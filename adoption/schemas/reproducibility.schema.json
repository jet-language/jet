{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jet-lang.dev/adoption/schemas/reproducibility-v1.json",
  "title": "Jet adoption reproducibility receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release_version", "lock_sha256", "status", "independent_rebuild", "checks"],
  "properties": {
    "schema": { "const": "jet.adoption.reproducibility/v1" },
    "release_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "lock_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "const": "verified" },
    "independent_rebuild": { "const": true },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "result"],
        "properties": {
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "result": { "const": "verified" }
        }
      }
    }
  }
}
