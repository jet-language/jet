{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jet-lang.dev/adoption/schemas/artifact-manifest-v1.json",
  "title": "Jet adoption artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "release", "artifacts", "generated_by"],
  "properties": {
    "schema": { "const": "jet.adoption.artifact-manifest/v1" },
    "version": { "$ref": "#/$defs/version" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commit", "platform", "lock_sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "platform": { "type": "string", "minLength": 1 },
        "lock_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "sha256", "bytes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "kind": { "enum": ["binary", "sbom-spdx", "sbom-cyclonedx", "provenance", "signature", "licenses", "security-policy", "support-policy", "reproducibility", "air-gap-bundle"] },
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 },
          "subject": { "type": ["string", "null"] },
          "package_name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "generated_by": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
