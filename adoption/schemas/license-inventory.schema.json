{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jet-lang.dev/adoption/schemas/license-inventory-v1.json",
  "title": "Jet adoption license inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release_version", "complete", "entries"],
  "properties": {
    "schema": { "const": "jet.adoption.licenses/v1" },
    "release_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "complete": { "const": true },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "license_expression", "source", "notice"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "license_expression": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "notice": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
