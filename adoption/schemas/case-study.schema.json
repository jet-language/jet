{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jet-lang.dev/adoption/schemas/case-study-v1.json",
  "title": "Jet adoption case study",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "capstone", "source", "jet", "measurements", "failures", "reproduction", "claims"],
  "properties": {
    "schema": { "const": "jet.adoption.case-study/v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "capstone": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "scope"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "jet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "measurements": { "type": "array", "minItems": 1 },
    "failures": { "type": "array", "minItems": 1 },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine", "receipt"],
      "properties": {
        "machine": { "type": "string", "minLength": 1 },
        "receipt": { "type": "string", "minLength": 1 }
      }
    },
    "claims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
