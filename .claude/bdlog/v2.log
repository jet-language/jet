macro_rules! jet_impl_sized_int_encode {
    ($($ty:ty),* $(,)?) => {$(
        impl __jet_Encode for $ty {
            fn jet_encode(&self) -> jet_std::DataTree {
                jet_std::DataTree::Int(*self as i64)
