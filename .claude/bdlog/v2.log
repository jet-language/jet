/// D-RANGE-VALUE1=A: the standard structural record form for `Range`.
pub fn jet_debug_range(start: i64, end: i64, exclusive: bool) -> String {
    jet_debug_record(
        "Range",
        [
            ("start".to_string(), start.to_string()),
