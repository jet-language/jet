fn jet_map_flat_map<K: Ord + Clone, V: Clone, F>(m: JetMap<K, V>, mut f: F) -> JetMap<K, V>
where F: FnMut(&K, &V) -> JetMap<K, V> {
    let mut out = JetMap::new();
    for (k, v) in &m {
        for (ik, iv) in f(k, v).iter() {
