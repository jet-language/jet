{
  "permissions": {
    "allow": [
      "Bash(scripts/agent/jet-env *)",
      "Bash(nix develop *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(cargo build*)",
      "Bash(cargo test*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore *)",
      "Bash(node plugins/tower/tower.mjs *)",
      "Bash(node /home/nate/Projects/Github/jet/plugins/tower/tower.mjs *)",
      "Bash(df *)",
      "Bash(rm -rf /tmp/nix-shell.*)",
      "Read(//tmp/**)",
      "WebSearch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=scripts/agent/clean-nix-tmp.sh; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/$f\"; [ -f \"$f\" ] && bash \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=scripts/agent/check-worktree-layout.sh; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/$f\"; [ -f \"$f\" ] && bash \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "f=scripts/agent/require-clean-tree.sh; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/$f\"; [ -f \"$f\" ] && exec bash \"$f\"; exit 0"
          }
        ]
      }
    ]
  }
}
