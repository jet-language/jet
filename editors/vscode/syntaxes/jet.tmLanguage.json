{
  "name": "Jet",
  "scopeName": "source.jet",
  "patterns": [
    { "include": "#comments" },
    { "include": "#doc-comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "doc-comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.jet",
          "match": "///.*$"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.jet",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.jet",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.jet",
              "match": "\\\\[\"\\\\nrt0]|\\\\u\\{[0-9a-fA-F]+\\}"
            },
            {
              "name": "meta.interpolation.jet",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.jet" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.jet" } },
              "patterns": [{ "include": "$self" }]
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.jet",
          "match": "'[^'\\\\]'|'\\\\.'",
          "captures": { "0": { "name": "constant.character.jet" } }
        }
      ]
    },
    "keywords": {
      "comment": "BEGIN GENERATED JET SYNTAX HIGHLIGHTS",
      "patterns": [
        {
          "name": "keyword.control.jet",
          "match": "\\b(break|continue|else|if|in|loop|return|step)\\b"
        },
        {
          "name": "keyword.declaration.jet",
          "match": "\\b(Bench|Context|Impure|Pure|Reactive|Sanitizer|State|Tainted|Test|Todo|Transact|Transition|Unsafe|add|alias|as|assume_deterministic|change|client|comptime|const|derive|distinct|enum|extern|fn|impl|live|migration|module|policy|priv|protocol|pub|region|remove|rename|rust|server|state|struct|tag|taskgroup|trait|use|via)\\b"
        },
        {
          "name": "keyword.other.ownership.jet",
          "match": "\\b(copy|uninit)\\b"
        },
        {
          "name": "keyword.other.jet",
          "match": "\\b(it|self)\\b"
        },
        {
          "name": "constant.language.jet",
          "match": "\\b(None|Val|err|false|ok|true)\\b"
        },
        {
          "name": "storage.type.builtin.jet",
          "match": "\\b(BigInt|Bool|Char|Computed|Csv|Data|DbValue|Decimal|Derived|Effect|Error|F32|F64|Float|I16|I32|I64|I8|IOError|Int|JSON|JSONError|Json|Key|List|Map|Measurement|Ptr|SelectBuilder|Shared|Signal|Stream|String|TaskGroup|Toml|U16|U32|U64|U8|UTF8Error|Yaml)\\b"
        },
        {
          "name": "support.function.builtin.jet",
          "match": "\\b(input|print)\\b"
        },
        {
          "name": "entity.name.tag.directive.jet",
          "match": "\\b(Bench|Bindgen|Caller|Caps|Default|DenyUnknownFields|Extern|Flatten|Grant|Html|Impure|Js|Layout|Reactive|Rename|RenameAll|Sanitizer|SingleUse|Skip|State|Suppress|Tag|Tainted|Target|Test|Todo|Transact|Transition|UnitFamily|Unsafe|Untagged|Wasm|WasmExport)\\b"
        },
        {
          "name": "entity.name.tag.contract.jet",
          "match": "\\b(Cli|Codable|CodableAsBase|Comparable|Debug|Decode|Doc|Encode|Experimental|Hardened|Inline|InlineAlways|MustUse|Numeric|Patchable|Persist|Post|Pre|Printable|PublishedSchema|Pure|Redact|Summarize|Tested)\\b"
        },
        {
          "name": "keyword.operator.sigil.jet",
          "match": "(#|&|\\.\\.\\.|::|:=|@|\\^)"
        },
        {
          "name": "keyword.operator.jet",
          "match": "(!|!=|%|%=|&&|&=|\\*|\\*=|\\+|\\+\\+|\\+=|\\-|\\-\\-|\\-=|\\->|\\.\\.|\\.\\[|\\.\\{|\\/|\\/=|<|<<|<<=|<=|==|=>|>|>=|>>|>>=|\\?|\\?\\.|\\?\\?|\\^=|\\||\\|=|\\|\\|)"
        }
      ],
      "endComment": "END GENERATED JET SYNTAX HIGHLIGHTS"
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.builtin.jet",
          "match": "\\b(Int|Float|Bool|String|Char|Error|Shared|I8|I16|I32|I64|U8|U16|U32|U64|F32|F64)\\b"
        },
        {
          "name": "storage.type.collection.jet",
          "match": "\\b(List|Map)\\b(?=\\s*<)"
        },
        {
          "name": "storage.type.result.jet",
          "match": "\\?"
        },
        {
          "comment": "User-defined types: PascalCase identifiers",
          "name": "entity.name.type.jet",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.jet",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.jet",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.jet",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "comment": "Function definition name",
          "name": "entity.name.function.jet",
          "match": "(?<=\\bfn\\s)([a-z_][A-Za-z0-9_]*)"
        },
        {
          "comment": "Method call: ident followed by (",
          "name": "entity.name.function.call.jet",
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "comment": "Binding sigils (D-BIND4)",
          "name": "keyword.operator.binding.jet",
          "match": "::|:="
        },
        {
          "name": "keyword.operator.jet",
          "match": "\\?|->|=>|&&|\\|\\||==|!=|<=|>=|[-+*/%]=|\\.{2}|[+\\-*/%<>&|^!]"
        }
      ]
    }
  }
}
