{
  "name": "Jet",
  "scopeName": "source.jet",
  "patterns": [
    { "include": "#comments" },
    { "include": "#doc-comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "doc-comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.jet",
          "match": "///.*$"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.jet",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.jet",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.jet",
              "match": "\\\\[\"\\\\nrt0]|\\\\u\\{[0-9a-fA-F]+\\}"
            },
            {
              "name": "meta.interpolation.jet",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.jet" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.jet" } },
              "patterns": [{ "include": "$self" }]
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.jet",
          "match": "'[^'\\\\]'|'\\\\.'",
          "captures": { "0": { "name": "constant.character.jet" } }
        }
      ]
    },
    "keywords": {
      "comment": "Keyword lists track Source/Syntax.rs (I7). FOREIGN_* teaching-error words are NOT listed here.",
      "patterns": [
        {
          "comment": "Control flow: real Jet keywords only. `while`/`for`/`switch`/`or` are FOREIGN_* teaching errors.",
          "name": "keyword.control.jet",
          "match": "\\b(if|else|when|in|break|continue|return|loop|region|live)\\b"
        },
        {
          "comment": "Declarations: `module` (U3), `#Pure` (S60), `distinct` (D-DIST1). `#Test`/`#Pure`/`#Context`/`#Sanitizer` are PascalCase markers (D-CASING1 follow-on); `#Tainted` is the D-TAINT1 value-fact tag. `tag` is the D-QUAL2 marker-qualifier declaration; `State`/`Transition` are D-STATE1 typestate keywords; `#Transact` is the D-TXN1 transaction marker; `assume_deterministic` is the D-DET1 determinism escape.",
          "name": "keyword.declaration.jet",
          "match": "\\b(fn|pub|struct|enum|impl|trait|derive|extern|use|const|comptime|Test|Bench|Unsafe|Impure|Context|module|Pure|Sanitizer|Tainted|distinct|migration|rename|add|remove|change|via|tag|assume_deterministic|State|Transition|Transact|state)\\b"
        },
        {
          "comment": "Ownership/borrow keywords. `val`/`var` retired (D-BIND1); `#Todo` marker (D-TOOL2, D-CASING1 follow-on).",
          "name": "keyword.other.jet",
          "match": "\\b(mut|take|view|ref|self|Todo)\\b"
        },
        {
          "comment": "Literals: `value` is LIT_VALUE (like true/false/null), highlighted as constant not keyword.",
          "name": "keyword.control.jet",
          "match": "\\b(ok|err|null|it)\\b"
        },
        {
          "comment": "Boolean and option literals.",
          "name": "constant.language.jet",
          "match": "\\b(true|false|value)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.builtin.jet",
          "match": "\\b(Int|Float|Bool|String|Char|Error|Shared|I8|I16|I32|I64|U8|U16|U32|U64|F32|F64)\\b"
        },
        {
          "name": "storage.type.collection.jet",
          "match": "\\b(List|Map)\\b(?=\\s*<)"
        },
        {
          "name": "storage.type.result.jet",
          "match": "\\?"
        },
        {
          "comment": "User-defined types: PascalCase identifiers",
          "name": "entity.name.type.jet",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.jet",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.jet",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.jet",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "comment": "Function definition name",
          "name": "entity.name.function.jet",
          "match": "(?<=\\bfn\\s)([a-z_][A-Za-z0-9_]*)"
        },
        {
          "comment": "Method call: ident followed by (",
          "name": "entity.name.function.call.jet",
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.jet",
          "match": "\\?|->|=>|&&|\\|\\||==|!=|<=|>=|[-+*/%]=|\\.{2}|[+\\-*/%<>&|^!]"
        }
      ]
    }
  }
}
