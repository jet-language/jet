{
  "name": "Jet",
  "scopeName": "source.jet",
  "patterns": [
    { "include": "#comments" },
    { "include": "#doc-comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#contextual-keywords" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "contextual-keywords": {
      "patterns": [
        {
          "name": "keyword.control.jet",
          "match": "(?<![.A-Za-z0-9_])next(?=\\s*(?:\\(\\s*[A-Za-z_][A-Za-z0-9_]*\\s*\\))?\\s*(?:[;}\\n]|$))"
        }
      ]
    },
    "doc-comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.jet",
          "match": "///.*$"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.jet",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.jet",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.jet",
              "match": "\\\\[\"\\\\nrt0]|\\\\u\\{[0-9a-fA-F]+\\}|\\{\\{|\\}\\}"
            },
            {
              "name": "meta.interpolation.jet",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.jet" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.jet" } },
              "patterns": [{ "include": "$self" }]
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.jet",
          "match": "'[^'\\\\]'|'\\\\.'",
          "captures": { "0": { "name": "constant.character.jet" } }
        }
      ]
    },
    "keywords": {
      "comment": "BEGIN GENERATED JET SYNTAX HIGHLIGHTS",
      "patterns": [
        {
          "name": "keyword.control.jet",
          "match": "\\b(break|defer|else|if|loop|return)\\b"
        },
        {
          "name": "keyword.declaration.jet",
          "match": "\\b(Bench|Context|Impure|Reactive|Sanitizer|State|Tainted|Test|Todo|Transact|Transition|Unsafe|add|alias|as|change|client|comptime|derive|distinct|enum|extern|fn|impl|migration|module|priv|protocol|pub|remove|rename|rust|server|state|struct|tag|taskgroup|trait|use|validate|via)\\b"
        },
        {
          "name": "keyword.other.ownership.jet",
          "match": "\\b(uninit)\\b"
        },
        {
          "name": "keyword.other.jet",
          "match": "\\b(it|self)\\b"
        },
        {
          "name": "constant.language.jet",
          "match": "\\b(None|Val|false|true)\\b"
        },
        {
          "name": "storage.type.builtin.jet",
          "match": "\\b(BTreeMap|BigInt|BitSet|Bool|Budget|BudgetApplies|ByteBuffer|CSV|Char|Computed|DBValue|DataTree|Decimal|Deque|Derived|Effect|Error|Event|EventPolicy|EventScope|EventTrace|F32|F64|Float|HashMap|Hook|I16|I32|I64|I8|IOError|Int|Iter|JSON|JSONError|Key|Lru|Measurement|PriorityQueue|Ptr|SelectBuilder|Set|Shared|Signal|SortedSet|Stream|String|Subscription|TOML|TaskGroup|U16|U32|U64|U8|UTF8Error|Void|WatchEvent|WatchHandle|WatchSet|YAML)\\b"
        },
        {
          "name": "support.function.builtin.jet",
          "match": "\\b(check|input|print)\\b"
        },
        {
          "name": "entity.name.tag.rule.jet",
          "match": "\\b(ABI|Authority|Bench|Bindgen|CLI|Caps|Codable|CodableAsBase|Comparable|Context|DebugOnly|Decode|Default|DenyUnknownFields|Doc|Encode|Every|Extern|FFI|Flag|Flatten|Grant|HTML|Impure|Inline|Invariant|Layout|Live|Local|Meta|MustUse|NoPrelude|Nondeterministic|Numeric|Off|Patchable|Persist|Policy|Post|Pre|Printable|PubFile|PublishedSchema|Reactive|Redact|Region|Rename|RenameAll|Replayable|SQL|Sanitizer|Shared|Shield|SingleUse|Skip|State|Static|Summarize|Tag|Tainted|Target|Task|Test|Todo|Track|Transact|Transition|UnitFamily|Unsafe|Untagged|WasmExport|allow|wire)\\b"
        },
        {
          "name": "keyword.operator.sigil.jet",
          "match": "(#|&|\\.\\.\\.|::|:=|\\^|~)"
        },
        {
          "name": "keyword.operator.jet",
          "match": "(!|!=|%|%=|&&|&=|\\*|\\*=|\\+|\\+\\+|\\+=|\\-|\\-\\-|\\-=|\\->|\\.\\.|\\.\\.<|\\.\\[|\\.\\{|\\/|\\/=|<|<<|<<=|<=|==|=>|>|>=|>>|>>=|\\?|\\?\\.|\\?\\?|\\^=|\\||\\|=|\\|\\|)"
        }
      ],
      "endComment": "END GENERATED JET SYNTAX HIGHLIGHTS"
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.builtin.jet",
          "match": "\\b(Int|Float|Bool|String|Char|Error|Shared|I8|I16|I32|I64|U8|U16|U32|U64|F32|F64)\\b"
        },
        {
          "name": "storage.type.collection.jet",
          "match": "\\b(List|Map)\\b(?=\\s*<)"
        },
        {
          "name": "storage.type.result.jet",
          "match": "\\?"
        },
        {
          "comment": "User-defined types: PascalCase identifiers",
          "name": "entity.name.type.jet",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.jet",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.jet",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.jet",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "comment": "Function definition name",
          "name": "entity.name.function.jet",
          "match": "(?<=\\bfn\\s)([a-z_][A-Za-z0-9_]*)"
        },
        {
          "comment": "Method call: ident followed by (",
          "name": "entity.name.function.call.jet",
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "comment": "Binding sigils (D-BIND4)",
          "name": "keyword.operator.binding.jet",
          "match": "::|:="
        },
        {
          "name": "keyword.operator.jet",
          "match": "\\?|->|=>|&&|\\|\\||==|!=|<=|>=|[-+*/%]=|\\.{2}|[+\\-*/%<>&|^!]"
        }
      ]
    }
  }
}
