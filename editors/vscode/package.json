{
  "name": "jet",
  "displayName": "Jet",
  "description": "Full language server (M13) for the Jet language: completion, hover, go-to-definition, references, rename, semantic tokens, inlay hints.",
  "version": "0.2.0",
  "publisher": "jet-lang",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:jet"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Jet starts a language server and debugger for the workspace; trust the workspace before enabling it."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "jet",
        "aliases": ["Jet", "jet"],
        "extensions": [".jet"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jet",
        "scopeName": "source.jet",
        "path": "./syntaxes/jet.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "jet",
        "scopes": {
          "ownership.copy": ["keyword.other.ownership.jet"],
          "ownership.move": ["keyword.operator.sigil.jet"],
          "ownership.writeBorrow": ["keyword.operator.sigil.jet"],
          "decorator.directive": ["entity.name.tag.directive.jet"],
          "decorator.contract": ["entity.name.tag.contract.jet"]
        }
      }
    ],
    "commands": [
      {
        "command": "jet.restartServer",
        "title": "Jet: Restart Language Server"
      },
      {
        "command": "jet.runFile",
        "title": "Jet: Run File"
      },
      {
        "command": "jet.testFile",
        "title": "Jet: Test File"
      },
      {
        "command": "jet.debugFile",
        "title": "Jet: Debug File"
      }
    ],
    "debuggers": [
      {
        "type": "jet",
        "label": "Jet Debugger",
        "languages": ["jet"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Jet source file to debug."
              },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Arguments passed to the Jet program."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the Jet program."
              },
              "env": {
                "type": "object",
                "description": "Environment overrides for the Jet program."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true,
                "description": "Stop at the first mapped Jet statement."
              },
              "showRawFrames": {
                "type": "boolean",
                "default": false,
                "description": "Expert view: append generated Rust frames and scopes."
              }
            }
          },
          "attach": {
            "required": ["program", "map", "processId"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Native debug binary for the local target."
              },
              "map": {
                "type": "string",
                "description": "Matching .jetmap sidecar for the native target."
              },
              "processId": {
                "type": "integer",
                "minimum": 1,
                "description": "Local same-user process id."
              },
              "showRawFrames": {
                "type": "boolean",
                "description": "Append explicitly requested raw frames/scopes."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "jet",
            "request": "launch",
            "name": "Jet: Launch",
            "program": "${file}"
          }
        ],
        "breakpoints": [
          { "languageIds": ["jet"] }
        ]
      }
    ],
    "configuration": {
      "title": "Jet",
      "properties": {
        "jet.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the Jet executable used by the language server and debugger. Leave empty to discover a trusted workspace debug binary, then `jet` on PATH."
        },
        "jet.languageServerPath": {
          "type": "string",
          "default": "",
          "description": "Legacy alias for jet.executablePath. Use jet.executablePath for new settings."
        },
        "jet.inlayHints.cloneHints": {
          "type": "boolean",
          "default": true,
          "description": "Show .clone() hints at implicit clone sites (L0201). On by default per D-LSP8."
        },
        "jet.inlayHints.typeAnnotations": {
          "type": "boolean",
          "default": false,
          "description": "Show inferred types on bindings. Off by default per D-LSP8."
        }
      }
    }
  }
}
