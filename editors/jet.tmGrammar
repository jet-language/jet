{
  "name": "Jet",
  "scopeName": "source.jet",
  "patterns": [
    { "include": "#comments" },
    { "include": "#doc-comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#effect-arrows" },
    { "include": "#brackets" },
    { "include": "#contextual-keywords" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "effect-arrows": {
      "comment": "D-EFF2: `-[Net]>` is one token, not minus plus a list.",
      "patterns": [
        {
          "name": "meta.effect-arrow.jet",
          "begin": "-\\[",
          "end": "\\]>",
          "beginCaptures": { "0": { "name": "keyword.operator.jet" } },
          "endCaptures": { "0": { "name": "keyword.operator.jet" } },
          "patterns": [
            { "match": "\\bvia\\b", "name": "keyword.declaration.jet" },
            { "match": "[A-Za-z_][A-Za-z0-9_.]*", "name": "entity.name.type.jet" }
          ]
        }
      ]
    },
    "brackets": {
      "comment": "Balanced `[...]` so nested list types and indexes keep scopes.",
      "patterns": [
        {
          "name": "meta.brackets.jet",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            { "include": "#strings" },
            { "include": "#comments" },
            { "include": "#effect-arrows" },
            { "include": "#brackets" },
            { "include": "#keywords" },
            { "include": "#types" },
            { "include": "#numbers" },
            { "include": "#functions" }
          ]
        }
      ]
    },
    "contextual-keywords": {
      "patterns": [
        {
          "name": "keyword.control.jet",
          "match": "(?<![.A-Za-z0-9_])next(?=\\s*(?:\\(\\s*[A-Za-z_][A-Za-z0-9_]*\\s*\\))?\\s*(?:[;}\\n]|$))"
        },
        {
          "comment": "D-ECO-INLINEPACKAGE1=A: package is contextual and only highlighted before its record carrier.",
          "name": "keyword.declaration.jet",
          "match": "(?<![.A-Za-z0-9_])package(?=\\s*(?:(?://[^\\n]*(?:\\n|$)|/\\*(?:[^*]|\\*(?!/))*\\*/)\\s*)*\\{)"
        }
      ]
    },
    "doc-comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.jet",
          "match": "///.*$"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.jet",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "comment": "Quoted text is one color. Escapes and {interpolation} stay in this scope; never include $self, #functions, or #keywords.",
      "patterns": [
        {
          "name": "string.quoted.double.jet",
          "begin": "\"",
          "end": "\"",
          "applyEndPatternLast": true,
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#string-interpolation" }
          ]
        }
      ]
    },
    "string-escapes": {
      "name": "string.quoted.double.jet",
      "match": "\\\\[\"\\\\nrt0]|\\\\u\\{[0-9a-fA-F]+\\}|\\{\\{|\\}\\}"
    },
    "string-interpolation": {
      "name": "string.quoted.double.jet",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#string-interpolation" },
        {
          "name": "string.quoted.double.jet",
          "begin": "\"",
          "end": "\"",
          "applyEndPatternLast": true,
          "patterns": [
            { "include": "#string-escapes" }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.jet",
          "match": "'[^'\\\\]'|'\\\\.'",
          "captures": { "0": { "name": "constant.character.jet" } }
        }
      ]
    },
    "keywords": {
      "comment": "BEGIN GENERATED JET SYNTAX HIGHLIGHTS",
      "patterns": [
        {
          "name": "keyword.control.jet",
          "match": "(?<![.A-Za-z0-9_])(break|else|if|in|loop|return)(?![A-Za-z0-9_])"
        },
        {
          "name": "keyword.control.jet",
          "match": "(?<![.A-Za-z0-9_])(after|defer|task)(?=\\s*(?:\\{|[A-Za-z_][A-Za-z0-9_]*\\s*:))"
        },
        {
          "name": "keyword.control.jet",
          "match": "(task\\.all|task\\.any|task\\.group|task\\.race)"
        },
        {
          "name": "keyword.declaration.jet",
          "match": "(?<![.A-Za-z0-9_])(derive|effect|enum|extern|fn|impl|module|priv|pub|struct|tag|trait|use)(?![A-Za-z0-9_])"
        },
        {
          "name": "keyword.declaration.jet",
          "match": "(?<![.A-Za-z0-9_])as(?=\\s+[A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "keyword.declaration.jet",
          "match": "(?<![.A-Za-z0-9_])(Context|Impure|Reactive|Scrub|State|Test|Todo|Transact|Transition|Unsafe|add|alias|change|client|distinct|marker|migration|policy|protocol|remove|rename|rust|server|state|validate|via|wrap)(?=\\s*(?:\\{|[A-Za-z_][A-Za-z0-9_]*\\s*:))"
        },
        {
          "name": "keyword.other.ownership.jet",
          "match": "(?<![.A-Za-z0-9_])(uninit)(?=\\s*(?:\\{|[A-Za-z_][A-Za-z0-9_]*\\s*:))"
        },
        {
          "name": "keyword.other.jet",
          "match": "(?<![.A-Za-z0-9_])(it|self)(?![A-Za-z0-9_])"
        },
        {
          "name": "keyword.other.jet",
          "match": "(?<![.A-Za-z0-9_])(shared)(?=\\s*(?:\\{|[A-Za-z_][A-Za-z0-9_]*\\s*:))"
        },
        {
          "name": "constant.language.jet",
          "match": "\\b(Cancelled|DeadlineBlown|None|Panicked|Val|false|true)\\b"
        },
        {
          "name": "storage.type.builtin.jet",
          "match": "\\b(BTreeMap|Bits|Bool|Budget|BudgetApplies|Bytes|CSV|Cache|Char|Complex|Computed|Condition|DBValue|DataTree|Decimal|Derived|Duration|Effect|EncodingError|Err|Event|EventPolicy|EventScope|EventTrace|F32|F64|Float|HashMap|Hook|I16|I32|I64|I8|IOError|Instant|Int|Iter|JSON|Key|Measurement|MemoStats|PriorityQueue|Ptr|Queue|Rank|Receiver|Sender|Set|Shared|SharedGuard|SharedRevisionError|SharedSnapshot|Signal|Stream|String|Subscription|TOML|Task|TaskFailure|U16|U32|U64|U8|UTF8Error|ViewIter|WatchEvent|WatchHandle|WatchSet|YAML)\\b"
        },
        {
          "name": "storage.type.builtin.jet",
          "match": "(\\(\\)|Shared\\.Weak)"
        },
        {
          "name": "support.function.builtin.jet",
          "match": "(?<![.A-Za-z0-9_])(assert|assert_eq|channel|check|freeze|input|join|print)(?=\\s*\\()"
        },
        {
          "name": "entity.name.tag.rule.jet",
          "match": "#\\[?(ABI|Arithmetic|Bindgen|CLI|Close|Codable|CodableAsBase|Commutative|Comparable|Context|Debug|DebugOnly|Decode|DenyUnknownFields|Deprecated|DevPanel|Discriminant|Doc|Encode|Env|Equatable|Error|Every|Extern|FFI|FX|Flag|Flatten|HTML|Impure|Inline|Interrupt|Job|Kernel|Layout|Live|Local|Memo|Meta|MustUse|NoPrelude|Nondeterministic|Numeric|Off|Patchable|Persist|Policy|Post|Pre|Printable|PubFile|PublishedSchema|Reactive|Receipt|Redact|Region|Rename|RenameAll|Replayable|Root|SQL|Scalar|Scrub|Shared|Shield|Short|SingleUse|Skip|State|Static|Target|Test|Todo|Track|Transact|Transition|Undo|UnitFamily|Unsafe|Untagged|WasmExport|allow|wire)\\b"
        },
        {
          "name": "keyword.operator.sigil.jet",
          "match": "(#|&|\\.\\.\\.|::|:=|@|@\\[|\\]@|\\^|~)"
        },
        {
          "name": "keyword.operator.jet",
          "match": "(!|!=|%|%%|%%=|%=|&&|&=|\\*|\\*=|\\+|\\+\\+|\\+=|\\-|\\-\\-|\\-=|\\->|\\.\\.|\\.\\.<|\\.\\[|\\/|\\/%|\\/%=|\\/=|<|<<|<<=|<=|<=>|==|>|>=|>>|>>=|\\?|\\?\\.|\\?\\?|\\^=|\\||\\|=|\\|\\||~\\||~\\|=)"
        }
      ],
      "endComment": "END GENERATED JET SYNTAX HIGHLIGHTS"
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.builtin.jet",
          "match": "\\b(Int|Float|Bool|String|Char|Err|Shared|I8|I16|I32|I64|U8|U16|U32|U64|F32|F64)\\b"
        },
        {
          "name": "storage.type.collection.jet",
          "match": "\\b(List|Map)\\b(?=\\s*<)"
        },
        {
          "name": "storage.type.result.jet",
          "match": "\\?"
        },
        {
          "comment": "User-defined types: PascalCase identifiers",
          "name": "entity.name.type.jet",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.jet",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.jet",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.jet",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "comment": "Function definition name",
          "name": "entity.name.function.jet",
          "match": "(?<=\\bfn\\s)([a-z_][A-Za-z0-9_]*)"
        },
        {
          "comment": "Method call: ident followed by (",
          "name": "entity.name.function.call.jet",
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "comment": "Binding sigils (D-BIND4)",
          "name": "keyword.operator.binding.jet",
          "match": "::|:="
        },
        {
          "name": "keyword.operator.jet",
          "match": "\\?|->|&&|\\|\\||==|!=|<=|>=|[-+*/%]=|\\.{2}|[+\\-*/%<>&|^!]"
        }
      ]
    }
  }
}
