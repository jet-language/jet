id = "jet-lang"
name = "Jet"
description = "Jet language support for the Jet language server."
version = "0.1.0"
schema_version = 1
authors = ["Jet Language <jet@example.com>"]
repository = "https://github.com/jet-language/jet"

languages = ["languages/jet"]

[language_servers.jet-lsp]
name = "Jet Language Server"
languages = ["Jet"]

[[capabilities]]
kind = "process:exec"
command = "jet"
args = ["self", "lsp"]

[[capabilities]]
kind = "process:exec"
command = "*"
args = ["self", "lsp"]

[grammars.jet]
repository = "@GRAMMAR_URI@"
commit = "@GRAMMAR_REV@"
