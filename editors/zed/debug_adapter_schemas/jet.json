{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": { "enum": ["launch", "attach"] },
    "program": { "type": "string" },
    "map": { "type": "string" },
    "processId": { "type": "integer", "minimum": 1 },
    "args": { "type": "array", "items": { "type": "string" } },
    "cwd": { "type": "string" },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "stopOnEntry": { "type": "boolean", "default": true },
    "showRawFrames": { "type": "boolean", "default": false }
  },
  "oneOf": [
    {
      "properties": {
        "request": { "const": "launch" },
        "program": { "type": "string", "pattern": "\\.jet$" }
      },
      "required": ["program"]
    },
    {
      "properties": {
        "request": { "const": "attach" },
        "program": { "type": "string", "description": "The matching native debug binary." },
        "map": { "type": "string", "description": "The matching .jetmap sidecar." }
      },
      "required": ["request", "program", "map", "processId"]
    }
  ]
}
