use core.net.url.[urljoin, parse_qsl, parse_qs, urlencode, split_fragment, quote, quote_from_bytes, quote_plus, unquote, unquote_to_bytes, unquote_plus, urlparse, urlsplit, urlunparse, urlunsplit, urldefrag, geturl, unparse]

fn run() {
    print(urljoin("https://example.com/a/b", "../c"))
    print(parse_qsl("?a=1&b=two%20words&empty"))
    print(parse_qs("a=1&b=two%20words"))
    print(urlencode([[String]{"a", "two words"}, [String]{"b", "!"}]))
    print(split_fragment("https://example.com/a#frag"))
    print(quote("a/b c"))
    print(quote_from_bytes([U8]{106, 101, 116, 32, 47}))
    print(quote_plus("a/b c"))
    print(unquote("a%2Fb"))
    print(unquote_to_bytes("a%2Fb"))
    print(unquote_plus("a+b%20c"))
    p :: urlparse("https://example.com/a?x=1#f") ?? return
    print(urlsplit("https://example.com/b"))
    print(urlunparse(p))
    print(urlunsplit(p))
    print(urldefrag("https://example.com/a#frag"))
    print(geturl(p))
    print(unparse(p))
}
