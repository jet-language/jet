use json: core.encoding.json

run: fn() {
    _: json.parse("{{}}") ?? panic("parse")
    print(true)
    _: json.parse("[]") ?? panic("parse")
    print(true)
    _: json.parse("{{\"\":1}}") ?? panic("parse")
    print(true)
    _: json.parse("{{\"a\":1}}") ?? panic("parse")
    print(true)
    _: json.parse("{{\"a\":1,\"b\":2}}") ?? panic("parse")
    print(true)
    _: json.parse("[1,2,3]") ?? panic("parse")
    print(true)
    _: json.parse("{{\"a\":1,\"b\":[true,false,null]}}") ?? panic("parse")
    print(true)
}
