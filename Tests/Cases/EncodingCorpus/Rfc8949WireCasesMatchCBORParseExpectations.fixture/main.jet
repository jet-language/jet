use cbor: core.encoding.cbor

run: fn() {
    _: cbor.parse([0]) ?? panic("appendix A accept 00")
    print(true)
    _: cbor.parse([1]) ?? panic("appendix A accept 01")
    print(true)
    _: cbor.parse([23]) ?? panic("appendix A accept 17")
    print(true)
    _: cbor.parse([24, 24]) ?? panic("appendix A accept 1818")
    print(true)
    _: cbor.parse([32]) ?? panic("appendix A accept 20")
    print(true)
    _: cbor.parse([64]) ?? panic("appendix A accept 40")
    print(true)
    _: cbor.parse([96]) ?? panic("appendix A accept 60")
    print(true)
    _: cbor.parse([159, 1, 2, 255]) ?? panic("appendix A accept 9f0102ff")
    print(true)
    _: cbor.parse([191, 97, 97, 1, 255]) ?? panic("appendix A accept bf616101ff")
    print(true)
    if cbor.parse([255]) == {
        .Ok(_) -> { print(false) }
        .Err(_) -> print(true)
    }
}
