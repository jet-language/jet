# `PAGE`'s check warns (a multiline HTML text is still a plain String), and
# a warning settles the check: only an error stops the run, so only an
# error waits for the values and reports of the batch that holds `A`
# (JetDriver Pipeline.jet jet_driver_comptime_settled). `A` and `B` build
# into one program, `PAGE` is checked once, and its warning is reported
# once.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
write: main.jet = "A: #run { [1, 2, 3].len() }\nPAGE: #run { `<p>\n<b>hi</b>` }\nB: #run { [4, 5].len() }\n\nrun: fn() {\n    print(\"{A} {PAGE.len()} {B}\")\n}\n"
step: jet check --trace main.jet
exit: 0
stderr: count "Warning: Jet.RawMultilineHtml" = 1 # PAGE's warning, once
stderr: count "> comptime.check PAGE (main.jet)" = 1 # checked once
stderr: ~ "# comptime.programs_built = 1\n" # A and B in one program
