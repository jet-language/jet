# A `#run` constant's type lands as it joins the comptime batch, ahead of
# its value, and the batch computes it for the entries after it, which read
# it by calling its item function (JetDriver Pipeline.jet
# jet_driver_comptime_type_land). A check that waits only on such constants
# joins the same batch, so the chain TWO -> SIX -> TWENTY and the pair FOUR
# -> EIGHT build one program, not one per dependency level. (A plain
# `NAME: expr` is a module value, which the batch does not compute for the
# entries after it.)
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
write: main.jet = "double: fn(n: Int) -> Int {\n    n * 2\n}\n\nTWO: #run double(1)\nSIX: #run (double(TWO) + 2)\nFOUR: #run double(2)\nEIGHT: #run double(FOUR)\nTWENTY: #run (double(SIX) + EIGHT)\n\nrun: fn() {\n    print(\"{TWO} {SIX} {FOUR} {EIGHT} {TWENTY}\")\n}\n"
step: jet run --trace main.jet
exit: 0
stdout: = "2 6 4 8 20\n"
stderr: ~ "# comptime.programs_built = 1\n" # one build for the whole chain
stderr: ~ "comptime.build TWO, SIX, FOUR, EIGHT, TWENTY (main.jet)" # the build span names every level
stderr: count "> comptime.check SIX (main.jet)" = 1 # SIX does not wait for TWO to land
stderr: count "> comptime.check TWENTY (main.jet)" = 1 # nor TWENTY for SIX and EIGHT
step: jet run --release main.jet
exit: 0
stdout: = "2 6 4 8 20\n"
