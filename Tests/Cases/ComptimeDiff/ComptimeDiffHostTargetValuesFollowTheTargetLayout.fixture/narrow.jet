use sys: core.sys

// Built for a 32-bit target, compile-time code measures that target, not the
// compiler's 64-bit host: the check stops if it measures anything else.
WIDEST: #run sys.usize_max()

POINTER_BITS: #run { if WIDEST > (U64{0xffffffff}) -> 64 else -> 32 }

NARROW_BITS: #run { if POINTER_BITS != 32 -> panic("compile-time code measured {POINTER_BITS}-bit pointers for a 32-bit target") else -> POINTER_BITS }

run: fn() { _ := NARROW_BITS }
