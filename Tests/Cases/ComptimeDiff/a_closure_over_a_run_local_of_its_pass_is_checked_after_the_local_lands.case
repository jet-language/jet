# An item whose closure checks a function holding a `name: #run value`
# local of the same comptime pass is checked after that local has landed
# (jet_driver_comptime_site_waits): `worker` and the second `line` reach
# `small` while it waits in the batch, and wait for the pass's last flush;
# the `line` in `early` reaches `big` before the pass does, and waits on it.
# A check made before the local landed would leave the function's body
# without the local, and the build would read an unknown local.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JET_RECHECK_VERIFY=1
write: main.jet = "fact: fn(n: Int) -> Int {\n    if n <= 1 -> return 1\n    n * fact(n - 1)\n}\n\nearly: fn() -> String {\n    line: late()\n    line\n}\n\nlate: fn() -> String {\n    big: #run fact(5)\n    \"late {big}\"\n}\n\nreport: fn() -> String {\n    small: #run fact(3)\n    \"report {small}\"\n}\n\nrun: fn() {\n    worker: task report()\n    if worker.join() == {\n        .Ok(line) -> { print(line) }\n        .Err(_) -> { print(\"failed\") }\n    }\n    print(early())\n    line: report()\n    print(line)\n}\n"
step: jet run main.jet
exit: 0
stdout: = "report 6\nlate 120\nreport 6\n"
step: jet run --release main.jet
exit: 0
stdout: = "report 6\nlate 120\nreport 6\n"
