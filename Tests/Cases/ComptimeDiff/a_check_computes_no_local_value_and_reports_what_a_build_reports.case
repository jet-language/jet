# `jet check` computes no local value (JetSema Comptime/LocalValues.jet
# sema_comptime_local_value_candidate). A check lowers nothing, and a local
# value reports nothing whether or not it lands, so the check reports word
# for word what a compile that computes it reports. `quotient` is a local
# value whose computing stops (it divides by zero), so a build tries it while
# compiling and leaves it to run time. `strict` also keeps the E2404
# obligation of the unannotated `checked`.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
write: main.jet = "divide: fn(a: Int, b: Int) -> Int {\n    a /% b\n}\n\nchecked: fn(row: Int) -> Int {\n    if row < 0 -> return Err(\"negative {row}\")\n    row\n}\n\nstrict: fn(row: Int) -> Int Never! {\n    quotient: divide(1, 0)\n    checked(row) + quotient\n}\n\nrun: fn() {\n    print(\"{strict(1)}\")\n}\n"
step: jet check main.jet
exit: nonzero
stdout: empty
stderr: = "Error [jet.ErrorNotPropagatable]: `checked` fails with `Err`, which can't propagate into `Never` here\n  --> main.jet:12:5\n    |\n 12 |     checked(row) + quotient\n    |     ^^^^^^^\n Why: `checked` is defined at `main.jet:5:1` with effective failure contract `implicit default Err!`; the caller's `explicit Never! (proven unreachable)` contract has no route from `Err` to `Never`\n Fix: The caller is declared `Never!`, so it can't fail: declare `Err!` in its return type, or handle `checked` locally with `??`\nMore: jet-lang.dev/e/E2404\n\n1 problem found\nrun `jet explain E2404` to learn more\n"
step: jet check --trace main.jet
exit: nonzero
stderr: !~ "comptime.eval quotient" # the check never computes `quotient`
stderr: !~ "# comptime.programs_built = 1" # nor builds a compile-time program for it
step: jet build main.jet
exit: nonzero
stderr: ~ "Error [jet.ErrorNotPropagatable]: `checked` fails with `Err`, which can't propagate into `Never` here\n  --> main.jet:12:5\n    |\n 12 |     checked(row) + quotient\n    |     ^^^^^^^\n Why: `checked` is defined at `main.jet:5:1` with effective failure contract `implicit default Err!`; the caller's `explicit Never! (proven unreachable)` contract has no route from `Err` to `Never`\n Fix: The caller is declared `Never!`, so it can't fail: declare `Err!` in its return type, or handle `checked` locally with `??`\nMore: jet-lang.dev/e/E2404\n" # the build reports the check's error word for word
step: jet build --trace main.jet
exit: nonzero
stderr: ~ "comptime.eval quotient" # the build computes `quotient` while compiling
