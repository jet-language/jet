# A local value that reads module state (a `^name: …` binding), in its own
# initializer or in a function it calls, directly or further down, is
# computed when the program runs it, never while building: the program
# writes the state first, and a value computed while building would read the
# binding's initializer instead.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
write: main.jet = "^counter: 0\n\noffset: fn(k: Int) -> Int { counter + k }\n\nthrough: fn(k: Int) -> Int { offset(k) * 10 }\n\nrun: fn() {\n    #Unsafe(\"one thread writes the word before any read\") {\n        counter = 5\n    }\n    first: offset(1)\n    second: through(2)\n    third: counter + offset(0)\n    print(\"{first} {second} {third}\")\n}\n"
step: jet build --trace main.jet
exit: 0
stderr: !~ "comptime.eval first" # `offset` reads `counter`, so the build does not compute the value
stderr: !~ "comptime.eval second" # nor through `offset`
stderr: !~ "comptime.eval third" # nor when the initializer reads it itself
step: jet run -O0 main.jet
exit: 0
stdout: = "6 70 10\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "6 70 10\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "6 70 10\n"
