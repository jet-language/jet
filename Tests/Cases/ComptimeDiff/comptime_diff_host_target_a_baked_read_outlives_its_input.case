# The `#Impure` example of Docs/Spec/Reference/metaprogramming.md, byte for
# byte. Its compile-time read needs the source gate and `Meta.Host` in the
# package's `allow` row (E3411 without it). With both, the read happens once,
# while building: the value lives as long as the program, so the built binary
# prints it after the file it came from is gone.
fixture: ComptimeDiffHostTargetABakedReadOutlivesItsInput.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet build main.jet
exit: 1
stderr: ~ "inside `#Impure` is a Tier-2 comptime effect, but its package doesn't hold `Meta.Host`" # E3411
write: package.jet = "name: \"main\"\nversion: \"0.1.0\"\nauthority: {\n    allow: [Meta.Host]\n}\n"
step: jet build main.jet
exit: 0
remove: config.txt
step: {work}/.jet/build/main
exit: 0
stdout: = "read while building\n"
