erased: fn() {
    #Off {
        #FX(authority: FS.Read) { print("erased") }
    }
    authority: Authority.workspace()
    authority.with("FS.Write(\".jet/build\")")
}

active: fn() {
    #FX(authority: FS.Read) { print("active") }
    authority: Authority.workspace()
    authority.with("FS.Write(\".jet/build\")")
}

run: fn() {}
