# Port of tests/jetpack_jetos.rs:3591-3714. All original predicates, fixture sources verbatim.
# Runtime PENDING-SAME-HEAD; PENDING-GRAMMAR(batch-four).
opt-in: epoch-7 jetos suite: writes ~24G scratch under TMPDIR (card 1638); run deliberately with -- --ignored
fixture: NixosMigrationPublishStageIsPrivateAndCollisionSafe.fixture
mkdir: package-root
requires: os-name:linux
requires: tool:cc
requires: arch:x86_64
mkdir: tools
mkdir: tool-outputs
env: JETPACK_ROOT={work}/package-root
env: JET_TEST_TOOL_ROOT={work}/tool-outputs
env: JET_TEST_REQUIRE_OFFLINE=1
env: JET_TEST_REQUIRE_COMPOSED_METADATA=1
env: TMPDIR={work}/package-root
step: cc -std=c11 -O0 migration-tool.c -o tools/migration-tool
exit: 0
hardlink: tools/migration-tool tools/nix
hardlink: tools/migration-tool tools/qemu-system-x86_64
hardlink: tools/migration-tool tools/qemu-img
step: jet perf attach --lens=syscalls --out {work}/publish-success.jettrace -- {jet} os migrate compare-nixos devhost-gnome --out {work}/published --no-color --offline
cwd: project
env: PATH={work}/tools:{env:PATH|}
exit: 0
stdout: ~ "{work}/published/nixos/devhost-gnome/system.qcow2" # original published path predicate
file: published/nixos/devhost-gnome/system.qcow2 is-file
stdout: ~ "{work}/published/nixos/devhost-gnome/proof.json" # original published path predicate
file: published/nixos/devhost-gnome/proof.json is-file
stdout: ~ "{work}/published/nixos/devhost-gnome/receipt.json" # original published path predicate
file: published/nixos/devhost-gnome/receipt.json is-file
when os unix: file: published mode = 0700
file: published/nixos/devhost-gnome/proof.json ~ "\"image\":\"system.qcow2\"" # original contains predicate
file: published/nixos/devhost-gnome/receipt.json ~ "\"boot_proof\":\"proof.json\"" # original contains predicate
file: published/nixos/devhost-gnome/build-boot-plan.json count "\"--offline\"" = 2 # original count predicate
json: file publish-success.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.status = "traced" # the kernel let jet trace the migration
step: jet perf view publish-success.jettrace
stdout: file trace.log
exit: 0
step: jet run observe/trace.jet
exit: 0
json: stdout doc $.mkdir >= 0
json: stdout doc $.protected[0] >= 0
json: stdout doc $.first_output >= 0
capture: mkdir stdout doc $.mkdir
capture: first_output stdout doc $.first_output
json: stdout doc $.protected[0] > {cap:mkdir}
json: stdout doc $.protected[0] < {cap:first_output}
step: jet os migrate compare-nixos devhost-gnome --out {work}/json-output --no-color --offline --json
cwd: project
env: PATH={work}/tools:{env:PATH|}
exit: 0
stdout: = "{\"kind\":\"nixos.migration.comparison\",\"state\":\"proved\",\"host\":\"devhost-gnome\",\"image\":\"{work}/json-output/nixos/devhost-gnome/system.qcow2\",\"proof\":\"{work}/json-output/nixos/devhost-gnome/proof.json\",\"receipt\":\"{work}/json-output/nixos/devhost-gnome/receipt.json\"}\n" # original format literal3684
step: jet perf attach --lens=syscalls --out {work}/publish-collision.jettrace -- {jet} os migrate compare-nixos devhost-gnome --out {work}/collision-output --no-color --offline
cwd: project
env: PATH={work}/tools:{env:PATH|}
env: JET_TEST_COLLIDE_PUBLISH={work}
exit: 2
file: collision-output absent
json: file publish-collision.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.status = "traced" # the kernel let jet trace the migration
step: jet perf view publish-collision.jettrace
stdout: file trace.log
exit: 0
step: jet run observe/trace.jet
exit: 0
json: stdout doc $.collision = true # original atomic EEXIST private mkdir predicate
