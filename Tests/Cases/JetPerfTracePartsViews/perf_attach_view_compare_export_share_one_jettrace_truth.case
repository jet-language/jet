# Port of tests/jet_perf_trace_parts/views.rs:1-164; all original command/stream/file assertions retained.
# The attach takes a sleeping process the case starts under the authorizer,
# so jet may trace it, as an attach needs; the original took the test's own
# process (std::process::id()), which is the attach's ancestor.
requires: os-name:linux
requires: tool:cc
fixture: Fixtures/Views
copy: {root}/Tests/Fixtures/Ptrace/authorizer.c authorizer.c
step: cc authorizer.c -o authorizer
exit: 0
spawn target: {work}/authorizer sleep 30
poll asleep: sh -c 'test "$(readlink /proc/{pid:target}/exe)" = "$(readlink -f "$(command -v sleep)")"' until exit: 0 timeout 5s every 10ms # the authorizer has let jet trace it and run `sleep`
step: jet perf attach {pid:target} --out {work}/session.jettrace
exit: 0
stderr: ~ "Trace:" # original predicate
file: session.jettrace is-file
file: session.jettrace ~ "\"schema\":\"jet.trace\"" # original predicate
file: session.jettrace ~ "\"version\":3" # original predicate
file: session.jettrace ~ "\"trace_id\":" # original predicate
file: session.jettrace ~ "\"capture_policy\":" # original predicate
step: jet perf view session.jettrace
exit: 0
stdout: ~ "schema jet.trace v3" # original predicate
stdout: ~ "command attach" # original predicate
step: jet perf view session.jettrace --json
exit: 0
stdout: ~ "\"kind\":\"jet.trace.view\"" # original predicate
stdout: ~ "\"timeline\":" # original predicate
stdout: ~ "\"flamegraph\":" # original predicate
step: jet perf view session.jettrace --html
exit: 0
stdout: ~ "<!doctype html>" # original predicate
stdout: ~ "flamegraph" # original predicate
stdout: ~ "timeline" # original predicate
step: jet perf view session.jettrace --frames=all
env: NO_COLOR=1
exit: 0
stdout: !~ "\u001b" # original predicate: no ESC byte
stdout: ~ "frames all" # original predicate
stdout: ~ "generated-frames:" # original predicate
step: jet perf compare session.jettrace session.jettrace
exit: 0
stdout: ~ "Compare OK" # original predicate
step: jet perf export session.jettrace --json
exit: 0
stdout: ~ "\"kind\":\"jet.trace.projection\"" # original predicate
stdout: ~ "\"loss\":" # original predicate
stdout: ~ "\"schema\":\"jet.trace\"" # original predicate
stdout: ~ "--chrome" # original predicate
stdout: !~ "no pprof/otel/chrome payloads" # original predicate
step: jet perf export session.jettrace --pprof
exit: 0
stdout: ~ "Profile: session.pb.gz" # the gzip profile.proto lands beside the trace
file: session.pb.gz is-file
step: jet perf export session.jettrace --otel
exit: 0
stdout: ~ "\"resourceSpans\":[" # an OTLP/JSON export request
step: jet perf export session.jettrace --chrome
exit: 0
stdout: ~ "chrome-projection" # original predicate
stdout: ~ "\"traceEvents\":[" # original predicate
step: jet perf export session.jettrace --emit-profile-map
exit: 0
stdout: ~ "profile-map-projection" # original predicate
step: jet perf compare session.jettrace session.jettrace --override-identity
exit: 0
stdout: ~ "budgets:" # original predicate
copy: corrupt.txt corrupt.jettrace
step: jet perf view corrupt.jettrace
exit: 2
stderr: ~ "jettrace" # original predicate
signal target: KILL
wait: target
exit: any # the case's KILL ends the sleep
