# Port of tests/fmt_project.rs:673-732.
# `jet fmt --simplify` over three trees of a project writes each one-return
# body on one line and keeps the block's own last-line `return`; a second
# simplify pass over the same trees changes nothing.
fixture: SimplifyProject.fixture
step: jet fmt --simplify {work}/examples {work}/tests {work}/docs/spec/reference
exit: 0
file: examples/answer.jet = answer.out
file: tests/double.jet = double.out
file: docs/spec/reference/sample.jet = label.out
copy: examples/answer.jet answer.before
copy: tests/double.jet double.before
copy: docs/spec/reference/sample.jet label.before
step: jet fmt --simplify --check {work}/examples {work}/tests {work}/docs/spec/reference
exit: 0
file: examples/answer.jet == answer.before
file: tests/double.jet == double.before
file: docs/spec/reference/sample.jet == label.before
