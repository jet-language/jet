# A `#run fn` literal hook runs while building, never with the program. A
# literal that takes a hook prints the value the hook computed. A hook that
# panics stops the build (E3010), and a hook that prints is refused (E3410),
# so neither one reaches the run: each build fails and nothing prints.
fixture: ComptimeNoSilentFallbackLiteralHook.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run source0/main.jet
exit: 0
stdout: = "50 1250\n"
step: jet build source1/main.jet
exit: nonzero
stderr: ~ "Error: Jet.ArithmeticOrBoundsFailure" # the hook's panic stops the build
stderr: ~ "too big for Small" # the panic's own message
stderr: !~ "Stop: Jet.Panic" # nothing ran
step: jet build source2/main.jet
exit: nonzero
stderr: ~ "Jet.ComptimeEffectWithoutImpure" # printing is an effect compile-time code is refused
stdout: !~ "hook ran" # the hook printed nothing
