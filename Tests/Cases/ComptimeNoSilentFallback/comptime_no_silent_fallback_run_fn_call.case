# A `#run fn` runs while building, so only code that runs while building
# calls it: a `#run` value in a body or at module level, a `#run { … }`
# block, and another `#run fn` body. Run-time code that calls one is refused
# at each call (E1019), and nothing is built to run it with the program.
fixture: ComptimeNoSilentFallbackRunFnCall.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run source0/main.jet
exit: 0
stdout: = "7 10 8 15\n"
step: jet check source1/main.jet --json
exit: nonzero
json: stdout doc $.reports has {"code":"E1019","line":14}
json: stdout doc $.reports has {"code":"E1019","line":17}
