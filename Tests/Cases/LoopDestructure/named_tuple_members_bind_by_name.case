# A brace loop head, `loop {a, b} in rows`, binds each name to the named
# tuple member it names (in either order, or renamed), and a struct pattern
# head takes each struct apart, at every optimization level and in a built
# binary. A paren head keeps the index and the item, a map keeps its
# key-value pair, and a bare `loop {` stays the infinite loop.
fixture: NamedTupleMembersBindByName.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 0
step: jet run -O0 main.jet
exit: 0
stdout: = named_tuple_members_bind_by_name.out
step: jet run -O1 main.jet
exit: 0
stdout: = named_tuple_members_bind_by_name.out
step: jet run -O2 main.jet
exit: 0
stdout: = named_tuple_members_bind_by_name.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = named_tuple_members_bind_by_name.out
