# HAND-PORT tests/jetpack_engine.rs:3256-3277 clean_without_yes_prints_plan_and_does_not_apply_in_non_tty
env: NO_COLOR=1
env: JETPACK_ROOT={work}/root
env: JETPACK_FIXTURES={work}/fixtures
mkdir: root
mkdir: project
mkdir: fixtures
mkdir: old-src
write: old-src/payload = "old bytes"
step: jetpack hangar ingest old-src --name oldplan --version 1.0 --ref fixture:oldplan --source-fingerprint sha256-fixture-source-oldplan --recipe-fingerprint sha256-fixture-recipe-oldplan --policy-fingerprint policy=fixture --provenance fixture --last-used-at 1 --json --no-color
exit: 0
capture: stale_id stdout doc $.id
step: jetpack hangar clean --no-color
exit: 0
file: root/hangar/{cap:stale_id}/meta.json is-file
stderr: ~ "Plan hangar clean" # original contains predicate
stderr: ~ "- stale-objects" # original contains predicate
stderr: ~ "-y or --yes" # original contains predicate

