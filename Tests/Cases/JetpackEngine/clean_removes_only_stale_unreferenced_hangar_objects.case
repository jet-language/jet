# HAND-PORT tests/jetpack_engine.rs:3229-3254 clean_removes_only_stale_unreferenced_hangar_objects
env: NO_COLOR=1
env: JETPACK_ROOT={work}/root
env: JETPACK_FIXTURES={work}/fixtures
mkdir: root
mkdir: project
mkdir: fixtures
mkdir: old-src
mkdir: fresh-src
write: old-src/payload = "old bytes"
write: fresh-src/payload = "fresh bytes"
step: jetpack hangar ingest old-src --name old --version 1.0 --ref fixture:old --source-fingerprint sha256-fixture-source-old --recipe-fingerprint sha256-fixture-recipe-old --policy-fingerprint policy=fixture --provenance fixture --last-used-at 1 --json --no-color
exit: 0
capture: stale_id stdout doc $.id
step: jetpack hangar ingest fresh-src --name fresh --version 1.0 --ref fixture:fresh --source-fingerprint sha256-fixture-source-fresh --recipe-fingerprint sha256-fixture-recipe-fresh --policy-fingerprint policy=fixture --provenance fixture --json --no-color
exit: 0
capture: fresh_id stdout doc $.id
step: jetpack hangar clean --no-color --yes
exit: 0
file: root/hangar/{cap:stale_id} absent
file: root/hangar/{cap:fresh_id}/meta.json is-file
stderr: ~ "removed 2 stale object" # original contains predicate

