# HAND-PORT tests/jetpack_engine.rs:2856-2966 no_nix_projects_external_output_and_build_facts
env: NO_COLOR=1
requires: os:unix
env: JETPACK_ROOT={work}/root
mkdir: root
mkdir: project
mkdir: fixtures
mkdir: staging/bin
write: staging/bin/greet = "#!/bin/sh\necho projected\n"
chmod: staging/bin/greet 0555
chmod: staging/bin 0555
chmod: staging 0555
write: fixtures/jetpack-greet.json = "[{\"drvPath\":\"/nix/store/0fixture00000000000000000000-greet.drv\",\"outputs\":{\"out\":\"{work}/staging\"}}]\n"
env: JETPACK_FIXTURES={work}/fixtures
step: jetpack use --prep greet@jetpack --no-color --offline
cwd: project
env: PATH=
exit: 0
file: staging/bin/greet exists
step: jetpack explain greet --json --no-color
cwd: project
exit: 0
stdout: ~ "\"nix.projection.mode\":\"canonical-hangar\"" # Nix production path projects into canonical Hangar
stdout: ~ "\"nix.build.root\":\"/build\"" # deterministic Nix build root fact
stdout: ~ "\"nix.build.home\":\"/homeless-shelter\"" # deterministic Nix build home fact
stdout: ~ "hangar/objects/sha256-" # projected output lives under Hangar objects
step: jetpack use greet@jetpack --no-color --offline -- /bin/sh -c "printf '%s|%s|%s|%s' \"$HOME\" \"$NIX_BUILD_TOP\" \"$TMPDIR\" \"$LC_ALL\""
cwd: project
env: PATH=
exit: 0
stdout: = "/homeless-shelter|/build|/build|C"

