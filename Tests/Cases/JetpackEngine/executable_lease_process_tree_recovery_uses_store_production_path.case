# HAND-PORT tests/jetpack_engine.rs:3790-3866 executable_lease_process_tree_recovery_uses_store_production_path
fixture: ExecutableLeaseProcessTreeRecoveryUsesStoreProductionPath.fixture
env: NO_COLOR=1
requires: os:unix
# The platform executable the lease realizes is the fixture's jetpack.jet: `--hold` keeps it
# alive for five seconds and `--help` prints its banner.
env: JETPACK_ROOT={work}/root
mkdir: root
mkdir: project
mkdir: fixtures
mkdir: output/bin
step: jet build --output-dir=output/bin jetpack.jet
exit: 0
copy: output/bin/jetpack fixtures/omp-native-jetpack-fixture
capture: artifact_sha = sha256 file fixtures/omp-native-jetpack-fixture
write: fixtures/jetpackage-omp.json = "{\"tag\":\"v1.0.0\",\"version\":\"1.0.0\",\"sha256\":\"{cap:artifact_sha}\",\"artifact\":\"omp-native-jetpack-fixture\"}\n"
write: hold.sh = "setsid /bin/sh -c 'printf ready > \"$LEASE_READY\"; while [ ! -f \"$LEASE_RELEASE\" ]; do sleep 0.01; done' </dev/null >/dev/null 2>&1 &\nwhile [ ! -f \"$LEASE_READY\" ]; do sleep 0.01; done\n"
step: jetpack use omp@releases#1.0.0 -y --no-color --offline --fixtures {work}/fixtures -- /bin/sh {work}/hold.sh
env: JETPACK_FIXTURES={work}/fixtures
env: LEASE_READY={work}/root/descendant-ready
env: LEASE_RELEASE={work}/root/descendant-release
exit: 0
file: root/descendant-ready exists
capture: lease = first-entry root/leases
step: jetpack hangar recover --no-color
exit: 0
file: {cap:lease} exists
write: root/descendant-release release.template
repeat while file: {cap:lease} exists timeout 5s every 10ms fail "idle descendant lease was not reclaimed"
step: jetpack hangar recover --no-color
exit: 0
end repeat

