# HAND-PORT tests/jetpack_engine.rs:3120-3166 disappeared_output_build_fails_without_store_state_and_retries
# Retargeted off the retired `jetpack build` (2b160ee885): build -> env --prep / use --prep, run -> env / use, test -> jet test.
env: NO_COLOR=1
env: JETPACK_ROOT={work}/root
env: JETPACK_FIXTURES={work}/fixtures
requires: os:unix
mkdir: root
mkdir: project
mkdir: fixtures
write: fixtures/jetpack-greet.json = "[{\"drvPath\":\"/nix/store/0fixture-greet.drv\",\"outputs\":{\"out\":\"{work}/root/not-realized\"}}]\n"
step: jetpack use --prep greet@jetpack --no-color --offline
exit: nonzero
stderr: ~ "Error: Jet.HangarIngestFailed:" # original contains predicate
stderr: ~ "does not exist" # original contains predicate
step: jetpack hangar list --no-color
exit: 0
stderr: !~ "greet" # original contains predicate
mkdir: greet-src/bin
write: greet-src/bin/greet = "#!/bin/sh\necho hello from jetpack\n"
chmod: greet-src/bin/greet 0755
step: jetpack hangar ingest greet-src --name greet --version 1.0 --ref greet@jetpack --json --no-color
exit: 0
capture: greet_digest stdout doc $.output_hash
write: fixtures/jetpack-greet.json = "[{\"drvPath\":\"/nix/store/0fixture-greet.drv\",\"outputs\":{\"out\":\"{work}/root/hangar/objects/{cap:greet_digest}\"}}]\n"
step: jetpack use --prep greet@jetpack --no-color --offline
exit: 0
