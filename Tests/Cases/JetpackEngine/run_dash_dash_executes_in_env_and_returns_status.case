# HAND-PORT tests/jetpack_engine.rs:3459-3486 run_dash_dash_executes_in_env_and_returns_status
# Retargeted off the retired `jetpack run` (2b160ee885): build -> env --prep / use --prep, run -> env / use, test -> jet test.
env: NO_COLOR=1
env: JETPACK_ROOT={work}/root
env: JETPACK_FIXTURES={work}/fixtures
requires: os:unix
mkdir: root
mkdir: project
mkdir: fixtures
mkdir: greet-src/bin
write: greet-src/bin/greet = "#!/bin/sh\necho hello from jetpack\n"
chmod: greet-src/bin/greet 0755
step: jetpack hangar ingest greet-src --name greet --version 1.0 --ref greet@jetpack --json --no-color
exit: 0
capture: greet_digest stdout doc $.output_hash
write: fixtures/jetpack-greet.json = "[{\"drvPath\":\"/nix/store/0fixture00000000000000000000-greet.drv\",\"outputs\":{\"out\":\"{work}/root/hangar/objects/{cap:greet_digest}\"}}]\n"
step: jetpack use greet@jetpack --no-color --offline -- greet
exit: 0
stdout.trim: = run_dash_dash_executes_in_env_and_returns_status.expected # original compares trimmed output
