# HAND-PORT tests/jetpack_engine.rs:3093-3118 list_shows_realized_package
env: NO_COLOR=1
env: JETPACK_ROOT={work}/root
env: JETPACK_FIXTURES={work}/fixtures
mkdir: root
mkdir: project
mkdir: fixtures
mkdir: greet-src/bin
write: greet-src/bin/greet = "#!/bin/sh\necho hello\n"
chmod: greet-src/bin/greet 0755
step: jetpack hangar ingest greet-src --name greet --version 1.0 --ref greet@jetpack --json --no-color
exit: 0
capture: greet_digest stdout doc $.output_hash
write: fixtures/jetpack-greet.json = "[{\"drvPath\":\"/nix/store/0fixture00000000000000000000-greet.drv\",\"outputs\":{\"out\":\"{work}/root/hangar/objects/{cap:greet_digest}\"}}]\n"
step: jetpack use --prep greet@jetpack --no-color --offline
exit: 0
step: jetpack hangar list --no-color
exit: 0
stderr: ~ "greet" # original contains predicate

