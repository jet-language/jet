# HAND-PORT tests/jetpack_engine.rs:6019-6044 env_dash_p_merges_with_project_declared_packages
fixture: EnvDashPMergesWithProjectDeclaredPackages.fixture
env: NO_COLOR=1
env: JETPACK_ROOT={work}/root
env: JETPACK_FIXTURES={work}/fixtures
env: HOME={work}/home
requires: os:unix
mkdir: root
mkdir: project
mkdir: fixtures
mkdir: home
mkdir: greet-src/bin
write: greet-src/bin/greet = "#!/bin/sh\necho hello from jetpack\n"
chmod: greet-src/bin/greet 0755
chmod: jet-pkgs/pkgs/hello/bin/hello 0755
write: project/env.jet env.template
step: jetpack hangar ingest greet-src --name greet --version 1.0 --ref greet@jetpack --json --no-color
exit: 0
capture: greet_digest stdout doc $.output_hash
write: fixtures/jetpack-greet.json = "[{\"drvPath\":\"/nix/store/0fixture00000000000000000000-greet.drv\",\"outputs\":{\"out\":\"{work}/root/hangar/objects/{cap:greet_digest}\"}}]\n"
step: jetpack env --no-color --trust --offline --fixtures {work}/fixtures -p greet -- sh -c "hello && greet"
cwd: project
exit: 0
stdout: ~ "hello from jet-pkgs" # original contains predicate
stdout: ~ "hello from jetpack" # original contains predicate
