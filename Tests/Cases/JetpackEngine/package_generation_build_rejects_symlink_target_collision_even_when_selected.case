# HAND-PORT tests/jetpack_engine.rs:1668-1702 package_generation_build_rejects_symlink_target_collision_even_when_selected
fixture: PackageGenerationBuildRejectsSymlinkTargetCollisionEvenWhenSelected.fixture
env: NO_COLOR=1
requires: os:unix
env: JETPACK_ROOT={work}/root
env: JETPACK_FIXTURES={work}/fixtures
mkdir: root
mkdir: project
mkdir: fixtures
mkdir: left-src/bin
mkdir: right-src/bin
write: left-src/bin/left-target = "left-target\n"
symlink: left-target left-src/bin/editor
write: right-src/bin/right-target = "right-target\n"
symlink: right-target right-src/bin/editor
step: jetpack hangar ingest left-src --name left --version 1.0 --ref left@default --json --no-color
exit: 0
capture: left_digest stdout doc $.output_hash
step: jetpack hangar ingest right-src --name right --version 1.0 --ref right@default --json --no-color
exit: 0
capture: right_digest stdout doc $.output_hash
write: fixtures/jetpack-left.json = "[{\"drvPath\":\"/nix/store/0fixture00000000000000000000-left.drv\",\"outputs\":{\"out\":\"{work}/root/hangar/objects/{cap:left_digest}\"}}]\n"
write: fixtures/jetpack-right.json = "[{\"drvPath\":\"/nix/store/0fixture00000000000000000000-right.drv\",\"outputs\":{\"out\":\"{work}/root/hangar/objects/{cap:right_digest}\"}}]\n"
step: jetpack profile build dev --no-color --offline
cwd: project
exit: 2
stderr: ~ "Jet.EnvironmentIntegrationConflict" # original contains predicate
stderr: ~ "symlink-target mismatch" # original contains predicate
stderr: ~ "left@default" # original contains predicate
stderr: ~ "right@default" # original contains predicate

