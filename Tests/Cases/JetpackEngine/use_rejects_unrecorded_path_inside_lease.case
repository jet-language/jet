# HAND-PORT tests/jetpack_engine.rs:3632-3736 use_rejects_unrecorded_path_inside_lease
env: NO_COLOR=1
env: JETPACK_ROOT={work}/root
env: JETPACK_FIXTURES={work}/fixtures
requires: os:unix
mkdir: root
mkdir: project
mkdir: fixtures
write: fixtures/omp-native-jetpack-fixture = "#!/bin/sh\necho hello from jetpack\n"
chmod: fixtures/omp-native-jetpack-fixture 0755
capture: artifact_sha = sha256 file fixtures/omp-native-jetpack-fixture
write: fixtures/jetpackage-omp.json = "{\"tag\":\"v1.0.0\",\"version\":\"1.0.0\",\"sha256\":\"{cap:artifact_sha}\",\"artifact\":\"omp-native-jetpack-fixture\"}\n"
step: jetpack use omp@releases#1.0.0 -y --no-color --offline --fixtures {work}/fixtures -- sh -c true
cwd: project
exit: 0
step: jetpack explain omp --json --no-color
cwd: project
exit: 0
capture: out stdout doc $.explain.entry.output_path
step: jetpack use omp@releases#1.0.0 -y --no-color --offline --fixtures {work}/fixtures -- {cap:out}/bin/../bin/omp
cwd: project
exit: 126
stderr: ~ "Error: Jet.JetpackCommandFailed:" # original contains predicate
stderr: ~ "not a recorded member" # original contains predicate
stdout: !~ "hello from jetpack" # original negative contains predicate
step: ln -s {cap:out}/bin {work}/root/lease-output-alias
exit: 0
step: jetpack use omp@releases#1.0.0 -y --no-color --offline --fixtures {work}/fixtures -- {work}/root/lease-output-alias/omp
cwd: project
exit: 126
stderr: ~ "not a recorded member" # original contains predicate
stdout: !~ "hello from jetpack" # original negative contains predicate
