# HAND-PORT tests/jetpack_engine.rs:5989-6017 env_dash_p_adds_adhoc_package_with_no_manifest_at_all
env: NO_COLOR=1
env: JETPACK_ROOT={work}/root
env: JETPACK_FIXTURES={work}/fixtures
requires: os:unix
mkdir: root
mkdir: project
mkdir: fixtures
mkdir: greet-src/bin
write: greet-src/bin/greet = "#!/bin/sh\necho hello from jetpack\n"
chmod: greet-src/bin/greet 0755
step: jetpack hangar ingest greet-src --name greet --version 1.0 --ref greet@jetpack --json --no-color
exit: 0
capture: greet_digest stdout doc $.output_hash
write: fixtures/jetpack-greet.json = "[{\"drvPath\":\"/nix/store/0fixture00000000000000000000-greet.drv\",\"outputs\":{\"out\":\"{work}/root/hangar/objects/{cap:greet_digest}\"}}]\n"
step: jetpack env --no-color --trust --offline --fixtures {work}/fixtures -p greet -- greet
cwd: project
exit: 0
stdout.trim: = env_dash_p_adds_adhoc_package_with_no_manifest_at_all.expected # original compares trimmed output
