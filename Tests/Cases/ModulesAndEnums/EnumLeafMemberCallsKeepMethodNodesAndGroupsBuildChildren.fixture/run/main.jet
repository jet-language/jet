Choice: enum {
    Empty
    Branch {
        Leaf(Int)
        Nested {
            Tip(Int)
            Unit
        }
    }

    measure: fn(self) -> Int { 7 }
}

run: fn() {
    _text: Dyn.Null.to_text()
    _equal: Dyn.Null.equal_unordered(Dyn.Null)
    empty: Choice.Empty.measure()
    unit: Choice.Branch.Nested.Unit.measure()
    _leaf: Choice.Branch.Leaf(2)
    _tip: Choice.Branch.Nested.Tip(3)
    print(empty)
    print(unit)
}
