geo: module {
    Point: struct {
        x: Int,
        y: Int,
    }

    Segment: struct {
        from: Point,
        to: Point,
    }

    shapes: module {
        Label: struct {
            text: String,
        }
    }
}

run: fn() {
    point: geo.Point{x: 1, y: 2}
    print(point)
    print("at {point}")
    print([geo.Point]{point, geo.Point{x: 3, y: 4}})
    print(geo.Segment{from: point, to: geo.Point{x: 5, y: 6}})
    print(geo.shapes.Label{text: "corner"})
}
