# A List element's optional file handle, bound by `&x == .Val(y)` and then
# used through method calls, as Jetpack's lease reads each executable it
# keeps open. The List is first read by value, then borrowed, then moved
# into the struct that keeps it. Each pass seeks the bound handle to 0 and
# reads every byte, at every tier. This pattern once faulted at address 0
# in the engine; the handle must stay live and readable here.
fixture: NullDerefRepro.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 0
stdout: = null_deref_repro.out
stderr: empty
step: jet run -O1 main.jet
exit: 0
stdout: = null_deref_repro.out
stderr: empty
step: jet run -O2 main.jet
exit: 0
stdout: = null_deref_repro.out
stderr: empty
