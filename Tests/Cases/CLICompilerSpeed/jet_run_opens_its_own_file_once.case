# Claim: `jet run` of a small program opens the jet's own file once and keeps that one descriptor for every read of it: the part table, the Core bodies records and the runtime image the loader maps; the run prints what it always did
requires: os-name:linux
requires: arch:x86_64
fixture: JetRunOpensItsOwnFileOnce.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/store
step: jet perf attach --lens=syscalls --out run.jettrace -- {jet} run main.jet
exit: 0
stdout: = "hello\n"
json: file run.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.status = "traced" # the kernel let jet trace the run
json: file run.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.calls[?name~="open"][?args~="/proc/self/exe"] #= 1 # the one open of the jet's own file; each read is a pread on that descriptor
