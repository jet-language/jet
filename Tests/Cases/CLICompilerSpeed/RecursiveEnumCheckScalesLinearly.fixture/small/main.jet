Tree: enum {
    Leaf(Int),
    Branch(left: Tree, right: Forest),
    Tagged(label: String, body: Node),
}

Forest: enum {
    Empty,
    Trees([Tree]),
    Linked(head: Tree, rest: Forest),
}

Node: enum {
    Plain(Int),
    Holds(Tree?),
    Grows(Forest),
}

Layer0: struct {
    tree: Tree,
    _node: Node,
}

use_0: fn(layer: Layer0) -> Int {
    if layer.tree == {
        .Leaf(value) -> value
        .Branch(_, _) -> 1
        .Tagged(_, _) -> 2
    }
}

Layer1: struct {
    left: Layer0,
    _right: Layer0,
    tree: Tree,
}

use_1: fn(layer: Layer1) -> Int {
    inner: layer.left
    if layer.tree == {
        .Leaf(value) -> value + use_0(inner)
        .Branch(_, _) -> 1
        .Tagged(_, body) -> if body == {
            .Plain(value) -> value
            .Holds(_) -> 0
            .Grows(_) -> 1
        }
    }
}

Layer2: struct {
    left: Layer1,
    _right: Layer1,
    tree: Tree,
}

use_2: fn(layer: Layer2) -> Int {
    inner: layer.left
    if layer.tree == {
        .Leaf(value) -> value + use_1(inner)
        .Branch(_, _) -> 2
        .Tagged(_, body) -> if body == {
            .Plain(value) -> value
            .Holds(_) -> 0
            .Grows(_) -> 2
        }
    }
}

Layer3: struct {
    left: Layer2,
    _right: Layer2,
    tree: Tree,
}

use_3: fn(layer: Layer3) -> Int {
    inner: layer.left
    if layer.tree == {
        .Leaf(value) -> value + use_2(inner)
        .Branch(_, _) -> 3
        .Tagged(_, body) -> if body == {
            .Plain(value) -> value
            .Holds(_) -> 0
            .Grows(_) -> 3
        }
    }
}

Layer4: struct {
    left: Layer3,
    _right: Layer3,
    tree: Tree,
}

use_4: fn(layer: Layer4) -> Int {
    inner: layer.left
    if layer.tree == {
        .Leaf(value) -> value + use_3(inner)
        .Branch(_, _) -> 4
        .Tagged(_, body) -> if body == {
            .Plain(value) -> value
            .Holds(_) -> 0
            .Grows(_) -> 4
        }
    }
}

Layer5: struct {
    left: Layer4,
    _right: Layer4,
    tree: Tree,
}

use_5: fn(layer: Layer5) -> Int {
    inner: layer.left
    if layer.tree == {
        .Leaf(value) -> value + use_4(inner)
        .Branch(_, _) -> 5
        .Tagged(_, body) -> if body == {
            .Plain(value) -> value
            .Holds(_) -> 0
            .Grows(_) -> 5
        }
    }
}

Layer6: struct {
    left: Layer5,
    _right: Layer5,
    tree: Tree,
}

use_6: fn(layer: Layer6) -> Int {
    inner: layer.left
    if layer.tree == {
        .Leaf(value) -> value + use_5(inner)
        .Branch(_, _) -> 6
        .Tagged(_, body) -> if body == {
            .Plain(value) -> value
            .Holds(_) -> 0
            .Grows(_) -> 6
        }
    }
}

// One value of every case, so each is built.
samples: fn() -> [Tree] {
    forest: Forest.Linked{head: Tree.Leaf(1), rest: Forest.Trees([Tree]{Tree.Leaf(2)})}
    [Tree]{Tree.Branch{left: Tree.Leaf(0), right: Forest.Empty}, Tree.Tagged{label: "held", body: Node.Holds(None)}, Tree.Tagged{label: "grown", body: Node.Grows(forest)}}
}

run: fn() {
    print(use_0(Layer0{tree: Tree.Leaf(1), _node: Node.Plain(2)}))
    print(samples().len())
}
