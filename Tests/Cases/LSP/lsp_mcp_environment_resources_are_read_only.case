stdout: ~ "\"listChanged\": false" # original predicate; unrelated metadata varies
send lsp: Messages/LSPMCPEnvironmentResourcesAreReadOnly/1.json
send lsp: Messages/LSPMCPEnvironmentResourcesAreReadOnly/2.json
recv lsp
stdout: ~ "jet://environment" # original predicate; unrelated metadata varies
stdout: ~ "application/json" # original predicate; unrelated metadata varies
