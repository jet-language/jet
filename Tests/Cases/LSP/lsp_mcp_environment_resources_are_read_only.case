stdout: ~ "lint_all" # original predicate; unrelated metadata varies
stdout: !~ "/test/home" # original negative predicate; unrelated metadata varies
capture: resource stdout doc $.result.contents[0].text
step envinfo: jet env info --json --no-color
env: HOME=/test/home
