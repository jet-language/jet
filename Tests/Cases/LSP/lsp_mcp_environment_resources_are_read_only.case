recv lsp
stdout: ~ "\"contents\"" # original predicate; unrelated metadata varies
stdout: ~ "active_environment" # original predicate; unrelated metadata varies
stdout: ~ "fixture" # original predicate; unrelated metadata varies
stdout: ~ "generated.txt" # original predicate; unrelated metadata varies
