# Port of tests/lsp.rs:3477-3550; original source bytes/order/assertions.
# PENDING-SEAM(read_bytes): Main ballot + CoreState2 + kit batch three.
# PENDING-GRAMMAR: collection, negated JSON filters, capture/write and named-stream equality.
session lsp content-length: jet self lsp
send lsp: Messages/LSPCanceledCostlyRequestReturns32800AndNeverPublishes/0.json
recv lsp until $.id = 1
send lsp: Messages/LSPCanceledCostlyRequestReturns32800AndNeverPublishes/1.json
recv lsp
stdout: ~ "publishDiagnostics" # original predicate; unrelated metadata varies
stdout: ~ "\"version\":1" # original predicate; unrelated metadata varies
send lsp: Messages/LSPCanceledCostlyRequestReturns32800AndNeverPublishes/2.json
send lsp: Messages/LSPCanceledCostlyRequestReturns32800AndNeverPublishes/3.json
send lsp: Messages/LSPCanceledCostlyRequestReturns32800AndNeverPublishes/4.json
recv lsp collect until $.id = 50
json: stdout ndjson $[?id=50].error.code = -32800
stdout: !~ "\"result\":" # original canceled response has no result; preceding frames are notifications
json: stdout ndjson $[?method="textDocument/publishDiagnostics"].params[?uri="file:///tmp/lsp_canceled_costly_request.jet"][?version!=2] #= 0 # original predicate
send lsp: Messages/LSPCanceledCostlyRequestReturns32800AndNeverPublishes/5.json
recv lsp collect until $.id = 51
json: stdout ndjson $[?id=50] #= 0 # original predicate
json: stdout ndjson $[?id=51].result[?name="marker_new"] #>= 1 # original predicate
json: stdout ndjson $[?id=51].result[?name~="marker_old"] #= 0 # original predicate
send lsp: Messages/LSPCanceledCostlyRequestReturns32800AndNeverPublishes/6.json
recv lsp until $.id = 99
close lsp
exit: 0
