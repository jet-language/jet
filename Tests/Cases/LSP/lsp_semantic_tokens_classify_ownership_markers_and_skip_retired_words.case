# Semantic tokens follow current syntax: the names a written type holds are
# types, and a retired word gets no token. The claims decode each answer
# against the document text it classifies (claims/run.jet).
fixture: LSPSemanticTokensClassifyOwnershipMarkersAndSkipRetiredWords.fixture
session lsp content-length: jet self lsp
stderr: null
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}"
recv lsp until $.id = 1
json: stdout doc $.result.capabilities.semanticTokensProvider.legend.tokenTypes[1] = "type"
send lsp: "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}"
send lsp: "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/semantic.jet\",\"languageId\":\"jet\",\"version\":1,\"text\":\"#Test(\\\"semantic\\\") {\\n    assert_eq(clean(2), 2)\\n}\\narchive: fn(name: &&String, slot: &Int) -> String {\\n    slot += 1\\n    saved: name.copy()\\n    saved\\n}\\nclean: fn(x: Int) -[]> Int { x }\\nmeasure: fn(window: View<Int>, grow: ViewMut<Int>) -> Int {\\n    window.len() + grow.len()\\n}\\nrun: fn() {\\n    old: 1\\n    while: 2\\n    for: 3\\n    text: \\\"view .view stays string content\\\"\\n    // view and .view stay comment content\\n    print(text, clean(old + while + for + next()))\\n}\\nnext: fn() -> Int { 1 }\\n\"}}}"
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/semanticTokens/full\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/semantic.jet\"}}}"
recv lsp until $.id = 2
capture: response = text stdout
write: response.json = "{cap:response}"
step: jet test claims
env: S5_SOURCE={work}/original.source
env: S5_RESPONSE={work}/response.json
env: S5_EDITED=0
# `.view(a..b)` is retired: the edited document still checks, with E0311.
send lsp: "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/semantic.jet\",\"version\":2},\"contentChanges\":[{\"range\":{\"start\":{\"line\":10,\"character\":11},\"end\":{\"line\":10,\"character\":11}},\"rangeLength\":0,\"text\":\"view(0..1).\"}]}}"
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/semanticTokens/full\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/semantic.jet\"}}}"
recv lsp until $.id = 3
capture: edited_response = text stdout
write: edited-response.json = "{cap:edited_response}"
step: jet test claims
env: S5_SOURCE={work}/edited.source
env: S5_RESPONSE={work}/edited-response.json
env: S5_EDITED=1
# The retired `mut`, `take` and `view` statement words no longer parse.
send lsp: "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/semantic.jet\",\"version\":3},\"contentChanges\":[{\"range\":{\"start\":{\"line\":16,\"character\":0},\"end\":{\"line\":16,\"character\":0}},\"rangeLength\":0,\"text\":\"    mut borrowed\\n    take borrowed\\n    view borrowed\\n\"}]}}"
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"textDocument/semanticTokens/full\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/semantic.jet\"}}}"
recv lsp until $.id = 4
capture: retired_response = text stdout
write: retired-response.json = "{cap:retired_response}"
step: jet test claims
env: S5_SOURCE={work}/retired.source
env: S5_RESPONSE={work}/retired-response.json
env: S5_EDITED=2
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"shutdown\",\"params\":{}}"
recv lsp until $.id = 5
send lsp: "{\"jsonrpc\":\"2.0\",\"method\":\"exit\",\"params\":{}}"
close lsp
exit: any # the session's status after `exit` is not under test
