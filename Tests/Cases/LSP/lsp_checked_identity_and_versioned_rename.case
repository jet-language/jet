# Port of tests/lsp.rs:3798-3926. The files are loose: files of one package
# share a namespace, so they cannot import each other by path.
fixture: LSPCheckedIdentityAndVersionedRename.fixture
session lsp content-length: jet self lsp
stderr: null
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"workspace\":{\"workspaceEdit\":{\"documentChanges\":true}}}}}"
recv lsp until $.id = 7
send lsp: "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/run.jet\",\"languageId\":\"jet\",\"version\":1,\"text\":\"use grades: scoring\\nuse \\\"util\\\"\\nrun: fn() {\\n    print(grades.letter(91))\\n    print(util.letter(91))\\n}\\nshadow: fn(letter: Int) { print(letter) }\\n\"}}}"
send lsp: "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/scoring.jet\",\"languageId\":\"jet\",\"version\":1,\"text\":\"letter: fn(score: Int) -> String { \\\"A\\\" }\\n\"}}}"
send lsp: "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/util.jet\",\"languageId\":\"jet\",\"version\":1,\"text\":\"letter: fn(score: Int) -> String { \\\"unrelated\\\" }\\n\"}}}"
send lsp: "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/scoring.jet\",\"version\":2},\"contentChanges\":[{\"text\":\"// unsaved 🚀\\n\\nletter: fn(score: Int) -> String { \\\"A\\\" }\\n\"}]}}"
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/run.jet\"},\"position\":{\"line\":3,\"character\":19}}}"
recv lsp until $.id = 7
json: stdout doc $.result.uri = "file://{work}/scoring.jet"
json: stdout doc $.result.range = {"start":{"line":2,"character":0},"end":{"line":2,"character":6}}
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/references\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/run.jet\"},\"position\":{\"line\":3,\"character\":19},\"context\":{\"includeDeclaration\":true}}}"
recv lsp until $.id = 7
json: stdout doc $.result #= 2
json: stdout doc $.result[*].uri in ["file://{work}/run.jet", "file://{work}/scoring.jet"]
json: stdout doc each $.result[?uri="file://{work}/run.jet"] as r: {r}.range = {"start":{"line":3,"character":17},"end":{"line":3,"character":23}} # original per-row predicate, vacuous on empty
json: stdout doc each $.result[?uri!="file://{work}/run.jet"] as r: {r}.range = {"start":{"line":2,"character":0},"end":{"line":2,"character":6}} # original per-row predicate, vacuous on empty
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/prepareRename\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/run.jet\"},\"position\":{\"line\":3,\"character\":19}}}"
recv lsp until $.id = 7
json: stdout doc $.result.range = {"start":{"line":3,"character":17},"end":{"line":3,"character":23}}
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/rename\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/run.jet\"},\"position\":{\"line\":3,\"character\":19},\"newName\":\"grade\"}}"
recv lsp until $.id = 7
json: stdout doc $.result.documentChanges #= 2
