json: stdout doc each $.result.documentChanges[?textDocument.uri!="file://{work}/run.jet"] as r: {r}.textDocument.version = 2 # original per-row predicate, vacuous on empty
json: stdout doc each $.result.documentChanges[?textDocument.uri!="file://{work}/run.jet"] as r: {r}.edits #= 1 # original per-row predicate, vacuous on empty
json: stdout doc each $.result.documentChanges[?textDocument.uri!="file://{work}/run.jet"] as r: {r}.edits[0].range = {"start":{"line":2,"character":0},"end":{"line":2,"character":6}} # original per-row predicate, vacuous on empty
json: stdout doc each $.result.documentChanges[?textDocument.uri!="file://{work}/run.jet"] as r: {r}.edits[0].newText = "grade" # original per-row predicate, vacuous on empty
