# The package is one namespace: `src/main.jet` uses `app/plan.jet`'s declarations
# without an import, both open documents check with no diagnostics, and the
# opened module's outline holds only its written declarations.
fixture: Fixtures/LSPDocumentSymbolReturnsSymbolsForImportedPackageModule
# PENDING-SEAM(read_bytes): D-CHILD-READ-BYTES1 + CoreState2 + kit batch three.
session lsp content-length: jet self lsp
send lsp: Messages/LSPDocumentSymbolReturnsSymbolsForImportedPackageModule/0.json
recv lsp
stdout: ~ "documentSymbolProvider" # original predicate; response has absolute scratch paths/metadata
send lsp: Messages/LSPDocumentSymbolReturnsSymbolsForImportedPackageModule/1.json
send lsp: Messages/LSPDocumentSymbolReturnsSymbolsForImportedPackageModule/2.json
recv lsp
stdout: ~ "publishDiagnostics" # the frame carries the scratch path
stdout: ~ "\"diagnostics\":[]" # src/main.jet checks clean
send lsp: Messages/LSPDocumentSymbolReturnsSymbolsForImportedPackageModule/3.json
recv lsp
stdout: ~ "publishDiagnostics" # the frame carries the scratch path
stdout: ~ "\"diagnostics\":[]" # app/plan.jet checks clean
send lsp: Messages/LSPDocumentSymbolReturnsSymbolsForImportedPackageModule/4.json
recv lsp until $.id = 2
stdout: ~ "\"result\":[" # locations carry the scratch path
stdout: ~ "\"name\":\"ImportedPlan\",\"kind\":23" # a struct
stdout: ~ "\"name\":\"imported_helper\",\"kind\":12" # a function
stdout: ~ "\"name\":\"value\",\"kind\":8" # a field
stdout: !~ "\"name\":\"encode\"" # a derive's members have no written name
stdout: !~ "\"name\":\"__read\"" # nor has a generated reader
stdout: !~ "\"name\":\"equal\"" # nor has a derived comparison
send lsp: Messages/LSPDocumentSymbolReturnsSymbolsForImportedPackageModule/5.json
recv lsp
stdout: ~ "result" # original predicate; response has absolute scratch paths/metadata
close lsp
exit: any # Original child.wait ignored status.
