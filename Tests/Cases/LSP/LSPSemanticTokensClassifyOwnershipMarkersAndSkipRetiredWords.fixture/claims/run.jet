// Decodes one semantic tokens answer against the document text it classifies:
// the `data` fields that are not unsigned 32-bit numbers are skipped, and a
// trailing part shorter than five fields is ignored. Token types index the
// server's legend: 0 keyword, 1 type, 2 function, 3 variable, 4 parameter,
// 7 string, 9 comment.
use {
    files: core.files
    sys: core.sys
}

S5SemanticToken: struct {
    text: String,
    token_type: Int,
    modifiers: Int,
}

s5_token_find: fn(text: String, marker: String, offset: Int) -> Int {
    bytes: text.bytes()
    pattern: marker.bytes()
    ^index: offset
    loop index + pattern.len() <= bytes.len() {
        ^same: true
        loop part in 0..<pattern.len() {
            if bytes[index + part] != pattern[part] -> same = false
        }
        if same -> return index
        index += 1
    }
    panic("semantic token data delimiter missing")
}

s5_token_slice: fn(text: String, start: Int, end: Int) -> String {
    bytes: text.bytes()
    if start < 0 || end < start || end > bytes.len() -> return ""
    ^selected: [U8]{}
    loop index in start..<end -> selected.push(bytes[index])
    String.from_bytes(selected) ?? ""
}

s5_token_u32: fn(text: String) -> Int? {
    bytes: text.bytes()
    if bytes.len() == 0 -> return None
    ^index: 0
    if (Int{bytes[0]}) == 43 -> index = 1
    if index == bytes.len() -> return None
    ^value: 0
    loop index < bytes.len() {
        digit: Int{bytes[index]} - 48
        if digit < 0 || digit > 9 -> return None
        if value > (4294967295 - digit) /% 10 -> return None
        value = value * 10 + digit
        index += 1
    }
    Val(value)
}

s5_token_decode: fn(source: String, response: String) -> [S5SemanticToken] {
    key: s5_token_find(response, "\"data\"", 0)
    first: s5_token_find(response, "[", key + 6) + 1
    last: s5_token_find(response, "]", first)
    ^values: [Int]{}
    loop field in s5_token_slice(response, first, last).split(",").to_list() {
        if s5_token_u32(field.trim()) == .Val(value) -> values.push(value)
    }
    lines: source.lines()
    ^tokens: [S5SemanticToken]{}
    ^line_index: 0
    ^column: 0
    ^offset: 0
    loop offset + 5 <= values.len() {
        delta: values[offset]
        line_index += delta
        column = if delta == 0 -> column + values[offset + 1] else -> values[offset + 1]
        length: values[offset + 2]
        text: if line_index < lines.len() -> s5_token_slice(lines[line_index], column, column + length) else -> ""
        tokens.push(S5SemanticToken{text: text, token_type: values[offset + 3], modifiers: values[offset + 4]})
        offset += 5
    }
    tokens
}

s5_token_count: fn(tokens: [S5SemanticToken], text: String, kind: Int) -> Int {
    ^count: 0
    loop token in tokens {
        if token.text == text && token.token_type == kind -> count += 1
    }
    count
}

s5_token_kind_count: fn(tokens: [S5SemanticToken], kind: Int) -> Int {
    ^count: 0
    loop token in tokens {
        if token.token_type == kind -> count += 1
    }
    count
}

s5_token_absent: fn(tokens: [S5SemanticToken], text: String) {
    loop token in tokens -> assert(token.text != text, "retired word {text} has a token")
}

s5_token_assertions: fn() {
    source: files.read(sys.get("S5_SOURCE") ?? panic("source path")) ?? panic("source bytes")
    response: files.read(sys.get("S5_RESPONSE") ?? panic("response path")) ?? panic("response bytes")
    tokens: s5_token_decode(source, response)
    stage: sys.get("S5_EDITED") ?? "0"
    // The test's name, and the string and the comment that spell `view`,
    // are two string tokens and one comment token.
    assert_eq(s5_token_kind_count(tokens, 7), 2)
    assert_eq(s5_token_kind_count(tokens, 9), 1)
    s5_token_absent(tokens, "view")
    if stage == "2" {
        // The document no longer parses: its retired statement words get
        // no keyword or name token.
        s5_token_absent(tokens, "mut")
        s5_token_absent(tokens, "take")
        return
    }
    // The document checks, the retired `.view(a..b)` method included.
    assert_eq(s5_token_count(tokens, "View", 1), 1)
    assert_eq(s5_token_count(tokens, "ViewMut", 1), 1)
    assert_eq(s5_token_count(tokens, "window", 4), 2)
    if stage == "1" {
        return
    }
    assert_eq(s5_token_count(tokens, "Int", 1), 7)
    assert_eq(s5_token_count(tokens, "String", 1), 2)
    assert_eq(s5_token_count(tokens, "while", 3), 2)
    assert_eq(s5_token_count(tokens, "for", 3), 2)
    assert_eq(s5_token_count(tokens, "next", 2), 2)
    // `copy` is a retired word the lexer keeps reserved; `.copy()` names a
    // method, never a keyword.
    assert_eq(s5_token_count(tokens, "copy", 0), 0)
}

#Test("semantic tokens follow current syntax and give retired words no token") {
    s5_token_assertions()
}
