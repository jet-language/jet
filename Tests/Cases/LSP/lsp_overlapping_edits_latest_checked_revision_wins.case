# Port of tests/lsp.rs:3224-3365; source/input bytes preserved, except that the
# callers' Rust-era `fn caller_N() Int` is written `caller_N: fn() -> Int`, so the
# document parses and has a checked outline.
# PENDING-SEAM(read_bytes): D-CHILD-READ-BYTES1 ballot + CoreState2 + kit batch three.
session lsp content-length: jet self lsp
send lsp: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/0.json
recv lsp
stdout: ~ "documentSymbolProvider" # original predicate; other response fields vary
send lsp: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/1.json
send lsp: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/2.json
recv lsp
stdout: ~ "publishDiagnostics" # original predicate; other response fields vary
stdout: ~ "\"version\":10" # original predicate; other response fields vary
send lsp: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/3.json
send lsp: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/4.json
send lsp: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/5.json
send lsp: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/6.json
recv lsp
stdout: ~ "\"id\":2" # original predicate; other response fields vary
stdout: ~ "marker_one" # original predicate; other response fields vary
stdout: !~ "marker_new" # original negative predicate; other response fields vary
send lsp: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/7.json
recv lsp
stdout: ~ "publishDiagnostics" # original predicate; other response fields vary
stdout: ~ "\"version\":12" # original predicate; other response fields vary
recv lsp
stdout: ~ "\"id\":3" # original predicate; other response fields vary
stdout: ~ "marker_new" # original predicate; other response fields vary
stdout: !~ "marker_two" # original negative predicate; other response fields vary
stdout: !~ "marker_stale" # original negative predicate; other response fields vary
send lsp: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/8.json
send lsp: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/9.json
recv lsp
stdout: ~ "\"id\":3" # original predicate; other response fields vary
stdout: ~ "marker_new" # original predicate; other response fields vary
stdout: !~ "\"code\":-32800" # original negative predicate; other response fields vary
send lsp: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/10.json
recv lsp
stdout: ~ "\"id\":99" # original predicate; other response fields vary
stdout: ~ "result" # original predicate; other response fields vary
close lsp
exit: any # Original child.wait did not assert status.
# A restarted server reuses nothing from the last one (no compile cache): it
# checks the document it is sent now, and none of the first server's last
# revision answers.
session lsp2 content-length: jet self lsp
send lsp2: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/0.json
recv lsp2
stdout: ~ "documentSymbolProvider" # the restarted server initializes
send lsp2: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/1.json
send lsp2: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/11.json
recv lsp2
stdout: ~ "publishDiagnostics" # it checks the reopened document
send lsp2: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/12.json
recv lsp2
stdout: ~ "\"id\":4" # the symbols request is answered
stdout: ~ "marker_restart" # from the text sent to this server
stdout: !~ "marker_new" # nothing of the first server's last revision survives the restart
send lsp2: Messages/LSPOverlappingEditsLatestCheckedRevisionWins/10.json
recv lsp2
stdout: ~ "\"id\":99" # shutdown answers
close lsp2
exit: any # the restarted server's exit status is not part of this contract
