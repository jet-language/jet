#Error
PatternError: enum { Bad }
Pattern: distinct String
impl Pattern.CheckedText {
    Error: PatternError,
    check: fn(parts: [String]) -[]> Checked<[String], TextSlot> PatternError! {
        if parts.join("") == "" -> return Err(PatternError.Bad)
        return Ok(Checked{shape: parts.copy(), slots: [TextSlot]{}})
    }
    encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> String { "hole" }
}

use_pattern: fn(value: Pattern, other: Pattern) -> Bool {
    value == other
}
run: fn() {
    
}
