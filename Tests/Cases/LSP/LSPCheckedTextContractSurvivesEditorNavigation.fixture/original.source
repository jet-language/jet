#Error
PatternError: enum { Bad }
Pattern: distinct String
impl Pattern.CheckedText {
    Error: PatternError,
    check: fn(text: String) -[]> PatternError! {
        if text == "" -> return Err(PatternError.Bad)
        return Ok()
    }
    encode_hole: fn<T: Printable>(value: T) -[]> String { "hole" }
}

use_pattern: fn(value: Pattern, other: Pattern) -> Bool {
    value == other
}
run: fn() {
    
}
