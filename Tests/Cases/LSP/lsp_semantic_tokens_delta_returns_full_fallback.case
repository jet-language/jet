# Port of tests/lsp.rs:3047-3089; source bytes copied verbatim.
# The server advertises semantic token deltas. A delta naming a result id the
# server does not keep answers the full tokens with a new result id; a delta
# naming the kept id after an edit answers edits only.
session lsp content-length: jet self lsp
send lsp: Messages/LSPSemanticTokensDeltaReturnsFullFallback/0.json
recv lsp until $.id = 1
json: stdout doc $.result.capabilities.semanticTokensProvider.full.delta = true
json: stdout doc $.result.capabilities.semanticTokensProvider.range = true
send lsp: Messages/LSPSemanticTokensDeltaReturnsFullFallback/1.json
send lsp: Messages/LSPSemanticTokensDeltaReturnsFullFallback/2.json
recv lsp
stdout: ~ "publishDiagnostics" # the open document's diagnostics arrive before any request is answered
send lsp: Messages/LSPSemanticTokensDeltaReturnsFullFallback/3.json
recv lsp until $.id = 2
json: stdout doc $.result.resultId = "1"
json: stdout doc $.result.data[0] = 0
send lsp: Messages/LSPSemanticTokensDeltaReturnsFullFallback/5.json
recv lsp until $.id = 3
json: stdout doc $.result.resultId = "2"
send lsp: Messages/LSPSemanticTokensDeltaReturnsFullFallback/6.json
send lsp: Messages/LSPSemanticTokensDeltaReturnsFullFallback/7.json
recv lsp until $.id = 4
json: stdout doc $.result.resultId = "3"
json: stdout doc $.result.edits #= 1
send lsp: Messages/LSPSemanticTokensDeltaReturnsFullFallback/4.json
recv lsp until $.id = 99
close lsp
exit: any # Original transcript only waited; it did not assert process status.
