# The editor checks a package as `jet check` does, with the modules its
# `build: fn` generates, so a call into one goes to the generated module the
# selected build plan names, under the package root at the path that module
# names. Swapping the order of the `b.generate` calls changes nothing but which
# module the executable selects.
fixture: LSPGeneratedDefinitionUsesSelectedBuildplanIdentity.fixture
write: main.jet lsp_generated_definition_uses_selected_buildplan_identity.0.source
session lsp0 content-length: jet self lsp
stderr: null
send lsp0: "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}"
recv lsp0 until $.id = 1
json: stdout doc $.result.capabilities.definitionProvider = true
send lsp0: "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}"
send lsp0: "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/main.jet\",\"languageId\":\"jet\",\"version\":1,\"text\":\"build: fn(b: Build) {\\n    b.generate(\\\"right\\\") {\\n        generated_value: fn() -> String { \\\"right\\\" }\\n    }\\n    b.generate(\\\"left\\\") {\\n        generated_value: fn() -> String { \\\"left\\\" }\\n    }\\n    app: b.add_executable(\\\"app\\\", [\\\"main.jet\\\", \\\".jet/generated/main/left.jet\\\"], [])\\n    b.default(app)\\n}\\nrun: fn() {\\n    print(generated_value())\\n}\\n\"}}}"
recv lsp0 until $.method = "textDocument/publishDiagnostics"
# The call resolves as `jet check` resolves it: no error.
json: stdout doc $.params.diagnostics[?severity=1] #= 0
send lsp0: "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/main.jet\"},\"position\":{\"line\":11,\"character\":16}}}"
recv lsp0 until $.id = 2
json: stdout doc $.result.uri = "file://{work}/.jet/generated/main/left.jet"
json: stdout doc $.result.range = {"start":{"line":0,"character":0},"end":{"line":0,"character":15}}
send lsp0: "{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\",\"params\":{}}"
recv lsp0 until $.id = 99
json: stdout doc $.result = null
close lsp0
exit: any # the server exit status after close is not part of this contract
write: main.jet lsp_generated_definition_uses_selected_buildplan_identity.1.source
session lsp1 content-length: jet self lsp
stderr: null
send lsp1: "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}"
recv lsp1 until $.id = 1
json: stdout doc $.result.capabilities.definitionProvider = true
send lsp1: "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}"
send lsp1: "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/main.jet\",\"languageId\":\"jet\",\"version\":1,\"text\":\"build: fn(b: Build) {\\n    b.generate(\\\"left\\\") {\\n        generated_value: fn() -> String { \\\"left\\\" }\\n    }\\n    b.generate(\\\"right\\\") {\\n        generated_value: fn() -> String { \\\"right\\\" }\\n    }\\n    app: b.add_executable(\\\"app\\\", [\\\"main.jet\\\", \\\".jet/generated/main/right.jet\\\"], [])\\n    b.default(app)\\n}\\nrun: fn() {\\n    print(generated_value())\\n}\\n\"}}}"
recv lsp1 until $.method = "textDocument/publishDiagnostics"
# The call resolves as `jet check` resolves it: no error.
json: stdout doc $.params.diagnostics[?severity=1] #= 0
send lsp1: "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/main.jet\"},\"position\":{\"line\":11,\"character\":16}}}"
recv lsp1 until $.id = 2
json: stdout doc $.result.uri = "file://{work}/.jet/generated/main/right.jet"
json: stdout doc $.result.range = {"start":{"line":0,"character":0},"end":{"line":0,"character":15}}
send lsp1: "{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\",\"params\":{}}"
recv lsp1 until $.id = 99
json: stdout doc $.result = null
close lsp1
exit: any # the server exit status after close is not part of this contract
