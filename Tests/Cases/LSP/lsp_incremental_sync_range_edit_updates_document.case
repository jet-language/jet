session lsp content-length: jet self lsp
send lsp: Messages/LSPIncrementalSyncRangeEditUpdatesDocument/0.json
recv lsp
json: stdout doc $.result.capabilities.textDocumentSync = 2
send lsp: Messages/LSPIncrementalSyncRangeEditUpdatesDocument/1.json
send lsp: Messages/LSPIncrementalSyncRangeEditUpdatesDocument/2.json
recv lsp
send lsp: Messages/LSPIncrementalSyncRangeEditUpdatesDocument/3.json
send lsp: Messages/LSPIncrementalSyncRangeEditUpdatesDocument/4.json
recv lsp
stdout: ~ "publishDiagnostics" # original predicate; other fields contain variable response metadata
stdout: !~ "Jet.RetiredForeignLet" # original negative predicate; other fields contain variable response metadata
stdout: !~ "Jet.RetiredForeignValVar" # original negative predicate; other fields contain variable response metadata
recv lsp
stdout: ~ "\"id\":2" # original predicate; other fields contain variable response metadata
stdout: ~ "\"data\"" # original predicate; other fields contain variable response metadata
send lsp: Messages/LSPIncrementalSyncRangeEditUpdatesDocument/5.json
recv lsp
send lsp: Messages/LSPIncrementalSyncRangeEditUpdatesDocument/6.json
close lsp
exit: any # Original child.wait did not assert process status.
