#Codable
Shape: enum {
    Dot,
    #Rename("circle") Circle(Int),
}

local_area: fn(s: Shape) -> Int {
    if s == {
        .Dot -> 0
        .Circle(r) -> r * r
    }
}

bare_area: fn(s: Shape) -> Int {
    if s == {
        .Dot -> 0
        Shape.Circle(r) -> r
    }
}

make: fn() -> Shape { Shape.Circle(2) }

dot: fn() -> Shape { Shape.Dot }
