# A file import links to the file it names, a workspace symbol query finds
# `run` in that file, and the opened document's entry and test get code lenses.
fixture: Fixtures/LSPDocumentLinksAndCodeLenses
session lsp content-length: jet self lsp
send lsp: Messages/LSPDocumentLinksAndCodeLenses/0.json
recv lsp
stdout: ~ "documentLinkProvider" # original predicate; response has absolute scratch paths/metadata
stdout: ~ "codeLensProvider" # original predicate; response has absolute scratch paths/metadata
send lsp: Messages/LSPDocumentLinksAndCodeLenses/1.json
send lsp: Messages/LSPDocumentLinksAndCodeLenses/2.json
recv lsp
stdout: ~ "publishDiagnostics" # original predicate; response has absolute scratch paths/metadata
send lsp: Messages/LSPDocumentLinksAndCodeLenses/3.json
recv lsp
stdout: ~ "\"target\"" # original predicate; response has absolute scratch paths/metadata
stdout: ~ "file://{work}/app/store.jet" # original predicate; response has absolute scratch paths/metadata
stdout: ~ "\"start\":{\"line\":0,\"character\":4}" # original predicate; response has absolute scratch paths/metadata
send lsp: Messages/LSPDocumentLinksAndCodeLenses/4.json
recv lsp
stdout: ~ "\"location\"" # original predicate; response has absolute scratch paths/metadata
stdout: ~ "file://{work}/app/store.jet" # original predicate; response has absolute scratch paths/metadata
send lsp: Messages/LSPDocumentLinksAndCodeLenses/5.json
recv lsp
stdout: ~ "\"title\":\"Run file\"" # original predicate; response has absolute scratch paths/metadata
stdout: ~ "\"command\":\"jet.runFile\"" # original predicate; response has absolute scratch paths/metadata
stdout: ~ "\"title\":\"Run test\"" # original predicate; response has absolute scratch paths/metadata
stdout: ~ "\"command\":\"jet.testFile\"" # original predicate; response has absolute scratch paths/metadata
send lsp: Messages/LSPDocumentLinksAndCodeLenses/6.json
recv lsp
stdout: ~ "result" # original predicate; response has absolute scratch paths/metadata
close lsp
exit: any # Original child.wait ignored status.
