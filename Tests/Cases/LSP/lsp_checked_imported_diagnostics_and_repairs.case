# The editor publishes what `jet check` reports for an imported file and the
# file importing it, at the unsaved text and version, and offers each repair
# only for the document it edits. A request range past a document's end
# covers the rest of that document. Once the unsaved text is saved, `jet
# check` (O0) and `jet build` at O1 and O2 report the same errors with the
# same meaning and recovery data the editor published: the optimize level
# does not change what a check reports.
fixture: LSPCheckedImportedDiagnosticsAndRepairs.fixture
session lsp content-length: jet self lsp
stderr: null
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"workspace\":{\"workspaceEdit\":{\"documentChanges\":true}}}}}"
recv lsp until $.id = 7
send lsp: "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/run.jet\",\"languageId\":\"jet\",\"version\":1,\"text\":\"use \\\"scoring\\\"\\nrun: fn() { print(scoring.letter(91)) }\\n\"}}}"
send lsp: "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/scoring.jet\",\"languageId\":\"jet\",\"version\":1,\"text\":\"letter: fn(score: Int, offset: Int) -> String {\\n    adjusted = score + offset\\n    return if {\\n        adjusted >= 90 -> \\\"A\\\"\\n        adjusted >= 80 -> \\\"B\\\"\\n        else -> \\\"C\\\"\\n    }\\n}\\nrepair_probe: fn() {\\n    m: [String:Int]{}\\n    _: m.gett(\\\"a\\\")\\n}\\n\"}}}"
send lsp: "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/scoring.jet\",\"version\":2},\"contentChanges\":[{\"text\":\"// unsaved 🚀\\n\\nletter: fn(score: Int, offset: Int) -> String {\\n    adjusted = score + offset\\n    return if {\\n        adjusted >= 90 -> \\\"A\\\"\\n        adjusted >= 80 -> \\\"B\\\"\\n        else -> \\\"C\\\"\\n    }\\n}\\nrepair_probe: fn() {\\n    m: [String:Int]{}\\n    _: m.gett(\\\"a\\\")\\n}\\n\"}]}}"
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/codeAction\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/run.jet\"},\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":9,\"character\":0}},\"context\":{\"diagnostics\":[]}}}"
recv lsp collect until ndjson $[?id=7] #>= 1
json: stdout ndjson $[?params.uri="file://{work}/scoring.jet"][-1].params.version = 2
json: stdout ndjson $[?params.uri="file://{work}/scoring.jet"][-1].params.diagnostics[?code="E0107"] #= 3
json: stdout ndjson $[?params.uri="file://{work}/scoring.jet"][-1].params.diagnostics[?code="E0107"][0].range.start.line = 3
json: stdout ndjson $[?params.uri="file://{work}/run.jet"][-1].params.diagnostics[?code="E0107"] #= 0
json: stdout ndjson $[?params.uri="file://{work}/run.jet"][-1].params.diagnostics[?code="E0766"][0].range = {"start":{"line":1,"character":26},"end":{"line":1,"character":32}}
json: stdout ndjson $[?params.uri="file://{work}/run.jet"][-1].params.diagnostics[?code="E0766"][0].message = "This call to `scoring.letter` is missing `offset`"
json: stdout ndjson $[?id=7][0].result[*].edit.documentChanges[*].edits[?newText in ["get","_repair_probe"]] #= 0
json: stdout ndjson $[?params.uri="file://{work}/scoring.jet"][-1].params.diagnostics[?code="E0107"][0].data.why = "An assignment changes a binding that is already declared, and nothing declares `adjusted`"
json: stdout ndjson $[?params.uri="file://{work}/scoring.jet"][-1].params.diagnostics[?code="E0107"][0].data.fix_edits[0].new_text = ":="
json: stdout ndjson $[?params.uri="file://{work}/scoring.jet"][-1].params.diagnostics[?code="E0107"][0].data.fix_edits[0].span.start = 78
json: stdout ndjson $[?params.uri="file://{work}/scoring.jet"][-1].params.diagnostics[?code="E0107"][0].data.applicability = "safe"
json: stdout ndjson $[?params.uri="file://{work}/scoring.jet"][-1].params.diagnostics[?code="E0311"][0].data.fix_edits[0].new_text = "get"
json: stdout ndjson $[?params.uri="file://{work}/scoring.jet"][-1].params.diagnostics[?code="E0311"][0].data.fix_edits[0].safety = "needs-review"
json: stdout ndjson $[?params.uri="file://{work}/scoring.jet"][-1].params.diagnostics[?code="E0311"][0].data.applicability = "suggested"
json: stdout ndjson $[?params.uri="file://{work}/run.jet"][-1].params.diagnostics[?code="E0766"][0].data.no_fix_reason.kind = "design"
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/codeAction\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/scoring.jet\"},\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":14,\"character\":0}},\"context\":{\"diagnostics\":[]}}}"
recv lsp until $.id = 7
json: stdout doc $.result[*].edit.documentChanges[*].edits[?newText="get"][0].range = {"start":{"line":12,"character":9},"end":{"line":12,"character":13}}
json: stdout doc each $.result[*].edit.documentChanges[*] as r: {r}.textDocument.uri = "file://{work}/scoring.jet" # each repair edits the unsaved document at its version
json: stdout doc each $.result[*].edit.documentChanges[*] as r: {r}.textDocument.version = 2 # each repair edits the unsaved document at its version
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"shutdown\",\"params\":{}}"
recv lsp until $.id = 7
close lsp
write: scoring.jet LSPCheckedImportedDiagnosticsAndRepairs.fixture/scoring_unsaved.template
step: jet check --json run.jet
exit: 1
json: stdout doc $.reports[?severity="error"] #= 5
json: stdout doc $.reports[?code="E0107"] #= 3
json: stdout doc $.reports[?code="E0107"][0].span.start = 69
json: stdout doc $.reports[?code="E0107"][0].why = "An assignment changes a binding that is already declared, and nothing declares `adjusted`"
json: stdout doc $.reports[?code="E0107"][0].fix_edits[0].new_text = ":="
json: stdout doc $.reports[?code="E0107"][0].fix_edits[0].span.start = 78
json: stdout doc $.reports[?code="E0107"][0].applicability = "safe"
json: stdout doc $.reports[?code="E0311"][0].fix_edits[0].new_text = "get"
json: stdout doc $.reports[?code="E0311"][0].fix_edits[0].safety = "needs-review"
json: stdout doc $.reports[?code="E0311"][0].applicability = "suggested"
json: stdout doc $.reports[?code="E0766"][0].message = "This call to `scoring.letter` is missing `offset`"
json: stdout doc $.reports[?code="E0766"][0].no_fix_reason.kind = "design"
step: jet build -O1 --json run.jet
exit: 1
json: stdout doc $.reports[?severity="error"] #= 5
json: stdout doc $.reports[?code="E0107"] #= 3
json: stdout doc $.reports[?code="E0107"][0].span.start = 69
json: stdout doc $.reports[?code="E0107"][0].why = "An assignment changes a binding that is already declared, and nothing declares `adjusted`"
json: stdout doc $.reports[?code="E0107"][0].fix_edits[0].new_text = ":="
json: stdout doc $.reports[?code="E0107"][0].fix_edits[0].span.start = 78
json: stdout doc $.reports[?code="E0107"][0].applicability = "safe"
json: stdout doc $.reports[?code="E0311"][0].fix_edits[0].new_text = "get"
json: stdout doc $.reports[?code="E0311"][0].fix_edits[0].safety = "needs-review"
json: stdout doc $.reports[?code="E0311"][0].applicability = "suggested"
json: stdout doc $.reports[?code="E0766"][0].message = "This call to `scoring.letter` is missing `offset`"
json: stdout doc $.reports[?code="E0766"][0].no_fix_reason.kind = "design"
step: jet build -O2 --json run.jet
exit: 1
json: stdout doc $.reports[?severity="error"] #= 5
json: stdout doc $.reports[?code="E0107"] #= 3
json: stdout doc $.reports[?code="E0107"][0].span.start = 69
json: stdout doc $.reports[?code="E0107"][0].why = "An assignment changes a binding that is already declared, and nothing declares `adjusted`"
json: stdout doc $.reports[?code="E0107"][0].fix_edits[0].new_text = ":="
json: stdout doc $.reports[?code="E0107"][0].fix_edits[0].span.start = 78
json: stdout doc $.reports[?code="E0107"][0].applicability = "safe"
json: stdout doc $.reports[?code="E0311"][0].fix_edits[0].new_text = "get"
json: stdout doc $.reports[?code="E0311"][0].fix_edits[0].safety = "needs-review"
json: stdout doc $.reports[?code="E0311"][0].applicability = "suggested"
json: stdout doc $.reports[?code="E0766"][0].message = "This call to `scoring.letter` is missing `offset`"
json: stdout doc $.reports[?code="E0766"][0].no_fix_reason.kind = "design"
