# Port of tests/lsp.rs:806-858.
# The snapshot pins every advertised capability. Each one's request is answered in the JetLSP test
# "initialize speaks only LSP, and every advertised provider's request is answered" and has an LSP case.
# Rust include_str marker-presence assertion is retired (Rust-source scan); public advertised coverage is retained.
# PENDING-SEAM(read_bytes): D-CHILD-READ-BYTES1 + CoreState2 + kit batch three.
session lsp content-length: jet self lsp
send lsp: Messages/LSPInitializeCapabilitiesHaveNamedTestCoverage/0.json
recv lsp
stdout: = lsp_initialize_capabilities_have_named_test_coverage.initialize.stdout
send lsp: Messages/LSPInitializeCapabilitiesHaveNamedTestCoverage/1.json
recv lsp
send lsp: Messages/LSPInitializeCapabilitiesHaveNamedTestCoverage/2.json
close lsp
exit: any # Original child.wait status was ignored.
