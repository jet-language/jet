# Unmarked fallible calls report E0434 diagnostics instead of faint `?` inlay
# hints; calls handled by `??`, `Never!` calls, and `print` calls report none.
session lsp content-length: jet self lsp
send lsp: Messages/LSPInlayHintsMarkFailurePropagation/0.json
recv lsp until $.id = 1
send lsp: Messages/LSPInlayHintsMarkFailurePropagation/1.json
recv lsp
json: stdout doc $.params.diagnostics #= 4
send lsp: Messages/LSPInlayHintsMarkFailurePropagation/2.json
recv lsp until $.id = 2
json: stdout doc $.result[?label="?"] #= 0
send lsp: Messages/LSPInlayHintsMarkFailurePropagation/3.json
recv lsp until $.id = 3
close lsp
