# Completion in an empty function body offers the module's functions, each
# with its checked signature as the item's detail.
session lsp content-length: jet self lsp
send lsp: Messages/LSPCompletionReturnsItems/0.json
recv lsp until $.id = 1
stdout: ~ "completionProvider" # the capability is advertised
send lsp: Messages/LSPCompletionReturnsItems/1.json
send lsp: Messages/LSPCompletionReturnsItems/2.json
send lsp: Messages/LSPCompletionReturnsItems/3.json
recv lsp collect until ndjson $[?id=2] #>= 1
json: stdout ndjson $[?id=2][0].result.items[?label="greet"] #= 1
json: stdout ndjson $[?id=2][0].result.items[?label="connect"] #= 1
json: stdout ndjson $[?id=2][0].result.items[?label="connect"][0].kind = 3
stdout: ~ "\"detail\":\"connect: fn(host: String, /, *, timeout seconds: Int) -> String" # the checked signature, positional and keyword zones included
send lsp: Messages/LSPCompletionReturnsItems/4.json
recv lsp until $.id = 99
close lsp
exit: 0
