# `jet test --browser-scaffold=<name>` creates an isolated browser test
# project: an app `jet dev` serves, browser-tests.conf naming chromium and
# that `jet dev` server, and a first test. Once jetpack pins chromium in the
# project's lock, `jet test` there starts `jet dev` (nothing serves its URL
# yet), opens the page in chromium and passes; the scaffold refuses a folder
# that already exists and a missing name.
env: NO_COLOR=1
step: jet test --browser-scaffold=demo
cwd: {work}
exit: 0
stderr: ~ "created demo/"
stderr: ~ "  home_test.jet"
stderr: ~ "  browser-tests.conf"
stderr: ~ "next: cd demo && jetpack browser lock chromium"
file: demo/browser-tests.conf ~ "browsers = chromium" # the configured browser
file: demo/browser-tests.conf ~ "server = reuse" # a running `jet dev` is reused
file: demo/browser-tests.conf ~ "webServer = jet dev run.jet" # else the run starts one
file: demo/run.jet ~ "web.app().route(\"/\", home).serve(4173)" # the app `jet dev` serves
file: demo/home_test.jet ~ "#Test(\"the home page greets the visitor\")" # the first test
step: jet fmt --check
cwd: {work}/demo
exit: 0
step: jet test --browser-scaffold=demo
cwd: {work}
exit: 1
stderr: ~ "`demo` already exists"
step: jet test --browser-scaffold
cwd: {work}
exit: 2
stderr: ~ "`--browser-scaffold` needs a value"
step: jet test --browser-scaffold=other home_test.jet
cwd: {work}
exit: 2
stderr: ~ "so it takes no target or filter, not `home_test.jet`"
file: other absent # a refused scaffold writes nothing
when probe chromium --version
when probe chromedriver --version
step: jetpack browser lock chromium --binary {tool:chromium} --driver {tool:chromedriver}
cwd: {work}/demo
env: JET_PROJECT_ROOT={work}/demo
exit: 0
step: jet test
cwd: {work}/demo
env: JET_PROJECT_ROOT={work}/demo
env: JET_APP_PORT={free-port:app}
env: JET_TEST_WEB_SERVER_URL=http://127.0.0.1:{free-port:app}/
exit: 0
stdout: ~ "the home page greets the visitor: pass"
stdout: ~ "1 passed, 0 failed, 0 skipped"
end when
end when
