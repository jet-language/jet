# browser.run_case runs each browser test on every engine browser-tests.conf
# names (chromium, then firefox, whatever the order written), in a fresh
# browser and context per attempt, and retries a failed attempt once. A test
# that fails on any engine fails the run: `jet test` exits 1 and the
# assertion's diagnostic lists one line per failing engine at the test's
# source position. A second run, with the text reporter, fails the same way.
env: NO_COLOR=1
copy: {root}/Tests/Cases/WebBrowser/Fixtures/CrossBrowser {work}/cross
when probe chromium --version
when probe chromedriver --version
when probe firefox --version
spawn app: jet run {work}/cross/run.jet
env: JET_APP_PORT={free-port:app}
stdout: null
poll ready: jet run {root}/Tests/Cases/WebBrowser/Fixtures/http-ready.jet 127.0.0.1:{free-port:app} / - write until stdout: ^= "HTTP/1.1 200" timeout 60s every 50ms # the app serves its root page
step: jetpack browser lock chromium --binary {tool:chromium} --driver {tool:chromedriver}
cwd: {work}/cross
env: JET_PROJECT_ROOT={work}/cross
exit: 0
step: jetpack browser lock firefox --binary {tool:firefox}
cwd: {work}/cross
env: JET_PROJECT_ROOT={work}/cross
exit: 0
step: jet test
cwd: {work}/cross
env: JET_PROJECT_ROOT={work}/cross
env: JET_TEST_WEB_SERVER_URL=http://127.0.0.1:{free-port:app}/
exit: 1
stdout+stderr: ~ "browser cases run on every engine: FAIL"
stdout+stderr: ~ "cross_test.jet:18:13: `banner` failed on chromium after 2 attempts: browser operation timed out" # the failing test's source position
stdout+stderr: ~ "cross_test.jet:18:13: `banner` failed on firefox after 2 attempts: browser operation timed out"
stdout+stderr: !~ "`greeting` failed" # the passing test reports nothing
stdout+stderr: ~ "--> cross_test.jet:29" # Jet's diagnostic at the assertion
file: cross/.jet/browser-tests/report.json ~ "\"summary\": \"1 passed, 1 failed, 0 skipped\""
file: cross/.jet/browser-tests/report.json ~ "\"exitCode\": 1"
file: cross/.jet/browser-tests/report.json ~ "\"engine\": \"firefox\",\n          \"attempt\": 1,\n          \"passed\": false"
step: jet test
cwd: {work}/cross
env: JET_PROJECT_ROOT={work}/cross
env: JET_TEST_WEB_SERVER_URL=http://127.0.0.1:{free-port:app}/
env: JET_TEST_REPORTER=text
env: JET_TEST_REPORT={work}/cross/report.txt
exit: 1
stdout+stderr: ~ "cross_test.jet:18:13: `banner` failed on chromium after 2 attempts: browser operation timed out"
stdout+stderr: ~ "cross_test.jet:18:13: `banner` failed on firefox after 2 attempts: browser operation timed out"
file: cross/report.txt ~ "Browser tests: 1 passed, 1 failed, 0 skipped"
file: cross/report.txt ~ "FAIL banner [chromium] attempt=1"
file: cross/report.txt ~ "FAIL banner [firefox] attempt=1"
signal app: KILL
wait: app
exit: any # the server is killed
end when
end when
end when
