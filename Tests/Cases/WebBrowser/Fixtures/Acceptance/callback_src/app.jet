// A browser click runs a Jet handler that calls a #Export(wasm) function
// and prints its answer: the callback and the compute round-trip in one page.
use ui: core.ui

#Export(wasm)
double: fn(n: Int) -> Int { n * 2 }

run: fn() {
    backend: ui.null_backend()
    tree: ui.box(
        [
            ui.button("go", fn() {
                if (double(21) ?? 0) == 42 -> print("42")
            }),
        ],
    )
    ui.mount(backend, tree, ui.constraint(0.0, 0.0, 200.0, 60.0))
}
