// Browser acceptance fixture: a later paint drops a child node from the
// tree, and the next one restores it.
use {
    ui: core.ui
    reactive: core.reactive
}

run: fn() {
    shown: reactive.signal(true)
    ui.reactive_render(fn() {
        backend: ui.null_backend()
        nodes := [ui.node("keep", 80.0, 24.0)]
        if shown.get() -> nodes.push(ui.node("drop", 80.0, 24.0))
        nodes.push(ui.button("hide", fn() { shown.set(false) }))
        nodes.push(ui.button("show", fn() { shown.set(true) }))
        ui.mount(backend, ui.box(nodes), ui.constraint(0.0, 0.0, 240.0, 120.0))
    })
}
