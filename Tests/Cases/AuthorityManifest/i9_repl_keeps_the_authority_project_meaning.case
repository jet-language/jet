# A REPL over the authority project loads its source (never its manifest)
# and runs its `run` with the comptime value the other tiers print.
fixture: I9ReplKeepsTheAuthorityProjectMeaning.fixture
env: NO_COLOR=1
step: jet repl --project .
stdin: i9_repl_keeps_the_authority_project_meaning.stdin
exit: 0
stdout: ~ "Project: loaded 1 source file(s)" # run.jet is the only source; package.jet is the manifest
stdout: ~ "> authority" # the project's run prints its comptime ANSWER
stderr: !~ "Error" # the manifest is never checked as session source
