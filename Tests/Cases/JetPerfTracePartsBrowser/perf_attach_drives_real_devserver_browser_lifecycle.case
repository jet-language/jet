# PORT + support.rs37-72 exact TCP HTTP polling/nonce algorithm.
# PENDING-GRAMMAR(batch-four); PENDING-SAME-HEAD; no mock relay, shell, or blessed bytes.
# have_rustc is toolchain-availability, erased per owner. Real public dev lifecycle remains.
# The devserver runs under the authorizer, so jet may trace it, as an attach needs.
requires: os-name:linux
requires: tool:cc
fixture: PerfAttachDrivesRealDevServerBrowserLifecycle.fixture
copy: {root}/Tests/Fixtures/Ptrace/authorizer.c authorizer.c
step: cc authorizer.c -o authorizer
exit: 0
spawn dev: {work}/authorizer {jet} dev app.jet --target=web --port={free-port:browser}
stdout: null
stderr: null
step: jet test client/browser_client.jet
env: S6_BROWSER_PORT={free-port:browser}
env: S6_BROWSER_PHASE=initial
exit: 0
spawn attach: jet perf attach {pid:dev} --out browser.jettrace
step: jet test client/browser_client.jet
env: S6_BROWSER_PORT={free-port:browser}
env: S6_BROWSER_PHASE=attached
exit: 0
wait: attach
exit: 0
capture: took = elapsed
file: browser.jettrace is-file
json: file browser.jettrace doc $.content.profile.window_status = "live" # the header's window is the attach's, from its first read of the devserver to its relay's rows
json: file browser.jettrace doc $.content.profile.window_wall_ns <= {cap:took}+0 # no more than the attach took, not the run since it started
json: file browser.jettrace doc $.content.receipt_sections[?name="window"][0].value.cpu_clock = "schedstat" # counted to the nanosecond
# Public view calls read_verified -> verify_jettrace (CmdPerf.rs2143/3404-3405), original hash-valid oracle.
step: jet perf view browser.jettrace
exit: 0
stdout: ~ " window=live run_wall=" # the header's window is the attach's
file: browser.jettrace ~ "\"name\":\"handlers__init$handler0\"" # original trace contains the handler frame name
step: jet test client/browser_client.jet
env: S6_BROWSER_PORT={free-port:browser}
env: S6_BROWSER_PHASE=active
exit: 0
write: app.jet rebuilt.jet.txt
step: jet test client/browser_client.jet
env: S6_BROWSER_PORT={free-port:browser}
env: S6_BROWSER_PHASE=rebuilt
exit: 0
signal dev: KILL
wait: dev
exit: any # Original ChildGuard::kill + wait, status unasserted.
