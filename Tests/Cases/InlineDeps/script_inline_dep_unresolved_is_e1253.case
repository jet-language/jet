# Port of tests/inline_deps.rs::script_inline_dep_unresolved_is_e1253 (106-125), under D-JPK-SCRIPTDEP1=A:
# `jet check` never fetches, so an unknown inline dependency is Jet.UnresolvedInlineDependency; `jet run`
# fetches it from the configured registry, here an absent one (Jet.RegistryUnreachable), and
# leaves no lock or local copy behind.
fixture: Ghost.fixture
env: JET_STORE_DIR={work}/.jet-test-cache
step: jet check stats.jet
exit: nonzero
stderr: ~ Jet.UnresolvedInlineDependency # the name; Tests/UI/inline_dep_unresolved owns the full report
step: jet run stats.jet
env: JET_REGISTRY_URL=file://{work}/absent.git
env: JET_REGISTRY_CACHE_DIR={work}/cache
exit: nonzero
stderr: ~ Jet.RegistryUnreachable # the name; the unreachable-registry report text is covered by pkg/cli_publish_unreachable_registry_e1235
file: stats.jet.lock absent
file: .jet/inline-deps absent
