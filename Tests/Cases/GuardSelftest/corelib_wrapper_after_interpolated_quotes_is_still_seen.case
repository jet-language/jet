# A quote nested in a string interpolation must not end the string, so the
# function after it is still seen opening #Unsafe. Runs the Jet ratchet checker.
fixture: Fixtures/Ratchet
copy: interpolated-quotes.txt Core/Sys/Sys.jet
step: jet {root}/Tools/Agent/UnsafeRatchet.jet --root {work} --baseline {work}/safety.md --update
exit: nonzero
stderr: ~ "fn fork opens #Unsafe" # the report names the unrecorded abstraction
