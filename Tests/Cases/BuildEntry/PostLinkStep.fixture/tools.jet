use {
    build: core.build
    compiler: core.compiler
}

// A post-link step that signs the executable: its command copies the linked
// file to the path it writes next and appends a signature line naming the
// output, past the end of the image, where the loader never reads.
#On(build.before_write) sign: fn(artifact: compiler.Artifact) -> build.BuildAction {
    build.action("sign", run: ["sh", "-c", "cat \"$0\" > \"$1\" && printf 'JETSIG %s\\n' \"$2\" >> \"$1\" && chmod +x \"$1\"", artifact.path, artifact.next, artifact.output], inputs: [artifact.path], outputs: [artifact.next], allow: [.Exec, .FS])
}
