# The Choice row `inline` (auto, always_marked, off; stock auto) says
# which unmarked callees the optimizer inlines. `mix` is marked
# `#Inline(Always)` and past the O1 callee limit, `bump` is small and
# unmarked: every value inlines each call of `mix` (the mark is a guarantee,
# kept past the size limits and under `off`), auto `bump` too. A callee
# spliced at every call is unreached, so `dead_code: remove` (the stock)
# drops it and the image does not name it; always_marked and off keep
# `bump` and its name. The program prints the same under every value.
fixture: Fixtures/BuildInline
env: NO_COLOR=1
step: jet build main.jet
cwd: open
exit: 0
rename: open/.jet/build/main open/.jet/build/main_auto
file: open/.jet/build/main_auto !~ "bump" # auto splices `bump` at every call
step: {work}/open/.jet/build/main_auto
exit: 0
stdout: = "mixed: 400255\n"
step: jet inspect choices -O2 main.jet
cwd: open
exit: 0
stdout: ~ "in stage_one: mix inlined: marked #Inline(Always)" # auto takes the marked `mix` past the O1 callee limit
stdout: ~ "in stage_one: bump inlined: cost " # and the small `bump` by size
step: jet inspect choices -O1 main.jet
cwd: open
exit: 0
stdout: ~ "in stage_three: mix inlined: marked #Inline(Always)" # at O1 too
step: jet inspect choices -O2 --inline=off main.jet
cwd: open
exit: 0
stdout: ~ "in stage_two: mix inlined: marked #Inline(Always)" # off keeps the marked `mix` inlined
stdout: !~ "bump inlined" # and takes no unmarked callee
step: jet build --inline=off main.jet
cwd: open
exit: 0
file: open/.jet/build/main ~ "bump" # off inlines no unmarked callee, so `bump` stays a function
rename: open/.jet/build/main open/.jet/build/main_off
step: {work}/open/.jet/build/main_off
exit: 0
stdout: = "mixed: 400255\n"
step: jet build --profile=marked main.jet
cwd: open
exit: 0
file: open/.jet/build/main ~ "bump" # always_marked takes only marked callees
step: {work}/open/.jet/build/main
exit: 0
stdout: = "mixed: 400255\n"
step: jet build --inline=always_marked -O2 --small main.jet
cwd: open
exit: 0
step: jet build --inline=sometimes main.jet
cwd: open
exit: 2
stderr: ~ "Error: Jet.InvalidCommandInput: `--inline=sometimes` isn't a value of `inline`" # auto, always_marked or off
step: jet build
cwd: code
exit: 0
stderr: !~ "note:" # no flag replaces a written value
step: jet build --inline=always_marked
cwd: code
exit: 0
stderr: ~ "note: --inline=always_marked replaces b.inline(.Off) at build.jet:2 for this run" # the replace note spells the Choice call
