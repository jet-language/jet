package: { name: "main", authority: { allow: [Meta.Code.Rewrite] } }

build: fn(b: Build) -[Meta.Code.Rewrite]> {
    app: b.add_executable("app", ["main.jet"], [])
    meta: b.compiler(app)
    meta.rewrite_body(
        greeting,
        #code {
            print("before")
            #{greeting.body}
            print("after")
        },
    )
    b.default(app)
}

run: fn() { greeting() }

greeting: fn() {
    name: "hand"
    if name != "" -> print("written by {name}")
}
