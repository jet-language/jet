package: { name: "main", authority: { allow: [Meta.Code.Rewrite] } }

build: fn(b: Build) -[Meta.Code.Rewrite]> {
    app: b.add_executable("app", ["main.jet"], [])
    meta: b.compiler(app)
    meta.rewrite_body(
        greeting,
        #code {
            print("rewritten by the build")
            print(farewell())
        },
    )
    b.default(app)
}

run: fn() { greeting() }

greeting: fn() { print("written by hand") }

farewell: fn() -> String { "the rest of the file stays" }
