// `core.math.abs` (Core) and `geom.gap` (a dependency package) are both
// `#Inline(Always)`: each call below is spliced into its caller, so the image
// holds neither function. `Int.abs()` calls the same `abs`. The arguments are
// parameters, so no call folds at build time.
use {
    core.math.abs
    geom
}

distance: fn(a: Int, b: Int) -> Int { abs(a - b) }

magnitude: fn(n: Int) -> Int { n.abs() }

spread: fn(a: Int, b: Int) -> Int { geom.gap(a, b) }

run: fn() { print("{distance(2, 9)} {distance(5, 0)} {magnitude(-3)} {spread(4, 1)}") }
