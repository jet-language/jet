// Source text is unparsed code, so a row that denies `Meta.Code.Raw` refuses it.
package: { name: "main", authority: { allow: [Meta.Code.Types] } }

build: fn(b: Build) -[!Meta.Code.Raw]> {
    app: b.add_executable("app", ["main.jet"], [])
    meta: b.compiler(app)
    meta.add("Shape: struct {{\n    id: I64,\n}}\n", scope: "shape")
    b.default(app)
}

run: fn() { print(Shape{id: I64{40}}.id) }
