use {
    build: core.build
    compiler: core.compiler
}

// A link step that links nothing: its command checks that the program
// object it reads is there and writes, as the executable, a script naming
// it. The build sandbox shows a step none of the host's programs, so the
// `chmod` it runs is the package's own, an input as the object is.
#On(build.link) relink: fn(inputs: compiler.LinkInputs) -> build.BuildAction {
    object: inputs.objects[0]
    script: "#!/bin/sh\necho 'relinked {inputs.output_name} from {object}'\n"
    build.action("relink", run: ["sh", "-c", "test -s \"$2\" && printf '%s' \"$0\" > \"$1\" && ./bin/chmod +x \"$1\"", script, inputs.output, object], inputs: [object, "bin/chmod"], outputs: [inputs.output], allow: [.Exec, .FS])
}
