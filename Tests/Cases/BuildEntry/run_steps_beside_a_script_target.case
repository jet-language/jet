# A script target reads only its own file, so it compiles while a step that
# writes another file runs: `gen`, a `#!` script built for this machine,
# compiles beside the `word` step, then `table` runs gen on word's output to
# write the source `show` compiles.
fixture: Fixtures/RunStepsBesideAScriptTarget
artifact: show
requires: tool:sh
requires: tool:bwrap
env: NO_COLOR=1
step: jet build main.jet --allow=Exec,FS
exit: 0
file: word.txt = "forty-two" # the step beside the compile wrote its output
file: .jet/build/host/gen exists # the script's host build, never installed
file: show.jet ~ "forty-two" # gen read word's output
step: built
stdout: = "forty-two\n"
