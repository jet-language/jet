# An ordinary effectful helper behaves the same in a permitted build as in the program.
# When the package holds `Meta.Host`, the `#Impure` block of `build: fn` calls the program's own
# helper, whose `files.read` runs natively in the compile-time child; the build writes what it
# read, and the built program prints what it reads, byte for byte the same, on every optimization
# level. Without `Meta.Host` the same read is refused with E3411 and nothing is written.
fixture: Fixtures/ImpureFileCallsRunNativelyWhileBuilding
env: NO_COLOR=1
env: JET_STORE_DIR={work}/store
step: jet build
exit: 1
stderr: ~ "inside `#Impure` is a Tier-2 comptime effect, but its package doesn't hold `Meta.Host`" # the package without Meta.Host refuses the helper's read
file: build-read.txt absent
file: .jet/build/app absent
step: jet build --gate impure=allow
exit: 2
stderr: ~ "reaching the host while compiling is the expert effect `Meta.Host`" # no flag opens it
write: package.jet = "name: \"impure_file_calls_run_natively_while_building\"\nversion: \"0.1.0\"\nauthority: {\n    allow: [IO, FS, Meta.Host]\n}\n"
step: jet build -O0
exit: 0
file: build-read.txt = "hello from the file\ncan't read missing.txt: not found during read `missing.txt`: No such file or directory (os error 2)\n" # what the build read (O0)
step: {work}/.jet/build/app
exit: 0
stdout: = "hello from the file\ncan't read missing.txt: not found during read `missing.txt`: No such file or directory (os error 2)\n"
remove: build-read.txt
step: jet build -O1
exit: 0
file: build-read.txt = "hello from the file\ncan't read missing.txt: not found during read `missing.txt`: No such file or directory (os error 2)\n" # what the build read (O1)
step: {work}/.jet/build/app
exit: 0
stdout: = "hello from the file\ncan't read missing.txt: not found during read `missing.txt`: No such file or directory (os error 2)\n"
remove: build-read.txt
step: jet build -O2
exit: 0
file: build-read.txt = "hello from the file\ncan't read missing.txt: not found during read `missing.txt`: No such file or directory (os error 2)\n" # what the build read (O2)
step: {work}/.jet/build/app
exit: 0
stdout: = "hello from the file\ncan't read missing.txt: not found during read `missing.txt`: No such file or directory (os error 2)\n"
