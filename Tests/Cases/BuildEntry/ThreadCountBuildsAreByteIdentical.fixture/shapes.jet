Point: struct {
    x: Int,
    y: Int,
}

Rect: struct {
    origin: Point,
    width: Int,
    height: Int,
}

rect: fn(width: Int, height: Int) -> Rect {
    Rect{origin: Point{x: 1, y: 2}, width: width, height: height}
}

area: fn(shape: Rect) -> Int { shape.width * shape.height }

corner: fn(shape: Rect) -> Point {
    Point{x: shape.origin.x + shape.width, y: shape.origin.y + shape.height}
}
