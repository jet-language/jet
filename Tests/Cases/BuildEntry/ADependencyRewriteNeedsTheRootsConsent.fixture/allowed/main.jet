use greet

build: fn(b: Build) -[Meta.Code.Rewrite]> {
    app: b.add_executable("app", ["main.jet"], [])
    meta: b.compiler(app)
    meta.allow_rewrite(package: "greet")
    meta.rewrite_body(
        greet.hello,
        #code {
            "rewritten by the root"
        },
    )
    b.default(app)
}

run: fn() { print(greet.hello()) }
