# The link hook rows. `link` is `default` or a hook path and `post_link` a
# list of hook paths, written unquoted in a profile, as flags (one
# `--post-link` per step) and in `build: fn`. A value that is no hook path is
# refused. Only `jet build` runs link and post-link hooks: a link hook that
# returns `inputs.default` links with Jet, and a hook no function marks
# `#On(build.link)` or `#On(build.before_write)` is E3506, which leaves no
# executable. Every other command refuses either hook with E2104 naming
# where it was written.
fixture: Fixtures/LinkHooks
artifact: app
env: NO_COLOR=1
step: jet build --link=default app.jet
cwd: open
exit: 0
file: open/.jet/build/app exists # `default` is Jet's own link
step: {work}/open/.jet/build/app
exit: 0
stdout: = "linked\n"
step: jet build --link=tools.relink app.jet
cwd: open
exit: 0
file: open/.jet/build/link/app/app.o exists # the hook got the program object
step: {work}/open/.jet/build/app
exit: 0
stdout: = "linked\n" # `inputs.default` is Jet's own link
step: jet run --link=relink app.jet
cwd: open
exit: 2
stderr: ~ "`--link=relink` isn't a value of `link`" # a hook path names its module
stderr: ~ "default or a hook path such as tools.relink" # the fix names the shape
step: jet build --post-link=tools.sign --post-link=tools.notarize app.jet
cwd: open
exit: nonzero
stderr: ~ "`--post-link=tools.sign --post-link=tools.notarize` names `tools.sign`, which is no function marked `#On(build.before_write)`" # each flag is one more step, and the first runs first
stderr: ~ "jet-lang.dev/e/E3506" # the post-link step's code
file: open/.jet/build/app absent # a failed post-link step leaves no executable
step: jet run --profile=relinked app.jet
cwd: open
exit: 2
stderr: ~ "`link: tools.relink` in profile `relinked` of package.jet names a link hook, and `jet run` links every image itself" # the profile field is the site
step: jet run --profile=signed app.jet
cwd: open
exit: 2
stderr: ~ "`post_link: [tools.sign]` in profile `signed` of package.jet names steps to run on each linked executable, and `jet run` writes none" # a profile lists its steps unquoted
step: jet build --profile=bare app.jet
cwd: refused_profile
exit: 2
stderr: ~ "`link: relink` in profile `bare` of package.jet isn't a value of `link`" # a profile's value is checked as a flag's is
step: jet build
cwd: code
exit: nonzero
stderr: ~ "`b.link(tools.relink)` at build.jet:2 names `tools.relink`, which is no function marked `#On(build.link)`" # fn build writes the hook as a path
stderr: ~ "jet-lang.dev/e/E3506" # the link step's code
