# Claim: `build.action(name, run:, inputs:, outputs:, allow:)` of core.build
# makes a `BuildAction`, a step as a plain value: its name, the command it
# runs, the files it reads and makes, and the effects it may use, read back
# as written. Making one runs nothing.
fixture: BuildActionDescribesAStep.fixture
env: NO_COLOR=1
step: jet run main.jet
exit: 0
stdout: = build_action_describes_a_step.out
stderr: empty
