// Eighteen steps, each reading the Jet source the one before made: the last
// would generate in round 18, past the limit of 17.
build: fn(b: Build) -[Exec, FS]> {
    #Impure("run the generating steps") {
        shell: b.probe("shell", "find_program", "sh")
        loop index in 0..<18 {
            step: b.run("gen{index}", b.found(shell), ["Exec", "FS"])
            if index > 0 -> step.reads(".jet/generated/rounds/gen{index - 1}.jet")
            step.writes(".jet/generated/rounds/gen{index}.jet")
        }
    }
}

run: fn() {}
