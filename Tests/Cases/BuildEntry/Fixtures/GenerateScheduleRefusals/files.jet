// `stamp` reads the plain file it makes: a step cycle, not a generation one.
build: fn(b: Build) -[Exec, FS]> {
    #Impure("run the step") {
        shell: b.probe("shell", "find_program", "sh")
        stamp: b.run("stamp", b.found(shell), ["Exec", "FS"])
        stamp.reads("stamp.txt")
        stamp.writes("stamp.txt")
        app: b.add_executable("app", ["files.jet"], [stamp])
        b.default(app)
    }
}

run: fn() {}
