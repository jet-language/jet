use http: core.http

// A written row is a ceiling, so query's solved row holds Net because its
// body reaches the network. The URL is a parameter, so the row names Net
// itself, not a host it is scoped to.
query: fn(url: String) -[Net]> Int {
    got: http.get(url) ?? return 0
    got.status
}

relay: fn(url: String) -> Int { query(url) }

add: fn(a: Int, b: Int) -> Int { a + b }

build: fn(b: Build) {
    loop f in b.program.functions() {
        effects: f.signature.effects
        if f.name == "query" {
            if effects.declared == .Val(row) && row.len() == 1 && row[0] == "Net" {
                b.error(f.span, "DECLARED", "the written row", "EffectInfo.declared", "ok")
            }
            if effects.inferred != None {
                b.error(f.span, "SOLVED", "the checked row", "EffectInfo.inferred", "ok")
            }
        }
        if f.name == "relay" {
            if effects.declared == None {
                b.error(f.span, "UNWRITTEN", "no written row", "EffectInfo.declared", "ok")
            }
            if effects.inferred == .Val(row) && row.contains("Net") && effects.values.contains("Net") {
                b.error(f.span, "INFERRED", "the body's Net", "EffectInfo.inferred", "ok")
            }
        }
        if f.name == "add" && effects.inferred == .Val(row) && row.len() == 0 {
            b.error(f.span, "PURE", "an empty solved row", "EffectInfo.inferred", "ok")
        }
    }
}

run: fn() { print(relay("http://127.0.0.1:9/") + add(1, 2)) }
