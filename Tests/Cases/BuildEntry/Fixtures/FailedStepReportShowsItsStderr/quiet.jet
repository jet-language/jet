// A step that fails without writing anything to stderr.
build: fn(b: Build) -[Exec, FS]> {
    #Impure("run the failing step") {
        shell: b.probe("shell", "find_program", "sh")
        fail: b.run("fail", b.found(shell), ["Exec", "FS"])
        fail.arg("-c")
        fail.arg("exit 3")
        fail.writes("out.txt")
        app: b.add_executable("app", ["quiet.jet"], [fail])
        b.default(app)
    }
}

run: fn() {}
