// A step that would write Jet source next to the project, outside it.
build: fn(b: Build) -[Exec, FS]> {
    #Impure("find the shell") {
        b.generate("facts") {
            answer: fn() -> Int { 42 }
        }
        shell: b.probe("shell", "find_program", "sh")
        make: b.run("make", b.found(shell), ["Exec", "FS"])
        make.arg("-c")
        make.arg("cp models.txt ../models.jet")
        make.writes("../models.jet")
    }
}

run: fn() {}
