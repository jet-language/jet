# A BuildError's record already is a default Err, so interpolating one shows
# that Err's message under Display and Debug alike, never the compiler's word
# for the value.
fixture: Fixtures/ABuildErrorShowsAsItsDefaultErr
step: jet build main.jet
exit: nonzero
stderr: ~ "display=[target name `app` is registered twice] debug=[target name `app` is registered twice]"
