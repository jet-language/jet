use {
    build: core.build
    compiler: core.compiler
}

// A hook of the settled moment takes the `compiler.Round` that
// `compiler.Event.Settled` carries.
#On(compiler.settled) settled: fn(round: compiler.Round) { print("settled {round.round}") }

// A hook of the link moment takes the `compiler.LinkInputs` that
// `compiler.Event.Link` carries and returns the step that links the output,
// here Jet's own.
#On(build.link) linked: fn(inputs: compiler.LinkInputs) -> build.BuildAction { inputs.default }

run: fn() { print("ran") }
