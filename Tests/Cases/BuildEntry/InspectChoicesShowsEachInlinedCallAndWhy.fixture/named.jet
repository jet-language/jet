// A call of another function with the marked one's name is no recursion:
// `exists` calls core.files' `exists` through its import, and `close`
// closes the field it holds, not itself.
use files: core.files

Probe: struct {
    path: String,

    #Inline(Always) exists: fn(self) -> Bool { files.exists(self.path) }
}

Inner: struct {
    id: Int,

    impl Close {
        close: fn(^^self) { print("inner {self.id} closed") }
    }
}

Outer: struct {
    inner: Inner,

    impl Close {
        #Inline(Always) close: fn(^^self) { close(self.inner) }
    }
}

run: fn() {
    print(Probe{path: "/"}.exists())
    outer: Outer{inner: Inner{id: 1}}
    close(outer)
}
