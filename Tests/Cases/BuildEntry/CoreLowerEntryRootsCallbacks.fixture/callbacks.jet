// Helper reached only from the Jet function-value callback `double`.
double_step: fn(value: Int) -> Int { value * 2 }

double: fn(value: Int) -> Int { double_step(value) }

// Reached only through a comptime-held function table.
triple: fn(value: Int) -> Int { value * 3 }

// Nothing reaches `unused_callback`.
unused_callback: fn(value: Int) -> Int { value * 7 + 1 }
