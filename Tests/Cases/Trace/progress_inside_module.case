# A traced build of one large module, written by gen.jet, reports progress
# inside the module's phases. In sema.bodies the compiler threads check the
# module's bodies as one body stream before its module span opens (the span
# is written once the stream hands the module's result back), and the calling
# thread reports the bodies claimed so far as `sema.bodies` progress directly
# under the phase: each claim it takes whose ranks meet the progress stride.
# lower reports the rows its reachability has read.
fixture: ProgressInsideModule.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/store
step: jet run --allow=FS gen.jet
exit: 0
stdout: = ""
step: jet build -O0 --threads 4 --trace main.jet
exit: 0
stderr: ~ "]     ~ sema.bodies " # the threads' claims report under sema.bodies itself, before main's module span opens
stderr: ~ "]   ~ lower " # lower reports the rows its reachability has read
