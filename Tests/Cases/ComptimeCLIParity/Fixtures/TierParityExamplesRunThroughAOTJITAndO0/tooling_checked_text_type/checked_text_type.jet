#Error
TextError: enum {
    Empty,
}

Token: distinct String

impl Token.CheckedText {
    Error: TextError,

    check: fn(parts: [String]) -[]> Checked<[String], TextSlot> TextError! {
        if parts.join("") == "" -> return Err(TextError.Empty)
        return Ok(Checked{shape: parts.copy(), slots: [TextSlot]{}})
    }

    encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> String { return "[{value}]" }
}

show: fn(value: Token) {
    #Unsafe("checked text example output") { print(value.raw()) }
}

run: fn() {
    literal: Token{"accepted {7}"}
    show(literal)

    if Token.from("accepted") == {
        .Ok(value) -> { show(value) }
        .Err(_) -> print("rejected")
    }
}
