# `_` in an `if` header is no longer a hole. A table header written with `_`
# is refused (E0443) with a fix that writes `<>`, nothing reads it as a hole
# or an alias, and `_` read as a value is no name (E0107). The respelled
# table runs.
fixture: OldHeaderRefused.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step header: jet check main.jet
exit: 1
stderr: ~ "An `if` table's hole is written `<>`, not `_`" # the E0443 headline
stderr: ~ "Fix: Write `<>` in place of `_`" # its fix writes the new hole
stderr: ~ "E0443" # the old-hole code
step value: jet check value.jet
exit: 1
stderr: ~ "`_` is not a name, so it has no value to read" # no hole outside a header either
stderr: ~ "E0107" # the unknown-name code
step respelled: jet run -O0 respelled.jet
exit: 0
stdout: = "Fizz\n7\n"
stderr: empty
