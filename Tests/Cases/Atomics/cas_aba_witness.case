# Compare-and-swap on an exact Int atomic is ABA-free on O0, O1 and O2.
# Incrementing tasks race with tasks that keep swapping the cell's number for
# a freshly built equal number and freeing the old one, so freed memory is
# reused while incrementers still hold their loaded value. Each swap compares
# the same raw word whose owner it holds, so a reused address can never pass
# for the loaded value, and every increment lands exactly once.
fixture: Fixtures/CASAba
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 0
step: jet run -O0 main.jet
exit: 0
stdout: = "increments landed 8000 of 8000\nevery increment landed once true\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "increments landed 8000 of 8000\nevery increment landed once true\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "increments landed 8000 of 8000\nevery increment landed once true\n"
