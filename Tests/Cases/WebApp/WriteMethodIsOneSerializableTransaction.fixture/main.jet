// Two concurrent calls of the mounted `move_task` on one version of a card.
// A call reads the card, checks the version it was given, waits a moment and
// writes the next version. Each call is one transaction on the board's store,
// so the later call's read waits until the earlier call has committed; it then
// finds the version moved on and gives Conflict. Without the transaction both
// would read the same version and both would move the card. A call whose
// reply is a failure rolls back what it wrote. Calls through a Remote that
// `app.remote` made, which run the method in this process, are transactions
// the same way.
use {
    app
    db: core.db
    time: core.time
    web: core.web
}

#Codable
Card: struct {
    id: Int,
    column: String,
    version: Int,
}

#Error
MoveError: enum {
    Conflict(Int),
    Missing,
    Failed(String),
    Unreachable(String),
}

impl app.CallError -> MoveError {
    if self == {
        .Unreachable(why) -> MoveError.Unreachable(why)
        .Invalid(errors) -> MoveError.Unreachable("{errors.len()} invalid arguments")
        .SignedOut -> MoveError.Unreachable("signed out")
        .UpdateRequired -> MoveError.Unreachable("update required")
    }
}

cards_in: fn(store: db.Store) -> db.Table<Int, Card> {
    store.table("cards", key: fn(card: Card) { card.id })
}

// Card `id` as `cards` holds it now.
card_now: fn(cards: db.Table<Int, Card>, id: Int) -[DB.Read]> Card MoveError! {
    if cards.get(id) == {
        .Val(card) -> Ok(card)
        .None -> Err(MoveError.Missing)
        .Err(failure) -> Err(MoveError.Failed(failure.message()))
    }
}

Board: struct {
    store: db.Store,

    // Moves card `id`, last seen at `version`, to `column`, and gives its
    // next version; Conflict, with the current version, when it has moved on.
    #App.Public move_task: fn(self, id: Int, version: Int, column: String) -> Int MoveError! {
        cards: cards_in(self.store)
        card: card_now(cards, id) ?? return Err(err)
        if card.version != version -> return Err(MoveError.Conflict(card.version))
        // Long enough for the other call to arrive while this one holds the card.
        time.sleep(100ms)
        _: cards.put(Card{id: id, column: column, version: version + 1}) ?? return Err(MoveError.Failed(err.message()))
        Ok(version + 1)
    }

    // Moves card `id` to `column` and then fails, so the move rolls back.
    #App.Public move_then_fail: fn(self, id: Int, column: String) -> Int MoveError! {
        cards: cards_in(self.store)
        card: card_now(cards, id) ?? return Err(err)
        _: cards.put(Card{id: id, column: column, version: card.version + 1}) ?? return Err(MoveError.Failed(err.message()))
        Err(MoveError.Failed("refused after the move"))
    }
}

refused: fn(failure: MoveError) -> String Never! {
    if failure == {
        .Conflict(current) -> "conflict at version {current}"
        .Missing -> "no such card"
        .Failed(why) -> "failed: {why}"
        .Unreachable(why) -> "unreachable: {why}"
    }
}

// One call of `move_task`, which moves card `id` from `version` to `column`.
move: fn(board: app.Remote<Board>, id: Int, version: Int, column: String) -> String Never! {
    next: board.move_task(id, version, column) ?? return refused(err)
    "moved to version {next}"
}

// A call of `move_then_fail` on card `id`.
move_and_fail: fn(board: app.Remote<Board>, id: Int) -> String Never! {
    next: board.move_then_fail(id, "archived") ?? return refused(err)
    "moved to version {next}"
}

card_line: fn(store: db.Store, id: Int) -> String Never! {
    card: card_now(cards_in(store), id) ?? return refused(err)
    "card {id} is at version {card.version}"
}

// The outcomes of two calls that ran at once, in an order that does not
// depend on which ran first.
settled: fn(first: ^^Task<String>, second: ^^Task<String>) {
    outcomes := [String]{first.join() ?? "the first call's task failed", second.join() ?? "the second call's task failed"}
    outcomes.sort()
    loop outcome in outcomes -> print(outcome)
}

run: fn() (HTTPError | TaskFailure)! {
    store: db.open_memory()
    _: cards_in(store).put(Card{id: 1, column: "todo", version: 1}) ?? panic("the first card")
    _: cards_in(store).put(Card{id: 2, column: "todo", version: 1}) ?? panic("the second card")
    server: web.app().mount(Board{store: store.copy()}).bind("127.0.0.1:0") ?? panic("bind")
    addr: server.local_addr() ?? panic("address")
    serving: task { server.serve() ?? panic("serve") }
    // Over HTTP. Each task owns what it captures, so each gets its own
    // address.
    first_api: "http://{addr}"
    second_api: "http://{addr}"
    settled(
        task { move(app.remote_at<Board>(first_api), 1, 1, "doing") },
        task { move(app.remote_at<Board>(second_api), 1, 1, "done") },
    )
    print(card_line(store, 1))
    print(move_and_fail(app.remote_at<Board>("http://{addr}"), 1))
    print(card_line(store, 1))
    _: server.shutdown(100ms) ?? panic("shutdown")
    serving.join() ?? panic("serve task")
    // In this process.
    first_board: Board{store: store.copy()}
    second_board: Board{store: store.copy()}
    settled(
        task { move(app.remote(first_board), 2, 1, "doing") },
        task { move(app.remote(second_board), 2, 1, "done") },
    )
    print(card_line(store, 2))
    print(move_and_fail(app.remote(Board{store: store.copy()}), 2))
    print(card_line(store, 2))
}
