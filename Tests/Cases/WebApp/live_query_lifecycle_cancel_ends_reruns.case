# Canceling a live query's subscription ends its re-runs. A device that
# watches a DBScope.live binding gets each write's event and reads again;
# once it closes the connection, the writes that follow reach no one and run
# nothing (changes stays put), and the next read re-runs the query once for
# all of them. Same output on O0, O1 and O2; the web target has no server
# sockets, so a subscription has no web tier.
fixture: LiveQueryLifecycleCancelEndsReruns.fixture
env: NO_COLOR=1
step default: jet run main.jet
exit: 0
stdout: = live_query_lifecycle_cancel_ends_reruns.stdout.expected
step: jet build main.jet
exit: 0
step debug: built
exit: 0
stdout: == default
step release: jet run --release main.jet
exit: 0
stdout: == default
