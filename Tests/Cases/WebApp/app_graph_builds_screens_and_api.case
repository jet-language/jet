# One app graph supplies the route set, the screens and the Remotes: the
# fixture's graph declares `Board` with `.api<Board>`, mounts it in this
# process (a public endpoint and a signed-in one, each registered with the
# graph's own arguments) and registers a board screen whose view takes the
# graph's Remote of `Board`. `url_of` gives the board's address, `go` opens
# the board there, its view calling the mounted service through the Remote,
# and `current` makes the board's state back from its address. A view runs
# as server code, so it shows its page rather than printing.
fixture: AppGraphBuildsScreensAndAPI.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step o0: jet run -O0 main.jet
exit: 0
stdout: = "/projects/p%201/board?tab=open\nbefore: none\ncurrent: p 1 open\n"
step o1: jet run -O1 main.jet
exit: 0
stdout: = "/projects/p%201/board?tab=open\nbefore: none\ncurrent: p 1 open\n"
step o2: jet run -O2 main.jet
exit: 0
stdout: = "/projects/p%201/board?tab=open\nbefore: none\ncurrent: p 1 open\n"
