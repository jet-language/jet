// Two servers of one app, each its own process, over one database file.
// `greeting` replies a String, which the app graph caches `.Public` for ten
// minutes. Server A, a child process that shares nothing with B but the
// file, answers one call of `greeting` and ends. Server B (the program) then
// answers the same call with the reply A kept in the file, and never runs
// `greeting` itself. No cache server runs.
use {
    app
    client: core.http.client
    db: core.db
    fs: core.files
    net: core.net
    process: core.process
    sys: core.sys
    web: core.web
}

FILE: "kept_replies.db"

Board: struct {
    store: db.Store
    name: String
    runs: Shared<Int>

    #App.Public greeting: fn(self, who: String) -> String {
        guard := self.runs.guard_edit()
        guard.value += 1
        "hello {who}, from {self.name}"
    }
}

// Serves one call of `greeting` as the server `name`, over the file, and
// prints its answer and how often this server ran `greeting`.
serve_one: fn(name: String) {
    _: app.new("Board").cache<String>(.Public{max_age: 10min})
    runs: Shared{0}
    served: web.app().mount("/api", Board{store: db.open(FILE), name: name, runs: runs.copy()})
    listener: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    addr: listener.local_addr()
    serving: task { served.serve_once(listener) ?? panic("serve") }
    answered: client.post("http://{addr}/api/greeting", "[\"ann\"]") ?? panic("call greeting")
    age: if answered.header("age") == None -> "none" else -> "set"
    print("{name} answers: {answered.status} {answered.text() ?? "unreadable"} | age: {age}")
    serving.join() ?? panic("serve task")
    held: runs.guard_read()
    print("{name} ran greeting: {held.value}")
}

run: fn() {
    if (process.args().get(0) ?? "") == "--server-a" {
        serve_one("server a")
        return
    }
    leftovers: [String]{FILE, "{FILE}-journal", "{FILE}-wal", "{FILE}-shm"}
    loop leftover in leftovers {
        if fs.exists(leftover) -> fs.remove(leftover) ?? panic("clear {leftover}")
    }
    other: process.cmd([sys.executable(), "--server-a"])
        .stdout(.Stream)
        .spawn() ?? panic("start server a")
    loop line in other.stdout.lines() -> print(line.trim())
    _: other.wait() ?? panic("server a ends")
    serve_one("server b")
}
