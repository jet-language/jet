# `.head(fn)` puts a screen's metadata in its server HTML. A public guide's
# page carries its title, description, canonical address (the state's own
# address, without the query it was asked with), and Open Graph and Twitter
# card tags, every value attribute-escaped and its share image an absolute
# URL. A guide whose head says `index: false` is noindex. The signed-in inbox
# is noindex whether it is refused 401 for want of a session or served to the
# account that has one, though its head says nothing of indexing.
fixture: HeadRendersMetadataAndSignedInScreensAreNoindex.fixture
env: NO_COLOR=1
step: jet run main.jet
exit: 0
stdout: = "/guides/faq?from=mail: 200\n<meta charset=\"utf-8\"><title>Crew help: faq</title><meta name=\"description\" content=\"Answers about &quot;faq&quot; &amp; more\"><link rel=\"canonical\" href=\"http://HOST/guides/faq\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:title\" content=\"Crew help: faq\"><meta property=\"og:description\" content=\"Answers about &quot;faq&quot; &amp; more\"><meta property=\"og:url\" content=\"http://HOST/guides/faq\"><meta property=\"og:image\" content=\"http://HOST/brand/board.png\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"Crew help: faq\"><meta name=\"twitter:description\" content=\"Answers about &quot;faq&quot; &amp; more\"><meta name=\"twitter:image\" content=\"http://HOST/brand/board.png\">\n/guides/draft: 200\n<meta charset=\"utf-8\"><title>Crew help: draft</title><meta name=\"robots\" content=\"noindex\"><meta name=\"description\" content=\"Answers about &quot;draft&quot; &amp; more\"><link rel=\"canonical\" href=\"http://HOST/guides/draft\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:title\" content=\"Crew help: draft\"><meta property=\"og:description\" content=\"Answers about &quot;draft&quot; &amp; more\"><meta property=\"og:url\" content=\"http://HOST/guides/draft\"><meta property=\"og:image\" content=\"http://HOST/brand/board.png\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"Crew help: draft\"><meta name=\"twitter:description\" content=\"Answers about &quot;draft&quot; &amp; more\"><meta name=\"twitter:image\" content=\"http://HOST/brand/board.png\">\n/inbox/mine: 401\n<meta charset=\"utf-8\"><title>Sign in</title><meta name=\"robots\" content=\"noindex\">\n/inbox/mine: 200\n<meta charset=\"utf-8\"><title>Crew mail: mine</title><meta name=\"robots\" content=\"noindex\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:title\" content=\"Crew mail: mine\"><meta name=\"twitter:card\" content=\"summary\"><meta name=\"twitter:title\" content=\"Crew mail: mine\">\n"
