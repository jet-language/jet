use {
    app
    db: core.db
    core.reactive.loadable.[Loadable]
}

#Error
BoardError: enum {
    NoBoard
    Unopened
    Read
}

// The app's database handles, which the query functions read through, and
// how many times each query function ran.
Store: struct {
    tasks: db.DBScope?
    notes: db.DBScope?
    task_runs: Int
    note_runs: Int
}

STORE: Shared{Store{tasks: None, notes: None, task_runs: 0, note_runs: 0}}

// A board's task titles, a query function an app binds with app.live. It
// reads the tasks table and nothing else.
task_titles: fn(board: String) -[DB.Read]> [String] BoardError! {
    if board == "" -> return Err(BoardError.NoBoard)
    store := STORE.guard_edit()
    store.value.task_runs += 1
    scope: store.value.tasks ?? return Err(BoardError.Unopened)
    rows: scope.query(SQL{"SELECT title FROM tasks WHERE board = {board} ORDER BY title"}) ?? return Err(BoardError.Read)
    titles := [String]{}
    loop row in rows -> titles.push(db.row_text(row, "title") ?? "?")
    titles
}

// How many notes there are; it reads only the notes table.
note_count: fn() -[DB.Read]> Int BoardError! {
    store := STORE.guard_edit()
    store.value.note_runs += 1
    scope: store.value.notes ?? return Err(BoardError.Unopened)
    rows: scope.query(SQL{"SELECT body FROM notes"}) ?? return Err(BoardError.Read)
    rows.len()
}

titles: fn(state: Loadable<[String], BoardError>) -> String {
    if state == {
        .Loaded(list) -> "[{list.join(",")}]"
        .Failed(reason) -> if reason == {
            .NoBoard -> "failed: no board"
            .Unopened -> "failed: unopened"
            .Read -> "failed: read"
        }
        .Idle | .Loading -> "pending"
    }
}

notes: fn(state: Loadable<Int, BoardError>) -> String {
    if state == {
        .Loaded(count) -> "{count}"
        .Failed(_) -> "failed"
        .Idle | .Loading -> "pending"
    }
}

runs: fn() -> String {
    store: STORE.guard_read()
    "task runs={store.value.task_runs} note runs={store.value.note_runs}"
}

add_task: fn(scope: db.DBScope, board: String, title: String) {
    owner: "alice"
    _: scope.execute(SQL{"INSERT INTO tasks (owner, board, title) VALUES ({owner}, {board}, {title})"}) ?? panic("insert task")
}

add_note: fn(scope: db.DBScope, body: String) {
    owner: "alice"
    _: scope.execute(SQL{"INSERT INTO notes (owner, body) VALUES ({owner}, {body})"}) ?? panic("insert note")
}

keep: fn(tasks: db.DBScope, notes: db.DBScope) {
    store := STORE.guard_edit()
    store.value.tasks = Val(tasks.copy())
    store.value.notes = Val(notes.copy())
}

run: fn() {
    conn: db.open_memory()
    task_policy: db.policy("tasks", "owner == user") ?? panic("tasks policy")
    note_policy: db.policy("notes", "owner == user") ?? panic("notes policy")
    tasks: conn.with_policy(task_policy, "alice")
    notes_scope: conn.with_policy(note_policy, "alice")
    _: db.migrate(tasks, "tasks-v1", [db.SQL]{SQL{"CREATE TABLE tasks (owner TEXT, board TEXT, title TEXT)"}}) ?? panic("migrate tasks")
    _: db.migrate(notes_scope, "notes-v1", [db.SQL]{SQL{"CREATE TABLE notes (owner TEXT, body TEXT)"}}) ?? panic("migrate notes")
    add_task(tasks, "jet", "one")
    keep(tasks, notes_scope)

    // app.live returns a typed binding; reading it runs the query once.
    board: app.live(task_titles, "jet")
    count: app.live(note_count)
    print("bound {titles(app.state(board))} notes={notes(app.state(count))}, {runs()}")
    print("read again {titles(app.state(board))} notes={notes(app.state(count))}, {runs()}")

    // A write to the tasks table re-runs the binding that read it, and only it.
    add_task(tasks, "jet", "two")
    print("after a task insert {titles(app.state(board))} notes={notes(app.state(count))}, {runs()}")

    // A write to the notes table re-runs only the note count.
    add_note(notes_scope, "hello")
    print("after a note insert {titles(app.state(board))} notes={notes(app.state(count))}, {runs()}")

    // A write that changes no row re-runs nothing.
    missing: "missing"
    _: tasks.execute(SQL{"DELETE FROM tasks WHERE title = {missing}"}) ?? panic("delete")
    print("after a delete of no row {titles(app.state(board))}, {runs()}")

    // A write inside a transaction reaches the binding at its commit.
    tx: tasks.begin() ?? panic("begin")
    add_task(tasks, "jet", "three")
    print("inside the transaction {titles(app.state(board))}, {runs()}")
    tx.commit() ?? panic("commit")
    print("after the commit {titles(app.state(board))}, {runs()}")

    // A failing query is a typed failure, not an unsupported call.
    nowhere: app.live(task_titles, "")
    print("an empty board {titles(app.state(nowhere))}")
}
