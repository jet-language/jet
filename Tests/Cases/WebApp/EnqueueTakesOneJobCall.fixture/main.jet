// `app.enqueue` closures that are not one call of an `#App.Job` method of the
// service with codable arguments, and two that are.
use app

Hook: struct {
    run: fn() -> Int,
}

Mailer: struct {
    #App.Job send: fn(self, to: String) -> Int Never! { to.len() }

    #App.Job hooked: fn(self, hook: Hook) -> Int Never! { hook.run() }

    count: fn(self, to: String) -> Int Never! { to.len() }

    #App.SignedIn notify: fn(self, to: String) -> Int app.CallError! {
        other: Mailer{}
        app.enqueue(fn() { self.send(to) })
        app.enqueue(fn() { self.send(to: "ann") })
        app.enqueue(fn(name: String) { self.send(name) })
        app.enqueue(fn() {
            name: "ann"
            self.send(name)
        })
        app.enqueue(fn() { local_send("ann") })
        app.enqueue(fn() { other.send("ann") })
        app.enqueue(fn() { self.count("ann") })
        app.enqueue(fn() { self.hooked(Hook{run: fn() -> Int { 1 }}) })
        app.enqueue(fn() { self.send("ann") }, 1)
        Ok(1)
    }
}

local_send: fn(to: String) -> Int { to.len() }

outside: fn() { app.enqueue(fn() { self.send("ann") }) }

run: fn() { outside() }
