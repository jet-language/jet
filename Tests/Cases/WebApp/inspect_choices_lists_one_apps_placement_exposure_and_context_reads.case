# One app holds a signed-in endpoint, a server-only method and a client
# function pinned to JS. `jet inspect choices` lists, for each function, its
# placement, whether it is an endpoint and under which marker, and the context
# fields it reads. Only an automatic placement row carries a pin hint.
fixture: InspectChoicesListsOneAppsPlacementExposureAndContextReads.fixture
env: NO_COLOR=1
step: jet inspect choices app.jet
exit: 0
stdout: ~ "Placement: app.jet:24 in view: JS: pinned by `#Target(JS)`" # the client function's pin
stdout: !~ "pinned by `#Target(JS)`; pin it" # a pinned row needs no pin hint
stdout: ~ "Placement: app.jet:26 in badge: JS: called by `view`, which runs in JS; pin it with `#Target(JS)`" # an automatic row names the pin that locks it
stdout: ~ "Placement: app.jet:18 in audit: Wasm: the default for code that nothing places in JS; pin it with `#Target(Wasm)`" # the server-only method's placement
stdout: ~ "Exposure: app.jet:15 in move_card: endpoint under `#App.SignedIn`: the marker serves it" # the signed-in endpoint and its marker
stdout: !~ " in audit: endpoint" # the server-only method is no endpoint
stdout: ~ "Context: app.jet:29 in budget: reads `deadline`, `thread`" # the fields its body reads, in order
