// A board whose `add` saves a note and queues `count`, an `#App.Job` that
// counts the note in a second store. The job's call commits the counts'
// store first, as its count joined it first, and the board's store, where it
// deletes the job's row, second.
//
// `-- crash` stops the process after the count committed but before the
// board's store acknowledged the job: a read the process holds on the board's
// store keeps that second commit waiting, and the process exits meanwhile.
// `-- serve` serves the board. Once the job's row is no longer held, the
// server takes it and runs the job again, under the job's key. The counts'
// store recorded that key with the count, so it drops the run, and the row is
// deleted: the count stays 1, and the job runs no third time.
use {
    app
    db: core.db
    process: core.process
    time: core.time
    web: core.web
}

#Codable
Note: struct {
    id: Int,
    text: String,
}

#Codable
Count: struct {
    name: String,
    runs: Int,
}

#Error
BoardError: enum {
    Failed(String),
    Unreachable(String),
}

impl app.CallError -> BoardError {
    if self == {
        .Unreachable(why) -> BoardError.Unreachable(why)
        .Invalid(errors) -> BoardError.Unreachable("{errors.len()} invalid arguments")
        .SignedOut -> BoardError.Unreachable("signed out")
        .UpdateRequired -> BoardError.Unreachable("update required")
    }
}

notes_in: fn(store: db.Store) -> db.Table<Int, Note> {
    store.table("notes", key: fn(note: Note) { note.id })
}

counts_in: fn(store: db.Store) -> db.Table<String, Count> {
    store.table("counts", key: fn(count: Count) { count.name })
}

// The notes counted so far.
count_now: fn(counts: db.Table<String, Count>) -[DB.Read]> Int BoardError! {
    if counts.get("notes") == {
        .Val(count) -> Ok(count.runs)
        .None -> Ok(0)
        .Err(failure) -> Err(BoardError.Failed(failure.message()))
    }
}

cell_of: fn(cell: Shared<Int>) -> Int { cell.guard_read().value }

cell_set: fn(cell: Shared<Int>, to: Int) {
    held := cell.guard_edit()
    held.value = to
}

Board: struct {
    store: db.Store,
    effects: db.Store,
    crash: Bool,
    // 1 once the crashing job counted; 2 once the process holds its read on
    // the board's store.
    gate: Shared<Int>,
    // The job's runs in this process.
    tries: Shared<Int>,

    // Saves note `id` and queues its count.
    #App.Public add: fn(self, id: Int) -> Int BoardError! {
        _: notes_in(self.store).put(Note{id: id, text: "note {id}"}) ?? return Err(BoardError.Failed(err.message()))
        app.enqueue(fn() { self.count(id) })
        Ok(id)
    }

    // Counts a note in the counts' store.
    #App.Job(retries: 3) count: fn(self, id: Int) -> Int BoardError! {
        cell_set(self.tries, cell_of(self.tries) + 1)
        counts: counts_in(self.effects)
        runs: (count_now(counts) ?? return Err(err)) + 1
        _: counts.put(Count{name: "notes", runs: runs}) ?? return Err(BoardError.Failed(err.message()))
        if self.crash {
            cell_set(self.gate, 1)
            loop cell_of(self.gate) < 2 { time.sleep(10ms) }
        }
        Ok(id)
    }
}

// Adds note `id` through `board`: whether its call committed.
add_note: fn(board: app.Remote<Board>, id: Int) -> Bool Never! {
    _: board.add(id) ?? return false
    true
}

// Holds a read on the board's store, which keeps any commit there waiting,
// from when the crashing job counted (`gate` 1, then 2) until `gate` is 3.
hold_read: fn(gate: Shared<Int>) {
    loop cell_of(gate) < 1 { time.sleep(10ms) }
    blocker: db.open("board.db")
    held: blocker.begin() ?? panic("a read on the board's store begins")
    _: notes_in(blocker).get(1) ?? panic("the board's store reads")
    cell_set(gate, 2)
    loop cell_of(gate) < 3 { time.sleep(10ms) }
    _: held.rollback()
}

crash: fn() {
    gate: Shared{0}
    holding: task { hold_read(gate.copy()) }
    holding.detach()
    if !add_note(app.remote(Board{store: db.open("board.db"), effects: db.open("effects.db"), crash: true, gate: gate.copy(), tries: Shared{0}}), 1) {
        panic("the add commits")
    }
    reader: db.open("effects.db")
    loop _ in 0..<1000 {
        if cell_of(gate) == 2 && (count_now(counts_in(reader)) ?? 0) == 1 -> break
        time.sleep(10ms)
    }
    print("counted {count_now(counts_in(reader)) ?? 0} before the board's store acknowledged the job")
    // The process ends with the read held, so the board's store never
    // commits the job's acknowledgement.
    process.exit(0)
}

serve: fn() {
    tries: Shared{0}
    board: Board{store: db.open("board.db"), effects: db.open("effects.db"), crash: false, gate: Shared{0}, tries: tries.copy()}
    server: web.app().mount(board).bind("127.0.0.1:0") ?? panic("bind the board")
    serving: task { server.serve() }
    serving.detach()
    loop _ in 0..<3000 {
        if cell_of(tries) > 0 -> break
        time.sleep(10ms)
    }
    // A row still kept would be taken again once its time passed.
    time.sleep(7000ms)
    print("redelivered runs: {cell_of(tries)}")
    print("count: {count_now(counts_in(db.open("effects.db"))) ?? panic("the count reads")}")
}

run: fn() {
    if process.args().contains("crash") -> crash() else -> serve()
}
