// A board whose `add` writes a row and queues a `work` job, and is refused
// after both when asked, so its call rolls back. `work` writes its note; on
// a slow board job 3 first waits a minute.
//
// The jobs are kept in the store's outbox, `__jet_jobs`, in the transaction
// of the call that queued them, for each engine core.db opens: a database
// file and an in-memory database.
//
// `-- file-stop` serves the board over `board.db`, adds 1 (refused), 2 and
// 3, and once note 2 is written and job 3 started, shuts the server down
// with 300 ms of grace: job 3 doesn't end within it, so its row stays,
// unacknowledged. `-- file-restart` serves the board again in a new process:
// once no server holds job 3's row, the server takes it and runs job 3, and
// only job 3, again.
//
// `-- memory` stops the same way over an in-memory database: its outbox
// keeps the same contract while the database is open, and its jobs last as
// long as the rows that queued them, which end with the process.
use {
    app
    db: core.db
    process: core.process
    time: core.time
    web: core.web
}

#Codable
Note: struct {
    id: Int
    text: String
}

#Error
BoardError: enum {
    Refused
    Failed(String)
    Unreachable(String)
}

impl app.CallError -> BoardError {
    if self == {
        .Unreachable(why) -> BoardError.Unreachable(why)
        .Invalid(errors) -> BoardError.Unreachable("{errors.len()} invalid arguments")
        .SignedOut -> BoardError.Unreachable("signed out")
        .UpdateRequired -> BoardError.Unreachable("update required")
    }
}

notes_in: fn(store: db.Store) -> db.Table<Int, Note> {
    store.table("notes", key: fn(note: Note) { note.id })
}

// The notes written whose IDs run from `first` to `first + 2`.
noted_from: fn(store: db.Store, first: Int) -> String {
    ids := [String]{}
    loop id in first..<first + 3 {
        if notes_in(store).get(id) == .Val(_) -> ids.push("{id}")
    }
    if ids.len() == 0 -> "none" else -> ids.join(", ")
}

// The jobs' notes written, by ID.
noted: fn(store: db.Store) -> String { noted_from(store, 1) }

// How many jobs the store's outbox keeps.
kept_jobs: fn(store: db.Store) -> String {
    policy: db.policy("notes", "true") ?? return "unreadable: {err.message()}"
    scope: store.with_policy(policy, "test")
    if scope.query_one(SQL{"SELECT count(*) AS n FROM __jet_jobs"}) == {
        .Val(row) -> if row.get("n") == .Val(.Int(n)) -> "{n}" else -> "unreadable"
        .None -> "none"
        .Err(failure) -> "unreadable: {failure.message()}"
    }
}

ran_of: fn(ran: Shared<[Int]>) -> String {
    held: ran.guard_read()
    ids := [String]{}
    loop id in held.value -> ids.push("{id}")
    if ids.len() == 0 -> "none" else -> ids.join(", ")
}

ran_has: fn(ran: Shared<[Int]>, id: Int) -> Bool { ran.guard_read().value.contains(id) }

ran_add: fn(ran: Shared<[Int]>, id: Int) {
    held := ran.guard_edit()
    held.value.push(id)
}

Board: struct {
    store: db.Store
    // Whether job 3 waits a minute before writing its note.
    slow: Bool
    // The jobs started in this server, by ID.
    ran: Shared<[Int]>

    // Writes row `id + 100` and queues job `id`; refused after both when
    // `refuse`, so its call rolls back.
    #App.Public add: fn(self, id: Int, refuse: Bool) -> Int BoardError! {
        _: notes_in(self.store).put(Note{id: id + 100, text: "added"}) ?? return Err(BoardError.Failed(err.message()))
        app.enqueue(fn() { self.work(id) })
        if refuse -> return Err(BoardError.Refused)
        Ok(id)
    }

    // Writes note `id`, after a minute for job 3 on a slow board.
    #App.Job work: fn(self, id: Int) -> Int BoardError! {
        ran_add(self.ran, id)
        if self.slow && id == 3 -> time.sleep(60000ms)
        _: notes_in(self.store).put(Note{id: id, text: "job {id}"}) ?? return Err(BoardError.Failed(err.message()))
        Ok(id)
    }
}

// What `added` gave, as text.
shown: fn(added: Int BoardError!) -> String {
    id: added ?? {
        if err == .Refused -> return "refused"
        return "failed"
    }
    "{id}"
}

// Adds 1 (refused), 2 and 3 through `board`.
adds: fn(board: app.Remote<Board>) {
    print("add 1: {shown(board.add(1, true))}")
    print("add 2: {shown(board.add(2, false))}")
    print("add 3: {shown(board.add(3, false))}")
}

// Serves a board over `store`, adds through it, and shuts it down with
// 300 ms of grace once note 2 is written and job 3 started.
stopped: fn(store: db.Store) {
    ran: Shared{[Int]{}}
    server: web.app().mount(Board{store: store.copy(), slow: true, ran: ran.copy()}).bind("127.0.0.1:0") ?? panic("bind the board")
    serving: task { server.serve() }
    serving.detach()
    adds(app.remote(Board{store: store.copy(), slow: true, ran: ran.copy()}))
    loop _ in 0..<1000 {
        if noted(store) == "2" && ran_has(ran, 3) -> break
        time.sleep(10ms)
    }
    _: server.shutdown(grace: 300ms) ?? panic("the server shuts down")
    print("after the stop, ran: {ran_of(ran)}, notes: {noted(store)}, rows added: {noted_from(store, 101)}, jobs kept: {kept_jobs(store)}")
}

// Serves a board over `store` that isn't slow until job 3 wrote its note,
// and then a while longer, as a row still kept would be taken by then.
restarted: fn(store: db.Store) {
    ran: Shared{[Int]{}}
    server: web.app().mount(Board{store: store.copy(), slow: false, ran: ran.copy()}).bind("127.0.0.1:0") ?? panic("bind the board")
    serving: task { server.serve() }
    serving.detach()
    loop _ in 0..<3000 {
        if noted(store) == "2, 3" -> break
        time.sleep(10ms)
    }
    time.sleep(1500ms)
    print("after the restart, ran: {ran_of(ran)}, notes: {noted(store)}, jobs kept: {kept_jobs(store)}")
}

run: fn() {
    args: process.args()
    if args.contains("file-restart") -> return restarted(db.open("board.db"))
    store: if args.contains("file-stop") -> db.open("board.db") else -> db.open_memory()
    stopped(store)
}
