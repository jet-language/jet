# tests/report.rs::ordinary_build_opens_no_network_connection
# Original exact network-syscall predicates; PENDING-GRAMMAR(batch-four line predicates); PENDING-SAME-HEAD.
# The build's network calls are those of the trace jet perf attach keeps,
# each line of `jet perf view` a call after its process.
requires: os-name:linux
requires: arch:x86_64
fixture: OrdinaryBuildOpensNoNetworkConnection.fixture
step build: jet perf attach --lens=syscalls --out build.jettrace -- {jet} build main.jet
exit: 0
json: file build.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.status = "traced" # the kernel let jet trace the build
step view: jet perf view build.jettrace
stdout: file build.calls
exit: 0
file.filter(where ~ " socket(" || ~ " socketpair(" || ~ " bind(" || ~ " listen(" || ~ " accept(" || ~ " accept4(" || ~ " connect(" || ~ " getsockname(" || ~ " getpeername(" || ~ " sendto(" || ~ " recvfrom(" || ~ " sendmsg(" || ~ " recvmsg(" || ~ " sendmmsg(" || ~ " recvmmsg(" || ~ " shutdown(" || ~ " setsockopt(" || ~ " getsockopt(" || ~ " sendfile("): build.calls each-line where (~ "socketpair(AF_UNIX, SOCK_SEQPACKET|SOCK_CLOEXEC, 0," && $= "= 0") || (~ "recvfrom(" && $= "\", 8, 0, NULL, NULL) = 0") || ~ "sendfile(" # original unexpected.is_empty
capture: spawn_sockets = lines file.filter(where ~ "socketpair(AF_UNIX, SOCK_SEQPACKET|SOCK_CLOEXEC, 0," && $= "= 0") build.calls
file.filter(where ~ " recvfrom(" && $= "\", 8, 0, NULL, NULL) = 0"): build.calls lines = {cap:spawn_sockets} # original spawn_sockets == spawn_replies
