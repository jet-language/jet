# Port of tests/diagnostic_gate.rs::warnings_never_choose_execution_exit_code (104-161).
# PENDING-GRAMMAR and PENDING-SAME-HEAD: no runtime snapshot.
# Visibility follows the ratified rule: run and dev keep the tidy error L0103
# off stderr, `--verbose` shows it, and `--json` reports exactly what the
# human output shows. The advisory L0202 is on the report tier: only
# `jet lint` lists it, even under `--verbose`. Neither chooses a run's exit
# code; `jet build` lists the tidy error and fails, and builds over the
# advisory lint. The l0103 fixture imports core.text under two aliases where
# the Rust source used core.http.client and fetched example.com; the case
# needs no network.
fixture: Warnings.fixture
env: NO_COLOR=1
step: jet run main.jet
cwd: l0103
env: JET_STORE_DIR={work}/cache/l0103/default/build
exit: 0
stderr: !~ "Warning [jet.UnusedImport]" # #3420: run hides advisories
stderr: !~ "Error [jet.UnusedImport]" # original predicate
stdout: = l0103.out
step: jet run --release main.jet
cwd: l0103
env: JET_STORE_DIR={work}/cache/l0103/release/build
exit: 0
stderr: !~ "Warning [jet.UnusedImport]" # #3420: run hides advisories
stderr: !~ "Error [jet.UnusedImport]" # original predicate
stdout: = l0103.out
step: jet dev main.jet --watch=off
cwd: l0103
env: JET_STORE_DIR={work}/cache/l0103/dev/build
exit: 0
stderr: !~ "Warning [jet.UnusedImport]" # #3420: dev hides advisories
stderr: !~ "Error [jet.UnusedImport]" # original predicate
stdout: = l0103.out
step: jet run --verbose main.jet
cwd: l0103
env: JET_STORE_DIR={work}/cache/l0103/verbose/build
exit: 0
stderr: ~ "Error [jet.UnusedImport]" # --verbose shows the tidy error
stderr: !~ "Warning [jet.UnusedImport]" # a tidy error is no warning
stdout: = l0103.out
step: jet build main.jet
cwd: l0103
env: JET_STORE_DIR={work}/cache/l0103/build/build
exit: 1
stderr: ~ "Error [jet.UnusedImport]" # jet build lists the tidy error and fails
stderr: !~ "Warning [jet.UnusedImport]" # a tidy error is no warning
step: jet run main.jet
cwd: l0202
env: JET_STORE_DIR={work}/cache/l0202/default/build
exit: 0
stderr: !~ "Warning [jet.SharedAutoClone]" # #3420: run hides advisories
stderr: !~ "Error [jet.SharedAutoClone]" # original predicate
stdout: = l0202.out
step: jet run --release main.jet
cwd: l0202
env: JET_STORE_DIR={work}/cache/l0202/release/build
exit: 0
stderr: !~ "Warning [jet.SharedAutoClone]" # #3420: run hides advisories
stderr: !~ "Error [jet.SharedAutoClone]" # original predicate
stdout: = l0202.out
step: jet dev main.jet --watch=off
cwd: l0202
env: JET_STORE_DIR={work}/cache/l0202/dev/build
exit: 0
stderr: !~ "Warning [jet.SharedAutoClone]" # #3420: dev hides advisories
stderr: !~ "Error [jet.SharedAutoClone]" # original predicate
stdout: = l0202.out
step: jet run --verbose main.jet
cwd: l0202
env: JET_STORE_DIR={work}/cache/l0202/verbose/build
exit: 0
stderr: !~ "Warning [jet.SharedAutoClone]" # the report tier stays off run, even under --verbose
stderr: !~ "Error [jet.SharedAutoClone]" # original predicate
stdout: = l0202.out
step: jet lint main.jet
cwd: l0202
env: JET_STORE_DIR={work}/cache/l0202/lint/build
exit: 0
stderr: ~ "Warning [jet.SharedAutoClone]" # jet lint lists the report tier
stderr: ~ "1 report found" # the one advisory, counted as a report
step: jet build main.jet
cwd: l0202
env: JET_STORE_DIR={work}/cache/l0202/build/build
exit: 0
stderr: !~ "Warning [jet.SharedAutoClone]" # jet build presents errors only today
stderr: !~ "Error [jet.SharedAutoClone]" # original predicate
step: {work}/l0202/.jet/build/main
cwd: l0202
exit: 0
stdout: = l0202.out
step: jet run --json main.jet
cwd: l0103
env: JET_STORE_DIR={work}/cache/json/build
exit: 0
stdout: = l0103.out
stderr: !~ "\"code\":\"L0103\"" # #3420: --json reports what run shows
stderr: !~ "\"severity\":\"error\"" # original predicate
step: jet run --json --verbose main.jet
cwd: l0103
env: JET_STORE_DIR={work}/cache/json-verbose/build
exit: 0
stdout: = l0103.out
stderr: ~ "\"severity\":\"tidy\"" # --json --verbose reports the tidy error
stderr: ~ "\"code\":\"L0103\"" # #3420: --json --verbose reports the advisory
stderr: !~ "\"severity\":\"error\"" # original predicate
step: jet run --quiet main.jet
cwd: l0103
env: JET_STORE_DIR={work}/cache/quiet/build
exit: 0
stdout: = l0103.out
