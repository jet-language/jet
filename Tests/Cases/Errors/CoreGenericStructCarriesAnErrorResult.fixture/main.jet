Held: struct<Q> {
    reason: String,
    value: Q?,
}

// core.prelude's generic SendError<T> carried in an error result: at a
// concrete argument, at a generic function's parameter, and around a
// generic struct of the program's own.
refuse: fn(x: ^^[String]) -> Int SendError<[String]>! { Err(SendError<[String]>{value: x}) }

refuse_any: fn<Q>(x: ^^Q) -> Int SendError<Q>! { Err(SendError<Q>{value: x}) }

refuse_held: fn<Q>(x: ^^Q) -> Int SendError<Held<Q>>! {
    Err(SendError<Held<Q>>{value: Held<Q>{reason: "full", value: Val(x)}})
}

run: fn() {
    if refuse([String]{"a"}) == {
        .Ok(v) -> { print(v) }
        .Err(e) -> print("concrete {e.value}")
    }
    if refuse_any([String]{"b"}) == {
        .Ok(v) -> { print(v) }
        .Err(e) -> print("generic {e.value}")
    }
    if refuse_held([String]{"c"}) == {
        .Ok(v) -> { print(v) }
        .Err(e) -> print("nested {e.value.value} {e.value.reason}")
    }
}
