// Inside a `??` handler a Core error value renders: `{err}` shows its message,
// `{err:Debug}` its declared fields, and `err.message` reads the text.
run: fn() {
    n: Int.parse("seven") ?? {
        print("display: {err}")
        print("debug: {err:Debug}")
        print("message: {err.message}")
        0
    }
    radix: Int.from_radix("zz", 2) ?? {
        print("radix: {err}") - 1
    }
    print("{n} {radix}")
}
