use jobs: "./jobs"

double: fn(value: Int) -> Int { value * 2 }

// The bare `Task<Int>` is the task handle, though jobs.jet declares a `Task`.
joined: fn(handle: ^^Task<Int>) -> Int { handle.join() ?? 91 }

run: fn() {
    print(jobs.describe(jobs.Task{name: "build"}))
    task.group g {
        handle: task double(21)
        print(joined(handle))
    }
}
