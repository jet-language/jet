run: fn() {
    u: U8{12}
    i: I64{12}
    w: U64{12}
    print("{u & U8{10}},{u | U8{10}},{u ~ U8{10}},{~u},{U8{2}.pow(U8{3})},{u << 1},{u >> 1}")
    print("{i & I64{10}},{i | I64{10}},{i ~ I64{10}},{~i},{I64{2}.pow(I64{3})},{i << 1},{i >> 1}")
    print("{w & U64{10}},{w | U64{10}},{w ~ U64{10}},{~w},{U64{2}.pow(U64{3})},{w << 1},{w >> 1}")
}
