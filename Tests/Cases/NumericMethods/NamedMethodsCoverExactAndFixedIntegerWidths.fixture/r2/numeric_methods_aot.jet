// D-SIGIL-ALGEBRA1=B: one numeric meaning on AOT, run, and compile time.
FOLDED: #run (2).pow(10)

run: fn() {
    a: 12
    b: 10
    print("{a & b},{a | b},{a ~ b},{~a}")
    i8a: I8{12}
    i8b: I8{10}
    print("{i8a & i8b},{i8a | i8b},{i8a ~ i8b},{~i8a}")
    i16a: I16{12}
    i16b: I16{10}
    print("{i16a & i16b},{i16a | i16b},{i16a ~ i16b},{~i16a}")
    i32a: I32{12}
    i32b: I32{10}
    print("{i32a & i32b},{i32a | i32b},{i32a ~ i32b},{~i32a}")
    i64a: I64{12}
    i64b: I64{10}
    print("{i64a & i64b},{i64a | i64b},{i64a ~ i64b},{~i64a}")
    u8a: U8{12}
    u8b: U8{10}
    print("{u8a & u8b},{u8a | u8b},{u8a ~ u8b},{~u8a}")
    u16a: U16{12}
    u16b: U16{10}
    print("{u16a & u16b},{u16a | u16b},{u16a ~ u16b},{~u16a}")
    u32a: U32{12}
    u32b: U32{10}
    print("{u32a & u32b},{u32a | u32b},{u32a ~ u32b},{~u32a}")
    u64a: U64{12}
    u64b: U64{10}
    print("{u64a & u64b},{u64a | u64b},{u64a ~ u64b},{~u64a}")
    print(~(~u64a))
    print(~U64.MAX)
    print((a + 2) & b * 3 | (2).pow(2))
    print(~a & 255)
    print(a &~ b)
    print(FOLDED)
    print((2).pow(-1).numerator())
    print((2).pow(-1).denominator())
    print(Float{1.5}.pow(Float{2.0}))
    print(!true)
}
