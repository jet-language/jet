# A whole-list write window `edit: ^values` is the list itself, not a copy:
# a push through it shows in the owner on the next turn.
fixture: ReplNonSliceWritePlaceIsNotSilentlyCopied.fixture
step: jet repl
env: NO_COLOR=1
env: XDG_STATE_HOME={work}/state
stdin: ReplNonSliceWritePlaceIsNotSilentlyCopied.fixture/input.txt
exit: 0
stdout: ~ "3 : Int" # the owner sees the push made through its window
stderr: !~ "Error" # every turn is accepted
