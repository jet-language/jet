// A price written by hand, with a copy-paste slip in its `equal`: the second
// comparison reads `rhs.dollars` where it means `rhs.cents`, so a price is
// not equal to itself. Equatable's `reflexive` law catches it.
Price: struct {
    dollars: Int
    cents: Int

    impl Equatable {
        equal: fn(self, rhs: Price) -> Bool {
            self.dollars == rhs.dollars && self.cents == rhs.dollars
        }
    }
}

// A tag whose written `equal` keeps every law.
Tag: struct {
    name: String
    weight: Int

    impl Equatable {
        equal: fn(self, rhs: Tag) -> Bool { self.name == rhs.name }
    }
}

// A ledger holds a map, which has no generator, so its laws are listed as
// not checked.
Ledger: struct {
    entries: [String:Int]

    impl Equatable {
        equal: fn(self, rhs: Ledger) -> Bool { self.entries.len() == rhs.entries.len() }
    }
}

#Test("a price keeps its parts") {
    price: Price{dollars: 3, cents: 50}
    assert(price.dollars == 3)
}
