// `assert_eq(x, None)` on an Optional that holds a value checks clean and
// fails at run time with the assertion's report, before the print.
lookup: fn(xs: [Int], want: Int) -> Int? {
    loop x in xs {
        if x == want -> return x
    }
    None
}

run: fn() {
    present: lookup([1, 2], 2)
    assert_eq(present, None)
    print("unreachable")
}
