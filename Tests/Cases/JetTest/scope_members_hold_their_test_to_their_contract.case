# Each scope member holds its test to its contract: an `.expect_fail(code)`
# region that stops with that code passes, while an `.expect_fail` region that
# completes, a failure inside `.setup` and a `.timeout` region over its limit
# each fail the test and name why.
fixture: ScopeMembersHoldTheirTestToTheirContract.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack

step code: jet test --show-default --capture=all --serial expect_fail_code.jet
exit: 0
stdout: ~ "expect a specific runtime stop: pass" # the region stops with the code it names

step passes: jet test --show-default --capture=all --serial expect_fail_passes.jet
exit: 1
stdout: ~ "expect_fail but region passes: FAIL" # a region that completes fails its test
stderr: ~ "expected this region to fail, but it passed" # and the report says so

step setup: jet test --show-default --capture=all --serial setup_fail.jet
exit: 1
stdout: ~ "setup fails: FAIL" # a failing setup fails its test
stderr: ~ "panic: setup blew up" # with the setup's own message

step timeout: jet test --show-default --capture=all --serial timeout_exceeded.jet
exit: 1
stdout: ~ "timeout exceeded: FAIL" # a region over its limit fails its test
stderr: ~ "limit was 1ns" # and the report names the limit
