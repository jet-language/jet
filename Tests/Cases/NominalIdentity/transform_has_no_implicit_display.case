# Transform source identity does not grant an undeclared Display capability.
# syntax-decisions.md:2271-2279; core-library.md:1939,1976.
fixture: TransformHasNoImplicitDisplay.fixture
step: jet check transform.jet
exit: nonzero
stderr: ~ "Jet.ValueTypeMismatch" # runtime reflection requires declared Display
stderr: ~ "Jet.MissingDisplay" # interpolation requires declared Display
step: jet check qualified_transform.jet
exit: nonzero
stderr: ~ "Jet.ValueTypeMismatch" # qualification does not grant runtime reflection
stderr: ~ "Jet.MissingDisplay" # qualification does not grant Display
step: jet check transform2.jet
exit: nonzero
stderr: ~ "Jet.ValueTypeMismatch" # scalar specialization does not grant reflection
stderr: ~ "Jet.MissingDisplay" # scalar specialization does not grant Display
step: jet check qualified_transform2.jet
exit: nonzero
stderr: ~ "Jet.ValueTypeMismatch" # qualified specialization has the same refusal
stderr: ~ "Jet.MissingDisplay" # qualified specialization has the same refusal
