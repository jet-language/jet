// The metaprogramming coverage check. It reads the manifest (manifest.tsv)
// and the metadata contract registry, then:
//   jet run check.jet -- plan <root> <manifest> <witnesses>
// writes every witness id, one per line, for `jet test --cases`, and
//   jet run check.jet -- verify <root> <manifest> <results>
// reads that run's `--results` document and passes only when every family
// and every contract row has each of its witnesses passing on every tier it
// ran on, or known failing there. A known-failing witness is owed by the
// open work its known-failing row names, never passed: the check prints each
// owed row with that witness and its reason. Each problem is a line on
// stderr, and any problem exits 1.
use {
    files: core.files
    process: core.process
    json: core.encoding.json
}

REGISTRY: "Compiler/JetFoundation/Source/Registry/MetadataContract.jet"

FAMILY_COUNT: 40

// The levels a witness that runs per level runs on.
LEVELS: [String]{"o0", "o1", "o2"}

// One row that must be witnessed: a Jai family or a contract row.
CoverageRow: struct {
    name: String,
    witnesses: [String],
}

Coverage: struct {
    rows: [CoverageRow],
    families: Int,
    contract: Int,
    // The families no observed source shows.
    historical_only: [String],
    problems: [String],
    // Each known-failing verdict, with its row, and how many rows hold one.
    owed: [String],
    owed_rows: Int,
}

// A family id, `J01` to `J40`.
family_id: fn(index: Int) -> String {
    if index < 10 -> return "J0{index}"
    "J{index}"
}

// The words of a manifest column; `-` is none.
column_words: fn(column: String) -> [String] {
    ^words: [String]{}
    if column.trim() == "-" -> return words
    loop word in column.split(" ") {
        if word != "" -> words.push(word.copy())  // copy: the words outlive the line.
    }
    words
}

// The manifest's sources by kind and its family rows, with every problem.
read_manifest: fn(root: String, text: String, coverage: ^Coverage) {
    ^kinds: [String:String]{}
    ^seen: [String]{}
    loop raw in text.split("\n") {
        line: raw.trim_end()
        if line == "" || line.starts_with("#") -> next
        cells: line.split("\t").to_list()
        if cells[0] == "source" {
            if cells.len() != 4 {
                coverage.problems.push("malformed source row `{line}`: write source, id, kind and what, tab-separated")
                next
            }
            if cells[2] != "historical" && cells[2] != "observed" {
                coverage.problems.push("source {cells[1]} is `{cells[2]}`: a source is historical or observed")
            }
            kinds[cells[1]] = cells[2].copy()  // copy: the kinds outlive the line.
            next
        }
        if cells[0] != "family" || cells.len() != 7 {
            coverage.problems.push("malformed manifest row `{line}`: write family, id, title, historical, observed, witnesses and Jet's answer, tab-separated")
            next
        }
        id: cells[1]
        if seen.contains(id) -> coverage.problems.push("{id} has two rows")
        seen.push(id.copy())  // copy: the duplicate check keeps every id.
        historical: column_words(cells[3])
        observed: column_words(cells[4])
        if historical.len() + observed.len() == 0 {
            coverage.problems.push("{id} cites no Jai source")
        }
        loop source in historical {
            if kinds.get(source) != .Val("historical") {
                coverage.problems.push("{id} lists {source} as historical, but the manifest's source {source} is not a historical one")
            }
        }
        loop source in observed {
            if kinds.get(source) != .Val("observed") {
                coverage.problems.push("{id} lists {source} as observed, but the manifest's source {source} is not an observed one")
            }
        }
        if observed.len() == 0 -> coverage.historical_only.push(id.copy())  // copy: the summary names it.
        add_row(root, "{id} {cells[2]}", column_words(cells[5]), coverage)
    }
    families: (loop index in 1..<FAMILY_COUNT + 1 -> family_id(index))
    loop family in families {
        if !seen.contains(family) -> coverage.problems.push("{family} has no row")
    }
    loop id in seen {
        if !families.contains(id) {
            coverage.problems.push("`{id}` is not a family J01 to J{FAMILY_COUNT}")
        }
    }
    coverage.families = seen.len()
}

// The text of `line` between `start` and the next `end`, if both are there.
between: fn(line: String, start: String, end: String) -> String? {
    after: line.split(start).to_list()
    if after.len() < 2 -> return None
    before: after[1].split(end).to_list()
    if before.len() < 2 -> return None
    Val(before[0].copy())
}

// Every row of the metadata contract registry, Owed ones as problems.
read_registry: fn(root: String, text: String, coverage: ^Coverage) {
    loop line in text.split("\n") {
        if !line.trim_start().starts_with("{{spelling: \"") -> next
        spelling: (between(line, "{{spelling: \"", "\", kind:") ?? "").replace("{{{{", "{{").replace("}}}}", "}}")
        witness: between(line, "witness: \"", "\"") ?? ""
        delivery: between(line, "delivery: .", "}}") ?? ""
        coverage.contract += 1
        if spelling == "" {
            coverage.problems.push("a contract row in {REGISTRY} has no spelling the check can read: `{line.trim()}`")
            next
        }
        if delivery != "Built" {
            coverage.problems.push("contract row `{spelling}` is {delivery}: it has no passing witness")
        }
        add_row(root, "contract row `{spelling}`", if witness == "" -> [String]{} else -> [String]{witness}, coverage)
    }
    if coverage.contract == 0 {
        coverage.problems.push("{REGISTRY} holds no contract row the check can read")
    }
}

add_row: fn(root: String, name: String, witnesses: [String], coverage: ^Coverage) {
    if witnesses.len() == 0 -> coverage.problems.push("{name} names no witness")
    loop witness in witnesses {
        if !files.exists(files.join(root, witness)) {
            coverage.problems.push("{name}: the witness `{witness}` is not a file")
        }
    }
    coverage.rows.push(CoverageRow{name: name, witnesses: witnesses})
}

coverage_of: fn(root: String, manifest: String) -> Coverage {
    ^coverage: Coverage{rows: [], families: 0, contract: 0, historical_only: [], problems: [], owed: [], owed_rows: 0}
    manifest_text: files.read(manifest) ?? process.fail(1, "can't read the manifest `{manifest}`: {err}")
    registry_text: files.read(files.join(root, REGISTRY)) ?? process.fail(1, "can't read `{REGISTRY}`: {err}")
    read_manifest(root, manifest_text, coverage)
    read_registry(root, registry_text, coverage)
    coverage
}

// Each witness once, in the order the rows name them.
witness_ids: fn(coverage: Coverage) -> [String] {
    ^ids: [String]{}
    loop row in coverage.rows {
        loop witness in row.witnesses {
            if !ids.contains(witness) -> ids.push(witness.copy())  // copy: the list outlives the rows.
        }
    }
    ids
}

// One verdict of the results document.
Verdict: struct {
    tier: String,
    status: String,
    detail: String,
}

text_field: fn(record: Dyn, name: String) -> String {
    value: record.field(name) ?? return ""
    value.text() ?? ""
}

// The verdicts of the results document at `path`, by witness id.
read_results: fn(path: String) -> [String:[Verdict]] {
    text: files.read(path) ?? process.fail(1, "can't read the results `{path}`: {err}")
    document: json.parse(text) ?? process.fail(1, "the results `{path}` are not JSON: {err}")
    records: if (document.field("results") ?? Dyn.Null) == {
        .Array(items) -> items
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> process.fail(1, "the results `{path}` hold no `results` list")
    }
    ^verdicts: [String:[Verdict]]{}
    loop record in records {
        id: text_field(record, "case")
        ^list: verdicts.get(id) ?? [Verdict]{}
        list.push(Verdict{tier: text_field(record, "tier"), status: text_field(record, "status"), detail: text_field(record, "detail")})
        verdicts[id] = list
    }
    verdicts
}

// The witness `id` on its tiers: why it does not pass, and each known-failing
// verdict, which leaves its row owed rather than passed.
WitnessReport: struct {
    problems: [String],
    owed: [String],
}

witness_report: fn(id: String, verdicts: [String:[Verdict]]) -> WitnessReport {
    ^report: WitnessReport{problems: [], owed: []}
    list: verdicts.get(id) ?? {
        report.problems.push("`{id}` has no result: it did not run")
        return report
    }
    ^tiers: [String]{}
    loop verdict in list {
        line: "`{id}` is {verdict.status} at {verdict.tier}: {verdict.detail}"
        if verdict.status == {
            "PASS" -> {}
            "KNOWN-FAILING" -> report.owed.push(line)
            else -> report.problems.push(line)
        }
        tiers.push(verdict.tier.copy())  // copy: the level check reads them after the loop.
    }
    // A witness that runs per level runs on every level.
    ^missing: [String]{}
    loop level in LEVELS {
        if !tiers.contains(level) -> missing.push(level)
    }
    if missing.len() < LEVELS.len() {
        loop level in missing -> report.problems.push("`{id}` did not run at {level}")
    }
    report
}

verify: fn(coverage: ^Coverage, results: String) {
    verdicts: read_results(results)
    loop row in coverage.rows {
        ^owed: false
        loop witness in row.witnesses {
            report: witness_report(witness, verdicts)
            loop problem in report.problems { coverage.problems.push("{row.name}: {problem}") }
            loop line in report.owed {
                coverage.owed.push("owed: {row.name}: {line}")
                owed = true
            }
        }
        if owed -> coverage.owed_rows += 1
    }
}

fail_on_problems: fn(coverage: Coverage) {
    if coverage.problems.len() == 0 {
        return
    }
    process.fail(1, "{coverage.problems.join("\n")}\n{coverage.problems.len()} coverage problems")
}

run: fn() {
    args: process.args()
    if args.len() != 4 || (args[0] != "plan" && args[0] != "verify") {
        process.fail(2, "usage: check.jet plan|verify <root> <manifest> <witnesses|results>")
    }
    ^coverage: coverage_of(args[1], args[2])
    if args[0] == "plan" {
        fail_on_problems(coverage)
        files.write(args[3], "{witness_ids(coverage).join("\n")}\n") ?? process.fail(1, "can't write `{args[3]}`: {err}")
        print("{witness_ids(coverage).len()} witnesses")
        return
    }
    verify(coverage, args[3])
    loop line in coverage.owed -> print(line)
    fail_on_problems(coverage)
    print("{coverage.families} Jai families and {coverage.contract} metadata contract rows: {coverage.rows.len() - coverage.owed_rows} pass their witnesses and {coverage.owed_rows} are owed")
    print("families only a historical demo shows: {coverage.historical_only.join(", ")}")
}
