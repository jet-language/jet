# The CheckedText hooks of Core's typed heads (SQL, Path, URL, Sh, HTML and
# DateTime), called directly: what `check` accepts and refuses, what
# `encode_hole` makes of a value, and what `build` assembles.
fixture: CheckedTextHooksCheckEncodeAndBuild.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet test --show-default --capture=all --serial hooks.jet
exit: 0
stdout: ~ "8 passed, 0 failed, 0 skipped" # every hook test passes
