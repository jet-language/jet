#Error
PatternError: enum {
    Rejected,
}

Pattern: distinct String

impl Pattern.CheckedText {
    Error: PatternError,

    check: fn(parts: [String]) -[]> Checked<[String], TextSlot> PatternError! {
        if parts.join("") == "bad" -> return Err(PatternError.Rejected)
        return Ok(Checked{shape: parts.copy(), slots: [TextSlot]{}})
    }

    encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> String { return "" }
}

impl Err.From(PatternError) {
    from: fn(error: PatternError) -> Err {
        return Err("pattern rejected", code: "E_PATTERN", cause: Err("invalid shape"))
    }
}

parse: fn(text: String) -[]> Pattern {
    pattern: Pattern.from(text)
    return Ok(pattern)
}

load: fn(text: String) -[]> Pattern {
    pattern: parse(text)?("loading pattern")
    return Ok(pattern)
}

run: fn() { _: load("bad") }
