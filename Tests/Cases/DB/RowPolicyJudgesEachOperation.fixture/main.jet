// Two guarded tables, projects and their members, read and written by three
// accounts, each step run as its account. Each policy notes the row and the
// operation it judged, and the program prints those notes after each step.
use {
    app
    auth: core.auth
    db: core.db
}

#Codable
Project: struct {
    id: Int,
    name: String,
    created_by: auth.AccountID,
}

#[Codable, Comparable]
MemberKey: struct {
    project: Int,
    account: auth.AccountID,
}

#Codable
Member: struct {
    project: Int,
    account: auth.AccountID,
    owner: Bool,
}

mia: fn() -> auth.AccountID { auth.AccountID.from_string("mia") }

ben: fn() -> auth.AccountID { auth.AccountID.from_string("ben") }

carol: fn() -> auth.AccountID { auth.AccountID.from_string("carol") }

// Every judgment since the last step, in order.
JUDGED: Shared{[String]{}}

projects_in: fn(store: db.Store) -> db.Table<Int, Project> {
    store.table("projects", key: fn(row: Project) { row.id })
}

members_in: fn(store: db.Store) -> db.Table<MemberKey, Member> {
    store.table("members", key: fn(row: Member) { MemberKey{project: row.project, account: row.account} })
}

op_name: fn(op: db.Op) -> String {
    if op == {
        .Read -> "read"
        .Insert -> "insert"
        .Update -> "update"
        .Delete -> "delete"
    }
}

account_of: fn(who: db.Who) -> auth.AccountID? {
    if who == {
        .Account(account) -> Val(account)
        .System -> None
        .Anonymous -> None
    }
}

note: fn(op: db.Op, who: db.Who, row: String) {
    caller: if account_of(who) == .Val(account) -> account.raw() else -> "no account"
    ^judged: JUDGED.guard_edit()
    judged.value.push("{op_name(op)} {row} as {caller}")
}

member_text: fn(row: Member) -> String {
    mark: if row.owner -> " (owner)" else -> ""
    "member {row.account} of {row.project}{mark}"
}

// The account's member row in `project`, read with the system's rights.
member_of: fn(store: db.Store, project: Int, account: auth.AccountID) -[DB.Read]> Member? db.DBError! {
    members_in(store).get(MemberKey{project: project, account: account})
}

// The creator may insert a project. Its members read it, and an owner
// changes or deletes it, but no change leaves it without a name. A caller
// with no account may do nothing.
project_policy: fn(row: Project, op: db.Op, who: db.Who, store: db.Store) -[DB.Read]> Bool db.DBError! {
    note(op, who, "project {row.id} ({row.name}) by {row.created_by}")
    account: account_of(who) ?? return Ok(false)
    if op == db.Op.Insert -> return Ok(row.created_by == account)
    if member_of(store, row.id, account) == {
        .Val(member) -> Ok(op == db.Op.Read || (member.owner && row.name.len() > 0))
        .None -> Ok(false)
        .Err(failure) -> Err(failure)
    }
}

// The creator rule: `account` created `project`, which has no members yet.
// The project row may be a write earlier in the same transaction; the member
// row being judged is not written yet, so it is not counted.
first_owner: fn(store: db.Store, project: Int, account: auth.AccountID) -[DB.Read]> Bool db.DBError! {
    if projects_in(store).get(project) == {
        .Val(found) -> {
            if found.created_by != account -> return Ok(false)
        }
        .None -> return Ok(false)
        .Err(failure) -> return Err(failure)
    }
    rows: (members_in(store).query() ?? return Err(err)).collect() ?? return Err(db.DBError.Failed("the members do not collect"))
    loop member in rows {
        if member.project == project -> return Ok(false)
    }
    Ok(true)
}

// Members see each other. An owner adds, changes and removes members, an
// account may remove its own row, and a project's creator may add itself as
// its first owner. A caller with no account may do nothing.
member_policy: fn(row: Member, op: db.Op, who: db.Who, store: db.Store) -[DB.Read]> Bool db.DBError! {
    note(op, who, member_text(row.copy()))
    account: account_of(who) ?? return Ok(false)
    ^member: false
    ^owner: false
    if member_of(store, row.project, account) == {
        .Val(mine) -> {
            member = true
            owner = mine.owner
        }
        .None -> {}
        .Err(failure) -> return Err(failure)
    }
    own_row: row.account == account
    if op == db.Op.Insert {
        if owner -> return Ok(true)
        if !own_row || !row.owner -> return Ok(false)
        return first_owner(store, row.project, account)
    }
    Ok(owner || (op == db.Op.Read && member) || (op == db.Op.Delete && own_row))
}

step: fn(label: String, outcome: String) {
    print("{label}: {outcome}")
    ^judged: JUDGED.guard_edit()
    loop line in judged.value -> print("  judged {line}")
    judged.value = [String]{}
}

project_wrote: fn(result: Project db.DBError!) -> String {
    if result == {
        .Ok(_) -> "ok"
        .Err(failure) -> failure.message()
    }
}

member_wrote: fn(result: Member db.DBError!) -> String {
    if result == {
        .Ok(_) -> "ok"
        .Err(failure) -> failure.message()
    }
}

project_read: fn(table: db.Table<Int, Project>, id: Int) -[DB.Read]> String {
    if table.get(id) == {
        .Val(project) -> project.name
        .None -> "none"
        .Err(failure) -> failure.message()
    }
}

members_read: fn(table: db.Table<MemberKey, Member>) -[DB.Read]> String {
    rows: (table.query() ?? return "unreadable").collect() ?? return "uncollected"
    ^names: [String]{}
    loop row in rows -> names.push(member_text(row))
    "[{names.join(", ")}]"
}

member_deleted: fn(table: db.Table<MemberKey, Member>, key: MemberKey) -[DB.Read, DB.Write]> String {
    if table.delete(key) == {
        .Ok(_) -> "ok"
        .Err(failure) -> failure.message()
    }
}

// The store each step opens its guarded tables from. A lambda owns what it
// captures, so a step opens its tables rather than capturing them.
Stores: struct {
    store: db.Store?,
}

STORE: Shared{Stores{store: None}}

remember: fn(store: db.Store) {
    ^stores: STORE.guard_edit()
    stores.value.store = Val(store.copy())
}

projects: fn() -> db.Table<Int, Project> {
    ^stores: STORE.guard_edit()
    store: stores.value.store ?? panic("the store is open")
    projects_in(store).guard(project_policy)
}

members: fn() -> db.Table<MemberKey, Member> {
    ^stores: STORE.guard_edit()
    store: stores.value.store ?? panic("the store is open")
    members_in(store).guard(member_policy)
}

run: fn() {
    store: db.open_memory()
    remember(store)

    transaction: store.begin() ?? panic("begin")
    created: app.as_caller(mia(), fn() { project_wrote(projects().add(Project{id: 1, name: "jet", created_by: mia()})) })
    owned: app.as_caller(mia(), fn() { member_wrote(members().add(Member{project: 1, account: mia(), owner: true})) })
    transaction.commit() ?? panic("commit")
    step("mia creates project 1 and becomes its first owner in one transaction", "{created}, {owned}")

    step("ben adds himself as an owner of project 1", app.as_caller(ben(), fn() { member_wrote(members().add(Member{project: 1, account: ben(), owner: true})) }))
    step("mia adds ben as a member", app.as_caller(mia(), fn() { member_wrote(members().add(Member{project: 1, account: ben(), owner: false})) }))
    step("ben makes himself an owner", app.as_caller(ben(), fn() { member_wrote(members().put(Member{project: 1, account: ben(), owner: true})) }))
    step("mia blanks the project's name", app.as_caller(mia(), fn() { project_wrote(projects().put(Project{id: 1, name: "", created_by: mia()})) }))
    step("mia renames the project", app.as_caller(mia(), fn() { project_wrote(projects().put(Project{id: 1, name: "jet2", created_by: mia()})) }))
    step("carol puts a project under a new key", app.as_caller(carol(), fn() { project_wrote(projects().put(Project{id: 2, name: "solo", created_by: carol()})) }))

    step("carol reads project 1", app.as_caller(carol(), fn() { project_read(projects(), 1) }))
    step("ben reads project 1", app.as_caller(ben(), fn() { project_read(projects(), 1) }))
    step("carol reads the members", app.as_caller(carol(), fn() { members_read(members()) }))
    step("ben reads the members", app.as_caller(ben(), fn() { members_read(members()) }))

    step("carol removes mia", app.as_caller(carol(), fn() { member_deleted(members(), MemberKey{project: 1, account: mia()}) }))
    step("ben leaves the project", app.as_caller(ben(), fn() { member_deleted(members(), MemberKey{project: 1, account: ben()}) }))
    step("the system reads the members", app.as_system(fn() { members_read(members()) }))
}
