// A row policy narrows the rows of its one table, and its scope reaches no
// other: a scope over `notes` runs `SELECT 1`, which names no table, narrows
// its own table's rows to its user, and refuses SQL that names another table
// (E2477), a join through its table included.
use db: core.db

run: fn() {
    c := db.open_memory()
    _: db.migrate(c.all_rows(), "notes-v1", [SQL{"CREATE TABLE notes (owner TEXT, title TEXT)"}, SQL{"CREATE TABLE tags (tag TEXT)"}]) ?? panic("migrate: {err}")
    _: c.execute(SQL{"INSERT INTO notes (owner, title) VALUES ('ann', 'plan'), ('ben', 'diary')"}) ?? panic("notes: {err}")
    _: c.execute(SQL{"INSERT INTO tags (tag) VALUES ('work')"}) ?? panic("tags: {err}")
    owned: db.policy("notes", "owner == user") ?? panic("policy: {err}")
    ann: c.with_policy(owned, "ann")
    one: ann.query(SQL{"SELECT 1 AS one"}) ?? panic("select 1: {err}")
    print("select 1: {one.len()} row, one = {db.row_int(one[0], "one") ?? -1}")
    if ann.query(SQL{"SELECT tag FROM tags"}) == {
        .Ok(tags) -> { print("another table: {tags.len()} row") }
        .Err(failure) -> { print("another table: {failure.message()}") }
    }
    mine: ann.query(SQL{"SELECT title FROM notes"}) ?? panic("notes: {err}")
    print("ann's notes: {mine.len()}")
    if ann.query(SQL{"SELECT tag FROM tags JOIN notes"}) == {
        .Ok(_) -> { print("a join through notes: ran") }
        .Err(_) -> { print("a join through notes: refused") }
    }
}
