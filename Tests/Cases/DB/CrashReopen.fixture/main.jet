// Real crash-consistency test on the emitted core.db engine:
// - Records every reachable VFS create, write, truncate, delete, sync, and
//   dirsync boundary of a multi-page two-transaction workload in both
//   rollback-journal (DELETE) and WAL modes.
// - Materializes crash disk images under the local POSIX durable storage model
//   (prefix-all, dropped unsynced writes, and seeded reordered unsynced writes).
// - Reopens every crash image with real core.db.open, asserts
//   PRAGMA integrity_check = ok and whole-or-absent transaction state.
// - Runs the same harness with PRAGMA synchronous = OFF to prove a real
//   failing schedule is caught, replayed deterministically from its seed,
//   and reduced to a minimal failing schedule.
use {
    db: core.db
    files: core.files
    random: core.math.random
}

VfsOpKind: enum {
    Create,
    Write,
    Truncate,
    Sync,
    Delete,
    DirSync,
}

VfsEvent: struct {
    kind: VfsOpKind,
    seq: Int,
    file: String,
    inode: Int,
    offset: Int,
    size: Int,
    bytes: [U8],
}

CrashSchedule: struct {
    seed: Int,
    boundary: Int,
    kept_unsynced: [Int],
    label: String,
}

CrashFailure: struct {
    schedule: CrashSchedule,
    reason: String,
}

hex_nibble: fn(b: U8) -> Int Never! {
    v: Int{b}
    if v >= 48 && v <= 57 -> return v - 48
    if v >= 97 && v <= 102 -> return v - 87
    if v >= 65 && v <= 70 {
        return v - 55
    }
    -1
}

decode_hex: fn(text: String) -> [U8] Err! {
    raw: text.bytes()
    if raw.len() % 2 != 0 -> return Err("odd hex length")
    ^out: [U8]{}
    ^i: 0
    loop i < raw.len() {
        hi: hex_nibble(raw[i])
        lo: hex_nibble(raw[i + 1])
        if hi < 0 || lo < 0 -> return Err("invalid hex digit")
        out.push(U8{(hi << 4) | lo})
        i += 2
    }
    Ok(out)
}

parse_int_str: fn(text: String) -> Int Err! {
    raw: text.bytes()
    if raw.len() == 0 -> return Err("empty integer")
    ^val: 0
    loop b in raw {
        d: Int{b}
        if d < 48 || d > 57 -> return Err("bad integer `{text}`")
        val = val * 10 + (d - 48)
    }
    Ok(val)
}

split_pipe: fn(line: String) -> [String] Never! {
    raw: line.bytes()
    ^parts: [String]{}
    ^cur: [U8]{}
    loop b in raw {
        if b == (U8{124}) {
            parts.push(String.from_bytes(cur.copy()) ?? "")
            cur = [U8]{}
        } else { cur.push(b) }
    }
    parts.push(String.from_bytes(cur) ?? "")
    parts
}

parse_trace: fn(text: String) -> [VfsEvent] Err! {
    ^events: [VfsEvent]{}
    raw: text.bytes()
    ^cur: [U8]{}
    ^lines: [String]{}
    loop b in raw {
        if b == (U8{10}) {
            if cur.len() > 0 -> lines.push(String.from_bytes(cur.copy()) ?? "")
            cur = [U8]{}
        } else if b != (U8{13}) { cur.push(b) }
    }
    if cur.len() > 0 -> lines.push(String.from_bytes(cur) ?? "")
    loop line in lines {
        parts: split_pipe(line)
        if parts.len() < 3 -> return Err("malformed trace line: {line}")
        tag: parts[0]
        seq: parse_int_str(parts[1]) ?? return Err(err)
        if tag == "CREATE" {
            if parts.len() != 4 -> return Err("bad CREATE line: {line}")
            events.push(VfsEvent{kind: .Create, seq: seq, file: parts[2].copy(), inode: -1, offset: 0, size: 0, bytes: [U8]{}})
        } else if tag == "WRITE" {
            if parts.len() != 6 -> return Err("bad WRITE line: {line}")
            off: parse_int_str(parts[3]) ?? return Err(err)
            sz: parse_int_str(parts[4]) ?? return Err(err)
            payload: decode_hex(parts[5]) ?? return Err(err)
            if payload.len() != sz -> return Err("WRITE length mismatch: {line}")
            events.push(VfsEvent{kind: .Write, seq: seq, file: parts[2].copy(), inode: -1, offset: off, size: sz, bytes: payload})
        } else if tag == "TRUNCATE" {
            if parts.len() != 4 -> return Err("bad TRUNCATE line: {line}")
            sz: parse_int_str(parts[3]) ?? return Err(err)
            events.push(VfsEvent{kind: .Truncate, seq: seq, file: parts[2].copy(), inode: -1, offset: 0, size: sz, bytes: [U8]{}})
        } else if tag == "SYNC" {
            if parts.len() != 4 -> return Err("bad SYNC line: {line}")
            flags: parse_int_str(parts[3]) ?? return Err(err)
            events.push(VfsEvent{kind: .Sync, seq: seq, file: parts[2].copy(), inode: -1, offset: 0, size: flags, bytes: [U8]{}})
        } else if tag == "DELETE" {
            if parts.len() != 3 -> return Err("bad DELETE line: {line}")
            events.push(VfsEvent{kind: .Delete, seq: seq, file: parts[2].copy(), inode: -1, offset: 0, size: 0, bytes: [U8]{}})
        } else if tag == "DIRSYNC" {
            if parts.len() != 3 -> return Err("bad DIRSYNC line: {line}")
            events.push(VfsEvent{kind: .DirSync, seq: seq, file: parts[2].copy(), inode: -1, offset: 0, size: 0, bytes: [U8]{}})
        } else {
            return Err("unknown VFS trace event: {tag}")
        }
    }
    Ok(events)
}

// Apply a single write to a byte buffer (zero-extending if offset > len).
apply_write_bytes: fn(buf: ^[U8], offset: Int, data: [U8]) Never! {
    end: offset + data.len()
    loop buf.len() < end -> buf.push(U8{0})
    loop i in 0..<data.len() -> buf[offset + i] = data[i]
}

// Apply a truncate to a byte buffer.
apply_truncate_bytes: fn(buf: ^[U8], size: Int) Never! {
    loop buf.len() > size -> _: buf.pop()
    loop buf.len() < size -> buf.push(U8{0})
}

DiskFile: struct {
    name: String,
    exists: Bool,
    data: [U8],
}

DirLink: struct {
    name: String,
    inode: Int,
}

InodeEntry: struct {
    id: Int,
    data: [U8],
}

dir_find: fn(links: [DirLink], name: String) -> Int Never! {
    loop i in 0..<links.len() {
        if links[i].name == name -> return i
    }
    -1
}

dir_set: fn(links: ^[DirLink], name: String, inode: Int) Never! {
    found: dir_find(links, name)
    if found >= 0 {
        links[found].inode = inode
        return
    }
    links.push(DirLink{name: name.copy(), inode: inode})
}

inode_find: fn(inodes: [InodeEntry], id: Int) -> Int Never! {
    loop i in 0..<inodes.len() {
        if inodes[i].id == id -> return i
    }
    -1
}

inode_ensure: fn(inodes: ^[InodeEntry], id: Int) -> Int Never! {
    found: inode_find(inodes, id)
    if found >= 0 -> return found
    inodes.push(InodeEntry{id: id, data: [U8]{}})
    inodes.len() - 1
}

// Tag every VFS event with its POSIX inode id: each pre-existing base file
// gets a distinct inode id, and each CREATE allocates a fresh empty inode id
// so writes to a newly created journal/WAL inode never bleed into a previously
// unlinked inode of the same path.
assign_inodes: fn(base_files: [DiskFile], raw_events: [VfsEvent]) -> [VfsEvent] Never! {
    ^live: [DirLink]{}
    ^next_id: 1
    loop f in base_files {
        if f.exists {
            dir_set(live, f.name, next_id)
            next_id += 1
        }
    }
    ^out: [VfsEvent]{}
    loop ev in raw_events {
        ^e: ev.copy()
        if e.kind == {
            .Create -> {
                e.inode = next_id
                dir_set(live, e.file, next_id)
                next_id += 1
            }
            .Write | .Truncate | .Sync -> {
                idx: dir_find(live, e.file)
                if idx >= 0 && live[idx].inode > 0 {
                    e.inode = live[idx].inode
                } else {
                    e.inode = next_id
                    dir_set(live, e.file, next_id)
                    next_id += 1
                }
            }
            .Delete -> {
                idx: dir_find(live, e.file)
                e.inode = if idx >= 0 -> live[idx].inode else -> -1
                dir_set(live, e.file, -1)
            }
            .DirSync -> { e.inode = 0 }
        }
        out.push(e)
    }
    out
}

// Compute the durable POSIX filesystem state (directory entries + per-inode
// synced bytes) plus the list of still-unsynced op indices after executing
// events[0..<boundary].
durable_at_boundary: fn(base_files: [DiskFile], events: [VfsEvent], boundary: Int) -> {links: [DirLink], inodes: [InodeEntry], pending: [Int]} Never! {
    ^links: [DirLink]{}
    ^inodes: [InodeEntry]{}
    ^next_id: 1
    loop f in base_files {
        if f.exists {
            dir_set(links, f.name, next_id)
            inodes.push(InodeEntry{id: next_id, data: f.data.copy()})
            next_id += 1
        }
    }
    ^pending: [Int]{}
    loop i in 0..<boundary {
        ev: events[i]
        if ev.kind == {
            .Create | .Write | .Truncate | .Delete -> { pending.push(i) }
            .Sync -> {
                // fsync(fd) flushes all pending writes/truncates for ev.inode in order.
                slot: inode_ensure(inodes, ev.inode)
                ^still: [Int]{}
                loop idx in pending {
                    pe: events[idx]
                    if pe.inode == ev.inode && pe.kind == .Write {
                        apply_write_bytes(inodes[slot].data, pe.offset, pe.bytes)
                    } else if pe.inode == ev.inode && pe.kind == .Truncate {
                        apply_truncate_bytes(inodes[slot].data, pe.size)
                    } else { still.push(idx) }
                }
                pending = still
            }
            .DirSync -> {
                // fsync(dirfd) flushes all pending CREATE/DELETE directory entries in order.
                ^still: [Int]{}
                loop idx in pending {
                    pe: events[idx]
                    if pe.kind == .Create {
                        _: inode_ensure(inodes, pe.inode)
                        dir_set(links, pe.file, pe.inode)
                    } else if pe.kind == .Delete {
                        at: dir_find(links, pe.file)
                        if at >= 0 && links[at].inode == pe.inode -> links[at].inode = -1
                    } else { still.push(idx) }
                }
                pending = still
            }
        }
    }
    {links: links, inodes: inodes, pending: pending}
}

// Materialize the exact crash disk image for (boundary, kept_unsynced):
// starts from durable (links, inodes) at `boundary`, then applies the ordered
// subset `kept_unsynced` of unsynced operations to their own inodes/links.
materialize_image: fn(base_files: [DiskFile], events: [VfsEvent], boundary: Int, kept_unsynced: [Int]) -> [DiskFile] Never! {
    state: durable_at_boundary(base_files, events, boundary)
    ^links: state.links
    ^inodes: state.inodes
    loop idx in kept_unsynced {
        pe: events[idx]
        if pe.kind == {
            .Create -> {
                _: inode_ensure(inodes, pe.inode)
                dir_set(links, pe.file, pe.inode)
            }
            .Delete -> {
                at: dir_find(links, pe.file)
                if at >= 0 && links[at].inode == pe.inode -> links[at].inode = -1
            }
            .Write -> {
                slot: inode_ensure(inodes, pe.inode)
                apply_write_bytes(inodes[slot].data, pe.offset, pe.bytes)
            }
            .Truncate -> {
                slot: inode_ensure(inodes, pe.inode)
                apply_truncate_bytes(inodes[slot].data, pe.size)
            }
            .Sync | .DirSync -> {}
        }
    }
    ^disk: [DiskFile]{}
    loop link in links {
        if link.inode > 0 {
            slot: inode_find(inodes, link.inode)
            data: if slot >= 0 -> inodes[slot].data.copy() else -> [U8]{}
            disk.push(DiskFile{name: link.name.copy(), exists: true, data: data})
        }
    }
    disk
}

// Read canonical workload state from a reopened database:
// checks PRAGMA integrity_check = ok, then reads both `accounts` and `transfers`
// (two separate tables / B-tree pages) so a torn multi-page write is always visible.
// Returns Ok(state_index) in 0..<allowed.len(), or Err(failure_reason).
reopen_and_check: fn(crash_dir: String, db_name: String, disk: [DiskFile], allowed: [String]) -[DB, FS]> Int Err! {
    if files.exists(crash_dir) -> files.remove_all(crash_dir) ?? ()
    files.create_dir_all(crash_dir) ?? return Err("could not create crash dir: {err}")
    loop f in disk {
        if !f.exists -> next
        full: "{crash_dir}/{f.name}"
        files.write_bytes(full, f.data) ?? return Err("could not write crash file {f.name}: {err}")
    }
    db_path: "{crash_dir}/{db_name}"
    store: db.open(db_path)
    // 1. PRAGMA integrity_check MUST return a single row "ok".
    ic_rows: store.query(SQL{"PRAGMA integrity_check"}) ?? {
        _: store.close()
        return Err("PRAGMA integrity_check errored: {err.message()}")
    }
    if ic_rows.len() != 1 {
        _: store.close()
        return Err("PRAGMA integrity_check returned {ic_rows.len()} rows")
    }
    ic_text: db.row_text(ic_rows[0], "integrity_check") ?? {
        _: store.close()
        return Err("PRAGMA integrity_check missing text column")
    }
    if ic_text != "ok" {
        _: store.close()
        return Err("PRAGMA integrity_check failed: {ic_text}")
    }
    // 2. Query both tables to verify whole-or-absent multi-page atomicity.
    acc_rows: store.query(SQL{"SELECT id, owner, balance FROM accounts ORDER BY id"}) ?? {
        _: store.close()
        return Err("accounts query errored: {err.message()}")
    }
    tx_rows: store.query(SQL{"SELECT id, amount, note FROM transfers ORDER BY id"}) ?? {
        _: store.close()
        return Err("transfers query errored: {err.message()}")
    }
    _: store.close()
    ^acc_parts: [String]{}
    loop row in acc_rows {
        id: db.row_int(row, "id") ?? -1
        owner: db.row_text(row, "owner") ?? "?"
        bal: db.row_int(row, "balance") ?? -1
        acc_parts.push("{id}:{owner}:{bal}")
    }
    ^tx_parts: [String]{}
    loop row in tx_rows {
        id: db.row_int(row, "id") ?? -1
        amt: db.row_int(row, "amount") ?? -1
        note: db.row_text(row, "note") ?? "?"
        tx_parts.push("{id}:{amt}:{note}")
    }
    snapshot: "{acc_parts.join(",")}|{tx_parts.join(",")}"
    loop i in 0..<allowed.len() {
        if snapshot == allowed[i] -> return Ok(i)
    }
    Err("torn or unexpected state `{snapshot}`")
}

// Generate deterministic crash schedules covering EVERY reachable write,
// truncate, delete, and sync boundary, including dropped and reordered
// unsynced writes derived from `seed`.
build_schedules: fn(base_files: [DiskFile], events: [VfsEvent], seed: Int) -> [CrashSchedule] Never! {
    ^schedules: [CrashSchedule]{}
    loop boundary in 0..<events.len() + 1 {
        st: durable_at_boundary(base_files, events, boundary)
        // 1. All unsynced writes dropped (pure durable state at boundary).
        schedules.push(CrashSchedule{seed: seed, boundary: boundary, kept_unsynced: [Int]{}, label: "b{boundary}:drop_all"})
        if st.pending.len() > 0 {
            // 2. Prefix-all-kept (every unsynced op up to boundary landed).
            schedules.push(CrashSchedule{seed: seed, boundary: boundary, kept_unsynced: st.pending.copy(), label: "b{boundary}:keep_all"})
        }
        if st.pending.len() >= 2 {
            // 3. Reordered: keep only the newest unsynced write (earlier unsynced writes dropped).
            last_idx: st.pending[st.pending.len() - 1]
            ^only_last: [Int]{}
            last_file: events[last_idx].file
            loop p in st.pending {
                if events[p].kind == .Create && events[p].file == last_file -> only_last.push(p)
            }
            if !only_last.contains(last_idx) -> only_last.push(last_idx)
            schedules.push(CrashSchedule{seed: seed, boundary: boundary, kept_unsynced: only_last, label: "b{boundary}:reorder_last_only"})
            // 4. Reordered: drop the earliest unsynced write while keeping later writes.
            ^drop_first: [Int]{}
            loop j in 1..<st.pending.len() -> drop_first.push(st.pending[j])
            schedules.push(CrashSchedule{seed: seed, boundary: boundary, kept_unsynced: drop_first, label: "b{boundary}:drop_first"})
            // 5. Seeded random reordered subset of unsynced ops.
            ^rng: random.rng(seed * 1009 + boundary * 9176 + 17)
            ^subset: [Int]{}
            loop p in st.pending {
                if rng.bool() -> subset.push(p)
            }
            ^k: subset.len() - 1
            loop k > 0 {
                j: rng.int(0, k)
                tmp: subset[k]
                subset[k] = subset[j]
                subset[j] = tmp
                k -= 1
            }
            schedules.push(CrashSchedule{seed: seed, boundary: boundary, kept_unsynced: subset, label: "b{boundary}:seeded_reorder"})
        }
    }
    schedules
}

// Run the real two-transaction workload (updating two separate tables / pages
// in each transaction) and return base disk snapshot + recorded VFS events.
record_two_tx_workload: fn(work_dir: String, journal_mode: String, sync_mode: String) -[DB, FS]> {base: [DiskFile], events: [VfsEvent]} Never! {
    if files.exists(work_dir) -> files.remove_all(work_dir) ?? ()
    files.create_dir_all(work_dir) ?? panic("mkdir work_dir: {err}")
    db_path: "{work_dir}/ledger.db"
    trace_path: "{work_dir}/vfs.trace"
    init_store: db.open(db_path)
    _: db.migrate(init_store.all_rows(), "ledger-v1", [
        SQL{"CREATE TABLE accounts (id INTEGER PRIMARY KEY, owner TEXT NOT NULL, balance INTEGER NOT NULL)"},
        SQL{"CREATE TABLE transfers (id INTEGER PRIMARY KEY, amount INTEGER NOT NULL, note TEXT NOT NULL)"},
    ]) ?? panic("migrate: {err}")
    _: init_store.execute(SQL{"INSERT INTO accounts (id, owner, balance) VALUES (1, 'alice', 1000), (2, 'bob', 1000)"}) ?? panic("seed accounts: {err}")
    _: init_store.execute(SQL{"INSERT INTO transfers (id, amount, note) VALUES (1, 0, 'opening')"}) ?? panic("seed transfers: {err}")
    jm_rows: init_store.query(db.SQL.raw("PRAGMA journal_mode = {journal_mode}")) ?? panic("journal_mode: {err}")
    assert_eq(jm_rows.len(), 1)
    _: init_store.close()
    store: db.open(db_path)
    _: store.execute(db.SQL.raw("PRAGMA synchronous = {sync_mode}")) ?? panic("synchronous: {err}")
    // Snapshot every durable DB file present at the moment tracing begins
    // (in WAL mode, opening the store already creates the empty 0-byte -wal file).
    ^base_files: [DiskFile]{DiskFile{name: "ledger.db", exists: true, data: files.read_bytes(db_path) ?? panic("read base db: {err}")}}
    wal_path: "{work_dir}/ledger.db-wal"
    if files.exists(wal_path) {
        base_files.push(DiskFile{name: "ledger.db-wal", exists: true, data: files.read_bytes(wal_path) ?? [U8]{}})
    }
    jrnl_path: "{work_dir}/ledger.db-journal"
    if files.exists(jrnl_path) {
        base_files.push(DiskFile{name: "ledger.db-journal", exists: true, data: files.read_bytes(jrnl_path) ?? [U8]{}})
    }
    assert(store.trace_vfs(Val(trace_path)))
    // Transaction 1: S0 -> S1 (mutates both `accounts` and `transfers` pages).
    ^tx1: store.begin() ?? panic("tx1 begin: {err}")
    _: store.execute(SQL{"UPDATE accounts SET balance = 750 WHERE id = 1"}) ?? panic("tx1 u1: {err}")
    _: store.execute(SQL{"UPDATE accounts SET balance = 1250 WHERE id = 2"}) ?? panic("tx1 u2: {err}")
    _: store.execute(SQL{"INSERT INTO transfers (id, amount, note) VALUES (2, 250, 'tx1')"}) ?? panic("tx1 ins: {err}")
    tx1.commit() ?? panic("tx1 commit: {err}")
    // Transaction 2: S1 -> S2 (mutates both `accounts` and `transfers` pages).
    ^tx2: store.begin() ?? panic("tx2 begin: {err}")
    _: store.execute(SQL{"UPDATE accounts SET balance = 850 WHERE id = 1"}) ?? panic("tx2 u1: {err}")
    _: store.execute(SQL{"UPDATE accounts SET balance = 1150 WHERE id = 2"}) ?? panic("tx2 u2: {err}")
    _: store.execute(SQL{"INSERT INTO accounts (id, owner, balance) VALUES (3, 'carol', 500)"}) ?? panic("tx2 ins acc: {err}")
    _: store.execute(SQL{"INSERT INTO transfers (id, amount, note) VALUES (3, 100, 'tx2')"}) ?? panic("tx2 ins tx: {err}")
    tx2.commit() ?? panic("tx2 commit: {err}")
    assert(store.trace_vfs(None))
    _: store.close()
    trace_text: files.read(trace_path) ?? panic("read trace: {err}")
    raw_events: parse_trace(trace_text) ?? panic("parse trace: {err}")
    events: assign_inodes(base_files, raw_events)
    {base: base_files, events: events}
}

// Replay a single CrashSchedule against the real core.db engine.
check_schedule: fn(crash_dir: String, base_files: [DiskFile], events: [VfsEvent], sched: CrashSchedule, allowed: [String]) -[DB, FS]> Int Err! {
    img: materialize_image(base_files, events, sched.boundary, sched.kept_unsynced)
    reopen_and_check(crash_dir, "ledger.db", img, allowed)
}

// Reduce a failing CrashSchedule to a 1-minimal failing schedule:
// drop unnecessary ops from kept_unsynced until every remaining op is necessary,
// then shrink boundary to the minimal prefix covering kept_unsynced.
reduce_failing_schedule: fn(crash_dir: String, base_files: [DiskFile], events: [VfsEvent], initial: CrashSchedule, allowed: [String]) -[DB, FS]> CrashFailure Never! {
    ^best: initial.copy()
    ^best_reason: ""
    if check_schedule(crash_dir, base_files, events, best, allowed) == {
        .Ok(_) -> panic("initial schedule must fail")
        .Err(reason) -> { best_reason = "{reason}" }
    }
    ^changed: true
    loop changed {
        changed = false
        ^i: 0
        loop i < best.kept_unsynced.len() {
            ^cand_kept: [Int]{}
            loop j in 0..<best.kept_unsynced.len() {
                if j != i -> cand_kept.push(best.kept_unsynced[j])
            }
            cand: CrashSchedule{seed: best.seed, boundary: best.boundary, kept_unsynced: cand_kept, label: "reduced"}
            if check_schedule(crash_dir, base_files, events, cand, allowed) == {
                .Ok(_) -> {}
                .Err(reason) -> {
                    best = cand
                    best_reason = "{reason}"
                    changed = true
                    break
                }
            }
            i += 1
        }
    }
    ^min_b: 0
    loop idx in best.kept_unsynced {
        if idx + 1 > min_b -> min_b = idx + 1
    }
    if min_b < best.boundary {
        cand: CrashSchedule{seed: best.seed, boundary: min_b, kept_unsynced: best.kept_unsynced.copy(), label: "reduced"}
        if check_schedule(crash_dir, base_files, events, cand, allowed) == {
            .Ok(_) -> {}
            .Err(reason) -> {
                best = cand
                best_reason = "{reason}"
            }
        }
    }
    CrashFailure{schedule: best, reason: best_reason}
}

CrashStorageSpec: struct {
    fs_type: String,
    journal_mode: String,
    synchronous: String,
    honors_fsync: Bool,
    honors_dirsync: Bool,
}

CrashOracleSpec: struct {
    require_integrity_check: Bool,
    allowed_states: [String],
}

CrashBudget: struct {
    budget_ms: Int,
    step_cost_ms: Int,
    max_schedules: Int,
    skip_boundary: Int?,
}

CrashVerdict: enum {
    Passed(count: Int, seen: [Int]),
    Failed(String),
    Refused(String),
}

crash_is_network_fs: fn(fs_type: String) -> Bool Never! {
    net_fs: [String]{"nfs", "nfs4", "cifs", "smb", "smb3", "sshfs", "fuse.sshfs", "9p", "davfs", "glusterfs", "ceph", "lustre", "afp", "webdav"}
    loop name in net_fs {
        if fs_type == name -> return true
    }
    false
}

crash_is_supported_local_fs: fn(fs_type: String) -> Bool Never! {
    local_fs: [String]{"ext4", "xfs", "btrfs", "zfs", "apfs", "ntfs"}
    loop name in local_fs {
        if fs_type == name -> return true
    }
    false
}

validate_crash_storage: fn(spec: CrashStorageSpec) -> String? Never! {
    if crash_is_network_fs(spec.fs_type) {
        return Val("unsupported storage: network filesystem `{spec.fs_type}` gets no untested atomicity promise")
    }
    if !crash_is_supported_local_fs(spec.fs_type) {
        return Val("unsupported storage: filesystem `{spec.fs_type}` is not a verified local crash-consistent POSIX store")
    }
    if !spec.honors_fsync {
        return Val("unsupported storage: storage does not honor fsync barriers")
    }
    if !spec.honors_dirsync {
        return Val("unsupported storage: storage does not honor directory sync barriers")
    }
    if spec.synchronous != "FULL" && spec.synchronous != "EXTRA" && spec.synchronous != "NORMAL" {
        return Val("unsupported storage: PRAGMA synchronous={spec.synchronous} provides no crash-consistency guarantee")
    }
    if spec.journal_mode != "DELETE" && spec.journal_mode != "TRUNCATE" && spec.journal_mode != "PERSIST" && spec.journal_mode != "WAL" {
        return Val("unsupported storage: PRAGMA journal_mode={spec.journal_mode} provides no crash-consistency guarantee")
    }
    None
}

validate_crash_oracle: fn(oracle: CrashOracleSpec) -> String? Never! {
    if !oracle.require_integrity_check {
        return Val("invalid oracle: PRAGMA integrity_check cannot be disabled")
    }
    if oracle.allowed_states.len() < 2 {
        return Val("invalid oracle: workload oracle needs at least initial and committed states")
    }
    loop i in 0..<oracle.allowed_states.len() {
        if oracle.allowed_states[i].count_bytes() == 0 {
            return Val("invalid oracle: empty allowed state at index {i}")
        }
        loop j in i + 1..<oracle.allowed_states.len() {
            if oracle.allowed_states[i] == oracle.allowed_states[j] {
                return Val("invalid oracle: duplicate allowed state `{oracle.allowed_states[i]}`")
            }
        }
    }
    None
}

run_crash_harness: fn(work_dir: String, base: [DiskFile], events: [VfsEvent], seed: Int, storage: CrashStorageSpec, oracle: CrashOracleSpec, budget: CrashBudget) -[FS, DB]> CrashVerdict Never! {
    if validate_crash_storage(storage) == .Val(reason) -> return CrashVerdict.Refused(reason)
    if validate_crash_oracle(oracle) == .Val(reason) -> return CrashVerdict.Refused(reason)
    if events.len() == 0 -> return CrashVerdict.Refused("incomplete schedule: VFS trace recorded zero events")
    if budget.skip_boundary != None -> return CrashVerdict.Refused("incomplete schedule: boundary skipping is forbidden")
    schedules: build_schedules(base, events, seed)
    if schedules.len() == 0 -> return CrashVerdict.Refused("incomplete schedule: zero crash schedules generated")
    if budget.max_schedules > 0 && schedules.len() > budget.max_schedules {
        return CrashVerdict.Refused("incomplete schedule: cap {budget.max_schedules} omits {schedules.len() - budget.max_schedules} reachable crash states")
    }
    ^seen: [Int]{}
    loop _ in 0..<oracle.allowed_states.len() -> seen.push(0)
    ^elapsed_ms: 0
    loop sched in schedules {
        elapsed_ms += budget.step_cost_ms
        if budget.budget_ms > 0 && elapsed_ms > budget.budget_ms {
            return CrashVerdict.Refused("timeout: crash schedule budget {budget.budget_ms}ms exceeded before completing all {schedules.len()} schedules")
        }
        if check_schedule(work_dir, base, events, sched, oracle.allowed_states) == {
            .Ok(state_idx) -> { seen[state_idx] = seen[state_idx] + 1 }
            .Err(reason) -> return CrashVerdict.Failed("{storage.journal_mode}/{storage.synchronous} crash failed at {sched.label} (b={sched.boundary}, kept={sched.kept_unsynced}): {reason}")
        }
    }
    CrashVerdict.Passed{count: schedules.len(), seen: seen}
}

assert_crash_refused: fn(v: CrashVerdict, expected_substr: String, label: String) Never! {
    if v == {
        .Refused(reason) -> {
            if !reason.contains(expected_substr) {
                panic("{label}: expected refusal containing `{expected_substr}`, got `{reason}`")
            }
        }
        .Passed(n, _) -> panic("{label}: expected Refused, got Passed({n})")
        .Failed(reason) -> panic("{label}: expected Refused, got Failed({reason})")
    }
}

assert_mode_passes: fn(root: String, tag: String, journal_mode: String, synchronous: String, seed: Int, allowed: [String], min_writes: Int, min_syncs: Int) -[FS, DB]> {base: [DiskFile], events: [VfsEvent]} Never! {
    rec: record_two_tx_workload("{root}/{tag}_src", journal_mode, synchronous)
    ^writes: 0
    ^syncs: 0
    loop ev in rec.events {
        if ev.kind == .Write -> writes += 1
        if ev.kind == .Sync || ev.kind == .DirSync -> syncs += 1
    }
    assert(writes >= min_writes)
    assert(syncs >= min_syncs)
    storage: CrashStorageSpec{fs_type: "ext4", journal_mode: journal_mode, synchronous: synchronous, honors_fsync: true, honors_dirsync: true}
    oracle: CrashOracleSpec{require_integrity_check: true, allowed_states: allowed}
    budget: CrashBudget{budget_ms: 0, step_cost_ms: 1, max_schedules: 0, skip_boundary: None}
    if run_crash_harness("{root}/{tag}_crash", rec.base, rec.events, seed, storage, oracle, budget) == {
        .Passed(count, seen) -> {
            assert(count > 0)
            assert(seen[0] > 0 && seen[1] > 0 && seen[2] > 0)
        }
        .Failed(reason) -> panic("{tag}: {reason}")
        .Refused(reason) -> panic("{tag}: unexpectedly refused: {reason}")
    }
    rec
}

#Test("db_crash_reopen") {
    root: files.mkdtemp("db_crash_reopen") ?? panic("mkdtemp: {err}")
    s0: "1:alice:1000,2:bob:1000|1:0:opening"
    s1: "1:alice:750,2:bob:1250|1:0:opening,2:250:tx1"
    s2: "1:alice:850,2:bob:1150,3:carol:500|1:0:opening,2:250:tx1,3:100:tx2"
    allowed: [String]{s0, s1, s2}
    // Part 1: Rollback-journal modes (DELETE, TRUNCATE, PERSIST) and WAL under
    // FULL, EXTRA, and NORMAL sync modes — every reachable write, truncate,
    // delete, and sync boundary + dropped/reordered unsynced writes.
    del_rec: assert_mode_passes(root, "delete_full", "DELETE", "FULL", 6876, allowed, 4, 4)
    _: assert_mode_passes(root, "truncate_full", "TRUNCATE", "FULL", 6878, allowed, 4, 4)
    _: assert_mode_passes(root, "persist_full", "PERSIST", "FULL", 6879, allowed, 4, 4)
    _: assert_mode_passes(root, "delete_extra", "DELETE", "EXTRA", 6880, allowed, 4, 4)
    _: assert_mode_passes(root, "wal_full", "WAL", "FULL", 6877, allowed, 4, 2)
    _: assert_mode_passes(root, "wal_normal", "WAL", "NORMAL", 6881, allowed, 4, 1)
    // Part 2: Fail-closed harness refusals exercised directly on the real
    // `run_crash_harness` over the real `del_rec` trace.
    valid_storage: CrashStorageSpec{fs_type: "ext4", journal_mode: "DELETE", synchronous: "FULL", honors_fsync: true, honors_dirsync: true}
    valid_oracle: CrashOracleSpec{require_integrity_check: true, allowed_states: allowed}
    valid_budget: CrashBudget{budget_ms: 0, step_cost_ms: 1, max_schedules: 0, skip_boundary: None}
    net_fs_list: [String]{"nfs", "nfs4", "cifs", "smb", "smb3", "sshfs", "9p", "glusterfs", "ceph", "lustre", "afp", "webdav"}
    loop net_fs in net_fs_list {
        net_spec: CrashStorageSpec{fs_type: net_fs, journal_mode: "DELETE", synchronous: "FULL", honors_fsync: true, honors_dirsync: true}
        assert_crash_refused(run_crash_harness("{root}/refuse_net", del_rec.base, del_rec.events, 6876, net_spec, valid_oracle, valid_budget), "network filesystem", "net:{net_fs}")
    }
    assert_crash_refused(run_crash_harness("{root}/refuse_fsync", del_rec.base, del_rec.events, 6876, CrashStorageSpec{fs_type: "ext4", journal_mode: "DELETE", synchronous: "FULL", honors_fsync: false, honors_dirsync: true}, valid_oracle, valid_budget), "fsync", "no-fsync")
    assert_crash_refused(run_crash_harness("{root}/refuse_dirsync", del_rec.base, del_rec.events, 6876, CrashStorageSpec{fs_type: "ext4", journal_mode: "DELETE", synchronous: "FULL", honors_fsync: true, honors_dirsync: false}, valid_oracle, valid_budget), "directory sync", "no-dirsync")
    assert_crash_refused(run_crash_harness("{root}/refuse_sync_off", del_rec.base, del_rec.events, 6876, CrashStorageSpec{fs_type: "ext4", journal_mode: "DELETE", synchronous: "OFF", honors_fsync: true, honors_dirsync: true}, valid_oracle, valid_budget), "synchronous=OFF", "sync-off")
    assert_crash_refused(run_crash_harness("{root}/refuse_oracle", del_rec.base, del_rec.events, 6876, valid_storage, CrashOracleSpec{require_integrity_check: false, allowed_states: allowed}, valid_budget), "invalid oracle", "no-integrity-check")
    assert_crash_refused(run_crash_harness("{root}/refuse_timeout", del_rec.base, del_rec.events, 6876, valid_storage, valid_oracle, CrashBudget{budget_ms: 2, step_cost_ms: 5, max_schedules: 0, skip_boundary: None}), "timeout", "timeout")
    assert_crash_refused(run_crash_harness("{root}/refuse_cap", del_rec.base, del_rec.events, 6876, valid_storage, valid_oracle, CrashBudget{budget_ms: 0, step_cost_ms: 1, max_schedules: 1, skip_boundary: None}), "incomplete schedule", "capped")
    assert_crash_refused(run_crash_harness("{root}/refuse_skip", del_rec.base, del_rec.events, 6876, valid_storage, valid_oracle, CrashBudget{budget_ms: 0, step_cost_ms: 1, max_schedules: 0, skip_boundary: Val(1)}), "incomplete schedule", "skipped")
    // Part 3: Seed replay & 1-minimal schedule reduction proof on real core.db
    // with synchronous=OFF (reordered unsynced writes yield a real torn state).
    unsafe_rec: record_two_tx_workload("{root}/unsafe_src", "DELETE", "OFF")
    unsafe_seed: 68760
    unsafe_schedules: build_schedules(unsafe_rec.base, unsafe_rec.events, unsafe_seed)
    ^found_idx: -1
    ^first_reason: ""
    loop i in 0..<unsafe_schedules.len() {
        if check_schedule("{root}/unsafe_crash", unsafe_rec.base, unsafe_rec.events, unsafe_schedules[i], allowed) == {
            .Ok(_) -> {}
            .Err(reason) -> {
                found_idx = i
                first_reason = "{reason}"
                break
            }
        }
    }
    assert(found_idx >= 0)
    failing: unsafe_schedules[found_idx]
    // Deterministic replay from seed alone reproduces the exact same failing schedule & failure.
    replayed_list: build_schedules(unsafe_rec.base, unsafe_rec.events, unsafe_seed)
    replayed: replayed_list[found_idx]
    assert_eq(replayed.boundary, failing.boundary)
    assert_eq(replayed.kept_unsynced, failing.kept_unsynced)
    if check_schedule("{root}/unsafe_replay", unsafe_rec.base, unsafe_rec.events, replayed, allowed) == {
        .Ok(_) -> panic("seed replay did not reproduce failure")
        .Err(reason) -> assert_eq("{reason}", first_reason)
    }
    // Reduce to a 1-minimal failing schedule and verify every remaining op is necessary.
    reduced: reduce_failing_schedule("{root}/unsafe_reduce", unsafe_rec.base, unsafe_rec.events, failing, allowed)
    assert(reduced.schedule.kept_unsynced.len() <= failing.kept_unsynced.len())
    assert(reduced.schedule.boundary <= failing.boundary)
    assert(reduced.schedule.kept_unsynced.len() >= 1)
    assert(reduced.schedule.kept_unsynced.len() <= 2)
    // Verify 1-minimality: dropping any single op from reduced.kept_unsynced makes it pass.
    loop drop_i in 0..<reduced.schedule.kept_unsynced.len() {
        ^smaller: [Int]{}
        loop j in 0..<reduced.schedule.kept_unsynced.len() {
            if j != drop_i -> smaller.push(reduced.schedule.kept_unsynced[j])
        }
        smaller_sched: CrashSchedule{seed: reduced.schedule.seed, boundary: reduced.schedule.boundary, kept_unsynced: smaller, label: "minimality-check"}
        if check_schedule("{root}/unsafe_mincheck", unsafe_rec.base, unsafe_rec.events, smaller_sched, allowed) == {
            .Ok(_) -> {}
            .Err(_) -> panic("reduced schedule was not 1-minimal")
        }
    }
    // Confirm the reduced schedule replays deterministically and reproduces the exact failure.
    if check_schedule("{root}/unsafe_reduced_replay", unsafe_rec.base, unsafe_rec.events, reduced.schedule, allowed) == {
        .Ok(_) -> panic("reduced schedule did not reproduce")
        .Err(reason) -> assert_eq("{reason}", reduced.reason)
    }
    files.remove_all(root) ?? ()
}
