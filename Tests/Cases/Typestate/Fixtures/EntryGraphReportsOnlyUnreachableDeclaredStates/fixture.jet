Flow: struct {
    state {
        Start -> Done, Canceled
        Done
        Canceled
        Orphan
    }

    start: fn() -[]> Flow.Start { return Flow{} }

    done: fn(self: ^^Flow.Start) -[]> Flow.Done { return self }

    cancel: fn(self: ^^Flow.Start) -[]> Flow.Canceled { return self }
}

run: fn() {}
