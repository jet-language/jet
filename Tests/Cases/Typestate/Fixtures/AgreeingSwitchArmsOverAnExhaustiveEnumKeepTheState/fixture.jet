Order: struct {
    state {
        Draft -> Confirmed, Canceled
        Confirmed -> Closed
        Canceled -> Closed
        Closed
    }

    id: Int,

    start: fn(id: Int) -[]> Order.Draft { return Order{id: id} }

    confirm: fn(self: ^^Order.Draft) -[]> Order.Confirmed { return self }

    cancel: fn(self: ^^Order.Draft) -[]> Order.Canceled { return self }

    close: fn(self: ^^Order.Confirmed) -[]> Order.Closed { return self }

    archive: fn(self: ^^Order.Canceled) -[]> Order.Closed { return self }

    ship: fn(self: Order.Confirmed) -[]> Int { return self.id }
}

Mode: enum {
    Fast,
    _Slow,
}

decide: fn(m: Mode) {
    order := Order.start(1)
    if m == {
        .Fast -> { order = order.confirm() }
        ._Slow -> order = order.confirm()
    }
    print(order.ship())
}

run: fn() { decide(Mode.Fast) }
