// The app imports the package's functions but not its `Type`, and declares
// a `Type` of its own.
use shapes.[kind, kind_type, make, type_name]

Type: struct {
    label: String,
}

run: fn() {
    k: kind("circle")
    print(type_name(k.ty))
    print(type_name(kind_type(k)))
    print(kind_type(k) == k.ty)
    print(type_name(make("square")) == "square")
    mine: Type{label: "own"}
    print(mine.label)
}
