# Every secret-dependent primitive, built at O0, O1 and O2, emits no branch and no load indexed by a secret
fixture: ConstantTimePrimitivesEmitNoSecretBranchOrIndex.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
# The code judged is the code a build ships: the kit's JET_OPT_VERIFY=1
# also takes every function out of SSA through fresh moves (Opt.jet
# ir_opt_ssa_facts), which no release build emits.
env: JET_OPT_VERIFY=0
step o0: jet test {root}/Core/Net/SSL/TLS.jet -O0 --filter=emission
env: JET_X64_EMIT_LOG=Core/Crypto/,Core/Net/SSL/
env: JET_X64_EMIT_LOG_REPORT={work}/o0.log
timeout: 900s
exit: 0
stdout: ~ "1 passed, 0 failed" # the test runner also prints the test's name line
step o1: jet test {root}/Core/Net/SSL/TLS.jet -O1 --filter=emission
env: JET_X64_EMIT_LOG=Core/Crypto/,Core/Net/SSL/
env: JET_X64_EMIT_LOG_REPORT={work}/o1.log
timeout: 900s
exit: 0
stdout: ~ "1 passed, 0 failed" # the test runner also prints the test's name line
step o2: jet test {root}/Core/Net/SSL/TLS.jet -O2 --filter=emission
env: JET_X64_EMIT_LOG=Core/Crypto/,Core/Net/SSL/
env: JET_X64_EMIT_LOG_REPORT={work}/o2.log
timeout: 900s
exit: 0
stdout: ~ "1 passed, 0 failed" # the test runner also prints the test's name line
step check: jet check.jet secrets.txt o0.log o1.log o2.log
timeout: 300s
exit: 0
stdout: ~ "0 findings, 0 missing roots" # one summary line per level's log
# The check finds what a directive clears: without the random draw's
# verdict and the RSA modulus's public member, the draw's loop branches on a
# secret and the modulus's limbs are read at secret addresses.
step probe: jet check.jet --drop "public __core_crypto_bignum.draw_in_range" --drop "public-field __core_crypto_rsa.RSAContext n" secrets.txt o2.log
timeout: 300s
exit: 1
stdout: ~ "__core_crypto_bignum.core_random at" # the findings carry their trails
stdout: ~ "branch on a secret" # the findings carry their trails
stdout: ~ "memory access at a secret address" # the findings carry their trails
# The check follows a secret through the copy glue an optimized build
# inlines and through a boxed variant's payload, into the members they
# touch: with the Int members of a ChaCha20-Poly1305 context and of a
# Camellia key declared secret, the cipher layer's copy-on-write clone of
# its boxed key schedule (cipher_update: its inlined `#copy` glue and the
# mode test through the box) and its copy of a built context (keyed_base)
# clone or test a secret Int at O1 and O2; every such access is through an
# untyped address only the copy or the box places.
step planted: jet check.jet --add "secret-struct __core_crypto_aead.ChaChaPoly" --add "secret-struct __core_crypto_block.CamelliaKey" secrets.txt o1.log o2.log
timeout: 300s
exit: 1
stdout: ~ "o1.log: __core_crypto_cipher_layer.cipher_update at" # the glue's and the box's accesses are placed in the real members
stdout: ~ "o2.log: __core_crypto_cipher_layer.cipher_update at" # the glue's and the box's accesses are placed in the real members
stdout: ~ "o1.log: __core_crypto_cipher_layer.keyed_base at" # the copy's glue reads the copied context's members
stdout: ~ "o2.log: __core_crypto_cipher_layer.keyed_base at" # the copy's glue reads the copied context's members
