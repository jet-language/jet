// deep.jet's recursion, never ending, in a task outside any `stack:` group:
// the task starts on the program's 8 MiB and grows onto stack segments, and
// past the stack budget it stops with E3012, whose fix names `stack:`.
package: {
    name: "taskgroup_stack"
    authority: { allow: [Env, Exec, FS, FS.Read, IO] }
}

use sys: core.sys

PROGRAM_STACK: 8388608

deep: fn(n: Int, a: Int, b: Int, c: Int, d: Int) -> Int {
    if n == 0 -> return a + b + c + d
    1 + deep(n + 1, b, c, d, a + n)
}

run: fn() {
    limit: sys.stack_limit() ?? panic("stack limit: {err}")
    sys.set_stack_limit(Val(PROGRAM_STACK), limit.hard) ?? panic("set stack limit: {err}")
    task.group plain {
        direct: task deep(1, 1, 2, 3, 4)
        print("reached {direct.join() ?? -1}")
    }
}
