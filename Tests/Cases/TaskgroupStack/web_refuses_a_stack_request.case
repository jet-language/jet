# A browser task has no stack of its own to size, so any `stack:` on the web
# target is E-WEB-UNSUPPORTED (D-THREAD-STACK1=A): the checker refuses the
# whole task group when the target machine is wasm.browser, as it refuses host
# APIs there (CheckProgram.jet sema_web_host_check_core_usage).
fixture: Fixtures/Stack
env: NO_COLOR=1
step: jet check web.jet --target web
exit: nonzero
stderr: ~ "[jet.WebConstructNotSupported]" # the refusal, E-WEB-UNSUPPORTED
stderr: ~ "cannot run a task group" # the refusal's text, beside other web findings
