Seen: struct {
    ids: Set<Int>,
}

Tagged: struct {
    tags: Set<String>,
}

Hue: enum {
    Red,
    Green,
    Blue,
}

Palette: struct {
    hues: Set<Hue>,
}

run: fn() {
    ids := Set<Int>.new()
    ids.add(3)
    ids.add(1)
    ids.add(2)
    print("{Seen{ids: ids}}")
    tags := Set<String>.new()
    tags.add("b")
    tags.add("a")
    print("{Tagged{tags: tags}}")
    print("{Tagged{tags: Set<String>.new()}}")
    hues := Set<Hue>.new()
    hues.add(Hue.Blue)
    hues.add(Hue.Red)
    print("{Palette{hues: hues}}")
    print("{ids}")
}
