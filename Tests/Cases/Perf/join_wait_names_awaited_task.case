# `jet perf run` records each join's wait: the trace's `task_join` span
# names the joining task, the task it awaits and the source line that
# spawned it, on the clock of every other span, so `jet perf view` shows the
# wait on the timeline beside the tasks with no manual alignment.
requires: os-name:linux
fixture: JoinWaitNamesAwaitedTask.fixture
env: NO_COLOR=1
step: jet perf run main.jet --out {work}/join.jettrace
exit: 0
stdout: = "joined=42\n"
step: jet perf view {work}/join.jettrace
exit: 0
stdout: ~ "joins count=1 · task 1 waited " # the run's one join, by the task that waited
stdout: ~ "ns for task 2 spawned at main.jet:4" # the awaited task and the line that spawned it
stdout: ~ "] join task 1 awaits task 2 spawned at main.jet:4" # the wait on the timeline
