# `jet perf run` samples each thread on its own CPU clock, and each sample
# fills a record buffer of its own: four tasks calling fib at once at -O2
# for two seconds of CPU time keep at least 90% of the 2000 samples that time
# gives, and each keeps its whole stack, so fib's recursive line holds them.
# One process-wide timer sent each expiry to one running thread, which lost
# about half of them, and a sample taken while another thread's filled the
# one buffer kept its program counter alone.
requires: os-name:linux
fixture: EveryThreadKeepsWholeStacks.fixture
env: NO_COLOR=1
step: jet perf run -O2 burn.jet --out {work}/burn.jettrace
exit: 0
stdout: = "burned=true\n"
json: file burn.jettrace doc $.content.profile.rows[?source.start_line=7][?inclusive_count>=1800] #= 1 # fib's recursive line holds at least 90% of the nominal samples
json: file burn.jettrace doc $.content.profile.reason ~ " samples 2" # the receipt gives the samples the sampled CPU time should give
json: file burn.jettrace doc $.content.profile.reason !~ "kept no stack" # no sample in Jet code lost its stack
