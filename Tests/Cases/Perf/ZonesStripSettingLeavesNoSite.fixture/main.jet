// Two zones per frame, a plot and a frame mark: under `zones: strip` the
// image keeps no zone site, and the plot and the frame marks still record.
use perf: core.perf

step: fn(n: Int) -> Int Never! {
    _step: perf.zone("step")
    ^total: 0
    loop i in 0..<n {
        _inner: perf.zone("inner")
        total += i % 7
    }
    total
}

run: fn() {
    ^total: 0
    loop frame in 1..<4 {
        total += step(frame * 10)
        perf.plot("total", Float{total})
        perf.frame()
    }
    print("total {total}")
}
