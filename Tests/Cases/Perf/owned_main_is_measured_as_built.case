# `jet perf run` measures the program a plain build makes. This program owns
# its main and prints 3072 lines into a pipe from one print line. Under
# `jet perf run` it keeps that main: the print line's writes reach `main`
# with no process root (jet_rt_main) between them. The view counts as many
# writes there as the built program makes when it runs plainly. count.py
# reads that count from /proc/PID/io once the program has exited, before it
# is reaped.
requires: os-name:linux
requires: arch:x86_64
requires: tool:python3
requires: probe test -r /proc/self/io # the plain run's write count
fixture: OwnedMainIsMeasuredAsBuilt.fixture
env: NO_COLOR=1
step: jet inspect decisions main.jet
exit: 0
stdout: ~ "Main: program-owned" # the plain build owns its main
step: sh -c '{jet} perf run main.jet --out {work}/writes.jettrace | wc -l'
exit: 0
stdout: ~ "3072" # the program ran whole
json: file writes.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.syscalls[?name in ["write","writev"]] #= 1 # every write is the print line's
json: file writes.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.syscalls[?name in ["write","writev"]][0].stack[?function="run"][?line=7] #= 1 # at the print line
json: file writes.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.syscalls[?name in ["write","writev"]][0].stack[?function="main"] #= 1 # called from the program's main
json: file writes.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.syscalls[?name in ["write","writev"]][0].stack[?function="jet_rt_main"] #= 0 # with no process root between
capture: counted file writes.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.syscalls[?name in ["write","writev"]][0].count
step: jet build main.jet
exit: 0
file: .jet/build/main !~ "jet_rt_root_begin" # the built image links no process root
step: python3 count.py {work}/.jet/build/main
exit: 0
json: stdout.after_first("syscw ").trim doc $ = {cap:counted} # the plain run makes as many writes as the view counts
