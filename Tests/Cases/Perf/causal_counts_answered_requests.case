# Under `jet perf run --lens=causal`, each request an HTTP server answers is
# the progress point `request`, with no call in the program: `jet perf view`
# ranks, for it, how much sooner each answer would come if a line were 30%
# faster.
requires: os-name:linux
requires: arch:x86_64
fixture: CausalCountsAnsweredRequests.fixture
env: NO_COLOR=1
step: jet perf run -A -O2 main.jet --lens=causal --out requests.jettrace
exit: 0
stdout: = "served\n"
step: jet perf view requests.jettrace
exit: 0
stdout: ~ "`request`: if this line were 30% faster, each pass would come sooner by" # an answered request is a progress point
