// Two tasks hand a number back and forth 20000 times, each receive a wait
// and each send a wake: far more records than the record socket holds
// between two of the flight recorder's drains, 100 ms apart.
use {
    term: core.term
    time: core.time
}

run: fn() {
    { sender: ping, receiver: pings }: channel<Int>(1)
    { sender: pong, receiver: pongs }: channel<Int>(1)
    child: task {
        loop _ in 0..<20000 {
            turn: pings.receive() ?? panic("closed")
            pong.send(turn)
        }
    }
    child.detach()
    loop turn in 0..<20000 {
        ping.send(turn)
        pongs.receive() ?? panic("closed")
    }
    // The ring is published every 100ms: its tally is in it by READY.
    time.sleep(300ms)
    print("READY")
    // A pipe stdout is written when its buffer fills; flush so the case
    // sees READY while the program still runs.
    out := term.stdout()
    out.flush() ?? panic("flush")
    time.sleep(30000ms)
}
