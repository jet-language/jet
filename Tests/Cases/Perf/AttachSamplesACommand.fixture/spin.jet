// A `jet check` busy for a while: the constant's compile-time work builds
// text over and over, then ends, and so does the check.
spin: fn() -> Int {
    ^total: 0
    loop _ in 0..<1000 {
        ^text: ""
        loop _ in 0..<2000 -> text = "{text}x"
        total += text.len()
    }
    total
}

#StepLimit(4000000000) SPUN: #run spin()

run: fn() { print("{SPUN}") }
