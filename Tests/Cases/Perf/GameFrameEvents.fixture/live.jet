use {
    game: core.game
    term: core.term
    time: core.time
}

World: struct {
    ticks: Int,
}

// Runs until it is killed: by its 300th frame its live snapshots hold more
// game records than the relay keeps, so an attach reads a window of them.
run: fn() {
    ^scene: game.Scene.new("arena")
    ^world: World{ticks: 0}
    scene.on_frame(fn(frame) { physics(world, frame.index) ?? panic("physics") })
    scene.on_frame(fn(frame) { render(frame.index) })
    game.run(scene, frames: 1000000).drop("the frames are the record under test")
}

physics: fn(world: ^World, index: Int) -[Time.Wait]> {
    world.ticks += index
    time.sleep(1ms)
}

render: fn(index: Int) -[IO, Time.Wait]> {
    time.sleep(1ms)
    if index == 300 {
        print("ready")
        // A pipe stdout is written when its buffer fills; flush so the case
        // sees ready while the frames run.
        ^out: term.stdout()
        out.flush() ?? panic("flush")
    }
}
