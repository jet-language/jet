name: "profiled_marker"
version: "0.1.0"
authority: {
    allow: [Meta.Code.Rewrite]
}

// Each checked function `#perf.Profiled` marks gets a zone named after it
// around its body; the unmarked ones stay as written.
build: fn(b: Build) {
    app: b.add_executable("profiled_marker", ["run.jet"], [])
    meta: b.compiler(app)
    meta.events(
        watch: .Functions{marked: core.perf.Profiled{}},
        fn(event) {
            if event == .Checked(.Function(f)) {
                name: f.name
                meta.rewrite_body(
                    f,
                    #code {
                        _zone: core.perf.zone(#{name})
                        #{f.body}
                    },
                )
            }
        },
    )
    b.default(app)
}
