# Two attaches share one zones window, and neither turns zones off under the
# other. Each `jet perf attach --zones=WINDOW` holds its own lease beside the
# one trigger; ending, it removes only its lease, and the program turns its
# zones off once no lease stands. Here the first attach asks for 1 s. The
# program opens the window at its next publication, up to 100 ms after the
# lease, and creates its window file then. Once that file is there, the
# second attach starts and asks for 2 s. The first ends early, and the
# window stays open for the second: the second's trace holds one window,
# opened before it began, that lasts its whole 2 s. The first, ending while
# the second holds the window, finds no window row, so it keeps its zone
# rows with the ring's records. The program runs under the authorizer, so
# jet may trace it, as an attach needs.
requires: os-name:linux
requires: tool:cc
fixture: AttachTurnsZonesOn.fixture
env: NO_COLOR=1
env: XDG_RUNTIME_DIR={work}/run
env: TMPDIR={work}/tmp
step: mkdir -m 700 run tmp
exit: 0
copy: {root}/Tests/Fixtures/Ptrace/authorizer.c authorizer.c
step: cc authorizer.c -o authorizer
exit: 0
session live line: {work}/authorizer {jet} run --observe live.jet
stderr: null
recv live
stdout.trim: ~ "READY" # the program is running its loop
spawn first: jet perf attach {pid:live} --source live.jet --zones=1s --out first.jettrace
step: sh -c 'n=0; while ! ls run/jet | grep -q "samples[.]window$" && [ $n -lt 200 ]; do sleep 0.02; n=$((n+1)); done; ls run/jet | grep -c -e "samples[.]window$" -e "samples[.]zones[.][0-9][0-9]*$"'
exit: 0
stdout: = "2\n" # the first attach's lease stands, and the window it asked for is open
step: jet perf attach {pid:live} --source live.jet --zones=2s --out second.jettrace
exit: 0
wait: first
exit: 0
file: first.jettrace ~ "\"kind\":\"zone\"" # the first attach's zones are trace rows
file: second.jettrace ~ "\"kind\":\"zone\"" # and so are the second's
json: file first.jettrace doc $.content.profile.window_reason ~ "the attach's window on process " # the first ended while the second held the window, so it found no window row
json: file second.jettrace doc $.content.profile.window_status = "live" # the second's run window is the zones window
json: file second.jettrace doc $.content.profile.window_reason ~ "the zones window process " # the program's own window
json: file second.jettrace doc $.content.profile.window_wall_ns >= 2000000000 # open from before the second began to after its 2 s: the first's end left it open
step: sh -c 'ls run/jet | grep -c "samples[.]zones"'
exit: 1 # grep counts no line
stdout: = "0\n" # each attach removed its lease, and the program the trigger once none stood
signal live: KILL
close live
exit: any # the case's KILL ends the program
