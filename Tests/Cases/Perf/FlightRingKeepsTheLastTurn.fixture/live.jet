// Waits for a `stop` file, then exits.
use {
    files: core.files
    term: core.term
    time: core.time
}

run: fn() {
    // The ring is published every 100ms: it is on disk by READY.
    time.sleep(300ms)
    print("READY")
    // A pipe stdout is written when its buffer fills; flush so the case
    // sees READY while the program still runs.
    out := term.stdout()
    out.flush() ?? panic("flush")
    loop _ in 0..<1500 {
        if files.exists("stop") -> break
        time.sleep(20ms)
    }
}
