# `jet perf attach` names each refusal by its cause. A flag that conflicts
# with the others is Jet.InvalidCommandInput (exit 2); a process that isn't
# running, or runs without publishing what the attach reads, is
# Jet.AttachTargetNotObserved (exit 1); a command line that names no one
# process (none, two, a word that isn't a pid, or a pid and a command) is
# Jet.AttachWhichProcess (exit 2); a command that can't be started is
# Jet.DriverOperationFailed (exit 1). Each report is a CLI snapshot. The
# running process runs under the authorizer, so jet may trace it and the
# refusal is its own.
requires: os-name:linux
requires: tool:cc
fixture: AttachTurnsZonesOn.fixture
env: NO_COLOR=1
env: TMPDIR={work}/tmp
step: mkdir -m 700 tmp
exit: 0
copy: {root}/Tests/Fixtures/Ptrace/authorizer.c authorizer.c
step: cc authorizer.c -o authorizer
exit: 0
step: jet perf attach 4242 --lens=alloc
exit: 2
stdout: = ""
stderr: = ../../CLI/perf_attach_alloc_needs_source.txt
step: jet perf attach 4242 --for=3s --source live.jet --out timed.jettrace
exit: 2
stdout: = ""
stderr: ~ "Error: Jet.InvalidCommandInput: `--for=` sets how long jet samples a process from outside, and `--source` reads what the program publishes instead" # a window for the outside sampler, on a program read by what it publishes
stderr: ~ "Fix: Attach with `--zones=<duration>` for a window on what it publishes, or drop `--source` to sample it from outside" # names that path's window
file: timed.jettrace absent # refused before it traced anything
step: jet perf attach 4242 --for=601s
exit: 2
stderr: ~ "Error: Jet.InvalidCommandInput: `--for=601s` isn't a window jet understands" # longer than 10 minutes
stderr: ~ "at most 10 minutes, as `--for=500ms` or `--for=20s`" # and the fix says the bound and the form
step: jet perf attach 4242 --for=3
exit: 2
stderr: ~ "Error: Jet.InvalidCommandInput: `--for=3` isn't a window jet understands" # a duration names its unit
step: jet perf attach 4294967295 --source live.jet --out gone.jettrace
exit: 1
stdout: = ""
stderr: = ../../CLI/perf_attach_not_running.txt
file: gone.jettrace absent # refused before it traced anything
spawn sleeper: {work}/authorizer sleep 30
poll asleep: sh -c 'test "$(readlink /proc/{pid:sleeper}/exe)" = "$(readlink -f "$(command -v sleep)")"' until exit: 0 timeout 5s every 10ms # the authorizer has let jet trace it and run `sleep`
step: jet perf attach {pid:sleeper} --source live.jet --out plain.jettrace
exit: 1
stdout: = ""
stderr: ~ "Error: Jet.AttachTargetNotObserved: Jet can't attach to process " # a running process jet doesn't observe is refused by that cause
stderr: ~ ": it publishes no live snapshot jet can read (no live observation is available at " # and says what it lacks
stderr: ~ "Fix: Start the program with `jet run --observe`, then attach to the pid it runs as" # and how to start it observed
file: plain.jettrace absent # refused before it traced anything
step: jet perf attach {pid:sleeper} --follow --out followed.jettrace
exit: 1
stdout: = ""
stderr: ~ "Error: Jet.AttachTargetNotObserved: Jet can't attach to process " # a follow of a process jet doesn't observe is refused by that cause
stderr: ~ "so it has no zones to follow" # and says what it lacks
file: followed.jettrace absent # refused before it traced anything
signal sleeper: KILL
wait: sleeper
exit: any # the case's KILL ends the process
step: jet perf attach 4242 4343 --source live.jet
exit: 2
stdout: = ""
stderr: = ../../CLI/perf_attach_two_processes.txt
step: jet perf attach --source live.jet
exit: 2
stderr: ~ "Error: Jet.AttachWhichProcess: `jet perf attach` names no process" # no pid is no choice of process
step: jet perf attach soon --source live.jet
exit: 2
stderr: ~ "Error: Jet.AttachWhichProcess: `soon` isn't a process id, so jet can't tell which process to attach to" # nor is a word that isn't a pid
step: jet perf attach 4242 --lens=counts
exit: 2
stderr: ~ "Error: Jet.InvalidCommandInput: `--lens=counts` counts a command from its start, and a running process has started already" # a count missing the start would mislead
stderr: ~ "Fix: Run `jet perf attach --lens=counts -- <command>`" # the command form is the fix
step: jet perf attach -- true
exit: 2
stderr: ~ "Error: Jet.InvalidCommandInput: `jet perf attach -- <command>` takes `--lens=counts`" # a command is counted, not sampled
step: jet perf attach --lens=counts --for=3s --out timed.jettrace -- true
exit: 2
stderr: ~ "Error: Jet.InvalidCommandInput: `--for=`, `--zones=`, `--source` and `--lens=alloc` read a running process" # a window on a running process
file: timed.jettrace absent # refused before it ran the command
step: jet perf attach 4242 --lens=counts -- true
exit: 2
stderr: ~ "Error: Jet.AttachWhichProcess: `jet perf attach` was given process `4242` and a command after `--`" # a pid and a command
step: jet perf attach --lens=counts --
exit: 2
stderr: ~ "Error: Jet.InvalidCommandInput: `jet perf attach --` names no command" # nothing after `--`
step: jet perf attach --lens=counts --out none.jettrace -- no-such-program-c14
exit: 1
stderr: ~ "Error: Jet.DriverOperationFailed: Jet can't run `no-such-program-c14`: no such program file on PATH" # a program PATH lacks
file: none.jettrace absent # nothing ran, so no trace
