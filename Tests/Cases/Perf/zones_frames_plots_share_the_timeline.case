# core.perf zones close when the block that holds them ends, frame marks
# and plots record a moment, and a core.log span writes the same timeline:
# under `jet perf run` each is a span row of the .jettrace, and `jet perf
# view` totals each zone name, the frames' intervals and each plot's last
# value. Each zone holds the CPU-time samples its task took inside it: the
# view names how many and the lines they were on, and its timeline shows
# them on the zone rows. Every row, the run's task row too, is on the
# program's clock from its process epoch, so the task row holds the log
# span and the zones. The program prints the same on every tier, in a perf
# run or not, and every tier's view totals the same zones.
fixture: ZonesFramesPlotsShareTheTimeline.fixture
env: NO_COLOR=1
step o0: jet run -A -O0 main.jet
exit: 0
stdout: = zones_frames_plots_share_the_timeline.out
stderr: empty
step o1: jet run -A -O1 main.jet
exit: 0
stdout: = zones_frames_plots_share_the_timeline.out
stderr: empty
step o2: jet run -A -O2 main.jet
exit: 0
stdout: = zones_frames_plots_share_the_timeline.out
stderr: empty
step o0perf: jet perf run -O0 main.jet --out zones.jettrace
exit: 0
stdout: = zones_frames_plots_share_the_timeline.out
stderr: ~ "Trace:" # jet perf run names the trace it wrote
file: zones.jettrace ~ "\"kind\":\"zone\"" # closed zones are trace rows
file: zones.jettrace ~ "\"kind\":\"frame_mark\"" # frame marks are trace rows
file: zones.jettrace ~ "\"kind\":\"plot\"" # plotted values are trace rows
file: zones.jettrace ~ "\"kind\":\"log_span\"" # the log span shares the timeline
file: zones.jettrace ~ "\"name\":\"moved = 4" # a plot row names its value
capture: run_start file zones.jettrace doc $.content.spans[?kind="task_observed"][0].start_ns
capture: run_end file zones.jettrace doc $.content.spans[?kind="task_observed"][0].end_ns
capture: session_start file zones.jettrace doc $.content.spans[?kind="log_span"][0].start_ns
capture: first_zone file zones.jettrace doc $.content.spans[?kind="zone"][?symbol.name="physics"][0].start_ns
capture: last_zone file zones.jettrace doc $.content.spans[?kind="zone"][?symbol.name="physics"][4].end_ns
cap:session_start: f64 >= {cap:run_start} # the log span opens inside the run's task row
cap:first_zone: f64 >= {cap:run_start} # so does the first zone
cap:last_zone: f64 <= {cap:run_end} # and the last zone closes inside it
step o0view: jet perf view zones.jettrace
exit: 0
stdout: ~ "zone broadphase count=1500 " # every inner zone closed
stdout: ~ "zone physics count=5 " # one outer zone per frame
stdout: ~ "frames count=5 " # one mark per frame
stdout: ~ "plot moved count=5 last=" # one value per frame
stdout: ~ "log spans count=1 " # the log span beside the zones
stdout: ~ "zone solve count=5 samples=" # the solve zone holds samples
stdout: !~ "zone solve count=5 samples=0 " # at least one
stdout: ~ " · main.jet:14 " # most on the solve loop's line
stdout: ~ "main.jet#solve · " # the timeline's solve rows show their samples
step o1perf: jet perf run -O1 main.jet --out zones1.jettrace
exit: 0
stdout: = zones_frames_plots_share_the_timeline.out
step o1view: jet perf view zones1.jettrace
exit: 0
stdout: ~ "zone broadphase count=1500 " # optimized, every inner zone still closes
stdout: ~ "zone physics count=5 " # and every outer one
stdout: ~ "frames count=5 " # every frame mark
stdout: ~ "plot moved count=5 last=" # every plotted value
stdout: ~ "log spans count=1 " # the log span
stdout: ~ "zone solve count=5 samples=" # the solve zone closed every frame
stdout: !~ "zone solve count=5 samples=0 " # and still holds samples
stdout: ~ " · main.jet:14 " # on the solve loop's line
stdout: ~ "main.jet#solve · " # and on the timeline's solve rows
step o2perf: jet perf run -O2 main.jet --out zones2.jettrace
exit: 0
stdout: = zones_frames_plots_share_the_timeline.out
step o2view: jet perf view zones2.jettrace
exit: 0
stdout: ~ "zone broadphase count=1500 " # the same totals on the last tier
stdout: ~ "zone physics count=5 " # one outer zone per frame
stdout: ~ "frames count=5 " # one mark per frame
stdout: ~ "plot moved count=5 last=" # one value per frame
stdout: ~ "log spans count=1 " # the log span
stdout: ~ "zone solve count=5 samples=" # the solve zone closed every frame
stdout: !~ "zone solve count=5 samples=0 " # and holds samples
stdout: ~ " · main.jet:14 " # on the solve loop's line
stdout: ~ "main.jet#solve · " # and on the timeline's solve rows
