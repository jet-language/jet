// Allocation in a loop: each of 2000 turns builds a 64-element list from
// its turn, so no list is a constant built once at compile time, and keeps
// every 100th: line 8 allocates on every turn and 20 lists stay live.
use core.perf

build: fn(first: Int, n: Int) -> [Int] {
    ^xs: [Int]{}
    loop i in 0..<n { xs.push(first + i) }
    xs
}

run: fn() {
    ^kept: [[Int]]{}
    ^total: 0
    loop t in 0..<2000 {
        xs: build(t, 64)
        total += xs.len()
        if t % 100 == 0 -> kept.push(xs)
    }
    perf.heap_mark("end")
    print("total={total} kept={kept.len()}")
}
