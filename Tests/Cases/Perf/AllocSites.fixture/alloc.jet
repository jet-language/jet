// Allocation in a loop: each of 2000 turns builds a 64-element list and
// every 100th list is kept, so the list's line allocates on every turn and
// the 20 kept lists are still live when the run ends.
use core.perf

build: fn(n: Int) -> [Int] {
    xs := [Int]{}
    loop i in 0..<n { xs.push(i) }
    xs
}

run: fn() {
    kept := [[Int]]{}
    total := 0
    loop t in 0..<2000 {
        xs: build(64)
        total += xs.len()
        if t % 100 == 0 -> kept.push(xs)
    }
    perf.heap_mark("end")
    print("total={total} kept={kept.len()}")
}
