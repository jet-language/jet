// A long-running loop: each turn runs a `tick` zone of some CPU time, plots
// its count and marks a frame, then sleeps 10 ms. Its zones stay off until
// `jet perf attach --zones=` turns them on for a window.
use {
    perf: core.perf
    term: core.term
    time: core.time
}

tick: fn(turn: Int) -> Int Never! {
    _tick: perf.zone("tick")
    ^total: 0
    loop i in 0..<200000 -> total += (turn + i) % 7
    total
}

run: fn() {
    print("READY")
    // A pipe stdout is written when its buffer fills; flush so the case
    // sees READY while the program still runs.
    ^out: term.stdout()
    out.flush() ?? panic("flush")
    ^sum: 0
    loop turn in 0..<3000 {
        sum += tick(turn)
        perf.plot("sum", Float{sum % 1000})
        perf.frame()
        time.sleep(10ms)
    }
    print("done {sum}")
}
