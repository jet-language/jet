# `jet perf attach --follow` shows a running program's zones as they close.
# With no pid and no `--source`, it takes the one observed program of this
# user's and the source its run published. It holds the zones window open
# and prints each zone, frame mark and plot on stdout as a line, while the
# program still runs. Ctrl-C ends it with exit 0, and the trace it names
# holds the zones it read. `--follow` with `--zones=` is refused, and so is
# an attach that names no pid while two observed programs run. The programs
# run under the authorizer, so jet may trace them, as an attach needs.
requires: os-name:linux
requires: tool:cc
fixture: AttachTurnsZonesOn.fixture
env: NO_COLOR=1
env: TMPDIR={work}/tmp
step: mkdir -m 700 tmp
exit: 0
copy: {root}/Tests/Fixtures/Ptrace/authorizer.c authorizer.c
step: cc authorizer.c -o authorizer
exit: 0
session live line: {work}/authorizer {jet} run --observe live.jet
stderr: null
recv live
stdout.trim: ~ "READY" # the program is running its loop
session follower line: {jet} perf attach --follow --out follow.jettrace
recv follower line until ~ "live.jet#tick" timeout 10s # a tick zone's line arrives while the program runs
stdout: ~ "] live.jet#tick" # timed from the window's opening, named in the source the run published
step: sh -c 'test -d /proc/{pid:live}'
exit: 0 # the program has not finished its 3,000 ticks
signal follower: INT
close follower
exit: 0 # Ctrl-C ends the follow, which writes its trace
stderr: ~ "Following " # it said what it follows
stderr: ~ "Trace: " # and names its trace
step: jet perf view follow.jettrace
exit: 0
stdout: ~ "zone tick count=" # the trace holds the zones it read
step: jet perf attach {pid:live} --source live.jet --follow --zones=500ms
exit: 2
stdout: = ""
stderr: ~ "Error: Jet.InvalidCommandInput: `--follow` keeps the window open until Ctrl-C or the program's end" # one capture's flag conflicts with a follow
session second line: {work}/authorizer {jet} run --observe live.jet
stderr: null
recv second
stdout.trim: ~ "READY" # a second observed program runs
step: jet perf attach --follow
exit: 2
stdout: = ""
stderr: ~ "Error: Jet.AttachWhichProcess: 2 observed programs of yours are running: " # jet won't guess which one
stderr: ~ " live.jet, " # it lists each pid and source
signal second: KILL
close second
exit: any # the case's KILL ends the program
signal live: KILL
close live
exit: any # the case's KILL ends the program
