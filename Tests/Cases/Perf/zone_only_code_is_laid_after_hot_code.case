# Code that only zone sites reach while zones are on (jet_perf_zone_close,
# called from each site's stub) is laid after all other code, past the
# startup's own code, at every tier, in a load segment of its own: the
# kernel maps a file's pages around each fault, but only within the
# fault's mapping, so a run that records no zone maps none of its pages.
# The program prints the same either way, and `jet perf run` still records
# and names every zone.
fixture: ZonesStripSettingLeavesNoSite.fixture
env: NO_COLOR=1
step: jet build main.jet
exit: 0
step: {work}/.jet/build/main
exit: 0
stdout: = "total 166\n"
step: sh image.sh {jet} order .jet/build/main
exit: 0
stdout: = "__jet_start\njet_perf_zone_close\n" # the zone-only close comes after the startup
step: sh image.sh {jet} code-segments .jet/build/main
exit: 0
stdout: = "2\n" # the zone-only code is an executable segment apart from the rest
step: jet build --release -O2 main.jet
exit: 0
step: {work}/.jet/build/main
exit: 0
stdout: = "total 166\n"
step: sh image.sh {jet} order .jet/build/main
exit: 0
stdout: = "__jet_start\njet_perf_zone_close\n" # the same order at -O2, read from the image's side debug file
step: jet perf run main.jet --out keep.jettrace
exit: 0
stdout: = "total 166\n"
step: jet perf view keep.jettrace
exit: 0
stdout: ~ "zone step count=3 " # the laid-out close still records every zone
stdout: ~ "zone inner count=60 " # and every pass of the inner zone
