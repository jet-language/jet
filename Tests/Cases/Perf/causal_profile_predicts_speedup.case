# `jet perf run --lens=causal` runs virtual speedup experiments on the
# program's lines, and `jet perf view` ranks, for each progress point, how
# much sooner its passes would come if a line were 30% faster. The fixture
# times the program by hand just before the profiled run and just after it,
# a plain round beside one with its narrow line's work cut to seven-tenths
# and one with its wide line's, so the machine's drifting load falls alike
# on each pair. On every tier one of three outcomes passes. Either each of
# the two lines the lens ranked for the `round` zone has a predicted
# interval that meets the speedup measured around the run, and it ranked one
# at least; or the program's threads waited for a CPU longer than the lens
# trusts, and it withheld every gain, naming the wait; or the threads waited
# that long while measured by hand, so no truth was measured. A measured
# speedup above the 30% a line 30% faster can give is an error, not a pass.
# Which line gains more depends on the CPUs the run gets, so neither is
# required to rank first. Each finished task is a progress point of its own.
# A run too short to rank is refused with the reason, and the lens refuses
# the company of lenses whose readings its delays would skew.
# With JET_CAUSAL_CASE_PATHS naming a file, each tier's check appends the
# outcome it took to it, with its numbers: compared, refused for the
# profiled run's wait, or contended truth.
requires: os-name:linux
requires: arch:x86_64
fixture: CausalProfilePredictsSpeedup.fixture
env: NO_COLOR=1
step o0: jet run -A -O0 main.jet -- measure before.txt
exit: 0
stdout: = "measured\n"
step: jet perf run -A -O0 main.jet --lens=causal --out causal.jettrace
exit: 0
stdout: = "done\n"
json: file causal.jettrace doc $.content.receipt_sections[?name="perf"][0].value.capture.sampling.lenses #= 2 # the receipt names each lens that ran
json: file causal.jettrace doc $.content.receipt_sections[?name="perf"][0].value.capture.sampling.lenses[1] = "causal" # the causal lens, beside the cpu samples it rides on
step: jet run -A -O0 main.jet -- measure after.txt
exit: 0
stdout: = "measured\n"
step: jet run -A check.jet -- o0 causal.jettrace
exit: 0
stdout: one-of CausalProfilePredictsSpeedup.fixture/predicted.out CausalProfilePredictsSpeedup.fixture/withheld.out CausalProfilePredictsSpeedup.fixture/contended.out # the hand-sped program lands in the interval of each ranked line, or the lens withheld its gains under contention, or the hand measurement was contended
step o1: jet run -A -O1 main.jet -- measure before.txt
exit: 0
stdout: = "measured\n"
step: jet perf run -A -O1 main.jet --lens=causal --out causal.jettrace
exit: 0
stdout: = "done\n"
step: jet run -A -O1 main.jet -- measure after.txt
exit: 0
stdout: = "measured\n"
step: jet run -A check.jet -- o1 causal.jettrace
exit: 0
stdout: one-of CausalProfilePredictsSpeedup.fixture/predicted.out CausalProfilePredictsSpeedup.fixture/withheld.out CausalProfilePredictsSpeedup.fixture/contended.out # on every tier
step o2: jet run -A -O2 main.jet -- measure before.txt
exit: 0
stdout: = "measured\n"
step: jet perf run -A -O2 main.jet --lens=causal --out causal.jettrace
exit: 0
stdout: = "done\n"
step: jet run -A -O2 main.jet -- measure after.txt
exit: 0
stdout: = "measured\n"
step: jet run -A check.jet -- o2 causal.jettrace
exit: 0
stdout: one-of CausalProfilePredictsSpeedup.fixture/predicted.out CausalProfilePredictsSpeedup.fixture/withheld.out CausalProfilePredictsSpeedup.fixture/contended.out # on every tier
json: file causal.jettrace doc $.content.receipt_sections[?name="causal"][0].value.points[?name="round"] #= 1 # the zone is a progress point
json: file causal.jettrace doc $.content.receipt_sections[?name="causal"][0].value.points[?name="task"] #= 1 # finished tasks are a point ranked apart
json: file causal.jettrace doc $.content.receipt_sections[?name="causal"][0].value.cpu_wait_ms >= 0 # the receipt keeps the threads' wait for a CPU
step: jet perf view causal.jettrace
exit: 0
stdout: ~ "causal\n  " # the view gives the lens's ranking or its refusal
step: jet perf run -A -O2 main.jet --lens=causal --out short.jettrace -- 60
exit: 0
stdout: = "done\n"
step: jet perf view short.jettrace
exit: 0
stdout: ~ "refused: the run kept " # too few experiments to rank, and why
json: file short.jettrace doc $.content.receipt_sections[?name="causal"][0].value.refused ~ "the run kept " # the receipt keeps the refusal's reason
step: jet perf run -A main.jet --lens=causal,memory --out mixed.jettrace
exit: 2
stderr: ~ "run it alone with `--lens=causal`" # the delays would skew the other lenses
