# `jet perf run` measures what sampling cost and reports it as the profile's
# overhead: the time the sampler's handlers and ring drains ran plus, for
# each signal that carried a sample, the kernel's delivery and return, plus,
# under a perf event, the kernel's time to write each sample to its thread's
# ring, each of which the runtime times as sampling starts. Four tasks
# calling fib at -O2 for two seconds of CPU time pay under 2% of it, 40 ms,
# at the default 8 kHz.
requires: os-name:linux
fixture: EveryThreadKeepsWholeStacks.fixture
env: NO_COLOR=1
step: jet perf run -O2 burn.jet --out {work}/burn.jettrace
exit: 0
stdout: = "burned=true\n"
json: file burn.jettrace doc $.content.profile.overhead_status = "measured" # the overhead is measured, not assumed
json: file burn.jettrace doc $.content.profile.overhead_ns >= 1 # the sampler's time is counted
json: file burn.jettrace doc $.content.profile.overhead_ns <= 40000000 # and is under 2% of the two seconds sampled
json: file burn.jettrace doc $.content.profile.overhead_reason ~ " microseconds of CPU time sampled: " # the receipt gives its share
