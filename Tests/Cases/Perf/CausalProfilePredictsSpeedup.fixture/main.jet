// The program the causal lens profiles. Each round spawns one task down the
// narrow path and three down the wide one, joins them and closes a `round`
// zone, the progress point the lens ranks lines by. The narrow task does
// the most work and each wide task four-fifths of it, so the three together
// take more CPU time than the narrow one. Which line bounds a round depends
// on the CPUs the tasks get: with one each, the narrow line does, and
// speeding the wide one gains nothing; when they share fewer (a loaded
// machine), the round takes their total CPU time, and speeding the wide line
// gains the most. The lens must tell which from the run it profiles.
//
// `jet run main.jet -- MILLIS` runs rounds for MILLIS milliseconds (4000 by
// default). `jet run main.jet -- measure FILE` times rounds as they are,
// with the narrow task doing seven-tenths of its work, as if its line were
// 30% faster, and with each wide task doing seven-tenths of its own, one
// round of each in turn. It writes to FILE how much sooner a round came for
// the narrow line and for the wide one, each as the low end of its median's
// 90% interval, the median and the high end, in tenths of a percent, then
// the runqueue wait its threads took in thousandths of their run time, and
// the means of the highest and the lowest clock, in MHz, of the CPUs its
// threads that ran last ran on, read after each three rounds (0 for both
// where the kernel has no cpufreq). The wait and the clocks are the same
// measures the lens takes of its run. A second line gives, for the plain
// rounds, the narrow-fast ones and the wide-fast ones in turn, the medians
// of where a round's time went (ROUND_PARTS), which check.jet sets beside
// the lens's own timings of its rounds' tasks.
use {
    files: core.files
    perf: core.perf
    process: core.process
    time: core.time
}

STEPS: 400000

// The rounds `measure` times in each of its three arms.
ROUNDS: 249

// How many ranks either side of the median the ends of its 90% interval
// lie among ROUNDS sorted values: 1.645 * sqrt(ROUNDS) / 2, rounded. This
// is the order-statistic interval, which holds whatever the rounds'
// distribution is.
MEDIAN_RANKS: 13

narrow: fn(seed: Int, steps: Int) -> Int {
    total := seed
    loop step in 0..<steps -> total = (total * 31 + step) % 1000003
    total
}

wide: fn(seed: Int, steps: Int) -> Int {
    total := seed
    loop step in 0..<steps -> total = (total * 17 + step) % 999983
    total
}

// When a task began and ended, in nanoseconds from its round's start, and
// what its work came to.
Run: struct {
    start: Int,
    end: Int,
    total: Int,
}

narrow_run: fn(origin: Int, seed: Int, steps: Int) -> Run {
    start: time.instant().start_ns
    total: narrow(seed, steps)
    Run{start: start - origin, end: time.instant().start_ns - origin, total: total}
}

wide_run: fn(origin: Int, seed: Int, steps: Int) -> Run {
    start: time.instant().start_ns
    total: wide(seed, steps)
    Run{start: start - origin, end: time.instant().start_ns - origin, total: total}
}

// One round, the narrow task doing `narrow_tenths` tenths of its work and
// each wide one `wide_tenths` of its own: the narrow task's run, then the
// wide ones'. (Named apart from its zone: check.jet finds the zone's ranking
// by its name.)
play_round: fn(seed: Int, narrow_tenths: Int, wide_tenths: Int) -> [Run] {
    _round: perf.zone("round")
    origin: time.instant().start_ns
    first: task narrow_run(origin, seed, STEPS * narrow_tenths /% 10)
    second: task wide_run(origin, seed + 1, STEPS * 8 * wide_tenths /% 100)
    third: task wide_run(origin, seed + 2, STEPS * 8 * wide_tenths /% 100)
    fourth: task wide_run(origin, seed + 3, STEPS * 8 * wide_tenths /% 100)
    none: Run{start: 0, end: 0, total: 0}
    runs: [Run]{first.join() ?? none, second.join() ?? none, third.join() ?? none, fourth.join() ?? none}
    if runs[0].total + runs[1].total + runs[2].total + runs[3].total < 0 -> print("negative")
    runs
}

// The parts of a round, in nanoseconds, the second line of `measure` gives
// the median of: its wall time, its tasks' span from the first start to the
// last end, the narrow task's start from the first one's and its run, and
// the wide tasks' starts and runs (the three pooled).
ROUND_PARTS: 6

// How long one round takes, in nanoseconds, then its tasks' parts
// (ROUND_PARTS) pushed onto `parts`, in their order, the wide ones' three
// each.
timed: fn(seed: Int, narrow_tenths: Int, wide_tenths: Int, parts: &[[Int]]) -> Int {
    started: time.instant()
    runs: play_round(seed, narrow_tenths, wide_tenths)
    wall: started.elapsed().ns
    first := runs[0].start
    last := runs[0].end
    loop run in runs {
        first = min(first, run.start)
        last = max(last, run.end)
    }
    parts[0].push(wall)
    parts[1].push(last - first)
    parts[2].push(runs[0].start - first)
    parts[3].push(runs[0].end - runs[0].start)
    loop index in 1..<4 {
        parts[4].push(runs[index].start - first)
        parts[5].push(runs[index].end - runs[index].start)
    }
    wall
}

// The median of each of `parts`, joined by spaces.
medians: fn(parts: &[[Int]]) -> String {
    words := [String]{}
    loop part in parts {
        sorted := part.copy()
        sorted.sort()
        words.push("{sorted[sorted.len() /% 2]}")
    }
    words.join(" ")
}

// The run time and the runqueue wait, in nanoseconds, this program's
// threads have taken: the first two fields of each thread's schedstat.
cpu_times: fn() -> [Int] {
    run := 0
    wait := 0
    entries: files.list_dir("/proc/self/task") ?? return [Int]{0, 0}
    loop entry in entries {
        text: files.read("/proc/self/task/{entry.name}/schedstat") ?? next
        fields: text.trim().split(" ").to_list()
        if fields.len() < 2 -> next
        run += Int.parse(fields[0]) ?? 0
        wait += Int.parse(fields[1]) ?? 0
    }
    [Int]{run, wait}
}

// The highest and the lowest clock, in kHz, of the CPUs this program's
// threads last ran on, of those threads whose run time grew since `runs`
// (by thread) last held it, which it now holds; 0 for both when none could
// be read. A thread's CPU is field 39 of its stat, the 37th after the
// state that follows its name's last `)`.
clocks: fn(runs: &[String:Int]) -> [Int] {
    high := 0
    low := 0
    entries: files.list_dir("/proc/self/task") ?? return [Int]{0, 0}
    loop entry in entries {
        text: files.read("/proc/self/task/{entry.name}/schedstat") ?? next
        run: Int.parse(text.trim().split(" ").to_list()[0]) ?? next
        last: runs.get(entry.name) ?? -1
        runs[entry.name] = run
        if last < 0 || run <= last -> next
        stat: files.read("/proc/self/task/{entry.name}/stat") ?? next
        parts: stat.split(")").to_list()
        fields: parts[parts.len() - 1].trim().split(" ").to_list()
        if fields.len() < 37 -> next
        khz: Int.parse((files.read("/sys/devices/system/cpu/cpu{fields[36]}/cpufreq/scaling_cur_freq") ?? next).trim()) ?? next
        if khz > high -> high = khz
        if khz > 0 && (low == 0 || khz < low) -> low = khz
    }
    [Int]{high, low}
}

// A sorted line's gains as the low end of its median's interval, the median
// and the high end.
median_interval: fn(gains: [Int]) -> String {
    middle: ROUNDS /% 2
    "{gains[middle - MEDIAN_RANKS]} {gains[middle]} {gains[middle + MEDIAN_RANKS]}"
}

run: fn() {
    args: process.args()
    word: if args.len() > 0 -> args[args.len() - 1] else -> ""
    if args.len() > 1 && args[args.len() - 2] == "measure" {
        // Rounds in threes, the program as it is, with the narrow line sped
        // up and with the wide one sped up, each first in turn. A sped-up
        // round is paired with the plain round beside it, so the machine's
        // load, which drifts over the run, falls alike on both: each
        // three's speedups, and the median of them, in tenths of a percent.
        // The wait the threads took meanwhile tells whether the rounds had
        // their CPUs or contended for them, and the clocks of their CPUs
        // whether those that idled clocked down. Each arm's rounds' parts
        // go to its own lists.
        narrow_gains := [Int]{}
        wide_gains := [Int]{}
        plain_parts := loop part in 0..<ROUND_PARTS -> [Int]{}
        narrow_parts := loop part in 0..<ROUND_PARTS -> [Int]{}
        wide_parts := loop part in 0..<ROUND_PARTS -> [Int]{}
        runs := [String:Int]{}
        khz_high := 0
        khz_low := 0
        clocked := 0
        _ := clocks(runs)
        before: cpu_times()
        loop index in 0..<ROUNDS {
            plain := 0
            narrow_fast := 0
            wide_fast := 0
            loop turn in 0..<3 {
                which: (index + turn) %% 3
                if {
                    which == 0 -> plain = timed(index, 10, 10, plain_parts)
                    which == 1 -> narrow_fast = timed(index, 7, 10, narrow_parts)
                    else -> wide_fast = timed(index, 10, 7, wide_parts)
                }
            }
            narrow_gains.push(1000 - narrow_fast * 1000 /% plain)
            wide_gains.push(1000 - wide_fast * 1000 /% plain)
            read: clocks(runs)
            if read[0] > 0 && read[1] > 0 {
                khz_high += read[0]
                khz_low += read[1]
                clocked += 1
            }
        }
        after: cpu_times()
        run_ns: after[0] - before[0]
        wait: if run_ns > 0 -> (after[1] - before[1]) * 1000 /% run_ns else -> 0
        high_mhz: if clocked > 0 -> khz_high /% clocked /% 1000 else -> 0
        low_mhz: if clocked > 0 -> khz_low /% clocked /% 1000 else -> 0
        narrow_gains.sort()
        wide_gains.sort()
        files.write(word, "{median_interval(narrow_gains)} {median_interval(wide_gains)} {wait} {high_mhz} {low_mhz}\n{medians(plain_parts)} {medians(narrow_parts)} {medians(wide_parts)}\n") ?? panic("cannot write {word}")
        print("measured")
        return
    }
    started: time.instant()
    count := 0
    loop started.elapsed_millis() < (Int.parse(word) ?? 4000) {
        _ := play_round(count, 10, 10)
        count += 1
    }
    print("done")
}
