// The program the causal lens profiles. Each round spawns one task down the
// narrow path and three down the wide one, joins them and closes a `round`
// zone, the progress point the lens ranks lines by. The narrow task does
// the most work, so it bounds each round; each wide task does four-fifths
// of it, so the three together take more CPU time than the narrow one and
// a CPU profile ranks the wide line first. Speeding the narrow line up
// shortens every round; speeding the wide one does not.
//
// `jet run main.jet -- MILLIS` runs rounds for MILLIS milliseconds (4000 by
// default). `jet run main.jet -- measure` runs them in turn as they are and
// with the narrow task doing seven-tenths of its work, as if its line were
// 30% faster, and writes how much sooner each round came, in tenths of a
// percent, to measured.txt.
use {
    files: core.files
    perf: core.perf
    process: core.process
    time: core.time
}

STEPS: 400000

narrow: fn(seed: Int, steps: Int) -> Int {
    total := seed
    loop step in 0..<steps -> total = (total * 31 + step) % 1000003
    total
}

wide: fn(seed: Int, steps: Int) -> Int {
    total := seed
    loop step in 0..<steps -> total = (total * 17 + step) % 999983
    total
}

// Rounds until `millis` have passed, the narrow task doing `tenths` tenths
// of its work: how many ran.
rounds: fn(millis: Int, tenths: Int) -> Int {
    started: time.instant()
    count := 0
    loop started.elapsed_millis() < millis {
        _round: perf.zone("round")
        seed: count
        first: task narrow(seed, STEPS * tenths /% 10)
        second: task wide(seed + 1, STEPS * 8 /% 10)
        third: task wide(seed + 2, STEPS * 8 /% 10)
        fourth: task wide(seed + 3, STEPS * 8 /% 10)
        sum: (first.join() ?? 0) + (second.join() ?? 0) + (third.join() ?? 0) + (fourth.join() ?? 0)
        if sum < 0 -> print("negative")
        count += 1
    }
    count
}

run: fn() {
    args: process.args()
    word: if args.len() > 0 -> args[args.len() - 1] else -> ""
    if word == "measure" {
        slow := 0
        fast := 0
        loop _ in 0..<3 {
            slow += rounds(1000, 10)
            fast += rounds(1000, 7)
        }
        // Each round takes slow/fast of its time when sped up.
        files.write("measured.txt", "{1000 - slow * 1000 /% fast}\n") ?? panic("cannot write measured.txt")
        print("measured")
        return
    }
    _ := rounds(Int.parse(word) ?? 4000, 10)
    print("done")
}
