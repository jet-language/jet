// Reads the causal section of the trace the last argument names and
// before.txt and after.txt, the speedups main.jet measured by hand for the
// narrow line and for the wide one just before the profiled run and just
// after it. It accepts one of four outcomes. The lens refused the run
// because its threads waited too long for a CPU, naming the wait its
// receipt keeps and giving no gain. Or a hand measurement's threads waited
// as long, so it measured a contended machine, which is no truth for a run
// the lens found uncontended. Or the CPUs that ran the rounds clocked down
// more than the lens trusts in the profiled run and the lens could not fit
// how much slower that made a task (its receipt's `clock_fit`), so it
// flags its gains with the drop its receipt keeps. Or, for the `round` progress
// point, each of the two lines the lens ranked has a predicted interval
// that meets the line's measured one, and the lens ranked one of them at
// least. A line's measured interval spans both measurements' 90% intervals
// of their gain, by rate as the lens predicts it, since the machine's CPUs,
// and with them the line's gain, drift from the one measurement to the
// other, and the profiled run lies between them. A ranked line's interval
// is at most WIDEST wide, the lens's own bound for ranking a line, so no
// interval passes by being vague; and a measured speedup above BOUND, which
// no line 30% faster can give, is refused as a measurement gone wrong, so
// none passes by being wild.
//
// The argument before the trace names the tier. The outcome's own line,
// with its numbers and the receipt's fit (its octaves' residuals, slope
// and R²), goes to stdout and stderr, and is appended to the file
// JET_CAUSAL_CASE_PATHS names when it is set, so a run of the case tells
// whether each tier compared the lens with its truth, or which of
// contention and clocks kept it from comparing. A comparison that fails
// prints its line too, with both lines' numbers, before it panics with
// every way it failed.
//
// First, on stdout and stderr, it sets where a round's time went by hand
// (main.jet ROUND_PARTS, before and after) beside where it went under the
// lens (the trace's `causal_tasks`: each task's timing), in the lens's
// baselines and in its experiments on the narrow line and the wide one.
//
// `check.jet -- counts TIER TRACE` sets out the lens's part alone and
// checks nothing, so a run too short to rank shows the experiments it kept,
// the count `jet perf view`'s refusal names.
use {
    files: core.files
    process: core.process
    sys: core.sys
}

// JetCLI CLI/Perf/Causal.jet JET_CLI_PERF_CAUSAL_WIDEST, in tenths of a
// percent.
WIDEST: 300

// JetCLI CLI/Perf/Causal.jet JET_CLI_PERF_CAUSAL_WAIT_MOST, in thousandths
// of the threads' run time: the most runqueue wait under which the lens
// ranks lines.
WAIT_MOST: 200

// JetCLI CLI/Perf/Causal.jet JET_CLI_PERF_CAUSAL_CLOCK_MOST, in thousandths
// of the highest clock: the most the lowest clock of the CPUs that ran the
// program's threads may fall below it before the lens, when it cannot fit
// how that slows its tasks, flags its gains.
CLOCK_MOST: 100

// The most a line 30% faster can make a round sooner, in tenths of a
// percent: all of the round's time on the line, every part of it 30% less.
// main.jet's measured gain above it is no speedup of the line but a
// measurement gone wrong, and is refused.
BOUND: 300

// One hand measurement: each line's gain by rate with its 90% interval, in
// tenths of a percent, the runqueue wait its threads took, in thousandths
// of their run time, and the means of the highest and the lowest clock of
// their CPUs, in MHz.
Measured: struct {
    narrow: [Int],
    wide: [Int],
    wait: Int,
    high_mhz: Int,
    low_mhz: Int,
}

// The measurement main.jet wrote to `path`: its first line.
read_measured: fn(path: String) -> Measured {
    words: (files.read(path) ?? panic("cannot read {path}")).trim().split("\n").to_list()[0].split(" ").to_list()
    if words.len() != 9 -> panic("{path} holds no nine numbers")
    numbers := [Int]{}
    loop word in words -> numbers.push(Int.parse(word) ?? panic("{path} holds `{word}`, no number"))
    Measured{narrow: [Int]{numbers[0], numbers[1], numbers[2]}, wide: [Int]{numbers[3], numbers[4], numbers[5]}, wait: numbers[6], high_mhz: numbers[7], low_mhz: numbers[8]}
}

// main.jet's ROUND_PARTS: the medians of a round's parts each arm gives.
ROUND_PARTS: 6

// The second line main.jet wrote to `path`: each arm's medians of its
// rounds' parts, in nanoseconds, plain, narrow-fast then wide-fast; empty
// when it holds no such line.
read_parts: fn(path: String) -> [Int] {
    lines: (files.read(path) ?? return [Int]{}).trim().split("\n").to_list()
    if lines.len() < 2 -> return [Int]{}
    numbers := [Int]{}
    loop word in lines[1].split(" ").to_list() -> numbers.push(Int.parse(word) ?? return [Int]{})
    if numbers.len() != 3 * ROUND_PARTS -> return [Int]{}
    numbers
}

// `ns` nanoseconds in microseconds, to a tenth.
micros: fn(ns: Int) -> String {
    sign: if ns < 0 -> "-" else -> ""
    whole: if ns < 0 -> -ns else -> ns
    "{sign}{whole /% 1000}.{whole /% 100 %% 10}"
}

// The median of `values`; -1 when it is empty.
median: fn(values: [Int]) -> Int {
    if values.len() == 0 -> return -1
    sorted := values.copy()
    sorted.sort()
    sorted[sorted.len() /% 2]
}

// A line on stdout and stderr.
say: fn(line: String) {
    print(line)
    eprint(line)
}

// The parts of a round the lens's timings give, by its kind of experiment,
// LENS_PARTS each: its tasks' span from the first start to the last end, the
// delay inserted meanwhile and the span less it; the narrow task's start
// from the first one's, its wall time, its pauses' wall time, its CPU time
// less its pauses' and its samples; the same of the wide ones (the three
// pooled); and the CPUs its tasks began on.
LENS_PARTS: 14

// The columns of a `causal_tasks` row (JetCLI CLI/Perf/Causal.jet
// jet_cli_perf_causal_tasks_section).
COLUMNS: 13

// The round of the lens's task rows `group`, sorted by start, into `parts`
// at its kind's LENS_PARTS (by `kinds`, its experiment's kind: 0 a
// baseline, 1 the narrow line's, 2 the wide line's); false when it is no
// whole round within one experiment.
take_round: fn(group: [[Int]], kinds: [Int], parts: &[[Int]]) -> Bool {
    if group.len() != 4 -> return false
    ordinal: group[0][3]
    loop row in group {
        if row[3] != ordinal || row[4] != ordinal -> return false
    }
    if ordinal < 0 || ordinal >= kinds.len() || kinds[ordinal] > 2 -> return false
    at: kinds[ordinal] * LENS_PARTS
    // The narrow task is the one whose body none of the others shares.
    narrow := -1
    loop index in 0..<4 {
        shared := 0
        loop other in 0..<4 {
            if other != index && group[other][0] == group[index][0] -> shared += 1
        }
        if shared == 0 -> narrow = index
    }
    if narrow < 0 -> return false
    first := group[0][1]
    last := group[0][1] + group[0][2]
    delay_from := group[0][9]
    delay_to := group[0][10]
    cores := [Int]{}
    loop row in group {
        first = min(first, row[1])
        last = max(last, row[1] + row[2])
        delay_from = min(delay_from, row[9])
        delay_to = max(delay_to, row[10])
        if !cores.contains(row[11]) -> cores.push(row[11])
    }
    parts[at].push(last - first)
    parts[at + 1].push(delay_to - delay_from)
    parts[at + 2].push(last - first - (delay_to - delay_from))
    loop (index, row) in group {
        side: if index == narrow -> at + 3 else -> at + 8
        parts[side].push(row[1] - first)
        parts[side + 1].push(row[2])
        parts[side + 2].push(row[6])
        parts[side + 3].push(row[5] - row[7])
        parts[side + 4].push(row[8])
    }
    parts[at + 13].push(cores.len())
    true
}

// Where a round's time went by hand and under the lens, as the header says.
report_rounds: fn(tier: String, trace: String) {
    arms: [String]{"plain", "narrow-fast", "wide-fast"}
    loop file in ([String]{"before.txt", "after.txt"}) {
        hand: read_parts(file)
        if hand.len() == 0 {
            say("causal rounds {tier} hand {file}: no round parts")
            next
        }
        loop (arm, name) in arms {
            at: arm * ROUND_PARTS
            say("causal rounds {tier} hand {file} {name}: wall {micros(hand[at])} span {micros(hand[at + 1])} narrow at {micros(hand[at + 2])} for {micros(hand[at + 3])} wide at {micros(hand[at + 4])} for {micros(hand[at + 5])} (µs, medians)")
        }
    }
    report_lens(tier, trace)
}

// Where a round's time went under the lens, by the trace's causal_tasks
// record: its tasks, rounds and experiments, the baselines among them,
// then each kind of experiment's medians.
report_lens: fn(tier: String, trace: String) {
    sections: trace.split("\"name\":\"causal_tasks\"").to_list()
    if sections.len() < 2 {
        say("causal rounds {tier} lens: the trace has no causal_tasks section")
        return
    }
    section: sections[1]
    kinds := [Int]{}
    listed: section.split("\"experiments\":[").to_list()
    if listed.len() > 1 {
        loop piece in listed[1].split("],\"kept_most\"").to_list()[0].split(",").to_list() {
            if {
                piece == "null" -> kinds.push(0)
                piece.starts_with("{{\"function\":\"narrow\"") -> kinds.push(1)
                piece.starts_with("{{\"function\":\"wide\"") -> kinds.push(2)
                piece.starts_with("{{\"function\":") -> kinds.push(3)
            }
        }
    }
    rows := [[Int]]{}
    tabled: section.split("\"rows\":[[").to_list()
    if tabled.len() > 1 {
        loop text in tabled[1].split("]],\"seen\"").to_list()[0].split("],[").to_list() {
            row := [Int]{}
            loop word in text.split(",").to_list() {
                row.push(Int.parse(word) ?? panic("a causal_tasks row holds `{word}`, no number"))
            }
            if row.len() != COLUMNS {
                panic("a causal_tasks row holds {row.len()} numbers, not {COLUMNS}")
            }
            rows.push(row)
        }
    }
    rows.sort_by(fn(left: [Int], right: [Int]) { left[1] <=> right[1] })
    parts := loop _part in 0..<3 * LENS_PARTS -> [Int]{}
    groups := 0
    kept := 0
    index := 0
    loop index < rows.len() {
        end := rows[index][1] + rows[index][2]
        after := index + 1
        loop after < rows.len() && rows[after][1] < end {
            end = max(end, rows[after][1] + rows[after][2])
            after += 1
        }
        groups += 1
        if take_round(rows.slice(index, after), kinds, parts) -> kept += 1
        index = after
    }
    seen: number_after(section, "\"seen\":") ?? -1
    most: number_after(section, "\"kept_most\":") ?? -1
    baselines := 0
    loop kind in kinds {
        if kind == 0 -> baselines += 1
    }
    say("causal rounds {tier} lens: tasks seen {seen}, kept {rows.len()} of at most {most}; rounds {groups}, kept whole within one experiment {kept}; experiments {kinds.len()}, {baselines} of them baselines")
    loop (kind, name) in ([String]{"baseline", "narrow line", "wide line"}) {
        at: kind * LENS_PARTS
        m: loop part in 0..<LENS_PARTS -> median(parts[at + part])
        say("causal rounds {tier} lens {name}: {parts[at].len()} rounds span {micros(m[0])} delay {micros(m[1])} virtual {micros(m[2])} narrow at {micros(m[3])} for {micros(m[4])} paused {micros(m[5])} work {micros(m[6])} samples {m[7]} wide at {micros(m[8])} for {micros(m[9])} paused {micros(m[10])} work {micros(m[11])} samples {m[12]} cpus {m[13]} (µs, medians)")
    }
}

// How far, in thousandths of `high`, `low` falls below it; 0 when no clock
// was read.
clock_drop: fn(high: Int, low: Int) -> Int { if high > 0 -> (high - low) * 1000 /% high else -> 0 }

// What is wrong with the measured `gain` of the `function` line
// when the line cannot have given it (BOUND); "" when nothing is.
check_bound: fn(function: String, gain: Int) -> String {
    if gain > BOUND {
        return "the {function} line sped up by hand gained {gain}, more than the {BOUND} a line 30% faster can give a round: the measurement is invalid"
    }
    ""
}

// The integer after `key` in `text`; None when `key` is absent.
number_after: fn(text: String, key: String) -> Int? {
    parts: text.split(key).to_list()
    if parts.len() < 2 -> return None
    digits: parts[1].split(",").to_list()[0].split("}}").to_list()[0].split("]").to_list()[0]
    number: Int.parse(digits) ?? return None
    Val(number)
}

// One line's comparison: whether the lens ranked it, what it predicted
// against what was measured, and every way it fails.
LineCheck: struct {
    ranked: Bool,
    said: String,
    wrong: [String],
}

// The lens's interval for the line of `function` among `lines`, the `round`
// point's, against the measured one, `measured_low` to `measured_high`. A
// ranked line's interval must meet the measured one and be at most WIDEST
// wide.
check_line: fn(lines: String, function: String, measured_low: Int, measured_high: Int) -> LineCheck {
    loop line in lines.split("}},{{").to_list() {
        if !line.contains("\"function\":\"{function}\"") -> next
        low: number_after(line, "\"low_tenths\":") ?? panic("no low_tenths in {line}")
        high: number_after(line, "\"high_tenths\":") ?? panic("no high_tenths in {line}")
        wrong := [String]{}
        if high - low > WIDEST {
            wrong.push("the {function} line is ranked with an interval of {low} to {high}, wider than the lens ranks")
        }
        if measured_high < low || measured_low > high {
            wrong.push("the {function} line sped up by hand gained {measured_low} to {measured_high}, outside its predicted {low} to {high}")
        }
        return LineCheck{ranked: true, said: "{function} predicted {low} to {high}, measured {measured_low} to {measured_high}", wrong: wrong}
    }
    LineCheck{ranked: false, said: "{function} unranked, measured {measured_low} to {measured_high}", wrong: [String]{}}
}

// The receipt's fit of how much slower a task ran the longer its CPU idled
// before it, as its JSON.
fit_of: fn(trace: String) -> String {
    parts: trace.split("\"clock_fit\":").to_list()
    if parts.len() < 2 -> panic("no clock_fit in the causal section")
    parts[1].split(",\"clock_flag\":").to_list()[0]
}

// Names the outcome `tier` took, with the fit of the receipt `trace`, its
// R² and slope ahead of its octaves: on stdout and stderr, and appended to
// the file JET_CAUSAL_CASE_PATHS names when it is set.
record_path: fn(tier: String, trace: String, outcome: String) {
    fit: fit_of(trace)
    held: if fit.contains("\"refused\":null") -> "held" else -> "refused"
    r2: number_after(fit, "\"r2_thousandths\":") ?? panic("no r2_thousandths in the fit {fit}")
    slope: number_after(fit, "\"slope_thousandths\":") ?? panic("no slope_thousandths in the fit {fit}")
    line: "causal case {tier}: {outcome}; fit {held}, R² {r2} and slope {slope} thousandths; {fit}"
    print(line)
    eprint(line)
    log: sys.get("JET_CAUSAL_CASE_PATHS") ?? return
    writer := files.append(log) ?? panic("cannot open {log}: {err}")
    writer.write_bytes("{line}\n".bytes()) ?? panic("cannot write {log}: {err}")
    writer.flush() ?? panic("cannot write {log}: {err}")
}

// Whether the lens refused the run under CPU contention; when it did, its
// reason must name the wait the receipt keeps, and no line may have a gain.
check_contended: fn(trace: String) -> Bool {
    if !trace.contains(" threads waited ") || !trace.contains("\"refused\":\"the program") {
        return false
    }
    wait: number_after(trace, "\"cpu_wait_ms\":") ?? panic("no cpu_wait_ms in the causal section")
    if !trace.contains(" threads waited {wait} ms for a CPU while they ran ") {
        panic("the contention refusal does not name the {wait} ms wait the receipt keeps")
    }
    if trace.contains("\"gain_tenths\"") {
        panic("the lens refused the run under CPU contention but gave a gain")
    }
    true
}

// Whether the lens flagged its gains because the CPUs that ran the
// program's threads clocked down while it could not fit how that slowed
// its tasks; when it did, its flag must name the drop the receipt keeps,
// that drop must be above CLOCK_MOST and the fit refused. When it did not,
// the drop the receipt keeps must be within CLOCK_MOST, or the fit usable.
check_clocked: fn(trace: String) -> Bool {
    high: number_after(trace, "\"clock_high_mhz\":") ?? panic("no clock_high_mhz in the causal section")
    low: number_after(trace, "\"clock_low_mhz\":") ?? panic("no clock_low_mhz in the causal section")
    drop: clock_drop(high, low)
    // The fit's own `refused` comes just before its slope.
    fitted: fit_of(trace).contains("\"refused\":null,\"slope_thousandths\":")
    if !trace.contains("\"clock_flag\":\"gains may under-read: ") {
        if drop > CLOCK_MOST && !fitted {
            panic("the CPUs clocked down from {high} MHz to {low} MHz and the lens could not fit how that slowed its tasks, but it did not flag its gains")
        }
        return false
    }
    if !trace.contains(" clocked down ") || !trace.contains(" ({high} MHz to {low} MHz) ") {
        panic("the clock flag does not name the {high} MHz to {low} MHz the receipt keeps")
    }
    if drop <= CLOCK_MOST {
        panic("the lens flagged its gains for clocks of {high} MHz to {low} MHz, within the {CLOCK_MOST} thousandths it trusts")
    }
    if fitted -> panic("the lens flagged its gains though it fit how the clocks slowed its tasks")
    true
}

run: fn() {
    args: process.args()
    if args.len() < 2 -> panic("usage: check.jet -- [counts] TIER TRACE")
    tier: args[args.len() - 2]
    trace: files.read(args[args.len() - 1]) ?? panic("cannot read the trace")
    // `counts` reports the lens's record of TRACE alone, the experiments
    // `jet perf view` reads, and checks nothing: a run too short to rank has
    // no gain to hold to the hand measurement.
    if args.len() >= 3 && args[args.len() - 3] == "counts" {
        report_lens(tier, trace)
        return
    }
    report_rounds(tier, trace)
    if check_contended(trace) {
        wait: number_after(trace, "\"cpu_wait_ms\":") ?? 0
        ran: number_after(trace, "\"cpu_run_ms\":") ?? 0
        record_path(tier, trace, "contention, the lens refused: the profiled run's threads waited {wait} ms for a CPU over {ran} ms of run")
        print("the lens withheld its gains under CPU contention, naming the wait")
        return
    }
    // main.jet's `measure` wrote these before the profiled run and after.
    first: read_measured("before.txt")
    last: read_measured("after.txt")
    if first.wait > WAIT_MOST || last.wait > WAIT_MOST {
        record_path(tier, trace, "contention, no truth: the measurements' threads waited {first.wait} and {last.wait} thousandths of their run for a CPU")
        print("a hand measurement's threads waited for a CPU longer than the lens ranks under, so it measured no truth to check the lens by")
        return
    }
    if check_clocked(trace) {
        high: number_after(trace, "\"clock_high_mhz\":") ?? 0
        low: number_after(trace, "\"clock_low_mhz\":") ?? 0
        record_path(tier, trace, "clock, the lens flagged its gains: the profiled run's CPUs clocked {high} to {low} MHz and it could not fit how that slowed its tasks")
        print("the CPUs that ran the rounds clocked down more than the lens trusts and it could not fit how that slowed the tasks, so it flagged its gains")
        return
    }
    bounds: [String]{check_bound("narrow", first.narrow[1]), check_bound("narrow", last.narrow[1]), check_bound("wide", first.wide[1]), check_bound("wide", last.wide[1])}
    wrong := [String]{}
    loop problem in bounds {
        if problem != "" -> wrong.push(problem)
    }
    // The `round` point's object holds its ranked lines before its name.
    before: trace.split("\"name\":\"round\"").to_list()
    if before.len() < 2 -> panic("no `round` progress point in the causal section")
    pieces: before[0].split("{{\"lines\":[").to_list()
    lines: pieces[pieces.len() - 1]
    narrow: check_line(lines, "narrow", min(first.narrow[0], last.narrow[0]), max(first.narrow[2], last.narrow[2]))
    wide: check_line(lines, "wide", min(first.wide[0], last.wide[0]), max(first.wide[2], last.wide[2]))
    loop problem in narrow.wrong -> wrong.push(problem)
    loop problem in wide.wrong -> wrong.push(problem)
    if !narrow.ranked && !wide.ranked {
        wrong.push("the lens ranked neither line sped up by hand for `round`: {lines}")
    }
    outcome: if wrong.len() == 0 -> "compared" else -> "compared and failed"
    record_path(tier, trace, "{outcome}, {narrow.said}; {wide.said}; waits {first.wait} and {last.wait} thousandths; the measurements' clock drops {clock_drop(first.high_mhz, first.low_mhz)} and {clock_drop(last.high_mhz, last.low_mhz)} thousandths")
    if wrong.len() > 0 -> panic(wrong.join("; "))
    print("each line sped up by hand that the lens ranked gained within its predicted interval")
}
