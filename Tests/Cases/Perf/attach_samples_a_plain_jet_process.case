# `jet perf attach` profiles a jet process started without any flag: a
# `jet check` busy in its compile-time work publishes nothing about itself,
# so the attach, given no `--source`, has the kernel sample the CPU of its
# threads and of the process it runs that work in, and names the frames by
# the functions of the images of their executable, the jet's own and the
# runtime image that process runs. The attach prints the functions its CPU
# was in, the hot one first, and how far its samples' stacks unwound, and
# the trace holds them, with the samples' folded stacks, as the `functions`
# receipt section, which `jet perf view` shows with their flame graph.
# The attach starts once the compile-time process has spun for 0.2 s of
# user CPU (its /proc stat utime, in 10 ms ticks), not as soon as it is
# forked: until it spins it may still be starting (its exec, its image's
# page faults) or waiting, using no user CPU, which is all the task clock
# samples, and a window that falls there keeps none (p389: samples=0).
# The samples are held to the CPU the sampled threads ran in the window,
# which the trace's run window records, not to a fixed count: a second of
# wall time is a second of the spin's CPU only on an idle machine, and in
# a loaded suite the spin got 186 ms of it (p391: samples=186 against a
# bar of 250 the case set then). A sample each millisecond of user CPU, the
# samples are at least half that CPU less 20 ms: the kernel's share of the
# spin, which the task clock doesn't sample, and the other threads' few
# milliseconds each, under a period, which give none. The check runs under
# the authorizer, so jet may trace it, as an attach needs.
requires: os-name:linux
requires: probe test -r /proc/self/schedstat # the window's CPU is its threads' schedstat run time
requires: tool:cc
fixture: AttachSamplesAPlainJetProcess.fixture
env: NO_COLOR=1
copy: {root}/Tests/Fixtures/Ptrace/authorizer.c authorizer.c
step: cc authorizer.c -o authorizer
exit: 0
spawn busy: {work}/authorizer {jet} check spin.jet
stdout: null
stderr: null
poll spinning: sh -c 'for c in $(cat /proc/{pid:busy}/task/*/children); do test "$(cut -d " " -f 14 /proc/$c/stat)" -ge 20 && exit 0; done; exit 1' until exit: 0 timeout 120s every 20ms # its compile-time work spins
step: jet perf attach {pid:busy} --out busy.jettrace
exit: 0
stderr: ~ "functions samples=" # the samples the kernel took of it
stderr: ~ " processes=2 " # the jet check and the process its compile-time work runs in
stderr: ~ "% total · unit.rt_text_append_owner" # the hot function, by its name: the runtime's text append the work spins in
stderr: ~ "stacks unwound=" # how many stacks unwound whole, were cut at the kernel's limit, or broke
stderr: ~ "Trace: " # and the trace
json: file busy.jettrace doc $.content.receipt_sections[?name="functions"][0].value.samples > 0 # the kernel sampled its CPU
json: file busy.jettrace doc $.content.profile.window_cpu_ns > 0 # the sampled threads ran in the window
capture: samples file busy.jettrace doc $.content.receipt_sections[?name="functions"][0].value.samples
json: file busy.jettrace doc $.content.profile.window_cpu_ns <= 2000000*{cap:samples}+20000000 # a sample a millisecond of the CPU they ran, at least half of it less 20 ms
json: file busy.jettrace doc $.content.receipt_sections[?name="functions"][0].value.stacks #>= 1 # the samples' folded stacks
step: jet perf view busy.jettrace
exit: 0
stdout: ~ "functions samples=" # the view shows the section's lines
stdout: ~ "% total · unit.rt_text_append_owner" # with the hot function
stdout: ~ "flamegraph\n0 " # and the flame graph of the folded stacks, from their outermost frame
signal busy: KILL
wait: busy
exit: any # the case's KILL ends the jet check, and its compile-time process with it
