# An image's zone sites test no runtime word: each is one instruction that
# falls through while zones are off, patched into a jump to its call's stub
# when zones turn on, and the image's `jet.zone_sites` part note lists them,
# which the runtime reads then, so nothing registers them before the entry
# runs. Off, the program runs past every site; `jet perf run` patches them
# on and records every zone.
fixture: ZonesStripSettingLeavesNoSite.fixture
env: NO_COLOR=1
step: jet build main.jet
exit: 0
step: {work}/.jet/build/main
exit: 0
stdout: = "total 166\n"
step: jet debug .jet/build/main --do disas
exit: 0
stdout: ~ "<jet_perf_zone_open_named>" # the sites' stubs call the zone routines by name
stdout: !~ "<jet_perf_zone_table>" # nothing registers a site table: the note lists the sites
step: jet debug .jet/build/main --do symbols
exit: 0
stdout: !~ " jet_perf_zone_sites\n" # and the program holds no table's code
step: sh image.sh {jet} zones-loads .jet/build/main
exit: 0
stdout: = "0\n" # no site loads the zones word to test it: only the runtime's own code names it
step: jet perf run main.jet --out keep.jettrace
exit: 0
stdout: = "total 166\n"
step: jet perf view keep.jettrace
exit: 0
stdout: ~ "zone step count=3 " # the patched sites record every zone
stdout: ~ "zone inner count=60 " # the inner zone's sites, in a loop, record each pass
stdout: !~ "zones off" # the runtime rewrote the sites
