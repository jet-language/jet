# An image's zone sites test no runtime word: each is a jump over its call
# that the image's site table lists, which `main` registers with the runtime
# (jet_perf_zone_table) before the entry runs. Off, the program runs past
# every site; `jet perf run` patches them on and records every zone.
fixture: ZonesStripSettingLeavesNoSite.fixture
env: NO_COLOR=1
step: jet build main.jet
exit: 0
step: {work}/.jet/build/main
exit: 0
stdout: = "total 166\n"
when tool objdump
step: objdump -d .jet/build/main
exit: 0
stdout: ~ "<jet_perf_zone_table>" # the site table registers
step: sh -c 'objdump -d .jet/build/main | grep -c "(%rip),%r11 .*<jet_rt_perf_zones>"'
exit: 1
stdout: = "0\n" # no site loads the zones word to test it: only the runtime's own code names it
end when
step: jet perf run main.jet --out keep.jettrace
exit: 0
stdout: = "total 166\n"
step: jet perf view keep.jettrace
exit: 0
stdout: ~ "zone step count=3 " # the patched sites record every zone
stdout: ~ "zone inner count=60 " # the inner zone's sites, in a loop, record each pass
stdout: !~ "zones off" # the runtime rewrote the sites
