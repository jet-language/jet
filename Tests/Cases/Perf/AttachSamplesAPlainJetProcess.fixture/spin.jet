// A `jet check` that stays busy: the constant's compile-time work builds
// text over and over, for far longer than the case attaches to it, and the
// case kills it.
spin: fn() -> Int {
    total := 0
    loop total >= 0 {
        text := ""
        loop _ in 0..<2000 -> text = "{text}x"
        total += text.len()
    }
    total
}

#StepLimit(4000000000) FOREVER: #run spin()

run: fn() { print("{FOREVER}") }
