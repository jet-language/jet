# A zone of a running program stays off until a profiler records it: `jet
# perf attach --zones=WINDOW` turns the zones of a flight-recorded program
# on for that window and off again, and the trace holds the zones, frame
# marks and plots the program recorded meanwhile, beside the ring's samples.
# An attach without `--zones=` records none. The trace's run window is the
# zones window: at least the 500 ms asked for and no longer than the attach
# took, with the program's CPU in it.
requires: os-name:linux
fixture: AttachTurnsZonesOn.fixture
env: NO_COLOR=1
session live line: jet run --observe live.jet
stderr: null
recv live
stdout.trim: ~ "READY" # the program is running its loop
step: jet perf attach {pid:live} --source live.jet --out point.jettrace
exit: 0
step: jet perf view point.jettrace
exit: 0
stdout: !~ "zone tick" # a point attach records no zone
step: jet perf attach {pid:live} --source live.jet --zones=500ms --out zones.jettrace
exit: 0
capture: took = elapsed
file: zones.jettrace ~ "\"kind\":\"zone\"" # the window's zones are trace rows
file: zones.jettrace ~ "\"kind\":\"frame_mark\"" # and its frame marks
file: zones.jettrace ~ "\"kind\":\"plot\"" # and its plots
json: file zones.jettrace doc $.content.profile.window_status = "live" # the header's window is the one the zones were on
json: file zones.jettrace doc $.content.profile.window_wall_ns >= 500000000 # its wall time: at least the 500 ms window, not the run since it started
json: file zones.jettrace doc $.content.profile.window_wall_ns <= {cap:took}+0 # and no more than the attach took, as this case timed it
capture: wall file zones.jettrace doc $.content.profile.window_wall_ns
json: file zones.jettrace doc $.content.profile.window_cpu_ns > 0 # the program's CPU in the window: its tick loop ran
json: file zones.jettrace doc $.content.profile.window_cpu_ns <= 2*{cap:wall} # at most the window's wall on each of its two threads, the loop's and the runtime's observation writer
step: jet perf view zones.jettrace
exit: 0
stdout: ~ "zone tick count=" # the zones the window recorded
stdout: ~ " window=live run_wall=" # the header's window is the zones window
stdout: !~ " run_cpu=0ns" # with the program's CPU in it
stdout: ~ " · live.jet:13 " # the ring's samples inside them, on the tick loop's line
stdout: ~ "frames count=" # its frame marks
step: jet perf attach {pid:live} --source live.jet --zones=soon --out bad.jettrace
exit: 2
stderr: ~ "`--zones=soon` isn't a window jet understands" # the line that names the refusal or the result
signal live: KILL
close live
exit: any # the case's KILL ends the program
