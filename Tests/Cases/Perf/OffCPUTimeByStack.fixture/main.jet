use time: core.time

run: fn() {
    loop _ in 0..<3 -> nap(30ms)
    paused: pause()
    print("napped, paused {paused}ms")
}

// Every nap ends in this sleep, a tail call that leaves nap no frame.
nap: fn(span: Duration) -[Time.Wait]> { time.sleep(span) }

// pause hands back its span after its nap, so the nap is no tail call (a
// jump, which leaves no frame) and pause stays on the nap's stack.
pause: fn() -[Time.Wait]> Int {
    nap(150ms)
    150
}
