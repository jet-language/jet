# Under `--lens=alloc` a heap snapshot names each live block's type and the
# line that allocated it, `jet perf compare` sets two snapshots against each
# other by type and line, and `jet perf view --retained-by <type>` shows the
# shortest path from a root that keeps the blocks of a type alive. chat.jet's
# 200 message bodies, `[Int]` blocks line 22 allocates between its two
# marks, are live at `after-chat`, each retained through its room's
# history: the path names the `history` and `body` fields, and at -O0 it
# starts at the `rooms` variable. A type no snapshot keeps is refused with
# the types they keep. It holds at -O0, -O1 and -O2. Every live block of a
# snapshot, at a mark or at exit, is charged to the line that allocated it:
# the runtime's and the observation's own blocks are not the program's. A
# snapshot is also taken on attach: held.jet keeps the same bodies, by line
# 24, while it runs under `jet run --observe --checked-alloc`, and `jet perf
# attach --lens=alloc` snapshots them there and says how long it held the
# program, its run window running from its first read of the program to the
# snapshot's answer with the program's CPU in it. With `--zones=500ms` too,
# the window holds the 500 ms and is no longer than the attach took. A run
# not started with allocation tracking is refused. Each attached program
# runs under the authorizer, so jet may trace it, as an attach needs.
requires: os-name:linux
requires: arch:x86_64
requires: tool:cc
fixture: HeapSnapshotRetention.fixture
env: NO_COLOR=1
copy: {root}/Tests/Fixtures/Ptrace/authorizer.c authorizer.c
step: cc authorizer.c -o authorizer
exit: 0
step o0: jet perf run -O0 --lens=alloc chat.jet --out {work}/o0.jettrace
exit: 0
stdout: = "messages=200\n"
json: file o0.jettrace doc $.content.receipt_sections[?name="heap"][0].value.snapshots[1].name = "after-chat"
json: file o0.jettrace doc $.content.receipt_sections[?name="heap"][0].value.snapshots[1].sites[?line=22][?type="[Int]"][?blocks=200] #= 1 # every body, by its type and line
json: file o0.jettrace doc $.content.receipt_sections[?name="heap"][0].value.snapshots[0].sites[?line=22] #= 0 # none before the chat
json: file o0.jettrace doc $.content.receipt_sections[?name="heap"][0].value.snapshots[2].name = "exit"
json: file o0.jettrace doc $.content.receipt_sections[?name="heap"][0].value.snapshots[0].sites[?line=null] #= 0 # each block at the first mark has its line
json: file o0.jettrace doc $.content.receipt_sections[?name="heap"][0].value.snapshots[1].sites[?line=null] #= 0 # and at the second
json: file o0.jettrace doc $.content.receipt_sections[?name="heap"][0].value.snapshots[2].sites[?line=null] #= 0 # and at exit
json: file o0.jettrace doc $.content.receipt_sections[?name="heap"][0].value.snapshots[1].retained[0].type = "[Int]" # what retains the bodies, types in order
step o0view: jet perf view {work}/o0.jettrace
exit: 0
stdout: ~ "live at after-chat  " # the snapshot's heading
stdout: ~ "  [Int]  chat.jet:22 run  200 blocks  " # the bodies, by type and line
step o0compare: jet perf compare {work}/o0.jettrace --heap start..after-chat
exit: 0
stdout: ~ "Heap start -> after-chat: blocks " # the diff names both snapshots
stdout: ~ "  [Int]  chat.jet:22 run  +200 blocks  +" # what grew, by type and line
step o0bodies: jet perf view {work}/o0.jettrace --retained-by [Int]
exit: 0
stdout: ~ "retained [Int] at after-chat  200 blocks  " # the retained list is typed and counted
stdout: ~ "  rooms[" # from the variable
stdout: ~ "].history[" # through the room's history
stdout: ~ "].body  200 blocks  " # to each message's body, one path shape
step o0history: jet perf view {work}/o0.jettrace --retained-by=[Message]
exit: 0
stdout: ~ "retained [Message] at after-chat  4 blocks  " # each element type is a row of its own
stdout: ~ "].history  4 blocks  " # each room's history buffer
step o0none: jet perf view {work}/o0.jettrace --retained-by Ring
exit: 2
stderr: ~ "keeps a live `Ring`; they keep " # the types it can name
step o1: jet perf run -O1 --lens=alloc chat.jet --out {work}/o1.jettrace
exit: 0
stdout: = "messages=200\n"
step o1bodies: jet perf view {work}/o1.jettrace --retained-by [Int]
exit: 0
stdout: ~ "retained [Int] at after-chat  200 blocks  " # the same retention shows on every reading
stdout: ~ "].history[" # through the room's history
stdout: ~ "].body  " # to each message's body
step o2: jet perf run -O2 --lens=alloc chat.jet --out {work}/o2.jettrace
exit: 0
stdout: = "messages=200\n"
step o2bodies: jet perf view {work}/o2.jettrace --retained-by [Int]
exit: 0
stdout: ~ "retained [Int] at after-chat  200 blocks  " # and again in this view
stdout: ~ "].history[" # through the room's history
stdout: ~ "].body  " # to each message's body
step o2compare: jet perf compare {work}/o2.jettrace --heap start..after-chat
exit: 0
stdout: ~ "  [Int]  chat.jet:22 run  +200 blocks  +" # the diff names the allocating line and its growth
session held line: {work}/authorizer {jet} run --observe --checked-alloc held.jet
stderr: null
recv held
stdout.trim: ~ "READY" # every body is live and the program waits
step attach: jet perf attach {pid:held} --lens=alloc --source held.jet --out {work}/attach.jettrace
exit: 0
stderr: ~ "Heap snapshot: held the program's allocations and frees for " # how long the snapshot held the program
capture: took = elapsed
json: file attach.jettrace doc $.content.receipt_sections[?name="heap"][0].value.snapshots[0].name = "attach"
json: file attach.jettrace doc $.content.receipt_sections[?name="heap"][0].value.snapshots[0].sites[?line=24][?type="[Int]"][?blocks=200] #= 1 # every body, by its type and line, while the program runs
json: file attach.jettrace doc $.content.receipt_sections[?name="heap"][0].value.snapshots[0].sites[?line=null] #= 0 # each live block has its line
json: file attach.jettrace doc $.content.profile.window_status = "live" # the header's window is the attach's, from its first read of the program to the snapshot's answer
json: file attach.jettrace doc $.content.profile.window_wall_ns <= {cap:took}+0 # no more than the attach took, not the run since it started
json: file attach.jettrace doc $.content.profile.window_cpu_ns > 0 # the program's CPU in it: the writer's publication that took the snapshot
json: file attach.jettrace doc $.content.receipt_sections[?name="window"][0].value.cpu_clock = "schedstat" # counted to the nanosecond
step attachview: jet perf view {work}/attach.jettrace
exit: 0
stdout: ~ "  [Int]  held.jet:24 run  200 blocks  " # the view names them so too
stdout: ~ " window=live run_wall=" # the header's window is the attach's
stdout: !~ " run_cpu=0ns" # with the program's CPU in it
step window: jet perf attach {pid:held} --lens=alloc --zones=500ms --source held.jet --out {work}/window.jettrace
exit: 0
stderr: ~ "Heap snapshot: held the program's allocations and frees for " # the snapshot, at the window's end
capture: waited = elapsed
json: file window.jettrace doc $.content.receipt_sections[?name="heap"][0].value.snapshots[0].sites[?line=24][?type="[Int]"][?blocks=200] #= 1 # the same bodies
json: file window.jettrace doc $.content.profile.window_status = "live" # the header's window is the attach's
json: file window.jettrace doc $.content.profile.window_wall_ns >= 500000000 # its wall time holds the 500 ms window, not the run since it started
json: file window.jettrace doc $.content.profile.window_wall_ns <= {cap:waited}+0 # and no more than the attach took
json: file window.jettrace doc $.content.profile.window_cpu_ns > 0 # the program's CPU in it
step windowview: jet perf view {work}/window.jettrace
exit: 0
stdout: ~ " window=live run_wall=" # the header's window is the attach's
stdout: !~ " run_cpu=0ns" # with the program's CPU in it
signal held: KILL
close held
exit: any # the case's KILL ends the program
session plain line: {work}/authorizer {jet} run --observe held.jet
stderr: null
recv plain
stdout.trim: ~ "READY" # an observed run without allocation tracking
step untracked: jet perf attach {pid:plain} --lens=alloc --source held.jet --out {work}/untracked.jettrace
exit: 1
stderr: ~ "Error: Jet.AttachTargetNotObserved: Jet can't attach to process " # refused by its cause: not observed for the lens
stderr: ~ ": it keeps no list of its live blocks: it was not started with allocation tracking" # the refusal's reason
stderr: ~ "jet run --observe --checked-alloc held.jet" # how to start it with tracking
file: untracked.jettrace absent # no empty snapshot
signal plain: KILL
close plain
exit: any # the case's KILL ends the program
