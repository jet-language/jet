# `jet perf compare` sets two folders of captures against each other per
# function and per line. The head side spins twice the rounds of the base
# side, so the spin loop's line, and its function, take about twice the
# CPU-time samples in every head capture: with 5 captures a side the exact
# test calls both slower. One capture each gets the means and no verdict.
requires: os-name:linux
fixture: PerfView.fixture
env: NO_COLOR=1
step: jet perf run main.jet --out {work}/base/1.jettrace -- 50000000
exit: 0
step: jet perf run main.jet --out {work}/base/2.jettrace -- 50000000
exit: 0
step: jet perf run main.jet --out {work}/base/3.jettrace -- 50000000
exit: 0
step: jet perf run main.jet --out {work}/base/4.jettrace -- 50000000
exit: 0
step: jet perf run main.jet --out {work}/base/5.jettrace -- 50000000
exit: 0
step: jet perf run main.jet --out {work}/head/1.jettrace -- 100000000
exit: 0
step: jet perf run main.jet --out {work}/head/2.jettrace -- 100000000
exit: 0
step: jet perf run main.jet --out {work}/head/3.jettrace -- 100000000
exit: 0
step: jet perf run main.jet --out {work}/head/4.jettrace -- 100000000
exit: 0
step: jet perf run main.jet --out {work}/head/5.jettrace -- 100000000
exit: 0
step text: jet perf compare {work}/base {work}/head
exit: 0
stdout: ~ "Captures: base " # each side's captures
stdout: ~ "base/5.jettrace · head " # the fifth base capture is one of them
capture: line = text stdout.after_first("  main.jet:11 spin_hot_loop ").split("\n", 0)
cap:line: ~ " slower (p=" # the spin loop's line took more samples in every head capture
capture: function = text stdout.after_first("  main.jet spin_hot_loop ").split("\n", 0)
cap:function: ~ " slower (p=" # and so did its function
stdout: ~ "verdict: exact Mann-Whitney U over 5 captures against 5"
step json: jet perf compare {work}/base {work}/head --json
exit: 0
stdout: ~ "\"kind\":\"jet.perf.compare\""
stdout: ~ "\"verdict\":\"slower\"" # the JSON rows carry the same verdicts
step one: jet perf compare {work}/base/1.jettrace {work}/head/1.jettrace
exit: 0
stdout: ~ "  main.jet:11 spin_hot_loop " # the line's means, without a verdict
stdout: !~ "slower (p=" # no capture count to judge by
stdout: ~ "verdict: none (one capture each; capture each side at least 4 times)"
