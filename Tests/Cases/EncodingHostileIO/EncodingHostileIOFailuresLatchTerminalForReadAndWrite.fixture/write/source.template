
use {
    encoding: core.encoding
    cbor: core.encoding.cbor
    files: core.files
}

writer_io: fn(writer: ^cbor.CBORWriter<files.FileWriter>) -[IO]> Bool {
    if writer.flush() == {
        .Err(error) -> return error.kind == encoding.EncodingErrorKind.IO
        .Ok(_) -> return false
    }
    return false
}

run: fn() {
    full_output: files.create("/dev/full") ?? panic("full open")
    full_writer := cbor.writer(full_output) ?? panic("full writer")
    if full_writer.write(encoding.DataEvent.Null) == {
        .Err(first) -> {
            print(first.kind == encoding.EncodingErrorKind.IO)
            if full_writer.flush() == {
                .Err(second) -> print(first.reason == second.reason)
                .Ok(_) -> print(false)
            }
        }
        .Ok(_) -> {
            if full_writer.flush() == {
                .Err(_) -> print(writer_io(full_writer))
                .Ok(_) -> print(false)
            }
        }
    }
}
