
use {
    _encoding: core.encoding
    _json: core.encoding.json
    _jsonl: core.encoding.jsonl
    csv: core.encoding.csv
    _cbor: core.encoding.cbor
    files: core.files
}

run: fn() {
    input: files.open("{work}/csv_bad/input.data") ?? panic("open")
    ^reader: csv.reader(input) ?? panic("reader")
    loop {
        if reader.next() == {
            .Val(_) -> {}
            .None -> {
                print("eof-missed")
                break
            }
            .Err(first) -> {
                if reader.next() == {
                    .Val(_) | .None -> { print("not-latched") }
                    .Err(second) -> {
                        print(first.byte_offset == second.byte_offset && first.reason == second.reason)
                    }
                }
                break
            }
        }
    }
}
