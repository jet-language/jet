# A pipe lowers each step to a hidden binding before type checking,
# so `port` written as a pipe (piped/) and as hand-named bindings (named/)
# compile to the same slot IR. Only the binding names differ (the pipe's are
# hidden, `__jet_pipe_<offset of its |>>`), so the named form's names are
# rewritten to them before each comparison.
# O0 compiles the `jet emit --ir` slots unchanged. They match through the final
# `return` and the index of the instruction after it, so the named dump
# starts with the piped one cut at its `unreachable` (no slot or
# instruction number is pinned). After the return the hand-named body
# drops `text` and `number` again where no path reaches (its function
# scope ends after the tail value), while the pipe's frame closed before
# the return.
# O1 (-O1) and O2 (--release) are the function after the passes, as
# `jet inspect decisions` prints it: identical.
fixture: APipeCompilesToItsHandNamedFormOnEveryTier.fixture
env: NO_COLOR=1
step: jet emit --ir piped/main.jet --fn port
exit: 0
stdout: ~ "local __jet_pipe_112: String" # the first step's value, bound under its hidden name
stdout: ~ "local __jet_pipe_163: Int" # the second step's value
stdout: !~ "local raw" # the head is a name, so the first step reads it in place
capture: piped_ir = text stdout
capture: piped_o0 = text cap:piped_ir.cut(": unreachable").trim
capture: piped_tail = text cap:piped_ir.after_last(": return ")
cap:piped_tail: ~ ": unreachable" # the pipe's frame dropped its values before the return
cap:piped_tail: !~ ": drop " # so nothing is dropped after it
step: jet emit --ir named/main.jet --fn port
exit: 0
capture: named_o0 = text stdout.replace("local text:", "local __jet_pipe_112:").replace("local number:", "local __jet_pipe_163:")
capture: named_tail = text cap:named_o0.after_last(": return ")
cap:named_tail: ~ ": drop " # the unreachable second drops of `text` and `number`
cap:named_o0: ^= "{cap:piped_o0}" # the same slots and instructions through the return, and the next index
step: jet inspect decisions -O1 piped/main.jet
env: JET_OPT_DUMP=port
exit: 0
stdout: ~ "O1:" # optimize: O1 runs the O1 passes
capture: piped_o1 = text stdout.after_first("\nafter fn port")
step: jet inspect decisions -O1 named/main.jet
env: JET_OPT_DUMP=port
exit: 0
capture: named_o1 = text stdout.after_first("\nafter fn port").replace("local text:", "local __jet_pipe_112:").replace("local number:", "local __jet_pipe_163:")
cap:named_o1: = "{cap:piped_o1}"
step: jet inspect decisions --release piped/main.jet
env: JET_OPT_DUMP=port
exit: 0
stdout: ~ "O2:" # --release runs the O2 passes
capture: piped_o2 = text stdout.after_first("\nafter fn port")
step: jet inspect decisions --release named/main.jet
env: JET_OPT_DUMP=port
exit: 0
capture: named_o2 = text stdout.after_first("\nafter fn port").replace("local text:", "local __jet_pipe_112:").replace("local number:", "local __jet_pipe_163:")
cap:named_o2: = "{cap:piped_o2}"
step: jet run -O0 piped/main.jet
exit: 0
stdout: = "8080\n"
step: jet run -O1 piped/main.jet
exit: 0
stdout: = "8080\n"
step: jet run -O2 piped/main.jet
exit: 0
stdout: = "8080\n"
