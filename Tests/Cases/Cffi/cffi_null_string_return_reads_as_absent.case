# A C `const char *` result that may be null: null reads as an absent
# name, and a non-null result as the string up to its NUL.
requires: tool:cc|gcc|clang
fixture: CffiNullStringReturnReadsAsAbsent.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = "Ada\nabsent\n"
step: jet run main.jet
exit: 0
stdout: = "Ada\nabsent\n"
