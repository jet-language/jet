use {
    core.mem
    sums: c.sums
}

#Import c.sums: module {
    sum_bytes: fn(bytes: *U8, count: U64) -> U64 = "sum_bytes"
}

// The pointer and its count cross together; C sums exactly `count` bytes.
run: fn() {
    bytes: [U8]{10, 20, 30}
    #Unsafe("the block holds the three bytes for the whole call, C keeps no pointer to it, and it is released once") {
        block := mem.alloc_raw(bytes.len(), 1) ?? panic("no memory")
        mem.list_copy<U8>(block, bytes, 0, bytes.len())
        print(sums.sum_bytes(block, U64{bytes.len()}))
        mem.free_raw(block)
    }
}
