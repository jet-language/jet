use {
    core.mem
    status: c.status
}

#Import c.status: module {
    decode_status: fn(input: *U8, input_len: U32, output: *U8, output_cap: U32, written: ^U32) -> I32 = "decode_status"
}

// The status and the written count both come back: status 0 with three
// bytes written, then -1 when the output cannot hold the input.
run: fn() {
    input: [U8]{1, 2, 3}
    #Unsafe("both blocks are live for the calls, C writes at most `output_cap` bytes and keeps no pointer, and each is released once") {
        ^from: mem.alloc_raw(3, 1) ?? panic("no memory")
        mem.list_copy<U8>(from, input, 0, 3)
        ^to: mem.alloc_raw(3, 1) ?? panic("no memory")
        ^written: U32{0}
        print(status.decode_status(from, U32{3}, to, U32{3}, written))
        print("{written} {to.byte_offset(0).*} {to.byte_offset(1).*} {to.byte_offset(2).*}")
        print(status.decode_status(from, U32{3}, to, U32{1}, written))
        mem.free_raw(to)
        mem.free_raw(from)
    }
}
