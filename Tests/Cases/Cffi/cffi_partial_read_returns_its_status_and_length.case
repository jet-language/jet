# A partial C read: the status says the read was partial, and the out
# length says how many bytes landed in the output.
requires: tool:cc|gcc|clang
fixture: CffiPartialReadReturnsItsStatusAndLength.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = "1\n2 1 2\n"
step: jet run main.jet
exit: 0
stdout: = "1\n2 1 2\n"
