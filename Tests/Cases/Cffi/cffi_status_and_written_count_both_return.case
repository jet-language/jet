# A C call that returns a status and writes a count through an out
# parameter: both reach the caller, on success and on a too-small output.
requires: tool:cc|gcc|clang
fixture: CffiStatusAndWrittenCountBothReturn.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = "0\n3 254 253 252\n-1\n"
step: jet run main.jet
exit: 0
stdout: = "0\n3 254 253 252\n-1\n"
