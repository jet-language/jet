# A byte view crosses to C for one call with its exact length; C borrows it
# and keeps no pointer.
requires: tool:cc|gcc|clang
fixture: CffiBorrowedByteViewCrossesForTheCall.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = "2\n"
step: jet run main.jet
exit: 0
stdout: = "2\n"
