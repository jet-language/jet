# tests/tir_operators_and_runtime.rs::non_arithmetic_checks_remain_checked_inside_wrapping_policy
# Original fixtures and exact assertions; PENDING-SAME-HEAD, runtime UNRUN.
# Case 3: a narrowing `U8{x}` follows the active overflow mode, so 256 wraps
# to 0 under `.Wrapping` instead of stopping.
fixture: NonArithmeticChecksRemainCheckedInsideWrappingPolicy.fixture
env: NO_COLOR=1
step: jet run run.jet
stdin: null
env: JET_ARITHMETIC_CASE=0
env: JET_ARITHMETIC_VALUE=200
exit: 70
stderr: ~ "Stop [E3010]" # original contains
step: jet run run.jet
stdin: null
env: JET_ARITHMETIC_CASE=1
env: JET_ARITHMETIC_VALUE=0
exit: 70
stderr: ~ "Stop [E3010]" # original contains
step: jet run run.jet
stdin: null
env: JET_ARITHMETIC_CASE=2
env: JET_ARITHMETIC_VALUE=8
exit: 70
stderr: ~ "Stop [E3010]" # original contains
step: jet run run.jet
stdin: null
env: JET_ARITHMETIC_CASE=3
env: JET_ARITHMETIC_VALUE=256
exit: 0
stdout: = "0\n" # the narrowing conversion wraps under the mode
step: jet run run.jet
stdin: null
env: JET_ARITHMETIC_CASE=4
env: JET_ARITHMETIC_VALUE=2
exit: 70
stderr: ~ "Stop [E3010]" # original contains
