# Claim: a field nothing reads and a case nothing builds are tidy errors, and
# like every tidy error they never stop `jet run` or `jet dev`. A library's
# public members stay exempt, since readers outside the package may use them;
# its private members are judged, and so is every member of an application,
# public or not.
fixture: MemberLivenessPubExempt.fixture
env: NO_COLOR=1
step: jet run app/main.jet
exit: 0
stdout: = "shapes\n3\non\n" # run runs the program
stdout+stderr: !~ "Jet.UnreadField" # run hides tidy errors
stdout+stderr: !~ "Jet.UnbuiltCase" # run hides tidy errors
step: jet dev app/main.jet --watch=off
exit: 0
stdout: ~ "shapes" # dev runs the program
stdout+stderr: !~ "Jet.UnreadField" # dev hides tidy errors
stdout+stderr: !~ "Jet.UnbuiltCase" # dev hides tidy errors
step: jet check shapes
exit: 1
stderr: ~ "Field `Shape.tag` is never read" # a library's private field is judged
stderr: ~ "Case `Mode.Off` is never built" # a library's private type is judged
stderr: !~ "Shape.width" # a library's pub field is exempt
stderr: !~ "Tone." # a library's pub enum is exempt
stderr: ~ "2 problems found" # only the private members are reported
step: jet check app/main.jet
exit: 1
stderr: ~ "Field `Report.draft` is never read" # an application's pub field is judged
stderr: !~ "Report.title" # a read field is never reported
stderr: !~ "Shape.width" # the library's pub field stays exempt from the application
