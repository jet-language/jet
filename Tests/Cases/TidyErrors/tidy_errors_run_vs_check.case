# Claim: a tidiness error (an unused import, an unused local, an
# unreachable arm) never stops `jet run`, `jet dev` or `jet test` and is not
# printed there; `jet check` and `jet build` list every one and exit non-zero,
# and the JSON report marks each one's kind as tidy.
fixture: TidyErrorsRunVsCheck.fixture
env: NO_COLOR=1
step: jet run main.jet
exit: 0
stdout: ~ "red" # run runs the program
stdout: !~ "again" # the unreachable arm never runs
stdout+stderr: !~ "Jet.Unused" # run hides tidy errors
stdout+stderr: !~ "Jet.UnreachableDispatchArm" # run hides tidy errors
step: jet run --json main.jet
exit: 0
stdout+stderr: !~ "Jet.UnusedImport" # the JSON run reports what the human run shows
stdout+stderr: !~ "\"tier\":\"tidy\"" # the JSON run reports what the human run shows
step: jet dev main.jet --watch=off
exit: 0
stdout: ~ "red" # dev runs the program
stdout+stderr: !~ "Jet.Unused" # dev hides tidy errors
stdout+stderr: !~ "Jet.UnreachableDispatchArm" # dev hides tidy errors
step: jet test --capture=all main.jet
exit: 0
stdout+stderr: ~ "1 passed, 0 failed" # test runs despite tidy errors
stdout+stderr: !~ "Jet.Unused" # test hides tidy errors
stdout+stderr: !~ "Jet.UnreachableDispatchArm" # test hides tidy errors
step: jet check main.jet
exit: 1
stderr: ~ "Error: Jet.UnusedImport" # check lists the unused import
stderr: ~ "Error: Jet.UnusedLocalBinding" # check lists the unused local
stderr: ~ "Error: Jet.UnreachableDispatchArm" # check lists the unreachable arm
stderr: ~ "3 problems found" # check counts every tidy error
stderr: !~ "Warning: " # a tidy error is no warning
step: jet build main.jet
exit: 1
stderr: ~ "Error: Jet.UnusedImport" # build lists the unused import
stderr: ~ "Error: Jet.UnusedLocalBinding" # build lists the unused local
stderr: ~ "Error: Jet.UnreachableDispatchArm" # build lists the unreachable arm
stderr: ~ "3 problems found" # build counts every tidy error
step: jet check --json main.jet
exit: 1
stdout: ~ "\"ok\":false" # a tidy error fails the JSON check
stdout: ~ "\"code\":\"L0103\"" # the JSON check lists the unused import
stdout: ~ "\"code\":\"L0101\"" # the JSON check lists the unused local
stdout: ~ "\"code\":\"L0301\"" # the JSON check lists the unreachable arm
stdout: ~ "\"tier\":\"tidy\"" # each carries its kind
stdout: !~ "\"tier\":\"warning\"" # a tidy error is no warning
