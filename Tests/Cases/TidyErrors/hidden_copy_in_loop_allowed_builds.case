# Claim: a site `#Allow(jet.HiddenCopyInLoop, "why")` silences the L2511
# tidy error inside its statement, so `jet check` and `jet build` pass.
fixture: HiddenCopyInLoopAllowed.fixture
env: NO_COLOR=1
step: jet check main.jet
exit: 0
stdout+stderr: !~ "[jet.HiddenCopyInLoop]" # check honors the allowance
step: jet build main.jet
exit: 0
stdout+stderr: !~ "[jet.HiddenCopyInLoop]" # build honors it too
