# `serve` reads JET_APP_PORT and JET_DEV, the port contract `jet run`, `jet dev`
# and the platform set, and the OTEL_* variables that name the platform's
# trace collector: those reads are the toolchain's, so a served app's allow
# row need not list `Env`. A program's own env read still charges `Env`.
fixture: ServePortEnvReadIsTheToolchains.fixture
env: NO_COLOR=1
step: jet check serve.jet
exit: 0 # serving charges no Env of the package's own
step: jet check reads_env.jet
exit: 1
stderr: count "Jet.ProhibitedEffectReached:" = 1 # only the program's own read is refused (one heading)
stderr: count "Error: " = 1 # the refusal is the only error
stderr: ~ "`reads_env.home` reaches the `Env` effect, which the package's `authority: { allow: […] }` row doesn't list" # the user env read still charges Env
