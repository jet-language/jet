# `effect` is no declaration word: a package effect is a type with an
# `impl Effect` block. A `Log.Audit: effect` line fails to parse like any
# line Jet does not spell, with no teaching diagnostic.
fixture: Fixtures/EffectWord
env: NO_COLOR=1
step: jet check main.jet
exit: nonzero
stderr: ~ "--> main.jet:1:" # the line is refused
stderr: ~ "jet-lang.dev/e/Jet.InvalidStatement" # the ordinary parse code
stderr: !~ "declares no effect" # no report for the old word
stderr: !~ "impl Effect" # no fix teaches the type form
