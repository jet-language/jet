# A source-owned Core call carries the effect set its Core declaration
# writes: `jobs.queue` declares `-[DB, Env, FS, Rand, Time]>` in Core and has
# no compiler-owned call row, so a caller naming the set checks and a `-[DB]>`
# caller is refused for the rest.
fixture: CoreCallEffectSet/Input
env: NO_COLOR=1
step: jet check declared.jet
exit: 0
step: jet check short.jet
exit: 1
stderr: count "Error: " = 1 # exactly this many
stderr: ~ "`open_queue` uses the effect `Env, Rand, Time`" # the declaration's effects past DB and the FS it covers
