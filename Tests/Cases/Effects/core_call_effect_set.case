# A source-owned Core call carries the effect set its Core declaration
# writes: `jobs.queue` declares `-[DB, Env, FS, Rand, Time]>`, the Core
# catalog lists all five for its call row, a caller naming the set checks,
# and a `-[DB]>` caller is refused for the rest.
fixture: CoreCallEffectSet/Input
env: NO_COLOR=1
step: jet inspect structure --core --json
exit: 0
json: stdout doc $.core.calls[?module="core.jobs"][?member="queue"][0].effects = ["DB","Env","FS","Rand","Time"]
step: jet check declared.jet
exit: 0
step: jet check short.jet
exit: 1
stderr: count "Error: " = 1 # exactly this many
stderr: ~ "`open_queue` uses the effect `Env, Rand, Time`" # the declaration's effects past DB and the FS it covers
