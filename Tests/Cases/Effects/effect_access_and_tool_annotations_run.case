# EffectAccess and MCP ToolAnnotations run identically across O0, O1, and O2
# and match the golden example output.
env: NO_COLOR=1
step: jet run -O0 {root}/Examples/Basics/EffectAccess.jet
exit: 0
stdout: == file {root}/Examples/Basics/EffectAccess.out # O0 matches golden
step: jet run -O1 {root}/Examples/Basics/EffectAccess.jet
exit: 0
stdout: == file {root}/Examples/Basics/EffectAccess.out # O1 matches golden
step: jet run -O2 {root}/Examples/Basics/EffectAccess.jet
exit: 0
stdout: == file {root}/Examples/Basics/EffectAccess.out # O2 matches golden
