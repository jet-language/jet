use {
    audit_files: core.files
    audit_parse: core.text.parse
    audit_process: core.process
    audit_json: core.encoding.json
}

// Same shared UTF-8 byte-span/Unicode word recipes as corpus_policy.jet:35-40,742-774.
// Kept private because this fixture is a standalone CLI program, not a public API.
policy_slice_bytes: fn(text: String, start: Int, end: Int) -> String {
    raw: text.bytes()
    assert(start >= 0 && end >= start && end <= raw.len(), "valid corpus byte span")
    if start == end -> return ""
    String.from_bytes(raw[start..(end - 1)]) ?? panic("corpus byte span must end on UTF-8 boundaries")
}

policy_space_width: fn(bytes: [U8], index: Int) -> Int {
    first: Int{bytes[index]}
    if first == 32 || (first >= 9 && first <= 13) -> return 1
    if index + 1 >= bytes.len() -> return 0
    second: Int{bytes[index + 1]}
    if first == 194 && (second == 133 || second == 160) -> return 2
    if index + 2 >= bytes.len() -> return 0
    third: Int{bytes[index + 2]}
    if first == 225 && second == 154 && third == 128 -> return 3
    if first == 226 && second == 128 && ((third >= 128 && third <= 138) || third == 168 || third == 169 || third == 175) {
        return 3
    }
    if first == 226 && second == 129 && third == 159 -> return 3
    if first == 227 && second == 128 && third == 128 -> return 3
    0
}

policy_split_whitespace: fn(text: String) -> [String] {
    bytes: text.bytes()
    words := [String]{}
    index := 0
    start := -1
    loop index < bytes.len() {
        width: policy_space_width(bytes, index)
        if width > 0 {
            if start >= 0 -> words.push(policy_slice_bytes(text, start, index))
            start = -1
            index += width
        } else {
            if start < 0 -> start = index
            index += 1
        }
    }
    if start >= 0 -> words.push(policy_slice_bytes(text, start, bytes.len()))
    words
}

// Strip one leading/trailing pipe, not all pipes
audit_table_cells: fn(raw: String) -> [String] {
    line := raw.trim()
    if line.starts_with("|") -> line = policy_slice_bytes(line, 1, line.bytes().len())
    if line.ends_with("|") -> line = policy_slice_bytes(line, 0, line.bytes().len() - 1)
    result := [String]{}
    loop cell in audit_parse.split(line, "|") -> result.push(cell.trim())
    result
}

audit_card_refs: fn(cell: String) -> [String] {
    result := [String]{}
    loop token in policy_split_whitespace(cell) {
        raw: token.bytes()
        if raw.len() <= 1 || raw[0] != (U8{35}) -> next
        digits := true
        loop i in 1..<raw.len() {
            if raw[i] < (U8{48}) || raw[i] > (U8{57}) -> digits = false
        }
        if digits -> result.push(token)
    }
    result
}

audit_card_number: fn(card: String) -> Int {
    // Rust parse::<i64>() rejects overflow; do not wrap an oversized card reference.
    number := 0
    raw: card.bytes()
    loop i in 1..<raw.len() {
        digit: Int{raw[i]} - 48
        assert(number <= (9223372036854775807 - digit) /% 10, "audit card reference must contain a numeric card ID")
        number = number * 10 + digit
    }
    number
}

// The Tower cards on the board, in the board's own shape (`cards: [{num}]`). The
// case passes the fixture's board.json: every card the audit names that the live
// board holds. A dev checkout's Tools/Tower/.tower is not the live board.
audit_board_cards: fn(path: String) -> [Int] {
    raw: audit_files.read(path) ?? panic("read board {path}")
    board: audit_json.parse(raw) ?? panic("parse board {path}: {err.reason}")
    entries: audit_json.pointer(board, "/cards") ?? panic("board {path} must list cards")
    nums := [Int]{}
    if entries == .Array(cards) {
        loop card in cards {
            value: audit_json.pointer(card, "/num") ?? panic("board card must contain a numeric num")
            resolved: if value == {
                .Int(number) -> number
                .Float(number) -> checked(Int{number}) ?? panic("board card num is not an integer")
                .Number(number) -> Int.parse(number) ?? panic("board card num is not an integer: {number}")
                .Null | .Bool(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> panic("board card must contain a numeric num")
            }
            nums.push(resolved)
        }
    }
    nums
}

// Exact table predicates ; the argument is the board
run: fn() {
    board: audit_board_cards(audit_process.args()[0])
    text: audit_files.read("Docs/Audits/cli-diagnostics-accessibility.md") ?? panic("CLI accessibility audit is readable")
    lines: text.lines()
    expected: [String]{"id", "surface", "screen_reader", "state", "card"}
    header := -1
    loop i in 0..<lines.len() {
        if audit_table_cells(lines[i]) == expected {
            header = i
            break
        }
    }
    assert(header >= 0, "accessibility audit must have the machine-readable findings header")
    assert(header + 1 < lines.len(), "accessibility findings table needs a separator row")
    separator: audit_table_cells(lines[header + 1])
    assert(separator.len() == expected.len(), "accessibility findings table separator must match its five columns")
    loop cell in separator {
        assert(cell == "---", "accessibility findings table needs a Markdown separator for every column")
    }
    rows := [[String]]{}
    finding_ids := [String]{}
    loop i in (header + 2)..<lines.len() {
        line: lines[i]
        if !line.trim_start().starts_with("|") -> break
        cells: audit_table_cells(line)
        assert(cells.len() == expected.len(), "accessibility findings row must have id, surface, screen_reader, state, and card: {line}")
        loop j in 0..<expected.len() {
            assert(!cells[j].is_empty(), "accessibility finding {expected[j]} must not be empty: {line}")
        }
        assert(!finding_ids.contains(cells[0]), "accessibility finding IDs must be unique: {cells[0]}")
        finding_ids.push(cells[0])
        assert(cells[3] == "pass" || cells[3] == "gap" || cells[3] == "not-proven", "accessibility finding {cells[0]} has an unknown state: {cells[3]}")
        rows.push(cells)
    }
    assert(!rows.is_empty(), "accessibility audit must list at least one finding")
    loop row in rows {
        if audit_parse.lower(row[3].trim()) == "pass" {
            assert(row[4] == "—", "passing accessibility finding {row[0]} must not name a Tower card")
            next
        }
        cards: audit_card_refs(row[4])
        assert(!cards.is_empty(), "non-pass accessibility finding {row[0]} must name a live Tower card")
        unique_cards := [String]{}
        loop card in cards {
            assert(!unique_cards.contains(card), "accessibility finding {row[0]} must list each Tower card once: {card}")
            unique_cards.push(card.copy())
            assert(board.contains(audit_card_number(card)), "accessibility finding {row[0]} names missing Tower card {card}")
        }
    }
    // The dated audit names the schema of its day, `jet.report/v1`; the 2026-09-11
    // checkpoint 38b2b7df7b rewrote this literal to v2 with the schema bump but left
    // the retained report as written, so the predicate could never hold. The live
    // schema is JET_CLI_REPORT_SCHEMA in Compiler/JetCLI/Source/CLI/Report.jet.
    laws: [String]{"D-REPORT-LAW1=A", "D-REPORT-HOME1=A", "D-REPORT-MACHINE1=A", "D-REPORT-EDITOR1=A", "`jet.report/v1`"}
    loop law in laws {
        assert(text.contains(law), "accessibility audit must name the canonical report law {law}")
    }
}
