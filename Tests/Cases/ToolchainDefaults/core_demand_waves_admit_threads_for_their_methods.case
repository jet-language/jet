# A Core demand wave admits compiler threads for the methods it names, by
# their source bytes, as it does for its top-level bodies (JetSema
# Sema/BodyPasses.jet, sema_check_body_stream with SemaWaveKind.Core), so a
# wave of mostly Core methods no longer checks them all on one thread. A JSON
# round trip demands the JSON value's methods and its parser's, enough work
# to admit two threads, and its output shows the bodies the threads checked
# are the ones a single thread checks.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
write: main.jet = "use json: core.encoding.json\n\nrun: fn() {\n    tree: json.parse(`{\"a\": [1, 2.5, true, null, \"x\"], \"b\": {\"c\": -3}}`) ?? return\n    print(json.to_string(tree))\n}\n"
step: jet check --threads 2 --trace main.jet
exit: 0
stdout+stderr: ~ "has no problems" # the check's summary line, among the trace's rows
stderr: ~ "# sema.core_demand.wave_workers = 2\n" # a demand wave admits both threads the cap allows
step: jet run --threads 2 main.jet
exit: 0
stdout: = "{\"a\":[1,2.5,true,null,\"x\"],\"b\":{\"c\":-3}}\n"
