# Docs/Spec/Reference/environment.md: an entry under a toolchain tree's `Compiler/` names that
# tree, so with `JET_TOOLCHAIN_ROOT` unset it compiles against the tree's Core. The tree's
# core.log carries an error in `info`, which `probe.jet` calls, so the check reports it only
# when it reads the tree's Core.
env: NO_COLOR=1
requires: os:unix
fixture: CheckCoreUncalled.fixture
copy: {root}/Core tree/Core
copy: {root}/Compiler/Prelude tree/Compiler/Prelude
copy: tree/app/probe.jet tree/Compiler/probe/probe.jet
concat: tree/Core/Log/Log.jet tree/Core/Log/Log.jet reached.txt
step: jet check tree/Compiler/probe/probe.jet
unset: JET_TOOLCHAIN_ROOT
exit: 1
stdout+stderr: ~ "info" # the error in the tree's Core/Log/Log.jet
step: jet check tree/app/probe.jet
unset: JET_TOOLCHAIN_ROOT
exit: 0
stdout+stderr: ~ "has no problems" # outside Core/ and Compiler/ the entry takes the built-in Core
