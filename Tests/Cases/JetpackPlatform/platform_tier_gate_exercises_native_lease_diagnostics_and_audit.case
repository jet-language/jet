# HAND-PORT tests/jetpack_platform.rs platform_tier_gate_exercises_native_lease_diagnostics_and_audit
env: NO_COLOR=1
env: JETPACK_ROOT={work}/root
env: JETPACK_FIXTURES={work}/fixtures
requires: os-name:linux
mkdir: root
mkdir: fixtures
mkdir: missing-tools
mkdir: output/bin
write: omp.jet = "run: fn() {\n    print(\"jetpack platform fixture\")\n}\n"
step: jet build --output-dir=output/bin omp.jet
exit: 0
copy: output/bin/omp fixtures/omp-native-jetpack-fixture
capture: artifact_sha = sha256 file fixtures/omp-native-jetpack-fixture
write: fixtures/jetpackage-omp.json = "{\"tag\":\"v1.0.0\",\"version\":\"1.0.0\",\"sha256\":\"{cap:artifact_sha}\",\"artifact\":\"omp-native-jetpack-fixture\"}\n"
step: jetpack use omp@releases#1.0.0 -y --no-color --offline --fixtures {work}/fixtures -- omp --help
env: PATH={work}/missing-tools
exit: 0
stdout: ~ "jetpack" # native lease child ran
entries: root/leases = 0 # production child exit left no lease behind
mkdir: good-src
write: good-src/payload = "fixture payload: platform-diagnostics-good"
step: jetpack hangar ingest good-src --name platform-diagnostics-good --version 1.0 --ref fixture:platform-diagnostics-good --source-fingerprint sha256-fixture-source-platform-diagnostics-good --recipe-fingerprint sha256-fixture-recipe-platform-diagnostics-good --policy-fingerprint policy=fixture --provenance fixture --json --no-color
exit: 0
capture: good_id stdout doc $.id
mkdir: root/leases/4294967294-1-platform-diagnostics-good/snapshot
write: root/leases/4294967294-1-platform-diagnostics-good/snapshot/partial = "interrupted"
step: jetpack doctor --json --offline
exit: 1
stdout: ~ "stale executable lease(s) found" # doctor reported stale lease
file: root/leases/4294967294-1-platform-diagnostics-good exists
step: jetpack audit --no-color
exit: 0
stderr: ~ "Leases:" # audit showed lease section
stderr: ~ "0 active, 1 stale" # audit counted stale lease
mkdir: root/hangar/closure-db/journal
write: root/hangar/closure-db/journal/00000000000000000099-corrupt.txn.partial = "interrupted"
step: jetpack audit --no-color
exit: 2
stderr: ~ "Error: Jet.JetpackCommandFailed:" # audit failed closed on partial journal
stderr: ~ "Why:" # diagnostic includes Why
stderr: ~ "Fix:" # diagnostic includes Fix
stderr: ~ "More: jet-lang.dev/e/Jet.JetpackCommandFailed" # diagnostic includes More
file: root/hangar/closure-db/journal/00000000000000000099-corrupt.txn.partial exists
file: root/hangar/{cap:good_id}/meta.json exists
remove: root/hangar/closure-db/journal/00000000000000000099-corrupt.txn.partial
step: jetpack hangar recover --no-color
env: PATH={work}/missing-tools
exit: 0
file: root/leases/4294967294-1-platform-diagnostics-good absent
file: root/hangar/{cap:good_id}/meta.json exists
