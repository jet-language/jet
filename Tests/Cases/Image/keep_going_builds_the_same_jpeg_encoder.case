# Keep-going never changes emitted code. A plain build loads the Core
# library's check of each Core body, and a keep-going build checks every Core
# body from text; both lower the same code. The JPEG encoder holds locals
# computed from calls (its code tables), so it builds to the same bytes with
# and without --keep-going.
fixture: JpegEncodeStaysWithinPsnrOnAllTiers.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet build -O1 run.jet
exit: 0
capture: plain_sha = sha256 file .jet/build/run
step: jet build -O1 --keep-going run.jet
exit: 0
file: .jet/build/run sha256 = "{cap:plain_sha}" # the keep-going build is the plain build's bytes
