// Fibers past the pool of idle stacks tear down in random order. 2000 tasks
// each park on their own channel and are released in a shuffled order; every
// fifth release also spawns a task that parks the same way, released after
// the first wave. Each finished fiber past the pool leaves the live thread
// registry, so its rows are removed in an order unrelated to how they were
// added. Every task returns the value it was sent. Once the tasks are joined,
// tasks.quiesce() joins every scheduler thread, carriers that retired past
// the pool included, each until it has left the process. So the thread count
// is then exactly the one read before any task started: no thread is left
// behind, under any load or pool size.
package: {
    name: "fiber_teardown"
    authority: { allow: [Exec, FS, FS.Read, IO, Mem.Alloc, Time, Time.Wait] }
}

use {
    files: core.files
    tasks: core.tasks
    time: core.time
}

TASKS: 2000

waiter: fn(rx: Receiver<Int>) -> Int { rx.receive() ?? -1 }

threads: fn() -[FS]> Int {
    text: files.read("/proc/self/status") ?? panic("read status")
    loop line in text.lines() {
        if line.starts_with("Threads:") {
            return Int.parse(line.remove_prefix("Threads:").trim()) ?? -1
        }
    }
    -1
}

// A Fisher-Yates shuffle of 0..<count by a fixed LCG: the same order on
// every run.
shuffled: fn(count: Int) -> [Int] {
    order := [Int]{}
    loop i in 0..<count -> order.push(i)
    seed := 12345
    loop k in 0..<count {
        seed = (seed * 1103515245 + 12345) % 2147483648
        j: k + seed % (count - k)
        held: order[j]
        order[j] = order[k]
        order[k] = held
    }
    order
}

run: fn() {
    before: threads()
    senders := [Sender<Int>]{}
    parked := [Task<Int>]{}
    loop _ in 0..<TASKS {
        { sender: tx, receiver: rx }: channel<Int>(capacity: 1)
        senders.push(tx)
        parked.push(task waiter(rx))
    }
    // Lets the tasks park before their releases; the count below does not
    // depend on it.
    time.sleep(50ms)
    late_senders := [Sender<Int>]{}
    late := [Task<Int>]{}
    order: shuffled(TASKS)
    loop k in 0..<TASKS {
        senders[order[k]].send(order[k])
        if k % 5 == 0 {
            { sender: tx, receiver: rx }: channel<Int>(capacity: 1)
            late_senders.push(tx)
            late.push(task waiter(rx))
        }
    }
    right := 0
    at := 0
    loop handle in parked {
        got: handle.join() ?? -1
        if got == at -> right += 1
        at += 1
    }
    late_count: late.len()
    late_order: shuffled(late_count)
    loop k in 0..<late_count -> late_senders[late_order[k]].send(TASKS + late_order[k])
    late_right := 0
    at = 0
    loop handle in late {
        got: handle.join() ?? -1
        if got == TASKS + at -> late_right += 1
        at += 1
    }
    quiesced: tasks.quiesce()
    after: threads()
    print("{right} of {TASKS} and {late_right} of {late_count} returned what they were sent")
    if quiesced && after == before -> print("threads unchanged true") else {
        print("threads unchanged false: quiesced {quiesced}, {before} before, {after} after")
    }
}
