probe: fn(value: Int) -> Int {
    return (value /% 3) + (value % 3) + (value %% 3) + (value << 1) + (value >> 1)
}

run: fn() {
    total := 0
    loop i in 0..<10 {
        total += (i /% 3)
        total += (i % 3)
        total += (i %% 3)
        total += (i << 1)
        total += (i >> 1)
    }
    print(total)
    print(probe(9223372036854775808))
}
