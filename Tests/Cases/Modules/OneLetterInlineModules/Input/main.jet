a: module {
    World: struct {
        x: Int,
    }

    origin: fn() -> World { World{x: 3} }
}

b: module {
    Camera: struct {
        y: Int,
    }
}

run: fn() {
    world: a.origin()
    camera: b.Camera{y: 4}
    moved: a.World{x: world.x + camera.y}
    print("world {world.x} camera {camera.y} moved {moved.x}")
}
