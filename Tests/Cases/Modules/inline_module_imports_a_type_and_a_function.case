# `use geo.[Point, double]` imports a type and a function from one inline
# module: `Point` names the module's member type in a signature, a struct
# literal and a declared type, exactly as `geo.Point` does, and `double`
# calls the member function.
fixture: InlineModuleImportsATypeAndAFunction/Input
env: NO_COLOR=1
step: jet check main.jet
exit: 0
step: jet run -O0 main.jet
exit: 0
stdout: = "2 2\n5 4\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "2 2\n5 4\n"
