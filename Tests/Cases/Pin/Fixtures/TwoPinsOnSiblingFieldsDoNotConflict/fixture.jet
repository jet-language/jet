use core.mem

Node: struct {
    _payload: Int,
    hops: Int,
}

Pair: struct {
    left: Node,
    right: Node,
}

run: fn() {
    ^pair: Pair{left: Node{_payload: 1, hops: 0}, right: Node{_payload: 2, hops: 0}}
    first: mem.pin(pair.left)
    second: mem.pin(pair.right)
    first.hops += 1
    second.hops += 2
    print("{(first.hops)} {(second.hops)}")
}
