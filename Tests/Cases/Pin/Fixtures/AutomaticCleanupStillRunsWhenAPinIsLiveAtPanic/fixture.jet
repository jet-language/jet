use core.mem

Guard: struct {
    name: String,

    impl Close {
        close: fn(^^self) { print("closed {self.name}") }
    }
}

Node: struct {
    _payload: Int,
    hops: Int,
}

run: fn() {
    ^_guard: Guard{name: "pin"}
    ^node: Node{_payload: 1, hops: 0}
    pinned: mem.pin(node)
    pinned.hops += 1
    print("body {(pinned.hops)}")
    panic("stop")
}
