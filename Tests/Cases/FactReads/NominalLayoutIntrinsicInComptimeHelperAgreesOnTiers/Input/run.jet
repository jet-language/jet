#Layout(c) TargetPointer: struct {
    pointer: *Int,

    // A `#run fn` is compile-time code, so its body reads the layout fact.
    #run pointer_bytes: fn() -> Int Never! {
        layout: TargetPointer.reflect().layout
        layout.size ?? panic("target pointer layout is missing")
    }
}

POINTER_BYTES: #run TargetPointer.pointer_bytes()

INLINE_BYTES: #run { TargetPointer.reflect().layout.size ?? 0 }

run: fn() { print(POINTER_BYTES == INLINE_BYTES) }
