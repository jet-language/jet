// A type's TypeInfo lists the traits it implements (`traits`) and the
// associated constants of those traits with their values (`constants`); its
// identity lists the type each parameter is bound to when the type is named
// with its arguments (`generic_bindings`), and says whether a number is
// signed or a float (`kind`), with a sized number's `bits` binding. A
// compile-time value and the program read the same records.
Shape: trait {
    sides: Int,
    label: String{"shape"},
    angles: [Int],
    area: fn(self) -> Int,
}

Square: struct {
    side: Int,

    impl Shape {
        sides: 4,
        angles: [90, 90, 90, 90],

        area: fn(self) -> Int { self.side * self.side }
    }
}

Pair: struct<A, B> {
    first: A,
    second: B,
}

Meters: distinct Float

// A number's signedness, width and kind; a distinct type reads its base.
number_form: fn(id: TypeId) -> String? {
    if id.kind == .Distinct {
        loop binding in id.generic_bindings {
            if binding.name == "base" -> return number_form(binding.type)
        }
    }
    if id.kind == .Number(signed, float) {
        sign: if signed -> "signed" else -> "unsigned"
        kind: if float -> "float" else -> "integer"
        loop binding in id.generic_bindings {
            if binding.name == "bits" -> return Val("{sign} {binding.size ?? 0}-bit {kind}")
        }
        return Val("{sign} {kind}")
    }
    None
}

number: fn(info: TypeInfo) -> String {
    form: number_form(info.identity) ?? return "{info.name}: not a number"
    "{info.name}: {form}"
}

NUMBERS: #run { [number(I32.reflect()), number(U8.reflect()), number(F32.reflect()), number(Int.reflect())] }

PREPARED: #run { Square.reflect() }

PAIR: #run { Pair<Int, String>.reflect() }

describe: fn(info: TypeInfo) -> String {
    ^traits: [String]{}
    loop implemented in info.traits {
        traits.push("{implemented.name} ({implemented.methods.len()} methods)")
    }
    ^constants: [String]{}
    loop constant in info.constants {
        constants.push("{constant.trait_name}.{constant.name}: {constant.type.name} = {constant.value ?? "unknown"}")
    }
    ^bindings: [String]{}
    loop binding in info.identity.generic_bindings {
        bindings.push("{binding.name} = {binding.type.name}")
    }
    "{info.name}: traits [{traits.join(", ")}]; constants [{constants.join("; ")}]; bindings [{bindings.join(", ")}]"
}

implements: fn(info: TypeInfo, name: String) -> Bool {
    loop implemented in info.traits {
        if implemented.name == name -> return true
    }
    false
}

run: fn() {
    print("prepared: {describe(PREPARED)}")
    print("program: {describe(Square.reflect())}")
    print("pair: {describe(PAIR)}")
    print("pair in program: {describe(Pair<Int, String>.reflect())}")
    print("bare pair: {describe(Pair.reflect())}")
    print("Square implements Shape: {implements(Square.reflect(), "Shape")}")
    print("Pair implements Shape: {implements(PAIR, "Shape")}")
    print("area {Square{side: 3}.area()}")
    print("prepared numbers: {NUMBERS.join(", ")}")
    print("numbers: {number(I32.reflect())}, {number(U8.reflect())}, {number(F32.reflect())}, {number(Int.reflect())}")
    print("{number(Meters.reflect())}; {number(Square.reflect())}")
}
