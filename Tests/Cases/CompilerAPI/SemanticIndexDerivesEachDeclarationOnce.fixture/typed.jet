use compiler: core.compiler

// main.jet's derivation records as typed code reads them, printed in the shape
// `jet inspect compiler check main.jet` gives them, so the case compares the
// two documents record by record.
CHECKED: #run { compiler.check(compiler.parse(embed_file("main.jet")) ?? panic("parse")) ?? panic("check") }

INDEX: #run { CHECKED.semantic_index() ?? panic("a clean check has an index") }

quoted: fn(text: String) -> String {
    escaped: text.replace("\\", "\\\\").replace("\"", "\\\"")
    "\"{escaped}\""
}

listed: fn(values: [String]) -> String { "[{(loop value in values -> quoted(value)).join(",")}]" }

optional: fn(value: String?) -> String { if value == .Val(text) -> quoted(text) else -> "null" }

DERIVATIONS: #run (loop record in INDEX.derivations -> "{{\"id\":{quoted(record.id)},\"subject\":{quoted(record.subject)},\"claim\":{quoted(record.claim)},\"producer\":{quoted(record.producer)},\"method\":{quoted(record.method)},\"rule\":{quoted(record.rule)},\"premises\":{listed(record.premises)},\"identity\":{{\"source\":{quoted(record.identity.source)},\"build\":{quoted(record.identity.build)},\"run\":{quoted(record.identity.run)},\"target\":{quoted(record.identity.target)}}},\"assumptions\":{listed(record.assumptions)},\"disposition\":{quoted(record.disposition)},\"observation\":{(if record.observation == .Val(observation) -> "{{\"counterexample\":{optional(observation.counterexample)},\"event\":{optional(observation.event)}}}" else -> "null")},\"payload\":{(if record.payload == .Val(payload) -> "{{\"kind\":{quoted(payload.kind)},\"json\":{quoted(payload.json)}}}" else -> "null")}}}").join(",")

run: fn() {
    print("{{\"compiler\":{{\"value\":{{\"semantic_index\":{{\"derivations\":[{DERIVATIONS}]}}}}}}}}")
}
