# Typed code reading `compiler.check` and the CLI's `jet inspect compiler check` see one result: each index fact typed.jet prints from main.jet is the same value in the CLI JSON, and a text with a semantic error keeps its diagnostics and has no index on both sides. A text whose import does not resolve is stopped before anything is checked, so both sides list no function and no effect rather than facts read from its syntax.
# Covers every member of the index: source_digest, definitions, references, calls and effects from main.jet, and state_graphs, fact_registry and derivations from machine.jet, a typestate struct with methods. typed_index.jet prints the last three as the JSON document the CLI prints, so its step is compared with the CLI's path by path. Its state spans leave out the file name, so a state is compared by name, terminal, reachable and span bounds.
# Every section spells the module one way, the way the identities do: main.jet checks as module `core_compiler`, so each `module` field is "core_compiler" and none is the dotted "core.compiler".
fixture: TypedConsumersMatchCLIJSON.fixture
env: NO_COLOR=1
step: jet run typed.jet
exit: 0
stdout: ~ "digest 9f360578ca264b727a79652f62db9bbb31f14499e2d867f6cf6f08243d14e001" # SHA-256 of the fixture main.jet bytes
stdout: ~ "definition helper fn:core_compiler.helper core_compiler 0-6" # the CLI JSON row for helper below; the module is the identity's module
stdout: ~ "definition run fn:core_compiler.run core_compiler 45-48" # the CLI JSON row for run below
stdout: ~ "definition value param:core_compiler.helper.value core_compiler 11-16" # the CLI JSON row for the parameter below
stdout: ~ "reference value core_compiler 32-37" # the one reference in main.jet
stdout: ~ "call fn:core_compiler.run fn:core_compiler.helper core_compiler 63-69" # the one call
stdout: ~ "effect fn:core_compiler.helper direct= callees= inferred= maximal=false provenance=" # helper has no effect
stdout: ~ "effect fn:core_compiler.run direct=IO callees=fn:core_compiler.helper inferred=IO maximal=false provenance=IO:fn:core_compiler.run@57-62" # run's IO comes from its own print
stdout: ~ "broken E0107 index absent" # broken.jet keeps its diagnostic and has no index
stdout: ~ "unresolved E0603 functions=0 effects=0 index absent" # the stopped check claims no checked fact
step: jet inspect compiler check main.jet
exit: 0
json: stdout doc $.compiler.value.semantic_index.source_digest = "9f360578ca264b727a79652f62db9bbb31f14499e2d867f6cf6f08243d14e001"
json: stdout doc $.compiler.value.semantic_index.definitions[?name="helper"][0].identity = "fn:core_compiler.helper"
json: stdout doc $.compiler.value.semantic_index.definitions[?name="helper"][0].module = "core_compiler" # the module spelled as in the identity above
json: stdout doc $.compiler.value.semantic_index.definitions[?name="helper"][0].span.start = 0
json: stdout doc $.compiler.value.semantic_index.definitions[?name="helper"][0].span.end = 6
json: stdout doc $.compiler.value.semantic_index.definitions[?name="run"][0].identity = "fn:core_compiler.run"
json: stdout doc $.compiler.value.semantic_index.definitions[?name="run"][0].span.start = 45
json: stdout doc $.compiler.value.semantic_index.definitions[?name="run"][0].span.end = 48
json: stdout doc $.compiler.value.semantic_index.definitions[?name="run"][0].module = "core_compiler"
json: stdout doc $.compiler.value.semantic_index.definitions[?identity="param:core_compiler.helper.value"][0].span.start = 11
json: stdout doc $.compiler.value.semantic_index.definitions[?identity="param:core_compiler.helper.value"][0].span.end = 16
json: stdout doc $.compiler.value.semantic_index.definitions[?identity="param:core_compiler.helper.value"][0].module = "core_compiler"
json: stdout doc $.compiler.value.semantic_index.definitions[?module="core.compiler"] #= 0 # no definition keeps the dotted spelling
json: stdout doc $.compiler.value.semantic_index.references[?module="core_compiler"] #= 1 # typed.jet printed one reference in main.jet
json: stdout doc $.compiler.value.semantic_index.references[?module="core_compiler"][0].name = "value"
json: stdout doc $.compiler.value.semantic_index.references[?module="core_compiler"][0].span.start = 32
json: stdout doc $.compiler.value.semantic_index.references[?module="core_compiler"][0].span.end = 37
json: stdout doc $.compiler.value.semantic_index.references[?module="core.compiler"] #= 0
json: stdout doc $.compiler.value.semantic_index.calls #= 1 # typed.jet printed every call
json: stdout doc $.compiler.value.semantic_index.calls[0].caller = "fn:core_compiler.run"
json: stdout doc $.compiler.value.semantic_index.calls[0].callee = "fn:core_compiler.helper"
json: stdout doc $.compiler.value.semantic_index.calls[0].module = "core_compiler"
json: stdout doc $.compiler.value.semantic_index.calls[0].span.start = 63
json: stdout doc $.compiler.value.semantic_index.calls[0].span.end = 69
json: stdout doc $.compiler.value.semantic_index.structural_nodes[?module="core.compiler"] #= 0 # the syntax walk spells the module the same way
json: stdout doc $.compiler.value.semantic_index.structural_nodes[?module="core_compiler"][0].class = "item"
json: stdout doc $.compiler.value.semantic_index.effects[?function="fn:core_compiler.helper"][0].direct = []
json: stdout doc $.compiler.value.semantic_index.effects[?function="fn:core_compiler.helper"][0].callees = []
json: stdout doc $.compiler.value.semantic_index.effects[?function="fn:core_compiler.helper"][0].inferred = []
json: stdout doc $.compiler.value.semantic_index.effects[?function="fn:core_compiler.helper"][0].maximal = false
json: stdout doc $.compiler.value.semantic_index.effects[?function="fn:core_compiler.helper"][0].provenance = []
json: stdout doc $.compiler.value.semantic_index.effects[?function="fn:core_compiler.run"][0].direct = ["IO"]
json: stdout doc $.compiler.value.semantic_index.effects[?function="fn:core_compiler.run"][0].callees = ["fn:core_compiler.helper"]
json: stdout doc $.compiler.value.semantic_index.effects[?function="fn:core_compiler.run"][0].inferred = ["IO"]
json: stdout doc $.compiler.value.semantic_index.effects[?function="fn:core_compiler.run"][0].maximal = false
json: stdout doc $.compiler.value.semantic_index.effects[?function="fn:core_compiler.run"][0].provenance #= 1
json: stdout doc $.compiler.value.semantic_index.effects[?function="fn:core_compiler.run"][0].provenance[0].effect = "IO"
json: stdout doc $.compiler.value.semantic_index.effects[?function="fn:core_compiler.run"][0].provenance[0].call_path = ["fn:core_compiler.run"]
json: stdout doc $.compiler.value.semantic_index.effects[?function="fn:core_compiler.run"][0].provenance[0].spans[*].start = [57]
json: stdout doc $.compiler.value.semantic_index.effects[?function="fn:core_compiler.run"][0].provenance[0].spans[*].end = [62]
step: jet inspect compiler check broken.jet
exit: 0
json: stdout doc $.compiler.value.diagnostics[*].code = ["E0107"] # the semantic error stays a diagnostic
json: stdout doc $.compiler.value.semantic_index = null # and the index is absent, as typed.jet saw
step: jet inspect compiler check unresolved.jet
exit: 0
json: stdout doc $.compiler.value.diagnostics[*].code = ["E0603"] # the same diagnostic typed.jet printed
json: stdout doc $.compiler.value.functions = [] # as typed.jet saw: no function
json: stdout doc $.compiler.value.effects = [] # and no effect
json: stdout doc $.compiler.value.semantic_index = null
step typed_index: jet run typed_index.jet
exit: 0
json: stdout doc $.compiler.value.semantic_index.state_graphs #= 1 # typed code reads Door's graph
step: jet inspect compiler check machine.jet
exit: 0
json: stdout doc $.compiler.value.diagnostics[*].code = ["L0153"] # only the lint for the unreachable Orphan state, so the index is present
json: stdout doc $.compiler.value.semantic_index.state_graphs #= 1
json: stdout doc $.compiler.value.semantic_index.state_graphs[0].owner = "Door"
json: stdout doc $.compiler.value.semantic_index.state_graphs[0].states[*].name = ["Closed", "Open", "Orphan"]
json: stdout doc $.compiler.value.semantic_index.state_graphs[0].states[*].reachable = [true, true, false]
json: stdout doc $.compiler.value.semantic_index.state_graphs[0].transitions #= 2 # close enters Closed, open moves it to Open
json: stdout doc $.compiler.value.semantic_index.state_graphs[*].owner == typed_index
json: stdout doc $.compiler.value.semantic_index.state_graphs[*].module == typed_index
json: stdout doc $.compiler.value.semantic_index.state_graphs[*].states[*].name == typed_index
json: stdout doc $.compiler.value.semantic_index.state_graphs[*].states[*].terminal == typed_index
json: stdout doc $.compiler.value.semantic_index.state_graphs[*].states[*].reachable == typed_index
json: stdout doc $.compiler.value.semantic_index.state_graphs[*].states[*].span.start == typed_index
json: stdout doc $.compiler.value.semantic_index.state_graphs[*].states[*].span.end == typed_index
json: stdout doc $.compiler.value.semantic_index.state_graphs[*].transitions == typed_index # each transition whole, an entry's absent `from` as null
json: stdout doc $.compiler.value.semantic_index.fact_registry[?kind="State"][0].members = ["Closed", "Open", "Orphan"]
json: stdout doc $.compiler.value.semantic_index.fact_registry == typed_index # every declaration whole: the effect roots, Door's states and the tags
json: stdout doc $.compiler.value.semantic_index.derivations[?identity.target="core.compiler"] #= 4 # Door, close, open and run
json: stdout doc $.compiler.value.semantic_index.derivations #== typed_index # typed code reads as many records
json: stdout doc $.compiler.value.semantic_index.derivations[?identity.target="core.compiler"] == typed_index # and each of this text's records whole, ids, identity, premises, absent observation and payload included
