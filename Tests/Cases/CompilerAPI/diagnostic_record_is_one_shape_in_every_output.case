# One CompilerDiagnostic record in every machine output (D-DIAG-ONESHAPE1): typed code reading compiler.parse, `jet inspect compiler lex|parse|check` and the `jet check --json` report carry the same code, severity, message, span, origin and graded fix_edits.
# A file the command read is named in span.file, origin.path and each repair's span.file; the text typed code hands the query names no file ("" and none) but has the same digest, the SHA-256 of habit.jet's bytes.
fixture: DiagnosticOriginWitnesses.fixture
env: NO_COLOR=1
step: jet run oneshape.jet
exit: 0
stdout: = "E0003 error `++` is not a Jet operator | [] 28-30 | none 0ed8e6a3ae8857367143fd76425785e340063450d938f363938eb19dc7756e35 | [] 28-30 < += 1> needs-review\n" # the handed text names no file; the repair carries its grade
step: jet inspect compiler parse habit.jet
exit: 0
json: stdout doc $.compiler.value.schema_version = 3 # the value records carry `fix_edits` since version 3
json: stdout doc $.compiler.value.diagnostics[?code="E0003"][0].severity = "error"
json: stdout doc $.compiler.value.diagnostics[?code="E0003"][0].message = "`++` is not a Jet operator"
json: stdout doc $.compiler.value.diagnostics[?code="E0003"][0].span = {"file":"habit.jet","start":28,"end":30}
json: stdout doc $.compiler.value.diagnostics[?code="E0003"][0].origin = {"path":"habit.jet","source_digest":"0ed8e6a3ae8857367143fd76425785e340063450d938f363938eb19dc7756e35"}
json: stdout doc $.compiler.value.diagnostics[?code="E0003"][0].fix_edits = [{"span":{"file":"habit.jet","start":28,"end":30},"new_text":" += 1","safety":"needs-review"}]
step: jet inspect compiler check habit.jet
exit: 0
json: stdout doc $.compiler.value.diagnostics[?code="E0003"][0].severity = "error"
json: stdout doc $.compiler.value.diagnostics[?code="E0003"][0].message = "`++` is not a Jet operator"
json: stdout doc $.compiler.value.diagnostics[?code="E0003"][0].span = {"file":"habit.jet","start":28,"end":30}
json: stdout doc $.compiler.value.diagnostics[?code="E0003"][0].origin = {"path":"habit.jet","source_digest":"0ed8e6a3ae8857367143fd76425785e340063450d938f363938eb19dc7756e35"}
json: stdout doc $.compiler.value.diagnostics[?code="E0003"][0].fix_edits = [{"span":{"file":"habit.jet","start":28,"end":30},"new_text":" += 1","safety":"needs-review"}]
step: jet check --json habit.jet
exit: 1
json: stdout doc $.reports[?code="E0003"][0].schema = "jet.report/v4" # the record, then the report extension
json: stdout doc $.reports[?code="E0003"][0].severity = "error"
json: stdout doc $.reports[?code="E0003"][0].message = "`++` is not a Jet operator"
json: stdout doc $.reports[?code="E0003"][0].span = {"file":"habit.jet","start":28,"end":30}
json: stdout doc $.reports[?code="E0003"][0].origin = {"path":"habit.jet","source_digest":"0ed8e6a3ae8857367143fd76425785e340063450d938f363938eb19dc7756e35"}
json: stdout doc $.reports[?code="E0003"][0].fix_edits = [{"span":{"file":"habit.jet","start":28,"end":30},"new_text":" += 1","safety":"needs-review"}]
json: stdout doc $.reports[?code="E0003"][0].line = 3 # extension members follow the record
step: jet inspect compiler lex escape.jet
exit: 0
json: stdout doc $.compiler.value.diagnostics[?code="E0001"][0].span = {"file":"escape.jet","start":23,"end":25}
json: stdout doc $.compiler.value.diagnostics[?code="E0001"][0].origin.path = "escape.jet"
json: stdout doc $.compiler.value.diagnostics[?code="E0001"][0].fix_edits #= 0 # a lexer error with no known repair carries an empty list
