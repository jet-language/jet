use event: core.event

Detail: struct {
    text: String
    count: Int
}

// The name of core.event's queue overflow policy, with a payload Core's lacks.
Overflow: enum {
    Spill(Detail)
    Calm
}

spill: fn(text: String) -> Overflow { Overflow.Spill(Detail{text: text, count: text.len()}) }

describe: fn(value: Overflow) -> String {
    if value == {
        .Spill(detail) -> "spill {detail.text} {detail.count}"
        .Calm -> "calm"
    }
}

run: fn() {
    scope: event.scope()
    policy: AsyncPolicy{capacity: 1, overflow: .DropNewest}
    if policy.overflow == .DropNewest -> print("drops newest")
    events: event.async_result<Int, String>(policy, .Collect) ?? panic("policy")
    events.on(scope, fn(n: Int) { print("got {n}") })
    report: events.emit_async(7).join() ?? panic("join")
    print("accepted={report.accepted()}")
    print(describe(spill("own")))
    print(describe(Overflow.Calm))
}
