# Port of tests/pkg.rs:2480-2539; both original phases kept. An unused local
# is now a tidy error, so the first build lists it and fails before its effect
# summary instead of warning.
# PENDING-GRAMMAR(batch-four): mkdir.
fixture: Fixtures/Minimal
mkdir: store
env: JET_PACKAGE_STORE_DIR={work}/store
copy: {root}/Tests/Cases/Pkg/Fixtures/Sources/unused.txt run.jet
step: jet build run.jet
exit: nonzero
stderr: ~ "Error [jet.UnusedLocalBinding]" # a tidy error fails jet build
stderr: ~ "L0101" # original predicate
stderr: !~ "effects:" # the failed build ends before its effect summary
stderr: !~ "E1293" # original predicate
copy: {root}/Tests/Cases/Pkg/Fixtures/Manifests/unused-deny.txt package.jet
step: jet build run.jet
exit: nonzero
stderr: ~ "E1293" # original predicate
stderr: ~ "L0101" # original predicate
stderr: !~ "Warning [jet.UnusedLocalBinding]" # original predicate
