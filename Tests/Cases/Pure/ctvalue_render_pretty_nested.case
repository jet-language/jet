# Compile-time and runtime rendering of a nested struct with a list of strings match across O0, O1, and O2.
fixture: CtvalueRenderPrettyNested.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step o0: jet run -O0 main.jet
exit: 0
stdout: = "Report { total: 42, items: [\"a\", \"b\"] }\n"
step o1: jet run -O1 main.jet
exit: 0
stdout: = "Report { total: 42, items: [\"a\", \"b\"] }\n"
step o2: jet run -O2 main.jet
exit: 0
stdout: = "Report { total: 42, items: [\"a\", \"b\"] }\n"
