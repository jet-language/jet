# The Alloc runtime test fragment (Compiler/JetRuntime/Tests/Fragments.fixture/AllocTests.jet)
# runs as a program under Tests/Fixtures/runtime_fragment_host.c: the plain transport's steps
# (Tools/Agent/CompilerRegistries.jet drive), as in
# the_secret_fragment_runs_as_a_program_and_its_end_scrubs_live_secrets.case. The allocator
# witness inspects slab metadata and so owns the whole heap: the host runs it `isolated`, on
# the attached main thread with no jet_rt_main, whose runtime would hold blocks of its own.
requires: os-name:linux
requires: tool:cc
requires: tool:as
mkdir: native/Source
mkdir: scratch
step unit: jet {root}/Compiler/Toolchain/RuntimePack.jet --root {root}/Compiler unit raw --test Alloc
timeout: 600s
exit: 0
write: glue.jet = "\n#Export(c) jet_rt_plain_fixture: fn() { alloc_tests() }\n"
concat: native/Source/Fixture.jet raw/unit.jet glue.jet
copy: raw/package.jet native/package.jet
copy: {root}/Compiler/JetRuntime/lifecycle.list lifecycle.full
capture: lifecycle = text file.filter(!^= "jet_rt_alloc_check_init ") lifecycle.full
write: native/lifecycle.list = "{cap:lifecycle}\n"
step library: jet doc {work}/native/Source/Fixture.jet
cwd: native/Source
env: JET_FRONT_LIBRARY_OBJECT_OUTPUT={work}/native/fixture
env: JET_FRONT_LIBRARY_LIFECYCLE={work}/native/lifecycle.list
timeout: 1800s
exit: 0
file: native/fixture.issues absent # the front lowered every function of the unit
file: native/fixture.o exists
write: fault-report.S = "    .text\n    .globl jet_rt_fault_report\n    .type jet_rt_fault_report, @function\njet_rt_fault_report:\n    .include \"{root}/Compiler/JetRuntime/Assets/FaultReport/report.S\"\n    .size jet_rt_fault_report, . - jet_rt_fault_report\n    .section .note.GNU-stack,\"\",@progbits\n"
step: as --64 -o fault-report.o fault-report.S
exit: 0
step: cc -std=c11 -Wall -Wextra -Werror {root}/Tests/Fixtures/runtime_fragment_host.c native/fixture.o fault-report.o -lpthread -ldl -lm -o fragment
exit: 0
step run: {work}/fragment isolated
env: TMPDIR={work}/scratch
timeout: 60s
exit: 0
stdout: = "alloc tests: ok\n"
stderr: empty
# Under an address-space limit below the region window's 16 GiB reservation the
# window is refused, and every region maps on its own: the witness checks that path.
step: {work}/fragment isolated
env: TMPDIR={work}/scratch
limit: memory=4194304
timeout: 60s
exit: 0
stdout: = "alloc tests: ok\n"
stderr: empty
# The host registers its environment before the witness runs, and an entryless
# host's registration indexes it into heap blocks the process keeps
# (HostStartup.jet host_environment_index): 24 bytes of rows per variable and
# one block of every entry's bytes. The witness passes whatever classes those
# take, so it runs under two environments of its own, not the runner's: one
# variable, whose blocks are small, and 111, whose 2664 bytes of rows land in
# class 4096 (more than 2032 bytes, at most 4080), the class the full-slabs
# witness fills.
step: {work}/fragment isolated
env-clear: true
env: TMPDIR={work}/scratch
timeout: 60s
exit: 0
stdout: = "alloc tests: ok\n"
stderr: empty
step: {work}/fragment isolated
env-clear: true
env: TMPDIR={work}/scratch
