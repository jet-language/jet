# Aggregates cost no copies. The named tuples `divmod` (two scalars) and
# `quad` (four) return, once inlined, are scalar-replaced at O1 and O2: their
# fields live in registers. So does `big` (one stack_address before the
# passes, none after): `look` and `consume` are inlined, and its Drop is its
# light glue's inlined member drops (OptGlue.jet), no loan of its storage.
# `big` is read by `look` and moved into `consume` in place: no byte copy.
# Its one String is the literal's clone before the passes and the literal
# itself after them. `grow` is recursive, so it stays a call, and the
# program prints the same values on every tier.
fixture: SmallResultsLiveInRegistersAndLargeValuesMoveByAddress.fixture
env: NO_COLOR=1
step: jet inspect decisions -O1 main.jet
env: JET_OPT_DUMP=run
exit: 0
stdout: ~ "O1:" # optimize: O1 runs the O1 passes
stdout: ~ "scalar-replaced 3," # divmod's and quad's tuples, and big
stdout: count "stack_address" = 1 # big, before the passes; none after
stdout: count "copy_bytes" = 0 # big is read and moved in place, never copied
stdout: count "jet_rt_string_clone" = 1 # the literal's clone before the passes; none after
step: jet inspect decisions --release main.jet
env: JET_OPT_DUMP=run
exit: 0
stdout: ~ "O2:" # --release runs the O2 passes
stdout: ~ "scalar-replaced 3," # divmod's and quad's tuples, and big
stdout: count "stack_address" = 1 # big, before the passes; none after
stdout: count "copy_bytes" = 0 # big is read and moved in place, never copied
stdout: count "jet_rt_string_clone" = 1 # the literal's clone before the passes; none after
step: jet run -O0 main.jet
exit: 0
stdout: = small_results_live_in_registers_and_large_values_move_by_address.out
step: jet run -O1 main.jet
exit: 0
stdout: = small_results_live_in_registers_and_large_values_move_by_address.out
step: jet run -O2 main.jet
exit: 0
stdout: = small_results_live_in_registers_and_large_values_move_by_address.out
step: jet build -O2 main.jet
exit: 0
step aot: built
exit: 0
stdout: = small_results_live_in_registers_and_large_values_move_by_address.out
