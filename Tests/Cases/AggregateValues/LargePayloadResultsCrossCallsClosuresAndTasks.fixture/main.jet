// A `T E!` Result whose payload is a seven-word struct (a 64-byte box, the
// largest a caller's frame holds) crosses a direct call, a closure and a
// task, Ok and Err alike; every tier prints the same sums.
#Error
WideError: enum {
    Negative
}

Wide: struct {
    a: I64
    b: I64
    c: I64
    d: I64
    e: I64
    f: I64
    g: I64
}

wide: fn(x: I64) -> Wide WideError! {
    if x < (I64{0}) -> return Err(WideError.Negative)
    Ok(Wide{a: x, b: wrapping(x * I64{3}), c: wrapping(x + I64{7}), d: x ~ I64{85}, e: wrapping(x - I64{2}), f: wrapping(x * x), g: I64{11}})
}

sum: fn(w: Wide) -> I64 {
    wrapping(w.a + wrapping(w.b + wrapping(w.c + wrapping(w.d + wrapping(w.e + wrapping(w.f + w.g))))))
}

zero: fn() -> Wide {
    Wide{a: I64{0}, b: I64{0}, c: I64{0}, d: I64{0}, e: I64{0}, f: I64{0}, g: I64{0}}
}

called: fn(n: Int) -> I64 Never! {
    total := I64{0}
    step := wrapping(I64{0} - I64{2})
    loop _ in 0..<n {
        got: wide(step) ?? zero()
        total = wrapping(total + sum(got))
        step = wrapping(step + I64{1})
    }
    total
}

closed: fn(n: Int) -> I64 {
    bias: I64{3}
    make: fn(x: I64) -> Wide WideError! { wide(wrapping(x - bias)) }
    total := I64{0}
    step := I64{0}
    loop _ in 0..<n {
        got: make(step) ?? zero()
        total = wrapping(total + sum(got))
        step = wrapping(step + I64{1})
    }
    total
}

tasked: fn(n: Int) -> I64 {
    total := I64{0}
    task.group pool(limit: 2) {
        first: task called(n)
        second: task called(n + 3)
        total = wrapping((first.join() ?? I64{0}) + (second.join() ?? I64{0}))
    }
    total
}

run: fn() {
    print("called {called(6)}")
    print("closed {closed(6)}")
    print("tasked {tasked(6)}")
}
