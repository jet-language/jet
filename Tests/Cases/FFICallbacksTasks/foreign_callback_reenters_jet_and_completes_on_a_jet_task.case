# The C dependency is a source directory (deps callback: c@"c"), which jet build compiles and links with its own toolchain, so no host C compiler or archiver is required.
# C calls a named Jet function and a lambda from a thread of its own, then a Jet task calls C, which does its work on another C thread.
requires: os:unix
fixture: ForeignCallbackReentersJetAndCompletesOnAJetTask.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = foreign_callback_reenters_jet_and_completes_on_a_jet_task.out
