use core.mem

run: fn() {
    values := {a: 1, b: 2, c: 3, d: 4, e: 5}
    list := [Int]{9}
    #Unsafe("every raw range stays inside the `values` tuple, which outlives each access") {
        first: mem.Ptr<Int>.from_addr(mem.address_of(values))
        grew: mem.list_append<Int>(list, first, 5)
        none: mem.list_append<Int>(list, first, 0)
        refused: mem.list_append<Int>(list, first, -1)
        print("{grew} {none} {refused} {list}")
        mem.list_copy<Int>(first.offset(1), list, 3, 3)
        mem.list_copy<Int>(first, list, 6, 0)
        print("{values.a} {values.b} {values.c} {values.d} {values.e}")
    }
    many := [Int]{1, 2, 3}
    #Unsafe("each append reads the Ints `many` holds, which move before their old buffer goes") {
        loop _ in 0..<4 {
            count: many.len()
            own: mem.Ptr<Int>.from_addr(mem.address_of(many[0]))
            _: mem.list_append<Int>(many, own, count)
        }
    }
    print("{many.len()} {many[0]} {many[22]} {many[47]}")
    names := {a: "left", b: "right"}
    words := [String]{"start"}
    #Unsafe("both ranges stay inside `names`; every String is a static text, which needs no single owner") {
        name: mem.Ptr<String>.from_addr(mem.address_of(names))
        _: mem.list_append<String>(words, name, 2)
        mem.list_copy<String>(name, words, 0, 1)
    }
    print("{words[0]} {words[1]} {words[2]} {names.a} {names.b}")
}
