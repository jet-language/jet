use core.mem

run: fn() {
    ^cell: {a: 1, b: 2}
    ^list: [Int]{}
    #Unsafe("the append reads one Int past the tuple, so the sentry stops it before the List changes") {
        first: mem.Ptr<Int>.from_addr(mem.address_of(cell))
        print(list.len())
        _: mem.list_append<Int>(list, first, 3)
        print(list.len())
    }
}
