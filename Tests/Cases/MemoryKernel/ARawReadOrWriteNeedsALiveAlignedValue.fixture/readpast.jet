use core.mem

run: fn() {
    #Unsafe("the read takes the Int just past the block") {
        block: mem.alloc_raw(16, 8) ?? panic("no memory")
        words: block.cast<Int>()
        mem.volatile_write<Int>(words, 4)
        print(mem.volatile_read<Int>(words))
        print(mem.volatile_read<Int>(words.offset(2)))
        mem.free_raw(block)
    }
}
