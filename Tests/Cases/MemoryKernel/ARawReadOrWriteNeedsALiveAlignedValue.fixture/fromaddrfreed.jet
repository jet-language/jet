use core.mem

run: fn() {
    #Unsafe("the address names an Int of a block already released") {
        block: mem.alloc_raw(16, 8) ?? panic("no memory")
        address: mem.address_of(block.*)
        mem.volatile_write<Int>(block.cast<Int>(), 6)
        print(mem.Ptr<Int>.from_addr(address).*)
        mem.free_raw(block)
        print(mem.Ptr<Int>.from_addr(address).*)
    }
}
