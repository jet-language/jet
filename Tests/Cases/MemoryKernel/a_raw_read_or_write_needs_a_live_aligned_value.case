# `mem.volatile_read` and `mem.volatile_write` of a value of a live raw block,
# and a pointer remade from that value's address with `Ptr.from_addr`, read
# and store it on every tier. Each stated precondition is checked before the
# access: a misaligned read is a located R0803 fault, a read or write of the
# Int just past the block is a located R0801 fault, and a read through a
# pointer, or a remade address, of a released block is a located R0802 fault.
fixture: ARawReadOrWriteNeedsALiveAlignedValue.fixture
env: NO_COLOR=1
step check: jet check main.jet
exit: 0
step o0: jet run -O0 main.jet
exit: 0
stdout: = "1 8 15\n1 40 40\n40\n"
step o1: jet run -O1 main.jet
exit: 0
stdout: = "1 8 15\n1 40 40\n40\n"
step o2: jet run -O2 main.jet
exit: 0
stdout: = "1 8 15\n1 40 40\n40\n"
when tool node
step: jet build --target web main.jet
exit: 0
file: .jet/build/app.wasm is-file
step: node app.js
cwd: .jet/build
exit: 0
stdout: = "1 8 15\n1 40 40\n40\n"
end when
step misalignednone: jet run -O0 misaligned.jet
exit: 70
stderr: ~ "Error: Jet.MisalignedRawAccess:" # the report also carries the gate and how far the address sits past the boundary
stderr: ~ "misaligned.jet:7:19, in #Unsafe gate" # the fault is located at the misaligned read
stderr: ~ "the address is a multiple of 8 plus 1, so it is not aligned to 8 bytes." # the read starts one byte into the block
step misalignedfull: jet run -O2 misaligned.jet
exit: 70
stderr: ~ "Error: Jet.MisalignedRawAccess:" # the report also carries the gate and how far the address sits past the boundary
stderr: ~ "misaligned.jet:7:19, in #Unsafe gate" # the fault is located at the misaligned read
stderr: ~ "the address is a multiple of 8 plus 1, so it is not aligned to 8 bytes." # the read starts one byte into the block
step readpastnone: jet run -O0 readpast.jet
exit: 70
stdout: = "4\n"
stderr: ~ "Error: Jet.RawAccessOutsideProvenance:" # the report also carries the gate and the obligation
stderr: ~ "readpast.jet:9:19, in #Unsafe gate" # the fault is located at the read past the block
stderr: ~ "raw `volatile_read` outside" # the gate's audit text follows
stderr: ~ "the access starts at offset 16 of the live range 0x" # the range's addresses vary with ASLR
stderr: ~ "(16 bytes) and runs past its end" # the block's two Ints
step readpastfull: jet run -O2 readpast.jet
exit: 70
stdout: = "4\n"
stderr: ~ "Error: Jet.RawAccessOutsideProvenance:" # the report also carries the gate and the obligation
stderr: ~ "readpast.jet:9:19, in #Unsafe gate" # the fault is located at the read past the block
stderr: ~ "(16 bytes) and runs past its end" # the block's two Ints
step writepastnone: jet run -O0 writepast.jet
exit: 70
stdout: = "4\n"
stderr: ~ "Error: Jet.RawAccessOutsideProvenance:" # the report also carries the gate and the obligation
stderr: ~ "writepast.jet:9:13, in #Unsafe gate" # the fault is located at the write past the block
stderr: ~ "raw `volatile_write` outside" # the gate's audit text follows
stderr: ~ "the access starts at offset 16 of the live range 0x" # the range's addresses vary with ASLR
stderr: ~ "(16 bytes) and runs past its end" # the block's two Ints
step writepastfull: jet run -O2 writepast.jet
exit: 70
stdout: = "4\n"
stderr: ~ "Error: Jet.RawAccessOutsideProvenance:" # the report also carries the gate and the obligation
stderr: ~ "writepast.jet:9:13, in #Unsafe gate" # the fault is located at the write past the block
stderr: ~ "(16 bytes) and runs past its end" # the block's two Ints
step readfreednone: jet run -O0 readfreed.jet
exit: 70
stdout: = "4\n"
stderr: ~ "Error: Jet.UseAfterLifetime:" # the report also carries the gate and the obligation
stderr: ~ "readfreed.jet:10:19, in #Unsafe gate" # the fault is located at the read after release
stderr: ~ "before this raw `volatile_read`" # the access the released storage refused
step readfreedfull: jet run -O2 readfreed.jet
exit: 70
stdout: = "4\n"
stderr: ~ "Error: Jet.UseAfterLifetime:" # the report also carries the gate and the obligation
stderr: ~ "readfreed.jet:10:19, in #Unsafe gate" # the fault is located at the read after release
step fromaddrfreednone: jet run -O0 fromaddrfreed.jet
exit: 70
stdout: = "6\n"
stderr: ~ "Error: Jet.UseAfterLifetime:" # the report also carries the gate and the obligation
stderr: ~ "fromaddrfreed.jet:10:15, in #Unsafe gate" # the fault is located at the read through the remade address
stderr: ~ "before this raw `read`" # the access the released storage refused
step fromaddrfreedfull: jet run -O2 fromaddrfreed.jet
exit: 70
stdout: = "6\n"
stderr: ~ "Error: Jet.UseAfterLifetime:" # the report also carries the gate and the obligation
stderr: ~ "fromaddrfreed.jet:10:15, in #Unsafe gate" # the fault is located at the read through the remade address
