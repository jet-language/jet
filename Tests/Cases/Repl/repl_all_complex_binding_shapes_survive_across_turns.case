# Typed list, map and optional literals, a fallible call's fallback and an
# enum payload each bind in one turn and read back in the next.
fixture: ReplAllComplexBindingShapesSurviveAcrossTurns.fixture
step: jet repl
env: NO_COLOR=1
env: XDG_STATE_HOME={work}/state
stdin: ReplAllComplexBindingShapesSurviveAcrossTurns.fixture/input.txt
exit: any # original library predicates did not assert process status
stderr: !~ "Error" # every turn is accepted
stdout|stderr: ~ "\"jet\" : String" # original expected loop predicate
stdout|stderr: ~ "2 : Int" # original expected loop predicate
stdout|stderr: ~ "7 : Int" # original expected loop predicate
stdout|stderr: ~ "9 : Int" # original expected loop predicate
stdout|stderr: ~ "11 : Int" # original expected loop predicate
