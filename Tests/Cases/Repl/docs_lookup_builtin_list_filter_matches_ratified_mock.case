# `?List.filter` prints the language catalog's page for the method: its
# signature right after the prompt, its summary, where it comes from and its
# example.
fixture: DocsLookupBuiltinListFilterMatchesRatifiedMock.fixture
step: jet repl
env: NO_COLOR=1
env: XDG_STATE_HOME={work}/state
stdin: DocsLookupBuiltinListFilterMatchesRatifiedMock.fixture/input0.txt
exit: 0
stdout: line ^= "1 user> List.filter(f: fn(T) -> Bool) -> [T]" # the prompt, then the page's signature
stdout: line ^= "Keeps items where f(item) is true." # the summary on its own line
stdout: line ^= "Source: core.collections" # the module the method comes from
stdout: line ^= "Example: items.filter(fn(item) { item.active })" # the catalog's example
stderr: !~ "Error" # the page is no refusal
