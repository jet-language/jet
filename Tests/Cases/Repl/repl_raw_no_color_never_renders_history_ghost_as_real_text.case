# PORT tests/repl.rs:2824-2840, helper343-357 where used; exact bytes/predicates, no reference snapshot.
# PENDING-SEAM(pty); runtime PENDING-SAME-HEAD.
# Each key waits for the prompt it answers, not for a time, so the transcript
# does not depend on how fast a turn evaluates. The ghost predicate is a
# negative one that a REPL with no history ghost at all also holds, so the
# case first requires the REPL to own the terminal in raw mode: the cooked
# line loop says "interactive keys require a TTY" and never draws a ghost.
env: NO_COLOR=1
requires: os:unix
env: JET_REPL_HISTORY=off
session repl raw: jet repl
pty: true
recv repl until ~ "1 user> " within 30s # the first prompt
stdout: !~ "interactive keys require a TTY" # the raw line editor runs, the one that draws history ghosts
pty-send: "^alphabet: 1\r" after 0ms
recv repl until ~ "2 user> " within 30s # the first turn is answered
pty-send: "a" after 0ms
pty-send: "\u0003" after 0ms
pty-send: ":quit\r" after 0ms
close repl
exit: 0
stdout: !~ "^alphabet: 1" # Original rsplit(last) rs2835-2838: after the second prompt, typing `a` shows no ghost `^lphabet: 1` as real text.
