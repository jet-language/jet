# A query held in a binding (no `Display`) plans and collects in later turns,
# an inner join keeps every duplicate match, and a left join keeps an
# unmatched left row with a `null` right.
fixture: ReplCoreDataQueryPlansAndTypedJoins.fixture
step: jet repl
env: NO_COLOR=1
env: XDG_STATE_HOME={work}/state
stdin: ReplCoreDataQueryPlansAndTypedJoins.fixture/input0.txt
stdout: file transcript.out
stderr: file transcript.err
exit: any # the line count step asserts the join rows
stdout: ~ "[scan, filter] : [String]" # a held query's plan
stdout: ~ "[2, 3] : [Int]" # a held query collects
stdout: ~ "DataJoin { left: 2, right: null }" # an unmatched left row keeps a null right
stderr: !~ "Error" # every turn is accepted
step: jet run line_count.jet
exit: 0
