# `?math.sqrt` after `use math: core.math` resolves the alias to the Core
# module and prints the function's declaration as Core writes it, then where it
# comes from.
fixture: ReplDocsResolveImportedCoreModuleMember.fixture
step: jet repl
env: NO_COLOR=1
env: XDG_STATE_HOME={work}/state
stdin: ReplDocsResolveImportedCoreModuleMember.fixture/input.txt
exit: 0
stdout: ~ "core.math.sqrt: fn(n: Float) -> Float" # the declaration, named by its module
stdout: line ^= "Source: core.math" # the module the alias names
stderr: !~ "Error" # the page is no refusal
