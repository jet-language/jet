# PORT tests/repl.rs:3425-3466; verbatim inputs and original predicate forms.
# PENDING-SAME-HEAD; PENDING-GRAMMAR(batch-four); no blessed snapshots.
# Banner/prompt non-overlap: crates/jet-repl/src/Render.rs24-37,67-74; stderr discovery41-61.
# lib.rs2469-2470 cooked floor mirrors transcript. No stripping/projection.
fixture: ReplCoreDataSchemaEmptyListsAndRowLaw.fixture
# Takes about 20 s alone and over 60 s under full-kit load, so it has this timeout until its cost is cut.
step: jet repl
timeout: 180s
env: NO_COLOR=1
env: XDG_STATE_HOME={work}/state
stdin: ReplCoreDataSchemaEmptyListsAndRowLaw.fixture/input.txt
exit: any # original library predicates did not assert process status
stdout: !~ "Jet.ComptimeConstructNotSupported" # original predicate
stderr: !~ "Jet.ComptimeConstructNotSupported" # original predicate
stdout|stderr: ~ "DataColumn(name: team, type_name: String)" # original predicate
stdout|stderr: ~ "DataColumn(name: minutes, type_name: Float)" # original predicate
stdout|stderr: ~ "DataColumn(name: value, type_name: Float)" # original predicate
stdout|stderr: ~ "[] : List" # original predicate
stdout|stderr: ~ "DataColumn(name: value, type_name: Int)" # original predicate
