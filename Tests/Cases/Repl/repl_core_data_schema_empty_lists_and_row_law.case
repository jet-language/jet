# `data.schema` reads a row's columns from its checked type, so an empty list
# still describes them; a scalar row, an exact number included, is one
# `value` column; a struct with no fields has no columns.
fixture: ReplCoreDataSchemaEmptyListsAndRowLaw.fixture
# Takes about 20 s alone and over 60 s under full-kit load, so it has this timeout until its cost is cut.
step: jet repl
timeout: 180s
env: NO_COLOR=1
env: XDG_STATE_HOME={work}/state
stdin: ReplCoreDataSchemaEmptyListsAndRowLaw.fixture/input.txt
exit: any # original library predicates did not assert process status
stderr: !~ "Error" # every turn is accepted
stdout: ~ "name: team, type_name: String, nullable: false" # an empty row list keeps its columns
stdout: ~ "name: minutes, type_name: Float, nullable: false" # a field's checked type
stdout: ~ "[DataColumn { id: column-14003a0a1e31681e, name: value, type_name: Decimal, nullable: false }] : [DataColumn]" # a bare `1.0` is a Decimal scalar row; the id hashes `5:value:Decimal`
stdout: ~ "[] : [DataColumn]" # a struct with no fields has no columns
stdout: ~ "name: value, type_name: Int, nullable: false }] : [DataColumn]" # a generic row substitutes its argument
