# An empty typed list echoes, and a query over it, a value with no `Display`,
# still runs and shows its type without exposing compile-time metadata.
fixture: ReplCoreDataListQueryEchoHidesComptimeMetadata.fixture
step: jet repl
env: NO_COLOR=1
env: XDG_STATE_HOME={work}/state
stdin: ReplCoreDataListQueryEchoHidesComptimeMetadata.fixture/input.txt
exit: 0
stderr: !~ "Error" # every turn is accepted
stdout: ~ "[] : [Ticket]" # an empty typed list
stdout: ~ "(a value with no Display) : Query<Ticket>" # a value with no Display shows its type
stdout: !~ "elem_type:" # no compile-time metadata
