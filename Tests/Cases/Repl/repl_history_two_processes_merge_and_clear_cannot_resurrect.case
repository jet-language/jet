# PORT tests/repl.rs:241-295 plus helpers13-62/343-357; original inputs/predicates, no reference snapshot.
# Runtime PENDING-SAME-HEAD.
fixture: ReplHistoryTwoProcessesMergeAndClearCannotResurrect.fixture
env: NO_COLOR=1
env: XDG_STATE_HOME={work}/state
session first raw: jet repl
unset: JET_REPL_HISTORY
session second raw: jet repl
unset: JET_REPL_HISTORY
await: dir state/jet timeout 2s every 10ms
sleep: 50ms
parallel
send first: ReplHistoryTwoProcessesMergeAndClearCannotResurrect.fixture/left.in
send second: ReplHistoryTwoProcessesMergeAndClearCannotResurrect.fixture/right.in
end parallel
close first
exit: 0
close second
exit: 0
step: jet repl
unset: JET_REPL_HISTORY
stdin: ReplHistoryTwoProcessesMergeAndClearCannotResurrect.fixture/merged.in
exit: any # Original merged search status unasserted rs258-267.
stdout: ~ "left_marker: 1" # Original merged pair conjunction rs265.
stdout: ~ "right_marker: 2" # Original merged pair conjunction rs265.
session stale raw: jet repl
unset: JET_REPL_HISTORY
await: dir state/jet timeout 2s every 10ms
sleep: 50ms
step: jet repl
unset: JET_REPL_HISTORY
stdin: ReplHistoryTwoProcessesMergeAndClearCannotResurrect.fixture/clear.in
exit: 0
send stale: ReplHistoryTwoProcessesMergeAndClearCannotResurrect.fixture/fresh.in
close stale
exit: 0
step: jet repl
unset: JET_REPL_HISTORY
stdin: ReplHistoryTwoProcessesMergeAndClearCannotResurrect.fixture/after.in
exit: any # Original after-clear search status unasserted rs280-292.
stdout: ~ "fresh_marker: 3" # Original fresh write rs287.
stdout: !~ "left_marker: 1" # Original cleared pair conjunction rs291.
stdout: !~ "right_marker: 2" # Original cleared pair conjunction rs291.
