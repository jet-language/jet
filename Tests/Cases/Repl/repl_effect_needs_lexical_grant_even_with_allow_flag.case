# A written `#FX` boundary is a ceiling even when `--allow=FS` grants the
# session the right: a write inside `#FX(authority: Time)` is refused before
# the file exists.
fixture: ReplEffectNeedsLexicalGrantEvenWithAllowFlag.fixture
mkdir: project
step: jet repl --project {work}/project --allow=FS
env: NO_COLOR=1
env: XDG_STATE_HOME={work}/state
stdin: ReplEffectNeedsLexicalGrantEvenWithAllowFlag.fixture/input0.txt
exit: any # a refused turn's piped session status is asserted by the deny rows
stderr: ~ "Jet.EffectWithoutAuthority" # the boundary, not the session, refuses the write
stderr: ~ "allows only `Time`" # the refusal names the ceiling
file: project/no.txt absent
