# A `--deny` right refuses both a draw and a mutating shuffle inside an
# `#FX(authority: Rand)` block, and the list stays as it was.
fixture: ReplDenyRandBlocksDrawAndMutatingShuffle.fixture
step: jet repl --deny=Rand
env: NO_COLOR=1
env: XDG_STATE_HOME={work}/state
stdin: ReplDenyRandBlocksDrawAndMutatingShuffle.fixture/input0.txt
exit: any # original library predicates did not assert process status
stdout|stderr: ~ "Application authority denies `Rand`" # the deny names the refused right
stdout|stderr: ~ "[1, 2, 3] : [Int]" # the refused shuffle left the list unchanged
stdout+stderr: count "Jet.ApplicationAuthorityDenied:" >= 2 # the draw and the shuffle are each refused
