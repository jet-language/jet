# A struct value, a function with a return type and a list keep their types
# across turns.
fixture: ReplComplexBindingsKeepExactTypedASTAcrossTurns.fixture
step: jet repl
env: NO_COLOR=1
env: XDG_STATE_HOME={work}/state
stdin: ReplComplexBindingsKeepExactTypedASTAcrossTurns.fixture/input.txt
exit: any # original library predicates did not assert process status
stderr: !~ "Error" # every turn is accepted
stdout|stderr: ~ "7 : Int" # original predicate
stdout|stderr: ~ "5 : Int" # original predicate
stdout|stderr: ~ "\"repl\" : String" # original predicate
