# A project row type decodes JSON, keeps its schema, filters through a query
# and reports the native JSON step in the file data status table.
fixture: ReplCoreDataJSONIngestAndSelect.fixture
mkdir: project
copy: model.jet project/model.jet
step: jet repl --project {work}/project
env: NO_COLOR=1
env: XDG_STATE_HOME={work}/state
stdin: ReplCoreDataJSONIngestAndSelect.fixture/input0.txt
exit: any # original library predicates did not assert process status
stderr: !~ "Error" # every turn is accepted
stdout: ~ "name: team, type_name: String, nullable: false" # the decoded row's columns
stdout: ~ "name: minutes, type_name: Float, nullable: false" # the decoded row's columns
stdout: ~ "2 : Int" # the filtered count
stdout: ~ "DataStatus { step: core.data.json, path: native" # the JSON step runs natively
