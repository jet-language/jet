// The copy of checked.jet inside `#Policy(sentries: .Off)`: the block runs
// without the sentry's check, so the four Ints land in the buffer, three
// over the list's items and one in its spare capacity.
use core.mem

run: fn() {
    ^target: [Int]{}
    loop i in 0..<8 -> target.push(i)
    loop _ in 0..<5 -> _: target.pop()
    values: [Int]{10, 11, 12, 13}
    #Unsafe("target's buffer holds eight Ints: its three items and spare capacity past them") {
        #Policy(sentries: .Off) {
            to: mem.Ptr<Int>.from_addr(mem.address_of(target[0]))
            mem.list_copy<Int>(to, values, 0, 4)
        }
    }
    print("{target.len()} items: {target[0]} {target[1]} {target[2]}")
}
