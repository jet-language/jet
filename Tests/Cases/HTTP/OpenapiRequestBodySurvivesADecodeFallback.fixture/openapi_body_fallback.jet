use {
    server: core.http.server
    web: core.web
}

#Codable
Ping: struct {
    text: String,
}

#Codable
Order: struct {
    count: Int,
}

run: fn() {
    app: web.app()
        .post("/ping", fn(request: HTTPRequest) {
            ping: request.json<Ping>()
            Ok(server.response(200, ping.text))
        })
        .post("/orders", fn(request: HTTPRequest) {
            order: request.json<Order>() ?? return Ok(server.response(400, "not an order"))
            Ok(server.response(201, "{order.count}"))
        })
    schema: web.openapi(app) ?? panic("openapi: {err}")
    // `/orders` sorts before `/ping`, so the text before the `/ping` key
    // holds the `/orders` operation and the text after it the `/ping` one.
    parts: schema.split("\"/ping\"").to_list()
    if parts.len() != 2 || !parts[0].contains("\"/orders\"") -> panic("unexpected paths: {schema}")
    orders: parts[0]
    ping: parts[1]
    print(ping.contains("\"requestBody\"") && ping.contains("\"text\""))
    print(orders.contains("\"requestBody\"") && orders.contains("\"count\""))
}
