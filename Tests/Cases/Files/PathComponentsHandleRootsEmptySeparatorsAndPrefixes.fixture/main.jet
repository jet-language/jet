package: {
    name: "main"
    authority: { allow: [IO] }
}

use path: core.files.path

row: fn(raw: String) {
    p: path.of(raw)
    pieces: path.parts(p)
    ^joined: ""
    loop piece in pieces -> joined = "{joined}<{piece}>"
    print("{raw:Debug} parts=[{joined}] root={path.root(p):Debug} anchor={path.anchor(p):Debug} drive={path.drive(p):Debug} abs={path.is_absolute(p)} rel={path.is_relative(p)} rebuilt={path.from_parts(pieces).raw:Debug}")
}

run: fn() {
    row("/")
    row("/a/b")
    row("a/b")
    row("")
    row(".")
    row("./a")
    row("a/../b")
    row("a//b/")
    row("//srv/share/x")
    row("C:\\x\\y")
    row("C:x")
}
