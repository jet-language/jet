# A caller's frame whose call lowering made: `xs.map(...)` is lowered in
# place, so `run` calls the lambda itself and no source call names that
# call. The call carries the call-site row of the node whose lowering made
# it, the `map` call, at the method's name, so
# `stackTrace` shows the caller's frame at that call's line and column, and
# `evaluate` in that frame is checked just before that node: `total` and
# `xs` are in scope, the loop's `v` is not. The fixture must stay in jet fmt
# form: line 4 is the loop, its `map` at column 18, and line 5 the lambda's
# body. No other debugger is on PATH.
fixture: LoopPull.fixture
env: NO_COLOR=1
env: PATH={work}/no-tools
session dap content-length: jet debug --dap {work}/prog.jet
send dap: "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"adapterID\":\"jet\",\"pathFormat\":\"path\",\"linesStartAt1\":true,\"columnsStartAt1\":true}}"
recv dap until $.request_seq = 1 timeout 30s every 100ms
send dap: "{\"seq\":2,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{\"program\":\"{work}/prog.jet\",\"stopOnEntry\":false,\"args\":[]}}"
recv dap until $.event = "initialized" timeout 30s every 100ms
send dap: "{\"seq\":3,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{\"source\":{\"path\":\"{work}/prog.jet\"},\"breakpoints\":[{\"line\":5}]}}"
recv dap until $.request_seq = 3 timeout 30s every 100ms
json: stdout doc $.body.breakpoints[0].verified = true
send dap: "{\"seq\":4,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{}}"
recv dap until $.event = "stopped" timeout 30s every 100ms
json: stdout doc $.body.reason = "breakpoint"
send dap: "{\"seq\":5,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
recv dap until $.request_seq = 5 timeout 30s every 100ms
json: stdout doc $.body.stackFrames[0].line = 5
json: stdout doc $.body.stackFrames[1].name = "run"
json: stdout doc $.body.stackFrames[1].line = 4
json: stdout doc $.body.stackFrames[1].column = 18
capture: run_frame stdout doc $.body.stackFrames[1].id
send dap: "{\"seq\":6,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"total\",\"frameId\":{cap:run_frame},\"context\":\"repl\"}}"
recv dap until $.request_seq = 6 timeout 30s every 100ms
json: stdout doc $.success = true
json: stdout doc $.body.result = "0"
send dap: "{\"seq\":7,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"xs.len()\",\"frameId\":{cap:run_frame},\"context\":\"repl\"}}"
recv dap until $.request_seq = 7 timeout 30s every 100ms
json: stdout doc $.success = true
json: stdout doc $.body.result = "3"
send dap: "{\"seq\":8,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"v\",\"frameId\":{cap:run_frame},\"context\":\"repl\"}}"
recv dap until $.request_seq = 8 timeout 30s every 100ms
json: stdout doc $.success = false
send dap: "{\"seq\":9,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
recv dap until $.event = "stopped" timeout 30s every 100ms
send dap: "{\"seq\":10,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{\"source\":{\"path\":\"{work}/prog.jet\"},\"breakpoints\":[]}}"
recv dap until $.request_seq = 10 timeout 30s every 100ms
send dap: "{\"seq\":11,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
recv dap collect until ndjson $[?event="terminated"] #>= 1 timeout 30s
stdout: ~ "\"output\":\"12" # the program ran on to its end and printed its sum
stdout: ~ "\"event\":\"exited\"" # and exited
send dap: "{\"seq\":12,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{}}"
recv dap until $.request_seq = 12 timeout 30s every 100ms
close dap
exit: 0
