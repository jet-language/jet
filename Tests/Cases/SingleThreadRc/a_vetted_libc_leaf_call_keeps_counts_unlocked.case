# A foreign call of a vetted libc leaf (`labs` starts no thread,
# installs no handler and calls nothing back) keeps the program single-threaded,
# so its inline reference counts stay unlocked.
fixture: AVettedLibcLeafCallKeepsCountsUnlocked.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet build --release --debug-info=true main.jet
exit: 0
step native: built
exit: 0
stdout: = "6\n"
when arch x86_64
# A release build inlines `run` into its generated entry, main.run__entry,
# which `jet debug --do` lists by its symbol from the image file, without
# starting the program. No disassembler is on PATH.
step: jet debug .jet/build/main --do 'disas main.run__entry'
env: PATH={work}/no-tools
exit: 0
stdout: ^= "main.run__entry  main.jet:" # the entry, by its symbol
stdout: !~ "Breakpoint hit" # read from the file; the program never ran
stdout: ~ "inc    QWORD PTR" # the entry body retains its strings and lists inline
stdout: !~ "lock " # a vetted libc leaf cannot start a second thread
end when
