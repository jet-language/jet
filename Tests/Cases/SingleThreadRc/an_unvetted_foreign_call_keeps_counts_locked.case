# A call into foreign code that is not a vetted libc leaf could
# start a thread or install a handler the compiler cannot see, so the program
# keeps every inline reference count update lock-prefixed.
fixture: AnUnvettedForeignCallKeepsCountsLocked.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet build --release --debug-info=true main.jet
exit: 0
step native: built
exit: 0
stdout: = "6\n"
when arch x86_64
# A release build inlines `run` into its generated entry, main.run__entry,
# which `jet debug` lists by its symbol at the first stop. No disassembler
# is on PATH.
step: jet debug .jet/build/main
env: PATH={work}/no-tools
stdin: disas_entry.stdin
exit: 0
stdout: ~ "(Jet) disas main.run__entry\nmain.run__entry  main.jet:" # the entry, by its symbol
stdout: ~ "lock inc QWORD PTR" # `getpid` is not a vetted libc leaf
stdout: !~ "inc    QWORD PTR" # no count update is unlocked after an unvetted foreign call
end when
