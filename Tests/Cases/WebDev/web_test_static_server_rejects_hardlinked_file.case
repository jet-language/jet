# PENDING-GRAMMAR(batch-four); PENDING-SEAM(read_bytes/DFileRaw).
fixture: WebTestStaticServerRejectsHardlinkedFile.fixture
copy: {root}/Tests/Cases/WebDev/Support.fixture/HTTP.jet claims/HTTP.jet
env: S5_PORT={free-port:web}
requires: os:unix|windows
env: S5_OUTSIDE={work}/outside.js
hardlink: outside.js root/hard.js
session app raw: jet run --allow=Env,FS,IO,Net,Time {root}/Tools/WebTest/Serve.jet -- --port {free-port:web} --root {work}/root
stdout: null
stderr: null
step: jet test claims
exit: 0
signal app: KILL
close app
exit: any # original KillOnDrop ignores child status
