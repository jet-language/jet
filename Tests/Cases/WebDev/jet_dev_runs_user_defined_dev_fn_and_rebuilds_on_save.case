# PENDING-GRAMMAR(batch-four); PENDING-SEAM(read_bytes/DFileRaw).
fixture: JetDevRunsUserDefinedDevFnAndRebuildsOnSave.fixture
copy: {root}/Tests/Cases/WebDev/Support.fixture/HTTP.jet claims/HTTP.jet
env: S5_PORT={free-port:web}
