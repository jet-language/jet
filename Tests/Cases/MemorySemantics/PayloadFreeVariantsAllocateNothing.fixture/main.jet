// A payload-free variant of an enum whose other variants carry a payload
// holds nothing a value could change, so building one borrows a static box
// instead of allocating one. A million of them in a list cost about the
// list's own 8-byte slot each in resident memory (its growth adds a few
// more), under 24 bytes apiece, where a block apiece made them about 50.
// The churn scenario writes new variants over payload-free ones through a
// write window and an index, copies and drops them, generic instances
// included, and panics when a value reads wrong or the peak RSS grows with
// the round count.
package: {
    name: "payload_free_variants_allocate_nothing"
    authority: { allow: [FS.Read, IO] }
}

use files: core.files

// Grows more than this (kB) over the measured rounds: a leak.
GROWTH_KB: 8192

COUNT: 1000000

Shape: enum {
    Point,
    Circle(radius: Int),
    Label(text: String),
    Empty,
}

Tree: enum<T> {
    Leaf,
    Node(value: T, left: Tree<T>, right: Tree<T>),
}

status_kb: fn(field: String) -> Int {
    status: files.read("/proc/self/status") ?? panic("read /proc/self/status")
    loop line in status.split("\n") {
        if !line.starts_with(field) -> next
        loop part in line.slice(field.len(), line.len()).trim().split(" ") {
            if part.len() > 0 -> return Int.parse(part.copy()) ?? panic("{field} field")
        }
    }
    panic("no {field} line")
}

weight: fn(shape: Shape) -> Int {
    if shape == {
        .Point -> 1
        .Circle(radius) -> radius
        .Label(text) -> text.len()
        .Empty -> 3
    }
}

point_or_empty: fn(i: Int) -> Shape { if i % 2 == 0 -> Shape.Point else -> Shape.Empty }

no_allocation_per_variant: fn() {
    warm := [Shape]{}
    loop i in 0..<1000 -> warm.push(point_or_empty(i))
    shapes := [Shape]{}
    before: status_kb("VmRSS:")
    loop i in 0..<COUNT -> shapes.push(point_or_empty(i))
    grown: status_kb("VmRSS:") - before
    total := 0
    loop shape in shapes -> total += weight(shape)
    if total != 2 * COUNT -> panic("payload-free variants weigh {total}")
    per_value: grown * 1024 /% COUNT
    if per_value >= 24 -> panic("a payload-free variant costs {per_value} bytes: it allocates")
    print("payload-free variants: {shapes.len()}, no allocation each, warm {warm.len()}")
}

grow: fn(shape: &Shape, by: Int) {
    if shape == .Point -> shape = Shape.Circle{radius: by}
}

insert: fn(tree: Tree<Int>, value: Int) -> Tree<Int> {
    if tree == .Node(here, left, right) {
        if value < here {
            return Tree<Int>.Node{value: here, left: insert(left, value), right: right}
        }
        return Tree<Int>.Node{value: here, left: left, right: insert(right, value)}
    }
    Tree<Int>.Node{value: value, left: Tree<Int>.Leaf, right: Tree<Int>.Leaf}
}

tree_sum: fn(tree: Tree<Int>) -> Int {
    if tree == {
        .Leaf -> 0
        .Node(value, left, right) -> value + tree_sum(left) + tree_sum(right)
    }
}

churn: fn(from: Int, to: Int) -> Int {
    total := 0
    loop i in from..<to {
        shapes := [Shape]{Shape.Point, Shape.Empty, Shape.Point, Shape.Label{text: "l{i % 10}"}}
        kept: shapes.copy()
        grow(shapes[0], i % 9 + 2)
        shapes[1] = Shape.Circle{radius: 5}
        shapes[2] = Shape.Empty
        if weight(kept[0]) != 1 || weight(kept[1]) != 3 || weight(kept[2]) != 1 {
            panic("a write over a payload-free variant showed in a copy")
        }
        if weight(shapes[0]) != i % 9 + 2 || weight(shapes[1]) != 5 || weight(shapes[2]) != 3 {
            panic("a written variant reads wrong")
        }
        tree := Tree<Int>.Leaf
        values: [Int]{i % 5, i % 3, i % 7}
        loop value in values -> tree = insert(tree, value)
        copied: tree.copy()
        tree = Tree<Int>.Leaf
        if tree_sum(tree) != 0 || tree_sum(copied) != i % 5 + i % 3 + i % 7 {
            panic("a tree of shared leaves sums wrong")
        }
        loop shape in shapes -> total += weight(shape)
        loop shape in kept -> total += weight(shape)
        total += tree_sum(copied)
    }
    total
}

measure: fn(warm: Int) {
    first: churn(0, warm)
    before: status_kb("VmHWM:")
    second: churn(warm, 9 * warm)
    grown: status_kb("VmHWM:") - before
    if grown > GROWTH_KB -> panic("peak RSS grew {grown} kB over {8 * warm} rounds")
    print("variants written, copied and dropped: flat, checksum {first + second}")
}

run: fn() {
    no_allocation_per_variant()
    measure(50000)
}
