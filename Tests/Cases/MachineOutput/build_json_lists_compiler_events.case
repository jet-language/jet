# Claim: `jet build --json` lists the compile's public moments under `events` in its one `build.effects` status, named by the compiler.Event registry rows and carrying their payload fields: the entry file parsed, each declaration declared in source order with the declarations it calls, the checked program, the one settled round, the written image emitted, and the finished outcome last. Stdout stays one status object.
# Hand-derived: main.jet declares `double` and then `run`, and `run` calls `double` first. The compile settles in round 1 with no errors.
fixture: BuildJSONListsCompilerEvents.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet build main.jet --json
exit: 0
stdout: lines = 1 # the status is the one machine line
json: stdout doc $.action = "build.effects"
json: stdout doc $.events[0].event = "compiler.parsed" # the load's moments come first
json: stdout doc $.events[0].data.path : string
json: stdout doc $.events[?event="compiler.declared"][0].data.name = "double" # declaration order
json: stdout doc $.events[?event="compiler.declared"][0].data.calls #= 0
json: stdout doc $.events[?event="compiler.declared"][0].data.complete = true
json: stdout doc $.events[?event="compiler.declared"][1].data.name = "run"
json: stdout doc $.events[?event="compiler.declared"][1].data.calls[0] = "double" # first-call order
json: stdout doc $.events[?event="compiler.checked"] #= 1
json: stdout doc $.events[?event="compiler.checked"][0].data.declarations #>= 2
json: stdout doc $.events[?event="compiler.settled"][0].data.round = 1
json: stdout doc $.events[?event="compiler.settled"][0].data.new_items #>= 2
json: stdout doc $.events[-2].event = "compiler.emitted" # the image, written before the compile finishes
json: stdout doc $.events[-2].data.output = "main"
json: stdout doc $.events[-2].data.path : string
json: stdout doc $.events[-2].data.next = ""
json: stdout doc $.events[-1].event = "compiler.finished" # the outcome is last
json: stdout doc $.events[-1].data.ok = true
json: stdout doc $.events[-1].data.errors = 0
step plain: jet build main.jet
exit: 0
stdout: !~ compiler.parsed # only `--json` records the moments
