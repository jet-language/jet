// Checks that the schema `$JET inspect events --schema` prints matches the
// compiler event rows of the checkout named by the first argument. The schema
// must list each moment in row order with its event name and payload, and
// nothing past them. Each payload must be a closed object that requires its
// row's fields, with their types. Prints one line per departure and exits 1,
// else prints how many rows match.
use {
    check_files: core.files
    check_json: core.encoding.json
    check_process: core.process
}

CHECK_ROWS_PATH: "Compiler/JetFoundation/Source/Registry/CompilerEvents.jet"

// The text between `open` and the next `close` after it in `line`, or "".
check_between: fn(line: String, open: String, close: String) -> String {
    after: (line.split_once(open) ?? return "").after
    (after.split_once(close) ?? return "").before
}

// The moments the rows list, as `name variant payload`, in row order.
check_rows: fn(text: String) -> [String] {
    ^names: [String:String]{}
    ^rows: [String]{}
    loop line in text.lines() {
        if line.starts_with("COMPILER_EVENT_") && line.contains(": \"") {
            parts: line.split_once(": ") ?? next
            names[parts.before] = parts.after.trim().removeprefix("\"").removesuffix("\"")
        }
        if line.trim().starts_with("CompilerEvent{{name: ") {
            name: names.get(check_between(line, "name: ", ",")) ?? "<unknown constant>"
            rows.push("{name} {check_between(line, "variant: \"", "\"")} {check_between(line, "payload: \"", "\"")}")
        }
    }
    rows
}

// The payload rows, as `Payload: field Type, field Type`, in row order. A
// payload row opens with `CompilerEventPayload{`, names its struct on the
// next `name:` line, and lists one `CompilerEventField{…}` per line.
check_payload_rows: fn(text: String) -> [String] {
    ^rows: [String]{}
    ^current: ""
    ^opened: false
    ^fields: [String]{}
    loop line in text.lines() {
        word: line.trim()
        if {
            word.starts_with("CompilerEventPayload{{") -> {
                if current != "" -> rows.push("{current}: {fields.join(", ")}")
                current = ""
                opened = true
                fields = [String]{}
            }
            opened && word.starts_with("name: \"") -> {
                current = check_between(word, "name: \"", "\"")
                opened = false
            }
            word.starts_with("CompilerEventField{{name: ") -> {
                fields.push("{check_between(word, "name: \"", "\"")} {check_between(word, "ty: \"", "\"")}")
            }
        }
    }
    if current != "" -> rows.push("{current}: {fields.join(", ")}")
    rows
}

// What the schema at `at` says a payload field of row type `ty` is, against
// the row: a JSON string, integer or boolean for String, Int or Bool, a
// string (its name) for an Effect, an array of the item's schema for `[T]`,
// and a reference to the payload of that name otherwise. "" when they agree.
check_field_problem: fn(schema: Dyn, at: String, ty: String, payloads: [String]) -> String {
    if ty.starts_with("[") && ty.ends_with("]") {
        found: check_json.at<String>(schema, "{at}/type") ?? ""
        if found != "array" -> return "`{at}` has type `{found}`; the row's `{ty}` is an array"
        return check_field_problem(schema, "{at}/items", ty.removeprefix("[").removesuffix("]"), payloads)
    }
    kind: if ty == {
        "String" | "Effect" -> "string"
        "Int" -> "integer"
        "Bool" -> "boolean"
        else -> ""
    }
    if kind != "" {
        found: check_json.at<String>(schema, "{at}/type") ?? ""
        if found != kind -> return "`{at}` has type `{found}`; the row's `{ty}` is `{kind}`"
        return ""
    }
    if !payloads.contains(ty) {
        return "`{at}` has row type `{ty}`, which is neither String, Int, Bool, a list nor a payload row"
    }
    found: check_json.at<String>(schema, "{at}/$ref") ?? ""
    if found != "#/$defs/{ty}" {
        return "`{at}` refers to `{found}`; the row's `{ty}` is `#/$defs/{ty}`"
    }
    ""
}

// Where `schema`, the JSON Schema of an item of `jet build --json`'s
// `events`, departs from the rows in `rows_text`.
check_schema_problems: fn(rows_text: String, schema: Dyn) -> [String] {
    ^problems: [String]{}
    rows: check_rows(rows_text)
    if rows.len() == 0 -> problems.push("{CHECK_ROWS_PATH} lists no moment")
    loop (index, row) in rows {
        words: row.split(" ").to_list()
        listed: check_json.at<String>(schema, "oneOf/{index}/$ref") ?? ""
        constant: check_json.at<String>(schema, "$defs/{words[0]}/properties/event/const") ?? ""
        data: check_json.at<String>(schema, "$defs/{words[0]}/properties/data/$ref") ?? ""
        if listed != "#/$defs/{words[0]}" || constant != words[0] || data != "#/$defs/{words[2]}" {
            problems.push("Event {index + 1} is `{listed}` with event `{constant}` and data `{data}`; row {index + 1} is `{words[0]}` carrying `{words[2]}`")
        }
    }
    extra: check_json.at<String>(schema, "oneOf/{rows.len()}/$ref") ?? ""
    if extra != "" -> problems.push("It lists `{extra}` past the {rows.len()} rows")
    payload_rows: check_payload_rows(rows_text)
    ^payload_names: [String]{}
    loop payload in payload_rows { payload_names.push((payload.split_once(":") ?? next).before) }
    loop payload in payload_rows {
        parts: payload.split_once(": ") ?? next
        ^fields: [String]{}
        loop field in parts.after.split(", ") {
            typed: field.split_once(" ") ?? next
            fields.push(typed.before)
            problem: check_field_problem(schema, "$defs/{parts.before}/properties/{typed.before}", typed.after, payload_names)
            if problem != "" -> problems.push(problem)
        }
        required: (check_json.at<[String]>(schema, "$defs/{parts.before}/required") ?? [String]{}).join(", ")
        if required != fields.join(", ") {
            problems.push("Payload `{parts.before}` requires `{required}`; its row lists `{fields.join(", ")}`")
        }
        if check_json.at<Bool>(schema, "$defs/{parts.before}/additionalProperties") ?? true {
            problems.push("Payload `{parts.before}` is not a closed object")
        }
    }
    problems
}

run: fn() {
    args: check_process.args()
    if args.len() < 1 -> check_process.fail(2, "Usage: jet check.jet <checkout>")
    rows_path: "{args[0]}/{CHECK_ROWS_PATH}"
    rows_text: check_files.read(rows_path) ?? check_process.fail(2, "Couldn't read {rows_path}: {err}")
    jet: check_process.env_get_or("JET", "jet")
    ran: check_process.cmd([String]{jet, "inspect", "events", "--schema"}).stdout(.Capture).stderr(.Capture).run() ?? check_process.fail(2, "Couldn't run {jet} inspect events --schema: {err}")
    if ran.code != 0 {
        check_process.fail(1, "{jet} inspect events --schema failed: {check_process.combined_output(ran).trim()}")
    }
    schema: check_json.parse(ran.output) ?? check_process.fail(1, "What {jet} inspect events --schema prints isn't JSON: {err}")
    problems: check_schema_problems(rows_text, schema)
    if problems.len() > 0 {
        check_process.fail(1, "The schema differs from the rows in {CHECK_ROWS_PATH}:\n{problems.join("\n")}")
    }
    print("The schema matches the {check_rows(rows_text).len()} compiler event rows")
}
