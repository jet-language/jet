use math: core.math

Point: struct {
    x: Int,
    y: Int,
    label: String,
    tag: U8,
}

make_point: fn(x: Int, y: Int, label: String, tag: U8) -> Point Never! {
    Point{x: x, y: y, label: label, tag: tag}
}

sum_many: fn(a0: Int, a1: Int, a2: Int, a3: Int, a4: Int, a5: Int, a6: Int, a7: Int, f0: Float, f1: Float, f2: Float, f3: Float, f4: Float, f5: Float, f6: Float, f7: Float, f8: Float) -> Int Never! {
    s: a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7
    fs: f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8
    s + Int{I64{fs}}
}

apply_fn: fn(f: fn(Int) -> Int Never!, x: Int) -> Int Never! {
    f(x)
}

double_it: fn(x: Int) -> Int Never! { x * 2 }

run: fn() -[IO]> {
    // Exact Int arithmetic, shifts, bitwise, big int, comparisons
    a: 17
    b: 5
    big: 1000000000000000000000000000000 + 7
    exact_sum: (a + b) + (a - b) + (a * b) + (a % b) + (a /% b) + (a %% b)
    exact_bits: (a & b) + (a | b) + (a ~ b) + (1 << 5) + (64 >> 2) + (-b) + (~0)
    exact_cmp: (if a > b -> 1 else -> 0) + (if a >= 17 -> 2 else -> 0) + (if b < a -> 4 else -> 0) + (if b <= 5 -> 8 else -> 0) + (if a == 17 -> 16 else -> 0) + (if a != b -> 32 else -> 0)
    print("exact:{exact_sum}:{exact_bits}:{exact_cmp}:{big}")

    // Fixed widths (signed & unsigned)
    u8v := U8{200}
    u8v = u8v - U8{50}
    i16v: I16{-300} + I16{420}
    u32v: (U32{1000} * U32{3}) /% U32{7}
    i64v: ((I64{-17} /% I64{5}) * I64{10}) + (I64{-17} %% I64{5})
    print("fixed:{u8v}:{i16v}:{u32v}:{i64v}")

    // Float & F32 arithmetic, sqrt, conversions, NaN comparisons
    x: Float{9.0}
    y: Float{4.0}
    f32a: F32{3.5}
    f32b: F32{1.5}
    nan: Float{0.0} / Float{0.0}
    nan_ok: !(nan < Float{1.0}) && !(nan <= Float{1.0}) && !(nan > Float{1.0}) && !(nan >= Float{1.0}) && !(nan == nan) && (nan != nan)
    print("float:{math.sqrt(x)}:{x + y}:{x - y}:{x * y}:{x / y}:{Float{f32a + f32b}}:{nan_ok}")

    // Strings: const text, concat, compare, early drops in loop
    acc := ""
    loop i in 0..<4 {
        part: "k{i}"
        if part < "k3" -> acc = "{acc}{part},"
    }
    print("str:{acc}:{acc == "k0,k1,k2,"}:{acc != "other"}:{"a" < "b"}:{"b" > "a"}")

    // Aggregates, structs, indirect calls, >6 GPR + >8 Float stacked arguments
    p: make_point(3, 4, "pt", U8{9})
    stacked: sum_many(1, 2, 3, 4, 5, 6, 7, 8, Float{1.0}, Float{2.0}, Float{3.0}, Float{4.0}, Float{5.0}, Float{6.0}, Float{7.0}, Float{8.0}, Float{9.0})
    indir: apply_fn(double_it, p.x + p.y)
    print("agg:{p.label}:{p.x}:{p.y}:{p.tag}:{stacked}:{indir}")

    // Lists (#unique<T>, block_unique/retain/release) & Atomics
    xs := [Int]{10, 20, 30}
    ys := xs
    xs.push(40)
    atom := Counter{n: I64{100}}
    old: atom.n.add(I64{25})
    swapped: atom.n.compare_exchange(I64{125}, I64{200})
    print("mem:{xs.len()}:{ys.len()}:{old}:{swapped}:{atom.n.load()}")
}

Counter: struct {
    n: Atomic<I64>,
}
