# An immutable `name: value` inside a block (a loop body, an `if` branch) is
# computed while compiling when it can be. Otherwise it falls back to run time
# quietly, and `jet inspect semindex` gives the reason: it reads a run-time
# input, it calls code that reaches the outside world, it holds a value no
# build can keep, or computing it stopped (here on the evaluator's step
# limit). The run prints the same result with no report.
fixture: ComptimeFallbackReasonShowsInInspect.fixture
step: jet inspect semindex reasons.jet --json
exit: 0
json: stdout doc $.semindex.definitions[?leaf_name="computed"][0].detail.stage = {"when":"build","value":"36"}
json: stdout doc $.semindex.definitions[?leaf_name="input"][0].detail.stage = {"when":"run","reason":"it reads `count`, which only the running program knows"}
json: stdout doc $.semindex.definitions[?leaf_name="printed"][0].detail.stage = {"when":"run","reason":"it calls `noisy`, which prints text or reads input"}
json: stdout doc $.semindex.definitions[?leaf_name="doubler"][0].detail.stage.when = "run"
json: stdout doc $.semindex.definitions[?leaf_name="doubler"][0].detail.stage.reason ~ "which a build can't keep" # the reason also names the held type, whose spelling is not part of this contract
json: stdout doc $.semindex.definitions[?leaf_name="spun"][0].detail.stage.when = "run"
json: stdout doc $.semindex.definitions[?leaf_name="spun"][0].detail.stage.reason ~ "computing it stops" # the reason ends with the stop's text
json: stdout doc $.semindex.definitions[?leaf_name="spun"][0].detail.stage.reason ~ "step limit" # the stop names the spent step limit
step: jet run reasons.jet
exit: 0
stdout: = "noisy\n82\n"
stderr: empty
