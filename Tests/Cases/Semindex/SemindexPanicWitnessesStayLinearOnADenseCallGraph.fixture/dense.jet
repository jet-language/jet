// Eighteen layers of three functions; each calls all three of the layer
// below, and the first layer calls `stop`, which panics in its own body.
stop: fn(n: Int) {
    if n < 0 -> panic("negative")
}

a1: fn(n: Int) {
    stop(n)
}

b1: fn(n: Int) {
    stop(n)
}

c1: fn(n: Int) {
    stop(n)
}

a2: fn(n: Int) {
    a1(n)
    b1(n)
    c1(n)
}

b2: fn(n: Int) {
    a1(n)
    b1(n)
    c1(n)
}

c2: fn(n: Int) {
    a1(n)
    b1(n)
    c1(n)
}

a3: fn(n: Int) {
    a2(n)
    b2(n)
    c2(n)
}

b3: fn(n: Int) {
    a2(n)
    b2(n)
    c2(n)
}

c3: fn(n: Int) {
    a2(n)
    b2(n)
    c2(n)
}

