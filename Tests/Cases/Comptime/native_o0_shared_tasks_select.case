# Compile-time code runs as native O0 code over the program's own runtime,
# so the operations a run uses work the same while building: a Shared cell
# written through a second handle, `task.all` and a joined task, a select
# over channels, runtime kernels (Core math, SHA-256) and allocation in a
# fixed backing with its reset. Each `#run` value equals the same call at
# run time on every tier and in the built binary. A foreign (`#FFI`)
# function is not linked into compile-time code, so calling one while
# building stops the build at the `#run` (E3010).
fixture: NativeO0SharedTasksSelect.fixture
env: NO_COLOR=1
step o0: jet run -O0 main.jet
exit: 0
stdout: = "built 42 5050 11 1.4142135623730951 166 70 33\nrun 42 5050 11 1.4142135623730951 166 70 33\n"
step o1: jet run -O1 main.jet
exit: 0
stdout: = "built 42 5050 11 1.4142135623730951 166 70 33\nrun 42 5050 11 1.4142135623730951 166 70 33\n"
step o2: jet run -O2 main.jet
exit: 0
stdout: = "built 42 5050 11 1.4142135623730951 166 70 33\nrun 42 5050 11 1.4142135623730951 166 70 33\n"
step built: jet build main.jet
exit: 0
step image: {work}/.jet/build/main
exit: 0
stdout: = "built 42 5050 11 1.4142135623730951 166 70 33\nrun 42 5050 11 1.4142135623730951 166 70 33\n"
step ffi: jet run ffi.jet
exit: 1
stderr: ~ "Error: Jet.ArithmeticOrBoundsFailure: `compile-time code cannot call the foreign (`#FFI`) function `add``" # the stop, not a link failure
stderr: ~ "ffi.jet:15:13" # at the `#run` that reached the call
