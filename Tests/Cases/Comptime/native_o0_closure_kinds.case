# Compile-time code runs the closures Core keeps for later the same way a run
# does: scope guards, transaction commit and rollback hooks, a task,
# reactive derived values and effects, and a UI click handler and render
# body; and the typed-text heads (HTML, Sh, URL, Path, DateTime, SQL) escape
# their holes the same way. Each `#run` value equals the same call at run
# time on every tier and in the built binary.
fixture: NativeO0ClosureKinds.fixture
env: NO_COLOR=1
step o0: jet run -O0 main.jet
exit: 0
stdout: = "built body,guard 2,guard 1,held,commit,rollback,total 200,total 300 seen 6 total 300\nrun body,guard 2,guard 1,held,commit,rollback,total 200,total 300 seen 6 total 300\nbuilt Save 0\nrun Save 0\nbuilt <p>two words; &lt;b&gt;</p>|echo+two words; <b>+plain|https://example.test/base/two%20words%3B%20%3Cb%3E?q=two%20words%3B%20%3Cb%3E|/srv/two%20words%3B%20%3Cb%3E/x|2024-02-29 23:58:57 UTC\nrun <p>two words; &lt;b&gt;</p>|echo+two words; <b>+plain|https://example.test/base/two%20words%3B%20%3Cb%3E?q=two%20words%3B%20%3Cb%3E|/srv/two%20words%3B%20%3Cb%3E/x|2024-02-29 23:58:57 UTC\nbuilt select id from users\nrun select id from users\n"
step o1: jet run -O1 main.jet
exit: 0
stdout: = "built body,guard 2,guard 1,held,commit,rollback,total 200,total 300 seen 6 total 300\nrun body,guard 2,guard 1,held,commit,rollback,total 200,total 300 seen 6 total 300\nbuilt Save 0\nrun Save 0\nbuilt <p>two words; &lt;b&gt;</p>|echo+two words; <b>+plain|https://example.test/base/two%20words%3B%20%3Cb%3E?q=two%20words%3B%20%3Cb%3E|/srv/two%20words%3B%20%3Cb%3E/x|2024-02-29 23:58:57 UTC\nrun <p>two words; &lt;b&gt;</p>|echo+two words; <b>+plain|https://example.test/base/two%20words%3B%20%3Cb%3E?q=two%20words%3B%20%3Cb%3E|/srv/two%20words%3B%20%3Cb%3E/x|2024-02-29 23:58:57 UTC\nbuilt select id from users\nrun select id from users\n"
step o2: jet run -O2 main.jet
exit: 0
stdout: = "built body,guard 2,guard 1,held,commit,rollback,total 200,total 300 seen 6 total 300\nrun body,guard 2,guard 1,held,commit,rollback,total 200,total 300 seen 6 total 300\nbuilt Save 0\nrun Save 0\nbuilt <p>two words; &lt;b&gt;</p>|echo+two words; <b>+plain|https://example.test/base/two%20words%3B%20%3Cb%3E?q=two%20words%3B%20%3Cb%3E|/srv/two%20words%3B%20%3Cb%3E/x|2024-02-29 23:58:57 UTC\nrun <p>two words; &lt;b&gt;</p>|echo+two words; <b>+plain|https://example.test/base/two%20words%3B%20%3Cb%3E?q=two%20words%3B%20%3Cb%3E|/srv/two%20words%3B%20%3Cb%3E/x|2024-02-29 23:58:57 UTC\nbuilt select id from users\nrun select id from users\n"
step built: jet build main.jet
exit: 0
step image: {work}/.jet/build/main
exit: 0
stdout: = "built body,guard 2,guard 1,held,commit,rollback,total 200,total 300 seen 6 total 300\nrun body,guard 2,guard 1,held,commit,rollback,total 200,total 300 seen 6 total 300\nbuilt Save 0\nrun Save 0\nbuilt <p>two words; &lt;b&gt;</p>|echo+two words; <b>+plain|https://example.test/base/two%20words%3B%20%3Cb%3E?q=two%20words%3B%20%3Cb%3E|/srv/two%20words%3B%20%3Cb%3E/x|2024-02-29 23:58:57 UTC\nrun <p>two words; &lt;b&gt;</p>|echo+two words; <b>+plain|https://example.test/base/two%20words%3B%20%3Cb%3E?q=two%20words%3B%20%3Cb%3E|/srv/two%20words%3B%20%3Cb%3E/x|2024-02-29 23:58:57 UTC\nbuilt select id from users\nrun select id from users\n"
