use {
    core.mem.scope
    reactive: core.reactive
    ui: core.ui
}

Log: struct {
    rows: [String],
}

#Error
Fail: enum {
    Bad,
}

// Scope guards run newest first when the function returns.
guarded: fn(log: Shared<Log>) -> Int Fail! {
    _first: scope.guard(fn() { log.rows.push("guard 1") })
    _second: scope.guard(fn() { log.rows.push("guard 2") })
    log.rows.push("body")
    Ok(1)
}

// A committed transaction runs its commit hook; a failed one its rollback.
transact: fn(log: Shared<Log>, commit: Bool) -> Int Fail! {
    #Transact(order) {
        order.on_commit(fn() { log.rows.push("commit") })
        order.on_rollback(fn() { log.rows.push("rollback") })
        if !commit -> return Err(Fail.Bad)
        log.rows.push("held")
    }
    Ok(2)
}

closures: fn() -> String {
    log: Shared{Log{rows: [String]{}}}
    _ := guarded(log) ?? 0
    _ := transact(log, true) ?? 0
    _ := transact(log, false) ?? 0
    worker: task log.rows.len()
    seen: worker.join() ?? -1
    price := reactive.signal(100)
    qty := reactive.signal(2)
    total: reactive.derived(fn() { price.get() * qty.get() })
    _subscription: reactive.autorun(fn() { log.rows.push("total {total.get()}") })
    price.set(150)
    "{log.rows.join(",")} seen {seen} total {total.get()}"
}

// A click handler, a drop handler and a render body are registered, not run;
// each keeps its own count.
interface: fn() -> String {
    clicks := 0
    save: ui.button("Save", fn() { clicks += 1 })
    dropped := 0
    draft: ui.text_input(
        "draft",
        UIIMEMode.Native,
        on_drop: fn(item: UIDropItem) {
            if item == .Text(value) -> dropped += value.len()
        },
    )
    renders := 0
    ui.reactive_render(fn() { renders += 10 })
    "{save.label} {draft.label}"
}

User: struct {
    id: Int,
}

// Each typed-text head escapes the same hole its own way.
texts: fn() -> String {
    word: "two words; <b>"
    page: HTML{"<p>{word}</p>"}
    command: Sh{"echo {word} plain"}
    link: URL{"https://example.test/base/{word}?q={word}"}
    file: Path{"/srv/{word}/x"}
    stamp: DateTime{"2024-02-29T23:58:57Z"}
    "{page.text()}|{command.args().join("+")}|{link.to_string()}|{file}|{stamp.to_string()}"
}

query: fn() -> String {
    #SQL(User) {
        q: SQL{"select id from users"}
        return q.template()
    }
}

CLOSURES: #run closures()

INTERFACE: #run interface()

TEXTS: #run texts()

QUERY: #run query()

run: fn() {
    print("built {CLOSURES}")
    print("run {closures()}")
    print("built {INTERFACE}")
    print("run {interface()}")
    print("built {TEXTS}")
    print("run {texts()}")
    print("built {QUERY}")
    print("run {query()}")
}
