# `jet new <kind> <name> --remove` undoes a generator run from its receipt:
# it deletes exactly the files the receipt lists, refuses and removes
# nothing when one of them was edited since, and keeps the receipt as
# removed, so a migration generated again reuses its version number.
env: NO_COLOR=1
write: shop/package.jet = "name: \"shop\"\nversion: \"0.1.0\"\n"
write: shop/Services/Keep.jet = "// Written by hand.\n"
step: jet new service OrderBoard
cwd: {work}/shop
exit: 0
step: jet new service OrderBoard --remove --preview
cwd: {work}/shop
exit: 0
stdout: = "would remove Services/OrderBoard.jet\n" # the preview lists the files and removes none
file: shop/Services/OrderBoard.jet is-file
step: jet new service OrderBoard --remove
cwd: {work}/shop
exit: 0
stderr: ~ "removed Services/OrderBoard.jet\nrecorded .jet/generated/service-order_board.receipt as removed\n" # exactly the listed file
file: shop/Services/OrderBoard.jet absent
file: shop/Services/Keep.jet = "// Written by hand.\n" # a file the receipt doesn't list stays
file: shop/.jet/generated/service-order_board.receipt ~ "state: removed\n" # the receipt is kept as removed
step: jet new service OrderBoard --remove
cwd: {work}/shop
exit: 1
stderr: ~ "`jet new service OrderBoard` was already removed" # a second undo has nothing to remove
step: jet new job SendDigest --remove
cwd: {work}/shop
exit: 1
stderr: ~ "No receipt records `jet new job SendDigest`" # no receipt, nothing to remove
step: jet new job SendDigest
cwd: {work}/shop
exit: 0
write: shop/Jobs/SendDigest.jet = "// Edited since.\n"
step: jet new job SendDigest --remove
cwd: {work}/shop
exit: 1
stderr: ~ "`Jobs/SendDigest.jet` changed since `jet new job SendDigest` wrote it, so nothing was removed" # the integrity check
file: shop/Jobs/SendDigest.jet = "// Edited since.\n" # the edited file stays
file: shop/.jet/generated/job-send_digest.receipt ~ "state: generated\n" # and the receipt still holds it
step: jet new migration AddIndex --up 'CREATE INDEX orders_by_user ON orders (user_id)'
cwd: {work}/shop
exit: 0
file: shop/Migrations/001_add_index.jet is-file
step: jet new migration AddColumn --up 'ALTER TABLE orders ADD COLUMN note TEXT'
cwd: {work}/shop
exit: 0
file: shop/Migrations/002_add_column.jet is-file
step: jet new migration AddIndex --remove
cwd: {work}/shop
exit: 0
file: shop/Migrations/001_add_index.jet absent
step: jet new migration AddIndex --up 'CREATE INDEX orders_by_user ON orders (user_id, id)'
cwd: {work}/shop
exit: 0
stderr: ~ "created Migrations/001_add_index.jet" # generated again, it keeps version 1
file: shop/Migrations/001_add_index.jet ~ "orders (user_id, id)" # with the SQL given now
step: jet new migration AddColumn --remove
cwd: {work}/shop
exit: 0
step: jet new migration AddNote --up 'ALTER TABLE orders ADD COLUMN memo TEXT'
cwd: {work}/shop
exit: 0
stderr: ~ "created Migrations/003_add_note.jet" # a removed migration's version is never given to another
