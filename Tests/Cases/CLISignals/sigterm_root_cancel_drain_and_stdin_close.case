# SIGTERM triggers root cancellation through shared Prelude semantics on O0, O1,
# and O2: ProcessStdin.close() finishes cleanly, the in-flight HTTP request is
# drained and answered 200 OK, and background tasks join as Canceled within 5s.
requires: os:unix
requires: tool:cat
fixture: SigtermRootCancelDrainAndStdinClose.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache

step: jet build -O0 --allow=Env,Exec,Net,Time,Time.Wait,FS.Read,IO main.jet
exit: 0

session o0 raw: built
recv o0 until = "ready\n" within 30s
stdout: = "ready\n"
signal o0: TERM
repeat while process {pid:o0} alive timeout 5s every 10ms fail "O0 artifact did not drain within 5s of SIGTERM"
end repeat
close o0
exit: 0
stdout: = "in_flight: HTTP/1.1 200 OK\nstdin_closed: true\nroot_cancel: client=true sleeper=true\ndrained: accepted=1 completed=1 canceled=0\n"

step: jet build -O1 --allow=Env,Exec,Net,Time,Time.Wait,FS.Read,IO main.jet
exit: 0

session o1 raw: built
recv o1 until = "ready\n" within 30s
stdout: = "ready\n"
signal o1: TERM
repeat while process {pid:o1} alive timeout 5s every 10ms fail "O1 artifact did not drain within 5s of SIGTERM"
end repeat
close o1
exit: 0
stdout: = "in_flight: HTTP/1.1 200 OK\nstdin_closed: true\nroot_cancel: client=true sleeper=true\ndrained: accepted=1 completed=1 canceled=0\n"

step: jet build -O2 --allow=Env,Exec,Net,Time,Time.Wait,FS.Read,IO main.jet
exit: 0

session o2 raw: built
recv o2 until = "ready\n" within 30s
stdout: = "ready\n"
signal o2: TERM
repeat while process {pid:o2} alive timeout 5s every 10ms fail "O2 artifact did not drain within 5s of SIGTERM"
end repeat
close o2
exit: 0
stdout: = "in_flight: HTTP/1.1 200 OK\nstdin_closed: true\nroot_cancel: client=true sleeper=true\ndrained: accepted=1 completed=1 canceled=0\n"
