// Fallible allocation is a value, with no heap: Fixed owns one compile-time
// inline buffer, so exhaustion is deterministic and calls no allocator, and
// each report is literal text, which allocates nothing.
use core.mem

run: fn() {
    fixed: mem.Fixed.new(size: 40)

    if fixed.try_alloc(7) == {
        .Ok(_) -> { print("success") }
        .Err(_) -> { print("unexpected failure") }
    }

    if fixed.try_alloc(9) == {
        .Ok(_) -> { print("unexpected success") }
        .Err(_) -> { print("failure") }
    }
}
