# A copy of a generic type that holds a Clock through itself is E0211: a copy
# forks every Clock it holds, and only a non-generic type gets a fork function.
fixture: ClockGenericRecursiveHolderCopyIsRefused/Input
step: jet check run.jet
exit: 1
stderr: ~ "Jet.CopyNotSupported" # the copy is refused, not left sharing the Clock
