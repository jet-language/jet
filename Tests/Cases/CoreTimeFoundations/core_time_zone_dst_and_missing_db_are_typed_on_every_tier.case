# IANA zone lookup, DST gap/overlap disambiguation, calendar data, and missing zone DB typed TimeError across O0/O1/O2.
fixture: CoreTimeZoneDstAndMissingDBAreTypedOnEveryTier.fixture
step o0: jet run main.jet
exit: 0
stdout: = core_time_zone_dst_and_missing_db_are_typed_on_every_tier.out
step o1: jet run -O1 main.jet
exit: 0
stdout: = core_time_zone_dst_and_missing_db_are_typed_on_every_tier.out
step o2: jet run -O2 main.jet
exit: 0
stdout: = core_time_zone_dst_and_missing_db_are_typed_on_every_tier.out
step missing_db_jet_tzdb_env: jet run missing_db.jet
env: JET_TZDB_DIR={work}/empty_jet_tzdb
exit: 0
stdout: ~ "missing_db_env: err:unknown IANA time zone: America/New_York"
step missing_db_tzdir_env: jet run missing_db.jet
env: TZDIR={work}/empty_tzdir
exit: 0
stdout: ~ "missing_db_env: err:unknown IANA time zone: America/New_York"

