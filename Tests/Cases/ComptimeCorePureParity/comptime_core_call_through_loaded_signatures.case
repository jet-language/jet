# A compile-time fragment calls Core source functions (`core.math.gcd`,
# `core.math.abs`) through their loaded signatures: no E0956, and each value
# is the one the same call returns at run time, on every tier. A plain-literal
# constant registers as its own value: the trace shows the two `#run` values
# built and evaluated, and no fragment built or evaluated for LIMIT, so
# registering a literal does not walk its unit again.
fixture: ComptimeCoreCallThroughLoadedSignatures.fixture
env: NO_COLOR=1
env: JET_CACHE_DIR={work}/cache
step trace: jet check --trace main.jet
exit: 0
stderr: ~ "comptime.eval DIVISOR (main.jet)" # the gcd call runs while compiling
stderr: ~ "comptime.eval DISTANCE (main.jet)" # and the abs call
stderr: ~ "comptime.check LIMIT (main.jet)" # the literal is checked
stderr: !~ "comptime.eval LIMIT" # but never evaluated
stderr: ~ "comptime.build DIVISOR, DISTANCE (main.jet)" # one fragment holds the two calls, and LIMIT is not in it
stderr: !~ "E0956" # no unloaded Core signature
step o0: jet run -O0 main.jet
exit: 0
stdout: = "6 9 40 6 9\n"
step o1: jet run -O1 main.jet
exit: 0
stdout: = "6 9 40 6 9\n"
step o2: jet run -O2 main.jet
exit: 0
stdout: = "6 9 40 6 9\n"
