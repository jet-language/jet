# Every call that changes a named argument requires `^` (E0228) with a Safe
# edit; `jet fix` inserts the marks and the result checks and runs.
fixture: WritesPolicyFixInsertsCallMarks.fixture
step: jet check run.jet
exit: 1
stderr: ~ "Jet.CallMarkRequired" # missing write call mark
step: jet fix run.jet
file: run.jet = WritesPolicyFixInsertsCallMarks.fixture/run.fixed.out
step: jet run run.jet
exit: 0
stdout: = "5 5\n"
