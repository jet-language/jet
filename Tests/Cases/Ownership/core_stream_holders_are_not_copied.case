# Core's `TCPStream`, `UnixStream`, `TLSStream` and `WsConn` stay resources by
# their Core identity, each read in its own module, and a struct or an enum
# that holds one is a resource too: a read parameter of each of the eight
# holders can't be copied into an owned field (E0201).
fixture: CoreStreamHoldersAreNotCopied.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet check main.jet --json
exit: nonzero
json: stdout doc $.reports[?severity="error"] #= 8 # exactly the eight refusals, nothing else
json: stdout doc $.reports[?code="E0201"][?message="`wire` cannot be moved from borrowed storage"] #= 4 # a struct holding each stream
json: stdout doc $.reports[?code="E0201"][?message="`side` cannot be moved from borrowed storage"] #= 4 # an enum holding each stream
