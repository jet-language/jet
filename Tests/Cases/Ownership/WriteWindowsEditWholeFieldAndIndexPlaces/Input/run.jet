Slot: struct {
    value: Int,
}

run: fn() {
    ^whole: 1
    whole_edit: whole.in_place()
    whole_edit = 2

    ^cell: Slot{value: 3}
    field_edit: cell.value.in_place()
    field_edit = 4

    ^xs: [5, 6]
    index_edit: xs[0].in_place()
    index_edit = 7
    print(whole + cell.value + xs[0])
}
