run: fn() {
    { sender: ready_sender, receiver: ready }: channel<Int>()
    { sender, receiver: ch }: channel<Int>()
    { sender: ack_sender, receiver: ack }: channel<Int>()
    slow: task {
        #Shield {
            ready_sender.send(1)
            value: ch.receive() ?? panic("closed")
            print(value)
            ack_sender.send(1)
        }
        print(99)
    }
    ^_: ready.receive() ?? panic("closed")
    slow.cancel()
    slow.detach()
    sender.send(42)
    ^_: ack.receive() ?? panic("closed")
}
