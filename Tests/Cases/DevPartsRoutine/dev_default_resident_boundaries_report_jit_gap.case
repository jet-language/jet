# tests/dev_parts/routine.rs::dev_default_resident_boundaries_report_jit_gap at tests/dev_parts/routine.rs:1672; hand-port (memory/expiring_secret declares its inline package, so its directory gets no package.jet)
fixture: DevDefaultResidentBoundariesReportJITGap.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1
copy: {root}/Examples/Memory/EntityTree.jet entity/entity_tree.jet
copy: {root}/Examples/Memory/ExpiringSecret.jet secret/expiring_secret.jet
step check_entity: jet check entity_tree.jet
cwd: entity
exit: any # original assert_default_run_or_named_boundary accepts a run or a named dev boundary
stderr: !~ "Jet.RetiredJitGap" # original predicate: problems never name the retired E2211
when exit != 0: stderr: ~any "Jet.RetiredDevStepBudget" "Jet.ComptimeFuelExhausted" "Jet.ComptimeConstructNotSupported" "Jet.ComptimePanic" "Jet.ComptimeEffectWithoutImpure" "Jet.ImpureGateNotAllowed" "Jet.ComptimeNetUnavailable" "Jet.SecretAtBuildTime" "Jet.UnknownFunction" "Jet.ModuleValueNotConstant" "Jet.UnknownName" "Jet.UntypedEmptyList" "Jet.UntypedNone" "Jet.MixedCollectionLiteral" "Jet.UnknownField" "Jet.InvalidIndexType" "Jet.MissingDisplay" "Jet.UnknownMethod" "Jet.UnknownCoreItem" # original predicate: is_named_dev_boundary (some diagnostic carries a BOUNDARY_CODES code)
step run_entity: jet run entity_tree.jet
cwd: entity
stdin: null
exit: any # original predicate: RunOutcome::Ran passes whatever the program exits
step check_secret: jet check expiring_secret.jet
cwd: secret
exit: any # original assert_default_run_or_named_boundary accepts a run or a named dev boundary
stderr: !~ "Jet.RetiredJitGap" # original predicate: problems never name the retired E2211
when exit != 0: stderr: ~any "Jet.RetiredDevStepBudget" "Jet.ComptimeFuelExhausted" "Jet.ComptimeConstructNotSupported" "Jet.ComptimePanic" "Jet.ComptimeEffectWithoutImpure" "Jet.ImpureGateNotAllowed" "Jet.ComptimeNetUnavailable" "Jet.SecretAtBuildTime" "Jet.UnknownFunction" "Jet.ModuleValueNotConstant" "Jet.UnknownName" "Jet.UntypedEmptyList" "Jet.UntypedNone" "Jet.MixedCollectionLiteral" "Jet.UnknownField" "Jet.InvalidIndexType" "Jet.MissingDisplay" "Jet.UnknownMethod" "Jet.UnknownCoreItem" # original predicate: is_named_dev_boundary (some diagnostic carries a BOUNDARY_CODES code)
step run_secret: jet run expiring_secret.jet
cwd: secret
stdin: null
exit: any # original predicate: RunOutcome::Ran passes whatever the program exits
