use time: core.time

slow_text: fn() -> String {
    time.sleep(25ms)
    return "slow"
}

late_text: fn() -> String {
    time.sleep(1000ms)
    return "late"
}

failure_label: fn(error: TaskFailure) -> String {
    if error == {
        .Canceled -> {
            return "canceled"
        }
        .DeadlineBlown -> {
            return "deadline"
        }
        .Panicked(_) -> {
            return "panicked"
        }
    }
}

run: fn() {
    task.group workers {
        child: task { "child" }
        print(child.join() ?? "child-fallback")

        all_result: task.all {"left", "right"} ?? []
        print(all_result[0], all_result[1])
        print((task.race {slow_text(), "race"}) ?? "race-fallback")
        print((task.any {slow_text(), "any"}) ?? "any-fallback")

        canceled: task late_text()
        canceled.cancel()
        if canceled.join() == {
            .Err(error) -> { print(failure_label(error)) }
            .Ok(_) -> { print("wrong cancellation") }
        }

        failed: task { panic("boom") }
        if failed.join() == {
            .Err(error) -> { print(failure_label(error)) }
            .Ok(_) -> { print("wrong panic") }
        }
    }
}
