# Port of tests/cli_parts/surface.rs:1954-2131, with the implicit-copy row.
# `jet lint --cost` reports each hidden dynamic cost a loop repeats as L2510
# (one per operation), `jet explain --cost` lists every typed cost site with
# its kind, state and tier, and a site the optimizer proves away is listed as
# removed but never linted. The original's `jet check` step is dropped: cost
# lints are opt-in, so `jet check` never reports L2510.
fixture: Fixtures/Cost
step: jet lint --cost {work}/tests/cli/cost_rows.jet
env: NO_COLOR=1
exit: 1
stderr: ~ "Jet.HiddenCostInLoop" # original predicate
stderr: ~ "Why:" # original predicate
stderr: ~ "Fix:" # original predicate
stderr: count "Editing a shared map backing store" = 1 # original predicate
stderr: count "An exact Int operation may spill to bigint" = 1 # original predicate
stderr: count "Using a generic collection representation" = 1 # original predicate
stderr: count "Constructing an Outcome carrier" = 1 # original predicate
stderr: count "view into an owned slot" = 1 # original predicate
stderr: count "Implicitly copying a `[Int]`" = 1 # `held := row` copies `row`, which the next turn and the end read again
stderr: count "Warning: Jet.HiddenCostInLoop:" = 6 # the original's L2510 header in the typed report form
stderr: ~ "6 hidden dynamic cost warnings found" # the summary counts the six rows above
step: jet explain --cost {work}/tests/cli/cost_rows.jet --json
env: NO_COLOR=1
exit: 0
stdout: ~ "\"kind\":\"view materialization\"" # original predicate
stdout: ~ "\"kind\":\"implicit copy\"" # `held := row` is the implicit-copy site
stdout: ~ "\"kind\":\"map copy-on-write\"" # original predicate
stdout: ~ "\"kind\":\"exact Int spill\"" # original predicate
stdout: ~ "\"kind\":\"outcome construction\"" # original predicate
stdout: ~ "\"kind\":\"generic representation fallback\"" # original predicate
stdout: ~ "\"state\":\"semantic remainder\"" # original predicate
stdout: count "\"tier\":\"shared-tir\"" = 6 # original predicate, with the implicit-copy row
stdout: !~ "\"source\":\"shared-tir\"" # original predicate
step: jet explain --cost {work}/tests/cli/cost_rows.jet
env: NO_COLOR=1
exit: 0
stdout.trim_lines.filter(!= ""): each-line ~ "tier=shared-tir" # original predicate
step: jet lint --cost {work}/tests/cli/cost_removed.jet
env: NO_COLOR=1
exit: 0
stdout: ~ "no hidden dynamic costs in loops" # original predicate
stdout: !~ "Jet.HiddenCostInLoop" # original predicate
stderr: !~ "Jet.HiddenCostInLoop" # original predicate
step: jet explain --cost {work}/tests/cli/cost_removed.jet --json
env: NO_COLOR=1
exit: 0
stdout: ~ "\"kind\":\"exact Int spill\"" # original predicate
stdout: ~ "\"state\":\"optimizer-proven removed\"" # original predicate
