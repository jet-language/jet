# Port of tests/cli_parts/surface.rs:1657-1759; exact original sources/predicates.
# PENDING-SAME-HEAD: runtime not run.
# PENDING-GRAMMAR(batch-four).
fixture: Fixtures/Safety
copy: exposed.jet exposed.bytes
step: jet check {work}/member_semicolon.jet --json
env: NO_COLOR=1
exit: 1
json: stdout doc $ valid # original predicate: parses
json: stdout doc $.reports[0].code = "E0373"
json: stdout doc $.reports[0].applicability = "suggested"
json: stdout doc $.reports[0].fix_edits : array # original pattern
json: stdout doc $.reports[0].fix_edits #= 1
# A `;` between struct fields separates nothing; the `,` it
# offers is the needs-review tier, since only the author knows the intent.
json: stdout doc $.reports[0].fix_edits[0].safety = "needs-review"
step: jet check {work}/immutable.jet --json
env: NO_COLOR=1
exit: 1
json: stdout doc $ valid # original predicate: parses
json: stdout doc $.reports[0].code = "E0111"
json: stdout doc $.reports[0].applicability = "safe"
json: stdout doc $.reports[0].fix_edits : array # original pattern
json: stdout doc $.reports[0].fix_edits #= 1
# The E0111 local-binding edit only lets the written assignment
# compile, so its registry row ranks it behavior-preserving.
json: stdout doc $.reports[0].fix_edits[0].safety = "behavior-preserving"
# E2421's `priv` removal widens a public failure contract: the api-changing
# tier. run reads `detail`, so no unread-field suggestion joins it.
step: jet check {work}/exposed.jet --json
env: NO_COLOR=1
exit: 1
json: stdout doc $ valid # the report parses
json: stdout doc $.reports[0].code = "E2421"
json: stdout doc $.reports[0].applicability = "suggested"
json: stdout doc $.reports[0].fix_edits #= 1
json: stdout doc $.reports[0].fix_edits[0].safety = "api-changing"
step: jet fix {work}/typo.jet
env: NO_COLOR=1
exit: 0
file: typo.jet = safety-typo-fixed.bytes
step: jet fix {work}/member_semicolon.jet
env: NO_COLOR=1
exit: 0
file: member_semicolon.jet ~ "x: Int; y: Int" # a needs-review edit is reported, not applied, without --all
stderr: ~ "no changes made (1 suggestion need review)" # the `,` edit is counted as needing review, not applied
step: jet fix {work}/immutable.jet
env: NO_COLOR=1
exit: 0
file: immutable.jet ~ "x := 1" # original predicate
step: jet fix {work}/exposed.jet
env: NO_COLOR=1
exit: 0
file: exposed.jet == exposed.bytes
stderr: ~ "no changes made (1 suggestion need review)" # an api-changing edit is reported, not applied, without --all
step: jet fix {work}/exposed.jet --all
env: NO_COLOR=1
exit: 0
file: exposed.jet ~ "    detail: String" # --all applies the api-changing edit
file: exposed.jet !~ "priv" # the `priv` marker is gone
