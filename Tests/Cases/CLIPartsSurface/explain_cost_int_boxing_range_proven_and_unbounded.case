# The cost view shows Int boxing per line. Arithmetic on a range
# loop's counter stays on the packed Int rail, since the range bounds the
# counter (CostFacts.jet body_cost_loop_counter_bounds), so its rows are
# optimizer-proven removed and never linted; a counter no range bounds may
# spill to a bigint every turn, so its row is a semantic remainder and the one
# L2510 `jet lint --cost` reports. The same view names every other kind on
# its own line: the copies (a view made owned, an implicit copy, a shared
# map's clone), the representation fallback, the allocation of an Outcome
# carrier each turn, and the stop poll each turn of the loop starts with.
fixture: Fixtures/Cost
step: jet explain --cost {work}/tests/cli/cost_int_boxing.jet
env: NO_COLOR=1
exit: 0
stdout: count "cost_int_boxing.jet:2 fn run — exact Int spill — optimizer-proven removed (loop depth 1; tier=shared-tir)" = 2 # `index * 2` and `+ 1` on the counter of `0..<4`
stdout: !~ "cost_int_boxing.jet:2 fn run — exact Int spill — semantic remainder" # the range proves the counter's arithmetic never spills
stdout: count "cost_int_boxing.jet:5 fn run — exact Int spill — semantic remainder (loop depth 1, repeats every loop turn; tier=shared-tir)" = 1 # `count += 1` has no range to bound it
step: jet lint --cost {work}/tests/cli/cost_int_boxing.jet
env: NO_COLOR=1
exit: 1
stderr: count "An exact Int operation may spill to bigint" = 1 # only the unbounded counter
stderr: ~ "cost_int_boxing.jet:5" # on the unbounded counter's line
stderr: !~ "cost_int_boxing.jet:2" # never on the range-proven line
step: jet explain --cost {work}/tests/cli/cost_rows.jet
env: NO_COLOR=1
exit: 0
stdout: count "cost_rows.jet:11 fn run — view materialization of `String` — semantic remainder (loop depth 1, repeats every loop turn; tier=shared-tir)" = 1 # copy: `out.push(view)` makes the trimmed view owned
stdout: count "cost_rows.jet:12 fn run — implicit copy of `[Int]` — semantic remainder (loop depth 1, repeats every loop turn; tier=shared-tir)" = 1 # copy: `held := row` copies a list still read later
stdout: count "cost_rows.jet:15 fn run — map copy-on-write — semantic remainder (loop depth 1, repeats every loop turn; tier=shared-tir)" = 1 # copy: the edit of `counts` may clone it
stdout: count "cost_rows.jet:16 fn run — exact Int spill — semantic remainder (loop depth 1, repeats every loop turn; tier=shared-tir)" = 1 # boxing: `total += index` has no range bounding `total`
stdout: count "cost_rows.jet:17 fn run — generic representation fallback — semantic remainder (loop depth 1, repeats every loop turn; tier=shared-tir)" = 1 # fallback: the indexed read of `values`
stdout: count "cost_rows.jet:18 fn run — outcome construction — semantic remainder (loop depth 1, repeats every loop turn; tier=shared-tir)" = 1 # allocation: `read_u8()` builds its Result each turn
stdout: count "cost_rows.jet:10 fn run — stop poll — semantic remainder (loop depth 1, repeats every loop turn; tier=shared-tir)" = 1 # poll: the turn poll each iteration of the loop starts with
