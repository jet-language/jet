# The value `jet eval CODE` prints is its last statement's (D-CLI-EVAL1):
# a final `if` with `->` branches or a final dispatch is that value,
# though the body of `run: fn` reads such an `if` as a statement elsewhere; a
# statement `if` and a unit value print nothing more; a List prints one item
# per line and a String prints without quotes. A `;` is the line break it
# means, so a value `if` whose last arm a `;` follows on the same line is
# refused (E0448), as in a file.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: XDG_CACHE_HOME={work}/xdg
step if_value: jet eval 'if 1 > 0 -> "yes" else -> "no"'
exit: 0
stdout: = "yes\n"
step dispatch_value: jet eval '^x: 2; if x == { 1 -> "one"; 2 -> "two"; else -> "many" }'
exit: 0
stdout: = "two\n"
step if_statement: jet eval 'if 1 > 0 { print("hi") }'
exit: 0
stdout: = "hi\n"
step unit: jet eval 'print("hi")'
exit: 0
stdout: = "hi\n"
step list: jet eval '[1, 2, 3].map(fn(n) { n * 2 })'
exit: 0
stdout: = "2\n4\n6\n"
step string: jet eval '"a b"'
exit: 0
stdout: = "a b\n"
step value_if_not_last: jet eval 'if 1 > 0 -> "a" else -> "b"; print(1)'
exit: 1
stdout: = ""
stderr: ~ "Jet.SemicolonAfterArm" # the `;` after a one-line arm could end the arm or the `if`
step negative_after_semicolon: jet eval '^x: 1; -1; print(x)'
exit: 1
stdout: = ""
stderr: ~ "Jet.SemicolonWithoutLineBreak" # a line break before `-1` would continue the statement
step statements: jet eval 'total: 2 + 3; print(total)'
exit: 0
stdout: = "5\n"
step trailing_semicolon: jet eval 'print(7);'
exit: 0
stdout: = "7\n"
step item_then_statements: jet eval 'S: struct { a: Int }; s: S{a: 1}; print(s.a)'
exit: 0
stdout: = "1\n"
