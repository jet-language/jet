run: fn() {
    padded: "  value  "
    view: padded.trim()
    out := [String]{}
    counts := [String:Int]{}
    values := [Int]{1, 2, 3}
    reader: Reader.over([U8]{1, 2, 3})
    total := Int{0}
    row: [Int]{1, 2}
    loop index in 0..<values.len() {
        out.push(view)
        held := row
        held.push(index)
        print(held.len())
        print((counts.add("value", 1)) ?? 0)
        total += index
        print(values[index])
        if reader.read_u8() == {
            .Ok(byte) -> { print(byte) }
            .Err(error) -> print(error)
        }
    }
    print(out.len())
    print(row.len())
    print(total)
}
