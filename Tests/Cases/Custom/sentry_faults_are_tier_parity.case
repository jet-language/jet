# Sentries are a development-tier watch: a plain release build runs the read unwatched
# (the same split as Examples/Memory/Unsafe/UnsafeSentries.o2.out), so the misaligned
# little-endian read of `1, 2` at byte offset 1 prints 2 << 56.
step: jet build --release unsafe_sentries_misaligned_list/unsafe_sentries_misaligned_list.jet
step: built
exit: 0
stdout: ~ "144115188075855872" # the misaligned read of `1, 2` at offset 1 is 2 << 56
stderr: !~ "Jet.MisalignedRawAccess" # no sentry watches a plain release read
