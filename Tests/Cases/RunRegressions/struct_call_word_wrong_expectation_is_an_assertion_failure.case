# Port of run_regressions.rs:120-128; stdout is deliberately unconstrained.
# PENDING-GRAMMAR: step-scoped env (fresh store and jetpack root for each tier).
env: JETPACK_ENV=1
env: NO_COLOR=1
# Original run_tier creates a Scratch root, not its cache/jetpack children.
mkdir: cache/default
step: jet run {root}/Tests/Fixtures/struct_call_word_failure.jet
env: JET_STORE_DIR={work}/cache/default/cache
env: JETPACK_ROOT={work}/cache/default/jetpack
exit: 70
# Renderer includes runtime source/location details; original asserts the diagnostic's identity only.
stderr: ~ "Jet.Panic" # Original checks only the runtime diagnostic's presence.
mkdir: cache/O0
step: jet run {root}/Tests/Fixtures/struct_call_word_failure.jet
env: JET_STORE_DIR={work}/cache/O0/cache
env: JETPACK_ROOT={work}/cache/O0/jetpack
exit: 70
# Renderer includes runtime source/location details; original asserts the diagnostic's identity only.
stderr: ~ "Jet.Panic" # Original checks only the runtime diagnostic's presence.
