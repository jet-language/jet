use process: core.process

// A child's pipes under the byte names: `write_some` is one partial write
// that reports the count taken, `write_bytes` writes every byte, and
// `read_bytes` reads up to its limit, empty at the end.
run: fn() {
    child: process.cmd([String]{"cat"}).stdin(.Stream).stdout(.Stream).spawn() ?? panic("spawn failed")
    taken: child.stdin.write_some("ab".bytes()) ?? panic("write_some failed")
    child.stdin.write_bytes("cd".bytes()) ?? panic("write_bytes failed")
    child.stdin.close()
    ^received: [U8]{}
    loop {
        chunk: child.stdout.read_bytes(3) ?? panic("read_bytes failed")
        if chunk.len() == 0 -> break
        loop byte in chunk { received.push(byte) }
    }
    print("took {taken}, received {String.from_bytes(received) ?? "?"}")
    receipt: child.wait() ?? panic("wait failed")
    print("exit {receipt.code}")
}
