// An imported generic's one instance in a union: `Box` in type position
// names boxes' generic, so the bare `.Box` arm names its member.
use boxes

show: fn(item: boxes.Box<Int> | Int) {
    if item == {
        .Int(n) -> { print("int {n}") }
        .Box(b) -> print("box {b.v}")
    }
}

run: fn() {
    show(boxes.Box<Int>{v: 5})
    show(2)
}
