use time: core.time

boom: fn() -> Int {
    panic("boom")
    return 0
}

deadline: fn() -> Int {
    #Deadline(0ms) { time.sleep(1ms) }
    return 0
}

panic_rail: fn() {
    task.group workers {
        failed: task boom()
        if failed.join() == {
            .Err(error) -> {
                if error == {
                    .Panicked(reason) -> { print("panic:{reason}") }
                    .DeadlineBlown -> { print("deadline") }
                    .Canceled -> { print("canceled") }
                }
            }
            .Ok(_) -> { print("wrong panic variant") }
        }
    }
}

all_rail: fn() {
    task.group workers {
        if (task.all {boom(), 2}) == {
            .Err(error) -> {
                if error == {
                    .Panicked(reason) -> { print("panic:{reason}") }
                    .DeadlineBlown -> { print("deadline") }
                    .Canceled -> { print("canceled") }
                }
            }
            .Ok(_) -> { print("wrong all variant") }
        }
    }
}

deadline_rail: fn() {
    task.group workers {
        expired: task deadline()
        if expired.join() == {
            .Err(error) -> {
                if error == {
                    .Panicked(reason) -> { print("panic:{reason}") }
                    .DeadlineBlown -> { print("deadline") }
                    .Canceled -> { print("canceled") }
                }
            }
            .Ok(_) -> { print("wrong deadline variant") }
        }
    }
}

cancel_rail: fn() {
    task.group workers {
        canceled: task {
            time.sleep(1000ms)
        }
        canceled.cancel()
        if canceled.join() == {
            .Err(error) -> {
                if error == {
                    .Panicked(reason) -> { print("panic:{reason}") }
                    .DeadlineBlown -> { print("deadline") }
                    .Canceled -> { print("canceled") }
                }
            }
            .Ok(_) -> { print("wrong cancel variant") }
        }
    }
}

run: fn() {
    panic_rail()
    all_rail()
    deadline_rail()
    cancel_rail()
}
