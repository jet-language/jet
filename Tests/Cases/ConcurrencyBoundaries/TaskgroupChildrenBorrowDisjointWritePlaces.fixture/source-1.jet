Particle: struct {
    position: Int,
    velocity: Int,
}

run: fn() {
    ^particles: [Particle]{{position: 10, velocity: 2}, {position: 20, velocity: 3}, {position: 30, velocity: 4}}
    task.group g {
        left: particles[0].in_place()
        right: particles[2].in_place()
        a: task {
            left.position += left.velocity
            left.position
        }
        b: task {
            right.position += right.velocity
            right.position
        }
    }
}
