Particle: struct {
    position: Int,
    velocity: Int,
}

run: fn() {
    ^particles: [Particle]{{position: 10, velocity: 2}, {position: 20, velocity: 3}}
    task.group g {
        one: particles[0].in_place()
        two: particles[0].in_place()
        a: task {
            one.position += 1
            one.position
        }
        b: task {
            two.position += 1
            two.position
        }
    }
}
