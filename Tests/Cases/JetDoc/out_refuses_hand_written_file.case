# `jet doc --out <dir>` never overwrites a file that lacks the generated-file header: with a hand-written docs/index.md, `jet doc --out docs` exits non-zero with E2105 naming docs/index.md and writes nothing, while a directory of pages jet doc wrote is replaced.
fixture: OutRefusesHandWrittenFile.fixture
env: NO_COLOR=1

step hand: jet doc --out docs run.jet
exit: nonzero
stdout+stderr: ~ "Jet.DriverOperationFailed" # the registered driver-operation error
stdout+stderr: ~ "docs/index.md" # names the hand-written file
stdout+stderr: ~ "was not written by `jet doc`" # says why it is kept
file: docs/index.md == kept.md # the hand-written file is unchanged
file: docs/index.html absent # nothing is written beside it

step first: jet doc --out site run.jet
exit: 0
stdout: ~ "/site" # names the --out directory
file: site/index.md ~ "<!-- Generated by jet doc" # the generated-file header
file: site/index.md ~ "[Source](../run.jet#L" # links lead back to the source root

step again: jet doc --out site run.jet
exit: 0 # pages jet doc wrote are replaced
file: .jet/doc absent # --out takes the place of .jet/doc
