# `jet doc` writes index.html and index.md under the source root's `.jet/doc`, prints that path, and never writes docs/ in the source tree; the pages link two directories back to the sources, and a later run replaces the pages it wrote.
fixture: WritesUnderStateDir.fixture
env: NO_COLOR=1

step: jet doc run.jet
exit: 0
stdout: ~ "Doc: generated " # names the directory it wrote
stdout: ~ "/.jet/doc" # the state directory, not the source tree
file: .jet/doc/index.md ~ "<!-- Generated by jet doc" # the generated-file header
file: .jet/doc/index.md ~ "[Source](../../run.jet#L" # links lead back to the source root
file: .jet/doc/index.html ~ "<!-- Generated by jet doc" # the generated-file header
file: .jet/doc/index.html ~ "\"../../run.jet#L" # links lead back to the source root
file: docs absent # never docs/ in the source tree

step again: jet doc run.jet
exit: 0 # the pages jet doc wrote are its own to replace
file: docs absent # still nothing in the source tree
