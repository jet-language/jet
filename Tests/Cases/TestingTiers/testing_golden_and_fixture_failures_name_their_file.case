# core.testing: a golden or fixture read that fails names its file. A missing
# golden, a golden path that is a folder, a golden that differs (with its
# bounded diff) and a missing fixture each fail their own test; the same reads
# against a matching golden pass.
fixture: TestingGoldenAndFixtureFailuresNameTheirFile.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack

step failures: jet test --show-default --capture=all --serial failures.jet
exit: 1
stdout: ~ "0 passed, 4 failed, 0 skipped" # each failing read fails its own test
stderr: ~ "golden file is missing: goldens/missing.golden" # the missing golden is named
stderr: ~ "golden file cannot be read: goldens" # a folder is no golden
stderr: ~ "golden file differs: goldens/expected.golden" # the differing golden is named
stderr: ~ "-expected\n+actual\n" # with its diff
stderr: ~ "fixture is missing: goldens/missing.txt" # the missing fixture is named
file: goldens/missing.golden absent # a plain run writes no golden

step passes: jet test --show-default --capture=all --serial passes.jet
exit: 0
stdout: ~ "2 passed, 0 failed, 0 skipped" # the matching reads pass
