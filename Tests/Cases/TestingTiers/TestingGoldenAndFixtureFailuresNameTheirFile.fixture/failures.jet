// Each failing golden or fixture read names its file: a missing golden, a
// path that is a folder, a golden that differs (with its diff) and a missing
// fixture.
use testing: core.testing

#Test("missing golden") {
    assert(testing.golden("goldens/missing.golden", "actual\n"))
}

#Test("unreadable golden") {
    assert(testing.golden("goldens", "actual\n"))
}

#Test("mismatched golden") {
    assert(testing.golden("goldens/expected.golden", "actual\n"))
}

#Test("missing fixture") {
    assert_eq(testing.fixture("goldens/missing.txt"), "expected\n")
}
