# In the web build, local storage is the page's localStorage and a
# core.browser.host route runs its handler for each event of the element it
# selects: the program's run writes `tasks` and binds the input's route;
# typing in the input runs the handler, which reads the input's value
# (host.value and the event's payload) and writes `draft`.
requires: tool:node
fixture: WebEventsAndStorageRoundtrip.fixture
env: NO_COLOR=1
step: jet build --target=web tests/fixtures/web_api.jet
exit: 0
file: .jet/build/app.wasm is-file
copy: harness.mjs .jet/build/harness.mjs
step: node harness.mjs
cwd: .jet/build
exit: 0
stdout: = web_events_and_storage_roundtrip.stdout.expected
stderr: empty
