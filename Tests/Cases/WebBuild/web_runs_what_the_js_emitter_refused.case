# The wasm build lowers the whole program, so what the retired JS emitter
# refused before emission runs on the page as `jet run` runs it: a `[Float]`
# helper and a `#Export(wasm)` one, a strided list loop and a `chars()` loop
# in `#Target(JS)` functions, and the TUI backend's `frame_lines`.
requires: tool:node
fixture: WebRunsWhatTheJSEmitterRefused.fixture
env: NO_COLOR=1
step lists: jet run lists.jet
exit: 0
stdout: = "[1.5, -2.0]\n[3.0, 0.25]\n"
step: jet build --target web lists.jet
exit: 0
step: node app.js
cwd: .jet/build
exit: 0
stdout: == lists
stderr: empty
step loops: jet run loops.jet
exit: 0
stdout: = "4\n3\n"
step: jet build --target web loops.jet
exit: 0
step: node app.js
cwd: .jet/build
exit: 0
stdout: == loops
stderr: empty
step tui: jet run tui.jet
exit: 0
stdout: = "[]\n"
step: jet build --target web tui.jet
exit: 0
step: node app.js
cwd: .jet/build
exit: 0
stdout: == tui
stderr: empty
