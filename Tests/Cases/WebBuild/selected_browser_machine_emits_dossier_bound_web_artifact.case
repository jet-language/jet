# HAND-PORT tests/web_build.rs:4361-4417 selected_browser_machine_emits_dossier_bound_web_artifact
# The build is bound to the browser's machine: the manifest's `binding` and
# app.js's JET_TARGET_BINDING name the machine, its dossier and the module
# identities, and the host refuses to run when app.js's binding is not the
# manifest's. The output directory is beside the entry, which has no package.
requires: tool:node
fixture: SelectedBrowserMachineEmitsDossierBoundWebArtifact.fixture
env: NO_COLOR=1
step: jet build --target web Examples/features/web/web_compute.jet
exit: 0
file: Examples/features/web/.jet/build/app.wasm is-file
file: Examples/features/web/.jet/build/web.manifest.json ~ "\"runtimeLayer\": \"hosted\"" # original generated JavaScript predicate
file: Examples/features/web/.jet/build/web.manifest.json ~ "\"providerIdentity\": \"target-providers-v1:" # original generated JavaScript predicate
file: Examples/features/web/.jet/build/web.manifest.json ~ "\"runtimeIdentity\": \"sha256:" # was: ~ "\"preludeClosureIdentity\": \"prelude-closure-v1:" (the runtime partition the build links replaces the retired prelude closure)
file: Examples/features/web/.jet/build/web.manifest.json ~ "\"targetEnvironment\": \"browser\"" # original generated JavaScript predicate
file: Examples/features/web/.jet/build/web.manifest.json ~ "\"artifactIdentity\": \"sha256:" # original generated JavaScript predicate
file: Examples/features/web/.jet/build/web.manifest.json ~ "\"targetDossierIdentity\": \"sha256:" # original generated JavaScript predicate
file: Examples/features/web/.jet/build/app.js ~ "const JET_TARGET_BINDING" # was: ~ "const JET_TARGET_DOSSIER" (the retired emitter's name)
file: Examples/features/web/.jet/build/app.js ~ "runMain(wasm, JET_TARGET_BINDING)" # was: ~ "jet_web_verify_target_binding" (the host checks the binding it is handed)
step: node app.js
cwd: Examples/features/web/.jet/build
exit: 0
stdout: = selected_browser_machine_emits_dossier_bound_web_artifact.stdout.expected
copy: Examples/features/web/.jet/build/app.js app.before.js
capture: broken = text file.replace_first("artifactIdentity: \"", "artifactIdentity: \"mismatch-") Examples/features/web/.jet/build/app.js
write: Examples/features/web/.jet/build/app.js = "{cap:broken}"
file: Examples/features/web/.jet/build/app.js != app.before.js
step: node app.js
cwd: Examples/features/web/.jet/build
exit: nonzero
stdout: empty
stderr: ~ "target binding mismatch" # original fail-before-user-code diagnostic
