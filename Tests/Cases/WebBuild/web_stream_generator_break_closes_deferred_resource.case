# A generator's `Stream<T>` consumed by loops on the page: breaking a loop
# closes the producer and runs its deferred cleanup, and the page prints what
# the native run prints.
requires: tool:node
fixture: WebStreamGeneratorBreakClosesDeferredResource.fixture
env: NO_COLOR=1
step: jet build --target web main.jet
exit: 0
file: .jet/build/rt.wasm is-file
file: .jet/build/app.wasm is-file
step: node app.js
cwd: .jet/build
exit: 0
stdout: = web_stream_generator_break_closes_deferred_resource.stdout.expected
