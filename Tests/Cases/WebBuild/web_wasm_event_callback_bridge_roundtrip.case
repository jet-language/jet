# A DOM event's handler, bound by core.browser.host on in the web build,
# runs when the page dispatches the event: it calls the program's exported
# code and writes the page's localStorage.
requires: tool:node
fixture: WebWasmEventCallbackBridgeRoundtrip.fixture
env: NO_COLOR=1
step: jet build --target web main.jet
exit: 0
file: .jet/build/app.wasm is-file
copy: harness.mjs .jet/build/harness.mjs
step: node harness.mjs
cwd: .jet/build
exit: 0
stdout: = web_wasm_event_callback_bridge_roundtrip.stdout.expected
stderr: empty
