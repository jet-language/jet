# The web build's scene carries each node's ARIA role and accessible name, a
# repaint clears the ones a node no longer has and keeps the focus on the
# element in the focused one's place, and an entry in which two backends
# paint shows the last paint.
requires: tool:node
fixture: WebTypedTreeA11YFocusAndCleanupRoundtrip.fixture
env: NO_COLOR=1
step: jet build --target web main.jet
exit: 0
file: .jet/build/app.wasm is-file
copy: harness.mjs .jet/build/harness.mjs
step: node harness.mjs
cwd: .jet/build
exit: 0
stdout: = web_typed_tree_a11y_focus_and_cleanup_roundtrip.stdout.expected
stderr: empty
