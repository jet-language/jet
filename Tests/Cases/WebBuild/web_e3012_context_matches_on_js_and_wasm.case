# A stack overflow in a web build stops with the E3012 report `jet run` gives:
# the page host catches the engine's refusal of the call, names the innermost
# Jet function at its declaration line, quotes that line from the build's
# source map, and the program exits 70. A function pinned to `#Target(JS)`
# and one pinned to `#Target(Wasm)` report alike, as the build selects the
# whole program to WebAssembly.
requires: tool:node
fixture: WebE3012ContextMatchesOnJSAndWasm.fixture
env: NO_COLOR=1
step: jet run tests/fixtures/web_e3012_js_context.jet
exit: 70
stderr: = web_e3012_context_matches_on_js_and_wasm.js.stderr
step: jet build --target web tests/fixtures/web_e3012_js_context.jet
exit: 0
file: tests/fixtures/.jet/build/app.wasm.map is-file
step: node app.js
cwd: tests/fixtures/.jet/build
exit: 70
stdout: empty
stderr: = web_e3012_context_matches_on_js_and_wasm.js.stderr
step: jet run tests/fixtures/web_e3012_wasm_context.jet
exit: 70
stderr: = web_e3012_context_matches_on_js_and_wasm.wasm.stderr
step: jet build --target web tests/fixtures/web_e3012_wasm_context.jet
exit: 0
file: tests/fixtures/.jet/build/app.wasm.map is-file
step: node app.js
cwd: tests/fixtures/.jet/build
exit: 70
stdout: empty
stderr: = web_e3012_context_matches_on_js_and_wasm.wasm.stderr
