# A `String` parameter of `#Export(wasm)` functions keeps hostile text on the
# page: empty, tab and newline, Unicode. The wasm build calls the exports from
# the program itself; it has no JavaScript-callable export bridge yet, so the
# retired JS emitter's ABI harness has nothing to call.
requires: tool:node
fixture: WebWasmStringParamExportHostileRoundtrip.fixture
env: NO_COLOR=1
step: jet build --target web main.jet
exit: 0
file: .jet/build/app.wasm is-file
step: node app.js
cwd: .jet/build
exit: 0
stdout: = web_wasm_string_param_export_hostile_roundtrip.stdout.expected
stderr: empty
