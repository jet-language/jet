# A `#Target(JS)` function and a `#Export(wasm)` function each keep the
# assignment inside their `#Impure` region: the built page prints both
# values.
requires: tool:node
fixture: WebBackendsTraverseImpureRegions.fixture
env: NO_COLOR=1
step: jet build --target web --json main.jet
exit: 0
file: .jet/build/web.manifest.json ~ "\"target\": \"web\"" # the manifest names the web target
file: .jet/build/app.wasm is-file
step: node app.js
cwd: .jet/build
exit: 0
stdout: = web_backends_traverse_impure_regions.stdout.expected
