// The forms_table page without its server: the typed Person form's markup,
// rendered by the same `home` the app routes `/` to.
use web: core.web

#Web.Form
Person: struct {
    id: Int
    name: String
    active: Bool
}

save: fn(input: Person) -> String { "saved {input.name}" }

home: fn() -> WebPage {
    form: web.form(Person, action: save)
    form.set("id", "7") ?? panic("id set")
    form.set("name", "Ada") ?? panic("name set")
    web.page("People", form.render())
}

run: fn() {
    page: home()
    print(page.title)
    print(page.body)
}
