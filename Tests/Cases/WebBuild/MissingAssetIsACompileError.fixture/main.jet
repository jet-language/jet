// `brand/logo.svg` beside this file is a file of this package; no other path names one.
use ui: core.ui

logo: fn() -> String Never! { ui.asset("brand/logo.svg").path }

missing: fn() -> String Never! { ui.asset("brand/missing.svg").path }

outside: fn() -> String Never! { ui.asset("../main.jet").path }

folder: fn() -> String Never! { ui.asset("brand").path }

main: fn() {
    print(logo())
    print(missing())
    print(outside())
    print(folder())
}
