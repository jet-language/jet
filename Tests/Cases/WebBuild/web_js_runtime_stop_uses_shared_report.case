# A bounds stop in a web build leaves by its stop path to the runtime
# partition's root, which prints the shared E3010 report and exits 70: the
# page prints byte for byte what `jet run` prints.
requires: tool:node
fixture: WebJSRuntimeStopUsesSharedReport.fixture
env: NO_COLOR=1
step native: jet run tests/fixtures/web_js_runtime_stop.jet
exit: 70
stdout: empty
stderr: ~ "Stop: Jet.ArithmeticOrBoundsFailure: `the list has 1 item, so position 9 doesn't exist`\n  --> web_js_runtime_stop.jet:5:13 in run\n" # the report's head; the page's report is compared whole below
stderr: ~ "locals: n = 1\n" # the frame's locals
stderr: !~ "thread 'main' panicked" # no host panic under the report
step: jet build --target web tests/fixtures/web_js_runtime_stop.jet
exit: 0
file: tests/fixtures/.jet/build/app.wasm is-file
step: node app.js
cwd: tests/fixtures/.jet/build
exit: 70
stdout: empty
stderr: == native
