# A `[I64]` list through a `#Export(wasm)` function keeps its signed values
# on the page. The wasm build calls the export from the program itself; it has
# no JavaScript-callable export bridge yet, so the retired JS emitter's
# ownership-forging harness has nothing to call.
requires: tool:node
fixture: WebWasmFixedIntListRejectsForgedOwnership.fixture
env: NO_COLOR=1
step: jet build --target web main.jet
exit: 0
file: .jet/build/app.wasm is-file
step: node app.js
cwd: .jet/build
exit: 0
stdout: = web_wasm_fixed_int_list_rejects_forged_ownership.stdout.expected
stderr: empty
