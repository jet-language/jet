# A Result matched by its Ok and Err arms, an Option tested against `.None`
# and bound by `.Val(n)`, and a `.Val(n)` binding joined with `^^` give the
# same answers in `#Target(JS)` code and in `#Export(wasm)` functions: the
# built page prints both lines for each flag.
requires: tool:node
fixture: WebFallibleMatchAndOptionIfEmitOnJSAndWasm.fixture
env: NO_COLOR=1
step: jet build --target web --json main.jet
exit: 0
file: .jet/build/web.manifest.json ~ "\"target\": \"web\"" # the manifest names the web target
file: .jet/build/app.wasm is-file
step: node app.js
cwd: .jet/build
exit: 0
stdout: = web_fallible_match_and_option_if_emit_on_js_and_wasm.stdout.expected
