#Target(Web)

Choice: enum {
    Stop,
    _Keep,
}

#Target(JS)
count: fn(choice: Choice) -[]> Int {
    hits := 0
    loop _ in 0..<3 {
        if choice == {
            .Stop -> { break }
            ._Keep -> {}
        }
        hits += 1
    }
    return hits
}

#Target(JS)
run: fn() { print(count(.Stop)) }
