// A DOM event's handler calls back into the program's own exported code
// and writes the page's storage.
use {
    host: core.browser.host
    core.browser.storage.local
}

#Export(wasm)
double: fn(n: Int) -> Int { n * 2 }

#Target(JS)
init: fn() {
    host.on("#go", "click", fn(ev) {
        if double(21) == 42 -> print("42")
        local.set("clicked", "yes")
    })
}

run: fn() { init() }
