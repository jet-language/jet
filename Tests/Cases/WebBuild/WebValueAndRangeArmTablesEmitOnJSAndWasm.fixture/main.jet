#Target(Web)

#Target(JS)
digit: fn(n: Int) -> String {
    if n == {
        0 -> "0"
        1 -> "1"
        else -> "x"
    }
}

#Target(JS)
band: fn(n: Int) -> String {
    if n == {
        0..9 -> "low"
        else -> "high"
    }
}

#Export(wasm)
wasm_digit: fn(n: Int) -> String {
    if n == {
        0 -> "0"
        1 -> "1"
        else -> "x"
    }
}

#Export(wasm)
wasm_band: fn(n: Int) -> String {
    if n == {
        0..9 -> "low"
        10..19 -> "mid"
        else -> "high"
    }
}

run: fn() {
    loop n in 0..<21 { print("{n}: {digit(n)} {band(n)} {wasm_digit(n)} {wasm_band(n)}") }
}
