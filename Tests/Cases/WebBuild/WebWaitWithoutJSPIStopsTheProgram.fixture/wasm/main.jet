#Target(Web)

use {
    term: core.term
    time: core.time
}

// Prints `text` and flushes it, so the page has the line before the wait.
say: fn(text: String) {
    print(text)
    ^out: term.stdout()
    out.flush() ?? panic("flush")
}

run: fn() {
    say("before the wait")
    time.sleep(200ms)
    say("after the wait")
}
