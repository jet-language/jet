# A `[String]` list through `#Export(wasm)` functions keeps hostile text on
# the page: an empty list, an empty element, tab and newline, Unicode and
# several elements. The wasm build calls the exports from the program itself;
# it has no JavaScript-callable export bridge yet, so the retired JS emitter's
# ABI harness has nothing to call.
requires: tool:node
fixture: WebWasmListStringExportHostileRoundtrip.fixture
env: NO_COLOR=1
step: jet build --target web main.jet
exit: 0
file: .jet/build/app.wasm is-file
step: node app.js
cwd: .jet/build
exit: 0
stdout: = web_wasm_list_string_export_hostile_roundtrip.stdout.expected
stderr: empty
