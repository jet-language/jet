# An `if subject == .Val(value)` binding and a payload range arm give the same
# answers in `#Target(JS)` code and in a `#Export(wasm)` function: the built
# page prints each for 0 to 4, across both ends of the 1..3 range.
requires: tool:node
fixture: WebJSIfletEvaluatesSubjectOnceAndChecksPayloadRanges.fixture
env: NO_COLOR=1
step: jet build --target web --json main.jet
exit: 0
file: .jet/build/web.manifest.json ~ "\"target\": \"web\"" # the manifest names the web target
file: .jet/build/app.wasm is-file
step: node app.js
cwd: .jet/build
exit: 0
stdout: = web_js_iflet_evaluates_subject_once_and_checks_payload_ranges.stdout.expected
