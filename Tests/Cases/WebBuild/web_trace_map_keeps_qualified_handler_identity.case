# The web build's location table (app.wasm's `jet.lines`, which a trace's
# frames read) names an event handler by the function that binds it, module
# path included: the handler `handlers.init` binds stays apart from the
# top-level `init`, each with its source file.
requires: tool:node
fixture: WebTraceMapKeepsQualifiedHandlerIdentity.fixture
env: NO_COLOR=1
step: jet build --target=web tests/fixtures/web_qualified_handler.jet
exit: 0
file: .jet/build/app.wasm is-file
copy: trace.mjs .jet/build/trace.mjs
step: node trace.mjs
cwd: .jet/build
exit: 0
stdout: ~ "fn __jet_handlers_dinit tests/fixtures/web_qualified_handler.jet" # handlers.init keeps its module path
stdout: ~ "fn __jet_handlers_dinit.lambda@" # the handler it binds is named by it
stdout: ~ "fn init tests/fixtures/web_qualified_handler.jet" # the top-level init stays its own function
stderr: empty
