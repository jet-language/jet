Named: trait {
    name: fn(self) -> String
}

Point: struct {
    x: Int,
}

impl Point.Named {
    name: fn(self) -> String { "point" }
}

Pair: struct<A, B> {
    a: A,
    b: B,
}

impl Pair.Named {
    name: fn(self) -> String { "pair" }
}

describe: fn(value: Named) -> String {
    value.name()
}

run: fn() {
    items: [Named]{Point{x: 1}, Pair{a: 1, b: "two"}, Pair{a: "three", b: 4}}
    loop item in items -> print(item.name())
    print(describe(Pair{a: true, b: 5}))
}
