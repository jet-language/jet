# A trait value prints and interpolates as its concrete value: its box's type
# key selects the implementer, whose value renders as that type's own does, at
# the top level and inside a list, on every tier.
fixture: TraitValuePrints.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 0
stdout: = trait_value_prints.out
step: jet run -O1 main.jet
exit: 0
stdout: = trait_value_prints.out
step: jet run -O2 main.jet
exit: 0
stdout: = trait_value_prints.out
