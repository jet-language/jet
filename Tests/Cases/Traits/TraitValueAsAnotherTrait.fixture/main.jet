Shown: trait {
    show: fn(self) -> String,
}

Back: trait {
    back: fn(self) -> String,
}

Point: struct {
    x: Int,
}

impl Point.Shown {
    show: fn(self) -> String { "point {self.x}" }
}

impl Point.Back {
    back: fn(self) -> String { "back {self.x}" }
}

impl Shown.Back {
    back: fn(self) -> String { "shown back" }
}

take_back: fn(value: Back) -> String { value.back() }

pass: fn(value: Shown) -> String { take_back(value) }

run: fn() { print(pass(Point{x: 3})) }
