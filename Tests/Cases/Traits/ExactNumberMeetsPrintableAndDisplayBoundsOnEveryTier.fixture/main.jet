// An exact number literal is a `Decimal`, which interpolates through its
// Core Display: it meets `Printable` and `Display` bounds without
// importing core.math.
described: fn<T: Printable>(value: T) -> String { "<{value}>" }

displayed: fn<T: Display>(value: T) -> String { "[{value}]" }

run: fn() {
    print(described(2.5))
    print(described(0.125))
    print(displayed(2.5))
    print(described(7))
}
