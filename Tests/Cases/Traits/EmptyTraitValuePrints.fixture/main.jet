Point: struct {
    x: Int
    y: Int
}

Bare: trait {
}

impl Int.Bare {

}

impl String.Bare {

}

impl Point.Bare {

}

show_bare: fn(s: Bare) {
    print(s)
    print("bare: {s}")
}

run: fn() {
    show_bare(14)
    show_bare("hi")
    show_bare(Point{x: 1, y: 2})
    bare: [Bare]{14, "hi", Point{x: 1, y: 2}}
    print(bare)
    loop item in bare -> print(item)
}
