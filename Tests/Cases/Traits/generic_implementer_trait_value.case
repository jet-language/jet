# A trait value holds instantiations of a generic type that implements the
# trait, and a dynamic call reaches the implementation for each instantiation
# (in a list and as an argument) on every tier.
fixture: GenericImplementerTraitValue.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 0
stdout: = generic_implementer_trait_value.out
step: jet run -O1 main.jet
exit: 0
stdout: = generic_implementer_trait_value.out
step: jet run -O2 main.jet
exit: 0
stdout: = generic_implementer_trait_value.out
