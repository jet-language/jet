use core.math

Shown: trait {
    show: fn(self) -> String
}

impl math.Decimal.Shown {
    show: fn(self) -> String { "decimal {self.to_string()}" }
}

describe: fn(value: Shown) -> String {
    value.show()
}

run: fn() {
    items: [Shown]{2.5, 0.125}
    loop item in items -> print(item.show())
    print(describe(7.75))
}
