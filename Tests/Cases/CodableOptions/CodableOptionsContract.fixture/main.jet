use json: core.encoding.json

// `only: .Encode` writes without reading; `.Skip` keeps a field off the wire.
#Codable(only: .Encode)
Report: struct {
    title: String,
    #Codable(.Skip) cache: Int{7},
}

// `only: .Decode` reads without writing.
#Codable(only: .Decode)
Request: struct {
    id: Int,
}

Address: struct {
    city: String,
    zip: String,
}

// `unknown: .Deny` refuses unlisted keys; flattened keys count as listed.
#Codable(unknown: .Deny)
Customer: struct {
    name: String,
    #Codable(.Flatten) address: Address,
}

// `published` locks the wire shape and still honors the other options.
#Codable(unknown: .Deny, published) Account: struct {
    name: String,
}

// `tag: .Field("kind")` names the case under one key beside its fields.
#Codable(tag: .Field("kind"))
Shape: enum {
    Circle(radius: Int),
    Dot,
}

// `tag: .None` writes the payload alone.
#Codable(tag: .None)
Reading: enum {
    Number(Int),
    Label(String),
}

// No `tag:` keeps the case name as the outer key.
#Codable
Switch: enum {
    On,
    Level(Int),
}

// A distinct type codes as its base type with no option.
Meters: distinct Int

#Codable
Trip: struct {
    length: Meters,
}

attempt_customer: fn(label: String, raw: String) {
    value: json.decode<Customer>(raw) ?? {
        print("{label}: {err}")
        return
    }
    print("{label}: {value.name} {value.address.city} {value.address.zip}")
}

attempt_account: fn(label: String, raw: String) {
    value: json.decode<Account>(raw) ?? {
        print("{label}: {err}")
        return
    }
    print("{label}: {json.to_string(value) ?? panic("account")}")
}

reading_text: fn(value: Reading) -> String {
    if value == {
        .Number(number) -> "number {number}"
        .Label(text) -> "label {text}"
    }
}

run: fn() {
    print(json.to_string(Report{title: "q3", cache: 1}) ?? panic("report"))
    request: json.decode<Request>("{{\"id\":4}}") ?? panic("request")
    print("request {request.id}")

    attempt_customer("customer", "{{\"name\":\"Ada\",\"city\":\"Reno\",\"zip\":\"89501\"}}")
    attempt_customer("customer extra", "{{\"name\":\"Ada\",\"city\":\"Reno\",\"zip\":\"89501\",\"extra\":1}}")
    attempt_account("account", "{{\"name\":\"Bo\"}}")
    attempt_account("account extra", "{{\"name\":\"Bo\",\"extra\":1}}")

    circle: Shape.Circle{radius: 2}
    dot: Shape.Dot
    print(json.to_string(circle) ?? panic("circle"))
    print(json.to_string(dot) ?? panic("dot"))
    shape: json.decode<Shape>("{{\"kind\":\"Circle\",\"radius\":5}}") ?? panic("shape")
    if shape == {
        .Circle(radius) -> { print("circle {radius}") }
        .Dot -> print("dot")
    }

    print(json.to_string(Reading.Number(3)) ?? panic("number"))
    print(json.to_string(Reading.Label("hi")) ?? panic("label"))
    print(reading_text(json.decode<Reading>("8") ?? panic("reading number")))
    print(reading_text(json.decode<Reading>("\"lo\"") ?? panic("reading label")))

    print(json.to_string(Switch.On) ?? panic("on"))
    print(json.to_string(Switch.Level(3)) ?? panic("level"))

    trip: Trip{length: Meters.from_int(12)}
    wire: json.to_string(trip) ?? panic("trip")
    back: json.decode<Trip>(wire) ?? panic("trip back")
    print("{wire} {back.length == trip.length}")
}
