// try_guard_read/try_guard_edit answer None while another guard holds the
// permit, guard_read_within/guard_edit_within once their limit passes; a free
// permit gives the guard, which writes the cell and releases when it drops,
// also from inside an Option. Readers share: a read attempt beside a reader
// succeeds, and a writer that gave up does not hold the next reader back.

try_read: fn(cell: Shared<Int>) -> String {
    guard: cell.try_guard_read() ?? return "read refused"
    "read {guard.value}"
}

try_bump: fn(cell: Shared<Int>) -> String {
    guard: cell.try_guard_edit() ?? return "edit refused"
    guard.value += 1
    "edited to {guard.value}"
}

wait_read: fn(cell: Shared<Int>, limit: Duration) -> String {
    guard: cell.guard_read_within(limit) ?? return "read timed out"
    "read {guard.value} in time"
}

wait_bump: fn(cell: Shared<Int>, limit: Duration) -> String {
    guard: cell.guard_edit_within(limit) ?? return "edit timed out"
    guard.value += 10
    "edited to {guard.value} in time"
}

while_editing: fn(cell: Shared<Int>) {
    held: cell.guard_edit()
    print(try_read(cell))
    print(try_bump(cell))
    print(wait_read(cell, 20ms))
    print(wait_bump(cell, 20ms))
    held.value = 5
}

held_in_option: fn(cell: Shared<Int>) -> String {
    attempt: cell.try_guard_edit()
    if attempt == .Val(_) -> return "an Option holds the edit"
    "no edit"
}

while_reading: fn(cell: Shared<Int>) {
    reader: cell.guard_read()
    print(try_read(cell))
    print(try_bump(cell))
    print(wait_bump(cell, 1ms))
    print(try_read(cell))
    print("reader sees {reader.value}")
}

main: fn() {
    cell := Shared{1}
    while_editing(cell)
    print(try_bump(cell))
    print(held_in_option(cell))
    print(try_bump(cell))
    while_reading(cell)
    print(wait_bump(cell, 1s))
    print(wait_read(cell, 1s))
}
