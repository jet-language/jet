# A braced body's bare name is written as it was written. Under a list or
# map alias, a conversion or `Type`, the name is the body's value, not a
# field, so `top: top` would change what the literal builds; the program
# runs the same after `jet fmt`, and a written `y: y` stays as written.
fixture: FmtKeepsABareNameFieldAsWritten.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet fmt run.jet
exit: 0
file: run.jet ~ "rows: Grid<Int>{top, bottom}\n" # list alias items stay items
file: run.jet ~ "whole: Table<Int>{table}\n" # a map alias's whole map stays one value
file: run.jet ~ "warm: Celsius{reading}\n" # a conversion's source stays its one value
file: run.jet ~ "rock: Type{Rock}\n" # a type value stays the type
file: run.jet ~ "p: Point{x, y: y}\n" # each field as written
step: jet fmt --check run.jet
exit: 0
step: jet run run.jet
exit: 0
stdout: = "2 1 21.5 true 3\n"
