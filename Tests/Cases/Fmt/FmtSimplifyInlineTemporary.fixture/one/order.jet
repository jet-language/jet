announce: fn(text: String) -> Int {
    print(text)
    text.count_bytes()
}

run: fn() {
    width: announce("a")
    print(announce("b") + width)
    again: announce("c")
    print(again + again)
    kept: announce("d")

    print(kept)
    noted: announce("e")
    // the note stays
    print(noted)
    counter := announce("f")
    print(counter)
}
