total: fn(prices: [Int]) -> Int {
    sum := 0
    loop price in prices -> sum += price
    sum
}

spread: fn(prices: [Int]) -> Int {
    summed: total(prices)
    return summed - prices.len()
}

run: fn() {
    words: "a b c".split(" ").to_list()
    shown: spread([2, 4])
    print(shown)
    count: words.len()
    print(count)
    first: total([1])
    doubled: first * 2
    print(doubled)
    limit: total([5])
    if limit > 4 -> print("big")
}
