P: struct {
    x: Int,
}

run: fn() {
    ps := [P]{P{x: 0}}
    counts := [String:Int]{}
    total := 0
    p := P{x: 0}
    loop key in ([String]{"a", "b"}) {
        #Allow(Jet.HiddenCopyInLoop, "the key is small") counts[key] = 1
        #Allow(Jet.HiddenCopyInLoop, "an index's field") ps[0].x = 2
        #Allow(Jet.HiddenCopyInLoop, "a field") p.x = 2
        #Allow(Jet.HiddenCopyInLoop, "a local") total = 3
        #Allow(Jet.HiddenCopyInLoop, "a compound local") total += 1
        #Allow(Jet.HiddenCopyInLoop, "a compound index") counts[key] += 1
        #Allow(Jet.HiddenCopyInLoop, "a compound field") ps[0].x += 1
    }
    print("{total} {p.x} {counts.len()} {ps[0].x}")
}
