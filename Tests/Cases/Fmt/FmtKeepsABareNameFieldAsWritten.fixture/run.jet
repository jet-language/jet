Grid<T>: [[T]]

Table<V>: [String:V]

Celsius: struct {
    degrees: Float,

    impl From(Float) {
        from: fn(value: Float) -> Celsius { Celsius{degrees: value} }
    }
}

Rock: struct {
    weight: Int,
}

Point: struct {
    x: Int,
    y: Int,
}

run: fn() {
    top: [Int]{4, 5, 6}
    bottom: [Int]{7}
    rows: Grid<Int>{top, bottom}
    table: Table<Int>{"a": 1}
    whole: Table<Int>{table}
    reading: 21.5
    warm: Celsius{reading}
    rock: Type{Rock}
    x: 1
    y: 2
    p: Point{x, y: y}
    print("{rows.len()} {whole.len()} {warm.degrees} {rock == Rock} {p.x + p.y}")
}
