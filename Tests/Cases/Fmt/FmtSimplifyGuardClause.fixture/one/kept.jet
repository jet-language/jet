// Left alone: a comment sits beside the branch that would move.
noted: fn(n: Int) {
    if n > 0 -> print(n) else {
        // nothing to print
        return
    }
}

// Left alone: both branches do work.
both: fn(n: Int) {
    if n > 0 -> print(n + 1) else -> print(n - 1)
}

// Left alone: both branches leave.
leaves: fn(n: Int) {
    if n > 0 {
        return
    } else { panic("negative") }
}

run: fn() {
    noted(3)
    noted(0)
    both(1)
    leaves(1)
}
