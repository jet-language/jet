TextError: enum { Empty }

Pattern: distinct String

impl Pattern.CheckedText {
    Error: TextError,

    check: fn(parts: [String]) -[]> Checked<[String], TextSlot> Err! {
        if parts.join("") == "" { return Err(TextError.Empty) }
        return Ok(Checked{shape: parts.copy(), slots: [TextSlot]{}})
    }

    encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> String {
        return "[{value}]"
    }
}

render: fn(value: Pattern) {
    #Unsafe("formatter fixture") {
        print(value.raw())
    }
}

run: fn() {
    id: 42
    value: Pattern{"value {id}"}
    render(value)
}
