// Every place a changeable name or a write window is written.
Pair: struct {
    lo: Int,
    hi: Int,
}

Shape: enum {
    Dot(Int),
    Line(Int),
}

#Persist visits := 0

hits := 0

grow: fn(shape: ^Shape) {
    if ^shape == {
        .Dot(size) -> { size += 1 }
        .Line(size) -> size += 2
    }
}

bump: fn(slot: ^Int?) {
    if ^slot == .Val(value) -> value += 10
}

size_of: fn(shape: Shape) -> Int {
    if shape == {
        .Dot(size) -> size
        .Line(size) -> size
    }
}

run: fn() {
    count := 0
    count += 1
    _ := count
    {lo, hi} := {lo: 1, hi: 2}
    lo += hi
    Pair{lo: low, ..} := Pair{lo: 5, hi: 6}
    low += 1
    { lo: base, hi: top } := {lo: 3, hi: 4}
    base += top
    [first, second] := [10, 20]
    first += second
    total := 0
    loop i := 0, i < 3 {
        total += i
        i += 1
    }
    squares: loop i := 0, i < 3, i += 1 -> i * i
    xs := [1, 2, 3]
    slot: ^xs[0]
    slot = 7
    other := ^xs[1]
    other = 8
    loop x in ^xs -> total += x
    shape := Shape.Dot(1)
    grow(shape)
    maybe := Int?{Val(1)}
    bump(maybe)
    bumped: maybe ?? 0
    print("{count} {lo} {hi} {low} {base} {first} {total} {squares.len()} {xs[0]} {xs[1]} {xs[2]} {size_of(shape)} {bumped} {hits} {visits}")
}
