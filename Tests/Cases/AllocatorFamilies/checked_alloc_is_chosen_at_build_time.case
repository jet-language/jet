# `--checked-alloc` (the checked_alloc build option) links the runtime's
# checked memory allocator, which a build without it does not link at all:
# the unchecked image has none of its code, the checked one its start-up
# hook, and both print the same. Every image keeps the allocator's two code
# words, `jet_rt_alloc_check_take_code` and `..._give_code` (0 unless the
# checked allocator starts), for `jet debug`'s in-process evaluation, so the
# unchecked image is checked for the allocator's functions by name.
# `jet run --checked-alloc` links the runtime pack in full (the prelinked
# runtime image holds no checked allocator). The
# web runtime partition holds none either: a web build runs unchecked, and
# `--checked-alloc` with `--target web` is refused.
# Compiler/JetRuntime/Tests/RunAllocParity.jet covers the checked traps.
fixture: CheckedAllocIsChosenAtBuildTime.fixture
env: NO_COLOR=1
step: jet build main.jet
exit: 0
step: {work}/.jet/build/main
exit: 0
stdout: = "part0,part1,part2\n"
step: jet debug .jet/build/main --do symbols
exit: 0
stdout: ~ "jet_rt_alloc_check_take_code" # the listing holds the code word every image keeps,
stdout: !~ "jet_rt_alloc_check_init" # but the unchecked image links none of the checked allocator: not its start-up hook,
stdout: !~ "jet_rt_alloc_check_sweep" # its exit sweep,
stdout: !~ "unit.alloc_check_fail" # or its failure report
step: jet build --checked-alloc main.jet
exit: 0
step: {work}/.jet/build/main
exit: 0
stdout: = "part0,part1,part2\n"
step: jet debug .jet/build/main --do symbols
exit: 0
stdout: ~ "jet_rt_alloc_check_init" # the checked image links its start-up hook
step: jet run --checked-alloc main.jet
exit: 0
stdout: = "part0,part1,part2\n"
when tool node
step: jet build --target web main.jet
exit: 0
step web: node app.js
cwd: .jet/build
exit: 0
stdout: = "part0,part1,part2\n" # the web runtime starts no checked heap
end when
step: jet build --target web --checked-alloc main.jet
exit: 2
stderr: ~ "Error: Jet.InvalidCommandInput: `--checked-alloc` asks for the checked allocator, and a web build has none" # refused before the build, not at link
