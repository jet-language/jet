// package.jet caps the counting program allocator at 64 MB. One 40 MB list
// fits; a second one beside it is over the cap and is refused without
// aborting; once the first ends with its match arm, its bytes come back, so a
// new 40 MB list fits again, and twenty more, each freed before the next, all
// fit. The first list ends with its scope rather than by `held = [Int]{}`,
// which empties a sole owner in place and keeps its buffer.
reserve: fn(count: Int) -> [Int] AllocError! { List.try_with_capacity(count) }

// Whether a 40 MB list fits; the list ends before this returns.
fits: fn() -> Bool {
    if reserve(5_000_000) == {
        .Ok(_values) -> true
        .Err(_error) -> false
    }
}

run: fn() {
    if reserve(5_000_000) == {
        .Ok(first) -> {
            print("a 40 MB list fits under the cap")
            if {
                fits() -> print("a second 40 MB list fit beside the first")
                else -> print("a second 40 MB list beside the first is over the cap")
            }
            print("the first is still held, with {first.len()} items")
        }
        .Err(_error) -> print("a 40 MB list was refused")
    }
    if {
        fits() -> print("after the first is freed, a 40 MB list fits again")
        else -> print("after the first is freed, a 40 MB list was still refused")
    }
    ^fitted: 0
    loop _ in 0..<20 {
        if fits() -> fitted += 1
    }
    print("40 MB lists freed one after another: {fitted} of 20 fit")
}
