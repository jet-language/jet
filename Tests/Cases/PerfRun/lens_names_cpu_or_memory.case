# `--lens` names `cpu`, `memory` or both, comma-separated. Any other word,
# or an empty list, is refused before the program builds, with the lenses
# it may name. `--method` is no flag of `jet perf run`: it reaches the
# program's run, which refuses it as a flag jet does not understand. The
# memory lens samples counters only under `jet perf run`, so `jet perf test`
# refuses it.
requires: os-name:linux
requires: arch:x86_64
fixture: MemoryCountersPerLine.fixture
env: NO_COLOR=1
step: jet perf run --lens=heap walk.jet --out {work}/heap.jettrace
exit: 2
stderr: ~ "`--lens` item `heap` is not a lens; lenses: cpu, memory"
step: jet perf run --lens= walk.jet --out {work}/none.jettrace
exit: 2
stderr: ~ "`--lens` needs `cpu`, `memory` or both, comma-separated"
step: jet perf run --method=memory walk.jet --out {work}/method.jettrace
exit: 2
stderr: ~ "`--method` isn't a flag jet understands"
step: jet perf test --lens=memory walk.jet
exit: 2
stderr: ~ "the `memory` lens samples a program's counters, which only `jet perf run` samples"
