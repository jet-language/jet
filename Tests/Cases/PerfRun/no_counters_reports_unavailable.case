# A host whose kernel refuses every counter: strace makes each
# perf_event_open the program makes fail with ENOENT, as on a CPU or VM
# that has none of the events. `jet perf run --method=memory` still
# profiles the CPU time. Each counter is reported unavailable with the
# kernel's errno, and the profile's reason says why. No row holds a count
# for any of them, zero or otherwise.
requires: os-name:linux
requires: arch:x86_64
requires: tool:strace
fixture: MemoryCountersPerLine.fixture
env: NO_COLOR=1
step: strace -f -qq -o /dev/null -e trace=perf_event_open -e inject=perf_event_open:error=ENOENT {jet} perf run --method=memory walk.jet --out {work}/walk.jettrace
exit: 0
stdout: = "lines=35184363700224 pages=35184363700224 hops=35183996698624\n"
json: file walk.jettrace doc $.content.profile.method = "memory"
json: file walk.jettrace doc $.content.profile.counters #= 4
json: file walk.jettrace doc $.content.profile.counters[?status="unavailable"][?errno=2] #= 4
json: file walk.jettrace doc $.content.profile.counters[?period=null] #= 4
json: file walk.jettrace doc $.content.profile.rows #>= 1 # the CPU-time profile is still there
json: file walk.jettrace doc $.content.profile.rows[?l1d_miss_count!=null] #= 0 # never a zero count, nor any count
json: file walk.jettrace doc $.content.profile.rows[?llc_miss_count!=null] #= 0
json: file walk.jettrace doc $.content.profile.rows[?dtlb_miss_count!=null] #= 0
json: file walk.jettrace doc $.content.profile.rows[?page_fault_count!=null] #= 0
json: file walk.jettrace doc $.content.profile.reason ~ "l1d_misses unavailable: the kernel refused the counter (errno 2)"
step: jet perf view {work}/walk.jettrace
exit: 0
stdout: ~ "counter l1d_misses unavailable errno=2"
stdout: !~ " l1d_misses="
