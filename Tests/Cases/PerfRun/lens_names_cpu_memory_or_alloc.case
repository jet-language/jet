# `--lens` names one or more of `cpu`, `memory` and `alloc`,
# comma-separated. Any other word, or an empty list, is refused before the
# program builds, with the lenses it may name. `--method` is no flag of
# `jet perf run`: it reaches the program's run, which refuses it as a flag
# jet does not understand. The memory lens samples counters and the alloc
# lens snapshots the heap only under `jet perf run`, so `jet perf test`
# refuses either.
requires: os-name:linux
requires: arch:x86_64
fixture: MemoryCountersPerLine.fixture
env: NO_COLOR=1
step: jet perf run --lens=heap walk.jet --out {work}/heap.jettrace
exit: 2
stderr: ~ "`--lens` item `heap` is not a lens; lenses: cpu, memory, alloc" # the word, and the lenses it may be
step: jet perf run --lens= walk.jet --out {work}/none.jettrace
exit: 2
stderr: ~ "`--lens` needs one or more of `cpu`, `memory` and `alloc`, comma-separated" # an empty list names no lens
step: jet perf run --method=memory walk.jet --out {work}/method.jettrace
exit: 2
stderr: ~ "`--method` isn't a flag jet understands" # the retired flag is no spelling of a lens
step: jet perf test --lens=memory walk.jet
exit: 2
stderr: ~ "The `memory` lens samples a program's counters, which only `jet perf run` samples" # refused under `jet perf test`
step: jet perf test --lens=alloc walk.jet
exit: 2
stderr: ~ "The `alloc` lens snapshots a program's heap, which only `jet perf run` snapshots" # refused under `jet perf test`
