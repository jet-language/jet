// A fill and three walks over arrays of Ints, their length from the
// command line so nothing folds at compile time. The fill (line 14) faults
// the array's pages in. The first walk reads one element per 64-byte cache
// line. The second reads one element per 4160 bytes, a page and a line
// apart, which no prefetcher follows across the page, so nearly every read
// misses L1D, and the dTLB once the array outgrows what the TLBs map. The
// third hops at random through a table larger than an L3 (line 44).
use core.process

run: fn() {
    args: process.args()
    count: if args.len() > 0 -> Int.parse(args[args.len() - 1]) ?? 4194304 else -> 4194304
    data := [Int]{}
    loop index in 0..<count { data.push(index) }
    lines := 0
    loop _ in 0..<4 {
        loop start in 0..<8 {
            at := start
            loop at < count {
                lines += data[at]
                at += 8
            }
        }
    }
    pages := 0
    loop _ in 0..<4 {
        loop start in 0..<520 {
            at := start
            loop at < count {
                pages += data[at]
                at += 520
            }
        }
    }
    // Four times the array, 128 MiB by default: each hop's address comes
    // from a linear congruential step no prefetcher predicts, so most hops
    // miss the LLC.
    table := [Int]{}
    loop index in 0..<count * 4 { table.push(index) }
    hops := 0
    spot := 0
    loop _ in 0..<count {
        spot = (spot * 1103515245 + 12345) % (count * 4)
        hops += table[spot]
    }
    print("lines={lines} pages={pages} hops={hops}")
}
