# Port of tests/jetpack_criterion2.rs:11-63, card297 criterion2.
env: NO_COLOR=1
env: JETPACK_ROOT={work}/root
env: JETPACK_SHARED_CAS={work}/shared
requires: os:unix
mkdir: root
mkdir: shared
mkdir: stale-src
mkdir: fresh-src
write: stale-src/payload = "fixture payload: criterion2-stale"
write: fresh-src/payload = "fixture payload: criterion2-fresh"
step: jetpack hangar ingest stale-src --name stale --version 1.0 --ref fixture:criterion2-stale --source-fingerprint sha256-fixture-source-criterion2-stale --recipe-fingerprint sha256-fixture-recipe-criterion2-stale --policy-fingerprint policy=fixture --provenance fixture --last-used-at 1 --json --no-color
exit: 0
capture: stale_id stdout doc $.id
step: jetpack hangar ingest fresh-src --name fresh --version 1.0 --ref fixture:criterion2-fresh --source-fingerprint sha256-fixture-source-criterion2-fresh --recipe-fingerprint sha256-fixture-recipe-criterion2-fresh --policy-fingerprint policy=fixture --provenance fixture --json --no-color
exit: 0
capture: fresh_id stdout doc $.id
mkdir: root/hangar/nix-index
write: root/hangar/nix-index/payload = "metadata missing"
step: jetpack hangar clean --no-color --yes
exit: 0
file: root/hangar/{cap:stale_id} absent
file: root/hangar/{cap:fresh_id} exists
file: root/hangar/nix-index absent
# Original read_dir result must contain ONE filename with BOTH substrings;
# two unrelated filename matches must never satisfy this assertion.
entries: root/hangar/quarantine name ~ nix-index name ~ missing-metadata >= 1 # original compound predicate: one entry names both
stderr: ~ "quarantined 1 invalid object" # original predicate
stderr: ~ "clean" # original predicate
