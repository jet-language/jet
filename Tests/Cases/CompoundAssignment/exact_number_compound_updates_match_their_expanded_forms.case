# An exact-number update written as `place op= value` checks and runs as
# `place = place op value` does: a Decimal or Fraction local made by
# `Decimal("0")` (or a Decimal quotient) takes a value read from a
# `[Decimal]`/`[Fraction]` parameter, which is the same type, and lifts an Int
# operand. A Decimal field of a parameter updates the same way. `jet fmt`
# writes the expanded file in the compound form, and that output checks and
# runs with the same results.
fixture: ExactNumberCompoundUpdatesMatchTheirExpandedForms.fixture
env: NO_COLOR=1
step: jet run updates.jet
cwd: compound
exit: 0
stdout: = "16.50\n10.75\n1.5\n"
step: jet run updates.jet
cwd: expanded
exit: 0
stdout: = "16.50\n10.75\n1.5\n"
step: jet fmt updates.jet
cwd: expanded
exit: 0
file: expanded/updates.jet ~ "    loop value in values -> total += value\n    total += 2\n    total -= Decimal(\"0.25\")\n    total *= 3\n" # the Decimal local's updates are written compound
file: expanded/updates.jet ~ "credit: fn(wallet: ^Wallet, value: Decimal) { wallet.total += value }\n" # so is the parameter's Decimal field update
file: expanded/updates.jet ~ "    loop value in values -> total += value\n    total += 1\n" # and the Fraction local's
step: jet run updates.jet
cwd: expanded
exit: 0
stdout: = "16.50\n10.75\n1.5\n"
