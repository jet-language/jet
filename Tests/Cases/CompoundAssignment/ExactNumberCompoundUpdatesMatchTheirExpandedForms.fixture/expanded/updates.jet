// Each update written out as `place = place op value`;
// ../compound/updates.jet writes the same updates as `place op= value`.
Wallet: struct {
    total: Decimal,
}

sum: fn(values: [Decimal]) -> Decimal {
    ^total: Decimal("0")
    loop value in values -> total = total + value
    total = total + 2
    total = total - Decimal("0.25")
    total = total * 3
    total
}

credit: fn(wallet: ^Wallet, value: Decimal) { wallet.total = wallet.total + value }

share: fn(values: [Fraction]) -> Fraction {
    ^total: Decimal("0") / Decimal("1")
    loop value in values -> total = total + value
    total = total + 1
    total
}

run: fn() {
    print(sum([Decimal]{Decimal("1.5"), Decimal("2.25")}))
    ^wallet: Wallet{total: Decimal("10")}
    credit(wallet, Decimal("0.75"))
    print(wallet.total)
    print(share([Fraction]{Decimal("1") / Decimal("3"), Decimal("1") / Decimal("6")}))
}
