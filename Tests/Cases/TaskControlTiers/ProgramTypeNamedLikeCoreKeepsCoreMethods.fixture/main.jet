use jobs

// The program's own `Task<T>`, `Sender<T>` and `Receiver<T>`, each with
// methods named like the handles' own: a lookup of the bare name in this
// module would give a task handle or a channel endpoint these methods.
Task: struct<T> {
    id: Int
    value: T

    join: fn(self) -> String { "program task {self.id} joined" }

    // `self` is the program's `Task` too: its `join` is this type's.
    detach: fn(self) -> String { "{self.join()}, then detached" }
}

Sender: struct<T> {
    id: Int
    value: T

    send: fn(self) -> String { "program sender {self.id} sent" }
}

Receiver: struct<T> {
    id: Int
    value: T

    receive: fn(self) -> String { "program receiver {self.id} received" }
}

// Aliases to a program `Task`: generic, and a path to the imported one.
Later<T>: Task<T>

Assignment: jobs.Task

make: fn(id: Int) -> Task<Int> { Task<Int>{id: id, value: 0} }

later: fn(id: Int) -> Later<Bool> { Task<Bool>{id: id, value: true} }

assign: fn(id: Int) -> Assignment { jobs.Task{id: id} }

run: fn() {
    // The program's types keep their own methods, however their values are
    // typed: a literal, a signature, a generic alias, an import and an alias
    // to it.
    written: Task<String>{id: 1, value: "first"}
    print(written.join())
    print(make(2).detach())
    print(later(3).join())
    imported: jobs.Task{id: 4}
    print(imported.join())
    print(assign(5).join())
    outbox: Sender<Int>{id: 6, value: 0}
    print(outbox.send())
    inbox: Receiver<Int>{id: 7, value: 0}
    print(inbox.receive())
    // Core's handles keep Core's methods beside them, and cross into tasks.
    { sender: results, receiver: arrivals }: channel<Int>()
    messenger: task { results.send(40) }
    messenger.detach()
    worker: task { (arrivals.receive() ?? 0) + 2 }
    print("worker joined {worker.join() ?? 0}")
}
