# A cancel or a passed deadline reaches a task spinning on an Atomic<I64>
# load, a loop whose only work is the word's read. That read is one inline
# mov that makes no call and has no stop poll after it, so the turn check
# each iteration starts with is what stops it. A race returns its winner,
# a canceled waiter unwinds through its deferred close, and a waiter whose
# `task.timeout` passes stops with the deadline failure. Without that
# delivery, the race and the joins never return and the run steps time out.
# Worker-run under -O0 and -O2 on a compiler that still calls the atomic
# routine.
fixture: ACancelOrDeadlineStopsALoopSpinningOnAnAtomicWordOnEveryTier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run -O0 main.jet
exit: 0
stdout: = "7\nclose the waiter's marker\nthe waiter: cancelled\nthe timed waiter: deadline\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "7\nclose the waiter's marker\nthe waiter: cancelled\nthe timed waiter: deadline\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "7\nclose the waiter's marker\nthe waiter: cancelled\nthe timed waiter: deadline\n"
step: jet build -O2 main.jet
exit: 0
step aot: built
exit: 0
stdout: = "7\nclose the waiter's marker\nthe waiter: cancelled\nthe timed waiter: deadline\n"
