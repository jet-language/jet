# A hand-built value prints so that it parses back to itself, an operand
# looser than its place parenthesized through the rule's grouping
# alternative. A value the grammar cannot print (a text field that is not
# one whole token of its kind, a missing or extra list element, a loose
# operand with no grouping alternative) is a GrammarError at the line and
# column of the text printed so far, and print_into leaves its output as it
# was, at every tier.
fixture: PrintChecksHandBuiltValues.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 0
step o0: jet run -O0 main.jet
exit: 0
stdout: = "(1+2)*3 => Mul((Add(1 + 2)) * 3)\n1-(2-3) => Add(1 - (Add(2 - 3)))\n(2^3)^2 => Pow((Pow(2, 3)), 2)\n(-2)^2 => Pow((Neg(2)), 2)\n(-f)(1) => (Neg(f))(1)\nerror 1:1: expected NUM for `value`, found \"x\"\nerror 1:2: expected \"+\" or \"-\" for `op`, found \"*\"\ninto > 1+2\ninto error 1:3: expected IDENT for `name`, found \"9\", out > 1+2\nerror 1:5: expected a value for `values`, found none\nerror 1:3: expected a value for `items`, found none\nerror 1:6: expected \"+\" or \"-\" for `sign`, found \"*\"\na,b\nerror 1:4: expected the end of `items`, found another element\nerror 1:3: expected a value for `items`, found none\n1*2+1\nerror 1:1: expected a value that binds as tightly as its place, found `Plus`, which the grammar cannot parenthesize\nerror 1:3: expected a value that binds as tightly as its place, found `Plus`, which the grammar cannot parenthesize\nerror 2:1: expected KEY for `name`, found \"a\\n[admin]\"\n"
step o2: jet run -O2 main.jet
exit: 0
stdout: == o0
