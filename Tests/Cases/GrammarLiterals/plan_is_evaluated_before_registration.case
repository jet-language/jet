# A grammar's plan is computed before the program registers: one compile of
# the declaring bindings alone, cut from their modules, evaluates every
# declaring literal at once, and the trace names each plan it computed. The
# rest of the program (its other bindings, functions and statements) is not
# part of that compile. A literal the grammar check refuses computes no plan,
# and its faults are reported once, by the compile proper.
fixture: PlanIsEvaluatedBeforeRegistration.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check --trace=good.json good/main.jet
exit: 0
file: good.json ~ "{\"name\":\"Pair\",\"cat\":\"grammar.plan\"" # the imported-item head's plan
file: good.json ~ "{\"name\":\"Words\",\"cat\":\"grammar.plan\"" # the module-alias head's plan
file: good.json !~ "{\"name\":\"LIMIT\",\"cat\":\"grammar.plan\"" # an ordinary constant is no grammar
step: jet check --json --trace=bad.json bad/main.jet
exit: nonzero
file: bad.json !~ "\"cat\":\"grammar.plan\"" # the refused literal has no plan
json: stdout doc $.reports[?code="E2712"] #= 1 # its fault is reported once
