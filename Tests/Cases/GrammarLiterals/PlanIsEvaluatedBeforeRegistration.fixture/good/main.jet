// Two grammar-declaring bindings, one head an imported item and one through
// a module alias, beside an ordinary constant, a function and `run`.
use core.grammar.[Grammar]
use rules: core.grammar

LIMIT: 3

Pair: Grammar{"""
    pair : key=WORD '=' value=WORD ;
    WORD : [a-z]+ ;
    WS : [ \t]+ -> skip ;
    """}

Words: rules.Grammar{"""
    words : (items+=WORD)+ ;
    WORD : [a-z]+ ;
    WS : [ \t]+ -> skip ;
    """}

count: fn(text: String) -> Int {
    text.len() + LIMIT
}

run: fn() {
    print(count("ab"))
}
