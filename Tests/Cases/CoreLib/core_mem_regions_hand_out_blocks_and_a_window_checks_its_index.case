# core.mem's Region and Block methods called on their own types. A
# reserved region's remaining bytes shrink as claim hands out blocks in
# address order, a claim at alignment 3 is refused, Block.join grows a block
# over its neighbor, Region.adopt wraps a claimed block's bytes and hands
# out a block at its start, and close ends both regions, on every
# optimization level and the built artifact. window.jet reads a `mem.window`
# View tied to its heap block inside and outside it, and is checked only.
fixture: CoreMemRegionsHandOutBlocksAndAWindowChecksItsIndex.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check window.jet
exit: 0
step: jet run -O0 main.jet
exit: 0
stdout: = "claimed 64 of 4096, first at 0, joined 64 bytes, alignment 3 refused true\nadopted 256 bytes, 240 left, piece at the host's start true\n3 blocks kept\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "claimed 64 of 4096, first at 0, joined 64 bytes, alignment 3 refused true\nadopted 256 bytes, 240 left, piece at the host's start true\n3 blocks kept\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "claimed 64 of 4096, first at 0, joined 64 bytes, alignment 3 refused true\nadopted 256 bytes, 240 left, piece at the host's start true\n3 blocks kept\n"
step: jet build -O2 main.jet
exit: 0
step aot: built
exit: 0
stdout: = "claimed 64 of 4096, first at 0, joined 64 bytes, alignment 3 refused true\nadopted 256 bytes, 240 left, piece at the host's start true\n3 blocks kept\n"
