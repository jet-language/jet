use {
    event: core.event
    watcher: core.watcher
    signals: "./signals"
}

watch_here: fn(scope: EventScope) -[FS, IO]> Subscription IOError! {
    handle: watcher.files(".") ?? return Err(err)
    Ok(handle.on(scope, fn(change: watcher.WatchEvent) { print(change.path) }))
}

run: fn() {
    scope: event.scope()
    bus: event.new<Int>()
    ^_: bus.on(scope, fn(value: Int) { print("got {value}") })
    print(bus.emit(7).summary())
    print("listeners={bus.listener_count()}")
    print(signals.label(signals.Event.Started))
}
