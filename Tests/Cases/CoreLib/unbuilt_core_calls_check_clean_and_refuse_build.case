# A Core call no `jet` has built yet (E2104 "not built yet") is refused only by
# a compile that lowers it: `jet check` lowers nothing and passes, while
# `jet build` refuses the call at its site, citing the card that ports it.
fixture: Fixtures/UnbuiltCoreCalls

# The configured HTTP client's transport is unbuilt: `http.Client.new()` and
# its builders are Core source and lower like any Core call, but
# `Client.send` has no transport yet. The send is refused at its site, so no
# call to it reaches the backend.
step: jet check http_client.jet
exit: 0
stderr: !~ "Jet.InvalidCommandInput" # check mode lowers nothing, so nothing is refused

step: jet build http_client.jet
exit: 1
stderr: ~ "Error: Jet.InvalidCommandInput: `Client.send` is not built yet" # the client's transport is unbuilt
stderr: ~ "card #3665" # the refusal names the card that ports it
stderr: !~ "Internal compiler error" # sema refuses before codegen
