# Values the checker owns with no source declaration (a bit set, a range, a
# file error) print through their runtime handle row's display or show form:
# bare, interpolated and in a list, at every optimization level.
fixture: Fixtures/CoreRuntimeShownValuesRender
step: jet run -A fixture.jet
stdout: = core_runtime_shown_values_render.out
stderr: empty
step: jet run -A -O1 fixture.jet
stdout: = core_runtime_shown_values_render.out
stderr: empty
step: jet run -A -O2 fixture.jet
stdout: = core_runtime_shown_values_render.out
stderr: empty
