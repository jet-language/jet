// core.ui's Point, Size and Rect print, interpolate and Debug-render as the
// plain structs Core declares them: the derived struct form, bare, inside a
// list and inside an Option.
use ui: core.ui

run: fn() {
    p: ui.Point{x: 1.5, y: 2.0}
    s: ui.Size{width: 3.0, height: 4.0}
    r: ui.Rect{x: 0.5, y: 1.0, width: 3.0, height: 4.0}
    print(p)
    print("{p}")
    print("{p:Debug}")
    print(s)
    print("{s}")
    print("{s:Debug}")
    print(r)
    print("{r}")
    print("{r:Debug}")
    points: [ui.Point]{p, ui.Point{x: -1.0, y: 0.25}}
    print(points)
    print("{points:Debug}")
    found: ui.Rect?{Val(r)}
    print("{found:Debug}")
}
