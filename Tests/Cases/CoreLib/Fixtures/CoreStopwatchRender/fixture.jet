use time: core.time

Lap: struct {
    name: String,
    watch: time.Stopwatch,
}

run: fn() {
    watch: time.Stopwatch{start_ns: 5}
    print(watch)
    print("{watch}")
    print("{watch:Debug}")
    lap: Lap{name: "first", watch: watch}
    print(lap)
    print("{lap:Debug}")
    print([time.Stopwatch]{watch})
    copied: watch.copy()
    print(copied.start_ns == watch.start_ns)
}
