
use {
    http: core.http
    mime: core.net.mime
    files: core.files
}

run: fn() {
    print(http.Method.custom("PURGE") ?? panic("method"))
    print(http.Status.new(299) ?? panic("status"))
    print(http.Version.http_1_1())
    print(http.HeaderName.new("X-Test") ?? panic("name"))
    print(http.HeaderValue.new("ok") ?? panic("value"))
    print(http.body_empty().bytes(1) ?? panic("empty"))
    print(http.body_bytes([0, 255]).bytes(2) ?? panic("bytes"))
    print(http.body_text("hello").text(5) ?? panic("text"))
    custom: mime.parse("text/custom") ?? panic("mime")
    print(http.body_typed_text("hello", custom.to_string()).text(5) ?? panic("custom"))
    print(http.body_form(["a": "b"]).text(16) ?? panic("form"))
    print(http.body_json(42).json<Int>(16) ?? panic("json"))
    input: files.open("{work}/input") ?? panic("open")
    body: http.body_reader_sized(input, 6) ?? panic("reader")
    output: files.create("{work}/output") ?? panic("create")
    print(body.copy_to(output, 6) ?? panic("copy"))
}
