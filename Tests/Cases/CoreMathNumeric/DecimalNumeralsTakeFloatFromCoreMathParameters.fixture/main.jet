// A written decimal numeral passed to a core.math function whose parameter is
// Float takes Float from that parameter, as any source call's argument does.
// That includes sqrt and the float classifications, whose special forms also
// take an F32, and for sqrt a measurement.
use math: core.math

run: fn() {
    print(math.is_finite(math.sqrt(2.0)))
    print(math.sqrt(2.0))
    print(math.sqrt((9.0)))
    print(math.is_nan(math.sqrt(-4.0)))
    print(math.is_finite(2.0))
    print(math.is_nan(-1.5))
    print(math.is_inf(1.0))
    print(math.sin(1.0))
    print(math.cos(-0.0))
    print(math.exp(1.0))
    print(math.hypot(3.0, 4.0))
    print(math.atan2(1.0, 1.0))
    print(math.cbrt(27.0))
}
