# Keyed splittable RNG streams agree across split orders, concurrent tasks, and O0/O1/O2/Web tiers.
requires: tool:node
fixture: CoreMathSplittableRNGKeyedStreamsMatchAcrossOrdersTasksAndTiers.fixture
step o0: jet run run.jet
exit: 0
stdout: = core_math_splittable_rng_keyed_streams_match_across_orders_tasks_and_tiers.out
step o1: jet run -O1 run.jet
exit: 0
stdout: = core_math_splittable_rng_keyed_streams_match_across_orders_tasks_and_tiers.out
step o2: jet run -O2 run.jet
exit: 0
stdout: = core_math_splittable_rng_keyed_streams_match_across_orders_tasks_and_tiers.out
step web_build: jet build --target web run.jet
exit: 0
step web_run: node .jet/build/app.js
exit: 0
stdout: = core_math_splittable_rng_keyed_streams_match_across_orders_tasks_and_tiers.out

