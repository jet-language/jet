# A `#run` parameter default is computed for each call while building, from
# the earlier arguments that call passes.
fixture: RunDefaultReadsEarlierArgument.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 0 # the `doubled` call in the default runs while building
stderr: !~ "Jet.UnsupportedCompileTimeValue" # a `#run` default is no longer refused as unimplemented
step: jet run main.jet
exit: 0
stdout: = "41\n9\n" # each call's default doubles its own width
