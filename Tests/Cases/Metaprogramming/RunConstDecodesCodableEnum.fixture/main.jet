// A `#run` constant decodes into a `#Codable` enum while building, as a
// run-time body does: the compile-time check finds the derived Decode the
// enum registered.
use json: core.encoding.json

#Codable
Shape: enum {
    Dot,
    Circle(Int),
}

SHAPE: #run { json.decode<Shape>(json.to_string(Shape.Circle(7))) ?? Shape.Dot }
SHAPES: #run { json.decode<[Shape]>(json.to_string([Shape]{Shape.Dot, Shape.Circle(7)})) ?? [Shape]{} }

run: fn() {
    runtime_shape: json.decode<Shape>(json.to_string(Shape.Circle(7))) ?? Shape.Dot
    runtime_shapes: json.decode<[Shape]>(json.to_string([Shape]{Shape.Dot, Shape.Circle(7)})) ?? [Shape]{}
    built_shape: json.to_string(SHAPE)
    built_shapes: json.to_string(SHAPES)
    print(built_shape)
    print("{built_shape == json.to_string(runtime_shape)}")
    print(built_shapes)
    print("{built_shapes == json.to_string(runtime_shapes)}")
}
