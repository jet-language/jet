# A `#run` constant decodes text into a `#Codable` enum while building.
fixture: RunConstDecodesCodableEnum.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 0 # the enum's derived Decode is found by the compile-time check
stderr: !~ "does not implement `Decode`" # the compile-time decode finds the enum's derived Decode
step: jet run main.jet
exit: 0
stdout: = "{\"Circle\":7}\n" # decoded while building, encoded again at run time
