// A rule hears the declared function an argument names as its FunctionInfo,
// with its parameters and their types. An argument that names no function
// carries None.
Unheard: struct {
    index: Int,

    impl Diagnostic {
        code: "known.Unheard",

        what: fn(self) -> String { "argument {self.index} is not heard with the function it names" }

        why: fn(self) -> String { "a function named as an argument is known while building" }

        fix: fn(self) -> String { "hear the function's FunctionInfo" }
    }
}

Handles: struct {
    impl Marker {
        sites: [.Function],

        check: fn(self, call: CompilerCall) {
            heard: [String]{"show(id: Int, name: String)", "none"}
            loop (index, argument) in call.args {
                ^named: "none"
                if argument.function == .Val(info) {
                    params: (loop param in info.signature.params -> "{param.name}: {param.type.name}").join(", ")
                    named = "{info.name}({params})"
                }
                if named != heard[index] -> reject(Unheard{index: index}, at: argument)
            }
        }
    }
}

show: fn(id: Int, name: String) -> String { "{id} {name}" }

#Handles route: fn(handler: fn(Int, String) -> String, path: String) -> String { handler(7, path) }

run: fn() { print(route(show, "/item")) }
