// A handler the main file names through the module alias `pages`.
#Recorded
note: fn(text: String) -> String { "{text}" }

#Recorded
reply: fn<T: Printable>(value: T) -> String { "{value}" }

show: fn(id: Int, name: String) -> String {
    seen: note(name)
    if seen == "" -> return reply<String>("nobody")
    answer: reply<Int>(id)
    answer
}
