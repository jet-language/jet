// A call may pass a `#run`-defaulted parameter only by forwarding a
// parameter of its own function whose default is the same `#run` default.
// `wrapped` computes `twice` from its own `width` and hands it on.
doubled: fn(value: Int) -> Int {
    value * 2
}

scaled: fn(width: Int, twice: Int{#run doubled(width)}) -> Int {
    twice + 1
}

wrapped: fn(width: Int, twice: Int{#run doubled(width)}) -> Int {
    scaled(width, twice)
}

run: fn() {
    print(wrapped(20))
    print(wrapped(4))
}
