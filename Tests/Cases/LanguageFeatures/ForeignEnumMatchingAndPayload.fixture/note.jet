NoteType: enum {
    User,
    _Feedback,
    _Project,
    _Reference,
}

Note: struct {
    _name: String,
    note_type: NoteType,
    _parent: String?,
}

make_note: fn(name: &&String, t: &&NoteType) -> Note {
    return Note{_name: name, note_type: t, _parent: None}
}

kind_str: fn(n: Note) -> String {
    k: n.note_type.copy()
    if k == {
        .User -> {
            return "user"
        }
        ._Feedback -> {
            return "feedback"
        }
        ._Project -> {
            return "project"
        }
        ._Reference -> {
            return "reference"
        }
    }
}

run: fn() { print("note") }
