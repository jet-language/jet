// An impl method writes no effect row; it inherits the trait method's `-[]>`.
// That holds for a user trait and for the Prelude's CheckedText alike.
Show: trait {
    show: fn(self) -[]> String,
}

Point: struct {
    v: Int,

    impl Show {
        show: fn(self) -> String { "p{self.v}" }
    }
}

describe: fn<T: Show>(value: T) -[]> String { value.show() }

#Error
TokenError: enum {
    Empty,
    TooLong,
}

Token: distinct String

impl Token.CheckedText {
    Error: TokenError,

    check: fn(parts: [String]) -> Checked<[String], TextSlot> TokenError! {
        if parts.join("") == "" -> return Err(TokenError.Empty)
        if parts.join("").len() > 20 -> return Err(TokenError.TooLong)
        return Ok(Checked{shape: parts.copy(), slots: [TextSlot]{}})
    }

    encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -> String { return "[{value}]" }
}

reveal: fn(value: Token) {
    #Unsafe("the case prints the checked text") { print(value.raw()) }
}

run: fn() {
    print(Point{v: 1}.show())
    print(describe(Point{v: 2}))
    name: "Ada"
    reveal(Token{"hi {name}"})
    reveal(Token{"fixed {7}"})
}
