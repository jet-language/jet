// A program's alias of a family size is that size's own type: its
// constants (`Byte.MAX`), its statics (`Real.parse`, `Single.from_int`) and
// its typed literal (`Byte{7}`) are the size's.
Byte: Unsigned<8>

Real: IEEE<11, 52>

Single: IEEE<8, 23>

run: fn() {
    print(Byte.MAX)
    print(Byte.MIN)
    small: Byte{7}
    print(Int{small} + 1)
    print(Real.parse("2.5") ?? 0.0)
    print(Single.from_int(3))
}
