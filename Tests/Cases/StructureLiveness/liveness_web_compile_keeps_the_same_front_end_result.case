# Rust-only target-libdir availability guard erased by TestLead1 ruling.
# A web compile keeps the front end's result: checked for the browser's
# machine, the file reports the same liveness lints as the host check, and
# its unused local and import fail the check as tidy errors.
step: jet check --target=web {root}/Examples/Tooling/StructureLiveness.jet
exit: 1
stderr: ~ "L0101" # an unused local binding
stderr: ~ "L0103" # an unused import
stderr: ~ "L0104" # an unused private function
stderr: ~ "L0105" # an unreachable package export
