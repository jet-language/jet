package: {
    name: "context_dir_cannot_escape_fs_effect_scope"
    authority: { allow: [FS, Env, IO] }
}

use {
    files: core.files
}

read_inside_allowed: fn(outside_dir: String) -[FS.Read("allowed/")]> String {
    #Context(dir: outside_dir) {
        files.read("secret.txt") ?? return "refused:{err}"
    }
}

run: fn() -[FS, Env, IO]> {
    files.create_dir_all("allowed") ?? panic("mkdir allowed")
    files.create_dir_all("outside") ?? panic("mkdir outside")
    files.write("allowed/public.txt", "public-ok") ?? panic("write public")
    files.write("outside/secret.txt", "top-secret") ?? panic("write secret")

    // Positive control: reading inside the allowed directory via `#Context(dir: "allowed")` succeeds.
    ok_read: fn() -[FS.Read("allowed/")]> String {
        #Context(dir: "allowed") {
            files.read("public.txt") ?? return "refused:{err}"
        }
    }
    print("allowed: {ok_read()}")

    // Escape attempt: switching `#Context(dir: "outside")` MUST NOT bypass `FS.Read("allowed/")`.
    escaped: read_inside_allowed("outside")
    assert(escaped.starts_with("refused:"), "expected refusal, got: {escaped}")
    assert(escaped.contains("Jet.EffectBoundExceeded"), "expected EffectBoundExceeded, got: {escaped}")
    print("escape: refused")
}
