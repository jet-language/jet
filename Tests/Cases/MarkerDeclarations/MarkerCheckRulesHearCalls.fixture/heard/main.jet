// A marker's `check` rule hears every call of the function it marks. It
// rejects at the call's name, at one of its arguments or at the whole call,
// and its rejection replaces the call's own errors (the arity of `log()`, the
// type of `log(42)`); the call it lets through checks as written.
EmptyLog: struct {
    impl Diagnostic {
        code: "logs.EmptyLog",

        what: fn(self) -> String { "this `log` call has no message" }

        why: fn(self) -> String { "the logging rule wants one message per call" }

        fix: fn(self) -> String { "pass the message to `log`" }
    }
}

NotText: struct {
    shown: String,

    impl Diagnostic {
        code: "logs.NotText",

        what: fn(self) -> String { "a `{self.shown}` is not a log message" }

        why: fn(self) -> String { "the logging rule logs text" }

        fix: fn(self) -> String { "pass a String" }
    }
}

LongLog: struct {
    impl Diagnostic {
        code: "logs.LongLog",

        what: fn(self) -> String { "this `log` call writes a long line" }

        why: fn(self) -> String {
            "the logging rule keeps each message under twenty bytes of source"
        }

        fix: fn(self) -> String { "shorten the message" }
    }
}

Logged: struct {
    impl Marker {
        sites: [.Function],

        check: fn(self, call: CompilerCall) {
            if call.args.len() == 0 -> reject(EmptyLog{}, at: call.name)
            if call.args[0].type.name != "String" {
                reject(NotText{shown: call.args[0].type.name}, at: call.args[0])
            }
            if call.args[0].span.end - call.args[0].span.start > 20 -> reject(LongLog{})
        }
    }
}

#Logged log: fn(message: String) { print(message) }

run: fn() {
    log("kept")
    log()
    log(42)
    log("a message far too long for the rule")
}
