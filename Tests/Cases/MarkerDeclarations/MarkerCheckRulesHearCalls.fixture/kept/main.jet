// A call whose own check fails waits on its rule; when the rule lets it
// through, the call's own error is reported as it would be without the rule.
EmptyLog: struct {
    impl Diagnostic {
        code: "logs.EmptyLog",

        what: fn(self) -> String { "this `log` call has no message" }

        why: fn(self) -> String { "the logging rule wants one message per call" }

        fix: fn(self) -> String { "pass the message to `log`" }
    }
}

Logged: struct {
    impl Marker {
        sites: [.Function],

        check: fn(self, call: CompilerCall) {
            if call.args.len() == 0 -> reject(EmptyLog{}, at: call.name)
        }
    }
}

#Logged log: fn(message: String) { print(message) }

run: fn() {
    log("kept")
    log(42)
}
