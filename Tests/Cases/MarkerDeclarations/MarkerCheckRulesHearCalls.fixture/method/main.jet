// A rule on a method hears each call of that method with its receiver.
NoAmount: struct {
    impl Diagnostic {
        code: "bank.NoAmount",

        what: fn(self) -> String { "this withdrawal names no amount" }

        why: fn(self) -> String { "the bank's rule wants every withdrawal to name its amount" }

        fix: fn(self) -> String { "pass the amount to `withdraw`" }
    }
}

NoReceiver: struct {
    impl Diagnostic {
        code: "bank.NoReceiver",

        what: fn(self) -> String { "this withdrawal has no account" }

        why: fn(self) -> String { "a method call is heard with its receiver" }

        fix: fn(self) -> String { "call `withdraw` on an account" }
    }
}

Checked: struct {
    impl Marker {
        sites: [.Method],

        check: fn(self, call: CompilerCall) {
            if call.receiver == None -> reject(NoReceiver{})
            if call.args.len() == 0 -> reject(NoAmount{}, at: call.name)
        }
    }
}

Account: struct {
    balance: Int,

    #Checked withdraw: fn(&self, amount: Int) { self.balance -= amount }
}

run: fn() {
    account := Account{balance: 10}
    account.withdraw(3)
    account.withdraw()
    print("{account.balance}")
}
