// A marker's call rule is `check: fn(self, call: CompilerCall) { … }`, and
// its `impl Marker` block holds one.
Routed: struct {
    impl Marker {
        sites: [.Function],

        check: fn(self, call: CompilerCall) {}

        check: fn(self, call: CompilerCall) {}
    }
}

Tidy: struct {
    impl Marker {
        sites: [.Function],

        check: fn(self, call: Int) {}
    }
}

run: fn() {}
