// A marker's `check` rule prints in its `impl Marker` block as written.
BadRoute: struct {
    path: String,

    impl Diagnostic {
        what: fn(self) -> String { "`{self.path}` is not a route" }

        why: fn(self) -> String { "a route starts with `/`" }

        fix: fn(self) -> String { "start the route with `/`" }
    }
}

Route: struct {
    impl Marker {
        sites: [.Function],

        check: fn(self, call: CompilerCall) {
            if call.args.len() == 0 -> reject(BadRoute{path: ""}, at: call.name)
            reject(BadRoute{path: call.name.text}, at: call.args[0])
        }
    }
}

Quiet: struct {
    impl Marker {
        sites: [.Function],

        check: fn(self, call: CompilerCall) {}
    }
}

run: fn() {}
