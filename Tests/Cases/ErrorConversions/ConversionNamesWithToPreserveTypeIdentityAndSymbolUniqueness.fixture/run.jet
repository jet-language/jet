#Error
SourceErr: struct {
    _message: String,
}

#Error
TargetErr: struct {
    _message: String,

    impl From(SourceErr) {
        from: fn(error: SourceErr) -> TargetErr {
            return TargetErr{_message: "converted from source"}
        }
    }
}

impl Err.From(TargetErr) {
    from: fn(error: TargetErr) -> Err { return Err("converted from target") }
}

read: fn() -> Int SourceErr! { return Err(SourceErr{_message: "source failure"}) }

middle: fn() -> Int TargetErr! {
    value: read()
    return Ok(value)
}

outer: fn() -> Int {
    value: middle()
    return Ok(value)
}

run: fn() { print(outer()) }
