// An erased trait value reflects as the concrete value its box holds: its
// path is the identity of that type's TypeId (`T.reflect()`), and so is a
// trait-typed field's.
use reflect: core.reflect

Shape: trait {
    area: fn(self) -> Int,
}

Square: struct {
    side: Int,

    impl Shape {
        area: fn(self) -> Int { self.side * self.side }
    }

    impl Display {
        display: fn(self) -> String { "square {self.side}" }
    }
}

Circle: struct {
    radius: Int,

    impl Shape {
        area: fn(self) -> Int { 3 * self.radius * self.radius }
    }

    impl Display {
        display: fn(self) -> String { "circle {self.radius}" }
    }
}

Frame: struct {
    shape: Shape,
    label: String,

    impl Display {
        display: fn(self) -> String { "frame {self.label}" }
    }
}

SQUARE_ID: #run Square.reflect().identity.identity

CIRCLE_ID: #run Circle.reflect().identity.identity

run: fn() {
    shapes: [Shape]{Square{side: 2}, Circle{radius: 1}}
    loop shape in shapes {
        info: reflect.of(shape)
        print("{info.type_name()} {info.path()} {info.display()}")
    }
    print(reflect.of(shapes[0]).path() == SQUARE_ID)
    print(reflect.of(shapes[1]).path() == CIRCLE_ID)
    print(reflect.of(shapes[1]).path() == SQUARE_ID)
    frame: Frame{shape: Circle{radius: 4}, label: "round"}
    loop field in reflect.of(frame).fields() {
        print("{field.name()}: {field.value().type_name()} {field.value().path()} {field.value().display()}")
    }
}
