# A builtin type's name (`Int`, `U8`) is a Type value where a Type is
# expected, the same as a declared type's: `counts[Int] = 1` keys a map by
# it, on every tier.
fixture: BuiltinTypesAreTypeValues.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
