use reflect: core.reflect

Point: struct {
    x: Int,
    y: Int,

    impl Shown {

    }
}

Shown: trait {
    tag: fn(self) -> Int {
        0
    }
}

impl Int.Shown {

}

impl String.Shown {

}

run: fn() {
    items: [Shown]{14, "hi", Point{x: 1, y: 2}}
    loop item in items {
        info: reflect.of(item)
        print("{info.type_name()} {info.path()} {info.display()}")
    }
}
