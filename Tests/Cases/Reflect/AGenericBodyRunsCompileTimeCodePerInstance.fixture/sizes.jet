// What both programs share: generic functions whose compile-time code reads
// the type parameter's TypeInfo record. Each instance computes its own
// answer while building, from the type that fills `T`.
width: fn<T>(value: T) -> String {
    #if (T.reflect().layout.size ?? 0) > 8 {
        return "wide"
    }
    "narrow"
}

field_count: fn<T>(value: T) -> Int {
    count: #run T.reflect().fields.len()
    count
}

// Fills `width`'s `T` with its own `U`.
width_again: fn<U>(value: U) -> String { width(value) }

// No program calls this one, so it computes nothing and reports nothing.
never_counted: fn<T>(value: T) -> Int {
    count: #run T.reflect().fields.len()
    count
}
