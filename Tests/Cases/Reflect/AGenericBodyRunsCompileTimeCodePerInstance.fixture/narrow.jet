use sizes

Score: struct {
    points: Int,
}

Trio: struct {
    first: Int,
    second: Int,
    third: Int,
}

print(sizes.width(Score{points: 3}))
print(sizes.field_count(Score{points: 3}))
print(sizes.width_again(Trio{first: 1, second: 2, third: 3}))
print(sizes.field_count(Trio{first: 1, second: 2, third: 3}))
