use sizes

Row: struct {
    team: String,
    minutes: Float,
}

Pick: enum {
    Rock,
    Paper,
}

print(sizes.width(Row{team: "a", minutes: 1.0}))
print(sizes.field_count(Row{team: "a", minutes: 1.0}))
print(sizes.width(Pick.Rock))
print(sizes.field_count(Pick.Rock))
print(sizes.width_again(3))
print(sizes.field_count(3))
