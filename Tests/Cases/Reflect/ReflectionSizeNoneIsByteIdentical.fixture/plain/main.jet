// The plain arm of the "size, none" cell: the reflection arm's program with
// its core.reflect import removed. The comment below stands in its place, so
// every other line keeps the line number the build records for it.
// No core.reflect import.

Rock: struct {
    weight: Int,
}

Door: enum {
    Open,
    Shut,
}

label: fn(door: Door) -> String {
    if door == {
        .Open -> "open"
        .Shut -> "shut"
    }
}

run: fn() {
    rock: Rock{weight: 3}
    print("rock {rock.weight}, door {label(Door.Shut)}")
}
