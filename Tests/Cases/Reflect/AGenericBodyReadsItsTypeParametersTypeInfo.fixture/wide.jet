use shapes

Row: struct {
    team: String,
    minutes: Float,
}

Pick: enum {
    Rock,
    Paper,
}

print(shapes.describe(Row{team: "a", minutes: 1.0}))
print(shapes.show(Row.reflect()))
print(shapes.describe(Pick.Rock))
print(shapes.show(Pick.reflect()))
print(shapes.describe_again(3))
print(shapes.show(Int.reflect()))
