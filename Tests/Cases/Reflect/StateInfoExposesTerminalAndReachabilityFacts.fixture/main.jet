Door: struct {
    state {
        Open -> Closed
        Closed
    }

    begin: fn() -[]> Door.Open { return Door{} }

    close: fn(self: &&Door.Open) -[]> Door.Closed { return self }
}

STATE_INFO: #run Door.reflect()

run: fn() {
    // Original first terminal false
    print(STATE_INFO.states[0].terminal)

    // Original second terminal true
    print(STATE_INFO.states[1].terminal)

    // Original first reachable present true
    print(STATE_INFO.states[0].reachable ?? panic("Open reachability must be present"))

    // Original second reachable present true
    print(STATE_INFO.states[1].reachable ?? panic("Closed reachability must be present"))
}
