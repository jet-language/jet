# A task group whose limit is at least the core count runs more parents than
# its one carrier and the fiber stacks a 4 GiB address-space cap leaves can
# hold, and each parent joins two children of its own. A parent the carrier
# runs on its own stack finds no carrier left to start a child, so its join
# runs the child on the joining thread; a parent on a fiber parks, and the
# one carrier runs its children. Every child reports its parent's thread and
# the program finishes. Built programs at O0, O1 and O2: under `jet run` the
# cap would be the compiler's process.
requires: os-name:linux
fixture: Fixtures/NestedJoin
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JET_SCHEDULER_THREADS=1
step: jet build -O0 main.jet
exit: 0
step o0: built
limit: time=120
exit: 0
stdout: = "nested joins finished, every child on its joiner's thread true\n"
stderr: empty
step: jet build -O1 main.jet
exit: 0
step o1: built
limit: time=120
exit: 0
stdout: = "nested joins finished, every child on its joiner's thread true\n"
stderr: empty
step: jet build --release main.jet
exit: 0
step o2: built
limit: time=120
exit: 0
stdout: = "nested joins finished, every child on its joiner's thread true\n"
stderr: empty
