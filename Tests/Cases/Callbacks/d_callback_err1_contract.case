# A Core function that calls a callback takes the callback's failure as its
# own type parameter and fails with it unchanged: a callback that can't fail
# leaves the join failing only with its own `DataError`, a `KeyError` callback
# reaches the caller as that `KeyError`, and a callback failing with
# `DataError | KeyError` beside the join's own `DataError` reaches it as the
# member it raised. Nothing is converted on the way, on every tier.
fixture: CallbackFailureContract.fixture
step check: jet check main.jet
exit: 0
step run: jet run main.jet
exit: 0
stdout: = "3\njoined 3\nkey\njoined 3\nkey\ndata mean\n0 2\n hit\nkey\n"
step o0: jet run -O0 main.jet
exit: 0
stdout: == run
step o2: jet run -O2 main.jet
exit: 0
stdout: == run
