# A lambda bound to a local never reads a stale copy. It copies each name it
# only reads when it is made, so a call after that name changed is refused
# (E0204), on every tier. Calls before the change, a lambda made after it,
# and a name the lambda writes (which it borrows) read the current value.
fixture: BoundLambdaReadsChangedCapture.fixture
env: NO_COLOR=1
step check: jet check accepted.jet
exit: 0
step o0: jet run -O0 accepted.jet
exit: 0
stdout: = "1\n2\n12\n"
step o1: jet run -O1 accepted.jet
exit: 0
stdout: = "1\n2\n12\n"
step o2: jet run -O2 accepted.jet
exit: 0
stdout: = "1\n2\n12\n"
step refused: jet check refused.jet
exit: 1
stderr: ~ "jet.UseWhileWriteActive" # the stale call is refused (E0204)
stderr: ~ "refused.jet:6:11" # at the call of `f` after `v.push(2)`
stderr: ~ "refused.jet:10:11" # at the call of `g` after `k = 5`
stderr: ~ "reads its own copy of `v`, made before `v` changed" # naming why
step refused_run: jet run -O0 refused.jet
exit: 1
stderr: ~ "jet.UseWhileWriteActive" # the run stops at the same check
