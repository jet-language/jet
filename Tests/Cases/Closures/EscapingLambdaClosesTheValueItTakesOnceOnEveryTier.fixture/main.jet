// A Close value can't be cloned, so the returned lambda takes it: the
// variable gives it up when the lambda is made, each call writes the
// lambda's own value, and the value closes once, when the lambda ends.
Counter: struct {
    count: Int,

    impl Close {
        close: fn(^^self) { print("closed after {self.count}") }
    }
}

make: fn() -> fn() -> Int {
    counter := Counter{count: 0}
    fn() {
        counter.count += 1
        counter.count
    }
}

run: fn() {
    tick: make()
    print(tick())
    print(tick())
    print("done")
}
