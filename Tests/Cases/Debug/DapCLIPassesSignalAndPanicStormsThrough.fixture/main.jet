use process: core.process

worker: fn(k: Int) -> Int {
    if k % 2 == 0 -> panic("worker {k} gives up")
    k
}

run: fn() {
    subscribed: process.signals([ProcessSignal]{.Usr1}) ?? panic("process.signals refused Usr1: {err}")
    received := 0
    loop _ in 0..<100 {
        sent: process.shell("kill -USR1 {process.current_pid()}").run() ?? panic("sh did not start: {err}")
        if !sent.success -> panic("kill -USR1 failed")
        _ := subscribed.receiver.receive() ?? panic("the receiver closed early")
        received += 1
    }
    subscribed.close()
    print("{received} USR1 received")
    failed := 0
    loop k in 0..<40 {
        helper: task worker(k)
        if (helper.join() ?? -1) < 0 -> failed += 1
    }
    print("{failed} of 40 workers panicked")
}
