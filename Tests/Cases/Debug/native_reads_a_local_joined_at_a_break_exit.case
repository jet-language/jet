# jet debug's own engine reads the O0 image a build ships. `total` leaves its
# loop by the loop's test or by the `break`, so after the loop its value is
# the join of both; the kit leaves the IR verifier's SSA round trip
# (JET_OPT_VERIFY), which would move that value into a fresh unnamed slot, off
# for Debug cases. Stopped on the line after the loop, `print total` shows the
# value the `break` left. The fixture is the lldb interop case's and must stay
# in jet fmt form.
fixture: LocalJoinedAtABreakExitStaysVisible.fixture
env: NO_COLOR=1
step: jet build -O0 prog.jet
exit: 0
step: jet debug {work}/.jet/build/prog --break prog.jet:8
stdin: native_reads_a_local_joined_at_a_break_exit.stdin
exit: 0 # `c` runs the program to its end, and the session ends with it
stdout+stderr: ~ "Breakpoint hit  prog.jet:8" # the stop is on the line after the loop
stdout+stderr: ~ "total = 6" # the joined local is there, with the value the `break` left
stdout+stderr: !~ "total = <" # with a value, not unavailable
stdout+stderr: ~ "Program finished" # and the program runs on to its end
