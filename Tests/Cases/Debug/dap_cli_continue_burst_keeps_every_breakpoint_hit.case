# An editor that sends `continue` and `stackTrace` without waiting for each
# stop gets every breakpoint hit. The loop body (line 5, after a spin of
# 10,000 additions) runs 11 times: the first stop, then 10 continues, each
# to the next hit, and every stackTrace answered at a stop. A request that
# comes while the program runs stops it (NativeSession.interrupt); a thread
# that ran onto the breakpoint as it was stopped is put back on it, and its
# next run traps there again (NativeThread.rearmed). Before, that run
# stepped over the breakpoint as over one it had reported, so the hit was
# lost: 5 to 10 of the 11 stops, the program's end before the last
# continue, and "the program is not paused" (gate jet of 6dda4bf451, 12 of
# 12 runs).
fixture: DapCLIContinueBurstKeepsEveryBreakpointHit.fixture
env: NO_COLOR=1
session dap content-length: jet debug --dap {work}/main.jet
send dap: "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"adapterID\":\"jet\",\"pathFormat\":\"path\",\"linesStartAt1\":true,\"columnsStartAt1\":true}}"
send dap: "{\"seq\":2,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{\"source\":{\"path\":\"{work}/main.jet\"},\"breakpoints\":[{\"line\":5}]}}"
send dap: "{\"seq\":3,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{\"program\":\"{work}/main.jet\",\"stopOnEntry\":false,\"args\":[],\"env\":{}}}"
send dap: "{\"seq\":4,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{}}"
send dap: "{\"seq\":5,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":6,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":7,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":8,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":9,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":10,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":11,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":12,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":13,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":14,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":15,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":16,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":17,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":18,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":19,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":20,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":21,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":22,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":23,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
send dap: "{\"seq\":24,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
close dap
exit: 0
stdout.find_block("Content-Length:", ~ "\"request_seq\":24,"): ~ "\"success\":true" # the last stackTrace, after the 10th continue, answers at a stop
stdout.find_block("Content-Length:", ~ "\"request_seq\":24,"): ~ "\"line\":5" # at the breakpoint
stdout: ~ "\"hitBreakpointIds\":[1]" # each stop is the breakpoint's hit
stdout: !~ "\"success\":false" # no request finds the program ended
stdout: !~ "\"event\":\"exited\"" # the 11th hit is the last stop; the program never runs to its end
stdout: !~ "total is " # nor prints
