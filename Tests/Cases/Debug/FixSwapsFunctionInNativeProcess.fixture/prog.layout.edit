// Rounds of a score. At round 1 the program moves an edit (a .edit file, no
// package member until then) over its own source, so `fix` has one to swap.
use files: core.files

Score: struct {
    value: Int,
    bonus: Int,
}

score: fn(round: Int) -> Score {
    made: Score{value: round * 10 + 1000, bonus: 7}
    Score{value: made.value + made.bonus - 7, bonus: made.bonus}
}

run: fn() {
    edited: if files.is_file("prog.next.edit") -> "prog.next.edit" else -> "prog.layout.edit"
    loop round in 0..<4 {
        if round == 1 -> files.rename(edited, "prog.jet") ?? ()
        print("round {round} score {score(round).value}")
    }
}
