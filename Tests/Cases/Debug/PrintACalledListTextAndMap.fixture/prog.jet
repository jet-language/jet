// Each grows its result.
numbers: fn(from: Int, count: Int) -> [Int] {
    out := [Int]{}
    loop k in 0..<count -> out.push(from + k)
    out
}

words: fn(word: String, count: Int) -> String {
    out := ""
    loop _ in 0..<count -> out = "{out}{word}"
    out
}

counts: fn(word: String, count: Int) -> [String:Int] {
    out := [String:Int]{}
    out[word] = count
    out
}

// The same, each also used as a value below.
held_numbers: fn(from: Int, count: Int) -> [Int] {
    out := [Int]{}
    loop k in 0..<count -> out.push(from + k)
    out
}

held_words: fn(word: String, count: Int) -> String {
    out := ""
    loop _ in 0..<count -> out = "{out}{word}"
    out
}

held_counts: fn(word: String, count: Int) -> [String:Int] {
    out := [String:Int]{}
    out[word] = count
    out
}

sizes: fn(list: fn(Int, Int) -> [Int], text: fn(String, Int) -> String, map: fn(String, Int) -> [String:Int]) -> Int {
    list(1, 2).len() + text("ab", 2).len() + map("a", 1).len()
}

run: fn() {
    total := numbers(1, 2).len() + words("ab", 2).len() + counts("a", 1).len()
    total += sizes(held_numbers, held_words, held_counts)
    print("{total}")
}
