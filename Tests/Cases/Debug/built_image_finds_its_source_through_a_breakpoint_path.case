# Claim: a breakpoint's absolute path names where the image's sources
# are when nothing above the image holds them. The source moves into
# another tree after the build, so the directory the image was built
# from no longer has it; `--break` with the moved file's absolute path
# shows that tree is the one the image's recorded source paths are
# relative to, and the stop, `up` and `down` read their lines from it,
# run from yet another directory. The fixture's line 3 is fib's sum; run
# calls fib on line 6. The breakpoint is then deleted, and the end of
# stdin runs the program to its end.
fixture: DisassembleMarksStopAndBreakpoint.fixture
env: NO_COLOR=1
mkdir: tree
mkdir: elsewhere
step: jet build -O0 prog.jet
exit: 0
rename: prog.jet tree/prog.jet
step: jet debug {work}/.jet/build/prog --break {work}/tree/prog.jet:3
stdin: built_image_finds_its_source_through_a_breakpoint_path.stdin
cwd: {work}/elsewhere
exit: 0
stdout: ~ "Breakpoint hit  prog.jet:3  in fib()\n3 |     fib(n - 1) + fib(n - 2)        <- here\n" # the stop's line, read from the tree the breakpoint names
stdout: ~ "#1  run()  at prog.jet:6\n6 | run: fn() " # `up` reads its caller's line from the same tree
stdout: ~ "#0  fib()  at prog.jet:3\n3 |     fib(n - 1) + fib(n - 2)\n" # and `down` the stop's again
stdout: !~ "source unavailable" # every line was found
stdout: ~ "Deleted breakpoint 1\n" # the stop's breakpoint goes
stdout: ~ "55\n" # and the program runs to its end
