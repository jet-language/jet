# `print` in an -O2 image's inlined frame answers as it does at O0. At O2
# `sum_squares` is inlined into `run`, so the stop on its loop's body is in
# an inlined `sum_squares` frame above `run`'s own. The image's debug
# information names the level it was built at, so the expression is
# compiled at that level and the code around it is the code the program
# runs. In the inlined frame it is checked in `sum_squares` at the stop's
# line and reads that frame's live locals, its parameter `count` among them
# as at O0: the inlined body reads the argument `run` passed; `up` selects
# `run` at the call, where it reads `run`'s. A call of the inlined function
# runs its code, compiled again. The same commands run on the O0 image
# first. The fixture must stay in jet fmt form: line 7 is the loop's body,
# line 15 the call.
fixture: PrintInAnInlinedFrame.fixture
env: NO_COLOR=1
env: PATH={work}/no-tools
step o0: jet build -O0 prog.jet
exit: 0
step: jet debug {work}/.jet/build/prog --break prog.jet:7
stdin: print_in_an_inlined_frame.stdin
exit: 0
stdout: ~ "Locals:  count = 1000   n = 2   total = 1\n" # the third stop, in sum_squares' own frame at O0
stdout: ~ "(Jet) print n + 1\nn + 1 = 3\n" # a local of the stopped function
stdout: ~ "(Jet) print total + n * 10\ntotal + n * 10 = 21\n" # two of them, in compiled code
stdout: ~ "(Jet) print count + 1\ncount + 1 = 1001\n" # `run`'s frame at the call reads its own local
stdout: ~ "(Jet) print sum_squares(3)\nsum_squares(3) = 5\n" # a call runs the function's code
stdout: !~ "Can't evaluate" # every expression answers
stdout: ~ "332833500\nProgram finished\n" # the evaluations left the program's run unchanged
step o2: jet build -O2 prog.jet
exit: 0
step: jet debug {work}/.jet/build/prog --break prog.jet:7
stdin: print_in_an_inlined_frame.stdin
exit: 0
stdout: ~ "Locals:  count = 1000   n = 2   total = 1\n" # the third stop, in the copy inlined into `run`, with the locals it has at O0
stdout: ~ "(Jet) print n + 1\nn + 1 = 3\n" # the inlined frame's local, as at O0
stdout: ~ "(Jet) print total + n * 10\ntotal + n * 10 = 21\n" # two of them, in code compiled at O2
stdout: ~ "(Jet) print count + 1\ncount + 1 = 1001\n" # `run`'s own frame below it, at the call
stdout: ~ "(Jet) print sum_squares(3)\nsum_squares(3) = 5\n" # the inlined function's code, compiled again
stdout: !~ "Can't evaluate" # every expression answers, as at O0
stdout: ~ "332833500\nProgram finished\n" # the evaluations left the program's run unchanged
