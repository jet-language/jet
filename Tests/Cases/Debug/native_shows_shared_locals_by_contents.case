# A Shared local is a pointer to its runtime cell. Its debug type is a
# typedef of a pointer to that cell, whose payload word points at the
# value's own type (JetIR X64Module.jet ir_x64_debug_types). So a stop, `locals`
# and `print` show the value inside, `Shared{Score{count: 11}}`, never the
# cell's address. The fixture must stay in jet fmt form.
fixture: SharedLocalsByContents.fixture
env: NO_COLOR=1
step: jet debug prog.jet --break prog.jet:9
stdin: native_shows_shared_locals_by_contents.stdin
exit: 0
stdout+stderr: ~ "Locals:  hits = Shared{7}   tally = Shared{Score{count: 11}}" # the stop shows each value inside its Shared
stdout+stderr: ~ "tally: Shared<Score> = Shared{Score{count: 11}}" # `locals` names the type as written
stdout+stderr: ~ "hits: Shared<Int> = Shared{7}" # a Shared of a scalar too
stdout+stderr: ~ "(Jet) print tally\ntally = Shared{Score{count: 11}}" # and so does `print`
stdout+stderr: ~ "(Jet) print hits\nhits = Shared{7}" # `print` of a Shared scalar too
stdout+stderr: ~ "tally 11\n" # the program runs on unchanged
stdout+stderr: !~ "Pointer" # never the cell's address
