# An editor selects a frame over `jet debug --dap`: `stackTrace` lists the
# Jet frames innermost first, `scopes` and `variables` of a caller's frame id
# show that frame's locals, and `evaluate` with that frame id (a watch
# expression, and a REPL one) reads the caller's locals. Selecting a caller
# does not move the program: `stepOut` still leaves the innermost frame.
# The fixture must stay in jet fmt form: line 2 is `scale`'s first line,
# line 9 the call in `total_of`'s loop and line 16 the call in `run`. No
# other debugger is on PATH.
fixture: DapCLISelectsACallerFrame.fixture
env: NO_COLOR=1
env: PATH={work}/no-tools
session dap content-length: jet debug --dap {work}/prog.jet
send dap: "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"adapterID\":\"jet\",\"pathFormat\":\"path\",\"linesStartAt1\":true,\"columnsStartAt1\":true}}"
recv dap until $.request_seq = 1 timeout 30s every 100ms
send dap: "{\"seq\":2,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{\"program\":\"{work}/prog.jet\",\"stopOnEntry\":false,\"args\":[]}}"
recv dap until $.event = "initialized" timeout 30s every 100ms
send dap: "{\"seq\":3,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{\"source\":{\"path\":\"{work}/prog.jet\"},\"breakpoints\":[{\"line\":2,\"condition\":\"n == 2\"}]}}"
recv dap until $.request_seq = 3 timeout 30s every 100ms
json: stdout doc $.body.breakpoints[0].verified = true
send dap: "{\"seq\":4,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{}}"
recv dap until $.event = "stopped" timeout 30s every 100ms
json: stdout doc $.body.reason = "breakpoint"
send dap: "{\"seq\":5,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
recv dap until $.request_seq = 5 timeout 30s every 100ms
json: stdout doc $.body.stackFrames[0].name = "scale"
json: stdout doc $.body.stackFrames[0].line = 2
json: stdout doc $.body.stackFrames[1].name = "total_of"
json: stdout doc $.body.stackFrames[1].line = 9
json: stdout doc $.body.stackFrames[2].name = "run"
json: stdout doc $.body.stackFrames[2].line = 16
capture: loop_frame stdout doc $.body.stackFrames[1].id
capture: run_frame stdout doc $.body.stackFrames[2].id
send dap: "{\"seq\":6,\"type\":\"request\",\"command\":\"scopes\",\"arguments\":{\"frameId\":{cap:loop_frame}}}"
recv dap until $.request_seq = 6 timeout 30s every 100ms
capture: loop_scope stdout doc $.body.scopes[0].variablesReference
send dap: "{\"seq\":7,\"type\":\"request\",\"command\":\"variables\",\"arguments\":{\"variablesReference\":{cap:loop_scope}}}"
recv dap until $.request_seq = 7 timeout 30s every 100ms
json: stdout doc $.success = true
json: stdout doc $.body.variables[?name="i"][0].value = "2"
json: stdout doc $.body.variables[?name="total"][0].value = "3"
json: stdout doc $.body.variables[?name="limit"][0].value = "4"
send dap: "{\"seq\":8,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"total + i\",\"frameId\":{cap:loop_frame},\"context\":\"watch\"}}"
recv dap until $.request_seq = 8 timeout 30s every 100ms
json: stdout doc $.success = true
json: stdout doc $.body.result = "5"
send dap: "{\"seq\":9,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"limit * 10\",\"frameId\":{cap:run_frame},\"context\":\"repl\"}}"
recv dap until $.request_seq = 9 timeout 30s every 100ms
json: stdout doc $.success = true
json: stdout doc $.body.result = "40"
send dap: "{\"seq\":10,\"type\":\"request\",\"command\":\"stepOut\",\"arguments\":{\"threadId\":1}}"
recv dap until $.request_seq = 10 timeout 30s every 100ms
send dap: "{\"seq\":11,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
recv dap until $.request_seq = 11 timeout 30s every 100ms
json: stdout doc $.body.stackFrames[0].name = "total_of"
send dap: "{\"seq\":12,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
recv dap collect until ndjson $[?event="terminated"] #>= 1 timeout 30s
stdout: ~ "\"output\":\"18" # the program ran on to its end and printed its sum
stdout: ~ "\"event\":\"exited\"" # and exited
send dap: "{\"seq\":13,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{}}"
recv dap until $.request_seq = 13 timeout 30s every 100ms
close dap
exit: 0
