use time: core.time

count_up: fn(n: Int) -> Int {
    total := 0
    loop i in 0..<n {
        step: i % 7
        total += step
    }
    total
}

sums: fn(n: Int) -> Int {
    a: 1
    b: 2
    c: 3
    d: 4
    e: 5
    total := 0
    loop i in 0..<n {
        step: a + b + c + d + e + i
        total += step
    }
    total
}

run: fn() -[IO, Time]> {
    started: time.start()
    first: count_up(1000000)
    took: time.elapsed(started).ns
    print(if took < 1000000000 -> "count_up: a million hits under a second" else -> "count_up: a million hits took {took} ns")
    again: time.start()
    second: sums(1000000)
    text_took: time.elapsed(again).ns
    print(if text_took < 1000000000 -> "sums: a million hits under a second" else -> "sums: a million hits took {text_took} ns")
    print("totals {first} {second} {count_up(5)} {sums(4)}")
}
