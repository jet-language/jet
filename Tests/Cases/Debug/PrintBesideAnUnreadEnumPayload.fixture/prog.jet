Part: enum {
    Byte(value: U8),
    Text(text: String),
}

Node: struct {
    count: Int,
    name: String,
    parts: [Part],
}

weigh: fn(node: Node) -> Int {
    total: node.name.len() + node.parts.len()
    total * node.count
}

run: fn() {
    node: Node{count: 3, name: "pair", parts: [Part]{Part.Byte{value: U8{7}}, Part.Text{text: "ab"}}}
    print("{weigh(node)}")
}
