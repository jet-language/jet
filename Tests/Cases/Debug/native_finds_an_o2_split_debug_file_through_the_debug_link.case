# jet debug's own engine reads an O2 image built with split debug info. The
# image holds no Jet debug information; its `.gnu_debuglink` names the side
# file by its name beside the image, which links to the package's symbol
# store. Given only the image, jet debug follows the link: a breakpoint by Jet
# file and line resolves and is hit. Once the store is gone the link leads
# nowhere, and jet debug says the image has no Jet debug information. The
# fixture is the lldb interop case's.
fixture: LldbFindsAnO2SplitDebugFileThroughTheDebugLink.fixture
env: NO_COLOR=1
step: jet build -O2 --debug-info=split prog.jet
exit: 0
file: .jet/build/prog.debug is-symlink # the side file's name beside the image links to the store
step: jet debug {work}/.jet/build/prog --break prog.jet:3
stdin: native_finds_an_o2_split_debug_file_through_the_debug_link.stdin
exit: any # `quit` ends the session; only the breakpoint is the subject
stdout+stderr: ~ "Breakpoint set  prog.jet:3" # the line table came from the store's side file
stdout+stderr: ~ "Breakpoint hit  prog.jet:3" # and the breakpoint is hit
remove: .jet/symbols
step: jet debug {work}/.jet/build/prog --break prog.jet:3
exit: 1
stdout+stderr: ~ "E2203" # without the store the link leads nowhere
stdout+stderr: ~ "has no Jet debug information" # and jet debug says why
step: {work}/.jet/build/prog
exit: 0
stdout: = "332833500\n" # the image runs unchanged
