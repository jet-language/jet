# Over `jet debug --dap`, `initialize` answers `supportsDisassembleRequest`
# and each Jet frame carries its pc as its `instructionPointerReference`, so
# an editor's disassembly view opens at the stop. Stopped on line 3 in
# `fib`, `disassemble` from two instructions before the frame's pc lists
# five: the third is the pc's own, on line 3 of prog.jet, in `fib`. An
# address no code is known at answers invalid rows, as the protocol asks,
# and a reference that is no address is E2236. The fixture is the console
# case's: line 3 is fib's sum.
fixture: DisassembleMarksStopAndBreakpoint.fixture
env: NO_COLOR=1
session dap content-length: jet debug --dap {work}/prog.jet
send dap: "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"adapterID\":\"jet\",\"pathFormat\":\"path\",\"linesStartAt1\":true,\"columnsStartAt1\":true}}"
recv dap until $.request_seq = 1 timeout 30s every 100ms
json: stdout doc $.body.supportsDisassembleRequest = true
send dap: "{\"seq\":2,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{\"program\":\"{work}/prog.jet\",\"stopOnEntry\":false,\"args\":[]}}"
recv dap until $.event = "initialized" timeout 30s every 100ms
send dap: "{\"seq\":3,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{\"source\":{\"path\":\"{work}/prog.jet\"},\"breakpoints\":[{\"line\":3}]}}"
recv dap until $.request_seq = 3 timeout 30s every 100ms
json: stdout doc $.body.breakpoints[0].verified = true
send dap: "{\"seq\":4,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{}}"
recv dap until $.event = "stopped" timeout 30s every 100ms
json: stdout doc $.body.reason = "breakpoint"
send dap: "{\"seq\":5,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
recv dap until $.request_seq = 5 timeout 30s every 100ms
json: stdout doc $.body.stackFrames[0].name = "fib"
json: stdout doc $.body.stackFrames[0].line = 3
stdout: ~ "\"instructionPointerReference\":\"0x" # every Jet frame carries its pc
capture: pc stdout doc $.body.stackFrames[0].instructionPointerReference
send dap: "{\"seq\":6,\"type\":\"request\",\"command\":\"disassemble\",\"arguments\":{\"memoryReference\":\"{cap:pc}\",\"instructionOffset\":-2,\"instructionCount\":5,\"resolveSymbols\":true}}"
recv dap until $.request_seq = 6 timeout 30s every 100ms
json: stdout doc $.success = true
json: stdout doc $.body.instructions #= 5 # exactly the count asked
json: stdout doc $.body.instructions[2].address = "{cap:pc}" # the frame's pc, two after the first
json: stdout doc $.body.instructions[2].line = 3
json: stdout doc $.body.instructions[2].location.name = "prog.jet"
stdout: ~ "\"symbol\":\"fib+" # the code it is in
stdout: ~ "\"instructionBytes\":\"" # with its bytes
stdout: !~ "int3" # the breakpoint's trap byte shows as the instruction it covers
send dap: "{\"seq\":7,\"type\":\"request\",\"command\":\"disassemble\",\"arguments\":{\"memoryReference\":\"0x10\",\"instructionCount\":2}}"
recv dap until $.request_seq = 7 timeout 30s every 100ms
json: stdout doc $.body.instructions #= 2
json: stdout doc $.body.instructions[0].presentationHint = "invalid" # no code is known there
json: stdout doc $.body.instructions[1].address = "0x11"
send dap: "{\"seq\":8,\"type\":\"request\",\"command\":\"disassemble\",\"arguments\":{\"memoryReference\":\"nope\",\"instructionCount\":2}}"
recv dap until $.request_seq = 8 timeout 30s every 100ms
json: stdout doc $.success = false
stdout: ~ "\"jetCode\":\"E2236\"" # a reference that is no address
send dap: "{\"seq\":9,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{}}"
recv dap until $.request_seq = 9 timeout 30s every 100ms
close dap
exit: 0
