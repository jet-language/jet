# The native image's DWARF types come from the compiler's own type facts:
# an enum, union, Option and Result is a variant part its discriminant
# selects in, a record its members. `print` shows every kind as its Jet
# value through the one generic renderer, never a raw word, an address or
# an opaque aggregate.
fixture: TypeFactsDisplayEveryKind.fixture
env: NO_COLOR=1
step: jet debug prog.jet
stdin: type_facts_display_every_kind.stdin
exit: 0
stdout: ~ "Breakpoint hit  prog.jet:45  in run()" # every local is bound by the print line
stdout: ~ "(Jet) print flag\nflag = true\n" # a Bool
stdout: ~ "(Jet) print letter\nletter = 'j'\n" # a Char, quoted
stdout: ~ "(Jet) print color\ncolor = Color.Green\n" # a payload-free enum's word names its variant
stdout: ~ "(Jet) print shape\nshape = Shape.Rect{w: 3, h: 4}\n" # a payload enum's box selects its variant and named payload
stdout: ~ "(Jet) print empty\nempty = Shape.Empty\n" # a variant without a payload is its name
stdout: ~ "(Jet) print tag\ntag = Tag.Num(7)\n" # an unnamed payload is positional
stdout: ~ "(Jet) print some\nsome = 5\n" # a present inline Option is its value
stdout: ~ "(Jet) print none\nnone = None\n" # an absent Option is None, not its sentinel word
stdout: ~ "(Jet) print text\ntext = \"hi\"\n" # a present Option of a String is the String
stdout: ~ "(Jet) print results\nresults = [Ok(2), Err(\"no\")]\n" # each Result box selects Ok or Err
stdout: ~ "(Jet) print either\neither = \"seven\"\n" # a union value is the member it holds
stdout: ~ "(Jet) print pair\npair = {n: 1, word: \"two\"}\n" # a record is spelled by its fields
stdout: ~ "(Jet) print points\npoints = [Point{x: 1, y: 2}]\n" # a list's element type keeps its own name
stdout: ~ "(Jet) print holder\nholder = Holder{tag: Tag.Word(\"x\"), color: Color.Red}\n" # variants nest inside a struct
stdout: !~ "<Unavailable>" # every local is shown
stdout: !~ "0x" # no value is shown as an address
stdout: ~ "true j Green Rect { w: 3, h: 4 } Empty Num(7) 5 null hi 2 1 1 Red\nseven\n1 2 false false false\nProgram finished\n" # the program's own output is unchanged
