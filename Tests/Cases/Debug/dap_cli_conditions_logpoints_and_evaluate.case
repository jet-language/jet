# `jet debug --dap` takes a breakpoint's condition and log message and
# answers `evaluate`, each a Jet expression over the paused frame's locals.
# The breakpoint in the loop stops only when `i == 3` holds. `evaluate` reads
# a local and computes from locals there. The logpoint after the loop logs
# its message with `total` filled in and does not stop. A condition that is
# not a Jet expression leaves its breakpoint unplaced.
# The fixture must stay in jet fmt form: the loop body holds two statements,
# so line 4 is the body and line 7 the `total` after the loop. The loop has
# no `break`: it leaves by its test alone, so `total` after it is still the
# loop's `total` under the IR verifier's SSA round trip too.
fixture: DapCLIConditionsLogpointsAndEvaluate.fixture
env: NO_COLOR=1
session dap content-length: jet debug --dap {work}/prog.jet
send dap: "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"adapterID\":\"jet\",\"pathFormat\":\"path\",\"linesStartAt1\":true,\"columnsStartAt1\":true}}"
recv dap until $.request_seq = 1 timeout 30s every 100ms
json: stdout doc $.body.supportsConditionalBreakpoints = true
json: stdout doc $.body.supportsLogPoints = true
send dap: "{\"seq\":2,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{\"program\":\"{work}/prog.jet\",\"stopOnEntry\":false,\"args\":[]}}"
recv dap until $.event = "initialized" timeout 30s every 100ms
send dap: "{\"seq\":3,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{\"source\":{\"path\":\"{work}/prog.jet\"},\"breakpoints\":[{\"line\":4,\"condition\":\"i == 3\"},{\"line\":7,\"logMessage\":\"total is {total}\"},{\"line\":2,\"condition\":\"i ==\"}]}}"
recv dap until $.request_seq = 3 timeout 30s every 100ms
json: stdout doc $.body.breakpoints[0].verified = true
json: stdout doc $.body.breakpoints[1].verified = true
json: stdout doc $.body.breakpoints[2].verified = false
stdout: ~ "is not a Jet expression" # the malformed condition says why it was not placed
send dap: "{\"seq\":4,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{}}"
recv dap until $.event = "stopped" timeout 30s every 100ms
json: stdout doc $.body.reason = "breakpoint"
send dap: "{\"seq\":5,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
recv dap until $.request_seq = 5 timeout 30s every 100ms
json: stdout doc $.body.stackFrames[0].name = "total_of"
json: stdout doc $.body.stackFrames[0].line = 4
capture: loop_frame stdout doc $.body.stackFrames[0].id
send dap: "{\"seq\":6,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"i\",\"frameId\":{cap:loop_frame},\"context\":\"watch\"}}"
recv dap until $.request_seq = 6 timeout 30s every 100ms
json: stdout doc $.success = true
json: stdout doc $.body.result = "3"
json: stdout doc $.body.type = "Int"
send dap: "{\"seq\":7,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"total + i * 10\",\"frameId\":{cap:loop_frame},\"context\":\"repl\"}}"
recv dap until $.request_seq = 7 timeout 30s every 100ms
json: stdout doc $.success = true
json: stdout doc $.body.result = "33"
send dap: "{\"seq\":8,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"0 < i && i < 4\",\"frameId\":{cap:loop_frame},\"context\":\"repl\"}}"
recv dap until $.request_seq = 8 timeout 30s every 100ms
json: stdout doc $.body.result = "true"
json: stdout doc $.body.type = "Bool"
send dap: "{\"seq\":9,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"missing\",\"frameId\":{cap:loop_frame},\"context\":\"hover\"}}"
recv dap until $.request_seq = 9 timeout 30s every 100ms
json: stdout doc $.success = false
send dap: "{\"seq\":10,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
recv dap collect until ndjson $[?event="terminated"] #>= 1 timeout 30s
stdout: ~ "\"category\":\"console\",\"output\":\"total is 10" # the logpoint logged with the local filled in
stdout: ~ "\"output\":\"10" # and the program ran on to its end
stdout: ~ "\"event\":\"exited\"" # and exited
send dap: "{\"seq\":11,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{}}"
recv dap until $.request_seq = 11 timeout 30s every 100ms
close dap
exit: 0
