# `break <function>` stops at the first line of the function's body on each
# call. The run starts at `run`, whose entry breakpoint is number 1, so
# `break scale` is number 2. The first call has `n = 0`; `finish` returns to
# the loop in `total_of`, and `c` stops in the next call, with `n = 1`.
# Deleting the breakpoint lets the program run to its end.
# The fixture must stay in jet fmt form: line 2 is `scale`'s first line and
# line 8 the loop and its call. No other debugger is on PATH: the stops are
# jet debug's own.
fixture: BreakByFunctionStopsInIt.fixture
env: NO_COLOR=1
step: jet debug prog.jet
env: PATH={work}/no-tools
stdin: break_by_function_stops_in_it.stdin
exit: 0
stdout: ~ "Breakpoint set  scale\n" # the breakpoint names the function
stdout: ~ "Breakpoint hit  prog.jet:2  in scale()\n" # it stops at the body's first line
stdout: ~ "print n\nn = 0\n" # the first call's argument
stdout: ~ "#0  scale()  at prog.jet:2\n" # the backtrace starts in the function
stdout: ~ "#1  total_of()  at prog.jet:8\n" # called from the loop
stdout: ~ "finish\n8 |     loop i in 0..<limit -> total += scale(i, 3)        <- here\n" # finish returns to the call's line in the caller
stdout: ~ "print n\nn = 1\n" # the second call stops too
stdout: ~ "Deleted breakpoint 2\n" # delete takes the breakpoint's number
stdout: ~ "18\n" # the program's own output: 0 + 3 + 6 + 9
stdout: ~ "Program finished\n" # and it runs to its end
