# tests/debug.rs::locals_and_print_show_jet_values
# Public production debugger transcript; PENDING-SAME-HEAD.
# The fixture must stay in jet fmt form: the loop body holds two statements,
# so stepping stops in it with the loop's variable bound.
fixture: LocalsAndPrintShowJetValues.fixture
env: NO_COLOR=1
step: jet debug jet_debug_locals.jet
stdin: locals_and_print_show_jet_values.stdin
exit: any # original transcript-only helper asserts no process code
stdout+stderr: ~ "Locals:  i = 1   n = 3   total = 0" # original contains predicate
stdout+stderr: ~ "total = 0" # original contains predicate
stdout+stderr: ~ "n: Int = 3\ntotal: Int = 0" # `locals` lists each local with its Jet type
