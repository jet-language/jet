# A program that ends itself with `process.exit(3)` is reported as it ended:
# its output, `exited` with exit code 3, then `terminated`, and no stop.
# After its end no request pretends it is paused: `stackTrace`, `evaluate`
# and `continue` each fail, saying the program is not paused. `restart`
# runs it again from the top, to the same end, and `disconnect` closes
# the session cleanly.
fixture: DapCLIEndsOnProcessExitWithAnHonestState.fixture
env: NO_COLOR=1
env: PATH={work}/no-tools
session dap content-length: jet debug --dap {work}/main.jet
send dap: "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"adapterID\":\"jet\",\"pathFormat\":\"path\"}}"
send dap: "{\"seq\":2,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{\"program\":\"{work}/main.jet\",\"stopOnEntry\":false,\"args\":[]}}"
send dap: "{\"seq\":3,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{}}"
recv dap collect until ndjson $[?event="terminated"] #>= 1 timeout 30s
json: stdout ndjson $[?event="exited"][0].body.exitCode = 3
json: stdout ndjson $[?event="stopped"] #= 0
stdout: ~ "\"output\":\"leaving with 3" # the program's own output comes first
send dap: "{\"seq\":4,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
recv dap until $.request_seq = 4 timeout 30s every 100ms
json: stdout doc $.success = false
json: stdout doc $.message = "the program is not paused"
send dap: "{\"seq\":5,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"1 + 1\",\"context\":\"repl\"}}"
recv dap until $.request_seq = 5 timeout 30s every 100ms
json: stdout doc $.success = false
json: stdout doc $.message = "the program is not paused"
send dap: "{\"seq\":6,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
recv dap until $.request_seq = 6 timeout 30s every 100ms
json: stdout doc $.success = false
json: stdout doc $.message = "the program is not paused"
send dap: "{\"seq\":7,\"type\":\"request\",\"command\":\"restart\",\"arguments\":{}}"
recv dap collect until ndjson $[?request_seq=7][?success=true] #>= 1 && ndjson $[?event="terminated"] #>= 1 timeout 30s
json: stdout ndjson $[?event="exited"][0].body.exitCode = 3
json: stdout ndjson $[?event="stopped"] #= 0
send dap: "{\"seq\":8,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{}}"
recv dap until $.request_seq = 8 timeout 30s every 100ms
json: stdout doc $.success = true
close dap
exit: 0
