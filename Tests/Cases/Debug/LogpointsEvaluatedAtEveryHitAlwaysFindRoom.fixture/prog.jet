use process: core.process

count_up: fn(n: Int) -> Int {
    ^total: 0
    loop i in 0..<n {
        step: i % 7
        total += step
    }
    total
}

named: fn(n: Int) -> Int {
    ^total: 0
    loop i in 0..<n {
        word: if i % 2 == 0 -> "even" else -> "odd"
        total += word.len()
    }
    total
}

run: fn() -[Exec.Args, IO]> {
    count: Int.parse(process.args().get(0) ?? "1000") ?? 1000
    print("totals {count_up(count)} {named(count /% 4)}")
}
