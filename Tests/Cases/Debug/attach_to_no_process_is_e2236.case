# `jet debug --attach` of a process id that names no process stops before
# anything is traced with E2236, the registered refusal of a debug target
# that is not as given. No other debugger is on PATH.
env: NO_COLOR=1
step: jet debug --attach 0
env: PATH={work}/no-tools
exit: 1
stdout: = ""
stderr: = ../../CLI/debug_attach_to_no_process_e2236.txt
