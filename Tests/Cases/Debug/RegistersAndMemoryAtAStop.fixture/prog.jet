use process: core.process

// The items' sum, and the sum again for each level of `depth`. The cases
// stop on line 8, the `if` after the loop, when `total` holds the sum.
sum: fn(items: [Int], depth: Int) -> Int {
    ^total: 0
    loop item in items -> total += item
    if depth > 0 -> total += sum(items, depth - 1)
    total
}

run: fn() {
    n: Int.parse(process.args().get(0) ?? "3") ?? 3
    ^items: [Int]{}
    loop k in 0..<n -> items.push(10 * k + 11)
    print("{sum(items, 0)}")
}
