# The program runs the code it was built from, so once its source changes
# the adapter answers for that code or says it can't. Stopped in the loop,
# `evaluate` of `scaled(5)` calls the program's `scaled`: 10. Then the
# source of `scaled` changes on disk (x * 3), and the same `evaluate` is
# refused: the image records the sha256 of each source it was built from
# (`.debug_jetsource`), `scaled`'s no longer matches, and the refusal says
# to rebuild or `fix` it. An expression that doesn't reach the changed
# code still answers, and the program runs on to the total its image
# computes, 6, not the edited source's 9.
# The fixtures must stay in jet fmt form: line 8 is the loop's body.
fixture: DapCLIRefusesAStaleBinaryHonestly.fixture
env: NO_COLOR=1
env: PATH={work}/no-tools
session dap content-length: jet debug --dap {work}/main.jet
send dap: "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"adapterID\":\"jet\",\"pathFormat\":\"path\"}}"
send dap: "{\"seq\":2,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{\"program\":\"{work}/main.jet\",\"stopOnEntry\":false,\"args\":[]}}"
recv dap until $.event = "initialized" timeout 30s every 100ms
send dap: "{\"seq\":3,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{\"source\":{\"path\":\"{work}/main.jet\"},\"breakpoints\":[{\"line\":8}]}}"
recv dap until $.request_seq = 3 timeout 30s every 100ms
json: stdout doc $.body.breakpoints[0].verified = true
send dap: "{\"seq\":4,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{}}"
recv dap until $.event = "stopped" timeout 30s every 100ms
json: stdout doc $.body.reason = "breakpoint"
send dap: "{\"seq\":5,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"scaled(5)\",\"context\":\"repl\"}}"
recv dap until $.request_seq = 5 timeout 60s every 100ms
json: stdout doc $.success = true
json: stdout doc $.body.result = "10"
copy: edited.src main.jet
send dap: "{\"seq\":6,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"scaled(5)\",\"context\":\"repl\"}}"
recv dap until $.request_seq = 6 timeout 60s every 100ms
json: stdout doc $.success = false
stdout: ~ "`scaled`'s source `" # the refusal names the reached item and its source
stdout: ~ "changed since the program was built; rebuild the program, or `fix` it first" # it says why and what to do
send dap: "{\"seq\":7,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"k + 40\",\"context\":\"repl\"}}"
recv dap until $.request_seq = 7 timeout 60s every 100ms
json: stdout doc $.success = true
json: stdout doc $.body.result = "40"
send dap: "{\"seq\":8,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{\"source\":{\"path\":\"{work}/main.jet\"},\"breakpoints\":[]}}"
recv dap until $.request_seq = 8 timeout 30s every 100ms
json: stdout doc $.success = true
send dap: "{\"seq\":9,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
recv dap collect until ndjson $[?event="terminated"] #>= 1 timeout 30s
stdout: ~ "\"output\":\"6\\n\"" # the image's code ran: 0 + 2 + 4
json: stdout ndjson $[?event="exited"][0].body.exitCode = 0
send dap: "{\"seq\":10,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{}}"
recv dap until $.request_seq = 10 timeout 30s every 100ms
json: stdout doc $.success = true
close dap
exit: 0
