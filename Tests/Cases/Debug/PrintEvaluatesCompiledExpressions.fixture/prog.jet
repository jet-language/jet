Point: struct {
    x: Int,
    y: Int,

    // The sum of the two coordinates.
    sum: fn(self) -> Int { self.x + self.y }
}

Line: struct {
    from: Point,
    to: Point,
}

largest: fn<T: Comparable>(a: T, b: T) -> T { if a > b -> a else -> b }

run: fn() {
    line: Line{from: Point{x: 1, y: 2}, to: Point{x: 30, y: 40}}
    xs: [Int]{4, 9, 16}
    label: "jet"
    print("{line.to.x} {xs[1]} {label} {largest(xs[0], xs[2])} {line.from.sum()}")
}
