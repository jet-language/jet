// The one way the parsers here fail.
#Error
ParseError: enum {
    Empty,
}

// The length of `s`; an empty `s` is no number.
parse: fn(s: String) -> Int ParseError! {
    if s == "" -> return Err(ParseError.Empty)
    s.len()
}

// As `parse`, its failure found by the compiler.
loose: fn(s: String) -> Int {
    if s == "" -> return Err(.Empty)
    s.len()
}

run: fn() {
    word: "abc"
    blank: ""
    print("{parse(word) ?? 0} {loose(blank) ?? 0}")
}
