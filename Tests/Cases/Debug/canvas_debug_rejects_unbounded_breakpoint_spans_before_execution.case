# tests/debug.rs::canvas_debug_rejects_unbounded_breakpoint_spans_before_execution
# Exact production WebHost Canvas requests/subclaims, original source unchanged.
# Core.net client mirrors the existing raw HTTP fixture pattern.
fixture: CanvasDebugRejectsUnboundedBreakpointSpansBeforeExecution.fixture
env: NO_COLOR=1
step: jet build client/run.jet
exit: 0
copy: client/.jet/build/run canvas-client
session canvas raw: jet dev jet_debug_canvas_breakpoint_limit.jet --canvas --canvas-port 0
env: JET_CANVAS_BROWSER=/definitely/missing/canvas-browser
recv canvas until ~ "Canvas: http" within 60s # jet dev prints the Canvas URL on stdout once it serves
capture: url = text stdout.after_first("Canvas: ").line(0)
capture: revision = sha256 file jet_debug_canvas_breakpoint_limit.jet
capture: original_source = text file jet_debug_canvas_breakpoint_limit.jet
write: request.json canvas_debug_rejects_unbounded_breakpoint_spans_before_execution.request.json
step request: {work}/canvas-client
env: S1_CANVAS_URL={cap:url}
env: S1_METHOD=POST
env: S1_PATH=/__jet_canvas/debug
exit: 0
stdout: ^= "HTTP/1.1 409" # original success vs expect_err projection
stdout: ~ "\"kind\":\"limit\"" # original contains predicate
file: jet_debug_canvas_breakpoint_limit.jet = "{cap:original_source}"
signal canvas: INT
wait: canvas
exit: any # original only asserts session/store/source predicates, not dev server shutdown status
