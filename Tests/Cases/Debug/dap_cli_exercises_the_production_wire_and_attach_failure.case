# The adapter answers `initialize` and verifies a breakpoint against the
# image's line table, then refuses an `attach` whose process id names no
# process: the DAP error carries the user-configuration code E2236, and no
# program stops. No other debugger is on PATH.
fixture: DapCLIExercisesTheProductionWireAndAttachFailure.fixture
env: NO_COLOR=1
session dap content-length: jet debug --dap {work}/main.jet
env: PATH={work}/no-tools
send dap: "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"adapterID\":\"jet\",\"pathFormat\":\"path\",\"linesStartAt1\":true,\"columnsStartAt1\":true}}"
send dap: "{\"seq\":2,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{\"source\":{\"path\":\"{work}/main.jet\"},\"breakpoints\":[{\"line\":4}]}}"
send dap: "{\"seq\":3,\"type\":\"request\",\"command\":\"attach\",\"arguments\":{\"processId\":0}}"
close dap
exit: 0
stdout.find_block("Content-Length:", ~ "\"request_seq\":1,"): ~ "\"success\":true,\"command\":\"initialize\"" # the adapter answers initialize
stdout.find_block("Content-Length:", ~ "\"request_seq\":2,"): ~ "\"success\":true,\"command\":\"setBreakpoints\"" # and setBreakpoints
stdout.find_block("Content-Length:", ~ "\"request_seq\":2,"): ~ "\"verified\":true,\"line\":4" # the loop's line has code, so the breakpoint is verified
stdout.find_block("Content-Length:", ~ "\"request_seq\":3,"): ~ "\"success\":false,\"command\":\"attach\"" # process id 0 is refused
stdout.find_block("Content-Length:", ~ "\"request_seq\":3,"): ~ "\"id\":22032" # as invalid arguments
stdout.find_block("Content-Length:", ~ "\"request_seq\":3,"): ~ "\"jetCode\":\"E2236\"" # carrying the registered configuration code
stdout: !~ "\"event\":\"stopped\"" # nothing ran, so nothing stopped
