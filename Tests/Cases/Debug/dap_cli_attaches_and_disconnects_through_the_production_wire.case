# A DAP client attaches to a program already running: the adapter seizes
# it where it is (the process stops, traced), reports it paused once the
# client is configured, and lets it run on at `disconnect`. The system lets a
# process trace only its own children here, so the authorizer lets any
# process trace the program before it runs it. No other debugger is on PATH.
requires: os-name:linux
requires: arch:x86_64
requires: tool:cc
fixture: DapCLIAttachesAndDisconnectsThroughTheProductionWire.fixture
env: NO_COLOR=1
copy: {root}/Tests/Fixtures/Ptrace/authorizer.c authorizer.c
step: cc authorizer.c -o authorizer
exit: 0
step: jet build -O0 main.jet
exit: 0
spawn target: {work}/authorizer {work}/.jet/build/main
await: process {pid:target} executable = {work}/.jet/build/main timeout 5s every 10ms
session dap content-length: jet debug --dap {work}/main.jet
env: PATH={work}/no-tools
send dap: "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"adapterID\":\"jet\",\"pathFormat\":\"path\"}}"
send dap: "{\"seq\":2,\"type\":\"request\",\"command\":\"attach\",\"arguments\":{\"processId\":{pid:target},\"program\":\"{work}/.jet/build/main\"}}"
await: process {pid:target} state in ["T","t"] timeout 30s every 20ms
send dap: "{\"seq\":3,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{}}"
send dap: "{\"seq\":4,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{}}"
close dap
exit: 0
stdout: ~ "\"request_seq\":2,\"success\":true,\"command\":\"attach\"" # the attach succeeds
stdout: ~ "\"event\":\"initialized\"" # and the client may configure the session
stdout: ~ "\"reason\":\"pause\"" # configured, the program is reported paused where it was taken
stdout: ~ "\"request_seq\":4,\"success\":true,\"command\":\"disconnect\"" # disconnect detaches
stdout: !~ "\"success\":false" # no request fails
process {pid:target}: alive-nonzombie
await: process {pid:target} state not-in ["T","t"] timeout 2s every 20ms
signal target: KILL
wait: target
exit: any # the target ends by the case's own KILL
