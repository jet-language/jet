use core.process

// A thousand strings, each its own allocation; given `stop`, the program
// ends by a stop (status 70) after them.
run: fn() {
    words := [String]{}
    loop n in 0..<1000 -> words.push("word {n}")
    print("words: {words.len()}")
    if process.args().contains("stop") -> panic("stopped after {words.len()} words")
}
