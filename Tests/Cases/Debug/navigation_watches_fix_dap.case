# Over `jet debug --dap` an editor navigates forward and back, watches Jet
# paths within the CPU's bound, and fixes the running program, on the
# replay and live routes. In a replay of a recorded run (`--replay=nav`),
# `reverseContinue` goes back from the second hit of line 32 to the first,
# where `round` is 0 again, `stepBack` goes to the line before, and a data
# breakpoint on the field path `order.total` stops at the write that
# changes it. Live, with the argument `edit`, `stepIn` goes from line 32
# into `price`, `stepOut` back to line 32 and `next` on to line 33; data
# breakpoints on `order.total`, `order.count` and `helper` take three of
# the four debug registers, so one on `order`, which needs two, is not
# verified and names the bound. The one on `order.total` stops at its first
# change, where Jet's `fix` request swaps in the edit the program moved over
# its source at round 1, and the next change is the new `price`'s.
# The recording comes first: the live session's edit changes the source a
# replay must match. The fixture must stay in jet fmt form; line 16 is
# `price`'s first line and line 32 adds its result to `order.total`.
fixture: NavigationWatchesFix.fixture
env: NO_COLOR=1
step: jet run --record=nav prog.jet
exit: 0
stdout: ~ "total 60 count 4 helper 3\n" # the recorded run
session dap content-length: jet debug --dap --replay=nav {work}/prog.jet
send dap: "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"adapterID\":\"jet\",\"pathFormat\":\"path\",\"linesStartAt1\":true,\"columnsStartAt1\":true}}"
recv dap until $.request_seq = 1 timeout 30s every 100ms
json: stdout doc $.body.supportsStepBack = true
json: stdout doc $.body.supportsDataBreakpoints = true
send dap: "{\"seq\":2,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{\"program\":\"{work}/prog.jet\",\"stopOnEntry\":false,\"args\":[]}}"
recv dap until $.event = "initialized" timeout 30s every 100ms
send dap: "{\"seq\":3,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{\"source\":{\"path\":\"{work}/prog.jet\"},\"breakpoints\":[{\"line\":32}]}}"
recv dap until $.request_seq = 3 timeout 30s every 100ms
json: stdout doc $.body.breakpoints[0].verified = true
send dap: "{\"seq\":4,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{}}"
recv dap until $.event = "stopped" timeout 30s every 100ms
json: stdout doc $.body.reason = "breakpoint"
send dap: "{\"seq\":5,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
recv dap until $.event = "stopped" timeout 30s every 100ms
json: stdout doc $.body.reason = "breakpoint"
send dap: "{\"seq\":6,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"round\",\"context\":\"repl\"}}"
recv dap until $.request_seq = 6 timeout 30s every 100ms
json: stdout doc $.body.result = "1" # the second hit
send dap: "{\"seq\":7,\"type\":\"request\",\"command\":\"reverseContinue\",\"arguments\":{\"threadId\":1}}"
recv dap until $.event = "stopped" timeout 60s every 100ms
send dap: "{\"seq\":8,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"round\",\"context\":\"repl\"}}"
recv dap until $.request_seq = 8 timeout 30s every 100ms
json: stdout doc $.body.result = "0" # back at the first hit
send dap: "{\"seq\":9,\"type\":\"request\",\"command\":\"stepBack\",\"arguments\":{\"threadId\":1}}"
recv dap until $.event = "stopped" timeout 60s every 100ms
json: stdout doc $.body.reason = "step"
send dap: "{\"seq\":10,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
recv dap until $.request_seq = 10 timeout 30s every 100ms
json: stdout doc $.body.stackFrames[0].name = "run"
json: stdout doc $.body.stackFrames[0].line = 31 # the line before
send dap: "{\"seq\":11,\"type\":\"request\",\"command\":\"dataBreakpointInfo\",\"arguments\":{\"name\":\"order.total\"}}"
recv dap until $.request_seq = 11 timeout 30s every 100ms
json: stdout doc $.body.accessTypes[0] = "write"
capture: recorded stdout doc $.body.dataId
send dap: "{\"seq\":12,\"type\":\"request\",\"command\":\"setDataBreakpoints\",\"arguments\":{\"breakpoints\":[{\"dataId\":\"{cap:recorded}\"}]}}"
recv dap until $.request_seq = 12 timeout 30s every 100ms
json: stdout doc $.body.breakpoints[0].verified = true # a watch on a field path in the replay
send dap: "{\"seq\":13,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{\"source\":{\"path\":\"{work}/prog.jet\"},\"breakpoints\":[]}}"
recv dap until $.request_seq = 13 timeout 30s every 100ms
send dap: "{\"seq\":14,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
recv dap until $.event = "stopped" timeout 60s every 100ms
json: stdout doc $.body.reason = "data breakpoint"
json: stdout doc $.body.description = "order.total: 0 -> 10" # it stops at the write that changes it
send dap: "{\"seq\":15,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{}}"
recv dap until $.request_seq = 15 timeout 30s every 100ms
json: stdout doc $.success = true
close dap
exit: 0
session live content-length: jet debug --dap {work}/prog.jet
send live: "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"adapterID\":\"jet\",\"pathFormat\":\"path\",\"linesStartAt1\":true,\"columnsStartAt1\":true}}"
recv live until $.request_seq = 1 timeout 30s every 100ms
json: stdout doc $.success = true
send live: "{\"seq\":2,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{\"program\":\"{work}/prog.jet\",\"stopOnEntry\":false,\"args\":[\"edit\"]}}"
recv live until $.event = "initialized" timeout 30s every 100ms
send live: "{\"seq\":3,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{\"source\":{\"path\":\"{work}/prog.jet\"},\"breakpoints\":[{\"line\":32}]}}"
recv live until $.request_seq = 3 timeout 30s every 100ms
json: stdout doc $.body.breakpoints[0].verified = true
send live: "{\"seq\":4,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{}}"
recv live until $.event = "stopped" timeout 30s every 100ms
json: stdout doc $.body.reason = "breakpoint"
send live: "{\"seq\":5,\"type\":\"request\",\"command\":\"stepIn\",\"arguments\":{\"threadId\":1}}"
recv live until $.event = "stopped" timeout 30s every 100ms
json: stdout doc $.body.reason = "step"
send live: "{\"seq\":6,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
recv live until $.request_seq = 6 timeout 30s every 100ms
json: stdout doc $.body.stackFrames[0].name = "price" # into the call
json: stdout doc $.body.stackFrames[0].line = 16
send live: "{\"seq\":7,\"type\":\"request\",\"command\":\"stepOut\",\"arguments\":{\"threadId\":1}}"
recv live until $.event = "stopped" timeout 30s every 100ms
send live: "{\"seq\":8,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
recv live until $.request_seq = 8 timeout 30s every 100ms
json: stdout doc $.body.stackFrames[0].name = "run" # out to the caller
json: stdout doc $.body.stackFrames[0].line = 32
send live: "{\"seq\":9,\"type\":\"request\",\"command\":\"next\",\"arguments\":{\"threadId\":1}}"
recv live until $.event = "stopped" timeout 30s every 100ms
send live: "{\"seq\":10,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
recv live until $.request_seq = 10 timeout 30s every 100ms
json: stdout doc $.body.stackFrames[0].line = 33 # over to the next line
send live: "{\"seq\":11,\"type\":\"request\",\"command\":\"dataBreakpointInfo\",\"arguments\":{\"name\":\"order.total\"}}"
recv live until $.request_seq = 11 timeout 30s every 100ms
capture: total stdout doc $.body.dataId
send live: "{\"seq\":12,\"type\":\"request\",\"command\":\"dataBreakpointInfo\",\"arguments\":{\"name\":\"order.count\"}}"
recv live until $.request_seq = 12 timeout 30s every 100ms
capture: count stdout doc $.body.dataId
send live: "{\"seq\":13,\"type\":\"request\",\"command\":\"dataBreakpointInfo\",\"arguments\":{\"name\":\"helper\"}}"
recv live until $.request_seq = 13 timeout 30s every 100ms
capture: helper stdout doc $.body.dataId
send live: "{\"seq\":14,\"type\":\"request\",\"command\":\"dataBreakpointInfo\",\"arguments\":{\"name\":\"order\"}}"
recv live until $.request_seq = 14 timeout 30s every 100ms
capture: order stdout doc $.body.dataId
send live: "{\"seq\":15,\"type\":\"request\",\"command\":\"setDataBreakpoints\",\"arguments\":{\"breakpoints\":[{\"dataId\":\"{cap:total}\"},{\"dataId\":\"{cap:count}\"},{\"dataId\":\"{cap:helper}\"},{\"dataId\":\"{cap:order}\"}]}}"
recv live until $.request_seq = 15 timeout 30s every 100ms
json: stdout doc $.body.breakpoints[0].verified = true # a watch on a field path
json: stdout doc $.body.breakpoints[2].verified = true # three watches hold three debug registers
json: stdout doc $.body.breakpoints[3].verified = false # a watch past the bound is not placed
stdout: ~ "`order` needs 2 of the CPU's 4 debug registers and 1 are free" # and names the bound
send live: "{\"seq\":16,\"type\":\"request\",\"command\":\"setDataBreakpoints\",\"arguments\":{\"breakpoints\":[{\"dataId\":\"{cap:total}\"}]}}"
recv live until $.request_seq = 16 timeout 30s every 100ms
json: stdout doc $.body.breakpoints[0].verified = true
send live: "{\"seq\":17,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{\"source\":{\"path\":\"{work}/prog.jet\"},\"breakpoints\":[]}}"
recv live until $.request_seq = 17 timeout 30s every 100ms
send live: "{\"seq\":18,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
recv live until $.event = "stopped" timeout 30s every 100ms
json: stdout doc $.body.reason = "data breakpoint"
json: stdout doc $.body.description = "order.total: 0 -> 10" # the watch stops at the first change
send live: "{\"seq\":19,\"type\":\"request\",\"command\":\"fix\",\"arguments\":{}}"
recv live until $.request_seq = 19 timeout 120s every 100ms
json: stdout doc $.success = true
json: stdout doc $.body.message = "Fixed `price`: the edit runs from the next call" # fix swaps the edit in
send live: "{\"seq\":20,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
recv live until $.event = "stopped" timeout 30s every 100ms
json: stdout doc $.body.reason = "data breakpoint"
json: stdout doc $.body.description = "order.total: 10 -> 1030" # the next change is the fixed price's
send live: "{\"seq\":21,\"type\":\"request\",\"command\":\"setDataBreakpoints\",\"arguments\":{\"breakpoints\":[]}}"
recv live until $.request_seq = 21 timeout 30s every 100ms
send live: "{\"seq\":22,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
recv live collect until ndjson $[?event="terminated"] #>= 1 timeout 30s
stdout: ~ "total 2060 count 4 helper 3" # the fixed program runs to its end
stdout: ~ "\"event\":\"exited\"" # and exits
send live: "{\"seq\":23,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{}}"
recv live until $.request_seq = 23 timeout 30s every 100ms
close live
exit: 0
