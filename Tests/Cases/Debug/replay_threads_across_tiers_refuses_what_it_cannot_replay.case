# `jet debug --replay` refuses before the program runs: a NAME that can't
# name a recording, a recording that isn't there, and an image with no
# observation start (a program with no task, channel, live value or event,
# built by `jet build`), where its runtime would run without the recording.
# jet debug's own -O0 build keeps every runtime function, the start among
# them, so the image comes from `jet build`. `jet debug --record` records a
# source file alone, so it refuses that image before anything runs.
fixture: ReplayThreadsAcrossTiers.fixture
env: NO_COLOR=1
step: jet debug --replay=../tiers prog.jet
exit: 2
stderr: ~ "`--replay=../tiers` names no recording" # the line that names the refusal or the result
step: jet debug --replay=tiers prog.jet
exit: 1
stderr: ~ "No recording `.jet/replays/tiers.jetproof-replay`" # the line that names the refusal or the result
stdout: !~ "joined" # nothing ran
step: jet run -O2 --record=tiers prog.jet
exit: 0
copy: plain.src prog.jet
step: jet build prog.jet
exit: 0
step: jet debug --replay=tiers {work}/.jet/build/prog
exit: 2
stderr: ~ "can't replay its recording" # the line that names the refusal or the result
stderr: ~ "has no observation start" # the line that names the refusal or the result
stdout: !~ "plain" # nothing ran
step: jet debug --record=other {work}/.jet/build/prog
exit: 2
stderr: ~ "records a run of a `.jet` source file" # the line that names the refusal or the result
stdout: !~ "plain" # nothing ran
