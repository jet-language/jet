# The debugger reads the code a build ships. `total` leaves its loop two
# ways, by the loop's test and by the `break`, so after the loop its value
# is the join of both. Stopped on the line after the loop, `total` is a
# local with the value the `break` left, listed after the parameter `n`,
# which no register holds there any more: it reads as the value it entered
# with.
# The fixture must stay in jet fmt form.
fixture: LocalJoinedAtABreakExitStaysVisible.fixture
env: NO_COLOR=1
step: jet debug prog.jet
stdin: local_joined_at_a_break_exit_stays_visible_after_the_loop.stdin
exit: 0
stdout: ~ "Breakpoint hit  prog.jet:8  in total_of()" # the line after the loop
stdout: ~ "Locals:  n = 5   total = 6" # the joined local is listed at the stop, after the parameter's entry value
stdout: ~ "(Jet) print total\ntotal = 6\n" # and reads as the value the `break` left
stdout: ~ "6\nProgram finished\n" # the program runs on to its end
