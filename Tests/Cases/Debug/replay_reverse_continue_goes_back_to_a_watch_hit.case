# `rc` goes back to a watch's stop as well as a breakpoint's: with only a
# watch on `total`, from its second change it goes back to its first,
# showing that write again.
# The fixture must stay in jet fmt form; line 21 adds to `total`.
fixture: ReplayReverse.fixture
env: NO_COLOR=1
step: jet run --record=back prog.jet
exit: 0
step: jet debug --replay=back prog.jet
stdin: replay_reverse_continue_goes_back_to_a_watch_hit.stdin
exit: 0
stdout: ~ "Watchpoint 3 hit  prog.jet:21  in run()\ntotal: 2 -> 6\n" # the second change
stdout: ~ "(Jet) rc\nWatchpoint 3 hit  prog.jet:21  in run()\ntotal: 0 -> 2\n" # back to the first
stdout: ~ "total 6 tally " # the program's own output among the session's
stdout: ~ "Program finished\n" # the session runs the program to its end
stdout+stderr: !~ "replay diverged"
