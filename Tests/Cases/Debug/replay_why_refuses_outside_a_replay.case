# `why` follows a value back through new runs of the program, which only
# a recording makes the same: a session without `--replay` refuses it and
# stays at its stop.
# The fixture must stay in jet fmt form.
fixture: ReplayReverse.fixture
env: NO_COLOR=1
step: jet debug prog.jet
stdin: replay_why_refuses_outside_a_replay.stdin
exit: 0
stdout: ~ "(Jet) why total\n`why` runs in a replay: start the session with `jet debug --replay=NAME`\n" # the command and its answer among the session's output
stdout: ~ "Program finished\n" # the session runs the program to its end
