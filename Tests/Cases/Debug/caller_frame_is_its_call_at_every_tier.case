json: stdout doc $.body.stackFrames[1].column = 37 # the same call column on O1
json: stdout doc $.body.stackFrames[2].name = "run"
json: stdout doc $.body.stackFrames[2].line = 14
json: stdout doc $.body.stackFrames[2].column = 10
capture: frame_o1 stdout doc $.body.stackFrames[1].id
send o1: "{\"seq\":6,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"limit\",\"frameId\":{cap:frame_o1},\"context\":\"repl\"}}"
recv o1 until $.request_seq = 6 timeout 30s every 100ms
json: stdout doc $.success = true
json: stdout doc $.body.result = "4"
send o1: "{\"seq\":7,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{\"source\":{\"path\":\"{work}/prog.jet\"},\"breakpoints\":[]}}"
recv o1 until $.request_seq = 7 timeout 30s every 100ms
send o1: "{\"seq\":8,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{\"threadId\":1}}"
recv o1 collect until ndjson $[?event="terminated"] #>= 1 timeout 30s
stdout: ~ "\"exitCode\":0" # the program ran on to its end
send o1: "{\"seq\":9,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{}}"
recv o1 until $.request_seq = 9 timeout 30s every 100ms
close o1
exit: 0
step: jet build -O2 --inline=off prog.jet
exit: 0
