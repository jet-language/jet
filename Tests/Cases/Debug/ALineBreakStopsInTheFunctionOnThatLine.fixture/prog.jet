use process: core.process

/// Inlined into `host` at O1 and O2, so `host` holds a copy of this
/// line's code after `middle`'s own.
early: fn(n: Int) -> Int { n * 3 + 1 }

middle: fn(n: Int) -> Int {
    if n <= 0 -> return 1
    ^total: middle(n - 1) + n
    total * 2
}

host: fn(n: Int) -> Int {
    ^a: early(n)
    loop k in 0..<n -> a += early(k)
    a
}

run: fn() {
    n: Int.parse(process.args().get(0) ?? "5") ?? 5
    first: host(n)
    print("{first} {middle(first % 7)}")
}
