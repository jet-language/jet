# `watch xs[3]` follows the item when `xs` grows past its capacity and moves
# to a new buffer: the watch also traps the List's data word, and when a
# write moves the List it watches the same item in the new buffer. Copying
# the item to the new buffer leaves its value as it was, so the moves never
# stop; the two writes to xs[3] do. The run starts at `run`, whose entry
# breakpoint was number 1, so `break 3` is 2 and the watch is 3. The first
# loop moves `xs` from its 4 items to room for 104, the second to room for
# 204, each through several new buffers. The fixture must stay in jet fmt
# form: line 3 is the first loop, lines 4 and 6 the writes to xs[3].
fixture: WatchFollowsAReallocatedList.fixture
env: NO_COLOR=1
env: PATH={work}/no-tools
step: jet debug prog.jet
stdin: watch_follows_a_reallocated_list.stdin
exit: 0
stdout: ~ "Breakpoint hit  prog.jet:3  in fill()\n" # the breakpoint stops before the List grows
stdout: ~ "Watchpoint 3  xs[3] = 40\n" # the watch reads the item
stdout: ~ "Watchpoint 3 hit  prog.jet:4  in fill()\nxs[3]: 40 -> 41\n" # the first write after the List moved stops
stdout: ~ "Watchpoint 3 hit  prog.jet:6  in fill()\nxs[3]: 41 -> 42\n" # so does the write after it moved again
stdout: !~ "xs[3]: 40 -> 40" # moving the item to a new buffer never stops
stdout: !~ "xs[3]: 41 -> 41" # nor does the second loop's
stdout: !~ "ended" # the watch lives through every move
stdout: ~ "246\n" # the program prints its result
stdout: ~ "Program finished\n" # and runs to its end
