# An attached program was started by someone else, so the adapter can't
# start it again: `restart` fails, saying to disconnect and attach again,
# and the program stays as it was, attached and paused where it was taken,
# with its stack still answered. `disconnect` then lets it run on. The
# system lets a process trace only its own children here, so the
# authorizer lets any process trace the program before it runs it.
requires: os-name:linux
requires: arch:x86_64
requires: tool:cc
fixture: DapCLIAttachesAndDisconnectsThroughTheProductionWire.fixture
env: NO_COLOR=1
copy: {root}/Tests/Fixtures/Ptrace/authorizer.c authorizer.c
step: cc authorizer.c -o authorizer
exit: 0
step: jet build -O0 main.jet
exit: 0
spawn target: {work}/authorizer {work}/.jet/build/main
await: process {pid:target} executable = {work}/.jet/build/main timeout 5s every 10ms
session dap content-length: jet debug --dap {work}/main.jet
env: PATH={work}/no-tools
send dap: "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"adapterID\":\"jet\",\"pathFormat\":\"path\"}}"
send dap: "{\"seq\":2,\"type\":\"request\",\"command\":\"attach\",\"arguments\":{\"processId\":{pid:target},\"program\":\"{work}/.jet/build/main\"}}"
recv dap until $.request_seq = 2 timeout 30s every 100ms
json: stdout doc $.success = true
send dap: "{\"seq\":3,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{}}"
recv dap until $.event = "stopped" timeout 30s every 100ms
json: stdout doc $.body.reason = "pause"
send dap: "{\"seq\":4,\"type\":\"request\",\"command\":\"restart\",\"arguments\":{}}"
recv dap until $.request_seq = 4 timeout 30s every 100ms
json: stdout doc $.success = false
json: stdout doc $.message = "an attached program does not restart; disconnect and attach again"
process {pid:target}: alive-nonzombie
send dap: "{\"seq\":5,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
recv dap until $.request_seq = 5 timeout 30s every 100ms
json: stdout doc $.success = true
json: stdout doc $.body.stackFrames[0].name = "run"
send dap: "{\"seq\":6,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{}}"
recv dap until $.request_seq = 6 timeout 30s every 100ms
json: stdout doc $.success = true
close dap
exit: 0
process {pid:target}: alive-nonzombie
await: process {pid:target} state not-in ["T","t"] timeout 2s every 20ms
signal target: KILL
wait: target
exit: any # the target ends by the case's own KILL
