use {
    process: core.process
    time: core.time
}

count_up: fn(n: Int) -> Int {
    total := 0
    loop i in 0..<n {
        step: i % 7
        total += step
    }
    total
}

named: fn(n: Int) -> Int {
    total := 0
    loop i in 0..<n {
        word: if i % 2 == 0 -> "even" else -> "odd"
        total += word.len()
    }
    total
}

run: fn() -[Exec.Args, IO, Time]> {
    count: Int.parse(process.args().get(0) ?? "1000000") ?? 1000000
    started: time.start()
    first: count_up(count)
    took: time.elapsed(started).ns
    print(if took < 5000000000 -> "a million logged hits under five seconds" else -> "a million logged hits took {took} ns")
    print("totals {first} {named(2)}")
}
