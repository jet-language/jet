# `watch <place>` stops at each write that changes the place and names the
# line that wrote it, with the old and new values; a write that leaves the
# value as it was (`total += 0`, and `total += k` when k is 0) runs on.
# The run starts at `run`, whose entry breakpoint was number 1, so `break 4`
# is 2 and the watch is 3; `breaks` lists the watch once the breakpoint is
# deleted. sum_even(6) adds k = 2 and k = 4: two stops, then the program
# finishes. The fixture must stay in jet fmt form: line 4 is the loop body's
# first statement.
fixture: WatchStopsAtTheChangingWrite.fixture
env: NO_COLOR=1
step: jet debug prog.jet
stdin: watch_stops_at_the_changing_write.stdin
exit: 0
stdout: ~ "Breakpoint hit  prog.jet:4  in sum_even()\n" # the breakpoint stops before the watch is set
stdout: ~ "Watchpoint 3  total = 0\n" # the watch reads the current value
stdout: ~ "Deleted breakpoint 2\n" # the temporary breakpoint is gone
stdout: ~ "breaks\n  3 watch total\n" # the watch is listed by its number
stdout: ~ "Watchpoint 3 hit  prog.jet:4  in sum_even()\ntotal: 0 -> 2\n" # the first stop is the write that changes total
stdout: ~ "Watchpoint 3 hit  prog.jet:4  in sum_even()\ntotal: 2 -> 6\n" # the next stop is the next changing write
stdout: !~ "total: 0 -> 0" # an unchanging write never stops
stdout: !~ "total: 2 -> 2" # a write of the same value never stops
stdout: ~ "6\n" # the program prints its sum
stdout: ~ "Program finished\n" # and runs to its end
