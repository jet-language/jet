# `jet run --record=NAME` of an -O2 program whose tasks share a channel and a
# lock runs it as an unrecorded run does, in a child whose runtime logs every
# sync event and input, and publishes the log as the replay artifact
# `.jet/replays/NAME.jetproof-replay` that `jet debug --replay=NAME` re-runs.
# A NAME already recorded is refused before anything runs, a bare `--record`
# is a usage error, and `jet dev --record` stays unbuilt.
fixture: ReplayThreadsAcrossTiers.fixture
env: NO_COLOR=1
step: jet run -O2 --record=tiers prog.jet
exit: 0
stdout: ~ "worker 3 saw tally " # the workers' lines reach stdout live
stdout: ~ "joined 12 rounds, tally 12\n" # and the run ends as it does unrecorded
stderr: ~ "jet run: recorded replay `.jet/replays/tiers.jetproof-replay`" # the line that names the refusal or the result
file: .jet/replays/tiers.jetproof-replay is-file
step: jet run -O2 --record=tiers prog.jet
exit: 1
stderr: ~ "the recording `.jet/replays/tiers.jetproof-replay` already exists" # the line that names the refusal or the result
stdout: !~ "joined" # refused before the program runs
step: jet run --record prog.jet
exit: 2
stderr: ~ "`--record` needs a NAME" # the line that names the refusal or the result
step: jet dev --record=other prog.jet
exit: any # the recorder that is not built yet refuses; its status is not the contract
stderr: ~ "`jet dev --record` is not built yet" # the line that names the refusal or the result
