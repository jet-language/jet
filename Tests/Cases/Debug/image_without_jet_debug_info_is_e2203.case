# `jet debug` of a path that isn't a `.jet` file debugs it as a built
# image. A file with no Jet debug information (here a text file) stops the
# session before anything runs with E2203, the native debugger's registered
# failure, which names no external tool.
fixture: ImageWithoutJetDebugInfoIsE2203.fixture
env: NO_COLOR=1
step: jet debug app
exit: 1
stdout: = ""
stderr: = ../../CLI/debug_image_without_jet_debug_info_e2203.txt
