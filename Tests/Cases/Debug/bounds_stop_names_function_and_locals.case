# A list bounds stop (E3010) names the faulting function and the column of
# the failing access, shows the source line under a caret and lists the
# frame's Int, Float and Bool locals, as a `panic` report does, on every tier
# and in the built binary, whether the locals reach the runtime in a frame
# area or in registers. `backtrace: off` drops that frame.
fixture: BoundsStopNamesFunctionAndLocals.fixture
env: NO_COLOR=1
step index_o0: jet run -O0 main.jet
exit: 70
stdout: = "past the end\n"
stderr: ~ "Stop: Jet.ArithmeticOrBoundsFailure: `the list has 3 items, so position 7 doesn't exist`\n  --> main.jet:8:7 in pick\n    |\n8 |     xs[at] + total\n    |       ^^^^\nlocals: at = 7, late = true, scale = 1.5, total = 10\n Why:" # the function, the access's column, the caret under the index and the locals
step index_o1: jet run -O1 main.jet
exit: 70
stderr: ~ "  --> main.jet:8:7 in pick\n    |\n8 |     xs[at] + total\n    |       ^^^^\nlocals: at = 7, late = true, scale = 1.5, total = 10\n" # the same report on O1
step index_o2: jet run -O2 main.jet
exit: 70
stderr: ~ "  --> main.jet:8:7 in pick\n    |\n8 |     xs[at] + total\n    |       ^^^^\nlocals: at = 7, late = true, scale = 1.5, total = 10\n" # the same report on O2, where `pick` is inlined
step: jet build main.jet
exit: 0
step index_aot: {work}/.jet/build/main
exit: 70
stderr: ~ "  --> main.jet:8:7 in pick\n" # the built binary names the function and column too
stderr: ~ "locals: at = 7, late = true, scale = 1.5, total = 10\n" # and lists its locals
step insert_o0: jet run -O0 insert.jet
exit: 70
stderr: ~ "Stop: Jet.ArithmeticOrBoundsFailure: `the list has 2 items, so position 5 doesn't exist`\n  --> insert.jet:4:9 in grow\n    |\n4 |     out.insert(at, 0)\n    |         ^^^^^^\nlocals: at = 5\n" # a list method's stop: the column and caret at the method, list locals left out
step registers_o0: jet run -O0 registers.jet
exit: 70
stderr: ~ "Stop: Jet.ArithmeticOrBoundsFailure: `the list has 3 items, so position 4 doesn't exist`\n  --> registers.jet:8:20 in walk\n    |\n8 |         total += xs[i * 2]\n    |                    ^^^^^^^\nlocals: i = 2, total = 4, wrapped = true\n" # three Int and Bool locals, passed in registers
step registers_o2: jet run -O2 registers.jet
exit: 70
stderr: ~ "locals: i = 2, total = 4, wrapped = true\n" # the same words on O2, read from where the loop keeps them
step deferred_o0: jet run -O0 deferred.jet
exit: 70
stderr: ~ "Stop: Jet.ArithmeticOrBoundsFailure: `the list has 3 items, so position 9 doesn't exist`\n  --> deferred.jet:6:7 in tally\n    |\n6 |     xs[at] + total\n    |       ^^^^\nlocals: at = 9, total = 12\n" # a `defer` adds an entry with no name and no slot to the frame, and the report passes over it
stderr: !~ "Internal compiler error" # the compiler doesn't trip over that entry
step deferred_o2: jet run -O2 deferred.jet
exit: 70
stderr: ~ "locals: at = 9, total = 12\n" # the same locals on O2
step index_off: jet run --backtrace=off main.jet
exit: 70
stderr: ~ "Stop: Jet.ArithmeticOrBoundsFailure: `the list has 3 items, so position 7 doesn't exist`\n Why:" # `off`: the stop line, then straight to its Why
stderr: !~ "locals:" # no frame and no locals
