// A package whose types carry a Prelude marker, a marker of its own and a
// plugin package's marker. One program-store query answers all three.
use audit

Reviewed: struct {
    impl Marker {
        sites: [.Type],
    }
}

#[Audit.Audited, Reviewed]
Order: struct {
    id: Int,
}

#Comparable
OrderID: distinct Int

run: fn() {
    print("orders")
}
