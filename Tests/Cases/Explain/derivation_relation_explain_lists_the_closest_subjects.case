# A record subject the module does not hold is refused with the module's
# closest subjects, nearest first, so the next command is one copy away.
fixture: ExplainDeclaration.fixture
env: NO_COLOR=1
step: jet explain main.Shape.aera main.jet
exit: 1
stderr: ~ "`main.Shape.aera` names no recorded fact of module `main`" # the misspelled subject is refused
stderr: ~ "Explain one of: main.Shape.area, main.Shape" # the nearest subject first
