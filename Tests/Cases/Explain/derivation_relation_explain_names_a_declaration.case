# `jet explain` reads the one derivation relation. A declaration path names
# the record the checker made for that definition: the explanation prints its
# claim, the producer, rule and method that know it, its subject and the
# premises it was derived from.
fixture: ExplainDeclaration.fixture
env: NO_COLOR=1
step: jet explain main.Shape.area main.jet
exit: 0
stdout: ~ "main.Shape.area" # the declaration it explains
stdout: ~ "Known by jet-sema · checked-definition · static derivation" # how the relation knows it
stdout: ~ "Premises: " # what it was derived from
stdout: ~ "derivation relation" # where the explanation comes from
