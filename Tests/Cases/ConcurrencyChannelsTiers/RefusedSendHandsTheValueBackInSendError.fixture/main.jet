// A send the channel refuses fails with `SendError<T>`, whose `value` is the
// payload handed back unsent.

// A bare send propagates: `relay` infers the default Err, since a Core error
// family member like `SendError<String>` is no typed member of an inferred
// failure union, so the refused send reads "send on a closed channel".
relay: fn(tx: Sender<String>, text: ^^String) { tx.send(text) }

// Through the default Err, a refused send reads "send on a closed channel".
forward: fn(tx: Sender<String>, text: ^^String) Err! { tx.send(text) }

run: fn() {
    { sender: tx, receiver: rx }: channel<String>(capacity: 4)
    tx.send("first") ?? print("refused {err.value}")
    print(rx.receive() ?? "closed")
    rx.close()
    tx.send("second") ?? print("refused {err.value}")
    relay(tx, "third") ?? print("relay: {err}")
    forward(tx, "fourth") ?? print("forward: {err}")
}
