# D-ENV-SURFACE1=A: `jet env vars` redacts secret values (URL credentials, URL
# query tokens, and secret-named registered variables under `--all`) in both
# text and `--json` forms, and excludes unregistered variables.
env: NO_COLOR=1
env: JET_OPT_VERIFY=1
env: JET_KEEP_GOING_REPORT=https://user:s3cr3t@example.com/report.tsv?token=topsecret999&mode=full
env: JET_FUZZ_ITERATIONS=42
env: JET_INSPECT_TOKEN=super-secret-token-999
env: JET_REGISTRY_CUSTOM_URL=https://alice:hunter2@registry.example.test/idx?api_key=keysecret42
env: JET_UNREGISTERED_NOISE_XYZ=must-never-appear
step: jet env vars
exit: 0
stdout: = vars_listing_redacts_secrets.text.out
stdout: !~ "s3cr3t" # URL password never appears
stdout: !~ "topsecret999" # URL query token never appears
step: jet env vars --json
exit: 0
json: stdout doc $ valid # JSON output is valid
stdout: = vars_listing_redacts_secrets.json.out
stdout: !~ "s3cr3t" # URL password never appears in JSON
stdout: !~ "topsecret999" # URL query token never appears in JSON
step: jet env vars --all
exit: 0
stdout: ~ "JET_FUZZ_ITERATIONS" # set registered non-control var is listed
stdout: ~ "42" # non-secret effective value is shown
stdout: ~ "JET_INSPECT_TOKEN" # set secret registered var is listed
stdout: ~ "JET_REGISTRY_CUSTOM_URL" # wildcard-family registered var is listed
stdout: ~ "https://***@registry.example.test/idx?api_key=***" # URL credentials and query key are redacted
stdout: !~ "super-secret-token-999" # secret token value is redacted
stdout: !~ "hunter2" # URL password in registered var is redacted
stdout: !~ "keysecret42" # URL query key in registered var is redacted
stdout: !~ "JET_UNREGISTERED_NOISE_XYZ" # unregistered variables are excluded
stdout: !~ "must-never-appear" # unregistered variable values are excluded
step: jet env vars --all --json
exit: 0
json: stdout doc $ valid # JSON --all output is valid
json: stdout doc $.variables[?name="JET_FUZZ_ITERATIONS"][?value="42"][?source="environment"][?redacted=false] #>= 1 # non-secret registered variable entry
json: stdout doc $.variables[?name="JET_INSPECT_TOKEN"][?value="***"][?source="environment"][?redacted=true] #>= 1 # secret registered variable entry is redacted
json: stdout doc $.variables[?name="JET_REGISTRY_CUSTOM_URL"][?value="https://***@registry.example.test/idx?api_key=***"][?redacted=true] #>= 1 # wildcard registered URL is redacted
stdout: !~ "super-secret-token-999" # secret token never leaks in JSON
stdout: !~ "hunter2" # URL password never leaks in JSON
stdout: !~ "keysecret42" # URL query key never leaks in JSON
stdout: !~ "JET_UNREGISTERED_NOISE_XYZ" # unregistered variable never appears in JSON
