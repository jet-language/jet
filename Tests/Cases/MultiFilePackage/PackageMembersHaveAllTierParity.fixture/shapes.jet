Shape: struct {
    mass: Int,

    impl Weighted {
        weight: fn(self) -> Int { self.mass }
    }
}

Stage: enum {
    Ready(Int),
    _Waiting,
}

Weighted: trait {
    weight: fn(self) -> Int,
}

stage_weight: fn(stage: Stage) -> Int {
    if stage == {
        .Ready(value) -> value
        ._Waiting -> 0
    }
}
