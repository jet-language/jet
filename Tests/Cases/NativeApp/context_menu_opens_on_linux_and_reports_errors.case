# A Linux app's context menu opens where the person right-clicks: the
# board's panel has one (`app.context_menu`), and a fake compositor on
# $WAYLAND_DISPLAY right-clicks it and reads the next frame, which shows
# the menu over the screen. It clicks Add Task, which closes the menu and
# turns the panel green; then it opens the menu again and clicks Share,
# whose run fails: its notice joins the app's notices, which the window
# shows on a dark red bar at its bottom. Then it closes the window, which
# ends the app.
fixture: ContextMenuOpensOnLinuxAndReportsErrors.fixture
requires: os-name:linux
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: XDG_DATA_HOME={work}/data
env: XDG_CONFIG_HOME={work}/config
env: XDG_RUNTIME_DIR={work}/run
env: DBUS_SESSION_BUS_ADDRESS=unix:path={work}/no-bus.sock
mkdir: run
spawn compositor: jet run compositor/fake_compositor.jet
stdout: file compositor.stdout
stderr: file compositor.stderr
await: file compositor.ready timeout 120s every 10ms # the fake compositor listens
step: jet run main.jet
env: WAYLAND_DISPLAY={work}/wl.sock
exit: 0
stdout: empty
wait: compositor timeout 60s
exit: 0
file: compositor.stdout = "board: 200x100, panel [51, 102, 255, 255], menu spot [255, 255, 255, 255], corner [255, 255, 255, 255]\nright-clicked the panel\nmenu: spot [245, 245, 245, 255]\nclicked Add Task\nafter Add Task: panel [51, 153, 51, 255], menu spot [255, 255, 255, 255]\nright-clicked the panel\nmenu: spot [245, 245, 245, 255]\nclicked Share\nafter Share: panel [51, 153, 51, 255], corner [153, 27, 27, 255]\nclosed the window\n"
