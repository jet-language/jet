// The session bus for the app in ../main.jet, with the desktop's Secret
// Service (org.freedesktop.secrets) on it, unlocked, as libsecret finds it
// once the person has signed in to the desktop. It keeps one item in
// memory: the refresh token the app keeps for its server. It is its own
// package, so the app's package does not hold it. It listens at bus.sock
// in the directory it runs in, writes bus.ready once it listens, and
// answers each connection in turn: Hello, OpenSession,
// CreateItem, SearchItems, GetSecrets and Item.Delete, with no prompt.
// Each time the item changes it appends a line to kept.txt: what the item
// is kept as and whether its secret is new, or "deleted".
use {
    files: core.files
    net: core.net
    sys: core.sys
}

SESSION: "/org/freedesktop/secrets/session/1"

ITEM: "/org/freedesktop/secrets/collection/login/1"

// The kept item's secret, "" while there is none.
SECRET: Shared{""}

// Every secret the item has held.
SEEN: Shared{[String]{}}

run: fn() -[Env, FS, Net, Time]> {
    port: sys.get("CREW_PORT") ?? panic("CREW_PORT names the server's port")
    origin: "http://127.0.0.1:{port}"
    listener: net.unix_listen("bus.sock") ?? panic("listen on bus.sock: {err}")
    files.write("bus.ready", "") ?? panic("write bus.ready: {err}")
    loop {
        stream := net.unix_accept(listener) ?? panic("accept on bus.sock: {err}")
        answer_connection(stream, origin)
    }
}

// Answers the calls on `stream` until the app closes it. `origin` is the
// server whose session the app keeps.
answer_connection: fn(stream: &net.UnixStream, origin: String) -[FS, Net]> {
    said := [U8]{}
    authenticated := false
    serial := 0
    loop {
        got: net.unix_receive(stream, 4096) ?? return
        if got.bytes.len() == 0 {
            return
        }
        loop b in got.bytes -> said.push(b)
        if !authenticated {
            // The credentials byte and the AUTH line come first, then
            // BEGIN and the calls.
            line_end: crlf_at(said, 0)
            if line_end < 0 -> next
            net.unix_write_all_bytes(stream, "OK 0123456789abcdef0123456789abcdef\r\n".bytes()) ?? return
            said = said[line_end..<said.len()].copy()
            authenticated = true
        }
        if said.len() >= 7 && String.from_bytes_lossy(said[0..<7].copy()) == "BEGIN\r\n" {
            said = said[7..<said.len()].copy()
        }
        loop said.len() >= 16 && said.len() >= message_length(said) {
            n: message_length(said)
            message: said[0..<n].copy()
            member: member_of(message)
            said = said[n..<said.len()].copy()
            call: word(message, 8)
            serial += 1
            answer: if {
                member == "Hello" -> returned(serial, call, "s", text_value(":1.48"))
                member == "OpenSession" -> returned(serial, call, "vo", opened())
                member == "CreateItem" -> {
                    hold(texts_of(message[(16 + aligned(word(message, 12), 8))..<n].copy()), origin)
                    returned(serial, call, "oo", paths([String]{ITEM, "/"}))
                }
                member == "SearchItems" -> returned(serial, call, "aoao", searched(secret() != ""))
                member == "GetSecrets" -> returned(serial, call, "a{{o(oayays)}}", secrets(secret()))
                member == "Delete" -> {
                    set_secret("")
                    files.append_all("kept.txt", "deleted\n") ?? panic("write kept.txt: {err}")
                    returned(serial, call, "o", text_value("/"))
                }
                else -> returned(serial, call, "", [U8]{})
            }
            net.unix_write_all_bytes(stream, answer) ?? return
        }
    }
}

// Keeps the secret of the CreateItem call whose body has the texts
// `texts`: its label, its attributes' names and values, the session, the
// secret and its content type, in that order.
hold: fn(texts: [String], origin: String) -[FS]> {
    secret: texts[texts.len() - 2].copy()
    schema := "no schema"
    server := "another server"
    loop i in 0..<(texts.len() - 1) {
        if texts[i] == "xdg:schema" -> schema = texts[i + 1].copy()
        if texts[i] == "server" && texts[i + 1] == origin -> server = "the crew server"
    }
    held := SEEN.guard_edit()
    fresh: if held.value.contains(secret) -> "a token it held before" else -> "a new token"
    held.value.push(secret.copy())
    set_secret(secret)
    files.append_all("kept.txt", "kept {schema} for {server}: {fresh}\n") ?? panic("write kept.txt: {err}")
}

secret: fn() -> String {
    held: SECRET.guard_read()
    held.value.copy()
}

set_secret: fn(secret: String) {
    held := SECRET.guard_edit()
    held.value = secret
}

// OpenSession's answer: no output for a "plain" session, and its path.
opened: fn() -> [U8] {
    out := [U8]{U8{1}}
    append(out, "s".bytes())
    out.push(U8{0})
    put_text(out, "")
    put_text(out, SESSION)
    out
}

// SearchItems' answer: the kept item unlocked, if there is one, and no
// locked items.
searched: fn(found: Bool) -> [U8] {
    out := [U8]{}
    if found {
        item := [U8]{}
        put_text(item, ITEM)
        put_word(out, item.len())
        append(out, item)
    } else { put_word(out, 0) }
    put_word(out, 0)
    out
}

// GetSecrets' answer: the kept item's secret in the plain session. The
// entry starts at an 8-byte boundary of the body, so its own alignment is
// the body's.
secrets: fn(secret: String) -> [U8] {
    entry := [U8]{}
    put_text(entry, ITEM)
    pad(entry, 8)
    put_text(entry, SESSION)
    put_word(entry, 0)
    put_word(entry, secret.bytes().len())
    append(entry, secret.bytes())
    put_text(entry, "text/plain")
    out := [U8]{}
    put_word(out, entry.len())
    pad(out, 8)
    append(out, entry)
    out
}

// Object paths in a row, as a body of `o`s.
paths: fn(texts: [String]) -> [U8] {
    out := [U8]{}
    loop text in texts -> put_text(out, text)
    out
}

// A method return for the call `call`, with a body of `signature`.
returned: fn(serial: Int, call: Int, signature: String, body: [U8]) -> [U8] {
    fields := [U8]{}
    number_field(fields, 5, call)
    text_field(fields, 7, 115, "org.freedesktop.DBus")
    if signature != "" -> signature_field(fields, signature)
    framed(2, serial, fields, body)
}

// A whole message: the fixed header, the header fields padded to 8 bytes,
// and the body.
framed: fn(kind: Int, serial: Int, fields: [U8], body: [U8]) -> [U8] {
    out := [U8]{U8{108}, U8{kind}, U8{1}, U8{1}}
    put_word(out, body.len())
    put_word(out, serial)
    put_word(out, fields.len())
    append(out, fields)
    pad(out, 8)
    append(out, body)
    out
}

// A header field holding a string (type `kind` 115) or an object path (111).
text_field: fn(out: &[U8], code: Int, kind: Int, text: String) {
    pad(out, 8)
    append(out, [U8]{U8{code}, U8{1}, U8{kind}, U8{0}})
    put_text(out, text)
}

number_field: fn(out: &[U8], code: Int, n: Int) {
    pad(out, 8)
    append(out, [U8]{U8{code}, U8{1}, U8{117}, U8{0}})
    put_word(out, n)
}

signature_field: fn(out: &[U8], signature: String) {
    pad(out, 8)
    append(out, [U8]{U8{8}, U8{1}, U8{103}, U8{0}})
    out.push(U8{signature.bytes().len()})
    append(out, signature.bytes())
    out.push(U8{0})
}

// A body of one string or object path.
text_value: fn(text: String) -> [U8] {
    out := [U8]{}
    put_text(out, text)
    out
}

// A string at a 4-byte boundary: its length, its bytes and a NUL.
put_text: fn(out: &[U8], text: String) {
    pad(out, 4)
    put_word(out, text.bytes().len())
    append(out, text.bytes())
    out.push(U8{0})
}

// A little-endian 32-bit word at a 4-byte boundary.
put_word: fn(out: &[U8], n: Int) {
    pad(out, 4)
    loop shift in ([Int]{0, 8, 16, 24}) -> out.push(U8{(n >> shift) & 255})
}

pad: fn(out: &[U8], to: Int) {
    loop out.len() % to != 0 -> out.push(U8{0})
}

append: fn(out: &[U8], bytes: [U8]) {
    loop b in bytes -> out.push(b)
}

// The runs of two or more printable ASCII bytes in `body`: the texts of a
// message body whose numbers are not printable.
texts_of: fn(body: [U8]) -> [String] {
    found := [String]{}
    run := [U8]{}
    loop b in body {
        n: Int{b}
        if n >= 32 && n < 127 {
            run.push(b)
            next
        }
        if run.len() >= 2 -> found.push(String.from_bytes_lossy(run.copy()))
        run = [U8]{}
    }
    if run.len() >= 2 -> found.push(String.from_bytes_lossy(run.copy()))
    found
}

// Where the CR LF that ends the first line of `bytes` after `from` ends, or
// -1.
crlf_at: fn(bytes: [U8], from: Int) -> Int {
    loop i in from..<(bytes.len() - 1) {
        if (Int{bytes[i]}) == 13 && (Int{bytes[i + 1]}) == 10 -> return i + 2
    }
    -1
}

// The length of the message `m` starts with: its fixed header, its header
// fields padded to 8 bytes, and its body.
message_length: fn(m: [U8]) -> Int { 16 + aligned(word(m, 12), 8) + word(m, 4) }

// The member the header of the message `m` names (field 3), or "".
member_of: fn(m: [U8]) -> String {
    end: 16 + word(m, 12)
    at := 16
    loop at < end {
        code: Int{m[at]}
        kind: Int{m[at + 2]}
        at += 4
        if kind == 103 {
            // A signature: a length byte, the text and a NUL.
            at += Int{m[at]} + 2
        } else if kind == 117 { at = aligned(at, 4) + 4 } else {
            // A string or an object path: a length word, the text and a NUL.
            at = aligned(at, 4)
            n: word(m, at)
            if code == 3 -> return String.from_bytes_lossy(m[(at + 4)..<(at + 4 + n)].copy())
            at += 4 + n + 1
        }
        at = aligned(at, 8)
    }
    ""
}

aligned: fn(at: Int, to: Int) -> Int { (at + to - 1) /% to * to }

// The little-endian 32-bit word at `at` of `bytes`.
word: fn(bytes: [U8], at: Int) -> Int {
    Int{bytes[at]} + (Int{bytes[at + 1]}) * 256 + (Int{bytes[at + 2]}) * 65536 + (Int{bytes[at + 3]}) * 16777216
}
