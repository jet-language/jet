# An app asks the person for a device permission with `app.ask`, and the
# system shows the package's `purposes:` line for it when it asks. `jet
# check` refuses an `ask` whose permission has no purpose
# (E-APP-PERMISSION-PURPOSE) at the argument: a literal permission needs
# its own line, and one chosen at run time needs a line for every
# permission. The location, which has its purpose, checks. The web output
# checks the same purposes.
fixture: PermissionWithoutAPurposeFailsTheBuild.fixture
env: NO_COLOR=1
step: jet check main.jet
exit: nonzero
stderr: ~ "`app.ask` may ask for the `camera` permission, but the package's `purposes:` doesn't say why." # the photo
stderr: ~ "main.jet:8:69" # on the case it names
stderr: ~ "`app.ask` may ask for the `camera` and `notifications` permissions" # the run-time choice
stderr: ~ "main.jet:11:80" # on the run-time permission
stderr: !~ "`location`" # the tag checks
stderr: ~ "2 problems found" # the photo and the run-time choice, nothing else
step: jet build --target web main.jet
exit: nonzero
stderr: ~ "`app.ask` may ask for the `camera` permission, but the package's `purposes:` doesn't say why." # the web output needs the same purposes
stderr: ~ "main.jet:8:69" # on the case it names
stderr: ~ "`app.ask` may ask for the `camera` and `notifications` permissions" # the run-time choice
