// Crewboard's desktop import (Desktop and Logic are copies of
// Examples/Apps/Crewboard's): Ann picks a CSV file of tasks in the system's
// open dialog. The picked file is a name, a size and a media type, never a
// path, and its bytes read the same whole, as text and a part at a time.
// Crewboard's import then adds each of its rows to her project as a task.
// When no file could be opened, the app's notice says why.
use {
    app
    auth: core.auth
    desktop
    logic
}

run: fn() -[DB.Read, Env, FS.Read, IO, Net, Time]> {
    _: app.new("Crewboard").api<logic.Crew>("/api").mount(logic.demo_crew())
    crew: app.remote(logic.demo_crew())
    picked: app.open_file(types: [app.FileType]{app.FileType.CSV})
    if picked == .Val(file) {
        show(file.copy())
        print(imported(crew, file))
        return
    }
    print("picked: none")
    loop notice in app.notices() -> print("notice: {notice.text}")
}

show: fn(file: app.PickedFile) -[FS.Read, IO, Time]> {
    print("picked: {file.name}, {file.bytes} bytes, {media_name(file.media)}")
    whole: file.read() ?? return print("unreadable: {err}")
    text: file.text() ?? return print("not text: {err}")
    parts: streamed(file) ?? return print("unstreamable: {err}")
    print("whole, text and stream agree: {whole == text.bytes() && whole == parts && whole.len() == file.bytes}")
}

// What the first bytes of the file show it holds.
media_name: fn(media: app.Media?) -> String {
    kind: media ?? return "no known media"
    if kind == {
        .Text -> "text"
        .Image -> "an image"
        .PDF -> "a PDF"
    }
}

// The file's bytes read through its stream, a few at a time, each part
// appended to one buffer.
streamed: fn(file: app.PickedFile) -[FS.Read, Time.Wait]> [U8] IOError! {
    ^stream: file.stream() ?? return Err(err)
    ^out: [U8]{}
    loop {
        count: stream.read_into(out, 7) ?? return Err(err)
        if count == 0 -> break
    }
    Ok(out)
}

// Ann imports the file into Spring fair, then her projects count its tasks.
imported: fn(crew: app.Remote<logic.Crew>, file: app.PickedFile) -[DB.Read, FS.Read, Net, Time]> String Never! {
    app.as_caller(
        auth.AccountID.from_string("ann"),
        fn() {
            added: if desktop.import_file(crew.copy(), "p2", file) == {
                .Ok(count) -> "imported {count} tasks"
                .Err(failure) -> "import: {desktop.import_notice(failure).text}"
            }
            if crew.my_projects() == {
                .Ok(cards) -> {
                    ^lines: [String]{added}
                    loop card in cards -> lines.push("{card.name}: {card.open_tasks} open")
                    lines.join("\n")
                }
                .Err(_) -> "{added}\nno projects"
            }
        },
    )
}
