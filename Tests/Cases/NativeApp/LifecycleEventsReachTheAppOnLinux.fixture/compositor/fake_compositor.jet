// The Wayland compositor for the app in ../main.jet. It is its own package,
// so the app's package does not hold it. It listens at wl.sock in the
// directory it runs in and writes compositor.ready once it listens. It
// offers a compositor, shared memory, xdg-shell and a seat with a pointer
// and a keyboard; configures the window at 200x100; and reads the pixels of
// each frame the window commits. On the first frame it gives the window
// the keyboard focus, takes it away and gives it back; once the panel
// turns it writes sleep.go, for logind to put the machine to sleep and
// wake it; once the notice bar shows over the top it clicks the bar, and
// once the bar is gone it closes the window. Once the app has hung up it
// prints what it saw, a line each.
use {
    files: core.files
    net: core.net
    sys: core.sys
}

// Where the fake looks at a frame, in window pixels at scale 1: the panel,
// under where the notice bar shows, and the top left corner, where the bar
// shows and its text does not.
PANEL_X: 100

PANEL_Y: 27

TOP_X: 2

TOP_Y: 2

// Where the fake clicks to dismiss the notice: on the bar.
BAR_X: 100

BAR_Y: 10

// The frames a step may take before what it waits for shows.
FRAMES_PER_STEP: 6

// Linux's code for the primary pointer button.
BUTTON_LEFT: 272

// wl_shm's codes for ARGB8888 and XRGB8888, the formats every compositor
// offers: little-endian words, so blue, green, red, then alpha or X in
// memory.
FORMAT_ARGB8888: 0

FORMAT_XRGB8888: 1

// The color of the notice bar, and the panel's after one resume and after
// two.
BAR: [U8]{U8{153}, U8{27}, U8{27}, U8{255}}

YELLOW: [U8]{U8{230}, U8{180}, U8{30}, U8{255}}

GREEN: [U8]{U8{51}, U8{153}, U8{51}, U8{255}}

// A wl_buffer: its pool (an index into `fds`), offset, size and wl_shm
// format.
FakeBuffer: struct {
    id: Int,
    pool: Int,
    offset: Int,
    width: Int,
    height: Int,
    format: Int,
}

Fake: struct {
    stream: net.UnixStream,
    inbox: [U8],
    out: [U8],
    registry: Int,
    compositor: Int,
    shm: Int,
    wm_base: Int,
    seat: Int,
    pointer: Int,
    keyboard: Int,
    surface: Int,
    xdg_surface: Int,
    toplevel: Int,
    // Each pool's object id, and the descriptor the window sent with it.
    pools: [Int],
    fds: [sys.Fd],
    buffers: [FakeBuffer],
    attached: Int,
    current: Int,
    callbacks: [Int],
    serial: Int,
    configured: Bool,
    board: [U8],
    // Whether the pointer is on the window's surface.
    entered: Bool,
    // 0 until the board shows; 1 until the panel turns after the focus
    // came back; 2 until the notice bar shows after the machine woke; 3
    // until the bar goes; 4 after the close.
    phase: Int,
    // The frames since the phase began.
    waited: Int,
    commits: Int,
    records: [String],
    failures: [String],
}

GLOBALS: [String]{"wl_compositor", "wl_shm", "xdg_wm_base", "wl_seat"}

fake_put: fn(out: &[U8], value: Int) {
    v: value & 4294967295
    out.push(U8{v & 255})
    out.push(U8{(v >> 8) & 255})
    out.push(U8{(v >> 16) & 255})
    out.push(U8{(v >> 24) & 255})
}

fake_words: fn(values: [Int]) -> [U8] {
    out := [U8]{}
    loop value in values -> fake_put(out, value)
    out
}

fake_u32: fn(bytes: [U8], at: Int) -> Int {
    if at + 4 > bytes.len() -> return 0
    Int{bytes[at]} + (Int{bytes[at + 1]} << 8) + (Int{bytes[at + 2]} << 16) + (Int{bytes[at + 3]} << 24)
}

fake_text: fn(text: String) -> [U8] {
    out := [U8]{}
    bytes: text.bytes()
    fake_put(out, bytes.len() + 1)
    loop b in bytes -> out.push(b)
    out.push(U8{0})
    loop out.len() %% 4 != 0 -> out.push(U8{0})
    out
}

fake_string: fn(bytes: [U8], at: Int) -> String {
    length: fake_u32(bytes, at)
    if length <= 1 || at + 4 + length > bytes.len() -> return ""
    String.from_bytes(bytes[(at + 4)..<(at + 3 + length)]) ?? ""
}

fake_event: fn(f: &Fake, object: Int, opcode: Int, args: [U8]) {
    fake_put(f.out, object)
    fake_put(f.out, ((args.len() + 8) << 16) + opcode)
    loop b in args -> f.out.push(b)
}

fake_flush: fn(f: &Fake) -[Net, Time]> {
    if f.out.len() == 0 {
        return
    }
    out: f.out.copy()
    f.out = [U8]{}
    net.unix_send(f.stream, out, [sys.Fd]{}) ?? {
        if f.phase < 4 -> f.failures.push("send failed: {err}")
        return
    }
}

fake_fail: fn(f: &Fake, message: String) {
    if f.failures.len() < 8 -> f.failures.push("phase {f.phase}: {message}")
}

fake_buffer: fn(f: Fake, id: Int) -> FakeBuffer? {
    loop buffer in f.buffers {
        if buffer.id == id -> return Val(buffer.copy())
    }
    None
}

fake_pool: fn(f: Fake, object: Int) -> Int {
    loop index in 0..<f.pools.len() {
        if f.pools[index] == object -> return index
    }
    -1
}

// The pixel (x, y) of `buffer` as red, green, blue and alpha, decoded by
// the format the window gave the buffer.
fake_pixel: fn(f: &Fake, buffer: FakeBuffer, x: Int, y: Int) -> [U8] {
    if buffer.pool >= f.fds.len() || x >= buffer.width || y >= buffer.height {
        fake_fail(f, "pixel {x},{y} is outside buffer {buffer.id}")
        return [U8]{}
    }
    if buffer.format != FORMAT_ARGB8888 && buffer.format != FORMAT_XRGB8888 {
        fake_fail(f, "buffer {buffer.id} has format {buffer.format}, which the fake never offered")
        return [U8]{}
    }
    at: Int(0..9223372036854775807).from_int(buffer.offset + (y * buffer.width + x) * 4) ?? {
        fake_fail(f, "pixel {x},{y} lies before the start of its pool")
        return [U8]{}
    }
    stored: f.fds[buffer.pool].read_at(at, 4) ?? {
        fake_fail(f, "reading a pool failed: {err}")
        return [U8]{}
    }
    [U8]{stored[2], stored[1], stored[0], stored[3]}
}

// The pointer comes to (x, y) of the window's surface, in logical units,
// entering it the first time, and the primary button presses and releases
// there.
fake_click: fn(f: &Fake, x: Int, y: Int) {
    pointer: f.pointer
    surface: f.surface
    f.serial += 1
    if f.entered -> fake_event(f, pointer, 2, fake_words([Int]{1000 + f.serial, x * 256, y * 256})) else {
        fake_event(f, pointer, 0, fake_words([Int]{f.serial, surface, x * 256, y * 256}))
        f.entered = true
    }
    f.serial += 1
    fake_event(f, pointer, 3, fake_words([Int]{f.serial, 1000 + f.serial, BUTTON_LEFT, 1}))
    f.serial += 1
    fake_event(f, pointer, 3, fake_words([Int]{f.serial, 1000 + f.serial, BUTTON_LEFT, 0}))
}

// Whether a phase that waits for what a frame shows has waited too long;
// if it has, the window closes.
fake_waited_out: fn(f: &Fake, what: String) -> Bool {
    f.waited += 1
    if f.waited < FRAMES_PER_STEP -> return false
    fake_fail(f, "the window never showed {what}")
    fake_close(f)
    true
}

fake_close: fn(f: &Fake) {
    toplevel: f.toplevel
    fake_event(f, toplevel, 1, [U8]{})
    f.records.push("closed the window")
    f.phase = 4
}

// A commit of the window's surface: its frame callbacks are done, and a
// new buffer is a frame to look at.
fake_commit: fn(f: &Fake) -[Env, FS]> {
    f.commits += 1
    callbacks: f.callbacks.copy()
    f.callbacks = [Int]{}
    loop id in callbacks -> fake_event(f, id, 0, fake_words([Int]{f.commits}))
    if f.attached == 0 {
        return
    }
    previous: f.current
    f.current = f.attached
    f.attached = 0
    if previous != 0 && previous != f.current -> fake_event(f, previous, 0, [U8]{})
    buffer: fake_buffer(f, f.current) ?? {
        fake_fail(f, "committed buffer {f.current}, which no pool made")
        return
    }
    panel: fake_pixel(f, buffer, PANEL_X, PANEL_Y)
    top: fake_pixel(f, buffer, TOP_X, TOP_Y)
    if f.phase == 0 {
        f.board = panel.copy()
        f.records.push("board: {buffer.width}x{buffer.height}, panel {panel}")
        if f.pointer == 0 || f.keyboard == 0 {
            fake_fail(f, "the window took no pointer or keyboard")
            fake_close(f)
            return
        }
        // The keyboard focus comes, goes to another window, and comes back.
        keyboard: f.keyboard
        surface: f.surface
        f.serial += 1
        fake_event(f, keyboard, 1, fake_words([Int]{f.serial, surface, 0}))
        f.serial += 1
        fake_event(f, keyboard, 2, fake_words([Int]{f.serial, surface}))
        f.serial += 1
        fake_event(f, keyboard, 1, fake_words([Int]{f.serial, surface, 0}))
        f.records.push("took the focus away and gave it back")
        f.phase = 1
        f.waited = 0
        return
    }
    if f.phase == 1 {
        if panel != YELLOW {
            _: fake_waited_out(f, "the first resume")
            return
        }
        f.records.push("after the focus came back: panel {panel}")
        files.write("sleep.go", "") ?? {
            fake_fail(f, "writing sleep.go failed: {err}")
            fake_close(f)
            return
        }
        f.records.push("wrote sleep.go")
        f.phase = 2
        f.waited = 0
        return
    }
    if f.phase == 2 {
        if panel != GREEN || top != BAR {
            _: fake_waited_out(f, "the notice of the second resume")
            return
        }
        f.records.push("after waking: panel {panel}, top {top}")
        fake_click(f, BAR_X, BAR_Y)
        f.records.push("clicked the notice")
        f.phase = 3
        f.waited = 0
        return
    }
    if f.phase != 3 {
        return
    }
    if top == BAR {
        _: fake_waited_out(f, "the notice dismissed")
        return
    }
    f.records.push("after the click: top {top}")
    fake_close(f)
}

fake_request: fn(f: &Fake, object: Int, opcode: Int, body: [U8]) -[Env, FS, Net, Time]> {
    if object == 1 && opcode == 1 {
        f.registry = fake_u32(body, 0)
        registry: f.registry
        loop (index, interface) in GLOBALS {
            args := fake_words([Int]{index + 1})
            loop b in fake_text(interface) -> args.push(b)
            version: if interface == "wl_compositor" -> 6 else if interface == "wl_seat" -> 5 else if interface == "xdg_wm_base" -> 2 else -> 1
            fake_put(args, version)
            fake_event(f, registry, 0, args)
        }
        return
    }
    if object == 1 && opcode == 0 {
        fake_event(f, fake_u32(body, 0), 0, fake_words([Int]{0}))
        return
    }
    if object == f.registry && opcode == 0 {
        name: fake_u32(body, 0)
        interface: fake_string(body, 4)
        length: fake_u32(body, 4)
        id: fake_u32(body, 8 + ((length + 3) /% 4) * 4 + 4)
        if name < 1 || name > GLOBALS.len() || GLOBALS[name - 1] != interface {
            fake_fail(f, "bound global {name} as {interface}")
        }
        if interface == "wl_compositor" -> f.compositor = id
        if interface == "wl_shm" {
            f.shm = id
            // wl_shm.format: ARGB8888 and XRGB8888, as every compositor.
            fake_event(f, id, 0, fake_words([Int]{FORMAT_ARGB8888}))
            fake_event(f, id, 0, fake_words([Int]{FORMAT_XRGB8888}))
        }
        if interface == "xdg_wm_base" -> f.wm_base = id
        if interface == "wl_seat" {
            f.seat = id
            // capabilities: a pointer and a keyboard.
            fake_event(f, id, 0, fake_words([Int]{3}))
        }
        return
    }
    if object == f.compositor && opcode == 0 {
        if f.surface == 0 -> f.surface = fake_u32(body, 0)
        return
    }
    if object == f.shm && opcode == 0 {
        f.pools.push(fake_u32(body, 0))
        return
    }
    pool: fake_pool(f, object)
    if pool >= 0 {
        if opcode == 0 {
            f.buffers.push(FakeBuffer{id: fake_u32(body, 0), pool: pool, offset: fake_u32(body, 4), width: fake_u32(body, 8), height: fake_u32(body, 12), format: fake_u32(body, 20)})
        }
        return
    }
    if object == f.wm_base && opcode == 2 {
        f.xdg_surface = fake_u32(body, 0)
        return
    }
    if object == f.xdg_surface && opcode == 1 {
        f.toplevel = fake_u32(body, 0)
        return
    }
    if f.seat != 0 && object == f.seat {
        if opcode == 0 -> f.pointer = fake_u32(body, 0)
        if opcode == 1 -> f.keyboard = fake_u32(body, 0)
        return
    }
    if object == f.surface {
        if opcode == 1 -> f.attached = fake_u32(body, 0)
        if opcode == 3 -> f.callbacks.push(fake_u32(body, 0))
        if opcode == 6 {
            if !f.configured {
                // The initial commit: the first configure, activated.
                f.configured = true
                f.serial += 1
                toplevel: f.toplevel
                xdg_surface: f.xdg_surface
                fake_event(f, toplevel, 0, fake_words([Int]{200, 100, 4, 4}))
                fake_event(f, xdg_surface, 0, fake_words([Int]{f.serial}))
                return
            }
            fake_commit(f)
        }
    }
}

fake_dispatch: fn(f: &Fake) -[Env, FS, Net, Time]> {
    at := 0
    loop f.inbox.len() - at >= 8 {
        object: fake_u32(f.inbox, at)
        word: fake_u32(f.inbox, at + 4)
        size: word >> 16
        if size < 8 {
            fake_fail(f, "malformed request header")
            f.inbox = [U8]{}
            return
        }
        if f.inbox.len() - at < size -> break
        body: f.inbox[(at + 8)..<(at + size)].copy()
        fake_request(f, object, word & 65535, body)
        at += size
    }
    if at > 0 -> f.inbox = f.inbox[at..<f.inbox.len()].copy()
}

// Accepts the one window and serves it until the app hangs up, or for a
// minute.
fake_serve: fn(listener: net.UnixListener) -[Env, FS, Net, Time]> Fake {
    stream: net.unix_accept(listener) ?? panic("accept on wl.sock: {err}")
    f := Fake{
        stream: stream,
        inbox: [U8]{},
        out: [U8]{},
        registry: 0,
        compositor: 0,
        shm: 0,
        wm_base: 0,
        seat: 0,
        pointer: 0,
        keyboard: 0,
        surface: 0,
        xdg_surface: 0,
        toplevel: 0,
        pools: [Int]{},
        fds: [sys.Fd]{},
        buffers: [FakeBuffer]{},
        attached: 0,
        current: 0,
        callbacks: [Int]{},
        serial: 0,
        configured: false,
        board: [U8]{},
        entered: false,
        phase: 0,
        waited: 0,
        commits: 0,
        records: [String]{},
        failures: [String]{},
    }
    idle := 0
    loop idle < 1200 {
        ready: net.unix_wait(f.stream, 50000000) ?? {
            f.failures.push("wait failed: {err}")
            return f
        }
        if !ready {
            idle += 1
            next
        }
        idle = 0
        message: net.unix_receive(f.stream, 65536) ?? {
            if f.phase < 4 -> f.failures.push("receive failed: {err}")
            return f
        }
        if message.bytes.len() == 0 -> return f
        loop fd in message.fds.move() -> f.fds.push(fd)
        loop b in message.bytes -> f.inbox.push(b)
        fake_dispatch(f)
        fake_flush(f)
    }
    f.failures.push("the window went quiet")
    f
}

run: fn() -[Env, FS, IO, Net, Time]> {
    listener: net.unix_listen("wl.sock") ?? panic("listen on wl.sock: {err}")
    files.write("compositor.ready", "") ?? panic("write compositor.ready: {err}")
    f: fake_serve(listener)
    if f.phase != 4 -> print("FAIL the compositor stopped in phase {f.phase}")
    loop record in f.records -> print(record)
    loop failure in f.failures -> print("FAIL {failure}")
}
