// Notes in a Linux window: a text input whose change handler (`on_change:`)
// keeps the note it shows and prints each text it gets, and a panel whose
// color shows how long the note is: blue when empty, yellow at one
// character and green at two. The person focuses the input with Tab,
// types "hi" and then Backspace. Then the window closes, which ends the
// app.
use {
    app
    ui: core.ui
    time: core.time
    core.color.[Color]
    core.ui.[UINode]
}

#Error
NoteError: enum {
    Offline,
}

Note: struct {
    text: String,
}

NOTE: Shared{Note{text: ""}}

note_text: fn() -[DB.Read]> String NoteError! {
    held: NOTE.guard_read()
    Ok(held.value.text.copy())
}

// The input's change handler: the note becomes what the input holds.
note_changed: fn(text: String) {
    print("changed: {text}")
    held := NOTE.guard_edit()
    held.value.text = text.copy()
    app.invalidate(note_text)
}

NoteView: struct {}

notes: fn(_view: NoteView) -> UINode Never! {
    text: if app.state(app.live(note_text)) == {
        .Loaded(text) -> text
        .Failed(_) | .Idle | .Loading -> ""
    }
    length: text.chars().len()
    color: if {
        length == 0 -> Color{r: 51, g: 102, b: 255, a: 255}
        length == 1 -> Color{r: 204, g: 153, b: 0, a: 255}
        else -> Color{r: 51, g: 153, b: 51, a: 255}
    }
    ui.box(
        [
            ui.node_color("", 200.0, 30.0, color),
            ui.text_input(text, UIIMEMode.Native, on_change: fn(typed: String) { note_changed(typed) }),
        ],
    )
}

run: fn() {
    graph: app.new("Notes").screen("/", notes).window(width: 200, height: 200)
    if !graph.launch() {
        return
    }
    // Closing the window ends the app; it waits up to a minute for that.
    loop _ in 0..<6000 -> time.sleep(10ms)
    print("the window stayed open")
}
