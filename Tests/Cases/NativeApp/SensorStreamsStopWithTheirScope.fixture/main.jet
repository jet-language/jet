// A field app follows the crew as they move and turns its map with the
// device. Each stream stops when the loop reading it ends.
use app

said: fn(held: app.Orientation) -> String {
    if held == {
        .Upright -> "upright"
        .UpsideDown -> "upside down"
        .LeftUp -> "left side up"
        .RightUp -> "right side up"
    }
}

run: fn() -[Env, IO, Net, Time]> {
    seen := 0
    loop place in app.location_updates() {
        print("place: {place.latitude} {place.longitude} within {place.accuracy_m} m")
        seen += 1
        if seen == 2 -> break
    }
    turns := 0
    loop held in app.orientation_updates() {
        print("held: {said(held)}")
        turns += 1
        if turns == 2 -> break
    }
    loop heading in app.heading_updates() {
        print("heading: {heading}")
        if heading > 100.0 -> break
    }
    print("stopped, asked: {app.ask(.Location) == .Granted}")
}
