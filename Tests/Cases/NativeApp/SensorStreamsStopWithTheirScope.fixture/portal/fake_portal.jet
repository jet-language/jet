// The session and system buses for the app in ../main.jet, with the desktop
// portal and the sensor proxy on them. It is its own package, so the app's
// package does not hold it. It listens at bus.sock in the directory it runs
// in and writes bus.ready once it listens. It takes one connection at a
// time, in order: the location session, then the accelerometer, then the
// compass. After each call the app makes it answers with that call's part
// of the conversation, and it takes the next connection only once the app
// has closed this one. For each connection the app closed it writes a line
// to heard.txt: the members the app called, in order.
use {
    files: core.files
    net: core.net
}

// The answer to each call of the location session: Hello, two AddMatch (the
// request's Response and the sessions' LocationUpdated), CreateSession (the
// session …/session/1_48/jet4), and Start (the request …/request/1_48/jet5),
// which comes with that request's Response signal with code 0 and four
// LocationUpdated signals: 52.52, 13.405 within 20.0 m; another session's;
// 52.5201, 13.4051 within 10.0 m; and 52.53, 13.41 within 5.0 m, which the
// app stops before. Last, Session.Close.
LOCATION: [String]{
    "6c0200010a000000010000002f000000050175000100000007017300140000006f72672e667265656465736b746f702e44427573000000000801670001730000050000003a312e343800",
    "6c020001000000000200000025000000050175000200000007017300140000006f72672e667265656465736b746f702e4442757300000000",
    "6c020001000000000300000025000000050175000300000007017300140000006f72672e667265656465736b746f702e4442757300000000",
    "6c02000136000000040000002f000000050175000400000007017300140000006f72672e667265656465736b746f702e444275730000000008016700016f0000310000002f6f72672f667265656465736b746f702f706f7274616c2f6465736b746f702f73657373696f6e2f315f34382f6a65743400",
    "",
    "6c020001000000000b00000025000000050175000600000007017300140000006f72672e667265656465736b746f702e4442757300000000",
}

// The answer to each call for the accelerometer: Hello, Properties.Get
// HasAccelerometer (true), AddMatch (the proxy's PropertiesChanged),
// ClaimAccelerometer, and Properties.Get AccelerometerOrientation
// ("normal"), which comes with a PropertiesChanged of LightLevel only and
// one of AccelerometerOrientation to "left-up". Last,
// ReleaseAccelerometer.
ACCELEROMETER: [String]{
    "6c0200010a000000010000002f000000050175000100000007017300140000006f72672e667265656465736b746f702e44427573000000000801670001730000050000003a312e343900",
    "6c02000108000000020000002f000000050175000200000007017300140000006f72672e667265656465736b746f702e444275730000000008016700017600000162000001000000",
    "6c020001000000000300000025000000050175000300000007017300140000006f72672e667265656465736b746f702e4442757300000000",
    "6c020001000000000400000025000000050175000400000007017300140000006f72672e667265656465736b746f702e4442757300000000",
    "",
    "6c020001000000000800000025000000050175000600000007017300140000006f72672e667265656465736b746f702e4442757300000000",
}

// The answer to each call for the compass, as for the accelerometer: the
// heading is 90.0, and its PropertiesChanged signal sets it to 180.5.
COMPASS: [String]{
    "6c0200010a000000010000002f000000050175000100000007017300140000006f72672e667265656465736b746f702e44427573000000000801670001730000050000003a312e343900",
    "6c02000108000000020000002f000000050175000200000007017300140000006f72672e667265656465736b746f702e444275730000000008016700017600000162000001000000",
    "6c020001000000000300000025000000050175000300000007017300140000006f72672e667265656465736b746f702e4442757300000000",
    "6c020001000000000400000025000000050175000400000007017300140000006f72672e667265656465736b746f702e4442757300000000",
    "",
    "6c020001000000000800000025000000050175000600000007017300140000006f72672e667265656465736b746f702e4442757300000000",
}

run: fn() -[FS, Net, Time]> {
    listener: net.unix_listen("bus.sock") ?? panic("listen on bus.sock: {err}")
    files.write("bus.ready", "") ?? panic("write bus.ready: {err}")
    heard := ""
    loop conversation in ([[String]]{LOCATION, ACCELEROMETER, COMPASS}) {
        stream := net.unix_accept(listener) ?? panic("accept on bus.sock: {err}")
        members := [String]{}
        said := [U8]{}
        authenticated := false
        loop {
            got: net.unix_receive(stream, 4096) ?? break
            if got.bytes.len() == 0 -> break
            loop b in got.bytes -> said.push(b)
            if !authenticated {
                // The credentials byte and the AUTH line come first, then
                // BEGIN and the calls.
                line_end: crlf_at(said, 0)
                if line_end < 0 -> next
                net.unix_write_all_bytes(stream, "OK 0123456789abcdef0123456789abcdef\r\n".bytes()) ?? panic("answer AUTH: {err}")
                said = said[line_end..<said.len()].copy()
                authenticated = true
            }
            if said.len() >= 7 && String.from_bytes_lossy(said[0..<7].copy()) == "BEGIN\r\n" {
                said = said[7..<said.len()].copy()
            }
            loop said.len() >= 16 && said.len() >= message_length(said) {
                n: message_length(said)
                members.push(member_of(said[0..<n].copy()))
                said = said[n..<said.len()].copy()
                at: members.len() - 1
                if at < conversation.len() {
                    net.unix_write_all_bytes(stream, bytes_of(conversation[at])) ?? panic("answer the app: {err}")
                }
            }
        }
        heard = "{heard}{members.join(" ")}\n"
    }
    files.write("heard.txt", heard) ?? panic("write heard.txt: {err}")
}

// Where the CR LF that ends the first line of `bytes` after `from` ends, or
// -1.
crlf_at: fn(bytes: [U8], from: Int) -> Int {
    loop i in from..<(bytes.len() - 1) {
        if (Int{bytes[i]}) == 13 && (Int{bytes[i + 1]}) == 10 -> return i + 2
    }
    -1
}

// The length of the message `m` starts with: its fixed header, its header
// fields padded to 8 bytes, and its body.
message_length: fn(m: [U8]) -> Int { 16 + aligned(word(m, 12), 8) + word(m, 4) }

// The member the header of the message `m` names (field 3), or "".
member_of: fn(m: [U8]) -> String {
    end: 16 + word(m, 12)
    at := 16
    loop at < end {
        code: Int{m[at]}
        kind: Int{m[at + 2]}
        at += 4
        if kind == 103 {
            // A signature: a length byte, the text and a NUL.
            at += Int{m[at]} + 2
        } else if kind == 117 { at = aligned(at, 4) + 4 } else {
            // A string or an object path: a length word, the text and a NUL.
            at = aligned(at, 4)
            n: word(m, at)
            if code == 3 -> return String.from_bytes_lossy(m[(at + 4)..<(at + 4 + n)].copy())
            at += 4 + n + 1
        }
        at = aligned(at, 8)
    }
    ""
}

aligned: fn(at: Int, to: Int) -> Int { (at + to - 1) /% to * to }

// The little-endian 32-bit word at `at` of `bytes`.
word: fn(bytes: [U8], at: Int) -> Int {
    Int{bytes[at]} + (Int{bytes[at + 1]}) * 256 + (Int{bytes[at + 2]}) * 65536 + (Int{bytes[at + 3]}) * 16777216
}

// The bytes the lowercase hex text `hex` spells.
bytes_of: fn(hex: String) -> [U8] {
    digits: hex.bytes()
    out := [U8]{}
    loop i in 0..<(digits.len() /% 2) {
        out.push(U8{nibble(Int{digits[2 * i]}) * 16 + nibble(Int{digits[2 * i + 1]})})
    }
    out
}

nibble: fn(b: Int) -> Int { if b >= 97 -> b - 87 else -> b - 48 }
