# `app.open_file(types:)` asks the person for a file and gives it as a
# PickedFile: a name, a size in bytes and a media type, never a path, with
# `read`, `text` and `stream` for its bytes. On Linux the desktop portal's
# open dialog (org.freedesktop.portal.FileChooser) asks: it gets the kinds
# of file to offer, and its answer is a file:// URI. The picked CSV reads
# the same whole, as text and a part at a time, and Crewboard's desktop
# import (a copy of Examples/Apps/Crewboard's Desktop and Logic) adds its
# rows to a project as tasks. With no dialog to ask, no file is picked and
# a notice says why. In a page (web/main.jet, built for the web output) the
# browser's file chooser asks: a hidden file input offers the kinds' name
# endings and media types, and the page keeps the picked file, whose bytes
# read the same there. Crewboard's import_tasks asks the chooser again and
# imports the same CSV as on Linux. A drop of files on a `drop_files` body
# gives the files of a kind it takes, read the same way, and a drop with
# none of them calls nothing.
fixture: PickedFileReadsTheSameBytesOnLinuxAndTheWeb.fixture
requires: os-name:linux
env: NO_COLOR=1
spawn bus: jet run bus/fake_portal.jet
stdout: file bus.stdout
stderr: file bus.stderr
await: file bus.ready timeout 120s every 10ms # the fake bus listens
step: jet run main.jet
env: DBUS_SESSION_BUS_ADDRESS=unix:path={work}/bus.sock
exit: 0
stdout: = "picked: crew-tasks.csv, 59 bytes, text\nwhole, text and stream agree: true\nimported 2 tasks\nGate repair: 2 open\nSpring fair: 3 open\n"
wait: bus timeout 60s
exit: 0
file: heard.txt = "Hello AddMatch OpenFile\nOpen File | handle_token | jet3 | filters | a(sa(us)) | CSV | *.csv | text/csv | current_filter | (sa(us)) | CSV | *.csv | text/csv\n"
step: jet run main.jet
env: DBUS_SESSION_BUS_ADDRESS=unix:path={work}/no-bus.sock
exit: 0
stdout: ~ "picked: none" # no dialog to ask, so no file
stdout: ~ "notice: Couldn't open a file:" # the notice says why
when tool node
step: jet build --target web main.jet
cwd: web
exit: 0
copy: web/page.mjs web/.jet/build/page.mjs
step: node page.mjs
cwd: web/.jet/build
exit: 0
stdout: = "the chooser offers .csv,text/csv, from a hidden input on the page\npicked: crew-tasks.csv, 59 bytes, text\nwhole, text and stream agree: true\nthe chooser offers .csv,text/csv, from a hidden input on the page\nimported 2 tasks\nGate repair: 2 open\nSpring fair: 3 open\nthe chooser's input is gone: true\nscene: div:\"board: 0 drops\"\nthe board takes a drag: true\ndropped: crew-tasks.csv, 59 bytes, text\nwhole, text and stream agree: true\nscene: div:\"board: 1 drops\"\nafter a drop of only the note, scene: div:\"board: 1 drops\"\n"
end when
