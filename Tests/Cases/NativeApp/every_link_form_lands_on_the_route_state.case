# A task's link lands on its screen state through the app graph's one route
# set, whatever its form. On a Linux desktop, `launch` installs the app's
# desktop entry, which names it the handler of `crewboard:` links, and opens
# the link the launch was given; `open_link` opens a link of the app's
# scheme, a web link of its domain and an address alike. A link no screen
# opens, or of a host the app doesn't have, opens the not-found state. On
# the web the same addresses are the server's pages: the task's, and the
# not-found page.
fixture: EveryLinkFormLandsOnTheRouteState.fixture
requires: os-name:linux
env: NO_COLOR=1
env: XDG_DATA_HOME={work}/data
env: XDG_CONFIG_HOME={work}/config
env: XDG_RUNTIME_DIR={work}/run
mkdir: run
step: jet run main.jet -- crewboard://tasks/0190f1c2-3b4a-7c5d-8e6f-0000000000aa
exit: 0
stdout: = "launch: TaskView{id: 0190f1c2-3b4a-7c5d-8e6f-0000000000aa}\ncrewboard://tasks/0190f1c2-3b4a-7c5d-8e6f-123456789abc: TaskView{id: 0190f1c2-3b4a-7c5d-8e6f-123456789abc}\nhttps://crew.example.com/tasks/0190f1c2-3b4a-7c5d-8e6f-123456789abc: TaskView{id: 0190f1c2-3b4a-7c5d-8e6f-123456789abc}\n/tasks/0190f1c2-3b4a-7c5d-8e6f-123456789abc: TaskView{id: 0190f1c2-3b4a-7c5d-8e6f-123456789abc}\ncrewboard://projects/0190f1c2-3b4a-7c5d-8e6f-123456789abc: not found: crewboard://projects/0190f1c2-3b4a-7c5d-8e6f-123456789abc\nhttps://elsewhere.example.com/tasks/0190f1c2-3b4a-7c5d-8e6f-123456789abc: not found: https://elsewhere.example.com/tasks/0190f1c2-3b4a-7c5d-8e6f-123456789abc\nweb /tasks/0190f1c2-3b4a-7c5d-8e6f-123456789abc: 200 <!doctype html><html><head><meta charset=\"utf-8\"><title>Crewboard</title></head><body><p>task 0190f1c2-3b4a-7c5d-8e6f-123456789abc</p><script type=\"application/json\" id=\"jet-resume\">[]</script></body></html>\nweb /projects/0190f1c2-3b4a-7c5d-8e6f-123456789abc: 404 404 Not Found\n"
file: data/applications/crewboard.desktop ~ "MimeType=x-scheme-handler/crewboard;" # the entry handles the scheme
file: data/applications/crewboard.desktop ~ "main.jet\" %u" # and runs the program with the link
file: config/mimeapps.list = "[Default Applications]\nx-scheme-handler/crewboard=crewboard.desktop\n" # the default handler
