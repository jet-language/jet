# Typing in a core.ui text input runs its change handler (`on_change:`) on
# the input's new text. A fake compositor on $WAYLAND_DISPLAY focuses the
# app's input with Tab and types "hi": the handler gets "h", then "hi",
# keeps the note, and the panel that shows the note's length turns green.
# Backspace gives it "h", and the panel turns yellow. Then it closes the
# window, which ends the app. In a page each input event runs the handler
# on the input's value, and the input the repaint puts in its place keeps
# the focus and the caret.
fixture: TypingInATextInputRunsItsChangeHandler.fixture
requires: os-name:linux
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: XDG_DATA_HOME={work}/data
env: XDG_CONFIG_HOME={work}/config
env: XDG_RUNTIME_DIR={work}/run
env: DBUS_SESSION_BUS_ADDRESS=unix:path={work}/no-bus.sock
mkdir: run
spawn compositor: jet run compositor/fake_compositor.jet
stdout: file compositor.stdout
stderr: file compositor.stderr
await: file compositor.ready timeout 120s every 10ms # the fake compositor listens
step: jet run main.jet
env: WAYLAND_DISPLAY={work}/wl.sock
exit: 0
stdout: = "changed: h\nchanged: hi\nchanged: h\n"
wait: compositor timeout 60s
exit: 0
file: compositor.stdout = "notes: 200x200, panel [51, 102, 255, 255]\ntyped hi into the input\nafter typing: panel [51, 153, 51, 255]\npressed Backspace\nafter Backspace: panel [204, 153, 0, 255]\nclosed the window\n"
when tool node
step: jet build --target web main.jet
cwd: web
exit: 0
copy: web/page.mjs web/.jet/build/page.mjs
step: node page.mjs
cwd: web/.jet/build
env: XDG_DATA_HOME={work}/page-data
exit: 0
stdout: = "mounted: \"note: \", input \"\", focused false, caret 0\nchanged: h\ntyped h: \"note: h\", input \"h\", focused true, caret 1\nchanged: hi\ntyped i: \"note: hi\", input \"hi\", focused true, caret 2\nchanged: h\ndeleted the i: \"note: h\", input \"h\", focused true, caret 1\n"
end when
