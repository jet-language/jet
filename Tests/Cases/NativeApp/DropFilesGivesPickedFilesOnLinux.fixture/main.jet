// Crewboard's import screen in a Linux window: its body takes dropped CSV
// files (`app.drop_files`), and each one dropped on it is read through
// the PickedFile it arrives as. Closing the window ends the app.
use {
    app
    ui: core.ui
    tasks: core.tasks
    core.color.[Color]
    core.ui.[UINode]
}

ImportView: struct {}

import_screen: fn(view: ImportView) -> UINode {
    app.drop_files(
        ui.box([ui.node_color("", 200.0, 100.0, Color{r: 51, g: 102, b: 255, a: 255})]),
        types: [app.FileType]{app.FileType.CSV},
        on_drop: fn(dropped: [app.PickedFile]) {
            print("dropped {dropped.len()} files")
            loop file in dropped {
                text: file.text() ?? return Err(app.Notice{text: "Couldn't read {file.name}: {err}"})
                rows: text.split("\n").to_list()
                print("{file.name}: {file.bytes} bytes, first row {rows[1]}")
            }
        },
    )
}

run: fn() {
    graph: app.new("Crewboard").screen("/", import_screen).window(width: 200, height: 100)
    if !graph.launch() {
        return
    }
    // Closing the window ends the app; it waits up to a minute for that.
    loop _ in 0..<6000 -> tasks.sleep(10)
    loop notice in app.notices() -> print("notice: {notice.text}")
    print("the window stayed open")
}
