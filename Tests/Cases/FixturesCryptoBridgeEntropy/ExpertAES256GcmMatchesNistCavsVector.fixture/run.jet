// PENDING-SAME-HEAD. Runtime UNRUN
// CryptoError payloads retire under D-CRYPTO-ERRFAM1=A; public tag mappings cite Core at assertion sites.
use expert: core.crypto.expert

filled: fn(value: Int, count: Int) -> [U8] {
    out := [U8]{}
    loop _ in 0..<count -> out.push((U8{value}))
    out
}

cut: fn(bytes: [U8], start: Int, end: Int) -> [U8] {
    out := [U8]{}
    loop i in start..<end -> out.push(bytes[i])
    out
}

hex: fn(text: String) -> [U8] {
    raw: text.bytes()
    out := [U8]{}
    loop i in 0..<(raw.len() /% 2) {
        a: Int{raw[2 * i]}
        b: Int{raw[2 * i + 1]}
        high: if a <= 57 -> a - 48 else -> a - 87
        low: if b <= 57 -> b - 48 else -> b - 87
        out.push((U8{high * 16 + low}))
    }
    out
}

little: fn(bytes: [U8], at: Int, width: Int) -> Int {
    out := 0
    loop i in 0..<width -> out |= Int{bytes[at + i]} << (8 * i)
    out
}

store_little: fn(bytes: &[U8], at: Int, width: Int, value: Int) {
    loop i in 0..<width -> bytes[at + i] = (U8{(value >> (8 * i)) & 255})
}

#Test("expert_aes256gcm_matches_nist_cavs_vector") {
    #Unsafe("original published known-answer vector") {
        key: hex("b52c505a37d78eda5dd34f20c22540ea1b58963cf8e5bf8ffa85f9f2492505b4")
        nonce: hex("516c33929df5a3284ff463d7")
        plain: hex("")
        aad: hex("")
        sealed: expert.aes256gcm_seal(key, nonce, plain, aad) ?? panic("seal")
        assert_eq(sealed, hex("bdc1ac884d332457a1d2664f168c76f0"))
        assert_eq(expert.aes256gcm_open(key, nonce, sealed, aad) ?? panic("open"), plain)
    }
}
