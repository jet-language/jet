# Original tests/failure_tier_parity.rs:280-288; verbatim input and every runtime parity assertion. The AOT
# tier builds the same main.jet the JIT and release tiers run, not a second copy inside the package.
fixture: FailureContractMatrixMatchesComptimeAndHostedTiers.fixture
step jit: jet run main.jet
env: NO_COLOR=1
exit: 0
stdout: = expected.out
step release: jet run --release main.jet
env: NO_COLOR=1
exit: 0
stdout: == jit
stderr: == jit
step: jet build main.jet
env: NO_COLOR=1
exit: 0
step aot: built
exit: 0
stdout: == jit
stderr: == jit
stdout: == release
stderr: == release
