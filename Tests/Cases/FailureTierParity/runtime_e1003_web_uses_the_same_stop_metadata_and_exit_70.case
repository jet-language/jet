# The web build of the out-of-width draw stops as `jet run` does: the page
# prints the stop report and exits 70. Which code that report carries is
# runtime_e1003_is_a_stop_with_exit_70_on_every_hosted_tier's to pin. The
# stop is raised inside Core, so its `-->` line names the user's call: the
# native image finds it in its location table, the web page in the program
# module's (main.jet:5 on both).
fixture: RuntimeE1003WebUsesTheSameStopMetadataAndExit70.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
requires: tool:node
step native: jet run main.jet
exit: 70
stdout: empty
stderr: ~ "\n  --> main.jet:5\n" # the user's call that reached Core
step: jet build --target web main.jet
exit: 0
step: node app.js
cwd: .jet/build
exit: 70
stdout: empty
stderr: ~ "\n  --> main.jet:5\n" # the same user call as natively
stderr: !~ "<corelib>/" # no Core path leaks into the report
stderr: !~ "trapped" # the stop leaves by its stop path, not a wasm trap
