# Original tests/failure_tier_parity.rs:197-245 and every runtime parity assertion. Its DNS timeout came from a
# negative lookup timeout core.net no longer takes, and an expired #Deadline stops at the wait (E3003), so the
# NetError here is core.net's refusal of a name with a control byte: the same on every host, with no network.
fixture: CoreNetErrorConversionRendersInResidentJIT.fixture
step jit: jet run main.jet
env: NO_COLOR=1
exit: 1
stdout: empty
stderr: ~ "Error:" # the diagnostic says it
stderr.from_or_all("Error:"): ~ "DNS name is empty or contains control bytes" # the report names the NetError cause
stderr.from_or_all("Error:"): ~ "(type: NetError)" # and its source type
stderr.from_or_all("Error:"): ~ "conversion" # and the conversion that reported it
capture: jit_runtime = text stderr.from_or_all("Error:").normalize_failure_journey_paths
step release: jet run --release main.jet
env: NO_COLOR=1
exit: 1
stdout: == jit
stderr.from_or_all("Error:").normalize_failure_journey_paths: = "{cap:jit_runtime}" # the tiers' reports differ only in their journey paths
step: jet build main.jet
env: NO_COLOR=1
exit: 0
step aot: built
exit: 1
stdout: == jit
stderr: ~ "Error:" # the diagnostic says it
stderr.from_or_all("Error:").normalize_failure_journey_paths: = "{cap:jit_runtime}" # the tiers' reports differ only in their journey paths
