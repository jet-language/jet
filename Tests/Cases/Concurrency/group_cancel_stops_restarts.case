# Canceling a supervised group stops restarts immediately and joins every
# worker so no worker outlives the group.
fixture: GroupCancelStopsRestarts.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run main.jet
exit: 0
stdout: = "canceled: true\nactive_after_wait: 0\nrestarts_stopped: true\nquiesced: true\n"
