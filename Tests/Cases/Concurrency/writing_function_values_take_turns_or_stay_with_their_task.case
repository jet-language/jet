# A function value whose body writes its captures is never called by two
# tasks at once. A detached task takes the value, so the owner's later call
# is refused (E0121). `task.group` children and their owner that call one
# value take turns under its invocation lock: before the lock the calls
# pushed onto one list together, and the checked heap trapped the list's
# buffer freed twice.
fixture: WritingFunctionValues.fixture
env: NO_COLOR=1
step: jet run -O0 refused.jet
exit: 1
stdout: = ""
stderr: ~ "Error: Jet.UseAfterMove: `counter` was consumed by a task that captures it, so it can't be used here" # the owner's call after the task took the value
stderr: ~ "spawn the task in a `task.group`, whose child borrows `counter` until the join" # a function value has no copy to give
step: jet run -O1 refused.jet
exit: 1
stdout: = ""
stderr: ~ "Error: Jet.UseAfterMove: `counter` was consumed by a task that captures it, so it can't be used here" # the same refusal on O1
step: jet run -O2 refused.jet
exit: 1
stdout: = ""
stderr: ~ "Error: Jet.UseAfterMove: `counter` was consumed by a task that captures it, so it can't be used here" # the same refusal on O2
step: jet run --checked-alloc -O0 main.jet
exit: 0
stdout: = "18003000\n6001\n8002000\n4000\n"
step: jet run --checked-alloc -O1 main.jet
exit: 0
stdout: = "18003000\n6001\n8002000\n4000\n"
step: jet run --checked-alloc -O2 main.jet
exit: 0
stdout: = "18003000\n6001\n8002000\n4000\n"
