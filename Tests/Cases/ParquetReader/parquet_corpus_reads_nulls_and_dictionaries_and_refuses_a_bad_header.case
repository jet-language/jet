# The Parquet reader on upstream apache/parquet-testing files: an INT32
# column with an all-null page, a dictionary-encoded string column, and a
# dictionary page header with a negative value count, which it refuses as
# a Decode error.
fixture: ParquetCorpusReadsNullsAndDictionariesAndRefusesABadHeader.fixture
copy: {root}/Tests/Run/Tooling/int32_with_null_pages.parquet int32_with_null_pages.parquet
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run main.jet
exit: 0
stdout: = "int32 rows=1000 nonnull=true null_page=true\ndictionary: decoded string_col\nmalformed: rejected Decode data.loader.parquet\n"
