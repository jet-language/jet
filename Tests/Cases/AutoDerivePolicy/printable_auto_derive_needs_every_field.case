# A structural Printable auto-derives only when every field qualifies: a field
# whose type refuses Printable blocks it, and a field that derives its own does not.
fixture: PrintableAutoDeriveNeedsEveryField.fixture
env: NO_COLOR=1
step: jet check main.jet
exit: 1
stderr: count "Error: Jet.ValueTypeMismatch" = 1 # only the field that refuses Printable blocks the derive
stderr: ~ "main.jet:12:36" # at the field whose type refuses Printable
copy: main.second main.jet
step: jet run main.jet
exit: 0
stdout: = "Shown { child: Inner { value: 1 }, name: a }\n"
