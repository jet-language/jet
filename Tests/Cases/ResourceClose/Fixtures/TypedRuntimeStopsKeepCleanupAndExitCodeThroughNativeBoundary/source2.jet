Resource: struct {
    name: String,

    impl Close {
        close: fn(^^self) { print("auto {self.name}") }
    }
}

#Allow(Jet.UnconditionalRecursion, "it overflows on purpose") recurse: fn(n: Int) -> Int {
    return recurse(n + 1)
}

run: fn() {
    ^resource: Resource{name: "stack"}
    print("body")
    print(recurse(0))
}
