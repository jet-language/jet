// The retired declaration words are ordinary names: fields, parameters,
// labels and locals.
Label: struct {
    tag: String,
    effect: Int,
    derive: Bool,
}

describe: fn(tag: String, effect: Int) -> String { "{tag} {effect}" }

run: fn() {
    marker: 2
    fact: 3
    label: Label{tag: "ok", effect: marker + fact, derive: true}
    print(describe(tag: label.tag, effect: label.effect))
    print("derive {label.derive}")
}
