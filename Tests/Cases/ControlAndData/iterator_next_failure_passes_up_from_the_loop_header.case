# An Iterator's `next` may fail, and a loop over an Iterable passes that
# failure up from its header: as the function's own failure, through a
# `From` conversion, or into an inferred failure, closing the iterator it owns
# with no further `next` call. `Error` is inferred from `next`, or written as
# that failure or `Never`. Called directly, `next` answers a recoverable
# failure, a terminal failure then None, and None for good. Every tier and
# the built binary print the same lines.
fixture: IteratorNextFailurePassesUpFromTheLoopHeader.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 0
step: jet run -O0 main.jet
exit: 0
stdout: = iterator_next_failure_passes_up_from_the_loop_header.out
step: jet run -O1 main.jet
exit: 0
stdout: = iterator_next_failure_passes_up_from_the_loop_header.out
step: jet run -O2 main.jet
exit: 0
stdout: = iterator_next_failure_passes_up_from_the_loop_header.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = iterator_next_failure_passes_up_from_the_loop_header.out
