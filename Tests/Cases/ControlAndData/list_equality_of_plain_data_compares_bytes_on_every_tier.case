# Lists of plain data (fixed-width integers, Bools) compare as their buffers' bytes
# through the runtime's memcmp, so lengths around the 8-byte word and the
# 64-byte step all decide by every element; Floats still compare by value.
fixture: ListEqualityOfPlainDataComparesBytesOnEveryTier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run -O0 main.jet
exit: 0
stdout: = "0 = = = x\n1 = x x x\n7 = x x x\n8 = x x x\n9 = x x x\n63 = x x x\n64 = x x x\n65 = x x x\n127 = x x x\n128 = x x x\n200 = x x x\nI32 3 = x\nI32 16 = x\nI32 17 = x\nI32 40 = x\nBool =\nBool x\nF64 =\nF64 x\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "0 = = = x\n1 = x x x\n7 = x x x\n8 = x x x\n9 = x x x\n63 = x x x\n64 = x x x\n65 = x x x\n127 = x x x\n128 = x x x\n200 = x x x\nI32 3 = x\nI32 16 = x\nI32 17 = x\nI32 40 = x\nBool =\nBool x\nF64 =\nF64 x\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "0 = = = x\n1 = x x x\n7 = x x x\n8 = x x x\n9 = x x x\n63 = x x x\n64 = x x x\n65 = x x x\n127 = x x x\n128 = x x x\n200 = x x x\nI32 3 = x\nI32 16 = x\nI32 17 = x\nI32 40 = x\nBool =\nBool x\nF64 =\nF64 x\n"
