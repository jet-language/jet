# A hole table read as a value tries every candidate, as the statement form does: each arm's header runs with its own candidate, a traced candidate runs once per arm tried and never after the match, while a plain table over a call reads its subject once.
fixture: HoleTableValueFormTriesEveryCandidate.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step o0: jet run -O0 main.jet
exit: 0
stdout: = "Fizz Fizz Fizz\nBuzz Buzz Buzz\nFizzBuzz FizzBuzz FizzBuzz\n7 7 7\n  try green\n  try amber\n  try red\nred\n  try green\n  try amber\namber\n  read\n2\n"
stderr: empty
step o1: jet run -O1 main.jet
exit: 0
stdout: = "Fizz Fizz Fizz\nBuzz Buzz Buzz\nFizzBuzz FizzBuzz FizzBuzz\n7 7 7\n  try green\n  try amber\n  try red\nred\n  try green\n  try amber\namber\n  read\n2\n"
stderr: empty
step o2: jet run -O2 main.jet
exit: 0
stdout: = "Fizz Fizz Fizz\nBuzz Buzz Buzz\nFizzBuzz FizzBuzz FizzBuzz\n7 7 7\n  try green\n  try amber\n  try red\nred\n  try green\n  try amber\namber\n  read\n2\n"
stderr: empty
