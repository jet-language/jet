# An ending process leaves its heap to the kernel. After 400,000 strings and a
# 64 MiB buffer, process.exit runs every user cleanup (the deferred Close that
# wipes a Secret, the scope guard, the exit callback) and frees nothing: the
# buffer alive at the exit is never unmapped. With `drop`, a buffer of the same
# size dies inside the run first, so freeing one is seen as munmap.
requires: os-name:linux
requires: arch:x86_64
fixture: ProcessExitLeavesHeapToKernelAfterUserCleanup.fixture
env: NO_COLOR=1
step: jet build main.jet
exit: 0
step held: jet perf attach --lens=syscalls --out exit.jettrace -- {work}/.jet/build/main
exit: 0
stdout: = process_exit_leaves_heap_to_kernel_after_user_cleanup.stdout.expected
json: file exit.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.status = "traced" # the kernel let jet trace the program
json: file exit.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.calls[?name="munmap"] #= 0 # no free at the exit
step drop: jet perf attach --lens=syscalls --out drop.jettrace -- {work}/.jet/build/main drop
exit: 0
stdout: = process_exit_leaves_heap_to_kernel_after_user_cleanup.drop.stdout.expected
json: file drop.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.calls[?name="munmap"] #>= 1 # the dropped buffer's free shows as a munmap
step: jet build --release main.jet
exit: 0
step optimized: jet perf attach --lens=syscalls --out optimized.jettrace -- {work}/.jet/build/main
exit: 0
stdout: = process_exit_leaves_heap_to_kernel_after_user_cleanup.stdout.expected
json: file optimized.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.status = "traced" # the kernel let jet trace the program
json: file optimized.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.calls[?name="munmap"] #= 0 # no free at the exit
step optimizeddrop: jet perf attach --lens=syscalls --out optimized-drop.jettrace -- {work}/.jet/build/main drop
exit: 0
stdout: = process_exit_leaves_heap_to_kernel_after_user_cleanup.drop.stdout.expected
json: file optimized-drop.jettrace doc $.content.receipt_sections[?name="syscalls"][0].value.calls[?name="munmap"] #>= 1 # the dropped buffer's free shows as a munmap
