# A `#SingleUse` payload bound by a pattern from a temporary owes `consume`
# like a plain binding of it (E0140), in an `if` test and in a match arm.
fixture: PatternBindingOwesConsume.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet check main.jet --json
exit: nonzero
json: stdout doc $.reports[?severity="error"] #= 2 # the two dropped payloads, nothing else
json: stdout doc $.reports[?code="E0140"][?message="`lease` still owes `consume`"] #= 2 # each pattern binding owes the duty a plain binding would
