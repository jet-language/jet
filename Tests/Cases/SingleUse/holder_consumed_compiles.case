# A record, tuple or enum holding a `#SingleUse` value owes nothing once it
# is moved whole, or once each field that holds the duty is moved out. A
# record lent to a function, read or written, keeps the duty with its owner.
# The program runs the same on every tier.
fixture: HolderConsumedCompiles.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet check main.jet
exit: 0
step: jet run -O0 main.jet
exit: 0
stdout: = "lent whole 2\nreleased whole\nreleased field\n2\nreleased first\nreleased second\nreleased tuple\n3\nreleased slot\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "lent whole 2\nreleased whole\nreleased field\n2\nreleased first\nreleased second\nreleased tuple\n3\nreleased slot\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "lent whole 2\nreleased whole\nreleased field\n2\nreleased first\nreleased second\nreleased tuple\n3\nreleased slot\n"
