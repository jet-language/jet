# A record or enum holding a `#SingleUse` value owes its duty as the value
# does (E0140): a record field, a nested record, an enum payload and a record
# holding Core's `mem.Block`, each dropped undone. The holders moved whole or
# emptied field by field owe nothing.
fixture: HolderDroppedIsE0140.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet check main.jet --json
exit: nonzero
json: stdout doc $.reports[?severity="error"] #= 4 # exactly the four dropped holders, nothing else
json: stdout doc $.reports[?code="E0140"] #= 4 # each one owes `consume`
json: stdout doc $.reports[?code="E0140"][?message="`nested` still owes `consume`"] #= 1 # a record inside a record holds it too
json: stdout doc $.reports[?code="E0140"][?message="`slot` still owes `consume`"] #= 1 # an enum payload holds it too
