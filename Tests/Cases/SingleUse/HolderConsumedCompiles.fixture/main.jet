// A record, tuple or enum holding a `#SingleUse` value is consumed by a move
// of the whole value, by a move of each field that holds the duty, or by
// returning it; none of these owes anything at its scope's end. A record
// lent to a function keeps its duty with its owner.
#SingleUse Lease: struct {
    name: String,
}

Holder: struct {
    lease: Lease,
    count: Int,
}

Pair: struct {
    first: Lease,
    second: Lease,
}

Slot: enum {
    _Empty,
    Held(lease: Lease),
}

acquire: fn(name: String) -> Lease { Lease{name: name.copy()} }

release: fn(lease: ^^Lease) {
    print("released {lease.name}")
    #Unsafe("the lease's job is done by hand here") { consume(lease) }
}

release_holder: fn(holder: ^^Holder) { release(holder.lease.move()) }

release_slot: fn(slot: ^^Slot) {
    print("released slot")
    #Unsafe("the slot's lease is done by hand here") { consume(slot) }
}

make: fn(name: String) -> Holder { Holder{lease: acquire(name), count: 1} }

name_of: fn(holder: Holder) -> String { holder.lease.name.copy() }

bump: fn(holder: ^Holder) { holder.count += 1 }

run: fn() {
    ^whole: make("whole")
    bump(whole)
    print("lent {name_of(whole)} {whole.count}")
    release_holder(whole)
    split: Holder{lease: acquire("field"), count: 2}
    release(split.lease.move())
    print(split.count)
    pair: Pair{first: acquire("first"), second: acquire("second")}
    release(pair.first.move())
    release(pair.second.move())
    tuple: {lease: acquire("tuple"), count: 3}
    release(tuple.lease.move())
    print(tuple.count)
    slot: Slot.Held{lease: acquire("slot")}
    release_slot(slot)
}
