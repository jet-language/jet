// A `#SingleUse` payload bound by a pattern from a temporary and released in
// its arm owes nothing more, in an `if` test and in a match arm.
#SingleUse Lease: struct {
    name: String,
}

acquire: fn(name: String) -> Lease? { Val(Lease{name: name.copy()}) }

release: fn(lease: ^^Lease) { print("released {lease.name}") }

run: fn() {
    if acquire("if") == .Val(lease) -> release(lease)
    if acquire("arm") == {
        .Val(lease) -> { release(lease) }
        .None -> {}
    }
}
