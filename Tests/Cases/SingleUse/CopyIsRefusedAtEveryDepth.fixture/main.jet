// Each `.copy()` below would give a `#SingleUse` value's one duty a second
// owner: the value itself, a record field, an enum payload, a list element,
// an option, and Core's `mem.Block` on its own and inside a record. So would
// the implicit copy `first` makes of an element its shelf keeps.
use core.mem

#SingleUse Lease: struct {
    name: String,
}

Holder: struct {
    lease: Lease,
}

Slot: enum {
    Empty,
    Held(lease: Lease),
}

BlockHolder: struct {
    block: mem.Block,
}

Shelf: struct {
    leases: [Lease],

    first: fn(self) -> Lease { self.leases[0] }
}

copy_value: fn(lease: Lease) -> Lease { lease.copy() }

copy_holder: fn(holder: Holder) -> Holder { holder.copy() }

copy_payload: fn(slot: Slot) -> Slot { slot.copy() }

copy_list: fn(leases: [Lease]) -> [Lease] { leases.copy() }

copy_option: fn(maybe: Lease?) -> Lease? { maybe.copy() }

copy_block: fn(block: mem.Block) -> mem.Block { block.copy() }

copy_block_holder: fn(holder: BlockHolder) -> BlockHolder { holder.copy() }

run: fn() {}
