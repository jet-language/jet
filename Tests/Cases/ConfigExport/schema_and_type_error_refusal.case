# Export JSON Schema from the same #Codable metadata and refuse ill-typed config values before writing any output.
fixture: Fixtures/AppConfig
env: NO_COLOR=1
step: jet os config export app.jet APP_CONFIG --schema
exit: 0
json: stdout doc $ valid # JSON Schema output must be valid JSON
json: stdout doc $.title = "AppConfig" # schema title matches checked struct name
json: stdout doc $.type = "object" # root schema is an object
json: stdout doc $.additionalProperties = false # #Codable(unknown: .Deny) sets additionalProperties false
json: stdout doc $.properties.listen_port.type = "integer" # #Rename wire key matches codec metadata
json: stdout doc $.properties.host.type = "string" # string property schema
json: stdout doc $.properties.hosts.type = "array" # list property schema
json: stdout doc $.properties.hosts.items.type = "string" # list element schema
json: stdout doc $.properties.tls.type = "boolean" # bool property schema
json: stdout doc $.properties.endpoint.type = "object" # nested struct schema
json: stdout doc $.properties.endpoint.properties.timeout_ms.type = "integer" # nested struct field schema
stdout: ~ "https://json-schema.org/draft/2020-12/schema" # Draft 2020-12 meta-schema URI
stdout: !~ "internal_tag" # #Codable(.Skip) fields are omitted from schema
step: jet os config export app.jet staging_config --format json
exit: 0
json: stdout doc $.listen_port = 9090 # zero-argument config function also exports cleanly
json: stdout doc $.note = "staging" # present optional field is encoded
step: jet os config export invalid_type.jet BAD_CONFIG --format json
exit: 1
stdout: = "" # ill-typed value is never exported
stderr: ~ "Error:" # compiler type error is reported on stderr
step: jet os config export invalid_type.jet BAD_CONFIG --schema
exit: 1
stdout: = "" # ill-typed value never produces a schema either
stderr: ~ "Error:" # compiler type error is reported on stderr
