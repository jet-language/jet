# Export a named typed Jet config value as TOML and decode it back into the same typed struct.
fixture: Fixtures/AppConfig
env: NO_COLOR=1
step: jet os config export app.jet APP_CONFIG --format toml
exit: 0
stdout: ~ "listen_port = 8080" # #Rename wire key is honored in TOML
stdout: ~ "host = \"0.0.0.0\"" # string field is preserved in TOML
stdout: ~ "tls = true" # bool field is preserved in TOML
stdout: !~ "internal_tag" # #Codable(.Skip) fields are never written
capture: exported = text stdout
write: exported.toml = "{cap:exported}"
step: jet run decode_toml.jet
exit: 0
stdout: ~ "round_trip_toml: ok" # exported TOML decodes back into the identical typed AppConfig
