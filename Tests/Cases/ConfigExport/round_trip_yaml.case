# Export a named typed Jet config value as YAML and decode it back into the same typed struct.
fixture: Fixtures/AppConfig
env: NO_COLOR=1
step: jet os config export app.jet APP_CONFIG --format yaml
exit: 0
stdout: ~ "listen_port: 8080" # #Rename wire key is honored in YAML
stdout: ~ "host: 0.0.0.0" # string field is preserved in YAML
stdout: ~ "tls: true" # bool field is preserved in YAML
stdout: !~ "internal_tag" # #Codable(.Skip) fields are never written
capture: exported = text stdout
write: exported.yaml = "{cap:exported}"
step: jet run decode_yaml.jet
exit: 0
stdout: ~ "round_trip_yaml: ok" # exported YAML decodes back into the identical typed AppConfig
