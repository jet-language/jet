# A program-side stop prints the same report at -O0, -O1 and -O2: the same
# What, the same Jet frame and source line, the same locals, Why, Fix and
# More. A panic three calls deep names the function it stopped in, and a
# list position past the end names the indexing line, byte for byte on
# every tier.
fixture: Fixtures/AStopReadsTheSameOnEveryTier
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step panic_o0: jet run -O0 nested.jet
exit: 70
stdout: empty
stderr: = a_stop_reads_the_same_on_every_tier.panic.expected
step panic_o1: jet run -O1 nested.jet
exit: 70
stdout: empty
stderr: = a_stop_reads_the_same_on_every_tier.panic.expected
step panic_o2: jet run -O2 nested.jet
exit: 70
stdout: empty
stderr: = a_stop_reads_the_same_on_every_tier.panic.expected
step bounds_o0: jet run -O0 bounds.jet
exit: 70
stdout: empty
stderr: = a_stop_reads_the_same_on_every_tier.bounds.expected
step bounds_o1: jet run -O1 bounds.jet
exit: 70
stdout: empty
stderr: = a_stop_reads_the_same_on_every_tier.bounds.expected
step bounds_o2: jet run -O2 bounds.jet
exit: 70
stdout: empty
stderr: = a_stop_reads_the_same_on_every_tier.bounds.expected
