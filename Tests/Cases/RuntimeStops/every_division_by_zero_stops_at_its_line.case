# Exact `/`, floor `/%` and remainder `%` by a zero divisor all give the
# same E3010 "divided by zero" stop at the division's own file and line on
# o0, o1 and o2. None reports line 0, quotes a source line, or uses the
# retired "invalid exact quotient" wording. A written zero divisor passes
# `jet check` and stops at its line once the lines before it have run. A
# Fraction built from user parts involves no division operator, so a zero
# denominator gives `None` instead of the division stop. The p04, p18 and p19
# fixtures are the learning-compilers mining probes: a constant zero
# divisor, exact division by zero, and a one-item list read at position 1.
fixture: Fixtures/EveryDivisionByZeroStopsAtItsLine
env: NO_COLOR=1
step p18_o0: jet run -O0 p18_exact_division_by_zero.jet
exit: 70
stdout: empty
stderr: ~ "Stop [E3010]: `divided by zero`" # the shared stop
stderr: ~ "--> p18_exact_division_by_zero.jet:7" # the division's line
stderr: !~ "invalid exact quotient" # the retired wording
stderr: !~ "p18_exact_division_by_zero.jet:0" # never line 0
stderr: !~ " | " # no quoted source line
step p18_o1: jet run -O1 p18_exact_division_by_zero.jet
exit: 70
stderr: ~ "Stop [E3010]: `divided by zero`" # the shared stop
stderr: ~ "--> p18_exact_division_by_zero.jet:7" # the division's line
stderr: !~ "invalid exact quotient" # the retired wording
step p18_o2: jet run -O2 p18_exact_division_by_zero.jet
exit: 70
stderr: ~ "Stop [E3010]: `divided by zero`" # the shared stop
stderr: ~ "--> p18_exact_division_by_zero.jet:7" # the division's line
stderr: !~ "invalid exact quotient" # the retired wording
step floor_o0: jet run -O0 floor.jet
exit: 70
stdout: empty
stderr: ~ "Stop [E3010]: `divided by zero`" # the shared stop
stderr: ~ "--> floor.jet:6" # the division's line
stderr: !~ " | " # no quoted source line
step floor_o1: jet run -O1 floor.jet
exit: 70
stderr: ~ "Stop [E3010]: `divided by zero`" # the shared stop
stderr: ~ "--> floor.jet:6" # the division's line
step floor_o2: jet run -O2 floor.jet
exit: 70
stderr: ~ "Stop [E3010]: `divided by zero`" # the shared stop
stderr: ~ "--> floor.jet:6" # the division's line
step rem_o0: jet run -O0 rem.jet
exit: 70
stdout: empty
stderr: ~ "Stop [E3010]: `divided by zero`" # the shared stop
stderr: ~ "--> rem.jet:6" # the division's line
stderr: !~ " | " # no quoted source line
step rem_o1: jet run -O1 rem.jet
exit: 70
stderr: ~ "Stop [E3010]: `divided by zero`" # the shared stop
stderr: ~ "--> rem.jet:6" # the division's line
step rem_o2: jet run -O2 rem.jet
exit: 70
stderr: ~ "Stop [E3010]: `divided by zero`" # the shared stop
stderr: ~ "--> rem.jet:6" # the division's line
step p04_check: jet check p04_constant_zero_divisor.jet
exit: 0
step p04_o0: jet run -O0 p04_constant_zero_divisor.jet
exit: 70
stdout: ~ "start" # the line before the division ran
stderr: ~ "Stop [E3010]: `divided by zero`" # the shared stop
stderr: ~ "--> p04_constant_zero_divisor.jet:5" # the division's line
step p04_o1: jet run -O1 p04_constant_zero_divisor.jet
exit: 70
stdout: ~ "start" # the line before the division ran
stderr: ~ "--> p04_constant_zero_divisor.jet:5" # the division's line
step p04_o2: jet run -O2 p04_constant_zero_divisor.jet
exit: 70
stdout: ~ "start" # the line before the division ran
stderr: ~ "--> p04_constant_zero_divisor.jet:5" # the division's line
step p19_o0: jet run -O0 p19_list_position_one_item.jet
exit: 70
stdout: empty
stderr: ~ "Stop [E3010]: `the list has 1 item, so position 1 doesn't exist; positions stop one below the count, and xs.last() reads the last item`" # one item, singular
stderr: ~ "--> p19_list_position_one_item.jet:4" # the indexing line
stderr: !~ "1 items" # the old plural
step p19_o1: jet run -O1 p19_list_position_one_item.jet
exit: 70
stderr: ~ "Stop [E3010]: `the list has 1 item, so position 1 doesn't exist; positions stop one below the count, and xs.last() reads the last item`" # one item, singular
stderr: ~ "--> p19_list_position_one_item.jet:4" # the indexing line
step p19_o2: jet run -O2 p19_list_position_one_item.jet
exit: 70
stderr: ~ "Stop [E3010]: `the list has 1 item, so position 1 doesn't exist; positions stop one below the count, and xs.last() reads the last item`" # one item, singular
stderr: ~ "--> p19_list_position_one_item.jet:4" # the indexing line
step fraction_o0: jet run -O0 fraction.jet
exit: 0
stdout: = "true\n0.75\nafter\n"
stderr: !~ "divided by zero" # no division stop without a division operator
step fraction_o1: jet run -O1 fraction.jet
exit: 0
stdout: = "true\n0.75\nafter\n"
stderr: !~ "divided by zero" # no division stop without a division operator
step fraction_o2: jet run -O2 fraction.jet
exit: 0
stdout: = "true\n0.75\nafter\n"
stderr: !~ "divided by zero" # no division stop without a division operator
