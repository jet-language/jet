// A Fraction built from user parts involves no division operator: a zero
// denominator gives `None`, not the division stop.
use math: core.math

run: fn() {
    xs: [Int]{5}
    z := 0
    if xs.len() > 3 -> z = 1
    print(math.fraction(3, z) == None)
    print(math.fraction(3, 4) ?? panic("three quarters"))
    print("after")
}
