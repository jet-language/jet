# A conversion's identity is its target and its source: a second
# `impl Celsius.From(Float)` is E0908 at its head.
fixture: OneConversionPerSource.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 1
stderr: ~ "`Celsius` already implements `From` for `Float`" # the second conversion from Float is refused
stderr: ~ "main.jet:8:10" # at the second impl's head
stderr: ~ "jet-lang.dev/e/E0908" # the duplicate-conversion code
