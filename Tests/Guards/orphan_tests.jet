// Orphan tests: every test source and fixture under Tests/ is read by a runner.
// A `.jet` or `.case` file under Tests/, and any file in a fixture folder
// (`Fixtures`, `*.fixture`, `Input`), must be read in one of these ways:
// - it lies in a tree a runner walks whole (ORPHAN_CORPORA);
// - it is a case file under Tests/Cases, which the cases suite runs;
// - a reader names the file, or a folder above it below a top tree of Tests/.
//
// The readers are:
// - every `.case` file, Examples' included: the lines that are not comments,
//   relative to the case's folder or to `{root}`;
// - the string literals of the runner sources: Compiler, Jetpack, Examples,
//   Tests/Guards, the Tools programs a case runs, and the case sources under
//   Tests/Cases: the `.jet` files, the `.template` files a case's `write:`
//   turns into a program, and the scripts a case runs;
// - the data files (`.tsv`, `.json`, `.list`, `.txt`) a reader names by
//   file, relative to their own folder.
//
// A `{…}` part of a name ends the name at the folder before it. A name of a
// top tree alone (`Tests/Cases`) covers nothing: naming a tree is no sign of
// reading every file in it. A case's expected output names what the program
// printed, so it reads nothing.
use {
    orphan_files: core.files
    orphan_process: core.process
}

// The guard itself names planted paths, never a real reader's.
ORPHAN_SELF: "Tests/Guards/orphan_tests.jet"

// The `{root}/` prefix a case writes before a repository path.
ORPHAN_ROOT: "{{root}}/"

// A tree a runner walks whole, and that runner.
OrphanCorpus: struct {
    root: String,
    runner: String,
}

ORPHAN_CORPORA: [OrphanCorpus]{
    OrphanCorpus{root: "Tests/UI", runner: "the ui suite (ui_corpus in Compiler/package.jet)"},
    OrphanCorpus{root: "Tests/UILint", runner: "the ui_lint suite (ui_corpus in Compiler/package.jet)"},
    OrphanCorpus{root: "Tests/Run", runner: "the run suite (golden_corpus in Compiler/package.jet)"},
    OrphanCorpus{root: "Tests/Guards", runner: "the packages suite (PACKAGE_TREES in Compiler/test.jet)"},
    OrphanCorpus{root: "Tests/Fuzz/Sema", runner: "the fuzz suite (FUZZ_CORPUS in Compiler/test.jet)"},
    OrphanCorpus{root: "Tests/CompiledWorkloads", runner: "Tools/CI/CompiledWorkloads.jet, which lists its Adapters, Fixtures, Expected and TaskDefinitions folders; the ReleaseGates cases run it"},
}

ORPHAN_DATA_EXTENSIONS: [String]{".tsv", ".json", ".list", ".txt"}

ORPHAN_SOURCE_EXTENSIONS: [String]{".jet", ".template", ".sh", ".py", ".tsv", ".json", ".list", ".txt", ".toml"}

// The files under Tests/Cases that are programs a case runs.
ORPHAN_CASE_SOURCE_EXTENSIONS: [String]{".jet", ".template", ".sh", ".py"}

// The trees whose runner sources may name a path under Tests/: the members,
// whose #Tests the packages suite runs, Core, whose #Tests the core suite
// runs, the examples the golden suite runs, the guards, and the case sources.
ORPHAN_SOURCE_TREES: [String]{"Compiler", "Core", "Jetpack", "Examples", "Tests/Guards", "Tests/Cases"}

OrphanTree: struct {
    // Every file in the working tree that git tracks or would track.
    tracked: [String],
    // The runner sources whose text names `Tests/`.
    sources: [String],
    // Texts a planted tree supplies; any other reader is read from disk.
    texts: [String:String],
}

OrphanFacts: struct {
    files: [String:Bool],
    folders: [String:Bool],
}

orphan_git_lines: fn(args: [String]) -> [String] {
    listed: orphan_process.cmd(args).stdout(.Capture).stderr(.Capture).run() ?? panic("run {args.join(" ")}: {err}")
    assert(listed.code == 0, "{args.join(" ")} failed: {orphan_process.combined_output(listed).trim()}")
    lines := [String]{}
    loop line in orphan_process.stdout_lines(listed) {
        if line.len() > 0 -> lines.push(line.copy())
    }
    lines
}

// Tracked and untracked unignored files, less the ones deleted from the tree.
orphan_tracked: fn() -> [String] {
    deleted := [String:Bool]{}
    loop path in orphan_git_lines([String]{"git", "-c", "core.quotePath=false", "ls-files", "--deleted"}) {
        deleted[path] = true
    }
    paths := [String]{}
    loop path in orphan_git_lines([String]{"git", "-c", "core.quotePath=false", "ls-files", "--cached", "--others", "--exclude-standard"}) {
        if deleted.get(path) == None -> paths.push(path)
    }
    paths
}

// The runner sources that name `Tests/`: the tracked ones git grep finds, and
// every untracked text file in the source trees.
orphan_sources: fn() -> [String] {
    grep := [String]{"git", "-c", "core.quotePath=false", "grep", "-l", "-I", "-F", "Tests/", "--"}
    others := [String]{"git", "-c", "core.quotePath=false", "ls-files", "--others", "--exclude-standard", "--"}
    loop tree in ORPHAN_SOURCE_TREES {
        grep.push(tree.copy())
        others.push(tree)
    }
    sources := orphan_git_lines(grep)
    loop path in orphan_git_lines(others) {
        if orphan_has_extension(path, ORPHAN_SOURCE_EXTENSIONS) -> sources.push(path)
    }
    sources
}

orphan_facts: fn(tracked: [String]) -> OrphanFacts {
    files := [String:Bool]{}
    folders := [String:Bool]{}
    loop path in tracked {
        files[path] = true
        segments: path.split("/").to_list()
        prefix := ""
        loop index in 0..<segments.len() - 1 {
            prefix = if index == 0 -> segments[0].copy() else -> "{prefix}/{segments[index]}"
            folders[prefix.copy()] = true
        }
    }
    OrphanFacts{files: files, folders: folders}
}

orphan_text: fn(tree: OrphanTree, path: String) -> String {
    if tree.texts.get(path) == .Val(text) -> return text.copy()
    orphan_files.read(path) ?? panic("read {path}: {err}")
}

// Bytes that end a word: blanks, quotes, brackets and separators.
orphan_delimiter: fn(byte: U8) -> Bool {
    byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 34 || byte == 39 || byte == 96 || byte == 44 || byte == 40 || byte == 41 || byte == 91 || byte == 93 || byte == 61 || byte == 59 || byte == 60 || byte == 62 || byte == 124
}

orphan_words: fn(text: String) -> [String] {
    raw: text.bytes()
    words := [String]{}
    start := -1
    loop index in 0..<raw.len() {
        if orphan_delimiter(raw[index]) {
            if start >= 0 -> words.push(policy_slice_raw(raw, start, index))
            start = -1
        } else if start < 0 { start = index }
    }
    if start >= 0 -> words.push(policy_slice_raw(raw, start, raw.len()))
    words
}

// The path `word` names from `base`, written relative to it, to the
// repository root or after `{root}/`, with any `{…}` part cut to the folder
// before it.
orphan_named: fn(word: String, base: String) -> String? {
    name := if word.ends_with(":") -> policy_slice_bytes(word, 0, word.bytes().len() - 1) else -> word.copy()
    rooted := base == ""
    if name.starts_with(ORPHAN_ROOT) {
        name = policy_slice_bytes(name, ORPHAN_ROOT.bytes().len(), name.bytes().len())
        rooted = true
    }
    if name.split_once("{{") == .Val(cut) {
        if !cut.before.contains("/") -> return None
        name = orphan_parent(cut.before)
    }
    if name == "" -> return None
    Val(if rooted -> orphan_normal(name) else -> orphan_normal("{base}/{name}"))
}

// The folder holding `path` ("" at the root).
orphan_parent: fn(path: String) -> String {
    segments := path.split("/").to_list()
    _ := segments.pop()
    segments.join("/")
}

// `path` with `.` and `..` segments resolved.
orphan_normal: fn(path: String) -> String {
    out := [String]{}
    loop segment in path.split("/") {
        if segment == "" || segment == "." -> next
        if segment == ".." && out.len() > 0 && out[out.len() - 1] != ".." {
            _ := out.pop()
            next
        }
        out.push(segment.copy())
    }
    out.join("/")
}

// The tracked file, or folder below a top tree of Tests/, that `word` names
// from the first base it resolves from.
orphan_resolve: fn(word: String, bases: [String], facts: OrphanFacts) -> String? {
    loop base in bases {
        path: orphan_named(word, base) ?? next
        if !path.starts_with("Tests/") -> next
        if facts.files.get(path) != None -> return Val(path)
        if path.split("/").to_list().len() >= 3 && facts.folders.get(path) != None {
            return Val(path)
        }
    }
    None
}

// A Tools program a case line names: the case runs it, so it is a runner.
orphan_tool: fn(word: String, facts: OrphanFacts) -> String? {
    name: if word.starts_with(ORPHAN_ROOT) -> policy_slice_bytes(word, ORPHAN_ROOT.bytes().len(), word.bytes().len()) else -> word.copy()
    if name.starts_with("Tools/") && name.ends_with(".jet") && facts.files.get(name) != None {
        return Val(name)
    }
    None
}

orphan_cover_words: fn(words: [String], bases: [String], facts: OrphanFacts, covered: &[String:Bool]) {
    loop word in words {
        if orphan_resolve(word, bases, facts) == .Val(path) -> covered[path] = true
    }
}

// The words of a runner source: a Jet file's or template's string literals
// outside comment lines, any other file's every word.
orphan_source_words: fn(path: String, text: String) -> [String] {
    if !(path.ends_with(".jet") || path.ends_with(".template")) -> return orphan_words(text)
    words := [String]{}
    loop line in text.split("\n") {
        if line.trim().starts_with("//") -> next
        segments: line.split("\"").to_list()
        loop index in 0..<segments.len() {
            if index % 2 == 1 {
                loop word in orphan_words(segments[index]) -> words.push(word)
            }
        }
    }
    words
}

orphan_is_covered: fn(path: String, covered: [String:Bool]) -> Bool {
    current := path.copy()
    loop current != "" {
        if covered.get(current) != None -> return true
        if !current.contains("/") -> return false
        current = orphan_parent(current)
    }
    false
}

// A folder's README documents its fixtures and is no fixture itself.
ORPHAN_README: "README.md"

// A file the guard asks a reader for: a test source, a case, or a file other
// than a README in a fixture folder under Tests/.
orphan_candidate: fn(path: String) -> Bool {
    if !path.starts_with("Tests/") -> return false
    if path.ends_with(".jet") || path.ends_with(".case") -> return true
    segments: path.split("/").to_list()
    if segments[segments.len() - 1] == ORPHAN_README -> return false
    loop index in 0..<segments.len() - 1 {
        folder: segments[index]
        if folder == "Fixtures" || folder == "Input" || folder.ends_with(".fixture") -> return true
    }
    false
}

orphan_has_extension: fn(path: String, extensions: [String]) -> Bool {
    loop extension in extensions {
        if path.ends_with(extension) -> return true
    }
    false
}

orphan_data: fn(path: String) -> Bool {
    path.starts_with("Tests/") && orphan_has_extension(path, ORPHAN_DATA_EXTENSIONS)
}

// Every candidate under Tests/ no runner reads, sorted.
orphan_findings: fn(tree: OrphanTree) -> [String] {
    facts: orphan_facts(tree.tracked)
    covered := [String:Bool]{}
    loop corpus in ORPHAN_CORPORA -> covered[corpus.root.copy()] = true
    runners := [String]{}
    loop path in tree.sources {
        if path == ORPHAN_SELF || path.ends_with(".case") -> next
        case_data: path.starts_with("Tests/Cases/") && !orphan_has_extension(path, ORPHAN_CASE_SOURCE_EXTENSIONS)
        if case_data -> next
        runners.push(path.copy())
    }
    loop path in tree.tracked {
        if !path.ends_with(".case") || !(path.starts_with("Tests/") || path.starts_with("Examples/")) {
            next
        }
        if path.starts_with("Tests/Cases/") -> covered[path.copy()] = true
        bases: [String]{orphan_parent(path), ""}
        loop line in orphan_text(tree, path).split("\n") {
            if line.trim().starts_with("#") -> next
            words: orphan_words(line)
            orphan_cover_words(words, bases, facts, covered)
            loop word in words {
                if orphan_tool(word, facts) == .Val(tool) && !runners.contains(tool) {
                    runners.push(tool)
                }
            }
        }
    }
    loop path in runners {
        orphan_cover_words(orphan_source_words(path, orphan_text(tree, path)), [String]{"", orphan_parent(path)}, facts, covered)
    }
    // A data file a reader names by file is a reader in turn.
    read := [String:Bool]{}
    changed := true
    loop changed {
        changed = false
        loop path in tree.tracked {
            if read.get(path) != None || covered.get(path) == None || !orphan_data(path) -> next
            read[path.copy()] = true
            changed = true
            orphan_cover_words(orphan_words(orphan_text(tree, path)), [String]{orphan_parent(path), ""}, facts, covered)
        }
    }
    findings := [String]{}
    loop path in tree.tracked {
        if orphan_candidate(path) && !orphan_is_covered(path, covered) -> findings.push(path.copy())
    }
    findings.sort()
    findings
}

#Test("orphan_tests: every test source and fixture under Tests/ is read by a runner") {
    guards_enter_root()
    findings: orphan_findings(OrphanTree{tracked: orphan_tracked(), sources: orphan_sources(), texts: [String:String]{}})
    assert(findings.len() == 0, "{findings.len()} files under Tests/ are read by no runner; give each to the runner its test belongs to, or delete it:\n{findings.join("\n")}")
}

#Test("orphan_tests: the guard names a planted orphan and keeps what a runner reads") {
    tracked: [String]{
        "Compiler/Thing/Tests/Reads.jet",
        "Tests/Cases/Topic/kept.case",
        "Tests/Cases/Topic/kept.out",
        "Tests/Cases/Topic/read.template",
        "Tests/Cases/Topic/Kept.fixture/run.jet",
        "Tests/Cases/Topic/Stray.fixture/run.jet",
        "Tests/Fixtures/Commented/run.jet",
        "Tests/Fixtures/Documented/README.md",
        "Tests/Fixtures/Golden/expected.golden",
        "Tests/Fixtures/Named/run.jet",
        "Tests/Fixtures/Printed/expected.golden",
        "Tests/Fixtures/Templated/a.jet",
        "Tests/Fixtures/orphan.jet",
        "Tests/UI/walked.jet",
        "Tests/Workloads/Fixtures/listed.jet",
        "Tests/Workloads/manifest.tsv",
    }
    texts: [String:String]{
        "Tests/Cases/Topic/kept.case": "# Tests/Fixtures/orphan.jet, named in a comment only\nfixture: Kept.fixture\ncopy: {{root}}/Tests/Workloads/manifest.tsv manifest.tsv\nwrite: run.jet read.template\nstdout: = kept.out\n",
        "Tests/Cases/Topic/kept.out": "Tests/Fixtures/Printed/expected.golden\n",
        "Tests/Cases/Topic/read.template": "run: fn() {{\n    print(testing.golden(\"{{root}}/Tests/Fixtures/Golden/expected.golden\", \"expected\\n\"))\n}}\n",
        "Tests/Workloads/manifest.tsv": "task\tFixtures/listed.jet\n",
        "Compiler/Thing/Tests/Reads.jet": "// Tests/Fixtures/Commented/run.jet\nread: fn() {{\n    files.read(\"Tests/Fixtures/Named/run.jet\")\n    files.read(\"Tests/Fixtures/Templated/{{name}}.jet\")\n    files.read(\"Tests\")\n}}\n",
    }
    sources: [String]{"Compiler/Thing/Tests/Reads.jet", "Tests/Cases/Topic/kept.case", "Tests/Cases/Topic/kept.out", "Tests/Cases/Topic/read.template"}
    findings: orphan_findings(OrphanTree{tracked: tracked, sources: sources, texts: texts})
    assert_eq(findings.join("\n"), "Tests/Cases/Topic/Stray.fixture/run.jet\nTests/Fixtures/Commented/run.jet\nTests/Fixtures/Printed/expected.golden\nTests/Fixtures/orphan.jet")
}
