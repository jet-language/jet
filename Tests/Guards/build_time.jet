use build_time_guard_files: core.files

// A stop through build_time_refused (JetFoundation BuildTime.jet) is a static
// assertion on jet's own build, so only `#run` constant initializers and tests
// may reach a function that calls it. This guard walks back from the helper
// over every Jet source under Compiler. A function that names a caller is a
// caller too. Each other reference is allowed only from a `#run`
// initializer, a `#Test` block, a Tests folder or a `use` list; any other
// reference is run-time code and fails with its path and line, and so does a
// caller that nothing names, which could be an entry point. A reference
// counts by name, so a call, a function value and a same-named function
// elsewhere all count, which errs toward failing.
BUILD_TIME_GUARD_ROOT: "Compiler"

BUILD_TIME_GUARD_HELPER: "build_time_refused"

BuildTimeGuardSource: struct {
    path: String,
    text: String,
}

build_time_guard_ident_byte: fn(byte: Int) -> Bool {
    (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) || byte == 95
}

// The leading name of a top-level line, `name` in `name: …`, or "".
build_time_guard_item_name: fn(line: String) -> String {
    bytes: line.bytes()
    end := 0
    loop end < bytes.len() && build_time_guard_ident_byte(Int{bytes[end]}) -> end += 1
    colon: end > 0 && end < bytes.len() && Int{bytes[end]} == 58
    if !colon -> return ""
    line.slice(0, end)
}

// The item each line of `text` belongs to: `fn:NAME`, `run:NAME`, `test`,
// `use`, or `other:…` for any other top-level item. A line at column zero
// opens an item; an indented, blank, closing, comment or marker line stays in
// the item above it.
build_time_guard_contexts: fn(text: String) -> [String] {
    contexts := [String]{}
    current := "use"
    loop line in text.split("\n") {
        opens: line != "" && !line.starts_with(" ") && !line.starts_with("\t") && !line.starts_with("}}") && !line.starts_with(")") && !line.starts_with("]") && !line.starts_with("//")
        if opens {
            if line.starts_with("#Test(") {
                current = "test"
            } else if line.starts_with("use ") || line.starts_with("use{{") {
                current = "use"
            } else if !line.starts_with("#") {
                name: build_time_guard_item_name(line)
                rest: if name == "" -> "" else -> line.slice(name.count_bytes() + 1, line.count_bytes()).trim()
                current = if name == "" -> "other:{line.trim()}" else if rest.starts_with("fn(") || rest.starts_with("fn<") -> "fn:{name}" else if rest.starts_with("#run") -> "run:{name}" else -> "other:{name}"
            }
        }
        contexts.push(current.copy())
    }
    contexts
}

// Whether code in `line`, outside a whole-line comment, names `name` as a
// whole word.
build_time_guard_names: fn(line: String, name: String) -> Bool {
    if !line.contains(name) || line.trim_start().starts_with("//") -> return false
    raw: line.bytes()
    width: name.count_bytes()
    offset := 0
    loop {
        index: build_time_guard_find(line, name, offset)
        if index < 0 -> return false
        offset = index + width
        before: index > 0 && build_time_guard_ident_byte(Int{raw[index - 1]})
        after: offset < raw.len() && build_time_guard_ident_byte(Int{raw[offset]})
        if !before && !after -> return true
    }
    false
}

// The byte offset of `needle` in `text` at or after `start`, or -1.
build_time_guard_find: fn(text: String, needle: String, start: Int) -> Int {
    hay: text.bytes()
    want: needle.bytes()
    if want.len() == 0 -> return -1
    at := start
    loop at + want.len() <= hay.len() {
        if hay[at] == want[0] {
            k := 1
            loop k < want.len() && hay[at + k] == want[k] -> k += 1
            if k == want.len() -> return at
        }
        at += 1
    }
    -1
}

// Every `.jet` file under `path`.
build_time_guard_collect: fn(path: String, sources: ^[BuildTimeGuardSource]) {
    kind: build_time_guard_files.stat(path) ?? return
    if kind.is_symlink -> return
    if !kind.is_dir {
        if path.ends_with(".jet") -> sources.push(BuildTimeGuardSource{path: path.copy(), text: build_time_guard_files.read(path) ?? panic("read {path}: {err}")})
        return
    }
    loop child in (build_time_guard_files.list_dir(path) ?? panic("list {path}: {err}")) {
        if child.name.starts_with(".") || child.name == "target" || child.name == "build" || child.name == "node_modules" -> next
        build_time_guard_collect("{path}/{child.name}", sources)
    }
}

// The references to the helper and its callers, followed back through
// `sources`, that come from run-time code; `reached` collects the callers.
build_time_guard_problems: fn(sources: [BuildTimeGuardSource], reached: ^[String]) -> [String] {
    problems := [String]{}
    queue := [String]{BUILD_TIME_GUARD_HELPER}
    seen := [String]{BUILD_TIME_GUARD_HELPER}
    at := 0
    loop at < queue.len() {
        name: queue[at].copy()
        at += 1
        named := false
        loop source in sources {
            if !source.text.contains(name) -> next
            tested: source.path.contains("/Tests/")
            contexts: build_time_guard_contexts(source.text)
            lines: source.text.split("\n").to_list()
            loop index in 0..<lines.len() {
                line: lines[index]
                if !build_time_guard_names(line, name) -> next
                context: contexts[index]
                if context == ("fn:{name}") -> next
                named = true
                if tested || context == "test" || context == "use" || context.starts_with("run:") -> next
                if context.starts_with("fn:") {
                    caller: context.slice(3, context.count_bytes())
                    if !seen.contains(caller) {
                        seen.push(caller.copy())
                        queue.push(caller.copy())
                        reached.push(caller.copy())
                    }
                    next
                }
                problems.push("{source.path}:{index + 1}: `{name}` reaches {BUILD_TIME_GUARD_HELPER}, but run-time code ({context}) names it; only `#run` initializers and tests may reach it")
            }
        }
        if !named && name != BUILD_TIME_GUARD_HELPER {
            problems.push("`{name}` reaches {BUILD_TIME_GUARD_HELPER}, but nothing names it, so it may be an entry point; only `#run` initializers and tests may reach it")
        }
    }
    problems
}

#Test("only `#run` initializers and tests reach build_time_refused") {
    guards_enter_root()
    sources := [BuildTimeGuardSource]{}
    build_time_guard_collect(BUILD_TIME_GUARD_ROOT, sources)
    reached := [String]{}
    problems: build_time_guard_problems(sources, reached)
    assert(reached.len() > 0, "no function calls {BUILD_TIME_GUARD_HELPER}, so the guard checks nothing")
    assert_eq(problems.join("\n"), "")
}

BUILD_TIME_GUARD_SAMPLE: "use x.[build_time_refused]\n\nrows: fn(text: String) -> Int {{\n    if text == \"\" -> build_time_refused(\"empty\")\n    1\n}}\n\nROWS: #run rows(\"a\")\n\nhelper: fn() -> Int {{ rows(\"b\") }}\n\nlive: fn() -> Int {{\n    // rows(\"c\") in a comment\n    myrows(\"d\")\n}}\n"

#Test("a caller reached from run-time code fails, and `#run` and tests may reach it") {
    sources: [BuildTimeGuardSource]{
        BuildTimeGuardSource{path: "Compiler/A/Source/A.jet", text: BUILD_TIME_GUARD_SAMPLE},
        BuildTimeGuardSource{path: "Compiler/A/Tests/A.jet", text: "t: fn() {{ helper() }}\n"},
    }
    reached := [String]{}
    assert_eq(build_time_guard_problems(sources, reached).join("\n"), "")
    assert_eq(reached, [String]{"rows", "helper"})
    late: [BuildTimeGuardSource]{
        BuildTimeGuardSource{path: "Compiler/A/Source/A.jet", text: BUILD_TIME_GUARD_SAMPLE},
        BuildTimeGuardSource{path: "Compiler/B/Source/B.jet", text: "Late: struct {{\n    n: Int,\n}}\n\nrun_late: fn() -> Int {{ helper() }}\n\nimpl Late {{\n    m: fn(self) -> Int {{ rows(\"e\") }}\n}}\n"},
    }
    reached_late := [String]{}
    assert_eq(build_time_guard_problems(late, reached_late).join("\n"), "Compiler/B/Source/B.jet:8: `rows` reaches build_time_refused, but run-time code (other:impl Late {{) names it; only `#run` initializers and tests may reach it\n`run_late` reaches build_time_refused, but nothing names it, so it may be an entry point; only `#run` initializers and tests may reach it")
    assert_eq(reached_late, [String]{"rows", "helper", "run_late"})
}
