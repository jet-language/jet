// Core.rows's declarations, read the way the compiler build reads them, pass
// every check against the checkout's Core sources
// (jet_foundation's core_declarations_source_problems). jet embeds the Core
// sources without checking them (Compiler/JetCLI/Source/CLI/CoreSources.jet),
// so this guard, which runs on every commit, is where a Core source that
// disagrees with its declarations is refused.
use {
    jet_foundation.[
        CORE_CALLS,
        CORE_DECLARATIONS,
        CORE_DECLARATIONS_CORE_PATH,
        CORE_DECLARATIONS_ENCODING_PATH,
        CORE_DECLARATIONS_PARTS_PATH,
        CORE_DECLARATIONS_RUNTIME_FILES,
        CORE_DECLARATIONS_SYNTAX_FILES,
        CoreDeclarationError,
        CoreDeclarationFile,
        CoreDeclarations,
        EFFECT_VOCABULARY_ROOTS,
        EFFECT_VOCABULARY_ROWS,
        JET_TEST_SETTINGS,
        core_declarations_read,
        core_declarations_source_problems,
        core_decl_lang_type_problem,
        core_decl_mem_problem,
        core_decl_mem_tier_problem,
        core_decl_syntax_constants,
        core_enum_payload_variants,
        core_enum_variant_payload,
    ]
    corpus_manifest.[guards_enter_root]
    core_guard_files: core.files
}

// Core.rows's declarations as the checkout has them, read with the build's
// other inputs.
core_guard_declared: fn() -[FS]> CoreDeclarations CoreDeclarationError! {
    source: core_guard_files.read(CORE_DECLARATIONS_CORE_PATH) ?? panic("{CORE_DECLARATIONS_CORE_PATH} did not read")
    parts: core_guard_files.read(CORE_DECLARATIONS_PARTS_PATH) ?? panic("{CORE_DECLARATIONS_PARTS_PATH} did not read")
    core_declarations_read(source, parts, CORE_DECLARATIONS_SYNTAX_FILES, CORE_DECLARATIONS_RUNTIME_FILES, EFFECT_VOCABULARY_ROWS)
}

// The text of every source `declared` names (its source rows and parts, and
// the encoding source), as the checkout has it.
core_guard_sources: fn(declared: CoreDeclarations) -[FS]> [CoreDeclarationFile] {
    ^paths: [String]{}
    loop row in declared.source_rows {
        if !paths.contains(row.path) -> paths.push(row.path.copy())
    }
    loop part in declared.parts {
        if !paths.contains(part.path) -> paths.push(part.path.copy())
    }
    if !paths.contains(CORE_DECLARATIONS_ENCODING_PATH) {
        paths.push(CORE_DECLARATIONS_ENCODING_PATH)
    }
    loop path in paths -> CoreDeclarationFile{path: path.copy(), text: core_guard_files.read(path) ?? panic("{path} did not read")}
}

#Test("the declarations the build reads pass every check against the checkout") {
    guards_enter_root()
    declared: core_guard_declared() ?? panic("Core.rows was refused: {err.message}")
    assert_eq(CORE_CALLS.len(), 0)
    sources: core_guard_sources(declared)
    assert_eq(core_declarations_source_problems(declared, sources).join("\n"), "")
    constants: core_decl_syntax_constants(CORE_DECLARATIONS_SYNTAX_FILES) ?? panic("the Syntax constants did not read: {err.message}")
    assert_eq(core_decl_mem_problem(CORE_DECLARATIONS, CORE_DECLARATIONS_SYNTAX_FILES, constants) ?? panic("the core.mem tiers did not read: {err.message}"), "")
    assert_eq(core_decl_mem_tier_problem(declared, CORE_DECLARATIONS_SYNTAX_FILES, sources) ?? panic("the core.mem tiers did not read: {err.message}"), "")
    assert_eq(core_decl_lang_type_problem(CORE_DECLARATIONS, "Effect", EFFECT_VOCABULARY_ROOTS, "the effect vocabulary's roots"), "")
    assert(core_decl_lang_type_problem(CORE_DECLARATIONS, "Effect", [String]{"Net", "Rand"}, "the effect vocabulary's roots").ends_with("; write `Effect:plain(Net|Rand)`"))
    assert(core_decl_lang_type_problem(CORE_DECLARATIONS, "SideEffect", [String]{"C"}, "the cases").contains("has no `SideEffect:plain(…)` type"))
}

#Test("Core.rows has zero dispatcher_row lines and refuses any") {
    guards_enter_root()
    source: core_guard_files.read(CORE_DECLARATIONS_CORE_PATH) ?? panic("{CORE_DECLARATIONS_CORE_PATH} did not read")
    parts: core_guard_files.read(CORE_DECLARATIONS_PARTS_PATH) ?? panic("{CORE_DECLARATIONS_PARTS_PATH} did not read")
    ^dispatcher_lines: [String]{}
    loop line in source.lines() {
        trimmed: line.trim()
        if trimmed.starts_with("dispatcher_row ") || trimmed == "dispatcher_row" {
            dispatcher_lines.push(trimmed.copy())
        }
    }
    assert(dispatcher_lines.len() == 0, "{CORE_DECLARATIONS_CORE_PATH} must have 0 dispatcher_row lines, found: {dispatcher_lines.join("\n")}")
    assert_eq(CORE_CALLS.len(), 0)
    injected: "{source}\ndispatcher_row plain core.term take | CoreCallRecord.source_owned(\"core.term\", \"take\", &[false])\n"
    if core_declarations_read(injected, parts, CORE_DECLARATIONS_SYNTAX_FILES, CORE_DECLARATIONS_RUNTIME_FILES, EFFECT_VOCABULARY_ROWS) == {
        .Ok(_) -> panic("Core.rows accepted a retired dispatcher_row line")
        .Err(error) -> assert(error.message.contains("unrecognized Core declaration: dispatcher_row"))
    }
}

// test.jet's `t.<setting>(…)` calls are core.testing's `impl Test` methods:
// one per `jet test` setting row (JET_TEST_SETTINGS), each writing its own
// row's name to the plan.
#Test("core.testing's Test has one method per jet test setting row") {
    guards_enter_root()
    source: core_guard_files.read("Core/Testing/Testing.jet") ?? ""
    ^missing: ""
    loop row in JET_TEST_SETTINGS {
        if !source.contains("\n    {row.name}: fn(self") || !source.contains("test_setting(self, \"{row.name}\", ") {
            missing = "{missing} {row.name}"
        }
    }
    assert_eq(missing, "")
}

#Test("an enum list carries its payloads into the Core enum payload rows") {
    guards_enter_root()
    declared: core_guard_declared() ?? panic("Core.rows was refused: {err.message}")
    ^payloads: [String]{}
    loop entry in declared.modules {
        if entry.name != "core.term" -> next
        loop leaf in entry.types {
            if leaf.name != "Key" -> next
            loop (at, variant) in leaf.variants {
                if leaf.payloads[at] != "" -> payloads.push("{variant}({leaf.payloads[at]})")
            }
        }
    }
    assert_eq(payloads.join("|"), "Char(Char)|F(Int)|Ctrl(Char)")
    assert_eq((core_enum_payload_variants("Key") ?? [String]{}).len(), 23)
    assert_eq((core_enum_variant_payload("DataEvent", "Bytes") ?? panic("DataEvent.Bytes has no payload row")).len(), 1)
    assert_eq((core_enum_variant_payload("Key", "Enter") ?? panic("Key.Enter has no payload row")).len(), 0)
    source: core_guard_files.read(CORE_DECLARATIONS_CORE_PATH) ?? panic("{CORE_DECLARATIONS_CORE_PATH} did not read")
    parts: core_guard_files.read(CORE_DECLARATIONS_PARTS_PATH) ?? panic("{CORE_DECLARATIONS_PARTS_PATH} did not read")
    qualified: source.replace("|F(Int)|", "|F(term.Int)|")
    if core_declarations_read(qualified, parts, CORE_DECLARATIONS_SYNTAX_FILES, CORE_DECLARATIONS_RUNTIME_FILES, EFFECT_VOCABULARY_ROWS) == {
        .Ok(_) -> { panic("a qualified payload in a Core.rows list was read") }
        .Err(error) -> {
            assert(error.message.contains("invalid payload of Core enum case `F(term.Int)`"))
        }
    }
}

#Test("a core.mem item whose declaration disagrees with its gate tier is named") {
    guards_enter_root()
    declared: core_guard_declared() ?? panic("Core.rows was refused: {err.message}")
    // `from_addr` is tiered Audit but declared plain; `stream_store` is
    // tiered Import but declared `#Unsafe`.
    drifted: [CoreDeclarationFile]{
        CoreDeclarationFile{
            path: "Core/Mem/Mem.jet",
            text: "from_addr: fn<T>(addr: Int) -> *T Never!\n#Unsafe(\"a reason\") stream_store: fn<T>(dst: ^T, value: T) Never!\n",
        },
    }
    problem: core_decl_mem_tier_problem(declared, CORE_DECLARATIONS_SYNTAX_FILES, drifted) ?? panic("the core.mem tiers did not read: {err.message}")
    assert(problem.contains("not tiered Audit=stream_store"))
    assert(problem.contains(",from_addr,"))
    assert(!problem.contains("address_of"))
}

#Test("every Compiler/JetBackend/Source/*ABI.jet is generated from the Core declarations") {
    guards_enter_root()
    entries: core_guard_files.list_dir("Compiler/JetBackend/Source") ?? panic("list Compiler/JetBackend/Source: {err}")
    ^generated: [String]{}
    ^hand: [String]{}
    loop entry in entries {
        if !entry.name.ends_with("ABI.jet") -> next
        text: core_guard_files.read(entry.path) ?? panic("{entry.path} did not read")
        if text.starts_with("// Generated by Tools/Agent/") {
            generated.push(entry.name.copy())
        } else {
            hand.push(entry.path.copy())
        }
    }
    assert_eq(hand.join("\n"), "")
    assert(generated.contains("CoreLayoutABI.jet"))
    assert(generated.contains("CoreEnumABI.jet"))
}

#Test("core.time Civil and Period checked methods keep one Core method identity") {
    guards_enter_root()
    time_src: core_guard_files.read("Core/Time/Time.jet") ?? panic("Core/Time/Time.jet did not read")
    // Each checked Civil/Period method has one body in Core/Time/Time.jet.
    required: [String]{
        "LocalDate: struct {{",
        "LocalTime: struct {{",
        "DateTime: struct {{",
        "ZonedDateTime: struct {{",
        "Period: struct {{",
        "    add_period: fn(self, value: Period) -> LocalDate Never! {{",
        "    add_period: fn(self, value: Period) -> DateTime Never! {{",
        "    add_period: fn(self, value: Period) -> ZonedDateTime Never! {{",
        "    total_in: fn(self, unit: String, anchor: DateTime | LocalDate) -> Float Never! {{",
    }
    loop needle in required {
        assert(time_src.contains(needle), "Core/Time/Time.jet missing canonical Civil/Period declaration: {needle}")
    }
    // No duplicate JetDate/JetDateTime/JetPeriod method lowering in JetSema or JetIR outside RuntimeRoutes.jet.
    forbid: [String]{"JetDate.", "JetDateTime.", "JetPeriod.", "JetLocalTime.", "JetZonedDateTime."}
    for_dirs: [String]{"Compiler/JetSema/Source", "Compiler/JetIR/Source"}
    loop dir in for_dirs {
        entries: core_guard_files.walk_files(dir) ?? panic("walk {dir}: {err}")
        loop raw in entries {
            entry: raw ?? next
            if !entry.path.ends_with(".jet") || entry.path.ends_with("RuntimeRoutes.jet") -> next
            text: core_guard_files.read(entry.path) ?? next
            loop sym in forbid {
                assert(!text.contains(sym), "duplicate Civil/Period lowering identity `{sym}` in {entry.path}")
            }
        }
    }
}

