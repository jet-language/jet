use generated_reasons_files: core.files

// Every committed generated copy says why it is committed rather than
// computed while building. A file is a generated copy when its first three
// lines name its generator (`generated by`) and forbid editing it (`do not
// edit` or `do not hand-edit`). Its first eight lines then give the reason
// with `stays committed`. A generated tree gives its reason once instead: a
// GENERATED marker file in the tree's root directory names the generator and
// says why it stays committed, and covers every generated file under that
// directory.
GENERATED_REASONS_ROOTS: [String]{"Compiler", "Core", "Jetpack", "Tests", "Docs/Site"}

GENERATED_REASONS_MARKER: "GENERATED"

GENERATED_REASONS_PHRASE: "stays committed"

// The first eight lines fit in this many bytes.
GENERATED_REASONS_HEADER_BYTES: 2048

// The words of the first `count` lines of `text`, lowercased and joined by
// single spaces, without the comment markers that open or close a line.
generated_reasons_head: fn(text: String, count: Int) -> String {
    words := [String]{}
    loop (index, line) in text.lines() {
        if index == count -> break
        loop word in line.to_lower().words() {
            if word == "//" || word == "///" || word == "#" || word == "*" || word == "<!--" || word == "-->" -> next
            words.push(word)
        }
    }
    words.join(" ")
}

// Whether `text` opens as a generated copy.
generated_reasons_generated: fn(text: String) -> Bool {
    head: generated_reasons_head(text, 3)
    head.contains("generated by") && (head.contains("do not edit") || head.contains("do not hand-edit"))
}

// Whether `text` gives its reason in its own header.
generated_reasons_reasoned: fn(text: String) -> Bool {
    generated_reasons_head(text, 8).contains(GENERATED_REASONS_PHRASE)
}

// The problem with a GENERATED marker's `text` at `path`, or "".
generated_reasons_marker_problem: fn(path: String, text: String) -> String {
    if !generated_reasons_head(text, 3).contains("generated by") -> return "{path}: a {GENERATED_REASONS_MARKER} marker names the generator of its tree with `Generated by`"
    if !generated_reasons_reasoned(text) -> return "{path}: a {GENERATED_REASONS_MARKER} marker says why its tree {GENERATED_REASONS_PHRASE}"
    ""
}

// The generated copies under `path` that give no reason, and the markers that
// fail; `covered` is whether a marker above `path` gives the reason.
generated_reasons_scan: fn(path: String, covered: Bool, problems: ^[String]) {
    kind: generated_reasons_files.stat(path) ?? return
    if kind.is_symlink -> return
    if !kind.is_dir {
        if covered -> return
        bytes: generated_reasons_files.read_at(path, 0, GENERATED_REASONS_HEADER_BYTES) ?? panic("read {path}: {err}")
        text: String.from_bytes_lossy(bytes)
        if generated_reasons_generated(text) && !generated_reasons_reasoned(text) {
            problems.push("{path}: a generated copy says why it {GENERATED_REASONS_PHRASE} in its first eight lines, or its tree's {GENERATED_REASONS_MARKER} marker does")
        }
        return
    }
    marker: "{path}/{GENERATED_REASONS_MARKER}"
    marked := covered
    if generated_reasons_files.exists(marker) {
        problem: generated_reasons_marker_problem(marker, generated_reasons_files.read(marker) ?? panic("read {marker}: {err}"))
        if problem != "" -> problems.push(problem) else -> marked = true
    }
    loop child in (generated_reasons_files.list_dir(path) ?? panic("list {path}: {err}")) {
        if child.name.starts_with(".") || child.name == "target" || child.name == "build" || child.name == "node_modules" -> next
        if child.name == GENERATED_REASONS_MARKER -> next
        generated_reasons_scan("{path}/{child.name}", marked, problems)
    }
}

#Test("every committed generated copy says why it stays committed, in its header or its tree's marker") {
    guards_enter_root()
    problems := [String]{}
    loop root in GENERATED_REASONS_ROOTS {
        assert(generated_reasons_files.is_dir(root), "the generated-reasons root {root} must exist")
        generated_reasons_scan(root, false, problems)
    }
    problems.sort()
    assert_eq(problems.join("\n"), "")
}

#Test("a generated copy is known by its header, and a reason may span its comment lines") {
    assert(generated_reasons_generated("// Generated by Tools/Agent/X.jet; do not edit.\nA: 1\n"))
    assert(generated_reasons_generated("<!-- Generated by Tools/Agent/X.jet; do not edit. -->\n<p>x</p>\n"))
    assert(generated_reasons_generated("// The codec, generated by X; do not\n// edit.\n"))
    assert(generated_reasons_generated("# Generated by `node X.mjs`; do not hand-edit.\n"))
    assert(!generated_reasons_generated("// Generated views must be derived from this file. Do not hand-edit\n"))
    assert(!generated_reasons_generated("// Pinned from rustc; do not hand-edit.\n"))
    assert(!generated_reasons_generated("a\nb\nc\n// Generated by X; do not edit.\n"))
    assert(generated_reasons_reasoned("// Generated by X; do not edit.\n// It stays\n// committed: the seed reads it.\n"))
    assert(!generated_reasons_reasoned("// Generated by X; do not edit.\n2\n3\n4\n5\n6\n7\n8\n// It stays committed: late.\n"))
}

#Test("a tree's marker names its generator and says why the tree stays committed") {
    assert_eq(generated_reasons_marker_problem("e/GENERATED", "Generated by X; do not edit.\nEvery page here stays committed: the site serves it.\n"), "")
    assert_eq(generated_reasons_marker_problem("e/GENERATED", "Every page here stays committed.\n"), "e/GENERATED: a GENERATED marker names the generator of its tree with `Generated by`")
    assert_eq(generated_reasons_marker_problem("e/GENERATED", "Generated by X; do not edit.\n"), "e/GENERATED: a GENERATED marker says why its tree stays committed")
}
