// The memory kernel's single home. Core's kernel file (Core/Mem/Mem.jet, the
// `Mem` entry of Core's `policy.memory`) declares each raw memory primitive
// exactly once, with its precondition stated in the `#Unsafe` gate it opens.
// No other compiler, Core or Jetpack source declares one of those names, every
// `.Kernel([...])` a shipped package names is a real file or folder, and the
// unsafe ratchet's count of raw memory regions outside a kernel stays zero, so
// E3113 holds everywhere a package does not name the file.
use mksh_files: core.files

MKSH_KERNEL: "Core/Mem/Mem.jet"

MKSH_ROOTS: [String]{"Compiler", "Core", "Jetpack"}

MKSH_SKIPPED: [String]{"Tests", ".jet", "target", "node_modules"}

MkshPrimitive: struct {
    name: String,
    action: String,
    // False for a name some unrelated Core function or method also takes
    // (`copy`, `fill`, `window`): only its home is checked, not its absence
    // elsewhere.
    unique: Bool,
}

MKSH_PRIMITIVES: [MkshPrimitive]{
    MkshPrimitive{name: "alloc_raw", action: "allocate", unique: true},
    MkshPrimitive{name: "free_raw", action: "free", unique: true},
    MkshPrimitive{name: "from_addr", action: "raw read or write", unique: true},
    MkshPrimitive{name: "volatile_read", action: "raw read", unique: true},
    MkshPrimitive{name: "volatile_write", action: "raw write", unique: true},
    MkshPrimitive{name: "__ptr_offset", action: "pointer offset", unique: true},
    MkshPrimitive{name: "__ptr_byte_offset", action: "pointer offset", unique: true},
    MkshPrimitive{name: "copy", action: "byte copy or move", unique: false},
    MkshPrimitive{name: "list_copy", action: "byte copy or move", unique: true},
    MkshPrimitive{name: "list_append", action: "byte copy or move", unique: true},
    MkshPrimitive{name: "fill", action: "fill", unique: false},
    MkshPrimitive{name: "__region_reserve", action: "OS mapping", unique: true},
    MkshPrimitive{name: "__region_release", action: "OS mapping", unique: true},
    MkshPrimitive{name: "mapped", action: "OS mapping", unique: true},
    MkshPrimitive{name: "unmapping", action: "OS mapping", unique: true},
    MkshPrimitive{name: "window", action: "view over raw memory", unique: false},
    MkshPrimitive{name: "__view_from_raw", action: "view over raw memory", unique: true},
}

// Whether `line` declares a top-level function `name`: the line starts at
// column 0 and `name: fn` follows the line start or the gate before it.
mksh_declares: fn(line: String, name: String) -> Bool Never! {
    if line.starts_with(" ") || line.starts_with("\t") || line.starts_with("//") -> return false
    line.starts_with("{name}: fn") || line.contains(" {name}: fn") || line.contains("){name}: fn")
}

mksh_walk: fn(path: String, out: &[String]) {
    if !mksh_files.is_dir(path) {
        if path.ends_with(".jet") -> out.push(path.copy())
        return
    }
    loop child in (mksh_files.list_dir(path) ?? panic("list {path}: {err}")) {
        skipped := false
        loop name in MKSH_SKIPPED {
            if child.name == name -> skipped = true
        }
        if !skipped -> mksh_walk(child.path, out)
    }
}

// The entries of a manifest's `memory: .Kernel([...])`, in written order.
mksh_kernel_entries: fn(manifest: String) -> [String] Never! {
    entries := [String]{}
    parts: manifest.split("memory: .Kernel([").to_list()
    if parts.len() < 2 -> return entries
    list: parts[1].split("])").to_list()[0].to_string()
    loop item in list.split(",") {
        entry := item.trim()
        if entry.starts_with("\"") && entry.ends_with("\"") && entry.len() >= 2 {
            entry = entry.slice(1, entry.len() - 1)
        }
        if entry.len() > 0 -> entries.push(entry)
    }
    entries
}

// The markers a declaration at `lines[index]` carries, as one text with the
// line breaks and indentation gone: the declaration line itself, where a
// marker may lead, and the marker lines right above it: `#…` lines, a
// wrapped group's inner lines and its closing `]` or `)`. A gate reads the
// same however its markers are laid out.
mksh_gate: fn(lines: [String], index: Int) -> String Never! {
    gate := lines[index].trim()
    above := index - 1
    loop above >= 0 {
        line: lines[above]
        marker: line.starts_with("#") || line.starts_with(" ") || line.starts_with("\t") || line.starts_with("]") || line.starts_with(")")
        if !marker -> break
        gate = "{line.trim()}{gate}"
        above -= 1
    }
    gate
}

// The kernel declarations of `source`, one finding per primitive that is not
// declared exactly once or whose declaration states no precondition.
mksh_home_findings: fn(source: String) -> [String] Never! {
    findings := [String]{}
    lines: source.split("\n").to_list()
    loop primitive in MKSH_PRIMITIVES {
        count := 0
        gated := false
        loop index in 0..<lines.len() {
            if !mksh_declares(lines[index], primitive.name) -> next
            count += 1
            if mksh_gate(lines, index).contains("Unsafe(\"") -> gated = true
        }
        if count != 1 {
            findings.push("{MKSH_KERNEL}: `{primitive.name}` ({primitive.action}) is declared {count} times; the kernel declares each primitive once")
        }
        if count == 1 && !gated {
            findings.push("{MKSH_KERNEL}: `{primitive.name}` ({primitive.action}) states no precondition; declare it behind `#Unsafe(\"…\")`")
        }
    }
    findings
}

#Test("the memory kernel declares each raw memory primitive once, with its precondition") {
    guards_enter_root()
    source: mksh_files.read(MKSH_KERNEL) ?? panic("read {MKSH_KERNEL}: {err}")
    assert_eq(mksh_home_findings(source).join("\n"), "")
    core: mksh_files.read("Core/package.jet") ?? panic("read Core/package.jet: {err}")
    assert(mksh_kernel_entries(core).contains("Mem"), "Core's policy.memory must name its kernel folder `Mem`")
}

#Test("no source outside the memory kernel declares a raw memory primitive") {
    guards_enter_root()
    sources := [String]{}
    loop root in MKSH_ROOTS -> mksh_walk(root, sources)
    assert(sources.len() > 1000, "the walk found only {sources.len()} Jet sources")
    findings := [String]{}
    loop path in sources {
        if path == MKSH_KERNEL -> next
        source: mksh_files.read(path) ?? panic("read {path}: {err}")
        loop line in source.lines() {
            loop primitive in MKSH_PRIMITIVES {
                if primitive.unique && mksh_declares(line, primitive.name) {
                    findings.push("{path}: declares `{primitive.name}`, a primitive whose one home is {MKSH_KERNEL}")
                }
            }
        }
    }
    assert_eq(findings.join("\n"), "")
}

#Test("every kernel a shipped package names exists, and no raw memory region stands outside one") {
    guards_enter_root()
    sources := [String]{}
    loop root in MKSH_ROOTS -> mksh_walk(root, sources)
    manifests := 0
    findings := [String]{}
    loop path in sources {
        if !path.ends_with("/package.jet") -> next
        manifest: mksh_files.read(path) ?? panic("read {path}: {err}")
        folder: path.slice(0, path.len() - "package.jet".len())
        loop entry in mksh_kernel_entries(manifest) {
            manifests += 1
            if !mksh_files.exists("{folder}{entry}") {
                findings.push("{path}: policy.memory names `{entry}`, which does not exist")
            }
        }
    }
    assert(manifests >= 3, "found only {manifests} kernel entries in shipped manifests")
    assert_eq(findings.join("\n"), "")
    safety: mksh_files.read("Docs/Spec/safety.md") ?? panic("read Docs/Spec/safety.md: {err}")
    assert(safety.contains("<!-- memory-kernel:outside 0 -->"), "the unsafe ratchet must record zero raw memory regions outside a kernel")
    diagnostics: mksh_files.read("Compiler/Prelude/Diagnostics.jet") ?? panic("read Compiler/Prelude/Diagnostics.jet: {err}")
    assert(diagnostics.contains("code: \"E3113\""), "E3113 must stay a registered diagnostic")
    snapshot: mksh_files.read("Tests/UI/E3113RawMemoryOutsideKernel/stderr") ?? panic("read the E3113 UI snapshot: {err}")
    assert(snapshot.contains("[jet.RawMemoryOutsideKernel]"), "the E3113 UI snapshot must show the refusal")
}

#Test("the single-home census reads declarations, not mentions") {
    assert(mksh_declares("#Unsafe(\"why\") alloc_raw: fn(size: Int) -> Int", "alloc_raw"))
    assert(mksh_declares("window: fn<T, O>(owner: O) -> View<T>", "window"))
    assert(!mksh_declares("ir_core_alloc_raw: fn(m: &IRModule) -> Int", "alloc_raw"))
    assert(!mksh_declares("    copy: fn(self) -> Int", "copy"))
    assert(!mksh_declares("// alloc_raw: fn is the kernel's", "alloc_raw"))
    assert_eq(mksh_kernel_entries("policy: {{\n    memory: .Kernel([\"Source/A.jet\", \"Source/B.jet\"]),\n}}"), [String]{"Source/A.jet", "Source/B.jet"})
    assert_eq(mksh_kernel_entries("name: \"x\""), [String]{})
    // A gate reads the same on the declaration's line, on its own line above
    // it, and wrapped as a marker group; a comment or another item above ends
    // the markers.
    gated: [String]{
        "#Unsafe(\"why\") free_raw: fn(p: Int) Never! {{",
        "#Unsafe(\"why\")\nfree_raw: fn(p: Int) Never! {{",
        "#[Inline(Always), Unsafe(\"why\")]\nfree_raw: fn(p: Int) Never! {{",
        "#[\n    Inline(Always),\n    Unsafe(\"why\"),\n]\nfree_raw: fn(p: Int) Never! {{",
        "#Unsafe(\n    \"why\"\n)\nfree_raw: fn(p: Int) Never! {{",
    }
    loop source in gated {
        lines: source.split("\n").to_list()
        assert(mksh_gate(lines, lines.len() - 1).contains("Unsafe(\""), "the gate of: {source}")
    }
    ungated: [String]{
        "#Unsafe(\"why\")\nother: fn() {{}}\n\nfree_raw: fn(p: Int) Never! {{",
        "#Unsafe(\"why\")\n// note\nfree_raw: fn(p: Int) Never! {{",
    }
    loop source in ungated {
        lines: source.split("\n").to_list()
        assert(!mksh_gate(lines, lines.len() - 1).contains("Unsafe(\""), "no gate in: {source}")
    }
}
