// American spelling: no tracked text spells a word the British way. The
// census reads every tracked text file (sources and their comments,
// diagnostics, snapshots, docs, data) with `git grep` for the AS_WORDS
// British spellings, whole words in any case, and names the American spelling
// for each hit. In the code trees (AS_CODE_TREES) it reads identifiers too:
// each part of `is_cancelled` or `TaskCancelled` is a word of its own.
//
// Three closed lists keep a British spelling, each row with its reason:
// - AS_IDENTIFIERS: a Jet identifier or machine value whose rename is a
//   public API and machine-output change. Its exact spelling passes where it
//   is written as code: in Jet code outside comments and string text, in
//   program output (a snapshot, a case file's steps, or a generated `.rows`
//   table), in backticks, after a `.`, as a quoted token without spaces
//   (`"Cancelled"`, `'cancelled'`, `"sleep-cancelled"`), as the key of a
//   `key=value` or `key:value` field (`cancelled=false`, `cancelled:0`), or
//   as the label of an interpolated value (`cancelled: {n}`). Written as
//   prose, it fails.
// - AS_QUOTED: a file that quotes an external name (an API identifier, a URL,
//   a title, quoted upstream text), with the count of each word it keeps.
// - AS_SKIPPED: the paths the census does not read at all: dated data dumps,
//   upstream tables copied as published, and this guard's word list.
// A row that keeps nothing any more fails, so the lists only shrink.
use as_process: core.process

AmericanSpelling: struct {
    british: String,
    american: String,
}

// Paths the census skips, as a git glob pathspec (`**` crosses folders).
SpellingSkip: struct {
    path: String,
    reason: String,
}

// A Jet identifier or machine value, spelled exactly, kept where it is code.
SpellingIdentifier: struct {
    spelling: String,
    reason: String,
}

// A file that keeps `count` British `word`s (any case) because each is part
// of a quoted external name.
SpellingQuote: struct {
    path: String,
    word: String,
    count: Int,
    reason: String,
}

AS_SKIPPED: [SpellingSkip]{
    SpellingSkip{path: "Tests/Guards/american_spelling.jet", reason: "this guard's word list"},
    SpellingSkip{path: "Tools/Tower/.tower/**", reason: "Tower's card store, which only the Tower tool writes"},
    SpellingSkip{path: "Docs/Audits/**/*.tsv", reason: "dated audit records that quote source lines as they stood"},
    SpellingSkip{path: "Docs/Audits/**/*.json", reason: "dated audit records that quote source lines as they stood"},
    SpellingSkip{path: "Docs/Research/**/*.json", reason: "dated research records that quote upstream text as it stood"},
    SpellingSkip{path: "Tests/Data/Unicode/**", reason: "the Unicode Character Database, as published"},
    SpellingSkip{path: "Tests/Cases/TextUnicode/*.fixture/data/**", reason: "the Unicode Character Database, as published"},
    SpellingSkip{path: "Tests/Data/Xkb/**", reason: "xkbcommon's keysym and Compose tables, as published"},
    SpellingSkip{path: "Docs/Research/mine-for-jet-2026-09-12.md", reason: "a closed 12 MB mining capture, past the size the reviewed editor opens"},
    SpellingSkip{path: "Docs/Assets/Research/**/*.json", reason: "dated research evidence records, kept as captured"},
    SpellingSkip{path: "Docs/Audits/RustExitParity/**", reason: "a closed ledger generated from its tsv rows, whose group names it repeats"},
    SpellingSkip{path: "Compiler/JetRuntime/Assets/MuslErrno1_2_5/COPYRIGHT", reason: "musl's license text, as published"},
    SpellingSkip{path: "Jetpack/Integrations/Source/Foreign/RustBridge/Runtime/public_suffix_list.dat", reason: "Mozilla's Public Suffix List, as published"},
    SpellingSkip{path: "Compiler/Migrations/AmericanIdent1.jet", reason: "the rewrite's British words, the spellings it replaces"},
    SpellingSkip{path: "Tests/Cases/Migrations/AmericanIdent1RenamesBritishNameParts/Input/**", reason: "the rewrite's input, an old program in the British spellings it replaces"},
}

AS_IDENTIFIERS: [SpellingIdentifier]{
    SpellingIdentifier{spelling: "Cancelled", reason: "the `Cancelled` task outcome and delivery state tokens durable service logs hold"},
    SpellingIdentifier{spelling: "cancelled", reason: "the `cancelled` wire and storage tokens (job queue SQL and JSON, workflow history, comparison status, jet.live.v1, paused-evaluate and jettrace keys, the UI host dialog answer) that the versioned converter migrates"},
    SpellingIdentifier{spelling: "Marshalled", reason: "the `AdapterMarshalled` value of the jet-ffi-descriptor-v1 binding stamp, which stored bindings carry"},
    SpellingIdentifier{spelling: "specialisation", reason: "JetOS's system field and boot path, named as NixOS spells its `specialisation` option"},
    SpellingIdentifier{spelling: "specialisations", reason: "JetOS's system field and boot path, named as NixOS spells its `specialisation` option"},
}

