// Program output and generated tables: every word of such a line is the text
// of its source, which the census reads there.
AS_OUTPUT_SUFFIXES: [String]{".out", ".stdout", ".stderr", ".expected", ".rows"}

// The code trees: there each part of an identifier is a word of its own
// (`is_cancelled`, `TaskCancelled`), so a British part counts as well.
AS_CODE_TREES: [String]{"Compiler/", "Core/", "Jetpack/", "Tools/", "Examples/", "Tests/"}

as_code_tree: fn(path: String) -> Bool Never! {
    loop tree in AS_CODE_TREES {
        if path.starts_with(tree) -> return true
    }
    false
}

// The American spelling of each British word, keyed in lower case.
as_word_map: fn() -> [String:String] Never! {
    map := [String:String]{}
    loop row in AS_WORDS -> map[row.british] = row.american
    map
}

// Whether `code` is a byte of a word as `git grep -w` reads one: an ASCII
// letter, digit or underscore.
as_word_byte: fn(code: Int) -> Bool Never! {
    (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
}

as_upper_byte: fn(code: Int) -> Bool Never! { code >= 65 && code <= 90 }

as_lower_byte: fn(code: Int) -> Bool Never! { code >= 97 && code <= 122 }

// The letter runs of identifier `word`: it splits at underscores and digits,
// where a lower-case letter meets a capital, and before the last capital of a
// run that starts a capitalized word (`HTTPServer` is `HTTP` and `Server`).
as_word_parts: fn(word: String) -> [String] Never! {
    bytes: word.bytes()
    parts := [String]{}
    start := -1
    loop at in 0..<bytes.len() {
        code: Int{bytes[at]}
        if !as_upper_byte(code) && !as_lower_byte(code) {
            if start >= 0 -> parts.push(String.from_bytes(bytes.slice(start, at)) ?? "")
            start = -1
            next
        }
        if start >= 0 && as_upper_byte(code) {
            previous: as_byte_at(bytes, at - 1)
            if as_lower_byte(previous) || (as_upper_byte(previous) && as_lower_byte(as_byte_at(bytes, at + 1))) {
                parts.push(String.from_bytes(bytes.slice(start, at)) ?? "")
                start = at
            }
        }
        if start < 0 -> start = at
    }
    if start >= 0 -> parts.push(String.from_bytes(bytes.slice(start, bytes.len())) ?? "")
    parts
}

// The byte at `at` as an Int, or 0 outside `bytes`.
as_byte_at: fn(bytes: [U8], at: Int) -> Int Never! {
    if at < 0 || at >= bytes.len() -> return 0
    Int{bytes[at]}
}

// `american` in the case `word` is written in: all capitals, a capital
// first letter, or lower case.
as_cased: fn(word: String, american: String) -> String Never! {
    if word == word.to_upper() -> return american.to_upper()
    bytes := american.bytes()
    first: Int{word.bytes()[0]}
    if first >= 65 && first <= 90 -> bytes[0] = U8{Int{bytes[0]} - 32}
    String.from_bytes(bytes) ?? ""
}

// Which bytes of a Jet source line are code: outside a `//` comment and
// outside string text, where an interpolation's braces hold code again.
as_jet_code: fn(bytes: [U8], mask: &[Bool]) {
    in_string := false
    depth := 0
    at := 0
    loop at < bytes.len() {
        code: Int{bytes[at]}
        next_code: if at + 1 < bytes.len() -> Int{bytes[at + 1]} else -> 0
        if !in_string && code == 47 && next_code == 47 {
            return
        }
        if {
            !in_string && (code == 34 || (code == 125 && depth == 1)) -> {
                depth = 0
                in_string = true
            }
            !in_string -> {
                if depth > 0 && code == 123 -> depth += 1
                if depth > 0 && code == 125 -> depth -= 1
                mask[at] = true
            }
            code == 92 || (code == 123 && next_code == 123) -> at += 1
            code == 123 -> {
                in_string = false
                depth = 1
            }
            code == 34 -> in_string = false
        }
        at += 1
    }
}

// Which bytes of `line` of the file at `path` are code (see AS_IDENTIFIERS).
as_code_mask: fn(path: String, line: String) -> [Bool] Never! {
    bytes: line.bytes()
    output := false
    loop suffix in AS_OUTPUT_SUFFIXES {
        if path.ends_with(suffix) -> output = true
    }
    if path.ends_with(".case") && !line.trim().starts_with("#") -> output = true
    mask := [Bool]{}
    loop _ in 0..<bytes.len() -> mask.push(output)
    if path.ends_with(".jet") -> as_jet_code(bytes, mask)
    quoted := false
    loop at in 0..<bytes.len() {
        if (Int{bytes[at]}) == 96 -> quoted = !quoted
        if quoted -> mask[at] = true
    }
    mask
}

// One British word of a tracked file, as written, and whether it is code.
AmericanHit: struct {
    path: String,
    line: String,
    word: String,
    code: Bool,
}

// The first space, tab, or quote byte from `at` on, stepping by `step`, or 0
// at the edge of the line.
as_token_edge: fn(bytes: [U8], at: Int, step: Int) -> Int Never! {
    index := at
    loop index >= 0 && index < bytes.len() {
        code: Int{bytes[index]}
        if code == 32 || code == 9 || code == 34 || code == 39 -> return code
        index += step
    }
    0
}

// The British words of `text`, line `line` of the file at `path`: whole
// words, and in a code tree each British part of an identifier.
as_line_hits: fn(path: String, line: String, text: String, words: [String:String], out: &[AmericanHit]) {
    bytes: text.bytes()
    mask: as_code_mask(path, text)
    at := 0
    loop at < bytes.len() {
        if !as_word_byte(Int{bytes[at]}) {
            at += 1
            next
        }
        start: at
        loop at < bytes.len() && as_word_byte(Int{bytes[at]}) -> at += 1
        word: String.from_bytes(bytes.slice(start, at)) ?? ""
        parts: if as_code_tree(path) -> as_word_parts(word) else -> [String]{word}
        british := [String]{}
        loop part in parts {
            if words.get(part.to_lower()) != None -> british.push(part.copy())
        }
        if british.is_empty() -> next
        before: as_byte_at(bytes, start - 1)
        after: as_byte_at(bytes, at)
        following: as_byte_at(bytes, at + 1)
        label: after == 61 || (after == 58 && ((following != 32 && following != 0) || as_byte_at(bytes, at + 2) == 123))
        left: as_token_edge(bytes, start - 1, -1)
        right: as_token_edge(bytes, at, 1)
        token: (left == 34 || left == 39) && (right == 34 || right == 39)
        code: mask[start] || before == 46 || token || label
        loop part in british {
            out.push(AmericanHit{path: path.copy(), line: line.copy(), word: part.copy(), code: code})
        }
    }
}

// The British words of `git grep -n` output lines (`path:line:text`).
as_hits: fn(lines: [String], words: [String:String]) -> [AmericanHit] Never! {
    hits := [AmericanHit]{}
    loop line in lines {
        parts: line.split(":").to_list()
        if parts.len() < 3 -> next
        text := parts[2]
        loop index in 3..<parts.len() -> text = "{text}:{parts[index]}"
        as_line_hits(parts[0], parts[1], text, words, hits)
    }
    hits
}

// The hits against the closed lists: each hit no row keeps, and each row
// that keeps nothing or a different count.
as_findings: fn(hits: [AmericanHit], words: [String:String]) -> [String] Never! {
    findings := [String]{}
    identifiers := [String:Int]{}
    loop row in AS_IDENTIFIERS -> identifiers[row.spelling] = 0
    quoted := [String:Int]{}
    loop row in AS_QUOTED -> quoted["{row.path}\t{row.word}"] = 0
    loop hit in hits {
        if hit.code && identifiers.get(hit.word) != None {
            identifiers[hit.word] = identifiers[hit.word] + 1
            next
        }
        key: "{hit.path}\t{hit.word.to_lower()}"
        if quoted.get(key) != None {
            quoted[key] = quoted[key] + 1
            next
        }
        findings.push("{hit.path}:{hit.line}: `{hit.word}` is British; write `{as_cased(hit.word, words[hit.word.to_lower()])}`")
    }
    loop row in AS_IDENTIFIERS {
        if identifiers[row.spelling] == 0 {
            findings.push("AS_IDENTIFIERS `{row.spelling}`: no code spells it any more; delete the row")
        }
    }
    loop row in AS_QUOTED {
        found: quoted["{row.path}\t{row.word}"]
        if found != row.count {
            findings.push("{row.path}: {found} `{row.word}`, AS_QUOTED keeps {row.count}; spell the others the American way, or correct the row")
        }
    }
    findings
}

// `git grep` over the tracked text files for every AS_WORDS spelling, outside
// AS_SKIPPED: anywhere in a word, so a line with a British part of an
// identifier reaches as_line_hits.
as_grep: fn() -> [String] {
    pattern := ""
    loop row in AS_WORDS {
        pattern = if pattern == "" -> row.british else -> "{pattern}|{row.british}"
    }
    argv := [String]{"git", "-c", "core.quotePath=false", "grep", "-I", "-n", "-P", "(?i)(?:{pattern})", "--", "."}
    loop row in AS_SKIPPED -> argv.push(":(exclude,glob){row.path}")
    listed: as_process.cmd(argv).stdout(.Capture).stderr(.Capture).run() ?? panic("run git grep: {err}")
    assert(listed.code == 0 || listed.code == 1, "git grep failed: {as_process.combined_output(listed).trim()}")
    lines := [String]{}
    loop line in as_process.stdout_lines(listed) {
        if line.len() > 0 -> lines.push(line)
    }
    lines
}

// Each AS_SKIPPED row that no tracked file matches any more.
as_stale_skips: fn() -> [String] {
    stale := [String]{}
    loop row in AS_SKIPPED {
        listed: as_process.cmd([String]{"git", "ls-files", "--", ":(glob){row.path}"}).stdout(.Capture).stderr(.Capture).run() ?? panic("run git ls-files: {err}")
        assert(listed.code == 0, "git ls-files failed: {as_process.combined_output(listed).trim()}")
        if as_process.stdout_lines(listed).is_empty() {
            stale.push("AS_SKIPPED `{row.path}`: no tracked file matches it any more; delete the row")
        }
    }
    stale
}

#Test("the census names each British word and its American spelling") {
    words: as_word_map()
    hits: as_hits([String]{"Docs/a.md:3:a Colour: the behaviour of initialise_x", "Docs/b.md:9:color"}, words)
    assert_eq(hits.len(), 2)
    findings: as_findings(hits, words)
    assert(findings.contains("Docs/a.md:3: `Colour` is British; write `Color`"))
    assert(findings.contains("Docs/a.md:3: `behaviour` is British; write `behavior`"))
}

#Test("in a code tree each British part of an identifier is a hit") {
    assert_eq(as_word_parts("is_colour2RecolourHTTPServer"), [String]{"is", "colour", "Recolour", "HTTP", "Server"})
    words: as_word_map()
    hits: as_hits([String]{"Core/a.jet:4:x_colour: RecolourHTTP + XMLColour", "Docs/a.md:4:x_colour: RecolourHTTP + XMLColour"}, words)
    assert_eq(hits.len(), 3)
    findings: as_findings(hits, words)
    assert(findings.contains("Core/a.jet:4: `colour` is British; write `color`"))
    assert(findings.contains("Core/a.jet:4: `Recolour` is British; write `Recolor`"))
    assert(findings.contains("Core/a.jet:4: `Colour` is British; write `Color`"))
}

#Test("a Jet line's code is outside its comments and string text") {
    words: as_word_map()
    hits := [AmericanHit]{}
    as_line_hits("a.jet", "1", "colour: \"{{colour}} colour\" // colour", words, hits)
    assert_eq(hits.len(), 4)
    assert(hits[0].code && hits[1].code && !hits[2].code && !hits[3].code)
    quoted := [AmericanHit]{}
    as_line_hits("a.md", "1", "the `colour` field, \"colour\", x.colour and colour", words, quoted)
    assert(quoted[0].code && quoted[1].code && quoted[2].code && !quoted[3].code)
    tokens := [AmericanHit]{}
    as_line_hits("a.md", "1", "\"Red,colour\", 'sleep-colour', \"the colour\"", words, tokens)
    assert(tokens[0].code && tokens[1].code && !tokens[2].code)
    output := [AmericanHit]{}
    as_line_hits("a.case", "1", "# the colour", words, output)
    as_line_hits("a.case", "2", "stdout: colour", words, output)
    assert(!output[0].code && output[1].code)
}

#Test("each word list row is lower case, listed once, and changes the word") {
    seen := [String:Bool]{}
    loop row in AS_WORDS {
        assert(row.british == row.british.to_lower(), "{row.british}: list the word in lower case")
        assert(row.british != row.american, "{row.british}: the American spelling must differ")
        assert(seen.get(row.british) == None, "{row.british}: listed twice")
        seen[row.british] = true
    }
}

#Test("no tracked text spells a word the British way") {
    guards_enter_root()
    words: as_word_map()
    findings := as_findings(as_hits(as_grep(), words), words)
    loop line in as_stale_skips() -> findings.push(line)
    assert_eq(findings.join("\n"), "")
}
