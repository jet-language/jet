use compiler_event_files: core.files

// The compiler's public moments have one list: the registry rows of
// Compiler/JetFoundation/Source/Registry/CompilerEvents.jet. Core declares
// the same moments for Jet code as `core.compiler.Event` and its payload
// structs. The rows and the Core declaration must name the same variants,
// in the same order, with the same payloads, and each payload struct must
// declare the fields its row lists, in the same order and with the same
// types.
COMPILER_EVENT_ROWS_PATH: "Compiler/JetFoundation/Source/Registry/CompilerEvents.jet"

COMPILER_EVENT_CORE_PATH: "Core/Compiler/Compiler.jet"

// The text between `open` and the next `close` after it in `line`, or "".
compiler_event_between: fn(line: String, open: String, close: String) -> String {
    after: (line.split_once(open) ?? return "").after
    (after.split_once(close) ?? return "").before
}

// The moments the rows list, as `name variant payload`, in row order.
compiler_event_rows: fn(text: String) -> [String] {
    names := [String:String]{}
    rows := [String]{}
    loop line in text.lines() {
        if line.starts_with("COMPILER_EVENT_") && line.contains(": \"") {
            parts: line.split_once(": ") ?? next
            names[parts.before] = parts.after.trim().removeprefix("\"").removesuffix("\"")
        }
        if line.trim().starts_with("CompilerEvent{{name: ") {
            name: names.get(compiler_event_between(line, "name: ", ",")) ?? "<unknown constant>"
            rows.push("{name} {compiler_event_between(line, "variant: \"", "\"")} {compiler_event_between(line, "payload: \"", "\"")}")
        }
    }
    rows
}

// The payload rows, as `Payload: field Type, field Type`, in row order. A
// payload row opens with `CompilerEventPayload{`, names its struct on the
// next `name:` line, and lists one `CompilerEventField{…}` per line.
compiler_event_payload_rows: fn(text: String) -> [String] {
    rows := [String]{}
    current := ""
    opened := false
    fields := [String]{}
    loop line in text.lines() {
        word: line.trim()
        if word.starts_with("CompilerEventPayload{{") {
            if current != "" -> rows.push("{current}: {fields.join(", ")}")
            current = ""
            opened = true
            fields = [String]{}
        } else if opened && word.starts_with("name: \"") {
            current = compiler_event_between(word, "name: \"", "\"")
            opened = false
        } else if word.starts_with("CompilerEventField{{name: ") {
            fields.push("{compiler_event_between(word, "name: \"", "\"")} {compiler_event_between(word, "ty: \"", "\"")}")
        }
    }
    if current != "" -> rows.push("{current}: {fields.join(", ")}")
    rows
}

// The member lines of the top-level `head` block in `text`, trimmed, without
// comments or blank lines.
compiler_event_block: fn(text: String, head: String) -> [String] {
    members := [String]{}
    inside := false
    loop line in text.lines() {
        if !inside {
            if line == head -> inside = true
            next
        }
        if line == "}}" -> return members
        word: line.trim()
        if word == "" || word.starts_with("//") -> next
        members.push(word.removesuffix(","))
    }
    members
}

#Test("compiler event rows and core.compiler.Event declare the same moments and payloads") {
    guards_enter_root()
    rows_text: compiler_event_files.read(COMPILER_EVENT_ROWS_PATH) ?? panic("read {COMPILER_EVENT_ROWS_PATH}: {err}")
    core_text: compiler_event_files.read(COMPILER_EVENT_CORE_PATH) ?? panic("read {COMPILER_EVENT_CORE_PATH}: {err}")
    rows: compiler_event_rows(rows_text)
    payloads: compiler_event_payload_rows(rows_text)
    assert(rows.len() > 0 && payloads.len() > 0, "{COMPILER_EVENT_ROWS_PATH} lists no moment or no payload")
    problems := [String]{}
    seen := [String]{}
    variants: compiler_event_block(core_text, "Event: enum {{")
    if variants.len() != rows.len() {
        problems.push("the rows list {rows.len()} moments, core.compiler.Event declares {variants.len()} variants")
    }
    payload_names := [String]{}
    loop payload in payloads -> payload_names.push((payload.split_once(":") ?? next).before)
    loop (index, row) in rows {
        words: row.split(" ").to_list()
        name: words[0]
        if !name.starts_with("compiler.") && !name.starts_with("build.") {
            problems.push("moment `{name}` is neither a compiler. nor a build. name")
        }
        if seen.contains(name) -> problems.push("moment `{name}` is listed twice")
        seen.push(name.copy())
        if !payload_names.contains(words[2]) {
            problems.push("moment `{name}` carries `{words[2]}`, which no payload row declares")
        }
        if index < variants.len() {
            declared: variants[index]
            variant: if declared.split_once("(") == .Val(cut) -> cut.before else -> declared
            payload: compiler_event_between(declared, ": ", ")")
            if variant != words[1] || payload != words[2] {
                problems.push("row {index + 1} is `{words[1]}({words[2]})`, core.compiler.Event declares `{declared}`")
            }
        }
    }
    loop payload in payloads {
        parts: payload.split_once(": ") ?? next
        declared := [String]{}
        loop member in compiler_event_block(core_text, "{parts.before}: struct {{") {
            field: member.split_once(": ") ?? next
            declared.push("{field.before} {field.after}")
        }
        if declared.join(", ") != parts.after {
            problems.push("payload `{parts.before}` lists `{parts.after}`, core.compiler declares `{declared.join(", ")}`")
        }
    }
    assert(problems.len() == 0, "the compiler event rows and core.compiler disagree:\n{problems.join("\n")}")
}
