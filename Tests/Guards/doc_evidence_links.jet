// Guard: every relative evidence link in README.md and Docs/Spec/
// must resolve to a committed file or directory in the repository.
use doc_links_files: core.files

doc_links_dir_of: fn(path: String) -> String {
    parts: path.split("/").to_list()
    if parts.len() <= 1 -> return ""
    ^keep: [String]{}
    loop i in 0..<(parts.len() - 1) -> keep.push(parts[i])
    keep.join("/")
}

doc_links_normalize: fn(path: String) -> String {
    ^stack: [String]{}
    loop seg in path.split("/") {
        if seg == "" || seg == "." -> next
        if seg == ".." {
            if stack.len() > 0 -> _popped: stack.pop() ?? ""
            next
        }
        stack.push(seg)
    }
    stack.join("/")
}

doc_links_resolve: fn(doc_path: String, raw_target: String) -> String {
    target: raw_target.trim()
    no_title: target.split(" ").to_list()[0]
    no_anchor: no_title.split("#").to_list()[0]
    if no_anchor == "" -> return ""
    if no_anchor.starts_with("/") -> return doc_links_normalize(no_anchor)
    base: doc_links_dir_of(doc_path)
    if base == "" -> return doc_links_normalize(no_anchor)
    doc_links_normalize("{base}/{no_anchor}")
}

doc_links_is_external: fn(raw_target: String) -> Bool {
    t: raw_target.trim()
    t == "" || t.starts_with("http://") || t.starts_with("https://") || t.starts_with("mailto:") || t.starts_with("#")
}

// Extract relative markdown link targets `[...](target)` outside fenced code blocks.
doc_links_extract_targets: fn(text: String) -> [String] {
    ^targets: [String]{}
    ^in_fence: false
    loop raw_line in text.lines() {
        trimmed: raw_line.trim()
        if trimmed.starts_with("```") {
            in_fence = !in_fence
            next
        }
        if in_fence -> next
        bytes: raw_line.bytes()
        n: bytes.len()
        ^i: 0
        loop i < n {
            // Find `](`
            if bytes[i] == (U8{93}) && i + 1 < n && bytes[i + 1] == (U8{40}) {
                start: i + 2
                ^end: start
                ^depth: 1
                loop end < n && depth > 0 {
                    b: bytes[end]
                    if b == (U8{40}) -> depth += 1 else if b == (U8{41}) -> depth -= 1
                    if depth > 0 -> end += 1
                }
                if depth == 0 && end > start {
                    target: policy_slice_raw(bytes, start, end)
                    if !doc_links_is_external(target) -> targets.push(target)
                }
                i = end + 1
                next
            }
            i += 1
        }
    }
    targets
}

doc_links_broken_in_text: fn(doc_path: String, text: String) -> [String] {
    ^broken: [String]{}
    loop raw_target in doc_links_extract_targets(text) {
        resolved: doc_links_resolve(doc_path, raw_target)
        if resolved == "" -> next
        if !doc_links_files.exists(resolved) {
            broken.push("{doc_path}: ({raw_target}) -> {resolved}")
        }
    }
    broken
}

#Test("doc_evidence_links") {
    guards_enter_root()
    ^docs: [String]{"README.md"}
    loop path in s3_truth_md_paths("Docs/Spec") -> docs.push(path)
    docs.sort()
    ^broken: [String]{}
    loop doc in docs {
        text: doc_links_files.read(doc) ?? panic("read {doc}: {err}")
        loop item in doc_links_broken_in_text(doc, text) -> broken.push(item)
    }
    assert(broken.len() == 0, "broken evidence links in README.md or Docs/Spec/:\n{broken.join("\n")}")
}

#Test("doc_evidence_links_rejects_planted_broken_link") {
    guards_enter_root()
    sample: "See [missing](../../Tests/Cases/DoesNotExist/)\nand [real](../../README.md)\n```\n[code](ignored/path)\n```\n"
    found: doc_links_broken_in_text("Docs/Spec/sample.md", sample)
    assert_eq(found.len(), 1)
    assert(found[0].contains("Tests/Cases/DoesNotExist"))
}

ADOPTION_DOCS: [String]{
    "Docs/Spec/Reference/migration-tier-map.md",
    "Docs/Spec/Reference/mixed-repo.md",
}

#Test("docs_links_resolve") {
    guards_enter_root()
    ^docs: [String]{}
    loop path in ADOPTION_DOCS -> docs.push(path)
    loop path in s3_truth_md_paths("Docs/Spec/Guides") -> docs.push(path)
    docs.sort()
    assert(docs.len() > 0, "no adoption or guide documents found")
    ^broken: [String]{}
    loop doc in docs {
        text: doc_links_files.read(doc) ?? panic("read {doc}: {err}")
        loop item in doc_links_broken_in_text(doc, text) -> broken.push(item)
    }
    loop doc in ADOPTION_DOCS {
        text: doc_links_files.read(doc) ?? panic("read {doc}: {err}")
        ^evidence_count: 0
        loop raw_target in doc_links_extract_targets(text) {
            resolved: doc_links_resolve(doc, raw_target)
            if resolved.starts_with("Tests/") || resolved.starts_with("Examples/") || resolved.starts_with("Compiler/") || resolved.starts_with("Jetpack/") || resolved.starts_with("Tools/") {
                evidence_count += 1
            }
        }
        assert(evidence_count > 0, "adoption doc {doc} must link to committed repo evidence")
    }
    assert(broken.len() == 0, "broken links in adoption and guide docs:\n{broken.join("\n")}")
}
