use dn_files: core.files

// Jet's debugger and profiler are its own engines. No text a user reads says
// that `jet debug` runs under LLDB or GDB or that `jet perf` is Linux perf, and
// no debug tier is named after one of them: the spellings below fail here, in
// any letter case. Interop cases keep the tools' names: a `.case` that requires
// lldb, gdb, perf, go or otelcol checks Jet's DWARF or symbol map against that
// tool. Audits, research notes and proposals are dated records and are not read.
DN_ROOTS: [String]{"Compiler", "Core", "Examples", "Jetpack", "Tools", "Tests", "Docs/Spec", "Docs/Site", "Docs/README.md"}

DN_SKIPPED: [String]{"target", "node_modules"}

DN_SPELLINGS: [String]{"under lldb", "under gdb", "under linux perf", "native-lldb", "nativelldb"}

DN_INTEROP_TOOLS: [String]{"tool:lldb", "tool:gdb", "tool:perf", "tool:go", "tool:otelcol"}

// This guard spells what it refuses.
DN_GUARD: "Tests/Guards/debug_names_no_outside_debugger.jet"

// The first refused spelling in `text`, in any letter case, or None.
dn_spelling: fn(text: String) -[]> String? {
    lower: text.to_lower()
    loop spelling in DN_SPELLINGS {
        if lower.contains(spelling) -> return Val(spelling)
    }
    None
}

// Whether `path` is a case that requires an outside tool, so checks Jet's
// output against it.
dn_interop_case: fn(path: String, text: String) -[]> Bool {
    if !path.ends_with(".case") -> return false
    loop line in text.lines() {
        if !line.starts_with("requires:") -> next
        loop tool in DN_INTEROP_TOOLS {
            if line.contains(tool) -> return true
        }
    }
    false
}

// Every line under `path` that spells a refused name, as `path:line: spelling`.
// Symbolic links, hidden entries, build output and installed node modules are
// skipped, and so are files that are not text.
dn_lines: fn(path: String, out: ^[String]) -[FS]> {
    if dn_files.is_symlink(path) {
        return
    }
    if dn_files.is_dir(path) {
        loop child in (dn_files.list_dir(path) ?? panic("list {path}: {err}")) {
            if child.name.starts_with(".") || DN_SKIPPED.contains(child.name) -> next
            dn_lines(child.path, out)
        }
        return
    }
    if path == DN_GUARD {
        return
    }
    text: dn_files.read(path) ?? return
    if dn_spelling(text) == None || dn_interop_case(path, text) {
        return
    }
    loop (index, line) in text.lines() {
        spelling: dn_spelling(line) ?? next
        out.push("{path}:{index + 1}: {spelling}")
    }
}

#Test("debug_names_no_outside_debugger") {
    guards_enter_root()
    found := [String]{}
    loop root in DN_ROOTS {
        assert(dn_files.exists(root), "the root {root} must exist")
        dn_lines(root, found)
    }
    assert_eq(found.join("\n"), "")
    // The matcher sees each spelling in any letter case, and an interop case
    // is one whose requires line names an outside tool.
    assert(dn_spelling("// steps it under LLDB, with Core") == Val("under lldb"))
    assert(dn_spelling("tier: \"Native-LLDB\"") == Val("native-lldb"))
    assert(dn_spelling("    DebugTier.NativeLLDB") == Val("nativelldb"))
    assert(dn_spelling("the samples Linux perf records under perf record") == None)
    assert(dn_spelling("lldb reads the split debug file") == None)
    assert(dn_interop_case("Tests/Cases/Debug/x.case", "requires: tool:lldb\nrun: jet build\n"))
    assert(!dn_interop_case("Tests/Cases/Debug/x.case", "requires: os-name:linux\n"))
    assert(!dn_interop_case("Tests/Cases/Debug/x.json", "requires: tool:lldb\n"))
}

// Nor does a committed script, skill, tool or case run an outside debugger,
// profiler or disassembler: `jet debug` and `jet perf` answer those questions
// about every Jet program, and using them is how their gaps are found
// (AGENTS.md, "Dogfood the debugger and profiler"). A run is the tool in a
// command position: the first word of a shell command (a script line, a
// `.case` step or a fenced block of a skill or README), or, in a Jet,
// JavaScript or Python tool, a string literal that is the tool's path, its
// `--tool` option, a command line starting with it, the head of an argv whose
// next word is an option or a subcommand, or the one argument of a lookup
// (`which("lldb")`). Comments and prose are not read. Under Compiler, Core
// and Jetpack only a package's Tests tree is, and under Docs only scripts and
// programs: a document's code block records a command, it runs nothing.
DN_RUN_TOOLS: [String]{"gdb", "lldb", "perf", "valgrind", "rr", "strace", "ltrace", "objdump"}

// The subcommands of perf and rr that start a run, as a command's second word.
DN_RUN_SUBCOMMANDS: [String]{"record", "stat", "report", "script", "top", "trace", "annotate", "replay"}

DN_RUN_ROOTS: [String]{"Tools", "Tests", "Examples", "Docs", ".agents/skills", "Compiler", "Core", "Jetpack"}

DN_RUN_TESTS_ONLY: [String]{"Compiler", "Core", "Jetpack"}

// The words that run the command after them.
DN_RUN_WRAPPERS: [String]{"timeout", "env", "exec", "nice", "command", "sudo", "time", "nohup", "xargs", "then", "do", "else", "if", "while", "until", "!"}

// The bytes that start a new shell command: | ; & ( ) ` ' " { }
DN_RUN_BREAKS: [Int]{124, 59, 38, 40, 41, 96, 39, 34, 123, 125}

// A kept run's class: a comparison harness (the outside tool measures Jet and
// a peer, a baseline or an oracle the same way), an interop case (the outside
// tool reading what Jet writes is the subject), or a gap (a Jet tool can't do
// the job yet). A gap row's `until` names the Tower criterion that gives a Jet
// tool the job (`#6995 c16`); the row leaves when that criterion is met.
DnRunKept: struct {
    path: String,
    harness: String,
    class: String,
    until: String,
    why: String,
}

DN_RUN_CLASSES: [String]{"comparison", "interop", "gap"}

DN_WHY_INTEROP: "the outside tool is the subject, reading the DWARF, symbols or perf map Jet writes for it"

// The harnesses that still run an outside tool, each named with its class
// and why. A row is a file or a directory; a row that no longer keeps a run
// fails, so the list only shrinks.
DN_RUNS_KEPT: [DnRunKept]{
    {path: "Tools/Perf/DebugLatency", harness: "DebugLatency", class: "comparison", until: "", why: "times jet debug against lldb on the same image and stops; lldb is the baseline each latency bar is judged by"},
    {path: "Compiler/JetBackend/Tests/X64Decode.jet", harness: "X64Decode", class: "comparison", until: "", why: "the decoder's parity oracle: objdump -M intel is a peer decoder Jet's x86-64 decoder must spell every instruction as, and the test skips where objdump is absent"},
    {path: "Tools/Gauntlet/Harness", harness: "the gauntlet", class: "comparison", until: "", why: "the standings' run cycles: perf stat -e cycles:u, read the same way for Jet's program and every peer language's"},
    {path: "Tools/Perf/AsmParity", harness: "AsmParity", class: "comparison", until: "", why: "cycles and instructions of a Jet build and of its hand-written assembly ceiling, counted by perf stat the same way for both, and the assembly side's lines read with objdump --dwarf=decodedline"},
    {path: "Tools/Perf/StdoutBuffer", harness: "StdoutBuffer", class: "comparison", until: "", why: "counts the write and writev system calls of Jet and of python3 printing the same lines, strace giving the one count for both"},
    {path: "Docs/Audits/BestInExistence20261119/Probes", harness: "the 2026-11-19 best-in-existence review's probes", class: "comparison", until: "", why: "a dated review's peer comparison: lldb, gdb and perf on the image jet debug and jet perf read"},
    {path: "Tests/Cases/ToolInterop", harness: "ToolInterop", class: "interop", until: "", why: DN_WHY_INTEROP},
    {path: "Tests/Cases/Debug/objdump_disassembles_main_from_text_section.case", harness: "objdump reads Jet's image", class: "interop", until: "", why: DN_WHY_INTEROP},
}

// The outside tool `word` names, bare or as a path, or None.
dn_run_tool: fn(word: String) -[]> String? {
    parts: word.trim().split("/").to_list()
    name: parts[parts.len() - 1]
    loop tool in DN_RUN_TOOLS {
        if name == tool -> return Val(tool)
    }
    None
}

// The outside tool one shell command runs, or None: its first word that is
// not a wrapper, an option, a number or an assignment.
dn_command_tool: fn(command: String) -[]> String? {
    loop word in command.split(" ").to_list() {
        bare: word.trim()
        if bare == "" || DN_RUN_WRAPPERS.contains(bare) || bare.starts_with("-") || bare.contains("=") {
            next
        }
        first: Int{bare.bytes()[0]}
        if first >= 48 && first <= 57 -> next
        return dn_run_tool(bare.removeprefix("$"))
    }
    None
}

// The outside tool a shell line runs, or None. Quotes, braces, pipes, lists
// and substitutions each start a command, so `sh -c 'objdump -d x'` and
// `prefix=(strace -f)` run their tools too.
dn_shell_tool: fn(line: String) -[]> String? {
    bytes: line.bytes()
    start := 0
    at := 0
    loop at <= bytes.len() {
        if at == bytes.len() || DN_RUN_BREAKS.contains(Int{bytes[at]}) {
            tool: dn_command_tool(String.from_bytes(bytes[start..<at]) ?? "")
            if tool != None -> return tool
            start = at + 1
        }
        at += 1
    }
    None
}

// The outside tool the code literal `text` runs, or None. `before` is the
// code byte before its opening quote (0 for none), and `after` the code after
// its closing one.
dn_text_tool: fn(text: String, before: Int, after: String) -[]> String? {
    if text.starts_with("--") -> return dn_run_tool(text.removeprefix("--"))
    words: text.split(" ").to_list()
    named: dn_run_tool(words[0]) ?? return None
    if words.len() > 1 {
        if words[1].starts_with("-") || DN_RUN_SUBCOMMANDS.contains(words[1]) -> return Val(named)
        return None
    }
    if words[0].contains("/") -> return Val(named)
    if before != 40 && before != 91 && before != 123 -> return None
    rest: after.trim()
    if rest.starts_with(")") -> return Val(named)
    if !rest.starts_with(",") -> return None
    argument: rest.removeprefix(",").trim()
    if argument.starts_with("[") -> return Val(named)
    word: argument.removeprefix("\"").removeprefix("'")
    if word == argument -> return None
    if word.starts_with("-") || DN_RUN_SUBCOMMANDS.find(fn(sub) { word.starts_with("{sub}\"") || word.starts_with("{sub}'") }) != None {
        return Val(named)
    }
    None
}

// The outside tool the string literals of one code line run, or None. A `//`
// outside a literal ends the code of the line.
dn_literal_tool: fn(line: String) -[]> String? {
    bytes: line.bytes()
    before := 0
    at := 0
    loop at < bytes.len() {
        quote: Int{bytes[at]}
        if quote == 47 && at + 1 < bytes.len() && (Int{bytes[at + 1]}) == 47 -> break
        if quote != 34 && quote != 39 && quote != 96 {
            if quote != 32 -> before = quote
            at += 1
            next
        }
        start: at + 1
        at = start
        loop at < bytes.len() && (Int{bytes[at]}) != quote {
            at += if (Int{bytes[at]}) == 92 -> 2 else -> 1
        }
        end: if at < bytes.len() -> at else -> bytes.len()
        text: String.from_bytes(bytes[start..<end]) ?? ""
        after: if end < bytes.len() -> String.from_bytes(bytes[(end + 1)..<bytes.len()]) ?? "" else -> ""
        tool: dn_text_tool(text, before, after)
        if tool != None -> return tool
        before = quote
        at += 1
    }
    None
}

// How a file's lines are read: "code", "shell", "case", "markdown", or "" for
// a file that is none of them.
dn_run_kind: fn(path: String, text: String) -[]> String {
    if path.ends_with(".jet") || path.ends_with(".mjs") || path.ends_with(".js") || path.ends_with(".ts") || path.ends_with(".py") {
        return "code"
    }
    if path.ends_with(".sh") || path.ends_with(".bash") -> return "shell"
    if path.ends_with(".case") -> return "case"
    if path.ends_with(".md") -> return "markdown"
    parts: path.split("/").to_list()
    if !parts[parts.len() - 1].contains(".") && text.starts_with("#!") && text.lines()[0].contains("sh") {
        return "shell"
    }
    ""
}

// A case step's command with each kit placeholder (`{work}`, `{jet}`: braces
// around one word) spelled as its bare word. The kit expands a placeholder to
// one argument, so it starts no command: `{jet} perf run` is jet's profiler.
dn_case_command: fn(text: String) -[]> String {
    bytes: text.bytes()
    out := [U8]{}
    at := 0
    loop at < bytes.len() {
        end: dn_placeholder_end(bytes, at)
        if {
            end > at -> {
                loop byte in bytes[at + 1..<end] -> out.push(byte)
                at = end + 1
            }
            else -> {
                out.push(bytes[at])
                at += 1
            }
        }
    }
    String.from_bytes(out) ?? text.copy()
}

// Where the `}` that closes a placeholder opening at `at` is, or `at` when no
// placeholder opens there.
dn_placeholder_end: fn(bytes: [U8], at: Int) -[]> Int {
    open: Int{bytes[at]}
    if open != 123 -> return at
    close := at + 1
    loop close < bytes.len() {
        byte: Int{bytes[close]}
        if byte == 125 -> return if close > at + 1 -> close else -> at
        if byte == 32 || DN_RUN_BREAKS.contains(byte) -> return at
        close += 1
    }
    at
}

// The outside tool one line of a `kind` file runs, or None. Comment lines and
// a markdown file's prose run nothing.
dn_line_tool: fn(kind: String, line: String, fenced: Bool) -[]> String? {
    bare: line.trim()
    if kind == "code" {
        if bare.starts_with("//") || bare.starts_with("#") || bare.starts_with("*") || bare.starts_with("/*") {
            return None
        }
        return dn_literal_tool(line)
    }
    if bare.starts_with("#") -> return None
    if kind == "markdown" && !fenced -> return None
    if kind != "case" -> return dn_shell_tool(line)
    if !bare.starts_with("step") -> return None
    step: bare.split_once(":") ?? return None
    dn_shell_tool(dn_case_command(step.after))
}

// Every run of an outside tool in `text`, as `path:line: tool`.
dn_text_runs: fn(path: String, text: String, out: ^[String]) -[]> {
    kind: dn_run_kind(path, text)
    if kind == "" {
        return
    }
    fenced := false
    loop (index, line) in text.lines() {
        if kind == "markdown" && line.trim().starts_with("```") {
            fenced = !fenced
            next
        }
        if dn_line_tool(kind, line, fenced) == .Val(tool) -> out.push("{path}:{index + 1}: {tool}")
    }
}

// Every run of an outside tool under `base/rel`, its paths relative to `base`.
// Under Compiler, Core and Jetpack only paths inside a Tests tree are read,
// and under Docs no markdown.
dn_runs_under: fn(base: String, rel: String, tests_only: Bool, out: ^[String]) -[FS]> {
    path: if base == "" -> rel.copy() else -> "{base}/{rel}"
    if dn_files.is_symlink(path) {
        return
    }
    if dn_files.is_dir(path) {
        loop child in (dn_files.list_dir(path) ?? panic("list {path}: {err}")) {
            if child.name.starts_with(".") || DN_SKIPPED.contains(child.name) -> next
            dn_runs_under(base, "{rel}/{child.name}", tests_only, out)
        }
        return
    }
    if rel == DN_GUARD || (tests_only && !rel.contains("/Tests/")) || (rel.starts_with("Docs/") && rel.ends_with(".md")) {
        return
    }
    text: dn_files.read(path) ?? return
    dn_text_runs(rel, text, out)
}

// Every run of an outside tool in the checkout at `base` ("" for the working
// directory).
dn_runs: fn(base: String) -[FS]> [String] {
    found := [String]{}
    loop root in DN_RUN_ROOTS {
        path: if base == "" -> root.copy() else -> "{base}/{root}"
        if !dn_files.exists(path) -> next
        dn_runs_under(base, root, DN_RUN_TESTS_ONLY.contains(root), found)
    }
    found
}

// Whether `finding` (`path:line: tool`) lies in the kept harness `row`.
dn_run_kept_by: fn(row: DnRunKept, finding: String) -[]> Bool {
    finding.starts_with("{row.path}:") || finding.starts_with("{row.path}/")
}

// What is wrong with the kept rows `rows`, given the runs `found` (`path:line:
// tool`): a row with no reason or a class not on the list, a gap row that
// names no criterion in `until` or a row of another class that names one,
// and a row that keeps no run any more, as when its harness was ported to a
// Jet tool. Each problem is one line.
dn_kept_problems: fn(rows: [DnRunKept], found: [String]) -[]> [String] {
    problems := [String]{}
    loop row in rows {
        if row.why == "" -> problems.push("DN_RUNS_KEPT row {row.path} names no reason")
        if !DN_RUN_CLASSES.contains(row.class) {
            problems.push("DN_RUNS_KEPT row {row.path} has class `{row.class}`, not comparison, interop or gap")
        }
        if (row.class == "gap") != row.until.starts_with("#") {
            problems.push("DN_RUNS_KEPT row {row.path}: a gap row, and only a gap row, names in `until` the criterion that removes it")
        }
        if found.find(fn(finding) { dn_run_kept_by(row, finding) }) == None {
            problems.push("DN_RUNS_KEPT row {row.path} keeps no run any more; delete it")
        }
    }
    problems
}

#Test("no script, skill, tool or case runs an outside debugger or profiler") {
    guards_enter_root()
    found: dn_runs("")
    refused := [String]{}
    loop finding in found {
        if DN_RUNS_KEPT.find(fn(row) { dn_run_kept_by(row, finding) }) == None {
            refused.push(finding)
        }
    }
    assert_eq(refused.join("\n"), "")
    assert_eq(dn_kept_problems(DN_RUNS_KEPT, found).join("\n"), "")
}

#Test("a kept row whose harness no longer runs its tool fails, and so does a gap row with no criterion") {
    found: [String]{"Tools/Perf/Kept/run.sh:4: perf"}
    kept: DnRunKept{path: "Tools/Perf/Kept", harness: "Kept", class: "gap", until: "#1 c1", why: "still samples with perf record"}
    ported: DnRunKept{path: "Tools/Perf/Ported", harness: "Ported", class: "gap", until: "#1 c2", why: "sampled with perf record before jet perf attach did"}
    unnamed: DnRunKept{path: "Tools/Perf/Kept/run.sh", harness: "Kept", class: "gap", until: "", why: "names no criterion"}
    assert_eq(dn_kept_problems([DnRunKept]{kept}, found), [String]{})
    assert_eq(dn_kept_problems([DnRunKept]{kept, ported}, found), [String]{"DN_RUNS_KEPT row Tools/Perf/Ported keeps no run any more; delete it"})
    assert_eq(dn_kept_problems([DnRunKept]{unnamed}, found), [String]{"DN_RUNS_KEPT row Tools/Perf/Kept/run.sh: a gap row, and only a gap row, names in `until` the criterion that removes it"})
}

#Test("a planted outside debugger run fails, named by file and line") {
    root: dn_files.mkdtemp("debug-runs") ?? panic("a temporary directory cannot be made: {err}")
    dn_files.create_dir_all("{root}/Tools/Probe") ?? panic("create {root}/Tools/Probe: {err}")
    dn_files.write("{root}/Tools/Probe/run.sh", "#!/bin/sh\n# lldb prog in a comment is prose\nlldb prog\n") ?? panic("write the planted script: {err}")
    assert_eq(dn_runs(root), [String]{"Tools/Probe/run.sh:3: lldb"})
    dn_files.remove_all(root) ?? panic("remove {root}: {err}")
    // Each command position runs its tool; prose and Jet's own tools do not.
    assert(dn_shell_tool("timeout 60 strace -f -o out prog") == Val("strace"))
    assert(dn_shell_tool("sh -c 'objdump -d .jet/build/main | grep -c x'") == Val("objdump"))
    assert(dn_shell_tool("  [ -n \"$trace\" ] && prefix=(strace -f -qq)") == Val("strace"))
    assert(dn_shell_tool("FOO=1 /usr/bin/gdb -batch prog") == Val("gdb"))
    assert(dn_shell_tool("jet perf run prog.jet") == None)
    assert(dn_shell_tool("lldb-vscode is not lldb") == None)
    assert(dn_literal_tool("    spawn([String]{{\"valgrind\", \"--leak-check=full\", binary}})") == Val("valgrind"))
    assert(dn_literal_tool("    run([\"perf\", \"stat\", \"-x,\"])") == Val("perf"))
    assert(dn_literal_tool("    path: \"{{dir}}/strace\"") == Val("strace"))
    assert(dn_literal_tool("    gdb: argument(argv, \"--gdb\", tool)") == Val("gdb"))
    assert(dn_literal_tool("    found: process.which(\"lldb\")") == Val("lldb"))
    assert(dn_literal_tool("    shown: \"strace -f -c {{probe}}\"") == Val("strace"))
    assert(dn_literal_tool("    run(jet, [String]{{\"debug\", \"prog.jet\"}})") == None)
    assert(dn_literal_tool("    run(jet, [String]{{\"perf\", \"run\", \"prog.jet\"}})") == None)
    assert(dn_literal_tool("    hidden: [String]{{\"lldb\", \"gdb\"}}") == None)
    assert(dn_literal_tool("    if comm == \"perf\" -> return true") == None)
    assert(dn_literal_tool("    reason: \"perf unavailable\"") == None)
    assert(dn_line_tool("case", "step: {{work}}/helper/main {{jet}} perf run --lens=cpu walk.jet", false) == None)
    assert(dn_line_tool("case", "step: strace -f -e inject=perf_event_open:error=ENOENT {{jet}} perf run walk.jet", false) == Val("strace"))
    assert(dn_line_tool("case", "step: sh -c '{{ objdump -d {{work}}/main; }}'", false) == Val("objdump"))
    assert(dn_run_kind("Tests/Cases/X/a.case", "") == "case")
    assert(dn_run_kind("Tools/Gauntlet/Entries/X/Fixtures/fake-perf", "#!/bin/sh\nexit 0\n") == "shell")
    assert(dn_run_kind("Tools/X/data", "plain\n") == "")
}
