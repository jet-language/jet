// Guard: every row of the accepted-failing ledger (Tests/known-failing.tsv)
// and every KNOWN-FAILING header names exactly one owning card, and that card
// is open on the live Tower board: listed, not archived and not done. Closing
// a card a row still names fails here, so the row moves to the card that owns
// the remaining work first. The reason names no card at all.
//
// The rule, the board choice (TOWER_DATA, else the main checkout's board,
// else this tree's) and their own tests live in one tool,
// Tools/Agent/KnownFailingOwner.jet, which Tools/Agent/LaneCheck.jet runs as
// its `known-failing-owner` tree check. This guard runs the same tool.
use {
    kfo_process: core.process
}

#Test("known_failing_owner") {
    guards_enter_root()
    jet: md_jet()
    ran: kfo_process.cmd([String]{jet, "Tools/Agent/KnownFailingOwner.jet", "--check"}).stdout(.Capture).stderr(.Capture).run() ?? panic("run Tools/Agent/KnownFailingOwner.jet: {err}")
    assert(ran.code == 0, kfo_process.combined_output(ran))
}
