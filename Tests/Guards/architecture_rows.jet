// Docs/Spec/architecture.md classifies every Core module: each module that
// Compiler/Prelude/Core.rows declares (a `module <name> exports` line) has a
// row `| `<name>` |` in its namespace classification table.
use ar_files: core.files

// The modules Core.rows declares, in file order.
ar_core_modules: fn(rows: String) -> [String] Never! {
    ^modules: [String]{}
    loop line in rows.lines() {
        if !line.starts_with("module ") -> next
        modules.push(line.split(" ").to_list()[1].to_string())
    }
    modules
}

#Test("architecture classifies every Core module") {
    guards_enter_root()
    rows: ar_files.read("Compiler/Prelude/Core.rows") ?? panic("read Compiler/Prelude/Core.rows")
    architecture: ar_files.read("Docs/Spec/architecture.md") ?? panic("read Docs/Spec/architecture.md")
    modules: ar_core_modules(rows)
    assert(modules.len() > 100, "Core.rows declares {modules.len()} modules; the module lines were not found")
    ^missing: [String]{}
    loop name in modules {
        if !architecture.contains("| `{name}` |") -> missing.push(name)
    }
    assert(missing.len() == 0, "architecture.md has no classification row for {missing.join(", ")}")
}
