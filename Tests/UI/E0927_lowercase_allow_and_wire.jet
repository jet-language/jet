// E0927: markers are PascalCase, so `#Allow(lint, "why")` is the one spelling
// of a lint allowance and the lowercase `#allow` is an unknown applied rule
// with a fix naming `#Allow`. The field marker `#wire` was retired outright
// (#4284 c66), so it is unknown too.
Account: struct {
    #wire id: Int,
}

run: fn() {
    #allow(Jet.HiddenCopyInLoop, "the lowercase spelling is not a marker") print("allow")
    #Allow(Jet.HiddenCopyInLoop, "the PascalCase spelling is the marker") print("Allow")
}
