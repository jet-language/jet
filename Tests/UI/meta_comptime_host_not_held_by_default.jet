// E3411: no package holds the expert effect `Meta.Host` by default, so the
// `#Impure` block alone doesn't let a file call run while compiling.
use fs: core.files

run: fn() {
    #Impure("probe a file while compiling") {
        found: #run fs.exists("meta_comptime_host_not_held_by_default.jet")
        print("{found}")
    }
}
