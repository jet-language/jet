// L0309: a struct with no fields whose body declares only static functions
// carries nothing in its values, so it is a module written as a type.
Geometry: struct {
    area: fn(width: Int, height: Int) -> Int { width * height }

    perimeter: fn(width: Int, height: Int) -> Int { 2 * (width + height) }
}

run: fn() {
    print(Geometry.area(3, 4))
    print(Geometry.perimeter(3, 4))
}
