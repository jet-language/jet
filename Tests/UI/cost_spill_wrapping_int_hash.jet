// L2511: an Int hash a loop multiplies by a factor each turn under
// `wrapping` or `saturating` leaves the packed Int rail for a bigint: on an
// unbounded Int either word is the exact product, which never wraps.
PRIME: 1099511628211

fnv: fn(data: [U8]) -> Int {
    h := -3750763034362895579
    loop b in data -> h = wrapping((h ~ Int{b}) * PRIME)
    h
}

polynomial: fn(data: [U8]) -> Int {
    h := 7
    loop b in data {
        h += Int{b}
        h = saturating(h * 31)
    }
    h
}

run: fn() {
    print(fnv([U8]{1, 2}))
    print(polynomial([U8]{1, 2}))
}
