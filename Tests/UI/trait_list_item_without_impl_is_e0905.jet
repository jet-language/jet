// A list item whose type does not implement the list's trait names the
// missing impl (E0905), the same for an exact number literal (a `Decimal`,
// whose impl is spelled through core.math) as for `Bool`.
Shown: trait {
    show: fn(self) -> String,
}

run: fn() {
    numbers: [Shown]{2.5}
    flags: [Shown]{true}
    loop item in numbers -> print(item.show())
    loop item in flags -> print(item.show())
}
