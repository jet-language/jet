use app

TaskView: struct {
    id: String,
}

BoardView: struct {
    project: String,
}

task_screen: fn(view: TaskView) -> String Never! { view.id }

graph: fn() -> app.App Never! { app.new("Crew").screen("/tasks/:id", task_screen) }

board_link: fn() -> String Never! { app.url_of(BoardView{project: "p1"}) }
