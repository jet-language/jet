// A type the program declares under a size name is its own: in this file
// `U8` names this struct, never Core's 8-bit whole number, in a parameter,
// a result and a typed literal alike.
U8: struct {
    label: String,
}

describe: fn(value: U8) -> String { "{value.label} is a user type" }

labelled: fn(label: String) -> U8 { U8{label: label} }

run: fn() {
    mine: U8{label: "mine"}
    print(describe(mine))
    print(describe(labelled("made")))
}
