// The `if` on line 9 never closes: the `}` at column 1 on line 14 closes it
// instead of `run`, so the end of the file comes before `run`'s `}`.

limit: 3

// Prints a count, and whether it passed the limit.
run: fn() {
    count: 5
    if count > limit {
        print("over the limit")
        print(count)
    print("done")
    print(limit)
}

helper: fn() -> Int { 1 }
