Counter: struct {
    value: Int?,
}

bump_local: fn() {
    ^maybe: Int?{Val(1)}
    if maybe.in_place() == {
        .Val(n) -> { n += 1 }
        .None -> {}
    }
    print(maybe ?? 0)
}

bump_field: fn() {
    ^counter: Counter{value: Val(10)}
    if counter.value.in_place() == {
        .Val(n) -> { n += 5 }
        .None -> {}
    }
    print(counter.value ?? 0)
}

bump_param: fn(slot: ^Int?) {
    if slot.in_place() == {
        .Val(n) -> { n *= 2 }
        .None -> {}
    }
}

run: fn() {
    bump_local()
    bump_field()
    ^held: Int?{Val(21)}
    bump_param(held)
    print(held ?? 0)
}
