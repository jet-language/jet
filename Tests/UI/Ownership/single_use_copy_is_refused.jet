// E0211: a `#SingleUse` value carries one duty, so a copy of it, or of a
// record that holds one, would let that duty be done twice.
#SingleUse Lease: struct {
    name: String
}

Holder: struct {
    lease: Lease
}

copy_value: fn(lease: Lease) -> Lease { lease.copy() }

copy_holder: fn(holder: Holder) -> Holder { holder.copy() }

run: fn() {}
