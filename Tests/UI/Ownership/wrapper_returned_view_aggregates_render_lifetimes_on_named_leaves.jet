Window: struct {
    _values: View<Int>,
}

Holder: struct {
    _maybe: Window?,
}

GenericHolder: struct<T> {
    _value: T,
    _maybe: Window?,
}

maybe: fn(values: [Int]) -[]> Window? {
    selected: values[0..1]
    return Val(Window{_values: selected})
}

result: fn(values: [Int]) -[]> Window Err! {
    selected: values[0..1]
    return Ok(Window{_values: selected})
}

tuple: fn(values: [Int]) -[]> {window: Window, count: Int} {
    selected: values[0..1]
    return {window: Window{_values: selected}, count: 1}
}

run: fn() { print(0) }
