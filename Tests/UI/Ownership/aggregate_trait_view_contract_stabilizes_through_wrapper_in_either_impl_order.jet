Pair: struct {
    _left: View<Int>,
    _right: View<Int>,
}

Select: trait {
    select: fn(self, left: [Int], right: [Int]) -[]> Pair,
}

wrapper: fn(selector: Select, left: [Int], right: [Int]) -[]> Pair {
    return selector.select(left, right)
}

First: struct {
    impl Select {
        select: fn(self, left: [Int], right: [Int]) -[]> Pair {
            left_view: left[0..1]
            right_view: right[0..1]
            return Pair{_left: left_view, _right: right_view}
        }
    }
}

Last: struct {
    impl Select {
        select: fn(self, left: [Int], right: [Int]) -[]> Pair {
            left_view: left[0..1]
            right_view: right[0..1]
            return Pair{_left: left_view, _right: right_view}
        }
    }
}

run: fn() { print(0) }
