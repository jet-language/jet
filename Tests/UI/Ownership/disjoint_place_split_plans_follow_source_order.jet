run: fn() {
    ^first_owner: [1, 2]
    first_left: first_owner[0].in_place()
    first_right: first_owner[1].in_place()
    print(first_left + first_right)

    ^second_owner: [3, 4]
    second_left: second_owner[0].in_place()
    second_right: second_owner[1].in_place()
    print(second_left + second_right)
}
