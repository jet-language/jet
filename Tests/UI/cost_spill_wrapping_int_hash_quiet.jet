// L2511, the no-fire pair of cost_spill_wrapping_int_hash: the same hashes
// on U64, where `wrapping` and `saturating` are one machine multiply that
// stays in 64 bits, never reach a bigint.
PRIME: U64{1099511628211}

fnv: fn(data: [U8]) -> U64 {
    h := U64{14695981039346656037}
    loop b in data -> h = wrapping((h ~ U64{b}) * PRIME)
    h
}

polynomial: fn(data: [U8]) -> U64 {
    h := U64{7}
    loop b in data {
        h = wrapping(h + U64{b})
        h = saturating(h * 31)
    }
    h
}

run: fn() {
    print(fnv([U8]{1, 2}))
    print(polynomial([U8]{1, 2}))
}
