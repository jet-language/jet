// A failure union naming a type parameter is read at the call's binding: a
// callback that can't fail leaves `total` failing with `ShopError` alone,
// and `ShopError` still has no route into the caller's `KeyError`.
#Error
ShopError: enum {
    Empty,
}

#Error
KeyError: enum {
    Blank,
}

total: fn<T, E>(rows: [T], weigh: fn(T) -> Int E!) -> Int (E | ShopError)! {
    if rows.len() == 0 -> return Err(ShopError.Empty)
    ^sum: 0
    loop row in rows -> sum += weigh(row)
    sum
}

lookup: fn(names: [String]) -> Int KeyError! {
    count: total(names, fn(n) { n.len() })
    Ok(count)
}

run: fn() { print(lookup([String]{"ab"}) ?? 0) }
