// An inline module body is one namespace, as a file's top level is: a nested
// module and a function may not share a name.
tools: module {
    text: module {
        shout: fn(s: String) -> String { s.to_upper() }
    }

    text: fn() -> String { "plain" }
}

run: fn() { print(tools.text.shout("hi")) }
