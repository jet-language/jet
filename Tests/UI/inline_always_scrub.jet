PII: tag { deny: [Exec] }

// E1016: a `#Scrub` routine stays a call, so `#Inline(Always)` cannot expand it.
#[Inline(Always), Scrub(PII)]
redact: fn(value: #PII String) -> String {
    // copy: the caller keeps its read-only `value`; the result owns its text
    value.copy()
}

run: fn() { print(redact(#PII #Input "secret")) }
