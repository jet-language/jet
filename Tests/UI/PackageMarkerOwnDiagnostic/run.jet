// A package marker refuses code with the package's own diagnostic: the
// `routes` package declares `#Served` and `BadPath`, and its marker's expand
// rejects the relative route here. The report is `routes.BadPath` with its
// texts and holes, at the marker use, and carries no Jet reference page.
use routes

#Routes.Served(path: "/") home: fn() -> String { "home" }

#Routes.Served(path: "about") about: fn() -> String { "about" }

run: fn() { print("{home()} {about()}") }
