// An exact number literal is a `Decimal`. At a bound by a trait this module
// declares, the missing impl is named (E0905), the way it is for `Int`; the
// bound's trait is in scope, so it isn't called unknown.
Shown: trait {
    shown: fn(self) -> String
}

show: fn<T: Shown>(value: T) -> String { value.shown() }

run: fn() {
    print(show(2.5))
    print(show(true))
}
