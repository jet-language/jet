// @check_goals
// `jet check` lists each `#Todo` goal's in-scope names that fit its type,
// ranked: locals nearest first, then parameters, then the module's own
// functions and then imported ones. `count` (an Int), `norm` (it returns an
// Int) and `shift` itself are no candidates. The goal is the function's last
// line, so its type is the return type.
use geometry
use geometry.[Point, midpoint, norm, origin]

home: fn() -> Point { Point{x: 1, y: 1} }

shift: fn(start: Point, steps: Int) -> Point {
    first: Point{x: start.x + steps, y: start.y}
    count: steps * 2
    moved: Point{x: first.x, y: count}
    if steps > 0 -> return moved
    #Todo
}

run: fn() {
    print(shift(home(), 3).x + norm(midpoint(home(), origin())))
}
