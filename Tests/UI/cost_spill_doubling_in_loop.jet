// L2511: an Int a loop doubles each turn with nothing in the
// loop's condition capping it leaves the packed Int rail for a bigint within
// a few dozen turns.
widen: fn(rows: [String]) -> Int {
    span := 1
    loop _ in rows -> span *= 2
    span
}

run: fn() { print(widen([String]{"a", "b"})) }
