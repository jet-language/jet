// Every mark position in the caret spelling, nested and layered: write and
// take parameters, receivers and their field footprints, function types that
// write and take, lambdas with marked parameters, windows into windows and
// element marks, a written match subject and a task that takes a name.
Counter: struct {
    hits: Int,
    log: [String],

    bump: fn(^self.hits) { self.hits += 1 }

    record: fn(^self.[log, hits], msg: ^^String) {
        self.bump()
        self.log.push(msg)
    }

    clear: fn(^self) { self.log = [String]{} }

    finish: fn(^^self) -> [String] { self.log }
}

Shape: enum {
    Dot(Int),
    Line(Int),
}

Step: struct {
    edit: fn(^[Int]) -> Int,
    keep: fn(^^[Int]) -> Int,
}

stretch: fn(shapes: ^[Shape]) {
    loop i in 0..<shapes.len() {
        slot: shapes[i].in_place()
        if slot.in_place() == {
            .Dot(size) -> { size += 1 }
            .Line(size) -> size += 2
        }
    }
}

through: fn(values: ^[Int], step: Step, owned: ^^[Int]) -> Int {
    window: values[0..<values.len()].in_place()
    inner: window[1..<3].in_place()
    first: inner[0].in_place()
    first = 10
    (step.edit)(values) + (step.keep)(owned)
}

total: fn(values: ^^[Int]) -> Int {
    ^sum: 0
    loop value in values -> sum += value
    sum
}

run: fn() {
    ^counter: Counter{hits: 0, log: [String]{}}
    counter.record("a")
    counter.bump()
    counter.clear()
    counter.record("b")
    print(counter.finish().len())

    ^shapes: [Shape]{.Dot(1), .Line(2)}
    stretch(shapes)

    ^values: [1, 2, 3, 4]
    step: Step{
        edit: fn(xs: ^[Int]) -> Int {
            xs.push(5)
            xs.len()
        },
        keep: total,
    }
    print(through(values, step, [7, 8]))

    owned: [3, 4]
    task.group adding {
        added: task ^^owned { total(owned) }
        print(added.join() ?? panic("adding failed"))
    }
}
