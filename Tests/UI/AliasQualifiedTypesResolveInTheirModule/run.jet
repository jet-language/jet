// A call reads the failure type and the parameter type another member file
// writes through its own import alias, as the declaring file resolves them.
offset: fn() -> Int {
    refuse("offset") ?? return err.byte_offset
}

described: fn() -> String {
    value: refuse("described") ?? return describe(err)
    "{value}"
}

run: fn() {
    print("{offset()} {described()}")
}
