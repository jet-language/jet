// Tests E0910: a #Codable(published) struct adds a field with no `add` migration,
// so old data has no value for it. The sibling .published.snapshot is the prior shape.
#Codable(published) Account: struct {
    name: String,
    verified: Bool,
}

run: fn() {
    a: Account{name: "Alice", verified: true}
    print("{a.name}")
}
