// A `#Error` failure passes up into `run`'s default `Err` with its text as
// the message. `ParseError` holds a retry function, which has no text, so
// the call in `run` has no route out.
#Error
ParseError: struct {
    retry: fn() -> Int,
}

no_retry: fn() -> Int { 0 }

parse_age: fn(raw: String) -> Int ParseError! {
    if raw == "" -> return Err(ParseError{retry: no_retry})
    Ok(42)
}

run: fn() {
    age: parse_age("7")
    print(age)
}
