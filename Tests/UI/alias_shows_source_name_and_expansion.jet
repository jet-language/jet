Grid<T>: [[T]]

total: fn(grid: Grid<Int>) -> Int { grid.len() }

firsts: fn() -> Grid<Int> { [Int]{1} }

run: fn() { print(total([Int]{1, 2})) }

Pairs<T>: [(T, T)]

count: fn(pairs: Pairs<Int>) -> Int { pairs.len() }

pairs_of: fn() -> Pairs<Int> { [Int]{1} }

counted: fn() -> Int { count([Int]{3, 4}) }
