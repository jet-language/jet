// E0181 stays quiet for each result a constructor may give: its own type,
// that type behind `?`, and one of its states.
Celsius: struct {
    degrees: Float,

    new: fn(degrees: Float) -> Celsius { Celsius{degrees: degrees} }
}

Reading: struct {
    value: Int,

    new: fn(value: Int) -> Reading? {
        if value < 0 -> return None
        Val(Reading{value: value})
    }
}

Gate: struct {
    state {
        Closed -> Open
        Open
    }

    _width: Int,

    new: fn(width: Int) -[]> Gate.Closed { Gate{_width: width} }

    open: fn(self: ^^Gate.Closed) -[]> Gate.Open { self }
}

run: fn() {
    print(Celsius.new(21.5).degrees)
    if Reading.new(3) == .Val(reading) -> print(reading.value)
    ^gate: Gate.new(2)
    gate = gate.open()
}
