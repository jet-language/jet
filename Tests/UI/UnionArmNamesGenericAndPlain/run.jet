// E0305: no `Box` is in scope, and two members' types are named `Box`
// (boxes' generic one and kit's), so the bare `.Box` names neither. The fix
// names each member by its arm, the generic one with its arguments.
use boxes
use kit

show: fn(item: boxes.Box<Int> | kit.Box) {
    if item == {
        .Box(_) -> print("a box")
    }
}

run: fn() {
    show(boxes.Box<Int>{v: 5})
    show(kit.Box{w: 6})
}
