// A `priv` type of the file module `geo` is private to that module: naming
// it here as a parameter type or building it is E0605, as for a `priv`
// function, and never an unknown type (E0119).
use geo

accepts: fn(s: geo.Secret) -> Bool { true }

run: fn() {
    print(geo.secret_key())
    print(geo.Secret{key: 1})
}
