// The `cypher` package's checked text head runs the package's `check` before
// the program runs: the rejection is the package's reason, reported at this
// line.
use cypher.[Cypher]

run: fn() {
    ^age: 42
    ^query: Cypher{"MATCH (p:Person WHERE p.age > {age} RETURN p"}
    print(query.text)
}
