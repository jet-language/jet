// @fixture_module
// A package's checked text head: `check` rejects an unbalanced query with
// the package's own reason.
#Error
CypherError: struct {
    reason: String,
}

Cypher: struct {
    text: String,
    params: [String],

    impl CheckedText {
        Error: CypherError,
        Hole: String,

        check: fn(parts: [String]) -[]> Checked<[String], TextSlot> CypherError! {
            ^depth: 0
            loop part in parts {
                loop byte in part.bytes() {
                    if byte == (U8{40}) -> depth += 1
                    if byte == (U8{41}) -> depth -= 1
                }
            }
            if depth != 0 -> return Err(CypherError{reason: "a Cypher query leaves a bracket open"})
            Ok(Checked{shape: parts.copy(), slots: loop _ in 1..<parts.len() -> TextSlot.Text})
        }

        encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> String { "{value}" }

        build: fn(shape: [String], holes: [String]) -[]> Cypher {
            Cypher{text: shape.join("$"), params: holes.copy()}
        }
    }
}
