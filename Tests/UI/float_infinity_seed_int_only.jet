// L0306: a Float seeded with infinity that every assignment sets to an Int.
use math: core.math

largest: fn(xs: [Int]) -> Float {
    best := -math.INFINITY
    loop d in xs {
        if d > best -> best = d
    }
    best
}

smallest: fn(xs: [Int]) -> Float {
    least := Float.INFINITY
    loop d in xs {
        if d < least -> least = d
    }
    least
}

run: fn() {
    print(largest([5, 3]))
    print(smallest([5, 3]))
}
