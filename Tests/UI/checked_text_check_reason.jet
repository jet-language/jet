// When `check` rejects a literal with an error whose type implements
// `Diagnostic`, E2712's Why line is the impl's `why`: here the reason the
// error carries.

#Error
RouteError: struct {
    reason: String,

    impl Diagnostic {
        code: "E2712",

        what: fn(self) -> String { "this checked text type rejected its body" }

        why: fn(self) -> String { "{self.reason}" }

        fix: fn(self) -> String { "fix the body so it satisfies the type's declared text grammar" }
    }
}

Route: struct {
    text: String,

    impl CheckedText {
        Error: RouteError,
        Hole: String,

        check: fn(parts: [String]) -[]> Checked<[String], TextSlot> RouteError! {
            if !parts[0].starts_with("/") {
                return Err(RouteError{reason: "a route must start with `/`"})
            }
            return Ok(Checked{shape: parts.copy(), slots: loop _ in 1..<parts.len() -> TextSlot.Text})
        }

        encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> String { "{value}" }

        build: fn(shape: [String], holes: [String]) -[]> Route { Route{text: shape.join("*")} }
    }
}

run: fn() {
    ^id: 7
    route: Route{"users/{id}"}
    print(route.text)
}
