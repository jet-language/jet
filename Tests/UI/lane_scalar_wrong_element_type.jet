// D-ARRAY-LANEBCAST1=A: lane-scalar broadcast requires the lane's exact
// element scalar type; a Float scalar does not broadcast with F32x4.
run: fn() {
    pixels: F32x4.new(F32{1.0}, F32{2.0}, F32{3.0}, F32{4.0})
    bad_right: pixels * Float{2.0}
    bad_left: Float{2.0} * pixels
    print(bad_right.lane(0))
    print(bad_left.lane(0))
}
