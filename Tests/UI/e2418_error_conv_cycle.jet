// E2418: error conversion graphs must not contain cycles.
#Error
SourceErr: enum {
    One,

    impl From(TargetErr) {
        from: fn(error: TargetErr) -> SourceErr { SourceErr.One }
    }
}

#Error
TargetErr: enum {
    One,

    impl From(SourceErr) {
        from: fn(error: SourceErr) -> TargetErr { TargetErr.One }
    }
}

run: fn() {}
