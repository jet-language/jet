// E0112: a value the checker owns whose runtime handle row has no display or
// show form (a process receipt, a process result, a UDP socket) is refused
// by `print` in the check instead of the build failing on it.
show_receipt: fn(receipt: ProcessReceipt) {
    print(receipt)
}

show_result: fn(result: ProcessResult) {
    print(result)
}

show_socket: fn(socket: UdpSocket) {
    print(socket)
}

run: fn() {}
