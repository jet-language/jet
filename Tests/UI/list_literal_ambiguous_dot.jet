// D-DOTCTOR2: an inferred construction stays rejected without context.
// D-LIT-DOT1=B spells it `{name: …}` — the dot dropped, the rule did not. A
// lone pun `{name}` is never a record, so a list of them names no type.
Fighter: struct {
    name: String,
}

run: fn() {
    name: "Ada"
    fighters: [{name}, {name}]
    print(fighters.len())
}
