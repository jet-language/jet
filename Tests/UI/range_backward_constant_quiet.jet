// Computed ends are never E0170: with `n == 0`, `0..n - 1` runs zero times,
// and `n..1` runs zero times for any `n` above 1 (D-RANGE-BACKWARD1=A).
count: fn(n: Int) -> Int {
    turns := 0
    loop i in 0..n - 1 -> turns += i + 1
    loop j in n..1 -> turns += j
    turns
}

run: fn() { print(count(0)) }
