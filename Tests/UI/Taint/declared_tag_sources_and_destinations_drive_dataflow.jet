use process: core.process

// `Untrusted`, a value tag from `source`, is declared at the end of the file.

source: fn() -> String { "untrusted" }

run: fn() {
    value := source()
    _: process.cmd(["echo", value])
}

#FX(!Exec)
Untrusted: struct {
    impl Marker {
        sites: [.TypeUse],
        from: [source]
    }
}
