// `Key`, a fixed-timing value tag, is declared at the end of the file.

select: fn(c: #Key U64, a: U64, b: U64) -> U64 {
    mask: wrapping(U64{0} - c)
    a & mask | b & (mask ~ U64{0xFFFFFFFFFFFFFFFF})
}

mix: fn(a: #Key U64, b: U64) -> U64 { wrapping(wrapping(a * b) + U64{1}) }

count: fn(keys: #Key [U8]) -> Int { keys.len() }

#FX(!Exec)
Key: struct {
    impl Marker {
        sites: [.TypeUse]
        timing: .Fixed
    }
}
