// `Key`, a fixed-timing value tag, is declared at the end of the file.

plain: fn(k: U64) -> U64 {
    if k == (U64{0}) -> return U64{1}
    k / U64{3}
}

forward: fn(k: #Key U64) -> U64 { plain(k) }

run: fn() {
    value: forward(U64{9})
    print("ran")
}

#FX(!Exec)
Key: struct {
    impl Marker {
        sites: [.TypeUse]
        timing: .Fixed
    }
}
