// `Key`, a fixed-timing value tag, is declared at the end of the file.

low: fn(x: U64) -> U64 { x % U64{7} }

mid: fn(x: U64) -> U64 { low(x ~ U64{1}) }

chain: fn(k: #Key U64) -> U64 { mid(k) }

through: fn(f: fn(U64) -> U64, k: #Key U64) -> U64 { f(k) }

#FX(!Exec)
Key: struct {
    impl Marker {
        sites: [.TypeUse],
        timing: .Fixed
    }
}
