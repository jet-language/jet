use process: core.process

// `Stored`, a value tag from `Store.read`, is declared at the end of the file.

Store: struct {
    value: String,

    read: fn(self) -> String { self.value }
}

run: fn() {
    ^store: Store{value: "Ada"}
    _: process.cmd(["echo", store.read()])
}

#FX(!Exec)
Stored: struct {
    impl Marker {
        sites: [.TypeUse],
        from: [Store.read]
    }
}
