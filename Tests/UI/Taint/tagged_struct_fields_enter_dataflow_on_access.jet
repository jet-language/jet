use process: core.process

// `PII`, a value tag, is declared at the end of the file.

Row: struct {
    secret: #PII String
}

run: fn() {
    row := Row{secret: "Ada"}
    process.run(["echo", row.secret]) ?? return Err("test")
}

#FX(!Exec)
PII: struct {
    impl Marker {
        sites: [.TypeUse]
    }
}
