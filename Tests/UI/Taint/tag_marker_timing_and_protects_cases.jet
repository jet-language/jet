#FX(!Exec)
Key: struct {
    impl Marker {
        sites: [.TypeUse],
        timing: .Constant
    }
}

#FX(!Exec)
Seal: struct {
    impl Marker {
        sites: [.TypeUse],
        timing: .Fixed,
        timing: .Free
    }
}

#FX(!Exec)
Trust: struct {
    impl Marker {
        sites: [.TypeUse],
        protects: .Authenticity
    }
}
