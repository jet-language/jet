// `Key`, a fixed-timing value tag, is declared at the end of the file.

first: fn(k: #Key U64, items: [U64]) -> #Key U64 {
    loop i in 0..<items.len() {
        if items[i] == k -> return U64{1}
        print("next")
    }
    U64{0}
}

#FX(!Exec)
Key: struct {
    impl Marker {
        sites: [.TypeUse],
        timing: .Fixed
    }
}
