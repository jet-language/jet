// D-CRYPTO-DIAG1=A: HKDF boundary literals and dynamic lengths remain valid.
use {
    crypto: core.crypto
    expert: core.crypto.expert
}

derive_dynamic: fn(length: Int) {
    #Unsafe("protocol-selected output length") {
        _dynamic: expert.hkdf_sha256_raw([1], [], [], length)
    }
}

run: fn() {
    _safe_min: crypto.hkdf_sha256([U8]{1}, [], [], 0)
    _safe_max: crypto.hkdf_sha256([U8]{1}, [], [], 8160)
    #Unsafe("fixed interop vectors") {
        _expert_min: expert.hkdf_sha256_raw([1], [], [], 0)
        _expert_max: expert.hkdf_sha256_raw([1], [], [], 8160)
    }
    derive_dynamic(8161)
}
