// L0306 stays quiet for the Int form, and for an infinity seed that takes a
// Float value on some path.
largest: fn(xs: [Int]) -> Int {
    best := Int.MIN
    loop d in xs {
        if d > best -> best = d
    }
    best
}

nearest: fn(xs: [Float]) -> Float {
    least := Float.INFINITY
    loop d in xs {
        if d < least -> least = d
    }
    least
}

scaled: fn(xs: [Int], scale: Float) -> Float {
    best := Float.NEG_INFINITY
    loop d in xs {
        if d > best -> best = d
    }
    if best < 0.0 -> best = scale
    best
}

run: fn() {
    print(largest([5, 3]))
    print(nearest([2.5, 1.5]))
    print(scaled([5, 3], 1.0))
}
