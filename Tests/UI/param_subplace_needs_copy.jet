Parcel: struct {
    label: String,
}

Holder: struct {
    _value: String,
}

Wrapped: enum {
    Val(String),
}

check: fn(parcel: Parcel, values: [String]) -> Holder {
    alias: parcel.label
    wrapped: Wrapped.Val(values[0])
    ^owned: "old"
    owned = parcel.label
    print(alias)
    print(wrapped)
    return Holder{_value: parcel.label}
}

run: fn() { print(0) }
