// E-SUBJECT-CALL: inside a loop with no binding `.carrier` reads the loop's
// item, so it is no field reference there.
use web: core.web

#Web.Form
ShipForm: struct {
    id: Int,
    carrier: String,
    tracking: String,
}

submit: fn(input: ShipForm) -> String { "shipped {input.id}" }

check: fn(value: String) {
    if value == "" -> return Err("carrier required")
}

run: fn() {
    form: web.form(ShipForm, action: submit)
    ships: [ShipForm]{ShipForm{id: 1, carrier: "Parcel", tracking: "PX-41"}}
    markup: loop ships -> form.validate(.carrier, on: .Blur, with: check).render()
    print(markup)
}
