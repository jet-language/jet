// A raw read through a fixed odd address is misaligned for an Int: the
// sentry names the address and the alignment the read needs.
use core.mem

run: fn() {
    #Unsafe("a fixed odd address stands for a misaligned pointer") {
        pointer: mem.Ptr<Int>.from_addr(4097)
        print(pointer.*)
    }
}
// @run_cli
