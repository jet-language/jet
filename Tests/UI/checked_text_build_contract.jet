// `Hole` and `build` are a pair: a `Hole` without `build` is E0907, as is a
// `build` whose holes are not `[Hole]` or whose result is not the owner.

#Error
TextError: enum {
    Empty,
}

Loose: distinct String

impl Loose.CheckedText {
    Error: TextError,
    Hole: Int,

    check: fn(parts: [String]) -[]> Checked<[String], TextSlot> TextError! { return Ok(Checked{shape: parts.copy(), slots: [TextSlot]{}}) }

    encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> Int { 0 }
}

Record: struct {
    text: String,

    impl CheckedText {
        Error: TextError,
        Hole: Int,

        check: fn(parts: [String]) -[]> Checked<[String], TextSlot> TextError! { return Ok(Checked{shape: parts.copy(), slots: [TextSlot]{}}) }

        encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> Int { 0 }

        build: fn(shape: [String], holes: [String]) -[]> String { shape.join("") }
    }
}

run: fn() {}
