// `#StepLimit(n)` on a lowercase module binding is that binding's own
// marker, so the binding's only problem is its casing: a module binding
// computed while building is a constant, named in ALL_CAPS.
total: fn(n: Int) -> Int {
    ^sum: 0
    loop i in 0..<n -> sum += i
    sum
}

#StepLimit(20000000) table: #run total(1000)

run: fn() { print("{table}") }
