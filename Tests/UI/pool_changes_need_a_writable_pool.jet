// `add`, `remove` and `slots[id] = v` change the store, so they need a
// writable binding (a changeable binding or a `^` parameter). Through a
// read-only `Slots<T>` parameter each one is the changeability error.
Player: struct {
    name: String,
}

retire: fn(world: Slots<Player>, id: ID<Player>) {
    world.remove(id).drop("only the refusal matters here")
}

recruit: fn(world: Slots<Player>) -> ID<Player> { world.add(Player{name: "Ash"}) }

rename: fn(world: Slots<Player>, id: ID<Player>) { world[id] = Player{name: "Rem"} }

run: fn() {
    ^world: Slots<Player>.new()
    kai: world.add(Player{name: "Kai"})
    retire(world, kai)
    rename(world, recruit(world))
}
