// Strong kids and weak parent back-edges never close a strong cycle.
Person: struct {
    name: String,
    _parent: Shared.Weak<Person>?,
    kids: [Shared<Person>],
}

run: fn() {
    mum: Shared{Person{name: "Ada", _parent: None, kids: []}}
    kid: Shared{Person{name: "Byron", _parent: Val(mum.downgrade()), kids: []}}
    mum.kids.push(kid)
    mum.kids.push(Shared{Person{name: "Cy", _parent: Val(mum.downgrade()), kids: []}})
    print("{mum.name} has {mum.kids.len()} kids")
}
