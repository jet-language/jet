// E0307: the table names only `.Int`, and its fix names the arm of each
// missing member: `.Point` for the module's own, `.geo2.Point` for geo2's.
use geo2

Point: struct {
    z: Int,
}

show: fn(item: Point | geo2.Point | Int) {
    if item == {
        .Int(n) -> print("int {n}")
    }
}

run: fn() {
    show(4)
}
