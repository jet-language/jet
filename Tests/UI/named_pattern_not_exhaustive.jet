#Error
FetchError: enum {
    BadURL(String),
    Timeout(seconds: Int, retries: Int),
}

#Error
AppError: enum {
    FailedToFetch(url: String, cause: FetchError),
    Offline,
}

query: fn(raw: String) -> String AppError! {
    if raw == "" -> return Err(.Offline)
    Ok(raw)
}

run: fn() {
    if query("") == {
        .Ok(page) -> { print(page) }
        .Err(.FailedToFetch{url, ..}) -> print(url)
    }
}
