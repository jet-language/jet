// E2421 names a `priv` failure carrier whole — even after this line's
// em dash, a character of three bytes, so a span slice counted in characters
// would start two bytes into the name.
#Error
priv MethodTokenError: struct {
    reason: String,
}

check_token: fn(token: String) -> Int MethodTokenError! {
    if token == "" -> return Err(MethodTokenError{reason: "empty"})
    Ok(token.len())
}

run: fn() {

}
