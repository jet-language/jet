// @all_diags
// Matching never builds a case: a case only named in match arms is never
// built.
Light: enum {
    Red,
    Green,
    Off,
}

describe: fn(light: Light) -> String {
    if light == {
        .Red -> "stop"
        .Green -> "go"
        .Off -> "dark"
    }
}

run: fn() {
    print(describe(.Red))
    print(describe(Light.Green))
}
