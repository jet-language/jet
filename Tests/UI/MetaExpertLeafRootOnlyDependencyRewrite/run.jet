// @programmable_build
// @cli_build
// E0777: `hook` rewrites its own `hello`, which uses `Meta.Code.Rewrite`.
// The main package consents to the rewrite but grants `hook` no expert
// effect; `hook`'s own `allow` row names it, but only the main package holds
// an expert effect.
use hook

build: fn(b: Build) {
    app: b.add_executable("app", ["run.jet"], [])
    meta: b.compiler(app)
    meta.allow_rewrite(package: "hook")
    hook.install(meta)
    b.default(app)
}

run: fn() { print(hook.hello()) }
