// @all_diags
// A `:=` binding in a generic module body that nothing writes is reported at
// the binding, the template text its `:` edit rewrites for every instance,
// once, however many instances expand the template.
tally: module<K>(start: Int) {
    total: fn(items: [K]) -> Int {
        count := start
        count + items.len()
    }
}

ints: tally<Int>(1)
names: tally<String>(2)

run: fn() {
    print(ints.total([Int]{1, 2}) + names.total([String]{"a"}))
}
