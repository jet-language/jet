// A choice whose alternatives the next three tokens do not tell apart is
// E2720 at the choice, with the shared start as text.
use core.grammar.[Grammar]

Command: Grammar{"""
    command : 'set' 'the' 'value' to=NAME # Name
            | 'set' 'the' 'value' to=NUM # Number
            ;
    NAME    : [a-z]+ ;
    NUM     : [0-9]+ ;
    WS      : ' '+ -> skip ;
    """}

run: fn() {}
