// A type parameter spelled like a size name is the parameter: inside its
// declaration `U8` and `U16` stand for whatever type the caller gives.
same: fn<U8>(value: U8) -> U8 { value }

Holder: struct<U16> {
    item: U16,
}

run: fn() {
    print(same("text"))
    held: Holder<String>{item: "held"}
    print(held.item)
}
