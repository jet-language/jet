// A larger union does not pass where a smaller one is expected: `Bool` is
// not one of `hold`'s cases.
hold: fn(cell: Int | String) -> String {
    if cell == {
        .Int(n) -> "int {n}"
        .String(s) -> "text {s}"
    }
}

wide: fn() -> Bool | Int | String { false }

run: fn() { print(hold(wide())) }
