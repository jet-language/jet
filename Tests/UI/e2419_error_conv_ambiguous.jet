// E2419: one source may have only one conversion route to a target.
#Error
RootErr: enum {
    One,
}

#Error
LeftErr: enum {
    One,

    impl From(RootErr) {
        from: fn(error: RootErr) -> LeftErr { LeftErr.One }
    }
}

#Error
RightErr: enum {
    One,

    impl From(RootErr) {
        from: fn(error: RootErr) -> RightErr { RightErr.One }
    }
}

#Error
TargetErr: enum {
    One,

    impl From(LeftErr) {
        from: fn(error: LeftErr) -> TargetErr { TargetErr.One }
    }

    impl From(RightErr) {
        from: fn(error: RightErr) -> TargetErr { TargetErr.One }
    }
}

run: fn() {}
