// A type the program declares under a number family's name is its own:
// `Signed<8>` here names this struct, never Core's 8-bit whole number.
Signed: struct<bits: Int> {
    label: String,
}

describe: fn(value: Signed<8>) -> String { "{value.label} is a user type" }

run: fn() {
    mine: Signed<8>{label: "mine"}
    print(describe(mine))
}
