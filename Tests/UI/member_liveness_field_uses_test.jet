// @all_diags
// A checked test reads what it reads: a field only a test reads is read, and
// a field nothing reads is still reported.
Ticket: struct {
    seat: String,
    price: Int,
    gate: String,
}

make_ticket: fn() -> Ticket { Ticket{seat: "12A", price: 40, gate: "B"} }

run: fn() { print(make_ticket().seat) }

#Test("a ticket costs 40") {
    assert_eq(make_ticket().price, 40)
}
