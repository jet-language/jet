// An arm E0305 refused still declares its binding, so the binding's uses add
// no E0107: the arm's report is the only one.
show: fn(value: Int | String) {
    if value == {
        .Int(n) -> print(n)
        .String(s) -> print(s)
        .Txt(t) -> {
            size: t.len()
            print(t)
            print(size)
        }
    }
}

run: fn() {
    show(1)
}
