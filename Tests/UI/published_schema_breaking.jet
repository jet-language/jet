// Tests E0910: #Codable(published) struct drops a field without a migration.
// The sibling .published.snapshot supplies the prior snapshot (field `name: String`).
#Codable(published) UserRecord: struct {
    display_name: String,
    age: Int,
}

run: fn() {
    r: UserRecord{display_name: "Alice", age: 30}
    print("{r.display_name}")
}
