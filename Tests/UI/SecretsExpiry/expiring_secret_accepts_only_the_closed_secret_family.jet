use {
    crypto: core.crypto
    vault: core.crypto.vault
}

run: fn() {
    ^clock: Clock.new(0)
    ^ttl: Duration.seconds(1) ?? panic("duration")
    ^bytes: crypto.Secret.from_text("bytes")
    ^signing: crypto.SigningKey.new_random() ?? panic("signing")
    ^agreement: crypto.X25519SecretKey.new_random() ?? panic("agreement")
    ^_first: vault.ExpiringSecret.new(bytes, ttl, clock)
    ^_second: vault.ExpiringSecret.new(signing, ttl, clock)
    ^_third: vault.ExpiringSecret.new(agreement, ttl, clock)
}
