use {
    http: core.http
    server: core.http.server
    web: core.web
}

ID: "42"

Record: struct {
    id: Int,
}

handle: fn(req: HTTPRequest) -> HTTPResponse HTTPError! { Ok(server.response(200, "ok")) }

// core.http's StaticRoutes rule refuses a router's or App's path written as a
// String literal with holes, an App's page, route or layout path too, each
// hole as `{name}`, or `{…}` when it is not a bare name. A literal in parens,
// a raw String and a `+` join are not such a literal; the ordinary checks do.
run: fn() {
    router: http.router()
    id: "42"
    record: Record{id: 7}
    router.get(("/a/{id}"), handle)
    router.get("/b/{ID}", handle)
    router.get("/c/{id:Debug}", handle)
    router.post("/d/{record.id}", handle)
    router.put("/e/{"x"}", handle)
    router.get("/f/{{lit}}/{id}", handle)
    router.get(`/g/{id}`, handle)
    router.get("/h/" + id, handle)
    router.custom("PURGE", "/i/{id}", handle)
    app: web.app()
    app.get("/j/{id}", handle)
    app.route("/k/{id}", home)
}

home: fn() -> WebPage { web.page("Home", "body") }
