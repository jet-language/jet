// A module binding computed while building raises its step limit with
// `#StepLimit(n)`. It is a budget, not an effect, so it needs no grant.
total: fn(n: Int) -> Int {
    ^sum: 0
    loop i in 0..<n -> sum += i
    sum
}

#StepLimit(20000000) TABLE: #run total(1000)

run: fn() { print("{TABLE}") }
