// E0205 on a dead-key layout: `^` then `e` composes `ê`, so the write
// parameter `^entries` arrives as a read parameter named `êntries`. The fix
// names the dead key and writes the mark back.
add: fn(êntries: [Int]) {
    êntries.push(1)
}

run: fn() {
    xs := [Int]{}
    add(xs)
    print(xs.len())
}
