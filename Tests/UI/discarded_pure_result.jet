// L0508 (D-DISCARD1=A): a value that goes nowhere is a tidy error. A pure
// call whose result is dropped does nothing, and a function with no written
// return type loses the value of its last line.
double: fn(n: Int) -> Int { n * 2 }

total: fn(a: Int, b: Int) { a + b }

run: fn() {
    double(3)
    total(1, 2)
    print("done")
}
