// D-QUAL2: a value tag is a marker with no methods. Declaring a method on one
// is E0732 — the fix is to make it a `trait` (if the method should dispatch)
// or drop the method (to keep it a marker).
#FX(!Net)
Reviewed: struct {
    review: fn(self) -> Int { 1 }

    impl Marker {
        sites: [.TypeUse]
    }
}

run: fn() {
    print("ok")
}
