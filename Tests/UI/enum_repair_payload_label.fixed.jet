Shape: enum {
    Circle(r: Float),
    Rect(w: Float, h: Float),
}

area: fn(shape: Shape) -> Float {
    if shape == {
        .Circle(r) -> 3.0 * r * r
        .Rect{w: width, h: height} -> width * height
    }
}

span: fn(shape: Shape) -> Float {
    if shape == {
        .Circle(r) -> 2.0 * r
        .Rect{w, h: height} -> w + height
    }
}

run: fn() {
    print(area(Shape.Rect{w: 2.0, h: 3.0}))
    height: 4.0
    print(span(Shape.Rect{w: 1.0, h: height}))
    print(span(Shape.Circle{r: 1.0}))
}
