// `^self` on a dead-key layout: `^` then `s` composes `ŝ`, so the write
// receiver `^self` arrives as a parameter named `ŝelf`. The fix names the
// dead key and writes `^self` back.
Counter: struct {
    n: Int,

    bump: fn(ŝelf) {
        self.n += 1
    }
}

run: fn() {
    counter := Counter{n: 1}
    counter.bump()
    print(counter.n)
}
