// L2511: a map edit a loop repeats is a tidy error only when the
// same loop shares the map each turn, so every edit clones the whole map.
// Here each turn keeps a snapshot of `counts`, then edits it.
history: fn(keys: [String]) -> [[String:Int]] {
    ^counts: [String:Int]{}
    ^out: [[String:Int]]{}
    loop key in keys {
        out.push(counts.copy())
        counts[key] = out.len()
    }
    out
}

run: fn() { print(history([String]{"a", "b"}).len()) }
