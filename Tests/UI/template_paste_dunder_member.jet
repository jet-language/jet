// A package's marker template can't paste a reserved `__` name for a member
// it declares: its pastes are its own writing, so E0067 applies as it does to
// its source.
Hidden: struct {
    impl Marker {
        sites: [.Type],

        expand: fn(self, target: Target) {
            hook: "__hidden_hook"
            #{hook}: fn(self) -> String { "reached the hook" }
        }
    }
}

#Hidden
Box: struct {
    n: Int,
}

run: fn() { print(Box{n: 1}.n) }
