// A value whose type has no `Display` gets E0915, which quotes the type's
// name once, in the What line. `ParseError` has no Debug form and Core owns
// it, so the Fix offers neither `:Debug` nor an `impl`.
run: fn() {
    n: Int.parse("x") ?? {
        print("couldn't read {err}")
        0
    }
    print(n)
}
