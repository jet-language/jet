// `helpers` is a `priv module` and a re-export is public, so `shapes` can't
// re-export it; the fix lists the members to re-export one by one instead.
priv helpers: module {
    double: fn(n: Int) -> Int { n * 2 }

    half: fn(n: Int) -> Int { n / 2 }
}

shapes: module {
    tools: helpers
}

run: fn() {}
