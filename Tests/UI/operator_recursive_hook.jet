Vec2: struct {
    x: Int,
    y: Int,

    impl Add {
        add: fn(self, rhs: Vec2) -> Vec2 {
            first: self + rhs
            literal: Vec2{x: 0, y: 0} + Vec2{x: 0, y: 0}
            return rhs + self
        }
    }

    // Another right-hand type picks another hook: this `+` calls `impl Add`.
    impl Add(Int) {
        add: fn(self, rhs: Int) -> Vec2 {
            self + Vec2{x: rhs, y: rhs}
        }
    }
}

run: fn() {

}
