// L2511, the no-fire pair of cost_spill_doubling_in_loop: a
// doubling the loop's condition compares against any Int, alone or times
// some Int, stops below twice that Int, a sum never reaches the rail's
// end in any loop's turns, and an element whose index is the loop's
// variable is scaled once, never carried into the next turn.
fit: fn(slots: Int) -> Int {
    capacity := 2
    loop capacity < slots -> capacity *= 2
    capacity
}

octave: fn(micros: Int) -> Int {
    whole := 0
    span := 1
    loop span * 2 <= micros {
        span *= 2
        whole += 1
    }
    whole
}

weigh: fn(weights: [Int]) -> Int {
    total := 0
    loop weight in weights -> total += weight
    total
}

scale: fn(xs: ^[Int], k: Int) {
    loop i in 0..<xs.len() -> xs[i] = xs[i] * k
}

run: fn() {
    print(fit(5))
    print(octave(40))
    print(weigh([Int]{1, 2, 3}))
    xs := [Int]{1, 2, 3}
    scale(xs, 4)
    print(xs[2])
}
