// @programmable_build
// @cli_build
// A step that would write Jet source outside the project reaches past what
// the build owns, so the plan is refused at the `.writes` call (E3502)
// before any step runs or any module is written.
build: fn(b: Build) -[Exec]> {
    #Impure("find the shell") {
        b.generate("facts") {
            answer: fn() -> Int { 42 }
        }
        shell: b.probe("shell", "find_program", "sh")
        make: b.run("make", b.found(shell), [])
        make.writes("../shared/models.jet")
    }
}

run: fn() {}
