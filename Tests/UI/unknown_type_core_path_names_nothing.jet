// A dotted type path names a declaration, or it is refused as a path through
// an unknown package is. Core has no `World`. core.math does export `Point2`,
// but a file names it through the module it imports, `math.Point2`.
place: fn(world: core.World, point: core.math.Point2) -> Int { 1 }

elsewhere: fn(thing: nosuch.Thing) -> Int { 1 }

run: fn() {}
