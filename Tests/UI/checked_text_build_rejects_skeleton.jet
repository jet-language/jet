// A checked text type with `build` checks its literal parts before the
// program runs; an unbalanced skeleton is E2712 at the literal, whatever
// the holes hold.

#Error
QueryError: enum {
    Unbalanced,
}

Query: struct {
    text: String,
    params: [String],

    impl CheckedText {
        Error: QueryError,
        Hole: String,

        check: fn(parts: [String]) -[]> Checked<[String], TextSlot> QueryError! {
            ^depth: 0
            loop byte in parts.join("").bytes() {
                if byte == (U8{40}) -> depth += 1
                if byte == (U8{41}) -> depth -= 1
            }
            if depth != 0 -> return Err(QueryError.Unbalanced)
            return Ok(Checked{shape: parts.copy(), slots: loop _ in 1..<parts.len() -> TextSlot.Text})
        }

        encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> String { "{value}" }

        build: fn(shape: [String], holes: [String]) -[]> Query {
            Query{text: shape.join("?"), params: holes.copy()}
        }
    }
}

run: fn() {
    ^close: ")"
    query: Query{"MATCH (p WHERE p.name = {close}"}
    print(query.text)
}
