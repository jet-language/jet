// A `Slots<T>` parameter without `^` is read-only: `add` and `remove` change
// the store, so each is refused through it. A changeable local and a `^` parameter
// change their store with no mark at the call.
Player: struct {
    name: String,
    hp: Int,
}

spawn: fn(world: Slots<Player>) -> ID<Player> { world.add(Player{name: "Kai", hp: 100}) }

despawn: fn(world: Slots<Player>, id: ID<Player>) { _: world.remove(id) }

respawn: fn(world: ^Slots<Player>, id: ID<Player>) -> ID<Player> {
    _: world.remove(id)
    world.add(Player{name: "Kai", hp: 100})
}

run: fn() {
    ^world: Slots<Player>.new()
    kai: world.add(Player{name: "Kai", hp: 100})
    again: respawn(world, kai)
    print(world.ids().len())
    despawn(world, again)
    _: spawn(world)
}
