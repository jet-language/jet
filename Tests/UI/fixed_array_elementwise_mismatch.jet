// E0446: an operator on fixed arrays pairs slot with slot, so the arrays need
// one length and one element type, and a value beside an array needs the
// slots' type.
run: fn() {
    three: [Int#3]{1, 2, 3}
    four: [Int#4]{1, 2, 3, 4}
    floats: [Float#3]{1.0, 2.0, 3.0}
    scale: floats[0]
    print(three + four)
    print(three * floats)
    print(three * scale)
}
