// The main package names the expert effect `Meta.Host` in its `allow` row, so
// the file call of the `#Impure` block runs while compiling.
package: { name: "main", authority: { allow: [Meta.Host] } }

use fs: core.files

run: fn() {
    #Impure("probe a file while compiling") {
        found: #run fs.exists("meta_comptime_host_held.jet")
        print("{found}")
    }
}
