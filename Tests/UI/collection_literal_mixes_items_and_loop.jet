// A typed head holds either its items or one loop that builds them, so a
// literal that mixes the two is refused, for a list and a map alike.
run: fn() {
    xs: [1, 2, 3]
    values: [Int]{0, loop x in xs -> x * 2}
    words: ["a", "b"]
    sizes: [String:Int]{"z": 0, loop w in words -> w: 1}
    print(values)
    print(sizes)
}
