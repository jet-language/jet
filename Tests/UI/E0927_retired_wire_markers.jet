// E0927: the wire markers are options of `#Codable` now, and a distinct type
// codes as its base without a marker. `#PublishedSchema`, `#Skip`,
// `#Discriminant` and `#CodableAsBase` are not markers; the codable-options1
// migration plan rewrites them.
#PublishedSchema
Account: struct {
    id: Int,
    #Skip cache: Int,
}

#Discriminant("kind")
Shape: enum {
    Circle(radius: Int),
    Dot,
}

#CodableAsBase
UserID: distinct String

run: fn() { print("ok") }
