byte: fn(value: Unsigned<8>) -> Int { Int{value} }

word: fn(value: Signed<32>) -> Int { Int{value} }

ratio: fn(value: IEEE<8, 23>) -> Float { Float{value} }

wide: fn(value: IEEE<11, 52>) -> Float { value }

run: fn() {
    print(byte("one"))
    print(word("two"))
    print(ratio("three"))
    print(wide("four"))
}
