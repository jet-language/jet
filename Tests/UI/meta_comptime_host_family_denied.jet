// E3411: the package's `deny: [Meta]` covers `Meta.Host`, and a deny wins
// over the `allow` row that names it.
package: { name: "main", authority: { allow: [Meta.Host], deny: [Meta] } }

use fs: core.files

run: fn() {
    #Impure("probe a file while compiling") {
        found: #run fs.exists("meta_comptime_host_family_denied.jet")
        print("{found}")
    }
}
