// E0305: no `Point` is in scope, and a bare `.Point` arm over
// `geo2.Point | map2.Point` names both members, so it names neither; the
// fix names each member's arm.
use {
    geo2
    map2
}

show: fn(item: geo2.Point | map2.Point) {
    if item == {
        .Point(_) -> print("a point")
    }
}

run: fn() { show(geo2.Point{x: 1, y: 2}) }
