// A written failure contract is a ceiling. `both` promises only
// `ParseError`, but its body also calls `load`, which fails with
// `DiskError`; that failure is outside the contract, so E2404 names it and
// the call that brings it in.
#Error
ParseError: enum {
    Empty
}

#Error
DiskError: enum {
    Missing
}

parse: fn(text: String) -> Int ParseError! {
    if text == "" -> return Err(ParseError.Empty)
    text.len()
}

load: fn(path: String) -> Int DiskError! {
    if path == "" -> return Err(DiskError.Missing)
    path.len()
}

both: fn(path: String) -> Int ParseError! {
    size: load(path)
    parse(path) + size
}

run: fn() { print(both("data") ?? 0) }
