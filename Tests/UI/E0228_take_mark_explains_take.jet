// A `^^` take mark on a field or copied type explains that the callee takes
// the input, never claiming the callee "reads this input".
Holder: struct {
    buf: [Int],
}

seal: fn(xs: ^^[Int]) {
    print(xs.len())
}

take_n: fn(n: ^^Int) {
    print(n)
}

run: fn() {
    st: Holder{buf: [Int]{1}}
    seal(^^st.buf)
    n: 3
    take_n(^^n)
}
