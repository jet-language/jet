// D-TEST1 fixture: a property test whose parameter type (a user struct
// holding a map) has no automatic value generator, so the runner rejects it
// with E0613.
Point: struct {
    x: Int,
    tags: [String:Int],
}

run: fn() { print("p") }

#Test uses_point: fn(pt: Point) {
    assert((pt.x == pt.x))
}
