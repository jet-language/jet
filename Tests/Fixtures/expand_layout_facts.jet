// D-LAYOUT-FACTS1=B: the CLI projects the same typed layout model used by
// focused `T.reflect().layout` and full reflection.
PlainPacket: struct {
    count: Int,
    label: String,
}

#Layout(c) CPacket: struct {
    count: U32,
    flag: U8,
}

#Layout(columnar) ColumnPacket: struct {
    count: Int,
    label: String,
}

PacketState: enum {
    Ready,
    Failed(String),
}

// A generic enum lays out per instance, so its declaration has no byte facts.
Slot: enum<T> {
    Full(T),
    Empty,
}

run: fn() {}
