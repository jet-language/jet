// A `Slots<T>` hands out `ID<T>` handles; an
// entry can hold an optional handle to another entry of the same store.
Node: struct {
    text: String,
    left: ID<Node>?,
}

run: fn() {
    ^world: Slots<Node>.new()
    a: world.add(Node{text: "a", left: None})
    b: world.add(Node{text: "b", left: None})
    world[b].left = a
    print(world[a].text)
    if world[b].left == .Val(link) -> print(world[link].text)
    print(world.ids().len())
}
