// A pool's `ID<T>` is a plain index and generation, so it shows as that
// record whatever `T` is: printed, interpolated and under Debug alike.
Node: struct {
    value: Int,
}

run: fn() {
    ^pool: Slots<Node>.new()
    id: pool.add(Node{value: 1})
    second: pool.add(Node{value: 2})
    print(id)
    print("{second}")
    print("{id:Debug}")
    print([id, second])
    print("{[id, second]:Debug}")
}
