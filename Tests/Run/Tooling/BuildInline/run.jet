// Which calls are inlined. `#Inline(Always)` ones always, on every tier
// (`jet run` too) and under every `inline` value; the value picks the rest:
//   jet build run.jet                         inline: auto, other callees picked by size
//   jet build --inline=always_marked run.jet   no other callee
//   jet build --profile=plain run.jet         inline: off, from the profile: no other callee
// The program prints the same under every value.
#Inline(Always) scale: fn(x: Int, factor: Int) -> Int { (x * factor + 7) % 1000 }

shift: fn(x: Int) -> Int { (x + 3) % 1000 }

run: fn() {
    values: [Int]{4, 8, 15, 16, 23, 42}
    total := 0
    loop value in values -> total = shift(scale(total + value, 3))
    print("total: {total}")
}
