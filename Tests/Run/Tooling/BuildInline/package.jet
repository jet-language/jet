// The `inline` build option says which unmarked callees the optimizer
// inlines at `optimize: O1` and `O2`: `auto` (the stock) picks them by
// size, and `always_marked` and `off` take none. Every `#Inline(Always)`
// callee is inlined under all three, on every tier. The same row is the
// flag `--inline=off` and the `build: fn` call `b.inline(.Off)`.
name: "build_inline_example"
version: "0.1.0"
edition: "2026"

build: {
    plain: Build{
        inline: off
    },
}
