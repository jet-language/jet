Point: struct {
    x: Int,
    _y: Int,
}

Shape: enum {
    Dot(Point),
    _Line(Int),
}

mk: fn(p: Point) -> Shape { return Shape.Dot(p.copy()) }

first: fn(s: Shape) -> Int {
    if s == {
        .Dot(p) -> { return p.x }
        ._Line(n) -> { return n }
    }
    return 0
}

run: fn() {
    pt: Point{x: 3, _y: 4}
    sh: mk(pt)
    print("{first(sh)}")
}
