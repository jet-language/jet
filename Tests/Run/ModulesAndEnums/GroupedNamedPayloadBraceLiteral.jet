Signal: enum {
    _Quit,
    Paint {
        Fill(Int),
        Stroke(width: Int, style: Int),
    },
}

describe: fn(signal: Signal) -> String {
    if signal == {
        ._Quit -> "quit"
        .Paint.Fill(amount) -> "fill {amount}"
        .Paint.Stroke(width, style) -> "stroke {width} {style}"
    }
}

run: fn() {
    stroke: Signal.Paint.Stroke{width: 2, style: 5}
    print(describe(stroke))
    print(describe(Signal.Paint.Fill(3)))
}
