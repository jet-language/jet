Msg: enum {
    Text(String),
    _Code(Int),
}

wrap: fn(s: String) -> Msg { return Msg.Text(s.copy()) }

render: fn(m: Msg) -> String {
    if m == {
        .Text(s) -> { return s }
        ._Code(n) -> { return "code" }
    }
    return "?"
}

run: fn() {
    m: wrap("hi")
    print(render(m))
}
