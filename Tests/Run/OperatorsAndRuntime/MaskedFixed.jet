// A fixed-width conversion of a masked Int, `U8{x & 255}`, is the
// masked value for every Int: negative, inline and beyond 64 bits (the
// optimizer makes it a move when the mask fits the width).
low_bytes: fn(value: Int) -> [U8] {
    [U8]{U8{value & 255}, U8{(value >> 8) & 255}, U8{(value >> 56) & 255}}
}

masked: fn(value: Int) -> String {
    a: I8{value & 127}
    b: I16{value & 0x7fff}
    c: U32{value & 0xffffffff}
    d: I64{Int{255} & value}
    "{a} {b} {c} {d}"
}

run: fn() {
    print(low_bytes(0x1122334455667788))
    print(low_bytes(-2))
    print(low_bytes((1 << 70) + 0x1ff))
    print(masked(-1))
    print(masked(0x123456789))
    print(masked((1 << 80) - 3))
}
