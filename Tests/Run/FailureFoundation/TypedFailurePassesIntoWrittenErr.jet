// A failure whose type the program marks `#Error`, the type minted from an
// unannotated function's cases, and a union of those with `Err` each pass
// into a written `Err!` contract with no declared conversion. The `Err`
// carries the failure's text.
#Error
FetchError: enum {
    Missing(String),
    Slow,
}

fetch_count: fn(raw: String) -> Int FetchError! {
    if raw == "" -> return Err(.Missing("blank"))
    if raw == "s" -> return Err(.Slow)
    7
}

find_age: fn(raw: String) -> Int {
    if raw == "" -> return Err(.Blank)
    if raw == "z" -> return Err(.NotFound(raw.copy()))
    36
}

age_of: fn(raw: String) -> Int {
    if raw == "x" -> return Err("odd input")
    find_age(raw) + 1
}

via_fetch: fn(raw: String) -> Int Err! { fetch_count(raw) }

via_find: fn(raw: String) -> Int Err! { find_age(raw) }

via_age: fn(raw: String) -> Int Err! { age_of(raw) }

run: fn() {
    loop raw in ["7", "", "s"] {
        if via_fetch(raw) == {
            .Ok(n) -> { print("fetch {n}") }
            .Err(e) -> print("fetch failed: {e}")
        }
    }
    loop raw in ["a", "", "z"] {
        if via_find(raw) == {
            .Ok(n) -> { print("find {n}") }
            .Err(e) -> print("find failed: {e}")
        }
    }
    loop raw in ["a", "x", "z"] {
        if via_age(raw) == {
            .Ok(n) -> { print("age {n}") }
            .Err(e) -> print("age failed: {e}")
        }
    }
}
