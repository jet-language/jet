// A function that takes a parameter by move (`^`) and returns it as its tail
// hands the same value back: the parameter's scope-end release never runs,
// because the value left through the return.
Row: struct {
    name: String,
}

keep_row: fn(row: ^^Row) -> Row Never! { row }

keep_text: fn(text: ^^String) -> String Never! { text }

renamed: fn(row: ^^Row, name: String) -> Row Never! {
    out := row
    out.name = name
    out
}

run: fn() {
    print(keep_row(Row{name: "a"}).name)
    print(keep_row(keep_row(Row{name: "b"})).name)
    print(keep_text("c"))
    print(renamed(keep_row(Row{name: "d"}), "e").name)
}
