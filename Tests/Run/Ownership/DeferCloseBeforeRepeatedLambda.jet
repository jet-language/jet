// A `defer close(name)` written before a lambda that may run more than once
// belongs to the enclosing body: the lambda never moves `name`, so it is no
// E0121, and the close still runs when the body's scope exits.
Resource: struct {
    name: String,

    impl Close {
        close: fn(&&self) { print("close {self.name}") }
    }
}

apply_twice: fn(f: fn()) {
    f()
    f()
}

run: fn() {
    first := Resource{name: "first"}
    defer close(first)
    apply_twice(fn() { print("again") })
    print("body")
}
