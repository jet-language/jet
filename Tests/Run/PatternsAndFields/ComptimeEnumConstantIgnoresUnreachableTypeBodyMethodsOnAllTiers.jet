COLORS: #run { [Color]{Color.Red, Color.Green} }

Color: enum {
    Red,
    Green,

    code: fn(self) -> Int { 7 }
}

#Allow(Jet.StaticOnlyStruct, "the golden calls a static function of a type body beside a build-time constant") Holder: struct {
    one: fn() -> Int { 1 }
}

run: fn() {
    print(COLORS.len())
    red: Color.Red
    print(red.code())
    print(Holder.one())
}
