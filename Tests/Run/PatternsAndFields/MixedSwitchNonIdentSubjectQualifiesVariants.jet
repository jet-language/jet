Light: enum {
    Red,
    _Green,
    _Yellow,
}

pick: fn() -> Light { return Light.Red }

classify: fn() -> Int {
    if pick() == {
        .Red -> {
            return 1
        }
        ._Green -> {
            return 2
        }
        ._Yellow -> {
            return 0
        }
    }
}

run: fn() { print(classify()) }
