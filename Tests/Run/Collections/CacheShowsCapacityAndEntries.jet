// A `Cache<K, V>` shows its capacity and its entries, each key and value in
// the form asked for: printed, interpolated and under Debug alike.
run: fn() {
    ^cache: Cache<Int, Int>.new(2)
    cache.add(1, 10).drop("new")
    cache.add(2, 20).drop("new")
    print(cache)
    print("{cache}")
    print("{cache:Debug}")
    print([cache])
}
