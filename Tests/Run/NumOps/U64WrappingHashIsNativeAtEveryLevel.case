# The U64 FNV-1a hash of 1 MB runs at O0, O1 and O2 within a bound far
# below what a bigint product per byte would take.
step: jet run -O0 U64WrappingHashIsNativeAtEveryLevel.jet
limit: time=10
exit: 0
stdout: = U64WrappingHashIsNativeAtEveryLevel.out
step: jet run -O1 U64WrappingHashIsNativeAtEveryLevel.jet
limit: time=10
exit: 0
stdout: = U64WrappingHashIsNativeAtEveryLevel.out
step: jet run -O2 U64WrappingHashIsNativeAtEveryLevel.jet
limit: time=10
exit: 0
stdout: = U64WrappingHashIsNativeAtEveryLevel.out
