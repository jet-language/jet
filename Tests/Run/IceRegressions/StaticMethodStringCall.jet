// A static method in a type body that calls String methods lowers to its
// checked IR target on every tier.
#Allow(Jet.StaticOnlyStruct, "the golden lowers static functions of a type body") Spec: struct {
    measure: fn(input: String) -> Int { input.trim().len() }

    is_comment: fn(input: String) -> Bool { input.trim().starts_with("#") }
}

run: fn() {
    print(Spec.measure(" x "))
    print(Spec.is_comment("  # note"))
    print(Spec.is_comment("value"))
}
