Sign: enum {
    Pos,
    _Neg,
    _Zero,

    make_pos: fn() -[]> Sign { return Sign.Pos }

    to_num: fn(self) -[]> Int {
        if self == {
            .Pos -> {
                return 1
            }
            ._Neg -> {
                return 0
            }
            ._Zero -> {
                return 0
            }
        }
    }
}

run: fn() {
    s: Sign.make_pos()
    print(s.to_num())
}
