// Integer bits are `&`, `|`, `~` (exclusive-or), `&~` (clear) and prefix
// `~` (complement). They bind as in C: shifts, then `&` and `&~`, then `~`,
// then `|`, and all of them above the comparisons.
run: fn() {
    flags := 12
    mask: 10
    print(flags & mask)
    print(flags | mask)
    print(flags ~ mask)
    print(flags &~ mask)
    print(~flags)
    print(1 | 2 & 3)
    print(1 ~ 3 & 2)
    print(6 | 1 ~ 3)
    print(1 << 2 & 4)
    print(2 + 1 & 1)
    print(flags & mask == 8)
    small: U8{5}
    print(~small)
    flags &= 8
    flags |= 3
    flags ~= 6
    flags &~= 1
    print(flags)
}
