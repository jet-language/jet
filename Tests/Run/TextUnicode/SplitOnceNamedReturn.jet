// The `(before, after)` pair from `split_once` and `cut_last` has the type
// of a written `(before: String, after: String)` return type. Written in the
// other label order it is another type: the pair itself converts by name at
// the return, and an optional holding it does not.
split_assign: fn(text: String) -> {before: String, after: String}? { text.split_once("=") }

cut_path: fn(path: String) -> {after: String, before: String}? {
    pair: path.cut_last("/") ?? return None
    pair
}

run: fn() {
    pair: split_assign("key=value") ?? panic("missing")
    print("{pair.before}|{pair.after}")
    print(split_assign("novalue") == None)
    leaf: cut_path("root/branch/leaf") ?? panic("missing cut")
    print("{leaf.before}|{leaf.after}")
    direct: "a:b:c".split_once(":") ?? panic("missing direct")
    print("{direct.before}|{direct.after}")
}
