== let_binding
-- jet
// An allowed failure: Tests/UI/retired_binding_spellings_get_the_generic_statement_error
// pins the generic statement error for a retired binding word, with no edit.
run: fn() {
    let total = 3
    print(total)
}
-- python
let total = 3
print(total)

