== misspelled_type
-- jet
Point: struct {
    x: Int,
    y: Int,
}

run: fn() {
    p: Pont{x: 1, y: 2}
    print(p.x + p.y)
}
-- python
class Point:
    def __init__(self, x, y):
        self.x = x
        self.y = y
p = Pont(1, 2)
print(p.x + p.y)

== misspelled_variant
-- jet
Color: enum {
    Red,
    Green,
}

run: fn() {
    c: Color.Gren
    print(c == Color.Red)
}
-- python
from enum import Enum
class Color(Enum):
    RED = 1
    GREEN = 2
c = Color.GREN
print(c == Color.RED)

