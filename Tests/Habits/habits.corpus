== misspelled_parameter
-- jet
area: fn(width: Int, height: Int) -> Int {
    width * heigth
}

run: fn() {
    print(area(2, 3))
}
-- python
def area(width, height):
    return width * heigth
print(area(2, 3))

== misspelled_field
-- jet
Person: struct {
    name: String,
    age: Int,
}

run: fn() {
    p: Person{name: "Ada", age: 36}
    print(p.nmae)
    print(p.age)
}
-- python
class Person:
    def __init__(self, name, age):
        self.name = name
        self.age = age
p = Person("Ada", 36)
print(p.nmae)

== misspelled_field_extra_letter
-- jet
Person: struct {
    name: String,
    age: Int,
}

run: fn() {
    p: Person{name: "Ada", age: 36}
    print(p.agee)
    print(p.name)
}
-- python
class Person:
    def __init__(self, name, age):
        self.name = name
        self.age = age
p = Person("Ada", 36)
print(p.agee)

