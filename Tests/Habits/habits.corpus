# Fifty-one Python and JavaScript habits and typos, each written once in Jet and
# once, as the same slip, in Python. Tools/Agent/HabitCorpus.jet runs every
# Jet case through `jet check --json`, applies its `fix_edits` and checks the
# result again. It also runs every Python case under Python 3.13 and counts the
# ones whose error says "Did you mean" or "Maybe you meant".
# A case opens with `== name`; `-- jet` and `-- python` open its two sources.
# Where a habit is correct Python, its Python case writes the JavaScript
# spelling that Python itself refuses.

== for_colon
-- jet
run: fn() {
    items: [1, 2, 3]
    for item in items:
        print(item)
}
-- python
items = [1, 2, 3]
for (const item of items) {
    print(item)
}

== and_keyword
-- jet
run: fn() {
    ready: true
    open: true
    if ready and open {
        print("go")
    }
}
-- python
ready = True
is_open = True
if ready && is_open:
    print("go")

== or_keyword
-- jet
run: fn() {
    cached: false
    fresh: true
    if cached or fresh {
        print("ok")
    }
}
-- python
cached = False
fresh = True
if cached || fresh:
    print("ok")

== not_keyword
-- jet
run: fn() {
    done: false
    if not done {
        print("working")
    }
}
-- python
done = False
if !done:
    print("working")

== power_operator
-- jet
run: fn() {
    side: 4
    print(side ** 2)
}
-- python
side = 4
print(side ^^ 2)

== floor_division
-- jet
run: fn() {
    print(9 // 2)
}
-- python
print(9 \ 2)

== elif_keyword
-- jet
run: fn() {
    n: 5
    if n < 0 {
        print("negative")
    } elif n == 0 {
        print("zero")
    } else {
        print("positive")
    }
}
-- python
n = 5
if n < 0:
    print("negative")
else if n == 0:
    print("zero")
else:
    print("positive")

== len_function
-- jet
run: fn() {
    items: [1, 2, 3]
    print(len(items))
}
-- python
items = [1, 2, 3]
print(items.length)

== is_none
-- jet
run: fn() {
    found: Int?{None}
    if found is None {
        print("missing")
    }
}
-- python
found = None
if found === None:
    print("missing")

== true_capital
-- jet
run: fn() {
    enabled: True
    print(enabled)
}
-- python
enabled = true
print(enabled)

== false_capital
-- jet
run: fn() {
    enabled: False
    print(enabled)
}
-- python
enabled = false
print(enabled)

== increment
-- jet
run: fn() {
    count := 0
    count++
    print(count)
}
-- python
count = 0
count++
print(count)

== decrement
-- jet
run: fn() {
    count := 3
    count--
    print(count)
}
-- python
count = 3
count--
print(count)

== def_keyword
-- jet
def add(a: Int, b: Int) -> Int {
    a + b
}

run: fn() {
    print(add(1, 2))
}
-- python
function add(a, b) {
    return a + b
}
print(add(1, 2))

== fstring_prefix
-- jet
run: fn() {
    name: "Ada"
    print(f"hello {name}")
}
-- python
name = "Ada"
print(`hello ${name}`)

== range_call
-- jet
run: fn() {
    loop i in range(3) {
        print(i)
    }
}
-- python
for i in rnage(3):
    print(i)

== while_keyword
-- jet
run: fn() {
    i := 0
    while i < 3 {
        i += 1
    }
    print(i)
}
-- python
i = 0
while (i < 3) {
    i += 1
}
print(i)

== str_function
-- jet
run: fn() {
    n: 7
    label: "n=" + str(n)
    print(label)
}
-- python
n = 7
label = "n=" + n.toString()
print(label)

== str_call
-- jet
run: fn() {
    n: 7
    label: str(n)
    print(label)
}
-- python
n = 7
label = n.toString()
print(label)

