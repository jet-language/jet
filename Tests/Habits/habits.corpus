== arrow_function
-- jet
run: fn() {
    items: [1, 2, 3]
    doubled: items.map(x => x * 2)
    print(doubled)
}
-- python
items = [1, 2, 3]
doubled = list(map(x => x * 2, items))
print(doubled)

