// D-QUAL2: `derive X` attaches method impls, so X must be a `trait`. A value
// tag has no methods, so applying one is E0731 — declare it as a `trait` instead.

#FX(!Net)
Reviewed: struct {
    impl Marker {
        sites: [.TypeUse]
    }
}

#Reviewed
Point: struct {
    x: Int,
}

run: fn() { print("ok") }
