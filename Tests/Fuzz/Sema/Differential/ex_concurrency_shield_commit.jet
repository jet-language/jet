// D-SHIELDNAME1=A / R12: AOT and dev both defer race cancellation until the
// shielded commit finishes. Code after the block never runs. The winner waits
// until the loser is inside its shield: a task canceled before it starts
// never runs its body.
use time: core.time

shielded_commit: fn(entered: Sender<Int>) -> Int {
    #Shield {
        entered.send(1)
        time.sleep(20ms)
        print("committed")
    }
    print("after shield")
    return 1
}

fast_seven: fn(entered: Receiver<Int>) -> Int {
    entered.receive() ?? 0
    7
}

run: fn() {
    { sender: entered_tx, receiver: entered }: channel<Int>(capacity: 1)
    task.group g {
        winner: task.race {shielded_commit(entered_tx), fast_seven(entered)} ?? panic("race failed")
        print(winner)
    }
}
