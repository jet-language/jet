// core-conformance: core.web.forms.WebFormTyped.cancel
use api: core.web.forms

canceled: fn(form: &api.WebFormTyped) -> String Never! {
    form.cancel()
    api.typed_state(form)
}

run: fn() {
    form := api.typed(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(canceled(form))
}
