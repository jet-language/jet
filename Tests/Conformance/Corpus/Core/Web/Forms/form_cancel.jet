// core-conformance: core.web.forms.WebFormTyped.cancel
use api: core.web.forms

JetForm: struct { jet: String }

canceled: fn(form: ^api.WebFormTyped<JetForm>) -> String Never! {
    form.cancel()
    api.typed_state(form)
}

run: fn() {
    form := api.typed<JetForm>(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(canceled(form))
}
