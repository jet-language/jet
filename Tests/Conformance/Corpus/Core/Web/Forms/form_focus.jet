// core-conformance: core.web.forms.WebFormTyped.focus
use api: core.web.forms

JetForm: struct { jet: String }

focused: fn(form: ^api.WebFormTyped<JetForm>) -> Bool Never! { form.focus(.jet) == .Ok(_) }

run: fn() {
    form := api.typed<JetForm>(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(focused(form))
}
