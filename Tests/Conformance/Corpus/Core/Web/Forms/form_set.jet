// core-conformance: core.web.forms.WebFormTyped.set
use api: core.web.forms

filled: fn(form: &api.WebFormTyped) -> Bool Never! { form.set("jet", "jet") == .Ok(_) }

run: fn() {
    form := api.typed(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(filled(form))
}
