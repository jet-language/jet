// core-conformance: core.web.forms.WebFormTyped.set
use api: core.web.forms

JetForm: struct { jet: String }

filled: fn(form: ^api.WebFormTyped<JetForm>) -> Bool Never! { form.set(.jet, "jet") == .Ok(_) }

run: fn() {
    form := api.typed<JetForm>(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(filled(form))
}
