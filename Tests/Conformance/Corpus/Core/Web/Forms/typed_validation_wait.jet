// core-conformance: core.web.forms.typed_validation_wait
use api: core.web.forms

JetForm: struct { jet: String }

run: fn() {
    form: api.typed<JetForm>(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    validation := api.typed_validate_async(form)
    print(api.typed_validation_wait(validation) == .Ok(_))
}
