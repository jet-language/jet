// core-conformance: core.web.forms.WebFormTyped.no_script
use api: core.web.forms

JetForm: struct { jet: String }

markup: fn(form: ^api.WebFormTyped<JetForm>) -> String Never! { form.no_script() ?? "refused" }

run: fn() {
    form := api.typed<JetForm>(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(markup(form))
}
