// core-conformance: core.web.forms.WebFormTyped.set_async_validator
use api: core.web.forms

JetForm: struct { jet: String }

checked: fn(form: ^api.WebFormTyped<JetForm>) -> Bool Never! {
    form.set_async_validator("jet", .Change, 0, fn(value) {}) == .Ok(_)
}

run: fn() {
    form := api.typed<JetForm>(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(checked(form))
}
