// core-conformance: core.web.forms.WebFormTyped.lifecycle
use api: core.web.forms

JetForm: struct { jet: String }

stage: fn(form: api.WebFormTyped<JetForm>) -> WebFormLifecycle Never! { form.lifecycle() }

run: fn() {
    form: api.typed<JetForm>(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(stage(form))
}
