// core-conformance: core.web.forms.WebFormTyped.blur
use api: core.web.forms

JetForm: struct { jet: String }

left: fn(form: ^api.WebFormTyped<JetForm>) -> Bool Never! { form.blur(.jet) == .Ok(_) }

run: fn() {
    form := api.typed<JetForm>(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(left(form))
}
