// core-conformance: core.web.forms.WebFormTyped.blur
use api: core.web.forms

left: fn(form: ^api.WebFormTyped) -> Bool Never! { form.blur("jet") == .Ok(_) }

run: fn() {
    form := api.typed(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(left(form))
}
