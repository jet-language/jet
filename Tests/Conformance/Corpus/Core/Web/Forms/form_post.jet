// core-conformance: core.web.forms.WebFormTyped.post
use api: core.web.forms

JetForm: struct { jet: String }

posted: fn(form: api.WebFormTyped<JetForm>) -> String Never! { form.post("jet") ?? "refused" }

run: fn() {
    form: api.typed<JetForm>(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(posted(form))
}
