// core-conformance: core.web.forms.WebFormTyped.errors
use api: core.web.forms

problems: fn(form: api.WebFormTyped) -> WebFormErrorState Never! { form.errors() }

run: fn() {
    form: api.typed(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(problems(form))
}
