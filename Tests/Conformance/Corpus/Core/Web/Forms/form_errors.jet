// core-conformance: core.web.forms.WebFormTyped.errors
use api: core.web.forms

JetForm: struct { jet: String }

problems: fn(form: api.WebFormTyped<JetForm>) -> WebFormErrorState Never! { form.errors() }

run: fn() {
    form: api.typed<JetForm>(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(problems(form))
}
