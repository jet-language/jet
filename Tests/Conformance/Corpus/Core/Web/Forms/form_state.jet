// core-conformance: core.web.forms.WebFormTyped.state
use api: core.web.forms

JetForm: struct { jet: String }

status: fn(form: api.WebFormTyped<JetForm>) -> String Never! { form.state() }

run: fn() {
    form: api.typed<JetForm>(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(status(form))
}
