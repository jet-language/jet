// core-conformance: core.web.forms.WebFormTyped.submit
use api: core.web.forms

submitted: fn(form: &api.WebFormTyped) -> String Never! { form.submit() ?? "refused" }

run: fn() {
    form := api.typed(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(submitted(form))
}
