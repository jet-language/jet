// core-conformance: core.web.forms.WebFormTyped.set_action
use api: core.web.forms

acted: fn(form: api.WebFormTyped) -> String Never! {
    form.set_action(fn(value) { "" })
    "action set"
}

run: fn() {
    form: api.typed(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    print(acted(form))
}
