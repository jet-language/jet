work: fn(n: Int, out: Sender<Int>) { out.send(n).drop("send") }

run: fn() {
    ^started: 0
    forgotten: 7
    { sender: done, receiver: finished }: channel<Int>()
    task.group members(limit: 2) {
        loop started < 3 {
            if started < 2 {
                task work(started, done.copy())
                started += 1
                next
            }
            print(finished.receive() ?? 0)
            started += 1
        }
    }
}
