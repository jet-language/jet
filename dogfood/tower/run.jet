use core.crypto.[sha256_bytes]
use core.encoding.json as json
use core.files as files
use core.http.server as http_server
use core.math as math
use core.net.url as url
use core.process as process
use core.regex as re
use core.time as time

fn tree_field(tree: DataTree, name: String) DataTree !Never -> {
    return tree.field(name) ?? DataTree.Null
}

fn list_at(tree: DataTree, name: String) [DataTree] !Never -> {
    empty := [DataTree]{}
    value :: tree_field(~tree, ~name)
    return if value == {
        .Array(items) -> items
        else -> empty
    }
}

fn int_at(tree: DataTree, name: String) Int !Never -> {
    value :: tree_field(~tree, ~name)
    return value.int() ?? 0
}

fn is_null(value: DataTree) Bool !Never -> {
    if {
        value == .Null -> return true
        else -> return false
    }
}

fn has_field(tree: DataTree, name: String) Bool -> {
    return if tree == {
        .Object(fields) -> fields.has_key(name)
        else -> false
    }
}

fn is_object(tree: DataTree) Bool -> {
    return if tree == {
        .Object(_fields) -> true
        else -> false
    }
}

fn copy_object_fields(fields: [String:DataTree]) [String:DataTree] !Never -> {
    out := [String:DataTree]{}
    loop (key, value) in fields -> out[key] = ~value
    return out
}

fn remove_object_fields(fields: [String:DataTree], removed: [String]) [String:DataTree] -> {
    out := [String:DataTree]{}
    loop (key, value) in fields {
        if !removed.contains(key) -> out[key] = ~value
    }
    return out
}

fn merge_object_fields(base: [String:DataTree], fields: [String:DataTree]) [String:DataTree] -> {
    out := base
    loop (key, value) in fields -> out[key] = ~value
    return out
}

fn merge_public_config_fields(base: [String:DataTree], fields: [String:DataTree]) [String:DataTree] -> {
    out := base
    loop (key, value) in fields {
        if key != "auth" && key != "push" -> out[key] = ~value
    }
    return out
}

fn object_fields(tree: DataTree) [String:DataTree] !Never -> {
    out := [String:DataTree]{}
    return if tree == {
        .Object(fields) -> copy_object_fields(~fields)
        else -> out
    }
}

fn object_without(tree: DataTree, removed: [String]) DataTree -> {
    out := [String:DataTree]{}
    return if tree == {
        .Object(fields) -> DataTree.Object(remove_object_fields(~fields, ~removed))
        else -> DataTree.Object(out)
    }
}

fn object_with(tree: DataTree, name: String, value: DataTree) DataTree !Never -> {
    out := object_fields(tree)
    out[name] = value
    return DataTree.Object(out)
}

fn array_field(tree: DataTree, name: String) [DataTree] !Never -> {
    empty := [DataTree]{}
    value :: tree_field(tree, name)
    return if value == {
        .Array(items) -> items
        else -> empty
    }
}

// #2356: split payload arms for AOT codegen.
fn scalar_text_text(value: DataTree) String !Never -> {
    return if value == {
        .Text(text) -> ~text
        else -> scalar_text_int(~value)
    }
}

fn scalar_text_int(value: DataTree) String !Never -> {
    return if value == {
        .Int(number) -> "{number}"
        else -> scalar_text_float(~value)
    }
}

fn scalar_text_float(value: DataTree) String !Never -> {
    return if value == {
        .Float(number) -> "{number}"
        else -> scalar_text_bool(~value)
    }
}

fn scalar_text_bool(value: DataTree) String !Never -> {
    return if value == {
        .Bool(flag) -> "{flag}"
        else -> ""
    }
}

fn scalar_text(value: DataTree) String !Never -> { return scalar_text_text(~value) }

fn javascript_truthy_null(value: DataTree) Bool !Never -> {
    return if value == {
        .Null -> false
        else -> javascript_truthy_bool(~value)
    }
}

fn javascript_truthy_bool(value: DataTree) Bool !Never -> {
    return if value == {
        .Bool(flag) -> flag
        else -> javascript_truthy_int(~value)
    }
}

fn javascript_truthy_int(value: DataTree) Bool !Never -> {
    return if value == {
        .Int(number) -> number != 0
        else -> javascript_truthy_float(~value)
    }
}

fn javascript_truthy_float(value: DataTree) Bool !Never -> {
    return if value == {
        .Float(number) -> number != 0.0
        else -> javascript_truthy_text(~value)
    }
}

fn javascript_truthy_text(value: DataTree) Bool !Never -> {
    return if value == {
        .Text(text) -> !text.is_empty()
        else -> javascript_truthy_array(~value)
    }
}

fn javascript_truthy_array(value: DataTree) Bool !Never -> {
    return if value == {
        .Array(_items) -> true
        else -> javascript_truthy_object(~value)
    }
}

fn javascript_truthy_object(value: DataTree) Bool !Never -> {
    return if value == {
        .Object(_entries) -> true
        else -> true
    }
}

fn javascript_truthy(value: DataTree) Bool !Never -> { return javascript_truthy_null(~value) }

fn javascript_text_or_empty(value: DataTree) String -> {
    if javascript_truthy(~value) -> return scalar_text(~value)
    return ""
}

fn text_field(tree: DataTree, name: String, fallback: String) String !Never -> {
    value :: tree_field(tree, name)
    if is_null(~value) -> return fallback
    return scalar_text(~value)
}

fn int_value(value: DataTree, fallback: Int) Int !Never -> {
    return if value == {
        .Int(number) -> number
        else -> fallback
    }
}

fn int_field(tree: DataTree, name: String, fallback: Int) Int !Never -> {
    return int_value(tree_field(tree, name), fallback)
}

fn bool_value(value: DataTree) Bool !Never -> {
    subject := ~value
    return if subject == {
        .Bool(flag) -> flag
        else -> javascript_truthy(~value)
    }
}

fn same_source_value(left: DataTree, right: DataTree) Bool !Never -> {
    return semantic_equal(left, right)
}

fn arrays_semantically_equal(left_values: [DataTree], right_values: [DataTree]) Bool !Never -> {
    if left_values.len() != right_values.len() -> return false
    i := 0
    loop i < left_values.len() {
        left_value :: left_values[i]
        right_value :: right_values[i]
        if !semantic_equal(~left_value, ~right_value) -> return false
        i += 1
    }
    return true
}

fn objects_semantically_equal(left_fields: [String:DataTree], right_fields: [String:DataTree]) Bool !Never -> {
    if left_fields.len() != right_fields.len() -> return false
    loop (key, value) in left_fields {
        if !right_fields.has_key(key) -> return false
        right_value :: right_fields[key]
        if !semantic_equal(~value, ~right_value) -> return false
    }
    return true
}

fn semantic_equal_left_null(left: DataTree, right: DataTree) Bool !Never -> {
    return if left == {
        .Null -> is_null(~right)
        else -> semantic_equal_left_bool(~left, ~right)
    }
}

fn semantic_equal_left_bool(left: DataTree, right: DataTree) Bool !Never -> {
    return if left == {
        .Bool(left_value) -> {
            return if right == {
                .Bool(right_value) -> left_value == right_value
                else -> false
            }

        }
        else -> semantic_equal_left_int(~left, ~right)
    }
}

fn semantic_equal_left_int(left: DataTree, right: DataTree) Bool !Never -> {
    return if left == {
        .Int(left_value) -> {
            return if right == {
                .Int(right_value) -> left_value == right_value
                else -> false
            }

        }
        else -> semantic_equal_left_float(~left, ~right)
    }
}

fn semantic_equal_left_float(left: DataTree, right: DataTree) Bool !Never -> {
    return if left == {
        .Float(left_value) -> {
            return if right == {
                .Float(right_value) -> left_value == right_value
                else -> false
            }

        }
        else -> semantic_equal_left_text(~left, ~right)
    }
}

fn semantic_equal_left_text(left: DataTree, right: DataTree) Bool !Never -> {
    return if left == {
        .Text(left_value) -> {
            return if right == {
                .Text(right_value) -> left_value == right_value
                else -> false
            }

        }
        else -> semantic_equal_left_array(~left, ~right)
    }
}

fn semantic_equal_left_array(left: DataTree, right: DataTree) Bool !Never -> {
    return if left == {
        .Array(left_values) -> {
            return if right == {
                .Array(right_values) -> arrays_semantically_equal(~left_values, ~right_values)
                else -> false
            }

        }
        else -> semantic_equal_left_object(~left, ~right)
    }
}

fn semantic_equal_left_object(left: DataTree, right: DataTree) Bool !Never -> {
    return if left == {
        .Object(left_fields) -> {
            return if right == {
                .Object(right_fields) -> objects_semantically_equal(~left_fields, ~right_fields)
                else -> false
            }

        }
        else -> false
    }
}

pub fn semantic_equal(left: DataTree, right: DataTree) Bool !Never -> {
    return semantic_equal_left_null(~left, ~right)
}

fn normalized_array_field(tree: DataTree, name: String) DataTree -> {
    return DataTree.Array(array_field(~tree, name))
}

fn normalize_card(card: DataTree) DataTree -> {
    out := object_fields(~card)
    out["blockedBy"] = normalized_array_field(~card, "blockedBy")
    out["log"] = normalized_array_field(~card, "log")
    out["criteria"] = normalized_array_field(~card, "criteria")
    out["refs"] = normalized_array_field(~card, "refs")
    out["tags"] = normalized_array_field(~card, "tags")
    out["parentId"] = tree_field(~card, "parentId")
    out["needsAcceptance"] = DataTree.Bool(bool_value(tree_field(~card, "needsAcceptance")))
    return DataTree.Object(out)
}

fn normalize_cards(cards: [DataTree]) [DataTree] -> {
    out := [DataTree]{}
    loop card in cards -> out.push(normalize_card(~card))
    return out
}

fn allowed_milestone_status(status: String) Bool -> {
    return ["open", "review-ready", "met"].contains(status)
}

fn allowed_criterion_status(status: String) Bool -> {
    return ["open", "met", "verified"].contains(status)
}

fn normalize_criterion(item: DataTree, index: Int, captured_day: String) DataTree -> {
    source := ~item
    source = if item == {
        .Text(text) -> DataTree.Object(["text": DataTree.Text(~text)])
        else -> source
    }

    n_value := tree_field(~source, "n")
    if is_null(~n_value) -> n_value = DataTree.Int(index + 1)

    text_value :: javascript_text_or_empty(tree_field(~source, "text")).trim()
    status := text_field(~source, "status", "open")
    if !allowed_criterion_status(~status) -> status = "open"
    met_by :: tree_field(~source, "metBy")
    verified_by :: tree_field(~source, "verifiedBy")
    evidence :: javascript_text_or_empty(tree_field(~source, "evidence"))
    at := javascript_text_or_empty(tree_field(~source, "at"))
    if (~at).is_empty() -> at = ~captured_day

    return DataTree.Object([
        "n": ~n_value,
        "text": DataTree.Text(text_value),
        "status": DataTree.Text(~status),
        "metBy": met_by,
        "verifiedBy": verified_by,
        "evidence": DataTree.Text(evidence),
        "at": DataTree.Text(~at)
    ])
}

fn normalize_criteria_items(items: [DataTree], captured_day: String) [DataTree] -> {
    out := [DataTree]{}
    index := 0
    loop item in items {
        out.push(normalize_criterion(~item, index, ~captured_day))
        index += 1
    }
    return out
}

fn normalize_criteria_array(raw: DataTree, captured_day: String) DataTree -> {
    return if raw == {
        .Array(items) -> DataTree.Array(normalize_criteria_items(~items, ~captured_day))
        else -> normalize_criteria_object(~raw, ~captured_day)
    }
}

fn normalize_criteria_object_items(items: DataTree, raw: DataTree, captured_day: String) DataTree -> {
    return if items == {
        .Array(values) -> DataTree.Array(normalize_criteria_items(~values, ~captured_day))
        else -> DataTree.Array([normalize_criterion(~raw, 0, ~captured_day)])
    }
}

fn normalize_criteria_object(raw: DataTree, captured_day: String) DataTree -> {
    return if raw == {
        .Object(_fields) -> normalize_criteria_object_items(tree_field(~raw, "items"), ~raw, ~captured_day)
        else -> normalize_criteria_text(~raw, ~captured_day)
    }
}

fn normalize_criteria_text(raw: DataTree, captured_day: String) DataTree -> {
    empty_text := [DataTree]{}
    return if raw == {
        .Text(text) -> {
            if text.is_empty() -> return DataTree.Array(empty_text)
            return DataTree.Array([normalize_criterion(~raw, 0, ~captured_day)])

        }
        else -> normalize_criteria_null(~raw, ~captured_day)
    }
}

fn normalize_criteria_null(raw: DataTree, captured_day: String) DataTree -> {
    empty_null := [DataTree]{}
    return if raw == {
        .Null -> DataTree.Array(empty_null)
        else -> DataTree.Array([normalize_criterion(~raw, 0, ~captured_day)])
    }
}

fn normalize_criteria(raw: DataTree, captured_day: String) DataTree -> {
    return normalize_criteria_array(~raw, ~captured_day)
}

fn normalize_milestone(milestone: DataTree, captured_day: String) DataTree -> {
    status := text_field(~milestone, "status", "open")
    if !allowed_milestone_status(~status) -> status = "open"
    criteria :: normalize_criteria(tree_field(~milestone, "criteria"), ~captured_day)

    if status == "met" && !javascript_truthy(tree_field(~milestone, "verification")) {
        out := object_fields(object_without(~milestone, ["metAt"]))
        out["criteria"] = criteria
        out["status"] = DataTree.Text("review-ready")
        return DataTree.Object(out)
    }

    out := object_fields(~milestone)
    out["criteria"] = criteria
    out["status"] = DataTree.Text(~status)
    return DataTree.Object(out)
}

fn normalize_milestones(milestones: [DataTree], captured_day: String) [DataTree] -> {
    out := [DataTree]{}
    loop milestone in milestones -> out.push(normalize_milestone(~milestone, ~captured_day))
    return out
}

fn normalize_decisions(decisions: [DataTree]) [DataTree] -> {
    replacement_present := false
    loop decision in decisions {
        if text_field(~decision, "id", "") == "D-ONCE-TIER1" -> replacement_present = true
    }

    out := [DataTree]{}
    loop decision in decisions {
        fields := object_fields(~decision)
        fields["draft"] = DataTree.Bool(bool_value(tree_field(~decision, "draft")))
        if text_field(~decision, "id", "") == "D-VERDICT-1254-1" && replacement_present && !javascript_truthy(tree_field(~decision, "supersededBy")) {
            fields["supersededBy"] = DataTree.Text("D-ONCE-TIER1")
        }
        out.push(DataTree.Object(fields))
    }
    return out
}

fn default_epochs() [DataTree] -> {
    return [DataTree]{
        DataTree.Object([
            "id": DataTree.Text("e1"),
            "name": DataTree.Text("Epoch 1"),
            "goal": DataTree.Text(""),
            "status": DataTree.Text("active")
        ])
    }
}

fn normalize_epochs(epochs: [DataTree], current_epoch: DataTree) [DataTree] -> {
    active_present := false
    loop epoch in epochs {
        if text_field(~epoch, "status", "") == "active" -> active_present = true
    }

    out := [DataTree]{}
    loop epoch in epochs {
        fields := object_fields(~epoch)
        if !active_present && !is_null(~current_epoch) && same_source_value(tree_field(~epoch, "id"), ~current_epoch) {
            fields["status"] = DataTree.Text("active")
        }
        out.push(DataTree.Object(fields))
    }
    return out
}

fn normalize_meta(meta: DataTree) DataTree -> {
    out := [String:DataTree]{
        "version": DataTree.Int(4),
        "project": DataTree.Text("Project"),
        "nextNum": DataTree.Int(1),
        "rev": DataTree.Int(0)
    }
    meta_subject := ~meta
    out = if meta_subject == {
        .Object(fields) -> merge_object_fields(~out, ~fields)
        else -> out
    }

    empty_toggled := [DataTree]{}
    ui := [String:DataTree]{"toggled": DataTree.Array(empty_toggled)}
    raw_ui :: tree_field(~meta, "ui")
    ui = if raw_ui == {
        .Object(fields) -> merge_object_fields(~ui, ~fields)
        else -> ui
    }
    out["version"] = DataTree.Int(4)
    out["ui"] = DataTree.Object(ui)

    clean :: object_without(DataTree.Object(out), ["digestCursor", "currentEpoch"])
    clean_fields := object_fields(clean)
    completion :: tree_field(~meta, "completionCursor")
    digest :: tree_field(~meta, "digestCursor")
    if is_null(~completion) && !is_null(~digest) -> clean_fields["completionCursor"] = ~digest
    return DataTree.Object(clean_fields)
}

fn milestone_progress(milestone: DataTree, cards: [DataTree], history_cards: [DataTree]) DataTree -> {
    selected := [String:DataTree]{}
    milestone_id :: tree_field(~milestone, "id")

    loop card in history_cards {
        if same_source_value(tree_field(~card, "milestoneId"), ~milestone_id) {
            card_id :: scalar_text(tree_field(~card, "id"))
            selected[card_id] = ~card
        }
    }
    loop card in cards {
        if same_source_value(tree_field(~card, "milestoneId"), ~milestone_id) {
            card_id :: scalar_text(tree_field(~card, "id"))
            selected[card_id] = ~card
        }
    }

    total :: selected.len()
    done := 0
    loop (_selected_id, card) in selected {
        if text_field(~card, "phase", "") == "done" -> done += 1
    }
    review_ready :: total > 0 && done == total
    met :: review_ready && text_field(~milestone, "status", "") == "met" && javascript_truthy(tree_field(~milestone, "verification"))
    return DataTree.Object([
        "total": DataTree.Int(total),
        "done": DataTree.Int(done),
        "reviewReady": DataTree.Bool(review_ready),
        "met": DataTree.Bool(met)
    ])
}

fn sync_milestone(milestone: DataTree, cards: [DataTree], history_cards: [DataTree]) DataTree -> {
    progress :: milestone_progress(~milestone, ~cards, ~history_cards)
    total :: int_field(~progress, "total", 0)
    done :: int_field(~progress, "done", 0)

    if total == 0 || done != total {
        out := object_fields(object_without(~milestone, ["verification", "metAt"]))
        out["status"] = DataTree.Text("open")
        return DataTree.Object(out)
    }

    if text_field(~milestone, "status", "") == "met" && javascript_truthy(tree_field(~milestone, "verification")) {
        return ~milestone
    }

    out := object_fields(object_without(~milestone, ["verification", "metAt"]))
    out["status"] = DataTree.Text("review-ready")
    return DataTree.Object(out)
}

fn sync_milestones(milestones: [DataTree], cards: [DataTree], history_cards: [DataTree]) [DataTree] -> {
    out := [DataTree]{}
    loop milestone in milestones -> out.push(sync_milestone(~milestone, ~cards, ~history_cards))
    return out
}

fn normalize_state(tower: DataTree, history: DataTree, captured_day: String) DataTree -> {
    tower_is_object :: is_object(~tower)
    meta_source :: tree_field(~tower, "meta")
    current_epoch :: tree_field(~meta_source, "currentEpoch")

    epochs_source := array_field(~tower, "epochs")
    if !tower_is_object -> epochs_source = default_epochs()
    epochs :: normalize_epochs(~epochs_source, ~current_epoch)

    history_cards :: array_field(~history, "cards")
    milestones_source :: array_field(~tower, "milestones")
    cards_source :: array_field(~tower, "cards")
    milestones0 :: normalize_milestones(~milestones_source, ~captured_day)
    cards :: normalize_cards(~cards_source)
    milestones :: sync_milestones(~milestones0, ~cards, ~history_cards)
    decisions :: normalize_decisions(array_field(~tower, "decisions"))
    questions :: array_field(~tower, "questions")
    ideas :: array_field(~tower, "ideas")
    papercuts :: array_field(~tower, "papercuts")
    events :: array_field(~tower, "events")

    return DataTree.Object([
        "meta": normalize_meta(~meta_source),
        "epochs": DataTree.Array(epochs),
        "milestones": DataTree.Array(milestones),
        "cards": DataTree.Array(~cards),
        "decisions": DataTree.Array(decisions),
        "questions": DataTree.Array(questions),
        "ideas": DataTree.Array(ideas),
        "papercuts": DataTree.Array(papercuts),
        "events": DataTree.Array(events)
    ])
}

fn linked_records(records: [DataTree], card: DataTree, field_name: String) [DataTree] !Never -> {
    out := [DataTree]{}
    target :: tree_field(~card, "id")
    loop record in records {
        if same_source_value(tree_field(~record, ~field_name), ~target) -> out.push(~record)
    }
    return out
}

fn clearance_for(card: DataTree, decisions: [DataTree]) DataTree !Never -> {
    target :: tree_field(~card, "id")
    open_ids := [DataTree]{}
    total := 0
    ratified := 0
    loop decision in decisions {
        if same_source_value(tree_field(~decision, "cardId"), ~target) && !bool_value(tree_field(~decision, "draft")) {
            total += 1
            if text_field(~decision, "status", "") == "ratified" -> ratified += 1 else {
                open_ids.push(tree_field(~decision, "id"))
            }
        }
    }
    state := "none"
    if total > 0 -> state = "cleared"
    if open_ids.len() > 0 -> state = "pending"
    return DataTree.Object([
        "state": DataTree.Text(state),
        "open": DataTree.Array(open_ids),
        "total": DataTree.Int(total),
        "ratified": DataTree.Int(ratified)
    ])
}

fn blocking_decision(decision: DataTree) Bool !Never -> {
    return text_field(~decision, "status", "") != "ratified" && !bool_value(tree_field(~decision, "draft"))
}

fn reference_number(reference: String) Int !Never -> {
    text := ~reference
    if (~text).starts_with("#") -> text = (~text).slice(1, (~text).len())
    return Int.parse(~text) ?? -1
}

fn card_matches_id(card: DataTree, reference: String) Bool !Never -> {
    card_id :: scalar_text(tree_field(~card, "id"))
    return card_id == reference
}

fn card_matches_number(card: DataTree, number: Int) Bool !Never -> {
    return int_field(~card, "num", -1) == number
}

fn card_for_reference(reference: DataTree, cards: [DataTree]) Int !Never -> {
    reference_text :: scalar_text(~reference)
    index := 0
    loop card in cards {
        if card_matches_id(~card, ~reference_text) -> return index
        index += 1
    }

    number :: reference_number(~reference_text)
    if number >= 0 {
        index = 0
        loop card in cards {
            if card_matches_number(~card, number) -> return index
            index += 1
        }
    }
    return -1
}

fn open_decision_for_reference(reference: DataTree, decisions: [DataTree]) Bool !Never -> {
    loop decision in decisions {
        if same_source_value(tree_field(~decision, "id"), ~reference) && text_field(~decision, "status", "") != "ratified" {
            return true
        }
    }
    return false
}

fn lane_record(lane: String, who: DataTree, label: String) DataTree !Never -> {
    return DataTree.Object([
        "lane": DataTree.Text(~lane),
        "who": who,
        "label": DataTree.Text(~label)
    ])
}

fn lane_of(card: DataTree, decisions: [DataTree], cards: [DataTree]) DataTree !Never -> {
    phase :: text_field(~card, "phase", "")
    if phase == "done" -> return lane_record("done", DataTree.Null, "Done")
    if phase == "frozen" {
        return lane_record("frozen", DataTree.Text("owner"), "Frozen — owner reactivates it")
    }

    target :: tree_field(~card, "id")
    open_ids := [DataTree]{}
    loop decision in decisions {
        if same_source_value(tree_field(~decision, "cardId"), ~target) && blocking_decision(~decision) && text_field(~decision, "group", "") != "acceptance" {
            open_ids.push(tree_field(~decision, "id"))
        }
    }
    if open_ids.len() > 0 {
        suffix := "s"
        if open_ids.len() == 1 -> suffix = ""
        return DataTree.Object([
            "lane": DataTree.Text("decide"),
            "who": DataTree.Text("owner"),
            "label": DataTree.Text("{open_ids.len()} decision{suffix} to make"),
            "decisions": DataTree.Array(open_ids)
        ])
    }

    blockers := [DataTree]{}
    labels := [String]{}
    for_blocked :: array_field(~card, "blockedBy")
    loop reference in for_blocked {
        found_index :: card_for_reference(~reference, ~cards)
        if found_index >= 0 {
            blocking_card :: ~cards[found_index]
            if text_field(~blocking_card, "phase", "") != "done" {
                blockers.push(~reference)
                blocking_num :: int_field(~blocking_card, "num", 0)
                labels.push("#{blocking_num}")
            }
        } else {
            if open_decision_for_reference(~reference, ~decisions) {
                blockers.push(~reference)
                labels.push(scalar_text(~reference))
            }
        }
    }
    if blockers.len() > 0 {
        label_text :: labels.join(", ")
        return DataTree.Object([
            "lane": DataTree.Text("blocked"),
            "who": DataTree.Null,
            "label": DataTree.Text("Blocked by {label_text}"),
            "blockers": DataTree.Array(blockers)
        ])
    }

    if phase == "deciding" {
        if javascript_truthy(tree_field(~card, "plan")) {
            return lane_record("implement", DataTree.Text("agent"), "Ready to implement")
        }
        return lane_record("plan", DataTree.Text("agent"), "Build a plan + raise decisions")
    }
    if phase == "planning" || phase == "triage" {
        if javascript_truthy(tree_field(~card, "plan")) {
            return lane_record("plan", DataTree.Text("agent"), "Vet the plan + raise decisions")
        }
        return lane_record("plan", DataTree.Text("agent"), "Build a plan + raise decisions")
    }
    if phase == "ready" {
        return lane_record("implement", DataTree.Text("agent"), "Ready to implement")
    }
    if phase == "building" {
        return lane_record("building", DataTree.Text("agent"), "Continue building")
    }
    if phase == "verify" {
        if bool_value(tree_field(~card, "needsAcceptance")) {
            card_num :: int_field(~card, "num", 0)
            expected :: "D-ACCEPT-{card_num}"
            acceptance_open := false
            loop decision in decisions {
                if scalar_text(tree_field(~decision, "id")) == expected && text_field(~decision, "status", "") != "ratified" {
                    acceptance_open = true
                }
            }
            if acceptance_open {
                return lane_record("verify", DataTree.Text("owner"), "Owner visual/UX acceptance")
            }
            return lane_record("verify", DataTree.Text("agent"), "Finish criteria before owner visual review")
        }
        return lane_record("verify", DataTree.Text("agent"), "Close when exit criteria are met")
    }
    return lane_record("blocked", DataTree.Null, "")
}

fn project_card(card: DataTree, decisions: [DataTree], cards: [DataTree], questions: [DataTree]) DataTree !Never -> {
    linked_decisions :: linked_records(~decisions, ~card, "cardId")
    linked_questions :: linked_records(~questions, ~card, "cardId")
    open_questions := 0
    loop question in linked_questions {
        if text_field(~question, "kind", "") != "message" && text_field(~question, "status", "") == "open" {
            open_questions += 1
        }
    }

    out := object_fields(~card)
    out["clearance"] = clearance_for(~card, ~decisions)
    out["decisions"] = DataTree.Array(linked_decisions)
    out["questions"] = DataTree.Array(linked_questions)
    out["openQ"] = DataTree.Int(open_questions)
    out["lane"] = lane_of(~card, ~decisions, ~cards)
    return DataTree.Object(out)
}

pub fn project_archived_card(card: DataTree, decisions: [DataTree], cards: [DataTree]) DataTree !Never -> {
    questions :: array_field(~card, "questions")
    projected :: project_card(~card, ~decisions, ~cards, ~questions)
    return object_with(~projected, "archived", DataTree.Bool(true))
}

fn project_cards(cards: [DataTree], decisions: [DataTree], questions: [DataTree]) [DataTree] -> {
    out := [DataTree]{}
    loop card in cards -> out.push(project_card(~card, ~decisions, ~cards, ~questions))
    return out
}

fn project_milestones(milestones: [DataTree], cards: [DataTree], history_cards: [DataTree]) [DataTree] -> {
    out := [DataTree]{}
    loop milestone in milestones {
        progress :: milestone_progress(~milestone, ~cards, ~history_cards)
        out.push(object_with(~milestone, "progress", ~progress))
    }
    return out
}

