#Test("phase1 plan matches the live oracle when configured") {
    project :: phase1_root() ?? panic("phase1 plan live fixture root cannot be resolved")
    port_store :: phase1_store("plan-live-port") ?? panic("phase1 plan live port store root cannot be resolved")
    oracle_store :: phase1_store("plan-live-oracle") ?? panic("phase1 plan live oracle store root cannot be resolved")
    assert(maybe_compare_oracle(["plan", "--json", "--offline"], ["profile", "plan", "dogfood", "--json", "--offline"], project, port_store, oracle_store, false) ?? panic("live oracle comparison failed"))
}

