    {
      "name": "recorded-repeat-dedup",
      "provider": "github",
      "reference": "portable@github",
      "argv": ["realize", "tests/fixtures/phase3/github-result.json", "--provider", "recorded", "--json", "--no-color", "--offline"],
      "expected_hash": "sha256-a30069bb3a497c58ef27cf60edb359eb5e6ad8b5933e885d559c0bf16f08546b",
      "payload_tree": ["dir:bin:0555", "file:bin/tool:0444:da773d229ceb4768e042459b633fb46f0f305edfc7e4c72bd29c570f8b6e3850", "dir:share:0555", "file:share/message.txt:0444:5085debb5f138c445724ec0b5765094895c83dc39db81860dcbde8bb15419878"],
