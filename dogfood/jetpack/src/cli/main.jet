use core.encoding.json as json
use core.files as fs
use core.process as process
use core.sys as env
use core.term as io
use ingest as store
use plan
use read_only
use realize as realization

#Error
pub struct CLIError {
    pub message: String
}

pub struct CommandResult {
    pub stdout: String
    pub exit_code: Int
}

fn error_result(action: String, message: String) CommandResult !Never -> {
    wire :: json.to_string(DataTree.Object([
        "schema": DataTree.Text("jet.report/v1"),
        "moment": DataTree.Text("tool"),
        "status": DataTree.Text("error"),
        "ok": DataTree.Bool(false),
        "action": DataTree.Text(~action),
        "error": DataTree.Text(~message)
    ]))
    return CommandResult{stdout: "{wire}\n", exit_code: 2}
}

fn success_result(wire: String) CommandResult !Never -> {
    return CommandResult{stdout: "{wire}\n", exit_code: 0}
}

#CLI
struct JetpackArgs {
    json: Bool
    no_color: Bool
    offline: Bool

    #Doc("resolve a profile")
    fn plan(self, name: String{"dogfood"}) {
        emit(plan_command(configured_project_root(), configured_store_root(), name))
    }

    #Doc("list profiles")
    fn list(self) {
        emit(list_command(configured_store_root()))
    }

    #Doc("inspect a profile")
    fn inspect(self) {
        emit(inspect_command(configured_store_root()))
    }

    #Doc("ingest a source tree")
    fn ingest(self, source: String, name: ?String, version: ?String, ref: ?String) {
        name_value :: name ?? ""
        version_value :: version ?? ""
        reference_value :: ref ?? ""
        emit(ingest_command(
            source,
            name_value,
            version_value,
            reference_value,
            configured_project_root(),
            configured_store_root()
        ))
    }

    #Doc("realize a source tree")
    fn realize(self, source: String, provider: String, name: ?String, version: ?String, ref: ?String, digest: ?String) {
        name_value :: name ?? ""
        version_value :: version ?? ""
        reference_value :: ref ?? ""
        digest_value :: digest ?? ""
        emit(realize_command(
            source,
            provider,
            name_value,
            version_value,
            reference_value,
            digest_value,
            configured_project_root(),
            configured_store_root()
        ))
    }
}

fn configured_project_root() String !Never -> {
    return env.get("JETPACK_PROJECT_ROOT") ?? "."
}

fn configured_store_root() String !Never -> {
    return env.get("JETPACK_DOGFOOD_ROOT") ?? Path.home().join(".cache").join("jet-dogfood").join("jetpack-store").to_string()
}

fn emit(result: CommandResult) {
    out :: io.stdout()
    out.write(result.stdout) ?? panic("stdout write failed")
    out.flush() ?? panic("stdout flush failed")
    process.exit(result.exit_code)
}

fn reject_symlink_components(path: Path, label: String) Bool !CLIError -> {
    current := path
    loop {
        if fs.stat(~current) == {
            .Ok(metadata) -> {
                if metadata.is_symlink {
                    return Err(CLIError{message: "{label} contains symbolic link component {current.to_string()}; use a real path under the Jet dogfood cache"})
                }
            }
            .Err(error) -> {
                if error == .NotFound(_) {
                } else {
                    return Err(CLIError{message: "{label} component cannot be inspected at {current.to_string()}; use a readable path under the Jet dogfood cache"})
                }
            }
        }
        parent :: current.parent()
        if parent == .Val(parent_path) {
            if parent_path.to_string() == current.to_string() {
                break
            }
            current = parent_path
            next
        }
        if parent == .None -> break
    }
    return Ok(true)
}

fn normalized_absolute(raw: String, label: String) String !CLIError -> {
    if raw.trim() == "" {
        return Err(CLIError{message: "{label} is required"})
    }
    candidate :: Path.from(raw).normalize()
    absolute :: fs.absolute(~candidate) ?? return Err(CLIError{message: "{label} cannot be resolved: {raw}"})
    normalized :: Path.from(~absolute).normalize()
    _symlink_check :: reject_symlink_components(~normalized, ~label)
    if fs.exists(~normalized) {
        canonical :: fs.canonicalize(~normalized) ?? return Err(CLIError{message: "{label} cannot be canonicalized: {normalized.to_string()}"})
        return Ok(~canonical)
    }
    return Ok(normalized.to_string())
}

fn checked_store_root(raw: String) String !CLIError -> {
    checked :: normalized_absolute(raw, "store root")
    base_path :: Path.home().join(".cache").join("jet-dogfood")
    base :: normalized_absolute(base_path.to_string(), "Jet dogfood cache")
    if !Path.from(~checked).is_within(Path.from(~base)) {
        return Err(CLIError{message: "store root must be under the Jet dogfood cache at {base}; choose a child path"})
    }
    return Ok(checked)
}

fn resolve_source(raw: String, project_root: String, action: String) String !CLIError -> {
    if raw.trim() == "" -> return Err(CLIError{message: "{action} source is required"})
    if project_root.trim() == "" -> return Err(CLIError{message: "project root is required"})
    project_absolute :: fs.absolute(Path.from(~project_root).normalize()) ?? return Err(CLIError{message: "project root cannot be resolved"})
    project_canonical :: fs.canonicalize(~project_absolute) ?? return Err(CLIError{message: "project root cannot be canonicalized"})
    candidate := Path.from(~raw)
    if !raw.starts_with("/") && !raw.starts_with("\\") {
        candidate = Path.from(~project_absolute).join(~raw)
    }
    absolute :: fs.absolute(candidate.normalize()) ?? return Err(CLIError{message: "{action} source cannot be resolved"})
    if !Path.from(~absolute).is_within(Path.from(~project_absolute)) {
        return Err(CLIError{message: "{action} source must be below the project root"})
    }
    if !fs.exists(~absolute) -> return Err(CLIError{message: "{action} source does not exist"})
    canonical :: fs.canonicalize(~absolute) ?? return Err(CLIError{message: "{action} source cannot be canonicalized"})
    if !Path.from(~canonical).is_within(Path.from(~project_canonical)) {
        return Err(CLIError{message: "{action} source must stay below the project root"})
    }
    return Ok(~absolute)
}

fn ingest_wire(result: store.IngestResult) String !Never -> {
    return json.to_string(DataTree.Object([
        "schema": DataTree.Text("jet.report/v1"),
        "moment": DataTree.Text("tool"),
        "status": DataTree.Text("ok"),
        "ok": DataTree.Bool(true),
        "action": DataTree.Text("ingest"),
        "id": DataTree.Text(~result.id),
        "output_hash": DataTree.Text(~result.output_hash),
        "deduplicated": DataTree.Bool(result.deduplicated)
    ]))
}

fn realize_wire(result: realization.RealizeResult) String !Never -> {
    return json.to_string(DataTree.Object([
        "schema": DataTree.Text("jet.report/v1"),
        "moment": DataTree.Text("tool"),
        "status": DataTree.Text("ok"),
        "ok": DataTree.Bool(true),
        "action": DataTree.Text("realize"),
        "provider": DataTree.Text(~result.provider),
        "reference": DataTree.Text(~result.reference),
        "id": DataTree.Text(~result.id),
        "output_hash": DataTree.Text(~result.output_hash),
        "deduplicated": DataTree.Bool(result.deduplicated)
    ]))
}

pub fn plan_command(project_root: String, store_root: String, name: String) CommandResult !Never -> {
    if checked_store_root(store_root) == {
        .Err(error) -> return error_result("plan", error.message)
        .Ok(_) -> {
            if plan.render(~project_root, ~name) == {
                .Err(error) -> return error_result("plan", error.message)
                .Ok(wire) -> return success_result(wire)
            }
        }
    }
    panic("unreachable plan result")
}

pub fn list_command(store_root: String) CommandResult !Never -> {
    if checked_store_root(store_root) == {
        .Err(error) -> return error_result("list", error.message)
        .Ok(root) -> {
            if read_only.list_json(~root) == {
                .Err(error) -> return error_result("list", error.message)
                .Ok(wire) -> return success_result(wire)
            }
        }
    }
    panic("unreachable list result")
}

pub fn inspect_command(store_root: String) CommandResult !Never -> {
    if checked_store_root(store_root) == {
        .Err(error) -> return error_result("inspect", error.message)
        .Ok(root) -> {
            if read_only.inspect_json(~root) == {
                .Err(error) -> return error_result("inspect", error.message)
                .Ok(wire) -> return success_result(wire)
            }
        }
    }
    panic("unreachable inspect result")
}

pub fn ingest_command(source: String, name: String, version: String, reference: String, project_root: String, store_root: String) CommandResult !Never -> {
    if source.trim() == "" -> return error_result("ingest", "ingest source is required")
    if name.trim() == "" -> return error_result("ingest", "ingest --name is required")
    if checked_store_root(store_root) == {
        .Err(error) -> return error_result("ingest", error.message)
        .Ok(root) -> {
            if resolve_source(~source, ~project_root, "ingest") == {
                .Err(error) -> return error_result("ingest", error.message)
                .Ok(source_path) -> {
                    if store.ingest(~root, store.IngestRequest{
                        name: name,
                        version: version,
                        reference: reference,
                        source: ~source_path,
                        expected_hash: ""
                    }) == {
                        .Err(error) -> return error_result("ingest", error.message)
                        .Ok(result) -> return success_result(ingest_wire(result))
                    }
                }
            }
        }
    }
    panic("unreachable ingest result")
}

pub fn realize_command(source: String, provider: String, name: String, version: String, reference: String, expected_hash: String, project_root: String, store_root: String) CommandResult !Never -> {
    if source.trim() == "" -> return error_result("realize", "realize source is required")
    if provider.trim() == "" -> return error_result("realize", "realize --provider is required")
    if provider != "local" && provider != "prefetched" && provider != "recorded" {
        return error_result("realize", "realize --provider must be local, prefetched, or recorded")
    }
    if provider != "recorded" {
        if name.trim() == "" -> return error_result("realize", "realize --name is required")
        if version.trim() == "" -> return error_result("realize", "realize --version is required")
        if reference.trim() == "" -> return error_result("realize", "realize --ref is required")
        if expected_hash.trim() == "" -> return error_result("realize", "realize --digest is required")
    }
    if checked_store_root(store_root) == {
        .Err(error) -> return error_result("realize", error.message)
        .Ok(root) -> {
            if resolve_source(~source, ~project_root, "realize") == {
                .Err(error) -> return error_result("realize", error.message)
                .Ok(source_path) -> {
                    if realization.realize(~root, realization.RealizeRequest{
                        provider: provider,
                        name: name,
                        version: version,
                        reference: reference,
                        source: ~source_path,
                        expected_hash: expected_hash
                    }) == {
                        .Err(error) -> return error_result("realize", error.message)
                        .Ok(result) -> return success_result(realize_wire(result))
                    }
                }
            }
        }
    }
    panic("unreachable realize result")
}

pub fn run(_args: JetpackArgs) {}
