// host capabilities (for example filesystem reads requested by a public
// query API) remain effectful.
// Portable codecs below are written in Jet.
//
// Invariants:
// - `DataTree` is the only user-facing dynamic tree. There is no `Data` alias.
// - Objects keep insertion order. Integers and floats stay distinct variants.
// - No codec fabricates a value for malformed input. Syntax problems are
//   `EncodingError`; alphabet helpers use their local typed errors.
// - Whole-value codecs are pure (`->`) and callers pass text or bytes directly.
module hex

module base32

module base64


module json

module jsonl

module csv
module toml
module yaml

module xml

module cbor

module binary

module ini
/// Wire format named by `EncodingError`.
pub enum EncodingFormat {
    JSON
    JSONL
    CSV
    TOML
    YAML
    XML
    CBOR
}

/// Why a codec stopped. `IO` is reserved for effectful streaming handles.
/// Whole-value codecs use `Syntax`, `Truncated`, `Limit`, or `Unsupported`.
pub enum EncodingErrorKind {
    Syntax
    Truncated
    Unsupported
    Limit
    IO
    State
}
/// Optional OS/handle cause attached to an `IO` error.
pub struct EncodingCause {
    pub kind: String
    pub os_code: ?Int
    pub message: String
}
/// One codec failure. Offsets are byte offsets into the original input; line
/// and column are 1-based when known. `path` is a JSON-pointer-style location
/// inside the value (`/users/0/name`), empty at the root.
#Error
pub struct EncodingError {
    pub format: EncodingFormat
    pub kind: EncodingErrorKind
    pub byte_offset: Int
    pub line: ?Int
    pub column: ?Int
    pub path: String
    pub reason: String
    pub cause: ?EncodingCause
}
#Error
pub struct HexError {
    pub reason: String
}

impl HexError {
    pub fn new(reason: String) -> HexError { HexError{reason: reason} }
}
/// Safety limits for streaming and hostile-input codecs.
pub struct EncodingLimits {
    pub buffer_bytes: Int
    pub max_depth: Int
    pub max_item_bytes: Int
    pub max_total_bytes: ?Int
    pub max_expansion_depth: Int
    pub max_expansion_bytes: Int
}
/// Pull event for streaming codecs. `End` is terminal, not an error.
pub enum DataEvent {
    Null
    Bool(Bool)
    Int(Int)
    Float(Float)
    Text(String)
    BeginArray
    EndArray
    BeginObject
    EndObject
    Field(String)
    End
}
impl EncodingLimits {
    /// Limits for ordinary documents: 64 KiB buffers, 256 nesting depth
    /// 16 MiB per item. Streaming codecs should treat these as hard caps, not
    /// hints.
    pub fn safe() -> EncodingLimits {
        {
            buffer_bytes: 65536,
            max_depth: 256,
            max_item_bytes: 16777216,
            max_total_bytes: None,
            max_expansion_depth: 32,
            max_expansion_bytes: 8388608,
        }
    }
}
pub struct Reader {
    pub events: [DataEvent]
    pub index: Int
}
impl Reader {
    pub fn next(&self) -> ?DataEvent {
        if self.index >= self.events.len() -> return None
        ev :: self.events[self.index]
        self.index += 1
        Val(ev)
    }
}
/// The one dynamic value. Adapters must not invent a second tree type.
///
/// `.text()` is strict: only `Text` leaves succeed. `.to_text()` also projects
/// integers, floats, and booleans, and returns `None` for `Null` and containers.
pub enum DataTree {
    Null
    Bool(Bool)
    Int(Int)
    Float(Float)
    Text(String)
    Array([DataTree])
    Object([String:DataTree])
}
impl DataTree {
    pub fn field(self, name: String) -> ?DataTree {
        if self == {
            .Object(entries) -> return entries.get(name)
            else -> return None
        }
    }

    pub fn at(self, index: Int) -> ?DataTree {
        if self == {
            .Array(items) -> {
                if index < 0 || index >= items.len() -> return None
                return Val(items[index])
            }
            else -> return None
        }
    }

    pub fn int(self) -> ?Int {
        if self == {
            .Int(n) -> return Val(n)
            else -> return None
        }
    }

    pub fn float(self) -> ?Float {
        if self == {
            .Float(n) -> return Val(n)
            .Int(n) -> return Val(Float{n})
            else -> return None
        }
    }

    pub fn text(self) -> ?String {
        if self == {
            .Text(s) -> return Val(s)
            else -> return None
        }
    }

    pub fn bool(self) -> ?Bool {
        if self == {
            .Bool(v) -> return Val(v)
            else -> return None
        }
    }

    /// Project a leaf as text. Containers and `Null` are absent — they have
    /// no single lossless spelling.
    pub fn to_text(self) -> ?String {
        if self == {
            .Text(s) -> return Val(s)
            .Int(n) -> return Val("{n}")
            .Float(n) -> return Val("{n}")
            .Bool(v) -> {
                if v -> return Val("true")
                return Val("false")
            }
            else -> return None
        }
    }

    /// Structural equality that ignores object insertion order, keeps array
    /// order, and never equates `NaN` with itself or with a number.
    pub fn equal_unordered(self, other: DataTree) -> Bool { tree_equal(self, other) }
}
fn tree_equal(left: DataTree, right: DataTree) -> Bool {
    if left == {
        .Null -> {
            if right == {
                .Null -> return true
                else -> return false
            }
        }
        .Bool(a) -> {
            if right == {
                .Bool(b) -> return a == b
                else -> return false
            }
        }
        .Int(a) -> {
            if right == {
                .Int(b) -> return a == b
                else -> return false
            }
        }
        .Float(a) -> {
            if right == {
                .Float(b) -> {
                    if a != a || b != b -> return false
                    return a == b
                }
                else -> return false
            }
        }
        .Text(a) -> {
            if right == {
                .Text(b) -> return a == b
                else -> return false
            }
        }
        .Array(xs) -> {
            if right == {
                .Array(ys) -> {
                    if xs.len() != ys.len() -> return false
                    loop i in 0..<xs.len() {
                        if !tree_equal(xs[i], ys[i]) -> return false
                    }
                    return true
                }
                else -> return false
            }
        }
        .Object(xs) -> {
            if right == {
                .Object(ys) -> {
                    if xs.len() != ys.len() -> return false
                    loop pair in xs {
                        if !ys.has_key(pair.key) -> return false
                        right_value :: ys.get(pair.key) ?? DataTree.Null
                        if !tree_equal(pair.value, right_value) -> return false
                    }
                    return true
                }
                else -> return false
            }
        }
        else -> return false
    }
}
impl EncodingError {
    pub fn syntax(format: EncodingFormat, offset: Int, line: Int, column: Int, path: String, reason: String) -> EncodingError {
        return {
            format: format,
            kind: EncodingErrorKind.Syntax,
            byte_offset: offset,
            line: Val(line),
            column: Val(column),
            path: path,
            reason: reason,
            cause: None,
        }
    }

    pub fn truncated(format: EncodingFormat, offset: Int, line: Int, column: Int, path: String) -> EncodingError {
        return {
            format: format,
            kind: EncodingErrorKind.Truncated,
            byte_offset: offset,
            line: Val(line),
            column: Val(column),
            path: path,
            reason: "input ended before the value was complete",
            cause: None,
        }
    }

    pub fn unsupported(format: EncodingFormat, offset: Int, reason: String) -> EncodingError {
        return {
            format: format,
            kind: EncodingErrorKind.Unsupported,
            byte_offset: offset,
            line: None,
            column: None,
            path: "",
            reason: reason,
            cause: None,
        }
    }
}
/// Convert one nibble to lowercase ASCII. Callers must pass `0..15`.
pub fn hex_nibble(n: Int) -> U8 {
    if n < 10 -> return (U8{48 + n})
    (U8{87 + n})
}

/// Hex alphabet lookup. Accepts `0-9A-Fa-f`. Other bytes are absent.
pub fn hex_value(b: U8) -> ?Int {
    n :: Int.from_u8(b)
    if n >= 48 && n <= 57 -> return Val(n - 48)
    if n >= 97 && n <= 102 -> return Val(n - 87)
    if n >= 65 && n <= 70 -> return Val(n - 55)
    None
}

/// Lowercase hex of `bytes`. Allocates `2 * bytes.len()` ASCII bytes.
pub fn bytes_to_hex(bytes: [U8]) -> String {
    out := [U8]{}
    loop b in bytes {
        n :: Int.from_u8(b)
        out.push(hex_nibble(n /% 16))
        out.push(hex_nibble(n %% 16))
    }
    String.from_bytes(out) ?? ""
}


pub fn test_hex(text: String) -> [U8] !HexError {
    raw :: text.bytes()
    if raw.len() %% 2 != 0 {
        return Err(HexError.new("odd"))
    }
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        hi :: hex_value(raw[i]) ?? return Err(HexError.new("bad"))
        lo :: hex_value(raw[i + 1]) ?? return Err(HexError.new("bad"))
        out.push(U8{hi * 16 + lo})
        i = i + 2
    }
    Ok(out)
}
