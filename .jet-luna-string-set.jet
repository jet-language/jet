use core.collections.set as api

fn run() {
    a :: api.from_list([String]{"a", "b", "a"})
    b :: api.from_list([String]{"b", "c"})
    print(api.to_list(a))
    print(api.len(a))
    print(api.contains(a, "a"))
    print(api.contains(a, "z"))
    print(api.to_list(api.add(a, "c")))
    print(api.to_list(api.discard(a, "b")))
    print(api.to_list(api.remove(a, "z") ?? api.new()))
    print(api.to_list(api.union(a, b)))
    print(api.to_list(api.intersection(a, b)))
    print(api.to_list(api.difference(a, b)))
    print(api.to_list(api.symmetric_difference(a, b)))
    print(api.issubset(a, api.union(a, b)))
    print(api.issuperset(api.intersection(a, b), a))
    print(api.isdisjoint(a, api.from_list([String]{"z"})))
    print(api.to_list(api.clear(a)))
}
