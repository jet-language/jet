#!/usr/bin/env bash
# Fast pre-push doc-sync tier (D-CI3). These focused tests may compile stale
# targets; the full suite runs in CI via scripts/agent/verify-full.sh. Wired by
# `git config core.hooksPath scripts/githooks` (see flake.nix shellHook).
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo"

echo "pre-push: capability-claim ledger check"
nix develop -c node scripts/agent/check-capability-ledger.mjs --check

echo "pre-push: truthfulness"
nix develop -c cargo test --test truthfulness

echo "pre-push: decisions"
nix develop -c cargo test --test decisions

echo "pre-push: diagnostics coverage"
nix develop -c cargo test --test diagnostics_coverage
