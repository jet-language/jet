#!/usr/bin/env bash
# Run one command in Jet's core shell, reusing nix-direnv's cache when present.
# `jet-env full <cmd>` selects FFI/browser/VM integration tooling.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
profile="core"
if [ "${1:-}" = "full" ]; then
  profile="full"
  shift
fi
if [ "$#" -eq 0 ]; then
  echo "usage: scripts/agent/jet-env [full] <command> [args...]" >&2
  exit 64
fi
# The development command means this checkout's compiler, not the prebuilt Jet
# package that the Nix shell also puts on PATH. Keep the package as bootstrap
# fallback for a clean tree with no local binary yet.
if [ "$1" = "jet" ] && [ -x "$repo/target/debug/jet" ]; then
  shift
  set -- "$repo/target/debug/jet" "$@"
fi

# Check after every environment boundary. direnv and nix can add a shared
# target dir after the outer process starts, so checking only the caller's
# environment leaves the same cross-worktree corruption door open.
check_target_dir() {
  local checkout="$1"

  # /tmp is RAM-backed tmpfs on this machine; cargo artifacts or test scratch
  # there fill swap and trigger kernel OOM kills. Use a disk path instead.
  reject_tmpfs_path() {
    local name="$1"
    local value="$2"
    local resolved
    resolved="$(realpath -m -- "$value")"
    case "$resolved" in
      /tmp|/tmp/*)
        echo "jet-env: $name=$value is on tmpfs /tmp (RAM-backed)." >&2
        echo "jet-env: artifacts there cause OOM crashes; use a disk path under the checkout." >&2
        exit 64
        ;;
    esac
  }

  if [ -n "${CARGO_TARGET_DIR:-}" ]; then
    reject_tmpfs_path CARGO_TARGET_DIR "$CARGO_TARGET_DIR"
  fi
  for scratch_var in JET_TEST_SCRATCH_DIR JET_DEV_ORACLE_CACHE_DIR; do
    scratch_value="${!scratch_var:-}"
    if [ -n "$scratch_value" ]; then
      reject_tmpfs_path "$scratch_var" "$scratch_value"
    fi
  done

  # A target dir outside this checkout can be shared by another same-name
  # checkout; cargo then reports "Finished" while target/debug/<bin> still holds
  # the other checkout's binary with its embedded assets. Per-checkout caches
  # only (card 1640).
  if [ -n "${CARGO_TARGET_DIR:-}" ]; then
    case "$(realpath -m -- "$CARGO_TARGET_DIR")" in
      "$checkout"/*) ;;
      *)
        echo "jet-env: CARGO_TARGET_DIR=$CARGO_TARGET_DIR lies outside this checkout." >&2
        echo "jet-env: shared caches serve stale cross-checkout binaries; use $checkout/target-<name>." >&2
        exit 64
        ;;
    esac
  fi
}

set_default_target_dir() {
  if [ -z "${CARGO_TARGET_DIR:-}" ]; then
    export CARGO_TARGET_DIR="$1/target"
  fi
}

set_default_target_dir "$repo"
check_target_dir "$repo"

# Cache-mode selection (card #1785): a COLD tree (no target/debug yet — fresh
# worktree) compiles fastest through sccache's input-keyed shared cache, which
# is safe across diverged branches (unlike a shared CARGO_TARGET_DIR, banned
# above and by papercut pc08xq6wo). A WARM tree keeps cargo's incremental
# cache, which beats sccache on delta rebuilds. The sccache binary lives in
# the nix shell, so the availability check must run AFTER the shell env is
# materialized — hence the wrapper below. JET_NO_SCCACHE=1 opts out.
cache_mode_env() {
  # $1 = checkout root (baked in by the caller — the nix-develop transplant
  # below has no access to this script's variables at runtime).
  if [ -z "${JET_NO_SCCACHE:-}" ] && [ -z "${RUSTC_WRAPPER:-}" ]; then
    tgt="${CARGO_TARGET_DIR:-$1/target}"
    if [ ! -d "$tgt/debug" ] && command -v sccache >/dev/null 2>&1; then
      export RUSTC_WRAPPER=sccache
      export CARGO_INCREMENTAL=0
    fi
  fi
}

# `direnv export` returns cached environment assignments when `.envrc` has
# been allowed. Execute the requested command once; never fall back after its
# own failure, which would duplicate writes/tests.
if command -v direnv >/dev/null 2>&1; then
  if env_dump="$(cd "$repo" && JET_DEV_SHELL="$profile" direnv export bash 2>/dev/null)"; then
    eval "$env_dump"
    set_default_target_dir "$repo"
    check_target_dir "$repo"
    cache_mode_env "$repo"
    exec "$@"
  fi
fi

# Inside `nix develop`, re-enter this script's cache selection via bash -c so
# the check sees the shell's PATH.
joined="$(printf '%q ' "$@")"
if [ "$profile" = "full" ]; then
  exec nix develop "$repo#full" -c bash -c "$(declare -f check_target_dir set_default_target_dir cache_mode_env); set_default_target_dir $(printf %q "$repo"); check_target_dir $(printf %q "$repo"); cache_mode_env $(printf %q "$repo"); exec $joined"
fi
exec nix develop "$repo" -c bash -c "$(declare -f check_target_dir set_default_target_dir cache_mode_env); set_default_target_dir $(printf %q "$repo"); check_target_dir $(printf %q "$repo"); cache_mode_env $(printf %q "$repo"); exec $joined"
