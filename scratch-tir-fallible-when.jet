enum ClassifyError {
    Bad(String)
}
fn classify(x: Int) Int !ClassifyError -> {
    if x == 0 {
        return Err(ClassifyError.Bad("bad"))
    }
    return Ok((x + 10))
}
fn run() {
    if classify(5) == {
        .Ok(n) -> {
            print(n)
        }
        .Err(e) -> {
            print(e)
        }
    }
    if classify(0) == {
        .Ok(n) -> {
            print(n)
        }
        .Err(e) -> {
            print(e)
        }
    }
}
