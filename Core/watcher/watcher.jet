package {
    name: "core.watcher"
    version: "0.0.1"
    edition: "2026"
    description: "Filesystem, process, and port watches."
    license: "MIT"
    outputs: {
        watcher: .Library{ entry: watcher }
    }
}

use core as core
use core.files as files

struct WatchHandle { kind: String, target: String }
struct WatchSet { handles: [WatchHandle] }

fn files(path: String) -[FS]> WatchHandle IOError! {
    if path.bytes().len() == 0 {
        return Err(IOError.InvalidInput(IOContext{
            operation: .Resolve,
            resource: Val(path),
            os_code: None,
            cause: Val("empty path"),
        }))
    }
    core.watcher.files(path)
}

fn process_pid(pid: Int) -> WatchHandle Never! {
    core.watcher.process_pid(pid)
}

fn port(host: String, port: Int) -[Net]> WatchHandle Never! {
    core.watcher.port(host, port)
}

fn set() -> WatchSet Never! { core.watcher.set() }


fn add(set: WatchSet, handle: WatchHandle) -[IO]> WatchSet Never! {
    set.add(handle)
    ~set
}

fn remove(set: WatchSet, target: String) -> WatchSet IOError! {
    if target.len() == 0 {
        return Err(IOError.InvalidInput(IOContext{
            operation: .Resolve,
            resource: Val(target),
            os_code: None,
            cause: Val("empty target"),
        }))
    }
    Err(IOError.Other(IOContext{
        operation: .Resolve,
        resource: Val(target),
        os_code: None,
        cause: Val("watch sets do not support removal"),
    }))
}

fn contains(set: WatchSet, target: String) -> Bool IOError! {
    if target.len() == 0 -> return Ok(false)
    Err(IOError.Other(IOContext{
        operation: .Resolve,
        resource: Val(target),
        os_code: None,
        cause: Val("watch sets do not expose target lookup"),
    }))
}

fn len(set: WatchSet) -> Int Never! {
    summary_count(set.summary())
}

fn kind(handle: WatchHandle) -> String Never! {
    summary_kind(handle.summary())
}

fn target(handle: WatchHandle) -> String Never! {
    summary_target(handle.summary())
}


enum WatchDomain {
    File
    Process
    Port
}

enum WatchEventKind {
    Created
    Modified
    Removed
    Error
    Exited
    Ready
}

struct WatchEvent {
    domain: WatchDomain
    kind: WatchEventKind
    path: String
    detail: String
    pid: Int
    port: Int
}

fn recursive(path: String) -[FS]> WatchHandle IOError! {
    // The host file watcher already snapshots directories recursively.
    files(path)
}

fn debounce(handle: WatchHandle, ms: Int) -> WatchHandle IOError! {
    if ms < 0 {
        return Err(IOError.InvalidInput(IOContext{
            operation: .Resolve,
            resource: Val(target(handle)),
            os_code: None,
            cause: Val("negative debounce interval"),
        }))
    }
    Err(IOError.Other(IOContext{
        operation: .Resolve,
        resource: Val(target(handle)),
        os_code: None,
        cause: Val("debounce is not supported by the host watcher"),
    }))
}

fn poll(handle: WatchHandle) -[IO]> [WatchEvent] Never! { handle.poll() }

fn events(handle: WatchHandle) -[IO]> [WatchEvent] Never! { handle.events() }

fn cancel(handle: WatchHandle) Never! -[IO]> { handle.cancel() }

fn is_active(handle: WatchHandle) -> Bool Never! { handle.is_active() }

fn summary(handle: WatchHandle) -> String Never! { handle.summary() }

fn drain(set: WatchSet) -[IO]> [WatchEvent] Never! { set.poll() }

fn summary_kind(text: String) -> String {
    if has_prefix(text, "watch file ") -> return "file"
    if has_prefix(text, "watch process ") -> return "process"
    if has_prefix(text, "watch port ") -> return "port"
    "watch"
}

fn summary_target(text: String) -> String Never! {
    if has_prefix(text, "watch file ") -> return suffix(text, 11)
    if has_prefix(text, "watch process ") -> return suffix(text, 14)
    if has_prefix(text, "watch port ") -> return suffix(text, 11)
    ""
}

fn summary_count(text: String) -> Int {
    seen := false
    n := 0
    loop b in text.bytes() {
        if seen {
            if b < 48 || b > 57 -> return n
            n = n * 10 + (b - 48)
        } else if b == 61 {
            seen = true
        }
    }
    n
}

fn has_prefix(text: String, prefix: String) -> Bool Never! {
    raw := text.bytes()
    want := prefix.bytes()
    if want.len() > raw.len() -> return false
    loop i in 0..<want.len() {
        if raw[i] != want[i] -> return false
    }
    true
}

fn suffix(text: String, start: Int) -> String Never! {
    raw := text.bytes()
    out := [U8]{}
    i := start
    loop {
        if i >= raw.len() -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}

