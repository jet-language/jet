use {
    core: core
    net: core.net
    crypto: core.crypto
    ssldefs: __core_net_ssl_defs
    ssltls: __core_net_ssl_tls
    sslmsg: __core_net_ssl_msg
    x509crt: __core_crypto_x509crt
    pk: __core_crypto_pk
    x509: __core_crypto_x509
    asn1: __core_crypto_asn1
    pkparse: __core_crypto_pkparse
    drbg: __core_crypto_drbg
    hashes: __core_crypto_md
    suites: __core_net_ssl_ciphersuites
    cipher: __core_crypto_cipher
    rt: jet.runtime.time
}

// core.net.tls — TLS 1.2/1.3 byte streams over the Jet port of Mbed TLS
// 3.6.7 (the engine in Core/Net/SSL, on the core.crypto parts).
//
// The engine reads and writes records through byte queues (its SSLBio); this
// file moves them between the queues and the TCPStream. Everything else is
// Jet policy and lives here too: system and custom trust, hostname
// verification, version bounds, ALPN, readiness waits and deadlines,
// WANT_READ/WANT_WRITE retries, close_notify, the verified peer identity,
// and every error message. The TCPStream keeps owning the socket.

ClientConfig: struct {
    host: String{""},
    alpn: [String]{[]},
    trust: TLSClientTrust{TLSClientTrust.System},
    identity: ClientIdentity?{None},
    min_version: TLSVersion{TLSVersion.TLS12},
    max_version: TLSVersion{TLSVersion.TLS13},

    // System roots, no client certificate, TLS 1.2 through 1.3, no ALPN.
    default: fn() -> ClientConfig Never! { ClientConfig{} }

    with_alpn: fn(self, protocols: [String]) -> ClientConfig IOError! {
        message: alpn_problem(protocols)
        if message != "" -> return Err(config_error("ClientConfig.with_alpn", message))
        Ok(config_with(self, protocols.copy(), self.trust.copy(), self.identity.copy(), self.min_version, self.max_version))
    }

    with_trust: fn(self, trust: TLSClientTrust) -> ClientConfig IOError! {
        Ok(config_with(self, self.alpn.copy(), trust.copy(), self.identity.copy(), self.min_version, self.max_version))
    }

    with_client_identity: fn(self, identity: ClientIdentity) -> ClientConfig IOError! {
        Ok(config_with(self, self.alpn.copy(), self.trust.copy(), Val(identity.copy()), self.min_version, self.max_version))
    }

    with_version_bounds: fn(self, /, *, min: TLSVersion, max: TLSVersion) -> ClientConfig IOError! {
        if version_rank(min) > version_rank(max) {
            return Err(config_error("ClientConfig.with_version_bounds", "minimum TLS version exceeds maximum"))
        }
        Ok(config_with(self, self.alpn.copy(), self.trust.copy(), self.identity.copy(), min, max))
    }
}

// `from_pem` stores the validated PEM text; `identity(cert, key)` is a plain
// carrier that the handshake validates.
ClientIdentity: struct {
    cert: String{""},
    key: String{""},

    // Validates a PEM certificate chain and the leaf's PEM private key.
    from_pem: fn(cert_chain: [U8], private_key: [U8]) -> ClientIdentity IOError! {
        identity: identity_validate(cert_chain, private_key) ?? return Err(config_error("ClientIdentity.from_pem", err.message))
        Ok(identity)
    }
}

// `from_pem` stores validated PEM roots; `roots(path)` names a bundle file.
RootCertificates: struct {
    path: String{""},
    pem: String{""},

    // Validates one or more PEM CERTIFICATE blocks and nothing else.
    from_pem: fn(pem: [U8]) -> RootCertificates IOError! {
        text: roots_validate(pem) ?? return Err(config_error("RootCertificates.from_pem", err.message))
        Ok(RootCertificates{pem: text})
    }
}

TLSClientTrust: enum {
    System,
    SystemPlus(RootCertificates),
    CustomOnly(RootCertificates),
}

TLSCertificate: struct {
    der: [U8],
    sha256: [U8],
    spki_sha256: [U8],
    dns_names: [String],
    valid_from_unix_ms: Int,
    valid_until_unix_ms: Int,
    subject: String,
    issuer: String,
}

TLSPeerIdentity: struct {
    verified_server_name: String,
    leaf: TLSCertificate,
    certificate_chain: [TLSCertificate],
    cipher_suite: String,
    tls_version: TLSVersion,
}

// Numbered as the protocol's version field (RFC 8446 section 4.1.2).
#[Specified, Layout(U16)]
TLSVersion: enum {
    TLS12 = 771,
    TLS13 = 772,
}

// A stream made by `client` or `__server`. `TLSStream{}` is a closed stream.
TLSStream: struct {
    state: Shared<TLSState>?{None},

    read_bytes: fn(self, max_bytes: Int, /, *, deadline: Duration) -[Net, Time.Wait]> [U8] IOError! {
        if max_bytes <= 0 {
            return Err(IOError.InvalidInput(io_context(.Read, "tls read limit must be positive")))
        }
        end_ns: deadline_end(deadline, "tls read") ?? return Err(net_to_io(err))
        state: __state(self) ?? return Err(io_error(.Read, "TLS stream is closed"))
        guard := state.guard_edit()
        __read(guard.value, max_bytes, end_ns)
    }

    // Appends up to `limit` plaintext bytes to `buffer` and returns the
    // count, 0 at the end of the stream. The bytes move from the engine's
    // record buffer into `buffer`, so a caller that clears and reuses one
    // List reads without allocating (#5976).
    read_into: fn(self, buffer: &[U8], limit: Int, /, *, deadline: Duration) -[Net, Time.Wait]> Int IOError! {
        if limit <= 0 {
            return Err(IOError.InvalidInput(io_context(.Read, "tls read_into limit must be positive")))
        }
        end_ns: deadline_end(deadline, "tls read") ?? return Err(net_to_io(err))
        state: __state(self) ?? return Err(io_error(.Read, "TLS stream is closed"))
        guard := state.guard_edit()
        read_into_locked(guard.value, buffer, limit, end_ns)
    }

    write_bytes: fn(self, bytes: [U8], /, *, deadline: Duration) -[Net, Time.Wait]> IOError! {
        end_ns: deadline_end(deadline, "tls write all") ?? return Err(net_to_io(err))
        state: __state(self) ?? return Err(io_error(.Write, "TLS stream is closed"))
        guard := state.guard_edit()
        write_all(guard.value, bytes, end_ns)
    }

    ready: fn(self, interest: NetReadyInterest, /, *, deadline: Duration) -[Net, Time.Wait]> NetReady IOError! {
        operation: if wants_write_only(interest) -> IOOperation.Write else -> IOOperation.Read
        end_ns: deadline_end(deadline, "tls ready") ?? return Err(net_to_io(err))
        if end_ns <= rt.clock_mono_ns() -> return Err(net_to_io(deadline_error("tls ready")))
        state: __state(self) ?? return Err(io_error(operation, "TLS stream is closed"))
        guard := state.guard_edit()
        if guard.value.closed -> return Err(io_error(operation, "TLS stream is closed"))
        want_read: !wants_write_only(interest)
        want_write: wants_write(interest)
        loop {
            if want_read {
                buffered: fill_pending(guard.value, operation, end_ns, false) ?? return Err(err)
                if buffered -> return Ok(NetReady{readable: true, writable: false})
            }
            raw: ready_wait(guard.value.tcp, interest, end_ns, "tls ready") ?? return Err(net_to_io(err))
            readable := false
            if want_read && raw.readable {
                readable = fill_pending(guard.value, operation, end_ns, true) ?? return Err(err)
            }
            writable: want_write && raw.writable
            if readable || writable -> return Ok(NetReady{readable: readable, writable: writable})
        }
    }

    // Sends close_notify, shuts down the socket's write side and closes the
    // stream, freeing the engine and wiping its buffers. Closing a closed
    // stream succeeds.
    close: fn(self) -[Net, Time.Wait]> IOError! {
        state: __state(self) ?? return Err(io_error(.Close, "TLS stream is closed"))
        guard := state.guard_edit()
        if guard.value.closed -> return Ok()
        _: send_close_notify(guard.value, C_NO_DEADLINE, "tls close") ?? return Err(err)
        guard.value.closed = true
        release(guard.value)
        Ok()
    }

    // Sends close_notify and shuts down the write side; reads stay open.
    close_write: fn(self, /, *, deadline: Duration) -[Net, Time.Wait]> IOError! {
        end_ns: deadline_end(deadline, "tls close write") ?? return Err(net_to_io(err))
        state: __state(self) ?? return Err(io_error(.Close, "TLS stream is closed"))
        guard := state.guard_edit()
        if guard.value.closed -> return Err(io_error(.Close, "TLS stream is closed"))
        send_close_notify(guard.value, end_ns, "tls close write")
    }

    // The verified server identity. Server-side and closed streams have none
    // and report an empty identity.
    peer_identity: fn(self) -> TLSPeerIdentity Never! {
        state: __state(self) ?? return empty_identity()
        guard := state.guard_edit()
        if guard.value.peer == .Val(peer) -> return peer.copy()
        empty_identity()
    }
}

// A configuration before setup: the engine's config, the roots loaded so
// far, and the generator the connection draws from.
priv TLSContext: struct {
    conf: ssldefs.SSLConfig,
    ca: [x509crt.X509Crt],
    rng: drbg.HMACDrbg,
}

priv TLSState: struct {
    ssl: ssldefs.SSLContext,
    rng: drbg.HMACDrbg,
    tcp: TCPStream,
    // The plaintext buffer the engine reads into, C_RECORD_BYTES long.
    buffer: [U8],
    peer: TLSPeerIdentity?,
    pending: [U8],
    read_eof: Bool,
    write_closed: Bool,
    closed: Bool,

    // The engine's secrets and the plaintext the stream holds die wiped: when the
    // last handle to the state goes, after a failed handshake included, the
    // engine is freed (mbedtls_ssl_free) and the buffers zeroed. `close` does the
    // same at once.
    impl Close {
        close: fn(&&self) {
            ssl := self.ssl.move()
            ssltls.ssl_free(ssl)
            buffer := self.buffer.move()
            ssldefs.ssl_wipe(buffer)
            pending := self.pending.move()
            ssldefs.ssl_wipe(pending)
        }
    }
}

// Free the engine and wipe the buffers of a stream that is done.
priv release: fn(tls: &TLSState) Never! {
    ssltls.ssl_free(tls.ssl)
    ssldefs.ssl_wipe(tls.buffer)
    ssldefs.ssl_wipe(tls.pending)
    tls.pending = [U8]{}
}

// One engine read: the byte count or the status, and the bytes read.
priv Got: struct {
    status: Int,
    bytes: [U8],
}

#Error
priv TLSFailure: struct {
    message: String,

    impl Display {
        display: fn(self) -> String { self.message.copy() }
    }

    impl Debug {
        debug: fn(&&self) -> String { self.message }
    }
}

priv fail: fn(message: String) -> TLSFailure Never! { TLSFailure{message: message} }

// Mbed TLS 3.6 status codes this policy acts on; the engine's errors map to
// them through ssldefs.ssl_error_code.
C_WANT_READ: -26880  // MBEDTLS_ERR_SSL_WANT_READ -0x6900

C_WANT_WRITE: -26752  // MBEDTLS_ERR_SSL_WANT_WRITE -0x6880

C_NEW_SESSION_TICKET: -31488  // MBEDTLS_ERR_SSL_RECEIVED_NEW_SESSION_TICKET -0x7B00

C_PEER_CLOSE_NOTIFY: -30848  // MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY -0x7880

// The socket statuses mbedtls_net_recv and mbedtls_net_send return.
C_NET_CONN_RESET: -80  // MBEDTLS_ERR_NET_CONN_RESET -0x0050

C_NET_RECV_FAILED: -76  // MBEDTLS_ERR_NET_RECV_FAILED -0x004C

C_NET_SEND_FAILED: -78  // MBEDTLS_ERR_NET_SEND_FAILED -0x004E

// An unreadable file (mbedtls_x509_crt_parse_file, through
// mbedtls_pk_load_file) and an unreadable directory
// (mbedtls_x509_crt_parse_path).
C_PK_FILE_IO_ERROR: -15872  // MBEDTLS_ERR_PK_FILE_IO_ERROR -0x3E00

C_X509_FILE_IO_ERROR: -10496  // MBEDTLS_ERR_X509_FILE_IO_ERROR -0x2900

C_NO_DEADLINE: 9223372036854775807

C_WAIT_SLICE_NS: 3600000000000

C_RECORD_BYTES: 16384

// The generator's seed: HMAC_DRBG-SHA-256's entropy and nonce lengths.
C_SEED_BYTES: 48

C_TRUNCATION: "TLS protocol truncation: peer closed connection without sending TLS close_notify"

// The two-argument native leaf consumes a connected TCPStream and a server
// name. Do not manufacture a descriptor or call the leaf with host/port text:
// the transport and TLS capabilities are separate typed boundaries.
client: fn(host: String, port: Int) -[Net, Time.Wait]> TLSStream IOError! {
    if !valid_host(host) {
        return Err(tls_error("client", host, "host is empty or contains invalid endpoint syntax"))
    }
    if port <= 0 || port > 65535 {
        return Err(tls_error("client", host, "port must be in 1..=65535"))
    }
    tcp := if net.tcp_connect(format_host_port(host, port)) == {
        .Ok(stream) -> stream
        .Err(_) -> {
            return Err(tls_error("client", host, "transport connect failed"))
        }
    }
    __client_stream_entry(tcp, host)
}

// Checked Core call rows keep the moved-stream and labeled handshake forms
// of `client`; Sema selects one of these by argument count.
__client_stream_entry: fn(stream: &&TCPStream, server_name: String) -[Net, Time.Wait]> TLSStream IOError! {
    tls := client_connect(stream, server_name, ClientConfig{}, forever()) ?? return Err(net_to_io(err))
    Ok(tls)
}

__client_deadline_entry: fn(stream: &&TCPStream, server_name: String, deadline: Duration) -[Net, Time.Wait]> TLSStream NetError! {
    client_connect(stream, server_name, ClientConfig{}, deadline)
}

__client_config_deadline_entry: fn(stream: &&TCPStream, server_name: String, config: ClientConfig, deadline: Duration) -[Net, Time.Wait]> TLSStream NetError! {
    client_connect(stream, server_name, config, deadline)
}

priv client_connect: fn(stream: &&TCPStream, server_name: String, config: ClientConfig, deadline: Duration) -[Net, Time.Wait]> TLSStream NetError! {
    tcp := stream.move()
    end_ns: deadline_end(deadline, "tls handshake") ?? return Err(err)
    context := client_tls_context(server_name, config) ?? return Err(net_error("tls handshake", err.message))
    state := open(context, tcp, server_name) ?? return Err(net_error("tls handshake", "TLS handshake with `{server_name}` failed: {ssl_text(err)}"))
    _: run_handshake(state, server_name, end_ns) ?? return Err(err)
    peer: verified_peer_identity(state.ssl, server_name) ?? return Err(NetError.TLS(tls_error_detail("tls peer identity", err.message)))
    state.peer = Val(peer)
    Ok(TLSStream{state: Val(Shared{state})})
}

// Internal server handshake for Core's own TLS servers and loopback proofs.
// The client certificate is not requested, so the stream has no peer identity.
__server: fn(stream: &&TCPStream, cert_pem: String, key_pem: String, alpn: [String], deadline: Duration) -[Net, Time.Wait]> TLSStream NetError! {
    tcp := stream.move()
    end_ns: deadline_end(deadline, "tls accept") ?? return Err(err)
    context := server_tls_context(cert_pem, key_pem) ?? return Err(net_error("tls accept", err.message))
    _: add_alpn(context, alpn) ?? return Err(net_error("tls accept", err.message))
    context.conf.authmode = ssldefs.SSL_VERIFY_NONE
    state := open(context, tcp, "") ?? return Err(net_error("tls accept", "TLS handshake failed: {ssl_text(err)}"))
    _: run_handshake(state, "", end_ns) ?? return Err(err)
    Ok(TLSStream{state: Val(Shared{state})})
}

// A server context holding the certificate chain and private key. The HTTPS
// listener (`tls: server.tls(cert, key)`) also builds one at bind to reject an
// unusable identity before serving (
// Docs/Spec/syntax-decisions.md:5083). The messages are the Rust oracle's
// (c9129d174d^): a certificate PEM holds a CERTIFICATE block, and a key PEM
// holds a PKCS#8, PKCS#1 or SEC1 private key block.
priv server_tls_context: fn(cert_pem: String, key_pem: String) -> TLSContext TLSFailure! {
    if !cert_pem.contains("-----BEGIN CERTIFICATE-----") {
        return Err(fail("TLS certificate PEM did not contain a certificate"))
    }
    if !key_pem.contains("-----BEGIN PRIVATE KEY-----") && !key_pem.contains("-----BEGIN RSA PRIVATE KEY-----") && !key_pem.contains("-----BEGIN EC PRIVATE KEY-----") {
        return Err(fail("TLS private key PEM did not contain a private key"))
    }
    context := context_new(ssldefs.SSL_IS_SERVER) ?? return Err(err)
    if __has_nul(cert_pem) || __has_nul(key_pem) {
        return Err(fail("TLS server identity is invalid: PEM text contains a NUL byte"))
    }
    identity: own_identity(context, cert_pem, key_pem)
    if identity != 0 {
        return Err(fail("TLS certificate and private key do not match: {mbedtls_text(identity)}"))
    }
    Ok(context)
}

read_bytes: fn(stream: &TLSStream, n: Int) -[Net, Time.Wait]> [U8] IOError! {
    if n <= 0 -> return Err(tls_error("read_bytes", "", "read limit must be positive"))
    stream.read_bytes(n, deadline: forever())
}

// Up to `n` bytes as text; no byte is lost (#4664). A character the limit or
// a record cuts stays for the next read, and one that starts the read is
// read whole, up to 3 bytes past `n`. Bytes that are not UTF-8, and a
// character the end of the stream cuts, fail the read and stay for
// `read_bytes`.
read: fn(stream: &TLSStream, n: Int) -[Net, Time.Wait]> String IOError! {
    if n <= 0 -> return Err(tls_error("read", "", "read limit must be positive"))
    end_ns: deadline_end(forever(), "tls read") ?? return Err(net_to_io(err))
    state: __state(stream) ?? return Err(io_error(.Read, "TLS stream is closed"))
    guard := state.guard_edit()
    __read_text(guard.value, n, end_ns)
}

write_some: fn(stream: &TLSStream, bytes: [U8]) -[Net, Time.Wait]> Int IOError! {
    _: stream.write_bytes(bytes, deadline: forever()) ?? return Err(err)
    Ok(bytes.len())
}

write_bytes: fn(stream: &TLSStream, bytes: [U8]) -[Net, Time.Wait]> IOError! {
    stream.write_bytes(bytes, deadline: forever())
}

write: fn(stream: &TLSStream, text: String) -[Net, Time.Wait]> IOError! {
    write_bytes(stream, text.bytes())
}

close: fn(stream: TLSStream) -[Net, Time.Wait]> IOError! { stream.close() }

sni: fn(stream: &TLSStream) -[Net]> String Never! {
    peer: stream.peer_identity()
    peer.verified_server_name
}

// TLSStream deliberately does not expose a transport socket address. Keeping
// a source-level port field would be an invalid nominal identity for the native
// provider, so report the missing capability instead of fabricating a value.
peer_port: fn(stream: &TLSStream) -[Net]> Int IOError! {
    Err(tls_error("peer_port", "", "TLS provider does not expose the peer port"))
}

// A TLS stream deliberately cannot be downgraded: doing so would make the
// caller believe plaintext bytes are protected by the old connection state.
unwrap: fn(stream: &TLSStream) -[Net]> TCPStream IOError! {
    Err(tls_error("unwrap", "", "TLS stream cannot be downgraded"))
}

version_name: fn(v: TLSVersion) -> String Never! {
    if v == TLSVersion.TLS12 -> return "TLSv1.2"
    return "TLSv1.3"
}

parse_version: fn(name: String) -> TLSVersion? Never! {
    n := ascii_lower(trim_ascii(name))
    if n == {
        "tlsv1.2" | "tls1.2" | "1.2" | "tls12" -> Val(TLSVersion.TLS12)
        "tlsv1.3" | "tls1.3" | "1.3" | "tls13" -> Val(TLSVersion.TLS13)
        else -> None
    }
}

is_tls13: fn(v: TLSVersion) -> Bool Never! { v == TLSVersion.TLS13 }

is_tls12: fn(v: TLSVersion) -> Bool Never! { v == TLSVersion.TLS12 }

// ---- client configuration ---------------------------------------------------

priv config_with: fn(config: ClientConfig, alpn: [String], trust: TLSClientTrust, identity: ClientIdentity?, min: TLSVersion, max: TLSVersion) -> ClientConfig Never! {
    ClientConfig{host: config.host.copy(), alpn: alpn, trust: trust, identity: identity, min_version: min, max_version: max}
}

priv config_error: fn(operation: String, message: String) -> IOError Never! {
    IOError.InvalidInput(IOContext{operation: .Connect, resource: Val("tls client configuration"), os_code: None, cause: Val("{operation} failed: {message}")})
}

priv version_rank: fn(version: TLSVersion) -> Int Never! {
    if version == TLSVersion.TLS12 -> 12 else -> 13
}

// A connection offers at most 16 protocols.
priv alpn_problem: fn(protocols: [String]) -> String Never! {
    if protocols.len() > 16 -> return "TLS ALPN offers at most 16 protocols"
    loop protocol in protocols {
        length: protocol.bytes().len()
        if length == 0 || length > 255 || __has_nul(protocol) {
            return "TLS ALPN protocols must contain 1 to 255 bytes"
        }
    }
    ""
}

// Constructors are pure carriers. Endpoint, ALPN, identity, and root policy
// is checked at the operation boundary instead of being silently dropped.
config: fn(host: String) -> ClientConfig Never! { ClientConfig{host: host} }

with_alpn: fn(cfg: ClientConfig, proto: String) -> ClientConfig Never! {
    alpn := [String]{}
    loop p in cfg.alpn -> alpn.push(p.copy())
    // Keep the requested value visible. connect_host validates the complete
    // list before crossing into the provider, so invalid input cannot become a
    // successful handshake or disappear as a no-op.
    alpn.push(proto.copy())
    config_with(cfg, alpn, cfg.trust.copy(), cfg.identity.copy(), cfg.min_version, cfg.max_version)
}

alpn_h2: fn(cfg: ClientConfig) -> ClientConfig Never! {
    with_alpn(with_alpn(cfg, "h2"), "http/1.1")
}

identity: fn(cert: String, key: String) -> ClientIdentity Never! {
    ClientIdentity{cert: cert, key: key}
}

roots: fn(path: String) -> RootCertificates Never! { RootCertificates{path: path} }

// The legacy host carrier connects with its ALPN list and default trust.
connect_host: fn(cfg: ClientConfig, port: Int) -[Net, Time.Wait]> TLSStream IOError! {
    if !valid_host(cfg.host) {
        return Err(tls_error("connect_host", cfg.host, "host is empty or contains invalid endpoint syntax"))
    }
    if port <= 0 || port > 65535 {
        return Err(tls_error("connect_host", cfg.host, "port must be in 1..=65535"))
    }
    if !valid_alpn_list(cfg.alpn) {
        return Err(tls_error("connect_host", cfg.host, "ALPN protocol must contain 1..255 non-control bytes"))
    }
    tcp := if net.tcp_connect(format_host_port(cfg.host, port)) == {
        .Ok(stream) -> stream
        .Err(_) -> {
            return Err(tls_error("connect_host", cfg.host, "transport connect failed"))
        }
    }
    tls := client_connect(tcp, cfg.host, cfg, forever()) ?? return Err(net_to_io(err))
    Ok(tls)
}

flags: fn(cfg: ClientConfig) -> [String] Never! { cfg.alpn }

has_alpn: fn(cfg: ClientConfig, proto: String) -> Bool Never! {
    loop p in cfg.alpn {
        if p == proto -> return true
    }
    false
}

tls_error: fn(operation: String, address: String, message: String) -> IOError Never! {
    is_unsupported := operation == "peer_port" || operation == "unwrap"
    if operation == "read" || operation == "read_text" {
        context := IOContext{operation: .Read, resource: Val(address.copy()), os_code: None, cause: Val(message.copy())}
        if is_unsupported -> return IOError.Other(context)
        return IOError.InvalidInput(context)
    }
    if operation == "write" || operation == "write_all" || operation == "write_text" {
        context := IOContext{operation: .Write, resource: Val(address.copy()), os_code: None, cause: Val(message.copy())}
        if is_unsupported -> return IOError.Other(context)
        return IOError.InvalidInput(context)
    }
    if operation == "close" {
        context := IOContext{operation: .Close, resource: Val(address.copy()), os_code: None, cause: Val(message.copy())}
        if is_unsupported -> return IOError.Other(context)
        return IOError.InvalidInput(context)
    }
    if operation == "client" || operation == "connect_host" {
        context := IOContext{operation: .Connect, resource: Val(address.copy()), os_code: None, cause: Val(message.copy())}
        if is_unsupported -> return IOError.Other(context)
        return IOError.InvalidInput(context)
    }
    context := IOContext{operation: .Resolve, resource: Val(address.copy()), os_code: None, cause: Val(message.copy())}
    if is_unsupported -> return IOError.Other(context)
    IOError.InvalidInput(context)
}

valid_host: fn(host: String) -> Bool Never! {
    raw: host.bytes()
    if raw.len() == 0 || raw.len() > 253 -> return false
    if raw[0] == (U8{91}) && (raw.len() < 3 || raw[raw.len() - 1] != (U8{93})) -> return false
    colons := 0
    i := 0
    loop i < raw.len() {
        n: Int{raw[i]}
        if n <= 32 || n == 127 || n == 47 || n == 63 || n == 35 || n == 64 -> return false
        if n == 58 -> colons += 1
        if n == 91 && i != 0 -> return false
        if n == 93 && (i == 0 || raw[0] != (U8{91}) || i != raw.len() - 1) -> return false
        i += 1
    }
    if colons == 1 -> return false
    if colons == 0 -> return valid_dns_name(raw)
    true
}

valid_dns_name: fn(raw: [U8]) -> Bool Never! {
    label_start := 0
    loop i in 0..<raw.len() {
        n: Int{raw[i]}
        if {
            n == 46 -> {
                label_len := i - label_start
                if label_len == 0 -> return i == raw.len() - 1 && i > 0 && raw[i - 1] != (U8{46})
                if raw[label_start] == (U8{45}) || raw[i - 1] == (U8{45}) -> return false
                label_start = i + 1
            }
            else -> {
                if !((n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 45 || n >= 128) {
                    return false
                }
                if i - label_start >= 63 -> return false
            }
        }
    }
    label_len := raw.len() - label_start
    if label_len == 0 {
        if raw.len() < 2 -> return false
        return raw[raw.len() - 2] != (U8{46})
    }
    if raw[label_start] == (U8{45}) || raw[raw.len() - 1] == (U8{45}) -> return false
    true
}

format_host_port: fn(host: String, port: Int) -> String Never! {
    raw: host.bytes()
    if raw.len() > 0 && raw[0] == (U8{91}) -> return "{host}:{port}"
    if contains_byte(host, 58) -> return "[{host}]:{port}"
    "{host}:{port}"
}

contains_byte: fn(text: String, needle: Int) -> Bool Never! {
    loop b in text.bytes() {
        if (Int{b}) == needle -> return true
    }
    false
}

valid_alpn_list: fn(protocols: [String]) -> Bool Never! {
    loop protocol in protocols {
        raw: protocol.bytes()
        if raw.len() == 0 || raw.len() > 255 -> return false
        loop b in raw {
            n: Int{b}
            if n <= 32 || n == 127 -> return false
        }
    }
    true
}

trim_ascii: fn(text: String) -> String Never! {
    raw: text.bytes()
    start := 0
    end := raw.len()
    loop start < end {
        n: Int{raw[start]}
        if n == 32 || n == 9 || n == 13 || n == 10 -> start += 1 else -> break
    }
    loop end > start {
        n: Int{raw[end - 1]}
        if n == 32 || n == 9 || n == 13 || n == 10 -> end -= 1 else -> break
    }
    if end <= start -> return ""
    result: String.from_bytes(raw[start..(end - 1)]) ?? ""
    return result
}

ascii_lower: fn(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n: Int{b}
        if n >= 65 && n <= 90 -> out.push(U8{n + 32}) else -> out.push(b)
    }
    decoded: String.from_bytes(out) ?? return text.copy()
    return decoded
}

// ---- contexts, trust and identity -------------------------------------------

// A fresh configuration for `endpoint` (SSL_IS_CLIENT or SSL_IS_SERVER)
// whose generator is seeded from the system entropy source.
priv context_new: fn(endpoint: Int) -> TLSContext TLSFailure! {
    seed := core.net.tls.__host_entropy(C_SEED_BYTES) ?? return Err(fail("TLS could not create a context: the system entropy source failed"))
    if seed.len() != C_SEED_BYTES {
        crypto.wipe(seed)
        return Err(fail("TLS could not create a context: the system entropy source failed"))
    }
    context_seeded(endpoint, seed)
}

// A fresh configuration whose HMAC_DRBG-SHA-256 generator is seeded from
// `seed` and the personalization string "jet_tls"
// (mbedtls_hmac_drbg_seed_buf over entropy || nonce || custom). `seed` is
// wiped, and the material is built at its final size, so no growth leaves a
// copy behind.
priv context_seeded: fn(endpoint: Int, seed: &[U8]) -> TLSContext TLSFailure! {
    custom: "jet_tls".bytes()
    material := [U8]{}
    cipher.reserve(material, seed.len() + custom.len())
    loop b in seed -> material.push(b)
    crypto.wipe(seed)
    loop b in custom -> material.push(b)
    rng := drbg.hmac_drbg_new(hashes.Md.SHA256)
    drbg.hmac_drbg_seed_buf(rng, material)
    crypto.wipe(material)
    conf := ssldefs.SSLConfig{}
    if ssltls.ssl_config_defaults(conf, endpoint, ssldefs.SSL_TRANSPORT_STREAM, ssldefs.SSL_PRESET_DEFAULT) == .Err(e) {
        return Err(fail("TLS could not create a context: {ssl_text(e)}"))
    }
    conf.ciphersuite_list = policy_suites()
    conf.group_list = policy_groups()
    conf.sig_algs = policy_sig_algs()
    Ok(TLSContext{conf: conf, ca: [x509crt.X509Crt]{}, rng: rng})
}

// Core's TLS policy: the engine's default preset narrowed to these suites,
// groups and signature algorithms; the engine's other suites stay off. A
// peer that offers none of them fails the handshake.
//
// The suites, in the engine's preference order: TLS 1.3 with ChaCha20-Poly1305
// or AES-GCM, and TLS 1.2 ECDHE with an ECDSA or RSA certificate and the
// same AEADs.
priv policy_suites: fn() -> [Int] Never! {
    [Int]{
        suites.TLS1_3_CHACHA20_POLY1305_SHA256,
        suites.TLS1_3_AES_256_GCM_SHA384,
        suites.TLS1_3_AES_128_GCM_SHA256,
        suites.TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256,
        suites.TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256,
        suites.TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,
        suites.TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,
        suites.TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,
        suites.TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,
    }
}

// The key exchange groups, cheapest first: x25519, P-256 and P-384.
priv policy_groups: fn() -> [Int] Never! {
    [Int]{ssldefs.SSL_IANA_TLS_GROUP_X25519, ssldefs.SSL_IANA_TLS_GROUP_SECP256R1, ssldefs.SSL_IANA_TLS_GROUP_SECP384R1}
}

// The handshake signature algorithms: ECDSA on P-256 and P-384 with SHA-256
// and SHA-384, then RSA-PSS and RSA PKCS#1 v1.5 with SHA-512, SHA-384 and
// SHA-256. Each code point means the same in TLS 1.2 (hash, signature)
// and TLS 1.3.
priv policy_sig_algs: fn() -> [Int] Never! {
    [Int]{
        ssldefs.TLS1_3_SIG_ECDSA_SECP256R1_SHA256,
        ssldefs.TLS1_3_SIG_ECDSA_SECP384R1_SHA384,
        ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA512,
        ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA384,
        ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA256,
        ssldefs.TLS1_3_SIG_RSA_PKCS1_SHA512,
        ssldefs.TLS1_3_SIG_RSA_PKCS1_SHA384,
        ssldefs.TLS1_3_SIG_RSA_PKCS1_SHA256,
    }
}

// Binds a finished configuration to a connected socket. An empty hostname
// sets no SNI or verification name (servers).
priv open: fn(context: &&TLSContext, tcp: &&TCPStream, hostname: String) -> TLSState ssldefs.SSLError! {
    ctx := context.move()
    conf := ctx.conf.move()
    if ctx.ca.len() > 0 -> conf.ca_chain = Val(ctx.ca.move())
    ssl := ssldefs.SSLContext{}
    _: ssltls.ssl_setup(ssl, conf) ?? return Err(err)
    if hostname != "" -> _: ssltls.ssl_set_hostname(ssl, Val(hostname.copy())) ?? return Err(err)
    Ok(TLSState{ssl: ssl, rng: ctx.rng.move(), tcp: tcp.move(), buffer: ssldefs.ssl_zeros(C_RECORD_BYTES), peer: None, pending: [U8]{}, read_eof: false, write_closed: false, closed: false})
}

priv client_tls_context: fn(server_name: String, config: ClientConfig) -> TLSContext TLSFailure! {
    if !valid_server_name(server_name) {
        return Err(fail("invalid TLS server name `{server_name}`"))
    }
    context := context_new(ssldefs.SSL_IS_CLIENT) ?? return Err(err)
    _: load_trust(context, config.trust) ?? return Err(err)
    if config.identity == .Val(identity) {
        if __has_nul(identity.cert) || __has_nul(identity.key) {
            return Err(fail("TLS client identity is invalid: PEM text contains a NUL byte"))
        }
        status: own_identity(context, identity.cert, identity.key)
        if status != 0 -> return Err(fail(identity_message(status)))
    }
    if version_rank(config.min_version) > version_rank(config.max_version) {
        return Err(fail("TLS version bounds must be between TLS12 and TLS13 with min <= max"))
    }
    context.conf.min_tls_version = config.min_version.to_int()
    context.conf.max_tls_version = config.max_version.to_int()
    _: add_alpn(context, config.alpn) ?? return Err(err)
    // The chain and the server name must verify.
    context.conf.authmode = ssldefs.SSL_VERIFY_REQUIRED
    Ok(context)
}

// The local certificate chain and private key, both PEM (server identity or
// client certificate): 0, or the status of the step that failed, as
// mbedtls_x509_crt_parse, mbedtls_pk_parse_key and mbedtls_pk_check_pair
// return it. The key must be the leaf certificate's key.
priv own_identity: fn(context: &TLSContext, cert: String, key: String) -> Int Never! {
    chain := [x509crt.X509Crt]{}
    if x509crt.x509_crt_parse(chain, cert.bytes()) == {
        .Ok(skipped) -> {
            if skipped != 0 -> return skipped
        }
        .Err(e) -> { return ssldefs.x509_code(e) }
    }
    private := if pkparse.pk_parse_key(key.bytes(), None, context.rng) == {
        .Ok(parsed) -> parsed
        .Err(e) -> {
            return ssldefs.pk_code(e)
        }
    }
    if pk.pk_check_pair(chain[0].pk, private, context.rng) == .Err(e) -> return ssldefs.pk_code(e)
    ssltls.ssl_conf_own_cert(context.conf, Val(ssldefs.SSLKeyCert{cert: chain, key: private}))
    0
}

priv add_alpn: fn(context: &TLSContext, protocols: [String]) TLSFailure! {
    message: alpn_problem(protocols)
    if message != "" -> return Err(fail(message))
    offered := [String]{}
    loop protocol in protocols {
        offered.push(protocol.copy())
        if ssltls.ssl_conf_alpn_protocols(context.conf, offered) == .Err(e) {
            return Err(fail("TLS could not offer ALPN protocol `{protocol}`: {ssl_text(e)}"))
        }
    }
    Ok()
}

priv load_trust: fn(context: &TLSContext, trust: TLSClientTrust) TLSFailure! {
    if trust == {
        .System -> { _: load_system_roots(context, true) ?? return Err(err) }
        .SystemPlus(roots) -> {
            _: load_system_roots(context, false) ?? return Err(err)
            _: load_custom_roots(context, roots) ?? return Err(err)
        }
        .CustomOnly(roots) -> { _: load_custom_roots(context, roots) ?? return Err(err) }
    }
    Ok()
}

priv load_custom_roots: fn(context: &TLSContext, roots: RootCertificates) TLSFailure! {
    before: context.ca.len()
    if {
        roots.pem != "" -> {
            if __has_nul(roots.pem) {
                return Err(fail("TLS custom CA PEM must contain only certificate blocks"))
            }
            status: ca_parse(context.ca, roots.pem.bytes())
            if status != 0 {
                return Err(fail("TLS could not use a custom certificate root: {ca_status_text(status)}"))
            }
        }
        roots.path != "" -> {
            if __has_nul(roots.path) {
                return Err(fail("TLS could not load custom certificate roots from `{roots.path}`: the path contains a NUL byte"))
            }
            status: ca_file(context.ca, roots.path)
            if status != 0 {
                return Err(fail("TLS could not load custom certificate roots from `{roots.path}`: {ca_status_text(status)}"))
            }
        }
    }
    if context.ca.len() == before {
        return Err(fail("TLS custom CA PEM did not contain a certificate"))
    }
    Ok()
}

priv ca_status_text: fn(status: Int) -> String Never! {
    if status > 0 -> return "{status} certificate(s) could not be parsed"
    mbedtls_text(status)
}

// Appends the roots of one PEM or DER buffer to `ca` (mbedtls_x509_crt_parse):
// the number of PEM certificates skipped, or the status of the failure.
priv ca_parse: fn(ca: &[x509crt.X509Crt], bytes: [U8]) -> Int Never! {
    if x509crt.x509_crt_parse(ca, bytes) == {
        .Ok(skipped) -> skipped
        .Err(e) -> ssldefs.x509_code(e)
    }
}

// Appends the roots of one bundle file (mbedtls_x509_crt_parse_file).
priv ca_file: fn(ca: &[x509crt.X509Crt], path: String) -> Int Never! {
    bytes: core.net.tls.__host_read_bytes(path) ?? return C_PK_FILE_IO_ERROR
    ca_parse(ca, bytes)
}

// Appends the roots of every file in one directory
// (mbedtls_x509_crt_parse_path): each file that fails counts one, and each
// other file adds its skipped certificates.
priv ca_dir: fn(ca: &[x509crt.X509Crt], path: String) -> Int Never! {
    handle: core.net.tls.__host_open_directory(-1, path) ?? return C_X509_FILE_IO_ERROR
    rows: core.net.tls.__host_list_directory(handle) ?? {
        core.net.tls.__host_close_directory(handle)
        return C_X509_FILE_IO_ERROR
    }
    core.net.tls.__host_close_directory(handle)
    count := 0
    loop row in rows {
        // The first byte is 1 for a directory; the name follows.
        if row.len() < 2 || row[0] == (U8{1}) -> next
        name: String.from_bytes(byte_range(row, 1, row.len())) ?? {
            count += 1
            next
        }
        status: ca_file(ca, "{path}/{name}")
        if status < 0 -> count += 1 else -> count += status
    }
    count
}

// System roots follow the OpenSSL convention rustls-native-certs used:
// SSL_CERT_FILE / SSL_CERT_DIR when either is set, otherwise the first
// distribution bundle that loads, then the hashed /etc/ssl/certs directory.
// The variables are read as process facts of the trust store, not as program
// configuration, so they add no Env effect to the handshake.
priv load_system_roots: fn(context: &TLSContext, required: Bool) TLSFailure! {
    file: env_text("SSL_CERT_FILE")
    dirs: env_text("SSL_CERT_DIR")
    if {
        file != "" || dirs != "" -> {
            if file != "" && !__has_nul(file) -> _: ca_file(context.ca, file)
            loop dir in split_colon(dirs) {
                if dir != "" && !__has_nul(dir) -> _: ca_dir(context.ca, dir)
            }
        }
        else -> {
            loop path in system_root_files() {
                if context.ca.len() > 0 -> break
                _: ca_file(context.ca, path)
            }
            if context.ca.len() == 0 -> _: ca_dir(context.ca, "/etc/ssl/certs")
        }
    }
    if required && context.ca.len() == 0 {
        return Err(fail("TLS could not find system certificate roots"))
    }
    Ok()
}

// The environment variable's value, "" when it is unset or not UTF-8.
priv env_text: fn(name: String) -> String Never! {
    bytes: core.net.tls.__host_env_value(name) ?? return ""
    String.from_bytes(bytes) ?? ""
}

priv system_root_files: fn() -> [String] Never! {
    [String]{
        "/etc/ssl/certs/ca-certificates.crt",
        "/etc/pki/tls/certs/ca-bundle.crt",
        "/etc/ssl/ca-bundle.pem",
        "/etc/pki/tls/cacert.pem",
        "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
        "/etc/ssl/cert.pem",
    }
}

priv split_colon: fn(text: String) -> [String] Never! {
    parts := [String]{}
    raw: text.bytes()
    start := 0
    loop at in 0..<raw.len() {
        if raw[at] == (U8{58}) {
            parts.push(String.from_bytes(byte_range(raw, start, at)) ?? "")
            start = at + 1
        }
    }
    parts.push(String.from_bytes(byte_range(raw, start, raw.len())) ?? "")
    parts
}

priv roots_validate: fn(pem: [U8]) -> String TLSFailure! {
    text: String.from_bytes(pem) ?? return Err(fail("TLS custom CA PEM must be UTF-8 text"))
    _: pem_certificates(text.bytes()) ?? return Err(err)
    if __has_nul(text) -> return Err(fail("TLS custom CA PEM must contain only certificate blocks"))
    ca := [x509crt.X509Crt]{}
    status: ca_parse(ca, text.bytes())
    if status != 0 {
        return Err(fail("TLS could not use a custom certificate root: {ca_status_text(status)}"))
    }
    Ok(text)
}

// The check runs without a connection, so its generator is seeded from the
// identity itself: the blinding of the key operations is unpredictable to
// anyone without the key, and validating needs no entropy source. The
// handshake checks the pair again under a generator from system entropy.
priv identity_validate: fn(cert_chain: [U8], private_key: [U8]) -> ClientIdentity TLSFailure! {
    cert: String.from_bytes(cert_chain) ?? return Err(fail("TLS custom CA PEM must be UTF-8 text"))
    _: pem_certificates(cert.bytes()) ?? return Err(err)
    key: String.from_bytes(private_key) ?? return Err(fail("TLS private key PEM must be UTF-8 text"))
    _: private_key_check(key.bytes()) ?? return Err(err)
    if __has_nul(cert) || __has_nul(key) {
        return Err(fail("TLS client identity is invalid: PEM text contains a NUL byte"))
    }
    seed := [U8]{}
    cipher.reserve(seed, private_key.len() + cert_chain.len())
    loop b in private_key -> seed.push(b)
    loop b in cert_chain -> seed.push(b)
    context := context_seeded(ssldefs.SSL_IS_CLIENT, seed) ?? return Err(err)
    status: own_identity(context, cert, key)
    if status != 0 -> return Err(fail(identity_message(status)))
    Ok(ClientIdentity{cert: cert, key: key})
}

// mbedtls_pk_check_pair reports a mismatched key through the PK, RSA or ECP
// layer depending on the key type.
priv identity_message: fn(status: Int) -> String Never! {
    high: mbedtls_high(status)
    if high == 16128 || high == 16000 || high == 16896 || high == 20352 || status == -16128 || status == -16000 {
        return "TLS client certificate does not match the private key"
    }
    "TLS client identity is invalid: {mbedtls_text(status)}"
}

// ---- PEM ----------------------------------------------------------------------

// The number of CERTIFICATE blocks; nothing but whitespace may surround them.
priv pem_certificates: fn(raw: [U8]) -> Int TLSFailure! {
    begin: "-----BEGIN CERTIFICATE-----".bytes()
    end: "-----END CERTIFICATE-----".bytes()
    count := 0
    at := 0
    loop {
        start: find(raw, begin, at)
        if start < 0 -> break
        if !blank(raw, at, start) {
            return Err(fail("TLS custom CA PEM contains data outside certificate blocks"))
        }
        body: start + begin.len()
        stop: find(raw, end, body)
        if stop < 0 -> return Err(fail("TLS custom CA PEM has an unterminated certificate"))
        _: pem_base64(raw, body, stop) ?? return Err(err)
        count += 1
        at = stop + end.len()
    }
    if count == 0 || !blank(raw, at, raw.len()) {
        return Err(fail("TLS custom CA PEM must contain only certificate blocks"))
    }
    Ok(count)
}

priv private_key_check: fn(raw: [U8]) TLSFailure! {
    first := 0
    last := raw.len()
    loop first < last && pem_space(Int{raw[first]}, true) -> first += 1
    loop last > first && pem_space(Int{raw[last - 1]}, true) -> last -= 1
    labels: [String]{"PRIVATE KEY", "RSA PRIVATE KEY", "EC PRIVATE KEY"}
    loop label in labels {
        begin: "-----BEGIN {label}-----".bytes()
        end: "-----END {label}-----".bytes()
        if last - first >= begin.len() + end.len() && find(raw, begin, first) == first && find(raw, end, last - end.len()) == last - end.len() {
            _: pem_base64(raw, first + begin.len(), last - end.len()) ?? return Err(err)
            return Ok()
        }
    }
    Err(fail("TLS private key PEM must contain exactly one PKCS#8, PKCS#1, or SEC1 key"))
}

// Strict base64 for one PEM body; returns the decoded byte count.
priv pem_base64: fn(raw: [U8], start: Int, end: Int) -> Int TLSFailure! {
    decoded := 0
    used := 0
    pads := 0
    padded := false
    at := start
    loop at < end {
        byte: Int{raw[at]}
        at += 1
        if pem_space(byte, false) -> next
        if padded -> return Err(fail("TLS custom CA PEM has data after base64 padding"))
        if {
            byte == 61 -> { pads += 1 }
            else -> {
                if pads != 0 -> return Err(fail("TLS custom CA PEM has invalid base64 padding"))
                if !((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 43 || byte == 47) {
                    return Err(fail("TLS custom CA PEM contains invalid base64"))
                }
            }
        }
        used += 1
        if used == 4 {
            if pads > 2 -> return Err(fail("TLS custom CA PEM has invalid base64 padding"))
            decoded += 3 - pads
            padded = pads != 0
            used = 0
            pads = 0
        }
    }
    if used != 0 || decoded == 0 -> return Err(fail("TLS custom CA PEM contains incomplete base64"))
    Ok(decoded)
}

// ASCII whitespace; `trim` adds the vertical tab str::trim also strips.
priv pem_space: fn(byte: Int, trim: Bool) -> Bool Never! {
    byte == 32 || byte == 9 || byte == 10 || byte == 12 || byte == 13 || (trim && byte == 11)
}

priv blank: fn(raw: [U8], start: Int, end: Int) -> Bool Never! {
    loop at in start..<end {
        if !pem_space(Int{raw[at]}, true) -> return false
    }
    true
}

priv find: fn(raw: [U8], needle: [U8], from: Int) -> Int Never! {
    at := from
    loop at + needle.len() <= raw.len() {
        matched := true
        loop k in 0..<needle.len() {
            if raw[at + k] != needle[k] {
                matched = false
                break
            }
        }
        if matched -> return at
        at += 1
    }
    -1
}

priv byte_range: fn(raw: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    loop at in start..<end -> out.push(raw[at])
    out
}

__has_nul: fn(text: String) -> Bool Never! {
    loop byte in text.bytes() {
        if byte == (U8{0}) -> return true
    }
    false
}

priv valid_server_name: fn(name: String) -> Bool Never! {
    raw: name.bytes()
    if raw.len() == 0 || raw.len() > 253 -> return false
    colons := 0
    loop byte in raw {
        n: Int{byte}
        if n == 58 -> colons += 1
    }
    if colons == 0 -> return valid_dns_name(raw)
    if colons < 2 -> return false
    loop byte in raw {
        n: Int{byte}
        if !((n >= 48 && n <= 58) || (n >= 65 && n <= 70) || (n >= 97 && n <= 102) || n == 46) {
            return false
        }
    }
    true
}

// ---- engine and socket --------------------------------------------------------

// The status of an engine error as mbedtls returns it.
priv engine_status: fn(e: ssldefs.SSLError) -> Int Never! { ssldefs.ssl_error_code(e) }

priv ssl_text: fn(e: ssldefs.SSLError) -> String Never! { mbedtls_text(ssldefs.ssl_error_code(e)) }

// An engine status after the records it queued were sent: a socket failure
// replaces a status that would let the caller carry on.
priv settle: fn(status: Int, sent: Int) -> Int Never! {
    if sent != 0 && (status >= 0 || status == C_WANT_READ || status == C_WANT_WRITE) -> return sent
    status
}

// Sends the records the engine queued, then drops them: 0, or the socket
// status that failed the send. Writes are sliced like ready_wait.
priv flush: fn(tls: &TLSState, end_ns: Int, operation: String) -[Net, Time.Wait]> Int NetError! {
    if tls.ssl.bio.tx.len() == 0 -> return Ok(0)
    status: send_queued(tls, end_ns, operation) ?? {
        tls.ssl.bio.tx.clear()
        return Err(err)
    }
    tls.ssl.bio.tx.clear()
    Ok(status)
}

priv send_queued: fn(tls: &TLSState, end_ns: Int, operation: String) -[Net, Time.Wait]> Int NetError! {
    total: tls.ssl.bio.tx.len()
    at := 0
    loop at < total {
        remaining: end_ns - rt.clock_mono_ns()
        if remaining <= 0 -> return Err(deadline_error(operation))
        slice: Duration{ns: if remaining > C_WAIT_SLICE_NS -> C_WAIT_SLICE_NS else -> remaining}
        sent := 0
        if at == 0 {
            sent = tls.tcp.write_some(tls.ssl.bio.tx, deadline: slice) ?? {
                if !timed_out(err) -> return Ok(socket_status(err, C_NET_SEND_FAILED))
                next
            }
        } else {
            sent = tls.tcp.write_some(byte_range(tls.ssl.bio.tx, at, total), deadline: slice) ?? {
                if !timed_out(err) -> return Ok(socket_status(err, C_NET_SEND_FAILED))
                next
            }
        }
        if sent == 0 -> return Ok(C_NET_SEND_FAILED)
        at += sent
    }
    Ok(0)
}

// Queues what a readable socket holds for the engine: 0, or the socket
// status that failed the read. An empty read is the end of the stream.
__take: fn(tls: &TLSState, end_ns: Int) -[Net, Time.Wait]> Int Never! {
    remaining: end_ns - rt.clock_mono_ns()
    if remaining <= 0 -> return 0
    slice: Duration{ns: if remaining > C_WAIT_SLICE_NS -> C_WAIT_SLICE_NS else -> remaining}
    if tls.tcp.read_into(tls.ssl.bio.rx, C_RECORD_BYTES, deadline: slice) == {
        .Ok(count) -> {
            if count == 0 -> tls.ssl.bio.rx_eof = true
            0
        }
        .Err(err) -> {
            if timed_out(err) -> return 0
            socket_status(err, C_NET_RECV_FAILED)
        }
    }
}

priv socket_status: fn(err: NetError, fallback: Int) -> Int Never! {
    if err == {
        .ConnectionReset(_) -> C_NET_CONN_RESET
        .Closed(_) -> C_NET_CONN_RESET
        .InvalidInput(_) | .PermissionDenied(_) | .AddressInUse(_) | .AddressUnavailable(_) | .ConnectionRefused(_) | .NotConnected(_) | .Timeout(_) | .Cancelled(_) | .Unsupported(_) | .TLS(_) | .Protocol(_) | .Other(_) | .DNS(_) -> fallback
    }
}

// Waits out a WANT_READ or WANT_WRITE status: 0 when the engine can be
// called again, or the socket status that ended the wait.
priv await: fn(tls: &TLSState, status: Int, end_ns: Int, operation: String) -[Net, Time.Wait]> Int NetError! {
    ready: ready_wait(tls.tcp, status_interest(status), end_ns, operation) ?? return Err(err)
    if status == C_WANT_READ && ready.readable -> return Ok(__take(tls, end_ns))
    Ok(0)
}

// One engine read of at most `limit` bytes (mbedtls_ssl_read).
priv engine_read: fn(tls: &TLSState, limit: Int, end_ns: Int, operation: String) -[Net, Time.Wait]> Got NetError! {
    status: engine_read_status(tls, limit, end_ns, operation) ?? return Err(err)
    if status > 0 -> return Ok(Got{status: status, bytes: byte_range(tls.buffer, 0, status)})
    Ok(Got{status: status, bytes: [U8]{}})
}

// One engine read of at most `limit` bytes into `tls.buffer`: the count, or
// the settled status when no byte came.
priv engine_read_status: fn(tls: &TLSState, limit: Int, end_ns: Int, operation: String) -[Net, Time.Wait]> Int NetError! {
    size: if limit < C_RECORD_BYTES -> limit else -> C_RECORD_BYTES
    status := 0
    if sslmsg.ssl_read(tls.ssl, tls.buffer, size, tls.rng) == {
        .Ok(count) -> { status = count }
        .Err(e) -> status = engine_status(e)
    }
    sent: flush(tls, end_ns, operation) ?? return Err(err)
    if status > 0 -> return Ok(status)
    Ok(settle(status, sent))
}

// ---- handshake and I/O --------------------------------------------------------

// A failed handshake frees the engine and wipes the buffers before its error
// goes back, as close does.
priv run_handshake: fn(tls: &TLSState, server_name: String, end_ns: Int) -[Net, Time.Wait]> NetError! {
    if handshake_steps(tls, server_name, end_ns) == .Err(error) {
        release(tls)
        return Err(error)
    }
    Ok()
}

priv handshake_steps: fn(tls: &TLSState, server_name: String, end_ns: Int) -[Net, Time.Wait]> NetError! {
    loop {
        status := 0
        if ssltls.ssl_handshake(tls.ssl, tls.rng) == .Err(e) -> status = engine_status(e)
        sent: flush(tls, end_ns, "tls handshake") ?? return Err(err)
        status = settle(status, sent)
        if status == 0 -> return Ok()
        if status == C_NEW_SESSION_TICKET -> next
        if status == C_WANT_READ || status == C_WANT_WRITE {
            status = await(tls, status, end_ns, "tls handshake") ?? return Err(err)
            if status == 0 -> next
        }
        return Err(net_error("tls handshake", handshake_message(tls.ssl, server_name, status)))
    }
}

priv handshake_message: fn(ssl: ssldefs.SSLContext, server_name: String, status: Int) -> String Never! {
    prefix: if server_name == "" -> "TLS handshake failed" else -> "TLS handshake with `{server_name}` failed"
    flags: ssltls.ssl_get_verify_result(ssl)
    if flags != 0 && flags != 4294967295 {
        return "{prefix}: invalid peer certificate: {verify_reason(flags)}"
    }
    if status == -0x7780 && ssl.in_msgtype == ssldefs.SSL_MSG_ALERT && ssl.in_msg + 1 < ssl.in_buf.len() {
        alert: ssldefs.ssl_u8(ssl.in_buf, ssl.in_msg + 1)
        if alert == ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE || alert == ssldefs.SSL_ALERT_MSG_INSUFFICIENT_SECURITY {
            return "{prefix}: the peer refused every cipher suite, group and signature algorithm Core's TLS offers (TLS 1.3, or TLS 1.2 ECDHE, with AES-GCM or ChaCha20-Poly1305 over x25519, P-256 or P-384)"
        }
        if alert == ssldefs.SSL_ALERT_MSG_PROTOCOL_VERSION {
            return "{prefix}: the peer refused the TLS versions this connection offers"
        }
    }
    "{prefix}: {mbedtls_text(status)}"
}

// MBEDTLS_X509_BADCERT_* flags in the order a path-building verifier reports
// them, spelled like rustls' CertificateError.
priv verify_reason: fn(flags: Int) -> String Never! {
    if flags & 8 != 0 -> return "UnknownIssuer"
    if flags & 1 != 0 -> return "Expired"
    if flags & 512 != 0 -> return "NotValidYet"
    if flags & 2 != 0 -> return "Revoked"
    if flags & 4 != 0 -> return "NotValidForName"
    "Other"
}

priv status_interest: fn(status: Int) -> NetReadyInterest Never! {
    if status == C_WANT_WRITE -> return NetReadyInterest.Write
    NetReadyInterest.Read
}

priv wants_write_only: fn(interest: NetReadyInterest) -> Bool Never! {
    if interest == {
        .Write -> true
        .Read | .ReadWrite -> false
    }
}

priv wants_write: fn(interest: NetReadyInterest) -> Bool Never! {
    if interest == {
        .Read -> false
        .Write | .ReadWrite -> true
    }
}

__read: fn(tls: &TLSState, max_bytes: Int, end_ns: Int) -[Net, Time.Wait]> [U8] IOError! {
    if tls.closed -> return Err(io_error(.Read, "TLS stream is closed"))
    if tls.pending.len() > 0 {
        count: if max_bytes < tls.pending.len() -> max_bytes else -> tls.pending.len()
        head: byte_range(tls.pending, 0, count)
        tls.pending = byte_range(tls.pending, count, tls.pending.len())
        return Ok(head)
    }
    if tls.read_eof -> return Ok([U8]{})
    loop {
        got: engine_read(tls, max_bytes, end_ns, "tls read") ?? return Err(net_to_io(err))
        status := got.status
        if status > 0 -> return Ok(got.bytes)
        if status == C_PEER_CLOSE_NOTIFY {
            tls.read_eof = true
            return Ok([U8]{})
        }
        // mbedtls_ssl_read reports a transport EOF without close_notify as 0.
        if status == 0 -> return Err(io_error(.Read, C_TRUNCATION))
        if status == C_NEW_SESSION_TICKET -> next
        if status == C_WANT_READ || status == C_WANT_WRITE {
            status = await(tls, status, end_ns, "tls read") ?? return Err(net_to_io(err))
            if status == 0 -> next
        }
        return Err(io_error(.Read, "TLS read failed: {mbedtls_text(status)}"))
    }
}

// read_into under the stream's lock: __read's steps, the bytes appended to
// `buffer` rather than returned.
priv read_into_locked: fn(tls: &TLSState, buffer: &[U8], limit: Int, end_ns: Int) -[Net, Time.Wait]> Int IOError! {
    if tls.closed -> return Err(io_error(.Read, "TLS stream is closed"))
    if tls.pending.len() > 0 {
        count: if limit < tls.pending.len() -> limit else -> tls.pending.len()
        loop index in 0..<count -> buffer.push(tls.pending[index])
        tls.pending = byte_range(tls.pending, count, tls.pending.len())
        return Ok(count)
    }
    if tls.read_eof -> return Ok(0)
    loop {
        status := engine_read_status(tls, limit, end_ns, "tls read") ?? return Err(net_to_io(err))
        if status > 0 {
            loop index in 0..<status -> buffer.push(tls.buffer[index])
            return Ok(status)
        }
        if status == C_PEER_CLOSE_NOTIFY {
            tls.read_eof = true
            return Ok(0)
        }
        // mbedtls_ssl_read reports a transport EOF without close_notify as 0.
        if status == 0 -> return Err(io_error(.Read, C_TRUNCATION))
        if status == C_NEW_SESSION_TICKET -> next
        if status == C_WANT_READ || status == C_WANT_WRITE {
            status = await(tls, status, end_ns, "tls read") ?? return Err(net_to_io(err))
            if status == 0 -> next
        }
        return Err(io_error(.Read, "TLS read failed: {mbedtls_text(status)}"))
    }
}

// read_into for a reader that bounds each wait itself: every socket read and
// write it makes waits at most `wait`, and it never reads the clock. A wait
// that runs out is NetError.Timeout, as IOError.TimedOut. The HTTP client
// reads a response body this way, one read timeout per read.
priv read_into_each: fn(stream: TLSStream, buffer: &[U8], limit: Int, wait: Duration) -[Net]> Int IOError! {
    if limit <= 0 {
        return Err(IOError.InvalidInput(io_context(.Read, "tls read_into limit must be positive")))
    }
    if wait.ns < 0 {
        return Err(net_to_io(NetError.InvalidInput(tls_error_detail("tls read", "network timeout must be non-negative"))))
    }
    state: __state(stream) ?? return Err(io_error(.Read, "TLS stream is closed"))
    guard := state.guard_edit()
    read_into_waiting(guard.value, buffer, limit, wait)
}

// read_into_each under the stream's lock.
priv read_into_waiting: fn(tls: &TLSState, buffer: &[U8], limit: Int, wait: Duration) -[Net]> Int IOError! {
    if tls.closed -> return Err(io_error(.Read, "TLS stream is closed"))
    if tls.pending.len() > 0 {
        count: if limit < tls.pending.len() -> limit else -> tls.pending.len()
        loop index in 0..<count -> buffer.push(tls.pending[index])
        tls.pending = byte_range(tls.pending, count, tls.pending.len())
        return Ok(count)
    }
    if tls.read_eof -> return Ok(0)
    loop {
        size: if limit < C_RECORD_BYTES -> limit else -> C_RECORD_BYTES
        status := 0
        if sslmsg.ssl_read(tls.ssl, tls.buffer, size, tls.rng) == {
            .Ok(count) -> { status = count }
            .Err(e) -> status = engine_status(e)
        }
        sent: flush_each(tls, wait) ?? return Err(net_to_io(err))
        if status > 0 {
            loop index in 0..<status -> buffer.push(tls.buffer[index])
            return Ok(status)
        }
        status = settle(status, sent)
        if status == C_PEER_CLOSE_NOTIFY {
            tls.read_eof = true
            return Ok(0)
        }
        // mbedtls_ssl_read reports a transport EOF without close_notify as 0.
        if status == 0 -> return Err(io_error(.Read, C_TRUNCATION))
        if status == C_NEW_SESSION_TICKET -> next
        if status == C_WANT_READ || status == C_WANT_WRITE {
            status = await_each(tls, status, wait) ?? return Err(net_to_io(err))
            if status == 0 -> next
        }
        return Err(io_error(.Read, "TLS read failed: {mbedtls_text(status)}"))
    }
}

// flush with each socket write bounded by `wait`: 0, or the socket status
// that failed the send.
priv flush_each: fn(tls: &TLSState, wait: Duration) -[Net]> Int NetError! {
    total: tls.ssl.bio.tx.len()
    at := 0
    loop at < total {
        sent: tls.tcp.write_some(byte_range(tls.ssl.bio.tx, at, total), deadline: wait) ?? {
            tls.ssl.bio.tx.clear()
            if timed_out(err) -> return Err(deadline_error("tls read"))
            if stopped(err) -> return Err(err)
            return Ok(socket_status(err, C_NET_SEND_FAILED))
        }
        if sent == 0 {
            tls.ssl.bio.tx.clear()
            return Ok(C_NET_SEND_FAILED)
        }
        at += sent
    }
    tls.ssl.bio.tx.clear()
    Ok(0)
}

// await with one socket wait bounded by `wait`: 0 when the engine can be
// called again, or the socket status that ended the wait.
priv await_each: fn(tls: &TLSState, status: Int, wait: Duration) -[Net]> Int NetError! {
    if status == C_WANT_WRITE {
        if tls.tcp.ready(NetReadyInterest.Write, deadline: wait) == .Err(err) {
            if timed_out(err) -> return Err(deadline_error("tls read"))
            if stopped(err) -> return Err(err)
            return Ok(socket_status(err, C_NET_SEND_FAILED))
        }
        return Ok(0)
    }
    if tls.tcp.read_into(tls.ssl.bio.rx, C_RECORD_BYTES, deadline: wait) == {
        .Ok(count) -> {
            if count == 0 -> tls.ssl.bio.rx_eof = true
            Ok(0)
        }
        .Err(err) -> {
            if timed_out(err) -> return Err(deadline_error("tls read"))
            if stopped(err) -> return Err(err)
            Ok(socket_status(err, C_NET_RECV_FAILED))
        }
    }
}

priv stopped: fn(err: NetError) -> Bool Never! {
    if err == {
        .Cancelled(_) -> true
        .InvalidInput(_) | .PermissionDenied(_) | .AddressInUse(_) | .AddressUnavailable(_) | .ConnectionRefused(_) | .ConnectionReset(_) | .NotConnected(_) | .Closed(_) | .Timeout(_) | .Unsupported(_) | .TLS(_) | .Protocol(_) | .Other(_) | .DNS(_) -> false
    }
}

// read_text under the stream's lock: the bytes it takes past the text it
// returns go back in front of `pending`.
__read_text: fn(tls: &TLSState, max_bytes: Int, end_ns: Int) -[Net, Time.Wait]> String IOError! {
    bytes := [U8]{}
    loop {
        want: if bytes.len() < max_bytes -> max_bytes - bytes.len() else -> 1
        more: __read(tls, want, end_ns) ?? {
            unread(tls, bytes)
            return Err(err)
        }
        if more.len() == 0 {
            if bytes.len() == 0 -> return Ok("")
            unread(tls, bytes)
            return Err(tls_error("read_text", "", "the stream ended inside a UTF-8 character"))
        }
        loop b in more -> bytes.push(b)
        valid: utf8_valid(bytes)
        if valid > 0 || valid == bytes.len() {
            unread(tls, byte_range(bytes, valid, bytes.len()))
            return Ok(String.from_bytes(byte_range(bytes, 0, valid)) ?? "")
        }
        if !utf8_cut(bytes) {
            unread(tls, bytes)
            return Err(tls_error("read_text", "", "read bytes are not UTF-8"))
        }
        // Only the start of one character so far: read on for the rest.
    }
}

priv unread: fn(tls: &TLSState, bytes: [U8]) Never! {
    if bytes.len() == 0 {
        return
    }
    out := bytes.copy()
    loop b in tls.pending -> out.push(b)
    tls.pending = out
}

// The length of the longest prefix of `bytes` that is UTF-8.
priv utf8_valid: fn(bytes: [U8]) -> Int Never! {
    at := 0
    loop at < bytes.len() {
        width: utf8_width(bytes, at)
        if width <= 0 -> return at
        at += width
    }
    at
}

// Whether `bytes` are the start of one UTF-8 character that more bytes may
// complete.
priv utf8_cut: fn(bytes: [U8]) -> Bool Never! { bytes.len() > 0 && utf8_width(bytes, 0) == -1 }

// The width of the UTF-8 character at `at`: 0 when the bytes there are not
// UTF-8, -1 when they are the start of a character the bytes end inside.
priv utf8_width: fn(bytes: [U8], at: Int) -> Int Never! {
    lead: Int{bytes[at]}
    if lead < 128 -> return 1
    width := 0
    low := 128
    high := 191
    if lead >= 194 && lead <= 223 -> width = 2
    if lead >= 224 && lead <= 239 {
        width = 3
        if lead == 224 -> low = 160
        if lead == 237 -> high = 159
    }
    if lead >= 240 && lead <= 244 {
        width = 4
        if lead == 240 -> low = 144
        if lead == 244 -> high = 143
    }
    if width == 0 -> return 0
    loop part in 1..<width {
        if at + part >= bytes.len() -> return -1
        byte: Int{bytes[at + part]}
        valid: if part == 1 -> byte >= low && byte <= high else -> byte >= 128 && byte <= 191
        if !valid -> return 0
    }
    width
}

#Test("TLS text reads split UTF-8 at the last whole character") {
    assert_eq(utf8_valid([U8]{104, 195}), 1)
    assert(utf8_cut([U8]{195}))
    assert(utf8_cut([U8]{240, 159, 152}))
    assert_eq(utf8_valid([U8]{97, 255, 98}), 1)
    assert(!utf8_cut([U8]{255, 98}))
    assert(!utf8_cut([U8]{226, 130, 65}))
    assert_eq(utf8_valid([U8]{226, 130, 172, 33}), 4)
}

#Test("Seeding a TLS context wipes the seed it was given, after the generator took it") {
    seed := [U8]{}
    loop i in 0..<C_SEED_BYTES -> seed.push(U8{i + 1})
    first := context_seeded(ssldefs.SSL_IS_CLIENT, seed) ?? panic("context: {err}")
    assert_eq(seed.len(), C_SEED_BYTES)
    assert(test_zero(seed))
    // The same seed again gives the same stream; the zeroed one another.
    again := [U8]{}
    loop i in 0..<C_SEED_BYTES -> again.push(U8{i + 1})
    second := context_seeded(ssldefs.SSL_IS_CLIENT, again) ?? panic("context: {err}")
    zeroed := context_seeded(ssldefs.SSL_IS_CLIENT, seed) ?? panic("context: {err}")
    none := drbg.NoEntropy{}
    drawn: drbg.hmac_drbg_random(first.rng, none, 16) ?? panic("{err:Debug}")
    assert_eq(drawn, drbg.hmac_drbg_random(second.rng, none, 16) ?? panic("{err:Debug}"))
    assert(drawn != (drbg.hmac_drbg_random(zeroed.rng, none, 16) ?? panic("{err:Debug}")))
}

// Moves what one engine queued for the network to the other's input, so a
// test runs both ends of a handshake in memory.
priv test_pump: fn(from: &TLSState, to: &TLSState) Never! {
    to.ssl.bio.rx.extend(from.ssl.bio.tx)
    from.ssl.bio.tx.clear()
}

// One engine handshake call: 0 when it is over, else the status it stopped at.
priv test_step: fn(tls: &TLSState) -> Int Never! {
    if tls.ssl.state == ssldefs.SSL_HANDSHAKE_OVER -> return 0
    if ssltls.ssl_handshake(tls.ssl, tls.rng) == .Err(e) -> return engine_status(e)
    0
}

// Whether a finished handshake kept none of what it needed only to finish:
// the key shares, the secrets, the transcript and the handshake transform.
priv test_handshake_freed: fn(ssl: &ssldefs.SSLContext) -> Bool Never! {
    share: if &ssl.handshake.ecdh_ctx == {
        .Val(_) -> true
        None -> false
    }
    transcript: if &ssl.handshake.fin_sha256 == {
        .Val(_) -> true
        None -> false
    }
    if share || transcript || ssl.handshake.transform_handshake != -1 -> return false
    ssl.handshake.randbytes.len() == 0 && ssl.handshake.premaster.len() == 0 && ssl.handshake.finished_digest.len() == 0 && ssl.handshake.tls13_app_secret.len() == 0 && ssl.handshake.client_handshake_traffic_secret.len() == 0 && ssl.handshake.server_handshake_traffic_secret.len() == 0
}

priv test_zero: fn(bytes: [U8]) -> Bool Never! {
    loop b in bytes {
        if b != (U8{0}) -> return false
    }
    true
}

// Whether a state's engine was freed and its buffers wiped.
priv test_released: fn(tls: TLSState) -> Bool Never! {
    !tls.ssl.has_conf && tls.ssl.tpool.len() == 0 && tls.ssl.spool.len() == 0 && tls.ssl.in_buf.len() == 0 && tls.pending.len() == 0 && test_zero(tls.buffer)
}

#Test("A finished TLS 1.2 or 1.3 handshake keeps none of its secrets, and close and release free the engine and wipe the plaintext") {
    cert: String.from_bytes(core.files.read_bytes("Tests/Fixtures/TLS/localhost.cert.pem") ?? panic("{err}")) ?? ""
    key: String.from_bytes(core.files.read_bytes("Tests/Fixtures/TLS/localhost.key.pem") ?? panic("{err}")) ?? ""
    versions: [Int]{ssldefs.SSL_VERSION_TLS1_2, ssldefs.SSL_VERSION_TLS1_3}
    loop version in versions {
        listener := net.tcp_listen("127.0.0.1:0") ?? panic("listen: {err}")
        addr: net.listener_local_socket_addr(listener) ?? panic("listen address: {err}")
        client_tcp := net.tcp_connect_addr(addr) ?? panic("connect: {err}")
        server_tcp := net.tcp_accept(listener) ?? panic("accept: {err}")
        client_context := context_new(ssldefs.SSL_IS_CLIENT) ?? panic("client context: {err}")
        client_context.conf.authmode = ssldefs.SSL_VERIFY_NONE
        client_context.conf.max_tls_version = version
        server_context := server_tls_context(cert, key) ?? panic("server context: {err}")
        server_context.conf.authmode = ssldefs.SSL_VERIFY_NONE
        client := open(client_context, client_tcp, "") ?? panic("client: {ssl_text(err)}")
        server := open(server_context, server_tcp, "") ?? panic("server: {ssl_text(err)}")
        rounds := 0
        loop client.ssl.state != ssldefs.SSL_HANDSHAKE_OVER || server.ssl.state != ssldefs.SSL_HANDSHAKE_OVER {
            rounds += 1
            assert(rounds < 20)
            sent: test_step(client)
            assert(sent == 0 || sent == C_WANT_READ)
            test_pump(client, server)
            answered: test_step(server)
            assert(answered == 0 || answered == C_WANT_READ)
            test_pump(server, client)
        }
        assert_eq(client.ssl.tls_version, version)
        assert(test_handshake_freed(client.ssl))
        assert(test_handshake_freed(server.ssl))
        // Application bytes land in the server's plaintext buffer.
        message: "a secret line".bytes()
        wrote := 0
        if sslmsg.ssl_write(client.ssl, message, message.len(), client.rng) == .Ok(n) -> wrote = n
        assert_eq(wrote, message.len())
        test_pump(client, server)
        got := 0
        if sslmsg.ssl_read(server.ssl, server.buffer, C_RECORD_BYTES, server.rng) == .Ok(n) {
            got = n
        }
        assert_eq(got, message.len())
        assert(!test_zero(server.buffer))
        // close: close_notify goes out, then the engine is freed and the
        // plaintext wiped.
        stream := TLSStream{state: Val(Shared{server})}
        _: stream.close() ?? panic("close: {err}")
        state: __state(stream) ?? panic("the closed stream lost its state")
        guard := state.guard_edit()
        assert(test_released(guard.value))
        release(client)
        assert(test_released(client))
    }
}

#Test("A refused TLS handshake frees the engine and wipes the buffers on both ends") {
    cert: String.from_bytes(core.files.read_bytes("Tests/Fixtures/TLS/localhost.cert.pem") ?? panic("{err}")) ?? ""
    key: String.from_bytes(core.files.read_bytes("Tests/Fixtures/TLS/localhost.key.pem") ?? panic("{err}")) ?? ""
    listener := net.tcp_listen("127.0.0.1:0") ?? panic("listen: {err}")
    addr: net.listener_local_socket_addr(listener) ?? panic("listen address: {err}")
    client_tcp := net.tcp_connect_addr(addr) ?? panic("connect: {err}")
    server_tcp := net.tcp_accept(listener) ?? panic("accept: {err}")
    client_context := context_new(ssldefs.SSL_IS_CLIENT) ?? panic("client context: {err}")
    client_context.conf.authmode = ssldefs.SSL_VERIFY_NONE
    client_context.conf.max_tls_version = ssldefs.SSL_VERSION_TLS1_2
    server_context := server_tls_context(cert, key) ?? panic("server context: {err}")
    server_context.conf.authmode = ssldefs.SSL_VERIFY_NONE
    server_context.conf.min_tls_version = ssldefs.SSL_VERSION_TLS1_3
    client := open(client_context, client_tcp, "") ?? panic("client: {ssl_text(err)}")
    server := open(server_context, server_tcp, "") ?? panic("server: {ssl_text(err)}")
    // The TLS 1.2-only ClientHello reaches the TLS 1.3-only server in memory;
    // the server refuses it, and its alert reaches the client over the socket.
    assert_eq(test_step(client), C_WANT_READ)
    test_pump(client, server)
    end_ns: rt.clock_mono_ns() + 10000000000
    server_refused := false
    if run_handshake(server, "", end_ns) == .Err(_) -> server_refused = true
    assert(server_refused)
    assert(test_handshake_freed(server.ssl))
    assert(test_released(server))
    client_refused := false
    if run_handshake(client, "", end_ns) == .Err(_) -> client_refused = true
    assert(client_refused)
    assert(test_handshake_freed(client.ssl))
    assert(test_released(client))
}

// Buffers decrypted bytes for `ready`; true once a read would not block.
// Only a `readable` socket is read, once.
priv fill_pending: fn(tls: &TLSState, operation: IOOperation, end_ns: Int, readable: Bool) -[Net, Time.Wait]> Bool IOError! {
    if tls.pending.len() > 0 || tls.read_eof -> return Ok(true)
    socket := readable
    loop {
        got: engine_read(tls, C_RECORD_BYTES, end_ns, "tls ready") ?? return Err(net_to_io(err))
        status := got.status
        if status > 0 {
            tls.pending = got.bytes
            return Ok(true)
        }
        if status == C_PEER_CLOSE_NOTIFY {
            tls.read_eof = true
            return Ok(true)
        }
        if status == 0 -> return Err(io_error(operation, C_TRUNCATION))
        if status == C_NEW_SESSION_TICKET -> next
        if status == C_WANT_READ || status == C_WANT_WRITE {
            if status == C_WANT_WRITE || !socket -> return Ok(false)
            socket = false
            status = __take(tls, end_ns)
            if status == 0 -> next
        }
        return Err(io_error(operation, "TLS read readiness failed: {mbedtls_text(status)}"))
    }
}

priv write_all: fn(tls: &TLSState, bytes: [U8], end_ns: Int) -[Net, Time.Wait]> IOError! {
    if tls.closed || tls.write_closed -> return Err(io_error(.Write, "TLS stream is closed"))
    offset := 0
    loop offset < bytes.len() {
        size: if bytes.len() - offset > C_RECORD_BYTES -> C_RECORD_BYTES else -> bytes.len() - offset
        count: if offset == 0 && size == bytes.len() -> write_chunk(tls, bytes, end_ns) ?? return Err(err) else -> write_chunk(tls, byte_range(bytes, offset, offset + size), end_ns) ?? return Err(err)
        if count == 0 {
            return Err(IOError.Other(io_context(.Write, "tls write all failed: zero bytes written")))
        }
        offset += count
    }
    Ok()
}

// One engine write (mbedtls_ssl_write): the count it took, after its records
// were sent.
priv write_chunk: fn(tls: &TLSState, chunk: [U8], end_ns: Int) -[Net, Time.Wait]> Int IOError! {
    loop {
        status := 0
        if sslmsg.ssl_write(tls.ssl, chunk, chunk.len(), tls.rng) == {
            .Ok(count) -> { status = count }
            .Err(e) -> status = engine_status(e)
        }
        sent: flush(tls, end_ns, "tls write") ?? return Err(net_to_io(err))
        status = settle(status, sent)
        if status >= 0 -> return Ok(status)
        if status == C_NEW_SESSION_TICKET -> next
        if status == C_WANT_READ || status == C_WANT_WRITE {
            status = await(tls, status, end_ns, "tls write") ?? return Err(net_to_io(err))
            if status == 0 -> next
        }
        return Err(io_error(.Write, "TLS write failed: {mbedtls_text(status)}"))
    }
}

priv send_close_notify: fn(tls: &TLSState, end_ns: Int, operation: String) -[Net, Time.Wait]> IOError! {
    if tls.write_closed -> return Ok()
    loop {
        status := 0
        if sslmsg.ssl_close_notify(tls.ssl, tls.rng) == .Err(e) -> status = engine_status(e)
        sent: flush(tls, end_ns, operation) ?? return Err(net_to_io(err))
        status = settle(status, sent)
        if status == 0 -> break
        if status == C_WANT_READ || status == C_WANT_WRITE {
            status = await(tls, status, end_ns, operation) ?? return Err(net_to_io(err))
            if status == 0 -> next
        }
        return Err(io_error(.Close, "TLS close-notify flush failed: {mbedtls_text(status)}"))
    }
    shutdown_failure: if tls.tcp.shutdown(NetShutdown.Write) == {
        .Ok(_) -> ""
        .Err(err) -> if not_connected(err) -> "" else -> "{err}"
    }
    if shutdown_failure != "" {
        return Err(io_error(.Close, "TLS socket write shutdown failed: {shutdown_failure}"))
    }
    tls.write_closed = true
    Ok()
}

priv not_connected: fn(err: NetError) -> Bool Never! {
    if err == {
        .NotConnected(_) -> true
        .InvalidInput(_) | .PermissionDenied(_) | .AddressInUse(_) | .AddressUnavailable(_) | .ConnectionRefused(_) | .ConnectionReset(_) | .Closed(_) | .Timeout(_) | .Cancelled(_) | .Unsupported(_) | .TLS(_) | .Protocol(_) | .Other(_) | .DNS(_) -> false
    }
}

// One socket readiness wait bounded by the operation deadline. Long waits are
// sliced so the runtime never sees an unbounded duration; a timeout that comes
// before the slice ends (an ambient deadline) is the caller's error as is.
priv ready_wait: fn(tcp: TCPStream, interest: NetReadyInterest, end_ns: Int, operation: String) -[Net, Time.Wait]> NetReady NetError! {
    started: rt.clock_mono_ns()
    remaining: end_ns - started
    if remaining <= 0 -> return Err(deadline_error(operation))
    slice: if remaining > C_WAIT_SLICE_NS -> C_WAIT_SLICE_NS else -> remaining
    if tcp.ready(interest, deadline: Duration{ns: slice}) == {
        .Ok(ready) -> Ok(ready)
        .Err(err) -> {
            if timed_out(err) {
                now: rt.clock_mono_ns()
                if now >= end_ns -> return Err(deadline_error(operation))
                if slice < remaining && now - started >= slice {
                    return Ok(NetReady{readable: false, writable: false})
                }
            }
            Err(err)
        }
    }
}

priv timed_out: fn(err: NetError) -> Bool Never! {
    if err == {
        .Timeout(_) -> true
        .InvalidInput(_) | .PermissionDenied(_) | .AddressInUse(_) | .AddressUnavailable(_) | .ConnectionRefused(_) | .ConnectionReset(_) | .NotConnected(_) | .Closed(_) | .Cancelled(_) | .Unsupported(_) | .TLS(_) | .Protocol(_) | .Other(_) | .DNS(_) -> false
    }
}

priv forever: fn() -> Duration Never! { Duration{ns: C_NO_DEADLINE} }

priv deadline_end: fn(deadline: Duration, operation: String) -> Int NetError! {
    if deadline.ns < 0 {
        return Err(NetError.InvalidInput(tls_error_detail(operation, "network timeout must be non-negative")))
    }
    now: rt.clock_mono_ns()
    if deadline.ns > C_NO_DEADLINE - now -> return Ok(C_NO_DEADLINE)
    Ok(now + deadline.ns)
}

__state: fn(stream: TLSStream) -> Shared<TLSState>? Never! {
    if stream.state == .Val(state) -> return Val(state.copy())
    None
}

// ---- errors -------------------------------------------------------------------

priv tls_error_detail: fn(operation: String, message: String) -> NetErrorDetail Never! {
    NetErrorDetail{operation: operation, address: None, name: None, message: message, os_code: None}
}

priv deadline_error: fn(operation: String) -> NetError Never! {
    NetError.Timeout(tls_error_detail(operation, "deadline exceeded while waiting in {operation}"))
}

priv net_error: fn(operation: String, message: String) -> NetError Never! {
    if message.starts_with("TLS protocol truncation:") {
        return NetError.Protocol(tls_error_detail(operation, message))
    }
    if message.contains("closed") -> return NetError.Closed(tls_error_detail(operation, message))
    if message.contains("timed out") || message.contains("deadline") {
        return NetError.Timeout(tls_error_detail(operation, message))
    }
    NetError.TLS(tls_error_detail(operation, message))
}

priv io_context: fn(operation: IOOperation, message: String) -> IOContext Never! {
    IOContext{operation: operation, resource: Val("TLS stream"), os_code: None, cause: Val(message)}
}

priv io_error: fn(operation: IOOperation, message: String) -> IOError Never! {
    if message.starts_with("TLS protocol truncation:") || message.starts_with("TLS protocol error:") {
        return IOError.Protocol(io_context(operation, message))
    }
    if message.contains("closed") -> return IOError.Closed(io_context(operation, message))
    if message.contains("timed out") || message.contains("deadline") {
        return IOError.TimedOut(io_context(operation, message))
    }
    if message.contains("canceled") -> return IOError.Cancelled(io_context(operation, message))
    IOError.Other(io_context(operation, message))
}

priv net_io_context: fn(detail: NetErrorDetail) -> IOContext Never! {
    operation: if {
        detail.operation.contains("read") -> IOOperation.Read
        detail.operation.contains("write") || detail.operation.contains("send") -> IOOperation.Write
        detail.operation.contains("connect") -> IOOperation.Connect
        detail.operation.contains("accept") -> IOOperation.Accept
        detail.operation.contains("close") || detail.operation.contains("shutdown") -> IOOperation.Close
        detail.operation.contains("resolve") || detail.operation.contains("dns") -> IOOperation.Resolve
        else -> IOOperation.Codec
    }
    resource: if detail.address == .Val(address) -> Val(address.copy()) else -> detail.name.copy()
    IOContext{operation: operation, resource: resource, os_code: detail.os_code, cause: Val(detail.message.copy())}
}

priv net_to_io: fn(err: NetError) -> IOError Never! {
    if err == {
        .InvalidInput(detail) -> IOError.InvalidInput(net_io_context(detail))
        .PermissionDenied(detail) -> IOError.PermissionDenied(net_io_context(detail))
        .Timeout(detail) -> IOError.TimedOut(net_io_context(detail))
        .Cancelled(detail) -> IOError.Cancelled(net_io_context(detail))
        .Closed(detail) -> IOError.Closed(net_io_context(detail))
        .NotConnected(detail) -> IOError.Closed(net_io_context(detail))
        .Protocol(detail) -> IOError.Protocol(net_io_context(detail))
        .AddressInUse(detail) -> IOError.Other(net_io_context(detail))
        .AddressUnavailable(detail) -> IOError.Other(net_io_context(detail))
        .ConnectionRefused(detail) -> IOError.Other(net_io_context(detail))
        .ConnectionReset(detail) -> IOError.Other(net_io_context(detail))
        .Unsupported(detail) -> IOError.Other(net_io_context(detail))
        .TLS(detail) -> IOError.Other(net_io_context(detail))
        .Other(detail) -> IOError.Other(net_io_context(detail))
        .DNS(_) -> IOError.Other(IOContext{operation: .Resolve, resource: None, os_code: None, cause: Val("{err}")})
    }
}

// The high-level part of a composite Mbed TLS status (negative), or 0.
priv mbedtls_high: fn(status: Int) -> Int Never! { 0 - ((0 - status) & 32640) }

priv mbedtls_text: fn(status: Int) -> String Never! {
    positive: 0 - status
    high: positive & 32640
    low: positive & 127
    text: mbedtls_known(if high != 0 -> high else -> low)
    if text != "" -> return text
    "Mbed TLS error -0x{__hex(positive, 4)}"
}

priv mbedtls_known: fn(code: Int) -> String Never! {
    if code == {
        0x7780 -> "received a fatal alert from the peer"
        0x7A00 -> "the peer certificate could not be processed"
        0x6E00 -> "the handshake negotiation failed"
        0x6E80 -> "no TLS version in common with the peer"
        0x7700 -> "received an unexpected message"
        0x7300 -> "received a message that could not be decoded"
        0x7200 -> "received an invalid record"
        0x7180 -> "a record failed its integrity check"
        0x7580 -> "no application protocol in common with the peer"
        0x7800 -> "the peer did not recognize the server name"
        0x7F00 -> "memory allocation failed"
        0x6C00 -> "internal error"
        0x6800 -> "the operation timed out"
        0x5E80 -> "the TLS configuration is invalid"
        0x7280 -> "the peer ended the connection during the exchange"
        0x7100 -> "invalid input"
        0x2700 -> "the peer certificate could not be verified"
        0x2180 -> "the certificate format is invalid"
        0x2900 -> "the certificate file could not be read"
        0x2800 -> "invalid certificate input"
        0x3D00 -> "the private key format is invalid"
        0x3C80 -> "the private key algorithm is not supported"
        0x3B00 -> "the private key is encrypted"
        0x3F00 -> "the key types do not match"
        0x3E80 -> "invalid key input"
        0x0050 -> "connection reset by peer"
        0x004C -> "receiving from the socket failed"
        0x004E -> "sending to the socket failed"
        else -> ""
    }
}

__hex: fn(value: Int, width: Int) -> String Never! {
    digits := [U8]{}
    rest := value
    loop rest > 0 || digits.len() < width {
        digit: rest %% 16
        digits.push(U8{if digit < 10 -> 48 + digit else -> 55 + digit})
        rest = rest /% 16
    }
    out := [U8]{}
    at := digits.len()
    loop at > 0 {
        at -= 1
        out.push(digits[at])
    }
    String.from_bytes(out) ?? ""
}

// ---- verified peer identity ---------------------------------------------------

priv empty_certificate: fn() -> TLSCertificate Never! {
    TLSCertificate{der: [U8]{}, sha256: [U8]{}, spki_sha256: [U8]{}, dns_names: [String]{}, valid_from_unix_ms: 0, valid_until_unix_ms: 0, subject: "", issuer: ""}
}

priv empty_identity: fn() -> TLSPeerIdentity Never! {
    TLSPeerIdentity{verified_server_name: "", leaf: empty_certificate(), certificate_chain: [TLSCertificate]{}, cipher_suite: "", tls_version: TLSVersion.TLS12}
}

// The verified peer's identity. Each certificate's fields come from the
// engine's parsed X509Crt chain, leaf first (mbedtls_ssl_get_peer_cert), so
// every certificate x509 accepted reports them and no second DER walk can
// refuse one.
priv verified_peer_identity: fn(ssl: ssldefs.SSLContext, server_name: String) -> TLSPeerIdentity TLSFailure! {
    chain := [TLSCertificate]{}
    if ssl.session >= 0 && ssl.session < ssl.spool.len() && ssl.spool[ssl.session].peer_cert == .Val(certs) {
        loop crt in certs -> chain.push(certificate(crt))
    }
    if chain.len() == 0 -> return Err(fail("TLS verified peer did not provide a certificate chain"))
    suite: ssltls.ssl_get_ciphersuite(ssl) ?? ""
    if suite == "" -> return Err(fail("TLS verified peer did not expose a negotiated cipher suite"))
    version: ssl.tls_version
    tls_version: TLSVersion.from_int(version) ?? return Err(fail("TLS verified peer negotiated unsupported protocol version: {version}"))
    leaf: chain[0].copy()
    Ok(TLSPeerIdentity{verified_server_name: server_name.copy(), leaf: leaf, certificate_chain: chain, cipher_suite: suite_name(suite), tls_version: tls_version})
}

// A dNSName that is not UTF-8 stays as escaped source bytes, like a name.
priv certificate: fn(crt: x509crt.X509Crt) -> TLSCertificate Never! {
    dns_names := [String]{}
    loop san in crt.subject_alt_names {
        if x509crt.x509_crt_san_type(san) != x509.X509_SAN_DNS_NAME -> next
        bytes: x509crt.x509_crt_san_bytes(crt, san)
        dns_names.push(String.from_bytes(bytes) ?? escaped(bytes))
    }
    TLSCertificate{
        der: crt.raw.copy(),
        sha256: crypto.sha256(crt.raw).bytes,
        spki_sha256: crypto.sha256(byte_range(crt.raw, crt.pk_raw.p, crt.pk_raw.p + crt.pk_raw.len)).bytes,
        dns_names: dns_names,
        valid_from_unix_ms: unix_ms(crt.valid_from),
        valid_until_unix_ms: unix_ms(crt.valid_to),
        subject: name_text(crt.subject),
        issuer: name_text(crt.issuer),
    }
}

// Mbed TLS names suites like "TLS1-3-AES-128-GCM-SHA256"; report the IANA
// spelling rustls used ("TLS13_AES_128_GCM_SHA256").
priv suite_name: fn(name: String) -> String Never! {
    if name.starts_with("TLS1-3-") -> return "TLS13_{name.slice(7, name.len()).replace("-", "_")}"
    name.replace("-", "_")
}

// Each attribute as LABEL=value, in certificate order, comma-joined.
priv name_text: fn(names: [asn1.NamedData]) -> String Never! {
    parts := [String]{}
    loop name in names {
        // Non-UTF8 DirectoryStrings, including Teletex and BMP/Universal,
        // stay as escaped source bytes: audit text is lossless and cannot
        // fail an already-verified handshake.
        text := escaped(name.val)
        if name.val_tag == 12 -> text = String.from_bytes(name.val) ?? text
        parts.push("{name_label(name.oid)}={text}")
    }
    parts.join(",")
}

priv name_label: fn(oid: [U8]) -> String Never! {
    if oid.len() != 3 || oid[0] != (U8{85}) || oid[1] != (U8{4}) -> return "OID"
    if (Int{oid[2]}) == {
        3 -> "CN"
        6 -> "C"
        7 -> "L"
        8 -> "ST"
        10 -> "O"
        11 -> "OU"
        else -> "OID"
    }
}

priv escaped: fn(bytes: [U8]) -> String Never! {
    out := [U8]{}
    loop byte in bytes {
        n: Int{byte}
        if {
            n == 92 || n == 44 || n == 61 -> {
                out.push(U8{92})
                out.push(byte)
            }
            n >= 32 && n <= 126 -> { out.push(byte) }
            else -> {
                loop b in "\\x{ascii_lower(__hex(n, 2))}".bytes() -> out.push(b)
            }
        }
    }
    String.from_bytes(out) ?? ""
}

// An x509 time to Unix milliseconds (days_from_civil).
priv unix_ms: fn(time: x509.X509Time) -> Int Never! {
    y: if time.mon <= 2 -> time.year - 1 else -> time.year
    era: y /% 400
    yoe: y - era * 400
    mp: if time.mon > 2 -> time.mon - 3 else -> time.mon + 9
    doy: (153 * mp + 2) /% 5 + time.day - 1
    doe: yoe * 365 + yoe /% 4 - yoe /% 100 + doy
    days: era * 146097 + doe - 719468
    (days * 86400 + time.hour * 3600 + time.min * 60 + time.sec) * 1000
}

#Test("Peer identity fields come from the parsed X509Crt, so a dNSName x509 keeps but that is not UTF-8 still reports") {
    pem: core.files.read_bytes("Tests/Fixtures/TLS/custom-root.server.cert.pem") ?? panic("{err}")
    chain := [x509crt.X509Crt]{}
    _: x509crt.x509_crt_parse(chain, pem) ?? panic("{err:Debug}")
    leaf: certificate(chain[0])
    assert_eq(leaf.subject, "CN=localhost")
    assert_eq(leaf.issuer, "CN=Jet-Test-CA")
    assert_eq(leaf.dns_names, [String]{"localhost"})
    assert_eq(leaf.valid_from_unix_ms, 1783974691000)
    assert_eq(leaf.valid_until_unix_ms, 2099334691000)
    assert_eq(leaf.der, chain[0].raw)
    // The first dNSName byte set to 0xff: x509 parses it (no signature check
    // here) and the identity escapes the byte instead of failing.
    der := chain[0].raw.copy()
    loop san in chain[0].subject_alt_names {
        if x509crt.x509_crt_san_type(san) == x509.X509_SAN_DNS_NAME -> der[san.p] = U8{255}
    }
    odd := [x509crt.X509Crt]{}
    x509crt.x509_crt_parse_der(odd, der) ?? panic("{err:Debug}")
    assert_eq(certificate(odd[0]).dns_names, [String]{"\\xffocalhost"})
    assert_eq(certificate(odd[0]).spki_sha256, leaf.spki_sha256)
}

// ---- `jet prove` journal --------------------------------------------------------

// The runtime's `jet prove` journal rows (JetRuntime ProveJournal.jet), which
// core.http.client's capture and replay ride.

// 0 outside `jet prove`, 1 under `--capture-sensitive`, 2 under `--replay`.
priv prove_net_mode: fn() -> Int Never! { core.net.tls.__host_prove_mode() }

// A capture journals one HTTP client hop's encoded bytes.
priv prove_net_record: fn(tape: [U8]) Never! {
    if tape.len() == 0 {
        return
    }
    core.net.tls.__host_prove_record(tape)
}

// A replay traces this hop's request and takes the next recorded hop's
// bytes; empty once the run diverged.
priv prove_net_take: fn(request: [U8]) -> [U8] Never! {
    core.net.tls.__host_prove_take(request) ?? [U8]{}
}

#Test("A TLS operation's deadline counts from when the operation reads the clock, not from a reading the build kept") {
    first: deadline_end(Duration{ns: 0}, "tls read") ?? panic("{err}")
    rt.sleep_ns(5000000)
    second: deadline_end(Duration{ns: 0}, "tls read") ?? panic("{err}")
    assert(second - first >= 5000000)
}
