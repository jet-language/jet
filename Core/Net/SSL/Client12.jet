// SPDX-License-Identifier: Apache-2.0
// Translated from Mbed TLS 3.6.7 (library/ssl_tls12_client.c); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: the TLS 1.2 client handshake.
//
// A port of mbedtls 3.6.7's ssl_tls12_client.c under the default
// mbedtls_config.h. MBEDTLS_USE_PSA_CRYPTO is off there, so the key
// exchanges run on the handshake's ECDH and DHM contexts; EC J-PAKE,
// DTLS-SRTP and restartable ECC are off and not ported. MBEDTLS_DEBUG_C is
// on, and its CertificateRequest loop rejects malformed distinguished
// names, so that check is kept.
//
// Messages are read at in_buf offsets and written at out_buf offsets.
// Unlike TLS 1.3, this side sends a fatal alert at once where it finds an
// error, as C does, whether or not the alert could be sent.
use {
    core
    __core_crypto_bignum.[RNG]
    hashes: __core_crypto_md
    ctime: __core_crypto_ctime
    oids: __core_crypto_oid
    asn1: __core_crypto_asn1
    ecp: __core_crypto_ecp
    ecdh: __core_crypto_ecdh
    dhm: __core_crypto_dhm
    pk: __core_crypto_pk
    x509: __core_crypto_x509
    ssldefs: __core_net_ssl_defs
    suites: __core_net_ssl_ciphersuites
    sslmsg: __core_net_ssl_msg
    ssltls: __core_net_ssl_tls
    gen13: __core_net_ssl_gen13
    sslcli: __core_net_ssl_cli
}

// Send a fatal alert and give the error to return with it.
ssl_cli12_fail: fn<R: RNG>(ssl: &ssldefs.SSLContext, alert: Int, reason: ssldefs.SSLError, rng: &R) -> ssldefs.SSLError Never! {
    ssltls.ssl_send_fatal_alert(ssl, alert, rng)
    reason.copy()
}

// ---------------------------------------------------------------------------
// ClientHello extensions.

// The renegotiation_info extension of a renegotiation, with our last
// Finished verify data (ssl_write_renegotiation_ext, RFC 5746 3.5).
ssl_cli12_write_renegotiation_ext: fn(ssl: &ssldefs.SSLContext, buf: Int, end: Int) -> Int ssldefs.SSLError! {
    if ssl.renego_status != ssldefs.SSL_RENEGOTIATION_IN_PROGRESS -> return Ok(0)
    vdl: ssl.verify_data_len
    ssltls.ssl_chk_buf(buf, end, 5 + vdl) ?? return Err(err)
    ssldefs.ssl_put_u16(ssl.out_buf, buf, ssldefs.TLS_EXT_RENEGOTIATION_INFO)
    ssl.out_buf[buf + 2] = U8{0}
    ssl.out_buf[buf + 3] = ssldefs.ssl_byte(vdl + 1)
    ssl.out_buf[buf + 4] = ssldefs.ssl_byte(vdl)
    ssldefs.ssl_copy_into(ssl.out_buf, buf + 5, ssl.own_verify_data, 0, vdl)
    Ok(5 + vdl)
}

// The ec_point_formats extension: uncompressed points only
// (ssl_write_supported_point_formats_ext, RFC 4492 5.1.2).
ssl_cli12_write_supported_point_formats_ext: fn(ssl: &ssldefs.SSLContext, buf: Int, end: Int) -> Int ssldefs.SSLError! {
    ssltls.ssl_chk_buf(buf, end, 6) ?? return Err(err)
    ssldefs.ssl_put_u16(ssl.out_buf, buf, ssldefs.TLS_EXT_SUPPORTED_POINT_FORMATS)
    ssldefs.ssl_put_u16(ssl.out_buf, buf + 2, 2)
    // One format, MBEDTLS_ECP_PF_UNCOMPRESSED.
    ssl.out_buf[buf + 4] = U8{1}
    ssl.out_buf[buf + 5] = U8{0}
    Ok(6)
}

// The DTLS connection_id extension with our CID, when CIDs are on
// (ssl_write_cid_ext, RFC 9146 3).
ssl_cli12_write_cid_ext: fn(ssl: &ssldefs.SSLContext, buf: Int, end: Int) -> Int ssldefs.SSLError! {
    if ssl.conf.transport != ssldefs.SSL_TRANSPORT_DATAGRAM || ssl.negotiate_cid == ssldefs.SSL_CID_DISABLED -> return Ok(0)
    cid_len: ssl.own_cid.len()
    ssltls.ssl_chk_buf(buf, end, cid_len + 5) ?? return Err(err)
    ssldefs.ssl_put_u16(ssl.out_buf, buf, ssldefs.TLS_EXT_CID)
    ssldefs.ssl_put_u16(ssl.out_buf, buf + 2, cid_len + 1)
    ssl.out_buf[buf + 4] = ssldefs.ssl_byte(cid_len)
    ssldefs.ssl_copy_into(ssl.out_buf, buf + 5, ssl.own_cid, 0, cid_len)
    Ok(cid_len + 5)
}

// The max_fragment_length extension, when one is configured
// (ssl_write_max_fragment_length_ext, RFC 6066 4).
ssl_cli12_write_max_fragment_length_ext: fn(ssl: &ssldefs.SSLContext, buf: Int, end: Int) -> Int ssldefs.SSLError! {
    if ssl.conf.mfl_code == ssldefs.SSL_MAX_FRAG_LEN_NONE -> return Ok(0)
    ssltls.ssl_chk_buf(buf, end, 5) ?? return Err(err)
    ssldefs.ssl_put_u16(ssl.out_buf, buf, ssldefs.TLS_EXT_MAX_FRAGMENT_LENGTH)
    ssldefs.ssl_put_u16(ssl.out_buf, buf + 2, 1)
    ssl.out_buf[buf + 4] = ssldefs.ssl_byte(ssl.conf.mfl_code)
    Ok(5)
}

// The empty encrypt_then_mac extension, when it is on
// (ssl_write_encrypt_then_mac_ext, RFC 7366 2).
ssl_cli12_write_encrypt_then_mac_ext: fn(ssl: &ssldefs.SSLContext, buf: Int, end: Int) -> Int ssldefs.SSLError! {
    if ssl.conf.encrypt_then_mac == ssldefs.SSL_ETM_DISABLED -> return Ok(0)
    ssltls.ssl_chk_buf(buf, end, 4) ?? return Err(err)
    ssldefs.ssl_put_u16(ssl.out_buf, buf, ssldefs.TLS_EXT_ENCRYPT_THEN_MAC)
    ssldefs.ssl_put_u16(ssl.out_buf, buf + 2, 0)
    Ok(4)
}

// The empty extended_master_secret extension, when it is on
// (ssl_write_extended_ms_ext, RFC 7627 5.1).
ssl_cli12_write_extended_ms_ext: fn(ssl: &ssldefs.SSLContext, buf: Int, end: Int) -> Int ssldefs.SSLError! {
    if ssl.conf.extended_ms == ssldefs.SSL_EXTENDED_MS_DISABLED -> return Ok(0)
    ssltls.ssl_chk_buf(buf, end, 4) ?? return Err(err)
    ssldefs.ssl_put_u16(ssl.out_buf, buf, ssldefs.TLS_EXT_EXTENDED_MASTER_SECRET)
    ssldefs.ssl_put_u16(ssl.out_buf, buf + 2, 0)
    Ok(4)
}

// The session_ticket extension with the ticket of the session to resume,
// empty without one, when tickets are on (ssl_write_session_ticket_ext,
// RFC 5077 3.2).
ssl_cli12_write_session_ticket_ext: fn(ssl: &ssldefs.SSLContext, buf: Int, end: Int) -> Int ssldefs.SSLError! {
    if ssltls.ssl_conf_get_session_tickets(ssl.conf) == ssldefs.SSL_SESSION_TICKETS_DISABLED -> return Ok(0)
    ticket := if ssl.spool[ssl.session_negotiate].ticket == {
        .Val(t) -> t.copy()
        None -> [U8]{}
    }
    tlen: ticket.len()
    ssltls.ssl_chk_buf(buf, end, 4 + tlen) ?? return Err(err)
    ssldefs.ssl_put_u16(ssl.out_buf, buf, ssldefs.TLS_EXT_SESSION_TICKET)
    ssldefs.ssl_put_u16(ssl.out_buf, buf + 2, tlen)
    ssldefs.ssl_copy_into(ssl.out_buf, buf + 4, ticket, 0, tlen)
    Ok(4 + tlen)
}

/// Write the ClientHello extensions only TLS 1.2 sends at out_buf[buf..<end]
/// and give their length (mbedtls_ssl_tls12_write_client_hello_exts):
/// renegotiation_info in a renegotiation, ec_point_formats when `uses_ec`,
/// connection_id, max_fragment_length, encrypt_then_mac,
/// extended_master_secret and session_ticket.
ssl_tls12_write_client_hello_exts: fn(ssl: &ssldefs.SSLContext, buf: Int, end: Int, uses_ec: Bool) -> Int ssldefs.SSLError! {
    p := buf
    p += ssl_cli12_write_renegotiation_ext(ssl, p, end) ?? return Err(err)
    if uses_ec {
        p += ssl_cli12_write_supported_point_formats_ext(ssl, p, end) ?? return Err(err)
    }
    p += ssl_cli12_write_cid_ext(ssl, p, end) ?? return Err(err)
    p += ssl_cli12_write_max_fragment_length_ext(ssl, p, end) ?? return Err(err)
    p += ssl_cli12_write_encrypt_then_mac_ext(ssl, p, end) ?? return Err(err)
    p += ssl_cli12_write_extended_ms_ext(ssl, p, end) ?? return Err(err)
    p += ssl_cli12_write_session_ticket_ext(ssl, p, end) ?? return Err(err)
    Ok(p - buf)
}

// ---------------------------------------------------------------------------
// ServerHello extensions, each at in_buf[buf..<buf + len].

// renegotiation_info: empty on the first handshake, our and the server's
// last verify data in a renegotiation (ssl_parse_renegotiation_info,
// RFC 5746 3.4).
ssl_cli12_parse_renegotiation_info: fn<R: RNG>(ssl: &ssldefs.SSLContext, buf: Int, len: Int, rng: &R) ssldefs.SSLError! {
    if ssl.renego_status != ssldefs.SSL_INITIAL_HANDSHAKE {
        vdl: ssl.verify_data_len
        ok := len == 1 + vdl * 2 && ssldefs.ssl_u8(ssl.in_buf, buf) == vdl * 2
        if ok {
            ok = ctime.memcmp(ssl.in_buf, buf + 1, ssl.own_verify_data, 0, vdl) == 0 && ctime.memcmp(ssl.in_buf, buf + 1 + vdl, ssl.peer_verify_data, 0, vdl) == 0
        }
        if !ok -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE, .HandshakeFailure, rng))
        return
    }
    if len != 1 || ssldefs.ssl_u8(ssl.in_buf, buf) != 0 -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE, .HandshakeFailure, rng))
    ssl.secure_renegotiation = ssldefs.SSL_SECURE_RENEGOTIATION
}

// max_fragment_length: the code we asked for (ssl_parse_max_fragment_length_ext).
ssl_cli12_parse_max_fragment_length_ext: fn<R: RNG>(ssl: &ssldefs.SSLContext, buf: Int, len: Int, rng: &R) ssldefs.SSLError! {
    if ssl.conf.mfl_code == ssldefs.SSL_MAX_FRAG_LEN_NONE || len != 1 || ssldefs.ssl_u8(ssl.in_buf, buf) != ssl.conf.mfl_code {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_ILLEGAL_PARAMETER, .IllegalParameter, rng))
    }
}

// connection_id: the server's CID, when we offered CIDs (ssl_parse_cid_ext).
ssl_cli12_parse_cid_ext: fn<R: RNG>(ssl: &ssldefs.SSLContext, buf: Int, len: Int, rng: &R) ssldefs.SSLError! {
    if ssl.conf.transport != ssldefs.SSL_TRANSPORT_DATAGRAM || ssl.negotiate_cid == ssldefs.SSL_CID_DISABLED {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_UNSUPPORTED_EXT, .UnsupportedExtension, rng))
    }
    if len == 0 -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    peer_cid_len: ssldefs.ssl_u8(ssl.in_buf, buf)
    if peer_cid_len > ssldefs.SSL_CID_OUT_LEN_MAX -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_ILLEGAL_PARAMETER, .IllegalParameter, rng))
    if len - 1 != peer_cid_len -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    ssl.handshake.cid_in_use = ssldefs.SSL_CID_ENABLED
    ssl.handshake.peer_cid = ssldefs.ssl_bytes_of(ssl.in_buf, buf + 1, peer_cid_len)
}

// encrypt_then_mac: empty, and only if we offered it
// (ssl_parse_encrypt_then_mac_ext).
ssl_cli12_parse_encrypt_then_mac_ext: fn<R: RNG>(ssl: &ssldefs.SSLContext, len: Int, rng: &R) ssldefs.SSLError! {
    if ssl.conf.encrypt_then_mac == ssldefs.SSL_ETM_DISABLED || len != 0 {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_UNSUPPORTED_EXT, .UnsupportedExtension, rng))
    }
    ssl.spool[ssl.session_negotiate].encrypt_then_mac = ssldefs.SSL_ETM_ENABLED
}

// extended_master_secret: empty, and only if we offered it
// (ssl_parse_extended_ms_ext).
ssl_cli12_parse_extended_ms_ext: fn<R: RNG>(ssl: &ssldefs.SSLContext, len: Int, rng: &R) ssldefs.SSLError! {
    if ssl.conf.extended_ms == ssldefs.SSL_EXTENDED_MS_DISABLED || len != 0 {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_UNSUPPORTED_EXT, .UnsupportedExtension, rng))
    }
    ssl.handshake.extended_ms = ssldefs.SSL_EXTENDED_MS_ENABLED
}

// session_ticket: empty, and only if we offered it; a NewSessionTicket
// follows (ssl_parse_session_ticket_ext).
ssl_cli12_parse_session_ticket_ext: fn<R: RNG>(ssl: &ssldefs.SSLContext, len: Int, rng: &R) ssldefs.SSLError! {
    if ssltls.ssl_conf_get_session_tickets(ssl.conf) == ssldefs.SSL_SESSION_TICKETS_DISABLED || len != 0 {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_UNSUPPORTED_EXT, .UnsupportedExtension, rng))
    }
    ssl.handshake.new_session_ticket = 1
}

// ec_point_formats: the first of uncompressed or compressed the server
// lists becomes the ECDH point format (ssl_parse_supported_point_formats_ext).
ssl_cli12_parse_supported_point_formats_ext: fn<R: RNG>(ssl: &ssldefs.SSLContext, buf: Int, len: Int, rng: &R) ssldefs.SSLError! {
    if len == 0 || ssldefs.ssl_u8(ssl.in_buf, buf) + 1 != len {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    }
    list_size: ssldefs.ssl_u8(ssl.in_buf, buf)
    loop i in 0..<list_size {
        f: ssldefs.ssl_u8(ssl.in_buf, buf + 1 + i)
        // MBEDTLS_ECP_PF_UNCOMPRESSED and MBEDTLS_ECP_PF_COMPRESSED.
        if f == 0 || f == 1 {
            fmt: if f == 0 -> ecp.PointFormat.Uncompressed else -> ecp.PointFormat.Compressed
            ssltls.ssl_ecdh_ready(ssl)
            if &ssl.handshake.ecdh_ctx == {
                .Val(ctx) -> ctx.point_format = fmt
                None -> {}
            }
            return
        }
    }
    Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE, .HandshakeFailure, rng))
}

// application_layer_protocol_negotiation: one protocol, which must be one
// of ours (ssl_parse_alpn_ext, RFC 7301 3.1).
ssl_cli12_parse_alpn_ext: fn<R: RNG>(ssl: &ssldefs.SSLContext, buf: Int, len: Int, rng: &R) ssldefs.SSLError! {
    ours: ssl.conf.alpn_list ?? return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_UNSUPPORTED_EXT, .UnsupportedExtension, rng))
    // The list length, then one name with its length.
    if len < 4 -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    list_len: ssldefs.ssl_get_u16(ssl.in_buf, buf)
    if list_len != len - 2 -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    name_len: ssldefs.ssl_u8(ssl.in_buf, buf + 2)
    if name_len != list_len - 1 -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    loop alpn in ours {
        alpn_bytes: alpn.bytes()
        if name_len == alpn_bytes.len() && ssldefs.ssl_range_eq(ssl.in_buf, buf + 3, alpn_bytes, 0, name_len) {
            ssl.alpn_chosen = Val(alpn)
            return
        }
    }
    Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE, .HandshakeFailure, rng))
}

// ---------------------------------------------------------------------------
// HelloVerifyRequest and ServerHello.

// Keep the cookie of a DTLS HelloVerifyRequest and start over at the
// ClientHello (ssl_parse_hello_verify_request, RFC 6347 4.2.1).
ssl_cli12_parse_hello_verify_request: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    hdr: sslmsg.ssl_hs_hdr_len(ssl)
    // The version and the cookie length.
    if hdr + 3 > ssl.in_msglen -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    p := ssl.in_msg + hdr
    // DTLS 1.2 or, as the RFC is not clear there, DTLS 1.0.
    dtls_legacy_version: ssldefs.ssl_get_u16(ssl.in_buf, p)
    p += 2
    if dtls_legacy_version != 0xFEFD && dtls_legacy_version != 0xFEFF {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_PROTOCOL_VERSION, .BadProtocolVersion, rng))
    }
    cookie_len: ssldefs.ssl_u8(ssl.in_buf, p)
    p += 1
    if (ssl.in_msg + ssl.in_msglen) - p < cookie_len -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    ssl.handshake.cookie = Val(ssldefs.ssl_bytes_of(ssl.in_buf, p, cookie_len))
    sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_CLIENT_HELLO)
    ssltls.ssl_reset_checksum(ssl)
    sslmsg.ssl_recv_flight_completed(ssl)
}

// Read the ServerHello: the version, random, session and ciphersuite the
// server chose, and its extensions; a resumed session goes on to the
// server's ChangeCipherSpec (ssl_parse_server_hello). In DTLS a
// HelloVerifyRequest may come instead.
ssl_cli12_parse_server_hello: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    sslmsg.ssl_read_record(ssl, true, rng) ?? return Err(err)
    if ssl.in_msgtype != ssldefs.SSL_MSG_HANDSHAKE {
        if ssl.renego_status == ssldefs.SSL_RENEGOTIATION_IN_PROGRESS {
            ssl.renego_records_seen += 1
            // The server has not honored our renegotiation request.
            if ssl.conf.renego_max_records >= 0 && ssl.renego_records_seen > ssl.conf.renego_max_records -> return Err(.UnexpectedMessage)
            ssl.keep_current_message = 1
            return Err(.WaitingServerHelloRenego)
        }
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_UNEXPECTED_MESSAGE, .UnexpectedMessage, rng))
    }
    msg: ssl.in_msg
    hdr: sslmsg.ssl_hs_hdr_len(ssl)
    if ssl.conf.transport == ssldefs.SSL_TRANSPORT_DATAGRAM {
        if ssldefs.ssl_u8(ssl.in_buf, msg) == ssldefs.SSL_HS_HELLO_VERIFY_REQUEST {
            ssl_cli12_parse_hello_verify_request(ssl, rng) ?? return Err(err)
            return
        }
        // The cookie exchange is over.
        ssl.handshake.cookie = None
    }
    if ssl.in_hslen < 38 + hdr || ssldefs.ssl_u8(ssl.in_buf, msg) != ssldefs.SSL_HS_SERVER_HELLO {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    }
    // 0..1 version, 2..33 random, 34 session_id length n, 35..34+n
    // session_id, 35+n..36+n cipher_suite, 37+n compression, then the
    // optional extensions length and extensions.
    b: msg + hdr
    sn: ssl.session_negotiate
    ssl.tls_version = sslmsg.ssl_read_version(ssl.in_buf, b, ssl.conf.transport)
    ssl.spool[sn].tls_version = ssl.tls_version
    ssl.spool[sn].endpoint = ssl.conf.endpoint
    if ssl.tls_version < ssl.conf.min_tls_version || ssl.tls_version > ssl.conf.max_tls_version {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_PROTOCOL_VERSION, .BadProtocolVersion, rng))
    }
    ssldefs.ssl_copy_into(ssl.handshake.randbytes, 32, ssl.in_buf, b + 2, 32)
    n: ssldefs.ssl_u8(ssl.in_buf, b + 34)
    if n > 32 -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    ext_len := 0
    if ssl.in_hslen > hdr + 39 + n {
        ext_len = ssldefs.ssl_get_u16(ssl.in_buf, b + 38 + n)
        if (ext_len > 0 && ext_len < 4) || ssl.in_hslen != hdr + 40 + n + ext_len {
            return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
        }
    } else {
        if ssl.in_hslen != hdr + 38 + n -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    }
    i: ssldefs.ssl_get_u16(ssl.in_buf, b + 35 + n)
    if ssldefs.ssl_u8(ssl.in_buf, b + 37 + n) != ssldefs.SSL_COMPRESS_NULL {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_ILLEGAL_PARAMETER, .FeatureUnavailable, rng))
    }
    cs: suites.ssl_ciphersuite_from_id(i) ?? return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_INTERNAL_ERROR, .BadInputData, rng))
    ssltls.ssl_optimize_checksum(ssl, cs)
    ssl.handshake.ciphersuite_info = Val(cs)
    // Resume only the session we proposed, and never in a renegotiation.
    same_session: ssl.handshake.resume != 0 && n != 0 && ssl.renego_status == ssldefs.SSL_INITIAL_HANDSHAKE && ssl.spool[sn].ciphersuite == i && ssl.spool[sn].id.len() == n && ssldefs.ssl_range_eq(ssl.spool[sn].id, 0, ssl.in_buf, b + 35, n)
    if same_session {
        sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_SERVER_CHANGE_CIPHER_SPEC)
    } else {
        sslmsg.ssl_handshake_increment_state(ssl)
        ssl.handshake.resume = 0
        ssl.spool[sn].start = ssldefs.ssl_time()
        ssl.spool[sn].ciphersuite = i
        ssl.spool[sn].id = ssldefs.ssl_bytes_of(ssl.in_buf, b + 35, n)
    }
    // The ciphersuite must be one we offered and fit the version.
    offered := false
    loop id in ssl.conf.ciphersuite_list {
        if id == i -> offered = true
    }
    if !offered -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_ILLEGAL_PARAMETER, .IllegalParameter, rng))
    if !ssltls.ssl_validate_ciphersuite(ssl, suites.ssl_ciphersuite_from_id(i), ssl.tls_version, ssl.tls_version) {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE, .HandshakeFailure, rng))
    }
    ext := b + 40 + n
    renegotiation_info_seen := false
    loop ext_len > 0 {
        ext_id: ssldefs.ssl_get_u16(ssl.in_buf, ext)
        ext_size: ssldefs.ssl_get_u16(ssl.in_buf, ext + 2)
        if ext_size + 4 > ext_len -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
        data: ext + 4
        if ext_id == ssldefs.TLS_EXT_RENEGOTIATION_INFO {
            renegotiation_info_seen = true
            ssl_cli12_parse_renegotiation_info(ssl, data, ext_size, rng) ?? return Err(err)
        }
        if ext_id == ssldefs.TLS_EXT_MAX_FRAGMENT_LENGTH {
            ssl_cli12_parse_max_fragment_length_ext(ssl, data, ext_size, rng) ?? return Err(err)
        }
        if ext_id == ssldefs.TLS_EXT_CID {
            ssl_cli12_parse_cid_ext(ssl, data, ext_size, rng) ?? return Err(err)
        }
        if ext_id == ssldefs.TLS_EXT_ENCRYPT_THEN_MAC {
            ssl_cli12_parse_encrypt_then_mac_ext(ssl, ext_size, rng) ?? return Err(err)
        }
        if ext_id == ssldefs.TLS_EXT_EXTENDED_MASTER_SECRET {
            ssl_cli12_parse_extended_ms_ext(ssl, ext_size, rng) ?? return Err(err)
        }
        if ext_id == ssldefs.TLS_EXT_SESSION_TICKET {
            ssl_cli12_parse_session_ticket_ext(ssl, ext_size, rng) ?? return Err(err)
        }
        if ext_id == ssldefs.TLS_EXT_SUPPORTED_POINT_FORMATS {
            ssl_cli12_parse_supported_point_formats_ext(ssl, data, ext_size, rng) ?? return Err(err)
        }
        if ext_id == ssldefs.TLS_EXT_ALPN {
            ssl_cli12_parse_alpn_ext(ssl, data, ext_size, rng) ?? return Err(err)
        }
        // Other extensions are ignored.
        ext_len -= 4 + ext_size
        ext += 4 + ext_size
        if ext_len > 0 && ext_len < 4 -> return Err(.DecodeError)
    }
    // A resumed session's keys come after the extensions, which may carry
    // the server's DTLS CID.
    if ssl.handshake.resume != 0 {
        if ssltls.ssl_derive_keys(ssl) == {
            .Ok(_) -> {}
            .Err(e) -> {
                ssltls.ssl_send_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_INTERNAL_ERROR, rng)
                return Err(e)
            }
        }
    }
    // Renegotiation security (RFC 5746 3.4 and 3.5).
    legacy: ssl.secure_renegotiation == ssldefs.SSL_LEGACY_RENEGOTIATION
    secure: ssl.secure_renegotiation == ssldefs.SSL_SECURE_RENEGOTIATION
    in_progress: ssl.renego_status == ssldefs.SSL_RENEGOTIATION_IN_PROGRESS
    allow: ssl.conf.allow_legacy_renegotiation
    handshake_failure: (legacy && allow == ssldefs.SSL_LEGACY_BREAK_HANDSHAKE) || (in_progress && secure && !renegotiation_info_seen) || (in_progress && legacy && allow == ssldefs.SSL_LEGACY_NO_RENEGOTIATION) || (in_progress && legacy && renegotiation_info_seen)
    if handshake_failure -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE, .HandshakeFailure, rng))
}

// ---------------------------------------------------------------------------
// ServerKeyExchange.

// The server's DH parameters at in_buf[p..<end]; a prime under the
// configured minimum is a HandshakeFailure (ssl_parse_server_dh_params).
ssl_cli12_parse_server_dh_params: fn(ssl: &ssldefs.SSLContext, p: &Int, end: Int) ssldefs.SSLError! {
    ssltls.ssl_dhm_ready(ssl)
    data: ssldefs.ssl_bytes_of(ssl.in_buf, p, end - p)
    at := 0
    bitlen := if &ssl.handshake.dhm_ctx == {
        .Val(ctx) -> {
            dhm.dhm_read_params(ctx, data, at, data.len()) ?? return Err(.DHM(err))
            dhm.dhm_get_bitlen(ctx)
        }
        None -> return Err(.InternalError)
    }
    p += at
    if bitlen < ssl.conf.dhm_min_bitlen -> return Err(.HandshakeFailure)
}

// Whether the ECDH curve is one we offered (ssl_check_server_ecdh_params,
// true where C returns 0).
ssl_cli12_check_server_ecdh_params: fn(ssl: &ssldefs.SSLContext) -> Bool Never! {
    grp_id := ecp.GroupID.Unknown
    if &ssl.handshake.ecdh_ctx == {
        .Val(ctx) -> grp_id = ctx.grp_id
        None -> return false
    }
    if ssltls.ssl_get_tls_id_from_ecp_group_id(grp_id) == 0 -> return false
    ssltls.ssl_check_curve(ssl, grp_id)
}

// The server's ephemeral ECDH curve and point at in_buf[p..<end], on a
// curve we offered (ssl_parse_server_ecdh_params).
ssl_cli12_parse_server_ecdh_params: fn(ssl: &ssldefs.SSLContext, p: &Int, end: Int) ssldefs.SSLError! {
    ssltls.ssl_ecdh_ready(ssl)
    data: ssldefs.ssl_bytes_of(ssl.in_buf, p, end - p)
    used := if &ssl.handshake.ecdh_ctx == {
        .Val(ctx) -> ecdh.ecdh_read_params(ctx, data) ?? return Err(.ECP(err))
        None -> return Err(.InternalError)
    }
    p += used
    if !ssl_cli12_check_server_ecdh_params(ssl) -> return Err(.HandshakeFailure)
}

// Skip the server's PSK identity hint at in_buf[p..<end], which this side
// does not use (ssl_parse_server_psk_hint).
ssl_cli12_parse_server_psk_hint: fn(ssl: ssldefs.SSLContext, p: &Int, end: Int) ssldefs.SSLError! {
    if end - p < 2 -> return Err(.DecodeError)
    len: ssldefs.ssl_get_u16(ssl.in_buf, p)
    p += 2
    if end - p < len -> return Err(.DecodeError)
    p += len
}

// Encrypt a fresh premaster secret to the server's RSA key and write it at
// out_msg + offset with its length; the premaster goes at pms_offset
// (ssl_write_encrypted_pms, RFC 5246 7.4.7.1). Gives the bytes written.
ssl_cli12_write_encrypted_pms: fn<R: RNG>(ssl: &ssldefs.SSLContext, offset: Int, pms_offset: Int, rng: &R) -> Int ssldefs.SSLError! {
    if offset + 2 > ssldefs.SSL_OUT_CONTENT_LEN -> return Err(.BufferTooSmall)
    // The newest version we offered, then 46 random bytes.
    sslmsg.ssl_write_version(ssl.handshake.premaster, pms_offset, ssl.conf.transport, ssldefs.SSL_VERSION_TLS1_2)
    random := ssldefs.ssl_zeros(46)
    if !rng.fill(random) -> return Err(.RandomFailed)
    ssldefs.ssl_copy_into(ssl.handshake.premaster, pms_offset + 2, random, 0, 46)
    ssldefs.ssl_wipe(random)
    ssl.handshake.pmslen = 48
    if !ssltls.ssl_has_peer_cert(ssl) -> return Err(.InternalError)
    if !ssltls.ssl_peer_pk_can_do(ssl, .RSA) -> return Err(.PKTypeMismatch)
    plain := ssldefs.ssl_bytes_of(ssl.handshake.premaster, pms_offset, 48)
    sn: ssl.session_negotiate
    enc := if &ssl.spool[sn].peer_cert == {
        .Val(chain) -> {
            if pk.pk_encrypt(chain[0].pk, plain, ssldefs.SSL_OUT_CONTENT_LEN - offset - 2, rng) == {
                .Ok(e) -> e
                .Err(e) -> {
                    ssldefs.ssl_wipe(plain)
                    return Err(.PK(e))
                }
            }
        }
        None -> return Err(.InternalError)
    }
    ssldefs.ssl_wipe(plain)
    ssldefs.ssl_copy_into(ssl.out_buf, ssl.out_msg + offset + 2, enc, 0, enc.len())
    ssldefs.ssl_put_u16(ssl.out_buf, ssl.out_msg + offset, enc.len())
    Ok(enc.len() + 2)
}

// The static ECDH key of an ECDH_RSA or ECDH_ECDSA server, from its
// certificate (ssl_get_ecdh_params_from_cert).
ssl_cli12_get_ecdh_params_from_cert: fn(ssl: &ssldefs.SSLContext) ssldefs.SSLError! {
    if !ssltls.ssl_has_peer_cert(ssl) -> return Err(.InternalError)
    if !ssltls.ssl_peer_pk_can_do(ssl, .ECKey) -> return Err(.PKTypeMismatch)
    ssltls.ssl_ecdh_ready(ssl)
    sn: ssl.session_negotiate
    failure := if &ssl.handshake.ecdh_ctx == {
        .Val(ctx) -> {
            if ssl.spool[sn].peer_cert == {
                .Val(chain) -> ssltls.ssl_ecdh_get_params_failure(ctx, chain[0].pk.ec, .Theirs)
                None -> None
            }
        }
        None -> None
    }
    if failure == {
        .Val(e) -> return Err(.ECP(e))
        None -> {}
    }
    if !ssl_cli12_check_server_ecdh_params(ssl) -> return Err(.BadCertificate)
}

// The key and digest of the server's signature algorithm: one this
// version supports (or an rsa_pss_rsae one, RFC 8446 4.2.3) that we
// offered; None for an illegal_parameter alert (ssl_parse_signature_algorithm).
ssl_cli12_parse_signature_algorithm: fn(ssl: ssldefs.SSLContext, sig_alg: Int) -> ssltls.SSLSigAlgParts? Never! {
    parts := if ssltls.ssl_get_pk_type_and_md_alg_from_sig_alg(sig_alg) == {
        .Ok(found) -> found
        .Err(_) -> return None
    }
    if !ssltls.ssl_sig_alg_is_supported(ssl, sig_alg) {
        pss_rsae: sig_alg == ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA256 || sig_alg == ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA384 || sig_alg == ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA512
        if !pss_rsae -> return None
    }
    if !ssltls.ssl_sig_alg_is_offered(ssl, sig_alg) -> return None
    Val(parts)
}

// Verify the server's signature over the key exchange hash; the error when
// it does not verify.
ssl_cli12_verify_signature: fn(key: &pk.PKContext, parts: ssltls.SSLSigAlgParts, hash: [U8], sig: [U8]) -> pk.PKError? Never! {
    if parts.pk_type == .RSASSAPSS {
        if pk.pk_verify_ext(parts.pk_type, gen13.ssl_tls13_pss_options(parts.pk_type, parts.md_alg), key, Val(parts.md_alg), hash, sig) == {
            .Ok(_) -> return None
            .Err(e) -> return Val(e)
        }
    }
    if pk.pk_verify(key, Val(parts.md_alg), hash, sig) == {
        .Ok(_) -> None
        .Err(e) -> Val(e)
    }
}

// Read the ServerKeyExchange: the PSK hint, the DH or ECDH parameters and
// the server's signature over them, as the key exchange has them. RSA
// has none and ECDH takes the certificate's key; PSK and RSA-PSK servers
// may leave it out (ssl_parse_server_key_exchange, RFC 5246 7.4.3).
ssl_cli12_parse_server_key_exchange: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    cs: ssl.handshake.ciphersuite_info ?? return Err(.InternalError)
    kx: cs.key_exchange
    if kx == .RSA {
        sslmsg.ssl_handshake_increment_state(ssl)
        return
    }
    if kx == .ECDHRSA || kx == .ECDHECDSA {
        if ssl_cli12_get_ecdh_params_from_cert(ssl) == {
            .Ok(_) -> {}
            .Err(e) -> {
                ssltls.ssl_send_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE, rng)
                return Err(e)
            }
        }
        sslmsg.ssl_handshake_increment_state(ssl)
        return
    }
    sslmsg.ssl_read_record(ssl, true, rng) ?? return Err(err)
    if ssl.in_msgtype != ssldefs.SSL_MSG_HANDSHAKE {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_UNEXPECTED_MESSAGE, .UnexpectedMessage, rng))
    }
    if ssldefs.ssl_u8(ssl.in_buf, ssl.in_msg) != ssldefs.SSL_HS_SERVER_KEY_EXCHANGE {
        if kx == .PSK || kx == .RSAPSK {
            // Without a hint the CertificateRequest or ServerHelloDone
            // comes now.
            ssl.keep_current_message = 1
            sslmsg.ssl_handshake_increment_state(ssl)
            return
        }
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_UNEXPECTED_MESSAGE, .UnexpectedMessage, rng))
    }
    params: ssl.in_msg + sslmsg.ssl_hs_hdr_len(ssl)
    p := params
    end: ssl.in_msg + ssl.in_hslen
    psk_only: kx == .PSK || kx == .RSAPSK
    dhe: kx == .DHERSA || kx == .DHEPSK
    ecdhe: kx == .ECDHERSA || kx == .ECDHEPSK || kx == .ECDHEECDSA
    if psk_only || kx == .DHEPSK || kx == .ECDHEPSK {
        if ssl_cli12_parse_server_psk_hint(ssl, p, end) == {
            .Ok(_) -> {}
            .Err(_) -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
        }
    }
    if !psk_only && !dhe && !ecdhe -> return Err(.InternalError)
    if dhe {
        if ssl_cli12_parse_server_dh_params(ssl, p, end) == {
            .Ok(_) -> {}
            .Err(_) -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_ILLEGAL_PARAMETER, .IllegalParameter, rng))
        }
    }
    if ecdhe {
        if ssl_cli12_parse_server_ecdh_params(ssl, p, end) == {
            .Ok(_) -> {}
            .Err(_) -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_ILLEGAL_PARAMETER, .IllegalParameter, rng))
        }
    }
    if suites.ssl_ciphersuite_uses_server_signature(cs) {
        params_len: p - params
        if !ssltls.ssl_has_peer_cert(ssl) -> return Err(.InternalError)
        // The digitally-signed structure: the algorithm, then the signature.
        ssltls.ssl_chk_buf_read(ssl, p, end, 2) ?? return Err(err)
        sig_alg: ssldefs.ssl_get_u16(ssl.in_buf, p)
        parts := ssl_cli12_parse_signature_algorithm(ssl, sig_alg) ?? return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_ILLEGAL_PARAMETER, .IllegalParameter, rng))
        p += 2
        if !ssltls.ssl_peer_pk_can_do(ssl, parts.pk_type) {
            return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_ILLEGAL_PARAMETER, .IllegalParameter, rng))
        }
        if p > end - 2 -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
        sig_len: ssldefs.ssl_get_u16(ssl.in_buf, p)
        p += 2
        if p != end - sig_len -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
        hash: ssltls.ssl_get_key_exchange_md_tls1_2(ssl, ssl.in_buf, params, params_len, parts.md_alg)
        if !ssltls.ssl_peer_pk_can_do(ssl, parts.pk_type) {
            return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE, .PKTypeMismatch, rng))
        }
        sig: ssldefs.ssl_bytes_of(ssl.in_buf, p, sig_len)
        sn: ssl.session_negotiate
        failure := if &ssl.spool[sn].peer_cert == {
            .Val(chain) -> ssl_cli12_verify_signature(chain[0].pk, parts, hash, sig)
            None -> return Err(.InternalError)
        }
        if failure == {
            .Val(e) -> {
                ssltls.ssl_send_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_DECRYPT_ERROR, rng)
                return Err(.PK(e))
            }
            None -> {}
        }
    }
    sslmsg.ssl_handshake_increment_state(ssl)
}

// ---------------------------------------------------------------------------
// CertificateRequest and ServerHelloDone.

// Whether in_buf[start..<end] starts with a well-formed DER Name.
ssl_cli12_dn_hint_is_name: fn(data: [U8], start: Int, end: Int) -> Bool Never! {
    p := start
    asn1_len := if asn1.get_tag(data, p, end, asn1.ASN1_CONSTRUCTED.bit_or(asn1.ASN1_SEQUENCE)) == {
        .Ok(len) -> len
        .Err(_) -> return false
    }
    if x509.x509_get_name(data, p, p + asn1_len) == {
        .Ok(_) -> true
        .Err(_) -> false
    }
}

// Read a CertificateRequest if the server sent one, and check its layout:
// the certificate types, signature algorithms and distinguished names
// (ssl_parse_certificate_request, RFC 5246 7.4.4). This side answers with
// its own certificate whatever the request lists.
ssl_cli12_parse_certificate_request: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    cs: ssl.handshake.ciphersuite_info ?? return Err(.InternalError)
    if !suites.ssl_ciphersuite_cert_req_allowed(cs) {
        sslmsg.ssl_handshake_increment_state(ssl)
        return
    }
    sslmsg.ssl_read_record(ssl, true, rng) ?? return Err(err)
    if ssl.in_msgtype != ssldefs.SSL_MSG_HANDSHAKE {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_UNEXPECTED_MESSAGE, .UnexpectedMessage, rng))
    }
    sslmsg.ssl_handshake_increment_state(ssl)
    buf: ssl.in_msg
    ssl.handshake.client_auth = if ssldefs.ssl_u8(ssl.in_buf, buf) == ssldefs.SSL_HS_CERTIFICATE_REQUEST -> 1 else -> 0
    if ssl.handshake.client_auth == 0 {
        // The message is the ServerHelloDone.
        ssl.keep_current_message = 1
        return
    }
    hdr: sslmsg.ssl_hs_hdr_len(ssl)
    if ssl.in_hslen <= hdr -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    // certificate_types, then supported_signature_algorithms.
    n := ssldefs.ssl_u8(ssl.in_buf, buf + hdr)
    if ssl.in_hslen <= hdr + 2 + n -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    sig_alg_len: ssldefs.ssl_get_u16(ssl.in_buf, buf + hdr + 1 + n)
    if ssl.in_hslen <= hdr + 3 + n + sig_alg_len -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    n += 2 + sig_alg_len
    // certificate_authorities, which end the message.
    dn_len: ssldefs.ssl_get_u16(ssl.in_buf, buf + hdr + 1 + n)
    n += dn_len
    if ssl.in_hslen != hdr + 3 + n -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    dn: buf + hdr + 3 + n - dn_len
    i := 0
    loop i < dn_len {
        if dn_len - i < 2 -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
        dni_len: ssldefs.ssl_get_u16(ssl.in_buf, dn + i)
        if dni_len > dn_len - i - 2 || !ssl_cli12_dn_hint_is_name(ssl.in_buf, dn + i + 2, dn + i + 2 + dni_len) {
            return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
        }
        i += 2 + dni_len
    }
}

// Read the empty ServerHelloDone (ssl_parse_server_hello_done); in DTLS
// the server's flight is then complete.
ssl_cli12_parse_server_hello_done: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    sslmsg.ssl_read_record(ssl, true, rng) ?? return Err(err)
    if ssl.in_msgtype != ssldefs.SSL_MSG_HANDSHAKE -> return Err(.UnexpectedMessage)
    if ssl.in_hslen != sslmsg.ssl_hs_hdr_len(ssl) || ssldefs.ssl_u8(ssl.in_buf, ssl.in_msg) != ssldefs.SSL_HS_SERVER_HELLO_DONE {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    }
    sslmsg.ssl_handshake_increment_state(ssl)
    if sslmsg.ssl_is_dtls(ssl) -> sslmsg.ssl_recv_flight_completed(ssl)
}

// ---------------------------------------------------------------------------
// ClientKeyExchange and CertificateVerify.

// Write the ClientKeyExchange: our DH or ECDH public value, the PSK
// identity, or the RSA-encrypted premaster secret, as the key exchange
// has it, and compute the premaster secret (ssl_write_client_key_exchange,
// RFC 5246 7.4.7, RFC 4279 2, RFC 4492 5.7).
ssl_cli12_write_client_key_exchange: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    cs: ssl.handshake.ciphersuite_info ?? return Err(.InternalError)
    kx: cs.key_exchange
    out: ssl.out_msg
    header_len := 0
    content_len := 0
    if kx == {
        .DHERSA -> {
            ssltls.ssl_dhm_ready(ssl)
            public := if &ssl.handshake.dhm_ctx == {
                .Val(ctx) -> {
                    size: dhm.dhm_get_len(ctx)
                    dhm.dhm_make_public(ctx, size, size, rng) ?? return Err(.DHM(err))
                }
                None -> return Err(.InternalError)
            }
            content_len = public.len()
            ssldefs.ssl_put_u16(ssl.out_buf, out + 4, content_len)
            header_len = 6
            ssldefs.ssl_copy_into(ssl.out_buf, out + header_len, public, 0, content_len)
            secret := if &ssl.handshake.dhm_ctx == {
                .Val(ctx) -> {
                    // The premaster buffer must hold a value as long as p.
                    if dhm.dhm_get_len(ctx) > ssldefs.SSL_PREMASTER_SIZE -> return Err(.DHM(.BadInput))
                    dhm.dhm_calc_secret(ctx, rng) ?? return Err(.DHM(err))
                }
                None -> return Err(.InternalError)
            }
            ssltls.ssl_set_premaster(ssl, secret)
        }
        .ECDHERSA | .ECDHEECDSA | .ECDHRSA | .ECDHECDSA -> {
            header_len = 4
            ssltls.ssl_ecdh_ready(ssl)
            public := if &ssl.handshake.ecdh_ctx == {
                .Val(ctx) -> ecdh.ecdh_make_public(ctx, 1000, rng) ?? return Err(.ECP(err))
                None -> return Err(.InternalError)
            }
            content_len = public.len()
            ssldefs.ssl_copy_into(ssl.out_buf, out + header_len, public, 0, content_len)
            secret := if &ssl.handshake.ecdh_ctx == {
                .Val(ctx) -> ecdh.ecdh_calc_secret(ctx, ssldefs.SSL_PREMASTER_SIZE, rng) ?? return Err(.ECP(err))
                None -> return Err(.InternalError)
            }
            ssltls.ssl_set_premaster(ssl, secret)
        }
        .PSK | .RSAPSK | .DHEPSK | .ECDHEPSK -> {
            // We offer PSK ciphersuites only with a PSK.
            if !ssltls.ssl_conf_has_static_psk(ssl.conf) -> return Err(.InternalError)
            identity := if ssl.conf.psk_identity == {
                .Val(id) -> id.copy()
                None -> return Err(.InternalError)
            }
            header_len = 4
            content_len = identity.len()
            if header_len + 2 + content_len > ssldefs.SSL_OUT_CONTENT_LEN -> return Err(.BufferTooSmall)
            ssldefs.ssl_put_u16(ssl.out_buf, out + header_len, content_len)
            header_len += 2
            ssldefs.ssl_copy_into(ssl.out_buf, out + header_len, identity, 0, identity.len())
            header_len += identity.len()
            if kx == {
                .PSK -> content_len = 0
                .RSAPSK -> content_len = ssl_cli12_write_encrypted_pms(ssl, header_len, 2, rng) ?? return Err(err)
                .DHEPSK -> {
                    ssltls.ssl_dhm_ready(ssl)
                    size := 0
                    if &ssl.handshake.dhm_ctx == {
                        .Val(ctx) -> size = dhm.dhm_get_len(ctx)
                        None -> {}
                    }
                    content_len = size
                    if header_len + 2 + content_len > ssldefs.SSL_OUT_CONTENT_LEN -> return Err(.BufferTooSmall)
                    ssldefs.ssl_put_u16(ssl.out_buf, out + header_len, content_len)
                    header_len += 2
                    public := if &ssl.handshake.dhm_ctx == {
                        .Val(ctx) -> dhm.dhm_make_public(ctx, size, size, rng) ?? return Err(.DHM(err))
                        None -> return Err(.InternalError)
                    }
                    ssldefs.ssl_copy_into(ssl.out_buf, out + header_len, public, 0, public.len())
                }
                .NoExchange | .RSA | .DHERSA | .ECDHERSA | .ECDHEECDSA | .ECDHEPSK | .ECDHRSA | .ECDHECDSA -> {
                    ssltls.ssl_ecdh_ready(ssl)
                    public := if &ssl.handshake.ecdh_ctx == {
                        .Val(ctx) -> ecdh.ecdh_make_public(ctx, ssldefs.SSL_OUT_CONTENT_LEN - header_len, rng) ?? return Err(.ECP(err))
                        None -> return Err(.InternalError)
                    }
                    content_len = public.len()
                    ssldefs.ssl_copy_into(ssl.out_buf, out + header_len, public, 0, content_len)
                }
            }
            ssltls.ssl_psk_derive_premaster(ssl, kx, rng) ?? return Err(err)
        }
        .RSA -> {
            header_len = 4
            content_len = ssl_cli12_write_encrypted_pms(ssl, header_len, 0, rng) ?? return Err(err)
        }
        .NoExchange -> return Err(.InternalError)
    }
    ssl.out_msglen = header_len + content_len
    ssl.out_msgtype = ssldefs.SSL_MSG_HANDSHAKE
    ssl.out_buf[out] = ssldefs.ssl_byte(ssldefs.SSL_HS_CLIENT_KEY_EXCHANGE)
    sslmsg.ssl_handshake_increment_state(ssl)
    sslmsg.ssl_write_handshake_msg(ssl, rng) ?? return Err(err)
}

// Derive the keys, then sign the transcript with our key if the server
// asked for a certificate and we sent one (ssl_write_certificate_verify,
// RFC 5246 7.4.8). The digest is the PRF's, which the server is assumed to
// accept, as C does.
ssl_cli12_write_certificate_verify: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    ssltls.ssl_derive_keys(ssl) ?? return Err(err)
    cs: ssl.handshake.ciphersuite_info ?? return Err(.InternalError)
    if !suites.ssl_ciphersuite_cert_req_allowed(cs) || ssl.handshake.client_auth == 0 || ssltls.ssl_own_key_cert(ssl) < 0 {
        sslmsg.ssl_handshake_increment_state(ssl)
        return
    }
    hash := ssltls.ssl_calc_verify(ssl) ?? return Err(err)
    out: ssl.out_msg
    md: if cs.mac == .SHA384 -> hashes.Md.SHA384 else -> hashes.Md.SHA256
    ssl.out_buf[out + 4] = ssldefs.ssl_byte(ssltls.ssl_hash_from_md_alg(Val(md)))
    ssl.out_buf[out + 5] = ssldefs.ssl_byte(ssltls.ssl_sig_from_pk_alg(ssltls.ssl_own_key_type(ssl)))
    // The hash and signature bytes come first.
    offset: 2
    sig := ssltls.ssl_own_key_sign(ssl, Val(md), hash, ssldefs.SSL_OUT_BUFFER_LEN - out - 6 - offset, rng) ?? return Err(.PK(err))
    ssldefs.ssl_copy_into(ssl.out_buf, out + 6 + offset, sig, 0, sig.len())
    ssldefs.ssl_put_u16(ssl.out_buf, out + offset + 4, sig.len())
    ssl.out_msglen = 6 + sig.len() + offset
    ssl.out_msgtype = ssldefs.SSL_MSG_HANDSHAKE
    ssl.out_buf[out] = ssldefs.ssl_byte(ssldefs.SSL_HS_CERTIFICATE_VERIFY)
    sslmsg.ssl_handshake_increment_state(ssl)
    sslmsg.ssl_write_handshake_msg(ssl, rng) ?? return Err(err)
}

// ---------------------------------------------------------------------------
// NewSessionTicket and the state machine.

// Wipe and forget a session's ticket.
ssl_cli12_drop_ticket: fn(s: &ssldefs.SSLSession) Never! {
    if &s.ticket == {
        .Val(t) -> ssldefs.ssl_wipe(t)
        None -> {}
    }
    s.ticket = None
}

// Read a NewSessionTicket and keep its ticket for the session; an empty
// ticket is none (ssl_parse_new_session_ticket, RFC 5077 3.3).
ssl_cli12_parse_new_session_ticket: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    sslmsg.ssl_read_record(ssl, true, rng) ?? return Err(err)
    if ssl.in_msgtype != ssldefs.SSL_MSG_HANDSHAKE {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_UNEXPECTED_MESSAGE, .UnexpectedMessage, rng))
    }
    hdr: sslmsg.ssl_hs_hdr_len(ssl)
    // The lifetime hint, then the ticket with its length.
    if ssldefs.ssl_u8(ssl.in_buf, ssl.in_msg) != ssldefs.SSL_HS_NEW_SESSION_TICKET || ssl.in_hslen < 6 + hdr {
        return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    }
    msg: ssl.in_msg + hdr
    lifetime: ssldefs.ssl_get_u32(ssl.in_buf, msg)
    ticket_len: ssldefs.ssl_get_u16(ssl.in_buf, msg + 4)
    if ticket_len + 6 + hdr != ssl.in_hslen -> return Err(ssl_cli12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    ssl.handshake.new_session_ticket = 0
    sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_SERVER_CHANGE_CIPHER_SPEC)
    // The server changed its mind.
    if ticket_len == 0 -> return
    if ssl.session >= 0 -> ssl_cli12_drop_ticket(ssl.spool[ssl.session])
    sn: ssl.session_negotiate
    ssl_cli12_drop_ticket(ssl.spool[sn])
    ssl.spool[sn].ticket = Val(ssldefs.ssl_bytes_of(ssl.in_buf, msg + 6, ticket_len))
    ssl.spool[sn].ticket_lifetime = lifetime
    // A ticket replaces the ServerHello's session ID (RFC 5077 3.4).
    ssl.spool[sn].id = [U8]{}
}

/// Take one step of the TLS 1.2 client handshake
/// (mbedtls_ssl_handshake_client_step).
ssl_handshake_client_step: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    // Change state now, so that mbedtls_ssl_read_record sees it when DTLS
    // drops an out-of-sequence ChangeCipherSpec.
    if ssl.state == ssldefs.SSL_SERVER_CHANGE_CIPHER_SPEC && ssl.handshake.new_session_ticket != 0 {
        sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_NEW_SESSION_TICKET)
    }
    state: ssl.state
    if state == ssldefs.SSL_HELLO_REQUEST {
        sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_CLIENT_HELLO)
        return
    }
    if state == ssldefs.SSL_CLIENT_HELLO -> return sslcli.ssl_write_client_hello(ssl, rng)
    if state == ssldefs.SSL_SERVER_HELLO -> return ssl_cli12_parse_server_hello(ssl, rng)
    if state == ssldefs.SSL_SERVER_CERTIFICATE -> return ssltls.ssl_parse_certificate(ssl, rng)
    if state == ssldefs.SSL_SERVER_KEY_EXCHANGE -> return ssl_cli12_parse_server_key_exchange(ssl, rng)
    if state == ssldefs.SSL_CERTIFICATE_REQUEST -> return ssl_cli12_parse_certificate_request(ssl, rng)
    if state == ssldefs.SSL_SERVER_HELLO_DONE -> return ssl_cli12_parse_server_hello_done(ssl, rng)
    if state == ssldefs.SSL_CLIENT_CERTIFICATE -> return ssltls.ssl_write_certificate(ssl, rng)
    if state == ssldefs.SSL_CLIENT_KEY_EXCHANGE -> return ssl_cli12_write_client_key_exchange(ssl, rng)
    if state == ssldefs.SSL_CERTIFICATE_VERIFY -> return ssl_cli12_write_certificate_verify(ssl, rng)
    if state == ssldefs.SSL_CLIENT_CHANGE_CIPHER_SPEC -> return sslmsg.ssl_write_change_cipher_spec(ssl, rng)
    if state == ssldefs.SSL_CLIENT_FINISHED -> return ssltls.ssl_write_finished(ssl, rng)
    if state == ssldefs.SSL_NEW_SESSION_TICKET -> return ssl_cli12_parse_new_session_ticket(ssl, rng)
    if state == ssldefs.SSL_SERVER_CHANGE_CIPHER_SPEC -> return sslmsg.ssl_parse_change_cipher_spec(ssl, rng)
    if state == ssldefs.SSL_SERVER_FINISHED -> return ssltls.ssl_parse_finished(ssl, rng)
    if state == ssldefs.SSL_FLUSH_BUFFERS {
        sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_HANDSHAKE_WRAPUP)
        return
    }
    if state == ssldefs.SSL_HANDSHAKE_WRAPUP {
        ssltls.ssl_handshake_wrapup(ssl)
        return
    }
    Err(.BadInputData)
}
