// SPDX-License-Identifier: Apache-2.0
// Translated from Mbed TLS 3.6.7 (library/ssl_tls.c); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: session and context serialization.
//
// A port of mbedtls 3.6.7's session and context serialization in
// ssl_tls.c under the default mbedtls_config.h: ssl_tls12_session_save and
// _load, ssl_tls13_session_save and _load, ssl_session_save and _load with
// their public wrappers, and mbedtls_ssl_context_save and _load. The bytes
// are those mbedtls 3.6.7 writes under the default configuration, so either
// side reads what the other wrote.
//
// C writes into a caller's buffer and reports the length it needs, with
// BUFFER_TOO_SMALL when the buffer is short; here a save returns the bytes,
// and a caller with limited room (a ticket writer) checks they fit. Loads
// take the buffer with the offset and length of the serialized data in it.
use {
    core
    hashes: __core_crypto_md
    x509crt: __core_crypto_x509crt
    ssldefs: __core_net_ssl_defs
    suites: __core_net_ssl_ciphersuites
    sslmsg: __core_net_ssl_msg
    ssltls: __core_net_ssl_tls
}

// MBEDTLS_VERSION_MAJOR, _MINOR, _PATCH (build_info.h).
SSL_SER_VERSION_MAJOR: 3
SSL_SER_VERSION_MINOR: 6
SSL_SER_VERSION_PATCH: 7

// SSL_SERIALIZED_SESSION_CONFIG_BITFLAG under the default configuration:
// HAVE_TIME (bit 0), X509_CRT_PARSE_C (1), client tickets (2),
// MAX_FRAGMENT_LENGTH (3), ENCRYPT_THEN_MAC (4), SESSION_TICKETS (5),
// KEEP_PEER_CERTIFICATE (6) and SERVER_NAME_INDICATION (7); EARLY_DATA (8),
// RECORD_SIZE_LIMIT (9) and the early-data ALPN (10) are off.
SSL_SERIALIZED_SESSION_CONFIG_BITFLAG: 0x00FF

// SSL_SERIALIZED_CONTEXT_CONFIG_BITFLAG under the default configuration:
// DTLS_CONNECTION_ID (bit 0), the bad-MAC limit (1), DTLS_ANTI_REPLAY (2)
// and ALPN (3).
SSL_SERIALIZED_CONTEXT_CONFIG_BITFLAG: 0x0F

// The length of a transform's randbytes, ServerHello.random followed by
// ClientHello.random (sizeof(transform->randbytes)).
SSL_SER_RANDBYTES_LEN: 64

/// The version and format bytes that start a serialized session
/// (ssl_serialized_session_header).
ssl_serialized_session_header: fn() -> [U8] Never! {
    [U8]{
        ssldefs.ssl_byte(SSL_SER_VERSION_MAJOR), ssldefs.ssl_byte(SSL_SER_VERSION_MINOR), ssldefs.ssl_byte(SSL_SER_VERSION_PATCH),
        ssldefs.ssl_byte(SSL_SERIALIZED_SESSION_CONFIG_BITFLAG >> 8), ssldefs.ssl_byte(SSL_SERIALIZED_SESSION_CONFIG_BITFLAG)
    }
}

/// The version and format bytes that start a serialized context
/// (ssl_serialized_context_header).
ssl_serialized_context_header: fn() -> [U8] Never! {
    header := ssl_serialized_session_header()
    header.push(ssldefs.ssl_byte(SSL_SERIALIZED_CONTEXT_CONFIG_BITFLAG >> 16))
    header.push(ssldefs.ssl_byte(SSL_SERIALIZED_CONTEXT_CONFIG_BITFLAG >> 8))
    header.push(ssldefs.ssl_byte(SSL_SERIALIZED_CONTEXT_CONFIG_BITFLAG))
    header
}

// `src` then zeros up to `n` bytes: C's fixed-size arrays (id[32],
// master[48], randbytes[64]) copied whole.
ssl_ser_push_fixed: fn(out: &[U8], src: [U8], n: Int) Never! {
    loop i in 0..<n {
        b: if i < src.len() -> src[i] else -> U8{0}
        out.push(b)
    }
}

// A big-endian 64-bit time read as C's (mbedtls_time_t) cast of the
// uint64_t reads it: two's complement, without overflowing Int.
ssl_ser_get_time: fn(buf: [U8], off: Int) -> Int Never! {
    hi: ssldefs.ssl_get_u32(buf, off)
    lo: ssldefs.ssl_get_u32(buf, off + 4)
    if hi >= 0x80000000 -> return (hi - 0x100000000) * 0x100000000 + lo
    hi * 0x100000000 + lo
}

// MBEDTLS_PUT_UINT64_BE of a U64 counter.
ssl_ser_push_u64: fn(out: &[U8], v: U64) Never! {
    loop i in 0..<8 {
        out.push(ssldefs.ssl_byte(Int{(v >> (56 - 8 * i)).bit_and(U64{0xFF})}))
    }
}

// MBEDTLS_GET_UINT64_BE into a U64 counter.
ssl_ser_get_u64: fn(buf: [U8], off: Int) -> U64 Never! {
    v := U64{0}
    loop i in 0..<8 {
        v = (v << 8).bit_or(U64{Int{buf[off + i]}})
    }
    v
}

/// Free a session's state (mbedtls_ssl_session_free): its secrets are
/// wiped and its fields cleared. A pool slot stays allocated, as C's
/// session struct does.
ssl_ser_session_free: fn(session: &ssldefs.SSLSession) Never! {
    valid: session.valid
    ssldefs.ssl_session_wipe(session)
    session = ssldefs.SSLSession{valid: valid}
}

// ---------------------------------------------------------------------------
// TLS 1.2 sessions.

/// Append a TLS 1.2 session (ssl_tls12_session_save): the start time, the
/// ID, master secret and verification result, the peer's end-entity
/// certificate, the client's ticket and its lifetime or the server's
/// ticket creation time, then the max_fragment_length code and the
/// encrypt-then-MAC flag.
ssl_tls12_session_save: fn(session: ssldefs.SSLSession, out: &[U8]) Never! {
    ssldefs.ssl_push_u64(out, session.start)
    out.push(ssldefs.ssl_byte(session.id.len()))
    ssl_ser_push_fixed(out, session.id, 32)
    ssl_ser_push_fixed(out, session.master, 48)
    ssldefs.ssl_push_u32(out, session.verify_result)
    // C keeps the end-entity certificate alone (peer_cert->raw).
    cert_len := 0
    if session.peer_cert == {
        .Val(chain) -> { if chain.len() > 0 -> cert_len = chain[0].raw.len() }
        None -> {}
    }
    ssldefs.ssl_push_u24(out, cert_len)
    if cert_len > 0 {
        if session.peer_cert == {
            .Val(chain) -> ssldefs.ssl_push_all(out, chain[0].raw)
            None -> {}
        }
    }
    if session.endpoint == ssldefs.SSL_IS_CLIENT {
        if session.ticket == {
            .Val(ticket) -> {
                ssldefs.ssl_push_u24(out, ticket.len())
                ssldefs.ssl_push_all(out, ticket)
            }
            None -> ssldefs.ssl_push_u24(out, 0)
        }
        ssldefs.ssl_push_u32(out, session.ticket_lifetime)
    }
    if session.endpoint == ssldefs.SSL_IS_SERVER -> ssldefs.ssl_push_u64(out, session.ticket_creation_time)
    out.push(ssldefs.ssl_byte(session.mfl_code))
    out.push(ssldefs.ssl_byte(session.encrypt_then_mac))
}

/// Read a TLS 1.2 session from buf[start..<start+len]
/// (ssl_tls12_session_load); the data must fill it exactly. The endpoint
/// is already read.
ssl_tls12_session_load: fn(session: &ssldefs.SSLSession, buf: [U8], start: Int, len: Int) ssldefs.SSLError! {
    p := start
    end: start + len
    if 8 > end - p -> return Err(.BadInputData)
    session.start = ssl_ser_get_time(buf, p)
    p += 8
    if 1 + 32 + 48 + 4 > end - p -> return Err(.BadInputData)
    id_len: ssldefs.ssl_u8(buf, p)
    p += 1
    // C keeps an id_len over 32 beside its 32 bytes, and reads past them
    // when it uses one; such data was not written by a save.
    if id_len > 32 -> return Err(.BadInputData)
    session.id = ssldefs.ssl_bytes_of(buf, p, id_len)
    p += 32
    ssldefs.ssl_wipe(session.master)
    session.master = ssldefs.ssl_bytes_of(buf, p, 48)
    p += 48
    session.verify_result = ssldefs.ssl_get_u32(buf, p)
    p += 4
    // What was read before is not this session's.
    session.peer_cert = None
    session.ticket = None
    // The peer's end-entity certificate.
    if 3 > end - p -> return Err(.BadInputData)
    cert_len: ssldefs.ssl_get_u24(buf, p)
    p += 3
    if cert_len != 0 {
        if cert_len > end - p -> return Err(.BadInputData)
        peer := [x509crt.X509Crt]{}
        x509crt.x509_crt_parse_der(peer, ssldefs.ssl_bytes_of(buf, p, cert_len)) ?? return Err(.X509(err))
        session.peer_cert = Val(peer)
        p += cert_len
    }
    if session.endpoint == ssldefs.SSL_IS_CLIENT {
        if 3 > end - p -> return Err(.BadInputData)
        ticket_len: ssldefs.ssl_get_u24(buf, p)
        p += 3
        if ticket_len != 0 {
            if ticket_len > end - p -> return Err(.BadInputData)
            session.ticket = Val(ssldefs.ssl_bytes_of(buf, p, ticket_len))
            p += ticket_len
        }
        if 4 > end - p -> return Err(.BadInputData)
        session.ticket_lifetime = ssldefs.ssl_get_u32(buf, p)
        p += 4
    }
    if session.endpoint == ssldefs.SSL_IS_SERVER {
        if 8 > end - p -> return Err(.BadInputData)
        session.ticket_creation_time = ssl_ser_get_time(buf, p)
        p += 8
    }
    if 1 > end - p -> return Err(.BadInputData)
    session.mfl_code = ssldefs.ssl_u8(buf, p)
    p += 1
    if 1 > end - p -> return Err(.BadInputData)
    session.encrypt_then_mac = ssldefs.ssl_u8(buf, p)
    p += 1
    if p != end -> return Err(.BadInputData)
}

// ---------------------------------------------------------------------------
// TLS 1.3 sessions.

/// Append a TLS 1.3 session (ssl_tls13_session_save): the ticket's age
/// add and flags and the resumption key, then the server's ticket creation
/// time, or the client's host name, ticket reception time, lifetime and
/// ticket. A resumption key over 48 bytes is BAD_INPUT_DATA.
ssl_tls13_session_save: fn(session: ssldefs.SSLSession, out: &[U8]) ssldefs.SSLError! {
    if session.resumption_key.len() > ssldefs.SSL_TLS1_3_TICKET_RESUMPTION_KEY_LEN -> return Err(.BadInputData)
    ssldefs.ssl_push_u32(out, session.ticket_age_add)
    out.push(ssldefs.ssl_byte(session.ticket_flags))
    out.push(ssldefs.ssl_byte(session.resumption_key.len()))
    ssldefs.ssl_push_all(out, session.resumption_key)
    if session.endpoint == ssldefs.SSL_IS_SERVER -> ssldefs.ssl_push_u64(out, session.ticket_creation_time)
    if session.endpoint == ssldefs.SSL_IS_CLIENT {
        // The host name with C's terminating NUL, or nothing.
        if session.hostname == {
            .Val(hostname) -> {
                name: hostname.bytes()
                ssldefs.ssl_push_u16(out, name.len() + 1)
                ssldefs.ssl_push_all(out, name)
                out.push(U8{0})
            }
            None -> ssldefs.ssl_push_u16(out, 0)
        }
        ssldefs.ssl_push_u64(out, session.ticket_reception_time)
        ssldefs.ssl_push_u32(out, session.ticket_lifetime)
        if session.ticket == {
            .Val(ticket) -> {
                ssldefs.ssl_push_u16(out, ticket.len())
                ssldefs.ssl_push_all(out, ticket)
            }
            None -> ssldefs.ssl_push_u16(out, 0)
        }
    }
}

/// Read a TLS 1.3 session from buf[start..<start+len]
/// (ssl_tls13_session_load); the data must fill it exactly. The endpoint
/// is already read.
ssl_tls13_session_load: fn(session: &ssldefs.SSLSession, buf: [U8], start: Int, len: Int) ssldefs.SSLError! {
    p := start
    end: start + len
    if end - p < 6 -> return Err(.BadInputData)
    session.ticket_age_add = ssldefs.ssl_get_u32(buf, p)
    session.ticket_flags = ssldefs.ssl_u8(buf, p + 4)
    resumption_key_len: ssldefs.ssl_u8(buf, p + 5)
    p += 6
    if end - p < resumption_key_len -> return Err(.BadInputData)
    if resumption_key_len > ssldefs.SSL_TLS1_3_TICKET_RESUMPTION_KEY_LEN -> return Err(.BadInputData)
    ssldefs.ssl_wipe(session.resumption_key)
    session.resumption_key = ssldefs.ssl_bytes_of(buf, p, resumption_key_len)
    p += resumption_key_len
    if session.endpoint == ssldefs.SSL_IS_SERVER {
        if end - p < 8 -> return Err(.BadInputData)
        session.ticket_creation_time = ssl_ser_get_time(buf, p)
        p += 8
    }
    if session.endpoint == ssldefs.SSL_IS_CLIENT {
        if end - p < 2 -> return Err(.BadInputData)
        hostname_len: ssldefs.ssl_get_u16(buf, p)
        p += 2
        if end - p < hostname_len -> return Err(.BadInputData)
        if hostname_len > 0 {
            // It is used as a NUL-terminated string, so it must be one.
            if buf[p + hostname_len - 1] != (U8{0}) -> return Err(.BadInputData)
            // C's strlen: the name ends at its first NUL.
            n := 0
            loop buf[p + n] != (U8{0}) {
                n += 1
            }
            hostname: String.from_bytes(ssldefs.ssl_bytes_of(buf, p, n)) ?? return Err(.BadInputData)
            ssltls.ssl_session_set_hostname(session, Val(hostname)) ?? return Err(err)
            p += hostname_len
        }
        if end - p < 8 -> return Err(.BadInputData)
        session.ticket_reception_time = ssl_ser_get_time(buf, p)
        p += 8
        if end - p < 4 -> return Err(.BadInputData)
        session.ticket_lifetime = ssldefs.ssl_get_u32(buf, p)
        p += 4
        if end - p < 2 -> return Err(.BadInputData)
        ticket_len: ssldefs.ssl_get_u16(buf, p)
        p += 2
        if end - p < ticket_len -> return Err(.BadInputData)
        // C's ticket_len of 0 leaves no ticket.
        session.ticket = None
        if ticket_len > 0 {
            session.ticket = Val(ssldefs.ssl_bytes_of(buf, p, ticket_len))
            p += ticket_len
        }
    }
    if p != end -> return Err(.BadInputData)
}

// ---------------------------------------------------------------------------
// Sessions.

/// Serialize a session (ssl_session_save): the version and format header
/// unless `omit_header`, the TLS version's low byte, the endpoint and the
/// ciphersuite, then the version's own fields. Versions other than TLS
/// 1.2 and 1.3 are FEATURE_UNAVAILABLE.
ssl_session_save_int: fn(session: ssldefs.SSLSession, omit_header: Bool) -> [U8] ssldefs.SSLError! {
    out := [U8]{}
    if !omit_header -> ssldefs.ssl_push_all(out, ssl_serialized_session_header())
    out.push(ssldefs.ssl_byte(session.tls_version))
    out.push(ssldefs.ssl_byte(session.endpoint))
    ssldefs.ssl_push_u16(out, session.ciphersuite)
    if session.tls_version == ssldefs.SSL_VERSION_TLS1_2 {
        ssl_tls12_session_save(session, out)
        return Ok(out)
    }
    if session.tls_version == ssldefs.SSL_VERSION_TLS1_3 {
        ssl_tls13_session_save(session, out) ?? return Err(err)
        return Ok(out)
    }
    Err(.FeatureUnavailable)
}

/// Serialize a session with its header (mbedtls_ssl_session_save).
ssl_session_save: fn(session: ssldefs.SSLSession) -> [U8] ssldefs.SSLError! {
    ssl_session_save_int(session, false)
}

/// Read a session from buf[start..<start+len] (ssl_session_load): a
/// header that is not this version's and format is VERSION_MISMATCH, and a
/// TLS version other than 1.2 and 1.3 is BAD_INPUT_DATA.
ssl_session_load_int: fn(session: &ssldefs.SSLSession, omit_header: Bool, buf: [U8], start: Int, len: Int) ssldefs.SSLError! {
    p := start
    end: start + len
    if !omit_header {
        header: ssl_serialized_session_header()
        if end - p < header.len() -> return Err(.BadInputData)
        if !ssldefs.ssl_range_eq(buf, p, header, 0, header.len()) -> return Err(.VersionMismatch)
        p += header.len()
    }
    if 4 > end - p -> return Err(.BadInputData)
    session.tls_version = ssldefs.ssl_u8(buf, p).bit_or(0x0300)
    session.endpoint = ssldefs.ssl_u8(buf, p + 1)
    session.ciphersuite = ssldefs.ssl_get_u16(buf, p + 2)
    p += 4
    if session.tls_version == ssldefs.SSL_VERSION_TLS1_2 -> return ssl_tls12_session_load(session, buf, p, end - p)
    if session.tls_version == ssldefs.SSL_VERSION_TLS1_3 -> return ssl_tls13_session_load(session, buf, p, end - p)
    Err(.BadInputData)
}

/// Read a session with its header (mbedtls_ssl_session_load); on an error
/// the session is freed.
ssl_session_load: fn(session: &ssldefs.SSLSession, buf: [U8]) ssldefs.SSLError! {
    if ssl_session_load_int(session, false, buf, 0, buf.len()) == {
        .Ok(_) -> {}
        .Err(e) -> {
            ssl_ser_session_free(session)
            return Err(e)
        }
    }
}

// ---------------------------------------------------------------------------
// Contexts.

/// The TLS 1.2 PRF digest of a ciphersuite (ssl_tls12prf_from_cs): None
/// for an unknown ciphersuite or a MAC other than SHA-256 and SHA-384.
ssl_tls12prf_from_cs: fn(ciphersuite_id: Int) -> hashes.Md? Never! {
    cs: suites.ssl_ciphersuite_from_id(ciphersuite_id) ?? return None
    if cs.mac == .SHA384 -> return Val(hashes.Md.SHA384)
    if cs.mac == .SHA256 -> return Val(hashes.Md.SHA256)
    None
}

/// Serialize a connection whose handshake is over, then reset the context
/// (mbedtls_ssl_context_save). Only a DTLS 1.2 connection with an AEAD
/// ciphersuite, no data pending and renegotiation disabled can be saved;
/// anything else is BAD_INPUT_DATA. The bytes are the header, the session
/// without its header, the randoms, the connection IDs, the bad-MAC count,
/// the anti-replay window, datagram packing, the outgoing record counter,
/// the MTU and the chosen ALPN protocol.
ssl_context_save: fn(ssl: &ssldefs.SSLContext) -> [U8] ssldefs.SSLError! {
    if !sslmsg.ssl_is_handshake_over(ssl) -> return Err(.BadInputData)
    if ssl.has_handshake -> return Err(.BadInputData)
    if ssl.transform < 0 || ssl.session < 0 -> return Err(.BadInputData)
    if sslmsg.ssl_check_pending(ssl) -> return Err(.BadInputData)
    if ssl.out_left != 0 -> return Err(.BadInputData)
    if ssl.conf.transport != ssldefs.SSL_TRANSPORT_DATAGRAM -> return Err(.BadInputData)
    if ssl.tls_version != ssldefs.SSL_VERSION_TLS1_2 -> return Err(.BadInputData)
    if !ssltls.ssl_transform_uses_aead(ssl.tpool[ssl.transform]) -> return Err(.BadInputData)
    if ssl.conf.disable_renegotiation != ssldefs.SSL_RENEGOTIATION_DISABLED -> return Err(.BadInputData)
    out := ssl_serialized_context_header()
    session := ssl_session_save_int(ssl.spool[ssl.session], true) ?? return Err(err)
    ssldefs.ssl_push_u32(out, session.len())
    ssldefs.ssl_push_all(out, session)
    ssldefs.ssl_wipe(session)
    t: ssl.transform
    ssl_ser_push_fixed(out, ssl.tpool[t].randbytes, SSL_SER_RANDBYTES_LEN)
    out.push(ssldefs.ssl_byte(ssl.tpool[t].in_cid.len()))
    ssldefs.ssl_push_all(out, ssl.tpool[t].in_cid)
    out.push(ssldefs.ssl_byte(ssl.tpool[t].out_cid.len()))
    ssldefs.ssl_push_all(out, ssl.tpool[t].out_cid)
    ssldefs.ssl_push_u32(out, ssl.badmac_seen_or_in_hsfraglen)
    ssl_ser_push_u64(out, ssl.in_window_top)
    ssl_ser_push_u64(out, ssl.in_window)
    out.push(ssldefs.ssl_byte(ssl.disable_datagram_packing))
    ssl_ser_push_fixed(out, ssl.cur_out_ctr, ssldefs.SSL_SEQUENCE_NUMBER_LEN)
    ssldefs.ssl_push_u16(out, ssl.mtu)
    if ssl.alpn_chosen == {
        .Val(alpn) -> {
            name: alpn.bytes()
            out.push(ssldefs.ssl_byte(name.len()))
            ssldefs.ssl_push_all(out, name)
        }
        None -> out.push(U8{0})
    }
    ssltls.ssl_session_reset_int(ssl, false)
    Ok(out)
}

// The configured ALPN protocol buf[p..<p+len] names, as alpn_chosen
// (mbedtls_ssl_context_load's search of conf->alpn_list).
ssl_ser_load_alpn: fn(ssl: &ssldefs.SSLContext, buf: [U8], p: Int, len: Int) Never! {
    ours: ssl.conf.alpn_list ?? return
    loop alpn in ours {
        alpn_bytes: alpn.bytes()
        if alpn_bytes.len() == len && ssldefs.ssl_range_eq(buf, p, alpn_bytes, 0, len) {
            ssl.alpn_chosen = Val(alpn)
            return
        }
    }
}

/// Restore a saved connection into a context freshly set up or reset
/// (ssl_context_load). Its configuration must allow what saving required:
/// DTLS, TLS 1.2 and renegotiation disabled. A header that is not this
/// version's and format is VERSION_MISMATCH; anything else wrong is
/// BAD_INPUT_DATA, as is an ALPN protocol the configuration lacks.
ssl_context_load_int: fn(ssl: &ssldefs.SSLContext, buf: [U8]) ssldefs.SSLError! {
    if ssl.state != ssldefs.SSL_HELLO_REQUEST || ssl.session >= 0 -> return Err(.BadInputData)
    if ssl.conf.disable_renegotiation != ssldefs.SSL_RENEGOTIATION_DISABLED -> return Err(.BadInputData)
    if ssl.conf.transport != ssldefs.SSL_TRANSPORT_DATAGRAM -> return Err(.BadInputData)
    if ssl.conf.max_tls_version < ssldefs.SSL_VERSION_TLS1_2 || ssl.conf.min_tls_version > ssldefs.SSL_VERSION_TLS1_2 -> return Err(.BadInputData)
    // C uses the session and transform the set-up or reset allocated; a
    // context without them is not one.
    if ssl.session_negotiate < 0 || ssl.transform_negotiate < 0 -> return Err(.BadInputData)
    p := 0
    end: buf.len()
    header: ssl_serialized_context_header()
    if end - p < header.len() -> return Err(.BadInputData)
    if !ssldefs.ssl_range_eq(buf, p, header, 0, header.len()) -> return Err(.VersionMismatch)
    p += header.len()
    // The session.
    if end - p < 4 -> return Err(.BadInputData)
    session_len: ssldefs.ssl_get_u32(buf, p)
    p += 4
    ssl.session = ssl.session_negotiate
    ssl.session_in = ssl.session
    ssl.session_out = ssl.session
    ssl.session_negotiate = -1
    if end - p < session_len -> return Err(.BadInputData)
    s: ssl.session
    if ssl_session_load_int(ssl.spool[s], true, buf, p, session_len) == {
        .Ok(_) -> {}
        .Err(e) -> {
            ssl_ser_session_free(ssl.spool[s])
            return Err(e)
        }
    }
    p += session_len
    // The transform, derived again from the master secret and randoms.
    ssl.transform = ssl.transform_negotiate
    ssl.transform_in = ssl.transform
    ssl.transform_out = ssl.transform
    ssl.transform_negotiate = -1
    t: ssl.transform
    ciphersuite: ssl.spool[s].ciphersuite
    prf_md: ssl_tls12prf_from_cs(ciphersuite) ?? return Err(.BadInputData)
    if end - p < SSL_SER_RANDBYTES_LEN -> return Err(.BadInputData)
    master := ssl.spool[s].master.copy()
    encrypt_then_mac: ssl.spool[s].encrypt_then_mac
    endpoint: ssl.conf.endpoint
    randbytes := ssldefs.ssl_bytes_of(buf, p, SSL_SER_RANDBYTES_LEN)
    failure := ssldefs.SSLError?{None}
    if ssltls.ssl_tls12_populate_transform(ssl, t, ciphersuite, master, encrypt_then_mac, prf_md, randbytes, ssldefs.SSL_VERSION_TLS1_2, endpoint) == {
        .Ok(_) -> {}
        .Err(e) -> failure = Val(e)
    }
    ssldefs.ssl_wipe(master)
    ssldefs.ssl_wipe(randbytes)
    if failure == {
        .Val(e) -> return Err(e)
        None -> {}
    }
    p += SSL_SER_RANDBYTES_LEN
    // The connection IDs.
    if end - p < 1 -> return Err(.BadInputData)
    in_cid_len: ssldefs.ssl_u8(buf, p)
    p += 1
    if end - p < in_cid_len + 1 -> return Err(.BadInputData)
    if in_cid_len > ssldefs.SSL_CID_IN_LEN_MAX -> return Err(.BadInputData)
    ssl.tpool[t].in_cid = ssldefs.ssl_bytes_of(buf, p, in_cid_len)
    p += in_cid_len
    out_cid_len: ssldefs.ssl_u8(buf, p)
    p += 1
    if end - p < out_cid_len -> return Err(.BadInputData)
    if out_cid_len > ssldefs.SSL_CID_OUT_LEN_MAX -> return Err(.BadInputData)
    ssl.tpool[t].out_cid = ssldefs.ssl_bytes_of(buf, p, out_cid_len)
    p += out_cid_len
    // The context's own fields.
    if end - p < 4 -> return Err(.BadInputData)
    ssl.badmac_seen_or_in_hsfraglen = ssldefs.ssl_get_u32(buf, p)
    p += 4
    if end - p < 16 -> return Err(.BadInputData)
    ssl.in_window_top = ssl_ser_get_u64(buf, p)
    ssl.in_window = ssl_ser_get_u64(buf, p + 8)
    p += 16
    if end - p < 1 -> return Err(.BadInputData)
    ssl.disable_datagram_packing = ssldefs.ssl_u8(buf, p)
    p += 1
    if end - p < ssldefs.SSL_SEQUENCE_NUMBER_LEN -> return Err(.BadInputData)
    ssl.cur_out_ctr = ssldefs.ssl_bytes_of(buf, p, ssldefs.SSL_SEQUENCE_NUMBER_LEN)
    p += ssldefs.SSL_SEQUENCE_NUMBER_LEN
    if end - p < 2 -> return Err(.BadInputData)
    ssl.mtu = ssldefs.ssl_get_u16(buf, p)
    p += 2
    if end - p < 1 -> return Err(.BadInputData)
    alpn_len: ssldefs.ssl_u8(buf, p)
    p += 1
    // C compares before it checks the length, and a short buffer then
    // fails its final check; here the length is checked first.
    if end - p < alpn_len -> return Err(.BadInputData)
    if alpn_len != 0 -> ssl_ser_load_alpn(ssl, buf, p, alpn_len)
    // Only a configuration mismatch gets here.
    if alpn_len != 0 && ssl.alpn_chosen == None -> return Err(.BadInputData)
    p += alpn_len
    // The fields the reset left as they must be, or that follow.
    sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_HANDSHAKE_OVER)
    ssl.tls_version = ssldefs.SSL_VERSION_TLS1_2
    sslmsg.ssl_update_out_pointers(ssl, t)
    ssl.in_epoch = 1
    // The reset's handshake would free the wrong transform at wrap-up.
    if ssl.has_handshake {
        ssltls.ssl_handshake_free(ssl)
        ssl.has_handshake = false
    }
    if p != end -> return Err(.BadInputData)
}

/// Restore a saved connection (mbedtls_ssl_context_load); on an error the
/// context is freed.
ssl_context_load: fn(ssl: &ssldefs.SSLContext, buf: [U8]) ssldefs.SSLError! {
    if ssl_context_load_int(ssl, buf) == {
        .Ok(_) -> {}
        .Err(e) -> {
            ssltls.ssl_free(ssl)
            return Err(e)
        }
    }
}
