// SPDX-License-Identifier: Apache-2.0
// Translated from Mbed TLS 3.6.7 (library/ssl_tls.c, library/ssl_misc.h); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: the SSL/TLS engine's shared handshake code.
//
// A port of mbedtls 3.6.7's ssl_tls.c, with the inline helpers of
// ssl_misc.h, under the default mbedtls_config.h: context setup and
// reset, the configuration and context setters that do more than store a
// field, the handshake transcript, the TLS 1.2 PRF, key derivation and
// record protection set-up, the Certificate and Finished messages shared by
// client and server, the handshake driver and renegotiation, and the
// extension helpers both TLS versions use. Session and context
// serialization are in their own part.
//
// C's one-line setters that store a field are not ported: the field is
// set directly. The deprecated mbedtls_ssl_conf_curves and
// mbedtls_ssl_conf_sig_hashes, which mbedtls 4 removes, are not ported
// either, so the handshake uses the configured group and signature
// algorithm lists as they are.
use {
    core
    __core_crypto_bignum.[RNG]
    bn: __core_crypto_bignum
    layer: __core_crypto_cipher_layer
    cipher: __core_crypto_cipher
    hashes: __core_crypto_md
    ctime: __core_crypto_ctime
    oids: __core_crypto_oid
    ecp: __core_crypto_ecp
    dhm: __core_crypto_dhm
    ecdh: __core_crypto_ecdh
    pk: __core_crypto_pk
    x509: __core_crypto_x509
    x509crt: __core_crypto_x509crt
    ssldefs: __core_net_ssl_defs
    suites: __core_net_ssl_ciphersuites
    sslmsg: __core_net_ssl_msg
    sslcli: __core_net_ssl_cli
    cli12: __core_net_ssl_cli12
    srv12: __core_net_ssl_srv12
    cli13: __core_net_ssl_cli13
    srv13: __core_net_ssl_srv13
    keys13: __core_net_ssl_keys13
    // The test vectors only.
    gen13: __core_net_ssl_gen13
    aead: __core_crypto_aead
    drbg: __core_crypto_drbg
    ecdsa: __core_crypto_ecdsa
    rsa: __core_crypto_rsa
    pem: __core_crypto_pem
    pkparse: __core_crypto_pkparse
    core.encoding.[Dyn]
    core.crypto.[Secret]
}

// ---------------------------------------------------------------------------
// Sessions.

/// The record length a max_fragment_length code allows
/// (ssl_mfl_code_to_length); 0 and unknown codes allow the full 2^14.
ssl_mfl_code_to_length: fn(mfl: Int) -> Int Never! {
    if mfl == ssldefs.SSL_MAX_FRAG_LEN_512 -> return 512
    if mfl == ssldefs.SSL_MAX_FRAG_LEN_1024 -> return 1024
    if mfl == ssldefs.SSL_MAX_FRAG_LEN_2048 -> return 2048
    if mfl == ssldefs.SSL_MAX_FRAG_LEN_4096 -> return 4096
    ssldefs.TLS_EXT_ADV_CONTENT_LEN
}

/// Make `dst` a copy of `src` (mbedtls_ssl_session_copy). The peer's
/// certificate is parsed again from its DER, the first of the chain alone
/// as C keeps it; the hostname is kept only for a client's session, as C
/// copies it only there.
ssl_session_copy: fn(dst: &ssldefs.SSLSession, src: ssldefs.SSLSession) ssldefs.SSLError! {
    ssldefs.ssl_session_wipe(dst)
    dst = ssldefs.SSLSession{
        valid: true, mfl_code: src.mfl_code, exported: src.exported, endpoint: src.endpoint,
        tls_version: src.tls_version, start: src.start, ciphersuite: src.ciphersuite,
        id: src.id.copy(), master: src.master.copy(), verify_result: src.verify_result,
        ticket: src.ticket.copy(), ticket_lifetime: src.ticket_lifetime,
        ticket_creation_time: src.ticket_creation_time, ticket_age_add: src.ticket_age_add,
        ticket_flags: src.ticket_flags, resumption_key: src.resumption_key.copy(),
        ticket_reception_time: src.ticket_reception_time, encrypt_then_mac: src.encrypt_then_mac,
        app_secrets: ssldefs.SSLTLS13AppSecrets{
            client_application_traffic_secret_n: src.app_secrets.client_application_traffic_secret_n.copy(),
            server_application_traffic_secret_n: src.app_secrets.server_application_traffic_secret_n.copy(),
            exporter_master_secret: src.app_secrets.exporter_master_secret.copy(),
            resumption_master_secret: src.app_secrets.resumption_master_secret.copy()
        }
    }
    if src.endpoint == ssldefs.SSL_IS_CLIENT -> dst.hostname = src.hostname.copy()
    if src.peer_cert == {
        .Val(chain) -> {
            if chain.len() > 0 {
                peer := [x509crt.X509Crt]{}
                x509crt.x509_crt_parse_der(peer, chain[0].raw) ?? return Err(.X509(err))
                dst.peer_cert = Val(peer)
            }
        }
        None -> {}
    }
}

// ---------------------------------------------------------------------------
// The handshake transcript.

/// Hash the transcript with the ciphersuite's digest alone from now on
/// (mbedtls_ssl_optimize_checksum).
ssl_optimize_checksum: fn(ssl: &ssldefs.SSLContext, cs: suites.SSLCiphersuite) Never! {
    ssl.handshake.checksum_md = if cs.mac == .SHA384 -> 2 else -> 1
}

/// Add the transcript's handshake message header of a message of
/// `total_hs_len` bytes (mbedtls_ssl_add_hs_hdr_to_checksum).
ssl_add_hs_hdr_to_checksum: fn(hs: &ssldefs.SSLHandshake, hs_type: Int, total_hs_len: Int) Never! {
    hdr: [U8]{ssldefs.ssl_byte(hs_type), ssldefs.ssl_byte(total_hs_len >> 16), ssldefs.ssl_byte(total_hs_len >> 8), ssldefs.ssl_byte(total_hs_len)}
    ssl_update_checksum(hs, hdr, 0, 4)
}

/// Add a handshake message, header and msg[off..<off+len], to the
/// transcript (mbedtls_ssl_add_hs_msg_to_checksum). It takes the
/// handshake rather than the context, so the message can be the context's
/// in_buf or out_buf.
ssl_add_hs_msg_to_checksum: fn(hs: &ssldefs.SSLHandshake, hs_type: Int, msg: [U8], off: Int, len: Int) Never! {
    ssl_add_hs_hdr_to_checksum(hs, hs_type, len)
    ssl_update_checksum(hs, msg, off, len)
}

/// Restart both transcript hashes (mbedtls_ssl_reset_checksum).
ssl_reset_checksum: fn(ssl: &ssldefs.SSLContext) Never! {
    ssl.handshake.fin_sha256 = Val(hashes.hash_start(.SHA256))
    ssl.handshake.fin_sha384 = Val(hashes.hash_start(.SHA384))
}

/// Add buf[off..<off+len] to the transcript hashes in use: both until the
/// ciphersuite is known (ssl_update_checksum_start), then its digest's
/// alone (ssl_update_checksum_sha256, ssl_update_checksum_sha384).
ssl_update_checksum: fn(hs: &ssldefs.SSLHandshake, buf: [U8], off: Int, len: Int) Never! {
    if hs.checksum_md != 2 {
        if &hs.fin_sha256 == {
            .Val(c) -> hashes.hash_update_range(c, buf, off, len)
            None -> {}
        }
    }
    if hs.checksum_md != 1 {
        if &hs.fin_sha384 == {
            .Val(c) -> hashes.hash_update_range(c, buf, off, len)
            None -> {}
        }
    }
}

// ---------------------------------------------------------------------------
// Context set-up and reset.

/// A fresh handshake state (ssl_handshake_params_init), its fixed-size
/// buffers allocated.
ssl_handshake_params_init: fn() -> ssldefs.SSLHandshake Never! {
    hs := ssldefs.SSLHandshake{}
    hs.alt_out_ctr = ssldefs.ssl_zeros(ssldefs.SSL_SEQUENCE_NUMBER_LEN)
    loop _ in 0..<ssldefs.SSL_MAX_BUFFERED_HS -> hs.hs.push(ssldefs.SSLHsBuffer{})
    hs.premaster = ssldefs.ssl_zeros(ssldefs.SSL_PREMASTER_SIZE)
    hs.randbytes = ssldefs.ssl_zeros(ssldefs.CLIENT_HELLO_RANDOM_LEN + ssldefs.SERVER_HELLO_RANDOM_LEN)
    hs.fin_sha256 = Val(hashes.hash_start(.SHA256))
    hs.fin_sha384 = Val(hashes.hash_start(.SHA384))
    hs
}

/// Start a handshake (ssl_handshake_init): a fresh negotiated transform
/// and session, the handshake state reset and the transcript restarted.
ssl_handshake_init: fn(ssl: &ssldefs.SSLContext) Never! {
    if ssl.transform_negotiate >= 0 {
        ssldefs.ssl_transform_wipe(ssl.tpool[ssl.transform_negotiate])
        ssl.tpool[ssl.transform_negotiate] = ssldefs.SSLTransform{valid: true}
    } else {
        ssl.transform_negotiate = ssldefs.ssl_transform_alloc(ssl)
    }
    if ssl.session_negotiate >= 0 {
        ssldefs.ssl_session_wipe(ssl.spool[ssl.session_negotiate])
        ssl.spool[ssl.session_negotiate] = ssldefs.SSLSession{valid: true, verify_result: 0xFFFFFFFF}
    } else {
        ssl.session_negotiate = ssldefs.ssl_session_alloc(ssl)
    }
    if ssl.has_handshake -> ssl_handshake_free(ssl)
    ssl.handshake = ssl_handshake_params_init()
    ssl.has_handshake = true
    ssl_reset_checksum(ssl)
    ssl.handshake.new_session_tickets_count = ssl.conf.new_session_tickets_count
    if sslmsg.ssl_is_dtls(ssl) {
        ssl.handshake.alt_transform_out = ssl.transform_out
        ssl.handshake.retransmit_state = if ssl.conf.endpoint == ssldefs.SSL_IS_CLIENT -> ssldefs.SSL_RETRANS_PREPARING else -> ssldefs.SSL_RETRANS_WAITING
        sslmsg.ssl_set_timer(ssl, 0)
    }
}

/// The cookie writer a DTLS server has until one is configured
/// (ssl_cookie_write_dummy).
ssl_cookie_write_dummy: fn(cli_id: [U8]) -> [U8] ssldefs.SSLError! {
    Err(.FeatureUnavailable)
}

/// The cookie checker a DTLS server has until one is configured
/// (ssl_cookie_check_dummy).
ssl_cookie_check_dummy: fn(cookie: [U8], cli_id: [U8]) -> Bool ssldefs.SSLError! {
    Err(.FeatureUnavailable)
}

/// mbedtls_ssl_conf_is_tls13_only.
ssl_conf_is_tls13_only: fn(conf: ssldefs.SSLConfig) -> Bool Never! {
    conf.min_tls_version == ssldefs.SSL_VERSION_TLS1_3 && conf.max_tls_version == ssldefs.SSL_VERSION_TLS1_3
}

/// mbedtls_ssl_conf_is_tls12_only.
ssl_conf_is_tls12_only: fn(conf: ssldefs.SSLConfig) -> Bool Never! {
    conf.min_tls_version == ssldefs.SSL_VERSION_TLS1_2 && conf.max_tls_version == ssldefs.SSL_VERSION_TLS1_2
}

/// mbedtls_ssl_conf_is_tls13_enabled.
ssl_conf_is_tls13_enabled: fn(conf: ssldefs.SSLConfig) -> Bool Never! {
    conf.min_tls_version <= ssldefs.SSL_VERSION_TLS1_3 && conf.max_tls_version >= ssldefs.SSL_VERSION_TLS1_3
}

/// mbedtls_ssl_conf_is_tls12_enabled.
ssl_conf_is_tls12_enabled: fn(conf: ssldefs.SSLConfig) -> Bool Never! {
    conf.min_tls_version <= ssldefs.SSL_VERSION_TLS1_2 && conf.max_tls_version >= ssldefs.SSL_VERSION_TLS1_2
}

/// mbedtls_ssl_conf_is_hybrid_tls12_tls13.
ssl_conf_is_hybrid_tls12_tls13: fn(conf: ssldefs.SSLConfig) -> Bool Never! {
    conf.min_tls_version == ssldefs.SSL_VERSION_TLS1_2 && conf.max_tls_version == ssldefs.SSL_VERSION_TLS1_3
}

/// Whether the configuration's version range is one this build can run
/// (ssl_conf_version_check): DTLS is TLS 1.2 only.
ssl_conf_version_check: fn(conf: ssldefs.SSLConfig) ssldefs.SSLError! {
    if ssl_conf_is_tls13_only(conf) {
        if conf.transport == ssldefs.SSL_TRANSPORT_DATAGRAM -> return Err(.FeatureUnavailable)
        return
    }
    if ssl_conf_is_tls12_only(conf) -> return
    if ssl_conf_is_hybrid_tls12_tls13(conf) {
        if conf.transport == ssldefs.SSL_TRANSPORT_DATAGRAM -> return Err(.FeatureUnavailable)
        return
    }
    Err(.BadConfig)
}

/// Set a context up to use `conf` (mbedtls_ssl_setup). The context takes
/// the configuration over, where C keeps a pointer to the caller's.
ssl_setup: fn(ssl: &ssldefs.SSLContext, conf: &&ssldefs.SSLConfig) ssldefs.SSLError! {
    ssl.conf = conf
    ssl.has_conf = true
    ssl_conf_version_check(ssl.conf) ?? return Err(err)
    ssl.tls_version = ssl.conf.max_tls_version
    ssl.in_buf = ssldefs.ssl_zeros(ssldefs.SSL_IN_BUFFER_LEN)
    ssl.out_buf = ssldefs.ssl_zeros(ssldefs.SSL_OUT_BUFFER_LEN)
    ssl.cur_out_ctr = ssldefs.ssl_zeros(ssldefs.SSL_SEQUENCE_NUMBER_LEN)
    ssl.own_verify_data = ssldefs.ssl_zeros(ssldefs.SSL_VERIFY_DATA_MAX_LEN)
    ssl.peer_verify_data = ssldefs.ssl_zeros(ssldefs.SSL_VERIFY_DATA_MAX_LEN)
    sslmsg.ssl_reset_in_pointers(ssl)
    sslmsg.ssl_reset_out_pointers(ssl)
    ssl_handshake_init(ssl)
}

/// Reset the record layer for a new connection
/// (mbedtls_ssl_session_reset_msg_layer). `partial` keeps the datagram
/// being read and the bad-MAC count, for a DTLS client reconnecting from
/// the same port.
ssl_session_reset_msg_layer: fn(ssl: &ssldefs.SSLContext, partial: Bool) Never! {
    sslmsg.ssl_set_timer(ssl, 0)
    sslmsg.ssl_reset_in_pointers(ssl)
    sslmsg.ssl_reset_out_pointers(ssl)
    ssl.in_offt = -1
    ssl.nb_zero = 0
    ssl.in_msgtype = 0
    ssl.in_msglen = 0
    ssl.in_hslen = 0
    ssl.keep_current_message = 0
    ssl.transform_in = -1
    if !partial -> ssl.badmac_seen_or_in_hsfraglen = 0
    ssl.next_record_offset = 0
    ssl.in_epoch = 0
    if !partial {
        ssl.in_left = 0
        ssldefs.ssl_fill(ssl.in_buf, 0, ssl.in_buf.len(), U8{0})
    }
    ssl.send_alert = 0
    ssl.alert_reason = None
    ssl.alert_type = 0
    ssl.out_msgtype = 0
    ssl.out_msglen = 0
    ssl.out_left = 0
    ssldefs.ssl_fill(ssl.out_buf, 0, ssl.out_buf.len(), U8{0})
    ssldefs.ssl_fill(ssl.cur_out_ctr, 0, ssl.cur_out_ctr.len(), U8{0})
    ssl.transform_out = -1
    sslmsg.ssl_dtls_replay_reset(ssl)
    ssldefs.ssl_transform_release(ssl, ssl.transform)
    ssl.transform = -1
    ssldefs.ssl_transform_release(ssl, ssl.transform_application)
    ssl.transform_application = -1
    if ssl.has_handshake {
        ssldefs.ssl_transform_release(ssl, ssl.handshake.transform_handshake)
        ssl.handshake.transform_handshake = -1
    }
}

/// Reset a context for a new connection, keeping its configuration and
/// callbacks (mbedtls_ssl_session_reset_int); see
/// ssl_session_reset_msg_layer for `partial`, which also keeps the
/// client's transport ID.
ssl_session_reset_int: fn(ssl: &ssldefs.SSLContext, partial: Bool) Never! {
    sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_HELLO_REQUEST)
    ssl.tls_version = ssl.conf.max_tls_version
    ssl_session_reset_msg_layer(ssl, partial)
    ssl.renego_status = ssldefs.SSL_INITIAL_HANDSHAKE
    ssl.renego_records_seen = 0
    ssl.verify_data_len = 0
    ssldefs.ssl_fill(ssl.own_verify_data, 0, ssl.own_verify_data.len(), U8{0})
    ssldefs.ssl_fill(ssl.peer_verify_data, 0, ssl.peer_verify_data.len(), U8{0})
    ssl.secure_renegotiation = ssldefs.SSL_LEGACY_RENEGOTIATION
    ssl.session_in = -1
    ssl.session_out = -1
    ssldefs.ssl_session_release(ssl, ssl.session)
    ssl.session = -1
    ssl.alpn_chosen = None
    if !partial -> ssl.cli_id = None
    ssl_handshake_init(ssl)
}

/// mbedtls_ssl_session_reset.
ssl_session_reset: fn(ssl: &ssldefs.SSLContext) Never! { ssl_session_reset_int(ssl, false) }

/// Free what the handshake holds (mbedtls_ssl_handshake_free): its
/// secrets are wiped, its buffered and in-flight messages and its TLS 1.3
/// handshake transform released, and the state cleared.
ssl_handshake_free: fn(ssl: &ssldefs.SSLContext) Never! {
    if !ssl.has_handshake -> return
    ssldefs.ssl_wipe(ssl.handshake.premaster)
    ssldefs.ssl_wipe(ssl.handshake.randbytes)
    ssldefs.ssl_wipe(ssl.handshake.tls13_early_secret)
    ssldefs.ssl_wipe(ssl.handshake.tls13_handshake_secret)
    ssldefs.ssl_wipe(ssl.handshake.tls13_app_secret)
    ssldefs.ssl_wipe(ssl.handshake.client_handshake_traffic_secret)
    ssldefs.ssl_wipe(ssl.handshake.server_handshake_traffic_secret)
    ssldefs.ssl_wipe(ssl.handshake.finished_digest)
    if &ssl.handshake.psk == {
        .Val(p) -> ssldefs.ssl_wipe(p)
        None -> {}
    }
    sslmsg.ssl_flight_free(ssl.handshake)
    sslmsg.ssl_buffering_free(ssl)
    ssldefs.ssl_transform_release(ssl, ssl.handshake.transform_handshake)
    ssl.handshake = ssldefs.SSLHandshake{}
}

/// Free a context's state (mbedtls_ssl_free): its buffers are wiped and
/// its sessions and transforms released. The pools hold what C reaches
/// through pointers, so every pool entry is wiped too, and the
/// configuration's PSK (mbedtls_ssl_config_free's part, since the context
/// owns its configuration).
ssl_free: fn(ssl: &ssldefs.SSLContext) Never! {
    ssldefs.ssl_wipe(ssl.out_buf)
    ssldefs.ssl_wipe(ssl.in_buf)
    ssldefs.ssl_transform_release(ssl, ssl.transform)
    if ssl.has_handshake {
        ssl_handshake_free(ssl)
        ssl.has_handshake = false
        ssldefs.ssl_transform_release(ssl, ssl.transform_negotiate)
        ssldefs.ssl_session_release(ssl, ssl.session_negotiate)
    }
    ssldefs.ssl_transform_release(ssl, ssl.transform_application)
    ssldefs.ssl_session_release(ssl, ssl.session)
    loop i in 0..<ssl.tpool.len() -> ssldefs.ssl_transform_release(ssl, i)
    loop i in 0..<ssl.spool.len() -> ssldefs.ssl_session_release(ssl, i)
    if &ssl.conf.psk == {
        .Val(p) -> ssldefs.ssl_wipe(p)
        None -> {}
    }
    ssl = ssldefs.SSLContext{}
}

// ---------------------------------------------------------------------------
// Setters that do more than store a field.

/// Use the timer, or stop using it (mbedtls_ssl_set_timer_cb with
/// mbedtls_timing's callbacks or none); it starts canceled.
ssl_set_timer_cb: fn(ssl: &ssldefs.SSLContext, enabled: Bool) Never! {
    ssl.timer.enabled = enabled
    sslmsg.ssl_set_timer(ssl, 0)
}

/// Offer to resume `session` (mbedtls_ssl_set_session).
ssl_set_session: fn(ssl: &ssldefs.SSLContext, session: ssldefs.SSLSession) ssldefs.SSLError! {
    if ssl.session_negotiate < 0 || ssl.conf.endpoint != ssldefs.SSL_IS_CLIENT -> return Err(.BadInputData)
    if ssl.handshake.resume == 1 -> return Err(.FeatureUnavailable)
    if session.tls_version == ssldefs.SSL_VERSION_TLS1_3 {
        if !ssl_validate_ciphersuite(ssl, suites.ssl_ciphersuite_from_id(session.ciphersuite), ssldefs.SSL_VERSION_TLS1_3, ssldefs.SSL_VERSION_TLS1_3) -> return Err(.BadInputData)
    }
    ssl_session_copy(ssl.spool[ssl.session_negotiate], session) ?? return Err(err)
    ssl.handshake.resume = 1
}

/// Add an own certificate chain and key, or with None remove them all
/// (mbedtls_ssl_conf_own_cert).
ssl_conf_own_cert: fn(conf: &ssldefs.SSLConfig, kc: &&ssldefs.SSLKeyCert?) Never! {
    if kc == {
        .Val(k) -> conf.key_cert.push(k)
        None -> conf.key_cert = [ssldefs.SSLKeyCert]{}
    }
}

/// The SNI callback's own certificate chain and key for this handshake,
/// added, or with None removed (mbedtls_ssl_set_hs_own_cert).
ssl_set_hs_own_cert: fn(ssl: &ssldefs.SSLContext, kc: &&ssldefs.SSLKeyCert?) Never! {
    if kc == {
        .Val(k) -> ssl.handshake.sni_key_cert.push(k)
        None -> ssl.handshake.sni_key_cert = [ssldefs.SSLKeyCert]{}
    }
}

/// Apply what an SNI or certificate callback selected
/// (mbedtls_ssl_set_hs_own_cert, set_hs_ca_chain, set_hs_authmode and
/// set_hs_dn_hints).
ssl_apply_hs_override: fn(ssl: &ssldefs.SSLContext, ov: &&ssldefs.SSLHsOverride) Never! {
    ssl.handshake.sni_key_cert.extend(ov.key_cert.move())
    if ov.ca_chain != None {
        ssl.handshake.sni_ca_chain = ov.ca_chain.move()
        ssl.handshake.sni_ca_crl = ov.ca_crl.move()
    }
    if ov.authmode != ssldefs.SSL_VERIFY_UNSET -> ssl.handshake.sni_authmode = ov.authmode
    if ov.dn_hints != None -> ssl.handshake.dn_hints = ov.dn_hints.move()
}

/// Whether the handshake's key and certificate list is the SNI or
/// certificate callback's rather than the configuration's.
ssl_key_cert_from_sni: fn(ssl: ssldefs.SSLContext) -> Bool Never! {
    ssl.has_handshake && ssl.handshake.sni_key_cert.len() != 0
}

/// Where the own key and certificate are (mbedtls_ssl_own_key and
/// mbedtls_ssl_own_cert): the index of the handshake's pick in its list
/// (ssl_key_cert_from_sni says which), else of the configuration's first;
/// -1 when there is none.
ssl_own_key_cert: fn(ssl: ssldefs.SSLContext) -> Int Never! {
    if ssl.has_handshake && ssl.handshake.key_cert >= 0 -> return ssl.handshake.key_cert
    if ssl.conf.key_cert.len() == 0 -> return -1
    0
}

/// The DER of each certificate of the own chain, None when there is none.
ssl_own_cert_der: fn(ssl: ssldefs.SSLContext) -> [[U8]]? Never! {
    i: ssl_own_key_cert(ssl)
    if i < 0 -> return None
    out := [[U8]]{}
    if ssl_own_key_cert_is_hs(ssl) {
        loop crt in ssl.handshake.sni_key_cert[i].cert -> out.push(crt.raw.copy())
    } else {
        loop crt in ssl.conf.key_cert[i].cert -> out.push(crt.raw.copy())
    }
    Val(out)
}

/// Whether the own key and certificate are the handshake's SNI or
/// certificate callback pick, at ssl_own_key_cert's index in its list.
ssl_own_key_cert_is_hs: fn(ssl: ssldefs.SSLContext) -> Bool Never! {
    ssl_key_cert_from_sni(ssl) && ssl.handshake.key_cert >= 0
}

/// A signature with the own private key (mbedtls_pk_sign_ext on
/// mbedtls_ssl_own_key); BadInput when there is no own key.
ssl_own_key_sign_ext: fn<R: RNG>(ssl: &ssldefs.SSLContext, kind: oids.PKType, md: hashes.Md?, hash: [U8], sig_size: Int, rng: &R) -> [U8] pk.PKError! {
    i: ssl_own_key_cert(ssl)
    if i < 0 -> return Err(.BadInput)
    if ssl_own_key_cert_is_hs(ssl) -> return pk.pk_sign_ext(kind, ssl.handshake.sni_key_cert[i].key, md, hash, sig_size, rng)
    pk.pk_sign_ext(kind, ssl.conf.key_cert[i].key, md, hash, sig_size, rng)
}

/// A signature with the own private key (mbedtls_pk_sign on
/// mbedtls_ssl_own_key); BadInput when there is no own key.
ssl_own_key_sign: fn<R: RNG>(ssl: &ssldefs.SSLContext, md: hashes.Md?, hash: [U8], sig_size: Int, rng: &R) -> [U8] pk.PKError! {
    i: ssl_own_key_cert(ssl)
    if i < 0 -> return Err(.BadInput)
    if ssl_own_key_cert_is_hs(ssl) -> return pk.pk_sign(ssl.handshake.sni_key_cert[i].key, md, hash, sig_size, rng)
    pk.pk_sign(ssl.conf.key_cert[i].key, md, hash, sig_size, rng)
}

/// The own private key's type, None without a key set up
/// (mbedtls_pk_get_type on mbedtls_ssl_own_key, MBEDTLS_PK_NONE for NULL).
ssl_own_key_type: fn(ssl: ssldefs.SSLContext) -> oids.PKType? Never! {
    i: ssl_own_key_cert(ssl)
    if i < 0 -> return None
    if ssl_own_key_cert_is_hs(ssl) -> return pk.pk_get_type(ssl.handshake.sni_key_cert[i].key)
    pk.pk_get_type(ssl.conf.key_cert[i].key)
}

/// Whether the negotiated session holds the peer's certificate
/// (ssl->session_negotiate->peer_cert != NULL).
ssl_has_peer_cert: fn(ssl: ssldefs.SSLContext) -> Bool Never! {
    if ssl.spool[ssl.session_negotiate].peer_cert == {
        .Val(chain) -> chain.len() > 0
        None -> false
    }
}

/// Whether the peer's certificate key can do `kind`; false without one.
ssl_peer_pk_can_do: fn(ssl: ssldefs.SSLContext, kind: oids.PKType) -> Bool Never! {
    if ssl.spool[ssl.session_negotiate].peer_cert == {
        .Val(chain) -> chain.len() > 0 && pk.pk_can_do(chain[0].pk, kind)
        None -> false
    }
}

/// Whether the own private key can do `kind` (mbedtls_pk_can_do on
/// mbedtls_ssl_own_key); false without one.
ssl_own_pk_can_do: fn(ssl: ssldefs.SSLContext, kind: oids.PKType) -> Bool Never! {
    i: ssl_own_key_cert(ssl)
    if i < 0 -> return false
    if ssl_own_key_cert_is_hs(ssl) -> return pk.pk_can_do(ssl.handshake.sni_key_cert[i].key, kind)
    pk.pk_can_do(ssl.conf.key_cert[i].key, kind)
}

/// The size in bytes of the own certificate's public key
/// (mbedtls_pk_get_len on mbedtls_ssl_own_cert's pk); -1 without one.
ssl_own_cert_pk_len: fn(ssl: ssldefs.SSLContext) -> Int Never! {
    i: ssl_own_key_cert(ssl)
    if i < 0 -> return -1
    if ssl_own_key_cert_is_hs(ssl) -> return pk.pk_get_len(ssl.handshake.sni_key_cert[i].cert[0].pk)
    pk.pk_get_len(ssl.conf.key_cert[i].cert[0].pk)
}

/// A decryption with the own private key (mbedtls_pk_decrypt on
/// mbedtls_ssl_own_key); BadInput when there is no own key.
ssl_own_key_decrypt: fn<R: RNG>(ssl: &ssldefs.SSLContext, input: [U8], osize: Int, rng: &R) -> [U8] pk.PKError! {
    i: ssl_own_key_cert(ssl)
    if i < 0 -> return Err(.BadInput)
    if ssl_own_key_cert_is_hs(ssl) -> return pk.pk_decrypt(ssl.handshake.sni_key_cert[i].key, input, osize, rng)
    pk.pk_decrypt(ssl.conf.key_cert[i].key, input, osize, rng)
}

/// Give the handshake an ECDH context if it has none yet (C's
/// ssl_handshake_params_init sets one up with mbedtls_ecdh_init).
ssl_ecdh_ready: fn(ssl: &ssldefs.SSLContext) Never! {
    have: if &ssl.handshake.ecdh_ctx == {
        .Val(_) -> true
        None -> false
    }
    if !have -> ssl.handshake.ecdh_ctx = Val(ecdh.ecdh_new())
}

/// Give the handshake a DHM context if it has none yet (mbedtls_dhm_init).
ssl_dhm_ready: fn(ssl: &ssldefs.SSLContext) Never! {
    have: if &ssl.handshake.dhm_ctx == {
        .Val(_) -> true
        None -> false
    }
    if !have -> ssl.handshake.dhm_ctx = Val(dhm.dhm_new())
}

/// Set an ECDH context's group and one side's key from an EC key
/// (mbedtls_ecdh_get_params); the failure, None on success.
ssl_ecdh_get_params_failure: fn(ctx: &ecdh.ECDHContext, key: ecp.Keypair, side: ecdh.ECDHSide) -> ecp.EcpError? Never! {
    if ecdh.ecdh_get_params(ctx, key, side) == {
        .Ok(_) -> None
        .Err(e) -> Val(e)
    }
}

/// Keep a computed shared secret as the premaster secret and wipe the copy
/// (the DH and ECDH calc_secret calls writing into handshake->premaster).
ssl_set_premaster: fn(ssl: &ssldefs.SSLContext, secret: &[U8]) Never! {
    ssldefs.ssl_copy_into(ssl.handshake.premaster, 0, secret, 0, secret.len())
    ssl.handshake.pmslen = secret.len()
    ssldefs.ssl_wipe(secret)
}

/// Whether a PSK and its identity are configured
/// (mbedtls_ssl_conf_has_static_psk).
ssl_conf_has_static_psk: fn(conf: ssldefs.SSLConfig) -> Bool Never! {
    identity: conf.psk_identity ?? return false
    if identity.len() == 0 -> return false
    key: conf.psk ?? return false
    key.len() != 0
}

// Drop the configured PSK and identity (ssl_conf_remove_psk).
ssl_conf_remove_psk: fn(conf: &ssldefs.SSLConfig) Never! {
    if &conf.psk == {
        .Val(p) -> ssldefs.ssl_wipe(p)
        None -> {}
    }
    conf.psk = None
    conf.psk_identity = None
}

/// Configure the PSK and its identity (mbedtls_ssl_conf_psk); only one
/// may be configured.
ssl_conf_psk: fn(conf: &ssldefs.SSLConfig, psk: [U8], psk_identity: [U8]) ssldefs.SSLError! {
    if ssl_conf_has_static_psk(conf) -> return Err(.FeatureUnavailable)
    if psk.len() == 0 || psk.len() > ssldefs.SSL_PSK_MAX_LEN -> return Err(.BadInputData)
    conf.psk = Val(psk.copy())
    // ssl_conf_set_psk_identity: the length is written in two bytes.
    if psk_identity.len() == 0 || (psk_identity.len() >> 16) != 0 || psk_identity.len() > ssldefs.SSL_OUT_CONTENT_LEN {
        ssl_conf_remove_psk(conf)
        return Err(.BadInputData)
    }
    conf.psk_identity = Val(psk_identity.copy())
}

/// The PSK for this handshake, as a server's PSK callback picks it
/// (mbedtls_ssl_set_hs_psk).
ssl_set_hs_psk: fn(ssl: &ssldefs.SSLContext, psk: [U8]) ssldefs.SSLError! {
    if !ssl.has_handshake -> return Err(.BadInputData)
    if psk.len() > ssldefs.SSL_PSK_MAX_LEN -> return Err(.BadInputData)
    // ssl_remove_psk.
    if &ssl.handshake.psk == {
        .Val(p) -> ssldefs.ssl_wipe(p)
        None -> {}
    }
    ssl.handshake.psk = Val(psk.copy())
}

/// The PSK in use (mbedtls_ssl_get_psk): the handshake's, else the
/// configuration's; PrivateKeyRequired when there is none.
ssl_get_psk: fn(ssl: ssldefs.SSLContext) -> [U8] ssldefs.SSLError! {
    if ssl.handshake.psk == {
        .Val(k) -> { if k.len() > 0 -> return Ok(k) }
        None -> {}
    }
    if ssl.conf.psk == {
        .Val(k) -> { if k.len() > 0 -> return Ok(k) }
        None -> {}
    }
    Err(.PrivateKeyRequired)
}

/// The record protection a ciphersuite uses
/// (mbedtls_ssl_get_mode_from_ciphersuite).
ssl_get_mode_from_ciphersuite: fn(encrypt_then_mac: Int, suite: suites.SSLCiphersuite) -> sslmsg.SSLMode Never! {
    if suites.ssl_ciphersuite_cipher_info(suite) == {
        .Val(info) -> sslmsg.ssl_get_actual_mode(info.mode, encrypt_then_mac)
        None -> sslmsg.SSLMode.Stream
    }
}

/// The DHM prime and generator a server offers, big-endian
/// (mbedtls_ssl_conf_dh_param_bin).
ssl_conf_dh_param_bin: fn(conf: &ssldefs.SSLConfig, dhm_p: [U8], dhm_g: [U8]) ssldefs.SSLError! {
    conf.dhm_p = None
    conf.dhm_g = None
    p: bn.read_binary(dhm_p) ?? return Err(.Mpi(err))
    g: bn.read_binary(dhm_g) ?? return Err(.Mpi(err))
    conf.dhm_p = Val(p)
    conf.dhm_g = Val(g)
}

/// A TLS 1.2 SignatureAndHashAlgorithm value
/// (MBEDTLS_SSL_TLS12_SIG_AND_HASH_ALG).
ssl_tls12_sig_and_hash_alg: fn(sig: Int, hash: Int) -> Int Never! {
    (hash * 256).bit_or(sig)
}

/// The groups a default configuration offers, cheapest first
/// (ssl_preset_default_groups).
ssl_preset_default_groups: fn() -> [Int] Never! {
    [Int]{
        ssldefs.SSL_IANA_TLS_GROUP_X25519, ssldefs.SSL_IANA_TLS_GROUP_SECP256R1,
        ssldefs.SSL_IANA_TLS_GROUP_SECP384R1, ssldefs.SSL_IANA_TLS_GROUP_X448,
        ssldefs.SSL_IANA_TLS_GROUP_SECP521R1, ssldefs.SSL_IANA_TLS_GROUP_BP256R1,
        ssldefs.SSL_IANA_TLS_GROUP_BP384R1, ssldefs.SSL_IANA_TLS_GROUP_BP512R1,
        ssldefs.SSL_IANA_TLS_GROUP_FFDHE2048, ssldefs.SSL_IANA_TLS_GROUP_FFDHE3072,
        ssldefs.SSL_IANA_TLS_GROUP_FFDHE4096, ssldefs.SSL_IANA_TLS_GROUP_FFDHE6144,
        ssldefs.SSL_IANA_TLS_GROUP_FFDHE8192
    }
}

/// The groups of the NSA Suite B preset (ssl_preset_suiteb_groups).
ssl_preset_suiteb_groups: fn() -> [Int] Never! {
    [Int]{ssldefs.SSL_IANA_TLS_GROUP_SECP256R1, ssldefs.SSL_IANA_TLS_GROUP_SECP384R1}
}

/// The signature algorithms a default configuration offers when TLS 1.3
/// may be negotiated (ssl_preset_default_sig_algs).
ssl_preset_default_sig_algs: fn() -> [Int] Never! {
    [Int]{
        ssldefs.TLS1_3_SIG_ECDSA_SECP256R1_SHA256, ssldefs.TLS1_3_SIG_ECDSA_SECP384R1_SHA384,
        ssldefs.TLS1_3_SIG_ECDSA_SECP521R1_SHA512, ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA512,
        ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA384, ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA256,
        ssldefs.TLS1_3_SIG_RSA_PKCS1_SHA512, ssldefs.TLS1_3_SIG_RSA_PKCS1_SHA384,
        ssldefs.TLS1_3_SIG_RSA_PKCS1_SHA256
    }
}

/// The signature algorithms a default TLS 1.2-only configuration offers
/// (ssl_tls12_preset_default_sig_algs).
ssl_tls12_preset_default_sig_algs: fn() -> [Int] Never! {
    [Int]{
        ssl_tls12_sig_and_hash_alg(ssldefs.SSL_SIG_ECDSA, ssldefs.SSL_HASH_SHA512),
        ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA512,
        ssl_tls12_sig_and_hash_alg(ssldefs.SSL_SIG_RSA, ssldefs.SSL_HASH_SHA512),
        ssl_tls12_sig_and_hash_alg(ssldefs.SSL_SIG_ECDSA, ssldefs.SSL_HASH_SHA384),
        ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA384,
        ssl_tls12_sig_and_hash_alg(ssldefs.SSL_SIG_RSA, ssldefs.SSL_HASH_SHA384),
        ssl_tls12_sig_and_hash_alg(ssldefs.SSL_SIG_ECDSA, ssldefs.SSL_HASH_SHA256),
        ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA256,
        ssl_tls12_sig_and_hash_alg(ssldefs.SSL_SIG_RSA, ssldefs.SSL_HASH_SHA256)
    }
}

/// The signature algorithms of the Suite B preset when TLS 1.3 may be
/// negotiated (ssl_preset_suiteb_sig_algs).
ssl_preset_suiteb_sig_algs: fn() -> [Int] Never! {
    [Int]{ssldefs.TLS1_3_SIG_ECDSA_SECP256R1_SHA256, ssldefs.TLS1_3_SIG_ECDSA_SECP384R1_SHA384}
}

/// The signature algorithms of the TLS 1.2-only Suite B preset
/// (ssl_tls12_preset_suiteb_sig_algs).
ssl_tls12_preset_suiteb_sig_algs: fn() -> [Int] Never! {
    [Int]{
        ssl_tls12_sig_and_hash_alg(ssldefs.SSL_SIG_ECDSA, ssldefs.SSL_HASH_SHA256),
        ssl_tls12_sig_and_hash_alg(ssldefs.SSL_SIG_ECDSA, ssldefs.SSL_HASH_SHA384)
    }
}

/// Load the defaults of an endpoint, transport and preset into `conf`
/// (mbedtls_ssl_config_defaults); the other settings keep their values.
ssl_config_defaults: fn(conf: &ssldefs.SSLConfig, endpoint: Int, transport: Int, preset: Int) ssldefs.SSLError! {
    conf.endpoint = endpoint
    conf.transport = transport
    if endpoint == ssldefs.SSL_IS_CLIENT {
        conf.authmode = ssldefs.SSL_VERIFY_REQUIRED
        conf.session_tickets = ssldefs.SSL_SESSION_TICKETS_ENABLED
        conf.tls13_signal_new_session_tickets = ssldefs.SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_DISABLED
    }
    conf.encrypt_then_mac = ssldefs.SSL_ETM_ENABLED
    conf.extended_ms = ssldefs.SSL_EXTENDED_MS_ENABLED
    conf.f_cookie_write = Val(ssldefs.SSLCookieWrite{call: ssl_cookie_write_dummy})
    conf.f_cookie_check = Val(ssldefs.SSLCookieCheck{call: ssl_cookie_check_dummy})
    conf.anti_replay = ssldefs.SSL_ANTI_REPLAY_ENABLED
    conf.cert_req_ca_list = ssldefs.SSL_CERT_REQ_CA_LIST_ENABLED
    conf.respect_cli_pref = ssldefs.SSL_SRV_CIPHERSUITE_ORDER_SERVER
    conf.hs_timeout_min = ssldefs.SSL_DTLS_TIMEOUT_DFL_MIN
    conf.hs_timeout_max = ssldefs.SSL_DTLS_TIMEOUT_DFL_MAX
    conf.renego_max_records = ssldefs.SSL_RENEGO_MAX_RECORDS_DEFAULT
    conf.renego_period = [U8]{0x00, 0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF}
    if endpoint == ssldefs.SSL_IS_SERVER {
        ssl_conf_dh_param_bin(conf, dhm.RFC3526_MODP_2048_P, dhm.RFC3526_MODP_2048_G) ?? return Err(err)
    }
    conf.new_session_tickets_count = ssldefs.SSL_TLS1_3_DEFAULT_NEW_SESSION_TICKETS
    conf.tls13_kex_modes = ssldefs.SSL_TLS1_3_KEY_EXCHANGE_MODE_ALL
    conf.min_tls_version = ssldefs.SSL_VERSION_TLS1_2
    conf.max_tls_version = if transport == ssldefs.SSL_TRANSPORT_DATAGRAM -> ssldefs.SSL_VERSION_TLS1_2 else -> ssldefs.SSL_VERSION_TLS1_3
    tls12_only: ssl_conf_is_tls12_only(conf)
    if preset == ssldefs.SSL_PRESET_SUITEB {
        conf.ciphersuite_list = [Int]{suites.TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, suites.TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384}
        conf.cert_profile = x509crt.x509_crt_profile_suiteb()
        conf.sig_algs = if tls12_only -> ssl_tls12_preset_suiteb_sig_algs() else -> ssl_preset_suiteb_sig_algs()
        conf.group_list = ssl_preset_suiteb_groups()
        return
    }
    conf.ciphersuite_list = suites.ssl_list_ciphersuites()
    conf.cert_profile = x509crt.x509_crt_profile_default()
    conf.sig_algs = if tls12_only -> ssl_tls12_preset_default_sig_algs() else -> ssl_preset_default_sig_algs()
    conf.group_list = ssl_preset_default_groups()
    conf.dhm_min_bitlen = 1024
}

/// Whether mbedtls_ssl_set_hostname has been called, with a name or None
/// (mbedtls_ssl_has_set_hostname_been_called).
ssl_has_set_hostname_been_called: fn(ssl: ssldefs.SSLContext) -> Bool Never! {
    ssl.hostname != None || ssl.hostname_skip_cn
}

/// The hostname to send and verify, None when unset
/// (mbedtls_ssl_get_hostname_pointer).
ssl_get_hostname_pointer: fn(ssl: ssldefs.SSLContext) -> String? Never! {
    if ssl.hostname_skip_cn -> return None
    ssl.hostname
}

/// The server's name, for SNI and to check its certificate against;
/// None skips the check (mbedtls_ssl_set_hostname).
ssl_set_hostname: fn(ssl: &ssldefs.SSLContext, hostname: String?) ssldefs.SSLError! {
    if hostname == {
        .Val(h) -> { if h.bytes().len() > ssldefs.SSL_MAX_HOST_NAME_LEN -> return Err(.BadInputData) }
        None -> {}
    }
    ssl.hostname = hostname
    ssl.hostname_skip_cn = hostname == None
}

/// The application protocols to offer or accept, in preference order
/// (mbedtls_ssl_conf_alpn_protocols).
ssl_conf_alpn_protocols: fn(conf: &ssldefs.SSLConfig, protos: [String]) ssldefs.SSLError! {
    tot_len := 0
    loop p in protos {
        cur_len: p.bytes().len()
        tot_len += cur_len
        if cur_len == 0 || cur_len > ssldefs.SSL_MAX_ALPN_NAME_LEN || tot_len > ssldefs.SSL_MAX_ALPN_LIST_LEN -> return Err(.BadInputData)
    }
    conf.alpn_list = Val(protos)
}

/// The largest record to ask the peer for (mbedtls_ssl_conf_max_frag_len).
ssl_conf_max_frag_len: fn(conf: &ssldefs.SSLConfig, mfl_code: Int) ssldefs.SSLError! {
    if mfl_code < 0 || mfl_code >= ssldefs.SSL_MAX_FRAG_LEN_INVALID || ssl_mfl_code_to_length(mfl_code) > ssldefs.TLS_EXT_ADV_CONTENT_LEN -> return Err(.BadInputData)
    conf.mfl_code = mfl_code
}

/// Whether a TLS 1.2 client asks for session tickets
/// (mbedtls_ssl_conf_session_tickets).
ssl_conf_session_tickets: fn(conf: &ssldefs.SSLConfig, use_tickets: Bool) Never! {
    conf.session_tickets = conf.session_tickets.bit_and(-2)
    if use_tickets -> conf.session_tickets = conf.session_tickets.bit_or(1)
}

/// Whether a TLS 1.3 client reports NewSessionTicket messages to the
/// caller (mbedtls_ssl_conf_tls13_enable_signal_new_session_tickets).
ssl_conf_tls13_enable_signal_new_session_tickets: fn(conf: &ssldefs.SSLConfig, signal: Bool) Never! {
    conf.session_tickets = conf.session_tickets.bit_and(-3)
    if signal -> conf.session_tickets = conf.session_tickets.bit_or(2)
}

/// mbedtls_ssl_conf_get_session_tickets.
ssl_conf_get_session_tickets: fn(conf: ssldefs.SSLConfig) -> Int Never! {
    if conf.session_tickets.bit_and(1) != 0 -> return ssldefs.SSL_SESSION_TICKETS_ENABLED
    ssldefs.SSL_SESSION_TICKETS_DISABLED
}

/// mbedtls_ssl_conf_is_signal_new_session_tickets_enabled.
ssl_conf_is_signal_new_session_tickets_enabled: fn(conf: ssldefs.SSLConfig) -> Int Never! {
    if conf.session_tickets.bit_and(2) != 0 -> return ssldefs.SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_ENABLED
    ssldefs.SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_DISABLED
}

/// The TLS 1.3 key exchange modes to allow
/// (mbedtls_ssl_conf_tls13_key_exchange_modes).
ssl_conf_tls13_key_exchange_modes: fn(conf: &ssldefs.SSLConfig, kex_modes: Int) Never! {
    conf.tls13_kex_modes = kex_modes.bit_and(ssldefs.SSL_TLS1_3_KEY_EXCHANGE_MODE_ALL)
}

// ---------------------------------------------------------------------------
// Getters.

/// The peer certificate's verification flags, 0xFFFFFFFF before any
/// (mbedtls_ssl_get_verify_result).
ssl_get_verify_result: fn(ssl: ssldefs.SSLContext) -> Int Never! {
    if ssl.session >= 0 -> return ssl.spool[ssl.session].verify_result
    if ssl.session_negotiate >= 0 -> return ssl.spool[ssl.session_negotiate].verify_result
    0xFFFFFFFF
}

/// mbedtls_ssl_get_ciphersuite_id_from_ssl: 0 before a session.
ssl_get_ciphersuite_id_from_ssl: fn(ssl: ssldefs.SSLContext) -> Int Never! {
    if ssl.session < 0 -> return 0
    ssl.spool[ssl.session].ciphersuite
}

/// The session's ciphersuite name, None before a session
/// (mbedtls_ssl_get_ciphersuite).
ssl_get_ciphersuite: fn(ssl: ssldefs.SSLContext) -> String? Never! {
    if ssl.session < 0 -> return None
    Val(suites.ssl_get_ciphersuite_name(ssl.spool[ssl.session].ciphersuite))
}

/// The protocol version's name (mbedtls_ssl_get_version).
ssl_get_version: fn(ssl: ssldefs.SSLContext) -> String Never! {
    if sslmsg.ssl_is_dtls(ssl) {
        if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_2 -> return "DTLSv1.2"
        return "unknown (DTLS)"
    }
    if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_2 -> return "TLSv1.2"
    if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_3 -> return "TLSv1.3"
    "unknown"
}

/// The largest record the peer may send (mbedtls_ssl_get_input_max_frag_len).
ssl_get_input_max_frag_len: fn(ssl: ssldefs.SSLContext) -> Int Never! {
    max_len := ssldefs.SSL_IN_CONTENT_LEN
    // A TLS 1.2 client past ServerHelloDone uses the length it asked for.
    if ssl.conf.endpoint == ssldefs.SSL_IS_CLIENT && ssl.state >= ssldefs.SSL_SERVER_HELLO_DONE -> return ssl_mfl_code_to_length(ssl.conf.mfl_code)
    if ssl.session_out >= 0 {
        read_mfl: ssl_mfl_code_to_length(ssl.spool[ssl.session_out].mfl_code)
        if read_mfl < max_len -> max_len = read_mfl
    }
    if ssl.session_negotiate >= 0 {
        read_mfl: ssl_mfl_code_to_length(ssl.spool[ssl.session_negotiate].mfl_code)
        if read_mfl < max_len -> max_len = read_mfl
    }
    max_len
}

/// The largest record to send (mbedtls_ssl_get_output_max_frag_len).
ssl_get_output_max_frag_len: fn(ssl: ssldefs.SSLContext) -> Int Never! {
    max_len := ssl_mfl_code_to_length(ssl.conf.mfl_code)
    if ssl.session_out >= 0 {
        mfl: ssl_mfl_code_to_length(ssl.spool[ssl.session_out].mfl_code)
        if mfl < max_len -> max_len = mfl
    }
    if ssl.session_negotiate >= 0 {
        mfl: ssl_mfl_code_to_length(ssl.spool[ssl.session_negotiate].mfl_code)
        if mfl < max_len -> max_len = mfl
    }
    max_len
}

/// The path MTU in use: the smaller of the configured and the handshake's
/// fallback, 0 for none (mbedtls_ssl_get_current_mtu).
ssl_get_current_mtu: fn(ssl: ssldefs.SSLContext) -> Int Never! {
    if !ssl.has_handshake || ssl.handshake.mtu == 0 -> return ssl.mtu
    if ssl.mtu == 0 -> return ssl.handshake.mtu
    if ssl.mtu < ssl.handshake.mtu -> ssl.mtu else -> ssl.handshake.mtu
}

/// The most application data one record can carry
/// (mbedtls_ssl_get_max_out_record_payload).
ssl_get_max_out_record_payload: fn(ssl: ssldefs.SSLContext) -> Int ssldefs.SSLError! {
    max_len := ssldefs.SSL_OUT_CONTENT_LEN
    mfl: ssl_get_output_max_frag_len(ssl)
    if max_len > mfl -> max_len = mfl
    if ssl.transform_out >= 0 && ssl.tpool[ssl.transform_out].tls_version == ssldefs.SSL_VERSION_TLS1_3 {
        // TLSInnerPlaintext holds the content type and padding too.
        max_len = (max_len /% ssldefs.SSL_CID_TLS1_3_PADDING_GRANULARITY) * ssldefs.SSL_CID_TLS1_3_PADDING_GRANULARITY - 1
    }
    mtu: ssl_get_current_mtu(ssl)
    if mtu != 0 {
        overhead: sslmsg.ssl_get_record_expansion(ssl) ?? return Err(err)
        if mtu <= overhead -> return Err(.FeatureUnavailable)
        if max_len > mtu - overhead -> max_len = mtu - overhead
    }
    Ok(max_len)
}

/// The most application data one received record can carry
/// (mbedtls_ssl_get_max_in_record_payload).
ssl_get_max_in_record_payload: fn(ssl: ssldefs.SSLContext) -> Int Never! {
    max_len := ssldefs.SSL_IN_CONTENT_LEN
    mfl: ssl_get_input_max_frag_len(ssl)
    if max_len > mfl -> max_len = mfl
    max_len
}

/// The DER of each certificate of the peer's chain, None before a session
/// or without one (mbedtls_ssl_get_peer_cert, which C returns in place; the
/// parsed chain stays in ssl.spool[ssl.session].peer_cert).
ssl_get_peer_cert_der: fn(ssl: ssldefs.SSLContext) -> [[U8]]? Never! {
    if ssl.session < 0 -> return None
    if ssl.spool[ssl.session].peer_cert == {
        .Val(chain) -> {
            out := [[U8]]{}
            loop crt in chain -> out.push(crt.raw.copy())
            Val(out)
        }
        None -> None
    }
}

/// A copy of the session to resume later; each session can be taken once
/// (mbedtls_ssl_get_session).
ssl_get_session: fn(ssl: &ssldefs.SSLContext, dst: &ssldefs.SSLSession) ssldefs.SSLError! {
    if ssl.session < 0 || ssl.conf.endpoint != ssldefs.SSL_IS_CLIENT -> return Err(.BadInputData)
    if ssl.spool[ssl.session].exported == 1 -> return Err(.FeatureUnavailable)
    ssl_session_copy(dst, ssl.spool[ssl.session]) ?? return Err(err)
    ssl.spool[ssl.session].exported = 1
}

// ---------------------------------------------------------------------------
// Extensions.

/// The bit an extension has in the sent and received masks
/// (mbedtls_ssl_get_extension_id).
ssl_get_extension_id: fn(extension_type: Int) -> Int Never! {
    if extension_type == ssldefs.TLS_EXT_SERVERNAME -> return ssldefs.SSL_EXT_ID_SERVERNAME
    if extension_type == ssldefs.TLS_EXT_MAX_FRAGMENT_LENGTH -> return ssldefs.SSL_EXT_ID_MAX_FRAGMENT_LENGTH
    if extension_type == ssldefs.TLS_EXT_STATUS_REQUEST -> return ssldefs.SSL_EXT_ID_STATUS_REQUEST
    if extension_type == ssldefs.TLS_EXT_SUPPORTED_GROUPS -> return ssldefs.SSL_EXT_ID_SUPPORTED_GROUPS
    if extension_type == ssldefs.TLS_EXT_SIG_ALG -> return ssldefs.SSL_EXT_ID_SIG_ALG
    if extension_type == ssldefs.TLS_EXT_USE_SRTP -> return ssldefs.SSL_EXT_ID_USE_SRTP
    if extension_type == ssldefs.TLS_EXT_HEARTBEAT -> return ssldefs.SSL_EXT_ID_HEARTBEAT
    if extension_type == ssldefs.TLS_EXT_ALPN -> return ssldefs.SSL_EXT_ID_ALPN
    if extension_type == ssldefs.TLS_EXT_SCT -> return ssldefs.SSL_EXT_ID_SCT
    if extension_type == ssldefs.TLS_EXT_CLI_CERT_TYPE -> return ssldefs.SSL_EXT_ID_CLI_CERT_TYPE
    if extension_type == ssldefs.TLS_EXT_SERV_CERT_TYPE -> return ssldefs.SSL_EXT_ID_SERV_CERT_TYPE
    if extension_type == ssldefs.TLS_EXT_PADDING -> return ssldefs.SSL_EXT_ID_PADDING
    if extension_type == ssldefs.TLS_EXT_PRE_SHARED_KEY -> return ssldefs.SSL_EXT_ID_PRE_SHARED_KEY
    if extension_type == ssldefs.TLS_EXT_EARLY_DATA -> return ssldefs.SSL_EXT_ID_EARLY_DATA
    if extension_type == ssldefs.TLS_EXT_SUPPORTED_VERSIONS -> return ssldefs.SSL_EXT_ID_SUPPORTED_VERSIONS
    if extension_type == ssldefs.TLS_EXT_COOKIE -> return ssldefs.SSL_EXT_ID_COOKIE
    if extension_type == ssldefs.TLS_EXT_PSK_KEY_EXCHANGE_MODES -> return ssldefs.SSL_EXT_ID_PSK_KEY_EXCHANGE_MODES
    if extension_type == ssldefs.TLS_EXT_CERT_AUTH -> return ssldefs.SSL_EXT_ID_CERT_AUTH
    if extension_type == ssldefs.TLS_EXT_OID_FILTERS -> return ssldefs.SSL_EXT_ID_OID_FILTERS
    if extension_type == ssldefs.TLS_EXT_POST_HANDSHAKE_AUTH -> return ssldefs.SSL_EXT_ID_POST_HANDSHAKE_AUTH
    if extension_type == ssldefs.TLS_EXT_SIG_ALG_CERT -> return ssldefs.SSL_EXT_ID_SIG_ALG_CERT
    if extension_type == ssldefs.TLS_EXT_KEY_SHARE -> return ssldefs.SSL_EXT_ID_KEY_SHARE
    if extension_type == ssldefs.TLS_EXT_TRUNCATED_HMAC -> return ssldefs.SSL_EXT_ID_TRUNCATED_HMAC
    if extension_type == ssldefs.TLS_EXT_SUPPORTED_POINT_FORMATS -> return ssldefs.SSL_EXT_ID_SUPPORTED_POINT_FORMATS
    if extension_type == ssldefs.TLS_EXT_ENCRYPT_THEN_MAC -> return ssldefs.SSL_EXT_ID_ENCRYPT_THEN_MAC
    if extension_type == ssldefs.TLS_EXT_EXTENDED_MASTER_SECRET -> return ssldefs.SSL_EXT_ID_EXTENDED_MASTER_SECRET
    if extension_type == ssldefs.TLS_EXT_RECORD_SIZE_LIMIT -> return ssldefs.SSL_EXT_ID_RECORD_SIZE_LIMIT
    if extension_type == ssldefs.TLS_EXT_SESSION_TICKET -> return ssldefs.SSL_EXT_ID_SESSION_TICKET
    ssldefs.SSL_EXT_ID_UNRECOGNIZED
}

/// mbedtls_ssl_get_extension_mask.
ssl_get_extension_mask: fn(extension_type: Int) -> Int Never! { 1 << ssl_get_extension_id(extension_type) }

/// Record a TLS 1.3 extension as sent (mbedtls_ssl_tls13_set_hs_sent_ext_mask).
ssl_tls13_set_hs_sent_ext_mask: fn(ssl: &ssldefs.SSLContext, extension_type: Int) Never! {
    ssl.handshake.sent_extensions = ssl.handshake.sent_extensions.bit_or(ssl_get_extension_mask(extension_type))
}

// ---------------------------------------------------------------------------
// Signature algorithms, hashes and groups.

/// The TLS 1.2 signature byte of a key (mbedtls_ssl_sig_from_pk).
ssl_sig_from_pk: fn(key: pk.PKContext) -> Int Never! {
    if pk.pk_can_do(key, .RSA) -> return ssldefs.SSL_SIG_RSA
    if pk.pk_can_do(key, .ECDSA) -> return ssldefs.SSL_SIG_ECDSA
    ssldefs.SSL_SIG_ANON
}

/// mbedtls_ssl_sig_from_pk_alg.
ssl_sig_from_pk_alg: fn(kind: oids.PKType?) -> Int Never! {
    t: kind ?? return ssldefs.SSL_SIG_ANON
    if t == {
        .RSA -> ssldefs.SSL_SIG_RSA
        .ECDSA | .ECKey -> ssldefs.SSL_SIG_ECDSA
        else -> ssldefs.SSL_SIG_ANON
    }
}

/// The key type of a TLS 1.2 signature byte, None for MBEDTLS_PK_NONE
/// (mbedtls_ssl_pk_alg_from_sig).
ssl_pk_alg_from_sig: fn(sig: Int) -> oids.PKType? Never! {
    if sig == ssldefs.SSL_SIG_RSA -> return Val(oids.PKType.RSA)
    if sig == ssldefs.SSL_SIG_ECDSA -> return Val(oids.PKType.ECDSA)
    None
}

/// The digest of a TLS 1.2 hash byte, None for MBEDTLS_MD_NONE
/// (mbedtls_ssl_md_alg_from_hash).
ssl_md_alg_from_hash: fn(hash: Int) -> hashes.Md? Never! {
    if hash == ssldefs.SSL_HASH_MD5 -> return Val(hashes.Md.MD5)
    if hash == ssldefs.SSL_HASH_SHA1 -> return Val(hashes.Md.SHA1)
    if hash == ssldefs.SSL_HASH_SHA224 -> return Val(hashes.Md.SHA224)
    if hash == ssldefs.SSL_HASH_SHA256 -> return Val(hashes.Md.SHA256)
    if hash == ssldefs.SSL_HASH_SHA384 -> return Val(hashes.Md.SHA384)
    if hash == ssldefs.SSL_HASH_SHA512 -> return Val(hashes.Md.SHA512)
    None
}

/// The TLS 1.2 hash byte of a digest (mbedtls_ssl_hash_from_md_alg).
ssl_hash_from_md_alg: fn(md: hashes.Md?) -> Int Never! {
    m: md ?? return ssldefs.SSL_HASH_NONE
    if m == {
        .MD5 -> ssldefs.SSL_HASH_MD5
        .SHA1 -> ssldefs.SSL_HASH_SHA1
        .SHA224 -> ssldefs.SSL_HASH_SHA224
        .SHA256 -> ssldefs.SSL_HASH_SHA256
        .SHA384 -> ssldefs.SSL_HASH_SHA384
        .SHA512 -> ssldefs.SSL_HASH_SHA512
        else -> ssldefs.SSL_HASH_NONE
    }
}

/// The configured groups (mbedtls_ssl_get_groups).
ssl_get_groups: fn(ssl: ssldefs.SSLContext) -> [Int] Never! { ssl.conf.group_list }

/// Whether a group the peer proposed is configured
/// (mbedtls_ssl_check_curve_tls_id, true where C returns 0).
ssl_check_curve_tls_id: fn(ssl: ssldefs.SSLContext, tls_id: Int) -> Bool Never! {
    loop g in ssl_get_groups(ssl) {
        if g == tls_id -> return true
    }
    false
}

/// ssl_check_curve_tls_id for a curve (mbedtls_ssl_check_curve).
ssl_check_curve: fn(ssl: ssldefs.SSLContext, grp_id: ecp.GroupID) -> Bool Never! {
    tls_id: ssl_get_tls_id_from_ecp_group_id(grp_id)
    if tls_id == 0 -> return false
    ssl_check_curve_tls_id(ssl, tls_id)
}

/// The curve of a TLS group ID, Unknown for none
/// (mbedtls_ssl_get_ecp_group_id_from_tls_id over tls_id_match_table).
ssl_get_ecp_group_id_from_tls_id: fn(tls_id: Int) -> ecp.GroupID Never! {
    if tls_id == 25 -> return .Secp521r1
    if tls_id == 28 -> return .Bp512r1
    if tls_id == 24 -> return .Secp384r1
    if tls_id == 27 -> return .Bp384r1
    if tls_id == 23 -> return .Secp256r1
    if tls_id == 22 -> return .Secp256k1
    if tls_id == 26 -> return .Bp256r1
    if tls_id == 21 -> return .Secp224r1
    if tls_id == 20 -> return .Secp224k1
    if tls_id == 19 -> return .Secp192r1
    if tls_id == 18 -> return .Secp192k1
    if tls_id == 29 -> return .Curve25519
    if tls_id == 30 -> return ecp.GroupID.Curve448
    ecp.GroupID.Unknown
}

/// The TLS group ID of a curve, 0 for none
/// (mbedtls_ssl_get_tls_id_from_ecp_group_id).
ssl_get_tls_id_from_ecp_group_id: fn(grp_id: ecp.GroupID) -> Int Never! {
    if grp_id == {
        .Secp521r1 -> 25
        .Bp512r1 -> 28
        .Secp384r1 -> 24
        .Bp384r1 -> 27
        .Secp256r1 -> 23
        .Secp256k1 -> 22
        .Bp256r1 -> 26
        .Secp224r1 -> 21
        .Secp224k1 -> 20
        .Secp192r1 -> 19
        .Secp192k1 -> 18
        .Curve25519 -> 29
        .Curve448 -> 30
        else -> 0
    }
}

/// Whether a group is an elliptic curve TLS 1.2 can use for ECDHE
/// (mbedtls_ssl_tls12_named_group_is_ecdhe; RFC 8422 5.1.1).
ssl_tls12_named_group_is_ecdhe: fn(g: Int) -> Bool Never! {
    g == ssldefs.SSL_IANA_TLS_GROUP_X25519 || g == ssldefs.SSL_IANA_TLS_GROUP_BP256R1 || g == ssldefs.SSL_IANA_TLS_GROUP_BP384R1 || g == ssldefs.SSL_IANA_TLS_GROUP_BP512R1 || g == ssldefs.SSL_IANA_TLS_GROUP_X448 || g == ssldefs.SSL_IANA_TLS_GROUP_SECP192K1 || g == ssldefs.SSL_IANA_TLS_GROUP_SECP192R1 || g == ssldefs.SSL_IANA_TLS_GROUP_SECP224K1 || g == ssldefs.SSL_IANA_TLS_GROUP_SECP224R1 || g == ssldefs.SSL_IANA_TLS_GROUP_SECP256K1 || g == ssldefs.SSL_IANA_TLS_GROUP_SECP256R1 || g == ssldefs.SSL_IANA_TLS_GROUP_SECP384R1 || g == ssldefs.SSL_IANA_TLS_GROUP_SECP521R1
}

/// mbedtls_ssl_tls13_named_group_is_ecdhe.
ssl_tls13_named_group_is_ecdhe: fn(g: Int) -> Bool Never! {
    g == ssldefs.SSL_IANA_TLS_GROUP_X25519 || g == ssldefs.SSL_IANA_TLS_GROUP_SECP256R1 || g == ssldefs.SSL_IANA_TLS_GROUP_SECP384R1 || g == ssldefs.SSL_IANA_TLS_GROUP_SECP521R1 || g == ssldefs.SSL_IANA_TLS_GROUP_X448
}

/// mbedtls_ssl_tls13_named_group_is_ffdh.
ssl_tls13_named_group_is_ffdh: fn(g: Int) -> Bool Never! {
    g >= ssldefs.SSL_IANA_TLS_GROUP_FFDHE2048 && g <= ssldefs.SSL_IANA_TLS_GROUP_FFDHE8192
}

/// Whether a group is configured (mbedtls_ssl_named_group_is_offered).
ssl_named_group_is_offered: fn(ssl: ssldefs.SSLContext, g: Int) -> Bool Never! { ssl_check_curve_tls_id(ssl, g) }

/// Whether TLS 1.3 can agree a key over a group
/// (mbedtls_ssl_named_group_is_supported).
ssl_named_group_is_supported: fn(g: Int) -> Bool Never! {
    if ssl_tls13_named_group_is_ecdhe(g) && ssl_get_ecp_group_id_from_tls_id(g) != .Unknown -> return true
    ssl_tls13_named_group_is_ffdh(g)
}

/// The configured signature algorithms (mbedtls_ssl_get_sig_algs).
ssl_get_sig_algs: fn(ssl: ssldefs.SSLContext) -> [Int] Never! { ssl.conf.sig_algs }

/// Whether the peer offered a signature algorithm
/// (mbedtls_ssl_sig_alg_is_received).
ssl_sig_alg_is_received: fn(ssl: ssldefs.SSLContext, own_sig_alg: Int) -> Bool Never! {
    loop s in ssl.handshake.received_sig_algs {
        if s == own_sig_alg -> return true
    }
    false
}

/// mbedtls_ssl_tls13_sig_alg_for_cert_verify_is_supported.
ssl_tls13_sig_alg_for_cert_verify_is_supported: fn(sig_alg: Int) -> Bool Never! {
    sig_alg == ssldefs.TLS1_3_SIG_ECDSA_SECP256R1_SHA256 || sig_alg == ssldefs.TLS1_3_SIG_ECDSA_SECP384R1_SHA384 || sig_alg == ssldefs.TLS1_3_SIG_ECDSA_SECP521R1_SHA512 || sig_alg == ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA256 || sig_alg == ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA384 || sig_alg == ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA512
}

/// The curve a TLS 1.3 ECDSA signature algorithm names, Unknown for an
/// algorithm that names none.
ssl_tls13_sig_alg_curve: fn(sig_alg: Int) -> ecp.GroupID Never! {
    if sig_alg == ssldefs.TLS1_3_SIG_ECDSA_SECP256R1_SHA256 -> return .Secp256r1
    if sig_alg == ssldefs.TLS1_3_SIG_ECDSA_SECP384R1_SHA384 -> return .Secp384r1
    if sig_alg == ssldefs.TLS1_3_SIG_ECDSA_SECP521R1_SHA512 -> return .Secp521r1
    ecp.GroupID.Unknown
}

/// mbedtls_ssl_tls13_sig_alg_is_supported.
ssl_tls13_sig_alg_is_supported: fn(sig_alg: Int) -> Bool Never! {
    if sig_alg == ssldefs.TLS1_3_SIG_RSA_PKCS1_SHA256 || sig_alg == ssldefs.TLS1_3_SIG_RSA_PKCS1_SHA384 || sig_alg == ssldefs.TLS1_3_SIG_RSA_PKCS1_SHA512 -> return true
    ssl_tls13_sig_alg_for_cert_verify_is_supported(sig_alg)
}

/// Whether a signature algorithm is configured
/// (mbedtls_ssl_sig_alg_is_offered).
ssl_sig_alg_is_offered: fn(ssl: ssldefs.SSLContext, proposed_sig_alg: Int) -> Bool Never! {
    loop s in ssl_get_sig_algs(ssl) {
        if s == proposed_sig_alg -> return true
    }
    false
}

/// A signature algorithm's key type and digest.
SSLSigAlgParts: struct {
    pk_type: oids.PKType
    md_alg: hashes.Md
}

/// The key type and digest of a signature algorithm
/// (mbedtls_ssl_get_pk_type_and_md_alg_from_sig_alg).
ssl_get_pk_type_and_md_alg_from_sig_alg: fn(sig_alg: Int) -> SSLSigAlgParts ssldefs.SSLError! {
    if ssl_pk_alg_from_sig(sig_alg.bit_and(0xFF)) == {
        .Val(kind) -> {
            if ssl_md_alg_from_hash((sig_alg >> 8).bit_and(0xFF)) == {
                .Val(md) -> return Ok(SSLSigAlgParts{pk_type: kind, md_alg: md})
                None -> {}
            }
        }
        None -> {}
    }
    if sig_alg == ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA256 -> return Ok(SSLSigAlgParts{pk_type: .RSASSAPSS, md_alg: .SHA256})
    if sig_alg == ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA384 -> return Ok(SSLSigAlgParts{pk_type: .RSASSAPSS, md_alg: .SHA384})
    if sig_alg == ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA512 -> return Ok(SSLSigAlgParts{pk_type: .RSASSAPSS, md_alg: .SHA512})
    Err(.FeatureUnavailable)
}

/// mbedtls_ssl_tls12_sig_alg_is_supported: an MD5 to SHA-512 hash with
/// RSA or ECDSA.
ssl_tls12_sig_alg_is_supported: fn(sig_alg: Int) -> Bool Never! {
    hash: (sig_alg >> 8).bit_and(0xFF)
    sig: sig_alg.bit_and(0xFF)
    if hash < ssldefs.SSL_HASH_MD5 || hash > ssldefs.SSL_HASH_SHA512 -> return false
    sig == ssldefs.SSL_SIG_RSA || sig == ssldefs.SSL_SIG_ECDSA
}

/// Whether the protocol version in use can sign with an algorithm
/// (mbedtls_ssl_sig_alg_is_supported).
ssl_sig_alg_is_supported: fn(ssl: ssldefs.SSLContext, sig_alg: Int) -> Bool Never! {
    if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_2 -> return ssl_tls12_sig_alg_is_supported(sig_alg)
    if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_3 -> return ssl_tls13_sig_alg_is_supported(sig_alg)
    false
}

/// Whether a TLS 1.3 ciphersuite was offered
/// (mbedtls_ssl_tls13_cipher_suite_is_offered).
ssl_tls13_cipher_suite_is_offered: fn(ssl: ssldefs.SSLContext, cipher_suite: Int) -> Bool Never! {
    loop id in ssl.conf.ciphersuite_list {
        if id == cipher_suite -> return true
    }
    false
}

// ---------------------------------------------------------------------------
// TLS 1.3 key exchange modes and ticket flags (ssl_misc.h).

/// mbedtls_ssl_conf_tls13_is_kex_mode_enabled.
ssl_conf_tls13_is_kex_mode_enabled: fn(ssl: ssldefs.SSLContext, mask: Int) -> Bool Never! { ssl.conf.tls13_kex_modes.bit_and(mask) != 0 }

/// mbedtls_ssl_conf_tls13_is_psk_enabled.
ssl_conf_tls13_is_psk_enabled: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl_conf_tls13_is_kex_mode_enabled(ssl, ssldefs.SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK) }

/// mbedtls_ssl_conf_tls13_is_psk_ephemeral_enabled.
ssl_conf_tls13_is_psk_ephemeral_enabled: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl_conf_tls13_is_kex_mode_enabled(ssl, ssldefs.SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL) }

/// mbedtls_ssl_conf_tls13_is_ephemeral_enabled.
ssl_conf_tls13_is_ephemeral_enabled: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl_conf_tls13_is_kex_mode_enabled(ssl, ssldefs.SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL) }

/// mbedtls_ssl_conf_tls13_is_some_ephemeral_enabled.
ssl_conf_tls13_is_some_ephemeral_enabled: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl_conf_tls13_is_kex_mode_enabled(ssl, ssldefs.SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ALL) }

/// mbedtls_ssl_conf_tls13_is_some_psk_enabled.
ssl_conf_tls13_is_some_psk_enabled: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl_conf_tls13_is_kex_mode_enabled(ssl, ssldefs.SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ALL) }

/// mbedtls_ssl_tls13_is_kex_mode_supported: a mode both sides allow.
ssl_tls13_is_kex_mode_supported: fn(ssl: ssldefs.SSLContext, mask: Int) -> Bool Never! { ssl.handshake.tls13_kex_modes.bit_and(mask) != 0 }

/// mbedtls_ssl_tls13_is_psk_supported.
ssl_tls13_is_psk_supported: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl_tls13_is_kex_mode_supported(ssl, ssldefs.SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK) }

/// mbedtls_ssl_tls13_is_psk_ephemeral_supported.
ssl_tls13_is_psk_ephemeral_supported: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl_tls13_is_kex_mode_supported(ssl, ssldefs.SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL) }

/// mbedtls_ssl_tls13_is_ephemeral_supported.
ssl_tls13_is_ephemeral_supported: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl_tls13_is_kex_mode_supported(ssl, ssldefs.SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL) }

/// mbedtls_ssl_tls13_is_some_ephemeral_supported.
ssl_tls13_is_some_ephemeral_supported: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl_tls13_is_kex_mode_supported(ssl, ssldefs.SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ALL) }

/// mbedtls_ssl_tls13_is_some_psk_supported.
ssl_tls13_is_some_psk_supported: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl_tls13_is_kex_mode_supported(ssl, ssldefs.SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ALL) }

/// mbedtls_ssl_tls13_key_exchange_mode_check: the negotiated mode.
ssl_tls13_key_exchange_mode_check: fn(ssl: ssldefs.SSLContext, mask: Int) -> Bool Never! { ssl.handshake.key_exchange_mode.bit_and(mask) != 0 }

/// mbedtls_ssl_tls13_key_exchange_mode_with_psk.
ssl_tls13_key_exchange_mode_with_psk: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl_tls13_key_exchange_mode_check(ssl, ssldefs.SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ALL) }

/// mbedtls_ssl_tls13_key_exchange_mode_with_ephemeral.
ssl_tls13_key_exchange_mode_with_ephemeral: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl_tls13_key_exchange_mode_check(ssl, ssldefs.SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ALL) }

/// mbedtls_ssl_tls13_session_get_ticket_flags.
ssl_tls13_session_get_ticket_flags: fn(session: ssldefs.SSLSession, flags: Int) -> Int Never! {
    session.ticket_flags.bit_and(flags).bit_and(ssldefs.SSL_TLS1_3_TICKET_FLAGS_MASK)
}

/// mbedtls_ssl_tls13_session_ticket_has_flags.
ssl_tls13_session_ticket_has_flags: fn(session: ssldefs.SSLSession, flags: Int) -> Bool Never! { ssl_tls13_session_get_ticket_flags(session, flags) != 0 }

/// mbedtls_ssl_tls13_session_ticket_allow_psk.
ssl_tls13_session_ticket_allow_psk: fn(session: ssldefs.SSLSession) -> Bool Never! { ssl_tls13_session_ticket_has_flags(session, ssldefs.SSL_TLS1_3_TICKET_ALLOW_PSK_RESUMPTION) }

/// mbedtls_ssl_tls13_session_ticket_allow_psk_ephemeral.
ssl_tls13_session_ticket_allow_psk_ephemeral: fn(session: ssldefs.SSLSession) -> Bool Never! { ssl_tls13_session_ticket_has_flags(session, ssldefs.SSL_TLS1_3_TICKET_ALLOW_PSK_EPHEMERAL_RESUMPTION) }

/// mbedtls_ssl_tls13_session_set_ticket_flags.
ssl_tls13_session_set_ticket_flags: fn(session: &ssldefs.SSLSession, flags: Int) Never! {
    session.ticket_flags = session.ticket_flags.bit_or(flags.bit_and(ssldefs.SSL_TLS1_3_TICKET_FLAGS_MASK))
}

/// mbedtls_ssl_tls13_session_clear_ticket_flags.
ssl_tls13_session_clear_ticket_flags: fn(session: &ssldefs.SSLSession, flags: Int) Never! {
    session.ticket_flags = session.ticket_flags.bit_and(flags.bit_and(ssldefs.SSL_TLS1_3_TICKET_FLAGS_MASK).bit_not())
}

/// Whether a record transform is AEAD (mbedtls_ssl_transform_uses_aead).
ssl_transform_uses_aead: fn(t: ssldefs.SSLTransform) -> Bool Never! { t.maclen == 0 && t.taglen != 0 }

// ---------------------------------------------------------------------------
// Buffer bounds.

/// Whether `need` bytes fit between the offsets `cur` and `end`
/// (mbedtls_ssl_chk_buf_ptr, true where it returns 0).
ssl_chk_buf_ptr: fn(cur: Int, end: Int, need: Int) -> Bool Never! { cur <= end && need <= end - cur }

/// BufferTooSmall unless `need` bytes fit (MBEDTLS_SSL_CHK_BUF_PTR).
ssl_chk_buf: fn(cur: Int, end: Int, need: Int) ssldefs.SSLError! {
    if !ssl_chk_buf_ptr(cur, end, need) -> return Err(.BufferTooSmall)
}

/// DecodeError, with a decode_error alert pending, unless `need` bytes are
/// left to read (MBEDTLS_SSL_CHK_BUF_READ_PTR).
ssl_chk_buf_read: fn(ssl: &ssldefs.SSLContext, cur: Int, end: Int, need: Int) ssldefs.SSLError! {
    if !ssl_chk_buf_ptr(cur, end, need) {
        sslmsg.ssl_pend_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError)
        return Err(.DecodeError)
    }
}

/// Send a fatal alert where C ignores whether it could be sent.
ssl_send_fatal_alert: fn<R: RNG>(ssl: &ssldefs.SSLContext, message: Int, rng: &R) Never! {
    sslmsg.ssl_send_alert_message(ssl, ssldefs.SSL_ALERT_LEVEL_FATAL, message, rng) ?? ()
}

// ---------------------------------------------------------------------------
// The handshake driver and renegotiation.

// Flush what is pending, and go on sending a DTLS flight being sent
// (ssl_prepare_handshake_step).
ssl_prepare_handshake_step: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    sslmsg.ssl_flush_output(ssl) ?? return Err(err)
    if sslmsg.ssl_is_dtls(ssl) && ssl.handshake.retransmit_state == ssldefs.SSL_RETRANS_SENDING {
        sslmsg.ssl_flight_transmit(ssl, rng) ?? return Err(err)
    }
}

// The step for the endpoint and protocol version, C's dispatch in
// mbedtls_ssl_handshake_step: BadInputData for an endpoint that is neither.
ssl_handshake_step_endpoint: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    if ssl.conf.endpoint == ssldefs.SSL_IS_CLIENT {
        if ssl.state == ssldefs.SSL_HELLO_REQUEST {
            sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_CLIENT_HELLO)
            return
        }
        if ssl.state == ssldefs.SSL_CLIENT_HELLO -> return sslcli.ssl_write_client_hello(ssl, rng)
        if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_3 -> return cli13.ssl_tls13_handshake_client_step(ssl, rng)
        return cli12.ssl_handshake_client_step(ssl, rng)
    }
    if ssl.conf.endpoint == ssldefs.SSL_IS_SERVER {
        if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_3 -> return srv13.ssl_tls13_handshake_server_step(ssl, rng)
        return srv12.ssl_handshake_server_step(ssl, rng)
    }
    Err(.BadInputData)
}

/// Perform one step of the handshake (mbedtls_ssl_handshake_step). A step
/// that fails with a fatal alert pending sends it, and fails with the
/// alert's reason. When a TLS 1.3 step ends the handshake, what the
/// handshake holds is freed: its secrets, key shares, transcript and
/// handshake transform. The empty structure stays for the post-handshake
/// NewSessionTicket, as mbedtls keeps the structure itself until ssl_free.
ssl_handshake_step: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    if !ssl.has_conf || !ssl.has_handshake || ssl.state == ssldefs.SSL_HANDSHAKE_OVER -> return Err(.BadInputData)
    ssl_prepare_handshake_step(ssl, rng) ?? return Err(err)
    sslmsg.ssl_handle_pending_alert(ssl, rng) ?? return Err(err)
    if ssl_handshake_step_endpoint(ssl, rng) == {
        .Err(e) -> {
            if ssl.send_alert != 0 -> return sslmsg.ssl_handle_pending_alert(ssl, rng)
            return Err(e)
        }
        else -> {}
    }
    if ssl.state == ssldefs.SSL_HANDSHAKE_OVER && ssl.tls_version == ssldefs.SSL_VERSION_TLS1_3 -> ssl_handshake_free(ssl)
}

/// Perform the handshake to its end (mbedtls_ssl_handshake). DTLS needs the
/// timer (ssl_set_timer_cb).
ssl_handshake: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    if !ssl.has_conf -> return Err(.BadInputData)
    if sslmsg.ssl_is_dtls(ssl) && !ssl.timer.enabled -> return Err(.BadInputData)
    loop ssl.state != ssldefs.SSL_HANDSHAKE_OVER {
        ssl_handshake_step(ssl, rng) ?? return Err(err)
    }
}

// Write a HelloRequest (ssl_write_hello_request).
ssl_write_hello_request: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    ssl.out_msglen = 4
    ssl.out_msgtype = ssldefs.SSL_MSG_HANDSHAKE
    ssl.out_buf[ssl.out_msg] = ssldefs.ssl_byte(ssldefs.SSL_HS_HELLO_REQUEST)
    sslmsg.ssl_write_handshake_msg(ssl, rng) ?? return Err(err)
}

/// Start a renegotiation on the client, or on the server once the client
/// asked for one (mbedtls_ssl_start_renegotiation).
ssl_start_renegotiation: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    ssl_handshake_init(ssl)
    // RFC 6347 4.2.2: the HelloRequest has message_seq 0, so the
    // ServerHello that answers it has 1.
    if sslmsg.ssl_is_dtls(ssl) && ssl.renego_status == ssldefs.SSL_RENEGOTIATION_PENDING {
        if ssl.conf.endpoint == ssldefs.SSL_IS_SERVER -> ssl.handshake.out_msg_seq = 1 else -> ssl.handshake.in_msg_seq = 1
    }
    sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_HELLO_REQUEST)
    ssl.renego_status = ssldefs.SSL_RENEGOTIATION_IN_PROGRESS
    ssl_handshake(ssl, rng) ?? return Err(err)
}

/// Ask for a renegotiation, or go on with one (mbedtls_ssl_renegotiate): a
/// server sends a HelloRequest, a client starts the handshake.
ssl_renegotiate: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    if !ssl.has_conf -> return Err(.BadInputData)
    if ssl.conf.endpoint == ssldefs.SSL_IS_SERVER {
        if !sslmsg.ssl_is_handshake_over(ssl) -> return Err(.BadInputData)
        ssl.renego_status = ssldefs.SSL_RENEGOTIATION_PENDING
        // A HelloRequest written before is still to go.
        if ssl.out_left != 0 -> return sslmsg.ssl_flush_output(ssl)
        return ssl_write_hello_request(ssl, rng)
    }
    if ssl.renego_status != ssldefs.SSL_RENEGOTIATION_IN_PROGRESS {
        if !sslmsg.ssl_is_handshake_over(ssl) -> return Err(.BadInputData)
        return ssl_start_renegotiation(ssl, rng)
    }
    ssl_handshake(ssl, rng) ?? return Err(err)
}

/// Resend a DTLS HelloRequest the client has not answered
/// (mbedtls_ssl_resend_hello_request). Without an enforced limit it is
/// resent for as many records as the retransmission timeout takes to
/// double from its minimum to its maximum.
ssl_resend_hello_request: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    if ssl.conf.renego_max_records < 0 {
        ratio := ssl.conf.hs_timeout_max /% ssl.conf.hs_timeout_min + 1
        doublings := 1
        loop ratio != 0 {
            doublings += 1
            ratio = ratio >> 1
        }
        ssl.renego_records_seen += 1
        if ssl.renego_records_seen > doublings -> return
    }
    ssl_write_hello_request(ssl, rng) ?? return Err(err)
}

// ---------------------------------------------------------------------------
// The TLS 1.2 PRF, master secret and key derivation.

/// P_hash(secret, label || random) cut to `dlen` bytes, the TLS 1.2 PRF under
/// `md` (tls_prf_generic, RFC 5246 5).
ssl_tls_prf_generic: fn(md: hashes.Md, secret: [U8], label: [U8], random: [U8], dlen: Int) -> [U8] Never! {
    md_len: hashes.md_size(md)
    key: hashes.hmac_key(md, secret)
    // A(1) = HMAC(secret, label || random).
    first := hashes.hash_clone(key.inner)
    hashes.hash_update(first, label)
    hashes.hash_update(first, random)
    a := hashes.hmac_finish(key, first)
    out := [U8]{}
    i := 0
    loop i < dlen {
        // HMAC(secret, A(i) || label || random), then A(i + 1) = HMAC(secret, A(i)).
        inner := hashes.hash_clone(key.inner)
        hashes.hash_update(inner, a)
        hashes.hash_update(inner, label)
        hashes.hash_update(inner, random)
        h_i := hashes.hmac_finish(key, inner)
        next_a := hashes.hmac_mac(key, a)
        ssldefs.ssl_wipe(a)
        a = next_a
        k: if i + md_len > dlen -> dlen %% md_len else -> md_len
        loop j in 0..<k -> out.push(h_i[j])
        ssldefs.ssl_wipe(h_i)
        i += md_len
    }
    ssldefs.ssl_wipe(a)
    out
}

/// The TLS 1.2 PRF of type `prf`, SSL_TLS_PRF_SHA384 or SSL_TLS_PRF_SHA256
/// (mbedtls_ssl_tls_prf); FeatureUnavailable for any other.
ssl_tls_prf: fn(prf: Int, secret: [U8], label: [U8], random: [U8], dlen: Int) -> [U8] ssldefs.SSLError! {
    if prf == ssldefs.SSL_TLS_PRF_SHA384 -> return Ok(ssl_tls_prf_generic(.SHA384, secret, label, random, dlen))
    if prf == ssldefs.SSL_TLS_PRF_SHA256 -> return Ok(ssl_tls_prf_generic(.SHA256, secret, label, random, dlen))
    Err(.FeatureUnavailable)
}

// The PRF type of a PRF digest (tls_prf_get_type).
ssl_tls_prf_get_type: fn(md: hashes.Md?) -> Int Never! {
    if md == {
        .Val(m) -> {
            if m == .SHA384 -> return ssldefs.SSL_TLS_PRF_SHA384
            if m == .SHA256 -> return ssldefs.SSL_TLS_PRF_SHA256
        }
        None -> {}
    }
    ssldefs.SSL_TLS_PRF_NONE
}

/// Pick the digest of the PRF, of calc_verify and of calc_finished for a
/// ciphersuite's MAC (ssl_set_handshake_prfs): SHA-384 for SHA-384, else
/// SHA-256.
ssl_set_handshake_prfs: fn(hs: &ssldefs.SSLHandshake, hash: hashes.Md) Never! {
    md: if hash == .SHA384 -> hashes.Md.SHA384 else -> hashes.Md.SHA256
    hs.tls_prf_md = Val(md)
    hs.calc_verify_md = Val(md)
}

/// Use the TLS HashAlgorithm `md` for calc_verify
/// (mbedtls_ssl_set_calc_verify_md); false, where C returns -1, for one
/// other than SHA-256 and SHA-384.
ssl_set_calc_verify_md: fn(ssl: &ssldefs.SSLContext, md: Int) -> Bool Never! {
    if md == ssldefs.SSL_HASH_SHA384 {
        ssl.handshake.calc_verify_md = Val(hashes.Md.SHA384)
        return true
    }
    if md == ssldefs.SSL_HASH_SHA256 {
        ssl.handshake.calc_verify_md = Val(hashes.Md.SHA256)
        return true
    }
    false
}

/// The digest of the handshake so far under `md`, the running transcript
/// going on (mbedtls_ssl_get_handshake_transcript); InternalError for a
/// digest other than SHA-256 and SHA-384.
ssl_get_handshake_transcript: fn(ssl: ssldefs.SSLContext, md: hashes.Md) -> [U8] ssldefs.SSLError! {
    if md == .SHA384 {
        if ssl.handshake.fin_sha384 == {
            .Val(c) -> {
                c384 := hashes.hash_clone(c)
                return Ok(hashes.hash_finish(c384))
            }
            None -> return Err(.InternalError)
        }
    }
    if md == .SHA256 {
        if ssl.handshake.fin_sha256 == {
            .Val(c) -> {
                c256 := hashes.hash_clone(c)
                return Ok(hashes.hash_finish(c256))
            }
            None -> return Err(.InternalError)
        }
    }
    Err(.InternalError)
}

/// The transcript digest a CertificateVerify signs and the extended master
/// secret takes (ssl_calc_verify_tls_sha256 and _sha384).
ssl_calc_verify: fn(ssl: ssldefs.SSLContext) -> [U8] ssldefs.SSLError! {
    md: ssl.handshake.calc_verify_md ?? return Err(.InternalError)
    ssl_get_handshake_transcript(ssl, md)
}

// The master secret of the negotiated session, from the premaster secret,
// which is wiped; nothing for a resumed session (ssl_compute_master). With
// the extended master secret the seed is the session hash (RFC 7627 4).
ssl_compute_master: fn(ssl: &ssldefs.SSLContext) ssldefs.SSLError! {
    if ssl.handshake.resume != 0 -> return
    lbl := "master secret".bytes()
    seed := ssl.handshake.randbytes
    if ssl.handshake.extended_ms == ssldefs.SSL_EXTENDED_MS_ENABLED {
        lbl = "extended master secret".bytes()
        seed = ssl_calc_verify(ssl) ?? return Err(err)
    }
    md: ssl.handshake.tls_prf_md ?? return Err(.InternalError)
    pms := ssldefs.ssl_bytes_of(ssl.handshake.premaster, 0, ssl.handshake.pmslen)
    ssl.spool[ssl.session_negotiate].master = ssl_tls_prf_generic(md, pms, lbl, seed, 48)
    ssldefs.ssl_wipe(pms)
    ssldefs.ssl_wipe(ssl.handshake.premaster)
}

/// Compute the master secret and fill the negotiated transform with the
/// keys it expands to (mbedtls_ssl_derive_keys).
ssl_derive_keys: fn(ssl: &ssldefs.SSLContext) ssldefs.SSLError! {
    cs: ssl.handshake.ciphersuite_info ?? return Err(.InternalError)
    ssl_set_handshake_prfs(ssl.handshake, cs.mac)
    ssl_compute_master(ssl) ?? return Err(err)
    // The master secret takes client || server random, the key expansion
    // server || client (RFC 5246 6.3 and 8.1).
    tmp := ssl.handshake.randbytes.copy()
    ssldefs.ssl_copy_into(ssl.handshake.randbytes, 0, tmp, 32, 32)
    ssldefs.ssl_copy_into(ssl.handshake.randbytes, 32, tmp, 0, 32)
    ssldefs.ssl_wipe(tmp)
    md: ssl.handshake.tls_prf_md ?? return Err(.InternalError)
    sn: ssl.session_negotiate
    ssl_tls12_populate_transform(ssl, ssl.transform_negotiate, ssl.spool[sn].ciphersuite, ssl.spool[sn].master.copy(), ssl.spool[sn].encrypt_then_mac, md, ssl.handshake.randbytes.copy(), ssl.tls_version, ssl.conf.endpoint) ?? return Err(err)
    // The randoms are not needed any more.
    ssldefs.ssl_wipe(ssl.handshake.randbytes)
}

// Key one cipher context for `op`, CBC without padding as the record layer
// pads; the failure, None for none.
ssl_tls12_key_cipher: fn(ctx: &layer.CipherContext, key: [U8], op: layer.CipherOperation) -> layer.CipherLayerError? Never! {
    if layer.cipher_setkey(ctx, key, op) == {
        .Err(e) -> return Val(e)
        else -> {}
    }
    if ctx.info.mode == .CBC {
        if layer.cipher_set_padding_mode(ctx, cipher.CBCPadding.Unpadded) == {
            .Err(e) -> return Val(e)
            else -> {}
        }
    }
    None
}

// Key the encryption and decryption contexts from the key block; the
// failure, None for none. The key copies are wiped.
ssl_tls12_key_ciphers: fn(enc: &layer.CipherContext, dec: &layer.CipherContext, keyblk: [U8], key1: Int, key2: Int, keylen: Int) -> layer.CipherLayerError? Never! {
    k1 := ssldefs.ssl_bytes_of(keyblk, key1, keylen)
    k2 := ssldefs.ssl_bytes_of(keyblk, key2, keylen)
    failure := ssl_tls12_key_cipher(enc, k1, .Encrypt)
    if failure == None -> failure = ssl_tls12_key_cipher(dec, k2, .Decrypt)
    ssldefs.ssl_wipe(k1)
    ssldefs.ssl_wipe(k2)
    failure
}

// Fill transform `tix` with what `master` and `randbytes` (server random ||
// client random) expand to under the ciphersuite
// (ssl_tls12_populate_transform, RFC 5246 6.3).
ssl_tls12_populate_transform: fn(ssl: &ssldefs.SSLContext, tix: Int, ciphersuite: Int, master: [U8], encrypt_then_mac: Int, prf_md: hashes.Md, randbytes: [U8], tls_version: Int, endpoint: Int) ssldefs.SSLError! {
    ssl.tpool[tix].encrypt_then_mac = encrypt_then_mac
    ssl.tpool[tix].tls_version = tls_version
    ssl.tpool[tix].randbytes = randbytes.copy()
    // TLS 1.3 transforms are made apart (ssl_tls13_populate_transform).
    if tls_version == ssldefs.SSL_VERSION_TLS1_3 -> return Err(.InternalError)
    cs: suites.ssl_ciphersuite_from_id(ciphersuite) ?? return Err(.BadInputData)
    ssl_mode: ssl_get_mode_from_ciphersuite(encrypt_then_mac, cs)
    taglen := 0
    if ssl_mode == .AEAD {
        taglen = 16
        if cs.flags.bit_and(suites.CIPHERSUITE_SHORT_TAG) != 0 -> taglen = 8
    }
    ssl.tpool[tix].taglen = taglen
    info: suites.ssl_ciphersuite_cipher_info(cs) ?? return Err(.BadInputData)
    if ssl.handshake.cid_in_use == ssldefs.SSL_CID_ENABLED {
        ssl.tpool[tix].in_cid = ssl.own_cid
        ssl.tpool[tix].out_cid = ssl.handshake.peer_cid
    }
    keyblk := ssl_tls_prf_generic(prf_md, master, "key expansion".bytes(), randbytes, 256)
    keylen: info.key_bits /% 8
    mac_key_len := 0
    if ssl_mode == .AEAD {
        // 12-byte nonces: GCM and CCM have a 4-byte fixed part and an 8-byte
        // explicit one (RFC 5288 3, RFC 6655 3), ChaChaPoly a 12-byte fixed
        // one XORed with the sequence number (RFC 7905 2).
        fixed_ivlen: if info.mode == .ChaChaPoly -> 12 else -> 4
        ssl.tpool[tix].maclen = 0
        ssl.tpool[tix].ivlen = 12
        ssl.tpool[tix].fixed_ivlen = fixed_ivlen
        ssl.tpool[tix].minlen = 12 - fixed_ivlen + taglen
    } else {
        mac_key_len = hashes.md_size(cs.mac)
        ssl.tpool[tix].maclen = mac_key_len
        ssl.tpool[tix].ivlen = info.iv_size
        if ssl_mode == .Stream {
            ssl.tpool[tix].minlen = mac_key_len
        } else {
            // One block past the MAC with encrypt-then-MAC, else the first
            // block multiple past it; then the explicit IV.
            block_size: info.block_size
            if ssl_mode == .CBCETM -> ssl.tpool[tix].minlen = mac_key_len + block_size else -> ssl.tpool[tix].minlen = mac_key_len + block_size - mac_key_len %% block_size
            if tls_version != ssldefs.SSL_VERSION_TLS1_2 {
                ssldefs.ssl_wipe(keyblk)
                return Err(.InternalError)
            }
            ssl.tpool[tix].minlen += info.iv_size
        }
    }
    if endpoint != ssldefs.SSL_IS_CLIENT && endpoint != ssldefs.SSL_IS_SERVER {
        ssldefs.ssl_wipe(keyblk)
        return Err(.InternalError)
    }
    // The key block is client MAC key, server MAC key, client key, server
    // key, client IV, server IV.
    ivlen: ssl.tpool[tix].ivlen
    fixed: ssl.tpool[tix].fixed_ivlen
    iv_copy_len: if fixed != 0 -> fixed else -> ivlen
    key1 := mac_key_len * 2
    key2 := mac_key_len * 2 + keylen
    mac_enc := 0
    mac_dec := mac_key_len
    iv_enc := key2 + keylen
    iv_dec := key2 + keylen + iv_copy_len
    if endpoint == ssldefs.SSL_IS_SERVER {
        key1 = mac_key_len * 2 + keylen
        key2 = mac_key_len * 2
        mac_enc = mac_key_len
        mac_dec = 0
        iv_dec = key1 + keylen
        iv_enc = key1 + keylen + iv_copy_len
    }
    ssl.tpool[tix].iv_enc = ssldefs.ssl_zeros(16)
    ssl.tpool[tix].iv_dec = ssldefs.ssl_zeros(16)
    ssldefs.ssl_copy_into(ssl.tpool[tix].iv_enc, 0, keyblk, iv_enc, iv_copy_len)
    ssldefs.ssl_copy_into(ssl.tpool[tix].iv_dec, 0, keyblk, iv_dec, iv_copy_len)
    if ssl.f_export_keys == {
        .Val(cb) -> {
            call: cb.call
            _ := call(ssldefs.SSLExportedKey{ktype: ssldefs.SSL_KEY_EXPORT_TLS12_MASTER_SECRET, secret: master, client_random: ssldefs.ssl_bytes_of(randbytes, 32, 32), server_random: ssldefs.ssl_bytes_of(randbytes, 0, 32), tls_prf_type: ssl_tls_prf_get_type(Val(prf_md))})
        }
        None -> {}
    }
    enc := layer.cipher_setup(info)
    dec := layer.cipher_setup(info)
    if ssl_tls12_key_ciphers(enc, dec, keyblk, key1, key2, keylen) == {
        .Val(e) -> {
            ssldefs.ssl_wipe(keyblk)
            return Err(.Cipher(e))
        }
        None -> {}
    }
    ssl.tpool[tix].cipher_enc = Val(enc)
    ssl.tpool[tix].cipher_dec = Val(dec)
    if mac_key_len != 0 {
        mk_enc := ssldefs.ssl_bytes_of(keyblk, mac_enc, mac_key_len)
        mk_dec := ssldefs.ssl_bytes_of(keyblk, mac_dec, mac_key_len)
        ssl.tpool[tix].md_enc = Val(hashes.hmac_key(cs.mac, mk_enc))
        ssl.tpool[tix].md_dec = Val(hashes.hmac_key(cs.mac, mk_dec))
        ssldefs.ssl_wipe(mk_enc)
        ssldefs.ssl_wipe(mk_dec)
    }
    ssldefs.ssl_wipe(keyblk)
}

/// The premaster secret of a PSK key exchange: the other secret, then the
/// PSK, each after a 2-byte length (mbedtls_ssl_psk_derive_premaster,
/// RFC 4279 2, RFC 5489 2).
ssl_psk_derive_premaster: fn<R: RNG>(ssl: &ssldefs.SSLContext, key_ex: suites.SSLKeyExchange, rng: &R) ssldefs.SSLError! {
    // Only DHE-PSK goes on without a PSK, with the DH secret alone.
    psk := [U8]{}
    if ssl_get_psk(ssl) == {
        .Ok(k) -> psk = k
        .Err(_) -> { if key_ex != .DHEPSK -> return Err(.InternalError) }
    }
    end: ssl.handshake.premaster.len()
    p := 0
    if key_ex == {
        .PSK -> {
            // The other secret is as many zeros as the PSK has bytes.
            if end - p < 2 -> return Err(.BadInputData)
            ssldefs.ssl_put_u16(ssl.handshake.premaster, p, psk.len())
            p += 2
            if end < p || end - p < psk.len() -> return Err(.BadInputData)
            ssldefs.ssl_fill(ssl.handshake.premaster, p, psk.len(), U8{0})
            p += psk.len()
        }
        .RSAPSK -> {
            // The ClientKeyExchange put the 48-byte other secret in place.
            if end - p < 2 -> return Err(.BadInputData)
            ssl.handshake.premaster[p] = U8{0}
            ssl.handshake.premaster[p + 1] = U8{48}
            p += 50
        }
        .DHEPSK -> {
            secret := if &ssl.handshake.dhm_ctx == {
                .Val(ctx) -> dhm.dhm_calc_secret(ctx, rng) ?? return Err(.DHM(err))
                None -> return Err(.InternalError)
            }
            if secret.len() > end - (p + 2) {
                ssldefs.ssl_wipe(secret)
                return Err(.DHM(.BadInput))
            }
            ssldefs.ssl_put_u16(ssl.handshake.premaster, p, secret.len())
            ssldefs.ssl_copy_into(ssl.handshake.premaster, p + 2, secret, 0, secret.len())
            p += 2 + secret.len()
            ssldefs.ssl_wipe(secret)
        }
        .ECDHEPSK -> {
            plen: end - (p + 2)
            z := if &ssl.handshake.ecdh_ctx == {
                .Val(ctx) -> ecdh.ecdh_calc_secret(ctx, plen, rng) ?? return Err(.ECP(err))
                None -> return Err(.InternalError)
            }
            ssldefs.ssl_put_u16(ssl.handshake.premaster, p, z.len())
            ssldefs.ssl_copy_into(ssl.handshake.premaster, p + 2, z, 0, z.len())
            p += 2 + z.len()
            ssldefs.ssl_wipe(z)
        }
        else -> return Err(.InternalError)
    }
    if end - p < 2 -> return Err(.BadInputData)
    ssldefs.ssl_put_u16(ssl.handshake.premaster, p, psk.len())
    p += 2
    if end < p || end - p < psk.len() -> return Err(.BadInputData)
    ssldefs.ssl_copy_into(ssl.handshake.premaster, p, psk, 0, psk.len())
    p += psk.len()
    ssl.handshake.pmslen = p
}

// ---------------------------------------------------------------------------
// Certificate and Finished messages.

/// Write the Certificate message (mbedtls_ssl_write_certificate): none for
/// a ciphersuite without certificates or a client not asked for one.
ssl_write_certificate: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    cs: ssl.handshake.ciphersuite_info ?? return Err(.InternalError)
    if !suites.ssl_ciphersuite_uses_srv_cert(cs) {
        sslmsg.ssl_handshake_increment_state(ssl)
        return
    }
    if ssl.conf.endpoint == ssldefs.SSL_IS_CLIENT && ssl.handshake.client_auth == 0 {
        sslmsg.ssl_handshake_increment_state(ssl)
        return
    }
    // 0: handshake type, 1..3: length, 4..6: certificate list length, then
    // each certificate after its 3-byte length (RFC 5246 7.4.2).
    ders: ssl_own_cert_der(ssl)
    if ssl.conf.endpoint == ssldefs.SSL_IS_SERVER && ders == None -> return Err(.InternalError)
    list: ders ?? [[U8]]{}
    i := 7
    loop der in list {
        n: der.len()
        if n > ssldefs.SSL_OUT_CONTENT_LEN - 3 - i -> return Err(.BufferTooSmall)
        ssldefs.ssl_put_u24(ssl.out_buf, ssl.out_msg + i, n)
        ssldefs.ssl_copy_into(ssl.out_buf, ssl.out_msg + i + 3, der, 0, n)
        i += 3 + n
    }
    ssldefs.ssl_put_u24(ssl.out_buf, ssl.out_msg + 4, i - 7)
    ssl.out_msglen = i
    ssl.out_msgtype = ssldefs.SSL_MSG_HANDSHAKE
    ssl.out_buf[ssl.out_msg] = ssldefs.ssl_byte(ssldefs.SSL_HS_CERTIFICATE)
    sslmsg.ssl_handshake_increment_state(ssl)
    sslmsg.ssl_write_handshake_msg(ssl, rng) ?? return Err(err)
}

// Parse the Certificate message into `chain` (ssl_parse_certificate_chain).
// In a client's renegotiation the server's certificate may not change.
ssl_parse_certificate_chain: fn<R: RNG>(ssl: &ssldefs.SSLContext, chain: &[x509crt.X509Crt], rng: &R) ssldefs.SSLError! {
    m: ssl.in_msg
    hdr: sslmsg.ssl_hs_hdr_len(ssl)
    if ssl.in_msgtype != ssldefs.SSL_MSG_HANDSHAKE || ssldefs.ssl_u8(ssl.in_buf, m) != ssldefs.SSL_HS_CERTIFICATE {
        ssl_send_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_UNEXPECTED_MESSAGE, rng)
        return Err(.UnexpectedMessage)
    }
    if ssl.in_hslen < hdr + 3 + 3 {
        ssl_send_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, rng)
        return Err(.DecodeError)
    }
    i := hdr
    // The certificate list's length is 3 bytes, the first of them 0.
    n0: ssldefs.ssl_get_u16(ssl.in_buf, m + i + 1)
    if ssldefs.ssl_u8(ssl.in_buf, m + i) != 0 || ssl.in_hslen != n0 + 3 + hdr {
        ssl_send_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, rng)
        return Err(.DecodeError)
    }
    i += 3
    crt_cnt := 0
    loop i < ssl.in_hslen {
        if i + 3 > ssl.in_hslen {
            ssl_send_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, rng)
            return Err(.DecodeError)
        }
        // Certificates are below 64 KiB, so their length's first byte is 0.
        if ssldefs.ssl_u8(ssl.in_buf, m + i) != 0 {
            ssl_send_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_UNSUPPORTED_CERT, rng)
            return Err(.BadCertificate)
        }
        n: ssldefs.ssl_get_u16(ssl.in_buf, m + i + 1)
        i += 3
        if n < 128 || i + n > ssl.in_hslen {
            ssl_send_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, rng)
            return Err(.DecodeError)
        }
        first: crt_cnt == 0
        crt_cnt += 1
        if first && ssl.conf.endpoint == ssldefs.SSL_IS_CLIENT && ssl.renego_status == ssldefs.SSL_RENEGOTIATION_IN_PROGRESS {
            // The server's end certificate must be the one of the session
            // being renegotiated; it is then dropped from that session.
            same := false
            if ssl.session >= 0 {
                if ssl.spool[ssl.session].peer_cert == {
                    .Val(old) -> {
                        if old.len() > 0 && old[0].raw.len() == n -> same = ssldefs.ssl_range_eq(old[0].raw, 0, ssl.in_buf, m + i, n)
                    }
                    None -> {}
                }
            }
            if !same {
                ssl_send_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_ACCESS_DENIED, rng)
                return Err(.BadCertificate)
            }
            ssl.spool[ssl.session].peer_cert = None
        }
        if x509crt.x509_crt_parse_der(chain, ssldefs.ssl_bytes_of(ssl.in_buf, m + i, n)) == {
            .Err(e) -> {
                if e == {
                    // An unknown signature algorithm is let through.
                    .UnknownSigAlg(o) -> {
                        if o == {
                            .Val(_) -> {}
                            None -> {
                                ssl_send_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_BAD_CERT, rng)
                                return Err(.X509(e))
                            }
                        }
                    }
                    .UnknownVersion -> {
                        ssl_send_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_UNSUPPORTED_CERT, rng)
                        return Err(.X509(e))
                    }
                    else -> {
                        ssl_send_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_BAD_CERT, rng)
                        return Err(.X509(e))
                    }
                }
            }
            else -> {}
        }
        i += n
    }
}

// Whether the client's Certificate message is empty, a server's only
// (ssl_srv_check_client_no_crt_notification, true where C returns 0).
ssl_srv_check_client_no_crt_notification: fn(ssl: ssldefs.SSLContext) -> Bool Never! {
    if ssl.conf.endpoint == ssldefs.SSL_IS_CLIENT -> return false
    hdr: sslmsg.ssl_hs_hdr_len(ssl)
    ssl.in_hslen == 3 + hdr && ssl.in_msgtype == ssldefs.SSL_MSG_HANDSHAKE && ssldefs.ssl_u8(ssl.in_buf, ssl.in_msg) == ssldefs.SSL_HS_CERTIFICATE && ssldefs.ssl_get_u24(ssl.in_buf, ssl.in_msg + hdr) == 0
}

// Whether no Certificate message is to come: none with the ciphersuite, a
// server's with RSA-PSK or without client authentication
// (ssl_parse_certificate_coordinate, true for SSL_CERTIFICATE_SKIP).
ssl_parse_certificate_coordinate: fn(ssl: &ssldefs.SSLContext, cs: suites.SSLCiphersuite, authmode: Int) -> Bool Never! {
    if !suites.ssl_ciphersuite_uses_srv_cert(cs) {
        ssl.spool[ssl.session_negotiate].verify_result = 0
        return true
    }
    if ssl.conf.endpoint == ssldefs.SSL_IS_SERVER {
        if cs.key_exchange == .RSAPSK -> return true
        if authmode == ssldefs.SSL_VERIFY_NONE {
            ssl.spool[ssl.session_negotiate].verify_result = x509.X509_BADCERT_SKIP_VERIFY
            return true
        }
    }
    false
}

/// Read and verify the peer's Certificate message
/// (mbedtls_ssl_parse_certificate); the authentication mode is the SNI
/// callback's if it set one.
ssl_parse_certificate: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    authmode: if ssl.handshake.sni_authmode != ssldefs.SSL_VERIFY_UNSET -> ssl.handshake.sni_authmode else -> ssl.conf.authmode
    cs: ssl.handshake.ciphersuite_info ?? return Err(.InternalError)
    if ssl_parse_certificate_coordinate(ssl, cs, authmode) {
        sslmsg.ssl_handshake_increment_state(ssl)
        return
    }
    sslmsg.ssl_read_record(ssl, true, rng) ?? return Err(err)
    sn: ssl.session_negotiate
    if ssl_srv_check_client_no_crt_notification(ssl) {
        ssl.spool[sn].verify_result = x509.X509_BADCERT_MISSING
        if authmode != ssldefs.SSL_VERIFY_OPTIONAL -> return Err(.NoClientCertificate)
        sslmsg.ssl_handshake_increment_state(ssl)
        return
    }
    // A session that failed to resume may hold a certificate.
    ssl.spool[sn].peer_cert = None
    chain := [x509crt.X509Crt]{}
    ssl_parse_certificate_chain(ssl, chain, rng) ?? return Err(err)
    ssl_verify_certificate(ssl, authmode, chain, Val(cs), rng) ?? return Err(err)
    ssl.spool[sn].peer_cert = Val(chain)
    sslmsg.ssl_handshake_increment_state(ssl)
}

// The verify_data of the Finished message `from` sends, the PRF of the
// master secret over its label and the transcript digest
// (ssl_calc_finished_tls_sha256 and _sha384, RFC 5246 7.4.9).
ssl_calc_finished: fn(ssl: ssldefs.SSLContext, from: Int) -> [U8] ssldefs.SSLError! {
    md: ssl.handshake.tls_prf_md ?? return Err(.InternalError)
    padbuf := ssl_get_handshake_transcript(ssl, md) ?? return Err(err)
    session: if ssl.session_negotiate >= 0 -> ssl.session_negotiate else -> ssl.session
    sender: if from == ssldefs.SSL_IS_CLIENT -> "client finished" else -> "server finished"
    out: ssl_tls_prf_generic(md, ssl.spool[session].master, sender.bytes(), padbuf, 12)
    ssldefs.ssl_wipe(padbuf)
    Ok(out)
}

/// Drop the handshake and make the negotiated transform current
/// (mbedtls_ssl_handshake_wrapup_free_hs_transform).
ssl_handshake_wrapup_free_hs_transform: fn(ssl: &ssldefs.SSLContext) Never! {
    ssl_handshake_free(ssl)
    ssl.has_handshake = false
    ssldefs.ssl_transform_release(ssl, ssl.transform)
    ssl.transform = ssl.transform_negotiate
    ssl.transform_negotiate = -1
}

/// End the handshake (mbedtls_ssl_handshake_wrapup): the negotiated session
/// becomes current and, when new, is offered to the session cache. A DTLS
/// endpoint keeps the handshake while its last flight may be resent.
ssl_handshake_wrapup: fn(ssl: &ssldefs.SSLContext) Never! {
    resume: ssl.handshake.resume
    if ssl.renego_status == ssldefs.SSL_RENEGOTIATION_IN_PROGRESS {
        ssl.renego_status = ssldefs.SSL_RENEGOTIATION_DONE
        ssl.renego_records_seen = 0
    }
    // The session being renegotiated is replaced.
    if ssl.session >= 0 {
        // RFC 7366 3.1: encrypt-then-MAC is kept across renegotiation.
        ssl.spool[ssl.session_negotiate].encrypt_then_mac = ssl.spool[ssl.session].encrypt_then_mac
        ssldefs.ssl_session_release(ssl, ssl.session)
    }
    ssl.session = ssl.session_negotiate
    ssl.session_negotiate = -1
    if ssl.conf.f_set_cache == {
        .Val(cb) -> {
            if ssl.spool[ssl.session].id.len() != 0 && resume == 0 {
                call: cb.call
                // C ignores the cache's failure to store.
                if call(ssl.spool[ssl.session].id, ssl.spool[ssl.session]) == {
                    .Ok(_) -> {}
                    .Err(_) -> {}
                }
            }
        }
        None -> {}
    }
    if sslmsg.ssl_is_dtls(ssl) && ssl.handshake.flight.len() != 0 {
        // Cancel the timer, the handshake is freed when the peer is heard.
        sslmsg.ssl_set_timer(ssl, 0)
    } else {
        ssl_handshake_wrapup_free_hs_transform(ssl)
    }
    sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_HANDSHAKE_OVER)
}

/// Write the Finished message, switching to the negotiated transform
/// (mbedtls_ssl_write_finished). DTLS keeps the previous epoch to resend
/// the flight with.
ssl_write_finished: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    sslmsg.ssl_update_out_pointers(ssl, ssl.transform_negotiate)
    buf := ssl_calc_finished(ssl, ssl.conf.endpoint) ?? return Err(err)
    hash_len: 12
    ssldefs.ssl_copy_into(ssl.out_buf, ssl.out_msg + 4, buf, 0, hash_len)
    ssl.verify_data_len = hash_len
    ssldefs.ssl_copy_into(ssl.own_verify_data, 0, buf, 0, hash_len)
    ssldefs.ssl_wipe(buf)
    ssl.out_msglen = 4 + hash_len
    ssl.out_msgtype = ssldefs.SSL_MSG_HANDSHAKE
    ssl.out_buf[ssl.out_msg] = ssldefs.ssl_byte(ssldefs.SSL_HS_FINISHED)
    // In a resumed handshake the server's Finished comes first.
    if ssl.handshake.resume != 0 {
        if ssl.conf.endpoint == ssldefs.SSL_IS_CLIENT -> sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_HANDSHAKE_WRAPUP)
        if ssl.conf.endpoint == ssldefs.SSL_IS_SERVER -> sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_CLIENT_CHANGE_CIPHER_SPEC)
    } else {
        sslmsg.ssl_handshake_increment_state(ssl)
    }
    // Switch to the new epoch, or reset the sequence number.
    if sslmsg.ssl_is_dtls(ssl) {
        ssl.handshake.alt_transform_out = ssl.transform_out
        ssldefs.ssl_copy_into(ssl.handshake.alt_out_ctr, 0, ssl.cur_out_ctr, 0, ssldefs.SSL_SEQUENCE_NUMBER_LEN)
        ssldefs.ssl_fill(ssl.cur_out_ctr, 2, ssldefs.SSL_SEQUENCE_NUMBER_LEN - 2, U8{0})
        i := 2
        loop i > 0 {
            v: (Int.from_u8(ssl.cur_out_ctr[i - 1]) + 1).bit_and(0xFF)
            ssl.cur_out_ctr[i - 1] = ssldefs.ssl_byte(v)
            if v != 0 -> break
            i -= 1
        }
        // The epoch must not wrap.
        if i == 0 -> return Err(.CounterWrapping)
    } else {
        ssldefs.ssl_fill(ssl.cur_out_ctr, 0, ssldefs.SSL_SEQUENCE_NUMBER_LEN, U8{0})
    }
    ssl.transform_out = ssl.transform_negotiate
    ssl.session_out = ssl.session_negotiate
    if sslmsg.ssl_is_dtls(ssl) -> sslmsg.ssl_send_flight_completed(ssl)
    sslmsg.ssl_write_handshake_msg(ssl, rng) ?? return Err(err)
    if sslmsg.ssl_is_dtls(ssl) -> sslmsg.ssl_flight_transmit(ssl, rng) ?? return Err(err)
}

/// Read and check the peer's Finished message (mbedtls_ssl_parse_finished).
ssl_parse_finished: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    buf := ssl_calc_finished(ssl, ssl.conf.endpoint.bit_xor(1)) ?? return Err(err)
    if sslmsg.ssl_read_record(ssl, true, rng) == {
        .Err(e) -> {
            ssldefs.ssl_wipe(buf)
            return Err(e)
        }
        else -> {}
    }
    hdr: sslmsg.ssl_hs_hdr_len(ssl)
    hash_len: 12
    failure := ssl_parse_finished_check(ssl, buf, hdr, hash_len)
    if failure == {
        .Val(alert) -> {
            ssldefs.ssl_wipe(buf)
            ssl_send_fatal_alert(ssl, alert.alert, rng)
            return Err(alert.reason)
        }
        None -> {}
    }
    ssl.verify_data_len = hash_len
    ssldefs.ssl_copy_into(ssl.peer_verify_data, 0, buf, 0, hash_len)
    ssldefs.ssl_wipe(buf)
    if ssl.handshake.resume != 0 {
        if ssl.conf.endpoint == ssldefs.SSL_IS_CLIENT -> sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_CLIENT_CHANGE_CIPHER_SPEC)
        if ssl.conf.endpoint == ssldefs.SSL_IS_SERVER -> sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_HANDSHAKE_WRAPUP)
    } else {
        sslmsg.ssl_handshake_increment_state(ssl)
    }
    if sslmsg.ssl_is_dtls(ssl) -> sslmsg.ssl_recv_flight_completed(ssl)
}

// An alert to send and the error to fail with.
SSLAlertFailure: struct {
    alert: Int
    reason: ssldefs.SSLError
}

// The Finished message's checks: a Finished of the right length whose
// verify_data matches `expected`, compared in constant time.
ssl_parse_finished_check: fn(ssl: ssldefs.SSLContext, expected: [U8], hdr: Int, hash_len: Int) -> SSLAlertFailure? Never! {
    if ssl.in_msgtype != ssldefs.SSL_MSG_HANDSHAKE || ssldefs.ssl_u8(ssl.in_buf, ssl.in_msg) != ssldefs.SSL_HS_FINISHED {
        return Val(SSLAlertFailure{alert: ssldefs.SSL_ALERT_MSG_UNEXPECTED_MESSAGE, reason: .UnexpectedMessage})
    }
    if ssl.in_hslen != hdr + hash_len {
        return Val(SSLAlertFailure{alert: ssldefs.SSL_ALERT_MSG_DECODE_ERROR, reason: .DecodeError})
    }
    if ctime.memcmp(ssl.in_buf, ssl.in_msg + hdr, expected, 0, hash_len) != 0 {
        return Val(SSLAlertFailure{alert: ssldefs.SSL_ALERT_MSG_DECRYPT_ERROR, reason: .HandshakeFailure})
    }
    None
}

// ---------------------------------------------------------------------------
// TLS 1.2 signatures and ciphersuites.

/// The digest a TLS 1.2 ServerKeyExchange signature covers: client random,
/// server random, then the parameters at buf[off..<off + len]
/// (mbedtls_ssl_get_key_exchange_md_tls1_2).
ssl_get_key_exchange_md_tls1_2: fn(ssl: ssldefs.SSLContext, buf: [U8], off: Int, len: Int, md: hashes.Md) -> [U8] Never! {
    ctx := hashes.hash_start(md)
    hashes.hash_update(ctx, ssl.handshake.randbytes)
    hashes.hash_update_range(ctx, buf, off, len)
    hashes.hash_finish(ctx)
}

/// The hash the peer prefers with signature algorithm `sig_alg`, a TLS 1.2
/// SignatureAlgorithm, SSL_HASH_NONE when it offered none we know
/// (mbedtls_ssl_tls12_get_preferred_hash_for_sig_alg).
ssl_tls12_get_preferred_hash_for_sig_alg: fn(ssl: ssldefs.SSLContext, sig_alg: Int) -> Int Never! {
    if sig_alg == ssldefs.SSL_SIG_ANON -> return ssldefs.SSL_HASH_NONE
    loop received in ssl.handshake.received_sig_algs {
        hash_alg: received.bit_and(0xFF00) >> 8
        sig_alg_received: received.bit_and(0xFF)
        if ssl_md_alg_from_hash(hash_alg) == None -> next
        if sig_alg == sig_alg_received -> return hash_alg
    }
    ssldefs.SSL_HASH_NONE
}

/// Whether a ciphersuite may be offered between the protocol versions, and
/// a PSK one only with a PSK (mbedtls_ssl_validate_ciphersuite, true where
/// C returns 0).
ssl_validate_ciphersuite: fn(ssl: ssldefs.SSLContext, suite_info: suites.SSLCiphersuite?, min_tls_version: Int, max_tls_version: Int) -> Bool Never! {
    cs: suite_info ?? return false
    if cs.min_tls_version > max_tls_version || cs.max_tls_version < min_tls_version -> return false
    if suites.ssl_ciphersuite_uses_psk(cs) && !ssl_conf_has_static_psk(ssl.conf) -> return false
    true
}

// ---------------------------------------------------------------------------
// Extensions shared by both versions.

/// Write the signature_algorithms extension at out_buf[p..<end]: its length
/// (mbedtls_ssl_write_sig_alg_ext, RFC 8446 4.2.3).
ssl_write_sig_alg_ext: fn(ssl: &ssldefs.SSLContext, p: Int, end: Int) -> Int ssldefs.SSLError! {
    // Extension type, extension length and list length come first.
    ssl_chk_buf(p, end, 6) ?? return Err(err)
    sig_algs: ssl_get_sig_algs(ssl)
    if sig_algs.len() == 0 -> return Err(.BadConfig)
    q := p + 6
    loop sig_alg in sig_algs {
        if !ssl_sig_alg_is_supported(ssl, sig_alg) -> next
        ssl_chk_buf(q, end, 2) ?? return Err(err)
        ssldefs.ssl_put_u16(ssl.out_buf, q, sig_alg)
        q += 2
    }
    supported_sig_alg_len: q - p - 6
    if supported_sig_alg_len == 0 -> return Err(.InternalError)
    ssldefs.ssl_put_u16(ssl.out_buf, p, ssldefs.TLS_EXT_SIG_ALG)
    ssldefs.ssl_put_u16(ssl.out_buf, p + 2, supported_sig_alg_len + 2)
    ssldefs.ssl_put_u16(ssl.out_buf, p + 4, supported_sig_alg_len)
    ssl_tls13_set_hs_sent_ext_mask(ssl, ssldefs.TLS_EXT_SIG_ALG)
    Ok(q - p)
}

/// Parse the peer's signature_algorithms extension at in_buf[p..<end] into
/// received_sig_algs (mbedtls_ssl_parse_sig_alg_ext). Under TLS 1.2 only
/// those we support and offer are kept.
ssl_parse_sig_alg_ext: fn(ssl: &ssldefs.SSLContext, buf: Int, end: Int) ssldefs.SSLError! {
    p := buf
    ssl_chk_buf_read(ssl, p, end, 2) ?? return Err(err)
    supported_sig_algs_len: ssldefs.ssl_get_u16(ssl.in_buf, p)
    p += 2
    ssl.handshake.received_sig_algs = [Int]{}
    ssl_chk_buf_read(ssl, p, end, supported_sig_algs_len) ?? return Err(err)
    supported_sig_algs_end: p + supported_sig_algs_len
    loop p < supported_sig_algs_end {
        ssl_chk_buf_read(ssl, p, supported_sig_algs_end, 2) ?? return Err(err)
        sig_alg: ssldefs.ssl_get_u16(ssl.in_buf, p)
        p += 2
        if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_2 && !(ssl_sig_alg_is_supported(ssl, sig_alg) && ssl_sig_alg_is_offered(ssl, sig_alg)) -> next
        if ssl.handshake.received_sig_algs.len() + 1 < ssldefs.RECEIVED_SIG_ALGS_SIZE -> ssl.handshake.received_sig_algs.push(sig_alg)
    }
    if p != end {
        sslmsg.ssl_pend_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError)
        return Err(.DecodeError)
    }
    if ssl.handshake.received_sig_algs.len() == 0 {
        sslmsg.ssl_pend_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE, .HandshakeFailure)
        return Err(.HandshakeFailure)
    }
}

/// Parse the client's server_name extension at in_buf[buf..<end] and hand
/// the host name to the SNI callback (mbedtls_ssl_parse_server_name_ext,
/// RFC 6066 3).
ssl_parse_server_name_ext: fn(ssl: &ssldefs.SSLContext, buf: Int, end: Int) ssldefs.SSLError! {
    p := buf
    ssl_chk_buf_read(ssl, p, end, 2) ?? return Err(err)
    server_name_list_len: ssldefs.ssl_get_u16(ssl.in_buf, p)
    p += 2
    ssl_chk_buf_read(ssl, p, end, server_name_list_len) ?? return Err(err)
    server_name_list_end: p + server_name_list_len
    loop p < server_name_list_end {
        ssl_chk_buf_read(ssl, p, server_name_list_end, 3) ?? return Err(err)
        hostname_len: ssldefs.ssl_get_u16(ssl.in_buf, p + 1)
        ssl_chk_buf_read(ssl, p, server_name_list_end, hostname_len + 3) ?? return Err(err)
        if ssldefs.ssl_u8(ssl.in_buf, p) == ssldefs.TLS_EXT_SERVERNAME_HOSTNAME {
            name: ssldefs.ssl_bytes_of(ssl.in_buf, p + 3, hostname_len)
            ssl.handshake.sni_name = Val(name)
            if ssl.conf.f_sni == {
                .Val(cb) -> {
                    call: cb.call
                    if call(name) == {
                        .Ok(ov) -> ssl_apply_hs_override(ssl, ov)
                        .Err(_) -> {
                            sslmsg.ssl_pend_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_UNRECOGNIZED_NAME, .UnrecognizedName)
                            return Err(.UnrecognizedName)
                        }
                    }
                }
                None -> {}
            }
            return
        }
        p += hostname_len + 3
    }
}

/// Parse the peer's application_layer_protocol_negotiation extension at
/// in_buf[buf..<end] and choose our first protocol it lists
/// (mbedtls_ssl_parse_alpn_ext, RFC 7301 3.1).
ssl_parse_alpn_ext: fn(ssl: &ssldefs.SSLContext, buf: Int, end: Int) ssldefs.SSLError! {
    ours: ssl.conf.alpn_list ?? return
    p := buf
    // Extension data length, then at least one name and its length.
    ssl_chk_buf_read(ssl, p, end, 4) ?? return Err(err)
    protocol_name_list_len: ssldefs.ssl_get_u16(ssl.in_buf, p)
    p += 2
    ssl_chk_buf_read(ssl, p, end, protocol_name_list_len) ?? return Err(err)
    protocol_name_list_end: p + protocol_name_list_len
    // Validate the peer's list: empty names are not allowed.
    loop p < protocol_name_list_end {
        protocol_name_len: ssldefs.ssl_u8(ssl.in_buf, p)
        p += 1
        ssl_chk_buf_read(ssl, p, protocol_name_list_end, protocol_name_len) ?? return Err(err)
        if protocol_name_len == 0 {
            sslmsg.ssl_pend_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_ILLEGAL_PARAMETER, .IllegalParameter)
            return Err(.IllegalParameter)
        }
        p += protocol_name_len
    }
    // Our preference order wins.
    loop alpn in ours {
        alpn_bytes: alpn.bytes()
        q := buf + 2
        loop q < protocol_name_list_end {
            protocol_name_len: ssldefs.ssl_u8(ssl.in_buf, q)
            q += 1
            if protocol_name_len == alpn_bytes.len() && ssldefs.ssl_range_eq(ssl.in_buf, q, alpn_bytes, 0, protocol_name_len) {
                ssl.alpn_chosen = Val(alpn)
                return
            }
            q += protocol_name_len
        }
    }
    sslmsg.ssl_pend_fatal_alert(ssl, ssldefs.SSL_ALERT_MSG_NO_APPLICATION_PROTOCOL, .NoApplicationProtocol)
    Err(.NoApplicationProtocol)
}

/// Write the server's application_layer_protocol_negotiation extension with
/// the chosen protocol at out_buf[p..<end]: its length, 0 for none chosen
/// (mbedtls_ssl_write_alpn_ext).
ssl_write_alpn_ext: fn(ssl: &ssldefs.SSLContext, p: Int, end: Int) -> Int ssldefs.SSLError! {
    chosen: ssl.alpn_chosen ?? return Ok(0)
    name: chosen.bytes()
    protocol_name_len: name.len()
    ssl_chk_buf(p, end, 7 + protocol_name_len) ?? return Err(err)
    ssldefs.ssl_put_u16(ssl.out_buf, p, ssldefs.TLS_EXT_ALPN)
    // Extension length, list length, name length, name.
    ssldefs.ssl_put_u16(ssl.out_buf, p + 2, protocol_name_len + 3)
    ssldefs.ssl_put_u16(ssl.out_buf, p + 4, protocol_name_len + 1)
    ssl.out_buf[p + 6] = ssldefs.ssl_byte(protocol_name_len)
    ssldefs.ssl_copy_into(ssl.out_buf, p + 7, name, 0, protocol_name_len)
    ssl_tls13_set_hs_sent_ext_mask(ssl, ssldefs.TLS_EXT_ALPN)
    Ok(7 + protocol_name_len)
}

/// Set the host name a TLS 1.3 ticket was issued for
/// (mbedtls_ssl_session_set_hostname); None clears it.
ssl_session_set_hostname: fn(session: &ssldefs.SSLSession, hostname: String?) ssldefs.SSLError! {
    if hostname == {
        .Val(h) -> { if h.bytes().len() > ssldefs.SSL_MAX_HOST_NAME_LEN -> return Err(.BadInputData) }
        None -> {}
    }
    session.hostname = hostname
}

// ---------------------------------------------------------------------------
// Certificate verification.

/// Whether a certificate's keyUsage and extKeyUsage allow its use by the
/// peer of a `recv_endpoint` with the ciphersuite
/// (mbedtls_ssl_check_cert_usage, true where C returns 0); what they do not
/// allow is added to `flags`.
ssl_check_cert_usage: fn(cert: x509crt.X509Crt, ciphersuite: suites.SSLCiphersuite?, recv_endpoint: Int, tls_version: Int, flags: &Int) -> Bool Never! {
    ok := true
    usage := x509.X509_KU_DIGITAL_SIGNATURE
    if tls_version == ssldefs.SSL_VERSION_TLS1_2 && recv_endpoint == ssldefs.SSL_IS_CLIENT {
        // The server's part of a TLS 1.2 key exchange.
        usage = 0
        if ciphersuite == {
            .Val(cs) -> {
                if cs.key_exchange == {
                    .RSA | .RSAPSK -> usage = x509.X509_KU_KEY_ENCIPHERMENT
                    .DHERSA | .ECDHERSA | .ECDHEECDSA -> usage = x509.X509_KU_DIGITAL_SIGNATURE
                    .ECDHRSA | .ECDHECDSA -> usage = x509.X509_KU_KEY_AGREEMENT
                    else -> usage = 0
                }
            }
            None -> {}
        }
    }
    if x509crt.x509_crt_check_key_usage(cert, usage) == {
        .Err(_) -> {
            flags = flags.bit_or(x509.X509_BADCERT_KEY_USAGE)
            ok = false
        }
        else -> {}
    }
    ext_oid: if recv_endpoint == ssldefs.SSL_IS_CLIENT -> oids.OID_SERVER_AUTH else -> oids.OID_CLIENT_AUTH
    if x509crt.x509_crt_check_extended_key_usage(cert, ext_oid) == {
        .Err(_) -> {
            flags = flags.bit_or(x509.X509_BADCERT_EXT_KEY_USAGE)
            ok = false
        }
        else -> {}
    }
    ok
}

// The host name to check the peer's certificate against, as bytes; None
// for no check.
ssl_hostname_bytes: fn(ssl: ssldefs.SSLContext) -> [U8]? Never! {
    h: ssl_get_hostname_pointer(ssl) ?? return None
    Val(h.bytes())
}

// Whether a verification failure is one VERIFY_OPTIONAL lets through: the
// chain rejected by the X.509 check or by the secondary checks.
ssl_verify_failure_is_soft: fn(e: ssldefs.SSLError) -> Bool Never! {
    if e == {
        .X509(x) -> {
            if x == {
                .CertVerifyFailed(_) -> return true
                else -> return false
            }
        }
        .BadCertificate -> true
        else -> false
    }
}

// The alert for a rejected certificate, by the first of its failures in
// C's order.
ssl_verify_alert: fn(verify_result: Int) -> Int Never! {
    if verify_result.bit_and(x509.X509_BADCERT_OTHER) != 0 -> return ssldefs.SSL_ALERT_MSG_ACCESS_DENIED
    if verify_result.bit_and(x509.X509_BADCERT_CN_MISMATCH) != 0 -> return ssldefs.SSL_ALERT_MSG_BAD_CERT
    if verify_result.bit_and(x509.X509_BADCERT_KEY_USAGE) != 0 -> return ssldefs.SSL_ALERT_MSG_UNSUPPORTED_CERT
    if verify_result.bit_and(x509.X509_BADCERT_EXT_KEY_USAGE) != 0 -> return ssldefs.SSL_ALERT_MSG_UNSUPPORTED_CERT
    if verify_result.bit_and(x509.X509_BADCERT_BAD_PK) != 0 -> return ssldefs.SSL_ALERT_MSG_UNSUPPORTED_CERT
    if verify_result.bit_and(x509.X509_BADCERT_BAD_KEY) != 0 -> return ssldefs.SSL_ALERT_MSG_UNSUPPORTED_CERT
    if verify_result.bit_and(x509.X509_BADCERT_EXPIRED) != 0 -> return ssldefs.SSL_ALERT_MSG_CERT_EXPIRED
    if verify_result.bit_and(x509.X509_BADCERT_REVOKED) != 0 -> return ssldefs.SSL_ALERT_MSG_CERT_REVOKED
    if verify_result.bit_and(x509.X509_BADCERT_NOT_TRUSTED) != 0 -> return ssldefs.SSL_ALERT_MSG_UNKNOWN_CA
    ssldefs.SSL_ALERT_MSG_CERT_UNKNOWN
}

// The X.509 check of `chain` against the SNI callback's CAs and CRLs if it
// set any, else the configuration's, at ssl_time's UTC date; the failure,
// None for none.
ssl_verify_chain: fn(ssl: &ssldefs.SSLContext, chain: &[x509crt.X509Crt], cn: [U8]?, vrfy: x509crt.X509VerifyCallback?) -> x509.X509Error? Never! {
    // The CRLs and profile are read before the CA list's write window.
    profile := ssl.conf.cert_profile
    sni_crl := ssl.handshake.sni_ca_crl.copy()
    conf_crl := ssl.conf.ca_crl.copy()
    now: x509.x509_time_gmtime(ssldefs.ssl_time())
    if &ssl.handshake.sni_ca_chain == {
        .Val(c) -> {
            if x509crt.x509_crt_verify_with_profile_at(chain, c, sni_crl, profile, cn, vrfy, now) == {
                .Err(e) -> return Val(e)
                else -> return None
            }
        }
        None -> {}
    }
    if &ssl.conf.ca_chain == {
        .Val(c) -> {
            if x509crt.x509_crt_verify_with_profile_at(chain, c, conf_crl, profile, cn, vrfy, now) == {
                .Err(e) -> return Val(e)
                else -> return None
            }
        }
        None -> {}
    }
    empty := [x509crt.X509Crt]{}
    if x509crt.x509_crt_verify_with_profile_at(chain, empty, conf_crl, profile, cn, vrfy, now) == {
        .Err(e) -> Val(e)
        else -> None
    }
}

/// Verify the peer's chain under `authmode` (mbedtls_ssl_verify_certificate):
/// the X.509 check against the CAs, the SNI callback's if it set any, then
/// the curve of a TLS 1.2 EC key and the key usages. The result is in the
/// negotiated session's verify_result; a failure sends its alert.
ssl_verify_certificate: fn<R: RNG>(ssl: &ssldefs.SSLContext, authmode: Int, chain: &[x509crt.X509Crt], ciphersuite_info: suites.SSLCiphersuite?, rng: &R) ssldefs.SSLError! {
    sn: ssl.session_negotiate
    if authmode == ssldefs.SSL_VERIFY_NONE {
        ssl.spool[sn].verify_result = 0
        return
    }
    vrfy := ssl.conf.f_vrfy
    if ssl.f_vrfy == {
        .Val(_) -> vrfy = ssl.f_vrfy
        None -> {}
    }
    // get_hostname_for_verification.
    if !ssl_has_set_hostname_been_called(ssl) && ssl.conf.endpoint == ssldefs.SSL_IS_CLIENT && ssl.conf.authmode == ssldefs.SSL_VERIFY_REQUIRED -> return Err(.CertificateVerificationWithoutHostname)
    cn: ssl_hostname_bytes(ssl)
    have_ca_chain: ssl.handshake.sni_ca_chain != None || ssl.conf.ca_chain != None
    failed := false
    reason := ssldefs.SSLError.InternalError
    if ssl_verify_chain(ssl, chain, cn, vrfy) == {
        .Val(e) -> {
            failed = true
            reason = ssldefs.SSLError.X509(e)
            // C's flags: those of the failed check, all set for any other error.
            if e == {
                .CertVerifyFailed(f) -> ssl.spool[sn].verify_result = f
                else -> ssl.spool[sn].verify_result = 0xFFFFFFFF
            }
        }
        None -> ssl.spool[sn].verify_result = 0
    }
    // The secondary checks are always made, but change the result only if
    // the X.509 check passed. An empty chain has no key and no extensions,
    // which pass them.
    if chain.len() > 0 {
        // The curve check is TLS 1.2's: a TLS 1.3 ECDSA signature algorithm
        // names the curve, and the CertificateVerify's key must be on it
        // (ssl_tls13_key_fits).
        if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_2 && pk.pk_can_do(chain[0].pk, .ECKey) && !ssl_check_curve(ssl, pk.pk_get_ec_group_id(chain[0].pk)) {
            ssl.spool[sn].verify_result = ssl.spool[sn].verify_result.bit_or(x509.X509_BADCERT_BAD_KEY)
            if !failed {
                failed = true
                reason = ssldefs.SSLError.BadCertificate
            }
        }
        flags := ssl.spool[sn].verify_result
        usage_ok: ssl_check_cert_usage(chain[0], ciphersuite_info, ssl.conf.endpoint, ssl.tls_version, flags)
        ssl.spool[sn].verify_result = flags
        if !usage_ok && !failed {
            failed = true
            reason = ssldefs.SSLError.BadCertificate
        }
    }
    // VERIFY_OPTIONAL goes on with an unacceptable certificate, but not past
    // other errors, such as a verification callback's.
    if failed && authmode == ssldefs.SSL_VERIFY_OPTIONAL && ssl_verify_failure_is_soft(reason) -> failed = false
    // Verifying without trust anchors is a configuration error.
    if !have_ca_chain && authmode == ssldefs.SSL_VERIFY_REQUIRED {
        failed = true
        reason = ssldefs.SSLError.CAChainRequired
    }
    if failed {
        alert: ssl_verify_alert(ssl.spool[sn].verify_result)
        ssl_send_fatal_alert(ssl, alert, rng)
        return Err(reason)
    }
}

// ---------------------------------------------------------------------------
// Keying material export.

/// `key_len` bytes of keying material for `label` and, if given, `context`
/// (mbedtls_ssl_export_keying_material, RFC 5705 4 and RFC 8446 7.5).
ssl_export_keying_material: fn(ssl: ssldefs.SSLContext, key_len: Int, label: [U8], context: [U8]?) -> [U8] ssldefs.SSLError! {
    if !sslmsg.ssl_is_handshake_over(ssl) -> return Err(.BadInputData)
    if key_len > ssldefs.SSL_EXPORT_MAX_KEY_LEN -> return Err(.BadInputData)
    cs: suites.ssl_ciphersuite_from_id(ssl_get_ciphersuite_id_from_ssl(ssl)) ?? return Err(.InternalError)
    hash_alg: cs.mac
    if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_2 {
        // Client random, server random, then the context after its 2-byte
        // length.
        randbytes: ssl.tpool[ssl.transform].randbytes
        prf_input := ssldefs.ssl_bytes_of(randbytes, ssldefs.SERVER_HELLO_RANDOM_LEN, ssldefs.CLIENT_HELLO_RANDOM_LEN)
        prf_input.extend(ssldefs.ssl_bytes_of(randbytes, 0, ssldefs.SERVER_HELLO_RANDOM_LEN))
        if context == {
            .Val(c) -> {
                if c.len() > 0xFFFF -> return Err(.BadInputData)
                ssldefs.ssl_push_u16(prf_input, c.len())
                prf_input.extend(c.copy())
            }
            None -> {}
        }
        return Ok(ssl_tls_prf_generic(hash_alg, ssl.spool[ssl.session].master, label, prf_input, key_len))
    }
    if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_3 {
        // The label fits an HkdfLabel (RFC 8446 7.1); the context is hashed.
        if label.len() > 249 -> return Err(.BadInputData)
        secret: ssldefs.ssl_bytes_of(ssl.spool[ssl.session].app_secrets.exporter_master_secret, 0, hashes.md_size(hash_alg))
        return keys13.ssl_tls13_exporter(hash_alg, secret, label, context ?? [U8]{}, key_len)
    }
    Err(.BadProtocolVersion)
}

// ---------------------------------------------------------------------------
// The published test vectors of every algorithm Core's TLS and crypto
// callers use (#6694).
//
// NIST CAVP vectors (public domain) are committed under tests/vectors/nist,
// trimmed to the parameters Core's TLS enables; tests/vectors/UPSTREAM.md
// names their sources. Wycheproof vectors (Apache-2.0) are not committed:
// each test fetches the files it needs from the pinned Wycheproof commit over
// Core's own HTTPS client, checks each against its SHA-256 pin and caches it
// under $XDG_CACHE_HOME/jet/vectors/wycheproof/<commit>, or ~/.cache when
// XDG_CACHE_HOME is unset. A cached file whose digest differs is fetched
// again; a fetched file whose digest differs fails the test.
//
// The tests read tests/vectors/nist relative to the working directory, so
// they run from the repository root: `jet test Core/Net/SSL/TLS.jet`.
// ---------------------------------------------------------------------------

/// The Wycheproof commit the pins below name.
VEC_WYCHEPROOF_COMMIT: "d17cc89fa5c8f4f4d378b5385ebf75da5d0926c9"

/// The committed NIST CAVP files, relative to the repository root.
VEC_NIST_DIR: "tests/vectors/nist"

/// The SHA-256 of Wycheproof file `name` (testvectors_v1/<name>_test.json)
