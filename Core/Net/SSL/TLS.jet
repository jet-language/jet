        "ecdsa_secp384r1_sha384" -> "8a5b3ae1760975143414811f13588c24d951d9d8c904195087ba327591dfe9cc"
        "rsa_signature_2048_sha256" -> "94a917b01ff50fb874cfc05bf29b4af44868d944a6558201cf18380da93fb393"
        "rsa_signature_2048_sha384" -> "c571c105d261c0ff588a2888a529f152563fb3b77894b7620d4e4f8f934f2c1d"
