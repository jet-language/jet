        "xchacha20_poly1305" -> "a79de072571b90eb40c3a63ce0c7f75dcb4b62323c8870228e1f61dcc61d63a9"
        "ed25519" -> "ea80ffebac085e21cb9d3e903e7fa2b448d96702da5b31f061d0b83b430b74b3"
        else -> ""
    }
}

// ---------------------------------------------------------------------------
// Tallies
// ---------------------------------------------------------------------------

/// The outcome of one vector file: records that agree, records that do not
/// (each named in `failures`), and invalid Wycheproof signatures accepted
/// because the DER reader takes BER lengths and INTEGERs without their sign
/// byte, as the C reader does.
VecTally: struct {
    what: String
    pass: Int
    fail: Int
    lenient: Int
    failures: [String]
}

vec_tally: fn(what: String) -> VecTally Never! { VecTally{what: what, pass: 0, fail: 0, lenient: 0, failures: [String]{}} }

vec_check: fn(t: &VecTally, ok: Bool, record: String) Never! {
    if ok {
        t.pass += 1
        return
    }
    t.fail += 1
    if t.failures.len() < 8 -> t.failures.push(record.copy())
}

/// `got` holds exactly `want`.
vec_is: fn(got: [U8]?, want: [U8]) -> Bool Never! {
    g: got ?? return false
    g == want
}

/// Every record of `t` agreed, and there was at least one.
vec_assert: fn(t: VecTally) {
    if t.fail > 0 || t.pass == 0 {
        detail := ""
        loop f in t.failures -> detail = "{detail}\n  {f}"
        panic("{t.what}: {t.pass} agree, {t.fail} disagree{detail}")
    }
}

/// The bytes of hex `text`. CAVP files drop a leading zero nibble, as in
/// `e = 7485b`, so an odd-length value takes one back.
vec_hex: fn(text: String) -> [U8] {
    digits: text.trim()
    even: if digits.len() %% 2 == 1 -> "0{digits}" else -> digits
    core.encoding.hex_to_bytes(even) ?? panic("bad hex `{text}`")
}

vec_concat: fn(a: [U8], b: [U8]) -> [U8] Never! {
    out := a.copy()
    loop x in b -> out.push(x)
    out
}

vec_md_named: fn(name: String) -> hashes.Md? Never! {
    if name == {
        "SHA-256" | "SHA256" -> Val(hashes.Md.SHA256)
        "SHA-384" | "SHA384" -> Val(hashes.Md.SHA384)
        "SHA-512" | "SHA512" -> Val(hashes.Md.SHA512)
        else -> None
    }
}

/// A deterministic generator for the blinding the ECDH and RSA operations ask
/// for; the vectors' results do not depend on it.
vec_rng: fn() -> drbg.HMACDrbg Never! {
    g := drbg.hmac_drbg_new(.SHA256)
    drbg.hmac_drbg_seed_buf(g, "Jet test vector blinding".bytes())
    g
}

// ---------------------------------------------------------------------------
// NIST CAVP response files
// ---------------------------------------------------------------------------

/// One blank-line-separated paragraph of a response file: the bracketed
/// header lines of its section, joined, and its lines in order.
VecRecord: struct {
    section: String
    names: [String]
    values: [String]
}

/// The paragraphs of tests/vectors/nist/`file` that hold fields.
vec_nist: fn(file: String) -[FS.Read]> [VecRecord] {
    path: "{VEC_NIST_DIR}/{file}"
    text: core.files.read(path) ?? panic("{path}: {err}; the vector tests run from the repository root")
    out := [VecRecord]{}
    section := ""
    in_header := false
    names := [String]{}
    values := [String]{}
    loop raw in text.lines() {
        line: raw.trim()
        if line.starts_with("#") -> next
        if line.starts_with("[") {
            if !in_header -> section = ""
            in_header = true
            section = "{section}{line}"
            next
        }
        in_header = false
        if line.is_empty() {
            if names.len() > 0 -> out.push(VecRecord{section: section.copy(), names: names.move(), values: values.move()})
            names = [String]{}
            values = [String]{}
            next
        }
        // `Name = value`, the value possibly empty.
        if line.split_once("=") == {
            .Val(parts) -> {
                names.push(parts.before.trim())
                values.push(parts.after.trim())
            }
            None -> {
                // A bare marker line, FAIL in the GCM decryption files.
                names.push(line.copy())
                values.push("")
            }
        }
    }
    if names.len() > 0 -> out.push(VecRecord{section: section.copy(), names: names.move(), values: values.move()})
    out
}

vec_has: fn(r: VecRecord, name: String) -> Bool Never! { r.names.contains(name) }

/// The `nth` value named `name` in r (fields repeat in the DRBG files).
vec_field_nth: fn(r: VecRecord, name: String, nth: Int) -> String {
    seen := 0
    loop i in 0..<r.names.len() {
        if r.names[i] == name {
            if seen == nth -> return r.values[i].copy()
            seen += 1
        }
    }
    panic("record has no field {name} #{nth}")
}

vec_field: fn(r: VecRecord, name: String) -> String { vec_field_nth(r, name, 0) }

vec_bytes: fn(r: VecRecord, name: String) -> [U8] { vec_hex(vec_field(r, name)) }

vec_label: fn(file: String, r: VecRecord, n: Int) -> String Never! { "{file} {r.section} record {n}" }

// ---------------------------------------------------------------------------
// Wycheproof files
// ---------------------------------------------------------------------------

vec_cache_dir: fn() -[Env]> String {
    xdg: core.sys.get("XDG_CACHE_HOME") ?? ""
    root: if !xdg.is_empty() -> xdg else -> "{core.sys.home_dir() ?? panic("no home directory for the vector cache")}/.cache"
    "{root}/jet/vectors/wycheproof/{VEC_WYCHEPROOF_COMMIT}"
}

vec_sha256_hex: fn(bytes: [U8]) -> String Never! { core.encoding.bytes_to_hex(hashes.hash(.SHA256, bytes)) }

/// The parsed Wycheproof file testvectors_v1/`name`_test.json, from the
/// cache when its digest matches the pin, else fetched and cached.
vec_wycheproof: fn(name: String) -[FS, Env, Net, Time.Wait]> Dyn {
    pin: vec_wycheproof_pin(name)
    if pin.is_empty() -> panic("Wycheproof file {name} has no SHA-256 pin")
    dir: vec_cache_dir()
    path: "{dir}/{name}_test.json"
    bytes := [U8]{}
    if core.files.exists(path) {
        cached: core.files.read_bytes(path) ?? panic("{path}: {err}")
        if vec_sha256_hex(cached) == pin -> bytes = cached.copy()
    }
    if bytes.is_empty() {
        url: "https://raw.githubusercontent.com/C2SP/wycheproof/{VEC_WYCHEPROOF_COMMIT}/testvectors_v1/{name}_test.json"
        response: core.http.get(url) ?? panic("Fetching {url}: {err}")
        if response.status != 200 -> panic("Fetching {url}: HTTP {response.status}")
        body: response.body.bytes(64000000) ?? panic("Fetching {url}: {err}")
        got: vec_sha256_hex(body)
        if got != pin -> panic("{url} has SHA-256 {got}, not the pinned {pin}")
        core.files.create_dir_all(dir) ?? panic("{dir}: {err}")
        core.files.write_atomic(path, body) ?? panic("{path}: {err}")
        bytes = body.copy()
    }
    text: String.from_bytes(bytes) ?? panic("{name}: not UTF-8")
    core.encoding.json.parse(text) ?? panic("{name}: {err}")
}

vec_text: fn(d: Dyn, key: String) -> String {
    if d[key] == {
        .Text(s) -> s.copy()
        else -> panic("Wycheproof field {key} is missing")
    }
}

vec_int: fn(d: Dyn, key: String) -> Int {
    if d[key] == {
        .Int(n) -> n
        .Number(s) -> Int.parse(s) ?? panic("Wycheproof field {key}: {s}")
        .Float(x) -> Int.from_float(x) ?? panic("Wycheproof field {key}: {x}")
        else -> panic("Wycheproof field {key} is missing")
    }
}

vec_items: fn(d: Dyn, key: String) -> [Dyn] {
    if d[key] == {
        .Array(items) -> items.copy()
        else -> panic("Wycheproof field {key} is missing")
    }
}

vec_flags: fn(d: Dyn) -> [String] {
    out := [String]{}
    loop f in vec_items(d, "flags") {
        if f == .Text(s) -> out.push(s.copy())
    }
    out
}

vec_wy_hex: fn(d: Dyn, key: String) -> [U8] { vec_hex(vec_text(d, key)) }

/// Tally Wycheproof case `c`: a valid case must be accepted, an invalid one
/// refused, an acceptable one either. `lenient_der` counts invalid DER
/// signatures with BER lengths or unsigned INTEGERs apart when accepted.
vec_wy_verdict: fn(t: &VecTally, file: String, c: Dyn, accepted: Bool, lenient_der: Bool) {
    result: vec_text(c, "result")
    ok: if result == {
        "valid" -> accepted
        "invalid" -> !accepted
        else -> true
    }
    if ok {
        t.pass += 1
        return
    }
    flags: vec_flags(c)
    comment: vec_text(c, "comment")
    if lenient_der && result == "invalid" && (flags.contains("BerEncodedSignature") || flags.contains("MissingZero") || comment == "prepending 0's to r" || comment == "prepending 0's to s") {
        t.lenient += 1
        return
    }
    vec_check(t, false, "{file} tcId {vec_int(c, "tcId")} ({result}: {comment})")
}

// ---------------------------------------------------------------------------
// AEAD: AES-GCM and ChaCha20-Poly1305
// ---------------------------------------------------------------------------

vec_gcm_seal: fn(key: [U8], iv: [U8], aad: [U8], plain: [U8]) -> [U8]? {
    k: aead.gcm_key(cipher.aes_key(key, false) ?? return None)
    aead.gcm_encrypt(k, iv, aad, plain, 16) ?? return None
}

vec_gcm_open: fn(key: [U8], iv: [U8], aad: [U8], sealed: [U8]) -> [U8]? {
    k: aead.gcm_key(cipher.aes_key(key, false) ?? return None)
    aead.gcm_decrypt(k, iv, aad, sealed, 16) ?? return None
}

// A TLS 1.3 client's check of a server CertificateVerify, under
// `algorithm`, whose signature over `signed` is `signature` and whose
// certificate key is `key`: 0 when the engine takes it, else the alert it
// pends.
vec_certificate_verify: fn(key: &&pk.PKContext, algorithm: Int, signature: [U8], signed: [U8]) -> Int {
    conf := ssldefs.SSLConfig{}
    ssl_config_defaults(conf, ssldefs.SSL_IS_CLIENT, ssldefs.SSL_TRANSPORT_STREAM, ssldefs.SSL_PRESET_DEFAULT) ?? panic("defaults: {err}")
    ssl := ssldefs.SSLContext{}
    ssl_setup(ssl, conf) ?? panic("setup: {err}")
    ssl.tls_version = ssldefs.SSL_VERSION_TLS1_3
    sn: ssldefs.ssl_session_alloc(ssl)
    ssl.session_negotiate = sn
    crt := x509crt.x509_crt_new()
    crt.pk = key
    chain := [x509crt.X509Crt]{}
    chain.push(crt)
    ssl.spool[sn].peer_cert = Val(chain)
    body := [U8]{ssldefs.ssl_byte(algorithm >> 8), ssldefs.ssl_byte(algorithm), ssldefs.ssl_byte(signature.len() >> 8), ssldefs.ssl_byte(signature.len())}
    body.extend(signature.copy())
    ssl.in_buf = body.copy()
    if gen13.ssl_tls13_parse_certificate_verify(ssl, 0, body.len(), signed) == .Err(_) -> return ssl.alert_type
    0
}

vec_localhost_key: fn() -> pk.PKContext {
    rng := vec_rng()
    pem_key: core.files.read_bytes("tests/fixtures/tls/localhost.key.pem") ?? panic("{err}")
    pkparse.pk_parse_key(pem_key, None, rng) ?? panic("localhost.key.pem: {err}")
}

vec_ec_key: fn(id: ecp.GroupID) -> pk.PKContext {
    rng := vec_rng()
    key := pk.pk_new()
    pk.pk_setup(key, Val(oids.PKType.ECKey)) ?? panic("pk_setup: {err}")
    key.ec = ecp.gen_key(id, rng) ?? panic("gen_key: {err}")
    key
}

#Test("A TLS 1.3 CertificateVerify must use an algorithm RFC 8446 allows there, and an ECDSA one must name the key's curve") {
    rng := vec_rng()
    signed: "TLS 1.3 CertificateVerify content".bytes()
    sha256: hashes.hash(.SHA256, signed)
    sha384: hashes.hash(.SHA384, signed)
    // RSASSA-PSS is taken; PKCS#1 v1.5, which the default configuration
    // offers for certificate signatures only, is refused with a signature
    // that verifies.
    pss_key := vec_localhost_key()
    pss: pk.pk_sign_ext(.RSASSAPSS, pss_key, Val(hashes.Md.SHA256), sha256, 1024, rng) ?? panic("PSS: {err}")
    assert_eq(vec_certificate_verify(pss_key, ssldefs.TLS1_3_SIG_RSA_PSS_RSAE_SHA256, pss, signed), 0)
    pkcs1_key := vec_localhost_key()
    pkcs1: pk.pk_sign(pkcs1_key, Val(hashes.Md.SHA256), sha256, 1024, rng) ?? panic("PKCS#1: {err}")
    pk.pk_verify_ext(.RSA, None, pkcs1_key, Val(hashes.Md.SHA256), sha256, pkcs1) ?? panic("the PKCS#1 v1.5 signature does not verify: {err}")
    assert_eq(vec_certificate_verify(pkcs1_key, ssldefs.TLS1_3_SIG_RSA_PKCS1_SHA256, pkcs1, signed), ssldefs.SSL_ALERT_MSG_DECRYPT_ERROR)
    // A P-256 key signs under ecdsa_secp256r1_sha256, but not under
    // ecdsa_secp384r1_sha384 with a signature over the SHA-384 hash that
    // verifies.
    p256_key := vec_ec_key(.Secp256r1)
    p256: pk.pk_sign(p256_key, Val(hashes.Md.SHA256), sha256, 200, rng) ?? panic("ECDSA: {err}")
    assert_eq(vec_certificate_verify(p256_key, ssldefs.TLS1_3_SIG_ECDSA_SECP256R1_SHA256, p256, signed), 0)
    mismatch_key := vec_ec_key(.Secp256r1)
    mismatch: pk.pk_sign(mismatch_key, Val(hashes.Md.SHA384), sha384, 200, rng) ?? panic("ECDSA: {err}")
    pk.pk_verify_ext(.ECDSA, None, mismatch_key, Val(hashes.Md.SHA384), sha384, mismatch) ?? panic("the P-256 signature over SHA-384 does not verify: {err}")
    assert_eq(vec_certificate_verify(mismatch_key, ssldefs.TLS1_3_SIG_ECDSA_SECP384R1_SHA384, mismatch, signed), ssldefs.SSL_ALERT_MSG_DECRYPT_ERROR)
}

#Test("NIST CAVP GCM vectors seal and open with AES-128 and AES-256, 96-bit IVs and 128-bit tags") {
    loop file in ([String]{"gcmEncryptExtIV128.rsp", "gcmEncryptExtIV256.rsp"}) {
        t := vec_tally(file)
        records: vec_nist(file)
        loop n in 0..<records.len() {
            r: records[n]
            if !vec_has(r, "Key") -> next
            sealed: vec_concat(vec_bytes(r, "CT"), vec_bytes(r, "Tag"))
            got: vec_gcm_seal(vec_bytes(r, "Key"), vec_bytes(r, "IV"), vec_bytes(r, "AAD"), vec_bytes(r, "PT"))
            vec_check(t, vec_is(got, sealed), vec_label(file, r, n))
        }
        vec_assert(t)
    }
    loop file in ([String]{"gcmDecrypt128.rsp", "gcmDecrypt256.rsp"}) {
        t := vec_tally(file)
        records: vec_nist(file)
        loop n in 0..<records.len() {
            r: records[n]
            if !vec_has(r, "Key") -> next
            sealed: vec_concat(vec_bytes(r, "CT"), vec_bytes(r, "Tag"))
            got: vec_gcm_open(vec_bytes(r, "Key"), vec_bytes(r, "IV"), vec_bytes(r, "AAD"), sealed)
            ok: if vec_has(r, "FAIL") -> got == None else -> vec_is(got, vec_bytes(r, "PT"))
            vec_check(t, ok, vec_label(file, r, n))
        }
        vec_assert(t)
    }
}

#Test("Wycheproof AES-GCM vectors with the key, IV and tag sizes TLS uses seal and open") {
    file: "aes_gcm"
    t := vec_tally(file)
    loop g in vec_items(vec_wycheproof(file), "testGroups") {
        key_size: vec_int(g, "keySize")
        if (key_size != 128 && key_size != 256) || vec_int(g, "ivSize") != 96 || vec_int(g, "tagSize") != 128 -> next
        loop c in vec_items(g, "tests") {
            key: vec_wy_hex(c, "key")
            iv: vec_wy_hex(c, "iv")
            aad: vec_wy_hex(c, "aad")
            msg: vec_wy_hex(c, "msg")
            sealed: vec_concat(vec_wy_hex(c, "ct"), vec_wy_hex(c, "tag"))
            opened: vec_gcm_open(key, iv, aad, sealed)
            accepted := vec_is(opened, msg)
            if vec_text(c, "result") == "valid" -> accepted = accepted && vec_is(vec_gcm_seal(key, iv, aad, msg), sealed)
            vec_wy_verdict(t, file, c, accepted, false)
        }
    }
    vec_assert(t)
}

#Test("Wycheproof ChaCha20-Poly1305 vectors with 96-bit nonces seal and open") {
    file: "chacha20_poly1305"
    t := vec_tally(file)
    loop g in vec_items(vec_wycheproof(file), "testGroups") {
        if vec_int(g, "ivSize") != 96 || vec_int(g, "tagSize") != 128 -> next
        loop c in vec_items(g, "tests") {
            key: vec_wy_hex(c, "key")
            iv: vec_wy_hex(c, "iv")
            aad: vec_wy_hex(c, "aad")
            msg: vec_wy_hex(c, "msg")
            sealed: vec_concat(vec_wy_hex(c, "ct"), vec_wy_hex(c, "tag"))
            accepted := vec_is(vec_chacha_open(key, iv, aad, sealed), msg)
            if vec_text(c, "result") == "valid" -> accepted = accepted && vec_is(vec_chacha_seal(key, iv, aad, msg), sealed)
            vec_wy_verdict(t, file, c, accepted, false)
        }
    }
    vec_assert(t)
}

vec_chacha_seal: fn(key: [U8], nonce: [U8], aad: [U8], plain: [U8]) -> [U8]? {
    aead.chachapoly_encrypt(key, nonce, aad, plain) ?? return None
}

vec_chacha_open: fn(key: [U8], nonce: [U8], aad: [U8], sealed: [U8]) -> [U8]? {
    aead.chachapoly_decrypt(key, nonce, aad, sealed) ?? return None
}

// ---------------------------------------------------------------------------
// Key agreement: X25519 and ECDH over P-256 and P-384
// ---------------------------------------------------------------------------

/// The shared secret of private key `private` and peer point `public` on
/// curve `id`, in its wire form: little-endian for X25519, big-endian
/// field-size bytes otherwise.
vec_ecdh: fn(id: ecp.GroupID, private: [U8], public: [U8]) -> [U8]? {
    key := ecp.keypair_new()
    ecp.read_key(id, key, private) ?? return None
    q: ecp.point_read_binary(key.grp, public) ?? return None
    rng := vec_rng()
    z: ecdh.ecdh_compute_shared(key.grp, q, key.d, rng) ?? return None
    size: (key.grp.pbits + 7) >> 3
    if ecp.group_type(key.grp) == .Montgomery -> return Val(bn.write_binary_le(z, size) ?? return None)
    Val(bn.write_binary(z, size) ?? return None)
}

/// A big-endian scalar at exactly `size` bytes: Wycheproof's private keys
/// carry a sign byte or drop leading zeros.
vec_scalar: fn(bytes: [U8], size: Int) -> [U8]? {
    x: bn.read_binary(bytes) ?? return None
    Val(bn.write_binary(x, size) ?? return None)
}

#Test("NIST CAVP ECC CDH primitive vectors agree on P-256 and P-384") {
    file: "ECC_CDH_Primitive.txt"
    t := vec_tally(file)
    records: vec_nist(file)
    loop n in 0..<records.len() {
        r: records[n]
        if !vec_has(r, "dIUT") -> next
        id: if {
            r.section.contains("P-256") -> ecp.GroupID.Secp256r1
            r.section.contains("P-384") -> ecp.GroupID.Secp384r1
            else -> panic("{file}: section {r.section}")
        }
        public := [U8]{0x04}
        loop b in vec_bytes(r, "QCAVSx") -> public.push(b)
        loop b in vec_bytes(r, "QCAVSy") -> public.push(b)
        got: vec_ecdh(id, vec_bytes(r, "dIUT"), public)
        vec_check(t, got == Val(vec_bytes(r, "ZIUT")), vec_label(file, r, n))
    }
    vec_assert(t)
}

#Test("Wycheproof X25519 vectors agree, and low-order points give no secret") {
    file: "x25519"
    t := vec_tally(file)
    loop g in vec_items(vec_wycheproof(file), "testGroups") {
        if vec_text(g, "curve") != "curve25519" -> next
        loop c in vec_items(g, "tests") {
            got: vec_ecdh(.Curve25519, vec_wy_hex(c, "private"), vec_wy_hex(c, "public"))
            // The all-zero secret of a low-order point is refused, as RFC
            // 7748 section 6.1 lets a TLS peer check.
            zero: cipher.zero_bytes(32)
            accepted: vec_is(got, vec_wy_hex(c, "shared")) && !vec_is(got, zero)
            vec_wy_verdict(t, file, c, accepted, false)
        }
    }
    vec_assert(t)
}

#Test("Wycheproof ECDH vectors on uncompressed P-256 and P-384 points agree, and bad points are refused") {
    loop file in ([String]{"ecdh_secp256r1_ecpoint", "ecdh_secp384r1_ecpoint"}) {
        t := vec_tally(file)
        id: if file.contains("256") -> ecp.GroupID.Secp256r1 else -> ecp.GroupID.Secp384r1
        size: if id == .Secp256r1 -> 32 else -> 48
        loop g in vec_items(vec_wycheproof(file), "testGroups") {
            loop c in vec_items(g, "tests") {
                private: vec_scalar(vec_wy_hex(c, "private"), size)
                got: if private == {
                    .Val(d) -> vec_ecdh(id, d, vec_wy_hex(c, "public"))
                    None -> None
                }
                vec_wy_verdict(t, file, c, got == Val(vec_wy_hex(c, "shared")), false)
            }
        }
        vec_assert(t)
    }
}

// ---------------------------------------------------------------------------
// Signatures: ECDSA and RSA
// ---------------------------------------------------------------------------

#Test("NIST CAVP ECDSA SigVer vectors verify on P-256 with SHA-256 and P-384 with SHA-384") {
    file: "ECDSA_SigVer.rsp"
    t := vec_tally(file)
    records: vec_nist(file)
    loop n in 0..<records.len() {
        r: records[n]
        if !vec_has(r, "Msg") -> next
        p384: r.section == "[P-384,SHA-384]"
        if !p384 && r.section != "[P-256,SHA-256]" -> panic("{file}: section {r.section}")
        id: if p384 -> ecp.GroupID.Secp384r1 else -> ecp.GroupID.Secp256r1
        md: if p384 -> hashes.Md.SHA384 else -> hashes.Md.SHA256
        grp: ecp.group_load(id) ?? panic("group {id}")
        public := [U8]{0x04}
        loop b in vec_bytes(r, "Qx") -> public.push(b)
        loop b in vec_bytes(r, "Qy") -> public.push(b)
        hash: hashes.hash(md, vec_bytes(r, "Msg"))
        accepted: vec_ecdsa_raw(grp, public, hash, vec_bytes(r, "R"), vec_bytes(r, "S"))
        vec_check(t, accepted == vec_field(r, "Result").starts_with("P"), vec_label(file, r, n))
    }
    vec_assert(t)
}

/// Verify the raw signature (r, s) of `hash` under the uncompressed point
/// `public` on `grp`.
vec_ecdsa_raw: fn(grp: ecp.EcpGroup, public: [U8], hash: [U8], r: [U8], s: [U8]) -> Bool {
    q: ecp.point_read_binary(grp, public) ?? return false
    sig_r: bn.read_binary(r) ?? return false
    sig_s: bn.read_binary(s) ?? return false
    ecdsa.ecdsa_verify(grp, hash, q, sig_r, sig_s) ?? return false
    true
}

/// Verify `sig` over `msg` with the SubjectPublicKeyInfo `der` through the
/// PK layer, as a TLS peer's CertificateVerify is checked. `pss` carries the
/// salt length for RSASSA-PSS, or is None for PKCS#1 v1.5 and ECDSA.
vec_pk_verify: fn(der: [U8], md: hashes.Md, msg: [U8], sig: [U8], pss: Int?) -> Bool {
    ctx := pkparse.pk_parse_public_key(der) ?? return false
    hash: hashes.hash(md, msg)
    if pss == {
        .Val(salt) -> pk.pk_verify_ext(.RSASSAPSS, Val(pk.PSSOptions{mgf1_hash_id: Val(md), expected_salt_len: salt}), ctx, Val(md), hash, sig) ?? return false
        None -> pk.pk_verify(ctx, Val(md), hash, sig) ?? return false
    }
    true
}

#Test("Wycheproof ECDSA vectors verify DER signatures on P-256 with SHA-256 and P-384 with SHA-384") {
    loop file in ([String]{"ecdsa_secp256r1_sha256", "ecdsa_secp384r1_sha384"}) {
        t := vec_tally(file)
        loop g in vec_items(vec_wycheproof(file), "testGroups") {
            md: vec_md_named(vec_text(g, "sha")) ?? panic("{file}: hash {vec_text(g, "sha")}")
            der: vec_wy_hex(g, "publicKeyDer")
            loop c in vec_items(g, "tests") {
                accepted: vec_pk_verify(der, md, vec_wy_hex(c, "msg"), vec_wy_hex(c, "sig"), None)
                vec_wy_verdict(t, file, c, accepted, true)
            }
        }
        vec_assert(t)
    }
}

#Test("Wycheproof RSA PKCS#1 v1.5 vectors verify at 2048, 3072 and 4096 bits with SHA-256, SHA-384 and SHA-512") {
    files: [String]{
        "rsa_signature_2048_sha256", "rsa_signature_2048_sha384", "rsa_signature_2048_sha512",
        "rsa_signature_3072_sha256", "rsa_signature_3072_sha384",
        "rsa_signature_4096_sha256", "rsa_signature_4096_sha384", "rsa_signature_4096_sha512",
    }
    loop file in files {
        t := vec_tally(file)
        loop g in vec_items(vec_wycheproof(file), "testGroups") {
            md: vec_md_named(vec_text(g, "sha")) ?? panic("{file}: hash {vec_text(g, "sha")}")
            der: vec_wy_hex(g, "publicKeyDer")
            loop c in vec_items(g, "tests") {
                accepted: vec_pk_verify(der, md, vec_wy_hex(c, "msg"), vec_wy_hex(c, "sig"), None)
                vec_wy_verdict(t, file, c, accepted, false)
            }
        }
        vec_assert(t)
    }
}

#Test("Wycheproof RSASSA-PSS vectors verify with MGF1 over the signing hash and a salt of its length") {
    files: [String]{
        "rsa_pss_2048_sha256_mgf1_32", "rsa_pss_3072_sha256_mgf1_32", "rsa_pss_4096_sha256_mgf1_32",
        "rsa_pss_2048_sha384_mgf1_48", "rsa_pss_4096_sha384_mgf1_48", "rsa_pss_4096_sha512_mgf1_64",
    }
    loop file in files {
        t := vec_tally(file)
        loop g in vec_items(vec_wycheproof(file), "testGroups") {
            md: vec_md_named(vec_text(g, "sha")) ?? panic("{file}: hash {vec_text(g, "sha")}")
            if vec_md_named(vec_text(g, "mgfSha")) != Val(md) -> panic("{file}: MGF1 hash {vec_text(g, "mgfSha")}")
            der: vec_wy_hex(g, "publicKeyDer")
            salt: vec_int(g, "sLen")
            loop c in vec_items(g, "tests") {
                accepted: vec_pk_verify(der, md, vec_wy_hex(c, "msg"), vec_wy_hex(c, "sig"), Val(salt))
                vec_wy_verdict(t, file, c, accepted, false)
            }
        }
        vec_assert(t)
    }
}

/// The PKCS#1 v1.5 signature of `msg` under the PKCS#8 private key `der`,
/// made through the PK layer as a TLS server signs, is `want`.
vec_pk_signs: fn(der: [U8], md: hashes.Md, msg: [U8], want: [U8]) -> Bool {
    rng := vec_rng()
    ctx := pkparse.pk_parse_key(der, None, rng) ?? return false
    sig: pk.pk_sign(ctx, Val(md), hashes.hash(md, msg), 1024, rng) ?? return false
    sig == want
}

#Test("Wycheproof RSA PKCS#1 v1.5 signing vectors sign at 2048, 3072 and 4096 bits with SHA-256, SHA-384 and SHA-512") {
    loop file in ([String]{"rsa_pkcs1_2048_sig_gen", "rsa_pkcs1_3072_sig_gen", "rsa_pkcs1_4096_sig_gen"}) {
        t := vec_tally(file)
        loop g in vec_items(vec_wycheproof(file), "testGroups") {
            // SHA-1 and SHA-224 are not among the signature schemes Core's TLS offers.
            md: vec_md_named(vec_text(g, "sha")) ?? next
            der: vec_wy_hex(g, "privateKeyPkcs8")
            loop c in vec_items(g, "tests") {
                vec_wy_verdict(t, file, c, vec_pk_signs(der, md, vec_wy_hex(c, "msg"), vec_wy_hex(c, "sig")), false)
            }
        }
        vec_assert(t)
    }
}

/// An RSA public key with modulus `n` and exponent `e`, completed; None when
/// the parts do not form a key.
vec_rsa_key: fn(n: [U8], e: [U8]) -> rsa.RSAContext? {
    ctx := rsa.rsa_new()
    rsa.rsa_import_raw(ctx, .N, n) ?? return None
    rsa.rsa_import_raw(ctx, .E, e) ?? return None
    rsa.rsa_complete(ctx) ?? return None
    Val(ctx)
}

/// (n, e) accepts `sig` over `hash`: PKCS#1 v1.5, or RSASSA-PSS with MGF1
/// over `md` and a salt of `pss` bytes.
vec_rsa_verifies: fn(n: [U8], e: [U8], md: hashes.Md, hash: [U8], sig: [U8], pss: Int?) -> Bool {
    ctx := vec_rsa_key(n, e) ?? return false
    if pss == {
        .Val(salt) -> {
            rsa.rsa_set_padding(ctx, .PKCSV21, Val(md))
            rsa.rsa_rsassa_pss_verify_ext(ctx, Val(md), hash, Val(md), salt, sig) ?? return false
        }
        None -> rsa.rsa_pkcs1_verify(ctx, Val(md), hash, sig) ?? return false
    }
    true
}

#Test("NIST CAVP RSA PKCS#1 v1.5 SigGen and SigVer and RSASSA-PSS SigVer vectors verify at 2048 and 3072 bits") {
    // SigGen15 gives (n, e) and the deterministic signature of each message,
    // which must verify.
    gen_file: "RSA_SigGen15.rsp"
    gen := vec_tally(gen_file)
    gen_records: vec_nist(gen_file)
    n_hex := ""
    e_hex := ""
    loop i in 0..<gen_records.len() {
        r: gen_records[i]
        if vec_has(r, "n") -> n_hex = vec_field(r, "n")
        if vec_has(r, "e") -> e_hex = vec_field(r, "e")
        if !vec_has(r, "SHAAlg") -> next
        md: vec_md_named(vec_field(r, "SHAAlg")) ?? next
        verified: vec_rsa_verifies(vec_hex(n_hex), vec_hex(e_hex), md, hashes.hash(md, vec_bytes(r, "Msg")), vec_bytes(r, "S"), None)
        vec_check(gen, verified, vec_label(gen_file, r, i))
    }
    vec_assert(gen)
    // SigVer15 and SigVerPSS: n heads each modulus section; e, the message
    // and the expected verdict are per record.
    loop file in ([String]{"RSA_SigVer15.rsp", "RSA_SigVerPSS.rsp"}) {
        t := vec_tally(file)
        records: vec_nist(file)
        pss: file.contains("PSS")
        n_hex = ""
        loop i in 0..<records.len() {
            r: records[i]
            if vec_has(r, "n") -> n_hex = vec_field(r, "n")
            if !vec_has(r, "SHAAlg") -> next
            md: vec_md_named(vec_field(r, "SHAAlg")) ?? next
            hash: hashes.hash(md, vec_bytes(r, "Msg"))
            sig: vec_bytes(r, "S")
            salt: if !pss -> None else if vec_field(r, "SaltVal") == "00" -> Val(0) else -> Val(vec_field(r, "SaltVal").len() >> 1)
            accepted: vec_rsa_verifies(vec_hex(n_hex), vec_bytes(r, "e"), md, hash, sig, salt)
            vec_check(t, accepted == vec_field(r, "Result").starts_with("P"), vec_label(file, r, i))
        }
        vec_assert(t)
    }
}

// ---------------------------------------------------------------------------
// MACs, key derivation and the generator
// ---------------------------------------------------------------------------

#Test("Wycheproof HMAC-SHA-256 and HMAC-SHA-384 vectors agree, truncated tags included") {
    loop file in ([String]{"hmac_sha256", "hmac_sha384"}) {
        t := vec_tally(file)
        md: if file == "hmac_sha256" -> hashes.Md.SHA256 else -> hashes.Md.SHA384
        loop g in vec_items(vec_wycheproof(file), "testGroups") {
            tag_bytes: vec_int(g, "tagSize") >> 3
            loop c in vec_items(g, "tests") {
                mac: hashes.hmac(md, vec_wy_hex(c, "key"), vec_wy_hex(c, "msg"))
                want: vec_wy_hex(c, "tag")
                accepted := want.len() == tag_bytes && tag_bytes <= mac.len()
                if accepted -> loop i in 0..<tag_bytes -> accepted = accepted && mac[i] == want[i]
                vec_wy_verdict(t, file, c, accepted, false)
            }
        }
        vec_assert(t)
    }
}

#Test("Wycheproof HKDF-SHA-256 and HKDF-SHA-384 vectors agree, and oversized outputs are refused") {
    loop file in ([String]{"hkdf_sha256", "hkdf_sha384"}) {
        t := vec_tally(file)
        md: if file == "hkdf_sha256" -> hashes.Md.SHA256 else -> hashes.Md.SHA384
        loop g in vec_items(vec_wycheproof(file), "testGroups") {
            loop c in vec_items(g, "tests") {
                got: hashes.hkdf(md, vec_wy_hex(c, "salt"), vec_wy_hex(c, "ikm"), vec_wy_hex(c, "info"), vec_int(c, "size"))
                vec_wy_verdict(t, file, c, vec_is(got, vec_wy_hex(c, "okm")), false)
            }
        }
        vec_assert(t)
    }
}

#Test("Wycheproof HKDF-SHA-256 and PBKDF2-HMAC-SHA-256 vectors agree through core.crypto's public KDFs") {
    hkdf_file: "hkdf_sha256"
    t := vec_tally("core.crypto.hkdf_sha256")
    loop g in vec_items(vec_wycheproof(hkdf_file), "testGroups") {
        loop c in vec_items(g, "tests") {
            accepted: vec_hkdf_public(c)
            vec_wy_verdict(t, hkdf_file, c, accepted, false)
        }
    }
    vec_assert(t)
    pbkdf2_file: "pbkdf2_hmacsha256"
    p := vec_tally("core.crypto.pbkdf2_hmac")
    loop g in vec_items(vec_wycheproof(pbkdf2_file), "testGroups") {
        loop c in vec_items(g, "tests") {
            accepted: vec_pbkdf2_public(c)
            vec_wy_verdict(p, pbkdf2_file, c, accepted, false)
        }
    }
    vec_assert(p)
}

vec_hkdf_public: fn(c: Dyn) -> Bool {
    out: core.crypto.hkdf_sha256(vec_wy_hex(c, "ikm"), vec_wy_hex(c, "salt"), vec_wy_hex(c, "info"), vec_int(c, "size")) ?? return false
    core.crypto.constant_time_equal(out, Secret.from_bytes(vec_wy_hex(c, "okm")))
}

vec_pbkdf2_public: fn(c: Dyn) -> Bool {
    dk: core.crypto.pbkdf2_hmac(vec_wy_hex(c, "password"), vec_wy_hex(c, "salt"), vec_int(c, "iterationCount"), vec_int(c, "dkLen")) ?? return false
    dk == vec_wy_hex(c, "dk")
}

#Test("NIST CAVP TLS 1.2 PRF vectors derive the master secret and key block with SHA-256 and SHA-384") {
    file: "TLS_PRF.rsp"
    t := vec_tally(file)
    records: vec_nist(file)
    loop n in 0..<records.len() {
        r: records[n]
        md: if {
            r.section.starts_with("[TLS 1.2, SHA-256]") -> hashes.Md.SHA256
            r.section.starts_with("[TLS 1.2, SHA-384]") -> hashes.Md.SHA384
            // TLS 1.0/1.1 and the SHA-512 PRF are not enabled in Core's TLS.
            else -> next
        }
        if !vec_has(r, "pre_master_secret") -> next
        want_master: vec_bytes(r, "master_secret")
        want_block: vec_bytes(r, "key_block")
        master: ssl_tls_prf_generic(md, vec_bytes(r, "pre_master_secret"), "master secret".bytes(), vec_concat(vec_bytes(r, "clientHello_random"), vec_bytes(r, "serverHello_random")), want_master.len())
        block: ssl_tls_prf_generic(md, master, "key expansion".bytes(), vec_concat(vec_bytes(r, "server_random"), vec_bytes(r, "client_random")), want_block.len())
        vec_check(t, master == want_master && block == want_block, vec_label(file, r, n))
    }
    vec_assert(t)
}

#Test("NIST CAVP HMAC_DRBG SHA-256 vectors without prediction resistance return the expected bits") {
    file: "HMAC_DRBG_SHA256.rsp"
    t := vec_tally(file)
    records: vec_nist(file)
    loop n in 0..<records.len() {
        r: records[n]
        if !vec_has(r, "EntropyInput") -> next
        g := drbg.hmac_drbg_new(.SHA256)
        seed := vec_concat(vec_bytes(r, "EntropyInput"), vec_bytes(r, "Nonce"))
        loop b in vec_bytes(r, "PersonalizationString") -> seed.push(b)
        drbg.hmac_drbg_seed_buf(g, seed)
        want: vec_bytes(r, "ReturnedBits")
        none := drbg.NoEntropy{}
        first: drbg.hmac_drbg_random_with_add(g, none, want.len(), vec_hex(vec_field_nth(r, "AdditionalInput", 0))) ?? panic("first generate")
        second: drbg.hmac_drbg_random_with_add(g, none, want.len(), vec_hex(vec_field_nth(r, "AdditionalInput", 1))) ?? panic("second generate")
        vec_check(t, first.len() == want.len() && second == want, vec_label(file, r, n))
    }
    vec_assert(t)
}

// ---------------------------------------------------------------------------
// core.crypto's own primitives: the AES-256-GCM, XChaCha20-Poly1305, X25519
// and Ed25519 of core.crypto.expert (Core/Crypto/Expert.jet and
// ExpertCt.jet), which core.crypto's envelopes, seal and signatures call
// ---------------------------------------------------------------------------

#Unsafe("`key` and `iv` are a vector record's, used for that record only") vec_expert_gcm_seal: fn(key: [U8], iv: [U8], aad: [U8], plain: [U8]) -> [U8]? {
    out := [U8]{}
    #Unsafe("a vector record's key and nonce, used for that record only") {
        out = core.crypto.expert.aes256gcm_seal(key, iv, plain, aad) ?? return None
    }
    Val(out)
}

#Unsafe("`key` and `iv` are a vector record's, used for that record only") vec_expert_gcm_open: fn(key: [U8], iv: [U8], aad: [U8], sealed: [U8]) -> [U8]? {
    out := [U8]{}
    #Unsafe("a vector record's key and nonce, used for that record only") {
        out = core.crypto.expert.aes256gcm_open(key, iv, sealed, aad) ?? return None
    }
    Val(out)
}

#Unsafe("`key` and `iv` are a vector record's, used for that record only") vec_expert_xchacha_seal: fn(key: [U8], iv: [U8], aad: [U8], plain: [U8]) -> [U8]? {
    out := [U8]{}
    #Unsafe("a vector record's key and nonce, used for that record only") {
        out = core.crypto.expert.xchacha20poly1305_seal(key, iv, plain, aad) ?? return None
    }
    Val(out)
}

#Unsafe("`key` and `iv` are a vector record's, used for that record only") vec_expert_xchacha_open: fn(key: [U8], iv: [U8], aad: [U8], sealed: [U8]) -> [U8]? {
    out := [U8]{}
    #Unsafe("a vector record's key and nonce, used for that record only") {
        out = core.crypto.expert.xchacha20poly1305_open(key, iv, sealed, aad) ?? return None
    }
    Val(out)
}

#Test("NIST CAVP GCM AES-256 vectors seal and open through core.crypto.expert") {
    #Unsafe("each record's key and IV are used for that record only") {
        file: "gcmEncryptExtIV256.rsp"
        t := vec_tally("{file} (expert)")
        records: vec_nist(file)
        loop n in 0..<records.len() {
            r: records[n]
            if !vec_has(r, "Key") -> next
            sealed: vec_concat(vec_bytes(r, "CT"), vec_bytes(r, "Tag"))
            got: vec_expert_gcm_seal(vec_bytes(r, "Key"), vec_bytes(r, "IV"), vec_bytes(r, "AAD"), vec_bytes(r, "PT"))
            vec_check(t, vec_is(got, sealed), vec_label(file, r, n))
        }
        vec_assert(t)
        open_file: "gcmDecrypt256.rsp"
        u := vec_tally("{open_file} (expert)")
        opened: vec_nist(open_file)
        loop n in 0..<opened.len() {
            r: opened[n]
            if !vec_has(r, "Key") -> next
            sealed: vec_concat(vec_bytes(r, "CT"), vec_bytes(r, "Tag"))
            got: vec_expert_gcm_open(vec_bytes(r, "Key"), vec_bytes(r, "IV"), vec_bytes(r, "AAD"), sealed)
            ok: if vec_has(r, "FAIL") -> got == None else -> vec_is(got, vec_bytes(r, "PT"))
            vec_check(u, ok, vec_label(open_file, r, n))
        }
        vec_assert(u)
    }
}

#Test("Wycheproof AES-256-GCM vectors with 96-bit IVs and 128-bit tags seal and open through core.crypto.expert") {
    file: "aes_gcm"
    t := vec_tally("{file} (expert)")
    loop g in vec_items(vec_wycheproof(file), "testGroups") {
        if vec_int(g, "keySize") != 256 || vec_int(g, "ivSize") != 96 || vec_int(g, "tagSize") != 128 -> next
        loop c in vec_items(g, "tests") {
            key: vec_wy_hex(c, "key")
            iv: vec_wy_hex(c, "iv")
            aad: vec_wy_hex(c, "aad")
            msg: vec_wy_hex(c, "msg")
            sealed: vec_concat(vec_wy_hex(c, "ct"), vec_wy_hex(c, "tag"))
            accepted := false
            #Unsafe("the record's key and IV are used for that record only") {
                accepted = vec_is(vec_expert_gcm_open(key, iv, aad, sealed), msg)
                if vec_text(c, "result") == "valid" -> accepted = accepted && vec_is(vec_expert_gcm_seal(key, iv, aad, msg), sealed)
            }
            vec_wy_verdict(t, file, c, accepted, false)
        }
    }
    vec_assert(t)
}

#Test("Wycheproof XChaCha20-Poly1305 vectors with 192-bit nonces seal and open through core.crypto.expert") {
    file: "xchacha20_poly1305"
    t := vec_tally(file)
    loop g in vec_items(vec_wycheproof(file), "testGroups") {
        if vec_int(g, "ivSize") != 192 || vec_int(g, "tagSize") != 128 -> next
        loop c in vec_items(g, "tests") {
            key: vec_wy_hex(c, "key")
            iv: vec_wy_hex(c, "iv")
            aad: vec_wy_hex(c, "aad")
            msg: vec_wy_hex(c, "msg")
            sealed: vec_concat(vec_wy_hex(c, "ct"), vec_wy_hex(c, "tag"))
            accepted := false
            #Unsafe("the record's key and nonce are used for that record only") {
                accepted = vec_is(vec_expert_xchacha_open(key, iv, aad, sealed), msg)
                if vec_text(c, "result") == "valid" -> accepted = accepted && vec_is(vec_expert_xchacha_seal(key, iv, aad, msg), sealed)
            }
            vec_wy_verdict(t, file, c, accepted, false)
        }
    }
    vec_assert(t)
}

#Unsafe("`private` is a vector record's key, used for that record only") vec_expert_x25519: fn(private: [U8], public: [U8]) -> [U8]? {
    out := [U8]{}
    #Unsafe("a vector record's private key, used for that record only") {
        shared: core.crypto.expert.x25519_raw(private, public) ?? return None
        out = core.crypto.expert.secret_bytes(shared)
    }
    Val(out)
}

#Unsafe("the arguments are a vector record's public key, message and signature") vec_expert_ed25519_verifies: fn(public: [U8], msg: [U8], sig: [U8]) -> Bool {
    accepted := false
    #Unsafe("verification of a vector record's public signature") {
        accepted = core.crypto.expert.ed25519_verify_strict(public, msg, sig) ?? return false
    }
    accepted
}

#Test("Wycheproof X25519 vectors agree through core.crypto.expert, and low-order points give no secret") {
    file: "x25519"
    t := vec_tally("{file} (expert)")
    loop g in vec_items(vec_wycheproof(file), "testGroups") {
        if vec_text(g, "curve") != "curve25519" -> next
        loop c in vec_items(g, "tests") {
            agreed := false
            #Unsafe("the record's private key is used for that record only") {
                agreed = vec_is(vec_expert_x25519(vec_wy_hex(c, "private"), vec_wy_hex(c, "public")), vec_wy_hex(c, "shared"))
            }
            vec_wy_verdict(t, file, c, agreed, false)
        }
    }
    vec_assert(t)
}

#Test("Wycheproof Ed25519 vectors verify strictly through core.crypto.expert") {
    file: "ed25519"
    t := vec_tally(file)
    loop g in vec_items(vec_wycheproof(file), "testGroups") {
        public: vec_wy_hex(g["publicKey"], "pk")
        loop c in vec_items(g, "tests") {
            accepted := false
            #Unsafe("the record's public key, message and signature") {
                accepted = vec_expert_ed25519_verifies(public, vec_wy_hex(c, "msg"), vec_wy_hex(c, "sig"))
            }
            vec_wy_verdict(t, file, c, accepted, false)
        }
    }
    vec_assert(t)
}

// ---------------------------------------------------------------------------
// Constant time: dudect timing tests
// ---------------------------------------------------------------------------
//
// dudect (Reparaz, Balasch and Verbauwhede, "Dude, is my code constant
// time?", DATE 2017, https://eprint.iacr.org/2016/1123): a primitive runs on
// two classes of secret input, one fixed value and fresh random values, and
// the class of each run is drawn at random, so drift and noise fall on both
// classes alike. When the time does not depend on the secret, Welch's t
// between the two classes' timings stays under 10, dudect's threshold for a
// leak, over all runs and under each crop of the slow tail. Every input is
// made before the clock starts, and each run reads its own copy, so both
// classes find memory in the same state.

/// xorshift64 (Marsaglia 2003) picks the classes and makes the random inputs:
/// they must not correlate with the timings, and need not be unpredictable.
CtRand: struct {
    s: U64
}

#Arithmetic(.Wrapping)
ct_next: fn(r: &CtRand) -> U64 Never! {
    x := r.s.copy()
    x = x.bit_xor(x << 13)
    x = x.bit_xor(x >> 7)
    x = x.bit_xor(x << 17)
    r.s = x.copy()
    x
}

ct_bytes: fn(r: &CtRand, n: Int) -> [U8] Never! {
    out := [U8]{}
    loop _ in 0..<n -> out.push(U8{ct_next(r).bit_and(U64{255})})
    out
}

ct_abs: fn(x: Float) -> Float Never! { if x < (Float{0}) -> Float{0} - x else -> x }

/// Welch's t between the random class's and the fixed class's timings, over
/// the runs that took at most `limit` nanoseconds.
ct_welch: fn(times: [Int], random: [Bool], limit: Int) -> Float Never! {
    n := [Int]{0, 0}
    sum := [Float]{Float{0}, Float{0}}
    loop i in 0..<times.len() {
        if times[i] > limit -> next
        c: if random[i] -> 1 else -> 0
        n[c] = n[c] + 1
        sum[c] = sum[c] + Float{times[i]}
    }
    if n[0] < 2 || n[1] < 2 -> return Float{0}
    mean: [Float]{sum[0] / Float{n[0]}, sum[1] / Float{n[1]}}
    sq := [Float]{Float{0}, Float{0}}
    loop i in 0..<times.len() {
        if times[i] > limit -> next
        c: if random[i] -> 1 else -> 0
        d: Float{times[i]} - mean[c]
        sq[c] = sq[c] + d * d
    }
    spread: sq[0] / Float{n[0] - 1} / Float{n[0]} + sq[1] / Float{n[1] - 1} / Float{n[1]}
    if spread <= (Float{0}) -> return Float{0}
    (mean[1] - mean[0]) / core.math.sqrt(spread)
}

/// Times `samples` runs of `batch` calls of `op`, each run on a copy of
/// `fixed` or on random bytes of its length, picked at random, and returns the
/// t of largest size over all runs and the 50th, 75th, 90th, 95th and 99th
/// percentile crops.
ct_measure: fn(what: String, samples: Int, batch: Int, fixed: [U8], op: fn([U8]) -> Int) -[Time, IO]> Float {
    r := CtRand{s: U64{88172645463325252}}
    inputs := [[U8]]{}
    random := [Bool]{}
    loop _ in 0..<samples {
        pick: ct_next(r).bit_and(U64{1}) == U64{1}
        random.push(pick)
        if pick {
            inputs.push(ct_bytes(r, fixed.len()))
        } else {
            inputs.push(fixed.copy())
        }
    }
    sink := 0
    loop i in 0..<32 -> sink = sink.bit_xor(op(inputs[i %% samples]))
    times := [Int]{}
    loop i in 0..<samples {
        x: inputs[i]
        watch: core.time.start()
        loop _ in 0..<batch -> sink = sink.bit_xor(op(x))
        times.push(core.time.elapsed(watch).ns)
    }
    sorted := times.copy()
    sorted.sort()
    worst := ct_welch(times, random, sorted[samples - 1])
    loop pct in ([Int]{50, 75, 90, 95, 99}) {
        t: ct_welch(times, random, sorted[((samples - 1) * pct) /% 100])
        if ct_abs(t) > ct_abs(worst) -> worst = t
    }
    print("dudect {what}: t {worst} over {samples} runs of {batch} (median run {sorted[samples /% 2]} ns, result {sink})")
    worst
}

/// `ct_measure`, failing when the t reaches 10 in size.
ct_dudect: fn(what: String, samples: Int, batch: Int, fixed: [U8], op: fn([U8]) -> Int) -[Time, IO]> Float {
    t: ct_measure(what, samples, batch, fixed, op)
    if ct_abs(t) >= (Float{10}) -> panic("{what}: Welch's t is {t} between fixed and random secrets over {samples} runs; dudect's leak threshold is 10")
    t
}

/// `bytes` with the last byte's low bit flipped: a tag that differs from
/// `bytes` at the end only, where a random one differs at the start.
ct_last_flipped: fn(bytes: [U8]) -> [U8] Never! {
    out := bytes.copy()
    out[out.len() - 1] = out[out.len() - 1].bit_xor(U8{1})
    out
}

ct_take: fn(bytes: [U8], from: Int, count: Int) -> [U8] Never! {
    out := [U8]{}
    loop i in from..<from + count -> out.push(bytes[i])
    out
}

/// The length of an opened message; 0 for a refused one.
ct_opened: fn(got: [U8]?) -> Int Never! {
    g: got ?? return 0
    g.len()
}

/// A comparison that stops at the first differing byte: the leak the
/// harness must find.
ct_early_exit: fn(a: [U8], b: [U8]) -> Int Never! {
    loop i in 0..<a.len() {
        if a[i] != b[i] -> return i + 1
    }
    0
}

#Test("dudect finds the leak in a comparison that stops at the first differing byte") {
    r := CtRand{s: U64{3}}
    mac: ct_bytes(r, 32)
    t: ct_measure("early-exit compare (the leak dudect must find)", 20000, 64, ct_last_flipped(mac), (x) -> ct_early_exit(mac, x))
    if ct_abs(t) < (Float{10}) -> panic("dudect missed an early-exit compare: t {t}")
}

#Test("dudect: ctime.memcmp and core.crypto.constant_time_equal_bytes take as long wherever two tags differ") {
    r := CtRand{s: U64{5}}
    mac: ct_bytes(r, 32)
    fixed: ct_last_flipped(mac)
    other: mac.copy()
    ct_dudect("ctime.memcmp", 20000, 64, fixed, (x) -> ctime.memcmp(mac, 0, x, 0, 32))
    ct_dudect("core.crypto.constant_time_equal_bytes", 20000, 64, fixed, (x) -> if core.crypto.constant_time_equal_bytes(other, x) -> 1 else -> 0)
}

ct_aes: fn(key: [U8], block: [U8]) -> Int Never! {
    k: cipher.aes_key(key, false) ?? return 0
    out := ct_take(block, 0, 16)
    cipher.encrypt_block(k, block, 0, out, 0)
    Int.from_u8(out[0])
}

#Test("dudect: AES key expansion and block encryption take as long on fixed and random keys") {
    r := CtRand{s: U64{7}}
    block: ct_bytes(r, 16)
    other: block.copy()
    ct_dudect("AES-128 key and block", 5000, 4, ct_bytes(r, 16), (x) -> ct_aes(x, block))
    ct_dudect("AES-256 key and block", 5000, 4, ct_bytes(r, 32), (x) -> ct_aes(x, other))
}

#Test("dudect: AES-GCM and ChaCha20-Poly1305 refuse a forged tag in the same time wherever it differs") {
    r := CtRand{s: U64{11}}
    key: ct_bytes(r, 32)
    iv: ct_bytes(r, 12)
    aad: ct_bytes(r, 13)
    plain: ct_bytes(r, 64)
    gcm: vec_gcm_seal(key, iv, aad, plain) ?? panic("GCM seal failed")
    chacha: vec_chacha_seal(key, iv, aad, plain) ?? panic("ChaCha20-Poly1305 seal failed")
    gcm_body: ct_take(gcm, 0, 64)
    chacha_body: ct_take(chacha, 0, 64)
    k2: key.copy()
    iv2: iv.copy()
    aad2: aad.copy()
    ct_dudect("AES-256-GCM open", 4000, 2, ct_last_flipped(ct_take(gcm, 64, 16)), (x) -> ct_opened(vec_gcm_open(key, iv, aad, vec_concat(gcm_body, x))))
    ct_dudect("ChaCha20-Poly1305 open", 4000, 2, ct_last_flipped(ct_take(chacha, 64, 16)), (x) -> ct_opened(vec_chacha_open(k2, iv2, aad2, vec_concat(chacha_body, x))))
}

#Test("dudect: HMAC-SHA-256 and HMAC-SHA-384 take as long on fixed and random keys") {
    r := CtRand{s: U64{13}}
    data: ct_bytes(r, 64)
    other: data.copy()
    ct_dudect("HMAC-SHA-256", 4000, 4, ct_bytes(r, 32), (x) -> Int.from_u8(hashes.hmac(hashes.Md.SHA256, x, data)[0]))
    ct_dudect("HMAC-SHA-384", 4000, 4, ct_bytes(r, 48), (x) -> Int.from_u8(hashes.hmac(hashes.Md.SHA384, x, other)[0]))
}

/// A private key for curve `id` from `bytes`: the top bit cleared, so it is
/// below the group order, and the low bit set, so it is not zero.
ct_scalar: fn(bytes: [U8]) -> [U8] Never! {
    out := bytes.copy()
    out[0] = out[0].bit_and(U8{0x7f})
    out[out.len() - 1] = out[out.len() - 1].bit_or(U8{1})
    out
}

/// The uncompressed generator of curve `id`, the peer point of the ECDH runs.
ct_generator: fn(id: ecp.GroupID, size: Int) -> [U8] {
    grp: ecp.group_load(id) ?? panic("no group {id}")
    ecp.point_write_binary(grp, grp.g, .Uncompressed, 1 + 2 * size) ?? panic("no generator for {id}")
}

#Test("dudect: X25519, P-256 and P-384 ECDH take as long on fixed and random private keys") {
    r := CtRand{s: U64{17}}
    base := [U8]{9}
    loop _ in 1..<32 -> base.push(U8{0})
    ct_dudect("X25519 ECDH", 600, 1, ct_bytes(r, 32), (x) -> ct_opened(vec_ecdh(.Curve25519, x, base)))
    p256: ct_generator(.Secp256r1, 32)
    ct_dudect("P-256 ECDH", 400, 1, ct_scalar(ct_bytes(r, 32)), (x) -> ct_opened(vec_ecdh(.Secp256r1, ct_scalar(x), p256)))
    p384: ct_generator(.Secp384r1, 48)
    ct_dudect("P-384 ECDH", 200, 1, ct_scalar(ct_bytes(r, 48)), (x) -> ct_opened(vec_ecdh(.Secp384r1, ct_scalar(x), p384)))
}

ct_ecdsa_sign: fn(id: ecp.GroupID, key: [U8], hash: [U8]) -> Int {
    grp: ecp.group_load(id) ?? return 0
    d: bn.read_binary(ct_scalar(key)) ?? return 0
    rng := vec_rng()
    sig: ecdsa.ecdsa_sign(grp, d, hash, rng) ?? return 0
    ct_opened(Val(bn.write_binary(sig.s, key.len()) ?? return 0))
}

#Test("dudect: ECDSA signing on P-256 and P-384 takes as long on fixed and random private keys") {
    r := CtRand{s: U64{19}}
    h256: ct_bytes(r, 32)
    ct_dudect("P-256 ECDSA sign", 400, 1, ct_bytes(r, 32), (x) -> ct_ecdsa_sign(.Secp256r1, x, h256))
    h384: ct_bytes(r, 48)
    ct_dudect("P-384 ECDSA sign", 200, 1, ct_bytes(r, 48), (x) -> ct_ecdsa_sign(.Secp384r1, x, h384))
}

ct_rsa_sign: fn(der: [U8], hash: [U8]) -> Int {
    rng := vec_rng()
    ctx := pkparse.pk_parse_key(der, None, rng) ?? return 0
    sig: pk.pk_sign(ctx, Val(hashes.Md.SHA256), hash, 1024, rng) ?? return 0
    sig.len()
}

#Test("dudect: RSA-2048 PKCS#1 v1.5 signing takes as long on fixed and random hashes") {
    groups: vec_items(vec_wycheproof("rsa_pkcs1_2048_sig_gen"), "testGroups")
    der: vec_wy_hex(groups[0], "privateKeyPkcs8")
    r := CtRand{s: U64{23}}
    ct_dudect("RSA-2048 sign", 200, 1, ct_bytes(r, 32), (x) -> ct_rsa_sign(der, x))
}

/// `bytes` as base64 text, one digit per byte.
ct_base64_text: fn(bytes: [U8]) -> [U8] Never! {
    digits: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".bytes()
    out := [U8]{}
    loop b in bytes -> out.push(digits[Int.from_u8(b.bit_and(U8{63}))])
    out
}

ct_base64_decoded: fn(bytes: [U8]) -> Int Never! {
    out: pem.base64_decode(ct_base64_text(bytes)) ?? return 0
    out.len()
}

#Test("dudect: PEM's base64 decoding of key text takes as long on fixed and random digits") {
    r := CtRand{s: U64{29}}
    ct_dudect("PEM base64 decode", 5000, 8, ct_bytes(r, 64), (x) -> ct_base64_decoded(x))
}

#Unsafe("`seed` is a timing run's test key, used for that run only") vec_expert_ed25519_sign: fn(seed: [U8], msg: [U8]) -> Int {
    n := 0
    #Unsafe("a timing run's test key, used for that run only") {
        sig: core.crypto.expert.ed25519_sign(seed, msg) ?? return 0
        n = sig.bytes.len()
    }
    n
}

#Test("dudect: core.crypto.expert's X25519, Ed25519 signing and AEAD tag checks take as long on fixed and random secrets") {
    r := CtRand{s: U64{31}}
    base := [U8]{9}
    loop _ in 1..<32 -> base.push(U8{0})
    msg: ct_bytes(r, 64)
    key: ct_bytes(r, 32)
    iv: ct_bytes(r, 12)
    xiv: ct_bytes(r, 24)
    aad: ct_bytes(r, 13)
    #Unsafe("timing runs on test keys and nonces, each used for its run only") {
        gcm: vec_expert_gcm_seal(key, iv, aad, msg) ?? panic("expert GCM seal failed")
        xchacha: vec_expert_xchacha_seal(key, xiv, aad, msg) ?? panic("expert XChaCha20-Poly1305 seal failed")
        gcm_body: ct_take(gcm, 0, 64)
        xchacha_body: ct_take(xchacha, 0, 64)
        k2: key.copy()
        aad2: aad.copy()
        ct_dudect("expert X25519", 600, 1, ct_bytes(r, 32), (x) -> ct_opened(vec_expert_x25519(x, base)))
        ct_dudect("expert Ed25519 sign", 400, 1, ct_bytes(r, 32), (x) -> vec_expert_ed25519_sign(x, msg))
        ct_dudect("expert AES-256-GCM open", 4000, 2, ct_last_flipped(ct_take(gcm, 64, 16)), (x) -> ct_opened(vec_expert_gcm_open(key, iv, aad, vec_concat(gcm_body, x))))
        ct_dudect("expert XChaCha20-Poly1305 open", 4000, 2, ct_last_flipped(ct_take(xchacha, 64, 16)), (x) -> ct_opened(vec_expert_xchacha_open(k2, xiv, aad2, vec_concat(xchacha_body, x))))
    }
}

// ---------------------------------------------------------------------------
// Constant time: the emission check's entry
// ---------------------------------------------------------------------------

/// The RSA-1024 key of the mbedtls rsa.c self-test (RSA.jet), completed.
ct_rsa_key: fn() -> rsa.RSAContext {
    ctx := rsa.rsa_new()
    n: bn.read_string(16, "9292758453063D803DD603D5E777D7888ED1D5BF35786190FA2F23EBC0848AEADDA92CA6C3D80B32C4D109BE0F36D6AE7130B9CED7ACDF54CFC7555AC14EEBAB93A89813FBF3C4F8066D2D800F7C38A81AE31942917403FF4946B0A83D3D3E05EE57C6F5F5606FB5D4BC6CD34EE0801A5E94BB77B07507233A0BC7BAC8F90F79") ?? panic("N")
    p: bn.read_string(16, "C36D0EB7FCD285223CFB5AABA5BDA3D82C01CAD19EA484A87EA4377637E75500FCB2005C5C7DD6EC4AC023CDA285D796C3D9E75E1EFC42488BB4F1D13AC30A57") ?? panic("P")
    q: bn.read_string(16, "C000DF51A7C77AE8D7C7370C1FF55B69E211C2B9E5DB1ED0BF61D0D9899620F4910E4168387E3C30AA1E00C339A795088452DD96A9A5EA5D9DCA68DA636032AF") ?? panic("Q")
    d: bn.read_string(16, "24BF6185468786FDD303083D25E64EFC66CA472BC44D253102F8B4A9D3BFA75091386C0077937FE33FA3252D28855837AE1B484A8A9A45F7EE8C0C634F99E8CDDF79C5CE07EE72C7F123142198164234CABB724CF78B8173B9F880FC86322407AF1FEDFDDE2BEB674CA15F3E81A1521E071513A1E85B5DFA031F21ECAE91A34D") ?? panic("D")
    e: bn.read_string(16, "10001") ?? panic("E")
    rsa.rsa_import(ctx, .N, n) ?? panic("import N")
    rsa.rsa_import(ctx, .P, p) ?? panic("import P")
    rsa.rsa_import(ctx, .Q, q) ?? panic("import Q")
    rsa.rsa_import(ctx, .D, d) ?? panic("import D")
    rsa.rsa_import(ctx, .E, e) ?? panic("import E")
    rsa.rsa_complete(ctx) ?? panic("complete")
    ctx
}

// Each primitive of the dudect tests above runs once here, so a build of this
// test alone selects every secret-dependent primitive; the case
// tests/cases/core_net_tls/constant_time_primitives_emit_no_secret_branch_or_index.case
// reads their emission log (JET_X64_EMIT_LOG) at O0, O1 and O2. The secrets
// are ct_entry's parameters, which a build at O1 and O2 keeps where it drops
// a test's locals.
#Test("The secret-dependent primitives each run once on test secrets (the emission check's entry)") {
    r := CtRand{s: U64{37}}
    ctx := ct_rsa_key()
    rng := vec_rng()
    #Unsafe("test keys and nonces, each used for this run only") {
        ct_entry(r, ctx, rng)
    }
}

#Unsafe("`r` draws test keys and nonces, each used for this run only") ct_entry: fn(r: &CtRand, ctx: &rsa.RSAContext, rng: &drbg.HMACDrbg) {
    mac: ct_bytes(r, 32)
    flipped: ct_last_flipped(mac)
    assert(ctime.memcmp(mac, 0, flipped, 0, 32) != 0)
    assert(!core.crypto.constant_time_equal_bytes(mac, flipped))
    block: ct_bytes(r, 16)
    assert(ct_aes(ct_bytes(r, 16), block) >= 0)
    assert(ct_aes(ct_bytes(r, 32), block) >= 0)
    key: ct_bytes(r, 32)
    iv: ct_bytes(r, 12)
    xiv: ct_bytes(r, 24)
    aad: ct_bytes(r, 13)
    plain: ct_bytes(r, 64)
    gcm: vec_gcm_seal(key, iv, aad, plain) ?? panic("GCM seal failed")
    assert_eq(ct_opened(vec_gcm_open(key, iv, aad, gcm)), 64)
    chacha: vec_chacha_seal(key, iv, aad, plain) ?? panic("ChaCha20-Poly1305 seal failed")
    assert_eq(ct_opened(vec_chacha_open(key, iv, aad, chacha)), 64)
    assert_eq(hashes.hmac(hashes.Md.SHA256, key, plain).len(), 32)
    assert_eq(hashes.hmac(hashes.Md.SHA384, ct_bytes(r, 48), plain).len(), 48)
    base := [U8]{9}
    loop _ in 1..<32 -> base.push(U8{0})
    assert_eq(ct_opened(vec_ecdh(.Curve25519, ct_bytes(r, 32), base)), 32)
    assert_eq(ct_opened(vec_ecdh(.Secp256r1, ct_scalar(ct_bytes(r, 32)), ct_generator(.Secp256r1, 32))), 32)
    assert_eq(ct_opened(vec_ecdh(.Secp384r1, ct_scalar(ct_bytes(r, 48)), ct_generator(.Secp384r1, 48))), 48)
    assert(ct_ecdsa_sign(.Secp256r1, ct_bytes(r, 32), ct_bytes(r, 32)) > 0)
    assert(ct_ecdsa_sign(.Secp384r1, ct_bytes(r, 48), ct_bytes(r, 48)) > 0)
    sig: rsa.rsa_pkcs1_sign(ctx, rng, Val(hashes.Md.SHA256), ct_bytes(r, 32)) ?? panic("RSA sign failed")
    assert_eq(sig.len(), 128)
    assert_eq(ct_base64_decoded(ct_bytes(r, 64)), 48)
    #Unsafe("test keys and nonces, each used for this run only") {
        assert_eq(ct_opened(vec_expert_x25519(ct_bytes(r, 32), base)), 32)
        assert_eq(vec_expert_ed25519_sign(ct_bytes(r, 32), plain), 64)
        sealed: vec_expert_gcm_seal(key, iv, aad, plain) ?? panic("expert GCM seal failed")
        assert_eq(ct_opened(vec_expert_gcm_open(key, iv, aad, sealed)), 64)
        xsealed: vec_expert_xchacha_seal(key, xiv, aad, plain) ?? panic("expert XChaCha20-Poly1305 seal failed")
        assert_eq(ct_opened(vec_expert_xchacha_open(key, xiv, aad, xsealed)), 64)
    }
    // The paths the tests below time: the bitsliced AES and the portable
    // GHASH, HKDF and the TLS 1.3 key schedule, the TLS 1.2 PRF (extended
    // master secret and Finished) and HMAC_DRBG.
    assert_eq(ct_aes_portable(ct_bytes(r, 32), ct_bytes(r, 64)).len(), 64)
    assert_eq(ct_ghash_portable(ct_bytes(r, 16), ct_bytes(r, 64)).len(), 16)
    assert_eq(ct_opened(hashes.hkdf(.SHA256, ct_bytes(r, 32), ct_bytes(r, 32), ct_bytes(r, 16), 32)), 32)
    assert_eq(ct_opened(hashes.hkdf(.SHA384, ct_bytes(r, 48), ct_bytes(r, 48), ct_bytes(r, 16), 48)), 48)
    assert_eq(ct_tls13_schedule(ct_bytes(r, 32), ct_bytes(r, 32), ct_bytes(r, 32)).len(), 16)
    assert_eq(ssl_tls_prf_generic(.SHA256, ct_bytes(r, 48), "extended master secret".bytes(), ct_bytes(r, 32), 48).len(), 48)
    assert_eq(ssl_tls_prf_generic(.SHA384, ct_bytes(r, 48), "client finished".bytes(), ct_bytes(r, 48), 12).len(), 12)
    assert_eq(ct_drbg(ct_bytes(r, 48)).len(), 32)
}

// ---------------------------------------------------------------------------
// Constant time: dudect timing of the paths the emission check does not enter
// ---------------------------------------------------------------------------
//
// The tests below time the secret inputs the tests above hold fixed (the
// ECDSA nonce, the ECDH peer point, the RSA key), the bitsliced AES and the
// portable GHASH that a host with AES-NI and PCLMULQDQ never runs, and what
// TLS builds on the primitives: AEAD key set-up and sealing, HKDF and the
// TLS 1.3 key schedule, the TLS 1.2 PRF and Finished, HMAC_DRBG, the record
// layer's ssl_decrypt_buf, and Bignum's exp_mod and gcd_modinv_odd. ct_entry
// above also enters all of these but the record layer, whose generic cipher
// layer the emission check cannot judge yet (its context's cipher choice and
// list words read as secret, and the choice reaches every cipher).

/// ECDSA signing with a fixed key whose nonce generator is seeded from
/// `seed`, so the nonce k is the secret that varies.
ct_ecdsa_nonce: fn(id: ecp.GroupID, key: [U8], hash: [U8], seed: [U8]) -> Int {
    grp: ecp.group_load(id) ?? return 0
    d: bn.read_binary(ct_scalar(key)) ?? return 0
    nonces := drbg.hmac_drbg_new(.SHA256)
    drbg.hmac_drbg_seed_buf(nonces, seed)
    blind := vec_rng()
    sig: ecdsa.ecdsa_sign_blinded(grp, d, hash, nonces, blind) ?? return 0
    ct_opened(Val(bn.write_binary(sig.s, key.len()) ?? return 0))
}

#Test("dudect: ECDSA signing on P-256 and P-384 takes as long on fixed and random nonces") {
    r := CtRand{s: U64{43}}
    key256: ct_bytes(r, 32)
    h256: ct_bytes(r, 32)
    assert_eq(ct_ecdsa_nonce(.Secp256r1, key256, h256, ct_bytes(r, 32)), 32)
    ct_dudect("P-256 ECDSA sign, nonce", 400, 1, ct_bytes(r, 32), (x) -> ct_ecdsa_nonce(.Secp256r1, key256, h256, x))
    key384: ct_bytes(r, 48)
    h384: ct_bytes(r, 48)
    assert_eq(ct_ecdsa_nonce(.Secp384r1, key384, h384, ct_bytes(r, 32)), 48)
    ct_dudect("P-384 ECDSA sign, nonce", 200, 1, ct_bytes(r, 32), (x) -> ct_ecdsa_nonce(.Secp384r1, key384, h384, x))
}

/// `count` uncompressed points of curve `id`, each the public key of a fresh
/// private key: the peer points of the variable-base ECDH runs.
ct_points: fn(id: ecp.GroupID, size: Int, count: Int) -> [[U8]] {
    rng := vec_rng()
    out := [[U8]]{}
    loop _ in 0..<count {
        pair: ecp.gen_key(id, rng) ?? panic("gen_key {id}: {err}")
        out.push(ecp.point_write_binary(pair.grp, pair.q, .Uncompressed, 1 + 2 * size) ?? panic("point {id}: {err}"))
    }
    out
}

#Test("dudect: X25519, P-256 and P-384 ECDH take as long on fixed and random peer points") {
    r := CtRand{s: U64{47}}
    x25519_key: ct_bytes(r, 32)
    assert_eq(ct_opened(vec_ecdh(.Curve25519, x25519_key, ct_bytes(r, 32))), 32)
    ct_dudect("X25519 ECDH, peer point", 600, 1, ct_bytes(r, 32), (x) -> ct_opened(vec_ecdh(.Curve25519, x25519_key, x)))
    // A one-byte input picks the peer point: the fixed class always gets
    // the same one, the random class any of 32.
    p256: ct_points(.Secp256r1, 32, 32)
    p256_key: ct_scalar(ct_bytes(r, 32))
    loop p in p256 -> assert_eq(ct_opened(vec_ecdh(.Secp256r1, p256_key, p)), 32)
    ct_dudect("P-256 ECDH, peer point", 400, 1, ct_bytes(r, 1), (x) -> ct_opened(vec_ecdh(.Secp256r1, p256_key, p256[Int.from_u8(x[0]) %% 32])))
    p384: ct_points(.Secp384r1, 48, 32)
    p384_key: ct_scalar(ct_bytes(r, 48))
    loop p in p384 -> assert_eq(ct_opened(vec_ecdh(.Secp384r1, p384_key, p)), 48)
    ct_dudect("P-384 ECDH, peer point", 200, 1, ct_bytes(r, 1), (x) -> ct_opened(vec_ecdh(.Secp384r1, p384_key, p384[Int.from_u8(x[0]) %% 32])))
}

ct_rsa_pss_sign: fn(der: [U8], hash: [U8]) -> Int {
    rng := vec_rng()
    ctx := pkparse.pk_parse_key(der, None, rng) ?? return 0
    sig: pk.pk_sign_ext(.RSASSAPSS, ctx, Val(hashes.Md.SHA256), hash, 1024, rng) ?? return 0
    sig.len()
}

/// The private keys of the Wycheproof RSA-2048 PKCS#1 signing groups that
/// share one shape: two 1024-bit primes and e = 65537, five keys. The other
/// three groups have e = 3 and primes of about 1365 and 683 bits. A key's
/// shape sets its signing time (the CRT halves run at the primes' sizes, the
/// fault check at e's), so the key tests vary the secret values at one shape.
ct_rsa_keys: fn() -[FS, Env, Net, Time.Wait]> [[U8]] {
    out := [[U8]]{}
    loop g in vec_items(vec_wycheproof("rsa_pkcs1_2048_sig_gen"), "testGroups") {
        der: vec_wy_hex(g, "privateKeyPkcs8")
        ctx := pkparse.pk_parse_key(der, None, vec_rng()) ?? panic("an RSA-2048 test key parses")
        e: rsa.rsa_export(ctx.rsa, .E) ?? panic("E")
        p: rsa.rsa_export(ctx.rsa, .P) ?? panic("P")
        q: rsa.rsa_export(ctx.rsa, .Q) ?? panic("Q")
        if bn.bitlen(p) == 1024 && bn.bitlen(q) == 1024 && bn.cmp_int(e, 65537) == 0 -> out.push(der)
    }
    out
}

#Test("dudect: RSA-2048 PKCS#1 v1.5 and PSS signing take as long on fixed and random keys, and PSS on fixed and random hashes") {
    keys: ct_rsa_keys()
    assert_eq(keys.len(), 5)
    pss_keys: keys.copy()
    pss_hash_keys: keys.copy()
    r := CtRand{s: U64{53}}
    // A one-byte input picks the key: the fixed class always gets the same
    // one, the random class any of the five.
    hash: ct_bytes(r, 32)
    pss_hash: hash.copy()
    loop k in keys {
        assert_eq(ct_rsa_sign(k, hash), 256)
        assert_eq(ct_rsa_pss_sign(k, hash), 256)
    }
    ct_dudect("RSA-2048 sign, key", 200, 1, ct_bytes(r, 1), (x) -> ct_rsa_sign(keys[Int.from_u8(x[0]) %% keys.len()], hash))
    ct_dudect("RSA-2048 PSS sign, key", 200, 1, ct_bytes(r, 1), (x) -> ct_rsa_pss_sign(pss_keys[Int.from_u8(x[0]) %% pss_keys.len()], pss_hash))
    ct_dudect("RSA-2048 PSS sign, hash", 200, 1, ct_bytes(r, 32), (x) -> ct_rsa_pss_sign(pss_hash_keys[0], x))
}

/// Whole blocks of `blocks` through the bitsliced AES rounds alone, which
/// run wherever the host leaf does not.
ct_aes_portable: fn(key: [U8], blocks: [U8]) -> [U8] Never! {
    k: cipher.aes_key(key, false) ?? return [U8]{}
    iv := cipher.zero_bytes(16)
    out := [U8]{}
    cipher.blocks_portable(k, cipher.ECB_ENC, iv, blocks, 0, blocks.len() /% 16, out)
    out
}

/// GHASH of `data` on the Jet carry-less multiply alone, under the hash
/// subkey of the AES key `key`.
ct_ghash_portable: fn(key: [U8], data: [U8]) -> [U8] Never! {
    k: aead.gcm_key(cipher.aes_key(key, false) ?? return [U8]{})
    y := cipher.zero_bytes(16)
    aead.ghash_portable(k.g, y, data, 0, data.len() /% 16)
    y
}

#Test("dudect: the bitsliced AES and the portable GHASH take as long on fixed and random keys and data") {
    // FIPS-197 C.3's AES-256 block, and the GHASH of GCM test case 2 (the
    // zero key's ciphertext block, then its length block).
    assert_eq(ct_aes_portable(vec_hex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"), vec_hex("00112233445566778899aabbccddeeff")), vec_hex("8ea2b7ca516745bfeafc49904b496089"))
    assert_eq(ct_ghash_portable(cipher.zero_bytes(16), vec_hex("0388dace60b6a392f328c2b971b2fe7800000000000000000000000000000080")), vec_hex("f38cbb1ad69223dcc3457ae5b6b0f885"))
    r := CtRand{s: U64{67}}
    blocks: ct_bytes(r, 64)
    aes_key: ct_bytes(r, 32)
    ghash_data: ct_bytes(r, 64)
    ghash_key: ct_bytes(r, 16)
    ct_dudect("bitsliced AES-256, key", 3000, 2, ct_bytes(r, 32), (x) -> Int.from_u8(ct_aes_portable(x, blocks)[0]))
    ct_dudect("bitsliced AES-256, data", 3000, 2, ct_bytes(r, 64), (x) -> Int.from_u8(ct_aes_portable(aes_key, x)[0]))
    ct_dudect("portable GHASH, key", 3000, 2, ct_bytes(r, 16), (x) -> Int.from_u8(ct_ghash_portable(x, ghash_data)[0]))
    ct_dudect("portable GHASH, data", 3000, 2, ct_bytes(r, 64), (x) -> Int.from_u8(ct_ghash_portable(ghash_key, x)[0]))
}

#Test("dudect: AES-GCM and ChaCha20-Poly1305 key set-up and sealing take as long on fixed and random keys and plaintexts") {
    r := CtRand{s: U64{71}}
    iv: ct_bytes(r, 12)
    aad: ct_bytes(r, 13)
    plain: ct_bytes(r, 64)
    key: ct_bytes(r, 32)
    iv2: iv.copy()
    aad2: aad.copy()
    plain2: plain.copy()
    iv3: iv.copy()
    aad3: aad.copy()
    iv4: iv.copy()
    aad4: aad.copy()
    key4: key.copy()
    gcm: vec_gcm_seal(key, iv, aad, plain) ?? panic("GCM seal failed")
    assert_eq(ct_opened(vec_gcm_open(key, iv, aad, gcm)), 64)
    chacha: vec_chacha_seal(key, iv, aad, plain) ?? panic("ChaCha20-Poly1305 seal failed")
    assert_eq(ct_opened(vec_chacha_open(key, iv, aad, chacha)), 64)
    ct_dudect("AES-256-GCM key and seal", 3000, 2, ct_bytes(r, 32), (x) -> ct_opened(vec_gcm_seal(x, iv, aad, plain)))
    ct_dudect("ChaCha20-Poly1305 key and seal", 3000, 2, ct_bytes(r, 32), (x) -> ct_opened(vec_chacha_seal(x, iv2, aad2, plain2)))
    ct_dudect("AES-256-GCM seal, plaintext", 3000, 2, ct_bytes(r, 64), (x) -> ct_opened(vec_gcm_seal(key, iv3, aad3, x)))
    ct_dudect("ChaCha20-Poly1305 seal, plaintext", 3000, 2, ct_bytes(r, 64), (x) -> ct_opened(vec_chacha_seal(key4, iv4, aad4, x)))
}

/// The TLS 1.3 key schedule from an early secret to a handshake traffic key:
/// the handshake secret over a fixed (EC)DHE secret, the client handshake
/// traffic secret and its AES-128 key (RFC 8446 7.1 and 7.3).
ct_tls13_schedule: fn(early: [U8], shared: [U8], transcript: [U8]) -> [U8] {
    handshake: keys13.ssl_tls13_evolve_secret(.SHA256, Val(early.copy()), shared) ?? return [U8]{}
    traffic: keys13.ssl_tls13_derive_secret(.SHA256, handshake, "c hs traffic".bytes(), transcript, keys13.SSL_TLS1_3_CONTEXT_HASHED, 32) ?? return [U8]{}
    keys13.ssl_tls13_hkdf_expand_label(.SHA256, traffic, "key".bytes(), [U8]{}, 16) ?? [U8]{}
}

#Test("dudect: HKDF, the TLS 1.3 key schedule and the TLS 1.2 PRF and Finished take as long on fixed and random secrets") {
    // RFC 8448 3's client handshake key: from the early secret, the ECDHE
    // secret and the ClientHello..ServerHello transcript hash.
    early: vec_hex("33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a")
    ecdhe: vec_hex("8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d")
    hello: vec_hex("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8")
    assert_eq(ct_tls13_schedule(early, ecdhe, hello), vec_hex("dbfaa693d1762c5b666af5d950258d01"))
    r := CtRand{s: U64{73}}
    salt: ct_bytes(r, 32)
    info: ct_bytes(r, 16)
    salt2: salt.copy()
    info2: info.copy()
    shared: ct_bytes(r, 32)
    transcript: ct_bytes(r, 32)
    session_hash: ct_bytes(r, 32)
    finished_hash: ct_bytes(r, 48)
    assert_eq(ct_opened(hashes.hkdf(.SHA256, salt, shared, info, 32)), 32)
    assert_eq(ct_opened(hashes.hkdf(.SHA384, salt, finished_hash, info, 48)), 48)
    assert_eq(ssl_tls_prf_generic(.SHA256, shared, "extended master secret".bytes(), session_hash, 48).len(), 48)
    ct_dudect("HKDF-SHA-256", 3000, 2, ct_bytes(r, 32), (x) -> ct_opened(hashes.hkdf(.SHA256, salt, x, info, 32)))
    ct_dudect("HKDF-SHA-384", 3000, 2, ct_bytes(r, 48), (x) -> ct_opened(hashes.hkdf(.SHA384, salt2, x, info2, 48)))
    ct_dudect("TLS 1.3 key schedule", 2000, 1, ct_bytes(r, 32), (x) -> Int.from_u8(ct_tls13_schedule(x, shared, transcript)[0]))
    ct_dudect("TLS 1.2 PRF, extended master secret", 2000, 1, ct_bytes(r, 32), (x) -> Int.from_u8(ssl_tls_prf_generic(.SHA256, x, "extended master secret".bytes(), session_hash, 48)[0]))
    ct_dudect("TLS 1.2 PRF, Finished", 2000, 1, ct_bytes(r, 48), (x) -> Int.from_u8(ssl_tls_prf_generic(.SHA384, x, "client finished".bytes(), finished_hash, 12)[0]))
}

/// HMAC_DRBG seeded with `seed`, and the 32 bytes it generates first.
ct_drbg: fn(seed: [U8]) -> [U8] {
    g := drbg.hmac_drbg_new(.SHA256)
    drbg.hmac_drbg_seed_buf(g, seed)
    none := ecp.NoRNG{}
    drbg.hmac_drbg_random(g, none, 32) ?? [U8]{}
}

#Test("dudect: HMAC_DRBG seeding and generation take as long on fixed and random seeds") {
    r := CtRand{s: U64{79}}
    assert_eq(ct_drbg(ct_bytes(r, 48)).len(), 32)
    ct_dudect("HMAC_DRBG-SHA-256", 3000, 2, ct_bytes(r, 48), (x) -> Int.from_u8(ct_drbg(x)[0]))
}

/// A TLS 1.3 record layer under fixed AES-128-GCM traffic keys: transform 0
/// is the server's, which seals, and 1 the client's, which opens.
ct_record_layer: fn() -> ssldefs.SSLContext {
    ssl := ssldefs.SSLContext{}
    r := CtRand{s: U64{83}}
    keys: keys13.SSLKeySet{client_write_key: ct_bytes(r, 16), server_write_key: ct_bytes(r, 16), client_write_iv: ct_bytes(r, 12), server_write_iv: ct_bytes(r, 12), key_len: 16, iv_len: 12}
    server: ssldefs.ssl_transform_alloc(ssl)
    keys13.ssl_tls13_populate_transform(ssl, server, ssldefs.SSL_IS_SERVER, suites.TLS1_3_AES_128_GCM_SHA256, keys) ?? panic("server transform: {err}")
    client: ssldefs.ssl_transform_alloc(ssl)
    keys13.ssl_tls13_populate_transform(ssl, client, ssldefs.SSL_IS_CLIENT, suites.TLS1_3_AES_128_GCM_SHA256, keys) ?? panic("client transform: {err}")
    assert(server == 0 && client == 1)
    ssl
}

/// The first application-data record of `plain` the server seals: room for
/// the 5-byte header, then the ciphertext and its tag.
ct_record_seal: fn(ssl: &ssldefs.SSLContext, plain: [U8]) -> [U8] {
    buf := ssldefs.ssl_zeros(5 + plain.len() + 64)
    ssldefs.ssl_copy_into(buf, 5, plain, 0, plain.len())
    rec := ssldefs.SSLRecord{ctr: ssldefs.ssl_zeros(8), rtype: ssldefs.SSL_MSG_APPLICATION_DATA, ver: [U8]{3, 3}, buf_start: 5, buf_len: buf.len() - 5, data_offset: 0, data_len: plain.len(), cid_len: 0}
    rng := vec_rng()
    sslmsg.ssl_encrypt_buf(ssl.tpool[0], rec, buf, rng) ?? panic("seal: {err}")
    ssldefs.ssl_bytes_of(buf, 0, 5 + rec.data_len)
}

/// ssl_decrypt_buf on the client of `sealed` with its tag replaced by `tag`:
/// the plaintext length, or the error code.
ct_record_open: fn(sealed: [U8], tag: [U8]) -> Int {
    ssl := ct_record_layer()
    buf := sealed.copy()
    ssldefs.ssl_copy_into(buf, buf.len() - tag.len(), tag, 0, tag.len())
    rec := ssldefs.SSLRecord{ctr: ssldefs.ssl_zeros(8), rtype: ssldefs.SSL_MSG_APPLICATION_DATA, ver: [U8]{3, 3}, buf_start: 0, buf_len: buf.len(), data_offset: 5, data_len: buf.len() - 5, cid_len: 0}
    if sslmsg.ssl_decrypt_buf(ssl.tpool[1], rec, buf) == .Err(e) -> return ssldefs.ssl_error_code(e)
    rec.data_len
}

#Test("dudect: the TLS 1.3 record layer refuses a forged record tag in the same time wherever it differs") {
    r := CtRand{s: U64{89}}
    ssl := ct_record_layer()
    sealed: ct_record_seal(ssl, ct_bytes(r, 64))
    mac: ct_take(sealed, sealed.len() - 16, 16)
    assert_eq(ct_record_open(sealed, mac), 64)
    assert(ct_record_open(sealed, ct_last_flipped(mac)) < 0)
    ct_dudect("TLS 1.3 ssl_decrypt_buf", 3000, 1, ct_last_flipped(mac), (x) -> ct_record_open(sealed, x))
}

/// A TLS 1.2 TLS_RSA_WITH_AES_128_CBC_SHA256 record layer, MAC then
/// encrypt: transform 0 is the server's, which seals, and 1 the client's,
/// which opens.
ct_cbc_layer: fn() -> ssldefs.SSLContext {
    ssl := ssldefs.SSLContext{}
    r := CtRand{s: U64{97}}
    master: ct_bytes(r, 48)
    randbytes: ct_bytes(r, 64)
    server: ssldefs.ssl_transform_alloc(ssl)
    ssl_tls12_populate_transform(ssl, server, suites.TLS_RSA_WITH_AES_128_CBC_SHA256, master, ssldefs.SSL_ETM_DISABLED, .SHA256, randbytes, ssldefs.SSL_VERSION_TLS1_2, ssldefs.SSL_IS_SERVER) ?? panic("server transform: {err}")
    client: ssldefs.ssl_transform_alloc(ssl)
    ssl_tls12_populate_transform(ssl, client, suites.TLS_RSA_WITH_AES_128_CBC_SHA256, master, ssldefs.SSL_ETM_DISABLED, .SHA256, randbytes, ssldefs.SSL_VERSION_TLS1_2, ssldefs.SSL_IS_CLIENT) ?? panic("client transform: {err}")
    assert(server == 0 && client == 1)
    ssl
}

/// The first application-data record the server `t` sends of `plain`,
/// built by hand so its padding is `pad` + 1 bytes of `pad` (RFC 5246
/// 6.2.3.2), where ssl_encrypt_buf pads to the next block only: the 5-byte
/// header, the explicit IV `iv`, then AES-128-CBC of `plain`, its
/// HMAC-SHA-256 (with its first byte flipped unless `mac_ok`) and the
/// padding.
ct_cbc_record: fn(t: &ssldefs.SSLTransform, plain: [U8], pad: Int, iv: [U8], mac_ok: Bool) -> [U8] {
    rec: ssldefs.SSLRecord{ctr: ssldefs.ssl_zeros(8), rtype: ssldefs.SSL_MSG_APPLICATION_DATA, ver: [U8]{3, 3}, data_len: plain.len(), cid_len: 0}
    add_data: sslmsg.ssl_extract_add_data_from_record(rec, t.tls_version, t.taglen)
    body := plain.copy()
    ssldefs.ssl_push_all(body, sslmsg.ssl_mac_of(t.md_enc, add_data, plain, 0, plain.len()) ?? panic("no MAC key"))
    if !mac_ok -> body[plain.len()] = body[plain.len()].bit_xor(U8{1})
    loop _ in 0..pad -> body.push(ssldefs.ssl_byte(pad))
    assert(body.len() %% 16 == 0)
    enc := [U8]{}
    if &t.cipher_enc == {
        .Val(c) -> enc = layer.cipher_crypt(c, iv, body) ?? panic("encrypt: {err}")
        None -> panic("no cipher")
    }
    out := [U8]{23, 3, 3, 0, 0}
    ssldefs.ssl_push_all(out, iv)
    ssldefs.ssl_push_all(out, enc)
    out
}

/// ssl_decrypt_buf under the client transform `t` of `sealed` with its last
/// `tail.len()` bytes replaced by `tail`: the plaintext length, or the error
/// code. Each call sets the transform's IV from the record and restarts its
/// cipher, so one transform opens every record alike.
ct_cbc_open: fn(t: &ssldefs.SSLTransform, sealed: [U8], tail: [U8]) -> Int {
    buf := sealed.copy()
    ssldefs.ssl_copy_into(buf, buf.len() - tail.len(), tail, 0, tail.len())
    rec := ssldefs.SSLRecord{ctr: ssldefs.ssl_zeros(8), rtype: ssldefs.SSL_MSG_APPLICATION_DATA, ver: [U8]{3, 3}, buf_start: 0, buf_len: buf.len(), data_offset: 5, data_len: buf.len() - 5, cid_len: 0}
    if sslmsg.ssl_decrypt_buf(t, rec, buf) == .Err(e) -> return ssldefs.ssl_error_code(e)
    rec.data_len
}

// Lucky Thirteen (AlFardan and Paterson 2013): a MAC-then-encrypt CBC
// record whose padding is bad is MACed over up to 256 bytes more than one
// whose padding is good, so a MAC whose time follows its length tells the
// two apart though both are refused. The fixed class is a record with the
// longest good padding, 256 bytes, and a wrong MAC; the random class
// replaces its last two blocks, which makes the padding bad but for one
// record in about 256. Both are refused as InvalidMac, so the test times
// the padding alone. ssl_ct_hmac hashes every candidate length the same,
// and the MAC bytes are read at every candidate offset (mbedtls_ct_hmac,
// mbedtls_ct_memcpy_offset), so the two take the same time. With the MAC
// taken over the true length instead, |t| was 7.7 and 8.6 here.
#Test("dudect: TLS 1.2 CBC records with good and bad padding are refused in the same time") {
    r := CtRand{s: U64{101}}
    ssl := ct_cbc_layer()
    plain: ct_bytes(r, 64)
    iv: ct_bytes(r, 16)
    valid: ct_cbc_record(ssl.tpool[0], plain, 255, iv, true)
    assert_eq(ct_cbc_open(ssl.tpool[1], valid, ct_take(valid, valid.len() - 32, 32)), 64)
    forged: ct_cbc_record(ssl.tpool[0], plain, 255, iv, false)
    good_pad: ct_take(forged, forged.len() - 32, 32)
    invalid_mac: ssldefs.ssl_error_code(.InvalidMac)
    assert_eq(ct_cbc_open(ssl.tpool[1], forged, good_pad), invalid_mac)
    assert_eq(ct_cbc_open(ssl.tpool[1], forged, ct_last_flipped(good_pad)), invalid_mac)
    t: ct_measure("TLS 1.2 CBC ssl_decrypt_buf, good against bad padding", 9000, 4, good_pad, (x) -> ct_cbc_open(ssl.tpool[1], forged, x))
    if ct_abs(t) >= (Float{9} / Float{2}) -> panic("TLS 1.2 CBC padding: Welch's t is {t} between good and bad padding; the bound is 4.5")
}

/// exp_mod of the fixed `base` by the secret exponent `e` modulo the P-256
/// prime.
ct_exp_mod: fn(grp: ecp.EcpGroup, base: bn.Mpi, e: [U8]) -> Int {
    x: bn.read_binary(e) ?? return 0
    rr := bn.mpi()
    out: bn.exp_mod(base, x, grp.p, rr) ?? return 0
    ct_opened(Val(bn.write_binary(out, 32) ?? return 0))
}

/// The inverse of the secret `a`, nonzero and below the P-256 order by
/// ct_scalar, modulo that order.
ct_modinv: fn(grp: ecp.EcpGroup, a: [U8]) -> Int {
    x: bn.read_binary(ct_scalar(a)) ?? return 0
    got: bn.gcd_modinv_odd(x, grp.n, true) ?? return 0
    ct_opened(Val(bn.write_binary(got.i, 32) ?? return 0))
}

#Test("dudect: Bignum exp_mod and gcd_modinv_odd take as long on fixed and random secrets") {
    r := CtRand{s: U64{101}}
    grp: ecp.group_load(.Secp256r1) ?? panic("P-256: {err}")
    order: ecp.group_load(.Secp256r1) ?? panic("P-256: {err}")
    base: bn.read_binary(ct_scalar(ct_bytes(r, 32))) ?? panic("base: {err}")
    assert_eq(ct_exp_mod(grp, base, ct_bytes(r, 32)), 32)
    assert_eq(ct_modinv(order, ct_bytes(r, 32)), 32)
    ct_dudect("exp_mod, exponent", 1000, 1, ct_bytes(r, 32), (x) -> ct_exp_mod(grp, base, x))
    ct_dudect("gcd_modinv_odd, value", 2000, 1, ct_bytes(r, 32), (x) -> ct_modinv(order, x))
}

// The soak tier: the elliptic-curve and RSA runs above, whose few hundred
// samples find only a gross leak, over ten times the samples. It runs with
// JET_DUDECT_SOAK=1 only, as it takes minutes.
#Test("dudect soak tier (JET_DUDECT_SOAK=1): ECDH, ECDSA and RSA signing over ten times the samples") {
    if (core.sys.get("JET_DUDECT_SOAK") ?? "") != "1" {
        print("dudect soak tier: not run; set JET_DUDECT_SOAK=1 to run it")
        return
    }
    r := CtRand{s: U64{97}}
    base := [U8]{9}
    loop _ in 1..<32 -> base.push(U8{0})
    ct_dudect("X25519 ECDH (soak)", 6000, 1, ct_bytes(r, 32), (x) -> ct_opened(vec_ecdh(.Curve25519, x, base)))
    g256: ct_generator(.Secp256r1, 32)
    ct_dudect("P-256 ECDH (soak)", 4000, 1, ct_scalar(ct_bytes(r, 32)), (x) -> ct_opened(vec_ecdh(.Secp256r1, ct_scalar(x), g256)))
    g384: ct_generator(.Secp384r1, 48)
    ct_dudect("P-384 ECDH (soak)", 2000, 1, ct_scalar(ct_bytes(r, 48)), (x) -> ct_opened(vec_ecdh(.Secp384r1, ct_scalar(x), g384)))
    p256: ct_points(.Secp256r1, 32, 32)
    p256_key: ct_scalar(ct_bytes(r, 32))
    ct_dudect("P-256 ECDH, peer point (soak)", 4000, 1, ct_bytes(r, 1), (x) -> ct_opened(vec_ecdh(.Secp256r1, p256_key, p256[Int.from_u8(x[0]) %% 32])))
    h256: ct_bytes(r, 32)
    ct_dudect("P-256 ECDSA sign (soak)", 4000, 1, ct_bytes(r, 32), (x) -> ct_ecdsa_sign(.Secp256r1, x, h256))
    h384: ct_bytes(r, 48)
    ct_dudect("P-384 ECDSA sign (soak)", 2000, 1, ct_bytes(r, 48), (x) -> ct_ecdsa_sign(.Secp384r1, x, h384))
    nonce_key: ct_bytes(r, 32)
    nonce_hash: ct_bytes(r, 32)
    ct_dudect("P-256 ECDSA sign, nonce (soak)", 4000, 1, ct_bytes(r, 32), (x) -> ct_ecdsa_nonce(.Secp256r1, nonce_key, nonce_hash, x))
    keys: ct_rsa_keys()
    first: keys[0].copy()
    rsa_hash: ct_bytes(r, 32)
    ct_dudect("RSA-2048 sign (soak)", 2000, 1, ct_bytes(r, 32), (x) -> ct_rsa_sign(first, x))
    ct_dudect("RSA-2048 sign, key (soak)", 2000, 1, ct_bytes(r, 1), (x) -> ct_rsa_sign(keys[Int.from_u8(x[0]) %% keys.len()], rsa_hash))
}
