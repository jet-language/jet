// The extensions each TLS 1.3 handshake message may carry, one bit
// (1 << SSL_EXT_ID_*) per extension (MBEDTLS_SSL_TLS1_3_ALLOWED_EXTS_OF_*).
// The extensions TLS 1.3 does not define, point formats,
// encrypt-then-MAC, extended master secret, session ticket, truncated HMAC
// and unrecognized ones (MBEDTLS_SSL_TLS1_3_EXT_MASK_UNRECOGNIZED), are
// allowed where a message may carry extensions it does not know.
SSL_EXT_MASK_NONE: 0
SSL_TLS1_3_EXT_MASK_UNRECOGNIZED: 0x0F800001
// Every extension but oid_filters, and the unrecognized ones.
SSL_TLS1_3_ALLOWED_EXTS_OF_CH: 0x1FF7FFFF
// server_name, max_fragment_length, supported_groups, use_srtp, heartbeat,
// ALPN, client and server certificate type, early_data and
// record_size_limit.
SSL_TLS1_3_ALLOWED_EXTS_OF_EE: 0x10004DD6
// status_request, signature_algorithms, SCT, certificate_authorities,
// oid_filters, signature_algorithms_cert and the unrecognized ones.
SSL_TLS1_3_ALLOWED_EXTS_OF_CR: 0x0FAC0229
// status_request and SCT.
SSL_TLS1_3_ALLOWED_EXTS_OF_CT: 0x208
// key_share, pre_shared_key and supported_versions.
SSL_TLS1_3_ALLOWED_EXTS_OF_SH: 0x40A000
// key_share, cookie and supported_versions.
SSL_TLS1_3_ALLOWED_EXTS_OF_HRR: 0x418000
// early_data and the unrecognized ones.
SSL_TLS1_3_ALLOWED_EXTS_OF_NST: 0x0F804001

TLS_EXT_SUPPORTED_POINT_FORMATS_PRESENT: 1
TLS_EXT_ECJPAKE_KKPP_OK: 2

SSL_MAX_BLOCK_LENGTH: 16
SSL_MAX_IV_LENGTH: 16
SSL_MAX_KEY_LENGTH: 32
SSL_MAC_ADD: 48
SSL_PADDING_ADD: 256
SSL_MAX_CID_EXPANSION: 16
// MBEDTLS_MAX_IV_LENGTH + MAC_ADD + PADDING_ADD + MAX_CID_EXPANSION.
SSL_PAYLOAD_OVERHEAD: 336
SSL_IN_PAYLOAD_LEN: 16720
SSL_OUT_PAYLOAD_LEN: 16720
SSL_MAX_BUFFERED_HS: 4
TLS_EXT_ADV_CONTENT_LEN: 16384
SSL_MAX_SIG_ALG_LIST_LEN: 65534
SSL_MIN_SIG_ALG_LIST_LEN: 2
SSL_MAX_CURVE_LIST_LEN: 65535
RECEIVED_SIG_ALGS_SIZE: 20
SSL_HEADER_LEN: 13
// HEADER_LEN + PAYLOAD_LEN + CID_LEN_MAX.
SSL_IN_BUFFER_LEN: 16765
SSL_OUT_BUFFER_LEN: 16765
CLIENT_HELLO_RANDOM_LEN: 32
SERVER_HELLO_RANDOM_LEN: 32
// The largest premaster secret, the 512-byte DHM modulus of
// MBEDTLS_PREMASTER_SIZE's union, plus the PSK framing.
SSL_PREMASTER_SIZE: 1060
// The longest pre-shared key (MBEDTLS_PSK_MAX_LEN with SHA-384 on).
SSL_PSK_MAX_LEN: 48
SSL_COOKIE_MAX_LEN: 65535

SSL_DONT_FORCE_FLUSH: false
SSL_FORCE_FLUSH: true

// ---------------------------------------------------------------------------
// The error.

/// Why an SSL/TLS operation stopped (MBEDTLS_ERR_SSL_*). WantRead and
/// WantWrite are not failures: the operation needs more input or room
/// to write and should be called again. A variant with a payload carries
/// the failure of the layer underneath, as mbedtls returns that layer's
/// code unchanged.
#Error
SSLError: enum {
    /// An asynchronous operation is not completed yet (CRYPTO_IN_PROGRESS).
    CryptoInProgress
    /// The requested feature is not available (FEATURE_UNAVAILABLE).
    FeatureUnavailable
    /// Bad input parameters to the function (BAD_INPUT_DATA).
    BadInputData
    /// Verification of the message MAC failed (INVALID_MAC).
    InvalidMac
    /// An invalid SSL record was received (INVALID_RECORD).
    InvalidRecord
    /// The connection indicated an EOF (CONN_EOF).
    ConnEOF
    /// A message could not be parsed due to a syntactic error
    /// (DECODE_ERROR).
    DecodeError
    /// No RNG was provided to the SSL module (NO_RNG).
    NoRNG
    /// No client certification received from the client, but required
    /// by the authentication mode (NO_CLIENT_CERTIFICATE).
    NoClientCertificate
    /// An unsupported extension was negotiated or offered
    /// (UNSUPPORTED_EXTENSION).
    UnsupportedExtension
    /// No common application protocol (NO_APPLICATION_PROTOCOL).
    NoApplicationProtocol
    /// The own private key or pre-shared key is not set, but needed
    /// (PRIVATE_KEY_REQUIRED).
    PrivateKeyRequired
    /// No CA Chain is set, but required to operate (CA_CHAIN_REQUIRED).
    CAChainRequired
    /// An unexpected message was received from our peer
    /// (UNEXPECTED_MESSAGE).
    UnexpectedMessage
    /// A fatal alert message was received from our peer
    /// (FATAL_ALERT_MESSAGE).
    FatalAlertMessage
    /// No server could be identified matching the client's SNI
    /// (UNRECOGNIZED_NAME).
    UnrecognizedName
    /// The peer notified us that the connection is going to be closed
    /// (PEER_CLOSE_NOTIFY).
    PeerCloseNotify
    /// Processing of the Certificate handshake message failed
    /// (BAD_CERTIFICATE).
    BadCertificate
    /// A TLS 1.3 NewSessionTicket message has been received
    /// (RECEIVED_NEW_SESSION_TICKET).
    ReceivedNewSessionTicket
    /// Not possible to read early data (CANNOT_READ_EARLY_DATA).
    CannotReadEarlyData
    /// Early data has been received as part of an on-going handshake
    /// (RECEIVED_EARLY_DATA).
    ReceivedEarlyData
    /// Not possible to write early data (CANNOT_WRITE_EARLY_DATA).
    CannotWriteEarlyData
    /// Cache entry not found (CACHE_ENTRY_NOT_FOUND).
    CacheEntryNotFound
    /// Memory allocation failed (ALLOC_FAILED).
    AllocFailed
    /// Hardware acceleration function returned with error
    /// (HW_ACCEL_FAILED).
    HwAccelFailed
    /// Hardware acceleration function skipped / left alone data
    /// (HW_ACCEL_FALLTHROUGH).
    HwAccelFallthrough
    /// Handshake protocol not within min/max boundaries
    /// (BAD_PROTOCOL_VERSION).
    BadProtocolVersion
    /// The handshake negotiation failed (HANDSHAKE_FAILURE).
    HandshakeFailure
    /// Session ticket has expired (SESSION_TICKET_EXPIRED).
    SessionTicketExpired
    /// Public key type mismatch (PK_TYPE_MISMATCH).
    PKTypeMismatch
    /// Unknown identity received, e.g. PSK identity (UNKNOWN_IDENTITY).
    UnknownIdentity
    /// Internal error, e.g. an unexpected failure in a lower-level module
    /// (INTERNAL_ERROR).
    InternalError
    /// A counter would wrap, e.g. the record sequence number
    /// (COUNTER_WRAPPING).
    CounterWrapping
    /// Unexpected message at ServerHello in renegotiation
    /// (WAITING_SERVER_HELLO_RENEGO).
    WaitingServerHelloRenego
    /// DTLS client must retry for hello verification
    /// (HELLO_VERIFY_REQUIRED).
    HelloVerifyRequired
    /// A buffer is too small to receive or write a message
    /// (BUFFER_TOO_SMALL).
    BufferTooSmall
    /// No data of requested type currently available on underlying
    /// transport (WANT_READ).
    WantRead
    /// Connection requires a write call (WANT_WRITE).
    WantWrite
    /// The operation timed out (TIMEOUT).
    Timeout
    /// The client initiated a reconnect from the same port
    /// (CLIENT_RECONNECT).
    ClientReconnect
    /// Record header looks valid but is not expected (UNEXPECTED_RECORD).
    UnexpectedRecord
    /// The alert message received indicates a non-fatal error
    /// (NON_FATAL).
    NonFatal
    /// A field in a message was incorrect or inconsistent with other
    /// fields (ILLEGAL_PARAMETER).
    IllegalParameter
    /// Internal-only message signaling that further message-processing
    /// should be done (CONTINUE_PROCESSING).
    ContinueProcessing
    /// The asynchronous operation is not completed yet
    /// (ASYNC_IN_PROGRESS).
    AsyncInProgress
    /// Internal-only message signaling that a message arrived early
    /// (EARLY_MESSAGE).
    EarlyMessage
    /// An encrypted DTLS-frame with an unexpected CID was received
    /// (UNEXPECTED_CID).
    UnexpectedCID
    /// An operation failed due to an unexpected version or configuration
    /// (VERSION_MISMATCH).
    VersionMismatch
    /// Invalid value in SSL config (BAD_CONFIG).
    BadConfig
    /// Attempt to verify a certificate without an expected hostname
    /// (CERTIFICATE_VERIFICATION_WITHOUT_HOSTNAME).
    CertificateVerificationWithoutHostname
    /// An internal invariant does not hold
    /// (MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED).
    CorruptionDetected
    /// A failure with no more specific code
    /// (MBEDTLS_ERR_ERROR_GENERIC_ERROR).
    GenericError
    /// The random generator failed (mbedtls returns f_rng's own code).
    RandomFailed
    /// The cipher layer failed (an MBEDTLS_ERR_CIPHER_* code).
    Cipher(layer.CipherLayerError)
    /// A public-key operation failed (an MBEDTLS_ERR_PK_* code).
    PK(pk.PKError)
    /// A certificate could not be read or verified (an MBEDTLS_ERR_X509_*
    /// code).
    X509(x509.X509Error)
    /// An elliptic-curve operation failed (an MBEDTLS_ERR_ECP_* code).
    ECP(ecp.EcpError)
    /// A Diffie-Hellman operation failed (an MBEDTLS_ERR_DHM_* code).
    DHM(dhm.DHMError)
    /// A big-number operation failed (an MBEDTLS_ERR_MPI_* code).
    Mpi(bn.MpiError)
    /// A callback failed with this code of its own, which mbedtls returns
    /// unchanged.
    Callback(Int)
}

/// The MBEDTLS_ERR_SSL_* code of `e`, or the code of the layer underneath
/// that mbedtls returns unchanged; RandomFailed is
/// MBEDTLS_ERR_ERROR_GENERIC_ERROR, as mbedtls's own generators report.
ssl_error_code: fn(e: SSLError) -> Int Never! {
    if e == {
        .CryptoInProgress -> -0x7000
        .FeatureUnavailable -> -0x7080
        .BadInputData -> -0x7100
        .InvalidMac -> -0x7180
        .InvalidRecord -> -0x7200
        .ConnEOF -> -0x7280
        .DecodeError -> -0x7300
        .NoRNG -> -0x7400
        .NoClientCertificate -> -0x7480
        .UnsupportedExtension -> -0x7500
        .NoApplicationProtocol -> -0x7580
        .PrivateKeyRequired -> -0x7600
        .CAChainRequired -> -0x7680
        .UnexpectedMessage -> -0x7700
        .FatalAlertMessage -> -0x7780
        .UnrecognizedName -> -0x7800
        .PeerCloseNotify -> -0x7880
        .BadCertificate -> -0x7A00
        .ReceivedNewSessionTicket -> -0x7B00
        .CannotReadEarlyData -> -0x7B80
        .ReceivedEarlyData -> -0x7C00
        .CannotWriteEarlyData -> -0x7C80
        .CacheEntryNotFound -> -0x7E80
        .AllocFailed -> -0x7F00
        .HwAccelFailed -> -0x7F80
        .HwAccelFallthrough -> -0x6F80
        .BadProtocolVersion -> -0x6E80
        .HandshakeFailure -> -0x6E00
        .SessionTicketExpired -> -0x6D80
        .PKTypeMismatch -> -0x6D00
        .UnknownIdentity -> -0x6C80
        .InternalError -> -0x6C00
        .CounterWrapping -> -0x6B80
        .WaitingServerHelloRenego -> -0x6B00
        .HelloVerifyRequired -> -0x6A80
        .BufferTooSmall -> -0x6A00
        .WantRead -> -0x6900
        .WantWrite -> -0x6880
        .Timeout -> -0x6800
        .ClientReconnect -> -0x6780
        .UnexpectedRecord -> -0x6700
        .NonFatal -> -0x6680
        .IllegalParameter -> -0x6600
        .ContinueProcessing -> -0x6580
        .AsyncInProgress -> -0x6500
        .EarlyMessage -> -0x6480
        .UnexpectedCID -> -0x6000
        .VersionMismatch -> -0x5F00
        .BadConfig -> -0x5E80
        .CertificateVerificationWithoutHostname -> -0x5D80
        .CorruptionDetected -> -0x006E
        .GenericError -> -0x0001
        .RandomFailed -> -0x0001
        .Cipher(c) -> layer_code(c)
        .PK(p) -> pk_code(p)
        .X509(x) -> x509_code(x)
        .ECP(x) -> ecp_code(x)
        .DHM(d) -> dhm_code(d)
        .Mpi(m) -> mpi_code(m)
        .Callback(n) -> n
    }
}

// The mbedtls error code of each crypto layer's error. mbedtls 3.6.7
// returns a negative int: a high-level code (0x1000 and up) plus, when a
// lower layer failed under it, that layer's low-level code. The enums of the
// ported layers carry the same information as a payload; these functions
// fold it back into C's int, as mbedtls_strerror reads it, for
// ssl_error_code and core.net.tls's messages. The values are those of
// bignum.h, asn1.h, oid.h, ecp.h, rsa.h, base64.h, pem.h, cipher.h, aes.h,
// gcm.h, ccm.h, chachapoly.h, chacha20.h, des.h, pkcs5.h, pkcs12.h, pk.h,
// x509.h and dhm.h.

/// MBEDTLS_ERR_MPI_*.
mpi_code: fn(e: bn.MpiError) -> Int Never! {
    if e == {
        .BadInput -> -0x4
        .InvalidCharacter -> -0x6
        .BufferTooSmall -> -0x8
        .NegativeValue -> -0xA
        .DivisionByZero -> -0xC
        .NotAcceptable -> -0xE
        .AllocFailed -> -0x10
        .Random -> -0x3C
        .FileIO -> -0x2
    }
}

/// An optional MPI failure's code, 0 for none.
opt_mpi_code: fn(e: bn.MpiError?) -> Int Never! {
    if e == .Val(m) -> return mpi_code(m)
    0
}

/// MBEDTLS_ERR_ASN1_*, or the code of the failure an ASN.1 callback or
/// MPI read stopped with.
asn1_code: fn(e: asn1.ASN1Error) -> Int Never! {
    if e == {
        .OutOfData -> -0x60
        .UnexpectedTag -> -0x62
        .InvalidLength -> -0x64
        .LengthMismatch -> -0x66
        .InvalidData -> -0x68
        .BufTooSmall -> -0x6C
        .Stopped(c) -> c
        .Mpi(m) -> mpi_code(m)
    }
}

/// An optional ASN.1 failure's code, 0 for none.
opt_asn1_code: fn(e: asn1.ASN1Error?) -> Int Never! {
    if e == .Val(a) -> return asn1_code(a)
    0
}

/// MBEDTLS_ERR_OID_NOT_FOUND, 0 for none.
opt_oid_code: fn(e: oids.OIDError?) -> Int Never! {
    if e == .Val(_) -> return -0x2E
    0
}

/// MBEDTLS_ERR_ECP_*.
ecp_code: fn(e: ecp.EcpError) -> Int Never! {
    if e == {
        .BadInput -> -0x4F80
        .BufferTooSmall -> -0x4F00
        .FeatureUnavailable -> -0x4E80
        .VerifyFailed -> -0x4E00
        .AllocFailed -> -0x4D80
        .RandomFailed -> -0x4D00
        .InvalidKey -> -0x4C80
        .SigLenMismatch -> -0x4C00
        .Mpi(m) -> mpi_code(m)
    }
}

/// ECDSA's codes: the ECP failure, or a bad signature encoding as
/// MBEDTLS_ERR_ECP_BAD_INPUT_DATA plus the ASN.1 failure.
ecdsa_code: fn(e: ecdsa.ECDSAError) -> Int Never! {
    if e == {
        .Ecp(x) -> ecp_code(x)
        .BadEncoding(a) -> asn1_code(a) - 0x4F80
    }
}

/// MBEDTLS_ERR_RSA_* plus the MPI or ASN.1 failure under it.
rsa_code: fn(e: rsa.RSAError) -> Int Never! {
    if e == {
        .BadInput(m) -> -0x4080 + opt_mpi_code(m)
        .InvalidPadding -> -0x4100
        .KeyGenFailed(m) -> -0x4180 + opt_mpi_code(m)
        .KeyCheckFailed(m) -> -0x4200 + opt_mpi_code(m)
        .PublicFailed(m) -> -0x4280 + opt_mpi_code(m)
        .PrivateFailed(m) -> -0x4300 + opt_mpi_code(m)
        .VerifyFailed -> -0x4380
        .OutputTooLarge -> -0x4400
        .RNGFailed -> -0x4480
        .Mpi(m) -> mpi_code(m)
        .Asn1(a) -> asn1_code(a)
    }
}

/// MBEDTLS_ERR_BASE64_INVALID_CHARACTER, 0 for none.
opt_base64_code: fn(e: pem.Base64Error?) -> Int Never! {
    if e == .Val(_) -> return -0x2C
    0
}

/// MBEDTLS_ERR_DES_INVALID_INPUT_LENGTH; a key of the wrong length, which
/// C's fixed-size arrays cannot express, is MBEDTLS_ERR_ERROR_GENERIC_ERROR.
des_code: fn(e: des.DESError) -> Int Never! {
    if e == {
        .InvalidInputLength -> -0x0032
        .InvalidKeyLength -> -0x0001
    }
}

/// MBEDTLS_ERR_PEM_* plus the Base64 failure under it, or the cipher's.
pem_code: fn(e: pem.PEMError) -> Int Never! {
    if e == {
        .NoHeaderFooterPresent -> -0x1080
        .InvalidData(b) -> -0x1100 + opt_base64_code(b)
        .InvalidEncIV -> -0x1200
        .UnknownEncAlg -> -0x1280
        .PasswordRequired -> -0x1300
        .PasswordMismatch -> -0x1380
        .BadInputData -> -0x1480
        .DES(d) -> des_code(d)
        .AESInvalidInputLength -> -0x0022
    }
}

/// MBEDTLS_ERR_CIPHER_*, or the code of the cipher module under it.
layer_code: fn(e: layer.CipherLayerError) -> Int Never! {
    if e == {
        .FeatureUnavailable -> -0x6080
        .BadInputData -> -0x6100
        .InvalidPadding -> -0x6200
        .FullBlockExpected -> -0x6280
        .AuthFailed -> -0x6300
        .AESInvalidInputLength -> -0x0022
        .GCMBadInput -> -0x0014
        .CCMBadInput -> -0x000D
        .ChaChaPolyBadState -> -0x0054
        .ChaCha20BadInput -> -0x0051
    }
}

/// MBEDTLS_ERR_PKCS5_* plus the ASN.1 failure under it.
pkcs5_code: fn(e: pkcs5.PBEError) -> Int Never! {
    if e == {
        .BadInput -> -0x2F80
        .InvalidFormat(inner) -> -0x2F00 + opt_asn1_code(inner)
        .FeatureUnavailable -> -0x2E80
        .PasswordMismatch -> -0x2E00
        .Cipher(c) -> layer_code(c)
    }
}

/// MBEDTLS_ERR_PKCS12_* plus the ASN.1 failure under it.
pkcs12_code: fn(e: pkcs5.PBEError) -> Int Never! {
    if e == {
        .BadInput -> -0x1F80
        .InvalidFormat(inner) -> -0x1E80 + opt_asn1_code(inner)
        .FeatureUnavailable -> -0x1F00
        .PasswordMismatch -> -0x1E00
        .Cipher(c) -> layer_code(c)
    }
}

/// MBEDTLS_ERR_PK_* plus the failure under it, or the lower layer's.
pk_code: fn(e: pk.PKError) -> Int Never! {
    if e == {
        .TypeMismatch -> -0x3F00
        .BadInput -> -0x3E80
        .KeyInvalidVersion -> -0x3D80
        .KeyInvalidFormat(a) -> -0x3D00 + opt_asn1_code(a)
        .KeyInvalidFormatEcp(x) -> -0x3D00 + ecp_code(x)
        .UnknownPKAlg -> -0x3C80
        .PasswordRequired -> -0x3C00
        .PasswordMismatch -> -0x3B80
        .InvalidPubkey(a) -> -0x3B00 + opt_asn1_code(a)
        .InvalidAlg(a) -> -0x3A80 + opt_asn1_code(a)
        .UnknownNamedCurve -> -0x3A00
        .FeatureUnavailable -> -0x3980
        .SigLenMismatch -> -0x3900
        .BufferTooSmall -> -0x3880
        .RSA(x) -> rsa_code(x)
        .Ecp(x) -> ecp_code(x)
        .ECDSA(x) -> ecdsa_code(x)
        .Asn1(a) -> asn1_code(a)
        .Oid(_) -> -0x2E
        .PEM(x) -> pem_code(x)
        .PKCS5(x) -> pkcs5_code(x)
        .PKCS12(x) -> pkcs12_code(x)
    }
}

/// MBEDTLS_ERR_X509_* plus the failure under it, or the lower layer's.
x509_code: fn(e: x509.X509Error) -> Int Never! {
    if e == {
        .FeatureUnavailable(o) -> -0x2080 + opt_oid_code(o)
        .UnknownOid -> -0x2100
        .InvalidFormat(a) -> -0x2180 + opt_asn1_code(a)
        .InvalidVersion(a) -> -0x2200 + opt_asn1_code(a)
        .InvalidSerial(a) -> -0x2280 + opt_asn1_code(a)
        .InvalidAlg(a) -> -0x2300 + opt_asn1_code(a)
        .InvalidAlgOid(_) -> -0x2300 - 0x2E
        .InvalidName(a) -> -0x2380 + opt_asn1_code(a)
        .InvalidDate(a) -> -0x2400 + opt_asn1_code(a)
        .InvalidSignature(a) -> -0x2480 + opt_asn1_code(a)
        .InvalidExtensions(a) -> -0x2500 + opt_asn1_code(a)
        .UnknownVersion -> -0x2580
        .UnknownSigAlg(o) -> -0x2600 + opt_oid_code(o)
        .SigMismatch -> -0x2680
        .CertVerifyFailed(_) -> -0x2700
        .CertUnknownFormat -> -0x2780
        .BadInput -> -0x2800
        .BufferTooSmall -> -0x2980
        .FatalError -> -0x3000
        .Callback(code) -> code
        .Asn1(a) -> asn1_code(a)
        .PK(x) -> pk_code(x)
        .PEM(x) -> pem_code(x)
        .OID(o) -> opt_oid_code(Val(o))
    }
}

/// MBEDTLS_ERR_DHM_* plus the MPI or ASN.1 failure under it, or the PEM
/// layer's.
dhm_code: fn(e: dhm.DHMError) -> Int Never! {
    if e == {
        .BadInput -> -0x3080
        .ReadParamsFailed(m) -> -0x3100 + mpi_code(m)
        .MakeParamsFailed(m) -> -0x3180 + opt_mpi_code(m)
        .ReadPublicFailed(m) -> -0x3200 + mpi_code(m)
        .MakePublicFailed(m) -> -0x3280 + opt_mpi_code(m)
        .CalcSecretFailed(m) -> -0x3300 + mpi_code(m)
        .InvalidFormat(a) -> -0x3380 + asn1_code(a)
        .SetGroupFailed(m) -> -0x3580 + mpi_code(m)
        .Mpi(m) -> mpi_code(m)
        .PEM(p) -> pem_code(p)
    }
}

// ---------------------------------------------------------------------------
// Records, transforms and sessions.

/// A record being protected or unprotected (mbedtls_record). C's `buf`
/// points into a larger buffer; here the record layer takes that whole
/// buffer beside the record, and `buf_start` is the offset C's pointer has
/// in it, so it works in the context's input and output buffers without
/// copying them. `data_offset` is relative to `buf_start`, as in C.
SSLRecord: struct {
    ctr: [U8]{[]}
    rtype: Int{0}
    ver: [U8]{[]}
    buf_start: Int{0}
    buf_len: Int{0}
    data_offset: Int{0}
    data_len: Int{0}
    cid_len: Int{0}
    cid: [U8]{[]}
}

/// The keys and state that protect records in one direction pair
/// (mbedtls_ssl_transform). The MAC contexts are the HMAC keys of
/// non-AEAD suites; AEAD suites have none. `valid` marks a pool slot in use.
SSLTransform: struct {
    valid: Bool{false}
    minlen: Int{0}
    ivlen: Int{0}
    fixed_ivlen: Int{0}
    maclen: Int{0}
    taglen: Int{0}
    iv_enc: [U8]{[]}
    iv_dec: [U8]{[]}
    md_enc: hashes.HMACKey?{None}
    md_dec: hashes.HMACKey?{None}
    encrypt_then_mac: Int{0}
    tls_version: Int{0}
    cipher_enc: layer.CipherContext?{None}
    cipher_dec: layer.CipherContext?{None}
    in_cid: [U8]{[]}
    out_cid: [U8]{[]}
    randbytes: [U8]{[]}
}

/// The TLS 1.3 secrets kept after the handshake
/// (mbedtls_ssl_tls13_application_secrets).
SSLTLS13AppSecrets: struct {
    client_application_traffic_secret_n: [U8]{[]}
    server_application_traffic_secret_n: [U8]{[]}
    exporter_master_secret: [U8]{[]}
    resumption_master_secret: [U8]{[]}
}

/// A negotiated or resumable session (mbedtls_ssl_session). `id` is the
/// session ID (id_len is its length); `ticket` is None when no ticket is
/// held; `peer_cert` is None when no peer chain was received.
SSLSession: struct {
    valid: Bool{false}
    mfl_code: Int{0}
    exported: Int{0}
    endpoint: Int{0}
    tls_version: Int{0}
    start: Int{0}
    ciphersuite: Int{0}
    id: [U8]{[]}
    master: [U8]{[]}
    peer_cert: [x509crt.X509Crt]?{None}
    verify_result: Int{0xFFFFFFFF}
    ticket: [U8]?{None}
    ticket_lifetime: Int{0}
    ticket_creation_time: Int{0}
    ticket_age_add: Int{0}
    ticket_flags: Int{0}
    resumption_key: [U8]{[]}
    hostname: String?{None}
    ticket_reception_time: Int{0}
    encrypt_then_mac: Int{0}
    app_secrets: SSLTLS13AppSecrets{SSLTLS13AppSecrets{}}
}

/// One own certificate chain and its private key (mbedtls_ssl_key_cert).
SSLKeyCert: struct {
    cert: [x509crt.X509Crt]
    key: pk.PKContext
}

/// One outgoing DTLS handshake or CCS message kept for retransmission
/// (mbedtls_ssl_flight_item); `p` includes the handshake header.
SSLFlightItem: struct {
    p: [U8]
    mtype: Int
}

/// A buffered future handshake message (mbedtls_ssl_hs_buffer).
SSLHsBuffer: struct {
    is_valid: Bool{false}
    is_fragmented: Bool{false}
    is_complete: Bool{false}
    data: [U8]{[]}
}

/// What an SNI callback selects for the handshake: the certificates and
/// key, CA chain and CRLs, and authmode to use instead of the
/// configuration's (mbedtls_ssl_set_hs_own_cert, set_hs_ca_chain,
/// set_hs_authmode, set_hs_dn_hints). None and an empty key_cert keep the
/// configuration's.
SSLHsOverride: struct {
    key_cert: [SSLKeyCert]{[]}
    ca_chain: [x509crt.X509Crt]?{None}
    ca_crl: [x509crl.X509Crl]{[]}
    authmode: Int{SSL_VERIFY_UNSET}
    dn_hints: [x509crt.X509Crt]?{None}
}

/// What a server PSK callback selects for an identity
/// (mbedtls_ssl_set_hs_psk). None refuses the identity.
SSLPskResult: struct {
    psk: [U8]?{None}
}

// ---------------------------------------------------------------------------
// Callbacks. C passes each a `void *` context; a Jet callback is a closure,
// which captures its context. C callbacks that change the SSL context (SNI,
// PSK, certificate selection) return what to change, which the engine
// applies.

/// Look up a cached session by ID (mbedtls_ssl_cache_get_t).
SSLCacheGet: struct {
    call: fn([U8]) -[Net]> SSLSession SSLError!
}

/// Store a session under its ID (mbedtls_ssl_cache_set_t).
SSLCacheSet: struct {
    call: fn([U8], SSLSession) -[Net]> Bool SSLError!
}

/// The server's SNI callback: what to use for this server name
/// (f_sni).
SSLSniCallback: struct {
    call: fn([U8]) -[Net]> SSLHsOverride SSLError!
}

/// The server's PSK callback: the key for this identity (f_psk).
SSLPskCallback: struct {
    call: fn([U8]) -[Net]> SSLPskResult SSLError!
}

/// The server's certificate selection callback, run after the
/// ClientHello is parsed: what to use for this handshake (f_cert_cb).
SSLCertCallback: struct {
    call: fn(SSLClientHelloInfo) -[Net]> SSLHsOverride SSLError!
}

/// What a certificate callback learns of the ClientHello: the SNI name
/// and the signature algorithms the client offered.
SSLClientHelloInfo: struct {
    sni: [U8]?
    sig_algs: [Int]
}

/// Write a DTLS HelloVerifyRequest cookie for a client's transport ID
/// (f_cookie_write).
SSLCookieWrite: struct {
    call: fn([U8]) -[Net]> [U8] SSLError!
}

/// Check a returned cookie against the client's transport ID
/// (f_cookie_check).
SSLCookieCheck: struct {
    call: fn([U8], [U8]) -[Net]> Bool SSLError!
}

/// A written session ticket: the ticket and its lifetime hint in seconds.
SSLTicketWritten: struct {
    ticket: [U8]
    lifetime: Int
}

/// Seal a session into a ticket (mbedtls_ssl_ticket_write_t).
SSLTicketWrite: struct {
    call: fn(SSLSession) -[Net]> SSLTicketWritten SSLError!
}

/// Open a ticket back into its session (mbedtls_ssl_ticket_parse_t).
SSLTicketParse: struct {
    call: fn([U8]) -[Net]> SSLSession SSLError!
}

/// One exported secret (mbedtls_ssl_export_keys_t's arguments).
SSLExportedKey: struct {
    ktype: Int
    secret: [U8]
    client_random: [U8]
    server_random: [U8]
    tls_prf_type: Int
}

/// Receive each secret the handshake derives (f_export_keys).
SSLExportKeys: struct {
    call: fn(SSLExportedKey) -[Net]> Bool Never!
}

// ---------------------------------------------------------------------------
// Configuration.

/// The settings shared by the contexts that use them (mbedtls_ssl_config).
/// A context takes its own copy at ssl_setup. The random generator is not
/// part of it: the calls that need randomness take one.
SSLConfig: struct {
    max_tls_version: Int{SSL_VERSION_UNKNOWN}
    min_tls_version: Int{SSL_VERSION_UNKNOWN}
    endpoint: Int{SSL_IS_CLIENT}
    transport: Int{SSL_TRANSPORT_STREAM}
    authmode: Int{SSL_VERIFY_NONE}
    allow_legacy_renegotiation: Int{0}
    mfl_code: Int{0}
    encrypt_then_mac: Int{0}
    extended_ms: Int{0}
    anti_replay: Int{0}
    disable_renegotiation: Int{0}
    session_tickets: Int{0}
    new_session_tickets_count: Int{0}
    tls13_signal_new_session_tickets: Int{0}
    cert_req_ca_list: Int{0}
    respect_cli_pref: Int{0}
    ignore_unexpected_cid: Int{0}
    ciphersuite_list: [Int]{[]}
    tls13_kex_modes: Int{0}
    f_get_cache: SSLCacheGet?{None}
    f_set_cache: SSLCacheSet?{None}
    f_sni: SSLSniCallback?{None}
    f_vrfy: x509crt.X509VerifyCallback?{None}
    f_psk: SSLPskCallback?{None}
    f_cookie_write: SSLCookieWrite?{None}
    f_cookie_check: SSLCookieCheck?{None}
    f_ticket_write: SSLTicketWrite?{None}
    f_ticket_parse: SSLTicketParse?{None}
    cid_len: Int{0}
    cert_profile: x509crt.X509CrtProfile{x509crt.x509_crt_profile_default()}
    key_cert: [SSLKeyCert]{[]}
    ca_chain: [x509crt.X509Crt]?{None}
    ca_crl: [x509crl.X509Crl]{[]}
    sig_algs: [Int]{[]}
    group_list: [Int]{[]}
    dhm_p: bn.Mpi?{None}
    dhm_g: bn.Mpi?{None}
    psk: [U8]?{None}
    psk_identity: [U8]?{None}
    alpn_list: [String]?{None}
    read_timeout: Int{0}
    hs_timeout_min: Int{0}
    hs_timeout_max: Int{0}
    renego_max_records: Int{0}
    renego_period: [U8]{[]}
    badmac_limit: Int{0}
    dhm_min_bitlen: Int{0}
    f_cert_cb: SSLCertCallback?{None}
    dn_hints: [x509crt.X509Crt]?{None}
}

// ---------------------------------------------------------------------------
// Handshake state.

/// The state only a handshake needs (mbedtls_ssl_handshake_params). C's
/// tls_prf and calc_finished function pointers are the digest
/// `tls_prf_md` names and its calc_verify pointer the digest
/// `calc_verify_md` names (None before the ciphersuite sets them), which
/// the engine dispatches on; its update_checksum pointer is `checksum_md`:
/// 0 feeds both transcript hashes (ssl_update_checksum_start), 1 SHA-256
/// and 2 SHA-384 alone. `premaster` holds `pmslen` bytes of premaster.
SSLHandshake: struct {
    resume: Int{0}
    cli_exts: Int{0}
    sni_authmode: Int{SSL_VERIFY_UNSET}
    certificate_request_sent: Int{0}
    new_session_ticket: Int{0}
    min_tls_version: Int{0}
    extended_ms: Int{0}
    retransmit_state: Int{0}
    ciphersuite_info: suites.SSLCiphersuite?{None}
    tls_prf_md: hashes.Md?{None}
    calc_verify_md: hashes.Md?{None}
    pmslen: Int{0}
    checksum_md: Int{0}
    // TLS 1.3.
    key_exchange_mode: Int{0}
    hello_retry_request_flag: Int{0}
    ccs_sent: Int{0}
    tls13_kex_modes: Int{0}
    hrr_selected_group: Int{0}
    new_session_tickets_count: Int{0}
    received_sig_algs: [Int]{[]}
    // Key exchange.
    dhm_ctx: dhm.DHMContext?{None}
    ecdh_ctx: ecdh.ECDHContext?{None}
    // The groups the client's supported_groups offered that we know; None
    // without the extension (C's NULL).
    curves_tls_id: [Int]?{None}
    // The peer's TLS 1.3 key share (xxdh_psa_peerkey); our own key share
    // is in ecdh_ctx or dhm_ctx, by group.
    xxdh_peerkey: [U8]{[]}
    psk: [U8]?{None}
    selected_identity: Int{0}
    // The own key and certificate picked: an index into the SNI or
    // certificate callback's list when it set one, else the
    // configuration's; -1 for the configuration's first.
    key_cert: Int{-1}
    // The callback's own keys and certificates; empty for none (C's NULL).
    sni_key_cert: [SSLKeyCert]{[]}
    sni_ca_chain: [x509crt.X509Crt]?{None}
    sni_ca_crl: [x509crl.X509Crl]{[]}
    // DTLS reassembly and buffering.
    total_bytes_buffered: Int{0}
    seen_ccs: Int{0}
    hs: [SSLHsBuffer]{[]}
    future_record: [U8]{[]}
    future_record_epoch: Int{0}
    cookie: [U8]?{None}
    cookie_verify_result: Int{0}
    out_msg_seq: Int{0}
    in_msg_seq: Int{0}
    retransmit_timeout: Int{0}
    flight: [SSLFlightItem]{[]}
    cur_msg: Int{-1}
    cur_msg_p: Int{0}
    in_flight_start_seq: Int{0}
    alt_transform_out: Int{-1}
    alt_out_ctr: [U8]{[]}
    cid_in_use: Int{0}
    peer_cid: [U8]{[]}
    mtu: Int{0}
    // The running handshake transcript hashes, started at handshake
    // set-up (ssl_handshake_params_init).
    fin_sha256: hashes.HashCtx?{None}
    fin_sha384: hashes.HashCtx?{None}
    offered_group_id: Int{0}
    client_auth: Int{0}
    // TLS 1.3 Finished preparation (state_local).
    finished_preparation_done: Int{0}
    finished_digest: [U8]{[]}
    randbytes: [U8]{[]}
    premaster: [U8]{[]}
    sent_extensions: Int{0}
    received_extensions: Int{0}
    certificate_request_context: [U8]{[]}
    transform_handshake: Int{-1}
    // The TLS 1.3 key schedule (tls13_master_secrets, tls13_hs_secrets).
    tls13_early_secret: [U8]{[]}
    tls13_handshake_secret: [U8]{[]}
    tls13_app_secret: [U8]{[]}
    client_handshake_traffic_secret: [U8]{[]}
    server_handshake_traffic_secret: [U8]{[]}
    sni_name: [U8]?{None}
    dn_hints: [x509crt.X509Crt]?{None}
}

// ---------------------------------------------------------------------------
// The context.

/// The bytes the context exchanges with the network in place of C's
/// f_send and f_recv callbacks. Received bytes (TLS) or datagrams (DTLS)
/// are queued by the caller; written ones are taken by the caller.
/// `rx_eof` makes a read with nothing queued report end of file;
/// `tx_room`, when not -1, is how many more bytes a write may queue
/// before reporting WantWrite.
SSLBio: struct {
    rx: [U8]{[]}
    rx_off: Int{0}
    rx_dgrams: [[U8]]{[]}
    rx_eof: Bool{false}
    tx: [U8]{[]}
    tx_dgrams: [[U8]]{[]}
    tx_room: Int{-1}
}

/// The retransmission timer (mbedtls_ssl_set_timer_cb with mbedtls's
/// timing delay): an intermediate and a final delay in milliseconds from
/// when it was set; `fin_ms` 0 is canceled.
SSLTimer: struct {
    enabled: Bool{false}
    int_ms: Int{0}
    fin_ms: Int{0}
    start_ns: Int{0}
}

/// One SSL/TLS connection (mbedtls_ssl_context).
SSLContext: struct {
    conf: SSLConfig{SSLConfig{}}
    has_conf: Bool{false}
    state: Int{0}
    renego_status: Int{0}
    renego_records_seen: Int{0}
    tls_version: Int{0}
    badmac_seen_or_in_hsfraglen: Int{0}
    f_vrfy: x509crt.X509VerifyCallback?{None}
    bio: SSLBio{SSLBio{}}
    spool: [SSLSession]{[]}
    session_in: Int{-1}
    session_out: Int{-1}
    session: Int{-1}
    session_negotiate: Int{-1}
    handshake: SSLHandshake{SSLHandshake{}}
    has_handshake: Bool{false}
    tpool: [SSLTransform]{[]}
    transform_in: Int{-1}
    transform_out: Int{-1}
    transform: Int{-1}
    transform_negotiate: Int{-1}
    transform_application: Int{-1}
    timer: SSLTimer{SSLTimer{}}
    // The input buffer and the offsets C's in_* pointers have in it.
    in_buf: [U8]{[]}
    in_ctr: Int{0}
    in_hdr: Int{0}
    in_cid: Int{0}
    in_len: Int{0}
    in_iv: Int{0}
    in_msg: Int{0}
    in_offt: Int{-1}
    in_msgtype: Int{0}
    in_msglen: Int{0}
    in_left: Int{0}
    in_epoch: Int{0}
    next_record_offset: Int{0}
    in_window_top: U64{U64{0}}
    in_window: U64{U64{0}}
    in_hslen: Int{0}
    nb_zero: Int{0}
    keep_current_message: Int{0}
    send_alert: Int{0}
    alert_type: Int{0}
    alert_reason: SSLError?{None}
    disable_datagram_packing: Int{0}
    // The output buffer and the offsets C's out_* pointers have in it.
    out_buf: [U8]{[]}
    out_ctr: Int{0}
    out_hdr: Int{0}
    out_cid: Int{0}
    out_len: Int{0}
    out_iv: Int{0}
    out_msg: Int{0}
    out_msgtype: Int{0}
    out_msglen: Int{0}
    out_left: Int{0}
    cur_out_ctr: [U8]{[]}
    mtu: Int{0}
    hostname: String?{None}
    hostname_skip_cn: Bool{false}
    alpn_chosen: String?{None}
    cli_id: [U8]?{None}
    secure_renegotiation: Int{0}
    verify_data_len: Int{0}
    own_verify_data: [U8]{[]}
    peer_verify_data: [U8]{[]}
    own_cid: [U8]{[]}
    negotiate_cid: Int{0}
    f_export_keys: SSLExportKeys?{None}
}

// ---------------------------------------------------------------------------
// Byte helpers.

ssl_zeros: fn(n: Int) -> [U8] Never! {
    out := [U8]{}
    loop _ in 0..<n -> out.push(U8{0})
    out
}

ssl_bytes_of: fn(src: [U8], off: Int, len: Int) -> [U8] Never! {
    out := [U8]{}
    loop i in 0..<len -> out.push(src[off + i])
    out
}

ssl_copy_into: fn(dst: &[U8], doff: Int, src: [U8], soff: Int, len: Int) Never! {
    loop i in 0..<len -> dst[doff + i] = src[soff + i]
}

ssl_move_within: fn(buf: &[U8], doff: Int, soff: Int, len: Int) Never! {
    if len <= 0 || doff == soff -> return
    if doff < soff {
        loop i in 0..<len -> buf[doff + i] = buf[soff + i]
        return
    }
    i := len - 1
    loop i >= 0 {
        buf[doff + i] = buf[soff + i]
        i -= 1
    }
}

ssl_fill: fn(buf: &[U8], off: Int, len: Int, value: U8) Never! {
    loop i in 0..<len -> buf[off + i] = value
}

ssl_push_all: fn(out: &[U8], bytes: [U8]) Never! {
    loop b in bytes -> out.push(b)
}

ssl_u8: fn(buf: [U8], off: Int) -> Int Never! { Int{buf[off]} }

ssl_get_u16: fn(buf: [U8], off: Int) -> Int Never! {
    (Int{buf[off]} << 8).bit_or(Int{buf[off + 1]})
}

ssl_get_u24: fn(buf: [U8], off: Int) -> Int Never! {
    (Int{buf[off]} << 16).bit_or(Int{buf[off + 1]} << 8).bit_or(Int{buf[off + 2]})
}

ssl_get_u32: fn(buf: [U8], off: Int) -> Int Never! {
    (ssl_get_u16(buf, off) << 16).bit_or(ssl_get_u16(buf, off + 2))
}

ssl_byte: fn(v: Int) -> U8 Never! { U8{v.bit_and(0xFF)} }

ssl_put_u16: fn(buf: &[U8], off: Int, v: Int) Never! {
    buf[off] = ssl_byte(v >> 8)
    buf[off + 1] = ssl_byte(v)
}

ssl_put_u24: fn(buf: &[U8], off: Int, v: Int) Never! {
    buf[off] = ssl_byte(v >> 16)
    buf[off + 1] = ssl_byte(v >> 8)
    buf[off + 2] = ssl_byte(v)
}

ssl_put_u32: fn(buf: &[U8], off: Int, v: Int) Never! {
    buf[off] = ssl_byte(v >> 24)
    buf[off + 1] = ssl_byte(v >> 16)
    buf[off + 2] = ssl_byte(v >> 8)
    buf[off + 3] = ssl_byte(v)
}

ssl_push_u16: fn(out: &[U8], v: Int) Never! {
    out.push(ssl_byte(v >> 8))
    out.push(ssl_byte(v))
}

ssl_push_u24: fn(out: &[U8], v: Int) Never! {
    out.push(ssl_byte(v >> 16))
    out.push(ssl_byte(v >> 8))
    out.push(ssl_byte(v))
}

ssl_push_u32: fn(out: &[U8], v: Int) Never! {
    out.push(ssl_byte(v >> 24))
    out.push(ssl_byte(v >> 16))
    out.push(ssl_byte(v >> 8))
    out.push(ssl_byte(v))
}

ssl_push_u64: fn(out: &[U8], v: Int) Never! {
    ssl_push_u32(out, v >> 32)
    ssl_push_u32(out, v)
}

ssl_get_u64: fn(buf: [U8], off: Int) -> Int Never! {
    (ssl_get_u32(buf, off) << 32).bit_or(ssl_get_u32(buf, off + 4))
}

ssl_range_eq: fn(a: [U8], aoff: Int, b: [U8], boff: Int, len: Int) -> Bool Never! {
    loop i in 0..<len {
        if a[aoff + i] != b[boff + i] -> return false
    }
    true
}

ssl_wipe: fn(buf: &[U8]) Never! {
    loop i in 0..<buf.len() -> buf[i] = U8{0}
}

// ---------------------------------------------------------------------------
// Clocks.

/// Seconds since the epoch (mbedtls_time), 0 before it. The wall clock is
/// core.net.tls's host row, so a handshake needs Net alone.
ssl_time: fn() -> Int Never! {
    sample: core.net.tls.__host_wall_sample()
    if sample.before_epoch -> 0 else -> sample.seconds
}

/// Milliseconds of the monotonic clock (mbedtls_ms_time, which reads
/// CLOCK_BOOTTIME or CLOCK_MONOTONIC).
ssl_ms_time: fn() -> Int Never! { rt.clock_mono_ns() /% 1000000 }

// ---------------------------------------------------------------------------
// Pools: C's session and transform pointers.

/// A fresh transform slot (mbedtls_calloc + mbedtls_ssl_transform_init).
ssl_transform_alloc: fn(ssl: &SSLContext) -> Int Never! {
    loop i in 0..<ssl.tpool.len() {
        if !ssl.tpool[i].valid {
            ssl.tpool[i] = SSLTransform{valid: true}
            return i
        }
    }
    ssl.tpool.push(SSLTransform{valid: true})
    ssl.tpool.len() - 1
}

/// mbedtls_ssl_transform_free + mbedtls_free: wipes the keys and frees the
/// slot. -1 is NULL and does nothing.
ssl_transform_release: fn(ssl: &SSLContext, t: Int) Never! {
    if t < 0 -> return
    ssl_transform_wipe(ssl.tpool[t])
    ssl.tpool[t] = SSLTransform{}
}

/// mbedtls_ssl_transform_free on a transform: its secrets are wiped.
ssl_transform_wipe: fn(t: &SSLTransform) Never! {
    ssl_wipe(t.iv_enc)
    ssl_wipe(t.iv_dec)
    t.md_enc = None
    t.md_dec = None
    t.cipher_enc = None
    t.cipher_dec = None
}

ssl_session_alloc: fn(ssl: &SSLContext) -> Int Never! {
    loop i in 0..<ssl.spool.len() {
        if !ssl.spool[i].valid {
            ssl.spool[i] = SSLSession{valid: true}
            return i
        }
    }
    ssl.spool.push(SSLSession{valid: true})
    ssl.spool.len() - 1
}

/// mbedtls_ssl_session_free + mbedtls_free on a pool slot.
ssl_session_release: fn(ssl: &SSLContext, s: Int) Never! {
    if s < 0 -> return
    ssl_session_wipe(ssl.spool[s])
    ssl.spool[s] = SSLSession{}
}

/// mbedtls_ssl_session_free: the session's secrets are wiped and it is
/// reset.
ssl_session_wipe: fn(s: &SSLSession) Never! {
    ssl_wipe(s.master)
    ssl_wipe(s.resumption_key)
    ssl_wipe(s.app_secrets.client_application_traffic_secret_n)
    ssl_wipe(s.app_secrets.server_application_traffic_secret_n)
    ssl_wipe(s.app_secrets.exporter_master_secret)
    ssl_wipe(s.app_secrets.resumption_master_secret)
    valid: s.valid
    s = SSLSession{valid: valid}
}
