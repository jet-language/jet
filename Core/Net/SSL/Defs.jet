// SPDX-License-Identifier: Apache-2.0
// Translated from Mbed TLS 3.6.7 (include/mbedtls/ssl.h, library/ssl_misc.h, library/error.c, the error codes of include/mbedtls/*.h); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: the SSL/TLS engine's constants, error and state.
//
// A port of the declarations mbedtls 3.6.7's TLS stack shares (ssl.h and
// ssl_misc.h) under the default mbedtls_config.h: (D)TLS 1.2 and TLS 1.3,
// client and server, DTLS connection IDs, encrypt-then-MAC, extended
// master secret, renegotiation, max fragment length, context
// serialization, session tickets, SNI, ALPN and the session cache, cookie
// and ticket helpers. Early data, EC J-PAKE, record size limit, variable
// buffer lengths, DTLS-SRTP, asynchronous private keys and the NULL cipher
// are off in that configuration and are not ported.
//
// Where C keeps pointers between the context's sessions and transforms
// (session_in, transform_out, alt_transform_out, ...), the context owns
// pools `spool` and `tpool` and every such pointer is an index into its
// pool, -1 for NULL; assigning a pointer assigns the index, so the C state
// machine carries over unchanged.
//
// The engine does no I/O of its own: `bio` holds the bytes (TLS) or
// datagrams (DTLS) received and to be sent, which the caller moves between
// the context and the network (mbedtls_ssl_set_bio's role).
use {
    core
    rt: jet.runtime.time
    bn: __core_crypto_bignum
    layer: __core_crypto_cipher_layer
    hashes: __core_crypto_md
    ecp: __core_crypto_ecp
    ecdh: __core_crypto_ecdh
    dhm: __core_crypto_dhm
    pk: __core_crypto_pk
    x509: __core_crypto_x509
    x509crt: __core_crypto_x509crt
    x509crl: __core_crypto_x509crl
    asn1: __core_crypto_asn1
    oids: __core_crypto_oid
    ecdsa: __core_crypto_ecdsa
    rsa: __core_crypto_rsa
    pem: __core_crypto_pem
    des: __core_crypto_des
    pkcs5: __core_crypto_pkcs5
    suites: __core_net_ssl_ciphersuites
}

