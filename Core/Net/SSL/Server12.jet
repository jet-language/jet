// SPDX-License-Identifier: Apache-2.0
// Translated from Mbed TLS 3.6.7 (library/ssl_tls12_server.c); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: the TLS 1.2 server handshake.
//
// A port of mbedtls 3.6.7's ssl_tls12_server.c under the default
// mbedtls_config.h. MBEDTLS_USE_PSA_CRYPTO is off there, so the key
// exchanges run on the handshake's ECDH and DHM contexts; EC J-PAKE,
// DTLS-SRTP, asynchronous private keys and restartable ECC are off and not
// ported.
//
// Messages are read at in_buf offsets and written at out_buf offsets. As
// in C, this side sends a fatal alert at once where it finds an error,
// whether or not the alert could be sent; the ClientHello checks that come
// before the version is known send none, since the peer may not speak TLS.
use {
    core
    __core_crypto_bignum.[RNG]
    hashes: __core_crypto_md
    ctime: __core_crypto_ctime
    oids: __core_crypto_oid
    ecp: __core_crypto_ecp
    ecdh: __core_crypto_ecdh
    dhm: __core_crypto_dhm
    pk: __core_crypto_pk
    rsa: __core_crypto_rsa
    x509: __core_crypto_x509
    x509crt: __core_crypto_x509crt
    ssldefs: __core_net_ssl_defs
    suites: __core_net_ssl_ciphersuites
    sslmsg: __core_net_ssl_msg
    ssltls: __core_net_ssl_tls
}

// MBEDTLS_ECP_DP_MAX: one more than the number of curves mbedtls knows.
SSL_SRV12_ECP_DP_MAX: 14

// Send a fatal alert and give the error to return with it.
ssl_srv12_fail: fn<R: RNG>(ssl: &ssldefs.SSLContext, alert: Int, reason: ssldefs.SSLError, rng: &R) -> ssldefs.SSLError Never! {
    ssltls.ssl_send_fatal_alert(ssl, alert, rng)
    reason.copy()
}

/// Set the client's transport-level ID, which a DTLS HelloVerifyRequest
/// cookie is bound to (mbedtls_ssl_set_client_transport_id).
ssl_set_client_transport_id: fn(ssl: &ssldefs.SSLContext, info: [U8]) ssldefs.SSLError! {
    if ssl.conf.endpoint != ssldefs.SSL_IS_SERVER -> return Err(.BadInputData)
    ssl.cli_id = Val(info)
}

// Whether a PSK callback, or a configured PSK and identity, is there
// (ssl_conf_has_psk_or_cb).
ssl_srv12_conf_has_psk_or_cb: fn(conf: ssldefs.SSLConfig) -> Bool Never! {
    if conf.f_psk != None -> return true
    identity_len: if conf.psk_identity == .Val(id) -> id.len() else -> 0
    if identity_len == 0 -> return false
    psk_len: if conf.psk == .Val(psk) -> psk.len() else -> 0
    psk_len != 0
}

// ---------------------------------------------------------------------------
// ClientHello extensions, each at in_buf[buf..<buf + len].

// renegotiation_info: empty on the first handshake, the client's last
// verify data in a renegotiation (ssl_parse_renegotiation_info, RFC 5746
// 3.6).
ssl_srv12_parse_renegotiation_info: fn<R: RNG>(ssl: &ssldefs.SSLContext, buf: Int, len: Int, rng: &R) ssldefs.SSLError! {
    if ssl.renego_status != ssldefs.SSL_INITIAL_HANDSHAKE {
        // The verify data in constant time; its length is no secret.
        vdl: ssl.verify_data_len
        ok := len == 1 + vdl && ssldefs.ssl_u8(ssl.in_buf, buf) == vdl
        if ok -> ok = ctime.memcmp(ssl.in_buf, buf + 1, ssl.peer_verify_data, 0, vdl) == 0
        if !ok -> return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE, .HandshakeFailure, rng))
        return
    }
    if len != 1 || ssldefs.ssl_u8(ssl.in_buf, buf) != 0 -> return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE, .HandshakeFailure, rng))
    ssl.secure_renegotiation = ssldefs.SSL_SECURE_RENEGOTIATION
}

// supported_groups (elliptic_curves in TLS 1.2): the groups offered that
// mbedtls knows, at most ECP_DP_MAX - 1 of them (ssl_parse_supported_groups_ext,
// RFC 8422 5.1.1).
ssl_srv12_parse_supported_groups_ext: fn<R: RNG>(ssl: &ssldefs.SSLContext, buf: Int, len: Int, rng: &R) ssldefs.SSLError! {
    if len < 2 -> return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    list_size := ssldefs.ssl_get_u16(ssl.in_buf, buf)
    if list_size + 2 != len || list_size % 2 != 0 {
        return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    }
    // Only a client that repeats the extension gets here twice.
    if ssl.handshake.curves_tls_id != None {
        return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_ILLEGAL_PARAMETER, .IllegalParameter, rng))
    }
    // Room for what the peer offers, never more than we know, and C's
    // closing 0.
    our_size := list_size /% 2 + 1
    if our_size > SSL_SRV12_ECP_DP_MAX -> our_size = SSL_SRV12_ECP_DP_MAX
    ids := [Int]{}
    p := buf + 2
    loop list_size > 0 && our_size > 1 {
        tls_id: ssldefs.ssl_get_u16(ssl.in_buf, p)
        if ssltls.ssl_get_ecp_group_id_from_tls_id(tls_id) != .Unknown {
            ids.push(tls_id)
            our_size -= 1
        }
        list_size -= 2
        p += 2
    }
    ssl.handshake.curves_tls_id = Val(ids)
}

// ec_point_formats: the first of uncompressed or compressed the client
// lists becomes the ECDH point format; a list with neither is accepted
// (ssl_parse_supported_point_formats).
ssl_srv12_parse_supported_point_formats: fn<R: RNG>(ssl: &ssldefs.SSLContext, buf: Int, len: Int, rng: &R) ssldefs.SSLError! {
    if len == 0 || ssldefs.ssl_u8(ssl.in_buf, buf) + 1 != len {
        return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    }
    list_size: ssldefs.ssl_u8(ssl.in_buf, buf)
    loop i in 0..<list_size {
        f: ssldefs.ssl_u8(ssl.in_buf, buf + 1 + i)
        // MBEDTLS_ECP_PF_UNCOMPRESSED and MBEDTLS_ECP_PF_COMPRESSED.
        if f == 0 || f == 1 {
            fmt: if f == 0 -> ecp.PointFormat.Uncompressed else -> ecp.PointFormat.Compressed
            ssltls.ssl_ecdh_ready(ssl)
            if &ssl.handshake.ecdh_ctx == {
                .Val(ctx) -> ctx.point_format = fmt
                None -> {}
            }
            return
        }
    }
}

// max_fragment_length: a code we know (ssl_parse_max_fragment_length_ext).
ssl_srv12_parse_max_fragment_length_ext: fn<R: RNG>(ssl: &ssldefs.SSLContext, buf: Int, len: Int, rng: &R) ssldefs.SSLError! {
    if len != 1 || ssldefs.ssl_u8(ssl.in_buf, buf) >= ssldefs.SSL_MAX_FRAG_LEN_INVALID {
        return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_ILLEGAL_PARAMETER, .IllegalParameter, rng))
    }
    ssl.spool[ssl.session_negotiate].mfl_code = ssldefs.ssl_u8(ssl.in_buf, buf)
}

// connection_id: the client's CID, in DTLS only; ignored when we turned
// CIDs off (ssl_parse_cid_ext, RFC 9146 3).
ssl_srv12_parse_cid_ext: fn<R: RNG>(ssl: &ssldefs.SSLContext, buf: Int, len: Int, rng: &R) ssldefs.SSLError! {
    if ssl.conf.transport != ssldefs.SSL_TRANSPORT_DATAGRAM {
        return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_ILLEGAL_PARAMETER, .IllegalParameter, rng))
    }
    if len < 1 -> return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    peer_cid_len: ssldefs.ssl_u8(ssl.in_buf, buf)
    if len - 1 != peer_cid_len -> return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    // cid_in_use stays SSL_CID_DISABLED.
    if ssl.negotiate_cid == ssldefs.SSL_CID_DISABLED -> return
    if peer_cid_len > ssldefs.SSL_CID_OUT_LEN_MAX {
        return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_ILLEGAL_PARAMETER, .IllegalParameter, rng))
    }
    ssl.handshake.cid_in_use = ssldefs.SSL_CID_ENABLED
    ssl.handshake.peer_cid = ssldefs.ssl_bytes_of(ssl.in_buf, buf + 1, peer_cid_len)
}

// encrypt_then_mac: empty; taken when we allow it
// (ssl_parse_encrypt_then_mac_ext).
ssl_srv12_parse_encrypt_then_mac_ext: fn<R: RNG>(ssl: &ssldefs.SSLContext, len: Int, rng: &R) ssldefs.SSLError! {
    if len != 0 -> return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    if ssl.conf.encrypt_then_mac == ssldefs.SSL_ETM_ENABLED {
        ssl.spool[ssl.session_negotiate].encrypt_then_mac = ssldefs.SSL_ETM_ENABLED
    }
}

// extended_master_secret: empty; taken when we allow it
// (ssl_parse_extended_ms_ext).
ssl_srv12_parse_extended_ms_ext: fn<R: RNG>(ssl: &ssldefs.SSLContext, len: Int, rng: &R) ssldefs.SSLError! {
    if len != 0 -> return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    if ssl.conf.extended_ms == ssldefs.SSL_EXTENDED_MS_ENABLED {
        ssl.handshake.extended_ms = ssldefs.SSL_EXTENDED_MS_ENABLED
    }
}

// session_ticket: the client wants a ticket and may offer one to resume
// with. A ticket that does not open is ignored (ssl_parse_session_ticket_ext,
// RFC 5077 3.2).
ssl_srv12_parse_session_ticket_ext: fn(ssl: &ssldefs.SSLContext, buf: Int, len: Int) Never! {
    parse := if ssl.conf.f_ticket_parse == {
        .Val(cb) -> cb.call
        None -> return
    }
    if ssl.conf.f_ticket_write == None -> return
    // The client asked for a new ticket.
    ssl.handshake.new_session_ticket = 1
    if len == 0 -> return
    if ssl.renego_status != ssldefs.SSL_INITIAL_HANDSHAKE -> return
    // A ticket that is not authentic or has expired is ignored.
    session := if parse(ssldefs.ssl_bytes_of(ssl.in_buf, buf, len)) == {
        .Ok(s) -> s
        .Err(_) -> return
    }
    // Keep the session ID the client sent: echoing it back accepts the
    // ticket (RFC 5077 3.4).
    sn: ssl.session_negotiate
    session.id = ssl.spool[sn].id.copy()
    ssldefs.ssl_session_wipe(ssl.spool[sn])
    // The pool slot stays in use.
    session.valid = true
    ssl.spool[sn] = session
    ssl.handshake.resume = 1
    // This ticket is good: no new one.
    ssl.handshake.new_session_ticket = 0
}

// ---------------------------------------------------------------------------
// Choosing the ciphersuite and certificate.

// Whether the key's curve is one the client offered
// (ssl_check_key_curve, true where C returns 0).
ssl_srv12_check_key_curve: fn(key: pk.PKContext, curves_tls_id: [Int]?) -> Bool Never! {
    grp_id: pk.pk_get_ec_group_id(key)
    if curves_tls_id == {
        .Val(ids) -> {
            loop tls_id in ids {
                if ssltls.ssl_get_ecp_group_id_from_tls_id(tls_id) == grp_id -> return true
            }
        }
        None -> {}
    }
    false
}

// Whether an own certificate suits the ciphersuite: its key type, its key
// usage, and for ECDSA a curve the client offered. A certificate the client
// would reject for its (extended) key usage is not sent.
ssl_srv12_cert_suits: fn(ssl: ssldefs.SSLContext, kc: ssldefs.SSLKeyCert, cs: suites.SSLCiphersuite, pk_alg: oids.PKType) -> Bool Never! {
    if kc.cert.len() == 0 -> return false
    if !pk.pk_can_do(kc.cert[0].pk, pk_alg) -> return false
    flags := 0
    if !ssltls.ssl_check_cert_usage(kc.cert[0], Val(cs.copy()), ssldefs.SSL_IS_CLIENT, ssldefs.SSL_VERSION_TLS1_2, flags) -> return false
    if pk_alg == .ECDSA && !ssl_srv12_check_key_curve(kc.cert[0].pk, ssl.handshake.curves_tls_id) -> return false
    true
}

// Pick the first own certificate that suits the ciphersuite, from the SNI
// or certificate callback's list when it set one. The handshake's key_cert
// changes only when one suits (ssl_pick_cert, true where C returns 0).
ssl_srv12_pick_cert: fn(ssl: &ssldefs.SSLContext, cs: suites.SSLCiphersuite) -> Bool Never! {
    pk_alg: suites.ssl_get_ciphersuite_sig_pk_alg(cs) ?? return true
    from_sni: ssltls.ssl_key_cert_from_sni(ssl)
    count: if from_sni -> ssl.handshake.sni_key_cert.len() else -> ssl.conf.key_cert.len()
    loop i in 0..<count {
        suits: if from_sni -> ssl_srv12_cert_suits(ssl, ssl.handshake.sni_key_cert[i], cs, pk_alg) else -> ssl_srv12_cert_suits(ssl, ssl.conf.key_cert[i], cs, pk_alg)
        if suits {
            ssl.handshake.key_cert = i
            return true
        }
    }
    false
}

// Whether a ciphersuite suits the version, the client's curves, our PSK,
// our certificates and the client's signature algorithms; it, when it does
// (ssl_ciphersuite_match). Picking the certificate comes last, since it
// changes the handshake's key_cert.
ssl_srv12_ciphersuite_match: fn(ssl: &ssldefs.SSLContext, suite_id: Int) -> suites.SSLCiphersuite? ssldefs.SSLError! {
    cs: suites.ssl_ciphersuite_from_id(suite_id) ?? return Err(.InternalError)
    if cs.min_tls_version > ssl.tls_version || cs.max_tls_version < ssl.tls_version -> return Ok(None)
    if suites.ssl_ciphersuite_uses_ec(cs) {
        no_curve: if &ssl.handshake.curves_tls_id == {
            .Val(ids) -> ids.len() == 0
            None -> true
        }
        if no_curve -> return Ok(None)
    }
    if suites.ssl_ciphersuite_uses_psk(cs) && !ssl_srv12_conf_has_psk_or_cb(ssl.conf) -> return Ok(None)
    if !ssl_srv12_pick_cert(ssl, cs) -> return Ok(None)
    // A suite that signs needs a hash the client accepts with it.
    sig_type: suites.ssl_get_ciphersuite_sig_alg(cs)
    if sig_type != None && ssltls.ssl_tls12_get_preferred_hash_for_sig_alg(ssl, ssltls.ssl_sig_from_pk_alg(sig_type)) == ssldefs.SSL_HASH_NONE {
        return Ok(None)
    }
    Ok(Val(cs))
}

// ---------------------------------------------------------------------------
// ClientHello.

// The client's ClientHello: its version, random, session ID, DTLS cookie,
// extensions, then the ciphersuite (ssl_parse_client_hello). The
// ClientHello may have been read already by the TLS 1.3 code or as a
// renegotiation request, so the record is read without adding it to the
// transcript, and it is added here.
ssl_srv12_parse_client_hello: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    if sslmsg.ssl_read_record(ssl, false, rng) == {
        .Ok(_) -> {}
        .Err(e) -> {
            // A DTLS alert ending an earlier connection comes with a
            // non-zero epoch; C has long given UnexpectedMessage for it.
            if ssl.conf.transport == ssldefs.SSL_TRANSPORT_DATAGRAM && ssl.renego_status == ssldefs.SSL_INITIAL_HANDSHAKE {
                if e == {
                    .UnexpectedRecord -> return Err(.UnexpectedMessage)
                    else -> {}
                }
            }
            return Err(e)
        }
    }
    // Before the extensions: a session ticket may be opened in place.
    sslmsg.ssl_update_handshake_status(ssl)
    buf := ssl.in_msg
    msg_len := ssl.in_hslen
    if ssl.in_msgtype != ssldefs.SSL_MSG_HANDSHAKE || ssldefs.ssl_u8(ssl.in_buf, buf) != ssldefs.SSL_HS_CLIENT_HELLO {
        return Err(.UnexpectedMessage)
    }
    hdr: sslmsg.ssl_hs_hdr_len(ssl)
    buf += hdr
    msg_len -= hdr
    // The version, random, session ID length, an empty suite list and an
    // empty compression list: 2 + 32 + 1 + 2 + 1.
    if msg_len < 38 -> return Err(.DecodeError)
    ssl.tls_version = sslmsg.ssl_read_version(ssl.in_buf, buf, ssl.conf.transport)
    sn: ssl.session_negotiate
    ssl.spool[sn].tls_version = ssl.tls_version
    ssl.spool[sn].endpoint = ssl.conf.endpoint
    if ssl.tls_version != ssldefs.SSL_VERSION_TLS1_2 {
        return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_PROTOCOL_VERSION, .BadProtocolVersion, rng))
    }
    ssldefs.ssl_copy_into(ssl.handshake.randbytes, 0, ssl.in_buf, buf + 2, 32)
    sess_len: ssldefs.ssl_u8(ssl.in_buf, buf + 34)
    // 2 for the suite list length.
    if sess_len > 32 || sess_len + 34 + 2 > msg_len {
        return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    }
    ssl.spool[sn].id = ssldefs.ssl_bytes_of(ssl.in_buf, buf + 35, sess_len)
    ciph_offset := 35 + sess_len
    if ssl.conf.transport == ssldefs.SSL_TRANSPORT_DATAGRAM {
        cookie_offset: 35 + sess_len
        cookie_len: ssldefs.ssl_u8(ssl.in_buf, buf + cookie_offset)
        if cookie_offset + 1 + cookie_len + 2 > msg_len {
            return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
        }
        checked := false
        if ssl.renego_status == ssldefs.SSL_INITIAL_HANDSHAKE {
            if ssl.conf.f_cookie_check == {
                .Val(cb) -> {
                    checked = true
                    check: cb.call
                    cli_id: if &ssl.cli_id == {
                        .Val(id) -> id.copy()
                        None -> [U8]{}
                    }
                    valid: if check(ssldefs.ssl_bytes_of(ssl.in_buf, buf + cookie_offset + 1, cookie_len), cli_id) == {
                        .Ok(ok) -> ok
                        .Err(_) -> false
                    }
                    ssl.handshake.cookie_verify_result = if valid -> 0 else -> 1
                }
                None -> {}
            }
        }
        // We sent no cookie, so it should be empty; this may be an
        // attacker's probe, so no alert.
        if !checked && cookie_len != 0 -> return Err(.DecodeError)
        ciph_offset = cookie_offset + 1 + cookie_len
    }
    // The suite list, checked here and searched last.
    ciph_len: ssldefs.ssl_get_u16(ssl.in_buf, buf + ciph_offset)
    // 1 for the compression list length.
    if ciph_len < 2 || ciph_len + 2 + ciph_offset + 1 > msg_len || ciph_len % 2 != 0 {
        return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    }
    // The compression list's contents are ignored: null compression is
    // mandatory and the only one supported.
    comp_offset: ciph_offset + 2 + ciph_len
    comp_len: ssldefs.ssl_u8(ssl.in_buf, buf + comp_offset)
    if comp_len < 1 || comp_len > 16 || comp_len + comp_offset + 1 > msg_len {
        return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    }
    ext_offset: comp_offset + 1 + comp_len
    ext_len := 0
    if msg_len > ext_offset {
        if msg_len < ext_offset + 2 -> return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
        ext_len = ssldefs.ssl_get_u16(ssl.in_buf, buf + ext_offset)
        if msg_len != ext_offset + 2 + ext_len -> return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
    }
    ext := buf + ext_offset + 2
    renegotiation_info_seen := false
    sig_hash_alg_ext_present := false
    loop ext_len != 0 {
        if ext_len < 4 -> return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
        ext_id: ssldefs.ssl_get_u16(ssl.in_buf, ext)
        ext_size: ssldefs.ssl_get_u16(ssl.in_buf, ext + 2)
        if ext_size + 4 > ext_len -> return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_DECODE_ERROR, .DecodeError, rng))
        data: ext + 4
        if ext_id == ssldefs.TLS_EXT_SERVERNAME {
            ssltls.ssl_parse_server_name_ext(ssl, data, data + ext_size) ?? return Err(err)
        } else if ext_id == ssldefs.TLS_EXT_RENEGOTIATION_INFO {
            renegotiation_info_seen = true
            ssl_srv12_parse_renegotiation_info(ssl, data, ext_size, rng) ?? return Err(err)
        } else if ext_id == ssldefs.TLS_EXT_SIG_ALG {
            ssltls.ssl_parse_sig_alg_ext(ssl, data, data + ext_size) ?? return Err(err)
            sig_hash_alg_ext_present = true
        } else if ext_id == ssldefs.TLS_EXT_SUPPORTED_GROUPS {
            ssl_srv12_parse_supported_groups_ext(ssl, data, ext_size, rng) ?? return Err(err)
        } else if ext_id == ssldefs.TLS_EXT_SUPPORTED_POINT_FORMATS {
            ssl.handshake.cli_exts = ssl.handshake.cli_exts.bit_or(ssldefs.TLS_EXT_SUPPORTED_POINT_FORMATS_PRESENT)
            ssl_srv12_parse_supported_point_formats(ssl, data, ext_size, rng) ?? return Err(err)
        } else if ext_id == ssldefs.TLS_EXT_MAX_FRAGMENT_LENGTH {
            ssl_srv12_parse_max_fragment_length_ext(ssl, data, ext_size, rng) ?? return Err(err)
        } else if ext_id == ssldefs.TLS_EXT_CID {
            ssl_srv12_parse_cid_ext(ssl, data, ext_size, rng) ?? return Err(err)
        } else if ext_id == ssldefs.TLS_EXT_ENCRYPT_THEN_MAC {
            ssl_srv12_parse_encrypt_then_mac_ext(ssl, ext_size, rng) ?? return Err(err)
        } else if ext_id == ssldefs.TLS_EXT_EXTENDED_MASTER_SECRET {
            ssl_srv12_parse_extended_ms_ext(ssl, ext_size, rng) ?? return Err(err)
        } else if ext_id == ssldefs.TLS_EXT_SESSION_TICKET {
            ssl_srv12_parse_session_ticket_ext(ssl, data, ext_size)
        } else if ext_id == ssldefs.TLS_EXT_ALPN {
            ssltls.ssl_parse_alpn_ext(ssl, data, data + ext_size) ?? return Err(err)
        }
        // Others are ignored.
        ext_len -= 4 + ext_size
        ext += 4 + ext_size
    }
    // Without signature_algorithms the client takes SHA-1 (RFC 5246
    // 7.4.1.4.1).
    if !sig_hash_alg_ext_present {
        ssl.handshake.received_sig_algs = [Int]{
            ssltls.ssl_tls12_sig_and_hash_alg(ssldefs.SSL_SIG_ECDSA, ssldefs.SSL_HASH_SHA1),
            ssltls.ssl_tls12_sig_and_hash_alg(ssldefs.SSL_SIG_RSA, ssldefs.SSL_HASH_SHA1)
        }
    }
    // TLS_EMPTY_RENEGOTIATION_INFO_SCSV (RFC 5746 3.6).
    loop i in 0..<ciph_len /% 2 {
        p: buf + ciph_offset + 2 + 2 * i
        if ssldefs.ssl_u8(ssl.in_buf, p) == 0 && ssldefs.ssl_u8(ssl.in_buf, p + 1) == ssldefs.SSL_EMPTY_RENEGOTIATION_INFO {
            if ssl.renego_status == ssldefs.SSL_RENEGOTIATION_IN_PROGRESS {
                return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE, .HandshakeFailure, rng))
            }
            ssl.secure_renegotiation = ssldefs.SSL_SECURE_RENEGOTIATION
            break
        }
    }
    // Renegotiation security checks.
    in_progress: ssl.renego_status == ssldefs.SSL_RENEGOTIATION_IN_PROGRESS
    handshake_failure := false
    if ssl.secure_renegotiation != ssldefs.SSL_SECURE_RENEGOTIATION && ssl.conf.allow_legacy_renegotiation == ssldefs.SSL_LEGACY_BREAK_HANDSHAKE {
        handshake_failure = true
    } else if in_progress && ssl.secure_renegotiation == ssldefs.SSL_SECURE_RENEGOTIATION && !renegotiation_info_seen {
        handshake_failure = true
    } else if in_progress && ssl.secure_renegotiation == ssldefs.SSL_LEGACY_RENEGOTIATION && ssl.conf.allow_legacy_renegotiation == ssldefs.SSL_LEGACY_NO_RENEGOTIATION {
        handshake_failure = true
    } else if in_progress && ssl.secure_renegotiation == ssldefs.SSL_LEGACY_RENEGOTIATION && renegotiation_info_seen {
        handshake_failure = true
    }
    if handshake_failure -> return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE, .HandshakeFailure, rng))
    // The certificate selection callback, now that the extensions are in.
    if ssl.conf.f_cert_cb == {
        .Val(cb) -> {
            select: cb.call
            info: ssldefs.SSLClientHelloInfo{sni: ssl.handshake.sni_name.copy(), sig_algs: ssl.handshake.received_sig_algs.copy()}
            ov := select(info) ?? return Err(err)
            ssltls.ssl_apply_hs_override(ssl, ov)
        }
        None -> {}
    }
    ssl.handshake.sni_name = None
    // The ciphersuite comes last: it needs the EC extensions and the
    // certificate the SNI or certificate callback chose.
    ours: ssl.conf.ciphersuite_list.copy()
    chosen := suites.SSLCiphersuite?{None}
    chosen_id := 0
    if ssl.conf.respect_cli_pref == ssldefs.SSL_SRV_CIPHERSUITE_ORDER_CLIENT {
        loop j in 0..<ciph_len /% 2 {
            offered: ssldefs.ssl_get_u16(ssl.in_buf, buf + ciph_offset + 2 + 2 * j)
            loop id in ours {
                if offered != id -> next
                found := if ssl_srv12_ciphersuite_match(ssl, id) == {
                    .Ok(f) -> f
                    .Err(e) -> return Err(e)
                }
                if found != None {
                    chosen = found
                    chosen_id = id
                    break
                }
            }
            if chosen != None -> break
        }
    } else {
        loop id in ours {
            loop j in 0..<ciph_len /% 2 {
                if ssldefs.ssl_get_u16(ssl.in_buf, buf + ciph_offset + 2 + 2 * j) != id -> next
                found := if ssl_srv12_ciphersuite_match(ssl, id) == {
                    .Ok(f) -> f
                    .Err(e) -> return Err(e)
                }
                if found != None {
                    chosen = found
                    chosen_id = id
                    break
                }
            }
            if chosen != None -> break
        }
    }
    // Suites in common none of which suit, or none in common: C only logs
    // the difference, with the same alert and error either way.
    cs: chosen ?? return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE, .HandshakeFailure, rng))
    ssl.spool[sn].ciphersuite = chosen_id
    ssl.handshake.ciphersuite_info = Val(cs)
    sslmsg.ssl_handshake_increment_state(ssl)
    if ssl.conf.transport == ssldefs.SSL_TRANSPORT_DATAGRAM -> sslmsg.ssl_recv_flight_completed(ssl)
}

// ---------------------------------------------------------------------------
// ServerHello extensions. Each gives the length it wrote, 0 for none; the
// fixed-size ones fit in what the ServerHello leaves, as in C.

// connection_id: ours, when the client offered the extension and we use it
// (ssl_write_cid_ext).
ssl_srv12_write_cid_ext: fn(ssl: &ssldefs.SSLContext, p: Int) -> Int Never! {
    if ssl.handshake.cid_in_use == ssldefs.SSL_CID_DISABLED -> return 0
    cid_len: ssl.own_cid.len()
    if !ssltls.ssl_chk_buf_ptr(p, ssl.out_msg + ssldefs.SSL_OUT_CONTENT_LEN, cid_len + 5) -> return 0
    ssldefs.ssl_put_u16(ssl.out_buf, p, ssldefs.TLS_EXT_CID)
    ssldefs.ssl_put_u16(ssl.out_buf, p + 2, cid_len + 1)
    ssl.out_buf[p + 4] = ssldefs.ssl_byte(cid_len)
    ssldefs.ssl_copy_into(ssl.out_buf, p + 5, ssl.own_cid, 0, cid_len)
    cid_len + 5
}

// encrypt_then_mac: only for a CBC suite, which then uses it (RFC 7366 3:
// not for a stream or AEAD suite) (ssl_write_encrypt_then_mac_ext).
ssl_srv12_write_encrypt_then_mac_ext: fn(ssl: &ssldefs.SSLContext, p: Int) -> Int Never! {
    sn: ssl.session_negotiate
    if suites.ssl_ciphersuite_from_id(ssl.spool[sn].ciphersuite) == {
        .Val(suite) -> {
            if ssltls.ssl_get_mode_from_ciphersuite(ssl.spool[sn].encrypt_then_mac, suite) != .CBCETM {
                ssl.spool[sn].encrypt_then_mac = ssldefs.SSL_ETM_DISABLED
            }
        }
        None -> ssl.spool[sn].encrypt_then_mac = ssldefs.SSL_ETM_DISABLED
    }
    if ssl.spool[sn].encrypt_then_mac == ssldefs.SSL_ETM_DISABLED -> return 0
    ssldefs.ssl_put_u16(ssl.out_buf, p, ssldefs.TLS_EXT_ENCRYPT_THEN_MAC)
    ssldefs.ssl_put_u16(ssl.out_buf, p + 2, 0)
    4
}

// extended_master_secret, when both sides use it (ssl_write_extended_ms_ext).
ssl_srv12_write_extended_ms_ext: fn(ssl: &ssldefs.SSLContext, p: Int) -> Int Never! {
    if ssl.handshake.extended_ms == ssldefs.SSL_EXTENDED_MS_DISABLED -> return 0
    ssldefs.ssl_put_u16(ssl.out_buf, p, ssldefs.TLS_EXT_EXTENDED_MASTER_SECRET)
    ssldefs.ssl_put_u16(ssl.out_buf, p + 2, 0)
    4
}

// session_ticket, empty, when a NewSessionTicket will follow
// (ssl_write_session_ticket_ext).
ssl_srv12_write_session_ticket_ext: fn(ssl: &ssldefs.SSLContext, p: Int) -> Int Never! {
    if ssl.handshake.new_session_ticket == 0 -> return 0
    ssldefs.ssl_put_u16(ssl.out_buf, p, ssldefs.TLS_EXT_SESSION_TICKET)
    ssldefs.ssl_put_u16(ssl.out_buf, p + 2, 0)
    4
}

// renegotiation_info under secure renegotiation: empty in the initial
// handshake, both verify_data in a renegotiation (ssl_write_renegotiation_ext,
// RFC 5746 3.6, 3.7).
ssl_srv12_write_renegotiation_ext: fn(ssl: &ssldefs.SSLContext, p: Int) -> Int Never! {
    if ssl.secure_renegotiation != ssldefs.SSL_SECURE_RENEGOTIATION -> return 0
    ssldefs.ssl_put_u16(ssl.out_buf, p, ssldefs.TLS_EXT_RENEGOTIATION_INFO)
    if ssl.renego_status != ssldefs.SSL_INITIAL_HANDSHAKE {
        vdl: ssl.verify_data_len
        ssl.out_buf[p + 2] = U8{0}
        ssl.out_buf[p + 3] = ssldefs.ssl_byte(vdl * 2 + 1)
        ssl.out_buf[p + 4] = ssldefs.ssl_byte(vdl * 2)
        ssldefs.ssl_copy_into(ssl.out_buf, p + 5, ssl.peer_verify_data, 0, vdl)
        ssldefs.ssl_copy_into(ssl.out_buf, p + 5 + vdl, ssl.own_verify_data, 0, vdl)
        return 5 + 2 * vdl
    }
    ssl.out_buf[p + 2] = U8{0}
    ssl.out_buf[p + 3] = U8{1}
    ssl.out_buf[p + 4] = U8{0}
    5
}

// max_fragment_length: the client's code echoed (ssl_write_max_fragment_length_ext).
ssl_srv12_write_max_fragment_length_ext: fn(ssl: &ssldefs.SSLContext, p: Int) -> Int Never! {
    mfl: ssl.spool[ssl.session_negotiate].mfl_code
    if mfl == ssldefs.SSL_MAX_FRAG_LEN_NONE -> return 0
    ssldefs.ssl_put_u16(ssl.out_buf, p, ssldefs.TLS_EXT_MAX_FRAGMENT_LENGTH)
    ssldefs.ssl_put_u16(ssl.out_buf, p + 2, 1)
    ssl.out_buf[p + 4] = ssldefs.ssl_byte(mfl)
    5
}

// ec_point_formats: uncompressed only, when the client sent the extension
// (ssl_write_supported_point_formats_ext).
ssl_srv12_write_supported_point_formats_ext: fn(ssl: &ssldefs.SSLContext, p: Int) -> Int Never! {
    if ssl.handshake.cli_exts.bit_and(ssldefs.TLS_EXT_SUPPORTED_POINT_FORMATS_PRESENT) == 0 -> return 0
    ssldefs.ssl_put_u16(ssl.out_buf, p, ssldefs.TLS_EXT_SUPPORTED_POINT_FORMATS)
    ssldefs.ssl_put_u16(ssl.out_buf, p + 2, 2)
    ssl.out_buf[p + 4] = U8{1}
    // MBEDTLS_ECP_PF_UNCOMPRESSED.
    ssl.out_buf[p + 5] = U8{0}
    6
}

// ---------------------------------------------------------------------------
// HelloVerifyRequest and ServerHello.

// A DTLS HelloVerifyRequest with a cookie for the client's transport ID
// (ssl_write_hello_verify_request, RFC 6347 4.2.1). It sends the version
// negotiated, which the RFC leaves open but interoperates best.
ssl_srv12_write_hello_verify_request: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    p: ssl.out_msg + 4
    sslmsg.ssl_write_version(ssl.out_buf, p, ssl.conf.transport, ssl.tls_version)
    // f_cookie_check is set, or the cookie would not have failed.
    write := if ssl.conf.f_cookie_write == {
        .Val(cb) -> cb.call
        None -> return Err(.InternalError)
    }
    cli_id: if &ssl.cli_id == {
        .Val(id) -> id.copy()
        None -> [U8]{}
    }
    cookie := write(cli_id) ?? return Err(err)
    // The cookie writer is given the rest of out_buf.
    if !ssltls.ssl_chk_buf_ptr(p + 3, ssldefs.SSL_OUT_BUFFER_LEN, cookie.len()) -> return Err(.BufferTooSmall)
    ssl.out_buf[p + 2] = ssldefs.ssl_byte(cookie.len())
    ssldefs.ssl_copy_into(ssl.out_buf, p + 3, cookie, 0, cookie.len())
    ssl.out_msglen = p + 3 + cookie.len() - ssl.out_msg
    ssl.out_msgtype = ssldefs.SSL_MSG_HANDSHAKE
    ssl.out_buf[ssl.out_msg] = ssldefs.ssl_byte(ssldefs.SSL_HS_HELLO_VERIFY_REQUEST)
    sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_SERVER_HELLO_VERIFY_REQUEST_SENT)
    sslmsg.ssl_write_handshake_msg(ssl, rng) ?? return Err(err)
    if ssl.conf.transport == ssldefs.SSL_TRANSPORT_DATAGRAM -> sslmsg.ssl_flight_transmit(ssl, rng) ?? return Err(err)
}

// Resume the session the client's session ID names, if the cache has it
// with the ciphersuite just chosen (ssl_handle_id_based_session_resumption).
// A ticket may have resumed it already.
ssl_srv12_handle_id_based_session_resumption: fn(ssl: &ssldefs.SSLContext) Never! {
    if ssl.handshake.resume == 1 -> return
    sn: ssl.session_negotiate
    if ssl.spool[sn].id.len() == 0 -> return
    get := if ssl.conf.f_get_cache == {
        .Val(cb) -> cb.call
        None -> return
    }
    if ssl.renego_status != ssldefs.SSL_INITIAL_HANDSHAKE -> return
    cached := if get(ssl.spool[sn].id.copy()) == {
        .Ok(s) -> s
        .Err(_) -> return
    }
    if ssl.spool[sn].ciphersuite != cached.ciphersuite {
        // The cached session is not the one negotiated.
        ssldefs.ssl_session_wipe(cached)
        return
    }
    ssldefs.ssl_session_wipe(ssl.spool[sn])
    // The pool slot stays in use.
    cached.valid = true
    ssl.spool[sn] = cached
    ssl.handshake.resume = 1
}

// The ServerHello: version, random, session ID, ciphersuite, null
// compression and extensions, or a HelloVerifyRequest for a DTLS client
// whose cookie failed (ssl_write_server_hello). A new session gets a fresh
// session ID, or none when a ticket will be issued; a resumed one derives
// its keys and goes to ChangeCipherSpec.
ssl_srv12_write_server_hello: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    if ssl.conf.transport == ssldefs.SSL_TRANSPORT_DATAGRAM && ssl.handshake.cookie_verify_result != 0 {
        return ssl_srv12_write_hello_verify_request(ssl, rng)
    }
    buf: ssl.out_msg
    p := buf + 4
    sslmsg.ssl_write_version(ssl.out_buf, p, ssl.conf.transport, ssl.tls_version)
    p += 2
    // The time, then 28 random bytes, the last 8 of them the TLS 1.3
    // downgrade marker when TLS 1.3 is enabled (RFC 8446 4.1.3).
    ssldefs.ssl_put_u32(ssl.out_buf, p, ssldefs.ssl_time())
    p += 4
    tls13: ssltls.ssl_conf_is_tls13_enabled(ssl.conf)
    random := ssldefs.ssl_zeros(if tls13 -> 20 else -> 28)
    if !rng.fill(random) -> return Err(.RandomFailed)
    ssldefs.ssl_copy_into(ssl.out_buf, p, random, 0, random.len())
    p += random.len()
    if tls13 {
        ssldefs.ssl_copy_into(ssl.out_buf, p, "DOWNGRD".bytes(), 0, 7)
        ssl.out_buf[p + 7] = U8{1}
        p += 8
    }
    ssldefs.ssl_copy_into(ssl.handshake.randbytes, 32, ssl.out_buf, buf + 6, 32)
    ssl_srv12_handle_id_based_session_resumption(ssl)
    sn: ssl.session_negotiate
    if ssl.handshake.resume == 0 {
        sslmsg.ssl_handshake_increment_state(ssl)
        ssl.spool[sn].start = ssldefs.ssl_time()
        if ssl.handshake.new_session_ticket != 0 {
            ssl.spool[sn].id = [U8]{}
        } else {
            id := ssldefs.ssl_zeros(32)
            if !rng.fill(id) -> return Err(.RandomFailed)
            ssl.spool[sn].id = id
        }
    } else {
        sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_SERVER_CHANGE_CIPHER_SPEC)
        ssltls.ssl_derive_keys(ssl) ?? return Err(err)
    }
    id_len: ssl.spool[sn].id.len()
    ssl.out_buf[p] = ssldefs.ssl_byte(id_len)
    ssldefs.ssl_copy_into(ssl.out_buf, p + 1, ssl.spool[sn].id, 0, id_len)
    p += 1 + id_len
    ssldefs.ssl_put_u16(ssl.out_buf, p, ssl.spool[sn].ciphersuite)
    ssl.out_buf[p + 2] = ssldefs.ssl_byte(ssldefs.SSL_COMPRESS_NULL)
    p += 3
    // The extensions, then their length.
    ext_len := 0
    ext_len += ssl_srv12_write_renegotiation_ext(ssl, p + 2 + ext_len)
    ext_len += ssl_srv12_write_max_fragment_length_ext(ssl, p + 2 + ext_len)
    ext_len += ssl_srv12_write_cid_ext(ssl, p + 2 + ext_len)
    ext_len += ssl_srv12_write_encrypt_then_mac_ext(ssl, p + 2 + ext_len)
    ext_len += ssl_srv12_write_extended_ms_ext(ssl, p + 2 + ext_len)
    ext_len += ssl_srv12_write_session_ticket_ext(ssl, p + 2 + ext_len)
    if suites.ssl_ciphersuite_from_id(ssl.spool[sn].ciphersuite) == {
        .Val(suite) -> {
            if suites.ssl_ciphersuite_uses_ec(suite) -> ext_len += ssl_srv12_write_supported_point_formats_ext(ssl, p + 2 + ext_len)
        }
        None -> {}
    }
    ext_len += ssltls.ssl_write_alpn_ext(ssl, p + 2 + ext_len, buf + ssldefs.SSL_OUT_CONTENT_LEN - 4) ?? return Err(err)
    if ext_len > 0 {
        ssldefs.ssl_put_u16(ssl.out_buf, p, ext_len)
        p += 2 + ext_len
    }
    ssl.out_msglen = p - buf
    ssl.out_msgtype = ssldefs.SSL_MSG_HANDSHAKE
    ssl.out_buf[buf] = ssldefs.ssl_byte(ssldefs.SSL_HS_SERVER_HELLO)
    sslmsg.ssl_write_handshake_msg(ssl, rng) ?? return Err(err)
}

// ---------------------------------------------------------------------------
// CertificateRequest.

// The subject DNs of a certificate list, in order, up to an empty entry.
ssl_srv12_subjects: fn(chain: &[x509crt.X509Crt]) -> [[U8]] Never! {
    out := [[U8]]{}
    loop i in 0..<chain.len() {
        if chain[i].version == 0 -> break
        out.push(ssldefs.ssl_bytes_of(chain[i].raw, chain[i].subject_raw.p, chain[i].subject_raw.len))
    }
    out
}

// The CAs a CertificateRequest names: the DN hints the certificate
// callback or configuration set, else the CA chain the SNI callback or
// configuration set.
ssl_srv12_ca_subjects: fn(ssl: &ssldefs.SSLContext) -> [[U8]] Never! {
    if &ssl.handshake.dn_hints == {
        .Val(chain) -> return ssl_srv12_subjects(chain)
        None -> {}
    }
    if &ssl.conf.dn_hints == {
        .Val(chain) -> return ssl_srv12_subjects(chain)
        None -> {}
    }
    if &ssl.handshake.sni_ca_chain == {
        .Val(chain) -> return ssl_srv12_subjects(chain)
        None -> {}
    }
    if &ssl.conf.ca_chain == {
        .Val(chain) -> return ssl_srv12_subjects(chain)
        None -> {}
    }
    [[U8]]{}
}

// Ask for the client's certificate, unless the ciphersuite or authmode
// does without: the certificate types, the signature algorithms we would
// verify with, and the CAs we trust while they fit
// (ssl_write_certificate_request, RFC 5246 7.4.4).
ssl_srv12_write_certificate_request: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    cs: ssl.handshake.ciphersuite_info ?? return Err(.InternalError)
    sslmsg.ssl_handshake_increment_state(ssl)
    authmode: if ssl.handshake.sni_authmode != ssldefs.SSL_VERIFY_UNSET -> ssl.handshake.sni_authmode else -> ssl.conf.authmode
    if !suites.ssl_ciphersuite_cert_req_allowed(cs) || authmode == ssldefs.SSL_VERIFY_NONE -> return
    buf: ssl.out_msg
    end: buf + ssldefs.SSL_OUT_CONTENT_LEN
    p := buf + 4
    // certificate_types: RSA and ECDSA signing.
    ssl.out_buf[p] = U8{2}
    ssl.out_buf[p + 1] = ssldefs.ssl_byte(ssldefs.SSL_CERT_TYPE_RSA_SIGN)
    ssl.out_buf[p + 2] = ssldefs.ssl_byte(ssldefs.SSL_CERT_TYPE_ECDSA_SIGN)
    ct_len: 3
    p += ct_len
    // supported_signature_algorithms: each configured one with a hash
    // calc_verify can take; the last such hash is the one it takes.
    sig_algs: ssltls.ssl_get_sig_algs(ssl)
    if sig_algs.len() == 0 -> return Err(.BadConfig)
    sa_len := 0
    loop sig_alg in sig_algs {
        if !ssltls.ssl_set_calc_verify_md(ssl, (sig_alg >> 8).bit_and(0xFF)) -> next
        if !ssltls.ssl_sig_alg_is_supported(ssl, sig_alg) -> next
        sa_len += 2
        ssldefs.ssl_put_u16(ssl.out_buf, p + sa_len, sig_alg)
    }
    ssldefs.ssl_put_u16(ssl.out_buf, p, sa_len)
    sa_len += 2
    p += sa_len
    // certificate_authorities, after its length.
    p += 2
    total_dn_size := 0
    if ssl.conf.cert_req_ca_list == ssldefs.SSL_CERT_REQ_CA_LIST_ENABLED {
        loop dn in ssl_srv12_ca_subjects(ssl) {
            if !ssltls.ssl_chk_buf_ptr(p, end, 2 + dn.len()) -> break
            ssldefs.ssl_put_u16(ssl.out_buf, p, dn.len())
            ssldefs.ssl_copy_into(ssl.out_buf, p + 2, dn, 0, dn.len())
            p += 2 + dn.len()
            total_dn_size += 2 + dn.len()
        }
    }
    ssl.out_msglen = p - buf
    ssl.out_msgtype = ssldefs.SSL_MSG_HANDSHAKE
    ssl.out_buf[buf] = ssldefs.ssl_byte(ssldefs.SSL_HS_CERTIFICATE_REQUEST)
    ssldefs.ssl_put_u16(ssl.out_buf, buf + 4 + ct_len + sa_len, total_dn_size)
    sslmsg.ssl_write_handshake_msg(ssl, rng) ?? return Err(err)
}

// ---------------------------------------------------------------------------
// ServerKeyExchange and ServerHelloDone.

// The static ECDH key of an ECDH_RSA or ECDH_ECDSA suite, from our own
// certificate's key (ssl_get_ecdh_params_from_cert).
ssl_srv12_get_ecdh_params_from_cert: fn(ssl: &ssldefs.SSLContext) ssldefs.SSLError! {
    i: ssltls.ssl_own_key_cert(ssl)
    if i < 0 -> return Err(.PrivateKeyRequired)
    if !ssltls.ssl_own_pk_can_do(ssl, .ECKey) -> return Err(.PKTypeMismatch)
    // The handshake's ECDH context is unused until here on this side; the
    // key is set up in a fresh one, then installed.
    ctx := ecdh.ecdh_new()
    failure := if ssltls.ssl_own_key_cert_is_hs(ssl) -> ssltls.ssl_ecdh_get_params_failure(ctx, ssl.handshake.sni_key_cert[i].key.ec, .Ours) else -> ssltls.ssl_ecdh_get_params_failure(ctx, ssl.conf.key_cert[i].key.ec, .Ours)
    ssl.handshake.ecdh_ctx = Val(ctx)
    if failure == {
        .Val(e) -> return Err(.ECP(e))
        None -> {}
    }
}

// Give a DHM context the configured group (mbedtls_dhm_set_group on
// conf->dhm_P and dhm_G).
ssl_srv12_dhm_set_group: fn(ctx: &dhm.DHMContext, conf: ssldefs.SSLConfig) ssldefs.SSLError! {
    if conf.dhm_p == {
        .Val(p) -> {
            if conf.dhm_g == {
                .Val(g) -> dhm.dhm_set_group(ctx, p, g) ?? return Err(.DHM(err))
                None -> return Err(.BadInputData)
            }
        }
        None -> return Err(.BadInputData)
    }
}

// Lay out the ServerKeyExchange after its header: an empty PSK identity
// hint for DHE-PSK and ECDHE-PSK (RFC 4279 3), our DH or ECDH parameters,
// and, for a suite that signs them, the algorithm and the signature, whose
// length is left for the caller to write. The signature's length, 0 for
// none (ssl_prepare_server_key_exchange).
ssl_srv12_prepare_server_key_exchange: fn<R: RNG>(ssl: &ssldefs.SSLContext, cs: suites.SSLCiphersuite, rng: &R) -> Int ssldefs.SSLError! {
    msg: ssl.out_msg
    // The header, type and length, is written later.
    ssl.out_msglen = 4
    dig_signed := -1
    if cs.key_exchange == .DHEPSK || cs.key_exchange == .ECDHEPSK {
        ssl.out_buf[msg + 4] = U8{0}
        ssl.out_buf[msg + 5] = U8{0}
        ssl.out_msglen += 2
    }
    if suites.ssl_ciphersuite_uses_dhe(cs) {
        // ServerDHParams: dh_p, dh_g, dh_Ys.
        if ssl.conf.dhm_p == None || ssl.conf.dhm_g == None -> return Err(.BadInputData)
        ssltls.ssl_dhm_ready(ssl)
        params := if &ssl.handshake.dhm_ctx == {
            .Val(ctx) -> {
                ssl_srv12_dhm_set_group(ctx, ssl.conf) ?? return Err(err)
                x_size: dhm.dhm_get_len(ctx)
                dhm.dhm_make_params(ctx, x_size, rng) ?? return Err(.DHM(err))
            }
            None -> return Err(.InternalError)
        }
        if !ssltls.ssl_chk_buf_ptr(msg + ssl.out_msglen, msg + ssldefs.SSL_OUT_CONTENT_LEN, params.len()) -> return Err(.BufferTooSmall)
        dig_signed = msg + ssl.out_msglen
        ssldefs.ssl_copy_into(ssl.out_buf, dig_signed, params, 0, params.len())
        ssl.out_msglen += params.len()
    }
    if suites.ssl_ciphersuite_uses_ecdhe(cs) {
        // ServerECDHParams: the curve, ours that the client offered first
        // in our order, and our public point.
        offered: ssl.handshake.curves_tls_id ?? return Err(.BadConfig)
        ours: ssltls.ssl_get_groups(ssl)
        if ours.len() == 0 -> return Err(.BadConfig)
        chosen := 0
        loop g in ours {
            loop o in offered {
                if o == g {
                    chosen = g
                    break
                }
            }
            if chosen != 0 -> break
        }
        if chosen == 0 -> return Err(.HandshakeFailure)
        ssltls.ssl_ecdh_ready(ssl)
        params := if &ssl.handshake.ecdh_ctx == {
            .Val(ctx) -> {
                ecdh.ecdh_setup(ctx, ssltls.ssl_get_ecp_group_id_from_tls_id(chosen)) ?? return Err(.ECP(err))
                ecdh.ecdh_make_params(ctx, ssldefs.SSL_OUT_CONTENT_LEN - ssl.out_msglen, rng) ?? return Err(.ECP(err))
            }
            None -> return Err(.InternalError)
        }
        dig_signed = msg + ssl.out_msglen
        ssldefs.ssl_copy_into(ssl.out_buf, dig_signed, params, 0, params.len())
        ssl.out_msglen += params.len()
    }
    if !suites.ssl_ciphersuite_uses_server_signature(cs) -> return Ok(0)
    if dig_signed < 0 -> return Err(.InternalError)
    dig_signed_len: msg + ssl.out_msglen - dig_signed
    // The hash the client's signature_algorithms prefer with our key's
    // algorithm (RFC 5246 7.4.1.4.1); the ciphersuite was chosen only if
    // there is one.
    sig_alg: suites.ssl_get_ciphersuite_sig_pk_alg(cs)
    if sig_alg == None -> return Err(.InternalError)
    sig_hash: ssltls.ssl_tls12_get_preferred_hash_for_sig_alg(ssl, ssltls.ssl_sig_from_pk_alg(sig_alg))
    md: ssltls.ssl_md_alg_from_hash(sig_hash) ?? return Err(.InternalError)
    hash: ssltls.ssl_get_key_exchange_md_tls1_2(ssl, ssl.out_buf, dig_signed, dig_signed_len, md)
    // DigitallySigned: the SignatureAndHashAlgorithm, then the signature.
    ssl.out_buf[msg + ssl.out_msglen] = ssldefs.ssl_byte(ssltls.ssl_hash_from_md_alg(Val(md)))
    ssl.out_buf[msg + ssl.out_msglen + 1] = ssldefs.ssl_byte(ssltls.ssl_sig_from_pk_alg(sig_alg))
    ssl.out_msglen += 2
    if ssltls.ssl_own_key_cert(ssl) < 0 -> return Err(.PrivateKeyRequired)
    // After the 2 bytes of its length.
    room: ssldefs.SSL_OUT_BUFFER_LEN - msg - ssl.out_msglen - 2
    sig := ssltls.ssl_own_key_sign(ssl, Val(md), hash, room, rng) ?? return Err(.PK(err))
    if sig.len() > room -> return Err(.BufferTooSmall)
    ssldefs.ssl_copy_into(ssl.out_buf, msg + ssl.out_msglen + 2, sig, 0, sig.len())
    Ok(sig.len())
}

// Send the ServerKeyExchange the key exchange needs; a suite without
// ephemeral keys sends none, and a static ECDH one takes its key from our
// certificate (ssl_write_server_key_exchange).
ssl_srv12_write_server_key_exchange: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    cs: ssl.handshake.ciphersuite_info ?? return Err(.InternalError)
    if suites.ssl_ciphersuite_no_pfs(cs) {
        if suites.ssl_ciphersuite_uses_ecdh(cs) -> ssl_srv12_get_ecdh_params_from_cert(ssl) ?? return Err(err)
        sslmsg.ssl_handshake_increment_state(ssl)
        return
    }
    signature_len := if ssl_srv12_prepare_server_key_exchange(ssl, cs, rng) == {
        .Ok(n) -> n
        .Err(e) -> {
            ssl.out_msglen = 0
            return Err(e)
        }
    }
    // The signature is in place after the 2 bytes of its length.
    if signature_len != 0 {
        ssldefs.ssl_put_u16(ssl.out_buf, ssl.out_msg + ssl.out_msglen, signature_len)
        ssl.out_msglen += 2 + signature_len
    }
    ssl.out_msgtype = ssldefs.SSL_MSG_HANDSHAKE
    ssl.out_buf[ssl.out_msg] = ssldefs.ssl_byte(ssldefs.SSL_HS_SERVER_KEY_EXCHANGE)
    sslmsg.ssl_handshake_increment_state(ssl)
    sslmsg.ssl_write_handshake_msg(ssl, rng) ?? return Err(err)
}

// The empty ServerHelloDone, which ends our DTLS flight
// (ssl_write_server_hello_done).
ssl_srv12_write_server_hello_done: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    ssl.out_msglen = 4
    ssl.out_msgtype = ssldefs.SSL_MSG_HANDSHAKE
    ssl.out_buf[ssl.out_msg] = ssldefs.ssl_byte(ssldefs.SSL_HS_SERVER_HELLO_DONE)
    sslmsg.ssl_handshake_increment_state(ssl)
    dtls: ssl.conf.transport == ssldefs.SSL_TRANSPORT_DATAGRAM
    if dtls -> sslmsg.ssl_send_flight_completed(ssl)
    sslmsg.ssl_write_handshake_msg(ssl, rng) ?? return Err(err)
    if dtls -> sslmsg.ssl_flight_transmit(ssl, rng) ?? return Err(err)
}

// ---------------------------------------------------------------------------
// ClientKeyExchange.

// The client's DH public value G^Y, into the DHM context
// (ssl_parse_client_dh_public).
ssl_srv12_parse_client_dh_public: fn(ssl: &ssldefs.SSLContext, p: &Int, end: Int) ssldefs.SSLError! {
    if p + 2 > end -> return Err(.DecodeError)
    n: ssldefs.ssl_get_u16(ssl.in_buf, p)
    p += 2
    if p + n > end -> return Err(.DecodeError)
    input: ssldefs.ssl_bytes_of(ssl.in_buf, p, n)
    if &ssl.handshake.dhm_ctx == {
        .Val(ctx) -> dhm.dhm_read_public(ctx, input) ?? return Err(.DecodeError)
        None -> return Err(.InternalError)
    }
    p += n
}

// Decrypt the RSA-encrypted premaster secret with our key to 48 bytes, with
// implicit rejection: `bad`, not an Err, when it does not decrypt to 48
// bytes (ssl_decrypt_encrypted_pms). The encrypted value's length must be
// the key's.
ssl_srv12_decrypt_encrypted_pms: fn<R: RNG>(ssl: &ssldefs.SSLContext, p: Int, end: Int, rng: &R) -> rsa.V15Fixed ssldefs.SSLError! {
    len: ssltls.ssl_own_cert_pk_len(ssl)
    if len < 0 -> return Err(.NoClientCertificate)
    if p + 2 > end -> return Err(.DecodeError)
    if ssldefs.ssl_get_u16(ssl.in_buf, p) != len -> return Err(.DecodeError)
    if p + 2 + len != end -> return Err(.DecodeError)
    if !ssltls.ssl_own_pk_can_do(ssl, .RSA) -> return Err(.PrivateKeyRequired)
    input: ssldefs.ssl_bytes_of(ssl.in_buf, p + 2, len)
    fixed: ssltls.ssl_own_key_decrypt_fixed(ssl, input, 48, rng) ?? return Err(.PK(err))
    Ok(fixed)
}

// The RSA-encrypted premaster secret, into premaster at pms_offset
// (ssl_parse_encrypted_pms). Against Bleichenbacher's attack and its
// timing forms (Marvin), a message that does not decrypt to 48 bytes with
// our version does not end the handshake: a random premaster secret takes
// its place, chosen without a branch on the outcome, and the Finished check
// fails later. The decryption reports the padding's verdict as a CtCond, so
// nothing branches on it; only public failures (a malformed message, no
// RSA key) take the Err arm.
ssl_srv12_parse_encrypted_pms: fn<R: RNG>(ssl: &ssldefs.SSLContext, p: Int, end: Int, pms_offset: Int, rng: &R) ssldefs.SSLError! {
    peer_pms := ssldefs.ssl_zeros(48)
    failed := ctime.ct_true()
    if ssl_srv12_decrypt_encrypted_pms(ssl, p, end, rng) == {
        .Ok(fixed) -> {
            peer_pms = fixed.out
            failed = fixed.bad
        }
        .Err(_) -> {}
    }
    ver := ssldefs.ssl_zeros(2)
    sslmsg.ssl_write_version(ver, 0, ssl.conf.transport, ssl.spool[ssl.session_negotiate].tls_version)
    diff := failed
    diff = ctime.bool_or(diff, ctime.uint_ne(U64{peer_pms[0]}, U64{ver[0]}))
    diff = ctime.bool_or(diff, ctime.uint_ne(U64{peer_pms[1]}, U64{ver[1]}))
    // Always made, whether or not it is used; an RNG failure reveals
    // nothing of the decryption.
    fake_pms := ssldefs.ssl_zeros(48)
    if !rng.fill(fake_pms) {
        ssldefs.ssl_wipe(peer_pms)
        return Err(.RandomFailed)
    }
    if ssl.handshake.premaster.len() < pms_offset + 48 {
        ssldefs.ssl_wipe(peer_pms)
        ssldefs.ssl_wipe(fake_pms)
        return Err(.InternalError)
    }
    ssl.handshake.pmslen = 48
    ctime.memcpy_if_else(diff, ssl.handshake.premaster, pms_offset, fake_pms, 0, peer_pms, 0, 48)
    ssldefs.ssl_wipe(peer_pms)
    ssldefs.ssl_wipe(fake_pms)
}

// Whether we know the client's PSK identity: the PSK callback picks the
// key for it, else it must be the configured identity, compared in
// constant time.
ssl_srv12_psk_identity_known: fn(ssl: &ssldefs.SSLContext, identity: [U8]) -> Bool Never! {
    if ssl.conf.f_psk != None {
        lookup := if ssl.conf.f_psk == {
            .Val(cb) -> cb.call
            None -> return false
        }
        found := if lookup(identity) == {
            .Ok(r) -> r
            .Err(_) -> return false
        }
        key: found.psk ?? return false
        return if ssltls.ssl_set_hs_psk(ssl, key) == {
            .Ok(_) -> true
            .Err(_) -> false
        }
    }
    ours: ssl.conf.psk_identity ?? return false
    ours.len() == identity.len() && ctime.memcmp(ours, 0, identity, 0, identity.len()) == 0
}

// The client's PSK identity, which we must know
// (ssl_parse_client_psk_identity).
ssl_srv12_parse_client_psk_identity: fn<R: RNG>(ssl: &ssldefs.SSLContext, p: &Int, end: Int, rng: &R) ssldefs.SSLError! {
    if !ssl_srv12_conf_has_psk_or_cb(ssl.conf) -> return Err(.PrivateKeyRequired)
    if end - p < 2 -> return Err(.DecodeError)
    n: ssldefs.ssl_get_u16(ssl.in_buf, p)
    p += 2
    if n == 0 || n > end - p -> return Err(.DecodeError)
    identity: ssldefs.ssl_bytes_of(ssl.in_buf, p, n)
    if !ssl_srv12_psk_identity_known(ssl, identity) {
        return Err(ssl_srv12_fail(ssl, ssldefs.SSL_ALERT_MSG_UNKNOWN_PSK_IDENTITY, .UnknownIdentity, rng))
    }
    p += n
}

// Read the ClientKeyExchange and derive the premaster secret, then the
// keys (ssl_parse_client_key_exchange, RFC 5246 7.4.7, RFC 4279 2,
// RFC 4492 5.7). A DH or ECDH value that does not read or compute is a
// DecodeError.
ssl_srv12_parse_client_key_exchange: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    cs: ssl.handshake.ciphersuite_info ?? return Err(.InternalError)
    kx: cs.key_exchange
    sslmsg.ssl_read_record(ssl, true, rng) ?? return Err(err)
    p := ssl.in_msg + sslmsg.ssl_hs_hdr_len(ssl)
    end: ssl.in_msg + ssl.in_hslen
    if ssl.in_msgtype != ssldefs.SSL_MSG_HANDSHAKE -> return Err(.UnexpectedMessage)
    if ssldefs.ssl_u8(ssl.in_buf, ssl.in_msg) != ssldefs.SSL_HS_CLIENT_KEY_EXCHANGE -> return Err(.UnexpectedMessage)
    if kx == {
        .DHERSA -> {
            ssl_srv12_parse_client_dh_public(ssl, p, end) ?? return Err(err)
            if p != end -> return Err(.DecodeError)
            secret := if &ssl.handshake.dhm_ctx == {
                .Val(ctx) -> {
                    // The premaster buffer must hold a value as long as p.
                    if dhm.dhm_get_len(ctx) > ssldefs.SSL_PREMASTER_SIZE -> return Err(.DecodeError)
                    dhm.dhm_calc_secret(ctx, rng) ?? return Err(.DecodeError)
                }
                None -> return Err(.InternalError)
            }
            ssltls.ssl_set_premaster(ssl, secret)
        }
        .ECDHERSA | .ECDHEECDSA | .ECDHRSA | .ECDHECDSA -> {
            secret := if &ssl.handshake.ecdh_ctx == {
                .Val(ctx) -> {
                    ecdh.ecdh_read_public(ctx, ssldefs.ssl_bytes_of(ssl.in_buf, p, end - p)) ?? return Err(.DecodeError)
                    ecdh.ecdh_calc_secret(ctx, ssldefs.SSL_PREMASTER_SIZE, rng) ?? return Err(.DecodeError)
                }
                None -> return Err(.InternalError)
            }
            ssltls.ssl_set_premaster(ssl, secret)
        }
        .PSK -> {
            ssl_srv12_parse_client_psk_identity(ssl, p, end, rng) ?? return Err(err)
            if p != end -> return Err(.DecodeError)
            ssltls.ssl_psk_derive_premaster(ssl, kx, rng) ?? return Err(err)
        }
        .RSAPSK -> {
            ssl_srv12_parse_client_psk_identity(ssl, p, end, rng) ?? return Err(err)
            ssl_srv12_parse_encrypted_pms(ssl, p, end, 2, rng) ?? return Err(err)
            ssltls.ssl_psk_derive_premaster(ssl, kx, rng) ?? return Err(err)
        }
        .DHEPSK -> {
            ssl_srv12_parse_client_psk_identity(ssl, p, end, rng) ?? return Err(err)
            ssl_srv12_parse_client_dh_public(ssl, p, end) ?? return Err(err)
            if p != end -> return Err(.DecodeError)
            ssltls.ssl_psk_derive_premaster(ssl, kx, rng) ?? return Err(err)
        }
        .ECDHEPSK -> {
            ssl_srv12_parse_client_psk_identity(ssl, p, end, rng) ?? return Err(err)
            if &ssl.handshake.ecdh_ctx == {
                .Val(ctx) -> ecdh.ecdh_read_public(ctx, ssldefs.ssl_bytes_of(ssl.in_buf, p, end - p)) ?? return Err(.DecodeError)
                None -> return Err(.InternalError)
            }
            ssltls.ssl_psk_derive_premaster(ssl, kx, rng) ?? return Err(err)
        }
        .RSA -> ssl_srv12_parse_encrypted_pms(ssl, p, end, 0, rng) ?? return Err(err)
        else -> return Err(.InternalError)
    }
    ssltls.ssl_derive_keys(ssl) ?? return Err(err)
    sslmsg.ssl_handshake_increment_state(ssl)
}

// ---------------------------------------------------------------------------
// CertificateVerify, NewSessionTicket and the state machine.

// Verify a signature with the client's key; the failure, None when it
// verifies.
ssl_srv12_verify_signature: fn(key: &pk.PKContext, md: hashes.Md, hash: [U8], sig: [U8]) -> pk.PKError? Never! {
    if pk.pk_verify(key, Val(md), hash, sig) == {
        .Ok(_) -> None
        .Err(e) -> Val(e)
    }
}

// The client's CertificateVerify, when it sent a certificate: its
// signature over the transcript up to it, which is added to the
// transcript only after (ssl_parse_certificate_verify, RFC 5246 7.4.8).
ssl_srv12_parse_certificate_verify: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    cs: ssl.handshake.ciphersuite_info ?? return Err(.InternalError)
    if !suites.ssl_ciphersuite_cert_req_allowed(cs) || !ssltls.ssl_has_peer_cert(ssl) {
        sslmsg.ssl_handshake_increment_state(ssl)
        return
    }
    sslmsg.ssl_read_record(ssl, false, rng) ?? return Err(err)
    sslmsg.ssl_handshake_increment_state(ssl)
    msg: ssl.in_msg
    if ssl.in_msgtype != ssldefs.SSL_MSG_HANDSHAKE || ssldefs.ssl_u8(ssl.in_buf, msg) != ssldefs.SSL_HS_CERTIFICATE_VERIFY {
        return Err(.UnexpectedMessage)
    }
    i := sslmsg.ssl_hs_hdr_len(ssl)
    // DigitallySigned: the SignatureAndHashAlgorithm, then the signature.
    if i + 2 > ssl.in_hslen -> return Err(.DecodeError)
    hash_alg: ssldefs.ssl_u8(ssl.in_buf, msg + i)
    md: ssltls.ssl_md_alg_from_hash(hash_alg) ?? return Err(.IllegalParameter)
    if !ssltls.ssl_set_calc_verify_md(ssl, hash_alg) -> return Err(.IllegalParameter)
    i += 1
    pk_alg: ssltls.ssl_pk_alg_from_sig(ssldefs.ssl_u8(ssl.in_buf, msg + i)) ?? return Err(.IllegalParameter)
    // The signature algorithm must be the certificate key's.
    if !ssltls.ssl_peer_pk_can_do(ssl, pk_alg) -> return Err(.IllegalParameter)
    i += 1
    if i + 2 > ssl.in_hslen -> return Err(.DecodeError)
    sig_len: ssldefs.ssl_get_u16(ssl.in_buf, msg + i)
    i += 2
    if i + sig_len != ssl.in_hslen -> return Err(.DecodeError)
    hash := ssltls.ssl_calc_verify(ssl) ?? return Err(err)
    sig: ssldefs.ssl_bytes_of(ssl.in_buf, msg + i, sig_len)
    sn: ssl.session_negotiate
    failure := if &ssl.spool[sn].peer_cert == {
        .Val(chain) -> ssl_srv12_verify_signature(chain[0].pk, md, hash, sig)
        None -> return Err(.InternalError)
    }
    if failure == {
        .Val(e) -> return Err(.PK(e))
        None -> {}
    }
    sslmsg.ssl_update_handshake_status(ssl)
}

// A NewSessionTicket with the ticket the ticket writer makes of the
// session; a writer that fails gives an empty ticket
// (ssl_write_new_session_ticket, RFC 5077 3.3). It shares its state with
// ChangeCipherSpec, so the flag records that it was sent.
ssl_srv12_write_new_session_ticket: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    msg: ssl.out_msg
    ssl.out_msgtype = ssldefs.SSL_MSG_HANDSHAKE
    ssl.out_buf[msg] = ssldefs.ssl_byte(ssldefs.SSL_HS_NEW_SESSION_TICKET)
    sn: ssl.session_negotiate
    ssl.spool[sn].ticket_creation_time = ssldefs.ssl_ms_time()
    // The flag is set only with a ticket writer.
    write := if ssl.conf.f_ticket_write == {
        .Val(cb) -> cb.call
        None -> return Err(.InternalError)
    }
    tlen := 0
    lifetime := 0
    if write(ssl.spool[sn]) == {
        .Ok(t) -> {
            // The writer is given the rest of the message.
            if ssltls.ssl_chk_buf_ptr(msg + 10, msg + ssldefs.SSL_OUT_CONTENT_LEN, t.ticket.len()) {
                ssldefs.ssl_copy_into(ssl.out_buf, msg + 10, t.ticket, 0, t.ticket.len())
                tlen = t.ticket.len()
                lifetime = t.lifetime
            }
        }
        .Err(_) -> {}
    }
    ssldefs.ssl_put_u32(ssl.out_buf, msg + 4, lifetime)
    ssldefs.ssl_put_u16(ssl.out_buf, msg + 8, tlen)
    ssl.out_msglen = 10 + tlen
    ssl.handshake.new_session_ticket = 0
    sslmsg.ssl_write_handshake_msg(ssl, rng) ?? return Err(err)
}

/// Take one step of the TLS 1.2 server handshake
/// (mbedtls_ssl_handshake_server_step).
ssl_handshake_server_step: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    state: ssl.state
    if state == ssldefs.SSL_HELLO_REQUEST {
        sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_CLIENT_HELLO)
        return
    }
    if state == ssldefs.SSL_CLIENT_HELLO -> return ssl_srv12_parse_client_hello(ssl, rng)
    if state == ssldefs.SSL_SERVER_HELLO_VERIFY_REQUEST_SENT -> return Err(.HelloVerifyRequired)
    if state == ssldefs.SSL_SERVER_HELLO -> return ssl_srv12_write_server_hello(ssl, rng)
    if state == ssldefs.SSL_SERVER_CERTIFICATE -> return ssltls.ssl_write_certificate(ssl, rng)
    if state == ssldefs.SSL_SERVER_KEY_EXCHANGE -> return ssl_srv12_write_server_key_exchange(ssl, rng)
    if state == ssldefs.SSL_CERTIFICATE_REQUEST -> return ssl_srv12_write_certificate_request(ssl, rng)
    if state == ssldefs.SSL_SERVER_HELLO_DONE -> return ssl_srv12_write_server_hello_done(ssl, rng)
    if state == ssldefs.SSL_CLIENT_CERTIFICATE -> return ssltls.ssl_parse_certificate(ssl, rng)
    if state == ssldefs.SSL_CLIENT_KEY_EXCHANGE -> return ssl_srv12_parse_client_key_exchange(ssl, rng)
    if state == ssldefs.SSL_CERTIFICATE_VERIFY -> return ssl_srv12_parse_certificate_verify(ssl, rng)
    if state == ssldefs.SSL_CLIENT_CHANGE_CIPHER_SPEC -> return sslmsg.ssl_parse_change_cipher_spec(ssl, rng)
    if state == ssldefs.SSL_CLIENT_FINISHED -> return ssltls.ssl_parse_finished(ssl, rng)
    if state == ssldefs.SSL_SERVER_CHANGE_CIPHER_SPEC {
        if ssl.handshake.new_session_ticket != 0 -> return ssl_srv12_write_new_session_ticket(ssl, rng)
        return sslmsg.ssl_write_change_cipher_spec(ssl, rng)
    }
    if state == ssldefs.SSL_SERVER_FINISHED -> return ssltls.ssl_write_finished(ssl, rng)
    if state == ssldefs.SSL_FLUSH_BUFFERS {
        sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_HANDSHAKE_WRAPUP)
        return
    }
    if state == ssldefs.SSL_HANDSHAKE_WRAPUP {
        ssltls.ssl_handshake_wrapup(ssl)
        return
    }
    Err(.BadInputData)
}

/// Take the client's ciphersuite order (SSL_SRV_CIPHERSUITE_ORDER_CLIENT)
/// or our own (mbedtls_ssl_conf_preference_order).
ssl_conf_preference_order: fn(conf: &ssldefs.SSLConfig, order: Int) Never! {
    conf.respect_cli_pref = order
}
