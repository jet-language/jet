// Translated from Mbed TLS 3.6.7 (library/ssl_ciphersuites.c, library/ssl_ciphersuites_internal.h); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: the TLS ciphersuites.
//
// mbedtls's ssl_ciphersuites.c and ssl_ciphersuites_internal.h: every
// ciphersuite the default configuration builds, its cipher, MAC digest, key
// exchange and version range, and the preference order the engine offers
// them in. The tables are generated from ssl_ciphersuites.c; the NULL-cipher
// and EC J-PAKE suites are left out, as the default configuration leaves
// MBEDTLS_CIPHER_NULL_CIPHER and MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED off.
use {
    core
    layer: __core_crypto_cipher_layer
    hashes: __core_crypto_md
    oids: __core_crypto_oid
    ssldefs: __core_net_ssl_defs
}

/// How a TLS 1.2 ciphersuite agrees on the premaster secret
/// (mbedtls_key_exchange_type_t). TLS 1.3 suites name NoExchange
/// (MBEDTLS_KEY_EXCHANGE_NONE): the key exchange is not part of a TLS 1.3
/// ciphersuite.
SSLKeyExchange: enum {
    NoExchange
    RSA
    DHERSA
    ECDHERSA
    ECDHEECDSA
    PSK
    DHEPSK
    RSAPSK
    ECDHEPSK
    ECDHRSA
    ECDHECDSA
}

/// A weak ciphersuite (MBEDTLS_CIPHERSUITE_WEAK).
CIPHERSUITE_WEAK: 1
/// A short authentication tag, as CCM_8 has (MBEDTLS_CIPHERSUITE_SHORT_TAG).
CIPHERSUITE_SHORT_TAG: 2
/// A ciphersuite DTLS cannot use (MBEDTLS_CIPHERSUITE_NODTLS).
CIPHERSUITE_NODTLS: 4

/// One ciphersuite (mbedtls_ssl_ciphersuite_t). `cipher` names the
/// cipher's CipherInfo; `flags` holds CIPHERSUITE_* bits.
SSLCiphersuite: struct {
    id: Int
    name: String
    cipher: String
    mac: hashes.Md
    key_exchange: SSLKeyExchange
    flags: Int
    min_tls_version: Int
    max_tls_version: Int
}

/// The supported ciphersuite IDs in preference order
/// (mbedtls_ssl_list_ciphersuites): the preference list less the suites
/// this build does not define.
ssl_list_ciphersuites: fn() -> [Int] Never! {
    out := [Int]{}
    loop id in CIPHERSUITE_PREFERENCE {
        if ssl_ciphersuite_defined(id) -> out.push(id)
    }
    out
}

// Whether the table defines the ciphersuite with this ID.
ssl_ciphersuite_defined: fn(id: Int) -> Bool Never! {
    loop cs in CIPHERSUITE_DEFINITIONS {
        if cs.id == id -> return true
    }
    false
}

/// The ciphersuite named `name` (mbedtls_ssl_ciphersuite_from_string).
ssl_ciphersuite_from_string: fn(name: String) -> SSLCiphersuite? Never! {
    loop cs in CIPHERSUITE_DEFINITIONS {
        if cs.name == name -> return Val(cs)
    }
    None
}

/// The ciphersuite with this IANA ID (mbedtls_ssl_ciphersuite_from_id).
ssl_ciphersuite_from_id: fn(id: Int) -> SSLCiphersuite? Never! {
    loop cs in CIPHERSUITE_DEFINITIONS {
        if cs.id == id -> return Val(cs)
    }
    None
}

/// The name of the ciphersuite with this ID, or "unknown"
/// (mbedtls_ssl_get_ciphersuite_name).
ssl_get_ciphersuite_name: fn(id: Int) -> String Never! {
    cs: ssl_ciphersuite_from_id(id) ?? return "unknown"
    cs.name
}

/// The ID of the ciphersuite named `name`, or 0
/// (mbedtls_ssl_get_ciphersuite_id).
ssl_get_ciphersuite_id: fn(name: String) -> Int Never! {
    cs: ssl_ciphersuite_from_string(name) ?? return 0
    cs.id
}

/// The cipher a ciphersuite runs (mbedtls_cipher_info_from_type on
/// `info->cipher`). Every table entry names a cipher CIPHER_INFO holds.
ssl_ciphersuite_cipher_info: fn(cs: SSLCiphersuite) -> layer.CipherInfo? Never! {
    layer.cipher_info_from_string(cs.cipher)
}

/// The key length in bits of a ciphersuite's cipher
/// (mbedtls_ssl_ciphersuite_get_cipher_key_bitlen), 0 when unknown.
ssl_ciphersuite_get_cipher_key_bitlen: fn(cs: SSLCiphersuite) -> Int Never! {
    info: ssl_ciphersuite_cipher_info(cs) ?? return 0
    info.key_bits
}

/// The public-key algorithm of the certificate the server presents
/// (mbedtls_ssl_get_ciphersuite_sig_pk_alg); None for MBEDTLS_PK_NONE.
ssl_get_ciphersuite_sig_pk_alg: fn(cs: SSLCiphersuite) -> oids.PKType? Never! {
    if cs.key_exchange == {
        .RSA | .DHERSA | .ECDHERSA | .RSAPSK -> Val(oids.PKType.RSA)
        .ECDHEECDSA -> Val(oids.PKType.ECDSA)
        .ECDHRSA | .ECDHECDSA -> Val(oids.PKType.ECKey)
        .NoExchange | .PSK | .DHEPSK | .ECDHEPSK -> None
    }
}

/// The algorithm of the server's key-exchange signature
/// (mbedtls_ssl_get_ciphersuite_sig_alg); None for MBEDTLS_PK_NONE.
ssl_get_ciphersuite_sig_alg: fn(cs: SSLCiphersuite) -> oids.PKType? Never! {
    if cs.key_exchange == {
        .DHERSA | .ECDHERSA -> Val(oids.PKType.RSA)
        .ECDHEECDSA -> Val(oids.PKType.ECDSA)
        .NoExchange | .RSA | .PSK | .DHEPSK | .RSAPSK | .ECDHEPSK | .ECDHRSA | .ECDHECDSA -> None
    }
}

/// Whether the key exchange uses elliptic curves
/// (mbedtls_ssl_ciphersuite_uses_ec).
ssl_ciphersuite_uses_ec: fn(cs: SSLCiphersuite) -> Bool Never! {
    if cs.key_exchange == {
        .ECDHERSA | .ECDHEECDSA | .ECDHEPSK | .ECDHRSA | .ECDHECDSA -> true
        .NoExchange | .RSA | .DHERSA | .PSK | .DHEPSK | .RSAPSK -> false
    }
}

/// Whether the key exchange uses a pre-shared key
/// (mbedtls_ssl_ciphersuite_uses_psk).
ssl_ciphersuite_uses_psk: fn(cs: SSLCiphersuite) -> Bool Never! {
    if cs.key_exchange == {
        .PSK | .RSAPSK | .DHEPSK | .ECDHEPSK -> true
        .NoExchange | .RSA | .DHERSA | .ECDHERSA | .ECDHEECDSA | .ECDHRSA | .ECDHECDSA -> false
    }
}

/// Whether the key exchange is forward-secure
/// (mbedtls_ssl_ciphersuite_has_pfs).
ssl_ciphersuite_has_pfs: fn(cs: SSLCiphersuite) -> Bool Never! {
    if cs.key_exchange == {
        .DHERSA | .DHEPSK | .ECDHERSA | .ECDHEPSK | .ECDHEECDSA -> true
        .NoExchange | .RSA | .PSK | .RSAPSK | .ECDHRSA | .ECDHECDSA -> false
    }
}

/// Whether the key exchange is not forward-secure
/// (mbedtls_ssl_ciphersuite_no_pfs).
ssl_ciphersuite_no_pfs: fn(cs: SSLCiphersuite) -> Bool Never! {
    if cs.key_exchange == {
        .ECDHRSA | .ECDHECDSA | .RSA | .PSK | .RSAPSK -> true
        .NoExchange | .DHERSA | .ECDHERSA | .ECDHEECDSA | .DHEPSK | .ECDHEPSK -> false
    }
}

/// Whether the key exchange is static ECDH
/// (mbedtls_ssl_ciphersuite_uses_ecdh).
ssl_ciphersuite_uses_ecdh: fn(cs: SSLCiphersuite) -> Bool Never! {
    cs.key_exchange == .ECDHRSA || cs.key_exchange == .ECDHECDSA
}

/// Whether the server may ask for a client certificate
/// (mbedtls_ssl_ciphersuite_cert_req_allowed).
ssl_ciphersuite_cert_req_allowed: fn(cs: SSLCiphersuite) -> Bool Never! {
    if cs.key_exchange == {
        .RSA | .DHERSA | .ECDHRSA | .ECDHERSA | .ECDHECDSA | .ECDHEECDSA -> true
        .NoExchange | .PSK | .DHEPSK | .RSAPSK | .ECDHEPSK -> false
    }
}

/// Whether the server presents a certificate
/// (mbedtls_ssl_ciphersuite_uses_srv_cert).
ssl_ciphersuite_uses_srv_cert: fn(cs: SSLCiphersuite) -> Bool Never! {
    if cs.key_exchange == {
        .RSA | .RSAPSK | .DHERSA | .ECDHRSA | .ECDHERSA | .ECDHECDSA | .ECDHEECDSA -> true
        .NoExchange | .PSK | .DHEPSK | .ECDHEPSK -> false
    }
}

/// Whether the key exchange is finite-field ephemeral Diffie-Hellman
/// (mbedtls_ssl_ciphersuite_uses_dhe).
ssl_ciphersuite_uses_dhe: fn(cs: SSLCiphersuite) -> Bool Never! {
    cs.key_exchange == .DHERSA || cs.key_exchange == .DHEPSK
}

/// Whether the key exchange is elliptic-curve ephemeral Diffie-Hellman
/// (mbedtls_ssl_ciphersuite_uses_ecdhe).
ssl_ciphersuite_uses_ecdhe: fn(cs: SSLCiphersuite) -> Bool Never! {
    if cs.key_exchange == {
        .ECDHEECDSA | .ECDHERSA | .ECDHEPSK -> true
        .NoExchange | .RSA | .DHERSA | .PSK | .DHEPSK | .RSAPSK | .ECDHRSA | .ECDHECDSA -> false
    }
}

/// Whether the server signs its key exchange
/// (mbedtls_ssl_ciphersuite_uses_server_signature).
ssl_ciphersuite_uses_server_signature: fn(cs: SSLCiphersuite) -> Bool Never! {
    if cs.key_exchange == {
        .DHERSA | .ECDHERSA | .ECDHEECDSA -> true
        .NoExchange | .RSA | .PSK | .DHEPSK | .RSAPSK | .ECDHEPSK | .ECDHRSA | .ECDHECDSA -> false
    }
}

