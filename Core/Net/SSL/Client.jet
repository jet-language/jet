// Private Core source part: the ClientHello both TLS versions send.
//
// A port of mbedtls 3.6.7's ssl_client.c under the default
// mbedtls_config.h: the ClientHello, its server_name, ALPN and
// supported_groups extensions and its cipher suite list, the client
// random and the legacy session ID. The version-specific extensions are
// cli12's and cli13's.
//
// The message is written at out_buf offsets: `buf` is where its body
// starts and `end` where its room ends.
use {
    core
    __core_crypto_bignum.[RNG]
    ssldefs: __core_net_ssl_defs
    suites: __core_net_ssl_ciphersuites
    sslmsg: __core_net_ssl_msg
    ssltls: __core_net_ssl_tls
    cli12: __core_net_ssl_cli12
    cli13: __core_net_ssl_cli13
}

// The versions a supported_groups extension serves
// (SSL_WRITE_SUPPORTED_GROUPS_EXT_TLS1_2_FLAG, _TLS1_3_FLAG).
SSL_WRITE_SUPPORTED_GROUPS_EXT_TLS1_2_FLAG: 1
SSL_WRITE_SUPPORTED_GROUPS_EXT_TLS1_3_FLAG: 2

// The server_name extension with the hostname set, nothing without one
// (ssl_write_hostname_ext, RFC 6066 3).
ssl_cli_write_hostname_ext: fn(ssl: &ssldefs.SSLContext, buf: Int, end: Int) -> Int ssldefs.SSLError! {
    hostname: ssltls.ssl_get_hostname_pointer(ssl) ?? return Ok(0)
    name: hostname.bytes()
    hostname_len: name.len()
    p := buf
    ssltls.ssl_chk_buf(p, end, hostname_len + 9) ?? return Err(err)
    ssldefs.ssl_put_u16(ssl.out_buf, p, ssldefs.TLS_EXT_SERVERNAME)
    ssldefs.ssl_put_u16(ssl.out_buf, p + 2, hostname_len + 5)
    // The ServerNameList: one host_name entry.
    ssldefs.ssl_put_u16(ssl.out_buf, p + 4, hostname_len + 3)
    ssl.out_buf[p + 6] = ssldefs.ssl_byte(ssldefs.TLS_EXT_SERVERNAME_HOSTNAME)
    ssldefs.ssl_put_u16(ssl.out_buf, p + 7, hostname_len)
    p += 9
    ssldefs.ssl_copy_into(ssl.out_buf, p, name, 0, hostname_len)
    ssltls.ssl_tls13_set_hs_sent_ext_mask(ssl, ssldefs.TLS_EXT_SERVERNAME)
    Ok(hostname_len + 9)
}

// The application_layer_protocol_negotiation extension with the
// configured protocols, nothing without them (ssl_write_alpn_ext,
// RFC 7301 3.1). Setting the list checked each name is under 256 bytes.
ssl_cli_write_alpn_ext: fn(ssl: &ssldefs.SSLContext, buf: Int, end: Int) -> Int ssldefs.SSLError! {
    alpn_list: ssl.conf.alpn_list ?? return Ok(0)
    p := buf
    // The extension type, its length and the list length.
    ssltls.ssl_chk_buf(p, end, 6) ?? return Err(err)
    ssldefs.ssl_put_u16(ssl.out_buf, p, ssldefs.TLS_EXT_ALPN)
    p += 6
    loop protocol in alpn_list {
        name: protocol.bytes()
        protocol_name_len: name.len()
        ssltls.ssl_chk_buf(p, end, 1 + protocol_name_len) ?? return Err(err)
        ssl.out_buf[p] = ssldefs.ssl_byte(protocol_name_len)
        ssldefs.ssl_copy_into(ssl.out_buf, p + 1, name, 0, protocol_name_len)
        p += 1 + protocol_name_len
    }
    out_len: p - buf
    ssldefs.ssl_put_u16(ssl.out_buf, buf + 4, out_len - 6)
    ssldefs.ssl_put_u16(ssl.out_buf, buf + 2, out_len - 4)
    ssltls.ssl_tls13_set_hs_sent_ext_mask(ssl, ssldefs.TLS_EXT_ALPN)
    Ok(out_len)
}

// The supported_groups extension (TLS 1.3, RFC 8446 4.2.7), which is TLS
// 1.2's supported elliptic curves one (RFC 8422 5.1.1): the configured
// groups the versions in `flags` can use (ssl_write_supported_groups_ext).
// TLS 1.3 takes its ECDHE curves and the RFC 7919 groups, TLS 1.2 its
// ECDHE curves. A configuration without groups is BadConfig.
ssl_cli_write_supported_groups_ext: fn(ssl: &ssldefs.SSLContext, buf: Int, end: Int, flags: Int) -> Int ssldefs.SSLError! {
    p := buf
    // The extension type, its length and the list length.
    ssltls.ssl_chk_buf(p, end, 6) ?? return Err(err)
    p += 6
    named_group_list: p
    group_list: ssltls.ssl_get_groups(ssl)
    if group_list.len() == 0 -> return Err(.BadConfig)
    loop group in group_list {
        propose_group := false
        if flags.bit_and(SSL_WRITE_SUPPORTED_GROUPS_EXT_TLS1_3_FLAG) != 0 {
            if ssltls.ssl_tls13_named_group_is_ecdhe(group) && ssltls.ssl_get_ecp_group_id_from_tls_id(group) != .Unknown -> propose_group = true
            if ssltls.ssl_tls13_named_group_is_ffdh(group) -> propose_group = true
        }
        if flags.bit_and(SSL_WRITE_SUPPORTED_GROUPS_EXT_TLS1_2_FLAG) != 0 && ssltls.ssl_tls12_named_group_is_ecdhe(group) && ssltls.ssl_get_ecp_group_id_from_tls_id(group) != .Unknown -> propose_group = true
        if propose_group {
            ssltls.ssl_chk_buf(p, end, 2) ?? return Err(err)
            ssldefs.ssl_put_u16(ssl.out_buf, p, group)
            p += 2
        }
    }
    named_group_list_len: p - named_group_list
    if named_group_list_len == 0 -> return Err(.InternalError)
    ssldefs.ssl_put_u16(ssl.out_buf, buf, ssldefs.TLS_EXT_SUPPORTED_GROUPS)
    ssldefs.ssl_put_u16(ssl.out_buf, buf + 2, named_group_list_len + 2)
    ssldefs.ssl_put_u16(ssl.out_buf, buf + 4, named_group_list_len)
    ssltls.ssl_tls13_set_hs_sent_ext_mask(ssl, ssldefs.TLS_EXT_SUPPORTED_GROUPS)
    Ok(p - buf)
}

// The cipher_suites field written at out_buf[buf..<end], and whether a
// TLS 1.2 suite among them uses elliptic curves.
SSLCipherSuitesWritten: struct {
    len: Int
    tls12_uses_ec: Bool
}

// The configured ciphersuites the versions offered allow, then on an
// initial handshake the empty renegotiation_info signalling suite
// (ssl_write_client_hello_cipher_suites, RFC 5746 3.3).
ssl_cli_write_client_hello_cipher_suites: fn(ssl: &ssldefs.SSLContext, buf: Int, end: Int) -> SSLCipherSuitesWritten ssldefs.SSLError! {
    p := buf
    tls12_uses_ec := false
    // The list length.
    ssltls.ssl_chk_buf(p, end, 2) ?? return Err(err)
    p += 2
    cipher_suites: p
    ciphersuite_list: ssl.conf.ciphersuite_list.copy()
    loop cipher_suite in ciphersuite_list {
        ciphersuite_info: suites.ssl_ciphersuite_from_id(cipher_suite)
        if !ssltls.ssl_validate_ciphersuite(ssl, ciphersuite_info, ssl.handshake.min_tls_version, ssl.tls_version) -> next
        if ciphersuite_info == {
            .Val(cs) -> { if suites.ssl_ciphersuite_uses_ec(cs) -> tls12_uses_ec = true }
            None -> {}
        }
        ssltls.ssl_chk_buf(p, end, 2) ?? return Err(err)
        ssldefs.ssl_put_u16(ssl.out_buf, p, cipher_suite)
        p += 2
    }
    if ssl.renego_status == ssldefs.SSL_INITIAL_HANDSHAKE {
        ssltls.ssl_chk_buf(p, end, 2) ?? return Err(err)
        ssldefs.ssl_put_u16(ssl.out_buf, p, ssldefs.SSL_EMPTY_RENEGOTIATION_INFO)
        p += 2
    }
    ssldefs.ssl_put_u16(ssl.out_buf, buf, p - cipher_suites)
    Ok(SSLCipherSuitesWritten{len: p - buf, tls12_uses_ec: tls12_uses_ec})
}

// A written ClientHello body: its length and the length of the PSK
// binders that end it, which are written once the rest is in the
// transcript.
SSLClientHelloWritten: struct {
    len: Int
    binders_len: Int
}

// Write the ClientHello body at out_buf[buf..<end]
// (ssl_write_client_hello_body; RFC 8446 4.1.2, RFC 5246 7.4.1.2 and
// RFC 6347 4.2.1). The version field is TLS 1.2's in both versions. The
// extensions are those of every version proposed, the TLS 1.3
// pre_shared_key one last; an empty extension list is left out.
ssl_write_client_hello_body: fn<R: RNG>(ssl: &ssldefs.SSLContext, buf: Int, end: Int, rng: &R) -[Time]> SSLClientHelloWritten ssldefs.SSLError! {
    p := buf
    binders_len := 0
    propose_tls12: ssl.handshake.min_tls_version <= ssldefs.SSL_VERSION_TLS1_2 && ssldefs.SSL_VERSION_TLS1_2 <= ssl.tls_version
    propose_tls13: ssl.handshake.min_tls_version <= ssldefs.SSL_VERSION_TLS1_3 && ssldefs.SSL_VERSION_TLS1_3 <= ssl.tls_version
    ssltls.ssl_chk_buf(p, end, 2) ?? return Err(err)
    sslmsg.ssl_write_version(ssl.out_buf, p, ssl.conf.transport, ssldefs.SSL_VERSION_TLS1_2)
    p += 2
    // The random ssl_prepare_client_hello made.
    ssltls.ssl_chk_buf(p, end, ssldefs.CLIENT_HELLO_RANDOM_LEN) ?? return Err(err)
    ssldefs.ssl_copy_into(ssl.out_buf, p, ssl.handshake.randbytes, 0, ssldefs.CLIENT_HELLO_RANDOM_LEN)
    p += ssldefs.CLIENT_HELLO_RANDOM_LEN
    // The (legacy) session ID ssl_prepare_client_hello made.
    sn: ssl.session_negotiate
    id: ssl.spool[sn].id.copy()
    id_len: id.len()
    ssltls.ssl_chk_buf(p, end, id_len + 1) ?? return Err(err)
    ssl.out_buf[p] = ssldefs.ssl_byte(id_len)
    ssldefs.ssl_copy_into(ssl.out_buf, p + 1, id, 0, id_len)
    p += 1 + id_len
    // DTLS 1.2's cookie.
    if ssl.conf.transport == ssldefs.SSL_TRANSPORT_DATAGRAM {
        cookie: if ssl.handshake.cookie == {
            .Val(c) -> c.copy()
            None -> [U8]{}
        }
        cookie_len: cookie.len()
        ssltls.ssl_chk_buf(p, end, cookie_len + 1) ?? return Err(err)
        ssl.out_buf[p] = ssldefs.ssl_byte(cookie_len)
        ssldefs.ssl_copy_into(ssl.out_buf, p + 1, cookie, 0, cookie_len)
        p += 1 + cookie_len
    }
    suites_written: ssl_cli_write_client_hello_cipher_suites(ssl, p, end) ?? return Err(err)
    p += suites_written.len
    tls12_uses_ec: suites_written.tls12_uses_ec
    // The compression methods: null alone.
    ssltls.ssl_chk_buf(p, end, 2) ?? return Err(err)
    ssl.out_buf[p] = U8{1}
    ssl.out_buf[p + 1] = ssldefs.ssl_byte(ssldefs.SSL_COMPRESS_NULL)
    p += 2
    ssl.handshake.sent_extensions = ssldefs.SSL_EXT_MASK_NONE
    // The extensions, then their length.
    ssltls.ssl_chk_buf(p, end, 2) ?? return Err(err)
    p_extensions_len: p
    p += 2
    p += ssl_cli_write_hostname_ext(ssl, p, end) ?? return Err(err)
    p += ssl_cli_write_alpn_ext(ssl, p, end) ?? return Err(err)
    if propose_tls13 {
        p += cli13.ssl_tls13_write_client_hello_exts(ssl, p, end, rng) ?? return Err(err)
    }
    groups_flags := 0
    if propose_tls13 && ssltls.ssl_conf_tls13_is_some_ephemeral_enabled(ssl) -> groups_flags = groups_flags.bit_or(SSL_WRITE_SUPPORTED_GROUPS_EXT_TLS1_3_FLAG)
    if propose_tls12 && tls12_uses_ec -> groups_flags = groups_flags.bit_or(SSL_WRITE_SUPPORTED_GROUPS_EXT_TLS1_2_FLAG)
    if groups_flags != 0 {
        p += ssl_cli_write_supported_groups_ext(ssl, p, end, groups_flags) ?? return Err(err)
    }
    if (propose_tls13 && ssltls.ssl_conf_tls13_is_ephemeral_enabled(ssl)) || propose_tls12 {
        p += ssltls.ssl_write_sig_alg_ext(ssl, p, end) ?? return Err(err)
    }
    if propose_tls12 {
        p += cli12.ssl_tls12_write_client_hello_exts(ssl, p, end, tls12_uses_ec) ?? return Err(err)
    }
    // pre_shared_key must be the last extension (RFC 8446 4.2.11).
    if propose_tls13 && ssltls.ssl_conf_tls13_is_some_psk_enabled(ssl) {
        psk_written: cli13.ssl_tls13_write_identities_of_pre_shared_key_ext(ssl, p, end) ?? return Err(err)
        p += psk_written.len
        binders_len = psk_written.binders_len
    }
    extensions_len: p - p_extensions_len - 2
    if extensions_len == 0 {
        p = p_extensions_len
    } else {
        ssldefs.ssl_put_u16(ssl.out_buf, p_extensions_len, extensions_len)
    }
    Ok(SSLClientHelloWritten{len: p - buf, binders_len: binders_len})
}

// The client random: TLS 1.2's starts with the time in seconds
// (ssl_generate_random, RFC 5246 7.4.1.2); TLS 1.3's is all random.
ssl_cli_generate_random: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! -[Time]> {
    gmt_unix_time_len := 0
    if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_2 {
        ssldefs.ssl_put_u32(ssl.handshake.randbytes, 0, ssldefs.ssl_time())
        gmt_unix_time_len = 4
    }
    random := ssldefs.ssl_zeros(ssldefs.CLIENT_HELLO_RANDOM_LEN - gmt_unix_time_len)
    if !rng.fill(random) -> return Err(.RandomFailed)
    ssldefs.ssl_copy_into(ssl.handshake.randbytes, gmt_unix_time_len, random, 0, random.len())
}

// Get ready for a ClientHello (ssl_prepare_client_hello): drop a TLS 1.3
// ticket that has expired, pick the versions to offer, make the random
// unless a HelloVerifyRequest or HelloRetryRequest needs the first one
// again (RFC 6347 4.2.1, RFC 8446 4.1.2), and the session ID: a TLS 1.2
// resumption's or one to go with a ticket (RFC 5077 3.4), or the 32
// random bytes of TLS 1.3 middlebox compatibility. A TLS 1.3 resumption
// must be to the host the ticket came from; else the session takes the
// hostname.
ssl_prepare_client_hello: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! -[Time]> {
    sn: ssl.session_negotiate
    if sn < 0 -> return Err(.InternalError)
    if ssl.handshake.resume != 0 && ssl.spool[sn].tls_version == ssldefs.SSL_VERSION_TLS1_3 && ssl.spool[sn].ticket != None {
        age: ssldefs.ssl_ms_time() - ssl.spool[sn].ticket_reception_time
        if age < 0 || age > ssl.spool[sn].ticket_lifetime * 1000 -> ssl.handshake.resume = 0
    }
    if ssl.renego_status != ssldefs.SSL_INITIAL_HANDSHAKE {
        ssl.handshake.min_tls_version = ssl.tls_version
    } else {
        if ssl.handshake.resume != 0 {
            ssl.tls_version = ssl.spool[sn].tls_version
            ssl.handshake.min_tls_version = ssl.tls_version
        } else {
            ssl.handshake.min_tls_version = ssl.conf.min_tls_version
        }
    }
    if (ssl.conf.transport != ssldefs.SSL_TRANSPORT_DATAGRAM || ssl.handshake.cookie == None) && ssl.handshake.hello_retry_request_flag == 0 {
        ssl_cli_generate_random(ssl, rng) ?? return Err(err)
    }
    session_id_len := ssl.spool[sn].id.len()
    if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_2 {
        if session_id_len < 16 || session_id_len > 32 || ssl.renego_status != ssldefs.SSL_INITIAL_HANDSHAKE || ssl.handshake.resume == 0 -> session_id_len = 0
        if ssl.renego_status == ssldefs.SSL_INITIAL_HANDSHAKE {
            if ssl.spool[sn].ticket == {
                .Val(t) -> { if t.len() != 0 -> session_id_len = 32 }
                None -> {}
            }
        }
    }
    if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_3 -> session_id_len = 32
    if session_id_len != ssl.spool[sn].id.len() {
        id := ssldefs.ssl_zeros(session_id_len)
        if session_id_len > 0 && !rng.fill(id) -> return Err(.RandomFailed)
        ssl.spool[sn].id = id
    }
    context_hostname: ssltls.ssl_get_hostname_pointer(ssl)
    if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_3 && ssl.handshake.resume != 0 {
        hostname_mismatch: if context_hostname == {
            .Val(h) -> {
                if ssl.spool[sn].hostname == {
                    .Val(s) -> h != s
                    None -> true
                }
            }
            None -> ssl.spool[sn].hostname != None
        }
        if hostname_mismatch -> return Err(.BadInputData)
        return
    }
    ssltls.ssl_session_set_hostname(ssl.spool[sn], context_hostname) ?? return Err(err)
}

/// Write the ClientHello (mbedtls_ssl_write_client_hello, the
/// MBEDTLS_SSL_CLIENT_HELLO step). A DTLS one goes out as its flight,
/// with the state moved on first so a retried send does not write it
/// again. Over TLS the PSK binders are computed over the transcript up to
/// them, and a TLS 1.3 proposal may go on to other states.
ssl_write_client_hello: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! -[Time]> {
    ssl_prepare_client_hello(ssl, rng) ?? return Err(err)
    buf: sslmsg.ssl_start_handshake_msg(ssl, ssldefs.SSL_HS_CLIENT_HELLO)
    buf_len: ssldefs.SSL_OUT_CONTENT_LEN - 4
    written: ssl_write_client_hello_body(ssl, buf, buf + buf_len, rng) ?? return Err(err)
    msg_len: written.len
    binders_len: written.binders_len
    if ssl.conf.transport == ssldefs.SSL_TRANSPORT_DATAGRAM {
        ssl.out_msglen = msg_len + 4
        sslmsg.ssl_send_flight_completed(ssl)
        sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_SERVER_HELLO)
        sslmsg.ssl_write_handshake_msg(ssl, rng) ?? return Err(err)
        sslmsg.ssl_flight_transmit(ssl, rng) ?? return Err(err)
        return
    }
    ssltls.ssl_add_hs_hdr_to_checksum(ssl.handshake, ssldefs.SSL_HS_CLIENT_HELLO, msg_len)
    ssltls.ssl_update_checksum(ssl.handshake, ssl.out_buf, buf, msg_len - binders_len)
    if binders_len > 0 {
        cli13.ssl_tls13_write_binders_of_pre_shared_key_ext(ssl, buf + msg_len - binders_len, buf + msg_len) ?? return Err(err)
        ssltls.ssl_update_checksum(ssl.handshake, ssl.out_buf, buf + msg_len - binders_len, binders_len)
    }
    sslmsg.ssl_finish_handshake_msg(ssl, msg_len, rng) ?? return Err(err)
    // mbedtls_ssl_tls13_finalize_client_hello, which may set another
    // state, does nothing without early data.
    sslmsg.ssl_handshake_set_state(ssl, ssldefs.SSL_SERVER_HELLO)
}
