// SPDX-License-Identifier: Apache-2.0
// Translated from Mbed TLS 3.6.7 (library/ssl_msg.c); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: the SSL/TLS record layer and message handling.
//
// A port of mbedtls 3.6.7's ssl_msg.c under the default mbedtls_config.h:
// record protection (encrypt_buf, decrypt_buf and the constant-flow HMAC
// of CBC records), the DTLS retransmission timer and flight state machine,
// record header parsing, replay protection, handshake message reassembly
// and buffering, alerts, and the read, write and close_notify paths.
//
// The context's input and output buffers are moved into an SSLRecord while
// a record is protected or unprotected and moved back after, so no record
// is copied. f_send and f_recv are the context's SSLBio; the timer is the
// context's SSLTimer over the monotonic clock.
use {
    core
    __core_crypto_bignum.[RNG]
    layer: __core_crypto_cipher_layer
    hashes: __core_crypto_md
    ctime: __core_crypto_ctime
    ssldefs: __core_net_ssl_defs
    ssltls: __core_net_ssl_tls
}

/// How a transform protects records (mbedtls_ssl_mode_t).
SSLMode: enum {
    Stream
    CBC
    CBCETM
    AEAD
}

// mbedtls_ssl_get_base_mode and ssl_get_actual_mode (ssl_tls.c).
ssl_get_actual_mode: fn(mode: layer.CipherMode, encrypt_then_mac: Int) -> SSLMode Never! {
    if mode == {
        .CBC -> {
            if encrypt_then_mac == ssldefs.SSL_ETM_ENABLED -> return SSLMode.CBCETM
            SSLMode.CBC
        }
        .GCM | .CCM | .ChaChaPoly -> SSLMode.AEAD
        .ECB | .CFB | .OFB | .CTR | .Stream | .CCMStarNoTag | .XTS | .KW | .KWP -> SSLMode.Stream
    }
}

/// The record protection a transform uses
/// (mbedtls_ssl_get_mode_from_transform).
ssl_get_mode_from_transform: fn(t: ssldefs.SSLTransform) -> SSLMode Never! {
    if t.cipher_enc == {
        .Val(ctx) -> ssl_get_actual_mode(ctx.info.mode, t.encrypt_then_mac)
        None -> SSLMode.Stream
    }
}

// ---------------------------------------------------------------------------
// The constant-flow HMAC of CBC records.

/// The HMAC under `key` of add_data || data[doff..<doff+data_len_secret],
/// computed with the same hash operations for every data_len_secret in
/// min_len...max_len, so the record's padding length does not show in
/// its timing (mbedtls_ct_hmac). The secret length is a word, compared
/// under masks only.
ssl_ct_hmac: fn(key: hashes.HMACKey, add_data: [U8], data: [U8], doff: Int, data_len_secret: U64, min_len: Int, max_len: Int) -> [U8] Never! {
    ctx := hashes.hash_clone(key.inner)
    hashes.hash_update(ctx, add_data)
    hashes.hash_update_range(ctx, data, doff, min_len)
    size: hashes.md_size(key.md)
    output := [U8]{}
    loop _ in 0..<size -> output.push(U8{0x21})
    loop offset in min_len..max_len {
        aux := hashes.hash_clone(ctx)
        aux_out := hashes.hash_finish(aux)
        ctime.memcpy_if(ctime.uint_eq(U64{offset}, data_len_secret), output, 0, aux_out, 0, size)
        ssldefs.ssl_wipe(aux_out)
        if offset < max_len -> hashes.hash_update_range(ctx, data, doff + offset, 1)
    }
    // The context finishes, which wipes it, before the outer hash; the
    // inner hash is wiped once absorbed.
    rest := hashes.hash_finish(ctx)
    ssldefs.ssl_wipe(rest)
    outer := hashes.hash_clone(key.outer)
    hashes.hash_update(outer, output)
    ssldefs.ssl_wipe(output)
    hashes.hash_finish(outer)
}

/// HMAC(key, a || buf[off..<off+len]): the record MAC of a non-CBC-decrypt
/// path (mbedtls_md_hmac_update twice, then hmac_finish).
ssl_record_mac: fn(key: hashes.HMACKey, add_data: [U8], buf: [U8], off: Int, len: Int) -> [U8] Never! {
    inner := hashes.hash_clone(key.inner)
    hashes.hash_update(inner, add_data)
    hashes.hash_update_range(inner, buf, off, len)
    hashes.hmac_finish(key, inner)
}

/// ssl_record_mac under a transform's MAC key; None when it has none.
ssl_mac_of: fn(key: hashes.HMACKey?, add_data: [U8], buf: [U8], off: Int, len: Int) -> [U8]? Never! {
    if key == {
        .Val(k) -> Val(ssl_record_mac(k, add_data, buf, off, len))
        None -> None
    }
}

// ---------------------------------------------------------------------------
// The retransmission timer.

/// Start the timer for `millisecs`; 0 cancels it (mbedtls_ssl_set_timer,
/// with mbedtls_timing_set_delay's intermediate delay of a quarter).
ssl_set_timer: fn(ssl: &ssldefs.SSLContext, millisecs: Int) Never! {
    if !ssl.timer.enabled -> return
    ssl.timer.int_ms = millisecs /% 4
    ssl.timer.fin_ms = millisecs
    if millisecs != 0 -> ssl.timer.start_ns = core.time.__clock_mono_ns()
}

/// mbedtls_timing_get_delay: -1 canceled, 0 running, 1 past the
/// intermediate delay, 2 past the final one.
ssl_timer_state: fn(ssl: ssldefs.SSLContext) -> Int Never! {
    if ssl.timer.fin_ms == 0 -> return -1
    elapsed_ms: (core.time.__clock_mono_ns() - ssl.timer.start_ns) /% 1000000
    if elapsed_ms >= ssl.timer.fin_ms -> return 2
    if elapsed_ms >= ssl.timer.int_ms -> return 1
    0
}

/// Whether the timer has expired (mbedtls_ssl_check_timer's -1).
ssl_check_timer: fn(ssl: ssldefs.SSLContext) -> Bool Never! {
    if !ssl.timer.enabled -> return false
    ssl_timer_state(ssl) == 2
}

// ---------------------------------------------------------------------------
// The (D)TLSInnerPlaintext and the record's additional data.

ssl_compute_padding_length: fn(len: Int, granularity: Int) -> Int Never! {
    (granularity - (len + 1) %% granularity) %% granularity
}

/// Append the content type and `pad` zeros to the `len` bytes at buf[off]
/// (ssl_build_inner_plaintext): the new length, or -1 when the `remaining`
/// bytes after them cannot hold the expansion.
ssl_build_inner_plaintext: fn(buf: &[U8], off: Int, len: Int, remaining: Int, rec_type: Int, pad: Int) -> Int Never! {
    if remaining == 0 -> return -1
    buf[off + len] = ssldefs.ssl_byte(rec_type)
    if remaining - 1 < pad -> return -1
    ssldefs.ssl_fill(buf, off + len + 1, pad, U8{0})
    len + 1 + pad
}

/// Strip the zero padding of the record's (D)TLSInnerPlaintext and take
/// its content type (ssl_parse_inner_plaintext); false when it is all
/// zeros.
ssl_parse_inner_plaintext: fn(rec: &ssldefs.SSLRecord, buf: [U8]) -> Bool Never! {
    data: rec.buf_start + rec.data_offset
    remaining := rec.data_len
    loop {
        if remaining == 0 -> return false
        remaining -= 1
        if buf[data + remaining] != (U8{0}) -> break
    }
    rec.data_len = remaining
    rec.rtype = Int.from_u8(buf[data + remaining])
    true
}

/// The MAC or AEAD additional data of a record
/// (ssl_extract_add_data_from_record), in RFC 9146's form when the
/// record carries a CID (MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT 0).
ssl_extract_add_data_from_record: fn(rec: ssldefs.SSLRecord, tls_version: Int, taglen: Int) -> [U8] Never! {
    out := [U8]{}
    ad_len_field := rec.data_len
    if tls_version == ssldefs.SSL_VERSION_TLS1_3 {
        ad_len_field += taglen
    } else if rec.cid_len != 0 {
        loop _ in 0..<8 -> out.push(U8{0xFF})
        out.push(ssldefs.ssl_byte(rec.rtype))
        out.push(ssldefs.ssl_byte(rec.cid_len))
    } else {
        ssldefs.ssl_push_all(out, rec.ctr)
    }
    out.push(ssldefs.ssl_byte(rec.rtype))
    ssldefs.ssl_push_all(out, rec.ver)
    if rec.cid_len != 0 {
        ssldefs.ssl_push_all(out, rec.ctr)
        loop i in 0..<rec.cid_len -> out.push(rec.cid[i])
    }
    ssldefs.ssl_push_u16(out, ad_len_field)
    out
}

ssl_transform_aead_dynamic_iv_is_explicit: fn(t: ssldefs.SSLTransform) -> Bool Never! { t.ivlen != t.fixed_ivlen }

/// IV := (fixed_iv || 0) XOR (0 || dynamic_iv) over 12 bytes
/// (ssl_build_record_nonce).
ssl_build_record_nonce: fn(fixed_iv: [U8], fixed_iv_len: Int, dynamic_iv: [U8], doff: Int, dynamic_iv_len: Int) -> [U8] Never! {
    iv := ssldefs.ssl_zeros(12)
    loop i in 0..<fixed_iv_len -> iv[i] = fixed_iv[i]
    base: 12 - dynamic_iv_len
    loop i in 0..<dynamic_iv_len -> iv[base + i] = iv[base + i].bit_xor(dynamic_iv[doff + i])
    iv
}

// ---------------------------------------------------------------------------
// Record protection.

/// Protect the record in place in `buf` under `t` (mbedtls_ssl_encrypt_buf):
/// wrap it in the inner plaintext for TLS 1.3 and CID records, then MAC and
/// encrypt it as the transform's mode requires. `rng` draws the explicit
/// CBC IV.
ssl_encrypt_buf: fn<R: RNG>(t: &ssldefs.SSLTransform, rec: &ssldefs.SSLRecord, buf: &[U8], rng: &R) ssldefs.SSLError! {
    if !t.valid -> return Err(.InternalError)
    if rec.buf_len < rec.data_offset || rec.buf_len - rec.data_offset < rec.data_len || rec.cid_len != 0 -> return Err(.InternalError)
    mode: ssl_get_mode_from_transform(t)
    data := rec.buf_start + rec.data_offset
    post_avail := rec.buf_len - (rec.data_len + rec.data_offset)
    if rec.data_len > ssldefs.SSL_OUT_CONTENT_LEN -> return Err(.BadInputData)
    if t.tls_version == ssldefs.SSL_VERSION_TLS1_3 {
        padding: ssl_compute_padding_length(rec.data_len, ssldefs.SSL_CID_TLS1_3_PADDING_GRANULARITY)
        n: ssl_build_inner_plaintext(buf, data, rec.data_len, post_avail, rec.rtype, padding)
        if n < 0 -> return Err(.BufferTooSmall)
        rec.data_len = n
        rec.rtype = ssldefs.SSL_MSG_APPLICATION_DATA
    }
    rec.cid_len = t.out_cid.len()
    rec.cid = t.out_cid.copy()
    if rec.cid_len != 0 {
        padding: ssl_compute_padding_length(rec.data_len, ssldefs.SSL_CID_TLS1_3_PADDING_GRANULARITY)
        n: ssl_build_inner_plaintext(buf, data, rec.data_len, post_avail, rec.rtype, padding)
        if n < 0 -> return Err(.BufferTooSmall)
        rec.data_len = n
        rec.rtype = ssldefs.SSL_MSG_CID
    }
    post_avail = rec.buf_len - (rec.data_len + rec.data_offset)
    auth_done := 0
    if mode == .Stream || mode == .CBC {
        if post_avail < t.maclen -> return Err(.BufferTooSmall)
        add_data: ssl_extract_add_data_from_record(rec, t.tls_version, t.taglen)
        mac := ssl_mac_of(t.md_enc, add_data, buf, data, rec.data_len) ?? return Err(.InternalError)
        ssldefs.ssl_copy_into(buf, data + rec.data_len, mac, 0, t.maclen)
        ssldefs.ssl_wipe(mac)
        rec.data_len += t.maclen
        post_avail -= t.maclen
        auth_done += 1
    }
    if mode == {
        // The only stream cipher is NULL, off in this configuration.
        .Stream -> return Err(.InternalError)
        .AEAD -> {
            if post_avail < t.taglen -> return Err(.BufferTooSmall)
            explicit: ssl_transform_aead_dynamic_iv_is_explicit(t)
            // The dynamic IV is the record sequence number in every case.
            iv := ssl_build_record_nonce(t.iv_enc, t.fixed_ivlen, rec.ctr, 0, 8)
            add_data: ssl_extract_add_data_from_record(rec, t.tls_version, t.taglen)
            plain := ssldefs.ssl_bytes_of(buf, data, rec.data_len)
            sealed := [U8]{}
            if &t.cipher_enc == {
                .Val(c) -> sealed = layer.cipher_auth_encrypt_ext(c, ssldefs.ssl_bytes_of(iv, 0, t.ivlen), add_data, plain, t.taglen) ?? return Err(.Cipher(err))
                None -> return Err(.InternalError)
            }
            ssldefs.ssl_wipe(plain)
            ssldefs.ssl_copy_into(buf, data, sealed, 0, sealed.len())
            rec.data_len = sealed.len()
            post_avail -= t.taglen
            if explicit {
                if rec.data_offset < 8 -> return Err(.BufferTooSmall)
                ssldefs.ssl_copy_into(buf, data - 8, rec.ctr, 0, 8)
                rec.data_offset -= 8
                rec.data_len += 8
            }
            auth_done += 1
        }
        .CBC | .CBCETM -> {
            padlen := t.ivlen - (rec.data_len + 1) %% t.ivlen
            if padlen == t.ivlen -> padlen = 0
            if post_avail < padlen + 1 -> return Err(.BufferTooSmall)
            ssldefs.ssl_fill(buf, data + rec.data_len, padlen + 1, ssldefs.ssl_byte(padlen))
            rec.data_len += padlen + 1
            post_avail -= padlen + 1
            // The per-record IV of TLS 1.2 (RFC 5246 6.2.3.2, method 1).
            if rec.data_offset < t.ivlen -> return Err(.BufferTooSmall)
            if !rng.fill(t.iv_enc) -> return Err(.RandomFailed)
            ssldefs.ssl_copy_into(buf, data - t.ivlen, t.iv_enc, 0, t.ivlen)
            plain := ssldefs.ssl_bytes_of(buf, data, rec.data_len)
            enc := [U8]{}
            if &t.cipher_enc == {
                .Val(c) -> enc = layer.cipher_crypt(c, ssldefs.ssl_bytes_of(t.iv_enc, 0, t.ivlen), plain) ?? return Err(.Cipher(err))
                None -> return Err(.InternalError)
            }
            ssldefs.ssl_wipe(plain)
            if enc.len() != rec.data_len -> return Err(.InternalError)
            ssldefs.ssl_copy_into(buf, data, enc, 0, enc.len())
            data -= t.ivlen
            rec.data_offset -= t.ivlen
            rec.data_len += t.ivlen
            if auth_done == 0 {
                // MAC(MAC_write_key, add_data, IV, ENC(content + padding + padding_length)).
                if post_avail < t.maclen -> return Err(.BufferTooSmall)
                add_data: ssl_extract_add_data_from_record(rec, t.tls_version, t.taglen)
                mac := ssl_mac_of(t.md_enc, add_data, buf, data, rec.data_len) ?? return Err(.InternalError)
                ssldefs.ssl_copy_into(buf, data + rec.data_len, mac, 0, t.maclen)
                ssldefs.ssl_wipe(mac)
                rec.data_len += t.maclen
                post_avail -= t.maclen
                auth_done += 1
            }
        }
    }
    if auth_done != 1 -> return Err(.InternalError)
}

/// Check and unprotect the record in place in `buf` under `t`
/// (mbedtls_ssl_decrypt_buf). A CBC record's padding and MAC are checked
/// without a branch or memory access that depends on the padding; any
/// failure there is InvalidMac.
ssl_decrypt_buf: fn(t: &ssldefs.SSLTransform, rec: &ssldefs.SSLRecord, buf: &[U8]) ssldefs.SSLError! {
    if rec.buf_len < rec.data_offset || rec.buf_len - rec.data_offset < rec.data_len -> return Err(.InternalError)
    data := rec.buf_start + rec.data_offset
    mode: ssl_get_mode_from_transform(t)
    if rec.cid_len != t.in_cid.len() || !ssldefs.ssl_range_eq(rec.cid, 0, t.in_cid, 0, rec.cid_len) -> return Err(.UnexpectedCID)
    auth_done := 0
    // A CBC record's length before the padding comes off: public, where
    // the padding length and the content length after it (`content_len`)
    // are secret until the MAC verdict. They are words under masks: an
    // Int's arithmetic tests its range.
    cbc := false
    cbc_len := 0
    content_len := U64{0}
    correct := ctime.ct_true()
    if mode == {
        // The only stream cipher is NULL, off in this configuration.
        .Stream -> return Err(.InternalError)
        .AEAD -> {
            dynamic_iv := rec.ctr.copy()
            if ssl_transform_aead_dynamic_iv_is_explicit(t) {
                if rec.data_len < 8 -> return Err(.InvalidMac)
                dynamic_iv = ssldefs.ssl_bytes_of(buf, data, 8)
                data += 8
                rec.data_offset += 8
                rec.data_len -= 8
            }
            if rec.data_len < t.taglen -> return Err(.InvalidMac)
            rec.data_len -= t.taglen
            iv := ssl_build_record_nonce(t.iv_dec, t.fixed_ivlen, dynamic_iv, 0, 8)
            add_data: ssl_extract_add_data_from_record(rec, t.tls_version, t.taglen)
            sealed := ssldefs.ssl_bytes_of(buf, data, rec.data_len + t.taglen)
            plain := [U8]{}
            if &t.cipher_dec == {
                .Val(c) -> {
                    if layer.cipher_auth_decrypt_ext(c, ssldefs.ssl_bytes_of(iv, 0, t.ivlen), add_data, sealed, t.taglen) == {
                        .Ok(p) -> plain = p
                        .Err(e) -> {
                            if e == .AuthFailed -> return Err(.InvalidMac)
                            return Err(.Cipher(e))
                        }
                    }
                }
                None -> return Err(.InternalError)
            }
            auth_done += 1
            if plain.len() != rec.data_len -> return Err(.InternalError)
            ssldefs.ssl_copy_into(buf, data, plain, 0, plain.len())
            ssldefs.ssl_wipe(plain)
        }
        .CBC | .CBCETM -> {
            // The ciphertext is prefixed with the CBC IV.
            minlen: t.ivlen
            if rec.data_len < minlen + t.ivlen || rec.data_len < minlen + t.maclen + 1 -> return Err(.InvalidMac)
            if mode == .CBCETM {
                rec.data_len -= t.maclen
                add_data: ssl_extract_add_data_from_record(rec, t.tls_version, t.taglen)
                mac_expect := ssl_mac_of(t.md_dec, add_data, buf, data, rec.data_len) ?? return Err(.InternalError)
                differs: ctime.memcmp(buf, data + rec.data_len, mac_expect, 0, t.maclen) != 0
                ssldefs.ssl_wipe(mac_expect)
                if differs -> return Err(.InvalidMac)
                auth_done += 1
            }
            if rec.data_len %% t.ivlen != 0 -> return Err(.InvalidMac)
            ssldefs.ssl_copy_into(t.iv_dec, 0, buf, data, t.ivlen)
            data += t.ivlen
            rec.data_offset += t.ivlen
            rec.data_len -= t.ivlen
            enc := ssldefs.ssl_bytes_of(buf, data, rec.data_len)
            dec := [U8]{}
            if &t.cipher_dec == {
                .Val(c) -> dec = layer.cipher_crypt(c, ssldefs.ssl_bytes_of(t.iv_dec, 0, t.ivlen), enc) ?? return Err(.Cipher(err))
                None -> return Err(.InternalError)
            }
            if dec.len() != rec.data_len -> return Err(.InternalError)
            ssldefs.ssl_copy_into(buf, data, dec, 0, dec.len())
            ssldefs.ssl_wipe(dec)
            cbc = true
            cbc_len = rec.data_len
            len: U64{cbc_len}
            pad: U64{buf[data + cbc_len - 1]}
            need: U64{if auth_done == 1 -> 1 else -> t.maclen + 1}
            ge: ctime.uint_ge(len, pad.wrapping_add(need))
            correct = ctime.bool_and(ge, correct)
            padlen: ctime.if_else_0(ge, pad).wrapping_add(U64{1})
            // Always read min(256, plaintext length) bytes at the end of
            // the plaintext, counting only the last padlen for the check.
            pad_count := U64{0}
            padding_idx: len.wrapping_sub(padlen)
            num_checks: if cbc_len <= 256 -> cbc_len else -> 256
            start_idx: cbc_len - num_checks
            loop idx in start_idx..<cbc_len {
                a: ctime.uint_ge(U64{idx}, padding_idx)
                b: ctime.uint_eq(U64{buf[data + idx]}, padlen.wrapping_sub(U64{1}))
                pad_count = pad_count.wrapping_add(ctime.if_else_0(ctime.bool_and(a, b), U64{1}))
            }
            correct = ctime.bool_and(ctime.uint_eq(pad_count, padlen), correct)
            content_len = len.wrapping_sub(ctime.if_else_0(correct, padlen))
        }
    }
    if auth_done == 0 {
        // Compute the MAC whatever the padding result (RFC 4346, CBCTIME),
        // over the secret content length.
        content_len = content_len.wrapping_sub(U64{t.maclen})
        // The extremes of that length over every padlen, from the public
        // length before the padding came off (mbedtls's data_len + padlen,
        // the same value).
        max_len: cbc_len - t.maclen
        min_len: if max_len > 256 -> max_len - 256 else -> 0
        // The additional data's length field is the secret length, its
        // two bytes written from the word.
        rec.data_len = max_len
        add_data := ssl_extract_add_data_from_record(rec, t.tls_version, t.taglen)
        at: add_data.len() - 2
        add_data[at] = wrapping(U8{content_len >> 8})
        add_data[at + 1] = wrapping(U8{content_len})
        mac_expect := [U8]{}
        if t.md_dec == {
            .Val(key) -> mac_expect = ssl_ct_hmac(key, add_data, buf, data, content_len, min_len, max_len)
            None -> return Err(.InternalError)
        }
        mac_peer := ssldefs.ssl_zeros(ssldefs.SSL_MAC_ADD)
        ctime.memcpy_offset(mac_peer, 0, buf, data, content_len, min_len, max_len, t.maclen)
        if ctime.memcmp(mac_peer, 0, mac_expect, 0, t.maclen) != 0 -> correct = ctime.ct_false()
        auth_done += 1
        ssldefs.ssl_wipe(mac_peer)
        ssldefs.ssl_wipe(mac_expect)
    }
    if !ssl_record_authentic(correct) -> return Err(.InvalidMac)
    if auth_done != 1 -> return Err(.InternalError)
    if cbc -> rec.data_len = ssl_authentic_len(content_len)
    if t.tls_version == ssldefs.SSL_VERSION_TLS1_3 {
        // Remove the inner padding and take the true content type.
        if !ssl_parse_inner_plaintext(rec, buf) -> return Err(.InvalidRecord)
    }
    if rec.cid_len != 0 {
        if !ssl_parse_inner_plaintext(rec, buf) -> return Err(.InvalidRecord)
    }
}

/// The verdict of a CBC record's padding and MAC checks, revealed once both
/// are done: a record that fails is refused whatever went wrong in it.
ssl_record_authentic: fn(correct: ctime.CtCond) -> Bool Never! { ctime.cond_is_true(correct) }

/// A CBC record's content length, revealed once its MAC verdict is true:
/// an authentic record's length is the one its sender chose, which the
/// receiver hands on (a record is at most 2^14 + 2048 bytes).
ssl_authentic_len: fn(len: U64) -> Int Never! { Int{wrapping(U32{len})} }

// ---------------------------------------------------------------------------
// Context helpers (ssl_misc.h).

ssl_is_dtls: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl.conf.transport == ssldefs.SSL_TRANSPORT_DATAGRAM }

/// mbedtls_ssl_is_handshake_over.
ssl_is_handshake_over: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl.state >= ssldefs.SSL_HANDSHAKE_OVER }

/// mbedtls_ssl_handshake_set_state.
ssl_handshake_set_state: fn(ssl: &ssldefs.SSLContext, state: Int) Never! { ssl.state = state }

/// mbedtls_ssl_handshake_increment_state.
ssl_handshake_increment_state: fn(ssl: &ssldefs.SSLContext) Never! { ssl.state += 1 }

/// The length of a record header's epoch (mbedtls_ssl_ep_len).
ssl_ep_len: fn(ssl: ssldefs.SSLContext) -> Int Never! { if ssl_is_dtls(ssl) -> 2 else -> 0 }

/// mbedtls_ssl_in_hdr_len.
ssl_in_hdr_len: fn(ssl: ssldefs.SSLContext) -> Int Never! { if ssl_is_dtls(ssl) -> 13 else -> 5 }

/// mbedtls_ssl_out_hdr_len.
ssl_out_hdr_len: fn(ssl: ssldefs.SSLContext) -> Int Never! { ssl.out_iv - ssl.out_hdr }

/// mbedtls_ssl_hs_hdr_len.
ssl_hs_hdr_len: fn(ssl: ssldefs.SSLContext) -> Int Never! { if ssl_is_dtls(ssl) -> 12 else -> 4 }

/// The count of records with a bad MAC seen, which only DTLS keeps
/// (mbedtls_ssl_get_badmac_seen).
ssl_get_badmac_seen: fn(ssl: ssldefs.SSLContext) -> Int Never! {
    if ssl_is_dtls(ssl) -> return ssl.badmac_seen_or_in_hsfraglen
    0
}

/// mbedtls_ssl_set_badmac_seen.
ssl_set_badmac_seen: fn(ssl: &ssldefs.SSLContext, badmac_seen: Int) ssldefs.SSLError! {
    if !ssl_is_dtls(ssl) -> return Err(.CorruptionDetected)
    ssl.badmac_seen_or_in_hsfraglen = badmac_seen
}

/// How much of a fragmented TLS handshake message is gathered, which only
/// TLS keeps (mbedtls_ssl_get_in_hsfraglen).
ssl_get_in_hsfraglen: fn(ssl: ssldefs.SSLContext) -> Int Never! {
    if ssl_is_dtls(ssl) -> return 0
    ssl.badmac_seen_or_in_hsfraglen
}

/// mbedtls_ssl_set_in_hsfraglen.
ssl_set_in_hsfraglen: fn(ssl: &ssldefs.SSLContext, in_hsfraglen: Int) ssldefs.SSLError! {
    if ssl_is_dtls(ssl) -> return Err(.CorruptionDetected)
    ssl.badmac_seen_or_in_hsfraglen = in_hsfraglen
}

/// Write the record version of `tls_version` at buf[off] in the
/// transport's form; DTLS versions are the one's complement of their
/// offset from 1.0 (mbedtls_ssl_write_version).
ssl_write_version: fn(buf: &[U8], off: Int, transport: Int, tls_version: Int) Never! {
    formatted := tls_version
    if transport == ssldefs.SSL_TRANSPORT_DATAGRAM {
        sub: if tls_version == 0x0302 -> 0x0202 else -> 0x0201
        formatted = (tls_version - sub).bit_xor(0xFFFF).bit_and(0xFFFF)
    }
    ssldefs.ssl_put_u16(buf, off, formatted)
}

/// The protocol version of the record version at buf[off]
/// (mbedtls_ssl_read_version).
ssl_read_version: fn(buf: [U8], off: Int, transport: Int) -> Int Never! {
    tls_version := ssldefs.ssl_get_u16(buf, off)
    if transport == ssldefs.SSL_TRANSPORT_DATAGRAM {
        sub: if tls_version == 0xFEFF -> 0x0202 else -> 0x0201
        tls_version = (tls_version - sub).bit_xor(0xFFFF).bit_and(0xFFFF)
    }
    tls_version
}

// ---------------------------------------------------------------------------
// f_recv and f_send over the context's SSLBio.

/// f_recv into in_buf[off..<off+len]: the count of bytes read, 0 at end of
/// file, or WantRead when nothing is queued. A DTLS read takes one whole
/// datagram, truncated to `len` as a datagram socket's recv truncates it.
ssl_bio_recv: fn(ssl: &ssldefs.SSLContext, off: Int, len: Int) -> Int ssldefs.SSLError! {
    if ssl_is_dtls(ssl) {
        if ssl.bio.rx_dgrams.len() == 0 {
            if ssl.bio.rx_eof -> return 0
            return Err(.WantRead)
        }
        dgram: ssl.bio.rx_dgrams.remove(0, .Slot) ?? return Err(.InternalError)
        n: if dgram.len() < len -> dgram.len() else -> len
        ssldefs.ssl_copy_into(ssl.in_buf, off, dgram, 0, n)
        return n
    }
    avail: ssl.bio.rx.len() - ssl.bio.rx_off
    if avail == 0 {
        if ssl.bio.rx_eof -> return 0
        return Err(.WantRead)
    }
    n: if avail < len -> avail else -> len
    ssldefs.ssl_copy_into(ssl.in_buf, off, ssl.bio.rx, ssl.bio.rx_off, n)
    ssl.bio.rx_off += n
    if ssl.bio.rx_off == ssl.bio.rx.len() {
        ssl.bio.rx = [U8]{}
        ssl.bio.rx_off = 0
    }
    n
}

/// f_send of out_buf[off..<off+len]: the count of bytes taken, or
/// WantWrite when `tx_room` has no room left. A DTLS write queues one whole
/// datagram or nothing.
ssl_bio_send: fn(ssl: &ssldefs.SSLContext, off: Int, len: Int) -> Int ssldefs.SSLError! {
    n := len
    if ssl.bio.tx_room >= 0 {
        if ssl.bio.tx_room == 0 -> return Err(.WantWrite)
        if ssl.bio.tx_room < n {
            if ssl_is_dtls(ssl) -> return Err(.WantWrite)
            n = ssl.bio.tx_room
        }
        ssl.bio.tx_room -= n
    }
    if ssl_is_dtls(ssl) {
        ssl.bio.tx_dgrams.push(ssldefs.ssl_bytes_of(ssl.out_buf, off, n))
    } else {
        loop i in 0..<n -> ssl.bio.tx.push(ssl.out_buf[off + i])
    }
    n
}

// ---------------------------------------------------------------------------
// Datagram sizes and the retransmission timeout.

ssl_get_maximum_datagram_size: fn(ssl: ssldefs.SSLContext) -> Int Never! {
    mtu: ssltls.ssl_get_current_mtu(ssl)
    if mtu != 0 && mtu < ssldefs.SSL_OUT_BUFFER_LEN -> return mtu
    ssldefs.SSL_OUT_BUFFER_LEN
}

ssl_get_remaining_space_in_datagram: fn(ssl: ssldefs.SSLContext) -> Int ssldefs.SSLError! {
    bytes_written: ssl.out_left
    mtu: ssl_get_maximum_datagram_size(ssl)
    if bytes_written > mtu -> return Err(.InternalError)
    mtu - bytes_written
}

/// How much more record payload fits in the datagram being assembled:
/// within the MFL, and leaving room for the record expansion.
ssl_get_remaining_payload_in_datagram: fn(ssl: ssldefs.SSLContext) -> Int ssldefs.SSLError! {
    max_len := ssldefs.SSL_OUT_CONTENT_LEN
    mfl: ssltls.ssl_get_output_max_frag_len(ssl)
    if max_len > mfl -> max_len = mfl
    // Never write datagrams larger than MFL + record expansion (RFC 6066 4).
    if max_len <= ssl.out_left -> return 0
    max_len -= ssl.out_left
    remaining := ssl_get_remaining_space_in_datagram(ssl) ?? return Err(err)
    expansion: ssl_get_record_expansion(ssl) ?? return Err(err)
    if remaining <= expansion -> return 0
    remaining -= expansion
    if remaining >= max_len -> remaining = max_len
    remaining
}

/// Double the retransmit timeout within hs_timeout_max; false when it is
/// already there (ssl_double_retransmit_timeout's -1). After the first
/// retransmission the MTU falls back to 508 bytes (RFC 6347 4.1.1.1).
ssl_double_retransmit_timeout: fn(ssl: &ssldefs.SSLContext) -> Bool Never! {
    if ssl.handshake.retransmit_timeout >= ssl.conf.hs_timeout_max -> return false
    if ssl.handshake.retransmit_timeout != ssl.conf.hs_timeout_min -> ssl.handshake.mtu = 508
    new_timeout := 2 * ssl.handshake.retransmit_timeout
    // uint32_t arithmetic: a doubling past 2^32 wraps below the old value.
    if new_timeout > 0xFFFFFFFF || new_timeout > ssl.conf.hs_timeout_max -> new_timeout = ssl.conf.hs_timeout_max
    ssl.handshake.retransmit_timeout = new_timeout
    true
}

ssl_reset_retransmit_timeout: fn(ssl: &ssldefs.SSLContext) Never! {
    ssl.handshake.retransmit_timeout = ssl.conf.hs_timeout_min
}

// ---------------------------------------------------------------------------
// Reading and flushing.

/// Read until `nb_want` bytes are at in_hdr (mbedtls_ssl_fetch_input). TLS
/// then has exactly nb_want; DTLS reads a whole datagram, which may hold
/// more, and the caller sets next_record_offset when done with a record.
/// An expired DTLS timer during a handshake retransmits the flight.
ssl_fetch_input: fn<R: RNG>(ssl: &ssldefs.SSLContext, nb_want: Int, rng: &R) ssldefs.SSLError! {
    if nb_want > ssldefs.SSL_IN_BUFFER_LEN - ssl.in_hdr -> return Err(.BadInputData)
    if ssl_is_dtls(ssl) {
        // Move to the next record in the datagram already read.
        if ssl.next_record_offset != 0 {
            if ssl.in_left < ssl.next_record_offset -> return Err(.InternalError)
            ssl.in_left -= ssl.next_record_offset
            if ssl.in_left != 0 -> ssldefs.ssl_move_within(ssl.in_buf, ssl.in_hdr, ssl.in_hdr + ssl.next_record_offset, ssl.in_left)
            ssl.next_record_offset = 0
        }
        if nb_want <= ssl.in_left -> return
        // A record cannot span datagrams.
        if ssl.in_left != 0 -> return Err(.InternalError)
        // Do not read once the timer has expired, so dropped records
        // cannot hold the timer off.
        if ssl_check_timer(ssl) {
            ssl_set_timer(ssl, 0)
            if ssl.state != ssldefs.SSL_HANDSHAKE_OVER {
                if !ssl_double_retransmit_timeout(ssl) -> return Err(.Timeout)
                ssl_resend(ssl, rng) ?? return Err(err)
                return Err(.WantRead)
            } else if ssl.conf.endpoint == ssldefs.SSL_IS_SERVER && ssl.renego_status == ssldefs.SSL_RENEGOTIATION_PENDING {
                ssltls.ssl_resend_hello_request(ssl, rng) ?? return Err(err)
                return Err(.WantRead)
            }
            return Err(.Timeout)
        }
        got: ssl_bio_recv(ssl, ssl.in_hdr, ssldefs.SSL_IN_BUFFER_LEN - ssl.in_hdr) ?? return Err(err)
        if got == 0 -> return Err(.ConnEOF)
        ssl.in_left = got
        return
    }
    loop ssl.in_left < nb_want {
        len: nb_want - ssl.in_left
        if ssl_check_timer(ssl) -> return Err(.Timeout)
        got: ssl_bio_recv(ssl, ssl.in_hdr + ssl.in_left, len) ?? return Err(err)
        if got == 0 -> return Err(.ConnEOF)
        if got > len -> return Err(.InternalError)
        ssl.in_left += got
    }
}

/// Send the out_left bytes written before out_hdr
/// (mbedtls_ssl_flush_output).
ssl_flush_output: fn(ssl: &ssldefs.SSLContext) ssldefs.SSLError! {
    if ssl.out_left == 0 -> return
    loop ssl.out_left > 0 {
        sent: ssl_bio_send(ssl, ssl.out_hdr - ssl.out_left, ssl.out_left) ?? return Err(err)
        if sent <= 0 -> return
        if sent > ssl.out_left -> return Err(.InternalError)
        ssl.out_left -= sent
    }
    ssl.out_hdr = if ssl_is_dtls(ssl) -> 0 else -> 8
    ssl_update_out_pointers(ssl, ssl.transform_out)
}

// ---------------------------------------------------------------------------
// The DTLS retransmission state machine.

/// Append the current handshake message to the outgoing flight
/// (ssl_flight_append).
ssl_flight_append: fn(ssl: &ssldefs.SSLContext) Never! {
    ssl.handshake.flight.push(ssldefs.SSLFlightItem{p: ssldefs.ssl_bytes_of(ssl.out_buf, ssl.out_msg, ssl.out_msglen), mtype: ssl.out_msgtype})
}

/// mbedtls_ssl_flight_free.
ssl_flight_free: fn(hs: &ssldefs.SSLHandshake) Never! { hs.flight = [ssldefs.SSLFlightItem]{} }

/// Swap transform_out and the out counter with the alternative ones
/// (ssl_swap_epochs).
ssl_swap_epochs: fn(ssl: &ssldefs.SSLContext) Never! {
    if ssl.transform_out == ssl.handshake.alt_transform_out -> return
    tmp_transform: ssl.transform_out
    ssl.transform_out = ssl.handshake.alt_transform_out
    ssl.handshake.alt_transform_out = tmp_transform
    tmp_out_ctr := ssl.cur_out_ctr.copy()
    ssl.cur_out_ctr = ssl.handshake.alt_out_ctr.copy()
    ssl.handshake.alt_out_ctr = tmp_out_ctr
    ssl_update_out_pointers(ssl, ssl.transform_out)
}

/// mbedtls_ssl_resend.
ssl_resend: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! { ssl_flight_transmit(ssl, rng) }

/// Transmit or retransmit the current flight, fragmenting handshake
/// messages to the datagram room (mbedtls_ssl_flight_transmit). The
/// message and offset reached are kept, so a WantWrite resumes there; it
/// is called until the state leaves SENDING.
ssl_flight_transmit: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    if ssl.handshake.retransmit_state != ssldefs.SSL_RETRANS_SENDING {
        ssl.handshake.cur_msg = if ssl.handshake.flight.len() == 0 -> -1 else -> 0
        ssl.handshake.cur_msg_p = 12
        ssl_swap_epochs(ssl)
        ssl.handshake.retransmit_state = ssldefs.SSL_RETRANS_SENDING
    }
    loop ssl.handshake.cur_msg >= 0 {
        ci: ssl.handshake.cur_msg
        cur_type: ssl.handshake.flight[ci].mtype
        cur_len: ssl.handshake.flight[ci].p.len()
        is_finished: cur_type == ssldefs.SSL_MSG_HANDSHAKE && ssldefs.ssl_u8(ssl.handshake.flight[ci].p, 0) == ssldefs.SSL_HS_FINISHED
        force_flush: ssl.disable_datagram_packing == 1
        // Swap epochs before sending Finished, not after the CCS, in case
        // the write returns WantRead; before copying, as it moves out_msg.
        if is_finished && ssl.handshake.cur_msg_p == 12 -> ssl_swap_epochs(ssl)
        max_frag_len: ssl_get_remaining_payload_in_datagram(ssl) ?? return Err(err)
        // A CCS is copied as is; handshake messages may be fragmented.
        if cur_type == ssldefs.SSL_MSG_CHANGE_CIPHER_SPEC {
            if max_frag_len == 0 {
                ssl_flush_output(ssl) ?? return Err(err)
                next
            }
            ssldefs.ssl_copy_into(ssl.out_buf, ssl.out_msg, ssl.handshake.flight[ci].p, 0, cur_len)
            ssl.out_msglen = cur_len
            ssl.out_msgtype = cur_type
            ssl.handshake.cur_msg_p += cur_len
        } else {
            p: ssl.handshake.cur_msg_p
            hs_len: cur_len - 12
            frag_off: p - 12
            rem_len: hs_len - frag_off
            if max_frag_len < 12 || (max_frag_len == 12 && hs_len != 0) {
                if is_finished -> ssl_swap_epochs(ssl)
                ssl_flush_output(ssl) ?? return Err(err)
                next
            }
            max_hs_frag_len: max_frag_len - 12
            cur_hs_frag_len: if rem_len > max_hs_frag_len -> max_hs_frag_len else -> rem_len
            // Messages are kept with unfragmented headers: copy type,
            // length and message_seq, then fill the fragment fields.
            ssldefs.ssl_copy_into(ssl.out_buf, ssl.out_msg, ssl.handshake.flight[ci].p, 0, 6)
            ssldefs.ssl_put_u24(ssl.out_buf, ssl.out_msg + 6, frag_off)
            ssldefs.ssl_put_u24(ssl.out_buf, ssl.out_msg + 9, cur_hs_frag_len)
            ssldefs.ssl_copy_into(ssl.out_buf, ssl.out_msg + 12, ssl.handshake.flight[ci].p, p, cur_hs_frag_len)
            ssl.out_msglen = cur_hs_frag_len + 12
            ssl.out_msgtype = cur_type
            ssl.handshake.cur_msg_p += cur_hs_frag_len
        }
        // Done with this message: on to the next, if any.
        if ssl.handshake.cur_msg_p >= cur_len {
            if ci + 1 < ssl.handshake.flight.len() {
                ssl.handshake.cur_msg = ci + 1
                ssl.handshake.cur_msg_p = 12
            } else {
                ssl.handshake.cur_msg = -1
                ssl.handshake.cur_msg_p = 0
            }
        }
        ssl_write_record(ssl, force_flush, rng) ?? return Err(err)
    }
    ssl_flush_output(ssl) ?? return Err(err)
    if ssl_is_handshake_over(ssl) {
        ssl.handshake.retransmit_state = ssldefs.SSL_RETRANS_FINISHED
    } else {
        ssl.handshake.retransmit_state = ssldefs.SSL_RETRANS_WAITING
        ssl_set_timer(ssl, ssl.handshake.retransmit_timeout)
    }
}

/// Whether the current incoming message is a Finished.
ssl_in_msg_is_finished: fn(ssl: ssldefs.SSLContext) -> Bool Never! {
    ssl.in_msgtype == ssldefs.SSL_MSG_HANDSHAKE && ssldefs.ssl_u8(ssl.in_buf, ssl.in_msg) == ssldefs.SSL_HS_FINISHED
}

/// The last message of an incoming flight is in
/// (mbedtls_ssl_recv_flight_completed).
ssl_recv_flight_completed: fn(ssl: &ssldefs.SSLContext) Never! {
    // That flight need not be resent any more.
    ssl_flight_free(ssl.handshake)
    ssl.handshake.cur_msg = -1
    // The next incoming flight starts with this msg_seq.
    ssl.handshake.in_flight_start_seq = ssl.handshake.in_msg_seq
    // CCSs are not remembered across flights.
    ssl.handshake.seen_ccs = 0
    ssl_buffering_free(ssl)
    ssl_set_timer(ssl, 0)
    if ssl_in_msg_is_finished(ssl) {
        ssl.handshake.retransmit_state = ssldefs.SSL_RETRANS_FINISHED
    } else {
        ssl.handshake.retransmit_state = ssldefs.SSL_RETRANS_PREPARING
    }
}

/// The last message of an outgoing flight is sent
/// (mbedtls_ssl_send_flight_completed).
ssl_send_flight_completed: fn(ssl: &ssldefs.SSLContext) Never! {
    ssl_reset_retransmit_timeout(ssl)
    ssl_set_timer(ssl, ssl.handshake.retransmit_timeout)
    if ssl_in_msg_is_finished(ssl) {
        ssl.handshake.retransmit_state = ssldefs.SSL_RETRANS_FINISHED
    } else {
        ssl.handshake.retransmit_state = ssldefs.SSL_RETRANS_WAITING
    }
}

// ---------------------------------------------------------------------------
// Handshake messages.

/// Begin a handshake message of `hs_type` (mbedtls_ssl_start_handshake_msg):
/// the offset in out_buf its body starts at, which has
/// SSL_OUT_CONTENT_LEN - 4 bytes of room.
ssl_start_handshake_msg: fn(ssl: &ssldefs.SSLContext, hs_type: Int) -> Int Never! {
    ssl.out_msgtype = ssldefs.SSL_MSG_HANDSHAKE
    ssl.out_buf[ssl.out_msg] = ssldefs.ssl_byte(hs_type)
    ssl.out_msg + 4
}

/// Write, or in DTLS queue in the flight, the current handshake or CCS
/// message (mbedtls_ssl_write_handshake_msg_ext): fill in its handshake
/// header and add it to the transcript when `update_checksum`. DTLS sends
/// only a HelloRequest at once; the rest go at flight_transmit.
ssl_write_handshake_msg_ext: fn<R: RNG>(ssl: &ssldefs.SSLContext, update_checksum: Bool, force_flush: Bool, rng: &R) ssldefs.SSLError! {
    hs_len: ssl.out_msglen - 4
    hs_type: ssldefs.ssl_u8(ssl.out_buf, ssl.out_msg)
    if ssl.out_msgtype != ssldefs.SSL_MSG_HANDSHAKE && ssl.out_msgtype != ssldefs.SSL_MSG_CHANGE_CIPHER_SPEC -> return Err(.InternalError)
    is_hello_request: ssl.out_msgtype == ssldefs.SSL_MSG_HANDSHAKE && hs_type == ssldefs.SSL_HS_HELLO_REQUEST
    // Anything but a HelloRequest is sent within a handshake.
    if !is_hello_request && !ssl.has_handshake -> return Err(.InternalError)
    if ssl_is_dtls(ssl) && ssl.has_handshake && ssl.handshake.retransmit_state == ssldefs.SSL_RETRANS_SENDING -> return Err(.InternalError)
    // The message writers keep to the buffer; check it all the same.
    if ssl.out_msglen > ssldefs.SSL_OUT_CONTENT_LEN -> return Err(.InternalError)
    if ssl.out_msgtype == ssldefs.SSL_MSG_HANDSHAKE {
        ssldefs.ssl_put_u24(ssl.out_buf, ssl.out_msg + 1, hs_len)
        // DTLS adds message_seq, fragment_offset and fragment_length.
        if ssl_is_dtls(ssl) {
            if ssldefs.SSL_OUT_CONTENT_LEN - ssl.out_msglen < 8 -> return Err(.BadInputData)
            ssldefs.ssl_move_within(ssl.out_buf, ssl.out_msg + 12, ssl.out_msg + 4, hs_len)
            ssl.out_msglen += 8
            if hs_type != ssldefs.SSL_HS_HELLO_REQUEST {
                ssldefs.ssl_put_u16(ssl.out_buf, ssl.out_msg + 4, ssl.handshake.out_msg_seq)
                ssl.handshake.out_msg_seq += 1
            } else {
                ssldefs.ssl_put_u16(ssl.out_buf, ssl.out_msg + 4, 0)
            }
            // The transcript has the message unfragmented: offset 0 and
            // fragment length hs_len for now.
            ssldefs.ssl_fill(ssl.out_buf, ssl.out_msg + 6, 3, U8{0})
            ssldefs.ssl_move_within(ssl.out_buf, ssl.out_msg + 9, ssl.out_msg + 1, 3)
        }
        if hs_type != ssldefs.SSL_HS_HELLO_REQUEST && update_checksum -> ssltls.ssl_update_checksum(ssl.handshake, ssl.out_buf, ssl.out_msg, ssl.out_msglen)
    }
    if ssl_is_dtls(ssl) && !is_hello_request {
        ssl_flight_append(ssl)
    } else {
        ssl_write_record(ssl, force_flush, rng) ?? return Err(err)
    }
}

/// mbedtls_ssl_write_handshake_msg.
ssl_write_handshake_msg: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    ssl_write_handshake_msg_ext(ssl, true, true, rng) ?? return Err(err)
}

/// Finish a message begun with ssl_start_handshake_msg whose body is
/// `msg_len` bytes (mbedtls_ssl_finish_handshake_msg). The caller has
/// added it to the transcript.
ssl_finish_handshake_msg: fn<R: RNG>(ssl: &ssldefs.SSLContext, msg_len: Int, rng: &R) ssldefs.SSLError! {
    ssl.out_msglen = msg_len + 4
    ssl_write_handshake_msg_ext(ssl, false, false, rng) ?? return Err(err)
}

// ---------------------------------------------------------------------------
// Writing records.

/// Write the current record: out_msgtype, out_msglen bytes at out_msg
/// (mbedtls_ssl_write_record). It is protected under transform_out and
/// appended to the output; DTLS packs records into a datagram until it is
/// full or `force_flush`.
ssl_write_record: fn<R: RNG>(ssl: &ssldefs.SSLContext, force_flush: Bool, rng: &R) ssldefs.SSLError! {
    len := ssl.out_msglen
    flush := force_flush
    // The content type is written after encryption, which a CID changes.
    // TLS 1.3 records carry the TLS 1.2 version.
    tls_ver := ssl.tls_version
    if tls_ver == ssldefs.SSL_VERSION_TLS1_3 -> tls_ver = ssldefs.SSL_VERSION_TLS1_2
    ssl_write_version(ssl.out_buf, ssl.out_hdr + 1, ssl.conf.transport, tls_ver)
    ssldefs.ssl_copy_into(ssl.out_buf, ssl.out_ctr, ssl.cur_out_ctr, 0, ssldefs.SSL_SEQUENCE_NUMBER_LEN)
    ssldefs.ssl_put_u16(ssl.out_buf, ssl.out_len, len)
    if ssl.transform_out >= 0 {
        ver := ssldefs.ssl_zeros(2)
        ssl_write_version(ver, 0, ssl.conf.transport, tls_ver)
        // The CID is set by encrypt_buf.
        rec := ssldefs.SSLRecord{
            ctr: ssldefs.ssl_bytes_of(ssl.out_buf, ssl.out_ctr, ssldefs.SSL_SEQUENCE_NUMBER_LEN)
            rtype: ssl.out_msgtype
            ver: ver
            buf_start: ssl.out_iv
            buf_len: ssldefs.SSL_OUT_BUFFER_LEN - ssl.out_iv
            data_offset: ssl.out_msg - ssl.out_iv
            data_len: ssl.out_msglen
            cid_len: 0
        }
        ssl_encrypt_buf(ssl.tpool[ssl.transform_out], rec, ssl.out_buf, rng) ?? return Err(err)
        if rec.data_offset != 0 -> return Err(.InternalError)
        // The record content type and CID encrypt_buf set.
        ssl.out_msgtype = rec.rtype
        ssldefs.ssl_copy_into(ssl.out_buf, ssl.out_cid, rec.cid, 0, rec.cid_len)
        len = rec.data_len
        ssl.out_msglen = len
        ssldefs.ssl_put_u16(ssl.out_buf, ssl.out_len, rec.data_len)
    }
    protected_record_size: len + ssl_out_hdr_len(ssl)
    // DTLS: the record must fit the room left in the datagram.
    if ssl_is_dtls(ssl) {
        room: ssl_get_remaining_space_in_datagram(ssl) ?? return Err(err)
        if protected_record_size > room -> return Err(.InternalError)
    }
    ssl.out_buf[ssl.out_hdr] = ssldefs.ssl_byte(ssl.out_msgtype)
    ssl.out_left += protected_record_size
    ssl.out_hdr += protected_record_size
    ssl_update_out_pointers(ssl, ssl.transform_out)
    ep: ssl_ep_len(ssl)
    i := 8
    loop i > ep {
        ssl.cur_out_ctr[i - 1] = ssldefs.ssl_byte(Int.from_u8(ssl.cur_out_ctr[i - 1]) + 1)
        if ssl.cur_out_ctr[i - 1] != (U8{0}) -> break
        i -= 1
    }
    // The loop runs to its end when the counter wraps.
    if i == ep -> return Err(.CounterWrapping)
    if ssl_is_dtls(ssl) && !flush {
        remaining: ssl_get_remaining_payload_in_datagram(ssl) ?? return Err(err)
        if remaining == 0 -> flush = true
    }
    if flush -> ssl_flush_output(ssl) ?? return Err(err)
}

// ---------------------------------------------------------------------------
// Record pointers. Each "pointer" is an offset into in_buf or out_buf; TLS
// keeps the implicit record sequence number in the 8 bytes before the header.

/// Set the out_* offsets from out_hdr for records under `transform`, a
/// transform pool index or -1 for none (mbedtls_ssl_update_out_pointers).
ssl_update_out_pointers: fn(ssl: &ssldefs.SSLContext, transform: Int) Never! {
    if ssl_is_dtls(ssl) {
        ssl.out_ctr = ssl.out_hdr + 3
        ssl.out_cid = ssl.out_ctr + ssldefs.SSL_SEQUENCE_NUMBER_LEN
        ssl.out_len = ssl.out_cid
        if transform >= 0 -> ssl.out_len += ssl.tpool[transform].out_cid.len()
        ssl.out_iv = ssl.out_len + 2
    } else {
        ssl.out_len = ssl.out_hdr + 3
        ssl.out_cid = ssl.out_len
        ssl.out_iv = ssl.out_hdr + 5
    }
    ssl.out_msg = ssl.out_iv
    // Room for the explicit IV, if the transform has one.
    if transform >= 0 -> ssl.out_msg += ssl.tpool[transform].ivlen - ssl.tpool[transform].fixed_ivlen
}

/// Set the in_* offsets from in_hdr for an unprotected record with no CID;
/// decryption moves in_msg to the plaintext (mbedtls_ssl_update_in_pointers).
ssl_update_in_pointers: fn(ssl: &ssldefs.SSLContext) Never! {
    if ssl_is_dtls(ssl) {
        ssl.in_ctr = ssl.in_hdr + 3
        ssl.in_cid = ssl.in_ctr + ssldefs.SSL_SEQUENCE_NUMBER_LEN
        ssl.in_len = ssl.in_cid
        ssl.in_iv = ssl.in_len + 2
    } else {
        ssl.in_ctr = 0
        ssl.in_len = ssl.in_hdr + 3
        ssl.in_cid = ssl.in_len
        ssl.in_iv = ssl.in_hdr + 5
    }
    ssl.in_msg = ssl.in_iv
}

/// mbedtls_ssl_reset_in_pointers.
ssl_reset_in_pointers: fn(ssl: &ssldefs.SSLContext) Never! {
    if ssl_is_dtls(ssl) -> ssl.in_hdr = 0 else -> ssl.in_hdr = ssldefs.SSL_SEQUENCE_NUMBER_LEN
    ssl_update_in_pointers(ssl)
}

/// mbedtls_ssl_reset_out_pointers.
ssl_reset_out_pointers: fn(ssl: &ssldefs.SSLContext) Never! {
    if ssl_is_dtls(ssl) {
        ssl.out_hdr = 0
    } else {
        ssl.out_ctr = 0
        ssl.out_hdr = ssldefs.SSL_SEQUENCE_NUMBER_LEN
    }
    ssl_update_out_pointers(ssl, -1)
}

/// The count of application data bytes ready to read
/// (mbedtls_ssl_get_bytes_avail).
ssl_get_bytes_avail: fn(ssl: ssldefs.SSLContext) -> Int Never! {
    if ssl.in_offt < 0 -> return 0
    ssl.in_msglen
}

/// Whether read data is pending in the record layer: a held-back message,
/// more records in the datagram, more handshake messages in the record, or
/// unread application data (mbedtls_ssl_check_pending).
ssl_check_pending: fn(ssl: ssldefs.SSLContext) -> Bool Never! {
    if ssl.keep_current_message == 1 -> return true
    if ssl_is_dtls(ssl) && ssl.in_left > ssl.next_record_offset -> return true
    if ssl.in_hslen > 0 && ssl.in_hslen < ssl.in_msglen -> return true
    ssl.in_offt >= 0
}

/// The most bytes protection under transform_out adds to a record,
/// header included (mbedtls_ssl_get_record_expansion).
ssl_get_record_expansion: fn(ssl: ssldefs.SSLContext) -> Int ssldefs.SSLError! {
    out_hdr_len: ssl_out_hdr_len(ssl)
    if ssl.transform_out < 0 -> return out_hdr_len
    tix: ssl.transform_out
    transform_expansion := 0
    if ssl.tpool[tix].cipher_enc == {
        .Val(ctx) -> {
            if ctx.info.mode == {
                .GCM | .CCM | .ChaChaPoly | .Stream -> transform_expansion = ssl.tpool[tix].minlen
                .CBC -> {
                    // The MAC, the padding (never more than a block) and
                    // the explicit IV.
                    block_size: ctx.info.block_size
                    transform_expansion = ssl.tpool[tix].maclen + block_size + block_size
                }
                .ECB | .CFB | .OFB | .CTR | .CCMStarNoTag | .XTS | .KW | .KWP -> return Err(.InternalError)
            }
        }
        // A context with no cipher has no mode.
        None -> return Err(.InternalError)
    }
    if ssl.tpool[tix].out_cid.len() != 0 -> transform_expansion += ssldefs.SSL_MAX_CID_EXPANSION
    out_hdr_len + transform_expansion
}

// ---------------------------------------------------------------------------
// Handshake records.

// The handshake message length, fragment offset and fragment length of the
// DTLS handshake header at in_msg.
ssl_get_hs_total_len: fn(ssl: ssldefs.SSLContext) -> Int Never! { ssldefs.ssl_get_u24(ssl.in_buf, ssl.in_msg + 1) }

ssl_get_hs_frag_off: fn(ssl: ssldefs.SSLContext) -> Int Never! { ssldefs.ssl_get_u24(ssl.in_buf, ssl.in_msg + 6) }

ssl_get_hs_frag_len: fn(ssl: ssldefs.SSLContext) -> Int Never! { ssldefs.ssl_get_u24(ssl.in_buf, ssl.in_msg + 9) }

// Whether the DTLS handshake message at in_msg is a proper fragment of a
// longer message (ssl_hs_is_proper_fragment).
ssl_hs_is_proper_fragment: fn(ssl: ssldefs.SSLContext) -> Bool Never! {
    ssl.in_msglen < ssl.in_hslen || ssl_get_hs_frag_off(ssl) != 0 || !ssldefs.ssl_range_eq(ssl.in_buf, ssl.in_msg + 9, ssl.in_buf, ssl.in_msg + 1, 3)
}

// Whether the DTLS handshake header's fragment lies in its message and in
// the record (ssl_check_hs_header, true where C returns 0).
ssl_check_hs_header: fn(ssl: ssldefs.SSLContext) -> Bool Never! {
    msg_len: ssl_get_hs_total_len(ssl)
    frag_off: ssl_get_hs_frag_off(ssl)
    frag_len: ssl_get_hs_frag_len(ssl)
    if frag_off > msg_len -> return false
    if frag_len > msg_len - frag_off -> return false
    if frag_len + 12 > ssl.in_msglen -> return false
    true
}

// Mark bits offset..<offset+len of the reassembly bitmask at buf[base]
// (ssl_bitmask_set); bit 7 of a byte is its first.
ssl_bitmask_set: fn(buf: &[U8], base: Int, offset0: Int, len0: Int) Never! {
    offset := offset0
    len := len0
    start_bits := 8 - offset %% 8
    if start_bits != 8 {
        first_byte_idx: base + offset /% 8
        if len <= start_bits {
            loop len != 0 {
                buf[first_byte_idx] = ssldefs.ssl_byte(Int.from_u8(buf[first_byte_idx]).bit_or(1 << (start_bits - len)))
                len -= 1
            }
            return
        }
        offset += start_bits
        len -= start_bits
        loop start_bits != 0 {
            buf[first_byte_idx] = ssldefs.ssl_byte(Int.from_u8(buf[first_byte_idx]).bit_or(1 << (start_bits - 1)))
            start_bits -= 1
        }
    }
    end_bits := len %% 8
    if end_bits != 0 {
        last_byte_idx: base + (offset + len) /% 8
        len -= end_bits
        loop end_bits != 0 {
            buf[last_byte_idx] = ssldefs.ssl_byte(Int.from_u8(buf[last_byte_idx]).bit_or(1 << (8 - end_bits)))
            end_bits -= 1
        }
    }
    ssldefs.ssl_fill(buf, base + offset /% 8, len /% 8, U8{0xFF})
}

// Whether the first `len` bits of the bitmask at buf[base] are all set
// (ssl_bitmask_check, true where C returns 0).
ssl_bitmask_check: fn(buf: [U8], base: Int, len: Int) -> Bool Never! {
    loop i in 0..<(len /% 8) {
        if buf[base + i] != (U8{0xFF}) -> return false
    }
    loop i in 0..<(len %% 8) {
        if Int.from_u8(buf[base + len /% 8]).bit_and(1 << (7 - i)) == 0 -> return false
    }
    true
}

// The reassembly buffer for a `msg_len`-byte message body: the header, the
// body and, for fragments, the bitmask (ssl_get_reassembly_buffer_size).
ssl_get_reassembly_buffer_size: fn(msg_len: Int, add_bitmap: Bool) -> Int Never! {
    alloc_len := 12 + msg_len
    if add_bitmap {
        alloc_len += msg_len /% 8
        if msg_len %% 8 != 0 -> alloc_len += 1
    }
    alloc_len
}

/// Check the handshake message at in_msg and set in_hslen
/// (mbedtls_ssl_prepare_handshake_record). DTLS: an out-of-sequence message
/// is dropped (resending the last flight on a repeat of its last message),
/// a future one or a fragment is EarlyMessage for buffering. TLS: fragments
/// are gathered at in_buf[8 + header], ContinueProcessing until complete.
ssl_prepare_handshake_record: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    // The first fragment must hold the header, and with it the length.
    if ssl_get_in_hsfraglen(ssl) == 0 {
        if ssl.in_msglen < ssl_hs_hdr_len(ssl) -> return Err(.InvalidRecord)
        ssl.in_hslen = ssl_hs_hdr_len(ssl) + ssl_get_hs_total_len(ssl)
    }
    if ssl_is_dtls(ssl) {
        recv_msg_seq: ssldefs.ssl_get_u16(ssl.in_buf, ssl.in_msg + 4)
        if !ssl_check_hs_header(ssl) -> return Err(.InvalidRecord)
        hs_type: ssldefs.ssl_u8(ssl.in_buf, ssl.in_msg)
        if hs_type == ssldefs.SSL_HS_CLIENT_HELLO && ssl.conf.endpoint == ssldefs.SSL_IS_SERVER {
            if ssl.state == ssldefs.SSL_CLIENT_HELLO && ssl.renego_status == ssldefs.SSL_INITIAL_HANDSHAKE {
                // The server keeps no state over ClientHello and
                // HelloVerifyRequest round trips, so the first ClientHello
                // it sees sets the expected message sequence numbers.
                if ssl.handshake.in_msg_seq == 0 && recv_msg_seq > 0 {
                    ssl_buffering_shift_slots(ssl, recv_msg_seq)
                    ssl.handshake.in_msg_seq = recv_msg_seq
                    ssl.handshake.out_msg_seq = recv_msg_seq
                }
                // An initial handshake is in epoch 0.
                if ssl.in_buf[ssl.in_ctr] != (U8{0}) || ssl.in_buf[ssl.in_ctr + 1] != (U8{0}) -> return Err(.IllegalParameter)
                ssldefs.ssl_copy_into(ssl.cur_out_ctr, 2, ssl.in_buf, ssl.in_ctr + 2, ssldefs.SSL_SEQUENCE_NUMBER_LEN - 2)
            } else if ssl_is_handshake_over(ssl) {
                // A ClientHello starting a renegotiation has sequence 0.
                if recv_msg_seq != 0 -> return Err(.DecodeError)
            }
        }
        over: ssl_is_handshake_over(ssl)
        if ssl.has_handshake && ((!over && recv_msg_seq != ssl.handshake.in_msg_seq) || (over && hs_type != ssldefs.SSL_HS_CLIENT_HELLO)) {
            if recv_msg_seq > ssl.handshake.in_msg_seq -> return Err(.EarlyMessage)
            // Resend only on the last message of the peer's previous
            // flight; no server resends HelloVerifyRequest.
            if recv_msg_seq == ssl.handshake.in_flight_start_seq - 1 && hs_type != ssldefs.SSL_HS_HELLO_VERIFY_REQUEST {
                ssl_resend(ssl, rng) ?? return Err(err)
            }
            return Err(.ContinueProcessing)
        }
        // in_msg_seq moves on when the message is complete. Fragments
        // are reassembled with the buffering of future messages.
        if ssl_hs_is_proper_fragment(ssl) -> return Err(.EarlyMessage)
        return
    }
    // TLS: move the fragment after the part gathered so far; even a sole
    // fragment moves, onto its explicit IV.
    reassembled_record_start: ssldefs.SSL_SEQUENCE_NUMBER_LEN
    payload_start: reassembled_record_start + ssl_in_hdr_len(ssl)
    in_hsfraglen := ssl_get_in_hsfraglen(ssl)
    payload_end := payload_start + in_hsfraglen
    if payload_end + ssl.in_msglen > ssldefs.SSL_IN_BUFFER_LEN -> return Err(.CorruptionDetected)
    ssldefs.ssl_move_within(ssl.in_buf, payload_end, ssl.in_msg, ssl.in_msglen)
    in_hsfraglen += ssl.in_msglen
    payload_end += ssl.in_msglen
    if in_hsfraglen < ssl.in_hslen {
        ssl.in_hdr = payload_end
        ssl.in_msglen = 0
        ssl_set_in_hsfraglen(ssl, in_hsfraglen) ?? return Err(.CorruptionDetected)
        ssl_update_in_pointers(ssl)
        return Err(.ContinueProcessing)
    }
    ssl.in_msglen = in_hsfraglen
    ssl_set_in_hsfraglen(ssl, 0) ?? return Err(.CorruptionDetected)
    ssl.in_hdr = reassembled_record_start
    ssl_update_in_pointers(ssl)
    // The reassembled record's length; more handshake messages may follow
    // the first in it.
    if ssl.in_msglen > 0xFFFF -> return Err(.CorruptionDetected)
    ssldefs.ssl_put_u16(ssl.in_buf, ssl.in_len, ssl.in_msglen)
}

/// Add the complete handshake message at in_msg to the transcript and, for
/// DTLS, move on to the next message sequence number
/// (mbedtls_ssl_update_handshake_status).
ssl_update_handshake_status: fn(ssl: &ssldefs.SSLContext) Never! {
    if !ssl_is_handshake_over(ssl) && ssl.has_handshake {
        ssltls.ssl_update_checksum(ssl.handshake, ssl.in_buf, ssl.in_msg, ssl.in_hslen)
    }
    if ssl_is_dtls(ssl) && ssl.has_handshake {
        ssl.handshake.in_msg_seq += 1
        ssl_buffering_shift_slots(ssl, 1)
    }
}

// ---------------------------------------------------------------------------
// DTLS anti-replay (RFC 6347 4.1.2.6). Bit n of in_window is set when record
// number in_window_top - n was seen.

/// mbedtls_ssl_dtls_replay_reset.
ssl_dtls_replay_reset: fn(ssl: &ssldefs.SSLContext) Never! {
    ssl.in_window_top = U64{0}
    ssl.in_window = U64{0}
}

// The 48-bit big-endian record number at buf[off].
ssl_load_six_bytes: fn(buf: [U8], off: Int) -> U64 Never! {
    U64{(ssldefs.ssl_get_u16(buf, off) << 32).bit_or(ssldefs.ssl_get_u32(buf, off + 2))}
}

// Whether the record counter ctr[off..<off+8] may be accepted
// (mbedtls_ssl_dtls_record_replay_check).
ssl_dtls_replay_check_ctr: fn(ssl: ssldefs.SSLContext, ctr: [U8], off: Int) -> Bool Never! {
    rec_seqnum: ssl_load_six_bytes(ctr, off + 2)
    if ssl.conf.anti_replay == ssldefs.SSL_ANTI_REPLAY_DISABLED -> return true
    if rec_seqnum > ssl.in_window_top -> return true
    bit: ssl.in_window_top - rec_seqnum
    if bit >= (U64{64}) -> return false
    if ssl.in_window.bit_and(U64{1} << Int.from_u64(bit)) != (U64{0}) -> return false
    true
}

/// Whether the record number at in_ctr may be accepted: true where
/// mbedtls_ssl_dtls_replay_check returns 0, false where it returns -1.
ssl_dtls_replay_check: fn(ssl: ssldefs.SSLContext) -> Bool Never! {
    ssl_dtls_replay_check_ctr(ssl, ssl.in_buf, ssl.in_ctr)
}

/// Record the validated record number at in_ctr in the window
/// (mbedtls_ssl_dtls_replay_update).
ssl_dtls_replay_update: fn(ssl: &ssldefs.SSLContext) Never! {
    rec_seqnum: ssl_load_six_bytes(ssl.in_buf, ssl.in_ctr + 2)
    if ssl.conf.anti_replay == ssldefs.SSL_ANTI_REPLAY_DISABLED -> return
    if rec_seqnum > ssl.in_window_top {
        shift: rec_seqnum - ssl.in_window_top
        if shift >= (U64{64}) {
            ssl.in_window = U64{1}
        } else {
            ssl.in_window = (ssl.in_window << Int.from_u64(shift)).bit_or(U64{1})
        }
        ssl.in_window_top = rec_seqnum
    } else {
        bit: ssl.in_window_top - rec_seqnum
        if bit < (U64{64}) -> ssl.in_window = ssl.in_window.bit_or(U64{1} << Int.from_u64(bit))
    }
}

// ---------------------------------------------------------------------------
// DTLS client reconnects from the same port (RFC 6347 4.2.8).

/// Check whether the datagram inb[0..<in_len] is a ClientHello with a valid
/// cookie for `cli_id` (mbedtls_ssl_check_dtls_clihlo_cookie). 0: the cookie
/// is valid. Otherwise a HelloVerifyRequest is written to obuf and its
/// length returned, where C returns HELLO_VERIFY_REQUIRED with *olen.
ssl_check_dtls_clihlo_cookie: fn(conf: ssldefs.SSLConfig, cli_id: [U8], inb: [U8], in_len: Int, obuf: &[U8], buf_len: Int) -> Int ssldefs.SSLError! {
    // Record header (13 bytes), handshake header (12), client_version (2),
    // random (32), then the session ID and the cookie, each length-prefixed:
    // at least 61 bytes.
    if in_len < 61 -> return Err(.DecodeError)
    epoch: ssldefs.ssl_get_u16(inb, 3)
    fragment_offset: ssldefs.ssl_get_u24(inb, 19)
    if ssldefs.ssl_u8(inb, 0) != ssldefs.SSL_MSG_HANDSHAKE || epoch != 0 || fragment_offset != 0 -> return Err(.DecodeError)
    sid_len: ssldefs.ssl_u8(inb, 59)
    if 59 + 1 + sid_len + 1 > in_len -> return Err(.DecodeError)
    cookie_len: ssldefs.ssl_u8(inb, 60 + sid_len)
    if 59 + 1 + sid_len + 1 + cookie_len > in_len -> return Err(.DecodeError)
    cookie: ssldefs.ssl_bytes_of(inb, sid_len + 61, cookie_len)
    valid := false
    if conf.f_cookie_check == {
        .Val(cb) -> {
            check: cb.call
            if check(cookie, cli_id) == {
                .Ok(ok) -> valid = ok
                .Err(_) -> valid = false
            }
        }
        None -> return Err(.InternalError)
    }
    if valid -> return 0
    // The HelloVerifyRequest copies the record header, the message type's
    // place, the message sequence and the fragment offset, then carries
    // server_version 0xfeff and the cookie: at least 28 bytes.
    if buf_len < 28 -> return Err(.BufferTooSmall)
    ssldefs.ssl_copy_into(obuf, 0, inb, 0, 25)
    obuf[13] = ssldefs.ssl_byte(ssldefs.SSL_HS_HELLO_VERIFY_REQUEST)
    obuf[25] = U8{0xFE}
    obuf[26] = U8{0xFF}
    written := [U8]{}
    if conf.f_cookie_write == {
        .Val(cb) -> {
            write: cb.call
            written = write(cli_id) ?? return Err(.InternalError)
        }
        None -> return Err(.InternalError)
    }
    // A cookie past the buffer is the write callback's failure in C.
    if 28 + written.len() > buf_len -> return Err(.InternalError)
    ssldefs.ssl_copy_into(obuf, 28, written, 0, written.len())
    olen: 28 + written.len()
    obuf[27] = ssldefs.ssl_byte(olen - 28)
    ssldefs.ssl_put_u24(obuf, 14, olen - 25)
    ssldefs.ssl_put_u24(obuf, 22, olen - 25)
    ssldefs.ssl_put_u16(obuf, 11, olen - 13)
    olen
}

// An epoch 0 ClientHello after the handshake (ssl_handle_possible_reconnect):
// with no cookie it is answered with a HelloVerifyRequest and dropped; with a
// valid one the context is reset and ClientReconnect returned.
ssl_handle_possible_reconnect: fn(ssl: &ssldefs.SSLContext) ssldefs.SSLError! {
    // Without cookies the peer's reachability can't be checked: drop it.
    if ssl.conf.f_cookie_write == {
        .Val(_) -> {}
        None -> return
    }
    if ssl.conf.f_cookie_check == {
        .Val(_) -> {}
        None -> return
    }
    cli_id := [U8]{}
    if ssl.cli_id == {
        .Val(id) -> cli_id = id.copy()
        None -> {}
    }
    olen: ssl_check_dtls_clihlo_cookie(ssl.conf, cli_id, ssl.in_buf, ssl.in_left, ssl.out_buf, ssldefs.SSL_OUT_CONTENT_LEN) ?? return Err(err)
    if olen > 0 {
        // A send error is not checked: a permanent one shows later, and a
        // passing one may not recur.
        if ssl_bio_send(ssl, 0, olen) == {
            else -> {}
        }
        return
    }
    ssltls.ssl_session_reset_int(ssl, true)
    Err(.ClientReconnect)
}

// Whether `record_type` is one the record layer knows
// (ssl_check_record_type, true where C returns 0).
ssl_check_record_type: fn(record_type: Int) -> Bool Never! {
    record_type == ssldefs.SSL_MSG_HANDSHAKE || record_type == ssldefs.SSL_MSG_ALERT || record_type == ssldefs.SSL_MSG_CHANGE_CIPHER_SPEC || record_type == ssldefs.SSL_MSG_APPLICATION_DATA
}

// Parse the record header at buf[off] of the `len` bytes available into
// `rec` (ssl_parse_record_header). DTLS:
// UnexpectedRecord for a record of another epoch or a replay, EarlyMessage
// for the next epoch's, InvalidRecord for a bad header.
ssl_parse_record_header: fn(ssl: ssldefs.SSLContext, buf: [U8], off: Int, len: Int, rec: &ssldefs.SSLRecord) ssldefs.SSLError! {
    dtls: ssl_is_dtls(ssl)
    rec_hdr_version_offset: 1
    rec_hdr_ctr_offset: 3
    rec_hdr_cid_offset: 11
    rec_hdr_len_offset := 3
    if dtls -> rec_hdr_len_offset = 11
    if len < rec_hdr_len_offset + 2 -> return Err(.InvalidRecord)
    rec.rtype = ssldefs.ssl_u8(buf, off)
    rec.cid_len = 0
    rec.cid = [U8]{}
    if dtls && ssl.conf.cid_len != 0 && rec.rtype == ssldefs.SSL_MSG_CID {
        // A CID record carries the CID, of the configured length, before
        // its length field.
        rec_hdr_cid_len: ssl.conf.cid_len
        rec_hdr_len_offset += rec_hdr_cid_len
        if len < rec_hdr_len_offset + 2 -> return Err(.InvalidRecord)
        rec.cid_len = rec_hdr_cid_len
        rec.cid = ssldefs.ssl_bytes_of(buf, off + rec_hdr_cid_offset, rec_hdr_cid_len)
    } else {
        if !ssl_check_record_type(rec.rtype) -> return Err(.InvalidRecord)
    }
    rec.ver = ssldefs.ssl_bytes_of(buf, off + rec_hdr_version_offset, 2)
    tls_version: ssl_read_version(buf, off + rec_hdr_version_offset, ssl.conf.transport)
    if tls_version > ssl.conf.max_tls_version -> return Err(.InvalidRecord)
    // DTLS records carry their sequence number; TLS's is implicit.
    if dtls {
        rec.ctr = ssldefs.ssl_bytes_of(buf, off + rec_hdr_ctr_offset, 8)
    } else {
        rec.ctr = ssldefs.ssl_bytes_of(ssl.in_buf, ssl.in_ctr, 8)
    }
    rec.data_offset = rec_hdr_len_offset + 2
    rec.data_len = ssldefs.ssl_get_u16(buf, off + rec_hdr_len_offset)
    rec.buf_start = off
    rec.buf_len = rec.data_offset + rec.data_len
    if rec.data_len == 0 -> return Err(.InvalidRecord)
    // The epoch is checked before the length, which depends on it: a
    // duplicate ChangeCipherSpec of an old epoch is skipped, not invalid.
    if dtls {
        rec_epoch: ssldefs.ssl_get_u16(rec.ctr, 0)
        if len < rec.data_offset + rec.data_len -> return Err(.InvalidRecord)
        if rec_epoch != ssl.in_epoch {
            // The next epoch's records may be buffered (an early Finished).
            if rec_epoch == ssl.in_epoch + 1 -> return Err(.EarlyMessage)
            return Err(.UnexpectedRecord)
        }
        if !ssl_dtls_replay_check_ctr(ssl, rec.ctr, 0) -> return Err(.UnexpectedRecord)
    }
}

// An epoch 0 ClientHello record to a server after its handshake may be the
// client reconnecting (ssl_check_client_reconnect). The handshake type is
// read at in_buf[13], past the 13-byte DTLS header, as in_msg may sit after
// an explicit IV.
ssl_check_client_reconnect: fn(ssl: &ssldefs.SSLContext) ssldefs.SSLError! {
    rec_epoch: ssldefs.ssl_get_u16(ssl.in_buf, ssl.in_ctr)
    if rec_epoch == 0 && ssl.conf.endpoint == ssldefs.SSL_IS_SERVER && ssl_is_handshake_over(ssl) && ssl.in_msgtype == ssldefs.SSL_MSG_HANDSHAKE && ssl.in_left > 13 && ssldefs.ssl_u8(ssl.in_buf, 13) == ssldefs.SSL_HS_CLIENT_HELLO {
        return ssl_handle_possible_reconnect(ssl)
    }
}

// Decrypt the record `rec` in in_buf under transform_in, if any
// (ssl_prepare_record_content), and check its decrypted content.
ssl_prepare_record_content: fn(ssl: &ssldefs.SSLContext, rec: &ssldefs.SSLRecord) ssldefs.SSLError! {
    // TLS 1.3 ChangeCipherSpec records are never protected.
    done := false
    if ssl.transform_in >= 0 && ssl.tpool[ssl.transform_in].tls_version == ssldefs.SSL_VERSION_TLS1_3 && rec.rtype == ssldefs.SSL_MSG_CHANGE_CIPHER_SPEC -> done = true
    if !done && ssl.transform_in >= 0 {
        if ssl_decrypt_buf(ssl.tpool[ssl.transform_in], rec, ssl.in_buf) == {
            .Err(e) -> {
                if e == {
                    .UnexpectedCID -> {
                        if ssl.conf.ignore_unexpected_cid == ssldefs.SSL_UNEXPECTED_CID_IGNORE -> return Err(.ContinueProcessing)
                    }
                    .CryptoInProgress | .FeatureUnavailable | .BadInputData | .InvalidMac | .InvalidRecord | .ConnEOF | .DecodeError | .NoRNG | .NoClientCertificate | .UnsupportedExtension | .NoApplicationProtocol | .PrivateKeyRequired | .CAChainRequired | .UnexpectedMessage | .FatalAlertMessage | .UnrecognizedName | .PeerCloseNotify | .BadCertificate | .ReceivedNewSessionTicket | .CannotReadEarlyData | .ReceivedEarlyData | .CannotWriteEarlyData | .CacheEntryNotFound | .AllocFailed | .HwAccelFailed | .HwAccelFallthrough | .BadProtocolVersion | .HandshakeFailure | .SessionTicketExpired | .PKTypeMismatch | .UnknownIdentity | .InternalError | .CounterWrapping | .WaitingServerHelloRenego | .HelloVerifyRequired | .BufferTooSmall | .WantRead | .WantWrite | .Timeout | .ClientReconnect | .UnexpectedRecord | .NonFatal | .IllegalParameter | .ContinueProcessing | .AsyncInProgress | .EarlyMessage | .VersionMismatch | .BadConfig | .CertificateVerificationWithoutHostname | .CorruptionDetected | .GenericError | .RandomFailed | .Cipher(_) | .PK(_) | .X509(_) | .ECP(_) | .DHM(_) | .Mpi(_) | .Callback(_) -> {}
                }
                return Err(e)
            }
            .Ok(_) -> {}
        }
        // A CID record's content type is in its plaintext: check it again,
        // fatally this time.
        if !ssl_check_record_type(rec.rtype) -> return Err(.InvalidRecord)
        if rec.data_len == 0 {
            // TLS 1.2 allows no empty records but application data.
            if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_2 && rec.rtype != ssldefs.SSL_MSG_APPLICATION_DATA -> return Err(.InvalidRecord)
            ssl.nb_zero += 1
            // Four empty records in a row may be a DoS attack: count them
            // as a bad MAC.
            if ssl.nb_zero > 3 -> return Err(.InvalidMac)
        } else {
            ssl.nb_zero = 0
        }
        // TLS keeps the incoming counter; DTLS reads it from the peer.
        if !ssl_is_dtls(ssl) {
            ep: ssl_ep_len(ssl)
            i := ssldefs.SSL_SEQUENCE_NUMBER_LEN
            loop i > ep {
                at: ssl.in_ctr + i - 1
                ssl.in_buf[at] = ssldefs.ssl_byte(Int.from_u8(ssl.in_buf[at]) + 1)
                if ssl.in_buf[at] != (U8{0}) -> break
                i -= 1
            }
            // The loop runs to its end when the counter wraps.
            if i == ep -> return Err(.CounterWrapping)
        }
    }
    if ssl_is_dtls(ssl) -> ssl_dtls_replay_update(ssl)
    if rec.data_len > ssldefs.SSL_IN_CONTENT_LEN -> return Err(.InvalidRecord)
}

// ---------------------------------------------------------------------------
// Reading records.

/// Read the next record or handshake message (mbedtls_ssl_read_record).
/// Non-fatal alerts are skipped, and for DTLS invalid records too
/// (RFC 6347 4.1.2.7). A handshake message is added to the transcript when
/// `update_hs_digest`.
ssl_read_record: fn<R: RNG>(ssl: &ssldefs.SSLContext, update_hs_digest: Bool, rng: &R) ssldefs.SSLError! {
    if ssl.keep_current_message != 0 {
        ssl.keep_current_message = 0
        return
    }
    loop {
        ssl_consume_current_message(ssl) ?? return Err(err)
        if !ssl_record_is_in_progress(ssl) {
            // Buffered messages are looked at when the datagram is done.
            dtls_have_buffered := false
            if ssl_is_dtls(ssl) && !ssl_next_record_is_in_datagram(ssl) {
                if ssl_load_buffered_message(ssl) -> dtls_have_buffered = true
            }
            if !dtls_have_buffered {
                if ssl_get_next_record(ssl, rng) == {
                    .Err(e) -> {
                        if e == {
                            .ContinueProcessing -> next
                            .CryptoInProgress | .FeatureUnavailable | .BadInputData | .InvalidMac | .InvalidRecord | .ConnEOF | .DecodeError | .NoRNG | .NoClientCertificate | .UnsupportedExtension | .NoApplicationProtocol | .PrivateKeyRequired | .CAChainRequired | .UnexpectedMessage | .FatalAlertMessage | .UnrecognizedName | .PeerCloseNotify | .BadCertificate | .ReceivedNewSessionTicket | .CannotReadEarlyData | .ReceivedEarlyData | .CannotWriteEarlyData | .CacheEntryNotFound | .AllocFailed | .HwAccelFailed | .HwAccelFallthrough | .BadProtocolVersion | .HandshakeFailure | .SessionTicketExpired | .PKTypeMismatch | .UnknownIdentity | .InternalError | .CounterWrapping | .WaitingServerHelloRenego | .HelloVerifyRequired | .BufferTooSmall | .WantRead | .WantWrite | .Timeout | .ClientReconnect | .UnexpectedRecord | .NonFatal | .IllegalParameter | .AsyncInProgress | .EarlyMessage | .UnexpectedCID | .VersionMismatch | .BadConfig | .CertificateVerificationWithoutHostname | .CorruptionDetected | .GenericError | .RandomFailed | .Cipher(_) | .PK(_) | .X509(_) | .ECP(_) | .DHM(_) | .Mpi(_) | .Callback(_) -> return Err(e)
                        }
                    }
                    .Ok(_) -> {}
                }
            }
        }
        if ssl_handle_message_type(ssl, rng) == {
            .Err(e) -> {
                if e == {
                    // A future message is buffered.
                    .EarlyMessage -> ssl_buffer_message(ssl) ?? return Err(err)
                    .NonFatal | .ContinueProcessing -> {}
                    .CryptoInProgress | .FeatureUnavailable | .BadInputData | .InvalidMac | .InvalidRecord | .ConnEOF | .DecodeError | .NoRNG | .NoClientCertificate | .UnsupportedExtension | .NoApplicationProtocol | .PrivateKeyRequired | .CAChainRequired | .UnexpectedMessage | .FatalAlertMessage | .UnrecognizedName | .PeerCloseNotify | .BadCertificate | .ReceivedNewSessionTicket | .CannotReadEarlyData | .ReceivedEarlyData | .CannotWriteEarlyData | .CacheEntryNotFound | .AllocFailed | .HwAccelFailed | .HwAccelFallthrough | .BadProtocolVersion | .HandshakeFailure | .SessionTicketExpired | .PKTypeMismatch | .UnknownIdentity | .InternalError | .CounterWrapping | .WaitingServerHelloRenego | .HelloVerifyRequired | .BufferTooSmall | .WantRead | .WantWrite | .Timeout | .ClientReconnect | .UnexpectedRecord | .IllegalParameter | .AsyncInProgress | .UnexpectedCID | .VersionMismatch | .BadConfig | .CertificateVerificationWithoutHostname | .CorruptionDetected | .GenericError | .RandomFailed | .Cipher(_) | .PK(_) | .X509(_) | .ECP(_) | .DHM(_) | .Mpi(_) | .Callback(_) -> return Err(e)
                }
            }
            .Ok(_) -> break
        }
    }
    if ssl.in_msgtype == ssldefs.SSL_MSG_HANDSHAKE && update_hs_digest -> ssl_update_handshake_status(ssl)
}

// Whether more records follow in the current datagram
// (ssl_next_record_is_in_datagram).
ssl_next_record_is_in_datagram: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl.in_left > ssl.next_record_offset }

// Load the next handshake message, or a ChangeCipherSpec, from the DTLS
// buffer into in_msg (ssl_load_buffered_message): whether one was loaded.
// A buffered message too long for in_buf, C's INTERNAL_ERROR, which
// mbedtls_ssl_read_record takes as nothing loaded, is not loaded.
ssl_load_buffered_message: fn(ssl: &ssldefs.SSLContext) -> Bool Never! {
    if !ssl.has_handshake -> return false
    if ssl.state == ssldefs.SSL_CLIENT_CHANGE_CIPHER_SPEC || ssl.state == ssldefs.SSL_SERVER_CHANGE_CIPHER_SPEC {
        // A ChangeCipherSpec seen before is synthesized.
        if ssl.handshake.seen_ccs == 0 -> return false
        ssl.in_msgtype = ssldefs.SSL_MSG_CHANGE_CIPHER_SPEC
        ssl.in_msglen = 1
        ssl.in_buf[ssl.in_msg] = U8{1}
        // Equal, so the datagram counts as consumed.
        ssl.in_left = 0
        ssl.next_record_offset = 0
        ssl.handshake.seen_ccs = 0
        return true
    }
    if ssl.handshake.hs[0].is_valid && ssl.handshake.hs[0].is_complete {
        msg_len: ssldefs.ssl_get_u24(ssl.handshake.hs[0].data, 1)
        if msg_len + 12 > ssldefs.SSL_IN_CONTENT_LEN -> return false
        ssl.in_msgtype = ssldefs.SSL_MSG_HANDSHAKE
        ssl.in_hslen = msg_len + 12
        ssl.in_msglen = msg_len + 12
        ssldefs.ssl_copy_into(ssl.in_buf, ssl.in_msg, ssl.handshake.hs[0].data, 0, ssl.in_hslen)
        return true
    }
    false
}

// Free buffered data, the future epoch's record first and then the most
// distant messages, until `desired` bytes may be buffered
// (ssl_buffer_make_space, true where C returns 0).
ssl_buffer_make_space: fn(ssl: &ssldefs.SSLContext, desired: Int) -> Bool Never! {
    ssl_free_buffered_record(ssl)
    if desired <= ssldefs.SSL_DTLS_MAX_BUFFERING - ssl.handshake.total_bytes_buffered -> return true
    offset := ssldefs.SSL_MAX_BUFFERED_HS - 1
    loop offset >= 0 {
        ssl_buffering_free_slot(ssl, offset)
        if desired <= ssldefs.SSL_DTLS_MAX_BUFFERING - ssl.handshake.total_bytes_buffered -> return true
        offset -= 1
    }
    false
}

// Buffer the DTLS message at in_msg, a future handshake message or fragment
// or an early ChangeCipherSpec (ssl_buffer_message).
ssl_buffer_message: fn(ssl: &ssldefs.SSLContext) ssldefs.SSLError! {
    if !ssl.has_handshake -> return
    if ssl.in_msgtype == ssldefs.SSL_MSG_CHANGE_CIPHER_SPEC {
        ssl.handshake.seen_ccs = 1
        return
    }
    if ssl.in_msgtype != ssldefs.SSL_MSG_HANDSHAKE -> return
    recv_msg_seq: ssldefs.ssl_get_u16(ssl.in_buf, ssl.in_msg + 4)
    msg_len: ssl.in_hslen - 12
    // An old message never gets here.
    if recv_msg_seq < ssl.handshake.in_msg_seq -> return Err(.InternalError)
    slot: recv_msg_seq - ssl.handshake.in_msg_seq
    // A message too far in the future is ignored.
    if slot >= ssldefs.SSL_MAX_BUFFERED_HS -> return
    if !ssl.handshake.hs[slot].is_valid {
        ssl.handshake.hs[slot].is_fragmented = ssl_hs_is_proper_fragment(ssl)
        // The message is copied back to in_buf once reassembled, so it must
        // fit there; a limit of this implementation, not of the standard.
        if msg_len + 12 > ssldefs.SSL_IN_CONTENT_LEN -> return
        if ssl.handshake.total_bytes_buffered > ssldefs.SSL_DTLS_MAX_BUFFERING -> return Err(.InternalError)
        reassembly_buf_sz: ssl_get_reassembly_buffer_size(msg_len, ssl.handshake.hs[slot].is_fragmented)
        if reassembly_buf_sz > ssldefs.SSL_DTLS_MAX_BUFFERING - ssl.handshake.total_bytes_buffered {
            // A future message with no room is ignored; room for the next
            // one is made by freeing future ones.
            if slot > 0 -> return
            if !ssl_buffer_make_space(ssl, reassembly_buf_sz) -> return Err(.BufferTooSmall)
        }
        // The final header: the type, length and message_seq, then
        // fragment_offset 0 and fragment_length the length.
        data := ssldefs.ssl_zeros(reassembly_buf_sz)
        ssldefs.ssl_copy_into(data, 0, ssl.in_buf, ssl.in_msg, 6)
        ssldefs.ssl_move_within(data, 9, 1, 3)
        ssl.handshake.hs[slot].data = data
        ssl.handshake.hs[slot].is_valid = true
        ssl.handshake.total_bytes_buffered += reassembly_buf_sz
    } else {
        // A fragment whose type and length disagree is ignored.
        if !ssldefs.ssl_range_eq(ssl.handshake.hs[slot].data, 0, ssl.in_buf, ssl.in_msg, 4) -> return
    }
    if !ssl.handshake.hs[slot].is_complete {
        // prepare_handshake_record checked the header.
        frag_off: ssl_get_hs_frag_off(ssl)
        frag_len: ssl_get_hs_frag_len(ssl)
        ssldefs.ssl_copy_into(ssl.handshake.hs[slot].data, 12 + frag_off, ssl.in_buf, ssl.in_msg + 12, frag_len)
        if ssl.handshake.hs[slot].is_fragmented {
            ssl_bitmask_set(ssl.handshake.hs[slot].data, 12 + msg_len, frag_off, frag_len)
            ssl.handshake.hs[slot].is_complete = ssl_bitmask_check(ssl.handshake.hs[slot].data, 12 + msg_len, msg_len)
        } else {
            ssl.handshake.hs[slot].is_complete = true
        }
    }
}

// Consume the last message read (ssl_consume_current_message): a handshake
// message is removed from the record, the rest moved up to in_msg; alerts
// and ChangeCipherSpec consume the record; application data is consumed by
// ssl_read.
ssl_consume_current_message: fn(ssl: &ssldefs.SSLContext) ssldefs.SSLError! {
    if ssl.in_hslen != 0 {
        // No application data may be in flight.
        if ssl.in_offt >= 0 -> return Err(.InternalError)
        // A TLS message still gathering its fragments stays.
        if ssl_get_in_hsfraglen(ssl) != 0 -> return
        // in_hslen may exceed in_msglen after a DTLS fragment or an
        // out-of-sequence message.
        if ssl.in_hslen < ssl.in_msglen {
            ssl.in_msglen -= ssl.in_hslen
            ssldefs.ssl_move_within(ssl.in_buf, ssl.in_msg, ssl.in_msg + ssl.in_hslen, ssl.in_msglen)
            ssldefs.ssl_put_u16(ssl.in_buf, ssl.in_len, ssl.in_msglen)
        } else {
            ssl.in_msglen = 0
        }
        ssl.in_hslen = 0
        return
    }
    if ssl.in_offt >= 0 -> return
    ssl.in_msglen = 0
}

// Whether the current record has content left (ssl_record_is_in_progress).
ssl_record_is_in_progress: fn(ssl: ssldefs.SSLContext) -> Bool Never! { ssl.in_msglen > 0 }

// Drop the buffered record of the next epoch (ssl_free_buffered_record).
ssl_free_buffered_record: fn(ssl: &ssldefs.SSLContext) Never! {
    if !ssl.has_handshake -> return
    if ssl.handshake.future_record.len() != 0 {
        ssl.handshake.total_bytes_buffered -= ssl.handshake.future_record.len()
        ssl.handshake.future_record = [U8]{}
    }
}

// Move the buffered record of the next epoch to in_hdr once that epoch is
// current and the datagram is consumed (ssl_load_buffered_record).
ssl_load_buffered_record: fn(ssl: &ssldefs.SSLContext) ssldefs.SSLError! {
    if !ssl_is_dtls(ssl) -> return
    if !ssl.has_handshake -> return
    rec_len: ssl.handshake.future_record.len()
    if rec_len == 0 -> return
    if ssl_next_record_is_in_datagram(ssl) -> return
    if ssl.handshake.future_record_epoch != ssl.in_epoch -> return
    if rec_len > ssldefs.SSL_IN_BUFFER_LEN - ssl.in_hdr -> return Err(.InternalError)
    ssldefs.ssl_copy_into(ssl.in_buf, ssl.in_hdr, ssl.handshake.future_record, 0, rec_len)
    ssl.in_left = rec_len
    ssl.next_record_offset = 0
    ssl_free_buffered_record(ssl)
}

// Buffer a handshake record of the next epoch, at most one, an early
// Finished (ssl_buffer_future_record).
ssl_buffer_future_record: fn(ssl: &ssldefs.SSLContext, rec: ssldefs.SSLRecord) Never! {
    if !ssl.has_handshake -> return
    if rec.rtype != ssldefs.SSL_MSG_HANDSHAKE -> return
    if ssl.handshake.future_record.len() != 0 -> return
    if rec.buf_len > ssldefs.SSL_DTLS_MAX_BUFFERING - ssl.handshake.total_bytes_buffered -> return
    ssl.handshake.future_record_epoch = ssl.in_epoch + 1
    ssl.handshake.future_record = ssldefs.ssl_bytes_of(ssl.in_buf, rec.buf_start, rec.buf_len)
    ssl.handshake.total_bytes_buffered += rec.buf_len
}

// Read and decrypt the next record (ssl_get_next_record). DTLS drops
// unexpected and invalid records with ContinueProcessing.
ssl_get_next_record: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    dtls: ssl_is_dtls(ssl)
    // A buffered record of a now current epoch is loaded, after which
    // fetch_input has nothing to do.
    ssl_load_buffered_record(ssl) ?? return Err(err)
    // Room for the header with no CID: 5 bytes for TLS, 13 for DTLS.
    hdr_len: ssl_in_hdr_len(ssl)
    ssl_fetch_input(ssl, hdr_len, rng) ?? return Err(err)
    rec := ssldefs.SSLRecord{}
    if ssl_parse_record_header(ssl, ssl.in_buf, ssl.in_hdr, ssl.in_left, rec) == {
        .Err(e) -> {
            if !dtls -> return Err(e)
            unexpected := false
            if e == {
                .EarlyMessage -> {
                    ssl_buffer_future_record(ssl, rec)
                    unexpected = true
                }
                .UnexpectedRecord -> unexpected = true
                .CryptoInProgress | .FeatureUnavailable | .BadInputData | .InvalidMac | .InvalidRecord | .ConnEOF | .DecodeError | .NoRNG | .NoClientCertificate | .UnsupportedExtension | .NoApplicationProtocol | .PrivateKeyRequired | .CAChainRequired | .UnexpectedMessage | .FatalAlertMessage | .UnrecognizedName | .PeerCloseNotify | .BadCertificate | .ReceivedNewSessionTicket | .CannotReadEarlyData | .ReceivedEarlyData | .CannotWriteEarlyData | .CacheEntryNotFound | .AllocFailed | .HwAccelFailed | .HwAccelFallthrough | .BadProtocolVersion | .HandshakeFailure | .SessionTicketExpired | .PKTypeMismatch | .UnknownIdentity | .InternalError | .CounterWrapping | .WaitingServerHelloRenego | .HelloVerifyRequired | .BufferTooSmall | .WantRead | .WantWrite | .Timeout | .ClientReconnect | .NonFatal | .IllegalParameter | .ContinueProcessing | .AsyncInProgress | .UnexpectedCID | .VersionMismatch | .BadConfig | .CertificateVerificationWithoutHostname | .CorruptionDetected | .GenericError | .RandomFailed | .Cipher(_) | .PK(_) | .X509(_) | .ECP(_) | .DHM(_) | .Mpi(_) | .Callback(_) -> {}
            }
            // A server waiting for the first ClientHello rejects invalid
            // and unexpected records rather than wait past them.
            if ssl.conf.endpoint == ssldefs.SSL_IS_SERVER && ssl.state == ssldefs.SSL_CLIENT_HELLO && ssl.renego_status == ssldefs.SSL_INITIAL_HANDSHAKE {
                if unexpected -> return Err(.UnexpectedRecord)
                return Err(e)
            }
            if unexpected {
                // The pointers of an unprotected record, for the reconnect
                // check.
                ssl_update_in_pointers(ssl)
                ssl.in_msgtype = rec.rtype
                ssl.in_len = ssl.in_cid + rec.cid_len
                ssl.in_iv = ssl.in_len + 2
                ssl.in_msg = ssl.in_iv
                ssl.in_msglen = rec.data_len
                ssl_check_client_reconnect(ssl) ?? return Err(err)
                // Skip the record, not the datagram.
                ssl.next_record_offset = rec.buf_len
            } else {
                // Skip the record and the rest of the datagram.
                ssl.next_record_offset = 0
                ssl.in_left = 0
            }
            return Err(.ContinueProcessing)
        }
        .Ok(_) -> {}
    }
    if dtls {
        // Where the next record of the datagram starts.
        ssl.next_record_offset = rec.buf_len
    } else {
        ssl_fetch_input(ssl, rec.buf_len, rng) ?? return Err(err)
        ssl.in_left = 0
    }
    if ssl_prepare_record_content(ssl, rec) == {
        .Err(e) -> {
            bad_mac := false
            if e == {
                .InvalidMac -> bad_mac = true
                .CryptoInProgress | .FeatureUnavailable | .BadInputData | .InvalidRecord | .ConnEOF | .DecodeError | .NoRNG | .NoClientCertificate | .UnsupportedExtension | .NoApplicationProtocol | .PrivateKeyRequired | .CAChainRequired | .UnexpectedMessage | .FatalAlertMessage | .UnrecognizedName | .PeerCloseNotify | .BadCertificate | .ReceivedNewSessionTicket | .CannotReadEarlyData | .ReceivedEarlyData | .CannotWriteEarlyData | .CacheEntryNotFound | .AllocFailed | .HwAccelFailed | .HwAccelFallthrough | .BadProtocolVersion | .HandshakeFailure | .SessionTicketExpired | .PKTypeMismatch | .UnknownIdentity | .InternalError | .CounterWrapping | .WaitingServerHelloRenego | .HelloVerifyRequired | .BufferTooSmall | .WantRead | .WantWrite | .Timeout | .ClientReconnect | .UnexpectedRecord | .NonFatal | .IllegalParameter | .ContinueProcessing | .AsyncInProgress | .EarlyMessage | .UnexpectedCID | .VersionMismatch | .BadConfig | .CertificateVerificationWithoutHostname | .CorruptionDetected | .GenericError | .RandomFailed | .Cipher(_) | .PK(_) | .X509(_) | .ECP(_) | .DHM(_) | .Mpi(_) | .Callback(_) -> {}
            }
            if dtls && bad_mac {
                // A bad MAC on Finished probably means the handshake went
                // wrong (a wrong PSK, a downgrade): it is fatal.
                if ssl.state == ssldefs.SSL_CLIENT_FINISHED || ssl.state == ssldefs.SSL_SERVER_FINISHED {
                    if ssl_send_alert_message(ssl, ssldefs.SSL_ALERT_LEVEL_FATAL, ssldefs.SSL_ALERT_MSG_BAD_RECORD_MAC, rng) == {
                        else -> {}
                    }
                    return Err(e)
                }
                if ssl.conf.badmac_limit != 0 {
                    badmac_seen: ssl_get_badmac_seen(ssl) + 1
                    ssl_set_badmac_seen(ssl, badmac_seen) ?? return Err(.CorruptionDetected)
                    if badmac_seen >= ssl.conf.badmac_limit -> return Err(.InvalidMac)
                }
                // Drop the whole datagram.
                ssl.next_record_offset = 0
                ssl.in_left = 0
                return Err(.ContinueProcessing)
            }
            if !dtls && bad_mac {
                if ssl_send_alert_message(ssl, ssldefs.SSL_ALERT_LEVEL_FATAL, ssldefs.SSL_ALERT_MSG_BAD_RECORD_MAC, rng) == {
                    else -> {}
                }
            }
            return Err(e)
        }
        .Ok(_) -> {}
    }
    // The pointers of an unprotected record with the record's CID; the
    // content type may change in decryption.
    ssl_update_in_pointers(ssl)
    ssl.in_len = ssl.in_cid + rec.cid_len
    ssl.in_iv = ssl.in_len + 2
    ssl.in_msgtype = rec.rtype
    ssl.in_msg = rec.buf_start + rec.data_offset
    ssl.in_msglen = rec.data_len
}

/// Handle the record read by its type (mbedtls_ssl_handle_message_type):
/// prepare handshake messages, check ChangeCipherSpec and alerts, drop
/// DTLS application data before the handshake is over.
ssl_handle_message_type: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    // Nothing but handshake records may come amid a fragmented handshake
    // message: TLS 1.3 forbids it, and this implementation for TLS 1.2.
    if ssl_get_in_hsfraglen(ssl) != 0 && ssl.in_msgtype != ssldefs.SSL_MSG_HANDSHAKE -> return Err(.UnexpectedMessage)
    if ssl.in_msgtype == ssldefs.SSL_MSG_HANDSHAKE -> ssl_prepare_handshake_record(ssl, rng) ?? return Err(err)
    if ssl.in_msgtype == ssldefs.SSL_MSG_CHANGE_CIPHER_SPEC {
        if ssl.in_msglen != 1 -> return Err(.InvalidRecord)
        if ssl.in_buf[ssl.in_msg] != (U8{1}) -> return Err(.InvalidRecord)
        if ssl_is_dtls(ssl) && ssl.state != ssldefs.SSL_CLIENT_CHANGE_CIPHER_SPEC && ssl.state != ssldefs.SSL_SERVER_CHANGE_CIPHER_SPEC {
            if !ssl.has_handshake -> return Err(.UnexpectedRecord)
            // Out of order: remembered.
            return Err(.EarlyMessage)
        }
        // TLS 1.3 compatibility mode ChangeCipherSpec is ignored.
        if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_3 -> return Err(.ContinueProcessing)
    }
    if ssl.in_msgtype == ssldefs.SSL_MSG_ALERT {
        // The standard allows several alerts in a record; this
        // implementation does not.
        if ssl.in_msglen != 2 -> return Err(.InvalidRecord)
        level: ssldefs.ssl_u8(ssl.in_buf, ssl.in_msg)
        desc: ssldefs.ssl_u8(ssl.in_buf, ssl.in_msg + 1)
        if level == ssldefs.SSL_ALERT_LEVEL_FATAL -> return Err(.FatalAlertMessage)
        if level == ssldefs.SSL_ALERT_LEVEL_WARNING && desc == ssldefs.SSL_ALERT_MSG_CLOSE_NOTIFY -> return Err(.PeerCloseNotify)
        // no_renegotiation is handled where ServerHello is parsed.
        if level == ssldefs.SSL_ALERT_LEVEL_WARNING && desc == ssldefs.SSL_ALERT_MSG_NO_RENEGOTIATION -> return
        // Other warnings are ignored.
        return Err(.NonFatal)
    }
    if ssl_is_dtls(ssl) {
        // Application data is dropped before the handshake is over, but at
        // the start of a renegotiation.
        if ssl.in_msgtype == ssldefs.SSL_MSG_APPLICATION_DATA && !ssl_is_handshake_over(ssl) && !(ssl.renego_status == ssldefs.SSL_RENEGOTIATION_IN_PROGRESS && ssl.state == ssldefs.SSL_SERVER_HELLO) -> return Err(.NonFatal)
        if ssl.has_handshake && ssl_is_handshake_over(ssl) -> ssltls.ssl_handshake_wrapup_free_hs_transform(ssl)
    }
}

/// mbedtls_ssl_send_fatal_handshake_failure.
ssl_send_fatal_handshake_failure: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    ssl_send_alert_message(ssl, ssldefs.SSL_ALERT_LEVEL_FATAL, ssldefs.SSL_ALERT_MSG_HANDSHAKE_FAILURE, rng)
}

/// Send an alert; pending output is flushed first, and the alert is then
/// not sent (mbedtls_ssl_send_alert_message).
ssl_send_alert_message: fn<R: RNG>(ssl: &ssldefs.SSLContext, level: Int, message: Int, rng: &R) ssldefs.SSLError! {
    if !ssl.has_conf -> return Err(.BadInputData)
    if ssl.out_left != 0 -> return ssl_flush_output(ssl)
    ssl.out_msgtype = ssldefs.SSL_MSG_ALERT
    ssl.out_msglen = 2
    ssl.out_buf[ssl.out_msg] = ssldefs.ssl_byte(level)
    ssl.out_buf[ssl.out_msg + 1] = ssldefs.ssl_byte(message)
    ssl_write_record(ssl, true, rng)
}

/// Write a ChangeCipherSpec and move to the next state
/// (mbedtls_ssl_write_change_cipher_spec).
ssl_write_change_cipher_spec: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    ssl.out_msgtype = ssldefs.SSL_MSG_CHANGE_CIPHER_SPEC
    ssl.out_msglen = 1
    ssl.out_buf[ssl.out_msg] = U8{1}
    ssl_handshake_increment_state(ssl)
    ssl_write_handshake_msg(ssl, rng)
}

/// Read the peer's ChangeCipherSpec and switch inbound records to the
/// negotiated transform and session (mbedtls_ssl_parse_change_cipher_spec).
ssl_parse_change_cipher_spec: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    ssl_read_record(ssl, true, rng) ?? return Err(err)
    // handle_message_type checked the length and content.
    if ssl.in_msgtype != ssldefs.SSL_MSG_CHANGE_CIPHER_SPEC {
        if ssl_send_alert_message(ssl, ssldefs.SSL_ALERT_LEVEL_FATAL, ssldefs.SSL_ALERT_MSG_UNEXPECTED_MESSAGE, rng) == {
            else -> {}
        }
        return Err(.UnexpectedMessage)
    }
    ssl.transform_in = ssl.transform_negotiate
    ssl.session_in = ssl.session_negotiate
    if ssl_is_dtls(ssl) {
        ssl_dtls_replay_reset(ssl)
        // A wrapping epoch is taken as an attack: no alert.
        ssl.in_epoch = (ssl.in_epoch + 1).bit_and(0xFFFF)
        if ssl.in_epoch == 0 -> return Err(.CounterWrapping)
    } else {
        ssldefs.ssl_fill(ssl.in_buf, ssl.in_ctr, ssldefs.SSL_SEQUENCE_NUMBER_LEN, U8{0})
    }
    ssl_update_in_pointers(ssl)
    ssl_handshake_increment_state(ssl)
}

// Parse and decrypt the DTLS record in buf (mbedtls_ssl_check_record's
// work). Decryption works on a copy, wiped after.
ssl_check_record_in: fn(ssl: &ssldefs.SSLContext, buf: [U8], buflen: Int) ssldefs.SSLError! {
    // There is no use for checking TLS records.
    if !ssl_is_dtls(ssl) -> return Err(.FeatureUnavailable)
    rec := ssldefs.SSLRecord{}
    ssl_parse_record_header(ssl, buf, 0, buflen, rec) ?? return Err(err)
    if ssl.transform_in >= 0 {
        scratch := ssldefs.ssl_bytes_of(buf, 0, buflen)
        if ssl_decrypt_buf(ssl.tpool[ssl.transform_in], rec, scratch) == {
            .Err(e) -> {
                ssldefs.ssl_wipe(scratch)
                return Err(e)
            }
            .Ok(_) -> ssldefs.ssl_wipe(scratch)
        }
    }
}

/// Check that the DTLS record in buf[0..<buflen] is valid for the context:
/// its header and its authentication (mbedtls_ssl_check_record). The
/// buffer is wiped. A record with an unexpected CID or of the next epoch is
/// UnexpectedRecord.
ssl_check_record: fn(ssl: &ssldefs.SSLContext, buf: &[U8], buflen: Int) ssldefs.SSLError! {
    if ssl_check_record_in(ssl, buf, buflen) == {
        .Err(e) -> {
            ssldefs.ssl_fill(buf, 0, buflen, U8{0})
            if e == {
                .UnexpectedCID | .EarlyMessage -> return Err(.UnexpectedRecord)
                .CryptoInProgress | .FeatureUnavailable | .BadInputData | .InvalidMac | .InvalidRecord | .ConnEOF | .DecodeError | .NoRNG | .NoClientCertificate | .UnsupportedExtension | .NoApplicationProtocol | .PrivateKeyRequired | .CAChainRequired | .UnexpectedMessage | .FatalAlertMessage | .UnrecognizedName | .PeerCloseNotify | .BadCertificate | .ReceivedNewSessionTicket | .CannotReadEarlyData | .ReceivedEarlyData | .CannotWriteEarlyData | .CacheEntryNotFound | .AllocFailed | .HwAccelFailed | .HwAccelFallthrough | .BadProtocolVersion | .HandshakeFailure | .SessionTicketExpired | .PKTypeMismatch | .UnknownIdentity | .InternalError | .CounterWrapping | .WaitingServerHelloRenego | .HelloVerifyRequired | .BufferTooSmall | .WantRead | .WantWrite | .Timeout | .ClientReconnect | .UnexpectedRecord | .NonFatal | .IllegalParameter | .ContinueProcessing | .AsyncInProgress | .VersionMismatch | .BadConfig | .CertificateVerificationWithoutHostname | .CorruptionDetected | .GenericError | .RandomFailed | .Cipher(_) | .PK(_) | .X509(_) | .ECP(_) | .DHM(_) | .Mpi(_) | .Callback(_) -> return Err(e)
            }
        }
        .Ok(_) -> ssldefs.ssl_fill(buf, 0, buflen, U8{0})
    }
}

// ---------------------------------------------------------------------------
// Application data.

// memcmp's sign over a[aoff..<aoff+len] and b[boff..<boff+len].
ssl_bytes_cmp: fn(a: [U8], aoff: Int, b: [U8], boff: Int, len: Int) -> Int Never! {
    loop i in 0..<len {
        x: Int.from_u8(a[aoff + i])
        y: Int.from_u8(b[boff + i])
        if x != y -> return x - y
    }
    0
}

// Renegotiate when a record counter passes renego_period
// (ssl_check_ctr_renegotiate).
ssl_check_ctr_renegotiate: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    ep_len: ssl_ep_len(ssl)
    if !ssl_is_handshake_over(ssl) || ssl.renego_status == ssldefs.SSL_RENEGOTIATION_PENDING || ssl.conf.disable_renegotiation == ssldefs.SSL_RENEGOTIATION_DISABLED -> return
    in_ctr_cmp: ssl_bytes_cmp(ssl.in_buf, ssl.in_ctr + ep_len, ssl.conf.renego_period, ep_len, ssldefs.SSL_SEQUENCE_NUMBER_LEN - ep_len)
    out_ctr_cmp: ssl_bytes_cmp(ssl.cur_out_ctr, ep_len, ssl.conf.renego_period, ep_len, ssldefs.SSL_SEQUENCE_NUMBER_LEN - ep_len)
    if in_ctr_cmp <= 0 && out_ctr_cmp <= 0 -> return
    ssltls.ssl_renegotiate(ssl, rng)
}

// Whether the handshake message read is a TLS 1.3 NewSessionTicket
// (ssl_tls13_is_new_session_ticket).
ssl_tls13_is_new_session_ticket: fn(ssl: ssldefs.SSLContext) -> Bool Never! {
    ssl.in_hslen != ssl_hs_hdr_len(ssl) && ssldefs.ssl_u8(ssl.in_buf, ssl.in_msg) == ssldefs.SSL_HS_NEW_SESSION_TICKET
}

// A TLS 1.3 handshake message after the handshake: a client hands a
// NewSessionTicket to the handshake when tickets are signaled, WantRead,
// or ignores it (ssl_tls13_handle_hs_message_post_handshake).
ssl_tls13_handle_hs_message_post_handshake: fn(ssl: &ssldefs.SSLContext) ssldefs.SSLError! {
    if ssl.conf.endpoint == ssldefs.SSL_IS_CLIENT && ssl_tls13_is_new_session_ticket(ssl) {
        if ssl.conf.session_tickets.bit_and(2) != 0 {
            ssl.keep_current_message = 1
            ssl_handshake_set_state(ssl, ssldefs.SSL_TLS1_3_NEW_SESSION_TICKET)
            return Err(.WantRead)
        }
        return
    }
    Err(.UnexpectedMessage)
}

// A TLS 1.2 handshake message after the handshake, which may only start a
// renegotiation: HelloRequest to a client, ClientHello to a server; others
// fail TLS and are dropped for DTLS (ssl_tls12_handle_hs_message_post_handshake).
ssl_tls12_handle_hs_message_post_handshake: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    hs_type: ssldefs.ssl_u8(ssl.in_buf, ssl.in_msg)
    if ssl.conf.endpoint == ssldefs.SSL_IS_CLIENT && (hs_type != ssldefs.SSL_HS_HELLO_REQUEST || ssl.in_hslen != ssl_hs_hdr_len(ssl)) {
        // DTLS: probably from the last handshake.
        if ssl_is_dtls(ssl) -> return
        return Err(.UnexpectedMessage)
    }
    if ssl.conf.endpoint == ssldefs.SSL_IS_SERVER && hs_type != ssldefs.SSL_HS_CLIENT_HELLO {
        if ssl_is_dtls(ssl) -> return
        return Err(.UnexpectedMessage)
    }
    refuse: ssl.conf.disable_renegotiation == ssldefs.SSL_RENEGOTIATION_DISABLED || (ssl.secure_renegotiation == ssldefs.SSL_LEGACY_RENEGOTIATION && ssl.conf.allow_legacy_renegotiation == ssldefs.SSL_LEGACY_NO_RENEGOTIATION)
    if refuse {
        ssl_send_alert_message(ssl, ssldefs.SSL_ALERT_LEVEL_WARNING, ssldefs.SSL_ALERT_MSG_NO_RENEGOTIATION, rng) ?? return Err(err)
        return
    }
    // A DTLS client must know the renegotiation is the server's.
    if ssl_is_dtls(ssl) && ssl.conf.endpoint == ssldefs.SSL_IS_CLIENT -> ssl.renego_status = ssldefs.SSL_RENEGOTIATION_PENDING
    // The ClientHello is kept for ssl_parse_client_hello.
    if ssl.conf.endpoint == ssldefs.SSL_IS_SERVER -> ssl.keep_current_message = 1
    if ssltls.ssl_start_renegotiation(ssl, rng) == {
        .Err(e) -> {
            if e == {
                .WaitingServerHelloRenego -> {}
                .CryptoInProgress | .FeatureUnavailable | .BadInputData | .InvalidMac | .InvalidRecord | .ConnEOF | .DecodeError | .NoRNG | .NoClientCertificate | .UnsupportedExtension | .NoApplicationProtocol | .PrivateKeyRequired | .CAChainRequired | .UnexpectedMessage | .FatalAlertMessage | .UnrecognizedName | .PeerCloseNotify | .BadCertificate | .ReceivedNewSessionTicket | .CannotReadEarlyData | .ReceivedEarlyData | .CannotWriteEarlyData | .CacheEntryNotFound | .AllocFailed | .HwAccelFailed | .HwAccelFallthrough | .BadProtocolVersion | .HandshakeFailure | .SessionTicketExpired | .PKTypeMismatch | .UnknownIdentity | .InternalError | .CounterWrapping | .HelloVerifyRequired | .BufferTooSmall | .WantRead | .WantWrite | .Timeout | .ClientReconnect | .UnexpectedRecord | .NonFatal | .IllegalParameter | .ContinueProcessing | .AsyncInProgress | .EarlyMessage | .UnexpectedCID | .VersionMismatch | .BadConfig | .CertificateVerificationWithoutHostname | .CorruptionDetected | .GenericError | .RandomFailed | .Cipher(_) | .PK(_) | .X509(_) | .ECP(_) | .DHM(_) | .Mpi(_) | .Callback(_) -> return Err(e)
            }
        }
        .Ok(_) -> {}
    }
}

// ssl_handle_hs_message_post_handshake, by protocol version.
ssl_handle_hs_message_post_handshake: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    if ssl.tls_version == ssldefs.SSL_VERSION_TLS1_3 -> return ssl_tls13_handle_hs_message_post_handshake(ssl)
    if ssl.tls_version <= ssldefs.SSL_VERSION_TLS1_2 -> return ssl_tls12_handle_hs_message_post_handshake(ssl, rng)
    Err(.InternalError)
}

// Copy up to `len` bytes of the application data at in_offt to buf, wiping
// what was read (ssl_read_application_data).
ssl_read_application_data: fn(ssl: &ssldefs.SSLContext, buf: &[U8], len: Int) -> Int Never! {
    n: if len < ssl.in_msglen -> len else -> ssl.in_msglen
    if len != 0 {
        ssldefs.ssl_copy_into(buf, 0, ssl.in_buf, ssl.in_offt, n)
        ssl.in_msglen -= n
    }
    ssldefs.ssl_fill(ssl.in_buf, ssl.in_offt, n, U8{0})
    if ssl.in_msglen == 0 {
        ssl.in_offt = -1
        ssl.keep_current_message = 0
    } else {
        ssl.in_offt += n
    }
    n
}

/// Read up to `len` bytes of application data into buf[0..<len]
/// (mbedtls_ssl_read): the count read, 0 at the end of the connection. The
/// handshake, or a renegotiation, is carried on first.
ssl_read: fn<R: RNG>(ssl: &ssldefs.SSLContext, buf: &[U8], len: Int, rng: &R) -> Int ssldefs.SSLError! {
    if !ssl.has_conf -> return Err(.BadInputData)
    if ssl_is_dtls(ssl) {
        ssl_flush_output(ssl) ?? return Err(err)
        if ssl.has_handshake && ssl.handshake.retransmit_state == ssldefs.SSL_RETRANS_SENDING -> ssl_flight_transmit(ssl, rng) ?? return Err(err)
    }
    // A renegotiation, or the handshake, runs first; a client that meets
    // something else while it waits for the ServerHello of a renegotiation
    // (WaitingServerHelloRenego) goes on to it.
    if ssl_check_ctr_renegotiate(ssl, rng) == {
        .Err(e) -> {
            if e == {
                .WaitingServerHelloRenego -> {}
                .CryptoInProgress | .FeatureUnavailable | .BadInputData | .InvalidMac | .InvalidRecord | .ConnEOF | .DecodeError | .NoRNG | .NoClientCertificate | .UnsupportedExtension | .NoApplicationProtocol | .PrivateKeyRequired | .CAChainRequired | .UnexpectedMessage | .FatalAlertMessage | .UnrecognizedName | .PeerCloseNotify | .BadCertificate | .ReceivedNewSessionTicket | .CannotReadEarlyData | .ReceivedEarlyData | .CannotWriteEarlyData | .CacheEntryNotFound | .AllocFailed | .HwAccelFailed | .HwAccelFallthrough | .BadProtocolVersion | .HandshakeFailure | .SessionTicketExpired | .PKTypeMismatch | .UnknownIdentity | .InternalError | .CounterWrapping | .HelloVerifyRequired | .BufferTooSmall | .WantRead | .WantWrite | .Timeout | .ClientReconnect | .UnexpectedRecord | .NonFatal | .IllegalParameter | .ContinueProcessing | .AsyncInProgress | .EarlyMessage | .UnexpectedCID | .VersionMismatch | .BadConfig | .CertificateVerificationWithoutHostname | .CorruptionDetected | .GenericError | .RandomFailed | .Cipher(_) | .PK(_) | .X509(_) | .ECP(_) | .DHM(_) | .Mpi(_) | .Callback(_) -> return Err(e)
            }
        }
        .Ok(_) -> {}
    }
    if ssl.state != ssldefs.SSL_HANDSHAKE_OVER {
        if ssltls.ssl_handshake(ssl, rng) == {
            .Err(e) -> {
                if e == {
                    .WaitingServerHelloRenego -> {}
                    .CryptoInProgress | .FeatureUnavailable | .BadInputData | .InvalidMac | .InvalidRecord | .ConnEOF | .DecodeError | .NoRNG | .NoClientCertificate | .UnsupportedExtension | .NoApplicationProtocol | .PrivateKeyRequired | .CAChainRequired | .UnexpectedMessage | .FatalAlertMessage | .UnrecognizedName | .PeerCloseNotify | .BadCertificate | .ReceivedNewSessionTicket | .CannotReadEarlyData | .ReceivedEarlyData | .CannotWriteEarlyData | .CacheEntryNotFound | .AllocFailed | .HwAccelFailed | .HwAccelFallthrough | .BadProtocolVersion | .HandshakeFailure | .SessionTicketExpired | .PKTypeMismatch | .UnknownIdentity | .InternalError | .CounterWrapping | .HelloVerifyRequired | .BufferTooSmall | .WantRead | .WantWrite | .Timeout | .ClientReconnect | .UnexpectedRecord | .NonFatal | .IllegalParameter | .ContinueProcessing | .AsyncInProgress | .EarlyMessage | .UnexpectedCID | .VersionMismatch | .BadConfig | .CertificateVerificationWithoutHostname | .CorruptionDetected | .GenericError | .RandomFailed | .Cipher(_) | .PK(_) | .X509(_) | .ECP(_) | .DHM(_) | .Mpi(_) | .Callback(_) -> return Err(e)
                }
            }
            .Ok(_) -> {}
        }
    }
    loop ssl.in_offt < 0 {
        if ssl.timer.enabled && ssl_timer_state(ssl) == -1 -> ssl_set_timer(ssl, ssl.conf.read_timeout)
        if ssl_read_record(ssl, true, rng) == {
            .Err(e) -> {
                if e == {
                    .ConnEOF -> return 0
                    .CryptoInProgress | .FeatureUnavailable | .BadInputData | .InvalidMac | .InvalidRecord | .DecodeError | .NoRNG | .NoClientCertificate | .UnsupportedExtension | .NoApplicationProtocol | .PrivateKeyRequired | .CAChainRequired | .UnexpectedMessage | .FatalAlertMessage | .UnrecognizedName | .PeerCloseNotify | .BadCertificate | .ReceivedNewSessionTicket | .CannotReadEarlyData | .ReceivedEarlyData | .CannotWriteEarlyData | .CacheEntryNotFound | .AllocFailed | .HwAccelFailed | .HwAccelFallthrough | .BadProtocolVersion | .HandshakeFailure | .SessionTicketExpired | .PKTypeMismatch | .UnknownIdentity | .InternalError | .CounterWrapping | .WaitingServerHelloRenego | .HelloVerifyRequired | .BufferTooSmall | .WantRead | .WantWrite | .Timeout | .ClientReconnect | .UnexpectedRecord | .NonFatal | .IllegalParameter | .ContinueProcessing | .AsyncInProgress | .EarlyMessage | .UnexpectedCID | .VersionMismatch | .BadConfig | .CertificateVerificationWithoutHostname | .CorruptionDetected | .GenericError | .RandomFailed | .Cipher(_) | .PK(_) | .X509(_) | .ECP(_) | .DHM(_) | .Mpi(_) | .Callback(_) -> return Err(e)
                }
            }
            .Ok(_) -> {}
        }
        // OpenSSL sends empty records to randomize the IV.
        if ssl.in_msglen == 0 && ssl.in_msgtype == ssldefs.SSL_MSG_APPLICATION_DATA {
            if ssl_read_record(ssl, true, rng) == {
                .Err(e) -> {
                    if e == {
                        .ConnEOF -> return 0
                        .CryptoInProgress | .FeatureUnavailable | .BadInputData | .InvalidMac | .InvalidRecord | .DecodeError | .NoRNG | .NoClientCertificate | .UnsupportedExtension | .NoApplicationProtocol | .PrivateKeyRequired | .CAChainRequired | .UnexpectedMessage | .FatalAlertMessage | .UnrecognizedName | .PeerCloseNotify | .BadCertificate | .ReceivedNewSessionTicket | .CannotReadEarlyData | .ReceivedEarlyData | .CannotWriteEarlyData | .CacheEntryNotFound | .AllocFailed | .HwAccelFailed | .HwAccelFallthrough | .BadProtocolVersion | .HandshakeFailure | .SessionTicketExpired | .PKTypeMismatch | .UnknownIdentity | .InternalError | .CounterWrapping | .WaitingServerHelloRenego | .HelloVerifyRequired | .BufferTooSmall | .WantRead | .WantWrite | .Timeout | .ClientReconnect | .UnexpectedRecord | .NonFatal | .IllegalParameter | .ContinueProcessing | .AsyncInProgress | .EarlyMessage | .UnexpectedCID | .VersionMismatch | .BadConfig | .CertificateVerificationWithoutHostname | .CorruptionDetected | .GenericError | .RandomFailed | .Cipher(_) | .PK(_) | .X509(_) | .ECP(_) | .DHM(_) | .Mpi(_) | .Callback(_) -> return Err(e)
                    }
                }
                .Ok(_) -> {}
            }
        }
        if ssl.in_msgtype == ssldefs.SSL_MSG_HANDSHAKE {
            // Whether or not a renegotiation it starts completes, the next
            // pass reads on: a new record, the application data met, or the
            // message held back while waiting for the ServerHello.
            ssl_handle_hs_message_post_handshake(ssl, rng) ?? return Err(err)
            next
        }
        if ssl.renego_status == ssldefs.SSL_RENEGOTIATION_PENDING && ssl.conf.renego_max_records >= 0 {
            ssl.renego_records_seen += 1
            if ssl.renego_records_seen > ssl.conf.renego_max_records -> return Err(.UnexpectedMessage)
        }
        // read_record handled fatal and closure alerts.
        if ssl.in_msgtype == ssldefs.SSL_MSG_ALERT -> return Err(.WantRead)
        if ssl.in_msgtype != ssldefs.SSL_MSG_APPLICATION_DATA -> return Err(.UnexpectedMessage)
        ssl.in_offt = ssl.in_msg
        // Data is returned now: the timer stops but in a renegotiation.
        if ssl_is_handshake_over(ssl) -> ssl_set_timer(ssl, 0)
        // A DTLS server that asked for a renegotiation and got data asks
        // again, after in_offt is set so WantWrite does not come back here.
        if ssl_is_dtls(ssl) && ssl.conf.endpoint == ssldefs.SSL_IS_SERVER && ssl.renego_status == ssldefs.SSL_RENEGOTIATION_PENDING {
            ssltls.ssl_resend_hello_request(ssl, rng) ?? return Err(err)
        }
    }
    ssl_read_application_data(ssl, buf, len)
}

// Write buf[0..<len] as one application data record within the record
// payload limit (ssl_write_real): the count written. TLS writes a prefix of
// a longer buffer; DTLS fails it. After WantWrite the pending record is
// flushed, and the caller repeats the call with the same data.
ssl_write_real: fn<R: RNG>(ssl: &ssldefs.SSLContext, buf: [U8], len0: Int, rng: &R) -> Int ssldefs.SSLError! {
    max_len: ssltls.ssl_get_max_out_record_payload(ssl) ?? return Err(err)
    len := len0
    if len > max_len {
        if ssl_is_dtls(ssl) -> return Err(.BadInputData)
        len = max_len
    }
    if ssl.out_left != 0 {
        ssl_flush_output(ssl) ?? return Err(err)
    } else {
        ssl.out_msglen = len
        ssl.out_msgtype = ssldefs.SSL_MSG_APPLICATION_DATA
        if len > 0 -> ssldefs.ssl_copy_into(ssl.out_buf, ssl.out_msg, buf, 0, len)
        ssl_write_record(ssl, true, rng) ?? return Err(err)
    }
    len
}

/// Write application data from buf[0..<len] (mbedtls_ssl_write): the count
/// written, which may be less than `len` for TLS. Zero-length records may
/// be sent (RFC 5246 6.2.1).
ssl_write: fn<R: RNG>(ssl: &ssldefs.SSLContext, buf: [U8], len: Int, rng: &R) -> Int ssldefs.SSLError! {
    if !ssl.has_conf -> return Err(.BadInputData)
    ssl_check_ctr_renegotiate(ssl, rng) ?? return Err(err)
    if ssl.state != ssldefs.SSL_HANDSHAKE_OVER -> ssltls.ssl_handshake(ssl, rng) ?? return Err(err)
    ssl_write_real(ssl, buf, len, rng)
}

/// Tell the peer the connection is closing (mbedtls_ssl_close_notify).
ssl_close_notify: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    if !ssl.has_conf -> return Err(.BadInputData)
    if ssl_is_handshake_over(ssl) -> ssl_send_alert_message(ssl, ssldefs.SSL_ALERT_LEVEL_WARNING, ssldefs.SSL_ALERT_MSG_CLOSE_NOTIFY, rng) ?? return Err(err)
}

/// Read records under `transform`, a pool index or -1, from sequence number
/// 0 (mbedtls_ssl_set_inbound_transform).
ssl_set_inbound_transform: fn(ssl: &ssldefs.SSLContext, transform: Int) Never! {
    ssl.transform_in = transform
    ssldefs.ssl_fill(ssl.in_buf, ssl.in_ctr, ssldefs.SSL_SEQUENCE_NUMBER_LEN, U8{0})
}

/// Write records under `transform`, a pool index or -1, from sequence
/// number 0 (mbedtls_ssl_set_outbound_transform).
ssl_set_outbound_transform: fn(ssl: &ssldefs.SSLContext, transform: Int) Never! {
    ssl.transform_out = transform
    ssldefs.ssl_fill(ssl.cur_out_ctr, 0, ssl.cur_out_ctr.len(), U8{0})
}

// ---------------------------------------------------------------------------
// DTLS buffering slots.

/// Drop every buffered message and record (mbedtls_ssl_buffering_free).
ssl_buffering_free: fn(ssl: &ssldefs.SSLContext) Never! {
    if !ssl.has_handshake -> return
    ssl_free_buffered_record(ssl)
    loop offset in 0..<ssldefs.SSL_MAX_BUFFERED_HS -> ssl_buffering_free_slot(ssl, offset)
}

// Wipe and drop buffering slot `slot` (ssl_buffering_free_slot).
ssl_buffering_free_slot: fn(ssl: &ssldefs.SSLContext, slot: Int) Never! {
    if slot >= ssldefs.SSL_MAX_BUFFERED_HS || slot >= ssl.handshake.hs.len() -> return
    if ssl.handshake.hs[slot].is_valid {
        ssl.handshake.total_bytes_buffered -= ssl.handshake.hs[slot].data.len()
        ssldefs.ssl_wipe(ssl.handshake.hs[slot].data)
        ssl.handshake.hs[slot] = ssldefs.SSLHsBuffer{}
    }
}

// Shift the buffering slots left by `shift`: slot i then holds what slot
// i + shift held (ssl_buffering_shift_slots).
ssl_buffering_shift_slots: fn(ssl: &ssldefs.SSLContext, shift0: Int) Never! {
    if shift0 == 0 -> return
    shift: if shift0 >= ssldefs.SSL_MAX_BUFFERED_HS -> ssldefs.SSL_MAX_BUFFERED_HS else -> shift0
    // The discarded entries are freed, the rest moved down, and empty
    // entries fill the end.
    loop offset in 0..<shift -> ssl_buffering_free_slot(ssl, offset)
    loop _ in 0..<shift {
        _ := ssl.handshake.hs.remove(0, .Slot)
        ssl.handshake.hs.push(ssldefs.SSLHsBuffer{})
    }
}

// ---------------------------------------------------------------------------
// Pending alerts.

/// Send the pending fatal alert, if any (mbedtls_ssl_handle_pending_alert):
/// the send's error, or else the alert's reason. After WantWrite the alert
/// stays pending.
ssl_handle_pending_alert: fn<R: RNG>(ssl: &ssldefs.SSLContext, rng: &R) ssldefs.SSLError! {
    if ssl.send_alert == 0 -> return
    if ssl_send_alert_message(ssl, ssldefs.SSL_ALERT_LEVEL_FATAL, ssl.alert_type, rng) == {
        .Err(e) -> {
            if e == {
                .WantWrite -> {}
                .CryptoInProgress | .FeatureUnavailable | .BadInputData | .InvalidMac | .InvalidRecord | .ConnEOF | .DecodeError | .NoRNG | .NoClientCertificate | .UnsupportedExtension | .NoApplicationProtocol | .PrivateKeyRequired | .CAChainRequired | .UnexpectedMessage | .FatalAlertMessage | .UnrecognizedName | .PeerCloseNotify | .BadCertificate | .ReceivedNewSessionTicket | .CannotReadEarlyData | .ReceivedEarlyData | .CannotWriteEarlyData | .CacheEntryNotFound | .AllocFailed | .HwAccelFailed | .HwAccelFallthrough | .BadProtocolVersion | .HandshakeFailure | .SessionTicketExpired | .PKTypeMismatch | .UnknownIdentity | .InternalError | .CounterWrapping | .WaitingServerHelloRenego | .HelloVerifyRequired | .BufferTooSmall | .WantRead | .Timeout | .ClientReconnect | .UnexpectedRecord | .NonFatal | .IllegalParameter | .ContinueProcessing | .AsyncInProgress | .EarlyMessage | .UnexpectedCID | .VersionMismatch | .BadConfig | .CertificateVerificationWithoutHostname | .CorruptionDetected | .GenericError | .RandomFailed | .Cipher(_) | .PK(_) | .X509(_) | .ECP(_) | .DHM(_) | .Mpi(_) | .Callback(_) -> ssl.send_alert = 0
            }
            return Err(e)
        }
        .Ok(_) -> ssl.send_alert = 0
    }
    if ssl.alert_reason == {
        .Val(reason) -> return Err(reason)
        None -> {}
    }
}

/// Set a fatal alert pending, to fail with `alert_reason`
/// (mbedtls_ssl_pend_fatal_alert).
ssl_pend_fatal_alert: fn(ssl: &ssldefs.SSLContext, alert_type: Int, alert_reason: ssldefs.SSLError) Never! {
    ssl.send_alert = 1
    ssl.alert_type = alert_type
    ssl.alert_reason = alert_reason
}
