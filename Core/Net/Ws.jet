use {
    core: core
    url: core.net.url
    http: core.http
    core.http.[HTTPRequest]
}
#Error
WsError: enum {
    InvalidURL
    InvalidHandshake
    Protocol
    Timeout
    Closed
    Cancelled
    UnsupportedTarget
    MessageTooLarge(limit: Int)
    IO(operation: String)
}

// The provider owns socket I/O, entropy, and frame codec. Jet validates the
// URL and handshake shape before crossing the typed boundary. Control bytes
// and spaces are refused in the text as written: parsing percent-encodes
// them, which would carry a hostile URL through to the handshake.
connect: fn(url_text: String) -[Net, Time.Wait]> WsConn WsError! {
    loop byte in url_text.bytes() {
        if byte <= (U8{32}) || byte == (U8{127}) -> return Err(WsError.InvalidURL)
    }
    parsed: url.parse(url_text) ?? return Err(WsError.InvalidURL)
    if parsed.scheme() != "ws" -> return Err(WsError.UnsupportedTarget)
    if parsed.host() == None || parsed.userinfo().bytes().len() > 0 {
        return Err(WsError.InvalidURL)
    }
    fragment := parsed.fragment() ?? ""
    if fragment.bytes().len() > 0 -> return Err(WsError.InvalidURL)
    core.net.ws.__connect(url.unparse(parsed))
}

upgrade: fn(request: HTTPRequest) -[Net, Time.Wait]> WsConn WsError! {
    if request.method() != "GET" -> return Err(WsError.InvalidHandshake)
    upgrade_header: request.header("upgrade") ?? return Err(WsError.InvalidHandshake)
    if !header_has_token(upgrade_header, "websocket") -> return Err(WsError.InvalidHandshake)
    connection_header: request.header("connection") ?? return Err(WsError.InvalidHandshake)
    if !header_has_token(connection_header, "upgrade") -> return Err(WsError.InvalidHandshake)
    version: request.header("sec-websocket-version") ?? return Err(WsError.InvalidHandshake)
    if trim_ascii(version) != "13" -> return Err(WsError.InvalidHandshake)
    key: request.header("sec-websocket-key") ?? return Err(WsError.InvalidHandshake)
    if key.bytes().len() == 0 || key.bytes().len() > 256 -> return Err(WsError.InvalidHandshake)
    fd: http.__upgrade_claim(request) ?? return Err(WsError.InvalidHandshake)
    core.net.ws.__upgrade(fd, trim_ascii(key))
}

header_has_token: fn(value: String, wanted: String) -> Bool Never! {
    raw: ascii_lower(value).bytes()
    target: ascii_lower(wanted)
    start := 0
    i := 0
    loop i <= raw.len() {
        if i == raw.len() || raw[i] == (U8{44}) {
            piece: trim_ascii(slice(raw, start, i))
            if piece == target -> return true
            start = i + 1
        }
        i = i + 1
    }
    false
}

trim_ascii: fn(text: String) -> String Never! {
    raw: text.bytes()
    start := 0
    end := raw.len()
    loop start < end {
        n: Int{raw[start]}
        if n == 32 || n == 9 || n == 10 || n == 13 -> start = start + 1 else -> break
    }
    loop end > start {
        n: Int{raw[end - 1]}
        if n == 32 || n == 9 || n == 10 || n == 13 -> end = end - 1 else -> break
    }
    if end <= start -> return ""
    slice(raw, start, end)
}

ascii_lower: fn(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n: Int{b}
        if n >= 65 && n <= 90 -> out.push(U8{n + 32}) else -> out.push(b)
    }
    String.from_bytes(out) ?? ""
}

slice: fn(raw: [U8], start: Int, end: Int) -> String Never! {
    out := [U8]{}
    i := start
    loop {
        if i >= end -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i = i + 1
    }
}

