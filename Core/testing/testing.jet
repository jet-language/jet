package {
    name: "core.testing"
    version: "0.0.1"
    edition: "2026"
    description: "Assertions, fixtures, goldens, and fake clocks."
    license: "MIT"
    outputs: {
        testing: .Library{ entry: testing }
    }
}
use core as core
use core.files as files
use core.sys as sys
use core.math.random as random

// D-VIS-REEXPORT1 / D-ALIAS-BIND2: a second spelling, never a second owner.
pub alias RNG :: random.RNG

// core.testing — deterministic tests and comparison records.
//
// Fixture, golden, world, and suite state remain host-owned;
// callback comparison and bounded history generation stay portable Jet code.

pub fn assert_equal(comparison: TestComparison) -> Bool Never! {
    // The typed provider also requires recorded samples; the source twin can
    // validate only the scalar proof fields exposed by the declaration.
    comparison.status == "matched" && !comparison.universal_proof && comparison.first_difference < 0
}

/// D-CALLBACK-ERR1=A: both callbacks share one failure type `E`, which the
/// comparison passes up; two callbacks that cannot fail make it `Never`.
pub fn compare<E>(cases: [DataTree], reference: fn(DataTree) -> DataTree E!, candidate: fn(DataTree) -> DataTree E!, relation: String) -> TestComparison E! {
    normalized := relation
    if normalized.len() == 0 -> normalized = "typed_equality"
    if normalized == "ordered_effects" || normalized == "typed_failure" {
        return terminal_comparison(normalized, "relation requires recorded observations")
    }
    if cases.len() == 0 -> return terminal_comparison(normalized, "comparison needs at least one case")
    inputs := [DataTree]{}
    reference_values := [DataTree]{}
    candidate_values := [DataTree]{}
    case_ids := [String]{}
    first_difference := -1
    loop i in 0..<cases.len() {
        input :: cases[i]
        expected :: reference(input)
        actual :: candidate(input)
        &inputs.push(input)
        &reference_values.push(expected)
        &candidate_values.push(actual)
        &case_ids.push("case-{i}")
        if first_difference < 0 && !expected.equal_unordered(actual) -> first_difference = i
    }
    status := "matched"
    reason := "comparison matched all cases"
    if first_difference >= 0 {
        status = "mismatch"
        reason = "reference and candidate differ at case-{first_difference}"
    }
    TestComparison{
        status: status,
        relation: normalized,
        source: "core.testing",
        tool: "jet",
        target: "embedded-prelude",
        seed: None,
        case_ids: case_ids,
        inputs: inputs,
        reference: reference_values,
        candidate: candidate_values,
        first_difference: first_difference,
        reason: reason,
        universal_proof: false,
    }
}

fn terminal_comparison(relation: String, reason: String) -> TestComparison {
    TestComparison{
        status: "unavailable",
        relation: relation,
        source: "core.testing",
        tool: "jet",
        target: "embedded-prelude",
        seed: None,
        case_ids: [String]{},
        inputs: [DataTree]{},
        reference: [DataTree]{},
        candidate: [DataTree]{},
        first_difference: -1,
        reason: reason,
        universal_proof: false,
    }
}

/// Compare or create a snapshot. Updating observes JET_UPDATE_SNAPSHOTS,
/// so the environment read is part of the declared effect row.
pub fn snap(name: String, value: String) -[FS, Env]> Bool Never! {
    path :: "__snapshots__/{snapshot_name(name)}.snap"
    update :: (sys.get("JET_UPDATE_SNAPSHOTS") ?? "") == "1"
    if update || !files.is_file(path) {
        if files.mkdir("__snapshots__", true) == {
            .Ok(_) -> {}
            .Err(_) -> {}
        }
        files.write(path, value) ?? return false
        return true
    }
    expected :: files.read(path) ?? return false
    expected == value
}

pub fn golden(name: String, value: String) -[FS]> Bool Never! {
    core.testing.golden(name, value)
}

pub fn fixture(name: String) -[FS]> String Never! { core.testing.fixture(name) }

pub fn temp_dir(prefix: String) -[FS]> String Never! { core.testing.temp_dir(prefix) }

/// Read each readable regular file in a directory, ordered by its full path.
/// The parameter retains the historical spelling `glob`; it names a directory.
pub fn corpus(glob: String) -[FS]> [String] Never! {
    entries :: files.list_dir(glob) ?? return [String]{}
    paths := [String]{}
    loop entry in entries -> &paths.push(entry.path)
    &paths.sort()
    values := [String]{}
    loop path in paths {
        if !files.is_file(path) -> next
        value :: files.read(path) ?? next
        &values.push(value)
    }
    values
}

/// The test-facing spelling of the deterministic Prelude `Clock` built by `Clock.new`.
pub fn fake_clock(unix_ms: Int) -> Clock Never! { Clock.new(unix_ms) }

/// A caller-owned deterministic RNG seeded by the ordinary source constructor.
pub fn fake_rng(seed: Int) -> random.RNG Never! { random.rng(seed) }

/// Deterministic fake data uses the same source SplitMix64 stream as RNG.
pub fn fake_data(seed: Int) -> Fake Never! {
    Fake{state: U64{Int{I64{seed}} & 18446744073709551615}, locale_code: 0}
}

pub struct Fake {
    state: U64
    locale_code: Int

    impl Display {
        fn display(self) -> String {
            language :: if self.locale_code == 1 -> "de" else -> "en"
            "Fake {{ locale: {language} }}"
        }
    }

    impl Debug {
        fn debug(self) -> String Never! {
            "Fake {{ state: {self.state}, locale: {self.locale_code} }}"
        }
    }

    pub fn locale(self, locale: String) -> Fake Never! {
        code :: if locale == "en" -> 0 else if locale == "de" -> 1 else -> panic("unsupported fake-data locale `{locale}`; supported locales: en, de")
        Fake{state: self.state ~| (U64{code}.wrapping_mul(U64{15111065706836454659})), locale_code: code}
    }

    pub fn name(&self) -> String Never! {
        first :: fake_first(&self.state, self.locale_code)
        last :: fake_last(&self.state, self.locale_code)
        "{first} {last}"
    }

    pub fn email(&self) -> String Never! {
        first :: core.text.parse.lower(fake_first(&self.state, self.locale_code))
        last :: core.text.parse.lower(fake_last(&self.state, self.locale_code))
        host :: fake_host(&self.state, self.locale_code)
        "{first}.{last}@{host}"
    }

    pub fn host(&self) -> String Never! {
        name :: fake_host(&self.state, self.locale_code)
        "www.{name}"
    }

    pub fn address(&self) -> String Never! {
        number :: core.math.random.__seeded_int(&self.state, 1, 999) ?? panic("fake address has a valid range")
        street :: fake_street(&self.state, self.locale_code)
        city :: fake_city(&self.state, self.locale_code)
        "{number} {street}, {city}"
    }
}

FAKE_EN_FIRST :: [String]{"Alice", "Bob", "Clara", "Diego"}
FAKE_EN_LAST :: [String]{"Smith", "Jones", "Taylor", "Brown"}
FAKE_EN_HOSTS :: [String]{"example.test", "mail.test", "demo.test"}
FAKE_EN_STREETS :: [String]{"Oak Street", "Pine Street", "Maple Street", "Cedar Street"}
FAKE_EN_CITIES :: [String]{"Austin", "Boston", "Denver", "Portland"}
FAKE_DE_FIRST :: [String]{"Anna", "Bruno", "Clara", "Dieter"}
FAKE_DE_LAST :: [String]{"Schmidt", "Fischer", "Weber", "Wagner"}
FAKE_DE_HOSTS :: [String]{"beispiel.test", "mail.test", "demo.test"}
FAKE_DE_STREETS :: [String]{"Bahnhofstraße", "Hauptstraße", "Lindenweg", "Gartenweg"}
FAKE_DE_CITIES :: [String]{"Berlin", "Bremen", "Dresden", "Hamburg"}

fn fake_index(state: &U64, count: Int) -> Int Never! {
    core.math.random.__seeded_int(&state, 0, count - 1) ?? panic("fake tables are nonempty")
}

fn fake_first(state: &U64, locale: Int) -> String Never! {
    index :: fake_index(&state, 4)
    if locale == 1 -> FAKE_DE_FIRST[index] else -> FAKE_EN_FIRST[index]
}

fn fake_last(state: &U64, locale: Int) -> String Never! {
    index :: fake_index(&state, 4)
    if locale == 1 -> FAKE_DE_LAST[index] else -> FAKE_EN_LAST[index]
}

fn fake_host(state: &U64, locale: Int) -> String Never! {
    index :: fake_index(&state, 3)
    if locale == 1 -> FAKE_DE_HOSTS[index] else -> FAKE_EN_HOSTS[index]
}

fn fake_street(state: &U64, locale: Int) -> String Never! {
    index :: fake_index(&state, 4)
    if locale == 1 -> FAKE_DE_STREETS[index] else -> FAKE_EN_STREETS[index]
}

fn fake_city(state: &U64, locale: Int) -> String Never! {
    index :: fake_index(&state, 4)
    if locale == 1 -> FAKE_DE_CITIES[index] else -> FAKE_EN_CITIES[index]
}

#Test("Fake English draw order matches the shipped seed 42 corpus") {
    fake := fake_data(42)
    assert_eq(&fake.name(), "Clara Smith")
    assert_eq(&fake.email(), "bob.jones@example.test")
    assert_eq(&fake.host(), "www.demo.test")
    assert_eq(&fake.address(), "219 Cedar Street, Boston")
}

#Test("Fake German locale salt and draw order match the shipped seed 42 corpus") {
    fake := fake_data(42).locale("de")
    assert_eq(&fake.name(), "Dieter Schmidt")
    assert_eq(&fake.email(), "bruno.schmidt@mail.test")
    assert_eq(&fake.host(), "www.beispiel.test")
    assert_eq(&fake.address(), "406 Hauptstraße, Berlin")
}

#Test("Fake copies keep independent streams and locale selection does not draw") {
    original := fake_data(-1)
    duplicate := ~original
    english := original.locale("en")
    assert_eq(&original.name(), &duplicate.name())
    fresh := fake_data(-1)
    assert_eq(&english.name(), &fresh.name())
}

#Test("Fake debug keeps the native state and locale field rendering") {
    assert_eq(fake_data(42).debug(), "Fake {{ state: 42, locale: 0 }}")
}

/// The Prelude `TestSuite` carrying the current harness iteration and result.
pub fn test_suite() -> TestSuite Never! { core.testing.test_suite() }

pub fn world(body: fn(DeterministicWorld)) Never! { core.testing.world(body) }

pub fn status(comparison: TestComparison) -> String Never! { comparison.status }


#Test("corpus reports an absent directory as an empty collection") {
    assert_eq(corpus("__jet_absent_corpus__/missing").len(), 0)
}

fn snapshot_name(name: String) -> String Never! {
    out := [U8]{}
    loop byte in name.bytes() {
        c :: Int.from_u8(byte)
        if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 95 {
            &out.push(byte)
        } else if c < 128 || c >= 192 {
            // String is valid UTF-8; only a leading byte starts a scalar.
            &out.push(U8{95})
        }
    }
    if out.len() == 0 -> return "case"
    String.from_bytes(out) ?? panic("snapshot names contain only ASCII")
}

#Test("Snapshot names replace each non-ASCII scalar exactly once") {
    assert_eq(snapshot_name(""), "case")
    assert_eq(snapshot_name("a/B.c é界"), "a_B_c___")
    assert_eq(snapshot_name("safe-Name_42"), "safe-Name_42")
}
