package {
    name: "core.testing"
    version: "0.1.0"
    edition: "2026"
    description: "Assertions, fixtures, goldens, and fake clocks."
    license: "MIT"
    outputs: {
        testing: .Library{ entry: testing }
    }
}
use core as core

// core.testing — deterministic tests and comparison records.
//
// Fixture, golden, world, fake-data, and suite state remain host-owned;
// callback comparison and bounded history generation stay portable Jet code.

pub fn assert_equal(comparison: TestComparison) -> Bool Never! {
    // The typed provider also requires recorded samples; the source twin can
    // validate only the scalar proof fields exposed by the declaration.
    comparison.status == "matched" && !comparison.universal_proof && comparison.first_difference < 0
}

/// D-CALLBACK-ERR1=A: both callbacks share one failure type `E`, which the
/// comparison passes up; two callbacks that cannot fail make it `Never`.
pub fn compare<E>(cases: [DataTree], reference: fn(DataTree) -> DataTree E!, candidate: fn(DataTree) -> DataTree E!, relation: String) -> TestComparison E! {
    normalized := relation
    if normalized.len() == 0 -> normalized = "typed_equality"
    if normalized == "ordered_effects" || normalized == "typed_failure" {
        return terminal_comparison(normalized, "relation requires recorded observations")
    }
    if cases.len() == 0 -> return terminal_comparison(normalized, "comparison needs at least one case")
    inputs := [DataTree]{}
    reference_values := [DataTree]{}
    candidate_values := [DataTree]{}
    case_ids := [String]{}
    first_difference := -1
    loop i in 0..<cases.len() {
        input :: cases[i]
        expected :: reference(input)
        actual :: candidate(input)
        &inputs.push(input)
        &reference_values.push(expected)
        &candidate_values.push(actual)
        &case_ids.push("case-{i}")
        if first_difference < 0 && !expected.equal_unordered(actual) -> first_difference = i
    }
    status := "matched"
    reason := "comparison matched all cases"
    if first_difference >= 0 {
        status = "mismatch"
        reason = "reference and candidate differ at case-{first_difference}"
    }
    TestComparison{
        status: status,
        relation: normalized,
        source: "core.testing",
        tool: "jet",
        target: "embedded-prelude",
        seed: None,
        case_ids: case_ids,
        inputs: inputs,
        reference: reference_values,
        candidate: candidate_values,
        first_difference: first_difference,
        reason: reason,
        universal_proof: false,
    }
}

fn terminal_comparison(relation: String, reason: String) -> TestComparison {
    TestComparison{
        status: "unavailable",
        relation: relation,
        source: "core.testing",
        tool: "jet",
        target: "embedded-prelude",
        seed: None,
        case_ids: [String]{},
        inputs: [DataTree]{},
        reference: [DataTree]{},
        candidate: [DataTree]{},
        first_difference: -1,
        reason: reason,
        universal_proof: false,
    }
}

/// Compare or create a host-managed snapshot for `name`.
pub fn snap(name: String, value: String) -[FS]> Bool Never! { core.testing.snap(name, value) }

pub fn golden(name: String, value: String) -[FS]> Bool Never! {
    core.testing.golden(name, value)
}

pub fn fixture(name: String) -[FS]> String Never! { core.testing.fixture(name) }

pub fn temp_dir(prefix: String) -[FS]> String Never! { core.testing.temp_dir(prefix) }

pub fn corpus(glob: String) -[FS]> [String] Never! { core.testing.corpus(glob) }

/// The test-facing spelling of the deterministic Prelude `Clock` built by `Clock.new`.
pub fn fake_clock(unix_ms: Int) -> Clock Never! { Clock.new(unix_ms) }

/// A deterministic Prelude `Rng` seeded by the provider constructor.
pub fn fake_rng(seed: Int) -> RNG Never! { core.testing.fake_rng(seed) }

/// The deterministic Prelude `Fake` data capability built by the provider constructor.
pub fn fake_data(seed: Int) -> Fake Never! { core.testing.fake_data(seed) }

/// The Prelude `TestSuite` carrying the current harness iteration and result.
pub fn test_suite() -> TestSuite Never! { core.testing.test_suite() }

pub fn world(body: fn(DeterministicWorld)) Never! { core.testing.world(body) }

pub fn status(comparison: TestComparison) -> String Never! { comparison.status }

