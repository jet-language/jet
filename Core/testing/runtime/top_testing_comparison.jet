use core.encoding.runtime.std_data_tree.[DataTree, render_datatree_json]
use core.testing.runtime.std_testing_comparison.JetTestComparison
use core.prelude.runtime.kernel_values.JetShow
use jet_foundation.TestingComparison.[ObservationRelation, ComparisonObservation, ComparisonRecord, ComparisonStatus, ComparisonIdentity, ComparisonSample, compare_samples]
use std.env
use std.panic.[catch_unwind, AssertUnwindSafe]

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingComparison.rs:6
fn jet_testing_relation(relation: String) -> ObservationRelation {
    match relation.as_str() {
        "" | "typed_equality" -> ObservationRelation.TypedEquality
        "ordered_effects" -> ObservationRelation.OrderedEffects
        "typed_failure" -> ObservationRelation.TypedFailure
        other -> ObservationRelation.Custom(other.to_string())
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingComparison.rs:25
fn jet_testing_observation(value: DataTree) -> ComparisonObservation {
    ComparisonObservation.value(render_datatree_json(value, false, 0))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingComparison.rs:33
fn jet_testing_record(record: ^ComparisonRecord, cases: [DataTree], reference_values: ^[DataTree], candidate_values: ^[DataTree], seed: I64?) -> JetTestComparison {
    case_ids :: record.samples.iter().map(sample -> sample.identity.case_id.clone()).collect::<[String]>()
    first_difference :: record.first_difference.map(index -> I64{index}).unwrap_or(I64{-1})
    JetTestComparison{
        status: record.status.as_str().to_string(), relation: record.relation.as_str().to_string(),
        source: "core.testing", tool: "jet", target: "embedded-prelude", seed,
        case_ids: ^case_ids, inputs: cases.clone(), reference: ^reference_values, candidate: ^candidate_values,
        first_difference, reason: record.reason.unwrap_or_else(fn() { "comparison has no reason" }),
        universal_proof: record.universal_proof
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingComparison.rs:68
// GATE #4565: kernel primitive
#Unsafe("read property seed and contain each callable panic; a crash is unavailable, never matched")
pub fn jet_testing_compare(cases: [DataTree], reference: fn(DataTree) -> DataTree, candidate: fn(DataTree) -> DataTree, relation: String) -> JetTestComparison {
    relation :: jet_testing_relation(relation)
    if !relation.supports_plain_callable() && matches(relation.as_str(), "ordered_effects" | "typed_failure") {
        record :: ComparisonRecord.terminal(^relation, ComparisonStatus.Unsupported, "relation requires recorded observations")
        return jet_testing_record(^record, cases, ^[DataTree]{}, ^[DataTree]{}, None)
    }
    seed :: env.var("JET_PROP_SEED").ok().and_then(value -> value.parse::<I64>().ok())
    samples := [ComparisonSample].with_capacity(cases.len())
    reference_values := [DataTree].with_capacity(cases.len())
    candidate_values := [DataTree].with_capacity(cases.len())
    for (index, input) in cases.iter().enumerate() {
        reference_value :: match catch_unwind(AssertUnwindSafe(fn() { reference(input.clone()) })) {
            Ok(value) -> ^value
            Err(_) -> {
                record :: ComparisonRecord.terminal(relation.clone(), ComparisonStatus.Unavailable, "reference implementation crashed on case-{index}")
                return jet_testing_record(^record, cases, ^reference_values, ^candidate_values, seed)
            }
        }
        candidate_value :: match catch_unwind(AssertUnwindSafe(fn() { candidate(input.clone()) })) {
            Ok(value) -> ^value
            Err(_) -> {
                reference_values.push(^reference_value)
                record :: ComparisonRecord.terminal(relation.clone(), ComparisonStatus.Unavailable, "candidate implementation crashed on case-{index}")
                return jet_testing_record(^record, cases, ^reference_values, ^candidate_values, seed)
            }
        }
        identity :: ComparisonIdentity.new("case-{index}", "input-{index}", "core.testing", "jet", "embedded-prelude")
        samples.push(ComparisonSample.new(^identity, jet_testing_observation(reference_value), jet_testing_observation(candidate_value)))
        reference_values.push(^reference_value)
        candidate_values.push(^candidate_value)
    }
    record :: compare_samples(^relation, ^samples)
    jet_testing_record(^record, cases, ^reference_values, ^candidate_values, seed)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingComparison.rs:144
pub fn jet_testing_assert_equal(comparison: JetTestComparison) -> Bool {
    comparison.status == "matched" && !comparison.universal_proof && comparison.first_difference < 0 && !comparison.inputs.is_empty()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingComparison.rs:151
pub fn jet_testing_status(comparison: JetTestComparison) -> String { comparison.status.clone() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingComparison.rs:155
impl JetShow for JetTestComparison {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingComparison.rs:156
    fn jet_show(self) -> String {
        "TestComparison {{ status: {self.status}, relation: {self.relation}, first_difference: {self.first_difference}, reason: {self.reason} }}"
    }
}
