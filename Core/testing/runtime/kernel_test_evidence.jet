// D-CLAIM1 / D-TEST-EVIDENCE1: typed test meaning and validation only.
use jet_foundation.Evidence.[EvidenceProducerKind, EvidenceOutcome, EvidenceExpectation, EvidenceMergeError, EvidenceExpectationError, EvidenceReport, EvidenceRecord, EvidenceProjection, EVIDENCE_REPORT_VERSION]
use std.fmt.[Display, Formatter]

// Rust: crates/jet-codegen/src/Prelude/Core/TestEvidence.rs:6
#Derive(Clone, Debug, PartialEq, Eq)
#Error
pub enum TestEvidenceError {
    SchemaConflict{expected: U16, found: U16}
    ProducerConflict{expected: EvidenceProducerKind, found: EvidenceProducerKind}
    EmptyReportId
    EmptyClaimId
    EmptyEvidenceId
    InvalidOutcome{outcome: EvidenceOutcome}
    InvalidExpectation{expectation: EvidenceExpectation, outcome: EvidenceOutcome}
    IdentityConflict{field: String, expected: String, found: String}
    Io{operation: String, path: String, message: String}
    GoldenMissing{path: String}
    GoldenUnreadable{path: String}
    GoldenMismatch{path: String, diff: String}
    FixtureMissing{path: String}
    FixtureUnreadable{path: String}
    ContradictoryOutcome{claim_id: String, existing: EvidenceOutcome, found: EvidenceOutcome}
    Foundation(EvidenceMergeError)
}
impl TestEvidenceError {
    // Rust: crates/jet-codegen/src/Prelude/Core/TestEvidence.rs:45
    pub fn io<O: Into<String>, P: Into<String>, M: Into<String>>(operation: O, path: P, message: M) -> TestEvidenceError Never! {
        .Io{operation: operation.into(), path: path.into(), message: message.into()}
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/TestEvidence.rs:59
    pub fn report_parts(self) -> (String, String) Never! {
        rendered :: self.to_string()
        rendered.split_once('\n').map((message, detail) -> (message.to_string(), detail.to_string())).unwrap_or((rendered, ""))
    }
}
impl Display for TestEvidenceError {
    // Rust: crates/jet-codegen/src/Prelude/Core/TestEvidence.rs:69
    fn fmt(self: TestEvidenceError, output: &Formatter) -> () std.fmt.Error! {
        match self {
            .SchemaConflict{expected, found} -> output.write_fmt("test evidence requires jet.evidence/v{expected}, found v{found}")
            .ProducerConflict{expected, found} -> output.write_fmt("test evidence producer must be {expected.as_str()}, found {found.as_str()}")
            .EmptyReportId -> output.write_str("test evidence report id must not be empty")
            .EmptyClaimId -> output.write_str("test evidence claim id must not be empty")
            .EmptyEvidenceId -> output.write_str("test evidence evidence id must not be empty")
            .IdentityConflict{field, expected, found} -> output.write_fmt("test evidence identity conflict for {field}: {expected} versus {found}")
            .InvalidOutcome{outcome} -> output.write_fmt("test evidence outcome {outcome.as_str()} is not a terminal test outcome")
            .InvalidExpectation{expectation, outcome} -> output.write_fmt("test evidence expectation {expectation.as_str()} cannot describe outcome {outcome.as_str()}")
            .Io{operation, path, message} -> output.write_fmt("test evidence {operation} failed for {path}: {message}")
            .GoldenMissing{path} -> output.write_fmt("golden file is missing: {path}\npath: {path}")
            .GoldenUnreadable{path} -> output.write_fmt("golden file cannot be read: {path}\npath: {path}")
            .GoldenMismatch{path, diff} -> output.write_fmt("golden file differs: {path}\npath: {path}\n{diff}")
            .FixtureMissing{path} -> output.write_fmt("fixture is missing: {path}\npath: {path}")
            .FixtureUnreadable{path} -> output.write_fmt("fixture cannot be read: {path}\npath: {path}")
            .ContradictoryOutcome{claim_id, existing, found} -> output.write_fmt(
                "test claim {claim_id} has contradictory terminal outcomes: {existing.as_str()} versus {found.as_str()}")
            .Foundation(error) -> error.fmt(output)
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/TestEvidence.rs:146
impl From<EvidenceMergeError> for TestEvidenceError {
    // Rust: crates/jet-codegen/src/Prelude/Core/TestEvidence.rs:147
    fn from(error: EvidenceMergeError) -> TestEvidenceError Never! { .Foundation(error) }
}
// Rust: crates/jet-codegen/src/Prelude/Core/TestEvidence.rs:151
impl From<EvidenceExpectationError> for TestEvidenceError {
    // Rust: crates/jet-codegen/src/Prelude/Core/TestEvidence.rs:152
    fn from(error: EvidenceExpectationError) -> TestEvidenceError Never! {
        match error { .InvalidOutcome{expectation, outcome} -> .InvalidExpectation{expectation, outcome} }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/TestEvidence.rs:166
fn validate_test_report(report: EvidenceReport) -> TestEvidenceError! {
    if report.schema_version != EVIDENCE_REPORT_VERSION {
        return Err(.SchemaConflict{expected: EVIDENCE_REPORT_VERSION, found: report.schema_version})
    }
    if report.producer != .Test -> return Err(.ProducerConflict{expected: .Test, found: report.producer})
    if report.identity.report_id.is_empty() -> return Err(.EmptyReportId)
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/Core/TestEvidence.rs:187
// Generated properties and producer-unavailable outcomes are terminal wire records.
fn is_terminal_test_outcome(outcome: EvidenceOutcome) -> Bool Never! {
    match outcome {
        .Generated | .Passed | .Failed | .Skipped | .Unavailable | .Error -> true
        _ -> false
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/TestEvidence.rs:199
fn validate_test_record(report: EvidenceReport, record: EvidenceRecord) -> TestEvidenceError! {
    if record.producer != .Test -> return Err(.ProducerConflict{expected: .Test, found: record.producer})
    if record.identity.report_id != report.identity.report_id {
        return Err(.IdentityConflict{field: "report_id", expected: ~report.identity.report_id, found: ~record.identity.report_id})
    }
    if record.identity.claim_id.is_empty() -> return Err(.EmptyClaimId)
    if record.identity.evidence_id.is_empty() -> return Err(.EmptyEvidenceId)
    if not is_terminal_test_outcome(record.outcome) -> return Err(.InvalidOutcome{outcome: record.outcome})
    record.validate().map_err(TestEvidenceError.from)?
    if not report.identity.claim_id.is_empty() && report.identity.claim_id != record.identity.claim_id {
        return Err(.IdentityConflict{field: "claim_id", expected: ~report.identity.claim_id, found: ~record.identity.claim_id})
    }
    if not report.identity.evidence_id.is_empty() && report.identity.evidence_id != record.identity.evidence_id {
        return Err(.IdentityConflict{field: "evidence_id", expected: ~report.identity.evidence_id, found: ~record.identity.evidence_id})
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/Core/TestEvidence.rs:249
fn validate_test_records(report: EvidenceReport) -> TestEvidenceError! {
    outcomes := [@String:EvidenceOutcome]{}
    evidence := [@String:@EvidenceRecord]{}
    loop record in report.records {
        validate_test_record(report, record)?
        if outcomes.get(record.identity.claim_id) is Val(existing) {
            if existing != record.outcome {
                return Err(.ContradictoryOutcome{claim_id: ~record.identity.claim_id, existing, found: record.outcome})
            }
        } else { _ :: &outcomes.insert(@record.identity.claim_id, record.outcome) }
        if evidence.get(record.identity.evidence_id) is Val(existing) {
            if existing != record {
                return Err(.Foundation(EvidenceMergeError.RecordConflict{evidence_id: ~record.identity.evidence_id}))
            }
        } else { _ :: &evidence.insert(@record.identity.evidence_id, @record) }
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/Core/TestEvidence.rs:284
// Preserve identities, source, revision, attachments, diagnostics and derivation.
pub fn record_test_case(report: &EvidenceReport, record: ^EvidenceRecord) -> TestEvidenceError! {
    validate_test_report(report)?
    validate_test_record(report, record)?
    if report.records.iter().find(existing -> existing.identity.claim_id == record.identity.claim_id) is Val(existing) {
        if existing.outcome != record.outcome {
            return Err(.ContradictoryOutcome{claim_id: ~record.identity.claim_id, existing: existing.outcome, found: record.outcome})
        }
    }
    result :: if record.derivation.is_some() { report.add_record(^record) }
        else {
            derivation :: record.checked_derivation()
            report.add_record_with_derivation(^record, derivation)
        }
    result.map_err(TestEvidenceError.Foundation)
}
// Rust: crates/jet-codegen/src/Prelude/Core/TestEvidence.rs:317
pub fn finalize_test_report(report: ^EvidenceReport) -> EvidenceReport TestEvidenceError! {
    owned := ^report
    validate_test_report(owned)?
    validate_test_records(owned)?
    records :: &owned.records.take()
    loop record in ^records -> record_test_case(&owned, ^record)?
    Ok(^owned)
}
// Rust: crates/jet-codegen/src/Prelude/Core/TestEvidence.rs:331
pub fn query_test_evidence(report: EvidenceReport, claim_id: String?) -> [EvidenceProjection] TestEvidenceError! {
    validate_test_report(report)?
    validate_test_records(report)?
    Ok(report.query(claim_id))
}

