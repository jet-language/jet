use core.cell.[Cell, ThreadLocal]

// Rust: crates/jet-codegen/src/Prelude/CommandSuite.rs:5
pub type JetSuiteRunner = fn() -> (I64, I64)
// Rust: crates/jet-codegen/src/Prelude/CommandSuite.rs:8
pub struct JetTestSuite {
    pub iteration: I64
    pub result: I64
    pub runner: JetSuiteRunner?
}
// Rust: crates/jet-codegen/src/Prelude/CommandSuite.rs:15-17
// GATE #4565: kernel primitive — per-thread harness snapshot storage.
const JET_TEST_RUNNER: ThreadLocal<Cell<JetSuiteRunner?>> = ThreadLocal.new(fn() { Cell.new(None) })
const JET_TEST_ITERATION: ThreadLocal<Cell<I64>> = ThreadLocal.new(fn() { Cell.new(I64{0}) })
const JET_TEST_RESULT: ThreadLocal<Cell<I64>> = ThreadLocal.new(fn() { Cell.new(I64{0}) })
// Rust: crates/jet-codegen/src/Prelude/CommandSuite.rs:20
pub fn jet_test_suite_install(runner: JetSuiteRunner) Never! {
    #Unsafe("access harness TLS only on its owning thread") {
        JET_TEST_RUNNER.with(fn(slot) { slot.set(Val(runner)) })
        JET_TEST_ITERATION.with(fn(slot) { slot.set(I64{0}) })
        JET_TEST_RESULT.with(fn(slot) { slot.set(I64{0}) })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CommandSuite.rs:26
pub fn jet_test_suite_new() -> JetTestSuite Never! {
    #Unsafe("copy three same-thread harness snapshot cells") {
        JetTestSuite{iteration: JET_TEST_ITERATION.with(fn(slot) { slot.get() }),
            result: JET_TEST_RESULT.with(fn(slot) { slot.get() }),
            runner: JET_TEST_RUNNER.with(fn(slot) { slot.get() })}
    }
}
// Rust: crates/jet-codegen/src/Prelude/CommandSuite.rs:38
pub fn jet_test_suite_run(suite: JetTestSuite) -> I64 Never! {
    runner :: suite.runner ?? return suite.result
    (iteration, result) :: runner()
    #Unsafe("write same-thread harness counters without changing caller snapshot") {
        JET_TEST_ITERATION.with(fn(slot) { slot.set(iteration) })
        JET_TEST_RESULT.with(fn(slot) { slot.set(result) })
    }
    result
}
// Rust: crates/jet-codegen/src/Prelude/CommandSuite.rs:48
pub fn jet_test_suite_status() -> I64 Never! {
    #Unsafe("read harness result on owning thread") { JET_TEST_RESULT.with(fn(slot) { slot.get() }) }
}
