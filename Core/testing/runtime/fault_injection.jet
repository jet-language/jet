// D-TESTFAULT1=A / D-EFFTREE1: one deterministic scheduler over typed effects.
use core.cell.[RefCell, ThreadLocal]
use std.panic as panic_native

// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:9
const JET_FAULT_MAX_ATTEMPTS: Int = 4096
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:15
#Equatable
enum JetFaultTarget { EffectPath(String), Allocation }
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:21
struct JetFaultState {
    targets: [JetFaultTarget]
    counts: [USize]
    active: Int?
    fail_nth: USize
    injected: Bool
}
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:20 (derived Default)
fn fault_empty_state() -> JetFaultState Never! {
    JetFaultState{targets: [], counts: [], active: None, fail_nth: USize{0}, injected: false}
}
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:29
// GATE #4565: kernel primitive — same-thread retained scheduler cell.
const JET_FAULT_STATE: ThreadLocal<RefCell<JetFaultState>> = ThreadLocal.new(fn() { RefCell.new(fault_empty_state()) })
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:34
fn jet_fault_clear() Never! {
    #Unsafe("replace only the current thread's scheduler") {
        JET_FAULT_STATE.with(fn(state) { &state.replace(fault_empty_state()) })
    }
}
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:40
fn jet_fault_state_is_clear() -> Bool Never! {
    #Unsafe("borrow scheduler on its owning thread") {
        JET_FAULT_STATE.with(fn(cell) {
            state :: cell.borrow()
            state.targets.is_empty() && state.counts.is_empty() && state.active == None && state.fail_nth == USize{0} && not state.injected
        })
    }
}
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:53
fn jet_fault_effect_covers(bound: String, observed: String) -> Bool Never! {
    if observed == bound -> return true
    suffix := observed.strip_prefix(bound) ?? return false // #4303
    suffix.starts_with('.')
}
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:60
fn jet_fault_record(state: &JetFaultState, target_index: Int, inject: Bool) -> Bool Never! {
    if target_index >= state.counts.len() -> return false
    state.counts[target_index] = state.counts[target_index].saturating_add(USize{1})
    injected :: inject && state.fail_nth != USize{0} && state.counts[target_index] == state.fail_nth
    if injected -> state.injected = true
    injected
}
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:78
pub fn jet_fault_should_fail(operation: String) -> Bool Never! {
    #Unsafe("same-thread mutable scheduler borrow does not outlive operation observation") {
        JET_FAULT_STATE.with(fn(cell) {
            state := cell.borrow_mut()
            active :: state.active
            injected := false
            loop index in 0..<state.targets.len() {
                matches :: if state.targets[index] == {
                    .EffectPath(selector) -> jet_fault_effect_covers(selector, operation)
                    .Allocation -> false
                }
                if matches {
                    failed :: jet_fault_record(&state, index, active == Val(index))
                    injected = injected || failed
                }
            }
            injected
        })
    }
}
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:102
pub fn jet_fault_should_fail_allocation() -> Bool Never! {
    #Unsafe("allocation rail observes the current thread's fault schedule") {
        JET_FAULT_STATE.with(fn(cell) {
            state := cell.borrow_mut()
            loop index in 0..<state.targets.len() {
                if state.targets[index] == .Allocation {
                    inject :: state.active == Val(index)
                    return jet_fault_record(&state, index, inject)
                }
            }
            false
        })
    }
}
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:120
fn jet_fault_seed(selectors: View<String>) -> U64 Never! {
    seed := U64{14695981039346656037}
    loop selector in selectors {
        loop byte in selector.bytes() {
            seed = seed ~| U64.from_u8(byte)
            seed = seed.wrapping_mul(U64{1099511628211})
        }
        seed = seed ~| U64{255}
        seed = seed.wrapping_mul(U64{1099511628211})
    }
    seed.max(U64{1})
}
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:133
struct JetFaultScope {}
impl Drop for JetFaultScope {
    // Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:136
    fn drop(self: &JetFaultScope) Never! { jet_fault_clear() }
}
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:144
struct JetFaultRun {
    result: Unit Err!
    injected: Bool
    counts: [USize]
    scheduler_clean: Bool
}
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:151
fn jet_fault_run_once_with_cleanup(selectors: View<String>, active: Int?, fail_nth: USize, body: &fn() -> Unit Err!) -> JetFaultRun Err! {
    targets := [JetFaultTarget]{}
    loop selector in selectors -> &targets.push(.EffectPath(selector.to_string()))
    &targets.push(.Allocation)
    count :: targets.len()
    if active is Val(index) -> if index >= count -> return Err("fault schedule selected an invalid target")
    // GATE #4565: kernel primitive — TLS and caught unwind retain ordinary cleanup paths.
    #Unsafe("install the actual thread-local schedule and catch native unwind without suppressing errors") {
        JET_FAULT_STATE.with(fn(cell) {
            state := cell.borrow_mut()
            state.targets = ^targets
            state.counts = [USize].filled(count, USize{0})
            state.active = active
            state.fail_nth = fail_nth
            state.injected = false
        })
    }
    scope :: JetFaultScope{}
    result :: #Unsafe("catch unwind around the body; scope and body destructors run normally") {
        panic_native.catch_unwind(panic_native.AssertUnwindSafe(body))
    }
    (injected, counts) :: #Unsafe("snapshot same-thread observations before scheduler scope drops") {
        JET_FAULT_STATE.with(fn(cell) {
            state :: cell.borrow()
            (state.injected, state.counts.clone())
        })
    }
    drop(^scope)
    scheduler_clean :: jet_fault_state_is_clear()
    if not scheduler_clean -> return Err("fault scheduler cleanup did not complete")
    outcome :: if result == {
        Ok(outcome) -> outcome
        Err(_) -> return Err("test panicked during fault injection")
    }
    Ok(JetFaultRun{result: outcome, injected: injected, counts: counts, scheduler_clean: scheduler_clean})
}
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:207
fn jet_fault_run_once(selectors: View<String>, active: Int?, fail_nth: USize, body: &fn() -> Unit Err!) -> (Unit Err!, Bool, [USize]) Err! {
    run :: jet_fault_run_once_with_cleanup(selectors, active, fail_nth, &body) ?? return Err(err)
    Ok((run.result, run.injected, run.counts))
}
// Rust: crates/jet-codegen/src/Prelude/FaultInjection.rs:222
pub fn jet_fault_test_loop(selectors: View<String>, body: &fn() -> Unit Err!) Err! {
    if selectors.is_empty() -> return body()
    seed :: jet_fault_seed(selectors)
    count :: selectors.len() + 1
    clean :: jet_fault_run_once_with_cleanup(selectors, None, USize{0}, &body) ?? return Err(err)
    if not clean.scheduler_clean -> return Err("fault scheduler cleanup did not complete")
    if clean.result is Err(error) -> return Err(error)
    max_counts := ^clean.counts
    next := [USize].filled(count, USize{1})
    attempts := 0
    loop {
        discovered := false
        index := 0
        loop index < count {
            nth := next[index]
            loop nth <= max_counts[index] {
                if attempts >= JET_FAULT_MAX_ATTEMPTS -> return Err("fault schedule exceeded {JET_FAULT_MAX_ATTEMPTS} attempts (seed {seed})")
                attempts += 1
                run :: jet_fault_run_once_with_cleanup(selectors, Val(index), nth, &body) ?? return Err(err)
                if not run.scheduler_clean -> return Err("fault scheduler cleanup did not complete")
                if not run.injected -> if run.result is Err(error) -> return Err(error)
                if run.injected {
                    loop other in 0..<run.counts.len() {
                        if run.counts[other] > max_counts[other] {
                            max_counts[other] = run.counts[other]
                            discovered = true
                        }
                    }
                }
                nth = nth.saturating_add(USize{1})
                next[index] = nth
            }
            index += 1
        }
        complete := true
        loop index in 0..<count -> if next[index] <= max_counts[index] -> complete = false
        if not discovered && complete -> break
    }
    Ok(())
}
