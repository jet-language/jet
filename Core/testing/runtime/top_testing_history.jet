fn jet_history_type_codec<T>(checked_type: String, encode: Fn(&T, USize) -> DataTree Err! + Send + Sync) -> JetHistoryTypeCodec {
    JetHistoryTypeCodec{checked_type: ^checked_type, encode: Arc.new(fn(value, depth) {
