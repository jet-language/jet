        operation.arguments = array_any(value, &["arguments"], "{label}.arguments")?.iter().enumerate().map(fn((index, value)) { history_value(value, "{label}.arguments[{index}]") }).collect_results()?
        operation.creates = array_any(value, &["creates"], "{label}.creates")?.iter().enumerate().map(fn((index, value)) { history_id(value, "{label}.creates[{index}]").map(fn(value) { HandleId{value: value} }) }).collect_results()?
        operation.consumes = array_any(value, &["consumes"], "{label}.consumes")?.iter().enumerate().map(fn((index, value)) { history_id(value, "{label}.consumes[{index}]").map(fn(value) { HandleId{value: value} }) }).collect_results()?
        operation.preconditions = array_any(value, &["preconditions"], "{label}.preconditions")?.iter().enumerate().map(fn((index, value)) { history_precondition(value, "{label}.preconditions[{index}]") }).collect_results()?
        operation.depends_on = array_any(value, &["depends_on", "dependsOn"], "{label}.depends_on")?.iter().enumerate().map(fn((index, value)) {
