}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingHistory.rs:339
fn jet_testing_history_execute<Command: Clone>(model: &Fn(&[Command]) -> JetOutcome<DataTree, JetErr>, actual: &Fn(&[Command]) -> JetOutcome<DataTree, JetErr>, observe: &Fn(&DataTree) -> JetOutcome<DataTree, JetErr>, commands: &[Command]) -> (DataTree, DataTree, ComparisonObservation, ComparisonObservation) Err! {
    reference_value :: jet_testing_history_apply(model, commands.to_vec(), "model")?
    candidate_value :: jet_testing_history_apply(actual, commands.to_vec(), "actual")?
    reference_observed :: jet_testing_history_apply(observe, reference_value.clone(), "observe").map(fn(value) { jet_testing_history_observation(&value) })?
    candidate_observed :: jet_testing_history_apply(observe, candidate_value.clone(), "observe").map(fn(value) { jet_testing_history_observation(&value) })?
    Ok((^reference_value, ^candidate_value, ^reference_observed, ^candidate_observed))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingHistory.rs:373
fn jet_testing_history_record(record: ComparisonRecord, inputs: [DataTree], reference: [DataTree], candidate: [DataTree], seed: I64?, provenance: (&HistoryProvenance)?) -> JetTestComparison {
    (source, tool, target) :: provenance.map(fn(provenance) { (provenance.source.clone(), provenance.tool.clone(), provenance.target.clone()) }).unwrap_or_else(fn() { (String.new(), String.new(), String.new()) })
    JetTestComparison{
        status: record.status.as_str().to_string(), relation: record.relation.as_str().to_string(),
        source: ^source, tool: ^tool, target: ^target, seed: seed,
        case_ids: record.samples.iter().map(fn(sample) { sample.identity.case_id.clone() }).collect(),
        inputs: ^inputs, reference: ^reference, candidate: ^candidate,
        first_difference: record.first_difference.map(fn(index) { index as I64 }).unwrap_or(-1),
        reason: record.reason.unwrap_or_else(fn() { "history comparison has no reason" }),
        universal_proof: record.universal_proof
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingHistory.rs:415
pub fn jet_testing_histories<Command: HistoryCommand>(seed: I64, cases: I64, strategy: JetHistoryStrategy<Command>?, model: Box<Fn([Command]) -> DataTree>, actual: Box<Fn([Command]) -> DataTree>, observe: Box<Fn(DataTree) -> DataTree>) -> JetTestComparison Err! {
    model_adapter :: Box.new(fn(commands: &[Command]) { Ok(model(commands.clone())) as JetOutcome<DataTree, JetErr> })
    actual_adapter :: Box.new(fn(commands: &[Command]) { Ok(actual(commands.clone())) as JetOutcome<DataTree, JetErr> })
    observe_adapter :: Box.new(fn(value: &DataTree) { Ok(observe(value.clone())) as JetOutcome<DataTree, JetErr> })
    jet_testing_histories_with_provenance(seed, cases, ^strategy, ^model_adapter, ^actual_adapter, ^observe_adapter, None)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingHistory.rs:448
// Compiler-private checked provenance stays outside the six Jet-visible history values.
pub fn jet_testing_histories_with_provenance<Command: HistoryCommand>(seed: I64, cases: I64, strategy: JetHistoryStrategy<Command>?, model: Box<Fn(&[Command]) -> JetOutcome<DataTree, JetErr>>, actual: Box<Fn(&[Command]) -> JetOutcome<DataTree, JetErr>>, observe: Box<Fn(&DataTree) -> JetOutcome<DataTree, JetErr>>, provenance: HistoryProvenance?) -> JetTestComparison Err! {
    bound_provenance :: provenance.and_then(fn(base) {
        bind :: fn() -> HistoryProvenance Err! {
            callbacks := [("model", jet_history_callback_fingerprint(model.as_ref())?), ("actual", jet_history_callback_fingerprint(actual.as_ref())?), ("observe", jet_history_callback_fingerprint(observe.as_ref())?)]
            if strategy.as_ref() == Val(strategy) {
                &callbacks.extend([("generate", jet_history_callback_fingerprint(strategy.generate.as_ref())?), ("rebuild", jet_history_callback_fingerprint(strategy.rebuild.as_ref())?), ("valid", jet_history_callback_fingerprint(strategy.valid.as_ref())?)])
            } else {
                identity :: "derived:{Command.history_command_type()}"
                &callbacks.push(("strategy", history_callback_value_fingerprint(identity, "[]".as_bytes()).map_err(fn(error) { error.to_string() })?))
            }
            references :: callbacks.iter().map(fn((role, identity)) { (*role, identity.as_str()) }).collect<[(String, String)]>()
            base.bind_callbacks(&references).map_err(fn(error) { error.to_string() })
        }
        bind().ok()
    })
    match strategy {
        Val(strategy) -> {
            generate :: ^strategy.generate
            rebuild :: ^strategy.rebuild
            valid :: ^strategy.valid
            foundation_strategy :: HistoryStrategy{
                generate: Box.new(fn(rng, index, steps) {
                    loan :: JetHistoryRngLoan.new(rng)
                    generate(loan.value.clone(), index, steps).ok()
                }),
                rebuild: Box.new(fn(case) { rebuild(case.clone()).ok() }),
                valid: Box.new(fn(case) { valid(case.clone()) }),
                bounds: ^strategy.bounds, distributions: ^strategy.distributions
            }
            jet_testing_histories_result_with_strategy(seed, cases, ^model, ^actual, ^observe, ^foundation_strategy, ^bound_provenance)
        }
        None -> jet_testing_histories_result_with_strategy(seed, cases, ^model, ^actual, ^observe, Command.history_strategy(), ^bound_provenance)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingHistory.rs:521
fn jet_testing_histories_result_with_strategy<Command: HistoryCommand, Strategy: HistoryStrategyBehavior<Command>>(seed: I64, cases: I64, model: Box<Fn(&[Command]) -> JetOutcome<DataTree, JetErr>>, actual: Box<Fn(&[Command]) -> JetOutcome<DataTree, JetErr>>, observe: Box<Fn(&DataTree) -> JetOutcome<DataTree, JetErr>>, strategy: Strategy, provenance: HistoryProvenance?) -> JetTestComparison Err! {
    (checked_seed, checked_cases) :: validate_history_bounds(seed, cases).map_err(fn(message) { message.to_string() })?
    bounds :: strategy.bounds()
    relation :: ObservationRelation.TypedEquality
    if provenance.is_none() {
        record :: ComparisonRecord.terminal(relation, .Unavailable, "history provenance is unavailable")
        return Ok(jet_testing_history_record(^record, [], [], [], Val(checked_seed as I64), None))
    }
    provenance :: provenance.unwrap()
    if strategy.unsupported_reason() == Val(reason) {
        record :: ComparisonRecord.terminal(relation.clone(), .Unsupported, reason)
        return Ok(jet_testing_history_record(^record, [], [], [], Val(checked_seed as I64), Val(&provenance)))
    }
    config :: HistoryConfig.new(checked_seed, checked_cases, bounds, provenance.source.clone(), provenance.tool.clone(), provenance.target.clone(), relation.clone(), OracleDeclaration.independent("testing.histories.model")).with_command_type(strategy.command_type())
    configured :: strategy.distributions().into_iter().fold(^config, fn(config, distribution) { config.with_distribution(^distribution) })
    runner :: HistoryRunner.new(^configured).map_err(fn(error) { error.to_string() })?
    inputs := [DataTree]{}
    reference_values := [DataTree]{}
    candidate_values := [DataTree]{}
    samples := [ComparisonSample]{}
    run :: runner.run_strategy<Command>(&strategy, fn(typed) {
        case :: &typed.case
        input :: match parse_json_datatree(case.json()) {
            Ok(input) -> ^input
            Err(error) -> return ComparisonRecord.terminal(relation.clone(), .Unavailable, "history input could not be decoded: {error.reason}")
        }
        (reference_value, candidate_value, reference_observed, candidate_observed) :: match jet_testing_history_execute(model.as_ref(), actual.as_ref(), observe.as_ref(), &typed.commands) {
            Ok(values) -> ^values
            Err(reason) -> return ComparisonRecord.terminal(relation.clone(), .Unavailable, ^reason)
        }
        (_reference_replay_value, _candidate_replay_value, reference_replay, candidate_replay) :: match jet_testing_history_execute(model.as_ref(), actual.as_ref(), observe.as_ref(), &typed.commands) {
            Ok(values) -> ^values
            Err(reason) -> return ComparisonRecord.terminal(relation.clone(), .Unavailable, ^reason)
        }
        identity := ComparisonIdentity.new(case.case_id.clone(), case.input_id(), provenance.source.clone(), provenance.tool.clone(), provenance.target.clone())
        identity.seed = Val(case.seed)
        sample :: ComparisonSample.new(^identity, ^reference_observed, ^candidate_observed).with_replays(^reference_replay, ^candidate_replay)
        &inputs.push(^input)
        &reference_values.push(^reference_value)
        &candidate_values.push(^candidate_value)
        &samples.push(sample.clone())
        compare_samples(relation.clone(), [^sample])
    }).map_err(fn(error) { error.to_string() })?
    if run.failure == Val(artifact) -> return Err("history-artifact {artifact.json()}")
    record := compare_samples_with_discarded(relation, ^samples, run.discarded_cases)
    if run.explored_cases == 0 {
        record.status = .Unavailable
        record.reason = Val("no history case produced an observation")
    }
    Ok(jet_testing_history_record(^record, ^inputs, ^reference_values, ^candidate_values, Val(checked_seed as I64), Val(&provenance)))
}
