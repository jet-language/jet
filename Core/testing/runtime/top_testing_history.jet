            Val(bytes.to_vec())
        })
        result :: input.and_then(fn(bytes) { str.from_utf8(&bytes).ok().map(str.to_string) }).and_then(fn(wire) { parse_json_typed_datatree(&wire).ok() }).map_or_else(fn() { Err("invalid testing history WebWasm wire JSON") }, fn(wire) { run_wire(&wire) })
        set_output(result_tree(^result))
        0
    }
}

