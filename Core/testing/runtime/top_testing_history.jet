// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingHistory.rs:275
fn jet_history_callback_fingerprint<F>(callback: &F) -> String Err! {
    metadata :: jet_history_callback_captures(callback)?
    identity :: metadata.get("function_identity")?.as_str()?
    captures :: metadata.get("captures")?
    bytes :: render_datatree_json(captures, false, 0).into_bytes()
    history_callback_value_fingerprint(identity, &bytes).map_err(fn(error) { error.to_string() })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingHistory.rs:284
fn jet_history_data_tree_capture(value: &DataTree, depth: USize) -> DataTree Err! {
    if depth >= 64 -> return Err("history capture exceeds the nesting bound")
    (kind, encoded) :: match value {
        .Null -> ("null", DataTree.Null)
        .Bool(value) -> ("bool", DataTree.Bool(*value))
        .Int(value) -> ("int", DataTree.Text(value.to_string()))
        .Float(value) -> ("float", DataTree.Text(value.to_bits().to_string()))
        .Number(value) -> ("number", DataTree.Text(value.clone()))
        .Text(value) -> ("text", DataTree.Text(value.clone()))
        .TypedText(value) -> ("typed_text", DataTree.Text(value.clone()))
        .Bytes(value) -> ("bytes", DataTree.Array(value.iter().map(fn(value) { DataTree.Int(*value as I64) }).collect()))
        .Array(values) -> ("array", DataTree.Array(values.iter().map(fn(value) { jet_history_data_tree_capture(value, depth + 1) }).collect<[DataTree] Err!>()?))
        .Object(fields) -> ("object", DataTree.Object(fields.iter().map(fn((name, value)) { Ok((name.clone(), jet_history_data_tree_capture(value, depth + 1)?)) }).collect<[(String, DataTree)] Err!>()?))
    }
    Ok(DataTree.Array([DataTree.Text(kind.to_string()), ^encoded]))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingHistory.rs:308
fn jet_testing_history_observation(value: &DataTree) -> ComparisonObservation {
    ComparisonObservation.value(render_datatree_json(value, false, 0))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingHistory.rs:316
fn jet_testing_history_apply<Input>(callback: &Fn(&Input) -> JetOutcome<DataTree, JetErr>, input: Input, role: String) -> DataTree Err! {
    // GATE #4565: kernel primitive
    result :: #Unsafe("catch callback unwind while input loan stays inside replay scope") { catch_unwind(AssertUnwindSafe(fn() { callback(&input) })) }.map_err(fn(_) { "{role} callback crashed while replaying a typed history" })?
    result.map_err(fn(error) { "{role} callback failed: {error}" })
}
