// Rust: crates/jet-codegen/src/Prelude/DevelopmentReceipt.rs:96
pub fn jet_production_failure_receipt_write(code: String, file: String, line: U32, function: String) -> String? Never! {
    // GATE #4483: dispatch on the compilation target, not the host.
    if target.selected_arch() == "wasm32" -> return None
    // GATE #4565: kernel primitive — environment, native paths and filesystem transaction.
    #Unsafe("read receipt configuration and create the redacted receipt with native filesystem semantics") {
        directory_text :: env.var(JET_DEVELOPMENT_RECEIPT_DIRECTORY_ENV) ?? return None
        entry :: env.var(JET_DEVELOPMENT_RECEIPT_ENTRY_ENV) ?? return None
        source_digest :: env.var(JET_DEVELOPMENT_RECEIPT_SOURCE_DIGEST_ENV) ?? return None
        closure_digest :: env.var(JET_DEVELOPMENT_RECEIPT_CLOSURE_DIGEST_ENV) ?? return None
        input_digest :: env.var(JET_DEVELOPMENT_RECEIPT_INPUT_DIGEST_ENV) ?? return None
        input_count_text :: env.var(JET_DEVELOPMENT_RECEIPT_INPUT_COUNT_ENV) ?? return None
        input_count :: USize.parse(input_count_text) ?? return None
        input_count_digest :: env.var(JET_DEVELOPMENT_RECEIPT_INPUT_COUNT_DIGEST_ENV) ?? return None
        target_name :: env.var(JET_DEVELOPMENT_RECEIPT_TARGET_ENV) ?? return None
        target_digest :: env.var(JET_DEVELOPMENT_RECEIPT_TARGET_DIGEST_ENV) ?? return None
        failure_file :: receipt_path(file, entry)
        record :: receipt.JetDevelopmentReceipt{
            act: "production-failure", locked_closure: closure_digest,
            inputs: [receipt_input("entry", source_digest), receipt_input("argv", input_digest),
                receipt_input("argv-count", input_count_digest), receipt_input("target", target_digest)],
            planned_action: "sha256-2baa4c66edeaf54e166ff66bdd4c914c3076a7621a98c90f9a577c9b825be3b3",
            outputs: [], activation_proof: "sha256-b8846cc6a6dfb698b445cafa1f316a814f70d56520598e8efcdbd42970999378",
            parent_generation: "", witness: "jet-runtime;target={target_name};argv-count={input_count};redaction=by-construction",
            outcome: "failed", failure_path: Val(receipt.JetDevelopmentReceiptPath{
                code: code, file: failure_file, line: Int.from_u32(line),
                function: if function.is_empty() -> "<unknown>" else -> function})}
        bytes :: receipt.jet_development_receipt_render(record).bytes()
        directory :: OSPath.from(directory_text)
        if not ensure_receipt_directory(directory) -> return None
        path :: directory.join("receipt")
        if fs.symlink_metadata(path) == {
            Ok(metadata) -> {
                if metadata.file_type().is_symlink() || not metadata.is_file() -> return None
                return Val(path.to_string_lossy().to_string())
            }
            Err(error) -> if error.kind() != .NotFound -> return None
        }
        options := fs.OpenOptions.new()
        &options.write(true).create_new(true)
        if target.selected_family() == "unix" -> &options.mode(0o600)
        output := if options.open(path) == {
            Ok(output) -> output
            Err(error) -> {
                if error.kind() == .AlreadyExists -> return Val(path.to_string_lossy().to_string())
                return None
            }
        }
        if output.write_all(bytes) is Err(_) -> return None
        if target.selected_family() == "unix" {
            if fs.set_permissions(path, fs.Permissions.from_mode(0o600)) is Err(_) -> return None
        }
        Val(path.to_string_lossy().to_string())
    }
}
// Rust: crates/jet-codegen/src/Prelude/DevelopmentReceipt.rs:196
fn receipt_input(name: String, value: String) -> receipt.JetDevelopmentReceiptInput Never! {
    receipt.JetDevelopmentReceiptInput{name: name, digest: value}
}
// Rust: crates/jet-codegen/src/Prelude/DevelopmentReceipt.rs:204
pub fn ensure_receipt_directory(path: OSPath) -> Bool Never! {
    // GATE #4565: kernel primitive — no-follow component checks and permission-controlled mkdir.
    #Unsafe("native path components and filesystem metadata stay native and preserve original error kinds") {
        current := OSPath.new()
        loop component in path.components() {
            &current.push(component.as_os_str())
            loop {
                if fs.symlink_metadata(current) == {
                    Ok(metadata) -> {
                        if metadata.file_type().is_symlink() || not metadata.is_dir() -> return false
                        break
                    }
                    Err(error) -> {
                        if error.kind() != .NotFound -> return false
                        builder := fs.DirBuilder.new()
                        if target.selected_family() == "unix" -> &builder.mode(0o700)
                        if builder.create(current) == {
                            Ok(_) -> {}
                            Err(error) -> {
                                if error.kind() == .AlreadyExists -> continue
                                return false
                            }
                        }
                    }
                }
            }
        }
        true
    }
}
// Rust: crates/jet-codegen/src/Prelude/DevelopmentReceipt.rs:239
fn receipt_path(file: String, entry: String) -> String Never! {
    raw :: if file.is_empty() -> entry else -> file
    if raw.is_empty() || raw.starts_with('<') -> return if raw.is_empty() -> "<unknown>" else -> raw
    // GATE #4565: kernel primitive — cwd and OSPath prefix semantics.
    relative := #Unsafe("redact absolute source paths outside the actual current directory") {
        path :: OSPath.from(raw)
        if path.is_absolute() {
            cwd :: env.current_dir() ?? return "<external>"
            relative :: path.strip_prefix(cwd) ?? return "<external>"
            relative.to_string_lossy().to_string()
        } else -> raw
    }
    relative = relative.replace('\\', "/")
    if relative.is_empty() || relative == "." || relative == ".." || relative.starts_with("../") || relative.starts_with('/') -> return "<external>"
    relative
}
