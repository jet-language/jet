package {
    name: "core.io"
    version: "0.1.0"
    edition: "2026"
    description: "In-memory text and byte buffers."
    license: "MIT"
    outputs: {
        io: .Library{ entry: io }
    }
}

// core.io — Python `io.StringIO` / `io.BytesIO` without a file descriptor.
//
// Cursor `pos` is a byte offset. `seek` origin is `0` start, `1` current
// `2` end. Reads past the end return empty. These buffers are pure values:
// every write returns a new buffer.

pub struct StringBuf {
    pub text: String
    pub pos: Int
}

pub struct BytesBuf {
    pub data: [U8]
    pub pos: Int
}

pub fn string_buf(text: String) -> StringBuf { StringBuf{text: text, pos: 0} }

pub fn string_empty() -> StringBuf { string_buf("") }

pub fn bytes_buf(data: [U8]) -> BytesBuf { BytesBuf{data: data, pos: 0} }

pub fn bytes_empty() -> BytesBuf { bytes_buf([U8]{}) }

pub fn getvalue(buf: StringBuf) -> String { buf.text }

pub fn getbytes(buf: BytesBuf) -> [U8] { buf.data }

pub fn tell(buf: StringBuf) -> Int { buf.pos }

pub fn bytes_tell(buf: BytesBuf) -> Int { buf.pos }

pub fn seek(buf: StringBuf, offset: Int, whence: Int) -> StringBuf {
    base := 0
    if whence == 1 -> base = buf.pos
    if whence == 2 -> base = buf.text.bytes().len()
    pos := base + offset
    if pos < 0 -> pos = 0
    n :: buf.text.bytes().len()
    if pos > n -> pos = n
    StringBuf{text: buf.text, pos: pos}
}

pub fn bytes_seek(buf: BytesBuf, offset: Int, whence: Int) -> BytesBuf {
    base := 0
    if whence == 1 -> base = buf.pos
    if whence == 2 -> base = buf.data.len()
    pos := base + offset
    if pos < 0 -> pos = 0
    if pos > buf.data.len() -> pos = buf.data.len()
    BytesBuf{data: buf.data, pos: pos}
}

pub fn is_eof(buf: StringBuf) -> Bool { buf.pos >= buf.text.bytes().len() }

pub fn bytes_is_eof(buf: BytesBuf) -> Bool { buf.pos >= buf.data.len() }

pub fn write(buf: StringBuf, chunk: String) -> StringBuf {
    raw :: buf.text.bytes()
    extra :: chunk.bytes()
    out := [U8]{}
    i := 0
    loop i < buf.pos && i < raw.len() {
        out.push(raw[i])
        i = i + 1
    }
    loop b in extra -> out.push(b)
    tail := buf.pos + extra.len()
    loop tail < raw.len() {
        out.push(raw[tail])
        tail = tail + 1
    }
    StringBuf{text: String.from_bytes(out) ?? buf.text, pos: buf.pos + extra.len()}
}

pub fn write_line(buf: StringBuf, chunk: String) -> StringBuf { write(buf, "{chunk}\n") }

pub fn bytes_write(buf: BytesBuf, chunk: [U8]) -> BytesBuf {
    out := [U8]{}
    i := 0
    loop i < buf.pos && i < buf.data.len() {
        out.push(buf.data[i])
        i = i + 1
    }
    loop b in chunk -> out.push(b)
    tail := buf.pos + chunk.len()
    loop tail < buf.data.len() {
        out.push(buf.data[tail])
        tail = tail + 1
    }
    BytesBuf{data: out, pos: buf.pos + chunk.len()}
}

pub fn read(buf: StringBuf, n: Int) -> (buf: StringBuf, text: String) {
    raw :: buf.text.bytes()
    if n < 0 -> n = raw.len() - buf.pos
    end := buf.pos + n
    if end > raw.len() -> end = raw.len()
    if end < buf.pos -> end = buf.pos
    text :: String.from_bytes(slice_b(raw, buf.pos, end)) ?? ""
    (buf: StringBuf{text: buf.text, pos: end}, text: text)
}

pub fn read_line(buf: StringBuf) -> (buf: StringBuf, text: String) {
    raw :: buf.text.bytes()
    i := buf.pos
    loop i < raw.len() {
        if raw[i] == (U8{10}) {
            end := i + 1
            text :: String.from_bytes(slice_b(raw, buf.pos, end)) ?? ""
            return (buf: StringBuf{text: buf.text, pos: end}, text: text)
        }
        i = i + 1
    }
    text :: String.from_bytes(slice_b(raw, buf.pos, raw.len())) ?? ""
    (buf: StringBuf{text: buf.text, pos: raw.len()}, text: text)
}

pub fn read_all(buf: StringBuf) -> (buf: StringBuf, text: String) { read(buf, -1) }

pub fn bytes_read(buf: BytesBuf, n: Int) -> (buf: BytesBuf, data: [U8]) {
    chunk_len := n
    if chunk_len < 0 -> chunk_len = buf.data.len() - buf.pos
    end := buf.pos + chunk_len
    if end > buf.data.len() -> end = buf.data.len()
    if end < buf.pos -> end = buf.pos
    (buf: BytesBuf{data: buf.data, pos: end}, data: slice_b(buf.data, buf.pos, end))
}

pub fn truncate(buf: StringBuf, size: Int) -> StringBuf {
    n := size
    if n < 0 -> n = 0
    raw :: buf.text.bytes()
    if n > raw.len() -> n = raw.len()
    pos := buf.pos
    if pos > n -> pos = n
    StringBuf{text: String.from_bytes(slice_b(raw, 0, n)) ?? "", pos: pos}
}

pub fn bytes_truncate(buf: BytesBuf, size: Int) -> BytesBuf {
    n := size
    if n < 0 -> n = 0
    if n > buf.data.len() -> n = buf.data.len()
    pos := buf.pos
    if pos > n -> pos = n
    BytesBuf{data: slice_b(buf.data, 0, n), pos: pos}
}

pub fn flush(buf: StringBuf) -> StringBuf { buf }

pub fn close(buf: StringBuf) -> StringBuf { buf }

fn slice_b(raw: [U8], start: Int, end: Int) -> [U8] {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i < 0 || i >= raw.len() -> return out
        out.push(raw[i])
        i = i + 1
    }
}

@seek_set :: 0
@seek_cur :: 1
@seek_end :: 2

pub fn string_io(text: String) -> StringBuf { string_buf(text) }
pub fn bytes_io(data: [U8]) -> BytesBuf { bytes_buf(data) }

pub fn readable(_buf: StringBuf) -> Bool { true }
pub fn writable(_buf: StringBuf) -> Bool { true }
pub fn seekable(_buf: StringBuf) -> Bool { true }
pub fn closed(buf: StringBuf) -> Bool { false }
pub fn bytes_readable(_buf: BytesBuf) -> Bool { true }
pub fn bytes_writable(_buf: BytesBuf) -> Bool { true }
pub fn bytes_seekable(_buf: BytesBuf) -> Bool { true }

/// Read up to `n` characters (bytes in UTF-8). `n < 0` reads the rest.
pub fn read_n(buf: StringBuf, n: Int) -> (buf: StringBuf, chunk: String) {
    raw :: buf.text.bytes()
    avail := raw.len() - buf.pos
    if avail < 0 -> avail = 0
    chunk_len := n
    if chunk_len < 0 || chunk_len > avail -> chunk_len = avail
    chunk :: String.from_bytes(slice_b(raw, buf.pos, buf.pos + chunk_len)) ?? ""
    (buf: StringBuf{text: buf.text, pos: buf.pos + chunk_len}, chunk: chunk)
}

pub fn bytes_read_n(buf: BytesBuf, n: Int) -> (buf: BytesBuf, chunk: [U8]) {
    avail := buf.data.len() - buf.pos
    if avail < 0 -> avail = 0
    chunk_len := n
    if chunk_len < 0 || chunk_len > avail -> chunk_len = avail
    (buf: BytesBuf{data: buf.data, pos: buf.pos + chunk_len}, chunk: slice_b(buf.data, buf.pos, buf.pos + chunk_len))
}

/// Read through the next newline, including it. Empty at EOF.
pub fn readline(buf: StringBuf) -> (buf: StringBuf, line: String) {
    raw :: buf.text.bytes()
    if buf.pos >= raw.len() -> return (buf: buf, line: "")
    i := buf.pos
    loop i < raw.len() {
        if raw[i] == (U8{10}) {
            i = i + 1
            break
        }
        i = i + 1
    }
    chunk :: String.from_bytes(slice_b(raw, buf.pos, i)) ?? ""
    (buf: StringBuf{text: buf.text, pos: i}, line: chunk)
}

pub fn readlines(buf: StringBuf) -> [String] {
    cur := buf
    out := [String]{}
    loop {
        nxt :: readline(cur)
        cur = nxt.buf
        if nxt.line.len() == 0 -> return out
        out.push(nxt.line)
    }
}

pub fn writelines(buf: StringBuf, lines: [String]) -> StringBuf {
    cur := buf
    loop line in lines -> cur = write(cur, line)
    cur
}

pub fn getvalue_from(buf: StringBuf) -> String { getvalue(buf) }
pub fn getbuffer(buf: BytesBuf) -> [U8] { getbytes(buf) }

/// Copy every remaining byte from `src` into `dst`.
pub fn copy_bytes(dst: BytesBuf, src: BytesBuf) -> BytesBuf {
    rest :: slice_b(src.data, src.pos, src.data.len())
    cur := dst
    loop b in rest -> cur = bytes_write(cur, [U8]{b})
    cur
}
