package {
    name: "core.io"
    version: "0.1.0"
    edition: "2026"
    description: "Typed in-memory text and byte buffers."
    license: "MIT"
    outputs: {
        io: .Library{ entry: io }
    }
}

// core.io — StringIO / BytesIO-style values without a file descriptor.
//
// Cursor `pos` is a byte offset. `seek` origin is 0 (start), 1 (current), or
// 2 (end). Reads past the end return an empty value; malformed offsets,
// closed buffers, and UTF-8 boundary violations return the shared typed
// IOError instead of silently discarding a request. Every mutation returns a
// new buffer, so the surface is pure and deterministic.
pub struct StringBuf {
    pub text: String
    pub pos: Int
}

pub struct BytesBuf {
    pub data: [U8]
    pub pos: Int
}


pub fn string_buf(text: String) -> StringBuf { StringBuf{text: text, pos: 0} }

pub fn string_empty() -> StringBuf { string_buf("") }

pub fn bytes_buf(data: [U8]) -> BytesBuf { BytesBuf{data: data, pos: 0} }

pub fn bytes_empty() -> BytesBuf { bytes_buf([U8]{}) }

pub fn getvalue(buf: StringBuf) -> String { buf.text }

pub fn getbytes(buf: BytesBuf) -> [U8] { buf.data }

pub fn tell(buf: StringBuf) -> Int { buf.pos }

pub fn bytes_tell(buf: BytesBuf) -> Int { buf.pos }

pub fn seek(buf: StringBuf, offset: Int, whence: Int) -> StringBuf !IOError {
    if buf.pos < 0 -> return Err(io_err("seek", "buffer is closed"))
    raw :: buf.text.bytes()
    if buf.pos > raw.len() || !utf8_boundary(raw, buf.pos) {
        return Err(io_err("seek", "buffer cursor is not a valid UTF-8 boundary"))
    }
    if whence < 0 || whence > 2 -> return Err(io_err("seek", "whence must be 0, 1, or 2"))
    base := 0
    if whence == 1 -> base = buf.pos
    if whence == 2 -> base = raw.len()
    pos := base + offset
    if pos < 0 -> return Err(io_err("seek", "negative position"))
    if pos > raw.len() -> pos = raw.len()
    if !utf8_boundary(raw, pos) -> return Err(io_err("seek", "position splits a UTF-8 code point"))
    Ok(StringBuf{text: buf.text, pos: pos})
}

pub fn bytes_seek(buf: BytesBuf, offset: Int, whence: Int) -> BytesBuf !IOError {
    if buf.pos < 0 -> return Err(io_err("bytes_seek", "buffer is closed"))
    if buf.pos > buf.data.len() -> return Err(io_err("bytes_seek", "cursor is outside the buffer"))
    if whence < 0 || whence > 2 -> return Err(io_err("bytes_seek", "whence must be 0, 1, or 2"))
    base := 0
    if whence == 1 -> base = buf.pos
    if whence == 2 -> base = buf.data.len()
    pos := base + offset
    if pos < 0 -> return Err(io_err("bytes_seek", "negative position"))
    if pos > buf.data.len() -> pos = buf.data.len()
    Ok(BytesBuf{data: buf.data, pos: pos})
}

pub fn is_eof(buf: StringBuf) -> Bool { buf.pos < 0 || buf.pos >= buf.text.bytes().len() }

pub fn bytes_is_eof(buf: BytesBuf) -> Bool { buf.pos < 0 || buf.pos >= buf.data.len() }

pub fn write(buf: StringBuf, chunk: String) -> StringBuf !IOError {
    if buf.pos < 0 -> return Err(io_err("write", "buffer is closed"))
    raw :: buf.text.bytes()
    if buf.pos > raw.len() || !utf8_boundary(raw, buf.pos) {
        return Err(io_err("write", "cursor is not a valid UTF-8 boundary"))
    }
    extra :: chunk.bytes()
    out := [U8]{}
    i := 0
    loop i < buf.pos {
        out.push(raw[i])
        i += 1
    }
    loop b in extra -> out.push(b)
    tail := buf.pos + extra.len()
    loop tail < raw.len() {
        out.push(raw[tail])
        tail += 1
    }
    text :: String.from_bytes(out) ?? return Err(io_err("write", "write would create invalid UTF-8"))
    Ok(StringBuf{text: text, pos: buf.pos + extra.len()})
}

pub fn write_line(buf: StringBuf, chunk: String) -> StringBuf !IOError {
    write(buf, "{chunk}\n")
}

pub fn bytes_write(buf: BytesBuf, chunk: [U8]) -> BytesBuf !IOError {
    if buf.pos < 0 -> return Err(io_err("bytes_write", "buffer is closed"))
    if buf.pos > buf.data.len() -> return Err(io_err("bytes_write", "cursor is outside the buffer"))
    out := [U8]{}
    i := 0
    loop i < buf.pos {
        out.push(buf.data[i])
        i += 1
    }
    loop b in chunk -> out.push(b)
    tail := buf.pos + chunk.len()
    loop tail < buf.data.len() {
        out.push(buf.data[tail])
        tail += 1
    }
    Ok(BytesBuf{data: out, pos: buf.pos + chunk.len()})
}

pub fn read(buf: StringBuf, n: Int) -> (buf: StringBuf, text: String) !IOError {
    if buf.pos < 0 -> return Err(io_err("read", "buffer is closed"))
    raw :: buf.text.bytes()
    if buf.pos > raw.len() || !utf8_boundary(raw, buf.pos) {
        return Err(io_err("read", "cursor is not a valid UTF-8 boundary"))
    }
    count := n
    if count < 0 -> count = raw.len() - buf.pos
    end := buf.pos + count
    if end < buf.pos -> return Err(io_err("read", "negative read size"))
    if end > raw.len() -> end = raw.len()
    if !utf8_boundary(raw, end) -> return Err(io_err("read", "read size splits a UTF-8 code point"))
    text :: String.from_bytes(slice_b(raw, buf.pos, end)) ?? return Err(io_err("read", "buffer contains invalid UTF-8"))
    Ok((buf: StringBuf{text: buf.text, pos: end}, text: text))
}

pub fn read_line(buf: StringBuf) -> (buf: StringBuf, text: String) !IOError {
    if buf.pos < 0 -> return Err(io_err("read_line", "buffer is closed"))
    raw :: buf.text.bytes()
    if buf.pos > raw.len() || !utf8_boundary(raw, buf.pos) {
        return Err(io_err("read_line", "cursor is not a valid UTF-8 boundary"))
    }
    i := buf.pos
    loop i < raw.len() {
        if raw[i] == (U8{10}) {
            i += 1
            break
        }
        i += 1
    }
    text :: String.from_bytes(slice_b(raw, buf.pos, i)) ?? return Err(io_err("read_line", "buffer contains invalid UTF-8"))
    Ok((buf: StringBuf{text: buf.text, pos: i}, text: text))
}

pub fn read_all(buf: StringBuf) -> (buf: StringBuf, text: String) !IOError { read(buf, -1) }

pub fn bytes_read(buf: BytesBuf, n: Int) -> (buf: BytesBuf, data: [U8]) !IOError {
    if buf.pos < 0 -> return Err(io_err("bytes_read", "buffer is closed"))
    if buf.pos > buf.data.len() -> return Err(io_err("bytes_read", "cursor is outside the buffer"))
    chunk_len := n
    if chunk_len < 0 -> chunk_len = buf.data.len() - buf.pos
    end := buf.pos + chunk_len
    if end < buf.pos -> return Err(io_err("bytes_read", "negative read size"))
    if end > buf.data.len() -> end = buf.data.len()
    Ok((buf: BytesBuf{data: buf.data, pos: end}, data: slice_b(buf.data, buf.pos, end)))
}

pub fn truncate(buf: StringBuf, size: Int) -> StringBuf !IOError {
    if buf.pos < 0 -> return Err(io_err("truncate", "buffer is closed"))
    if size < 0 -> return Err(io_err("truncate", "size must be non-negative"))
    raw :: buf.text.bytes()
    if buf.pos > raw.len() || !utf8_boundary(raw, buf.pos) {
        return Err(io_err("truncate", "cursor is not a valid UTF-8 boundary"))
    }
    n := size
    if n > raw.len() -> n = raw.len()
    if !utf8_boundary(raw, n) -> return Err(io_err("truncate", "size splits a UTF-8 code point"))
    pos := buf.pos
    if pos > n -> pos = n
    text :: String.from_bytes(slice_b(raw, 0, n)) ?? return Err(io_err("truncate", "buffer contains invalid UTF-8"))
    Ok(StringBuf{text: text, pos: pos})
}

pub fn bytes_truncate(buf: BytesBuf, size: Int) -> BytesBuf !IOError {
    if buf.pos < 0 -> return Err(io_err("bytes_truncate", "buffer is closed"))
    if buf.pos > buf.data.len() -> return Err(io_err("bytes_truncate", "cursor is outside the buffer"))
    if size < 0 -> return Err(io_err("bytes_truncate", "size must be non-negative"))
    n := size
    if n > buf.data.len() -> n = buf.data.len()
    pos := buf.pos
    if pos > n -> pos = n
    Ok(BytesBuf{data: slice_b(buf.data, 0, n), pos: pos})
}

/// In-memory buffers have no pending external writes; flush preserves value.
pub fn flush(buf: StringBuf) -> StringBuf { ~buf }

/// Closing is idempotent. The retained value remains readable through
/// `getvalue`; cursor-based operations report `IOError` after close.
pub fn close(buf: StringBuf) -> StringBuf {
    if buf.pos < 0 -> return ~buf
    StringBuf{text: buf.text, pos: -1}
}

fn slice_b(raw: [U8], start: Int, end: Int) -> [U8] !Never {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i < 0 || i >= raw.len() -> return ~out
        out.push(raw[i])
        i += 1
    }
}

fn utf8_boundary(raw: [U8], pos: Int) -> Bool !Never {
    if pos < 0 || pos > raw.len() -> return false
    if pos == 0 || pos == raw.len() -> return true
    value :: Int.from_u8(raw[pos])
    value & 192 != 128
}

fn io_err(operation: String, message: String) -> IOError !Never {
    if operation == "write" ||
        operation == "bytes_write" ||
        operation == "truncate" ||
        operation == "bytes_truncate" ||
        operation == "copy_bytes" {
        if message == "buffer is closed" {
            return IOError.Closed(IOContext{
                operation: .Write,
                resource: None,
                os_code: None,
                cause: Val(message),
            })
        }
        return IOError.InvalidInput(IOContext{
            operation: .Write,
            resource: None,
            os_code: None,
            cause: Val(message),
        })
    }
    if message == "buffer is closed" {
        return IOError.Closed(IOContext{
            operation: .Read,
            resource: None,
            os_code: None,
            cause: Val(message),
        })
    }
    IOError.InvalidInput(IOContext{
        operation: .Read,
        resource: None,
        os_code: None,
        cause: Val(message),
    })
}

SEEK_SET :: 0
SEEK_CUR :: 1
SEEK_END :: 2

pub fn string_io(text: String) -> StringBuf { string_buf(text) }
pub fn bytes_io(data: [U8]) -> BytesBuf { bytes_buf(data) }

pub fn readable(buf: StringBuf) -> Bool { buf.pos >= 0 }
pub fn writable(buf: StringBuf) -> Bool { buf.pos >= 0 }
pub fn seekable(buf: StringBuf) -> Bool { buf.pos >= 0 }
pub fn closed(buf: StringBuf) -> Bool { buf.pos < 0 }
pub fn bytes_readable(buf: BytesBuf) -> Bool { buf.pos >= 0 }
pub fn bytes_writable(buf: BytesBuf) -> Bool { buf.pos >= 0 }
pub fn bytes_seekable(buf: BytesBuf) -> Bool { buf.pos >= 0 }

/// Read up to `n` bytes. `n < 0` reads the remainder.
pub fn read_n(buf: StringBuf, n: Int) -> (buf: StringBuf, chunk: String) !IOError {
    result :: read(buf, n)
    Ok((buf: result.buf, chunk: result.text))
}

pub fn bytes_read_n(buf: BytesBuf, n: Int) -> (buf: BytesBuf, chunk: [U8]) !IOError {
    result :: bytes_read(buf, n)
    Ok((buf: result.buf, chunk: result.data))
}

/// Read through the next newline, including it. Empty at EOF.
pub fn readline(buf: StringBuf) -> (buf: StringBuf, line: String) !IOError {
    result :: read_line(buf)
    Ok((buf: result.buf, line: result.text))
}

pub fn readlines(buf: StringBuf) -> [String] !IOError {
    cur := buf
    out := [String]{}
    loop {
        nxt :: readline(cur)
        cur = nxt.buf
        if nxt.line.len() == 0 -> return Ok(~out)
        out.push(nxt.line)
    }
}

pub fn writelines(buf: StringBuf, lines: [String]) -> StringBuf !IOError {
    cur := buf
    loop line in lines -> cur = write(cur, line)
    Ok(cur)
}

pub fn getvalue_from(buf: StringBuf) -> String { getvalue(buf) }
pub fn getbuffer(buf: BytesBuf) -> [U8] { getbytes(buf) }

/// Copy every remaining byte from `src` into `dst`.
pub fn copy_bytes(dst: BytesBuf, src: BytesBuf) -> BytesBuf !IOError {
    if dst.pos < 0 || src.pos < 0 -> return Err(io_err("copy_bytes", "buffer is closed"))
    if dst.pos > dst.data.len() || src.pos > src.data.len() {
        return Err(io_err("copy_bytes", "cursor is outside the buffer"))
    }
    out := [U8]{}
    i := 0
    loop i < dst.pos {
        out.push(dst.data[i])
        i += 1
    }
    i = src.pos
    loop i < src.data.len() {
        out.push(src.data[i])
        i += 1
    }
    tail :: dst.pos + src.data.len() - src.pos
    i = dst.pos
    loop i < dst.data.len() {
        out.push(dst.data[i])
        i += 1
    }
    Ok(BytesBuf{data: out, pos: tail})
}
