// D-SOA-TIER1=A: one column per stored field, no per-read column-set temporary.
// Rust: crates/jet-codegen/src/Prelude/Core/Columns.rs:23
pub type JetRowCells<C> = [C]
// Rust: crates/jet-codegen/src/Prelude/Core/Columns.rs:29
#Inline(Always)
pub fn jet_columns_rows<C>(columns: View<View<C>>) -> USize {
    if columns.first() == Some(column) -> column.len() else -> 0
}
// Rust: crates/jet-codegen/src/Prelude/Core/Columns.rs:43
#Inline(Always)
pub fn jet_columns_gather<C: Clone>(columns: View<View<C>>, index: I64) -> JetRowCells<C> JetFixedListIndexError! {
    row :: jet_fixed_list_index(jet_columns_rows(columns), index, (row) -> row) ?? return Err(^err)
    Ok(columns.iter().map((column) -> column[row].clone()).collect())
}
// Rust: crates/jet-codegen/src/Prelude/Core/Columns.rs:56
#Inline(Always)
pub fn jet_columns_gather_cell<C: Clone>(columns: View<View<C>>, field: USize, index: I64) -> C JetFixedListIndexError! {
    row :: jet_fixed_list_index(jet_columns_rows(columns), index, (row) -> row) ?? return Err(^err)
    Ok(columns[field][row].clone())
}
