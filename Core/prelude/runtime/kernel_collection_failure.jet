// Rust: crates/jet-codegen/src/Prelude/Core/CollectionFailure.rs:5
pub fn jet_collection_try_map<T, U, E, I: IntoIterator<T>>(items: I, f: fn(T) -> U E!) -> [U] E! {
    iterator := items.into_iter()
    out := [U].with_capacity(iterator.size_hint().lower)
    loop item in iterator {
        value :: f(^item) ?? return Err(^err)
        out.push(^value)
    }
    Ok(^out)
}
// Rust: crates/jet-codegen/src/Prelude/Core/CollectionFailure.rs:13
pub fn jet_collection_try_filter<T, E, I: IntoIterator<T>>(items: I, f: fn(T) -> Bool E!) -> [T] E! {
    out: [T] := []
    loop item in items {
        keep :: f(item) ?? return Err(^err)
        if keep -> out.push(^item)
    }
    Ok(^out)
}

