trait JetModulo {
    // Rust: crates/jet-codegen/src/Prelude/Core/Division.rs:85
    fn jet_mod(self: Self, rhs: Self, file: String, line: U32) -> Self
}
// Rust: crates/jet-codegen/src/Prelude/Core/Division.rs:92 (signed expansion i8)
impl JetModulo for I8 {
    fn jet_mod(self: I8, rhs: I8, file: String, line: U32) -> I8 {
        if rhs == 0 -> jet_arithmetic_stop(file, line, JET_FLOORDIV_ZERO)
        // MIN %% -1 is zero, never a division-overflow trap.
        remainder :: self.wrapping_rem(rhs)
        if remainder != 0 && (remainder < 0) != (rhs < 0) -> remainder.wrapping_add(rhs) else -> remainder
    }
}
