trait JetFloorDiv {
    // Rust: crates/jet-codegen/src/Prelude/Core/Division.rs:39
    fn jet_floordiv(self: Self, rhs: Self, file: String, line: U32) -> Self
}
// Rust: crates/jet-codegen/src/Prelude/Core/Division.rs:46 (signed expansion i8)
impl JetFloorDiv for I8 {
    fn jet_floordiv(self: I8, rhs: I8, file: String, line: U32) -> I8 {
        if rhs == 0 -> jet_arithmetic_stop(file, line, JET_FLOORDIV_ZERO)
        quotient :: self.checked_div(rhs) ?? return jet_arithmetic_stop(file, line, JET_FLOORDIV_OVERFLOW)
        remainder :: self.wrapping_rem(rhs)
        if remainder != 0 && (remainder < 0) != (rhs < 0) -> quotient - 1 else -> quotient
    }
}
