// D-FLOORDIV1=A: /% rounds down, % takes the divisor's sign; %% truncates.
// Rust: crates/jet-codegen/src/Prelude/Core/Division.rs:12
const JET_FLOORDIV_ZERO: String = JET_ARITHMETIC_DIVIDE_ZERO
// Rust: crates/jet-codegen/src/Prelude/Core/Division.rs:13
const JET_FLOORDIV_OVERFLOW: String = JET_ARITHMETIC_DIVIDE_OVERFLOW
// Rust: crates/jet-codegen/src/Prelude/Core/Division.rs:18
const JET_DIVIDE_ZERO: String = JET_ARITHMETIC_DIVIDE_ZERO
// Rust: crates/jet-codegen/src/Prelude/Core/Division.rs:19
const JET_DIVIDE_OVERFLOW: String = JET_ARITHMETIC_DIVIDE_OVERFLOW
// Rust: crates/jet-codegen/src/Prelude/Core/Division.rs:21
pub fn jet_division(left: I128, right: I128, minimum: I128, maximum: I128) -> I128 Err! {
    if right == 0 -> return Err(JET_DIVIDE_ZERO)
    quotient :: left.checked_div(right) ?? return Err(JET_DIVIDE_OVERFLOW)
    if quotient >= minimum && quotient <= maximum -> Ok(quotient) else -> Err(JET_DIVIDE_OVERFLOW)
}
