use core.cell.[Cell, ThreadLocal]
use core.sys.target.[usize_max]
use jet_foundation.Outcome.[JET_RUNTIME_STACK_LIMIT]

// D-FAIL-BREACH1=A: call-depth storage is local to the executing task thread.
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeStack.rs:7
// GATE #4565: kernel primitive — owning-thread depth counter.
JET_RUNTIME_STACK_DEPTH :: ThreadLocal<Cell<U64>>.new(fn() { Cell.new(U64{0}) })
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeStack.rs:12
#Unsafe("increment only the executing thread's call depth, bounded by selected usize")
pub fn jet_runtime_stack_enter() -> Bool {
    JET_RUNTIME_STACK_DEPTH.with(depth -> {
        previous :: depth.get()
        next :: if previous == usize_max() { previous } else { previous + U64{1} }
        depth.set(next)
        next > U64{JET_RUNTIME_STACK_LIMIT}
    })
}
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeStack.rs:20
#Unsafe("decrement only the executing thread's call depth without underflow")
pub fn jet_runtime_stack_leave() -> {
    JET_RUNTIME_STACK_DEPTH.with(depth -> depth.set(depth.get().saturating_sub(U64{1})))
}
