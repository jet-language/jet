use core.mem.runtime.portable_core.[JetOutcome, JetAbsent]

// One lazy option lift for all execution carriers; presence precedes factory evaluation.
// Rust: crates/jet-codegen/src/Prelude/Core/Option.rs:7
pub trait JetOptionValue {
    type Item
    fn jet_option_is_present(self) -> Bool
    fn jet_option_into_item(self) -> Self.Item
}
// Rust: crates/jet-codegen/src/Prelude/Core/Option.rs:14
impl<T> JetOptionValue for JetOutcome<T, JetAbsent> {
    type Item = T
    // Rust: crates/jet-codegen/src/Prelude/Core/Option.rs:17
    fn jet_option_is_present(self) -> Bool { self.is_ok() }
    // Rust: crates/jet-codegen/src/Prelude/Core/Option.rs:21
    fn jet_option_into_item(self) -> T {
        match self { Ok(value) -> value, Err(_) -> unreachable("option payload requested from absence") }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Option.rs:33
pub struct JetOptionPacked<T> { pub present: Bool, pub value: T }
// Rust: crates/jet-codegen/src/Prelude/Core/Option.rs:38
impl<T> JetOptionValue for JetOptionPacked<T> {
    type Item = T
    // Rust: crates/jet-codegen/src/Prelude/Core/Option.rs:41
    fn jet_option_is_present(self) -> Bool { self.present }
    // Rust: crates/jet-codegen/src/Prelude/Core/Option.rs:45
    fn jet_option_into_item(self) -> T {
        debug_assert(self.present, "option payload requested from absence")
        self.value
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Option.rs:57
pub fn jet_option_pack_i64(present: Bool, value: I64) -> I64 {
    if present { value.wrapping_add(I64{1}) } else { I64{0} }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Option.rs:65
pub fn jet_option_lift2<A: JetOptionValue, B: JetOptionValue, R, O>(a: A, b: B,
    absent: fn() -> O, present: fn(R) -> O, make_f: fn() -> (fn(A.Item, B.Item) -> R)) -> O {
    if not a.jet_option_is_present() or not b.jet_option_is_present() -> return absent()
    f :: make_f()
    left :: a.jet_option_into_item()
    right :: b.jet_option_into_item()
    present(f(^left, ^right))
}
