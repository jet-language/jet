// Rust CoreLib/JetStd/DataTreeKind.rs:3–17, datatree_kind.
// The resident tag is a borrowed vocabulary input, not a DataTree carrier.
pub fn datatree_kind(resident_tag: String) -> String Never! {
    if resident_tag == {
        "Null" -> return "null"
        "Bool" -> return "Bool"
        "Int" -> return "Int"
        "Float" -> return "Float"
        "Number" -> return "number"
        "TypedText" | "Text" -> return "Text"
        "Bytes" -> return "Bytes"
        "Array" -> return "a list"
        "Object" -> return "an object"
        else -> return "value"
    }
}
