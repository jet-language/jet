    fraction :: Concurrency.with_runtime_mut(fn(rt) -> CtFraction? {
        if rt.decimal_values.get(handle_index(a)) == .Val(.Val(left)) {
            if rt.decimal_values.get(handle_index(b)) == .Val(.Val(right)) -> return left.div(right)
