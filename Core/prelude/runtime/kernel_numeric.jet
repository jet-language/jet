fn jet_jit_int_to_native(value: I64) -> I64 Never! {
    Concurrency.with_runtime_mut(fn(rt) {
        if rt.heap.int_to_i64(value) == .Val(native) -> return native
        rt.set_arithmetic_stop(U32{0}, "native Int argument exceeds host range"); I64{0}
