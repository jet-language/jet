enum NumericSignature { Unary, Binary, Compare, CompareI64, UnaryBool, UnaryF64, ComplexParts, Located }

// Rust: crates/jet-jit/src/Numeric.rs:1114
pub fn register_numeric_symbols(builder: &JITBuilder) Never! {
    // GATE #4494: guarded supplies an audited native C-ABI address, not Rust.
    numeric_entries(fn(field, symbol, address, shape) {
        builder.symbol(symbol, address())
        #If(test) { audit.record_registered(symbol) }
        Ok(())
    }).expect("numeric symbol registration is infallible")
}
// Rust: crates/jet-jit/src/Numeric.rs:1115-1146
pub fn declare_numeric_host_fns<M: Module>(module: &M) -> NumericHostFns Err! {
    cc :: module.target_config().default_call_conv
    sig_unary := Signature.new(cc)
    sig_unary.params.push(AbiParam.new(types.I64)); sig_unary.returns.push(AbiParam.new(types.I64))
    sig_binary := Signature.new(cc)
    sig_binary.params.push(AbiParam.new(types.I64)); sig_binary.params.push(AbiParam.new(types.I64))
    sig_binary.returns.push(AbiParam.new(types.I64))
    sig_compare := Signature.new(cc)
    sig_compare.params.push(AbiParam.new(types.I64)); sig_compare.params.push(AbiParam.new(types.I64))
    sig_compare.returns.push(AbiParam.new(types.I8))
    sig_compare_i64 := Signature.new(cc)
    sig_compare_i64.params.push(AbiParam.new(types.I64)); sig_compare_i64.params.push(AbiParam.new(types.I64))
    sig_compare_i64.returns.push(AbiParam.new(types.I64))
    sig_unary_bool := Signature.new(cc)
    sig_unary_bool.params.push(AbiParam.new(types.I64)); sig_unary_bool.returns.push(AbiParam.new(types.I8))
    sig_unary_f64 := Signature.new(cc)
    sig_unary_f64.params.push(AbiParam.new(types.I64)); sig_unary_f64.returns.push(AbiParam.new(types.F64))
    sig_complex_parts := Signature.new(cc)
    sig_complex_parts.params.push(AbiParam.new(types.F64)); sig_complex_parts.params.push(AbiParam.new(types.F64))
    sig_complex_parts.returns.push(AbiParam.new(types.I64))
    sig_located := Signature.new(cc)
    loop i in 0..<4 -> sig_located.params.push(AbiParam.new(types.I64))
    sig_located.returns.push(AbiParam.new(types.I64))
    import :: fn(name: String, signature: Signature) -> FuncId Err! {
        #If(test) { audit.record_declared(name) }
        if module.declare_function(name,Linkage.Import,signature) == {
            .Ok(id) -> Ok(id)
            .Err(error) -> Err(error.to_string())
        }
    }
    Ok(NumericHostFns{
        i8_trap_add: import("jet_i8_trap_add",sig_located)?,
        i8_trap_sub: import("jet_i8_trap_sub",sig_located)?,
        i8_trap_mul: import("jet_i8_trap_mul",sig_located)?,
        i8_trap_div: import("jet_i8_trap_div",sig_located)?,
        i8_trap_rem: import("jet_i8_trap_rem",sig_located)?,
        u8_trap_add: import("jet_u8_trap_add",sig_located)?,
        u8_trap_sub: import("jet_u8_trap_sub",sig_located)?,
        u8_trap_mul: import("jet_u8_trap_mul",sig_located)?,
        u8_trap_div: import("jet_u8_trap_div",sig_located)?,
        u8_trap_rem: import("jet_u8_trap_rem",sig_located)?,
        i16_trap_add: import("jet_i16_trap_add",sig_located)?,
        i16_trap_sub: import("jet_i16_trap_sub",sig_located)?,
        i16_trap_mul: import("jet_i16_trap_mul",sig_located)?,
        i16_trap_div: import("jet_i16_trap_div",sig_located)?,
        i16_trap_rem: import("jet_i16_trap_rem",sig_located)?,
        u16_trap_add: import("jet_u16_trap_add",sig_located)?,
        u16_trap_sub: import("jet_u16_trap_sub",sig_located)?,
        u16_trap_mul: import("jet_u16_trap_mul",sig_located)?,
        u16_trap_div: import("jet_u16_trap_div",sig_located)?,
        u16_trap_rem: import("jet_u16_trap_rem",sig_located)?,
        i32_trap_add: import("jet_i32_trap_add",sig_located)?,
        i32_trap_sub: import("jet_i32_trap_sub",sig_located)?,
        i32_trap_mul: import("jet_i32_trap_mul",sig_located)?,
        i32_trap_div: import("jet_i32_trap_div",sig_located)?,
        i32_trap_rem: import("jet_i32_trap_rem",sig_located)?,
        u32_trap_add: import("jet_u32_trap_add",sig_located)?,
