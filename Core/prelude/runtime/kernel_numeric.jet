// Rust: crates/jet-jit/src/Numeric.rs:541
fn jet_jit_int_factorial(a: I64) -> I64 Never! {
    Concurrency.with_runtime_mut(fn(rt) { result :: rt.heap.int_factorial(a); int_option(&rt, result) })
}
// Rust: crates/jet-jit/src/Numeric.rs:548
fn int_option(rt: &JitRuntime, value: I64?) -> I64 Never! {
    if value == .Val(v) -> return runtime_host.alloc_jit_result(&rt, true, v as U64)
    runtime_host.alloc_jit_result(&rt, false, U64{0})
}
// Rust: crates/jet-jit/src/Numeric.rs:555
fn int_pair(rt: &JitRuntime, quotient: I64, remainder: I64) -> I64 Never! {
    handle :: rt.heap.alloc_record(2)
    _ :: rt.heap.record_set_int(handle, 0, quotient)
    _ :: rt.heap.record_set_int(handle, 1, remainder)
    handle
}
