// Rust: crates/jet-jit/src/Numeric.rs:135
fn jet_jit_int_from_str(str_id: I64) -> I64 Never! {
    Concurrency.with_runtime_mut(fn(rt) {
        text :: rt.heap.clone_string(str_id).unwrap_or("")
        if rt.heap.int_from_str(text) == .Ok(id) -> return id
        rt.set_trap("invalid default Int literal"); I64{0}
    })
}
