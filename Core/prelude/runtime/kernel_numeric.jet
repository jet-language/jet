// Rust: crates/jet-jit/src/Numeric.rs:1
// Packed exact-Int carriers and decimal/fraction/complex side tables share the
// Foundation algorithms. GATE #4494: retained runtime access and guarded ABI.
// GATE #4483: handle indices obey selected-target usize width.
fn handle_index(handle: I64) -> Int Never! {
    Int.from_u64(handle.saturating_sub(I64{1}) as U64) & Int.from_u64(target.usize_max())
}
// Rust: crates/jet-jit/src/Numeric.rs:16
fn trap_fraction(msg: String) Never! { Concurrency.with_runtime_mut(fn(rt) { rt.set_trap(msg) }) }
// Rust: crates/jet-jit/src/Numeric.rs:33
fn divide_by_zero_message() -> String Never! { runtime_host.contract_kernel.jet_arithmetic_message("divide_zero") }
// Rust: crates/jet-jit/src/Numeric.rs:37
pub fn push_decimal(d: ^CtDecimal) -> I64 Never! {
    Concurrency.with_runtime_mut(fn(rt) { rt.decimal_values.push(Val(^d)); rt.decimal_values.len() as I64 })
}
// Rust: crates/jet-jit/src/Numeric.rs:45
fn with_decimal<R>(handle: I64, f: fn(CtDecimal) -> R) -> R? Never! {
    Concurrency.with_runtime_mut(fn(rt) {
        if rt.decimal_values.get(handle_index(handle)) == .Val(.Val(value)) -> return Val(f(value))
        None
    })
}
// Rust: crates/jet-jit/src/Numeric.rs:51
fn push_decimal_in_runtime(rt: &JitRuntime, value: ^CtDecimal) -> I64 Never! {
    rt.decimal_values.push(Val(^value)); rt.decimal_values.len() as I64
}
// Rust: crates/jet-jit/src/Numeric.rs:57
fn decimal_binary(left: I64, right: I64, operation: fn(CtDecimal, CtDecimal) -> CtDecimal) -> I64 Never! {
    Concurrency.with_runtime_mut(fn(rt) {
        left_value :: rt.decimal_values.get(handle_index(left))
        right_value :: rt.decimal_values.get(handle_index(right))
        value := CtDecimal.from_int(0)
        if left_value == .Val(.Val(l)) {
            if right_value == .Val(.Val(r)) -> value = operation(l, r)
        }
        push_decimal_in_runtime(&rt, ^value)
    })
}
