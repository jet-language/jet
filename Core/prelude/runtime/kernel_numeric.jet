// Rust: crates/jet-jit/src/Numeric.rs:761
fn jet_jit_decimal_compare(a: I64,b: I64) -> I64 Never! {
    order :: Concurrency.with_runtime_mut(fn(rt) {
        if rt.decimal_values.get(handle_index(a)) == .Val(.Val(left)) {
            if rt.decimal_values.get(handle_index(b)) == .Val(.Val(right)) -> return left.cmp(right) as I8
        }
        I8{0}
    })
    variant := "Equal"
    if order < I8{0} -> variant = "Less"
    if order > I8{0} -> variant = "Greater"
