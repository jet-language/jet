// Rust: crates/jet-jit/src/Numeric.rs:394
fn jet_jit_fixed_trap(left: I64, right: I64, file: I64, line: I64, op: I64, signed: Bool, bits: U8) -> I64 Never! {
    jet_jit_fixed_arith(left, right, file, line, op, fixed_arithmetic_kernel.JET_FIXED_MODE_TRAP, signed, bits)
}
// Rust: crates/jet-jit/src/Numeric.rs:406
fn jet_jit_fixed_arith(left: I64, right: I64, _file: I64, line: I64, op: I64, mode: I64, signed: Bool, bits: U8) -> I64 Never! {
    if fixed_arithmetic_kernel.jet_fixed_arithmetic(left, right as I128, op, mode, signed, bits, signed) == {
        .Value(value) -> value
        .Absent -> I64{0}
        .Trap(error) -> {
            message :: error.to_string()
            Concurrency.with_runtime_mut(fn(rt) { rt.set_arithmetic_stop(line as U32, message) })
            I64{0}
        }
    }
}

