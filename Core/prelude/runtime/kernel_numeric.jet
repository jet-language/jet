// Rust: crates/jet-jit/src/Numeric.rs:219
fn jet_jit_int_to_radix(value: I64, radix: I64) -> I64 Never! {
    Concurrency.with_runtime_mut(fn(rt) {
        if rt.heap.int_to_i64(radix) == .Val(r) {
            if r < I64{0} || r > I64{4294967295} {
                rt.set_trap("integer radix must be between 2 and 36"); return I64{0}
            }
            text :: rt.heap.int_to_string(value)
            if CtBigInt.from_str(text) == {
                .Ok(big) -> {
                    if big.to_radix(r as U32) == {
                        .Ok(rendered) -> return rt.heap.alloc_string(^rendered)
                        .Err(message) -> rt.set_trap(message)
                    }
                }
                .Err(message) -> rt.set_trap(message)
            }
            return I64{0}
        }
        rt.set_trap("integer radix must fit in Int"); I64{0}
    })
}
// Rust: crates/jet-jit/src/Numeric.rs:244
// Bad digits/radices are result errors, not traps.
fn jet_jit_int_from_radix(text: I64, radix: I64) -> I64 Never! {
    Concurrency.with_runtime_mut(fn(rt) {
        parsed :: fn() -> I64 Err! {
            if rt.heap.int_to_i64(radix) == .Val(r) {
                if r < I64{0} || r > I64{4294967295} -> return Err("integer radix must be between 2 and 36, got {r}")
                source :: rt.heap.clone_string(text).unwrap_or("")
                value :: CtBigInt.from_radix(source, r as U32)?
                return rt.heap.int_from_str(value.to_string_rep())
            }
            Err("integer radix must be between 2 and 36")
        }()
        if parsed == {
            .Ok(value) -> runtime_host.alloc_jit_result(&rt, true, value as U64)
            .Err(message) -> {
                error :: rt.heap.alloc_string(^message)
                runtime_host.alloc_jit_result(&rt, false, error as U64)
            }
        }
    })
}
