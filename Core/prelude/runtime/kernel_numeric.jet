// Rust: crates/jet-jit/src/Numeric.rs:675
fn jet_jit_int_div_mod(l: I64,r: I64) -> I64 Never! {
    Concurrency.with_runtime_mut(fn(rt) {
        if rt.heap.int_div_mod(l,r) == .Val((q,rem)) -> return int_pair(&rt,q,rem)
