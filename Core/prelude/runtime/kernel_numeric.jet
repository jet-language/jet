// Rust: crates/jet-jit/src/Numeric.rs:352
fn located_int_op(line: I64, failure: String, op: fn(&JitRuntime) -> I64?) -> I64 Never! {
    Concurrency.with_runtime_mut(fn(rt) {
        if op(&rt) == .Val(value) -> return value
        rt.set_arithmetic_stop(line as U32, failure); I64{0}
    })
}
