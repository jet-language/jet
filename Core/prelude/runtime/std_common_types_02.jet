    fn cancel(self) Never! { self.state.edit(fn(state) { _ :: state.lifecycle.cancel() }) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:2129
    fn get(self) -> [T] DataError! {
        if !self.is_active() -> return Err(DataError.simple(.State, "data.watch.get", "watch is cancelled"))
        snapshot :: self.state.capture()
        current :: snapshot.value()
        generation :: current.lifecycle.generation
        lifecycle := current.lifecycle.clone()
        if !lifecycle.begin_refresh(generation) -> return Err(DataError.simple(.State, "data.watch.get", "watch is cancelled"))
        update :: match self.source.refresh(current.source_revision, &current.entries) {
            Val(update) => update,
            Err(error) => {
                _ :: lifecycle.fail(generation, error.to_string())
                failed :: DataWatchState{entries: current.entries.clone(), source_revision: current.source_revision,
                    mode: current.mode.clone(), retained_rows: current.retained_rows, recomputations: current.recomputations, lifecycle: lifecycle}
                _ :: self.state.try_replace(snapshot, failed)
                return Err(error)
            },
        }
        if update.entries.len() as I64 > DataLimits.safe().max_output_rows {
            error :: DataError.simple(.Limit, "data.watch.get", "maintained result exceeds max_output_rows")
            _ :: lifecycle.fail(generation, error.to_string())
            failed :: DataWatchState{entries: current.entries.clone(), source_revision: current.source_revision,
                mode: current.mode.clone(), retained_rows: current.retained_rows, recomputations: current.recomputations, lifecycle: lifecycle}
            _ :: self.state.try_replace(snapshot, failed)
            return Err(error)
        }
        _ :: lifecycle.publish(generation, JetLiveLifecycle.active_now().fresh_at_ms)
        next :: DataWatchState{entries: update.entries, source_revision: update.revision, mode: update.mode,
            retained_rows: update.retained_rows, recomputations: current.recomputations.saturating_add(if update.recomputed { 1 } else { 0 }), lifecycle: lifecycle}
        if !self.is_active() -> return Err(DataError.simple(.State, "data.watch.get", "watch was cancelled before publication"))
        match self.state.try_replace(snapshot, next) {
            Val(true) => self.state.read(fn(state) { state.entries.iter().map(fn(entry) { entry.value.clone() }).collect() }),
            Val(false) => Err(DataError.simple(.StaleRevision, "data.watch.get", "watch state changed before publication")),
            Err(.WrongOwner) => Err(DataError.simple(.WrongOwner, "data.watch.get", "watch snapshot belongs to another owner")),
            Err(.GenerationExhausted) => Err(DataError.simple(.Overflow, "data.watch.get", "watch publication revision exhausted")),
        }
