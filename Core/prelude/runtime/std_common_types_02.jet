        state :: DataWatchState{entries: initial.entries, source_revision: initial.revision, mode: initial.mode,
            retained_rows: initial.retained_rows, recomputations: if initial.recomputed { 1 } else { 0 }, lifecycle: JetLiveLifecycle.active_now()}
