impl DataWatchOperationSource<T> {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:1788
    fn apply_operation(self, entries: [DataWatchEntry<T>], retained_rows: Int) -> [DataWatchEntry<T>] DataError! {
        match self.operation {
            .Filter(predicate) => entries.retain(fn(entry) { predicate(entry.value.clone()) }),
            .SortBy(key) => {
                limit :: DataLimits.safe().max_sort_rows
                if retained_rows as I64 > limit -> return Err(DataError.simple(.Limit, "data.query.watch", "max_sort_rows {limit} exceeded"))
                for entry in &entries -> entry.key = Some(key(entry.value.clone()))
                entries.sort_by(fn(left, right) { left.key.cmp(right.key) })
            },
        }
        entries
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:1816
impl DataWatchOperationSource<T>.DataWatchSource<T> {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:1817
    fn initial(self) -> DataWatchMaterialized<T> DataError! {
        materialized :: self.inner.initial()?
        next_base :: materialized.entries.clone()
        entries :: self.apply_operation(next_base.clone(), materialized.retained_rows)?
        self.base.replace(Some(next_base))
        DataWatchMaterialized{entries: entries, revision: materialized.revision, mode: materialized.mode,
            recomputed: materialized.recomputed, changed: materialized.changed, retained_rows: materialized.retained_rows}
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:1833
    fn refresh(self, revision: U64, prior: View<DataWatchEntry<T>>) -> DataWatchMaterialized<T> DataError! {
        base :: self.base.borrow().clone().ok_or_else(fn() { DataError.simple(.State, "data.query.watch", "derived watch was not initialized") })?
        materialized :: self.inner.refresh(revision, &base)?
        if !materialized.changed && materialized.revision == revision {
            return DataWatchMaterialized{entries: prior.to_list(), revision: materialized.revision, mode: materialized.mode,
                recomputed: false, changed: false, retained_rows: materialized.retained_rows}
        }
        next_base :: materialized.entries.clone()
        entries :: self.apply_operation(next_base.clone(), materialized.retained_rows)?
        self.base.replace(Some(next_base))
        DataWatchMaterialized{entries: entries, revision: materialized.revision, mode: materialized.mode,
            recomputed: materialized.recomputed, changed: materialized.changed, retained_rows: materialized.retained_rows}
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:1871
struct DataTrackedWatchSource<T> { source: Rc<DataTrackedReader<T>>, operations: [DataQueryOperation<T>] }
impl DataTrackedWatchSource<T> {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:1877
    fn accepts(operations: View<DataQueryOperation<T>>, row: T) -> (Bool, String?) Never! {
        sort_key := None
        for operation in operations {
            match operation {
                .Filter(predicate) => { if !predicate(row.clone()) -> return (false, None) },
                .SortBy(key) => sort_key = Some(key(row.clone())),
            }
        }
        (true, sort_key)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:1897
    fn insert_entry(entries: &[DataWatchEntry<T>], entry: DataWatchEntry<T>) Never! {
        position :: entries.iter().position(fn(existing) {
            match (entry.key, existing.key) {
                (Some(left), Some(right)) => left.cmp(right) == .Less || (left == right && entry.order < existing.order),
                _ => entry.order < existing.order,
            }
        }).unwrap_or(entries.len())
        entries.insert(position, entry)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:1911
    fn entries_from_snapshot(self, rows: [(U64, T)]) -> [DataWatchEntry<T>] Never! {
        entries := []
        for (order, value) in rows {
            (accepted, key) :: Self.accepts(&self.operations, value)
            if accepted -> Self.insert_entry(&entries, DataWatchEntry{order: order, key: key, value: value})
        }
        entries
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:1924
    fn check_sort_limit(self) DataError! {
        if self.operations.iter().any(fn(operation) { match operation { .SortBy(_) => true, _ => false } }) {
            limit :: DataLimits.safe().max_sort_rows
            if self.source.retained_rows() as I64 > limit -> return Err(DataError.simple(.Limit, "data.query.watch", "max_sort_rows {limit} exceeded"))
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:1942
    fn apply_change(self, entries: &[DataWatchEntry<T>], change: DataTrackedChange<T>) DataError! {
        index :: entries.iter().position(fn(entry) { entry.order == change.order })
        match change.kind {
            .Insert{row} => {
                (accepted, key) :: Self.accepts(&self.operations, row)
                if accepted -> Self.insert_entry(entries, DataWatchEntry{order: change.order, key: key, value: row})
            },
            .Replace{after, ..} => {
                if Some(index) = index -> entries.remove(index)
                (accepted, key) :: Self.accepts(&self.operations, after)
                if accepted -> Self.insert_entry(entries, DataWatchEntry{order: change.order, key: key, value: after})
            },
            .Remove{..} => { if Some(index) = index -> entries.remove(index) },
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:1978
impl DataTrackedWatchSource<T>.DataWatchSource<T> {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:1979
    fn initial(self) -> DataWatchMaterialized<T> DataError! {
        self.check_sort_limit()?
        (revision, rows) :: self.source.snapshot_entries_at_revision()
        entries :: self.entries_from_snapshot(rows)
        DataWatchMaterialized{entries: entries, revision: revision, mode: "incremental", recomputed: false,
            changed: true, retained_rows: self.source.retained_rows()}
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:1993
    fn refresh(self, revision: U64, prior: View<DataWatchEntry<T>>) -> DataWatchMaterialized<T> DataError! {
        self.check_sort_limit()?
        changes :: self.source.changes_since(revision)?
        entries := prior.to_list()
        for change in changes -> self.apply_change(&entries, change)?
        DataWatchMaterialized{entries: entries, revision: self.source.revision(), mode: "incremental", recomputed: false,
            changed: self.source.revision() != revision, retained_rows: self.source.retained_rows()}
    }
}
