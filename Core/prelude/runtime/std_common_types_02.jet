    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:3394
    fn cmp_abs(self, other: JetBigInt) -> I8 Never! {
        match self.limbs.len().cmp(other.limbs.len()) {
            .Greater => 1,
            .Less => -1,
            .Equal => {
                for (a, b) in self.limbs.iter().rev().zip(other.limbs.iter().rev()) {
                    match a.cmp(b) { .Greater => return 1, .Less => return -1, .Equal => {} }
                }
                0
            },
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:3411
    pub fn mul(self, other: JetBigInt) -> JetBigInt Never! {
        out := Self.from_int(0)
        for (i, limb) in other.limbs.iter().enumerate() {
            if limb == 0 -> continue
            part := self.mul_small(limb)
            for _ in 0..i -> part = part.mul_small(BI_BASE as U32)
            out = out.add(part)
        }
        Self{negative: self.negative != other.negative, limbs: out.limbs}.normalize()
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:3430
    pub fn neg(self) -> JetBigInt Never! {
        if self.limbs.len() == 1 && self.limbs[0] == 0 { self.clone() }
        else { Self{negative: !self.negative, limbs: self.limbs.clone()} }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:3441
    fn div_rem_small(self, divisor: U32) -> (JetBigInt, U32) Never! {
        divisor :: divisor as U64
        remainder: U64 := 0
        limbs := [U32].repeat(0, self.limbs.len())
        for index in (0..self.limbs.len()).rev() {
            current :: remainder * BI_BASE + self.limbs[index] as U64
            limbs[index] = (current / divisor) as U32
            remainder = current % divisor
        }
        (Self{negative: false, limbs: limbs}.normalize(), remainder as U32)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:3461
    fn bit_width(self) -> Int Never! {
        value := self.abs()
        width := 0
        while !value.is_zero() { (next, _) :: value.div_rem_small(2); value = next; width += 1 }
        width
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:3472
    fn unsigned_bits(self, width: Int) -> [Bool] Never! {
        value := self.abs()
        bits := [Bool].with_capacity(width)
        for _ in 0..width { (next, remainder) :: value.div_rem_small(2); bits.push(remainder != 0); value = next }
        bits
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:3483
    fn from_unsigned_bits(bits: View<Bool>) -> JetBigInt Never! {
        value := Self.from_int(0)
        for bit in bits.iter().rev() { value = value.mul_small(2); if bit -> value = value.add_small(1) }
        value
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:3494
    fn twos_complement(self, width: Int) -> [Bool] Never! {
        bits := self.unsigned_bits(width)
        if self.negative {
            for bit in &bits -> bit = !bit
            carry := true
            for bit in &bits {
                if !carry -> break
                if bit -> bit = false
                else { bit = true; carry = false }
            }
        }
        bits
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:3516
    fn from_twos_complement(bits: [Bool]) -> JetBigInt Never! {
        negative :: bits.last().copied().unwrap_or(false)
        if !negative -> return Self.from_unsigned_bits(&bits)
        for bit in &bits -> bit = !bit
        carry := true
        for bit in &bits {
            if !carry -> break
            if bit -> bit = false
            else { bit = true; carry = false }
        }
        Self.from_unsigned_bits(&bits).neg()
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:3539
    fn bitwise(self, other: JetBigInt, op: fn(Bool, Bool) -> Bool) -> JetBigInt Never! {
        width :: self.bit_width().max(other.bit_width()).saturating_add(1)
        left :: self.twos_complement(width)
        right :: other.twos_complement(width)
        bits :: left.into_iter().zip(right).map(fn(pair) { op(pair.0, pair.1) }).collect()
        Self.from_twos_complement(bits)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:3551
    pub fn bit_and(self, other: JetBigInt) -> JetBigInt Never! { self.bitwise(other, fn(left, right) { left & right }) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:3555
    pub fn bit_or(self, other: JetBigInt) -> JetBigInt Never! { self.bitwise(other, fn(left, right) { left | right }) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:3559
    pub fn bit_xor(self, other: JetBigInt) -> JetBigInt Never! { self.bitwise(other, fn(left, right) { left ^ right }) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:3563
    pub fn bit_count(self, width: U32, method: String) -> I64? Never! {
        width :: Int.try_from(width).ok()?
        if width == 0 -> return None
        bits :: self.twos_complement(width)
        ones :: bits.iter().filter(fn(bit) { bit }).count()
        count :: match method {
            "count_ones" => ones,
            "count_zeros" => width - ones,
            "leading_zeros" => bits.iter().rev().take_while(fn(bit) { !bit }).count(),
            "trailing_zeros" => bits.iter().take_while(fn(bit) { !bit }).count(),
            "bit_count" => self.unsigned_bits(self.bit_width()).into_iter().filter(fn(bit) { bit }).count(),
            "bit_length" => self.bit_width(),
            _ => return None,
        }
        I64.try_from(count).ok()
    }
}
