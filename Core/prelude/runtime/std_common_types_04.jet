// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:6524
impl IOContext.JetDebug {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:6525
    fn jet_debug(self) -> String Never! {
        operation := match self.operation {
            .Read => "Read", .Write => "Write", .Flush => "Flush", .Connect => "Connect",
            .Accept => "Accept", .Close => "Close", .Resolve => "Resolve", .Codec => "Codec",
        }
        jet_debug_record("IOContext", [("operation", operation), ("resource", self.resource.jet_debug()), ("os_code", self.os_code.jet_debug()), ("cause", self.cause.jet_debug())])
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:6557
impl IOError.JetShow {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:6558
    fn jet_show(self) -> String Never! {
        (variant, context) := match self {
            .InvalidInput(context) => (0, context), .NotFound(context) => (1, context),
            .PermissionDenied(context) => (2, context), .TimedOut(context) => (3, context),
            .Cancelled(context) => (4, context), .Closed(context) => (5, context),
            .Protocol(context) => (6, context), .Other(context) => (7, context),
            .ResourceLimit(limit) => return "process resource limit exceeded: " + limit.jet_show(),
        }
        jet_show_io_error(variant, context.operation as I64, context.resource.as_ref().ok(), context.cause.as_ref().ok())
    }
}
