impl IOError.JetDebug {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:6586
    fn jet_debug(self) -> String Never! {
        (variant, context) := match self {
            .InvalidInput(context) => ("InvalidInput", context), .NotFound(context) => ("NotFound", context),
            .PermissionDenied(context) => ("PermissionDenied", context), .TimedOut(context) => ("TimedOut", context),
            .Cancelled(context) => ("Cancelled", context), .Closed(context) => ("Closed", context),
            .Protocol(context) => ("Protocol", context), .Other(context) => ("Other", context),
            .ResourceLimit(limit) => return jet_debug_variant("ResourceLimit", .Some(limit.jet_debug())),
        }
        jet_debug_variant(variant, .Some(context.jet_debug()))
    }
}
