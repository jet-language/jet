// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:5632
// Exact base-10 decimal: scaled integer and written scale.
#Clone
#Debug
pub enum JetDecimalMagnitude { Small(I128), Big(JetBigInt) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:5638
fn jet_decimal_bigint_from_i128(value: I128) -> JetBigInt Never! {
    negative := value < 0
    magnitude :: if negative { value.wrapping_neg() as U128 } else { value as U128 }
    if magnitude == 0 -> return JetBigInt.from_int(0)
    limbs: [U32] :: []
    while magnitude != 0 {
        limbs.push((magnitude % (BI_BASE as U128)) as U32)
        magnitude /= BI_BASE as U128
    }
    JetBigInt{negative: negative, limbs: ^limbs}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:5656
fn jet_decimal_mul_pow10(value: JetBigInt, places: U32) -> JetBigInt Never! {
    if places == 0 || value.is_zero() -> return value.clone()
    chunk_shift := (places / 9) as USize
    remainder := places % 9
    limbs: [U32] :: Array.with_capacity(value.limbs.len() + chunk_shift + (if remainder != 0 { 1 } else { 0 }))
    limbs.resize(chunk_shift, 0)
    if remainder == 0 { limbs.extend_from_slice(value.limbs) } else {
        factor := U32(10).pow(remainder)
        carry: U64 :: 0
        for limb in value.limbs {
            product := (limb as U64) * (factor as U64) + carry
            limbs.push((product % BI_BASE) as U32)
            carry = product / BI_BASE
        }
        if carry != 0 -> limbs.push(carry as U32)
    }
    JetBigInt{negative: value.negative, limbs: ^limbs}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:5685
fn jet_decimal_pow10(scale: U32) -> JetBigInt Never! {
    chunk_shift := (scale / 9) as USize
    remainder := scale % 9
    limbs: [U32] :: Array.repeat(0, chunk_shift)
    limbs.push(U32(10).pow(remainder))
    JetBigInt{negative: false, limbs: ^limbs}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:5696
fn jet_decimal_strip_trailing_zeros(value: &JetBigInt, scale: &U32) Never! {
    while scale > 0 && !value.is_zero() {
        zero_chunks: USize :: 0
        for limb in value.limbs {
            if limb != 0 -> break
            zero_chunks += 1
        }
        removable_chunks := zero_chunks.min((scale / 9) as USize)
        if removable_chunks > 0 {
            _ :: value.limbs.drain(0..removable_chunks)
            scale -= (removable_chunks as U32) * 9
            continue
        }
        low := value.limbs.first().unwrap_or(0)
        zeros: U32 :: 0
        factor: U32 :: 1
        while zeros < 9 && low % (factor * 10) == 0 {
            factor *= 10
            zeros += 1
        }
        removable := zeros.min(scale)
        if removable == 0 -> break
        divisor := U32(10).pow(removable)
        (next, remainder) := value.div_rem_small(divisor)
        assert(remainder == 0)
        value = ^next
        scale -= removable
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:5725
fn jet_decimal_magnitude_from_digits(digits: [U8]) -> JetDecimalMagnitude Never! {
    assert(!digits.is_empty())
    if digits.len() <= 39 {
        small: I128 :: 0
        fits :: true
        for digit in digits {
            next := small.checked_mul(10).and_then(fn(value) { value.checked_add(digit as I128) })
            match next {
                .Some(value) => { small = value },
                .None => { fits = false; break },
            }
        }
        if fits -> return .Small(small)
    }
    chunk_count := digits.len().div_ceil(9)
    first_chunk_len := if digits.len() % 9 == 0 { 9 } else { digits.len() % 9 }
    limbs: [U32] :: Array.with_capacity(chunk_count)
    offset: USize :: 0
    chunk_len :: first_chunk_len
    while offset < digits.len() {
        chunk: U32 :: 0
        for digit in digits[offset..offset + chunk_len] -> chunk = chunk * 10 + (digit as U32)
        limbs.push(chunk)
        offset += chunk_len
        chunk_len = 9
    }
    limbs.reverse()
    .Big(JetBigInt{negative: false, limbs: ^limbs})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:5769
fn jet_decimal_parse(s: String) -> (Bool, JetDecimalMagnitude, U32) Err! {
    if let .Some((negative, value, scale)) = json_decimal_small(s)? -> return (negative, .Small(value), scale)
    (negative, digits, scale) := json_decimal_lexeme(s)?
    (negative, jet_decimal_magnitude_from_digits(digits), scale)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:5782
fn jet_decimal_small_to_f64(value: I128, scale: U32) -> F64 Never! {
    assert(value >= 0)
    if value == 0 -> return 0.0
    if scale == 0 -> return value as F64
    MAX_EXACT_F64_INTEGER: U128 := (U128(1) << 53) - 1
    if scale <= 15 && (value as U128) <= MAX_EXACT_F64_INTEGER -> return (value as F64) / F64(10).powi(scale as I32)
    magnitude :: value as U128
    limbs: [U32; 5] :: [0; 5]
    length: USize :: 0
    while magnitude != 0 {
        limbs[length] = (magnitude % (BI_BASE as U128)) as U32
        magnitude /= BI_BASE as U128
        length += 1
    }
    denominator := jet_decimal_power10_limbs(scale)
    jet_ratio_limbs_to_f64(limbs[0..length], denominator, false)
}
