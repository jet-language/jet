    // Every binary denominator is a power of two; a power of five gives an exact decimal.
    pub fn from_float(value: F64) -> JetDecimal? Never! {
        if !value.is_finite() -> return .None
        if value == 0.0 -> return .Some(JetDecimal.from_int(0).expect("zero is a valid Decimal"))
        bits := value.to_bits()
