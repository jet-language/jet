pub fn jet_int_exact_div_rem(value: I64, divisor: I64, file: String, line: U32) -> (I64, I64) Never! {
    match jet_exact_numeric.div_rem(jet_std_raw_to_exact(value), jet_std_raw_to_exact(divisor)) {
        .Some((quotient, remainder)) => (jet_std_exact_to_raw(quotient), jet_std_exact_to_raw(remainder)),
        .None => jet_arithmetic_stop(file, line, jet_exact_numeric.failure_message("div")),
    }
}
