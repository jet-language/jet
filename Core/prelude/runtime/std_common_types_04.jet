// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:5493
pub fn jet_int_exact_div_mod(value: I64, divisor: I64, file: String, line: U32) -> (I64, I64) Never! {
    left := jet_std_raw_to_exact(value)
    right := jet_std_raw_to_exact(divisor)
    quotient := jet_exact_numeric.floor_div(left, right).map(jet_std_exact_to_raw).unwrap_or_else(fn() {
        jet_arithmetic_stop(file, line, jet_exact_numeric.failure_message("floor_div"))
    })
    remainder := jet_exact_numeric.modulo(left, right).map(jet_std_exact_to_raw).unwrap_or_else(fn() {
        jet_arithmetic_stop(file, line, jet_exact_numeric.failure_message("mod"))
    })
    (quotient, remainder)
}
