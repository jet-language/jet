// D-MEMDISJOINT1=A: prove half-open bounds before creating mutable views.
// Rust: crates/jet-codegen/src/Prelude/Core/Disjoint.rs:5
fn jet_disjoint_split_bounds(len: USize, mid: I64) -> ((USize, USize), (USize, USize)) Err! {
    len_i64 :: len as I64
    if mid < 0 || mid > len_i64 -> return Err("split point {mid} is outside 0..={len_i64} for {len_i64} items")
    middle :: mid as USize
    Ok(((0, middle), (middle, len)))
}
// Rust: crates/jet-codegen/src/Prelude/Core/Disjoint.rs:20
fn jet_disjoint_index_bounds(len: USize, indices: View<I64>) -> [(USize, USize, USize)] Err! {
    len_i64 :: len as I64
    ordered := [(USize, USize, USize)].with_capacity(indices.len())
    loop (position, index) in indices.iter().enumerate() {
        if index < 0 || index >= len_i64 -> return Err("index {index} is outside 0..{len_i64} for {len_i64} items")
        start :: index as USize
        ordered.push((start, start + 1, position))
    }
    ordered.sort_by_key((entry) -> (entry.0, entry.1))
    loop pair in ordered.windows(2) {
        if pair[0].1 > pair[1].0 -> return Err("duplicate index {pair[1].0} overlaps itself")
    }
    Ok(^ordered)
}

