// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/FfiCallbacks.rs:46
#Equatable
pub struct JetFfiCallbackContract {
    pub capture_lifetime: Bool
    pub thread_affinity: JetFfiCallbackThreadAffinity
    pub reentrant: Bool
    pub registration_ownership: Bool
    pub completion: Bool
    pub retained_native_access: Bool
    pub authority_scope: Bool
    pub effects: String
    pub callback_identity: String
    pub plan_digest: String
}
impl JetFfiCallbackContract {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/FfiCallbacks.rs:66
    pub fn managed(identity: String, plan_digest: String) -> Self {
        Self{capture_lifetime: true, thread_affinity: .AttachedForeign, reentrant: true,
            registration_ownership: true, completion: true, retained_native_access: true,
            authority_scope: true, effects: "FFI.C + IO.Write",
            callback_identity: ^identity, plan_digest: ^plan_digest}
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/FfiCallbacks.rs:84
    pub fn validate(self: &Self, has_release: Bool) -> Err! {
        identity := self.callback_identity.trim() // #4303
        if identity.is_empty() -> return Err("callback identity is empty")
        digest := self.plan_digest.trim() // #4303
        if digest.is_empty() -> return Err("callback plan digest is empty")
        if not self.capture_lifetime -> return Err("callback capture lifetime is not retained through shutdown")
        if not self.registration_ownership -> return Err("callback registration has no consuming owner")
        if not self.completion -> return Err("callback registration has no completion acknowledgement")
        if not self.authority_scope -> return Err("callback authority scope does not cover registration and cleanup")
        if self.retained_native_access && not has_release -> return Err("retained native callback access has no release hook")
        if self.effects.split('+').map(fn(part) { part.trim() }).all(fn(part) { part != "FFI.C" }) {
            return Err("callback effects omit FFI.C")
        }
        if self.effects.split('+').map(fn(part) { part.trim() }).all(fn(part) { part != "IO.Write" }) {
            return Err("callback effects omit IO.Write")
        }
        Ok(())
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/FfiCallbacks.rs:116
fn jet_ffi_callback_plan_digest(identity: &String) -> String {
    input :: "jet-ffi-callback-plan-v1{TEXT_NUL}{identity}"
    digest := String.with_capacity(64)
    loop byte in jet_sha256_raw(input.as_bytes()) -> digest.push_str("{byte:02x}")
    digest
}
