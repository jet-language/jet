use std.cmp.Ordering
// D-FLOATSORT1: all NaNs follow non-NaNs; two NaNs compare equal.
// Rust: crates/jet-codegen/src/Prelude/Core/FloatOrdering.rs:6
pub fn jet_float_sort_cmp(left: F64, right: F64) -> Ordering {
    if left.partial_cmp(right) == Some(ordering) -> ordering
    else if left.is_nan() && right.is_nan() -> .Equal
    else if left.is_nan() -> .Greater
    else -> .Less
}

