// Rust: crates/jet-codegen/src/Prelude/Core.rs:1414
#Unsafe("carry deferred or handler diagnostics intact through native unwind")
fn jet_runtime_diagnostic(rendered: String) -> Never {
    if JET_PARA_DEFER_FAILURE.with(defer -> defer.get()) {
        panic.resume_unwind(Box.new(JetParaRuntimeFailure.Diagnostic{rendered: rendered}))
    }
    if jet_interrupt_handler_should_unwind() {
        panic.resume_unwind(Box.new(JetRenderedRuntimeStop{rendered: rendered, exit_code: I32{70}}))
    }
    std.io.eprintln(rendered)
    jet_runtime_exit()
}
// E3005: failed Pre/Post clause retains the clause's own message.
// Rust: crates/jet-codegen/src/Prelude/Core.rs:1431
#Unsafe("carry the typed contract report through the native unwind rail")
fn jet_contract_fail(file: &String, line: U32, clause_kw: &String, msg: &String) -> Never {
    if JET_PARA_DEFER_FAILURE.with(defer -> defer.get()) {
        panic.resume_unwind(Box.new(JetParaRuntimeFailure.Contract{file: file.to_string(),
            line: line, clause_kw: clause_kw.to_string(), msg: msg.to_string()}))
    }
    report :: jet_contract_report(clause_kw, msg, file, line)
    jet_test_record_stop("E3005")
    jet_proof_record(U8{2}, U8{1}, "E3005", &report.what, file, line)
    panic.resume_unwind(Box.new(report))
}
// Length-framed private evidence channel; terminal text is not evidence.
// Rust: crates/jet-codegen/src/Prelude/Core.rs:1449
fn jet_proof_record(kind: U8, state: U8, name: &String, message: &String, file: &String, line: U32) -> {
    if state == U8{1} and jet_test_expect_fail_matching_scope().is_some() {
        jet_evidence_with_expectation(true, fn() { jet_evidence_record_write(kind, state, name, message, file, line) })
    } else { jet_evidence_record_write(kind, state, name, message, file, line) }
}
