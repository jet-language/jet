// D-PARCAPTURE1=D: failure-aware wrapper over shared indexed scheduling.
// Rust: crates/jet-codegen/src/Prelude/Core.rs:281
struct JetParaFailure { index: Int, payload: Box<Any + Send> }
// Rust: crates/jet-codegen/src/Prelude/Core.rs:286
enum JetParaRuntimeFailure {
    Simple { code: String, file: String, line: U32, fn_name: String, src_line: String, msg: String }
    Rich { code: String, file: String, line: U32, fn_name: String, src_line: String, col: U32, caret_len: U32, msg: String, locals: String }
    Diagnostic { rendered: String }
    Contract { file: String, line: U32, clause_kw: String, msg: String }
    SchedulerFatal { msg: String }
}
impl JetParaRuntimeFailure {
    // Rust: crates/jet-codegen/src/Prelude/Core.rs:321
    fn raise(self) -> Never {
        match self {
            .Simple{code, file, line, fn_name, src_line, msg} ->
                jet_runtime_stop_with_context(code, &file, line, &fn_name, &src_line, &msg)
            .Rich{code, file, line, fn_name, src_line, col, caret_len, msg, locals} ->
                jet_panic_rich_code(code, &file, line, &fn_name, &src_line, col, caret_len, &msg, &locals)
            .Diagnostic{rendered} -> jet_runtime_diagnostic(rendered)
            .Contract{file, line, clause_kw, msg} -> jet_contract_fail(&file, line, &clause_kw, &msg)
            .SchedulerFatal{msg} -> jet_runtime_stop("E3001", "", U32{0}, &msg)
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core.rs:356
// GATE #4565: kernel primitive — per-thread deferred failure flag.
pub JET_PARA_DEFER_FAILURE :: ThreadLocal<Cell<Bool>>.new(fn() { Cell.new(false) })
// Rust: crates/jet-codegen/src/Prelude/Core.rs:360
// GATE #4565: kernel primitive — host unwind capture retains its actual payload.
#Unsafe("callback unwind is caught on the same thread and the deferred flag is restored")
fn jet_para_call<R>(index: Int, f: fn() -> R) -> R JetParaFailure! {
    result :: JET_PARA_DEFER_FAILURE.with(defer -> {
        previous :: defer.replace(true)
        result :: panic.catch_unwind(panic.AssertUnwindSafe(f))
        defer.set(previous)
        result
    })
    result.map_err(payload -> JetParaFailure{index: index, payload: payload})
}
// Rust: crates/jet-codegen/src/Prelude/Core.rs:373
// GATE #4565: kernel primitive — typed unwind carrier classification.
#Unsafe("resume the original payload if it is not a deferred Jet runtime failure")
fn jet_para_raise_failure(failure: JetParaFailure) -> Never {
    match failure.payload.downcast<JetParaRuntimeFailure>() {
        Ok(failure) -> failure.raise()
        Err(payload) -> panic.resume_unwind(payload)
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core.rs:380
fn jet_list_para_chunks<R: Send>(len: Int, worker_limit: Int, f: fn(Range<Int>) -> R JetParaFailure!) -> [R] {
    // GATE #4565: kernel primitive — selected compile configuration and hardware parallelism.
    worker_cap :: #Unsafe("read selected test configuration or native available parallelism") {
        if std.cfg.jet_para_test_workers { 3 }
        else { std.thread.available_parallelism().map(n -> n.get()).unwrap_or(1) }
    }
    (indexed, _) :: jet_list_para_chunks_measured(len, worker_limit, worker_cap, true, true, true,
        JetAccelerationTransform.PooledParallelChunks, false, false, None, f)
    results := Array.with_capacity(indexed.len())
    first_failure: JetParaFailure? = None
    for (_, outcome) in indexed {
        match outcome {
            Ok(result) -> results.push(^result)
            Err(failure) -> {
                if first_failure.as_ref().is_none_or(first -> failure.index < first.index) { first_failure = Val(^failure) }
            }
        }
    }
    if first_failure is Val(failure) { jet_para_raise_failure(failure) }
    results
}
// Rust: crates/jet-codegen/src/Prelude/Core.rs:425
fn jet_list_para_map<T: Sync, U: Send>(xs: [T], f: fn(&T) -> U, limit: JetInt) -> [U] {
    worker_limit :: jet_std.jet_int_owned_to_i64(&limit).ok().and_then(value -> USize.try_from(value).ok()).unwrap_or(USize{usize_max()}).max(USize{1})
    jet_list_para_chunks(xs.len(), Int{worker_limit}, range -> {
        out := Array.with_capacity(range.len())
        for index in range { out.push(jet_para_call(index, fn() { f(&xs[index]) })?) }
        out
    }).into_iter().flatten().collect()
}
// Rust: crates/jet-codegen/src/Prelude/Core.rs:452
fn jet_list_para_flags<T: Sync>(xs: &[T], f: fn(&T) -> Bool) -> [Bool] {
    jet_list_para_chunks(xs.len(), Int{usize_max()}, range -> {
        out := Array.with_capacity(range.len())
        for index in range { out.push(jet_para_call(index, fn() { f(&xs[index]) })?) }
        out
    }).into_iter().flatten().collect()
}
// Rust: crates/jet-codegen/src/Prelude/Core.rs:469
fn jet_list_para_filter<T: Sync>(xs: [T], f: fn(&T) -> Bool) -> [T] {
    keep :: jet_list_para_flags(&xs, f)
    xs.into_iter().zip(keep).filter_map((x, keep) -> if keep { Val(^x) } else { None }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/Core.rs:481
fn jet_list_para_partition<T: Sync, R>(xs: [T], f: fn(&T) -> Bool, out: fn([T], [T]) -> R) -> R {
    matches :: jet_list_para_flags(&xs, f)
    false_items := []
    true_items := []
    for (item, matched) in xs.into_iter().zip(matches) {
        if matched { true_items.push(^item) } else { false_items.push(^item) }
    }
    out(^false_items, ^true_items)
}
// Rust: crates/jet-codegen/src/Prelude/Core.rs:500
fn jet_list_para_fold<T: Sync, U: Send>(xs: [T], seed: fn() -> U, step: fn(&U, &T) -> U, merge: fn(&U, &U) -> U) -> U {
    partials :: jet_list_para_chunks(xs.len(), Int{usize_max()}, range -> {
        start :: range.start
        acc := jet_para_call(start, seed)?
        for index in range { acc = jet_para_call(index, fn() { step(&acc, &xs[index]) })? }
        (start, acc)
    })
    if partials.is_empty() -> return seed()
    jet_list_para_merge_tree(partials, ((left_index, left), (_, right)) ->
        jet_para_call(left_index, fn() { merge(&left, &right) }).map(merged -> (left_index, merged)))
        .unwrap_or_else(failure -> jet_para_raise_failure(failure)).1
}

// D-FRED1=A: reject extents outside the selected wasm32 address space.
// Rust: crates/jet-codegen/src/Prelude/Core.rs:533
fn jet_web_d_fred_checked_len(len: U32, element_size: Int) -> Int {
    bytes :: (Int{len}).checked_mul(element_size).expect("Web D-FRED input byte size overflow")
    assert(bytes <= Int{U32.MAX}, "Web D-FRED input exceeds wasm32 address space")
    Int{len}
}
// Rust: crates/jet-codegen/src/Prelude/Core.rs:545
// GATE #4565: kernel primitive — wasm bridge thread-local owned input storage.
