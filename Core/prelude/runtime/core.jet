// Rust: crates/jet-codegen/src/Prelude/Core.rs:553
// GATE #4565: kernel primitive — retained wasm buffer pointer ABI.
#Unsafe("wasm host receives only the pointer to this thread's retained initialized f32 buffer")
pub fn jet_web_d_fred_f32_alloc(len: U32) -> U32 {
    assert(selected_arch() == "wasm32")
    JET_WEB_D_FRED_F32_INPUT.with(cell -> {
        values := cell.borrow_mut()
        count :: jet_web_d_fred_checked_len(len, 4)
