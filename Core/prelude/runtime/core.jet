//RS struct JetRenderedRuntimeStop {
//RS     rendered: String,
//RS     exit_code: i32,
//RS }
//RS 
//RS /// Raise a program-side stop through the unwind carrier that THIS frame's
//RS /// catcher reads (I9; D-CONC-FAIL1=A "a joined child panic becomes
//RS /// `.Panicked(reason)`").
//RS ///
//RS /// A scheduler task frame is caught inside `Prelude/Scheduler.rs` — by
//RS /// `jet_scheduler_catch_task_unwind` for a spawned body, by
//RS /// `jet_scheduler_wait_without_unwind` for a native wait boundary — and both
//RS /// publish the child value out of a `String` payload
//RS /// (`jet_scheduler_panic_message`, `JetSchedulerWait::Panicked`). So a task
//RS /// frame carries the stop's own message and nothing else: the `reason` in
//RS /// `.Panicked(reason)` is a value the PROGRAM computed, and a runtime that put
//RS /// its own stand-in text there would publish a wrong answer, not a vaguer one.
//RS /// The other tiers already carry the program's message into that same frame —
//RS /// the resident JIT re-raises it (`jet-jit/src/Concurrency.rs`
//RS /// `spawn_with_runtime`, from the `msg` recorded by `jet_jit_rich_panic`), and
//RS /// the interpreter carries it as the child's E0953 `what`
//RS /// (`Codegen/TIR/eval/exprs.rs` `eval_require_failure`).
//RS ///
//RS /// Every intentional unwinding frame keeps the typed report: an `#Interrupt`
//RS /// handler and `jet test`'s expect-fail region catch the rendered stop, while
//RS /// scheduler tasks receive the program's message above. The ordinary process
//RS /// path may cross a boundary that cannot carry an unwind. This matters for
//RS /// debug native dispatch: its `extern "C"` trampoline is a non-unwinding ABI,
//RS /// so resuming a panic there aborts before `jet_runtime_boundary` can observe
//RS /// the report. End that path at the shared process boundary instead.
//RS fn jet_runtime_stop_unwind(rendered: String, exit_code: i32, message: &str) -> ! {
//RS     if jet_scheduler_in_task() {
//RS         std::panic::resume_unwind(Box::new(message.to_string()));
//RS     }
//RS     if !jet_runtime_should_unwind() {
//RS         jet_runtime_process_exit(exit_code, Some(&rendered));
//RS     }
//RS     std::panic::resume_unwind(Box::new(JetRenderedRuntimeStop {
//RS         rendered,
//RS         exit_code,
//RS     }))
//RS }
//RS 
//RS /// A user-requested process stop unwinds through the same boundary as a
//RS /// runtime report. This gives guards and deferred resource closes a chance to
//RS /// run before the final native exit.
//RS struct JetExplicitExit {
//RS     code: i32,
//RS }
//RS 
//RS // Process-edge callbacks live beside the one boundary so a program that does
//RS // not import core.sys still has a complete entry wrapper. The OS adapter only
//RS // registers callbacks; it never installs a second native exit path.
//RS mod jet_runtime_atexit {
//RS     use std::cell::RefCell;
//RS 
//RS     thread_local! {
//RS         static HANDLERS: RefCell<Vec<Box<dyn Fn() + 'static>>> = const { RefCell::new(Vec::new()) };
//RS     }
//RS 
//RS     pub(super) fn register<F>(handler: F)
//RS     where
//RS         F: Fn() + 'static,
//RS     {
//RS         HANDLERS.with(|handlers| {
//RS             let mut handlers = handlers.borrow_mut();
//RS             super::jet_runtime_register_atexit(&mut handlers, Box::new(handler));
//RS         });
//RS     }
//RS 
//RS     pub(super) fn run() {
//RS         HANDLERS.with(|handlers| {
//RS             let mut handlers = handlers.borrow_mut();
//RS             super::jet_runtime_drain_atexit(&mut handlers, |handler| handler());
//RS         });
//RS     }
//RS }
//RS 
//RS fn jet_std_os_atexit<F>(handler: std::rc::Rc<F>)
//RS where
//RS     F: Fn() + 'static,
//RS {
//RS     jet_runtime_atexit::register(move || handler());
//RS }
//RS 
//RS fn jet_std_os_run_atexit() {
//RS     jet_runtime_atexit::run();
//RS }
