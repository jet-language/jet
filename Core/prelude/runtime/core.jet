    JET_WEB_D_FRED_F32_INPUT.with(cell -> {
        values :: cell.borrow()
        assert(Int{ptr} == values.as_ptr().addr(), "invalid Web D-FRED input pointer")
        assert(Int{len} <= values.len(), "invalid Web D-FRED input length")
        jet_simd_reduce_fixed(&values[..Int{len}], seed)
    })
}
// Rust: crates/jet-codegen/src/Prelude/Core.rs:575
#Unsafe("verify retained wasm f32 buffer identity before releasing its allocation")
pub fn jet_web_d_fred_f32_free(ptr: U32) -> {
