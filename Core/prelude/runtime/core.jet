//RS /// The value slot of a read of a folded aggregate constant: the constant is
//RS /// one per-thread value built once, so a read borrows it in place and only an
//RS /// owned use or a write copies it (a uniquely held value is moved, not
//RS /// copied). The slot keeps the `Option` slot API (`as_ref`, `as_mut`, `take`)
//RS /// its readers use.
//RS pub struct JetSharedSlot<T>(Option<std::rc::Rc<T>>);
//RS 
//RS impl<T: Clone> JetSharedSlot<T> {
//RS     pub const fn empty() -> Self {
//RS         Self(None)
//RS     }
//RS 
//RS     pub fn new(value: std::rc::Rc<T>) -> Self {
//RS         Self(Some(value))
//RS     }
//RS 
//RS     pub fn as_ref(&self) -> Option<&T> {
//RS         self.0.as_deref()
//RS     }
//RS 
//RS     pub fn as_mut(&mut self) -> Option<&mut T> {
//RS         self.0.as_mut().map(std::rc::Rc::make_mut)
//RS     }
//RS 
//RS     pub fn take(&mut self) -> Option<T> {
//RS         self.0.take().map(std::rc::Rc::unwrap_or_clone)
//RS     }
//RS 
//RS     /// Ends this read without copying the shared rows.
//RS     pub fn release(&mut self) {
//RS         self.0 = None;
//RS     }
//RS }
