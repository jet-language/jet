// Rust: crates/jet-codegen/src/Prelude/Core.rs:625
// GATE #4565: kernel primitive — sequentially consistent shared signal.
JET_PERF_FIDELITY :: AtomicU32.new(JET_PERF_DEFAULT_FIDELITY_BITS)
// Rust: crates/jet-codegen/src/Prelude/Core.rs:627
#Unsafe("atomic fidelity load observes the shared signal with SeqCst ordering")
fn jet_perf_fidelity() -> F64 { F64{F32.from_bits(JET_PERF_FIDELITY.load(Ordering.SeqCst))} }
// Rust: crates/jet-codegen/src/Prelude/Core.rs:631
