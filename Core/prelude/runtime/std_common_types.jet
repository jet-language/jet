// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:861
#Equatable
pub struct DataSchema {
    pub identity: String
    pub format: DataFormat
    pub columns: [DataColumn]
    pub projection: ShapeProjection?
}
impl DataSchema {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:875
    pub fn infer(tree: DataTree, format: DataFormat) -> DataSchema Never! {
        // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:876
        fn merge_type(left: String, right: String) -> (String, Bool) Never! {
            if left == right {
                name :: match left {
                    "null" => "null", "bool" => "bool", "int" => "int", "float" => "float",
                    "text" => "text", "bytes" => "bytes", "array" => "array", "object" => "object", _ => "Any",
                }
                return (name, left == "null")
            }
            if left == "null" -> return (right, true)
            if right == "null" -> return (left, true)
            if (left == "int" and right == "float") or (left == "float" and right == "int") -> return ("float", false)
            ("Any", false)
        }
        // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:904
        fn value_type(value: DataTree) -> String Never! {
            match value {
                .Null => "null", .Bool(_) => "bool", .Int(_) => "int",
                .Float(_) | .Number(_) => "float", .TypedText(_) | .Text(_) => "text",
                .Bytes(_) => "bytes", .Array(_) => "array", .Object(_) => "object",
            }
        }
        // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:916
        fn absorb(fields: &[String: (String, Bool)], name: String, value: DataTree, nullable: Bool) Never! {
            current_type :: value_type(value)
            merged := (current_type, nullable or current_type == "null")
            if fields.get(name) is Val(current) {
                pair :: merge_type(current.0, current_type)
                merged = (pair.0, current.1 or nullable or pair.1)
            }
            fields[name] = merged
        }
        fields := [String: (String, Bool)]{}
        match tree {
            .Object(entries) => {
                loop (name, value) in entries -> absorb(&fields, name.clone(), value, value is .Null)
            },
            .Array(values) => {
                rows_seen := 0
                loop value in values {
                    if value is .Object(entries) {
                        present := [String: Bool]{}
                        loop (name, _) in entries -> present[name] = true
                        loop (name, item) in entries -> absorb(&fields, name.clone(), item, rows_seen > 0 or item is .Null)
                        names :: fields.keys().collect()
                        loop name in names {
                            if not present.contains_key(name) {
                                if fields.get(name) is Val(current) -> fields[name] = (current.0, true)
                            }
                        }
                    } else {
                        absorb(&fields, "$", value, rows_seen > 0 or value is .Null)
                    }
                    rows_seen = rows_seen.saturating_add(1)
                }
            },
            value => absorb(&fields, "$", value, value is .Null),
        }
        // Rust BTreeMap order: sort the keys once, never depend on hash iteration.
        names := fields.keys().collect()
        names.sort()
        columns := [DataColumn]{}
        loop order in 0..<names.len() {
            name :: names[order]
            pair :: fields[name]
            columns.push(DataColumn{id: "column-{order}-{name}", name: name,
                type_name: pair.0, nullable: pair.1})
        }
        identity := ""
        format_name :: format.as_str()
        identity += "{format_name.bytes().len()}:{format_name};"
        loop column in columns {
            nullable :: if column.nullable { "true" } else { "false" }
            loop value in [column.id, column.name, column.type_name, nullable] {
                identity += "{value.bytes().len()}:{value};"
            }
        }
        DataSchema{identity: identity, format: format, columns: columns, projection: None}
    }
}
