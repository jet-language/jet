// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:71
// GATE #4494: Windows HPCON is an owned native handle, not a file pipe.
struct ConPtyControl { handle: Cell<Int> }
impl ConPtyControl {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:87
    fn new(handle: Int) -> ConPtyControl Never! { ConPtyControl{handle: Cell.new(handle)} }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:93
    fn raw(self) -> Int Never! { self.handle.get() }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:97
    fn close(self) Never! {
        handle :: self.handle.replace(0)
        if handle != 0 {
            // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:82
            // GATE #4494: kernel32 ClosePseudoConsole, system ABI. Zeroing first
            // preserves the single HPCON owner and makes wait/drop idempotent.
            if selected_os() == .Windows -> std.windows.kernel32.ClosePseudoConsole(handle)
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:109
impl ConPtyControl.Close { fn close(^self) { ConPtyControl.close(self) } }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:115
pub struct TerminalSession {
    // GATE #4483/#4494: only the selected family's native handle is present.
    master: Rc<File>?
    control: Rc<ConPtyControl>?
}
impl TerminalSession {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:127
    pub fn eq(self, other: TerminalSession) -> Bool Never! {
        match selected_family() {
            .Unix => Rc.ptr_eq(self.master.unwrap(), other.master.unwrap()),
            .Windows => Rc.ptr_eq(self.control.unwrap(), other.control.unwrap()),
            _ => false,
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs:128
impl TerminalSession.Equatable {
    fn equal(self, rhs: TerminalSession) -> Bool Never! { self.eq(rhs) }
}
impl TerminalSession.Clone {
    fn clone(self) -> TerminalSession Never! {
        TerminalSession{master: self.master.clone(), control: self.control.clone()}
    }
}
