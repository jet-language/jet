use std.cmp.Ordering
// Rust: crates/jet-codegen/src/Prelude/Core/MapKey.rs:4
#Derive(Clone, Debug)
pub enum JetMapKey {
    Int(I64)
    // Normalized little-endian base 10^9 limbs; fits-i64 values use Int only.
    BigInt { negative: Bool, limbs: [U32] }
    UInt(U64)
    String(String)
    Bool(Bool)
    Char(Char)
    Record([JetMapKey])
}
// Rust: crates/jet-codegen/src/Prelude/Core/MapKey.rs:20
fn jet_map_key_kind(key: JetMapKey) -> U8 {
    if key == { .Int(_), .BigInt{..} -> 0; .UInt(_) -> 1; .String(_) -> 2; .Bool(_) -> 3; .Char(_) -> 4; .Record(_) -> 5 }
}
// Rust: crates/jet-codegen/src/Prelude/Core/MapKey.rs:32
pub fn jet_map_key_cmp(left: JetMapKey, right: JetMapKey) -> Ordering {
    if (left, right) == {
        (.Int(l), .Int(r)) -> l.cmp(r)
        (.Int(_), .BigInt{negative, ..}) -> if negative -> .Greater else -> .Less
        (.BigInt{negative, ..}, .Int(_)) -> if negative -> .Less else -> .Greater
        (.BigInt{negative: ln, limbs: l}, .BigInt{negative: rn, limbs: r}) -> {
            if ln != rn -> return rn.cmp(ln)
            magnitude := l.len().cmp(r.len())
            if magnitude == .Equal -> magnitude = l.iter().rev().cmp(r.iter().rev())
            if ln -> magnitude.reverse() else -> magnitude
        }
        (.UInt(l), .UInt(r)) -> l.cmp(r)
        (.String(l), .String(r)) -> l.cmp(r)
        (.Bool(l), .Bool(r)) -> l.cmp(r)
        (.Char(l), .Char(r)) -> l.cmp(r)
        (.Record(l), .Record(r)) -> {
            loop (lkey, rkey) in l.iter().zip(r) {
                order :: jet_map_key_cmp(lkey, rkey)
                if order != .Equal -> return order
            }
            l.len().cmp(r.len())
        }
        else -> jet_map_key_kind(left).cmp(jet_map_key_kind(right))
    }
}
impl PartialEq for JetMapKey {
    // Rust: crates/jet-codegen/src/Prelude/Core/MapKey.rs:92
    fn eq(self: JetMapKey, other: JetMapKey) -> Bool { jet_map_key_cmp(self, other) == .Equal }
}
// Rust: crates/jet-codegen/src/Prelude/Core/MapKey.rs:97
impl Eq for JetMapKey {}
impl PartialOrd for JetMapKey {
    // Rust: crates/jet-codegen/src/Prelude/Core/MapKey.rs:100
    fn partial_cmp(self: JetMapKey, other: JetMapKey) -> Ordering? { Some(jet_map_key_cmp(self, other)) }
}
impl Ord for JetMapKey {
    // Rust: crates/jet-codegen/src/Prelude/Core/MapKey.rs:106
    fn cmp(self: JetMapKey, other: JetMapKey) -> Ordering { jet_map_key_cmp(self, other) }
}

