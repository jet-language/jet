// D-TYPE2-SPELL1: preserve the i64 carrier, check only the interval fact.
// Rust: crates/jet-codegen/src/Prelude/Core/InlineRange.rs:3
pub fn jet_inline_range_from_int(value: I64, lo: I64, hi: I64) -> I64 Err! {
    if value >= lo && value <= hi -> Ok(value)
    else -> Err("value is outside Int({lo}..{hi})")
}

