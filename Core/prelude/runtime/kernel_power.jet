impl JetPow for U64 {
    // GATE #4565: kernel primitive — bit reinterpretation of inline unsigned operands/results.
    #Unsafe("marshal U64 payload bits into the canonical I64 fixed-operation carrier")
    fn jet_pow(self, exponent: JetFixedWide, file: &String, line: U32) -> Self { std.mem.transmute<I64, U64>(jet_power_fixed_value(jet_fixed_arithmetic(std.mem.transmute<U64, I64>(self), exponent, JET_FIXED_OP_POW, JET_FIXED_MODE_TRAP, false, 64, true), file, line)) }
    #Unsafe("marshal U64 payload bits into the canonical I64 fixed-operation carrier")
    fn jet_wrapping_pow(self, exponent: JetFixedWide, file: &String, line: U32) -> Self { std.mem.transmute<I64, U64>(jet_power_fixed_value(jet_fixed_arithmetic(std.mem.transmute<U64, I64>(self), exponent, JET_FIXED_OP_POW, JET_FIXED_MODE_WRAPPING, false, 64, true), file, line)) }
    #Unsafe("marshal U64 payload bits into the canonical I64 fixed-operation carrier")
    fn jet_saturating_pow(self, exponent: JetFixedWide, file: &String, line: U32) -> Self { std.mem.transmute<I64, U64>(jet_power_fixed_value(jet_fixed_arithmetic(std.mem.transmute<U64, I64>(self), exponent, JET_FIXED_OP_POW, JET_FIXED_MODE_SATURATING, false, 64, true), file, line)) }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Power.rs:74
trait JetPowFloat: Copy { fn jet_pow(self, exponent: Self) -> Self }
// Rust: crates/jet-codegen/src/Prelude/Core/Power.rs:77
impl JetPowFloat for F64 { fn jet_pow(self, exponent: F64) -> F64 { self.powf(exponent) } }
