// D-EXPOP1=A / D-EXPSEM1=A: dynamic whole-number exponents stay signed i128,
// marshalled through the canonical two-word carrier. Negative exponents trap.
// Rust: crates/jet-codegen/src/Prelude/Core/Power.rs:15
trait JetPow: Copy {
    fn jet_pow(self, exponent: JetFixedWide, file: &String, line: U32) -> Self
    fn jet_wrapping_pow(self, exponent: JetFixedWide, file: &String, line: U32) -> Self
    fn jet_saturating_pow(self, exponent: JetFixedWide, file: &String, line: U32) -> Self
}
// Rust: crates/jet-codegen/src/Prelude/Core/Power.rs:21
fn jet_power_fixed_value(result: JetFixedArithmeticResult, file: &String, line: U32) -> I64 {
    match result {
        .Value(value) -> value
        .Absent -> jet_arithmetic_stop(file, line, "This checked fixed-width operation has no result")
        .Trap(error) -> jet_fixed_error_stop(error, file, line)
    }
}
