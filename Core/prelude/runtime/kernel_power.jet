    // Rust: crates/jet-codegen/src/Prelude/Core/Power.rs:58
    fn jet_saturating_pow(self, exponent: JetFixedWide, file: &String, line: U32) -> Self { I8{jet_power_fixed_value(jet_fixed_arithmetic(I64{self}, exponent, JET_FIXED_OP_POW, JET_FIXED_MODE_SATURATING, true, 8, true), file, line)} }
}
