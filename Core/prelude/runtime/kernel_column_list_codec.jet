    // Rust: crates/jet-codegen/src/Prelude/Core/ColumnListCodec.rs:8
    fn jet_encode(self: JetColumnList<S>) -> DataTree { self.to_aos().jet_encode() }
}
impl<S: JetRow + __jet_Decode> __jet_Decode for JetColumnList<S> {
    // Rust: crates/jet-codegen/src/Prelude/Core/ColumnListCodec.rs:14
