// Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:456
impl<T: JetShow, E: JetShow> JetShow for JetOutcome<T, E> {
    fn jet_show(self) -> String {
        clean :: E.jet_report_is_clean()
