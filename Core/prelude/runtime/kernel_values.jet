fn jet_loadable_idle() -> Loadable<Unit, Unit> { .Idle }
// Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:480
fn jet_loadable_loading() -> Loadable<Unit, Unit> { .Loading }
// Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:483
fn jet_loadable_loaded<T: Clone>(value: T) -> Loadable<T, Unit> { .Loaded(^value) }
// Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:486
fn jet_loadable_failed<E: Clone>(error: E) -> Loadable<Unit, E> { .Failed(^error) }
// Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:489
impl<T: Clone, E: Clone> Loadable<T, E> {
    fn loadable_tag(self) -> U8 {
        match self { .Idle -> JET_LOADABLE_IDLE, .Loading -> JET_LOADABLE_LOADING, .Loaded(_) -> JET_LOADABLE_LOADED, .Failed(_) -> JET_LOADABLE_FAILED }
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:498
    fn is_idle(self) -> Bool { jet_loadable_is_tag(self.loadable_tag(), JET_LOADABLE_IDLE) }
    // Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:501
    fn is_loading(self) -> Bool { jet_loadable_is_tag(self.loadable_tag(), JET_LOADABLE_LOADING) }
    // Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:504
    fn is_loaded(self) -> Bool { jet_loadable_has_value(self.loadable_tag()) }
    // Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:507
    fn is_failed(self) -> Bool { jet_loadable_is_tag(self.loadable_tag(), JET_LOADABLE_FAILED) }
    // Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:510
    fn loaded(self) -> JetOutcome<T, JetAbsent> {
        if jet_loadable_has_value(self.loadable_tag()) {
            if self is .Loaded(v) -> return Ok(v.clone())
            unreachable("loaded tag requires Loaded payload")
        } else { Err(JetAbsent{}) }
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:518
    fn or_else(self, default: T) -> T {
        if jet_loadable_has_value(self.loadable_tag()) {
            if self is .Loaded(v) -> return v.clone()
            unreachable("loaded tag requires Loaded payload")
        } else { default }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:527
impl<T: Clone + JetShow, E: Clone + JetShow> JetShow for Loadable<T, E> {
    fn jet_show(self) -> String {
        match self { .Idle -> "Idle", .Loading -> "Loading", .Loaded(v) -> format("Loaded({})", v.jet_show()), .Failed(e) -> format("Failed({})", e.jet_show()) }
    }
}
