// Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:546
struct JetExpiring<T: Clone> { value: T, deadline_ms: I64 }
// Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:550
impl<T: Clone> JetExpiring<T> {
    fn new(value: T, deadline_ms: I64) -> JetExpiring<T> { JetExpiring{value: value, deadline_ms: deadline_ms} }
    // Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:554
    fn get(self, now_ms: I64) -> T JetExpired! {
        if now_ms > self.deadline_ms { Err(JetExpired{}) } else { self.value.clone() }
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:561
    fn is_valid(self, now_ms: I64) -> Bool { now_ms <= self.deadline_ms }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:565
impl<T: Clone + JetShow> JetShow for JetExpiring<T> {
    fn jet_show(self) -> String { format("Expiring(deadline={})", self.deadline_ms) }
}
