struct JetDeferredClose<F: FnOnce> { close: F? }
// Rust: crates/jet-codegen/src/Prelude/Core/Values.rs:200
impl<F: FnOnce> JetDeferredClose<F> {
    fn new(close: F) -> JetDeferredClose<F> { JetDeferredClose{close: Val(^close)} }
