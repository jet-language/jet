//RS /// #1633: one canonical listing per JIT host symbol.
//RS ///
//RS /// Each per-module host-symbol table used to write every symbol four times:
//RS /// the host `fn` itself (real code, unaffected here), a `FuncId` struct field,
//RS /// a `builder.symbol(...)` registration, and a `module.declare_function(...)`
//RS /// import — about 1,300 symbols x the last three listings. Missing one of
//RS /// those three did not fail the build; it failed silently at JIT run time.
//RS /// `host_fns!` takes one entry per symbol and generates the struct, the
//RS /// `builder.symbol` registration function, and the `declare_function` import
//RS /// function from it, so a symbol with a missing piece is a compile error.
//RS ///
//RS /// `#extra { field: Type, ... }` passes already-declared delegate values
//RS /// (nested per-module `Host*Fns` structs) straight through as plain struct
//RS /// fields / fn params, for the top-level table that composes them. The `#`
//RS /// is load-bearing, not decoration: `macro_rules!` can't tell an optional
//RS /// `extra { ... }` group apart from a `$field:ident` that happens to be
//RS /// spelled `extra` (`local ambiguity` error) unless the group starts on a
//RS /// token no field name can produce.
//RS ///
//RS /// `@shared field: "symbol": sig;` (no `=> host_fn`) declares and imports a
//RS /// `FuncId` whose `builder.symbol` registration is owned by a different
//RS /// module's `host_fns!` block (a handful of symbols — e.g.
//RS /// `jet_jit_event_scope` — are registered once by `Reactive` and imported by
//RS /// both `Reactive` and `Watcher`). Left out of `$register_fn` so
//RS /// registration stays single-owner per symbol.
//RS ///
//RS /// D-JITUNWIND1 (#1995 / #1997): the same one-entry-per-symbol input also
//RS /// generates the crate's **no-unwind boundary**. `builder.symbol` registers
//RS /// `host_seam::guarded($host_fn)` — a shim with the same C signature that runs
//RS /// the seam inside `guard_seam` — never `$host_fn` itself. A JIT frame carries
//RS /// no unwind information (`cranelift-jit` registers none), so a Rust panic
//RS /// raised above one aborts the process with `failed to initiate panic,
//RS /// error 5` before any outer `catch_unwind` can exist. Boundary conversion was
//RS /// chosen over registering FDEs for generated code, and its recorded cost is
//RS /// that the guarantee must hold for every entry below — which is why it is
//RS /// generated here instead of reviewed per call site. `host_seam.rs` carries the
//RS /// full decision record and `tests/jit_no_unwind_boundary.rs` is the mechanical
//RS /// check. See also `Docs/spec/architecture.md` R13.
//RS macro_rules! host_fns {
//RS     (
//RS         struct $StructName:ident;
//RS         register: $register_fn:ident;
//RS         declare: $declare_fn:ident($module:ident) { $($sigs:tt)* }
//RS         $(#extra { $($extra_field:ident : $extra_ty:ty),* $(,)? })?
//RS         $( $(@shared)? $field:ident : $symbol:literal $(=> $host_fn:path)? : $sig:expr ; )*
//RS     ) => {
//RS         pub(crate) struct $StructName {
//RS             $( pub(crate) $field: cranelift_module::FuncId, )*
//RS             $( $( pub(crate) $extra_field: $extra_ty, )* )?
//RS         }
//RS 
//RS         impl $StructName {
//RS             /// Resolve a registered host symbol without adding another
//RS             /// per-module lookup table in lowering. The macro input is the
//RS             /// one declaration/registration source for both operations.
//RS             pub(crate) fn lookup(&self, symbol: &str) -> Option<cranelift_module::FuncId> {
//RS                 match symbol {
//RS                     $( $symbol => Some(self.$field), )*
//RS                     _ => {
//RS                         $(
//RS                             $(
//RS                                 if let Some(id) = self.$extra_field.lookup(symbol) {
//RS                                     return Some(id);
//RS                                 }
//RS                             )*
//RS                         )?
//RS                         None
//RS                     }
//RS                 }
//RS             }
//RS         }
//RS 
//RS         pub(crate) fn $register_fn(builder: &mut cranelift_jit::JITBuilder) {
//RS             $(
//RS                 $(
//RS                     builder.symbol($symbol, $crate::host_seam::guarded($host_fn));
//RS                     #[cfg(test)]
//RS                     $crate::host_fns_audit::record_registered($symbol);
//RS                 )?
//RS             )*
//RS         }
//RS 
//RS         #[allow(unused_mut)]
//RS         pub(crate) fn $declare_fn<M: cranelift_module::Module>(
//RS             $module: &mut M,
//RS             $( $( $extra_field: $extra_ty, )* )?
//RS         ) -> Result<$StructName, String> {
//RS             $($sigs)*
//RS             let mut import = |name: &str, sig: &cranelift_codegen::ir::Signature| -> Result<cranelift_module::FuncId, String> {
//RS                 #[cfg(test)]
//RS                 $crate::host_fns_audit::record_declared(name);
//RS                 cranelift_module::Module::declare_function(
//RS                     $module,
//RS                     name,
//RS                     cranelift_module::Linkage::Import,
//RS                     sig,
//RS                 )
//RS                 .map_err(|e| e.to_string())
//RS             };
//RS             Ok($StructName {
//RS                 $( $field: import($symbol, &$sig)?, )*
//RS                 $( $( $extra_field, )* )?
//RS             })
//RS         }
//RS     };
//RS }
//RS 
//RS /// #1633 criterion #3 backstop: `JITModule::new`'s eager symbol resolution
//RS /// (cranelift-jit 0.112.3, `backend.rs` `declare_function` for
//RS /// `Linkage::Import`) does `lookup_symbol(name).unwrap_or(null)` and
//RS /// installs a null PLT entry on a miss — it does not fail. So a declared
//RS /// import with no matching registered symbol (e.g. an `@shared` entry whose
//RS /// owning module's registration was deleted) builds and passes `new_jit_module`
//RS /// silently, then calls a null pointer at run time. Every `host_fns!`
//RS /// `register_fn`/`declare_fn` records into these two sets so a test can
//RS /// compare them directly instead of trusting `JITModule::new`'s `Ok`.
//RS #[cfg(test)]
//RS pub(crate) mod host_fns_audit {
//RS     use std::collections::BTreeSet;
//RS     use std::sync::Mutex;
//RS 
//RS     static REGISTERED: Mutex<BTreeSet<String>> = Mutex::new(BTreeSet::new());
//RS     static DECLARED: Mutex<BTreeSet<String>> = Mutex::new(BTreeSet::new());
//RS 
//RS     pub(crate) fn record_registered(name: &str) {
//RS         REGISTERED.lock().unwrap().insert(name.to_string());
//RS     }
//RS 
//RS     pub(crate) fn record_declared(name: &str) {
//RS         DECLARED.lock().unwrap().insert(name.to_string());
//RS     }
//RS 
//RS     /// Snapshot both sets and clear them for the next test.
//RS     pub(crate) fn take_snapshot() -> (BTreeSet<String>, BTreeSet<String>) {
//RS         let mut registered = REGISTERED.lock().unwrap();
//RS         let mut declared = DECLARED.lock().unwrap();
//RS         (
//RS             std::mem::take(&mut *registered),
//RS             std::mem::take(&mut *declared),
//RS         )
//RS     }
//RS }
