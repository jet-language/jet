// PORT-PENDING 0242 crates-jet-jit-src-host-seam-module-group: crates/jet-jit/src/lib.rs:1-602
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! c139 (D-JITDEP1 / D-JIT2=A) — Cranelift JIT tier-1 backend.
//RS //!
//RS //! Architecture: `CraneliftBackend` consumes checked canonical MIR. Native
//RS //! execution is allowed only for functions whose upstream target facts include
//RS //! Cranelift; unsupported MIR is reported at this execution boundary.
//RS //! `--trace-tiers` remains available for experts.
//RS //! M2 keeps a resident JIT module + live runtime heap across hot_swap.
//RS //! M3 widens native lowering: arithmetic, bindings, if/else, calls, loops,
//RS //! compound assign, &&/|| short-circuit.
//RS //! M4: tasks/channels/spawn via scheduler host shims (D-ASYNCRT1=A).
//RS 
//RS // This module includes shared Prelude source that several hosts compile,
//RS // each using a different subset, so dead-code reports here are about the
//RS // other hosts' usage, not about this one. Scoped to the module, never the crate.
//RS #![expect(
//RS     dead_code,
//RS     reason = "#804: shared Prelude host adapters are compiled by multiple tiers"
//RS )]
//RS #![expect(
//RS     non_snake_case,
//RS     reason = "#804: shared Prelude symbols retain canonical Jet names"
//RS )]
//RS 
