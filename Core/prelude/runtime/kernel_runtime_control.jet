    fn begin() -> JetSharedTransaction { jet_shared_transaction_begin() }
}
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:157
trait __jet_Serialize { fn to_json(self) -> String }
// User rendering stays with this generated-program surface; key decoding has one owner.
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:172
impl JetShow for JetKey {
    fn jet_show(self) -> String {
        match self {
            .Char(c) -> format("Char({:?})", c)
            .Enter -> "Enter"
            .Escape -> "Escape"
            .Backspace -> "Backspace"
            .Tab -> "Tab"
            .Delete -> "Delete"
            .Up -> "Up"
            .Down -> "Down"
            .Left -> "Left"
            .Right -> "Right"
            .F(n) -> format("F({})", n)
            .Ctrl(c) -> format("Ctrl({:?})", c)
            .Unknown -> "Unknown"
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:192
impl JetDisplay for JetKey { fn jet_display(self) -> String { self.jet_show() } }
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:198
impl JetDebug for JetKey { fn jet_debug(self) -> String { self.jet_show() } }
