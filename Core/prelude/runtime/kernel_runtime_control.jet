// A guard consumes its non-boxed borrowed-capture callback once on every exit.
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:6
struct JetScopeGuard<F: FnOnce> { f: F? }
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:9
fn jet_scope_guard<F: FnOnce>(f: F) -> JetScopeGuard<F> { JetScopeGuard{f: Val(^f)} }
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:12
impl<F: FnOnce> Drop for JetScopeGuard<F> {
    fn drop(self: &JetScopeGuard<F>) -> { if self.f.take() is Val(f) { f() } }
}
// Transaction Drop runs commit hooks LIFO, or snapshots then rollback hooks LIFO.
// Unselected callback stacks are destroyed without invocation.
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:35
struct JetTransaction {
    hooks: [Box<fn() ->>]
    rollback_hooks: [Box<fn() ->>]
    snapshots: [Box<fn() ->>]
    committed: Bool
}
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:41
fn jet_transaction() -> JetTransaction { JetTransaction{hooks: [], rollback_hooks: [], snapshots: [], committed: false} }
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:49
impl JetTransaction {
    // Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:50
    fn on_commit(self: &JetTransaction, f: Box<fn() ->>) -> { self.hooks.push(^f) }
    // Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:53
    fn on_rollback(self: &JetTransaction, f: Box<fn() ->>) -> { self.rollback_hooks.push(^f) }
    // Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:56
    fn on_snapshot(self: &JetTransaction, f: Box<fn() ->>) -> { self.snapshots.push(^f) }
    // Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:59
    fn commit(self: &JetTransaction) -> { self.committed = true }
}
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:66
fn jet_transaction_on_commit(transaction: &JetTransaction, callback: Box<fn() ->>) -> { transaction.on_commit(^callback) }
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:71
fn jet_transaction_on_rollback(transaction: &JetTransaction, callback: Box<fn() ->>) -> { transaction.on_rollback(^callback) }
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:75
fn jet_transaction_commit(transaction: &JetTransaction) -> { transaction.commit() }
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:78
impl Drop for JetTransaction {
    fn drop(self: &JetTransaction) -> {
        if self.committed {
            while self.hooks.pop() is Val(f) { f() }
        } else {
            while self.snapshots.pop() is Val(f) { f() }
            while self.rollback_hooks.pop() is Val(f) { f() }
        }
    }
}
// The compiler chooses places. Each place outlives the later-declared guard,
// whose Drop restores pre-state before the place itself is destroyed.
// Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:106
module jet_txn {
    // Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:111
    // GATE #4565: kernel primitive — retained raw place pointer for lexical rollback.
    #Unsafe("caller guarantees the snapshotted place outlives the transaction guard")
    fn snapshot<T: Clone>(tx: &JetTransaction, place: &T) -> {
        saved :: place.clone()
        raw :: mem.Ptr<T>.from_ref(place)
        tx.on_snapshot(Box.new(fn() {
            #Unsafe("the transaction drops before the still-live snapshotted place") { _ :: raw.replace(^saved) }
        }))
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/RuntimeControl.rs:125
    #Unsafe("caller guarantees the custom-snapshot place outlives the transaction guard")
    fn snapshot_custom<T, S>(tx: &JetTransaction, place: &T, snap: S, restore: fn(&T, S) ->) -> {
        raw :: mem.Ptr<T>.from_ref(place)
        tx.on_snapshot(Box.new(fn() {
            #Unsafe("the transaction drops before the still-live custom-snapshot place") { restore(&raw.as_mut(), ^snap) }
        }))
    }
}
