//RS // Card 1984: `core.files.create_dir_all` had no resident host, so lowering's
//RS // registry projection missed and `io/files_depth` deopted. The Prelude makes
//RS // both rows the same operation — `jet_std_fs_create_dir` and
//RS // `jet_std_fs_create_dir_all` (Prelude/CoreLib/Top/Text.rs) both call
//RS // `std::fs::create_dir_all` behind the same `FS.Write` fault gate — so this
//RS // adapter marshals to the same call rather than inventing a second policy.
//RS fn jet_jit_fs_create_dir_all(path: i64) -> i64 {
//RS     jet_jit_fs_create_dir(path)
//RS }
