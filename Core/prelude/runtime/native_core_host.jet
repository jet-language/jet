//RS     let existed = entries
//RS         .iter()
//RS         .position(|(candidate, _)| jit_env_key_eq(candidate.as_os_str(), key))
//RS         .map(|old| entries.remove(old))
//RS         .is_some();
//RS     Ok(existed)
//RS }
