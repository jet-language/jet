//RS fn jet_jit_process_exit(code: i64) {
//RS     // Soft exit: record the code + trap so `resident_invoke` returns `Ran` with
//RS     // that exit status. Never terminate the resident host — that would kill
//RS     // the resident/test process (three-way battery, `jet serve`, …). The
//RS     // recorder writes BOTH fields (`set_explicit_exit`); writing `exit_code`
//RS     // here and then calling `set_trap` left `trapped` empty, so generated code
//RS     // sailed past every `emit_trap_check` and the program outlived its exit.
//RS     //
//RS     // D-FAIL-EXIT1: `os.atexit` runs after defer/scope-guard cleanup. Generated
//RS     // epilogues still run after this host returns, then `resident_invoke`
//RS     // drains the queue. Draining here printed atexit before guards.
//RS     Concurrency::with_runtime_mut(|rt| {
//RS         rt.set_explicit_exit(contract_kernel::jet_runtime_exit_code(code));
//RS     });
//RS }
