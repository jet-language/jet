//RS pub(crate) fn jit_env_snapshot_raw() -> JitEnvEntries {
//RS     jit_env_read().clone()
//RS }
//RS 
//RS // #2003 / D-ENV-MUTATE1: one raw-by-name read over Jet's logical environment
//RS // table, for every in-process engine. The resident JIT host (`IO.rs`), the
//RS // `core.sys` shims above, the extern "C" heap-ABI shims below and the
//RS // interpreter ambient (`ambient_interp`) all call THIS — an engine marshals
//RS // arguments and results, it never re-derives the lookup (I9). The AOT Prelude
//RS // keeps its own definition because generated programs do not link jet-jit; see
//RS // the comment on `jet_env_value_raw` in
//RS // `jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs`.
//RS //
//RS // Raw `OsString` on purpose: `NO_COLOR` counts by PRESENCE, so a value that is
//RS // not valid Unicode must still read as present. Decoding here would turn
//RS // "present but not UTF-8" into "absent" — the defect #1206's review caught in
//RS // AOT. Callers that need a `String` go through `jit_env_value`.
//RS pub(crate) fn jit_env_value_raw(name: &str) -> Option<std::ffi::OsString> {
//RS     let name = std::ffi::OsStr::new(name);
//RS     jit_env_read()
//RS         .iter()
//RS         .find(|(candidate, _)| jit_env_key_eq(candidate.as_os_str(), name))
//RS         .map(|(_, value)| value.clone())
//RS }
//RS 
//RS /// The decoding read behind `core.sys.get` (Prelude `jet_std_env_get`): a
//RS /// non-Unicode value reads as absent to a `String` caller.
//RS pub(crate) fn jit_env_value(name: &str) -> Option<String> {
//RS     jit_env_value_raw(name).and_then(|value| value.into_string().ok())
//RS }
//RS 
//RS /// The one write behind `core.sys.set` (Prelude `jet_std_env_set`): validate,
//RS /// drop any earlier spelling of the key, then append so the last spelling
//RS /// wins. Never touches the host process environment.
//RS pub(crate) fn jit_env_set(name: &str, value: &str) -> Result<(), &'static str> {
//RS     jit_env_validate_name(name)?;
//RS     jit_env_validate_value(value)?;
//RS     let key = std::ffi::OsString::from(name);
//RS     let mut entries = jit_env_write();
//RS     if let Some(old) = entries
//RS         .iter()
//RS         .position(|(candidate, _)| jit_env_key_eq(candidate.as_os_str(), key.as_os_str()))
//RS     {
//RS         entries.remove(old);
//RS     }
//RS     entries.push((key, std::ffi::OsString::from(value)));
//RS     Ok(())
//RS }
//RS /// Remove one key from the logical environment table, preserving the
//RS /// Prelude's validation and last-spelling-wins semantics.
//RS pub(crate) fn jit_env_unset(name: &str) -> Result<bool, &'static str> {
//RS     jit_env_validate_name(name)?;
//RS     let key = std::ffi::OsStr::new(name);
