// Rust: crates/jet-codegen/src/Prelude/Core.rs:2126
// Rich stops share one report shape with the generated harness.
fn jet_panic_rich_code(code: String, file: String, line: U32, fn_name: String, src_line: String, col: U32, caret_len: U32, msg: String, locals: String) -> Never {
    jet_test_record_stop(code)
    // GATE #4565: kernel primitive
    if #Unsafe("read current parallel worker's deferred-failure flag") { JET_PARA_DEFER_FAILURE.with(defer -> defer.get()) } {
        // GATE #4565: kernel primitive
        #Unsafe("resume native unwind carrying complete rich failure into parallel join") {
            panic.resume_unwind(Box.new(JetParaRuntimeFailure.Rich{code: code, file: file.to_string(), line: line, fn_name: fn_name.to_string(), src_line: src_line.to_string(), col: col, caret_len: caret_len, msg: msg.to_string(), locals: locals.to_string()}))
        }
    }
    jet_proof_record(2, 1, code, msg, file, line)
    _ :: jet_production_failure_receipt_write(code, file, line, fn_name)
    report :: jet_runtime_stop_report(code, file, line, fn_name, src_line, col, caret_len, msg, locals)
    if jet_runtime_should_unwind() -> jet_stream_record_failure_report(~report.rendered)
    jet_runtime_stop_unwind(^report.rendered, report.exit_code, msg)
}
// Rust: crates/jet-codegen/src/Prelude/Core.rs:2165
fn jet_panic_rich(file: String, line: U32, fn_name: String, src_line: String, col: U32, caret_len: U32, msg: String, locals: String) -> Never {
    jet_panic_rich_code("E3001", file, line, fn_name, src_line, col, caret_len, msg, locals)
}
// Rust: crates/jet-codegen/src/Prelude/Core.rs:2182
pub fn jet_test_failure_message(file: String, line: U32, fn_name: String, src_line: String, col: U32, caret_len: U32, msg: String, locals: String) -> String {
    if jet_testing_take_failure() is Val(failure) -> return jet_runtime_stop_report("E3001", file, line, fn_name, src_line, col, caret_len, failure.message, failure.detail).rendered
