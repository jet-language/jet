// Rust: crates/jet-codegen/src/Prelude/Core.rs:1686
fn jet_fixed_option<T>(result: JetFixedArithmeticResult, map: fn(I64) -> T) -> T? {
    match result { .Value(value) -> Val(map(value)), .Absent | .Trap(_) -> None }
}

