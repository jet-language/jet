package {
    name: "core.prelude"
    version: "0.0.1"
    edition: "2026"
    description: "Always-imported identity and scalar helpers."
    license: "MIT"
    outputs: {
        prelude: .Library{ entry: prelude }
    }
}

// core.prelude contains only total value helpers.  `keep` is the compiler's
// identity/use-site barrier; every other declaration is an ordinary Jet
// function with the same value in and value out.
pub fn keep<T>(value: T) -> T Never! { value }

pub fn identity(value: ^String) -> String Never! { value }

pub fn always(value: Bool) -> Bool Never! { value }

pub fn identity_int(value: Int) -> Int Never! { value }

pub fn identity_float(value: Float) -> Float Never! { value }

pub fn identity_bool(value: Bool) -> Bool Never! { value }

pub fn const_int(value: Int, ignored: Int) -> Int Never! {
    _ :: ignored
    value
}

pub fn const_bool(value: Bool, ignored: Bool) -> Bool Never! {
    _ :: ignored
    value
}

pub fn not_bool(value: Bool) -> Bool Never! {
    if value -> return false
    true
}

pub fn min_int(a: Int, b: Int) -> Int Never! {
    if a <= b -> return a
    b
}

pub fn max_int(a: Int, b: Int) -> Int Never! {
    if a >= b -> return a
    b
}
