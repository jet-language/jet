package: {
    name: "core.event"
    version: "0.0.1"
    edition: "2026"
    description: "Typed events, hooks, and scheduler-backed dispatch."
    license: "MIT"
    outputs: {
        event: .Library{ entry: event }
    }
}

use {
    core: core
    builtin: jet_builtins
    rt: jet.runtime.event
    core.event.[Event]
}

// The runtime's event provider reports and reads these cases by position,
// so each enum keeps the provider's order.

/// What an async event does when its queue is full.
Overflow: enum {
    Block,
    DropNewest,
    DropOldest,
}

/// Queue capacity and overflow policy for an async event.
AsyncPolicy: struct {
    capacity: Int,
    overflow: Overflow,
}

/// How an async event treats a handler's failure.
FailurePolicy: enum {
    StopFirst,
    Collect,
    Log,
    Ignore,
}

/// How a decision hook combines its handlers' decisions.
HookPolicy: enum {
    FirstCancelElseTransform,
}

/// What became of one dispatched event.
DispatchState: enum {
    Delivered,
    HandlerFailed,
    DroppedNewest,
    DroppedOldest,
    Closed,
    Canceled,
    DeadlineExceeded,
}

/// Why an async event could not be built: its capacity is not positive.
#Error
EventConfigError: enum {
    InvalidCapacity,
}

// The provider owns listener cells, lifecycle and scheduler identities.
// Source owns constructor composition and rejects invalid async capacities
// before allocating provider state.

scope: fn() -> EventScope Never! { rt.scope_new() }

new: fn<T>() -> Event<T> Never! { with_policy<T>(policy_sync()) }

with_policy: fn<T>(policy: EventPolicy) -> Event<T> Never! { event_make<T>(policy) }

hook: fn<T, R>(fallback: R) -> Hook<T, R> Never! { hook_make<T, R>(fallback) }

decision_hook: fn<T, E>(policy: HookPolicy) -> DecisionHook<T, E> Never! {
    decision_hook_make<T, E>(policy)
}

// The provider's constructors. The compiler builds each call as the
// provider's, handed the descriptors of the call's type arguments (Build.jet
// IR_CORE_INTRINSICS); a body only names that operation.
#Builtin.Role(.InlineEventWithPolicy) priv event_make: fn<T>(policy: EventPolicy) -> Event<T> Never! {
    event_make<T>(policy)
}

#Builtin.Role(.InlineHookNew) priv hook_make: fn<T, R>(fallback: R) -> Hook<T, R> Never! {
    hook_make<T, R>(fallback)
}

#Builtin.Role(.InlineDecisionHookNew) priv decision_hook_make: fn<T, E>(policy: HookPolicy) -> DecisionHook<T, E> Never! {
    decision_hook_make<T, E>(policy)
}

// An AsyncEvent under a policy whose capacity the caller checked.
#Builtin.Role(.InlineAsyncEventNew) priv async_event_make: fn<T, E>(policy: AsyncPolicy, failures: FailurePolicy) -> AsyncEvent<T, E> Never! {
    async_event_make<T, E>(policy, failures)
}

// A declared point: a module binding whose whole value calls one of these
// names a typed extension point, and the binding is its identity. The
// program makes its carrier at the first read, once, and every read shares
// it. The call is valid only as a module binding's value, where the compiler
// finds it by its jet_builtins role; the bodies make the same carriers
// `new`, `hook` and `decision_hook` make.

/// A declared event point: `clicked: event.point<Int>()`.
#Builtin.Role(.EventPoint) point: fn<T>() -> Event<T> Never! { with_policy<T>(policy_sync()) }

/// A declared hook point, which returns `fallback` when nothing handles it.
#Builtin.Role(.HookPoint) hook_point: fn<T, R>(fallback: R) -> Hook<T, R> Never! {
    hook_make<T, R>(fallback)
}

/// A declared decision point, whose handlers' decisions `policy` combines.
#Builtin.Role(.DecisionPoint) decision_point: fn<T, E>(policy: HookPolicy) -> DecisionHook<T, E> Never! {
    decision_hook_make<T, E>(policy)
}

policy_sync: fn() -> EventPolicy Never! { rt.policy_sync() }

async_result: fn<T, E>(policy: AsyncPolicy, failures: FailurePolicy) -> AsyncEvent<T, E> EventConfigError! {
    if policy.capacity <= 0 -> return Err(EventConfigError.InvalidCapacity)
    async_event_make<T, E>(policy, failures)
}

#Test("async constructors reject zero and negative capacities before allocation") {
    capacities: [Int]{0, -1, -9223372036854775808}
    loop capacity in capacities {
        policy: AsyncPolicy{capacity: capacity, overflow: Overflow.Block}
        if async_result<Int, String>(policy, FailurePolicy.Collect) == {
            .Err(.InvalidCapacity) -> {}
            .Ok(_) -> panic("capacity {capacity} must refuse with InvalidCapacity")
        }
    }
}
