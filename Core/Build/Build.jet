/// The checked graph of `plan`, as the build host projects it. Only build and
/// compile-time code hold a BuildPlan, and only there does the host answer.
#Import(jet.build, symbol: "BuildPlan.graph")
graph: fn(plan: BuildPlan) -> BuildGraph Never!

/// Compare two checked graph projections without reading source files or
/// making cache policy decisions.  All deltas are ordered lexicographically;
/// action keys compare recipe identity, while affected files follow changed
/// actions through declared outputs, consumers, and target dependencies.
receipt_diff: fn(before: BuildGraph, after: BuildGraph) -> BuildGraphDiff Never! {
    if !valid_graph(before) || !valid_graph(after) {
        panic("core.build.receipt_diff requires canonical BuildGraph values")
    }

    file_deltas: diff_files(before, after)
    ^action_names: [String]{}
    loop action in before.actions -> append_unique(action_names, action.name)
    loop action in after.actions -> append_unique(action_names, action.name)
    action_names.sort()

    ^key_deltas: [BuildGraphKeyDelta]{}
    ^cache_deltas: [BuildGraphCacheDelta]{}
    ^changed_actions: [String]{}
    loop name in action_names {
        before_action: find_action_name(before, name)
        after_action: find_action_name(after, name)
        if action_changed(before_action, after_action) -> append_unique(changed_actions, name)

        before_key: action_key(before_action)
        after_key: action_key(after_action)
        if before_key != after_key {
            key_deltas.push(BuildGraphKeyDelta{action: name.copy(), before: before_key, after: after_key})
        }

        before_hit: action_cache_hit(before_action)
        after_hit: action_cache_hit(after_action)
        if before_hit != after_hit {
            cache_deltas.push(BuildGraphCacheDelta{action: name.copy(), before: before_hit, after: after_hit})
        }
    }

    ^affected: affected_files(before, changed_actions)
    loop path in affected_files(after, changed_actions) -> append_unique(affected, path)
    affected.sort()
    return {
        file_deltas: file_deltas,
        affected_files: affected,
        key_deltas: key_deltas,
        cache_deltas: cache_deltas,
    }
}

diff_files: fn(before: BuildGraph, after: BuildGraph) -> [BuildGraphFileDelta] {
    ^paths: [String]{}
    loop file in before.files -> append_unique(paths, file.path)
    loop file in after.files -> append_unique(paths, file.path)
    paths.sort()

    ^out: [BuildGraphFileDelta]{}
    loop path in paths {
        before_file: find_file(before.files, path)
        after_file: find_file(after.files, path)
        if file_identity(before, before_file) != file_identity(after, after_file) {
            out.push(BuildGraphFileDelta{path: path, before: before_file, after: after_file})
        }
    }
    out
}

affected_files: fn(graph: BuildGraph, changed_actions: [String]) -> [String] {
    ^pending_actions: [String]{}
    loop action in graph.actions {
        if contains_string(changed_actions, action.name) {
            append_unique(pending_actions, action.name)
        }
    }
    ^pending_targets: [Int]{}
    ^seen_actions: [String]{}
    ^seen_targets: [Int]{}
    ^affected: [String]{}
    ^action_index: 0
    ^target_index: 0

    loop action_index < pending_actions.len() || target_index < pending_targets.len() {
        loop action_index < pending_actions.len() {
            action_name: pending_actions[action_index]
            action_index += 1
            if contains_string(seen_actions, action_name) -> next
            append_unique(seen_actions, action_name)
            action: find_action_name(graph, action_name) ?? next
            loop output in action.outputs {
                append_unique(affected, output)
                file: find_file(graph.files, output) ?? next
                loop consumer_id in file.consumers {
                    consumer: find_action_id(graph, consumer_id)
                    if consumer != .None {
                        consumer_action: consumer
                        append_unique(pending_actions, consumer_action.name)
                    }
                }
            }
            loop target in graph.targets {
                if contains_int(target.actions, action.id) {
                    append_unique_int(pending_targets, target.id)
                }
            }
        }

        loop target_index < pending_targets.len() {
            target_id: pending_targets[target_index]
            target_index += 1
            if contains_int(seen_targets, target_id) -> next
            append_unique_int(seen_targets, target_id)
            loop target in graph.targets {
                if contains_int(target.deps, target_id) {
                    loop action_id in target.actions {
                        action: find_action_id(graph, action_id)
                        if action != .None {
                            named: action
                            append_unique(pending_actions, named.name)
                        }
                    }
                    append_unique_int(pending_targets, target.id)
                }
            }
        }
    }
    affected
}

file_identity: fn(graph: BuildGraph, file: BuildGraphFile?) -> String {
    current: file ?? return "<missing>"
    ^owner: ""
    if current.owner != .None {
        owner_id: current.owner ?? -1
        owner = action_name(graph, owner_id)
    }
    ^consumers: [String]{}
    loop id in current.consumers {
        name: action_name(graph, id)
        if name != "" -> append_unique(consumers, name)
    }
    consumers.sort()
    ^targets: [String]{}
    loop id in current.targets {
        name: target_name(graph, id)
        if name != "" -> append_unique(targets, name)
    }
    targets.sort()
    "{owner}|{consumers.join(",")}|{targets.join(",")}"
}

action_changed: fn(before: BuildGraphAction?, after: BuildGraphAction?) -> Bool {
    if before == .None || after == .None -> return true
    left: before ?? return true
    right: after ?? return true
    left.key != right.key || left.inputs != right.inputs
}

action_key: fn(action: BuildGraphAction?) -> String? {
    value: action ?? return None
    Val(value.key)
}

action_cache_hit: fn(action: BuildGraphAction?) -> Bool? {
    value: action ?? return None
    value.cache_hit
}

find_action_name: fn(graph: BuildGraph, name: String) -> BuildGraphAction? {
    loop action in graph.actions {
        if action.name == name -> return Val(action)
    }
    None
}

find_action_id: fn(graph: BuildGraph, id: Int) -> BuildGraphAction? {
    loop action in graph.actions {
        if action.id == id -> return Val(action)
    }
    None
}

find_file: fn(files: [BuildGraphFile], path: String) -> BuildGraphFile? {
    loop file in files {
        if file.path == path -> return Val(file)
    }
    None
}

action_name: fn(graph: BuildGraph, id: Int) -> String {
    action: find_action_id(graph, id) ?? return ""
    action.name
}

target_name: fn(graph: BuildGraph, id: Int) -> String {
    loop target in graph.targets {
        if target.id == id -> return target.name
    }
    ""
}

valid_graph: fn(graph: BuildGraph) -> Bool {
    if graph.targets.len() > BUILD_MAX_TARGETS || graph.actions.len() > BUILD_MAX_ACTIONS || graph.files.len() > BUILD_MAX_FILES || graph.nodes.len() > BUILD_MAX_NODES {
        return false
    }

    ^target_ids: [Int]{}
    ^target_names: [String]{}
    loop target in graph.targets {
        if target.id < 0 || !valid_graph_text(target.name, 1024) -> return false
        if contains_int(target_ids, target.id) || contains_string(target_names, target.name) {
            return false
        }
        target_ids.push(target.id)
        target_names.push(target.name.copy())
        if target.deps.len() > BUILD_MAX_TARGETS || target.actions.len() > BUILD_MAX_ACTIONS || target.files.len() > BUILD_MAX_FILES {
            return false
        }
        loop path in target.files {
            if !valid_graph_path(path) -> return false
        }
    }

    ^action_ids: [Int]{}
    ^action_names: [String]{}
    loop action in graph.actions {
        if action.id < 0 || !valid_graph_text(action.name, 1024) -> return false
        if contains_int(action_ids, action.id) || contains_string(action_names, action.name) {
            return false
        }
        action_ids.push(action.id)
        action_names.push(action.name.copy())
        if action.inputs.len() > BUILD_MAX_FILES || action.outputs.len() > BUILD_MAX_FILES {
            return false
        }
        loop path in action.inputs {
            if !valid_graph_path(path) -> return false
        }
        loop path in action.outputs {
            if !valid_graph_path(path) -> return false
        }
        loop cap in action.caps {
            if !valid_graph_text(cap, 128) -> return false
        }
        loop pool in action.pools {
            if !valid_graph_text(pool, 128) -> return false
        }
        if action.target != .None {
            target_id: action.target ?? -1
            if !contains_int(target_ids, target_id) -> return false
        }
    }

    ^file_paths: [String]{}
    loop file in graph.files {
        if !valid_graph_path(file.path) || contains_string(file_paths, file.path) -> return false
        file_paths.push(file.path.copy())
        if file.owner != .None {
            owner_id: file.owner ?? -1
            if !contains_int(action_ids, owner_id) -> return false
        }
        loop consumer_id in file.consumers {
            if !contains_int(action_ids, consumer_id) -> return false
        }
        loop target_id in file.targets {
            if !contains_int(target_ids, target_id) -> return false
        }
    }

    loop target in graph.targets {
        loop dep_id in target.deps {
            if !contains_int(target_ids, dep_id) -> return false
        }
        loop action_id in target.actions {
            if !contains_int(action_ids, action_id) -> return false
        }
    }

    loop action_key in graph.action_keys {
        if !valid_graph_text(action_key.action, 1024) || !valid_graph_text(action_key.key, 1024) {
            return false
        }
        if !contains_string(action_names, action_key.action) -> return false
    }

    loop cached in graph.cache_hits {
        if cached.id < 0 || !valid_graph_text(cached.name, 1024) -> return false
        if !contains_int(action_ids, cached.id) || !contains_string(action_names, cached.name) {
            return false
        }
    }

    ^affected_paths: [String]{}
    loop file in graph.affected_files {
        if !valid_graph_path(file.path) || contains_string(affected_paths, file.path) {
            return false
        }
        affected_paths.push(file.path.copy())
    }

    loop node in graph.nodes {
        if !valid_graph_text(node.kind, 128) || !valid_graph_text(node.key, 1024) || !valid_graph_text(node.subject, 4096) {
            return false
        }
        if node.inputs.len() > BUILD_MAX_FILES || node.input_digests.len() > BUILD_MAX_FILES {
            return false
        }
        loop path in node.inputs {
            if !valid_graph_path(path) -> return false
        }
        loop digest in node.input_digests {
            if !valid_graph_text(digest.name, 4096) || !valid_graph_text(digest.digest, 1024) {
                return false
            }
        }
    }
    true
}

valid_graph_path: fn(value: String) -> Bool { valid_graph_text(value, 4096) }

valid_graph_text: fn(value: String, max: Int) -> Bool {
    if value == "" || value.len() > max -> return false
    loop byte in value.bytes() {
        n: Int{byte}
        if n < 32 || n == 127 -> return false
    }
    true
}

contains_string: fn(values: [String], value: String) -> Bool {
    loop item in values {
        if item == value -> return true
    }
    false
}

contains_int: fn(values: [Int], value: Int) -> Bool {
    loop item in values {
        if item == value -> return true
    }
    false
}

append_unique: fn(values: ^[String], value: String) {
    if !contains_string(values, value) -> values.push(value.copy())
}

append_unique_int: fn(values: ^[Int], value: Int) {
    if !contains_int(values, value) -> values.push(value)
}
