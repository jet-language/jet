#Import(jet.build, symbol: "Build.error")
priv __build_error: fn(b: Build, at: SourceLocation, span: SourceSpan, code: String, what: String, why: String, fix: String) Never!

#Import(jet.build, symbol: "Build.default")
priv __build_default: fn(b: Build, at: SourceLocation, target: BuildTarget) Never!

#Import(jet.build, symbol: "Build.compiler")
