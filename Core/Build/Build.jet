#Import(jet.build, symbol: "Build.add_test")
priv __build_add_test: fn(b: Build, at: SourceLocation, name: String, sources: [String], actions: [BuildStepHandle], deps: [BuildTarget], probes: [BuildProbe], toolchain: BuildToolchain?, signing: BuildSigningIdentity?) -> BuildTarget BuildError!

#Import(jet.build, symbol: "Build.add_asset_bundle")
priv __build_add_asset_bundle: fn(b: Build, at: SourceLocation, name: String, sources: [String], actions: [BuildStepHandle], deps: [BuildTarget], probes: [BuildProbe], toolchain: BuildToolchain?, signing: BuildSigningIdentity?) -> BuildTarget BuildError!

#Import(jet.build, symbol: "Build.add_doc")
priv __build_add_doc: fn(b: Build, at: SourceLocation, name: String, sources: [String], actions: [BuildStepHandle], deps: [BuildTarget], probes: [BuildProbe], toolchain: BuildToolchain?, signing: BuildSigningIdentity?) -> BuildTarget BuildError!

#Import(jet.build, symbol: "Build.add_install")
priv __build_add_install: fn(b: Build, at: SourceLocation, name: String, sources: [String], actions: [BuildStepHandle], deps: [BuildTarget], probes: [BuildProbe], toolchain: BuildToolchain?, signing: BuildSigningIdentity?) -> BuildTarget BuildError!

#Import(jet.build, symbol: "Build.add_package")
priv __build_add_package: fn(b: Build, at: SourceLocation, name: String, sources: [String], actions: [BuildStepHandle], deps: [BuildTarget], probes: [BuildProbe], toolchain: BuildToolchain?, signing: BuildSigningIdentity?) -> BuildTarget BuildError!

#Import(jet.build, symbol: "Build.add_publish")
priv __build_add_publish: fn(b: Build, at: SourceLocation, name: String, sources: [String], actions: [BuildStepHandle], deps: [BuildTarget], probes: [BuildProbe], toolchain: BuildToolchain?, signing: BuildSigningIdentity?) -> BuildTarget BuildError!

#Import(jet.build, symbol: "Build.toolchain")
priv __build_toolchain: fn(b: Build, at: SourceLocation, name: String, target: String, host: String, sdk: String?, linker: String?, sysroot: String?) -> BuildToolchain BuildError!

#Import(jet.build, symbol: "Build.signing")
priv __build_signing: fn(b: Build, at: SourceLocation, name: String, label: String) -> BuildSigningIdentity BuildError!

#Import(jet.build, symbol: "Build.probe")
priv __build_probe: fn(b: Build, at: SourceLocation, name: String, kind: String, value: String, code: String?, reproducibility: String?, toolchain: BuildToolchain?) -> BuildProbe BuildError!

#Import(jet.build, symbol: "Build.run")
priv __build_run: fn(b: Build, at: SourceLocation, name: String, tool: BuildFile, effects: [String]) -> BuildStepHandle BuildError!

#Import(jet.build, symbol: "Build.action")
priv __build_action: fn(b: Build, at: SourceLocation, step: BuildAction) -> BuildStepHandle BuildError!

#Import(jet.build, symbol: "Build.found")
priv __build_found: fn(b: Build, at: SourceLocation, probe: BuildProbe) -> BuildFile Never!

#Import(jet.build, symbol: "Build.host")
priv __build_host: fn(b: Build, at: SourceLocation, target: BuildTarget) -> BuildFile Never!

#Import(jet.build, symbol: "Build.image")
priv __build_image: fn(b: Build, at: SourceLocation, target: BuildTarget) -> BuildFile Never!

#Import(jet.build, symbol: "Build.jet")
priv __build_jet: fn(b: Build, at: SourceLocation) -> BuildFile Never!

#Import(jet.build, symbol: "Build.jet_built_from")
priv __build_jet_built_from: fn(b: Build, at: SourceLocation, target: BuildTarget) -> BuildFile Never!

#Import(jet.build, symbol: "Build.source_key")
priv __build_source_key: fn(b: Build, at: SourceLocation) -> String Never!

#Import(jet.build, symbol: "Build.dependency")
priv __build_dependency: fn(b: Build, at: SourceLocation, name: String) -> BuildFile Never!

#Import(jet.build, symbol: "Build.folder")
