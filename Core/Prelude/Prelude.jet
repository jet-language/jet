package: {
    name: "core.prelude"
    version: "0.0.1"
    edition: "2026"
    description: "Always-imported identity and scalar helpers."
    license: "MIT"
    outputs: {
        prelude: .Library{ entry: prelude }
    }
}

use {
    core: core
    builtin: jet_builtins
}

// The number families: one generic definition per number
// kind, over the compiler's storage, and only standard sizes. These names
// resolve like any other, so a program's own `Signed` shadows them. Applied
// to a standard size, a family is the compiler's own type for it, so
// `Unsigned<8>` and `U8` are one type, every report shows `U8`, and
// `Unsigned<24>` is E0314.
Signed: struct<bits: Int> {
    raw: builtin.Word<bits>,
}

Unsigned: struct<bits: Int> {
    raw: builtin.Word<bits>,
}

IEEE: struct<exponent: Int, fraction: Int> {
    raw: builtin.FloatWord<exponent, fraction>,
}

// The size names. Each is an alias of one family size, and the compiler
// reads its spellings from these lines (FOUNDATION_SIZE_ALIASES), so a file
// that declares, imports or takes as a type parameter a name of its own
// spelled like one keeps its own.
I8: Signed<8>

I16: Signed<16>

I32: Signed<32>

I64: Signed<64>

U8: Unsigned<8>

U16: Unsigned<16>

U32: Unsigned<32>

U64: Unsigned<64>

F32: IEEE<8, 23>

F64: IEEE<11, 52>

// `keep` is the compiler's identity/use-site barrier. The other helpers,
// including the optional-to-failure view, are ordinary reachable Jet bodies.
keep: fn<T>(value: T) -> T Never! { value }

identity: fn(value: ^^String) -> String Never! { value }

always: fn(value: Bool) -> Bool Never! { value }

identity_int: fn(value: Int) -> Int Never! { value }

identity_float: fn(value: Float) -> Float Never! { value }

identity_bool: fn(value: Bool) -> Bool Never! { value }

const_int: fn(value: Int, ignored: Int) -> Int Never! {
    _: ignored
    value
}

const_bool: fn(value: Bool, ignored: Bool) -> Bool Never! {
    _: ignored
    value
}

not_bool: fn(value: Bool) -> Bool Never! {
    if value -> return false
    true
}

// `min`, `max` and `clamp` are prelude names (no import) over any one ordered
// type: Int and the sized integers, Float/F32, Decimal, Duration, Instant,
// String, Char, or a type that implements Comparable. They order by
// `compare`, so Floats follow IEEE 754 totalOrder (-NaN < -inf < ... < -0.0 <
// +0.0 < ... < +inf < NaN). Among equal values the first argument wins.
min: fn<T: Comparable>(a: T, b: T, rest: ...T) -> T Never! {
    ^best: a
    if b.compare(best) == .Less -> best = b
    loop value in rest {
        if value.compare(best) == .Less -> best = value
    }
    best
}

max: fn<T: Comparable>(a: T, b: T, rest: ...T) -> T Never! {
    ^best: a
    if b.compare(best) == .Greater -> best = b
    loop value in rest {
        if value.compare(best) == .Greater -> best = value
    }
    best
}

// Reversed bounds are accepted: `clamp(x, 10, 0)` clamps to `0..=10`.
clamp: fn<T: Comparable>(x: T, lo: T, hi: T) -> T Never! {
    if hi.compare(lo) == .Less {
        if x.compare(hi) == .Less -> return hi
        if x.compare(lo) == .Greater -> return lo
        return x
    }
    if x.compare(lo) == .Less -> return lo
    if x.compare(hi) == .Greater -> return hi
    x
}

// The caller materializes the receiver and then `why`,
// even when the payload is present. Own those evaluated values, not a later
// read of the caller's optional. Construct an Err only for clean absence.
option_or_err: fn<T>(value: ^^T?, why: ^^String) -> T Err! {
    return if value == {
        .Val(payload) -> Ok(payload)
        .None -> Err(why)
    }
}

// Where source sits: `#here` is the place it is written, and a parameter
// default `at: SourceLocation{#caller}` is the place of each call that leaves
// `at` out. The compiler fills the fields; displays as `file:line:column`.
// `module` is the dotted module of the place: the package's name, then the
// `name: module` declarations that reach the file, then any inline modules
// around it (`shop.cache`); a file no declaration reaches is the package
// root (`shop`). "" only in a value built by hand and in a `context.trace`
// record, whose location table names no module (and no column: 0).
SourceLocation: struct {
    file: String,
    line: Int,
    column: Int,
    function: String,
    module: String{""},

    impl Display {
        display: fn(self) -> String { "{self.file}:{self.line}:{self.column}" }
    }
}

// What a debugger shows for a value of a type that implements it, in place
// of the type's fields: one item a row, each a label and its value's text. A
// ring buffer lists its items in order rather than its storage and indices.
// A build with debug information keeps every implementation, so `jet debug`
// calls it on the stopped program's own value. It can't fail, so the
// debugger calls it as the program calls an infallible method.
DebugView: trait {
    debug_view: fn(self) -> [DebugItem] Never!,
}

// One row of a DebugView: the text before the colon, and the text after it.
DebugItem: struct {
    label: String,
    value: String,
}

// Errors with two audiences: `public()` returns caller-safe text that never
// exposes causes, file paths, stack or guest trap frames, SQL queries, internal
// addresses, OS error codes, or secret values; `detail()` returns the full
// operator-facing diagnostic text including any cause chain. Every Core boundary
// (HTTP, CLI, jobs, MCP tool results) chooses `public()` for external callers
// and records/logs `detail()` for operators.
Describe: trait {
    public: fn(self) -> String Never!,
    detail: fn(self) -> String Never!,
}

// A type as a value. Where a `Type` is expected a type name is one
// (`counts[Position] = 2`, `if t == { Position -> … }`); `Type{Rock}` names
// one explicitly, and `type_of(p)` is the static type of a name or field
// path, read without evaluating it. Two values are equal exactly when they
// name one type, generic arguments included (`Box<Int>` is not
// `Box<String>`), so a `Type` keys a map. It displays its path, each declared
// type qualified by its module (`shop.Box<Int>`). Inside a generic body
// `Type{V}` names the type each instance fills `V` with, equal to that
// type's written `Type{…}`. Only the compiler builds one: no text becomes a
// `Type`, and nothing casts through it.
Type: struct {
    priv path: String,

    impl Display {
        display: fn(self) -> String { "{self.path}" }
    }
}

// One stored field of `Model`, whose type is `T`. Where a `FieldRef<M, T>` is
// expected, a bare `.name` is one: `form.validate(.carrier, …)` names
// `M`'s field `carrier`, a name `M` doesn't declare is a build error at the
// dot, and `T` is that field's type. Only the compiler builds one: no text
// becomes a `FieldRef`. A library reads the field's name with `name()`.
FieldRef: struct<Model, T> {
    priv name: String,

    // The field's name, as `Model` declares it.
    name: fn(self) -> String Never! { self.name }
}

// A send the channel refused: its receiving end is gone, or the sending task
// was canceled while it waited. `value` is the payload, handed back unsent,
// so `tx.send(job) ?? retry(err.value)` keeps the job. A program never has to
// spell it: `tx.send(v)` fails with `SendError<T>` for the channel's `T`, and
// passes it up as the default `Err` like any Core error.
#Error
SendError: struct<T> {
    value: T,

    impl Describe {
        public: fn(self) -> String Never! { "Channel is closed." }

        detail: fn(self) -> String Never! { "send on a closed channel" }
    }
}

// How a task's join fails: the task was canceled, ran past its deadline, or
// stopped on a failure it did not handle, with that failure's text. It lives
// in the prelude because every program can reach it without naming it: a
// join (`h.join()`, `task.all`, a group) fails with it, and the runtime's
// scheduler builds it by its position. A `!` contract may name it, but it is
// not in the standard error family: no conversion takes it to `Err`.
#Error
TaskFailure: enum {
    Canceled,
    DeadlineBlown,
    Panicked(String),

    impl Describe {
        public: fn(self) -> String Never! {
            if self == {
                .Canceled -> "Request was canceled."
                .DeadlineBlown -> "Request timed out."
                .Panicked(_) -> "An internal error occurred."
            }
        }

        detail: fn(self) -> String Never! {
            if self == {
                .Canceled -> "task canceled"
                .DeadlineBlown -> "task deadline exceeded"
                .Panicked(message) -> "task panicked: {message}"
            }
        }
    }
}

// Why a text did not parse as a number: `Int.parse`, `Float.parse`,
// `Int.from_radix` and `String.to_int` fail with it, its message the reason
// ("cannot parse `x` as an integer"). It lives in the prelude because a
// program reaches it without naming it, yet may name it: a `??` handler can
// pass `err` on to a `fn(err: ParseError)`, show it with `{err}` or
// `{err:Debug}`, or read `err.message`.
#Error
ParseError: struct {
    message: String,

    impl Display {
        display: fn(self) -> String { self.message.copy() }
    }

    impl Describe {
        public: fn(self) -> String Never! { "Invalid numeric input." }

        detail: fn(self) -> String Never! { self.message.copy() }
    }
}

impl Err.Describe {
    public: fn(self) -> String Never! {
        if self.code == .Val(code) {
            raw: code.bytes()
            if raw.len() > 0 && raw.len() <= 64 {
                ^safe: true
                loop byte in raw {
                    n: Int{byte}
                    ok: (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 95 || n == 45
                    if !ok {
                        safe = false
                        break
                    }
                }
                if safe -> return "Request failed ({code})."
            }
        }
        "An internal error occurred."
    }

    detail: fn(self) -> String Never! {
        head: if self.code == .Val(code) && code.bytes().len() > 0 -> "[{code}] {self.message}" else -> "{self.message}"
        if self.cause == .Val(inner) {
            return "{head}\ncaused by: {inner.detail()}"
        }
        head
    }
}

impl IOError.Describe {
    public: fn(self) -> String Never! {
        if self == {
            .InvalidInput(_) -> "Invalid input."
            .NotFound(_) -> "Resource not found."
            .PermissionDenied(_) -> "Permission denied."
            .TimedOut(_) -> "Operation timed out."
            .Canceled(_) -> "Operation canceled."
            .Closed(_) -> "Resource is closed."
            .AlreadyExists(_) -> "Resource already exists."
            .Unsupported(_) -> "Operation is not supported."
            .ResourceLimit(_) -> "Resource limit exceeded."
            .Protocol(_) | .Other(_) -> "An I/O error occurred."
        }
    }

    detail: fn(self) -> String Never! { "{self}" }
}

impl RangeError.Describe {
    public: fn(self) -> String Never! { "Value out of range." }

    detail: fn(self) -> String Never! { self.reason.copy() }
}

impl TextError.Describe {
    public: fn(self) -> String Never! { "Invalid text format." }

    detail: fn(self) -> String Never! { self.message.copy() }
}

impl UTF8Error.Describe {
    public: fn(self) -> String Never! { "Invalid UTF-8 text." }

    detail: fn(self) -> String Never! { self.message.copy() }
}

// What a `CheckedText` type's `check` learned from a literal's parts:
// `shape`, computed once while building and handed to `build`, and one slot
// per hole, the kind of position the hole sits in, handed to `encode_hole`
// (Core/prelude.jet). A program reaches it without naming it: every checked
// text literal runs a `check` that returns one.
Checked: struct<Shape, Slot> {
    shape: Shape,
    slots: [Slot],
}

// The one slot of a `CheckedText` type that declares no `Slot`: every hole
// is text.
TextSlot: enum {
    Text,
}

// The phase of the compiled copy an expression runs in: `#phase` is
// `.Preparation` in preparation and compile-time code and in a function's
// compile-time copy, `.Build` in the copy a package's `fn build` runs, and
// `.Runtime` in the running program. Each copy folds its own phase, never the
// optimizer: the same copy reads the same phase on every tier.
Phase: enum {
    Preparation,
    Build,
    Runtime,
}

// A reflected enum case's payload: none, one unnamed value of a type, or its
// named fields in declaration order. It lives in the prelude because every
// program can reach it without naming it: a reflected `CaseInfo` holds one,
// and its layout comes from this declaration.
CasePayload: enum {
    Unit,
    Single(TypeId),
    Named([FieldInfo]),
}

// What a type is, as its TypeId reads it (`T.reflect().identity.kind`): a
// named type's declaration kind, or the shape of a constructed one. A
// number's kind says whether it is signed and whether it is a float; its
// width is its `bits` generic binding. It lives in the prelude because every
// program can reach it without naming it: each reflected TypeId holds one.
TypeKind: enum {
    Struct,
    Enum,
    Trait,
    Distinct,
    Builtin,
    Number(signed: Bool, float: Bool),
    List,
    Map,
    Option,
    Result,
    Shared,
    Tuple,
    Function,
    FixedList,
    Range,
    Quantity,
    Union,
    TraitObject,
}

// A finding the compiler or a package reports, and the only carrier of one.
// An error type is a struct whose fields are the holes of its texts; its impl
// gives each text as one string literal that reads only `self` fields, so
// `jet explain` can print it without running code. `reject(value)` raises one
// while compiling. The constants are the registry columns, and each has a
// default.
Diagnostic: trait {
    // The report's code. None: the type's path, such as `web.BadPath`.
    code: String?{None},
    severity: Severity{.Error},
    // Which commands the finding fails.
    tier: DiagnosticTier{.Error},
    // The name `#Allow` and lint policy use; a `.Lint` diagnostic needs one.
    lint_name: String?{None},
    // The pipeline stages that report it.
    stage: [DiagnosticStage]{[.Sema]},
    moment: DiagnosticMoment{.Compile},
    status: DiagnosticStatus{.Active},
    // A one-line summary. None: the `what` text.
    meaning: String?{None},
    // Whether `jet explain` prints the what, why and fix texts in full.
    detail: Bool{false},
    // The machine edit `jet fix` applies, if any. The `fix` text stays the
    // help a reader follows by hand.
    structured_fix: DiagnosticEdit?{None},
    // Why no machine edit can apply. None: an edit applies, or none is classified.
    no_fix: DiagnosticNoFix?{.Design},
    // The next step without a machine edit. None: the `fix` text.
    fix_next: String?{None},
    fix_safety: DiagnosticFixSafety?{None},
    // Whether `jet fmt` applies the fix while formatting, so a source whose
    // only parse errors are such rows is rewritten, not refused.
    fmt_applies_fix: Bool{false},
    // Why an error refuses the program: `.Soundness` or `.Opinion`. None:
    // not yet classified.
    safety_class: DiagnosticSafetyClass?{None},
    // One line: the fault accepting the program could cause, or why it would
    // run safely.
    safety_reason: String?{None},
    // A `.Soundness` error's way out for an expert: the opt-in that reaches
    // the same program, or `none: ` and why nothing can.
    expert_path: String?{None},
    what: fn(self) -> String,
    why: fn(self) -> String,
    fix: fn(self) -> String,
}

// Which commands a finding fails. An `.Error` fails every command. A `.Tidy`
// error is about untidy code that still runs: `jet check` and `jet build`
// list it and fail, while `jet run`, `jet dev` and `jet test` never stop for
// it. A `.Report` is advice that `jet lint` lists; it fails nothing.
DiagnosticTier: enum {
    Error,
    Tidy,
    Report,
}

// How a diagnostic stops the build. `.Warning` and `.Lint` reports don't, and
// `#Allow(Type)` silences one.
Severity: enum {
    Error,
    Warning,
    Lint,
}

// A part of the toolchain that reports a diagnostic. A row lists every part
// that does (`[.Parse, .Sema]`).
DiagnosticStage: enum {
    Build,
    Compile,
    Comptime,
    Driver,
    Jet,
    Jetpack,
    Lex,
    Load,
    Parse,
    Repl,
    Runtime,
    Sema,
    Tooling,
}

// When a diagnostic can fire.
DiagnosticMoment: enum {
    Compile,
    Run,
    Test,
    Tool,
}

// A retired code no longer fires; it stays so old logs remain explainable.
// A reserved code holds its number for a rule not yet reported.
DiagnosticStatus: enum {
    Active,
    Reserved,
    Retired,
}

// Why an error refuses a program. `.Soundness`: accepting it could cause a
// memory, type, aliasing or resource fault. `.Opinion`: it would run safely,
// and Jet refuses it for clarity or style.
DiagnosticSafetyClass: enum {
    Soundness,
    Opinion,
}

// The machine edit `jet fix` applies for a diagnostic. `.Replace` writes `to`
// over the reported `from` text, and `.Remove` deletes the reported `text`.
// `.Rewrite` is what `syntax.rewrite(callee: f, replacement: g)` writes in a
// package lint's `structured_fix`: at a reported call of the resolved
// function `callee`, the call calls `replacement` instead and keeps its
// arguments.
DiagnosticEdit: enum {
    SourceEdit,
    SuggestedSourceEdit,
    CryptoMisuse,
    Replace(from: String, to: String),
    Remove(text: String),
    Rewrite(callee: String, replacement: String),
    GeneratedMarkerGroup,
    GeneratedMissingArms,
    GeneratedScriptRun,
    GeneratedRedundantTailReturn,
}

// Why a diagnostic has no machine edit: the fix is a design choice, it would
// change behavior, or more than one fix fits.
DiagnosticNoFix: enum {
    Design,
    Behavior,
    Ambiguous,
}

// How safe a machine edit is to apply without review.
DiagnosticFixSafety: enum {
    Formatting,
    BehaviorPreserving,
    APIChanging,
    NeedsReview,
    TargetChanging,
}

// What a build's `meta.events(watch: …, handler)` handler hears: a
// declaration or a call of the build's program that passed its checks.
CompilerEvent: enum {
    Checked(CheckedItem),
}

// The checked part a `CompilerEvent` names: a function a
// `.Functions{marked: m}` watch hears, or a call a `.Calls{to: f}` watch
// hears.
CheckedItem: enum {
    Function(FunctionInfo),
    Call(CompilerCall),
}

// One part of a String literal with holes, as a `check` rule hears it in
// `CompilerArg.written`: a run of its text, or a hole with its name when
// the hole is a bare name and its span. `"/users/{id}"` is
// `[.Text{text: "/users/"}, .Hole{name: Val("id"), span: …}]`.
CompilerWrittenPart: enum {
    Text(text: String),
    Hole(name: String?, span: SourceSpan),
}

// A marker is a struct that implements Marker: its fields are what a use
// site passes (`#Label("x")`), and the constants are the rule's settings,
// each a value known while compiling. The same `impl Marker` block may name a
// fixed marker stack (`group: #[…]`, which takes no settings), a companion
// rule (`companion: [Rule, .Site]`) and the `expand: fn(self, target: Target)`
// template. A package marker can't set `inherits`, `resolution` or `scopes`:
// only Jet's own markers change how the compiler checks code. A value tag is
// a field-less marker struct with `sites: [.TypeUse]`: its `#FX(!…)` row is
// what its values may not reach, and only its block also takes `from` (the
// effects or functions whose results carry it), `timing` (a TagTiming case)
// and `protects` (a TagProtects case), from core.compiler.lang.
Marker: trait {
    // Where the marker may be written.
    sites: [Site],
    // Whether one target may carry the marker more than once.
    repeatable: Bool{false},
    // Whether the marker teaches its own argument menu in its errors.
    owns_menu: Bool{false},
    // Whether a setting on an outer scope reaches the scopes inside it.
    inherits: Bool{false},
    // How an inner setting meets an inherited one.
    resolution: MarkerResolution{.SiteBound},
    // The scopes an inheriting setting may be written on.
    scopes: [MarkerScope]{[]},
}

// A place a marker is written. `TypeUse` is a type where it is used, which a
// value tag marks (`#CardNumber String`).
Site: enum {
    Package,
    File,
    Module,
    Function,
    Method,
    Block,
    Statement,
    Expression,
    Type,
    Impl,
    Trait,
    Declaration,
    Constant,
    Field,
    Variant,
    Parameter,
    Test,
    Operation,
    Text,
    Arm,
    TypeUse,
}

// A match arm, after its body (`1 -> { a() } #Through`).

// How an inner marker setting meets the one it inherits: it applies only
// where written, replaces the outer one, merges with it, or may only tighten it.
MarkerResolution: enum {
    SiteBound,
    Override,
    Merge,
    Tighten,
}

// A scope an inheriting marker setting is written on.
MarkerScope: enum {
    Organization,
    Package,
    Module,
    Function,
    Block,
}

// What an effect operation does to kept data: Reads only looks, Adds makes
// something new while leaving existing data alone, and Replaces overwrites or
// removes existing data.
EffectAccess: enum {
    Reads,
    Adds,
    Replaces,

    // Derives MCP ToolAnnotations from this EffectAccess class, repeatability
    // fact, and whether the operation's effect row reaches an open-world
    // external boundary (`Net`, `Browser`, `Exec`, or `FFI`).
    tool_annotations: fn(self, repeatable: Bool, open_world: Bool) -> ToolAnnotations Never! {
        read_only: self == EffectAccess.Reads
        ToolAnnotations{
            readOnlyHint: read_only,
            destructiveHint: self == EffectAccess.Replaces,
            idempotentHint: read_only || repeatable,
            openWorldHint: open_world,
        }
    }
}

// MCP tool safety annotations derived from checked effect access, repeatability,
// and external open-world reachability.
ToolAnnotations: struct {
    readOnlyHint: Bool,
    destructiveHint: Bool,
    idempotentHint: Bool,
    openWorldHint: Bool,
}

// A compiler fact plane is a field-less struct that implements Fact: the
// compiler tracks the fact, and no value of the struct exists. One form
// serves value, scope and build facts; `holds` says which. The constants are
// the plane's laws, each a value known while compiling, and only Jet's own
// Prelude declares planes.
Fact: trait {
    // The plane's dotted compiler name. None: the struct's name.
    name: String?{None},
    // What the fact attaches to.
    holds: FactTarget,
    // The way the fact may move without a gate.
    safe: FactDirection,
    // Every escape that may move the fact the other way.
    gates: [Gate]{[]},
    // Whether the plane contributes to carrier identity.
    identity: Bool{false},
    // The prover that publishes the plane read-only. None: the checker.
    proved_by: String?{None},
}

// What a fact attaches to: a value, a scope, or the build.
FactTarget: enum {
    Value,
    Scope,
    Build,
}

// The way a fact may move without a gate: it may only be gained, only
// shrink, or only be discharged, or it is read-only and never moves.
FactDirection: enum {
    Gain,
    Shrink,
    Discharge,
    ReadOnly,
}

// An escape that moves a fact away from its safe direction: one case per
// escape word (`approx`, `_name`, `policy allow`, the `grant:` of `#FX`, a
// forced build setting, …), and `.Marker(Unsafe)` for an escape written as a
// marker, whose type must be a marker.
Gate: enum {
    Approx,
    Rounded,
    Raw,
    Wrapping,
    Saturating,
    Checked,
    Detach,
    Drop,
    Provider,
    Digest,
    UnderscoreName,
    PolicyAllow,
    ManifestRuleEdit,
    Grant,
    Force,
    Marker(Type),
}

// A foreign language: the root its modules are imported under (`c` in
// `use c.stdio`). A type that implements it adds the language, Core's own
// below and a package's alike, and no local module may take a language's
// root as its name or alias (E1002).
Language: trait {
    // The import root: `c`, `py`, `zig`.
    root: String,
}

// The languages the toolchain's binders bind, in the order of the `FFI`
// effect's cases; Jetpack's binder table (BinderDescriptor.jet) registers one
// binder for each of these roots, in this order.
GoLanguage: struct {
    impl Language {
        root: "go",
    }
}

JavaLanguage: struct {
    impl Language {
        root: "java",
    }
}

DotNetLanguage: struct {
    impl Language {
        root: "cs",
    }
}

FortranLanguage: struct {
    impl Language {
        root: "fortran",
    }
}

CobolLanguage: struct {
    impl Language {
        root: "cobol",
    }
}

TclLanguage: struct {
    impl Language {
        root: "tcl",
    }
}

LuaLanguage: struct {
    impl Language {
        root: "lua",
    }
}

AdaLanguage: struct {
    impl Language {
        root: "ada",
    }
}

PascalLanguage: struct {
    impl Language {
        root: "pascal",
    }
}

DartLanguage: struct {
    impl Language {
        root: "dart",
    }
}

PowerShellLanguage: struct {
    impl Language {
        root: "pwsh",
    }
}

