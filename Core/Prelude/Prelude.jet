package {
    name: "core.prelude"
    version: "0.0.1"
    edition: "2026"
    description: "Always-imported identity and scalar helpers."
    license: "MIT"
    outputs: {
        prelude: .Library{ entry: prelude }
    }
}
use core :: core

// `keep` is the compiler's identity/use-site barrier. The other helpers,
// including the optional-to-failure view, are ordinary reachable Jet bodies.
fn keep<T>(value: T) -> T Never! { value }

fn identity(value: ^String) -> String Never! { value }

fn always(value: Bool) -> Bool Never! { value }

fn identity_int(value: Int) -> Int Never! { value }

fn identity_float(value: Float) -> Float Never! { value }

fn identity_bool(value: Bool) -> Bool Never! { value }

fn const_int(value: Int, ignored: Int) -> Int Never! {
    _ :: ignored
    value
}

fn const_bool(value: Bool, ignored: Bool) -> Bool Never! {
    _ :: ignored
    value
}

fn not_bool(value: Bool) -> Bool Never! {
    if value -> return false
    true
}

// `min`, `max` and `clamp` are prelude names (no import) over any one ordered
// type: Int and the sized integers, Float/F32, Decimal, Duration, Instant,
// String, Char, or a type that implements Comparable. Among equal values the
// first argument wins. A NaN argument is the result: it orders against
// nothing, so no other value is the least or the greatest. Only an unordered
// pair (neither `a < b` nor `b <= a`) pays for finding which side is NaN, so
// ordered values cost one or two compares per argument.
fn min<T: Comparable>(a: T, b: T, rest: ...T) -> T Never! {
    best := a
    if b < a {
        best = b
    } else if !(a <= b) {
        return if a <= a -> b else -> a
    }
    loop value in rest {
        if value < best {
            best = value
        } else if !(best <= value) {
            return if best <= best -> value else -> best
        }
    }
    best
}

fn max<T: Comparable>(a: T, b: T, rest: ...T) -> T Never! {
    best := a
    if a < b {
        best = b
    } else if !(b <= a) {
        return if a <= a -> b else -> a
    }
    loop value in rest {
        if best < value {
            best = value
        } else if !(value <= best) {
            return if best <= best -> value else -> best
        }
    }
    best
}

// Reversed bounds are accepted: `clamp(x, 10, 0)` clamps to `0..=10`.
fn clamp<T: Comparable>(x: T, lo: T, hi: T) -> T Never! {
    if hi < lo {
        if hi <= x {
            if x <= lo -> return x
            return lo
        }
        if x < hi -> return hi
        return x
    }
    if !(lo <= hi) -> return if lo <= lo -> hi else -> lo
    if lo <= x {
        if x <= hi -> return x
        return hi
    }
    if x < lo -> return lo
    x
}

// The caller materializes the receiver and then `why`,
// even when the payload is present. Own those evaluated values, not a later
// read of the caller's optional. Construct an Err only for clean absence.
fn option_or_err<T>(value: ^T?, why: ^String) -> T Err! {
    return if value == {
        .Val(payload) -> Ok(payload)
        .None -> Err(why)
    }
}

// Compiler-supplied #Receipt facts are not a user-constructible handle.
// This private source target retains the typed payload and all three checked
// metadata arguments; the raw store operation uses the existing encoder.
module receipt {
    use core :: core

    fn attach<T>(value: T, section_name: String, type_name: String, schema_digest: String) Never! {
        core.prelude.__receipt_attach<T>(value, section_name, type_name, schema_digest)
    }
}
