package: {
    name: "core.prelude"
    version: "0.0.1"
    edition: "2026"
    description: "Always-imported identity and scalar helpers."
    license: "MIT"
    outputs: {
        prelude: .Library{ entry: prelude }
    }
}
use core: core

// `keep` is the compiler's identity/use-site barrier. The other helpers,
// including the optional-to-failure view, are ordinary reachable Jet bodies.
keep: fn<T>(value: T) -> T Never! { value }

identity: fn(value: &&String) -> String Never! { value }

always: fn(value: Bool) -> Bool Never! { value }

identity_int: fn(value: Int) -> Int Never! { value }

identity_float: fn(value: Float) -> Float Never! { value }

identity_bool: fn(value: Bool) -> Bool Never! { value }

const_int: fn(value: Int, ignored: Int) -> Int Never! {
    _: ignored
    value
}

const_bool: fn(value: Bool, ignored: Bool) -> Bool Never! {
    _: ignored
    value
}

not_bool: fn(value: Bool) -> Bool Never! {
    if value -> return false
    true
}

// `min`, `max` and `clamp` are prelude names (no import) over any one ordered
// type: Int and the sized integers, Float/F32, Decimal, Duration, Instant,
// String, Char, or a type that implements Comparable. They order by
// `compare`, so Floats follow IEEE 754 totalOrder (-NaN < -inf < ... < -0.0 <
// +0.0 < ... < +inf < NaN). Among equal values the first argument wins.
min: fn<T: Comparable>(a: T, b: T, rest: ...T) -> T Never! {
    best := a
    if b.compare(best) == .Less -> best = b
    loop value in rest {
        if value.compare(best) == .Less -> best = value
    }
    best
}

max: fn<T: Comparable>(a: T, b: T, rest: ...T) -> T Never! {
    best := a
    if b.compare(best) == .Greater -> best = b
    loop value in rest {
        if value.compare(best) == .Greater -> best = value
    }
    best
}

// Reversed bounds are accepted: `clamp(x, 10, 0)` clamps to `0..=10`.
clamp: fn<T: Comparable>(x: T, lo: T, hi: T) -> T Never! {
    if hi.compare(lo) == .Less {
        if x.compare(hi) == .Less -> return hi
        if x.compare(lo) == .Greater -> return lo
        return x
    }
    if x.compare(lo) == .Less -> return lo
    if x.compare(hi) == .Greater -> return hi
    x
}

// The caller materializes the receiver and then `why`,
// even when the payload is present. Own those evaluated values, not a later
// read of the caller's optional. Construct an Err only for clean absence.
option_or_err: fn<T>(value: &&T?, why: &&String) -> T Err! {
    return if value == {
        .Val(payload) -> Ok(payload)
        .None -> Err(why)
    }
}

// Where source sits: `#here` is the place it is written, and a parameter
// default `at: SourceLocation{#caller}` is the place of each call that leaves
// `at` out. The compiler fills the fields; displays as `file:line:column`.
// `module` is the dotted module of the place: the package's name, then the
// `name: module` declarations that reach the file, then any inline modules
// around it (`shop.cache`); a file no declaration reaches is the package
// root (`shop`). "" only in a value built by hand.
SourceLocation: struct {
    file: String
    line: Int
    column: Int
    function: String
    module: String{""}

    impl Display { display: fn(self) -> String { "{self.file}:{self.line}:{self.column}" } }
}
// The phase of the compiled copy an expression runs in: `#phase` is
// `.Preparation` in preparation and compile-time code and in a function's
// compile-time copy, `.Build` in the copy a package's `fn build` runs, and
// `.Runtime` in the running program. Each copy folds its own phase, never the
// optimizer: the same copy reads the same phase on every tier.
Phase: enum {
    Preparation
    Build
    Runtime
}

// A finding the compiler or a package reports, and the only carrier of one.
// An error type is a struct whose fields are the holes of its texts; its impl
// gives each text as one string literal that reads only `self` fields, so
// `jet explain` can print it without running code. `reject(value)` raises one
// while compiling. The constants are the registry columns, and each has a
// default.
Diagnostic: trait {
    // The report's code. None: the type's path, such as `web.BadPath`.
    code: String?{None}
    severity: Severity{.Error}
    // Which commands the finding fails.
    tier: DiagnosticTier{.Error}
    // The name `#Allow` and lint policy use; a `.Lint` diagnostic needs one.
    lint_name: String?{None}
    // The pipeline stages that report it.
    stage: [DiagnosticStage]{[.Sema]}
    moment: DiagnosticMoment{.Compile}
    status: DiagnosticStatus{.Active}
    // A one-line summary. None: the `what` text.
    meaning: String?{None}
    // Whether `jet explain` prints the what, why and fix texts in full.
    detail: Bool{false}
    // The machine edit `jet fix` applies, if any. The `fix` text stays the
    // help a reader follows by hand.
    structured_fix: DiagnosticEdit?{None}
    // Why no machine edit can apply. None: an edit applies, or none is classified.
    no_fix: DiagnosticNoFix?{.Design}
    // The next step without a machine edit. None: the `fix` text.
    fix_next: String?{None}
    fix_safety: DiagnosticFixSafety?{None}
    // Why an error refuses the program: `.Soundness` or `.Opinion`. None:
    // not yet classified.
    safety_class: DiagnosticSafetyClass?{None}
    // One line: the fault accepting the program could cause, or why it would
    // run safely.
    safety_reason: String?{None}
    // A `.Soundness` error's way out for an expert: the opt-in that reaches
    // the same program, or `none: ` and why nothing can.
    expert_path: String?{None}
    what: fn(self) -> String
    why: fn(self) -> String
    fix: fn(self) -> String
}

// Which commands a finding fails. An `.Error` fails every command. A `.Tidy`
// error is about untidy code that still runs: `jet check` and `jet build`
// list it and fail, while `jet run`, `jet dev` and `jet test` never stop for
// it. A `.Report` is advice that `jet lint` lists; it fails nothing.
DiagnosticTier: enum {
    Error
    Tidy
    Report
}

// How a diagnostic stops the build. `.Warning` and `.Lint` reports don't, and
// `#Allow(Type)` silences one.
Severity: enum {
    Error
    Warning
    Lint
}

// A part of the toolchain that reports a diagnostic. A row lists every part
// that does (`[.Parse, .Sema]`).
DiagnosticStage: enum {
    Build
    Compile
    Comptime
    Driver
    Jet
    Jetpack
    Lex
    Load
    Parse
    Repl
    Runtime
    Sema
    Tooling
}

// When a diagnostic can fire.
DiagnosticMoment: enum {
    Compile
    Run
    Test
    Tool
}

// A retired code no longer fires; it stays so old logs remain explainable.
// A reserved code holds its number for a rule not yet reported.
DiagnosticStatus: enum {
    Active
    Reserved
    Retired
}

// Why an error refuses a program. `.Soundness`: accepting it could cause a
// memory, type, aliasing or resource fault. `.Opinion`: it would run safely,
// and Jet refuses it for clarity or style.
DiagnosticSafetyClass: enum {
    Soundness
    Opinion
}

// The machine edit `jet fix` applies for a diagnostic. `.Replace` writes `to`
// over the reported `from` text, and `.Remove` deletes the reported `text`.
// `.Rewrite` is what `syntax.rewrite(callee: f, replacement: g)` writes in a
// package lint's `structured_fix`: at a reported call of the resolved
// function `callee`, the call calls `replacement` instead and keeps its
// arguments.
DiagnosticEdit: enum {
    SourceEdit
    SuggestedSourceEdit
    CryptoMisuse
    Replace(from: String, to: String)
    Remove(text: String)
    Rewrite(callee: String, replacement: String)
    GeneratedMarkerGroup
    GeneratedMissingArms
    GeneratedScriptRun
    GeneratedRedundantTailReturn
}

// Why a diagnostic has no machine edit: the fix is a design choice, it would
// change behavior, or more than one fix fits.
DiagnosticNoFix: enum {
    Design
    Behavior
    Ambiguous
}

// How safe a machine edit is to apply without review.
DiagnosticFixSafety: enum {
    Formatting
    BehaviorPreserving
    APIChanging
    NeedsReview
    TargetChanging
}

// What a build's `meta.events(watch: …, handler)` handler hears: a
// declaration or a call of the build's program that passed its checks.
CompilerEvent: enum {
    Checked(CheckedItem)
}

// The checked part a `CompilerEvent` names: a function a
// `.Functions{marked: m}` watch hears, or a call a `.Calls{to: f}` watch
// hears.
CheckedItem: enum {
    Function(FunctionInfo)
    Call(CompilerCall)
}

// A marker is a struct that implements Marker: its fields are what a use
// site passes (`#Label("x")`), and the constants are the rule's settings,
// each a value known while compiling. The same `impl Marker` block may name a
// fixed marker stack (`group: #[…]`, which takes no settings), a companion
// rule (`companion: [Rule, .Site]`) and the `expand: fn(self, target: Target)`
// template. A package marker can't set `inherits`, `resolution` or `scopes`:
// only Jet's own markers change how the compiler checks code.
Marker: trait {
    // Where the marker may be written.
    sites: [Site]
    // Whether one target may carry the marker more than once.
    repeatable: Bool{false}
    // Whether the marker teaches its own argument menu in its errors.
    owns_menu: Bool{false}
    // Whether a setting on an outer scope reaches the scopes inside it.
    inherits: Bool{false}
    // How an inner setting meets an inherited one.
    resolution: MarkerResolution{.SiteBound}
    // The scopes an inheriting setting may be written on.
    scopes: [MarkerScope]{[]}
}

// A place a marker is written.
Site: enum {
    Package
    File
    Module
    Function
    Method
    Block
    Statement
    Expression
    Type
    Impl
    Trait
    Declaration
    Constant
    Field
    Variant
    Parameter
    Test
    Operation
    Text
    // A match arm, after its body (`1 -> { a() } #Through`).
    Arm
}

// How an inner marker setting meets the one it inherits: it applies only
// where written, replaces the outer one, merges with it, or may only tighten it.
MarkerResolution: enum {
    SiteBound
    Override
    Merge
    Tighten
}

// A scope an inheriting marker setting is written on.
MarkerScope: enum {
    Organization
    Package
    Module
    Function
    Block
}
// Compiler-supplied #Receipt facts are not a user-constructible handle.
// This private source target retains the typed payload and all three checked
// metadata arguments; the raw store operation uses the existing encoder.
receipt: module {
    use core: core

    attach: fn<T>(value: T, section_name: String, type_name: String, schema_digest: String) Never! {
        core.prelude.__receipt_attach<T>(value, section_name, type_name, schema_digest)
    }
}
