package: {
    name: "core.service"
    version: "0.0.1"
    edition: "2026"
    description: "Typed service topology, delivery, and workflow handles."
    license: "MIT"
    outputs: {
        service: .Library{ entry: service }
    }
}

use {
    core: core
    service_sys: core.sys
    service_encoding: core.encoding
    service_crypto: core.crypto
    service_files: core.files
}

// Ordinary source values: construction, matching, equality and ownership use
// the compiler's existing record/enum rails, not service-specific handles.
#Error
ServiceError: enum {
    Full(String)
    Ambiguous(String)
    Unknown(String)
    NotStarted(String)
    Policy(String)
    Unavailable(String)
    Partitioned(String)
    Revoked(String)
    Stale(String)
    Expired(String)

    impl Display {
        display: fn(self) -> String { service_error_show(self) }
    }
}

service_error_show: fn(error: ServiceError) -> String Never! {
    if error == {
        .Full(message) -> message
        .Ambiguous(message) -> message
        .Unknown(message) -> message
        .NotStarted(message) -> message
        .Policy(message) -> message
        .Unavailable(message) -> message
        .Partitioned(message) -> message
        .Revoked(message) -> message
        .Stale(message) -> message
        .Expired(message) -> message
    }
}

DeliveryState: enum {
    Pending
    Accepted
    Delivering
    Delivered
    DeadLettered
    Cancelled
}

delivery_state_show: fn(state: DeliveryState) -> String Never! {
    if state == {
        .Pending -> "Pending"
        .Accepted -> "Accepted"
        .Delivering -> "Delivering"
        .Delivered -> "Delivered"
        .DeadLettered -> "DeadLettered"
        .Cancelled -> "Cancelled"
    }
}

DeliveryReceipt: struct {
    id: String
    state: DeliveryState
    attempts: Int
    retention_until: Int
    deadline: Int
    idempotency_key: String
    duplicate: Bool
    authority: String
    generation: Int
    signature: String

    show: fn(self) -> String Never! { delivery_receipt_show(self) }

    impl Display {
        display: fn(self) -> String { delivery_receipt_show(self) }
    }
}

delivery_receipt_show: fn(receipt: DeliveryReceipt) -> String Never! {
    state: delivery_state_show(receipt.state)
    "DeliveryReceipt(id={receipt.id}, state={state}, attempts={receipt.attempts}, retention_until={receipt.retention_until}, deadline={receipt.deadline}, key={receipt.idempotency_key}, duplicate={receipt.duplicate}, authority={receipt.authority}, generation={receipt.generation}, signature={receipt.signature})"
}

TaskOutcome: enum {
    Finished
    Panicked(String)
    Cancelled
    DeadlineBlown

    impl Display {
        display: fn(self) -> String { task_outcome_show(self) }
    }
    impl Debug {
        debug: fn(&&self) -> String {
            if self == {
                .Panicked(reason) -> "Panicked({reason:Debug})"
                .Finished | .Cancelled | .DeadlineBlown -> task_outcome_show(self)
            }
        }
    }
}

task_outcome_show: fn(outcome: TaskOutcome) -> String Never! {
    if outcome == {
        .Finished -> "Finished"
        .Panicked(reason) -> "Panicked({reason})"
        .Cancelled -> "Cancelled"
        .DeadlineBlown -> "DeadlineBlown"
    }
}

#Test("task outcome display and debug distinguish raw and quoted panic reasons") {
    assert(task_outcome_show(TaskOutcome.Finished) == "Finished")
    assert(task_outcome_show(TaskOutcome.Cancelled) == "Cancelled")
    assert(task_outcome_show(TaskOutcome.DeadlineBlown) == "DeadlineBlown")
    assert(task_outcome_show(TaskOutcome.Panicked("a\"b")) == "Panicked(a\"b)")
    outcome: TaskOutcome.Panicked("a\"b")
    assert("{outcome:Debug}" == "Panicked(\"a\\\"b\")")
}

// Byte-exact current token-derived key. This intentionally does not introduce
// a signing-key registry or strengthen the existing authority proof.
__authority_signing_key: fn(authority: String) -> [U8] ServiceError! {
    raw: authority.bytes()
    if raw.len() != 67 || raw[0] != (U8{115}) || raw[1] != (U8{97}) || raw[2] != (U8{45}) {
        return Err(ServiceError.Revoked("service authority proof is malformed"))
    }
    key := [U8]{}
    loop i in 0..<32 {
        high: authority_hex_digit(Int.from_u8(raw[3 + i * 2])) ?? return Err(ServiceError.Revoked("service authority proof is malformed"))
        low: authority_hex_digit(Int.from_u8(raw[4 + i * 2])) ?? return Err(ServiceError.Revoked("service authority proof is malformed"))
        key.push(U8{high * 16 + low})
    }
    key
}

authority_hex_digit: fn(value: Int) -> Int? Never! {
    if value >= 48 && value <= 57 -> return Val(value - 48)
    if value >= 65 && value <= 70 -> return Val(value - 65 + 10)
    if value >= 97 && value <= 102 -> return Val(value - 97 + 10)
    None
}

// Exact policy order from ServiceAuthority::jet_services_authority_validate:
// missing-key identity fallback, newer unpartitioned fallback; for an exact
// row, tree/worker mismatch, partition, generation, then stopped/newer-started.
authority_validate_snapshot: fn(identity: ServiceEndpoint, exact: __EndpointState?, candidates: [__EndpointState]) ServiceError! {
    if exact == {
        .None -> {
            loop candidate in candidates {
                if candidate.tree == identity.tree && candidate.worker == identity.worker && candidate.generation == identity.generation {
                    return Err(ServiceError.Revoked("service endpoint authority does not match the registered worker"))
                }
            }
            loop candidate in candidates {
                if candidate.tree == identity.tree && candidate.worker == identity.worker && candidate.authority == identity.authority && candidate.generation > identity.generation && !candidate.partitioned {
                    return Err(ServiceError.Stale("service endpoint generation {identity.generation} is no longer current"))
                }
            }
            return Err(ServiceError.Partitioned("service endpoint authority is not registered"))
        }
        .Val(state) -> {
            if state.tree != identity.tree -> return Err(ServiceError.Revoked("service endpoint belongs to another tree"))
            if state.worker != identity.worker -> return Err(ServiceError.Revoked("service endpoint belongs to another worker"))
            if state.partitioned -> return Err(ServiceError.Partitioned("service endpoint authority is partitioned"))
            if state.generation != identity.generation {
                return Err(ServiceError.Stale("service endpoint generation {identity.generation} is not current (current generation {state.generation})"))
            }
            if !state.started && !state.draining {
                loop candidate in candidates {
                    if candidate.tree == identity.tree && candidate.worker == identity.worker && candidate.authority == identity.authority && candidate.generation > identity.generation && candidate.started && !candidate.partitioned {
                        return Err(ServiceError.Stale("service endpoint generation {identity.generation} is no longer current"))
                    }
                }
                return Err(ServiceError.NotStarted("service worker `{identity.worker}` is not running"))
            }
            return Ok()
        }
    }
}

endpoint_state_fixture: fn(authority: String, tree: String, worker: String, generation: Int, started: Bool, partitioned: Bool) -> __EndpointState Never! {
    __EndpointState{tree: tree, worker: worker, authority: authority, generation: generation, started: started, draining: false, partitioned: partitioned, store: None, store_generation: 0, channel: None}
}

#Test("endpoint snapshot preserves mismatch partition stale and stopped priorities") {
    token: "sa-000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
    identity: ServiceEndpoint{tree: "tree", worker: "worker", generation: 2, authority: token}
    empty: [__EndpointState]{}
    wrong_tree: endpoint_state_fixture(token, "other", "worker", 1, false, true)
    wrong_worker: endpoint_state_fixture(token, "tree", "other", 1, false, true)
    partitioned: endpoint_state_fixture(token, "tree", "worker", 1, false, true)
    stale: endpoint_state_fixture(token, "tree", "worker", 1, false, false)
    stopped: endpoint_state_fixture(token, "tree", "worker", 2, false, false)
    assert(if authority_validate_snapshot(identity, Val(wrong_tree), empty) == {
        .Err(.Revoked(message)) -> message == "service endpoint belongs to another tree"
        .Ok(_) | .Err(_) -> false
    })
    assert(if authority_validate_snapshot(identity, Val(wrong_worker), empty) == {
        .Err(.Revoked(message)) -> message == "service endpoint belongs to another worker"
        .Ok(_) | .Err(_) -> false
    })
    assert(if authority_validate_snapshot(identity, Val(partitioned), empty) == {
        .Err(.Partitioned(message)) -> message == "service endpoint authority is partitioned"
        .Ok(_) | .Err(_) -> false
    })
    assert(if authority_validate_snapshot(identity, Val(stale), empty) == {
        .Err(.Stale(message)) -> message == "service endpoint generation 2 is not current (current generation 1)"
        .Ok(_) | .Err(_) -> false
    })
    assert(if authority_validate_snapshot(identity, Val(stopped), empty) == {
        .Err(.NotStarted(message)) -> message == "service worker `worker` is not running"
        .Ok(_) | .Err(_) -> false
    })
    peers := [__EndpointState]{}
    peers.push(endpoint_state_fixture(token, "tree", "worker", 3, true, false))
    assert(if authority_validate_snapshot(identity, Val(stopped), peers) == {
        .Err(.Stale(message)) -> message == "service endpoint generation 2 is no longer current"
        .Ok(_) | .Err(_) -> false
    })
    assert(if authority_validate_snapshot(identity, None, empty) == {
        .Err(.Partitioned(message)) -> message == "service endpoint authority is not registered"
        .Ok(_) | .Err(_) -> false
    })
    assert(if authority_validate_snapshot(identity, None, peers) == {
        .Err(.Stale(message)) -> message == "service endpoint generation 2 is no longer current"
        .Ok(_) | .Err(_) -> false
    })
    peers.push(endpoint_state_fixture("sa-ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff", "tree", "worker", 2, false, false))
    assert(if authority_validate_snapshot(identity, None, peers) == {
        .Err(.Revoked(message)) -> message == "service endpoint authority does not match the registered worker"
        .Ok(_) | .Err(_) -> false
    })
}

validate_endpoint_identity: fn(authority: String, tree: String, worker: String, generation: Int) ServiceError! {
    if !valid_service_text(tree, 256) -> return Err(ServiceError.Policy("service tree is empty, too long, or contains control characters"))
    if !valid_service_text(worker, 256) -> return Err(ServiceError.Policy("service worker is empty, too long, or contains control characters"))
    if !valid_authority_token(authority) -> return Err(ServiceError.Policy("service authority must be a provider-issued opaque token"))
    if __authority_signing_key(authority) == {
        .Err(error) -> return Err(error)
        .Ok(_) -> {}
    }
    if generation < 1 -> return Err(ServiceError.Policy("service endpoint generation must be positive"))
}

valid_authority_token: fn(authority: String) -> Bool Never! {
    raw: authority.bytes()
    if raw.len() != 67 || !authority.starts_with("sa-") -> return false
    loop i in 3..<67 {
        value: Int.from_u8(raw[i])
        if !((value >= 48 && value <= 57) || (value >= 97 && value <= 102)) -> return false
    }
    true
}

#Test("endpoint identity checks preserve native order and lowercase issuance") {
    token: "sa-000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
    assert(if validate_endpoint_identity(token, " ", "worker", 1) == {
        .Ok(_) -> true
        .Err(_) -> false
    })
    assert(if validate_endpoint_identity("bad", "", "", 0) == {
        .Err(.Policy(message)) -> message == "service tree is empty, too long, or contains control characters"
        .Ok(_) | .Err(_) -> false
    })
    assert(if validate_endpoint_identity(token, "tree", "", 0) == {
        .Err(.Policy(message)) -> message == "service worker is empty, too long, or contains control characters"
        .Ok(_) | .Err(_) -> false
    })
    assert(if validate_endpoint_identity("sa-000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F", "tree", "worker", 1) == {
        .Err(.Policy(message)) -> message == "service authority must be a provider-issued opaque token"
        .Ok(_) | .Err(_) -> false
    })
    assert(if validate_endpoint_identity(token, "tree", "worker", 0) == {
        .Err(.Policy(message)) -> message == "service endpoint generation must be positive"
        .Ok(_) | .Err(_) -> false
    })
}

endpoint_show: fn(endpoint: ServiceEndpoint) -> String Never! {
    "Endpoint({endpoint.tree}/{endpoint.worker}@g{endpoint.generation})"
}

set_delivery: fn(tree: &ServiceTree, delivery: ServiceDelivery) ServiceError! {
    if tree.started -> return Err(ServiceError.Policy("cannot change delivery after start"))
    tree.delivery = delivery
}

// The root policy is written first, then every declared group's policy.
set_restart: fn(tree: &ServiceTree, restart: ServiceRestart) ServiceError! {
    if tree.started -> return Err(ServiceError.Policy("cannot change restart policy after start"))
    tree.restart = restart
    loop index in 0..<tree.groups.len() -> tree.groups[index].restart = restart
}

drain_dead_letters: fn(tree: &ServiceTree) -> Int ServiceError! {
    if !tree.started -> return Err(ServiceError.NotStarted("service tree is not started"))
    count: tree.dead_letters.len()
    tree.dead_letters.clear()
    Ok(count)
}

set_state_empty: fn(tree: &ServiceTree) ServiceError! {
    if tree.started -> return Err(ServiceError.Policy("cannot change state adapter after start"))
    if tree.snapshot != None || tree.event_log.len() != 0 {
        return Err(ServiceError.Policy("cannot discard state records while selecting Empty state adapter"))
    }
    tree.state_adapter = __TreeStateAdapter.Empty
    tree.state_authority = None
}

// Services3247/3274: identical checks, then adapter followed by authority.
set_state_snapshot: fn(tree: &ServiceTree, store: ServiceStateStore, schema: String, version: Int, migration: String) ServiceError! {
    select_state_adapter(tree, store, schema, version, migration, false)
}

set_state_event_log: fn(tree: &ServiceTree, store: ServiceStateStore, schema: String, version: Int, migration: String) ServiceError! {
    select_state_adapter(tree, store, schema, version, migration, true)
}

select_state_adapter: fn(tree: &ServiceTree, store: ServiceStateStore, schema: String, version: Int, migration: String, event_log: Bool) ServiceError! {
    if tree.started -> return Err(ServiceError.Policy("cannot change state adapter after start"))
    if tree.snapshot != None || tree.event_log.len() != 0 {
        return Err(ServiceError.Policy("cannot replace a state adapter after it has records"))
    }
    if migration != "reversible" && migration != "dual_write" && migration != "forward_only" {
        return Err(ServiceError.Policy("unknown migration policy {migration:Debug}; write \"reversible\", \"dual_write\", or \"forward_only\""))
    }
    if !valid_service_text(store.path, 4096) -> return Err(ServiceError.Policy("service state store is empty, too long, or contains control characters"))
    if !valid_service_text(schema, 256) -> return Err(ServiceError.Policy("service state schema is empty, too long, or contains control characters"))
    if version < 1 -> return Err(ServiceError.Policy("service state schema version must be positive"))
    adapter: if event_log -> __TreeStateAdapter.EventLog else -> __TreeStateAdapter.Snapshot
    tree.state_adapter = adapter
    tree.state_authority = Val(__TreeStateAuthority{store: store.path, schema: schema, version: version, migration: migration, adapter: adapter})
}

valid_service_text: fn(text: String, limit: Int) -> Bool Never! {
    raw: text.bytes()
    if raw.len() == 0 || raw.len() > limit -> return false
    loop i in 0..<raw.len() {
        value: Int.from_u8(raw[i])
        if value < 32 || value == 127 -> return false
        if value == 194 && i + 1 < raw.len() {
            next_byte: Int.from_u8(raw[i + 1])
            if next_byte >= 128 && next_byte <= 159 -> return false
        }
    }
    true
}

restore_snapshot: fn(tree: ServiceTree) -> String ServiceError! {
    authority: tree.state_authority ?? return Err(ServiceError.Policy("Snapshot state has no injected authority"))
    records: state_load(authority, __TreeStateAdapter.Snapshot)
    if records.len() == 0 -> return Err(ServiceError.Policy("no snapshot committed"))
    read_state_record("v{authority.version}:", records[0])
}

// Replays the in-memory records; no store read.
replay_events: fn(tree: ServiceTree) -> String Never! {
    version: if tree.state_authority == {
        .Val(value) -> value.version
        .None -> 1
    }
    events := [String]{}
    loop record in tree.event_log {
        event: read_state_record("v{version}:", record) ?? return "StateReplayError(invalid_record)"
        events.push(event)
    }
    events.join("|")
}

read_state_record: fn(prefix: String, record: String) -> String ServiceError! {
    if !record.starts_with(prefix) -> return Err(ServiceError.Policy("state record schema is incompatible"))
    raw: record.bytes()
    start: prefix.bytes().len()
    separator := start
    loop separator < raw.len() && raw[separator] != (U8{58}) -> separator = separator + 1
    if separator == raw.len() -> return Err(ServiceError.Policy("state record is truncated"))
    digits_start := start
    if digits_start < separator && raw[digits_start] == (U8{43}) -> digits_start = digits_start + 1
    if digits_start == separator -> return Err(ServiceError.Policy("state record length is invalid"))
    length := 0
    maximum: service_sys.usize_max()
    loop i in digits_start..<separator {
        digit: Int.from_u8(raw[i]) - 48
        if digit < 0 || digit > 9 || length > (maximum - digit) /% 10 -> return Err(ServiceError.Policy("state record length is invalid"))
        length = length * 10 + digit
    }
    if length != raw.len() - separator - 1 -> return Err(ServiceError.Policy("state record length does not match payload"))
    String.from_bytes(raw.slice(separator + 1, raw.len())) ?? return Err(ServiceError.Policy("state record length does not match payload"))
}

upgrade_receipt: fn(tree: ServiceTree) -> ServiceUpgradeReceipt ServiceError! {
    tree.last_upgrade ?? return Err(ServiceError.Policy("service tree has no completed generation handoff"))
}

// The rollback store is omitted from every text view.
__upgrade_receipt_display: fn(receipt: ServiceUpgradeReceipt) -> String Never! {
    "ServiceUpgradeReceipt(from={receipt.from_generation}, to={receipt.to_generation}, migration={receipt.migration}, rollback_available={receipt.rollback_available}, pinned={receipt.pinned_shards.join(",")})"
}

tree_show: fn(tree: ServiceTree) -> String Never! {
    handlers := [String]{}
    loop worker in tree.workers -> handlers.push("{worker.name}:{worker.handler_name}")
    restart: if tree.restart == {
        .OneForOne -> "OneForOne"
        .OneForAll -> "OneForAll"
        .RestForOne -> "RestForOne"
    }
    delivery: if tree.delivery == {
        .AtMostOnce -> "AtMostOnce"
        .DurableAtLeastOnce -> "DurableAtLeastOnce"
    }
    "ServiceTree(name={tree.name}, workers={tree.workers.len()}, handlers=[{handlers.join(",")}], started={tree.started}, restart={restart}, budget={tree.budget_max}/{tree.budget_per_ms}ms, delivery={delivery})"
}

// Durable replay precedes lookup; the first matching run wins.
workflow_history: fn(tree: ServiceTree, run: Int | ServiceWorkflow) -> String ServiceError! {
    run_id: workflow_run_id(run)
    loop workflow in workflow_replay(tree) {
        if workflow.run_id == run_id -> return Ok(workflow.history.join("|"))
    }
    Err(ServiceError.Unknown("workflow run {run_id} not found"))
}

// A missing or nonterminal run is Policy.
workflow_outcome: fn(tree: ServiceTree, run: Int | ServiceWorkflow) -> TaskOutcome ServiceError! {
    run_id: workflow_run_id(run)
    loop workflow in workflow_replay(tree) {
        if workflow.run_id == run_id {
            return workflow.outcome ?? return Err(ServiceError.Policy("workflow run {run_id} has no recorded terminal outcome"))
        }
    }
    Err(ServiceError.Policy("workflow run {run_id} has no recorded terminal outcome"))
}

observe: fn(tree: ServiceTree) -> String Never! {
    running := 0
    paused := 0
    cancel_requested := 0
    pending := 0
    finished := 0
    panicked := 0
    cancelled := 0
    deadline_blown := 0
    loop workflow in tree.workflows {
        if workflow.status == {
            .Running -> running = running + 1
            .Paused -> paused = paused + 1
            .CancelRequested -> cancel_requested = cancel_requested + 1
        }
        if workflow.outcome == {
            .None -> pending = pending + 1
            .Val(.Finished) -> finished = finished + 1
            .Val(.Panicked(_)) -> panicked = panicked + 1
            .Val(.Cancelled) -> cancelled = cancelled + 1
            .Val(.DeadlineBlown) -> deadline_blown = deadline_blown + 1
        }
    }
    rollback: if tree.last_upgrade == {
        .Val(receipt) -> receipt.rollback_available
        .None -> false
    }
    "Observe(workers={tree.workers.len()}, started={tree.started}, generation={tree.generation}, dead_letters={tree.dead_letters.len()}, events={tree.event_log.len()}, chaos={tree.chaos_fails}, draining={tree.draining.len()}, partitions={tree.partitioned.len()}, rollback={rollback}, workflows={tree.workflows.len()},statuses={{running:{running},paused:{paused},cancel_requested:{cancel_requested}}},outcomes={{pending:{pending},finished:{finished},panicked:{panicked},cancelled:{cancelled},deadline_blown:{deadline_blown}}})"
}

#Test("service state records use UTF-8 byte lengths and exact corruption errors") {
    assert((read_state_record("v1:", "v1:2:é") ?? panic("record")) == "é")
    assert((read_state_record("v1:", "v1:+2:é") ?? panic("record")) == "é")
    assert(if read_state_record("v1:", "v2:2:é") == {
        .Err(.Policy(message)) -> message == "state record schema is incompatible"
        .Ok(_) | .Err(_) -> false
    })
    assert(if read_state_record("v1:", "v1:1:é") == {
        .Err(.Policy(message)) -> message == "state record length does not match payload"
        .Ok(_) | .Err(_) -> false
    })
    assert(if read_state_record("v1:", "v1:-1:x") == {
        .Err(.Policy(message)) -> message == "state record length is invalid"
        .Ok(_) | .Err(_) -> false
    })
}

#Test("service authority key decodes the existing token, including uppercase hex") {
    key: __authority_signing_key("sa-000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F") ?? panic("key")
    assert(key.len() == 32)
    loop i in 0..<32 -> assert(Int.from_u8(key[i]) == i)
    assert(if __authority_signing_key("bad") == {
        .Err(.Revoked(message)) -> message == "service authority proof is malformed"
        .Ok(_) | .Err(_) -> false
    })
}

#Test("service errors keep every message and delivery receipts keep every field") {
    assert(service_error_show(ServiceError.Full("full")) == "full")
    assert(service_error_show(ServiceError.Ambiguous("ambiguous")) == "ambiguous")
    assert(service_error_show(ServiceError.Unknown("unknown")) == "unknown")
    assert(service_error_show(ServiceError.NotStarted("not started")) == "not started")
    assert(service_error_show(ServiceError.Policy("policy")) == "policy")
    assert(service_error_show(ServiceError.Unavailable("unavailable")) == "unavailable")
    assert(service_error_show(ServiceError.Partitioned("partitioned")) == "partitioned")
    assert(service_error_show(ServiceError.Revoked("revoked")) == "revoked")
    assert(service_error_show(ServiceError.Stale("stale")) == "stale")
    assert(service_error_show(ServiceError.Expired("expired")) == "expired")
    receipt: DeliveryReceipt{id: "id", state: DeliveryState.Delivered, attempts: 3, retention_until: 4, deadline: 5, idempotency_key: "key", duplicate: true, authority: "authority", generation: 6, signature: "signature"}
    assert(delivery_receipt_show(receipt) == "DeliveryReceipt(id=id, state=Delivered, attempts=3, retention_until=4, deadline=5, key=key, duplicate=true, authority=authority, generation=6, signature=signature)")
}

// core.service owns its runtime in source: trees, mailboxes, the process
// endpoint registry, durable stores and workflow logs are ordinary values.
// Host leaves are limited to wall time, entropy, sleep and file primitives.

// Plain policy values; constructors and duration projection are below.
ServiceRestart: enum {
    OneForOne
    OneForAll
    RestForOne
}

ServiceDelivery: enum {
    AtMostOnce
    DurableAtLeastOnce
}

ServiceRuntime: struct {
    store: String
    retention_ms: Int
}

ServiceStateStore: struct {
    path: String
}

ServiceTree: struct {
    priv name: String
    priv authority: String
    priv generation: Int
    priv delivery: ServiceDelivery
    priv restart: ServiceRestart
    priv budget_max: Int
    priv budget_per_ms: Int
    priv workers: [__TreeWorker]
    priv groups: [__TreeGroup]
    priv started: Bool
    priv state_adapter: __TreeStateAdapter
    priv state_authority: __TreeStateAuthority?
    priv snapshot: String?
    priv event_log: [String]
    priv dead_letters: [String]
    priv idempotency: [__IdempotencyRecord]
    priv directory: [__DirectoryRecord]
    priv draining: [String]
    priv partitioned: [String]
    priv workflows: [__TreeWorkflowState]
    priv chaos_fails: Int
    priv previous_generation: Int
    priv last_upgrade: ServiceUpgradeReceipt?
}

// Identity only: equality compares tree, worker, generation and authority.
// The bounded channel lives in the process endpoint registry.
ServiceEndpoint: struct {
    priv tree: String
    priv worker: String
    priv generation: Int
    priv authority: String
}

// A worker never runs a handler task in-process; the handler identity is
// checked when the worker is declared and only its name is kept.
__TreeWorker: struct {
    name: String
    handler_name: String
    endpoint: ServiceEndpoint
    capacity: Int
    channel: Shared<__ServiceChannel>
    restarts: [Int]
    running: Bool
}

__TreeGroup: struct {
    name: String
    restart: ServiceRestart
    budget_max: Int
    budget_per_ms: Int
    workers: [String]
}

__TreeStateAdapter: enum {
    Empty
    Snapshot
    EventLog
}

__TreeStateAuthority: struct {
    store: String
    schema: String
    version: Int
    migration: String
    adapter: __TreeStateAdapter
}

__IdempotencyRecord: struct {
    key: String
    endpoint: ServiceEndpoint
    message: String
}

__DirectoryRecord: struct {
    name: String
    endpoint: ServiceEndpoint
    proof: String
}

ServiceUpgradeReceipt: struct {
    priv from_generation: Int
    priv to_generation: Int
    priv migration: String
    priv rollback_store: String
    priv rollback_available: Bool
    priv pinned_shards: [String]

    impl Display {
        display: fn(self) -> String { __upgrade_receipt_display(self) }
    }
}

Delivery: struct {
    priv id: String
    priv store: String
    priv duplicate: Bool
    priv authority: String
    priv generation: Int

    show: fn(self) -> String Never! { "Delivery({self.id})" }

    impl Display {
        display: fn(self) -> String { self.show() }
    }
}

tree: fn(name: String) -> ServiceTree Never! {
    ServiceTree{
        name: name,
        authority: "",
        generation: 1,
        delivery: ServiceDelivery.AtMostOnce,
        restart: ServiceRestart.OneForOne,
        budget_max: 5,
        budget_per_ms: 60000,
        workers: [__TreeWorker]{},
        groups: [__TreeGroup]{},
        started: false,
        state_adapter: __TreeStateAdapter.Empty,
        state_authority: None,
        snapshot: None,
        event_log: [String]{},
        dead_letters: [String]{},
        idempotency: [__IdempotencyRecord]{},
        directory: [__DirectoryRecord]{},
        draining: [String]{},
        partitioned: [String]{},
        workflows: [__TreeWorkflowState]{},
        chaos_fails: 0,
        previous_generation: 0,
        last_upgrade: None,
    }
}

// Bounded FIFO shared by an endpoint's registry entry and its tree mailbox.
// `head` indexes the oldest value; consumed slots are compacted lazily.
__ServiceChannel: struct {
    capacity: Int
    values: [String]
    head: Int
    closed: Bool
}

__ChannelSend: enum {
    Sent
    Full
    Closed
}

__ChannelReceive: enum {
    Value(String)
    Empty
    Closed
}

channel_new: fn(capacity: Int, values: [String]) -> Shared<__ServiceChannel>? Never! {
    if capacity < 1 || values.len() > capacity -> return None
    Val(shared __ServiceChannel{capacity: capacity, values: values, head: 0, closed: false})
}

channel_try_send: fn(channel: Shared<__ServiceChannel>, value: String) -> __ChannelSend Never! {
    guard := channel.guard_edit()
    if guard.value.closed -> return __ChannelSend.Closed
    if guard.value.values.len() - guard.value.head >= guard.value.capacity -> return __ChannelSend.Full
    guard.value.values.push(value.copy())
    __ChannelSend.Sent
}

channel_try_receive: fn(channel: Shared<__ServiceChannel>) -> __ChannelReceive Never! {
    guard := channel.guard_edit()
    head: guard.value.head
    if head < guard.value.values.len() {
        value: guard.value.values[head].copy() // copy: the slot is released by compaction below
        guard.value.head = head + 1
        if guard.value.head == guard.value.values.len() {
            guard.value.values.clear()
            guard.value.head = 0
        } else if guard.value.head * 2 > guard.value.values.len() {
            guard.value.values = guard.value.values.slice(guard.value.head, guard.value.values.len())
            guard.value.head = 0
        }
        return __ChannelReceive.Value(value)
    }
    if guard.value.closed -> return __ChannelReceive.Closed
    __ChannelReceive.Empty
}

channel_snapshot: fn(channel: Shared<__ServiceChannel>) -> [String] Never! {
    guard: channel.guard_read()
    guard.value.values.slice(guard.value.head, guard.value.values.len())
}

channel_depth: fn(channel: Shared<__ServiceChannel>) -> Int Never! {
    guard: channel.guard_read()
    guard.value.values.len() - guard.value.head
}

channel_clear: fn(channel: Shared<__ServiceChannel>) Never! {
    guard := channel.guard_edit()
    guard.value.values.clear()
    guard.value.head = 0
}

channel_close: fn(channel: Shared<__ServiceChannel>) Never! {
    guard := channel.guard_edit()
    guard.value.closed = true
}

#Test("service channel keeps FIFO order, capacity, close and restore bounds") {
    assert(channel_new(0, [String]{}) == None)
    assert(channel_new(1, [String]{"a", "b"}) == None)
    channel: channel_new(2, [String]{"a"}) ?? panic("channel")
    assert(channel_try_send(channel, "b") == __ChannelSend.Sent)
    assert(channel_try_send(channel, "c") == __ChannelSend.Full)
    assert(channel_snapshot(channel) == [String]{"a", "b"})
    assert(channel_try_receive(channel) == __ChannelReceive.Value("a"))
    assert(channel_depth(channel) == 1)
    channel_close(channel)
    assert(channel_try_send(channel, "d") == __ChannelSend.Closed)
    assert(channel_try_receive(channel) == __ChannelReceive.Value("b"))
    assert(channel_try_receive(channel) == __ChannelReceive.Closed)
}

// Host leaves. Each is one existing runtime primitive with no service policy.
service_now: fn() -> Int Never! {
    sample: core.service.__host_wall_sample()
    if sample.before_epoch -> return 9223372036854775807
    millis: sample.nanoseconds /% 1000000
    if sample.seconds > (9223372036854775807 - millis) /% 1000 -> return 9223372036854775807
    sample.seconds * 1000 + millis
}

service_issue_authority: fn() -> String ServiceError! {
    bytes: core.service.__host_entropy(32) ?? return Err(ServiceError.Policy("service authority cannot obtain cryptographic entropy"))
    if bytes.len() != 32 -> return Err(ServiceError.Policy("service authority cannot obtain cryptographic entropy"))
    Ok("sa-{service_encoding.bytes_to_hex(bytes)}")
}

service_sleep_ms: fn(millis: Int) Never! {
    core.service.__host_sleep_ns(millis * 1000000)
}

// symlink_metadata kind: 0 file, 1 directory, 2 symlink, otherwise other.
service_path_kind: fn(path: String) -> Int IOError! {
    core.service.__host_path_kind(path)
}

// The stat row of `path` itself (links not followed); see core.files.stat.
service_stat: fn(path: String) -> [Int] IOError! {
    core.service.__host_stat(-1, path, false)
}

service_read_bytes: fn(path: String) -> [U8] IOError! {
    core.service.__host_read_bytes(path)
}

service_remove: fn(path: String) IOError! {
    core.service.__host_remove(path)
}

service_create_dirs: fn(path: String) IOError! {
    core.service.__host_create_dirs(path)
}

// Create `path` exclusively with mode 0600 and write `bytes` durably. An
// existing name is AlreadyExists, the one kind lock acquisition retries.
service_create_private: fn(path: String, bytes: [U8]) IOError! {
    handle: core.service.__host_reserve(path, path)
    if core.service.__host_set_mode(path, 384) == {
        .Err(error) -> {
            core.service.__host_close(handle)
            core.service.__host_remove(path).drop("the reserved name is removed best-effort")
            return Err(error)
        }
        .Ok(_) -> {}
    }
    result: core.service.__host_finish(handle, bytes, path, path)
    core.service.__host_close(handle)
    result
}

// Replace `path` atomically with a private (0600) file holding `bytes`:
// exclusive temporary, durable write, rename, then parent directory sync.
service_replace_private: fn(path: String, temporary: String, bytes: [U8]) IOError! {
    if service_create_private(temporary, bytes) == {
        .Err(error) -> {
            core.service.__host_remove(temporary).drop("the temporary is removed best-effort")
            return Err(error)
        }
        .Ok(_) -> {}
    }
    if core.service.__host_rename(temporary, path) == {
        .Err(error) -> {
            core.service.__host_remove(temporary).drop("the temporary is removed best-effort")
            return Err(error)
        }
        .Ok(_) -> {}
    }
    parent: state_parent_lex(path, false) ?? "."
    core.service.__host_sync_parent(if parent == "" -> "." else -> parent, path)
}

// Append `bytes` to `path`, creating it private (0600) first, then fsync.
service_append_private: fn(path: String, bytes: [U8]) IOError! {
    if service_create_private(path, [U8]{}) == {
        .Err(.AlreadyExists(_)) -> {}
        .Err(error) -> return Err(error)
        .Ok(_) -> {}
    }
    core.service.__host_append_bytes(path, bytes)
    core.service.__host_fsync(path)
}

service_pid: fn() -> Int Never! {
    core.service.__host_pid()
}

service_current_dir: fn() -> String? Never! {
    if core.service.__host_current_dir() == {
        .Ok(value) -> Val(value)
        .Err(_) -> None
    }
}

// Absolute, lexically normalized store path: `.` dropped, `..` pops.
authority_store_identity: fn(store: String) -> String Never! {
    absolute := store.copy() // copy: the caller keeps its store text
    if !store.starts_with("/") {
        if service_current_dir() == {
            .Val(directory) -> absolute = if directory.ends_with("/") -> "{directory}{store}" else -> "{directory}/{store}"
            .None -> {}
        }
    }
    parts := [String]{}
    loop part in absolute.split("/") {
        if part == "" || part == "." -> next
        if part == ".." {
            if parts.len() > 0 -> _: parts.pop()
            next
        }
        parts.push(part)
    }
    joined: parts.join("/")
    if absolute.starts_with("/") -> return "/{joined}"
    joined
}

authority_validate_text: fn(value: String, label: String, limit: Int, allow_empty: Bool) ServiceError! {
    if value == "" {
        if allow_empty -> return Ok()
        return Err(ServiceError.Policy("{label} is empty, too long, or contains control characters"))
    }
    if !valid_service_text(value, limit) -> return Err(ServiceError.Policy("{label} is empty, too long, or contains control characters"))
}

authority_validate_store_path: fn(store: String) ServiceError! {
    if service_path_kind(store) == {
        .Ok(kind) -> { if kind != 0 -> return Err(ServiceError.Policy("service authority store must be a regular file, not a symlink")) }
        .Err(.NotFound(_)) -> {}
        .Err(error) -> return Err(ServiceError.Unavailable("could not inspect service authority store: {error}"))
    }
    parent := state_parent_lex(store, false)
    loop {
        directory: parent ?? break
        if directory != "" {
            if service_path_kind(directory) == {
                .Ok(kind) -> { if kind != 1 -> return Err(ServiceError.Policy("service authority store parent must be a real directory")) }
                .Err(.NotFound(_)) -> {}
                .Err(error) -> return Err(ServiceError.Unavailable("could not inspect service store parent: {error}"))
            }
        }
        parent = state_parent_lex(directory, false)
    }
}

authority_validate_runtime: fn(runtime: ServiceRuntime) ServiceError! {
    authority_validate_text(runtime.store, "service store", 4096, false)
    if runtime.retention_ms < 0 -> return Err(ServiceError.Policy("service retention must be zero or positive"))
    authority_validate_store_path(runtime.store)
}

// Cross-process exclusion: `{store}.{suffix}.lock` is created exclusively
// (0600) holding its creation time in milliseconds. A lock older than two
// minutes is abandoned and removed; waiting past 30 seconds fails closed.
// An empty path holds nothing: a tree without a state store has no journal.
__ServiceFileLock: struct {
    path: String
}
impl __ServiceFileLock.Close {
    close: fn(&&self) {
        if self.path == "" -> return
        service_remove(self.path).drop("lock release is best-effort; a stale lock is recovered by age")
    }
}

authority_file_lock: fn(store: String, suffix: String) -> __ServiceFileLock ServiceError! {
    authority_validate_store_path(store)
    path: "{store}.{suffix}.lock"
    if state_parent_lex(path, false) == {
        .Val(parent) -> {
            if parent != "" {
                if service_create_dirs(parent) == {
                    .Err(error) -> return Err(ServiceError.Unavailable("could not create service lock directory: {error}"))
                    .Ok(_) -> {}
                }
            }
        }
        .None -> {}
    }
    started: service_now()
    loop {
        if service_create_private(path, "{service_now()}".bytes()) == {
            .Ok(_) -> return Ok(__ServiceFileLock{path: path})
            .Err(.AlreadyExists(_)) -> {
                now: service_now()
                if authority_lock_stale(path, now) {
                    service_remove(path).drop("another waiter may already have removed the stale lock")
                    next
                }
                if now - started >= 30000 -> return Err(ServiceError.Unavailable("service authority lock remained held beyond its recovery budget"))
                service_sleep_ms(1)
            }
            .Err(error) -> return Err(ServiceError.Unavailable("could not create service authority lock: {error}"))
        }
    }
}

// Lock age is measured from the lock file's modification time.
authority_lock_stale: fn(path: String, now: Int) -> Bool Never! {
    row: service_stat(path) ?? return false
    modified_ms: row[9] /% 1000000
    now - modified_ms >= 120000
}

authority_operation_lock: fn(runtime: ServiceRuntime, operation: String) -> __ServiceFileLock ServiceError! {
    digest: service_crypto.sha256(delivery_signature_payload([String]{authority_store_identity(runtime.store), operation})).bytes
    authority_file_lock(runtime.store, "op-{service_encoding.bytes_to_hex(digest)}")
}

authority_retention_deadline: fn(now: Int, retention_ms: Int) -> Int Never! {
    if retention_ms == 0 -> return 9223372036854775807
    if now > 9223372036854775807 - retention_ms -> return 9223372036854775807
    now + retention_ms
}

// Process endpoint registry. One row per issued (authority, worker,
// generation); the row owns the authoritative route facts and the channel.
__EndpointState: struct {
    tree: String
    worker: String
    authority: String
    generation: Int
    started: Bool
    draining: Bool
    partitioned: Bool
    store: String?
    store_generation: Int
    channel: Shared<__ServiceChannel>?
}

__ServiceRegistry: struct {
    endpoints: [__EndpointState]
}

__PendingEntry: struct {
    id: String
    message: String
    store: String
}

__PendingQueue: struct {
    store: String
    authority: String
    worker: String
    generation: Int
    entries: [__PendingEntry]
}

__PendingRegistry: struct {
    queues: [__PendingQueue]
}

// In-process serialization of durable authority store work; the file locks
// serialize the same work across processes.
__AuthorityGate: struct {
    entered: Int
}

init_service_registry: fn() -> Shared<__ServiceRegistry> Never! {
    shared __ServiceRegistry{endpoints: [__EndpointState]{}}
}

init_pending_registry: fn() -> Shared<__PendingRegistry> Never! {
    shared __PendingRegistry{queues: [__PendingQueue]{}}
}

init_authority_gate: fn() -> Shared<__AuthorityGate> Never! {
    shared __AuthorityGate{entered: 0}
}

service_registry: fn() -> Shared<__ServiceRegistry> Never! {
    core.mem.__process_shared(init_service_registry)
}

pending_registry: fn() -> Shared<__PendingRegistry> Never! {
    core.mem.__process_shared(init_pending_registry)
}

authority_gate: fn() -> Shared<__AuthorityGate> Never! {
    core.mem.__process_shared(init_authority_gate)
}

registry_index: fn(endpoints: [__EndpointState], authority: String, worker: String, generation: Int) -> Int Never! {
    loop index in 0..<endpoints.len() {
        state: endpoints[index]
        if state.authority == authority && state.worker == worker && state.generation == generation -> return index
    }
    -1
}

endpoint_new: fn(tree: String, worker: String, generation: Int, authority: String) -> ServiceEndpoint ServiceError! {
    validate_endpoint_identity(authority, tree, worker, generation)
    Ok(ServiceEndpoint{tree: tree, worker: worker, generation: generation, authority: authority})
}

authority_register: fn(endpoint: ServiceEndpoint, started: Bool, channel: Shared<__ServiceChannel>?) ServiceError! {
    validate_endpoint_identity(endpoint.authority, endpoint.tree, endpoint.worker, endpoint.generation)
    registry := service_registry().guard_edit()
    index: registry_index(registry.value.endpoints, endpoint.authority, endpoint.worker, endpoint.generation)
    if index < 0 {
        loop state in registry.value.endpoints {
            if state.authority == endpoint.authority && state.tree != endpoint.tree -> return Err(ServiceError.Revoked("service authority does not match its registered tree"))
        }
        registry.value.endpoints.push(__EndpointState{
            tree: endpoint.tree.copy(), // copy: the registry row outlives the borrowed endpoint
            worker: endpoint.worker.copy(), // copy: as above
            authority: endpoint.authority.copy(), // copy: as above
            generation: endpoint.generation,
            started: started,
            draining: false,
            partitioned: false,
            store: None,
            store_generation: 0,
            channel: channel,
        })
        return Ok()
    }
    state: registry.value.endpoints[index]
    if state.tree != endpoint.tree || state.worker != endpoint.worker -> return Err(ServiceError.Revoked("service endpoint authority does not match its tree"))
    if started && state.partitioned -> return Err(ServiceError.Partitioned("service endpoint authority is partitioned"))
    registry_write_generation(registry.value.endpoints[index], endpoint.generation, started, channel)
}

registry_write_generation: fn(state: &__EndpointState, generation: Int, started: Bool, channel: Shared<__ServiceChannel>?) Never! {
    if state.generation != generation {
        state.store = None
        state.draining = false
    }
    state.generation = generation
    state.started = started
    if channel != None -> state.channel = channel
}

// Locate the registered row for `endpoint`; missing is Partitioned and a
// tree/worker mismatch is Revoked, as every registry mutation requires.
registry_row: fn(endpoints: [__EndpointState], endpoint: ServiceEndpoint) -> Int ServiceError! {
    index: registry_index(endpoints, endpoint.authority, endpoint.worker, endpoint.generation)
    if index < 0 -> return Err(ServiceError.Partitioned("service endpoint authority is not registered"))
    state: endpoints[index]
    if state.tree != endpoint.tree || state.worker != endpoint.worker -> return Err(ServiceError.Revoked("service endpoint authority does not match its tree"))
    Ok(index)
}

authority_update: fn(endpoint: ServiceEndpoint, started: Bool, channel: Shared<__ServiceChannel>?) ServiceError! {
    validate_endpoint_identity(endpoint.authority, endpoint.tree, endpoint.worker, endpoint.generation)
    registry := service_registry().guard_edit()
    index: registry_row(registry.value.endpoints, endpoint)
    if started && registry.value.endpoints[index].partitioned -> return Err(ServiceError.Partitioned("service endpoint authority is partitioned"))
    registry_write_generation(registry.value.endpoints[index], endpoint.generation, started, channel)
}

authority_update_partitioned: fn(endpoint: ServiceEndpoint, partitioned: Bool) ServiceError! {
    validate_endpoint_identity(endpoint.authority, endpoint.tree, endpoint.worker, endpoint.generation)
    registry := service_registry().guard_edit()
    index: registry_row(registry.value.endpoints, endpoint)
    registry.value.endpoints[index].partitioned = partitioned
    if partitioned -> registry.value.endpoints[index].started = false
}

authority_update_draining: fn(endpoint: ServiceEndpoint, draining: Bool) ServiceError! {
    validate_endpoint_identity(endpoint.authority, endpoint.tree, endpoint.worker, endpoint.generation)
    registry := service_registry().guard_edit()
    index: registry_row(registry.value.endpoints, endpoint)
    registry.value.endpoints[index].draining = draining
}

// Issuance is recorded only by the endpoint registry.
authority_require_issued: fn(authority: String) ServiceError! {
    registry: service_registry().guard_read()
    loop state in registry.value.endpoints {
        if state.authority == authority -> return Ok()
    }
    Err(ServiceError.Revoked("service authority is not registered by this provider"))
}

// A serialized endpoint never creates authority: only an endpoint already
// issued into this registry can be rehydrated or validate a directory proof.
authority_require_registered: fn(endpoint: ServiceEndpoint) ServiceError! {
    validate_endpoint_identity(endpoint.authority, endpoint.tree, endpoint.worker, endpoint.generation)
    registry: service_registry().guard_read()
    index: registry_index(registry.value.endpoints, endpoint.authority, endpoint.worker, endpoint.generation)
    if index < 0 -> return Err(ServiceError.Revoked("service endpoint authority was not issued in this process"))
    state: registry.value.endpoints[index]
    if state.tree != endpoint.tree || state.worker != endpoint.worker || state.authority != endpoint.authority || state.generation != endpoint.generation {
        return Err(ServiceError.Revoked("service endpoint authority does not match its issued identity"))
    }
}

__authority_validate: fn(endpoint: ServiceEndpoint) ServiceError! {
    validate_endpoint_identity(endpoint.authority, endpoint.tree, endpoint.worker, endpoint.generation)
    registry: service_registry().guard_read()
    index: registry_index(registry.value.endpoints, endpoint.authority, endpoint.worker, endpoint.generation)
    exact: if index < 0 -> None else -> Val(registry.value.endpoints[index])
    authority_validate_snapshot(endpoint, exact, registry.value.endpoints)
}

// Route facts read under the registry: started, draining and the channel.
__EndpointRoute: struct {
    started: Bool
    draining: Bool
    channel: Shared<__ServiceChannel>
}

authority_channel: fn(endpoint: ServiceEndpoint) -> __EndpointRoute ServiceError! {
    __authority_validate(endpoint)
    registry: service_registry().guard_read()
    index: registry_row(registry.value.endpoints, endpoint)
    state: registry.value.endpoints[index]
    if state.partitioned -> return Err(ServiceError.Partitioned("service endpoint authority is partitioned"))
    channel: state.channel ?? return Err(ServiceError.Partitioned("service endpoint mailbox is not connected"))
    Ok(__EndpointRoute{started: state.started, draining: state.draining, channel: channel})
}

// The registry guard is the one linearization point for drain, partition,
// handoff and endpoint send: a send enters the mailbox before the gate
// changes, or is rejected after it.
authority_try_send: fn(endpoint: ServiceEndpoint, message: String) ServiceError! {
    validate_endpoint_identity(endpoint.authority, endpoint.tree, endpoint.worker, endpoint.generation)
    if message.bytes().len() > 1048576 || (message != "" && !valid_service_text(message, 1048576)) {
        return Err(ServiceError.Policy("service message exceeds the 1 MiB limit"))
    }
    registry: service_registry().guard_read()
    index: registry_index(registry.value.endpoints, endpoint.authority, endpoint.worker, endpoint.generation)
    if index < 0 {
        loop candidate in registry.value.endpoints {
            if candidate.tree == endpoint.tree && candidate.worker == endpoint.worker && candidate.generation == endpoint.generation {
                return Err(ServiceError.Revoked("service endpoint authority does not match the registered worker"))
            }
        }
        loop candidate in registry.value.endpoints {
            if candidate.tree == endpoint.tree && candidate.worker == endpoint.worker && candidate.authority == endpoint.authority && candidate.generation > endpoint.generation && !candidate.partitioned {
                return Err(ServiceError.Stale("service endpoint generation {endpoint.generation} is no longer current"))
            }
        }
        return Err(ServiceError.Partitioned("service endpoint authority is not registered"))
    }
    state: registry.value.endpoints[index]
    if state.tree != endpoint.tree || state.worker != endpoint.worker -> return Err(ServiceError.Revoked("service endpoint authority does not match its tree"))
    if state.partitioned -> return Err(ServiceError.Partitioned("service endpoint authority is partitioned"))
    if state.generation != endpoint.generation {
        return Err(ServiceError.Stale("service endpoint generation {endpoint.generation} is not current (current generation {state.generation})"))
    }
    if !state.started -> return Err(ServiceError.NotStarted("service worker `{endpoint.worker}` is not running"))
    if state.draining -> return Err(ServiceError.NotStarted("service endpoint is draining"))
    channel: state.channel ?? return Err(ServiceError.Partitioned("service endpoint mailbox is not connected"))
    if channel_try_send(channel, message) == {
        .Sent -> Ok()
        .Full -> Err(ServiceError.Full("service endpoint mailbox is full"))
        .Closed -> Err(ServiceError.NotStarted("service endpoint mailbox is closed"))
    }
}

endpoint_send: fn(endpoint: ServiceEndpoint, message: String) ServiceError! {
    authority_try_send(endpoint, message)
}

endpoint_receive: fn(endpoint: ServiceEndpoint) -> String ServiceError! {
    validate_endpoint_identity(endpoint.authority, endpoint.tree, endpoint.worker, endpoint.generation)
    route: authority_channel(endpoint)
    if !route.started && (!route.draining || channel_depth(route.channel) == 0) -> return Err(ServiceError.NotStarted("service worker is not running"))
    if channel_try_receive(route.channel) == {
        .Value(message) -> Ok(message)
        .Empty -> Err(ServiceError.Ambiguous("service endpoint mailbox is empty"))
        .Closed -> Err(ServiceError.NotStarted("service endpoint mailbox is closed"))
    }
}

// The package endpoint core.jobs binds a queue to (durable jobs
// with no service setup). Its authority is a private secret kept at
// `secret_path`, beside the queue database, so every run of the package
// reaches the same queue rows and verifies the same receipts. The first run
// writes a fresh authority to a private (0600) exclusive temporary and
// publishes it with a no-replace rename, so the secret is never visible at a
// wider mode or half-written; a run that loses that race reads the winner's
// file. An existing file that is not a regular file owned by this user with
// no group or other permission bits is refused, never overwritten.
__active_endpoint: fn(secret_path: String) -[Env, FS]> ServiceEndpoint ServiceError! {
    authority: package_authority(secret_path) ?? return Err(err)
    endpoint: endpoint_new("jobs", "package", 1, authority) ?? return Err(err)
    authority_register(endpoint, true, None) ?? return Err(err)
    Ok(endpoint)
}

package_authority: fn(path: String) -[Env, FS]> String ServiceError! {
    if service_files.exists(path) == false {
        issued: service_issue_authority() ?? return Err(err)
        nonce: service_issue_authority() ?? return Err(err)
        temporary: "{path}.{nonce}.tmp"
        if package_authority_write(temporary, issued) == {
            .Err(error) -> {
                service_files.remove(temporary).drop("the private temporary is removed best-effort")
                return Err(package_authority_io(temporary, error))
            }
            .Ok(_) -> {}
        }
        if service_files.rename(temporary, path, if_exists: .Refuse) == {
            .Ok(_) -> return Ok(issued)
            .Err(.AlreadyExists(_)) -> {}
            .Err(error) -> {
                service_files.remove(temporary).drop("the private temporary is removed best-effort")
                return Err(package_authority_io(path, error))
            }
        }
        // Another run published first: its authority is the package's.
        service_files.remove(temporary).drop("the losing temporary is removed best-effort")
    }
    package_authority_read(path)
}

package_authority_write: fn(path: String, authority: String) IOError! -[FS]> {
    writer: service_files.create(path, if_exists: .Refuse, mode: Val(0o600), links: .Refuse) ?? return Err(err)
    writer.write_all(authority.bytes()) ?? return Err(err)
    writer.fsync()
}

package_authority_read: fn(path: String) -[Env, FS]> String ServiceError! {
    info: service_files.stat(path, links: .Refuse) ?? return Err(package_authority_io(path, err))
    if !info.is_file -> return Err(ServiceError.Policy("job queue authority `{path}` is not a regular file; remove it so the next run can create a private one"))
    if info.owner != Val(service_sys.geteuid()) -> return Err(ServiceError.Policy("job queue authority `{path}` is not owned by this user; remove it so the next run can create a private one"))
    if info.mode.bit_and(0o077) != 0 -> return Err(ServiceError.Policy("job queue authority `{path}` is readable or writable by group or others; restrict it with `chmod 600` or remove it"))
    raw: service_files.read_bytes(path) ?? return Err(package_authority_io(path, err))
    authority: String.from_bytes(raw) ?? return Err(ServiceError.Policy("job queue authority `{path}` is malformed; remove it so the next run can create a fresh one"))
    if !valid_authority_token(authority) -> return Err(ServiceError.Policy("job queue authority `{path}` is malformed; remove it so the next run can create a fresh one"))
    Ok(authority)
}

package_authority_io: fn(path: String, error: IOError) -> ServiceError Never! {
    ServiceError.Unavailable("job queue authority `{path}` cannot be read or created: {error}")
}

// The issuing authority token of an endpoint, for Core providers (core.jobs)
// that bind durable state to the service authority.
__endpoint_authority: fn(endpoint: ServiceEndpoint) -> String Never! {
    endpoint.authority.copy() // copy: the caller keeps the token past the borrowed endpoint
}

authority_bound_store: fn(endpoint: ServiceEndpoint) -> String? ServiceError! {
    __authority_validate(endpoint)
    registry_store(endpoint)
}

// The store bound to the endpoint's own generation, if any.
registry_store: fn(endpoint: ServiceEndpoint) -> String? ServiceError! {
    registry: service_registry().guard_read()
    index: registry_row(registry.value.endpoints, endpoint)
    state: registry.value.endpoints[index]
    if state.store_generation != endpoint.generation -> return Ok(None)
    Ok(state.store)
}

authority_bind_store: fn(runtime: ServiceRuntime, endpoint: ServiceEndpoint) -> String ServiceError! {
    authority_validate_runtime(runtime)
    __authority_validate(endpoint)
    store: authority_store_identity(runtime.store)
    registry := service_registry().guard_edit()
    index: registry_row(registry.value.endpoints, endpoint)
    if registry.value.endpoints[index].store == {
        .Val(bound) -> {
            if registry.value.endpoints[index].store_generation == endpoint.generation {
                if bound != store -> return Err(ServiceError.Revoked("service endpoint authority is bound to another store"))
                return Ok(store)
            }
        }
        .None -> {}
    }
    registry.value.endpoints[index].store = Val(store.copy()) // copy: the registry keeps the binding, the caller gets the identity
    registry.value.endpoints[index].store_generation = endpoint.generation
    Ok(store)
}

// A durable receipt keeps its original authority; a restarted provider
// adopts it as an alias of the live endpoint without a second mailbox.
authority_adopt_alias: fn(source: ServiceEndpoint, authority: String) -> ServiceEndpoint ServiceError! {
    __authority_validate(source)
    alias: endpoint_new(source.tree, source.worker, source.generation, authority)
    registry := service_registry().guard_edit()
    source_index: registry_index(registry.value.endpoints, source.authority, source.worker, source.generation)
    if source_index < 0 -> return Err(ServiceError.Partitioned("service endpoint authority is not registered"))
    source_state: registry.value.endpoints[source_index]
    if source_state.tree != alias.tree || source_state.worker != alias.worker -> return Err(ServiceError.Revoked("service authority alias does not match its worker"))
    if source_state.partitioned || !source_state.started -> return Err(ServiceError.Partitioned("service authority alias source is not active"))
    alias_index: registry_index(registry.value.endpoints, alias.authority, alias.worker, alias.generation)
    if alias_index >= 0 {
        existing: registry.value.endpoints[alias_index]
        if existing.tree != alias.tree || existing.worker != alias.worker || existing.generation != alias.generation {
            return Err(ServiceError.Revoked("service authority alias is already bound to another worker"))
        }
    } else {
        alias_state := source_state.copy() // copy: the alias row shares route facts and channel with its source
        alias_state.authority = alias.authority.copy() // copy: the returned endpoint keeps its authority
        registry.value.endpoints.push(alias_state)
    }
    Ok(alias)
}

// Move one routing shard between generations under the registry guard, so a
// caller observes the old endpoint or the new one, never both live. The old
// row stays registered but stopped, so a stale endpoint fails closed. The
// new row takes `channel`, or the old row's channel when none is given.
authority_rotate: fn(old: ServiceEndpoint, next: ServiceEndpoint, started: Bool, draining: Bool, channel: Shared<__ServiceChannel>?) ServiceError! {
    validate_endpoint_identity(old.authority, old.tree, old.worker, old.generation)
    validate_endpoint_identity(next.authority, next.tree, next.worker, next.generation)
    if old.tree != next.tree || old.worker != next.worker || old.authority != next.authority || old.generation == next.generation {
        return Err(ServiceError.Policy("service authority rotation must stay within one worker and change generation"))
    }
    registry := service_registry().guard_edit()
    old_index: registry_index(registry.value.endpoints, old.authority, old.worker, old.generation)
    if old_index < 0 -> return Err(ServiceError.Partitioned("service endpoint authority is not registered"))
    old_state: registry.value.endpoints[old_index]
    if old_state.tree != old.tree || old_state.worker != old.worker -> return Err(ServiceError.Revoked("service endpoint authority does not match its worker"))
    next_index: registry_index(registry.value.endpoints, next.authority, next.worker, next.generation)
    if next_index >= 0 {
        state: registry.value.endpoints[next_index]
        if state.tree != next.tree || state.worker != next.worker -> return Err(ServiceError.Revoked("new service endpoint authority does not match its worker"))
        if started && state.partitioned -> return Err(ServiceError.Partitioned("new service endpoint authority is partitioned"))
    }
    route := old_state.channel
    if channel == .Val(fresh) -> route = Val(fresh)
    registry.value.endpoints[old_index].started = false
    registry.value.endpoints[old_index].draining = false
    if next_index < 0 {
        registry.value.endpoints.push(__EndpointState{
            tree: next.tree,
            worker: next.worker,
            authority: next.authority,
            generation: next.generation,
            started: started,
            draining: draining,
            partitioned: false,
            store: None,
            store_generation: 0,
            channel: route,
        })
        return Ok()
    }
    registry.value.endpoints[next_index].started = started
    registry.value.endpoints[next_index].draining = draining
    registry.value.endpoints[next_index].partitioned = false
    registry.value.endpoints[next_index].channel = route
}

// Whether a live durable receipt still routes to this exact shard. A queued
// receipt counts too: rotating it away would strand it between the old
// pending queue and the new endpoint.
authority_has_uncommitted: fn(endpoint: ServiceEndpoint) -> Bool ServiceError! {
    validate_endpoint_identity(endpoint.authority, endpoint.tree, endpoint.worker, endpoint.generation)
    bound: registry_store(endpoint)
    store: bound ?? return Ok(false)
    runtime: ServiceRuntime{store: store, retention_ms: 0}
    gate := authority_gate().guard_edit()
    entries: authority_entries(runtime, authority_read(runtime))
    now: service_now()
    loop entry in entries {
        if entry.tree != endpoint.tree || entry.worker != endpoint.worker || entry.state == DeliveryState.Cancelled -> next
        if !delivery_routes_to_endpoint(runtime, entry, endpoint) -> next
        if !entry.delivered && !entry.dead && entry.retained_until == None && !delivery_entry_expired(entry, now) -> return Ok(true)
    }
    Ok(false)
}

#Test("fresh service tree exposes every native seed without starting a task") {
    fresh: tree("seed")
    assert(tree_show(fresh) == "ServiceTree(name=seed, workers=0, handlers=[], started=false, restart=OneForOne, budget=5/60000ms, delivery=AtMostOnce)")
    assert(observe(fresh) == "Observe(workers=0, started=false, generation=1, dead_letters=0, events=0, chaos=0, draining=0, partitions=0, rollback=false, workflows=0,statuses={{running:0,paused:0,cancel_requested:0}},outcomes={{pending:0,finished:0,panicked:0,cancelled:0,deadline_blown:0}})")
    assert(directory_generation(fresh) == 1)
    assert(event_count(fresh) == 0)
    assert(dead_letter_count(fresh) == 0)
}

runtime: fn(store: String, retention: Duration) -> ServiceRuntime Never! {
    ServiceRuntime{store: store, retention_ms: retention.ns /% 1000000}
}

state_store: fn(path: String) -[FS.Read]> ServiceStateStore ServiceError! {
    if !valid_store_text(path) {
        return Err(ServiceError.Policy("service state store is empty, too long, or contains control characters"))
    }
    if state_path_kind(path) == {
        .Ok(kind) -> {
            if kind == 2 -> return Err(state_error("service state store must not be a symlink"))
            if kind != 0 -> return Err(state_error("service state store is not a regular file"))
        }
        .Err(.NotFound(_)) -> {}
        .Err(error) -> return Err(state_error("cannot inspect service state store: {stat_cause(error)}"))
    }
    windows: StatePathPlatform{}.windows()
    parent := state_parent_lex(path, windows)
    loop {
        ancestor: parent ?? break
        if state_path_kind(ancestor) == {
            .Ok(kind) -> {
                if kind == 2 -> return Err(state_error("service state parent is a symlink: {ancestor}"))
                if kind != 1 -> return Err(state_error("service state parent is not a directory: {ancestor}"))
            }
            .Err(.NotFound(_)) -> {}
            .Err(error) -> return Err(state_error("cannot inspect service state parent: {stat_cause(error)}"))
        }
        parent = state_parent_lex(ancestor, windows)
    }
    ServiceStateStore{path: path}
}

// Metadata-only raw read: Windows identity acquisition would add failures that
// the constructor's native symlink_metadata contract never had.
state_path_kind: fn(path: String) -[FS.Read]> Int IOError! {
    #Unsafe("read the final path component's OS metadata kind without opening an identity handle") {
        return core.files.__path_kind(path)
    }
}

restart_one_for_one: fn() -> ServiceRestart Never! {
    ServiceRestart.OneForOne
}

restart_one_for_all: fn() -> ServiceRestart Never! {
    ServiceRestart.OneForAll
}

restart_rest_for_one: fn() -> ServiceRestart Never! {
    ServiceRestart.RestForOne
}

delivery_at_most_once: fn() -> ServiceDelivery Never! {
    ServiceDelivery.AtMostOnce
}

delivery_durable: fn() -> ServiceDelivery Never! {
    ServiceDelivery.DurableAtLeastOnce
}

directory_generation: fn(tree: ServiceTree) -> Int Never! {
    tree.generation
}

event_count: fn(tree: ServiceTree) -> Int Never! {
    tree.event_log.len()
}

dead_letter_count: fn(tree: ServiceTree) -> Int Never! {
    tree.dead_letters.len()
}

#Test("service policy constructors retain their nominal values") {
    assert(restart_one_for_one() == ServiceRestart.OneForOne)
    assert(restart_one_for_all() == ServiceRestart.OneForAll)
    assert(restart_rest_for_one() == ServiceRestart.RestForOne)
    assert(delivery_at_most_once() == ServiceDelivery.AtMostOnce)
    assert(delivery_durable() == ServiceDelivery.DurableAtLeastOnce)
    retention: Duration.milliseconds(1234) ?? panic("retention")
    value: runtime("queue.store", retention)
    assert(value.store == "queue.store")
    assert(value.retention_ms == 1234)
}

valid_store_text: fn(text: String) -> Bool Never! {
    raw: text.bytes()
    if raw.len() == 0 || raw.len() > 4096 -> return false
    loop i in 0..<raw.len() {
        value: Int.from_u8(raw[i])
        if value < 32 || value == 127 -> return false
        // Rust char::is_control is Unicode Cc, not only ASCII controls.
        if value == 194 && i + 1 < raw.len() {
            next: Int.from_u8(raw[i + 1])
            if next >= 128 && next <= 159 -> return false
        }
    }
    true
}

state_error: fn(message: String) -> ServiceError Never! {
    ServiceError.Policy("{message}; repair or replace the state store before retrying")
}

stat_cause: fn(error: IOError) -> String Never! {
    context: if error == {
        .InvalidInput(value) -> Val(value)
        .NotFound(value) -> Val(value)
        .PermissionDenied(value) -> Val(value)
        .TimedOut(value) -> Val(value)
        .Cancelled(value) -> Val(value)
        .Closed(value) -> Val(value)
        .Protocol(value) -> Val(value)
        .Other(value) -> Val(value)
        .AlreadyExists(value) -> Val(value)
        .Unsupported(value) -> Val(value)
        .ResourceLimit(_) -> None
    } ?? return "{error}"
    context.cause ?? "{error}"
}

// Select path grammar at compile time, not through an Env capability.
StatePathPlatform: struct {}
impl StatePathPlatform {
    windows: fn(self) -> Bool Never! {
        comptime if #build.target.os == {
            .Linux -> { return false }
            .MacOS -> { return false }
            .Windows -> { return true }
            else -> { return false }
        }
    }
}

StatePathPrefix: struct {
    length: Int
    verbatim: Bool
    implicit_root: Bool
}

// Match Path::components().next_back()/as_path(): retain lexical `..` and
// interior separators, but skip empty/dot suffix components. dirname's
// normalization would miss a symlink ancestor in paths such as link/../store.
state_parent_lex: fn(path: String, windows: Bool) -> String? Never! {
    raw: path.bytes()
    prefix: state_prefix(raw, windows)
    physical_root: prefix.length < raw.len() && state_separator(raw[prefix.length], windows, false)
    rooted: physical_root || prefix.implicit_root
    curdir: !rooted && prefix.length < raw.len() && raw[prefix.length] == (U8{46})
        && (raw.len() == prefix.length + 1 || state_separator(raw[prefix.length + 1], windows, prefix.verbatim))
    floor := prefix.length
    if physical_root -> floor = floor + 1
    if curdir -> floor = floor + 1
    end: state_trim_suffix(raw, raw.len(), floor, windows, prefix.verbatim)
    if end == floor {
        if curdir -> return Val(state_path_slice(raw, prefix.length))
        return None
    }
    begin: state_component_begin(raw, end, floor, windows, prefix.verbatim)
    remaining := begin
    if begin > floor -> remaining = begin - 1
    Val(state_path_slice(raw, state_trim_suffix(raw, remaining, floor, windows, prefix.verbatim)))
}

state_separator: fn(value: U8, windows: Bool, verbatim: Bool) -> Bool Never! {
    if windows && verbatim -> return value == (U8{92})
    value == (U8{47}) || (windows && value == (U8{92}))
}

state_component_begin: fn(raw: [U8], end: Int, floor: Int, windows: Bool, verbatim: Bool) -> Int Never! {
    start := end
    loop start > floor && !state_separator(raw[start - 1], windows, verbatim) {
        start = start - 1
    }
    start
}

state_trim_suffix: fn(raw: [U8], limit: Int, floor: Int, windows: Bool, verbatim: Bool) -> Int Never! {
    end := limit
    loop end > floor {
        begin: state_component_begin(raw, end, floor, windows, verbatim)
        skipped: begin == end || (!verbatim && end == begin + 1 && raw[begin] == (U8{46}))
        if !skipped -> break
        end = begin
        if begin > floor -> end = begin - 1
    }
    end
}

state_path_slice: fn(raw: [U8], end: Int) -> String Never! {
    bytes := [U8]{}
    loop i in 0..<end -> bytes.push(raw[i])
    String.from_bytes(bytes) ?? panic("path component boundary is not UTF-8")
}

state_next_separator: fn(raw: [U8], start: Int, verbatim: Bool) -> Int Never! {
    i := start
    loop i < raw.len() && !state_separator(raw[i], true, verbatim) -> i = i + 1
    i
}

state_drive: fn(raw: [U8], start: Int) -> Bool Never! {
    if start + 1 >= raw.len() || raw[start + 1] != (U8{58}) -> return false
    value: Int.from_u8(raw[start])
    (value >= 65 && value <= 90) || (value >= 97 && value <= 122)
}

state_prefix: fn(raw: [U8], windows: Bool) -> StatePathPrefix Never! {
    if !windows -> return StatePathPrefix{length: 0, verbatim: false, implicit_root: false}
    if raw.len() >= 2 && state_separator(raw[0], true, false) && state_separator(raw[1], true, false) {
        if raw.len() >= 4 && raw[0] == (U8{92}) && raw[1] == (U8{92}) && raw[2] == (U8{63}) && raw[3] == (U8{92}) {
            if raw.len() >= 8 && raw[4] == (U8{85}) && raw[5] == (U8{78}) && raw[6] == (U8{67}) && state_separator(raw[7], true, false) {
                server_end: state_next_separator(raw, 8, true)
                share_start := server_end
                if server_end < raw.len() -> share_start = server_end + 1
                share_end: state_next_separator(raw, share_start, true)
                length := server_end
                if share_end > share_start -> length = share_end
                return StatePathPrefix{length: length, verbatim: true, implicit_root: true}
            }
            if state_drive(raw, 4) && (raw.len() == 6 || state_separator(raw[6], true, false)) {
                return StatePathPrefix{length: 6, verbatim: true, implicit_root: false}
            }
            return StatePathPrefix{length: state_next_separator(raw, 4, true), verbatim: true, implicit_root: true}
        }
        if raw.len() >= 4 && raw[2] == (U8{46}) && state_separator(raw[3], true, false) {
            return StatePathPrefix{length: state_next_separator(raw, 4, false), verbatim: false, implicit_root: true}
        }
        server_end: state_next_separator(raw, 2, false)
        share_start := server_end
        if server_end < raw.len() -> share_start = server_end + 1
        share_end: state_next_separator(raw, share_start, false)
        if server_end > 2 && share_end > share_start {
            return StatePathPrefix{length: share_end, verbatim: false, implicit_root: true}
        }
    } else if state_drive(raw, 0) {
        return StatePathPrefix{length: 2, verbatim: false, implicit_root: false}
    }
    StatePathPrefix{length: 0, verbatim: false, implicit_root: false}
}

#Test("service state path text and lexical parents") {
    assert(!valid_store_text(""))
    assert(!valid_store_text("bad\npath"))
    control: String.from_bytes([U8]{194, 133}) ?? panic("Unicode control")
    assert(!valid_store_text(control))
    assert(valid_store_text("normal/../store"))
    assert(state_parent_lex("", false) == None)
    assert(state_parent_lex("/", false) == None)
    assert(state_parent_lex("///", false) == None)
    assert(state_parent_lex(".", false) == (Val("")))
    assert(state_parent_lex("./file", false) == (Val(".")))
    assert(state_parent_lex("file", false) == (Val("")))
    assert(state_parent_lex("dir/./file", false) == (Val("dir")))
    assert(state_parent_lex("dir//sub/file", false) == (Val("dir//sub")))
    assert(state_parent_lex("link/../store", false) == (Val("link/..")))
    assert(state_parent_lex("dir///./", false) == (Val("")))
    assert(state_parent_lex("/dir/file/", false) == (Val("/dir")))
    assert(state_parent_lex("C:\\dir\\file", true) == (Val("C:\\dir")))
    assert(state_parent_lex("C:\\file", true) == (Val("C:\\")))
    assert(state_parent_lex("C:file", true) == (Val("C:")))
    assert(state_parent_lex("C:\\", true) == None)
    assert(state_parent_lex("\\\\server\\share\\file", true) == (Val("\\\\server\\share\\")))
    assert(state_parent_lex("\\\\server\\share", true) == None)
    assert(state_parent_lex("\\\\?\\C:\\dir\\.\\file", true) == (Val("\\\\?\\C:\\dir\\.")))
    assert(state_parent_lex("\\\\.\\COM42\\file", true) == (Val("\\\\.\\COM42\\")))
}

// Durable state store: a versioned header, then length-framed records.
state_adapter_name: fn(adapter: __TreeStateAdapter) -> String Never! {
    if adapter == {
        .Empty -> "empty"
        .Snapshot -> "snapshot"
        .EventLog -> "event-log"
    }
}

state_record: fn(prefix: String, payload: String) -> String Never! {
    "{prefix}{workflow_frame(payload)}"
}

state_encode: fn(authority: __TreeStateAuthority, adapter: __TreeStateAdapter, records: [String]) -> [U8] ServiceError! {
    if records.len() > 100000 || (adapter == __TreeStateAdapter.Snapshot && records.len() > 1) {
        return Err(ServiceError.Policy("service state record limit exceeded"))
    }
    prefix: "v{authority.version}:"
    header: "JET-SERVICE-STATE/1\nadapter:{state_adapter_name(adapter)}\nschema:{workflow_frame(authority.schema)}\nversion:{authority.version}\nmigration:{workflow_frame(authority.migration)}\n"
    parts := [String]{header}
    size := header.bytes().len()
    loop record in records {
        read_state_record(prefix, record)
        if record.bytes().len() > 1048576 || !valid_record_payload(record) -> return Err(ServiceError.Policy("service state record contains invalid bytes"))
        frame: workflow_frame(record)
        size = size + frame.bytes().len()
        if size > 134217728 -> return Err(ServiceError.Policy("service state store exceeds its byte limit"))
        parts.push(frame)
    }
    Ok(parts.join("").bytes())
}

__StateCursor: struct {
    bytes: [U8]
    offset: Int
}

// Rust usize parsing: optional `+`, decimal digits only.
service_parse_count: fn(text: String) -> Int? Never! {
    if text.starts_with("-") -> return None
    workflow_i64(text)
}

state_read_line: fn(cursor: &__StateCursor, label: String) -> String ServiceError! {
    if cursor.offset > cursor.bytes.len() -> return Err(state_error("{label} is truncated"))
    end := cursor.offset
    loop end < cursor.bytes.len() && cursor.bytes[end] != (U8{10}) -> end = end + 1
    if end == cursor.bytes.len() -> return Err(state_error("{label} is truncated"))
    line: String.from_bytes(cursor.bytes.slice(cursor.offset, end)) ?? return Err(state_error("{label} is not valid UTF-8"))
    cursor.offset = end + 1
    Ok(line)
}

state_read_frame: fn(cursor: &__StateCursor, label: String) -> String ServiceError! {
    start: cursor.offset
    if start > cursor.bytes.len() -> return Err(state_error("{label} is truncated"))
    colon := start
    loop colon < cursor.bytes.len() && cursor.bytes[colon] != (U8{58}) -> colon = colon + 1
    if colon == cursor.bytes.len() -> return Err(state_error("{label} length is missing"))
    length_text: String.from_bytes(cursor.bytes.slice(start, colon)) ?? return Err(state_error("{label} length is invalid"))
    length: service_parse_count(length_text) ?? return Err(state_error("{label} length is invalid"))
    if length > 1048576 -> return Err(state_error("{label} exceeds the state record limit"))
    payload_end: colon + 1 + length
    if payload_end > cursor.bytes.len() -> return Err(state_error("{label} is truncated"))
    value: String.from_bytes(cursor.bytes.slice(colon + 1, payload_end)) ?? return Err(state_error("{label} is not valid UTF-8"))
    cursor.offset = payload_end
    Ok(value)
}

state_decode: fn(authority: __TreeStateAuthority, adapter: __TreeStateAdapter, bytes: [U8]) -> [String] ServiceError! {
    if bytes.len() > 134217728 -> return Err(state_error("service state store exceeds its byte limit"))
    cursor := __StateCursor{bytes: bytes, offset: 0}
    if state_read_line(cursor, "state magic") != "JET-SERVICE-STATE/1" -> return Err(state_error("service state magic is invalid"))
    if state_read_line(cursor, "state adapter") != "adapter:{state_adapter_name(adapter)}" {
        return Err(state_error("service state adapter does not match the declared adapter"))
    }
    schema_line: state_read_line(cursor, "state schema")
    if !schema_line.starts_with("schema:") -> return Err(state_error("service state schema header is invalid"))
    schema_parts: schema_line.removeprefix("schema:").split_once(":") ?? return Err(state_error("service state schema length is invalid"))
    schema_length: service_parse_count(schema_parts.before) ?? return Err(state_error("service state schema length is invalid"))
    if schema_length != schema_parts.after.bytes().len() || schema_length != authority.schema.bytes().len() || schema_length > 256 {
        return Err(state_error("service state schema length does not match the authority"))
    }
    if schema_parts.after != authority.schema -> return Err(state_error("service state schema does not match the authority"))
    version_line: state_read_line(cursor, "state version")
    if !version_line.starts_with("version:") -> return Err(state_error("service state version is invalid"))
    version: workflow_i64(version_line.removeprefix("version:")) ?? return Err(state_error("service state version is invalid"))
    if version != authority.version -> return Err(state_error("service state version {version} does not match authority version {authority.version}"))
    migration_line: state_read_line(cursor, "state migration")
    if !migration_line.starts_with("migration:") -> return Err(state_error("state migration header is invalid"))
    migration_parts: migration_line.removeprefix("migration:").split_once(":") ?? return Err(state_error("state migration length is invalid"))
    migration_length: service_parse_count(migration_parts.before) ?? return Err(state_error("state migration length is invalid"))
    if migration_length != migration_parts.after.bytes().len() || migration_length > 32 {
        return Err(state_error("state migration length does not match the authority"))
    }
    if migration_parts.after != authority.migration -> return Err(state_error("state migration policy does not match the authority"))
    prefix: "v{authority.version}:"
    records := [String]{}
    loop cursor.offset < cursor.bytes.len() {
        if records.len() >= 100000 -> return Err(state_error("service state record limit exceeded"))
        record: state_read_frame(cursor, "state record")
        read_state_record(prefix, record)
        records.push(record)
    }
    if adapter == __TreeStateAdapter.Snapshot && records.len() > 1 -> return Err(state_error("snapshot store contains more than one record"))
    Ok(records)
}

// Rejects a symlinked or non-regular store and any symlinked or non-directory
// ancestor; missing components are allowed.
state_validate_path: fn(path: String) ServiceError! {
    if service_path_kind(path) == {
        .Ok(kind) -> {
            if kind == 2 -> return Err(state_error("service state store must not be a symlink"))
            if kind != 0 -> return Err(state_error("service state store is not a regular file"))
        }
        .Err(.NotFound(_)) -> {}
        .Err(error) -> return Err(state_error("cannot inspect service state store: {stat_cause(error)}"))
    }
    windows: StatePathPlatform{}.windows()
    parent := state_parent_lex(path, windows)
    loop {
        ancestor: parent ?? break
        if service_path_kind(ancestor) == {
            .Ok(kind) -> {
                if kind == 2 -> return Err(state_error("service state parent is a symlink: {ancestor}"))
                if kind != 1 -> return Err(state_error("service state parent is not a directory: {ancestor}"))
            }
            .Err(.NotFound(_)) -> {}
            .Err(error) -> return Err(state_error("cannot inspect service state parent: {stat_cause(error)}"))
        }
        parent = state_parent_lex(ancestor, windows)
    }
}

state_read_unlocked: fn(authority: __TreeStateAuthority, adapter: __TreeStateAdapter) -> [String] ServiceError! {
    state_validate_path(authority.store)
    row := [Int]{}
    if service_stat(authority.store) == {
        .Ok(value) -> row = value
        .Err(.NotFound(_)) -> return Ok([String]{})
        .Err(error) -> return Err(state_error("cannot inspect service state store: {error}"))
    }
    if row[1] > 134217728 -> return Err(state_error("service state store exceeds its byte limit"))
    bytes: service_read_bytes(authority.store) ?? return Err(state_error("cannot read service state store: {err}"))
    state_decode(authority, adapter, bytes)
}

state_load: fn(authority: __TreeStateAuthority, adapter: __TreeStateAdapter) -> [String] ServiceError! {
    gate := authority_gate().guard_edit()
    lock: authority_file_lock(authority.store, "state")
    state_read_unlocked(authority, adapter)
}

__StateSequence: struct {
    next: Int
}

init_state_sequence: fn() -> Shared<__StateSequence> Never! {
    shared __StateSequence{next: 0}
}

state_temp_sequence: fn() -> Int Never! {
    sequence := core.mem.__process_shared(init_state_sequence).guard_edit()
    value: sequence.value.next
    sequence.value.next = value + 1
    value
}

state_write_unlocked: fn(authority: __TreeStateAuthority, adapter: __TreeStateAdapter, records: [String]) ServiceError! {
    bytes: state_encode(authority, adapter, records)
    state_validate_path(authority.store)
    state_create_parent(authority.store, "state")
    // Check again after creating missing directories.
    state_validate_path(authority.store)
    state_publish(authority.store, "{authority.store}.jet-state-{service_pid()}-{service_now()}-{state_temp_sequence()}", bytes, "state store")
}

state_create_parent: fn(path: String, label: String) ServiceError! {
    parent: state_parent_lex(path, StatePathPlatform{}.windows()) ?? return Ok()
    if parent == "" -> return Ok()
    if service_create_dirs(parent) == {
        .Err(error) -> Err(state_error("cannot create service {label} directory: {error}"))
        .Ok(_) -> Ok()
    }
}

// Write `bytes` to a private exclusive temporary, then rename it over `path`;
// a failed step removes the temporary.
state_publish: fn(path: String, temporary: String, bytes: [U8], label: String) ServiceError! {
    if service_create_private(temporary, bytes) == {
        .Err(error) -> {
            service_remove(temporary).drop("the temporary is removed best-effort")
            return Err(state_error("cannot write service {label}: {error}"))
        }
        .Ok(_) -> {}
    }
    if core.service.__host_rename(temporary, path) == {
        .Err(error) -> {
            service_remove(temporary).drop("the temporary is removed best-effort")
            Err(state_error("cannot publish service {label}: {error}"))
        }
        .Ok(_) -> Ok()
    }
}

state_write: fn(authority: __TreeStateAuthority, adapter: __TreeStateAdapter, records: [String]) ServiceError! {
    lock: authority_file_lock(authority.store, "state")
    state_write_unlocked(authority, adapter, records)
}

state_append: fn(authority: __TreeStateAuthority, record: String) ServiceError! {
    gate := authority_gate().guard_edit()
    lock: authority_file_lock(authority.store, "state")
    records: state_read_unlocked(authority, __TreeStateAdapter.EventLog)
    if records.len() >= 100000 -> return Err(ServiceError.Policy("event-log record limit exceeded"))
    row := [Int]{}
    if service_stat(authority.store) == {
        .Ok(value) -> row = value
        .Err(.NotFound(_)) -> return state_write_unlocked(authority, __TreeStateAdapter.EventLog, [String]{record})
        .Err(error) -> return Err(state_error("cannot inspect service state store before append: {error}"))
    }
    frame: workflow_frame(record).bytes()
    if row[1] > 134217728 - frame.len() -> return Err(ServiceError.Policy("service state store exceeds its byte limit"))
    if core.service.__host_append_bytes(authority.store, frame) == {
        .Err(error) -> return Err(state_error("cannot append state event: {error}"))
        .Ok(_) -> {}
    }
    if core.service.__host_fsync(authority.store) == {
        .Err(error) -> Err(state_error("cannot sync state event: {error}"))
        .Ok(_) -> Ok()
    }
}

// Rollout journal: the generation, upgrade receipt and per-worker route
// state, checksummed and published atomically beside the state store, so a
// restarted controller resumes the same rollout instead of guessing.
__RolloutWorker: struct {
    name: String
    generation: Int
}

__RolloutDirectory: struct {
    name: String
    worker: String
    generation: Int
}

__RolloutState: struct {
    generation: Int
    previous_generation: Int
    last_upgrade: ServiceUpgradeReceipt?
    workers: [__RolloutWorker]
    draining: [String]
    partitioned: [String]
    directory: [__RolloutDirectory]
}

rollout_snapshot: fn(tree: ServiceTree) -> __RolloutState Never! {
    workers := [__RolloutWorker]{}
    loop worker in tree.workers -> workers.push(__RolloutWorker{name: worker.name, generation: worker.endpoint.generation})
    directory := [__RolloutDirectory]{}
    loop record in tree.directory -> directory.push(__RolloutDirectory{name: record.name, worker: record.endpoint.worker, generation: record.endpoint.generation})
    __RolloutState{generation: tree.generation, previous_generation: tree.previous_generation, last_upgrade: tree.last_upgrade, workers: workers, draining: tree.draining, partitioned: tree.partitioned, directory: directory}
}

rollout_scalar: fn(lines: &[String], label: String, value: String) Never! {
    lines.push("{label}:{value}\n")
}

rollout_frame: fn(lines: &[String], label: String, value: String) ServiceError! {
    if !workflow_visible(value, 1048576) -> return Err(state_error("rollout journal {label} contains invalid text"))
    lines.push("{label}:{workflow_frame(value)}\n")
}

rollout_encode: fn(tree_name: String, state: __RolloutState) -> [U8] ServiceError! {
    lines := [String]{"JET-SERVICE-ROLLOUT/1\n"}
    rollout_frame(lines, "tree", tree_name)
    rollout_scalar(lines, "generation", "{state.generation}")
    rollout_scalar(lines, "previous", "{state.previous_generation}")
    if state.last_upgrade == {
        .None -> rollout_scalar(lines, "upgrade", "none")
        .Val(receipt) -> {
            rollout_scalar(lines, "upgrade", "present")
            rollout_scalar(lines, "upgrade_from", "{receipt.from_generation}")
            rollout_scalar(lines, "upgrade_to", "{receipt.to_generation}")
            rollout_frame(lines, "upgrade_migration", receipt.migration)
            rollout_frame(lines, "upgrade_store", receipt.rollback_store)
            rollout_scalar(lines, "upgrade_available", if receipt.rollback_available -> "1" else -> "0")
            rollout_scalar(lines, "pinned_count", "{receipt.pinned_shards.len()}")
            loop name in receipt.pinned_shards -> rollout_frame(lines, "pinned", name)
        }
    }
    rollout_scalar(lines, "worker_count", "{state.workers.len()}")
    loop worker in state.workers {
        rollout_frame(lines, "worker", worker.name)
        rollout_scalar(lines, "worker_generation", "{worker.generation}")
    }
    rollout_scalar(lines, "draining_count", "{state.draining.len()}")
    loop name in state.draining -> rollout_frame(lines, "draining", name)
    rollout_scalar(lines, "partitioned_count", "{state.partitioned.len()}")
    loop name in state.partitioned -> rollout_frame(lines, "partitioned", name)
    rollout_scalar(lines, "directory_count", "{state.directory.len()}")
    loop entry in state.directory {
        rollout_frame(lines, "directory_name", entry.name)
        rollout_frame(lines, "directory_worker", entry.worker)
        rollout_scalar(lines, "directory_generation", "{entry.generation}")
    }
    body: lines.join("")
    checksum: service_encoding.bytes_to_hex(service_crypto.sha256(body.bytes()).bytes)
    bytes: "{body}checksum:{checksum}\n".bytes()
    if bytes.len() > 4194304 -> return Err(state_error("rollout journal exceeds its byte limit"))
    Ok(bytes)
}

// Text lines as Rust `str::lines` yields them: a trailing `\r` is dropped.
__RolloutLines: struct {
    lines: [String]
    next: Int
}

rollout_read_line: fn(lines: &__RolloutLines, label: String) -> String ServiceError! {
    if lines.next >= lines.lines.len() -> return Err(state_error("rollout journal {label} is truncated"))
    line: lines.lines[lines.next]
    lines.next = lines.next + 1
    prefix: "{label}:"
    if !line.starts_with(prefix) -> return Err(state_error("rollout journal {label} is invalid"))
    Ok(line.removeprefix(prefix))
}

rollout_read_scalar: fn(lines: &__RolloutLines, label: String) -> Int ServiceError! {
    text: rollout_read_line(lines, label)
    workflow_i64(text) ?? return Err(state_error("rollout journal {label} is invalid"))
}

rollout_read_count: fn(lines: &__RolloutLines, label: String) -> Int ServiceError! {
    text: rollout_read_line(lines, label)
    count: service_parse_count(text) ?? return Err(state_error("rollout journal {label} is invalid"))
    if count > 4096 -> return Err(state_error("rollout journal {label} exceeds the worker limit"))
    Ok(count)
}

rollout_read_bool: fn(lines: &__RolloutLines, label: String) -> Bool ServiceError! {
    text: rollout_read_line(lines, label)
    if text == "0" -> return Ok(false)
    if text == "1" -> return Ok(true)
    Err(state_error("rollout journal {label} is invalid"))
}

rollout_read_frame: fn(lines: &__RolloutLines, label: String) -> String ServiceError! {
    value: rollout_read_line(lines, label)
    parts: value.split_once(":") ?? return Err(state_error("rollout journal {label} length is missing"))
    length: service_parse_count(parts.before) ?? return Err(state_error("rollout journal {label} length is invalid"))
    if length != parts.after.bytes().len() || length > 1048576 || !workflow_visible(parts.after, 1048576) {
        return Err(state_error("rollout journal {label} frame is invalid"))
    }
    Ok(parts.after)
}

rollout_name: fn(value: String, label: String) ServiceError! {
    if value.trim() == "" || !valid_service_text(value, 256) -> return Err(state_error("rollout journal {label} is not a valid service name"))
}

// The start of the last `\nchecksum:` in `bytes`.
rollout_checksum_marker: fn(bytes: [U8]) -> Int? Never! {
    marker: "\nchecksum:".bytes()
    start := bytes.len() - marker.len()
    loop start >= 0 {
        matched := true
        loop offset in 0..<marker.len() {
            if bytes[start + offset] != marker[offset] {
                matched = false
                break
            }
        }
        if matched -> return Val(start)
        start = start - 1
    }
    None
}

rollout_names_contain: fn(names: [String], name: String) -> Bool Never! {
    worker_contains(names, name)
}

rollout_decode: fn(tree_name: String, bytes: [U8]) -> __RolloutState ServiceError! {
    if bytes.len() > 4194304 || bytes.len() == 0 || bytes[bytes.len() - 1] != (U8{10}) {
        return Err(state_error("rollout journal exceeds its byte limit or is not newline terminated"))
    }
    marker: rollout_checksum_marker(bytes) ?? return Err(state_error("rollout journal checksum is missing"))
    checksum: String.from_bytes(bytes.slice(marker + 10, bytes.len() - 1)) ?? return Err(state_error("rollout journal checksum is not valid UTF-8"))
    if checksum.bytes().len() != 64 -> return Err(state_error("rollout journal checksum is invalid"))
    loop byte in checksum.bytes() {
        if authority_hex_digit(Int.from_u8(byte)) == None -> return Err(state_error("rollout journal checksum is invalid"))
    }
    content: bytes.slice(0, marker + 1)
    if checksum != service_encoding.bytes_to_hex(service_crypto.sha256(content).bytes) -> return Err(state_error("rollout journal checksum does not match its contents"))
    text: String.from_bytes(content) ?? return Err(state_error("rollout journal is not valid UTF-8"))
    pieces: text.split("\n").to_list()
    collected := [String]{}
    loop index in 0..<pieces.len() - 1 {
        piece: pieces[index]
        collected.push(if piece.ends_with("\r") -> piece.removesuffix("\r") else -> piece)
    }
    lines := __RolloutLines{lines: collected, next: 0}
    if lines.lines.len() == 0 || lines.lines[0] != "JET-SERVICE-ROLLOUT/1" -> return Err(state_error("rollout journal magic is invalid"))
    lines.next = 1
    if rollout_read_frame(lines, "tree") != tree_name -> return Err(state_error("rollout journal belongs to a different service tree"))
    generation: rollout_read_scalar(lines, "generation")
    previous: rollout_read_scalar(lines, "previous")
    if generation < 1 || previous < 0 || previous >= generation -> return Err(state_error("rollout journal generation order is invalid"))
    marker_text: rollout_read_line(lines, "upgrade")
    last_upgrade := ServiceUpgradeReceipt?{None}
    if marker_text == "present" {
        from_generation: rollout_read_scalar(lines, "upgrade_from")
        to_generation: rollout_read_scalar(lines, "upgrade_to")
        migration: rollout_read_frame(lines, "upgrade_migration")
        rollback_store: rollout_read_frame(lines, "upgrade_store")
        rollback_available: rollout_read_bool(lines, "upgrade_available")
        pinned_count: rollout_read_count(lines, "pinned_count")
        pinned := [String]{}
        loop _ in 0..<pinned_count {
            name: rollout_read_frame(lines, "pinned")
            rollout_name(name, "pinned shard")
            if rollout_names_contain(pinned, name) -> return Err(state_error("rollout journal contains a duplicate pinned shard"))
            pinned.push(name)
        }
        if from_generation < 1 || to_generation <= from_generation || to_generation != generation || from_generation != previous {
            return Err(state_error("rollout journal receipt generations do not match the active generation"))
        }
        if migration != "reversible" && migration != "dual_write" && migration != "forward_only" {
            return Err(ServiceError.Policy("unknown migration policy {migration:Debug}; write \"reversible\", \"dual_write\", or \"forward_only\""))
        }
        if rollback_available != (rollback_store != "") -> return Err(state_error("rollout journal rollback availability is inconsistent"))
        last_upgrade = Val(ServiceUpgradeReceipt{from_generation: from_generation, to_generation: to_generation, migration: migration, rollback_store: rollback_store, rollback_available: rollback_available, pinned_shards: pinned})
    } else if marker_text != "none" {
        return Err(state_error("rollout journal upgrade marker is invalid"))
    }
    if last_upgrade == None && previous != 0 -> return Err(state_error("rollout journal has a previous generation without a receipt"))
    worker_count: rollout_read_count(lines, "worker_count")
    workers := [__RolloutWorker]{}
    loop _ in 0..<worker_count {
        name: rollout_read_frame(lines, "worker")
        rollout_name(name, "worker")
        worker_generation: rollout_read_scalar(lines, "worker_generation")
        pinned_generation: if last_upgrade == {
            .Val(receipt) -> worker_generation == receipt.from_generation
            .None -> false
        }
        if worker_generation < 1 || (worker_generation != generation && !pinned_generation) -> return Err(state_error("rollout journal worker generation is not allowed"))
        loop seen in workers {
            if seen.name == name -> return Err(state_error("rollout journal contains a duplicate worker"))
        }
        workers.push(__RolloutWorker{name: name, generation: worker_generation})
    }
    draining_count: rollout_read_count(lines, "draining_count")
    draining := [String]{}
    loop _ in 0..<draining_count {
        name: rollout_read_frame(lines, "draining")
        rollout_name(name, "draining worker")
        if rollout_names_contain(draining, name) -> return Err(state_error("rollout journal contains a duplicate draining worker"))
        draining.push(name)
    }
    partitioned_count: rollout_read_count(lines, "partitioned_count")
    partitioned := [String]{}
    loop _ in 0..<partitioned_count {
        name: rollout_read_frame(lines, "partitioned")
        rollout_name(name, "partitioned worker")
        if rollout_names_contain(partitioned, name) || rollout_names_contain(draining, name) -> return Err(state_error("rollout journal has overlapping or duplicate worker state"))
        partitioned.push(name)
    }
    directory_count: rollout_read_count(lines, "directory_count")
    directory := [__RolloutDirectory]{}
    loop _ in 0..<directory_count {
        name: rollout_read_frame(lines, "directory_name")
        worker: rollout_read_frame(lines, "directory_worker")
        rollout_name(name, "directory name")
        rollout_name(worker, "directory worker")
        worker_generation: rollout_read_scalar(lines, "directory_generation")
        duplicate := false
        loop seen in directory {
            if seen.name == name -> duplicate = true
        }
        if worker_generation < 1 || duplicate -> return Err(state_error("rollout journal directory entry is invalid"))
        directory.push(__RolloutDirectory{name: name, worker: worker, generation: worker_generation})
    }
    if lines.next < lines.lines.len() -> return Err(state_error("rollout journal has trailing records"))
    Ok(__RolloutState{generation: generation, previous_generation: previous, last_upgrade: last_upgrade, workers: workers, draining: draining, partitioned: partitioned, directory: directory})
}

rollout_path: fn(authority: __TreeStateAuthority) -> String ServiceError! {
    path: "{authority.store}.rollout"
    authority_validate_text(path, "service rollout journal", 4096, false)
    state_validate_path(path)
    Ok(path)
}

rollback_store_path: fn(authority: __TreeStateAuthority, generation: Int) -> String ServiceError! {
    path: "{authority.store}.rollback-g{generation}"
    authority_validate_text(path, "service rollback store", 4096, false)
    Ok(path)
}

// The state authority with its store moved to `store`.
state_authority_at: fn(authority: __TreeStateAuthority, store: String) -> __TreeStateAuthority Never! {
    __TreeStateAuthority{store: store, schema: authority.schema, version: authority.version, migration: authority.migration, adapter: authority.adapter}
}

// Serializes lifecycle operations across controllers of one state store.
rollout_operation_lock: fn(tree: ServiceTree) -> __ServiceFileLock ServiceError! {
    authority: tree.state_authority ?? return Ok(__ServiceFileLock{path: ""})
    authority_file_lock(authority.store, "rollout-operation")
}

rollout_store_load: fn(tree: ServiceTree) -> __RolloutState? ServiceError! {
    authority: tree.state_authority ?? return Ok(None)
    path: rollout_path(authority)
    gate := authority_gate().guard_edit()
    lock: authority_file_lock(path, "rollout")
    row := [Int]{}
    if service_stat(path) == {
        .Ok(value) -> row = value
        .Err(_) -> return Ok(None)
    }
    if row[1] > 4194304 -> return Err(state_error("service rollout journal exceeds its byte limit"))
    bytes: service_read_bytes(path) ?? return Err(state_error("cannot read service rollout journal: {err}"))
    Ok(Val(rollout_decode(tree.name, bytes)))
}

rollout_store_write: fn(tree: ServiceTree) ServiceError! {
    authority: tree.state_authority ?? return Ok()
    path: rollout_path(authority)
    bytes: rollout_encode(tree.name, rollout_snapshot(tree))
    gate := authority_gate().guard_edit()
    lock: authority_file_lock(path, "rollout")
    state_create_parent(path, "rollout")
    state_validate_path(path)
    state_publish(path, "{path}.jet-rollout-{service_pid()}-{service_now()}-{state_temp_sequence()}", bytes, "rollout journal")
}

rollout_store_assert_current: fn(tree: ServiceTree) ServiceError! {
    loaded: rollout_store_load(tree)
    persisted: loaded ?? return Ok()
    if persisted != rollout_snapshot(tree) -> return Err(ServiceError.Stale("service rollout state changed since this controller started"))
}

service_is_file: fn(path: String) -> Bool Never! {
    if service_path_kind(path) == {
        .Ok(kind) -> kind == 0
        .Err(_) -> false
    }
}

// Re-apply a persisted rollout to a freshly declared tree before start: the
// journal wins over the declaration's default generation and route state.
restore_rollout_state: fn(tree: &ServiceTree) ServiceError! {
    loaded: rollout_store_load(tree)
    state: loaded ?? return Ok()
    if state.workers.len() != tree.workers.len() -> return Err(state_error("rollout journal worker topology does not match the service declaration"))
    if state.last_upgrade == {
        .Val(receipt) -> {
            if receipt.rollback_available {
                authority: tree.state_authority ?? return Err(state_error("rollout receipt has no state authority"))
                if receipt.rollback_store != rollback_store_path(authority, receipt.from_generation) {
                    return Err(state_error("rollout receipt names a rollback store outside its state authority"))
                }
                state_validate_path(receipt.rollback_store)
                if !service_is_file(receipt.rollback_store) -> return Err(state_error("rollout receipt names a missing rollback store"))
                _: state_load(state_authority_at(authority, receipt.rollback_store), tree.state_adapter)
            }
        }
        .None -> {}
    }
    generations := [Int]{}
    loop worker in tree.workers {
        found := 0
        loop entry in state.workers {
            if entry.name == worker.name {
                found = entry.generation
                break
            }
        }
        if found < 1 -> return Err(state_error("rollout journal is missing worker {worker.name}"))
        generations.push(found)
    }
    loop entry in state.directory {
        recorded := 0
        loop candidate in state.workers {
            if candidate.name == entry.worker {
                recorded = candidate.generation
                break
            }
        }
        if recorded < 1 || worker_named(tree, entry.worker) == None -> return Err(state_error("rollout journal directory entry {entry.name} names an unknown worker"))
        if recorded != entry.generation -> return Err(state_error("rollout journal directory generation is inconsistent"))
    }
    tree.generation = state.generation
    tree.previous_generation = state.previous_generation
    tree.last_upgrade = state.last_upgrade
    tree.draining = state.draining
    tree.partitioned = state.partitioned
    loop index in 0..<tree.workers.len() {
        tree.workers[index].endpoint.generation = generations[index]
        endpoint: tree.workers[index].endpoint
        authority_register(endpoint, false, Val(tree.workers[index].channel))
        authority_update_partitioned(endpoint, worker_contains(tree.partitioned, endpoint.worker))
        authority_update_draining(endpoint, worker_contains(tree.draining, endpoint.worker))
    }
    tree.directory.clear()
    loop entry in state.directory {
        index: worker_named(tree, entry.worker) ?? return Err(ServiceError.Unknown("restored directory worker disappeared"))
        endpoint: tree.workers[index].endpoint
        if endpoint.generation != entry.generation -> return Err(state_error("rollout journal directory generation does not match its worker"))
        tree.directory.push(__DirectoryRecord{name: entry.name, endpoint: endpoint, proof: directory_sign(tree.authority, tree.name, entry.name, endpoint)})
    }
}

// Workflows. The durable `{store}.workflows` event log is the source of
// truth; the tree's copy carries only a runtime replay cursor on top.
__ActivityOutcome: struct {
    key: String
    outcome: TaskOutcome
}

__TreeWorkflowState: struct {
    id: String
    run_id: Int
    version: Int
    steps: [String]
    history: [String]
    replay_cursor: Int
    status: TaskStatus
    activity_outcomes: [__ActivityOutcome]
    outcome: TaskOutcome?
}

// A handle detached from its tree: wait points append through the same
// durable log under the workflow file lock.
ServiceWorkflow: struct {
    priv run_id: Int
    priv authority: __TreeStateAuthority
    priv state: Shared<__TreeWorkflowState>

    impl Display {
        display: fn(self) -> String { "{self.run_id}" }
    }
}

// Workflow tree methods take a run as its id or its handle.
workflow_run_id: fn(run: Int | ServiceWorkflow) -> Int Never! {
    if run == {
        .Int(id) -> id
        .ServiceWorkflow(workflow) -> workflow.run_id
    }
}

workflow_authority: fn(tree: ServiceTree) -> __TreeStateAuthority ServiceError! {
    authority: tree.state_authority ?? return Err(ServiceError.Policy("durable workflow history needs the injected service state authority"))
    store: "{authority.store}.workflows"
    authority_validate_text(store, "service workflow store", 4096, false)
    Ok(__TreeStateAuthority{store: store, schema: authority.schema, version: authority.version, migration: authority.migration, adapter: __TreeStateAdapter.EventLog})
}

workflow_handle: fn(tree: ServiceTree, run_id: Int) -> ServiceWorkflow ServiceError! {
    authority: workflow_authority(tree)
    loop workflow in tree.workflows {
        if workflow.run_id == run_id {
            return Ok(ServiceWorkflow{run_id: run_id, authority: authority, state: shared __TreeWorkflowState{
                id: workflow.id,
                run_id: workflow.run_id,
                version: workflow.version,
                steps: workflow.steps,
                history: workflow.history,
                replay_cursor: workflow.replay_cursor,
                status: workflow.status,
                activity_outcomes: workflow.activity_outcomes,
                outcome: workflow.outcome,
            }})
        }
    }
    Err(ServiceError.Unknown("workflow run {run_id} not found"))
}

workflow_replay_authority: fn(authority: __TreeStateAuthority) -> [__TreeWorkflowState] ServiceError! {
    records: state_load(authority, __TreeStateAdapter.EventLog)
    prefix: "v{authority.version}:"
    workflows := [__TreeWorkflowState]{}
    loop record in records {
        workflow_apply(workflows, read_state_record(prefix, record))
    }
    if workflows.len() > 100000 -> return Err(state_error("workflow run limit exceeded"))
    Ok(workflows)
}

workflow_replay: fn(tree: ServiceTree) -> [__TreeWorkflowState] ServiceError! {
    workflow_replay_authority(workflow_authority(tree))
}

// Reload from the durable log, keeping each run's in-memory replay cursor.
workflow_sync_tree: fn(tree: &ServiceTree) ServiceError! {
    workflows := workflow_replay(tree)
    loop index in 0..<workflows.len() {
        workflows[index].replay_cursor = workflow_cursor(tree.workflows, workflows[index].run_id)
    }
    tree.workflows = workflows
}

workflow_cursor: fn(workflows: [__TreeWorkflowState], run_id: Int) -> Int Never! {
    loop workflow in workflows {
        if workflow.run_id == run_id -> return workflow.replay_cursor
    }
    0
}

// `{length}:{value}` where the value is the entire remainder.
workflow_field: fn(input: String, label: String) -> String ServiceError! {
    parts: input.split_once(":") ?? return Err(state_error("workflow {label} length is missing"))
    length: service_parse_count(parts.before) ?? return Err(state_error("workflow {label} length is invalid"))
    if length != parts.after.bytes().len() || !workflow_visible(parts.after, 9223372036854775807) {
        return Err(state_error("workflow {label} length or contents are invalid"))
    }
    Ok(parts.after)
}

__WorkflowField: struct {
    value: String
    rest: String
}

// `{length}:{value}{rest}`; the length is in bytes and must end on a
// character boundary.
workflow_take_field: fn(input: String, label: String) -> __WorkflowField ServiceError! {
    parts: input.split_once(":") ?? return Err(state_error("workflow {label} length is missing"))
    length: service_parse_count(parts.before) ?? return Err(state_error("workflow {label} length is invalid"))
    raw: parts.after.bytes()
    if length > raw.len() -> return Err(state_error("workflow {label} length is not a character boundary"))
    value: String.from_bytes(raw.slice(0, length)) ?? return Err(state_error("workflow {label} length is not a character boundary"))
    rest: String.from_bytes(raw.slice(length, raw.len())) ?? return Err(state_error("workflow {label} length is invalid"))
    if !workflow_visible(value, 9223372036854775807) -> return Err(state_error("workflow {label} contains control characters"))
    Ok(__WorkflowField{value: value, rest: rest})
}

workflow_token_valid: fn(text: String) -> Bool Never! {
    text.trim() != "" && workflow_visible(text, 256) && !text.contains(":")
}

workflow_outcome_from_wire: fn(value: String) -> TaskOutcome ServiceError! {
    if value == "Finished" -> return Ok(TaskOutcome.Finished)
    if value == "Cancelled" -> return Ok(TaskOutcome.Cancelled)
    if value == "DeadlineBlown" -> return Ok(TaskOutcome.DeadlineBlown)
    if !value.starts_with("Panicked:") -> return Err(state_error("unknown task outcome"))
    outcome: TaskOutcome.Panicked(workflow_field(value.removeprefix("Panicked:"), "panic reason"))
    if !workflow_valid_outcome(outcome) -> return Err(state_error("invalid task outcome"))
    Ok(outcome)
}

workflow_step_valid: fn(step: String) -> Bool Never! {
    if step.trim() == "" || !workflow_visible(step, 1048576) -> return false
    markers: [String]{"time.", "random", "rand.", "io.", "channel", "spawn", "service.connect"}
    loop marker in markers {
        if step.contains(marker) -> return false
    }
    true
}

workflow_split: fn(text: String, label: String) -> __WorkflowField ServiceError! {
    parts: text.split_once(":") ?? return Err(state_error("workflow {label} is missing"))
    Ok(__WorkflowField{value: parts.before, rest: parts.after})
}

workflow_parse_int: fn(text: String, label: String) -> Int ServiceError! {
    workflow_i64(text) ?? return Err(state_error("workflow {label} is invalid"))
}

workflow_index_of: fn(workflows: [__TreeWorkflowState], run_id: Int, label: String) -> Int ServiceError! {
    loop index in 0..<workflows.len() {
        if workflows[index].run_id == run_id -> return Ok(index)
    }
    Err(state_error("workflow {label} has no start record"))
}

// After every activity has completed, the first failed activity outcome is
// the run's outcome, otherwise Finished.
workflow_refresh_outcome: fn(workflow: &__TreeWorkflowState) Never! {
    keys := 0
    loop step in workflow.steps {
        definition: workflow_activity_parts(step) ?? next
        keys = keys + 1
        if workflow_activity_outcome(workflow.activity_outcomes, definition.key) == None {
            workflow.outcome = None
            return
        }
    }
    if keys == 0 {
        workflow.outcome = None
        return
    }
    loop pair in workflow.activity_outcomes {
        if pair.outcome != TaskOutcome.Finished {
            workflow.outcome = Val(pair.outcome)
            return
        }
    }
    workflow.outcome = Val(TaskOutcome.Finished)
}

// The one reader of a workflow record. Writers reach the in-memory history
// only through it, so a record that cannot be replayed is never written.
workflow_apply: fn(workflows: &[__TreeWorkflowState], payload: String) ServiceError! {
    if payload.starts_with("workflow-start:") {
        run: workflow_split(payload.removeprefix("workflow-start:"), "start run id")
        run_id: workflow_parse_int(run.value, "start run id")
        version_field: workflow_split(run.rest, "start version")
        version: workflow_parse_int(version_field.value, "start version")
        id: workflow_field(version_field.rest, "id")
        if run_id <= 0 || version < 1 || id.trim() == "" || id.bytes().len() > 256 -> return Err(state_error("workflow start contains invalid identity"))
        loop workflow in workflows {
            if workflow.run_id == run_id || (workflow.id == id && workflow.version == version) -> return Err(state_error("workflow log contains a duplicate start record"))
        }
        workflows.push(__TreeWorkflowState{id: id, run_id: run_id, version: version, steps: [String]{}, history: [String]{"start@v{version}"}, replay_cursor: 0, status: TaskStatus.Running, activity_outcomes: [__ActivityOutcome]{}, outcome: None})
    } else if payload.starts_with("workflow-step:") {
        run: workflow_split(payload.removeprefix("workflow-step:"), "step run id")
        run_id: workflow_parse_int(run.value, "step run id")
        step: workflow_field(run.rest, "step")
        if !workflow_step_valid(step) -> return Err(state_error("workflow step contains invalid contents"))
        index: workflow_index_of(workflows, run_id, "step")
        if workflows[index].outcome != None -> return Err(state_error("workflow step follows a terminal workflow outcome"))
        if workflows[index].steps.len() >= 100000 -> return Err(state_error("workflow step history limit exceeded"))
        workflows[index].steps.push(step.copy()) // copy: the step text is kept in both steps and history
        workflows[index].history.push("step:{step}")
    } else if payload.starts_with("workflow-wait-sleep:") {
        fields: payload.removeprefix("workflow-wait-sleep:").split_once(":") ?? return Err(state_error("workflow sleep run id or duration is missing"))
        run_id: workflow_parse_int(fields.before, "sleep run id")
        nanos: workflow_parse_int(fields.after, "sleep duration")
        if run_id < 1 -> return Err(state_error("workflow sleep run id is invalid"))
        index: workflow_index_of(workflows, run_id, "sleep")
        if workflows[index].outcome != None -> return Err(state_error("workflow sleep follows a terminal workflow outcome"))
        workflows[index].history.push("sleep:{nanos}")
        workflows[index].status = TaskStatus.Running
    } else if payload.starts_with("workflow-wait-sleep-cancelled:") {
        run_id: workflow_parse_int(payload.removeprefix("workflow-wait-sleep-cancelled:"), "cancelled sleep run id")
        if run_id < 1 -> return Err(state_error("workflow cancelled sleep run id is invalid"))
        index: workflow_index_of(workflows, run_id, "cancelled sleep")
        if workflows[index].outcome != None || !workflow_last_is_sleep(workflows[index].history) -> return Err(state_error("workflow cancelled sleep is out of order"))
        workflows[index].history.push("sleep-cancelled")
        workflows[index].status = TaskStatus.CancelRequested
        workflows[index].outcome = Val(TaskOutcome.Cancelled)
    } else if payload.starts_with("workflow-wait-sleep-deadline:") {
        run_id: workflow_parse_int(payload.removeprefix("workflow-wait-sleep-deadline:"), "deadline sleep run id")
        if run_id < 1 -> return Err(state_error("workflow deadline sleep run id is invalid"))
        index: workflow_index_of(workflows, run_id, "deadline sleep")
        if workflows[index].outcome != None || !workflow_last_is_sleep(workflows[index].history) -> return Err(state_error("workflow deadline sleep is out of order"))
        workflows[index].history.push("sleep-deadline")
        workflows[index].status = TaskStatus.Paused
        workflows[index].outcome = Val(TaskOutcome.DeadlineBlown)
    } else if payload.starts_with("workflow-wait-activity:") {
        run: workflow_split(payload.removeprefix("workflow-wait-activity:"), "activity wait run id")
        run_id: workflow_parse_int(run.value, "activity wait run id")
        activity: workflow_take_field(run.rest, "wait activity")
        argument: workflow_take_field(activity.rest, "wait argument")
        if run_id < 1 || argument.rest != "" || !workflow_token_valid(activity.value) || !workflow_visible(argument.value, 1048576) {
            return Err(state_error("workflow activity wait contains invalid fields"))
        }
        index: workflow_index_of(workflows, run_id, "activity wait")
        if workflows[index].outcome != None -> return Err(state_error("workflow activity wait follows a terminal workflow outcome"))
        workflows[index].history.push("activity:{activity.value}:{argument.value}")
        workflows[index].status = TaskStatus.Running
    } else if payload.starts_with("workflow-wait-all:") {
        run: workflow_split(payload.removeprefix("workflow-wait-all:"), "all wait run id")
        run_id: workflow_parse_int(run.value, "all wait run id")
        count_field: workflow_split(run.rest, "all wait count")
        count: service_parse_count(count_field.value) ?? return Err(state_error("workflow all wait count is invalid"))
        if run_id < 1 || count > 100000 -> return Err(state_error("workflow all wait count is outside the bounded range"))
        values := [String]{}
        rest := count_field.rest
        loop _ in 0..<count {
            field: workflow_take_field(rest, "all wait value")
            if field.value.bytes().len() > 1048576 -> return Err(state_error("workflow all wait value is too large"))
            values.push(field.value)
            rest = field.rest
        }
        if rest != "" -> return Err(state_error("workflow all wait contains trailing fields"))
        index: workflow_index_of(workflows, run_id, "all wait")
        if workflows[index].outcome != None -> return Err(state_error("workflow all wait follows a terminal workflow outcome"))
        workflows[index].history.push("all:{values.join(",")}")
        workflows[index].status = TaskStatus.Running
    } else if payload.starts_with("workflow-activity:") {
        run: workflow_split(payload.removeprefix("workflow-activity:"), "activity run id")
        run_id: workflow_parse_int(run.value, "activity run id")
        attempt_field: workflow_split(run.rest, "activity attempt")
        attempt: workflow_parse_int(attempt_field.value, "activity attempt")
        limit_field: workflow_split(attempt_field.rest, "activity retry limit")
        max_attempts: workflow_parse_int(limit_field.value, "activity retry limit")
        activity: workflow_take_field(limit_field.rest, "activity")
        key: workflow_take_field(activity.rest, "idempotency key")
        if !workflow_token_valid(activity.value) || !workflow_token_valid(key.value) || run_id < 1 || attempt != 1 || max_attempts < 1 || max_attempts > 1000 || key.rest != "" {
            return Err(state_error("workflow activity start contains invalid fields"))
        }
        index: workflow_index_of(workflows, run_id, "activity")
        if workflows[index].outcome != None -> return Err(state_error("workflow activity follows a terminal workflow outcome"))
        if workflow_activity_definition(workflows[index], key.value) != None -> return Err(state_error("workflow log contains a duplicate activity key"))
        workflows[index].steps.push("activity:{activity.value}:{key.value}:{attempt}:{max_attempts}")
        workflows[index].history.push("activity:{activity.value}:{key.value}@{attempt}/{max_attempts}")
        workflows[index].status = TaskStatus.Running
    } else if payload.starts_with("workflow-activity-retry:") {
        run: workflow_split(payload.removeprefix("workflow-activity-retry:"), "activity retry run id")
        run_id: workflow_parse_int(run.value, "activity retry run id")
        attempt_field: workflow_split(run.rest, "activity retry attempt")
        attempt: workflow_parse_int(attempt_field.value, "activity retry attempt")
        key: workflow_take_field(attempt_field.rest, "idempotency key")
        wire: workflow_take_field(key.rest, "activity attempt outcome")
        outcome: workflow_outcome_from_wire(wire.value)
        if run_id < 1 || attempt < 2 || attempt > 1000 || wire.rest != "" || outcome == TaskOutcome.Finished || !workflow_token_valid(key.value) {
            return Err(state_error("workflow activity retry contains invalid fields"))
        }
        index: workflow_index_of(workflows, run_id, "retry")
        if workflows[index].outcome != None || workflow_activity_outcome(workflows[index].activity_outcomes, key.value) != None {
            return Err(state_error("workflow retry follows a terminal activity"))
        }
        definition: workflow_activity_definition(workflows[index], key.value) ?? return Err(state_error("workflow retry has no activity"))
        if attempt != definition.attempt + 1 || attempt > definition.max_attempts -> return Err(state_error("workflow activity retry is out of order or exceeds its limit"))
        workflows[index].steps[definition.index] = "activity:{definition.activity}:{key.value}:{attempt}:{definition.max_attempts}"
        workflows[index].history.push("activity-retry:{key.value}@{attempt}/{definition.max_attempts}:{task_outcome_show(outcome)}")
        workflows[index].status = TaskStatus.Paused
    } else if payload.starts_with("workflow-activity-done:") {
        run: workflow_split(payload.removeprefix("workflow-activity-done:"), "activity completion run id")
        run_id: workflow_parse_int(run.value, "activity completion run id")
        key: workflow_take_field(run.rest, "idempotency key")
        wire: workflow_take_field(key.rest, "activity outcome")
        outcome: workflow_outcome_from_wire(wire.value)
        if run_id < 1 || wire.rest != "" || !workflow_token_valid(key.value) -> return Err(state_error("workflow activity completion contains invalid fields"))
        index: workflow_index_of(workflows, run_id, "completion")
        if workflow_activity_definition(workflows[index], key.value) == None -> return Err(state_error("workflow completion has no activity record"))
        if workflow_activity_outcome(workflows[index].activity_outcomes, key.value) != None -> return Err(state_error("workflow log contains a duplicate activity completion"))
        workflows[index].history.push("activity-done:{key.value}")
        workflows[index].history.push("activity-result:{task_outcome_show(outcome)}")
        workflows[index].activity_outcomes.push(__ActivityOutcome{key: key.value, outcome: outcome})
        workflow_refresh_outcome(workflows[index])
    } else {
        return Err(state_error("workflow log contains an unknown record"))
    }
    // One bound for every record kind: history carries the start entry and
    // retries on top of steps.
    if workflows.len() > 100000 -> return Err(state_error("workflow history limit exceeded"))
    loop workflow in workflows {
        if workflow.steps.len() > 100000 || workflow.history.len() > 100000 -> return Err(state_error("workflow history limit exceeded"))
    }
}

workflow_last_is_sleep: fn(history: [String]) -> Bool Never! {
    history.len() > 0 && history[history.len() - 1].starts_with("sleep:")
}

// Append one record after replaying it onto the durable log, so a record the
// reader would reject never reaches the store and drifted history is
// reported instead of extended. The workflow file lock orders writers.
workflow_append: fn(tree: &ServiceTree, payload: String) ServiceError! {
    authority: workflow_authority(tree)
    lock: authority_file_lock(authority.store, "workflow")
    applied := workflow_replay_authority(authority)
    loop index in 0..<applied.len() {
        loop current in tree.workflows {
            if current.run_id == applied[index].run_id -> applied[index].replay_cursor = current.replay_cursor
        }
    }
    if applied != tree.workflows -> return Err(state_error("in-memory workflow history does not match the durable workflow log"))
    workflow_apply(applied, payload)
    if applied.len() > 100000 -> return Err(ServiceError.Policy("workflow run limit exceeded"))
    state_append(authority, state_record("v{authority.version}:", payload))
    tree.workflows = applied
}

workflow_start: fn(tree: &ServiceTree, id: String, version: Int) -> ServiceWorkflow ServiceError! {
    workflow_prepare(tree)
    if id.trim() == "" || !workflow_visible(id, 256) -> return Err(ServiceError.Policy("workflow id must be non-empty and visible"))
    if version < 1 -> return Err(ServiceError.Policy("workflow version must be >= 1"))
    // Starting an existing version begins one deterministic replay pass.
    loop index in 0..<tree.workflows.len() {
        if tree.workflows[index].id == id && tree.workflows[index].version == version {
            tree.workflows[index].replay_cursor = 1
            return workflow_handle(tree, tree.workflows[index].run_id)
        }
    }
    maximum := 0
    loop workflow in tree.workflows {
        if workflow.id == id && workflow.version != version && workflow.outcome == None {
            return Err(ServiceError.Policy("workflow `{id}` already has a different active version"))
        }
        if workflow.run_id > maximum -> maximum = workflow.run_id
    }
    if maximum == 9223372036854775807 -> return Err(ServiceError.Policy("workflow run id exhausted"))
    run_id: maximum + 1
    workflow_append(tree, "workflow-start:{run_id}:{version}:{workflow_frame(id)}")
    loop index in 0..<tree.workflows.len() {
        if tree.workflows[index].run_id == run_id -> tree.workflows[index].replay_cursor = 1
    }
    workflow_handle(tree, run_id)
}

workflow_step: fn(tree: &ServiceTree, run: Int | ServiceWorkflow, step: String) ServiceError! {
    run_id: workflow_run_id(run)
    workflow_prepare(tree)
    if step.trim() == "" || !workflow_visible(step, 1048576) -> return Err(ServiceError.Policy("workflow step must be non-empty and visible"))
    if !workflow_step_valid(step) -> return Err(ServiceError.Policy("workflow step reaches a non-deterministic effect; use a recorded activity"))
    index: workflow_find(tree, run_id) ?? return Err(ServiceError.Unknown("workflow run {run_id} not found"))
    replaying: tree.workflows[index].replay_cursor != 0
    if replaying {
        if workflow_replay_decision(tree, index, "step:{step}") -> return Ok()
    } else {
        workflow_advance(tree, index, false, 0)
    }
    if tree.workflows[index].outcome != None -> return Err(ServiceError.Policy("workflow step follows a terminal workflow outcome"))
    if tree.workflows[index].steps.len() >= 100000 -> return Err(ServiceError.Policy("workflow step history limit exceeded"))
    workflow_append(tree, "workflow-step:{run_id}:{workflow_frame(step)}")
    workflow_advance(tree, index, replaying, 1)
}

// Wait points on a detached handle. Replay consumes the recorded decision;
// a live wait records itself before it waits.
workflow_handle_replay: fn(workflow: ServiceWorkflow, expected: String) -> Bool ServiceError! {
    state := workflow.state.guard_edit()
    cursor: state.value.replay_cursor
    if cursor == 0 {
        state.value.replay_cursor = state.value.history.len()
        return Ok(false)
    }
    if cursor >= state.value.history.len() -> return Ok(false)
    actual: state.value.history[cursor]
    if actual != expected -> return Err(ServiceError.Policy("workflow replay diverged: expected `{actual}`, got `{expected}`"))
    state.value.replay_cursor = cursor + 1
    Ok(true)
}

// Append through the durable log, as `workflow_append` does for a tree: the
// handle's history must still match the log it extends.
workflow_append_handle: fn(workflow: ServiceWorkflow, payload: String) ServiceError! {
    lock: authority_file_lock(workflow.authority.store, "workflow")
    applied := workflow_replay_authority(workflow.authority)
    state := workflow.state.guard_edit()
    index: workflow_find_run(applied, state.value.run_id) ?? return Err(ServiceError.Unknown("workflow run {state.value.run_id} not found"))
    applied[index].replay_cursor = state.value.replay_cursor
    if applied[index] != state.value -> return Err(state_error("workflow handle history does not match the durable workflow log"))
    workflow_apply(applied, payload)
    state_append(workflow.authority, state_record("v{workflow.authority.version}:", payload))
    after: workflow_find_run(applied, state.value.run_id) ?? return Err(state_error("workflow handle disappeared after append"))
    state.value = applied[after]
    state.value.replay_cursor = state.value.history.len()
}

workflow_find_run: fn(workflows: [__TreeWorkflowState], run_id: Int) -> Int? Never! {
    loop index in 0..<workflows.len() {
        if workflows[index].run_id == run_id -> return Val(index)
    }
    None
}

// A recorded sleep replays its recorded end: a cancelled or deadline-blown
// sleep fails again without waiting.
workflow_sleep: fn(workflow: ServiceWorkflow, duration: Duration) ServiceError! {
    nanos: duration.ns
    if workflow_handle_replay(workflow, "sleep:{nanos}") {
        state := workflow.state.guard_edit()
        cursor: state.value.replay_cursor
        if cursor < state.value.history.len() {
            if state.value.history[cursor] == "sleep-cancelled" {
                state.value.replay_cursor = cursor + 1
                state.value.status = TaskStatus.CancelRequested
                state.value.outcome = Val(TaskOutcome.Cancelled)
                return Err(ServiceError.Policy("workflow sleep was cancelled"))
            }
            if state.value.history[cursor] == "sleep-deadline" {
                state.value.replay_cursor = cursor + 1
                state.value.status = TaskStatus.Paused
                state.value.outcome = Val(TaskOutcome.DeadlineBlown)
                return Err(ServiceError.Policy("workflow sleep deadline expired"))
            }
        }
        return Ok()
    }
    workflow_append_handle(workflow, "workflow-wait-sleep:{workflow.run_id}:{nanos}")
    // The wait ends in a code instead of unwinding, so a cancelled or
    // deadline-blown sleep is recorded before the workflow fails.
    if core.service.__host_sleep_wait_ns(nanos) == {
        1 -> {
            workflow_append_handle(workflow, "workflow-wait-sleep-cancelled:{workflow.run_id}")
            Err(ServiceError.Policy("workflow sleep was cancelled"))
        }
        2 -> {
            workflow_append_handle(workflow, "workflow-wait-sleep-deadline:{workflow.run_id}")
            Err(ServiceError.Policy("workflow sleep deadline expired"))
        }
        else -> Ok()
    }
}

workflow_activity_wait: fn(workflow: ServiceWorkflow, activity: String, argument: String) -> String ServiceError! {
    workflow_token(activity, "activity")
    if !workflow_visible(argument, 1048576) -> return Err(ServiceError.Policy("workflow activity argument is outside the bounded visible range"))
    if workflow_handle_replay(workflow, "activity:{activity}:{argument}") -> return Ok(argument)
    workflow_append_handle(workflow, "workflow-wait-activity:{workflow.run_id}:{workflow_frame(activity)}{workflow_frame(argument)}")
    Ok(argument)
}

workflow_all: fn(workflow: ServiceWorkflow, values: [String]) -> [String] ServiceError! {
    if values.len() > 100000 -> return Err(ServiceError.Policy("workflow all wait values are outside the bounded visible range"))
    loop value in values {
        if !workflow_visible(value, 1048576) -> return Err(ServiceError.Policy("workflow all wait values are outside the bounded visible range"))
    }
    joined: values.join(",")
    if workflow_handle_replay(workflow, "all:{joined}") -> return Ok(values)
    frames := [String]{"workflow-wait-all:{workflow.run_id}:{values.len()}:"}
    loop value in values -> frames.push(workflow_frame(value))
    workflow_append_handle(workflow, frames.join(""))
    Ok(values)
}

workflow_activity: fn(tree: &ServiceTree, run: Int | ServiceWorkflow, activity: String, key: String, max_attempts: Int) -> TaskStatus ServiceError! {
    run_id: workflow_run_id(run)
    workflow_prepare(tree)
    workflow_token(activity, "activity")
    workflow_token(key, "idempotency key")
    if max_attempts < 1 || max_attempts > 1000 -> return Err(ServiceError.Policy("workflow activity retry limit is outside the bounded range"))
    index: workflow_find(tree, run_id) ?? return Err(ServiceError.Unknown("workflow run {run_id} not found"))
    replaying: tree.workflows[index].replay_cursor != 0
    expected: "activity:{activity}:{key}@1/{max_attempts}"
    if workflow_activity_definition(tree.workflows[index], key) == {
        .Val(existing) -> {
            if existing.activity != activity || existing.max_attempts != max_attempts -> return Err(ServiceError.Policy("workflow activity `{key}` does not match its recorded definition"))
            if replaying {
                if workflow_replay_decision(tree, index, expected) -> return Ok(TaskStatus.Running)
            }
            return Ok(tree.workflows[index].status)
        }
        .None -> {}
    }
    if !replaying {
        workflow_advance(tree, index, false, 0)
    } else {
        cursor: tree.workflows[index].replay_cursor
        if cursor < tree.workflows[index].history.len() {
            actual: tree.workflows[index].history[cursor]
            if actual == expected -> return Err(ServiceError.Policy("workflow replay activity is missing its durable state"))
            return Err(ServiceError.Policy("workflow replay diverged: expected `{actual}`, got `{expected}`"))
        }
    }
    if tree.workflows[index].outcome != None -> return Err(ServiceError.Policy("workflow activity follows a terminal workflow outcome"))
    workflow_append(tree, "workflow-activity:{run_id}:1:{max_attempts}:{workflow_frame(activity)}{workflow_frame(key)}")
    workflow_advance(tree, index, false, 0)
    Ok(TaskStatus.Running)
}

workflow_activity_retry: fn(tree: &ServiceTree, run: Int | ServiceWorkflow, key: String, outcome: TaskOutcome) -> TaskStatus ServiceError! {
    run_id: workflow_run_id(run)
    workflow_prepare(tree)
    workflow_token(key, "idempotency key")
    index: workflow_find(tree, run_id) ?? return Err(ServiceError.Unknown("workflow run {run_id} not found"))
    replaying: tree.workflows[index].replay_cursor != 0
    activity: workflow_activity_definition(tree.workflows[index], key) ?? return Err(ServiceError.Unknown("activity key `{key}` not found"))
    if outcome == TaskOutcome.Finished -> return Err(ServiceError.Policy("a finished activity cannot be retried"))
    if !workflow_valid_outcome(outcome) -> return Err(ServiceError.Policy("workflow activity outcome is invalid"))
    if replaying {
        if workflow_replay_retry(tree, index, key, activity.max_attempts, outcome) -> return Ok(TaskStatus.Paused)
    }
    if tree.workflows[index].outcome != None || workflow_activity_outcome(tree.workflows[index].activity_outcomes, key) != None {
        return Err(ServiceError.Policy("workflow activity retry follows a terminal activity"))
    }
    if activity.attempt >= activity.max_attempts -> return Err(ServiceError.Policy("workflow activity retry limit exhausted"))
    if !replaying -> workflow_advance(tree, index, false, 0)
    next_attempt: activity.attempt + 1
    workflow_append(tree, "workflow-activity-retry:{run_id}:{next_attempt}:{workflow_frame(key)}{workflow_frame(workflow_outcome_wire(outcome))}")
    workflow_advance(tree, index, replaying, 1)
    Ok(TaskStatus.Paused)
}

workflow_activity_complete: fn(tree: &ServiceTree, run: Int | ServiceWorkflow, key: String, outcome: TaskOutcome) -> TaskOutcome ServiceError! {
    run_id: workflow_run_id(run)
    workflow_prepare(tree)
    workflow_token(key, "idempotency key")
    if !workflow_valid_outcome(outcome) -> return Err(ServiceError.Policy("workflow activity outcome is invalid"))
    index: workflow_find(tree, run_id) ?? return Err(ServiceError.Unknown("workflow run {run_id} not found"))
    if workflow_activity_definition(tree.workflows[index], key) == None -> return Err(ServiceError.Unknown("activity key `{key}` not found"))
    replaying: tree.workflows[index].replay_cursor != 0
    if replaying {
        cursor: tree.workflows[index].replay_cursor
        history: tree.workflows[index].history
        done: "activity-done:{key}"
        result: "activity-result:{task_outcome_show(outcome)}"
        if cursor + 1 < history.len() && history[cursor] == done && history[cursor + 1] == result {
            tree.workflows[index].replay_cursor = cursor + 2
            return Ok(outcome)
        }
        if cursor < history.len() -> return Err(ServiceError.Policy("workflow replay diverged: expected completion for `{key}`, got `{history[cursor]}`"))
    }
    if workflow_activity_outcome(tree.workflows[index].activity_outcomes, key) == {
        .Val(existing) -> {
            if existing == outcome -> return Ok(outcome)
            return Err(ServiceError.Policy("workflow activity completion conflicts with its recorded outcome"))
        }
        .None -> {}
    }
    if !replaying -> workflow_advance(tree, index, false, 0)
    workflow_append(tree, "workflow-activity-done:{run_id}:{workflow_frame(key)}{workflow_frame(workflow_outcome_wire(outcome))}")
    workflow_advance(tree, index, replaying, 2)
    Ok(outcome)
}

workflow_prepare: fn(tree: &ServiceTree) ServiceError! {
    if !tree.started -> return Err(ServiceError.NotStarted("service tree is not started"))
    workflow_sync_tree(tree)
}

workflow_find: fn(tree: ServiceTree, run_id: Int) -> Int? Never! {
    loop index in 0..<tree.workflows.len() {
        if tree.workflows[index].run_id == run_id -> return Val(index)
    }
    None
}

workflow_visible: fn(text: String, limit: Int) -> Bool Never! {
    // Empty payloads are valid; Rust char::is_control includes C0, DEL and C1.
    if text == "" -> return true
    valid_service_text(text, limit)
}

workflow_token: fn(text: String, label: String) ServiceError! {
    if !workflow_token_valid(text) -> return Err(ServiceError.Policy("workflow {label} must be non-empty, visible, bounded, and contain no `:`"))
}

workflow_frame: fn(text: String) -> String Never! { "{text.bytes().len()}:{text}" }

workflow_valid_outcome: fn(outcome: TaskOutcome) -> Bool Never! {
    if outcome == {
        .Panicked(reason) -> reason.trim() != "" && workflow_visible(reason, 1048576)
        .Finished | .Cancelled | .DeadlineBlown -> true
    }
}

workflow_outcome_wire: fn(outcome: TaskOutcome) -> String Never! {
    if outcome == {
        .Panicked(reason) -> "Panicked:{workflow_frame(reason)}"
        .Finished | .Cancelled | .DeadlineBlown -> task_outcome_show(outcome)
    }
}

// Consume one recorded decision. A mismatch is a safety error, never a new
// history entry.
workflow_replay_decision: fn(tree: &ServiceTree, index: Int, expected: String) -> Bool ServiceError! {
    cursor: tree.workflows[index].replay_cursor
    if cursor == 0 || cursor >= tree.workflows[index].history.len() -> return Ok(false)
    actual: tree.workflows[index].history[cursor]
    if actual != expected -> return Err(ServiceError.Policy("workflow replay diverged: expected `{actual}`, got `{expected}`"))
    tree.workflows[index].replay_cursor = cursor + 1
    Ok(true)
}

workflow_advance: fn(tree: &ServiceTree, index: Int, replaying: Bool, amount: Int) Never! {
    tree.workflows[index].replay_cursor = if replaying -> tree.workflows[index].replay_cursor + amount else -> tree.workflows[index].history.len()
}

WorkflowActivityDefinition: struct {
    index: Int
    activity: String
    key: String
    attempt: Int
    max_attempts: Int
}

// `activity:{activity}:{key}:{attempt}:{max_attempts}`
workflow_activity_parts: fn(step: String) -> WorkflowActivityDefinition? Never! {
    fields: step.split(":").to_list()
    if fields.len() != 5 || fields[0] != "activity" -> return None
    attempt: workflow_i64(fields[3]) ?? return None
    maximum: workflow_i64(fields[4]) ?? return None
    Val(WorkflowActivityDefinition{index: 0, activity: fields[1], key: fields[2], attempt: attempt, max_attempts: maximum})
}

workflow_activity_definition: fn(workflow: __TreeWorkflowState, key: String) -> WorkflowActivityDefinition? Never! {
    loop step_index in 0..<workflow.steps.len() {
        definition := workflow_activity_parts(workflow.steps[step_index]) ?? next
        if definition.key == key {
            definition.index = step_index
            return Val(definition)
        }
    }
    None
}

workflow_activity_outcome: fn(outcomes: [__ActivityOutcome], key: String) -> TaskOutcome? Never! {
    loop pair in outcomes {
        if pair.key == key -> return Val(pair.outcome)
    }
    None
}

workflow_i64: fn(text: String) -> Int? Never! {
    raw: text.bytes()
    if raw.len() == 0 -> return None
    start := 0
    negative := false
    if raw[0] == (U8{43}) -> start = 1
    if raw[0] == (U8{45}) {
        start = 1
        negative = true
    }
    if start == raw.len() -> return None
    limit: if negative -> 9223372036854775808 else -> 9223372036854775807
    value := 0
    loop i in start..<raw.len() {
        digit: Int.from_u8(raw[i]) - 48
        if digit < 0 || digit > 9 || value > (limit - digit) /% 10 -> return None
        value = value * 10 + digit
    }
    Val(if negative -> -value else -> value)
}

// Retry records carry the attempt assigned by the durable log; replay
// consumes that number instead of deriving another from replayed state.
workflow_replay_retry: fn(tree: &ServiceTree, index: Int, key: String, maximum: Int, outcome: TaskOutcome) -> Bool ServiceError! {
    cursor: tree.workflows[index].replay_cursor
    if cursor == 0 || cursor >= tree.workflows[index].history.len() -> return Ok(false)
    actual: tree.workflows[index].history[cursor]
    prefix: "activity-retry:{key}@"
    suffix: ":{task_outcome_show(outcome)}"
    if !actual.starts_with(prefix) || !actual.ends_with(suffix) -> return Err(ServiceError.Policy("workflow replay diverged: expected retry for `{key}`, got `{actual}`"))
    raw: actual.bytes()
    range: String.from_bytes(raw.slice(prefix.bytes().len(), raw.len() - suffix.bytes().len())) ?? return Err(ServiceError.Policy("workflow replay has an invalid retry decision for `{key}`"))
    parts: range.split_once("/") ?? return Err(ServiceError.Policy("workflow replay has an invalid retry decision for `{key}`"))
    attempt: workflow_i64(parts.before) ?? return Err(ServiceError.Policy("workflow replay has an invalid retry attempt for `{key}`"))
    recorded_limit: workflow_i64(parts.after) ?? return Err(ServiceError.Policy("workflow replay has an invalid retry limit for `{key}`"))
    if attempt < 2 || attempt > maximum || recorded_limit != maximum -> return Err(ServiceError.Policy("workflow replay retry definition for `{key}` changed"))
    tree.workflows[index].replay_cursor = cursor + 1
    Ok(true)
}

#Test("workflow framing, token bounds, signed replay counters and panic validation") {
    assert(workflow_frame("λ") == "2:λ")
    assert(workflow_i64("+0002") == (Val(2)))
    assert(workflow_i64("-9223372036854775808") == (Val(-9223372036854775808)))
    assert(workflow_i64("9223372036854775808") == None)
    assert(workflow_i64(" 2") == None)
    assert(workflow_i64("2/3") == None)
    assert(workflow_visible("", 1048576))
    assert(!workflow_visible("\n", 1048576))
    assert(!workflow_valid_outcome(TaskOutcome.Panicked("   ")))
    assert(workflow_outcome_wire(TaskOutcome.Panicked("λ")) == "Panicked:2:λ")
}

group: fn(tree: &ServiceTree, name: String, workers: [String]) ServiceError! {
    if tree.started -> return Err(ServiceError.Policy("cannot add groups after start"))
    known := [String]{}
    loop worker in tree.workers -> known.push(worker.name)
    groups := [(name: String, workers: [String])]{}
    loop existing in tree.groups -> groups.push((name: existing.name, workers: existing.workers))
    validate_group(name, workers, known, groups)
    tree.groups.push(__TreeGroup{name: name, restart: tree.restart, budget_max: tree.budget_max, budget_per_ms: tree.budget_per_ms, workers: workers})
}

validate_group: fn(name: String, workers: [String], known: [String], groups: [(name: String, workers: [String])]) ServiceError! {
    if name.trim().len() == 0 || !valid_service_text(name, 256) || workers.len() == 0 || workers.len() > 4096 {
        return Err(ServiceError.Policy("service group needs a visible name and at least one worker"))
    }
    loop existing in groups {
        if existing.name == name -> return Err(ServiceError.Policy("group `{name}` already exists"))
    }
    loop worker in workers {
        found := false
        loop existing in known {
            if existing == worker -> found = true
        }
        if !found -> return Err(ServiceError.Unknown("group `{name}` references unknown worker `{worker}`"))
    }
    loop worker in workers {
        loop existing in groups {
            loop member in existing.workers {
                if member == worker -> return Err(ServiceError.Policy("a worker can belong to only one service supervisor group"))
            }
        }
    }
    loop i in 0..<workers.len() {
        loop j in 0..<i {
            if workers[j] == workers[i] -> return Err(ServiceError.Policy("group `{name}` lists a worker more than once"))
        }
    }
}

// The counter advances before a running worker is chosen and failed.
chaos_fail: fn(tree: &ServiceTree) -> Int ServiceError! {
    if !tree.started -> return Err(ServiceError.NotStarted("service tree is not started"))
    if tree.chaos_fails == 9223372036854775807 -> return Err(ServiceError.Policy("chaos failure counter exhausted"))
    tree.chaos_fails = tree.chaos_fails + 1
    endpoint := ServiceEndpoint?{None}
    loop worker in tree.workers {
        if worker.running {
            endpoint = Val(worker.endpoint)
            break
        }
    }
    target: endpoint ?? return Err(ServiceError.Partitioned("chaos failure has no reachable service worker"))
    fail_worker(tree, target)
    Ok(tree.chaos_fails)
}

// The durable append precedes the in-memory push.
append_event: fn(tree: &ServiceTree, event: String) ServiceError! {
    if !tree.started -> return Err(ServiceError.NotStarted("service tree is not started"))
    if tree.state_adapter != __TreeStateAdapter.EventLog -> return Err(ServiceError.Policy("append_event requires EventLog state adapter"))
    authority: tree.state_authority ?? return Err(ServiceError.Policy("EventLog state has no injected authority"))
    if !valid_record_payload(event) -> return Err(ServiceError.Policy("event record exceeds the state record limit"))
    if tree.event_log.len() >= 100000 -> return Err(ServiceError.Policy("event-log record limit exceeded"))
    record: state_record("v{authority.version}:", event)
    state_append(authority, record)
    tree.event_log.push(record)
}

commit_snapshot: fn(tree: &ServiceTree, payload: String) ServiceError! {
    if !tree.started -> return Err(ServiceError.NotStarted("service tree is not started"))
    if tree.state_adapter != __TreeStateAdapter.Snapshot -> return Err(ServiceError.Policy("commit_snapshot requires Snapshot state adapter"))
    authority: tree.state_authority ?? return Err(ServiceError.Policy("Snapshot state has no injected authority"))
    if !valid_record_payload(payload) -> return Err(ServiceError.Policy("snapshot record exceeds the state record limit"))
    record: state_record("v{authority.version}:", payload)
    gate := authority_gate().guard_edit()
    state_write(authority, __TreeStateAdapter.Snapshot, [String]{record})
    tree.snapshot = Val(record)
}

valid_record_payload: fn(text: String) -> Bool Never! {
    // Rust allows empty messages/records but rejects every Unicode Cc scalar.
    text.len() == 0 || valid_service_text(text, 1048576)
}

#Test("service group policy preserves native error precedence") {
    assert(if validate_group("", [String]{}, [String]{}, [(name: String, workers: [String])]{}) == {
        .Err(.Policy(message)) -> message == "service group needs a visible name and at least one worker"
        .Ok(_) | .Err(_) -> false
    })
    existing: [(name: String, workers: [String])]{(name: "g", workers: [String]{"w"})}
    assert(if validate_group("g", [String]{"unknown"}, [String]{"w"}, existing) == {
        .Err(.Policy(message)) -> message == "group `g` already exists"
        .Ok(_) | .Err(_) -> false
    })
    assert(if validate_group("new", [String]{"unknown", "w"}, [String]{"w"}, existing) == {
        .Err(.Unknown(message)) -> message == "group `new` references unknown worker `unknown`"
        .Ok(_) | .Err(_) -> false
    })
    assert(if validate_group("new", [String]{"w", "w"}, [String]{"w"}, existing) == {
        .Err(.Policy(message)) -> message == "a worker can belong to only one service supervisor group"
        .Ok(_) | .Err(_) -> false
    })
    assert(if validate_group("new", [String]{"w", "w"}, [String]{"w"}, [(name: String, workers: [String])]{}) == {
        .Err(.Policy(message)) -> message == "group `new` lists a worker more than once"
        .Ok(_) | .Err(_) -> false
    })
    assert(valid_record_payload(""))
    assert(valid_record_payload("é"))
    assert(!valid_record_payload("\n"))
}

#Test("mutating service operations borrow the tree and preserve pre-start policy") {
    fresh := tree("mutation-contract")
    assert(if group(fresh, "g", [String]{"missing"}) == {
        .Err(.Unknown(message)) -> message == "group `g` references unknown worker `missing`"
        .Ok(_) | .Err(_) -> false
    })
    assert(if chaos_fail(fresh) == {
        .Err(.NotStarted(message)) -> message == "service tree is not started"
        .Ok(_) | .Err(_) -> false
    })
    assert(if append_event(fresh, "event") == {
        .Err(.NotStarted(message)) -> message == "service tree is not started"
        .Ok(_) | .Err(_) -> false
    })
    assert(if commit_snapshot(fresh, "snapshot") == {
        .Err(.NotStarted(message)) -> message == "service tree is not started"
        .Ok(_) | .Err(_) -> false
    })
    assert(directory_generation(fresh) == 1)
    assert(event_count(fresh) == 0)
    delivery: delivery_durable()
    restart: restart_one_for_all()
    set_delivery(fresh, delivery) ?? panic("pre-start delivery")
    set_restart(fresh, restart) ?? panic("pre-start restart")
    assert(delivery == delivery_durable())
    assert(restart == restart_one_for_all())
    assert(tree_show(fresh).contains("restart=OneForAll"))
    assert(tree_show(fresh).contains("delivery=DurableAtLeastOnce"))
}

// Identity and pinned-generation checks precede authority validation.
validate_tree_endpoint: fn(tree: ServiceTree, endpoint: ServiceEndpoint) ServiceError! {
    if endpoint.authority != tree.authority || endpoint.tree != tree.name -> return Err(ServiceError.Revoked("service endpoint {endpoint.tree}/{endpoint.worker} is not issued by this authority"))
    if !route_generation_allowed(tree.generation, tree.last_upgrade, endpoint.worker, endpoint.generation) {
        return Err(stale_tree_endpoint(endpoint.tree, endpoint.worker, endpoint.generation, tree.generation))
    }
    __authority_validate(endpoint)
}

route_generation_allowed: fn(generation: Int, upgrade: ServiceUpgradeReceipt?, worker: String, endpoint_generation: Int) -> Bool Never! {
    if endpoint_generation == generation -> return true
    if upgrade == {
        .Val(receipt) -> {
            if receipt.to_generation != generation || receipt.from_generation != endpoint_generation -> return false
            loop name in receipt.pinned_shards {
                if name == worker -> return true
            }
        }
        .None -> {}
    }
    false
}

// The worker slot whose endpoint is exactly `endpoint`.
worker_slot: fn(tree: ServiceTree, endpoint: ServiceEndpoint) -> Int? Never! {
    loop index in 0..<tree.workers.len() {
        current: tree.workers[index].endpoint
        if tree.workers[index].name == endpoint.worker && current.tree == endpoint.tree && current.authority == endpoint.authority && current.generation == endpoint.generation {
            return Val(index)
        }
    }
    None
}

directory_payload: fn(authority: String, tree_name: String, name: String, endpoint: ServiceEndpoint) -> [U8] Never! {
    delivery_signature_payload([String]{"jet-service-directory-v2", authority, tree_name, name, endpoint.tree, endpoint.worker, "{endpoint.generation}"})
}

// Directory entries are signed with the provider-issued tree authority; they
// do not form a second rights table.
directory_sign: fn(authority: String, tree_name: String, name: String, endpoint: ServiceEndpoint) -> String ServiceError! {
    authority_require_issued(authority)
    validate_endpoint_identity(endpoint.authority, endpoint.tree, endpoint.worker, endpoint.generation)
    if endpoint.authority != authority || endpoint.tree != tree_name -> return Err(ServiceError.Revoked("service directory endpoint is outside its authority tree"))
    key: __authority_signing_key(authority)
    Ok(service_encoding.bytes_to_hex(service_crypto.hmac_sha256(key, directory_payload(authority, tree_name, name, endpoint))))
}

directory_validate: fn(authority: String, tree_name: String, name: String, endpoint: ServiceEndpoint, signature: String) ServiceError! {
    authority_require_issued(authority)
    validate_endpoint_identity(endpoint.authority, endpoint.tree, endpoint.worker, endpoint.generation)
    if endpoint.authority != authority || endpoint.tree != tree_name -> return Err(ServiceError.Revoked("service directory endpoint is outside its authority tree"))
    authority_require_registered(endpoint)
    supplied: service_encoding.hex_to_bytes(signature) ?? return Err(ServiceError.Revoked("service directory proof is malformed"))
    key: __authority_signing_key(authority)
    expected: service_crypto.hmac_sha256(key, directory_payload(authority, tree_name, name, endpoint))
    if supplied.len() != expected.len() || !service_crypto.constant_time_equal_bytes(expected, supplied) {
        return Err(ServiceError.Revoked("service directory proof does not validate"))
    }
}

// Exact lookup, then generation, proof, authority, running and draining.
directory_resolve: fn(tree: ServiceTree, name: String) -> ServiceEndpoint ServiceError! {
    entry := __DirectoryRecord?{None}
    loop record in tree.directory {
        if record.name == name {
            entry = Val(record)
            break
        }
    }
    found: entry ?? return Err(ServiceError.Unknown("directory has no entry `{name}`"))
    endpoint: found.endpoint
    if !route_generation_allowed(tree.generation, tree.last_upgrade, endpoint.worker, endpoint.generation) -> return Err(ServiceError.Stale("directory entry `{name}` is from generation {endpoint.generation}"))
    directory_validate(tree.authority, tree.name, found.name, endpoint, found.proof)
    if __authority_validate(endpoint) == {
        .Err(.NotStarted(message)) -> return Err(ServiceError.Expired(message))
        .Err(error) -> return Err(error)
        .Ok(_) -> {}
    }
    index: worker_slot(tree, endpoint) ?? return Err(ServiceError.Expired("directory entry `{name}` no longer names a running worker"))
    if !tree.workers[index].running -> return Err(ServiceError.Expired("directory entry `{name}` no longer names a running worker"))
    loop draining in tree.draining {
        if draining == endpoint.worker -> return Err(ServiceError.Unavailable("directory entry `{name}` is draining"))
    }
    Ok(endpoint)
}

send: fn(tree: &ServiceTree, endpoint: ServiceEndpoint, message: String) ServiceError! {
    if !tree.started -> return Err(ServiceError.NotStarted("service tree is not started"))
    validate_tree_endpoint(tree, endpoint)
    if !valid_record_payload(message) -> return Err(ServiceError.Policy("service message exceeds the 1 MiB limit"))
    draining := false
    loop name in tree.draining {
        if name == endpoint.worker -> draining = true
    }
    // Worker lookup validates again before selecting a worker.
    validate_tree_endpoint(tree, endpoint)
    index: worker_slot(tree, endpoint) ?? return Err(ServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not in this tree"))
    worker: tree.workers[index]
    if !worker.running || draining -> return Err(ServiceError.NotStarted("worker `{worker.name}` is not running"))
    if authority_try_send(endpoint, message) == {
        .Err(.Full(_)) -> return Err(full_tree_mailbox(worker.name, worker.capacity))
        .Err(error) -> return Err(error)
        .Ok(_) -> {}
    }
}

service_saturating_add: fn(left: Int, right: Int) -> Int Never! {
    if left > 9223372036854775807 - right -> return 9223372036854775807
    left + right
}

#Test("service route generation accepts only active or explicitly pinned predecessors") {
    assert(route_generation_allowed(2, None, "w", 2))
    assert(!route_generation_allowed(2, None, "w", 1))
    receipt: Val(ServiceUpgradeReceipt{from_generation: 1, to_generation: 2, migration: "reversible", rollback_store: "", rollback_available: false, pinned_shards: [String]{"w"}})
    assert(route_generation_allowed(2, receipt, "w", 1))
    assert(!route_generation_allowed(2, receipt, "other", 1))
    assert(!route_generation_allowed(3, receipt, "w", 1))
}

stale_tree_endpoint: fn(tree: String, worker: String, generation: Int, current: Int) -> ServiceError Never! {
    ServiceError.Stale("service endpoint {tree}/{worker}@g{generation} is stale (current generation {current})")
}

full_tree_mailbox: fn(worker: String, capacity: Int) -> ServiceError Never! {
    ServiceError.Full("mailbox for `{worker}` is full (capacity {capacity})")
}

#Test("service send capacity remap and endpoint generation text retain exact native spelling") {
    assert(if full_tree_mailbox("worker", 3) == {
        .Full(message) -> message == "mailbox for `worker` is full (capacity 3)"
        .Ambiguous(_) | .Unknown(_) | .NotStarted(_) | .Policy(_) | .Unavailable(_) | .Partitioned(_) | .Revoked(_) | .Stale(_) | .Expired(_) -> false
    })
    assert(if stale_tree_endpoint("tree", "worker", 1, 2) == {
        .Stale(message) -> message == "service endpoint tree/worker@g1 is stale (current generation 2)"
        .Full(_) | .Ambiguous(_) | .Unknown(_) | .NotStarted(_) | .Policy(_) | .Unavailable(_) | .Partitioned(_) | .Revoked(_) | .Expired(_) -> false
    })
}

// Durable delivery authority log. A line is an operation letter followed by
// `|{byte length}:{hex}` per field; entries are a pure replay of the log.
__DeliveryRecord: struct {
    op: String
    fields: [String]
}

__DeliveryEntry: struct {
    id: String
    key: String
    tree: String
    worker: String
    authority: String
    generation: Int
    message: String
    created: Int
    expires: Int
    retained_until: Int?
    attempts: Int
    state: DeliveryState
    event_sequence: Int
    delivered_to_worker: Bool
    delivered: Bool
    dead: Bool
}

DeliveryEvent: struct {
    sequence: Int
    state: DeliveryState
    attempts: Int
    timestamp: Int
    signature: String
}

authority_error: fn(message: String) -> ServiceError Never! {
    ServiceError.Unavailable(message)
}

authority_record: fn(op: String, fields: [String]) -> String Never! {
    parts := [String]{op}
    loop field in fields -> parts.push("|{field.bytes().len()}:{service_encoding.bytes_to_hex(field.bytes())}")
    parts.push("\n")
    parts.join("")
}

// Even-length hexadecimal in either case.
authority_unhex: fn(text: String) -> [U8]? Never! {
    raw: text.bytes()
    count: raw.len() /% 2
    if count * 2 != raw.len() -> return None
    bytes := [U8]{}
    loop index in 0..<count {
        high: authority_hex_digit(Int.from_u8(raw[index * 2])) ?? return None
        low: authority_hex_digit(Int.from_u8(raw[index * 2 + 1])) ?? return None
        bytes.push(U8{high * 16 + low})
    }
    Val(bytes)
}

authority_parse_record: fn(line: String) -> __DeliveryRecord ServiceError! {
    parts: line.split("|").to_list()
    head: parts[0].bytes()
    if head.len() == 0 -> return Err(authority_error("service authority record has no operation"))
    // A non-ASCII lead is never a known operation.
    op: String.from_bytes(head.slice(0, 1)) ?? "?"
    fields := [String]{}
    loop index in 1..<parts.len() {
        field: parts[index].split_once(":") ?? return Err(authority_error("service authority field is malformed"))
        length: service_parse_count(field.before) ?? return Err(authority_error("service authority field length is malformed"))
        bytes: authority_unhex(field.after) ?? return Err(authority_error("service authority field is not hex"))
        if bytes.len() != length -> return Err(authority_error("service authority field length does not match"))
        value: String.from_bytes(bytes) ?? return Err(authority_error("service authority field is not UTF-8"))
        fields.push(value)
    }
    Ok(__DeliveryRecord{op: op, fields: fields})
}

// One line without its terminator; a trailing carriage return is not part
// of the record.
authority_parse_line: fn(raw: [U8]) -> __DeliveryRecord ServiceError! {
    end := raw.len()
    if end > 0 && raw[end - 1] == (U8{13}) -> end = end - 1
    line: String.from_bytes(raw.slice(0, end)) ?? return Err(authority_error("service authority field is not UTF-8"))
    authority_parse_record(line)
}

// Offset just past the last newline, or 0.
authority_complete_end: fn(bytes: [U8]) -> Int Never! {
    index := bytes.len()
    loop index > 0 {
        if bytes[index - 1] == (U8{10}) -> return index
        index = index - 1
    }
    0
}

service_utf8: fn(bytes: [U8]) -> Bool Never! {
    _: String.from_bytes(bytes) ?? return false
    true
}

// A crash can leave an incomplete tail after the last newline. A tail that
// still parses as a whole record is a truncated record and fails closed.
authority_tail_is_record: fn(bytes: [U8], complete_end: Int) -> Bool Never! {
    if complete_end == bytes.len() -> return false
    tail: String.from_bytes(bytes.slice(complete_end, bytes.len())) ?? return false
    if authority_parse_record(tail) == {
        .Ok(_) -> true
        .Err(_) -> false
    }
}

authority_read: fn(runtime: ServiceRuntime) -> [__DeliveryRecord] ServiceError! {
    authority_validate_store_path(runtime.store)
    lock: authority_file_lock(runtime.store, "store")
    row := [Int]{}
    if service_stat(runtime.store) == {
        .Ok(value) -> row = value
        .Err(.NotFound(_)) -> return Ok([__DeliveryRecord]{})
        .Err(error) -> return Err(authority_error("could not open service store: {error}"))
    }
    if row[1] > 134217728 -> return Err(ServiceError.Policy("service authority log exceeds its byte limit"))
    bytes: service_read_bytes(runtime.store) ?? return Err(authority_error("could not read service store: {err}"))
    if !service_utf8(bytes) -> return Err(authority_error("could not read service store: stream did not contain valid UTF-8"))
    complete_end: authority_complete_end(bytes)
    lines := 0
    loop byte in bytes {
        if byte == (U8{10}) -> lines = lines + 1
    }
    if complete_end < bytes.len() -> lines = lines + 1
    if lines > 100000 -> return Err(ServiceError.Policy("service authority log is full"))
    if authority_tail_is_record(bytes, complete_end) -> return Err(authority_error("service authority log ends with a truncated record"))
    records := [__DeliveryRecord]{}
    if complete_end == 0 -> return Ok(records)
    // Lines of the complete prefix without its final newline; a last empty
    // line before that newline is not a record.
    end: complete_end - 1
    start := 0
    loop index in 0..<end {
        if bytes[index] == (U8{10}) {
            records.push(authority_parse_line(bytes.slice(start, index)))
            start = index + 1
        }
    }
    if start < end -> records.push(authority_parse_line(bytes.slice(start, end)))
    Ok(records)
}

authority_append: fn(runtime: ServiceRuntime, op: String, fields: [String]) ServiceError! {
    authority_validate_store_path(runtime.store)
    lock: authority_file_lock(runtime.store, "store")
    record: authority_record(op, fields).bytes()
    existing := [U8]{}
    if service_read_bytes(runtime.store) == {
        .Ok(value) -> existing = value
        .Err(.NotFound(_)) -> {
            if record.len() > 134217728 -> return Err(ServiceError.Policy("service authority log exceeds its byte limit"))
            if service_create_private(runtime.store, record) == {
                .Err(error) -> return Err(authority_error("could not open service store: {error}"))
                .Ok(_) -> return Ok()
            }
        }
        .Err(error) -> return Err(authority_error("could not read service store before append: {error}"))
    }
    if existing.len() > 134217728 - record.len() -> return Err(ServiceError.Policy("service authority log exceeds its byte limit"))
    if !service_utf8(existing) -> return Err(authority_error("could not read service store before append: stream did not contain valid UTF-8"))
    complete_end: authority_complete_end(existing)
    if complete_end < existing.len() {
        if authority_tail_is_record(existing, complete_end) -> return Err(authority_error("service authority log ends with a truncated record"))
        // Drop the incomplete tail and add the record in one atomic replacement.
        repaired := existing.slice(0, complete_end)
        loop byte in record -> repaired.push(byte)
        temporary: "{runtime.store}.jet-repair-{service_pid()}-{service_now()}-{state_temp_sequence()}"
        if service_replace_private(runtime.store, temporary, repaired) == {
            .Err(error) -> return Err(authority_error("could not repair service authority log tail: {error}"))
            .Ok(_) -> return Ok()
        }
    }
    if core.service.__host_append_bytes(runtime.store, record) == {
        .Err(error) -> return Err(authority_error("could not append service receipt: {error}"))
        .Ok(_) -> {}
    }
    if core.service.__host_fsync(runtime.store) == {
        .Err(error) -> Err(authority_error("could not commit service receipt: {error}"))
        .Ok(_) -> Ok()
    }
}

// Receipt ids name the logical operation: store, tree, worker, message and
// key, never the generation-scoped authority token.
authority_delivery_id: fn(store: String, tree: String, worker: String, message: String, key: String) -> String Never! {
    digest: service_crypto.sha256(delivery_signature_payload([String]{authority_store_identity(store), tree, worker, message, key})).bytes
    "svc-{service_encoding.bytes_to_hex(digest)}"
}

delivery_transition_allowed: fn(entry: __DeliveryEntry, state: DeliveryState, attempts: Int) ServiceError! {
    if attempts < entry.attempts -> return Err(authority_error("delivery event attempts move backwards"))
    allowed: if entry.state == {
        .Pending -> state == DeliveryState.Accepted
        .Accepted -> state == DeliveryState.Accepted || state == DeliveryState.Delivering || state == DeliveryState.DeadLettered || state == DeliveryState.Cancelled
        .Delivering -> state == DeliveryState.Accepted || state == DeliveryState.Delivered || state == DeliveryState.DeadLettered || state == DeliveryState.Cancelled
        .Delivered -> state == DeliveryState.DeadLettered || (state == DeliveryState.Accepted && entry.retained_until != None)
        .DeadLettered | .Cancelled -> false
    }
    if !allowed -> return Err(authority_error("delivery event contains an invalid lifecycle transition"))
}

delivery_acceptance_signature: fn(authority: String, generation: Int, id: String, key: String, tree: String, worker: String, message: String, created: Int, expires: Int) -> [U8] ServiceError! {
    signing_key: delivery_generation_key(authority, generation)
    fields: [String]{"jet-service-delivery-acceptance-v2", id, key, authority, tree, worker, "{generation}", message, "{created}", "{expires}"}
    Ok(service_crypto.hmac_sha256(signing_key, delivery_signature_payload(fields)))
}

delivery_retention_signature: fn(entry: __DeliveryEntry, retained_until: Int) -> [U8] ServiceError! {
    signing_key: delivery_generation_key(entry.authority, entry.generation)
    fields: [String]{"jet-service-delivery-retention-v1", entry.id, "{retained_until}"}
    Ok(service_crypto.hmac_sha256(signing_key, delivery_signature_payload(fields)))
}

delivery_signature_matches: fn(expected: [U8], supplied: String, malformed: String, invalid: String) ServiceError! {
    bytes: authority_unhex(supplied) ?? return Err(authority_error(malformed))
    if !service_crypto.constant_time_equal_bytes(expected, bytes) -> return Err(authority_error(invalid))
}

delivery_entry_index: fn(entries: [__DeliveryEntry], id: String) -> Int? Never! {
    loop index in 0..<entries.len() {
        if entries[index].id == id -> return Val(index)
    }
    None
}

// Replay the log: acceptances, retention extensions and signed lifecycle
// events, each validated before it changes an entry.
authority_entries: fn(runtime: ServiceRuntime, records: [__DeliveryRecord]) -> [__DeliveryEntry] ServiceError! {
    entries := [__DeliveryEntry]{}
    loop record in records {
        fields: record.fields
        if record.op == "S" && fields.len() == 10 {
            generation: workflow_i64(fields[5]) ?? return Err(authority_error("service send generation is malformed"))
            created: workflow_i64(fields[7]) ?? return Err(authority_error("service send timestamp is malformed"))
            expires: workflow_i64(fields[8]) ?? return Err(authority_error("service send expiry is malformed"))
            validate_endpoint_identity(fields[2], fields[3], fields[4], generation)
            authority_validate_text(fields[1], "service idempotency key", 1024, false)
            authority_validate_text(fields[6], "service message", 1048576, true)
            if fields[0] != authority_delivery_id(runtime.store, fields[3], fields[4], fields[6], fields[1]) {
                return Err(authority_error("service receipt identity does not match its authority fields"))
            }
            expected: delivery_acceptance_signature(fields[2], generation, fields[0], fields[1], fields[3], fields[4], fields[6], created, expires)
            delivery_signature_matches(expected, fields[9], "service acceptance signature is malformed", "service acceptance signature does not validate")
            loop previous in entries {
                if previous.id == fields[0] -> return Err(authority_error("service authority log contains duplicate acceptance"))
            }
            loop previous in entries {
                if previous.key == fields[1] -> return Err(authority_error("service authority log contains duplicate idempotency work"))
            }
            entries.push(__DeliveryEntry{id: fields[0], key: fields[1], tree: fields[3], worker: fields[4], authority: fields[2], generation: generation, message: fields[6], created: created, expires: expires, retained_until: None, attempts: 0, state: DeliveryState.Accepted, event_sequence: 1, delivered_to_worker: false, delivered: false, dead: false})
        } else if record.op == "K" && fields.len() == 3 {
            until: workflow_i64(fields[1]) ?? return Err(authority_error("service retention deadline is malformed"))
            index: delivery_entry_index(entries, fields[0]) ?? return Err(authority_error("service retention references an unknown id"))
            expected: delivery_retention_signature(entries[index], until)
            delivery_signature_matches(expected, fields[2], "service retention signature is malformed", "service retention signature does not validate")
            entries[index].retained_until = Val(until)
        } else if record.op == "E" && fields.len() == 6 {
            sequence: workflow_i64(fields[1]) ?? return Err(authority_error("delivery event sequence is malformed"))
            attempts: workflow_i64(fields[3]) ?? return Err(authority_error("delivery event attempts are malformed"))
            timestamp: workflow_i64(fields[4]) ?? return Err(authority_error("delivery event timestamp is malformed"))
            state: delivery_parse_state(fields[2]) ?? return Err(authority_error("service delivery lifecycle state is malformed"))
            index: delivery_entry_index(entries, fields[0]) ?? return Err(authority_error("delivery event references an unknown id"))
            if sequence != service_saturating_add(entries[index].event_sequence, 1) -> return Err(authority_error("delivery event sequence is not monotonic"))
            delivery_transition_allowed(entries[index], state, attempts)
            expected: delivery_event_signature(entries[index].authority, entries[index].generation, fields[0], sequence, state, attempts, timestamp)
            delivery_signature_matches(expected, fields[5], "delivery event signature is malformed", "delivery event signature does not validate")
            entries[index].event_sequence = sequence
            entries[index].attempts = attempts
            entries[index].state = state
            entries[index].delivered_to_worker = state == DeliveryState.Delivering || state == DeliveryState.Delivered
            entries[index].delivered = state == DeliveryState.Delivered
            entries[index].dead = state == DeliveryState.DeadLettered
        } else {
            return Err(authority_error("service authority record has an unknown shape"))
        }
    }
    Ok(entries)
}

delivery_entry_expired: fn(entry: __DeliveryEntry, now: Int) -> Bool Never! {
    if entry.state == DeliveryState.DeadLettered || entry.state == DeliveryState.Cancelled -> return false
    if entry.retained_until == {
        .Val(until) -> until <= now
        .None -> entry.expires <= now
    }
}

delivery_for_entry: fn(runtime: ServiceRuntime, entry: __DeliveryEntry, duplicate: Bool) -> Delivery Never! {
    Delivery{id: entry.id, store: authority_store_identity(runtime.store), duplicate: duplicate, authority: entry.authority, generation: entry.generation}
}

authority_append_event: fn(runtime: ServiceRuntime, entry: __DeliveryEntry, state: DeliveryState, attempts: Int, timestamp: Int) ServiceError! {
    delivery_transition_allowed(entry, state, attempts)
    sequence: service_saturating_add(entry.event_sequence, 1)
    signature: delivery_event_signature(entry.authority, entry.generation, entry.id, sequence, state, attempts, timestamp)
    authority_append(runtime, "E", [String]{entry.id, "{sequence}", delivery_state_show(state), "{attempts}", "{timestamp}", service_encoding.bytes_to_hex(signature)})
}

// Pending delivery queues: one per (store, authority, worker, generation).
pending_queue_slot: fn(pending: &__PendingRegistry, store: String, endpoint: ServiceEndpoint) -> Int Never! {
    identity: authority_store_identity(store)
    loop index in 0..<pending.queues.len() {
        queue: pending.queues[index]
        if queue.store == identity && queue.authority == endpoint.authority && queue.worker == endpoint.worker && queue.generation == endpoint.generation -> return index
    }
    pending.queues.push(__PendingQueue{store: identity, authority: endpoint.authority, worker: endpoint.worker, generation: endpoint.generation, entries: [__PendingEntry]{}})
    pending.queues.len() - 1
}

pending_remove: fn(store: String, id: String) Never! {
    identity: authority_store_identity(store)
    pending := pending_registry().guard_edit()
    loop slot in 0..<pending.value.queues.len() {
        kept := [__PendingEntry]{}
        loop entry in pending.value.queues[slot].entries {
            if entry.id != id || authority_store_identity(entry.store) != identity -> kept.push(entry)
        }
        pending.value.queues[slot].entries = kept
    }
}

pending_remove_entry: fn(runtime: ServiceRuntime, entry: __DeliveryEntry) Never! {
    if entry.authority == "" -> return
    pending_remove(runtime.store, entry.id)
}

pending_contains: fn(entries: [__PendingEntry], candidate: __PendingEntry) -> Bool Never! {
    loop entry in entries {
        if entry.id == candidate.id && entry.message == candidate.message && entry.store == candidate.store -> return true
    }
    false
}

authority_cleanup_expired: fn(runtime: ServiceRuntime, entries: [__DeliveryEntry], now: Int) -> Bool ServiceError! {
    cleaned := false
    loop entry in entries {
        if delivery_entry_expired(entry, now) {
            authority_append_event(runtime, entry, DeliveryState.DeadLettered, entry.attempts, now)
            pending_remove_entry(runtime, entry)
            cleaned = true
        }
    }
    Ok(cleaned)
}

// Read and replay the log; an expiry sweep that appended events reads again.
authority_load: fn(runtime: ServiceRuntime) -> [__DeliveryEntry] ServiceError! {
    entries: authority_entries(runtime, authority_read(runtime))
    if authority_cleanup_expired(runtime, entries, service_now()) -> return authority_entries(runtime, authority_read(runtime))
    Ok(entries)
}

authority_enqueue: fn(runtime: ServiceRuntime, endpoint: ServiceEndpoint, id: String, message: String) ServiceError! {
    authority_validate_runtime(runtime)
    __authority_validate(endpoint)
    store: authority_bind_store(runtime, endpoint)
    authority_validate_text(id, "service id", 1024, false)
    authority_validate_text(message, "service message", 1048576, true)
    pending := pending_registry().guard_edit()
    slot: pending_queue_slot(pending.value, store, endpoint)
    loop entry in pending.value.queues[slot].entries {
        if entry.id == id && entry.store == store -> return Ok()
    }
    if pending.value.queues[slot].entries.len() >= 100000 -> return Err(ServiceError.Full("service authority pending delivery queue is full"))
    pending.value.queues[slot].entries.push(__PendingEntry{id: id, message: message, store: store})
}

__RouteCandidate: struct {
    authority: String
    tree: String
    worker: String
    generation: Int
    store: String?
}

__RouteScan: struct {
    exact: __RouteCandidate?
    newer_exact: __RouteCandidate?
    candidates: [__RouteCandidate]
    exact_stopped: Bool
    newer_generation: Bool
}

// Registry rows that can carry a receipt for `entry`'s tree and worker.
// A stopped replacement never revokes a running source generation.
authority_route_scan: fn(entry: __DeliveryEntry) -> __RouteScan Never! {
    registry: service_registry().guard_read()
    scan := __RouteScan{exact: None, newer_exact: None, candidates: [__RouteCandidate]{}, exact_stopped: false, newer_generation: false}
    loop state in registry.value.endpoints {
        if state.tree != entry.tree || state.worker != entry.worker || state.partitioned -> next
        if state.generation > entry.generation && state.started -> scan.newer_generation = true
        bound: if state.store_generation == state.generation -> state.store else -> None
        candidate: __RouteCandidate{authority: state.authority, tree: state.tree, worker: state.worker, generation: state.generation, store: bound}
        if state.authority == entry.authority {
            if state.generation == entry.generation {
                if state.started {
                    scan.exact = Val(candidate)
                } else {
                    scan.exact_stopped = true
                }
            } else if state.generation > entry.generation && state.started {
                newer: if scan.newer_exact == {
                    .Val(current) -> current.generation < state.generation
                    .None -> true
                }
                if newer -> scan.newer_exact = Val(candidate)
            }
        } else if state.generation == entry.generation && state.started {
            scan.candidates.push(candidate)
        }
    }
    scan
}

authority_route_select: fn(scan: __RouteScan, store: String, entry: __DeliveryEntry) -> __RouteCandidate ServiceError! {
    if scan.exact == {
        .Val(exact) -> return Ok(exact)
        .None -> {}
    }
    if scan.newer_exact == {
        .Val(newer) -> return Ok(newer)
        .None -> {}
    }
    bound := [__RouteCandidate]{}
    loop candidate in scan.candidates {
        if candidate.store == {
            .Val(value) -> { if value == store -> bound.push(candidate.copy()) }
            .None -> {}
        }
    }
    if bound.len() == 1 -> return Ok(bound[0])
    if bound.len() > 1 -> return Err(ServiceError.Ambiguous("multiple active service authorities are bound to this store"))
    if scan.candidates.len() == 1 -> return Ok(scan.candidates[0])
    if scan.candidates.len() > 1 -> return Err(ServiceError.Ambiguous("service receipt matches multiple active provider authorities"))
    if scan.exact_stopped -> return Err(ServiceError.NotStarted("service worker `{entry.worker}` is not running"))
    if scan.newer_generation -> return Err(ServiceError.Stale("service receipt generation {entry.generation} is no longer current"))
    Err(ServiceError.Partitioned("service receipt provider authority is not registered"))
}

// The live endpoint for a durable receipt. A restarted provider holds a new
// authority for the same shard; the receipt's authority becomes its alias.
authority_current_endpoint: fn(runtime: ServiceRuntime, entry: __DeliveryEntry) -> ServiceEndpoint ServiceError! {
    selected: authority_route_select(authority_route_scan(entry), authority_store_identity(runtime.store), entry)
    endpoint: endpoint_new(selected.tree, selected.worker, selected.generation, selected.authority)
    _: authority_bind_store(runtime, endpoint)
    if endpoint.authority == entry.authority -> return Ok(endpoint)
    alias: authority_adopt_alias(endpoint, entry.authority)
    _: authority_bind_store(runtime, alias)
    Ok(alias)
}

delivery_routes_to_endpoint: fn(runtime: ServiceRuntime, entry: __DeliveryEntry, endpoint: ServiceEndpoint) -> Bool Never! {
    if entry.tree != endpoint.tree || entry.worker != endpoint.worker -> return false
    if entry.authority == endpoint.authority && entry.generation == endpoint.generation -> return true
    if authority_current_endpoint(runtime, entry) == {
        .Ok(current) -> current.tree == endpoint.tree && current.worker == endpoint.worker && current.generation == endpoint.generation
        .Err(_) -> false
    }
}

authority_enqueue_entry: fn(runtime: ServiceRuntime, entry: __DeliveryEntry) ServiceError! {
    endpoint: authority_current_endpoint(runtime, entry)
    if endpoint.tree != entry.tree || endpoint.worker != entry.worker -> return Err(ServiceError.Revoked("service receipt endpoint no longer names its worker"))
    authority_enqueue(runtime, endpoint, entry.id, entry.message)
}

pending_skipped: fn(skip_ids: [String], id: String) -> Bool Never! {
    loop skip in skip_ids {
        if skip == id -> return true
    }
    false
}

// Up to `capacity` pending receipts for `endpoint`, after queueing every
// eligible log entry not yet queued.
authority_take_pending: fn(endpoint: ServiceEndpoint, capacity: Int, skip_ids: [String]) -> [__PendingEntry] ServiceError! {
    __authority_validate(endpoint)
    if capacity <= 0 -> return Ok([__PendingEntry]{})
    bound: authority_bound_store(endpoint)
    store: bound ?? return Ok([__PendingEntry]{})
    runtime: ServiceRuntime{store: store, retention_ms: 0}
    gate := authority_gate().guard_edit()
    entries: authority_load(runtime)
    pending := pending_registry().guard_edit()
    slot: pending_queue_slot(pending.value, store, endpoint)
    identity: authority_store_identity(store)
    loop entry in entries {
        queued := false
        loop queued_entry in pending.value.queues[slot].entries {
            if queued_entry.id == entry.id && authority_store_identity(queued_entry.store) == identity -> queued = true
        }
        if entry.authority == "" || entry.tree != endpoint.tree || entry.worker != endpoint.worker || entry.state == DeliveryState.Cancelled || entry.dead -> next
        if !delivery_routes_to_endpoint(runtime, entry, endpoint) -> next
        if entry.delivered_to_worker && entry.delivered -> next
        // A retained receipt is eligible only after an explicit retry queues it.
        if entry.retained_until != None && !queued -> next
        if delivery_entry_expired(entry, service_now()) || pending_skipped(skip_ids, entry.id) -> next
        // A receipt already handed to the worker is never retried silently.
        if entry.delivered_to_worker && !entry.delivered -> next
        if queued -> next
        if pending.value.queues[slot].entries.len() >= 100000 -> return Err(ServiceError.Full("service authority pending delivery queue is full"))
        pending.value.queues[slot].entries.push(__PendingEntry{id: entry.id, message: entry.message, store: store})
    }
    selected := [__PendingEntry]{}
    retained := [__PendingEntry]{}
    loop entry in pending.value.queues[slot].entries {
        if selected.len() < capacity && !pending_skipped(skip_ids, entry.id) {
            selected.push(entry)
        } else {
            retained.push(entry)
        }
    }
    pending.value.queues[slot].entries = retained
    Ok(selected)
}

// Put undelivered receipts back at the head of the queue after a mailbox
// boundary rejected a batch.
authority_requeue_pending: fn(endpoint: ServiceEndpoint, entries: [__PendingEntry]) ServiceError! {
    __authority_validate(endpoint)
    if entries.len() == 0 -> return Ok()
    bound: authority_bound_store(endpoint)
    store: bound ?? return Err(ServiceError.Partitioned("service endpoint has no bound authority store for pending delivery"))
    runtime: ServiceRuntime{store: store, retention_ms: 0}
    gate := authority_gate().guard_edit()
    receipts: authority_load(runtime)
    normalized := [__PendingEntry]{}
    loop entry in entries {
        authority_validate_text(entry.id, "service id", 1024, false)
        authority_validate_text(entry.message, "service message", 1048576, true)
        authority_validate_text(entry.store, "service store", 4096, false)
        if authority_store_identity(entry.store) != store -> return Err(ServiceError.Revoked("pending delivery belongs to another authority store"))
        index: delivery_entry_index(receipts, entry.id) ?? return Err(ServiceError.Unknown("service id `{entry.id}` is unknown"))
        receipt: receipts[index]
        if receipt.authority == "" || receipt.tree != endpoint.tree || receipt.worker != endpoint.worker || !delivery_routes_to_endpoint(runtime, receipt, endpoint) || receipt.message != entry.message {
            return Err(ServiceError.Revoked("pending delivery does not match its authority receipt"))
        }
        if receipt.dead -> return Err(ServiceError.Unavailable("cannot requeue a dead-lettered service receipt"))
        if receipt.state == DeliveryState.Cancelled -> return Err(ServiceError.Unavailable("cannot requeue a cancelled service receipt"))
        if delivery_entry_expired(receipt, service_now()) -> return Err(ServiceError.Expired("service receipt retention expired during delivery rollback"))
        normalized.push(__PendingEntry{id: entry.id, message: entry.message, store: store})
    }
    pending := pending_registry().guard_edit()
    slot: pending_queue_slot(pending.value, store, endpoint)
    queue: pending.value.queues[slot].entries
    if queue.len() > 100000 - normalized.len() -> return Err(ServiceError.Full("service authority pending delivery queue is full"))
    restored := [__PendingEntry]{}
    loop entry in normalized {
        if !pending_contains(queue, entry) && !pending_contains(restored, entry) -> restored.push(entry)
    }
    loop entry in queue -> restored.push(entry.copy())
    pending.value.queues[slot].entries = restored
}

// Record that a pending receipt reached the worker mailbox, separately from
// commit: a crash after this marker and before commit stays retryable.
authority_mark_delivered: fn(store: String, id: String) ServiceError! {
    authority_validate_text(id, "service id", 1024, false)
    runtime: ServiceRuntime{store: store, retention_ms: 0}
    authority_validate_runtime(runtime)
    operation: authority_operation_lock(runtime, id)
    gate := authority_gate().guard_edit()
    entries: authority_entries(runtime, authority_read(runtime))
    index: delivery_entry_index(entries, id) ?? return Err(ServiceError.Unknown("service id `{id}` is unknown"))
    entry: entries[index]
    if entry.dead {
        pending_remove_entry(runtime, entry)
        return Err(ServiceError.Unavailable("cannot deliver a dead-lettered service receipt"))
    }
    if entry.state == DeliveryState.Cancelled {
        pending_remove_entry(runtime, entry)
        return Err(ServiceError.Unavailable("cannot deliver a cancelled delivery"))
    }
    // The reservation goes before the durable marker: if the marker append
    // fails, the log stays the recovery source.
    pending_remove_entry(runtime, entry)
    if !entry.delivered_to_worker -> authority_append_event(runtime, entry, DeliveryState.Delivering, entry.attempts, service_now())
}

__DeliveryRead: struct {
    entry: __DeliveryEntry
    records: [__DeliveryRecord]
}

// The receipt behind a delivery handle, checked against the handle.
delivery_entry: fn(delivery: Delivery) -> __DeliveryRead ServiceError! {
    authority_validate_text(delivery.id, "delivery id", 1024, false)
    runtime: ServiceRuntime{store: delivery.store, retention_ms: 0}
    authority_validate_runtime(runtime)
    operation: authority_operation_lock(runtime, delivery.id)
    gate := authority_gate().guard_edit()
    records := authority_read(runtime)
    entries := authority_entries(runtime, records)
    if authority_cleanup_expired(runtime, entries, service_now()) {
        records = authority_read(runtime)
        entries = authority_entries(runtime, records)
    }
    index: delivery_entry_index(entries, delivery.id) ?? return Err(ServiceError.Unknown("delivery `{delivery.id}` is unknown"))
    entry: entries[index]
    if delivery.authority != entry.authority -> return Err(ServiceError.Revoked("delivery handle authority does not match its receipt"))
    if delivery.generation != entry.generation -> return Err(ServiceError.Stale("delivery handle generation does not match its receipt"))
    Ok(__DeliveryRead{entry: entry, records: records})
}

delivery_validate_runtime: fn(runtime: ServiceRuntime, delivery: Delivery) ServiceError! {
    if authority_store_identity(runtime.store) != delivery.store -> return Err(ServiceError.Revoked("delivery handle belongs to another authority store"))
    _: delivery_entry(delivery)
}

delivery_status: fn(delivery: Delivery) -> DeliveryState ServiceError! {
    Ok(delivery_entry(delivery).entry.state)
}

// A single status sample, not polling or a scheduler wait.
delivery_wait: fn(delivery: Delivery) -> DeliveryState ServiceError! {
    delivery_status(delivery)
}

delivery_receipt: fn(delivery: Delivery) -> DeliveryReceipt ServiceError! {
    entry: delivery_entry(delivery).entry
    signature: delivery_receipt_signature(entry, delivery.duplicate)
    Ok(DeliveryReceipt{id: entry.id, state: entry.state, attempts: entry.attempts, retention_until: entry.retained_until ?? -1, deadline: entry.expires, idempotency_key: entry.key, duplicate: delivery.duplicate, authority: entry.authority, generation: entry.generation, signature: signature})
}

delivery_events: fn(delivery: Delivery) -> [DeliveryEvent] ServiceError! {
    read: delivery_entry(delivery)
    entry: read.entry
    events := [DeliveryEvent]{}
    loop record in read.records {
        fields: record.fields
        if record.op == "S" && fields.len() == 10 && fields[0] == delivery.id {
            generation: workflow_i64(fields[5]) ?? return Err(authority_error("delivery event generation is malformed"))
            timestamp: workflow_i64(fields[7]) ?? return Err(authority_error("delivery event timestamp is malformed"))
            if events.len() != 0 -> return Err(authority_error("delivery event sequence is not monotonic"))
            events.push(DeliveryEvent{sequence: 1, state: DeliveryState.Accepted, attempts: 0, timestamp: timestamp, signature: fields[9]})
            expires: workflow_i64(fields[8]) ?? return Err(authority_error("delivery acceptance expiry is malformed"))
            expected: delivery_acceptance_signature(fields[2], generation, fields[0], fields[1], fields[3], fields[4], fields[6], timestamp, expires)
            delivery_signature_matches(expected, fields[9], "delivery acceptance signature is malformed", "delivery acceptance history signature does not validate")
        } else if record.op == "E" && fields.len() == 6 && fields[0] == delivery.id {
            sequence: workflow_i64(fields[1]) ?? return Err(authority_error("delivery event sequence is malformed"))
            state: delivery_parse_state(fields[2]) ?? return Err(authority_error("service delivery lifecycle state is malformed"))
            attempts: workflow_i64(fields[3]) ?? return Err(authority_error("delivery event attempts are malformed"))
            timestamp: workflow_i64(fields[4]) ?? return Err(authority_error("delivery event timestamp is malformed"))
            expected_sequence: if events.len() == 0 -> 1 else -> service_saturating_add(events[events.len() - 1].sequence, 1)
            if sequence != expected_sequence -> return Err(authority_error("delivery event sequence is not monotonic"))
            expected: delivery_event_signature(entry.authority, entry.generation, fields[0], sequence, state, attempts, timestamp)
            delivery_signature_matches(expected, fields[5], "delivery event signature is malformed", "delivery event signature does not validate")
            events.push(DeliveryEvent{sequence: sequence, state: state, attempts: attempts, timestamp: timestamp, signature: fields[5]})
        }
    }
    if events.len() != entry.event_sequence || events.len() == 0 || events[0].sequence != 1 -> return Err(authority_error("delivery event history is incomplete"))
    Ok(events)
}

delivery_retry: fn(delivery: Delivery) -> Delivery ServiceError! {
    _: delivery_entry(delivery)
    runtime_retry(ServiceRuntime{store: delivery.store, retention_ms: 0}, delivery)
}

delivery_cancel: fn(delivery: Delivery) -> Delivery ServiceError! {
    _: delivery_entry(delivery)
    runtime: ServiceRuntime{store: delivery.store, retention_ms: 0}
    authority_validate_runtime(runtime)
    operation: authority_operation_lock(runtime, delivery.id)
    gate := authority_gate().guard_edit()
    entries: authority_entries(runtime, authority_read(runtime))
    index: delivery_entry_index(entries, delivery.id) ?? return Err(ServiceError.Unknown("delivery `{delivery.id}` is unknown"))
    entry: entries[index]
    if entry.state == DeliveryState.DeadLettered -> return Err(ServiceError.Unavailable("dead-lettered delivery cannot be cancelled"))
    if entry.state == DeliveryState.Delivered -> return Err(ServiceError.Policy("delivered work cannot be cancelled"))
    if entry.state != DeliveryState.Cancelled {
        authority_append_event(runtime, entry, DeliveryState.Cancelled, entry.attempts, service_now())
        pending_remove_entry(runtime, entry)
    }
    Ok(delivery)
}

// Durable acceptance: an existing key resolves to its receipt; a new key
// appends a signed acceptance and queues it for the worker.
runtime_send: fn(runtime: ServiceRuntime, endpoint: ServiceEndpoint, message: String, key: String) -> Delivery ServiceError! {
    authority_validate_runtime(runtime)
    validate_endpoint_identity(endpoint.authority, endpoint.tree, endpoint.worker, endpoint.generation)
    __authority_validate(endpoint)
    _: authority_bind_store(runtime, endpoint)
    authority_validate_text(key, "idempotency key", 1024, false)
    authority_validate_text(message, "service message", 1048576, true)
    operation: authority_operation_lock(runtime, key)
    gate := authority_gate().guard_edit()
    entries := authority_entries(runtime, authority_read(runtime))
    now: service_now()
    if authority_cleanup_expired(runtime, entries, now) -> entries = authority_entries(runtime, authority_read(runtime))
    loop entry in entries {
        if entry.key != key || entry.authority == "" -> next
        // The authority token is generation-scoped; the logical tree/worker
        // operation still resolves to this receipt. Route or message reuse
        // is rejected before anything is appended or queued.
        if entry.tree != endpoint.tree || entry.worker != endpoint.worker || entry.message != message {
            return Err(ServiceError.Policy("idempotency key was already used by another service authority or delivery"))
        }
        if !entry.dead && entry.expires > now && !entry.delivered && entry.state != DeliveryState.Cancelled -> authority_enqueue_entry(runtime, entry)
        return Ok(delivery_for_entry(runtime, entry, true))
    }
    id: authority_delivery_id(runtime.store, endpoint.tree, endpoint.worker, message, key)
    expires: authority_retention_deadline(now, runtime.retention_ms)
    signature: delivery_acceptance_signature(endpoint.authority, endpoint.generation, id, key, endpoint.tree, endpoint.worker, message, now, expires)
    authority_append(runtime, "S", [String]{id, key, endpoint.authority, endpoint.tree, endpoint.worker, "{endpoint.generation}", message, "{now}", "{expires}", service_encoding.bytes_to_hex(signature)})
    authority_enqueue(runtime, endpoint, id, message)
    Ok(Delivery{id: id, store: authority_store_identity(runtime.store), duplicate: false, authority: endpoint.authority, generation: endpoint.generation})
}

// The one explicit operation that may reset a receipt already handed to a
// worker but not committed.
runtime_retry: fn(runtime: ServiceRuntime, delivery: Delivery) -> Delivery ServiceError! {
    authority_validate_runtime(runtime)
    delivery_validate_runtime(runtime, delivery)
    id: delivery.id
    authority_validate_text(id, "service id", 1024, false)
    operation: authority_operation_lock(runtime, id)
    gate := authority_gate().guard_edit()
    entries := authority_entries(runtime, authority_read(runtime))
    now: service_now()
    if authority_cleanup_expired(runtime, entries, now) -> entries = authority_entries(runtime, authority_read(runtime))
    index: delivery_entry_index(entries, id) ?? return Err(ServiceError.Unknown("service id `{id}` is unknown"))
    entry: entries[index]
    if entry.authority == "" -> return Err(ServiceError.Unavailable("service receipt has no endpoint authority"))
    if entry.dead -> return Err(ServiceError.Unavailable("cannot retry a dead-lettered delivery"))
    if entry.state == DeliveryState.Cancelled -> return Err(ServiceError.Policy("cancelled delivery cannot be retried"))
    if entry.delivered && entry.retained_until == None -> return Ok(delivery_for_entry(runtime, entry, false))
    authority_append_event(runtime, entry, DeliveryState.Accepted, service_saturating_add(entry.attempts, 1), now)
    authority_enqueue_entry(runtime, entry)
    Ok(delivery_for_entry(runtime, entry, false))
}

runtime_dead_letter: fn(runtime: ServiceRuntime, delivery: Delivery) -> Delivery ServiceError! {
    authority_validate_runtime(runtime)
    delivery_validate_runtime(runtime, delivery)
    id: delivery.id
    authority_validate_text(id, "service id", 1024, false)
    operation: authority_operation_lock(runtime, id)
    gate := authority_gate().guard_edit()
    entries: authority_load(runtime)
    index: delivery_entry_index(entries, id) ?? return Err(ServiceError.Unknown("service id `{id}` is unknown"))
    entry: entries[index]
    if entry.dead -> return Ok(delivery_for_entry(runtime, entry, false))
    authority_append_event(runtime, entry, DeliveryState.DeadLettered, entry.attempts, service_now())
    pending_remove_entry(runtime, entry)
    Ok(delivery_for_entry(runtime, entry, false))
}

runtime_retain: fn(runtime: ServiceRuntime, delivery: Delivery) -> Delivery ServiceError! {
    authority_validate_runtime(runtime)
    delivery_validate_runtime(runtime, delivery)
    id: delivery.id
    authority_validate_text(id, "service id", 1024, false)
    operation: authority_operation_lock(runtime, id)
    gate := authority_gate().guard_edit()
    entries: authority_load(runtime)
    index: delivery_entry_index(entries, id) ?? return Err(ServiceError.Unknown("service id `{id}` is unknown"))
    entry: entries[index]
    if entry.dead -> return Ok(delivery_for_entry(runtime, entry, false))
    if entry.state == DeliveryState.Cancelled -> return Err(ServiceError.Policy("cancelled delivery cannot be retained"))
    until: authority_retention_deadline(service_now(), runtime.retention_ms)
    signature: delivery_retention_signature(entry, until)
    authority_append(runtime, "K", [String]{id, "{until}", service_encoding.bytes_to_hex(signature)})
    Ok(delivery_for_entry(runtime, entry, false))
}

// Durably acknowledge a delivered receipt; an acknowledged receipt is
// idempotent.
runtime_commit: fn(runtime: ServiceRuntime, delivery: Delivery) ServiceError! {
    authority_validate_runtime(runtime)
    delivery_validate_runtime(runtime, delivery)
    id: delivery.id
    authority_validate_text(id, "service id", 1024, false)
    operation: authority_operation_lock(runtime, id)
    gate := authority_gate().guard_edit()
    entries := authority_entries(runtime, authority_read(runtime))
    now: service_now()
    target_expired := false
    if delivery_entry_index(entries, id) == {
        .Val(found) -> target_expired = delivery_entry_expired(entries[found], now)
        .None -> {}
    }
    if authority_cleanup_expired(runtime, entries, now) -> entries = authority_entries(runtime, authority_read(runtime))
    index: delivery_entry_index(entries, id) ?? return Err(ServiceError.Unknown("service id `{id}` is unknown"))
    entry: entries[index]
    if entry.dead {
        pending_remove_entry(runtime, entry)
        if target_expired -> return Err(ServiceError.Expired("service receipt retention expired"))
        return Err(ServiceError.Unavailable("cannot commit a dead-lettered service receipt"))
    }
    if !entry.delivered_to_worker -> return Err(ServiceError.Unavailable("service receipt has not reached its worker"))
    if !entry.delivered -> authority_append_event(runtime, entry, DeliveryState.Delivered, entry.attempts, service_now())
    pending_remove_entry(runtime, entry)
}

delivery_receipt_signature: fn(entry: __DeliveryEntry, duplicate: Bool) -> String ServiceError! {
    key: delivery_generation_key(entry.authority, entry.generation)
    fields: [String]{"jet-service-delivery-receipt-v1", entry.id, entry.key, "{duplicate}", entry.tree, entry.worker, entry.message, delivery_state_show(entry.state), "{entry.attempts}", "{entry.expires}", "{entry.retained_until ?? -1}", "{entry.generation}"}
    Ok(service_encoding.bytes_to_hex(service_crypto.hmac_sha256(key, delivery_signature_payload(fields))))
}

delivery_event_signature: fn(authority: String, generation: Int, id: String, sequence: Int, state: DeliveryState, attempts: Int, timestamp: Int) -> [U8] ServiceError! {
    key: if delivery_generation_key(authority, generation) == {
        .Ok(value) -> value
        .Err(error) -> { return Err(error) }
    }
    fields: [String]{"jet-service-delivery-event-v1", id, "{sequence}", delivery_state_show(state), "{attempts}", "{timestamp}"}
    Ok(service_crypto.hmac_sha256(key, delivery_signature_payload(fields)))
}

delivery_generation_key: fn(authority: String, generation: Int) -> [U8] ServiceError! {
    key: if __authority_signing_key(authority) == {
        .Ok(value) -> value
        .Err(error) -> { return Err(error) }
    }
    fields: [String]{"jet-service-delivery-generation-v1", "{generation}"}
    Ok(service_crypto.hmac_sha256(key, delivery_signature_payload(fields)))
}

delivery_signature_payload: fn(fields: [String]) -> [U8] Never! {
    payload := [U8]{}
    loop field in fields {
        bytes: field.bytes()
        length: bytes.len()
        loop byte in 0..<8 -> payload.push(U8{(length >> ((7 - byte) * 8)).bit_and(255)})
        loop value in bytes -> payload.push(value)
    }
    payload
}

delivery_parse_state: fn(text: String) -> DeliveryState? Never! {
    if text == "Pending" -> return Val(DeliveryState.Pending)
    if text == "Accepted" -> return Val(DeliveryState.Accepted)
    if text == "Delivering" -> return Val(DeliveryState.Delivering)
    if text == "Delivered" -> return Val(DeliveryState.Delivered)
    if text == "DeadLettered" -> return Val(DeliveryState.DeadLettered)
    if text == "Cancelled" -> return Val(DeliveryState.Cancelled)
    None
}

#Test("delivery signature fields retain big-endian byte counts and state spellings") {
    fields: [String]{"λ", ""}
    assert(service_encoding.bytes_to_hex(delivery_signature_payload(fields)) == "0000000000000002cebb0000000000000000")
    assert(delivery_parse_state("Delivered") == (Val(DeliveryState.Delivered)))
    assert(delivery_parse_state("delivered") == None)
}

// Independent node:crypto oracle, captured in
// JsonStreams8/service-signature-oracle.json. Native framing:
// each length is u64 BE UTF8 bytes.
#Test("delivery receipt and event signatures match observed fixed-key framing vectors") {
    authority: "sa-000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
    generation_key: delivery_generation_key(authority, 7) ?? panic("fixed key")
    assert(service_encoding.bytes_to_hex(generation_key) == "0efa1cbc75008d741cc1cdfb5a9b4512112201437413147ff3a5bdaabc65699e")
    entry: __DeliveryEntry{id: "d1", key: "k1", tree: "tree", worker: "worker", authority: authority, generation: 7, message: "λ", created: 0, expires: 1700000000999, retained_until: Val(1700000010000), attempts: 3, state: DeliveryState.Delivered, event_sequence: 4, delivered_to_worker: true, delivered: true, dead: false}
    receipt: delivery_receipt_signature(entry, true) ?? panic("receipt vector")
    assert(receipt == "df0bd21f6f2307c792cfb3b56258a633200241a964aca0c5f669853f11883601")
    event: delivery_event_signature(authority, 7, "d1", 4, DeliveryState.Delivered, 3, 1700000000123) ?? panic("event vector")
    assert(service_encoding.bytes_to_hex(event) == "b26b530c1223a26a44476d6d44df66905c6cf02eaf51f440790b5ee153140aa6")
}

// The validated worker slot for `endpoint`.
find_worker: fn(tree: ServiceTree, endpoint: ServiceEndpoint) -> Int ServiceError! {
    validate_tree_endpoint(tree, endpoint)
    index: worker_slot(tree, endpoint) ?? return Err(ServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not in this tree"))
    Ok(index)
}

worker_named: fn(tree: ServiceTree, name: String) -> Int? Never! {
    loop index in 0..<tree.workers.len() {
        if tree.workers[index].name == name -> return Val(index)
    }
    None
}

// The durable delivery log lives beside the state store with its own framing.
delivery_store: fn(store: String) -> String Never! {
    "{store}.delivery"
}

// Replace a worker's channel with one holding `messages` and publish it to
// the endpoint registry, so routing never targets the closed channel.
worker_restore_mailbox: fn(tree: &ServiceTree, index: Int, messages: [String], draining: Bool) ServiceError! {
    channel_close(tree.workers[index].channel)
    if messages.len() > tree.workers[index].capacity -> return Err(ServiceError.Policy("mailbox messages exceed the bounded channel capacity"))
    channel: channel_new(tree.workers[index].capacity, messages) ?? return Err(ServiceError.Policy("mailbox channel could not restore its queued messages"))
    tree.workers[index].channel = channel
    authority_update(tree.workers[index].endpoint, tree.workers[index].running || draining, Val(tree.workers[index].channel))
}

// Ids of durable receipts this tree already queued locally for `endpoint`.
local_delivery_ids: fn(tree: ServiceTree, endpoint: ServiceEndpoint, store: String) -> [String] Never! {
    index: worker_slot(tree, endpoint) ?? return [String]{}
    messages: channel_snapshot(tree.workers[index].channel)
    ids := [String]{}
    loop record in tree.idempotency {
        recorded: record.endpoint
        if recorded.tree != endpoint.tree || recorded.worker != endpoint.worker || recorded.authority != endpoint.authority -> next
        queued := false
        loop message in messages {
            if message == record.message -> queued = true
        }
        if queued -> ids.push(authority_delivery_id(store, recorded.tree, recorded.worker, record.message, record.key))
    }
    ids
}

send_durable: fn(tree: &ServiceTree, endpoint: ServiceEndpoint, message: String, idempotency_key: String) -> Delivery ServiceError! {
    if tree.delivery != ServiceDelivery.DurableAtLeastOnce -> return Err(ServiceError.Policy("send_durable requires DurableAtLeastOnce delivery"))
    authority: tree.state_authority ?? return Err(ServiceError.Policy("durable service delivery needs its injected authority"))
    runtime: ServiceRuntime{store: delivery_store(authority.store), retention_ms: 0}
    if !valid_service_text(idempotency_key, 256) -> return Err(ServiceError.Policy("durable send requires a non-empty idempotency key"))
    if !valid_record_payload(message) -> return Err(ServiceError.Policy("service message exceeds the 1 MiB limit"))
    if !tree.started -> return Err(ServiceError.NotStarted("service tree is not started"))
    validate_tree_endpoint(tree, endpoint)
    draining: worker_contains(tree.draining, endpoint.worker)
    if draining -> return Err(ServiceError.Unavailable("service endpoint is draining"))
    local_id: authority_delivery_id(runtime.store, endpoint.tree, endpoint.worker, message, idempotency_key)
    loop id in local_delivery_ids(tree, endpoint, runtime.store) {
        if id == local_id -> return Ok(Delivery{id: local_id, store: runtime.store, duplicate: true, authority: endpoint.authority, generation: endpoint.generation})
    }
    delivery: runtime_send(runtime, endpoint, message, idempotency_key)
    if delivery_status(delivery) != DeliveryState.Accepted -> return Ok(delivery)
    index: worker_named(tree, endpoint.worker) ?? return Err(ServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not in this tree"))
    before: channel_snapshot(tree.workers[index].channel)
    if send(tree, endpoint, message) == {
        .Err(error) -> {
            if error == {
                .Full(_) -> {
                    runtime_dead_letter(runtime, delivery).drop("the mailbox rejection is the reported failure")
                    if tree.dead_letters.len() < 100000 -> tree.dead_letters.push(delivery.id)
                }
                .Ambiguous(_) | .Unknown(_) | .NotStarted(_) | .Policy(_) | .Unavailable(_) | .Partitioned(_) | .Revoked(_) | .Stale(_) | .Expired(_) -> {}
            }
            return Err(error)
        }
        .Ok(_) -> {}
    }
    if authority_mark_delivered(runtime.store, delivery.id) == {
        .Err(error) -> {
            // The mailbox owns the message but its durable marker failed:
            // restore the pre-send queue; the log stays the recovery source.
            missing: ServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} disappeared during durable delivery")
            slot: worker_named(tree, endpoint.worker) ?? return Err(ServiceError.Policy("{service_error_show(error)}; mailbox rollback failed: {service_error_show(missing)}"))
            if worker_restore_mailbox(tree, slot, before, draining) == {
                .Err(rollback_error) -> return Err(ServiceError.Policy("{service_error_show(error)}; mailbox rollback failed: {service_error_show(rollback_error)}"))
                .Ok(_) -> return Err(error)
            }
        }
        .Ok(_) -> {}
    }
    if tree.idempotency.len() < 100000 {
        seen := false
        loop record in tree.idempotency {
            if record.key == idempotency_key -> seen = true
        }
        if !seen -> tree.idempotency.push(__IdempotencyRecord{key: idempotency_key, endpoint: endpoint, message: message})
    }
    Ok(delivery)
}

receive: fn(tree: &ServiceTree, endpoint: ServiceEndpoint) -> String ServiceError! {
    if !tree.started -> return Err(ServiceError.NotStarted("service tree is not started"))
    validate_tree_endpoint(tree, endpoint)
    draining: worker_contains(tree.draining, endpoint.worker)
    slot: worker_slot(tree, endpoint) ?? return Err(ServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not in this tree"))
    available := 0
    if tree.workers[slot].running || draining -> available = tree.workers[slot].capacity - channel_depth(tree.workers[slot].channel)
    // A drain closes new endpoint sends but still consumes durable receipts
    // already in flight; otherwise a retried receipt pins the shard forever.
    if available > 0 {
        local_ids := [String]{}
        if tree.delivery == ServiceDelivery.DurableAtLeastOnce {
            if tree.state_authority == {
                .Val(authority) -> local_ids = local_delivery_ids(tree, endpoint, delivery_store(authority.store))
                .None -> {}
            }
        }
        pending: authority_take_pending(endpoint, available, local_ids)
        if pending.len() != 0 {
            target: find_worker(tree, endpoint)
            loop i in 0..<pending.len() {
                record: pending[i]
                before: channel_snapshot(tree.workers[target].channel)
                sent: channel_try_send(tree.workers[target].channel, record.message)
                if sent != __ChannelSend.Sent {
                    error: if sent == __ChannelSend.Full -> ServiceError.Policy("service authority delivery exceeded mailbox capacity") else -> ServiceError.NotStarted("service authority worker mailbox is closed")
                    return Err(pending_delivery_rollback(tree, endpoint, target, pending.slice(i, pending.len()), before, draining, error))
                }
                if authority_mark_delivered(record.store, record.id) == {
                    .Err(error) -> return Err(pending_delivery_rollback(tree, endpoint, target, pending.slice(i, pending.len()), before, draining, error))
                    .Ok(_) -> {}
                }
            }
        }
    }
    current: find_worker(tree, endpoint)
    name: tree.workers[current].name
    channel: tree.workers[current].channel
    if !tree.workers[current].running && channel_depth(channel) == 0 -> return Err(ServiceError.NotStarted("worker `{name}` is not running"))
    before: channel_snapshot(channel)
    message := ""
    if channel_try_receive(channel) == {
        .Value(value) -> message = value
        .Empty -> return Err(ServiceError.Ambiguous("mailbox for `{name}` is empty"))
        .Closed -> return Err(ServiceError.NotStarted("mailbox for `{name}` is closed"))
    }
    if draining && channel_depth(channel) == 0 {
        if finish_drain(tree, endpoint) == {
            .Err(error) -> {
                missing: ServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} disappeared while restoring a drained mailbox")
                index: worker_exact(tree, endpoint) ?? return Err(ServiceError.Policy("{service_error_show(error)}; drained mailbox restore failed: {service_error_show(missing)}"))
                if worker_restore_mailbox(tree, index, before, draining) == {
                    .Err(restore_error) -> return Err(ServiceError.Policy("{service_error_show(error)}; drained mailbox restore failed: {service_error_show(restore_error)}"))
                    .Ok(_) -> return Err(error)
                }
            }
            .Ok(_) -> {}
        }
    }
    Ok(message)
}

// The worker whose endpoint equals `endpoint` in every identity field.
worker_exact: fn(tree: ServiceTree, endpoint: ServiceEndpoint) -> Int? Never! {
    loop index in 0..<tree.workers.len() {
        if tree.workers[index].endpoint == endpoint -> return Val(index)
    }
    None
}

// Requeue the undelivered suffix, then restore the mailbox; each runs once
// even when the other fails.
pending_delivery_rollback: fn(tree: &ServiceTree, endpoint: ServiceEndpoint, index: Int, remaining: [__PendingEntry], before: [String], draining: Bool, error: ServiceError) -> ServiceError Never! {
    authority_error := ServiceError?{None}
    if authority_requeue_pending(endpoint, remaining) == {
        .Err(failure) -> authority_error = Val(failure)
        .Ok(_) -> {}
    }
    mailbox_error := ServiceError?{None}
    if worker_restore_mailbox(tree, index, before, draining) == {
        .Err(failure) -> mailbox_error = Val(failure)
        .Ok(_) -> {}
    }
    pending_rollback_error(error, authority_error, mailbox_error)
}

pending_rollback_error: fn(error: ServiceError, authority_error: ServiceError?, mailbox_error: ServiceError?) -> ServiceError Never! {
    if authority_error == {
        .Val(rollback) -> {
            if mailbox_error == {
                .Val(mailbox) -> return ServiceError.Policy("{service_error_show(error)}; authority rollback failed: {service_error_show(rollback)}; mailbox rollback failed: {service_error_show(mailbox)}")
                .None -> return ServiceError.Policy("{service_error_show(error)}; authority rollback failed: {service_error_show(rollback)}; unmarked receipts remain recoverable from the authority log")
            }
        }
        .None -> {
            if mailbox_error == {
                .Val(mailbox) -> return ServiceError.Policy("{service_error_show(error)}; mailbox rollback failed: {service_error_show(mailbox)}")
                .None -> return error.copy()
            }
        }
    }
}

#Test("pending delivery failure preserves authority-requeue then mailbox-restore partial-failure text") {
    send_error: ServiceError.Policy("service authority delivery exceeded mailbox capacity")
    requeue_error: ServiceError.Policy("requeue")
    restore_error: ServiceError.Policy("restore")
    both: pending_rollback_error(send_error, Val(requeue_error), Val(restore_error))
    assert(service_error_show(both) == "service authority delivery exceeded mailbox capacity; authority rollback failed: requeue; mailbox rollback failed: restore")
    recoverable: pending_rollback_error(send_error, Val(requeue_error), None)
    assert(service_error_show(recoverable) == "service authority delivery exceeded mailbox capacity; authority rollback failed: requeue; unmarked receipts remain recoverable from the authority log")
    assert(service_error_show(pending_rollback_error(send_error, None, Val(restore_error))) == "service authority delivery exceeded mailbox capacity; mailbox rollback failed: restore")
    assert(pending_rollback_error(send_error, None, None) == send_error)
}

// Workers are declared before start. The tree mailbox and the endpoint
// registry share one bounded channel per worker.
worker: fn(tree: &ServiceTree, name: String, handler: fn(), handler_name: String, capacity: Int) -> ServiceEndpoint ServiceError! {
    if tree.started -> return Err(ServiceError.Policy("cannot add workers after start"))
    if capacity <= 0 || capacity > 1000000 -> return Err(ServiceError.Policy("mailbox capacity must be positive and bounded"))
    if name.trim().len() == 0 || !valid_service_text(name, 256) -> return Err(ServiceError.Policy("worker name must be non-empty and visible"))
    if handler_name.trim().len() == 0 || !valid_service_text(handler_name, 256) -> return Err(ServiceError.Policy("worker handler name must be non-empty and visible"))
    if tree.workers.len() >= 4096 -> return Err(ServiceError.Policy("service tree worker limit exceeded"))
    if worker_named(tree, name) != None -> return Err(ServiceError.Unknown("worker `{name}` already exists in tree `{tree.name}`"))
    if tree.authority == "" -> tree.authority = service_issue_authority()
    endpoint: endpoint_new(tree.name, name, tree.generation, tree.authority)
    channel: channel_new(capacity, [String]{}) ?? return Err(ServiceError.Policy("mailbox channel could not restore its queued messages"))
    // The mailbox exists before the endpoint is published, so a failed
    // allocation never leaves a ghost authority in the registry.
    authority_register(endpoint, false, Val(channel))
    tree.workers.push(__TreeWorker{name: name, handler_name: handler_name, endpoint: endpoint, capacity: capacity, channel: channel, restarts: [Int]{}, running: false})
    Ok(endpoint)
}

worker_contains: fn(names: [String], name: String) -> Bool Never! {
    loop existing in names {
        if existing == name -> return true
    }
    false
}

index_listed: fn(values: [Int], value: Int) -> Bool Never! {
    loop existing in values {
        if existing == value -> return true
    }
    false
}

worker_index: fn(names: [String], name: String) -> Int? Never! {
    loop i in 0..<names.len() {
        if names[i] == name -> return Val(i)
    }
    None
}

worker_names: fn(tree: ServiceTree) -> [String] Never! {
    names := [String]{}
    loop worker in tree.workers -> names.push(worker.name)
    names
}

group_members: fn(tree: ServiceTree) -> [[String]] Never! {
    members := [[String]]{}
    loop group in tree.groups -> members.push(group.workers)
    members
}

// The group supervising `worker`, or the root (`groups.len()`).
worker_supervisor: fn(groups: [[String]], worker: String) -> Int Never! {
    loop i in 0..<groups.len() {
        if worker_contains(groups[i], worker) -> return i
    }
    groups.len()
}

worker_scope: fn(names: [String], groups: [[String]], worker: String) -> (supervisor: Int, scope: [Int]) Never! {
    supervisor: worker_supervisor(groups, worker)
    if supervisor < groups.len() {
        scope := [Int]{}
        loop member in groups[supervisor] {
            if worker_index(names, member) == {
                .Val(index) -> scope.push(index)
                .None -> {}
            }
        }
        return (supervisor: supervisor, scope: scope)
    }
    scope := [Int]{}
    loop i in 0..<names.len() {
        grouped := false
        loop group in groups {
            if worker_contains(group, names[i]) -> grouped = true
        }
        if !grouped -> scope.push(i)
    }
    (supervisor: groups.len(), scope: scope)
}

worker_targets: fn(restart: ServiceRestart, scope: [Int], failed: Int) -> [Int] Never! {
    if restart == ServiceRestart.OneForOne -> return [Int]{failed}
    begin := 0
    if restart == ServiceRestart.RestForOne {
        loop i in 0..<scope.len() {
            if scope[i] == failed {
                begin = i
                break
            }
        }
    }
    out := [Int]{}
    loop i in begin..<scope.len() -> out.push(scope[i])
    out
}

// Restart instants are signed 64-bit milliseconds; the window start
// saturates at the 64-bit bounds.
worker_window_start: fn(now: Int, per: Int) -> Int Never! {
    if per > 0 {
        if now < -9223372036854775808 + per -> return -9223372036854775808
    }
    if per < 0 {
        if now > 9223372036854775807 + per -> return 9223372036854775807
    }
    now - per
}

worker_spent: fn(restarts: [Int], now: Int, per: Int) -> Int Never! {
    start: worker_window_start(now, per)
    spent := 0
    loop at in restarts {
        if at > start -> spent = spent + 1
    }
    spent
}

// Record a restart at `now`, keeping only the instants the budget counts.
worker_pruned: fn(restarts: [Int], now: Int, per: Int) -> [Int] Never! {
    start: worker_window_start(now, per)
    out := [Int]{}
    loop at in restarts {
        if at > start -> out.push(at)
    }
    if now > start -> out.push(now)
    out
}

// One policy lookup: the supervising group's row carries both the restart
// strategy and the budget that decides escalation.
fail_worker: fn(tree: &ServiceTree, endpoint: ServiceEndpoint) ServiceError! {
    if !tree.started -> return Err(ServiceError.NotStarted("service tree is not started"))
    validate_tree_endpoint(tree, endpoint)
    names: worker_names(tree)
    scope: worker_scope(names, group_members(tree), endpoint.worker)
    restart := tree.restart
    max := tree.budget_max
    per := tree.budget_per_ms
    if scope.supervisor < tree.groups.len() {
        restart = tree.groups[scope.supervisor].restart
        max = tree.groups[scope.supervisor].budget_max
        per = tree.groups[scope.supervisor].budget_per_ms
    }
    now: service_now()
    preserve: tree.delivery == ServiceDelivery.DurableAtLeastOnce
    failed: worker_index(names, endpoint.worker) ?? return Err(ServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not in this tree"))
    targets: worker_targets(restart, scope.scope, failed)
    loop index in targets {
        if worker_spent(tree.workers[index].restarts, now, per) >= max {
            reason: "worker `{tree.workers[index].name}` spent its restart budget of {max} per {per}ms; the supervisor escalates to its parent group"
            loop i in 0..<tree.workers.len() {
                tree.workers[i].running = false
                if authority_update(tree.workers[i].endpoint, false, None) == {
                    .Err(_) -> authority_register(tree.workers[i].endpoint, false, Val(tree.workers[i].channel)).drop("escalation reports the budget failure, not the registry fallback")
                    .Ok(_) -> {}
                }
            }
            tree.started = false
            return Err(ServiceError.Unavailable(reason))
        }
    }
    desired := [Bool]{}
    loop i in 0..<tree.workers.len() {
        desired.push(if index_listed(targets, i) -> !worker_contains(tree.partitioned, tree.workers[i].name) else -> tree.workers[i].running)
    }
    loop i in 0..<tree.workers.len() {
        if authority_update(tree.workers[i].endpoint, desired[i], None) == {
            .Err(error) -> {
                rollback := ServiceError?{None}
                loop k in 0..<i {
                    undo: i - 1 - k
                    if authority_update(tree.workers[undo].endpoint, tree.workers[undo].running, None) == {
                        .Err(failure) -> { if rollback == None -> rollback = Val(failure) }
                        .Ok(_) -> {}
                    }
                }
                if rollback == {
                    .Val(failure) -> return Err(ServiceError.Policy("{service_error_show(error)}; service failure authority rollback failed: {service_error_show(failure)}"))
                    .None -> return Err(error)
                }
            }
            .Ok(_) -> {}
        }
    }
    loop index in targets {
        tree.workers[index].restarts = worker_pruned(tree.workers[index].restarts, now, per)
        tree.workers[index].running = true
        messages: if preserve -> channel_snapshot(tree.workers[index].channel) else -> [String]{}
        channel_close(tree.workers[index].channel)
        tree.workers[index].channel = channel_new(tree.workers[index].capacity, messages) ?? panic("validated service mailbox must restart with its bounded queue")
        authority_update(tree.workers[index].endpoint, desired[index], Val(tree.workers[index].channel))
    }
    // A partition is an authority decision: restart policy may revive a
    // crashed worker but never rejoins a partitioned side.
    loop i in 0..<tree.workers.len() {
        if worker_contains(tree.partitioned, tree.workers[i].name) -> tree.workers[i].running = false
    }
}

// The observable count is the spent budget under the supervising policy.
restarts: fn(tree: ServiceTree, endpoint: ServiceEndpoint) -> Int ServiceError! {
    validate_tree_endpoint(tree, endpoint)
    supervisor: worker_supervisor(group_members(tree), endpoint.worker)
    per: if supervisor < tree.groups.len() -> tree.groups[supervisor].budget_per_ms else -> tree.budget_per_ms
    now: service_now()
    loop worker in tree.workers {
        if worker.name == endpoint.worker && worker.endpoint.tree == endpoint.tree -> return Ok(worker_spent(worker.restarts, now, per))
    }
    Err(ServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not in this tree"))
}

mailbox_depth: fn(tree: ServiceTree, endpoint: ServiceEndpoint) -> Int ServiceError! {
    validate_tree_endpoint(tree, endpoint)
    loop worker in tree.workers {
        if worker.name == endpoint.worker && worker.endpoint.tree == endpoint.tree -> return Ok(channel_depth(worker.channel))
    }
    Err(ServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not in this tree"))
}

// --- Lifecycle and rollout -------------------------------------------------
// No worker owns an in-process task, so the native task discharge/start steps
// (and their recovery branches) have nothing to act on here.

// A worker still routed at `generation` after a handoff pinned its shard.
generation_is_pinned: fn(tree: ServiceTree, worker: String, generation: Int) -> Bool Never! {
    receipt: tree.last_upgrade ?? return false
    receipt.to_generation == tree.generation && receipt.from_generation == generation && worker_contains(receipt.pinned_shards, worker)
}

// Durable delivery binds every running endpoint to the tree's delivery store.
bind_delivery_endpoint: fn(tree: ServiceTree, endpoint: ServiceEndpoint) ServiceError! {
    if tree.delivery != ServiceDelivery.DurableAtLeastOnce -> return Ok()
    authority: tree.state_authority ?? return Err(ServiceError.Policy("durable service delivery needs its injected authority"))
    _: authority_bind_store(ServiceRuntime{store: delivery_store(authority.store), retention_ms: 0}, endpoint)
}

// `error`, or a Policy that also names the failed recovery `step`.
recovery_error: fn(error: &&ServiceError, recovery: ServiceError?, step: String) -> ServiceError Never! {
    failure: recovery ?? return error
    ServiceError.Policy("{service_error_show(error)}; {step} failed: {service_error_show(failure)}")
}

names_remove: fn(names: &[String], name: String) Never! {
    if worker_index(names, name) == .Val(at) -> _: names.remove(at, .Slot)
}

receipt_unpinned: fn(receipt: ServiceUpgradeReceipt?, name: String) -> ServiceUpgradeReceipt? Never! {
    current := receipt ?? return None
    names_remove(current.pinned_shards, name)
    Val(current)
}

// A draining worker's mailbox just emptied: a pinned old-generation shard is
// promoted to the active generation; any other drained worker stops.
finish_drain: fn(tree: &ServiceTree, endpoint: ServiceEndpoint) ServiceError! {
    lock: rollout_operation_lock(tree)
    validate_tree_endpoint(tree, endpoint)
    index: worker_slot(tree, endpoint) ?? return Err(ServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not in this tree"))
    if generation_is_pinned(tree, endpoint.worker, tree.workers[index].endpoint.generation) {
        if !promote_worker_generation(tree, endpoint.worker) -> return Err(ServiceError.Unavailable("drained shard has uncommitted durable delivery"))
        return Ok()
    }
    authority_update(endpoint, false, None)
    tree.workers[index].running = false
}

// Move a pinned shard to the active generation once no durable receipt still
// routes to its old endpoint; false leaves it pinned.
promote_worker_generation: fn(tree: &ServiceTree, name: String) -> Bool ServiceError! {
    index: worker_named(tree, name) ?? return Err(ServiceError.Unknown("worker `{name}` disappeared"))
    old: tree.workers[index].endpoint
    next: endpoint_new(old.tree, old.worker, tree.generation, old.authority)
    running: !worker_contains(tree.partitioned, name)
    if authority_has_uncommitted(old) -> return Ok(false)
    old_draining: worker_contains(tree.draining, name)
    authority_rotate(old, next, running, false, Val(tree.workers[index].channel))
    if running {
        if bind_delivery_endpoint(tree, next) == {
            .Err(error) -> {
                recovery := ServiceError?{None}
                if authority_rotate(next, old, running, old_draining, Val(tree.workers[index].channel)) == {
                    .Err(failure) -> recovery = Val(failure)
                    .Ok(_) -> {}
                }
                return Err(recovery_error(error, recovery, "service authority recovery"))
            }
            .Ok(_) -> {}
        }
    }
    tree.workers[index].endpoint = next
    tree.workers[index].running = running
    loop entry in 0..<tree.directory.len() {
        if tree.directory[entry].endpoint.worker == name {
            tree.directory[entry].endpoint.generation = tree.generation
            tree.directory[entry].proof = directory_sign(tree.authority, tree.name, tree.directory[entry].name, tree.directory[entry].endpoint)
        }
    }
    loop record in 0..<tree.idempotency.len() {
        if tree.idempotency[record].endpoint.worker == name -> tree.idempotency[record].endpoint.generation = tree.generation
    }
    tree.last_upgrade = receipt_unpinned(tree.last_upgrade, name)
    names_remove(tree.draining, name)
    rollout_store_write(tree)
    Ok(true)
}

// The durable records a restart resumes from, when the tree has an authority.
start_load_state: fn(tree: &ServiceTree) ServiceError! {
    authority: tree.state_authority ?? return Ok()
    records := state_load(authority, tree.state_adapter)
    if tree.state_adapter == __TreeStateAdapter.Snapshot {
        tree.snapshot = if records.len() == 0 -> None else -> Val(records[0])
    } else if tree.state_adapter == __TreeStateAdapter.EventLog {
        tree.event_log = records
    }
    materialized := tree.workflows.copy() // copy: the comparison must not move the live cursors
    loop index in 0..<materialized.len() -> materialized[index].replay_cursor = 0
    durable := workflow_replay(tree)
    loop index in 0..<durable.len() -> durable[index].replay_cursor = 0
    if materialized.len() != 0 && materialized != durable -> return Err(state_error("in-memory workflow history does not match the durable workflow log"))
    tree.workflows = durable
}

// Publish one worker's route and, when it runs, bind its durable delivery.
start_activate: fn(tree: ServiceTree, index: Int, published: Bool, running: Bool) ServiceError! {
    endpoint: tree.workers[index].endpoint
    if authority_update(endpoint, published, Val(tree.workers[index].channel)) == {
        .Err(.Partitioned(_)) -> authority_register(endpoint, published, Val(tree.workers[index].channel))
        .Err(.Unavailable(_)) -> authority_register(endpoint, published, Val(tree.workers[index].channel))
        .Err(error) -> return Err(error)
        .Ok(_) -> {}
    }
    if running -> bind_delivery_endpoint(tree, endpoint)
}

// Start reopens every mailbox and publishes each worker route. Handlers run
// through endpoint receive; start invokes none.
start: fn(tree: &ServiceTree) ServiceError! {
    if tree.started -> return Err(ServiceError.Policy("service tree is already started"))
    lock: rollout_operation_lock(tree)
    restore_rollout_state(tree)
    if tree.name.trim() == "" || !valid_service_text(tree.name, 256) -> return Err(ServiceError.Policy("service tree metadata is invalid or exceeds its limit"))
    if tree.workers.len() == 0 -> return Err(ServiceError.Policy("service tree has no workers"))
    start_load_state(tree)
    preserve: tree.delivery == ServiceDelivery.DurableAtLeastOnce
    loop index in 0..<tree.workers.len() {
        messages: if preserve -> channel_snapshot(tree.workers[index].channel) else -> [String]{}
        if messages.len() > tree.workers[index].capacity -> return Err(ServiceError.Policy("mailbox messages exceed the bounded channel capacity"))
        tree.workers[index].channel = channel_new(tree.workers[index].capacity, messages) ?? return Err(ServiceError.Policy("mailbox channel could not restore its queued messages"))
    }
    activated := [Int]{}
    loop index in 0..<tree.workers.len() {
        draining: worker_contains(tree.draining, tree.workers[index].name)
        partitioned: worker_contains(tree.partitioned, tree.workers[index].name)
        running: !partitioned && (!draining || channel_depth(tree.workers[index].channel) > 0)
        tree.workers[index].running = running
        if start_activate(tree, index, !partitioned && (running || draining), running) == {
            .Err(error) -> {
                authority_update(tree.workers[index].endpoint, false, None).drop("the activation failure is the reported error")
                rollback := ServiceError?{None}
                loop done in activated {
                    if authority_update(tree.workers[done].endpoint, false, None) == {
                        .Err(failure) -> {
                            rollback = Val(failure)
                            break
                        }
                        .Ok(_) -> {}
                    }
                }
                loop worker in 0..<tree.workers.len() -> tree.workers[worker].running = false
                return Err(recovery_error(error, rollback, "service authority activation rollback"))
            }
            .Ok(_) -> {}
        }
        activated.push(index)
    }
    tree.started = true
    if rollout_store_write(tree) == {
        .Err(error) -> {
            tree.started = false
            loop index in 0..<tree.workers.len() {
                tree.workers[index].running = false
                authority_update(tree.workers[index].endpoint, false, None).drop("the journal failure is the reported error")
                authority_update_draining(tree.workers[index].endpoint, false).drop("the journal failure is the reported error")
            }
            return Err(error)
        }
        .Ok(_) -> {}
    }
}

// Stop retracts every route. Durable delivery keeps queued mail for the next
// start; an Empty state adapter forgets everything the run accumulated.
stop: fn(tree: &ServiceTree) ServiceError! {
    lock: rollout_operation_lock(tree)
    preserve: tree.delivery == ServiceDelivery.DurableAtLeastOnce
    reset: tree.state_adapter == __TreeStateAdapter.Empty
    first := ServiceError?{None}
    loop index in 0..<tree.workers.len() {
        tree.workers[index].running = false
        if reset {
            if authority_update_partitioned(tree.workers[index].endpoint, false) == {
                .Err(error) -> if first == None -> first = Val(error)
                .Ok(_) -> {}
            }
        }
        if authority_update(tree.workers[index].endpoint, false, None) == {
            .Err(error) -> if first == None -> first = Val(error)
            .Ok(_) -> {}
        }
        if authority_update_draining(tree.workers[index].endpoint, false) == {
            .Err(error) -> if first == None -> first = Val(error)
            .Ok(_) -> {}
        }
        if !preserve -> channel_clear(tree.workers[index].channel)
        channel_close(tree.workers[index].channel)
    }
    if reset {
        tree.snapshot = None
        tree.event_log.clear()
        tree.dead_letters.clear()
        tree.idempotency.clear()
        tree.directory.clear()
        tree.draining.clear()
        tree.partitioned.clear()
        tree.workflows.clear()
    }
    tree.started = false
    failure: first ?? return Ok()
    Err(failure)
}

directory_register: fn(tree: &ServiceTree, name: String, endpoint: ServiceEndpoint) ServiceError! {
    if !tree.started -> return Err(ServiceError.NotStarted("service tree is not started"))
    lock: rollout_operation_lock(tree)
    if name.trim() == "" || !valid_service_text(name, 256) -> return Err(ServiceError.Policy("directory name must be non-empty and visible"))
    if endpoint.generation != tree.generation -> return Err(ServiceError.Policy("endpoint generation {endpoint.generation} does not match tree generation {tree.generation}"))
    validate_tree_endpoint(tree, endpoint)
    index: worker_exact(tree, endpoint) ?? return Err(ServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not a worker in this generation"))
    if !tree.workers[index].running -> return Err(ServiceError.NotStarted("worker `{tree.workers[index].name}` is not running"))
    existing := Int?{None}
    loop entry in 0..<tree.directory.len() {
        if tree.directory[entry].name == name -> existing = Val(entry)
    }
    if tree.directory.len() >= 4096 && existing == None -> return Err(ServiceError.Policy("service directory entry limit exceeded"))
    proof: directory_sign(tree.authority, tree.name, name, endpoint)
    previous := __DirectoryRecord?{None}
    if existing == .Val(at) -> previous = tree.directory.remove(at, .Slot)
    tree.directory.push(__DirectoryRecord{name: name, endpoint: endpoint, proof: proof})
    if rollout_store_write(tree) == {
        .Err(error) -> {
            _: tree.directory.pop()
            if previous == .Val(record) -> tree.directory.push(record)
            return Err(error)
        }
        .Ok(_) -> {}
    }
}

// Reopen the route of a drained worker whose drain could not be journaled.
drain_reopen: fn(endpoint: ServiceEndpoint) ServiceError! {
    authority_update(endpoint, true, None)
    authority_update_draining(endpoint, false)
}

drain_worker: fn(tree: &ServiceTree, endpoint: ServiceEndpoint) ServiceError! {
    if !tree.started -> return Err(ServiceError.NotStarted("service tree is not started"))
    lock: rollout_operation_lock(tree)
    named: find_worker(tree, endpoint)
    if worker_contains(tree.draining, tree.workers[named].name) -> return authority_update_draining(endpoint, true)
    // The route gate closes before the queue is inspected: endpoint sends use
    // the same gate, so none can enqueue after drain observes an empty mailbox.
    authority_update_draining(endpoint, true)
    index: find_worker(tree, endpoint)
    empty: channel_depth(tree.workers[index].channel) == 0
    if empty -> tree.workers[index].running = false
    tree.draining.push(tree.workers[index].name)
    if rollout_store_write(tree) == {
        .Err(error) -> {
            names_remove(tree.draining, endpoint.worker)
            recovery := ServiceError?{None}
            if empty {
                if drain_reopen(tree.workers[index].endpoint) == {
                    .Err(failure) -> recovery = Val(failure)
                    .Ok(_) -> {}
                }
                tree.workers[index].running = recovery == None
            } else {
                if authority_update_draining(tree.workers[index].endpoint, false) == {
                    .Err(failure) -> recovery = Val(failure)
                    .Ok(_) -> {}
                }
            }
            return Err(recovery_error(error, recovery, "drain journal recovery"))
        }
        .Ok(_) -> {}
    }
}

// Reopen the route of a partitioned worker whose partition could not be journaled.
partition_reopen: fn(endpoint: ServiceEndpoint, was_running: Bool) ServiceError! {
    authority_update_partitioned(endpoint, false)
    if was_running -> authority_update(endpoint, true, None)
}

partition_worker: fn(tree: &ServiceTree, endpoint: ServiceEndpoint) ServiceError! {
    if !tree.started -> return Err(ServiceError.NotStarted("service tree is not started"))
    lock: rollout_operation_lock(tree)
    index: find_worker(tree, endpoint)
    was_running: tree.workers[index].running
    tree.workers[index].running = false
    added := false
    if !worker_contains(tree.partitioned, endpoint.worker) {
        if tree.partitioned.len() >= 4096 {
            tree.workers[index].running = was_running
            return Err(ServiceError.Policy("service partition limit exceeded"))
        }
        tree.partitioned.push(tree.workers[index].name)
        added = true
    }
    if authority_update_partitioned(tree.workers[index].endpoint, true) == {
        .Err(error) -> {
            if added -> names_remove(tree.partitioned, endpoint.worker)
            tree.workers[index].running = was_running
            return Err(error)
        }
        .Ok(_) -> {}
    }
    if rollout_store_write(tree) == {
        .Err(error) -> {
            names_remove(tree.partitioned, endpoint.worker)
            recovery := ServiceError?{None}
            if partition_reopen(tree.workers[index].endpoint, was_running) == {
                .Err(failure) -> recovery = Val(failure)
                .Ok(_) -> {}
            }
            tree.workers[index].running = was_running && recovery == None
            return Err(recovery_error(error, recovery, "partition journal recovery"))
        }
        .Ok(_) -> {}
    }
}

// Rejoin a reconciled worker: an old-generation shard is promoted, a current
// one simply reopens its route.
reconcile_rejoin: fn(tree: &ServiceTree, endpoint: ServiceEndpoint, generation: Int) ServiceError! {
    if generation != tree.generation {
        if !promote_worker_generation(tree, endpoint.worker) -> return Err(ServiceError.Unavailable("partitioned worker has uncommitted durable delivery"))
        return Ok()
    }
    authority_update_partitioned(endpoint, false)
    authority_update(endpoint, true, None)
}

reconcile_worker: fn(tree: &ServiceTree, endpoint: ServiceEndpoint) ServiceError! {
    if !tree.started -> return Err(ServiceError.NotStarted("service tree is not started"))
    lock: rollout_operation_lock(tree)
    if validate_tree_endpoint(tree, endpoint) == {
        .Err(.Partitioned(_)) -> {}
        .Err(error) -> return Err(error)
        .Ok(_) -> {}
    }
    position: worker_index(tree.partitioned, endpoint.worker) ?? return Err(ServiceError.Unknown("worker `{endpoint.worker}` is not partitioned"))
    index: worker_slot(tree, endpoint) ?? return Err(ServiceError.Unknown("reconciled worker disappeared"))
    generation: tree.workers[index].endpoint.generation
    tree.workers[index].running = true
    saved := tree.partitioned.copy() // copy: restored verbatim when the rejoin fails
    _: tree.partitioned.remove(position, .Slot)
    if reconcile_rejoin(tree, endpoint, generation) == {
        .Err(error) -> {
            authority_update_partitioned(endpoint, true).drop("the rejoin failure is the reported error")
            tree.partitioned = saved
            tree.workers[index].running = false
            return Err(error)
        }
        .Ok(_) -> {}
    }
    rollout_store_write(tree)
}

// The pre-handoff state copy a reversible migration can roll back to.
__RollbackPlan: struct {
    store: String
    available: Bool
    migration: String
}

prepare_rollback: fn(tree: ServiceTree) -> __RollbackPlan ServiceError! {
    authority: tree.state_authority ?? return Ok(__RollbackPlan{store: "", available: false, migration: "none"})
    if authority.migration == "forward_only" -> return Ok(__RollbackPlan{store: "", available: false, migration: authority.migration})
    store: rollback_store_path(authority, tree.generation)
    records: state_load(authority, tree.state_adapter)
    state_write(state_authority_at(authority, store), tree.state_adapter, records)
    Ok(__RollbackPlan{store: store, available: true, migration: authority.migration})
}

discard_rollback_store: fn(path: String) -> ServiceError? Never! {
    if path == "" -> return None
    if service_remove(path) == {
        .Err(.NotFound(_)) -> None
        .Err(error) -> Val(state_error("cannot retire failed service rollback store: {error}"))
        .Ok(_) -> None
    }
}

rollout_failure: fn(primary: &&ServiceError, authority: ServiceError?, cleanup: ServiceError?) -> ServiceError Never! {
    failures := [String]{}
    if authority == .Val(error) -> failures.push("authority rollback failed: {service_error_show(error)}")
    if cleanup == .Val(error) -> failures.push("rollback store cleanup failed: {service_error_show(error)}")
    if failures.len() == 0 -> return primary
    joined: failures.join("; ")
    ServiceError.Policy("{service_error_show(primary)}; {joined}")
}

// Re-register a worker's pre-rollout route after a failed rollout.
restore_route: fn(tree: ServiceTree, index: Int, running: Bool) ServiceError! {
    endpoint: tree.workers[index].endpoint
    authority_register(endpoint, running, Val(tree.workers[index].channel))
    authority_update_draining(endpoint, worker_contains(tree.draining, endpoint.worker))
    if running -> bind_delivery_endpoint(tree, endpoint)
}

restore_handoff_authority: fn(tree: ServiceTree, next_endpoints: [ServiceEndpoint], running: [Bool], pinned: [String]) -> ServiceError? Never! {
    first := ServiceError?{None}
    loop index in 0..<tree.workers.len() {
        if worker_contains(pinned, tree.workers[index].name) -> next
        authority_update(next_endpoints[index], false, None).drop("the restored old route supersedes the new one")
        if restore_route(tree, index, running[index]) == {
            .Err(error) -> if first == None -> first = Val(error)
            .Ok(_) -> {}
        }
    }
    first
}

handoff_rotate: fn(tree: ServiceTree, index: Int, next: ServiceEndpoint, running: Bool) ServiceError! {
    authority_rotate(tree.workers[index].endpoint, next, running, false, Val(tree.workers[index].channel))
    if running -> bind_delivery_endpoint(tree, next)
}

// Move every unpinned worker to the next generation. Partitioned shards,
// draining shards with queued mail and shards with live durable receipts stay
// pinned to the old generation until they drain or reconcile.
handoff_generation: fn(tree: &ServiceTree) -> Int ServiceError! {
    if !tree.started -> return Err(ServiceError.NotStarted("service tree is not started"))
    lock: rollout_operation_lock(tree)
    rollout_store_assert_current(tree)
    candidates: if tree.last_upgrade == {
        .Val(receipt) -> receipt.pinned_shards.copy() // copy: promotion edits the list being walked
        .None -> tree.draining.copy() // copy: as above
    }
    loop name in candidates {
        index: worker_named(tree, name) ?? next
        if !worker_contains(tree.partitioned, name) && channel_depth(tree.workers[index].channel) == 0 && generation_is_pinned(tree, name, tree.workers[index].endpoint.generation) {
            _: promote_worker_generation(tree, name)
        }
    }
    blocked := false
    if tree.last_upgrade == {
        .Val(receipt) -> blocked = receipt.pinned_shards.len() != 0
        .None -> {}
    }
    if blocked -> return Err(ServiceError.Policy("cannot start another handoff while pinned shards are draining"))
    from: tree.generation
    if from == 9223372036854775807 -> return Err(ServiceError.Policy("service generation exhausted"))
    to: from + 1
    pinned := [String]{}
    loop worker in tree.workers {
        uncommitted: authority_has_uncommitted(worker.endpoint)
        if worker_contains(tree.partitioned, worker.name) || (worker_contains(tree.draining, worker.name) && channel_depth(worker.channel) > 0) || uncommitted -> pinned.push(worker.name)
    }
    rollback: prepare_rollback(tree)
    running := [Bool]{}
    next_running := [Bool]{}
    next_endpoints := [ServiceEndpoint]{}
    loop worker in tree.workers {
        held: worker_contains(pinned, worker.name)
        running.push(worker.running)
        next_running.push(worker.running || (!held && worker_contains(tree.draining, worker.name)))
        next_endpoints.push(endpoint_new(worker.endpoint.tree, worker.endpoint.worker, if held -> worker.endpoint.generation else -> to, worker.endpoint.authority))
    }
    next_directory := tree.directory.copy() // copy: the live directory stays intact until every route rotates
    loop entry in 0..<next_directory.len() {
        if worker_contains(pinned, next_directory[entry].endpoint.worker) -> next
        next_directory[entry].endpoint.generation = to
        next_directory[entry].proof = directory_sign(tree.authority, tree.name, next_directory[entry].name, next_directory[entry].endpoint)
    }
    next_idempotency := tree.idempotency.copy() // copy: as above, for the idempotency records
    loop record in 0..<next_idempotency.len() {
        if !worker_contains(pinned, next_idempotency[record].endpoint.worker) -> next_idempotency[record].endpoint.generation = to
    }
    loop index in 0..<tree.workers.len() {
        if worker_contains(pinned, tree.workers[index].name) -> next
        if handoff_rotate(tree, index, next_endpoints[index], next_running[index]) == {
            .Err(error) -> return Err(rollout_failure(error, restore_handoff_authority(tree, next_endpoints, running, pinned), discard_rollback_store(rollback.store)))
            .Ok(_) -> {}
        }
    }
    tree.previous_generation = from
    tree.generation = to
    loop index in 0..<tree.workers.len() {
        if worker_contains(pinned, tree.workers[index].name) {
            if worker_contains(tree.partitioned, tree.workers[index].name) -> tree.workers[index].running = false
            next
        }
        tree.workers[index].running = next_running[index]
        tree.workers[index].endpoint = next_endpoints[index].copy() // copy: the list is dropped with this frame
    }
    tree.directory = next_directory
    tree.idempotency = next_idempotency
    at := tree.draining.len()
    loop at > 0 {
        at = at - 1
        if !worker_contains(pinned, tree.draining[at]) -> _: tree.draining.remove(at, .Slot)
    }
    tree.last_upgrade = Val(ServiceUpgradeReceipt{from_generation: from, to_generation: to, migration: rollback.migration, rollback_store: rollback.store, rollback_available: rollback.available, pinned_shards: pinned})
    rollout_store_write(tree)
    Ok(tree.generation)
}

restore_rollback_authority: fn(tree: ServiceTree, rollback_endpoints: [ServiceEndpoint], running: [Bool]) -> ServiceError? Never! {
    loop endpoint in rollback_endpoints -> authority_update(endpoint, false, None).drop("the restored current route supersedes the rollback one")
    first := ServiceError?{None}
    loop index in 0..<tree.workers.len() {
        if restore_route(tree, index, running[index]) == {
            .Err(error) -> if first == None -> first = Val(error)
            .Ok(_) -> {}
        }
    }
    first
}

rollback_rotate: fn(tree: ServiceTree, index: Int, endpoint: ServiceEndpoint, running: Bool) ServiceError! {
    if tree.workers[index].endpoint.generation != endpoint.generation {
        authority_rotate(tree.workers[index].endpoint, endpoint, running, worker_contains(tree.draining, endpoint.worker), Val(tree.workers[index].channel))
    }
    if running -> bind_delivery_endpoint(tree, endpoint)
}

// Put the pre-handoff state copy back in the live store and retire it.
restore_rollback: fn(tree: &ServiceTree, from: Int, plan: __RollbackPlan) ServiceError! {
    if !plan.available -> return Ok()
    authority: tree.state_authority ?? return Err(ServiceError.Policy("upgrade receipt requires a state authority"))
    if plan.store != rollback_store_path(authority, from) -> return Err(state_error("rollout receipt names a rollback store outside its state authority"))
    lock: authority_file_lock(plan.store, "rollback")
    if !service_is_file(plan.store) -> return Err(state_error("service rollback store is missing or not a regular file"))
    records: state_load(state_authority_at(authority, plan.store), tree.state_adapter)
    state_write(authority, tree.state_adapter, records)
    if tree.state_adapter == __TreeStateAdapter.Snapshot {
        tree.snapshot = if records.len() == 0 -> None else -> Val(records[0])
    } else if tree.state_adapter == __TreeStateAdapter.EventLog {
        tree.event_log = records
    }
    if service_remove(plan.store) == {
        .Err(error) -> return Err(state_error("cannot retire service rollback store: {error}"))
        .Ok(_) -> {}
    }
}

// Return every worker to the handoff's source generation and restore the
// state copy a reversible migration kept.
rollback_generation: fn(tree: &ServiceTree) -> Int ServiceError! {
    if !tree.started -> return Err(ServiceError.NotStarted("service tree is not started"))
    lock: rollout_operation_lock(tree)
    rollout_store_assert_current(tree)
    if tree.previous_generation <= 0 -> return Err(ServiceError.Policy("no previous generation to roll back to"))
    receipt: tree.last_upgrade ?? return Err(ServiceError.Policy("service tree has no rollback receipt"))
    if receipt.to_generation != tree.generation || receipt.from_generation != tree.previous_generation -> return Err(ServiceError.Stale("service rollback receipt does not match the active generation"))
    if receipt.migration == "forward_only" -> return Err(ServiceError.Policy("forward-only state migration cannot roll back; publish a forward recovery generation"))
    from: receipt.from_generation
    plan: __RollbackPlan{store: receipt.rollback_store.copy(), available: receipt.rollback_available, migration: receipt.migration.copy()} // copy: the receipt is cleared below
    rollback_endpoints := [ServiceEndpoint]{}
    running := [Bool]{}
    loop worker in tree.workers {
        rollback_endpoints.push(endpoint_new(worker.endpoint.tree, worker.endpoint.worker, from, worker.endpoint.authority))
        running.push(worker.running)
    }
    loop index in 0..<tree.workers.len() {
        if rollback_rotate(tree, index, rollback_endpoints[index], running[index]) == {
            .Err(error) -> return Err(rollout_failure(error, restore_rollback_authority(tree, rollback_endpoints, running), None))
            .Ok(_) -> {}
        }
    }
    if restore_rollback(tree, from, plan) == {
        .Err(error) -> return Err(rollout_failure(error, restore_rollback_authority(tree, rollback_endpoints, running), None))
        .Ok(_) -> {}
    }
    tree.generation = from
    tree.previous_generation = 0
    loop index in 0..<tree.workers.len() -> tree.workers[index].endpoint.generation = from
    loop entry in 0..<tree.directory.len() {
        tree.directory[entry].endpoint.generation = from
        tree.directory[entry].proof = directory_sign(tree.authority, tree.name, tree.directory[entry].name, tree.directory[entry].endpoint)
    }
    loop record in 0..<tree.idempotency.len() -> tree.idempotency[record].endpoint.generation = from
    tree.last_upgrade = None
    rollout_store_write(tree)
    Ok(tree.generation)
}

#Test("service worker restart scope preserves group declaration order and root membership") {
    names: [String]{"a", "b", "c", "d"}
    groups: [[String]]{[String]{"c", "a", "missing"}}
    grouped: worker_scope(names, groups, "a")
    assert(grouped.supervisor == 0 && grouped.scope == [Int]{2, 0})
    root: worker_scope(names, groups, "b")
    assert(root.supervisor == 1 && root.scope == [Int]{1, 3})
    assert(worker_targets(ServiceRestart.OneForOne, grouped.scope, 0) == [Int]{0})
    assert(worker_targets(ServiceRestart.OneForAll, grouped.scope, 0) == [Int]{2, 0})
    assert(worker_targets(ServiceRestart.RestForOne, grouped.scope, 0) == [Int]{0})
    assert(worker_targets(ServiceRestart.RestForOne, grouped.scope, 99) == [Int]{2, 0})
}

#Test("service worker restart budget excludes the exact boundary and saturates i64 subtraction") {
    assert(worker_window_start(-9223372036854775808, 1) == -9223372036854775808)
    assert(worker_window_start(9223372036854775807, -1) == 9223372036854775807)
    instants: [Int]{0, 1, 10}
    assert(worker_spent(instants, 10, 10) == 2)
    assert(worker_pruned(instants, 10, 10) == [Int]{1, 10, 10})
    assert(worker_pruned([Int]{}, -9223372036854775808, 1).len() == 0)
}
