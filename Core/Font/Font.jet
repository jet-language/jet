package {
    name: "core.font"
    version: "0.0.1"
    edition: "2026"
    description: "Font faces and glyph shaping."
    license: "MIT"
    outputs: {
        font: .Library{ entry: font }
    }
    authority: { needs: [UI.FontShaping] }
}
use core as core

// core.font — one face/run model across native and headless tiers.
//
// `shape` is the provider seam: the host owns real shaping and returns a
// canonical run.  `shape_with` is the explicit portable fallback for callers
// that need deterministic, approximate advances without a shaping provider.
enum FontStyle {
    Body
    Title
    Monospace
}

enum GlyphShaper {
    HarfBuzz
    HeadlessFallback
}

struct FontFace {
    family: String
    size: Float
    style: FontStyle
}

struct Glyph {
    id: Int
    cluster: Int
    x: Float
    y: Float
    advance_x: Float
    advance_y: Float
}

struct GlyphRun {
    glyphs: [Glyph]
    advance_x: Float
    advance_y: Float
    shaper: GlyphShaper
    deterministic: Bool
    approximate: Bool
}

fn system(style: FontStyle) -> FontFace Never! {
    if style == FontStyle.Monospace -> return FontFace{family: "monospace", size: 14.0, style: style}
    if style == FontStyle.Title -> return FontFace{family: "system-ui", size: 24.0, style: style}
    FontFace{family: "system-ui", size: 14.0, style: style}
}

fn shape_with(face: FontFace, text: String) -> GlyphRun Never! {
    // This is the explicit opt-in for deterministic approximate metrics.
    // `shape` is the only path that requests the FontShaping capability.
    shape_fallback(face, text)
}

fn shape(text: String, face: FontFace) -> GlyphRun Never! {
    if core.font.__shape_text(text, face) == {
        .Ok(run) -> run
        .Err(cause) -> panic("font shaping host contract failure: {cause}")
    }
}

fn shape_fallback(face: FontFace, text: String) -> GlyphRun {
    glyphs := [Glyph]{}
    advance := Float{0.0}
    raw :: text.bytes()
    i := 0
    loop i < raw.len() {
        pair :: decode_cp(raw, i)
        width :: glyph_advance(face, pair.cp)
        &glyphs.push(Glyph{
            id: pair.cp,
            cluster: i,
            x: advance,
            y: 0.0,
            advance_x: width,
            advance_y: 0.0,
        })
        advance += width
        i = pair.next
    }
    GlyphRun{
        glyphs: glyphs,
        advance_x: advance,
        advance_y: 0.0,
        shaper: GlyphShaper.HeadlessFallback,
        deterministic: true,
        approximate: true,
    }
}

fn glyph_advance(face: FontFace, cp: Int) -> Float {
    if cp == 10 -> return 0.0
    if cp < 128 -> return face.size * 0.6
    face.size
}

struct DecodePair {
    cp: Int
    next: Int
}

fn decode_cp(raw: [U8], i: Int) -> DecodePair {
    if i >= raw.len() -> return DecodePair{cp: 0, next: i}
    first :: Int.from_u8(raw[i])
    if first < 128 -> return DecodePair{cp: first, next: i + 1}

    width := 0
    cp := 0
    if first >= 194 && first <= 223 {
        width = 2
        cp = (first).bit_and(31)
    }
    if first >= 224 && first <= 239 {
        width = 3
        cp = (first).bit_and(15)
    }
    if first >= 240 && first <= 244 {
        width = 4
        cp = (first).bit_and(7)
    }
    if width == 0 || i + width > raw.len() -> return DecodePair{cp: 65533, next: i + 1}

    second :: Int.from_u8(raw[i + 1])
    // Reject overlong encodings and UTF-16 surrogate prefixes before the
    // continuation loop so malformed bytes consume one byte at a time.
    if (first == 224 && second < 160) || (first == 237 && second >= 160) {
        return DecodePair{cp: 65533, next: i + 1}
    }
    if (first == 240 && second < 144) || (first == 244 && second >= 144) {
        return DecodePair{cp: 65533, next: i + 1}
    }

    k := 1
    loop k < width {
        byte :: Int.from_u8(raw[i + k])
        if byte < 128 || byte >= 192 -> return DecodePair{cp: 65533, next: i + 1}
        cp = ((cp << 6)).bit_or(((byte).bit_and(63)))
        k += 1
    }
    if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
        return DecodePair{cp: 65533, next: i + 1}
    }
    DecodePair{cp: cp, next: i + width}
}


#Test("system font styles have canonical family and size defaults") {
    body :: system(.Body)
    title :: system(.Title)
    mono :: system(.Monospace)
    assert_eq(body.family, "system-ui")
    assert_eq(body.size, 14.0)
    assert_eq(title.family, "system-ui")
    assert_eq(title.size, 24.0)
    assert_eq(mono.family, "monospace")
    assert_eq(mono.size, 14.0)
}
