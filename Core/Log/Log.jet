package: {
    name: "core.log"
    version: "0.0.1"
    edition: "2026"
    description: "Structured logs, spans, and sinks."
    license: "MIT"
    outputs: {
        log: .Library{ entry: log }
    }
}
use {
    core: core
    rt: jet.runtime.log
    internal.[code_level, covering_rank, emit, enabled_for, level_name, level_rank, module_path_valid, parse_filter, render_filter]
}

// core.log — one structured logger for the process.
//
// Levels are the typed `LogLevel`, `.Debug` through `.Fatal`. Fields are
// typed (`field` / `int` / `float` / `bool`); `redact` marks a key so sinks
// must not print its value. Spans are `span` + `enter` / `close`. Every
// record's first field is `module`: the dotted module of the call
// (SourceLocation.module). This is not a tracing SDK; OTLP file export is
// the one optional bridge.
//
// The level a record must reach comes from five sources, each later one
// above the earlier: the stock `info`, the package's `log:` field, the
// `set_level` calls of the code, the JET_LOG environment variable and the
// `--log` flag of `jet run` and `jet dev`. Each source is a filter of
// comma-separated `level` and `module=level` pairs. A pair covers its module
// and every module under it, a bare level covers every module, and for a
// record the longest module path any source names decides; a later source
// replaces an earlier source's pair for the same path. The compiler checks
// the package field and the flag, and the runtime checks JET_LOG at startup.
//
// Filtering, sampling, JSON line layout, and redaction are Jet. The sink
// write and the process-global level, filter and trace cells are host.
LogField: struct {
    key: String
    value: String
    kind: String
    redacted: Bool
}

// Readable but not constructible outside this module.
LogSpan: struct {
    id: Int
    name: String

    id: fn(self) -> Int Never! { self.id }
    name: fn(self) -> String Never! { self.name }
}

/// A record's severity, least to most severe.
LogLevel: enum {
    Debug
    Info
    Warn
    Error
    Critical
    Fatal
}

debug: fn(message: String, at: SourceLocation{#caller}) Never! -[Log]> { emit(.Debug, message, [LogField]{}, at.module) }

info: fn(message: String, at: SourceLocation{#caller}) Never! -[Log]> { emit(.Info, message, [LogField]{}, at.module) }

warn: fn(message: String, at: SourceLocation{#caller}) Never! -[Log]> { emit(.Warn, message, [LogField]{}, at.module) }

error: fn(message: String, at: SourceLocation{#caller}) Never! -[Log]> { emit(.Error, message, [LogField]{}, at.module) }

/// Emit a message at a caller-selected level.
log: fn(level: LogLevel, message: String, at: SourceLocation{#caller}) Never! -[Log]> { emit(level, message, [LogField]{}, at.module) }

critical: fn(message: String, at: SourceLocation{#caller}) Never! -[Log]> { emit(.Critical, message, [LogField]{}, at.module) }

fatal: fn(message: String, at: SourceLocation{#caller}) Never! -[Log]> { emit(.Fatal, message, [LogField]{}, at.module) }

debug_fields: fn(message: String, fields: [LogField], at: SourceLocation{#caller}) Never! -[Log]> { emit(.Debug, message, fields, at.module) }

info_fields: fn(message: String, fields: [LogField], at: SourceLocation{#caller}) Never! -[Log]> { emit(.Info, message, fields, at.module) }

warn_fields: fn(message: String, fields: [LogField], at: SourceLocation{#caller}) Never! -[Log]> { emit(.Warn, message, fields, at.module) }

error_fields: fn(message: String, fields: [LogField], at: SourceLocation{#caller}) Never! -[Log]> { emit(.Error, message, fields, at.module) }

field: fn(key: String, value: String) -> LogField Never! {
    LogField{key: key, value: value, kind: "string", redacted: false}
}

int: fn(key: String, value: Int) -> LogField Never! {
    LogField{key: key, value: "{value}", kind: "int", redacted: false}
}

float: fn(key: String, value: Float) -> LogField Never! {
    LogField{key: key, value: "{value}", kind: "float", redacted: false}
}

bool: fn(key: String, value: Bool) -> LogField Never! {
    LogField{key: key, value: "{value}", kind: "bool", redacted: false}
}

redact: fn(key: String) -> LogField Never! {
    LogField{key: key, value: "[redacted]", kind: "redacted", redacted: true}
}

span: fn(name: String) -[Log]> LogSpan Never! {
    allocated: rt.span_allocate(name)
    LogSpan{id: allocated.id, name: allocated.name}
}

enter: fn(span: LogSpan) Never! -[Log]> { rt.span_enter(span) }

close: fn(span: LogSpan) Never! -[Log]> { rt.span_close(span) }

/// Select the record sink. `stderr` (JSON lines on stderr) and the `json`,
/// `jsonl` and `text` file sinks are supported. An unsupported kind, or a
/// file sink without a path, leaves the sink unchanged and logs an error
/// record that names the rejected setting instead of returning silently.
set_sink: fn(kind: String, path: String) Never! -[Log]> {
    normalized: ascii_lower(trim(kind))
    if normalized == "stderr" {
        rt.format_store(1)
        return rt.sink_store("")
    }
    if normalized != "json" && normalized != "jsonl" && normalized != "text" {
        return reject_setting("log.set_sink: unsupported sink kind `{kind}`; the sink is unchanged (supported: stderr, json, jsonl, text)")
    }
    if (normalized == "jsonl" || normalized == "text") && trim(path).len() == 0 {
        return reject_setting("log.set_sink: the `{normalized}` sink needs a file path; the sink is unchanged")
    }
    rt.format_store(if normalized == "text" -> 2 else -> 1)
    rt.sink_store(path)
}

sample_every: fn(n: Int) Never! -[Log]> {
    if n > 0 {
        rt.sample_store(n)
        rt.sample_count_store(0)
    }
}

counter: fn(name: String, value: Int) -> LogField Never! {
    rt.metric_publish(name, value)
    LogField{key: "metric.counter.{name}", value: "{value}", kind: "counter", redacted: false}
}

otlp_file: fn(path: String) Never! -[Log, FS]> {
    if trim(path).len() > 0 -> set_sink("jsonl", path)
}

/// Set the level of the module at `path` (`shop.db`) and every module under
/// it; "" is every module. The code's levels rank above the package's `log:`
/// field and below JET_LOG and `--log`: when either names the same path, its
/// level stays, and this call logs one `warn` note that says so.
set_level: fn(level: LogLevel, path: String{""}, at: SourceLocation{#caller}) Never! -[Log]> {
    code_level(level_rank(level), path, at)
}

set_trace_id: fn(id: String) Never! -[Log]> {
    if trim(id).len() > 0 -> rt.trace_store(id)
}

/// Apply comma-separated settings without handing the whole grammar to the
/// host. Each setting is `key=value` (`format`, `sink`, `file` or `path`,
/// `sample` or `sample_every`, `trace_id`); a bare `auto`, `json` or `text`
/// selects the record format. Levels are set by `set_level` alone. An unknown
/// setting or value is reported as an error record and otherwise ignored. The
/// host owns the sink and process-global cells; Jet owns normalization and
/// dispatch.
setup: fn(spec: String) Never! -[Log]> {
    loop raw in split_csv(spec) {
        if trim(raw).len() == 0 -> next
        pair: split_once(raw, "=")
        key: ascii_lower(trim(pair.left))
        value: trim(pair.right)
        if {
            value.len() == 0 && is_format(key) -> rt.format_store(format_code(key))
            key == "format" && is_format(ascii_lower(value)) -> rt.format_store(format_code(ascii_lower(value)))
            key == "sink" -> {
                sink: ascii_lower(value)
                if sink == "stderr" || sink == "stdout" -> set_sink(sink, "") else -> set_sink("jsonl", value)
            }
            (key == "file" || key == "path") && value.len() > 0 -> set_sink("jsonl", value)
            (key == "sample" || key == "sample_every") && (parse_int(value) ?? 0) > 0 -> sample_every(parse_int(value) ?? 0)
            key == "trace_id" && value.len() > 0 -> set_trace_id(value)
            else -> reject_setting("log.setup: unsupported setting `{trim(raw)}`; it was ignored")
        }
    }
}

is_format: fn(name: String) -> Bool {
    name == "auto" || name == "json" || name == "text"
}

format_code: fn(name: String) -> Int Never! {
    if name == "json" -> return 1
    if name == "text" -> return 2
    0
}

reject_setting: fn(message: String) -[Log]> {
    rt.record_emit("error", message, [LogField]{})
}

disable: fn() Never! -[Log]> { rt.disabled_store(true) }

flush: fn() Never! -[Log]> { rt.flush() }

/// Whether a record at `level` from the calling module would be written.
enabled: fn(level: LogLevel, at: SourceLocation{#caller}) -[Log]> Bool Never! {
    enabled_for(level_rank(level), at.module)
}

normalize_fields: fn(fields: [LogField]) -> [LogField] {
    needs_normalization := false
    loop i in 0..<fields.len() {
        if fields[i].redacted || (fields[i].kind != "string" && fields[i].kind != "int" && fields[i].kind != "float" && fields[i].kind != "bool" && fields[i].kind != "counter") {
            needs_normalization = true
            break
        }
    }
    if !needs_normalization -> return fields.copy()
    out := [LogField]{}
    loop field in fields {
        if field.redacted {
            out.push(LogField{key: field.key, value: "[redacted]", kind: "redacted", redacted: true})
        } else if field.kind != "string" && field.kind != "int" && field.kind != "float" && field.kind != "bool" && field.kind != "counter" {
            out.push(LogField{key: field.key, value: field.value, kind: "string", redacted: false})
        } else {
            out.push(field.copy())
        }
    }
    out
}

// One pair of a level filter: `path` "" is every module.
FilterPair: struct {
    path: String
    rank: Int
}

// The level cell caches the resolution: 0 is unresolved, 1-6 is the one
// level every module has, and FILTER_PER_MODULE means a source names a module.
FILTER_PER_MODULE: 7

// The sources below the code's levels and above them (`rt.config_load`).
CONFIG_PACKAGE: 0
CONFIG_ENV: 1
CONFIG_FLAG: 2

// Level resolution, the filter text and the record leaf: not part of the
// log surface.
priv internal: module {
    enabled_for: fn(rank: Int, path: String) -[Log]> Bool Never! {
        if rt.disabled_load() -> return false
        rank >= threshold(path)
    }

    emit: fn(level: LogLevel, message: String, fields: [LogField], path: String) -[Log]> {
        // `fatal` always ends the process with exit 1 (ledger #1474); the host
        // applies the level filter to the record and still exits, so a disabled
        // or filtered logger must not skip the call.
        if level != .Fatal && !enabled_for(level_rank(level), path) -> return
        tagged := [LogField]{LogField{key: "module", value: path, kind: "string", redacted: false}}
        loop item in normalize_fields(fields) -> tagged.push(item)
        // The runtime keeps sink selection, sampling, timestamps and
        // telemetry fan-out.
        rt.record_emit(level_name(level), message, tagged)
        if level == .Fatal {
            flush()
            rt.process_exit(1)
        }
    }

    level_rank: fn(level: LogLevel) -> Int Never! {
        if level == {
            .Debug -> 1
            .Info -> 2
            .Warn -> 3
            .Error -> 4
            .Critical -> 5
            .Fatal -> 6
        }
    }

    level_name: fn(level: LogLevel) -> String Never! { rank_name(level_rank(level)) }

    // The filter spelling of a rank (1 is `debug` … 6 is `fatal`).
    rank_name: fn(rank: Int) -> String Never! {
        if rank == {
            1 -> "debug"
            2 -> "info"
            3 -> "warn"
            4 -> "error"
            5 -> "critical"
            else -> "fatal"
        }
    }

    // The rank of a level's filter spelling, or 0 for any other text.
    name_rank: fn(name: String) -> Int Never! {
        if name == {
            "debug" -> 1
            "info" -> 2
            "warn" -> 3
            "error" -> 4
            "critical" -> 5
            "fatal" -> 6
            else -> 0
        }
    }

    // The rank a record of module `path` must reach.
    threshold: fn(path: String) -[Log]> Int Never! {
        cached: rt.level_load()
        if cached > 0 && cached < FILTER_PER_MODULE -> return cached
        pairs: merged_filter()
        if cached == 0 {
            if pairs.len() == 1 {
                rt.level_store(pairs[0].rank)
                return pairs[0].rank
            }
            rt.level_store(FILTER_PER_MODULE)
        }
        covering_rank(pairs, path)
    }

    // Every source's pairs, the stock `info` first; a later source's pair
    // replaces an earlier pair for the same path.
    merged_filter: fn() -[Log]> [FilterPair] Never! {
        pairs := [FilterPair]{FilterPair{path: "", rank: 2}}
        texts: [String]{rt.config_load(CONFIG_PACKAGE), rt.filter_load(), rt.config_load(CONFIG_ENV), rt.config_load(CONFIG_FLAG)}
        loop text in texts {
            loop pair in parse_filter(text) -> put_pair(pairs, pair.path, pair.rank)
        }
        pairs
    }

    // The rank of the longest pair path that covers `path`: the path itself or
    // a dotted prefix of it, and "" covers every path.
    covering_rank: fn(pairs: [FilterPair], path: String) -> Int Never! {
        best := -1
        rank := 2
        loop pair in pairs {
            if pair.path.len() > best && path_covers(pair.path, path) {
                best = pair.path.len()
                rank = pair.rank
            }
        }
        rank
    }

    path_covers: fn(prefix: String, path: String) -> Bool Never! {
        if prefix == "" || prefix == path -> return true
        path.starts_with("{prefix}.")
    }

    // The rank `pairs` give exactly `path`, or 0.
    pair_rank: fn(pairs: [FilterPair], path: String) -> Int Never! {
        loop pair in pairs {
            if pair.path == path -> return pair.rank
        }
        0
    }

    put_pair: fn(pairs: &[FilterPair], path: String, rank: Int) {
        loop i in 0..<pairs.len() {
            if pairs[i].path == path {
                pairs[i] = FilterPair{path: path, rank: rank}
                return
            }
        }
        pairs.push(FilterPair{path: path, rank: rank})
    }

    // The pairs of a filter text. The compiler and the runtime have already
    // checked each source; a pair that is not `level` or `module=level` is
    // skipped.
    parse_filter: fn(text: String) -> [FilterPair] Never! {
        pairs := [FilterPair]{}
        if text == "" -> return pairs
        loop raw in split_csv(text) {
            item: trim(raw)
            if item.len() == 0 -> next
            pair: split_once(item, "=")
            if trim(pair.right) == "" {
                rank: name_rank(item)
                if rank > 0 -> put_pair(pairs, "", rank)
            } else {
                path: trim(pair.left)
                rank: name_rank(trim(pair.right))
                if rank > 0 && module_path_valid(path) -> put_pair(pairs, path, rank)
            }
        }
        pairs
    }

    render_filter: fn(pairs: [FilterPair]) -> String Never! {
        text := ""
        loop pair in pairs {
            item: if pair.path == "" -> rank_name(pair.rank) else -> "{pair.path}={rank_name(pair.rank)}"
            text = if text == "" -> item else -> "{text},{item}"
        }
        text
    }

    // A dotted module path: identifier segments joined by `.`.
    module_path_valid: fn(path: String) -> Bool Never! {
        if path.len() == 0 -> return false
        start := true
        loop b in path.bytes() {
            n: Int.from_u8(b)
            if n == 46 {
                if start -> return false
                start = true
                next
            }
            letter: (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 95
            digit: n >= 48 && n <= 57
            if !letter && !(digit && !start) -> return false
            start = false
        }
        !start
    }

    // Record the code's level for `path` ("" is every module). When JET_LOG or
    // `--log` names the same path, the operator's level stays and one `warn`
    // note says so.
    code_level: fn(rank: Int, path: String, at: SourceLocation) -[Log]> {
        if path != "" && !module_path_valid(path) {
            return reject_setting("log.set_level: `{path}` is not a dotted module path; the level is unchanged")
        }
        pairs := parse_filter(rt.filter_load())
        put_pair(pairs, path, rank)
        rt.filter_store(render_filter(pairs))
        rt.level_store(0)
        operators: [Int]{CONFIG_FLAG, CONFIG_ENV}
        loop source in operators {
            kept: pair_rank(parse_filter(rt.config_load(source)), path)
            if kept > 0 {
                operator: if source == CONFIG_FLAG -> "--log" else -> "JET_LOG"
                target: if path == "" -> "every module" else -> "`{path}`"
                note: "log.set_level({rank_name(rank)}) at {at} for {target} is kept below {operator}, which sets {rank_name(kept)}"
                if !rt.disabled_load() -> rt.record_emit("warn", note, [LogField]{LogField{key: "module", value: at.module, kind: "string", redacted: false}})
                return
            }
        }
    }
}

canon_mode: fn(mode: String) -> String {
    normalized: ascii_lower(trim(mode))
    if normalized == "text" -> return "text"
    "json"
}

escape: fn(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n: Int.from_u8(b)
        if n == 92 {
            out.push(U8{92})
            out.push(U8{92})
            next
        }
        if n == 34 {
            out.push(U8{92})
            out.push(U8{34})
            next
        }
        if n == 8 || n == 9 || n == 10 || n == 12 || n == 13 {
            out.push(U8{92})
            if n == {
                8 -> out.push(U8{98})
                9 -> out.push(U8{116})
                10 -> out.push(U8{110})
                12 -> out.push(U8{102})
                13 -> out.push(U8{114})
                else -> { _ := 0 }
            }
            next
        }
        if n < 32 {
            out.push(U8{92})
            out.push(U8{117})
            out.push(U8{48})
            out.push(U8{48})
            out.push(hex_digit(n >> 4))
            out.push(hex_digit((n).bit_and(15)))
            next
        }
        out.push(b)
    }
    String.from_bytes(out) ?? text
}

hex_digit: fn(value: Int) -> U8 {
    n: (value).bit_and(15)
    if n < 10 -> return U8{48 + n}
    U8{87 + n}
}
trim: fn(text: String) -> String {
    raw: text.bytes()
    a := 0
    b := raw.len()
    loop {
        if a >= b -> return ""
        if !is_space(raw[a]) -> break
        a += 1
    }
    loop {
        if b <= a -> return ""
        if !is_space(raw[b - 1]) -> break
        b -= 1
    }
    out := [U8]{}
    i := a
    loop {
        if i >= b -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i += 1
    }
}

is_space: fn(b: U8) -> Bool {
    n: b
    n == 32 || n == 9 || n == 10 || n == 13
}

split_csv: fn(text: String) -> [String] {
    out := [String]{}
    cur := [U8]{}
    loop b in text.bytes() {
        if {
            b == (U8{44}) -> {
                out.push(String.from_bytes(cur) ?? "")
                cur = [U8]{}
            }
            else -> cur.push(b)
        }
    }
    out.push(String.from_bytes(cur) ?? "")
    out
}

/// A structured log event shared by formatters and handlers.
LogRecord: struct {
    level: LogLevel
    message: String
    fields: [LogField]
}

/// A deterministic formatter. `text` is human-readable; every other mode is
/// the canonical JSON line used by `emit`.
Formatter: struct {
    mode: String
}

/// A level-filtered sink. `handle` applies the threshold before formatting.
Handler: struct {
    minimum: LogLevel
    mode: String
}

record: fn(level: LogLevel, message: String, fields: [LogField]) -> LogRecord Never! {
    LogRecord{level: level, message: message, fields: fields}
}

formatter: fn(mode: String) -> Formatter Never! {
    Formatter{mode: canon_mode(mode)}
}

handler: fn(level: LogLevel) -> Handler Never! {
    Handler{minimum: level, mode: "json"}
}

handler_format: fn(target: Handler, mode: String) -> Handler Never! {
    Handler{minimum: target.minimum, mode: canon_mode(mode)}
}

format: fn(target: Formatter, event: LogRecord) -> String Never! {
    mode: canon_mode(target.mode)
    if mode == "text" -> return render_text(event)
    render_json(event)
}

handle: fn(target: Handler, event: LogRecord, at: SourceLocation{#caller}) Never! -[Log]> {
    if level_rank(event.level) < level_rank(target.minimum) -> return
    formatter: Formatter{mode: canon_mode(target.mode)}
    if formatter.mode == "text" {
        emit(event.level, format(formatter, event), [LogField]{}, at.module)
    } else {
        emit(event.level, event.message, event.fields, at.module)
    }
}


render_text: fn(event: LogRecord) -> String {
    line := "{level_name(event.level)}: {event.message}"
    loop field in event.fields {
        value := field.value
        if field.redacted -> value = "[redacted]"
        line = "{line} {field.key}={value}"
    }
    line
}

render_json: fn(event: LogRecord) -> String {
    line := "{{\"level\":\"{level_name(event.level)}\",\"msg\":\"{escape(event.message)}\""
    loop field in event.fields {
        if field.redacted {
            line = "{line},\"{escape(field.key)}\":\"[redacted]\""
        } else if field.kind == "int" || field.kind == "float" || field.kind == "bool" || field.kind == "counter" {
            line = "{line},\"{escape(field.key)}\":{field.value}"
        } else {
            line = "{line},\"{escape(field.key)}\":\"{escape(field.value)}\""
        }
    }
    line = "{line}}}"
    line
}

Pair: struct {
    left: String
    right: String
}

split_once: fn(text: String, sep: String) -> Pair {
    hay: text.bytes()
    nd: sep.bytes()
    if nd.len() == 0 || nd.len() > hay.len() -> return {left: text, right: ""}
    loop i in 0..<(hay.len() - nd.len() + 1) {
        if matches_at(hay, nd, i) {
            return {left: slice_ascii(hay, 0, i), right: slice_ascii(hay, i + nd.len(), hay.len())}
        }
    }
    {left: text, right: ""}
}

matches_at: fn(hay: [U8], needle: [U8], offset: Int) -> Bool {
    loop j in 0..<needle.len() {
        if hay[offset + j] != needle[j] -> return false
    }
    true
}

slice_ascii: fn(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    i := start
    loop {
        if i >= end -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i += 1
    }
}

ascii_lower: fn(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n: b
        if n >= 65 && n <= 90 -> out.push(U8{n + 32}) else -> out.push(b)
    }
    String.from_bytes(out) ?? text
}

parse_int: fn(text: String) -> Int? {
    n := 0
    any := false
    loop b in text.bytes() {
        d: b
        if d < 48 || d > 57 -> return None
        if n > 922337203685477580 || (n == 922337203685477580 && d > 7) -> return None
        n = n * 10 + (d - 48)
        any = true
    }
    if !any -> return None
    Val(n)
}
add: fn(event: LogRecord, field: LogField) -> LogRecord Never! {
    fields := event.fields
    fields.push(field.copy())
    LogRecord{level: event.level, message: event.message, fields: fields}
}

group: fn(event: LogRecord, prefix: String) -> LogRecord Never! {
    fields := [LogField]{}
    loop field in event.fields -> fields.push(LogField{key: "{prefix}.{field.key}", value: field.value, kind: field.kind, redacted: field.redacted})
    LogRecord{level: event.level, message: event.message, fields: fields}
}

time: fn(event: LogRecord, timestamp: Int) -> LogRecord Never! { add(event, int("time", timestamp)) }

clear: fn(event: LogRecord) -> LogRecord Never! { record(event.level, event.message, [LogField]{}) }

#Test("log level policy uses raw state") {
    saved_level: rt.level_load()
    saved_filter: rt.filter_load()
    saved_disabled: rt.disabled_load()
    rt.filter_store("")
    rt.level_store(0)
    rt.disabled_store(false)
    assert(!enabled_for(1, "shop"))
    assert(enabled_for(2, "shop"))
    set_level(.Debug)
    assert(enabled_for(1, "shop"))
    set_level(.Warn)
    assert(!enabled_for(2, "shop"))
    assert(enabled_for(3, "shop"))
    set_level(.Debug, path: "shop.db")
    assert(enabled_for(1, "shop.db"))
    assert(enabled_for(1, "shop.db.pool"))
    assert(!enabled_for(1, "shop.dbx"))
    assert(!enabled_for(2, "shop"))
    disable()
    assert(!enabled_for(6, "shop"))
    rt.filter_store(saved_filter)
    rt.level_store(saved_level)
    rt.disabled_store(saved_disabled)
}

#Test("log filters take the longest covering module path") {
    pairs: parse_filter("warn, shop.db=debug,shop.db.pool=error,bad pair,shop=nope")
    assert_eq(render_filter(pairs), "warn,shop.db=debug,shop.db.pool=error")
    assert_eq(covering_rank(pairs, "shop"), 3)
    assert_eq(covering_rank(pairs, "shop.db"), 1)
    assert_eq(covering_rank(pairs, "shop.db.pool.conn"), 4)
    assert_eq(covering_rank(pairs, "shop.dbx"), 3)
    assert(module_path_valid("shop.db_2"))
    assert(!module_path_valid("shop..db"))
    assert(!module_path_valid("2shop"))
    assert(!module_path_valid("shop."))
}

#Test("log format codes are source policy") {
    assert(format_code("auto") == 0)
    assert(format_code("json") == 1)
    assert(format_code("text") == 2)
}

#Test("span allocation preserves names and advances the thread counter") {
    first: span(" \nλ ")
    second: span("")
    assert_eq(first.name(), " \nλ ")
    assert_eq(second.name(), "")
    assert_eq(second.id(), first.id() + 1)
}

#Test("typed log fields retain order and normalize only redacted or unknown kinds") {
    fields: normalize_fields([LogField]{
        {key: "same", value: "secret", kind: "int", redacted: true},
        {key: "same", value: "7", kind: "counter", redacted: false},
        {key: "\"", value: "\n", kind: "unknown", redacted: false}
    })
    assert_eq(fields.len(), 3)
    assert_eq(fields[0].key, "same")
    assert_eq(fields[0].value, "[redacted]")
    assert_eq(fields[0].kind, "redacted")
    assert_eq(fields[1].value, "7")
    assert_eq(fields[1].kind, "counter")
    assert_eq(fields[2].key, "\"")
    assert_eq(fields[2].value, "\n")
    assert_eq(fields[2].kind, "string")
}
