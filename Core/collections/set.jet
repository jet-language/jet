// core.collections.set — ordered unique string sets.
//
// The set stores first-seen values in a deterministic order. All public
// operations return owned values and leave their inputs unchanged.
pub struct StringSet {
    pub items: [String]
}
fn copy_strings(xs: [String]) -> [String] {
    out := [String]{}
    loop x in xs -> &out.push(~x)
    out
}

fn has_string(xs: [String], item: String) -> Bool Never! {
    loop x in xs {
        if x == item -> return true
    }
    false
}

pub fn new() -> StringSet { StringSet{items: [String]{}} }

pub fn from_list(items: [String]) -> StringSet {
    out := [String]{}
    loop item in items {
        if !has_string(out, item) -> &out.push(~item)
    }
    StringSet{items: out}
}

pub fn add(s: StringSet, item: String) -> StringSet {
    if has_string(s.items, item) -> return StringSet{items: copy_strings(s.items)}
    items := copy_strings(s.items)
    &items.push(~item)
    StringSet{items: items}
}

pub fn discard(s: StringSet, item: String) -> StringSet Never! {
    items := [String]{}
    loop x in s.items {
        if x != item -> &items.push(~x)
    }
    StringSet{items: items}
}

pub fn remove(s: StringSet, item: String) -> StringSet? {
    if !contains(s, item) -> return None
    Val(discard(s, item))
}

pub fn contains(s: StringSet, item: String) -> Bool Never! {
    has_string(s.items, item)
}

pub fn len(s: StringSet) -> Int { s.items.len() }

pub fn is_empty(s: StringSet) -> Bool { s.items.len() == 0 }

pub fn to_list(s: StringSet) -> [String] { copy_strings(s.items) }

pub fn clear(_s: StringSet) -> StringSet { new() }

pub fn union(a: StringSet, b: StringSet) -> StringSet {
    items := copy_strings(a.items)
    loop x in b.items {
        if !has_string(items, x) -> &items.push(~x)
    }
    StringSet{items: items}
}

pub fn intersection(a: StringSet, b: StringSet) -> StringSet {
    items := [String]{}
    loop x in a.items {
        if has_string(b.items, x) -> &items.push(~x)
    }
    StringSet{items: items}
}

pub fn difference(a: StringSet, b: StringSet) -> StringSet {
    items := [String]{}
    loop x in a.items {
        if !has_string(b.items, x) -> &items.push(~x)
    }
    StringSet{items: items}
}

pub fn symmetric_difference(a: StringSet, b: StringSet) -> StringSet {
    union(difference(a, b), difference(b, a))
}

pub fn issubset(a: StringSet, b: StringSet) -> Bool {
    loop x in a.items {
        if !contains(b, x) -> return false
    }
    true
}

pub fn issuperset(a: StringSet, b: StringSet) -> Bool { issubset(b, a) }

pub fn isdisjoint(a: StringSet, b: StringSet) -> Bool {
    loop x in a.items {
        if has_string(b.items, x) -> return false
    }
    true
}

pub fn clone_set(s: StringSet) -> StringSet {
    StringSet{items: copy_strings(s.items)}
}
