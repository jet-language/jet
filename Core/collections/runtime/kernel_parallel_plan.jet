#Comparable
#Equatable
pub enum JetParallelReductionOrder { SourceOrder StableAdjacentPair }
pub fn reduction_order_display(order: JetParallelReductionOrder) -> String Never! {
    if order == .SourceOrder -> return "source-order"
    "stable-adjacent-pair"
}
#Debug
#Equatable
pub struct JetParallelReductionFact {
    pub operator: String
    pub identity_proved: Bool
    pub associative: Bool
    pub commutative: Bool
    pub order: JetParallelReductionOrder
}
pub fn reduction_new(operator: ^String, identity_proved: Bool, associative: Bool) -> JetParallelReductionFact Never! {
    JetParallelReductionFact{operator: ^operator, identity_proved: identity_proved, associative: associative,
        commutative: false, order: .StableAdjacentPair}
}
pub fn reduction_proven(operator: ^String) -> JetParallelReductionFact Never! { reduction_new(^operator, true, true) }
pub fn reduction_rejection_reason(fact: JetParallelReductionFact) -> String? Never! {
    operator := fact.operator.trim() // #4303
    if operator == "" -> return Val("reduction operator is unnamed")
    if !fact.identity_proved -> return Val("merge identity is not proven on both sides")
    if !fact.associative -> return Val("merge is not proven associative")
    if fact.order != .StableAdjacentPair -> return Val("reduction order `{reduction_order_display(fact.order)}` is not the stable adjacent-pair tree")
    None
}
#Debug
#Equatable
pub struct JetParallelResourceBounds {
    pub requested_workers: U64
    pub available_workers: U64
    pub chunk_items: U64
    pub max_chunks: U64
}
pub fn resources_new(requested_workers: U64, available_workers: U64, chunk_items: U64, max_chunks: U64) -> JetParallelResourceBounds Never! {
    JetParallelResourceBounds{requested_workers: requested_workers, available_workers: available_workers, chunk_items: chunk_items, max_chunks: max_chunks}
}
pub fn resources_default() -> JetParallelResourceBounds Never! { resources_explicit(U64{1}, U64{1}) }
pub fn resources_explicit(workers: U64, available_workers: U64) -> JetParallelResourceBounds Never! {
    resources_new(workers, available_workers, JET_PARALLEL_DEFAULT_CHUNK_ITEMS, JET_PARALLEL_DEFAULT_MAX_CHUNKS)
}
pub fn resources_with_chunk_items(resources: JetParallelResourceBounds, chunk_items: U64) -> JetParallelResourceBounds Never! {
    resources_new(resources.requested_workers, resources.available_workers, chunk_items, resources.max_chunks)
}
pub fn resources_worker_limit(resources: JetParallelResourceBounds) -> U64 Never! { max(U64{1}, resources.requested_workers) }
pub fn resources_selected_workers(resources: JetParallelResourceBounds, chunk_count: U64) -> U64 Never! {
    if chunk_count == (U64{0}) || resources.available_workers == (U64{0}) -> return U64{0}
    min(resources_worker_limit(resources), min(resources.available_workers, chunk_count))
}
#Debug
#Comparable
#Equatable
pub struct JetParallelChunk { pub ordinal: U64 pub start: U64 pub end: U64 pub worker: U64 }
pub fn chunk_len(chunk: JetParallelChunk) -> U64 Never! {
    if chunk.end < chunk.start -> return U64{0}
    chunk.end - chunk.start
}
pub fn chunk_range(chunk: JetParallelChunk) -> (start: U64, end: U64) Never! { (start: chunk.start, end: chunk.end) }
// Rust :1297. usize_max is a CHECKED target fact, never inferred from host.
pub fn resources_deterministic_chunks(resources: JetParallelResourceBounds, domain: JetParallelIterationDomain, usize_max: U64) -> [JetParallelChunk] JetParallelRejection! {
    range :: domain_range(domain) ?? return Err(JetParallelRejection.Domain(domain_rejection_reason(domain)))
    if resources.chunk_items == (U64{0}) -> return Err(JetParallelRejection.Resource("chunk_items must be greater than zero (got 0)"))
    len :: range.end - range.start
    if len == (U64{0}) -> return Ok([JetParallelChunk]{})
    if resources.available_workers == (U64{0}) -> return Err(JetParallelRejection.Resource("available_workers must be greater than zero for a non-empty domain (got 0)"))
    addend :: resources.chunk_items - U64{1}
    if len > usize_max - addend -> return Err(JetParallelRejection.Resource("chunk count overflows usize for {len} items and chunk_items={resources.chunk_items}"))
    chunk_count :: (len + addend) / resources.chunk_items
    if chunk_count > resources.max_chunks -> return Err(JetParallelRejection.Resource("chunk count {chunk_count} exceeds max_chunks {resources.max_chunks}"))
    workers :: resources_selected_workers(resources, chunk_count)
    chunks := [JetParallelChunk]{}
    ordinal := U64{0}
    loop ordinal < chunk_count {
        start :: range.start + ordinal * resources.chunk_items
        end :: start + min(resources.chunk_items, usize_max - start)
        &chunks.push(JetParallelChunk{ordinal: ordinal, start: start, end: min(end, range.end), worker: ordinal % workers})
        ordinal = ordinal + U64{1}
    }
    Ok(^chunks)
}
#Debug
#Comparable
#Equatable
pub enum JetParallelSequentialReason { EmptyDomain SingleChunk WorkerLimitOne AccelerationGateRejected ExplicitSerial }
pub fn sequential_reason_display(reason: JetParallelSequentialReason) -> String Never! {
    if reason == {
        .EmptyDomain -> "empty iteration domain"
        .SingleChunk -> "one deterministic chunk does not justify worker setup"
        .WorkerLimitOne -> "worker limit is one"
        .AccelerationGateRejected -> "D-ACCEL1 measured gain did not clear its threshold"
        .ExplicitSerial -> "caller selected the serial execution form"
    }
}
#Debug
#Comparable
#Equatable
pub enum JetParallelExecution { Sequential(reason: JetParallelSequentialReason) Parallel(workers: U64) }
pub fn execution_is_parallel(execution: JetParallelExecution) -> Bool Never! {
    if execution == .Parallel(_) -> return true
    false
}
pub fn execution_workers(execution: JetParallelExecution) -> U64 Never! {
    if execution == .Parallel(workers) -> return workers
    U64{1}
}
#Debug
#Error
#Equatable
pub enum JetParallelRejection {
    Domain(reason: String)
    MissingEffectFacts
    Access(fact: JetParallelAccessFact, reason: String)
    Dependence(fact: JetParallelDependencyFact)
    Effect(fact: JetParallelEffectFact, reason: String)
    Reduction(reason: String)
    Resource(reason: String)
}
pub fn rejection_reason(rejection: JetParallelRejection) -> String Never! {
    if rejection == {
        .Domain(reason) -> "iteration domain rejected: {reason}"
        .MissingEffectFacts -> "effect rejected: callback effect facts are unavailable"
        .Access(fact, reason) -> "access rejected: {access_description(fact)}: {reason}"
        .Dependence(fact) -> "dependence rejected: {dependency_description(fact)}"
        .Effect(fact, reason) -> "{reason} (`{fact.name}` is {effect_kind_display(fact.kind)}); operation cannot reorder it"
        .Reduction(reason) -> "reduction law rejected: {reason}"
        .Resource(reason) -> "resource bound rejected: {reason}"
    }
}
#Debug
#Equatable
pub struct JetParallelProof {
    pub domain: JetParallelIterationDomain
    pub accesses: [JetParallelAccessFact]
    pub effects: [JetParallelEffectFact]
    pub dependencies: [JetParallelDependencyFact]
    pub reduction: JetParallelReductionFact?
}
pub fn proof_new(domain: ^JetParallelIterationDomain, accesses: ^[JetParallelAccessFact], effects: ^[JetParallelEffectFact], dependencies: ^[JetParallelDependencyFact], reduction: ^JetParallelReductionFact?) -> JetParallelProof Never! {
    JetParallelProof{domain: ^domain, accesses: ^accesses, effects: ^effects, dependencies: ^dependencies, reduction: ^reduction}
}
pub fn proof_pure(domain: ^JetParallelIterationDomain) -> JetParallelProof Never! {
    proof_new(^domain, [JetParallelAccessFact]{}, [JetParallelEffectFact]{effect_pure()}, [JetParallelDependencyFact]{}, None)
}
// Rust :1607–1675; linear walks, exact domain/access/effect/dependency/law precedence.
pub fn proof_validate(proof: JetParallelProof, operation: JetParallelOperation) JetParallelRejection! {
    if !domain_is_valid(proof.domain) -> return Err(JetParallelRejection.Domain(domain_rejection_reason(proof.domain)))
    if proof.effects.len() == 0 -> return Err(JetParallelRejection.MissingEffectFacts)
    loop access in proof.accesses {
        if access.scope == .Unknown -> return Err(JetParallelRejection.Access(~access, "scope is unknown, so iteration disjointness is not proven"))
        if access_mode_is_reduction(access.mode) && !operation_is_reduction(operation) {
            return Err(JetParallelRejection.Access(~access, "reduction access is only valid for para_fold, not {operation_surface_name(operation)}"))
        }
        if access_mode_writes(access.mode) && !access_is_proven_disjoint(access) && !access_mode_is_reduction(access.mode) {
            return Err(JetParallelRejection.Dependence(dependency_write_after_write(~access.place, None, None)))
        }
    }
    loop effect in proof.effects {
        if effect_rejection_reason(effect, operation, proof.reduction != None) == .Val(reason) {
            return Err(JetParallelRejection.Effect(~effect, ^reason))
        }
    }
    loop dependency in proof.dependencies {
        if dependency_kind_conflicts(dependency.kind) -> return Err(JetParallelRejection.Dependence(~dependency))
    }
    if operation_is_reduction(operation) {
        reduction :: proof.reduction ?? return Err(JetParallelRejection.Reduction("para_fold requires a proven identity and associative merge law"))
        if reduction_rejection_reason(reduction) == .Val(reason) -> return Err(JetParallelRejection.Reduction(^reason))
    }
    Ok(())
}
pub fn proof_is_proven_independent(proof: JetParallelProof, operation: JetParallelOperation) -> Bool Never! {
    if proof_validate(proof, operation) == { .Ok(_) -> true .Err(_) -> false }
}
pub fn proof_rejection(proof: JetParallelProof, operation: JetParallelOperation) -> JetParallelRejection? Never! {
    if proof_validate(proof, operation) == { .Ok(_) -> None .Err(reason) -> Val(^reason) }
}
#Debug
#Equatable
pub struct JetParallelPlan {
    pub operation: JetParallelOperation
    pub domain: JetParallelIterationDomain
    pub proof: JetParallelProof
    pub resources: JetParallelResourceBounds
    pub chunks: [JetParallelChunk]
    pub execution: JetParallelExecution
    pub reduction: JetParallelReductionFact?
    pub acceleration: JetAccelerationDecision?
}
pub fn plan_select_explicit(operation: JetParallelOperation, proof: ^JetParallelProof, resources: JetParallelResourceBounds, usize_max: U64) -> JetParallelPlan JetParallelRejection! {
    plan_select_with_acceleration(operation, ^proof, resources, None, usize_max)
}
pub fn plan_select_with_acceleration(operation: JetParallelOperation, proof: ^JetParallelProof, resources: JetParallelResourceBounds, acceleration: JetAccelerationDecision?, usize_max: U64) -> JetParallelPlan JetParallelRejection! {
    if proof_validate(proof, operation) == .Err(rejection) -> return Err(^rejection)
    chunks :: if resources_deterministic_chunks(resources, proof.domain, usize_max) == {
        .Ok(values) -> ^values
        .Err(rejection) -> return Err(^rejection)
    }
    execution := JetParallelExecution.Sequential(.EmptyDomain)
    if chunks.len() != 0 {
        workers :: resources_selected_workers(resources, U64{chunks.len()})
        if chunks.len() == 1 { execution = .Sequential(.SingleChunk) }
        else if resources_worker_limit(resources) == (U64{1}) || workers <= (U64{1}) { execution = .Sequential(.WorkerLimitOne) }
        else if acceleration == .Val(decision) && !decision_selected(decision) { execution = .Sequential(.AccelerationGateRejected) }
        else { execution = .Parallel(workers) }
    }
    domain :: ~proof.domain
    reduction :: ~proof.reduction
    Ok(JetParallelPlan{operation: operation, domain: ^domain, proof: ^proof, resources: resources,
        chunks: ^chunks, execution: execution, reduction: ^reduction, acceleration: acceleration})
}
pub fn plan_is_parallel(plan: JetParallelPlan) -> Bool Never! { execution_is_parallel(plan.execution) }
pub fn plan_worker_count(plan: JetParallelPlan) -> U64 Never! { execution_workers(plan.execution) }
pub fn plan_chunk_count(plan: JetParallelPlan) -> U64 Never! { U64{plan.chunks.len()} }
// Rust :1497–1518, with Main's source-defect ruling: pair EVERY adjacent
// ordinal at each level and carry odd tails. Compact scalar ordinals in-place:
// O(n) total work, one active buffer, n-1 pairs, no per-level allocation.
pub fn plan_merge_tree(plan: JetParallelPlan) -> [(left: U64, right: U64)] Never! {
    pairs := [(left: U64, right: U64)]{}
    if !operation_is_reduction(plan.operation) -> return ^pairs
    active := [U64]{}
    loop chunk in plan.chunks -> &active.push(chunk.ordinal)
    count := active.len()
    loop count > 1 {
        cursor := 0
        next_count := 0
        loop cursor < count {
            left :: active[cursor]
            if cursor + 1 < count {
                &pairs.push((left: left, right: active[cursor + 1]))
                cursor += 2
            } else { cursor += 1 }
            active[next_count] = left
            next_count += 1
        }
        count = next_count
    }
    ^pairs
}
#Debug
#Equatable
pub struct JetParallelFailure { pub source_index: U64 pub message: String }
#Debug
#Comparable
#Equatable
pub enum JetParallelReceiptStatus { Running Completed Failed Cancelled }
pub fn receipt_status_display(status: JetParallelReceiptStatus) -> String Never! {
    if status == { .Running -> "running" .Completed -> "completed" .Failed -> "failed" .Cancelled -> "cancelled" }
}
#Debug
#Equatable
pub struct JetParallelReceipt {
    pub operation: JetParallelOperation
    pub status: JetParallelReceiptStatus
    pub chunks_total: U64
    pub chunks_started: U64
    pub chunks_completed: U64
    pub items_completed: U64
    pub first_failure: JetParallelFailure?
    pub cancellation_index: U64?
    pub partial_result_discarded: Bool
    pub external_effects_rolled_back: Bool
    pub acceleration: JetAccelerationDecision?
}
pub fn receipt_new(plan: JetParallelPlan) -> JetParallelReceipt Never! {
    JetParallelReceipt{operation: plan.operation, status: .Running, chunks_total: U64{plan.chunks.len()},
        chunks_started: U64{0}, chunks_completed: U64{0}, items_completed: U64{0}, first_failure: None,
        cancellation_index: None, partial_result_discarded: false, external_effects_rolled_back: false,
        acceleration: ~plan.acceleration}
}
pub fn plan_receipt(plan: JetParallelPlan) -> JetParallelReceipt Never! { receipt_new(plan) }
pub fn receipt_record_failure(receipt: &JetParallelReceipt, source_index: U64, message: ^String) Never! {
    replace := true
    if receipt.first_failure == .Val(current) {
        replace = source_index < current.source_index || (source_index == current.source_index && message < current.message)
    }
    if replace -> receipt.first_failure = Val(JetParallelFailure{source_index: source_index, message: ^message})
    receipt.partial_result_discarded = true
    receipt.external_effects_rolled_back = false
    receipt.status = .Running
}
pub fn receipt_record_cancellation(receipt: &JetParallelReceipt, source_index: U64) Never! {
    replace := true
    if receipt.cancellation_index == .Val(current) -> replace = source_index < current
    if replace -> receipt.cancellation_index = Val(source_index)
    receipt.partial_result_discarded = true
    receipt.external_effects_rolled_back = false
    receipt.status = .Running
}
pub fn receipt_finish(receipt: &JetParallelReceipt) -> JetParallelReceiptStatus Never! {
    if receipt.first_failure != None { receipt.status = .Failed }
    else if receipt.cancellation_index != None { receipt.status = .Cancelled }
    else { receipt.status = .Completed }
    if receipt.status != .Completed -> receipt.partial_result_discarded = true
    ~receipt.status
}
pub fn receipt_has_result(receipt: JetParallelReceipt) -> Bool Never! { receipt.status == .Completed && !receipt.partial_result_discarded }
// Borrow the original optional slot (the same retaining-reference convention
// as OverlayState.error_pause), never clone the failure/message for inspection.
pub fn receipt_selected_failure(receipt: JetParallelReceipt) -> &(JetParallelFailure?) from receipt {
    &receipt.first_failure
}

// Exact native/cross-owner body gates (no callable stubs):
// :239 AtomicU64 sequence; :248 publish requires selected wasm no-op OR real
// native var_os("JET_RECEIPT_DIR"/"JET_RECEIPT_CLAIM") BEFORE allocation/clock,
// relaxed fetch_add old sequence, canonical JSON render(false,0), existing
// jet_receipt_attach_encoded(payload,section,type,digest). The published ABI
// provides required var_os/counter concepts but no receipt attach or stable
// acceleration-specific static atomic cell. Do not use a temp-file counter.
// :75 costs_once: above-floor ONE lazy process cell initializes BOTH costs.
// :488 spawn: actual available_parallelism default1, saturating 64*max(workers,2),
// time kernel(items,usize::MAX,workers, |_| Ok(())), elapsed.as_nanos.max(1) as U64.
// :499 bandwidth: two 65536-byte blocks; source[index]=index as U8; time real
// target.copy_from_slice(source), wrapping U8 checksum, black_box, elapsed above.
// :516 first_chunk: no clock at <=1024; otherwise f(0..min(items,64)) ONCE,
// retain value and timed nanos. Needs canonical monotonic/Instant duration law.
// :539 measured_chunks: static refusal chunk_count0/len<=1024/workers<=1/
// !release/!parity/!proof calls canonical serial kernel with deferred input;
// otherwise retain first result, costs_once, evaluate, invoke existing selected
// parallel or serial kernel ONLY over len-sample_items with offset ranges;
// move first value at ordinal0 and tail ordinals+1 into source-ordered results.
// :621 column_range_map_with_sample: absent sample uses original(range); with
// sample assert len==sample_items, MOVE sample.value, reserve remaining range,
// compute min(saturating(start+sample_items),end), return if no tail; selected
// tail calls canonical column_copy_range_map, rejected tail calls original;
// MOVE tail into retained result. Sole dependency owner (packet0143):
// core.collections.runtime.kernel_collections.jet_list_accel_column_copy_range_map.
// That callable and no-copy reserve/consuming extension are not published.
// :663 accel_range_map: source range remains an index fact; actual worker cap
// (test cfg3, otherwise available_parallelism default1); measured_chunks with
// PooledParallelChunks and nested/singlepass false; each item uses original
// jet_para_call(source_index, f), ordered flatten, lowest failure.index wins,
// jet_para_raise_failure after collecting. Sole owners: packet0144
// core.collections.runtime.kernel_parallel_kernel.jet_list_para_chunks_kernel
// and .jet_list_para_chunks_serial_kernel; packet0138 owns the canonical
// failure/catch-unwind rail. Send/Sync/capture and selected cfg stay gated.
// Until those APIs and #4494/#4483/#4500 exist these eight bodies remain explicit
// missing prerequisites, not production wrappers, aliases, or parity claims.
