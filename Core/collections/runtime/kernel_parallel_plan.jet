use core.encoding.[DataTree]

// ParallelPlan.rs: D-PARCAPTURE1=D / D-ACCEL1=A. Backend-neutral proof,
// resource, measurement and outcome facts; this module is not a scheduler.
// Rust usize slots are retained as U64, NOT narrowed to host Int. The checked
// selected-target adapter supplies usize_max to chunk selection (#4483).
// Native activation gates: #4494 process-static LazyLock/AtomicU64, actual
// monotonic clocks/black_box, worker Send+Sync/catch-unwind, receipt capture;
// #4483 native/wasm and available_parallelism selection. No native substitute
// or successful placeholder is declared here. See the source-anchor gates below.
// #4499 and #4409 do not apply: no composite map keys or IO error-kind conversion.
// #4500 gates linear FnOnce/Fn captures, Send/Sync crossing, retained payload
// loans, capacity reservation and consuming list extension without T copies.

pub const JET_PARALLEL_DEFAULT_CHUNK_ITEMS: U64 = U64{64}
pub const JET_PARALLEL_DEFAULT_MAX_CHUNKS: U64 = U64{1048576}
pub const JET_ACCEL_STATIC_FLOOR_ITEMS: U64 = U64{1024}
pub const JET_ACCEL_CACHE_BLOCK_BYTES: U64 = U64{65536}
pub const JET_ACCEL_REQUIRED_GAIN_NUMERATOR: U64 = U64{2}
pub const JET_ACCEL_REQUIRED_GAIN_DENOMINATOR: U64 = U64{1}
pub const JET_ACCELERATION_RECEIPT_TYPE_NAME: String = "AccelerationDecision"
pub const JET_ACCELERATION_RECEIPT_SECTION_PREFIX: String = "jet.acceleration."
pub const JET_ACCELERATION_RECEIPT_SCHEMA_DIGEST: String = "fb216702b04de0611c6ceeb7b92efeeec9b91d3076277f38baac13475962d6d1"

