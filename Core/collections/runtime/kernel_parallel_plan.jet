pub fn decision_selected(decision: JetAccelerationDecision) -> Bool Never! { gate_status_is_selected(decision.status) }
#Debug
#Equatable
pub struct JetAccelerationGate {
    pub static_floor_items: U64
    pub cache_block_bytes: U64
    pub required_gain_numerator: U64
    pub required_gain_denominator: U64
}
pub fn gate_d_accel1() -> JetAccelerationGate Never! {
    JetAccelerationGate{static_floor_items: JET_ACCEL_STATIC_FLOOR_ITEMS,
        cache_block_bytes: JET_ACCEL_CACHE_BLOCK_BYTES,
        required_gain_numerator: JET_ACCEL_REQUIRED_GAIN_NUMERATOR,
        required_gain_denominator: JET_ACCEL_REQUIRED_GAIN_DENOMINATOR}
}
pub fn gate_default() -> JetAccelerationGate Never! { gate_d_accel1() }
pub fn gate_should_measure(gate: JetAccelerationGate, items: U64) -> Bool Never! { items > gate.static_floor_items }
// Rust :448–478. Overflow is None, including overflow in ceiling's addend;
// do NOT algebraically replace it with a non-overflowing rounded division.
fn checked_projection(nanos: U64, items: U64, divisor: U64) -> U64? Never! {
    if divisor == (U64{0}) -> return None
    product :: nanos.checked_mul(items) ?? return None
    rounded :: product.checked_add(divisor - U64{1}) ?? return None
    Val(rounded / divisor)
}
pub fn gate_measurement(gate: JetAccelerationGate, input: JetAccelerationGateInput) -> JetAccelerationMeasurement Never! {
    floor :: max(input.spawn_nanos, input.bandwidth_floor_nanos)
    JetAccelerationMeasurement{items: input.items, sample_items: input.sample_items,
        sample_nanos: input.sample_nanos, spawn_nanos: input.spawn_nanos,
        bandwidth_floor_nanos: input.bandwidth_floor_nanos, floor_nanos: floor,
        projected_serial_nanos: checked_projection(input.sample_nanos, input.items, input.sample_items),
        required_serial_nanos: checked_projection(floor, gate.required_gain_numerator, gate.required_gain_denominator)}
}
pub fn gate_evaluate(gate: JetAccelerationGate, transform: JetAccelerationTransform,
    input: JetAccelerationGateInput) -> JetAccelerationDecision Never! {
    measurement :: gate_measurement(gate, input)
    status := JetAccelerationGateStatus.Selected
    if input.items <= gate.static_floor_items { status = .BelowStaticFloor }
    else if input.pin == .Val(pin) { status = .Pinned(pin) }
    else if !input.release_build { status = .NotReleaseBuild }
    else if !input.cross_mode_parity_proven { status = .CrossModeParityMissing }
    else if transform == .TransientColumnCopy && (!input.nested_reuse || input.single_pass) { status = .ColumnCopyNotApplicable }
    else if !input.proof_proven { status = .ProofIncomplete }
    else if !input.first_chunk_serial_timed { status = .SampleNotTimed }
    else if !input.spawn_cost_once_per_process { status = .SpawnCostNotMeasured }
    else if !input.bandwidth_floor_measured { status = .BandwidthFloorNotMeasured }
    else if input.sample_items == (U64{0}) || input.sample_items > input.items || input.sample_nanos == (U64{0})
        || input.spawn_nanos == (U64{0}) || input.bandwidth_floor_nanos == (U64{0})
        || gate.required_gain_numerator == (U64{0}) || gate.required_gain_denominator == (U64{0}) {
        status = .InvalidMeasurement
    } else {
        if measurement.projected_serial_nanos == {
            .None -> status = .InvalidMeasurement
            .Val(projected) -> {
                if measurement.required_serial_nanos == {
                    .None -> status = .InvalidMeasurement
                    .Val(required) -> if projected < required -> status = .ProjectedGainBelowThreshold
                }
            }
        }
    }
    JetAccelerationDecision{transform: transform, status: status, measurement: measurement}
}
// Rust :364–373; canonical DataTree Int is exact, but the Rust receipt saturates
// at signed64, so retain that wire law even though Jet could represent more.
pub fn jet_acceleration_int(value: U64) -> DataTree Never! {
    DataTree.Int(Int.from_u64(min(value, U64{9223372036854775807})))
}
pub fn jet_acceleration_optional_int(value: U64?) -> DataTree Never! {
    if value == .Val(number) -> return jet_acceleration_int(number)
    DataTree.Null
}
// Rust :287–361. Canonical ordered String-key object, not a second value tree.
pub fn jet_acceleration_receipt_payload(function: String, loop_header: U32,
    source_start: U64, source_end: U64, decision: JetAccelerationDecision) -> DataTree Never! {
    row :: decision.measurement
    measurement := [String: DataTree]{}
    _ :: &measurement.add("bandwidth_floor_nanos", jet_acceleration_int(row.bandwidth_floor_nanos))
    _ :: &measurement.add("floor_nanos", jet_acceleration_int(row.floor_nanos))
    _ :: &measurement.add("items", jet_acceleration_int(row.items))
    _ :: &measurement.add("projected_serial_nanos", jet_acceleration_optional_int(row.projected_serial_nanos))
    _ :: &measurement.add("required_serial_nanos", jet_acceleration_optional_int(row.required_serial_nanos))
    _ :: &measurement.add("sample_items", jet_acceleration_int(row.sample_items))
    _ :: &measurement.add("sample_nanos", jet_acceleration_int(row.sample_nanos))
    _ :: &measurement.add("spawn_nanos", jet_acceleration_int(row.spawn_nanos))
    pin := DataTree.Null
    if decision.status == .Pinned(value) -> pin = DataTree.Text(pin_as_str(value))
    choice := [String: DataTree]{}
    _ :: &choice.add("measurement", DataTree.Object(^measurement))
    _ :: &choice.add("pin", ^pin)
    _ :: &choice.add("status", DataTree.Text(gate_status_as_str(decision.status)))
    _ :: &choice.add("transform", DataTree.Text(transform_as_str(decision.transform)))
    source := [String: DataTree]{}
    _ :: &source.add("end", jet_acceleration_int(source_end))
    _ :: &source.add("start", jet_acceleration_int(source_start))
    out := [String: DataTree]{}
    _ :: &out.add("decision", DataTree.Object(^choice))
    _ :: &out.add("function", DataTree.Text(~function))
    _ :: &out.add("loop_header", DataTree.Int(Int.from_u32(loop_header)))
    _ :: &out.add("source", DataTree.Object(^source))
    DataTree.Object(^out)
}

#Debug
#Comparable
#Equatable
pub enum JetParallelOperation { Map Filter Partition Fold }
pub fn operation_surface_name(operation: JetParallelOperation) -> String Never! {
    if operation == { .Map -> "para_map" .Filter -> "para_filter" .Partition -> "para_partition" .Fold -> "para_fold" }
}
pub fn operation_is_reduction(operation: JetParallelOperation) -> Bool Never! { operation == .Fold }
#Debug
#Equatable
pub enum JetParallelIterationDomain {
    Indexed(start: U64, end: U64)
    Unknown(reason: String)
}
pub fn domain_indexed(start: U64, end: U64) -> JetParallelIterationDomain Never! { JetParallelIterationDomain.Indexed(start, end) }
pub fn domain_from_len(len: U64) -> JetParallelIterationDomain Never! { domain_indexed(U64{0}, len) }
pub fn domain_unknown(reason: ^String) -> JetParallelIterationDomain Never! { JetParallelIterationDomain.Unknown(^reason) }
pub fn domain_start(domain: JetParallelIterationDomain) -> U64? Never! {
    if domain == { .Indexed(start, _) -> Val(start) .Unknown(_) -> None }
}
pub fn domain_end(domain: JetParallelIterationDomain) -> U64? Never! {
    if domain == { .Indexed(_, end) -> Val(end) .Unknown(_) -> None }
}
pub fn domain_len(domain: JetParallelIterationDomain) -> U64? Never! {
    if domain == .Indexed(start, end) && start <= end -> return Val(end - start)
    None
}
// A named tuple is the private, non-materializing Range<usize> fact.
pub fn domain_range(domain: JetParallelIterationDomain) -> (start: U64, end: U64)? Never! {
    if domain == .Indexed(start, end) && start <= end -> return Val((start: start, end: end))
    None
}
pub fn domain_is_valid(domain: JetParallelIterationDomain) -> Bool Never! { domain_range(domain) != None }
pub fn domain_rejection_reason(domain: JetParallelIterationDomain) -> String Never! {
    if domain == {
        .Indexed(start, end) -> {
            if start > end -> return "indexed domain has start {start} after end {end}"
            return ""
        }
        .Unknown(reason) -> {
            if reason == "" -> return "iteration bounds were not exposed by sema"
            return ~reason
        }
    }
}
