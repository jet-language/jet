    JetParallelAccessFact{place: ^place, mode: mode, scope: scope}
}
pub fn access_read(place: ^String) -> JetParallelAccessFact Never! { access_new(^place, .Read, .Invariant) }
pub fn access_write(place: ^String) -> JetParallelAccessFact Never! { access_new(^place, .Write, .Invariant) }
pub fn access_read_write(place: ^String) -> JetParallelAccessFact Never! { access_new(^place, .ReadWrite, .Invariant) }
pub fn access_reduce(place: ^String) -> JetParallelAccessFact Never! { access_new(^place, .Reduce, .Invariant) }
pub fn access_disjoint(place: ^String, mode: JetParallelAccessMode) -> JetParallelAccessFact Never! { access_new(^place, mode, .Disjoint) }
pub fn access_is_proven_disjoint(fact: JetParallelAccessFact) -> Bool Never! { fact.scope == .IterationLocal || fact.scope == .Disjoint }
pub fn access_description(fact: JetParallelAccessFact) -> String Never! {
    "{access_mode_display(fact.mode)} `{fact.place}` ({access_scope_display(fact.scope)})"
}
