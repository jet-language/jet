pub enum JetParallelEffectKind { Pure ReadOnly SharedRead Reduction MayFail CancellationPoint SharedWrite External Unknown }
pub fn effect_kind_display(kind: JetParallelEffectKind) -> String Never! {
    if kind == {
        .Pure -> "pure" .ReadOnly -> "read-only" .SharedRead -> "synchronized read"
        .Reduction -> "reduction" .MayFail -> "fallible" .CancellationPoint -> "cancellation point"
        .SharedWrite -> "shared write" .External -> "external effect" .Unknown -> "unknown effect"
    }
}
#Debug
#Equatable
pub struct JetParallelEffectFact { pub name: String pub kind: JetParallelEffectKind }
pub fn effect_new(name: ^String, kind: JetParallelEffectKind) -> JetParallelEffectFact Never! { JetParallelEffectFact{name: ^name, kind: kind} }
pub fn effect_pure() -> JetParallelEffectFact Never! { effect_new("callback", .Pure) }
pub fn effect_read_only(name: ^String) -> JetParallelEffectFact Never! { effect_new(^name, .ReadOnly) }
pub fn effect_shared_read(name: ^String) -> JetParallelEffectFact Never! { effect_new(^name, .SharedRead) }
pub fn effect_reduction(name: ^String) -> JetParallelEffectFact Never! { effect_new(^name, .Reduction) }
pub fn effect_shared_write(name: ^String) -> JetParallelEffectFact Never! { effect_new(^name, .SharedWrite) }
pub fn effect_external(name: ^String) -> JetParallelEffectFact Never! { effect_new(^name, .External) }
pub fn effect_unknown(name: ^String) -> JetParallelEffectFact Never! { effect_new(^name, .Unknown) }
pub fn effect_rejection_reason(fact: JetParallelEffectFact, operation: JetParallelOperation, has_reduction: Bool) -> String? Never! {
    reason := ""
    if fact.kind == {
        .Pure -> return None
        .ReadOnly -> return None
        .SharedRead -> return None
        .MayFail -> return None
        .CancellationPoint -> return None
        .Reduction -> {
            if operation_is_reduction(operation) && has_reduction -> return None
            reason = "reduction effect needs a proven identity and associative merge law"
        }
        .SharedWrite -> reason = "shared writes can race; use explicit synchronized state outside the callback"
        .External -> reason = "external effects observe callback order and are not rollback-safe"
        .Unknown -> reason = "effect facts were not classified by sema"
    }
    Val("effect `{fact.name}` is {effect_kind_display(fact.kind)}: {reason}")
}
