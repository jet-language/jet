}
pub fn gate_input_deferred(items: U64, release_build: Bool) -> JetAccelerationGateInput Never! {
    JetAccelerationGateInput{items: items, sample_items: U64{0}, sample_nanos: U64{0},
        spawn_nanos: U64{0}, bandwidth_floor_nanos: U64{0}, first_chunk_serial_timed: false,
        spawn_cost_once_per_process: false, bandwidth_floor_measured: false,
        release_build: release_build, cross_mode_parity_proven: false, pin: None,
        nested_reuse: false, single_pass: false, proof_proven: false}
}
pub fn gate_input_measured(items: U64, sample_items: U64, sample_nanos: U64,
    costs: JetAccelerationRuntimeCosts, release_build: Bool, cross_mode_parity_proven: Bool,
    proof_proven: Bool, nested_reuse: Bool, single_pass: Bool, pin: JetAccelerationPin?) -> JetAccelerationGateInput Never! {
    JetAccelerationGateInput{items: items, sample_items: sample_items, sample_nanos: sample_nanos,
        spawn_nanos: costs.spawn_nanos, bandwidth_floor_nanos: costs.bandwidth_floor_nanos,
        first_chunk_serial_timed: sample_items != (U64{0}) && sample_nanos != (U64{0}),
        spawn_cost_once_per_process: costs.spawn_cost_once_per_process,
        bandwidth_floor_measured: costs.bandwidth_floor_measured, release_build: release_build,
        cross_mode_parity_proven: cross_mode_parity_proven, pin: pin, nested_reuse: nested_reuse,
        single_pass: single_pass, proof_proven: proof_proven}
}
#Debug
#Comparable
#Equatable
pub enum JetAccelerationGateStatus {
    BelowStaticFloor
    Pinned(pin: JetAccelerationPin)
    NotReleaseBuild
    CrossModeParityMissing
    ColumnCopyNotApplicable
    ProofIncomplete
    SampleNotTimed
    SpawnCostNotMeasured
    BandwidthFloorNotMeasured
    InvalidMeasurement
    ProjectedGainBelowThreshold
    Selected
}
pub fn gate_status_as_str(status: JetAccelerationGateStatus) -> String Never! {
    if status == {
        .BelowStaticFloor -> "below-static-floor"
        .Pinned(_) -> "pinned"
        .NotReleaseBuild -> "not-release-build"
        .CrossModeParityMissing -> "cross-mode-parity-missing"
        .ColumnCopyNotApplicable -> "column-copy-not-applicable"
        .ProofIncomplete -> "proof-incomplete"
        .SampleNotTimed -> "sample-not-timed"
        .SpawnCostNotMeasured -> "spawn-cost-not-measured"
        .BandwidthFloorNotMeasured -> "bandwidth-floor-not-measured"
        .InvalidMeasurement -> "invalid-measurement"
        .ProjectedGainBelowThreshold -> "projected-gain-below-threshold"
        .Selected -> "selected"
    }
}
pub fn gate_status_is_selected(status: JetAccelerationGateStatus) -> Bool Never! { status == .Selected }
