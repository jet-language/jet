pub fn dependency_kind_conflicts(kind: JetParallelDependencyKind) -> Bool Never! { kind != .Independent }
pub fn dependency_kind_display(kind: JetParallelDependencyKind) -> String Never! {
    if kind == {
        .Independent -> "independent" .ReadAfterWrite -> "read-after-write" .WriteAfterRead -> "write-after-read"
        .WriteAfterWrite -> "write-after-write" .LoopCarried -> "loop-carried" .Unknown -> "unknown"
    }
}
#Debug
#Equatable
pub struct JetParallelDependencyFact {
    pub place: String
    pub kind: JetParallelDependencyKind
    pub source_iteration: U64?
    pub target_iteration: U64?
    pub detail: String
}
pub fn dependency_new(place: ^String, kind: JetParallelDependencyKind, source_iteration: U64?, target_iteration: U64?, detail: ^String) -> JetParallelDependencyFact Never! {
    JetParallelDependencyFact{place: ^place, kind: kind, source_iteration: source_iteration, target_iteration: target_iteration, detail: ^detail}
}
pub fn dependency_independent(place: ^String) -> JetParallelDependencyFact Never! {
    dependency_new(^place, .Independent, None, None, "sema proved disjoint iteration projections")
}
pub fn dependency_write_after_write(place: ^String, source: U64?, target: U64?) -> JetParallelDependencyFact Never! {
    dependency_new(^place, .WriteAfterWrite, source, target, "iterations write the same location")
}
pub fn dependency_unknown(place: ^String, detail: ^String) -> JetParallelDependencyFact Never! { dependency_new(^place, .Unknown, None, None, ^detail) }
pub fn dependency_description(fact: JetParallelDependencyFact) -> String Never! {
    pair := ""
    if fact.source_iteration == .Val(source) && fact.target_iteration == .Val(target) -> pair = " from iteration {source} to {target}"
    if fact.detail == "" -> return "{dependency_kind_display(fact.kind)} on `{fact.place}`{pair}"
    "{dependency_kind_display(fact.kind)} on `{fact.place}`{pair}: {fact.detail}"
}
