use core.collections.runtime.kernel_collections.[JetLoopSource, JetLoopSourceKind, JetLoopAny, jet_loop_source_error]
use core.encoding.runtime.kernel_mod.[JetFileReader]
use core.files.runtime.top_file_stream.[jet_std_file_reader_read_line]
use core.term.runtime.kernel_stdin_reader.[JetStdinReader, jet_std_io_stdin_read_line]
use core.process.runtime.top_process_02.[jet_process_stream_next_line]
use core.mem.runtime.portable_core.[jet_panic]
use std.rc.[Rc]
use std.cell.[RefCell]
use std.io.[Read, BufReader]
use std.iter
// Native file, stdin and process source adapters; collection semantics stay in Collections.
impl JetLoopSource for JetFileReader {
    // Rust: crates/jet-codegen/src/Prelude/Core/CollectionIoSources.rs:7
    fn jet_loop_source(^self, source_kind: JetLoopSourceKind, by_value: Bool) -> Box<Iterator<Item=JetLoopAny>> {
        match source_kind {
            .LinesFile -> {
                if !by_value { jet_loop_source_error(source_kind) }
                Box.new(std.iter.from_fn(fn() {
                    match jet_std_file_reader_read_line(&self) {
                        Ok(value) -> value.map(fn(value) { Box.new(^value) as JetLoopAny }),
                        Err(error) -> jet_panic("<core.prelude>", 0, &error.jet_show()),
                    }
                }))
            },
            _ -> jet_loop_source_error(source_kind),
        }
    }
}
impl JetLoopSource for &JetFileReader {
    // Rust: crates/jet-codegen/src/Prelude/Core/CollectionIoSources.rs:36
    fn jet_loop_source(^self, source_kind: JetLoopSourceKind, by_value: Bool) -> Box<Iterator<Item=JetLoopAny>> {
        match source_kind {
            .LinesFile -> {
                if by_value { jet_loop_source_error(source_kind) }
                values := [String].new()
                loop {
                    match jet_std_file_reader_read_line(self) {
                        Ok(Val(value)) -> values.push(^value),
                        Ok(None) -> break,
                        Err(error) -> jet_panic("<core.prelude>", 0, &error.jet_show()),
                    }
                }
                Box.new(values.into_iter().map(fn(value) { Box.new(^value) as JetLoopAny }))
            },
            _ -> jet_loop_source_error(source_kind),
        }
    }
}
