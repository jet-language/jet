impl<R: Read> JetLoopSource for Rc<RefCell<BufReader<R>?>> {
    // Rust: crates/jet-codegen/src/Prelude/Core/CollectionIoSources.rs:139
    fn jet_loop_source(^self, source_kind: JetLoopSourceKind, _by_value: Bool) -> Box<Iterator<Item=JetLoopAny>> {
        match source_kind {
            .LinesProcessStream -> {
                // GATE #4565: kernel primitive
                handle :: #Unsafe("retain the process stream Rc provider for the escaping owned iterator") { Rc.clone(&self) }
                Box.new(std.iter.from_fn(fn() {
                    match jet_process_stream_next_line(&handle) {
                        Ok(value) -> value.map(fn(value) { Box.new(^value) as JetLoopAny }),
                        Err(error) -> jet_panic("<core.prelude>", 0, &error.jet_show()),
                    }
                }))
            },
            _ -> jet_loop_source_error(source_kind),
        }
    }
}

