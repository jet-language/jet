// Rust: crates/jet-codegen/src/Prelude/Core/Collections.rs:1975
// Empty split yields a leading empty, scalar strings, and trailing empty.
enum JetStringSplitSeparator { Empty, Scalar(Char), Text(String) }
// Rust: crates/jet-codegen/src/Prelude/Core/Collections.rs:1981
struct JetStringSplitIter { source: String, separator: JetStringSplitSeparator, offset: Usize, phase: U8, done: Bool }
impl JetStringSplitIter.Iterator {
    type Item = String
    // Rust: crates/jet-codegen/src/Prelude/Core/Collections.rs:1992
    fn next(self: &JetStringSplitIter) -> String? {
        if self.separator == {
            .Empty -> {
                if self.phase == {
                    0 -> { self.phase = 1; .Val(String.new()) }
                    1 -> {
                        if self.offset >= self.source.len() {
                            self.phase = 2
                            return .Val(String.new())
                        }
                        ch :: self.source[self.offset..].chars().next().expect("offset in bounds")
                        width :: ch.len_utf8()
                        out :: self.source[self.offset..self.offset + width].to_owned()
                        self.offset += width
                        .Val(out)
                    }
                    _ -> .None
                }
            }
            separator -> {
                if self.done -> return .None
                start :: self.offset
                found :: if separator == {
                    .Scalar(ch) -> self.source[start..].find(ch).map(fn(relative) { (relative, ch.len_utf8()) })
                    .Text(text) -> self.source[start..].find(text).map(fn(relative) { (relative, text.len()) })
                    .Empty -> panic("empty separator handled above")
                }
                if found == {
                    .Val((relative, separator_len)) -> {
                        end :: start + relative
                        self.offset = end + separator_len
                        .Val(self.source[start..end].to_owned())
                    }
                    .None -> { self.done = true; .Val(self.source[start..].to_owned()) }
                }
            }
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Collections.rs:2045
fn jet_iter_string_split(s: String, sep: String) -> JetIter<String> {
    chars :: sep.chars()
    separator :: if (chars.next(), chars.next()) == {
        (.None, _) -> JetStringSplitSeparator.Empty
        (.Val(ch), .None) -> JetStringSplitSeparator.Scalar(ch)
        (.Val(_), .Val(_)) -> JetStringSplitSeparator.Text(sep.to_owned())
    }
    JetIter { source: Box.new(JetStringSplitIter { source: s.to_owned(), separator, offset: 0, phase: 0, done: false }) }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Collections.rs:2065
fn jet_bytes_ascii_whitespace_for_each(bytes: &[U8], space: U8, ws_start: U8, ws_end: U8,
    f: fn(&[U8], Bool) -> Unit) -> Unit {
    start := 0
    for (index, byte) in bytes.iter().enumerate() {
        if byte == space || (byte >= ws_start && byte <= ws_end) {
            if start < index -> f(bytes[start..index], false)
            start = index + 1
        }
    }
    if start < bytes.len() -> f(bytes[start..], true)
}
// Rust: crates/jet-codegen/src/Prelude/Core/Collections.rs:2090
fn jet_iter_string_rsplit(s: String, sep: String) -> JetIter<String> {
    if sep.is_empty() -> return jet_iter_string_split(s, sep)
    parts :: s.rsplit(sep).map(fn(p) { p.to_string() }).collect<[String]>()
    parts.reverse()
    jet_iter_from_vec(^parts)
}
