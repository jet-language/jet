//RS 
//RS /// Push one already-read column word back into a list in its own kind.
//RS ///
//RS /// The write half of `jit_zip_read_value`: every kind except `Float` lives as
//RS /// one `i64` word in a list slot (a `String` slot holds the string handle), and
//RS /// `Float` needs `list_push_float` because a list slot is a `JetVal::Float`,
//RS /// not the bit pattern.
//RS fn jit_zip_push_column_value(
//RS     heap: &mut jet_rt::JetArena,
//RS     list: i64,
//RS     value: JitZipValue,
//RS ) -> Option<()> {
//RS     match value {
//RS         JitZipValue::Float(value) => heap.list_push_float(list, value),
//RS         JitZipValue::Bits(value) => heap.list_push_int(list, value),
//RS         JitZipValue::Absent => None,
//RS     }
//RS }
//RS 
//RS /// `[(A, B)].unzip()` — two columns, each read and republished in its OWN kind.
//RS ///
//RS /// The kinds arrive as immediates (`JitZipValueKind::code`) because lowering
//RS /// already knows the row's field types and an unzip has no fill mode to plan.
//RS /// This used to be an i64-pair host: it read both fields with `record_get_int`,
//RS /// so a `String` column read `None`, the whole row fell out of a `filter_map`,
//RS /// and the answer was two EMPTY lists rather than a stop. The split semantics
//RS /// still belong to the Prelude kernel (I9); only the representation is here.
