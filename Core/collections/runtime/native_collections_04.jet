//RS fn jet_jit_iter_zip_family(
//RS     plan_id: i64,
//RS     column_handles: i64,
//RS     common_fill: i64,
//RS     column_fills: i64,
//RS ) -> i64 {
//RS     let out = zip_family_rows(plan_id, column_handles, common_fill, column_fills);
//RS     // The sidecar reads list lengths itself, so it runs outside the runtime
