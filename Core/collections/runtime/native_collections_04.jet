//RS #[derive(Clone, Copy)]
//RS enum JitZipValue {
//RS     Bits(i64),
//RS     Float(f64),
//RS     Absent,
//RS }
//RS 
//RS fn jit_zip_read_value(
//RS     heap: &jet_rt::JetArena,
//RS     list: i64,
//RS     kind: crate::runtime_host::JitZipValueKind,
//RS     index: usize,
//RS ) -> Option<JitZipValue> {
//RS     let index = i64::try_from(index).ok()?;
//RS     match kind {
//RS         crate::runtime_host::JitZipValueKind::Float => {
//RS             heap.list_get_float(list, index).map(JitZipValue::Float)
//RS         }
//RS         crate::runtime_host::JitZipValueKind::Int
//RS         | crate::runtime_host::JitZipValueKind::Bool
//RS         | crate::runtime_host::JitZipValueKind::Char
//RS         | crate::runtime_host::JitZipValueKind::String
//RS         | crate::runtime_host::JitZipValueKind::Opaque => {
//RS             heap.list_get_int(list, index).map(JitZipValue::Bits)
//RS         }
//RS     }
//RS }
//RS 
//RS /// Read record field `index` back in the kind `jit_zip_set_value` wrote it in.
//RS ///
//RS /// Two callers need this exact per-kind accessor ladder: the per-column fill
//RS /// record `zip(fill:)` passes, and `jet_jit_list_unzip` taking a row apart
//RS /// again. It is the read half of `jit_zip_set_value` and must stay total over
//RS /// the same `JitZipValueKind` set — the unzip host used to read every field
//RS /// with `record_get_int`, so a `record_set_string` column returned `None`, the
//RS /// row was dropped, and `["a","bb","c"].zip([1,2,3]).unzip()` answered two
//RS /// EMPTY lists.
//RS fn jit_zip_record_field(
//RS     heap: &mut jet_rt::JetArena,
//RS     kind: crate::runtime_host::JitZipValueKind,
//RS     column_fills_handle: i64,
//RS     index: usize,
//RS ) -> JitZipValue {
//RS     let Some(index) = i64::try_from(index).ok() else {
//RS         return JitZipValue::Absent;
//RS     };
//RS     match kind {
//RS         crate::runtime_host::JitZipValueKind::Float => heap
//RS             .record_get_float(column_fills_handle, index)
//RS             .map_or(JitZipValue::Absent, JitZipValue::Float),
//RS         crate::runtime_host::JitZipValueKind::Bool => heap
//RS             .record_get_bool(column_fills_handle, index)
//RS             .map_or(JitZipValue::Absent, |value| {
//RS                 JitZipValue::Bits(i64::from(value))
//RS             }),
//RS         crate::runtime_host::JitZipValueKind::Char => heap
//RS             .record_get_char(column_fills_handle, index)
//RS             .map_or(JitZipValue::Absent, |value| {
//RS                 JitZipValue::Bits(i64::from(u32::from(value)))
//RS             }),
//RS         crate::runtime_host::JitZipValueKind::Int => heap
//RS             .record_get_int(column_fills_handle, index)
//RS             .map_or(JitZipValue::Absent, JitZipValue::Bits),
//RS         crate::runtime_host::JitZipValueKind::String => heap
//RS             .record_get_string(column_fills_handle, index)
//RS             .map_or(JitZipValue::Absent, JitZipValue::Bits),
//RS         // `Opaque` is the ONE kind that names no payload representation, so it
//RS         // must not assert one. It is also the only kind
//RS         // `LowerCtx::unzip_column_kinds` can reach WITHOUT `JitMeta`: the
//RS         // static `clif_ty` is distinct-blind, so a `distinct Name = String`
//RS         // column looks like a plain I64 handle to it, while the row writer used
//RS         // the distinct-AWARE erasure and stored a `String` cell. Asserting
//RS         // `record_get_int` there read `None` — the same shape that answered two
//RS         // empty lists, one ICE further on. So read the cell in ITS shape: the
//RS         // column list this word is republished into is typed by the same field
//RS         // type, so the cell's own shape is the representation that list slot
//RS         // wants (`[Float]` slots are floats, `[String]`/`[Bool]`/`[Char]` slots
//RS         // are the erased int word). `Int` stays first: it is the hot cell and
//RS         // pays exactly one match, as before.
//RS         crate::runtime_host::JitZipValueKind::Opaque => {
//RS             if let Some(value) = heap.record_get_int(column_fills_handle, index) {
//RS                 return JitZipValue::Bits(value);
//RS             }
//RS             if let Some(value) = heap.record_get_float(column_fills_handle, index) {
//RS                 return JitZipValue::Float(value);
//RS             }
//RS             if let Some(value) = heap.record_get_bool(column_fills_handle, index) {
//RS                 return JitZipValue::Bits(i64::from(value));
//RS             }
//RS             if let Some(value) = heap.record_get_char(column_fills_handle, index) {
//RS                 return JitZipValue::Bits(i64::from(u32::from(value)));
//RS             }
//RS             heap.record_get_string(column_fills_handle, index)
//RS                 .map_or(JitZipValue::Absent, JitZipValue::Bits)
//RS         }
//RS     }
//RS }
//RS 
