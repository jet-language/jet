use core.collections.runtime.kernel_collections.[JetLoopSource, JetLoopSourceKind, JetLoopAny, jet_loop_source_error]
use core.math.runtime.std_math_task_mem.[JetReceiver]
use core.tasks.runtime.stream.[JetStream]
use core.encoding.runtime.kernel_mod.[JSONReader, JSONLReader, CSVReader, XMLReader, CBORReader]
use core.encoding.runtime.top_encoding_stream.[jet_enc_json_reader_next, jet_enc_jsonl_reader_next, jet_enc_csv_reader_next, jet_enc_xml_reader_next, jet_enc_cbor_reader_next]
use core.mem.runtime.portable_core.[jet_panic]
use std.iter
// Native collection source adapters; scheduler and encoding owners retain stream state.
impl<T: Send> JetLoopSource for JetReceiver<T> {
    // Rust: crates/jet-codegen/src/Prelude/Core/CollectionSources.rs:7
    fn jet_loop_source(^self, source_kind: JetLoopSourceKind, _by_value: Bool) -> Box<Iterator<Item=JetLoopAny>> {
        match source_kind {
            .ChannelReceiver -> {
                receiver :: ^self
                Box.new(std.iter.from_fn(fn() {
                    match receiver.receive() { Ok(value) -> Val(Box.new(^value) as JetLoopAny), Err(_) -> None }
                }))
            },
            _ -> jet_loop_source_error(source_kind),
        }
    }
}
impl<T: Send> JetLoopSource for &JetReceiver<T> {
    // Rust: crates/jet-codegen/src/Prelude/Core/CollectionSources.rs:32
    fn jet_loop_source(^self, source_kind: JetLoopSourceKind, _by_value: Bool) -> Box<Iterator<Item=JetLoopAny>> {
        match source_kind {
            .ChannelReceiver -> {
                receiver :: (*self).clone()
                Box.new(std.iter.from_fn(fn() {
                    match receiver.receive() { Ok(value) -> Val(Box.new(^value) as JetLoopAny), Err(_) -> None }
                }))
            },
            _ -> jet_loop_source_error(source_kind),
        }
    }
}
impl<T: Send> JetLoopSource for JetStream<T> {
    // Rust: crates/jet-codegen/src/Prelude/Core/CollectionSources.rs:57
    fn jet_loop_source(^self, source_kind: JetLoopSourceKind, by_value: Bool) -> Box<Iterator<Item=JetLoopAny>> {
        match source_kind {
            .Plain -> {
                if !by_value { jet_loop_source_error(source_kind) }
                Box.new(self.into_iter().map(fn(value) { Box.new(^value) as JetLoopAny }))
            },
            _ -> jet_loop_source_error(source_kind),
        }
    }
}
impl JetLoopSource for JSONReader {
    // Rust: crates/jet-codegen/src/Prelude/Core/CollectionSources.rs:84
    fn jet_loop_source(^self, source_kind: JetLoopSourceKind, by_value: Bool) -> Box<Iterator<Item=JetLoopAny>> {
        match source_kind {
            .EncodingReader{reader_type} -> match reader_type {
                "JSONReader" -> {
                    if !by_value { jet_loop_source_error(source_kind) }
                    Box.new(std.iter.from_fn(fn() {
                        match jet_enc_json_reader_next(&self) {
                            Ok(Ok(value)) -> Val(Box.new(^value) as JetLoopAny),
                            Ok(Err(_)) -> None,
                            Err(error) -> jet_panic("<core.prelude>", 0, &error.jet_show()),
                        }
                    }))
                },
                _ -> jet_loop_source_error(source_kind),
            },
            _ -> jet_loop_source_error(source_kind),
        }
    }
}
