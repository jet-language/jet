use std.cmp.[Ordering]
use std.iter.[IntoIterator]

// Rust: crates/jet-codegen/src/Prelude/Core/SortKernel.rs:1
pub fn jet_list_try_sort_by_key_kernel<T, K, E>(xs: &[T], key: fn(&T) -> K E!,
    compare: fn(&K, &K) -> Ordering) -> Unit E! {
    // Evaluate keys once before mutating the receiver; retain stable tie order.
    keyed := [(Usize, K)].with_capacity(xs.len())
    for (index, item) in xs.iter().enumerate() -> keyed.push((index, key(item)?))
    keyed.sort_by(fn(left, right) { compare(&left.1, &right.1) })
    // Follow prior swaps without copying receiver values.
    for target in 0..keyed.len() {
        source := keyed[target].0
        while source < target -> source = keyed[source].0
        keyed[target].0 = source
        if source != target -> xs.swap(target, source)
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/Core/SortKernel.rs:32
pub fn jet_list_sort_by_compare_kernel<T>(xs: &[T], compare: fn(&T, &T) -> Ordering) -> Unit { xs.sort_by(compare) }
// Rust: crates/jet-codegen/src/Prelude/Core/SortKernel.rs:39
pub fn jet_list_try_partition_kernel<T, E, I: IntoIterator<Item = T>>(xs: I,
    predicate: fn(&T) -> Bool E!) -> ([T], [T]) E! {
    yes: [T] := []
    no: [T] := []
    for item in xs {
        if predicate(&item)? -> yes.push(^item)
        else -> no.push(^item)
    }
    Ok((^yes, ^no))
}
