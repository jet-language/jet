// Shared zip-family policy: hosts only marshal values into this owner.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Iter.rs:3
fn jet_sequence_argument_message(method: &String, value: I64) -> String? {
    match method {
        "take" | "skip" if value < 0 -> Val("sequence count must be nonnegative"),
        "step_by" if value <= 0 -> Val("step_by requires a positive step"),
        "chunks" if value <= 0 -> Val("chunks requires a positive size"),
        "windows" if value <= 0 -> Val("windows requires a positive size"),
        _ -> None,
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Iter.rs:13
fn jet_zip_row_count(lengths: &[Usize], mode: U8) -> Usize? {
    if lengths.is_empty() { return Val(0) }
    if mode == 1 && lengths.iter().any(fn(length) { *length != lengths[0] }) { return None }
    Val(match mode { 2 -> lengths.iter().copied().max().unwrap_or(0), _ -> lengths.iter().copied().min().unwrap_or(0) })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Iter.rs:26
fn jet_zip_column_index(row: Usize, length: Usize) -> Usize? { (row < length).then_some(row) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Iter.rs:30
fn jet_zip_fill_at<T: Clone>(fill_mode: U8, common_fills: &[T], column_fills: &[T], default: T, column: Usize) -> T {
    match fill_mode { 1 -> common_fills.get(column).cloned().unwrap_or(^default), 2 -> column_fills.get(column).cloned().unwrap_or(^default), _ -> ^default }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Iter.rs:44
fn jet_zip_rows<T: Clone>(lengths: &[Usize], mode: U8, read: fn(Usize, Usize) -> T?, fill: fn(Usize) -> T) -> [[T]]? {
    row_count :: jet_zip_row_count(lengths, mode)?
    Val((0..row_count).map(fn(row) {
        lengths.iter().enumerate().map(fn((column, length)) {
            jet_zip_column_index(row, *length).and_then(fn(index) { read(column, index) }).unwrap_or_else(fn() { fill(column) })
        }).collect<[T]>()
    }).collect<[[T]]>())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Iter.rs:72
pub fn jet_zip_strict_step<A, B>(left: A?, right: B?) -> (A, B)? ()! {
    match (left, right) {
        (Val(left), Val(right)) -> Ok(Val((^left, ^right))),
        (None, None) -> Ok(None),
        (None, Val(_)) | (Val(_), None) -> Err(()),
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Iter.rs:80
pub fn jet_zip_short_step<A, B>(left: A?, right: fn() -> B?) -> (A, B)? {
    match left { Val(left) -> right().map(fn(right) { (^left, ^right) }), None -> None }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Iter.rs:90
pub fn jet_zip_pad_step<A: Clone, B: Clone>(left: A?, right: B?, left_fill: A, right_fill: B) -> (A, B)? {
    match (left, right) {
        (Val(left), Val(right)) -> Val((^left, ^right)),
        (Val(left), None) -> Val((^left, ^right_fill)),
        (None, Val(right)) -> Val((^left_fill, ^right)),
        (None, None) -> None,
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Iter.rs:106
fn jet_list_count_where_kernel<T>(xs: &[T], predicate: fn(&T) -> Bool) -> I64 {
    count: I64 := 0
    for item in xs { if predicate(item) { count += 1 } }
    count
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Iter.rs:120
fn jet_list_update_first_kernel<T>(xs: &[T], predicate: fn(&T) -> Bool, replacement: T) -> Bool {
    for index in 0..xs.len() {
        if predicate(&xs[index]) { xs[index] = ^replacement; return true }
    }
    false
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Iter.rs:138
pub fn jet_list_count_where_result_kernel<T, E>(xs: &[T], predicate: fn(&T) -> Bool E!) -> I64 E! {
    count: I64 := 0
    for item in xs { if predicate(item)? { count += 1 } }
    Ok(count)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Iter.rs:156
pub fn jet_list_update_first_result_kernel<T, E>(xs: &[T], predicate: fn(&T) -> Bool E!, replacement: T) -> Bool E! {
    for index in 0..xs.len() {
        if predicate(&xs[index])? { xs[index] = ^replacement; return Ok(true) }
    }
    Ok(false)
}

