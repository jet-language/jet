//RS     }
//RS     let (left_values, right_values) = collection_semantics::list_unzip_pairs(columns);
//RS     let left = heap.alloc_empty_list();
//RS     for value in left_values {
//RS         if jit_zip_push_column_value(heap, left, value).is_none() {
//RS             jet_foundation::ice!(None, "unzip column representation mismatch");
