//RS /// Packed Option ABI for `Option(Int)`: 0 = None, value+1 = Some. This is what
//RS /// `uses_result_option_abi`'s `_ => false` default assumes, so it is the carrier
//RS /// for every Option-returning host with no arm in that predicate. Sound only for
//RS /// payloads that are never `-1` (indices, lengths, arena handles).
//RS fn option_packed(value: Option<i64>) -> i64 {
//RS     match value {
//RS         Some(v) => v.wrapping_add(1),
//RS         None => 0,
//RS     }
//RS }
