//RS     error: jet_foundation::Outcome::AllocError,
//RS ) -> i64 {
//RS     let record = rt.heap.alloc_record(2);
//RS     let allocator = rt.heap.alloc_string(error.allocator);
//RS     let _ = rt.heap.record_set_int(record, 0, error.requested_bytes);
//RS     let _ = rt.heap.record_set_string(record, 1, allocator);
//RS     crate::runtime_host::alloc_jit_result(rt, false, record as u64)
//RS }
