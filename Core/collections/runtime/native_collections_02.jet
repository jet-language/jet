//RS /// Result-arena Option ABI: a 1-based `rt.results` handle carrying `(ok, bits)`.
//RS /// `LowerCtx::uses_result_option_abi` is the ONE fact that says which host
//RS /// answers this way, and it enumerates the ops explicitly. A host that reaches
//RS /// for this helper without an arm in that predicate hands a handle to a consumer
//RS /// that decodes it as `option_packed`, and a 1-based handle is never zero, so the
//RS /// miss reads as `Some(handle - 1)` — a wrong answer, never a refusal.
//RS fn option_i64(rt: &mut crate::JitRuntime, value: Option<i64>) -> i64 {
//RS     crate::runtime_host::alloc_jit_result(rt, value.is_some(), value.unwrap_or_default() as u64)
//RS }
//RS 
//RS pub(crate) fn alloc_error_result(
