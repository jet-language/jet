#Inline(Always)
fn jet_list_accel_column_copy_range_map<U,R>(range: Range<USize>, project: fn(USize) -> U Never!, copied_kernel: fn(View<U>,Range<USize>) -> [R] Never!) -> [R] Never! {
    start :: range.start
    end :: range.end
    element_bytes :: mem.size_of<U>().max(1)
    block_items :: (JET_LIST_ACCEL_CACHE_BLOCK_BYTES / element_bytes).max(1)
    result := [R].new()
    block_start := start
    while block_start < end {
        block_end :: block_start.saturating_add(block_items).min(end)
        column :: (block_start..<block_end).map(project).collect<[U]>()
        result.extend(copied_kernel(column,block_start..<block_end))
        block_start = block_end
    }
    ^result
}
