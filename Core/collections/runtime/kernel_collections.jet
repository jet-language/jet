fn jet_map_top_n<K: Ord + Clone,V: Ord + Clone>(m: [K:V],n: I64) -> [(K,V)] Never! {
    limit :: USize.try_from(n.max(0)).unwrap_or(USize.MAX).min(m.len())
    if limit == 0 -> return []
    rank :: fn((left_key,left_value),(right_key,right_value)) -> right_value.cmp(left_value).then_with(fn() -> left_key.cmp(right_key))
    best := [(K,V)].with_capacity(limit)
    loop (key,value) in m.iter() {
        if best.len() < limit {
            best.push((key.clone(),value.clone()))
            if best.len() == limit -> best.sort_by(rank)
            continue
        }
        worst :: best.len() - 1
        better :: value > best[worst].1 or (value == best[worst].1 and key < best[worst].0)
        if not better -> continue
        best[worst] = (key.clone(),value.clone())
        inserted := worst
        while inserted > 0 and rank(best[inserted],best[inserted - 1]).is_lt() {
            best.swap(inserted,inserted - 1)
            inserted -= 1
        }
    }
    ^best
}
