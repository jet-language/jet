// D-TIER-ONEIR1=A: target-neutral iterator cursor state and stepping.
use std.any.[Any]
use std.str as str
use std.iter.[Iterator]
use core.mem.runtime.portable_core.[jet_panic]

// Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:7
pub type JetLoopAny = Box<Any>
// Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:9
pub trait JetLoopItem {
    type Value
    type Error: Clone
    fn into_value(self) -> Self.Value Self.Error!
    fn error(self: &Self) -> Self.Error?
    fn exhausted_error() -> Self.Error
}
// Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:18
impl JetLoopAny.JetLoopItem {
    type Value = JetLoopAny
    type Error = String
    // Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:22
    fn into_value(self) -> JetLoopAny Err! { Ok(^self) }
    // Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:26
    fn error(self: &JetLoopAny) -> String? { .None }
    // Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:30
    fn exhausted_error() -> String { "iterator loop value requested after exhaustion" }
}
// Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:35
impl<T, E: Clone + From<String>> (T E!).JetLoopItem {
    type Value = T
    type Error = E
    // Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:42
    fn into_value(self) -> T E! { ^self }
    // Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:46
    fn error(self: &Self) -> E? { self.as_ref().err() }
    // Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:50
    fn exhausted_error() -> E { E.from("iterator loop value requested after exhaustion") }
}
// Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:55
pub struct JetLoopIterCursor<T = JetLoopAny, I = Box<Iterator<Item = T>>> {
    iter: I
    current: T?
    step: Usize
    exhausted: Bool
}
// Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:65
fn jet_loop_iter_step(step_value: I64, has_step: Bool) -> Usize Err! {
    step :: if has_step -> step_value else -> 1
    if step <= 0 -> return Err("iterator loop stride must be positive")
    Usize.try_from(step).map_err(fn(_) { "iterator loop stride is too large" })
}
// Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:73
pub fn jet_loop_iter_init_typed<T: JetLoopItem, I: Iterator<Item = T>>(iter: I, step_value: I64,
    has_step: Bool) -> JetLoopIterCursor<T, I> Err! {
    step :: jet_loop_iter_step(step_value, has_step)?
    current :: iter.next()
    exhausted :: current.is_none()
    Ok(JetLoopIterCursor { iter: ^iter, current: ^current, step, exhausted })
}
// Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:93
pub fn jet_loop_iter_typed_has_next<T: JetLoopItem, I: Iterator<Item = T>>(cursor: &JetLoopIterCursor<T, I>) -> Bool T.Error! {
    if cursor.current.as_ref() == .Val(item) {
        if item.error() == .Val(error) -> return Err(error.clone())
        return Ok(true)
    }
    Ok(false)
}
// Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:109
pub fn jet_loop_iter_typed_value<T: JetLoopItem, I: Iterator<Item = T>>(cursor: &JetLoopIterCursor<T, I>) -> T.Value T.Error! {
    cursor.current.take().ok_or_else(T.exhausted_error)?.into_value()
}
// Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:123
pub fn jet_loop_iter_typed_advance<T: JetLoopItem, I: Iterator<Item = T>>(cursor: &JetLoopIterCursor<T, I>) -> Unit T.Error! {
    if cursor.exhausted -> return Ok(())
    for _ in 1..cursor.step {
        item :: if cursor.iter.next() == {
            .Val(item) -> item
            .None -> {
                cursor.current = .None
                cursor.exhausted = true
                return Ok(())
            }
        }
        if item.error().is_some() {
            cursor.current = .None
            cursor.exhausted = true
            if item.into_value() == {
                .Err(error) -> return Err(error)
                .Ok(_) -> panic("iterator item reported an error but yielded a value")
            }
        }
    }
    cursor.current = cursor.iter.next()
    cursor.exhausted = cursor.current.is_none()
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:154
pub struct JetStringChars { bytes: [U8], offset: Usize }
impl JetStringChars {
    // Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:160
    pub fn new(value: String) -> JetStringChars { JetStringChars { bytes: value.into_bytes(), offset: 0 } }
}
impl JetStringChars.Iterator {
    type Item = Char
    // Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:171
    fn next(self: &JetStringChars) -> Char? {
        end :: self.offset.saturating_add(4).min(self.bytes.len())
        bytes :: self.bytes.get(self.offset..end)?
        tail :: if str.from_utf8(bytes) == {
            .Ok(tail) -> tail
            .Err(error) -> str.from_utf8(bytes[..error.valid_up_to()]).ok()?
        }
        value :: tail.chars().next()?
        self.offset += value.len_utf8()
        .Val(value)
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:184
fn jet_loop_iter_has_next(cursor: &JetLoopIterCursor) -> Bool {
    jet_loop_iter_typed_has_next(cursor).unwrap_or_else(fn(message) { jet_panic("<core.prelude>", 0, message) })
}
// Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:189
fn jet_loop_iter_value<T>(cursor: &JetLoopIterCursor) -> T {
    value :: jet_loop_iter_typed_value(cursor).unwrap_or_else(fn(message) { jet_panic("<core.prelude>", 0, message) })
    if value.downcast<T>() == {
        .Ok(value) -> value.take()
        .Err(_) -> jet_panic("<core.prelude>", 0, "iterator loop item type does not match MIR")
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/LoopCursor.rs:198
fn jet_loop_iter_advance(cursor: &JetLoopIterCursor) -> Unit {
    _ :: jet_loop_iter_typed_advance(cursor).unwrap_or_else(fn(message) { jet_panic("<core.prelude>", 0, message) })
}
