//RS 
//RS /// D-SOA-TIER1=A / D-SOA1: THE read that pulls one record out of a
//RS /// `#Layout(columnar)` list on the Cranelift tier.
//RS ///
//RS /// The tier holds a columnar list as its canonical logical rows. The arena owns
//RS /// that row representation, so this host reads the selected row directly
//RS /// instead of rebuilding a transient `JetColumns` store for every access. The
//RS /// shared fixed-list helper still owns bounds selection and wording; this host
//RS /// only maps its typed result onto the resident stop and record handle (I9).
//RS ///
//RS /// The cells remain in stored-field order, which is the same order the arena
//RS /// uses for the record slots. A gathered row is therefore allocated slot for
//RS /// slot, preserving the handle-generation and ownership behavior of the
//RS /// previous column-store adapter (I8: one numbering).
//RS ///
//RS /// The canonical row invariant is equal, non-zero width for a non-empty
//RS /// columnar record. Zero-width records retain the shared store's zero-row
//RS /// bounds behavior.
//RS ///
//RS /// This is deliberately a read-only view over the arena rows: mutations update
//RS /// those rows, and the next gather observes them without a second cache.
//RS fn jet_jit_columnar_gather(list: i64, idx: i64, line: u32) -> i64 {
//RS     Concurrency::with_runtime_mut(|rt| {
//RS         let Some(rows) = rt.heap.record_rows(list) else {
//RS             jet_foundation::ice!(None, "jit columnar gather: bad handle");
//RS         };
//RS         let width = rows.first().map_or(0, Vec::len);
//RS         debug_assert!(
//RS             rows.iter().all(|row| row.len() == width),
//RS             "columnar rows must have one cell per stored field"
//RS         );
//RS         // A transient column store used to rebuild every column on each read.
//RS         // The arena already owns the canonical row order, so keep the read on
//RS         // that representation and apply the shared fixed-list bounds policy
//RS         // directly. A zero-width record has no backing column and therefore
//RS         // retains the old zero-row bounds semantics.
//RS         let len = if width == 0 { 0 } else { rows.len() };
//RS         match jet_codegen::fixed_list::jet_fixed_list_index(len, idx, |row| {
//RS             rows[row][..width].to_vec()
//RS         }) {
//RS             Ok(cells) => rt.heap.alloc_record_cells(cells),
//RS             Err(error) => {
//RS                 rt.set_runtime_stop("E3010", line, &error.message());
//RS                 0
//RS             }
//RS         }
//RS     })
//RS }
//RS 
