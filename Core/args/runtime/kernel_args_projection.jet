// Rust: crates/jet-codegen/src/Prelude/Core/ArgsProjection.rs:10
pub fn jet_args_decode<T: __jet_Decode>(spec: &JetArgsSpec, argv: &[String], names: View<(String, String)>) -> T [FieldError]! {
    parsed :: jet_args_parse(spec, argv).map_err(fn(message) { FieldError.one(message) })?
    fields :: jet_args_shape_tree_values(spec, &parsed, names).map_err(fn(errors) {
        errors.flat_map(fn(error) {
            if error.path.is_empty() { FieldError.one(error.reason) } else { FieldError.at(error.path, error.reason) }
        })
    })?
    fields :: fields.map(fn((name, value)) { (name, jet_args_shape_value_to_datatree(value)) })
    T.jet_decode(&DataTree.Object(fields))
}
// Rust: crates/jet-codegen/src/Prelude/Core/ArgsProjection.rs:35
fn jet_args_shape_value_to_datatree(value: JetArgsShapeValue) -> DataTree {
    match value {
        .Bool(value) -> DataTree.Bool(value)
        .Int(value) -> DataTree.Int(value)
        .Float(value) -> DataTree.Float(value)
        .Text(value) -> DataTree.Text(value)
        .Array(values) -> DataTree.Array(values.map(jet_args_shape_value_to_datatree))
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/ArgsProjection.rs:56
pub fn jet_config_merge<T: __jet_Encode + __jet_Decode>(spec: &JetArgsSpec, argv: &[String], names: View<(String, String)>, flags: &T, settings: &T) -> T [FieldError]! {
    flag_fields :: match flags.jet_encode() {
        .Object(fields) -> fields
        _ -> return Err(FieldError.one("flags layer is not a record"))
    }
    settings_fields :: match settings.jet_encode() {
        .Object(fields) -> fields
        _ -> return Err(FieldError.one("settings layer is not a record"))
    }
    fields :: jet_args_merge_fields(spec, argv, names, flag_fields, settings_fields).map_err(fn(errors) {
        errors.flat_map(fn(error) {
            if error.path.is_empty() { FieldError.one(error.reason) } else { FieldError.at(error.path, error.reason) }
        })
    })?
    T.jet_decode(&DataTree.Object(fields))
}
// Rust: crates/jet-codegen/src/Prelude/Core/ArgsProjection.rs:86
struct JetGuidedTuiModel {
    label: String
    value: String
    cursor: Int
    width: Int
    error: String?
    done: Bool
}
// Rust: crates/jet-codegen/src/Prelude/Core/ArgsProjection.rs:95
enum JetGuidedTuiMessage {
    Key(code: String, modifiers: U8)
    Resize(size: JetSize)
    Reset(value: String, error: String?)
}
// Rust: crates/jet-codegen/src/Prelude/Core/ArgsProjection.rs:104
fn jet_guided_tui_update(model: JetGuidedTuiModel, message: JetGuidedTuiMessage) -> (JetGuidedTuiModel, JetTuiCommand<JetGuidedTuiMessage>) {
    model := model
    match message {
        .Reset(value, error) -> {
            model.value = value
            model.cursor = model.value.chars().count()
            model.error = error
            model.done = false
        }
        .Resize(size) -> model.width = size.width.max(1.0).floor() as Int
        .Key(code, modifiers) -> {
            if (modifiers & 1) != 0 {
                match code {
                    "c" -> { model.error = Val("guided input cancelled"); model.done = true }
                    "u" -> { model.value.clear(); model.cursor = 0 }
                    _ -> {}
                }
            } else {
                match code {
                    "enter" -> model.done = true
                    "escape" -> { model.error = Val("guided input cancelled"); model.done = true }
                    "left" -> model.cursor = (model.cursor - 1).max(0)
                    "right" -> model.cursor = (model.cursor + 1).min(model.value.chars().count())
                    "backspace" -> {
                        if model.cursor > 0 {
                            chars := model.value.chars().collect()
                            chars.remove(model.cursor - 1)
                            model.value = chars.collect_string()
                            model.cursor -= 1
                        }
                    }
                    "delete" -> {
                        chars := model.value.chars().collect()
                        if model.cursor < chars.len() {
                            chars.remove(model.cursor)
                            model.value = chars.collect_string()
                        }
                    }
                    "up" | "down" | "tab" | "unknown" -> {}
                    _ if not code.is_empty() -> {
                        chars := model.value.chars().collect()
                        inserted :: code.chars().collect()
                        chars.splice(model.cursor..model.cursor, inserted.iter().copied())
                        model.value = chars.collect_string()
                        model.cursor += inserted.len()
                    }
                    _ -> {}
                }
            }
            if not model.done && code != "enter" && code != "escape" { model.error = None }
        }
    }
    (model, JetTuiCommand<JetGuidedTuiMessage>.none())
}
// Rust: crates/jet-codegen/src/Prelude/Core/ArgsProjection.rs:176
fn jet_guided_visible_input(model: &JetGuidedTuiModel) -> String {
    chars :: model.value.chars().collect()
    cursor :: model.cursor.min(chars.len())
    width :: (model.width.max(8) - 1).max(0)
    start :: (cursor - (width - 1).max(0)).max(0).min((chars.len() - width).max(0))
    end :: (start + width).min(chars.len())
    visible := chars[start..end].iter().copied().collect_string()
    caret :: (cursor - start).max(0)
    caret_byte :: visible.char_indices().nth(caret).map(fn((index, _)) { index }) ?? visible.len()
    visible.insert(caret_byte, '▏')
    visible
}
// Rust: crates/jet-codegen/src/Prelude/Core/ArgsProjection.rs:194
fn jet_guided_tui_view(model: &JetGuidedTuiModel) -> JetUiNode {
    children := [jet_ui_text(model.label), jet_ui_text_input(jet_guided_visible_input(model), JetUiImeMode.Native)]
    if model.error is Val(error) { children.push(jet_ui_text("Correction: {error}")) }
    jet_ui_box(children)
}
// Rust: crates/jet-codegen/src/Prelude/Core/ArgsProjection.rs:205
fn jet_guided_tui_frame(program: &JetTuiProgram<JetGuidedTuiModel, JetGuidedTuiMessage, fn(JetGuidedTuiModel, JetGuidedTuiMessage) -> (JetGuidedTuiModel, JetTuiCommand<JetGuidedTuiMessage>), fn(&JetGuidedTuiModel) -> JetUiNode>) -> Err! {
    frame :: program.frame_lines().join(" | ")
    jet_term_write_stderr("\r\x1b[2K{frame}", true).map_err(fn(error) { "guided prompt output failed: {error}" })
}
// Rust: crates/jet-codegen/src/Prelude/Core/ArgsProjection.rs:221
fn jet_args_guided_tui_prompt(field: &JetGuidedField, initial: String, error: String?) -> String Err! {
    label :: if field.help.is_empty() { "Page {field.page + 1} · {field.name}:" } else {
        "Page {field.page + 1} · {field.name} — {field.help}:"
    }
    // GATE #4565: kernel primitive — read actual process environment.
    width :: jet_term_width(fn(name) { #Unsafe("read the named environment value") { env.var(name).ok() } }).max(1) as Int
    model :: JetGuidedTuiModel{label: label, value: initial.to_string(), cursor: initial.chars().count(),
        width: width, error: error.map(fn(text) { text.to_string() }), done: false}
    update :: jet_guided_tui_update
    view :: jet_guided_tui_view
    program := JetTuiProgram.new(model, update, view)
    program.set_constraint(jet_ui_constraint(0.0, 0.0,
        jet_term_width(fn(name) { #Unsafe("read terminal width environment") { env.var(name).ok() } }) as Float,
        jet_term_height(fn(name) { #Unsafe("read terminal height environment") { env.var(name).ok() } }).min(8) as Float))
    program.set_event_mapper(fn(event) {
        match event {
            .Key(code, modifiers) -> Val(JetGuidedTuiMessage.Key(code, modifiers))
            .Resize(size) -> Val(JetGuidedTuiMessage.Resize(size))
            .Interrupt | .Close -> Val(JetGuidedTuiMessage.Key("escape", 0))
            .Timer(..) | .IO(..) | .Focus(..) -> None
        }
    })
    program.redraw()
    jet_guided_tui_frame(&program)?
    jet_term_enter()
    _resize :: program.dispatch_event(JetTuiEvent.resize(width as Float,
        jet_term_height(fn(name) { #Unsafe("read terminal height environment") { env.var(name).ok() } }) as Float))
    program.step()
    loop {
        key :: jet_term_read_key()
        if key is .Unknown {
            jet_term_leave()
            return Err("guided input ended before the form was submitted")
        }
        event :: JetTuiEvent.key_with_modifiers(key.code(), key.modifier_bits())
        program.dispatch_event(event)
        program.step()
        if jet_guided_tui_frame(&program) is Err(error) { jet_term_leave(); return Err(error) }
        model :: program.model() ?? {
            jet_term_leave()
            return Err("guided input model stopped unexpectedly")
        }
        if model.done {
            result :: match model.error.clone() { Val(error) -> Err(error), None -> Ok(model.value.clone()) }
            jet_term_leave()
            jet_term_write_stderr("\n", true).map_err(fn(output_error) { "guided prompt output failed: {output_error}" })?
            return result
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/ArgsProjection.rs:304
fn jet_args_guided_line_prompt(field: &JetGuidedField, initial: String, error: String?) -> String Err! {
    prompt := if field.help.is_empty() { "{field.name}:" } else { "{field.name} — {field.help}:" }
    if not initial.is_empty() { prompt.push_str(" [{initial}]") }
    if error is Val(error) { prompt.push_str(" Correction: {error}") }
    prompt.push(' ')
    jet_term_write_stderr(prompt, true).map_err(fn(output_error) { "guided prompt output failed: {output_error}" })?
    match jet_term_read_stdin_line().map_err(fn(error) { error.to_string() })? {
        .Line(value) -> Ok(value)
        .EndOfInput -> Err("guided input ended before the form was submitted")
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/ArgsProjection.rs:331
fn jet_args_guided_interactive() -> Bool {
    jet_term_stdin_is_terminal() && jet_term_stderr_is_terminal() && not jet_term_machine_output() &&
        // GATE #4565: kernel primitive
        #Unsafe("query actual CI environment presence") { env.var_os("CI").is_none() }
}
// Rust: crates/jet-codegen/src/Prelude/Core/ArgsProjection.rs:338
fn jet_args_guided_accessible() -> Bool {
    // GATE #4565: kernel primitive
    #Unsafe("query actual accessibility and terminal environment facts") {
        env.var_os("NO_COLOR").is_some() || env.var_os("JET_ACCESSIBLE").is_some() ||
            env.var_os("JET_CLI_ACCESSIBLE").is_some() || env.var("TERM").ok().is_some_and(fn(term) { term.eq_ignore_ascii_case("dumb") })
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/ArgsProjection.rs:347
pub fn jet_args_guided_argv_tui(spec: &JetArgsSpec, argv: &[String]) -> [String] Err! {
    if not jet_args_guided_interactive() -> return Ok(argv.clone())
    if jet_args_guided_accessible() { jet_args_guided_argv_with(spec, argv, jet_args_guided_line_prompt) } else {
        jet_args_guided_argv_with(spec, argv, jet_args_guided_tui_prompt)
    }
}
