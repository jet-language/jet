package: {
    name: "core.tasks"
    version: "0.0.1"
    edition: "2026"
    description: "Tasks, timers, the running task's identity and CPU clock."
    license: "MIT"
    outputs: {
        tasks: .Library{ entry: tasks }
    }
}
use {
    core: core
    time: core.time
    rt: jet.runtime.time
}

// Timer creation and scheduler identity are host cells. Scheduler channels
// and task groups use language primitives; TaskState transitions are pure Jet.
// Sleeping uses core.time.sleep. A function that waits, or reads the
// monotonic clock for a timer's deadline, names the waiting leaf `Time.Wait`.
after: fn<T>(delay: time.Duration, value: T) -[Time.Wait]> Receiver<T> Never! {
    core.tasks.after(delay, value)
}

interval: fn(period: time.Duration) -[Time.Wait]> Receiver<Int> Never! {
    core.tasks.__interval_ms(interval_milliseconds(period))
}

interval_milliseconds: fn(period: time.Duration) -> Int Never! {
    milliseconds: period.ns /% 1000000
    if milliseconds < 1 -> return 1
    milliseconds
}

// These functions back compiler-private channel rows, not new public API.
scheduler: module {
    use core: core

    channel: fn<T>() -> (sender: Sender<T>, receiver: Receiver<T>) Never! {
        pair: core.tasks.__channel_new<T>()
        (sender: pair.sender, receiver: pair.receiver)
    }

    #Test("scheduler channel preserves its named sender and receiver") {
        pair: channel<Int>()
        __test_send(pair.sender, 41) ?? panic("channel closed")
        assert_eq(pair.receiver.receive() ?? panic("channel closed"), 41)
        pair.sender.close()
    }

    bounded: fn<T>(capacity: Int) -> (sender: Sender<T>, receiver: Receiver<T>) Never! {
        limit: if capacity < 1 -> 1 else -> capacity
        pair: core.tasks.__channel_bounded<T>(limit)
        (sender: pair.sender, receiver: pair.receiver)
    }

    #Test("scheduler bounded channel preserves its named sender and receiver") {
        pair: bounded<Int>(0)
        __test_send(pair.sender, 42) ?? panic("bounded channel closed")
        assert_eq(pair.receiver.receive() ?? panic("bounded channel closed"), 42)
        pair.sender.close()
    }

    // A test's send; the test holds the receiver, so a refusal is its bug.
    __test_send: fn(sender: Sender<Int>, value: Int) Err! {
        sender.send(value)
    }
}

impl Condition {
    notify_one: fn(self) Never! { core.tasks.__condition_notify_one(self) }
    notify_all: fn(self) Never! { core.tasks.__condition_notify_all(self) }
}

yield_now: fn() Never! -[Time.Wait]> { host_yield() }

/// The running task's identity. Two reads by one task are equal and differ
/// from every other running task's; a finished task's identity can be reused.
/// Outside a scheduled task it identifies the calling thread.
TaskID: struct {
    priv value: Int

    impl Display {
        display: fn(self) -> String { "task {self.value}" }
    }
}

current_task: fn() -> TaskID Never! { TaskID{value: core.tasks.__task_identity()} }

/// Runs one piece of work at most once across every task that shares the Once
/// (pthread_once, call_once); copies share one state. A caller that arrives
/// while the work runs waits for it to finish, so after `call` returns the work
/// has run.
Once: struct {
    priv done: Shared<Bool>

    new: fn() -> Once Never! { {done: Shared{false}} }

    /// Runs `work` unless this Once has already run it; true when this call
    /// ran it. The work must not call the same Once.
    call: fn(self, work: fn()) -> Bool Never! {
        guard := self.done.guard_edit()
        if guard.value -> return false
        work()
        guard.value = true
        true
    }

    /// Whether the work has run.
    is_done: fn(self) -> Bool Never! {
        guard: self.done.guard_read()
        guard.value
    }
}

/// A counting semaphore shared by every task that holds a copy (sem_init,
/// sem_wait, sem_trywait, sem_post, sem_getvalue). `acquire` takes a unit,
/// waiting for one when none is free; `release` returns one and wakes one
/// waiter.
Semaphore: struct {
    priv count: Shared<Int>
    priv changed: Condition

    /// A semaphore holding `count` units (none when `count` is negative).
    new: fn(count: Int) -> Semaphore Never! {
        {count: Shared{if count < 0 -> 0 else -> count}, changed: Condition.new()}
    }

    /// Takes a unit, waiting until one is free; false when the wait ends
    /// without one, as when the task is cancelled.
    acquire: fn(self) -[Time.Wait]> Bool Never! {
        guard := self.count.guard_edit()
        guard.wait(self.changed, fn(units) { units > 0 }) ?? return false
        guard.value -= 1
        true
    }

    /// Takes a unit when one is free, without waiting.
    try_acquire: fn(self) -> Bool Never! {
        guard := self.count.guard_edit()
        if guard.value <= 0 -> return false
        guard.value -= 1
        true
    }

    /// Returns a unit and wakes one waiting `acquire`.
    release: fn(self) Never! {
        guard := self.count.guard_edit()
        guard.value += 1
        self.changed.notify_one()
    }

    /// The free units now; another task may change it at once.
    value: fn(self) -> Int Never! {
        guard: self.count.guard_read()
        guard.value
    }
}

/// The CPU time the running task has used, in nanoseconds. A task's clock
/// counts only the time it ran, on whichever carrier threads ran it, and
/// stands still while it is parked; on a plain thread it is the thread's CPU
/// time. Only the difference of two reads by the same task means anything.
/// A deterministic world has no CPU clock to control, so it rejects the read.
cpu_ns: fn() -[Time]> Int Never! {
    rt.reject_uncontrolled("task CPU clock")
    core.tasks.__task_cpu_ns()
}

/// Receive from a scheduler channel: the next value, or None once the
/// channel is closed and drained.
recv: fn<T>(rx: Receiver<T>) -[Time.Wait]> T? Never! {
    value: rx.receive() ?? return None
    Val(value)
}

/// Blocking receive spellings used by queue/future adapters.
get: fn<T>(rx: Receiver<T>) -[Time.Wait]> T? Never! { recv(rx) }

result: fn<T>(rx: Receiver<T>) -[Time.Wait]> T? Never! { recv(rx) }

wait: fn<T>(rx: Receiver<T>) -[Time.Wait]> T? Never! { recv(rx) }

/// One receive per receiver, in order; None where a channel closed drained.
waitall: fn<T>(receivers: [Receiver<T>]) -[Time.Wait]> [T?] Never! {
    out := [T?]{}
    loop rx in receivers -> out.push(recv(rx))
    out
}

/// The index of the receiver that answered and its value (None when that
/// channel closed drained). The list must not be empty.
waitany: fn<T>(receivers: [Receiver<T>]) -[Time.Wait]> (index: Int, value: T?) Never! {
    if receivers.len() == 0 -> panic("waitany needs at least one receiver")
    // Receiver readiness is owned by the scheduler's opaque handle. This
    // convenience rail keeps the deterministic first-arm selection; callers
    // needing a true race should use the host select surface.
    (index: 0, value: recv(receivers[0]))
}


host_sleep_ms: fn(ms: Int) -[Time.Wait]> {
    _: recv(core.tasks.after(Duration.milliseconds(ms) ?? panic("sleep duration is outside Duration's range"), 0))
}


host_yield: fn() -[Time.Wait]> { core.tasks.__yield_now() }

/// Joins the scheduler's carrier and timer threads, the safe step before a
/// raw exec or fork that needs a single-threaded process. False, with nothing
/// stopped, while a task or a timer is still pending. The threads start again
/// on the next task or timer.
quiesce: fn() -[Exec]> Bool Never! { core.tasks.__quiesce() }
/// Receiver metadata is owned by the scheduler's typed handle.
is_timer: fn<T>(rx: Receiver<T>) -> Bool Never! { rx.is_timer() }

is_interval: fn<T>(rx: Receiver<T>) -> Bool Never! { rx.is_interval() }

is_cancelled: fn<T>(rx: Receiver<T>) -> Bool Never! { rx.is_cancelled() }

is_ready: fn<T>(rx: Receiver<T>) -> Bool Never! { rx.is_ready() }

delay_ms: fn<T>(rx: Receiver<T>) -> Int Never! { rx.delay_ms() }

timeout: fn(delay: time.Duration) Never! -[Time.Wait]> {
    _: recv(core.tasks.after(delay, 0))
}

sleep: fn(ms: Int) Never! -[Time.Wait]> {
    delay := ms
    if delay < 0 -> delay = 0
    host_sleep_ms(delay)
}

try_recv: fn<T>(rx: Receiver<T>) -> T? Never! { rx.try_receive() }

/// Closing the receiver wakes blocked consumers and is the host cancellation
/// operation. The returned handle remains usable for identity/ownership.
cancel: fn<T>(rx: Receiver<T>) -[Time]> Receiver<T> Never! {
    rx.close()
    rx.copy()
}

TaskState: struct {
    values: [Int]
    capacity: Int
    closed: Bool
    locked: Bool
    generation: Int
}

// Pure value-state transitions; these are separate from scheduler.channel<T>.
channel: fn(capacity: Int) -> TaskState Never! {
    cap := capacity
    if cap < 0 -> cap = 0
    TaskState{values: [Int]{}, capacity: cap, closed: false, locked: false, generation: 0}
}

put: fn(state: TaskState, value: Int) -> TaskState Never! {
    if state.closed -> return state.copy()
    if state.capacity > 0 && state.values.len() >= state.capacity -> return state.copy()
    values := state.values.copy()
    values.push(value)
    TaskState{
        values: values,
        capacity: state.capacity,
        closed: state.closed,
        locked: state.locked,
        generation: state.generation + 1,
    }
}

clear: fn(state: TaskState) -> TaskState Never! {
    if state.values.len() == 0 -> return state.copy()
    TaskState{values: [Int]{}, capacity: state.capacity, closed: state.closed, locked: state.locked, generation: state.generation + 1}
}

shutdown: fn(state: TaskState) -> TaskState Never! {
    if state.closed -> return state.copy()
    TaskState{values: state.values.copy(), capacity: state.capacity, closed: true, locked: state.locked, generation: state.generation + 1}
}

stop: fn(state: TaskState) -> TaskState Never! { shutdown(state) }

reset: fn(state: TaskState) -> TaskState Never! {
    TaskState{values: [Int]{}, capacity: state.capacity, closed: false, locked: false, generation: state.generation + 1}
}

lock: fn() -> TaskState Never! { channel(1) }

acquire: fn(state: TaskState) -> TaskState Never! {
    if state.closed || state.locked -> return state.copy()
    TaskState{values: state.values.copy(), capacity: state.capacity, closed: state.closed, locked: true, generation: state.generation + 1}
}

release: fn(state: TaskState) -> TaskState Never! {
    if !state.locked -> return state.copy()
    TaskState{values: state.values.copy(), capacity: state.capacity, closed: state.closed, locked: false, generation: state.generation + 1}
}

notify: fn(state: TaskState) -> TaskState Never! {
    TaskState{values: state.values.copy(), capacity: state.capacity, closed: state.closed, locked: state.locked, generation: state.generation + 1}
}

start: fn<T>(rx: Receiver<T>) -> Receiver<T> Never! { rx.copy() }

run: fn() Never! -[Time.Wait]> { yield_now() }

is_closed: fn(state: TaskState) -> Bool Never! { state.closed }
is_locked: fn(state: TaskState) -> Bool Never! { state.locked }
size: fn(state: TaskState) -> Int Never! { state.values.len() }
capacity: fn(state: TaskState) -> Int Never! { state.capacity }
generation: fn(state: TaskState) -> Int Never! { state.generation }

spawn_name: fn(name: String) -> String Never! {
    name.copy()
}



#Test("a Once runs its work once, however many tasks call it") {
    once: Once.new()
    hits: Shared{0}
    // copy: the work's handle to the same cell, which the test reads after
    counter: hits.copy()
    assert(!once.is_done())
    assert(once.call(fn() {
        guard := counter.guard_edit()
        guard.value += 1
    }))
    assert(!once.call(fn() { panic("a done Once ran its work again") }))
    assert(once.is_done())
    counted: hits.guard_read()
    assert_eq(counted.value, 1)
    shared: Once.new()
    task.group callers {
        first: task shared.call(fn() {})
        second: task shared.call(fn() {})
        assert((first.join() ?? false) != (second.join() ?? false))
    }
    assert(shared.is_done())
}

#Test("a Semaphore hands out its units and wakes a waiting acquire") {
    units: Semaphore.new(1)
    assert(units.try_acquire())
    assert(!units.try_acquire())
    task.group waiters {
        waiter: task units.acquire()
        units.release()
        assert(waiter.join() ?? false)
    }
    assert_eq(units.value(), 0)
    units.release()
    units.release()
    assert_eq(units.value(), 2)
    assert_eq(Semaphore.new(-3).value(), 0)
}

#Test("a task's identity is stable and differs from another running task's") {
    mine: current_task()
    assert_eq(mine, current_task())
    other: task current_task()
    theirs: other.join() ?? panic("identity task failed")
    assert(mine != theirs)
    seven: TaskID{value: 7}
    assert_eq(seven.display(), "task 7")
    seen := [TaskID: Bool]{}
    seen[mine] = true
    assert(seen.get(current_task()) != None && seen.get(theirs) == None)
}

#Test("the task CPU clock advances while the task computes") {
    before: cpu_ns()
    total := 0
    loop n in 0..<3000000 -> total += n % 7
    assert(total > 0)
    assert(cpu_ns() - before > 0)
}

#Test("interval periods truncate whole milliseconds and never spin at zero") {
    assert_eq(interval_milliseconds(time.Duration{ns: -1000000}), 1)
    assert_eq(interval_milliseconds(time.Duration{ns: 0}), 1)
    assert_eq(interval_milliseconds(time.Duration{ns: 999999}), 1)
    assert_eq(interval_milliseconds(time.Duration{ns: 1999999}), 1)
    assert_eq(interval_milliseconds(time.Duration{ns: 2000000}), 2)
}

#Test("task value channels preserve the source value and reject full or closed writes") {
    initial: channel(1)
    written: put(initial, 7)
    assert_eq(size(initial), 0)
    assert_eq(size(written), 1)
    assert_eq(generation(written), 1)
    full: put(written, 8)
    assert_eq(full.values, [Int]{7})
    assert_eq(generation(full), 1)
    closed: shutdown(written)
    assert_eq(is_closed(closed), true)
    assert_eq(generation(stop(closed)), generation(closed))
    assert_eq(generation(put(closed, 9)), generation(closed))
    emptied: clear(written)
    assert_eq(size(emptied), 0)
    assert_eq(generation(emptied), 2)
    assert_eq(generation(clear(emptied)), 2)
    assert_eq(capacity(channel(-1)), 0)
}

#Test("task lock transitions advance generations only for changes or notifications") {
    initial: lock()
    held: acquire(initial)
    assert_eq(is_locked(initial), false)
    assert_eq(is_locked(held), true)
    assert_eq(generation(held), 1)
    assert_eq(generation(acquire(held)), 1)
    released: release(held)
    assert_eq(is_locked(released), false)
    assert_eq(generation(released), 2)
    assert_eq(generation(release(released)), 2)
    signalled: notify(held)
    assert_eq(is_locked(signalled), true)
    assert_eq(generation(signalled), 2)
    restarted: reset(shutdown(signalled))
    assert_eq(is_closed(restarted), false)
    assert_eq(is_locked(restarted), false)
    assert_eq(size(restarted), 0)
    assert_eq(capacity(restarted), 1)
    assert_eq(generation(restarted), 4)
}
