// core.meta — the metadata of a module and of its package.
//
// Every module has a Module value and every package a Package value; the
// compiler fills them while building. A module body's first lines may set
// the fields that have defaults (`category: "billing"`), and `pricing.category`
// reads one. Reading a field needs no import; naming the type does
// (`use core.meta.[Module]`). Every field is known while building, so a
// program carries only the fields its code reads.

/// A module's or declaration's maturity: the `maturity` field line here and
/// the `#Meta(maturity: …)` closed set.
Maturity: enum {
    Experimental
    Tested
    Hardened
}

/// A module's metadata. `name`, `file`, `doc` and `package` are set by the
/// compiler; `maturity`, `category` and `deprecated` are the module's to set
/// in its body's field lines.
Module: struct {
    /// The module's name.
    name: String
    /// Its file, from the package root.
    file: String
    /// The `///` comment above it, or "".
    doc: String
    /// The package that owns it.
    package: Package
    maturity: Maturity{.Tested}
    /// A group name for docs and tools.
    category: String{""}
    /// Set, every use from another module warns.
    deprecated: Deprecated?{None}
}

/// A retired module: since which version, and what to use instead. Uses from
/// another module warn; the build never fails on them.
Deprecated: struct {
    since: String
    use: String
    removed_in: String?{None}
}

/// A package's metadata: its package.jet fields. A dependency's Package is
/// read-only to the code that reads it.
Package: struct {
    name: String
    version: String{"0.0.0"}
    description: String?{None}
    license: String?{None}
    authors: [String]{[String]{}}
    edition: String?{None}
    repository: String?{None}
    // The optional Jet self-toolchain pin.
    jet: String?{None}
    source: String?{None}
    // The `log:` core.log level filter.
    log: String?{None}
}
