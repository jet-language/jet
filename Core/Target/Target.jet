// The machines a build can target. A target is a struct with no fields that
// implements `Machine`; its one constant, `facts`, says what the machine is
// (triple, operating system, layout, CPU features) and which services it
// provides. A service the machine lacks is absent, and each absent service
// denies the effect that needs it: `row` derives that denial row, the one
// the compiler checks every artifact built for the machine against.

// The operating system a machine runs code under.
MachineOS: enum {
    Linux
    MacOS
    Windows
    // A browser page: WebAssembly with the browser's APIs.
    Web
    // WebAssembly without a browser.
    Wasm
    // No operating system: the program is the machine's only code.
    Freestanding
}

// The byte order of a machine's words.
MachineEndian: enum {
    Little
    Big
}

// The sizes a machine's code is laid out with, in bits for values and in
// bytes for the cache line.
MachineLayout: struct {
    pointer_bits: Int
    word_bits: Int
    // The bytes one cache line holds, the unit `#Layout(c, align(…))` pads to.
    cache_line: Int
    endian: MachineEndian{.Little}
    // The widest value one atomic instruction reads or writes.
    atomic_bits: Int
}

// What a panic does on a machine.
MachinePanic: enum {
    // It reports the panic and stops the program.
    Report
    // It stops the machine at once, reporting nothing.
    Abort
    // Code built for the machine cannot panic.
    Denied
}

// The facts of one machine. Each service is the provider that implements it,
// or None when the machine lacks it.
MachineFacts: struct {
    triple: String
    os: MachineOS
    layout: MachineLayout
    // The CPU features every CPU of the machine has, so code built for it
    // uses them without probing.
    cpu_features: [String]{[String]{}}
    // The heap. None means code built for the machine cannot allocate.
    allocator: String?
    panic: MachinePanic
    // Where `print` and the standard streams write.
    byte_sink: String?{None}
    wall_clock: String?{None}
    monotonic_clock: String?{None}
    sleep: String?{None}
    entropy: String?{None}
    sockets: String?{None}
    files: String?{None}
    processes: String?{None}
    env: String?{None}
    // The page's DOM, storage and JavaScript bridge.
    browser: String?{None}
    gpu: String?{None}
    // The C calling convention to foreign code.
    ffi: String?{None}

    // The effects every artifact built for the machine is denied, one for
    // each service it lacks, in the order the effect roots are declared.
    row: fn(self) -> [String] {
        denied := [String]{}
        if self.sockets == None -> denied.push("!Net")
        if self.files == None -> denied.push("!FS")
        if self.byte_sink == None -> denied.push("!IO")
        if self.wall_clock == None && self.monotonic_clock == None {
            denied.push("!Time")
        } else if self.sleep == None {
            denied.push("!Time.Wait")
        }
        if self.entropy == None -> denied.push("!Rand")
        if self.env == None -> denied.push("!Env")
        if self.processes == None -> denied.push("!Exec")
        if self.gpu == None -> denied.push("!GPU")
        if self.ffi == None {
            // The browser carries the JavaScript bridge, so a page lacks only
            // the C side of foreign calls.
            if self.browser == None -> denied.push("!FFI") else -> denied.push("!FFI.C")
        }
        if self.browser == None -> denied.push("!Browser")
        if self.panic == .Denied -> denied.push("!Panic")
        if self.allocator == None -> denied.push("!Mem.Alloc")
        denied
    }
}

// A machine a build can target: a struct with no fields whose `facts` say
// what the machine is and provides.
Machine: trait {
    facts: MachineFacts
}

// A 64-bit x86 Linux host. Core's terminal and headless UI backends run
// under `Browser`, so a host provides it through `core.ui`.
LinuxX64: struct {
    impl Machine {
        facts: MachineFacts{
            triple: "x86_64-unknown-linux-gnu",
            os: .Linux,
            layout: MachineLayout{pointer_bits: 64, word_bits: 64, cache_line: 64, atomic_bits: 64},
            cpu_features: ["sse2"],
            allocator: "system",
            panic: .Report,
            byte_sink: "stdio",
            wall_clock: "clock_gettime",
            monotonic_clock: "clock_gettime",
            sleep: "nanosleep",
            entropy: "getrandom",
            sockets: "bsd_sockets",
            files: "posix",
            processes: "posix_spawn",
            env: "environ",
            browser: "core.ui",
            gpu: "vulkan",
            ffi: "c",
        }
    }
}

// A 64-bit Arm macOS host. Apple's cores fetch 128-byte cache lines.
MacOSArm64: struct {
    impl Machine {
        facts: MachineFacts{
            triple: "aarch64-apple-darwin",
            os: .MacOS,
            layout: MachineLayout{pointer_bits: 64, word_bits: 64, cache_line: 128, atomic_bits: 64},
            cpu_features: ["neon"],
            allocator: "system",
            panic: .Report,
            byte_sink: "stdio",
            wall_clock: "clock_gettime",
            monotonic_clock: "mach_absolute_time",
            sleep: "nanosleep",
            entropy: "getentropy",
            sockets: "bsd_sockets",
            files: "posix",
            processes: "posix_spawn",
            env: "environ",
            browser: "core.ui",
            gpu: "metal",
            ffi: "c",
        }
    }
}

// A 64-bit x86 Windows host.
WindowsX64: struct {
    impl Machine {
        facts: MachineFacts{
            triple: "x86_64-pc-windows-msvc",
            os: .Windows,
            layout: MachineLayout{pointer_bits: 64, word_bits: 64, cache_line: 64, atomic_bits: 64},
            cpu_features: ["sse2"],
            allocator: "heap_alloc",
            panic: .Report,
            byte_sink: "console",
            wall_clock: "system_time",
            monotonic_clock: "query_performance_counter",
            sleep: "sleep_ex",
            entropy: "bcrypt_gen_random",
            sockets: "winsock",
            files: "win32",
            processes: "create_process",
            env: "environment_block",
            browser: "core.ui",
            gpu: "direct3d",
            ffi: "c",
        }
    }
}

// A web build: 32-bit WebAssembly with its JavaScript host. The host reads
// files and the environment where it runs under Node and fetches assets in a
// page; it starts no processes and reaches foreign code only through
// JavaScript.
Web: struct {
    impl Machine {
        facts: MachineFacts{
            triple: "wasm32-unknown-unknown",
            os: .Web,
            layout: MachineLayout{pointer_bits: 32, word_bits: 32, cache_line: 64, atomic_bits: 64},
            allocator: "wasm_memory",
            panic: .Report,
            byte_sink: "console",
            wall_clock: "date",
            monotonic_clock: "performance",
            sleep: "timers",
            entropy: "crypto",
            sockets: "fetch",
            files: "web_host",
            env: "web_host",
            browser: "dom",
            gpu: "webgpu",
        }
    }
}

// A GPU running compute kernels: no heap, no host services, and no way to
// report a panic.
GPU: struct {
    impl Machine {
        facts: MachineFacts{
            triple: "spirv64-unknown-unknown",
            os: .Freestanding,
            layout: MachineLayout{pointer_bits: 64, word_bits: 32, cache_line: 128, atomic_bits: 64},
            allocator: None,
            panic: .Denied,
            gpu: "device",
        }
    }
}
