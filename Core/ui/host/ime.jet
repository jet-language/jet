use core as core
use core.ui.host.[UIHostError, UINodeID, UITextRange]

// core.ui.host.ime — typed input-method editor events.
enum UIIMEPhase {
    Start
    Update
    Commit
    Cancel
}

struct UIIMEComposition {
    text: String
    selection: UITextRange
    marked: UITextRange?
}

struct UIIMEEvent {
    target: UINodeID
    phase: UIIMEPhase
    composition: UIIMEComposition?
}

fn poll() -[IO]> UIIMEEvent? UIHostError! {
    #Unsafe("Core IME consumes one typed event from the current retained provider queue") {
        core.ui.host.ime.__poll()
    }
}
