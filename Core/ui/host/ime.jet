use core as core
use core.ui.host.[UiHostError, UiNodeId, UiTextRange]

// core.ui.host.ime — typed input-method editor events.
pub enum UiImePhase {
    Start
    Update
    Commit
    Cancel
}

pub struct UiImeComposition {
    pub text: String
    pub selection: UiTextRange
    pub marked: ?UiTextRange
}

pub struct UiImeEvent {
    pub target: UiNodeId
    pub phase: UiImePhase
    pub composition: ?UiImeComposition
}

pub fn poll() -[IO]> ?UiImeEvent !UiHostError {
    core.ui.host.ime.poll()
}
