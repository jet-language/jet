use core as core
use core.ui.host.[UIGrantedPath, UIHostError, UINodeID]

// core.ui.host.drag_drop — typed file/text drop events.
enum UIDragPhase {
    Enter
    Over
    Drop
    Leave
    Cancel
}

enum UIDragOperation {
    Copy
    Move
    Link
}

enum UIDropItem {
    Text(value: String)
    URI(value: String)
    File(value: UIGrantedPath)
}

struct UIDragEvent {
    target: UINodeID
    phase: UIDragPhase
    operation: UIDragOperation
    items: [UIDropItem]
}

fn poll() -[IO]> UIDragEvent? UIHostError! {
    #Unsafe("Core drag/drop consumes one typed event from the current retained provider queue") {
        core.ui.host.drag_drop.__poll()
    }
}
