use core as core
use core.ui.host.[UIGrantedPath, UIHostError, UINodeID]

// core.ui.host.drag_drop — typed file/text drop events.
pub enum UIDragPhase {
    Enter
    Over
    Drop
    Leave
    Cancel
}

pub enum UIDragOperation {
    Copy
    Move
    Link
}

pub enum UIDropItem {
    Text(value: String)
    URI(value: String)
    File(value: UIGrantedPath)
}

pub struct UIDragEvent {
    pub target: UINodeID
    pub phase: UIDragPhase
    pub operation: UIDragOperation
    pub items: [UIDropItem]
}

pub fn poll() -[IO]> UIDragEvent? UIHostError! {
    core.ui.host.drag_drop.poll()
}
