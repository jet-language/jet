// core.ui.host.accessibility — project a node tree to a platform tree.
pub struct UiA11yNode {
    pub role: String
    pub label: String
    pub children: [UiA11yNode]
}

/// Attach an accessibility tree to the host. Handle 0 means headless.
pub fn attach(tree: UiA11yNode) -> Int { host_a11y_attach(tree.role, tree.label) }

/// Flatten `tree` to `role:label` lines for tests and headless hosts.
pub fn project(tree: UiA11yNode) -> [String] {
    out := [String]{}
    walk(tree, &out)
    out
}

fn walk(tree: UiA11yNode, out: [String]) {
    out.push("{tree.role}:{tree.label}")
    loop c in tree.children -> walk(c, out)
}

fn host_a11y_attach(role: String, label: String) -> Int { panic("host_a11y_attach") }
