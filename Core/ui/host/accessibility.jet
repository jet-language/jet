use core as core
use core.ui.[UINode]
use core.ui.host.[UIAccessibility, UIAccessibilityProjection, UIHostError, UINodeID]

// core.ui.host.accessibility — route canonical node metadata through the host.
pub fn attach(node: UINode, metadata: UIAccessibility) UIHostError! -[IO]> {
    core.ui.host.accessibility.attach(node, metadata)
}

pub fn project(node: UINode, node_id: UINodeID) -[IO]> UIAccessibilityProjection? UIHostError! {
    core.ui.host.accessibility.project(node, node_id)
}
