// core.ui.host.shortcuts — chord → action table.

pub struct UiBinding {
    pub chord: String
    pub action: String
}

pub struct UiShortcutMap {
    pub bindings: [UiBinding]
}

pub fn binding(chord: String, action: String) -> UiBinding { UiBinding{chord: chord, action: action} }

pub fn register(map: UiShortcutMap, b: UiBinding) -> UiShortcutMap {
    out := [UiBinding]{}
    replaced := false
    loop x in map.bindings {
        if {
            x.chord == b.chord -> {
                out.push(b)
                replaced = true
            }
            else -> out.push(x)
        }
    }
    if !replaced -> out.push(b)
    UiShortcutMap{bindings: out}
}

/// Resolve `chord` to an action name. Empty string if unbound.
pub fn dispatch(map: UiShortcutMap, chord: String) -> String {
    loop b in map.bindings {
        if b.chord == chord -> return b.action
    }
    ""
}
