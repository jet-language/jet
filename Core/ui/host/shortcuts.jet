use core as core
use core.ui.host.[UIHostError, UIShortcut, UIShortcutBinding, UIShortcutDispatch]

// core.ui.host.shortcuts — provider-backed shortcut registration/dispatch.
pub fn binding(shortcut: ^UIShortcut, action: String) -> UIShortcutBinding UIHostError! {
    core.ui.runtime.kernel_host_services.shortcut_binding(^shortcut, action, None)
}

pub fn register(binding: UIShortcutBinding) -[IO]> UIShortcutBinding UIHostError! {
    core.ui.host.shortcuts.register(binding)
}

pub fn dispatch(shortcut: UIShortcut) -[IO]> UIShortcutDispatch UIHostError! {
    core.ui.host.shortcuts.dispatch(shortcut)
}
