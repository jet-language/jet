// Rust: crates/jet-codegen/src/Prelude/UiGtk.rs:1588
fn gtk_file_dialog_setup(dialog: Ptr<GtkFileDialog>, parent: Ptr<GtkWidget>, request: &JetUiFileDialogRequest) -> () JetUiHostError! {
    if dialog.is_null() || parent.is_null() -> return Err(JetUiHostError.CapabilityUnavailable{capability: "UI.FileDialog"})
    // GATE #4565: kernel primitive
    #Unsafe("GTK borrows temporary C strings; release every retained GIO folder/filter/store reference") {
        title :: CString.new(request.title.as_str()).map_err(fn(_) { JetUiHostError.InvalidRequest("file dialog title must not contain NUL") })?
        gtk_file_dialog_set_title(dialog, title.as_ptr())
        gtk_file_dialog_set_modal(dialog, 1)
        if request.initial_directory.as_ref() is Val(directory) {
            path :: CString.new(directory.path()).map_err(fn(_) { JetUiHostError.InvalidRequest("file dialog initial directory must not contain NUL") })?
            folder :: g_file_new_for_path(path.as_ptr())
            if folder.is_null() -> return Err(JetUiHostError.InvalidRequest("GTK rejected the file dialog initial directory"))
            gtk_file_dialog_set_initial_folder(dialog, folder)
            g_object_unref(folder.cast<c_void>())
        }
        if request.filters.is_empty() -> return Ok(())
        object_type :: gtk_file_filter_get_type()
        if object_type == 0 -> return Err(JetUiHostError.CapabilityUnavailable{capability: "UI.FileDialog"})
        store :: g_list_store_new(object_type)
        if store.is_null() -> return Err(JetUiHostError.CapabilityUnavailable{capability: "UI.FileDialog"})
        for specification in &request.filters {
            filter :: gtk_file_filter_new()
            if filter.is_null() {
                g_object_unref(store.cast<c_void>())
                return Err(JetUiHostError.CapabilityUnavailable{capability: "UI.FileDialog"})
            }
            if CString.new(specification.label.as_str()).ok() is Val(label) {
                if !specification.label.is_empty() { gtk_file_filter_set_name(filter, label.as_ptr()) }
            }
            for source_extension in &specification.extensions {
                extension := source_extension.trim_start_matches('.') // #4303
                pattern :: if extension.starts_with('*') { extension.to_string() } else { "*.{extension}" }
                if CString.new(pattern).ok() is Val(cpattern) { gtk_file_filter_add_pattern(filter, cpattern.as_ptr()) }
            }
            for mime in &specification.mime_types {
                if CString.new(mime.as_str()).ok() is Val(cmime) { gtk_file_filter_add_mime_type(filter, cmime.as_ptr()) }
            }
            g_list_store_append(store, filter.cast<c_void>())
            g_object_unref(filter.cast<c_void>())
        }
        gtk_file_dialog_set_filters(dialog, store.cast<GListModel>())
        g_object_unref(store.cast<c_void>())
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/UiGtk.rs:1680
fn gtk_run_file_dialog(window: Ptr<GtkWidget>, request: &JetUiFileDialogRequest) -> JetUiFileDialogSelection JetUiHostError! {
    dialog :: gtk_file_dialog_new()
    if dialog.is_null() -> return Err(JetUiHostError.CapabilityUnavailable{capability: "UI.FileDialog"})
    match gtk_file_dialog_setup(dialog, window, request) {
        Err(error) -> { g_object_unref(dialog.cast<c_void>()); return Err(^error) }
        Ok(_) -> {}
    }
    mode :: when (request.kind, request.allow_multiple) {
        (.Open, true) -> FileDialogMode.OpenMultiple
        (.Open, false) -> FileDialogMode.Open
        (.Save, false) -> FileDialogMode.Save
        (.Save, true) -> {
            g_object_unref(dialog.cast<c_void>())
            return Err(JetUiHostError.InvalidRequest("save dialogs cannot select multiple files"))
        }
    }
    pending := FileDialogRead{done: false, mode: mode, files: [], cancelled: false, error: None}
    // GATE #4565: kernel primitive
    #Unsafe("drain GTK async callback before stack pending state leaves scope; release dialog afterward") {
        data :: Ptr.from_ref(&pending).cast<c_void>()
        when mode {
            .Open -> gtk_file_dialog_open(dialog, window, Ptr.null(), jet_gtk_file_dialog_ready, data)
            .OpenMultiple -> gtk_file_dialog_open_multiple(dialog, window, Ptr.null(), jet_gtk_file_dialog_ready, data)
            .Save -> gtk_file_dialog_save(dialog, window, Ptr.null(), jet_gtk_file_dialog_ready, data)
        }
        while !pending.done { _ :: g_main_context_iteration(Ptr.null(), 1) }
        g_object_unref(dialog.cast<c_void>())
    }
    if pending.error is Val(message) -> return Err(JetUiHostError.HostFailure{service: "UI.FileDialog", message: ^message})
    if pending.cancelled || pending.files.is_empty() -> return Err(JetUiHostError.Cancelled(.User))
    access :: when request.kind { .Open -> JetUiFsAccess.Read; .Save -> JetUiFsAccess.Write }
    files := [JetUiGrantedPath].with_capacity(pending.files.len())
    for path in &pending.files { files.push(request.grant.scope(path, access)?) }
    JetUiFileDialogSelection.new(^files)
}
