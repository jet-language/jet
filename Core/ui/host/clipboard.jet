use core as core
use core.ui.host.[UiClipboardText, UiClipboardWrite, UiHostError]

// core.ui.host.clipboard — typed UTF-8 clipboard provider.
pub fn read_text() -[IO]> UiClipboardText UiHostError! {
    core.ui.host.clipboard.read_text()
}

pub fn write_text(text: String) -[IO]> UiClipboardWrite UiHostError! {
    core.ui.host.clipboard.write_text(text)
}

pub fn clear() -[IO]> UiClipboardWrite UiHostError! {
    write_text("")
}

pub fn is_empty() -[IO]> Bool UiHostError! {
    read_text().text.len() == 0
}
