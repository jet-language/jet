// core.ui.host.clipboard — UTF-8 clipboard text.
pub fn read_text() -> String { host_clipboard_read() }

pub fn write_text(text: String) { host_clipboard_write(text) }

fn host_clipboard_read() -> String { panic("host_clipboard_read") }

fn host_clipboard_write(text: String) { panic("host_clipboard_write") }

pub fn clear() { host_clipboard_write("") }

pub fn is_empty() -> Bool { host_clipboard_read().bytes().len() == 0 }
