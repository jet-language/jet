use core as core
use core.ui.host.[UIClipboardText, UIClipboardWrite, UIHostError]

// core.ui.host.clipboard — typed UTF-8 clipboard provider.
fn read_text() -[IO]> UIClipboardText UIHostError! {
    core.ui.host.clipboard.read_text()
}

fn write_text(text: String) -[IO]> UIClipboardWrite UIHostError! {
    core.ui.host.clipboard.write_text(text)
}

fn clear() -[IO]> UIClipboardWrite UIHostError! {
    write_text("")
}

fn is_empty() -[IO]> Bool UIHostError! {
    read_text().text.len() == 0
}
