package {
    name: "core.ui"
    version: "0.1.0"
    edition: "2026"
    description: "Immediate-mode UI nodes, previews, and host dialogs."
    license: "MIT"
    outputs: {
        ui: .Library{ entry: ui }
    }
}
use core as core

// core.ui — one portable tree consumed by every backend.
//
// Geometry and node values are deliberately backend-neutral.  Opening a
// window, painting, and event delivery remain provider operations; these
// constructors only build values that can be measured and rendered.
module host

pub enum UIPreviewDevice {
    Phone
    Tablet
    Desktop
}

pub enum UIPreviewKind {
    Preview
    Playground
}

pub enum UIIMEMode {
    Native
    Disabled
}

pub enum UIAriaRole {
    Button
    Container
    Label
    TextInput
}

pub enum UINodeKind {
    Custom
    Text
    Box
    Button
    TextInput
}

pub struct Point {
    pub x: Float
    pub y: Float
}

pub struct Size {
    pub width: Float
    pub height: Float
}

pub struct Rect {
    pub x: Float
    pub y: Float
    pub width: Float
    pub height: Float
}


pub enum InputEvent {
    Key(code: String)
    Resize(size: Size)
}




pub fn point(x: Float, y: Float) -> Point Never! { core.ui.point(x, y) }
pub fn size(width: Float, height: Float) -> Size Never! {
    core.ui.size(width, height)
}
pub fn rect(x: Float, y: Float, width: Float, height: Float) -> Rect Never! {
    core.ui.rect(x, y, width, height)
}
pub fn constraint(min_width: Float, min_height: Float, max_width: Float, max_height: Float) -> SizeConstraint Never! {
    core.ui.constraint(min_width, min_height, max_width, max_height)
}

pub fn node(label: String, width: Float, height: Float) -> UINode Never! {
    core.ui.node(label, width, height)
}

pub fn box(children: [UINode]) -> UINode Never! {
    core.ui.box(children)
}

pub fn text(value: String) -> UINode Never! {
    core.ui.text(value)
}

pub fn desktop() -> UIPreviewViewport Never! { core.ui.desktop() }
pub fn phone() -> UIPreviewViewport Never! { core.ui.phone() }
pub fn tablet() -> UIPreviewViewport Never! { core.ui.tablet() }

pub fn key_event(code: String) -> InputEvent Never! { core.ui.key_event(code) }
pub fn resize_event(width: Float, height: Float) -> InputEvent Never! {
    core.ui.resize_event(width, height)
}


pub fn gtk_backend() -> GtkBackend Never! { core.ui.gtk_backend() }
pub fn tui_backend() -> TUIBackend Never! { core.ui.tui_backend() }
pub fn null_backend() -> NullBackend Never! { core.ui.null_backend() }

pub fn aria_role_button() -> UIAriaRole Never! { core.ui.aria_role_button() }
pub fn aria_role_container() -> UIAriaRole Never! { core.ui.aria_role_container() }
pub fn aria_role_label() -> UIAriaRole Never! { core.ui.aria_role_label() }
pub fn aria_role_text_input() -> UIAriaRole Never! { core.ui.aria_role_text_input() }

pub fn node_accessibility(n: UINode, metadata: UIAccessibility) -> UINode Never! {
    core.ui.node_accessibility(n, metadata)
}

pub fn node_color(label: String, width: Float, height: Float, color: String) -> UINode Never! {
    core.ui.node_color(label, width, height, color)
}

pub fn node_role(label: String, width: Float, height: Float, role: UIAriaRole) -> UINode Never! {
    core.ui.node_role(label, width, height, role)
}

pub fn node_shortcut(n: UINode, shortcut: UIShortcut) -> UINode Never! {
    core.ui.node_shortcut(n, shortcut)
}

