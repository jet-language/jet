package {
    name: "core.ui"
    version: "0.0.1"
    edition: "2026"
    description: "Immediate-mode UI nodes, previews, and host dialogs."
    license: "MIT"
    outputs: {
        ui: .Library{ entry: ui }
    }
}
use core as core

// core.ui — one portable tree consumed by every backend.
//
// Geometry and node values are deliberately backend-neutral.  Opening a
// window, painting, and event delivery remain provider operations; these
// constructors only build values that can be measured and rendered.
module host

pub enum UIPreviewDevice {
    Phone
    Tablet
    Desktop
}

pub enum UIPreviewKind {
    Preview
    Playground
}

pub enum UIIMEMode {
    Native
    Disabled
}

pub enum UIAriaRole {
    Button
    Container
    Label
    TextInput
}

pub enum UINodeKind {
    Custom
    Text
    Box
    Button
    TextInput
}

pub struct Point {
    pub x: Float
    pub y: Float
}

pub struct Size {
    pub width: Float
    pub height: Float
}

pub struct Rect {
    pub x: Float
    pub y: Float
    pub width: Float
    pub height: Float
}

pub struct SizeConstraint {
    pub min_width: Float
    pub min_height: Float
    pub max_width: Float
    pub max_height: Float
}


pub enum InputEvent {
    Key(code: String)
    Resize(size: Size)
}




pub fn point(x: Float, y: Float) -> Point Never! { Point{x: x, y: y} }
pub fn size(width: Float, height: Float) -> Size Never! {
    Size{width: width, height: height}
}
pub fn rect(x: Float, y: Float, width: Float, height: Float) -> Rect Never! {
    Rect{x: x, y: y, width: width, height: height}
}
pub fn constraint(min_width: Float, min_height: Float, max_width: Float, max_height: Float) -> SizeConstraint Never! {
    SizeConstraint{min_width: min_width, min_height: min_height, max_width: max_width, max_height: max_height}
}

pub fn node(label: String, width: Float, height: Float) -> UINode Never! {
    transfer_node(label, width, height, None, UINodeKind.Custom, [UINode]{}, None)
}

pub fn box(children: [UINode]) -> UINode Never! {
    width := Float{0.0}
    height := Float{0.0}
    loop child in children {
        // f64::max ignores a NaN operand; do not let it poison the width.
        if child.width > width -> width = child.width
        height += child.height
    }
    transfer_node("", width, height, Val(UIAriaRole.Container), UINodeKind.Box, children, None)
}

pub fn text(value: String) -> UINode Never! {
    width :: Float{core.tui.display_width(value)}
    transfer_node(value, width, 1.0, Val(UIAriaRole.Label), UINodeKind.Text, [UINode]{}, None)
}

pub fn desktop() -> UIPreviewViewport Never! { transfer_viewport(2, 1280, 800, 1) }
pub fn phone() -> UIPreviewViewport Never! { transfer_viewport(0, 390, 844, 2) }
pub fn tablet() -> UIPreviewViewport Never! { transfer_viewport(1, 834, 1119, 2) }

pub fn key_event(code: String) -> InputEvent Never! { InputEvent.Key(code) }
pub fn resize_event(width: Float, height: Float) -> InputEvent Never! {
    InputEvent.Resize(size(width, height))
}


pub fn gtk_backend() -> GtkBackend Never! { core.ui.gtk_backend() }
pub fn tui_backend() -> TUIBackend Never! { core.ui.tui_backend() }
pub fn null_backend() -> NullBackend Never! { core.ui.null_backend() }

pub fn aria_role_button() -> UIAriaRole Never! { UIAriaRole.Button }
pub fn aria_role_container() -> UIAriaRole Never! { UIAriaRole.Container }
pub fn aria_role_label() -> UIAriaRole Never! { UIAriaRole.Label }
pub fn aria_role_text_input() -> UIAriaRole Never! { UIAriaRole.TextInput }

pub fn node_accessibility(n: UINode, metadata: UIAccessibility) -> UINode Never! {
    #Unsafe("Core UI accessibility slot transfer: explicitly present validated metadata") {
        core.ui.__accessibility_transfer(n, metadata, true)
    }
}

pub fn node_color(label: String, width: Float, height: Float, color: String) -> UINode Never! {
    transfer_node(label, width, height, Val(UIAriaRole.Label), UINodeKind.Custom, [UINode]{}, Val(color))
}

pub fn node_role(label: String, width: Float, height: Float, role: UIAriaRole) -> UINode Never! {
    kind := UINodeKind.Custom
    if role == .Button -> kind = UINodeKind.Button
    if role == .TextInput -> kind = UINodeKind.TextInput
    transfer_node(label, width, height, Val(role), kind, [UINode]{}, None)
}

pub fn node_shortcut(n: UINode, shortcut: UIShortcut) -> UINode Never! {
    #Unsafe("Core UI shortcut slot transfer: explicitly present validated shortcut") {
        core.ui.__shortcut_transfer(n, shortcut, true)
    }
}


fn transfer_node(label: String, width: Float, height: Float, role: UIAriaRole?, kind: UINodeKind, children: [UINode], color: String?) -> UINode Never! {
    // Policy chooses the absent metadata slots here. The wire explicitly
    // carries their six absence bits, rather than asking the host for defaults.
    role_tag := -1
    if role == .Val(value) {
        if value == .Button -> role_tag = 0
        if value == .TextInput -> role_tag = 1
        if value == .Label -> role_tag = 2
        if value == .Container -> role_tag = 3
    }
    kind_tag := 0
    if kind == .Text -> kind_tag = 1
    if kind == .Box -> kind_tag = 2
    if kind == .Button -> kind_tag = 3
    if kind == .TextInput -> kind_tag = 4
    color_present := false
    color_word := ""
    if color == .Val(value) {
        color_present = true
        color_word = value
    }
    #Unsafe("Core UI host slot transfer: audited kind, role, explicit absent slots, and normalized style words") {
        core.ui.__node_transfer(label, width, height, role_tag, kind_tag, children, color_present, color_word, 63, false, 0, 0, 0, 0, 0)
    }
}

fn transfer_viewport(device: Int, width: Int, height: Int, scale: Int) -> UIPreviewViewport Never! {
    #Unsafe("Core UI viewport transfer: source supplies a valid device and bounded positive dimensions") {
        core.ui.__viewport_transfer(device, width, height, scale)
    }
}

#Test("UI aria role constructors") {
    assert(aria_role_button() == UIAriaRole.Button)
    assert(aria_role_container() == UIAriaRole.Container)
    assert(aria_role_label() == UIAriaRole.Label)
    assert(aria_role_text_input() == UIAriaRole.TextInput)
}
