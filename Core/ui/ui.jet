package {
    name: "core.ui"
    version: "0.0.1"
    edition: "2026"
    description: "Immediate-mode UI nodes, previews, and host dialogs."
    license: "MIT"
    outputs: {
        ui: .Library{ entry: ui }
    }
}
use core as core

// core.ui — one portable tree consumed by every backend.
//
// Geometry and node values are deliberately backend-neutral.  Opening a
// window, painting, and event delivery remain provider operations; these
// constructors only build values that can be measured and rendered.
module host

enum UIPreviewDevice {
    Phone
    Tablet
    Desktop
}

enum UIPreviewKind {
    Preview
    Playground
}

enum UIIMEMode {
    Native
    Disabled
}

enum UIAriaRole {
    Button
    Container
    Label
    TextInput
}

enum UINodeKind {
    Custom
    Text
    Box
    Button
    TextInput
}

struct Point {
    x: Float
    y: Float
}

struct Size {
    width: Float
    height: Float
}

struct Rect {
    x: Float
    y: Float
    width: Float
    height: Float
}


enum InputEvent {
    Key(code: String)
    Resize(size: Size)
}




fn point(x: Float, y: Float) -> Point Never! { core.ui.point(x, y) }
fn size(width: Float, height: Float) -> Size Never! {
    core.ui.size(width, height)
}
fn rect(x: Float, y: Float, width: Float, height: Float) -> Rect Never! {
    core.ui.rect(x, y, width, height)
}
fn constraint(min_width: Float, min_height: Float, max_width: Float, max_height: Float) -> SizeConstraint Never! {
    core.ui.constraint(min_width, min_height, max_width, max_height)
}

fn node(label: String, width: Float, height: Float) -> UINode Never! {
    core.ui.node(label, width, height)
}

fn box(children: [UINode]) -> UINode Never! {
    core.ui.box(children)
}

fn text(value: String) -> UINode Never! {
    core.ui.text(value)
}

fn desktop() -> UIPreviewViewport Never! { core.ui.desktop() }
fn phone() -> UIPreviewViewport Never! { core.ui.phone() }
fn tablet() -> UIPreviewViewport Never! { core.ui.tablet() }

fn key_event(code: String) -> InputEvent Never! { core.ui.key_event(code) }
fn resize_event(width: Float, height: Float) -> InputEvent Never! {
    core.ui.resize_event(width, height)
}


fn gtk_backend() -> GtkBackend Never! { core.ui.gtk_backend() }
fn tui_backend() -> TUIBackend Never! { core.ui.tui_backend() }
fn null_backend() -> NullBackend Never! { core.ui.null_backend() }

fn aria_role_button() -> UIAriaRole Never! { core.ui.aria_role_button() }
fn aria_role_container() -> UIAriaRole Never! { core.ui.aria_role_container() }
fn aria_role_label() -> UIAriaRole Never! { core.ui.aria_role_label() }
fn aria_role_text_input() -> UIAriaRole Never! { core.ui.aria_role_text_input() }

fn node_accessibility(n: UINode, metadata: UIAccessibility) -> UINode Never! {
    core.ui.node_accessibility(n, metadata)
}

fn node_color(label: String, width: Float, height: Float, color: String) -> UINode Never! {
    core.ui.node_color(label, width, height, color)
}

fn node_role(label: String, width: Float, height: Float, role: UIAriaRole) -> UINode Never! {
    core.ui.node_role(label, width, height, role)
}

fn node_shortcut(n: UINode, shortcut: UIShortcut) -> UINode Never! {
    core.ui.node_shortcut(n, shortcut)
}

