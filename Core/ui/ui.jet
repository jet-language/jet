package {
    name: "core.ui"
    version: "0.1.0"
    edition: "2026"
    description: "Immediate-mode UI nodes, previews, and host dialogs."
    license: "MIT"
    outputs: {
        ui: .Library{ entry: ui }
    }
}
use core as core

// core.ui — one portable tree consumed by every backend.
//
// Geometry and node values are deliberately backend-neutral.  Opening a
// window, painting, and event delivery remain provider operations; these
// constructors only build values that can be measured and rendered.
module host

pub enum UiPreviewDevice {
    Phone
    Tablet
    Desktop
}

pub enum UiPreviewKind {
    Preview
    Playground
}

pub enum UiImeMode {
    Native
    Disabled
}

pub enum UiAriaRole {
    Button
    Container
    Label
    TextInput
}

pub enum UiNodeKind {
    Custom
    Text
    Box
    Button
    TextInput
}

pub struct Point {
    pub x: Float
    pub y: Float
}

pub struct Size {
    pub width: Float
    pub height: Float
}

pub struct Rect {
    pub x: Float
    pub y: Float
    pub width: Float
    pub height: Float
}

pub struct SizeConstraint {
    pub min_width: Float
    pub min_height: Float
    pub max_width: Float
    pub max_height: Float
}



pub struct UiNode {
    pub label: String
    pub width: Float
    pub height: Float
    pub accessibility: ?UiAccessibility
    pub ime: ?UiImeMode
    pub shortcut: ?UiShortcut
}

pub enum InputEvent {
    Key(code: String)
    Resize(size: Size)
}




pub fn point(x: Float, y: Float) -> Point { core.ui.point(x, y) }
pub fn size(width: Float, height: Float) -> Size {
    core.ui.size(width, height)
}
pub fn rect(x: Float, y: Float, width: Float, height: Float) -> Rect {
    core.ui.rect(x, y, width, height)
}
pub fn constraint(min_width: Float, min_height: Float, max_width: Float, max_height: Float) -> SizeConstraint {
    core.ui.constraint(min_width, min_height, max_width, max_height)
}

pub fn node(label: String, width: Float, height: Float) -> UiNode {
    core.ui.node(label, width, height)
}

pub fn box(children: [UiNode]) -> UiNode {
    core.ui.box(children)
}

pub fn text(value: String) -> UiNode {
    core.ui.text(value)
}




pub fn preview(name: String, viewport: ?UiPreviewViewport, body: fn() -> UiNode) -> UiPreview {
    core.ui.preview(name, viewport, body)
}


pub fn playground(name: String, viewport: ?UiPreviewViewport, body: fn() -> UiNode) -> UiPreview {
    core.ui.playground(name, viewport, body)
}



pub fn desktop() -> UiPreviewViewport { core.ui.desktop() }
pub fn phone() -> UiPreviewViewport { core.ui.phone() }
pub fn tablet() -> UiPreviewViewport { core.ui.tablet() }

pub fn key_event(code: String) -> InputEvent { core.ui.key_event(code) }
pub fn resize_event(width: Float, height: Float) -> InputEvent {
    core.ui.resize_event(width, height)
}

pub fn reactive_render(body: fn()) {
    core.ui.reactive_render(body)
}

pub fn gtk_backend() -> GtkBackend { core.ui.gtk_backend() }
pub fn tui_backend() -> TuiBackend { core.ui.tui_backend() }
pub fn null_backend() -> NullBackend { core.ui.null_backend() }

pub fn aria_role_button() -> UiAriaRole { core.ui.aria_role_button() }
pub fn aria_role_container() -> UiAriaRole { core.ui.aria_role_container() }
pub fn aria_role_label() -> UiAriaRole { core.ui.aria_role_label() }
pub fn aria_role_text_input() -> UiAriaRole { core.ui.aria_role_text_input() }

pub fn node_accessibility(n: UiNode, metadata: UiAccessibility) -> UiNode {
    core.ui.node_accessibility(n, metadata)
}

pub fn node_color(label: String, width: Float, height: Float, color: String) -> UiNode {
    core.ui.node_color(label, width, height, color)
}

pub fn node_role(label: String, width: Float, height: Float, role: UiAriaRole) -> UiNode {
    core.ui.node_role(label, width, height, role)
}

pub fn node_shortcut(n: UiNode, shortcut: UiShortcut) -> UiNode {
    core.ui.node_shortcut(n, shortcut)
}

