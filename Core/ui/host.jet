use core as core
// core.ui.host — typed host capability leaves for dialogs and metadata.
//
// Every operation that crosses the process boundary is forwarded to the
// scoped provider.  Request construction and validation remain pure Jet code;
// cancellation, headless, and denied outcomes stay typed.

pub enum UICapability {
    FileDialog
    Clipboard
    IME
    DragDrop
    Shortcuts
    Accessibility
    FontShaping
}

pub enum UICancellation {
    User
    Closed
    Headless
    Superseded
    Programmatic
}

pub enum UIFileDialogKind {
    Open
    Save
}

pub enum UIFSAccess {
    Read
    Write
}

#Error
pub enum UIHostError {
    Cancelled
    Headless
    Denied
    Missing
    InvalidRequest(String)
    CapabilityUnavailable
    CapabilityDenied
    HostFailure
    ResourceDenied
    ShortcutConflict
    QueueFull
}

pub struct UICapabilityFact {
    pub capability: UICapability
    pub available: Bool
}

pub struct UICapabilityFacts {
    pub facts: [UICapabilityFact]
}

pub struct UIFSRights {
    bits: U8
}

pub struct UIFSGrant {
    pub root: String
    pub rights: UIFSRights
}

pub struct UIGrantedPath {
    pub path: String
    pub grant_root: String
    pub access: UIFSAccess
}

pub struct UIFileFilter {
    pub label: String
    pub extensions: [String]
    pub mime_types: [String]
}

pub struct UIFileDialogRequest {
    pub kind: UIFileDialogKind
    pub title: String
    pub grant: UIFSGrant
    pub initial_directory: UIGrantedPath?
    pub filters: [UIFileFilter]
    pub allow_multiple: Bool
}

pub struct UIFileDialogSelection {
    pub files: [UIGrantedPath]
}

pub struct UIShortcutModifiers {
    pub bits: Int
}

pub struct UIShortcut {
    pub key: String
    pub modifiers: UIShortcutModifiers
}
pub struct UITextRange {
    pub start: Int
    pub end: Int
}

pub struct UIClipboardText {
    pub text: String
    pub selection: UITextRange?
}

pub struct UIClipboardWrite {
    pub characters: Int
}

pub struct UINodeID {
    pub value: String
}

pub struct UIAccessibilityProjection {
    pub lines: [String]
}
pub struct UIShortcutBinding {
    pub shortcut: UIShortcut
    pub action: String
    pub node: UINodeID?
}

pub enum UIShortcutDispatch {
    Dispatched(UIShortcutBinding)
    Unhandled
}



pub fn capabilities() -> UICapabilityFacts Never! { core.ui.host.capabilities() }

pub fn open_file(request: UIFileDialogRequest) -[FS]> UIFileDialogSelection UIHostError! {
    core.ui.host.open_file(request)
}

pub fn save_file(request: UIFileDialogRequest) -[FS]> UIFileDialogSelection UIHostError! {
    core.ui.host.save_file(request)
}

pub fn open_request(grant: UIFSGrant) -> UIFileDialogRequest Never! {
    transfer_request(0, "Open File", grant, true, [UIFileFilter]{}, false)
}

pub fn save_request(grant: UIFSGrant) -> UIFileDialogRequest Never! {
    transfer_request(1, "Save File", grant, true, [UIFileFilter]{}, false)
}

fn transfer_request(kind: Int, title: String, grant: UIFSGrant, directory_absent: Bool, filters: [UIFileFilter], multiple: Bool) -> UIFileDialogRequest Never! {
    #Unsafe("Core UI dialog request transfer: validated grant and explicit absent directory, filter list, and multiple-selection slot") {
        core.ui.host.__request_transfer(kind, title, grant, directory_absent, filters, multiple)
    }
}

pub fn file_filter(label: String, extensions: [String], mime_types: [String]) -> UIFileFilter UIHostError! {
    if label.len() == 0 && extensions.len() == 0 && mime_types.len() == 0 -> return Err(UIHostError.InvalidRequest("file filter must name an extension, media type, or label"))
    loop extension in extensions {
        if extension.len() == 0 -> return Err(UIHostError.InvalidRequest("file filter extensions must not be empty"))
    }
    loop mime in mime_types {
        if mime.len() == 0 -> return Err(UIHostError.InvalidRequest("file filter media types must not be empty"))
    }
    Ok(UIFileFilter{label: label, extensions: extensions, mime_types: mime_types})
}

pub fn file_filter_text() -> UIFileFilter Never! {
    UIFileFilter{label: "Text", extensions: [String]{"txt"}, mime_types: [String]{"text/plain"}}
}

pub fn fs_grant(path: String, rights: UIFSRights) -> UIFSGrant UIHostError! {
    core.ui.host.fs_grant(path, rights)
}

pub fn fs_rights_read() -> UIFSRights Never! { UIFSRights{bits: U8{1}} }
pub fn fs_rights_write() -> UIFSRights Never! { UIFSRights{bits: U8{2}} }
pub fn fs_rights_read_write() -> UIFSRights Never! { UIFSRights{bits: U8{3}} }

pub fn shortcut(key: String, modifiers: UIShortcutModifiers) -[IO]> UIShortcut UIHostError! {
    normalized :: core.text.lower(core.text.trim(key))
    if normalized.len() == 0 -> return Err(UIHostError.InvalidRequest("shortcut key must not be empty"))
    Ok(UIShortcut{key: normalized, modifiers: modifiers})
}

pub fn accessibility(name: String, description: String) -[IO]> UIAccessibility UIHostError! {
    core.ui.host.accessibility(name, description)
}

#Test("UI file-filter policy preserves labels and typed error payloads") {
    text :: file_filter_text()
    assert(text.label == "Text" && text.extensions == [String]{"txt"} && text.mime_types == [String]{"text/plain"})
    filter :: file_filter(" ", [String]{"jet"}, [String]{"text/x-jet"}) ?? panic("valid filter rejected")
    assert(filter.label == " " && filter.extensions == [String]{"jet"})
    if file_filter("", [String]{}, [String]{}) == .Err(error) {
        if error == .InvalidRequest(message) -> assert(message == "file filter must name an extension, media type, or label")
        else -> panic("wrong file-filter error")
    } else -> panic("empty filter accepted")
    if file_filter("Jet", [String]{""}, [String]{}) == .Err(error) {
        if error == .InvalidRequest(message) -> assert(message == "file filter extensions must not be empty")
        else -> panic("wrong extension error")
    } else -> panic("empty extension accepted")
    if file_filter("Jet", [String]{}, [String]{""}) == .Err(error) {
        if error == .InvalidRequest(message) -> assert(message == "file filter media types must not be empty")
        else -> panic("wrong media-type error")
    } else -> panic("empty media type accepted")
}

#Test("UI dialog request defaults occupy explicit carrier slots") {
    grant :: fs_grant(".", fs_rights_read_write()) ?? panic("valid grant rejected")
    open :: open_request(grant)
    save :: save_request(grant)
    assert(open.kind == .Open && open.title == "Open File")
    assert(save.kind == .Save && save.title == "Save File")
    assert(open.initial_directory == None && save.initial_directory == None)
    assert(open.filters.len() == 0 && save.filters.len() == 0)
    assert(!open.allow_multiple && !save.allow_multiple)
    assert(open.grant.root == grant.root && save.grant.root == grant.root)
}

#Test("UI filesystem rights constructors preserve canonical read and write bits") {
    read :: fs_rights_read()
    write :: fs_rights_write()
    both :: fs_rights_read_write()
    assert(read.bits == U8{1} && write.bits == U8{2} && both.bits == U8{3})
    assert(read != write && both != read && both != write)
    empty :: UIFSRights{}
    assert(empty.bits == U8{0})
    grant :: fs_grant(".", both) ?? panic("valid grant rejected")
    assert(grant.rights == both)
}


#Test("UI shortcut policy normalizes Unicode and preserves modifiers") {
    modifiers :: UIShortcutModifiers{}
    normalized :: shortcut(" \tÄBC İ \n", modifiers) ?? panic("valid shortcut rejected")
    assert(normalized.key == "äbc i̇")
    assert(normalized.modifiers == modifiers)
    spaced :: shortcut(" A B ", modifiers) ?? panic("valid spaced shortcut rejected")
    assert(spaced.key == "a b")
    command :: UIShortcut.cmd("a").modifiers
    commanded :: shortcut(" A ", command) ?? panic("valid command shortcut rejected")
    assert(commanded.modifiers == command)
    sigma :: shortcut("ΑΣ", modifiers) ?? panic("valid Greek shortcut rejected")
    assert(sigma.key == "ας")
    // U+3000, U+0085, U+2028 are Rust White_Space, not just ASCII trim bytes.
    padding :: String.from_bytes([U8]{227, 128, 128, 194, 133, 226, 128, 168}) ?? panic("valid whitespace bytes rejected")
    whitespace :: shortcut("{padding}A{padding}", modifiers) ?? panic("Unicode whitespace rejected")
    assert(whitespace.key == "a")
    if shortcut(" \t\n", modifiers) == .Err(error) {
        if error == .InvalidRequest(message) -> assert(message == "shortcut key must not be empty")
        else -> panic("wrong shortcut error")
    } else -> panic("empty shortcut accepted")
}
