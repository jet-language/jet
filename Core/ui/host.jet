// core.ui.host — file dialogs, clipboard, IME, shortcuts, accessibility.
//
// Dialogs and clipboard talk to the OS through `host_*`. Headless hosts
// return `UiCancellation.Headless` rather than inventing a path.

// Nested host helpers live beside this file in the package tree; the parent
// UI module exposes the host surface directly.

pub enum UiCapability {
    FileDialog
    Clipboard
    Ime
    DragDrop
    Shortcuts
    Accessibility
}

pub enum UiCancellation {
    User
    Closed
    Headless
    Superseded
    Programmatic
}

pub enum UiFileDialogKind {
    Open
    Save
}

pub enum UiFsAccess {
    Read
    Write
}

#Error
pub enum UiHostError {
    Cancelled
    Headless
    Denied
    Missing
}

pub struct UiCapabilityFact {
    pub capability: UiCapability
    pub available: Bool
}

pub struct UiCapabilityFacts {
    pub facts: [UiCapabilityFact]
}

pub struct UiFsRights {
    pub read: Bool
    pub write: Bool
}

pub struct UiGrantedPath {
    pub path: String
    pub rights: UiFsRights
}

pub struct UiFsGrant {
    pub paths: [UiGrantedPath]
}

pub struct UiFileFilter {
    pub label: String
    pub glob: String
}

pub struct UiFileDialogRequest {
    pub kind: UiFileDialogKind
    pub title: String
    pub filter: UiFileFilter
}

pub struct UiFileDialogSelection {
    pub path: String
}

pub struct UiShortcut {
    pub chord: String
    pub action: String
}

pub struct UiAccessibilityTree {
    pub role: String
    pub label: String
}

pub fn capabilities() -> UiCapabilityFacts {
    facts := [UiCapabilityFact]{}
    facts.push(UiCapabilityFact{capability: UiCapability.FileDialog, available: host_has_file_dialog()})
    facts.push(UiCapabilityFact{capability: UiCapability.Clipboard, available: host_has_clipboard()})
    facts.push(UiCapabilityFact{capability: UiCapability.Ime, available: host_has_ime()})
    facts.push(UiCapabilityFact{capability: UiCapability.DragDrop, available: host_has_drag_drop()})
    facts.push(UiCapabilityFact{capability: UiCapability.Shortcuts, available: true})
    facts.push(UiCapabilityFact{capability: UiCapability.Accessibility, available: host_has_a11y()})
    UiCapabilityFacts{facts: facts}
}

pub fn open_file(request: UiFileDialogRequest) -[FS]> String !UiHostError {
    path :: host_open_file(request.title, request.filter.glob)
    if path.len() == 0 -> return Err(UiHostError.Cancelled)
    Ok(path)
}

pub fn save_file(request: UiFileDialogRequest) -[FS]> String !UiHostError {
    path :: host_save_file(request.title, request.filter.glob)
    if path.len() == 0 -> return Err(UiHostError.Cancelled)
    Ok(path)
}

pub fn open_request(title: String, filter: UiFileFilter) -> UiFileDialogRequest {
    UiFileDialogRequest{kind: UiFileDialogKind.Open, title: title, filter: filter}
}

pub fn save_request(title: String, filter: UiFileFilter) -> UiFileDialogRequest {
    UiFileDialogRequest{kind: UiFileDialogKind.Save, title: title, filter: filter}
}

pub fn file_filter(label: String, glob: String) -> UiFileFilter { UiFileFilter{label: label, glob: glob} }

pub fn file_filter_text() -> UiFileFilter { UiFileFilter{label: "Text", glob: "*.txt"} }

pub fn fs_grant(path: String, rights: UiFsRights) -> UiFsGrant {
    UiFsGrant{paths: [UiGrantedPath]{UiGrantedPath{path: path, rights: rights}}}
}

pub fn fs_rights_read() -> UiFsRights { UiFsRights{read: true, write: false} }
pub fn fs_rights_write() -> UiFsRights { UiFsRights{read: false, write: true} }
pub fn fs_rights_read_write() -> UiFsRights { UiFsRights{read: true, write: true} }

pub fn shortcut(chord: String, action: String) -> UiShortcut { UiShortcut{chord: chord, action: action} }

pub fn accessibility(role: String, label: String) -> UiAccessibilityTree {
    UiAccessibilityTree{role: role, label: label}
}

fn host_has_file_dialog() -[FS]> Bool { panic("host_has_file_dialog") }
fn host_has_clipboard() -> Bool { panic("host_has_clipboard") }
fn host_has_ime() -> Bool { panic("host_has_ime") }
fn host_has_drag_drop() -> Bool { panic("host_has_drag_drop") }
fn host_has_a11y() -> Bool { panic("host_has_a11y") }
fn host_open_file(title: String, glob: String) -[FS]> String { panic("host_open_file") }
fn host_save_file(title: String, glob: String) -[FS]> String { panic("host_save_file") }
