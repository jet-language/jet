use core as core
// core.ui.host — typed host capability leaves for dialogs and metadata.
//
// Every operation that crosses the process boundary is forwarded to the
// scoped provider.  Request construction and validation remain pure Jet code;
// cancellation, headless, and denied outcomes stay typed.

enum UICapability {
    FileDialog
    Clipboard
    IME
    DragDrop
    Shortcuts
    Accessibility
    FontShaping
}

enum UICancellation {
    User
    Closed
    Headless
    Superseded
    Programmatic
}

enum UIFileDialogKind {
    Open
    Save
}

enum UIFSAccess {
    Read
    Write
}

#Error
enum UIHostError {
    Cancelled
    Headless
    Denied
    Missing
    InvalidRequest
    CapabilityUnavailable
    CapabilityDenied
    HostFailure
    ResourceDenied
    ShortcutConflict
    QueueFull
}

struct UICapabilityFact {
    capability: UICapability
    available: Bool
}

struct UICapabilityFacts {
    facts: [UICapabilityFact]
}

struct UIFSRights {
    read: Bool
    write: Bool
}

struct UIFSGrant {
    root: String
    rights: UIFSRights
}

struct UIGrantedPath {
    path: String
    grant_root: String
    access: UIFSAccess
}

struct UIFileFilter {
    label: String
    extensions: [String]
    mime_types: [String]
}

struct UIFileDialogRequest {
    kind: UIFileDialogKind
    title: String
    grant: UIFSGrant
    initial_directory: UIGrantedPath?
    filters: [UIFileFilter]
    allow_multiple: Bool
}

struct UIFileDialogSelection {
    files: [UIGrantedPath]
}

struct UIShortcutModifiers {
    bits: Int
}

struct UIShortcut {
    key: String
    modifiers: UIShortcutModifiers
}
struct UITextRange {
    start: Int
    end: Int
}

struct UIClipboardText {
    text: String
    selection: UITextRange?
}

struct UIClipboardWrite {
    characters: Int
}

struct UINodeID {
    value: String
}

struct UIAccessibilityProjection {
    lines: [String]
}
struct UIShortcutBinding {
    shortcut: UIShortcut
    action: String
    node: UINodeID?
}

enum UIShortcutDispatch {
    Dispatched(UIShortcutBinding)
    Unhandled
}



fn capabilities() -> UICapabilityFacts Never! { core.ui.host.capabilities() }

fn open_file(request: UIFileDialogRequest) -[FS]> UIFileDialogSelection UIHostError! {
    core.ui.host.open_file(request)
}

fn save_file(request: UIFileDialogRequest) -[FS]> UIFileDialogSelection UIHostError! {
    core.ui.host.save_file(request)
}

fn open_request(grant: UIFSGrant) -> UIFileDialogRequest Never! {
    core.ui.host.open_request(grant)
}

fn save_request(grant: UIFSGrant) -> UIFileDialogRequest Never! {
    core.ui.host.save_request(grant)
}

fn file_filter(label: String, extensions: [String], mime_types: [String]) -> UIFileFilter UIHostError! {
    if label.len() == 0 && extensions.len() == 0 && mime_types.len() == 0 -> return Err(UIHostError.InvalidRequest)
    loop extension in extensions {
        if extension.len() == 0 -> return Err(UIHostError.InvalidRequest)
    }
    loop mime in mime_types {
        if mime.len() == 0 -> return Err(UIHostError.InvalidRequest)
    }
    core.ui.host.file_filter(label, extensions, mime_types)
}

fn file_filter_text() -> UIFileFilter Never! {
    core.ui.host.file_filter_text()
}

fn fs_grant(path: String, rights: UIFSRights) -> UIFSGrant UIHostError! {
    if path.trim() == "" || (!rights.read && !rights.write) -> return Err(UIHostError.InvalidRequest)
    core.ui.host.fs_grant(path, rights)
}

fn fs_rights_read() -> UIFSRights Never! { core.ui.host.fs_rights_read() }
fn fs_rights_write() -> UIFSRights Never! { core.ui.host.fs_rights_write() }
fn fs_rights_read_write() -> UIFSRights Never! { core.ui.host.fs_rights_read_write() }

fn shortcut(key: String, modifiers: UIShortcutModifiers) -[IO]> UIShortcut UIHostError! {
    if key.trim() == "" -> return Err(UIHostError.InvalidRequest)
    core.ui.host.shortcut(key, modifiers)
}

fn accessibility(role: String, label: String) -[IO]> UIAccessibility UIHostError! {
    if role.trim() == "" || label.trim() == "" -> return Err(UIHostError.InvalidRequest)
    core.ui.host.accessibility(role, label)
}

