use core as core
use __core_files_path_components as host_path
// core.ui.host — typed host capability leaves for dialogs and metadata.
//
// Every operation that crosses the process boundary is forwarded to the
// scoped provider.  Request construction and validation remain pure Jet code;
// cancellation, headless, and denied outcomes stay typed.

enum UICapability {
    FileDialog
    Clipboard
    IME
    DragDrop
    Shortcuts
    Accessibility
    FontShaping
}

enum UICancellation {
    User
    Closed
    Headless
    Superseded
    Programmatic
}

enum UIFileDialogKind {
    Open
    Save
}

enum UIFSAccess {
    Read
    Write
}

#Error
enum UIHostError {
    Cancelled
    Headless
    Denied
    Missing
    InvalidRequest(String)
    CapabilityUnavailable
    CapabilityDenied
    HostFailure
    ResourceDenied
    ShortcutConflict
    QueueFull
}

struct UICapabilityFact {
    capability: UICapability
    available: Bool
}

struct UICapabilityFacts {
    facts: [UICapabilityFact]
}

struct UIFSRights {
    bits: U8
}

struct UIFSGrant {
    root: String
    rights: UIFSRights
}

struct UIGrantedPath {
    path: String
    grant_root: String
    access: UIFSAccess
}

struct UIFileFilter {
    label: String
    extensions: [String]
    mime_types: [String]
}

struct UIFileDialogRequest {
    kind: UIFileDialogKind
    title: String
    grant: UIFSGrant
    initial_directory: UIGrantedPath?
    filters: [UIFileFilter]
    allow_multiple: Bool
}

struct UIFileDialogSelection {
    files: [UIGrantedPath]
}

struct UIShortcutModifiers {
    bits: Int
}

struct UIShortcut {
    key: String
    modifiers: UIShortcutModifiers
}
struct UITextRange {
    start: Int
    end: Int
}

struct UIClipboardText {
    text: String
    selection: UITextRange?
}

struct UIClipboardWrite {
    characters: Int
}

struct UINodeID {
    value: String
}

struct UIAccessibilityProjection {
    lines: [String]
}
struct UIShortcutBinding {
    shortcut: UIShortcut
    action: String
    node: UINodeID?
}

enum UIAccessibilityState {
    Disabled
    Busy
    Expanded(Bool)
    Checked(Bool)
    Selected(Bool)
    Required
    Value(String)
}

struct UIAccessibility {
    name: String?
    description: String?
    states: [UIAccessibilityState]
}

enum UIShortcutDispatch {
    Dispatched(UIShortcutBinding)
    Unhandled
}



fn capabilities() -> UICapabilityFacts Never! {
    #Unsafe("Core UI capability facts come from the current retained provider, not a fabricated default") {
        core.ui.host.__capabilities()
    }
}

fn open_file(request: UIFileDialogRequest) -[FS]> UIFileDialogSelection UIHostError! {
    #Unsafe("Core UI dialog crosses the current provider boundary; its typed cancellation and denial are preserved") {
        core.ui.host.__open_file(request)
    }
}

fn save_file(request: UIFileDialogRequest) -[FS]> UIFileDialogSelection UIHostError! {
    #Unsafe("Core UI save dialog crosses the current provider boundary with the original typed request") {
        core.ui.host.__save_file(request)
    }
}

fn open_request(grant: UIFSGrant) -> UIFileDialogRequest Never! {
    transfer_request(0, "Open File", grant, true, [UIFileFilter]{}, false)
}

fn save_request(grant: UIFSGrant) -> UIFileDialogRequest Never! {
    transfer_request(1, "Save File", grant, true, [UIFileFilter]{}, false)
}

fn transfer_request(kind: Int, title: String, grant: UIFSGrant, directory_absent: Bool, filters: [UIFileFilter], multiple: Bool) -> UIFileDialogRequest Never! {
    #Unsafe("Core UI dialog request transfer: validated grant and explicit absent directory, filter list, and multiple-selection slot") {
        core.ui.host.__request_transfer(kind, title, grant, directory_absent, filters, multiple)
    }
}

fn file_filter(label: String, extensions: [String], mime_types: [String]) -> UIFileFilter UIHostError! {
    if label.len() == 0 && extensions.len() == 0 && mime_types.len() == 0 -> return Err(UIHostError.InvalidRequest("file filter must name an extension, media type, or label"))
    loop extension in extensions {
        if extension.len() == 0 -> return Err(UIHostError.InvalidRequest("file filter extensions must not be empty"))
    }
    loop mime in mime_types {
        if mime.len() == 0 -> return Err(UIHostError.InvalidRequest("file filter media types must not be empty"))
    }
    Ok(UIFileFilter{label: label, extensions: extensions, mime_types: mime_types})
}

fn file_filter_text() -> UIFileFilter Never! {
    UIFileFilter{label: "Text", extensions: [String]{"txt"}, mime_types: [String]{"text/plain"}}
}

/// Normalize selected-platform lexical components without file I/O or symlink
/// resolution. Empty rights are valid; crossing the lexical root is denied.
fn fs_grant(path: String, rights: UIFSRights) -> UIFSGrant UIHostError! {
    if core.text.trim(path).len() == 0 -> return Err(UIHostError.InvalidRequest("filesystem grant path must not be empty"))
    platform :: if core.files.__path_windows() -> host_path.PathPlatform.Windows else -> host_path.PathPlatform.Unix
    input :: host_path.from_text(path, platform)
    normalized := host_path.from_text("", platform)
    cursor := host_path.components(input)
    rooted := false
    normal_depth := 0
    loop {
        part :: host_path.next(input, &cursor) ?? break
        if part.kind == .Prefix {
            host_path.push(&normalized, host_path.owned_span(input, part.span))
            rooted = true
        } else if part.kind == .RootDir {
            root :: host_path.OSPath{encoded: [U8]{host_path.main_separator(platform)}, platform: platform}
            host_path.push(&normalized, root)
            rooted = true
        } else if part.kind == .ParentDir {
            if normal_depth == 0 -> return Err(UIHostError.ResourceDenied("path `{path}` escapes its lexical root"))
            parent :: host_path.parent_span(normalized) ?? panic("normalized grant parent")
            host_path.truncate(&normalized.encoded, parent.end)
            normal_depth -= 1
        } else if part.kind == .Normal {
            host_path.push(&normalized, host_path.owned_span(input, part.span))
            normal_depth += 1
        }
    }
    if normalized.encoded.len() == 0 && rooted -> &normalized.encoded.push(host_path.main_separator(platform))
    root :: if normalized.encoded.len() == 0 -> "." else -> String.from_bytes(normalized.encoded) ?? panic("UTF-8 grant path")
    Ok(UIFSGrant{root: root, rights: rights})
}

fn fs_rights_read() -> UIFSRights Never! { UIFSRights{bits: U8{1}} }
fn fs_rights_write() -> UIFSRights Never! { UIFSRights{bits: U8{2}} }
fn fs_rights_read_write() -> UIFSRights Never! { UIFSRights{bits: U8{3}} }

fn shortcut(key: String, modifiers: UIShortcutModifiers) -[IO]> UIShortcut UIHostError! {
    normalized :: core.text.lower(core.text.trim(key))
    if normalized.len() == 0 -> return Err(UIHostError.InvalidRequest("shortcut key must not be empty"))
    Ok(UIShortcut{key: normalized, modifiers: modifiers})
}

/// The existing two-string API always names the node; an empty description
/// is absent. Whitespace remains data and initial accessibility states are empty.
fn accessibility(name: String, description: String) -[IO]> UIAccessibility UIHostError! {
    if name.len() == 0 -> return Err(UIHostError.InvalidRequest("accessibility name and description must not be empty"))
    detail :: if description.len() == 0 -> None else -> Val(description)
    Ok(UIAccessibility{name: Val(name), description: detail, states: [UIAccessibilityState]{}})
}

#Test("UI file-filter policy preserves labels and typed error payloads") {
    text :: file_filter_text()
    assert(text.label == "Text" && text.extensions == [String]{"txt"} && text.mime_types == [String]{"text/plain"})
    filter :: file_filter(" ", [String]{"jet"}, [String]{"text/x-jet"}) ?? panic("valid filter rejected")
    assert(filter.label == " " && filter.extensions == [String]{"jet"})
    if file_filter("", [String]{}, [String]{}) == .Err(error) {
        if error == .InvalidRequest(message) -> assert(message == "file filter must name an extension, media type, or label")
        else -> panic("wrong file-filter error")
    } else { panic("empty filter accepted") }
    if file_filter("Jet", [String]{""}, [String]{}) == .Err(error) {
        if error == .InvalidRequest(message) -> assert(message == "file filter extensions must not be empty")
        else -> panic("wrong extension error")
    } else { panic("empty extension accepted") }
    if file_filter("Jet", [String]{}, [String]{""}) == .Err(error) {
        if error == .InvalidRequest(message) -> assert(message == "file filter media types must not be empty")
        else -> panic("wrong media-type error")
    } else { panic("empty media type accepted") }
}

#Test("UI dialog request defaults occupy explicit carrier slots") {
    grant :: fs_grant(".", fs_rights_read_write()) ?? panic("valid grant rejected")
    open :: open_request(grant)
    save :: save_request(grant)
    assert(open.kind == .Open && open.title == "Open File")
    assert(save.kind == .Save && save.title == "Save File")
    assert(open.initial_directory == None && save.initial_directory == None)
    assert(open.filters.len() == 0 && save.filters.len() == 0)
    assert(!open.allow_multiple && !save.allow_multiple)
    assert(open.grant.root == grant.root && save.grant.root == grant.root)
}

#Test("UI filesystem rights constructors preserve canonical read and write bits") {
    read :: fs_rights_read()
    write :: fs_rights_write()
    both :: fs_rights_read_write()
    assert(read.bits == U8{1} && write.bits == U8{2} && both.bits == U8{3})
    assert(read != write && both != read && both != write)
    empty :: UIFSRights{}
    assert(empty.bits == U8{0})
    grant :: fs_grant(".", both) ?? panic("valid grant rejected")
    assert(grant.rights == both)
}


#Test("UI shortcut policy normalizes Unicode and preserves modifiers") {
    modifiers :: UIShortcutModifiers{}
    normalized :: shortcut(" \tÄBC İ \n", modifiers) ?? panic("valid shortcut rejected")
    assert(normalized.key == "äbc i̇")
    assert(normalized.modifiers == modifiers)
    spaced :: shortcut(" A B ", modifiers) ?? panic("valid spaced shortcut rejected")
    assert(spaced.key == "a b")
    command :: UIShortcut.cmd("a").modifiers
    commanded :: shortcut(" A ", command) ?? panic("valid command shortcut rejected")
    assert(commanded.modifiers == command)
    sigma :: shortcut("ΑΣ", modifiers) ?? panic("valid Greek shortcut rejected")
    assert(sigma.key == "ας")
    // U+3000, U+0085, U+2028 are Rust White_Space, not just ASCII trim bytes.
    padding :: String.from_bytes([U8]{227, 128, 128, 194, 133, 226, 128, 168}) ?? panic("valid whitespace bytes rejected")
    whitespace :: shortcut("{padding}A{padding}", modifiers) ?? panic("Unicode whitespace rejected")
    assert(whitespace.key == "a")
    if shortcut(" \t\n", modifiers) == .Err(error) {
        if error == .InvalidRequest(message) -> assert(message == "shortcut key must not be empty")
        else -> panic("wrong shortcut error")
    } else { panic("empty shortcut accepted") }
}

#Test("filesystem grants normalize lexical components without changing rights") {
    rights :: UIFSRights{bits: U8{0}}
    grant :: fs_grant("a/../b/./", rights) ?? panic("relative lexical grant")
    assert(grant.root == "b" && grant.rights.bits == (U8{0}))
    empty :: fs_grant(".", rights) ?? panic("current-directory grant")
    assert(empty.root == ".")
    if fs_grant("../outside", rights) == .Err(error) {
        if error == .ResourceDenied(message) -> assert(message == "path `../outside` escapes its lexical root")
        else -> panic("wrong lexical grant denial")
    } else { panic("escaping grant accepted") }
    if fs_grant(" \t\n", rights) == .Err(error) {
        if error == .InvalidRequest(message) -> assert(message == "filesystem grant path must not be empty")
        else -> panic("wrong empty grant error")
    } else { panic("empty grant accepted") }
}

#Test("accessibility keeps optional description and whitespace names") {
    named :: accessibility(" ", "") ?? panic("whitespace name")
    assert(named.name == .Val(name) && name == " ")
    assert(named.description == None && named.states.len() == 0)
    described :: accessibility("button", " ") ?? panic("whitespace description")
    assert(described.description == .Val(description) && description == " ")
    if accessibility("", "description") == .Err(error) {
        if error == .InvalidRequest(message) -> assert(message == "accessibility name and description must not be empty")
        else -> panic("wrong accessibility error")
    } else { panic("empty name accepted") }
}
