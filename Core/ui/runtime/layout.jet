        LinExpr{terms: terms, n_terms: 1, constant: 0.0, handle: Val(handle_id)}
    }
    // Rust: crates/jet-codegen/src/Prelude/Layout.rs:110
    fn combine(self: &LinExpr, other: &LinExpr, sign: Float) -> LinExpr {
        terms := self.terms
        n := self.n_terms as Int
        for (idx, coeff) in other.terms[0..other.n_terms as Int] {
            slot := None as Int?
            for i in 0..n { if terms[i].0 == idx { slot = Val(i); break } }
            if slot is Val(i) { terms[i].1 += sign * coeff } else {
                assert(n < MAX_TERMS, "layout constraint expression has more than {MAX_TERMS} distinct terms")
                terms[n] = (idx, sign * coeff)
                n += 1
            }
        }
        LinExpr{terms: terms, n_terms: n as U8, constant: self.constant + sign * other.constant,
            handle: self.handle.or(other.handle)}
    }
    // Rust: crates/jet-codegen/src/Prelude/Layout.rs:133
    fn eval(self: &LinExpr, solution: View<Float>) -> Float {
        v := self.constant
        for (idx, coeff) in self.terms[0..self.n_terms as Int] {
            v += coeff * (solution.get(idx) ?? 0.0)
        }
        v
    }
    // Rust: crates/jet-codegen/src/Prelude/Layout.rs:141
    fn terms(self: &LinExpr) -> View<(Int, Float)> { self.terms[0..self.n_terms as Int] }
}
