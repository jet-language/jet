//RS mod jet_layout {
//RS     // D-LAYOUT1 / D-LAYOUT-CTOR1: a Cassowary-style
//RS     // linear constraint solver backing `name :: Layout.{ … }`. I6: zero external
//RS     // crates — a hand-rolled two-phase primal simplex, plain std Rust only.
//RS     //
//RS     // Design (the sema/codegen half lives in Sema/CheckerCoreLib.rs,
//RS     // Sema/CheckerInfer/{binary,calls}.rs, Codegen/TIR/{mod,lower,emit}.rs):
//RS     //   * `HVar`/`VVar`/`LengthVar` all erase to `LinExpr` here — the
//RS     //     horizontal/vertical/neutral axis distinction is checked entirely at
//RS     //     compile time (GATE 1/2); there is nothing to represent at runtime.
//RS     //   * A `Layout.{ … }` body's `box.anchor` / `self.anchor` reads desugar
//RS     //     (parser, D-LAYOUT-CTOR1) to `NAME.h(box, anchor)` / `NAME.v(box, anchor)`
//RS     //     — both call the SAME internal `var()`, since the axis distinction is erased.
//RS     //   * `>=`/`<=`/`==` between layout values (GATE 1) lower to the free
//RS     //     functions `ge`/`le`/`eq_` below (Rust operator overloading can't
//RS     //     return a non-`bool` type via `>=`/`==` syntax).
//RS     //   * Layout values are assumed NON-NEGATIVE (widths, positions, gaps —
//RS     //     the universal case for UI layout; a signed-variable extension via
//RS     //     the standard `x = x+ - x-` split is a contained follow-up, not
//RS     //     needed for the ratified surface).
//RS     //   * Every constraint is REQUIRED by default; `.weak()`/`.medium()`/
//RS     //     `.strong()` (Cassowary-style priorities, collapsed to one weighted
//RS     //     objective rather than the paper's lexicographic objective stack —
//RS     //     see `Strength::weight`) turn it into a soft goal a conflicting
//RS     //     required constraint always wins against. Soft constraints use the
//RS     //     classic Cassowary "error variable" technique, which doubles as the
//RS     //     row's phase-1-feasible seed (no artificial ever needed for a soft
//RS     //     row); required rows use a standard two-phase artificial-variable
//RS     //     seed. This is a real, from-scratch re-solve on every `.add()`/
//RS     //     `.suggest()` (not Cassowary's incremental dual-simplex update) —
//RS     //     correct and fine at UI scale; true incrementality is a performance
//RS     //     follow-up, not a correctness requirement.
//RS     use std::cell::RefCell;
//RS     use std::collections::HashMap;
//RS     use std::rc::Rc;
//RS 
//RS     const EPS: f64 = 1e-7;
//RS 
//RS     // ---------------------------------------------------------------------
//RS     // Linear expressions — what `HVar`/`VVar`/`LengthVar` erase to.
//RS     // ---------------------------------------------------------------------
//RS 
//RS     /// Max distinct box-anchor variables one constraint EXPRESSION (one side
//RS     /// of a `>=`/`<=`/`==`, built by chaining `+`/`-`) can reference. Real
//RS     /// layout lines stay well under this (2-4 terms); generous headroom, not
//RS     /// a hard language limit — `combine` panics with a clear message if it's
//RS     /// ever exceeded (would mean a genuinely unusual expression, worth
//RS     /// surfacing loudly rather than silently truncating).
//RS     const MAX_TERMS: usize = 16;
//RS 
//RS     /// `LinExpr` is what `HVar`/`VVar`/`LengthVar` erase to — and it needs to
//RS     /// be `Copy`: a `layout {}` line routinely reuses a captured variable
//RS     /// (`xv :: form.h("x","width"); form.suggest(xv, 100.0); form.value(xv)`),
//RS     /// and Jet's general non-Copy-reuse clone-insertion doesn't (yet) know
//RS     /// about this closed type family, so a `Vec`/`Rc`-backed representation
//RS     /// would hit a real "use of moved value" in the generated Rust the first
//RS     /// time a variable was captured and used twice. A fixed-size term array
//RS     /// (no `Vec`) plus a `u32` handle INDEX into a thread-local registry (not
//RS     /// an `Rc` directly — `Rc` isn't `Copy`) keeps every field `Copy`.
//RS     #[derive(Clone, Copy)]
//RS     pub struct LinExpr {
//RS         terms: [(usize, f64); MAX_TERMS],
//RS         n_terms: u8,
//RS         constant: f64,
//RS         handle: Option<u32>,
//RS     }
//RS 
//RS     thread_local! {
//RS         /// The handle registry `LinExpr` indexes into (see `MAX_TERMS` doc).
//RS         /// Handles are never removed — a `layout {}` block's solver state
//RS         /// lives for the rest of the program, same as any other value.
