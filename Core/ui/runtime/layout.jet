// Rust: crates/jet-codegen/src/Prelude/Layout.rs:37
const EPS: Float = 1e-7
// Rust: crates/jet-codegen/src/Prelude/Layout.rs:49
const MAX_TERMS: Int = 16
// Rust: crates/jet-codegen/src/Prelude/Layout.rs:61
#Copy
pub struct LinExpr {
    terms: Array<(Int, Float), 16>
    n_terms: U8
    constant: Float
