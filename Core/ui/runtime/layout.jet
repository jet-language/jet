    }
}
// Rust: crates/jet-codegen/src/Prelude/Layout.rs:237
struct RowSpec {
    terms: [(Int, Float)]
    rhs: Float
    op: RelOp
    strength: Strength
    label: String
}
// Rust: crates/jet-codegen/src/Prelude/Layout.rs:247
fn normalize_row(row: RowSpec) -> RowSpec {
    row := row
    if row.rhs < 0.0 {
        row.rhs = -row.rhs
        for i in 0..row.terms.len() { row.terms[i].1 = -row.terms[i].1 }
        row.op = match row.op { .Le -> .Ge, .Ge -> .Le, .Eq -> .Eq }
    }
    row
}
// Rust: crates/jet-codegen/src/Prelude/Layout.rs:262
fn build_row(lhs: &LinExpr, rhs: &LinExpr, op: RelOp, strength: Strength, label: String) -> RowSpec {
    combined :: lhs.combine(rhs, -1.0)
    normalize_row(RowSpec{terms: combined.terms().to_list(), rhs: -combined.constant,
        op: op, strength: strength, label: label})
}
