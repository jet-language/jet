}
// Rust: crates/jet-codegen/src/Prelude/Layout.rs:68
// GATE #4565: kernel primitive — thread-local storage retains solver handles.
const HANDLE_REGISTRY: ThreadLocal<RefCell<[Rc<RefCell<Inner>>]>> = ThreadLocal.new(fn() { RefCell.new([]) })
// Rust: crates/jet-codegen/src/Prelude/Layout.rs:75
fn register_handle(inner: Rc<RefCell<Inner>>) -> U32 {
    #Unsafe("thread-local registry is accessed only on its owning thread") {
        HANDLE_REGISTRY.with(fn(r) {
            registry := r.borrow_mut()
            registry.push(inner)
            (registry.len() - 1) as U32
        })
    }
}
// Rust: crates/jet-codegen/src/Prelude/Layout.rs:83
fn handle_by_id(id: U32) -> Rc<RefCell<Inner>> {
    // GATE #4565: kernel primitive
    #Unsafe("registered handle index is read only on its owning thread") {
        HANDLE_REGISTRY.with(fn(r) { r.borrow()[id as Int].clone() })
    }
}
impl LinExpr {
    // Rust: crates/jet-codegen/src/Prelude/Layout.rs:90
    pub fn from_const(c: Float) -> LinExpr {
        LinExpr{terms: Array<(Int, Float), 16>.filled((0, 0.0)), n_terms: 0, constant: c, handle: None}
    }
    // Rust: crates/jet-codegen/src/Prelude/Layout.rs:99
    fn from_var(idx: Int, handle_id: U32) -> LinExpr {
