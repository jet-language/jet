            trimmed := text.trim_end() // #4303
            trimmed.to_string()
        })
    }
    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:1839
    pub fn render_count(self: &JetTuiBackend) -> I64 { self.state.lock().unwrap().render_count as I64 }
}
