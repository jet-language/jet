// Rust: crates/jet-codegen/src/Prelude/Ui.rs:1850
impl JetBackend for JetTuiBackendState {
    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:1851
    fn measure(self: &JetTuiBackendState, node: &JetUiNode, constraint: JetSizeConstraint) -> JetSize {
        size :: jet_ui_measure_tree(node, constraint)
        self.measured = Val(size)
        size
    }
    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:1857
    fn layout(self: &JetTuiBackendState, node: &JetUiNode, frame: JetRect) -> {
        _ :: node
        self.layout_frame = Val(frame)
        (cols, rows) :: tui_grid_dims(&frame)
        self.grid_cols = cols
        self.grid_rows = rows
        self.grid = tui_blank_grid(cols, rows)
    }
    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:1866
    fn paint(self: &JetTuiBackendState, node: &JetUiNode) -> {
        self.render_count += 1
        self.last_node = Val(node.clone())
        frame :: self.layout_frame ?? JetRect{x: 0.0, y: 0.0, width: node.width, height: node.height}
        if self.grid.is_empty() {
            (cols, rows) :: tui_grid_dims(&frame)
            self.grid_cols = cols
            self.grid_rows = rows
            self.grid = tui_blank_grid(cols, rows)
        }
        for r in 0..self.grid.len() { for c in 0..self.grid[r].len() { self.grid[r][c] = ' ' } }
        capabilities :: self.capabilities.clone()
        jet_ui_visit_tree(node, frame, fn(leaf, leaf_frame) {
            tui_write_label(&self.grid, &leaf_frame, &leaf.label, leaf.style.as_ref(), &capabilities)
        })
        jet_ui_bind_tree_clicks(node, "tui#0")
        focus := [] as [JetUiNode]
        jet_ui_collect_focus(node, &focus)
        if not focus.is_empty() { self.focused_index = Val(0); self.focus_nodes = focus }
    }
    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:1905
    fn on_event(self: &JetTuiBackendState, event: JetInputEvent) -> JetEventResult {
        if event is .Key(code) {
            if jet_ui_advance_focus(&self.focus_nodes, &self.focused_index, code, 0) is Val(result) {
                self.last_event = Val(result)
                return result
            }
        }
        result :: match event {
            .Key(code) if code.is_empty() -> JetEventResult.Ignored
            .Resize(size) if size.width <= 0.0 || size.height <= 0.0 -> JetEventResult.Ignored
            .Resize(size) -> {
                frame :: JetRect{x: 0.0, y: 0.0, width: size.width, height: size.height}
                (cols, rows) :: tui_grid_dims(&frame)
                self.layout_frame = Val(frame)
                self.grid_cols = cols
                self.grid_rows = rows
                self.grid = tui_blank_grid(cols, rows)
                JetEventResult.Handled
            }
            _ -> JetEventResult.Handled
        }
        self.last_event = Val(result)
        result
    }
    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:1938
    fn on_tui_event(self: &JetTuiBackendState, event: JetTuiEvent) -> JetEventResult {
        match event {
            .Key(code, modifiers) -> {
                if jet_ui_advance_focus(&self.focus_nodes, &self.focused_index, &code, modifiers) is Val(result) {
                    self.last_event = Val(result)
                    return result
                }
                result :: if code.is_empty() { JetEventResult.Ignored } else { JetEventResult.Handled }
                self.last_event = Val(result)
                result
            }
            .Resize(size) -> {
                result :: self.on_event(JetInputEvent.Resize(size))
                if result == .Handled {
                    if self.last_node.clone() is Val(node) {
                        frame :: self.layout_frame ?? JetRect{x: 0.0, y: 0.0, width: size.width, height: size.height}
                        self.layout(&node, frame)
                        self.paint(&node)
                    }
                }
                result
            }
            event -> {
                result :: JetBackend.on_tui_event(self, event)
                self.last_event = Val(result)
                result
            }
        }
    }
}
