        color: None, style: None,
        kind: if role == .Button { JetUiNodeKind.Button } else if role == .TextInput { JetUiNodeKind.TextInput } else { JetUiNodeKind.Custom },
        children: [], key: None, on_click: None, on_drop: None, shortcut: None}
}
