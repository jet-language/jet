// Rust: crates/jet-codegen/src/Prelude/Ui.rs:2391
pub fn jet_ui_bind_tree_clicks(node: &JetUiNode, path: String) -> {
    identity :: match jet_ui_node_id(node, path) { Ok(id) -> id, Err(_) -> return }
    if node.on_click is Val(slot) { jet_ui_bind_click(identity.clone(), slot) }
    if node.on_drop is Val(slot) { jet_ui_bind_drop(identity, slot) }
    if node.kind == .Box {
        for (index, child) in node.children.enumerate() { jet_ui_bind_tree_clicks(child, "{path}/{index}") }
    }
}
