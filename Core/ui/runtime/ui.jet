impl JetTuiBackend {
    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:1802
    pub fn paint_node(self: &JetTuiBackend, node: JetUiNode) -> {
        state := self.state.lock().unwrap()
        JetBackend.paint(&state, &node)
    }
    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:1808
    pub fn mount_node(self: &JetTuiBackend, node: JetUiNode, constraint: JetSizeConstraint) -> {
        size :: self.measure_node(node.clone(), constraint)
        self.layout_node(node.clone(), jet_ui_rect(0.0, 0.0, size.width, size.height))
        self.paint_node(node)
    }
    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:1817
    pub fn mount_node_default(self: &JetTuiBackend, node: JetUiNode) -> {
