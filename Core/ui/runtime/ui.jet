// Rust: crates/jet-codegen/src/Prelude/Ui.rs:2181
pub fn jet_ui_button_with_metadata(label: String, shortcut: JetOutcome<JetUiShortcut, JetAbsent>, accessible_label: JetOutcome<String, JetAbsent>) -> JetUiNode {
    node := jet_ui_button(label)
    node.shortcut = shortcut.ok()
    if accessible_label is Ok(name) {
        node.accessibility = Val(JetUiAccessibility{name: Val(name), description: None, states: []})
    }
    node
}
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:2201
pub fn jet_ui_button_on_click(label: String, shortcut: JetOutcome<JetUiShortcut, JetAbsent>, accessible_label: JetOutcome<String, JetAbsent>, handler: fn()) -> JetUiNode {
    node := jet_ui_button_with_metadata(label, shortcut, accessible_label)
    node.on_click = Val(jet_ui_register_click(handler))
    node
}
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:2213
pub fn jet_ui_box(children: [JetUiNode]) -> JetUiNode {
    width := 0.0
    height := 0.0
    for child in children { width = width.max(child.width); height += child.height }
    JetUiNode{label: "", width: width, height: height, role: Val(.Container), accessibility: None, ime: None,
        color: None, style: None, kind: .Box, children: children, key: None, on_click: None, on_drop: None, shortcut: None}
}
