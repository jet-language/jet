pub fn jet_ui_dispatch_drop(identity: &JetUiNodeId, items: [JetUiDropItem]) -> {
    slot :: jet_ui_drop_bindings().lock().unwrap_or_else(fn(e) { e.into_inner() }).get(identity).copied()
    slot :: slot ?? return
