        loop (index, item) in self.items.iter().enumerate().skip(state.offset).take(rows) {
            prefix :: if index == selected { "> " } else { "  " }
            children.push(jet_ui_text(jet_tui_truncate("{prefix}{item}", width)))
        }
        if children.is_empty() { children.push(jet_ui_text("")) }
        jet_ui_box(^children)
    }
}
