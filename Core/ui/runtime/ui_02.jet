// Rust: crates/jet-codegen/src/Prelude/Ui.rs:153
fn jet_ui_validate_file_dialog_selection(request: &JetUiFileDialogRequest, expected_kind: JetUiFileDialogKind, selection: &JetUiFileDialogSelection) -> () JetUiHostError! {
    if request.kind != expected_kind {
        operation :: match expected_kind { .Open -> "open_file", .Save -> "save_file" }
        return Err(JetUiHostError.InvalidRequest("{operation} requires a {expected_kind:?} dialog request"))
    }
    request.validate()?
    if selection.files.is_empty() -> return Err(JetUiHostError.InvalidRequest("a completed file dialog must select at least one file"))
    if !request.allow_multiple && selection.files.len() > 1 -> return Err(JetUiHostError.InvalidRequest("a single-selection dialog returned multiple files"))
    access :: match request.kind { .Open -> JetUiFsAccess.Read, .Save -> JetUiFsAccess.Write }
    loop selected in selection.files {
        scoped :: request.grant.scope(selected.path(), access)?
        if scoped.path() != selected.path() || scoped.grant_root() != selected.grant_root() || scoped.access() != selected.access() {
            return Err(JetUiHostError.ResourceDenied("file dialog selection `{selected.path()}` is outside its grant"))
        }
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:199
fn jet_ui_checked_file_dialog_result(request: &JetUiFileDialogRequest, expected_kind: JetUiFileDialogKind, result: JetUiFileDialogSelection JetUiHostError!) -> JetUiFileDialogSelection JetUiHostError! {
    match result {
        Ok(selection) -> {
            jet_ui_validate_file_dialog_selection(request, expected_kind, &selection)?
            Ok(^selection)
        }
        other -> other
    }
}
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:217
pub fn jet_ui_open_file(host: &JetUiHost, request: ^JetUiFileDialogRequest) -> JetUiFileDialogSelection JetUiHostError! {
    checked_request :: request.clone()
    jet_ui_checked_file_dialog_result(&checked_request, JetUiFileDialogKind.Open, host.open_file(^request))
}
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:231
pub fn jet_ui_save_file(host: &JetUiHost, request: ^JetUiFileDialogRequest) -> JetUiFileDialogSelection JetUiHostError! {
    checked_request :: request.clone()
    jet_ui_checked_file_dialog_result(&checked_request, JetUiFileDialogKind.Save, host.save_file(^request))
}
