// Deterministic character-grid output.
struct JetTuiBackendState {
    measured: JetSize?, layout_frame: JetRect?, grid: [[Char]], grid_cols: USize, grid_rows: USize,
    render_count: USize, last_event: JetEventResult?, capabilities: JetTuiCapabilities,
    // Retain the semantic tree so direct resize repaints the same view.
    last_node: JetUiNode?, focus_nodes: [JetUiNode], focused_index: USize?,
}
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:1687
fn tui_grid_dims(frame: &JetRect) -> (USize, USize) { (USize{frame.width.max(1.0).floor()}, USize{frame.height.max(1.0).floor()}) }
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:1693
fn tui_blank_grid(cols: USize, rows: USize) -> [[Char]] { (0..rows).map(fn(_) { [' '].repeat(cols) }).collect<[[Char]]>() }
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:1697
fn tui_write_label(grid: &[[Char]], frame: &JetRect, label: String, style: (&JetTuiStyle)?, capabilities: &JetTuiCapabilities) -> {
    (cols, rows) :: (grid.first().map(fn(r) { r.len() }).unwrap_or(0), grid.len())
    start_col :: USize{frame.x.max(0.0)}
    start_row :: USize{frame.y.max(0.0)}
    rendered :: style.map(fn(style) { style.render(label, capabilities) }).unwrap_or_else(fn() { label.to_string() })
    label :: if capabilities.unicode { jet_tui_strip_ansi(rendered) } else { jet_tui_ascii(jet_tui_strip_ansi(rendered)) }
    col := start_col
    loop ch in label.chars() {
        width :: jet_tui_char_width(ch)
        if width == 0 { next }
        if col < cols && start_row < rows {
            grid[start_row][col] = ch
            if width == 2 && col + 1 < cols { grid[start_row][col + 1] = ' ' }
        }
        col = col.saturating_add(width)
        if col >= cols { break }
    }
}
