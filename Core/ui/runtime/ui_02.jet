// One default mount viewport shared by every host.
pub const DEFAULT_MOUNT_COLS: F64 = 80.0
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:1410
pub const DEFAULT_MOUNT_ROWS: F64 = 24.0
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:1413
pub trait JetBackend {
    fn measure(self: &Self, node: &JetUiNode, constraint: JetSizeConstraint) -> JetSize
    fn layout(self: &Self, node: &JetUiNode, frame: JetRect) ->
    fn paint(self: &Self, node: &JetUiNode) ->
    fn on_event(self: &Self, event: ^JetInputEvent) -> JetEventResult
    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:1422
    fn on_tui_event(self: &Self, event: ^JetTuiEvent) -> JetEventResult {
        match event {
            .Key(code, _) -> self.on_event(JetInputEvent.Key(code: ^code))
            .Resize(size) -> self.on_event(JetInputEvent.Resize(size: size))
            .Timer(_, _) | .IO(_, _) | .Focus(_) | .Interrupt | .Close -> JetEventResult.Handled
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:1435
fn jet_ui_measure_tree(node: &JetUiNode, constraint: JetSizeConstraint) -> JetSize {
    natural :: if node.kind == JetUiNodeKind.Box {
        JetSize{width: node.children.iter().map(fn(child) { child.width }).fold(0.0, fn(a, b) { a.max(b) }), height: node.children.iter().map(fn(child) { child.height }).sum()}
    } else { JetSize{width: node.width, height: node.height} }
    JetSize{width: natural.width.clamp(constraint.min_width, constraint.max_width), height: natural.height.clamp(constraint.min_height, constraint.max_height)}
}
