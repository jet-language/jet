// Rust: crates/jet-codegen/src/Prelude/Ui.rs:1488
fn jet_ui_paint_tree(node: &JetUiNode, frame: JetRect, commands: &[JetPaintCmd]) -> {
    visit := fn(leaf, leaf_frame) {
        if leaf.kind != JetUiNodeKind.Text { commands.push(JetPaintCmd.FillRect(rect: leaf_frame, color: leaf.color.clone().unwrap_or_else(fn() { "#000000".to_string() }))) }
        commands.push(JetPaintCmd.Text(rect: leaf_frame, text: leaf.label.clone(), style: leaf.style.clone()))
    }
    jet_ui_visit_tree(node, frame, &visit)
}
