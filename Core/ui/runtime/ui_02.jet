fn jet_ui_collect_focus(node: &JetUiNode, out: &[JetUiNode]) -> {
    if node.role.as_ref().is_some_and(fn(role) { role.is_interactive() }) { out.push(node.clone()) }
    loop child in node.children { jet_ui_collect_focus(child, out) }
}
