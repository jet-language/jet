// Rust: crates/jet-codegen/src/Prelude/Ui.rs:833
fn jet_tui_table_line(values: &[String], columns: USize, width: USize) -> String {
    if columns == 0 { return "" }
    separators :: columns.saturating_sub(1) * 3
    column_width :: width.saturating_sub(separators) / columns
    line := ""
    loop index in 0..columns {
        if index > 0 { line.push_str(" | ") }
        value :: values.get(index).map(fn(value) { value.as_str() }).unwrap_or("")
        value :: jet_tui_truncate(value, column_width)
        if index + 1 < columns { line.push_str(jet_tui_pad(value, column_width)) }
        else { line.push_str(value) }
    }
    jet_tui_truncate(line, width)
}
impl JetTuiWidget for JetTuiTable {
    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:856
    fn render(self: &Self, area: JetRect) -> JetUiNode {
        columns :: self.headers.len().max(self.rows.iter().map(fn(row) { row.len() }).max().unwrap_or(0))
        if columns == 0 { return jet_ui_text("") }
        width :: USize{area.width.max(0.0).floor()}
        children := [JetUiNode]{}
        if !self.headers.is_empty() { children.push(jet_ui_text(jet_tui_table_line(&self.headers, columns, width))) }
        loop row in self.rows { children.push(jet_ui_text(jet_tui_table_line(row, columns, width))) }
        jet_ui_box(^children)
    }
}
