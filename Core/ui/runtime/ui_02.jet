// Rust: crates/jet-codegen/src/Prelude/Ui.rs:696
// Nested layouts share the same deterministic allocation and rounding policy.
pub fn jet_tui_layout(area: JetRect, direction: JetTuiDirection, constraints: ^[JetTuiConstraint]) -> [JetRect] {
    area :: Rect{x: Float{area.x}, y: Float{area.y}, width: Float{area.width}, height: Float{area.height}}
    constraints :: constraints.into_iter().map(fn(value) { value.kernel() }).collect<[TUIConstraint]>()
    tui_kernel.layout(area, direction.kernel(), constraints).into_iter().map(fn(rect) { JetRect{x: F64{rect.x}, y: F64{rect.y}, width: F64{rect.width}, height: F64{rect.height}} }).collect<[JetRect]>()
}
