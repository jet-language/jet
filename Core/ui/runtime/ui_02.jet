            if jet_ui_advance_focus(&self.focus_nodes, &self.focused_index, code, 0) is Val(result) {
                self.last_event = Val(result)
                return result
            }
        }
        result :: match event {
            .Key(code) -> if code.is_empty() { JetEventResult.Ignored } else { JetEventResult.Handled }
            .Resize(size) -> if size.width <= 0.0 || size.height <= 0.0 { JetEventResult.Ignored } else { JetEventResult.Handled }
        }
        self.last_event = Val(result)
