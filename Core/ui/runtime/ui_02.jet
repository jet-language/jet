// Rust: crates/jet-codegen/src/Prelude/Ui.rs:497
fn jet_tui_env_dimension(name: String, fallback: USize) -> USize {
    // GATE #4565: kernel primitive
    value :: #Unsafe("read actual process terminal dimension environment") { env.var(name).ok() }
    value.and_then(fn(value) { value.parse<USize>().ok() }).filter(fn(value) { *value > 0 }).unwrap_or(fallback)
}
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:505
fn jet_tui_env_flag(name: String) -> Bool {
    // GATE #4565: kernel primitive
    #Unsafe("read native environment flag without discarding non-Unicode values") { env.var_os(name).is_some_and(fn(value) { value != "0" }) }
}
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:511
// NO_COLOR is an unconditional no-ANSI override; FORCE_COLOR opts into color.
pub fn jet_tui_capabilities() -> JetTuiCapabilities {
    width :: jet_tui_env_dimension("COLUMNS", 80)
    height :: jet_tui_env_dimension("LINES", 24)
    // GATE #4565: kernel primitive
    term :: #Unsafe("read terminal presentation environment") { env.var("TERM").unwrap_or_default().to_ascii_lowercase() }
    // GATE #4565: kernel primitive
    color_term :: #Unsafe("read terminal color depth environment") { env.var("COLORTERM").unwrap_or_default().to_ascii_lowercase() }
    ascii :: jet_tui_env_flag("JET_TUI_ASCII") || term == "dumb"
    profile :: if ascii { JetTuiColorProfile.ASCII }
        else if color_term == "truecolor" || color_term == "24bit" || term.contains("truecolor") || term.contains("24bit") { JetTuiColorProfile.TrueColor }
        else if term.contains("256color") { JetTuiColorProfile.ANSI256 }
        else { JetTuiColorProfile.ANSI16 }
    // GATE #4565: kernel primitive
    no_color :: #Unsafe("test presence of native NO_COLOR environment entry") { env.var_os("NO_COLOR").is_some() }
    forced :: jet_tui_env_flag("FORCE_COLOR")
    // GATE #4565: kernel primitive
    terminal :: #Unsafe("query actual retained stdout terminal capability") { io.stdout().is_terminal() }
    capabilities := JetTuiCapabilities.for_profile(profile, width, height)
    capabilities.color = !no_color && profile != JetTuiColorProfile.ASCII && (terminal || forced)
    if no_color { capabilities.mouse = false; capabilities.clipboard = false }
    ^capabilities
}
