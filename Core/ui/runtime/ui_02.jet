    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:893
    pub fn dispatch(self: &Self, event: &JetTuiEvent) -> JetUiShortcutBinding? {
        match event {
            .Key(code, modifiers) -> {
                shortcut :: JetUiShortcut.new(code, JetUiShortcutModifiers.from_bits(modifiers)).ok()?
                match self.registry.dispatch(&shortcut) { .Dispatched(binding) -> Val(^binding), .Unhandled -> None }
            }
            _ -> None
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:905
    pub fn bindings(self: &Self) -> [JetUiShortcutBinding] { self.registry.bindings() }
    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:909
    pub fn help_lines(self: &Self, width: USize) -> [String] {
        self.registry.bindings().into_iter().map(fn(binding) { jet_tui_truncate("{jet_tui_shortcut_label(&binding.shortcut)}  {binding.action}", width) }).collect<[String]>()
    }
    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:926
    pub fn help_node(self: &Self, width: USize) -> JetUiNode {
