    }
}
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:936
fn jet_tui_shortcut_label(shortcut: &JetUiShortcut) -> String {
    modifiers :: shortcut.modifiers
    label := ""
    loop (modifier, text) in [(JetUiShortcutModifier.Control, "Ctrl-"), (JetUiShortcutModifier.Alt, "Alt-"), (JetUiShortcutModifier.Shift, "Shift-"), (JetUiShortcutModifier.Meta, "Meta-"), (JetUiShortcutModifier.Command, "Cmd-")] {
        if modifiers.contains(modifier) { label.push_str(text) }
    }
    label.push_str(shortcut.key)
    ^label
}
