// None means not a focus-routing event: normal key handling continues.
fn jet_ui_advance_focus(focus_nodes: &[JetUiNode], focused_index: &USize?, code: String, _modifiers: U8) -> JetEventResult? {
    if !code.eq_ignore_ascii_case("tab") || focus_nodes.is_empty() { return None }
    next :: match *focused_index { Val(i) -> (i + 1) % focus_nodes.len(), None -> 0 }
    *focused_index = Val(next)
    Val(JetEventResult.Handled)
}
