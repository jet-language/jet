impl JetTuiStatefulWidget for JetTuiList {
    type State = JetTuiListState
    // Rust: crates/jet-codegen/src/Prelude/Ui.rs:789
    fn render(self: &Self, area: JetRect, state: &Self.State) -> JetUiNode {
        rows :: USize{area.height.max(1.0).floor()}
        width :: USize{area.width.max(0.0).floor()}
        selected :: state.selected.min(self.items.len().saturating_sub(1))
        state.selected = selected
        if selected < state.offset { state.offset = selected }
        if rows > 0 && selected >= state.offset + rows { state.offset = selected + 1 - rows }
