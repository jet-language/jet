    fn jet_game_asset_watch_events(frame: String, expected_session_id: String) -> ([JetGameAssetWatchEvent], USize) Err! {
        value :: parse_json_strict(frame).map_err(fn(error) { "invalid game asset watch frame: {error.reason}" })?
        fields :: jet_game_control_object(&value)?
        if jet_game_control_required_text(fields, "protocol")? != JET_DEVTOOLS_PROTOCOL { return Err("game asset watch frame protocol mismatch") }
        if jet_game_control_required_text(fields, "session_id")? != expected_session_id { return Err("game asset watch frame session identity mismatch") }
        if jet_game_control_required_text(fields, "direction")? != "host_to_runtime" { return Err("game asset watch frame direction mismatch") }
        _ :: jet_game_control_optional_u64(fields, "started_at_ms")?.ok_or_else(fn() { "game asset watch frame requires started_at_ms" })?
        skipped_count :: jet_game_control_optional_u64(fields, "skipped")?.unwrap_or(0)
        skipped_count :: USize.try_from(skipped_count).map_err(fn(error) { "game asset watch frame skipped count is outside usize" })?
        if skipped_count > JET_GAME_ASSET_MAX_SKIPPED { return Err("game asset watch frame exceeds skipped count limit") }
        values :: match jet_game_control_field(fields, "events") {
            Val(DataTree.Array(values)) -> values
            _ -> return Err("game asset watch frame requires events")
        }
        if values.len() > JET_GAME_ASSET_MAX_EVENTS { return Err("game asset watch frame exceeds event limit") }
        events :: values.iter().map(fn(value) {
            fields :: jet_game_control_object(value)?
            root :: match jet_game_control_field(fields, "root") {
                Val(DataTree.Object(root)) -> root
                _ -> return Err("game asset watch event requires root")
            }
            root_id :: match jet_game_control_field(root, "id") {
                Val(DataTree.Text(value)) | Val(DataTree.TypedText(value)) -> value.clone()
                _ -> return Err("game asset watch root requires id")
            }
            root_path :: match jet_game_control_field(root, "path") {
                Val(DataTree.Text(value)) | Val(DataTree.TypedText(value)) -> value.clone()
                _ -> return Err("game asset watch root requires path")
            }
            logical_path :: jet_game_control_required_text(fields, "logical_path")?
            kind :: match jet_game_control_required_text(fields, "kind")?.as_str() {
                "created" -> JetGameAssetWatchEventKind.Created
                "changed" -> JetGameAssetWatchEventKind.Changed
                "deleted" -> JetGameAssetWatchEventKind.Deleted
                _ -> return Err("game asset watch event kind is unsupported")
            }
            root :: JetGameAssetRootIdentity.new(^root_id, ^root_path).map_err(fn(error) { error.to_string() })?
            JetGameAssetWatchEvent.new(^root, ^logical_path, kind).map_err(fn(error) { error.to_string() })
        }).collect()?
        Ok((^events, skipped_count))
    }
