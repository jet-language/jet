impl GameDevSession {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1790
    pub fn record_and_publish(self: &Self, fact: JetGameSampleFact) -> JetGameFrameReceipt Err! {
        if self.lifecycle == JetDevtoolsLifecycleState.Stopped { return Err("game dev session is stopped") }
        frame :: fact.frame_identity().clone()
        frame_sample :: match &fact { JetGameSampleFact.Frame(sample) -> Val(sample.clone()); _ -> None }
        timestamp_ms :: fact.timestamp_ns() / 1_000_000
        receipt :: self.record(^fact).map_err(fn(error) { error.to_string() })?
        self.overlay.set_frame_identity(frame.clone())
        self.draw_cursor = None
        source :: self.profiler.identity().source.clone()
        _ :: self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Frame(^frame))?
        if frame_sample == Val(sample) {
            if receipt.sample_sequence == Val(sequence) { sample.sequence = sequence }
            _ :: self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.FrameSample(^sample))?
        }
        _ :: self.push_game_event(timestamp_ms, ^source, GameDevEvent.Profile(receipt.clone()))?
        Ok(^receipt)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1830
    pub fn publish_diagnostic(self: &Self, timestamp_ms: U64, pause: JetGameErrorPause) -> [U64] Err! {
        if self.lifecycle == JetDevtoolsLifecycleState.Stopped { return Err("game dev session is stopped") }
        source :: self.profiler.identity().source.clone()
        profile := None
        overlay := None
        if self.overlay.error_pause_enabled() && self.profiler.profiler().state() == JetGameFrameProfilerState.Running {
            receipt :: self.profiler.error_pause(pause.source.clone(), pause.code.clone(), pause.message.clone()).map_err(fn(error) { error.to_string() })?
            fact :: self.overlay.error_pause(pause.source.source_id.clone(), self.profiler.identity().trace_identity().trace_id).map_err(fn(error) { error.message() })?
            self.phase = GameDevPhase.Paused
            self.frame_advance_pending = false
            self.draw_cursor = None
            self.envelope.lifecycle = JetDevtoolsLifecycleState.Error
            self.envelope.freshness = JetDevtoolsFreshnessFact.fresh(timestamp_ms)
            profile = Val(^receipt)
            overlay = Val(^fact)
        }
        sequences := [self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Diagnostic(^pause))?]
        if overlay == Val(fact) { sequences.push(self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Overlay(^fact))?) }
        if profile == Val(receipt) { sequences.push(self.push_game_event(timestamp_ms, ^source, GameDevEvent.Profile(^receipt))?) }
        Ok(^sequences)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1888
    pub fn publish_crash(self: &Self, timestamp_ms: U64, bundle: JetGameCrashBundle) -> U64 Err! {
        if self.lifecycle == JetDevtoolsLifecycleState.Stopped { return Err("game dev session is stopped") }
        if bundle.context.is_none() { bundle.context = self.trace_context().cloned() }
        expected_trace :: self.profiler.identity().trace_identity()
        if bundle.frame.trace_identity() != expected_trace { return Err("game crash frame identity does not match the live trace") }
        bundle.validate().map_err(fn(error) { error.to_string() })?
        source :: self.profiler.identity().source.clone()
        self.push_game_event(timestamp_ms, ^source, GameDevEvent.Crash(^bundle))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1908
    pub fn push_game_event(self: &Self, timestamp_ms: U64, source: String, event: GameDevEvent) -> U64 Err! {
        wire :: event.to_devtools_event(timestamp_ms, ^source)?
        sequence :: self.push_event(wire.clone())
        jet_devtools_publish_event_for_session(self.envelope.session_id, ^wire)
        Ok(sequence)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1921
    pub fn apply_asset_swap(self: &Self, timestamp_ms: U64, fact: JetGameChangeFact) -> JetGameSwapOutcome Err! { self.apply_game_swap(timestamp_ms, ^fact, JetGameChangeKind.Asset) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1930
    pub fn apply_script_reload(self: &Self, timestamp_ms: U64, fact: JetGameChangeFact) -> JetGameSwapOutcome Err! { self.apply_game_swap(timestamp_ms, ^fact, JetGameChangeKind.Script) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1939
    pub fn apply_world_reload(self: &Self, timestamp_ms: U64, fact: JetGameChangeFact) -> JetGameSwapOutcome Err! { self.apply_game_swap(timestamp_ms, ^fact, JetGameChangeKind.World) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1947
    fn apply_game_swap(self: &Self, timestamp_ms: U64, fact: JetGameChangeFact, kind: JetGameChangeKind) -> JetGameSwapOutcome Err! {
        if self.lifecycle == JetDevtoolsLifecycleState.Stopped { return Err("game dev session is stopped") }
        if fact.kind != kind { return Err("game swap operation `{kind.as_str()}` received `{fact.kind.as_str()}` fact") }
        outcome :: match kind {
            JetGameChangeKind.Asset -> self.swap_session.apply_asset_swap(^fact)?
            JetGameChangeKind.Script -> self.swap_session.apply_script_reload(^fact)?
            JetGameChangeKind.World -> self.swap_session.apply_world_reload(^fact)?
        }
        source :: self.profiler.identity().source.clone()
        _ :: self.push_game_event(timestamp_ms, ^source, GameDevEvent.GameSwap(outcome.clone()))?
        Ok(^outcome)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1973
    pub fn publish_overlay_metric(self: &Self, timestamp_ms: U64, value: JetGameOverlayMetricValue) -> U64 Err! {
        if self.lifecycle == JetDevtoolsLifecycleState.Stopped { return Err("game dev session is stopped") }
        self.overlay.observe_metric(value.metric, value.value, value.sampled_at_ns)
        frame :: self.overlay.frame_identity().cloned()
        source :: self.profiler.identity().source.clone()
        self.push_game_event(timestamp_ms, ^source, GameDevEvent.OverlayMetric{value: ^value, frame: ^frame})
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1992
    pub fn publish_overlay_output(self: &Self, timestamp_ms: U64, row: JetGameOverlayOutputRow) -> U64 Err! {
        if self.lifecycle == JetDevtoolsLifecycleState.Stopped { return Err("game dev session is stopped") }
        self.overlay.record_output(^row).map_err(fn(error) { error.message() })?
        row :: self.overlay.history().last().cloned().ok_or_else(fn() { "game overlay output was not retained" })?
        source :: self.profiler.identity().source.clone()
        self.push_game_event(timestamp_ms, ^source, GameDevEvent.OverlayOutput(^row))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:2013
    fn publish_overlay_command(self: &Self, timestamp_ms: U64, command: String) -> U64 Err! {
        self.overlay.record_command(timestamp_ms.saturating_mul(1_000_000), ^command).map_err(fn(error) { error.message() })?
        command :: self.overlay.commands().last().cloned().ok_or_else(fn() { "game overlay command was not retained" })?
        source :: self.profiler.identity().source.clone()
        self.push_game_event(timestamp_ms, ^source, GameDevEvent.OverlayCommand(^command))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:2031
    fn step_draw_event(self: &Self) -> JetGameDrawEvent? Err! {
        frame :: self.profiler.profiler().paused_frame().cloned().ok_or_else(fn() { "game frame debugger requires a paused frame" })?
        needs_cursor :: self.draw_cursor.as_ref().map(fn(cursor) { cursor.frame_identity() != &frame }).unwrap_or(true)
        if needs_cursor { self.draw_cursor = Val(self.profiler.draw_cursor(frame.clone()).map_err(fn(error) { error.to_string() })?) }
        events :: self.profiler.profiler().history().draw_events_for(&frame).map_err(fn(error) { error.to_string() })?
        self.draw_cursor.as_mut().ok_or_else(fn() { "game frame debugger cursor is unavailable" })?.step_forward(events).map_err(fn(error) { error.to_string() })
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:2063
    fn evaluate_world_request(self: &Self, request: JetGamePausedEvalRequest) -> JetGamePausedEvalResult {
        request_id :: request.request_id.clone()
        if self.profiler.profiler().state() == JetGameFrameProfilerState.Running { return game_dev_eval_result(^request_id, JET_GAME_PAUSED_EVAL_RUNNING) }
        frame :: match self.profiler.profiler().paused_frame() {
            Val(frame) -> frame
            None -> return game_dev_eval_result(^request_id, JET_GAME_PAUSED_EVAL_STALE)
        }
        if frame.frame_id != request.frame_id { return game_dev_eval_result(^request_id, JET_GAME_PAUSED_EVAL_STALE) }
        self.inspector.evaluate_request(^request)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:2080
    fn publish_transition(self: &Self, timestamp_ms: U64, operation: GameDevTransitionOperation, before: GameDevPhase,
        after: GameDevPhase, status: GameDevTransitionStatus, reason: String) -> U64 Err! {
        sequence :: self.next_transition_sequence
        self.next_transition_sequence = self.next_transition_sequence.saturating_add(1).max(1)
        self.launch_profile.record_phase(after, status, reason.clone())
        transition :: GameDevTransition{sequence: sequence, operation: operation, before: before, after: after, status: status,
            run_mode: self.run_mode, frame_index: self.frame_index, source_revision: self.profiler.identity().revision.clone(),
            selected_world_id: self.selected_world_id.clone(), selected_actor_id: self.selected_actor_id.clone(), reason: ^reason}
        source :: self.profiler.identity().source.clone()
        self.push_game_event(timestamp_ms, ^source, GameDevEvent.Transition(^transition))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:2113
    pub fn begin_simulation_frame(self: &Self) -> Bool {
        match self.phase {
            GameDevPhase.Playing | GameDevPhase.Simulating -> true
            GameDevPhase.FrameAdvance -> {
                if self.frame_advance_pending { self.frame_advance_pending = false; true } else { false }
            }
            _ -> false
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:2124
    pub fn finish_simulation_frame(self: &Self, timestamp_ms: U64, frame_index: U64) -> [U64] Err! {
        self.frame_index = frame_index
        if self.phase != GameDevPhase.FrameAdvance { return Ok([]) }
        source :: self.profiler.identity().source.clone()
        overlay :: self.overlay.pause()
        profile :: self.profiler.pause()
        self.phase = GameDevPhase.Paused
        self.draw_cursor = None
        sequences := [self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Overlay(^overlay))?]
        sequences.push(self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Profile(^profile))?)
        sequences.push(self.publish_transition(timestamp_ms, GameDevTransitionOperation.FrameAdvance, GameDevPhase.FrameAdvance,
            GameDevPhase.Paused, GameDevTransitionStatus.Applied, "one simulation frame completed")?)
        Ok(^sequences)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:2159
    fn validate_control_phase(self: &Self, control: &GameDevControl) -> () Err! {
        allowed :: match control {
            GameDevControl.Play | GameDevControl.Simulate -> self.phase == GameDevPhase.Editing || self.phase == GameDevPhase.Paused
            GameDevControl.Pause -> self.phase == GameDevPhase.Playing || self.phase == GameDevPhase.Simulating
            GameDevControl.Resume | GameDevControl.FrameAdvance | GameDevControl.Step | GameDevControl.SelectWorld(_)
                | GameDevControl.EditWorld(_) | GameDevControl.EvaluateWorld(_) | GameDevControl.Eject{..}
                | GameDevControl.Keep(_) | GameDevControl.Discard -> self.phase == GameDevPhase.Paused || self.phase == GameDevPhase.FrameAdvance
            GameDevControl.Edit | GameDevControl.SelectGameplayCategory(_) | GameDevControl.Input(_) | GameDevControl.Console(_)
                | GameDevControl.Autocomplete{..} | GameDevControl.ToggleOverlay | GameDevControl.SetOverlayVisible(_)
                | GameDevControl.SetInputCapture(_) | GameDevControl.SetErrorPauseEnabled(_) | GameDevControl.SetFilter(_)
                | GameDevControl.ToggleFilter(_) | GameDevControl.SelectMetric(_) | GameDevControl.DeselectMetric(_) -> true
        }
        if allowed { Ok(()) } else { Err("game control `{control.render_json()}` is not valid during `{self.phase.as_str()}`") }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:2205
    pub fn dispatch_control(self: &Self, timestamp_ms: U64, control: GameDevControl) -> [U64] Err! {
        if self.lifecycle == JetDevtoolsLifecycleState.Stopped { return Err("game dev session is stopped") }
        self.validate_control_phase(&control)?
        source :: self.profiler.identity().source.clone()
        sequences := [self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Control(control.clone()))?]
        is_play :: match &control { GameDevControl.Play -> true; _ -> false }
        match control {
            GameDevControl.Play | GameDevControl.Simulate -> {
                before :: self.phase
                if before != GameDevPhase.Editing && before != GameDevPhase.Paused { return Err("game run can start only from editing or paused") }
                self.run_mode = if is_play { GameDevRunMode.PlayInEditor } else { GameDevRunMode.SimulateInEditor }
                self.phase = if is_play { GameDevPhase.Playing } else { GameDevPhase.Simulating }
                overlay :: self.overlay.resume()
                profile :: self.profiler.resume()
                self.lifecycle = JetDevtoolsLifecycleState.Ready
                self.envelope.lifecycle = JetDevtoolsLifecycleState.Ready
                self.envelope.freshness = JetDevtoolsFreshnessFact.fresh(timestamp_ms)
                sequences.push(self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Overlay(^overlay))?)
                sequences.push(self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Profile(^profile))?)
                operation :: if is_play { GameDevTransitionOperation.Play } else { GameDevTransitionOperation.Simulate }
                sequences.push(self.publish_transition(timestamp_ms, operation, before, self.phase, GameDevTransitionStatus.Applied, "game run started")?)
            }
            GameDevControl.Edit -> {
                before :: self.phase
                self.phase = GameDevPhase.Editing
                self.run_mode = GameDevRunMode.Headless
                self.frame_advance_pending = false
                overlay :: self.overlay.pause()
                profile :: self.profiler.pause()
                self.draw_cursor = None
                sequences.push(self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Overlay(^overlay))?)
                sequences.push(self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Profile(^profile))?)
                sequences.push(self.publish_transition(timestamp_ms, GameDevTransitionOperation.Edit, before, GameDevPhase.Editing, GameDevTransitionStatus.Applied, "returned to source editing")?)
            }
            GameDevControl.Eject{world_id, actor_id} -> {
                if world_id.is_empty() || actor_id.is_empty() { return Err("eject requires non-empty world and actor ids") }
                before :: self.phase
                self.selected_world_id = Val(^world_id)
                self.selected_actor_id = Val(^actor_id)
                sequences.push(self.publish_transition(timestamp_ms, GameDevTransitionOperation.Eject, before, before, GameDevTransitionStatus.Applied, "live actor selected")?)
            }
            GameDevControl.Keep(request) -> {
                before :: self.phase
                if before != GameDevPhase.Paused && before != GameDevPhase.FrameAdvance { return Err("keep requires a paused game state") }
                self.inspector.validate_edit_request(&request).map_err(fn(error) { error.to_string() })?
                self.pending_world_edits.clear()
                sequences.push(self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.WorldEdit(^request))?)
                sequences.push(self.publish_transition(timestamp_ms, GameDevTransitionOperation.Keep, before, before, GameDevTransitionStatus.Applied, "source-backed game change accepted")?)
            }
            GameDevControl.Discard -> {
                before :: self.phase
                self.pending_world_edits.clear()
                sequences.push(self.publish_transition(timestamp_ms, GameDevTransitionOperation.Discard, before, before, GameDevTransitionStatus.Applied, "runtime changes discarded; authored source unchanged")?)
            }
            GameDevControl.SelectGameplayCategory(category) -> {
                if !self.policy.game_debug_data_enabled() { return Err("Gameplay Debugger categories are unavailable outside a development profile") }
                if category.trim().is_empty() || category.chars().any(fn(ch) { ch.is_control() }) { return Err("gameplay debugger category must be printable") }
                before :: self.phase
                self.selected_debugger_category = Val(^category)
                sequences.push(self.publish_transition(timestamp_ms, GameDevTransitionOperation.SelectCategory, before, before, GameDevTransitionStatus.Applied, "Gameplay Debugger category selected")?)
            }
            GameDevControl.Pause -> {
                before :: self.phase
                overlay :: self.overlay.pause()
                profile :: self.profiler.pause()
                self.phase = GameDevPhase.Paused
                self.frame_advance_pending = false
                self.draw_cursor = None
                sequences.push(self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Overlay(^overlay))?)
                sequences.push(self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Profile(^profile))?)
                sequences.push(self.publish_transition(timestamp_ms, GameDevTransitionOperation.Pause, before, GameDevPhase.Paused, GameDevTransitionStatus.Applied, "simulation paused")?)
            }
            GameDevControl.Resume -> {
                before :: self.phase
                overlay :: self.overlay.resume()
                profile :: self.profiler.resume()
                self.phase = match self.run_mode {
                    GameDevRunMode.PlayInEditor -> GameDevPhase.Playing
                    GameDevRunMode.SimulateInEditor -> GameDevPhase.Simulating
                    GameDevRunMode.Headless -> GameDevPhase.Playing
                }
                self.frame_advance_pending = false
                self.draw_cursor = None
                self.lifecycle = JetDevtoolsLifecycleState.Ready
                self.envelope.lifecycle = JetDevtoolsLifecycleState.Ready
                self.envelope.freshness = JetDevtoolsFreshnessFact.fresh(timestamp_ms)
                sequences.push(self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Overlay(^overlay))?)
                sequences.push(self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Profile(^profile))?)
                sequences.push(self.publish_transition(timestamp_ms, GameDevTransitionOperation.Resume, before, self.phase, GameDevTransitionStatus.Applied, "simulation resumed")?)
            }
            GameDevControl.Step -> {
                if self.step_draw_event()? == Val(event) { sequences.push(self.push_game_event(timestamp_ms, ^source, GameDevEvent.DrawEvent(^event))?) }
            }
            GameDevControl.FrameAdvance -> {
                before :: self.phase
                if before != GameDevPhase.Paused { return Err("frame advance requires a paused game state") }
                self.frame_advance_pending = true
                self.phase = GameDevPhase.FrameAdvance
                overlay :: self.overlay.resume()
                profile :: self.profiler.resume()
                sequences.push(self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Overlay(^overlay))?)
                sequences.push(self.push_game_event(timestamp_ms, source.clone(), GameDevEvent.Profile(^profile))?)
                sequences.push(self.publish_transition(timestamp_ms, GameDevTransitionOperation.FrameAdvance, before, GameDevPhase.FrameAdvance, GameDevTransitionStatus.Applied, "one simulation frame requested")?)
            }
            GameDevControl.Input(input) -> self.last_input = Val(^input)
            GameDevControl.Console(command) -> sequences.push(self.publish_overlay_command(timestamp_ms, ^command)?)
            GameDevControl.Autocomplete{query, commands} -> {
                fact :: self.overlay.autocomplete(^query, &commands).map_err(fn(error) { error.message() })?
                sequences.push(self.push_game_event(timestamp_ms, ^source, GameDevEvent.OverlayAutocomplete(^fact))?)
            }
            GameDevControl.ToggleOverlay -> {
                fact :: self.overlay.set_visible(!self.overlay.visibility().visible)
                sequences.push(self.push_game_event(timestamp_ms, ^source, GameDevEvent.Overlay(^fact))?)
            }
            GameDevControl.SetOverlayVisible(visible) -> {
                fact :: self.overlay.set_visible(visible)
                sequences.push(self.push_game_event(timestamp_ms, ^source, GameDevEvent.Overlay(^fact))?)
            }
            GameDevControl.SetInputCapture(capture) -> {
                fact :: self.overlay.set_input_capture(capture)
                sequences.push(self.push_game_event(timestamp_ms, ^source, GameDevEvent.Overlay(^fact))?)
            }
            GameDevControl.SetErrorPauseEnabled(enabled) -> {
                fact :: self.overlay.set_error_pause_enabled(enabled)
                sequences.push(self.push_game_event(timestamp_ms, ^source, GameDevEvent.Overlay(^fact))?)
            }
            GameDevControl.SetFilter(filter) -> {
                fact :: self.overlay.set_filter(^filter)
                sequences.push(self.push_game_event(timestamp_ms, ^source, GameDevEvent.Overlay(^fact))?)
            }
            GameDevControl.ToggleFilter(category) -> {
                fact :: self.overlay.toggle_filter(category)
                sequences.push(self.push_game_event(timestamp_ms, ^source, GameDevEvent.Overlay(^fact))?)
            }
            GameDevControl.SelectMetric(metric) -> {
                fact :: self.overlay.select_metric(metric).map_err(fn(error) { error.message() })?
                sequences.push(self.push_game_event(timestamp_ms, ^source, GameDevEvent.Overlay(^fact))?)
            }
            GameDevControl.DeselectMetric(metric) -> {
                fact :: self.overlay.deselect_metric(metric)
                sequences.push(self.push_game_event(timestamp_ms, ^source, GameDevEvent.Overlay(^fact))?)
            }
            GameDevControl.SelectWorld(selection) -> {
                self.selected_world_id = Val(selection.world_id.clone())
                self.selected_actor_id = selection.entity_id.clone()
                self.inspector.select(^selection).map_err(fn(error) { error.to_string() })?
                if self.inspector.project() == Val(projection) { sequences.push(self.push_game_event(timestamp_ms, ^source, GameDevEvent.WorldSelection(^projection))?) }
            }
            GameDevControl.EditWorld(request) -> {
                self.inspector.validate_edit_request(&request).map_err(fn(error) { error.to_string() })?
                if self.pending_world_edits.len() >= 256 { _ :: self.pending_world_edits.remove(0) }
                self.pending_world_edits.push(request.clone())
                sequences.push(self.push_game_event(timestamp_ms, ^source, GameDevEvent.WorldEdit(^request))?)
            }
            GameDevControl.EvaluateWorld(request) -> {
                result :: self.evaluate_world_request(^request)
                sequences.push(self.push_game_event(timestamp_ms, ^source, GameDevEvent.WorldEvaluation(^result))?)
            }
        }
        Ok(^sequences)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:2584
    pub fn stop(self: &Self, timestamp_ms: U64, reason: String) -> () Err! {
        if self.lifecycle == JetDevtoolsLifecycleState.Stopped { return Ok(()) }
        if reason.trim().is_empty() || reason.chars().any(fn(ch) { ch.is_control() }) { return Err("game stop reason must be printable") }
        frame_index :: self.frame_index
        self.lifecycle = JetDevtoolsLifecycleState.Stopped
        self.envelope.lifecycle = JetDevtoolsLifecycleState.Stopped
        self.envelope.freshness = JetDevtoolsFreshnessFact.fresh(timestamp_ms)
        jet_devtools_clear_commands(self.envelope.session_id)
        _ :: jet_devtools_clear_game_control_relays()
        self.push_game_event(timestamp_ms, self.profiler.identity().source.clone(), GameDevEvent.Stopped(GameDevStopped.new(^reason, frame_index))).map(fn(sequence) { () })
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:2606
    pub fn ingest_world(self: &Self, world: JetGameWorldFact) -> Result<(), JetGameWorldInspectorError> { self.inspector.ingest(^world) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:2613
    pub fn ingest_world_and_publish(self: &Self, timestamp_ms: U64, world: JetGameWorldFact) -> U64 Err! {
        self.ingest_world(world.clone()).map_err(fn(error) { error.to_string() })?
