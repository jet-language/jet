}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:3605
fn game_dev_json_string(value: String) -> String {
    output := String.with_capacity(value.len() + 2)
    output.push('"')
    for character in value.chars() {
        match character {
            '"' -> output.push_str("\\\"")
            '\\' -> output.push_str("\\\\")
            '\n' -> output.push_str("\\n")
            '\r' -> output.push_str("\\r")
            '\t' -> output.push_str("\\t")
            character -> {
                if character.is_control() { output.push_str("\\u{character as U32:04x}") }
                else { output.push(character) }
            }
        }
    }
    output.push('"')
    ^output
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:3625
fn game_dev_json_option(value: String?) -> String { value.map(game_dev_json_string).unwrap_or_else(fn() { "null" }) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:3631
fn game_dev_function_identity_json(function: &JetGameFunctionIdentity) -> String {
    "{{\"function_id\":{game_dev_json_string(function.function_id)},\"name\":{game_dev_json_string(function.name)},\"source\":{game_dev_source_span_json(function.source)}}}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:3640
fn game_dev_source_span_json(source: &JetGameSourceSpan) -> String {
    "{{\"source_id\":{game_dev_json_string(source.source_id)},\"file\":{game_dev_json_string(source.file)},\"start_line\":{source.start_line},\"start_column\":{source.start_column},\"end_line\":{source.end_line},\"end_column\":{source.end_column}}}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:3652
fn game_dev_frame_identity_json(frame: &JetGameFrameIdentity) -> String {
    "{{\"frame_id\":{frame.frame_id},\"scene\":{game_dev_json_string(frame.scene)},\"frame_index\":{frame.frame_index},\"build\":{game_dev_json_string(frame.build)},\"revision\":{game_dev_json_string(frame.revision)},\"trace_id\":{game_dev_json_string(frame.trace_id)}}}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:3665
fn game_profile_snapshot_json(snapshot: &GameProfileSnapshot) -> String {
    assets :: snapshot.identity.assets.iter().map(JetGameAssetNodeIdentity.render_json).collect().join(",")
    hot_paths :: snapshot.projection.hot_paths.iter().map(fn(path) {
        "{{\"function_id\":{game_dev_json_string(path.function.function_id)},\"domain\":{game_dev_json_string(path.domain.as_str())},\"sample_count\":{path.sample_count},\"frame_count\":{path.frame_count},\"total_ns\":{path.total_ns},\"max_ns\":{path.max_ns}}}"
    }).collect().join(",")
    "{{\"identity\":{{\"scene\":{game_dev_json_string(snapshot.identity.scene)},\"build\":{game_dev_json_string(snapshot.identity.build)},\"target\":{game_dev_json_string(snapshot.identity.target)},\"assets\":[{assets}]}},\"run\":{{\"session\":{game_dev_json_string(snapshot.run.session)},\"source\":{game_dev_json_string(snapshot.run.source)},\"build\":{game_dev_json_string(snapshot.run.build)},\"revision\":{game_dev_json_string(snapshot.run.revision)}}},\"trace_identity\":{{\"build\":{game_dev_json_string(snapshot.trace_identity.build)},\"revision\":{game_dev_json_string(snapshot.trace_identity.revision)},\"trace_id\":{game_dev_json_string(snapshot.trace_identity.trace_id)}}},\"projection\":{{\"retained_samples\":{snapshot.projection.retained_samples},\"capacity\":{snapshot.projection.capacity},\"dropped_samples\":{snapshot.projection.dropped_samples},\"total_function_ns\":{snapshot.projection.total_function_ns},\"hot_paths\":[{hot_paths}]}}}}"
}

