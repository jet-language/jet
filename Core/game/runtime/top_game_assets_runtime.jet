use core.game.runtime.kernel_game_asset_pipeline.[JetGameAssetStore, JetGameAssetRootSet,
    JetGameAssetPipelineError, JetGameAssetSourceIdentity, JetGameAssetArtifactIdentity,
    JetGameAssetNodeIdentity, JetGameAssetReloadReceipt, JetGameAssetReloadTransaction,
    JetGameAssetImportPlan, JetGameAssetImportOutcome, JetGameAssetTransactionReceipt]
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsRuntime.rs:1
// Canonical checked replacement store owns cache/locks/revisions/rollback;
// this boundary never maintains a second copy of publication state.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsRuntime.rs:7
#Clone
struct GameAssetRuntimeAdapter { store: JetGameAssetStore }
impl GameAssetRuntimeAdapter {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsRuntime.rs:13
    fn new() -> Self { Self{store: JetGameAssetStore.new()} }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsRuntime.rs:19
    fn with_roots(roots: JetGameAssetRootSet) -> Self JetGameAssetPipelineError! {
        Ok(Self{store: JetGameAssetStore.with_roots(^roots)?})
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsRuntime.rs:27
    fn revision(self: &Self) -> U64 { self.store.revision() }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsRuntime.rs:31
    fn ready(self: &Self, source: &JetGameAssetSourceIdentity) -> JetGameAssetArtifactIdentity? {
        self.store.ready(source)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsRuntime.rs:38
    fn ready_for_node(self: &Self, node: &JetGameAssetNodeIdentity) -> JetGameAssetArtifactIdentity? {
        self.store.ready_for_node(node)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsRuntime.rs:45
    fn ready_assets(self: &Self) -> [JetGameAssetArtifactIdentity] { self.store.ready_assets() }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsRuntime.rs:49
    fn latest(self: &Self, source: &JetGameAssetSourceIdentity) -> JetGameAssetReloadReceipt? {
        self.store.latest(source)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsRuntime.rs:56
    fn begin_transaction(self: &Self) -> JetGameAssetReloadTransaction { self.store.begin_transaction() }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsRuntime.rs:60
    fn begin_at(self: &Self, revision: U64) -> JetGameAssetReloadTransaction { self.store.begin_at(revision) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsRuntime.rs:64
    fn apply(self: &Self, plan: JetGameAssetImportPlan,
        outcome: JetGameAssetImportOutcome) -> JetGameAssetTransactionReceipt {
        self.store.apply(^plan, ^outcome)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsRuntime.rs:72
    fn apply_at(self: &Self, revision: U64, plan: JetGameAssetImportPlan,
        outcome: JetGameAssetImportOutcome) -> JetGameAssetTransactionReceipt {
        self.store.apply_at(revision, ^plan, ^outcome)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsRuntime.rs:80
    fn apply_transaction(self: &Self, entries: [(JetGameAssetImportPlan, JetGameAssetImportOutcome)]) -> JetGameAssetTransactionReceipt Err! {
        transaction := self.store.begin_transaction()
        loop (plan, outcome) in entries {
            if transaction.stage(^plan, ^outcome) == Err(error) {
                _ :: transaction.rollback()
                return Err(error.to_string())
            }
        }
        Ok(transaction.commit())
    }
