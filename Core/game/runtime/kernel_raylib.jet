// Rust: crates/jet-codegen/src/Prelude/Core/Raylib.rs:33
// GATE #4565: kernel primitive — per-thread draw-call record ownership.
JET_RAYLIB_DRAW_CALLS :: ThreadLocal<RefCell<[JetRaylibSpriteDrawCall]>>.new(fn() { RefCell.new([]) })
// Rust: crates/jet-codegen/src/Prelude/Core/Raylib.rs:38
#Unsafe("append only to the calling thread's draw-call registry")
pub fn jet_raylib_record_draw_call(call: JetRaylibSpriteDrawCall) -> {
    JET_RAYLIB_DRAW_CALLS.with(calls -> calls.borrow_mut().push(^call))
}
// Rust: crates/jet-codegen/src/Prelude/Core/Raylib.rs:43
#Unsafe("move the calling thread's draw calls out and replace with an empty registry")
pub fn jet_raylib_take_draw_calls() -> [JetRaylibSpriteDrawCall] {
    JET_RAYLIB_DRAW_CALLS.with(calls -> {
        values := calls.borrow_mut()
        std.mem.take(&values)
    })
}
// Rust: crates/jet-codegen/src/Prelude/Core/Raylib.rs:47
pub fn jet_raylib_sprite_draw_call(atlas_name: &String, regions: &[JetRaylibAtlasRegion], region: &String, x: I64, y: I64) -> JetRaylibSpriteDrawCall? {
    region_data :: regions.iter().find(item -> item.name == region)?
    Val(JetRaylibSpriteDrawCall{atlas: atlas_name.to_string(), region: region.to_string(), x: x, y: y,
        source_x: region_data.x, source_y: region_data.y, width: region_data.width, height: region_data.height})
}
// Rust: crates/jet-codegen/src/Prelude/Core/Raylib.rs:67
// GATE #4565: kernel primitive — native lexical path and actual UTF-8 file read.
#Unsafe("read the atlas using selected native path semantics; failed read retains the original fallback behavior")
pub fn jet_raylib_load_texture_atlas_spec(path: &String) -> JetRaylibAtlasSpec {
    fallback_name :: OSPath.from(path).file_stem().and_then(name -> name.to_str()).unwrap_or("atlas").to_string()
    text :: fs.read_to_string(OSPath.from(path)).ok()
    jet_raylib_parse_texture_atlas(path, text.as_deref(), fallback_name)
}
// Rust: crates/jet-codegen/src/Prelude/Core/Raylib.rs:77
fn jet_raylib_parse_texture_atlas(path: &String, text: String?, fallback_name: String) -> JetRaylibAtlasSpec {
    name := fallback_name
    texture_path: String? = None
    regions := []
    if text is Val(text) {
        for raw in text.lines() {
            line := raw.trim() // #4303
            if line.is_empty() -> continue
            if line.strip_prefix("atlas:") is Val(value) {
                value := value.trim() // #4303
                if not value.is_empty() { name = value.to_string() }
            } else if line.strip_prefix("texture:") is Val(value) {
                value := value.trim() // #4303
                if not value.is_empty() { texture_path = Val(jet_raylib_atlas_texture_path(path, &value)) }
            } else if jet_raylib_atlas_region(&line) is Val(region) { regions.push(^region) }
        }
    }
    if texture_path.is_none() {
        // GATE #4565: kernel primitive — selected-target lexical path extension.
        texture_path = Val(#Unsafe("replace the atlas suffix without accessing the filesystem") {
            OSPath.from(path).with_extension("png").to_string_lossy().to_string()
        })
    }
    JetRaylibAtlasSpec{path: path.to_string(), name: name, texture_path: texture_path, regions: regions}
}
// Rust: crates/jet-codegen/src/Prelude/Core/Raylib.rs:116
fn jet_raylib_atlas_region(line: &String) -> JetRaylibAtlasRegion? {
    rest :: line.strip_prefix("region:").or_else(fn() { line.strip_prefix("region ") })?
    fields := rest.split_whitespace()
    name :: fields.next()?.to_string()
    x :: fields.next()?.parse<I64>().ok()?
    y :: fields.next()?.parse<I64>().ok()?
    width :: fields.next()?.parse<I64>().ok()?
    height :: fields.next()?.parse<I64>().ok()?
    Val(JetRaylibAtlasRegion{name: name, x: x, y: y, width: width, height: height})
}
// Rust: crates/jet-codegen/src/Prelude/Core/Raylib.rs:135
// GATE #4565: kernel primitive — selected-target native lexical path operations.
#Unsafe("resolve a texture lexically relative to its atlas; no canonicalization or filesystem access")
fn jet_raylib_atlas_texture_path(atlas_path: &String, texture: &String) -> String {
    texture_path :: OSPath.from(texture)
    if texture_path.is_absolute() { texture_path.to_string_lossy().to_string() }
    else { OSPath.from(atlas_path).parent().unwrap_or_else(fn() { OSPath.from(".") }).join(texture_path).to_string_lossy().to_string() }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Raylib.rs:149
pub fn jet_raylib_button_code(name: &String) -> I32? {
    match name {
        "A" | "a" | "South" | "south" | "RightFaceDown" | "right_face_down" -> Val(I32{7})
        "B" | "b" | "East" | "east" | "RightFaceRight" | "right_face_right" -> Val(I32{6})
        "X" | "x" | "West" | "west" | "RightFaceLeft" | "right_face_left" -> Val(I32{8})
        "Y" | "y" | "North" | "north" | "RightFaceUp" | "right_face_up" -> Val(I32{5})
        "DPadUp" | "dpad_up" | "LeftFaceUp" | "left_face_up" -> Val(I32{1})
        "DPadRight" | "dpad_right" | "LeftFaceRight" | "left_face_right" -> Val(I32{2})
        "DPadDown" | "dpad_down" | "LeftFaceDown" | "left_face_down" -> Val(I32{3})
        "DPadLeft" | "dpad_left" | "LeftFaceLeft" | "left_face_left" -> Val(I32{4})
        "LeftShoulder" | "left_shoulder" | "LeftTrigger1" | "left_trigger_1" -> Val(I32{9})
        "LeftTrigger" | "left_trigger" | "LeftTrigger2" | "left_trigger_2" -> Val(I32{10})
        "RightShoulder" | "right_shoulder" | "RightTrigger1" | "right_trigger_1" -> Val(I32{11})
        "RightTrigger" | "right_trigger" | "RightTrigger2" | "right_trigger_2" -> Val(I32{12})
        "Back" | "back" | "MiddleLeft" | "middle_left" -> Val(I32{13})
        "Start" | "start" | "Middle" | "middle" -> Val(I32{14})
        "Guide" | "guide" | "MiddleRight" | "middle_right" -> Val(I32{15})
        "LeftThumb" | "left_thumb" -> Val(I32{16})
        "RightThumb" | "right_thumb" -> Val(I32{17})
        "Left" | "left" -> Val(I32{18})
        "Right" | "right" -> Val(I32{19})
        _ -> None
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Raylib.rs:174
pub fn jet_raylib_axis_code(name: &String) -> I32? {
    match name {
        "LeftX" | "left_x" | "leftx" -> Val(I32{0})
        "LeftY" | "left_y" | "lefty" -> Val(I32{1})
        "RightX" | "right_x" | "rightx" -> Val(I32{2})
        "RightY" | "right_y" | "righty" -> Val(I32{3})
        "LeftTrigger" | "left_trigger" | "lefttrigger" -> Val(I32{4})
        "RightTrigger" | "right_trigger" | "righttrigger" -> Val(I32{5})
        _ -> None
    }
}
