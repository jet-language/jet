pub struct JetRaylibAtlasRegion {
    pub name: String
    pub x: I64
    pub y: I64
    pub width: I64
    pub height: I64
}
// Rust: crates/jet-codegen/src/Prelude/Core/Raylib.rs:14
#Equatable
