// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1141
// Frozen projection owns only copied canonical profiler facts.
#Derive(Clone, Debug, Eq, PartialEq)
pub struct GameProfileSnapshot {
    pub identity: GameProfileIdentity
    pub run: GameDevRunIdentity
    pub trace_identity: JetGameTraceIdentity
    pub projection: JetGameBottleneckProjection
}
impl GameProfileSnapshot {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1152
    pub fn from_profiler(profiler: &JetGameFrameProfiler, run: GameDevRunIdentity, identity: GameProfileIdentity) -> Self GameProfileComparisonError! {
        if profiler.state != JetGameFrameProfilerState.Paused {
            return Err(GameProfileComparisonError.Incomplete("profile", profiler.state))
        }
        trace_identity :: profiler.trace_identity.clone()
        if run.build != trace_identity.build {
            return Err(GameProfileComparisonError.IncompatibleIdentity("build", ^run.build, ^trace_identity.build))
        }
        if run.revision != trace_identity.revision {
            return Err(GameProfileComparisonError.IncompatibleIdentity("revision", ^run.revision, ^trace_identity.revision))
        }
        if run.source != trace_identity.trace_id {
            return Err(GameProfileComparisonError.IncompatibleIdentity("source", ^run.source, ^trace_identity.trace_id))
        }
        if trace_identity.build != identity.build {
            return Err(GameProfileComparisonError.IncompatibleIdentity("build", ^identity.build, ^trace_identity.build))
        }
        projection :: profiler.bottleneck(128)
        Ok(Self{identity: ^identity, run: ^run, trace_identity: ^trace_identity, projection: ^projection})
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1201
    pub fn from_ring(ring: &GameDevProfileRing, identity: GameProfileIdentity) -> Self GameProfileComparisonError! {
        Self.from_profiler(&ring.profiler, ring.identity.clone(), ^identity)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1209
#Derive(Clone, Debug, Eq, PartialEq)
pub struct GameProfileComparison { pub left: GameProfileSnapshot, pub right: GameProfileSnapshot, pub total_function_ns_delta: I128 }
impl GameProfileComparison {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1220
    pub fn compare(left: GameProfileSnapshot, right: GameProfileSnapshot) -> Self GameProfileComparisonError! {
        if left.identity.scene != right.identity.scene {
            return Err(GameProfileComparisonError.IncompatibleIdentity("scene", left.identity.scene.clone(), right.identity.scene.clone()))
        }
        if left.identity.target != right.identity.target {
            return Err(GameProfileComparisonError.IncompatibleIdentity("target", left.identity.target.clone(), right.identity.target.clone()))
        }
        if left.identity.assets != right.identity.assets {
            left_assets :: left.identity.assets.iter().map(fn(asset) { asset.key() }).collect<[String]>().join(",")
            right_assets :: right.identity.assets.iter().map(fn(asset) { asset.key() }).collect<[String]>().join(",")
            return Err(GameProfileComparisonError.IncompatibleIdentity("assets", ^left_assets, ^right_assets))
        }
        delta :: I128{right.projection.total_function_ns} - I128{left.projection.total_function_ns}
        Ok(Self{left: ^left, right: ^right, total_function_ns_delta: delta})
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1269
    pub fn is_regression(self: &Self) -> Bool { self.total_function_ns_delta > 0 }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1274
const JET_GAME_DEVTOOLS_COMMAND_FRAME_MAX: Int = 256
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1276
fn jet_game_control_object(value: &DataTree) -> &[(String, DataTree)] Err! {
    match value {
        .Object(fields) -> Ok(&fields)
        _ -> Err("game control command payload must be an object")
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1285
fn jet_game_control_field(fields: &[(String, DataTree)], name: String) -> &DataTree? {
    loop (field_name, value) in fields { if field_name == name -> return Val(&value) }
    None
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1294
fn jet_game_control_required_text(fields: &[(String, DataTree)], name: String) -> String Err! {
    match jet_game_control_field(fields, name) {
        Val(.Text(value) | .TypedText(value)) if !value.is_empty() -> Ok(value.clone())
        Val(_) -> Err("game control field `{name}` must be non-empty text")
        None -> Err("game control field `{name}` is required")
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1309
fn jet_game_control_optional_text(fields: &[(String, DataTree)], name: String) -> String? Err! {
    match jet_game_control_field(fields, name) {
        None | Val(.Null) -> Ok(None)
        Val(.Text(value) | .TypedText(value)) if !value.is_empty() -> Ok(Val(value.clone()))
        Val(_) -> Err("game control field `{name}` must be text or null")
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1324
fn jet_game_control_optional_u64(fields: &[(String, DataTree)], name: String) -> U64? Err! {
    match jet_game_control_field(fields, name) {
        None | Val(.Null) -> Ok(None)
        Val(.Int(value)) if value >= 0 -> Ok(Val(value as U64))
        Val(.Number(value)) -> value.parse<U64>().map(fn(number) { Val(number) }).map_err(fn(_) { "game control field `{name}` is outside u64" })
        Val(_) -> Err("game control field `{name}` must be an unsigned integer")
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1339
fn jet_game_decode_control_request(session_id: String, payload: String) -> JetDevtoolsGameControlRequest Err! {
    value :: parse_json_strict(payload).map_err(fn(_) { "invalid game control payload" })?
    fields :: jet_game_control_object(&value)?
    expected :: ["session_id", "request_id", "kind", "source_id", "revision", "world_id", "actor_id", "component_id", "authored_instance_id", "source_span_start", "source_span_end", "field", "value", "category", "expression", "required_authority", "frame_id", "budget"]
    if fields.len() != expected.len() || !fields.iter().all(fn((key, _)) { expected.iter().any(fn(expected_key) { key == expected_key }) }) {
        return Err("game control payload has unexpected fields")
    }
    payload_session :: jet_game_control_required_text(fields, "session_id")?
    if payload_session != session_id -> return Err("game control payload session identity mismatch")
    request_id :: jet_game_control_required_text(fields, "request_id")?
    kind :: JetDevtoolsGameControlKind.from_str(jet_game_control_required_text(fields, "kind")?)?
    request := JetDevtoolsGameControlRequest.new(^payload_session, ^request_id, kind)?
    request.source_id = jet_game_control_optional_text(fields, "source_id")?
    request.revision = jet_game_control_optional_text(fields, "revision")?
    request.world_id = jet_game_control_optional_text(fields, "world_id")?
    request.actor_id = jet_game_control_optional_text(fields, "actor_id")?
    request.component_id = jet_game_control_optional_text(fields, "component_id")?
    request.authored_instance_id = jet_game_control_optional_text(fields, "authored_instance_id")?
    request.source_span_start = jet_game_control_optional_u64(fields, "source_span_start")?
    request.source_span_end = jet_game_control_optional_u64(fields, "source_span_end")?
    request.field = jet_game_control_optional_text(fields, "field")?
    request.value = jet_game_control_optional_text(fields, "value")?
    request.category = jet_game_control_optional_text(fields, "category")?
    request.expression = jet_game_control_optional_text(fields, "expression")?
    request.required_authority = jet_game_control_optional_text(fields, "required_authority")?
    request.frame_id = jet_game_control_optional_u64(fields, "frame_id")?
    request.budget = jet_game_control_optional_u64(fields, "budget")?
    request.validate()?
    Ok(^request)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1404
fn jet_game_ingest_devtools_command_frame(frame: String, expected_session_id: String) -> Int Err! {
    value :: parse_json_strict(frame).map_err(fn(_) { "invalid game control command frame" })?
    fields :: jet_game_control_object(&value)?
    protocol :: jet_game_control_required_text(fields, "protocol")?
    if protocol != JET_DEVTOOLS_PROTOCOL -> return Err("game control command frame protocol mismatch")
    session_id :: jet_game_control_required_text(fields, "session_id")?
    if session_id != expected_session_id -> return Err("game control command frame session identity mismatch")
    _ :: jet_game_control_optional_u64(fields, "started_at_ms")?.ok_or_else(fn() { "game control command frame requires started_at_ms" })?
    direction :: jet_game_control_required_text(fields, "direction")?
    if direction != "host_to_runtime" -> return Err("game control command frame direction mismatch")
    commands :: match jet_game_control_field(fields, "commands") {
        Val(.Array(commands)) -> &commands
        _ -> return Err("game control command frame requires commands")
    }
    if commands.len() > JET_GAME_DEVTOOLS_COMMAND_FRAME_MAX -> return Err("game control command frame exceeds command limit")
    accepted: Int := 0
    loop command in commands {
        command_fields :: jet_game_control_object(command)?
        kind :: jet_game_control_required_text(command_fields, "kind")?
        if kind != "GameControl" -> return Err("unsupported game control command `{kind}`")
        payload :: jet_game_control_field(command_fields, "payload").ok_or_else(fn() { "game control command is missing payload" })?
        payload :: render_datatree_json(payload, false, 0)
        request :: jet_game_decode_control_request(session_id, payload)?
        jet_devtools_enqueue_game_control(^request)?
        accepted = accepted.saturating_add(1)
    }
    Ok(accepted)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1449
fn jet_game_devtools_callback(session_id: String, payload: String) -> Unit Err! {
    request :: jet_game_decode_control_request(session_id, payload)?
    jet_devtools_enqueue_game_control(^request)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1454
// GATE #4565: kernel primitive
static JET_GAME_DEVTOOLS_CALLBACK_GUARD: LazyLock<JetDevtoolsGameControlCallbackGuard?> =
    #Unsafe("initialize and retain the single process-lifetime game-control callback guard") {
        LazyLock.new(fn() { jet_devtools_install_game_control_callback(jet_game_devtools_callback).ok() })
    }
