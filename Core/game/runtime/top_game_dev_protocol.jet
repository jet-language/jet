fn jet_game_install_devtools_callback() -> {
    // Only authorized sessions call this; the session policy owns control reachability.
    // GATE #4565: kernel primitive
    #Unsafe("force the lazy callback installation without releasing its process-lifetime guard") {
        _ :: LazyLock.force(&JET_GAME_DEVTOOLS_CALLBACK_GUARD)
