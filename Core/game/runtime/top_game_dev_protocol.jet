// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:189
#Derive(Clone, Debug, Eq, PartialEq)
pub struct GameDevLaunchProfile {
    pub target: String
    pub run_mode: GameDevRunMode
    pub headless_compatible: Bool
    pub phases: [GameDevPhaseResult]
}
impl GameDevLaunchProfile {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:198
    pub fn new<T: Into<String>>(target: T, run_mode: GameDevRunMode) -> Self {
        Self{target: target.into(), run_mode: run_mode, headless_compatible: true, phases: []}
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:207
    pub fn record_phase<T: Into<String>>(self: &Self, phase: GameDevPhase, status: GameDevTransitionStatus, detail: T) -> {
        if self.phases.len() < 256 { self.phases.push(GameDevPhaseResult{phase: phase, status: status, detail: detail.into()}) }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:222
    pub fn headless_variant(self: &Self) -> Self {
        profile := self.clone()
        profile.run_mode = GameDevRunMode.Headless
        ^profile
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:228
    pub fn render_json(self: &Self) -> String {
        phases :: self.phases.iter().map(fn(phase) {
            "{{\"phase\":{game_dev_json_string(phase.phase.as_str())},\"status\":{game_dev_json_string(phase.status.as_str())},\"detail\":{game_dev_json_string(&phase.detail)}}}"
        }).collect<[String]>().join(",")
        "{{\"target\":{game_dev_json_string(&self.target)},\"run_mode\":{game_dev_json_string(self.run_mode.as_str())},\"headless_compatible\":{self.headless_compatible},\"phases\":[{phases}]}}"
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:252
// First-party extensions are checked values; release profiles never register.
#Derive(Clone, Debug, PartialEq)
pub struct GameDevExtension { category: String, extension: String, profile: String }
impl GameDevExtension {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:262
    pub const GAMEPLAY_DEBUGGER_CATEGORY: String = "Gameplay Debugger"
    pub const GAMEPLAY_DEBUGGER_NAME: String = "jet.gameplay.debugger"
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:270
    pub fn checked_gameplay_debugger_with_policy<T: Into<String>>(profile: T, policy: GameDevPolicy) -> Self? Err! {
        if !policy.game_debug_data_enabled() -> return Err("Gameplay Debugger is unavailable outside a development profile")
        profile :: profile.into()
        trimmed := profile.trim() // #4303
        if trimmed.is_empty() || profile.chars().any(fn(character) { character.is_control() }) {
            return Err("game dev extension profile must be non-empty and printable")
        }
        if profile == "release" -> return Ok(None)
        Ok(Val(Self{category: Self.GAMEPLAY_DEBUGGER_CATEGORY, extension: Self.GAMEPLAY_DEBUGGER_NAME, profile: ^profile}))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:295
    pub fn checked_gameplay_debugger<T: Into<String>>(profile: T) -> Self? Err! {
        Self.checked_gameplay_debugger_with_policy(profile, GameDevPolicy.new(false))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:302
    pub fn category(self: &Self) -> String { self.category }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:306
    pub fn extension(self: &Self) -> String { self.extension }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:310
    pub fn profile(self: &Self) -> String { self.profile }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:314
    pub fn render_json(self: &Self) -> String {
        "{{\"category\":{game_dev_json_string(self.category)},\"extension\":{game_dev_json_string(self.extension)},\"profile\":{game_dev_json_string(&self.profile)},\"development_only\":true,\"capabilities\":[\"Devtools.GameInspect\",\"Devtools.GameControl\"]}}"
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:325
#Derive(Clone, Debug, PartialEq)
pub enum GameDevEvent {
    Frame(JetGameFrameIdentity)
    FrameSample(JetGameFrameSample)
    Diagnostic(JetGameErrorPause)
    Control(GameDevControl)
    Transition(GameDevTransition)
    GameplayDebugger(GameDevExtension)
    Profile(JetGameFrameReceipt)
    ReloadStatus(JetGameReloadFact)
    ProfileComparison(GameProfileComparison)
    Overlay(JetGameOverlayTransitionFact)
    OverlayAutocomplete(JetGameOverlayAutocompleteFact)
    OverlayCommand(JetGameOverlayCommandRow)
    OverlayOutput(JetGameOverlayOutputRow)
    OverlayMetric(value: JetGameOverlayMetricValue, frame: JetGameFrameIdentity?)
    DrawEvent(JetGameDrawEvent)
    World(JetGameWorldFact)
    WorldSelection(JetGameWorldSelectionProjection)
    WorldEdit(JetGameWorldEditRequest)
    WorldEvaluation(JetGamePausedEvalResult)
    AssetWatch(JetGameAssetWatchFacts)
    AssetImportReport(JetGameAssetImportReport)
    AssetReload(JetGameAssetTransactionReceipt)
    GameSwap(JetGameSwapOutcome)
    HotSwap(JetGameHotSwapReceipt)
    HotSwapExplanation(JetGameHotSwapExplanation)
    Crash(JetGameCrashBundle)
    Stopped(GameDevStopped)
}
impl GameDevEvent {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:360
    pub fn kind(self: &Self) -> String {
        match self {
            .Frame(_) -> "Frame", .FrameSample(_) -> "GameFrameSample", .Control(_) -> "Control",
            .Transition(_) -> "GameTransition", .Diagnostic(_) -> "Diagnostic", .GameplayDebugger(_) -> "GameplayDebugger",
            .Profile(_) -> "Profile", .ReloadStatus(_) -> "ReloadStatus", .ProfileComparison(_) -> "ProfileComparison",
            .Overlay(_) -> "Overlay", .OverlayAutocomplete(_) -> "OverlayAutocomplete", .OverlayCommand(_) -> "OverlayCommand",
            .OverlayOutput(_) -> "OverlayOutput", .OverlayMetric(_, _) -> "OverlayMetric", .DrawEvent(_) -> "GameDrawEvent",
            .World(_) -> "World", .WorldSelection(_) -> "WorldSelection", .WorldEdit(_) -> "WorldEdit", .WorldEvaluation(_) -> "WorldEvaluation",
            .AssetWatch(_) -> "AssetWatch", .AssetImportReport(_) -> "AssetImportReport", .AssetReload(_) -> "AssetReload",
            .GameSwap(_) -> "GameSwap", .HotSwap(_) -> "HotSwap", .HotSwapExplanation(_) -> "HotSwapExplanation",
            .Crash(_) -> "Crash", .Stopped(_) -> "Stopped"
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:398
// Hosts provide already-authorized roots/events; coalescing/import/projection
// stays in this one protocol owner rather than a second host report.
pub fn project_asset_watch_import_events<T: Into<String>>(timestamp_ms: U64, source: T, roots: JetGameAssetRootSet, events: [JetGameAssetWatchEvent], skipped_count: USize) -> [JetDevtoolsEvent] Err! {
    source :: source.into()
    facts :: JetGameAssetWatchFacts.coalesce_with_skipped(&roots, events, skipped_count).map_err(fn(error) { error.to_string() })?
    report :: GameAssetImportAdapter.new(^roots).import_report(&facts)
    Ok([JetDevtoolsEvent]{
        GameDevEvent.AssetWatch(^facts).to_devtools_event(timestamp_ms, source.clone())?,
        GameDevEvent.AssetImportReport(^report).to_devtools_event(timestamp_ms, ^source)?
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:417
impl GameDevEvent {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:419
    // Typed producer facts project into the one shared devtools envelope.
    pub fn to_devtools_event<T: Into<String>>(self: &Self,
        timestamp_ms: U64, source: T) -> JetDevtoolsEvent Err! {
        source :: source.into()
        if game_dev_typed_trace_body(self) == Some(body) {
            return JetDevtoolsEvent.try_new(timestamp_ms, ^source, ^body)
        }
        if game_dev_swap_body(self) == Some(body) {
            return JetDevtoolsEvent.try_new(timestamp_ms, ^source, ^body)
        }
        (entity, fields, payload) :: match self {
            .Frame(frame) -> (
                frame.scene.clone(),
                "{{\"frame_id\":{frame.frame_id},\"scene\":{game_dev_json_string(&frame.scene)},\"frame_index\":{frame.frame_index},\"build\":{game_dev_json_string(&frame.build)},\"revision\":{game_dev_json_string(&frame.revision)},\"trace_id\":{game_dev_json_string(&frame.trace_id)}}}",
                None)
            .FrameSample(_) | .DrawEvent(_) | .GameSwap(_) ->
                unreachable("typed game events are handled before field projection")
            .Diagnostic(pause) -> (
                pause.source.source_id.clone(),
                "{{\"code\":{game_dev_json_string(&pause.code)},\"message\":{game_dev_json_string(&pause.message)},\"source\":{game_dev_source_span_json(&pause.source)}}}",
                None)
            .Transition(transition) -> (
                "game",
                "{{\"operation\":{game_dev_json_string(transition.operation.as_str())},\"before\":{game_dev_json_string(transition.before.as_str())},\"after\":{game_dev_json_string(transition.after.as_str())},\"status\":{game_dev_json_string(transition.status.as_str())},\"run_mode\":{game_dev_json_string(transition.run_mode.as_str())},\"frame_index\":{transition.frame_index},\"source_revision\":{game_dev_json_string(&transition.source_revision)}}}",
                Some(transition.render_json()))
            .Control(control) -> ("game", control.render_json(), None)
            .GameplayDebugger(extension) -> (
                "game.gameplay_debugger",
                "{{\"category\":{game_dev_json_string(extension.category())},\"extension\":{game_dev_json_string(extension.extension())},\"profile\":{game_dev_json_string(extension.profile())},\"development_only\":true}}",
                Some(extension.render_json()))
            .Profile(receipt) -> (
                receipt.frame.as_ref().map(fn(frame) { frame.scene.clone() }).unwrap_or_else(fn() { "game" }),
                "{{\"sequence\":{receipt.sequence},\"kind\":{game_dev_json_string(receipt.kind.as_str())},\"before\":{game_dev_json_string(receipt.before.as_str())},\"after\":{game_dev_json_string(receipt.after.as_str())},\"dropped_samples\":{receipt.dropped_samples}}}",
                None)
            .ReloadStatus(fact) -> (
                "game.reload",
                "{{\"frame_id\":{fact.frame.frame_id},\"domain\":{game_dev_json_string(&fact.domain)},\"status\":{game_dev_json_string(fact.status.as_str())},\"reason\":{game_dev_json_string(&fact.reason)}}}",
                Some(fact.render_json()))
            .ProfileComparison(comparison) -> (
                comparison.left.identity.scene.clone(),
                "{{\"scene\":{game_dev_json_string(&comparison.left.identity.scene)},\"target\":{game_dev_json_string(&comparison.left.identity.target)},\"delta_function_ns\":{comparison.total_function_ns_delta},\"regression\":{comparison.is_regression()}}}",
                Some("{{\"left\":{game_profile_snapshot_json(&comparison.left)},\"right\":{game_profile_snapshot_json(&comparison.right)}}}"))
            .Overlay(fact) -> {
                frame :: fact.frame.as_ref().map(game_dev_frame_identity_json).unwrap_or_else(fn() { "null" })
                ("game.overlay",
                    "{{\"sequence\":{fact.sequence},\"kind\":{game_dev_json_string(fact.kind.as_str())},\"before\":{game_dev_json_string(fact.before.as_str())},\"after\":{game_dev_json_string(fact.after.as_str())},\"visible\":{fact.visibility.visible},\"input_capture\":{game_dev_json_string(fact.visibility.input_capture.as_str())},\"filter\":{game_dev_json_string(fact.filter.as_str())},\"error_pause_enabled\":{fact.error_pause_enabled},\"frame\":{frame}}}",
                    Some(fact.render_json()))
            }
            .OverlayAutocomplete(fact) -> (
                "game.overlay",
                "{{\"query\":{game_dev_json_string(&fact.query)},\"match_count\":{fact.matches.len()}}}",
                Some(fact.render_json()))
            .OverlayCommand(command) -> (
                "game.overlay",
                "{{\"id\":{command.id},\"timestamp_ns\":{command.timestamp_ns},\"text\":{game_dev_json_string(&command.text)}}}",
                None)
            .OverlayOutput(row) -> {
                payload :: row.published_text().map(fn(_) { row.render_json() })
                ("game.overlay",
                    "{{\"id\":{row.id},\"timestamp_ns\":{row.timestamp_ns},\"category\":{game_dev_json_string(row.category.as_str())},\"message\":{game_dev_json_string(&row.message)},\"source_id\":{game_dev_json_option(row.source_id.as_deref())},\"trace_id\":{game_dev_json_option(row.trace_id.as_deref())},\"published\":{row.published_text().is_some()}}}",
                    ^payload)
            }
            .OverlayMetric{value, frame} -> {
                frame :: frame.as_ref().map(game_dev_frame_identity_json).unwrap_or_else(fn() { "null" })
                ("game.overlay",
                    "{{\"metric\":{game_dev_json_string(value.metric.as_str())},\"value\":{value.value},\"sampled_at_ns\":{value.sampled_at_ns},\"frame\":{frame}}}",
                    None)
            }
            .World(world) -> (
                world.world_id.clone(),
                "{{\"world_id\":{game_dev_json_string(&world.world_id)},\"frame_id\":{world.frame_id},\"source_id\":{game_dev_json_string(&world.source_id)},\"revision\":{game_dev_json_string(&world.revision)}}}",
                Some(world.render_json()))
            .WorldSelection(selection) -> (
                selection.world_id.clone(),
                "{{\"world_id\":{game_dev_json_string(&selection.world_id)},\"frame_id\":{selection.frame_id},\"source_id\":{game_dev_json_string(&selection.source_id)},\"revision\":{game_dev_json_string(&selection.revision)}}}",
                Some(selection.render_json()))
            .WorldEdit(request) -> (
                "game.world",
                "{{\"field\":{game_dev_json_string(&request.field_patch.field)},\"target_count\":{request.targets.len()}}}",
                Some(request.render_json()))
            .WorldEvaluation(result) -> (
                "game.world",
                "{{\"request_id\":{game_dev_json_string(&result.request_id)},\"status\":{game_dev_json_string(&result.status)},\"type_name\":{game_dev_json_string(&result.type_name)}}}",
                Some(result.render_json()))
            .AssetWatch(facts) -> (
                "game.assets",
                "{{\"created\":{facts.created.len()},\"changed\":{facts.changed.len()},\"deleted\":{facts.deleted.len()},\"events\":{facts.events.len()},\"skipped_count\":{facts.skipped_count}}}",
                Some(facts.render_json()))
            .AssetImportReport(report) -> (
                "game.assets",
                "{{\"imported\":{report.imported.len()},\"dependencies\":{report.dependencies.len()},\"created\":{report.created.len()},\"deleted\":{report.deleted.len()},\"skipped\":{report.skipped.len()},\"skipped_count\":{report.skipped_count},\"diagnostics\":{report.diagnostics.len()}}}",
                Some(report.render_json()))
            .AssetReload(receipt) -> (
                "game.assets",
                "{{\"transaction_id\":{receipt.transaction_id},\"status\":{game_dev_json_string(receipt.status.as_str())},\"entries\":{receipt.entries.len()},\"revision_before\":{receipt.revision_before},\"revision_after\":{receipt.revision_after}}}",
                Some(receipt.render_json()))
            .HotSwap(receipt) -> (
                "game.hotswap",
                "{{\"transaction_id\":{receipt.transaction_id},\"phase\":{game_dev_json_string(receipt.phase.as_str())},\"committed\":{receipt.is_committed()},\"rolled_back\":{receipt.is_rolled_back()},\"from\":{receipt.from_identity.render_json()},\"to\":{receipt.to_identity.render_json()}}}",
                Some(receipt.render_json()))
            .HotSwapExplanation(explanation) -> {
                transaction_id :: explanation.transaction_id.map(fn(value) { value.to_string() }).unwrap_or_else(fn() { "null" })
                ("game.hotswap",
                    "{{\"compatible\":{explanation.compatible},\"code\":{game_dev_json_string(&explanation.code)},\"message\":{game_dev_json_string(&explanation.message)},\"transaction_id\":{transaction_id}}}",
                    Some(explanation.render_json()))
            }
            .Crash(bundle) -> (
                "game.crash",
                "{{\"frame_id\":{bundle.frame.frame_id},\"reason\":{game_dev_json_string(&bundle.reason)},\"target\":{game_dev_json_string(&bundle.target)},\"upload_policy\":{game_dev_json_string(bundle.upload_policy.as_str())}}}",
                Some(bundle.render_json()))
            .Stopped(stopped) -> (
                "game",
                "{{\"reason\":{game_dev_json_string(&stopped.reason)},\"frame_index\":{stopped.frame_index}}}",
                Some(stopped.render_json()))
        }
        JetDevtoolsEvent.from_parts_with_payload(timestamp_ms, ^source, self.kind(), ^entity, ^fields, ^payload)
    }
}
