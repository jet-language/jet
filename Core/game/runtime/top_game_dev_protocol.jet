}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1467
fn jet_game_control_request(request: JetDevtoolsGameControlRequest, session: &GameDevSession) -> GameDevControl Err! {
    identity :: session.profiler.identity()
    if request.session_id != identity.session -> return Err("game control request session identity mismatch")
    if request.source_id is Val(source_id) {
        if source_id != identity.source -> return Err("game control request source identity mismatch")
    }
    if request.revision is Val(revision) {
        if revision != identity.revision -> return Err("game control request revision identity mismatch")
    }
    match request.kind {
        .Play -> Ok(GameDevControl.Play)
        .Simulate -> Ok(GameDevControl.Simulate)
        .Pause -> Ok(GameDevControl.Pause)
        .Step -> Ok(GameDevControl.Step)
        .Resume -> Ok(GameDevControl.Resume)
        .FrameAdvance -> Ok(GameDevControl.FrameAdvance)
        .Edit -> Ok(GameDevControl.Edit)
        .Discard -> Ok(GameDevControl.Discard)
        .SelectCategory -> Ok(GameDevControl.SelectGameplayCategory(request.category.ok_or_else(fn() { "select_category requires category" })?))
        .SelectWorld -> {
            world_id :: request.world_id.ok_or_else(fn() { "select_world requires world_id" })?
            selection :: JetGameWorldSelection.new(^world_id, ^request.actor_id, ^request.component_id, ^request.field).map_err(fn(error) { error.to_string() })?
            Ok(GameDevControl.SelectWorld(^selection))
        }
        .EvaluateWorld -> {
            world_id :: request.world_id.ok_or_else(fn() { "evaluate_world requires world_id" })?
            frame_id :: request.frame_id.ok_or_else(fn() { "evaluate_world requires frame_id" })?
            actor_id :: request.actor_id.ok_or_else(fn() { "evaluate_world requires actor_id" })?
            component_id :: request.component_id.ok_or_else(fn() { "evaluate_world requires component_id" })?
            expression :: request.expression.ok_or_else(fn() { "evaluate_world requires expression" })?
            required_authority :: request.required_authority.ok_or_else(fn() { "evaluate_world requires required_authority" })?
            budget :: request.budget.ok_or_else(fn() { "evaluate_world requires budget" })?
            JetGamePausedEvalRequest.new(^request.request_id, identity.session.clone(), ^world_id, frame_id, ^actor_id, ^component_id, ^expression, ^required_authority, budget)
                .map_err(fn(error) { error.to_string() })?.with_tier("game")
                .map(fn(evaluation) { GameDevControl.EvaluateWorld(^evaluation) }).map_err(fn(error) { error.to_string() })
        }
        .Eject -> Ok(GameDevControl.Eject{
            world_id: request.world_id.ok_or_else(fn() { "eject requires world_id" })?,
            actor_id: request.actor_id.ok_or_else(fn() { "eject requires actor_id" })?})
        .Keep | .EditWorld -> {
            source_id :: request.source_id.ok_or_else(fn() { "world edit requires source_id" })?
            revision :: request.revision.ok_or_else(fn() { "world edit requires revision" })?
            authored_instance_id :: request.authored_instance_id.ok_or_else(fn() { "world edit requires authored_instance_id" })?
            start :: request.source_span_start.ok_or_else(fn() { "world edit requires source_span_start" })?
            end :: request.source_span_end.ok_or_else(fn() { "world edit requires source_span_end" })?
            field :: request.field.ok_or_else(fn() { "world edit requires field" })?
            value :: request.value.ok_or_else(fn() { "world edit requires value" })?
            // GATE #4483: selected target width, never the compiler host width.
            maximum :: sys.usize_max()
            if start > maximum -> return Err("world edit source span is too large")
            if end > maximum -> return Err("world edit source span is too large")
            span :: JetGameWorldSourceSpan.new(Int.from_u64(start), Int.from_u64(end)).map_err(fn(error) { error.to_string() })?
            target :: JetGameWorldEditTarget.new(^source_id, ^revision, ^authored_instance_id, ^span).map_err(fn(error) { error.to_string() })?
                .with_session_identity(identity.session.clone(), "game").map_err(fn(error) { error.to_string() })?
            edit :: JetGameWorldEditRequest.new([^target], ^field, ^value).map_err(fn(error) { error.to_string() })?
            if request.kind is .Keep { Ok(GameDevControl.Keep(^edit)) } else { Ok(GameDevControl.EditWorld(^edit)) }
        }
    }
}
