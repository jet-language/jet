// The envelope is the sole transport owner; game state lives in canonical Core modules.
#Derive(Clone, Debug)
pub struct GameDevSession {
    pub envelope: JetDevtoolsEnvelope
    pub lifecycle: JetDevtoolsLifecycleState
    pub profiler: GameDevProfileRing
    pub overlay: JetGameOverlayState
    pub inspector: JetGameWorldInspector
    pub asset_roots: JetGameAssetRootSet
    pub policy: GameDevPolicy
    pub swap_session: JetGameDevSession
    asset_import: GameAssetImportAdapter
    asset_runtime: GameAssetRuntimeAdapter
    pub last_asset_watch: JetGameAssetWatchFacts?
    pub last_asset_import_report: JetGameAssetImportReport?
    pub hot_swap_live: JetGameHotSwapSnapshot?
    pub last_input: GameDevInput?
    pub phase: GameDevPhase
    pub run_mode: GameDevRunMode
    pub frame_index: U64
    pub selected_world_id: String?
    pub selected_actor_id: String?
    pub selected_debugger_category: String?
    pub launch_profile: GameDevLaunchProfile
    pending_world_edits: [JetGameWorldEditRequest]
    next_transition_sequence: U64
    frame_advance_pending: Bool
    draw_cursor: JetGameDrawCursor?
}
impl GameDevSession {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1637
    pub fn new(identity: GameDevRunIdentity, started_at_ms: U64) -> Self JetGameFrameProfilerError! {
        Self.new_with_policy(^identity, started_at_ms, GameDevPolicy.new(false))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1644
    pub fn new_with_policy(identity: GameDevRunIdentity, started_at_ms: U64, policy: GameDevPolicy) -> Self JetGameFrameProfilerError! {
        if !policy.game_debug_data_enabled() {
            return Err(JetGameFrameProfilerError.InvalidTraceContext("game development data is disabled for this profile"))
        }
        profiler :: GameDevProfileRing.new(identity.clone())?
        launch_profile :: GameDevLaunchProfile.new(identity.source.clone(), GameDevRunMode.Headless)
        asset_roots :: JetGameAssetRootSet.default()
        inspector := JetGameWorldInspector.default()
        &inspector.set_session_identity(identity.session.clone(), "game")
        envelope := JetDevtoolsEnvelope.new(identity.session.clone(), started_at_ms)
        envelope.lifecycle = JetDevtoolsLifecycleState.Ready
        envelope.freshness = JetDevtoolsFreshnessFact.fresh(started_at_ms)
        envelope.source_identity = Val(JetDevtoolsSourceIdentityFact.new(Val(identity.source.clone()), Val(identity.build.clone()), Val(identity.revision.clone()), None))
        Ok(Self{envelope: ^envelope, lifecycle: JetDevtoolsLifecycleState.Ready, profiler: ^profiler,
            overlay: JetGameOverlayState.new(), inspector: ^inspector, swap_session: JetGameDevSession.new(),
            asset_import: GameAssetImportAdapter.new(asset_roots.clone()), asset_runtime: GameAssetRuntimeAdapter.new(),
            asset_roots: ^asset_roots, policy: policy, last_asset_watch: None, last_asset_import_report: None,
            hot_swap_live: None, last_input: None, phase: GameDevPhase.Editing, run_mode: GameDevRunMode.Headless,
            frame_index: 0, selected_world_id: None, selected_actor_id: None, selected_debugger_category: None,
            launch_profile: ^launch_profile, pending_world_edits: [], next_transition_sequence: 1,
            frame_advance_pending: false, draw_cursor: None})
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1697
    pub fn game_debug_data_enabled(self: &Self) -> Bool { self.policy.game_debug_data_enabled() }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1704
    // Both callback and separate-process relay commands reach the single transition owner.
    pub fn dispatch_pending_devtools_controls(self: &Self, timestamp_ms: U64) -> Int Err! {
        const MAX_CONTROLS_PER_TICK: Int = 32
        loop frame in jet_devtools_take_game_control_relays(self.envelope.session_id)? {
            _ :: jet_game_ingest_devtools_command_frame(frame, self.envelope.session_id)?
        }
        pending :: jet_devtools_command_count(self.envelope.session_id).min(MAX_CONTROLS_PER_TICK)
        dispatched: Int := 0
        loop _ in 0..<pending {
            request :: jet_devtools_poll_game_control(self.envelope.session_id) ?? break
            control :: jet_game_control_request(^request, self)?
            _ :: &self.dispatch_control(timestamp_ms, ^control)?
            dispatched = dispatched.saturating_add(1)
        }
        Ok(dispatched)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1729
    // Reject release policies before constructing extension values or events.
    pub fn register_gameplay_debugger<T: Into<String>>(self: &Self, timestamp_ms: U64, profile: T) -> U64? Err! {
        if !self.policy.game_debug_data_enabled() -> return Err("Gameplay Debugger is unavailable outside a development profile")
        if self.lifecycle == JetDevtoolsLifecycleState.Stopped -> return Err("game dev session is stopped")
        extension :: GameDevExtension.checked_gameplay_debugger_with_policy(profile, self.policy)? ?? return Ok(None)
        source :: self.profiler.identity().source.clone()
        &self.push_game_event(timestamp_ms, ^source, GameDevEvent.GameplayDebugger(^extension)).map(fn(sequence) { Val(sequence) })
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1756
    pub fn record(self: &Self, fact: JetGameSampleFact) -> JetGameFrameReceipt JetGameFrameProfilerError! { &self.profiler.publish(^fact) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1762
    pub fn set_trace_context(self: &Self, context: JetGameTraceContext) -> Unit Err! {
        &self.profiler.set_context(^context).map_err(fn(error) { error.to_string() })
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1771
    pub fn trace_context(self: &Self) -> &JetGameTraceContext? { self.profiler.context() }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameDevProtocol.rs:1774
    pub fn publish_reload_status(self: &Self, timestamp_ms: U64, fact: JetGameReloadFact) -> U64 Err! {
        if self.lifecycle == JetDevtoolsLifecycleState.Stopped -> return Err("game dev session is stopped")
        fact.validate().map_err(fn(error) { error.to_string() })?
        source :: self.profiler.identity().source.clone()
        &self.push_game_event(timestamp_ms, ^source, GameDevEvent.ReloadStatus(^fact))
    }
}
