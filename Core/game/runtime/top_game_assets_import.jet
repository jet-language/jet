use core.game.runtime.kernel_game_asset_pipeline.[JetGameAssetRootSet, JetGameAssetDependencyGraph,
    JetGameAssetRootIdentity, JetGameAssetPipelineError, JetGameAssetWatchEvent, JetGameAssetWatchFacts,
    JetGameAssetSourceIdentity, JetGameAssetNodeIdentity, JetGameAssetDependencyIdentity,
    JetGameAssetRecipeIdentity, JetGameAssetToolIdentity, JetGameAssetVersionIdentity,
    JetGameAssetImportPlan, JetGameAssetImportOutcome, JetGameAssetRuntimeFact, JetGameAssetImportReport]
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:1
// Typed asset import boundary: hosts supply facts; shared pipeline owns all
// normalization, validation, dependency and report rules, never filesystem scans.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:8
#Clone
struct GameAssetImportAdapter { roots: JetGameAssetRootSet, graph: JetGameAssetDependencyGraph }
impl GameAssetImportAdapter {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:15
    fn new(roots: JetGameAssetRootSet) -> Self {
        graph :: JetGameAssetDependencyGraph.new(roots.clone())
        Self{roots: ^roots, graph: ^graph}
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:20
    fn with_roots(roots: [JetGameAssetRootIdentity]) -> Self JetGameAssetPipelineError! {
        Ok(Self.new(JetGameAssetRootSet.new(^roots)?))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:26
    fn roots(self: &Self) -> &JetGameAssetRootSet { &self.roots }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:30
    fn graph(self: &Self) -> &JetGameAssetDependencyGraph { &self.graph }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:34
    fn graph_mut(self: &Self) -> &JetGameAssetDependencyGraph { &self.graph }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:38
    fn watch_facts(self: &Self, events: &[JetGameAssetWatchEvent]) -> JetGameAssetWatchFacts JetGameAssetPipelineError! {
        JetGameAssetWatchFacts.coalesce(&self.roots, events)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:45
    fn add_source(self: &Self, source: JetGameAssetSourceIdentity) -> JetGameAssetNodeIdentity JetGameAssetPipelineError! {
        self.graph.add_source(^source)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:52
    fn set_dependencies(self: &Self, source: &JetGameAssetSourceIdentity,
        dependencies: [JetGameAssetDependencyIdentity]) -> () JetGameAssetPipelineError! {
        self.graph.set_dependencies(source, ^dependencies)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:60
    fn import_plan(self: &Self, source: JetGameAssetSourceIdentity, recipe: JetGameAssetRecipeIdentity,
        tool: JetGameAssetToolIdentity, version: JetGameAssetVersionIdentity,
        dependencies: [JetGameAssetDependencyIdentity]) -> JetGameAssetImportPlan JetGameAssetPipelineError! {
        JetGameAssetImportPlan.new(^source, ^recipe, ^tool, ^version)?.with_dependencies(^dependencies)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:71
    fn ready_outcome(self: &Self, plan: &JetGameAssetImportPlan,
        output_hash: String) -> JetGameAssetImportOutcome JetGameAssetPipelineError! {
        JetGameAssetImportOutcome.ready(plan, ^output_hash)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:78
    fn runtime_fact(self: &Self, plan: &JetGameAssetImportPlan, outcome: &JetGameAssetImportOutcome,
        bytes: [U8], metadata: String) -> JetGameAssetRuntimeFact JetGameAssetPipelineError! {
        JetGameAssetRuntimeFact.from_ready(plan, outcome, ^bytes, ^metadata)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:89
    fn failed_outcome(self: &Self, plan: &JetGameAssetImportPlan,
        code: String, message: String) -> JetGameAssetImportOutcome JetGameAssetPipelineError! {
        JetGameAssetImportOutcome.failed(plan, ^code, ^message)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:98
    fn report_from_watch(self: &Self, events: &[JetGameAssetWatchEvent]) -> JetGameAssetImportReport JetGameAssetPipelineError! {
        Ok(JetGameAssetImportReport.from_watch(&self.watch_facts(events)?))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/GameAssetsImport.rs:104
    fn import_report(self: &Self, facts: &JetGameAssetWatchFacts) -> JetGameAssetImportReport {
        report := JetGameAssetImportReport.from_watch(facts)
        imported :: report.imported.clone()
        loop node in imported.iter().cloned() {
            loop dependency in self.graph.dependencies_for(&node) -> report.record_dependency(^dependency)
        }
        // Projection of the declared graph: untouched registered sources are
        // explicit skips, distinct from considered-but-unchanged watch facts.
        // GATE #4499: exact composite node map-key equality.
        imported: [JetGameAssetNodeIdentity:Bool] :: imported.into_iter().map(fn(node) { (^node, true) }).collect()
        deleted: [JetGameAssetNodeIdentity:Bool] :: report.deleted.iter().cloned().map(fn(node) { (^node, true) }).collect()
        sources :: self.graph.nodes()
        loop node in sources {
            if self.graph.source(&node).is_some() and not imported.contains_key(&node) and not deleted.contains_key(&node) {
                report.record_skipped(^node)
            }
        }
        ^report
    }
}
