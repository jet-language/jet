// :749-819. Actual typed Node keys preserve the Rust tuple's field equality;
// #4499 remains an activation gate, not a string-key workaround.
struct WatchBucket {
    event: JetGameAssetWatchEvent
    first: JetGameAssetWatchEventKind
}
impl JetGameAssetWatchFacts {
    pub fn coalesce(roots: JetGameAssetRootSet, events: [JetGameAssetWatchEvent]) -> JetGameAssetWatchFacts JetGameAssetPipelineError! {
        JetGameAssetWatchFacts.coalesce_with_skipped(roots, events, 0)
    }
    pub fn coalesce_with_skipped(roots: JetGameAssetRootSet, events: [JetGameAssetWatchEvent], skipped_count: Int) -> JetGameAssetWatchFacts JetGameAssetPipelineError! {
        if events.len() > JET_GAME_ASSET_MAX_EVENTS || skipped_count > JET_GAME_ASSET_MAX_SKIPPED -> return Err(.TooManyEvents)
        buckets := [JetGameAssetNodeIdentity: WatchBucket]{}
        loop event in events {
            declared :: roots.root(event.root.id) ?? return Err(.RootNotDeclared(event.root.id))
            if declared != event.root -> return Err(.RootMismatch(declared.path, event.root.path))
            normalized :: JetGameAssetWatchEvent.new(event.root, event.logical_path, event.kind) ?? return Err(err)
            key :: normalized.node()
            if buckets.get(key) == .Val(current) {
                kind :: jet_game_asset_net_event_kind(current.first, normalized.kind)
                if kind == .Val(net) {
                    buckets[key].event.kind = net
                } else {
                    _ :: &buckets.remove(key)
                }
            } else {
                buckets[key] = WatchBucket{event: normalized, first: normalized.kind}
            }
        }
        facts := JetGameAssetWatchFacts{events: [JetGameAssetWatchEvent]{}, created: [JetGameAssetNodeIdentity]{}, changed: [JetGameAssetNodeIdentity]{}, deleted: [JetGameAssetNodeIdentity]{}, skipped_count: skipped_count}
        keys := buckets.keys().to_list()
        &keys.sort_by((a: JetGameAssetNodeIdentity, b: JetGameAssetNodeIdentity) -> node_order(a, b))
        loop key in keys {
            event :: buckets[key].event
            if event.kind == {
                .Created -> &facts.created.push(event.node())
                .Changed -> &facts.changed.push(event.node())
                .Deleted -> &facts.deleted.push(event.node())
            }
            &facts.events.push(event)
        }
        // Node order is not event order: Rust events derive Ord over physical
        // root (id, path), logical path, then kind. Preserve the physical tie.
        &facts.events.sort_by((a: JetGameAssetWatchEvent, b: JetGameAssetWatchEvent) -> event_order(a, b))
        facts
    }
}
fn event_order(left: JetGameAssetWatchEvent, right: JetGameAssetWatchEvent) -> Ordering Never! {
    roots :: root_order(left.root, right.root)
    if roots != Ordering.Equal -> return roots
    paths :: left.logical_path <=> right.logical_path
    if paths != Ordering.Equal -> return paths
    event_rank(left.kind) <=> event_rank(right.kind)
}
fn event_rank(kind: JetGameAssetWatchEventKind) -> Int Never! {
    if kind == {
        .Created -> return 0
        .Changed -> return 1
        .Deleted -> return 2
    }
}

// :871-1071. #4499 typed-key map equality/hashing remains a real capability
// gate. Sources, edges and reverse edges are never serialized as keys.
pub struct JetGameAssetDependencyGraph {
    roots_value: JetGameAssetRootSet
    sources: [JetGameAssetNodeIdentity: JetGameAssetSourceIdentity]
    edges: [JetGameAssetNodeIdentity: [JetGameAssetDependencyIdentity]]
}
impl JetGameAssetDependencyGraph {
    pub fn new(roots: JetGameAssetRootSet) -> JetGameAssetDependencyGraph Never! {
        {roots_value: roots, sources: [JetGameAssetNodeIdentity: JetGameAssetSourceIdentity]{}, edges: [JetGameAssetNodeIdentity: [JetGameAssetDependencyIdentity]]{}}
    }
    pub fn roots(self) -> JetGameAssetRootSet Never! { self.roots_value }
    pub fn add_source(&self, source: JetGameAssetSourceIdentity) -> JetGameAssetNodeIdentity JetGameAssetPipelineError! {
        self.validate_source(source) ?? return Err(err)
        node :: source.node()
        self.sources[node] = source
        if !self.edges.has_key(node) -> self.edges[node] = [JetGameAssetDependencyIdentity]{}
        node
    }
    pub fn set_dependencies(&self, source: JetGameAssetSourceIdentity, dependencies: ^[JetGameAssetDependencyIdentity]) JetGameAssetPipelineError! {
        self.validate_source(source) ?? return Err(err)
        node :: source.node()
        normalized :: self.normalize_dependencies(^dependencies) ?? return Err(err)
        // Validate an overlay rather than clone the whole graph for one edge.
        // No source/edge mutation occurs before cycle validation succeeds.
        _ :: graph_order_overlay(self.edges, Val(node), normalized) ?? return Err(err)
        self.sources[node] = ~source
        self.edges[node] = normalized
    }
    pub fn add_dependency(&self, source: JetGameAssetSourceIdentity, dependency: JetGameAssetDependencyIdentity) JetGameAssetPipelineError! {
        dependencies := self.dependencies_for(source.node())
        &dependencies.push(dependency)
        &self.set_dependencies(source, ^dependencies)
    }
    pub fn dependencies_for(self, source: JetGameAssetNodeIdentity) -> [JetGameAssetDependencyIdentity] Never! {
        if self.edges.get(source) == .Val(values) -> return ~values
        [JetGameAssetDependencyIdentity]{}
    }
    pub fn source(self, node: JetGameAssetNodeIdentity) -> JetGameAssetSourceIdentity? Never! { self.sources.get(node) }
    pub fn nodes(self) -> [JetGameAssetNodeIdentity] Never! {
        keys := self.edges.keys().to_list()
        &keys.sort_by((a: JetGameAssetNodeIdentity, b: JetGameAssetNodeIdentity) -> node_order(a, b))
        keys
    }
    pub fn render_json(self) -> String Never! {
        rows := [String]{}
        loop node in self.nodes() -> &rows.push("{{\"node\":{node.render_json()},\"dependencies\":[{dependencies_json(self.edges[node])}]}}")
        "[{rows.join(",")}]"
    }
    fn validate_source(self, source: JetGameAssetSourceIdentity) JetGameAssetPipelineError! {
        if self.roots_value.contains_root(source.root) -> return
        if self.roots_value.root(source.root.id) == .Val(root) -> return Err(.RootMismatch(root.path, source.root.path))
        return Err(.RootNotDeclared(source.root.id))
    }
    fn normalize_dependencies(self, dependencies: ^[JetGameAssetDependencyIdentity]) -> [JetGameAssetDependencyIdentity] JetGameAssetPipelineError! {
        normalized := ^dependencies
        if normalized.len() > JET_GAME_ASSET_MAX_DEPENDENCIES -> return Err(.TooManyDependencies)
        loop i in 0..<normalized.len() {
            root :: self.roots_value.root(normalized[i].root_id) ?? return Err(.RootNotDeclared(normalized[i].root_id))
            path :: jet_game_asset_normalize_logical_path(normalized[i].logical_path) ?? return Err(err)
            if root.id.is_empty() -> return Err(.RootNotDeclared(root.id))
            normalized[i] = JetGameAssetDependencyIdentity{root_id: root.id, logical_path: path}
        }
        unique_dependencies(^normalized)
    }
}
pub fn jet_game_asset_graph_order(edges: [JetGameAssetNodeIdentity: [JetGameAssetDependencyIdentity]]) -> [JetGameAssetNodeIdentity] JetGameAssetPipelineError! {
    graph_order_overlay(edges, None, [JetGameAssetDependencyIdentity]{})
}
fn graph_order_overlay(edges: [JetGameAssetNodeIdentity: [JetGameAssetDependencyIdentity]], replacement: JetGameAssetNodeIdentity?, dependencies: [JetGameAssetDependencyIdentity]) -> [JetGameAssetNodeIdentity] JetGameAssetPipelineError! {
    nodes := [JetGameAssetNodeIdentity: Bool]{}
    indegree := [JetGameAssetNodeIdentity: Int]{}
    reverse := [JetGameAssetNodeIdentity: [JetGameAssetNodeIdentity: Bool]]{}
    loop node in edges.keys() {
        if replacement == Val(node) -> next
        graph_order_edges(node, edges[node], &nodes, &indegree, &reverse)
    }
    if replacement == .Val(node) -> graph_order_edges(node, dependencies, &nodes, &indegree, &reverse)
    ordered := nodes.keys().to_list()
    &ordered.sort_by((a: JetGameAssetNodeIdentity, b: JetGameAssetNodeIdentity) -> node_order(a, b))
    ranks := [JetGameAssetNodeIdentity: Int]{}
    ready := [Int]{}
    loop i in 0..<ordered.len() {
        ranks[ordered[i]] = i
        if (indegree.get(ordered[i]) ?? 0) == 0 -> graph_ready_push(&ready, i)
    }
    order := [JetGameAssetNodeIdentity]{}
    loop !ready.is_empty() {
        rank :: graph_ready_pop(&ready)
        node :: ordered[rank]
        &order.push(~node)
        if reverse.get(node) == .Val(dependents) {
            loop dependent in dependents.keys() {
                count :: indegree[dependent] - 1
                indegree[dependent] = count
                if count == 0 -> graph_ready_push(&ready, ranks[dependent])
            }
        }
    }
    if order.len() == ordered.len() -> return order
    chain := [String]{}
    // Indegree > 0 is precisely Rust's un-emitted nodes, including downstream
    // blocked nodes. Avoid Rust's per-node order.contains quadratic scan.
    loop node in ordered -> if (indegree.get(node) ?? 0) > 0 -> &chain.push(node.key())
    Err(.DependencyCycle(chain))
}
fn graph_order_edges(node: JetGameAssetNodeIdentity, dependencies: [JetGameAssetDependencyIdentity], nodes: &[JetGameAssetNodeIdentity: Bool], indegree: &[JetGameAssetNodeIdentity: Int], reverse: &[JetGameAssetNodeIdentity: [JetGameAssetNodeIdentity: Bool]]) Never! {
    nodes[node] = true
    loop dependency in dependencies {
        edge :: dependency.node()
        nodes[edge] = true
        indegree[node] = (indegree.get(node) ?? 0) + 1
        if !reverse.has_key(edge) -> reverse[edge] = [JetGameAssetNodeIdentity: Bool]{}
        reverse[edge][node] = true
    }
}
// A rank heap is specific to deterministic Kahn scheduling. Core collections'
// value-returning heappush/heappop copy their complete heap; those cannot meet
// this graph's O((V+E)log V) work and O(V+E) storage contract.
fn graph_ready_push(ready: &[Int], rank: Int) Never! {
    &ready.push(rank)
    at := ready.len() - 1
    loop at > 0 {
        parent :: (at - 1) /% 2
        if ready[parent] <= rank -> break
        ready[at] = ready[parent]
        at = parent
    }
    ready[at] = rank
}
fn graph_ready_pop(ready: &[Int]) -> Int Never! {
    rank :: ready[0]
    last :: ready[ready.len() - 1]
    _ :: &ready.pop()
    if ready.is_empty() -> return rank
    at := 0
    loop at * 2 + 1 < ready.len() {
        child := at * 2 + 1
        if child + 1 < ready.len() && ready[child + 1] < ready[child] -> child += 1
        if last <= ready[child] -> break
        ready[at] = ready[child]
        at = child
    }
    ready[at] = last
    rank
}

// Derived Rust Default anchors :338,737,873,1586 use the same constructors.
impl JetGameAssetRootSet {
    pub fn default() -> JetGameAssetRootSet Never! { {roots_value: [JetGameAssetRootIdentity]{}} }
}
impl JetGameAssetWatchFacts {
    pub fn default() -> JetGameAssetWatchFacts Never! {
        {events: [JetGameAssetWatchEvent]{}, created: [JetGameAssetNodeIdentity]{}, changed: [JetGameAssetNodeIdentity]{}, deleted: [JetGameAssetNodeIdentity]{}, skipped_count: 0}
    }
}
impl JetGameAssetDependencyGraph {
    pub fn default() -> JetGameAssetDependencyGraph Never! { JetGameAssetDependencyGraph.new(JetGameAssetRootSet.default()) }
}
impl JetGameAssetImportReport {
    pub fn default() -> JetGameAssetImportReport Never! {
        {imported: [JetGameAssetNodeIdentity]{}, dependencies: [JetGameAssetDependencyIdentity]{}, created: [JetGameAssetNodeIdentity]{}, deleted: [JetGameAssetNodeIdentity]{}, skipped: [JetGameAssetNodeIdentity]{}, skipped_count: 0, diagnostics: [JetGameAssetImportDiagnostic]{}}
    }
}

fn dependency_order(left: JetGameAssetDependencyIdentity, right: JetGameAssetDependencyIdentity) -> Ordering Never! {
    order :: left.root_id <=> right.root_id
    if order != Ordering.Equal -> return order
    left.logical_path <=> right.logical_path
}
