        if self.dependency == .Val(value) -> dependency = value.render_json()
        "{{\"severity\":{jet_game_asset_json_string(self.severity.as_str())},\"code\":{jet_game_asset_json_string(self.code)},\"message\":{jet_game_asset_json_string(self.message)},\"source\":{self.source.render_json()},\"dependency\":{dependency}}}"
    }
}
