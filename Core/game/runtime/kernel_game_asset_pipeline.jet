// GameAssetPipeline.rs:1-2351. Pure declared-root/import/reload facts: no host scan
// or importer. Publication belongs to Main; this private kernel is not a new API.
// #4499: coalescing/graph use real typed map keys, never encoded key substitutes.
// #4494/#4500: Rust :1808-2245 Store/ReloadTransaction require ONE shared native
// Arc<RwLock<State>> owner, poison-recovering borrowed guards, atomic publication
// and cleanup. No equivalent canonical provider is published: no stubs here.
// #4392: text.utf8_bytes is the sole borrowed-byte seam; its current bootstrap
// materialization is NOT allocation parity for Rust's borrowed str/as_bytes.
use core.text.runtime.kernel_unicode_string as asset_text
use core.crypto.runtime.kernel_sha256 as asset_sha256

pub JET_GAME_ASSET_MAX_ROOTS :: 64
pub JET_GAME_ASSET_MAX_PATH_BYTES :: 4096
pub JET_GAME_ASSET_MAX_ID_BYTES :: 256
pub JET_GAME_ASSET_MAX_METADATA_BYTES :: 4096
pub JET_GAME_ASSET_MAX_DEPENDENCIES :: 256
pub JET_GAME_ASSET_MAX_EVENTS :: 1024
pub JET_GAME_ASSET_MAX_SKIPPED :: 4096
pub JET_GAME_ASSET_MAX_DIAGNOSTICS :: 64
pub JET_GAME_ASSET_MAX_OUTPUTS :: 64
pub JET_GAME_ASSET_MAX_TRANSACTION_ITEMS :: 128
pub JET_GAME_ASSET_MAX_READY_ARTIFACTS :: 4096

// Rust :24-129. Payloads remain typed, including otherwise-unused variants.
#Error
pub enum JetGameAssetPipelineError {
    EmptyIdentity(field: String)
    IdentityTooLong(field: String)
    ControlIdentity(field: String)
    InvalidPath(path: String)
    PathEscape(path: String)
    UndeclaredPath(path: String)
    DuplicateRoot(value: String)
    RootNotDeclared(id: String)
    RootMismatch(expected: String, actual: String)
    TooManyRoots
    TooManyDependencies
    TooManyEvents
    TooManyDiagnostics
    TooManyOutputs
    TooManyTransactionItems
    EmptyHash(field: String)
    DuplicateDependency(dependency: String)
    DependencyCycle(chain: [String])
    MissingArtifact(source: String)
    ArtifactMismatch(field: String)
    OutcomeSourceMismatch
    OutcomeDependencyMismatch
    FailedImportWithoutDiagnostic
    TransactionClosed
    StaleTransaction(expected: U64, actual: U64)
    RejectedTransaction(reason: String)
    ReadyArtifactLimit
}
impl JetGameAssetPipelineError {
    pub fn text(self) -> String Never! {
        if self == {
            .EmptyIdentity(field) -> return "game asset {field} must not be empty"
            .IdentityTooLong(field) -> return "game asset {field} exceeds the Prelude identity limit"
            .ControlIdentity(field) -> return "game asset {field} contains a control character"
            .InvalidPath(path) -> return "invalid game asset path `{path}`"
            .PathEscape(path) -> return "game asset path escapes its declared root: `{path}`"
            .UndeclaredPath(path) -> return "game asset path is not under a declared root: `{path}`"
            .DuplicateRoot(value) -> return "game asset root `{value}` is declared more than once"
            .RootNotDeclared(id) -> return "game asset root `{id}` is not declared"
            .RootMismatch(expected, actual) -> return "game asset root mismatch: expected `{expected}`, got `{actual}`"
            .TooManyRoots -> return "game asset root limit exceeded"
            .TooManyDependencies -> return "game asset dependency limit exceeded"
            .TooManyEvents -> return "game asset watch event limit exceeded"
            .TooManyDiagnostics -> return "game asset diagnostic limit exceeded"
            .TooManyOutputs -> return "game asset output limit exceeded"
            .TooManyTransactionItems -> return "game asset reload transaction limit exceeded"
            .EmptyHash(field) -> return "game asset {field} hash must not be empty"
            .DuplicateDependency(dependency) -> return "game asset dependency `{dependency}` is duplicated"
            .DependencyCycle(chain) -> return "game asset dependency cycle: {chain.join(" -> ")}"
            .MissingArtifact(source) -> return "game asset import returned no artifact for `{source}`"
            .ArtifactMismatch(field) -> return "game asset artifact does not match plan {field}"
            .OutcomeSourceMismatch -> return "game asset import outcome source does not match plan"
            .OutcomeDependencyMismatch -> return "game asset import outcome dependencies do not match plan"
            .FailedImportWithoutDiagnostic -> return "failed game asset import has no source-linked diagnostic"
            .TransactionClosed -> return "game asset reload transaction is closed"
            .StaleTransaction(expected, actual) -> return "stale game asset reload transaction: expected revision {expected}, current revision {actual}"
            .RejectedTransaction(reason) -> return "game asset reload transaction rejected: {reason}"
            .ReadyArtifactLimit -> return "ready game asset artifact limit exceeded"
        }
    }
}

fn has_control(value: String) -> Bool Never! { !asset_text.isprintable(value) }
// :131-177. Trim precedes size and Cc rejection; metadata is NOT trimmed.
pub fn jet_game_asset_text(value: String, field: String) -> String JetGameAssetPipelineError! {
    trimmed := value.trim() // #4303
    if trimmed.is_empty() -> return Err(.EmptyIdentity(field))
    if trimmed.count_bytes() > JET_GAME_ASSET_MAX_ID_BYTES -> return Err(.IdentityTooLong(field))
    if has_control(trimmed) -> return Err(.ControlIdentity(field))
    trimmed
}
pub fn jet_game_asset_metadata(value: String) -> String JetGameAssetPipelineError! {
    if value.count_bytes() > JET_GAME_ASSET_MAX_METADATA_BYTES -> return Err(.IdentityTooLong("runtime metadata"))
    if has_control(value) -> return Err(.ControlIdentity("runtime metadata"))
    value
}
fn jet_game_asset_path_text(value: String) -> String JetGameAssetPipelineError! {
    trimmed := value.trim() // #4303
    if trimmed.is_empty() -> return Err(.InvalidPath(value))
    if trimmed.count_bytes() > JET_GAME_ASSET_MAX_PATH_BYTES -> return Err(.IdentityTooLong("path"))
    if has_control(trimmed) -> return Err(.ControlIdentity("path"))
    trimmed.replace("\\", "/")
}
fn drive_prefix(path: String) -> Bool Never! {
    if path.count_bytes() < 3 -> return false
    first := path.slice(0, 1) // #4303
    tail := path.slice(1, 3) // #4303
    first.count_bytes() == 1 && tail == ":/"
}
// :182-254. Components are views; one stack and one final join, no loop concat.
pub fn jet_game_asset_normalize_path(value: String) -> String JetGameAssetPipelineError! {
    path := jet_game_asset_path_text(value) ?? return Err(err)
    absolute :: path.starts_with("/")
    drive :: drive_prefix(path)
    prefix_len :: if absolute -> 1 else -> if drive -> 3 else -> 0
    prefix := path.slice(0, prefix_len) // #4303
    suffix := path.slice(prefix_len, path.len()) // #4303: slice counts scalars.
    components := [String]{}
    loop component in suffix.split("/") {
        if component == "" || component == "." -> next
        if component == ".." {
            if components.is_empty() -> return Err(.PathEscape(value))
            _ :: &components.pop()
        } else {
            &components.push(component)
        }
    }
    if components.is_empty() {
        if absolute || drive -> return prefix
        return "."
    }
    "{prefix}{components.join("/")}"
}
pub fn jet_game_asset_normalize_logical_path(value: String) -> String JetGameAssetPipelineError! {
    path := jet_game_asset_path_text(value) ?? return Err(err)
    if path.starts_with("/") || drive_prefix(path) -> return Err(.InvalidPath(value))
    components := [String]{}
    loop component in path.split("/") {
        if component == "" || component == "." -> next
        if component == ".." {
            if components.is_empty() -> return Err(.PathEscape(value))
            _ :: &components.pop()
        } else {
            &components.push(component)
        }
    }
    if components.is_empty() -> return Err(.InvalidPath(value))
    components.join("/")
}
pub fn jet_game_asset_relative_path(root: String, path: String) -> String? Never! {
    if root == "." {
        if path.starts_with("/") || drive_prefix(path) || path == "." -> return None
        return Val(path)
    }
    if root == "/" {
        if !path.starts_with("/") || path.count_bytes() <= 1 -> return None
        relative := path.slice(1, path.len()) // #4303
        return Val(relative)
    }
    prefix :: "{root}/"
    if !path.starts_with(prefix) || path.count_bytes() == prefix.count_bytes() -> return None
    relative := path.slice(prefix.len(), path.len()) // #4303
    Val(relative)
}
pub fn jet_game_asset_path_key(root: String, logical_path: String) -> String Never! {
    "{root.count_bytes()}:{root}:{logical_path}"
}
fn append_text(out: &[U8], value: String) Never! {
    loop byte in asset_text.utf8_bytes(value) -> &out.push(byte)
}
// :278-296. This wire law differs from general JSON: Cc includes DEL and C1,
// and backspace/formfeed use lowercase \\u0008/\\u000c, never \\b/\\f.
pub fn jet_game_asset_json_string(value: String) -> String Never! {
    raw :: asset_text.utf8_bytes(value)
    out := [U8]{U8{34}}
    at := 0
    loop at < raw.len() {
        cp :: asset_text.scalar_at(raw, at)
        width :: asset_text.utf8_width_at(raw, at)
        if cp == 34 {
            append_text(&out, "\\\"")
        } else if cp == 92 {
            append_text(&out, "\\\\")
        } else if cp == 10 {
            append_text(&out, "\\n")
        } else if cp == 13 {
            append_text(&out, "\\r")
        } else if cp == 9 {
            append_text(&out, "\\t")
        } else if cp < 32 || (cp >= 127 && cp <= 159) {
            append_text(&out, "\\u00")
            &out.push(hex_digit(cp >> 4))
            &out.push(hex_digit(cp & 15))
        } else {
            loop i in at..<(at + width) -> &out.push(raw[i])
        }
        at += width
    }
    &out.push(U8{34})
    String.from_bytes(out) ?? panic("game asset JSON emitted invalid UTF-8")
}
fn hex_digit(n: Int) -> U8 Never! { if n < 10 -> U8{48 + n} else -> U8{87 + n} }
// :2247-2351 reuses the sole Core SHA-256 implementation, not a second digest.
pub fn jet_game_asset_hash_bytes(bytes: [U8]) -> String Never! {
    digest :: asset_sha256.sha256_bytes(bytes)
    out := [U8]{}
    append_text(&out, "sha256-")
    loop byte in digest {
        n :: Int.from_u8(byte)
        &out.push(hex_digit(n >> 4))
        &out.push(hex_digit(n & 15))
    }
    String.from_bytes(out) ?? panic("game asset hash emitted invalid UTF-8")
}

pub struct JetGameAssetRootIdentity {
    pub id: String
    pub path: String
}
impl JetGameAssetRootIdentity {
    pub fn new(id: String, path: String) -> JetGameAssetRootIdentity JetGameAssetPipelineError! {
        normalized_id :: jet_game_asset_text(id, "root id") ?? return Err(err)
        normalized_path :: jet_game_asset_normalize_path(path) ?? return Err(err)
        {id: normalized_id, path: normalized_path}
    }
    pub fn validate(self) JetGameAssetPipelineError! {
        expected :: JetGameAssetRootIdentity.new(self.id, self.path) ?? return Err(err)
        if self != expected -> return Err(.InvalidPath(self.path))
    }
    pub fn render_json(self) -> String Never! { "{{\"id\":{jet_game_asset_json_string(self.id)},\"path\":{jet_game_asset_json_string(self.path)}}}" }
}
fn root_order(left: JetGameAssetRootIdentity, right: JetGameAssetRootIdentity) -> Ordering Never! {
    order :: left.id <=> right.id
    if order != Ordering.Equal -> return order
    left.path <=> right.path
}
pub struct JetGameAssetRootSet { roots_value: [JetGameAssetRootIdentity] }
impl JetGameAssetRootSet {
    pub fn new(roots: [JetGameAssetRootIdentity]) -> JetGameAssetRootSet JetGameAssetPipelineError! {
        set := JetGameAssetRootSet{roots_value: [JetGameAssetRootIdentity]{}}
        loop root in roots -> &set.declare(root) ?? return Err(err)
        set
    }
    pub fn declare(&self, root: JetGameAssetRootIdentity) JetGameAssetPipelineError! {
        root.validate() ?? return Err(err)
        if self.roots_value.len() >= JET_GAME_ASSET_MAX_ROOTS -> return Err(.TooManyRoots)
        loop current in self.roots_value {
            if current.id == root.id || current.path == root.path -> return Err(.DuplicateRoot(root.id))
        }
        &self.roots_value.push(root)
        &self.roots_value.sort_by((a: JetGameAssetRootIdentity, b: JetGameAssetRootIdentity) -> root_order(a, b))
    }
    pub fn roots(self) -> [JetGameAssetRootIdentity] Never! { self.roots_value }
    pub fn root(self, id: String) -> JetGameAssetRootIdentity? Never! {
        loop root in self.roots_value -> if root.id == id -> return Val(root)
        None
    }
    pub fn resolve(self, path: String) -> JetGameAssetResolvedPath JetGameAssetPipelineError! {
        normalized :: jet_game_asset_normalize_path(path) ?? return Err(err)
        best := JetGameAssetResolvedPath?{None}
        depth := -1
        // Rust sorts all matches; selecting its minimum retains its exact tie
        // rule while avoiding match-table copies and an unnecessary sort.
        loop root in self.roots_value {
            relative :: jet_game_asset_relative_path(root.path, normalized) ?? next
            current_depth :: root.path.split("/").len()
            take := current_depth > depth
            if current_depth == depth {
                if best == .Val(previous) -> take = root.id < previous.root.id
            }
            if take {
                best = Val(JetGameAssetResolvedPath{root: root, logical_path: relative})
                depth = current_depth
            }
        }
        best ?? return Err(.UndeclaredPath(path))
    }
    pub fn contains_root(self, root: JetGameAssetRootIdentity) -> Bool Never! {
        loop declared in self.roots_value -> if declared == root -> return true
        false
    }
    pub fn render_json(self) -> String Never! {
        rows := [String]{}
        loop root in self.roots_value -> &rows.push(root.render_json())
        "[{rows.join(",")}]"
    }
}
pub struct JetGameAssetResolvedPath {
    pub root: JetGameAssetRootIdentity
    pub logical_path: String
}
impl JetGameAssetResolvedPath {
    pub fn node(self) -> JetGameAssetNodeIdentity Never! { {root_id: self.root.id, logical_path: self.logical_path} }
}
pub struct JetGameAssetSourceIdentity {
    pub root: JetGameAssetRootIdentity
    pub logical_path: String
    pub content_hash: String
}
impl JetGameAssetSourceIdentity {
    pub fn new(root: JetGameAssetRootIdentity, logical_path: String, content_hash: String) -> JetGameAssetSourceIdentity JetGameAssetPipelineError! {
        root.validate() ?? return Err(err)
        path :: jet_game_asset_normalize_logical_path(logical_path) ?? return Err(err)
        hash :: jet_game_asset_text(content_hash, "source hash") ?? return Err(err)
        {root: root, logical_path: path, content_hash: hash}
    }
    pub fn from_bytes(root: JetGameAssetRootIdentity, logical_path: String, bytes: [U8]) -> JetGameAssetSourceIdentity JetGameAssetPipelineError! {
        JetGameAssetSourceIdentity.new(root, logical_path, jet_game_asset_hash_bytes(bytes))
    }
    pub fn node(self) -> JetGameAssetNodeIdentity Never! { {root_id: self.root.id, logical_path: self.logical_path} }
    pub fn absolute_path(self) -> String Never! {
        if self.root.path == "." -> return self.logical_path
        if self.root.path == "/" -> return "/{self.logical_path}"
        "{self.root.path}/{self.logical_path}"
    }
    pub fn render_json(self) -> String Never! { "{{\"root\":{self.root.render_json()},\"logical_path\":{jet_game_asset_json_string(self.logical_path)},\"content_hash\":{jet_game_asset_json_string(self.content_hash)}}}" }
}
pub struct JetGameAssetNodeIdentity {
    pub root_id: String
    pub logical_path: String
}
impl JetGameAssetNodeIdentity {
    pub fn new(root_id: String, logical_path: String) -> JetGameAssetNodeIdentity JetGameAssetPipelineError! {
        root :: jet_game_asset_text(root_id, "root id") ?? return Err(err)
        path :: jet_game_asset_normalize_logical_path(logical_path) ?? return Err(err)
        {root_id: root, logical_path: path}
    }
    pub fn from_source(source: JetGameAssetSourceIdentity) -> JetGameAssetNodeIdentity Never! { source.node() }
    pub fn key(self) -> String Never! { jet_game_asset_path_key(self.root_id, self.logical_path) }
    pub fn render_json(self) -> String Never! { "{{\"root_id\":{jet_game_asset_json_string(self.root_id)},\"logical_path\":{jet_game_asset_json_string(self.logical_path)}}}" }
}
fn node_order(left: JetGameAssetNodeIdentity, right: JetGameAssetNodeIdentity) -> Ordering Never! {
    order :: left.root_id <=> right.root_id
    if order != Ordering.Equal -> return order
    left.logical_path <=> right.logical_path
}
pub struct JetGameAssetDependencyIdentity {
    pub root_id: String
    pub logical_path: String
}
impl JetGameAssetDependencyIdentity {
    pub fn new(root_id: String, logical_path: String) -> JetGameAssetDependencyIdentity JetGameAssetPipelineError! {
        root :: jet_game_asset_text(root_id, "dependency root id") ?? return Err(err)
        path :: jet_game_asset_normalize_logical_path(logical_path) ?? return Err(err)
        {root_id: root, logical_path: path}
    }
    pub fn from_root(root: JetGameAssetRootIdentity, logical_path: String) -> JetGameAssetDependencyIdentity JetGameAssetPipelineError! { JetGameAssetDependencyIdentity.new(root.id, logical_path) }
    pub fn node(self) -> JetGameAssetNodeIdentity Never! { {root_id: self.root_id, logical_path: self.logical_path} }
    pub fn key(self) -> String Never! { jet_game_asset_path_key(self.root_id, self.logical_path) }
    pub fn render_json(self) -> String Never! { "{{\"root_id\":{jet_game_asset_json_string(self.root_id)},\"logical_path\":{jet_game_asset_json_string(self.logical_path)}}}" }
}
pub struct JetGameAssetRecipeIdentity {
    pub name: String
    pub version: String
}
impl JetGameAssetRecipeIdentity {
    pub fn new(name: String, version: String) -> JetGameAssetRecipeIdentity JetGameAssetPipelineError! {
        n :: jet_game_asset_text(name, "recipe name") ?? return Err(err)
        v :: jet_game_asset_text(version, "recipe version") ?? return Err(err)
        {name: n, version: v}
    }
    pub fn render_json(self) -> String Never! { "{{\"name\":{jet_game_asset_json_string(self.name)},\"version\":{jet_game_asset_json_string(self.version)}}}" }
}
pub struct JetGameAssetToolIdentity {
    pub name: String
    pub version: String
}
impl JetGameAssetToolIdentity {
    pub fn new(name: String, version: String) -> JetGameAssetToolIdentity JetGameAssetPipelineError! {
        n :: jet_game_asset_text(name, "tool name") ?? return Err(err)
        v :: jet_game_asset_text(version, "tool version") ?? return Err(err)
        {name: n, version: v}
    }
    pub fn render_json(self) -> String Never! { "{{\"name\":{jet_game_asset_json_string(self.name)},\"version\":{jet_game_asset_json_string(self.version)}}}" }
