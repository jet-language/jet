pub struct JetGameAssetVersionIdentity { pub value: String }
impl JetGameAssetVersionIdentity {
    pub fn new(value: String) -> JetGameAssetVersionIdentity JetGameAssetPipelineError! {
        v :: jet_game_asset_text(value, "version") ?? return Err(err)
        {value: v}
    }
    pub fn numeric(value: U64) -> JetGameAssetVersionIdentity Never! { {value: "{value}"} }
    pub fn render_json(self) -> String Never! { jet_game_asset_json_string(self.value) }
}

pub enum JetGameAssetWatchEventKind {
    Created
    Changed
    Deleted
}
impl JetGameAssetWatchEventKind {
    pub fn as_str(self) -> String Never! {
        if self == {
            .Created -> return "created"
            .Changed -> return "changed"
            .Deleted -> return "deleted"
        }
    }
}
pub struct JetGameAssetWatchEvent {
    pub root: JetGameAssetRootIdentity
    pub logical_path: String
    pub kind: JetGameAssetWatchEventKind
}
impl JetGameAssetWatchEvent {
    pub fn new(root: JetGameAssetRootIdentity, logical_path: String, kind: JetGameAssetWatchEventKind) -> JetGameAssetWatchEvent JetGameAssetPipelineError! {
        root.validate() ?? return Err(err)
        path :: jet_game_asset_normalize_logical_path(logical_path) ?? return Err(err)
        {root: root, logical_path: path, kind: kind}
    }
    pub fn from_path(roots: JetGameAssetRootSet, path: String, kind: JetGameAssetWatchEventKind) -> JetGameAssetWatchEvent JetGameAssetPipelineError! {
        resolved :: roots.resolve(path) ?? return Err(err)
        JetGameAssetWatchEvent.new(resolved.root, resolved.logical_path, kind)
    }
    pub fn node(self) -> JetGameAssetNodeIdentity Never! { {root_id: self.root.id, logical_path: self.logical_path} }
    pub fn render_json(self) -> String Never! { "{{\"root\":{self.root.render_json()},\"logical_path\":{jet_game_asset_json_string(self.logical_path)},\"kind\":{jet_game_asset_json_string(self.kind.as_str())}}}" }
}
pub fn jet_game_asset_net_event_kind(first: JetGameAssetWatchEventKind, last: JetGameAssetWatchEventKind) -> JetGameAssetWatchEventKind? Never! {
    if first == .Created && last == .Deleted -> return None
    if first == .Deleted && last == .Created -> return Val(.Changed)
    if first == .Created -> return Val(.Created)
    if last == .Deleted -> return Val(.Deleted)
    Val(.Changed)
}
fn unique_nodes(values: ^[JetGameAssetNodeIdentity]) -> [JetGameAssetNodeIdentity] Never! {
    out := ^values
    &out.sort_by((a: JetGameAssetNodeIdentity, b: JetGameAssetNodeIdentity) -> node_order(a, b))
    write := 0
    loop read in 0..<out.len() {
        if write == 0 || out[read] != out[write - 1] {
            if read != write -> out[write] = ~out[read]
            write += 1
        }
    }
    loop out.len() > write -> _ :: &out.pop()
    out
}
fn unique_dependencies(values: ^[JetGameAssetDependencyIdentity]) -> [JetGameAssetDependencyIdentity] Never! {
    out := ^values
    &out.sort_by((a: JetGameAssetDependencyIdentity, b: JetGameAssetDependencyIdentity) -> dependency_order(a, b))
    write := 0
    loop read in 0..<out.len() {
        if write == 0 || out[read] != out[write - 1] {
            if read != write -> out[write] = ~out[read]
            write += 1
        }
    }
    loop out.len() > write -> _ :: &out.pop()
    out
}
fn nodes_json(values: [JetGameAssetNodeIdentity]) -> String Never! {
    rows := [String]{}
    loop value in values -> &rows.push(value.render_json())
    rows.join(",")
}
fn dependencies_json(values: [JetGameAssetDependencyIdentity]) -> String Never! {
    rows := [String]{}
    loop value in values -> &rows.push(value.render_json())
    rows.join(",")
}
pub struct JetGameAssetWatchFacts {
    pub events: [JetGameAssetWatchEvent]
    pub created: [JetGameAssetNodeIdentity]
    pub changed: [JetGameAssetNodeIdentity]
    pub deleted: [JetGameAssetNodeIdentity]
    pub skipped_count: Int
}
impl JetGameAssetWatchFacts {
    pub fn imported_nodes(self) -> [JetGameAssetNodeIdentity] Never! {
        nodes := ~self.created
        loop node in self.changed -> &nodes.push(~node)
        unique_nodes(^nodes)
    }
    pub fn render_json(self) -> String Never! {
        events := [String]{}
        loop event in self.events -> &events.push(event.render_json())
        "{{\"events\":[{events.join(",")}],\"created\":[{nodes_json(self.created)}],\"changed\":[{nodes_json(self.changed)}],\"deleted\":[{nodes_json(self.deleted)}],\"skipped_count\":{self.skipped_count}}}"
    }
}

// :1073-1221. Lengths in cache material are UTF-8 byte counts, not scalars.
pub struct JetGameAssetImportPlan {
    pub source: JetGameAssetSourceIdentity
    pub recipe: JetGameAssetRecipeIdentity
    pub tool: JetGameAssetToolIdentity
    pub version: JetGameAssetVersionIdentity
    pub dependencies: [JetGameAssetDependencyIdentity]
    pub cache_key: String
}
impl JetGameAssetImportPlan {
    pub fn new(source: JetGameAssetSourceIdentity, recipe: JetGameAssetRecipeIdentity, tool: JetGameAssetToolIdentity, version: JetGameAssetVersionIdentity) -> JetGameAssetImportPlan JetGameAssetPipelineError! {
        plan := JetGameAssetImportPlan{source: source, recipe: recipe, tool: tool, version: version, dependencies: [JetGameAssetDependencyIdentity]{}, cache_key: ""}
        plan.cache_key = plan.compute_cache_key()
        plan.validate() ?? return Err(err)
        plan
    }
    pub fn from_source(source: JetGameAssetSourceIdentity, recipe: JetGameAssetRecipeIdentity, tool: JetGameAssetToolIdentity, version: JetGameAssetVersionIdentity) -> JetGameAssetImportPlan JetGameAssetPipelineError! {
        JetGameAssetImportPlan.new(source, recipe, tool, version)
    }
    pub fn with_dependencies(^self, dependencies: ^[JetGameAssetDependencyIdentity]) -> JetGameAssetImportPlan JetGameAssetPipelineError! {
        plan := ^self
        plan.dependencies = jet_game_asset_normalize_dependency_list(^dependencies) ?? return Err(err)
        plan.cache_key = plan.compute_cache_key()
        plan.validate() ?? return Err(err)
        plan
    }
    pub fn compute_cache_key(self) -> String Never! {
        jet_game_asset_import_cache_key(self.source.content_hash, self.recipe, self.tool, self.version, self.dependencies)
    }
    pub fn validate(self) JetGameAssetPipelineError! {
        self.source.root.validate() ?? return Err(err)
        _ :: jet_game_asset_normalize_logical_path(self.source.logical_path) ?? return Err(err)
        hash := self.source.content_hash.trim() // #4303
        if hash.is_empty() -> return Err(.EmptyHash("source"))
        if self.dependencies.len() > JET_GAME_ASSET_MAX_DEPENDENCIES -> return Err(.TooManyDependencies)
        if self.cache_key != self.compute_cache_key() -> return Err(.ArtifactMismatch("cache key"))
    }
    pub fn node(self) -> JetGameAssetNodeIdentity Never! { self.source.node() }
    pub fn render_json(self) -> String Never! { "{{\"source\":{self.source.render_json()},\"recipe\":{self.recipe.render_json()},\"tool\":{self.tool.render_json()},\"version\":{self.version.render_json()},\"dependencies\":[{dependencies_json(self.dependencies)}],\"cache_key\":{jet_game_asset_json_string(self.cache_key)}}}" }
}
pub fn jet_game_asset_normalize_dependency_list(dependencies: ^[JetGameAssetDependencyIdentity]) -> [JetGameAssetDependencyIdentity] JetGameAssetPipelineError! {
    normalized := ^dependencies
    if normalized.len() > JET_GAME_ASSET_MAX_DEPENDENCIES -> return Err(.TooManyDependencies)
    loop i in 0..<normalized.len() {
        normalized[i].root_id = jet_game_asset_text(normalized[i].root_id, "dependency root id") ?? return Err(err)
        normalized[i].logical_path = jet_game_asset_normalize_logical_path(normalized[i].logical_path) ?? return Err(err)
    }
    unique_dependencies(^normalized)
}
fn jet_game_asset_cache_component(value: String, output: &[U8]) Never! {
    append_text(&output, "{value.count_bytes()}:")
    append_text(&output, value)
    &output.push(U8{59})
}
pub fn jet_game_asset_import_cache_key(source_hash: String, recipe: JetGameAssetRecipeIdentity, tool: JetGameAssetToolIdentity, version: JetGameAssetVersionIdentity, dependencies: [JetGameAssetDependencyIdentity]) -> String Never! {
    material := [U8]{}
    append_text(&material, "jet-game-asset-cache-v1;")
    jet_game_asset_cache_component(source_hash, &material)
    jet_game_asset_cache_component(recipe.name, &material)
    jet_game_asset_cache_component(recipe.version, &material)
    jet_game_asset_cache_component(tool.name, &material)
    jet_game_asset_cache_component(tool.version, &material)
    jet_game_asset_cache_component(version.value, &material)
    // Preserve caller order/ownership. Sort indices, not whole identities.
    indices := [Int]{}
    loop i in 0..<dependencies.len() -> &indices.push(i)
    &indices.sort_by((a: Int, b: Int) -> dependency_order(dependencies[a], dependencies[b]))
    previous := -1
    loop i in indices {
        if previous >= 0 && dependencies[i] == dependencies[previous] -> next
        jet_game_asset_cache_component(dependencies[i].root_id, &material)
        jet_game_asset_cache_component(dependencies[i].logical_path, &material)
        previous = i
    }
    jet_game_asset_hash_bytes(material)
}

