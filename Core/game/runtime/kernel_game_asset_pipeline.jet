}
impl JetGameAssetArtifactIdentity {
    pub fn new(plan: JetGameAssetImportPlan, output_hash: String) -> JetGameAssetArtifactIdentity JetGameAssetPipelineError! {
        plan.validate() ?? return Err(err)
        hash :: jet_game_asset_text(output_hash, "output hash") ?? return Err(err)
        {cache_key: ~plan.cache_key, source: ~plan.source, recipe: ~plan.recipe, tool: ~plan.tool, version: ~plan.version, output_hash: hash}
    }
    pub fn compatible_with(self, plan: JetGameAssetImportPlan) JetGameAssetPipelineError! {
        if self.cache_key != plan.cache_key -> return Err(.ArtifactMismatch("cache key"))
        if self.source != plan.source -> return Err(.ArtifactMismatch("source"))
        if self.recipe != plan.recipe -> return Err(.ArtifactMismatch("recipe"))
        if self.tool != plan.tool -> return Err(.ArtifactMismatch("tool"))
        if self.version != plan.version -> return Err(.ArtifactMismatch("version"))
    }
    pub fn render_json(self) -> String Never! {
        "{{\"cache_key\":{jet_game_asset_json_string(self.cache_key)},\"source\":{self.source.render_json()},\"recipe\":{self.recipe.render_json()},\"tool\":{self.tool.render_json()},\"version\":{self.version.render_json()},\"output_hash\":{jet_game_asset_json_string(self.output_hash)}}}"
    }
}
fn artifacts_json(values: [JetGameAssetArtifactIdentity]) -> String Never! {
    rows := [String]{}
    loop value in values -> &rows.push(value.render_json())
    rows.join(",")
}
pub struct JetGameAssetRuntimeFact {
    pub artifact: JetGameAssetArtifactIdentity
    pub bytes: [U8]
    pub metadata: String
}
impl JetGameAssetRuntimeFact {
    pub fn new(artifact: JetGameAssetArtifactIdentity, bytes: ^[U8], metadata: String) -> JetGameAssetRuntimeFact JetGameAssetPipelineError! {
        meta :: jet_game_asset_metadata(metadata) ?? return Err(err)
        {artifact: artifact, bytes: ^bytes, metadata: meta}
    }
    pub fn from_ready(plan: JetGameAssetImportPlan, outcome: JetGameAssetImportOutcome, bytes: ^[U8], metadata: String) -> JetGameAssetRuntimeFact JetGameAssetPipelineError! {
        outcome.validate_against(plan) ?? return Err(err)
        artifact :: outcome.artifact() ?? return Err(.MissingArtifact(plan.source.logical_path))
        JetGameAssetRuntimeFact.new(~artifact, ^bytes, metadata)
    }
    pub fn validate_against(self, plan: JetGameAssetImportPlan, outcome: JetGameAssetImportOutcome) JetGameAssetPipelineError! {
        outcome.validate_against(plan) ?? return Err(err)
        self.artifact.compatible_with(plan) ?? return Err(err)
        _ :: jet_game_asset_metadata(self.metadata) ?? return Err(err)
        if outcome.artifact() != Val(self.artifact) -> return Err(.ArtifactMismatch("runtime fact"))
    }
    pub fn byte_len(self) -> U64 Never! { U64{self.bytes.len()} }
    pub fn render_json(self) -> String Never! {
        "{{\"artifact\":{self.artifact.render_json()},\"byte_len\":{self.byte_len()},\"metadata\":{jet_game_asset_json_string(self.metadata)}}}"
    }
}
pub struct JetGameAssetImportOutcome {
    pub status: JetGameAssetImportStatus
    pub source: JetGameAssetSourceIdentity
    pub artifacts: [JetGameAssetArtifactIdentity]
    pub dependencies: [JetGameAssetDependencyIdentity]
    pub diagnostics: [JetGameAssetImportDiagnostic]
}
// Compare normalized dependency sets via sorted indices. No identity-table
// copies and no quadratic membership scans; duplicates are ignored as in Rust.
fn dependency_set_equal(left: [JetGameAssetDependencyIdentity], right: [JetGameAssetDependencyIdentity]) -> Bool Never! {
    li := [Int]{}
    ri := [Int]{}
    loop i in 0..<left.len() -> &li.push(i)
    loop i in 0..<right.len() -> &ri.push(i)
    &li.sort_by((a: Int, b: Int) -> dependency_order(left[a], left[b]))
    &ri.sort_by((a: Int, b: Int) -> dependency_order(right[a], right[b]))
    l := 0
    r := 0
    loop l < li.len() && r < ri.len() {
        if left[li[l]] != right[ri[r]] -> return false
        before_l :: l
        before_r :: r
        l += 1
        r += 1
        loop l < li.len() && left[li[l]] == left[li[before_l]] -> l += 1
        loop r < ri.len() && right[ri[r]] == right[ri[before_r]] -> r += 1
    }
    l == li.len() && r == ri.len()
}
impl JetGameAssetImportOutcome {
    pub fn ready(plan: JetGameAssetImportPlan, output_hash: String) -> JetGameAssetImportOutcome JetGameAssetPipelineError! {
        artifact :: JetGameAssetArtifactIdentity.new(plan, output_hash) ?? return Err(err)
        {status: .Ready, source: ~plan.source, artifacts: [JetGameAssetArtifactIdentity]{artifact}, dependencies: ~plan.dependencies, diagnostics: [JetGameAssetImportDiagnostic]{}}
    }
    pub fn failed(plan: JetGameAssetImportPlan, code: String, message: String) -> JetGameAssetImportOutcome JetGameAssetPipelineError! {
        diagnostic :: JetGameAssetImportDiagnostic.error(~plan.source, code, message) ?? return Err(err)
        {status: .Failed, source: ~plan.source, artifacts: [JetGameAssetArtifactIdentity]{}, dependencies: ~plan.dependencies, diagnostics: [JetGameAssetImportDiagnostic]{diagnostic}}
    }
    pub fn validate_against(self, plan: JetGameAssetImportPlan) JetGameAssetPipelineError! {
        plan.validate() ?? return Err(err)
        if self.source != plan.source -> return Err(.OutcomeSourceMismatch)
        if !dependency_set_equal(plan.dependencies, self.dependencies) -> return Err(.OutcomeDependencyMismatch)
        if self.diagnostics.len() > JET_GAME_ASSET_MAX_DIAGNOSTICS -> return Err(.TooManyDiagnostics)
        if self.artifacts.len() > JET_GAME_ASSET_MAX_OUTPUTS -> return Err(.TooManyOutputs)
        if self.status == .Ready {
            if self.artifacts.is_empty() -> return Err(.MissingArtifact(self.source.logical_path))
            loop artifact in self.artifacts -> artifact.compatible_with(plan) ?? return Err(err)
            hash := self.artifacts[0].output_hash.trim() // #4303
            if hash.is_empty() -> return Err(.EmptyHash("output"))
        } else {
            if !self.artifacts.is_empty() -> return Err(.ArtifactMismatch("failed outcome output"))
            linked := false
            loop diagnostic in self.diagnostics {
                if diagnostic.source == self.source && diagnostic.severity == .Error {
                    linked = true
                    break
                }
            }
            if !linked -> return Err(.FailedImportWithoutDiagnostic)
        }
    }
    pub fn artifact(self) -> JetGameAssetArtifactIdentity? Never! {
        if self.artifacts.is_empty() -> return None
        Val(self.artifacts[0])
    }
    pub fn is_ready(self) -> Bool Never! { self.status == .Ready }
    pub fn render_json(self) -> String Never! {
        "{{\"status\":{jet_game_asset_json_string(self.status.as_str())},\"source\":{self.source.render_json()},\"artifacts\":[{artifacts_json(self.artifacts)}],\"dependencies\":[{dependencies_json(self.dependencies)}],\"diagnostics\":[{diagnostics_json(self.diagnostics)}]}}"
    }
}
pub struct JetGameAssetImportReport {
    pub imported: [JetGameAssetNodeIdentity]
    pub dependencies: [JetGameAssetDependencyIdentity]
    pub created: [JetGameAssetNodeIdentity]
    pub deleted: [JetGameAssetNodeIdentity]
    pub skipped: [JetGameAssetNodeIdentity]
    pub skipped_count: Int
    pub diagnostics: [JetGameAssetImportDiagnostic]
}
impl JetGameAssetImportReport {
    pub fn from_watch(facts: JetGameAssetWatchFacts) -> JetGameAssetImportReport Never! {
        report := JetGameAssetImportReport{imported: facts.imported_nodes(), dependencies: [JetGameAssetDependencyIdentity]{}, created: ~facts.created, deleted: ~facts.deleted, skipped: [JetGameAssetNodeIdentity]{}, skipped_count: facts.skipped_count, diagnostics: [JetGameAssetImportDiagnostic]{}}
        &report.sort_and_dedup()
        report
    }
    pub fn record_dependency(&self, dependency: JetGameAssetDependencyIdentity) Never! {
        if self.dependencies.len() < JET_GAME_ASSET_MAX_DEPENDENCIES {
            &self.dependencies.push(dependency)
            self.dependencies = unique_dependencies(^self.dependencies)
        }
    }
    pub fn record_skipped(&self, node: JetGameAssetNodeIdentity) Never! {
        if self.skipped.len() < JET_GAME_ASSET_MAX_EVENTS {
            &self.skipped.push(node)
            self.skipped = unique_nodes(^self.skipped)
        }
    }
    pub fn record_diagnostic(&self, diagnostic: JetGameAssetImportDiagnostic) JetGameAssetPipelineError! {
        if self.diagnostics.len() >= JET_GAME_ASSET_MAX_DIAGNOSTICS -> return Err(.TooManyDiagnostics)
        &self.diagnostics.push(diagnostic)
        &self.diagnostics.sort_by((a: JetGameAssetImportDiagnostic, b: JetGameAssetImportDiagnostic) -> diagnostic_order(a, b))
    }
    pub fn sort_and_dedup(&self) Never! {
        self.imported = unique_nodes(^self.imported)
        self.created = unique_nodes(^self.created)
        self.deleted = unique_nodes(^self.deleted)
        self.skipped = unique_nodes(^self.skipped)
        self.dependencies = unique_dependencies(^self.dependencies)
    }
    pub fn render_json(self) -> String Never! {
        "{{\"imported\":[{nodes_json(self.imported)}],\"dependencies\":[{dependencies_json(self.dependencies)}],\"created\":[{nodes_json(self.created)}],\"deleted\":[{nodes_json(self.deleted)}],\"skipped\":[{nodes_json(self.skipped)}],\"skipped_count\":{self.skipped_count},\"diagnostics\":[{diagnostics_json(self.diagnostics)}]}}"
    }
}
fn diagnostic_order(left: JetGameAssetImportDiagnostic, right: JetGameAssetImportDiagnostic) -> Ordering Never! {
    roots :: left.source.root.id <=> right.source.root.id
    if roots != Ordering.Equal -> return roots
    order :: left.source.logical_path <=> right.source.logical_path
    if order != Ordering.Equal -> return order
    left.code <=> right.code
}
