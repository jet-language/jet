pub JET_GAME_PAUSED_EVAL_BUDGET :: "budget_exceeded"

// Rust :13-34. Empty fact spans are valid; edits require nonempty spans.
#Equatable
pub struct JetGameWorldSourceSpan { pub start: Int, pub end: Int }
impl JetGameWorldSourceSpan {
    pub fn new(start: Int, end: Int) -> JetGameWorldSourceSpan JetGameWorldInspectorError! {
        if start > end -> return Err(JetGameWorldInspectorError.InvalidSourceSpan)
        JetGameWorldSourceSpan{start, end}
    }
    pub fn is_empty(self) -> Bool Never! { self.start >= self.end }
    pub fn render_json(self) -> String Never! { "{{\"start\":{self.start},\"end\":{self.end}}}" }
    // Rust derived Ord/PartialOrd: lexicographic (start,end).
    pub fn compare(self, other: JetGameWorldSourceSpan) -> Ordering Never! {
        start :: self.start <=> other.start
        if start != Ordering.Equal -> return start
        self.end <=> other.end
    }
}
// Rust :36-130, including the exact Display branches; typed errors stay typed.
#Error
#Equatable
pub enum JetGameWorldInspectorError {
    EmptyText(field: String)
    TextTooLong(field: String)
    TooManyEntities
    TooManyComponents(entity_id: String)
    TooManyProperties(component_id: String)
    TooManyFrames
    DuplicateId(id: String)
    DuplicateProperty(component_id: String, field: String)
    MissingParent(child_id: String, parent_id: String)
    Cycle(id: String)
    InvalidSourceSpan
    NoWorld
    MismatchedWorld(expected: String, actual: String)
    UnknownEntity(id: String)
    UnknownComponent(id: String)
    UnknownProperty(id: String)
    InvalidSelectionHierarchy
    NoSelection
    NotEditable(field: String)
    InvalidEdit(reason: String)
    DuplicateEditTarget
    StaleRevision(expected: String, actual: String)
    StaleSession(expected: String, actual: String)
    StaleTier(expected: String, actual: String)
    InvalidEvaluation(reason: String)
}
impl JetGameWorldInspectorError {
    pub fn show(self) -> String Never! {
        if self == {
            .EmptyText(field) -> "game world {field} must not be empty"
            .TextTooLong(field) -> "game world {field} exceeds the Prelude limit"
            .TooManyEntities -> "game world entity limit exceeded"
            .TooManyComponents(id) -> "component limit exceeded for entity `{id}`"
            .TooManyProperties(id) -> "property limit exceeded for component `{id}`"
            .TooManyFrames -> "game world frame limit exceeded"
            .DuplicateId(id) -> "duplicate game world id `{id}`"
            .DuplicateProperty(id, field) -> "duplicate property `{field}` on component `{id}`"
            .MissingParent(child, parent) -> "game world parent `{parent}` for `{child}` is missing"
            .Cycle(id) -> "game world cycle at `{id}`"
            .InvalidSourceSpan -> "invalid game world source span"
            .NoWorld -> "game world inspector has no world"
            .MismatchedWorld(expected, actual) -> "game world selection names `{actual}`, current world is `{expected}`"
            .UnknownEntity(id) -> "unknown game world entity `{id}`"
            .UnknownComponent(id) -> "unknown game world component `{id}`"
            .UnknownProperty(id) -> "unknown game world property `{id}`"
            .InvalidSelectionHierarchy -> "game world selection does not name a valid hierarchy"
            .NoSelection -> "game world inspector has no selection"
            .NotEditable(field) -> "game world property `{field}` is not authored-editable"
            .InvalidEdit(reason) -> "invalid game world edit: {reason}"
            .DuplicateEditTarget -> "duplicate game world edit target"
            .StaleRevision(expected, actual) -> "stale game world revision `{actual}`, current revision is `{expected}`"
            .StaleSession(expected, actual) -> "stale game world session `{actual}`, current session is `{expected}`"
            .StaleTier(expected, actual) -> "stale game world tier `{actual}`, current tier is `{expected}`"
            .InvalidEvaluation(reason) -> "invalid paused game evaluation: {reason}"
        }
    }
}
