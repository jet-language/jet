pub JET_GAME_WORLD_MAX_COMPONENTS_PER_ENTITY :: 256
pub JET_GAME_WORLD_MAX_PROPERTIES_PER_COMPONENT :: 256
pub JET_GAME_WORLD_MAX_FRAME_FACTS :: 256
pub JET_GAME_WORLD_MAX_TEXT_BYTES :: 16384
pub JET_GAME_PAUSED_EVAL_OK :: "ok"
pub JET_GAME_PAUSED_EVAL_STALE :: "stale"
pub JET_GAME_PAUSED_EVAL_RUNNING :: "running_frame_rejected"
pub JET_GAME_PAUSED_EVAL_UNAUTHORIZED :: "authority_rejected"
pub JET_GAME_PAUSED_EVAL_INVALID :: "invalid_request"
pub JET_GAME_PAUSED_EVAL_UNSUPPORTED :: "unsupported_expression"
