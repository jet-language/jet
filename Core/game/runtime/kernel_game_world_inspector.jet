// Rust :507-582. Sorting indices detects duplicate composite targets without
// inventing composite map keys (#4499) or the Rust quadratic suffix scan.
#Equatable
pub struct JetGameWorldFieldPatch { pub field: String, pub value: String }
impl JetGameWorldFieldPatch {
    pub fn new(field: ^String, value: ^String) -> JetGameWorldFieldPatch JetGameWorldInspectorError! {
        jet_game_world_validate_text(field, "edit field") ?? return Err(err)
        jet_game_world_validate_text(value, "edit value") ?? return Err(err)
        JetGameWorldFieldPatch{field: ^field, value: ^value}
    }
}
#Equatable
pub struct JetGameWorldEditRequest { pub targets: [JetGameWorldEditTarget], pub field_patch: JetGameWorldFieldPatch }
impl JetGameWorldEditRequest {
    pub fn new(targets: ^[JetGameWorldEditTarget], field: ^String, value: ^String) -> JetGameWorldEditRequest JetGameWorldInspectorError! {
        sorted := ^targets
        &sorted.sort_by((a: JetGameWorldEditTarget, b: JetGameWorldEditTarget) -> jet_game_world_edit_target_cmp(a, b))
        patch :: JetGameWorldFieldPatch.new(^field, ^value) ?? return Err(err)
        request :: JetGameWorldEditRequest{targets: ^sorted, field_patch: patch}
        request.validate() ?? return Err(err)
        request
    }
    pub fn validate(self) JetGameWorldInspectorError! {
        if self.targets.is_empty() -> return Err(JetGameWorldInspectorError.InvalidEdit("targets must not be empty"))
        jet_game_world_validate_text(self.field_patch.field, "edit field") ?? return Err(err)
        jet_game_world_validate_text(self.field_patch.value, "edit value") ?? return Err(err)
        order := world_indices(self.targets.len())
        &order.sort_by((a: Int, b: Int) -> {
            comparison :: jet_game_world_edit_target_cmp(self.targets[a], self.targets[b])
            if comparison != Ordering.Equal -> return comparison
            a <=> b
        })
        duplicate := [Bool]{}
        loop _ in self.targets -> &duplicate.push(false)
        loop i in 1..<order.len() {
            if self.targets[order[i - 1]] == self.targets[order[i]] -> duplicate[order[i - 1]] = true
        }
        loop i in 0..<self.targets.len() {
            jet_game_world_validate_edit_target(self.targets[i]) ?? return Err(err)
            if duplicate[i] -> return Err(JetGameWorldInspectorError.DuplicateEditTarget)
        }
    }
    pub fn render_json(self) -> String Never! {
        rows := [String]{}
        loop target in self.targets -> &rows.push(jet_game_world_edit_target_json(target))
        patch :: jet_game_world_field_patch_json(self.field_patch)
        "{{\"targets\":[{rows.join(",")}],\"field_patch\":{patch}}}"
    }
}
