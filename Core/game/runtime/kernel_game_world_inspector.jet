// Rust :182-228.
#Equatable
pub struct JetGameWorldComponentFact {
    pub component_id: String
    pub type_name: String
    pub authored_instance_id: String
    pub properties: [JetGameWorldPropertyFact]
}
impl JetGameWorldComponentFact {
    pub fn new(component_id: ^String, type_name: ^String, authored_instance_id: ^String, properties: ^[JetGameWorldPropertyFact]) -> JetGameWorldComponentFact JetGameWorldInspectorError! {
        fact :: JetGameWorldComponentFact{component_id: ^component_id, type_name: ^type_name, authored_instance_id: ^authored_instance_id, properties: ^properties}
        fact.validate() ?? return Err(err)
        fact
    }
    fn validate(self) JetGameWorldInspectorError! {
        jet_game_world_validate_text(self.component_id, "component id") ?? return Err(err)
        jet_game_world_validate_text(self.type_name, "component type") ?? return Err(err)
        jet_game_world_validate_text(self.authored_instance_id, "authored instance id") ?? return Err(err)
        if self.properties.len() > JET_GAME_WORLD_MAX_PROPERTIES_PER_COMPONENT -> return Err(JetGameWorldInspectorError.TooManyProperties(~self.component_id))
        fields := [String: Bool]{}
        loop property in self.properties {
            property.validate() ?? return Err(err)
            if fields.has_key(property.field) -> return Err(JetGameWorldInspectorError.DuplicateProperty(~self.component_id, ~property.field))
            fields[~property.field] = true
        }
    }
}
