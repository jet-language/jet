// Rust :279-372. Maps retain entity indices, not cloned nested facts.
#Equatable
pub struct JetGameWorldFact {
    pub world_id: String
    pub frame_id: U64
    pub source_id: String
    pub revision: String
    pub entities: [JetGameWorldEntityFact]
}
impl JetGameWorldFact {
    pub fn new(world_id: ^String, frame_id: U64, source_id: ^String, revision: ^String, entities: ^[JetGameWorldEntityFact]) -> JetGameWorldFact JetGameWorldInspectorError! {
        fact :: JetGameWorldFact{world_id: ^world_id, frame_id, source_id: ^source_id, revision: ^revision, entities: ^entities}
        fact.validate() ?? return Err(err)
        fact
    }
    pub fn validate(self) JetGameWorldInspectorError! {
        jet_game_world_validate_text(self.world_id, "world id") ?? return Err(err)
        jet_game_world_validate_text(self.source_id, "source id") ?? return Err(err)
        jet_game_world_validate_text(self.revision, "revision") ?? return Err(err)
        if self.entities.len() > JET_GAME_WORLD_MAX_ENTITIES -> return Err(JetGameWorldInspectorError.TooManyEntities)
        ids := [String: Bool]{}
        parents := [String: Int]{}
        colors := [Int]{}
        loop i in 0..<self.entities.len() {
            self.entities[i].validate() ?? return Err(err)
            id :: self.entities[i].entity_id
            if ids.has_key(id) -> return Err(JetGameWorldInspectorError.DuplicateId(~id))
            ids[~id] = true
            parents[~id] = i
            &colors.push(0)
            loop component in self.entities[i].components {
                if ids.has_key(component.component_id) -> return Err(JetGameWorldInspectorError.DuplicateId(~component.component_id))
                ids[~component.component_id] = true
            }
        }
        // Memoized forest walk: each edge visited at most twice. Original entity order,
        // first repeated ID and originating child in MissingParent are retained.
        loop root in 0..<self.entities.len() {
            cursor := root
            loop true {
                if colors[cursor] == 2 -> break
                if colors[cursor] == 1 -> return Err(JetGameWorldInspectorError.Cycle(~self.entities[cursor].entity_id))
                colors[cursor] = 1
                if self.entities[cursor].parent_id == .Val(parent) {
                    if !parents.has_key(parent) -> return Err(JetGameWorldInspectorError.MissingParent(~self.entities[root].entity_id, ~parent))
                    cursor = parents[parent]
                } else -> break
            }
            cursor = root
            loop colors[cursor] != 2 {
                colors[cursor] = 2
                if self.entities[cursor].parent_id == .Val(parent) -> cursor = parents[parent]
                else -> break
            }
        }
    }
    pub fn render_json(self) -> String Never! {
        order := world_indices(self.entities.len())
        &order.sort_by((a: Int, b: Int) -> self.entities[a].entity_id <=> self.entities[b].entity_id)
        rows := [String]{}
        loop index in order -> &rows.push(jet_game_world_entity_json(self.entities[index]))
        id :: jet_game_world_json_string(self.world_id)
        source :: jet_game_world_json_string(self.source_id)
        revision :: jet_game_world_json_string(self.revision)
        "{{\"world_id\":{id},\"frame_id\":{self.frame_id},\"source_id\":{source},\"revision\":{revision},\"entities\":[{rows.join(",")}]}}"
    }
}
