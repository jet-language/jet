// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Game.rs:380
fn jet_game_scene_query(scene: &GameScene, names: &String) -> [String] {
    // GATE #4565: kernel primitive
    #Unsafe("read the headless synthetic component row from the canonical native scene state") {
        state :: scene.assets.state.borrow()
        wanted :: names.split(",").filter(fn(s) { !s.is_empty() }).collect()
        if wanted.iter().all(fn(name) { state.components.iter().any(fn(c) { c == name }) }) {
            row :: wanted.iter().map(fn(name) {
                match *name { "Position" -> "Position{x:0}", "Velocity" -> "Velocity{dx:0}", other -> "{other}{{}}" }
            }).collect().join(",")
            [^row]
        } else { [] }
    }
}
