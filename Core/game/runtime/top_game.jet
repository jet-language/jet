fn jet_game_identity_from_env(key: String, fallback: String) -> String {
    // GATE #4565: kernel primitive
    #Unsafe("read the host-supplied development identity from the native environment") {
        env.var(key).ok().filter(fn(value) { !value.trim().is_empty() }).unwrap_or_else(fn() { fallback.to_string() })
