#Derive(Debug)
struct GameState {
    assets: [(String, String)]
    bindings: [(String, String)]
    components: [String]
    // Asset bytes and handles are host-supplied checked facts; never read paths.
    asset_bytes: U64
    asset_roots: JetGameAssetRootSet
    asset_handles: [String:GameAssetRuntimeHandle]
    dev_session: GameDevSession?
}
impl GameState {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Game.rs:23
    fn new(scene_name: String) -> GameState {
        root :: JetGameAssetRootIdentity.new("game", ".").expect("the built-in game asset root is valid")
        asset_roots :: JetGameAssetRootSet.new([^root]).expect("the built-in game asset root is unique")
        dev_session :: if JET_GAME_DEBUG_DATA_ENABLED {
            fallback_source :: if scene_name.is_empty() { "game" } else { scene_name }
            session :: jet_game_identity_from_env("JET_DEVTOOLS_RELAY_SESSION_ID", "game:{scene_name}")
            source :: jet_game_identity_from_env("JET_DEVTOOLS_RELAY_SOURCE_ID", fallback_source)
            build :: jet_game_identity_from_env("JET_DEVTOOLS_RELAY_BUILD_ID", "runtime")
            revision :: jet_game_identity_from_env("JET_DEVTOOLS_RELAY_REVISION", "runtime")
            identity :: GameDevRunIdentity.new(^session, ^source, ^build, ^revision)
            dev_session := GameDevSession.new_with_policy(^identity, 0, GameDevPolicy.new(JET_GAME_DEBUG_DATA_ENABLED))
                .expect("the built-in game dev session is valid")
            jet_game_install_devtools_callback()
            dev_session.register_gameplay_debugger(0, "dev").expect("the built-in gameplay debugger extension is valid")
            dev_session.configure_asset_roots(asset_roots.clone()).expect("the built-in game asset roots are valid")
            Some(^dev_session)
        } else { None }
        GameState{assets: [], bindings: [], components: [], asset_bytes: 0, asset_roots: ^asset_roots,
            asset_handles: [String:GameAssetRuntimeHandle]{}, dev_session: ^dev_session}
    }
}
