// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Game.rs:510
fn read_vmhwm_bytes() -> U64 {
    // GATE #4565: kernel primitive
    text :: match #Unsafe("read Linux peak RSS from procfs; native errors preserve the reference unavailable value") { fs.read_to_string(OSPath("/proc/self/status")) } {
        Ok(text) -> ^text
        Err(_) -> return 0
    }
    loop line in text.lines() {
        if Val(rest) :: line.strip_prefix("VmHWM:") {
            if Val(kib) :: rest.split_whitespace().next().and_then(fn(v) { v.parse<U64>().ok() }) -> return kib.saturating_mul(1024)
        }
    }
    0
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Game.rs:526
fn jet_game_replay_input(replay: &GameReplay?, frame_idx: I64, _bindings: &[(String, String)], replay_cursor: &I64) -> [String] {
    *replay_cursor = (*replay_cursor).saturating_add(1)
    replay.and_then(fn(replay) { replay.tape.actions_at(frame_idx) }).map(fn(actions) { actions.to_list() }).unwrap_or_default()
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Game.rs:542
// Foundation owns ordinary and probe iteration; this adapter projects its facts.
fn jet_game_run(scene: &GameScene, replay: &GameReplay?, backend: &GameBackend?, frames: &I64?) -> String {
    if Val(frames) :: frames -> JetGameFrameBudget.validate(*frames).unwrap_or_else(fn(error) { panic("{error}") })
    backend := backend.cloned().unwrap_or_else(jet_game_backend_headless)
    backend.frame_budget.set_requested(frames.copied()).unwrap_or_else(fn(error) { panic("{error}") })
    replay_path :: replay.map(fn(r) { r.path.clone() }).unwrap_or_else(fn() { "<none>" })
    // GATE #4565: kernel primitive
    #Unsafe("native scene state borrows, monotonic sampling, pause sleeps and stdout form the audited headless host boundary") {
        probe_name :: env.var("JET_SCENE_PROBE").ok()
        measuring :: probe_name.as_deref() == Some(scene.name.as_str())
        asset_bytes :: scene.assets.state.borrow().asset_bytes
        warmup_frames: I64 :: 120
        measure_frames: I64 :: 600
        total_frames :: warmup_frames + measure_frames
        frame_plan := if measuring {
            JetGameFrameBudget.with_frame_count(total_frames).expect("the measured game frame plan must be positive")
        } else { backend.frame_budget.clone() }
        out := [String]{}
        if !measuring {
            out.push("scene:{scene.name}")
            out.push("backend:{backend.renderer}/{backend.audio}/{backend.editor}")
            out.push("replay:{replay_path}")
            {
                state :: scene.assets.state.borrow()
                assets :: state.assets.iter().map(fn((kind, path)) { "{kind}:{path}" }).collect().join(",")
                out.push("assets:{if assets.is_empty() { "none" } else { assets }}")
                bindings :: state.bindings.iter().map(fn((action, key)) { "{action}={key}" }).collect().join(",")
                out.push("input:{if bindings.is_empty() { "none" } else { bindings }}")
                components :: state.components.join(",")
                out.push("components:{if components.is_empty() { "none" } else { components }}")
            }
        }
        // Hex encoding avoids tab/newline ambiguity in the probe wire protocol.
        scene_hex: String :: scene.name.bytes().map(fn(b) { "{b:02x}" }).collect()
        if measuring {
            println("JETSCENEID\t{scene_hex}\tbackend={backend.renderer}/{backend.audio}/{backend.editor}\treplay={replay_path}\tdevice=headless\tviewport=default\tsettings=default\twarmup={warmup_frames}\tmeasured={measure_frames}\tready=frame0")
        }
        if JET_GAME_DEBUG_DATA_ENABLED {
            state := scene.assets.state.borrow_mut()
            dev_session :: state.dev_session.as_mut().expect("development game session must exist when debug data is enabled")
            identity :: dev_session.profiler.identity().clone()
            dev_session.set_trace_context(JetGameTraceContext.new(^identity.session, scene.name.clone(), "runtime",
                "{backend.renderer}/{backend.audio}/{backend.editor}", 1, 1, "default"))
                .expect("the game trace context must satisfy the profiler identity")
            dev_session.dispatch_pending_devtools_controls(0).expect("game devtools command ingress must be valid")
            if dev_session.phase == GameDevPhase.Editing {
                dev_session.dispatch_control(0, GameDevControl.Play).expect("the game devtools session must enter Play")
            }
        }
        // Preserve the reference frame_idx independently of the issued plan index.
        frame_idx: I64 := 0
        replay_cursor: I64 := 0
        transcript := JetGameTranscriptHasher.new()
        loop {
            index :: match frame_plan.next_frame() { Some(index) -> index, None -> break }
            loop {
                admitted :: if JET_GAME_DEBUG_DATA_ENABLED {
                    state := scene.assets.state.borrow_mut()
                    dev_session :: state.dev_session.as_mut().expect("development game session must exist when debug data is enabled")
                    dev_session.dispatch_pending_devtools_controls(frame_idx as U64).expect("game devtools command ingress must be valid")
                    dev_session.begin_simulation_frame()
                } else { true }
                if admitted -> break
                // Keep the frame in flight until Resume or one-shot FrameAdvance.
                thread.sleep(Duration.from_millis(1))
            }
            pressed :: {
                state :: scene.assets.state.borrow()
                jet_game_replay_input(replay, frame_idx, &state.bindings, &replay_cursor)
            }
            transcript.push_frame(frame_idx, &pressed)
            frame :: GameFrame{index: frame_idx, user_index: frame_idx,
                input: GameInputSnapshot{pressed: pressed.clone()}, user_input: GameInputSnapshot{pressed: pressed.clone()}}
            callbacks_count :: scene.callbacks.borrow().len() as U64
            t0 :: Instant.now()
            // Serial registration order is source order, never a modeled parallel decision.
            if measuring {
                loop callback in scene.callbacks.borrow_mut().iter_mut() -> jet_game_execute_frame_callback(callback, frame.clone())
            } else {
                loop callback in scene.callbacks.borrow_mut().iter_mut() -> jet_game_execute_frame_callback(callback, frame.clone())
                input :: if pressed.is_empty() { "none" } else { pressed.join("+") }
                out.push("frame:{frame_idx} input:{input}")
            }
            elapsed_ns :: t0.elapsed().as_nanos() as U64
            rss :: read_vmhwm_bytes()
            if measuring && frame_idx >= warmup_frames {
                println("JETSCENE1\t{scene_hex}\tFrameTime\t{elapsed_ns}")
                println("JETSCENE1\t{scene_hex}\tDrawCalls\t{callbacks_count}")
                println("JETSCENE1\t{scene_hex}\tSceneAssetBytes\t{asset_bytes}")
                println("JETSCENE1\t{scene_hex}\tMemoryHighWater\t{rss}")
            }
            if JET_GAME_DEBUG_DATA_ENABLED {
                identity :: {
                    state :: scene.assets.state.borrow()
                    state.dev_session.as_ref().expect("development game session must exist when debug data is enabled")
                        .profiler.identity().clone()
                }
                frame_identity :: JetGameFrameIdentity.new(&scene.name, frame_idx as U64, ^identity.build, ^identity.revision, ^identity.source)
                sample :: JetGameFrameSample.new(^frame_identity, frame_idx as U64, elapsed_ns, None)
                state := scene.assets.state.borrow_mut()
                dev_session :: state.dev_session.as_mut().expect("development game session must exist when debug data is enabled")
                if dev_session.profiler.profiler().state() == JetGameFrameProfilerState.Running {
                    dev_session.record_and_publish(sample.into()).expect("the game frame producer must satisfy the profiler identity")
                    sample_time_ns :: frame_idx as U64
                    event_time_ms :: frame_idx as U64
                    dev_session.publish_overlay_metric(event_time_ms,
                        JetGameOverlayMetricValue.new(JetGameOverlayMetric.FrameTime, elapsed_ns.min(I64.MAX as U64) as I64, sample_time_ns))
                        .expect("the game frame metric must publish")
                    dev_session.publish_overlay_metric(event_time_ms,
                        JetGameOverlayMetricValue.new(JetGameOverlayMetric.DrawCalls, callbacks_count.min(I64.MAX as U64) as I64, sample_time_ns))
                        .expect("the draw-call metric must publish")
                    if asset_bytes != 0 {
                        dev_session.publish_overlay_metric(event_time_ms,
                            JetGameOverlayMetricValue.new(JetGameOverlayMetric.SceneAssetBytes, asset_bytes.min(I64.MAX as U64) as I64, sample_time_ns))
                            .expect("the scene asset metric must publish")
                    }
                    if rss != 0 {
                        dev_session.publish_overlay_metric(event_time_ms,
                            JetGameOverlayMetricValue.new(JetGameOverlayMetric.MemoryHighWater, rss.min(I64.MAX as U64) as I64, sample_time_ns))
                            .expect("the memory metric must publish")
                    }
                }
            }
            if JET_GAME_DEBUG_DATA_ENABLED {
                state := scene.assets.state.borrow_mut()
                state.dev_session.as_mut().expect("development game session must exist when debug data is enabled")
                    .finish_simulation_frame(frame_idx as U64, frame_idx as U64).expect("the game frame must satisfy the devtools phase")
            }
            frame_plan.present()
        }
        if JET_GAME_DEBUG_DATA_ENABLED {
            state := scene.assets.state.borrow_mut()
            state.dev_session.as_mut().expect("development game session must exist when debug data is enabled")
                .stop(frame_idx as U64, "game run completed").expect("the game run must publish its stopped lifecycle")
        }
        if !measuring && frames.is_some() -> out.push("transcript_hash:{transcript.finish()}")
        out.join("\n")
    }
}

