// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Game.rs:303
fn jet_game_scene_on_frame(scene: &GameScene, f: Box<fn(GameFrame) -> ()>, schedule_json: String?, derivation_id: String?) -> {
    schedule :: schedule_json.map(fn(payload) {
        JetFrameSchedule.from_canonical_json(payload).unwrap_or_else(fn(error) { panic("invalid checked game frame schedule: {error}") })
    })
    if schedule.is_some() && derivation_id.is_none() -> panic("checked game frame schedule has no canonical derivation")
    // GATE #4565: kernel primitive
    #Unsafe("register a mutable frame callback and native shared completion state under exclusive RefCell borrow") {
        callbacks := scene.callbacks.borrow_mut()
        if callbacks.len() >= MAX_GAME_SCENE_CALLBACKS -> panic("game scene callback limit exceeded")
        callbacks.push(GameFrameCallback{
            completion: schedule.as_ref().map(fn(schedule) { Arc.new(Mutex.new(JetFrameCompletionState.new(schedule))) }),
            callback: ^f, schedule: ^schedule, derivation: derivation_id.map(fn(value) { value.to_string() })})
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Game.rs:332
fn jet_game_execute_frame_callback(callback: &GameFrameCallback, frame: GameFrame) -> {
    if Val(schedule) :: &callback.schedule {
        if schedule.operations.windows(2).any(fn(window) { window[0].source_index > window[1].source_index }) {
            panic("checked game frame schedule is not in source order")
        }
        if callback.derivation.is_none() -> panic("checked game frame schedule has no canonical derivation")
    }
    completion :: callback.completion.clone()
    if Val(completion) :: completion {
        with_frame_completion_scope(^completion, fn() { callback.callback(^frame) })
    } else { callback.callback(^frame) }
    if Val(schedule) :: &callback.schedule {
        // GATE #4565: kernel primitive
        #Unsafe("check reuse readiness under the native completion mutex after callback execution") {
            completion :: callback.completion.as_ref().expect("checked game frame schedule has no completion state")
                .lock().unwrap_or_else(PoisonError.into_inner)
            completion.assert_reuse_ready(schedule).unwrap_or_else(fn(error) { panic("checked game frame reuse before completion: {error}") })
        }
    }
}
