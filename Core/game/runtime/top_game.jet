// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Game.rs:444
// Only a committed importer-checked runtime fact becomes visible to asset handles.
fn jet_game_assets_reload(assets: &GameAssets, timestamp_ms: U64, plan: JetGameAssetImportPlan, outcome: JetGameAssetImportOutcome, fact: JetGameAssetRuntimeFact) -> JetGameAssetTransactionReceipt Err! {
    if !JET_GAME_DEBUG_DATA_ENABLED -> return Err("game asset reload is unavailable outside a development profile")
    asset_key :: fact.artifact.source.node().key()
    byte_len :: fact.byte_len()
    // GATE #4565: kernel primitive
    #Unsafe("validate the reload transaction before replacing shared native asset bytes and scene accounting") {
        receipt :: {
            state := assets.state.borrow_mut()
            dev_session :: state.dev_session.as_mut().ok_or_else(fn() { "game development data is disabled for this profile" })?
            dev_session.reload_asset_with_fact(timestamp_ms, ^plan, ^outcome, &fact)?
        }
        if !receipt.is_committed() || !receipt.entries.iter().any(fn(entry) {
            match entry.status { .Applied -> true, .Unchanged -> true, _ -> false }
        }) -> return Ok(^receipt)
        payload :: GameAssetRuntimePayload{artifact: ^fact.artifact, bytes: Arc.from(^fact.bytes), metadata: ^fact.metadata}
        state := assets.state.borrow_mut()
        previous_len :: if Val(existing) :: state.asset_handles.get(&asset_key) { existing.replace(^payload) }
        else { state.asset_handles.insert(^asset_key, GameAssetRuntimeHandle.new(^payload)); 0 }
        state.asset_bytes = state.asset_bytes.saturating_sub(previous_len).saturating_add(byte_len)
        Ok(^receipt)
    }
}
