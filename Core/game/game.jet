package {
    name: "core.game"
    version: "0.1.0"
    edition: "2026"
    description: "Backend-neutral game scene, replay, and frame loop."
    license: "MIT"
    outputs: {
        game: .Library{ entry: game }
    }
}
use core as core

// core.game — canonical scene/replay/backend handles.
//
// The runtime owns frame scheduling, input snapshots, and presentation.
// Source constructors remain useful in the portable model and never invent
// a successful frame when a provider is unavailable.
module raylib

pub struct Scene {
    pub name: String
    pub max_frames: Int
    pub tick: Int
}

pub struct ReplayFrame {
    pub tick: Int
    pub keys: [String]
}

pub struct Replay {
    pub path: String
    pub frames: [ReplayFrame]
}

pub struct Backend {
    pub name: String
    pub running: Bool
}

pub fn scene(name: String) -> Scene {
    Scene{name: name, max_frames: 0, tick: 0}
}

pub fn backend_null() -> Backend {
    Backend{name: "headless", running: true}
}

pub fn backend_raylib() -> Backend {
    Backend{name: "raylib", running: true}
}

impl Scene {
    pub fn new(name: String) -> Scene { scene(name) }
}

impl Replay {
    pub fn record(path: String) -> Replay { Replay{path: path, frames: [ReplayFrame]{}} }
}

impl Backend {
    pub fn headless() -> Backend { backend_null() }
}
