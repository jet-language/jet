package {
    name: "core.game"
    version: "0.1.0"
    edition: "2026"
    description: "Backend-neutral game scene, replay, and frame loop."
    license: "MIT"
    outputs: {
        game: .Library{ entry: game }
    }
}

// core.game — canonical scene/replay/backend handles.
//
// The runtime owns frame scheduling, input snapshots, and presentation.
// Source constructors remain useful in the portable model and never invent
// a successful frame when a provider is unavailable.
module raylib

pub struct Scene {
    pub name: String
    pub max_frames: Int
    pub tick: Int
}

pub struct Replay {
    pub path: String
}

pub struct Backend {
    pub name: String
    pub running: Bool
}

impl Scene {
    pub fn new(name: String) -> Scene {
        Scene{name: name, max_frames: 0, tick: 0}
    }
}

impl Replay {
    pub fn record(path: String) -> Replay { Replay{path: path} }
}

impl Backend {
    pub fn headless() -> Backend {
        Backend{name: "headless", running: true}
    }
}
