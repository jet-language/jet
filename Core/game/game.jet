package {
    name: "core.game"
    version: "0.0.1"
    edition: "2026"
    description: "Backend-neutral game scene, replay, and frame loop."
    license: "MIT"
    outputs: {
        game: .Library{ entry: game }
    }
}

// core.game — canonical scene/replay/backend handles.
//
// The runtime owns frame scheduling, input snapshots, and presentation.
// Scene, Replay, and Backend are opaque compiler-owned handles. Their
// registered constructors retain scene assets, input, replay, and scheduling
// state; a plain source record cannot represent those runtime identities.
module raylib

