use core as core

// core.game.raylib — display-gated raylib bridge (D-RAYLIB1=A).
//
// This module owns no host fallback.  Window, input, drawing, texture, and
// audio state are provider-owned; unavailable display/audio capabilities are
// reported by the provider's typed result rather than fabricated locally.
pub struct RaylibWindow {
    pub width: Int
    pub height: Int
    pub title: String
    pub open: Bool
    pub drawing: Bool
    pub should_close: Bool
    pub fps: Int
    pub commands: [String]
}

pub struct RaylibColor {
    pub r: Int
    pub g: Int
    pub b: Int
    pub a: Int
}

pub struct RaylibTextureAtlas {
    pub path: String
}

pub struct RaylibSound {
    pub path: String
}

pub fn color(r: Int, g: Int, b: Int, a: Int) -> RaylibColor {
    RaylibColor{r: clamp8(r), g: clamp8(g), b: clamp8(b), a: clamp8(a)}
}

pub fn window_open(width: Int, height: Int, title: String) -> RaylibWindow {
    w := clamp_dimension(width)
    h := clamp_dimension(height)
    core.game.raylib.window_open(w, h, title)
}

pub fn window_should_close(window: RaylibWindow) -> Bool {
    core.game.raylib.window_should_close(window)
}

pub fn window_ready(window: RaylibWindow) -> Bool {
    core.game.raylib.window_ready(window)
}

pub fn close_window(window: RaylibWindow) {
    core.game.raylib.close_window(window)
}

pub fn begin_drawing(window: RaylibWindow) {
    core.game.raylib.begin_drawing(window)
}

pub fn end_drawing() {
    core.game.raylib.end_drawing()
}

pub fn clear_background(color: RaylibColor) {
    core.game.raylib.clear_background(color)
}

pub fn draw_rectangle(x: Int, y: Int, width: Int, height: Int, color: RaylibColor) {
    core.game.raylib.draw_rectangle(x, y, width, height, color)
}

pub fn draw_text(text: String, x: Int, y: Int, size: Int, color: RaylibColor) {
    core.game.raylib.draw_text(text, x, y, size, color)
}

pub fn draw_sprite(atlas: RaylibTextureAtlas, source: String, x: Int, y: Int) {
    core.game.raylib.draw_sprite(atlas, source, x, y)
}

pub fn set_target_fps(fps: Int) {
    core.game.raylib.set_target_fps(fps)
}

pub fn key_down(key: String) -> Bool {
    core.game.raylib.key_down(key)
}

pub fn gamepad_down(gamepad: Int, button: String) -> Bool {
    core.game.raylib.gamepad_down(gamepad, button)
}

pub fn gamepad_axis(gamepad: Int, axis: String) -> Float {
    core.game.raylib.gamepad_axis(gamepad, axis)
}

pub fn load_texture_atlas(path: String) -[FS, GPU]> RaylibTextureAtlas {
    core.game.raylib.load_texture_atlas(path)
}

pub fn load_sound(path: String) -[FS, GPU]> RaylibSound {
    core.game.raylib.load_sound(path)
}

pub fn play_sound(sound: RaylibSound) -> Bool {
    core.game.raylib.play_sound(sound)
}

fn clamp8(value: Int) -> Int {
    if value < 0 -> return 0
    if value > 255 -> return 255
    value
}

fn clamp_dimension(value: Int) -> Int {
    if value < 1 -> return 1
    if value > 2147483647 -> return 2147483647
    value
}
