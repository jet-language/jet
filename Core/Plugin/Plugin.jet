package: {
    name: "core.plugin"
    version: "0.0.1"
    edition: "2026"
    description: "Load and call a sandboxed WASM Component."
    license: "MIT"
    outputs: {
        plugin: .Library{ entry: plugin }
    }
}

use {
    builtin: jet_builtins
    core: core
}

// core.plugin — the intrinsic WASM Component boundary.
//
// The compiler still requires a literal artifact and attaches its frozen
// Component interface, then projects tightened authority to its canonical
// wire at that same boundary. The compiler lowers a `load` call as the
// native `jet_plugin_load` route, which decodes the host's load wire into the
// typed handle; `load`'s body is what a compiler that does not lower it runs.
// Every export call fails with a `PluginError`; each case carries a
// `PluginFault { export, message, frames }` whose frames are
// `PluginFrame { function, component, offset }`.

// Loads the WebAssembly Component at `path` under `authority`, which must
// hold FS.Read and bounds the host imports the guest reaches, and `limits`.
// A literal `path`, from the package root, embeds the artifact and gives the
// handle its Component's interface: its exports are its methods. A path known
// only at run time names no embedded artifact, so its calls fail as `Guest`.
#Builtin.Role(.InlinePluginLoad) load: fn(path: String, authority: Authority, /, *, limits: Limits{Limits{}}) -[Exec]> Plugin {
    core.plugin.load(path, authority, limits: limits)
}

// The budgets one loaded component runs under, `load`'s `limits:` label; a
// load without it takes these defaults. Fuel and the timeout refill before
// each export call; memory and table elements cap the component for its
// whole life. A field of zero or less, or memory above the 4 GiB a 32-bit
// memory addresses, fails the load as `Guest` before the artifact is read.
// Running past a limit stops the call with `Budget` naming it.
Limits: struct {
    fuel: Int{10_000_000},
    memory_bytes: Int{16_777_216},
    table_elements: Int{10_000},
    timeout: Duration{1s},
}

// One frame of a plugin trap trace.
PluginFrame: struct {
    function: String,
    component: String,
    offset: Int,
}

// Details carried by a PluginError: the export that failed, the message, and
// any guest trap frames.
PluginFault: struct {
    export: String,
    message: String,
    frames: [PluginFrame],
}

// The budget a plugin call ran out of, the `limit` of `PluginError.Budget`.
// The runtime builds it by its position (jet.runtime.plugin).
PluginLimit: enum {
    Fuel,
    Memory,
    Table,
    Time,
    Wire,
}

// How a plugin load or call failed: the guest trapped or its artifact was
// refused (`Guest`), the authority refused a host import (`Denied`), a budget
// ran out (`Budget`), or the host hit an internal defect (`Defect`). The
// runtime builds it by its position (jet.runtime.plugin).
#Error
PluginError: enum {
    Guest(PluginFault),
    Denied(PluginFault),
    Budget(limit: PluginLimit, fault: PluginFault),
    Defect(PluginFault),
}
