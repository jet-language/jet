package {
    name: "core.event"
    version: "0.0.1"
    edition: "2026"
    description: "Typed events, hooks, and scheduler-backed dispatch."
    license: "MIT"
    outputs: {
        event: .Library{ entry: event }
    }
}

use core as core

// D-EVENT1 / D-EVENT2=A / D-EVENT-CONTINUE1=C:
// the public event family is compiler-known and its runtime state belongs to
// the provider. This module keeps the library spelling stable while forwarding
// typed constructors; it must not manufacture a second string-backed event
// model or turn an unavailable provider result into a successful value.

fn scope() -> EventScope Never! {
    core.event.scope()
}

fn new<T>() -> Event<T> Never! {
    core.event.new<T>()
}

fn with_policy<T>(policy: EventPolicy) -> Event<T> Never! {
    core.event.with_policy<T>(policy)
}

fn hook<T, R>(fallback: R) -> Hook<T, R> Never! {
    core.event.hook<T, R>(fallback)
}

fn decision_hook<T, E>(policy: HookPolicy) -> DecisionHook<T, E> Never! {
    core.event.decision_hook<T, E>(policy)
}

fn policy_sync() -> EventPolicy Never! {
    core.event.policy_sync()
}

fn async_result<T, E>(policy: AsyncPolicy, failures: FailurePolicy) -> AsyncEvent<T, E> EventConfigError! {
    core.event.async_result<T, E>(policy, failures)
}
