fn jet_url_normalize_typed_path(parts: [(String, Bool)]) -> [(String, Bool)] {
    absolute :: parts.first().is_some_and((part, hole) -> !hole && part.starts_with('/'))
    trailing :: parts.last().is_some_and((part, hole) -> !hole && part.ends_with('/'))
    segments := [[(String, Bool)]]{[]}
    loop (part, hole) in ^parts {
        if hole {
            if Val(current) = &segments.last_mut() -> &current.push((part, true))
            continue
        }
        loop (index, piece) in part.split('/').enumerate() {
            if index > 0 -> &segments.push([])
            if !piece.is_empty() {
                if Val(current) = &segments.last_mut() -> &current.push((piece.to_string(), false))
            }
        }
    }
    normalized := [[(String, Bool)]]{}
    loop segment in ^segments {
        if segment.is_empty() -> continue
        has_hole :: segment.iter().any((_, hole) -> hole)
        value :: segment.iter().map((part, _) -> part.as_str()).collect<String>()
        if !has_hole && value == "." -> continue
        if !has_hole && value == ".." {
            match normalized.last() {
                Val(previous) -> {
                    if !previous.iter().any((_, hole) -> hole) { _ :: &normalized.pop() }
                    else { &normalized.push(segment) }
                }
                None -> {}
            }
            continue
        }
        &normalized.push(segment)
    }
    out := [(String, Bool)]{}
    if absolute -> &out.push(("/", false))
    loop (index, segment) in normalized.into_iter().enumerate() {
        if index > 0 -> &out.push(("/", false))
        &out.extend(^segment)
    }
    if trailing && !out.last().is_some_and((part, _) -> part.ends_with('/')) -> &out.push(("/", false))
    out
}
