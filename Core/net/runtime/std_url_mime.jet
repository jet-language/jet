// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:1034
fn jet_punycode_encode(input: String) -> String Err! {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:1035
    const BASE: U32 = 36
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:1036
    const TMIN: U32 = 1
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:1037
    const TMAX: U32 = 26
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:1038
    const SKEW: U32 = 38
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:1039
    const DAMP: U32 = 700
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:1040
    const INITIAL_BIAS: U32 = 72
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:1041
    const INITIAL_N: U32 = 128
    codepoints :: input.chars().map(c -> c as U32).collect<[U32]>()
    out := ""
    loop cp in codepoints {
        if cp < 0x80 -> &out.push(Char.from_u32(cp).ok_or("bad codepoint")?)
    }
    basic :: out.chars().count() as U32
    handled := basic
    if basic > 0 && handled < codepoints.len() as U32 -> &out.push('-')
    n := INITIAL_N
    delta := U32{0}
    bias := INITIAL_BIAS
    loop handled < codepoints.len() as U32 {
        m :: codepoints.iter().filter(cp -> cp >= n).min().ok_or("bad punycode input")?
        delta = delta.checked_add((m - n).saturating_mul(handled + 1)).ok_or("punycode overflow")?
        n = m
        loop cp in codepoints {
            if cp < n {
                delta = delta.checked_add(1).ok_or("punycode overflow")?
            } else if cp == n {
                q := delta
                k := BASE
                loop {
                    t :: if k <= bias -> TMIN else if k >= bias + TMAX -> TMAX else -> k - bias
                    if q < t -> break
                    &out.push(jet_punycode_digit(t + ((q - t) % (BASE - t)))?)
                    q = (q - t) / (BASE - t)
                    k += BASE
                }
                &out.push(jet_punycode_digit(q)?)
                bias = jet_punycode_adapt(delta, handled + 1, handled == basic)
                delta = 0
                handled += 1
            }
        }
        delta = delta.checked_add(1).ok_or("punycode overflow")?
        n = n.checked_add(1).ok_or("punycode overflow")?
    }
    Ok(out)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:1100
fn jet_punycode_digit(d: U32) -> Char Err! {
    Char.from_u32(if d < 26 -> U32{97} + d else -> U32{48} + d - 26).ok_or("bad punycode digit")
