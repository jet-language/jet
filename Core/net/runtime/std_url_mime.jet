// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:1105
fn jet_punycode_adapt(delta_input: U32, points: U32, first: Bool) -> U32 {
    delta := if first -> delta_input / 700 else -> delta_input / 2
    delta += delta / points
    k := U32{0}
    loop delta > ((36 - 1) * 26) / 2 { delta /= 36 - 1; k += 36 }
    k + (((36 - 1 + 1) * delta) / (delta + 38))
}
