// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:657
fn jet_typed_url_marker_name(literals: [String]) -> String {
    nonce := 0
    loop {
        marker :: "jet-hole-opaque-{nonce}-"
        if !literals.iter().any(literal -> literal.contains(marker)) -> return marker
        nonce += 1
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:668
fn jet_typed_url_marker(literals: [String]) -> (String, JetURLParts) Err! {
    marker :: jet_typed_url_marker_name(literals)
    skeleton :: jet_typed_url_skeleton(literals, marker)
    url :: JetURLParts.parse_without_normalization_with_marker(skeleton, Val(marker))?
    Ok((marker, url))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:675
fn jet_url_typed_authority(rest: String) -> String? {
    authority :: rest.strip_prefix("//")?
    end :: authority.char_indices().find_map((index, ch) -> if ch == '/' || ch == '?' || ch == '#' -> Val(index) else -> None).unwrap_or(authority.len())
    Val(authority[..end])
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:684
fn jet_typed_url_skeleton(literals: [String], marker: String) -> String {
    skeleton := ""
    loop (index, literal) in literals.iter().enumerate() {
        &skeleton.push_str(literal)
        if index + 1 < literals.len() -> &skeleton.push_str(marker)
    }
    skeleton
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:695
fn jet_url_apply_typed_holes(value: String, marker: String, holes: [String], hole_index: &USize) -> (String, [(String, Bool)]?) Err! {
    parts := [(String, Bool)]{}
    cursor := 0
    loop {
        offset :: value[cursor..].find(marker)
        if offset.is_none() -> break
        start :: cursor + offset.unwrap()
        literal :: value[cursor..start]
        if !literal.is_empty() || parts.is_empty() -> &parts.push((literal.to_string(), false))
