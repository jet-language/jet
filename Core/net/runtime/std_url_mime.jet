pub fn jet_url_join_text(base: String, rel: String) -> String {
    if rel.is_empty() -> return base.to_string()
    if Val(colon) = rel.find(':') {
        before_slash :: rel.find('/').map_or(true, slash -> colon < slash)
        if before_slash && jet_url_valid_scheme(rel[..colon]) -> return rel.to_string()
    }
    parsed :: match JetURLParts.parse(base.to_string()) { Ok(value) -> value, Err(_) -> return rel.to_string() }
