}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:1140
pub fn jet_url_parse_qsl_rows(query: String) -> [[String]] {
    body :: query.strip_prefix('?').unwrap_or(query)
