// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:1243
pub fn jet_url_percent_encode(s: String, path: Bool) -> String {
    out := ""
    loop b in s.bytes() {
        keep :: b.is_ascii_alphanumeric() || [U8]{45, 46, 95, 126}.contains(b) || (path && b == U8{47})
