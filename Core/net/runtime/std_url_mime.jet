// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:410
pub fn jet_validate_typed_url_literal(literals: [String]) -> Unit Err! {
    if literals.is_empty() -> return Err("URL literal needs a quoted body")
    marker :: jet_typed_url_marker_name(literals)
    skeleton :: jet_typed_url_skeleton(literals, marker)
    if Val(colon) = skeleton.find(':') {
        scheme_raw :: skeleton[..colon]
        if scheme_raw.contains(marker) -> return Err("URL scheme cannot contain interpolation")
        if scheme_raw.eq_ignore_ascii_case("data") {
            data_body :: skeleton[colon + 1..].split(ch -> ch == '?' || ch == '#').next().unwrap_or_default()
            match data_body.find(',') {
                Val(comma) -> if data_body[..comma].contains(marker) -> return Err("data URL MIME metadata cannot contain interpolation")
                None -> if data_body.contains(marker) -> return Err("data URL payload needs a MIME separator")
            }
        }
        if Val(authority) = jet_url_typed_authority(skeleton[colon + 1..]) {
            host_port :: authority.rsplit_once('@').map_or(authority, (_, hp) -> hp)
            port_has_marker :: if Val(end) = host_port.find(']') -> {
                host_port.get(end + 1..).is_some_and(suffix -> suffix.starts_with(':') && suffix[1..].contains(marker))
            } else -> host_port.rsplit_once(':').is_some_and((_, port) -> port.contains(marker))
            if port_has_marker -> return Err("URL port cannot contain interpolation")
        }
    }
    JetURLParts.parse_without_normalization_with_marker(skeleton, Val(marker)).map(_ -> ())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:462
pub fn jet_typed_url_parts_literal(literals: [String], holes: [String]) -> JetURLParts {
    match jet_typed_url_literal_checked(literals, ^holes) {
        Ok(url) -> url
        Err(_) -> {
            // Sema rejects malformed heads; terminate a violated compiler invariant.
            // GATE #4565: kernel primitive
            #Unsafe("abort on malformed lowered typed URL invariant, without manufacturing a value") { process.abort() }
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:474
fn jet_typed_url_literal_checked(literals: [String], holes: [String]) -> JetURLParts Err! {
    if literals.len() != holes.len() + 1 -> return Err("typed URL literal and hole counts do not match")
    (marker, initial) :: jet_typed_url_marker(literals)?
    url := initial
    hole_index := 0
    (scheme, _) :: jet_url_apply_typed_holes(url.scheme, marker, holes, &hole_index)?
    url.scheme = scheme.to_ascii_lowercase()
    if Val(username) = &url.username.take() -> url.username = Val(jet_url_apply_typed_holes(username, marker, holes, &hole_index)?.0)
    if Val(password) = &url.password.take() -> url.password = Val(jet_url_apply_typed_holes(password, marker, holes, &hole_index)?.0)
    if Val(host) = &url.host.take() {
        (host_value, parts) :: jet_url_apply_typed_holes(host, marker, holes, &hole_index)?
        url.host = Val(host_value)
        url.typed_host = parts
    }
    (path, path_parts) :: jet_url_apply_typed_holes(url.path, marker, holes, &hole_index)?
    url.path = path
    url.typed_path = path_parts
    if Val(taken) = &url.typed_path.take() {
        parts :: if url.scheme == "data" -> taken else -> jet_url_normalize_typed_path(^taken)
        url.path = parts.iter().map((part, _) -> part.as_str()).collect()
        url.typed_path = Val(parts)
    } else if url.scheme != "data" { url.path = jet_url_remove_dot_segments(url.path) }
    loop (key, value) in &url.query {
        key_value :: jet_url_apply_typed_holes(key, marker, holes, &hole_index)?.0
        key = key_value
        value_value :: jet_url_apply_typed_holes(value, marker, holes, &hole_index)?.0
        value = value_value
    }
    if Val(fragment) = &url.fragment.take() -> url.fragment = Val(jet_url_apply_typed_holes(fragment, marker, holes, &hole_index)?.0)
    if hole_index != holes.len() -> return Err("typed URL holes do not match its literal skeleton")
    Ok(url)
}
