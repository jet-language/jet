// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:1280
fn jet_url_remove_dot_segments(path: String) -> String {
    if path.is_empty() || !path.contains('.') -> return path.to_string()
    absolute :: path.starts_with('/')
    trailing :: path.ends_with('/')
    parts := [String]{}
    loop p in path.split('/') {
        match p { "" | "." -> {}, ".." -> { _ :: &parts.pop() }, _ -> &parts.push(p) }
    }
    out := ""
    if absolute -> &out.push('/')
    &out.push_str(parts.join("/"))
    if trailing && !out.ends_with('/') -> &out.push('/')
    if out.is_empty() && absolute -> "/" else -> out
}
