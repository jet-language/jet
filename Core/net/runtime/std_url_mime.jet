// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:901
fn jet_url_typed_path_segments(parts: [(String, Bool)]) -> [String] {
    segments := [String]{}
    current := ""
    loop (part, hole) in parts {
        if hole { &current.push_str(part); continue }
        loop (index, piece) in part.split('/').enumerate() {
            if index > 0 && !current.is_empty() {
                &segments.push(^current)
