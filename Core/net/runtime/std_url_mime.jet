// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:928
fn jet_url_parse_authority(authority: String, typed_marker: String?) -> (String?, String?, String, Int?) Err! {
    (userinfo, host_port) :: match authority.rsplit_once('@') {
        Val((ui, hp)) -> (Val(ui), hp)
        None -> (None, authority)
    }
    (username, password) :: if Val(ui) = userinfo -> {
        match ui.split_once(':') {
            Val((user, pass)) -> (Val(jet_url_percent_decode_str(user)?), Val(jet_url_percent_decode_str(pass)?))
            None -> (Val(jet_url_percent_decode_str(ui)?), None)
        }
    } else -> (None, None)
    if host_port.is_empty() -> return Err("URL host is empty")
    if host_port.starts_with('[') {
        end :: host_port.find(']').ok_or("IPv6 host is missing `]`")?
        suffix :: host_port[end + 1..]
        (host, port) :: if suffix.is_empty() -> (host_port[..=end].to_ascii_lowercase(), None)
        else if Val(marker) = typed_marker -> {
            if suffix.starts_with(':') && jet_url_only_typed_markers(suffix[1..], marker) -> (host_port.to_ascii_lowercase(), None)
            else if jet_url_only_typed_markers(suffix, marker) -> (host_port.to_ascii_lowercase(), None)
            else if suffix.starts_with(':') -> (host_port[..=end].to_ascii_lowercase(), Val(jet_url_parse_port(suffix[1..])?))
            else -> return Err("invalid text after IPv6 host")
        } else if suffix.starts_with(':') -> (host_port[..=end].to_ascii_lowercase(), Val(jet_url_parse_port(suffix[1..])?))
        else -> return Err("invalid text after IPv6 host")
        return Ok((username, password, host, port))
    }
    (host, port) :: if Val((h, p)) = host_port.rsplit_once(':') -> {
        if !p.is_empty() && p.chars().all(c -> c.is_ascii_digit()) -> (h, Val(jet_url_parse_port(p)?))
        else -> (host_port, None)
    } else -> (host_port, None)
    Ok((username, password, jet_url_host_to_ascii(host)?, port))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs:999
fn jet_url_only_typed_markers(value: String, marker: String) -> Bool {
