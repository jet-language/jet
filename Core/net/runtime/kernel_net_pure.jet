// D-NETSOCKET1=A: pure address value rules shared by NetHTTP and comptime.
use std.net.[IpAddr, SocketAddr, AddrParseError]

// Rust: crates/jet-codegen/src/Prelude/Core/NetPure.rs:3
pub fn jet_net_pure_parse_ip(text: String) -> IpAddr AddrParseError! { text.parse<IpAddr>() }
// Rust: crates/jet-codegen/src/Prelude/Core/NetPure.rs:9
pub fn jet_net_pure_parse_socket_addr(text: String) -> SocketAddr AddrParseError! { text.parse<SocketAddr>() }
// Rust: crates/jet-codegen/src/Prelude/Core/NetPure.rs:15
pub fn jet_net_pure_ip_is_ipv4(address: IpAddr) -> Bool Never! { address.is_ipv4() }
// Rust: crates/jet-codegen/src/Prelude/Core/NetPure.rs:19
pub fn jet_net_pure_socket_host(address: SocketAddr) -> String Never! { address.ip().to_string() }
// Rust: crates/jet-codegen/src/Prelude/Core/NetPure.rs:23
pub fn jet_net_pure_socket_port(address: SocketAddr) -> I64 Never! { I64{address.port()} }
// Rust: crates/jet-codegen/src/Prelude/Core/NetPure.rs:27
pub fn jet_net_pure_socket_to_string(address: SocketAddr) -> String Never! { address.to_string() }

