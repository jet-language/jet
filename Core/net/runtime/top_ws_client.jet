                value := value.trim() // #4303
                if name.eq_ignore_ascii_case("upgrade") && value.eq_ignore_ascii_case("websocket") { upgrade_ok = true }
                else if name.eq_ignore_ascii_case("connection") && value.split(',').any(fn(part) { part.trim().eq_ignore_ascii_case("Upgrade") }) { connection_ok = true }
                else if name.eq_ignore_ascii_case("sec-websocket-accept") && value == expected { accept_ok = true }
            }
            if !(upgrade_ok && connection_ok && accept_ok) -> return Err(JetWsError.InvalidHandshake)
            break
        }
    }
    JetWsConn.from_stream(^stream, JetWsRole.Client)
}
