#Unsafe("write each complete frame through an exclusively borrowed native socket")
fn jet_ws_write_frame(stream: &TcpStream, opcode: U8, payload: &[U8], masked: Bool) -> () JetWsError! {
    if payload.len() > JET_WS_MAX_MESSAGE -> return Err(JetWsError.MessageTooLarge{limit: JET_WS_MAX_MESSAGE as I64})
    if (opcode == 0x8 || opcode == 0x9 || opcode == 0xA) && payload.len() > JET_WS_MAX_CONTROL -> return Err(JetWsError.Protocol)
