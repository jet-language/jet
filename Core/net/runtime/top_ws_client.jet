fn jet_ws_sha1(data: &[U8]) -> [U8; 20] {
    // Minimal SHA-1 for the RFC6455 accept key only.
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WsClient.rs:123
    fn rotl(value: U32, bits: U32) -> U32 { value.rotate_left(bits) }
    h0 := U32{0x67452301}
    h1 := U32{0xEFCDAB89}
    h2 := U32{0x98BADCFE}
    h3 := U32{0x10325476}
    h4 := U32{0xC3D2E1F0}
    bit_len :: (data.len() as U64).saturating_mul(8)
    msg := data.to_vec()
    msg.push(0x80)
    while msg.len() % 64 != 56 { msg.push(0) }
    msg.extend_from_slice(&bit_len.to_be_bytes())
    for chunk in msg.chunks_exact(64) {
        w := [U32; 80].filled(0)
        for (i, word) in chunk.chunks_exact(4).enumerate() { w[i] = U32.from_be_bytes([word[0], word[1], word[2], word[3]]) }
        for i in 16..80 { w[i] = rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1) }
        a := h0; b := h1; c := h2; d := h3; e := h4
        for i in 0..80 {
            (f, k) :: match i {
                0..=19 -> ((b & c) | ((!b) & d), U32{0x5A827999})
                20..=39 -> (b ^ c ^ d, U32{0x6ED9EBA1})
                40..=59 -> ((b & c) | (b & d) | (c & d), U32{0x8F1BBCDC})
                _ -> (b ^ c ^ d, U32{0xCA62C1D6})
            }
            temp :: rotl(a, 5).wrapping_add(f).wrapping_add(e).wrapping_add(k).wrapping_add(w[i])
            e = d; d = c; c = rotl(b, 30); b = a; a = temp
        }
        h0 = h0.wrapping_add(a); h1 = h1.wrapping_add(b); h2 = h2.wrapping_add(c)
        h3 = h3.wrapping_add(d); h4 = h4.wrapping_add(e)
    }
    out := [U8; 20].filled(0)
    for (index, value) in [h0, h1, h2, h3, h4].into_iter().enumerate() {
        out[index * 4..(index + 1) * 4].copy_from_slice(&value.to_be_bytes())
    }
    out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WsClient.rs:178
fn jet_ws_base64(bytes: &[U8]) -> String {
    const TABLE: &[U8] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    out := String.new()
    index := 0
    while index + 3 <= bytes.len() {
        n :: ((bytes[index] as U32) << 16) | ((bytes[index + 1] as U32) << 8) | (bytes[index + 2] as U32)
        out.push(TABLE[((n >> 18) & 63) as USize] as Char)
        out.push(TABLE[((n >> 12) & 63) as USize] as Char)
        out.push(TABLE[((n >> 6) & 63) as USize] as Char)
        out.push(TABLE[(n & 63) as USize] as Char)
        index += 3
    }
    rest :: bytes.len() - index
    if rest == 1 {
        n :: (bytes[index] as U32) << 16
        out.push(TABLE[((n >> 18) & 63) as USize] as Char)
        out.push(TABLE[((n >> 12) & 63) as USize] as Char)
        out.push('='); out.push('=')
    } else if rest == 2 {
        n :: ((bytes[index] as U32) << 16) | ((bytes[index + 1] as U32) << 8)
        out.push(TABLE[((n >> 18) & 63) as USize] as Char)
        out.push(TABLE[((n >> 12) & 63) as USize] as Char)
        out.push(TABLE[((n >> 6) & 63) as USize] as Char)
        out.push('=')
    }
    out
}
