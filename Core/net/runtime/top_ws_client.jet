        mask :: jet_ws_mask_key()
        header.extend_from_slice(&mask)
        jet_ws_apply_mask(&body, mask)
    }
    stream.write_all(&header).map_err(fn(_) { JetWsError.IO{operation: "write frame header"} })?
    stream.write_all(&body).map_err(fn(_) { JetWsError.IO{operation: "write frame payload"} })?
