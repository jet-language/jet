fn jet_ws_parse_url(url: &String) -> (String, U16, String) JetWsError! {
    rest :: url.strip_prefix("ws://").ok_or(JetWsError.InvalidURL)?
    (authority, path) :: match rest.split_once('/') {
        Val((authority, path)) -> (authority, "/{path}")
        None -> (rest, "/")
    }
    if authority.is_empty() || authority.contains('@') -> return Err(JetWsError.InvalidURL)
    (host, port) :: if authority.strip_prefix('[') is Val(host) {
        (host, rest) :: host.split_once(']').ok_or(JetWsError.InvalidURL)?
        port :: if rest.is_empty() { U16{80} } else {
            rest.strip_prefix(':').ok_or(JetWsError.InvalidURL)?.parse<U16>().map_err(fn(_) { JetWsError.InvalidURL })?
        }
        (host.to_string(), port)
    } else if authority.rsplit_once(':') is Val((host, port)) {
        if host.contains(':') -> return Err(JetWsError.InvalidURL)
        (host.to_string(), port.parse<U16>().map_err(fn(_) { JetWsError.InvalidURL })?)
    } else { (authority.to_string(), U16{80}) }
    if host.is_empty() || !path.starts_with('/') || host.bytes().any(fn(byte) { byte.is_ascii_control() || byte.is_ascii_whitespace() }) || path.bytes().any(fn(byte) { byte.is_ascii_control() || byte.is_ascii_whitespace() }) {
        return Err(JetWsError.InvalidURL)
    }
    Ok((^host, port, ^path))
}
