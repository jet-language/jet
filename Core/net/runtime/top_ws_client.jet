    stream.set_read_timeout(Val(JET_WS_DEFAULT_READ_TIMEOUT)).map_err(fn(_) { JetWsError.IO{operation: "set read timeout"} })?
    stream.set_write_timeout(Val(JET_WS_DEFAULT_READ_TIMEOUT)).map_err(fn(_) { JetWsError.IO{operation: "set write timeout"} })?
    key :: jet_ws_random_key()
    host_header :: if port == 80 { host.clone() } else { "{host}:{port}" }
    request :: "GET {path} HTTP/1.1\r\nHost: {host_header}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n"
