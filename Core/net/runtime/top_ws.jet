// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Ws.rs:29
pub fn jet_ws_take_upgraded() -> Bool {
    // GATE #4565: kernel primitive
    #Unsafe("consume and clear only this dispatch thread's upgrade flag") {
        JET_WS_UPGRADED.with(fn(flag) {
            upgraded :: flag.get()
