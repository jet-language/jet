// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Ws.rs:9
pub struct JetWsStreamGuard {}
impl JetWsStreamGuard {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Ws.rs:12
