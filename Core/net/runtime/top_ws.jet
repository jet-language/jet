// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Ws.rs:37
fn jet_ws_header_get(headers: &JetHTTPHeaders, name: &String) -> String? {
    headers.get(name).map(fn(value) { value.as_str() })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Ws.rs:41
fn jet_ws_header_has_token(headers: &JetHTTPHeaders, name: &String, token: &String) -> Bool {
    headers.all(name).iter().any(fn(value) {
        value.split(',').any(fn(part) { part.trim().eq_ignore_ascii_case(token) })
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Ws.rs:50
fn jet_ws_validate_upgrade_request(req: &JetHTTPRequest) -> String JetWsError! {
    if req.method != "GET" -> return Err(JetWsError.InvalidHandshake)
    if !jet_ws_header_has_token(&req.headers, "upgrade", "websocket") -> return Err(JetWsError.InvalidHandshake)
    if !jet_ws_header_has_token(&req.headers, "connection", "Upgrade") -> return Err(JetWsError.InvalidHandshake)
    version :: jet_ws_header_get(&req.headers, "sec-websocket-version").ok_or(JetWsError.InvalidHandshake)?
    if version != "13" -> return Err(JetWsError.InvalidHandshake)
    key :: jet_ws_header_get(&req.headers, "sec-websocket-key").ok_or(JetWsError.InvalidHandshake)?
    if key.is_empty() || key.len() > 256 -> return Err(JetWsError.InvalidHandshake)
    Ok(key.to_string())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Ws.rs:73
// GATE #4565: kernel primitive
#Unsafe("write and flush the upgrade response to the retained native stream")
fn jet_ws_write_upgrade_response(stream: &TcpStream, accept: &String) -> () JetWsError! {
    response :: "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: {accept}\r\n\r\n"
    stream.write_all(response.as_bytes()).map_err(fn(_) { JetWsError.IO{operation: "write upgrade response"} })?
    stream.flush().map_err(fn(_) { JetWsError.IO{operation: "flush upgrade response"} })?
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Ws.rs:92
pub fn jet_ws_upgrade(req: &JetHTTPRequest) -> JetWsConn JetWsError! {
    key :: jet_ws_validate_upgrade_request(req)?
    accept :: jet_ws_accept_key(&key)
    // GATE #4565: kernel primitive
    stream := #Unsafe("pointer is installed only while JetWsStreamGuard wraps mux dispatch; clone transfers independent socket ownership") {
        JET_WS_ACTIVE_STREAM.with(fn(slot) {
            pointer :: slot.borrow().ok_or(JetWsError.InvalidHandshake)?
            stream := pointer.as_mut()
            stream.try_clone().map_err(fn(_) { JetWsError.IO{operation: "clone upgrade stream"} })
        })
    }?
    jet_ws_write_upgrade_response(&stream, &accept)?
    // GATE #4565: kernel primitive
    #Unsafe("set only this dispatch thread's successful upgrade flag") { JET_WS_UPGRADED.with(fn(flag) { flag.set(true) }) }
    JetWsConn.from_stream(^stream, JetWsRole.Server)
}
