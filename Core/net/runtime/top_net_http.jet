fn jet_net_dns_result<T>(result: T Err!, name: String) -> T JetNetError! {
    result.map_err(fn(message) {
        if message.starts_with("DNS name not found") -> JetNetError.DNS(.NotFound(name))
        else if message.starts_with("network operation cancelled") -> JetNetError.Cancelled(jet_net_detail("dns", None, Val(name), ^message, None))
        else if message.starts_with("network protocol error") -> JetNetError.Protocol(jet_net_detail("dns", None, Val(name), ^message, None))
        else if message.contains("timed out") || message.contains("timeout") -> JetNetError.Timeout(jet_net_detail("dns", None, Val(name), ^message, None))
