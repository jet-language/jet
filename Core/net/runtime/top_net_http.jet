            jet_net_tls_write_step_impl, jet_net_tls_close_step_impl, jet_net_tls_close_write_step_impl,
            jet_net_tls_peer_identity_impl)
    }.map_err(jet_net_to_io_error)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:1425
fn jet_net_tls_client_scheduler(stream: JetTCPStream, server_name: &String,
    begin: fn(native_net.TcpStream, &String) -> I64 Err!,
    handshake_step: fn(I64) -> Bool Err!, abort: fn(I64) -> (),
    wants: fn(I64) -> (Bool, Bool) Err!, read_ready: fn(I64) -> Bool Err!,
    read_step: fn(I64, I64) -> [U8]? Err!, write_step: fn(I64, &[U8]) -> I64? Err!,
    close_step: fn(I64) -> Bool Err!, close_write_step: fn(I64) -> Bool Err!,
    peer_snapshot: fn(I64) -> JetTLSPeerSnapshot Err!) -> JetTLSStream JetNetError! {
    jet_net_tls_client_scheduler_with_begin(^stream, fn(inner) -> begin(^inner, server_name),
        handshake_step, abort, wants, read_ready, read_step, write_step, close_step, close_write_step, peer_snapshot)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:1454
fn jet_net_tls_client_scheduler_with_begin(stream: JetTCPStream,
    begin: fn(native_net.TcpStream) -> I64 Err!,
    handshake_step: fn(I64) -> Bool Err!, abort: fn(I64) -> (),
    wants: fn(I64) -> (Bool, Bool) Err!, read_ready: fn(I64) -> Bool Err!,
    read_step: fn(I64, I64) -> [U8]? Err!, write_step: fn(I64, &[U8]) -> I64? Err!,
    close_step: fn(I64) -> Bool Err!, close_write_step: fn(I64) -> Bool Err!,
    peer_snapshot: fn(I64) -> JetTLSPeerSnapshot Err!) -> JetTLSStream JetNetError! {
    // GATE #4565: kernel primitive
    socket :: #Unsafe("duplicate the TCP descriptor for scheduler readiness before transferring the original into TLS") {
        stream.inner.try_clone()
    }.map_err(fn(error) -> jet_net_io_error("tls scheduler registration", None, error))?
    read_timeout_ms :: stream.read_timeout_ms
    write_timeout_ms :: stream.write_timeout_ms
    handshake_timeout_ms :: match (read_timeout_ms, write_timeout_ms) {
        (Val(read), Val(write)) -> Val(read.min(write))
        (read, write) -> read.or(write)
    }
    id :: jet_net_tls_result(begin(^stream.inner), "tls handshake")?
    tls := JetTLSStream{id: id, socket: ^socket, read_timeout_ms: read_timeout_ms, write_timeout_ms: write_timeout_ms,
        wants: wants, read_ready: read_ready, read_step: read_step, write_step: write_step,
        close_step: close_step, close_write_step: close_write_step, peer_snapshot: peer_snapshot, peer_identity: None}
    result :: (fn() -> JetTLSStream JetNetError! {
        _deadline :: jet_net_operation_deadline(handshake_timeout_ms)
        loop {
            if jet_net_tls_result(handshake_step(id), "tls handshake")? {
                peer :: jet_net_tls_peer_identity_from_snapshot(jet_net_tls_result(tls.peer_snapshot(id), "tls peer identity")?)?
                tls.peer_identity = Val(^peer)
                return Ok(^tls)
            }
            jet_net_tls_scheduler_wait(&tls, true, true, "tls handshake")?
        }
    })()
    if result.is_err() { abort(id) }
    ^result
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:1515
fn jet_net_tls_client_scheduler_deadline(stream: JetTCPStream, server_name: &String, deadline: &JetDuration,
    begin: fn(native_net.TcpStream, &String) -> I64 Err!,
    handshake_step: fn(I64) -> Bool Err!, abort: fn(I64) -> (),
    wants: fn(I64) -> (Bool, Bool) Err!, read_ready: fn(I64) -> Bool Err!,
    read_step: fn(I64, I64) -> [U8]? Err!, write_step: fn(I64, &[U8]) -> I64? Err!,
    close_step: fn(I64) -> Bool Err!, close_write_step: fn(I64) -> Bool Err!,
    peer_snapshot: fn(I64) -> JetTLSPeerSnapshot Err!) -> JetTLSStream JetNetError! {
    _deadline :: jet_net_explicit_deadline(deadline, "tls handshake")?
    jet_net_tls_client_scheduler(^stream, server_name, begin, handshake_step, abort, wants, read_ready,
        read_step, write_step, close_step, close_write_step, peer_snapshot)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:1547
fn jet_net_tls_client_scheduler_config_deadline(stream: JetTCPStream, server_name: &String,
    config: &JetTLSClientConfig, deadline: &JetDuration,
    begin: fn(native_net.TcpStream, &String, I64, &[U8], &[U8], &[U8], I64, I64, &[String]) -> I64 Err!,
    handshake_step: fn(I64) -> Bool Err!, abort: fn(I64) -> (),
    wants: fn(I64) -> (Bool, Bool) Err!, read_ready: fn(I64) -> Bool Err!,
    read_step: fn(I64, I64) -> [U8]? Err!, write_step: fn(I64, &[U8]) -> I64? Err!,
    close_step: fn(I64) -> Bool Err!, close_write_step: fn(I64) -> Bool Err!,
    peer_snapshot: fn(I64) -> JetTLSPeerSnapshot Err!) -> JetTLSStream JetNetError! {
    _deadline :: jet_net_explicit_deadline(deadline, "tls handshake")?
    (trust_mode, roots) :: match config.trust {
        .System -> (0, [U8]{})
        .SystemPlus(roots) -> (1, roots.pem.clone())
        .CustomOnly(roots) -> (2, roots.pem.clone())
    }
    empty :: [U8]{}
    (cert_chain, private_key) :: config.identity.as_ref().map(fn(identity) -> (&identity.cert_chain, identity.private_key.as_vec())).unwrap_or((&empty, &empty))
    version :: fn(version) -> match version { .TLS12 -> 12, .TLS13 -> 13 }
    jet_net_tls_client_scheduler_with_begin(^stream,
        fn(inner) -> begin(^inner, server_name, trust_mode, &roots, cert_chain, private_key,
            version(config.min_version), version(config.max_version), &config.alpn),
        handshake_step, abort, wants, read_ready, read_step, write_step, close_step, close_write_step, peer_snapshot)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:1616
fn jet_net_tls_read_bytes(stream: &JetTLSStream, limit: I64) -> [U8] IOError! {
    if limit <= 0 -> return Err(IOError.InvalidInput(IOContext.new(IOOperation.Read, Val("TLS stream"), None, Val("tls read limit must be positive"))))
    _deadline :: jet_net_operation_deadline(stream.read_timeout_ms)
    loop {
        match jet_net_tls_io_result(stream.read_step(stream.id, limit), IOOperation.Read)? {
            Val(bytes) -> return Ok(^bytes)
            None -> { jet_net_tls_io_scheduler_wait(stream, true, false, IOOperation.Read)? }
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:1640
fn jet_net_tls_read_bytes_deadline(stream: &JetTLSStream, limit: I64, deadline: &JetDuration) -> [U8] IOError! {
    _deadline :: jet_net_explicit_deadline(deadline, "tls read").map_err(jet_net_to_io_error)?
    jet_net_tls_read_bytes(stream, limit)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:1649
fn jet_net_tls_read_text(stream: &JetTLSStream) -> String IOError! {
    bytes :: jet_net_tls_read_bytes(stream, 8192)?
    String.from_utf8(^bytes).map_err(fn(error) -> IOError.InvalidInput(IOContext.new(IOOperation.Read, Val("TLS stream"), None, Val("tls read text failed: invalid UTF-8: {error}"))))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:1661
fn jet_net_tls_write_bytes_with_current_deadline(stream: &JetTLSStream, data: &[U8]) -> I64 IOError! {
    loop {
        match jet_net_tls_io_result(stream.write_step(stream.id, data), IOOperation.Write)? {
            Val(count) -> return Ok(count)
            None -> { jet_net_tls_io_scheduler_wait(stream, false, true, IOOperation.Write)? }
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:1678
fn jet_net_tls_write_bytes(stream: &JetTLSStream, data: &[U8]) -> I64 IOError! {
    _deadline :: jet_net_operation_deadline(stream.write_timeout_ms)
    jet_net_tls_write_bytes_with_current_deadline(stream, data)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:1686
fn jet_net_tls_write_all_bytes(stream: &JetTLSStream, data: &[U8]) -> () IOError! {
    _deadline :: jet_net_operation_deadline(stream.write_timeout_ms)
    offset: USize := 0
    loop offset < data.len() {
        chunk :: data[offset..].to_vec()
        count :: jet_net_tls_write_bytes_with_current_deadline(stream, &chunk)? as USize
        if count == 0 -> return Err(IOError.Other(IOContext.new(IOOperation.Write, Val("TLS stream"), None, Val("tls write all failed: zero bytes written"))))
        offset += count
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:1708
fn jet_net_tls_write_all_bytes_deadline(stream: &JetTLSStream, data: &[U8], deadline: &JetDuration) -> () IOError! {
    _deadline :: jet_net_explicit_deadline(deadline, "tls write all").map_err(jet_net_to_io_error)?
    jet_net_tls_write_all_bytes(stream, data)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:1718
fn jet_net_tls_write_text(stream: &JetTLSStream, text: &String) -> () IOError! {
    jet_net_tls_write_all_bytes(stream, &text.as_bytes().to_vec())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:1725
fn jet_net_tls_close(stream: &JetTLSStream) -> () IOError! {
    _deadline :: jet_net_operation_deadline(stream.write_timeout_ms)
    loop {
        if jet_net_tls_io_result(stream.close_step(stream.id), IOOperation.Close)? -> return Ok(())
        jet_net_tls_io_scheduler_wait(stream, false, true, IOOperation.Close)?
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:1735
fn jet_net_tls_close_write(stream: &JetTLSStream, deadline: &JetDuration) -> () IOError! {
    _deadline :: jet_net_explicit_deadline(deadline, "tls close write").map_err(jet_net_to_io_error)?
    loop {
        if jet_net_tls_io_result(stream.close_write_step(stream.id), IOOperation.Close)? -> return Ok(())
        jet_net_tls_io_scheduler_wait(stream, false, true, IOOperation.Close)?
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:1752
fn jet_net_tls_peer_identity_from_snapshot(snapshot: JetTLSPeerSnapshot) -> JetTLSPeerIdentity JetNetError! {
    (verified_server_name, ders, spkis, dns_names, valid_from, valid_until, subjects, issuers, cipher_suite, tls_version) :: ^snapshot
    certificate_chain := [JetTLSCertificate].with_capacity(ders.len())
    loop index in 0..ders.len() {
        der :: ders[index].clone()
        certificate_chain.push(JetTLSCertificate{
            sha256: sha256_bytes(der), spki_sha256: sha256_bytes(spkis[index]),
            der: ^der, dns_names: dns_names[index].clone(), valid_from_unix_ms: valid_from[index],
            valid_until_unix_ms: valid_until[index], subject: subjects[index].clone(), issuer: issuers[index].clone()})
    }
    leaf :: certificate_chain.first().cloned().ok_or_else(fn() ->
        JetNetError.TLS(jet_net_detail("tls peer identity", None, None, "verified TLS peer chain is empty", None)))?
    tls_version :: match tls_version {
        12 -> JetTLSVersion.TLS12
        13 -> JetTLSVersion.TLS13
        other -> return Err(JetNetError.TLS(jet_net_detail("tls peer identity", None, None, "TLS peer negotiated unsupported protocol version `{other}`", None)))
    }
    Ok(JetTLSPeerIdentity{verified_server_name: ^verified_server_name, leaf: ^leaf,
        certificate_chain: ^certificate_chain, cipher_suite: ^cipher_suite, tls_version: tls_version})
}

