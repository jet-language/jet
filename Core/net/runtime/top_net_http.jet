fn jet_net_tls_result<T>(result: T Err!, operation: String) -> T JetNetError! {
    result.map_err(fn(message) {
        detail :: jet_net_detail(operation, None, None, message.clone(), None)
        if message.starts_with("TLS protocol truncation:") -> JetNetError.Protocol(^detail)
        else if message.contains("closed") -> JetNetError.Closed(^detail)
        else if message.contains("timed out") || message.contains("deadline") -> JetNetError.Timeout(^detail)
        else -> JetNetError.TLS(^detail)
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:717
fn jet_net_tls_io_result<T>(result: T Err!, operation: IOOperation) -> T IOError! {
    result.map_err(fn(message) {
        context :: IOContext.new(operation, Val("TLS stream"), None, Val(message.clone()))
        if message.starts_with("TLS protocol truncation:") || message.starts_with("TLS protocol error:") -> IOError.Protocol(^context)
        else if message.contains("closed") -> IOError.Closed(^context)
        else if message.contains("timed out") || message.contains("deadline") -> IOError.TimedOut(^context)
        else if message.contains("cancelled") -> IOError.Cancelled(^context)
        else -> IOError.Other(^context)
    })
}
