        .Closed(value) -> detail("Closed", 7, ^value)
        .Timeout(value) -> detail("Timeout", 8, ^value)
        .Cancelled(value) -> detail("Cancelled", 9, ^value)
        .Unsupported(value) -> detail("Unsupported", 10, ^value)
        .TLS(value) -> detail("TLS", 11, ^value)
        .Protocol(value) -> detail("Protocol", 12, ^value)
        .Other(value) -> detail("Other", 13, ^value)
        .DNS(.NotFound(value)) -> JetNetErrorSurfaceParts{variant: "DNS", ordinal: 14, payload: .DNS{variant: "NotFound", ordinal: 0, value: ^value}}
        .DNS(.Failure(value)) -> JetNetErrorSurfaceParts{variant: "DNS", ordinal: 14, payload: .DNS{variant: "Failure", ordinal: 1, value: ^value}}
    }
