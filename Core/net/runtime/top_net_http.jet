impl JetShow for JetNetError {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:531
    fn jet_show(self: &Self) -> String {
        (variant, detail_message, dns_variant, dns_value) :: match self {
            .InvalidInput(d) -> (0, Val(d.message), None, None)
            .PermissionDenied(d) -> (1, Val(d.message), None, None)
            .AddressInUse(d) -> (2, Val(d.message), None, None)
            .AddressUnavailable(d) -> (3, Val(d.message), None, None)
            .ConnectionRefused(d) -> (4, Val(d.message), None, None)
            .ConnectionReset(d) -> (5, Val(d.message), None, None)
            .NotConnected(d) -> (6, Val(d.message), None, None)
            .Closed(d) -> (7, Val(d.message), None, None)
            .Timeout(d) -> (8, Val(d.message), None, None)
            .Cancelled(d) -> (9, Val(d.message), None, None)
            .Unsupported(d) -> (10, Val(d.message), None, None)
            .TLS(d) -> (11, Val(d.message), None, None)
            .Protocol(d) -> (12, Val(d.message), None, None)
            .Other(d) -> (13, Val(d.message), None, None)
            .DNS(.NotFound(name)) -> (14, None, Val(0), Val(name))
            .DNS(.Failure(message)) -> (14, None, Val(1), Val(message))
        }
        jet_net_error_kernel_show(variant, detail_message, dns_variant, dns_value)
    }
}
