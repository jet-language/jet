// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:43
fn jet_net_to_io_error(error: JetNetError) -> IOError {
    text :: jet_net_error_operation(&error)
    operation :: if text.contains("read") -> IOOperation.Read
        else if text.contains("write") || text.contains("send") -> IOOperation.Write
        else if text.contains("connect") -> IOOperation.Connect
        else if text.contains("accept") -> IOOperation.Accept
        else if text.contains("close") || text.contains("shutdown") -> IOOperation.Close
        else if text.contains("resolve") || text.contains("dns") -> IOOperation.Resolve
        else -> IOOperation.Codec
    resource :: jet_net_error_address(&error).or_else(fn() -> jet_net_error_name(&error))
    context :: IOContext.new(operation, resource, jet_net_error_os_code(&error), Val(error.jet_show()))
    match error {
        .InvalidInput(_) -> IOError.InvalidInput(^context)
        .PermissionDenied(_) -> IOError.PermissionDenied(^context)
        .Timeout(_) -> IOError.TimedOut(^context)
        .Cancelled(_) -> IOError.Cancelled(^context)
        .Closed(_) | .NotConnected(_) -> IOError.Closed(^context)
        .Protocol(_) -> IOError.Protocol(^context)
        _ -> IOError.Other(^context)
    }
}
