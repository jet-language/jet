// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:660
fn jet_net_io_error(operation: String, address: String?, error: native_io.Error) -> JetNetError {
    detail :: jet_net_detail(operation, ^address, None, "{operation} failed: {error}", error.raw_os_error().map(fn(code) -> code as I64))
    match error.kind() {
        .InvalidInput | .InvalidData -> JetNetError.InvalidInput(^detail)
        .PermissionDenied -> JetNetError.PermissionDenied(^detail)
        .AddrInUse -> JetNetError.AddressInUse(^detail)
