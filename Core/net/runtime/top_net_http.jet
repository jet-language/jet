    peer_snapshot: fn(I64) -> JetTLSPeerSnapshot Err!) -> JetTLSStream JetNetError! {
    jet_net_tls_client_scheduler_with_begin(^stream, fn(inner) -> begin(^inner, server_name),
        handshake_step, abort, wants, read_ready, read_step, write_step, close_step, close_write_step, peer_snapshot)
}
