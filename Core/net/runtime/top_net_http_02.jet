fn jet_net_dns_a(name: &String, ms: I64) -> [JetIpAddr] Err! {
    out := jet_net_dns_system_lookup(name, ms)?.into_iter().filter(fn(a) { a.is_ipv4() }).map(fn(a) { JetIpAddr{inner: a.ip()} }).collect<[JetIpAddr]>()
    &out.sort_by_key(fn(a) { a.inner })
    &out.dedup_by_key(fn(a) { a.inner })
    Ok(^out)
}
