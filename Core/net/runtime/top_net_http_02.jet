    if flags & 0x7800 != 0 -> return Err("network protocol error: unsupported DNS opcode")
    if flags & 0x0040 != 0 -> return Err("network protocol error: reserved DNS header bit is set")
    rcode :: flags & 0x000f
    if rcode == 3 -> return Err("DNS name not found: `{name}`")
    if rcode != 0 -> return Err("DNS server failure for `{name}`: RCODE {rcode}")
    qd :: jet_net_dns_read_u16(&packet, 4, "question count")? as USize
    if qd != 1 -> return Err("network protocol error: DNS response must echo one question")
    total_records :: jet_net_dns_read_u16(&packet, 6, "answer count")? as USize + jet_net_dns_read_u16(&packet, 8, "authority count")? as USize + jet_net_dns_read_u16(&packet, 10, "additional count")? as USize
    pos := USize{12}
    echoed_name :: jet_net_dns_read_name(&packet, &pos)?
    echoed_type :: jet_net_dns_read_u16(&packet, pos, "question type")?
    echoed_class :: jet_net_dns_read_u16(&packet, pos + 2, "question class")?
    pos = pos + 4
    echoed := echoed_name.trim_end_matches('.') // #4303
    requested := name.trim_end_matches('.') // #4303
    if !echoed.eq_ignore_ascii_case(requested) || echoed_type != qtype || echoed_class != 1 -> return Err("network protocol error: DNS question echo mismatch")
    // TC authenticates the header/question only; parse records after bounded TCP retry.
    if flags & 0x0200 != 0 -> return Ok((true, []))
    minimum_record_bytes :: total_records.checked_mul(11).ok_or_else(fn() { "network protocol error: DNS record count overflows packet bounds" })?
    if minimum_record_bytes > packet.len().saturating_sub(pos) -> return Err("network protocol error: DNS record counts exceed packet bounds")
    packet :: Arc.new(^packet)
    records := [JetDNSWireRecord].with_capacity(total_records)
    loop _ in 0..total_records {
        owner :: jet_net_dns_read_name(packet.as_slice(), &pos)?
        ty :: jet_net_dns_read_u16(packet.as_slice(), pos, "record type")?
        class :: jet_net_dns_read_u16(packet.as_slice(), pos + 2, "record class")?
        rdata_len :: jet_net_dns_read_u16(packet.as_slice(), pos + 8, "record length")? as USize
        pos = pos + 10
        end :: pos.checked_add(rdata_len).filter(fn(end) { *end <= packet.len() }).ok_or_else(fn() { "network protocol error: truncated DNS record data" })?
        &records.push(JetDNSWireRecord{owner: ^owner, ty: ty, class: class, packet: packet.clone(), rdata_start: pos, rdata_len: rdata_len})
        pos = end
    }
    if pos != packet.len() -> return Err("network protocol error: trailing bytes after DNS records")
    Ok((false, ^records))
