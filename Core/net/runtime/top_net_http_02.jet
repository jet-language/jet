fn jet_net_tcp_connect(addr: String) -> JetTCPStream JetNetError! {
    jet_scheduler_world_reject_uncontrolled("network")
    // GATE #4483: original wasm32-wasip2 branch.
    if target.selected_os() == "wasi" && target.selected_env() == "p2" && target.selected_arch() == "wasm32" {
