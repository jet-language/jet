fn jet_net_socket_addr(host: String, port: I64) -> JetSocketAddr JetNetError! {
    if port < 0 || port > 65535 {
        return Err(JetNetError.InvalidInput(jet_net_detail("resolve socket address", Val(host.clone()), None, "invalid port `{port}`: expected 0..65535", None)))
    }
