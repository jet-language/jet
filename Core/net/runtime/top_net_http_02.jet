// GATE #4565: kernel primitive
#Unsafe("receive actual UDP datagram including zero-size output limit and retain original length")
fn jet_net_udp_receive(socket: &JetUDPSocket, limit: I64) -> JetUDPPacket JetNetError! {
    jet_net_udp_open(socket, "udp receive")?
    if limit < 0 -> return Err(JetNetError.InvalidInput(jet_net_detail("udp receive", None, None, "udp receive limit must be non-negative", None)))
    _deadline :: jet_net_operation_deadline(socket.timeout_ms.lock().unwrap().get())
    if target.selected_os() == "wasi" && target.selected_env() == "p2" && target.selected_arch() == "wasm32" -> jet_net_udp_apply_timeout(socket, true, "udp receive")?
    cap :: min(limit as USize, 65535)
    bytes := [U8].repeat(0, 65535)
    (original_len, addr) :: loop {
        match socket.inner.recv_from(&bytes) {
            Ok(packet) -> break packet
            Err(error) if error.kind() is .WouldBlock || error.kind() is .Interrupted -> jet_net_udp_scheduler_wait(socket, true, false, "udp receive")?
            Err(error) -> return Err(jet_net_io_error("udp receive", None, ^error))
        }
    }
    &bytes.truncate(min(original_len, cap))
    Ok(JetUDPPacket{data: ^bytes, addr: JetSocketAddr{inner: addr}, original_len: original_len as I64, truncated: original_len > cap})
}
