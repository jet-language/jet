// GATE #4565: kernel primitive
#Unsafe("accept actual native sockets; selected WASI polling preserves deadline/cancellation checks and native targets use scheduler")
fn jet_net_tcp_accept(listener: &JetTCPListener) -> JetTCPStream JetNetError! {
    // GATE #4483: exact wasm32-wasip2 branch.
    if target.selected_os() == "wasi" && target.selected_env() == "p2" && target.selected_arch() == "wasm32" {
        listener.inner.set_nonblocking(true).map_err(fn(error) { jet_net_io_error("tcp accept setup", None, ^error) })?
        loop {
            match listener.inner.accept() {
                Ok((stream, _)) -> return jet_net_tcp_stream(^stream)
                Err(error) if error.kind() == ErrorKind.WouldBlock || error.kind() == ErrorKind.Interrupted -> {
                    if jet_deadline_remaining_ms() is Val(ms) && ms <= 0 -> return Err(jet_net_deadline_timeout("tcp accept"))
                    if jet_scheduler_wait_point_cancelled() -> return Err(JetNetError.Cancelled(jet_net_detail("tcp accept", None, None, "tcp accept cancelled", None)))
                    thread.sleep(NativeDuration.from_millis(2))
                }
                Err(error) -> return Err(jet_net_io_error("tcp accept", None, ^error))
            }
        }
    }
    loop {
        match listener.inner.accept() {
            Ok((stream, _)) -> return jet_net_tcp_stream(^stream)
            Err(error) if error.kind() == ErrorKind.WouldBlock || error.kind() == ErrorKind.Interrupted -> jet_net_tcp_listener_scheduler_wait(&listener.inner, "tcp accept")?
            Err(error) -> return Err(jet_net_io_error("tcp accept", None, ^error))
        }
    }
}
