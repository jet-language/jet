// GATE #4565: kernel primitive
#Unsafe("close retained Unix scheduler descriptor and shutdown real socket once")
fn jet_net_unix_close(stream: &JetUnixStream) -> Unit JetNetError! {
    if target.selected_family() != "unix" -> return Err(JetNetError.Unsupported(jet_net_detail("unix close", None, None, "unix sockets are not supported on this platform", None)))
    if stream.closed -> return Ok(())
    stream.closed = true
    stream.read_shutdown = true
    stream.write_shutdown = true
    stream.scheduler.close()
    match stream.inner.shutdown(Shutdown.Both) {
        Ok(_) -> {}
        Err(error) if error.kind() is .NotConnected -> {}
        Err(error) -> return Err(jet_net_io_error("unix close", None, ^error))
    }
    Ok(())
}
