        Err(_) -> {
            iter := text.to_socket_addrs().map_err(fn(error) { jet_net_io_error("resolve socket address", Val(text.clone()), ^error) })?
            &iter.next().ok_or_else(fn() { NativeIOError.new(ErrorKind.NotFound, "no address") })
        }
    }
    resolved.map(fn(inner) { JetSocketAddr{inner: inner} }).map_err(fn(error) { jet_net_io_error("resolve socket address", Val(^text), ^error) })
}
