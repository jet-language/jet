#Unsafe("receive actual datagram, preserving original size before truncation")
fn jet_net_udp_recv_from(socket: &JetUDPSocket, limit: I64) -> JetUDPPacket JetNetError! {
    jet_net_udp_open(socket, "udp receive")?
    if limit <= 0 -> return Err(JetNetError.InvalidInput(jet_net_detail("udp receive", None, None, "udp receive limit must be positive", None)))
    _deadline :: jet_net_operation_deadline(socket.timeout_ms.lock().unwrap().get())
    if target.selected_os() == "wasi" && target.selected_env() == "p2" && target.selected_arch() == "wasm32" -> jet_net_udp_apply_timeout(socket, true, "udp receive")?
    cap :: min(limit as USize, 1 << 20)
    buf := [U8].repeat(0, 65535)
    loop {
        match socket.inner.recv_from(&buf) {
            Ok((n, addr)) -> {
                &buf.truncate(min(n, cap))
                return Ok(JetUDPPacket{data: ^buf, addr: JetSocketAddr{inner: addr}, original_len: n as I64, truncated: n > cap})
            }
            Err(error) if error.kind() is .WouldBlock || error.kind() is .Interrupted -> jet_net_udp_scheduler_wait(socket, true, false, "udp receive")?
            Err(error) -> return Err(jet_net_io_error("udp receive", None, ^error))
        }
    }
}
