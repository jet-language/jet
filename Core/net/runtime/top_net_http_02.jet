fn jet_net_dns_read_name(packet: &[U8], pos: &USize) -> String Err! {
    labels := [String]{}
    p := *pos
    jumped := false
    seen := [Bool].repeat(false, packet.len())
    wire_len := USize{1}
    loop {
        if p >= packet.len() -> return Err("network protocol error: truncated DNS name")
        if seen[p] -> return Err("network protocol error: cyclic DNS compression pointer")
        seen[p] = true
        len :: packet[p]
        if len & 0xc0 == 0xc0 {
            if p + 1 >= packet.len() -> return Err("network protocol error: truncated DNS compression pointer")
            ptr :: (((len & 0x3f) as USize) << 8) | packet[p + 1] as USize
            if ptr >= packet.len() -> return Err("network protocol error: DNS compression pointer is out of bounds")
            if ptr >= p -> return Err("network protocol error: DNS compression pointer does not point backward")
            if !jumped -> *pos = p + 2
            p = ptr
            jumped = true
            continue
        }
        if len & 0xc0 != 0 -> return Err("network protocol error: reserved DNS label encoding")
        p = p + 1
        if len == 0 {
            if !jumped -> *pos = p
            break
        }
        if len > 63 -> return Err("network protocol error: DNS label exceeds 63 bytes")
        end :: p + len as USize
        if end > packet.len() -> return Err("network protocol error: truncated DNS label")
        wire_len = wire_len + len as USize + 1
        if wire_len > 255 -> return Err("network protocol error: DNS name exceeds 255 bytes")
        label :: from_utf8(&packet[p..end]).map_err(fn(_) { "network protocol error: DNS label is not valid UTF-8" })?
        &labels.push(label.to_string())
        p = end
        if !jumped -> *pos = p
    }
    Ok(if labels.is_empty() { "." } else { labels.join(".") })
