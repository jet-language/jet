// Send a well-formed HTTP/1.1 response and close its write side.
// GATE #4565: kernel primitive
#Unsafe("write complete actual HTTP response bytes and shutdown the real TCP write side")
fn jet_net_tcp_reply(stream: JetTCPStream, status: &String, body: &String) -> Unit JetNetError! {
    stream := ^stream
    response :: "HTTP/1.1 {status}\r\nContent-Length: {body.len()}\r\nContent-Type: text/plain\r\nConnection: close\r\n\r\n{body}"
    &stream.inner.write_all(response.as_bytes()).map_err(fn(error) { jet_net_io_error("tcp reply", None, ^error) })?
    stream.inner.shutdown(Shutdown.Write).map_err(fn(error) { jet_net_io_error("tcp reply close", None, ^error) })
}

