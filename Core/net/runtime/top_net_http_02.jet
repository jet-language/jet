fn jet_net_dns_a_at(server: &String, name: &String, ms: I64) -> [JetIpAddr] Err! {
    records :: jet_net_dns_matching_records(&jet_net_dns_query(server, name, 1, ms)?, name, 1)?
    out := [JetIpAddr]{}
    loop r in records {
        data :: &r.packet[r.rdata_start..r.rdata_start + r.rdata_len]
