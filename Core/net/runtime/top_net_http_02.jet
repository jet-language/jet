    if packet.len() < 12 -> return Err("network protocol error: truncated DNS header")
    if jet_net_dns_read_u16(&packet, 0, "transaction ID")? != txid -> return Err("network protocol error: DNS transaction ID mismatch")
    flags :: jet_net_dns_read_u16(&packet, 2, "flags")?
