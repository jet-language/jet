#Unsafe("invoke audited TLS callbacks and wait on the existing raw socket scheduler boundary")
fn jet_net_tls_ready(stream: &JetTLSStream, interest: JetNetReadyInterest, deadline: &JetDuration) -> JetNetReady IOError! {
    operation :: if interest is .Write { IOOperation.Write } else { IOOperation.Read }
    _deadline :: jet_net_explicit_deadline(deadline, "tls ready").map_err(jet_net_to_io_error)?
    if jet_deadline_remaining_ms() is Val(ms) && ms <= 0 {
        return Err(jet_net_to_io_error(jet_net_deadline_timeout("tls ready")))
    }
    want_read :: interest is .Read || interest is .ReadWrite
    want_write :: interest is .Write || interest is .ReadWrite
    loop {
        readable :: want_read && jet_net_tls_io_result((stream.read_ready)(stream.id), operation)?
        if readable -> return Ok(JetNetReady{readable: true, writable: false})
        (tls_read, tls_write) :: jet_net_tls_io_result((stream.wants)(stream.id), operation)?
        (raw_readable, raw_writable) :: jet_net_tcp_scheduler_ready_wait(&stream.socket, want_read || tls_read, want_write || tls_write, "tls ready").map_err(jet_net_to_io_error)?
        readable :: want_read && raw_readable && jet_net_tls_io_result((stream.read_ready)(stream.id), operation)?
        writable :: want_write && raw_writable
        if readable || writable -> return Ok(JetNetReady{readable: readable, writable: writable})
    }
}
