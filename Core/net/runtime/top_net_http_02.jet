// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:3973
fn jet_net_dns_matching_records(records: &[JetDNSWireRecord], name: String, qtype: U16) -> [JetDNSWireRecord] Err! {
    trimmed := name.trim_end_matches('.') // #4303
    current := trimmed.to_string()
    visited := [String:Bool]{}
    loop _ in 0..16 {
        key :: current.to_ascii_lowercase()
        if visited.contains_key(&key) -> return Err("network protocol error: cyclic DNS CNAME chain")
        _ :: &visited.insert(^key, true)
        found :: records.iter().filter(fn(r) { r.class == 1 && r.ty == qtype && r.owner.eq_ignore_ascii_case(&current) }).cloned().collect<[JetDNSWireRecord]>()
        if !found.is_empty() -> return Ok(^found)
        alias :: records.iter().find(fn(r) { r.class == 1 && r.ty == 5 && r.owner.eq_ignore_ascii_case(&current) })
        match alias {
            Val(record) -> {
                alias_name :: jet_net_dns_record_name(record)?
                alias_trimmed := alias_name.trim_end_matches('.') // #4303
                current = alias_trimmed.to_string()
            }
            None -> return Ok([])
        }
    }
    Err("network protocol error: DNS CNAME chain exceeds 16 records")
}
