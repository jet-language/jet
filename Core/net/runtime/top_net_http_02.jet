fn jet_net_dns_encode_name(out: &[U8], name: String) -> Unit Err! {
    trimmed := name.trim_end_matches('.') // #4303
    if trimmed.is_empty() { &out.push(0); return Ok(()) }
    loop label in trimmed.split('.') {
        if label.is_empty() || label.len() > 63 || !label.is_ascii() -> return Err("invalid DNS name `{name}`")
        &out.push(label.len() as U8)
        &out.extend_from_slice(label.as_bytes())
    }
    &out.push(0)
    if out.len() > 255 -> return Err("invalid DNS name `{name}`: encoded name exceeds 255 bytes")
    Ok(())
}
