#Unsafe("observe actual monotonic deadline while respecting canonical task cancellation and shields")
fn jet_net_dns_remaining(deadline: Instant, name: String) -> NativeDuration Err! {
    if jet_net_dns_cancelled() -> return Err("network operation cancelled during DNS lookup for `{name}`")
    remaining :: deadline.saturating_duration_since(Instant.now())
