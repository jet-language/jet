#Unsafe("shutdown actual Unix socket before recording directional state")
fn jet_net_unix_shutdown(stream: &JetUnixStream, how: JetNetShutdown) -> Unit JetNetError! {
    if target.selected_family() != "unix" -> return Err(JetNetError.Unsupported(jet_net_detail("unix shutdown", None, None, "unix sockets are not supported on this platform", None)))
    if stream.closed -> return Err(jet_net_closed("unix shutdown"))
    os_how :: match how { .Read -> Shutdown.Read, .Write -> Shutdown.Write, .Both -> Shutdown.Both }
    stream.inner.shutdown(os_how).map_err(fn(error) { jet_net_io_error("unix shutdown", None, ^error) })?
    match how {
        .Read -> stream.read_shutdown = true
        .Write -> stream.write_shutdown = true
        .Both -> { stream.read_shutdown = true; stream.write_shutdown = true }
    }
    Ok(())
}
