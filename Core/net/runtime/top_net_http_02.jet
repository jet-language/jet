// GATE #4565: kernel primitive
#Unsafe("apply actual TCP read/write timeouts from the canonical ambient deadline")
fn jet_net_apply_tcp_deadlines(stream: &TcpStream, op: String) -> Unit JetNetError! {
    if jet_deadline_remaining_ms() is Val(remaining) {
        if remaining <= 0 -> return Err(jet_net_deadline_timeout(op))
        dur :: Val(NativeDuration.from_millis(remaining as U64))
        stream.set_read_timeout(dur).map_err(fn(error) { jet_net_io_error("{op} read timeout", None, ^error) })?
        stream.set_write_timeout(dur).map_err(fn(error) { jet_net_io_error("{op} write timeout", None, ^error) })?
    }
    Ok(())
}
