// GATE #4565: kernel primitive
#Unsafe("resolve and race actual native TCP connections using bounded resolver channel, real workers and monotonic launch clock")
fn jet_net_tcp_connect_happy(host: String, port: I64, ms: I64) -> JetTCPStream JetNetError! {
    jet_scheduler_world_reject_uncontrolled("network")
    if port < 0 || port > 65535 {
        return Err(JetNetError.InvalidInput(jet_net_detail("tcp connect", Val(host.clone()), None, "invalid port `{port}`: expected 0..65535", None)))
    }
    _ :: jet_net_timeout(ms).map_err(fn(message) {
        JetNetError.InvalidInput(jet_net_detail("tcp connect", Val(host.clone()), None, ^message, None))
    })?
    _deadline :: jet_net_operation_deadline(Val(ms))
    if jet_deadline_remaining_ms() is Val(remaining) && remaining <= 0 -> return Err(jet_net_deadline_timeout("tcp connect"))
    query :: host.clone()
    (resolve_sender, resolve_receiver) :: mpsc.sync_channel(1)
    _ :: thread.spawn(fn() {
        result :: (query.as_str(), port as U16).to_socket_addrs().map(fn(addrs) { addrs.collect<[SocketAddr]>() })
        _ :: resolve_sender.send(^result)
    })
    addrs :: loop {
        match resolve_receiver.try_recv() {
            Ok(Ok(addrs)) -> break ^addrs
            Ok(Err(error)) -> return Err(jet_net_io_error("resolve socket address", Val(host.clone()), ^error))
            Err(.Empty) -> jet_net_scheduler_park("tcp connect", 5)?
            Err(.Disconnected) -> return Err(JetNetError.Other(jet_net_detail("tcp connect", Val(host.clone()), None, "socket address resolver stopped without a result", None)))
        }
    }
    if addrs.is_empty() {
        return Err(JetNetError.AddressUnavailable(jet_net_detail("tcp connect", Val(host.clone()), None, "tcp connect failed: no address for `{host}`", None)))
    }
    first_is_v6 :: addrs[0].is_ipv6()
    v6 := addrs.iter().copied().filter(fn(addr) { addr.is_ipv6() })
    v4 := addrs.iter().copied().filter(fn(addr) { addr.is_ipv4() })
    ordered := [SocketAddr].with_capacity(addrs.len())
    loop {
        next :: if ordered.len() % 2 == 0 {
            if first_is_v6 { &v6.next().or_else(fn() { &v4.next() }) } else { &v4.next().or_else(fn() { &v6.next() }) }
        } else if first_is_v6 { &v4.next().or_else(fn() { &v6.next() }) } else { &v6.next().or_else(fn() { &v4.next() }) }
        match next { Val(addr) -> &ordered.push(addr), None -> break }
    }
    (sender, receiver) :: mpsc.channel()
    next := 0
    in_flight := 0
    last: (SocketAddr, NativeIOError)? := None
    next_launch := Instant.now()
    loop {
        if next < ordered.len() && Instant.now() >= next_launch {
            addr :: ordered[next]
            remaining :: jet_deadline_remaining_ms().unwrap_or(0)
            if remaining <= 0 -> return Err(jet_net_deadline_timeout("tcp connect"))
            attempt_sender :: sender.clone()
            _ :: thread.spawn(fn() {
                timeout :: NativeDuration.from_millis(remaining as U64)
                _ :: attempt_sender.send((addr, TcpStream.connect_timeout(&addr, timeout)))
            })
            next = next + 1
            in_flight = in_flight + 1
            next_launch = Instant.now() + NativeDuration.from_millis(250)
        }
        match receiver.try_recv() {
            Ok((_, Ok(stream))) -> return jet_net_tcp_stream(^stream)
            Ok((addr, Err(error))) -> {
                in_flight = in_flight - 1
                last = Val((addr, ^error))
                next_launch = Instant.now()
            }
            Err(.Empty) -> {}
            Err(.Disconnected) -> panic("connect sender retained")
        }
        if next == ordered.len() && in_flight == 0 {
            (addr, error) :: last.expect("at least one connection attempt completed")
            return Err(jet_net_io_error("tcp connect", Val(addr.to_string()), ^error))
        }
        jet_net_scheduler_park("tcp connect", 5)?
    }
}
