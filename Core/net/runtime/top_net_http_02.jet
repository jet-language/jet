#Unsafe("read actual native TCP bytes and wait for scheduler readiness")
fn jet_net_tcp_read_bytes(stream: &JetTCPStream, limit: I64) -> [U8] JetNetError! {
    if stream.closed || stream.read_shutdown -> return Err(jet_net_closed("tcp read"))
    if limit < 0 -> return Err(JetNetError.InvalidInput(jet_net_detail("tcp read", None, None, "tcp read limit must be non-negative", None)))
    cap :: min(limit as USize, 16 * 1024 * 1024)
    if cap == 0 -> return Ok([])
    _deadline :: jet_net_operation_deadline(stream.read_timeout_ms)
    jet_net_apply_tcp_deadlines(&stream.inner, "tcp read")?
    bytes := [U8].repeat(0, cap)
    loop {
        match &stream.inner.read(&bytes) {
            Ok(n) -> { &bytes.truncate(n); return Ok(^bytes) }
            Err(error) if error.kind() is .WouldBlock -> jet_net_scheduler_wait(&stream.inner, true, false, "tcp read")?
            Err(error) -> return Err(jet_net_io_error("tcp read", None, ^error))
        }
    }
}
