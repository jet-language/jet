#Unsafe("read real Linux resolver configuration or scoped macOS/Windows native resolver policy")
fn jet_net_dns_system_servers() -> [String] {
    jet_scheduler_world_reject_uncontrolled("network")
    out := [String]{}
    if target.selected_os() == "linux" {
        if read_to_string("/etc/resolv.conf") is Ok(text) -> &out.extend(jet_net_dns_parse_resolv_conf(&text))
    }
    // macOS scoped interface/VPN resolvers are not all represented by resolv.conf.
    if target.selected_os() == "macos" {
        if Command.new("scutil").arg("--dns").output() is Ok(output) -> &out.extend(jet_net_dns_parse_scutil(&String.from_utf8_lossy(&output.stdout)))
    }
    // Address values avoid localized ipconfig labels and preserve IPv4/IPv6 policy.
    if target.selected_family() == "windows" {
        if Command.new("powershell.exe").args(["-NoProfile", "-NonInteractive", "-Command", "Get-DNSClientServerAddress | ForEach-Object { $_.ServerAddresses }"]).output() is Ok(output) {
            &out.extend(jet_net_dns_parse_windows_addresses(&String.from_utf8_lossy(&output.stdout)))
        }
    }
    &out.sort()
    &out.dedup()
    ^out
}
