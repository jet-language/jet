#Unsafe("use real monotonic deadline across configured TXT resolver attempts")
fn jet_net_dns_txt(name: &String, ms: I64) -> [String] Err! {
    deadline :: Instant.now() + jet_net_timeout(ms)?
    servers :: jet_net_dns_system_servers()
    if servers.is_empty() -> return Err("host DNS configuration has no resolver for TXT lookup")
    last := ""
    loop server in servers {
        remaining :: deadline.saturating_duration_since(Instant.now())
        if remaining.is_zero() -> return Err("network timeout during DNS lookup for `{name}`")
        match jet_net_dns_txt_at(&server, name, min(remaining.as_millis(), I64.MAX as U128) as I64) {
            Ok(v) -> return Ok(^v)
            Err(e) -> last = ^e
        }
    }
    Err(^last)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:4130
fn jet_net_dns_txt_at(server: &String, name: &String, ms: I64) -> [String] Err! {
    out := [String]{}
    records :: jet_net_dns_query(server, name, 16, ms)?
    loop r in jet_net_dns_matching_records(&records, name, 16)? {
        data :: &r.packet[r.rdata_start..r.rdata_start + r.rdata_len]
        p := USize{0}
        s := ""
        loop p < data.len() {
            len :: data[p] as USize
            p = p + 1
            if p + len > data.len() -> return Err("network protocol error: truncated DNS TXT record")
            part :: from_utf8(&data[p..p + len]).map_err(fn(_) { "network protocol error: DNS TXT record is not valid UTF-8" })?
            &s.push_str(part)
            p = p + len
        }
        &out.push(^s)
    }
    Ok(^out)
}
