fn jet_net_sendfile(stream: &JetTCPStream, path: &String) -> I64 JetNetError! {
    if stream.closed || stream.write_shutdown -> return Err(jet_net_closed("tcp sendfile"))
    file := File.open(path.as_str()).map_err(fn(error) { jet_net_io_error("tcp sendfile open", Val(path.clone()), ^error) })?
    _deadline :: jet_net_operation_deadline(stream.write_timeout_ms)
