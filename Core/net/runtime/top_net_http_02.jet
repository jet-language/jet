fn jet_net_tcp_write_all_bytes(stream: &JetTCPStream, data: &[U8]) -> Unit JetNetError! {
    _deadline :: jet_net_operation_deadline(stream.write_timeout_ms)
    offset := USize{0}
    loop offset < data.len() {
        wrote :: jet_net_tcp_write_bytes_with_current_deadline(&stream, &data[offset..])? as USize
        if wrote == 0 -> return Err(JetNetError.ConnectionReset(jet_net_detail("tcp write all", None, None, "tcp write all failed: zero bytes written", None)))
        offset = offset + wrote
    }
    Ok(())
}
