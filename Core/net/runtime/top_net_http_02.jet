#Unsafe("perform actual framed DNS TCP exchange with bounded cancellable native read/write slices")
fn jet_net_dns_tcp_exchange(server_addr: SocketAddr, request: &[U8], deadline: Instant, name: String) -> [U8] Err! {
    stream := TcpStream.connect_timeout(&server_addr, jet_net_dns_remaining(deadline, name)?).map_err(fn(error) { "DNS TCP connect to `{server_addr}` failed: {error}" })?
    len :: U16.try_from(request.len()).map_err(fn(_) { "network protocol error: DNS request exceeds TCP frame" })?
    framed := [U8].with_capacity(request.len() + 2)
    &framed.extend_from_slice(&len.to_be_bytes())
    &framed.extend_from_slice(request)
    written := USize{0}
    loop written < framed.len() {
        stream.set_write_timeout(Val(jet_net_dns_io_slice(deadline, name)?)).map_err(fn(error) { "DNS TCP timeout setup failed: {error}" })?
        match &stream.write(&framed[written..]) {
            Ok(0) -> return Err("network protocol error: DNS TCP connection closed while sending query")
            Ok(n) -> written = written + n
            Err(error) if error.kind() is .TimedOut || error.kind() is .WouldBlock || error.kind() is .Interrupted -> continue
            Err(error) -> return Err("DNS TCP query send failed: {error}")
        }
    }
    prefix := [U8].repeat(0, 2)
    prefix_read := USize{0}
    loop prefix_read < prefix.len() {
        stream.set_read_timeout(Val(jet_net_dns_io_slice(deadline, name)?)).map_err(fn(error) { "DNS TCP timeout setup failed: {error}" })?
        match &stream.read(&prefix[prefix_read..]) {
            Ok(0) -> return Err("network protocol error: DNS TCP connection closed before response length")
            Ok(n) -> prefix_read = prefix_read + n
            Err(error) if error.kind() is .TimedOut || error.kind() is .WouldBlock || error.kind() is .Interrupted -> continue
            Err(error) -> return Err("DNS TCP response length failed: {error}")
        }
    }
    response_len :: U16.from_be_bytes(prefix) as USize
    if response_len < 12 || response_len > 65535 -> return Err("network protocol error: invalid DNS TCP response length")
    packet := [U8].repeat(0, response_len)
    read := USize{0}
    loop read < packet.len() {
        stream.set_read_timeout(Val(jet_net_dns_io_slice(deadline, name)?)).map_err(fn(error) { "DNS TCP timeout setup failed: {error}" })?
        match &stream.read(&packet[read..]) {
            Ok(0) -> return Err("network protocol error: DNS TCP response is truncated")
            Ok(n) -> read = read + n
            Err(error) if error.kind() is .TimedOut || error.kind() is .WouldBlock || error.kind() is .Interrupted -> continue
            Err(error) -> return Err("DNS TCP response truncated: {error}")
        }
    }
    Ok(^packet)
}
