#Unsafe("perform real Unix connection in native worker and await bounded result through scheduler")
fn jet_net_unix_connect(path: &String) -> JetUnixStream JetNetError! {
    if target.selected_family() != "unix" -> return Err(JetNetError.Unsupported(jet_net_detail("unix connect", Val(path.clone()), None, "unix sockets are not supported on this platform", None)))
    jet_scheduler_world_reject_uncontrolled("network")
    address :: path.clone()
    worker_address :: address.clone()
    (sender, receiver) :: mpsc.sync_channel(1)
    _ :: thread.spawn(fn() { _ :: sender.send(UnixStream.connect(^worker_address)) })
    inner :: loop {
        match receiver.try_recv() {
            Ok(Ok(stream)) -> break ^stream
            Ok(Err(error)) -> return Err(jet_net_io_error("unix connect", Val(^address), ^error))
            Err(.Empty) -> jet_net_scheduler_park("unix connect", 5)?
            Err(.Disconnected) -> return Err(JetNetError.Other(jet_net_detail("unix connect", Val(^address), None, "unix connect worker stopped without a result", None)))
        }
    }
    inner.set_nonblocking(true).map_err(fn(error) { jet_net_io_error("unix connect", Val(path.clone()), ^error) })?
    Ok(JetUnixStream{scheduler: jet_net_scheduler_handle(&inner), inner: ^inner, closed: false, read_shutdown: false, write_shutdown: false, read_timeout_ms: None, write_timeout_ms: None})
}
