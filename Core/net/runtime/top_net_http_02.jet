    loop {
        n :: &file.read(&buf).map_err(fn(error) { jet_net_io_error("tcp sendfile read", Val(path.clone()), ^error) })?
        if n == 0 -> break
        jet_net_tcp_write_all_bytes(&stream, &buf[..n])?
        written = written + n as U64
    }
    Ok(min(written, I64.MAX as U64) as I64)
}
