// GATE #4565: kernel primitive
#Unsafe("shutdown the actual TCP socket before recording directional shutdown state")
fn jet_net_tcp_shutdown(stream: &JetTCPStream, how: JetNetShutdown) -> Unit JetNetError! {
    if stream.closed -> return Err(jet_net_closed("tcp shutdown"))
    shutdown :: match how { .Read -> Shutdown.Read, .Write -> Shutdown.Write, .Both -> Shutdown.Both }
    stream.inner.shutdown(shutdown).map_err(fn(error) { jet_net_io_error("tcp shutdown", None, ^error) })?
    match how {
        .Read -> stream.read_shutdown = true
        .Write -> stream.write_shutdown = true
        .Both -> { stream.read_shutdown = true; stream.write_shutdown = true }
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs:2443
// GATE #4565: kernel primitive
#Unsafe("close actual TCP socket, preserving errors except already disconnected")
fn jet_net_tcp_close(stream: &JetTCPStream) -> Unit JetNetError! {
    if stream.closed -> return Ok(())
    match stream.inner.shutdown(Shutdown.Both) {
        Ok(_) -> {}
        Err(error) if error.kind() is .NotConnected -> {}
        Err(error) -> return Err(jet_net_io_error("tcp close", None, ^error))
    }
    stream.closed = true
    stream.read_shutdown = true
    stream.write_shutdown = true
    Ok(())
}
