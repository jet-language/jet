// GATE #4565: kernel primitive
#Unsafe("run real system address resolver in bounded native worker and wait with cancellation-aware slices")
fn jet_net_dns_system_lookup(name: &String, ms: I64) -> [SocketAddr] Err! {
    jet_scheduler_world_reject_uncontrolled("network")
    configured :: jet_net_timeout(ms)?
    timeout :: match jet_deadline_remaining_ms() {
        Val(remaining) if remaining <= 0 -> return Err("network timeout during DNS lookup for `{name}`")
        Val(remaining) -> configured.min(NativeDuration.from_millis(remaining as U64))
        None -> configured
    }
    owned_name :: name.clone()
    (tx, rx) :: mpsc.sync_channel(1)
    _ :: thread.spawn(fn() {
        result :: (owned_name.as_str(), 0).to_socket_addrs().map(fn(iter) { iter.collect<[SocketAddr]>() }).map_err(fn(error) { error.to_string() })
        _ :: tx.send(^result)
    })
    deadline :: Instant.now().checked_add(timeout).ok_or_else(fn() { "network timeout exceeds platform range" })?
    loop {
        slice :: jet_net_dns_io_slice(deadline, name)?
        match rx.recv_timeout(slice) {
            Ok(result) -> return result.map_err(fn(error) { "DNS lookup for `{name}` failed: {error}" })
            Err(.Timeout) -> continue
            Err(.Disconnected) -> return Err("DNS lookup worker for `{name}` failed")
        }
    }
}
