// D-ONCE-LAW1 / I9: one MIME parser and extension table for every tier.
use core.net.mime.[from_extension]

// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Mime.rs:2
#Derive(Clone, Debug, PartialEq)
pub struct JetMimeParts { pub top: String, pub sub: String, pub params: [(String, String)] }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Mime.rs:9
pub fn jet_mime_parse_parts(input: String) -> JetMimeParts Err! {
    parts := input.split(';')
    essence := parts.next().unwrap_or("").trim() // #4303
    (raw_top, raw_sub) :: essence.split_once('/').ok_or("MIME type needs `type/subtype`")?
    top_view := raw_top.trim() // #4303
    sub_view := raw_sub.trim() // #4303
    top :: top_view.to_ascii_lowercase()
    sub :: sub_view.to_ascii_lowercase()
    if top.is_empty() || sub.is_empty() || not jet_mime_token(top) || not jet_mime_token(sub) {
        return Err("invalid MIME type `{essence}`")
    }
    params := [(String, String)]{}
    loop raw_parameter in parts {
        parameter := raw_parameter.trim() // #4303
        if parameter.is_empty() -> continue
        (raw_key, raw_value) :: parameter.split_once('=').ok_or_else(() -> "invalid MIME parameter `{parameter}`")?
        key_view := raw_key.trim() // #4303
        key :: key_view.to_ascii_lowercase()
        if key.is_empty() || not jet_mime_token(key) {
            error_key := key.trim() // #4303
            return Err("invalid MIME parameter `{error_key}`")
        }
        value_view := raw_value.trim() // #4303
        unquoted := value_view.trim_matches('"') // #4303
        &params.push((key, unquoted.to_string()))
    }
    Ok(JetMimeParts{top, sub, params: ^params})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Mime.rs:38
pub fn jet_mime_essence(top: String, sub: String) -> String Never! { "{top}/{sub}" }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Mime.rs:42
pub fn jet_mime_param<P: IntoIterator<(@String, @String)>>(params: P, name: String) -> (@String)? Never! from params {
    folded :: name.to_ascii_lowercase()
    params.into_iter().find((key, _) -> key == folded).map((_, value) -> value)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Mime.rs:53
pub fn jet_mime_to_string<P: IntoIterator<(@String, @String)>>(top: String, sub: String, params: P) -> String Never! {
    output := jet_mime_essence(top, sub)
    loop (key, value) in params {
        &output.push_str("; ")
        &output.push_str(key)
        &output.push('=')
        &output.push_str(value)
    }
    ^output
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Mime.rs:68
fn jet_mime_token(value: String) -> Bool Never! {
    not value.is_empty() && value.bytes().all(byte ->
        byte.is_ascii_alphanumeric() || byte == U8{33} || byte == U8{35} || byte == U8{36} ||
        byte == U8{38} || byte == U8{45} || byte == U8{94} || byte == U8{95} || byte == U8{46} || byte == U8{43})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Mime.rs:79
// Existing canonical extension table has all 21 Rust entries and the same ASCII folding/dot stripping.
pub fn jet_mime_from_extension(ext: String) -> String? Never! { from_extension(ext) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Mime.rs:106
pub fn jet_extension_from_mime(mime: String) -> String? Never! {
    folded :: mime.to_ascii_lowercase()
    essence := folded.split(';').next().unwrap_or("").trim() // #4303
    match essence {
        "text/html" -> Val("html")
        "text/css" -> Val("css")
        "text/csv" -> Val("csv")
        "text/plain" -> Val("txt")
        "text/markdown" -> Val("md")
        "application/json" -> Val("json")
        "text/javascript" | "application/javascript" -> Val("js")
        "application/wasm" -> Val("wasm")
        "application/pdf" -> Val("pdf")
        "image/png" -> Val("png")
        "image/jpeg" -> Val("jpg")
        "image/gif" -> Val("gif")
        "image/svg+xml" -> Val("svg")
        "image/webp" -> Val("webp")
        "image/x-icon" -> Val("ico")
        "audio/mpeg" -> Val("mp3")
        "video/mp4" -> Val("mp4")
        "application/xml" | "text/xml" -> Val("xml")
        "application/zip" -> Val("zip")
        "application/gzip" -> Val("gz")
        "application/x-tar" -> Val("tar")
        _ -> None
    }
}

