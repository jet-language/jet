        .Ok(value) -> ^value
        .Err(.Status(_,value)) -> ^value
        .Err(error) -> return Err(policy.foundation_fetch_http_error(url,error.to_string()))
    }
    status :: response.status()
    content_length := None
    if response.header("Content-Length") == .Val(value) {
        if U64.from_str(value) == {
            .Ok(length) -> content_length = Val(length)
            .Err(_) -> return Err(policy.foundation_fetch_http_error(url,"invalid Content-Length"))
        }
    }
    location :: response.header("Location").map(fn(value) { value.to_string() })
    Ok(StreamResponse{status_value:status,content_length_value:content_length,location_value:^location,reader:Box.new(response.into_reader())})
}
// Rust: crates/jet-net/src/lib.rs:802
pub fn get_stream_follow_redirects(url: String,timeout: Duration,max_redirects: Int) -> StreamResponse FoundationFetchError! {
    get_stream_follow_redirects_with(url,timeout,max_redirects,fn(current,location) {
        policy.foundation_fetch_resolve_redirect(current,location).map_err(fn(error) { error.to_string() })
    })
}
// Rust: crates/jet-net/src/lib.rs:818
pub fn get_stream_follow_redirects_with(url: String,timeout: Duration,max_redirects: Int,
    redirect: fn(String,String) -> String Err!) -> StreamResponse FoundationFetchError! {
    current := url.clone()
    loop hop in 0..=max_redirects {
        response :: get_stream_with_timeout(current,timeout)?
        if response.status() < U16{300} || response.status() >= U16{400} -> return Ok(^response)
        location :: response.location().ok_or_else(fn() { policy.foundation_fetch_http_error(current,"redirect response has no Location header") })?
        next :: redirect(current,location).map_err(fn(detail) { policy.foundation_fetch_http_error(current,^detail) })?
        current = ^next
    }
    Err(policy.foundation_fetch_http_error(url,"too many redirects (limit {max_redirects})"))
}
// Rust: crates/jet-net/src/lib.rs:854
pub fn fetch_bounded_with_redirect_policy(url: String,timeout: Duration,max_redirects: Int,limit: U64,
    redirect: fn(String,String) -> String Err!) -> [U8] FoundationFetchError! {
    response :: get_stream_follow_redirects_with(url,timeout,max_redirects,redirect)?
    if response.status() < U16{200} || response.status() >= U16{300} -> return Err(policy.foundation_fetch_http_error(url,"URL returned HTTP {response.status()}"))
    content_length :: response.content_length()
    if content_length == .Val(length) {
        if length > limit -> return Err(policy.foundation_fetch_http_error(url,"response exceeds its size bound"))
    }
    body := [U8]{}
    response.take(limit.saturating_add(U64{1})).read_to_end(&body)
        .map_err(fn(error) { policy.foundation_fetch_http_error(url,"could not read response: {error}") })?
    if (body.len() as U64) > limit -> return Err(policy.foundation_fetch_http_error(url,"response exceeds its size bound"))
    if content_length == .Val(length) {
        if length != (body.len() as U64) -> return Err(policy.foundation_fetch_http_error(url,"response Content-Length disagrees"))
    }
    Ok(^body)
}
