// Rust: crates/jet-net/src/lib.rs:379
fn same_directory(left: Metadata, right: Metadata) -> Bool Never! {
    left.is_dir() && right.is_dir() && left.dev() == right.dev() && left.ino() == right.ino()
}
// Rust: crates/jet-net/src/lib.rs:383
fn unix_open_no_follow(path: OSPath) -> File IOError! {
    OpenOptions.new().read(true).custom_flags(O_NOFOLLOW() | O_CLOEXEC()).open(path)
}
// Rust: crates/jet-net/src/lib.rs:390
fn unix_open_root(path: OSPath) -> File IOError! {
    OpenOptions.new().read(true).custom_flags(O_DIRECTORY() | O_NOFOLLOW() | O_CLOEXEC()).open(path)
}
// Rust: crates/jet-net/src/lib.rs:397
fn unix_open_relative(root: File, relative: OSPath) -> File IOError! {
    components :: relative.components().collect()
    if components.is_empty() -> return root.try_clone()
    current := root.try_clone()?
    loop index in 0..<components.len() {
        if components[index] == .Normal(name) {
            // GATE #4494: CString owns native component bytes; NUL is rejected.
            name :: CString.new(name.as_bytes()).map_err(fn(_) { IOError.new(ErrorKind.InvalidInput,"file authority path contains NUL") })?
            last :: index + 1 == components.len()
            flags := O_NOFOLLOW() | O_CLOEXEC()
            if !last -> flags = flags | O_DIRECTORY()
            fd :: #Unsafe("openat borrows held directory and NUL-terminated component") { unix_native.openat(current.as_raw_fd(),name.as_ptr(),flags,U32{0}) }
            if fd < I32{0} -> return Err(IOError.last_os_error())
            opened :: #Unsafe("successful openat transfers one owned native descriptor") { File.from_raw_fd(fd) }
            if last -> return Ok(^opened)
            current = ^opened
        } else {
            return Err(IOError.new(ErrorKind.InvalidInput,"file authority path has unsupported components"))
        }
    }
    Err(IOError.new(ErrorKind.InvalidInput,"file authority path is empty"))
}
// Rust: crates/jet-net/src/lib.rs:440
fn unix_is_single_link_file(file: File) -> Bool IOError! { Ok(file.metadata()?.nlink() == U64{1}) }

