// Rust: crates/jet-net/src/lib.rs:213
pub fn fetch_with_root_timeout_and_http(url: String, timeout: Duration, base_dir: OSPath,
    http_stream: fn(String, Duration) -> StreamResponse FoundationFetchError!) -> [U8] FoundationFetchError! {
    if url.strip_prefix("file://") == .Val(path) {
        file :: open_scoped_file(path, base_dir)?
        if read_limited(^file, MAX_FETCH_BYTES) == {
            .Ok(bytes) -> return Ok(^bytes)
            .Err(error) -> return Err(FoundationFetchError.IO(error.to_string()))
        }
    } else if url.starts_with("http://") || url.starts_with("https://") {
        response :: http_stream(url, timeout)?
        if response.content_length() == .Val(length) {
            if length > U64{MAX_FETCH_BYTES} -> return Err(policy.foundation_fetch_http_error(url, "response exceeds its size bound"))
        }
        if read_limited(^response, MAX_FETCH_BYTES) == {
            .Ok(bytes) -> return Ok(^bytes)
            .Err(error) -> return Err(policy.foundation_fetch_http_error(url, error.to_string()))
        }
    }
    Err(policy.foundation_fetch_scheme_error(url))
}

// Rust: crates/jet-net/src/lib.rs:243
fn open_scoped_file(raw_path: String, base_dir: OSPath) -> File FoundationFetchError! {
    // GATE #4483: source cfg arms use selected target, not host facts.
    os :: target.selected_os()
    if os == .Linux || os == .Android || os == .MacOS || os == .IOS {
        operation :: fn() -> File IOError! {
            if raw_path == "/dev/null" -> return unix_open_no_follow(OSPath.from_text(raw_path))
            before :: fs.symlink_metadata(base_dir)?
            if before.file_type().is_symlink() || !before.is_dir() -> return Err(IOError.new(ErrorKind.Other, "compile-time source directory must be a real directory"))
            root :: fs.canonicalize(base_dir)?
            after :: fs.symlink_metadata(base_dir)?
            if after.file_type().is_symlink() || !after.is_dir() || !same_directory(before,after) {
                return Err(IOError.new(ErrorKind.Other, "compile-time source directory changed during resolution"))
            }
            root_handle :: unix_open_root(root)?
            opened_root :: root_handle.metadata()?
            if !same_directory(after,opened_root) -> return Err(IOError.new(ErrorKind.Other,"compile-time source directory changed during resolution"))
            requested := OSPath.from_text(raw_path)
            if !requested.is_absolute() -> requested = root.join(requested)
            canonical :: fs.canonicalize(requested)?
            if !canonical.starts_with(root) -> return Err(IOError.new(ErrorKind.Other,"file URL resolves outside the compile-time source directory"))
            relative :: canonical.strip_prefix(root).map_err(fn(_) { IOError.new(ErrorKind.Other,"file URL resolves outside the compile-time source directory") })?
            file :: unix_open_relative(root_handle,relative)?
            metadata :: file.metadata()?
            if !metadata.is_file() || !unix_is_single_link_file(file)? {
                return Err(IOError.new(ErrorKind.Other,"file URL must name a regular, unshared file"))
            }
            Ok(^file)
        }()
        if operation == { .Ok(file) -> return Ok(^file); .Err(error) -> return Err(FoundationFetchError.IO(error.to_string())) }
    }
    if target.selected_family() == .Windows {
        operation :: fn() -> File IOError! {
            root :: fs.canonicalize(base_dir)?
            requested := OSPath.from_text(raw_path)
            if !requested.is_absolute() -> requested = root.join(requested)
            windows_open_file(root, requested)
        }()
        if operation == { .Ok(file) -> return Ok(^file); .Err(error) -> return Err(FoundationFetchError.IO(error.to_string())) }
    }
    Err(FoundationFetchError.IO("descriptor-relative no-follow file access is unavailable on this platform"))
}

// Rust: crates/jet-net/src/lib.rs:364-373
fn O_CLOEXEC() -> I32 Never! {
    if target.selected_os() == .Linux || target.selected_os() == .Android -> return I32{0o2000000}
    I32{0x01000000}
}
fn O_DIRECTORY() -> I32 Never! {
    if target.selected_os() == .Linux || target.selected_os() == .Android -> return I32{0o200000}
    I32{0x00100000}
}
fn O_NOFOLLOW() -> I32 Never! {
    if target.selected_os() == .Linux || target.selected_os() == .Android -> return I32{0o400000}
    I32{0x0100}
}
