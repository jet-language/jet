    buffer := [U16].filled(Int.from_u32(needed) + 1,U16{0})
    written :: #Unsafe("Win32 writes at most the retained wide buffer capacity") {
        win32.get_final_path_name_by_handle_w(file.as_raw_handle(),buffers.wide_mut_ptr(&buffer,0),buffer.len() as U32,U32{0})
    }
    if written == U32{0} || Int.from_u32(written) >= buffer.len() -> return Err(IOError.last_os_error())
    buffer.truncate(Int.from_u32(written))
