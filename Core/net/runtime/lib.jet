// Rust: crates/jet-net/src/lib.rs:539
fn normalized_final_path(path: String) -> String Never! {
    native := path.replace("/","\\")
    native = native.trim_start_matches("\\\\?\\").to_string() // #4303
    native = native.trim_end_matches([Char]{'\\','/'}).to_string() // #4303
    native.to_ascii_lowercase()
}
// Rust: crates/jet-net/src/lib.rs:546
fn is_beneath(root: String,candidate: String) -> Bool Never! {
    if candidate == root -> return true
    if candidate.strip_prefix(root) == .Val(tail) -> return tail.starts_with("\\")
    false
}
// Rust: crates/jet-net/src/lib.rs:553
fn windows_open_file(root: OSPath, requested: OSPath) -> File IOError! {
    root_handle :: windows_open_root(root)?
    root_final :: normalized_final_path(final_path(root_handle)?)
    expected_root :: normalized_final_path(root.to_string_lossy().into_owned())
    if root_final != expected_root -> return Err(IOError.new(ErrorKind.PermissionDenied,"compile-time source directory changed during resolution"))
    file :: OpenOptions.new().read(true).custom_flags(FILE_FLAG_OPEN_REPARSE_POINT).open(requested)?
    if !file.metadata()?.is_file() || is_reparse(requested)? || !windows_is_single_link_file(file)? {
        return Err(IOError.new(ErrorKind.PermissionDenied,"opened object is not a regular, unshared non-reparse file"))
    }
    file_final :: normalized_final_path(final_path(file)?)
    if !is_beneath(root_final,file_final) -> return Err(IOError.new(ErrorKind.PermissionDenied,"opened file escapes the compile-time source directory"))
    Ok(^file)
}
// Rust: crates/jet-net/src/lib.rs:586
fn windows_open_root(path: OSPath) -> File IOError! {
    if is_reparse(path)? -> return Err(IOError.new(ErrorKind.PermissionDenied,"compile-time source directory is a reparse point"))
    root :: OpenOptions.new().read(true).access_mode(GENERIC_READ).share_mode(FILE_SHARE_READ | FILE_SHARE_WRITE)
        .custom_flags(FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT).open(path)?
    if is_reparse(path)? || !root.metadata()?.is_dir() -> return Err(IOError.new(ErrorKind.PermissionDenied,"compile-time source directory is not a real directory"))
    Ok(^root)
}

// Rust: crates/jet-net/src/lib.rs:609
fn comptime_http_stream(url: String,timeout: Duration) -> StreamResponse FoundationFetchError! {
    // Shared parser is exact; this entry does not add a scheme precheck.
    response :: if COMPTIME_HTTP_AGENT.get(url).timeout(timeout).set("Accept-Encoding","identity").call() == {
        .Ok(value) -> ^value
        .Err(.Status(_,value)) -> ^value
        .Err(error) -> return Err(policy.foundation_fetch_http_error(url,error.to_string()))
    }
    status :: response.status()
    content_length := None
    if response.header("Content-Length") == .Val(value) {
        if U64.from_str(value) == {
            .Ok(length) -> content_length = Val(length)
            .Err(_) -> return Err(policy.foundation_fetch_http_error(url,"invalid Content-Length"))
        }
    }
    location :: response.header("Location").map(fn(value) { value.to_string() })
    Ok(StreamResponse{status_value:status,content_length_value:content_length,location_value:^location,reader:Box.new(response.into_reader())})
}
