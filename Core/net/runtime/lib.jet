fn restricted_resolver(netloc: String) -> [SocketAddr] IOError! {
    addresses :: netloc.to_socket_addrs()?.collect()
    if !addresses_are_public(addresses) -> return Err(IOError.new(ErrorKind.PermissionDenied,"compile-time network destination is not public"))
    Ok(^addresses)
}
// Rust: crates/jet-net/src/lib.rs:654
pub fn resolve_public_addresses(host: String,port: U16) -> [SocketAddr] Err! {
    host := host
    if host.strip_prefix("[") == .Val(rest) {
        if rest.strip_suffix("]") == .Val(unbracketed) -> host = unbracketed.to_string()
    }
    endpoint := "{host}:{port}"
    if host.contains(":") -> endpoint = "[{host}]:{port}"
    addresses :: endpoint.to_socket_addrs().map_err(fn(error) { "could not resolve provider destination: {error}" })?.collect()
    if !addresses_are_public(addresses) -> return Err("provider destination resolves to a non-public address")
    Ok(^addresses)
}
// Rust: crates/jet-net/src/lib.rs:674
pub fn addresses_are_public(addresses: [SocketAddr]) -> Bool Never! {
    if addresses.is_empty() -> return false
    loop address in addresses { if !is_public_ip(address.ip()) -> return false }
    true
}
// Rust: crates/jet-net/src/lib.rs:681
pub fn is_public_ip(ip: IpAddr) -> Bool Never! {
    if ip == {
        .V4(value) -> {
            octets :: value.octets()
            a :: Int.from_u8(octets[0]); b :: Int.from_u8(octets[1]); c :: Int.from_u8(octets[2])
            !(a == 0 || a == 10 || (a == 100 && (b & 192) == 64) || a == 127
                || (a == 169 && b == 254) || (a == 172 && b >= 16 && b <= 31)
                || (a == 192 && b == 0 && c == 0) || (a == 192 && b == 0 && c == 2)
                || (a == 192 && b == 168) || (a == 198 && b >= 18 && b <= 19)
                || (a == 198 && b == 51 && c == 100) || (a == 203 && b == 0 && c == 113) || a >= 224)
        }
        .V6(value) -> {
            if value.to_ipv4_mapped() == .Val(v4) -> return is_public_ip(IpAddr.V4(v4))
            segments :: value.segments()
            first :: Int.from_u16(segments[0]); second :: Int.from_u16(segments[1])
            (first & 0xe000) == 0x2000 && !value.is_unspecified() && !value.is_loopback() && !value.is_multicast()
                && (first & 0xfe00) != 0xfc00 && (first & 0xffc0) != 0xfe80 && !(first == 0x2001 && second == 0x0db8)
        }
    }
}
// Rust: crates/jet-net/src/lib.rs:715
pub fn read_limited<R: Read>(reader: ^R,limit: Int) -> [U8] IOError! {
    bytes := [U8]{}
    // GATE #4483: saturating usize limit+1; take actually bounds native reads.
    count :: (limit + 1).min(Int.from_u64(target.usize_max())) as U64
    reader.by_ref().take(count).read_to_end(&bytes)?
    if bytes.len() > limit -> return Err(IOError.new(ErrorKind.InvalidData,"fetch response exceeds {limit} bytes")) // GATE #4409
    Ok(^bytes)
}
