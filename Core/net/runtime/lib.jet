    result :: #Unsafe("Win32 fills a C-layout FileStandardInfo before successful assume_init") {
        win32.get_file_information_by_handle_ex(file.as_raw_handle(),I32{1},information.as_mut_ptr().cast(),mem.size_of<FileStandardInfo>() as U32)
