use core.net.runtime.kernel_net_pure.[jet_net_pure_parse_ip, jet_net_pure_socket_to_string]
use std.net.SocketAddr

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DNSResolverPolicy.rs:1
fn jet_net_dns_socket_addr(host: String) -> String? {
    host := host.trim().trim_matches(fn(c) { c == '[' || c == ']' }) // #4303
    jet_net_pure_parse_ip(host).ok().map(fn(ip) { jet_net_pure_socket_to_string(SocketAddr.new(ip, U16{53})) })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DNSResolverPolicy.rs:8
fn jet_net_dns_parse_resolv_conf(text: String) -> [String] {
    text.lines().filter_map(fn(line) -> String? {
        parts := line.split('#').next()?.split_whitespace()
        (parts.next() == Val("nameserver")).then(fn() { parts.next() })
            .flatten().and_then(jet_net_dns_socket_addr)
    }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DNSResolverPolicy.rs:20
fn jet_net_dns_parse_scutil(text: String) -> [String] {
    text.lines().filter_map(fn(line) -> String? {
        (label, value) :: line.trim().split_once(':')?
        label := label.trim() // #4303
        index :: label.strip_prefix("nameserver[")?.strip_suffix(']')?
        (!index.is_empty() && index.bytes().all(fn(byte) { byte.is_ascii_digit() }))
            .then(fn() { jet_net_dns_socket_addr(value) }).flatten()
    }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DNSResolverPolicy.rs:33
fn jet_net_dns_parse_windows_addresses(text: String) -> [String] {
    text.lines().flat_map(fn(line) { line.split(fn(c: Char) { c.is_whitespace() || c == ',' || c == '{' || c == '}' }) })
        .filter_map(jet_net_dns_socket_addr).collect()
}

