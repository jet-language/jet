// core.net.url — RFC 3986 URLs and component escaping.
//
// URL structure, authority validation, dot-segment removal, query ordering,
// and the percent codecs are deterministic Jet code. The value is intentionally
// kept as the existing `URL` carrier used by the Core registry.
//
// Non-ASCII host labels are lowercased byte-wise and Punycode-encoded
// (RFC 3492, `xn--` prefix); no IDNA mapping table is applied. An explicit
// authority port is remembered so rendering keeps it even when it equals the
// scheme default; `port` itself follows the default-port convention.
use core.net.mime.[MIME]
#Error
pub enum URLError {
    Syntax
    Percent
}

pub struct URL {
    pub scheme: String
    user_text: String
    password_text: String
    pub host: String
    pub port: Int
    port_explicit: Bool
    pub path: String
    pub query: String
    pub fragment: String
    pub raw: String
}

impl URL {
    /// Render the URL; an explicit authority port is kept.
    pub fn to_string(self) -> String Never! { unparse(self) }

    /// The decoded user name, or empty when absent.
    pub fn username(self) -> String Never! { ~self.user_text }

    /// The decoded password, or empty when absent.
    pub fn password(self) -> String Never! { ~self.password_text }

    /// `user:password`, `user`, or empty.
    pub fn userinfo(self) -> String Never! { userinfo_text(self) }

    /// `userinfo@host:port` with the port only when it was written explicitly.
    pub fn authority(self) -> String Never! {
        if self.host.bytes().len() == 0 -> return ""
        out := ""
        info :: userinfo_text(self)
        if info.bytes().len() > 0 -> out = "{info}@"
        out = "{out}{render_host(self.host)}"
        if self.port_explicit && self.port >= 0 -> out = "{out}:{self.port}"
        out
    }

    /// The registered default port for the scheme, when it has one.
    pub fn default_port(self) -> Int? Never! {
        port :: scheme_default_port(self.scheme)
        if port < 0 -> return None
        Val(port)
    }

    /// Decoded, non-empty path segments.
    pub fn path_segments(self) -> [String] Never! {
        raw :: self.path.bytes()
        out := [String]{}
        start := 0
        loop i in 0..<(raw.len() + 1) {
            if i == raw.len() || raw[i] == (U8{47}) {
                if i > start -> &out.push(slice(raw, start, i))
                start = i + 1
            }
        }
        out
    }

    /// Decoded repeated query pairs, in order.
    pub fn query_pairs(self) -> [[String]] Never! { parse_qsl(self.query) ?? [[String]]{} }

    /// A copy with a lowercase scheme, ASCII host, and dot segments removed.
    pub fn normalize(self) -> URL Never! {
        scheme :: ascii_lower(self.scheme)
        path := self.path
        if scheme != "data" -> path = normalize_path(self.path, self.host.bytes().len() > 0 || starts(self.path, "/"))
        URL{
            scheme: scheme,
            user_text: self.user_text,
            password_text: self.password_text,
            host: host_to_ascii(ascii_lower(self.host)),
            port: self.port,
            port_explicit: self.port_explicit,
            path: path,
            query: self.query,
            fragment: self.fragment,
            raw: "",
        }
    }

    /// Resolve a relative reference against this URL.
    pub fn join(self, relative: String) -> URL URLError! { join_url(self, relative) }
}

fn userinfo_text(url: URL) -> String Never! {
    if url.password_text.bytes().len() == 0 -> return ~url.user_text
    "{url.user_text}:{url.password_text}"
}


pub fn parse(text: String) -> URL URLError! {
    input :: trim_ascii(text)
    raw :: input.bytes()
    if raw.len() == 0 -> return Err(URLError.Syntax)
    colon := scheme_colon(raw)
    if colon <= 0 -> return Err(URLError.Syntax)
    scheme :: ascii_lower(slice(raw, 0, colon))
    if !valid_scheme(scheme) -> return Err(URLError.Syntax)

    rest_i := colon + 1
    user := ""
    password := ""
    host := ""
    port := scheme_default_port(scheme)
    port_explicit := false

    if rest_i + 1 < raw.len() && raw[rest_i] == (U8{47}) && raw[rest_i + 1] == (U8{47}) {
        rest_i = rest_i + 2
        auth_end := rest_i
        loop auth_end < raw.len() {
            n :: Int.from_u8(raw[auth_end])
            if n == 47 || n == 63 || n == 35 -> break
            auth_end = auth_end + 1
        }
        authority :: slice(raw, rest_i, auth_end)
        if authority.bytes().len() == 0 -> return Err(URLError.Syntax)
        at := last_index(authority.bytes(), 64)
        hostport := ~authority
        if at >= 0 {
            info :: slice(authority.bytes(), 0, at)
            sep := index_of(info.bytes(), 58)
            if sep >= 0 {
                user = percent_decode(slice(info.bytes(), 0, sep)) ?? return Err(URLError.Percent)
                password = percent_decode(slice(info.bytes(), sep + 1, info.bytes().len())) ?? return Err(URLError.Percent)
            } else {
                user = percent_decode(info) ?? return Err(URLError.Percent)
            }
            hostport = slice(authority.bytes(), at + 1, authority.bytes().len())
        }
        if hostport.bytes().len() == 0 -> return Err(URLError.Syntax)
        hp :: hostport.bytes()
        if hp[0] == (U8{91}) {
            rb := index_of(hp, 93)
            if rb < 0 -> return Err(URLError.Syntax)
            host = ascii_lower(slice(hp, 1, rb))
            if rb + 1 < hp.len() {
                if hp[rb + 1] != (U8{58}) -> return Err(URLError.Syntax)
                port = parse_port(slice(hp, rb + 2, hp.len())) ?? return Err(URLError.Syntax)
                port_explicit = true
            }
        } else {
            col := last_index(hp, 58)
            if col >= 0 {
                if index_of(hp, 58) != col -> return Err(URLError.Syntax)
                host = host_to_ascii(ascii_lower(slice(hp, 0, col)))
                port = parse_port(slice(hp, col + 1, hp.len())) ?? return Err(URLError.Syntax)
                port_explicit = true
            } else {
                host = host_to_ascii(ascii_lower(hostport))
            }
        }
        if !valid_url_host(host) -> return Err(URLError.Syntax)
        rest_i = auth_end
    } else if scheme == "http" || scheme == "https" || scheme == "ws" || scheme == "wss" {
        return Err(URLError.Syntax)
    }

    hash := raw.len()
    loop i in rest_i..<raw.len() {
        if raw[i] == (U8{35}) {
            hash = i
            break
        }
    }
    qpos := hash
    loop i in rest_i..<hash {
        if raw[i] == (U8{63}) {
            qpos = i
            break
        }
    }
    path_raw :: slice(raw, rest_i, qpos)
    if !valid_percent(path_raw) -> return Err(URLError.Percent)
    path := if scheme == "data" -> path_raw else -> percent_decode(path_raw) ?? return Err(URLError.Percent)
    path = if scheme == "data" -> path else -> normalize_path(path, host.bytes().len() > 0)
    if path.bytes().len() == 0 && host.bytes().len() > 0 -> path = "/"
    query := ""
    if qpos < hash -> query = escape_query(slice(raw, qpos + 1, hash))
    fragment := ""
    if hash < raw.len() -> fragment = percent_decode(slice(raw, hash + 1, raw.len())) ?? return Err(URLError.Percent)
    Ok(URL{scheme: scheme, user_text: user, password_text: password, host: host, port: port, port_explicit: port_explicit, path: path, query: query, fragment: fragment, raw: input})
}

pub fn from_parts(scheme: String, host: String, path: String, query: [[String]], fragment: String) -> URL URLError! {
    scheme_l :: ascii_lower(scheme)
    if !valid_scheme(scheme_l) -> return Err(URLError.Syntax)
    if host.bytes().len() == 0 && (scheme_l == "http" || scheme_l == "https" || scheme_l == "ws" || scheme_l == "wss") {
        return Err(URLError.Syntax)
    }
    if host.bytes().len() > 0 && !valid_url_host(ascii_lower(host)) -> return Err(URLError.Syntax)
    p := path
    if host.bytes().len() > 0 && p.bytes().len() == 0 -> p = "/"
    if host.bytes().len() > 0 && p.bytes().len() > 0 && p.bytes()[0] != (U8{47}) -> p = "/{p}"
    q :: encode_query(query)
    raw := "{scheme_l}:"
    if host.bytes().len() > 0 {
        rendered_host := ascii_lower(host)
        if contains_byte(host, 58) && !starts(host, "[") -> rendered_host = "[{rendered_host}]"
        raw = "{raw}//{rendered_host}"
    }
    raw = "{raw}{p}"
    if q.bytes().len() > 0 -> raw = "{raw}?{q}"
    if fragment.bytes().len() > 0 -> raw = "{raw}#{percent_encode(fragment)}"
    parse(raw)
}

pub fn file(path: String) -> URL Never! {
    p := path
    if p.bytes().len() == 0 -> p = "/"
    if p.bytes()[0] != (U8{47}) -> p = "/{p}"
    URL{scheme: "file", user_text: "", password_text: "", host: "", port: -1, port_explicit: false, path: normalize_path(p, true), query: "", fragment: "", raw: ""}
}

pub fn data(mime: MIME, payload: String) -> URL Never! {
    encoded :: percent_encode(payload)
    URL{scheme: "data", user_text: "", password_text: "", host: "", port: -1, port_explicit: false, path: "{mime.top}/{mime.sub},{encoded}", query: "", fragment: "", raw: ""}
}

fn scheme_default_port(scheme: String) -> Int Never! {
    if scheme == {
        "http" | "ws" -> 80
        "https" | "wss" -> 443
        "ftp" -> 21
        "ssh" -> 22
        "smtp" -> 25
        "pop3" -> 110
        "imap" -> 143
        else -> -1
    }
}

pub fn query(pairs: [[String]]) -> String Never! { encode_query(pairs) }

fn encode_query(pairs: [[String]]) -> String Never! {
    out := ""
    first := true
    loop row in pairs {
        if row.len() == 0 -> next
        key :: percent_encode(row[0])
        value := ""
        if row.len() > 1 -> value = percent_encode(row[1])
        piece :: "{key}={value}"
        if first {
            out = piece
            first = false
        } else {
            out = "{out}&{piece}"
        }
    }
    out
}

pub fn percent_encode(text: String) -> String Never! {
    encode_component(text, false, false)
}

pub fn percent_decode(text: String) -> String URLError! {
    raw :: text.bytes()
    out := [U8]{}
    i := 0
    loop {
        if i >= raw.len() -> break
        if raw[i] == (U8{37}) {
            if i + 2 >= raw.len() -> return Err(URLError.Percent)
            hi :: hex_value(raw[i + 1]) ?? return Err(URLError.Percent)
            lo :: hex_value(raw[i + 2]) ?? return Err(URLError.Percent)
            &out.push(U8{hi * 16 + lo})
            i = i + 3
        } else {
            &out.push(raw[i])
            i = i + 1
        }
    }
    String.from_bytes(out) ?? return Err(URLError.Percent)
}

pub fn geturl(url: URL) -> String Never! { unparse(url) }

pub fn unparse(url: URL) -> String Never! {
    scheme :: ascii_lower(url.scheme)
    authority := ""
    if url.host.bytes().len() > 0 {
        host :: render_host(url.host)
        authority = ~host
        if url.user_text.bytes().len() > 0 {
            authority = percent_encode(url.user_text)
            if url.password_text.bytes().len() > 0 -> authority = "{authority}:{percent_encode(url.password_text)}"
            authority = "{authority}@{host}"
        }
        if url.port >= 0 && (url.port_explicit || url.port != scheme_default_port(scheme)) -> authority = "{authority}:{url.port}"
    }
    path := url.path
    if authority.bytes().len() > 0 && path.bytes().len() == 0 -> path = "/"
    path_text :: if scheme == "data" -> path else -> encode_component(path, true, false)
    query_text := ""
    if url.query.bytes().len() > 0 -> query_text = "?{url.query}"
    fragment_text := ""
    if url.fragment.bytes().len() > 0 -> fragment_text = "#{percent_encode(url.fragment)}"
    if authority.bytes().len() > 0 -> return "{scheme}://{authority}{path_text}{query_text}{fragment_text}"
    if scheme == "file" -> return "file://{path_text}{query_text}{fragment_text}"
    return "{scheme}:{path_text}{query_text}{fragment_text}"
}

pub fn urljoin(base: String, rel: String) -> String URLError! {
    parsed :: parse(base)
    joined :: join_url(parsed, rel)
    unparse(joined)
}

fn join_url(parsed: URL, rel: String) -> URL URLError! {
    if rel.bytes().len() == 0 -> return with_parts(parsed, parsed.path, parsed.query, parsed.fragment)
    if has_scheme(rel) -> return parse(rel)
    if starts(rel, "//") -> return parse("{parsed.scheme}:{rel}")
    if rel.bytes()[0] == (U8{35}) {
        fragment :: percent_decode(slice(rel.bytes(), 1, rel.bytes().len())) ?? return Err(URLError.Percent)
        return with_parts(parsed, parsed.path, parsed.query, fragment)
    }
    if rel.bytes()[0] == (U8{63}) {
        query :: slice(rel.bytes(), 1, rel.bytes().len())
        if !valid_percent(query) -> return Err(URLError.Percent)
        return with_parts(parsed, parsed.path, escape_query(query), "")
    }
    hash := index_of(rel.bytes(), 35)
    rel_no_frag := if hash >= 0 -> slice(rel.bytes(), 0, hash) else -> rel
    frag_raw := if hash >= 0 -> slice(rel.bytes(), hash + 1, rel.bytes().len()) else -> ""
    frag :: percent_decode(frag_raw) ?? return Err(URLError.Percent)
    qpos := index_of(rel_no_frag.bytes(), 63)
    rel_path_raw := if qpos >= 0 -> slice(rel_no_frag.bytes(), 0, qpos) else -> rel_no_frag
    rel_path :: percent_decode(rel_path_raw) ?? return Err(URLError.Percent)
    rel_query := if qpos >= 0 -> slice(rel_no_frag.bytes(), qpos + 1, rel_no_frag.bytes().len()) else -> ""
    if !valid_percent(rel_query) -> return Err(URLError.Percent)
    path := parsed.path
    query := parsed.query
    if rel_path.bytes().len() == 0 {
        if qpos >= 0 -> query = escape_query(rel_query)
    } else if rel_path.bytes()[0] == (U8{47}) {
        path = normalize_path(rel_path, parsed.host.bytes().len() > 0)
        query = escape_query(rel_query)
    } else {
        dir :: dirname_url(parsed.path)
        path = normalize_path("{dir}{rel_path}", parsed.host.bytes().len() > 0)
        query = escape_query(rel_query)
    }
    with_parts(parsed, path, query, frag)
}

fn with_parts(url: URL, path: String, query: String, fragment: String) -> URL Never! {
    URL{
        scheme: url.scheme,
        user_text: url.user_text,
        password_text: url.password_text,
        host: url.host,
        port: url.port,
        port_explicit: url.port_explicit,
        path: path,
        query: query,
        fragment: fragment,
        raw: "",
    }
}

fn render_host(host: String) -> String Never! {
    if contains_byte(host, 58) && !starts(host, "[") -> return "[{host}]"
    ~host
}

// Percent-encode query bytes that RFC 3986 does not allow unescaped; existing
// `%XX` escapes, sub-delimiters, `:`, `@`, `/`, and `?` are kept.
fn escape_query(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        if unreserved(b) || n == 37 || n == 33 || n == 36 || (n >= 38 && n <= 44) || n == 47 || n == 58 || n == 59 || n == 61 || n == 63 || n == 64 {
            &out.push(b)
        } else {
            &out.push(U8{37})
            &out.push(hex_nibble(n /% 16))
            &out.push(hex_nibble(n %% 16))
        }
    }
    String.from_bytes(out) ?? ""
}

// Lowercase-ASCII host to its ASCII form: labels with non-ASCII bytes become
// `xn--` Punycode labels (RFC 3492). Malformed UTF-8 is left unchanged so the
// host validator rejects or keeps it as before.
fn host_to_ascii(host: String) -> String Never! {
    raw :: host.bytes()
    ascii := true
    loop b in raw {
        if Int.from_u8(b) >= 128 -> ascii = false
    }
    if ascii -> return ~host
    out := ""
    start := 0
    loop i in 0..<(raw.len() + 1) {
        if i == raw.len() || raw[i] == (U8{46}) {
            label :: slice(raw, start, i)
            encoded := label
            points :: utf8_points(label.bytes()) ?? return ~host
            non_ascii := false
            loop cp in points {
                if cp >= 128 -> non_ascii = true
            }
            if non_ascii -> encoded = "xn--{punycode(points)}"
            if i < raw.len() -> out = "{out}{encoded}." else -> out = "{out}{encoded}"
            start = i + 1
        }
    }
    out
}

fn utf8_points(raw: [U8]) -> [Int]? {
    out := [Int]{}
    i := 0
    loop i < raw.len() {
        b :: Int.from_u8(raw[i])
        width := 1
        cp := b
        if b >= 240 {
            width = 4
            cp = b & 7
        } else if b >= 224 {
            width = 3
            cp = b & 15
        } else if b >= 192 {
            width = 2
            cp = b & 31
        } else if b >= 128 {
            return None
        }
        if i + width > raw.len() -> return None
        loop k in 1..<width {
            next :: Int.from_u8(raw[i + k])
            if next < 128 || next >= 192 -> return None
            cp = cp * 64 + (next & 63)
        }
        &out.push(cp)
        i = i + width
    }
    Val(out)
}

fn punycode(points: [Int]) -> String Never! {
    out := [U8]{}
    loop cp in points {
        if cp < 128 -> &out.push(U8{cp})
    }
    basic :: out.len()
    handled := basic
    if basic > 0 && handled < points.len() -> &out.push(U8{45})
    n := 128
    delta := 0
    bias := 72
    loop handled < points.len() {
        m := -1
        loop cp in points {
            if cp >= n && (m < 0 || cp < m) -> m = cp
        }
        delta = delta + (m - n) * (handled + 1)
        n = m
        loop cp in points {
            if cp < n -> delta = delta + 1
            if cp == n {
                q := delta
                k := 36
                loop {
                    t := k - bias
                    if k <= bias -> t = 1
                    if k >= bias + 26 -> t = 26
                    if q < t -> break
                    &out.push(punycode_digit(t + (q - t) %% (36 - t)))
                    q = (q - t) /% (36 - t)
                    k = k + 36
                }
                &out.push(punycode_digit(q))
                bias = punycode_adapt(delta, handled + 1, handled == basic)
                delta = 0
                handled = handled + 1
            }
        }
        delta = delta + 1
        n = n + 1
    }
    String.from_bytes(out) ?? ""
}

fn punycode_digit(d: Int) -> U8 Never! {
    if d < 26 -> return U8{97 + d}
    U8{22 + d}
}

fn punycode_adapt(delta_in: Int, points: Int, first: Bool) -> Int Never! {
    delta := if first -> delta_in /% 700 else -> delta_in /% 2
    delta = delta + delta /% points
    k := 0
    loop delta > 455 {
        delta = delta /% 35
        k = k + 36
    }
    k + (36 * delta) /% (delta + 38)
}

pub fn parse_qsl(query: String) -> [[String]] URLError! {
    rows := [[String]]{}
    raw :: query.bytes()
    if raw.len() == 0 -> return rows
    start := 0
    if raw[0] == (U8{63}) -> start = 1
    i := start
    loop i <= raw.len() {
        if i == raw.len() || raw[i] == (U8{38}) {
            piece :: slice(raw, start, i)
            if piece.bytes().len() > 0 {
                eq :: index_of(piece.bytes(), 61)
                if eq >= 0 {
                    k :: form_percent_decode(slice(piece.bytes(), 0, eq))
                    v :: form_percent_decode(slice(piece.bytes(), eq + 1, piece.bytes().len()))
                    &rows.push([String]{k, v})
                } else {
                    &rows.push([String]{form_percent_decode(piece), ""})
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    rows
}

pub fn urlencode(pairs: [[String]]) -> String Never! { encode_query(pairs) }

pub fn split_fragment(url: String) -> (fragment: String, url: String) Never! {
    raw :: url.bytes()
    i := index_of(raw, 35)
    if i < 0 -> return (fragment: "", url: url)
    (fragment: slice(raw, i + 1, raw.len()), url: slice(raw, 0, i))
}

pub fn quote(text: String) -> String Never! { encode_component(text, true, false) }
pub fn quote_from_bytes(data: [U8]) -> String Never! { encode_component(String.from_bytes(data) ?? "", true, false) }
pub fn quote_plus(text: String) -> String Never! { encode_component(text, false, true) }
pub fn unquote(text: String) -> String URLError! { percent_decode(text) }

pub fn unquote_to_bytes(text: String) -> [U8] URLError! {
    decoded :: percent_decode(text)
    decoded.bytes()
}

pub fn unquote_plus(text: String) -> String URLError! {
    percent_decode(form_to_percent(text))
}

pub fn urlparse(text: String) -> URL URLError! { parse(text) }
pub fn urlsplit(text: String) -> URL URLError! { parse(text) }
pub fn urlunparse(url: URL) -> String Never! { unparse(url) }
pub fn urlunsplit(url: URL) -> String Never! { unparse(url) }

pub fn urldefrag(text: String) -> (url: String, fragment: String) Never! {
    raw :: text.bytes()
    i := index_of(raw, 35)
    if i < 0 -> return (url: text, fragment: "")
    (url: slice(raw, 0, i), fragment: slice(raw, i + 1, raw.len()))
}

pub fn parse_qs(query: String) -> [[String]] URLError! { parse_qsl(query) }

fn encode_component(text: String, allow_slash: Bool, plus_space: Bool) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        if plus_space && n == 32 -> &out.push(U8{43})
        else if unreserved(b) || (allow_slash && n == 47) -> &out.push(b)
        else {
            &out.push(U8{37})
            &out.push(hex_nibble(n /% 16))
            &out.push(hex_nibble(n %% 16))
        }
    }
    String.from_bytes(out) ?? ""
}

fn form_to_percent(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        if b == (U8{43}) {
            &out.push(U8{37})
            &out.push(U8{50})
            &out.push(U8{48})
        } else {
            &out.push(b)
        }
    }
    String.from_bytes(out) ?? ""
}

fn form_percent_decode(text: String) -> String URLError! {
    percent_decode(form_to_percent(text))
}

fn unreserved(b: U8) -> Bool Never! {
    n :: Int.from_u8(b)
    if n >= 65 && n <= 90 -> return true
    if n >= 97 && n <= 122 -> return true
    if n >= 48 && n <= 57 -> return true
    n == 45 || n == 46 || n == 95 || n == 126
}

fn hex_nibble(n: Int) -> U8 Never! {
    if n < 10 -> return U8{48 + n}
    return U8{65 + n - 10}
}

fn hex_value(b: U8) -> Int? {
    n :: Int.from_u8(b)
    if n >= 48 && n <= 57 -> return Val(n - 48)
    if n >= 65 && n <= 70 -> return Val(n - 55)
    if n >= 97 && n <= 102 -> return Val(n - 87)
    None
}

fn ascii_lower(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        if n >= 65 && n <= 90 -> &out.push(U8{n + 32}) else -> &out.push(b)
    }
    String.from_bytes(out) ?? ""
}

fn valid_scheme(text: String) -> Bool Never! {
    raw :: text.bytes()
    if raw.len() == 0 -> return false
    first :: Int.from_u8(raw[0])
    if !((first >= 65 && first <= 90) || (first >= 97 && first <= 122)) -> return false
    i := 1
    loop i < raw.len() {
        n :: Int.from_u8(raw[i])
        if !((n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 43 || n == 45 || n == 46) -> return false
        i = i + 1
    }
    true
}

fn scheme_colon(raw: [U8]) -> Int Never! {
    i := 0
    loop i < raw.len() {
        n :: Int.from_u8(raw[i])
        if n == 58 -> return i
        if n == 47 || n == 63 || n == 35 -> return -1
        i = i + 1
    }
    -1
}

fn has_scheme(text: String) -> Bool Never! { scheme_colon(text.bytes()) > 0 }

fn parse_port(text: String) -> Int? {
    raw :: text.bytes()
    if raw.len() == 0 -> return None
    n := 0
    loop b in raw {
        d :: Int.from_u8(b)
        if d < 48 || d > 57 -> return None
        n = n * 10 + d - 48
        if n > 65535 -> return None
    }
    Val(n)
}

fn trim_ascii(text: String) -> String Never! {
    raw :: text.bytes()
    start := 0
    end := raw.len()
    loop start < end {
        n :: Int.from_u8(raw[start])
        if n == 32 || n == 9 || n == 10 || n == 13 -> start = start + 1 else -> break
    }
    loop end > start {
        n :: Int.from_u8(raw[end - 1])
        if n == 32 || n == 9 || n == 10 || n == 13 -> end = end - 1 else -> break
    }
    if end <= start -> return ""
    slice(raw, start, end)
}

fn valid_percent(text: String) -> Bool Never! {
    raw :: text.bytes()
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{37}) {
            if i + 2 >= raw.len() || !is_hex_byte(raw[i + 1]) || !is_hex_byte(raw[i + 2]) -> return false
            i = i + 3
        } else {
            i = i + 1
        }
    }
    true
}

fn valid_url_host(host: String) -> Bool Never! {
    raw :: host.bytes()
    if raw.len() == 0 -> return false
    label := 0
    non_dot := false
    i := 0
    loop i < raw.len() {
        n :: Int.from_u8(raw[i])
        if n == 46 {
            if label == 0 && i < raw.len() - 1 -> return false
            label = 0
        } else {
            if n <= 32 || n == 127 || n == 47 || n == 63 || n == 35 || n == 64 || n == 91 || n == 93 -> return false
            label = label + 1
            if label > 63 -> return false
            non_dot = true
        }
        i = i + 1
    }
    if !non_dot -> return false
    if label == 0 && raw[raw.len() - 1] != (U8{46}) -> return false
    true
}

fn is_hex_byte(b: U8) -> Bool Never! {
    n :: Int.from_u8(b)
    (n >= 48 && n <= 57) || (n >= 65 && n <= 70) || (n >= 97 && n <= 102)
}

fn normalize_path(path: String, absolute: Bool) -> String Never! {
    raw :: path.bytes()
    segments := [String]{}
    start := 0
    i := 0
    loop i <= raw.len() {
        if i == raw.len() || raw[i] == (U8{47}) {
            segment :: slice(raw, start, i)
            if segment == ".." {
                if segments.len() > 0 && segments[segments.len() - 1] != ".." {
                    _ :: &segments.pop()
                } else if !absolute {
                    &segments.push("..")
                }
            } else if segment != "" && segment != "." {
                &segments.push(segment)
            }
            start = i + 1
        }
        i = i + 1
    }
    out := ""
    if absolute -> out = "/"
    loop segment in segments {
        if out.bytes().len() > 0 && out.bytes()[out.bytes().len() - 1] != (U8{47}) -> out = "{out}/"
        out = "{out}{segment}"
    }
    if path.bytes().len() > 0 && path.bytes()[path.bytes().len() - 1] == (U8{47}) && out.bytes().len() > 0 && out.bytes()[out.bytes().len() - 1] != (U8{47}) -> out = "{out}/"
    if out.bytes().len() == 0 && absolute -> return "/"
    out
}

fn dirname_url(path: String) -> String Never! {
    raw :: path.bytes()
    if raw.len() == 0 -> return "/"
    i := raw.len()
    loop i > 0 {
        i = i - 1
        if raw[i] == (U8{47}) -> return slice(raw, 0, i + 1)
    }
    "/"
}

fn contains_byte(text: String, needle: Int) -> Bool Never! {
    loop b in text.bytes() {
        if Int.from_u8(b) == needle -> return true
    }
    false
}

fn starts(text: String, prefix: String) -> Bool Never! {
    a :: text.bytes()
    b :: prefix.bytes()
    if b.len() > a.len() -> return false
    loop i in 0..<b.len() {
        if a[i] != b[i] -> return false
    }
    true
}

fn index_of(raw: [U8], b: Int) -> Int Never! {
    loop i in 0..<raw.len() {
        if Int.from_u8(raw[i]) == b -> return i
    }
    -1
}

fn last_index(raw: [U8], b: Int) -> Int Never! {
    i := raw.len() - 1
    loop i >= 0 {
        if Int.from_u8(raw[i]) == b -> return i
        i = i - 1
    }
    -1
}

fn slice(raw: [U8], start: Int, end: Int) -> String Never! {
    String.from_bytes(slice_bytes(raw, start, end)) ?? ""
}

fn slice_bytes(raw: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    limit := if end < raw.len() -> end else -> raw.len()
    if start < 0 || start >= limit -> return out
    loop i in start..<limit -> &out.push(raw[i])
    out
}
