package {
    name: "core.net"
    version: "0.1.0"
    edition: "2026"
    description: "Sockets, DNS, TLS, URLs, and MIME."
    license: "MIT"
    outputs: {
        net: .Library{ entry: net }
    }
}
// core.net — blocking sockets and name resolution.
//
// TCP/UDP/Unix/DNS/TLS talk to the OS through private `host_*` cells.
// Address parsing, service names, accessors, write-all loops, and
// `sendfile` are Jet. Failures are `IOError`. There is no hidden retry.
module url

module mime

module tls

module ws

module ip

#Error
pub struct IOError {
    pub operation: String
    pub message: String
    pub address: String
    pub name: String
    pub os_code: ?Int
}

pub struct SocketAddr {
    pub host: String
    pub port: Int
}

pub struct TcpStream {
    pub fd: Int
    pub host: String
    pub port: Int
}

pub struct TcpListener {
    pub fd: Int
    pub host: String
    pub port: Int
}

pub struct UdpSocket {
    pub fd: Int
    pub host: String
    pub port: Int
}

pub struct UdpPacket {
    pub data: [U8]
    pub host: String
    pub port: Int
    pub original_len: Int
    pub truncated: Bool
}

pub struct UnixStream {
    pub fd: Int
    pub path: String
}

pub struct UnixListener {
    pub fd: Int
    pub path: String
}

pub struct TlsStream {
    pub fd: Int
    pub host: String
    pub port: Int
}

pub struct SrvRecord {
    pub target: String
    pub port: Int
    pub priority: Int
    pub weight: Int
}

pub fn ip_addr(host: String, port: Int) -[Net]> SocketAddr !IOError { socket_addr(host, port) }

pub fn ip_to_string(addr: SocketAddr) -> String { "{addr.host}:{addr.port}" }

pub fn ip_is_ipv4(addr: SocketAddr) -> Bool {
    loop b in addr.host.bytes() {
        n :: b
        if n == 58 -> return false
    }
    index_byte(addr.host, 46) >= 0
}

pub fn socket_addr(host: String, port: Int) -[Net]> SocketAddr !IOError {
    if port < 0 || port > 65535 -> return Err(net_err("socket_addr", host, "port out of range"))
    Ok(SocketAddr{host: host, port: port})
}

pub fn socket_addr_parse(text: String) -> SocketAddr !IOError {
    raw :: text.bytes()
    if raw.len() == 0 -> return Err(net_err("parse", text, "empty address"))
    if raw[0] == (U8{91}) {
        rb := index_of(raw, 93)
        if rb < 0 -> return Err(net_err("parse", text, "unclosed IPv6 bracket"))
        host :: slice(raw, 1, rb)
        port := 0
        if rb + 1 < raw.len() {
            if raw[rb + 1] != (U8{58}) -> return Err(net_err("parse", text, "expected :port"))
            port = parse_int(slice(raw, rb + 2, raw.len())) ?? return Err(net_err("parse", text, "invalid port"))
        }
        return Ok(SocketAddr{host: host, port: port})
    }
    col := last_index(raw, 58)
    if col < 0 -> return Err(net_err("parse", text, "address needs host:port"))
    host :: slice(raw, 0, col)
    port :: parse_int(slice(raw, col + 1, raw.len())) ?? return Err(net_err("parse", text, "invalid port"))
    Ok(SocketAddr{host: host, port: port})
}

pub fn socket_host(addr: SocketAddr) -> String { addr.host }

pub fn socket_port(addr: SocketAddr) -> Int { addr.port }

pub fn socket_to_string(addr: SocketAddr) -> String { ip_to_string(addr) }

pub fn socket_type(stream: TcpStream) -[Net]> String { "stream" }

pub fn tcp_listen(host: String, port: Int) -[Net]> TcpListener !IOError {
    addr :: socket_addr(host, port)
    tcp_listen_addr(addr)
}

pub fn tcp_listen_addr(addr: SocketAddr) -[Net]> TcpListener !IOError {
    fd :: host_tcp_listen(addr.host, addr.port)
    Ok(TcpListener{fd: fd, host: addr.host, port: addr.port})
}

pub fn tcp_accept(listener: TcpListener) -[Net]> TcpStream !IOError {
    fd :: host_tcp_accept(listener.fd)
    Ok(TcpStream{fd: fd, host: listener.host, port: listener.port})
}

pub fn tcp_connect(host: String, port: Int) -[Net]> TcpStream !IOError {
    addr :: socket_addr(host, port)
    tcp_connect_addr(addr)
}

pub fn tcp_connect_addr(addr: SocketAddr) -[Net]> TcpStream !IOError {
    fd :: host_tcp_connect(addr.host, addr.port, 0)
    Ok(TcpStream{fd: fd, host: addr.host, port: addr.port})
}

pub fn tcp_connect_timeout(host: String, port: Int, timeout: Duration) -[Net]> TcpStream !IOError {
    ms :: timeout.ns / 1000000
    fd :: host_tcp_connect(host, port, ms)
    Ok(TcpStream{fd: fd, host: host, port: port})
}

pub fn tcp_connect_happy(host: String, port: Int) -[Net]> TcpStream !IOError {
    tcp_connect(host, port)
}
/// Python-compatible connection constructor.
pub fn create_connection(host: String, port: Int) -[Net]> TcpStream !IOError {
    tcp_connect(host, port)
}

/// Python-compatible server constructor.
pub fn create_server(host: String, port: Int) -[Net]> TcpListener !IOError {
    tcp_listen(host, port)
}

pub fn send(stream: TcpStream, text: String) -[Net]> Int !IOError {
    tcp_write(stream, text)
}


pub fn tcp_read(stream: TcpStream, n: Int) -[Net]> String !IOError { tcp_read_text(stream, n) }

pub fn tcp_write(stream: TcpStream, text: String) -[Net]> Int !IOError {
    tcp_write_bytes(stream, text.bytes())
}

pub fn tcp_read_bytes(stream: TcpStream, n: Int) -[Net]> [U8] !IOError {
    host_tcp_read(stream.fd, n)
}

pub fn tcp_read_text(stream: TcpStream, n: Int) -[Net]> String !IOError {
    bytes :: tcp_read_bytes(stream, n)
    Ok(String.from_bytes(bytes) ?? return Err(net_err("read", stream.host, "not UTF-8")))
}

pub fn tcp_write_bytes(stream: TcpStream, bytes: [U8]) -[Net]> Int !IOError {
    host_tcp_write(stream.fd, bytes)
}

pub fn tcp_write_all_bytes(stream: TcpStream, bytes: [U8]) !IOError {
    off := 0
    loop off < bytes.len() {
        n :: host_tcp_write(stream.fd, slice_bytes(bytes, off, bytes.len()))
        if n <= 0 -> return Err(net_err("write", stream.host, "short write"))
        off = off + n
    }
    Ok()
}

pub fn tcp_write_text(stream: TcpStream, text: String) !IOError {
    tcp_write_all_bytes(stream, text.bytes())
}

pub fn tcp_shutdown(stream: TcpStream) !IOError {
    host_tcp_shutdown(stream.fd)
    Ok()
}

pub fn tcp_close(stream: TcpStream) !IOError {
    host_tcp_close(stream.fd)
    Ok()
}

pub fn tcp_ready(stream: TcpStream) -[Net]> Bool { host_tcp_ready(stream.fd, true) }

pub fn tcp_local_addr(stream: TcpStream) -[Net]> String !IOError {
    addr :: tcp_local_socket_addr(stream)
    Ok(ip_to_string(addr))
}

pub fn tcp_peer_addr(stream: TcpStream) -[Net]> String !IOError {
    addr :: tcp_peer_socket_addr(stream)
    Ok(ip_to_string(addr))
}

pub fn tcp_local_socket_addr(stream: TcpStream) -[Net]> SocketAddr !IOError {
    host_tcp_local(stream.fd)
}

pub fn tcp_peer_socket_addr(stream: TcpStream) -[Net]> SocketAddr !IOError {
    host_tcp_peer(stream.fd)
}

pub fn listener_local_socket_addr(listener: TcpListener) -[Net]> SocketAddr !IOError {
    host_tcp_local(listener.fd)
}

pub fn tcp_reply(stream: TcpStream, text: String) !IOError {
    _ :: tcp_write_text(stream, text)
    tcp_close(stream)
}

pub fn ready_readable(stream: TcpStream) -[Net]> Bool { host_tcp_ready(stream.fd, true) }

pub fn ready_writable(stream: TcpStream) -[Net]> Bool { host_tcp_ready(stream.fd, false) }

pub fn set_timeout(stream: TcpStream, timeout: Duration) !IOError {
    host_tcp_timeout(stream.fd, timeout.ns / 1000000, true)
    host_tcp_timeout(stream.fd, timeout.ns / 1000000, false)
    Ok()
}

pub fn set_read_timeout(stream: TcpStream, timeout: Duration) !IOError {
    host_tcp_timeout(stream.fd, timeout.ns / 1000000, true)
    Ok()
}

pub fn set_write_timeout(stream: TcpStream, timeout: Duration) !IOError {
    host_tcp_timeout(stream.fd, timeout.ns / 1000000, false)
    Ok()
}

pub fn nodelay(stream: TcpStream) -[Net]> Bool { host_tcp_nodelay(stream.fd) }

pub fn set_nodelay(stream: TcpStream, on: Bool) !IOError {
    host_tcp_set_nodelay(stream.fd, on)
    Ok()
}

pub fn ttl(stream: TcpStream) -[Net]> Int { host_tcp_ttl(stream.fd) }

pub fn set_ttl(stream: TcpStream, hops: Int) !IOError {
    host_tcp_set_ttl(stream.fd, hops)
    Ok()
}

pub fn sendfile(stream: TcpStream, path: String, offset: Int, count: Int) -[Net, FS]> Int !IOError {
    data :: host_read_path(path)
    out := [U8]{}
    i := offset
    end := offset + count
    if count < 0 -> end = data.len()
    loop {
        if i >= data.len() || i >= end -> break
        if i >= 0 -> out.push(data[i])
        i = i + 1
    }
    _ :: tcp_write_all_bytes(stream, out)
    Ok(out.len())
}

pub fn udp_bind(host: String, port: Int) -[Net]> UdpSocket !IOError {
    fd :: host_udp_bind(host, port)
    Ok(UdpSocket{fd: fd, host: host, port: port})
}

pub fn udp_bind_addr(addr: SocketAddr) -[Net]> UdpSocket !IOError { udp_bind(addr.host, addr.port) }

pub fn udp_local_addr(socket: UdpSocket) -[Net]> String !IOError {
    Ok("{socket.host}:{socket.port}")
}

pub fn udp_set_timeout(socket: UdpSocket, timeout: Duration) !IOError {
    host_udp_timeout(socket.fd, timeout.ns / 1000000)
    Ok()
}

pub fn udp_send_to(socket: UdpSocket, text: String, host: String, port: Int) -[Net]> Int !IOError {
    host_udp_send(socket.fd, text.bytes(), host, port)
}

pub fn udp_recv_from(socket: UdpSocket) -[Net]> (host: String, port: Int, text: String) !IOError {
    pkt :: udp_receive(socket)
    Ok((text: String.from_bytes(pkt.data) ?? "", host: pkt.host, port: pkt.port))
}

pub fn udp_send_bytes_to(socket: UdpSocket, bytes: [U8], addr: SocketAddr) -[Net]> Int !IOError {
    host_udp_send(socket.fd, bytes, addr.host, addr.port)
}

pub fn udp_receive(socket: UdpSocket) -[Net]> UdpPacket !IOError { host_udp_recv(socket.fd) }

pub fn udp_packet_data(packet: UdpPacket) -> String { String.from_bytes(packet.data) ?? "" }

pub fn udp_packet_addr(packet: UdpPacket) -> String { "{packet.host}:{packet.port}" }

pub fn udp_packet_bytes(packet: UdpPacket) -> [U8] { packet.data }

pub fn udp_packet_original_len(packet: UdpPacket) -> Int { packet.original_len }

pub fn udp_packet_truncated(packet: UdpPacket) -> Bool { packet.truncated }

pub fn unix_listen(path: String) -[Net, FS]> UnixListener !IOError {
    fd :: host_unix_listen(path)
    Ok(UnixListener{fd: fd, path: path})
}

pub fn unix_accept(listener: UnixListener) -[Net]> UnixStream !IOError {
    fd :: host_unix_accept(listener.fd)
    Ok(UnixStream{fd: fd, path: listener.path})
}

pub fn unix_connect(path: String) -[Net, FS]> UnixStream !IOError {
    fd :: host_unix_connect(path)
    Ok(UnixStream{fd: fd, path: path})
}

pub fn unix_read(stream: UnixStream, n: Int) -[Net]> String !IOError {
    bytes :: unix_read_bytes(stream, n)
    Ok(String.from_bytes(bytes) ?? "")
}

pub fn unix_write(stream: UnixStream, text: String) -[Net]> Int !IOError {
    host_unix_write(stream.fd, text.bytes())
}

pub fn unix_read_bytes(stream: UnixStream, n: Int) -[Net]> [U8] !IOError {
    host_unix_read(stream.fd, n)
}

pub fn unix_write_all_bytes(stream: UnixStream, bytes: [U8]) !IOError {
    off := 0
    loop off < bytes.len() {
        n :: host_unix_write(stream.fd, slice_bytes(bytes, off, bytes.len()))
        if n <= 0 -> return Err(net_err("write", stream.path, "short write"))
        off = off + n
    }
    Ok()
}

pub fn unix_shutdown(stream: UnixStream) !IOError {
    host_unix_close(stream.fd)
    Ok()
}

pub fn unix_close(stream: UnixStream) !IOError { unix_shutdown(stream) }

pub fn dns_a(name: String) -[Net]> [String] !IOError { host_dns(name, "A", "") }

pub fn dns_aaaa(name: String) -[Net]> [String] !IOError { host_dns(name, "AAAA", "") }

pub fn dns_a_at(name: String, resolver: String) -[Net]> [String] !IOError {

    host_dns(name, "A", resolver)
}

pub fn dns_aaaa_at(name: String, resolver: String) -[Net]> [String] !IOError {
    host_dns(name, "AAAA", resolver)
}

pub fn dns_txt(name: String) -[Net]> [String] !IOError { host_dns(name, "TXT", "") }

pub fn dns_txt_at(name: String, resolver: String) -[Net]> [String] !IOError {
    host_dns(name, "TXT", resolver)
}

pub fn dns_ptr(addr: String) -[Net]> [String] !IOError { host_dns(addr, "PTR", "") }

pub fn dns_srv(name: String) -[Net]> [SrvRecord] !IOError { host_dns_srv(name, "") }

pub fn dns_srv_at(name: String, resolver: String) -[Net]> [SrvRecord] !IOError {
    host_dns_srv(name, resolver)
}
pub fn gethostbyname(name: String) -[Net]> String !IOError {
    hosts :: dns_a(name)
    if hosts.len() == 0 -> return Err(net_err("gethostbyname", name, "no address"))
    hosts[0]
}

pub fn gethostbyaddr(addr: String) -[Net]> String !IOError {
    names :: dns_ptr(addr)
    if names.len() == 0 -> return Err(net_err("gethostbyaddr", addr, "no name"))
    names[0]
}

pub fn dns_srv_target(record: SrvRecord) -> String { record.target }

pub fn dns_srv_port(record: SrvRecord) -> Int { record.port }

pub fn dns_srv_priority(record: SrvRecord) -> Int { record.priority }

pub fn dns_srv_weight(record: SrvRecord) -> Int { record.weight }

pub fn getservbyname(name: String) -[Net]> Int !IOError {
    n :: ascii_lower(name)
    if n == {
        "http" | "www" -> Ok(80)
        "https" -> Ok(443)
        "ssh" -> Ok(22)
        "ftp" -> Ok(21)
        "smtp" -> Ok(25)
        "dns" | "domain" -> Ok(53)
        "ntp" -> Ok(123)
        "imap" -> Ok(143)
        "imaps" -> Ok(993)
        "pop3" -> Ok(110)
        "pop3s" -> Ok(995)
        else -> Err(net_err("getservbyname", name, "unknown service"))
    }
}

pub fn getservbyport(port: Int) -[Net]> String !IOError {
    if port == {
        80 -> Ok("http")
        443 -> Ok("https")
        22 -> Ok("ssh")
        21 -> Ok("ftp")
        25 -> Ok("smtp")
        53 -> Ok("domain")
        else -> Err(net_err("getservbyport", "{port}", "unknown port"))
    }
}

