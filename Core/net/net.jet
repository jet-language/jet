pub fn gethostbyname(name: String) -[Net, Time.Wait]> String !NetError {
    hosts :: dns_a(name, 5000)
    if hosts.len() == 0 -> return Err(net_err("gethostbyname", name, "no address"))
    ip_to_string(hosts[0])
}

pub fn gethostbyaddr(addr: String) -[Net, Time.Wait]> String !NetError {
    names :: dns_ptr(addr, 5000)
    if names.len() == 0 -> return Err(net_err("gethostbyaddr", addr, "no name"))
    names[0]
}

