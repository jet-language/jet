pub fn dns_srv_port(record: DNSSRV) -> Int Never! { core.net.dns_srv_port(record) }
pub fn dns_srv_priority(record: DNSSRV) -> Int Never! { core.net.dns_srv_priority(record) }
pub fn dns_srv_weight(record: DNSSRV) -> Int Never! { core.net.dns_srv_weight(record) }

