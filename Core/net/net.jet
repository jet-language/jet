fn net_err(op: String, addr: String, message: String) -> IOError {
    {
        operation: op,
        message: message,
        address: addr,
        name: addr,
        os_code: None,
    }
}

fn index_byte(text: String, b: Int) -> Int { index_of(text.bytes(), b) }

fn index_of(raw: [U8], b: Int) -> Int {
    loop i in 0..<raw.len() {
        n :: raw[i]
        if n == b -> return i
    }
    -1
}

fn last_index(raw: [U8], b: Int) -> Int {
    i := raw.len() - 1
    loop i >= 0 {
        n :: raw[i]
        if n == b -> return i
        i = i - 1
    }
    -1
}

fn parse_int(text: String) -> ?Int {
    if text.bytes().len() == 0 -> return None
    n := 0
    loop b in text.bytes() {
        d :: b
        if d < 48 || d > 57 -> return None
        n = n * 10 + (d - 48)
    }
    Val(n)
}

fn ascii_lower(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n :: b
        if n >= 65 && n <= 90 -> out.push(U8{n + 32}) else -> out.push(b)
    }
    String.from_bytes(out) ?? ""
}

fn slice(raw: [U8], start: Int, end: Int) -> String {
    String.from_bytes(slice_bytes(raw, start, end)) ?? ""
}

fn slice_bytes(raw: [U8], start: Int, end: Int) -> [U8] {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i >= raw.len() -> return out
        out.push(raw[i])
        i = i + 1
    }
}
pub fn addressfamily(addr: SocketAddr) -> String {
    if index_byte(addr.host, 58) >= 0 -> "IPv6"
    "IPv4"
}
