fn dns_srv(name: String, ms: Int) -[Net, Time.Wait]> [SRVRecord] NetError! {
    if !valid_text(name) -> return Err(net_err("dns_srv", name, "DNS name is empty or contains control bytes"))
    if !valid_timeout(ms) -> return Err(net_err("dns_srv", name, "DNS timeout must be non-negative"))
