package {
    name: "core.net"
    version: "0.1.0"
    edition: "2026"
    description: "Sockets, DNS, TLS, URLs, and MIME."
    license: "MIT"
    outputs: {
        net: .Library{ entry: net }
    }
}

use core as core

// core.net — blocking sockets and name resolution.
//
// Address parsing, service names, accessors, write-all loops, and deterministic
// request framing live in Jet. The `core.net` cells are typed OS transport
// leaves; a missing provider is reported as an IOError rather than converted
// into an empty or successful result.
module url
module mime
module tls
module ws
module ip

pub struct SocketAddr {
    pub host: String
    pub port: Int
}

pub struct TCPStream {
    fd: Int
    host: String
    port: Int
}

pub struct TCPListener {
    fd: Int
    host: String
    port: Int
}

pub struct UDPSocket {
    pub fd: Int
    pub host: String
    pub port: Int
}

pub struct UDPPacket {
    pub data: [U8]
    pub host: String
    pub port: Int
    pub original_len: Int
    pub truncated: Bool
}

pub struct UnixStream {
    pub fd: Int
    pub path: String
}

pub struct UnixListener {
    pub fd: Int
    pub path: String
}


pub struct SRVRecord {
    pub target: String
    pub port: Int
    pub priority: Int
    pub weight: Int
}

pub fn gethostname() -> String Never! { core.net.gethostname() }

pub fn ip_addr(text: String) -[Net, Time.Wait]> IPAddr NetError! {
    if !valid_text(text) -> return Err(net_err("ip_addr", text, "IP address is empty or contains control bytes"))
    core.net.ip_addr(text)
}

fn ip_to_string_impl(addr: IPAddr) -> String Never! {
    core.net.ip_to_string(addr)
}
pub fn ip_to_string(addr: IPAddr) -> String Never! { ip_to_string_impl(addr) }
pub fn ip_is_ipv4(addr: IPAddr) -> Bool Never! { core.net.ip_is_ipv4(addr) }

pub fn socket_addr(host: String, port: Int) -[Net, Time.Wait]> SocketAddr NetError! {
    if !valid_host_text(host) -> return Err(net_err("socket_addr", host, "socket host is empty or contains invalid bytes"))
    if !valid_port(port) -> return Err(net_err("socket_addr", host, "port must be in 0..=65535"))
    host_text := host
    if contains_byte(host, 58) && !starts_with(host, "[") -> host_text = "[{host}]"
    core.net.socket_addr(host_text, port)
}

pub fn socket_addr_parse(text: String) -[Net, Time.Wait]> SocketAddr NetError! {
    if !valid_text(text) -> return Err(net_err("socket_addr_parse", text, "socket address is empty or contains control bytes"))
    core.net.socket_addr_parse(text)
}

pub fn socket_host(addr: SocketAddr) -> String Never! { core.net.socket_host(addr) }
pub fn socket_port(addr: SocketAddr) -> Int Never! { core.net.socket_port(addr) }
fn socket_to_string_impl(addr: SocketAddr) -> String Never! {
    core.net.socket_to_string(addr)
}
pub fn socket_to_string(addr: SocketAddr) -> String Never! { socket_to_string_impl(addr) }
pub fn socket_type(stream: TCPStream) -> String Never! { "stream" }

pub fn tcp_listen(addr: String) -[Net, Time.Wait]> TCPListener NetError! {
    if !valid_text(addr) -> return Err(net_err("tcp_listen", addr, "listen address is empty or contains control bytes"))
    core.net.tcp_listen(addr)
}

pub fn tcp_listen_addr(addr: SocketAddr) -[Net, Time.Wait]> TCPListener NetError! {
    core.net.tcp_listen_addr(addr)
}

pub fn tcp_accept(listener: TCPListener) -[Net, Time.Wait]> TCPStream NetError! {
    core.net.tcp_accept(listener)
}

pub fn tcp_connect(addr: String) -[Net, Time.Wait]> TCPStream NetError! {
    if !valid_text(addr) -> return Err(net_err("tcp_connect", addr, "connect address is empty or contains control bytes"))
    core.net.tcp_connect(addr)
}

pub fn tcp_connect_addr(addr: SocketAddr) -[Net, Time.Wait]> TCPStream NetError! {
    core.net.tcp_connect_addr(addr)
}

pub fn tcp_connect_timeout(addr: SocketAddr, timeout_ms: Int) -[Net, Time.Wait]> TCPStream NetError! {
    if !valid_timeout(timeout_ms) -> return Err(net_err("tcp_connect_timeout", socket_to_string_impl(addr), "timeout must be non-negative"))
    core.net.tcp_connect_timeout(addr, timeout_ms)
}

pub fn tcp_connect_happy(host: String, port: Int, timeout_ms: Int) -[Net, Time.Wait]> TCPStream NetError! {
    if !valid_host_text(host) -> return Err(net_err("tcp_connect_happy", host, "connect host is empty or contains invalid bytes"))
    if !valid_port(port) -> return Err(net_err("tcp_connect_happy", host, "port must be in 0..=65535"))
    if !valid_timeout(timeout_ms) -> return Err(net_err("tcp_connect_happy", host, "timeout must be non-negative"))
    core.net.tcp_connect_happy(host, port, timeout_ms)
}

pub fn create_connection(host: String, port: Int) -[Net, Time.Wait]> TCPStream NetError! {
    if !valid_host_text(host) -> return Err(net_err("create_connection", host, "connect host is empty or contains invalid bytes"))
    if !valid_port(port) -> return Err(net_err("create_connection", host, "port must be in 0..=65535"))
    tcp_connect(format_host_port(host, port))
}

pub fn create_server(host: String, port: Int) -[Net, Time.Wait]> TCPListener NetError! {
    if !valid_host_text(host) -> return Err(net_err("create_server", host, "listen host is empty or contains invalid bytes"))
    if !valid_port(port) -> return Err(net_err("create_server", host, "port must be in 0..=65535"))
    tcp_listen(format_host_port(host, port))
}
pub fn send(stream: TCPStream, text: String) -[Net, Time.Wait]> Int NetError! {
    stream.write(text)
}

pub fn tcp_read(stream: TCPStream) -[Net, Time.Wait]> String NetError! {
    stream.read_text(8192)
}

pub fn tcp_write(stream: TCPStream, text: String) NetError! -[Net, Time.Wait]> {
    return stream.write_text(text)
}
pub fn tcp_read_bytes(stream: TCPStream, n: Int) -[Net, Time.Wait]> [U8] NetError! {
    if n < 0 -> return Err(net_err("tcp_read_bytes", "", "read limit must be non-negative"))
    stream.read(n)
}

pub fn tcp_read_text(stream: TCPStream, n: Int) -[Net, Time.Wait]> String NetError! {
    if n < 0 -> return Err(net_err("tcp_read_text", "", "read limit must be non-negative"))
    stream.read_text(n)
}

pub fn tcp_write_bytes(stream: TCPStream, bytes: [U8]) -[Net, Time.Wait]> Int NetError! {
    stream.write(bytes)
}

pub fn tcp_write_all_bytes(stream: TCPStream, bytes: [U8]) NetError! -[Net, Time.Wait]> {
    return stream.write_all(bytes)
}

pub fn tcp_write_text(stream: TCPStream, text: String) NetError! -[Net, Time.Wait]> {
