fn dns_a(name: String, ms: Int) -[Net, Time.Wait]> [IPAddr] NetError! {
    if !valid_text(name) -> return Err(net_err("dns_a", name, "DNS name is empty or contains control bytes"))
    if !valid_timeout(ms) -> return Err(net_err("dns_a", name, "DNS timeout must be non-negative"))
    if core.net.__dns_a_lookup(name, ms) == {
        .Ok(addresses) -> Ok(addresses)
        .Err(message) -> Err(dns_error(name, message))
    }
}

fn dns_aaaa(name: String, ms: Int) -[Net, Time.Wait]> [IPAddr] NetError! {
    if !valid_text(name) -> return Err(net_err("dns_aaaa", name, "DNS name is empty or contains control bytes"))
    if !valid_timeout(ms) -> return Err(net_err("dns_aaaa", name, "DNS timeout must be non-negative"))
    if core.net.__dns_aaaa_lookup(name, ms) == {
        .Ok(addresses) -> Ok(addresses)
        .Err(message) -> Err(dns_error(name, message))
    }
}

fn dns_a_at(server: String, name: String, ms: Int) -[Net, Time.Wait]> [IPAddr] NetError! {
    if !valid_text(server) || !valid_text(name) -> return Err(net_err("dns_a_at", name, "DNS server/name is empty or contains control bytes"))
    if !valid_timeout(ms) -> return Err(net_err("dns_a_at", name, "DNS timeout must be non-negative"))
    _ :: socket_addr_parse(server) ?? return Err(net_err("dns_a_at", server, "DNS server must be an IP socket address"))
    if core.net.__dns_a_at_lookup(server, name, ms) == {
        .Ok(addresses) -> Ok(addresses)
        .Err(message) -> Err(dns_error(name, message))
    }
}

fn dns_aaaa_at(server: String, name: String, ms: Int) -[Net, Time.Wait]> [IPAddr] NetError! {
    if !valid_text(server) || !valid_text(name) -> return Err(net_err("dns_aaaa_at", name, "DNS server/name is empty or contains control bytes"))
    if !valid_timeout(ms) -> return Err(net_err("dns_aaaa_at", name, "DNS timeout must be non-negative"))
    _ :: socket_addr_parse(server) ?? return Err(net_err("dns_aaaa_at", server, "DNS server must be an IP socket address"))
    if core.net.__dns_aaaa_at_lookup(server, name, ms) == {
