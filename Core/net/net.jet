package {
    name: "core.net"
    version: "0.0.1"
    edition: "2026"
    description: "Sockets, DNS, TLS, URLs, and MIME."
    license: "MIT"
    outputs: {
        net: .Library{ entry: net }
    }
}

use core as core

// core.net — blocking sockets and name resolution.
//
// Address parsing, service names, accessors, write-all loops, and deterministic
// request framing live in Jet. Reserved `__` leaves retain the existing OS
// transport, scheduler ordering and native error mapping until the Jet runtime
// socket layer replaces them; public spellings always enter source policy.
module url
module mime
module tls
module ws
module ip

struct SocketAddr {
    host: String
    port: Int
}

// Provider sockets retain their native carriers and complete method/trait
// contracts; source policy must not replace them with descriptor records.

struct NetReady {
    readable: Bool
    writable: Bool
}


// NetHTTP.rs JetNetErrorDetail: public construction is already supported.
struct NetErrorDetail {
    operation: String
    address: String?
    name: String?
    message: String
    os_code: Int?
}

enum NetDNSError {
    NotFound(String)
    Failure(String)
}

// Preserve checked surface ordinals (jet_net_error_surface_parts), not Rust
// declaration order: TLS=11, Protocol=12, Other=13, DNS=14.
#Error
enum NetError {
    InvalidInput(NetErrorDetail)
    PermissionDenied(NetErrorDetail)
    AddressInUse(NetErrorDetail)
    AddressUnavailable(NetErrorDetail)
    ConnectionRefused(NetErrorDetail)
    ConnectionReset(NetErrorDetail)
    NotConnected(NetErrorDetail)
    Closed(NetErrorDetail)
    Timeout(NetErrorDetail)
    Cancelled(NetErrorDetail)
    Unsupported(NetErrorDetail)
    TLS(NetErrorDetail)
    Protocol(NetErrorDetail)
    Other(NetErrorDetail)
    DNS(NetDNSError)

    impl Display {
        fn display(self) -> String { net_error_text(self) }
    }
    impl Debug {
        fn debug(^self) -> String { net_error_text(self) }
    }
}

// D-NET-ERROR-DISPLAY1 / Prelude/Core/NetError.rs: every ordinary variant
// displays its detail message; DNS NotFound alone adds the canonical prefix.
fn net_error_text(err: NetError) -> String Never! {
    if err == .DNS(dns) {
        return if dns == {
            .NotFound(name) -> "DNS name not found: `{name}`"
            .Failure(message) -> message
        }
    } else {
        detail :: error_detail(err) ?? panic("NetError detail")
        detail.message
    }
}

#Test("NetError display retains DNS and detail projections") {
    assert(net_error_text(NetError.DNS(NetDNSError.NotFound("example.test"))) == "DNS name not found: `example.test`")
    assert(net_error_text(NetError.DNS(NetDNSError.Failure("lookup failed"))) == "lookup failed")
    detail :: NetErrorDetail{operation: "read", address: None, name: None, message: "closed", os_code: None}
    assert(net_error_text(NetError.Closed(detail)) == "closed")
}
// Compiler-private platform result: exact Int fields use the existing record
// codec rather than a tuple nested inside Result.
struct __ResolveError {
    kind: Int
    has_os_code: Bool
    os_code: Int
    message: String
}

struct UDPPacket {
    data: [U8]
    host: String
    port: Int
    original_len: Int
    truncated: Bool
}


struct SRVRecord {
    target: String
    port: Int
    priority: Int
    weight: Int
}

fn gethostname() -[Env, FS]> String Never! {
    environment :: core.sys.get("HOSTNAME") ?? ""
    if environment.len() > 0 -> return environment
    contents :: core.files.read("/etc/hostname") ?? return "localhost"
    core.text.trim(contents)
}

fn ip_addr(text: String) -> IPAddr NetError! {
    if !valid_text(text) -> return Err(net_err("ip_addr", text, "IP address is empty or contains control bytes"))
    bytes :: parse_ip_bytes(text) ?? return Err(net_err("parse IP address", text, "invalid IP address `{text}`: invalid IP address syntax"))
    #Unsafe("checked IPv4/IPv6 octets transferred into the native address carrier") {
        return core.net.__ip_from_bytes(^bytes)
    }
}

fn ip_to_string_impl(addr: IPAddr) -> String Never! {
    #Unsafe("read native address octets; no parsing or formatting policy in the carrier leaf") {
        return format_ip_bytes(core.net.__ip_bytes(addr))
    }
}
fn ip_to_string(addr: IPAddr) -> String Never! { ip_to_string_impl(addr) }
fn ip_is_ipv4(addr: IPAddr) -> Bool Never! {
    #Unsafe("read the native IP address discriminant") { return core.net.__ip_is_v4(addr) }
}

fn socket_addr(host: String, port: Int) -[Net, Time.Wait]> SocketAddr NetError! {
    if !valid_host_text(host) -> return Err(net_err("socket_addr", host, "socket host is empty or contains invalid bytes"))
    if !valid_port(port) -> return Err(net_err("socket_addr", host, "port must be in 0..=65535"))
    host_text := host
    if contains_byte(host, 58) && !starts_with(host, "[") -> host_text = "[{host}]"
    text :: "{host_text}:{port}"
    if socket_addr_parse(text) == .Ok(address) -> return Ok(address)
    port16 :: U16{port}
    if core.net.__resolve_ordered(host_text, port16) == {
        .Ok(addresses) -> resolve_first(text, addresses)
        .Err(error) -> Err(resolve_error(text, error))
    }
}

fn socket_addr_parse(text: String) -> SocketAddr NetError! {
    if !valid_text(text) -> return Err(net_err("socket_addr_parse", text, "socket address is empty or contains control bytes"))
    raw :: text.bytes()
    host := ""
    port_text := ""
    scope := 0
    bytes := [U8]{}
    if raw[0] == (U8{91}) {
        close :: last_index(raw, 93)
        if close < 2 || close + 2 >= raw.len() || raw[close + 1] != (U8{58}) -> return Err(invalid_socket(text))
        host = slice(raw, 1, close)
        port_text = slice(raw, close + 2, raw.len())
        percent :: last_index(host.bytes(), 37)
        if percent >= 0 {
            scope = parse_scope(slice(host.bytes(), percent + 1, host.bytes().len())) ?? return Err(invalid_socket(text))
            host = slice(host.bytes(), 0, percent)
        }
        bytes = parse_ip_bytes(host) ?? return Err(invalid_socket(text))
        if bytes.len() != 16 -> return Err(invalid_socket(text))
    } else {
        colon :: last_index(raw, 58)
        if colon < 1 || colon + 1 >= raw.len() -> return Err(invalid_socket(text))
        host = slice(raw, 0, colon)
        port_text = slice(raw, colon + 1, raw.len())
        bytes = parse_ipv4_bytes(host) ?? return Err(invalid_socket(text))
    }
    port :: parse_port(port_text) ?? return Err(invalid_socket(text))
    #Unsafe("validated IP octets, port and IPv6 numeric scope transferred into the socket carrier") {
        ip :: core.net.__ip_from_bytes(^bytes)
        return core.net.__socket_from_parts(^ip, U16{port}, U32{0}, U32{scope})
    }
}

fn socket_host(addr: SocketAddr) -> String Never! {
    #Unsafe("read socket IP representation; formatting stays in Jet") { return ip_to_string_impl(core.net.__socket_ip(addr)) }
}
fn socket_port(addr: SocketAddr) -> Int Never! {
    #Unsafe("read native socket port") { return core.net.__socket_port(addr) }
}
fn socket_to_string_impl(addr: SocketAddr) -> String Never! {
    host :: socket_host(addr)
    port :: socket_port(addr)
    if !contains_byte(host, 58) -> return "{host}:{port}"
    scope :: socket_scope(addr)
    if scope == 0 -> "[{host}]:{port}" else -> "[{host}%{scope}]:{port}"
}
fn socket_to_string(addr: SocketAddr) -> String Never! { socket_to_string_impl(addr) }

fn socket_scope(addr: SocketAddr) -> Int Never! {
    #Unsafe("read native IPv6 socket scope identifier") {
        return core.net.__socket_scope(addr) ?? 0
    }
}
fn socket_type(stream: TCPStream) -> String Never! { "stream" }

