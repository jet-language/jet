}

pub fn tcp_shutdown(stream: TCPStream, how: NetShutdown) NetError! -[Net, Time.Wait]> {
    return stream.shutdown(how)
}

pub fn tcp_close(stream: TCPStream) NetError! -[Net, Time.Wait]> {
    return stream.close()
}
pub fn tcp_ready(stream: TCPStream, interest: NetReadyInterest, deadline_ms: Int) -[Net, Time.Wait]> NetReady NetError! {
    if !valid_timeout(deadline_ms) -> return Err(net_err("tcp_ready", "", "deadline must be non-negative"))
    deadline :: Duration.milliseconds(deadline_ms) ?? return Err(net_err("tcp_ready", "", "deadline is too large"))
    stream.ready(interest, deadline: deadline)
}

pub fn ready_readable(ready: NetReady) -> Bool Never! { core.net.ready_readable(ready) }
pub fn ready_writable(ready: NetReady) -> Bool Never! { core.net.ready_writable(ready) }

