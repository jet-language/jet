fn tcp_ready(&stream: TCPStream, interest: NetReadyInterest, deadline_ms: Int) -[Net, Time.Wait]> NetReady NetError! {
    if !valid_timeout(deadline_ms) -> return Err(net_err("tcp_ready", "", "deadline must be non-negative"))
    deadline :: Duration.milliseconds(deadline_ms) ?? return Err(net_err("tcp_ready", "", "deadline is too large"))
    &stream.ready(interest, deadline: deadline)
}

fn ready_readable(ready: NetReady) -> Bool Never! { ready.readable }
