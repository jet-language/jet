pub fn tcp_reply(stream: TCPStream, status: String, body: String) NetError! -[Net, Time.Wait]> {
    if !valid_status(status) -> return Err(net_err("tcp_reply", "", "status must be a three-digit HTTP status without control bytes"))
    core.net.tcp_reply(^stream, status, body)
}

pub fn set_timeout(stream: TCPStream, timeout_ms: Int) NetError! -[Net, Time.Wait]> {
    if !valid_timeout(timeout_ms) -> return Err(net_err("set_timeout", "", "timeout must be non-negative"))
    working := stream
    core.net.set_timeout(&working, timeout_ms)
}

pub fn set_read_timeout(stream: TCPStream, timeout_ms: Int) NetError! -[Net, Time.Wait]> {
    if !valid_timeout(timeout_ms) -> return Err(net_err("set_read_timeout", "", "timeout must be non-negative"))
    working := stream
    core.net.set_read_timeout(&working, timeout_ms)
}

pub fn set_write_timeout(stream: TCPStream, timeout_ms: Int) NetError! -[Net, Time.Wait]> {
