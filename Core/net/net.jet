pub fn error_operation(err: NetError) -> String Never! { return core.net.error_operation(err) }
pub fn error_message(err: NetError) -> String Never! { return core.net.error_message(err) }
pub fn error_address(err: NetError) -> String? Never! { return core.net.error_address(err) }
pub fn error_name(err: NetError) -> String? Never! { return core.net.error_name(err) }
pub fn error_os_code(err: NetError) -> Int? Never! { return core.net.error_os_code(err) }

pub fn addressfamily(addr: SocketAddr) -> String Never! {
    if contains_byte(addr.host, 58) -> "IPv6" else -> "IPv4"
}

fn net_err(op: String, addr: String, message: String) -> NetError Never! {
    NetError.InvalidInput(NetErrorDetail{
        operation: op,
        address: Val(addr),
        name: None,
        message: message,
        os_code: None,
    })
}




fn valid_text(text: String) -> Bool Never! {
    raw :: text.bytes()
    if raw.len() == 0 -> return false
    loop b in raw {
        n :: Int.from_u8(b)
        if n <= 31 || n == 127 -> return false
    }
    true
}

fn valid_status(status: String) -> Bool Never! {
    raw :: status.bytes()
    if raw.len() < 3 -> return false
    if Int.from_u8(raw[0]) < 48 || Int.from_u8(raw[0]) > 57 || Int.from_u8(raw[1]) < 48 || Int.from_u8(raw[1]) > 57 || Int.from_u8(raw[2]) < 48 || Int.from_u8(raw[2]) > 57 -> return false
    if raw.len() > 3 && raw[3] != (U8{32}) -> return false
    loop b in raw {
        n :: Int.from_u8(b)
        if n == 10 || n == 13 -> return false
    }
    true
}

fn valid_host_text(host: String) -> Bool Never! {
    raw :: host.bytes()
    if raw.len() == 0 -> return false
    if raw[0] == (U8{91}) && (raw.len() < 3 || raw[raw.len() - 1] != (U8{93})) -> return false
    i := 0
    loop i < raw.len() {
        n :: Int.from_u8(raw[i])
        if n <= 32 || n == 127 || n == 47 || n == 63 || n == 35 || n == 64 -> return false
        if n == 91 && i != 0 -> return false
        if n == 93 && (i == 0 || raw[0] != (U8{91}) || i != raw.len() - 1) -> return false
        i = i + 1
    }
    true
}

fn valid_port(port: Int) -> Bool Never! { port >= 0 && port <= 65535 }

fn valid_timeout(timeout_ms: Int) -> Bool Never! { timeout_ms >= 0 }

fn starts_with(text: String, prefix: String) -> Bool Never! {
    a :: text.bytes()
    b :: prefix.bytes()
    if b.len() > a.len() -> return false
    loop i in 0..<b.len() {
        if a[i] != b[i] -> return false
    }
    true
}

fn duration_millis(duration: Duration) -> Int Never! {
    if duration.ns < 0 -> return -1
    duration.ns /% 1000000
}

fn format_host_port(host: String, port: Int) -> String Never! {
    raw :: host.bytes()
    if raw.len() > 0 && raw[0] == (U8{91}) -> return "{host}:{port}"
    if contains_byte(host, 58) -> return "[{host}]:{port}"
    "{host}:{port}"
}

fn contains_byte(text: String, needle: Int) -> Bool Never! {
    loop b in text.bytes() {
        if Int.from_u8(b) == needle -> return true
    }
    false
}

fn index_of(raw: [U8], b: Int) -> Int Never! {
    loop i in 0..<raw.len() {
        if Int.from_u8(raw[i]) == b -> return i
    }
    -1
}

fn last_index(raw: [U8], b: Int) -> Int Never! {
    i := raw.len() - 1
    loop i >= 0 {
        if Int.from_u8(raw[i]) == b -> return i
        i = i - 1
    }
    -1
}

fn parse_port(text: String) -> Int? Never! {
    raw :: text.bytes()
    if raw.len() == 0 -> return None
    n := 0
    loop b in raw {
        d :: Int.from_u8(b)
        if d < 48 || d > 57 -> return None
        n = n * 10 + (d - 48)
        if n > 65535 -> return None
    }
    Val(n)
}

fn ascii_lower(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        if n >= 65 && n <= 90 -> &out.push(U8{n + 32}) else -> &out.push(b)
    }
    String.from_bytes(out) ?? ""
}

fn slice(raw: [U8], start: Int, end: Int) -> String Never! {
    String.from_bytes(slice_bytes(raw, start, end)) ?? ""
}

fn slice_bytes(raw: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    limit := if end < raw.len() -> end else -> raw.len()
    if start < 0 || start >= limit -> return out
    loop i in start..<limit -> &out.push(raw[i])
    out
}
