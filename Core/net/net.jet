pub fn dns_a(name: String, ms: Int) -[Net, Time.Wait]> [IPAddr] !NetError {
    if name.bytes().len() == 0 -> return Err(net_err("dns_a", name, "DNS name is empty"))
    if ms < 0 -> return Err(net_err("dns_a", name, "DNS timeout must be non-negative"))
    core.net.dns_a(name, ms)
}

pub fn dns_aaaa(name: String, ms: Int) -[Net, Time.Wait]> [IPAddr] !NetError {
    if name.bytes().len() == 0 -> return Err(net_err("dns_aaaa", name, "DNS name is empty"))
    if ms < 0 -> return Err(net_err("dns_aaaa", name, "DNS timeout must be non-negative"))
    core.net.dns_aaaa(name, ms)
}

pub fn dns_a_at(server: String, name: String, ms: Int) -[Net, Time.Wait]> [IPAddr] !NetError {
    if server.bytes().len() == 0 || name.bytes().len() == 0 -> return Err(net_err("dns_a_at", name, "DNS server/name is empty"))
    if ms < 0 -> return Err(net_err("dns_a_at", name, "DNS timeout must be non-negative"))
    core.net.dns_a_at(server, name, ms)
}

