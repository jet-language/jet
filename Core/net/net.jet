pub fn set_ttl(stream: TCPStream, hops: Int) NetError! -[Net, Time.Wait]> {
    if hops < 0 || hops > 4294967295 -> return Err(net_err("set_ttl", "", "ttl must fit u32"))
    working := stream
    core.net.set_ttl(&working, hops)
}

