use core as core

#Error
pub enum WsError {
    InvalidUrl
    InvalidHandshake
    Protocol
    Timeout
    Closed
    Cancelled
    UnsupportedTarget
    MessageTooLarge(limit: Int)
    IO(operation: String)
}

// The native leaf owns the connected socket, handshake, and frame codec.
// Keep this source boundary typed; do not duplicate provider policy here.
pub fn connect(url: String) -[Net]> WsConn !WsError {
    core.net.ws.connect(url)
}

pub fn upgrade(request: HTTPRequest) -[Net]> WsConn !WsError {
    core.net.ws.upgrade(request)
}

