// core.net.mime — `type/subtype` values and a small extension table.
//
// `parse` accepts `type/subtype` plus `; name=value` parameters. Type
// subtype, and parameter names are folded to lowercase. The extension
// table is the same one CoreLib uses for static HTTP files; unknown
// extensions are absent, never `application/octet-stream`.
#Error
pub enum MIMEError {
    Syntax
}

pub struct MIME {
    pub top: String
    pub sub: String
}

pub fn parse(text: String) -> MIME !MIMEError {
    raw :: trim_ascii(text)
    bytes :: raw.bytes()
    semi := bytes.len()
    i := 0
    loop i < bytes.len() {
        if bytes[i] == (U8{59}) {
            semi = i
            break
        }
        i = i + 1
    }
    essence :: slice(bytes, 0, semi)
    slash := -1
    i = 0
    loop i < essence.bytes().len() {
        if essence.bytes()[i] == (U8{47}) {
            if slash >= 0 -> return Err(MIMEError.Syntax)
            slash = i
        }
        i = i + 1
    }
    if slash <= 0 -> return Err(MIMEError.Syntax)
    top :: ascii_lower(trim_ascii(slice(essence.bytes(), 0, slash)))
    sub :: ascii_lower(trim_ascii(slice(essence.bytes(), slash + 1, essence.bytes().len())))
    if !mime_token(top) || !mime_token(sub) -> return Err(MIMEError.Syntax)

    start := semi + 1
    i = start
    loop i <= bytes.len() {
        if i == bytes.len() || bytes[i] == (U8{59}) {
            parameter :: trim_ascii(slice(bytes, start, i))
            if parameter.bytes().len() > 0 {
                eq := index_of(parameter.bytes(), 61)
                if eq <= 0 -> return Err(MIMEError.Syntax)
                name :: ascii_lower(trim_ascii(slice(parameter.bytes(), 0, eq)))
                if !mime_token(name) -> return Err(MIMEError.Syntax)
            }
            start = i + 1
        }
        i = i + 1
    }
    Ok(MIME{top: top, sub: sub})
}

pub fn from_extension(ext: String) -> ?String {
    key :: ascii_lower(trim_dot(ext))
    if key == {
        "html" | "htm" -> Val("text/html")
        "css" -> Val("text/css")
        "csv" -> Val("text/csv")
        "txt" | "text" -> Val("text/plain")
        "md" -> Val("text/markdown")
        "json" -> Val("application/json")
        "js" | "mjs" -> Val("text/javascript")
        "wasm" -> Val("application/wasm")
        "pdf" -> Val("application/pdf")
        "png" -> Val("image/png")
        "jpg" | "jpeg" -> Val("image/jpeg")
        "gif" -> Val("image/gif")
        "svg" -> Val("image/svg+xml")
        "webp" -> Val("image/webp")
        "ico" -> Val("image/x-icon")
        "mp3" -> Val("audio/mpeg")
        "mp4" -> Val("video/mp4")
        "xml" -> Val("application/xml")
        "zip" -> Val("application/zip")
        "gz" -> Val("application/gzip")
        "tar" -> Val("application/x-tar")
        else -> None
    }
}

pub fn extension(mime: String) -> ?String {
    essence :: ascii_lower(trim_params(mime))
    if essence == {
        "text/html" -> Val("html")
        "text/css" -> Val("css")
        "text/csv" -> Val("csv")
        "text/plain" -> Val("txt")
        "text/markdown" -> Val("md")
        "text/javascript" | "application/javascript" -> Val("js")
        "application/wasm" -> Val("wasm")
        "application/pdf" -> Val("pdf")
        "image/png" -> Val("png")
        "image/jpeg" -> Val("jpg")
        "image/gif" -> Val("gif")
        "image/svg+xml" -> Val("svg")
        "image/webp" -> Val("webp")
        "image/x-icon" -> Val("ico")
        "audio/mpeg" -> Val("mp3")
        "video/mp4" -> Val("mp4")
        "application/xml" | "text/xml" -> Val("xml")
        "application/zip" -> Val("zip")
        "application/gzip" -> Val("gz")
        "application/x-tar" -> Val("tar")
        else -> None
    }
}

fn trim_dot(ext: String) -> String {
    raw :: (~ext).bytes()
    i := 0
    loop i < raw.len() && raw[i] == (U8{46}) -> i = i + 1
    if i > 0 -> return slice(raw, i, raw.len())
    return ~ext
}

fn trim_params(mime: String) -> String {
    raw :: (~mime).bytes()
    loop i in 0..<raw.len() {
        if raw[i] == (U8{59}) -> return trim_ascii(slice(raw, 0, i))
    }
    trim_ascii(mime)
}

fn trim_ascii(text: String) -> String {
    raw :: text.bytes()
    start := 0
    end := raw.len()
    loop {
        if start >= end -> return ""
        n :: Int.from_u8(raw[start])
        if n == 32 || n == 9 || n == 10 || n == 13 -> start = start + 1 else -> break
    }
    loop {
        if end <= start -> return ""
        n :: Int.from_u8(raw[end - 1])
        if n == 32 || n == 9 || n == 10 || n == 13 -> end = end - 1 else -> break
    }
    slice(raw, start, end)
}

fn ascii_lower(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n :: b
        if n >= 65 && n <= 90 -> out.push(U8{n + 32}) else -> out.push(b)
    }
    String.from_bytes(out) ?? ""
}

fn mime_token(text: String) -> Bool {
    raw :: text.bytes()
    if raw.len() == 0 -> return false
    loop b in raw {
        n :: Int.from_u8(b)
        if (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) {
            next
        }
        if n == 33 || n == 35 || n == 36 || n == 38 || n == 45 || n == 94 || n == 95 || n == 46 || n == 43 {
            next
        }
        return false
    }
    true
}

fn index_of(raw: [U8], needle: Int) -> Int {
    loop i in 0..<raw.len() {
        if Int.from_u8(raw[i]) == needle -> return i
    }
    -1
}

fn slice(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    i := start
    loop {
        if i >= end -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i = i + 1
    }
}
