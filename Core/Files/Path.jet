package: {
    name: "core.files.path"
    version: "0.0.1"
    edition: "2026"
    description: "Object paths that beat Python pathlib."
    license: "MIT"
    outputs: {
        path: .Library{ entry: path }
    }
}
use {
    core: core
    files: core.files
}

// core.files.path — pathlib-style paths that beat Python's `pathlib`.
//
// Construction and string math are pure. Existence queries are `-[FS]>`.
// Join never inserts duplicate separators. `..` and `.` collapse through
// `collapse`. Windows drive letters (`C:`) count as absolute.
//
// Beyond PurePath/Path: `join_many`, `parents`, `is_relative_to`, `rglob`
// `ensure_dir`, `read_lines`/`write_lines`, `samefile`, `with_segments`
// `as_uri`, suffix lists, and POSIX/Windows separator conversion.

Path: struct {
    raw: String
}


of: fn(raw: String) -> Path Never! { Path{raw: raw.copy()} }


/// Construct a path from its platform-neutral textual spelling.
path: fn(raw: String) -> Path Never! { of(raw) }


from_parts: fn(parts: [String]) -> Path Never! {
    acc := ""
    loop p in parts {
        if acc.bytes().len() == 0 {
            acc = p
        } else {
            acc = files.join(acc, p)
        }
    }
    Path{raw: acc}
}


cwd: fn() -[FS, Env]> Path IOError! {
    p: files.cwd()
    Ok(Path{raw: p})
}


home: fn() -[FS, Env]> Path IOError! {
    p: files.home()
    Ok(Path{raw: p})
}


join: fn(base: Path, other: String) -> Path Never! { Path{raw: files.join(base.raw, other)} }


join_path: fn(base: Path, other: Path) -> Path Never! { Path{raw: files.join(base.raw, other.raw)} }


join_many: fn(base: Path, parts: [String]) -> Path Never! {
    acc := base
    loop p in parts -> acc = join(acc, p)
    acc
}


parent: fn(path: Path) -> Path Never! { Path{raw: files.dirname(path.raw)} }


ends_colon: fn(text: String) -> Bool {
    raw: text.bytes()
    if raw.len() == 0 -> return false
    raw[raw.len() - 1] == (U8{58})
}


parents: fn(path: Path) -> [Path] Never! {
    out := [Path]{}
    cur := parent(path)
    seen := path.raw.copy()
    loop {
        if cur.raw == seen || cur.raw.bytes().len() == 0 -> return out
        out.push(cur.copy())
        if cur.raw == "/" || (cur.raw.bytes().len() == 2 && ends_colon(cur.raw)) -> return out
        seen = cur.raw.copy()
        nxt := parent(cur)
        if nxt.raw == cur.raw -> return out
        cur = nxt
    }
}


name: fn(path: Path) -> String Never! { files.basename(path.raw) }


stem: fn(path: Path) -> String Never! { files.stem(path.raw) }


suffix: fn(path: Path) -> String Never! { files.suffix(path.raw) }


files_slice: fn(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i < 0 || i >= raw.len() -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i = i + 1
    }
}


suffixes: fn(path: Path) -> [String] Never! {
    n: files.basename(path.raw)
    raw: n.bytes()
    out := [String]{}
    start := -1
    i := 1
    loop i < raw.len() {
        if raw[i] == (U8{46}) {
            if start >= 0 -> out.push(files_slice(raw, start, i))
            start = i
        }
        i = i + 1
    }
    if start >= 0 -> out.push(files_slice(raw, start, raw.len()))
    out
}


with_name: fn(path: Path, name: String) -> Path Never! { Path{raw: files.with_name(path.raw, name)} }


with_suffix: fn(path: Path, suffix: String) -> Path Never! { Path{raw: files.with_suffix(path.raw, suffix)} }


with_stem: fn(path: Path, stem: String) -> Path Never! { Path{raw: files.with_name(path.raw, "{stem}{files.suffix(path.raw)}")} }


with_segments: fn(path: Path, segments: [String]) -> Path Never! { from_parts(segments) }


parts: fn(path: Path) -> [String] Never! { files.split_slash(path.raw) }


is_letter: fn(b: U8) -> Bool {
    n: b
    (n >= 65 && n <= 90) || (n >= 97 && n <= 122)
}


drive: fn(path: Path) -> String Never! {
    raw: path.raw.bytes()
    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{58}) {
        return files_slice(raw, 0, 2)
    }
    ""
}


is_absolute: fn(path: Path) -> Bool Never! { files.is_absolute(path.raw) }


root: fn(path: Path) -> String Never! {
    if is_absolute(path) {
        d: drive(path)
        if d.bytes().len() > 0 -> return "{d}/"
        return "/"
    }
    ""
}


anchor: fn(path: Path) -> String Never! {
    d: drive(path)
    r: root(path)
    if d.bytes().len() > 0 -> return r
    r
}


is_relative: fn(path: Path) -> Bool Never! { !files.is_absolute(path.raw) }


is_empty: fn(path: Path) -> Bool Never! { path.raw.bytes().len() == 0 || path.raw == "." }


as_posix: fn(path: Path) -> String Never! {
    out := [U8]{}
    loop b in path.raw.bytes() {
        if b == (U8{92}) {
            out.push(U8{47})
        } else {
            out.push(b)
        }
    }
    String.from_bytes(out) ?? path.raw.copy()
}


as_windows: fn(path: Path) -> String Never! {
    out := [U8]{}
    loop b in path.raw.bytes() {
        if b == (U8{47}) {
            out.push(U8{92})
        } else {
            out.push(b)
        }
    }
    String.from_bytes(out) ?? path.raw.copy()
}


collapse: fn(path: Path) -> Path Never! { Path{raw: files.collapse(path.raw)} }


resolve_pure: fn(path: Path) -> Path Never! { collapse(path) }


starts_slash: fn(text: String) -> Bool {
    raw: text.bytes()
    raw.len() > 0 && raw[0] == (U8{47})
}


as_uri: fn(path: Path) -> String Never! {
    posix: as_posix(resolve_pure(path))
    if starts_slash(posix) -> return "file://{posix}"
    "file:///{posix}"
}


resolve: fn(path: Path) -[FS, Env]> Path IOError! {
    abs: files.absolute(path.raw)
    Ok(Path{raw: abs})
}


absolute: fn(path: Path) -[FS, Env]> Path IOError! { resolve(path) }


expanduser: fn(path: Path) -[FS, Env]> Path IOError! {
    raw: files.expanduser(path.raw)
    Ok(Path{raw: raw})
}


relative_to: fn(path: Path, start: Path) -> Path Never! { Path{raw: files.relative(path.raw, start.raw)} }


is_relative_to: fn(path: Path, start: Path) -> Bool Never! {
    target: files.collapse(path.raw)
    base: files.collapse(start.raw)
    common: files.commonpath([String]{target.copy(), base.copy()})
    if common != base -> return false
    if base == "." && starts_dotdot(target) -> return false
    true
}


match_glob: fn(path: Path, pattern: String) -> Bool Never! { files.fnmatch(name(path), pattern) }


match_path: fn(path: Path, pattern: String) -> Bool Never! { files.fnmatch(as_posix(path), pattern) }


exists: fn(path: Path) -[FS]> Bool Never! { files.exists(path.raw) }


is_dir: fn(path: Path) -[FS]> Bool Never! { files.is_dir(path.raw) }


is_file: fn(path: Path) -[FS]> Bool Never! { files.is_file(path.raw) }


is_symlink: fn(path: Path) -[FS]> Bool Never! { files.is_symlink(path.raw) }


stat: fn(path: Path) -[FS]> Stat IOError! { files.stat(path.raw) }


size: fn(path: Path) -[FS]> Int IOError! {
    s: files.getsize(path.raw)
    Ok(s)
}


mtime: fn(path: Path) -[FS]> Int IOError! {
    s: files.getmtime(path.raw)
    Ok(s)
}




samefile: fn(a: Path, b: Path) -[FS]> Bool IOError! {
    files.samefile(a.raw, b.raw)
}

read_text: fn(path: Path) -[FS]> String IOError! { files.read(path.raw) }


read_bytes: fn(path: Path) -[FS]> [U8] IOError! { files.read_bytes(path.raw) }


read_lines: fn(path: Path) -[FS]> [String] IOError! { files.read_lines(path.raw) }


write_text: fn(path: Path, text: String) IOError! -[FS]> { files.write(path.raw, text) }


write_bytes: fn(path: Path, bytes: [U8]) IOError! -[FS]> { files.write_bytes(path.raw, bytes) }


write_lines: fn(path: Path, lines: [String]) IOError! -[FS]> { files.write_lines(path.raw, lines) }


append_text: fn(path: Path, text: String) IOError! -[FS]> { files.append_all(path.raw, text) }


mkdir: fn(path: Path, parents: Bool) IOError! -[FS]> {
    if parents -> return files.create_dir_all(path.raw)
    files.create_dir(path.raw)
}


ensure_dir: fn(path: Path) IOError! -[FS]> { files.create_dir_all(path.raw) }


rmdir: fn(path: Path) IOError! -[FS]> { files.remove_dir(path.raw) }


rmtree: fn(path: Path) IOError! -[FS]> { files.remove_all(path.raw) }


unlink: fn(path: Path) IOError! -[FS]> { files.remove(path.raw) }


rename: fn(path: Path, to: Path) IOError! -[FS]> { files.rename(path.raw, to.raw) }


replace: fn(path: Path, to: Path) IOError! -[FS]> { files.relocate(path.raw, to.raw) }


touch: fn(path: Path) IOError! -[FS]> { files.touch(path.raw) }


chmod: fn(path: Path, mode: Int) IOError! -[FS]> { files.set_mode(path.raw, mode) }


symlink_to: fn(path: Path, target: Path) IOError! -[FS]> { files.symlink(target.raw, path.raw) }


hardlink_to: fn(path: Path, target: Path) IOError! -[FS]> { files.hard_link(target.raw, path.raw) }


readlink: fn(path: Path) -[FS]> Path IOError! {
    t: files.read_link(path.raw)
    Ok(Path{raw: t})
}


copy_file: fn(path: Path, to: Path) IOError! -[FS]> { files.copy2(path.raw, to.raw) }


copy_into: fn(path: Path, dir: Path) -[FS]> Path IOError! {
    dest: join(dir, name(path))
    copied: files.copy2(path.raw, dest.raw)
    _: copied
    Ok(dest)
}


glob: fn(path: Path, pattern: String) -[FS]> [Path] IOError! {
    full: files.join(path.raw, pattern) ?? ""
    names: files.glob(full)?("glob")
    out := [Path]{}
    loop n in names -> out.push(Path{raw: n})
    Ok(out)
}

rglob: fn(path: Path, pattern: String) -[FS]> [Path] IOError! {
    first: files.join(path.raw, "**") ?? ""
    full: files.join(first, pattern) ?? ""
    names: files.glob(full)?("glob")
    out := [Path]{}
    loop n in names -> out.push(Path{raw: n})
    Ok(out)
}


iterdir: fn(path: Path) -[FS]> [Path] IOError! {
    entries: files.list_dir(path.raw)
    out := [Path]{}
    loop e in entries -> out.push(Path{raw: e.path})
    Ok(out)
}


walk: fn(path: Path) -[FS]> [Path] IOError! {
    entries: files.walk(path.raw, None)
    out := [Path]{}
    loop e in entries -> out.push(Path{raw: e.path})
    Ok(out)
}


which: fn(name: String) -[FS, Env]> Path? Never! {
    found: files.which(name) ?? return None
    Val(Path{raw: found})
}


open_read: fn(path: Path) -[FS]> FileReader IOError! { files.open(path.raw) }


open_write: fn(path: Path) -[FS]> FileWriter IOError! { files.create(path.raw) }


show: fn(path: Path) -> String Never! { path.raw.copy() }


equals: fn(a: Path, b: Path) -> Bool Never! { files.collapse(a.raw) == files.collapse(b.raw) }


starts_dotdot: fn(text: String) -> Bool {
    raw: text.bytes()
    if raw.len() < 2 -> return false
    if raw[0] != (U8{46}) || raw[1] != (U8{46}) -> return false
    raw.len() == 2 || raw[2] == (U8{47})
}
