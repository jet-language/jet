package: {
    name: "core.files.path"
    version: "0.0.1"
    edition: "2026"
    description: "Object paths that beat Python pathlib."
    license: "MIT"
    outputs: {
        path: .Library{ entry: path }
    }
}

use {
    core: core
    files: core.files
}

// core.files.path — pathlib-style paths that beat Python's `pathlib`.
//
// Construction and string math are pure. Existence queries are `-[FS]>`.
// Join never inserts duplicate separators. `..` and `.` collapse through
// `collapse`. Windows drive letters (`C:`) count as absolute.
//
// Beyond PurePath/Path: `join_many`, `parents`, `is_relative_to`, `rglob`
// `ensure_dir`, `read_lines`/`write_lines`, `samefile`, `with_segments`
// `as_uri`, suffix lists, and POSIX/Windows separator conversion.

Path: struct {
    raw: String,

    /// Lexical component containment: compares normalized lexical components
    /// across separators, `.`, `..`, partial names, and roots.
    /// This is pure lexical comparison and is not symlink truth; canonicalize
    /// both paths on the filesystem when symlink identity matters.
    is_within: fn(self, base: Path) -> Bool Never! { is_within(self, base) }
}

of: fn(raw: String) -> Path Never! { Path{raw: raw.copy()} }

/// Construct a path from its platform-neutral textual spelling.
path: fn(raw: String) -> Path Never! { of(raw) }

from_parts: fn(parts: [String]) -> Path Never! {
    acc := ""
    loop p in parts {
        if acc.bytes().len() == 0 -> acc = p else -> acc = files.join(acc, p)
    }
    Path{raw: acc}
}

cwd: fn() -[FS, Env]> Path IOError! {
    p: files.cwd()
    Ok(Path{raw: p})
}

home: fn() -[FS, Env]> Path IOError! {
    p: files.home()
    Ok(Path{raw: p})
}

join: fn(base: Path, other: String) -> Path Never! { Path{raw: files.join(base.raw, other)} }

join_path: fn(base: Path, other: Path) -> Path Never! { Path{raw: files.join(base.raw, other.raw)} }

join_many: fn(base: Path, parts: [String]) -> Path Never! {
    acc := base
    loop p in parts -> acc = join(acc, p)
    acc
}

parent: fn(path: Path) -> Path Never! { Path{raw: files.dirname(path.raw)} }

ends_colon: fn(text: String) -> Bool {
    raw: text.bytes()
    if raw.len() == 0 -> return false
    raw[raw.len() - 1] == (U8{58})
}

parents: fn(path: Path) -> [Path] Never! {
    out := [Path]{}
    cur := parent(path)
    seen := path.raw.copy()
    loop {
        if cur.raw == seen || cur.raw.bytes().len() == 0 -> return out
        out.push(cur.copy())
        if cur.raw == "/" || (cur.raw.bytes().len() == 2 && ends_colon(cur.raw)) -> return out
        seen = cur.raw.copy()
        nxt := parent(cur)
        if nxt.raw == cur.raw -> return out
        cur = nxt
    }
}

name: fn(path: Path) -> String Never! { files.basename(path.raw) }

stem: fn(path: Path) -> String Never! { files.stem(path.raw) }

suffix: fn(path: Path) -> String Never! { files.suffix(path.raw) }

files_slice: fn(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i < 0 || i >= raw.len() -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i += 1
    }
}

suffixes: fn(path: Path) -> [String] Never! {
    n: files.basename(path.raw)
    raw: n.bytes()
    out := [String]{}
    start := -1
    i := 1
    loop i < raw.len() {
        if raw[i] == (U8{46}) {
            if start >= 0 -> out.push(files_slice(raw, start, i))
            start = i
        }
        i += 1
    }
    if start >= 0 -> out.push(files_slice(raw, start, raw.len()))
    out
}

with_name: fn(path: Path, name: String) -> Path Never! {
    Path{raw: files.with_name(path.raw, name)}
}

with_suffix: fn(path: Path, suffix: String) -> Path Never! {
    Path{raw: files.with_suffix(path.raw, suffix)}
}

with_stem: fn(path: Path, stem: String) -> Path Never! {
    Path{raw: files.with_name(path.raw, "{stem}{files.suffix(path.raw)}")}
}

with_segments: fn(path: Path, segments: [String]) -> Path Never! { from_parts(segments) }

// The anchor (drive and root, when the path has one), then each named
// component, as pathlib's `parts`: the empty components of doubled or
// trailing separators and every `.` drop, and `..` stays (that is
// `collapse`'s job). `from_parts(parts(p))` spells the same path.
parts: fn(path: Path) -> [String] Never! {
    out := [String]{}
    head: anchor(path)
    if head.bytes().len() > 0 -> out.push(head)
    raw: path.raw.bytes()
    rest: files_slice(raw, drive(path).bytes().len(), raw.len())
    loop component in files.split_slash(rest) {
        if component == "" || component == "." -> next
        out.push(component)
    }
    out
}

is_letter: fn(b: U8) -> Bool {
    n: b
    (n >= 65 && n <= 90) || (n >= 97 && n <= 122)
}

drive: fn(path: Path) -> String Never! {
    raw: path.raw.bytes()
    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{58}) -> return files_slice(raw, 0, 2)
    ""
}

is_absolute: fn(path: Path) -> Bool Never! { files.is_absolute(path.raw) }

root: fn(path: Path) -> String Never! {
    if is_absolute(path) {
        d: drive(path)
        if d.bytes().len() > 0 -> return "{d}/"
        return "/"
    }
    ""
}

anchor: fn(path: Path) -> String Never! {
    d: drive(path)
    r: root(path)
    if d.bytes().len() > 0 -> return r
    r
}

is_relative: fn(path: Path) -> Bool Never! { !files.is_absolute(path.raw) }

is_empty: fn(path: Path) -> Bool Never! { path.raw.bytes().len() == 0 || path.raw == "." }

as_posix: fn(path: Path) -> String Never! {
    out := [U8]{}
    loop b in path.raw.bytes() {
        if b == (U8{92}) -> out.push(U8{47}) else -> out.push(b)
    }
    String.from_bytes(out) ?? path.raw.copy()
}

as_windows: fn(path: Path) -> String Never! {
    out := [U8]{}
    loop b in path.raw.bytes() {
        if b == (U8{47}) -> out.push(U8{92}) else -> out.push(b)
    }
    String.from_bytes(out) ?? path.raw.copy()
}

collapse: fn(path: Path) -> Path Never! { Path{raw: files.collapse(path.raw)} }

resolve_pure: fn(path: Path) -> Path Never! { collapse(path) }

starts_slash: fn(text: String) -> Bool {
    raw: text.bytes()
    raw.len() > 0 && raw[0] == (U8{47})
}

as_uri: fn(path: Path) -> String Never! {
    posix: as_posix(resolve_pure(path))
    if starts_slash(posix) -> return "file://{posix}"
    "file:///{posix}"
}

resolve: fn(path: Path) -[FS, Env]> Path IOError! {
    abs: files.absolute(path.raw)
    Ok(Path{raw: abs})
}

absolute: fn(path: Path) -[FS, Env]> Path IOError! { resolve(path) }

expanduser: fn(path: Path) -[FS, Env]> Path IOError! {
    raw: files.expanduser(path.raw)
    Ok(Path{raw: raw})
}

relative_to: fn(path: Path, start: Path) -> Path Never! {
    Path{raw: files.relative(path.raw, start.raw)}
}

is_relative_to: fn(path: Path, start: Path) -> Bool Never! { is_within(path, start) }

priv lexical_parts: fn(path: Path) -> [String] Never! {
    posix: as_posix(path)
    collapsed: files.collapse(posix)
    if collapsed == "." || collapsed == "" -> return [String]{}
    p: Path{raw: collapsed}
    parts(p)
}

/// Lexical component containment: compares normalized lexical components across
/// separators (`/` and `\`), `.`, `..`, partial names (`/a/bc` is not within
/// `/a/b`), and roots (`/`).
/// This is pure lexical comparison and is not symlink truth; canonicalize both
/// paths on the filesystem when symlink identity matters.
is_within: fn(path: Path, base: Path) -> Bool Never! {
    path_abs: is_absolute(Path{raw: as_posix(path)})
    base_abs: is_absolute(Path{raw: as_posix(base)})
    if path_abs != base_abs -> return false
    p_parts: lexical_parts(path)
    b_parts: lexical_parts(base)
    // A relative path that escapes above the base (`..`) is never within `.` or a relative root.
    if !path_abs && b_parts.len() == 0 -> return p_parts.len() == 0 || p_parts[0] != ".."
    if p_parts.len() < b_parts.len() -> return false
    loop i in 0..<b_parts.len() {
        if p_parts[i] != b_parts[i] -> return false
    }
    true
}

match_glob: fn(path: Path, pattern: String) -> Bool Never! { files.fnmatch(name(path), pattern) }

match_path: fn(path: Path, pattern: String) -> Bool Never! {
    files.fnmatch(as_posix(path), pattern)
}

exists: fn(path: Path) -[FS]> Bool Never! { files.exists(path.raw) }

is_dir: fn(path: Path) -[FS]> Bool Never! { files.is_dir(path.raw) }

is_file: fn(path: Path) -[FS]> Bool Never! { files.is_file(path.raw) }

is_symlink: fn(path: Path) -[FS]> Bool Never! { files.is_symlink(path.raw) }

stat: fn(path: Path) -[FS]> Stat IOError! { files.stat(path.raw) }

size: fn(path: Path) -[FS]> Int IOError! {
    s: files.getsize(path.raw)
    Ok(s)
}

mtime: fn(path: Path) -[FS]> Int IOError! {
    s: files.getmtime(path.raw)
    Ok(s)
}

samefile: fn(a: Path, b: Path) -[FS]> Bool IOError! { files.samefile(a.raw, b.raw) }

read_text: fn(path: Path) -[FS]> String IOError! { files.read(path.raw) }

read_bytes: fn(path: Path) -[FS]> [U8] IOError! { files.read_bytes(path.raw) }

read_lines: fn(path: Path) -[FS]> [String] IOError! { files.read_lines(path.raw) }

write_text: fn(path: Path, text: String) -[FS]> IOError! { files.write(path.raw, text) }

write_bytes: fn(path: Path, bytes: [U8]) -[FS]> IOError! { files.write_bytes(path.raw, bytes) }

write_lines: fn(path: Path, lines: [String]) -[FS]> IOError! { files.write_lines(path.raw, lines) }

append_text: fn(path: Path, text: String) -[FS]> IOError! { files.append_all(path.raw, text) }

/// pathlib spelling of `files.create_dir_all`: missing parents are always
/// created, so `parents` does not change the result.
mkdir: fn(path: Path, parents: Bool) -[FS]> IOError! { files.create_dir_all(path.raw) }

ensure_dir: fn(path: Path) -[FS]> IOError! { files.create_dir_all(path.raw) }

rmdir: fn(path: Path) -[FS]> IOError! { files.remove_dir(path.raw) }

rmtree: fn(path: Path) -[FS]> IOError! { files.remove_all(path.raw) }

unlink: fn(path: Path) -[FS]> IOError! { files.remove(path.raw) }

rename: fn(path: Path, to: Path) -[FS]> IOError! { files.rename(path.raw, to.raw) }

replace: fn(path: Path, to: Path) -[FS]> IOError! { files.relocate(path.raw, to.raw) }

touch: fn(path: Path) -[FS]> IOError! { files.touch(path.raw) }

chmod: fn(path: Path, mode: Int) -[FS]> IOError! { files.set_mode(path.raw, mode) }

symlink_to: fn(path: Path, target: Path) -[FS]> IOError! { files.symlink(target.raw, path.raw) }

hardlink_to: fn(path: Path, target: Path) -[FS]> IOError! { files.hard_link(target.raw, path.raw) }

readlink: fn(path: Path) -[FS]> Path IOError! {
    t: files.read_link(path.raw)
    Ok(Path{raw: t})
}

copy_file: fn(path: Path, to: Path) -[FS]> IOError! { files.copy2(path.raw, to.raw) }

copy_into: fn(path: Path, dir: Path) -[FS]> Path IOError! {
    dest: join(dir, name(path))
    copied: files.copy2(path.raw, dest.raw)
    _: copied
    Ok(dest)
}

glob: fn(path: Path, pattern: String) -[FS]> [Path] IOError! {
    full: files.join(path.raw, pattern) ?? ""
    names: files.glob(full)?("glob")
    out := [Path]{}
    loop n in names -> out.push(Path{raw: n})
    Ok(out)
}

rglob: fn(path: Path, pattern: String) -[FS]> [Path] IOError! {
    first: files.join(path.raw, "**") ?? ""
    full: files.join(first, pattern) ?? ""
    names: files.glob(full)?("glob")
    out := [Path]{}
    loop n in names -> out.push(Path{raw: n})
    Ok(out)
}

iterdir: fn(path: Path) -[FS]> [Path] IOError! {
    entries: files.list_dir(path.raw)
    out := [Path]{}
    loop e in entries -> out.push(Path{raw: e.path})
    Ok(out)
}

walk: fn(path: Path) -[FS]> [Path] IOError! {
    out := [Path]{}
    loop entry in files.walk(path.raw, None) {
        item: entry ?? return Err(err)
        out.push(Path{raw: item.path})
    }
    Ok(out)
}

which: fn(name: String) -[FS, Env]> Path? Never! {
    found: files.which(name) ?? return None
    Val(Path{raw: found})
}

open_read: fn(path: Path) -[FS]> FileReader IOError! { files.open(path.raw) }

open_write: fn(path: Path) -[FS]> FileWriter IOError! { files.create(path.raw) }

show: fn(path: Path) -> String Never! { path.raw.copy() }

equals: fn(a: Path, b: Path) -> Bool Never! { files.collapse(a.raw) == files.collapse(b.raw) }

starts_dotdot: fn(text: String) -> Bool {
    raw: text.bytes()
    if raw.len() < 2 -> return false
    if raw[0] != (U8{46}) || raw[1] != (U8{46}) -> return false
    raw.len() == 2 || raw[2] == (U8{47})
}

#Test("Path.is_within compares normalized lexical components and is not symlink truth") {
    // Separator normalization (doubled, trailing, mixed backslash/slash)
    assert(of("/srv/root//sub/file").is_within(of("/srv/root/")))
    assert(of("/srv/root/sub/").is_within(of("/srv/root")))
    assert(of("srv\\root\\sub\\file").is_within(of("srv/root")))
    // Dot and dot-dot lexical collapsing
    assert(of("/srv/root/a/./b/../file").is_within(of("/srv/root")))
    assert(!of("/srv/root/../outside").is_within(of("/srv/root")))
    assert(of("a/b/../c").is_within(of(".")))
    assert(!of("../escape").is_within(of(".")))
    assert(of(".").is_within(of(".")))
    // Partial prefix names must not match
    assert(!of("/srv/rooted/file").is_within(of("/srv/root")))
    assert(!of("/a/bc").is_within(of("/a/b")))
    assert(!of("foo_bar/baz").is_within(of("foo")))
    // Root and absolute/relative boundaries
    assert(of("/").is_within(of("/")))
    assert(of("/a/b").is_within(of("/")))
    assert(of("/a/..").is_within(of("/")))
    assert(!of("a/b").is_within(of("/")))
    assert(!of("/a/b").is_within(of("a")))
    // Same path is within itself
    assert(of("/srv/root").is_within(of("/srv/root")))
    // Pure lexical check: does not consult the filesystem or follow symlinks.
    assert(of("/nonexistent/link/target").is_within(of("/nonexistent/link")))
}

#Test("Path components handle roots, empty paths, separators, and prefixes") {
    // Rooted Unix path
    p_abs: of("/a/b")
    assert_eq(parts(p_abs), [String]{"/", "a", "b"})
    assert_eq(root(p_abs), "/")
    assert_eq(anchor(p_abs), "/")
    assert_eq(drive(p_abs), "")
    assert(is_absolute(p_abs))
    assert_eq(from_parts(parts(p_abs)).raw, "/a/b")

    // Relative path
    p_rel: of("a/b")
    assert_eq(parts(p_rel), [String]{"a", "b"})
    assert_eq(root(p_rel), "")
    assert_eq(anchor(p_rel), "")
    assert_eq(drive(p_rel), "")
    assert(is_relative(p_rel))
    assert_eq(from_parts(parts(p_rel)).raw, "a/b")

    // Empty path and current directory
    p_empty: of("")
    assert_eq(parts(p_empty), [String]{})
    assert(is_empty(p_empty))
    assert(is_relative(p_empty))
    assert_eq(from_parts(parts(p_empty)).raw, "")

    p_dot: of(".")
    assert_eq(parts(p_dot), [String]{})
    assert(is_empty(p_dot))
    assert(is_relative(p_dot))

    // Doubled and trailing separators
    p_seps: of("a//b/")
    assert_eq(parts(p_seps), [String]{"a", "b"})
    assert(is_relative(p_seps))
    assert_eq(from_parts(parts(p_seps)).raw, "a/b")

    // UNC-like prefix spelling
    p_unc: of("//srv/share/x")
    assert_eq(parts(p_unc), [String]{"/", "srv", "share", "x"})
    assert_eq(root(p_unc), "/")
    assert_eq(anchor(p_unc), "/")
    assert(is_absolute(p_unc))
    assert_eq(from_parts(parts(p_unc)).raw, "/srv/share/x")

    // Windows drive prefix with backslashes and drive without separator
    p_win: of("C:\\x\\y")
    assert_eq(parts(p_win), [String]{"C:/", "x", "y"})
    assert_eq(drive(p_win), "C:")
    assert_eq(root(p_win), "C:/")
    assert_eq(anchor(p_win), "C:/")
    assert(is_absolute(p_win))
    assert_eq(from_parts(parts(p_win)).raw, "C:/x/y")

    p_drive: of("C:x")
    assert_eq(parts(p_drive), [String]{"C:/", "x"})
    assert_eq(drive(p_drive), "C:")
    assert_eq(anchor(p_drive), "C:/")
    assert(is_absolute(p_drive))
    assert_eq(from_parts(parts(p_drive)).raw, "C:/x")
}
