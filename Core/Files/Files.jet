package: {
    name: "core.files"
    version: "0.0.1"
    edition: "2026"
    description: "Filesystem handles, paths, and whole-file convenience."
    license: "MIT"
    outputs: {
        files: .Library{ entry: files }
    }
}
use {
    core: core
    unicode: core.text


    sys: core.sys
    process: core.process
    rt: jet.runtime.files
    host_path: __core_files_path_components
    core.files.[__host_path_is_absolute, __host_path_join, __temp_path_sample, __temp_directory]
    access_codes.[access_check, advice_code, map_advice_code]
    scope_reads.[scope_roots, scope_has_parent, scope_part_name, scope_input_error, scope_read_at]
}
// core.files — one filesystem surface.
//
// Whole-file helpers (`read`, `write`, `write_bytes`, `append_all`) and
// streaming constructors (`open`, `create`, `append`) share this namespace.
// `append_all` is the whole-file twin so it does not collide with a handle
// `.append` method. Each filesystem call names the leaf it needs: reads and
// queries are `-[FS.Read]>`, changes are `-[FS.Write]>`, and a call that does
// both keeps `-[FS]>`; current-directory and environment helpers additionally
// carry `-[Env]>`. Missing files,
// permission denials, and type mismatches are `IOError`; nothing here panics
// on a bad path.
//
// `exists` / `is_dir` return booleans rather than errors: a path that cannot
// be observed is treated as absent. `walk` / `walk_files` take an optional
// ignore-file name (`.gitignore` style).
//
// The OS door is the typed `core.files` provider: open/read/write/stat,
// directory, link, temp, lock, and metadata calls route through it. Walk,
// glob, copy composition, and path math remain Jet.
// Open readers, writers, temporary files and directories, and locks own their
// provider resources until their lexical scope exits or they are consumed by
// `close(handle)`. A writer's explicit `flush()` remains fallible.
// Directory copies preserve that boundary: only regular files are copied;
// symlink and other special entries are never dereferenced.


// Why a checked Path literal was rejected.
#Error
PathLiteralError: struct { reason: String }

// The checked `Path{…}` literal: each hole's display text is one percent-
// encoded path component, so its slashes and dot segments never become path
// grammar.
impl Path.CheckedText {
    Error: PathLiteralError
    Hole: String

    check: fn(text: String) PathLiteralError! -[]> {
        if text.bytes().contains(U8{0}) -> return Err(PathLiteralError{reason: "a Path cannot contain a NUL character"})
        return Ok()
    }

    encode_hole: fn<T: Printable>(value: T) -[]> String { "{value}" }

    build: fn(parts: [String], holes: [String]) -[]> Path {
        text := parts[0].copy()
        loop index in 0..<holes.len() -> text = "{text}{path_component_encode(holes[index])}{parts[index + 1]}"
        Path.from(text)
    }
}

path_component_encode: fn(component: String) -> String Never! {
    hex: "0123456789ABCDEF".bytes()
    dots: component == "." || component == ".."
    out := [U8]{}
    loop byte in component.bytes() {
        keep: !dots && ((byte >= (U8{48}) && byte <= (U8{57})) || (byte >= (U8{65}) && byte <= (U8{90})) || (byte >= (U8{97}) && byte <= (U8{122})) || byte == (U8{45}) || byte == (U8{46}) || byte == (U8{95}) || byte == (U8{126}))
        if keep {
            out.push(byte)
        } else {
            out.push(U8{37})
            out.push(hex[Int{byte} >> 4])
            out.push(hex[Int{byte}.bit_and(15)])
        }
    }
    String.from_bytes(out) ?? panic("percent-encoded path text is ASCII")
}

DirEntry: struct {
    name: String
    path: String
    is_dir: Bool
}

/// One entry of `Directory.list`. `raw_name` is the exact
/// name the system stores; `name_is_unicode` is false when those bytes are not
/// valid UTF-8, and then `name` and `path` show each non-ASCII byte as U+FFFD,
/// so only `raw_name` identifies the entry exactly.
DirectoryEntry: struct {
    name: String
    path: String
    is_dir: Bool
    raw_name: [U8]
    name_is_unicode: Bool
}

/// The shown form of a name that is not valid UTF-8: ASCII bytes stay, every
/// other byte becomes U+FFFD.
replacement_name: fn(raw: [U8]) -> String Never! {
    shown := [U8]{}
    loop byte in raw {
        if byte < (U8{128}) {
            shown.push(byte)
        } else {
            shown.push(U8{239})
            shown.push(U8{191})
            shown.push(U8{189})
        }
    }
    String.from_bytes(shown) ?? ""
}

unicode_basename: fn(raw: [U8]) -> String? Never! {
    Val(String.from_bytes(raw) ?? return None)
}

raw_name_order: fn(left: [U8], right: [U8]) -> Ordering Never! {
    i := 0
    loop i < left.len() && i < right.len() {
        if left[i] < right[i] -> return .Less
        if left[i] > right[i] -> return .Greater
        i += 1
    }
    left.len() <=> right.len()
}

/// Whether `create` may replace an existing file.
/// `Refuse` creates exclusively and reports `IOError.AlreadyExists`.
CreateIfExists: enum {
    Replace
    Refuse
}

/// Whether a call follows a final symbolic link. `Refuse`
/// reports `IOError.InvalidInput` when the path ends in a link.
LinkPolicy: enum {
    Follow
    Refuse
}

/// What `rename` does when the target name exists.
/// `Refuse` reports `IOError.AlreadyExists`; `Swap` exchanges both names in
/// one step and reports `IOError.Unsupported` where the system cannot.
RenameIfExists: enum {
    Replace
    Refuse
    Swap
}

/// How a program will read an open or mapped file, so the system can plan
/// its caching (`FileReader.advise`, `MappedFile.advise`). `Sequential`
/// reads ahead further, `Random` stops reading ahead, `WillNeed` starts
/// reading the file into memory now, `DontNeed` drops its cached pages,
/// `NoReuse` marks the data as read once, and `Normal` restores the default.
Advice: enum {
    Normal
    Sequential
    Random
    WillNeed
    DontNeed
    NoReuse
}

/// How a `MappedFile` keeps its bytes fixed while another process writes or
/// truncates the file (`MappedFile.kind()`). `Clone` maps a clone of the
/// file that shares its blocks until either changes. `Held` maps the file
/// itself while nothing can change it: its file system cannot be written, or
/// the map holds a read lease, which the first writer breaks; the map then
/// holds a copy of the bytes it showed and reports `Copy`. `Copy` maps a copy
/// taken when the file was mapped or when its lease broke.
MapKind: enum {
    Clone
    Held
    Copy
}

/// A file's identity, its device plus its file number.
/// Two paths name the same file exactly when their ids are equal.
FileID: struct {
    device: Int
    inode: Int
}

/// What `stat` reports about one directory entry. A final link is described
/// itself, never its target. `owner` is None where the system has no numeric
/// owner (Windows), and `created` is None where the file system keeps no
/// birth time. Times are wall-clock `DateTime` values with nanosecond
/// precision.
Stat: struct {
    size: Int
    kind: String
    mode: Int
    readonly: Bool
    is_file: Bool
    is_dir: Bool
    is_symlink: Bool
    id: FileID
    links: Int
    owner: Int?
    /// Unix reports allocated 512-byte blocks multiplied by 512 with signed saturation; Windows and other non-Unix platforms report logical file length in bytes, not allocated space.
    size_on_disk: Int
    modified: DateTime
    changed: DateTime
    created: DateTime?
}

/// The room on the file system holding a path, in bytes (`space`). `free`
/// counts every unused byte; `available` is the part an unprivileged program
/// may fill, what is left after the blocks the system keeps for its
/// superuser.
DiskSpace: struct {
    total: Int
    free: Int
    available: Int

    /// The bytes in use: everything that is not free.
    used: fn(self) -> Int Never! { self.total - self.free }

    /// The share in use from 0.0 to 100.0, as `df` reports it: used bytes
    /// over used plus available. The superuser's reserve counts as neither,
    /// so a file system that only the superuser can still fill reads 100.
    used_percent: fn(self) -> Float Never! {
        used: self.total - self.free
        room: used + self.available
        if room <= 0 -> return 0.0
        Float{used} * 100.0 / Float{room}
    }
}

WalkEntry: struct {
    path: String
    relative: String
    is_dir: Bool
    depth: Int
}

FileScope: struct {
    authority: Authority

    /// Read only through the authority's descriptor-relative no-follow roots.
    read: fn(self, path: String) -[FS.Read]> String IOError! {
        scoped_read(self, path)
    }
}

// The native file resources below are filled only by Core's own opens:
// their `priv handle` keeps a literal outside core.files from forging one,
// and `path` is computed over `priv stored_path`, so it stays readable
// (core-library.md:635/:701) while no code can write it.
MappedFile: struct {
    priv stored_path: String
    path: String -> stored_path
    bytes: [U8]
    priv handle: Int

    /// Tell the system how the mapped bytes will be read (posix_madvise over
    /// the whole map). Advice only plans paging: the map holds the same file
    /// contents whatever it says, and an empty map accepts any.
    advise: fn(self, advice: Advice) IOError! -[FS.Read]> {
        core.files.__map_advise(self, map_advice_code(advice))
    }

    /// How this map keeps its bytes fixed while the file changes. Every
    /// kind shows the bytes the file held when it was mapped; a `Held` map
    /// becomes `Copy` once a writer breaks its lease.
    kind: fn(self) -> MapKind Never! {
        if core.files.__map_kind(self) == {
            1 -> MapKind.Clone
            2 -> MapKind.Held
            else -> MapKind.Copy
        }
    }
}

TempDir: struct {
    priv stored_path: String
    path: String -> stored_path
    is_dir: Bool
    priv handle: Int
}

TempFile: struct {
    priv stored_path: String
    path: String -> stored_path
    priv handle: Int
}

FileLock: struct {
    priv stored_path: String
    path: String -> stored_path
    priv handle: Int
}


// The fd is guarded before it becomes the native FileLock carrier. Failed
// opens, waits and identity checks therefore close without unlinking a name.
// Close reads the consumed receiver in place. Rebinding it (`held := self.move()`)
// would make a second owner whose scope-end Close re-enters this one.
__LockFd: struct {
    fd: Int

    impl Close {
        close: fn(&&self) {
            _: core.files.__lock_close(self.fd)
        }
    }
}
// The FileLock becomes the descriptor's one owner: the caller's guard is
// disarmed in place (-1 closes nothing), so its scope-end Close never closes
// the descriptor the FileLock now holds.
lock_owner: fn(path: &&String, fd: &__LockFd) -> FileLock Never! {
    value: fd.fd
    fd.fd = -1
    core.files.__lock_owner(path, value)
}

// Private plain records preserve raw host facts without tuple/codec transports.
__LockCall: struct { value: Int, errno: Int, platform: Int }
__LockIdentity: struct {
    device: Int, low: Int, high: Int,
    regular: Bool, reparse: Bool, errno: Int, platform: Int
}
__LockWait: struct {
    acquired: Bool, timed_out: Bool, errno: Int,
    platform: Int, deadline_ns: Int
}

/// An exclusive advisory lock on a held directory. Closing this owner releases
/// the OS lock without removing any filesystem name.
AdvisoryLock: struct {
    priv handle: Int

    impl Close {
        close: fn(&&self) {
            core.files.__close_directory(self.handle)
        }
    }
}

/// An open file for reading. `read_line`, `lines`, `read(max)` and
/// `read_into(buffer, limit)` advance one shared position; `read` returns up
/// to `max` bytes and an empty list at end of file, and `read_into` appends up
/// to `limit` bytes to `buffer` and returns the count, 0 at end of file.
/// Only Core's opens fill the `priv handle`, so a literal outside core.files
/// cannot forge one.
FileReader: struct {
    priv stored_path: String
    path: String -> stored_path
    priv handle: Int

    /// What the open file is now (fstat). Comparing
    /// `id` with a later `files.stat(path).id` shows whether the path was
    /// replaced after the open.
    stat: fn(self) -[FS.Read]> Stat IOError! {
        stat_from_row(core.files.__reader_stat(self))
    }

    read_line: fn(&self) -[FS.Read]> String? IOError! {
        __reader_read_line(self)
    }

    /// Tell the system how the file will be read (posix_fadvise over the
    /// whole file). Advice only plans caching: reads return the same bytes
    /// whatever it says, and a pipe or a system without advice accepts any.
    advise: fn(self, advice: Advice) IOError! -[FS.Read]> {
        core.files.__reader_advise(self, advice_code(advice))
    }

    impl Reader {
        read: fn(&self, limit: Int) -[Time.Wait]> [U8] IOError! {
            rt.reader_read(self, limit)
        }

        read_into: fn(&self, buffer: &[U8], limit: Int) -[Time.Wait]> Int IOError! {
            rt.reader_read_into(self, buffer, limit)
        }
    }
}

/// An open file for writing. `write_line` and `write_all` are buffered;
/// `flush` hands the bytes to the system and `fsync` also makes them durable.
/// Only Core's opens fill the `priv handle`, so a literal outside core.files
/// cannot forge one.
FileWriter: struct {
    priv stored_path: String
    path: String -> stored_path
    priv handle: Int

    /// What the open file is now (fstat). Bytes still
    /// buffered are not counted until `flush` or `fsync`.
    stat: fn(self) -[FS.Read]> Stat IOError! {
        stat_from_row(core.files.__writer_stat(self))
    }

    /// Set the open file's permission bits (0o0..0o7777) without naming its
    /// path again. Windows keeps only the read-only flag.
    set_mode: fn(self, mode: Int) IOError! -[FS.Write]> {
        core.files.__writer_set_mode(self, mode)
    }

    /// Reserve disk space for the first `size` bytes (posix_fallocate), so
    /// later writes there cannot fail for lack of space. A shorter file grows
    /// to `size`, the new bytes zero; a longer one keeps its length.
    /// `IOError.Unsupported` reports a file system that cannot reserve.
    allocate: fn(self, size: Int) IOError! -[FS.Write]> {
        core.files.__writer_allocate(self, size)
    }

    /// `write` hands over every byte, as `write_all` does, and returns the
    /// count; the bytes are buffered until `flush`, `fsync` or close.
    impl Writer {
        write: fn(&self, bytes: [U8]) -[Time.Wait]> Int IOError! {
            rt.writer_write_all(self, bytes) ?? return Err(err)
            Ok(bytes.len())
        }

        write_all: fn(&self, bytes: [U8]) -[Time.Wait]> IOError! {
            rt.writer_write_all(self, bytes)
        }
    }
}


scope: fn(authority: Authority) -[FS]> FileScope Never! { {authority: authority} }


/// Open `path` for reading. `links: .Refuse` refuses a
/// path that ends in a symbolic link. Every handle is close-on-exec.
open: fn(path: String | Path, links: LinkPolicy{.Follow}) -[FS.Read]> FileReader IOError! {
    core.files.__open_reader(-1, path_text(path), link_code(links))
}


/// Open `path` for writing from empty. `if_exists:
/// .Refuse` creates exclusively; `mode` sets a new file's permission bits
/// before the process umask and leaves an existing file's bits alone.
create: fn(path: String | Path, if_exists: CreateIfExists{.Replace}, mode: Int?{None}, links: LinkPolicy{.Follow}) -[FS.Write]> FileWriter IOError! {
    core.files.__open_writer(-1, path_text(path), false, create_code(if_exists), mode ?? -1, link_code(links))
}


/// Open `path` for appending, creating it when missing.
append: fn(path: String | Path, mode: Int?{None}, links: LinkPolicy{.Follow}) -[FS.Write]> FileWriter IOError! {
    core.files.__open_writer(-1, path_text(path), true, 0, mode ?? -1, link_code(links))
}


/// Path parameters take text or a `Path`, the same shape as every other
/// `core.files` path operation.
path_text: fn(path: String | Path) -> String Never! {
    if path == {
        .String(text) -> text.copy()
        .Path(held) -> held.to_string()
    }
}


link_code: fn(links: LinkPolicy) -> Int Never! {
    if links == .Refuse -> return 1
    0
}


create_code: fn(if_exists: CreateIfExists) -> Int Never! {
    if if_exists == .Refuse -> return 1
    0
}


rename_code: fn(if_exists: RenameIfExists) -> Int Never! {
    if if_exists == .Refuse -> return 1
    if if_exists == .Swap -> return 2
    0
}


/// A directory held open. It keeps working after its path
/// is renamed or removed. Every method takes a relative name made of plain
/// parts separated by `/`; each part is opened without following a link, and
/// `..`, `.`, empty parts, and absolute names are refused with
/// `IOError.InvalidInput`. The handle is close-on-exec and closes when it
/// leaves scope or at `close(directory)`.
Directory: struct {
    priv stored_path: String
    path: String -> stored_path
    priv handle: Int

    /// Open the regular file `name` for reading.
    open: fn(self, name: String) -[FS.Read]> FileReader IOError! {
        held_name(self.path, name, false)
        core.files.__open_reader(self.handle, name, 1)
    }

    /// Create the file `name`, with the same labels as `files.create`.
    create: fn(self, name: String, if_exists: CreateIfExists{.Replace}, mode: Int?{None}) -[FS.Write]> FileWriter IOError! {
        held_name(self.path, name, true)
        core.files.__open_writer(self.handle, name, false, create_code(if_exists), mode ?? -1, 1)
    }

    /// Hold the directory `name` inside this one.
    open_directory: fn(self, name: String) -[FS.Read]> Directory IOError! {
        held_name(self.path, name, false)
        key: core.files.__open_directory(self.handle, name)
        Ok(Directory{stored_path: join(self.path, name), handle: key})
    }

    /// Create the directory `name` and hold it. An existing name reports
    /// `IOError.AlreadyExists`.
    create_directory: fn(self, name: String, mode: Int?{None}) -[FS.Read, FS.Write]> Directory IOError! {
        held_name(self.path, name, true)
        core.files.__create_directory(self.handle, name, mode ?? -1)
        key: core.files.__open_directory(self.handle, name)
        Ok(Directory{stored_path: join(self.path, name), handle: key})
    }

    /// The entries in raw-name byte order. A link to a directory has
    /// `is_dir: false`. `raw_name` holds the entry's exact name bytes and
    /// `name_is_unicode` says whether they are valid UTF-8; when they are not,
    /// `name` (and `path`) show each non-ASCII byte as U+FFFD.
    list: fn(self) -[FS.Read]> [DirectoryEntry] IOError! {
        rows: core.files.__list_directory(self.handle)
        out := [DirectoryEntry]{}
        loop row in rows {
            raw := [U8]{}
            i := 1
            loop i < row.len() {
                raw.push(row[i])
                i += 1
            }
            text: unicode_basename(raw)
            unicode: text != None
            name: text ?? replacement_name(raw)
            out.push(DirectoryEntry{
                name: name,
                path: join(self.path, name),
                is_dir: row[0] == (U8{1}),
                raw_name: raw,
                name_is_unicode: unicode,
            })
        }
        out.sort_by(fn(left: DirectoryEntry, right: DirectoryEntry) { raw_name_order(left.raw_name, right.raw_name) })
        Ok(out)
    }

    /// Describe the held directory itself.
    stat: fn(self) -[FS.Read]> Stat IOError! {
        row: core.files.__stat_at(self.handle, "", false)
        Ok(stat_from_row(row))
    }

    /// Describe the entry `name` without following a final link.
    entry_stat: fn(self, name: String) -[FS.Read]> Stat IOError! {
        held_name(self.path, name, false)
        row: core.files.__stat_at(self.handle, name, false)
        Ok(stat_from_row(row))
    }

    /// The text stored in the link `name`, exactly as stored.
    read_link: fn(self, name: String) -[FS.Read]> String IOError! {
        held_name(self.path, name, false)
        core.files.__read_link_at(self.handle, name)
    }

    /// Rename `from` to `to`, both inside this directory unless `into` names
    /// the directory that receives `to`. `if_exists` follows `files.rename`.
    rename: fn(self, from: String, to: String, into: Directory?{None}, if_exists: RenameIfExists{.Replace}) IOError! -[FS.Write]> {
        held_name(self.path, from, true)
        target := self.handle
        target_path := self.path
        if into == {
            Val(other) -> {
                target = other.handle
                target_path = other.path
            }
            .None -> {}
        }
        held_name(target_path, to, true)
        core.files.__rename_at(self.handle, from, target, to, rename_code(if_exists))
    }

    /// Remove the non-directory entry `name`; a link is removed, not followed.
    remove: fn(self, name: String) IOError! -[FS.Write]> {
        held_name(self.path, name, true)
        core.files.__remove_at(self.handle, name, false)
    }

    /// Remove the empty directory `name`.
    remove_directory: fn(self, name: String) IOError! -[FS.Write]> {
        held_name(self.path, name, true)
        core.files.__remove_at(self.handle, name, true)
    }

    /// Flush the held directory so earlier renames inside it are durable.
    fsync: fn(self) IOError! -[FS.Write]> { core.files.__fsync_directory(self.handle) }

    /// Acquire an exclusive, nonblocking flock on this directory's identity.
    /// An independent descriptor owns the lock until the returned owner closes,
    /// even if the directory is renamed or this Directory is closed.
    lock: fn(self) -[FS.Read, FS.Write]> AdvisoryLock IOError! {
        key: core.files.__open_directory(self.handle, ".")
        if core.files.__flock(key, 6) == {
            .Ok(_) -> Ok(AdvisoryLock{handle: key})
            .Err(error) -> {
                core.files.__close_directory(key)
                Err(error)
            }
        }
    }

    /// A fresh handle to this same directory, independent of this one:
    /// closing either leaves the other open, and both keep naming the
    /// directory after its path is renamed. The new handle is opened through
    /// this one, never by path. `spec.keep_open(directory.duplicate())`
    /// keeps the directory open in a child while this handle stays usable.
    duplicate: fn(self) -[FS.Read]> Directory IOError! {
        key: core.files.__open_directory(self.handle, ".")
        Ok(Directory{stored_path: self.stored_path.copy(), handle: key})
    }

    // Kept only for CacheLease, which passes one lease directory into many
    // specs; every other caller uses ProcessSpec.keep_open (#6677).
    /// Pass this directory to the process `spec` starts, open at descriptor
    /// `at` (3 or more): the child inherits a duplicate, so renaming or
    /// closing the directory here afterwards does not change what it sees.
    /// A slot `spec` already passes is `IOError.InvalidInput`.
    pass_to: fn(self, spec: ProcessSpec, at: Int) -[FS, Exec, Env]> ProcessSpec IOError! {
        process_directory(spec, self, at, false)
    }

    impl Close {
        close: fn(&&self) {
            core.files.__close_directory(self.handle)
        }
    }
}

// Compiler-private store bridge, not a public filesystem API. The store
// validates the plain destination name and interprets errno (including EXDEV).
#Unsafe("the compiler store passes a live FileReader and Directory, with one NUL-free plain destination name; no source pathname is reopened") compiler_link_held: fn(source: FileReader, into: Directory, name: String) -[FS.Write]> (available: Bool, held: Bool, value: Int, errno: Int) Never! {
    core.files.jet_files_link_reader_at_raw(source, into.handle, name)
}

// Compiler-private process bridge. The borrowed Directory stays live through
// the raw fd duplication; only the duplicate enters the ProcessSpec carrier.
#Unsafe("compiler store owns the explicit child descriptor slot and retains the held Directory until the process leaf duplicates its descriptor") compiler_with_process_directory: fn(spec: ProcessSpec, directory: Directory, child_fd: Int, as_cwd: Bool) -[FS, Exec, Env]> ProcessSpec IOError! {
    process_directory(spec, directory, child_fd, as_cwd)
}

// Duplicate the held directory into `spec` at `child_fd`, optionally as the
// child's working directory. The Directory is borrowed through the
// duplication, so a later rename or close here never changes the child's view.
process_directory: fn(spec: ProcessSpec, directory: Directory, child_fd: Int, as_cwd: Bool) -[FS, Exec, Env]> ProcessSpec IOError! {
    context: IOContext{operation: .Resolve, resource: Val(directory.stored_path), os_code: None, cause: None}
    if child_fd < 3 || child_fd > 2147483646 {
        return Err(IOError.InvalidInput(IOContext{operation: .Resolve, resource: Val(directory.path), os_code: None,
            cause: Val("the inherited directory descriptor must be between 3 and 2147483646")}))
    }
    held: core.files.__directory_fd(directory.handle)
    if !held.available -> return Err(IOError.Unsupported(context))
    if !held.held -> return Err(IOError.Closed(context))
    row: core.process.__keep_open_raw(spec, held.fd, child_fd, as_cwd)
    if !row.available -> return Err(IOError.Unsupported(context))
    if row.errno != 0 {
        return Err(IOError.Other(IOContext{operation: .Resolve, resource: Val(directory.path),
            os_code: Val(row.errno), cause: Val(core.sys.__errno_text(row.errno))}))
    }
    // The parent's duplicate may sit above `child_fd`; the spawn moves it
    // into the slot. A refused row is a slot `spec` already passes.
    if row.assigned_fd < 0 {
        return Err(IOError.InvalidInput(IOContext{operation: .Resolve, resource: Val(directory.path), os_code: None,
            cause: Val("the requested inherited directory descriptor slot is already passed to this process")}))
    }
    Ok(row.spec)
}

// `spec.keep_open(handle, at:)`, the Core body every tier runs. The child
// `spec` starts gets a duplicate of `handle` at descriptor `at`, or at the
// handle's own number when `at` is None. The spec takes the handle, so the
// parent's descriptor closes here and the duplicate closes with the spec. A
// refusal is recorded on the spec and returned by spawn, run, run_checked and
// plan before any child exists: a slot outside 3 to 2147483646 or one the
// spec already keeps is IOError.InvalidInput, and a failed duplication is
// IOError.Other. A kept FileLock's duplicate shares its lock, so the lock
// stays held while the child (or anything it starts) keeps the descriptor.
__spec_keep_open: fn(spec: ProcessSpec, handle: &&FileReader | FileWriter | FileLock | Directory, at: Int?{None}) -[FS]> ProcessSpec Never! {
    fd: if handle == {
        .FileReader(reader) -> core.files.__reader_fd(reader) ?? -1
        .FileWriter(writer) -> core.files.__writer_fd(writer) ?? -1
        .FileLock(lock) -> core.files.__lock_fd(lock) ?? -1
        .Directory(directory) -> {
            held: core.files.__directory_fd(directory.handle)
            if held.available && held.held -> held.fd else -> -1
        }
    }
    slot: at ?? fd
    child: if slot < 3 || slot > 2147483646 -> -1 else -> slot
    core.process.__keep_open_raw(spec, fd, child, false).spec
}

#Test("compiler process directories retain authority after rename and close") {
    if sys.name() == "linux" {
        root: mktemp("process-held-directory-test")
        destination_path: join(root, "destination")
        source_path: join(root, "source")
        create_dir_all(destination_path) ?? panic("destination")
        create_dir_all(source_path) ?? panic("source")
        write(join(destination_path, "marker.txt"), "held destination\n") ?? panic("marker")
        write(join(source_path, "source.txt"), "held source\n") ?? panic("source marker")
        destination: open_directory(destination_path) ?? panic("hold destination")
        source: open_directory(source_path) ?? panic("hold source")
        initial: process.cmd(["sh", "-c", "cat marker.txt; cat /proc/self/fd/199/source.txt"])
            .cwd("/missing-lexical-process-directory")
        #Unsafe("this test owns both held directories and child descriptor slots 198 and 199 until the child runs") {
            in_destination: compiler_with_process_directory(initial, destination, 198, true) ?? panic("attach destination")
            with_source: compiler_with_process_directory(in_destination, source, 199, false) ?? panic("attach source")
            assert(compiler_with_process_directory(compiler_with_process_directory(process.cmd(["sh", "-c", "exit 0"]), destination, 198, true) ?? panic("first slot"), source, 198, false) == .Err(.InvalidInput(_)))
            close(destination)
            close(source)
            rename(destination_path, join(root, "moved-destination")) ?? panic("rename destination")
            rename(source_path, join(root, "moved-source")) ?? panic("rename source")
            create_dir_all(destination_path) ?? panic("replacement destination")
            create_dir_all(source_path) ?? panic("replacement source")
            write(join(destination_path, "marker.txt"), "wrong destination\n") ?? panic("replacement marker")
            write(join(source_path, "source.txt"), "wrong source\n") ?? panic("replacement source marker")
            receipt: with_source.run() ?? panic("run held directories")
            assert(receipt.success)
            assert(receipt.output == "held destination\nheld source\n")
        }
        remove_all(root) ?? panic("cleanup")
    }
}

#Test("the reader and writer descriptor rows name the open descriptor and flush the writer first") {
    if sys.name() == "linux" {
        root: mktemp("descriptor-rows-test")
        create_dir_all(root) ?? panic("descriptor rows root")
        input_path: join(root, "input.txt")
        output_path: join(root, "output.txt")
        write(input_path, "input\n") ?? panic("input")
        reader: open(input_path) ?? panic("open reader")
        writer := create(output_path) ?? panic("create writer")
        writer.write_line("buffered") ?? panic("buffer a line")
        reader_fd: core.files.__reader_fd(reader) ?? panic("reader descriptor: {err}")
        writer_fd: core.files.__writer_fd(writer) ?? panic("writer descriptor: {err}")
        assert(reader_fd >= 3 && writer_fd >= 3 && reader_fd != writer_fd)
        // The kernel's link is the canonical path, which a symlinked TMPDIR changes.
        assert((read_link("/proc/self/fd/{reader_fd}") ?? panic("reader link")).ends_with("/input.txt"))
        assert((read_link("/proc/self/fd/{writer_fd}") ?? panic("writer link")).ends_with("/output.txt"))
        assert_eq(read(output_path) ?? panic("read output"), "buffered\n")
        assert_eq(core.files.__reader_fd(reader) ?? panic("reader descriptor again"), reader_fd)
        close(reader)
        close(writer)
        remove_all(root) ?? panic("cleanup")
    }
}

#Test("a duplicated directory is independent of the original and keeps the same directory") {
    if sys.name() == "linux" {
        root: mktemp("duplicate-directory-test")
        held_path: join(root, "held")
        create_dir_all(held_path) ?? panic("held")
        write(join(held_path, "held.txt"), "held\n") ?? panic("marker")
        original: open_directory(held_path) ?? panic("hold")
        twin: original.duplicate() ?? panic("duplicate")
        assert(twin.path == original.path)
        original_fd: core.files.__directory_fd(original.handle)
        twin_fd: core.files.__directory_fd(twin.handle)
        assert(original_fd.held && twin_fd.held && original_fd.fd != twin_fd.fd)
        rename(held_path, join(root, "moved")) ?? panic("rename")
        create_dir_all(held_path) ?? panic("replacement")
        write(join(held_path, "replacement.txt"), "wrong\n") ?? panic("replacement marker")
        close(original)
        names := [String]{}
        entries: twin.list() ?? panic("list through the duplicate")
        loop entry in entries -> names.push(entry.name)
        assert(names == [String]{"held.txt"})
        close(twin)
        remove_all(root) ?? panic("cleanup")
    }
}


/// Hold the directory at `path`. The last part must be a
/// real directory, not a link.
open_directory: fn(path: String) -[FS.Read]> Directory IOError! {
    key: core.files.__open_directory(-1, path)
    Ok(Directory{stored_path: path.copy(), handle: key})
}


held_name_error: fn(shown: String, write: Bool, why: String) -> IOError Never! {
    if write {
        return IOError.InvalidInput(IOContext{
            operation: .Write,
            resource: Val(shown),
            os_code: None,
            cause: Val(why),
        })
    }
    IOError.InvalidInput(IOContext{
        operation: .Read,
        resource: Val(shown),
        os_code: None,
        cause: Val(why),
    })
}


// A held-directory name is plain parts separated by `/`.
held_name: fn(base: String, name: String, write: Bool) IOError! {
    shown: join(base.copy(), name.copy())
    raw: (name.copy()).bytes()
    if raw.len() == 0 -> return Err(held_name_error(shown, write, "the name is empty; pass a relative name such as `pkg/data`"))
    if is_abs_impl(name.copy()) -> return Err(held_name_error(shown, write, "the name is absolute; a held directory takes a relative name"))
    start := 0
    i := 0
    loop i <= raw.len() {
        if i == raw.len() || raw[i] == (U8{47}) || raw[i] == (U8{92}) {
            part: slice_path(name.copy(), start, i)
            if part == "" -> return Err(held_name_error(shown, write, "the name has an empty part; remove the doubled or trailing `/`"))
            if part == "." || part == ".." -> return Err(held_name_error(shown, write, "the part `{part}` is refused; a held directory takes only plain names, so open the parent directory instead"))
            start = i + 1
        }
        i = i + 1
    }
}


stat_kind: fn(code: Int) -> String Never! {
    if code == 0 -> return "file"
    if code == 1 -> return "dir"
    if code == 2 -> return "symlink"
    "other"
}


// The provider row order: kind, size, mode, readonly, device, inode, links,
// owner (-1: none), size_on_disk, modified_ns, changed_ns, created present,
// created_ns.
stat_from_row: fn(row: [Int]) -> Stat Never! {
    owner := Int?{None}
    if row[7] >= 0 -> owner = Val(row[7])
    created := DateTime?{None}
    if row[11] == 1 -> created = Val(core.time.from_unix_nanoseconds(row[12]))
    Stat{
        size: row[1],
        kind: stat_kind(row[0]),
        mode: row[2],
        readonly: row[3] == 1,
        is_file: row[0] == 0,
        is_dir: row[0] == 1,
        is_symlink: row[0] == 2,
        id: FileID{device: row[4], inode: row[5]},
        links: row[6],
        owner: owner,
        size_on_disk: row[8],
        modified: core.time.from_unix_nanoseconds(row[9]),
        changed: core.time.from_unix_nanoseconds(row[10]),
        created: created,
    }
}


/// The extended-attribute names on `path` itself, in
/// sorted order. A final link is never followed. Windows and file systems
/// without attributes report none.
extended_attribute_names: fn(path: String) -[FS.Read]> [String] IOError! { core.files.__xattr_names(path) }


/// One extended-attribute value, or None when absent.
extended_attribute: fn(path: String, name: String) -[FS.Read]> [U8]? IOError! {
    core.files.__xattr_get(path, name)
}


/// Write one extended-attribute value on `path` itself.
/// Windows and file systems without attributes report `IOError.Unsupported`.
set_extended_attribute: fn(path: String, name: String, value: [U8]) IOError! -[FS.Write]> {
    core.files.__xattr_set(path, name, value)
}



io_err: fn(operation: String, path: String, message: String) -> IOError Never! {
    if operation == "write" || operation == "mkdir" || operation == "truncate" {
        return IOError.InvalidInput(IOContext{
            operation: .Write,
            resource: Val(path),
            os_code: None,
            cause: Val(message),
        })
    }
    if operation == "resolve" || operation == "home" || operation == "samefile" {
        return IOError.InvalidInput(IOContext{
            operation: .Resolve,
            resource: Val(path),
            os_code: None,
            cause: Val(message),
        })
    }
    IOError.InvalidInput(IOContext{
        operation: .Read,
        resource: Val(path),
        os_code: None,
        cause: Val(message),
    })
}


// Public checkpoints precede OS work exactly once, not once per raw leaf.
file_fault: fn(operation_path: String, operation: IOOperation, path: String) IOError! {
    if rt.fault_should_fail(operation_path) {
        return Err(IOError.Other(IOContext{
            operation: operation.copy(), resource: Val(path), os_code: None,
            cause: Val("fault injected: {operation_path}"),
        }))
    }
    Ok()
}

// Boolean metadata probes answer `false` for any failed probe, so an injected
// FS.Read fault (the same checkpoint `stat` takes) answers `false` too.
read_probe_fault: fn() -> Bool Never! { rt.fault_should_fail("FS.Read") }

file_writer_refusal: fn(path: String) IOError! -[FS.Write]> {
    if core.files.__writer_refusal(path) == {
        .None -> {}
        .Val(error) -> return Err(error)
    }
    Ok()
}

read_bytes: fn(path: String | Path) -[FS.Read]> [U8] IOError! {
    source: path_text(path)
    file_fault("FS.Read", .Read, source)
    core.files.__read_bytes_os(source)
}


read: fn(path: String | Path) -[FS.Read]> String IOError! {
    source: path_text(path)
    bytes: read_bytes(source)
    Ok(String.from_bytes(bytes) ?? return Err(io_err("read", source, "stream did not contain valid UTF-8")))
}

/// The text of the file at `path`, or `fallback` when it cannot be read
/// (missing, unreadable or not UTF-8): `files.read_or(path, "")` is a
/// script's `cat path 2>/dev/null`, its fallback stated in the call.
read_or: fn(path: String | Path, fallback: String) -[FS.Read]> String Never! {
    read(path) ?? fallback
}


map: fn(path: String | Path) -[FS.Read]> MappedFile IOError! {
    text: path_text(path)
    files8_preflight("FS.Read", .Read, text)
    core.files.__map_raw(text)
}


write: fn(path: String | Path, text: String) IOError! -[FS.Write]> {
    target: path_text(path)
    file_fault("FS.Write", .Write, target)
    core.files.__write_bytes_os(target, text.bytes())
}


write_bytes: fn(path: String | Path, bytes: [U8]) IOError! -[FS.Write]> {
    target: path_text(path)
    file_writer_refusal(target)
    file_fault("FS.Write", .Write, target)
    core.files.__write_bytes_os(target, bytes)
}


append_all: fn(path: String | Path, text: String) IOError! -[FS.Write]> {
    target: path_text(path)
    file_fault("FS.Write", .Write, target)
    core.files.__append_bytes_os(target, text.bytes())
}


// `Path.write_atomic(bytes)` calls this with its receiver (one atomic writer).
write_atomic: fn(path: String | Path, bytes: [U8]) IOError! -[FS.Write]> {
    destination: path_text(path)
    file_writer_refusal(destination)
    file_fault("FS.Write", .Write, destination)
    platform: file_path_platform()
    target: host_path.from_text(destination, platform)
    parent_span: host_path.parent_span(target)
    // A bare relative name ("data.bin") has an empty parent: the current directory.
    parent: if parent_span == {
        .None -> host_path.from_text(".", platform)
        .Val(extent) -> if extent.end == extent.start -> host_path.from_text(".", platform) else -> host_path.owned_span(target, extent)
    }
    parent_text: String.from_bytes(parent.encoded) ?? panic("UTF-8 path span")
    pid: core.files.__atomic_pid()
    loop sequence in 0..<128 {
        candidate := parent.copy()
        host_path.push(candidate, host_path.from_text(".jet_tmp_{pid}_{sequence}", platform))
        candidate_text: String.from_bytes(candidate.encoded) ?? panic("UTF-8 temporary path")
        if core.files.__atomic_reserve(destination, candidate_text) == {
            .Err(error) -> {
                if error == {
                    .AlreadyExists(_) -> {}
                    .InvalidInput(_) | .NotFound(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .Unsupported(_) -> { return Err(error) }
                }
            }
            .Ok(handle) -> {
                if core.files.__atomic_finish(handle, bytes, destination, candidate_text) == {
                    .Err(error) -> {
                        _: core.files.__atomic_remove(candidate_text)
                        core.files.__atomic_close(handle)
                        return Err(error)
                    }
                    .Ok(_) -> {}
                }
                core.files.__atomic_close(handle)
                if core.files.__atomic_rename(candidate_text, destination) == {
                    .Err(error) -> {
                        _: core.files.__atomic_remove(candidate_text)
                        return Err(error)
                    }
                    .Ok(_) -> {}
                }
                return core.files.__atomic_sync_parent(parent_text, destination)
            }
        }
    }
    Err(IOError.Other(IOContext{
        operation: .Write, resource: Val(destination), os_code: None,
        cause: Val("could not reserve an atomic-write temporary file"),
    }))
}


read_at: fn(path: String | Path, offset: Int, count: Int) -[FS.Read]> [U8] IOError! {
    source: path_text(path)
    file_fault("FS.Read", .Read, source)
    core.files.__read_at_os(source, if offset < 0 -> 0 else -> offset, if count < 0 -> 0 else -> count)
}


write_at: fn(path: String | Path, offset: Int, bytes: [U8]) IOError! -[FS.Write]> {
    target: path_text(path)
    file_writer_refusal(target)
    file_fault("FS.Write", .Write, target)
    core.files.__write_at_os(target, if offset < 0 -> 0 else -> offset, bytes)
}


fsync: fn(path: String | Path) IOError! -[FS.Write]> {
    text: path_text(path)
    files8_preflight("FS.Write", .Flush, text)
    core.files.__fsync_raw(text)
}


/// Flush every dirty file and directory on the filesystem holding `path` in
/// one `syncfs`. Write a whole tree, sync once, then publish it with a rename
/// instead of syncing file by file.
sync_filesystem: fn(path: String | Path) IOError! -[FS.Write]> {
    text: path_text(path)
    files8_preflight("FS.Write", .Flush, text)
    core.files.__syncfs_raw(text)
}


/// The room on the file system holding `path` (statvfs).
space: fn(path: String | Path) -[FS.Read]> DiskSpace IOError! {
    text: path_text(path)
    files8_preflight("FS.Read", .Read, text)
    row: core.files.__space(text)
    Ok(DiskSpace{total: row[0], free: row[1], available: row[2]})
}


/// Whether this program may read `path` now, judged with its effective user
/// and groups as `open` judges them (faccessat with AT_EACCESS). A missing
/// path, or one that cannot be checked, is false, never an error. The answer
/// can change before the next call, so a program that must read the file
/// opens it and handles that error instead.
can_read: fn(path: String | Path) -[FS.Read]> Bool Never! { access_check(path, 4) }

/// Whether this program may write `path` now; `can_read` explains the check.
can_write: fn(path: String | Path) -[FS.Read]> Bool Never! { access_check(path, 2) }

/// Whether this program may execute `path` now (search it, for a directory);
/// `can_read` explains the check.
can_execute: fn(path: String | Path) -[FS.Read]> Bool Never! { access_check(path, 1) }

// The access check and advice numbers behind can_read, advise and
// map.advise: not part of the files surface.
priv access_codes: module {
    // faccessat's mode bits: R_OK 4, W_OK 2, X_OK 1.
    access_check: fn(path: String | Path, mode: Int) -> Bool Never! {
        if read_probe_fault() -> return false
        if core.files.__access_raw(path_text(path), mode) == {
            .Ok(_) -> true
            .Err(_) -> false
        }
    }

    // posix_fadvise's advice numbers on Linux.
    advice_code: fn(advice: Advice) -> Int Never! {
        if advice == {
            .Normal -> 0
            .Random -> 1
            .Sequential -> 2
            .WillNeed -> 3
            .DontNeed -> 4
            .NoReuse -> 5
        }
    }

    // madvise's advice numbers on Linux: the first five match posix_fadvise's;
    // read-once data is MADV_COLD, which the runtime treats as a no-op on a
    // kernel without it.
    map_advice_code: fn(advice: Advice) -> Int Never! {
        if advice == .NoReuse -> return 20
        advice_code(advice)
    }
}


// A final link is followed, so a broken link does not exist; `lexists` sees the link itself.
exists_impl: fn(path: String) -> Bool Never! {
    row: core.files.__stat_at(-1, path, true) ?? return false
    row[0] >= 0
}


/// Whether something exists at `path`. A final symbolic link is followed, so a
/// broken link is false (`lexists` sees the link itself), and a path that
/// cannot be inspected is false too, never an error.
exists: fn(path: String | Path) -[FS]> Bool Never! {
    if read_probe_fault() -> return false
    exists_impl(path_text(path))
}


is_dir: fn(path: String | Path) -[FS.Read]> Bool Never! {
    if read_probe_fault() -> return false
    text: path_text(path)
    core.files.__metadata_directory(text) ?? false
}


/// Describe `path`. By default a final symbolic link is described itself;
/// `links: .Follow` describes what it points to, and `links: .Refuse`
/// reports `IOError.InvalidInput` when the path ends in a link.
stat: fn(path: String | Path, links: LinkPolicy?{None}) -[FS.Read]> Stat IOError! {
    text: path_text(path)
    file_fault("FS.Read", .Read, text)
    follow: links == .Val(.Follow)
    info: stat_from_row(core.files.__stat_at(-1, text, follow))
    if links == .Val(.Refuse) && info.is_symlink {
        return Err(IOError.InvalidInput(IOContext{operation: .Read, resource: Val(text), os_code: None, cause: Val("path ends in a symbolic link")}))
    }
    Ok(info)
}


/// The same description as `stat`; neither follows a final link.
lstat: fn(path: String | Path) -[FS.Read]> Stat IOError! { stat(path) }


set_mode: fn(path: String | Path, mode: Int) IOError! -[FS.Write]> {
    text: path_text(path)
    files8_preflight("FS.Write", .Write, text)
    if rt.os_family() == "unix" {
        if !files8_u32(mode) -> return Err(files8_other(.Write, Val(text), "file mode must be between 0 and u32::MAX"))
    } else if mode != 0 && mode != 1 {
        return Err(files8_other(.Write, Val(text), "file mode must contain only the readonly bit on this platform"))
    }
    core.files.__set_mode_raw(text, mode)
}

chown: fn(path: String | Path, owner: Int, group: Int) IOError! -[FS.Write]> {
    text: path_text(path)
    if rt.os_family() != "unix" -> return Err(files8_other(.Write, None, "chown is unavailable on this platform"))
    if owner != -1 && !files8_u32(owner) -> return Err(files8_other(.Write, Val(text), "owner must be -1 or a non-negative u32"))
    if group != -1 && !files8_u32(group) -> return Err(files8_other(.Write, Val(text), "group must be -1 or a non-negative u32"))
    loop byte in text.bytes() {
        if byte == (U8{0}) -> return Err(files8_other(.Write, Val(text), "path contains an interior NUL"))
    }
    core.files.__chown_raw(text, owner, group)
}

is_fifo: fn(path: String | Path) -[FS.Read]> Bool IOError! {
    text: path_text(path)
    files8_preflight("FS.Read", .Read, text)
    mode: core.files.__stat_mode_raw(text)
    Ok((mode.bit_and(61440)) == 4096)
}

files8_u32: fn(value: Int) -> Bool Never! { value >= 0 && value <= 4294967295 }

files8_other: fn(operation: IOOperation, resource: String?, cause: String) -> IOError Never! {
    IOError.Other(IOContext{operation: operation, resource: resource, os_code: None, cause: Val(cause)})
}

files8_preflight: fn(probe: String, operation: IOOperation, path: String) IOError! {
    if rt.fault_should_fail(probe) -> return Err(files8_other(operation, Val(path), "fault injected: {probe}"))
    Ok()
}


anchor_for_parts: fn(drive: String, absolute: Bool) -> String Never! {
    if drive.bytes().len() > 0 -> return drive.copy()
    if absolute -> return "/"
    ""
}


join_parts: fn(parts: [String]) -> String Never! {
    s := ""
    first := true
    loop p in parts {
        if p.bytes().len() == 0 -> next
        if first {
            s = p
            first = false
        } else { s = "{s}/{p}" }
    }
    s
}


compose: fn(anchor: String, parts: [String]) -> String Never! {
    s: join_parts(parts)
    if anchor == "/" {
        if s.bytes().len() == 0 -> return "/"
        return "/{s}"
    }
    if anchor.bytes().len() > 0 {
        if s.bytes().len() == 0 -> return "{anchor}/"
        return "{anchor}/{s}"
    }
    if s.bytes().len() == 0 -> return "."
    s
}


is_letter: fn(b: U8) -> Bool Never! {
    n: b
    (n >= 65 && n <= 90) || (n >= 97 && n <= 122)
}


is_abs_impl: fn(path: String) -> Bool Never! {
    raw: path.bytes()
    if raw.len() == 0 -> return false
    if raw[0] == (U8{47}) || raw[0] == (U8{92}) -> return true
    raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{58})
}

is_abs: fn(path: String) -> Bool Never! { is_abs_impl(path) }


is_separator: fn(b: U8) -> Bool Never! { b == (U8{47}) || b == (U8{92}) }


slice: fn(raw: [U8], start: Int, end: Int) -> String Never! {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i < 0 || i >= raw.len() -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i = i + 1
    }
}


split_slash_impl: fn(path: String) -> [String] Never! {
    raw: path.bytes()
    out := [String]{}
    start := 0
    i := 0
    loop i < raw.len() {
        n: raw[i]
        if n == 47 || n == 92 {
            out.push(slice(raw, start, i))
            start = i + 1
        }
        i = i + 1
    }
    out.push(slice(raw, start, raw.len()))
    out
}

split_slash: fn(path: String) -> [String] Never! { split_slash_impl(path) }


collapse_impl: fn(path: String) -> String Never! {
    raw: path.bytes()
    if raw.len() == 0 -> return "."
    absolute: is_abs_impl(path)
    drive := ""
    start := 0
    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{58}) {
        drive = slice(raw, 0, 2)
        start = 2
        if start < raw.len() && is_separator(raw[start]) -> start = start + 1
    } else if absolute {
        start = 1
        loop start < raw.len() && is_separator(raw[start]) -> start = start + 1
    }
    tail: slice(raw, start, raw.len())
    out := [String]{}
    loop p in split_slash_impl(tail) {
        if p == "" || p == "." -> next
        if p == ".." {
            if out.len() > 0 {
                prev: out[out.len() - 1]
                if prev != ".." {
                    _: out.pop()
                    next
                }
            }
            if !absolute -> out.push("..")
            next
        }
        out.push(p)
    }
    compose(anchor_for_parts(drive, absolute), out)
}

collapse: fn(path: String) -> String Never! { collapse_impl(path) }


strip_leading_separators: fn(path: String) -> String Never! {
    raw: path.bytes()
    i := 0
    loop i < raw.len() && is_separator(raw[i]) -> i = i + 1
    slice(raw, i, raw.len())
}


join_impl: fn(a: String, b: String) -> String Never! {
    if b.bytes().len() == 0 -> return a.copy()
    if is_abs_impl(b) -> return b.copy()
    if a.bytes().len() == 0 -> return b.copy()
    clean_b: strip_leading_separators(b)
    if clean_b.bytes().len() == 0 -> return a.copy()
    last: a.bytes()[a.bytes().len() - 1]
    if is_separator(last) -> return "{a}{clean_b}"
    "{a}/{clean_b}"
}

join: fn(a: String, b: String) -> String Never! { join_impl(a, b) }

/// `path` as node's `path.normalize` writes it: `/` separates (`\` is an
/// ordinary character), empty and `.` segments go, `..` takes away the segment
/// before it (a relative path keeps a leading `..`; `/..` is `/`), and a
/// trailing slash stays. "" is ".". `collapse` is Python's `normpath`, which
/// drops the trailing slash and also reads `\` and drive letters.
normalize: fn(path: String) -> String Never! {
    if path == "" -> return "."
    absolute: path.starts_with("/")
    trailing: path.ends_with("/")
    parts := [String]{}
    loop part in path.split("/") {
        if {
            part == "" || part == "." -> {}
            part != ".." -> parts.push(part.copy())
            parts.len() > 0 && parts[parts.len() - 1] != ".." -> { _ := parts.pop() }
            !absolute -> parts.push("..")
            else -> {}
        }
    }
    body: parts.join("/")
    if body == "" {
        return if {
            absolute -> "/"
            trailing -> "./"
            else -> "."
        }
    }
    "{if absolute -> "/" else -> ""}{body}{if trailing -> "/" else -> ""}"
}

/// `parts` joined as node's `path.join` joins them: the non-empty parts joined
/// with `/`, then `normalize`d, so an absolute part stays under the parts
/// before it (`join_all(["/a", "/b"])` is "/a/b", where `join("/a", "/b")` is
/// "/b"). No non-empty part gives ".".
join_all: fn(parts: [String]) -> String Never! {
    normalize(parts.filter(fn(part) { part != "" }).join("/"))
}

/// `path` made absolute against the current directory and `normalize`d, as
/// node's `path.resolve(path)` gives it: no trailing slash, except "/". No
/// file is read; `canonicalize` resolves links.
resolve: fn(path: String) -[FS, Env]> String IOError! {
    whole: normalize(if path.starts_with("/") -> path.copy() else -> "{sys.current_dir()}/{path}")
    Ok(if whole != "/" && whole.ends_with("/") -> whole.removesuffix("/") else -> whole)
}


absolute: fn(path: String | Path) -[FS, Env]> String IOError! {
    text: path_text(path)
    if __host_path_is_absolute(text.copy()) -> return Ok(text)
    cwd: sys.current_dir()
    Ok(__host_path_join(cwd, text))
}

temp_prefix: fn(prefix: String) -> String Never! {
    out := [U8]{}
    loop byte in prefix.bytes() {
        // Continuation bytes belong to the scalar whose lead byte emitted `_`.
        if byte >= (U8{128}) && byte < (U8{192}) -> next
        ascii: (byte >= (U8{48}) && byte <= (U8{57})) ||
            (byte >= (U8{65}) && byte <= (U8{90})) ||
            (byte >= (U8{97}) && byte <= (U8{122}))
        out.push(if ascii -> byte else -> U8{95})
    }
    String.from_bytes(out) ?? ""
}

mktemp: fn(prefix: String) -[FS, Env, Time]> String Never! {
    clean: temp_prefix(prefix)
    row: __temp_path_sample()
    nanos: if row.clock_available -> row.nanos else -> "0"
    pid: sys.getpid()
    __host_path_join(__temp_directory(), "{clean}_{pid}_{nanos}")
}

#Test("temporary path prefixes replace each non-ASCII scalar once") {
    assert(temp_prefix("Az09-é🌍/") == "Az09____")
    assert(temp_prefix("") == "")
}


/// The absolute path of `path` with every symbolic link, `.` and `..`
/// resolved; every part must exist. `missing_last: true` lets the last part
/// be missing, as `readlink -f` does: its parent is resolved and the last
/// name joined to it.
canonicalize: fn(path: String | Path, missing_last: Bool{false}) -[FS.Read]> String IOError! {
    text: path_text(path)
    files8_preflight("FS.Read", .Read, text)
    whole: core.files.__canonicalize_raw(text) ?? {
        missing: err == .NotFound(_)
        if !missing_last || !missing -> return Err(err)
        parent: dirname(text)
        resolved: core.files.__canonicalize_raw(if parent == "" -> "." else -> parent)
        return Ok(join(resolved, basename(text)))
    }
    Ok(whole)
}


/// The entries of directory `path` in name order. With `matching`, only those
/// whose name matches that shell pattern, where `*` is any run of bytes and
/// `?` is one byte: `files.list_dir(dir, matching: "*.files")` is `dir/*.files`.
list_dir: fn(path: String | Path, matching: String?{None}) -[FS.Read]> [DirEntry] IOError! {
    text: path_text(path)
    files8_preflight("FS.Read", .Read, text)
    entries: core.files.__list_dir_raw(text)
    pattern: matching ?? return Ok(entries)
    kept := [DirEntry]{}
    loop entry in entries {
        if entries_glob_match(pattern.bytes(), entry.name.bytes()) -> kept.push(entry.copy())
    }
    Ok(kept)
}

/// The entries of directory `path` as `list_dir` gives them, or `fallback`
/// when it cannot be listed: `files.list_dir_or(dir, [])` is a script's
/// `ls dir 2>/dev/null`, its fallback stated in the call.
list_dir_or: fn(path: String | Path, fallback: [DirEntry], matching: String?{None}) -[FS.Read]> [DirEntry] Never! {
    list_dir(path, matching: matching) ?? fallback
}


dirname_impl: fn(path: String) -> String Never! {
    raw: path.bytes()
    if raw.len() == 0 -> return ""
    end := raw.len()
    loop end > 1 && is_separator(raw[end - 1]) {
        end = end - 1
    }
    if end == 0 -> return "/"
    i := end - 1
    loop i >= 0 {
        if is_separator(raw[i]) {
            if i == 0 -> return "/"
            prefix: slice(raw, 0, i)
            if prefix.bytes().len() == 2 && prefix.bytes()[1] == (U8{58}) {
                return "{prefix}/"
            }
            return prefix
        }
        i = i - 1
    }
    if end >= 2 && is_letter(raw[0]) && raw[1] == (U8{58}) -> return slice(raw, 0, 2)
    ""
}

dirname: fn(path: String) -> String Never! { dirname_impl(path) }


/// Create `path` and any missing parents; an existing directory is success.
create_dir_all: fn(path: String | Path) IOError! -[FS.Write]> {
    target: path_text(path)
    file_fault("FS.Write", .Write, target)
    core.files.__create_dirs_os(target)
}


remove: fn(path: String | Path) IOError! -[FS.Write]> {
    text: path_text(path)
    files8_preflight("FS.Write", .Write, text)
    core.files.__remove_raw(text)
}


remove_dir: fn(path: String | Path) IOError! -[FS.Write]> {
    text: path_text(path)
    files8_preflight("FS.Write", .Write, text)
    core.files.__remove_dir_raw(text)
}


remove_all: fn(path: String | Path) IOError! -[FS]> {
    text: path_text(path)
    files8_preflight("FS.Write", .Write, text)
    directory: core.files.__metadata_directory(text) ?? false
    core.files.__remove_all_raw(text, directory)
}

copy: fn(from: String | Path, to: String | Path) IOError! -[FS]> {
    source: path_text(from)
    target: path_text(to)
    files8_preflight("FS.Read", .Read, source)
    files8_preflight("FS.Write", .Write, target)
    core.files.__copy_raw(source, target)
}


copy_file_impl: fn(from: String, to: String) IOError! -[FS]> {
    bytes: read_bytes(from)
    parent: dirname_impl(to)
    if parent.bytes().len() > 0 -> create_dir_all(parent)
    write_bytes(to.copy(), bytes)
}


copy_dir: fn(from: String | Path, to: String | Path) IOError! -[FS]> {
    source: path_text(from)
    destination: path_text(to)
    files8_preflight("FS.Read", .Read, source)
    files8_preflight("FS.Write", .Write, destination)
    context: rt.entries_context(source, destination, true)
    _guard: core.mem.scope.guard(fn() { rt.entries_close(context) })
    entries_copy_tree(context, 0, source)
}

entries_copy_tree: fn(context: Int, directory: Int, resource: String) IOError! -[FS]> {
    created: rt.entries_mkdir(context, directory)
    if created.status_reason != None -> return Err(walk_error(.Write, created.status, created.status_code, created.status_reason, resource))
    opened: rt.entries_read_dir(context, directory)
    if opened.status_reason != None -> return Err(walk_error(.Read, opened.status, opened.status_code, opened.status_reason, resource))
    loop {
        entry: rt.entries_next(context, directory)
        if entry.status_reason != None -> return Err(walk_error(.Read, entry.status, entry.status_code, entry.status_reason, resource))
        if entry.at_end -> break
        kind: rt.entries_file_type(context, entry.child)
        if kind.status_reason != None -> return Err(walk_error(.Read, kind.status, kind.status_code, kind.status_reason, resource))
        if kind.directory {
            entries_copy_tree(context, entry.child, resource)
        } else if kind.file {
            copied: rt.entries_copy(context, entry.child)
            if copied.status_reason != None -> return Err(walk_error(.Write, copied.status, copied.status_code, copied.status_reason, resource))
        }
        rt.entries_release(context, entry.child)
    }
    Ok()
}


/// Rename `from` to `to`. `if_exists: .Replace`
/// replaces an existing target, `.Refuse` reports `IOError.AlreadyExists`,
/// and `.Swap` exchanges the two names in one step (both must exist).
/// Follow with `fsync(dirname(to))` to make the rename durable.
rename: fn(from: String | Path, to: String | Path, if_exists: RenameIfExists{.Replace}) IOError! -[FS.Write]> {
    core.files.__rename_at(-1, path_text(from), -1, path_text(to), rename_code(if_exists))
}


/// Create `link` as a symbolic link naming `original`. The link text is stored
/// as given and is not resolved; later path operations follow it, so lexical
/// `Path.is_within` cannot see an escape through a link — compare
/// `canonicalize` results instead. `replace: true` first removes a link or
/// file already at `link`, so a link to a directory is replaced, not
/// followed, as `ln -sfn` does; a real directory there is an error.
symlink: fn(original: String | Path, link: String | Path, replace: Bool{false}) IOError! -[FS.Write]> {
    source: path_text(original)
    target: path_text(link)
    files8_preflight("FS.Write", .Write, target)
    platform: rt.os_family()
    if platform != "unix" && platform != "windows" -> return Err(files8_other(.Write, Val(target), "symbolic links are unavailable on this platform"))
    if replace && core.files.__remove_raw(target) == .Err(failure) {
        gone: failure == .NotFound(_)
        if !gone -> return Err(failure)
    }
    directory := false
    if platform == "windows" -> directory = core.files.__symlink_directory_raw(source)
    core.files.__symlink_raw(source, target, directory)
}

/// File operations run best effort, where a script keeps going past one that
/// fails as the shell does (`rm -rf old; mkdir -p new; cp a new/`): each
/// call runs its `core.files` namesake (`copy_file` runs `copy`, since a
/// method can't be named `copy`) and records a failure here instead of
/// returning it, so the failure path stays visible at the call (the receiver
/// is the record) and the run reports what failed once, through `failed()`,
/// `report()` or `failures`.
BestEffort: struct {
    failures: [IOError]

    copy_file: fn(&self, from: String | Path, to: String | Path) Never! -[FS]> {
        if core.files.copy(from, to) == .Err(failure) -> self.failures.push(failure)
    }

    copy_dir: fn(&self, from: String | Path, to: String | Path) Never! -[FS]> {
        if core.files.copy_dir(from, to) == .Err(failure) -> self.failures.push(failure)
    }

    /// `rm -f`: a path that is already gone is no failure.
    remove: fn(&self, path: String | Path) Never! -[FS.Write]> {
        if core.files.remove(path) == .Err(failure) && !(failure == .NotFound(_)) -> self.failures.push(failure)
    }

    /// `rm -rf`: a path that is already gone is no failure.
    remove_all: fn(&self, path: String | Path) Never! -[FS]> {
        if core.files.remove_all(path) == .Err(failure) && !(failure == .NotFound(_)) -> self.failures.push(failure)
    }

    create_dir_all: fn(&self, path: String | Path) Never! -[FS.Write]> {
        if core.files.create_dir_all(path) == .Err(failure) -> self.failures.push(failure)
    }

    symlink: fn(&self, original: String | Path, link: String | Path, replace: Bool{false}) Never! -[FS.Write]> {
        if core.files.symlink(original, link, replace: replace) == .Err(failure) -> self.failures.push(failure)
    }

    /// The resolved path, or `path` itself when it cannot be resolved (as
    /// `readlink -f path || echo path`), the failure recorded.
    canonicalize: fn(&self, path: String | Path, missing_last: Bool{false}) -[FS.Read]> String Never! {
        core.files.canonicalize(path, missing_last: missing_last) ?? {
            self.failures.push(err)
            path_text(path)
        }
    }

    /// Whether any operation failed.
    failed: fn(self) -> Bool Never! { self.failures.len() > 0 }

    /// One line per failure, in the order they happened; empty when none did.
    report: fn(self) -> String Never! {
        lines := [String]{}
        loop failure in self.failures -> lines.push("{failure}")
        lines.join("\n")
    }
}

/// A new, empty best-effort record: `done := files.best_effort()`.
best_effort: fn() -> BestEffort Never! { {failures: [IOError]{}} }


hard_link: fn(original: String | Path, link: String | Path) IOError! -[FS.Write]> {
    source: path_text(original)
    target: path_text(link)
    files8_preflight("FS.Write", .Write, target)
    core.files.__hard_link_raw(source, target)
}
 
is_socket: fn(path: String | Path) -[FS.Read]> Bool IOError! {
    text: path_text(path)
    files8_preflight("FS.Read", .Read, text)
    mode: core.files.__stat_mode_raw(text)
    Ok((mode.bit_and(61440)) == 49152)
}


read_link: fn(path: String | Path) -[FS.Read]> String IOError! {
    source: path_text(path)
    file_fault("FS.Read", .Read, source)
    core.files.__read_link_os(source)
}


split_lines: fn(text: String) -> [String] Never! {
    raw: text.bytes()
    out := [String]{}
    start := 0
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{10}) {
            line := slice(raw, start, i)
            if line.bytes().len() > 0 && line.bytes()[line.bytes().len() - 1] == (U8{13}) {
                line = slice(line.bytes(), 0, line.bytes().len() - 1)
            }
            out.push(line)
            start = i + 1
        }
        i = i + 1
    }
    if start < raw.len() -> out.push(slice(raw, start, raw.len()))
    out
}


trim: fn(text: String) -> String Never! {
    raw: text.bytes()
    a := 0
    b := raw.len()
    loop a < b {
        n: raw[a]
        if n == 32 || n == 9 -> a = a + 1 else -> break
    }
    loop b > a {
        n: raw[b - 1]
        if n == 32 || n == 9 -> b = b - 1 else { break }
    }
    slice(raw, a, b)
}


glob_bytes: fn(pat: [U8], pi: Int, name: [U8], ni: Int) -> Bool Never! {
    if pi >= pat.len() -> return ni >= name.len()
    if pat[pi] == (U8{42}) {
        if glob_bytes(pat, pi + 1, name, ni) -> return true
        if ni < name.len() -> return glob_bytes(pat, pi, name, ni + 1)
        return false
    }
    if ni >= name.len() -> return false
    if pat[pi] == (U8{63}) -> return glob_bytes(pat, pi + 1, name, ni + 1)
    if pat[pi] == (U8{91}) {
        j := pi + 1
        negated := false
        if j < pat.len() && (pat[j] == (U8{33}) || pat[j] == (U8{94})) {
            negated = true
            j = j + 1
        }
        matched := false
        closed := false
        loop j < pat.len() {
            if pat[j] == (U8{93}) {
                closed = true
                break
            }
            if j + 2 < pat.len() && pat[j + 1] == (U8{45}) && pat[j + 2] != (U8{93}) {
                if name[ni] >= pat[j] && name[ni] <= pat[j + 2] -> matched = true
                j = j + 3
            } else {
                if name[ni] == pat[j] -> matched = true
                j = j + 1
            }
        }
        if !closed -> return pat[pi] == name[ni] && glob_bytes(pat, pi + 1, name, ni + 1)
        if negated -> matched = !matched
        if !matched -> return false
        return glob_bytes(pat, j + 1, name, ni + 1)
    }
    if pat[pi] == name[ni] -> return glob_bytes(pat, pi + 1, name, ni + 1)
    false
}


glob_seg: fn(pat: String, name: String) -> Bool Never! { glob_bytes(pat.bytes(), 0, name.bytes(), 0) }


glob_parts: fn(pat: [String], pi: Int, tgt: [String], ti: Int) -> Bool Never! {
    if pi >= pat.len() -> return ti >= tgt.len()
    if pat[pi] == "**" {
        if glob_parts(pat, pi + 1, tgt, ti) -> return true
        if ti < tgt.len() -> return glob_parts(pat, pi, tgt, ti + 1)
        return false
    }
    if ti >= tgt.len() -> return false
    if !glob_seg(pat[pi], tgt[ti]) -> return false
    glob_parts(pat, pi + 1, tgt, ti + 1)
}


glob_parts_for: fn(path: String) -> [String] Never! {
    raw: path.bytes()
    out := [String]{}
    drive := ""
    absolute: is_abs_impl(path)
    start := 0
    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{58}) {
        drive = slice(raw, 0, 2)
        start = 2
        if start < raw.len() && is_separator(raw[start]) -> start = start + 1
    } else if absolute {
        out.push("/")
        start = 1
        loop start < raw.len() && is_separator(raw[start]) -> start = start + 1
    }
    if drive.bytes().len() > 0 -> out.push(drive)
    loop p in split_slash_impl(slice(raw, start, raw.len())) {
        if p.bytes().len() > 0 -> out.push(p)
    }
    out
}


glob_match_impl: fn(pattern: String, path: String) -> Bool Never! {
    pp: glob_parts_for(pattern)
    tt: glob_parts_for(path)
    glob_parts(pp, 0, tt, 0)
}

glob_match: fn(pattern: String, path: String) -> Bool Never! { glob_match_impl(pattern, path) }


has_separator: fn(path: String) -> Bool Never! {
    loop b in path.bytes() {
        if is_separator(b) -> return true
    }
    false
}


anchor_of: fn(path: String) -> String Never! {
    raw: path.bytes()
    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{58}) -> return slice(raw, 0, 2)
    if raw.len() > 0 && is_separator(raw[0]) -> return "/"
    ""
}


path_parts: fn(path: String) -> [String] Never! {
    raw: path.bytes()
    start := 0
    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{58}) {
        start = 2
        if start < raw.len() && is_separator(raw[start]) -> start = start + 1
    } else if raw.len() > 0 && is_separator(raw[0]) {
        start = 1
        loop start < raw.len() && is_separator(raw[start]) -> start = start + 1
    }
    out := [String]{}
    loop p in split_slash_impl(slice(raw, start, raw.len())) {
        if p.bytes().len() > 0 -> out.push(p)
    }
    out
}


relative_impl: fn(path: String, start: String) -> String Never! {
    a: collapse_impl(path)
    b: collapse_impl(start)
    if anchor_of(a) != anchor_of(b) -> return a
    ap: path_parts(a)
    bp: path_parts(b)
    i := 0
    loop i < ap.len() && i < bp.len() {
        if ap[i] != bp[i] -> break
        i = i + 1
    }
    out := [String]{}
    j := i
    loop j < bp.len() {
        out.push("..")
        j = j + 1
    }
    loop i < ap.len() {
        out.push(ap[i])
        i = i + 1
    }
    s: join_parts(out)
    if s.bytes().len() == 0 -> return "."
    s
}

relative: fn(path: String, start: String) -> String Never! { relative_impl(path, start) }


walk_error: fn(operation: IOOperation, kind: Int, code: Int?, cause: String?, resource: String) -> IOError Never! {
    context: IOContext{operation: operation, resource: Val(resource), os_code: code, cause: cause}
    if kind == {
        1 -> IOError.InvalidInput(context)
        2 -> IOError.NotFound(context)
        3 -> IOError.PermissionDenied(context)
        4 -> IOError.TimedOut(context)
        5 -> IOError.Closed(context)
        6 -> IOError.AlreadyExists(context)
        7 -> IOError.Unsupported(context)
        else -> IOError.Other(context)
    }
}

// The directory and every ancestor must be a real directory, not a symlink.
// The ancestor slots this pushes are released before it returns.
walk_validate: fn(context: Int, directory: Int, root: String) IOError! -[FS]> {
    source: rt.walk_validation_path(context, directory)
    failure := IOError?{None}
    loop ancestor in rt.walk_ancestors(context, source) {
        if failure == None {
            metadata: rt.walk_metadata(context, ancestor)
            if metadata.status_reason != None {
                failure = Val(walk_error(.Read, metadata.status, metadata.status_code, metadata.status_reason, root))
            } else if metadata.link {
                path: rt.walk_shown(context, ancestor)
                failure = Val(walk_error(.Read, 3, None, Val("filesystem walk path contains symlink: {path}"), root))
            }
        }
        rt.walk_release(context, ancestor)
    }
    if failure == None {
        metadata: rt.walk_metadata(context, source)
        if metadata.status_reason != None {
            failure = Val(walk_error(.Read, metadata.status, metadata.status_code, metadata.status_reason, root))
        } else if !metadata.directory {
            path: rt.walk_shown(context, source)
            failure = Val(walk_error(.Read, 0, None, Val("filesystem walk root is not a directory: {path}"), root))
        }
    }
    if source != directory -> rt.walk_release(context, source)
    if failure == .Val(error) -> return Err(error)
    Ok()
}

// One directory of a walk: its kept entries sorted by path, and its child
// directories sorted by subtree key, the child's path and a separator. Every
// path below a child starts with its key, and no sibling's path does, so a
// walk that descends into each child where its key falls among the entries
// yields every path in order without sorting the whole tree. Both lists are
// in reverse, so the next one is the last. Every slot the batch is done with
// is released; a child directory keeps its slot until it is read.
__walk_batch: fn(context: Int, directory: Int, depth: Int, root: String, ignore: String?, files_only: Bool, skip: [String]) -[FS]> __WalkFrame IOError! {
    walk_validate(context, directory, root)
    if ignore != None {
        rules: rt.walk_rules(context, directory, ignore)
        if rules.status_reason != None -> return Err(walk_error(.Read, rules.status, rules.status_code, rules.status_reason, rt.walk_shown(context, directory)))
    }
    opened: rt.walk_read_dir(context, directory)
    if opened.status_reason != None -> return Err(walk_error(.Read, opened.status, opened.status_code, opened.status_reason, root))
    entries := [WalkEntry]{}
    children := [(key: String, directory: Int)]{}
    loop {
        entry: rt.walk_next(context, directory)
        if entry.status_reason != None -> return Err(walk_error(.Read, entry.status, entry.status_code, entry.status_reason, root))
        if entry.at_end -> break
        skipped := skip.len() > 0 && skip.contains(basename(entry.relative))
        if !skipped && ignore != None {
            skipped = entry.rules_file || rt.walk_ignored(context, directory, entry.relative, entry.directory)
        }
        if !skipped && (!files_only || (!entry.directory && entry.file)) {
            entries.push(WalkEntry{path: entry.path, relative: entry.relative, is_dir: entry.directory, depth: depth})
        }
        if skipped || !entry.directory {
            // Only a directory has a child slot to release.
            if entry.child != 0 -> rt.walk_release(context, entry.child)
            next
        }
        if ignore != None -> rt.walk_inherit(context, entry.child, directory)
        // The walk joins a child's name to its directory with `/`.
        children.push((key: "{entry.path}/", directory: entry.child))
    }
    entries.sort_by(fn(left: WalkEntry, right: WalkEntry) { right.path <=> left.path })
    children.sort_by(fn(left: (key: String, directory: Int), right: (key: String, directory: Int)) { right.key <=> left.key })
    Ok(__WalkFrame{entries: entries, children: children, depth: depth})
}

// One directory of a walk being read: the entries and child directories it
// has still to yield, each in reverse walk order.
__WalkFrame: struct {
    entries: [WalkEntry]
    children: [(key: String, directory: Int)]
    depth: Int
}

/// The entries below a directory, read as the walk goes: a loop over it
/// yields each one in path order as `WalkEntry IOError!`, with at most one
/// open directory and one directory's entries in hand at a time. A directory
/// that can't be read yields its error where its entries would be, and the
/// walk goes on. Leaving the loop early closes the walk.
Walk: struct {
    priv root: String
    priv ignore: String?
    priv files_only: Bool
    priv skip: [String]

    /// Every entry in walk order, or the first error the walk meets.
    list: fn(&&self) -[FS]> [WalkEntry] IOError! {
        out := [WalkEntry]{}
        // The cursor's own `next`, not `loop entry in self`: the seed that
        // builds this Core does not yet take a type's nested Iterable as a
        // loop source inside the type's own body.
        cursor := self.iter()
        loop cursor.next() == .Val(entry) -> out.push(entry?)
        Ok(out)
    }

    impl Iterable {
        Iter: __WalkCursor

        iter: fn(&&self) -> __WalkCursor {
            __WalkCursor{root: self.root, ignore: self.ignore, files_only: self.files_only, skip: self.skip, context: 0, frames: [__WalkFrame]{}, done: false}
        }
    }
}

// A walk being read: its context, 0 until the first step opens it, and the
// directories still to finish, the deepest last.
__WalkCursor: struct {
    root: String
    ignore: String?
    files_only: Bool
    skip: [String]
    context: Int
    frames: [__WalkFrame]
    done: Bool

    impl Iterator {
        Item: WalkEntry IOError!

        // Yield the next entry, descending first into each child directory whose
        // subtree key sorts before it.
        next: fn(&self) -[FS]> (WalkEntry IOError!)? {
            if self.done -> return None
            if self.context == 0 {
                if __walk_open(self) == .Err(error) {
                    __walk_finish(self)
                    return Val(Err(error))
                }
            }
            loop self.frames.len() > 0 {
                top: self.frames.len() - 1
                entries: self.frames[top].entries.len()
                children: self.frames[top].children.len()
                if children > 0 && (entries == 0 || self.frames[top].children[children - 1].key < self.frames[top].entries[entries - 1].path) {
                    child: self.frames[top].children.pop() ?? panic("walk child")
                    depth: self.frames[top].depth + 1
                    if __walk_batch(self.context, child.directory, depth, self.root, self.ignore, self.files_only, self.skip) == {
                        .Ok(frame) -> {
                            rt.walk_release(self.context, child.directory)
                            self.frames.push(frame)
                        }
                        .Err(error) -> {
                            rt.walk_release(self.context, child.directory)
                            return Val(Err(error))
                        }
                    }
                    next
                }
                if self.frames[top].entries.pop() == .Val(entry) -> return Val(Ok(entry))
                _ := self.frames.pop()
            }
            __walk_finish(self)
            None
        }
    }

    impl Close {
        close: fn(&&self) {
            if self.context != 0 -> rt.walk_close(self.context)
        }
    }
}

__walk_open: fn(cursor: &__WalkCursor) IOError! -[FS]> {
    files8_preflight("FS.Read", .Read, cursor.root)
    cursor.context = rt.walk_context(cursor.root, cursor.ignore ?? "", cursor.ignore != None)
    walk_validate(cursor.context, 0, cursor.root)
    if cursor.ignore != None -> rt.walk_matcher_new(cursor.context)
    cursor.frames.push(__walk_batch(cursor.context, 0, 0, cursor.root, cursor.ignore, cursor.files_only, cursor.skip))
    Ok()
}

// The walk is over: close its context so no descriptor or slot outlives it.
__walk_finish: fn(cursor: &__WalkCursor) -[FS]> {
    cursor.done = true
    cursor.frames = [__WalkFrame]{}
    if cursor.context != 0 -> rt.walk_close(cursor.context)
    cursor.context = 0
}


/// The entries below `root`, every directory and file, read lazily in path
/// order (see `Walk`); the call keeps the FS authority every walk needs. An
/// entry whose name is in `skip` is neither yielded nor entered, as
/// `find root -name NAME -prune` leaves it out.
walk: fn(root: String | Path, ignore: String?{None}, skip: [String]{[String]{}}) -[FS]> Walk {
    Walk{root: path_text(root), ignore: ignore, files_only: false, skip: skip}
}


walk_files: fn(root: String | Path, ignore: String?{None}, skip: [String]{[String]{}}) -[FS]> Walk {
    Walk{root: path_text(root), ignore: ignore, files_only: true, skip: skip}
}




// Match the native byte grammar: '*' crosses separators, '?' is one byte,
// brackets have no special meaning. Backtracking retains byte indexes only.
entries_glob_match: fn(pattern: [U8], path: [U8]) -> Bool Never! {
    p := 0
    t := 0
    star := -1
    restart := 0
    loop t < path.len() {
        if p < pattern.len() && (pattern[p] == (U8{63}) || (pattern[p] != (U8{42}) && pattern[p] == path[t])) {
            p += 1
            t += 1
        } else if p < pattern.len() && pattern[p] == (U8{42}) {
            star = p
            p += 1
            restart = t
        } else if star >= 0 {
            restart += 1
            t = restart
            p = star + 1
        } else { return false }
    }
    loop p < pattern.len() && pattern[p] == (U8{42}) -> p += 1
    p == pattern.len()
}

entries_glob_root: fn(pattern: String, separator: U8) -> String Never! {
    bytes: pattern.bytes()
    last := -1
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{42}) || bytes[index] == (U8{63}) -> break
        if bytes[index] == separator -> last = index
    }
    if last <= 0 -> "." else -> slice(bytes, 0, last)
}

entries_glob_tree: fn(context: Int, directory: Int, resource: String, output: &[String]) IOError! -[FS]> {
    opened: rt.entries_read_dir(context, directory)
    if opened.status_reason != None -> return Err(walk_error(.Read, opened.status, opened.status_code, opened.status_reason, resource))
    children := [Int]{}
    // Native collect fails on iteration errors before inspecting any file_type.
    loop {
        entry: rt.entries_next(context, directory)
        if entry.status_reason != None -> return Err(walk_error(.Read, entry.status, entry.status_code, entry.status_reason, resource))
        if entry.at_end -> break
        children.push(entry.child)
    }
    children.sort_by(fn(left: Int, right: Int) {
        if rt.entries_before(context, left, right) -> return Ordering.Less
        if rt.entries_before(context, right, left) -> return Ordering.Greater
        Ordering.Equal
    })
    loop child in children {
        output.push(rt.entries_shown(context, child))
        kind: rt.entries_file_type(context, child)
        if kind.status_reason != None -> return Err(walk_error(.Read, kind.status, kind.status_code, kind.status_reason, resource))
        if kind.directory -> entries_glob_tree(context, child, resource, output)
        rt.entries_release(context, child)
    }
    Ok()
}

glob: fn(pattern: String | Path) -[FS]> [String] IOError! {
    resource: path_text(pattern)
    files8_preflight("FS.Read", .Read, resource)
    separator: if rt.os_family() == "windows" -> U8{92} else -> U8{47}
    root: entries_glob_root(resource, separator)
    context: rt.entries_context(root, "", false)
    _guard: core.mem.scope.guard(fn() { rt.entries_close(context) })
    paths := [String]{}
    entries_glob_tree(context, 0, resource, paths)
    bytes: resource.bytes()
    matches := [String]{}
    loop path in paths { if entries_glob_match(bytes, path.bytes()) -> matches.push(path) }
    matches.sort()
    Ok(matches)
}


temp_dir: fn(prefix: String) -[FS]> TempDir IOError! {
    path: files_temp_path(prefix)
    files8_preflight("FS.Write", .Write, path)
    core.files.__temp_dir_raw(path)
}

mkdtemp: fn(prefix: String) -[FS]> String IOError! {
    path: files_temp_path(prefix)
    files8_preflight("FS.Write", .Write, path)
    core.files.__mkdtemp_raw(path)
}

files_temp_path: fn(prefix: String) -[FS]> String Never! {
    clean: temp_prefix(prefix)
    clock: core.files.__temp_clock_raw()
    nanos: if clock.clock_available -> clock.nanos else -> "0"
    pid: rt.process_id_raw()
    __host_path_join(core.files.__temp_directory_raw(), "{clean}_{pid}_{nanos}")
}


temp_file: fn(prefix: String) -[FS]> TempFile IOError! {
    path: files_temp_path(prefix)
    files8_preflight("FS.Write", .Write, path)
    core.files.__temp_file_raw(path)
}


/// Wait for an exclusive operating-system lock. A missing
/// lock file is created owner-only; a final symbolic link is refused. Closing
/// the returned owner releases the lock but never removes the lock file.
/// `timeout` bounds acquisition; omitting it waits without limit.
lock: fn(path: String | Path, timeout: Duration?{None}) -[FS, Env]> FileLock IOError! {
    text: path_text(path)
    files8_preflight("FS.Write", .Write, text)
    lock_path(text)
    bounded: timeout != None
    ns := 0
    if timeout == .Val(duration) -> ns = duration.ns
    deadline := 0
    loop {
        fd := lock_open(text)
        waited: core.files.__lock_wait(fd.fd, ns, bounded, deadline)
        deadline = waited.deadline_ns
        if waited.timed_out -> return Err(lock_timeout(text))
        if !waited.acquired -> return Err(lock_errno(text, waited.errno, waited.platform))
        if lock_current(text, fd.fd) -> return Ok(lock_owner(text, fd))
        // A replacement never inherits this claim. Scope exit closes the old
        // inode before the next open; every retry retains the original deadline.
    }
}

/// Return None only when another owner holds the exclusive system lock.
/// Missing paths are created as with `lock`; other failures remain errors.
try_lock: fn(path: String | Path) -[FS, Env]> FileLock? IOError! {
    text: path_text(path)
    files8_preflight("FS.Write", .Write, text)
    lock_path(text)
    loop {
        fd := lock_open(text)
        result: core.files.__lock_try(fd.fd)
        if result.value != 0 {
            if lock_contended(result.errno, result.platform) -> return Ok(None)
            return Err(lock_errno(text, result.errno, result.platform))
        }
        if lock_current(text, fd.fd) -> return Ok(Val(lock_owner(text, fd)))
    }
}

lock_context: fn(path: String, code: Int?, cause: String) -> IOContext Never! {
    IOContext{operation: .Write, resource: Val(path), os_code: code, cause: Val(cause)}
}

lock_path: fn(path: String) IOError! {
    loop byte in path.bytes() {
        if byte == (U8{0}) -> return Err(IOError.InvalidInput(lock_context(path, None, "the lock path contains NUL; pass a filesystem path without NUL")))
    }
}

lock_timeout: fn(path: String) -> IOError Never! {
    IOError.TimedOut(lock_context(path, None, "timed out waiting for an exclusive file lock; retry or allow a longer timeout"))
}

// Contention: Linux EWOULDBLOCK=EAGAIN(11), macOS EWOULDBLOCK=EAGAIN(35),
// Windows ERROR_LOCK_VIOLATION(33). The Rust originals use those same kernel
// results.
lock_contended: fn(code: Int, platform: Int) -> Bool Never! {
    (platform == 1 && code == 11) || (platform == 2 && code == 35) || (platform == 3 && code == 33)
}

// Project native errno exactly as jet_std::io_error_at projects
// std::io::ErrorKind. Unknown kinds stay Other. In particular
// EBADF/ERROR_INVALID_HANDLE are NOT Closed: the shared mapper reserves Closed
// for NotConnected/BrokenPipe.
lock_errno: fn(path: String, code: Int, platform: Int) -> IOError Never! {
    if platform == 0 -> return IOError.Unsupported(lock_context(path, None, "file locking is unavailable on this operating system"))
    context: lock_context(path, Val(code), core.sys.__errno_text(code))
    if platform == 3 {
        // std library/std/src/sys/io/error/windows.rs decode_error_kind (blob 6056f177),
        // constants in library/std/src/sys/pal/windows/c/windows_sys.rs (blob 0c865494).
        if code == 2 || code == 3 || code == 15 || code == 53 || code == 67 -> return IOError.NotFound(context)
        if code == 5 || code == 10013 -> return IOError.PermissionDenied(context)
        if code == 80 || code == 183 -> return IOError.AlreadyExists(context)
        if code == 87 || code == 131 || code == 10022 -> return IOError.InvalidInput(context)
        if code == 109 || code == 232 || code == 10057 || code == 10058 -> return IOError.Closed(context)
        if code == 121 || code == 258 || code == 594 || code == 995 || code == 1053 || code == 1121 || code == 1460 ||
            code == 5910 || code == 7012 || code == 7040 || code == 8014 || code == 8226 || code == 9705 ||
            code == 10060 || code == 13805 || code == 15402 || code == 15403 -> return IOError.TimedOut(context)
        // FILEERROR1: ERROR_NOT_SUPPORTED(50); std: ERROR_CALL_NOT_IMPLEMENTED(120).
        if code == 50 || code == 120 -> return IOError.Unsupported(context)
    } else {
        if code == 2 -> return IOError.NotFound(context)
        // std library/std/src/sys/io/error/unix.rs decode_error_kind (blob 5f60abf9);
        // Linux rows also observed against rust 1.97.1's installed decoder.
        if code == 1 || code == 13 -> return IOError.PermissionDenied(context)
        if code == 22 -> return IOError.InvalidInput(context)
        if code == 17 -> return IOError.AlreadyExists(context)
        if code == 32 || (platform == 1 && code == 107) || (platform == 2 && code == 57) -> return IOError.Closed(context)
        if (platform == 1 && code == 110) || (platform == 2 && code == 60) -> return IOError.TimedOut(context)
        // Unsupported override plus std ENOSYS.
        if (platform == 1 && (code == 38 || code == 95)) || (platform == 2 && (code == 45 || code == 78 || code == 102)) -> return IOError.Unsupported(context)
        // Existing no-follow-open rule.
        if (platform == 1 && code == 40) || (platform == 2 && code == 62) {
            return IOError.InvalidInput(lock_context(path, Val(code), "the final lock path is a symbolic link; use a regular lock file"))
        }
    }
    IOError.Other(context)
}

lock_open: fn(path: String) -[FS, Env]> __LockFd IOError! {
    opened: core.files.__lock_open(path)
    if opened.value < 0 -> return Err(lock_errno(path, opened.errno, opened.platform))
    fd: __LockFd{fd: opened.value}
    identity: core.files.__lock_fd_identity(fd.fd)
    if identity.errno != 0 -> return Err(lock_errno(path, identity.errno, identity.platform))
    if !identity.regular || identity.reparse {
        return Err(IOError.InvalidInput(lock_context(path, None, "the lock path must name a regular file, not a directory or link")))
    }
    Ok(fd)
}

lock_current: fn(path: String, fd: Int) -[FS, Env]> Bool IOError! {
    held: core.files.__lock_fd_identity(fd)
    if held.errno != 0 -> return Err(lock_errno(path, held.errno, held.platform))
    current: core.files.__lock_path_identity(path)
    // Disappearance and replacement release and reopen. Other lookup failures
    // are real errors, never mistaken for contention or an absent attribute.
    if current.errno != 0 {
        if (current.platform == 3 && (current.errno == 2 || current.errno == 3)) || (current.platform != 3 && current.errno == 2) -> return Ok(false)
        return Err(lock_errno(path, current.errno, current.platform))
    }
    Ok(current.regular && !current.reparse && held.device == current.device && held.low == current.low && held.high == current.high)
}


basename: fn(path: String) -> String Never! {
    raw: path.bytes()
    i := raw.len() - 1
    loop i >= 0 {
        if raw[i] == (U8{47}) || raw[i] == (U8{92}) -> return slice(raw, i + 1, raw.len())
        i = i - 1
    }
    path.copy()
}


suffix: fn(path: String) -> String Never! {
    name: basename(path)
    raw: name.bytes()
    i := raw.len() - 1
    loop i > 0 {
        if raw[i] == (U8{46}) -> return slice(raw, i, raw.len())
        i = i - 1
    }
    ""
}


stem: fn(path: String) -> String Never! {
    name: basename(path)
    raw: name.bytes()
    i := raw.len() - 1
    loop i > 0 {
        if raw[i] == (U8{46}) -> return slice(raw, 0, i)
        i = i - 1
    }
    name
}


with_suffix: fn(path: String, next: String) -> String Never! {
    dir: dirname(path)
    base: stem(path)
    joined: "{base}{next}"
    if dir.bytes().len() == 0 -> return joined
    join(dir, joined)
}


with_name: fn(path: String, name: String) -> String Never! {
    dir: dirname(path)
    if dir.bytes().len() == 0 -> return name.copy()
    join(dir, name)
}


is_absolute: fn(path: String) -> Bool Never! { is_abs(path) }


// Like `is_dir` and a shell's `test -f`, a final link is followed: a link to a
// file is a file. A PATH search relies on this, since package managers install
// tools as links.
is_file_impl: fn(path: String) -> Bool Never! {
    row: core.files.__stat_at(-1, path, true) ?? return false
    row[0] == 0
}

is_file: fn(path: String) -[FS]> Bool Never! {
    if read_probe_fault() -> return false
    is_file_impl(path)
}


is_symlink: fn(path: String) -[FS]> Bool Never! {
    if read_probe_fault() -> return false
    row: core.files.__stat_at(-1, path, false) ?? return false
    row[0] == 2
}


cwd: fn() -[FS, Env]> String IOError! { sys.current_dir() }


home: fn() -[FS, Env]> String IOError! {
    core.sys.home_dir() ?? return Err(io_err("home", "", "home directory unavailable"))
}


expanduser: fn(path: String) -[FS, Env]> String IOError! {
    raw: path.bytes()
    if raw.len() == 0 || raw[0] != (U8{126}) -> return Ok(path.copy())
    h: home()
    if raw.len() == 1 -> return Ok(h)
    if raw[1] == (U8{47}) || raw[1] == (U8{92}) -> return Ok(join_impl(h, slice(raw, 2, raw.len())))
    Ok(path.copy())
}


touch: fn(path: String) IOError! -[FS]> {
    if exists_impl(path) {
        core.files.fsync(path)
        return Ok()
    }
    parent: dirname_impl(path)
    if parent.bytes().len() > 0 -> create_dir_all(parent)
    write_bytes(path, [U8]{})
}


relocate: fn(from: String, to: String) IOError! -[FS]> { rename(from, to) }


/// Python-compatible spelling for an atomic replacement rename.
replace: fn(from: String, to: String) IOError! -[FS]> { relocate(from, to) }


/// Return `path` relative to `start`, using the same normalized path rules.
relativeto: fn(path: String, start: String) -> String Never! { relative(path, start) }


/// Python-compatible spelling for `set_mode`.
chmod: fn(path: String, mode: Int) IOError! -[FS]> { core.files.set_mode(path, mode) }


/// Copy the bytes of `from` to `to`, creating missing parent directories.
/// Unlike Python's `shutil.copy2`, permission bits and timestamps are not
/// copied: the new file takes the default mode.
copy2: fn(from: String, to: String) IOError! -[FS]> { copy_file_impl(from, to) }


/// Python-compatible spelling for a single-file copy.
copyfile: fn(from: String, to: String) IOError! -[FS]> { copy2(from, to) }


/// Python-compatible spelling of `create_dir_all`: missing parents are always
/// created, so `parents` does not change the result.
mkdir: fn(path: String, parents: Bool) IOError! -[FS]> { create_dir_all(path) }


rmdir: fn(path: String) IOError! -[FS]> { core.files.remove_dir(path) }


unlink: fn(path: String) IOError! -[FS]> { core.files.remove(path) }


joinpath: fn(a: String, b: String) -> String Never! { join(a, b) }


/// Python `os` spellings backed by the same checked filesystem surface.
getcwd: fn() -[FS, Env]> String IOError! { cwd() }


chdir: fn(path: String) IOError! -[FS, Env]> { sys.set_current_dir(path) }


scandir: fn(path: String) -[FS]> [DirEntry] IOError! { core.files.list_dir(path) }


gettempdir: fn() -[Env]> String Never! { sys.temp_dir() }


getenv: fn(name: String) -[Env]> String? Never! { sys.get(name) }


read_lines: fn(path: String) -[FS]> [String] IOError! {
    text: read(path)
    Ok(split_lines(text))
}


write_lines: fn(path: String, lines: [String]) IOError! -[FS]> {
    s := ""
    loop line in lines -> s = "{s}{line}\n"
    write(path, s)
}


commonpath: fn(paths: [String]) -> String Never! {
    if paths.len() == 0 -> return ""
    first: collapse_impl(paths[0])
    anchor: anchor_of(first)
    parts := path_parts(first)
    loop p in paths {
        cur: collapse_impl(p)
        if anchor_of(cur) != anchor -> return ""
        next: path_parts(cur)
        n := parts.len()
        if next.len() < n -> n = next.len()
        k := 0
        loop k < n {
            if parts[k] != next[k] -> break
            k = k + 1
        }
        kept := [String]{}
        i := 0
        loop i < k {
            kept.push(parts[i])
            i = i + 1
        }
        parts = kept
    }
    compose(anchor, parts)
}


fnmatch: fn(name: String, pattern: String) -> Bool Never! { glob_match(pattern, name) }


split_path_env: fn(text: String) -> [String] Never! {
    raw: text.bytes()
    out := [String]{}
    start := 0
    i := 0
    sep := 58
    loop b in raw {
        if b == (U8{59}) {
            sep = 59
            break
        }
    }
    loop i <= raw.len() {
        n := 0
        if i < raw.len() -> n = raw[i]
        if i == raw.len() || n == sep {
            out.push(slice(raw, start, i))
            start = i + 1
        }
        i = i + 1
    }
    out
}


which: fn(name: String) -[FS, Env]> String? Never! {
    if is_abs_impl(name) {
        if is_file_impl(name) -> return Val(name.copy())
        return None
    }
    path_var: sys.get("PATH") ?? ""
    loop dir in split_path_env(path_var) {
        base := dir
        if base.bytes().len() == 0 -> base = "."
        cand: join_impl(base, name)
        if is_file_impl(cand) -> return Val(cand)
    }
    None
}


slice_path: fn(text: String, start: Int, end: Int) -> String Never! {
    raw: text.bytes()
    out := [U8]{}
    i := start
    loop {
        if i >= end || i < 0 || i >= raw.len() -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i = i + 1
    }
}


splitext: fn(path: String) -> (ext: String, root: String) Never! {
    ext: suffix(path)
    if ext.bytes().len() == 0 -> return (root: path.copy(), ext: "")
    root: slice_path(path, 0, path.bytes().len() - ext.bytes().len())
    (root: root, ext: ext)
}


split: fn(path: String) -> (dir: String, name: String) Never! {
    (dir: dirname(path), name: basename(path))
}


normpath: fn(path: String) -> String Never! { collapse(path) }


getsize: fn(path: String) -[FS]> Int IOError! {
    s: stat(path)
    Ok(s.size)
}


getmtime: fn(path: String) -[FS]> Int IOError! {
    file_fault("FS.Read", .Read, path)
    row: core.files.__stat_at(-1, path, false)
    Ok(row[9] /% 1000000)
}


/// Whether `path` names an entry, a symbolic link itself included: a broken
/// link is true here, where `exists` follows it and is false.
lexists: fn(path: String) -[FS]> Bool Never! { exists_impl(path) || is_symlink(path) }


/// Whether `a` and `b` name the same file (equal ids).
samefile: fn(a: String, b: String) -[FS]> Bool IOError! {
    left: stat(a)
    right: stat(b)
    Ok(left.id.device == right.id.device && left.id.inode == right.id.inode)
}


commonprefix: fn(paths: [String]) -> String Never! {
    if paths.len() == 0 -> return ""
    pref := paths[0].copy()
    loop p in paths {
        n := pref.bytes().len()
        if p.bytes().len() < n -> n = p.bytes().len()
        i := 0
        loop i < n {
            if pref.bytes()[i] != p.bytes()[i] -> break
            i = i + 1
        }
        pref = slice_path(pref, 0, i)
    }
    pref
}


expandvars: fn(path: String) -[Env]> String IOError! {
    raw: path.bytes()
    out := ""
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{36}) {
            i = i + 1
            braced := false
            if i < raw.len() && raw[i] == (U8{123}) {
                braced = true
                i = i + 1
            }
            start: i
            loop i < raw.len() {
                n: raw[i]
                if braced && n == 125 -> break
                letter: (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 95 || (n >= 48 && n <= 57)
                if !braced && !letter -> break
                i = i + 1
            }
            key: slice_path(path, start, i)
            if braced && i < raw.len() && raw[i] == (U8{125}) -> i = i + 1
            val: sys.get(key) ?? ""
            out = "{out}{val}"
            next
        }
        out = "{out}{String.from_bytes([U8]{raw[i]}) ?? ""}"
        i = i + 1
    }
    Ok(out)
}


move: fn(from: String, to: String) IOError! -[FS]> { rename(from, to) }


rmtree: fn(path: String) IOError! -[FS]> { core.files.remove_all(path) }


makedirs: fn(path: String) IOError! -[FS]> { create_dir_all(path) }


listdir: fn(path: String) -[FS]> [String] IOError! {
    entries: core.files.list_dir(path)
    out := [String]{}
    loop e in entries -> out.push(e.name)
    Ok(out)
}


glob_recursive: fn(pattern: String) -[FS]> [String] IOError! { core.files.glob(pattern) }


fnmatch_filter: fn(names: [String], pattern: String) -> [String] Never! {
    out := [String]{}
    loop n in names {
        if fnmatch(n, pattern) -> out.push(n.copy())
    }
    out
}


is_mount: fn(path: String) -[FS]> Bool Never! {
    if !core.files.is_dir(path.copy()) -> return false
    parent: dirname(path)
    if parent == path -> return true
    false
}


ensure_parent: fn(path: String) IOError! -[FS]> { create_dir_all(dirname_impl(path)) }


slice_bytes: fn(raw: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i < 0 || i >= raw.len() -> return out
        out.push(raw[i])
        i = i + 1
    }
}


readdir: fn(path: String) -[FS]> [DirEntry] IOError! { core.files.list_dir(path) }


walkdir: fn(root: String, ignore: String?) -[FS]> Walk { Walk{root: root, ignore: ignore, files_only: false, skip: [String]{}} }


truncate: fn(path: String, size: Int) IOError! -[FS]> {
    if size < 0 -> return Err(io_err("truncate", path, "negative size"))
    bytes: read_bytes(path.copy())
    if size < bytes.len() {
        write_bytes(path.copy(), slice_bytes(bytes, 0, size))
    } else {
        out := bytes
        loop out.len() < size -> out.push(U8{0})
        write_bytes(path.copy(), out)
    }
}


createdirectory: fn(path: String) IOError! -[FS]> { create_dir_all(path) }


filesize: fn(path: String) -[FS]> Int IOError! {
    info: stat(path)
    Ok(info.size)
}


delete: fn(path: String) IOError! -[FS]> { core.files.remove(path) }


cp: fn(from: String, to: String) IOError! -[FS]> { copy2(from, to) }


rm: fn(path: String) IOError! -[FS]> { core.files.remove(path) }


realpath: fn(path: String) -[FS, Env]> String IOError! { core.files.canonicalize(path) }


pwd: fn() -[FS, Env]> String IOError! { cwd() }


/// A fresh directory under the system temp directory that stays until the caller removes it.
/// `temp_dir` is the form that removes its directory when the `TempDir` drops.
tmpdir: fn(prefix: String) -[FS]> String IOError! {
    mkdtemp(prefix)
}


topath: fn(path: String) -[FS, Env]> String IOError! { core.files.canonicalize(path) }


cd: fn(path: String) IOError! -[FS, Env]> { sys.set_current_dir(path) }


#Test("whole-file policy preserves UTF-8 error text and negative range clamping") {
    root: mktemp("whole-file-source-policy")
    create_dir_all(root) ?? panic("whole-file policy root")
    path: join(root, "data")
    write_bytes(path, [U8]{255}) ?? panic("write invalid UTF-8")
    if read(path) == {
        .Err(.InvalidInput(context)) -> {
            if context.operation == {
                .Read -> {}
                .Write | .Flush | .Connect | .Accept | .Close | .Resolve | .Codec -> panic("invalid UTF-8 is a Read failure")
            }
            assert_eq(context.resource, Val(path))
            assert_eq(context.os_code, None)
            assert_eq(context.cause, Val("stream did not contain valid UTF-8"))
        }
        .Ok(_) | .Err(_) -> assert(false)
    }
    write(path, "abc") ?? panic("write text")
    assert_eq(read_at(path, -1, -1) ?? panic("empty range"), [U8]{})
    assert_eq(read_at(path, -1, 1) ?? panic("clamped offset"), [U8]{97})
    write_at(path, -1, [U8]{120}) ?? panic("clamped write")
    append_all(path, "d") ?? panic("append text")
    assert_eq(read(path) ?? panic("read text"), "xbcd")
    create_dir_all(join(root, "one/two")) ?? panic("recursive create_dir_all")
    create_dir_all(join(root, "one/two")) ?? panic("existing directory")
    remove_all(root) ?? panic("cleanup whole-file source policy")
}

file_path_platform: fn() -> host_path.PathPlatform Never! {
    if core.files.__path_windows() -> .Windows else -> .Unix
}

scope_denied: fn(path: String) -> IOError Never! {
    IOError.PermissionDenied(IOContext{
        operation: .Read, resource: Val(path), os_code: None,
        cause: Val("path is outside the granted FS.Read root"),
    })
}

scope_relative: fn(path: host_path.OSPath, requested: String) -> String IOError! {
    cursor := host_path.components(path)
    normalized := [U8]{}
    loop {
        part: host_path.next(path, cursor) ?? break
        if part.kind != .CurDir {
            if part.kind != .Normal -> return Err(scope_denied(requested))
            if normalized.len() > 0 -> normalized.push(host_path.main_separator(path.platform))
            loop i in part.span.start..<part.span.end -> normalized.push(path.encoded[i])
        }
    }
    if normalized.len() == 0 -> return Err(scope_denied(requested))
    Ok(String.from_bytes(normalized) ?? panic("UTF-8 relative path components"))
}

// One read root of a file scope. Only an `FS.Read("<path>")` right names one,
// so a bare `FS.Read` never becomes an ambient file-system handle.
ScopeRoot: struct {
    encoded: [U8]
    absolute: Bool
}

// The read roots and the held, no-follow read behind a file scope: not part
// of the files surface.
priv scope_reads: module {
    // The scope's read roots, in the authority's sorted right order.
    // `FS.Read("repo")` is the working directory; a root with a `..` part names none.
    scope_roots: fn(scope: FileScope, platform: host_path.PathPlatform) -> [ScopeRoot] Never! {
        roots := [ScopeRoot]{}
        loop right in rt.authority_to_wire(scope.authority).split("\n") {
            if !right.starts_with("FS.Read(\"") || !right.ends_with("\")") -> next
            root: right.removeprefix("FS.Read(\"").removesuffix("\")")
            if root == "" -> next
            if root == "repo" {
                roots.push(ScopeRoot{encoded: ".".bytes(), absolute: false})
                next
            }
            path: host_path.from_text(root, platform)
            if scope_has_parent(path) -> next
            absolute: host_path.is_absolute(path)
            roots.push(ScopeRoot{encoded: path.encoded, absolute: absolute})
        }
        roots
    }

    scope_has_parent: fn(path: host_path.OSPath) -> Bool Never! {
        cursor := host_path.components(path)
        loop {
            part: host_path.next(path, cursor) ?? break
            if part.kind == .ParentDir -> return true
        }
        false
    }

    scope_part_name: fn(path: host_path.OSPath, part: host_path.PathComponent, requested: String) -> String IOError! {
        bytes := [U8]{}
        loop i in part.span.start..<part.span.end -> bytes.push(path.encoded[i])
        Ok(String.from_bytes(bytes) ?? return Err(scope_denied(requested)))
    }

    scope_input_error: fn(requested: String, why: String) -> IOError Never! {
        IOError.PermissionDenied(IOContext{operation: .Read, resource: Val(requested), os_code: None, cause: Val(why)})
    }

    // Read `relative` (normalized by scope_relative) below `root`. The root and
    // every part below it are opened from their held parent without following a
    // link, and the bytes come from that same opened regular file.
    scope_read_at: fn(root: ScopeRoot, relative: String, platform: host_path.PathPlatform, requested: String) -[FS.Read]> [U8] IOError! {
        directories := [Directory]{}
        directories.push(open_directory(if root.absolute -> "/" else -> "."))
        root_path: host_path.OSPath{encoded: root.encoded, platform: platform}
        cursor := host_path.components(root_path)
        loop {
            part: host_path.next(root_path, cursor) ?? break
            if part.kind == .Prefix -> return Err(scope_denied(requested))
            if part.kind == .Normal {
                name: scope_part_name(root_path, part, requested)
                directories.push(directories[directories.len() - 1].open_directory(name))
            }
        }
        parts: relative.split(if platform == .Windows -> "\\" else -> "/").to_list()
        loop index in 0..<(parts.len() - 1) {
            directories.push(directories[directories.len() - 1].open_directory(parts[index]))
        }
        reader := directories[directories.len() - 1].open(parts[parts.len() - 1])
        opened: reader.stat()
        if !opened.is_file -> return Err(scope_input_error(requested, "file authority input is not a regular file"))
        if opened.links != 1 -> return Err(scope_input_error(requested, "file authority input has multiple hard links"))
        bytes := [U8]{}
        loop {
            chunk: reader.read(65536)
            if chunk.len() == 0 -> break
            bytes.extend(chunk)
        }
        after: reader.stat()
        if after.id != opened.id || after.size != bytes.len() {
            return Err(IOError.Other(IOContext{operation: .Read, resource: Val(requested), os_code: None, cause: Val("file changed while reading")}))
        }
        Ok(bytes)
    }
}

scoped_read: fn(scope: FileScope, path: String) -[FS.Read]> String IOError! {
    file_fault("FS.Read", .Read, path)
    platform: file_path_platform()
    requested: host_path.from_text(path, platform)
    absolute: host_path.is_absolute(requested)
    last := scope_denied(path)
    loop root in scope_roots(scope, platform) {
        relative := Val(requested)
        if absolute {
            relative = None
            if root.absolute {
                root_path: host_path.OSPath{encoded: root.encoded, platform: platform}
                if host_path.strip_prefix_span(requested, root_path) == .Val(extent) {
                    relative = Val(host_path.owned_span(requested, extent))
                }
            }
        }
        if relative == .Val(selected) {
            relative_text: scope_relative(selected, path)
            if scope_read_at(root, relative_text, platform, path) == {
                .Err(error) -> last = error
                .Ok(bytes) -> {
                    text: String.from_bytes(bytes) ?? return Err(io_err("read", path, file_utf8_error(bytes)))
                    return Ok(text)
                }
            }
        }
    }
    Err(last)
}

#Test("a file scope reads only below its FS.Read roots and never through a link") {
    platform: file_path_platform()
    root: mktemp("file-scope-read")
    create_dir_all(join(root, "inner")) ?? panic("scope root")
    write(join(root, "inner/note.txt"), "scoped") ?? panic("scope file")
    symlink(join(root, "inner/note.txt"), join(root, "link.txt")) ?? panic("scope link")
    here: scope(Authority.from_rights(["FS.Read(\"{root}\")", "FS.Read(\"a/../b\")", "FS.Read"]))
    roots: scope_roots(here, platform)
    assert_eq(roots.len(), 1)
    assert(roots[0].absolute)
    assert(scope_has_parent(host_path.from_text("a/../b", platform)))
    assert(!scope_has_parent(host_path.from_text("a/b", platform)))
    assert_eq(scope_part_name(host_path.from_text("ab", platform), host_path.PathComponent{kind: .Normal, span: host_path.span(0, 2)}, "ab") ?? panic("part name"), "ab")
    assert_eq(scope_read_at(roots[0], "inner/note.txt", platform, "note") ?? panic("held read"), "scoped".bytes())
    assert_eq(here.read(join(root, "inner/note.txt")) ?? panic("absolute read inside the root"), "scoped")
    assert_eq(scoped_read(here, join(root, "inner/note.txt")) ?? panic("scoped read inside the root"), "scoped")
    if scoped_read(here, join(root, "link.txt")) == {
        .Ok(_) -> panic("a scoped read followed a link")
        .Err(_) -> {}
    }
    if here.read("/etc/hostname") == {
        .Ok(_) -> panic("a scoped read left its root")
        .Err(error) -> if error == {
            .PermissionDenied(context) -> assert_eq(context.cause, Val("path is outside the granted FS.Read root"))
            .InvalidInput(_) | .NotFound(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> panic("outside the root is PermissionDenied")
        }
    }
    if scope_input_error("x", "why") == {
        .PermissionDenied(context) -> assert_eq(context.cause, Val("why"))
        .InvalidInput(_) | .NotFound(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> panic("scope input errors are PermissionDenied")
    }
    remove_all(root) ?? panic("cleanup file scope")
}

// std::str::Utf8Error's exact Display text; scoped reads used from_utf8,
// unlike whole-file reads, whose read_to_string error has a fixed cause.
file_utf8_error: fn(bytes: [U8]) -> String Never! {
    at := 0
    loop at < bytes.len() {
        lead: Int{bytes[at]}
        width := if lead < 128 -> 1 else -> 0
        low := 128
        high := 191
        if lead >= 194 && lead <= 223 -> width = 2
        if lead >= 224 && lead <= 239 {
            width = 3
            if lead == 224 -> low = 160
            if lead == 237 -> high = 159
        }
        if lead >= 240 && lead <= 244 {
            width = 4
            if lead == 240 -> low = 144
            if lead == 244 -> high = 143
        }
        if width == 0 -> return "invalid utf-8 sequence of 1 bytes from index {at}"
        loop part in 1..<width {
            if at + part >= bytes.len() -> return "incomplete utf-8 byte sequence from index {at}"
            byte: Int{bytes[at + part]}
            valid: if part == 1 -> byte >= low && byte <= high else -> byte >= 128 && byte <= 191
            if !valid -> return "invalid utf-8 sequence of {part} bytes from index {at}"
        }
        at += width
    }
    panic("UTF-8 error requested for valid bytes")
}

#Test("scoped read UTF-8 causes retain Rust offset and invalid-length text") {
    assert_eq(file_utf8_error([U8]{65, 255}), "invalid utf-8 sequence of 1 bytes from index 1")
    assert_eq(file_utf8_error([U8]{226, 130, 65}), "invalid utf-8 sequence of 2 bytes from index 0")
    assert_eq(file_utf8_error([U8]{240, 144, 128}), "incomplete utf-8 byte sequence from index 0")
}

#Test("scoped lexical policy rejects parents and empty names before OS work") {
    unix: host_path.PathPlatform.Unix
    assert_eq(scope_relative(host_path.from_text("./a//./b", unix), "x") ?? panic("normal path"), "a/b")
    if scope_relative(host_path.from_text("a/../b", unix), "x") == { .Err(_) -> {} .Ok(_) -> assert(false) }
    if scope_relative(host_path.from_text(".", unix), "x") == { .Err(_) -> {} .Ok(_) -> assert(false) }
}

// The Rust original is the exact contract. The existing BufReader owns
// refill/position and retries Interrupted reads; the source owns the public
// fault checkpoint, EOF, UTF-8 error and file-specific terminator trimming.
__reader_read_line: fn(reader: &FileReader) -[FS.Read]> String? IOError! {
    if rt.fault_should_fail("FS.Read") {
        return Err(IOError.Other(IOContext{
            operation: .Read, resource: Val(core.files.__reader_path(reader)),
            os_code: None, cause: Val("fault injected: FS.Read"),
        }))
    }
    bytes := core.files.__reader_line_bytes(reader)
    if bytes.len() == 0 -> return Ok(None)
    trim_file_line(bytes)
    text: String.from_bytes(bytes) ?? return Err(io_err("read", core.files.__reader_path(reader), "stream did not contain valid UTF-8"))
    Ok(Val(text))
}

trim_file_line: fn(bytes: &[U8]) Never! {
    loop bytes.len() > 0 {
        last: bytes[bytes.len() - 1]
        if last != (U8{10}) && last != (U8{13}) -> break
        _: bytes.pop()
    }
}

#Test("file read_line trims every trailing CR/LF including unterminated final CR") {
    final := [U8]{108, 97, 115, 116, 13}
    trim_file_line(final)
    assert_eq(String.from_bytes(final) ?? panic("trimmed UTF-8"), "last")
    repeated := [U8]{120, 13, 13, 10}
    trim_file_line(repeated)
    assert_eq(String.from_bytes(repeated) ?? panic("trimmed UTF-8"), "x")
}

#Test("filesystem u32 policy preserves chown and permission boundaries") {
    assert(!files8_u32(-1))
    assert(files8_u32(0))
    assert(files8_u32(4294967295))
    assert(!files8_u32(4294967296))
    assert(((4096).bit_and(61440)) == 4096)
    assert(((8192).bit_and(61440)) != 4096)
    assert(((32768).bit_and(61440)) != 4096)
}

#Test("walk owns zero-based depth, path sorting and inherited ignore rules") {
    directory: core.files.temp_dir("walk_source") ?? panic("temporary walk directory")
    child: join(directory.path, "nested")
    create_dir_all(child) ?? panic("nested directory")
    write(join(directory.path, "visible"), "root") ?? panic("root file")
    write(join(directory.path, "hidden"), "hidden") ?? panic("ignored file")
    write(join(directory.path, ".gitignore"), "hidden\n") ?? panic("root rules")
    write(join(child, "visible"), "nested") ?? panic("nested file")
    write(join(child, "hidden"), "hidden") ?? panic("inherited ignored file")
    rows: walk(directory.path, Val(".gitignore")).list() ?? panic("walk")
    assert_eq(rows.len(), 3)
    assert_eq(rows[0].relative, "nested")
    assert_eq(rows[0].depth, 0)
    assert(rows[0].is_dir)
    assert_eq(rows[1].relative, join("nested", "visible"))
    assert_eq(rows[1].depth, 1)
    assert_eq(rows[2].relative, "visible")
    assert_eq(rows[2].depth, 0)
    files: walk_files(directory.path, Val(".gitignore")).list() ?? panic("walk files")
    assert_eq(files.len(), 2)
    loop entry in files -> assert(!entry.is_dir)
}

#Test("walk validates an empty spelling but reads the actual empty root") {
    if walk("", None).list() == {
        .Ok(_) -> assert(false)
        .Err(_) -> {}
    }
}

#Test("walk rejects regular-file roots with the native cause") {
    file: temp_file("walk_root") ?? panic("temporary walk root")
    if walk(file.path, None).list() == {
        .Ok(_) -> assert(false)
        .Err(error) -> {
            if error == {
                .Other(context) -> assert_eq(context.cause, Val("filesystem walk root is not a directory: {file.path}"))
                .InvalidInput(_) | .NotFound(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> assert(false)
            }
        }
    }
}


#Test("glob keeps the native byte grammar and prefix base") {
    assert(entries_glob_match("*.txt".bytes(), "./sub/deep.txt".bytes()))
    assert(entries_glob_match("./?".bytes(), "./q".bytes()))
    assert(!entries_glob_match("./?".bytes(), "./é".bytes()))
    assert(entries_glob_match("./[x]".bytes(), "./[x]".bytes()))
    assert(!entries_glob_match("./[x]".bytes(), "./x".bytes()))
    assert(entries_glob_match("*a".bytes(), "*ba".bytes()))
    assert_eq(entries_glob_root("literal", U8{47}), ".")
    assert_eq(entries_glob_root("/literal", U8{47}), ".")
    assert_eq(entries_glob_root("dir/*.txt", U8{47}), "dir")
    assert_eq(entries_glob_root("dir\\*.txt", U8{92}), "dir")
}

#Test("copy directory preserves nested regular files and skips symlink entries") {
    root: mktemp("entries-copy-kat")
    source: join(root, "source")
    destination: join(root, "destination")
    create_dir_all(join(source, "nested")) ?? panic("nested source")
    write(join(source, "top.txt"), "top") ?? panic("top")
    write(join(source, "nested/deep.txt"), "deep") ?? panic("deep")
    if rt.os_family() == "unix" -> symlink("nested", join(source, "link")) ?? panic("symlink")
    copy_dir(Path.from(source), Path.from(destination)) ?? panic("copy")
    assert_eq(read(join(destination, "top.txt")) ?? panic("copied top"), "top")
    assert_eq(read(join(destination, "nested/deep.txt")) ?? panic("copied deep"), "deep")
    assert(!exists(join(destination, "link")))
    remove_all(root) ?? panic("cleanup")
}

#Test("list_dir matching, canonicalize missing_last, symlink replace and walk skip read as the shell does") {
    root: mktemp("files-shell-kat")
    create_dir_all(join(root, "keep/.jet")) ?? panic("tree")
    create_dir_all(join(root, "out")) ?? panic("out")
    write(join(root, "a.files"), "one\n") ?? panic("a")
    write(join(root, "b.files"), "") ?? panic("b")
    write(join(root, "notes.txt"), "x") ?? panic("notes")
    write(join(root, "keep/.jet/cache"), "c") ?? panic("cache")
    write(join(root, "keep/src.jet"), "s") ?? panic("src")
    names := [String]{}
    loop entry in list_dir(root, matching: "*.files") ?? panic("list") -> names.push(entry.name.copy())
    assert_eq(names, [String]{"a.files", "b.files"})
    base: canonicalize(root) ?? panic("canonical root")
    assert_eq(canonicalize(join(root, "new.txt"), missing_last: true) ?? panic("missing last"), join(base, "new.txt"))
    assert(canonicalize(join(root, "new.txt")) == .Err(_))
    if rt.os_family() == "unix" {
        link: join(root, "current")
        symlink("keep", link) ?? panic("first link")
        assert(symlink("out", link) == .Err(_))
        symlink("out", link, replace: true) ?? panic("replace link")
        assert_eq(read_link(link) ?? panic("read link"), "out")
        assert(!exists(join(root, "keep/out")))
        assert(symlink("out", join(root, "keep"), replace: true) == .Err(_))
    }
    walked := [String]{}
    loop entry in walk_files(join(root, "keep"), skip: [String]{".jet"}) -> walked.push((entry ?? panic("walk")).relative)
    assert_eq(walked, [String]{"src.jet"})
    remove_all(root) ?? panic("cleanup")
}

#Test("best_effort runs each operation, records what failed and reports it once") {
    root: mktemp("files-best-effort-kat")
    create_dir_all(root) ?? panic("root")
    write(join(root, "a"), "one") ?? panic("a")
    done := best_effort()
    done.remove_all(join(root, "gone"))
    done.remove(join(root, "gone"))
    done.create_dir_all(join(root, "out/deep"))
    done.copy_file(join(root, "a"), join(root, "out/a"))
    done.copy_dir(join(root, "out"), join(root, "again"))
    assert(!done.failed())
    assert_eq(done.report(), "")
    done.copy_file(join(root, "missing"), join(root, "out/b"))
    assert_eq(done.canonicalize(join(root, "missing/x")), join(root, "missing/x"))
    assert_eq(done.canonicalize(join(root, "a")), canonicalize(join(root, "a")) ?? panic("canonical a"))
    if rt.os_family() == "unix" {
        done.symlink("a", join(root, "link"))
        done.symlink("out", join(root, "link"))
        done.symlink("out", join(root, "link"), replace: true)
        assert_eq(read_link(join(root, "link")) ?? panic("link"), "out")
    }
    assert_eq(read(join(root, "again/a")) ?? panic("copied"), "one")
    assert(done.failed())
    expected: if rt.os_family() == "unix" -> 3 else -> 2
    assert_eq(done.failures.len(), expected)
    assert_eq(done.report().split("\n").len(), expected)
    remove_all(root) ?? panic("cleanup")
}

#Test("read_or and list_dir_or give the file or listing, else the stated fallback") {
    root: mktemp("files-or-kat")
    create_dir_all(root) ?? panic("root")
    write(join(root, "a.files"), "one\n") ?? panic("a")
    write(join(root, "notes.txt"), "x") ?? panic("notes")
    write_bytes(join(root, "bad"), [U8]{255, 10}) ?? panic("bad")
    assert_eq(read_or(join(root, "a.files"), "none"), "one\n")
    assert_eq(read_or(join(root, "missing"), "none"), "none")
    assert_eq(read_or(join(root, "bad"), ""), "")
    names := [String]{}
    loop entry in list_dir_or(root, [DirEntry]{}, matching: "*.files") -> names.push(entry.name.copy())
    assert_eq(names, [String]{"a.files"})
    assert_eq(list_dir_or(root, [DirEntry]{}).len(), 3)
    assert_eq(list_dir_or(join(root, "missing"), [DirEntry]{}).len(), 0)
    assert_eq(list_dir_or(join(root, "a.files"), [DirEntry]{}).len(), 0)
    remove_all(root) ?? panic("cleanup")
}

#Test("glob DFS uses native shown paths, literal brackets and a byte wildcard") {
    root: mktemp("entries-glob-kat")
    create_dir_all(join(root, "sub")) ?? panic("sub")
    write(join(root, "top.txt"), "top") ?? panic("top")
    write(join(root, "sub/deep.txt"), "deep") ?? panic("deep")
    write(join(root, "q"), "question") ?? panic("q")
    write(join(root, "[x]"), "literal") ?? panic("literal")
    expected := [String]{join(root, "sub/deep.txt"), join(root, "top.txt")}
    expected.sort()
    assert_eq(glob(Path.from(join(root, "*.txt"))) ?? panic("star"), expected)
    assert_eq(glob(join(root, "?")) ?? panic("question"), [String]{join(root, "q")})
    assert_eq(glob(join(root, "[x]")) ?? panic("literal"), [String]{join(root, "[x]")})
    remove_all(root) ?? panic("cleanup")
}

#Test("entries error projection retains source operation and top-level resource") {
    context: IOContext{operation: .Write, resource: Val("source"), os_code: Val(17), cause: Val("existing destination")}
    projected: walk_error(.Write, 6, Val(17), Val("existing destination"), "source")
    expected: IOError.AlreadyExists(context)
    assert_eq("{projected:Debug}", "{expected:Debug}")
    unsupported: walk_error(.Read, 7, None, Val("unsupported"), "pattern")
    unsupported_expected: IOError.Unsupported(IOContext{operation: .Read, resource: Val("pattern"), os_code: None, cause: Val("unsupported")})
    assert_eq("{unsupported:Debug}", "{unsupported_expected:Debug}")
}


// #4750: every path metadata probe takes the FS.Read checkpoint. Setup uses
// only FS.Write, so each schedule selects exactly the probe under test; the
// injected branch prints a marker a captured `jet test` run can find. The
// fixture returns its TempDir so the directory outlives the fixture call.
metadata_fault_fixture: fn(prefix: String) -[FS]> (root: TempDir, dir: String, file: String, link: String)? Never! {
    root: temp_dir(prefix) ?? return None
    file: join(root.path, "file")
    write(file, "x") ?? return None
    link: join(root.path, "link")
    symlink(file, link) ?? return None
    dir: root.path.copy()
    Val((root: root, dir: dir, file: file, link: link))
}

metadata_fault_seen: fn(probe: String, error: IOError) {
    if error == {
        .Other(context) -> assert_eq(context.cause, Val("fault injected: FS.Read"))
        .InvalidInput(_) | .NotFound(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> panic("{probe} expected the injected FS.Read fault, got {error:Debug}")
    }
    print("files fault observed: {probe}")
}

#Test(faults: [FS.Read]) files_stat_takes_the_read_fault: fn() {
    fixture: metadata_fault_fixture("stat_fault") ?? return
    if stat(fixture.file) == {
        .Ok(info) -> assert_eq(info.size, 1)
        .Err(error) -> metadata_fault_seen("stat", error)
    }
}

#Test(faults: [FS.Read]) files_getmtime_takes_the_read_fault: fn() {
    fixture: metadata_fault_fixture("mtime_fault") ?? return
    if getmtime(fixture.file) == {
        .Ok(_) -> {}
        .Err(error) -> metadata_fault_seen("getmtime", error)
    }
}

#Test(faults: [FS.Read]) files_exists_takes_the_read_fault: fn() {
    fixture: metadata_fault_fixture("exists_fault") ?? return
    if !exists(fixture.file) -> print("files fault observed: exists")
}

#Test(faults: [FS.Read]) files_is_dir_takes_the_read_fault: fn() {
    fixture: metadata_fault_fixture("is_dir_fault") ?? return
    if !is_dir(fixture.dir) -> print("files fault observed: is_dir")
}

#Test(faults: [FS.Read]) files_is_file_takes_the_read_fault: fn() {
    fixture: metadata_fault_fixture("is_file_fault") ?? return
    if !is_file(fixture.file) -> print("files fault observed: is_file")
}

#Test(faults: [FS.Read]) files_is_symlink_takes_the_read_fault: fn() {
    fixture: metadata_fault_fixture("is_symlink_fault") ?? return
    if !is_symlink(fixture.link) -> print("files fault observed: is_symlink")
}

#Test("normalize, join_all and resolve write paths as node's path module does") {
    assert_eq(normalize("/a//b/./c/../d/"), "/a/b/d/")
    assert_eq(normalize("a/../../b"), "../b")
    assert_eq(normalize("/../x"), "/x")
    assert_eq(normalize("a/.."), ".")
    assert_eq(normalize("a/../"), "./")
    assert_eq(normalize("//"), "/")
    assert_eq(normalize(""), ".")
    assert_eq(normalize("a\\b/c"), "a\\b/c")
    assert_eq(join_all([String]{"/home/u", ".cache"}), "/home/u/.cache")
    assert_eq(join_all([String]{"/a", "/b/", "../c"}), "/a/c")
    assert_eq(join_all([String]{"", ".cache"}), ".cache")
    assert_eq(join_all([String]{"", ""}), ".")
    assert_eq(resolve("/x/y/../z/") ?? panic("absolute"), "/x/z")
    assert_eq(resolve("/") ?? panic("root"), "/")
    assert_eq(resolve("a/./b") ?? panic("relative"), "{sys.current_dir() ?? panic("cwd")}/a/b")
}
