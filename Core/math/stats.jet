use core.math as math
use core.math.random as random

// core.math.stats — descriptive statistics in exact Int / software Float.
//
// Scalar statistics return `None` for empty, mismatched, non-finite, or
// mathematically undefined inputs. Population variants divide by n; sample
// variants divide by n - 1. Collection transforms return an empty collection
// for invalid dimensions/parameters. Ties in mode and rank preserve the
// first-seen order. Random KDE sampling carries the explicit Rand effect.

pub struct SlopeIntercept {
    pub slope: Float
    pub intercept: Float
}

pub struct NormalDist {
    pub mu: Float
    pub sigma: Float
}

struct CovarianceTerms {
    x_scale: Float
    y_scale: Float
    sx: Float
    sy: Float
    xx: Float
    yy: Float
    xy: Float
}

struct CentralTerms {
    n: Int
    s2: Float
    s3: Float
    s4: Float
}

fn nonfinite(value: Float) -> Bool Never! {
    if math.is_finite(value) -> return false
    true
}
fn abs_value(value: Float) -> Float Never! {
    if value < (Float{0.0}) -> return Float{0.0} - value
    value
}
fn sqrt_value(value: Float) -> Float Never! {
    math.sqrt(value)
}
fn ln_value(value: Float) -> Float Never! {
    math.ln(value)
}
fn exp_value(value: Float) -> Float Never! {
    math.exp(value)
}

fn valid_sample(xs: [Float]) -> Bool Never! {
    loop x in xs {
        if nonfinite(x) -> return false
    }
    true
}
fn invalid_sample(xs: [Float]) -> Bool Never! {
    if valid_sample(xs) -> return false
    true
}

fn copy_floats(xs: [Float]) -> [Float] Never! {
    out := [Float]{}
    loop x in xs -> &out.push(x)
    out
}
fn stable_mean(xs: [Float]) -> Float? {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    scale := Float{0.0}
    loop x in xs {
        magnitude :: abs_value(x)
        if magnitude > scale -> scale = magnitude
    }
    if scale <= (Float{0.0}) -> return Val(Float{0.0})
    acc := Float{0.0}
    loop x in xs -> acc = acc + x / scale
    Val((acc / (Float{xs.len()})) * scale)
}


fn compensated_sum(xs: [Float]) -> Float Never! {
    acc := Float{0.0}
    correction := Float{0.0}
    positive_inf := false
    negative_inf := false
    loop x in xs {
        if math.is_nan(x) -> return x
        if math.is_inf(x) {
            if x > (Float{0.0}) -> positive_inf = true else -> negative_inf = true
            next
        }
        if math.is_inf(acc) -> next
        t :: acc + x
        if abs_value(acc) >= abs_value(x) {
            correction = correction + ((acc - t) + x)
        } else {
            correction = correction + ((x - t) + acc)
        }
        acc = t
    }
    if positive_inf && negative_inf -> return math.nan()
    if positive_inf -> return math.infinity()
    if negative_inf -> return -math.infinity()
    acc + correction
}

fn sift_down(xs: &[Float], start: Int, end: Int) Never! {
    root := start
    loop {
        child :: root * 2 + 1
        if child > end -> return
        candidate := root
        if xs[candidate] < xs[child] -> candidate = child
        right :: child + 1
        if right <= end && xs[candidate] < xs[right] -> candidate = right
        if candidate == root -> return
        tmp :: Float{xs[root]}
        xs[root] = xs[candidate]
        xs[candidate] = tmp
        root = candidate
    }
}

fn sorted(xs: [Float]) -> [Float] Never! {
    out := copy_floats(xs)
    n :: out.len()
    if n < 2 -> return out
    start := (n - 2) /% 2
    loop {
        sift_down(&out, start, n - 1)
        if start == 0 -> break
        start = start - 1
    }
    end := n - 1
    loop end > 0 {
        tmp :: Float{out[0]}
        out[0] = out[end]
        out[end] = tmp
        end = end - 1
        sift_down(&out, 0, end)
    }
    out
}

fn interpolate(a: Float, b: Float, fraction: Float) -> Float Never! {
    if (a >= (Float{0.0}) && b >= (Float{0.0})) || (a <= (Float{0.0}) && b <= (Float{0.0})) {
        return a + (b - a) * fraction
    }
    a * ((Float{1.0}) - fraction) + b * fraction
}

fn quantile_sorted(s: [Float], p: Float) -> Float? {
    if s.len() == 0 || p != p || p < (Float{0.0}) || p > (Float{1.0}) -> return None
    if p <= (Float{0.0}) -> return Val(s[0])
    if p >= (Float{1.0}) -> return Val(s[s.len() - 1])
    position :: p * (Float{s.len() - 1})
    lower :: Int{position}
    upper :: lower + 1
    if upper >= s.len() -> return Val(s[s.len() - 1])
    fraction :: position - (Float{lower})
    Val(interpolate(s[lower], s[upper], fraction))
}

fn compensated_sum_scaled(xs: [Float], scale: Float) -> Float Never! {
    acc := Float{0.0}
    correction := Float{0.0}
    loop x in xs {
        value :: x / scale
        t :: acc + value
        if abs_value(acc) >= abs_value(value) {
            correction = correction + ((acc - t) + value)
        } else {
            correction = correction + ((value - t) + acc)
        }
        acc = t
    }
    acc + correction
}
fn covariance_terms(xs: [Float], ys: [Float]) -> CovarianceTerms? {
    n :: xs.len()
    if n == 0 || ys.len() != n || invalid_sample(xs) || invalid_sample(ys) -> return None
    x_scale := Float{0.0}
    y_scale := Float{0.0}
    loop x in xs {
        magnitude :: abs_value(x)
        if magnitude > x_scale -> x_scale = magnitude
    }
    loop y in ys {
        magnitude :: abs_value(y)
        if magnitude > y_scale -> y_scale = magnitude
    }
    if x_scale <= (Float{0.0}) || y_scale <= (Float{0.0}) {
        return Val(CovarianceTerms{x_scale: x_scale, y_scale: y_scale, sx: Float{0.0}, sy: Float{0.0}, xx: Float{0.0}, yy: Float{0.0}, xy: Float{0.0}})
    }
    mx :: compensated_sum_scaled(xs, x_scale) / (Float{n})
    my :: compensated_sum_scaled(ys, y_scale) / (Float{n})
    sx := Float{0.0}
    sy := Float{0.0}
    loop i in 0..<n {
        dx :: abs_value(xs[i] / x_scale - mx)
        dy :: abs_value(ys[i] / y_scale - my)
        if dx > sx -> sx = dx
        if dy > sy -> sy = dy
    }
    xx := Float{0.0}
    yy := Float{0.0}
    xy := Float{0.0}
    loop i in 0..<n {
        dx := Float{0.0}
        dy := Float{0.0}
        if sx > (Float{0.0}) -> dx = (xs[i] / x_scale - mx) / sx
        if sy > (Float{0.0}) -> dy = (ys[i] / y_scale - my) / sy
        xx = xx + dx * dx
        yy = yy + dy * dy
        xy = xy + dx * dy
    }
    Val(CovarianceTerms{x_scale: x_scale, y_scale: y_scale, sx: sx, sy: sy, xx: xx, yy: yy, xy: xy})
}


fn central_terms(xs: [Float]) -> CentralTerms? {
    n :: xs.len()
    if n == 0 || invalid_sample(xs) -> return None
    scale := Float{0.0}
    loop x in xs {
        magnitude :: abs_value(x)
        if magnitude > scale -> scale = magnitude
    }
    if scale <= (Float{0.0}) -> return None
    m :: compensated_sum_scaled(xs, scale) / (Float{n})
    s2 := Float{0.0}
    s3 := Float{0.0}
    s4 := Float{0.0}
    loop x in xs {
        z :: x / scale - m
        z2 :: z * z
        s2 = s2 + z2
        s3 = s3 + z2 * z
        s4 = s4 + z2 * z2
    }
    Val(CentralTerms{n: n, s2: s2, s3: s3, s4: s4})
}

fn variance_den(xs: [Float], den: Int) -> Float? {
    if den <= 0 || xs.len() == 0 || invalid_sample(xs) -> return None
    scale := Float{0.0}
    loop x in xs {
        magnitude :: abs_value(x)
        if magnitude > scale -> scale = magnitude
    }
    if scale <= (Float{0.0}) -> return Val(Float{0.0})
    m :: compensated_sum_scaled(xs, scale) / (Float{xs.len()})
    acc := Float{0.0}
    loop x in xs {
        z :: x / scale - m
        acc = acc + z * z
    }
    normalized := acc / (Float{den})
    if normalized < (Float{0.0}) -> return Val(Float{0.0})
    deviation := sqrt_value(normalized) * scale
    if nonfinite(deviation) -> return None
    value := deviation * deviation
    if nonfinite(value) -> return None
    Val(value)
}


pub fn sum(xs: [Float]) -> Float Never! { compensated_sum(xs) }

pub fn prod(xs: [Float]) -> Float Never! {
    acc := Float{1.0}
    loop x in xs -> acc = acc * x
    acc
}

pub fn mean(xs: [Float]) -> Float? Never! {
    m :: stable_mean(xs) ?? return None
    Val(m)
}

pub fn fmean(xs: [Float]) -> Float? Never! { mean(xs) }

pub fn geometric_mean(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    acc := Float{0.0}
    i := 0
    loop x in xs {
        if x <= (Float{0.0}) -> return None
        log_x :: ln_value(x)
        acc = acc + (log_x - acc) / (Float{i + 1})
        i = i + 1
    }
    Val(exp_value(acc))
}

pub fn harmonic_mean(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    minimum := ~xs[0]
    loop x in xs {
        if x <= (Float{0.0}) -> return None
        if x < minimum -> minimum = ~x
    }
    acc := Float{0.0}
    loop x in xs -> acc = acc + minimum / x
    if acc <= (Float{0.0}) -> return None
    Val((Float{xs.len()}) * minimum / acc)
}

pub fn median(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    s :: sorted(xs)
    n :: s.len()
    mid :: n /% 2
    if n % 2 == 1 -> return Val(s[mid])
    Val(interpolate(s[mid - 1], s[mid], (Float{0.5})))
}

pub fn median_grouped(xs: [Float], interval: Float) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) || nonfinite(interval) || interval <= (Float{0.0}) {
        return None
    }
    s :: sorted(xs)
    n :: s.len()
    mid :: n /% 2
    x :: s[mid]
    lower :: x - interval / (Float{2.0})
    upper :: lower + interval
    below := 0
    frequency := 0
    loop value in s {
        if value < lower -> below += 1
        if value >= lower && value < upper -> frequency += 1
    }
    if frequency == 0 -> return Val(x)
    Val(lower + interval * ((Float{n}) / (Float{2.0}) - (Float{below})) / (Float{frequency}))
}

pub fn median_low(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    s :: sorted(xs)
    n :: s.len()
    if n % 2 == 1 -> return Val(s[n /% 2])
    Val(s[n /% 2 - 1])
}

pub fn median_high(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    s :: sorted(xs)
    Val(s[s.len() /% 2])
}

pub fn quantile(xs: [Float], p: Float) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    quantile_sorted(sorted(xs), p)
}

pub fn percentile(xs: [Float], pct: Float) -> Float? Never! {
    if pct != pct -> return None
    quantile(xs, pct / (Float{100.0}))
}

pub fn mode(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    best := ~xs[0]
    best_n := 0
    loop x in xs {
        n := 0
        loop y in xs {
            if y == x -> n = n + 1
        }
        if n > best_n {
            best = ~x
            best_n = n
        }
    }
    Val(best)
}

pub fn multimode(xs: [Float]) -> [Float] Never! {
    out := [Float]{}
    if xs.len() == 0 || invalid_sample(xs) -> return out
    best := 0
    loop x in xs {
        n := 0
        loop y in xs {
            if y == x -> n = n + 1
        }
        if n > best -> best = n
    }
    loop x in xs {
        n := 0
        loop y in xs {
            if y == x -> n = n + 1
        }
        if n == best {
            seen := false
            loop z in out {
                if z == x -> seen = true
            }
            if seen == false -> &out.push(x)
        }
    }
    out
}

pub fn pvariance(xs: [Float]) -> Float? Never! { variance_den(xs, xs.len()) }

pub fn pstdev(xs: [Float]) -> Float? Never! {
    v :: pvariance(xs) ?? return None
    Val(sqrt_value(v))
}

pub fn variance(xs: [Float]) -> Float? Never! {
    if xs.len() < 2 -> return None
    variance_den(xs, xs.len() - 1)
}

pub fn stdev(xs: [Float]) -> Float? Never! {
    v :: variance(xs) ?? return None
    Val(sqrt_value(v))
}

pub fn covariance(xs: [Float], ys: [Float]) -> Float? Never! {
    n :: xs.len()
    if n < 2 || ys.len() != n -> return None
    t :: covariance_terms(xs, ys) ?? return None
    if t.sx <= (Float{0.0}) || t.sy <= (Float{0.0}) -> return Val(Float{0.0})
    x_deviation := t.sx * t.x_scale
    y_deviation := t.sy * t.y_scale
    if nonfinite(x_deviation) || nonfinite(y_deviation) -> return None
    value := (t.xy / (Float{n - 1})) * x_deviation * y_deviation
    if nonfinite(value) -> return None
    Val(value)
}

pub fn correlation(xs: [Float], ys: [Float]) -> Float? Never! {
    n :: xs.len()
    if n < 2 || ys.len() != n -> return None
    t :: covariance_terms(xs, ys) ?? return None
    if t.xx <= (Float{0.0}) || t.yy <= (Float{0.0}) -> return None
    value := t.xy / sqrt_value(t.xx * t.yy)
    if nonfinite(value) -> return None
    if value < (Float{-1.0}) -> return Val(Float{-1.0})
    if value > (Float{1.0}) -> return Val(Float{1.0})
    Val(value)
}

pub fn linear_regression(xs: [Float], ys: [Float]) -> SlopeIntercept? Never! {
    n :: xs.len()
    if n < 2 || ys.len() != n -> return None
    t :: covariance_terms(xs, ys) ?? return None
    if t.sx <= (Float{0.0}) || t.xx <= (Float{0.0}) -> return None
    x_deviation := t.sx * t.x_scale
    y_deviation := t.sy * t.y_scale
    if nonfinite(x_deviation) || nonfinite(y_deviation) || x_deviation <= (Float{0.0}) {
        return None
    }
    slope := (t.xy / t.xx) * (y_deviation / x_deviation)
    mx :: stable_mean(xs) ?? return None
    my :: stable_mean(ys) ?? return None
    intercept := my - slope * mx
    if nonfinite(slope) || nonfinite(intercept) -> return None
    Val(SlopeIntercept{slope: slope, intercept: intercept})
}

pub fn normal_dist(mu: Float, sigma: Float) -> NormalDist Never! {
    NormalDist{mu: mu, sigma: sigma}
}

pub fn kde(xs: [Float], bandwidth: Float) -> [Float] Never! {
    out := [Float]{}
    if xs.len() == 0 || invalid_sample(xs) || nonfinite(bandwidth) || bandwidth <= (Float{0.0}) {
        return out
    }
    normalizer :: (Float{1.0}) / ((Float{xs.len()}) * bandwidth * sqrt_value((Float{2.0}) * math.pi()))
    loop point in xs {
        total := Float{0.0}
        loop value in xs {
            z :: (point - value) / bandwidth
            total = total + exp_value((Float{-0.5}) * z * z)
        }
        &out.push(total * normalizer)
    }
    out
}

pub fn kde_random(xs: [Float], bandwidth: Float, n: Int) -[Rand]> [Float] Never! {
    out := [Float]{}
    if xs.len() == 0 || invalid_sample(xs) || nonfinite(bandwidth) || bandwidth <= (Float{0.0}) || n <= 0 {
        return out
    }
    loop _ in 0..<n {
        index :: random.int(0, xs.len() - 1)
        value := xs[index] + random.normal((Float{0.0}), bandwidth)
        if nonfinite(value) -> return [Float]{}
        &out.push(value)
    }
    out
}

pub fn zscore(xs: [Float]) -> [Float] Never! {
    out := [Float]{}
    if xs.len() == 0 || invalid_sample(xs) -> return out
    scale := Float{0.0}
    loop x in xs {
        magnitude :: abs_value(x)
        if magnitude > scale -> scale = magnitude
    }
    if scale <= (Float{0.0}) -> return out
    m :: compensated_sum_scaled(xs, scale) / (Float{xs.len()})
    acc := Float{0.0}
    loop x in xs {
        z :: x / scale - m
        acc = acc + z * z
    }
    spread :: sqrt_value(acc / (Float{xs.len()}))
    if spread <= (Float{0.0}) -> return out
    loop x in xs -> &out.push((x / scale - m) / spread)
    out
}

pub fn min(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    m := ~xs[0]
    loop x in xs {
        if x < m -> m = ~x
    }
    Val(m)
}

pub fn max(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    m := ~xs[0]
    loop x in xs {
        if x > m -> m = ~x
    }
    Val(m)
}

pub fn range(xs: [Float]) -> Float? Never! {
    lo :: min(xs) ?? return None
    hi :: max(xs) ?? return None
    value := hi - lo
    if nonfinite(value) -> return None
    Val(value)
}
pub fn cumsum(xs: [Float]) -> [Float] Never! {
    out := [Float]{}
    if invalid_sample(xs) -> return out
    acc := Float{0.0}
    correction := Float{0.0}
    loop x in xs {
        t :: acc + x
        if abs_value(acc) >= abs_value(x) {
            correction = correction + ((acc - t) + x)
        } else {
            correction = correction + ((x - t) + acc)
        }
        acc = t
        value :: acc + correction
        if nonfinite(value) -> return [Float]{}
        &out.push(value)
    }
    out
}

pub fn count(xs: [Float]) -> Int Never! { xs.len() }

pub fn sumprod(xs: [Float], ys: [Float]) -> Float? Never! {
    if xs.len() != ys.len() || invalid_sample(xs) || invalid_sample(ys) -> return None
    acc := Float{0.0}
    correction := Float{0.0}
    loop i in 0..<xs.len() {
        x :: xs[i] * ys[i]
        t :: acc + x
        if abs_value(acc) >= abs_value(x) {
            correction = correction + ((acc - t) + x)
        } else {
            correction = correction + ((x - t) + acc)
        }
        acc = t
    }
    value := acc + correction
    if nonfinite(value) -> return None
    Val(value)
}
pub fn weighted_mean(xs: [Float], weights: [Float]) -> Float? Never! {
    if xs.len() == 0 || xs.len() != weights.len() || invalid_sample(xs) -> return None
    maximum_weight := Float{0.0}
    value_scale := Float{0.0}
    loop i in 0..<xs.len() {
        w :: weights[i]
        if nonfinite(w) || w < (Float{0.0}) -> return None
        if w > maximum_weight -> maximum_weight = w
        magnitude :: abs_value(xs[i])
        if magnitude > value_scale -> value_scale = magnitude
    }
    if maximum_weight <= (Float{0.0}) -> return None
    if value_scale <= (Float{0.0}) -> return Val(Float{0.0})
    numerator := Float{0.0}
    denominator := Float{0.0}
    loop i in 0..<xs.len() {
        scaled_weight :: weights[i] / maximum_weight
        numerator = numerator + (xs[i] / value_scale) * scaled_weight
        denominator = denominator + scaled_weight
    }
    if denominator <= (Float{0.0}) -> return None
    value := (numerator / denominator) * value_scale
    if nonfinite(value) -> return None
    Val(value)
}

pub fn quantiles(xs: [Float], n: Int) -> [Float] Never! {
    out := [Float]{}
    if n <= 1 || xs.len() == 0 || invalid_sample(xs) -> return out
    s :: sorted(xs)
    i := 1
    loop i < n {
        q :: quantile_sorted(s, (Float{i}) / (Float{n})) ?? return [Float]{}
        &out.push(q)
        i = i + 1
    }
    out
}

pub fn iqr(xs: [Float]) -> Float? Never! {
    q1 :: quantile(xs, (Float{0.25})) ?? return None
    q3 :: quantile(xs, (Float{0.75})) ?? return None
    value := q3 - q1
    if nonfinite(value) -> return None
    Val(value)
}

pub fn mad(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    m :: median(xs) ?? return None
    scale := Float{0.0}
    loop x in xs {
        magnitude :: abs_value(x)
        if magnitude > scale -> scale = magnitude
    }
    if scale <= (Float{0.0}) -> return Val(Float{0.0})
    center := m / scale
    dev := [Float]{}
    loop x in xs -> &dev.push(abs_value(x / scale - center))
    d :: median(dev) ?? return None
    value := d * scale
    if nonfinite(value) -> return None
    Val(value)
}

pub fn mean_abs_deviation(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    scale := Float{0.0}
    loop x in xs {
        magnitude :: abs_value(x)
        if magnitude > scale -> scale = magnitude
    }
    if scale <= (Float{0.0}) -> return Val(Float{0.0})
    m :: compensated_sum_scaled(xs, scale) / (Float{xs.len()})
    acc := Float{0.0}
    loop x in xs -> acc = acc + abs_value(x / scale - m)
    value := (acc / (Float{xs.len()})) * scale
    if nonfinite(value) -> return None
    Val(value)
}

pub fn skew(xs: [Float]) -> Float? Never! {
    n :: xs.len()
    if n < 3 -> return None
    t :: central_terms(xs) ?? return None
    variance :: t.s2 / (Float{t.n})
    if variance <= (Float{0.0}) -> return None
    root :: sqrt_value(variance)
    Val((t.s3 / (Float{t.n})) / (root * root * root))
}

pub fn kurtosis(xs: [Float]) -> Float? Never! {
    n :: xs.len()
    if n < 4 -> return None
    t :: central_terms(xs) ?? return None
    variance :: t.s2 / (Float{t.n})
    if variance <= (Float{0.0}) -> return None
    Val((t.s4 / (Float{t.n})) / (variance * variance) - (Float{3.0}))
}

pub fn moving_average(xs: [Float], window: Int) -> [Float] Never! {
    out := [Float]{}
    if window <= 0 || invalid_sample(xs) -> return out
    acc := Float{0.0}
    i := 0
    loop i < xs.len() {
        acc = acc + xs[i]
        if i >= window -> acc = acc - xs[i - window]
        if nonfinite(acc) -> return [Float]{}
        width := i + 1
        if width > window -> width = window
        value := acc / (Float{width})
        if nonfinite(value) -> return [Float]{}
        &out.push(value)
        i = i + 1
    }
    out
}

pub fn ewma(xs: [Float], alpha: Float) -> [Float] Never! {
    out := [Float]{}
    if xs.len() == 0 || invalid_sample(xs) || nonfinite(alpha) -> return out
    a := alpha
    if a < (Float{0.0}) -> a = (Float{0.0})
    if a > (Float{1.0}) -> a = (Float{1.0})
    acc := ~xs[0]
    &out.push(acc)
    i := 1
    loop i < xs.len() {
        acc = a * xs[i] + ((Float{1.0}) - a) * acc
        if nonfinite(acc) -> return [Float]{}
        &out.push(acc)
        i = i + 1
    }
    out
}

pub fn cumprod(xs: [Float]) -> [Float] Never! {
    out := [Float]{}
    if invalid_sample(xs) -> return out
    acc := Float{1.0}
    loop x in xs {
        acc = acc * x
        if nonfinite(acc) -> return [Float]{}
        &out.push(acc)
    }
    out
}

pub fn diff(xs: [Float]) -> [Float] Never! {
    out := [Float]{}
    if xs.len() < 2 || invalid_sample(xs) -> return out
    i := 1
    loop i < xs.len() {
        value := xs[i] - xs[i - 1]
        if nonfinite(value) -> return [Float]{}
        &out.push(value)
        i = i + 1
    }
    out
}

pub fn rank(xs: [Float]) -> [Float] Never! {
    out := [Float]{}
    if invalid_sample(xs) -> return out
    n :: xs.len()
    loop i in 0..<n {
        before := 1
        ties := 0
        loop j in 0..<n {
            if xs[j] < xs[i] -> before = before + 1
            if xs[j] == xs[i] -> ties = ties + 1
        }
        &out.push((Float{before}) + (Float{ties - 1}) / (Float{2.0}))
    }
    out
}

pub fn spearman(xs: [Float], ys: [Float]) -> Float? Never! {
    if xs.len() != ys.len() -> return None
    correlation(rank(xs), rank(ys))
}

pub fn r_squared(xs: [Float], ys: [Float]) -> Float? Never! {
    n :: xs.len()
    if n < 2 || ys.len() != n -> return None
    _ :: linear_regression(xs, ys) ?? return None
    r :: correlation(xs, ys) ?? return None
    Val(r * r)
}

pub fn residuals(xs: [Float], ys: [Float]) -> [Float] Never! {
    out := [Float]{}
    if xs.len() != ys.len() || invalid_sample(xs) || invalid_sample(ys) -> return out
    fit :: linear_regression(xs, ys) ?? return out
    loop i in 0..<xs.len() {
        value := ys[i] - (fit.slope * xs[i] + fit.intercept)
        if nonfinite(value) -> return [Float]{}
        &out.push(value)
    }
    out
}

pub fn histogram(xs: [Float], bins: Int) -> [Int] Never! {
    out := [Int]{}
    if bins <= 0 || xs.len() == 0 || invalid_sample(xs) -> return out
    lo :: min(xs) ?? return out
    hi :: max(xs) ?? return out
    loop _ in 0..<bins -> &out.push(0)
    if lo == hi {
        out[0] = xs.len()
        return out
    }
    scale := abs_value(lo)
    if abs_value(hi) > scale -> scale = abs_value(hi)
    loop x in xs {
        t := Float{0.0}
        if scale > (Float{0.0}) {
            lower :: lo / scale
            upper :: hi / scale
            value :: x / scale
            t = (value - lower) / (upper - lower)
        }
        idx := Int{t * (Float{bins})}
        if idx < 0 -> idx = 0
        if idx >= bins -> idx = bins - 1
        out[idx] = out[idx] + 1
    }
    out
}

pub fn describe(xs: [Float]) -> (max: Float, mean: Float, median: Float, min: Float, n: Int, q1: Float, q3: Float, stdev: Float) Never! {
    empty := (max: (Float{0.0}), mean: (Float{0.0}), median: (Float{0.0}), min: (Float{0.0}), n: 0, q1: (Float{0.0}), q3: (Float{0.0}), stdev: (Float{0.0}))
    if xs.len() == 0 || invalid_sample(xs) -> return empty
    return (
        max: max(xs) ?? (Float{0.0}),
        mean: mean(xs) ?? (Float{0.0}),
        median: median(xs) ?? (Float{0.0}),
        min: min(xs) ?? (Float{0.0}),
        n: xs.len(),
        q1: quantile(xs, (Float{0.25})) ?? (Float{0.0}),
        q3: quantile(xs, (Float{0.75})) ?? (Float{0.0}),
        stdev: stdev(xs) ?? (Float{0.0}),
    )
}

pub fn clip(xs: [Float], lo: Float, hi: Float) -> [Float] Never! {
    out := [Float]{}
    if invalid_sample(xs) || nonfinite(lo) || nonfinite(hi) -> return out
    lower := lo
    upper := hi
    if lower > upper {
        swap := ~lower
        lower = upper
        upper = swap
    }
    loop x in xs {
        v := ~x
        if v < lower -> v = lower
        if v > upper -> v = upper
        &out.push(v)
    }
    out
}

pub fn winsorize(xs: [Float], p: Float) -> [Float] Never! {
    if invalid_sample(xs) || p != p || p < (Float{0.0}) || p > (Float{0.5}) -> return [Float]{}
    lo :: quantile(xs, p) ?? return [Float]{}
    hi :: quantile(xs, (Float{1.0}) - p) ?? return [Float]{}
    clip(xs, lo, hi)
}

pub fn pearson(xs: [Float], ys: [Float]) -> Float? Never! { correlation(xs, ys) }

pub fn covariance_population(xs: [Float], ys: [Float]) -> Float? Never! {
    n :: xs.len()
    if n == 0 || ys.len() != n -> return None
    t :: covariance_terms(xs, ys) ?? return None
    if t.sx <= (Float{0.0}) || t.sy <= (Float{0.0}) -> return Val(Float{0.0})
    x_deviation := t.sx * t.x_scale
    y_deviation := t.sy * t.y_scale
    if nonfinite(x_deviation) || nonfinite(y_deviation) -> return None
    value := (t.xy / (Float{n})) * x_deviation * y_deviation
    if nonfinite(value) -> return None
    Val(value)
}
