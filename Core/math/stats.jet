package {
    name: "core.math.stats"
    version: "0.1.0"
    edition: "2026"
    description: "core.math.stats core library."
    license: "MIT"
    outputs: {
        stats: .Library{ entry: stats }
    }
}
use core.math as math
use core.math.random as random
// core.math.stats — descriptive statistics in exact Int / software Float.
//
// Empty samples return `None` rather than NaN. Population variants use `n`
// in the denominator; sample variants use `n - 1`. Ties in `mode` keep the
// first-seen value. This is the surface Python's `statistics` module covers
// plus quantiles, z-scores, covariance, and ordinary-least-squares.
pub fn sum(xs: [Float]) -> Float {
    acc := 0.0
    loop x in xs -> acc = acc + x
    acc
}

pub fn prod(xs: [Float]) -> Float {
    acc := 1.0
    loop x in xs -> acc = acc * x
    acc
}

pub fn mean(xs: [Float]) -> ?Float {
    if xs.len() == 0 -> return None
    Val(sum(xs) / (Float{xs.len()}))
}

pub fn fmean(xs: [Float]) -> ?Float { mean(xs) }

pub fn geometric_mean(xs: [Float]) -> ?Float {
    if xs.len() == 0 -> return None
    acc := 0.0
    loop x in xs {
        if x <= 0.0 -> return None
        acc = acc + math.ln(x)
    }
    Val(math.exp(acc / (Float{xs.len()})))
}

pub fn harmonic_mean(xs: [Float]) -> ?Float {
    if xs.len() == 0 -> return None
    acc := 0.0
    loop x in xs {
        if x == 0.0 -> return None
        acc = acc + 1.0 / x
    }
    Val(Float{xs.len()} / acc)
}

pub fn median(xs: [Float]) -> ?Float {
    n :: xs.len()
    if n == 0 -> return None
    s :: sorted(xs)
    mid :: n / 2
    if n % 2 == 1 -> return Val(s[mid])
    Val((s[mid - 1] + s[mid]) / 2.0)
}

pub fn median_grouped(xs: [Float], interval: Float) -> ?Float {
    if xs.len() == 0 || interval <= 0.0 -> return None
    s :: sorted(xs)
    n :: s.len()
    mid :: n / 2
    x :: if n % 2 == 1 -> s[mid] else -> (s[mid - 1] + s[mid]) / 2.0
    lower :: x - interval / 2.0
    upper :: lower + interval
    below := 0
    frequency := 0
    loop value in s {
        if value < lower -> below += 1
        if value >= lower && value < upper -> frequency += 1
    }
    if frequency == 0 -> return Val(x)
    Val(lower + interval * (Float{mid - below}) / Float{frequency})
}

pub fn median_low(xs: [Float]) -> ?Float {
    n :: xs.len()
    if n == 0 -> return None
    s :: sorted(xs)
    if n % 2 == 1 -> return Val(s[n / 2])
    Val(s[n / 2 - 1])
}

pub fn median_high(xs: [Float]) -> ?Float {
    n :: xs.len()
    if n == 0 -> return None
    s :: sorted(xs)
    Val(s[n / 2])
}

pub fn quantile(xs: [Float], p: Float) -> ?Float {
    if xs.len() == 0 -> return None
    if p <= 0.0 -> return Val(sorted(xs)[0])
    if p >= 1.0 -> return Val(sorted(xs)[xs.len() - 1])
    s :: sorted(xs)
    x :: p * (Float{s.len() - 1})
    lo :: (Int{x})
    hi :: lo + 1
    if hi >= s.len() -> return Val(s[s.len() - 1])
    frac :: x - (Float{lo})
    Val(s[lo] + (s[hi] - s[lo]) * frac)
}

pub fn percentile(xs: [Float], pct: Float) -> ?Float { quantile(xs, pct / 100.0) }

pub fn mode(xs: [Float]) -> ?Float {
    if xs.len() == 0 -> return None
    best := xs[0]
    best_n := 0
    loop x in xs {
        n := 0
        loop y in xs {
            if y == x -> n = n + 1
        }
        if n > best_n {
            best = x
            best_n = n
        }
    }
    Val(best)
}

pub fn multimode(xs: [Float]) -> [Float] {
    out := [Float]{}
    if xs.len() == 0 -> return out
    best := 0
    loop x in xs {
        n := 0
        loop y in xs {
            if y == x -> n = n + 1
        }
        if n > best -> best = n
    }
    loop x in xs {
        n := 0
        loop y in xs {
            if y == x -> n = n + 1
        }
        if n == best {
            seen := false
            loop z in out {
                if z == x -> seen = true
            }
            if !seen -> out.push(x)
        }
    }
    out
}

pub fn pvariance(xs: [Float]) -> ?Float { variance_den(xs, xs.len()) }

pub fn pstdev(xs: [Float]) -> ?Float {
    v :: pvariance(xs) ?? return None
    Val(math.sqrt(v))
}

pub fn variance(xs: [Float]) -> ?Float {
    if xs.len() < 2 -> return None
    variance_den(xs, xs.len() - 1)
}

pub fn stdev(xs: [Float]) -> ?Float {
    v :: variance(xs) ?? return None
    Val(math.sqrt(v))
}

pub fn covariance(xs: [Float], ys: [Float]) -> ?Float {
    n :: xs.len()
    if n < 2 || ys.len() != n -> return None
    mx :: mean(xs) ?? return None
    my :: mean(ys) ?? return None
    acc := 0.0
    i := 0
    loop i < n {
        acc = acc + (xs[i] - mx) * (ys[i] - my)
        i = i + 1
    }
    Val(acc / (Float{n - 1}))
}

pub fn correlation(xs: [Float], ys: [Float]) -> ?Float {
    sx :: stdev(xs) ?? return None
    sy :: stdev(ys) ?? return None
    if sx == 0.0 || sy == 0.0 -> return None
    cov :: covariance(xs, ys) ?? return None
    Val(cov / (sx * sy))
}

pub fn linear_regression(xs: [Float], ys: [Float]) -> ?SlopeIntercept {
    n :: xs.len()
    if n < 2 || ys.len() != n -> return None
    mx :: mean(xs) ?? return None
    my :: mean(ys) ?? return None
    num := 0.0
    den := 0.0
    i := 0
    loop i < n {
        dx :: xs[i] - mx
        num = num + dx * (ys[i] - my)
        den = den + dx * dx
        i = i + 1
    }
    if den == 0.0 -> return None
    slope :: num / den
    Val(SlopeIntercept{slope: slope, intercept: my - slope * mx})
}

pub struct SlopeIntercept {
    pub slope: Float
    pub intercept: Float
}
pub struct NormalDist {
    pub mu: Float
    pub sigma: Float
}

pub fn normal_dist(mu: Float, sigma: Float) -> NormalDist {
    NormalDist{mu: mu, sigma: sigma}
}

pub fn kde(xs: [Float], bandwidth: Float) -> [Float] {
    out := [Float]{}
    if xs.len() == 0 || bandwidth <= 0.0 -> return out
    scale :: Float{xs.len()} * bandwidth * math.sqrt(2.0 * math.pi)
    loop point in xs {
        total := 0.0
        loop value in xs {
            z :: (point - value) / bandwidth
            total += math.exp(-0.5 * z * z)
        }
        out.push(total / scale)
    }
    out
}

pub fn kde_random(xs: [Float], bandwidth: Float, n: Int) -> [Float] {
    density :: kde(xs, bandwidth)
    out := [Float]{}
    if density.len() == 0 || n <= 0 -> return out
    loop i in 0..<n -> out.push(density[i % density.len()])
    out
}

pub fn zscore(xs: [Float]) -> [Float] {
    m :: mean(xs) ?? return [Float]{}
    s :: pstdev(xs) ?? return [Float]{}
    if s == 0.0 -> return [Float]{}
    out := [Float]{}
    loop x in xs -> out.push((x - m) / s)
    out
}

pub fn min(xs: [Float]) -> ?Float {
    if xs.len() == 0 -> return None
    m := xs[0]
    loop x in xs {
        if x < m -> m = x
    }
    Val(m)
}

pub fn max(xs: [Float]) -> ?Float {
    if xs.len() == 0 -> return None
    m := xs[0]
    loop x in xs {
        if x > m -> m = x
    }
    Val(m)
}

pub fn range(xs: [Float]) -> ?Float {
    lo :: min(xs) ?? return None
    hi :: max(xs) ?? return None
    Val(hi - lo)
}

pub fn cumsum(xs: [Float]) -> [Float] {
    out := [Float]{}
    acc := 0.0
    loop x in xs {
        acc = acc + x
        out.push(acc)
    }
    out
}

fn variance_den(xs: [Float], den: Int) -> ?Float {
    if den <= 0 || xs.len() == 0 -> return None
    m :: mean(xs) ?? return None
    acc := 0.0
    loop x in xs {
        d :: x - m
        acc = acc + d * d
    }
    Val(acc / (Float{den}))
}

fn sorted(xs: [Float]) -> [Float] {
    out := [Float]{}
    loop x in xs -> out.push(x)
    n :: out.len()
    i := 0
    loop i < n {
        j := 0
        loop j < n - 1 {
            if out[j] > out[j + 1] {
                t :: out[j]
                out[j] = out[j + 1]
                out[j + 1] = t
            }
            j = j + 1
        }
        i = i + 1
    }
    out
}

pub fn count(xs: [Float]) -> Int { xs.len() }

pub fn sumprod(xs: [Float], ys: [Float]) -> ?Float {
    if xs.len() != ys.len() -> return None
    acc := 0.0
    i := 0
    loop i < xs.len() {
        acc = acc + xs[i] * ys[i]
        i = i + 1
    }
    Val(acc)
}

pub fn weighted_mean(xs: [Float], weights: [Float]) -> ?Float {
    if xs.len() == 0 || xs.len() != weights.len() -> return None
    num := 0.0
    den := 0.0
    i := 0
    loop i < xs.len() {
        if weights[i] < 0.0 -> return None
        num = num + xs[i] * weights[i]
        den = den + weights[i]
        i = i + 1
    }
    if den == 0.0 -> return None
    Val(num / den)
}

pub fn quantiles(xs: [Float], n: Int) -> [Float] {
    out := [Float]{}
    if n <= 0 || xs.len() == 0 -> return out
    i := 1
    loop i < n {
        q :: quantile(xs, (Float{i}) / (Float{n})) ?? return out
        out.push(q)
        i = i + 1
    }
    out
}

pub fn iqr(xs: [Float]) -> ?Float {
    q1 :: quantile(xs, 0.25) ?? return None
    q3 :: quantile(xs, 0.75) ?? return None
    Val(q3 - q1)
}

pub fn mad(xs: [Float]) -> ?Float {
    m :: median(xs) ?? return None
    dev := [Float]{}
    loop x in xs {
        d :: x - m
        if d < 0.0 -> dev.push(0.0 - d) else -> dev.push(d)
    }
    median(dev)
}

pub fn mean_abs_deviation(xs: [Float]) -> ?Float {
    m :: mean(xs) ?? return None
    acc := 0.0
    loop x in xs {
        d :: x - m
        if d < 0.0 -> acc = acc + (0.0 - d) else -> acc = acc + d
    }
    Val(acc / (Float{xs.len()}))
}

pub fn skew(xs: [Float]) -> ?Float {
    n :: xs.len()
    if n < 3 -> return None
    m :: mean(xs) ?? return None
    s :: stdev(xs) ?? return None
    if s == 0.0 -> return None
    acc := 0.0
    loop x in xs {
        z :: (x - m) / s
        acc = acc + z * z * z
    }
    Val(acc / (Float{n}))
}

pub fn kurtosis(xs: [Float]) -> ?Float {
    n :: xs.len()
    if n < 4 -> return None
    m :: mean(xs) ?? return None
    s :: stdev(xs) ?? return None
    if s == 0.0 -> return None
    acc := 0.0
    loop x in xs {
        z :: (x - m) / s
        acc = acc + z * z * z * z
    }
    Val(acc / (Float{n}) - 3.0)
}

pub fn moving_average(xs: [Float], window: Int) -> [Float] {
    out := [Float]{}
    if window <= 0 -> return out
    i := 0
    loop i < xs.len() {
        start := i - window + 1
        if start < 0 -> start = 0
        acc := 0.0
        k := start
        loop k <= i {
            acc = acc + xs[k]
            k = k + 1
        }
        out.push(acc / (Float{i - start + 1}))
        i = i + 1
    }
    out
}

pub fn ewma(xs: [Float], alpha: Float) -> [Float] {
    out := [Float]{}
    if xs.len() == 0 -> return out
    a := alpha
    if a < 0.0 -> a = 0.0
    if a > 1.0 -> a = 1.0
    acc := xs[0]
    out.push(acc)
    i := 1
    loop i < xs.len() {
        acc = a * xs[i] + (1.0 - a) * acc
        out.push(acc)
        i = i + 1
    }
    out
}

pub fn cumprod(xs: [Float]) -> [Float] {
    out := [Float]{}
    acc := 1.0
    loop x in xs {
        acc = acc * x
        out.push(acc)
    }
    out
}

pub fn diff(xs: [Float]) -> [Float] {
    out := [Float]{}
    if xs.len() < 2 -> return out
    i := 1
    loop i < xs.len() {
        out.push(xs[i] - xs[i - 1])
        i = i + 1
    }
    out
}

pub fn rank(xs: [Float]) -> [Float] {
    n :: xs.len()
    out := [Float]{}
    loop i in 0..<n {
        r := 1.0
        loop j in 0..<n {
            if xs[j] < xs[i] -> r = r + 1.0
        }
        out.push(r)
    }
    out
}

pub fn spearman(xs: [Float], ys: [Float]) -> ?Float { correlation(rank(xs), rank(ys)) }

pub fn r_squared(xs: [Float], ys: [Float]) -> ?Float {
    fit :: linear_regression(xs, ys) ?? return None
    pred := [Float]{}
    loop x in xs -> pred.push(fit.slope * x + fit.intercept)
    my :: mean(ys) ?? return None
    ss_res := 0.0
    ss_tot := 0.0
    i := 0
    loop i < ys.len() {
        e :: ys[i] - pred[i]
        ss_res = ss_res + e * e
        d :: ys[i] - my
        ss_tot = ss_tot + d * d
        i = i + 1
    }
    if ss_tot == 0.0 -> return None
    Val(1.0 - ss_res / ss_tot)
}

pub fn residuals(xs: [Float], ys: [Float]) -> [Float] {
    fit :: linear_regression(xs, ys) ?? return [Float]{}
    out := [Float]{}
    i := 0
    loop i < xs.len() {
        out.push(ys[i] - (fit.slope * xs[i] + fit.intercept))
        i = i + 1
    }
    out
}

pub fn histogram(xs: [Float], bins: Int) -> [Int] {
    out := [Int]{}
    if bins <= 0 || xs.len() == 0 -> return out
    lo :: min(xs) ?? return out
    hi :: max(xs) ?? return out
    loop i in 0..<bins -> out.push(0)
    span :: hi - lo
    if span == 0.0 {
        out[0] = xs.len()
        return out
    }
    loop x in xs {
        t :: (x - lo) / span
        b :: Int{t * (Float{bins})}
        idx := b
        if idx < 0 -> idx = 0
        if idx >= bins -> idx = bins - 1
        out[idx] = out[idx] + 1
    }
    out
}

pub fn describe(xs: [Float]) -> (max: Float, mean: Float, median: Float, min: Float, n: Int, q1: Float, q3: Float, stdev: Float) {
    empty := (n: 0, mean: 0.0, stdev: 0.0, min: 0.0, q1: 0.0, median: 0.0, q3: 0.0, max: 0.0)
    if xs.len() == 0 -> return empty
    return (
        n: xs.len(),
        mean: mean(xs) ?? 0.0,
        stdev: stdev(xs) ?? 0.0,
        min: min(xs) ?? 0.0,
        q1: quantile(xs, 0.25) ?? 0.0,
        median: median(xs) ?? 0.0,
        q3: quantile(xs, 0.75) ?? 0.0,
        max: max(xs) ?? 0.0,
    )
}

pub fn clip(xs: [Float], lo: Float, hi: Float) -> [Float] {
    out := [Float]{}
    loop x in xs {
        v := x
        if v < lo -> v = lo
        if v > hi -> v = hi
        out.push(v)
    }
    out
}

pub fn winsorize(xs: [Float], p: Float) -> [Float] {
    lo :: quantile(xs, p) ?? return xs
    hi :: quantile(xs, 1.0 - p) ?? return xs
    clip(xs, lo, hi)
}

pub fn pearson(xs: [Float], ys: [Float]) -> ?Float { correlation(xs, ys) }

pub fn covariance_population(xs: [Float], ys: [Float]) -> ?Float {
    n :: xs.len()
    if n == 0 || ys.len() != n -> return None
    mx :: mean(xs) ?? return None
    my :: mean(ys) ?? return None
    acc := 0.0
    i := 0
    loop i < n {
        acc = acc + (xs[i] - mx) * (ys[i] - my)
        i = i + 1
    }
    Val(acc / (Float{n}))
}
