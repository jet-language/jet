pub fn acosh(n: Float) -> Float Never! { core.math.acosh(n) }
pub fn asin(n: Float) -> Float Never! { core.math.asin(n) }
pub fn asinh(n: Float) -> Float Never! { core.math.asinh(n) }
pub fn atan(n: Float) -> Float Never! { core.math.atan(n) }
pub fn atan2(a: Float, b: Float) -> Float Never! { core.math.atan2(a, b) }
pub fn atanh(n: Float) -> Float Never! { core.math.atanh(n) }
pub fn cbrt(n: Float) -> Float Never! { core.math.cbrt(n) }
pub fn cos(n: Float) -> Float Never! { core.math.cos(n) }
pub fn cosh(n: Float) -> Float Never! { core.math.cosh(n) }
pub fn exp(n: Float) -> Float Never! { core.math.exp(n) }
pub fn exp2(n: Float) -> Float Never! { core.math.exp2(n) }
pub fn exp_m1(n: Float) -> Float Never! { core.math.exp_m1(n) }
pub fn expm1(n: Float) -> Float Never! { exp_m1(n) }
pub fn erf(n: Float) -> Float Never! { core.math.erf(n) }
pub fn erfc(n: Float) -> Float Never! { core.math.erfc(n) }
pub fn floor(n: Float) -> Float Never! { core.math.floor(n) }
pub fn ceil(n: Float) -> Float Never! { core.math.ceil(n) }
pub fn fract(n: Float) -> Float Never! { core.math.fract(n) }
pub fn gamma(n: Float) -> Float Never! { core.math.gamma(n) }
pub fn lgamma(n: Float) -> Float Never! { core.math.lgamma(n) }
pub fn hypot(a: Float, b: Float) -> Float Never! { core.math.hypot(a, b) }
pub fn ln(n: Float) -> Float Never! { core.math.ln(n) }
pub fn ln_1p(n: Float) -> Float Never! { core.math.ln_1p(n) }
pub fn log1p(n: Float) -> Float Never! { ln_1p(n) }
pub fn log(n: Float, base: Float) -> Float Never! { core.math.log(n, base) }
pub fn log10(n: Float) -> Float Never! { core.math.log10(n) }
pub fn log2(n: Float) -> Float Never! { core.math.log2(n) }
pub fn logb(n: Float) -> Float Never! { core.math.logb(n) }
pub fn pow(a: Float, b: Float) -> Float Never! { core.math.pow(a, b) }
pub fn sin(n: Float) -> Float Never! { core.math.sin(n) }
pub fn sinh(n: Float) -> Float Never! { core.math.sinh(n) }
pub fn sqrt(n: Float) -> Float Never! { core.math.sqrt(n) }
pub fn tan(n: Float) -> Float Never! { core.math.tan(n) }
pub fn tanh(n: Float) -> Float Never! { core.math.tanh(n) }
pub fn trunc(n: Float) -> Float Never! { core.math.trunc(n) }
pub fn truncate(n: Float) -> Float Never! { trunc(n) }

pub fn cot(n: Float) -> Float Never! { core.math.cot(n) }
pub fn copysign(value: Float, sign_value: Float) -> Float Never! {
    core.math.copysign(value, sign_value)
}
pub fn fma(a: Float, b: Float, c: Float) -> Float Never! { core.math.fma(a, b, c) }
pub fn muladd(a: Float, b: Float, c: Float) -> Float Never! { fma(a, b, c) }
pub fn inv(n: Float) -> Float Never! { core.math.inv(n) }
pub fn signum(n: Float) -> Float Never! { core.math.signum(n) }
pub fn degrees(n: Float) -> Float Never! { core.math.degrees(n) }
pub fn radians(n: Float) -> Float Never! { core.math.radians(n) }
pub fn lerp(a: Float, b: Float, t: Float) -> Float Never! { core.math.lerp(a, b, t) }
pub fn float32(n: Float) -> Float Never! { core.math.float32(n) }
pub fn float64(n: Float) -> Float Never! { core.math.float64(n) }
pub fn fabs(n: Float) -> Float Never! { core.math.fabs(n) }
pub fn real(n: Float) -> Float Never! { n }
pub fn imag(n: Float) -> Float Never! { Float{0.0} }
pub fn conj(n: Float) -> Float Never! { n }

pub fn is_nan(n: Float) -> Bool Never! { core.math.is_nan(n) }
pub fn is_inf(n: Float) -> Bool Never! { core.math.is_inf(n) }
pub fn is_finite(n: Float) -> Bool Never! { core.math.is_finite(n) }
pub fn isnan(n: Float) -> Bool Never! { is_nan(n) }
pub fn isinf(n: Float) -> Bool Never! { is_inf(n) }
pub fn isfinite(n: Float) -> Bool Never! { is_finite(n) }
pub fn is_normal(n: Float) -> Bool Never! { core.math.is_normal(n) }
pub fn is_subnormal(n: Float) -> Bool Never! { core.math.is_subnormal(n) }
