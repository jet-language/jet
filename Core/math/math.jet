package {
    name: "core.math"
    version: "0.0.1"
    edition: "2026"
    description: "Exact integer arithmetic and IEEE floating-point composition in Jet."
    license: "MIT"
    outputs: {
        math: .Library{ entry: math }
    }
}
use core as core
pub fn abs(n: Int) -> Int Never! {
    if n < 0 -> return -n
    n
}

pub fn abs_float(n: Float) -> Float Never! { core.math.fabs(n) }


pub fn min(a: Int, b: Int) -> Int Never! {
    if a < b -> return a
    b
}

pub fn max(a: Int, b: Int) -> Int Never! {
    if a > b -> return a
    b
}

pub fn clamp(x: Int, lo: Int, hi: Int) -> Int Never! {
    lower := lo
    upper := hi
    if lower > upper {
        swap := lower
        lower = upper
        upper = swap
    }
    if x < lower -> return lower
    if x > upper -> return upper
    x
}

pub fn is_even(n: Int) -> Bool Never! { n % 2 == 0 }
pub fn is_odd(n: Int) -> Bool Never! { n % 2 != 0 }

pub fn sign(n: Int) -> Int Never! {
    if n > 0 -> return 1
    if n < 0 -> return -1
    0
}

pub fn isqrt(n: Int) -> Int? Never! {
    if n < 0 -> return None
    if n < 2 -> return Val(n)
    lo := 1
    hi := n
    ans := 1
    loop lo <= hi {
        mid :: lo + (hi - lo) /% 2
        // Compare through division so `mid * mid` cannot overflow.
        if mid > n /% mid {
            hi = mid - 1
        } else {
            ans = mid
            if mid == n /% mid && n %% mid == 0 -> return Val(mid)
            lo = mid + 1
        }
    }
    Val(ans)
}

pub fn gcd(a: Int, b: Int) -> Int Never! {
    x := abs(a)
    y := abs(b)
    loop y != 0 {
        next :: x % y
        x = y
        y = next
    }
    x
}

pub fn lcm(a: Int, b: Int) -> Int Never! {
    if a == 0 || b == 0 -> return 0
    abs(a /% gcd(a, b) * b)
}
// Floating-point entry points remain thin Jet APIs over the existing
// deterministic Core primitives.  Keeping the call qualified is deliberate:
// inside this source package it selects the primitive Core route rather than
// recursively calling the source implementation being defined.
pub fn acos(n: Float) -> Float Never! { core.math.acos(n) }
pub fn acosh(n: Float) -> Float Never! { core.math.acosh(n) }
pub fn asin(n: Float) -> Float Never! { core.math.asin(n) }
pub fn asinh(n: Float) -> Float Never! { core.math.asinh(n) }
pub fn atan(n: Float) -> Float Never! { core.math.atan(n) }
pub fn atan2(a: Float, b: Float) -> Float Never! { core.math.atan2(a, b) }
pub fn atanh(n: Float) -> Float Never! { core.math.atanh(n) }
pub fn cbrt(n: Float) -> Float Never! { core.math.cbrt(n) }
pub fn cos(n: Float) -> Float Never! { core.math.cos(n) }
pub fn cosh(n: Float) -> Float Never! { core.math.cosh(n) }
pub fn exp(n: Float) -> Float Never! { core.math.exp(n) }
pub fn exp2(n: Float) -> Float Never! { core.math.exp2(n) }
pub fn exp_m1(n: Float) -> Float Never! { core.math.exp_m1(n) }
pub fn expm1(n: Float) -> Float Never! { exp_m1(n) }
/// Abramowitz & Stegun 7.1.26, retaining the runtime polynomial and operation order.
pub fn erf(n: Float) -> Float Never! {
    if is_nan(n) -> return nan()
    if is_inf(n) -> return signum(n)
    sign := Float{1.0}
    if n < 0.0 -> sign = -1.0
    magnitude :: fabs(n)
    t :: Float{1.0} / (Float{1.0} + Float{0.3275911} * magnitude)
    polynomial :: t * (Float{0.254829592} + t * (-Float{0.284496736} + t * (Float{1.421413741} + t * (-Float{1.453152027} + t * Float{1.061405429}))))
    sign * (Float{1.0} - polynomial * exp(-magnitude * magnitude))
}
pub fn erfc(n: Float) -> Float Never! { 1.0 - erf(n) }
pub fn floor(n: Float) -> Float Never! { core.math.floor(n) }
pub fn ceil(n: Float) -> Float Never! { core.math.ceil(n) }
pub fn fract(n: Float) -> Float Never! { n - trunc(n) }
/// Lanczos g=7, n=9, reflected below one half.
pub fn gamma(n: Float) -> Float Never! {
    if is_nan(n) -> return nan()
    if n <= 0.0 && n == floor(n) -> return nan()
    if n < 0.5 -> return pi() / (sin(pi() * n) * gamma(1.0 - n))
    z :: n - 1.0
    accumulator := Float{0.99999999999980993}
    accumulator = accumulator + Float{676.5203681218851} / (z + 1.0)
    accumulator = accumulator + -Float{1259.1392167224028} / (z + 2.0)
    accumulator = accumulator + Float{771.32342877765313} / (z + 3.0)
    accumulator = accumulator + -Float{176.61502916214059} / (z + 4.0)
    accumulator = accumulator + Float{12.507343278686905} / (z + 5.0)
    accumulator = accumulator + -Float{0.13857109526572012} / (z + 6.0)
    accumulator = accumulator + Float{9.984369654078991e-6} / (z + 7.0)
    accumulator = accumulator + Float{1.5056327351493116e-7} / (z + 8.0)
    t :: z + 7.0 + 0.5
    sqrt(2.0 * pi()) * pow(t, z + 0.5) * exp(-t) * accumulator
}
pub fn lgamma(n: Float) -> Float Never! {
    value :: gamma(n)
    if is_nan(value) || value <= 0.0 -> return nan()
    ln(value)
}
pub fn hypot(a: Float, b: Float) -> Float Never! { core.math.hypot(a, b) }
pub fn ln(n: Float) -> Float Never! { core.math.ln(n) }
pub fn ln_1p(n: Float) -> Float Never! { core.math.ln_1p(n) }
pub fn log1p(n: Float) -> Float Never! { ln_1p(n) }
pub fn log(n: Float, base: Float) -> Float Never! { ln(n) / ln(base) }
pub fn log10(n: Float) -> Float Never! { core.math.log10(n) }
pub fn log2(n: Float) -> Float Never! { core.math.log2(n) }
pub fn logb(n: Float) -> Float Never! {
    if ilogb(n) == {
        .Val(exponent) -> return Float{exponent}
        .None -> {}
    }
    if n == 0.0 -> return -infinity()
    infinity()
}
pub fn pow(a: Float, b: Float) -> Float Never! { core.math.pow(a, b) }
pub fn sin(n: Float) -> Float Never! { core.math.sin(n) }
pub fn sinh(n: Float) -> Float Never! { core.math.sinh(n) }
pub fn sqrt(n: Float) -> Float Never! { core.math.sqrt(n) }
pub fn tan(n: Float) -> Float Never! { core.math.tan(n) }
pub fn tanh(n: Float) -> Float Never! { core.math.tanh(n) }
pub fn trunc(n: Float) -> Float Never! { core.math.trunc(n) }
pub fn truncate(n: Float) -> Float Never! { trunc(n) }

pub fn cot(n: Float) -> Float Never! { 1.0 / tan(n) }
pub fn copysign(value: Float, sign_value: Float) -> Float Never! {
    magnitude :: to_bits(value) & 9223372036854775807
    sign :: to_bits(sign_value) & (-9223372036854775807 - 1)
    from_bits(magnitude | sign)
}
pub fn fma(a: Float, b: Float, c: Float) -> Float Never! { core.math.fma(a, b, c) }
pub fn muladd(a: Float, b: Float, c: Float) -> Float Never! { fma(a, b, c) }
pub fn inv(n: Float) -> Float Never! { 1.0 / n }
pub fn signum(n: Float) -> Float Never! {
    if is_nan(n) -> return nan()
    if sign_bit(n) -> return -1.0
    1.0
}
pub fn degrees(n: Float) -> Float Never! { n * 57.29577951308232 }
pub fn radians(n: Float) -> Float Never! { n * 0.017453292519943295 }
pub fn lerp(a: Float, b: Float, t: Float) -> Float Never! { a + (b - a) * t }
pub fn float32(n: Float) -> Float Never! { n }
pub fn float64(n: Float) -> Float Never! { n }
pub fn fabs(n: Float) -> Float Never! { from_bits(to_bits(n) & 9223372036854775807) }
pub fn real(n: Float) -> Float Never! { n }
pub fn imag(n: Float) -> Float Never! { Float{0.0} }
pub fn conj(n: Float) -> Float Never! { n }

pub fn is_nan(n: Float) -> Bool Never! { n != n }
pub fn is_inf(n: Float) -> Bool Never! { fabs(n) == infinity() }
fn is_finite(n: Float) -> Bool Never! { fabs(n) < infinity() }
pub fn isnan(n: Float) -> Bool Never! { is_nan(n) }
pub fn isinf(n: Float) -> Bool Never! { is_inf(n) }
pub fn isfinite(n: Float) -> Bool Never! { is_finite(n) }
pub fn is_normal(n: Float) -> Bool Never! {
    magnitude :: fabs(n)
    magnitude >= 2.2250738585072014e-308 && magnitude < infinity()
}
pub fn is_subnormal(n: Float) -> Bool Never! {
    magnitude :: fabs(n)
    magnitude > 0.0 && magnitude < 2.2250738585072014e-308
}
pub fn is_canonical(n: Float) -> Bool Never! { is_finite(n) || is_nan(n) }
pub fn is_signed(n: Float) -> Bool Never! { sign_bit(n) }
pub fn is_zero(n: Float) -> Bool Never! { n == 0.0 }
pub fn is_integer(n: Float) -> Bool Never! { is_finite(n) && fract(n) == 0.0 }
pub fn sign_bit(n: Float) -> Bool Never! { to_bits(n) < 0 }

pub fn next_up(n: Float) -> Float Never! {
    if is_nan(n) || n == infinity() -> return n
    next_after(n, infinity())
}
pub fn next_down(n: Float) -> Float Never! {
    if is_nan(n) || n == -infinity() -> return n
    next_after(n, -infinity())
}
pub fn next_after(n: Float, toward: Float) -> Float Never! {
    if is_nan(n) || is_nan(toward) -> return nan()
    if n == toward -> return toward
    if n == 0.0 {
        if toward > 0.0 -> return from_bits(1)
        return -from_bits(1)
    }
    bits := to_bits(n)
    if (toward > n) == !sign_bit(n) -> bits = bits + 1 else -> bits = bits - 1
    from_bits(bits)
}
pub fn nextafter(n: Float, toward: Float) -> Float Never! { next_after(n, toward) }
pub fn significand(n: Float) -> Float Never! {
    if n == 0.0 || !is_finite(n) -> return n
    bits :: to_bits(n)
    exponent :: (bits >> 52) & 2047
    if exponent == 0 {
        value := fabs(n)
        loop value < 1.0 -> value = value * 2.0
        return copysign(value, n)
    }
    copysign(from_bits((1023 << 52) | (bits & 4503599627370495)), n)
}
pub fn ulp(n: Float) -> Float Never! {
    if is_nan(n) -> return nan()
    if is_inf(n) -> return infinity()
    magnitude :: fabs(n)
    if magnitude == 0.0 -> return from_bits(1)
    from_bits(to_bits(magnitude) + 1) - magnitude
}
pub fn ilogb(n: Float) -> Int? Never! {
    if n == 0.0 || !is_finite(n) -> return None
    Val(Int{floor(log2(fabs(n)))})
}
pub fn ldexp(n: Float, exponent: Int) -> Float Never! {
    if !is_finite(n) || n == 0.0 || exponent == 0 -> return n
    n * pow(2.0, Float{clamp(exponent, -2099, 2099)})
}
pub fn scaleb(n: Float, exponent: Int) -> Float Never! { ldexp(n, exponent) }
pub fn radix(n: Float) -> Int Never! { 2 }

pub fn pi() -> Float Never! { Float{3.14159265358979323846264338327950288} }
pub fn e() -> Float Never! { Float{2.7182818284590452354} }
pub fn tau() -> Float Never! { Float{6.2831853071795864769} }
pub fn tau_const() -> Float Never! { tau() }
pub fn infinity() -> Float Never! { (Float{1.0}) / (Float{0.0}) }
pub fn nan() -> Float Never! { (Float{0.0}) / (Float{0.0}) }
pub fn zero() -> Float Never! { Float{0.0} }

pub fn round(n: Float) -> Int Never! {
    if is_nan(n) -> return 0
    if n >= 9223372036854775808.0 -> return 9223372036854775807
    if n <= -9223372036854775808.0 -> return -9223372036854775808
    whole := trunc(n)
    fraction :: n - whole
    if fraction >= 0.5 -> whole = whole + 1.0
    if fraction <= -0.5 -> whole = whole - 1.0
    Int{whole}
}
pub fn to_bits(n: Float) -> Int Never! { core.math.to_bits(n) }
pub fn from_bits(bits: Int) -> Float Never! { core.math.from_bits(bits) }
pub fn sin_cos(n: Float) -> (cos: Float, sin: Float) Never! {
    pair :: core.math.sin_cos(n)
    (cos: pair.cos, sin: pair.sin)
}
pub fn modf(n: Float) -> (fract: Float, whole: Float) Never! {
    (fract: fract(n), whole: trunc(n))
}
pub fn frexp(n: Float) -> (exp: Int, frac: Float) Never! {
    exponent :: ilogb(n) ?? 0
    if n == 0.0 || !is_finite(n) -> return (exp: exponent, frac: n)
    (exp: exponent, frac: ldexp(n, -exponent))
}

pub fn checked_abs(n: Int) -> Int? Never! {
    if n < 0 -> return Val(0 - n)
    Val(n)
}

pub fn checked_neg(n: Int) -> Int? Never! { Val(0 - n) }

pub fn checked_add(a: Int, b: Int) -> Int? Never! { Val(a + b) }

pub fn checked_sub(a: Int, b: Int) -> Int? Never! { Val(a - b) }

pub fn checked_mul(a: Int, b: Int) -> Int? Never! { Val(a * b) }

pub fn checked_div(a: Int, b: Int) -> Int? Never! {
    if b == 0 -> return None
    remainder :: a %% b
    Val((a - remainder) /% b)
}

pub fn checked_rem(a: Int, b: Int) -> Int? Never! {
    if b == 0 -> return None
    Val(a %% b)
}

pub fn checked_pow(base: Int, exponent: Int) -> Int? Never! {
    if exponent < 0 -> return None
    result := 1
    factor := base
    power := exponent
    loop power > 0 {
        if (power & 1) != 0 {
            result = checked_mul(result, factor) ?? return None
        }
        power = power /% 2
        if power > 0 -> factor = checked_mul(factor, factor) ?? return None
    }
    Val(result)
}

pub fn int_pow(base: Int, exponent: Int) -> Int Never! {
    if exponent < 0 -> return 0
    result := 1
    factor := base
    power := exponent
    loop power > 0 {
        if (power & 1) != 0 {
            result = result * factor
        }
        power = power /% 2
        if power > 0 -> factor = factor * factor
    }
    result
}

pub fn saturating_add(a: Int, b: Int) -> Int Never! { a + b }

pub fn saturating_sub(a: Int, b: Int) -> Int Never! { a - b }

pub fn saturating_mul(a: Int, b: Int) -> Int Never! { a * b }

pub fn factorial(n: Int) -> Int? Never! {
    if n < 0 -> return None
    acc := 1
    i := 2
    loop i <= n {
        acc = checked_mul(acc, i) ?? return None
        i = i + 1
    }
    Val(acc)
}

pub fn binomial(n: Int, k: Int) -> Int? Never! {
    if n < 0 || k < 0 || k > n -> return None
    choose_k := k
    if choose_k > n - choose_k -> choose_k = n - choose_k
    acc := 1
    i := 1
    loop i <= choose_k {
        factor :: n - choose_k + i
        acc = checked_mul(acc, factor) ?? return None
        acc = acc /% i
        i = i + 1
    }
    Val(acc)
}

pub fn comb(n: Int, k: Int) -> Int? Never! { binomial(n, k) }

pub fn perm(n: Int, k: Int) -> Int? Never! {
    if n < 0 || k < 0 || k > n -> return None
    acc := 1
    i := 0
    loop i < k {
        acc = checked_mul(acc, n - i) ?? return None
        i = i + 1
    }
    Val(acc)
}

pub fn gcd_many(values: [Int]) -> Int Never! {
    acc := 0
    loop value in values -> acc = gcd(acc, value)
    acc
}

pub fn lcm_many(values: [Int]) -> Int Never! {
    if values.len() == 0 -> return 0
    acc := values[0]
    i := 1
    loop i < values.len() {
        acc = lcm(acc, values[i])
        i = i + 1
    }
    acc
}

pub fn powmod(base: Int, exponent: Int, modulus: Int) -> Int? Never! {
    if modulus <= 0 || exponent < 0 -> return None
    result := 1 %% modulus
    factor := base %% modulus
    if factor < 0 -> factor = factor + modulus
    power := exponent
    loop power > 0 {
        if (power & 1) != 0 {
            product :: checked_mul(result, factor) ?? return None
            result = product %% modulus
        }
        power = power /% 2
        square :: checked_mul(factor, factor) ?? return None
        factor = square %% modulus
    }
    Val(result)
}

pub fn div_mod(a: Int, b: Int) -> (quot: Int, rem: Int) Never! {
    rem := a %% b
    if rem < 0 {
        if b > 0 -> rem = rem + b
        if b < 0 -> rem = rem - b
    }
    (quot: (a - rem) /% b, rem: rem)
}

pub fn div_rem(a: Int, b: Int) -> (quot: Int, rem: Int) Never! {
    rem :: a %% b
    (quot: (a - rem) /% b, rem: rem)
}

pub fn digits(n: Int) -> Int Never! {
    value := n
    count := 1
    loop value <= -10 || value >= 10 {
        value = value /% 10
        count = count + 1
    }
    count
}
pub fn leading_ones(n: Int) -> Int Never! {
    count := 0
    loop count < 64 {
        if ((n >> (63 - count)) & 1) == 0 -> return count
        count = count + 1
    }
    count
}
pub fn trailing_ones(n: Int) -> Int Never! {
    count := 0
    loop count < 64 {
        if ((n >> count) & 1) == 0 -> return count
        count = count + 1
    }
    count
}
pub fn cmp(a: Float, b: Float) -> Int Never! {
    if a < b -> return -1
    if a > b -> return 1
    if a == b || (is_nan(a) && is_nan(b)) -> return 0
    if is_nan(a) -> return 1
    return -1
}

pub fn abs_diff(a: Int, b: Int) -> Int Never! {
    if a >= b -> return a - b
    b - a
}

pub fn even(n: Int) -> Bool Never! { is_even(n) }
pub fn odd(n: Int) -> Bool Never! { is_odd(n) }
pub fn xor(a: Int, b: Int) -> Int Never! { a ~| b }
pub fn in_range(value: Int, low: Int, high: Int) -> Bool Never! {
    value >= low && value < high
}

pub fn sum_int(values: [Int]) -> Int Never! {
    acc := 0
    loop value in values -> acc = saturating_add(acc, value)
    acc
}

pub fn prod_int(values: [Int]) -> Int Never! {
    acc := 1
    loop value in values -> acc = saturating_mul(acc, value)
    acc
}

pub fn prod(values: [Int]) -> Int Never! { prod_int(values) }
pub fn fmod(a: Float, b: Float) -> Float Never! { core.math.fmod(a, b) }
pub fn remainder(a: Float, b: Float) -> Float Never! {
    if !is_finite(a) || !is_finite(b) || b == 0.0 -> return nan()
    quotient :: a / b
    lower :: floor(quotient)
    fraction :: quotient - lower
    nearest := lower
    if fraction > 0.5 || (fraction == 0.5 && fmod(lower, 2.0) != 0.0) {
        nearest = lower + 1.0
    }
    a - nearest * b
}
pub fn isclose(a: Float, b: Float, rel_tol: Float, abs_tol: Float) -> Bool Never! {
    if rel_tol < 0.0 || abs_tol < 0.0 -> return false
    if a == b -> return true
    if !is_finite(a) || !is_finite(b) -> return false
    fabs(a - b) <= max_float(rel_tol * max_float(fabs(a), fabs(b)), abs_tol)
}

pub fn dist(left: [Float], right: [Float]) -> Float Never! {
    if left.len() != right.len() -> return nan()
    total := Float{0.0}
    loop i in 0..<left.len() {
        delta :: left[i] - right[i]
        total = total + delta * delta
    }
    sqrt(total)
}

pub fn hypot3(a: Float, b: Float, c: Float) -> Float Never! { hypot(hypot(a, b), c) }

pub fn clamp_float(value: Float, low: Float, high: Float) -> Float Never! {
    if !(low <= high) -> panic("min > max, or either was NaN")
    if value < low -> return low
    if value > high -> return high
    value
}

pub fn min_float(a: Float, b: Float) -> Float Never! {
    if is_nan(a) -> return b
    if is_nan(b) -> return a
    if a < b -> return a
    b
}
pub fn max_float(a: Float, b: Float) -> Float Never! {
    if is_nan(a) -> return b
    if is_nan(b) -> return a
    if a > b -> return a
    b
}
pub fn midpoint(a: Float, b: Float) -> Float Never! { a + (b - a) * 0.5 }

pub fn fsum(values: [Float]) -> Float Never! {
    total := Float{0.0}
    compensation := Float{0.0}
    loop value in values {
        corrected :: value - compensation
        next_total :: total + corrected
        compensation = (next_total - total) - corrected
        total = next_total
    }
    total
}

pub fn sumprod(left: [Float], right: [Float]) -> Float Never! {
    total := Float{0.0}
    n := left.len()
    if right.len() < n -> n = right.len()
    loop i in 0..<n -> total = total + left[i] * right[i]
    total
}

pub fn random() -> Float Never! { core.math.random() }

pub fn fraction(numerator: Int, denominator: Int) -> Fraction? Never! {
    core.math.fraction(numerator, denominator)
}

pub fn decimal(text: String) -> Decimal Never! {
    core.math.decimal(text)
}

pub fn copy(n: Float) -> Float Never! { n }

#Test("math scalar composition preserves IEEE boundaries") {
    assert(is_nan(nan()))
    assert(is_inf(infinity()))
    assert(!is_finite(nan()))
    assert(is_normal(1.0))
    assert(is_subnormal(from_bits(1)))
    assert(sign_bit(-0.0))
    assert_eq(to_bits(fabs(-0.0)), 0)
    assert_eq(signum(-0.0), -1.0)
    assert_eq(cmp(nan(), 1.0), 1)
    assert_eq(cmp(1.0, nan()), -1)
    assert_eq(cmp(nan(), nan()), 0)
    assert_eq(radix(0.0), 2)
}

#Test("math rounding uses ties away from zero and saturating native conversion") {
    assert_eq(round(1.5), 2)
    assert_eq(round(-1.5), -2)
    assert_eq(round(0.49999999999999994), 0)
    assert_eq(round(nan()), 0)
    assert_eq(round(infinity()), 9223372036854775807)
    assert_eq(round(-infinity()), -9223372036854775808)
}

#Test("math adjacent values and exponent decomposition") {
    assert_eq(to_bits(next_up(0.0)), 1)
    assert_eq(to_bits(next_down(0.0)), -9223372036854775807)
    assert_eq(to_bits(next_after(1.0, 2.0)), to_bits(1.0) + 1)
    assert_eq(next_up(infinity()), infinity())
    assert_eq(ulp(0.0), from_bits(1))
    assert_eq(significand(6.0), 1.5)
    assert_eq(ilogb(8.0) ?? -1, 3)
    assert(ilogb(0.0) == None)
    assert_eq(ldexp(1.5, 2), 6.0)
    pair :: frexp(6.0)
    assert_eq(pair.exp, 2)
    assert_eq(pair.frac, 1.5)
}

#Test("math remainder and distance retain their validation") {
    assert_eq(remainder(7.0, 2.0), -1.0)
    assert_eq(remainder(5.0, 2.0), 1.0)
    assert(is_nan(remainder(1.0, 0.0)))
    assert(isclose(infinity(), infinity(), 0.0, 0.0))
    assert(!isclose(1.0, 1.0, -1.0, 0.0))
    assert_eq(dist([Float]{0.0, 0.0}, [Float]{3.0, 4.0}), 5.0)
    assert(is_nan(dist([Float]{1.0}, [Float]{})))
    assert_eq(digits(-9223372036854775808), 19)
    assert_eq(leading_ones(-1), 64)
    assert_eq(trailing_ones(-1), 64)
    assert_eq(xor(3, 5), 6)
}

#Test("math special functions retain their approximation") {
    assert_eq(erf(infinity()), 1.0)
    assert_eq(erf(-infinity()), -1.0)
    assert(is_nan(gamma(0.0)))
    assert(isclose(gamma(5.0), 24.0, 0.000000000001, 0.0))
    assert(isclose(erfc(1.0), 1.0 - erf(1.0), 0.0, 0.0))
}
