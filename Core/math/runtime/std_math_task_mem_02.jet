// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/MathTaskMem.rs:3275
pub fn jet_pool_get<T: Clone>(pool: &JetPool<T>, id: JetId<T>, file: String,
    line: U32, fn_name: String, src_line: String) -> T {
    jet_pool_get_ref(pool, id, file, line, fn_name, src_line).clone()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/MathTaskMem.rs:3287
pub fn jet_pool_get_ref<T>(pool: &JetPool<T>, id: JetId<T>, file: String,
    line: U32, fn_name: String, src_line: String) -> &T {
    match pool.checked_get(id) {
        Val(value) -> value
        None -> jet_runtime_stop_with_context("E3001", file, line, fn_name, src_line, jet_pool_stale_message())
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/MathTaskMem.rs:3312
pub fn jet_pool_get_mut<T>(pool: &JetPool<T>, id: JetId<T>, file: String,
    line: U32, fn_name: String, src_line: String) -> &T {
    match pool.checked_get_mut(id) {
        Val(value) -> value
        None -> jet_runtime_stop_with_context("E3001", file, line, fn_name, src_line, jet_pool_stale_message())
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/MathTaskMem.rs:3335
pub fn jet_pool_set<T>(pool: &JetPool<T>, id: JetId<T>, value: T, file: String,
    line: U32, fn_name: String, src_line: String) -> {
    if pool.checked_get_mut(id) is Val(slot) {
        *slot = ^value
        return
    }
    jet_runtime_stop_with_context("E3001", file, line, fn_name, src_line, jet_pool_stale_message())
}

