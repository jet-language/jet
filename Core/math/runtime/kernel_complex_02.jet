use jet_foundation.Traits.[TraitRegistry, TraitInfo, OperatorImpl, e0906, e0907, PRINTABLE, EQUATABLE, DEBUG, DISPLAY, COMPARABLE, ENCODE, DECODE, SERIALIZE, RENDERABLE, CLOSE]
use jet_foundation.AST.[Type, TypeParam, Item, VariantPayload, TagMarker, InternalTag, AccessConvention, Param, ParamZone, TraitMethodSig, Span, OperatorMarker, Func, Marker, StructDef, EnumDef, TraitDef, ViewSource]
use jet_foundation.[Generics, Syntax, Names]
use jet_foundation.Generics.[unify_types, substitute_type]
use jet_foundation.Diagnostics.Diagnostic
use jet_foundation.Symbols.FuncSig
use std.collections.HashSet

impl TraitRegistry {
    // Rust: crates/jet-foundation/src/Traits.rs:1796
    fn auto_derive_set(self, trait_name: String) -> HashSet<String>? Never! {
        match trait_name {
            PRINTABLE -> Val(self.auto_printable)
            EQUATABLE -> Val(self.auto_equatable)
            DEBUG -> Val(self.auto_debug)
            COMPARABLE -> Val(self.auto_comparable)
            ENCODE -> Val(self.auto_encode)
            DECODE -> Val(self.auto_decode)
            _ -> None
        }
    }

    // Rust: crates/jet-foundation/src/Traits.rs:1808
    fn auto_derive_set_mut(&self, trait_name: String) -> HashSet<String>? Never! {
        match trait_name {
            PRINTABLE -> Val(&self.auto_printable)
            EQUATABLE -> Val(&self.auto_equatable)
            DEBUG -> Val(&self.auto_debug)
            COMPARABLE -> Val(&self.auto_comparable)
            ENCODE -> Val(&self.auto_encode)
            DECODE -> Val(&self.auto_decode)
            _ -> None
        }
    }

    // Rust: crates/jet-foundation/src/Traits.rs:1822
    fn auto_derive_fields_ready(self, item: Item, trait_name: String, supports: fn(String, String) -> Bool?) -> Bool Never! {
        type_params :: match item {
            Item.Struct(s) -> s.type_params
            Item.Enum(e) -> e.type_params
            _ -> return false
        }
        ready :: |ty| self.auto_derive_type_ready(ty, trait_name, type_params, supports)
        match item {
            Item.Struct(s) -> s.fields.iter()
                .filter(|field| field.computed.is_none())
                // A redacted field's carrier needs no Debug implementation.
                .filter(|field| !(trait_name == DEBUG && field.redact))
                .all(|field| ready(field.ty))
            Item.Enum(e) -> e.variants.iter().all(|variant| match variant.payload {
                VariantPayload.Unit -> true
                VariantPayload.Single(ty, _) -> ready(ty)
                VariantPayload.Named(fields) -> fields.iter().all(|field| ready(field.ty))
            })
            _ -> false
        }
    }

    // Rust: crates/jet-foundation/src/Traits.rs:1857
    fn auto_derive_type_ready(self, ty: Type, trait_name: String, type_params: [TypeParam], foreign_supports: fn(String, String) -> Bool?) -> Bool Never! {
        codec :: trait_name == ENCODE || trait_name == DECODE
        match ty {
            Type.List(inner) | Type.Option(inner) | Type.FixedList{elem: inner, ..} -> {
                if trait_name == COMPARABLE -> Self.native_ordering_ready(ty)
                else -> self.auto_derive_type_ready(inner, trait_name, type_params, foreign_supports)
            }
            Type.Result{ok, err} -> {
                if codec -> false
                else if trait_name == COMPARABLE -> Self.native_ordering_ready(ty)
                else -> self.auto_derive_type_ready(ok, trait_name, type_params, foreign_supports)
                    && self.auto_derive_type_ready(err, trait_name, type_params, foreign_supports)
            }
            Type.Map{key, value, ..} -> {
                if trait_name == COMPARABLE -> false
                else -> (!codec || matches(key, Type.String))
                    && self.auto_derive_type_ready(key, trait_name, type_params, foreign_supports)
                    && self.auto_derive_type_ready(value, trait_name, type_params, foreign_supports)
            }
            Type.Tuple(fields) -> {
                if codec -> false
                else if trait_name == COMPARABLE -> Self.native_ordering_ready(ty)
                else -> fields.iter().all(|(_, field)| self.auto_derive_type_ready(field, trait_name, type_params, foreign_supports))
            }
            Type.Union(members) -> {
                if trait_name == COMPARABLE -> Self.native_ordering_ready(ty)
                else -> members.iter().all(|member| self.auto_derive_type_ready(member, trait_name, type_params, foreign_supports))
            }
            Type.Apply{name, args} -> {
                if trait_name == COMPARABLE -> false
                else -> (foreign_supports(name, trait_name) ?? self.implements_trait(name, trait_name))
                    && args.iter().all(|arg| self.auto_derive_type_ready(arg, trait_name, type_params, foreign_supports))
            }
            Type.Tagged{marker: TagMarker.Internal(InternalTag.CoreCryptoNominal), inner}
                if trait_name == DEBUG && matches(inner, Type.Named(name) if name == "Secret") -> true
            Type.Tagged{inner, ..} -> {
                if codec -> false
                else if trait_name == COMPARABLE -> Self.native_ordering_ready(ty)
                else -> self.auto_derive_type_ready(inner, trait_name, type_params, foreign_supports)
            }
            Type.InlineRange{base: inner, ..} -> self.auto_derive_type_ready(inner, trait_name, type_params, foreign_supports)
            Type.Named(name) if type_params.iter().any(|param| param.name == name) ->
                type_params.iter().find(|param| param.name == name)
                    .is_some_and(|param| param.bounds.iter().any(|bound| bound == trait_name))
            Type.Named(name) -> foreign_supports(name, trait_name) ?? self.implements_trait(name, trait_name)
            Type.Float | Type.Float32 -> trait_name != COMPARABLE
            Type.Int | Type.Bool | Type.String | Type.Char | Type.IntN{..} -> true
            Type.Quantity{base, ..} -> !codec && self.auto_derive_type_ready(base, trait_name, type_params, foreign_supports)
            Type.Measure(_) -> !codec
            Type.Shared(_) | Type.TraitObject(_) | Type.Fn{..} -> false
        }
    }

    // Rust: crates/jet-foundation/src/Traits.rs:1999
    pub fn is_trait_name(self, name: String) -> Bool Never! {
        self.traits.contains_key(name) || Generics.is_builtin_trait(name) || Generics.is_literal_capability(name)
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2005
    pub fn resolve_type_name(self, name: String, type_param_scope: [TypeParam]) -> Type Never! {
        if type_param_scope.iter().any(|p| p.name == name) -> Type.Named(name)
        else if self.is_trait_name(name) -> Type.TraitObject([name])
        else -> Type.Named(name)
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2015
    pub fn implements_trait(self, type_name: String, trait_name: String) -> Bool Never! {
        if [Syntax.TYPE_INT, Syntax.TYPE_FLOAT, Syntax.TYPE_BOOL, Syntax.TYPE_STRING, Syntax.TYPE_CHAR].contains(type_name)
            && Generics.is_builtin_trait(trait_name) && trait_name != CLOSE && trait_name != Generics.CHECKED_TEXT {
            if trait_name == Generics.NUMERIC -> return type_name == Syntax.TYPE_INT || type_name == Syntax.TYPE_FLOAT
            if [Syntax.TRAIT_ADD, Syntax.TRAIT_SUB, Syntax.TRAIT_MUL, Syntax.TRAIT_DIV].contains(trait_name)
                && type_name != Syntax.TYPE_INT && type_name != Syntax.TYPE_FLOAT -> return false
            return true
        }
        if (type_name == Syntax.TYPE_DECIMAL || type_name == Syntax.TYPE_FRACTION)
            && (trait_name == Generics.NUMERIC || Syntax.NUMERIC_SUPERTRAITS.contains(trait_name)) -> return true
        // GATE #4499: exact composite-key equality/hash.
        if self.trait_impls.contains((type_name, trait_name)) -> return true
        match trait_name {
            PRINTABLE if self.auto_printable.contains(type_name) -> true
            DEBUG if self.auto_debug.contains(type_name) -> true
            DISPLAY -> self.trait_impls.contains((type_name, DISPLAY))
            EQUATABLE if self.auto_equatable.contains(type_name) -> true
            COMPARABLE if self.auto_comparable.contains(type_name) -> true
            ENCODE if self.auto_encode.contains(type_name) -> true
            DECODE if self.auto_decode.contains(type_name) -> true
            COMPARABLE | SERIALIZE | ENCODE | DECODE -> self.derives.get(type_name).is_some_and(|d| d.contains(trait_name))
            _ if trait_name == Syntax.MARKER_CLI -> self.derives.get(type_name).is_some_and(|d| d.contains(trait_name))
            RENDERABLE -> self.auto_printable.contains(type_name) || self.trait_impls.contains((type_name, DISPLAY))
            _ -> false
        }
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2096
    pub fn type_implements_trait(self, ty: Type, trait_name: String) -> Bool Never! {
        match ty {
            Type.IntN{..} | Type.InlineRange{..} | Type.Float32 ->
                Generics.is_builtin_trait(trait_name) && trait_name != CLOSE && trait_name != Generics.CHECKED_TEXT
            Type.List(inner) | Type.Option(inner) | Type.FixedList{elem: inner, ..} if trait_name == EQUATABLE ->
                self.type_implements_trait(inner, trait_name)
            Type.Map{key, value, ..} if trait_name == EQUATABLE ->
                self.type_implements_trait(key, trait_name) && self.type_implements_trait(value, trait_name)
            Type.List(inner) | Type.Option(inner) | Type.FixedList{elem: inner, ..} if trait_name == COMPARABLE -> Self.native_ordering_ready(inner)
            Type.Result{ok, err} if trait_name == EQUATABLE -> self.type_implements_trait(ok, trait_name) && self.type_implements_trait(err, trait_name)
            Type.Result{ok, err} if trait_name == COMPARABLE -> Self.native_ordering_ready(ok) && Self.native_ordering_ready(err)
            Type.Tuple(fields) if trait_name == EQUATABLE -> fields.iter().all(|(_, field)| self.type_implements_trait(field, trait_name))
            Type.Tuple(fields) if trait_name == COMPARABLE -> fields.iter().all(|(_, field)| Self.native_ordering_ready(field))
            Type.Named(name) -> self.implements_trait(name, trait_name)
            Type.Apply{name, args} -> {
                if !self.implements_trait(name, trait_name) -> return false
                params :: self.struct_params.get(name) ?? return true
                params.len() == args.len() && params.iter().zip(args).enumerate().all(|(index, (param, arg))|
                    param.bounds.iter().all(|bound| self.type_implements_trait(arg, bound))
                    && (!(trait_name == EQUATABLE || trait_name == COMPARABLE)
                        || self.structural_params.get(name).is_some_and(|used| !used.contains(index) || self.type_implements_trait(arg, trait_name))
                        || (!self.structural_params.contains_key(name) && self.type_implements_trait(arg, trait_name))))
            }
            Type.TraitObject(bounds) -> bounds.iter().any(|bound| bound == trait_name)
            Type.Tagged{inner, ..} if trait_name == COMPARABLE -> Self.native_ordering_ready(inner)
            Type.Tagged{inner, ..} -> self.type_implements_trait(inner, trait_name)
            other -> self.implements_trait(other.name(), trait_name)
        }
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2169
    pub fn infer_fn_subst(self, sig: FuncSig, arg_types: [Type], type_params: [TypeParam], expected_ret: Type?) -> [String: Type] Err! {
        self.infer_subst(sig.params, sig.return_type, arg_types, type_params, expected_ret)!
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2185
    pub fn infer_fn_subst_without_bounds(self, sig: FuncSig, arg_types: [Type], type_params: [TypeParam], expected_ret: Type?) -> [String: Type] Err! {
        self.infer_subst_inner(sig.params, sig.return_type, arg_types, type_params, expected_ret, false)!
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2204
    pub fn infer_subst(self, params: [(AccessConvention, Type)], return_type: Type?, arg_types: [Type], type_params: [TypeParam], expected_ret: Type?) -> [String: Type] Err! {
        self.infer_subst_inner(params, return_type, arg_types, type_params, expected_ret, true)!
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2226
    pub fn infer_subst_without_bounds(self, params: [(AccessConvention, Type)], return_type: Type?, arg_types: [Type], type_params: [TypeParam], expected_ret: Type?) -> [String: Type] Err! {
        self.infer_subst_inner(params, return_type, arg_types, type_params, expected_ret, false)!
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2244
    fn infer_subst_inner(self, params: [(AccessConvention, Type)], return_type: Type?, arg_types: [Type], type_params: [TypeParam], expected_ret: Type?, check_bounds: Bool) -> [String: Type] Err! {
        if type_params.is_empty() -> return [String: Type]{}
        tp_set :: type_params.iter().map(|p| p.name).collect::<HashSet<String>>()
        subst := [String: Type]{}
        loop (i, (_, pty)) in params.iter().enumerate() {
            if arg_ty :: arg_types.get(i) {
                if !unify_types(pty, arg_ty, &subst, tp_set) -> return Err(type_params.first().map(|p| p.name) ?? "")
            }
        }
        if expected :: expected_ret {
            if ret :: return_type {
                inst_ret :: substitute_type(ret, subst)
                _ :: unify_types(inst_ret, expected, &subst, tp_set)
            }
        }
        loop p in type_params {
            if !subst.contains_key(p.name) -> return Err(p.name)
            if check_bounds {
                loop b in p.bounds {
                    if !self.type_implements_trait(subst.get(p.name).unwrap(), b) -> return Err(p.name)
                }
            }
        }
        subst
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2291
    pub fn instantiate_type(self, ty: Type, subst: [String: Type]) -> Type Never! {
        substitute_type(ty, subst)
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2298
    pub fn register_error_conv(&self, from_ty: String, to_ty: String, span: Span, diags: & [Diagnostic]) Never! {
        from_local :: self.local_types.contains(from_ty)
        to_local :: self.local_types.contains(to_ty)
        if to_ty != Syntax.TYPE_ERR && !from_local && !to_local {
            diags.push(Diagnostic.error("E2406",
                "can't declare `impl {from_ty} -> {to_ty}` — neither type is defined in this program",
                "typed-target error conversions obey the same orphan rule as trait impls (S28); only the default `Err` target may name a foreign source",
                "define one of these types locally, or convert the foreign source into `Err`", Val(span)))
            return
        }
        key :: (from_ty, to_ty)
        if prev :: self.error_conversions.get(key) {
            diags.push(Diagnostic.error("E2405",
                "duplicate error conversion: `impl {from_ty} -> {to_ty}` is already declared",
                "there can be at most one declared way to convert a `Source` error into a `Target`",
                "remove one of the two `impl … -> …` blocks", Val(span)))
            _ :: prev
            return
        }
        if from_ty == to_ty || self.error_conversion_path_exists(to_ty, from_ty) {
            diags.push(Diagnostic.from_row("E2418", [("Source", from_ty), ("Target", to_ty)], Val(span)))
            return
        }
        if self.error_conversion_path_exists(from_ty, to_ty) {
            diags.push(Diagnostic.from_row("E2419", [("Source", from_ty), ("Target", to_ty)], Val(span)))
            return
        }
        self.error_conversions.insert(key, span)
        if (source, target) :: self.ambiguous_error_conversion_pair() {
            self.error_conversions.remove(key)
            diags.push(Diagnostic.from_row("E2419", [("Source", source), ("Target", target)], Val(span)))
        }
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2370
    fn error_conversion_path_exists(self, from_ty: String, to_ty: String) -> Bool Never! {
        if from_ty == to_ty -> return true
        pending := [from_ty]
        seen := HashSet<String>{}
        loop {
            current :: pending.pop() ?? break
            if !seen.insert(current) -> continue
            loop (source, target) in self.error_conversions.keys() {
                if source == current {
                    if target == to_ty -> return true
                    pending.push(target)
                }
            }
        }
        false
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2392
    fn ambiguous_error_conversion_pair(self) -> (String, String)? Never! {
        nodes := HashSet<String>{}
        loop (source, target) in self.error_conversions.keys() {
            nodes.insert(source)
            nodes.insert(target)
        }
        ordered := nodes.iter().collect::<[String]>()
        ordered.sort()
        loop source in ordered {
            loop target in ordered {
                if source == target -> continue
                visiting := HashSet<String>{}
                if self.error_conversion_path_count(source, target, &visiting) > U8{1} -> return Val((source, target))
            }
        }
        None
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2412
    fn error_conversion_path_count(self, from_ty: String, to_ty: String, visiting: &HashSet<String>) -> U8 Never! {
        if from_ty == to_ty -> return U8{1}
        if !visiting.insert(from_ty) -> return U8{0}
        paths := U8{0}
        loop (source, target) in self.error_conversions.keys() {
            if source != from_ty -> continue
            paths = (paths + self.error_conversion_path_count(target, to_ty, &visiting)).min(U8{2})
            if paths == U8{2} -> break
        }
        visiting.remove(from_ty)
        paths
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2439
    pub fn has_error_conv(self, from_ty: String, to_ty: String) -> Bool Never! {
        self.error_conversions.contains_key((from_ty, to_ty))
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2449
    pub fn register_synthetic_rollback(&self) Never! {
        if self.traits.contains_key(Syntax.TRAIT_ROLLBACK) -> return
        dummy :: Span{start: 0, end: 0}
        snapshot_sig :: TraitMethodSig{
            name: "snapshot", name_span: dummy,
            params: [Param{name: Syntax.KW_SELF, name_span: dummy, ty: Type.Named(""), ty_span: dummy,
                convention: AccessConvention.Read, root: false, default: None, variadic: false,
                variadic_bound_list: None, declared_view_from_names: None, public_label: None, zone: ParamZone.Either}],
            return_type: Val(Type.Named("Snapshot")), span: dummy, default_body: None, is_pure: false,
            declared_effects: None, return_view_provenance: Default.default(), declared_return_view_provenance: None}
        restore_sig :: TraitMethodSig{
            name: "restore", name_span: dummy,
            params: [
                Param{name: Syntax.KW_SELF, name_span: dummy, ty: Type.Named(""), ty_span: dummy,
                    convention: AccessConvention.Write, root: false, default: None, variadic: false,
                    variadic_bound_list: None, declared_view_from_names: None, public_label: None, zone: ParamZone.Either},
                Param{name: "snap", name_span: dummy, ty: Type.Named("Snapshot"), ty_span: dummy,
                    convention: AccessConvention.Move, root: false, default: None, variadic: false,
                    variadic_bound_list: None, declared_view_from_names: None, public_label: None, zone: ParamZone.Either}],
            return_type: None, span: dummy, default_body: None, is_pure: false,
            declared_effects: None, return_view_provenance: Default.default(), declared_return_view_provenance: None}
        methods := [String: TraitMethodSig]{}
        methods.insert("snapshot", ^snapshot_sig)
        methods.insert("restore", ^restore_sig)
        self.local_traits.insert(Syntax.TRAIT_ROLLBACK)
        self.traits.insert(Syntax.TRAIT_ROLLBACK, TraitInfo{methods: ^methods, assoc_types: ["Snapshot"], span: dummy})
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2541
    const PRELUDE_JET_SHOW_PRINTABLE_TYPES: [String] = [
        "ComputeDevice", "SyncText", "SyncCounter", "SyncMap", "SyncList",
        "ServiceRestart", "ServiceDelivery", "ServiceRuntime", "ServiceStateStore"]

    // Rust: crates/jet-foundation/src/Traits.rs:2554
    pub fn register_synthetic_display_debug(&self) Never! {
        self.register_synthetic_trait_method(Syntax.TRAIT_DISPLAY, "display", Val(Type.String), AccessConvention.Read)
        self.register_synthetic_trait_method(Syntax.TRAIT_DEBUG, "debug", Val(Type.String), AccessConvention.Move)
        loop ty in [
            "ArgsSpec", "AriaRole", Syntax.TYPE_BITS, "BuildError", "BrowserError", Syntax.TYPE_BYTES,
            "Clock", "CountMinSketch", "DataError", "DataTracked", "DataWatch", "DataWatchStatus", "DataTree",
            "DBValue", "DBLease", "DBPoolReceipt", "Date", "DateTime", "Decimal", "FieldError", "DirEntry",
            "DNSSRV", "Duration", "EncodingError", "EmailError", "EnvError", "EventResult", "F32x4", "F64x2",
            "Field", "FileLock", "GameAssets", "GameBackend", "GameFrame", "GameImage", "GameInputMap",
            "GameInputSnapshot", "GameReplay", "GameScene", "GameSound", "HTTPError", "HTTPHeaderName",
            "HTTPHeaderValue", "HTTPMethod", "HTTPRequest", "HTTPResponse", "HTTPRouter", "HTTPStatus",
            "HTTPVersion", "HyperLogLog", "ID", "Instant", "IOError", "IPAddr", "JSON", "Key", "LocalDate",
            "LocalTime", "Cache", "Mat3", "Mat4", "Measurement", "MIME", "NetError", "ParsedArgs", "Path",
            "Period", "Point", "Pool", "ProcessChild", "ProcessReceipt", "ProcessResult", "ProcessSpec", "Quat",
            "Range", "RangeError", "Rect", "ReflectField", "ReflectValue", "Regex", "RegexFlags", "RegexMatch",
            "ReservoirSampler", "RNG", "Fake", "Size", "SocketAddr", "Solver", "Stat", "Stopwatch", "TestSuite",
            "TcpListener", "TcpStream", "TDigest", "TempDir", "TempFile", "TextError", "TLSStream", "TLSVersion",
            "UDPPacket", "UdpSocket", "UnixListener", "UnixStream", "URL", "UTF8Error", "Value", "Vec2",
            "Vec3", "Vec4", "WalkEntry", "WatchEvent", "WsError", "Zone", "ZonedDateTime"
        ].iter().chain(Self.PRELUDE_JET_SHOW_PRINTABLE_TYPES.iter()) -> self.auto_printable.insert(ty)
        loop ty in [
            Syntax.TYPE_BITS, Syntax.TYPE_BYTES, "Clock", "Decimal", "DataTracked", "DataWatch", "DataWatchStatus",
            "DataTree", "Date", "DateTime", "Duration", "GameImage", "GameSound", "ID", "IOError", "Instant",
            "LocalDate", "LocalTime", "Cache", "Mat3", "Mat4", "Period", "Quat", "Range", "Vec2", "Vec3",
            "Vec4", "Zone", "ZonedDateTime"
        ] -> self.auto_debug.insert(ty)
        loop ty in ["DateTime", "LocalDate", "LocalTime", "Duration", "Instant", "ZonedDateTime"] {
            self.auto_equatable.insert(ty)
            self.auto_comparable.insert(ty)
        }
        self.auto_comparable.insert("Decimal")
        self.auto_equatable.insert(Syntax.TYPE_RANGE)
        self.auto_equatable.insert("TLSVersion")
        self.trait_impls.insert((Syntax.TYPE_RANGE, DISPLAY))
        self.trait_impls.insert(("EncodingError", DISPLAY))
        self.trait_impls.insert(("DataError", DISPLAY))
        self.trait_impls.insert(("FieldError", DISPLAY))
        loop ty in ["EncodingErrorKind", "EncodingFormat", "EncodingCause", "EncodingError", "EncodingLimits",
            "DataError", "DataErrorKind", "DataLimits"] {
            self.auto_equatable.insert(ty)
            self.auto_debug.insert(ty)
        }
        loop ty in Syntax.SIMD_LANE_TYPE_NAMES {
            self.auto_printable.insert(ty)
            self.auto_debug.insert(ty)
        }
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2792
    pub fn register_synthetic_close(&self) Never! {
        self.register_synthetic_trait_method(Syntax.TRAIT_CLOSE, Syntax.RESOURCE_CLOSE, None, AccessConvention.Move)
        loop ty in ["FileReader", "FileWriter", "FileLock", "TempDir", "TempFile", "TCPStream", "TcpStream",
            "UnixStream", "TLSStream", "DBConnection", "DBScope", "DBPool", "DBLease", "Arena", "Bump", "Pool", "Fixed"] ->
            self.trait_impls.insert((ty, Syntax.TRAIT_CLOSE))
    }

    // Rust: crates/jet-foundation/src/Traits.rs:2824
    pub fn register_synthetic_operators(&self) Never! {
        loop (trait_name, method, ret) in [
            (Syntax.TRAIT_ADD, "add", Type.Named("")), (Syntax.TRAIT_SUB, "sub", Type.Named("")),
            (Syntax.TRAIT_MUL, "mul", Type.Named("")), (Syntax.TRAIT_DIV, "div", Type.Named("")),
            (Syntax.TRAIT_EQUATABLE, "equal", Type.Bool),
