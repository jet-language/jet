// Rust: crates/jet-foundation/src/Traits.rs:3589
pub fn auto_derive_requested(markers: [Marker], trait_name: String, package_default: Bool) -> Bool Never! {
    markers.iter().rev().find(|marker| marker.name == trait_name
        || ((trait_name == ENCODE || trait_name == DECODE) && marker.name == Syntax.MARKER_CODABLE))
        .map_or(package_default, |marker| !marker.negated)
}

// Rust: crates/jet-foundation/src/Traits.rs:3604
pub fn struct_auto_derive_ok(s: StructDef) -> Bool Never! {
    !s.is_single_use && s.reflection_fields().all(|field| field_auto_ok(field.ty, s.name))
}

// Rust: crates/jet-foundation/src/Traits.rs:3610
pub fn enum_auto_derive_ok(e: EnumDef) -> Bool Never! {
    !e.is_single_use && e.variants.iter().all(|v| match v.payload {
        VariantPayload.Unit -> true
        VariantPayload.Single(t, _) -> field_auto_ok(t, e.name)
        VariantPayload.Named(fs) -> fs.iter().all(|f| field_auto_ok(f.ty, e.name))
    })
}

// Rust: crates/jet-foundation/src/Traits.rs:3620
fn field_auto_ok(ty: Type, owner: String) -> Bool Never! {
    match ty {
        Type.Int | Type.Float | Type.Bool | Type.String | Type.Char | Type.IntN{..} | Type.Float32 -> true
        Type.List(inner) | Type.Option(inner) | Type.Tagged{inner, ..}
            | Type.FixedList{elem: inner, ..} | Type.InlineRange{base: inner, ..} -> field_auto_ok(inner, owner)
        Type.Map{key, value, ..} | Type.Result{ok: key, err: value} -> field_auto_ok(key, owner) && field_auto_ok(value, owner)
        Type.Tuple(fields) -> fields.iter().all(|(_, field)| field_auto_ok(field, owner))
        Type.Union(members) -> members.iter().all(|member| field_auto_ok(member, owner))
        Type.Named(_) -> true
        Type.Apply{name, ..} -> name != Syntax.TYPE_SHARED_GUARD
        Type.Quantity{base, ..} -> field_auto_ok(base, owner)
        Type.Measure(_) -> true
        Type.Shared(_) | Type.TraitObject(_) | Type.Fn{..} -> false
    }
}

// Rust: crates/jet-foundation/src/Traits.rs:3655
fn wire_param_indices(params: [TypeParam], wire_types: [Type]) -> [Int] Never! {
    names :: params.iter().map(|p| p.name).collect::<HashSet<String>>()
    mentioned := HashSet<String>{}
    loop ty in wire_types -> Generics.collect_type_param_mentions(ty, names, &mentioned)
    params.iter().enumerate().filter(|(_, p)| mentioned.contains(p.name)).map(|(i, _)| i).collect::<[Int]>()
}

// Rust: crates/jet-foundation/src/Traits.rs:3669
pub fn rust_type_name(ty: Type) -> String Never! {
    rust_type_name_assoc(ty, HashSet<String>{})
}

// Rust: crates/jet-foundation/src/Traits.rs:3676
pub fn rust_type_name_assoc(ty: Type, assoc: HashSet<String>) -> String Never! {
    match ty {
        Type.Int -> "i64"
        Type.Float -> "f64"
        Type.Bool -> "bool"
        Type.String -> "String"
        Type.Char -> "char"
        Type.IntN{signed, bits} -> {
            prefix :: if signed -> "i" else -> "u"
            "{prefix}{bits}"
        }
        Type.Float32 -> "f32"
        Type.List(inner) -> "Vec<{rust_type_name_assoc(inner, assoc)}>"
        Type.FixedList{elem, len, ..} -> "[{rust_type_name_assoc(elem, assoc)}; {len}]"
        Type.Result{ok, err} -> "JetOutcome<{rust_type_name_assoc(ok, assoc)}, {rust_type_name_assoc(err, assoc)}>"
        Type.Named(n) if n.is_empty() -> "Self"
        Type.Named(n) if n == Syntax.INTERNAL_UNIT_TYPE -> "()"
        Type.Named(n) if n == Syntax.TYPE_ERR -> "JetErr"
        Type.Named(n) if n == Syntax.TYPE_NEVER -> "std::convert::Infallible"
        Type.Named(n) if assoc.contains(n) -> "Self::{n}"
        Type.Named(n) -> Names.mangle_path(n)
        Type.Apply{name, args} if name == "View" && args.len() == 1 -> {
            if matches(args[0], Type.Named(inner) if inner == "str") -> "&str"
            else -> "&[{rust_type_name_assoc(args[0], assoc)}]"
        }
        Type.Apply{name, args} if name == "ViewMut" && args.len() == 1 -> "&mut [{rust_type_name_assoc(args[0], assoc)}]"
        Type.Apply{name, args} -> {
            rendered :: args.iter().map(|a| rust_type_name_assoc(a, assoc)).collect::<[String]>().join(", ")
            "{Names.mangle_path(name)}<{rendered}>"
        }
        Type.TraitObject(t) -> {
            rendered :: t.iter().map(|name| Names.mangle_path(name)).collect::<[String]>().join(" + ")
            "Box<dyn {rendered}>"
        }
        Type.Option(inner) -> "JetOutcome<{rust_type_name_assoc(inner, assoc)}, JetAbsent>"
        Type.Map{key, value, ..} -> "std::collections::BTreeMap<{rust_type_name_assoc(key, assoc)}, {rust_type_name_assoc(value, assoc)}>"
        Type.Fn{..} -> "Box<dyn Fn()>"
        _ -> "()"
    }
}

// Rust: crates/jet-foundation/src/Traits.rs:3741
fn generated_view_lifetime() -> String Never! {
    "'{Names.mangle_generated("view")}"
}

// Rust: crates/jet-foundation/src/Traits.rs:3745
fn add_view_lifetime(rust: String) -> String Never! {
    if rest :: rust.strip_prefix("&mut ") -> "&{generated_view_lifetime()} mut {rest}"
    else if rest :: rust.strip_prefix("&") -> "&{generated_view_lifetime()} {rest}"
    else -> rust
}

// Rust: crates/jet-foundation/src/Traits.rs:3755
pub fn emit_trait_def(t: TraitDef, out: &String, render_view_return: fn(Type, HashSet<String>) -> String) Never! {
    out.push_str("pub trait {Names.mangle(t.name)} {{\n")
    assoc :: t.assoc_types.iter().map(|(n, _)| n).collect::<HashSet<String>>()
    loop (name, _) in t.assoc_types -> out.push_str("    type {name};\n")
    loop m in t.methods {
        view_provenance :: m.return_view_provenance.get()
        has_view_return :: view_provenance.is_some_and(|map| !map.is_empty())
        borrows_receiver :: view_provenance.is_some_and(|map| map.values().any(|provenance|
            provenance.sources.iter().any(|source| matches(source.source, ViewSource.Receiver))))
        ret_type :: m.return_type.map(|_| m.effective_return_type())
        ret :: ret_type.map(|ty| if has_view_return -> render_view_return(ty, assoc) else -> rust_type_name_assoc(ty, assoc)) ?? "()"
        param_index := 0
        params :: m.params.iter().map(|p| {
            if p.name == Syntax.KW_SELF {
                match p.convention {
                    AccessConvention.Write if borrows_receiver -> "&{generated_view_lifetime()} mut self"
                    AccessConvention.Read if borrows_receiver -> "&{generated_view_lifetime()} self"
                    AccessConvention.Write -> "&mut self"
                    AccessConvention.Move -> "self"
                    AccessConvention.Read -> "&self"
                }
            } else {
                base :: rust_type_name_assoc(p.ty, assoc)
                rust_ty := match p.convention {
                    AccessConvention.Read if p.ty.is_scalar() -> base
                    AccessConvention.Read -> "&{base}"
                    AccessConvention.Write -> "&mut {base}"
                    AccessConvention.Move -> base
                }
                if view_provenance.is_some_and(|map| map.values().any(|provenance|
                    provenance.sources.iter().any(|source| matches(source.source, ViewSource.Parameter(index) if index == param_index)))) {
                    rust_ty = add_view_lifetime(^rust_ty)
                }
                param_index = param_index + 1
                "_{p.name}: {rust_ty}"
            }
        }).collect::<[String]>()
        lifetime :: if has_view_return -> "<{generated_view_lifetime()}>" else -> ""
        rendered :: params.join(", ")
        out.push_str("    fn {m.name}{lifetime}({rendered}) -> {ret};\n")
    }
    out.push_str("}\n\n")
}

// Rust: crates/jet-foundation/src/Traits.rs:3856
fn trait_assoc(items: [Item], type_name: String, trait_name: String, assoc: String) -> Type? Never! {
    loop item in items {
        match item {
            Item.Impl(i) if i.type_name == type_name && i.trait_name == Val(trait_name) ->
                return i.assoc_type_impls.iter().find(|(n, _, _)| n == assoc).map(|(_, _, t)| t.clone())
            Item.Struct(s) if s.name == type_name -> {
                loop block in s.trait_impls {
                    if block.trait_name == trait_name ->
                        return block.assoc_type_impls.iter().find(|(n, _, _)| n == assoc).map(|(_, _, t)| t.clone())
                }
            }
            Item.Enum(e) if e.name == type_name -> {
                loop block in e.trait_impls {
                    if block.trait_name == trait_name ->
                        return block.assoc_type_impls.iter().find(|(n, _, _)| n == assoc).map(|(_, _, t)| t.clone())
                }
            }
            _ -> {}
        }
    }
    None
}

