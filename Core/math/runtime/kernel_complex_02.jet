    // Rust: crates/jet-foundation/src/Traits.rs:3370
    fn check_serde_impl_methods(self, type_name: String, trait_name: String, methods: [Func], span: Span, diags: & [Diagnostic]) Never! {
        verb :: if trait_name == ENCODE -> "encode" else -> "decode"
        is_data :: |ty| matches(ty, Type.Named(n) if Syntax.is_data_type_name(n))
        expected :: if trait_name == ENCODE -> "`fn encode(self) -> DataTree`"
            else -> "`fn decode(tree: DataTree) -> {type_name} [FieldError]!`"
        saw_verb := false
        loop m in methods {
            if m.name != verb {
                diags.push(e0907(trait_name, m.name, "only `{verb}`", m.name_span))
                continue
            }
            saw_verb = true
            has_self :: m.params.first().is_some_and(|p| p.name == Syntax.KW_SELF)
            non_self :: m.params.iter().filter(|p| p.name != Syntax.KW_SELF).collect::<[Param]>()
            ok :: if trait_name == ENCODE {
                has_self && non_self.is_empty() && m.return_type.is_some_and(is_data)
            } else {
                ret_ok :: matches(m.return_type, Val(Type.Result{ok, err})
                    if (matches(ok, Type.Named(n) if n == type_name || n == "Self")
                        || matches(ok, Type.Apply{name, ..} if name == type_name))
                    && matches(err, Type.List(inner) if matches(inner, Type.Named(n) if n == "FieldError")))
                !has_self && non_self.len() == 1 && is_data(non_self[0].ty) && ret_ok
            }
            if !ok -> diags.push(e0907(trait_name, m.name, expected, m.name_span))
        }
        if !saw_verb -> diags.push(e0906(trait_name, [verb], span))
    }

