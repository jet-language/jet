//RS /// Pack a scalar float with a negative tag; math handles remain non-negative.
//RS fn pack_float(x: f64) -> i64 {
//RS     (1i64 << 63) | (f64_bits(x) & !(1i64 << 63))
//RS }
//RS 
//RS /// Integer reductions and lane reads already have an unboxed I64 carrier in
//RS /// Cranelift, so they need no tag. The caller selects this unpacker from the
//RS /// sema-proven return type.
//RS fn pack_int(x: i64) -> i64 {
//RS     x
//RS }
//RS 
//RS fn pack_handle(h: i64) -> i64 {
//RS     h & !(1i64 << 63)
//RS }
//RS 
//RS fn is_float_pack(p: i64) -> bool {
//RS     p < 0
//RS }
//RS 
//RS fn unpack_float(p: i64) -> f64 {
//RS     bits_f64(p & !(1i64 << 63))
//RS }
//RS 
//RS fn unpack_int(p: i64) -> i64 {
//RS     p
//RS }
//RS 
//RS fn unpack_handle(p: i64) -> i64 {
//RS     p & !(1i64 << 63)
//RS }
