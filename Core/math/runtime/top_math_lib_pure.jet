pub fn jet_std_math_fsum(values: [F64]) -> F64 {
    total := 0.0
    compensation := 0.0
    for value in values {
        corrected :: value - compensation
        next :: total + corrected
        compensation = (next - total) - corrected
        total = next
    }
    total
}
