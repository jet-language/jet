// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:187
pub fn jet_stats_diff(values: [F64]) -> [F64] { values.windows(2).map(fn(pair) { pair[1] - pair[0] }).collect() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:194
pub fn jet_stats_moving_average(values: [F64], window: I64) -> [F64] {
    if window <= 0 -> return []
    window :: window as USize
    (0..<values.len()).map(fn(index) {
        start :: index.saturating_add(1).saturating_sub(window)
        slice :: &values[start..=index]
        slice.iter().sum<F64>() / slice.len() as F64
    }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:208
pub fn jet_stats_ewma(values: [F64], alpha: F64) -> [F64] {
    (first, rest) :: values.split_first() ?? return []
    alpha :: alpha.clamp(0.0, 1.0)
    total := *first
    out := [total]
    out.extend(rest.iter().map(fn(value) { total = alpha * *value + (1.0 - alpha) * total; total }))
    out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:222
pub fn jet_stats_rank(values: [F64]) -> [F64] {
    values.iter().map(fn(value) { 1.0 + values.iter().filter(fn(other) { *other < value }).count() as F64 }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:231
pub fn jet_stats_zscore(values: [F64]) -> [F64] {
    if values.is_empty() -> return []
    mean :: values.iter().sum<F64>() / values.len() as F64
    variance :: values.iter().map(fn(value) { delta :: *value - mean; delta * delta }).sum<F64>() / values.len() as F64
    deviation :: variance.sqrt()
    if deviation == 0.0 -> return []
    values.into_iter().map(fn(value) { (value - mean) / deviation }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:254
pub fn jet_stats_clip(values: [F64], low: F64, high: F64) -> [F64] { values.into_iter().map(fn(value) { value.clamp(low, high) }).collect() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:260
fn jet_stats_sorted(values: [F64]) -> [F64] { values.sort_by(F64.total_cmp); ^values }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:265
fn jet_stats_mean_value(values: View<F64>) -> F64? { if values.is_empty() -> None else -> Val(values.iter().sum<F64>() / values.len() as F64) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:269
fn jet_stats_quantile_value(values: View<F64>, probability: F64) -> F64? {
    sorted :: jet_stats_sorted(values.to_vec())
    (first, rest) :: sorted.split_first()?
    first :: *first
    last :: rest.last().copied().unwrap_or(first)
    if probability <= 0.0 -> return Val(first)
    if probability >= 1.0 -> return Val(last)
    position :: probability * (sorted.len() - 1) as F64
    lower :: position.floor() as USize
    upper :: position.ceil() as USize
    if lower == upper -> return Val(sorted[lower])
    fraction :: position - lower as F64
    Val(sorted[lower] + (sorted[upper] - sorted[lower]) * fraction)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:289
pub fn jet_stats_mean(values: [F64]) -> F64? { jet_stats_mean_value(&values) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:293
pub fn jet_stats_geometric_mean(values: [F64]) -> F64? {
    if values.is_empty() || values.iter().any(fn(value) { *value <= 0.0 }) -> return None
    Val((values.iter().map(fn(value) { value.ln() }).sum<F64>() / values.len() as F64).exp())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:300
pub fn jet_stats_harmonic_mean(values: [F64]) -> F64? {
    if values.is_empty() || values.iter().any(fn(value) { *value == 0.0 }) -> return None
    Val(values.len() as F64 / values.iter().map(fn(value) { 1.0 / value }).sum<F64>())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:307
pub fn jet_stats_median(values: [F64]) -> F64? { jet_stats_quantile_value(&values, 0.5) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:311
pub fn jet_stats_median_grouped(values: [F64], interval: F64) -> F64? {
    if values.is_empty() || interval <= 0.0 -> return None
    sorted :: jet_stats_sorted(^values)
    middle :: if sorted.len() % 2 == 1 -> sorted[sorted.len() / 2]
        else -> (sorted[sorted.len() / 2 - 1] + sorted[sorted.len() / 2]) / 2.0
    lower :: middle - interval / 2.0
    upper :: lower + interval
    below :: sorted.iter().filter(fn(value) { **value < lower }).count()
    frequency :: sorted.iter().filter(fn(value) { **value >= lower && **value < upper }).count()
    if frequency == 0 -> Val(middle)
    else -> Val(lower + interval * (sorted.len() / 2 - below) as F64 / frequency as F64)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:335
pub fn jet_stats_median_low(values: [F64]) -> F64? {
    sorted :: jet_stats_sorted(^values)
    sorted.get(sorted.len().saturating_sub(1) / 2).copied()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:342
pub fn jet_stats_median_high(values: [F64]) -> F64? {
    sorted :: jet_stats_sorted(^values)
    sorted.get(sorted.len() / 2).copied()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:347
pub fn jet_stats_quantile(values: [F64], probability: F64) -> F64? { jet_stats_quantile_value(&values, probability) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:351
pub fn jet_stats_percentile(values: [F64], percent: F64) -> F64? { jet_stats_quantile_value(&values, percent / 100.0) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:355
pub fn jet_stats_mode(values: [F64]) -> F64? {
    first :: values.first().copied()?
    best := first
    best_count := USize{0}
    for value in &values {
        count :: values.iter().filter(fn(other) { **other == *value }).count()
        if count > best_count { best = *value; best_count = count }
    }
    Val(best)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:369
pub fn jet_stats_multimode(values: [F64]) -> [F64] {
    first :: values.first().copied() ?? return []
    best_count :: values.iter().map(fn(value) { values.iter().filter(fn(other) { **other == *value }).count() }).max().unwrap_or(0)
    out := [F64]{}
    for value in std.iter.once(first).chain(values.iter().copied().skip(1)) {
        count :: values.iter().filter(fn(other) { **other == value }).count()
        if count == best_count && !out.contains(&value) -> out.push(value)
    }
    out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:388
pub fn jet_stats_pvariance(values: [F64]) -> F64? {
    mean :: jet_stats_mean_value(&values)?
    Val(values.iter().map(fn(value) { (value - mean).powi(2) }).sum<F64>() / values.len() as F64)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:393
pub fn jet_stats_variance(values: [F64]) -> F64? {
    if values.len() < 2 -> return None
    mean :: jet_stats_mean_value(&values)?
    Val(values.iter().map(fn(value) { (value - mean).powi(2) }).sum<F64>() / (values.len() - 1) as F64)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:401
pub fn jet_stats_pstdev(values: [F64]) -> F64? { jet_stats_pvariance(^values).map(F64.sqrt) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:405
pub fn jet_stats_stdev(values: [F64]) -> F64? { jet_stats_variance(^values).map(F64.sqrt) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:409
pub fn jet_stats_covariance(left: [F64], right: [F64]) -> F64? {
    if left.len() < 2 || left.len() != right.len() -> return None
    left_mean :: jet_stats_mean_value(&left)?
    right_mean :: jet_stats_mean_value(&right)?
    Val(left.iter().zip(right.iter()).map(fn((a, b)) { (a - left_mean) * (b - right_mean) }).sum<F64>() / (left.len() - 1) as F64)
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:424
pub fn jet_stats_covariance_population(left: [F64], right: [F64]) -> F64? {
    if left.is_empty() || left.len() != right.len() -> return None
    left_mean :: jet_stats_mean_value(&left)?
    right_mean :: jet_stats_mean_value(&right)?
    Val(left.iter().zip(right.iter()).map(fn((a, b)) { (a - left_mean) * (b - right_mean) }).sum<F64>() / left.len() as F64)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:439
pub fn jet_stats_correlation(left: [F64], right: [F64]) -> F64? {
    if left.len() < 2 || left.len() != right.len() -> return None
    left_mean :: jet_stats_mean_value(&left)?
    right_mean :: jet_stats_mean_value(&right)?
    covariance :: left.iter().zip(right.iter()).map(fn((a, b)) { (a - left_mean) * (b - right_mean) }).sum<F64>() / (left.len() - 1) as F64
    left_deviation :: jet_stats_stdev(^left)?
    right_deviation :: jet_stats_stdev(^right)?
    if left_deviation != 0.0 && right_deviation != 0.0 -> Val(covariance / (left_deviation * right_deviation)) else -> None
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:447
pub fn jet_stats_kde(values: [F64], bandwidth: F64) -> [F64] {
    if values.is_empty() || bandwidth <= 0.0 -> return []
    scale :: values.len() as F64 * bandwidth * (2.0 * PI).sqrt()
    values.iter().map(fn(point) {
        values.iter().map(fn(value) { z :: (point - value) / bandwidth; (-0.5 * z * z).exp() }).sum<F64>() / scale
    }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:467
pub fn jet_stats_kde_random(values: [F64], bandwidth: F64, count: I64) -> [F64] {
    density :: jet_stats_kde(^values, bandwidth)
    if density.is_empty() || count <= 0 -> return []
    (0..<count).map(fn(index) { density[index as USize % density.len()] }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:477
pub fn jet_stats_min(values: [F64]) -> F64? { values.into_iter().reduce(F64.min) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:481
pub fn jet_stats_max(values: [F64]) -> F64? { values.into_iter().reduce(F64.max) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:485
pub fn jet_stats_range(values: [F64]) -> F64? {
    high :: values.iter().copied().reduce(F64.max)?
    low :: values.into_iter().reduce(F64.min)?
    Val(high - low)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:489
pub fn jet_stats_sumprod(left: [F64], right: [F64]) -> F64? {
    if left.len() == right.len() -> Val(left.into_iter().zip(right).map(fn((a, b)) { a * b }).sum())
    else -> None
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:493
pub fn jet_stats_weighted_mean(values: [F64], weights: [F64]) -> F64? {
    if values.is_empty() || values.len() != weights.len() || weights.iter().any(fn(weight) { *weight < 0.0 }) -> return None
    total_weight :: weights.iter().sum<F64>()
    if total_weight == 0.0 -> return None
    Val(values.into_iter().zip(weights).map(fn((value, weight)) { value * weight }).sum<F64>() / total_weight)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:508
pub fn jet_stats_quantiles(values: [F64], count: I64) -> [F64] {
    if count <= 0 || values.is_empty() -> return []
    (1..<count).filter_map(fn(index) { jet_stats_quantile_value(&values, index as F64 / count as F64) }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:517
pub fn jet_stats_iqr(values: [F64]) -> F64? {
    Val(jet_stats_quantile_value(&values, 0.75)? - jet_stats_quantile_value(&values, 0.25)?)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:521
pub fn jet_stats_mad(values: [F64]) -> F64? {
    median :: jet_stats_quantile_value(&values, 0.5)?
    jet_stats_median(values.into_iter().map(fn(value) { (value - median).abs() }).collect())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:526
pub fn jet_stats_mean_abs_deviation(values: [F64]) -> F64? {
    mean :: jet_stats_mean_value(&values)?
    Val(values.iter().map(fn(value) { (value - mean).abs() }).sum<F64>() / values.len() as F64)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:531
pub fn jet_stats_skew(values: [F64]) -> F64? {
    if values.len() < 3 -> return None
    mean :: jet_stats_mean_value(&values)?
    deviation :: (values.iter().map(fn(value) { (value - mean).powi(2) }).sum<F64>() / (values.len() - 1) as F64).sqrt()
    if deviation == 0.0 -> return None
    Val(values.iter().map(fn(value) { ((value - mean) / deviation).powi(3) }).sum<F64>() / values.len() as F64)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:546
pub fn jet_stats_kurtosis(values: [F64]) -> F64? {
    if values.len() < 4 -> return None
    mean :: jet_stats_mean_value(&values)?
    deviation :: (values.iter().map(fn(value) { (value - mean).powi(2) }).sum<F64>() / (values.len() - 1) as F64).sqrt()
    if deviation == 0.0 -> return None
    Val(values.iter().map(fn(value) { ((value - mean) / deviation).powi(4) }).sum<F64>() / values.len() as F64 - 3.0)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:562
pub fn jet_stats_spearman(left: [F64], right: [F64]) -> F64? { jet_stats_correlation(jet_stats_rank(^left), jet_stats_rank(^right)) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:566
pub fn jet_stats_residuals(left: [F64], right: [F64]) -> [F64] {
    if left.len() < 2 || left.len() != right.len() -> return []
    mean_x :: jet_stats_mean_value(&left) ?? return []
    mean_y :: jet_stats_mean_value(&right) ?? return []
    numerator :: left.iter().zip(right.iter()).map(fn((x, y)) { (x - mean_x) * (y - mean_y) }).sum<F64>()
    denominator :: left.iter().map(fn(x) { (x - mean_x).powi(2) }).sum<F64>()
    if denominator == 0.0 -> return []
    slope :: numerator / denominator
    intercept :: mean_y - slope * mean_x
    left.iter().zip(right.iter()).map(fn((x, y)) { y - (slope * x + intercept) }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:595
pub fn jet_stats_histogram(values: [F64], bins: I64) -> [I64] {
    if bins <= 0 || values.is_empty() -> return []
    low :: values.iter().copied().reduce(F64.min) ?? return []
    high :: values.iter().copied().reduce(F64.max) ?? return []
    out := [I64].filled(bins as USize, 0)
    if high == low { out[0] = values.len() as I64; return out }
    span :: high - low
    for value in values {
        index := ((value - low) / span * bins as F64) as I64
        index = index.clamp(0, bins - 1)
        out[index as USize] += 1
    }
    out
}
