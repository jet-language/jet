pub fn jet_coll_merge_sorted(left: &[I64], right: &[I64]) -> [I64] {
    out := [I64].with_capacity(left.len() + right.len())
    left_index := USize{0}
    right_index := USize{0}
    loop left_index < left.len() && right_index < right.len() {
        if left[left_index] <= right[right_index] {
            out.push(left[left_index])
            left_index += 1
        } else {
            out.push(right[right_index])
            right_index += 1
        }
