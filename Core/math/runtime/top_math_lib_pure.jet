pub fn jet_stats_winsorize(values: [F64], probability: F64) -> [F64] {
    low :: jet_stats_quantile_value(&values, probability) ?? return ^values
    high :: jet_stats_quantile_value(&values, 1.0 - probability) ?? return ^values
    values.into_iter().map(fn(value) { value.clamp(low, high) }).collect()
}

