pub fn jet_coll_nsmallest(n: I64, values: &[I64]) -> [I64] {
    if n <= 0 -> return []
    values := values.to_vec()
    values.sort_unstable()
    values.truncate(n as USize)
    values
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:1414
pub fn jet_coll_nlargest(n: I64, values: &[I64]) -> [I64] {
    if n <= 0 -> return []
    values := values.to_vec()
    values.sort_unstable_by(fn(left, right) { right.cmp(left) })
    values.truncate(n as USize)
    values
}
