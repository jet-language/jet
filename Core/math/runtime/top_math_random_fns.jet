// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:105
// GATE #4565: kernel primitive — calling-thread ambient PRNG storage.
JET_RNG :: ThreadLocal<Cell<U64>>.new(fn() { Cell.new(U64{0x4d595df4d0f33173}) })
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:106
fn jet_rng_next() -> U64 {
    if Val(value) :: jet_scheduler_world_rng_next() -> return value
    // GATE #4565: kernel primitive
    #Unsafe("mutate only the calling thread's fallback RNG when no isolated test world is active") {
        JET_RNG.with(fn(cell) {
            x := cell.get()
            x ^= x << 7
            x ^= x >> 9
            x = x.wrapping_mul(U64{0x9e3779b97f4a7c15})
            cell.set(x)
            x
        })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:122
fn jet_std_random_seed(n: I64) -> {
    if jet_scheduler_world_rng_seed(n) -> return
    // GATE #4565: kernel primitive
    #Unsafe("seed only the calling thread's ambient stream outside a test world") { JET_RNG.with(fn(cell) { cell.set(n as U64) }) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:128
fn jet_std_random_getrandbits(k: I64) -> I64 {
    bits :: k.clamp(0, 63) as U32
    if bits == 0 -> 0 else -> (jet_rng_next() >> (64 - bits)) as I64
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:136
fn jet_std_random_randrange(start: I64, stop: I64) -> I64 {
    if stop <= start -> return start
    jet_std_random_int(start, stop - 1)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:142
fn jet_std_random_int(low: I64, high: I64) -> I64 {
    if high <= low -> return low
    low + (jet_rng_next() % ((high - low + 1) as U64)) as I64
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:148
fn jet_std_random_float() -> F64 { (jet_rng_next() as F64) / (U64.MAX as F64) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:151
fn jet_std_random_float_open() -> F64 { x :: jet_std_random_float(); if x <= 0.0 -> F64.MIN_POSITIVE else -> x }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:155
fn jet_std_random_float_range(low: F64, high: F64) -> F64 {
    if !(high > low) -> return low
    low + (high - low) * jet_std_random_float()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:161
fn jet_std_random_bool(p: F64) -> Bool {
    if p <= 0.0 || p.is_nan() -> false else if p >= 1.0 -> true else -> jet_std_random_float() < p
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:170
fn jet_std_random_normal(mean: F64, stddev: F64) -> F64 {
    u1 :: jet_std_random_float_open()
    u2 :: jet_std_random_float()
    z0 :: (-2.0 * u1.ln()).sqrt() * (TAU * u2).cos()
    mean + z0 * stddev.max(0.0)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:176
fn jet_std_random_exponential(lambda: F64) -> F64 {
    if lambda <= 0.0 || lambda.is_nan() -> return 0.0
    -jet_std_random_float_open().ln() / lambda
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:182
fn jet_std_random_choices<T: Clone>(xs: &[T], n: I64) -> [T] {
    out := [T]{}
    if xs.is_empty() -> return out
    for _ in 0..<n.max(0) {
        if Val(value) :: jet_std_random_pick(xs) -> out.push(^value)
    }
    out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:194
fn jet_std_random_triangular(low: F64, high: F64, mode: F64) -> F64 {
    if high <= low -> return low
    peak :: mode.clamp(low, high)
    u :: jet_std_random_float()
    cut :: (peak - low) / (high - low)
    if u <= cut -> low + (u * (high - low) * (peak - low)).sqrt()
    else -> high - ((1.0 - u) * (high - low) * (high - peak)).sqrt()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:207
fn jet_std_random_gamma(alpha: F64, beta: F64) -> F64 {
    if alpha <= 0.0 || beta <= 0.0 -> return 0.0
    if alpha < 1.0 -> return jet_std_random_gamma(alpha + 1.0, beta) * (jet_std_random_float_open().ln() / alpha).exp()
    d :: alpha - 1.0 / 3.0
    c :: 1.0 / (9.0 * d).sqrt()
    loop {
        x :: jet_std_random_normal(0.0, 1.0)
        v0 :: 1.0 + c * x
        if v0 <= 0.0 -> continue
        v :: v0 * v0 * v0
        u :: jet_std_random_float_open()
        if u < 1.0 - 0.0331 * x.powi(4) || u.ln() < 0.5 * x * x + d * (1.0 - v + v.ln()) -> return beta * d * v
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:232
fn jet_std_random_beta(alpha: F64, beta: F64) -> F64 {
    if alpha <= 0.0 || beta <= 0.0 -> return 0.0
    a :: jet_std_random_gamma(alpha, 1.0)
    b :: jet_std_random_gamma(beta, 1.0)
    if a + b <= 0.0 -> 0.0 else -> a / (a + b)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:240
fn jet_std_random_lognormal(mean: F64, sigma: F64) -> F64 { jet_std_random_normal(mean, sigma).exp() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:243
fn jet_std_random_pareto(alpha: F64) -> F64 { if alpha <= 0.0 -> 0.0 else -> (-jet_std_random_float_open().ln() / alpha).exp() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:250
fn jet_std_random_weibull(alpha: F64, beta: F64) -> F64 { if alpha <= 0.0 || beta <= 0.0 -> 0.0 else -> alpha * (-jet_std_random_float_open().ln()).powf(1.0 / beta) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:257
fn jet_std_random_vonmises(mu: F64, kappa: F64) -> F64 { if kappa <= 0.0 -> TAU * jet_std_random_float() else -> mu + jet_std_random_normal(0.0, 1.0 / kappa.sqrt()) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:264
fn jet_std_random_binomial(n: I64, p: F64) -> I64 {
    if n <= 0 || p <= 0.0 -> return 0
    if p >= 1.0 -> return n
    (0..<n).filter(fn(_) { jet_std_random_float() < p }).count() as I64
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:275
fn jet_std_random_pick<T: Clone>(xs: &[T]) -> T? {
    if xs.is_empty() -> None else -> Val(xs[jet_std_random_int(0, xs.len() as I64 - 1) as USize].clone())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:282
fn jet_std_random_weighted_pick<T: Clone>(xs: &[T], weights: &[F64]) -> T? {
    if xs.is_empty() || xs.len() != weights.len() -> return None
    total := 0.0
    for w in weights { if w.is_finite() && w > 0.0 -> total += w }
    if total <= 0.0 -> return None
    needle := jet_std_random_float_range(0.0, total)
    for (item, weight) in xs.iter().zip(weights.iter()) {
        w :: if weight.is_finite() && *weight > 0.0 -> *weight else -> 0.0
        if needle < w -> return Val(item.clone())
        needle -= w
    }
    xs.last().cloned()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:305
fn jet_std_random_sample<T: Clone>(xs: &[T], k: I64) -> [T] {
    want :: (k.max(0) as USize).min(xs.len())
    pool := xs.clone()
    for i in 0..<want { j :: jet_std_random_int(i as I64, pool.len() as I64 - 1) as USize; pool.swap(i, j) }
    pool.truncate(want)
    pool
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:315
fn jet_std_random_shuffle<T>(xs: &[T]) -> {
    len :: xs.len()
    for i in (1..<len).rev() { j :: jet_std_random_int(0, i as I64) as USize; xs.swap(i, j) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:324
// Seedable simulation bytes are NOT cryptographically secure.
fn jet_std_random_bytes(n: I64) -> [U8] {
    n :: n.max(0) as USize
    out := [U8].with_capacity(n)
    for _ in 0..<n { out.push(jet_rng_next() as U8) }
    out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:332
fn jet_std_random_split(seed: I64) -> Rng { Rng{state: (seed as U64) ^ jet_rng_next().rotate_left(17)} }
