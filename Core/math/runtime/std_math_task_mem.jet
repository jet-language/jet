// Lane-place access uses the same checked index as a value read.
pub trait JetNativeLane {
    type Scalar
    const NAME: String
    fn lanes(self: &Self) -> &[Self.Scalar]
    fn lanes_mut(self: &Self) -> &[Self.Scalar]
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/MathTaskMem.rs:15
pub fn jet_native_lane_ref<L: JetNativeLane>(value: &L, index: I64, file: String, line: U32) -> &L.Scalar {
    lanes :: value.lanes()
    checked :: jet_simd_lane_index(index, L.NAME, lanes.len()).unwrap_or_else((message) -> jet_panic(file, line, message))
    &lanes[checked]
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/MathTaskMem.rs:22
pub fn jet_native_lane_mut<L: JetNativeLane>(value: &L, index: I64, file: String, line: U32) -> &L.Scalar {
    lanes := value.lanes_mut()
    checked :: jet_simd_lane_index(index, L.NAME, lanes.len()).unwrap_or_else((message) -> jet_panic(file, line, message))
    &lanes[checked]
}
