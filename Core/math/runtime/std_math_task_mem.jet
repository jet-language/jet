fn jet_shared_scalar_from_bits<T>(bits: U64, kind: JetSharedScalarKind) -> T {
    if kind == {
        .I8 -> jet_shared_scalar_write_as<T,I8>(bits as I8)
        .U8 -> jet_shared_scalar_write_as<T,U8>(bits as U8)
        .I16 -> jet_shared_scalar_write_as<T,I16>(bits as I16)
        .U16 -> jet_shared_scalar_write_as<T,U16>(bits as U16)
        .I32 -> jet_shared_scalar_write_as<T,I32>(bits as I32)
        .U32 -> jet_shared_scalar_write_as<T,U32>(bits as U32)
        .I64 -> jet_shared_scalar_write_as<T,I64>(bits as I64)
        .U64 -> jet_shared_scalar_write_as<T,U64>(bits)
        .F32 -> jet_shared_scalar_write_as<T,F32>(F32.from_bits(bits as U32))
        .F64 -> jet_shared_scalar_write_as<T,F64>(F64.from_bits(bits))
