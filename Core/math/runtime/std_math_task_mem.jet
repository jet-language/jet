        .U16 -> jet_shared_scalar_read_as<T,U16>(value) as U64
        .I32 -> jet_shared_scalar_read_as<T,I32>(value) as I64 as U64
        .U32 -> jet_shared_scalar_read_as<T,U32>(value) as U64
        .I64 -> jet_shared_scalar_read_as<T,I64>(value) as U64
        .U64 -> jet_shared_scalar_read_as<T,U64>(value)
        .F32 -> jet_shared_scalar_read_as<T,F32>(value).to_bits() as U64
