//RS // ── D-SIMD2 / D-SIMD3 / D-LINALG1: math value-type free functions ────────────
//RS // Constructors (`_new`), statics (`splat`/`from_array`), instance methods, lane
//RS // reads, and reductions. Codegen names these `jet_math_<Type>_<fn>` and always
//RS // passes the receiver as `&recv` (value types — every op returns a fresh value).
//RS // Fixed arrays plus aggressive inlining give portable AOT LLVM a vectorizable
//RS // shape. Host-native F64x4 uses the private AVX carrier from the shared
//RS // Prelude; reductions still marshal through its scalar left-to-right fold so
//RS // every tier keeps the same result.
//RS 
//RS macro_rules! jet_simd_lane_fns {
//RS     (
//RS         $T:ident,
//RS         $new:ident, $splat:ident, $from_array:ident, $to_array:ident,
//RS         $lane:ident, $sum:ident, $product:ident, $min:ident, $max:ident,
//RS         $reduce_add:ident, $reduce_mul:ident, $reduce_min:ident,
//RS         $reduce_max:ident, $reduce_avg:ident,
//RS         $scalar:ty, $n:literal, $( $arg:ident ),+
//RS     ) => {
//RS         #[inline(always)]
//RS         fn $new($( $arg: $scalar ),+) -> jet_std::$T {
//RS             jet_std::$T([$( $arg ),+])
//RS         }
//RS         #[inline(always)]
//RS         fn $splat(x: $scalar) -> jet_std::$T {
//RS             jet_std::$T(crate::jet_simd_splat_array(x))
//RS         }
//RS         #[inline(always)]
//RS         fn $from_array(a: [$scalar; $n]) -> jet_std::$T {
//RS             jet_std::$T(a)
//RS         }
//RS         #[inline(always)]
//RS         fn $to_array(v: &jet_std::$T) -> [$scalar; $n] {
//RS             v.0
//RS         }
//RS         #[inline(always)]
//RS         fn $lane(v: &jet_std::$T, i: i64, file: &str, line: u32) -> $scalar {
//RS             let index = match crate::jet_simd_lane_index(i, stringify!($T), $n) {
//RS                 Ok(index) => index,
//RS                 Err(message) => jet_panic(file, line, &message),
//RS             };
//RS             v.0[index]
//RS         }
//RS         #[inline(always)]
//RS         fn $sum(v: &jet_std::$T) -> $scalar {
//RS             crate::jet_simd_sum_array(&v.0)
//RS         }
//RS         #[inline(always)]
//RS         fn $product(v: &jet_std::$T) -> $scalar {
//RS             crate::jet_simd_product_array(&v.0)
//RS         }
//RS         #[inline(always)]
//RS         fn $min(v: &jet_std::$T) -> $scalar {
//RS             crate::jet_simd_min_array(&v.0)
//RS         }
//RS         #[inline(always)]
//RS         fn $max(v: &jet_std::$T) -> $scalar {
//RS             crate::jet_simd_max_array(&v.0)
//RS         }
//RS         #[inline(always)]
//RS         fn $reduce_add(v: &jet_std::$T) -> $scalar { $sum(v) }
//RS         #[inline(always)]
//RS         fn $reduce_mul(v: &jet_std::$T) -> $scalar { $product(v) }
//RS         #[inline(always)]
//RS         fn $reduce_min(v: &jet_std::$T) -> $scalar { $min(v) }
//RS         #[inline(always)]
//RS         fn $reduce_max(v: &jet_std::$T) -> $scalar { $max(v) }
//RS         #[inline(always)]
//RS         fn $reduce_avg(v: &jet_std::$T) -> $scalar {
//RS             crate::jet_simd_avg_array(&v.0)
//RS         }
//RS     };
//RS }
