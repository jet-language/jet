package {
    name: "core.tasks"
    version: "0.0.1"
    edition: "2026"
    description: "Timers, cooperative yield, and the current trace id."
    license: "MIT"
    outputs: {
        tasks: .Library{ entry: tasks }
    }
}
use core as core
use core.time as time

// Timer creation and scheduler identity are host cells. Channels and task
// groups use the language primitives; sleeping uses core.time.sleep.
pub fn after(delay: time.Duration, value: Int{0}) -[Time]> Receiver<Int> Never! {
    core.tasks.after(delay, value)
}

pub fn interval(period: time.Duration) -[Time]> Receiver<Int> Never! {
    core.tasks.__interval_ms(interval_milliseconds(period))
}

fn interval_milliseconds(period: time.Duration) -> Int Never! {
    milliseconds :: period.ns /% 1000000
    if milliseconds < 1 -> return 1
    milliseconds
}

// These functions back compiler-private channel rows, not new public API.
module scheduler {
    use core as core

    fn channel<T>() -> (sender: Sender<T>, receiver: Receiver<T>) Never! {
        pair :: core.tasks.__channel_new<T>()
        (sender: pair.sender, receiver: pair.receiver)
    }

    #Test("scheduler channel preserves its named sender and receiver") {
        pair :: channel<Int>()
        pair.sender.send(41)
        assert_eq(pair.receiver.receive() ?? panic("channel closed"), 41)
        pair.sender.close()
    }

    fn bounded<T>(capacity: Int) -> (sender: Sender<T>, receiver: Receiver<T>) Never! {
        limit :: if capacity < 1 -> 1 else -> capacity
        pair :: core.tasks.__channel_bounded<T>(limit)
        (sender: pair.sender, receiver: pair.receiver)
    }

    #Test("scheduler bounded channel preserves its named sender and receiver") {
        pair :: bounded<Int>(0)
        pair.sender.send(42)
        assert_eq(pair.receiver.receive() ?? panic("bounded channel closed"), 42)
        pair.sender.close()
    }
}

impl Condition {
    pub fn notify_one(self) Never! { core.tasks.__condition_notify_one(self) }
    pub fn notify_all(self) Never! { core.tasks.__condition_notify_all(self) }
}

pub fn yield_now() Never! -[Time.Wait]> { host_yield() }

pub fn current_task() -> String Never! { host_task_id() }

/// Receive from the host scheduler channel. A closed channel maps to the
/// existing integer sentinel because this convenience rail is non-fallible.
pub fn recv(rx: Receiver<Int>) -[Time.Wait]> Int Never! {
    value :: rx.receive() ?? return -1
    value
}

/// Blocking receive spellings used by queue/future adapters.
pub fn get(rx: Receiver<Int>) -[Time.Wait]> Int Never! { recv(rx) }

pub fn result(rx: Receiver<Int>) -[Time.Wait]> Int Never! { recv(rx) }

pub fn wait(rx: Receiver<Int>) -[Time.Wait]> Int Never! { recv(rx) }


fn host_sleep_ms(ms: Int) -[Time]> {
    _ :: recv(core.tasks.after(Duration.milliseconds(ms) ?? panic("sleep duration is outside Duration's range"), 0))
}


fn host_yield() -[Time.Wait]> { core.tasks.__yield_now() }

fn host_task_id() -> String {
    paused :: core.tasks.__task_paused() ?? false
    cancel :: core.tasks.__task_cancelled() ?? false
    task_trace(paused, cancel)
}

fn task_trace(paused: Bool, cancel: Bool) -> String Never! {
    "paused={paused},cancel={cancel}"
}

/// Receiver metadata is owned by the scheduler's typed handle.
pub fn is_timer(rx: Receiver<Int>) -> Bool Never! { rx.is_timer() }

pub fn is_interval(rx: Receiver<Int>) -> Bool Never! { rx.is_interval() }

pub fn is_cancelled(rx: Receiver<Int>) -> Bool Never! { rx.is_cancelled() }

pub fn is_ready(rx: Receiver<Int>) -> Bool Never! { rx.is_ready() }

pub fn delay_ms(rx: Receiver<Int>) -> Int Never! { rx.delay_ms() }

pub fn timeout(delay: time.Duration) Never! -[Time]> {
    _ :: recv(core.tasks.after(delay, 0))
}

pub fn sleep(ms: Int) Never! -[Time]> {
    delay := ms
    if delay < 0 -> delay = 0
    host_sleep_ms(delay)
}

pub fn try_recv(rx: Receiver<Int>) -> Int? Never! { rx.try_receive() }

/// Closing the receiver wakes blocked consumers and is the host cancellation
/// operation. The returned handle remains usable for identity/ownership.
pub fn cancel(rx: Receiver<Int>) -[Time]> Receiver<Int> Never! {
    rx.close()
    ~rx
}

pub fn is_closed(state: TaskState) -> Bool Never! { state.closed }
pub fn is_locked(state: TaskState) -> Bool Never! { state.locked }
pub fn size(state: TaskState) -> Int Never! { state.values.len() }
pub fn capacity(state: TaskState) -> Int Never! { state.capacity }
pub fn generation(state: TaskState) -> Int Never! { state.generation }

pub fn spawn_name(name: String) -> String Never! {
    ~name
}



#Test("current task has idle defaults outside a scheduled task") {
    assert_eq(current_task(), "paused=false,cancel=false")
}

#Test("task trace preserves the pause and cancellation fields") {
    assert_eq(task_trace(true, false), "paused=true,cancel=false")
    assert_eq(task_trace(false, true), "paused=false,cancel=true")
    assert_eq(task_trace(true, true), "paused=true,cancel=true")
}

#Test("interval periods truncate whole milliseconds and never spin at zero") {
    assert_eq(interval_milliseconds(time.Duration{ns: -1000000}), 1)
    assert_eq(interval_milliseconds(time.Duration{ns: 0}), 1)
    assert_eq(interval_milliseconds(time.Duration{ns: 999999}), 1)
    assert_eq(interval_milliseconds(time.Duration{ns: 1999999}), 1)
    assert_eq(interval_milliseconds(time.Duration{ns: 2000000}), 2)
}
