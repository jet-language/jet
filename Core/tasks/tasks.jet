package {
    name: "core.tasks"
    version: "0.0.1"
    edition: "2026"
    description: "Timers, cooperative yield, and the current trace id."
    license: "MIT"
    outputs: {
        tasks: .Library{ entry: tasks }
    }
}
use core as core
use core.time as time


// core.tasks — timers and scheduler identity on the Jet scheduler.
//
// `after` is a one-shot timer channel: after the supplied duration it yields
// `value`. `interval` yields 1, 2, 3, … on the period. `yield_now` returns
// control without sleeping. The live builtins are generic; this source
// records the `Int` specialisation.
//
// Channels, tasks, and shared state are the language primitives:
// `channel<T>(capacity)`, `rx.receive()` with its typed `Closed` failure,
// `task { … }` / `task.all` / `task.timeout(delay)`, and `Shared<T>`. This
// module adds no second channel, lock, wait, or timeout rail; sleeping is
// `core.time.sleep`.

pub fn after(delay: time.Duration, value: Int{0}) -[Time]> Receiver<Int> Never! {
    core.tasks.after(delay, value)
}

pub fn interval(period: time.Duration) -[Time]> Receiver<Int> Never! {
    core.tasks.interval(period)
}

pub fn yield_now() Never! -[Time.Wait]> { core.tasks.yield_now() }

pub fn current_task() -> String Never! { core.tasks.current_task() }
