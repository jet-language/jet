package {
    name: "core.tasks"
    version: "0.1.0"
    edition: "2026"
    description: "Tasks, timers, and the current trace id."
    license: "MIT"
    outputs: {
        tasks: .Library{ entry: tasks }
    }
}

// core.tasks — cooperative tasks on the Jet scheduler.
//
// `after` is a one-shot timer channel: after `ms` milliseconds it yields
// `value`. `interval` yields 1, 2, 3, … on the period. `yield_now` returns
// control without sleeping. The live builtins are generic; this source
// records the `Int` specialisation.
//
// Timer bookkeeping is Jet. The actual park/wake is a host scheduler cell.

pub struct Receiver {
    pub kind: String
    pub delay_ms: Int
    pub value: Int
    pub period_ns: Int
}

pub struct TaskState {
    pub values: [Int]
    pub capacity: Int
    pub closed: Bool
    pub locked: Bool
    pub generation: Int
}

pub struct TaskFailure {
    pub message: String
    pub raised: Bool
}

pub fn channel(capacity: Int) -> TaskState {
    cap := capacity
    if cap < 0 -> cap = 0
    TaskState{values: [Int]{}, capacity: cap, closed: false, locked: false, generation: 0}
}

pub fn put(state: TaskState, value: Int) -> TaskState {
    if state.closed -> return ~state
    if state.capacity > 0 && state.values.len() >= state.capacity -> return ~state
    values := ~state.values
    values.push(value)
    TaskState{values: values, capacity: state.capacity, closed: state.closed, locked: state.locked, generation: state.generation}
}

pub fn clear(state: TaskState) -> TaskState {
    TaskState{values: [Int]{}, capacity: state.capacity, closed: state.closed, locked: state.locked, generation: state.generation}
}

pub fn shutdown(state: TaskState) -> TaskState {
    TaskState{values: ~state.values, capacity: state.capacity, closed: true, locked: state.locked, generation: state.generation}
}

pub fn stop(state: TaskState) -> TaskState { shutdown(state) }

pub fn reset(state: TaskState) -> TaskState {
    TaskState{values: [Int]{}, capacity: state.capacity, closed: false, locked: false, generation: state.generation + 1}
}

pub fn lock() -> TaskState { channel(1) }

pub fn acquire(state: TaskState) -> TaskState {
    TaskState{values: ~state.values, capacity: state.capacity, closed: state.closed, locked: true, generation: state.generation}
}

pub fn release(state: TaskState) -> TaskState {
    TaskState{values: ~state.values, capacity: state.capacity, closed: state.closed, locked: false, generation: state.generation}
}

pub fn notify(state: TaskState) -> TaskState {
    TaskState{values: ~state.values, capacity: state.capacity, closed: state.closed, locked: state.locked, generation: state.generation + 1}
}

pub fn exception(message: String) -> TaskFailure { TaskFailure{message: message, raised: true} }

pub fn start(rx: Receiver) -> Receiver { ~rx }

pub fn run() -[Time]> {
    yield_now()
}

pub fn waitall(receivers: [Receiver]) -[Time]> [Int] {
    out := [Int]{}
    loop rx in receivers -> out.push(wait(rx))
    out
}

pub fn waitany(receivers: [Receiver]) -[Time]> Int {
    if receivers.len() == 0 -> return -1
    first := receivers[0]
    wait(first)
}

pub fn after(ms: Int, value: Int) -[Time]> Receiver {
    delay := ms
    if delay < 0 -> delay = 0
    host_sleep_ms(delay)
    Receiver{kind: "after", delay_ms: delay, value: value, period_ns: 0}
}

pub fn interval(period: Duration) -[Time]> Receiver {
    ns := period.in(.Nanoseconds) ?? 0
    if ns < 1 -> ns = 1
    Receiver{kind: "interval", delay_ms: 0, value: 1, period_ns: ns}
}

pub fn yield_now() -[Time]> host_yield()

pub fn current_task() -> String { host_task_id() }

/// Take the next interval tick. Sleeps `period_ns` and returns the tick number.
pub fn recv(rx: Receiver) -[Time]> Int {
    if rx.kind == "after" -> return rx.value
    host_sleep_ns(rx.period_ns)
    rx.value
}
/// Blocking receive spellings used by queue/future adapters.
pub fn get(rx: Receiver) -[Time]> Int { recv(rx) }

pub fn result(rx: Receiver) -[Time]> Int { recv(rx) }

pub fn wait(rx: Receiver) -[Time]> Int { recv(rx) }


fn host_sleep_ms(ms: Int) -[Time]> panic("host_sleep_ms")
fn host_sleep_ns(ns: Int) -[Time]> panic("host_sleep_ns")
fn host_yield() -[Time]> panic("host_yield")
fn host_task_id() -> String { panic("host_task_id") }


pub fn is_timer(rx: Receiver) -> Bool { rx.kind == "after" }
pub fn is_interval(rx: Receiver) -> Bool { rx.kind == "interval" }
pub fn delay_ms(rx: Receiver) -> Int { rx.delay_ms }


pub fn timeout(ms: Int) -[Time]> Receiver { after(ms, 0) }

pub fn sleep(ms: Int) -[Time]> {
    _ :: after(ms, 0)
}

pub fn try_recv(rx: Receiver) -> ?Int {
    if rx.kind == "after" -> return Val(rx.value)
    None
}

pub fn cancel(rx: Receiver) -> Receiver { Receiver{kind: "cancelled", delay_ms: rx.delay_ms, value: rx.value, period_ns: 0} }

pub fn is_cancelled(rx: Receiver) -> Bool { rx.kind == "cancelled" }

pub fn spawn_name(name: String) -> String {
    _ :: ~name
    host_task_id()
}


