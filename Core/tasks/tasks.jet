package {
    name: "core.tasks"
    version: "0.0.1"
    edition: "2026"
    description: "Timers, cooperative yield, and the current trace id."
    license: "MIT"
    outputs: {
        tasks: .Library{ entry: tasks }
    }
}
use core as core
use core.time as time

// Timer creation and scheduler identity are host cells. Channels and task
// groups use the language primitives; sleeping uses core.time.sleep.
pub fn after(delay: time.Duration, value: Int{0}) -[Time]> Receiver<Int> Never! {
    core.tasks.after(delay, value)
}

pub fn interval(period: time.Duration) -[Time]> Receiver<Int> Never! {
    core.tasks.interval(period)
}

pub fn yield_now() Never! -[Time.Wait]> { core.tasks.yield_now() }

pub fn current_task() -> String Never! { core.tasks.current_task() }
