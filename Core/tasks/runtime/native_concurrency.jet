//RS         // No resident runtime owns this call, so there is no status channel to
//RS         // put the fault on. Never return a silent success: say it on stderr.
//RS         let _ = crate::runtime_host::write_jit_stderr(
//RS             &format!("internal compiler error: {message}\n"),
//RS             true,
//RS         );
//RS     }
//RS }
//RS 
//RS /// Contain an unwind raised by shared-Prelude cleanup inside a host seam.
//RS ///
//RS /// The crate-wide no-unwind boundary is generated (`host_seam.rs`, #1997) and
//RS /// already stands between every seam and its Cranelift caller. This is the
//RS /// narrower, *inner* form for the handful of seam bodies that run a scheduler
//RS /// wait point directly: `jet_scheduler_wait_without_unwind` marks the frame as
//RS /// a live task catch frame, which is what makes a cancelled wait point choose
//RS /// to unwind here at all instead of returning a cooperative sentinel. The outer
//RS /// boundary would convert the same transfer, but only after abandoning the rest
//RS /// of the seam body's cleanup.
//RS ///
//RS /// The seams that need this are the ones running shared-Prelude cleanup with no
//RS /// `wait_status` around them. Dropping a `JetStreamSender` sends its completion
//RS /// and dropping a `JetStream` cancels and drains its producer, and both are
//RS /// scheduler wait points that unwind when the running task is cancelled
//RS /// (`Prelude/Scheduler.rs::jet_task_deliver_cancel`). A generator abandoned by
//RS /// `break` hits exactly that: the consumer cancels the producer, and then the
//RS /// producer's own Cranelift epilogue calls `jet_jit_sender_close`.
//RS ///
//RS /// Conversion goes through the same shared decoder every wait point in this
//RS /// file already uses, so a cancel or a deadline lands on the tier's pending
//RS /// interrupt channel and the scheduler's own hook keeps the converted unwind
//RS /// off stderr. Anything else is an engine defect and takes the ICE rail.
//RS pub(crate) fn contain_seam_unwind<F>(f: F)
//RS where
//RS     F: FnOnce(),
//RS {
//RS     deliver_wait_status(jet_scheduler_wait_without_unwind(f));
//RS }
//RS 
//RS /// Put one converted control transfer on the tier's existing status channel.
//RS ///
//RS /// I8: this is the single delivery point. The wait-point form
//RS /// ([`contain_seam_unwind`]) and the plain-seam form
//RS /// ([`deliver_caught_unwind`]) differ only in how they catch — never in what a
//RS /// cancel, a blown deadline, or a defect then means.
//RS fn deliver_wait_status(status: JetSchedulerWait<()>) {
//RS     match status {
//RS         JetSchedulerWait::Ready(()) => {}
//RS         JetSchedulerWait::Cancelled => set_pending_shield_exit(JetShieldExit::Cancelled),
//RS         JetSchedulerWait::Deadline(rendered) => record_deadline_interrupt(rendered),
//RS         JetSchedulerWait::Panicked(message) => {
//RS             if message.starts_with("Stop [E") {
//RS                 with_runtime_mut(|rt| {
//RS                     rt.set_rendered_runtime_stop(message, jet_foundation::ExitCodes::RUNTIME_PANIC)
//RS                 });
//RS             } else {
//RS                 host_fault(&message);
//RS             }
//RS         }
//RS     }
//RS }
