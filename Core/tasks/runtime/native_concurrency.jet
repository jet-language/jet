//RS /// Record an engine defect raised at a Cranelift host seam. Returns normally:
//RS /// generated code reads the runtime's trap flag at its next `emit_trap_check`
//RS /// and leaves through Cranelift control flow, never through a Rust unwind (I1).
//RS /// `set_host_fault` puts the defect on the branded ICE rail — exit 101 with no
//RS /// Rust payload in the program report (I2).
//RS fn host_fault(message: &str) {
//RS     let recorded = with_runtime_mut(|rt| {
//RS         rt.set_host_fault(message);
//RS         true
//RS     });
