//RS /// `jet_deopt_call`. Always returns normally: generated code reads
//RS /// the runtime's status at its next `emit_trap_check` and leaves through
//RS /// Cranelift control flow, never through a Rust unwind (I1).
//RS pub(crate) fn deliver_caught_unwind(payload: Box<dyn std::any::Any + Send>) {
//RS     // A shared-Prelude stop recorded its complete report in
