// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:176
pub struct JetEventTimeState<K, T> {
    window_ns: I64
    allowed_lateness_ns: I64
    late_disposition: JetLateEventDisposition
    keys: [K]
    active: [JetPendingWindow<T>]
    side_output: [JetStreamEvent<T>]
    max_event_time: CivilDateTime?
    watermark: CivilDateTime?
}
// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:187
impl<K: Clone + PartialEq, T> JetEventTimeState<K, T> {
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:191
    pub fn new(window_ns: I64, allowed_lateness_ns: I64, late_disposition: JetLateEventDisposition) -> Self Err! {
        if window_ns <= 0 -> return Err("stream window duration must be positive")
        if allowed_lateness_ns < 0 -> return Err("stream allowed lateness must be nonnegative")
        Ok(Self{window_ns, allowed_lateness_ns, late_disposition, keys: [], active: [], side_output: [], max_event_time: None, watermark: None})
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:218
    pub fn ingest(self: &Self, key: K, event: ^JetStreamEvent<T>) -> JetStreamEventDisposition {
        event_ns :: event.event_time.total_nanoseconds()
        was_late :: self.watermark.as_ref().is_some_and(watermark -> event_ns < watermark.total_nanoseconds())
        if self.max_event_time.as_ref().is_none_or(max -> event_ns > max.total_nanoseconds()) {
            self.max_event_time = Val(event.event_time.clone())
            &self.advance_watermark()
        }
        if was_late {
            return match self.late_disposition {
                .Drop -> JetStreamEventDisposition.Dropped
                .SideOutput -> { &self.side_output.push(^event); JetStreamEventDisposition.SideOutput }
            }
        }
        key_index :: &self.key_index(key)
        start_ns :: jet_stream_window_start_ns(event.event_time.total_nanoseconds(), self.window_ns)
        if Val(window) = &self.active.iter_mut().find(window -> window.key_index == key_index && window.start_ns == start_ns) {
            &window.events.push(^event)
        } else {
            position :: self.active.iter().position(window -> window.key_index > key_index || (window.key_index == key_index && window.start_ns > start_ns)).unwrap_or(self.active.len())
            &self.active.insert(position, JetPendingWindow{key_index, start_ns, events: [JetStreamEvent<T>]{^event}})
        }
        JetStreamEventDisposition.Accepted
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:280
    pub fn watermark(self) -> CivilDateTime? { self.watermark.clone() }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:284
    pub fn max_event_time(self) -> CivilDateTime? { self.max_event_time.clone() }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:288
    pub fn late_disposition(self) -> JetLateEventDisposition { self.late_disposition }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:292
    pub fn key_order(self) -> @[K] from self { @self.keys }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:296
    pub fn side_output(self) -> @[JetStreamEvent<T>] from self { @self.side_output }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:300
    pub fn take_side_output(self: &Self) -> [JetStreamEvent<T>] { mem.take(&self.side_output) }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:307
    pub fn take_ready_windows(self: &Self) -> [JetStreamWindow<K, T>] {
        if self.watermark.is_none() -> return []
        watermark_ns :: self.watermark.as_ref().unwrap().total_nanoseconds()
        window_ns :: self.window_ns
        &self.take_windows_where(window -> window_end_ns(window.start_ns, window_ns) <= watermark_ns)
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:321
    pub fn finish(self: &Self) -> [JetStreamWindow<K, T>] { &self.take_windows_where(_ -> true) }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:325
    fn key_index(self: &Self, key: K) -> USize {
        if Val(index) = self.keys.iter().position(known -> known == key) -> return index
        &self.keys.push(key.clone())
        self.keys.len() - 1
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:333
    fn advance_watermark(self: &Self) -> Unit {
        if self.max_event_time.is_none() -> return
        candidate :: jet_stream_datetime_from_ns(self.max_event_time.as_ref().unwrap().total_nanoseconds().saturating_sub(self.allowed_lateness_ns as I128))
        if self.watermark.as_ref().is_none_or(watermark -> candidate.total_nanoseconds() > watermark.total_nanoseconds()) -> self.watermark = Val(candidate)
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:349
    fn take_windows_where<F: FnMut(@JetPendingWindow<T>) -> Bool>(self: &Self, ready: &F) -> [JetStreamWindow<K, T>] {
        window_ns :: self.window_ns
        keys :: @self.keys
        completed := [JetStreamWindow<K, T>]{}
        retained := [JetPendingWindow<T>]{}.with_capacity(self.active.len())
        loop window in &self.active.drain(..) {
            if ready(@window) {
                end_ns :: window_end_ns(window.start_ns, window_ns)
                key :: keys[window.key_index].clone()
                &completed.push(JetStreamWindow{key, start: jet_stream_datetime_from_ns(window.start_ns), end: jet_stream_datetime_from_ns(end_ns), events: ^window.events})
            } else { &retained.push(^window) }
        }
        self.active = ^retained
        completed
    }
}
