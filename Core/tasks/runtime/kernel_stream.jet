// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:70
pub fn jet_stream_with_event_time<T: Send, F: FnMut(@T) -> R + Send, R: JetStreamEventTime + Send>(stream: ^JetStream<T>, event_time: ^F) -> JetStream<JetStreamEvent<T>> {
    // Producer captures are static owned Send values, not escaping source borrows.
    jet_stream_task(fn(sender) {
        loop {
            value :: &stream.pull_checked()
            if value.is_none() -> break
            item :: value.unwrap()
            timestamp :: (&event_time)(@item).into_event_time()
            if !sender.send_stream(JetStreamEvent.new(^item, ^timestamp)) -> break
        }
    })
}
// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:90
pub fn jet_stream_with_event_time_i64<T: Send, F: FnMut(@T) -> I64 + Send>(stream: ^JetStream<T>, event_time: ^F) -> JetStream<JetStreamEvent<T>> {
    jet_stream_with_event_time(^stream, ^event_time)
}
// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:103
pub fn jet_stream_with_event_time_ns<T: Send, F: FnMut(@T) -> I64 + Send>(stream: ^JetStream<T>, event_time: ^F) -> JetStream<JetStreamEvent<T>> {
    jet_stream_task(fn(sender) {
        loop {
            value :: &stream.pull_checked()
            if value.is_none() -> break
            item :: value.unwrap()
            timestamp :: CivilDateTime.from_unix_nanoseconds((&event_time)(@item))
            if !sender.send_stream(JetStreamEvent.new(^item, ^timestamp)) -> break
        }
    })
}
