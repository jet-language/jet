impl<K, T> JetEventTimeState<K, T> {
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:377
    pub fn window_ns(self) -> I64 { self.window_ns }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:381
    pub fn allowed_lateness_ns(self) -> I64 { self.allowed_lateness_ns }
