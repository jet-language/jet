// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:388
pub struct JetKeyedStream<K, T> { stream: JetStream<JetStreamEvent<T>>, keyer: Box<dyn FnMut(@T) -> K + Send> }
// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:393
impl<K: Send, T: Send> JetKeyedStream<K, T> {
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:398
    pub fn next_keyed(self: &Self) -> (K, JetStreamEvent<T>)? {
        event :: &self.stream.pull_checked()?
        key :: (&self.keyer)(@event.value)
        Val((key, ^event))
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:404
    pub fn window(self: ^Self, window_ns: I64, allowed_lateness_ns: I64, late_disposition: JetLateEventDisposition) -> JetWindowedStream<K, T> Err! where K: Clone + PartialEq {
        JetEventTimeState.new(window_ns, allowed_lateness_ns, late_disposition).map(state -> {
            JetWindowedStream{source: Val(^self), state: ^state, ready: VecDeque.new(), finished: false}
        })
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:424
impl<K: Send, T: Send> JetKeyedStream<K, T>.Iterator {
    type Item = (K, JetStreamEvent<T>)
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:431
    fn next(self: &Self) -> Self.Item? { &self.next_keyed() }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:437
pub struct JetWindowedStream<K, T> { source: JetKeyedStream<K, T>?, state: JetEventTimeState<K, T>, ready: VecDeque<JetStreamWindow<K, T>>, finished: Bool }
// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:444
impl<K: Clone + PartialEq + Send, T: Send> JetWindowedStream<K, T> {
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:449
    pub fn pull_window(self: &Self) -> JetStreamWindow<K, T>? {
        loop {
            if Val(window) = &self.ready.pop_front() -> return Val(^window)
            if self.finished -> return None
            next :: &self.source.as_mut().and_then(source -> &source.next_keyed())
            if next.is_none() {
                _ :: &self.source.take()
                &self.ready.extend(&self.state.finish())
                self.finished = true
                continue
            }
            (key, event) :: next.unwrap()
            _ :: &self.state.ingest(^key, ^event)
            &self.ready.extend(&self.state.take_ready_windows())
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:469
    pub fn watermark(self) -> CivilDateTime? { self.state.watermark() }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:473
    pub fn max_event_time(self) -> CivilDateTime? { self.state.max_event_time() }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:477
    pub fn late_disposition(self) -> JetLateEventDisposition { self.state.late_disposition() }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:481
    pub fn side_output(self) -> @[JetStreamEvent<T>] from self { self.state.side_output() }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:485
    pub fn take_side_output(self: &Self) -> [JetStreamEvent<T>] { &self.state.take_side_output() }
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:489
    pub fn key_order(self) -> @[K] from self { self.state.key_order() }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:494
impl<K: Clone + PartialEq + Send, T: Send> JetWindowedStream<K, T>.Iterator {
    type Item = JetStreamWindow<K, T>
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:501
    fn next(self: &Self) -> Self.Item? { &self.pull_window() }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:506
impl<T: Send> JetStream<JetStreamEvent<T>> {
    // Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:510
    pub fn key_by<K: Send, F: FnMut(@T) -> K + Send>(self: ^Self, keyer: ^F) -> JetKeyedStream<K, T> {
        JetKeyedStream{stream: ^self, keyer: Box.new(^keyer)}
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:522
pub fn jet_stream_key_by<T: Send, K: Send, F: FnMut(@T) -> K + Send>(stream: ^JetStream<JetStreamEvent<T>>, keyer: ^F) -> JetKeyedStream<K, T> {
    stream.key_by(^keyer)
}
// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:534
pub fn jet_keyed_stream_window<K: Clone + PartialEq + Send, T: Send, D: JetStreamDuration + Send>(stream: ^JetKeyedStream<K, T>, window: D, watermark: D, late_disposition: JetLateEventDisposition) -> JetStream<JetStreamWindow<K, T>> {
    window_ns :: window.stream_nanoseconds()
    watermark_ns :: watermark.stream_nanoseconds()
    jet_stream_task(fn(sender) {
        windows := match stream.window(window_ns, watermark_ns, late_disposition) {
            Ok(value) -> value
            Err(error) -> { sender.fail_with(error); return }
        }
        loop {
            window :: &windows.pull_window()
            if window.is_none() -> break
            if !sender.send_stream(window.unwrap()) -> break
        }
    })
}
// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:564
pub fn jet_keyed_stream_window_i64<K: Clone + PartialEq + Send, T: Send>(stream: ^JetKeyedStream<K, T>, window: I64, watermark: I64, late_disposition: JetLateEventDisposition) -> JetStream<JetStreamWindow<K, T>> {
    jet_keyed_stream_window(^stream, window, watermark, late_disposition)
}
// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:577
fn jet_stream_window_start_ns(event_ns: I128, window_ns: I64) -> I128 {
    event_ns.div_euclid(window_ns as I128) * window_ns as I128
}
// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:581
fn window_end_ns(start_ns: I128, window_ns: I64) -> I128 { start_ns.saturating_add(window_ns as I128) }
// Rust: crates/jet-codegen/src/Prelude/Core/Stream.rs:585
fn jet_stream_datetime_from_ns(total_ns: I128) -> CivilDateTime {
    secs :: total_ns.div_euclid(1_000_000_000).clamp(I64.MIN as I128, I64.MAX as I128) as I64
    nanos :: total_ns.rem_euclid(1_000_000_000) as U32
    CivilDateTime.from_timestamp_ns(secs, nanos)
}
