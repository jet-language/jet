    // Close can race initial probe and registration; recheck to avoid a lost close wake.
    if after_ms.is_empty() && not recvs.is_empty() && recvs.iter().all(fn(ch) { ch.is_closed_and_empty() }) { return .Closed }
    for ms in &after_ms { timer_wheel().schedule(Instant.now() + Duration.from_millis(*ms), master.clone()) }
    loop {
