// Rust: crates/jet-codegen/src/Prelude/Stream.rs:6
pub fn jet_stream<T: Send>() -> (JetStreamSender<T>, JetStream<T>) {
    // GATE #4565: kernel primitive
    #Unsafe("stream owns its scheduler channels and shares only synchronized completion state") {
        values :: JetSchedulerChannel.new()
        acknowledgements :: JetSchedulerChannel.new()
        completion :: JetSchedulerChannel<JetStreamCompletion>.new()
        failure_report :: Arc.new(Mutex.new(None))
        value_tx :: values.sender()
        acknowledgement_tx :: acknowledgements.sender()
        completion_tx :: completion.sender()
        (JetStreamSender{values: ^value_tx, acknowledgements: ^acknowledgements,
            completion: ^completion_tx, failed: AtomicBool.new(false), failure_report: failure_report.clone(),
            cancel_shielded: AtomicBool.new(false)},
         JetStream{values: Val(^values), acknowledgements: Val(^acknowledgement_tx),
            completion: Val(^completion), pending: false, failed: false,
            failure_report: ^failure_report, producer_task: None})
    }
}
// Rust: crates/jet-codegen/src/Prelude/Stream.rs:38
pub fn jet_stream_task<T: Send>(producer: fn(&JetStreamSender<T>) -> ()) -> JetStream<T> {
    (sender, stream) :: jet_stream()
    // GATE #4565: kernel primitive
    #Unsafe("consumer owns child control and join; cancellation unwinds only at scheduler wait boundaries") {
        control :: JetTaskControl.new()
        join :: jet_scheduler_spawn_with_control(fn() {
            result :: catch_unwind(AssertUnwindSafe(fn() {
                producer(&sender)
                // Cleanup ran under Shield; deliver deferred cancellation at its exit.
                sender.leave_cancel_shield()
            }))
            if result is Err(payload) {
                if !jet_scheduler_is_cancel_unwind(payload.as_ref()) { sender.fail() }
                resume_unwind(^payload)
            }
        }, control.clone())
        stream.attach_task(^control, ^join)
        ^stream
    }
}
