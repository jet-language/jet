    }
}
// Rust: crates/jet-codegen/src/Prelude/TaskGroup.rs:452
pub fn jet_task_select<Task, T, E>(tasks: [Task], mode: JetTaskSelectMode,
    wait_check: fn() -> Result<(), E>, completion_order: fn(&Task) -> U128?,
    try_complete: fn(&Task) -> Result<T, E>?, cancel: fn(&Task) -> (), drain: fn(Task) -> ()) -> Result<[T], E> {
    if tasks.is_empty() { unreachable("sema must reject an empty task group combinator") }
    pending_tasks := tasks.into_iter().map(fn(task) { Val(^task) }).collect::<[Task?]>()
    policy := JetTaskSelectPolicy.new(mode, pending_tasks.len())
    loop {
        if wait_check() is Err(error) {
            for task in pending_tasks.iter().flatten() { cancel(task) }
            for task in pending_tasks.into_iter().flatten() { drain(^task) }
            return Err(^error)
        }
        next :: pending_tasks.iter().enumerate().filter_map(fn(entry) {
            (index, task) :: entry
            task.as_ref().and_then(&completion_order).map(fn(order) { (order, index) })
        }).min()
        if next is Val((order, index)) {
            result :: pending_tasks[index].as_mut().and_then(&try_complete)
            if result is Val(result) {
                pending_tasks[index] = None
                if policy.settle(order, index, ^result) is JetTaskDecision.Finish(result) {
                    if result.is_err() || !(mode is JetTaskSelectMode.All) {
                        for task in pending_tasks.iter().flatten() { cancel(task) }
                    }
                    for task in pending_tasks.into_iter().flatten() { drain(^task) }
                    return ^result
                }
            }
        }
        // GATE #4565: kernel primitive
        #Unsafe("yield the native execution thread while no task completion can be consumed") { yield_now() }
    }
}
