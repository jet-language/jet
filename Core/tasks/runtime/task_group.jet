}
// Rust: crates/jet-codegen/src/Prelude/TaskGroup.rs:64
pub fn jet_task_flatten_results<T, E: Debug>(result: Result<[Result<T, E>], JetTaskFailure>) -> Result<[T], JetTaskFailure> {
    result.and_then(fn(values) {
