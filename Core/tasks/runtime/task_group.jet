// Rust: crates/jet-codegen/src/Prelude/TaskGroup.rs:40
pub fn jet_task_failure_from_code(code: String, reason: String) -> JetTaskFailure {
    match code {
        "E3004" | "TASK_CANCELLED" -> JetTaskFailure.Cancelled
        "E3003" -> JetTaskFailure.DeadlineBlown
        _ -> JetTaskFailure.Panicked(^reason)
    }
}
// Rust: crates/jet-codegen/src/Prelude/TaskGroup.rs:52
pub fn jet_task_flatten_result<T, E: Debug>(result: Result<Result<T, E>, JetTaskFailure>) -> Result<T, JetTaskFailure> {
