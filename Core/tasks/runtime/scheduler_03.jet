pub fn jet_scheduler_any<T: Send>(entries: [(JetSchedulerJoin<T>, Arc<JetTaskControl>)]) -> Result<T, JetTaskFailure> {
    jet_scheduler_select_tasks(^entries, .Any).map(fn(values) { values.pop().expect("any result missing") })
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4102
// D-SELECT-GENERIC1=A: scheduler owns readiness, waiting, arm choice and failure.
pub fn jet_scheduler_select_values<T: Send>(recvs: [Arc<ChannelInner<T>>], after_values: [(U64, T?)]) -> T {
    after_ms :: after_values.iter().map(fn((ms, _)) { *ms }).collect<[U64]>()
    match jet_scheduler_select(^recvs, ^after_ms) {
        .Recv(_, value) -> ^value
        .After(arm) -> after_values.into_iter().nth(arm).and_then(fn((_, value)) { ^value })
            .unwrap_or_else(fn() { jet_scheduler_fatal("select timer arm has no receive value") })
        .Closed -> jet_scheduler_fatal("select closed")
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4120
pub fn jet_scheduler_select_int_channels<T: Send>(channels: &[JetSchedulerChannel<T>], after_ms: [U64]) -> T {
    recvs :: channels.iter().map(fn(channel) { channel.select_inner() }).collect()
    jet_scheduler_select_values(^recvs, after_ms.into_iter().map(fn(ms) { (ms, None) }).collect())
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4134
pub fn jet_scheduler_select_channels_tagged<T: Send>(channels: &[JetSchedulerChannel<T>], after_ns: [I64]) -> (I64, T?) {
    recvs :: channels.iter().map(fn(channel) { channel.select_inner() }).collect()
    after_ms :: after_ns.into_iter().map(fn(ns) { jet_task_delay_ms_defaulted(jet_std_time_duration_to_millis(ns)) }).collect()
    match jet_scheduler_select(^recvs, ^after_ms) {
        .Recv(arm, value) -> (arm as I64, Val(^value))
        .After(arm) -> ((channels.len() + arm) as I64, None)
        .Closed -> jet_scheduler_fatal("select closed")
    }
}
