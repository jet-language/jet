// A timer created in a deterministic world participates in idle and scope close.
pub fn jet_scheduler_spawn_detached_timer(f: fn() -> ()) -> {
    world :: jet_scheduler_current_world()
    // GATE #4565: kernel primitive
    #Unsafe("detached native thread owns its static Send callback and deterministic world scope") {
        if world is Val(world) {
            world.task_spawned()
            task_world :: world.clone()
            _ :: thread.spawn(fn() {
                _world_scope :: jet_scheduler_world_task_enter(Val(^task_world))
                f()
            })
            return
        }
        _ :: thread.spawn(^f)
    }
}
