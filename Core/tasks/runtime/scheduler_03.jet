// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4318
fn jet_scheduler_spawn_with_control_kind<T: Send>(spawn_site: USize, label: &String, f: fn() -> T,
    control: Arc<JetTaskControl>, blocking: Bool) -> JetSchedulerJoin<T> {
    observe_id :: jet_observe_task_register_at_with_control(&control.observe_id, spawn_site, Val(&control))
    jet_observe_task_set_label(observe_id, label)
    identity :: jet_observe_task_identity(observe_id)
    world :: jet_scheduler_current_world()
    if world.as_ref() is Val(world) -> world.task_spawned()
    // GATE #4565: kernel primitive
    #Unsafe("bounded completion channel and once-published sequence belong to one static Send worker job") {
        (tx, rx) :: sync_channel<JetSchedulerResult<T>>(1)
        completion_order :: Arc.new(OnceLock<(high: U64, low: U64)>.new())
        task_completion_order :: completion_order.clone()
        completion_wait :: ParkSlot.new()
        task_completion_wait :: completion_wait.clone()
        scheduler().submit(Job{blocking: blocking, run: Box.new(fn() {
            _world_scope :: jet_scheduler_world_task_enter(^world)
            jet_observe_task_enter(observe_id)
            jet_scheduler_set_task_control(Val(control.clone()))
            jet_scheduler_task_panic_enter()
            control.wait_while_paused()
            // Cancel while never resumed aborts startup; after resume only wait points deliver.
            if control.paused.load(Ordering.Relaxed) && control.cancelled.load(Ordering.Relaxed) {
                jet_scheduler_task_panic_leave()
                jet_scheduler_set_task_control(None)
                jet_observe_task_finish(observe_id)
                task_completion_order.set(next_task_completion_order()).expect("task completion recorded twice")
                _ :: tx.send(.Cancelled)
                task_completion_wait.wake()
                return
            }
            completion_scope := jet_scheduler_task_completion_begin()
            out :: jet_scheduler_catch_task_unwind(^f)
            // D-CANCELMODEL1=C: drain owned groups before publication, even after cancellation unwind.
            completion_scope.drain()
            drop(^completion_scope)
            jet_scheduler_task_panic_leave()
            jet_scheduler_set_task_control(None)
            result :: match out {
                Ok(value) -> JetSchedulerResult.Value(^value)
                Err(error) -> {
                    if error.is<JetCancelUnwind>() { JetSchedulerResult.Cancelled }
                    else if error.is<JetDeadlineUnwind>() {
                        deadline :: error.downcast<JetDeadlineUnwind>().expect("deadline payload type checked")
                        JetSchedulerResult.Deadline(^deadline.rendered)
                    } else {
                        JetSchedulerResult.Panicked(jet_observe_task_failure_message(
                            observe_id, jet_scheduler_panic_message(&*error)))
                    }
                }
            }
            jet_observe_task_finish(observe_id)
            task_completion_order.set(next_task_completion_order()).expect("task completion recorded twice")
            _ :: tx.send(^result)
            task_completion_wait.wake()
        })})
        JetSchedulerJoin{rx: ^rx, pending: Mutex.new(None), completion_order: ^completion_order,
            completion_wait: ^completion_wait, identity: ^identity}
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4403
pub fn jet_scheduler_drain() -> {
    sched :: scheduler()
    // GATE #4565: kernel primitive
    #Unsafe("bounded normal drain observes retained worker queues and I/O lifetime accounting") {
        loop _ in 0..<5000 {
            // Parked tasks need an external event; exit observer reports the bounded identity.
            if jet_observe_has_parked_tasks() -> return
            if sched.live.load(Ordering.Relaxed) == 0 {
                guard :: sched.global.lock().unwrap()
                pending_local :: sched.workers.iter().any(fn(worker) { not worker.queue.lock().unwrap().is_empty() })
                io_drained :: METRIC_IO_ACTIVE.load(Ordering.Acquire) == 0
                    && METRIC_IO_ALLOCATED.load(Ordering.Acquire) == METRIC_IO_RETIRED.load(Ordering.Acquire)
                if guard.is_empty() && not pending_local && io_drained -> return
            }
            thread.sleep(Duration.from_millis(1))
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4433
// Exit drain waits for cancelled parked children before runtime teardown.
pub fn jet_scheduler_drain_after_exit() -> {
    sched :: scheduler()
    // GATE #4565: kernel primitive
    #Unsafe("exit drain cannot return until worker queues and all retained I/O operations retire") {
        loop {
            if sched.live.load(Ordering.Relaxed) == 0 {
                guard :: sched.global.lock().unwrap()
                pending_local :: sched.workers.iter().any(fn(worker) { not worker.queue.lock().unwrap().is_empty() })
                io_drained :: METRIC_IO_ACTIVE.load(Ordering.Acquire) == 0
                    && METRIC_IO_ALLOCATED.load(Ordering.Acquire) == METRIC_IO_RETIRED.load(Ordering.Acquire)
                if guard.is_empty() && not pending_local && io_drained -> return
            }
            thread.yield_now()
        }
    }
}

