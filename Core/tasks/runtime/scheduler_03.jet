// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:3965
fn jet_scheduler_all_wait(probes: [fn() -> JetSchedulerTaskPoll],
    cancels: [fn() -> ()], drains: [fn() -> ()]) -> Result<(), JetTaskFailure> {
    loop {
        if jet_task_deadline_if_expired(jet_deadline_remaining_ms(), "task selection").is_some() {
            loop cancel in &cancels -> cancel()
            loop drain in &drains -> drain()
            jet_deadline_exceeded("task selection")
        }
        if jet_scheduler_task_cancelled() && not jet_scheduler_shielded() {
            loop cancel in &cancels -> cancel()
            loop drain in &drains -> drain()
            jet_task_deliver_cancel()
            return Err(.Cancelled)
        }
        all_complete := true
        first_failure: ((high: U64, low: U64), JetTaskFailure)? = None
        loop probe in &probes {
            match probe() {
                .Pending -> all_complete = false
                .Complete(_) -> {}
                .Failed(error, order) -> {
                    if first_failure.as_ref().is_none_or(fn((first_order, _)) {
                        order.high < first_order.high || (order.high == first_order.high && order.low < first_order.low)
                    }) { first_failure = Val((order, ^error)) }
                }
            }
        }
        if first_failure is Val((_, error)) {
            loop cancel in &cancels -> cancel()
            loop drain in &drains -> drain()
            return Err(^error)
        }
        if all_complete -> return Ok(())
        jet_scheduler_yield_now()
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4024
fn jet_scheduler_select_tasks<T: Send>(entries: [(JetSchedulerJoin<T>, Arc<JetTaskControl>)],
    mode: JetTaskSelectMode) -> Result<[T], JetTaskFailure> {
    result :: jet_task_select(^entries, mode,
        fn() -> Result<(), JetSchedulerSelectError<T>> {
            deadline :: jet_task_deadline_if_expired(jet_deadline_remaining_ms(), "task selection")
            jet_task_wait_policy(deadline, jet_scheduler_task_cancelled(), jet_scheduler_shielded())
                .map_err(fn(interrupt) {
                    match interrupt {
                        .Deadline(_) -> .ParentDeadline
                        .Cancelled -> .ParentCancelled
                    }
                })
        },
        fn((join, _)) { join.completion_order() },
        fn((join, _)) {
            join.try_recv().map(fn(result) {
                match result {
                    .Value(value) -> Ok(^value)
                    failure -> Err(JetSchedulerSelectError.Child(^failure))
                }
            })
        },
        fn((_, control)) { control.cancel() },
        fn((join, _)) { join.drain() })
    jet_scheduler_drain()
    match result {
        Ok(values) -> Ok(^values)
        Err(.ParentDeadline) -> jet_deadline_exceeded("task selection")
        Err(.ParentCancelled) -> {
            // Cleanup reached from drop glue defers through the common delivery door.
            jet_task_deliver_cancel()
            Err(.Cancelled)
        }
        Err(.Child(.Deadline(_))) -> Err(.DeadlineBlown)
        Err(.Child(.Cancelled)) -> Err(.Cancelled)
        Err(.Child(.Panicked(reason))) -> Err(.Panicked(^reason))
        Err(.Child(.Value(_))) -> panic("unreachable child success on failure rail")
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4077
// D-CONCCOMB1: source-order values, fail fast and cancel siblings.
pub fn jet_scheduler_all<T: Send>(entries: [(JetSchedulerJoin<T>, Arc<JetTaskControl>)]) -> Result<[T], JetTaskFailure> {
    jet_scheduler_select_tasks(^entries, .All)
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4084
// D-RACEWIN1: first success wins and cancels losers.
pub fn jet_scheduler_race<T: Send>(entries: [(JetSchedulerJoin<T>, Arc<JetTaskControl>)]) -> Result<T, JetTaskFailure> {
    jet_scheduler_select_tasks(^entries, .Race).map(fn(values) { values.pop().expect("race result missing") })
}
