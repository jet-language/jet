                workers: (0..<count).map(fn(_) { WorkerSlot{queue: Mutex.new(VecDeque<Job>.new())} }).collect<[WorkerSlot]>(),
                global: Mutex.new(VecDeque<Job>.new()), notify: Condvar.new(),
                live: AtomicUsize.new(0), shutdown: AtomicBool.new(false),
                blocking_wait: Mutex.new(BlockingWaitState{waits: 0, threads: 0, peak: 0, reserve: false})})
            loop id in 0..<count {
