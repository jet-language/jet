// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4185
pub fn jet_scheduler_try_select_channels_tagged<T: Send>(channels: &[JetSchedulerChannel<T>], after_ns: [I64]) -> (I64, T?) {
    recvs :: channels.iter().map(fn(channel) { channel.select_inner() }).collect()
    after_ms :: after_ns.into_iter().map(fn(ns) { jet_task_delay_ms_defaulted(jet_std_time_duration_to_millis(ns)) }).collect()
    match jet_scheduler_try_select(^recvs, ^after_ms) {
        Val(.Recv(arm, value)) -> (arm as I64, Val(^value))
        Val(.After(arm)) -> ((channels.len() + arm) as I64, None)
        Val(.Closed) | None -> (-1, None)
    }
}
