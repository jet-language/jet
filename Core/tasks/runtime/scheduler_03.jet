// Consuming non-owning views retains queue state without delaying receiver close.
pub fn jet_scheduler_select_channel_views_tagged<T: Send>(views: [JetSchedulerChannelSelectView<T>], after_ns: [I64]) -> (I64, T?) {
    receiver_arms :: views.len()
    recvs :: views.into_iter().map(fn(view) { ^view.inner }).collect()
    after_ms :: after_ns.into_iter().map(fn(ns) { jet_task_delay_ms_defaulted(jet_std_time_duration_to_millis(ns)) }).collect()
    match jet_scheduler_select(^recvs, ^after_ms) {
        .Recv(arm, value) -> (arm as I64, Val(^value))
        .After(arm) -> ((receiver_arms + arm) as I64, None)
        .Closed -> jet_scheduler_fatal("select closed")
    }
}
