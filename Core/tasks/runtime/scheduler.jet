//RS /// lifecycle helpers use this predicate to keep cancellation out of the
//RS /// ordinary producer-failure rail.
//RS pub fn jet_scheduler_is_cancel_unwind(payload: &(dyn std::any::Any + Send)) -> bool {
//RS     payload.is::<JetCancelUnwind>()
//RS }
//RS /// Identify the internal deadline unwind used by D-CANCELMODEL1=C. Shared
//RS /// lifecycle helpers use this predicate to preserve deadline identity at
//RS /// foreign boundaries instead of classifying it as an ordinary panic.
//RS pub fn jet_scheduler_is_deadline_unwind(payload: &(dyn std::any::Any + Send)) -> bool {
//RS     payload.is::<JetDeadlineUnwind>()
//RS }
