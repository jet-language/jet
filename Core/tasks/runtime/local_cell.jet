    pub fn map<U: ?Sized, F: FnOnce(@T) -> @U>(self: ^Self, project: F) -> JetCellReadGuard<U> {
        // GATE #4565: kernel primitive
        #Unsafe("project within shared root loan then transfer its retained token to the mapped static view") {
            ptr :: NonNull.from(project(self.ptr.as_ref()))
            JetCellReadGuard{loan: ^self.loan, ptr}
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:247
    pub fn split<A: ?Sized, B: ?Sized, F: FnOnce(@T) -> (@A, @B)>(self: ^Self, project: F) -> (JetCellReadGuard<A>, JetCellReadGuard<B>) {
