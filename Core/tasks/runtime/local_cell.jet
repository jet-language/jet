}
// Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:17
impl<T> JetCellInner<T>.JetCellLoanRoot {
    // Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:18
    fn release(self, write: Bool) -> Unit {
        // GATE #4565: kernel primitive
        #Unsafe("single-thread borrow counter is owned by the retained loan root") {
            state :: self.borrows.get()
            if write {
                debug_assert(state == -1)
                self.borrows.set(0)
            } else {
                debug_assert(state > 0)
                self.borrows.set(state - 1)
            }
        }
    }
}
