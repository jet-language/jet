    fn value(self) -> (@Self.Value)? from self
    // Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:151
    fn store(self: &Self, value: Self.Value) -> Unit
}
// Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:156
impl<T: Clone> JetOutcome<T, JetAbsent>.JetCellOptionLike {
    type Value = T
    // Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:159
    fn value(self) -> (@T)? from self { self.as_ref().ok() }
    // Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:163
    fn store(self: &Self, value: T) -> Unit { self = Ok(^value) }
}
// Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:168
impl<T: JetCellOptionLike> JetCell<T> {
    // Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:169
    pub fn begin_get_or_set(self) -> JetCellGetOrSet<T> {
        guard :: self.guard_edit()
        match guard.read(slot -> slot.value().cloned()) {
            Val(value) -> JetCellGetOrSet.Value(value)
            None -> JetCellGetOrSet.Empty(^guard)
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:177
    pub fn get_or_set<F: FnOnce() -> T.Value>(self, init: F) -> T.Value {
        self.try_get_or_set(fn() -> T.Value Never! { Ok(init()) }).expect("infallible Cell initializer")
    }
    // Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:185
    pub fn try_get_or_set<F: FnOnce() -> T.Value E!, E>(self, init: F) -> T.Value E! {
        match self.begin_get_or_set() {
            .Value(value) -> Ok(value)
            .Empty(guard) -> {
                value :: init()?
                guard.store_option_value(value.clone())
                Ok(value)
            }
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:200
pub enum JetCellGetOrSet<T: JetCellOptionLike> { Value(T.Value), Empty(JetCellEditGuard<T>) }
// Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:205
impl<T: JetCellOptionLike> JetCellEditGuard<T> {
    // Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:209
    pub fn store_option_value(self, value: T.Value) -> Unit { self.edit(slot -> slot.store(^value)) }
}
