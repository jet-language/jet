struct JetCellGuardAccess { state: @Cell<ISize>, write: Bool }
// Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:280
impl JetCellGuardAccess.Drop {
    // Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:281
    fn drop(self: &JetCellGuardAccess) -> Unit {
        // GATE #4565: kernel primitive
        #Unsafe("callback access guard restores its borrowed local counter even on panic unwinding") {
            if self.write {
                debug_assert(self.state.get() == -1)
                self.state.set(0)
            } else {
                readers :: self.state.get()
                debug_assert(readers > 0)
                self.state.set(readers - 1)
            }
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:293
impl<T: ?Sized> JetCellEditGuard<T> {
    // Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:294
