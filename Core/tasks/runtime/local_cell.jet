    pub fn guard_read(self) -> JetCellReadGuard<T> {
        // GATE #4565: kernel primitive
        #Unsafe("increment local read loan; retained token outlives every projected pointer and unwinds on panic") {
            state :: self.inner.borrows.get()
            if state < 0 -> panic("Cell borrow conflict: cannot read while an edit guard is active")
            self.inner.borrows.set(state.checked_add(1).expect("Cell borrow count overflow"))
            root: Rc<dyn JetCellLoanRoot> :: self.inner.clone()
            JetCellReadGuard{loan: Rc.new(JetCellLoan{root, write: false}), ptr: NonNull.from(@*self.inner.value.get())}
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:129
    pub fn guard_edit(self) -> JetCellEditGuard<T> {
        // GATE #4565: kernel primitive
        #Unsafe("acquire exclusive root loan and retain its token for every derived guard") {
            if self.inner.borrows.get() != 0 -> panic("Cell borrow conflict: cannot edit while a guard is active")
            self.inner.borrows.set(-1)
            root: Rc<dyn JetCellLoanRoot> :: self.inner.clone()
            JetCellEditGuard{loan: Rc.new(JetCellLoan{root, write: true}), ptr: NonNull.from(&*self.inner.value.get()), access: Cell.new(ISize{0})}
        }
    }
}
