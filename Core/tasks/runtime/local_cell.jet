// Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:73
impl<T> JetCell<T> {
    // Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:74
    pub fn new(value: T) -> Self {
        // GATE #4565: kernel primitive
        #Unsafe("retain an owned static cell value in a local non-Send Rc allocation") {
            Self{inner: Rc.new(JetCellInner{value: UnsafeCell.new(^value), borrows: Cell.new(ISize{0})})}
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:83
    pub fn get(self) -> T where T: Clone { self.read(value -> value.clone()) }
    // Rust: crates/jet-codegen/src/Prelude/LocalCell.rs:90
    pub fn set(self, value: T) -> Unit { self.edit(slot -> { slot = ^value }) }
