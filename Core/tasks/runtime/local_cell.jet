            state :: self.access.get()
            if state < 0 -> panic("Cell guard conflict: cannot read during an edit callback")
            self.access.set(state.checked_add(1).expect("Cell guard read count overflow"))
            access :: JetCellGuardAccess{state: @self.access, write: false}
