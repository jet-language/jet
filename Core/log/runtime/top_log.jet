    keep :: #Unsafe("check thread-local disable and advance sampling counter before publication") {
        if JET_LOG_DISABLED.with(d -> d.get()) -> return
        JET_LOG_SAMPLE_EVERY.with(every -> JET_LOG_SAMPLE_COUNT.with(count -> {
            next :: count.get() + 1
            count.set(next)
            every.get() <= 1 || (next - 1) % every.get() == 0
        }))
    }
    if !keep -> return
    timestamp_ns :: jet_log_telemetry_wall_now_ns()
    ts :: (timestamp_ns / 1_000_000) as I64
    // GATE #4565: kernel primitive
    index :: #Unsafe("advance relaxed process log sequence") { JET_LOG_TELEMETRY_NEXT_LOG_INDEX.fetch_add(1, Ordering.Relaxed) }
    span :: jet_log_current_span()
    if jet_log_publish_record(level, msg, timestamp_ns, fields, index, span.as_ref()) {
        if span is Val(span) {
            if jet_log_note_active_span(span.id, index) is Val(updated) -> jet_log_publish_link(updated, level, timestamp_ns, index)
        }
    }
    if jet_log_format_active() == 2 -> jet_log_emit_text(level, msg, ts, fields)
    else -> jet_log_emit_json(level, msg, ts, fields)
