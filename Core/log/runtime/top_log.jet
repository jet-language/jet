// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:730
fn jet_log_emit_text(level: String, msg: String, ts: I64, fields: [LogField]) -> {
    secs :: ts / 1000
    (y, mo, d, h, mi, s) :: unix_to_ymdhms(secs)
    level_tag :: match level {
        "debug" -> "DEBUG", "info" -> "INFO", "warn" -> "WARN", "error" -> "ERROR", "critical" -> "CRITICAL", "fatal" -> "FATAL", _ -> level,
    }
    // GATE #4565: kernel primitive
    trace :: #Unsafe("snapshot current thread trace text") { JET_LOG_TRACE_ID.with(t -> t.borrow().clone()) }
    field_text :: if fields.is_empty() -> String.new()
        else -> " {fields.iter().map(f -> "{f.key}={f.value}").collect<[String]>().join(" ")}"
    line :: if trace.is_empty() -> "[{level_tag}] {y:04}-{mo:02}-{d:02}T{h:02}:{mi:02}:{s:02}Z | {msg}{field_text}"
        else -> "[{level_tag}] {y:04}-{mo:02}-{d:02}T{h:02}:{mi:02}:{s:02}Z trace={trace} | {msg}{field_text}"
    jet_log_write(line)
}
