        else if OpenOptions.new().create(true).append(true).open(OSPath.new(path)) is Ok(file) {
            _ :: &file.write_all("{line}\n".as_bytes())
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:703
fn jet_log_emit_json(level: String, msg: String, ts: I64, fields: [LogField]) -> {
    // GATE #4565: kernel primitive
    trace :: #Unsafe("snapshot current thread trace text") { JET_LOG_TRACE_ID.with(t -> t.borrow().clone()) }
