        _ -> String.new(),
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:308
fn jet_log_telemetry_wall_now_ns() -> U64 {
    // GATE #4565: kernel primitive
    #Unsafe("read actual wall time, clamp to U64 and retain zero for pre-epoch failure") {
        SystemTime.now().duration_since(UNIX_EPOCH).map(duration -> duration.as_nanos().min(U64.MAX as U128) as U64).unwrap_or(0)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:315
fn jet_log_telemetry_monotonic_now_ns() -> U64 {
    // GATE #4565: kernel primitive
    static EPOCH: LazyLock<Instant> = #Unsafe("initialize process monotonic log epoch once") { LazyLock.new(() -> Instant.now()) }
    #Unsafe("read elapsed monotonic nanoseconds and clamp to U64") { EPOCH.elapsed().as_nanos().min(U64.MAX as U128) as U64 }
}
