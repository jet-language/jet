// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:197
pub fn jet_ring_log_enter(span: LogSpan) -> {
    // GATE #4565: kernel primitive
    #Unsafe("retain current span stack and bounded observation in executing thread") {
        JET_LOG_SPANS.with(s -> &s.borrow_mut().push(~span))
