fn jet_log_current_span() -> JetLogSpanObservation? {
    // GATE #4565: kernel primitive
    #Unsafe("snapshot top thread-owned span observation") { JET_LOG_SPAN_OBSERVATIONS.with(spans -> spans.borrow().last().cloned()) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:328
fn jet_log_metric_slot(name: String) -> (Bool, U64)? {
    // GATE #4565: kernel primitive
    #Unsafe("hold bounded metric registry mutex, preserving Rust poison recovery") {
        metrics := match JET_LOG_TELEMETRY_METRICS.lock() { Ok(metrics) -> metrics, Err(poisoned) -> poisoned.into_inner() }
        loop i in 0..<metrics.len() {
            if metrics[i].name == name {
                index :: metrics[i].next_index
                metrics[i].next_index = index.saturating_add(1).max(1)
                return Val((false, index))
            }
        }
        if metrics.len() >= JET_LOG_TELEMETRY_MAX_METRICS -> return None
        &metrics.push(JetLogMetricState{name: ~name, next_index: 2})
        Val((true, U64{1}))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:348
fn jet_log_publish_metric(name: String, value: I64) -> {
    name :: jet_log_telemetry_text(name)
    if name.is_empty() -> return
    (first, index) :: match jet_log_metric_slot(name) { Val(slot) -> slot, None -> return }
    timestamp_ns :: jet_log_telemetry_wall_now_ns()
    if first {
        fields :: "{{\"name\":{jet_log_telemetry_json_string(name)},\"kind\":\"counter\",\"unit\":\"count\",\"description\":\"core.log counter\",\"source_id\":{jet_log_telemetry_json_string(JET_LOG_TELEMETRY_SOURCE)},\"source_file\":{jet_log_telemetry_json_string(JET_LOG_TELEMETRY_FILE)},\"source_line\":179,\"source_column\":1,\"source_function\":\"jet_ring_log_counter\"}}"
        if JetDevtoolsEvent.from_parts(0, JET_LOG_TELEMETRY_SOURCE, "Metric", name, ^fields) is Ok(event) { jet_devtools_publish_event(^event) }
    }
    span :: jet_log_current_span()
    span_id :: span.as_ref().map(span -> span.id.to_string())
    trace_id :: span.as_ref().and_then(span -> span.trace_id.as_ref())
    fields :: "{{\"index\":{index},\"timestamp_ns\":{timestamp_ns},\"instrument\":{jet_log_telemetry_json_string(name)},\"source_id\":{jet_log_telemetry_json_string(JET_LOG_TELEMETRY_SOURCE)},\"source_file\":{jet_log_telemetry_json_string(JET_LOG_TELEMETRY_FILE)},\"source_line\":179,\"source_column\":1,\"source_function\":\"jet_ring_log_counter\",\"tags\":[]{jet_log_telemetry_context_json(trace_id, span_id.as_ref())} }}"
    payload :: "{{\"value\":{value}}}"
    if JetDevtoolsEvent.from_parts_with_payload(timestamp_ns / 1_000_000, JET_LOG_TELEMETRY_SOURCE, "Metric", name, ^fields, Val(^payload)) is Ok(event) { jet_devtools_publish_event(^event) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:402
pub fn jet_log_telemetry_log_fields(fields: [LogField]) -> String {
    metadata := [(String, Bool)]{}
    loop field in fields.iter().take(JET_LOG_TELEMETRY_MAX_FIELDS) {
        key :: jet_log_telemetry_text(field.key)
        if key.is_empty() -> continue
        if metadata.iter().position(pair -> pair.0 == key) is Val(pos) {
            metadata[pos].1 = metadata[pos].1 || field.redacted
        } else { &metadata.push((^key, field.redacted)) }
    }
    &metadata.sort_by((left, right) -> left.0.cmp(right.0))
    fragments := [String]{}
    loop (key, redacted) in metadata {
        if redacted -> &fragments.push("{{\"key\":{jet_log_telemetry_json_string(key)},\"redacted\":true}}")
        else -> &fragments.push("{{\"key\":{jet_log_telemetry_json_string(key)}}}")
    }
    "[{fragments.join(",")}]"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:432
pub fn jet_log_telemetry_payload_fields(fields: [LogField]) -> String {
    values := [String]{}
    loop field in fields.iter().take(JET_LOG_TELEMETRY_MAX_FIELDS) {
        key :: jet_log_telemetry_text(field.key)
        if key.is_empty() || field.redacted -> continue
        value :: match field.kind {
            "int" | "counter" -> field.value.parse<I64>().ok().map(value -> value.to_string()),
            "float" -> field.value.parse<F64>().ok().filter(value -> value.is_finite()).map(value -> value.to_string()),
            "bool" if field.value == "true" || field.value == "false" -> Val(~field.value),
            _ -> Val(jet_log_telemetry_json_string(field.value)),
        }
        if value is Val(value) -> &values.push("{{\"key\":{jet_log_telemetry_json_string(key)},\"value\":{value}}}")
    }
    "[{values.join(",")}]"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:466
fn jet_log_publish_record(level: String, message: String, timestamp_ns: U64, fields: [LogField], index: U64, span: JetLogSpanObservation?) -> Bool {
    span_id :: span.as_ref().map(span -> span.id.to_string())
    trace_id :: span.as_ref().and_then(span -> span.trace_id.as_ref())
    telemetry_fields :: "{{\"index\":{index},\"timestamp_ns\":{timestamp_ns},\"level\":{jet_log_telemetry_json_string(level)},\"source_id\":{jet_log_telemetry_json_string(JET_LOG_TELEMETRY_SOURCE)},\"source_file\":{jet_log_telemetry_json_string(JET_LOG_TELEMETRY_FILE)},\"source_line\":724,\"source_column\":1,\"source_function\":\"jet_log_emit\",\"fields\":{jet_log_telemetry_log_fields(fields)}{jet_log_telemetry_context_json(trace_id, span_id.as_ref())} }}"
    payload :: "{{\"body\":{jet_log_telemetry_json_string(message)},\"fields\":{jet_log_telemetry_payload_fields(fields)}}}"
    event :: match JetDevtoolsEvent.from_parts_with_payload(timestamp_ns / 1_000_000, JET_LOG_TELEMETRY_SOURCE, "Log", index.to_string(), ^telemetry_fields, Val(^payload)) {
        Ok(event) -> event, Err(_) -> return false,
    }
    jet_devtools_publish_event(^event)
    true
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:505
fn jet_log_note_active_span(span_id: I64, log_index: U64) -> JetLogSpanObservation? {
    // GATE #4565: kernel primitive
    #Unsafe("link successful publication only to current matching thread span") {
        JET_LOG_SPAN_OBSERVATIONS.with(spans -> {
            spans := spans.borrow_mut()
            if spans.is_empty() -> return None
            i :: spans.len() - 1
            if spans[i].id != span_id -> return None
            if spans[i].linked_logs.len() < JET_LOG_TELEMETRY_MAX_LINKED_LOGS -> &spans[i].linked_logs.push(log_index)
            Val(~spans[i])
        })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:522
fn jet_log_publish_link(span: JetLogSpanObservation, level: String, timestamp_ns: U64, log_index: U64) -> {
    trace_id :: match span.trace_id.as_ref() { Val(trace) -> trace, None -> return }
    fields :: "{{\"span_index\":{span.id.max(0)},\"log_index\":{log_index},\"trace_id\":{jet_log_telemetry_json_string(trace_id)},\"span_id\":{jet_log_telemetry_json_string(span.id.to_string())},\"span_source_id\":{jet_log_telemetry_json_string(JET_LOG_TELEMETRY_SOURCE)},\"log_source_id\":{jet_log_telemetry_json_string(JET_LOG_TELEMETRY_SOURCE)},\"timestamp_ns\":{timestamp_ns},\"level\":{jet_log_telemetry_json_string(level)}}}"
    if JetDevtoolsEvent.from_parts(timestamp_ns / 1_000_000, JET_LOG_TELEMETRY_SOURCE, "TraceLink", "{span.id.max(0)}:{log_index}", ^fields) is Ok(event) { jet_devtools_publish_event(^event) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:553
fn jet_log_publish_span(span: JetLogSpanObservation, end_ns: U64) -> {
    trace_id :: match span.trace_id.as_ref() { Val(trace) -> trace, None -> return }
    span_index :: span.id.max(0) as U64
    end_ns :: end_ns.max(span.start_ns)
    duration_ns :: end_ns.saturating_sub(span.start_ns)
    linked_logs :: span.linked_logs.iter().map(index -> index.to_string()).collect<[String]>().join(",")
    span_id :: span.id.to_string()
    parent_span_id :: span.parent_id.map(parent -> parent.to_string())
    parent_field :: parent_span_id.as_ref().map(jet_log_telemetry_json_string).unwrap_or_else(() -> "null")
