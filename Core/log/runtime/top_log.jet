// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:52
pub fn jet_log_level_rank(level: String) -> U8? {
    match level {
        "debug" -> Val(U8{0}), "info" -> Val(U8{1}),
        "warn" | "warning" -> Val(U8{2}), "error" -> Val(U8{3}),
        "critical" -> Val(U8{4}), "fatal" -> Val(U8{5}), _ -> None,
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:64
pub fn jet_ring_log_set_level(level: String) -> {
    n :: jet_log_level_rank(level).unwrap_or(1)
    // GATE #4565: kernel primitive
    #Unsafe("set executing thread level") { JET_LOG_LEVEL.with(l -> l.set(n)) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:69
pub fn jet_ring_log_disable() -> {
    // GATE #4565: kernel primitive
