// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:222
pub fn jet_ring_log_close(span: LogSpan) -> {
    // GATE #4565: kernel primitive
    observation :: #Unsafe("remove last matching span from both thread-owned stacks") {
        JET_LOG_SPANS.with(s -> {
            spans := s.borrow_mut()
            if spans.iter().rposition(x -> x.id == span.id) is Val(pos) { _ :: &spans.remove(pos) }
        })
        JET_LOG_SPAN_OBSERVATIONS.with(spans -> {
            spans := spans.borrow_mut()
            spans.iter().rposition(state -> state.id == span.id).map(pos -> &spans.remove(pos))
        })
    }
    if observation is Val(observation) -> jet_log_publish_span(observation, jet_log_telemetry_monotonic_now_ns())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:241
pub fn jet_log_telemetry_text(value: String) -> String {
    out := String.new()
    loop ch in value.chars() {
        if ch.is_control() -> continue
        width :: ch.len_utf8()
        if out.len().saturating_add(width) > JET_LOG_TELEMETRY_TEXT_BYTES -> break
        &out.push(ch)
    }
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:256
pub fn jet_log_telemetry_json_string(value: String) -> String {
    max_len :: JET_LOG_TELEMETRY_TEXT_BYTES.saturating_add(2)
    out := String.with_capacity(value.len().min(JET_LOG_TELEMETRY_TEXT_BYTES) + 2)
    &out.push('"')
    loop ch in value.chars() {
        if ch.is_control() {
            escaped :: "\\u{ch as U32:04x}"
            if out.len().saturating_add(escaped.len()).saturating_add(1) > max_len -> break
            &out.push_str(escaped)
            continue
        }
        fragment :: match ch {
            '"' -> "\\\"", '\\' -> "\\\\", '\n' -> "\\n", '\r' -> "\\r", '\t' -> "\\t",
            '\u{08}' -> "\\b", '\u{0c}' -> "\\f",
            _ -> {
                if out.len().saturating_add(ch.len_utf8()).saturating_add(1) > max_len -> break
                &out.push(ch)
                continue
            },
        }
        if out.len().saturating_add(fragment.len()).saturating_add(1) > max_len -> break
        &out.push_str(fragment)
    }
    &out.push('"')
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:294
pub fn jet_log_telemetry_context_json(trace_id: String?, span_id: String?) -> String {
    match (trace_id, span_id) {
