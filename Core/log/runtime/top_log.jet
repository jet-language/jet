}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:73
pub fn jet_ring_log_flush() -> {
    // GATE #4565: kernel primitive
    #Unsafe("flush stderr and the configured append-only file; ignore native IO failures as in Rust") {
        _ :: io.stderr().flush()
        JET_LOG_SINK_PATH.with(path -> {
            path :: path.borrow()
            if path.is_empty() -> return
            if OpenOptions.new().append(true).create(true).open(OSPath.new(path)) is Ok(file) {
                _ :: &file.flush()
            }
        })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:90
pub fn jet_ring_log_enabled(level: String) -> Bool {
    // GATE #4565: kernel primitive
    #Unsafe("read thread-local disable and level cells") {
