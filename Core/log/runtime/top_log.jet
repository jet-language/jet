fn jet_log_write(line: String) -> {
    // GATE #4565: kernel primitive
    #Unsafe("write actual stderr provider or create/append selected native file; preserve ignored IO errors") {
        path :: JET_LOG_SINK_PATH.with(p -> p.borrow().clone())
