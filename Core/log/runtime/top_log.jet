// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:856
pub fn unix_to_ymdhms(secs: I64) -> (I32, U32, U32, U32, U32, U32) {
    days := secs / 86400
    time_of_day :: (secs % 86400).unsigned_abs()
    h :: (time_of_day / 3600) as U32
    mi :: ((time_of_day % 3600) / 60) as U32
    s :: (time_of_day % 60) as U32
    year := I32{1970}
    loop {
        dy :: if is_leap(year) -> I64{366} else -> I64{365}
        if days < dy -> break
        days -= dy
        year += 1
    }
    month_days :: if is_leap(year) -> [I64]{31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31}
        else -> [I64]{31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31}
    month := U32{1}
    loop md in month_days {
        if days < md -> break
        days -= md
        month += 1
    }
    (year, month, (days + 1) as U32, h, mi, s)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Log.rs:887
pub fn is_leap(y: I32) -> Bool { (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0) }
