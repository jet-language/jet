    spans_json :: jet_log_spans_json()
    line :: if trace.is_empty() -> "{{\"level\":\"{level}\",\"body\":\"{jet_log_json_escape(msg)}\",\"ts\":{ts}{fields_json}{spans_json} }}"
        else -> "{{\"level\":\"{level}\",\"body\":\"{jet_log_json_escape(msg)}\",\"trace_id\":\"{jet_log_json_escape(trace)}\",\"ts\":{ts}{fields_json}{spans_json} }}"
    jet_log_write(line.replace(" }", "}"))
