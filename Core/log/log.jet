package {
    name: "core.log"
    version: "0.1.0"
    edition: "2026"
    description: "Structured logs, spans, and sinks."
    license: "MIT"
    outputs: {
        log: .Library{ entry: log }
    }
}
use core as core

// core.log — one structured logger for the process.
//
// Levels are `debug`, `info`, `warn`, `error`, `critical`, `fatal`. Fields
// are typed (`field` / `int` / `float` / `bool`); `redact` marks a key so
// sinks must not print its value. Spans are `span` + `enter` / `close`.
// This is not a tracing SDK; OTLP file export is the one optional bridge.
//
// Filtering, sampling, JSON line layout, and redaction are Jet. The sink
// write and the process-global level/trace cells are host.
pub struct LogField {
    pub key: String
    pub value: String
    pub kind: String
    pub redacted: Bool
}

pub fn debug(message: String) -[Log]> { emit("debug", message, [LogField]{}) }

pub fn info(message: String) -[Log]> { emit("info", message, [LogField]{}) }

pub fn warn(message: String) -[Log]> { emit("warn", message, [LogField]{}) }

pub fn error(message: String) -[Log]> { emit("error", message, [LogField]{}) }
/// Emit a message at a caller-selected level.
pub fn log(level: String, message: String) -[Log]> { emit(level, message, [LogField]{}) }

/// Python-compatible warning spelling.
pub fn warning(message: String) -[Log]> { warn(message) }


pub fn critical(message: String) -[Log]> { emit("critical", message, [LogField]{}) }

pub fn fatal(message: String) -[Log]> { emit("fatal", message, [LogField]{}) }

pub fn debug_fields(message: String, fields: [LogField]) -[Log]> { emit("debug", message, fields) }

pub fn info_fields(message: String, fields: [LogField]) -[Log]> { emit("info", message, fields) }

pub fn warn_fields(message: String, fields: [LogField]) -[Log]> { emit("warn", message, fields) }

pub fn error_fields(message: String, fields: [LogField]) -[Log]> { emit("error", message, fields) }

pub fn field(key: String, value: String) -> LogField {
    LogField{key: key, value: value, kind: "string", redacted: false}
}

pub fn int(key: String, value: Int) -> LogField {
    LogField{key: key, value: "{value}", kind: "int", redacted: false}
}

pub fn float(key: String, value: Float) -> LogField {
    LogField{key: key, value: "{value}", kind: "float", redacted: false}
}

pub fn bool(key: String, value: Bool) -> LogField {
    LogField{key: key, value: "{value}", kind: "bool", redacted: false}
}

pub fn redact(key: String) -> LogField {
    LogField{key: key, value: "[redacted]", kind: "redacted", redacted: true}
}

pub fn span(name: String) -[Log]> LogSpan { core.log.span(name) }

pub fn enter(span: LogSpan) -[Log]> { core.log.enter(span) }

pub fn close(span: LogSpan) -[Log]> { core.log.close(span) }

pub fn set_sink(kind: String, path: String) -[Log]> {
    normalized :: ascii_lower(trim(kind))
    if normalized == "stderr" -> return core.log.set_sink("json", "")
    if normalized == "stdout" -> return
    if normalized != "json" && normalized != "jsonl" && normalized != "text" -> return
    if (normalized == "jsonl" || normalized == "text") && trim(~path).len() == 0 -> return
    core.log.set_sink(normalized, path)
}

pub fn sample_every(n: Int) -[Log]> {
    if n > 0 -> core.log.sample_every(n)
}

pub fn counter(name: String, value: Int) -> LogField { core.log.counter(name, value) }

pub fn otlp_file(path: String) -[Log, FS]> {
    if trim(~path).len() > 0 -> core.log.otlp_file(path)
}

pub fn set_level(level: String) -[Log]> {
    normalized :: canon_level(level)
    if normalized.len() > 0 -> core.log.set_level(normalized)
}

pub fn set_trace_id(id: String) -[Log]> {
    if trim(~id).len() > 0 -> core.log.set_trace_id(id)
}

/// Apply comma-separated `key=value` settings without handing the whole
/// grammar to the host. The host owns the sink and process-global cells; Jet
/// owns normalization and dispatch of each setting.
pub fn setup(spec: String) -[Log]> {
    loop raw in split_csv(spec) {
        pair :: split_once(raw, "=")
        key :: ascii_lower(trim(pair.left))
        value :: trim(pair.right)
        if {
            key == "level" -> set_level(value)
            key == "format" -> {
                format :: ascii_lower(value)
                if format == "auto" || format == "json" || format == "text" -> core.log.setup(format)
            }
            key == "sink" -> {
                sink :: ascii_lower(value)
                if sink == "stderr" -> set_sink("json", "")
                if sink != "stdout" && sink != "stderr" && sink.len() > 0 -> set_sink("jsonl", value)
            }
            key == "file" || key == "path" -> {
                if value.len() > 0 -> set_sink("jsonl", value)
            }
            key == "sample" || key == "sample_every" -> {
                n :: parse_int(value) ?? next
                if n > 0 -> sample_every(n)
            }
            key == "trace_id" && value.len() > 0 -> set_trace_id(value)
        }
    }
}

pub fn disable() -[Log]> { core.log.disable() }

pub fn flush() -[Log]> { core.log.flush() }

pub fn enabled(level: String) -[Log]> Bool {
    normalized :: canon_level(level)
    if normalized.len() == 0 -> return false
    core.log.enabled(normalized)
}

fn emit(level: String, message: String, fields: [LogField]) -[Log]> {
    normalized :: canon_level(level)
    if normalized.len() == 0 -> return
    if !core.log.enabled(normalized) -> return
    normalized_fields := fields
    if normalized_fields.len() > 0 -> normalized_fields = normalize_fields(normalized_fields)
    if normalized == {
        "debug" -> {
            if normalized_fields.len() > 0 -> return core.log.debug_fields(message, normalized_fields)
            return core.log.debug(message)
        }
        "info" -> {
            if normalized_fields.len() > 0 -> return core.log.info_fields(message, normalized_fields)
            return core.log.info(message)
        }
        "warn" -> {
            if normalized_fields.len() > 0 -> return core.log.warn_fields(message, normalized_fields)
            return core.log.warn(message)
        }
        "error" -> {
            if normalized_fields.len() > 0 -> return core.log.error_fields(message, normalized_fields)
            return core.log.error(message)
        }
        "critical" -> {
            line := message
            if normalized_fields.len() > 0 -> line = render_json(record(normalized, message, normalized_fields))
            return core.log.critical(line)
        }
        "fatal" -> {
            line := message
            if normalized_fields.len() > 0 -> line = render_json(record(normalized, message, normalized_fields))
            return core.log.fatal(line)
        }
        else -> return
    }
}
fn normalize_fields(fields: [LogField]) -> [LogField] {
    needs_normalization := false
    loop i in 0..<fields.len() {
        if fields[i].redacted || (fields[i].kind != "string" && fields[i].kind != "int" && fields[i].kind != "float" && fields[i].kind != "bool" && fields[i].kind != "counter") {
            needs_normalization = true
            break
        }
    }
    if !needs_normalization -> return ~fields
    out := [LogField]{}
    loop field in fields {
        if field.redacted {
            &out.push(LogField{key: field.key, value: "[redacted]", kind: "redacted", redacted: true})
        } else if field.kind != "string" && field.kind != "int" && field.kind != "float" && field.kind != "bool" && field.kind != "counter" {
            &out.push(LogField{key: field.key, value: field.value, kind: "string", redacted: false})
        } else {
            &out.push(field)
        }
    }
    out
}

fn rank(level: String) -> Int {
    n :: canon_level(level)
    if n == {
        "debug" -> 10
        "info" -> 20
        "warn" -> 30
        "error" -> 40
        "critical" -> 50
        "fatal" -> 60
        else -> -1
    }
}

fn canon_level(level: String) -> String {
    n :: ascii_lower(trim(level))
    if n == {
        "warning" -> return "warn"
        "err" -> return "error"
        "crit" -> return "critical"
        "debug" | "info" | "warn" | "error" | "critical" | "fatal" -> return n
        else -> ""
    }
}

fn default_level(level: String) -> String {
    normalized :: canon_level(level)
    if normalized.len() == 0 -> return "info"
    normalized
}

fn canon_mode(mode: String) -> String {
    normalized :: ascii_lower(trim(mode))
    if normalized == "text" -> return "text"
    "json"
}

fn escape(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n :: b
        if n == 92 {
            &out.push(U8{92})
            &out.push(U8{92})
            next
        }
        if n == 34 {
            &out.push(U8{92})
            &out.push(U8{34})
            next
        }
        if n == 8 || n == 9 || n == 10 || n == 12 || n == 13 {
            &out.push(U8{92})
            if n == {
                8 -> &out.push(U8{98})
                9 -> &out.push(U8{116})
                10 -> &out.push(U8{110})
                12 -> &out.push(U8{102})
                13 -> &out.push(U8{114})
                else -> { _ := 0 }
            }
            next
        }
        if n < 32 {
            &out.push(U8{92})
            &out.push(U8{117})
            &out.push(U8{48})
            &out.push(U8{48})
            &out.push(hex_digit(n >> 4))
            &out.push(hex_digit(n & 15))
            next
        }
        &out.push(b)
    }
    String.from_bytes(out) ?? text
}

fn hex_digit(value: Int) -> U8 {
    n :: value & 15
    if n < 10 -> return U8{48 + n}
    U8{87 + n}
}
fn trim(text: String) -> String {
    raw :: text.bytes()
    a := 0
    b := raw.len()
    loop {
        if a >= b -> return ""
        if !is_space(raw[a]) -> break
        a += 1
    }
    loop {
        if b <= a -> return ""
        if !is_space(raw[b - 1]) -> break
        b -= 1
    }
    out := [U8]{}
    i := a
    loop {
        if i >= b -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i += 1
    }
}

fn is_space(b: U8) -> Bool {
    n :: b
    n == 32 || n == 9 || n == 10 || n == 13
}

fn split_csv(text: String) -> [String] {
    out := [String]{}
    cur := [U8]{}
    loop b in text.bytes() {
        if {
            b == (U8{44}) -> {
                &out.push(String.from_bytes(cur) ?? "")
                cur = [U8]{}
            }
            else -> &cur.push(b)
        }
    }
    &out.push(String.from_bytes(cur) ?? "")
    out
}

/// A structured log event shared by formatters and handlers.
pub struct LogRecord {
    pub level: String
    pub message: String
    pub fields: [LogField]
}

/// A deterministic formatter. `text` is human-readable; every other mode is
/// the canonical JSON line used by `emit`.
pub struct Formatter {
    pub mode: String
}

/// A level-filtered sink. `handle` applies the threshold before formatting.
pub struct Handler {
    pub minimum: String
    pub mode: String
}

pub fn record(level: String, message: String, fields: [LogField]) -> LogRecord {
    LogRecord{level: default_level(level), message: message, fields: fields}
}

pub fn formatter(mode: String) -> Formatter {
    Formatter{mode: canon_mode(mode)}
}

pub fn handler(level: String) -> Handler {
    Handler{minimum: default_level(level), mode: "json"}
}

pub fn handler_format(target: Handler, mode: String) -> Handler {
    Handler{minimum: default_level(target.minimum), mode: canon_mode(mode)}
}

pub fn format(target: Formatter, event: LogRecord) -> String {
    mode :: canon_mode(target.mode)
    if mode == "text" -> return render_text(event)
    render_json(event)
}

pub fn handle(target: Handler, event: LogRecord) -[Log]> {
    minimum :: default_level(target.minimum)
    if rank(event.level) < rank(minimum) -> return
    formatter :: Formatter{mode: canon_mode(target.mode)}
    if formatter.mode == "text" {
        emit(event.level, format(formatter, event), [LogField]{})
    } else {
        emit(event.level, event.message, event.fields)
    }
}


fn render_text(event: LogRecord) -> String {
    line := "{event.level}: {event.message}"
    loop field in event.fields {
        value := field.value
        if field.redacted -> value = "[redacted]"
        line = "{line} {field.key}={value}"
    }
    line
}

fn render_json(event: LogRecord) -> String {
    line := "{{\"level\":\"{escape(event.level)}\",\"msg\":\"{escape(event.message)}\""
    loop field in event.fields {
        if field.redacted {
            line = "{line},\"{escape(field.key)}\":\"[redacted]\""
        } else if field.kind == "int" || field.kind == "float" || field.kind == "bool" || field.kind == "counter" {
            line = "{line},\"{escape(field.key)}\":{field.value}"
        } else {
            line = "{line},\"{escape(field.key)}\":\"{escape(field.value)}\""
        }
    }
    line = "{line}}}"
    line
}

pub struct Pair {
    pub left: String
    pub right: String
}

fn split_once(text: String, sep: String) -> Pair {
    hay :: text.bytes()
    nd :: sep.bytes()
    if nd.len() == 0 || nd.len() > hay.len() -> return {left: text, right: ""}
    loop i in 0..<(hay.len() - nd.len() + 1) {
        if matches_at(hay, nd, i) {
            return {left: slice_ascii(hay, 0, i), right: slice_ascii(hay, i + nd.len(), hay.len())}
        }
    }
    {left: text, right: ""}
}

fn matches_at(hay: [U8], needle: [U8], offset: Int) -> Bool {
    loop j in 0..<needle.len() {
        if hay[offset + j] != needle[j] -> return false
    }
    true
}

fn slice_ascii(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    i := start
    loop {
        if i >= end -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i += 1
    }
}

fn ascii_lower(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n :: b
        if n >= 65 && n <= 90 -> &out.push(U8{n + 32}) else -> &out.push(b)
    }
    String.from_bytes(out) ?? text
}

fn parse_int(text: String) -> Int? {
    n := 0
    any := false
    loop b in text.bytes() {
        d :: b
        if d < 48 || d > 57 -> return None
        if n > 922337203685477580 || (n == 922337203685477580 && d > 7) -> return None
        n = n * 10 + (d - 48)
        any = true
    }
    if !any -> return None
    Val(n)
}
pub fn add(event: LogRecord, field: LogField) -> LogRecord {
    fields := event.fields
    &fields.push(field)
    LogRecord{level: event.level, message: event.message, fields: fields}
}

pub fn group(event: LogRecord, prefix: String) -> LogRecord {
    fields := [LogField]{}
    loop field in event.fields -> &fields.push(LogField{key: "{prefix}.{field.key}", value: field.value, kind: field.kind, redacted: field.redacted})
    LogRecord{level: event.level, message: event.message, fields: fields}
}

pub fn time(event: LogRecord, timestamp: Int) -> LogRecord { add(event, int("time", timestamp)) }

pub fn clear(event: LogRecord) -> LogRecord { record(event.level, event.message, [LogField]{}) }
