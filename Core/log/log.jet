package {
    name: "core.log"
    version: "0.0.1"
    edition: "2026"
    description: "Structured logs, spans, and sinks."
    license: "MIT"
    outputs: {
        log: .Library{ entry: log }
    }
}
use core as core

// core.log — one structured logger for the process.
//
// Levels are `debug`, `info`, `warn`, `error`, `critical`, `fatal`. Fields
// are typed (`field` / `int` / `float` / `bool`); `redact` marks a key so
// sinks must not print its value. Spans are `span` + `enter` / `close`.
// This is not a tracing SDK; OTLP file export is the one optional bridge.
//
// Filtering, sampling, JSON line layout, and redaction are Jet. The sink
// write and the process-global level/trace cells are host.
struct LogField {
    key: String
    value: String
    kind: String
    redacted: Bool
}

// Readable but not constructible outside this module.
struct LogSpan {
    id: Int
    name: String

    fn id(self) -> Int Never! { self.id }
    fn name(self) -> String Never! { self.name }
}

fn debug(message: String) Never! -[Log]> { emit("debug", message, [LogField]{}) }

fn info(message: String) Never! -[Log]> { emit("info", message, [LogField]{}) }

fn warn(message: String) Never! -[Log]> { emit("warn", message, [LogField]{}) }

fn error(message: String) Never! -[Log]> { emit("error", message, [LogField]{}) }
/// Emit a message at a caller-selected level.
fn log(level: String, message: String) Never! -[Log]> { emit(level, message, [LogField]{}) }

/// Python-compatible warning spelling.
fn warning(message: String) Never! -[Log]> { warn(message) }


fn critical(message: String) Never! -[Log]> { emit("critical", message, [LogField]{}) }

fn fatal(message: String) Never! -[Log]> { emit("fatal", message, [LogField]{}) }

fn debug_fields(message: String, fields: [LogField]) Never! -[Log]> { emit("debug", message, fields) }

fn info_fields(message: String, fields: [LogField]) Never! -[Log]> { emit("info", message, fields) }

fn warn_fields(message: String, fields: [LogField]) Never! -[Log]> { emit("warn", message, fields) }

fn error_fields(message: String, fields: [LogField]) Never! -[Log]> { emit("error", message, fields) }

fn field(key: String, value: String) -> LogField Never! {
    LogField{key: key, value: value, kind: "string", redacted: false}
}

fn int(key: String, value: Int) -> LogField Never! {
    LogField{key: key, value: "{value}", kind: "int", redacted: false}
}

fn float(key: String, value: Float) -> LogField Never! {
    LogField{key: key, value: "{value}", kind: "float", redacted: false}
}

fn bool(key: String, value: Bool) -> LogField Never! {
    LogField{key: key, value: "{value}", kind: "bool", redacted: false}
}

fn redact(key: String) -> LogField Never! {
    LogField{key: key, value: "[redacted]", kind: "redacted", redacted: true}
}

fn span(name: String) -[Log]> LogSpan Never! {
    allocated :: core.log.__span_allocate(name)
    LogSpan{id: allocated.id, name: allocated.name}
}

fn enter(span: LogSpan) Never! -[Log]> { core.log.__span_enter(span) }

fn close(span: LogSpan) Never! -[Log]> { core.log.__span_close(span) }

/// Select the record sink. `stderr` (JSON lines on stderr) and the `json`,
/// `jsonl` and `text` file sinks are supported. An unsupported kind, or a
/// file sink without a path, leaves the sink unchanged and logs an error
/// record that names the rejected setting instead of returning silently.
fn set_sink(kind: String, path: String) Never! -[Log]> {
    normalized :: ascii_lower(trim(kind))
    if normalized == "stderr" {
        core.log.__format_store(1)
        return core.log.__sink_store("")
    }
    if normalized != "json" && normalized != "jsonl" && normalized != "text" {
        return reject_setting("log.set_sink: unsupported sink kind `{kind}`; the sink is unchanged (supported: stderr, json, jsonl, text)")
    }
    if (normalized == "jsonl" || normalized == "text") && trim(path).len() == 0 {
        return reject_setting("log.set_sink: the `{normalized}` sink needs a file path; the sink is unchanged")
    }
    core.log.__format_store(if normalized == "text" -> 2 else -> 1)
    core.log.__sink_store(path)
}

fn sample_every(n: Int) Never! -[Log]> {
    if n > 0 {
        core.log.__sample_store(n)
        core.log.__sample_count_store(0)
    }
}

fn counter(name: String, value: Int) -> LogField Never! {
    core.log.__metric_publish(name, value)
    LogField{key: "metric.counter.{name}", value: "{value}", kind: "counter", redacted: false}
}

fn otlp_file(path: String) Never! -[Log, FS]> {
    if trim(path).len() > 0 -> set_sink("jsonl", path)
}

fn set_level(level: String) Never! -[Log]> {
    normalized :: canon_level(level)
    if normalized.len() > 0 -> core.log.__level_store(rank_canonical(normalized) /% 10)
}

fn set_trace_id(id: String) Never! -[Log]> {
    if trim(id).len() > 0 -> core.log.__trace_store(id)
}

/// Apply comma-separated settings without handing the whole grammar to the
/// host. Each setting is `key=value` (`level`, `format`, `sink`, `file` or
/// `path`, `sample` or `sample_every`, `trace_id`); a bare `auto`, `json` or
/// `text` selects the record format. An unknown setting or value
/// is reported as an error record and otherwise ignored. The host owns the
/// sink and process-global cells; Jet owns normalization and dispatch.
fn setup(spec: String) Never! -[Log]> {
    loop raw in split_csv(spec) {
        if trim(raw).len() == 0 -> next
        pair :: split_once(raw, "=")
        key :: ascii_lower(trim(pair.left))
        value :: trim(pair.right)
        if {
            value.len() == 0 && is_format(key) -> core.log.__format_store(format_code(key))
            key == "level" && canon_level(value).len() > 0 -> set_level(value)
            key == "format" && is_format(ascii_lower(value)) -> core.log.__format_store(format_code(ascii_lower(value)))
            key == "sink" -> {
                sink :: ascii_lower(value)
                if sink == "stderr" || sink == "stdout" -> set_sink(sink, "") else -> set_sink("jsonl", value)
            }
            (key == "file" || key == "path") && value.len() > 0 -> set_sink("jsonl", value)
            (key == "sample" || key == "sample_every") && (parse_int(value) ?? 0) > 0 -> sample_every(parse_int(value) ?? 0)
            key == "trace_id" && value.len() > 0 -> set_trace_id(value)
            else -> reject_setting("log.setup: unsupported setting `{trim(raw)}`; it was ignored")
        }
    }
}

fn is_format(name: String) -> Bool {
    name == "auto" || name == "json" || name == "text"
}

fn format_code(name: String) -> Int Never! {
    if name == "json" -> return 1
    if name == "text" -> return 2
    0
}

fn reject_setting(message: String) -[Log]> {
    emit("error", message, [LogField]{})
}

fn disable() Never! -[Log]> { core.log.__disabled_store(true) }

fn flush() Never! -[Log]> { core.log.__flush() }

fn enabled(level: String) -[Log]> Bool Never! {
    normalized :: canon_level(level)
    if normalized.len() == 0 -> return false
    enabled_canonical(normalized)
}

fn enabled_canonical(normalized: String) -[Log]> Bool Never! {
    if core.log.__disabled_load() -> return false
    stored :: core.log.__level_load()
    minimum :: if stored == 0 -> 1 else -> stored - 1
    minimum <= rank_canonical(normalized) /% 10 - 1
}

fn emit(level: String, message: String, fields: [LogField]) -[Log]> {
    normalized :: canon_level(level)
    if normalized.len() == 0 -> return
    // `fatal` always ends the process with exit 1 (ledger #1474); the host
    // applies the level filter to the record and still exits, so a disabled
    // or filtered logger must not skip the call.
    if normalized != "fatal" && !enabled_canonical(normalized) -> return
    normalized_fields := fields
    if normalized_fields.len() > 0 -> normalized_fields = normalize_fields(normalized_fields)
    // This leaf retains sink selection, sampling, timestamps and telemetry
    // fan-out until Jet runtime L6 replaces it. It is not a public-row call.
    if normalized == "critical" || normalized == "fatal" {
        line := message
        if normalized_fields.len() > 0 -> line = render_json(record(normalized, message, normalized_fields))
        core.log.__record_emit(normalized, line, [LogField]{})
    } else {
        core.log.__record_emit(normalized, message, normalized_fields)
    }
    if normalized == "fatal" {
        flush()
        core.log.__process_exit(1)
    }
}
fn normalize_fields(fields: [LogField]) -> [LogField] {
    needs_normalization := false
    loop i in 0..<fields.len() {
        if fields[i].redacted || (fields[i].kind != "string" && fields[i].kind != "int" && fields[i].kind != "float" && fields[i].kind != "bool" && fields[i].kind != "counter") {
            needs_normalization = true
            break
        }
    }
    if !needs_normalization -> return fields.copy()
    out := [LogField]{}
    loop field in fields {
        if field.redacted {
            &out.push(LogField{key: field.key, value: "[redacted]", kind: "redacted", redacted: true})
        } else if field.kind != "string" && field.kind != "int" && field.kind != "float" && field.kind != "bool" && field.kind != "counter" {
            &out.push(LogField{key: field.key, value: field.value, kind: "string", redacted: false})
        } else {
            &out.push(field)
        }
    }
    out
}

fn rank(level: String) -> Int { rank_canonical(canon_level(level)) }

fn rank_canonical(level: String) -> Int {
    if level == {
        "debug" -> 10
        "info" -> 20
        "warn" -> 30
        "error" -> 40
        "critical" -> 50
        "fatal" -> 60
        else -> -1
    }
}

fn canon_level(level: String) -> String {
    n :: ascii_lower(trim(level))
    if n == {
        "warning" -> return "warn"
        "err" -> return "error"
        "crit" -> return "critical"
        "debug" | "info" | "warn" | "error" | "critical" | "fatal" -> return n
        else -> ""
    }
}

fn default_level(level: String) -> String {
    normalized :: canon_level(level)
    if normalized.len() == 0 -> return "info"
    normalized
}

fn canon_mode(mode: String) -> String {
    normalized :: ascii_lower(trim(mode))
    if normalized == "text" -> return "text"
    "json"
}

fn escape(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n :: b
        if n == 92 {
            &out.push(U8{92})
            &out.push(U8{92})
            next
        }
        if n == 34 {
            &out.push(U8{92})
            &out.push(U8{34})
            next
        }
        if n == 8 || n == 9 || n == 10 || n == 12 || n == 13 {
            &out.push(U8{92})
            if n == {
                8 -> &out.push(U8{98})
                9 -> &out.push(U8{116})
                10 -> &out.push(U8{110})
                12 -> &out.push(U8{102})
                13 -> &out.push(U8{114})
                else -> { _ := 0 }
            }
            next
        }
        if n < 32 {
            &out.push(U8{92})
            &out.push(U8{117})
            &out.push(U8{48})
            &out.push(U8{48})
            &out.push(hex_digit(n >> 4))
            &out.push(hex_digit((n).bit_and(15)))
            next
        }
        &out.push(b)
    }
    String.from_bytes(out) ?? text
}

fn hex_digit(value: Int) -> U8 {
    n :: (value).bit_and(15)
    if n < 10 -> return U8{48 + n}
    U8{87 + n}
}
fn trim(text: String) -> String {
    raw :: text.bytes()
    a := 0
    b := raw.len()
    loop {
        if a >= b -> return ""
        if !is_space(raw[a]) -> break
        a += 1
    }
    loop {
        if b <= a -> return ""
        if !is_space(raw[b - 1]) -> break
        b -= 1
    }
    out := [U8]{}
    i := a
    loop {
        if i >= b -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i += 1
    }
}

fn is_space(b: U8) -> Bool {
    n :: b
    n == 32 || n == 9 || n == 10 || n == 13
}

fn split_csv(text: String) -> [String] {
    out := [String]{}
    cur := [U8]{}
    loop b in text.bytes() {
        if {
            b == (U8{44}) -> {
                &out.push(String.from_bytes(cur) ?? "")
                cur = [U8]{}
            }
            else -> &cur.push(b)
        }
    }
    &out.push(String.from_bytes(cur) ?? "")
    out
}

/// A structured log event shared by formatters and handlers.
struct LogRecord {
    level: String
    message: String
    fields: [LogField]
}

/// A deterministic formatter. `text` is human-readable; every other mode is
/// the canonical JSON line used by `emit`.
struct Formatter {
    mode: String
}

/// A level-filtered sink. `handle` applies the threshold before formatting.
struct Handler {
    minimum: String
    mode: String
}

fn record(level: String, message: String, fields: [LogField]) -> LogRecord Never! {
    LogRecord{level: default_level(level), message: message, fields: fields}
}

fn formatter(mode: String) -> Formatter Never! {
    Formatter{mode: canon_mode(mode)}
}

fn handler(level: String) -> Handler Never! {
    Handler{minimum: default_level(level), mode: "json"}
}

fn handler_format(target: Handler, mode: String) -> Handler Never! {
    Handler{minimum: default_level(target.minimum), mode: canon_mode(mode)}
}

fn format(target: Formatter, event: LogRecord) -> String Never! {
    mode :: canon_mode(target.mode)
    if mode == "text" -> return render_text(event)
    render_json(event)
}

fn handle(target: Handler, event: LogRecord) Never! -[Log]> {
    minimum :: default_level(target.minimum)
    if rank(event.level) < rank(minimum) -> return
    formatter :: Formatter{mode: canon_mode(target.mode)}
    if formatter.mode == "text" {
        emit(event.level, format(formatter, event), [LogField]{})
    } else {
        emit(event.level, event.message, event.fields)
    }
}


fn render_text(event: LogRecord) -> String {
    line := "{event.level}: {event.message}"
    loop field in event.fields {
        value := field.value
        if field.redacted -> value = "[redacted]"
        line = "{line} {field.key}={value}"
    }
    line
}

fn render_json(event: LogRecord) -> String {
    line := "{{\"level\":\"{escape(event.level)}\",\"msg\":\"{escape(event.message)}\""
    loop field in event.fields {
        if field.redacted {
            line = "{line},\"{escape(field.key)}\":\"[redacted]\""
        } else if field.kind == "int" || field.kind == "float" || field.kind == "bool" || field.kind == "counter" {
            line = "{line},\"{escape(field.key)}\":{field.value}"
        } else {
            line = "{line},\"{escape(field.key)}\":\"{escape(field.value)}\""
        }
    }
    line = "{line}}}"
    line
}

struct Pair {
    left: String
    right: String
}

fn split_once(text: String, sep: String) -> Pair {
    hay :: text.bytes()
    nd :: sep.bytes()
    if nd.len() == 0 || nd.len() > hay.len() -> return {left: text, right: ""}
    loop i in 0..<(hay.len() - nd.len() + 1) {
        if matches_at(hay, nd, i) {
            return {left: slice_ascii(hay, 0, i), right: slice_ascii(hay, i + nd.len(), hay.len())}
        }
    }
    {left: text, right: ""}
}

fn matches_at(hay: [U8], needle: [U8], offset: Int) -> Bool {
    loop j in 0..<needle.len() {
        if hay[offset + j] != needle[j] -> return false
    }
    true
}

fn slice_ascii(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    i := start
    loop {
        if i >= end -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i += 1
    }
}

fn ascii_lower(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n :: b
        if n >= 65 && n <= 90 -> &out.push(U8{n + 32}) else -> &out.push(b)
    }
    String.from_bytes(out) ?? text
}

fn parse_int(text: String) -> Int? {
    n := 0
    any := false
    loop b in text.bytes() {
        d :: b
        if d < 48 || d > 57 -> return None
        if n > 922337203685477580 || (n == 922337203685477580 && d > 7) -> return None
        n = n * 10 + (d - 48)
        any = true
    }
    if !any -> return None
    Val(n)
}
fn add(event: LogRecord, field: LogField) -> LogRecord Never! {
    fields := event.fields
    &fields.push(field)
    LogRecord{level: event.level, message: event.message, fields: fields}
}

fn group(event: LogRecord, prefix: String) -> LogRecord Never! {
    fields := [LogField]{}
    loop field in event.fields -> &fields.push(LogField{key: "{prefix}.{field.key}", value: field.value, kind: field.kind, redacted: field.redacted})
    LogRecord{level: event.level, message: event.message, fields: fields}
}

fn time(event: LogRecord, timestamp: Int) -> LogRecord Never! { add(event, int("time", timestamp)) }

fn clear(event: LogRecord) -> LogRecord Never! { record(event.level, event.message, [LogField]{}) }

#Test("log level policy uses raw state") {
    saved_level :: core.log.__level_load()
    saved_disabled :: core.log.__disabled_load()
    core.log.__level_store(0)
    core.log.__disabled_store(false)
    assert(!enabled("debug"))
    assert(enabled("info"))
    assert(!enabled("not-a-level"))
    set_level(" DEBUG ")
    assert(enabled("debug"))
    set_level("warn")
    assert(!enabled("info"))
    assert(enabled(" WARNING "))
    set_level("invalid")
    assert(!enabled("info"))
    disable()
    assert(!enabled("fatal"))
    core.log.__level_store(saved_level)
    core.log.__disabled_store(saved_disabled)
}

#Test("log format codes are source policy") {
    assert(format_code("auto") == 0)
    assert(format_code("json") == 1)
    assert(format_code("text") == 2)
}

#Test("span allocation preserves names and advances the thread counter") {
    first :: span(" \nλ ")
    second :: span("")
    assert_eq(first.name(), " \nλ ")
    assert_eq(second.name(), "")
    assert_eq(second.id(), first.id() + 1)
}

#Test("typed log fields retain order and normalize only redacted or unknown kinds") {
    fields :: normalize_fields([LogField]{
        LogField{key: "same", value: "secret", kind: "int", redacted: true},
        LogField{key: "same", value: "7", kind: "counter", redacted: false},
        LogField{key: "\"", value: "\n", kind: "unknown", redacted: false}
    })
    assert_eq(fields.len(), 3)
    assert_eq(fields[0].key, "same")
    assert_eq(fields[0].value, "[redacted]")
    assert_eq(fields[0].kind, "redacted")
    assert_eq(fields[1].value, "7")
    assert_eq(fields[1].kind, "counter")
    assert_eq(fields[2].key, "\"")
    assert_eq(fields[2].value, "\n")
    assert_eq(fields[2].kind, "string")
}
