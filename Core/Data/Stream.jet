use core as core
use core.data.[DataError, DataErrorKind, DataStream]

fn stream_error(kind: DataErrorKind, reason: String, operation: String) -> DataError Never! {
    DataError{
        kind: kind,
        operation: operation,
        row: None,
        column: None,
        index: None,
        reason: reason,
        cause: None,
    }
}

// core.data.stream — one-shot typed DataStream<T> operations.
//
// The cursor is owned by the DataStream handle: its owned items first, then
// the rows of its pull source (`csv_reader<T>`). Pull and collection advance
// that same cursor; a source failure stays latched, and cancellation is
// terminal and never becomes an empty success. Provider-owned decoders must
// construct DataStream<T> before these operations are called, so this module
// never coerces a String into T.

fn from_items<T>(items: ^[T]) -> DataStream<T> Never! {
    DataStream<T>{items: items, index: 0, cancelled: false, __source: None}
}

fn next<T>(stream: &DataStream<T>) -> T? DataError! {
    core.data.__stream_pull<T>(&stream)
}

fn collect<T>(stream: &DataStream<T>) -> [T] DataError! {
    core.data.__stream_collect<T>(&stream)
}

fn cancel<T>(stream: &DataStream<T>) Never! {
    stream.cancelled = true
}

fn skip<T>(stream: &DataStream<T>, count: Int) Never! {
    remaining := count
    loop remaining > 0 {
        if core.data.__stream_pull<T>(&stream) == {
            .Ok(item) -> {
                if item == {
                    .Val(_) -> remaining = remaining - 1
                    else -> return
                }
            }
            .Err(_) -> return
        }
    }
}

fn take_n<T>(stream: &DataStream<T>, count: Int) -> [T] DataError! {
    if stream.cancelled -> return Err(stream_error(DataErrorKind.State, "stream was cancelled", "data.stream"))
    out := [T]{}
    remaining := count
    loop remaining > 0 {
        item :: core.data.__stream_pull<T>(&stream)
        row :: item ?? return Ok(out)
        &out.push(row)
        remaining = remaining - 1
    }
    Ok(out)
}

fn len<T>(stream: DataStream<T>) -> Int Never! { core.data.__stream_remaining<T>(stream) }

fn is_empty<T>(stream: DataStream<T>) -> Bool Never! { len<T>(stream) == 0 }
