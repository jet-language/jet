package: {
    name: "core.data"
    version: "0.0.1"
    edition: "2026"
    description: "Tabular data, loaders, sketches, and plots."
    license: "MIT"
    outputs: {
        data: .Library{ entry: data }
    }
}

use {
    core: core
    builtin: jet_builtins
    math: core.math
    encoding: core.encoding
    rt: jet.runtime.encoding
    core.encoding.[EncodingError, EncodingLimits, Format]
    json_codec: core.encoding.json
    csv_codec: core.encoding.csv
    encoding_stream: __core_encoding_stream
    parquet: __core_data_parquet
    core.crypto.[sha256]
    time: core.time
    core.time.[DateTime]
    quantile_select.[finite_quantile, select_rank]
    rank_order.[rank_select_prototype, rank_select_range, rank_test_before, rank_test_refusing, rank_test_text_before, rank_test_values]
}

arrow: module

loader: module

stream: module

plot: module

sketch: module

#[Comparable, Equatable]
DataFormat: enum {
    CSV,
    JSON,
    JSONL,
    Parquet,
    Arrow,
}

#Equatable
DataErrorKind: enum {
    Decode,
    Limit,
    IO,
    Empty,
    InvalidArgument,
    NonFinite,
    Overflow,
    State,
    Bridge,
    Unsupported,
    DuplicateKey,
    MissingKey,
    WrongOwner,
    StaleRevision,
    InvalidValue,

    impl Display {
        display: fn(self) -> String { data_error_kind_text(self) }
    }

    impl Debug {
        debug: fn(^^self) -> String { data_error_kind_text(self) }
    }
}

data_error_kind_text: fn(kind: DataErrorKind) -> String Never! {
    if kind == {
        .Decode -> "Decode"
        .Limit -> "Limit"
        .IO -> "IO"
        .Empty -> "Empty"
        .InvalidArgument -> "InvalidArgument"
        .NonFinite -> "NonFinite"
        .Overflow -> "Overflow"
        .State -> "State"
        .Bridge -> "Bridge"
        .Unsupported -> "Unsupported"
        .DuplicateKey -> "DuplicateKey"
        .MissingKey -> "MissingKey"
        .WrongOwner -> "WrongOwner"
        .StaleRevision -> "StaleRevision"
        .InvalidValue -> "InvalidValue"
    }
}

#[Equatable, Error]
DataError: struct {
    kind: DataErrorKind,
    operation: String,
    row: Int?,
    column: Int?,
    index: Int?,
    reason: String,
    cause: EncodingError?,

    impl Display {
        display: fn(self) -> String { data_error_text(self) }
    }

    impl Debug {
        debug: fn(^^self) -> String { data_error_text(self) }
    }

    new: fn(kind: DataErrorKind, message: String, path: String) -> DataError Never! {
        return DataError{
            kind: kind,
            operation: path.copy(),
            row: None,
            column: None,
            index: None,
            reason: message,
            cause: None,
        }
    }
}

data_error: fn(kind: DataErrorKind, message: String, operation: String) -> DataError Never! {
    DataError{
        kind: kind,
        operation: operation,
        row: None,
        column: None,
        index: None,
        reason: message,
        cause: None,
    }
}

data_error_text: fn(error: DataError) -> String Never! {
    text := "{data_error_kind_text(error.kind)} {error.operation}"
    if error.row == .Val(row) -> text = "{text}, row {row}"
    if error.column == .Val(column) -> text = "{text}, column {column}"
    if error.index == .Val(index) -> text = "{text}, index {index}"
    "{text}: {error.reason}"
}

data_error_at: fn(kind: DataErrorKind, message: String, operation: String, index: Int) -> DataError Never! {
    DataError{
        kind: kind,
        operation: operation,
        row: None,
        column: None,
        index: Val(index),
        reason: message,
        cause: None,
    }
}

nonfinite: fn(value: Float) -> Bool Never! {
    if math.is_finite(value) -> return false
    true
}

DataLineOptions: struct {
    title: String,
    x_label: String,
    y_label: String,
    markers: Bool,
    reference: Float?,
    style: String,
    color: String,
    legend: String,
}

#Comparable
DataFreshness: enum {
    Pending,
    Fresh,
    Stale,
    Error,
    Offline,
    Canceled,
}

#[Comparable, Equatable]
DataInvalidationCause: enum {
    NoCause,
    Loader,
    Input,
    ArchiveMember,
    Parameters,
    Credential,
    Capability,
    Manual,
}

#Equatable
DataStatus: struct {
    step: String,
    path: String,
    clone_value: String,
    ownership: String,
    trust: String,
    fallback: String,
    replacement: String,
}

#Equatable
DataLimits: struct {
    encoding: EncodingLimits,
    max_groups: Int,
    max_sort_rows: Int,
    max_join_rows: Int,
    max_output_rows: Int,

    // Typed data declarations and provider-backed boundaries.
    safe: fn() -> DataLimits Never! {
        DataLimits{
            encoding: encoding.EncodingLimits.safe(),
            max_groups: 100000,
            max_sort_rows: 1000000,
            max_join_rows: 1000000,
            max_output_rows: 1000000,
        }
    }
}

DataAuthority: struct {
    scope: String,
    revision: String,
}

// Where a loader reads from; the runtime's data provider takes it by
// position.
DataLoaderKind: enum {
    File,
    URL,
    Database,
    Value,
}

DataSourceIdentity: struct {
    kind: DataLoaderKind,
    locator: String,
    member: String,
    parameters: [String],
}

DataSnapshotIdentity: struct {
    id: String,
    source: String,
    content: String,
    schema: String,
    format: DataFormat,
}

DataProvenance: struct {
    source: DataSourceIdentity,
    format: DataFormat,
    authority: DataAuthority,
}

DataColumn: struct {
    id: String,
    name: String,
    type_name: String,
    nullable: Bool,
}

DataSchema: struct {
    identity: String,
    format: DataFormat,
    columns: [DataColumn],
    projection: String?,
}

DataSnapshot: struct<T> {
    value: T,
    identity: DataSnapshotIdentity,
    provenance: DataProvenance,
    schema: DataSchema,
    status: DataLoaderStatus,
    content: [U8],
}

// A loader reads its payload as one of Core's data formats (`format`), or,
// made by `file_as` or `url_as`, through a package's `Format`: then `format`
// is None, `codec` is that `Format`'s name, and `stream_as` gives the rows.
DataLoader: struct<T> {
    source: DataSourceIdentity,
    format: DataFormat?,
    codec: String?,
    authority: DataAuthority,
    limits: DataLimits,
    payload: [U8]?,
    last_good: [U8]?,
    canceled: Bool,
    offline: Bool,
    status: DataLoaderStatus,
}

#Comparable
DataLoaderStatus: struct {
    identity: String,
    freshness: DataFreshness,
    invalidated_by: DataInvalidationCause,
    error: String,
    cleanup: String,
    buffered_bytes: Int,
    backpressure: Bool,
    last_good: Bool,
}

#Equatable
DataWatchStatus: struct {
    mode: String,
    revision: Int,
    retained_rows: Int,
    recomputations: Int,
    active: Bool,
    generation: Int,
    dirty: Bool,
    error: String,
    freshness_ms: Int,
    invalidation_cause: String,
    refreshing: Bool,
    canceled: Bool,

    impl Display {
        display: fn(self) -> String { data_watch_status_text(self) }
    }

    impl Debug {
        debug: fn(^^self) -> String { data_watch_status_text(self) }
    }
}

data_watch_status_text: fn(status: DataWatchStatus) -> String Never! {
    "DataWatchStatus{{mode: {status.mode}, revision: {status.revision}, retained_rows: {status.retained_rows}, recomputations: {status.recomputations}, active: {status.active}, generation: {status.generation}, dirty: {status.dirty}, error: {status.error}, freshness_ms: {status.freshness_ms}, invalidation_cause: {status.invalidation_cause}, refreshing: {status.refreshing}, canceled: {status.canceled}}}"
}

// A stream is a one-shot cursor (core-library.md `core.data.stream`): the
// owned `items` come first, then the rows of the optional pull source.
DataStream: struct<T> {
    items: [T],
    index: Int,
    canceled: Bool,
    __source: Shared<StreamSource<T>>?,
}

// The pull side of a file-backed stream. `pull` reads and decodes one row; a
// failure stays latched in `terminal`, and `ahead` keeps rows that `len` read
// early. `limits` are the reader's: they bound `collect` and a query over the
// stream.
priv StreamSource: struct<T> {
    pull: fn() -> T? DataError!,
    limits: DataLimits,
    ahead: [T],
    ahead_index: Int,
    terminal: DataError?,
    done: Bool,
}

DataPivotCell: struct {
    row_key: String,
    column_key: String,
    count: Int,
    sum: Float,
    mean: Float,
}

#Equatable
DataSummary: struct {
    count: Int,
    sum: Float,
    mean: Float,
    min: Float,
    max: Float,
    median: Float,
    variance: Float,
    stddev: Float,
}

DataJoin: struct<L, R> {
    left: L,
    right: R,
}

JetDataPlot: struct<T> {
    rows: [T],
    plan: JetDataPlotPlan,
}

Group: struct<K, V> {
    key: K,
    value: V,
}

// Query<T> is the deferred operation carrier: `__steps` is the plan and the
// shared cell holds the computation that materializes the rows on collect.
// Row-list queries that only filter and sort may be collected again; every
// other computation (map, extrema, joins, grouped reducers) is one-shot and
// derived filter/sort queries share that one-shot state.
//
// `run(condition, values)` materializes the rows. A source that can select
// its rows by a SQL condition (a database table, `__query_narrowed`) reads
// only the rows `condition` holds for, with `values` bound to its `?`s in
// order; `""` selects every row. A filter whose predicate the compiler wrote
// as such a condition passes it on to its own query, joined to the one it
// was given, and every other filter passes on the one it was given. Each
// filter still applies its predicate to the rows it gets, so a condition
// only ever narrows what is read. Every other step reads every row of its
// query and ignores the condition.
priv QueryCell: struct<T> {
    run: fn(String, [String]) -> [T] DataError!,
    count_by: (fn(String, String, [String]) -[DB.Read]> [{key: String, count: Int}]? DataError!)?,
}

priv QueryState: struct {
    consumed: Bool,
}

// `__limits` bound the query's sorts, groups and output: a query over a
// reader's stream keeps that reader's limits, every other source starts at
// `DataLimits.safe()`, and each derived query inherits its source's.
// `__take`, set by `limit`, is how many of its cell's rows it gives.
// `__live` is how a watch maintains the query's rows (QueryLive); None when
// no watch can.
Query: struct<T> {
    __steps: [String],
    __one_shot: Bool,
    __limits: DataLimits,
    __state: Shared<QueryState>,
    __cell: Shared<QueryCell<T>>,
    __take: Int?,
    __live: Shared<QueryLive<T>>?,

    // The first `count` rows the query gives, in its order; a count below
    // one gives none. A table's query gives the rows its row policy let the
    // caller read, so a limit counts those and a page is full whenever the
    // caller may read enough rows. The limited query reads its source as
    // the source reads, without a filter after it narrowing that read.
    limit: fn(self, count: Int) -> Query<T> Never! {
        most: if self.__take == .Val(held) && held < count -> held else -> count
        live: query_live_derived<T, T>(self, fn(entries: [WatchEntry<T>]) {
            out := [WatchEntry<T>]{}
            loop entry in entries {
                if out.len() >= most -> break
                out.push(entry.copy())
            }
            Ok(out)
        })
        Query<T>{__steps: query_steps(self.__steps, "limit"), __one_shot: self.__one_shot, __limits: self.__limits.copy(), __state: self.__state.copy(), __cell: self.__cell.copy(), __take: Val(most), __live: live}
    }

    // The steps the query runs, from its source on (`"scan"`, `"filter"`,
    // `"sql"`, …).
    plan: fn(self) -> [String] Never! { self.__steps.copy() }

    // A watch over the query (DataWatch), which keeps its rows and maintains
    // them from the edits of the `data.track` rows the query reads. Only
    // such a query can be watched.
    watch: fn(self) -> DataWatch<T> DataError! { query_watch<T>(self) }

    // Grouped row counts over an `Int` key: runs a single SQL `GROUP BY` query
    // when `column` names a table's field column and the source supports SQL
    // grouping, otherwise reads the query's rows and counts in memory.
    __count_by_int: fn(self, column: String, key: ^^fn(T) -[]> Int) -[DB.Read]> [Int:Int] DataError! {
        if column != "" {
            if query_count_by_sql<T>(self, column, "", [String]{}) == {
                .Ok(found) -> {
                    if found == .Val(groups) {
                        if groups.len() > self.__limits.max_groups {
                            return Err(data_error(DataErrorKind.Limit, "max_groups {self.__limits.max_groups} exceeded", "query.count_by"))
                        }
                        out := [Int:Int]{}
                        parsed := true
                        loop entry in groups {
                            if Int.parse(entry.key) == .Ok(number) -> out[number] = entry.count else {
                                parsed = false
                                break
                            }
                        }
                        if parsed -> return Ok(out)
                    }
                }
                .Err(failure) -> return Err(failure)
            }
        }
        rows: self.collect() ?? return Err(err)
        limits: self.__limits.copy()
        out := [Int:Int]{}
        loop row in rows {
            group_key: key(row.copy()) ?? return Err(data_error(DataErrorKind.State, "group key callback failed", "query.count_by"))
            if out.get(group_key) == .Val(held) -> out[group_key] = held + 1 else {
                if out.len() >= limits.max_groups {
                    return Err(data_error(DataErrorKind.Limit, "max_groups {limits.max_groups} exceeded", "query.count_by"))
                }
                out[group_key] = 1
            }
        }
        Ok(out)
    }

    __count_by_string: fn(self, column: String, key: ^^fn(T) -[]> String) -[DB.Read]> [String:Int] DataError! {
        if column != "" {
            if query_count_by_sql<T>(self, column, "", [String]{}) == {
                .Ok(found) -> {
                    if found == .Val(groups) {
                        if groups.len() > self.__limits.max_groups {
                            return Err(data_error(DataErrorKind.Limit, "max_groups {self.__limits.max_groups} exceeded", "query.count_by"))
                        }
                        out := [String:Int]{}
                        loop entry in groups -> out[entry.key.copy()] = entry.count
                        return Ok(out)
                    }
                }
                .Err(failure) -> return Err(failure)
            }
        }
        rows: self.collect() ?? return Err(err)
        limits: self.__limits.copy()
        out := [String:Int]{}
        loop row in rows {
            group_key: key(row.copy()) ?? return Err(data_error(DataErrorKind.State, "group key callback failed", "query.count_by"))
            if out.get(group_key) == .Val(held) -> out[group_key] = held + 1 else {
                if out.len() >= limits.max_groups {
                    return Err(data_error(DataErrorKind.Limit, "max_groups {limits.max_groups} exceeded", "query.count_by"))
                }
                out[group_key] = 1
            }
        }
        Ok(out)
    }

    __count_by_bool: fn(self, column: String, key: ^^fn(T) -[]> Bool) -[DB.Read]> [Bool:Int] DataError! {
        if column != "" {
            if query_count_by_sql<T>(self, column, "", [String]{}) == {
                .Ok(found) -> {
                    if found == .Val(groups) {
                        if groups.len() > self.__limits.max_groups {
                            return Err(data_error(DataErrorKind.Limit, "max_groups {self.__limits.max_groups} exceeded", "query.count_by"))
                        }
                        out := [Bool:Int]{}
                        parsed := true
                        loop entry in groups {
                            if entry.key == "1" || entry.key == "true" -> out[true] = entry.count else if entry.key == "0" || entry.key == "false" {
                                out[false] = entry.count
                            } else {
                                parsed = false
                                break
                            }
                        }
                        if parsed -> return Ok(out)
                    }
                }
                .Err(failure) -> return Err(failure)
            }
        }
        rows: self.collect() ?? return Err(err)
        limits: self.__limits.copy()
        out := [Bool:Int]{}
        loop row in rows {
            group_key: key(row.copy()) ?? return Err(data_error(DataErrorKind.State, "group key callback failed", "query.count_by"))
            if out.get(group_key) == .Val(held) -> out[group_key] = held + 1 else {
                if out.len() >= limits.max_groups {
                    return Err(data_error(DataErrorKind.Limit, "max_groups {limits.max_groups} exceeded", "query.count_by"))
                }
                out[group_key] = 1
            }
        }
        Ok(out)
    }
}

// A row callback that a query's batch run and its watch both call: a
// filter's predicate, a sort or join key, a projection, a group key or a
// group value. It sits in a Shared cell because a function value cannot be
// copied.
priv QueryKeyCell: struct<T, K> {
    key: fn(T) -[]> K DataError!,
}

// A grouped sum's addition, shared the same way.
priv QueryAddCell: struct<V> {
    add: fn(V, V) -[]> V DataError!,
}

// `query.group_by(key)`: the grouped carrier its count/sum/mean reducers read.
DataGroupedQuery: struct<T, K> {
    __query: Query<T>,
    __key: Shared<QueryKeyCell<T, K>>,
}

// `data.track(rows, key)`: owned rows with unique keys, changed in place by
// `insert`, `replace` and `remove`. The table is shared, so a query over it
// reads the rows as they are when it runs, and a watch of that query
// maintains its result from the table's changes.
DataTracked: struct<T, K: Comparable> {
    __table: Shared<TrackedTable<T, K>>,

    // A reusable scan of the tracked rows, in the order they were added.
    query: fn(self) -> Query<T> Never! { __query_tracked<T, K>(self) }

    // Adds `row`, whose key must not be tracked yet.
    insert: fn(self, row: T) DataError! { tracked_insert<T, K>(self, row) }

    // Replaces the row tracked under `key` with `row`, whose own key must be
    // `key`: a replace never adds a row.
    replace: fn(self, key: K, row: T) DataError! { tracked_replace<T, K>(self, key, row) }

    // Removes the row tracked under `key`.
    remove: fn(self, key: K) DataError! { tracked_remove<T, K>(self, key) }
}

// A tracked table's rows: `keys[i]` is the key of `rows[i]` and `orders[i]`
// its stamp, which a row keeps from its insert to its removal; stamps only
// grow, so the rows are in stamp order. `by_key` holds the positions sorted
// by key, so a lookup is a binary search (group_find). Each edit is the
// table's next `revision` and logs one change (tracked_log).
priv TrackedTable: struct<T, K> {
    rows: [T],
    keys: [K],
    by_key: [Int],
    orders: [Int],
    next_order: Int,
    revision: Int,
    changes: [TrackedChange<T>],
    key: fn(T) -[]> K DataError!,
}

// One edit of a tracked table: from `revision` on, the row stamped `order`
// is `row`, or is gone when `row` is None. An insert, a replace and a remove
// are each one change.
priv TrackedChange: struct<T> {
    revision: Int,
    order: Int,
    row: T?,
}

// A tracked table as a watch reads it, without its key type: `snapshot`
// reads every row, `changes` the changes after a revision (TrackedDelta).
priv TrackedReader: struct<T> {
    snapshot: fn() -[]> TrackedSnapshot<T> Never!,
    changes: fn(Int) -[]> TrackedDelta<T> DataError!,
}

priv TrackedSnapshot: struct<T> {
    revision: Int,
    orders: [Int],
    rows: [T],
}

// The changes after a revision, oldest first, up to the table's `revision`.
// `complete` is false when the table's log no longer holds them all.
priv TrackedDelta: struct<T> {
    revision: Int,
    retained_rows: Int,
    complete: Bool,
    changes: [TrackedChange<T>],
}

// How a watch maintains a query's rows. A query over
// a tracked table that only filters and sorts has the table's `reader` and
// its `steps`, and a watch applies each change to the rows it holds
// (watch_tracked); a grouped reducer over such a query maintains its groups
// the same way (watch_group). Every other maintained query (`map`, `min`,
// `max`, `limit`, a join with a maintained side, and a filter or sort after
// one of them) has `derived`, whose source derives its result again from
// its input's maintained result when that changed (watch_derived,
// watch_join).
priv QueryLive: struct<T> {
    reader: Shared<TrackedReader<T>>?,
    steps: [WatchStep<T>],
    derived: Shared<WatchFactory<T>>?,
}

// A filter (`keep`) or a sort (`key`) over a tracked table's rows.
priv WatchStep: struct<T> {
    keep: Shared<QueryKeyCell<T, Bool>>?,
    key: Shared<QueryKeyCell<T, String>>?,
}

// Makes the source of a new watch; None when its input has none.
priv WatchFactory: struct<T> {
    make: fn() -[]> WatchSource<T>? Never!,
}

priv WatchDerive: struct<S, T> {
    run: fn([WatchEntry<S>]) -[]> [WatchEntry<T>] DataError!,
}

priv WatchJoin: struct<T, U, O> {
    run: fn([T], [U]) -[]> [O] DataError!,
}

// A join side's rows as a watch that does not maintain the side reads them
// (watch_static).
priv QueryRowsCell: struct<T> {
    read: fn() -[]> [T] DataError!,
}

// One row of a maintained result. `order` is the stamp of its tracked row
// (a position, in a derived result) and `keys` the sort keys that place it,
// last sort first (watch_before).
priv WatchEntry: struct<T> {
    order: Int,
    keys: [String],
    value: T,
}

// A source's result at `revision`. An unchanged result has no entries: its
// holder keeps the ones it has. `commit` records the result as the base of
// the source's next refresh; a watch runs it only when it publishes the
// result, so a failed refresh leaves every source where it was.
priv WatchView: struct<T> {
    entries: [WatchEntry<T>],
    revision: Int,
    mode: String,
    recomputed: Bool,
    changed: Bool,
    retained_rows: Int,
    commit: fn() -[]> Never!,
}

// `refresh(revision, prior)` brings `prior`, the result published at
// `revision`, up to the source's current revision.
priv WatchSource: struct<T> {
    initial: fn() -[]> WatchView<T> DataError!,
    refresh: fn(Int, [WatchEntry<T>]) -[]> WatchView<T> DataError!,
}

// A watch's published result and lifecycle. `publications` counts the
// writes, so a refresh publishes only over the state it started from.
priv WatchState: struct<T> {
    entries: [WatchEntry<T>],
    revision: Int,
    mode: String,
    retained_rows: Int,
    recomputations: Int,
    generation: Int,
    publications: Int,
    dirty: Bool,
    error: String,
    invalidation_cause: String,
    canceled: Bool,
    max_output_rows: Int,
}

// `query.watch()`: the query's rows, kept and maintained from the changes of
// the tracked table under it (QueryLive). `get` brings them up to the
// table's revision: with no change since the last get it answers the kept
// rows without running a callback, and otherwise it applies each change to
// them. A refresh publishes all of its result or none: a failure keeps the
// published rows and their revision, marks the watch dirty and records the
// error. `cancel` ends the watch: a later `get` fails.
DataWatch: struct<T> {
    __source: Shared<WatchSource<T>>,
    __state: Shared<WatchState<T>>,

    get: fn(self) -> [T] DataError! { watch_get<T>(self) }

    status: fn(self) -> DataWatchStatus Never! { watch_status<T>(self) }

    cancel: fn(self) Never! { watch_cancel<T>(self) }
}

#Comparable
JetDataPlotMark: enum {
    Line,
    Bar,
    Point,

    as_str: fn(self) -> String Never! {
        if self == {
            .Line -> "line"
            .Bar -> "bar"
            .Point -> "point"
        }
    }
}

#Comparable
JetDataPlotChannel: enum {
    X,
    Y,
    Color,
    Size,
    Text,
    Detail,

    as_str: fn(self) -> String Never! {
        if self == {
            .X -> "x"
            .Y -> "y"
            .Color -> "color"
            .Size -> "size"
            .Text -> "text"
            .Detail -> "detail"
        }
    }
}

JetDataPlotAggregate: enum {
    Sum,
    Mean,
    Count,
    Min,
    Max,
}

#Comparable
JetDataPlotFilterOp: enum {
    Equal,
    NotEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,

    as_str: fn(self) -> String Never! {
        if self == {
            .Equal -> "eq"
            .NotEqual -> "ne"
            .Less -> "lt"
            .LessEqual -> "lte"
            .Greater -> "gt"
            .GreaterEqual -> "gte"
        }
    }
}

