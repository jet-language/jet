// Typed data declarations and provider-backed boundaries.
impl DataLimits {
    fn safe() -> DataLimits Never! {
        DataLimits{
            encoding: encoding.EncodingLimits.safe(),
            max_groups: 100000,
            max_sort_rows: 1000000,
            max_join_rows: 1000000,
            max_output_rows: 1000000,
        }
    }
}

fn track<T, K>(rows: [T], _key: fn(T) -> K) -> DataTracked<T, K> DataError! {
    Ok(DataTracked<T, K>{snapshot: snapshot_from_rows<T>(rows)})
}

fn __query_make<T>(steps: [String], one_shot: Bool, run: ^fn() -> [T] DataError!) -> Query<T> Never! {
    Query<T>{__steps: steps, __one_shot: one_shot, __state: shared __QueryState{consumed: false}, __cell: shared __QueryCell<T>{run: ^run}}
}

fn __query_steps(steps: [String], step: String) -> [String] Never! {
    out := steps.copy()
    &out.push(step)
    out
}

// The rows a query produces, without the output bound of `collect`; a
// one-shot computation runs at most once.
fn __query_rows<T>(query: Query<T>) -> [T] DataError! {
    if query.__one_shot {
        state := query.__state.guard_edit()
        if state.value.consumed -> return Err(data_error(DataErrorKind.State, "query has already been collected", "query.collect"))
        state.value.consumed = true
    }
    cell :: query.__cell.guard_read()
    cell.value.run()
}

// `data.query(rows)`: a reusable scan of an in-memory row list.
fn query<T>(rows: [T]) -> Query<T> Never! {
    __query_make<T>([String]{"scan"}, false, () -> Ok(rows.copy()))
}

// `data.query(stream)`: a one-shot read of the stream's remaining rows.
fn __query_stream<T>(source: DataStream<T>) -> Query<T> Never! {
    __query_make<T>([String]{"stream"}, true, () -> {
        reader := source.copy()
        if reader.cancelled -> return Err(data_error(DataErrorKind.State, "stream was cancelled", "data.stream"))
        limits := DataLimits.safe()
        out := [T]{}
        loop {
            if __stream_pull<T>(&reader) == {
                .Ok(item) -> {
                    row :: item ?? return Ok(out)
                    if out.len() >= limits.max_output_rows -> return Err(data_error(DataErrorKind.Limit, "max_output_rows {limits.max_output_rows} exceeded", "collect"))
                    &out.push(row)
                }
                .Err(failure) -> return Err(failure)
            }
        }
        Ok(out)
    })
}

// The next row of a stream: its owned items first, then its pull source.
// End of input is a stable `None`; a source failure stays latched.
fn __stream_pull<T>(stream: &DataStream<T>) -> T? DataError! {
    if stream.cancelled -> return Err(data_error(DataErrorKind.State, "stream was cancelled", "data.stream"))
    if stream.index < 0 -> stream.index = 0
    if stream.index < stream.items.len() {
        value :: stream.items[stream.index].copy()
        stream.index = stream.index + 1
        return Ok(Val(value))
    }
    if stream.__source == {
        .Val(source) -> {
            cell := source.guard_edit()
            if cell.value.ahead_index < cell.value.ahead.len() {
                value :: cell.value.ahead[cell.value.ahead_index].copy()
                cell.value.ahead_index = cell.value.ahead_index + 1
                return Ok(Val(value))
            }
            if cell.value.terminal == {
                .Val(failure) -> return Err(failure.copy())
                else -> {}
            }
            if cell.value.done -> return Ok(None)
            if cell.value.pull() == {
                .Ok(item) -> {
                    row :: item ?? {
                        cell.value.done = true
                        return Ok(None)
                    }
                    return Ok(Val(row))
                }
                .Err(failure) -> {
                    cell.value.terminal = Val(failure.copy())
                    return Err(failure)
                }
            }
        }
        else -> return Ok(None)
    }
}

// `stream.collect`: the remaining rows, bounded by the source's
// `max_output_rows`; crossing fails before the crossing row is kept, and
// the failure stays latched (Rust `jet_data_stream_collect`).
fn __stream_collect<T>(stream: &DataStream<T>) -> [T] DataError! {
    limit :: if stream.__source == {
        .Val(source) -> source.guard_read().value.max_output_rows
        else -> -1
    }
    out := [T]{}
    loop {
        item :: __stream_pull<T>(&stream)
        row :: item ?? return Ok(out)
        if limit >= 0 && out.len() >= limit {
            failure :: data_error(DataErrorKind.Limit, "max_output_rows {limit} exceeded", "collect")
            if stream.__source == {
                .Val(source) -> {
                    cell := source.guard_edit()
                    cell.value.terminal = Val(failure.copy())
                }
                else -> {}
            }
            return Err(failure)
        }
        &out.push(row)
    }
}

// `stream.len`: the rows still to come. A pull source reads its remaining
// rows ahead into `ahead` so that no row changes owner; a failure while
// reading ahead is latched for the pull after those rows.
fn __stream_remaining<T>(stream: DataStream<T>) -> Int Never! {
    if stream.cancelled -> return 0
    start :: if stream.index < 0 -> 0 else -> stream.index
    remaining := stream.items.len() - start
    if remaining < 0 -> remaining = 0
    if stream.__source == {
        .Val(source) -> {
            cell := source.guard_edit()
            reading := !cell.value.done
            if cell.value.terminal == {
                .Val(_) -> reading = false
                else -> {}
            }
            loop reading {
                if cell.value.pull() == {
                    .Ok(item) -> {
                        if item == {
                            .Val(row) -> &cell.value.ahead.push(row)
                            else -> {
                                cell.value.done = true
                                reading = false
                            }
                        }
                    }
                    .Err(failure) -> {
                        cell.value.terminal = Val(failure)
                        reading = false
                    }
                }
            }
            remaining = remaining + cell.value.ahead.len() - cell.value.ahead_index
        }
        else -> {}
    }
    remaining
}

// `data.query(tracked)` and `tracked.query()`: a reusable scan of the
// tracked snapshot rows.
fn __query_tracked<T, K>(tracked: DataTracked<T, K>) -> Query<T> Never! {
    __query_make<T>([String]{"track"}, false, () -> Ok(tracked.snapshot.value.copy()))
}

fn __query_plan<T>(query: Query<T>) -> [String] Never! { query.__steps.copy() }

fn __query_collect<T>(query: Query<T>) -> [T] DataError! {
    rows :: __query_rows<T>(query) ?? return Err(err)
    limits := DataLimits.safe()
    if rows.len() > limits.max_output_rows -> return Err(data_error(DataErrorKind.Limit, "max_output_rows {limits.max_output_rows} exceeded", "query.collect"))
    Ok(rows)
}

fn __query_filter<T>(query: Query<T>, predicate: ^fn(T) -> Bool) -> Query<T> Never! {
    __query_make<T>(__query_steps(query.__steps, "filter"), false, () -> {
        rows :: __query_rows<T>(query) ?? return Err(err)
        out := [T]{}
        loop row in rows {
            keep :: predicate(row.copy()) ?? return Err(data_error(DataErrorKind.State, "filter callback failed", "query.filter"))
            if keep -> &out.push(row.copy())
        }
        Ok(out)
    })
}

// A stable sort by the String key, bounded by `max_sort_rows`.
fn __query_sort_by<T>(query: Query<T>, key: ^fn(T) -> String) -> Query<T> Never! {
    __query_make<T>(__query_steps(query.__steps, "sort_by"), false, () -> {
        rows :: __query_rows<T>(query) ?? return Err(err)
        limits := DataLimits.safe()
        if rows.len() > limits.max_sort_rows -> return Err(data_error(DataErrorKind.Limit, "max_sort_rows {limits.max_sort_rows} exceeded", "query.sort_by"))
        keys := [String]{}
        loop row in rows {
            text :: key(row.copy()) ?? return Err(data_error(DataErrorKind.State, "sort key callback failed", "query.sort_by"))
            &keys.push(text)
        }
        out := [T]{}
        loop index in __query_merge_order(keys, false, false) -> &out.push(rows[index].copy())
        Ok(out)
    })
}

// Whether position `left` stays before position `right`. `sort_by` compares
// its String keys and keeps equal keys in row order. An SQL ORDER BY compares
// two numeric cells as numbers and any other pair as text, breaks ties by row
// position, and reverses that whole order when descending.
fn __query_order_before(keys: [String], left: Int, right: Int, sql_order: Bool, descending: Bool) -> Bool Never! {
    if !sql_order -> return keys[left] <= keys[right]
    order := 0
    left_number :: __query_number(keys[left])
    right_number :: __query_number(keys[right])
    numeric := false
    if left_number == .Val(a) {
        if right_number == .Val(b) {
            numeric = true
            if a < b -> order = -1
            if a > b -> order = 1
        }
    }
    if !numeric {
        if keys[left] < keys[right] -> order = -1
        if keys[left] > keys[right] -> order = 1
    }
    if order == 0 -> order = if left < right -> -1 else -> 1
    if descending -> order = -order
    order < 0
}

fn __query_number(text: String) -> Float? Never! { Val(Float.parse(text) ?? return None) }

// A bottom-up merge sort of the key positions.
fn __query_merge_order(keys: [String], sql_order: Bool, descending: Bool) -> [Int] Never! {
    count :: keys.len()
    order := [Int]{}
    loop index in 0..<count -> &order.push(index)
    width := 1
    loop width < count {
        merged := [Int]{}
        start := 0
        loop start < count {
            middle := start + width
            if middle > count -> middle = count
            end := start + width * 2
            if end > count -> end = count
            left := start
            right := middle
            loop left < middle || right < end {
                take_left := right >= end
                if !take_left && left < middle -> take_left = __query_order_before(keys, order[left], order[right], sql_order, descending)
                if take_left {
                    &merged.push(order[left])
                    left = left + 1
                } else {
                    &merged.push(order[right])
                    right = right + 1
                }
            }
            start = end
        }
        order = merged
        width = width * 2
    }
    order
}

fn __query_map<T, U>(query: Query<T>, mapper: ^fn(T) -> U) -> Query<U> Never! {
    __query_make<U>(__query_steps(query.__steps, "map"), true, () -> {
        rows :: __query_rows<T>(query) ?? return Err(err)
        out := [U]{}
        loop row in rows {
            value :: mapper(row.copy()) ?? return Err(data_error(DataErrorKind.State, "map callback failed", "query.map"))
            &out.push(value)
        }
        Ok(out)
    })
}

// The first minimum or maximum key in row order; an empty query has none.
fn __query_extreme<T, V: Comparable>(query: Query<T>, key: ^fn(T) -> V, maximum: Bool) -> Query<V> Never! {
    step :: if maximum -> "max" else -> "min"
    operation :: "query.{step}"
    __query_make<V>(__query_steps(query.__steps, step), true, () -> {
        rows :: __query_rows<T>(query) ?? return Err(err)
        selected := [V]{}
        loop row in rows {
            candidate :: key(row.copy()) ?? return Err(data_error(DataErrorKind.State, "extreme key callback failed", operation))
            if selected.len() == 0 {
                &selected.push(candidate)
            } else {
                replace :: if maximum -> candidate > selected[0] else -> candidate < selected[0]
                if replace -> selected[0] = candidate
            }
        }
        if selected.len() == 0 -> return Err(data_error(DataErrorKind.Empty, "empty query has no extreme", operation))
        Ok(selected)
    })
}

fn __query_min<T, V: Comparable>(query: Query<T>, key: ^fn(T) -> V) -> Query<V> Never! { __query_extreme<T, V>(query, ^key, false) }

fn __query_max<T, V: Comparable>(query: Query<T>, key: ^fn(T) -> V) -> Query<V> Never! { __query_extreme<T, V>(query, ^key, true) }

fn __query_inner_join<T, U>(left: Query<T>, right: Query<U>, left_key: ^fn(T) -> String, right_key: ^fn(U) -> String) -> Query<DataJoin<T, U>> Never! {
    __query_make<DataJoin<T, U>>(__query_steps(left.__steps, "inner_join"), true, () -> {
        left_rows :: __query_rows<T>(left) ?? return Err(err)
        right_rows :: __query_rows<U>(right) ?? return Err(err)
        inner_join<T, U>(left_rows, right_rows, left_key, right_key)
    })
}

fn __query_left_join<T, U>(left: Query<T>, right: Query<U>, left_key: ^fn(T) -> String, right_key: ^fn(U) -> String) -> Query<DataJoin<T, U?>> Never! {
    __query_make<DataJoin<T, U?>>(__query_steps(left.__steps, "left_join"), true, () -> {
        left_rows :: __query_rows<T>(left) ?? return Err(err)
        right_rows :: __query_rows<U>(right) ?? return Err(err)
        left_join<T, U>(left_rows, right_rows, left_key, right_key)
    })
}

fn __query_group_by<T, K>(query: Query<T>, key: ^fn(T) -> K) -> DataGroupedQuery<T, K> Never! {
    DataGroupedQuery<T, K>{__query: query, __key: shared __QueryKeyCell<T, K>{key: (row: T) -> {
        value :: key(row) ?? return Err(data_error(DataErrorKind.State, "group key callback failed", "query.group_by"))
        Ok(value)
    }}}
}

fn __group_steps<T, K>(grouped: DataGroupedQuery<T, K>, step: String) -> [String] Never! {
    __query_steps(__query_steps(grouped.__query.__steps, "group_by"), step)
}

// Groups come out in ascending key order (a stable sort of the first-seen
// groups); reaching `max_groups` fails before a new group is retained.
fn __group_find<K: Comparable>(keys: [K], key: K) -> Int Never! {
    loop index in 0..<keys.len() {
        if (keys[index] <=> key) == Ordering.Equal -> return index
    }
    -1
}

fn __group_sorted<K: Comparable, V>(groups: [Group<K, V>]) -> [Group<K, V>] Never! {
    out := groups
    &out.sort_by((left: Group<K, V>, right: Group<K, V>) -> left.key <=> right.key)
    out
}

fn __group_count<T, K: Comparable>(grouped: DataGroupedQuery<T, K>) -> Query<Group<K, Int>> Never! {
    __query_make<Group<K, Int>>(__group_steps<T, K>(grouped, "count"), true, () -> {
        rows :: __query_rows<T>(grouped.__query) ?? return Err(err)
        limits := DataLimits.safe()
        cell :: grouped.__key.guard_read()
        keys := [K]{}
        counts := [Int]{}
        loop row in rows {
            group_key :: cell.value.key(row.copy()) ?? return Err(err)
            found :: __group_find<K>(keys, group_key)
            if found >= 0 {
                counts[found] = counts[found] + 1
            } else {
                if keys.len() >= limits.max_groups -> return Err(data_error(DataErrorKind.Limit, "max_groups {limits.max_groups} exceeded", "query.group_by.count"))
                &keys.push(group_key)
                &counts.push(1)
            }
        }
        out := [Group<K, Int>]{}
        loop index in 0..<keys.len() -> &out.push(Group<K, Int>{key: keys[index].copy(), value: counts[index]})
        Ok(__group_sorted<K, Int>(out))
    })
}

// Group sums keep the value callback's numeric type; each numeric domain
// supplies its own addition to the shared reducer.
fn __group_sum<T, K: Comparable, V>(grouped: DataGroupedQuery<T, K>, value: ^fn(T) -> V, add: ^fn(V, V) -> V) -> Query<Group<K, V>> Never! {
    __query_make<Group<K, V>>(__group_steps<T, K>(grouped, "sum"), true, () -> {
        rows :: __query_rows<T>(grouped.__query) ?? return Err(err)
        limits := DataLimits.safe()
        cell :: grouped.__key.guard_read()
        keys := [K]{}
        totals := [V]{}
        loop row in rows {
            group_key :: cell.value.key(row.copy()) ?? return Err(err)
            group_value :: value(row.copy()) ?? return Err(data_error(DataErrorKind.State, "group value callback failed", "query.group_by.sum"))
            found :: __group_find<K>(keys, group_key)
            if found >= 0 {
                total :: add(totals[found].copy(), group_value) ?? return Err(data_error(DataErrorKind.Overflow, "group sum overflowed", "query.group_by.sum"))
                totals[found] = total
            } else {
                if keys.len() >= limits.max_groups -> return Err(data_error(DataErrorKind.Limit, "max_groups {limits.max_groups} exceeded", "query.group_by.sum"))
                &keys.push(group_key)
                &totals.push(group_value)
            }
        }
        if keys.len() > limits.max_output_rows -> return Err(data_error(DataErrorKind.Limit, "max_output_rows {limits.max_output_rows} exceeded", "query.group_by.sum"))
        out := [Group<K, V>]{}
        loop index in 0..<keys.len() -> &out.push(Group<K, V>{key: keys[index].copy(), value: totals[index].copy()})
        Ok(__group_sorted<K, V>(out))
    })
}

fn __group_sum_int<T, K: Comparable>(grouped: DataGroupedQuery<T, K>, value: ^fn(T) -> Int) -> Query<Group<K, Int>> Never! { __group_sum<T, K, Int>(grouped, ^value, (left: Int, right: Int) -> left + right) }
fn __group_sum_float<T, K: Comparable>(grouped: DataGroupedQuery<T, K>, value: ^fn(T) -> Float) -> Query<Group<K, Float>> Never! { __group_sum<T, K, Float>(grouped, ^value, (left: Float, right: Float) -> left + right) }
fn __group_sum_f32<T, K: Comparable>(grouped: DataGroupedQuery<T, K>, value: ^fn(T) -> F32) -> Query<Group<K, F32>> Never! { __group_sum<T, K, F32>(grouped, ^value, (left: F32, right: F32) -> left + right) }
fn __group_sum_i8<T, K: Comparable>(grouped: DataGroupedQuery<T, K>, value: ^fn(T) -> I8) -> Query<Group<K, I8>> Never! { __group_sum<T, K, I8>(grouped, ^value, (left: I8, right: I8) -> left + right) }
fn __group_sum_i16<T, K: Comparable>(grouped: DataGroupedQuery<T, K>, value: ^fn(T) -> I16) -> Query<Group<K, I16>> Never! { __group_sum<T, K, I16>(grouped, ^value, (left: I16, right: I16) -> left + right) }
fn __group_sum_i32<T, K: Comparable>(grouped: DataGroupedQuery<T, K>, value: ^fn(T) -> I32) -> Query<Group<K, I32>> Never! { __group_sum<T, K, I32>(grouped, ^value, (left: I32, right: I32) -> left + right) }
fn __group_sum_i64<T, K: Comparable>(grouped: DataGroupedQuery<T, K>, value: ^fn(T) -> I64) -> Query<Group<K, I64>> Never! { __group_sum<T, K, I64>(grouped, ^value, (left: I64, right: I64) -> left + right) }
fn __group_sum_u8<T, K: Comparable>(grouped: DataGroupedQuery<T, K>, value: ^fn(T) -> U8) -> Query<Group<K, U8>> Never! { __group_sum<T, K, U8>(grouped, ^value, (left: U8, right: U8) -> left + right) }
fn __group_sum_u16<T, K: Comparable>(grouped: DataGroupedQuery<T, K>, value: ^fn(T) -> U16) -> Query<Group<K, U16>> Never! { __group_sum<T, K, U16>(grouped, ^value, (left: U16, right: U16) -> left + right) }
fn __group_sum_u32<T, K: Comparable>(grouped: DataGroupedQuery<T, K>, value: ^fn(T) -> U32) -> Query<Group<K, U32>> Never! { __group_sum<T, K, U32>(grouped, ^value, (left: U32, right: U32) -> left + right) }
fn __group_sum_u64<T, K: Comparable>(grouped: DataGroupedQuery<T, K>, value: ^fn(T) -> U64) -> Query<Group<K, U64>> Never! { __group_sum<T, K, U64>(grouped, ^value, (left: U64, right: U64) -> left + right) }

fn __group_mean<T, K: Comparable>(grouped: DataGroupedQuery<T, K>, value: ^fn(T) -> Float) -> Query<Group<K, Float>> Never! {
    __query_make<Group<K, Float>>(__group_steps<T, K>(grouped, "mean"), true, () -> {
        rows :: __query_rows<T>(grouped.__query) ?? return Err(err)
        limits := DataLimits.safe()
        cell :: grouped.__key.guard_read()
        keys := [K]{}
        totals := [Float]{}
        counts := [Int]{}
        loop row in rows {
            group_key :: cell.value.key(row.copy()) ?? return Err(err)
            group_value :: value(row.copy()) ?? return Err(data_error(DataErrorKind.State, "group value callback failed", "query.group_by.mean"))
            if nonfinite(group_value) -> return Err(data_error(DataErrorKind.NonFinite, "group values must be finite", "query.group_by.mean"))
            found :: __group_find<K>(keys, group_key)
            if found >= 0 {
                totals[found] = totals[found] + group_value
                counts[found] = counts[found] + 1
            } else {
                if keys.len() >= limits.max_groups -> return Err(data_error(DataErrorKind.Limit, "max_groups {limits.max_groups} exceeded", "query.group_by.mean"))
                &keys.push(group_key)
                &totals.push(group_value)
                &counts.push(1)
            }
        }
        out := [Group<K, Float>]{}
        loop index in 0..<keys.len() -> &out.push(Group<K, Float>{key: keys[index].copy(), value: totals[index] / Float{counts[index]}})
        Ok(__group_sorted<K, Float>(out))
    })
}

// `rows.query(sql)`: the rows encode to `Dyn` trees, the checked SQL binds its
// one WHERE value after parsing, and every referenced field must exist in the
// all-row schema. Only WHERE, ORDER BY and LIMIT select typed rows here; a
// projection or grouping changes the row shape.
fn __query_sql<T: Encode>(rows: [T], sql: SQL) -> Query<T> [FieldError]! {
    trees := [Dyn]{}
    loop row in rows -> &trees.push(row.encode())
    spec :: __query_sql_spec(sql) ?? return Err(__query_field_error("{err}"))
    core.db.sql.__validate_query_fields(spec, __query_sql_fields(trees), "analytics query") ?? return Err(__query_field_error("{err}"))
    reshapes := spec.group_by.len() != 0 || spec.projection.len() != 1 || spec.projection[0] != sql_kernel.JetSQLSelectItem.Wildcard
    loop item in spec.projection {
        if item == .Aggregate(_, _, _) -> reshapes = true
    }
    if reshapes -> return Err(__query_field_error("SQL projection/grouping changes the row shape; use the Dyn query result"))
    selected := [T]{}
    loop index in __query_sql_select(trees, spec) -> &selected.push(rows[index].copy())
    Ok(__query_make<T>([String]{"scan", "sql"}, false, () -> Ok(selected.copy())))
}

// The CSV header door of `csv.query`: every field the SQL names must be a
// header column.
fn __query_validate_fields(fields: [String], sql: SQL) [FieldError]! {
    spec :: sql_kernel.parse_sql_query(sql.text) ?? return Err(__query_field_error("{err}"))
    core.db.sql.__validate_query_fields(spec, fields, "analytics query") ?? return Err(__query_field_error("{err}"))
    Ok()
}

fn __query_field_error(message: String) -> [FieldError] Never! {
    [FieldError]{FieldError{path: "", reason: message}}
}

// The checked carrier binds after parsing, so a value cannot become query
// syntax; the kernel has one scalar WHERE slot.
fn __query_sql_spec(sql: SQL) -> sql_kernel.JetSQLQuery Err! {
    spec := sql_kernel.parse_sql_query(sql.text) ?? return Err("{err}")
    placeholder := false
    if spec.filter == .Val(filter) -> placeholder = filter.value == "?"
    if sql.values.len() == 0 {
        if placeholder -> return Err("analytics query WHERE binding is missing")
        return Ok(spec)
    }
    if !placeholder || sql.values.len() != 1 -> return Err("analytics query bindings do not match its WHERE value")
    if sql.values[0] == .Blob(_) -> return Err("analytics query WHERE requires a scalar binding")
    literal :: if sql.values[0] == {
        .Null -> "null"
        .Int(value) -> "{value}"
        .Float(value) -> core.db.__float_text(value)
        .Bool(value) -> "{value}"
        .Text(value) -> "'{value.replace("'", "''")}'"
        .Blob(_) -> ""
    }
    if spec.filter == .Val(filter) -> spec.filter = Val((field: filter.field.copy(), operator: filter.operator.copy(), value: literal))
    Ok(spec)
}

// The all-row schema's field names: every object key of every row, and `$`
// for a row that is not an object.
fn __query_sql_fields(trees: [Dyn]) -> [String] Never! {
    names := [String]{}
    loop tree in trees {
        if tree == .Object(_) {
            loop entry in encoding_stream.object_entries(tree) -> &names.push(entry.key.copy())
        } else {
            &names.push("$")
        }
    }
    names
}

// A cell's comparison text: text as is, scalars in their display form, null
// empty, and any other value as compact JSON.
fn __query_sql_cell(tree: Dyn, field: String) -> String? Never! {
    if !(tree == .Object(_)) -> return None
    loop entry in encoding_stream.object_entries(tree) {
        if entry.key != field -> next
        return Val(if entry.value == {
            .Text(text) -> text.copy()
            .Int(number) -> "{number}"
            .Float(number) -> core.db.__float_text(number)
            .Bool(flag) -> "{flag}"
            .Null -> ""
            else -> json_codec.to_string(entry.value) ?? ""
        })
    }
    None
}

// WHERE keeps rows whose cell compares true, ORDER BY sorts the kept
// positions, and LIMIT keeps a prefix.
fn __query_sql_select(trees: [Dyn], spec: sql_kernel.JetSQLQuery) -> [Int] Never! {
    selected := [Int]{}
    loop index in 0..<trees.len() {
        if spec.filter == .Val(filter) {
            cell :: __query_sql_cell(trees[index], filter.field) ?? next
            if !sql_kernel.compare_sql_cell(cell, filter.operator, filter.value) -> next
        }
        &selected.push(index)
    }
    if spec.order == .Val(order) {
        keys := [String]{}
        loop index in selected -> &keys.push(__query_sql_cell(trees[index], order.field) ?? "")
        ordered := [Int]{}
        loop position in __query_merge_order(keys, true, order.descending) -> &ordered.push(selected[position])
        selected = ordered
    }
    if spec.limit == .Val(limit) {
        kept := [Int]{}
        loop index in selected {
            if (U64.from_int(kept.len()) ?? U64{0}) >= limit -> break
            &kept.push(index)
        }
        selected = kept
    }
    selected
}

// `data.schema(rows)`: sema passes the checked row type's column names and
// type spellings (a scalar row is one `value` column), so empty rows still
// describe their columns.
fn __schema<T>(_rows: [T], names: [String], types: [String]) -> [DataColumn] Never! {
    columns := [DataColumn]{}
    loop index in 0..<names.len() {
        &columns.push(DataColumn{id: __column_identity(names[index], types[index]), name: names[index].copy(), type_name: types[index].copy(), nullable: types[index].ends_with("?")})
    }
    columns
}

// A column identity: FNV-1a 64 over the length-delimited `name:type` key,
// spelled `column-` and 16 lowercase hex digits.
fn __column_identity(name: String, type_name: String) -> String Never! {
    key :: "{name.bytes().len()}:{type_name}"
    hash := U64{14695981039346656037}
    loop byte in key.bytes() -> hash = (hash.bit_xor(U64.from_u8(byte))).wrapping_mul(U64{1099511628211})
    digits :: "0123456789abcdef".bytes()
    out := "column-".bytes()
    loop index in 0..<16 {
        shift :: U64.from_int(60 - index * 4) ?? U64{0}
        &out.push(digits[Int.from_u64((hash >> shift).bit_and(U64{15}))])
    }
    String.from_bytes(out) ?? ""
}

#Codable
struct __QueryTestSale {
    item: String
    cents: Int
}

fn __query_test_sales() -> [__QueryTestSale] Never! {
    [__QueryTestSale]{__QueryTestSale{item: "tools", cents: 125}, __QueryTestSale{item: "core", cents: 40}, __QueryTestSale{item: "apps", cents: 80}, __QueryTestSale{item: "core", cents: 90}}
}

#Test("deferred queries filter, sort, map and group rows in key order") {
    rows :: __query_test_sales()
    big :: __query_filter<__QueryTestSale>(query<__QueryTestSale>(rows), sale -> sale.cents >= 80)
    assert_eq(__query_plan<__QueryTestSale>(big), [String]{"scan", "filter"})
    sorted :: __query_collect<__QueryTestSale>(__query_sort_by<__QueryTestSale>(big, sale -> sale.item)) ?? panic("sort_by")
    assert_eq(sorted.len(), 3)
    assert_eq(sorted[0].item, "apps")
    assert_eq(sorted[1].cents, 90)
    assert_eq(sorted[2].item, "tools")
    assert_eq((__query_collect<__QueryTestSale>(big) ?? panic("reuse")).len(), 3)
    mapped :: __query_map<__QueryTestSale, Int>(query<__QueryTestSale>(rows), sale -> sale.cents * 2)
    assert_eq(__query_collect<Int>(mapped) ?? panic("map"), [Int]{250, 80, 160, 180})
    if __query_collect<Int>(mapped) == .Ok(_) -> panic("a mapped query collects once")
    assert_eq(__query_collect<Int>(__query_min<__QueryTestSale, Int>(query<__QueryTestSale>(rows), sale -> sale.cents)) ?? panic("min"), [Int]{40})
    assert_eq(__query_collect<String>(__query_max<__QueryTestSale, String>(query<__QueryTestSale>(rows), sale -> sale.item)) ?? panic("max"), [String]{"tools"})
    if __query_collect<Int>(__query_min<__QueryTestSale, Int>(query<__QueryTestSale>([__QueryTestSale]{}), sale -> sale.cents)) == .Ok(_) -> panic("an empty query has no minimum")
    sums :: __query_collect<Group<String, Int>>(__group_sum_int<__QueryTestSale, String>(__query_group_by<__QueryTestSale, String>(query<__QueryTestSale>(rows), sale -> sale.item), sale -> sale.cents)) ?? panic("sum")
    assert_eq(sums.len(), 3)
    assert_eq(sums[0].key, "apps")
    assert_eq(sums[2].key, "tools")
    assert_eq(sums[1].key, "core")
    assert_eq(sums[1].value, 130)
    counts :: __query_collect<Group<String, Int>>(__group_count<__QueryTestSale, String>(__query_group_by<__QueryTestSale, String>(query<__QueryTestSale>(rows), sale -> sale.item))) ?? panic("count")
    assert_eq(counts[1].value, 2)
    means :: __query_collect<Group<String, Float>>(__group_mean<__QueryTestSale, String>(__query_group_by<__QueryTestSale, String>(query<__QueryTestSale>(rows), sale -> sale.item), sale -> Float{sale.cents})) ?? panic("mean")
    assert_eq(means[1].value, 65.0)
    joined :: __query_collect<DataJoin<__QueryTestSale, __QueryTestSale?>>(__query_left_join<__QueryTestSale, __QueryTestSale>(query<__QueryTestSale>(rows), query<__QueryTestSale>(sorted), sale -> sale.item, sale -> sale.item)) ?? panic("left_join")
    assert_eq(joined.len(), 4)
    assert(joined[1].right == None)
}

#Test("SQL row queries bind after parsing and keep typed rows") {
    rows :: __query_test_sales()
    selected :: __query_sql<__QueryTestSale>(rows, SQL{text: "SELECT * FROM sales WHERE cents > ? ORDER BY item", values: [DBValue]{.Int(50)}}) ?? panic("sql")
    assert_eq(__query_plan<__QueryTestSale>(selected), [String]{"scan", "sql"})
    got :: __query_collect<__QueryTestSale>(selected) ?? panic("collect")
    assert_eq(got.len(), 3)
    assert_eq(got[0].item, "apps")
    assert_eq(got[1].cents, 90)
    top :: __query_collect<__QueryTestSale>(__query_sql<__QueryTestSale>(rows, SQL{text: "SELECT * FROM sales ORDER BY cents DESC LIMIT 2", values: [DBValue]{}}) ?? panic("top")) ?? panic("top collect")
    assert_eq(top.len(), 2)
    assert_eq(top[0].cents, 125)
    assert_eq(top[1].cents, 90)
    quoted :: __query_collect<__QueryTestSale>(__query_sql<__QueryTestSale>(rows, SQL{text: "SELECT * FROM sales WHERE item = ?", values: [DBValue]{.Text("it's")}}) ?? panic("quoted")) ?? panic("quoted collect")
    assert_eq(quoted.len(), 0)
    refusals :: [String]{"SELECT * FROM sales WHERE missing = 1", "SELECT item FROM sales", "SELECT * FROM sales WHERE cents > ?"}
    expected :: [String]{"analytics query references unknown field `missing`", "SQL projection/grouping changes the row shape; use the Dyn query result", "analytics query WHERE binding is missing"}
    loop index in 0..<refusals.len() {
        if __query_sql<__QueryTestSale>(rows, SQL{text: refusals[index], values: [DBValue]{}}) == {
            .Ok(_) -> panic("SQL query should be refused")
            .Err(errors) -> assert_eq(errors[0].reason, expected[index])
        }
    }
    if __query_validate_fields([String]{"item"}, SQL{text: "SELECT * FROM sales ORDER BY cents", values: [DBValue]{}}) == {
        .Ok(_) -> panic("an unknown header field should be refused")
        .Err(errors) -> assert_eq(errors[0].reason, "analytics query references unknown field `cents`")
    }
}

#Test("schema columns keep their order, nullability and column identity") {
    columns :: __schema<Int>([Int]{}, [String]{"team", "minutes", "value"}, [String]{"String", "Float", "Int?"})
    assert_eq(columns.len(), 3)
    assert_eq(columns[0].id, "column-ed14b1fd5790663e")
    assert_eq(columns[1].id, "column-52b8ce3bb4ec8b96")
    assert_eq(columns[2].id, "column-727bb12c67abeab0")
    assert(!columns[1].nullable)
    assert(columns[2].nullable)
}

fn file<T>(path: String, format: String, limits: DataLimits) -> DataLoader<T> DataError! {
    make_loader<T>(DataLoaderKind.File, path, "", [String]{}, format, "local", limits)
}

fn file_member<T>(path: String, member: String, format: String, limits: DataLimits) -> DataLoader<T> DataError! {
    make_loader<T>(DataLoaderKind.File, path, member, [String]{}, format, "local", limits)
}

fn url<T>(href: String, format: String, authority: String, limits: DataLimits) -> DataLoader<T> DataError! {
    make_loader<T>(DataLoaderKind.URL, href, "", [String]{}, format, authority, limits)
}

fn database<T>(query: String, parameters: [String], authority: String, limits: DataLimits) -> DataLoader<T> DataError! {
    make_loader<T>(DataLoaderKind.Database, query, "", parameters, "json", authority, limits)
}

fn value<T: Encode>(value: T, limits: DataLimits) -> DataLoader<T> DataError! {
    payload := [U8]{}
    data_loader_render(&payload, value.encode())
    data_loader_check_payload(limits, payload.len(), "data.value") ?? return Err(err)
    loader := make_loader<T>(DataLoaderKind.Value, "value", "", [String]{}, "json", "local", limits) ?? return Err(err)
    loader.payload = Val(payload)
    Ok(loader)
}

/// Infer a core format from the final path extension, without reading the
/// source. Query/fragment suffixes do not participate in format detection.
fn load_default<T>(locator: String) -[FS, Net, DB]> DataLoader<T> DataError! {
    load<T>(locator, DataLimits.safe())
}

fn load<T>(locator: String, limits: DataLimits) -[FS, Net, DB]> DataLoader<T> DataError! {
    format :: locator_format(locator)
    if locator.starts_with("http://") || locator.starts_with("https://") {
        if url<T>(locator, format, "network", limits) == {
            .Ok(loader) -> return Ok(loader)
            .Err(error) -> return Err(load_format_error(error, format))
        }
    }
    if file<T>(locator, format, limits) == {
        .Ok(loader) -> Ok(loader)
        .Err(error) -> Err(load_format_error(error, format))
    }
}

fn load_format_error(error: DataError, format: String) -> DataError Never! {
    if error.kind == .InvalidArgument && error.reason == "unknown data format" {
        return data_error(DataErrorKind.Bridge, "format `{format}` is provider-owned; import its package", "data.loader")
    }
    error.copy()
}

fn locator_format(locator: String) -> String DataError! {
    path :: locator.split("?").to_list()[0].split("#").to_list()[0]
    segments :: path.split("/").to_list()
    name :: segments[segments.len() - 1]
    parts :: name.split(".").to_list()
    if parts.len() < 2 {
        return Err(data_error(DataErrorKind.Bridge, "source has no core format; import a provider package", "data.load"))
    }
    parts[parts.len() - 1]
}

#Test("load discovers the final path extension before query and fragment") {
    local :: load_default<Int>("dir.with.dot/items.CSV?version=.json#part") ?? panic("local loader")
    assert_eq(local.source.locator, "dir.with.dot/items.CSV?version=.json#part")
    assert(local.format == .CSV)
    remote :: load_default<Int>("https://example.test/items.ndjson#part.json") ?? panic("remote loader")
    assert(remote.source.kind == .URL)
    assert(remote.format == .JSONL)
    assert_eq(remote.authority.scope, "network")
    assert_eq(remote.limits.max_output_rows, 1000000)
}

#Test("load does not infer a format from a directory or query") {
    if load_default<Int>("dir.csv/items?format=.json") == {
        .Ok(_) -> panic("extensionless source accepted")
        .Err(error) -> {
            assert(error.kind == .Bridge)
            assert_eq(error.operation, "data.load")
            assert_eq(error.reason, "source has no core format; import a provider package")
        }
    }
    if load_default<Int>("items.txt") == {
        .Ok(_) -> panic("provider format accepted")
        .Err(error) -> {
            assert(error.kind == .Bridge)
            assert_eq(error.operation, "data.loader")
            assert_eq(error.reason, "format `txt` is provider-owned; import its package")
        }
    }
}

// Typed CSV and JSON input report one DataError (kind Decode) that keeps
// every field failure of the codec decode.
fn data_decode_error(errors: [FieldError], operation: String) -> DataError Never! {
    reasons :: loop error in errors -> if error.path == "" -> error.reason else -> "{error.path}: {error.reason}"
    data_error(DataErrorKind.Decode, reasons.join("; "), operation)
}

fn csv<T: Decode>(text: String) -> [T] DataError! {
    csv_codec.decode<T>(text) ?? return Err(data_decode_error(err, "data.csv"))
}

fn json<T: Decode>(text: String) -> [T] DataError! {
    json_codec.decode<[T]>(text) ?? return Err(data_decode_error(err, "data.json"))
}

#Test("typed data JSON reuses exact number decoding") {
    rows :: json<Int>("[9007199254740993,1e2,-9007199254740993]") ?? panic("typed data JSON")
    assert_eq(rows, [Int]{9007199254740993, 100, -9007199254740993})
}

// Typed CSV rows over a consumed file (Rust `jet_data_csv_reader` and
// `jet_data_stream_scan`). The stream pulls one record at a time: the first
// record names the fields, and every later record must carry exactly that
// many. A row failure carries its 1-based data row and stays latched.
fn csv_reader<T: Decode>(reader: ^FileReader, limits: DataLimits) -[FS, IO]> DataStream<T> DataError! {
    data_limits_check(limits) ?? return Err(err)
    records :: csv_codec.reader(^reader, limits.encoding) ?? return Err(data_from_encoding("csv_reader", None, err))
    state :: shared __CSVRowSource{records: ^records, header: [String]{}, started: false, row: 0}
    source :: shared __StreamSource<T>{
        pull: () -> csv_reader_next<T>(state),
        max_output_rows: limits.max_output_rows,
        ahead: [T]{},
        ahead_index: 0,
        terminal: None,
        done: false,
    }
    Ok(DataStream<T>{items: [T]{}, index: 0, cancelled: false, __source: Val(source)})
}

// One pull of `csv_reader<T>`: the header on the first pull, then one data
// record decoded to `T`; `None` at end of input.
fn csv_reader_next<T: Decode>(state: Shared<__CSVRowSource>) -> T? DataError! {
    cell := state.guard_edit()
    if !cell.value.started {
        cell.value.started = true
        if &cell.value.records.next() == {
            .Ok(first) -> {
                named :: first ?? return Ok(None)
                cell.value.header = named.fields.copy()
            }
            .Err(failure) -> return Err(data_from_encoding("csv_reader", None, failure))
        }
    }
    if &cell.value.records.next() == {
        .Ok(next) -> {
            record :: next ?? return Ok(None)
            cell.value.row = cell.value.row + 1
            if csv_reader_row<T>(cell.value.header, record.fields, cell.value.row) == {
                .Ok(row) -> return Ok(Val(row))
                .Err(failure) -> return Err(failure)
            }
        }
        .Err(failure) -> return Err(data_from_encoding("csv_reader", Val(cell.value.row + 1), failure))
    }
}

// One data record as header-named Text cells (Rust
// `jet_data_stream_decode_csv_row`). The cells decode as text, so a
// `Float` field reads "10.0".
fn csv_reader_row<T: Decode>(header: [String], fields: [String], row: Int) -> T DataError! {
    if fields.len() != header.len() {
        error := data_error(DataErrorKind.Decode, "CSV row has {fields.len()} fields; expected {header.len()}", "csv_reader")
        error.row = Val(row)
        return Err(error)
    }
    entries := [(key: String, value: Dyn)]{}
    loop column in 0..<header.len() -> &entries.push((key: header[column].copy(), value: Dyn.Text(fields[column].copy())))
    tree :: encoding_stream.object_from_entries(^entries)
    previous :: encoding.__text_cells_enter()
    if tree.decode<T>() == {
        .Ok(value) -> {
            encoding.__text_cells_leave(previous)
            return Ok(value)
        }
        .Err(failures) -> {
            encoding.__text_cells_leave(previous)
            error := data_decode_error(failures, "csv_reader")
            error.row = Val(row)
            return Err(error)
        }
    }
}

// An encoding failure keeps its kind family, column and cause (Rust
// `jet_data_from_encoding`).
fn data_from_encoding(operation: String, row: Int?, cause: EncodingError) -> DataError Never! {
    kind :: if cause.kind == {
        .Limit -> DataErrorKind.Limit
        .IO -> DataErrorKind.IO
        .State -> DataErrorKind.State
        else -> DataErrorKind.Decode
    }
    DataError{kind: kind, operation: operation, row: row, column: cause.column, index: None, reason: cause.reason.copy(), cause: Val(cause)}
}

// The checked `DataLimits` of a reader or snapshot (Rust
// `jet_data_limits_validate`).
fn data_limits_check(limits: DataLimits) DataError! {
    if !valid_encoding_limits(limits.encoding) {
        return Err(data_error(DataErrorKind.Limit, "encoding limits are outside their safe ranges", "DataLimits"))
    }
    if limits.max_groups <= 0 || limits.max_sort_rows <= 0 || limits.max_join_rows <= 0 || limits.max_output_rows <= 0 {
        return Err(data_error(DataErrorKind.InvalidArgument, "data limits must be positive", "DataLimits"))
    }
    Ok(())
}

// Typed rows of one top-level JSON array over a consumed file (Rust
// `jet_data_json_reader` and the JSON arm of `jet_data_stream_scan`;
// core-library.md `json_reader<T: Decode>(reader, limits)`). Numbers keep
// their typed lexemes, each array element folds to one tree under the
// reader's allocation budget, and a failure stays latched.
fn json_reader<T: Decode>(reader: ^FileReader, limits: DataLimits) -[FS, IO]> DataStream<T> DataError! {
    data_limits_check(limits) ?? return Err(err)
    parser := encoding_stream.json_reader(^reader, limits.encoding, false) ?? return Err(data_from_encoding("json_reader", None, err))
    parser.typed_numbers = true
    state :: shared __JSONRowSource{parser: ^parser, array_started: false, array_done: false, row: 0}
    source :: shared __StreamSource<T>{
        pull: () -> json_reader_next<T>(state),
        max_output_rows: limits.max_output_rows,
        ahead: [T]{},
        ahead_index: 0,
        terminal: None,
        done: false,
    }
    Ok(DataStream<T>{items: [T]{}, index: 0, cancelled: false, __source: Val(source)})
}

// One pull of `json_reader<T>`: the opening `[` on the first pull, then one
// array element decoded to `T`; `None` at the closing `]` or end of input.
fn json_reader_next<T: Decode>(state: Shared<__JSONRowSource>) -> T? DataError! {
    cell := state.guard_edit()
    if cell.value.array_done -> return Ok(None)
    if !cell.value.array_started {
        if &cell.value.parser.next() == {
            .Ok(next) -> {
                opened :: next ?? return Ok(None)
                if opened != .ArrayStart {
                    return Err(data_error(DataErrorKind.Decode, "typed JSON stream requires a top-level array of objects", "json_reader"))
                }
                cell.value.array_started = true
            }
            .Err(failure) -> return Err(data_from_encoding("json_reader", None, failure))
        }
    }
    first :: if &cell.value.parser.next() == {
        .Ok(next) -> next
        .Err(failure) -> {
            return Err(data_from_encoding("json_reader", Val(cell.value.row + 1), failure))
        }
    }
    event :: first ?? {
        cell.value.array_done = true
        return Ok(None)
    }
    if event == .ArrayEnd {
        cell.value.array_done = true
        return Ok(None)
    }
    heap := encoding_stream.FoldBudget{decoded: 0, tracked: 0}
    tree :: if &cell.value.parser.fold(^event, &heap) == {
        .Ok(folded) -> folded
        .Err(failure) -> {
            cell.value.parser.allocation.release(heap.tracked)
            return Err(data_from_encoding("json_reader", Val(cell.value.row + 1), failure))
        }
    }
    cell.value.parser.allocation.release(heap.tracked)
    cell.value.row = cell.value.row + 1
    if tree.decode<T>() == {
        .Ok(value) -> Ok(Val(value))
        .Err(failures) -> {
            error := data_decode_error(failures, "json_reader")
            error.row = Val(cell.value.row)
            Err(error)
        }
    }
}

// A typed snapshot of a loader's payload (Rust `jet_data_loader_snapshot`
// with the Foundation `PreludeDataFlow` kernel; core-library.md
// `snapshot(loader)`, line 3045). The payload
// is the bound bytes, the offline/value last-good bytes, or the local file;
// it parses by format, decodes to `T`, and commits as the new last-good
// snapshot. Any failure is recorded in the loader status before it returns.
fn snapshot<T: [Encode, Decode]>(loader: &DataLoader<T>) -[FS, Net, DB]> DataSnapshot<T> DataError! {
    if loader.cancelled {
        return Err(data_loader_fail<T>(&loader, data_loader_error(DataErrorKind.State, "data.loader", "loader was cancelled before snapshot")))
    }
    data_loader_validate<T>(loader) ?? return Err(data_loader_fail<T>(&loader, err))
    data_limits_check(loader.limits) ?? return Err(data_loader_fail<T>(&loader, err))
    payload :: data_loader_payload<T>(loader) ?? return Err(data_loader_fail<T>(&loader, err))
    tree :: data_loader_tree(payload.data, loader.format, loader.limits) ?? return Err(data_loader_fail<T>(&loader, err))
    value :: if data_loader_decode<T>(tree, loader.format == DataFormat.CSV) == {
        .Ok(result) -> result
        .Err(failures) -> {
            reasons :: loop failure in failures -> if failure.path == "" -> failure.reason else -> "{failure.path}: {failure.reason}"
            return Err(data_loader_fail<T>(&loader, data_loader_error(DataErrorKind.Decode, "data.loader", reasons.join("; "))))
        }
    }
    canonical := [U8]{}
    data_loader_render(&canonical, value.encode())
    schema := data_loader_schema(tree, loader.format)
    schema.identity = data_loader_digest(schema.identity.bytes())
    provenance_source :: loader.source.copy()
    provenance_authority :: loader.authority.copy()
    provenance_format :: loader.format
    provenance :: DataProvenance{source: provenance_source, format: provenance_format, authority: provenance_authority}
    // PreludeDataFlow::commit_snapshot
    data_loader_check_payload(loader.limits, canonical.len(), "data.snapshot") ?? return Err(data_loader_fail<T>(&loader, err))
    content_id :: data_loader_digest(canonical)
    source_material := ""
    source_material = data_loader_identity_part(source_material, data_loader_kind_text(loader.source.kind))
    source_material = data_loader_identity_part(source_material, loader.source.locator)
    source_material = data_loader_identity_part(source_material, loader.source.member)
    loop parameter in loader.source.parameters -> source_material = data_loader_identity_part(source_material, parameter)
    source_material = data_loader_identity_part(source_material, loader.authority.scope)
    source_material = data_loader_identity_part(source_material, loader.authority.revision)
    source_id :: data_loader_digest(source_material.bytes())
    snapshot_material := ""
    snapshot_material = data_loader_identity_part(snapshot_material, source_id)
    snapshot_material = data_loader_identity_part(snapshot_material, content_id)
    snapshot_material = data_loader_identity_part(snapshot_material, schema.identity)
    snapshot_material = data_loader_identity_part(snapshot_material, data_format_text(loader.format))
    snapshot_id :: data_loader_digest(snapshot_material.bytes())
    loader.status = DataLoaderStatus{
        identity: "snapshot-{snapshot_id}",
        freshness: if payload.offline -> DataFreshness.Offline else -> DataFreshness.Fresh,
        invalidated_by: if payload.offline -> loader.status.invalidated_by.copy() else -> DataInvalidationCause.NoCause,
        error: "",
        cleanup: "retained",
        buffered_bytes: 0,
        backpressure: false,
        last_good: true,
    }
    loader.last_good = Val(payload.data.copy())
    loader.payload = None
    identity :: DataSnapshotIdentity{
        id: "snapshot-{snapshot_id}",
        source: "source-{source_id}",
        content: content_id,
        schema: schema.identity.copy(),
        format: loader.format,
    }
    Ok(DataSnapshot<T>{value: value, identity: identity, provenance: provenance, schema: schema, status: loader.status.copy(), content: canonical})
}

fn count<T>(rows: [T]) -> Int Never! { rows.len() }

fn describe(values: [Float]) -> DataSummary DataError! {
    if values.len() == 0 -> return Err(data_error(DataErrorKind.Empty, "describe of empty data is undefined", "describe"))
    total := Float{0.0}
    if compensated_sum(values, "describe") == {
        .Ok(value) -> total = value
        .Err(error) -> return Err(error)
    }
    mean_value := total / Float{values.len()}
    if nonfinite(mean_value) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while computing mean", "describe"))
    minimum :: min(values) ?? return Err(data_error(DataErrorKind.NonFinite, "minimum failed while describing data", "describe"))
    maximum :: max(values) ?? return Err(data_error(DataErrorKind.NonFinite, "maximum failed while describing data", "describe"))
    middle :: median(values) ?? return Err(data_error(DataErrorKind.Empty, "median failed while describing data", "describe"))
    spread := Float{0.0}
    if variance(values) == {
        .Ok(value) -> spread = value
        .Err(error) -> return Err(error)
    }
    deviation := math.sqrt(spread)
    if nonfinite(deviation) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while computing standard deviation", "describe"))
    Ok(DataSummary{
        count: values.len(),
        sum: total,
        mean: normalize_zero(mean_value),
        min: normalize_zero(minimum),
        max: normalize_zero(maximum),
        median: normalize_zero(middle),
        variance: normalize_zero(spread),
        stddev: normalize_zero(deviation),
    })
}


fn sum(values: [Float]) -> Float DataError! {
    compensated_sum(values, "sum")
}

fn mean(values: [Float]) -> Float DataError! {
    if values.len() == 0 -> return Err(data_error(DataErrorKind.Empty, "mean of empty data is undefined", "mean"))
    total := Float{0.0}
    // Rust `jet_data_mean_checked` reports its summation failures as `sum`.
    if compensated_sum(values, "sum") == {
        .Ok(value) -> total = value
        .Err(error) -> return Err(error)
    }
    mean_value := total / Float{values.len()}
    if nonfinite(mean_value) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while computing mean", "mean"))
    Ok(normalize_zero(mean_value))
}

fn min(values: [Float]) -> Float DataError! {
    if values.len() == 0 -> return Err(data_error(DataErrorKind.Empty, "min of empty data is undefined", "min"))
    first :: values[0]
    if nonfinite(first) -> return Err(data_error(DataErrorKind.NonFinite, "numeric input must be finite", "min"))
    out := first
    loop value in values {
        if nonfinite(value) -> return Err(data_error(DataErrorKind.NonFinite, "numeric input must be finite", "min"))
        if value < out -> out = value
    }
    Ok(normalize_zero(out))
}

fn max(values: [Float]) -> Float DataError! {
    if values.len() == 0 -> return Err(data_error(DataErrorKind.Empty, "max of empty data is undefined", "max"))
    first :: values[0]
    if nonfinite(first) -> return Err(data_error(DataErrorKind.NonFinite, "numeric input must be finite", "max"))
    out := first
    loop value in values {
        if nonfinite(value) -> return Err(data_error(DataErrorKind.NonFinite, "numeric input must be finite", "max"))
        if value > out -> out = value
    }
    Ok(normalize_zero(out))
}

fn variance(values: [Float]) -> Float DataError! {
    if values.len() == 0 -> return Err(data_error(DataErrorKind.Empty, "variance of empty data is undefined", "variance"))
    mean_value := Float{0.0}
    m2 := Float{0.0}
    n := Float{0.0}
    loop value in values {
        if nonfinite(value) -> return Err(data_error(DataErrorKind.NonFinite, "numeric input must be finite", "variance"))
        n = n + Float{1.0}
        delta := value - mean_value
        mean_value = mean_value + delta / n
        delta2 := value - mean_value
        m2 = m2 + delta * delta2
        if nonfinite(mean_value) || nonfinite(m2) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while computing variance", "variance"))
    }
    if m2 < (Float{0.0}) -> m2 = Float{0.0}
    result := m2 / n
    if nonfinite(result) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while computing variance", "variance"))
    Ok(normalize_zero(result))
}

fn stddev(values: [Float]) -> Float DataError! {
    value := Float{0.0}
    if variance(values) == {
        .Ok(result) -> value = result
        .Err(error) -> return Err(error)
    }
    result := math.sqrt(value)
    if nonfinite(result) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while computing standard deviation", "stddev"))
    Ok(normalize_zero(result))

}

fn median(values: [Float]) -> Float DataError! {
    quantile(values, Float{0.5})
}

fn quantile(values: [Float], q: Float) -> Float DataError! {
    if nonfinite(q) || q < (Float{0.0}) || q > (Float{1.0}) {
        return Err(data_error(DataErrorKind.InvalidArgument, "quantile q must be a finite value in 0.0 through 1.0", "quantile"))
    }
    if values.len() == 0 -> return Err(data_error(DataErrorKind.Empty, "quantile of empty data is undefined", "quantile"))
    limits := DataLimits.safe()
    if values.len() > limits.max_sort_rows -> return Err(data_error(DataErrorKind.Limit, "max_sort_rows exceeded", "quantile"))
    loop value in values {
        if nonfinite(value) -> return Err(data_error(DataErrorKind.NonFinite, "numeric input must be finite", "quantile"))
    }
    sorted := sort_floats(values)
    pos := q * Float{sorted.len() - 1}
    lo := Int.from_float(pos) ?? panic("quantile position must be finite")
    hi := lo
    if (Float{lo}) < pos -> hi = lo + 1
    if hi >= sorted.len() -> hi = sorted.len() - 1
    if lo == hi -> return Ok(normalize_zero(sorted[lo]))
    frac := pos - Float{lo}
    result := sorted[lo] * (Float{1.0} - frac) + sorted[hi] * frac
    if nonfinite(result) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while interpolating quantile", "quantile"))
    Ok(normalize_zero(result))
}

fn rolling_mean(values: [Float], window: Int) -> [Float] DataError! {
    if window < 1 -> return Err(data_error(DataErrorKind.InvalidArgument, "rolling width must be positive", "rolling_mean"))
    limits := DataLimits.safe()
    if values.len() > limits.max_output_rows -> return Err(data_error(DataErrorKind.Limit, "max_output_rows exceeded", "rolling_mean"))
    loop index in 0..<values.len() {
        if nonfinite(values[index]) {
            return Err(data_error_at(DataErrorKind.NonFinite, "numeric input must be finite", "rolling_mean", index))
        }
    }
    out := [Float]{}
    loop i in 0..<values.len() {
        start := 0
        if window < i + 1 -> start = i - window + 1
        total := Float{0.0}
        if compensated_sum_range(values, start, i + 1, "rolling_mean") == {
            .Ok(value) -> total = value
            .Err(error) -> return Err(error)
        }
        n := i + 1 - start
        mean_value := total / Float{n}
        if nonfinite(mean_value) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while computing rolling mean", "rolling_mean"))
        &out.push(normalize_zero(mean_value))
    }
    Ok(out)
}

fn inner_join<T, U>(left: [T], right: [U], left_key: fn(T) -> String, right_key: fn(U) -> String) -> [DataJoin<T, U>] DataError! {
    limits := DataLimits.safe()
    left_keys := [String]{}
    right_keys := [String]{}
    loop row in left {
        key :: left_key(row) ?? return Err(data_error(DataErrorKind.Decode, "left join key failed", "inner_join"))
        &left_keys.push(key)
    }
    loop row in right {
        key :: right_key(row) ?? return Err(data_error(DataErrorKind.Decode, "right join key failed", "inner_join"))
        &right_keys.push(key)
    }
    // The output cardinality is known from per-key counts before any row is
    // built, so a limit breach costs O(left + right) rather than one push per
    // row up to max_join_rows.
    right_counts :: join_key_counts(right_keys)
    total := 0
    loop key in left_keys {
        total += right_counts.get(key) ?? 0
        if total > limits.max_join_rows {
            return Err(data_error(DataErrorKind.Limit, "max_join_rows exceeded", "inner_join"))
        }
    }
    out := [DataJoin<T, U>]{}
    loop left_index in 0..<left.len() {
        if (right_counts.get(left_keys[left_index]) ?? 0) == 0 -> next
        loop right_index in 0..<right.len() {
            if left_keys[left_index] != right_keys[right_index] -> next
            &out.push(DataJoin<T, U>{left: left[left_index], right: right[right_index]})
        }
    }
    if out.len() > limits.max_output_rows {
        return Err(data_error(DataErrorKind.Limit, "max_output_rows exceeded", "inner_join"))
    }
    Ok(out)
}

fn left_join<T, U>(left: [T], right: [U], left_key: fn(T) -> String, right_key: fn(U) -> String) -> [DataJoin<T, U?>] DataError! {
    limits := DataLimits.safe()
    left_keys := [String]{}
    right_keys := [String]{}
    loop row in left {
        key :: left_key(row) ?? return Err(data_error(DataErrorKind.Decode, "left join key failed", "left_join"))
        &left_keys.push(key)
    }
    loop row in right {
        key :: right_key(row) ?? return Err(data_error(DataErrorKind.Decode, "right join key failed", "left_join"))
        &right_keys.push(key)
    }
    // Every left row yields at least one output row; see inner_join.
    right_counts :: join_key_counts(right_keys)
    total := 0
    loop key in left_keys {
        matches := right_counts.get(key) ?? 0
        if matches == 0 -> matches = 1
        total += matches
        if total > limits.max_join_rows {
            return Err(data_error(DataErrorKind.Limit, "max_join_rows exceeded", "left_join"))
        }
    }
    out := [DataJoin<T, U?>]{}
    loop left_index in 0..<left.len() {
        if (right_counts.get(left_keys[left_index]) ?? 0) == 0 {
            &out.push(DataJoin<T, U?>{left: left[left_index], right: None})
            next
        }
        loop right_index in 0..<right.len() {
            if left_keys[left_index] != right_keys[right_index] -> next
            &out.push(DataJoin<T, U?>{left: left[left_index], right: Val(right[right_index])})
        }
    }
    if out.len() > limits.max_output_rows {
        return Err(data_error(DataErrorKind.Limit, "max_output_rows exceeded", "left_join"))
    }
    Ok(out)
}

fn join_key_counts(keys: [String]) -> [String:Int] Never! {
    counts := [String:Int]{}
    loop key in keys {
        seen :: counts.get(key) ?? 0
        _ :: &counts.add(key, seen + 1)
    }
    counts
}

fn pivot_sum<T>(rows: [T], row_key: fn(T) -> String, column_key: fn(T) -> String, value_fn: fn(T) -> Float) -> [DataPivotCell] DataError! {
    limits := DataLimits.safe()
    cells := [DataPivotCell]{}
    loop index in 0..<rows.len() {
        row := rows[index]
        row_name :: row_key(row) ?? return Err(data_error(DataErrorKind.Decode, "pivot row key failed", "pivot_sum"))
        column_name :: column_key(row) ?? return Err(data_error(DataErrorKind.Decode, "pivot column key failed", "pivot_sum"))
        amount :: value_fn(row) ?? return Err(data_error(DataErrorKind.Decode, "pivot value failed", "pivot_sum"))
        if nonfinite(amount) {
            return Err(data_error_at(DataErrorKind.NonFinite, "pivot values must be finite", "pivot_sum", index))
        }
        found := -1
        loop cell_index in 0..<cells.len() {
            if text_compare(cells[cell_index].row_key, row_name) == 0 && text_compare(cells[cell_index].column_key, column_name) == 0 {
                found = cell_index
                break
            }
        }
        if found < 0 {
            if cells.len() >= limits.max_groups {
                return Err(data_error(DataErrorKind.Limit, "max_groups exceeded", "pivot_sum"))
            }
            &cells.push(DataPivotCell{row_key: row_name, column_key: column_name, count: 1, sum: amount.copy(), mean: amount})
            next
        }
        cell := cells[found]
        cell.count = cell.count + 1
        cell.sum = cell.sum + amount
        if nonfinite(cell.sum) {
            return Err(data_error(DataErrorKind.Overflow, "finite overflow while pivoting", "pivot_sum"))
        }
        cells[found] = cell
    }
    if cells.len() > limits.max_output_rows {
        return Err(data_error(DataErrorKind.Limit, "max_output_rows exceeded", "pivot_sum"))
    }
    loop index in 0..<cells.len() {
        cell := cells[index]
        cell.mean = cell.sum / Float{cell.count}
        if nonfinite(cell.mean) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while pivoting", "pivot_sum"))
        cell.sum = normalize_zero(cell.sum)
        cell.mean = normalize_zero(cell.mean)
        cells[index] = cell
    }
    _ :: sort_pivot_cells(&cells)
    Ok(cells)
}

fn plot<T: Encode>(rows: [T]) -> JetDataPlot<T> DataError! {
    core.data.plot<T>(rows)
}

fn inspect<T>(plot: JetDataPlot<T>) -> JetDataPlotInspection DataError! {
    plan :: normalize_plot_plan(plot.plan)
    Ok(JetDataPlotInspection{text: plot_inspection_text(plan, plot.rows.len())})
}

fn inspect_json<T>(plot: JetDataPlot<T>) -> String DataError! {
    plan :: normalize_plot_plan(plot.plan)
    Ok(plot_plan_json(plan))
}

fn text<T>(plot: JetDataPlot<T>) -> String DataError! {
    plan :: normalize_plot_plan(plot.plan)
    Ok(render_plot_text(plan))
}

fn svg<T>(plot: JetDataPlot<T>) -> String DataError! {
    plan :: normalize_plot_plan(plot.plan)
    Ok(render_plot_svg(plan))
}

fn show<T>(plot: JetDataPlot<T>) -> JetDataPlotRender DataError! {
    render<T>(plot, JetDataPlotBackend.Browser)
}

fn render<T>(plot: JetDataPlot<T>, backend: JetDataPlotBackend) -> JetDataPlotRender DataError! {
    plan :: normalize_plot_plan(plot.plan)
    if backend == JetDataPlotBackend.Terminal {
        return Ok(JetDataPlotRender{format: JetDataPlotRenderFormat.Text, body: render_plot_text(plan)})
    }
    Ok(JetDataPlotRender{format: JetDataPlotRenderFormat.SVG, body: render_plot_svg(plan)})
}

// One row per group: the key, a bar of one `#` per count (at most 40), then
// the count.
fn bar_text(groups: [Group<String, Int>]) -> String DataError! {
    _ :: validate_bar_counts(groups, "bar_text")
    out := ""
    loop index in 0..<groups.len() {
        group :: groups[index]
        width :: if group.value > 40 -> 40 else -> group.value
        bar := ""
        loop _ in 0..<width -> bar = "{bar}#"
        if index > 0 -> out = "{out}\n"
        out = "{out}{group.key} | {bar} {group.value}"
    }
    Ok(out)
}

// A 320-wide chart: one 24px row per group, bars scaled to the largest count
// over 200px, the count printed after each bar.
fn bar_svg(groups: [Group<String, Int>]) -> String DataError! {
    _ :: validate_bar_counts(groups, "bar_svg")
    height :: 24 + 24 * groups.len()
    maximum := 1
    loop group in groups {
        if group.value > maximum -> maximum = group.value
    }
    out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"320\" height=\"{height}\" viewBox=\"0 0 320 {height}\"><rect width=\"320\" height=\"100%\" fill=\"white\"/>"
    loop index in 0..<groups.len() {
        group :: groups[index]
        y :: 18 + index * 24
        bar_width :: math.round(Float{group.value} / Float{maximum} * Float{200.0})
        out = "{out}<text x=\"8\" y=\"{y}\" font-family=\"monospace\" font-size=\"12\">{xml_escape(group.key)}</text>"
        out = "{out}<rect x=\"96\" y=\"{y - 12}\" width=\"{bar_width}\" height=\"14\" fill=\"#2f6f73\"/>"
        out = "{out}<text x=\"{104 + bar_width}\" y=\"{y}\" font-family=\"monospace\" font-size=\"12\">{group.value}</text>"
    }
    Ok("{out}</svg>")
}

fn validate_bar_counts(groups: [Group<String, Int>], operation: String) DataError! {
    loop index in 0..<groups.len() {
        if groups[index].value < 0 {
            return Err(data_error_at(DataErrorKind.InvalidArgument, "plot counts must be non-negative", operation, index))
        }
    }
    Ok()
}

fn line_text(groups: [Group<String, Float>], options: DataLineOptions) -> String DataError! {
    _ :: validate_line_options(options, "line_text")
    labels := [String]{}
    values := [Float]{}
    loop index in 0..<groups.len() {
        group :: groups[index]
        if nonfinite(group.value) {
            return Err(data_error_at(DataErrorKind.NonFinite, "plot values must be finite", "line_text", index))
        }
        &labels.push(group.key)
        &values.push(group.value)
    }
    Ok(render_line_options_text(labels, values, options))
}

fn line_svg(groups: [Group<String, Float>], options: DataLineOptions) -> String DataError! {
    _ :: validate_line_options(options, "line_svg")
    labels := [String]{}
    values := [Float]{}
    loop index in 0..<groups.len() {
        group :: groups[index]
        if nonfinite(group.value) {
            return Err(data_error_at(DataErrorKind.NonFinite, "plot values must be finite", "line_svg", index))
        }
        &labels.push(group.key)
        &values.push(group.value)
    }
    Ok(render_line_options_svg(labels, values, options))
}

/// Native facts and live, explicitly opted-in bridge availability.
fn status() -[FS, Env]> [DataStatus] Never! {
    rows := [DataStatus]{}
    native_steps :: [String]{"core.data.csv", "core.data.stats", "core.data.query", "core.data.stream", "core.data.schema", "core.data.json"}
    loop step in native_steps {
        &rows.push(DataStatus{step: step, path: "native", clone_value: "none", ownership: "jet", trust: "native", fallback: "none", replacement: "native"})
    }
    bridge_steps :: [String]{"py.*", "r.*", "gpu.*"}
    loop step in bridge_steps -> &rows.push(bridge_status(step))
    rows
}

fn require_bridge(provider: String) DataError! -[FS, Env]> {
    step :: bridge_provider(provider) ?? return Err(data_error(DataErrorKind.InvalidArgument, "unknown data bridge provider `{provider}`; expected py, r, or gpu", "require_bridge"))
    facts :: bridge_status(step)
    if facts.path == "available" -> return Ok(())
    return Err(data_error(DataErrorKind.Bridge, "{step} unavailable (clone_value={facts.clone_value}, ownership={facts.ownership}, trust={facts.trust}, fallback={facts.fallback}, replacement={facts.replacement})", "require_bridge"))
}

fn bridge_provider(provider: String) -> String? Never! {
    name := trim(provider)
    loop name.ends_with(".") -> name = String.from_bytes(name.bytes()[0..<name.bytes().len() - 1]) ?? ""
    if name.ends_with(".*") -> name = String.from_bytes(name.bytes()[0..<name.bytes().len() - 2]) ?? ""
    name = upper(name)
    if name == "PY" || name == "PYTHON" -> return Val("py.*")
    if name == "R" -> return Val("r.*")
    if name == "GPU" || name == "CUDA" || name == "METAL" || name == "VULKAN" || name == "WEBGPU" -> return Val("gpu.*")
    None
}

fn bridge_status(step: String) -[FS, Env]> DataStatus Never! {
    path := "unavailable"
    if step == "r.*" && bridge_tool_on_path("Rscript") {
        if sys.get("JET_DATA_R_BRIDGE") == .Val(enabled) {
            if enabled == "1" -> path = "available"
        }
    }
    if step == "py.*" -> return DataStatus{step: step, path: path, clone_value: "owned-copy", ownership: "python-sidecar", trust: "untrusted-foreign", fallback: "none", replacement: "core.data native lists/query/stats"}
    if step == "r.*" -> return DataStatus{step: step, path: path, clone_value: "owned-copy", ownership: "r-sidecar", trust: "untrusted-foreign", fallback: "none", replacement: "core.data Query<T> typed round-trip"}
    DataStatus{step: step, path: path, clone_value: "device-transfer", ownership: "device-buffer", trust: "untrusted-accelerator", fallback: "none", replacement: "core.data / Tensor native CPU path"}
}

fn bridge_tool_on_path(tool: String) -[FS, Env]> Bool Never! {
    // Keep opaque native path bytes: PATH need not be UTF-8.
    path :: core.sys.__host_env("PATH") ?? return false
    windows :: sys.is_windows()
    delimiter :: if windows -> U8{59} else -> U8{58}
    directory := [U8]{}
    quoted := false
    index := 0
    loop {
        at_end :: index == path.len()
        if !at_end {
            b :: path[index]
            index += 1
            if windows && b == (U8{34}) {
                quoted = !quoted
                next
            }
            if b != delimiter || quoted {
                &directory.push(b)
                next
            }
        }
        if directory.len() > 0 {
            last :: directory[directory.len() - 1]
            drive_relative :: windows && directory.len() == 2 && directory[1] == (U8{58})
            if last != (U8{47}) && (!windows || last != (U8{92})) && !drive_relative {
                &directory.push(if windows -> U8{92} else -> U8{47})
            }
        }
        loop b in tool.bytes() -> &directory.push(b)
        is_file := false
        #Unsafe("native path bytes originate from the host environment and are split at ASCII boundaries") {
            is_file = core.data.__host_path_is_file(directory) ?? false
        }
        if is_file -> return true
        if at_end -> break
        directory = [U8]{}
    }
    false
}

fn make_loader<T>(kind: DataLoaderKind, locator: String, member: String, parameters: [String], format_name: String, authority_name: String, limits: DataLimits) -> DataLoader<T> DataError! {
    if !valid_encoding_limits(limits.encoding) {
        return Err(data_error(DataErrorKind.Limit, "encoding limits are outside their safe ranges", "data.loader"))
    }
    if limits.max_groups <= 0 || limits.max_sort_rows <= 0 || limits.max_join_rows <= 0 || limits.max_output_rows <= 0 {
        return Err(data_error(DataErrorKind.InvalidArgument, "data limits must be positive", "data.loader"))
    }
    if !valid_public_text(locator, false) {
        return Err(data_error(DataErrorKind.InvalidArgument, "source locator is invalid", "data.loader"))
    }
    if member.len() > 0 && !valid_public_text(member, false) {
        return Err(data_error(DataErrorKind.InvalidArgument, "archive member is invalid", "data.loader"))
    }
    if kind != DataLoaderKind.File && member.len() > 0 {
        return Err(data_error(DataErrorKind.InvalidArgument, "only file loaders may carry an archive member", "data.loader"))
    }
    loop parameter in parameters {
        if !valid_public_text(parameter, true) {
            return Err(data_error(DataErrorKind.InvalidArgument, "loader parameter is invalid", "data.loader"))
        }
    }
    if !valid_public_text(authority_name, false) || !valid_authority(authority_name) {
        return Err(data_error(DataErrorKind.InvalidArgument, "loader authority is invalid", "data.loader"))
    }
    format :: parse_format(format_name) ?? return Err(data_error(DataErrorKind.InvalidArgument, "unknown data format", "data.loader"))
    source := DataSourceIdentity{kind: kind, locator: public_locator(kind, locator), member: member, parameters: public_parameters(parameters)}
    authority := DataAuthority{scope: authority_name.copy(), revision: ""}
    status := DataLoaderStatus{
        identity: "",
        freshness: DataFreshness.Pending,
        invalidated_by: .NoCause,
        error: "",
        cleanup: "none",
        buffered_bytes: 0,
        backpressure: false,
        last_good: false,
    }
    Ok(DataLoader<T>{
        source: source,
        format: format,
        authority: authority,
        limits: limits,
        payload: None,
        last_good: None,
        cancelled: false,
        offline: false,
        status: status,
    })
}

fn public_parameters(values: [String]) -> [String] Never! {
    out := [String]{}
    loop value in values -> &out.push(public_parameter(value))
    out
}

fn public_parameter(value: String) -> String Never! {
    normalized := trim(value)
    if normalized.len() == 0 -> return ""
    parts :: normalized.split("=").to_list()
    if parts.len() < 2 -> return "value-{sha256(normalized.bytes()).hex()}"
    key :: trim(parts[0])
    if key.len() == 0 -> return "value-{sha256(normalized.bytes()).hex()}"
    parameter_value :: parts[1]
    upper_key :: upper(key)
    upper_value :: upper(parameter_value)
    sensitive_key := upper_key.contains("PASSWORD") || upper_key.contains("PASSWD") || upper_key.contains("PWD") || upper_key.contains("SECRET") || upper_key.contains("TOKEN") || upper_key.contains("CREDENTIAL") || upper_key.contains("AUTH") || upper_key.contains("API_KEY") || upper_key.contains("APIKEY") || upper_key.contains("ACCESS_KEY") || upper_key.contains("ACCESS-TOKEN") || upper_key.contains("SIGNATURE") || upper_key.contains("COOKIE") || upper_key.contains("SESSION") || upper_key.contains("PRIVATE_KEY") || upper_key.contains("PRIVATE-KEY") || upper_key.contains("BEARER")
    sensitive_value := upper_value.starts_with("BEARER ") || upper_value.starts_with("BASIC ") || upper_value.starts_with("-----BEGIN") || upper_value.starts_with("PASSWORD=") || upper_value.starts_with("SECRET=") || upper_value.starts_with("TOKEN=") || upper_value.starts_with("CREDENTIAL=") || upper_value.starts_with("AUTHORIZATION=")
    if sensitive_key || sensitive_value -> return "{key}=<redacted>"
    normalized
}

fn public_locator(kind: DataLoaderKind, locator: String) -> String Never! {
    if kind == DataLoaderKind.Database -> return "query-{sha256(locator.bytes()).hex()}"
    if kind != DataLoaderKind.URL -> return locator.copy()
    fragment_parts :: locator.split("#").to_list()
    without_fragment :: fragment_parts[0]
    query_parts :: without_fragment.split("?").to_list()
    base := query_parts[0]
    scheme_parts :: base.split("://").to_list()
    if scheme_parts.len() > 1 {
        path_parts :: scheme_parts[1].split("/").to_list()
        authority_parts :: path_parts[0].split("@").to_list()
        authority :: authority_parts[authority_parts.len() - 1]
        base = "{scheme_parts[0]}://{authority}"
        loop i in 1..<path_parts.len() -> base = "{base}/{path_parts[i]}"
    }
    if query_parts.len() == 1 -> return base
    public_query := [String]{}
    loop parameter in query_parts[1].split("&") -> &public_query.push(public_parameter(parameter))
    "{base}?{public_query.join("&")}"
}

fn valid_encoding_limits(limits: EncodingLimits) -> Bool Never! {
    if limits.buffer_bytes < 4096 || limits.buffer_bytes > 16777216 -> return false
    if limits.max_depth < 1 || limits.max_depth > 4096 -> return false
    if limits.max_item_bytes < 1 || limits.max_item_bytes > 1073741824 -> return false
    if limits.max_total_bytes != None {
        total :: limits.max_total_bytes ?? 0
        if total < 0 -> return false
    }
    if limits.max_expansion_depth < 0 || limits.max_expansion_depth > 256 -> return false
    if limits.max_expansion_bytes < 0 || limits.max_expansion_bytes > 1073741824 -> return false
    true
}

fn valid_public_text(text: String, allow_empty: Bool) -> Bool Never! {
    raw :: text.bytes()
    if raw.len() == 0 -> return allow_empty
    if raw.len() > 4096 -> return false
    has_nonspace := false
    loop byte in raw {
        if byte < (U8{32}) || byte == (U8{127}) -> return false
        if byte != (U8{32}) -> has_nonspace = true
    }
    has_nonspace
}

fn valid_authority(text: String) -> Bool Never! {
    normalized := upper(text)
    if normalized.starts_with("BEARER ") || normalized.starts_with("BASIC ") -> return false
    if normalized.starts_with("PASSWORD=") || normalized.starts_with("SECRET=") || normalized.starts_with("TOKEN=") || normalized.starts_with("CREDENTIAL=") || normalized.starts_with("AUTHORIZATION=") -> return false
    loop byte in text.bytes() {
        if byte == (U8{61}) || byte == (U8{38}) -> return false
    }
    true
}

fn parse_format(name: String) -> DataFormat? Never! {
    normalized := upper(name)
    if normalized == {
        "CSV" -> Val(DataFormat.CSV)
        "JSON" -> Val(DataFormat.JSON)
        "JSONL" -> Val(DataFormat.JSONL)
        "NDJSON" -> Val(DataFormat.JSONL)
        "PARQUET" -> Val(DataFormat.Parquet)
        "ARROW" -> Val(DataFormat.Arrow)
        "ARROW-IPC" -> Val(DataFormat.Arrow)
        "FEATHER" -> Val(DataFormat.Arrow)
        else -> None
    }
}


fn normalize_zero(value: Float) -> Float Never! {
    if value == (Float{0.0}) -> return Float{0.0}
    value
}

fn compensated_sum(values: [Float], operation: String) -> Float DataError! {
    compensated_sum_range(values, 0, values.len(), operation)
}

fn compensated_sum_range(values: [Float], start: Int, end: Int, operation: String) -> Float DataError! {
    total := Float{0.0}
    correction := Float{0.0}
    loop index in start..<end {
        value :: values[index]
        if nonfinite(value) {
            return Err(data_error_at(DataErrorKind.NonFinite, "numeric input must be finite", operation, index))
        }
        next_total := total + value
        // Rust `jet_data_neumaier_sum`: the lost low part is formed before it
        // joins the running correction.
        if math.fabs(total) >= math.fabs(value) {
            correction = correction + ((total - next_total) + value)
        } else {
            correction = correction + ((value - next_total) + total)
        }
        total = next_total
        if nonfinite(total) || nonfinite(correction) {
            return Err(data_error(DataErrorKind.Overflow, "finite overflow while summing", operation))
        }
    }
    result := total + correction
    if nonfinite(result) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while summing", operation))
    Ok(normalize_zero(result))
}
fn sort_pivot_cells(cells: &[DataPivotCell]) Never! {
    loop i in 1..<cells.len() {
        j := i
        loop j > 0 {
            if !pivot_before(cells[j], cells[j - 1]) -> break
            current := cells[j]
            cells[j] = cells[j - 1]
            cells[j - 1] = current
            j = j - 1
        }
    }
}

fn pivot_before(left: DataPivotCell, right: DataPivotCell) -> Bool Never! {
    row_order := text_compare(left.row_key, right.row_key)
    if row_order < 0 -> return true
    if row_order > 0 -> return false
    text_compare(left.column_key, right.column_key) < 0
}

fn text_compare(left: String, right: String) -> Int Never! {
    a :: left.bytes()
    b :: right.bytes()
    n := a.len()
    if b.len() < n -> n = b.len()
    loop i in 0..<n {
        if a[i] < b[i] -> return -1
        if a[i] > b[i] -> return 1
    }
    if a.len() < b.len() -> return -1
    if a.len() > b.len() -> return 1
    0
}


fn snapshot_from_rows<T>(rows: [T]) -> DataSnapshot<[T]> Never! {
    source := DataSourceIdentity{kind: DataLoaderKind.Value, locator: "rows", member: "", parameters: [String]{}}
    authority := DataAuthority{scope: "local", revision: ""}
    return DataSnapshot<[T]>{
        value: rows,
        identity: DataSnapshotIdentity{id: "rows", source: "rows", content: "", schema: "", format: DataFormat.JSON},
        provenance: DataProvenance{source: source, format: DataFormat.JSON, authority: authority},
        schema: DataSchema{identity: "rows", format: DataFormat.JSON, columns: [DataColumn]{}, projection: None},
        status: DataLoaderStatus{identity: "rows", freshness: DataFreshness.Fresh, invalidated_by: .NoCause, error: "", cleanup: "", buffered_bytes: 0, backpressure: false, last_good: true},
        content: [U8]{},
    }
}

fn sort_floats(values: [Float]) -> [Float] Never! {
    out := [Float]{}
    loop value in values -> &out.push(value)
    loop i in 0..<out.len() {
        loop j in (i + 1)..<out.len() {
            if out[j] < out[i] {
                value := out[i]
                out[i] = out[j]
                out[j] = value
            }
        }
    }
    out
}
fn render_bar_text(labels: [String], values: [Float]) -> String Never! {
    bounds :: value_bounds(values)
    minimum :: bounds.min
    maximum :: bounds.max
    baseline := scale_between(Float{0.0}, minimum, maximum, 20)
    out := ""
    loop i in 0..<labels.len() {
        v := values[i]
        bar := ""
        if v >= (Float{0.0}) {
            width := 0
            if maximum > (Float{0.0}) -> width = scale_between(v, Float{0.0}, maximum, 20 - baseline)
            loop _ in 0..<baseline -> bar = "{bar} "
            loop _ in 0..<width -> bar = "{bar}#"
        } else {
            width := 0
            if minimum < (Float{0.0}) -> width = scale_between(v, minimum, Float{0.0}, baseline)
            loop _ in 0..<width -> bar = "{bar}<"
        }
        out = "{out}{labels[i]} | {bar} {v}\n"
    }
    out
}

fn render_bar_svg(labels: [String], values: [Float]) -> String Never! {
    bounds :: value_bounds(values)
    minimum :: bounds.min
    maximum :: bounds.max
    baseline := 100
    if maximum > minimum -> baseline = scale_between(Float{0.0}, minimum, maximum, 200)
    w := 320
    h := 24 * labels.len() + 16
    out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{w}\" height=\"{h}\">"
    loop i in 0..<labels.len() {
        v := values[i]
        y := 8 + i * 24
        x := 80 + baseline
        bw := 0
        if v >= (Float{0.0}) {
            if maximum > (Float{0.0}) -> bw = scale_between(v, Float{0.0}, maximum, 200 - baseline)
        } else {
            if minimum < (Float{0.0}) -> bw = scale_between(v, minimum, Float{0.0}, baseline)
            x = x - bw
        }
        out = "{out}<text x=\"4\" y=\"{y + 12}\" font-size=\"12\">{xml_escape(labels[i])}</text>"
        out = "{out}<rect x=\"{x}\" y=\"{y}\" width=\"{bw}\" height=\"16\" fill=\"#4a90d9\"/>"
    }
    "{out}<line x1=\"{80 + baseline}\" y1=\"0\" x2=\"{80 + baseline}\" y2=\"{h}\" stroke=\"#777\" stroke-width=\"1\"/></svg>"
}

fn render_line_text(labels: [String], values: [Float]) -> String Never! {
    out := ""
    loop i in 0..<labels.len() {
        out = "{out}{labels[i]}={values[i]}\n"
    }
    out
}

fn render_line_svg(labels: [String], values: [Float]) -> String Never! {
    n :: labels.len()
    w := 320
    h := 120
    bounds :: value_bounds(values)
    out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{w}\" height=\"{h}\"><polyline fill=\"none\" stroke=\"#4a90d9\" points=\""
    loop i in 0..<n {
        x := 8
        if n > 1 -> x = i * (w - 16) /% (n - 1) + 8
        y :: h - 8 - scale_between(values[i], bounds.min, bounds.max, h - 16)
        if i > 0 -> out = "{out} "
        out = "{out}{x},{y}"
    }
    "{out}\"/></svg>"
}

fn render_point_svg(labels: [String], values: [Float]) -> String Never! {
    n :: labels.len()
    w := 320
    h := 120
    bounds :: value_bounds(values)
    out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{w}\" height=\"{h}\">"
    loop i in 0..<n {
        x := 8
        if n > 1 -> x = i * (w - 16) /% (n - 1) + 8
        y :: h - 8 - scale_between(values[i], bounds.min, bounds.max, h - 16)
        out = "{out}<circle cx=\"{x}\" cy=\"{y}\" r=\"3\" fill=\"#4a90d9\"/>"
        out = "{out}<text x=\"{x}\" y=\"{h - 1}\" font-size=\"10\">{xml_escape(labels[i])}</text>"
    }
    "{out}</svg>"
}

fn value_bounds(values: [Float]) -> (min: Float, max: Float) Never! {
    minimum := Float{0.0}
    maximum := Float{0.0}
    loop value in values {
        if value < minimum -> minimum = value
        if value > maximum -> maximum = value
    }
    if minimum == maximum {
        minimum = minimum - (Float{1.0})
        maximum = maximum + (Float{1.0})
    }
    (min: minimum, max: maximum)
}

fn scale_between(value: Float, minimum: Float, maximum: Float, extent: Int) -> Int Never! {
    if extent <= 0 || maximum <= minimum -> return 0
    ratio := (value - minimum) / (maximum - minimum)
    if ratio <= (Float{0.0}) -> return 0
    if ratio >= (Float{1.0}) -> return extent
    Int.from_float(ratio * Float{extent}) ?? panic("plot coordinate must be finite")
}


fn validate_line_options(options: DataLineOptions, operation: String) DataError! {
    if options.reference != None {
        reference :: options.reference ?? Float{0.0}
        if nonfinite(reference) -> return Err(data_error(DataErrorKind.NonFinite, "reference line must be finite", operation))
    }
    if options.style != "solid" && options.style != "dashed" && options.style != "dotted" {
        return Err(data_error(DataErrorKind.InvalidArgument, "line style must be solid, dashed, or dotted", operation))
    }
    if options.color.len() == 0 -> return Err(data_error(DataErrorKind.InvalidArgument, "line color must not be empty", operation))
    return Ok()
}

fn normalize_plot_plan(plan: JetDataPlotPlan) -> JetDataPlotPlan DataError! {
    values := [Float]{}
    loop i in 0..<plan.labels.len() {
        value := Float{0.0}
        if i < plan.values.len() -> value = plan.values[i]
        if nonfinite(value) {
            return Err(data_error_at(DataErrorKind.NonFinite, "plot values must be finite", "plot", i))
        }
        &values.push(value)
    }
    height := 24 * plan.labels.len() + 16
    if plan.mark == JetDataPlotMark.Line || plan.mark == JetDataPlotMark.Point -> height = 120
    if height < 16 -> height = 16
    Ok(JetDataPlotPlan{
        mark: plan.mark,
        labels: plan.labels,
        values: values,
        layout: JetDataPlotLayout{width: 320, height: height},
        encoding: plan.encoding,
        schema: plan.schema,
    })
}

fn plot_mark_name(mark: JetDataPlotMark) -> String Never! {
    if mark == JetDataPlotMark.Line -> return "line"
    if mark == JetDataPlotMark.Point -> return "point"
    "bar"
}

fn plot_plan_json(plan: JetDataPlotPlan) -> String Never! {
    "{{\"mark\":\"{plot_mark_name(plan.mark)}\",\"n\":{plan.labels.len()},\"width\":{plan.layout.width},\"height\":{plan.layout.height}}}"
}

fn plot_inspection_text(plan: JetDataPlotPlan, rows: Int) -> String Never! {
    "plot mark={plot_mark_name(plan.mark)} rows={rows} labels={plan.labels.len()} width={plan.layout.width} height={plan.layout.height}"
}

fn render_plot_text(plan: JetDataPlotPlan) -> String Never! {
    if plan.mark == JetDataPlotMark.Line -> return render_line_text(plan.labels, plan.values)
    if plan.mark == JetDataPlotMark.Point {
        out := ""
        loop i in 0..<plan.labels.len() -> out = "{out}{plan.labels[i]}: {plan.values[i]}\n"
        return out
    }
    render_bar_text(plan.labels, plan.values)
}

fn render_plot_svg(plan: JetDataPlotPlan) -> String Never! {
    if plan.mark == JetDataPlotMark.Line -> return render_line_svg(plan.labels, plan.values)
    if plan.mark == JetDataPlotMark.Point -> return render_point_svg(plan.labels, plan.values)
    render_bar_svg(plan.labels, plan.values)
}

// Points print with six decimals and SVG coordinates with three; -0.0 prints
// as 0.
fn render_line_options_text(labels: [String], values: [Float], options: DataLineOptions) -> String Never! {
    points := ""
    loop i in 0..<values.len() {
        if i > 0 -> points = "{points} -> "
        points = "{points}{normalize_zero(values[i]):Fixed(6)}"
    }
    label_text := ""
    loop i in 0..<labels.len() {
        if i > 0 -> label_text = "{label_text} | "
        label_text = "{label_text}{labels[i]}"
    }
    out := ""
    if options.title.len() > 0 -> out = "{out}{options.title}\n"
    out = "{out}{options.x_label}: {label_text}\n{options.y_label}: {points}\n"
    markers := "off"
    if options.markers -> markers = "on"
    out = "{out}line: style={options.style} color={options.color} markers={markers}"
    if options.reference != None {
        reference :: options.reference ?? Float{0.0}
        out = "{out}\nreference: {normalize_zero(reference):Fixed(6)}"
    }
    if options.legend.len() > 0 -> out = "{out}\nlegend: {options.legend}"
    out
}

// A 640x360 chart with a 64/24/44/52 margin. The value range spans the points
// and the reference line; a flat range widens by one on each side.
fn render_line_options_svg(labels: [String], values: [Float], options: DataLineOptions) -> String Never! {
    n :: labels.len()
    minimum := Float{0.0}
    maximum := Float{1.0}
    if values.len() > 0 {
        minimum = values[0]
        maximum = values[0]
    }
    loop value in values {
        if value < minimum -> minimum = value
        if value > maximum -> maximum = value
    }
    if options.reference != None {
        reference :: options.reference ?? Float{0.0}
        if values.len() == 0 {
            minimum = reference
            maximum = reference
        }
        if reference < minimum -> minimum = reference
        if reference > maximum -> maximum = reference
    }
    if math.fabs(maximum - minimum) < 2.220446049250313e-16 {
        minimum = minimum - Float{1.0}
        maximum = maximum + Float{1.0}
    }
    color :: xml_escape(options.color)
    out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"640\" height=\"360\" viewBox=\"0 0 640 360\"><title>{xml_escape(options.title)}</title><rect width=\"640\" height=\"360\" fill=\"white\"/>"
    out = "{out}<line x1=\"64\" y1=\"44\" x2=\"64\" y2=\"308\" stroke=\"#333\"/><line x1=\"64\" y1=\"308\" x2=\"616\" y2=\"308\" stroke=\"#333\"/>"
    if options.reference != None {
        reference :: options.reference ?? Float{0.0}
        y :: line_plot_y(reference, minimum, maximum)
        out = "{out}<line x1=\"64\" y1=\"{y:Fixed(3)}\" x2=\"616\" y2=\"{y:Fixed(3)}\" stroke=\"#888\" stroke-dasharray=\"4 4\"/>"
    }
    points := ""
    loop i in 0..<n {
        if i > 0 -> points = "{points} "
        points = "{points}{line_plot_x(i, n):Fixed(3)},{line_plot_y(values[i], minimum, maximum):Fixed(3)}"
    }
    dash := ""
    if options.style == "dashed" -> dash = " stroke-dasharray=\"8 5\""
    if options.style == "dotted" -> dash = " stroke-dasharray=\"2 5\""
    out = "{out}<polyline fill=\"none\" stroke=\"{color}\" stroke-width=\"2\"{dash} points=\"{points}\"/>"
    if options.markers {
        loop i in 0..<n {
            out = "{out}<circle cx=\"{line_plot_x(i, n):Fixed(3)}\" cy=\"{line_plot_y(values[i], minimum, maximum):Fixed(3)}\" r=\"4\" fill=\"{color}\"/>"
        }
    }
    loop i in 0..<n {
        out = "{out}<text x=\"{line_plot_x(i, n):Fixed(3)}\" y=\"326\" text-anchor=\"middle\" font-family=\"monospace\" font-size=\"11\">{xml_escape(labels[i])}</text>"
    }
    out = "{out}<text x=\"320\" y=\"24\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"16\">{xml_escape(options.title)}</text>"
    out = "{out}<text x=\"320\" y=\"350\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\">{xml_escape(options.x_label)}</text>"
    out = "{out}<text x=\"16\" y=\"180\" text-anchor=\"middle\" transform=\"rotate(-90 16 180)\" font-family=\"sans-serif\" font-size=\"12\">{xml_escape(options.y_label)}</text>"
    if options.legend.len() > 0 -> out = "{out}<text x=\"496\" y=\"32\" font-family=\"sans-serif\" font-size=\"12\" fill=\"{color}\">{xml_escape(options.legend)}</text>"
    "{out}</svg>"
}

fn line_plot_x(index: Int, count: Int) -> Float Never! {
    if count <= 1 -> return Float{340.0}
    Float{64.0} + Float{552.0} * Float{index} / Float{count - 1}
}

fn line_plot_y(value: Float, minimum: Float, maximum: Float) -> Float Never! {
    Float{44.0} + (maximum - value) / (maximum - minimum) * Float{264.0}
}

fn xml_escape(text: String) -> String Never! {
    out := ""
    chunk := [U8]{}
    loop byte in text.bytes() {
        entity := ""
        if byte == (U8{38}) -> entity = "&amp;"
        else if byte == (U8{60}) -> entity = "&lt;"
        else if byte == (U8{62}) -> entity = "&gt;"
        else if byte == (U8{34}) -> entity = "&quot;"
        else if byte == (U8{39}) -> entity = "&apos;"
        if entity.len() > 0 {
            chunk_text :: String.from_bytes(chunk) ?? ""
            out = "{out}{chunk_text}{entity}"
            chunk = [U8]{}
        } else {
            &chunk.push(byte)
        }
    }
    tail :: String.from_bytes(chunk) ?? ""
    out = "{out}{tail}"
    out
}

fn trim(text: String) -> String Never! {
    raw :: text.bytes()
    s := 0
    e := raw.len()
    loop s < e {
        n :: raw[s]
        if n == 32 || n == 9 || n == 10 || n == 13 -> s = s + 1 else { break }
    }
    loop e > s {
        n :: raw[e - 1]
        if n == 32 || n == 9 || n == 10 || n == 13 -> e = e - 1 else { break }
    }
    if s == 0 && e == raw.len() -> return String.from_bytes(raw) ?? ""
    if e <= s -> return ""
    String.from_bytes(raw[s..(e - 1)]) ?? ""
}

fn upper(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n :: b
        if n >= 97 && n <= 122 -> &out.push(U8{n - 32}) else -> &out.push(b)
    }
    String.from_bytes(out) ?? ""
}

#Test("Plot aggregate absence is the native enum constructor") {
    none :: plot.__plot_aggregate_none()
    assert(none == plot.__plot_aggregate_none())
    assert(none != JetDataPlotAggregate.Sum)
}

// Native DataFlow.rs::jet_data_loader_canonical_tree sorts object keys by
// UTF-8 lexical order, but keeps Debug float spelling and exact Number text.
fn data_loader_put_text(out: &[U8], text: String) Never! {
    loop index in 0..<text.count_bytes() -> &out.push(encoding_stream.byte_at(text, index))
}

fn data_loader_put_control(out: &[U8], value: Int) Never! {
    &out.push(U8{92})
    &out.push(U8{117})
    &out.push(U8{48})
    &out.push(U8{48})
    hex :: "0123456789abcdef"
    &out.push(encoding_stream.byte_at(hex, value >> 4))
    &out.push(encoding_stream.byte_at(hex, value.bit_and(15)))
}

fn data_loader_quote(out: &[U8], text: String) Never! {
    &out.push(U8{34})
    index := 0
    loop index < text.count_bytes() {
        byte :: encoding_stream.byte_at(text, index)
        n :: Int.from_u8(byte)
        if n == 34 || n == 92 {
            &out.push(U8{92})
            &out.push(byte)
        } else if n == 10 || n == 13 || n == 9 {
            &out.push(U8{92})
            &out.push(if n == 10 -> U8{110} else if n == 13 -> U8{114} else -> U8{116})
        } else if n < 32 || n == 127 {
            data_loader_put_control(&out, n)
        } else if n == 194 && index + 1 < text.count_bytes() && Int.from_u8(encoding_stream.byte_at(text, index + 1)) <= 159 {
            // Rust char::is_control includes the C1 scalars U+0080..U+009F.
            index += 1
            data_loader_put_control(&out, Int.from_u8(encoding_stream.byte_at(text, index)))
        } else {
            &out.push(byte)
        }
        index += 1
    }
    &out.push(U8{34})
}

fn data_loader_render(out: &[U8], tree: encoding.Dyn) Never! {
    #Unsafe("inspect existing private Decode carriers only inside checked Core data source") {
        if tree == .Number(text) {
            data_loader_put_text(&out, text)
            return
        }
        if tree == .Bytes(bytes) {
            &out.push(U8{91})
            loop (index, byte) in bytes {
                if index != 0 -> &out.push(U8{44})
                data_loader_put_text(&out, "{byte}")
            }
            &out.push(U8{93})
            return
        }
    }
    if tree == {
        .Null -> data_loader_put_text(&out, "null")
        .Bool(value) -> data_loader_put_text(&out, if value -> "true" else -> "false")
        .Int(value) -> data_loader_put_text(&out, "{value}")
        .Float(value) -> data_loader_put_text(&out, "{value:Debug}")
        .Text(value) -> data_loader_quote(&out, value)
        .Array(values) -> {
            &out.push(U8{91})
            loop (index, value) in values {
                if index != 0 -> &out.push(U8{44})
                data_loader_render(&out, value)
            }
            &out.push(U8{93})
        }
        .Object(_) -> {
            // Sort the owned entries directly; the comparator captures no tree.
            entries := encoding_stream.object_entries(tree)
            &entries.sort_by((left: (key: String, value: Dyn), right: (key: String, value: Dyn)) -> left.key <=> right.key)
            &out.push(U8{123})
            loop (position, entry) in entries {
                if position != 0 -> &out.push(U8{44})
                data_loader_quote(&out, entry.key)
                &out.push(U8{58})
                data_loader_render(&out, entry.value)
            }
            &out.push(U8{125})
        }
        .DateTime(_) -> data_loader_quote(&out, tree.to_text() ?? panic("DateTime always has an RFC 3339 representation"))
        else -> panic("unknown native Dyn carrier")
    }
}

fn data_loader_check_payload(limits: DataLimits, bytes: Int, operation: String) DataError! {
    if bytes > limits.encoding.max_item_bytes -> return Err(data_error(.Limit, "payload is {bytes} bytes; max_item_bytes is {limits.encoding.max_item_bytes}", operation))
    if limits.encoding.max_total_bytes == .Val(limit) {
        if bytes > limit -> return Err(data_error(.Limit, "payload is {bytes} bytes; max_total_bytes is {limit}", operation))
    }
    Ok(())
}

// Foundation `PreludeDataFlow` loader kernel, ported for `snapshot<T>`.

// `bounded_text(value, MAX_STATUS_TEXT)`: at most 1024 bytes, cut on a UTF-8
// boundary and marked `...<truncated>`.
fn data_loader_bounded_text(value: String) -> String Never! {
    raw :: value.bytes()
    if raw.len() <= 1024 -> return value.copy()
    end := 1024 - 14
    loop end > 0 && raw[end] >= (U8{128}) && raw[end] < (U8{192}) -> end -= 1
    prefix :: if end == 0 -> "" else -> String.from_bytes(raw[0..(end - 1)]) ?? ""
    "{prefix}...<truncated>"
}

// `status_text`: a status message that carries credential material is
// redacted whole.
fn data_loader_status_text(value: String) -> String Never! {
    lowered :: value.to_ascii_lower()
    markers :: [String]{"password=", "password:", "passwd=", "passwd:", "secret=", "secret:", "token=", "token:", "credential=", "credential:", "authorization=", "authorization:", "api_key=", "api_key:", "access_key=", "access_key:", "cookie=", "cookie:", "session=", "session:", "bearer ", "basic ", "-----begin"}
    loop marker in markers {
        if lowered.contains(marker) -> return "<redacted>"
    }
    data_loader_bounded_text(value)
}

fn data_loader_error(kind: DataErrorKind, operation: String, reason: String) -> DataError Never! {
    data_error(kind, data_loader_bounded_text(reason), operation)
}

fn data_loader_public_text_error(label: String) -> DataError Never! {
    data_loader_error(DataErrorKind.InvalidArgument, "data.loader", "{label} must be non-empty, contain no control characters, and be at most 4096 bytes")
}

// `fail`: the loader status records the failure; a non-value loader releases
// its pending payload.
fn data_loader_fail<T>(loader: &DataLoader<T>, error: DataError) -> DataError Never! {
    cleanup := "payload-released"
    if loader.source.kind == DataLoaderKind.Value {
        cleanup = "retained"
    } else {
        loader.payload = None
    }
    loader.status = DataLoaderStatus{
        identity: loader.status.identity.copy(),
        freshness: if loader.cancelled -> DataFreshness.Cancelled else -> DataFreshness.Error,
        invalidated_by: loader.status.invalidated_by.copy(),
        error: data_loader_status_text("{error.operation}: {error.reason}"),
        cleanup: cleanup,
        buffered_bytes: 0,
        backpressure: false,
        last_good: loader.last_good != None,
    }
    error.copy()
}

// `validate_loader`: the public source identity and authority.
fn data_loader_validate<T>(loader: DataLoader<T>) DataError! {
    if !valid_public_text(loader.source.locator, false) -> return Err(data_loader_public_text_error("source identity locator"))
    if loader.source.member.len() > 0 && !valid_public_text(loader.source.member, false) -> return Err(data_loader_public_text_error("source identity member"))
    loop parameter in loader.source.parameters {
        if !valid_public_text(parameter, true) -> return Err(data_loader_public_text_error("source identity parameter"))
    }
    if loader.source.kind != DataLoaderKind.File && loader.source.member.len() > 0 {
        return Err(data_loader_error(DataErrorKind.InvalidArgument, "data.loader", "only file loaders may carry an archive member identity"))
    }
    if !valid_public_text(loader.authority.scope, false) -> return Err(data_loader_public_text_error("authority scope"))
    if !valid_public_text(loader.authority.revision, true) -> return Err(data_loader_public_text_error("authority revision"))
    if !valid_authority(loader.authority.scope) || !valid_authority(loader.authority.revision) {
        return Err(data_loader_error(DataErrorKind.InvalidArgument, "data.loader", "authority identity cannot carry credential material"))
    }
    Ok(())
}

// `payload` plus the local-file read of `jet_data_loader_payload`: bound
// bytes, then offline/value last-good bytes, then the local file. Every
// other source needs its provider to bind the payload.
fn data_loader_payload<T>(loader: DataLoader<T>) -[FS]> (data: [U8], offline: Bool) DataError! {
    if loader.payload == .Val(bound) {
        data_loader_check_payload(loader.limits, bound.len(), "data.loader") ?? return Err(err)
        return Ok((data: bound.copy(), offline: loader.offline))
    }
    if loader.offline || loader.source.kind == DataLoaderKind.Value {
        if loader.last_good == .Val(good) {
            data_loader_check_payload(loader.limits, good.len(), "data.loader.offline") ?? return Err(err)
            return Ok((data: good.copy(), offline: loader.offline))
        }
    }
    local_file :: loader.source.kind == DataLoaderKind.File && loader.source.member.len() == 0
    if loader.offline && !local_file {
        return Err(data_loader_error(DataErrorKind.Bridge, "data.loader.offline", "offline mode has no last-good snapshot"))
    }
    if local_file {
        read :: core_files.read_bytes(loader.source.locator) ?? return Err(data_loader_error(DataErrorKind.IO, "data.loader.file", "could not read `{loader.source.locator}`: {err}"))
        data_loader_check_payload(loader.limits, read.len(), "data.loader.file") ?? return Err(err)
        return Ok((data: read, offline: loader.offline))
    }
    operation :: if loader.source.kind == {
        .URL -> "data.loader.url"
        .Database -> "data.loader.database"
        .File -> "data.loader.archive"
        .Value -> "data.loader.value"
    }
    Err(data_loader_error(DataErrorKind.Bridge, operation, "provider payload is missing; core does not access remote authority"))
}

// The payload as one tree, by format (Rust `jet_data_loader_tree`).
fn data_loader_tree(payload: [U8], format: DataFormat, limits: DataLimits) -> Dyn DataError! {
    if format == DataFormat.Parquet {
        if parquet.read_rows(payload, limits.max_output_rows, limits.encoding.max_item_bytes) == {
            .Ok(tree) -> return Ok(tree)
            .Err(failure) -> {
                kind :: if failure.kind == {
                    .Decode -> DataErrorKind.Decode
                    .Unsupported -> DataErrorKind.Unsupported
                    .Limit -> DataErrorKind.Limit
                }
                return Err(data_loader_error(kind, "data.loader.parquet", failure.reason))
            }
        }
    }
    if format == DataFormat.Arrow {
        return Err(data_loader_error(DataErrorKind.Bridge, "data.loader", "Arrow IPC has a separate provider boundary; Parquet is the registered reader"))
    }
    text :: String.from_bytes(payload) ?? return Err(data_loader_error(DataErrorKind.Decode, "data.loader", "payload is not UTF-8"))
    tree := Dyn.Null
    if format == DataFormat.JSON {
        if json_codec.parse(text) == {
            .Ok(value) -> tree = value
            .Err(failure) -> return Err(data_loader_error(DataErrorKind.Decode, "data.loader.json", data_loader_json_reason("invalid JSON", failure)))
        }
    } else if format == DataFormat.CSV {
        tree = data_loader_csv_tree(text, limits) ?? return Err(err)
    } else {
        tree = data_loader_jsonl_tree(text, limits) ?? return Err(err)
    }
    if tree == .Array(rows) {
        if rows.len() > limits.max_output_rows -> return Err(data_loader_error(DataErrorKind.Limit, "data.loader", "max_output_rows {limits.max_output_rows} exceeded"))
    }
    Ok(tree)
}

fn data_loader_json_reason(prefix: String, failure: EncodingError) -> String Never! {
    if failure.line == .Val(line) -> return "{prefix} (line {line}): {failure.reason}"
    "{prefix}: {failure.reason}"
}

// A CSV payload's cells are Text; they decode as typed cells, the scope
// `csv_reader<T>` decodes its rows in.
fn data_loader_decode<T: Decode>(tree: Dyn, text_cells: Bool) -> T [FieldError]! {
    if !text_cells {
        if tree.decode<T>() == {
            .Ok(value) -> {
                return Ok(value)
            }
            .Err(failures) -> {
                return Err(failures)
            }
        }
    }
    previous :: encoding.__text_cells_enter()
    if tree.decode<T>() == {
        .Ok(value) -> {
            encoding.__text_cells_leave(previous)
            return Ok(value)
        }
        .Err(failures) -> {
            encoding.__text_cells_leave(previous)
            return Err(failures)
        }
    }
}

// Header-named Text cells; a short row's missing cells are null.
fn data_loader_csv_tree(text: String, limits: DataLimits) -> Dyn DataError! {
    records :: csv_codec.rows(text, ",", false, false) ?? return Err(data_loader_error(DataErrorKind.Decode, "data.loader.csv", err.reason))
    if records.len() == 0 -> return Ok(Dyn.Array([Dyn]{}))
    header :: records[0].fields
    loop (index, name) in header {
        if !valid_public_text(name, false) -> return Err(data_loader_public_text_error("CSV header"))
        loop earlier in 0..<index {
            if header[earlier] == name -> return Err(data_loader_error(DataErrorKind.Decode, "data.loader.csv", "duplicate CSV header `{name}`"))
        }
    }
    values := [Dyn]{}
    loop row in 1..<records.len() {
        fields :: records[row].fields
        if values.len() >= limits.max_output_rows -> return Err(data_loader_error(DataErrorKind.Limit, "data.loader.csv", "max_output_rows {limits.max_output_rows} exceeded"))
        if fields.len() > header.len() -> return Err(data_loader_error(DataErrorKind.Decode, "data.loader.csv", "CSV row has {fields.len()} fields; header has {header.len()}"))
        entries := [(key: String, value: Dyn)]{}
        loop column in 0..<header.len() {
            cell :: if column < fields.len() -> Dyn.Text(fields[column].copy()) else -> Dyn.Null
            &entries.push((key: header[column].copy(), value: cell))
        }
        &values.push(encoding_stream.object_from_entries(^entries))
    }
    Ok(Dyn.Array(values))
}

// One JSON value per non-blank line.
fn data_loader_jsonl_tree(text: String, limits: DataLimits) -> Dyn DataError! {
    values := [Dyn]{}
    loop (index, raw_line) in text.split("\n").to_list() {
        line :: trim(raw_line)
        if line.len() == 0 -> next
        if values.len() >= limits.max_output_rows -> return Err(data_loader_error(DataErrorKind.Limit, "data.loader.jsonl", "max_output_rows {limits.max_output_rows} exceeded"))
        if json_codec.parse(line) == {
            .Ok(value) -> &values.push(value)
            .Err(failure) -> return Err(data_loader_error(DataErrorKind.Decode, "data.loader.jsonl", data_loader_json_reason("invalid JSONL record at line {index + 1}", failure)))
        }
    }
    Ok(Dyn.Array(values))
}

// `DataSchema::infer`: one column per field name across every row, sorted
// by name. A null, a missing field, or any field after the first row is
// nullable; Int and Float share `float`, other conflicts widen to `Any`.
// The identity is the length-delimited format and column facts.
fn data_loader_schema(tree: Dyn, format: DataFormat) -> DataSchema Never! {
    fields := [(name: String, type_name: String, nullable: Bool)]{}
    if tree == {
        .Object(_) -> {
            loop entry in encoding_stream.object_entries(tree) -> data_schema_absorb(&fields, entry.key, entry.value, entry.value == .Null)
        }
        .Array(values) -> {
            rows_seen := 0
            loop value in values {
                if value == .Object(_) {
                    entries :: encoding_stream.object_entries(value)
                    loop entry in entries -> data_schema_absorb(&fields, entry.key, entry.value, rows_seen > 0 || entry.value == .Null)
                    loop index in 0..<fields.len() {
                        present := false
                        loop entry in entries {
                            if entry.key == fields[index].name -> present = true
                        }
                        if !present -> fields[index] = (name: fields[index].name.copy(), type_name: fields[index].type_name.copy(), nullable: true)
                    }
                } else {
                    data_schema_absorb(&fields, "$", value, rows_seen > 0 || value == .Null)
                }
                rows_seen += 1
            }
        }
        else -> data_schema_absorb(&fields, "$", tree, tree == .Null)
    }
    &fields.sort_by((left: (name: String, type_name: String, nullable: Bool), right: (name: String, type_name: String, nullable: Bool)) -> left.name <=> right.name)
    format_name :: data_format_text(format)
    identity := data_loader_identity_part("", format_name)
    columns := [DataColumn]{}
    loop (order, field) in fields {
        column :: DataColumn{id: "column-{order}-{field.name}", name: field.name.copy(), type_name: field.type_name.copy(), nullable: field.nullable}
        identity = data_loader_identity_part(identity, column.id)
        identity = data_loader_identity_part(identity, column.name)
        identity = data_loader_identity_part(identity, column.type_name)
        identity = data_loader_identity_part(identity, if column.nullable -> "true" else -> "false")
        &columns.push(column)
    }
    DataSchema{identity: identity, format: format, columns: columns, projection: None}
}

fn data_schema_absorb(fields: &[(name: String, type_name: String, nullable: Bool)], name: String, value: Dyn, nullable: Bool) Never! {
    current :: data_schema_value_type(value)
    loop index in 0..<fields.len() {
        if fields[index].name == name {
            merged :: data_schema_merge(fields[index].type_name, current)
            fields[index] = (name: name.copy(), type_name: merged.type_name, nullable: fields[index].nullable || nullable || merged.nullable)
            return
        }
    }
    &fields.push((name: name.copy(), type_name: current, nullable: nullable || current == "null"))
}

fn data_schema_merge(left: String, right: String) -> (type_name: String, nullable: Bool) Never! {
    if left == right {
        known :: left == "null" || left == "bool" || left == "int" || left == "float" || left == "text" || left == "bytes" || left == "array" || left == "object"
        return (type_name: if known -> left.copy() else -> "Any", nullable: left == "null")
    }
    if left == "null" -> return (type_name: right.copy(), nullable: true)
    if right == "null" -> return (type_name: left.copy(), nullable: true)
    if (left == "int" && right == "float") || (left == "float" && right == "int") -> return (type_name: "float", nullable: false)
    (type_name: "Any", nullable: false)
}

fn data_schema_value_type(value: Dyn) -> String Never! {
    #Unsafe("inspect existing private Decode carriers only inside checked Core data source") {
        if value == .Number(_) -> return "float"
        if value == .Bytes(_) -> return "bytes"
    }
    if value == {
        .Null -> "null"
        .Bool(_) -> "bool"
        .Int(_) -> "int"
        .Float(_) -> "float"
        .Text(_) -> "text"
        .DateTime(_) -> "datetime"
        .Array(_) -> "array"
        .Object(_) -> "object"
        else -> panic("unknown native Dyn carrier")
    }
}

fn data_loader_digest(bytes: [U8]) -> String Never! { "sha256-{sha256(bytes).hex()}" }

// `identity_part`: one length-delimited `len:value;` fact.
fn data_loader_identity_part(material: String, value: String) -> String Never! { "{material}{value.count_bytes()}:{value};" }

fn data_loader_kind_text(kind: DataLoaderKind) -> String Never! {
    if kind == {
        .File -> "File"
        .URL -> "URL"
        .Database -> "Database"
        .Value -> "Value"
    }
}

fn data_format_text(format: DataFormat) -> String Never! {
    if format == {
        .CSV -> "csv"
        .JSON -> "json"
        .JSONL -> "jsonl"
        .Parquet -> "parquet"
        .Arrow -> "arrow"
    }
}

#Encode
struct DataLoaderPortRecord {
    z: Float
    a: String
}

#Test("value loader preserves canonical payload and user-record return type") {
    record :: DataLoaderPortRecord{z: Float{2.0}, a: "x"}
    loader :: value<DataLoaderPortRecord>(record, DataLimits.safe()) ?? panic("value loader")
    payload :: loader.payload ?? panic("value payload")
    assert_eq(payload, [U8]{123, 34, 97, 34, 58, 34, 120, 34, 44, 34, 122, 34, 58, 50, 46, 48, 125})
    assert_eq(loader.source.kind, DataLoaderKind.Value)
    assert_eq(loader.source.locator, "value")
    assert_eq(loader.authority.scope, "local")
    assert_eq(loader.format, DataFormat.JSON)
    assert(loader.last_good == None)
    assert(!loader.cancelled)
    assert(!loader.offline)

    limits := DataLimits.safe()
    limits.encoding.max_item_bytes = 1
    limits.encoding.buffer_bytes = 1
    if value<String>("x", limits) == {
        .Err(error) -> {
            assert(error.kind == .Limit)
            assert_eq(error.operation, "data.value")
            assert_eq(error.reason, "payload is 3 bytes; max_item_bytes is 1")
        }
        else -> panic("value payload limit must precede constructor validation")
    }
}

#Test("value canonical strings retain native C0 and C1 control escaping") {
    text :: encoding_stream.text_from_bytes([U8]{8, 127, 194, 128, 194, 159, 9}) ?? panic("control text")
    out := [U8]{}
    data_loader_quote(&out, text)
    assert_eq(out, [U8]{34, 92, 117, 48, 48, 48, 56, 92, 117, 48, 48, 55, 102, 92, 117, 48, 48, 56, 48, 92, 117, 48, 48, 57, 102, 92, 116, 34})
}

#Test("data CSV and JSON preserve malformed input field-error strings") {
    if csv<Int>("n\n\"7\"x") == {
        .Err(errors) -> {
            assert_eq(errors.len(), 1)
            assert_eq(errors[0].path, "")
            assert_eq(errors[0].reason, "E2701: CSV row 2, line 2, column 4 — only quote, comma, CRLF, LF, or EOF may follow a closing quote")
        }
        else -> panic("malformed CSV accepted")
    }
    if json<Int>("[1e]") == {
        .Err(errors) -> {
            assert_eq(errors.len(), 1)
            assert_eq(errors[0].path, "")
            assert_eq(errors[0].reason, "invalid JSON (line 1): bad number")
        }
        else -> panic("malformed JSON accepted")
    }
}

