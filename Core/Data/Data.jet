    ArchiveMember
    Parameters
    Credential
    Capability
    Manual
}


#Equatable
DataStatus: struct {
    step: String
    path: String
    clone_value: String
    ownership: String
    trust: String
    fallback: String
    replacement: String
}


#Equatable
DataLimits: struct {
    encoding: EncodingLimits
    max_groups: Int
    max_sort_rows: Int
    max_join_rows: Int
    max_output_rows: Int

    // Typed data declarations and provider-backed boundaries.
    safe: fn() -> DataLimits Never! {
        DataLimits{
            encoding: encoding.EncodingLimits.safe(),
            max_groups: 100000,
            max_sort_rows: 1000000,
            max_join_rows: 1000000,
            max_output_rows: 1000000,
        }
    }
}



