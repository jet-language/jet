    scope: String
    revision: String
}

DataSourceIdentity: struct {
    kind: DataLoaderKind
    locator: String
    member: String
    parameters: [String]
}

DataSnapshotIdentity: struct {
    id: String
    source: String
    content: String
    schema: String
    format: DataFormat
}

DataProvenance: struct {
    source: DataSourceIdentity
    format: DataFormat
    authority: DataAuthority
}

DataColumn: struct {
