package: {
    name: "core.data"
    version: "0.0.1"
    edition: "2026"
    description: "Tabular data, loaders, sketches, and plots."
    license: "MIT"
    outputs: {
        data: .Library{ entry: data }
    }
}
use {
    core: core

    core_files: core.files
    core.files.[FileReader]
    math: core.math
    encoding: core.encoding
    rt: jet.runtime.encoding
    core.encoding.[EncodingError, EncodingLimits]
    json_codec: core.encoding.json
    csv_codec: core.encoding.csv
    core.encoding.csv.[CSVReader]
    encoding_stream: __core_encoding_stream
    parquet: __core_data_parquet
    core.crypto.[sha256]
    sys: core.sys
    core.db.[SQL, DBValue]
    sql_kernel: core.db.sql
    time: core.time
    core.time.[DateTime]
    quantile_select.[finite_quantile, select_rank]
    rank_order.[rank_select_prototype, rank_select_range, rank_test_before, rank_test_refusing, rank_test_text_before, rank_test_values]
}
arrow: module

loader: module

stream: module

plot: module

sketch: module

#[Comparable, Equatable]
DataFormat: enum {
    CSV
    JSON
    JSONL
    Parquet
    Arrow
}


#Equatable
DataErrorKind: enum {
    Decode
    Limit
    IO
    Empty
    InvalidArgument
    NonFinite
    Overflow
    State
    Bridge
    Unsupported
    DuplicateKey
    MissingKey
    WrongOwner
    StaleRevision
    InvalidValue
    impl Display {
        display: fn(self) -> String { data_error_kind_text(self) }
    }
    impl Debug {
        debug: fn(&&self) -> String { data_error_kind_text(self) }
    }
}

data_error_kind_text: fn(kind: DataErrorKind) -> String Never! {
    if kind == {
        .Decode -> "Decode"
        .Limit -> "Limit"
        .IO -> "IO"
        .Empty -> "Empty"
        .InvalidArgument -> "InvalidArgument"
        .NonFinite -> "NonFinite"
        .Overflow -> "Overflow"
        .State -> "State"
        .Bridge -> "Bridge"
        .Unsupported -> "Unsupported"
        .DuplicateKey -> "DuplicateKey"
        .MissingKey -> "MissingKey"
        .WrongOwner -> "WrongOwner"
        .StaleRevision -> "StaleRevision"
        .InvalidValue -> "InvalidValue"
    }
}

#[Equatable, Error]
DataError: struct {
    kind: DataErrorKind
    operation: String
    row: Int?
    column: Int?
    index: Int?
    reason: String
    cause: EncodingError?

    impl Display {
        display: fn(self) -> String { data_error_text(self) }
    }

    impl Debug {
        debug: fn(&&self) -> String { data_error_text(self) }
    }

    new: fn(kind: DataErrorKind, message: String, path: String) -> DataError Never! {
        return DataError{
            kind: kind,
            operation: path.copy(),
            row: None,
            column: None,
            index: None,
            reason: message,
            cause: None,
        }
    }
}
data_error: fn(kind: DataErrorKind, message: String, operation: String) -> DataError Never! {
    DataError{
        kind: kind,
        operation: operation,
        row: None,
        column: None,
        index: None,
        reason: message,
        cause: None,
    }
}

data_error_text: fn(error: DataError) -> String Never! {
    text := "{data_error_kind_text(error.kind)} {error.operation}"
    if error.row == .Val(row) -> text = "{text}, row {row}"
    if error.column == .Val(column) -> text = "{text}, column {column}"
    if error.index == .Val(index) -> text = "{text}, index {index}"
    "{text}: {error.reason}"
}

data_error_at: fn(kind: DataErrorKind, message: String, operation: String, index: Int) -> DataError Never! {
    DataError{
        kind: kind,
        operation: operation,
        row: None,
        column: None,
        index: Val(index),
        reason: message,
        cause: None,
    }
}

nonfinite: fn(value: Float) -> Bool Never! {
    if math.is_finite(value) -> return false
    true
}


DataLineOptions: struct {
    title: String
    x_label: String
    y_label: String
    markers: Bool
    reference: Float?
    style: String
    color: String
    legend: String
}


