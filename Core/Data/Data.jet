}

#Comparable
DataLoaderStatus: struct {
    identity: String
    freshness: DataFreshness
    invalidated_by: DataInvalidationCause
    error: String
    cleanup: String
    buffered_bytes: Int
    backpressure: Bool
    last_good: Bool
}

#Equatable
DataWatchStatus: struct {
    mode: String
    revision: Int
    retained_rows: Int
    recomputations: Int
    active: Bool
    generation: Int
    dirty: Bool
    error: String
    freshness_ms: Int
    invalidation_cause: String
    refreshing: Bool
    cancelled: Bool
    impl Display {
        display: fn(self) -> String { data_watch_status_text(self) }
    }
    impl Debug {
        debug: fn(&&self) -> String { data_watch_status_text(self) }
    }
}

data_watch_status_text: fn(status: DataWatchStatus) -> String Never! {
    "DataWatchStatus{{mode: {status.mode}, revision: {status.revision}, retained_rows: {status.retained_rows}, recomputations: {status.recomputations}, active: {status.active}, generation: {status.generation}, dirty: {status.dirty}, error: {status.error}, freshness_ms: {status.freshness_ms}, invalidation_cause: {status.invalidation_cause}, refreshing: {status.refreshing}, cancelled: {status.cancelled}}}"
}

// A stream is a one-shot cursor (core-library.md `core.data.stream`): the
// owned `items` come first, then the rows of the optional pull source.
DataStream: struct<T> {
    items: [T]
    index: Int
    cancelled: Bool
    __source: Shared<__StreamSource<T>>?
}

// The pull side of a file-backed stream (Rust `DataStream` with its inner
// reader, `terminal` and `eof`). `pull` reads and decodes one row; a failure
// stays latched in `terminal`, and `ahead` keeps rows that `len` read early.
// `limits` are the reader's: they bound `collect` and a query over the stream.
__StreamSource: struct<T> {
    pull: fn() -> T? DataError!
    limits: DataLimits
    ahead: [T]
    ahead_index: Int
    terminal: DataError?
    done: Bool
}

// The CSV record cursor behind `csv_reader<T>`; the first record is the
// header and is read on the first pull.
__CSVRowSource: struct {
    records: CSVReader
    header: [String]
    started: Bool
    row: Int
}

// The JSON event cursor behind `json_reader<T>`; the opening `[` is read on
// the first pull and the closing `]` ends the stream.
__JSONRowSource: struct {
    parser: encoding_stream.JSONPull
    array_started: Bool
    array_done: Bool
    row: Int
}

DataPivotCell: struct {
    row_key: String
    column_key: String
    count: Int
    sum: Float
    mean: Float
}
#Equatable
DataSummary: struct {
    count: Int
    sum: Float
    mean: Float
    min: Float
    max: Float
    median: Float
    variance: Float
    stddev: Float
}

DataJoin: struct<L, R> {
    left: L
    right: R
}

JetDataPlot: struct<T> {
    rows: [T]
    plan: JetDataPlotPlan
}

Group: struct<K, V> {
    key: K
    value: V
}

// Query<T> is the deferred operation carrier: `__steps` is the plan and the
// shared cell holds the computation that materializes the rows on collect.
// Row-list queries that only filter and sort may be collected again; every
// other computation (map, extrema, joins, grouped reducers) is one-shot and
// derived filter/sort queries share that one-shot state.
__QueryCell: struct<T> {
    run: fn() -> [T] DataError!
}

__QueryState: struct {
    consumed: Bool
}

// `__limits` bound the query's sorts, groups and output: a query over a
// reader's stream keeps that reader's limits, every other source starts at
// `DataLimits.safe()`, and each derived query inherits its source's.
Query: struct<T> {
    __steps: [String]
    __one_shot: Bool
    __limits: DataLimits
    __state: Shared<__QueryState>
    __cell: Shared<__QueryCell<T>>
}

__QueryKeyCell: struct<T, K> {
    key: fn(T) -> K DataError!
}

// `query.group_by(key)`: the grouped carrier its count/sum/mean reducers read.
DataGroupedQuery: struct<T, K> {
    __query: Query<T>
    __key: Shared<__QueryKeyCell<T, K>>
}

DataTracked: struct<T, K> {
    snapshot: DataSnapshot<[T]>
}

DataWatch: struct<T> {
    query: Query<T>
    status: DataWatchStatus
}

