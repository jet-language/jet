use {
    core: core
    core.data.[DataAuthority, DataError, DataErrorKind, DataFormat, DataFreshness, DataInvalidationCause, DataLimits, DataLoader, DataLoaderKind, DataLoaderStatus, DataSnapshotIdentity, DataSourceIdentity, DataStream]
    core.encoding.[Format]
    cbor: core.encoding.cbor
    json: core.encoding.json
}

loader_error: fn(kind: DataErrorKind, reason: String, operation: String) -> DataError Never! {
    DataError{
        kind: kind,
        operation: operation,
        row: None,
        column: None,
        index: None,
        reason: reason,
        cause: None,
    }
}

// core.data.loader — lifecycle for a typed, provider-owned DataLoader<T>.
//
// Payload bytes are a pending input until snapshot/stream validation commits
// them.  `last_good` is only changed by that commit, so bind/mark_stale can
// retain a known snapshot without falsely reporting a fresh one.

bind: fn<T>(loader: ^DataLoader<T>, payload: [U8]) DataError! {
    if loader.canceled {
        return Err(loader_error(DataErrorKind.State, "loader was canceled", source_path<T>(loader)))
    }
    if !accepts_payload<T>(loader) {
        return Err(
            loader_error(
                DataErrorKind.InvalidArgument,
                "only URL, database, or archive-member loaders accept provider payloads",
                "data.loader.bind",
            ),
        )
    }
    bytes := payload.len()
    if bytes > loader.limits.encoding.max_item_bytes {
        return Err(loader_error(DataErrorKind.Limit, "payload exceeds max_item_bytes", "data.loader.bind"))
    }
    if loader.limits.encoding.max_total_bytes != None {
        total: loader.limits.encoding.max_total_bytes ?? 0
        if bytes > total {
            return Err(loader_error(DataErrorKind.Limit, "payload exceeds max_total_bytes", "data.loader.bind"))
        }
    }
    bound := copy_bytes(payload)
    loader.payload = Val(bound)
    loader.status.freshness = DataFreshness.Pending
    loader.status.error = ""
    loader.status.cleanup = if loader.last_good != None -> "retained" else -> "none"
    loader.status.buffered_bytes = bytes
    loader.status.backpressure = bytes > loader.limits.encoding.buffer_bytes
    loader.status.last_good = loader.last_good != None
    return
}

bind_text: fn<T>(loader: ^DataLoader<T>, text: String) DataError! { bind<T>(loader, text.bytes()) }

authority: fn<T>(loader: DataLoader<T>) -> DataAuthority Never! { loader.authority.copy() }

status: fn<T>(loader: DataLoader<T>) -> DataLoaderStatus Never! { loader.status.copy() }

ready: fn<T>(loader: DataLoader<T>) -> Bool Never! {
    !loader.canceled && !loader.status.backpressure
}

needs_refresh: fn<T>(loader: DataLoader<T>) -> Bool Never! {
    if loader.status.freshness == DataFreshness.Fresh || loader.status.freshness == DataFreshness.Offline || loader.status.freshness == DataFreshness.Canceled {
        return false
    }
    true
}

snapshot_reusable: fn(previous: DataSnapshotIdentity, current: DataSnapshotIdentity) -> Bool Never! {
    previous.id == current.id && previous.source == current.source && previous.content == current.content && previous.schema == current.schema && previous.format == current.format
}

source_identity: fn<T>(loader: DataLoader<T>) -> DataSourceIdentity Never! { loader.source.copy() }

cancel: fn<T>(loader: ^DataLoader<T>) Never! {
    loader.canceled = true
    if loader.source.kind != DataLoaderKind.Value -> loader.payload = None
    loader.status.freshness = DataFreshness.Canceled
    loader.status.error = "loader was canceled"
    if loader.source.kind == DataLoaderKind.Value -> loader.status.cleanup = "retained" else {
        loader.status.cleanup = "payload-released"
    }
    loader.status.buffered_bytes = 0
    loader.status.backpressure = false
    loader.status.last_good = loader.last_good != None
}

offline: fn<T>(loader: ^DataLoader<T>, enabled: Bool) Never! {
    loader.offline = enabled
    if enabled {
        if loader.payload == None && loader.last_good != None {
            loader.status.freshness = DataFreshness.Offline
        }
        return
    }
    if loader.status.freshness != DataFreshness.Offline {
        return
    }
    if loader.payload != None -> loader.status.freshness = DataFreshness.Pending else if loader.last_good != None && loader.status.invalidated_by == DataInvalidationCause.NoCause {
        loader.status.freshness = DataFreshness.Fresh
    } else if loader.last_good != None { loader.status.freshness = DataFreshness.Stale } else {
        loader.status.freshness = DataFreshness.Pending
    }
}

mark_stale: fn<T>(loader: ^DataLoader<T>, cause: DataInvalidationCause) Never! {
    loader.status.invalidated_by = cause.copy()
    loader.status.freshness = DataFreshness.Stale
    loader.status.error = ""
    if loader.source.kind != DataLoaderKind.Value -> loader.payload = None
    loader.status.cleanup = if loader.last_good != None -> "retained" else -> "none"
    loader.status.buffered_bytes = 0
    loader.status.backpressure = false
    loader.status.last_good = loader.last_good != None
}

stream: fn<T: Decode>(loader: DataLoader<T>) -> DataStream<T> DataError! {
    if loader.canceled {
        return Err(loader_error(DataErrorKind.State, "loader stream was canceled", source_path<T>(loader)))
    }
    if loader.format == None {
        return Err(loader_error(DataErrorKind.Bridge, "a loader made by `file_as` or `url_as` streams with `stream_as`", source_path<T>(loader)))
    }
    bytes_opt := loader.payload
    if bytes_opt == None && loader.offline -> bytes_opt = loader.last_good
    bytes: bytes_opt ?? return Err(loader_error(DataErrorKind.State, "loader has no bound payload", source_path<T>(loader)))
    text: String.from_bytes(bytes) ?? return Err(loader_error(DataErrorKind.Decode, "loader payload is not UTF-8", source_path<T>(loader)))
    rows := [T]{}
    if loader.format == Val(DataFormat.CSV) {
        rows = core.data.csv<T>(text) ?? return Err(loader_error(DataErrorKind.Decode, "CSV stream decode failed", source_path<T>(loader)))
    } else if loader.format == Val(DataFormat.JSON) {
        rows = core.data.json<T>(text) ?? return Err(loader_error(DataErrorKind.Decode, "JSON stream decode failed", source_path<T>(loader)))
    } else if loader.format == Val(DataFormat.JSONL) {
        rows = decode_jsonl<T>(text) ?? return Err(loader_error(DataErrorKind.Decode, "JSONL stream decode failed", source_path<T>(loader)))
    } else {
        return Err(loader_error(DataErrorKind.Bridge, "provider-backed stream is required for this format", source_path<T>(loader)))
    }
    if rows.len() > loader.limits.max_output_rows {
        return Err(loader_error(DataErrorKind.Limit, "max_output_rows exceeded", "data.loader.stream"))
    }
    core.data.stream.from_items<T>(rows)
}

/// The rows of a loader made by `core.data.file_as` or `url_as` over the
/// `Format` `F`: `F.read` gives the payload's tree, which decodes as the rows.
/// A URL loader's payload is bound by its provider (`bind`); a file loader's
/// by `core.files.data.read`.
///
/// ```jet
/// remote := core.data.url_as<Int, json.Codec>("https://example.test/rows", "network", DataLimits.safe()) ?? panic("{err}")
/// bind<Int>(remote, "[1, 2]".bytes()) ?? panic("{err}")
/// rows := stream_as<Int, json.Codec>(remote) ?? panic("{err}")
/// (core.data.stream.collect<Int>(rows) ?? panic("{err}")) == [Int]{1, 2} // => true
/// local: core.data.file_as<Int, json.Codec>("rows.json", DataLimits.safe()) ?? panic("{err}")
/// local.codec == Val("json") // => true
/// ```
stream_as: fn<T: Decode, F: Format>(loader: DataLoader<T>) -> DataStream<T> DataError! {
    if loader.canceled {
        return Err(loader_error(DataErrorKind.State, "loader stream was canceled", source_path<T>(loader)))
    }
    if loader.codec != Val(F.name) {
        return Err(loader_error(DataErrorKind.Bridge, "this loader was not made over the `{F.name}` format", source_path<T>(loader)))
    }
    bytes_opt := loader.payload
    if bytes_opt == None && loader.offline -> bytes_opt = loader.last_good
    bytes: bytes_opt ?? return Err(loader_error(DataErrorKind.State, "loader has no bound payload", source_path<T>(loader)))
    tree: F.read(bytes) ?? return Err(loader_error(DataErrorKind.Decode, "{err}", source_path<T>(loader)))
    rows: tree.decode<[T]>() ?? return Err(loader_error(DataErrorKind.Decode, "`{F.name}` stream decode failed", source_path<T>(loader)))
    if rows.len() > loader.limits.max_output_rows {
        return Err(loader_error(DataErrorKind.Limit, "max_output_rows exceeded", "data.loader.stream"))
    }
    core.data.stream.from_items<T>(rows)
}

#Test("a loader over a Format streams the rows that format reads") {
    loader := core.data.url_as<Int, json.Codec>("https://example.test/rows", "network", DataLimits.safe()) ?? panic("loader")
    assert(loader.format == None)
    bind<Int>(loader, "[1, 2]".bytes()) ?? panic("bind")
    rows := stream_as<Int, json.Codec>(loader.copy()) ?? panic("stream")
    assert_eq(core.data.stream.collect<Int>(rows) ?? panic("collect"), [Int]{1, 2})
    if stream_as<Int, cbor.Codec>(loader.copy()) == {
        .Ok(_) -> { panic("a JSON loader streamed through CBOR") }
        .Err(failure) -> {
            assert_eq(failure.reason, "this loader was not made over the `cbor` format")
        }
    }
    if stream<Int>(loader) == {
        .Ok(_) -> { panic("a JSON-codec loader streamed as a Core data format") }
        .Err(failure) -> assert_eq(failure.kind, DataErrorKind.Bridge)
    }
}

accepts_payload: fn<T>(loader: DataLoader<T>) -> Bool Never! {
    if loader.source.kind == DataLoaderKind.URL || loader.source.kind == DataLoaderKind.Database {
        return true
    }
    loader.source.kind == DataLoaderKind.File && loader.source.member.len() > 0
}

decode_jsonl: fn<T: Decode>(text: String) -> [T] DataError! {
    out := [T]{}
    raw := text.bytes()
    start := 0
    loop i in 0..<(raw.len() + 1) {
        if i < raw.len() && raw[i] != (U8{10}) -> next
        end := i
        if end > start && raw[end - 1] == (U8{13}) -> end -= 1
        if end > start {
            line_bytes := raw[start..(end - 1)]
            line: String.from_bytes(line_bytes) ?? return Err(loader_error(DataErrorKind.Decode, "JSONL row is not UTF-8", "data.loader.stream"))
            if !blank(line) {
                wrapped := "[{line}]"
                row: core.data.json<T>(wrapped) ?? return Err(loader_error(DataErrorKind.Decode, "JSONL row decode failed", "data.loader.stream"))
                if row.len() != 1 {
                    return Err(loader_error(DataErrorKind.Decode, "JSONL row did not decode to one value", "data.loader.stream"))
                }
                out.push(row[0].copy())
            }
        }
        start = i + 1
    }
    Ok(out)
}

blank: fn(text: String) -> Bool Never! {
    if text.len() == 0 -> return true
    loop byte in text.bytes() {
        if byte != (U8{32}) && byte != (U8{9}) -> return false
    }
    true
}

source_path: fn<T>(loader: DataLoader<T>) -> String Never! { loader.source.locator }

copy_bytes: fn(bytes: [U8]) -> [U8] Never! {
    out := [U8]{}
    loop byte in bytes -> out.push(byte)
    out
}
