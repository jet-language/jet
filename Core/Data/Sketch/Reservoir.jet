// The shipped Algorithm R sampler, with its fixed xorshift seed and slot order.
ReservoirSampler: struct {
    state: ReservoirState

    impl Display {
        display: fn(self) -> String {
            "ReservoirSampler(n={self.state.count})"
        }
    }
}

ReservoirState: struct {
    capacity: Int
    items: [String]
    count: U64
    rng: U64
}

new: fn(capacity: Int) -> ReservoirSampler Never! { ReservoirSampler.new(capacity) }

impl ReservoirSampler {
    new: fn(capacity: Int) -> ReservoirSampler Never! {
        limit: if capacity < 1 -> 1 else -> capacity
        ReservoirSampler{state: ReservoirState{
            capacity: limit,
            items: [String]{},
            count: U64{0},
            rng: U64{16045690984503098046},
        }}
    }

    add: fn(&self, item: String) Never! {
        self.state.count = self.state.count.wrapping_add(U64{1})
        if self.state.items.len() < self.state.capacity {
            &self.state.items.push(item)
            return
        }
        state := self.state.rng
        state = state.bit_xor((state << 13))
        state = state.bit_xor((state >> 7))
        state = state.bit_xor((state << 17))
        self.state.rng = state
        index: state %% self.state.count
        if index < (U64{self.state.capacity}) -> self.state.items[Int.from_u64(index)] = item
    }

    sample: fn(self) -> [String] Never! {
        self.state.items.copy()
    }
}

#Test("reservoir keeps filled slots and native minimum capacity") {
    sampler := new(3)
    &sampler.add("x")
    clone := sampler.copy()
    &clone.add("y")
    &clone.add("z")
    assert_eq(sampler.sample(), [String]{"x"})
    assert_eq(clone.sample(), [String]{"x", "y", "z"})
    minimum := new(-1)
    &minimum.add("only")
    assert_eq(minimum.sample(), [String]{"only"})
}

#Test("reservoir replacement is replayable") {
    left := new(3)
    right := new(3)
    loop i in 0..<20 {
        &left.add("{i}")
        &right.add("{i}")
    }
    assert_eq(left.sample(), right.sample())
}
