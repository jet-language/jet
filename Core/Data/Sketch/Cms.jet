// The shipped width-256/depth-4 count-min sketch. Seeded FNV hashing and
// unit increments live in Jet; cloning copies the counter value independently.
use core.data.sketch as sketch

struct CountMinSketch {
    counters: [Int]

    impl Display {
        fn display(self) -> String { "CountMinSketch" }
    }
}

fn new() -> CountMinSketch Never! { CountMinSketch.new() }

impl CountMinSketch {
    fn new() -> CountMinSketch Never! {
        counters := [Int]{}
        loop _ in 0..<1024 -> &counters.push(0)
        CountMinSketch{counters: counters}
    }

    fn add(&self, key: String) Never! {
        (first, second) :: hashes(key)
        loop row in 0..<4 {
            index :: counter_index(first, second, row)
            if self.counters[index] < 4294967295 -> self.counters[index] = self.counters[index] + 1
        }
    }

    fn count(self, key: String) -> Int Never! {
        (first, second) :: hashes(key)
        count := self.counters[counter_index(first, second, 0)]
        loop row in 1..<4 {
            value :: self.counters[counter_index(first, second, row)]
            if value < count -> count = value
        }
        count
    }
}

fn hashes(key: String) -> (first: U64, second: U64) Never! {
    seed :: U64{14695981039346656037}
    (first: sketch.__fnv1a64(key, seed), second: sketch.__fnv1a64(key, seed.wrapping_add(U64{3735928559})))
}

fn counter_index(first: U64, second: U64, row: Int) -> Int Never! {
    column :: first.wrapping_add(second.wrapping_mul(U64{row + 1})).bit_and(U64{255})
    row * 256 + Int.from_u64(column)
}

/// Merge by adding corresponding counters, as the existing source API does.
fn merge(a: CountMinSketch, b: CountMinSketch) -> CountMinSketch Never! {
    counters := a.counters.copy()
    loop i in 0..<1024 -> counters[i] = counters[i] + b.counters[i]
    CountMinSketch{counters: counters}
}

#Test("CMS retains unit counts, independent clones and additive merge") {
    cms := new()
    &cms.add("hello")
    clone := cms.copy()
    &clone.add("hello")
    &clone.add("world")
    assert_eq(cms.count("hello"), 1)
    assert_eq(cms.count("world"), 0)
    assert_eq(clone.count("hello"), 2)
    assert_eq(cms.count("absent"), 0)
    combined :: merge(cms, clone)
    assert_eq(combined.count("hello"), 3)
    assert_eq(combined.count("world"), 1)
}
