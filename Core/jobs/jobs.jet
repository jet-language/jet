package {
    name: "core.jobs"
    version: "0.0.1"
    edition: "2026"
    description: "Durable, authority-bound at-least-once job queues."
    license: "MIT"
    outputs: {
        jobs: .Library{ entry: jobs }
    }
}

use core as core

// D-JOB-QUEUE1: one durable queue. JobQueue is the opaque provider handle;
// its receiver operations perform atomic storage/lease/receipt transactions.
// It is not a second in-memory record collection. Payloads and outcomes keep
// their declared type identity and bytes, with publication explicitly opted in.

pub enum JobQueueDeliveryPolicy { AtLeastOnce }

pub enum JobQueueState {
    Queued
    Running
    Retrying
    Completed
    Failed
    DeadLettered
    Cancelled
}

pub struct JobPayload {
    pub type_id: String
    pub bytes: [U8]
    pub publish: Bool
}

pub struct JobResult {
    pub type_id: String
    pub bytes: [U8]
    pub publish: Bool
}

pub struct JobError {
    pub type_id: String
    pub reason: String
    pub detail: String?
}

pub struct JobQueueReceipt {
    pub id: String
    pub authority: String
    pub queue: String
    pub job_type: String
    pub state: JobQueueState
    pub sequence: Int
    pub attempts: Int
    pub due_at_ms: Int
    pub accepted_at_ms: Int
    pub request_id: String?
    pub idempotency_key: String?
    pub lease_until_ms: Int?
    pub duration_ms: Int?
    pub error_reason: String?
    pub delivery: JobQueueDeliveryPolicy
    pub duplicate: Bool
    pub signature: String
}

pub struct JobQueueClaim {
    pub receipt: JobQueueReceipt
    pub payload: JobPayload
    pub worker: String
    pub lease_token: String
    pub lease_until_ms: Int
}

pub struct JobQueueEvent {
    pub sequence: Int
    pub state: JobQueueState
    pub attempts: Int
    pub timestamp_ms: Int
    pub reason: String?
    pub duration_ms: Int?
    pub worker: String?
}

pub struct JobQueueRecord {
    pub receipt: JobQueueReceipt
    pub payload: JobPayload?
    pub result: JobResult?
    pub error: JobError?
    pub started_at_ms: Int?
    pub finished_at_ms: Int?
}

pub struct JobQueueStatus {
    pub queue: String
    pub authority: String
    pub queued: Int
    pub running: Int
    pub retrying: Int
    pub completed: Int
    pub failed: Int
    pub dead_lettered: Int
    pub cancelled: Int
    pub depth: Int
    pub wait_ms: Int
    pub throughput: Int
    pub capacity: Int
    pub paused: Bool
    pub freshness_ms: Int
}

// Opening validates the package authority and selected provider. The handle's
// enqueue/delay/receipt/inspect/events/claim/heartbeat/acknowledge/fail/cancel/
// dead_letter/recover_expired/status/pause/resume/wait/prune methods retain
// ServiceError failures; mutation is committed by the provider before return.
pub fn queue() -[DB]> JobQueue ServiceError! { core.jobs.queue() }

// Pure state policy belongs in Jet. The provider owns atomic transitions, not
// an independently mutable copy of a queue's records.
pub fn is_terminal(state: JobQueueState) -> Bool Never! {
    state == JobQueueState.Completed
        || state == JobQueueState.Failed
        || state == JobQueueState.DeadLettered
        || state == JobQueueState.Cancelled
}

pub fn is_cancelled(state: JobQueueState) -> Bool Never! {
    state == JobQueueState.Cancelled
}
