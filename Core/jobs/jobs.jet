package {
    name: "core.jobs"
    version: "0.0.1"
    edition: "2026"
    description: "Durable job queues."
    license: "MIT"
    outputs: {
        jobs: .Library{ entry: jobs }
    }
}

// core.jobs — an in-memory at-least-once queue.
//
// `queue` is the constructor. Enqueue assigns a monotonic id. `claim` moves
// Queued → Running; `ack` completes; `fail` retries until `max_attempts`
// then dead-letters. Persistence is a later host cell; the state machine
// is Jet so tests do not need a broker.

#Error
enum JobError {
    Empty
    Duplicate
    Failed
    Missing
}

enum JobQueueDeliveryPolicy {
    AtLeastOnce
}

enum JobQueueState {
    Queued
    Running
    Retrying
    Completed
    Failed
    DeadLettered
    Cancelled
}

struct JobPayload { body: String }
struct JobResult { ok: Bool, detail: String }
struct JobQueueReceipt { id: String }
struct JobQueueClaim { id: String, payload: String }
struct JobQueueEvent { kind: String, id: String }
struct JobQueueRecord {
    id: String
    payload: String
    state: JobQueueState
    attempts: Int
}
struct JobQueueStatus {
    queued: Int
    running: Int
    done: Int
    failed: Int
}

struct JobQueue {
    name: String
    next_id: Int
    max_attempts: Int
    policy: JobQueueDeliveryPolicy
    records: [JobQueueRecord]
}

fn queue() -> JobQueue Never! {
    JobQueue{name: "default", next_id: 1, max_attempts: 8, policy: JobQueueDeliveryPolicy.AtLeastOnce, records: [JobQueueRecord]{}}
}

/// Return a queue with a bounded retry budget. A non-positive budget is
/// normalized to one attempt so a failed claim cannot loop forever.
fn with_max_attempts(q: JobQueue, max_attempts: Int) -> JobQueue Never! {
    limit := max_attempts
    if limit < 1 -> limit = 1
    if limit > 1000000 -> limit = 1000000
    JobQueue{
        name: q.name,
        next_id: q.next_id,
        max_attempts: limit,
        policy: q.policy,
        records: ~q.records,
    }
}

fn queue_name(q: JobQueue) -> String Never! { q.name }
fn named(name: String) -> JobQueue JobError! {
    if !valid_queue_name(name) -> return Err(JobError.Empty)
    q :: queue()
    JobQueue{name: name, next_id: 1, max_attempts: q.max_attempts, policy: q.policy, records: [JobQueueRecord]{}}
}


fn enqueue(q: JobQueue, job: String) -> (queue: JobQueue, receipt: JobQueueReceipt) JobError! {
    if !valid_job_payload(job) -> return Err(JobError.Empty)
    if q.next_id < 1 || q.next_id >= 9223372036854775807 -> return Err(JobError.Failed)
    id :: "{q.next_id}"
    recs := copy_recs(q.records)
    &recs.push(JobQueueRecord{id: id, payload: job, state: JobQueueState.Queued, attempts: 0})
    nq :: JobQueue{name: q.name, next_id: q.next_id + 1, max_attempts: q.max_attempts, policy: q.policy, records: recs}
    (queue: nq, receipt: JobQueueReceipt{id: id})
}

fn claim(q: JobQueue) -> (queue: JobQueue, taken: JobQueueClaim?) Never! {
    recs := copy_recs(q.records)
    limit := q.max_attempts
    if limit < 1 -> limit = 1
    changed := false
    loop i in 0..<recs.len() {
        st :: recs[i].state
        if st == JobQueueState.Queued || st == JobQueueState.Retrying {
            if recs[i].attempts < 0 -> recs[i].attempts = 0
            if st == JobQueueState.Retrying && recs[i].attempts >= limit {
                recs[i].state = JobQueueState.DeadLettered
                changed = true
                next
            }
            if recs[i].attempts >= 9223372036854775807 {
                recs[i].state = JobQueueState.DeadLettered
                changed = true
                next
            }
            recs[i] = JobQueueRecord{
                id: recs[i].id,
                payload: recs[i].payload,
                state: JobQueueState.Running,
                attempts: recs[i].attempts + 1,
            }
            nq :: JobQueue{
                name: q.name,
                next_id: q.next_id,
                max_attempts: limit,
                policy: q.policy,
                records: ~recs,
            }
            return (queue: nq, taken: Val(JobQueueClaim{id: ~recs[i].id, payload: ~recs[i].payload}))
        }
    }
    if changed {
        return (queue: JobQueue{name: q.name, next_id: q.next_id, max_attempts: limit, policy: q.policy, records: ~recs}, taken: None)
    }
    (queue: q, taken: None)
}

fn ack(q: JobQueue, id: String) -> JobQueue JobError! {
    set_state(q, id, JobQueueState.Completed)
}

fn fail(q: JobQueue, id: String) -> JobQueue JobError! {
    if !valid_job_id(id) -> return Err(JobError.Missing)
    recs := copy_recs(q.records)
    limit := q.max_attempts
    if limit < 1 -> limit = 1
    loop i in 0..<recs.len() {
        if recs[i].id != id -> next
        if recs[i].state != JobQueueState.Running -> return Err(JobError.Failed)
        next_state :: if recs[i].attempts >= limit -> JobQueueState.DeadLettered else -> JobQueueState.Retrying
        recs[i] = JobQueueRecord{
            id: ~recs[i].id,
            payload: ~recs[i].payload,
            state: next_state,
            attempts: recs[i].attempts,
        }
        return Ok(JobQueue{
            name: q.name,
            next_id: q.next_id,
            max_attempts: limit,
            policy: q.policy,
            records: ~recs,
        })
    }
    Err(JobError.Missing)
}

fn cancel(q: JobQueue, id: String) -> JobQueue JobError! {
    if !valid_job_id(id) -> return Err(JobError.Missing)
    set_state(q, id, JobQueueState.Cancelled)
}
fn status(q: JobQueue) -> JobQueueStatus Never! {
    queued := 0
    running := 0
    done := 0
    failed := 0
    loop r in q.records {
        if r.state == JobQueueState.Queued || r.state == JobQueueState.Retrying -> queued += 1
        if r.state == JobQueueState.Running -> running += 1
        if r.state == JobQueueState.Completed -> done += 1
        if r.state == JobQueueState.Failed || r.state == JobQueueState.DeadLettered -> failed += 1
    }
    JobQueueStatus{queued: queued, running: running, done: done, failed: failed}
}

fn set_state(q: JobQueue, id: String, state: JobQueueState) -> JobQueue JobError! {
    if !valid_job_id(id) -> return Err(JobError.Missing)
    recs := copy_recs(q.records)

    loop i in 0..<recs.len() {
        if recs[i].id != id -> next
        current :: recs[i].state
        if current == state -> return Err(JobError.Duplicate)
        if state == JobQueueState.Completed && current != JobQueueState.Running {
            return Err(JobError.Failed)
        }
        if state == JobQueueState.Cancelled {
            if current != JobQueueState.Queued && current != JobQueueState.Running && current != JobQueueState.Retrying {
                return Err(JobError.Failed)
            }
        }
        recs[i] = JobQueueRecord{id: ~recs[i].id, payload: ~recs[i].payload, state: state, attempts: recs[i].attempts}
        return Ok(JobQueue{name: q.name, next_id: q.next_id, max_attempts: q.max_attempts, policy: q.policy, records: ~recs})
    }
    Err(JobError.Missing)
}
fn state(q: JobQueue, id: String) -> JobQueueState? Never! {
    loop record in ~q.records {
        if record.id == id -> return Val(record.state)
    }
    None
}

fn attempts(q: JobQueue, id: String) -> Int Never! {
    loop record in ~q.records {
        if record.id == id -> return record.attempts
    }
    0
}

fn payload(q: JobQueue, id: String) -> String? Never! {
    loop record in ~q.records {
        if record.id == id -> return Val(record.payload)
    }
    None
}

fn event(q: JobQueue, id: String) -> JobQueueEvent? Never! {
    st :: state(q, id) ?? return None
    Val(JobQueueEvent{kind: state_name(st), id: id})
}

fn events(q: JobQueue) -> [JobQueueEvent] Never! {
    out := [JobQueueEvent]{}
    loop record in ~q.records {
        &out.push(JobQueueEvent{kind: state_name(record.state), id: record.id})
    }
    out
}

fn is_terminal(state: JobQueueState) -> Bool Never! {
    state == JobQueueState.Completed
        || state == JobQueueState.Failed
        || state == JobQueueState.DeadLettered
        || state == JobQueueState.Cancelled
}

fn is_cancelled(state: JobQueueState) -> Bool Never! {
    state == JobQueueState.Cancelled
}

fn state_name(state: JobQueueState) -> String Never! {
    if state == JobQueueState.Queued -> return "queued"
    if state == JobQueueState.Running -> return "running"
    if state == JobQueueState.Retrying -> return "retrying"
    if state == JobQueueState.Completed -> return "completed"
    if state == JobQueueState.Failed -> return "failed"
    if state == JobQueueState.DeadLettered -> return "dead-lettered"
    "cancelled"
}

fn copy_recs(xs: [JobQueueRecord]) -> [JobQueueRecord] Never! {
    out := [JobQueueRecord]{}
    loop x in xs -> &out.push(x)
    out
}
fn valid_queue_name(value: String) -> Bool Never! {
    trimmed :: value.trim()
    trimmed != "" && trimmed.len() <= 256 && value == trimmed && !has_control(value)
}

fn valid_job_payload(value: String) -> Bool Never! {
    value.len() > 0 && value.len() <= 1048576
}

fn valid_job_id(value: String) -> Bool Never! {
    if value.len() == 0 -> return false
    loop byte in value.bytes() {
        n :: Int.from_u8(byte)
        if n < 48 || n > 57 -> return false
    }
    true
}

fn has_control(value: String) -> Bool Never! {
    loop byte in value.bytes() {
        n :: Int.from_u8(byte)
        if n < 32 || n == 127 -> return true
    }
    false
}
