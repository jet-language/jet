// Several roots share one closure so each common predecessor is admitted once.
fn jet_job_run_graph_roots<F: Clone + Send + Sync, G: Send>(roots: [Int], jobs: [JetJobSpec], program: String, root_args: [String], sink: JetJobEventSinkHandle, scope_enter: F) ->
where F: fn() -> G? Err! {
