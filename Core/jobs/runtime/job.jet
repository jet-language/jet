// Rust: crates/jet-codegen/src/Prelude/Job.rs:568
fn jet_job_json_string(value: String) -> String {
    output := String.with_capacity(value.len().saturating_add(2))
    &output.push('"')
    loop character in value.chars() {
        match character {
            '"' -> &output.push_str("\\\""),
            '\\' -> &output.push_str("\\\\"),
            '\u{08}' -> &output.push_str("\\b"),
            '\u{0c}' -> &output.push_str("\\f"),
            '\n' -> &output.push_str("\\n"),
            '\r' -> &output.push_str("\\r"),
            '\t' -> &output.push_str("\\t"),
            c if c.is_control() -> &output.push_str("\\u{c as U32:04x}"),
            c -> &output.push(c),
        }
    }
    &output.push('"')
    ^output
}
// Rust: crates/jet-codegen/src/Prelude/Job.rs:590
fn jet_job_emit(sink: JetJobEventSinkHandle, timestamp_ms: U64, kind: String, state: String, job_id: String, name: String, queue: String, attempts: U32, duration_ms: U64?, worker: String?, request_id: String?, failure: String?) -> {
    duration :: duration_ms.map(value -> value.to_string()).unwrap_or_else(fn() -> "null")
    worker_json :: worker.map(jet_job_json_string).unwrap_or_else(fn() -> "null")
    request_json :: request_id.map(jet_job_json_string).unwrap_or_else(fn() -> "null")
    failure_json :: failure.map(jet_job_json_string).unwrap_or_else(fn() -> "null")
    fields :: "{{\"event\":{jet_job_json_string(kind)},\"state\":{jet_job_json_string(state)},\"job_id\":{jet_job_json_string(job_id)},\"name\":{jet_job_json_string(name)},\"queue\":{jet_job_json_string(queue)},\"attempts\":{attempts},\"duration_ms\":{duration},\"worker\":{worker_json},\"request_id\":{request_json},\"failure\":{failure_json}}}"
    if JetDevtoolsEvent.from_parts(timestamp_ms, "job-runtime", "Job", job_id, fields) is Ok(event) {
        sink.publish(~event)
        jet_devtools_publish_event(^event)
    }
}
