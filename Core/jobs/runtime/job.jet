        _ :: stack.pop()
        state[index] = U8{2}
        Ok(())
    }
    state := [U8].filled(jobs.len(), U8{0})
    stack := [Int]{}
    loop index in 0..<jobs.len() -> visit(index, jobs, names, &state, &stack)?
    Ok(())
}
