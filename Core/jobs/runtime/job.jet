        ready := pending.keys().copied().filter(index -> jet_job_dependency_indices(jobs, index).iter().all(dependency -> status.get(dependency) == Val(true))).collect()
        &ready.sort_by((left, right) -> jobs[left].entry.name.cmp(jobs[right].entry.name).then_with(fn() -> left.cmp(right)))
        if ready.is_empty() {
            cancelled := pending.keys().copied().collect()
            &cancelled.sort()
            loop index in cancelled {
                &pending.remove(index)
                &status.insert(index, false)
                jet_job_emit_cancelled(jobs[index], sink, "job graph made no schedulable progress")
            }
            break
        }
