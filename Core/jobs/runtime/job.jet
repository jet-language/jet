fn jet_job_glob_match(pattern: String, value: String) -> Bool {
    p :: pattern.as_bytes()
    v :: value.as_bytes()
    row := [Bool].filled(v.len() + 1, false)
    row[0] = true
    loop token in p {
        next := [Bool].filled(v.len() + 1, false)
        if token == U8{42} {
            next[0] = row[0]
            loop index in 1..=v.len() -> next[index] = row[index] || next[index - 1]
        } else {
            loop index in 1..=v.len() {
                if token == U8{63} || token == v[index - 1] -> next[index] = row[index - 1]
            }
        }
        row = ^next
    }
    row[v.len()]
}
