    fn visit(index: Int, jobs: [JetJobSpec], names: [String:[Int]], state: &[U8], stack: &[Int]) -> () Err! {
        if state[index] == U8{2} -> return Ok(())
        if state[index] == U8{1} {
            start :: stack.iter().position(candidate -> candidate == index).unwrap_or(0)
            cycle :: stack[start..].iter().map(candidate -> jobs[candidate].entry.name).chain([jobs[index].entry.name]).collect().join(" -> ")
            return Err("job graph contains a cycle: {cycle}")
        }
        state[index] = U8{1}
        &stack.push(index)
        loop dependency in jobs[index].after {
            if names.get(dependency).and_then(indices -> indices.first()) is Val(candidate) -> visit(candidate, jobs, names, &state, &stack)?
