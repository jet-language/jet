    }
}
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1120
pub fn jet_job_dispatch_specs<F: Clone + Send + Sync, G: Send>(argv: [String], jobs: [JetJobSpec], scope_enter: F) -> Bool
where F: fn() -> G? Err! { jet_job_dispatch_specs_with_sink(argv, jobs, jet_job_event_sink(), scope_enter) }
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1133
pub fn jet_job_dispatch_specs_with_sink<F: Clone + Send + Sync, G: Send>(argv: [String], jobs: [JetJobSpec], sink: JetJobEventSinkHandle, scope_enter: F) -> Bool
where F: fn() -> G? Err! {
    specs :: jobs.iter().map(job -> (job.entry.name, job.entry.scope)).collect()
    if specs.is_empty() -> return false
    if argv.get(1) == Val(JET_JOB_PRIVATE_DISPATCH_FLAG) {
        name :: argv.get(2) ?? jet_job_graph_failure("private job dispatch is missing a job name")
        index :: jobs.iter().position(job -> job.entry.name == name) ?? jet_job_graph_failure("private job dispatch names unknown job `{name}`")
        if jet_job_validate_graph(jobs) is Err(reason) -> jet_job_graph_failure(reason)
        args :: argv[3..].to_vec()
        if jobs[index].validate is Val(validate) {
            if validate(args) is Err(reason) -> jet_job_graph_failure("job `{jobs[index].entry.name}` received invalid arguments: {reason}")
        }
        jet_job_run_graph(index, jobs, argv.first().cloned().unwrap_or_else(fn() -> "program"), args, sink, scope_enter.clone())
        return true
    }
    if !jet_job_has_visible(specs) {
        name :: argv.get(1) ?? return false
        if name.starts_with('-') || !specs.iter().any((job_name, _) -> job_name == name) -> return false
        jet_job_unknown(argv, specs, name)
    }
    match jet_job_select(argv, specs) {
        .Ordinary -> false,
        .Help -> { jet_job_help(argv, specs); true },
        .Job(index) -> {
            if jet_job_validate_graph(jobs) is Err(reason) -> jet_job_graph_failure(reason)
            // Wrapper and validator both take job args only, excluding program/job.
            args :: argv[2..].to_vec()
            if jobs[index].validate is Val(validate) {
                if validate(args) is Err(reason) -> jet_job_graph_failure("job `{jobs[index].entry.name}` received invalid arguments: {reason}")
            }
            jet_job_run_graph(index, jobs, argv.first().cloned().unwrap_or_else(fn() -> "program"), args, sink, scope_enter.clone())
            true
        },
        .Unknown -> jet_job_unknown(argv, specs, argv.get(1).unwrap_or("")),
    }
}
