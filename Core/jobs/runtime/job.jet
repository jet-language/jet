fn jet_job_validate_graph(jobs: [JetJobSpec]) -> () Err! {
    names := [String:[Int]]{}
    loop (index, job) in jobs.iter().enumerate() {
        if job.parallel == 0 -> return Err("job `{job.entry.name}` declares a zero parallel bound")
