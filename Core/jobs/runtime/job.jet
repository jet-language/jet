    loop root in roots -> collect(root, jobs, &closure)
    pending := ^closure
    status := [Int:Bool]{}
    limit :: pending.keys().map(index -> jobs[index].parallel).max().unwrap_or(1).max(1)
    while !pending.is_empty() {
        pending_now := pending.keys().copied().collect()
        &pending_now.sort()
