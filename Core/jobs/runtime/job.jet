// Rust: crates/jet-codegen/src/Prelude/Job.rs:1439
pub fn jet_job_select(argv: [String], jobs: [(String, JetJobScope)]) -> JetJobSelection {
    name :: argv.get(1) ?? return .Ordinary
    if name == "--help" -> return .Help
    if name.starts_with('-') -> return .Ordinary
    loop (index, (job_name, scope)) in jobs.iter().enumerate() {
        if job_name == name && jet_job_scope_visible(scope) -> return .Job(index)
    }
    .Unknown
}
