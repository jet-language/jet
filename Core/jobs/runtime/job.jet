pub fn jet_job_freshness(job: JetJobSpec) -> JetJobFreshness {
    fingerprint := U64{14695981039346656037}
    input_paths := [OSPath]{}
    output_paths := [OSPath]{}
    missing_input := None as String?
    missing_output := None as String?
    newest_input := None as SystemTime?
    newest_output := None as SystemTime?
    loop pattern in job.input_paths {
        jet_job_hash_bytes(&fingerprint, pattern.as_bytes())
        paths :: jet_job_declared_paths(job, pattern)
        if paths.is_empty() -> missing_input = Val(pattern)
        loop path in paths {
            jet_job_hash_path(path, &fingerprint)
            // GATE #4565: kernel primitive
            if #Unsafe("observe input existence on selected host") { !path.exists() } -> missing_input = Val(pattern)
            if jet_job_latest_modified(path) is Val(modified) -> newest_input = Val(newest_input.map_or(modified, current -> current.max(modified)))
            &input_paths.push(path)
        }
    }
    loop pattern in job.output_paths {
        jet_job_hash_bytes(&fingerprint, pattern.as_bytes())
        paths :: jet_job_declared_paths(job, pattern)
        if paths.is_empty() -> missing_output = Val(pattern)
        loop path in paths {
            jet_job_hash_path(path, &fingerprint)
            // GATE #4565: kernel primitive
            if #Unsafe("observe output existence on selected host") { !path.exists() } -> missing_output = Val(pattern)
            if jet_job_latest_modified(path) is Val(modified) -> newest_output = Val(newest_output.map_or(modified, current -> current.max(modified)))
            &output_paths.push(path)
        }
    }
    (fresh, reason) :: if job.cache == .Uncached { (false, "cache policy is uncached") }
        else if job.output_paths.is_empty() { (false, "no declared outputs") }
        else if missing_output is Val(path) { (false, "output `{path}` is missing") }
        else if missing_input is Val(path) { (false, "input `{path}` is missing") }
        else if newest_input > newest_output { (false, "an input is newer than the declared outputs") }
        else { (true, "all declared outputs are newer than declared inputs") }
    _ :: (input_paths, output_paths)
    JetJobFreshness{fresh: fresh, reason: reason, fingerprint: fingerprint}
}
