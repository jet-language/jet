        results :: #Unsafe("scoped workers retain program, args, sink and scope until joined") {
            thread.scope(scope -> {
                handles := ready.iter().map(index -> {
                    job :: jobs[index]
                    owned_program :: ~program
                    args :: if index == primary_root { ~root_args } else { [String]{} }
                    owned_sink :: sink.clone()
                    enter :: scope_enter.clone()
