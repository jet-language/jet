}
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1317
fn jet_args_program_name(prog: String) -> String {
    if prog.is_empty() -> return "program"
    OSPath.new(prog).file_name().and_then(name -> name.to_str()).unwrap_or(prog).to_string()
}
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1329
pub fn jet_args_source_program_name(prog: String) -> String {
    (program, suffix) :: prog.split_once(' ').unwrap_or((prog, ""))
    name :: jet_args_program_name(program)
    source := name.strip_suffix(".jet").unwrap_or(name) // #4303
    if suffix.is_empty() { source.to_string() } else { "{source} {suffix}" }
}
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1347
pub fn jet_cli_banner(text: String) -> String { "{text}\n" }
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1351
#Clone
#Comparable
pub enum JetJobSelection { Ordinary, Help, Job(Int), Unknown }
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1359
fn jet_job_scope_visible(scope: JetJobScope) -> Bool {
    match scope { .Dev -> !target.jet_release(), .Ship -> true, .Internal -> false }
}
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1368
fn jet_job_scope_name(scope: JetJobScope) -> String { match scope { .Dev -> "dev", .Ship -> "ship", .Internal -> "internal" } }
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1376
pub fn jet_job_has_visible(jobs: [(String, JetJobScope)]) -> Bool { jobs.iter().any((_, scope) -> jet_job_scope_visible(scope)) }
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1380
pub fn jet_job_help_text(argv: [String], jobs: [(String, JetJobScope)]) -> String {
    program :: jet_args_source_program_name(argv.first().unwrap_or(""))
    text := "Usage: {program} <job> [options]\n\nJobs:"
    loop (name, scope) in jobs {
        if jet_job_scope_visible(scope) -> &text.push_str("\n  {name:<20} {jet_job_scope_name(scope)}")
    }
    &text.push('\n')
    ^text
}
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1392
pub fn jet_job_help(argv: [String], jobs: [(String, JetJobScope)]) -> {
    // GATE #4565: kernel primitive
    #Unsafe("write exact help text to stdout without another newline") { env.print(jet_job_help_text(argv, jobs)) }
}
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1401
pub const JET_JOB_UNKNOWN_WHY: String = "The first program subcommand must name a function marked `#Job`."
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1404
pub const JET_JOB_UNKNOWN_FIX: String = "Mark a function `#Job`, or check the subcommand spelling."
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1408
pub fn jet_job_unknown_what(name: String) -> String { "No job named `{name}`" }
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1417
pub fn jet_job_declared_detail(names: [String]) -> String { "declared jobs: {names.join(", ")}" }
// Rust: crates/jet-codegen/src/Prelude/Job.rs:1421
fn jet_job_unknown(argv: [String], jobs: [(String, JetJobScope)], name: String) -> Never {
    program :: jet_args_source_program_name(argv.first().unwrap_or(""))
    dispatchable :: jobs.iter().filter((_, scope) -> jet_job_scope_visible(scope)).map((name, _) -> name).collect()
    // GATE #4565: kernel primitive
    #Unsafe("print registered E1294 diagnostic and exit actual process with exit2") {
        env.eprintln("Error [E1294]: {jet_job_unknown_what(name)}")
        env.eprintln(" Why: {JET_JOB_UNKNOWN_WHY}")
        env.eprintln(" Fix: {JET_JOB_UNKNOWN_FIX}")
        env.eprintln("More: jet-lang.dev/e/E1294")
        env.eprintln(jet_job_declared_detail(dispatchable))
        env.eprintln("\nUsage: {program} <job> [options]")
        process.exit(2)
