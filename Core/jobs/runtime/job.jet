// Rust: crates/jet-codegen/src/Prelude/Job.rs:318
fn jet_job_platform_matches(platform: String) -> Bool {
    match platform {
        "Linux" | "linux" -> target.selected_os() == .Linux,
        "MacOS" | "macOS" | "macos" -> target.selected_os() == .MacOS,
        "Windows" | "windows" -> target.selected_os() == .Windows,
        "FreeBSD" | "freebsd" -> target.selected_os() == .FreeBSD,
        _ -> false,
    }
}
