package: {
    name: "core.text.parse"
    version: "0.0.1"
    edition: "2026"
    description: "core.text.parse core library."
    license: "MIT"
    outputs: {
        parse: .Library{ entry: parse }
    }
}
use {
    unicode: core.text
    parse_unicode_string: core.text.runtime.kernel_unicode_string
}

// core.text.parse — scanning, splitting, and number parsers.
//
// These sit beside Unicode segmentation in `core.text`. Python's `str.split`
// `partition`, `find`, `replace`, `int()`, and `float()` are the bar; Jet
// returns `None` instead of raising on a bad number.
split: fn(text: String, sep: String) -> [String] Never! {
    if sep.bytes().len() == 0 -> return chars(text)
    out := [String]{}
    raw: text.bytes()
    needle: sep.bytes()
    start := 0
    i := 0
    loop i + needle.len() <= raw.len() {
        if match_at(raw, i, needle) {
            out.push(slice_b(raw, start, i))
            i = i + needle.len()
            start = i
            next
        }
        i = i + 1
    }
    out.push(slice_b(raw, start, raw.len()))
    out
}

rsplit: fn(text: String, sep: String, maxsplit: Int) -> [String] Never! {
    parts: split(text, sep)
    if maxsplit < 0 || parts.len() <= maxsplit + 1 -> return parts
    keep := parts.len() - maxsplit
    head := ""
    i := 0
    loop i < keep {
        if i == 0 -> head = parts[0] else -> head = "{head}{sep}{parts[i]}"
        i = i + 1
    }
    out := [String]{head}
    i = keep
    loop i < parts.len() {
        out.push(parts[i])
        i = i + 1
    }
    out
}

split_once: fn(text: String, sep: String) -> (found: Bool, head: String, tail: String) Never! {
    i: find(text, sep)
    if i < 0 -> return (head: text, tail: "", found: false)
    n: sep.bytes().len()
    (head: slice_str(text, 0, i), tail: slice_str(text, i + n, text.bytes().len()), found: true)
}

partition: fn(text: String, sep: String) -> (head: String, sep: String, tail: String) Never! {
    i: find(text, sep)
    if i < 0 -> return (head: text, sep: "", tail: "")
    n: sep.bytes().len()
    (head: slice_str(text, 0, i), sep: sep, tail: slice_str(text, i + n, text.bytes().len()))
}

rpartition: fn(text: String, sep: String) -> (head: String, sep: String, tail: String) Never! {
    i: rfind(text, sep)
    if i < 0 -> return (head: "", sep: "", tail: text)
    n: sep.bytes().len()
    (head: slice_str(text, 0, i), sep: sep, tail: slice_str(text, i + n, text.bytes().len()))
}

find: fn(text: String, needle: String) -> Int Never! {
    if needle.bytes().len() == 0 -> return 0
    raw: text.bytes()
    nd: needle.bytes()
    if nd.len() > raw.len() -> return -1
    loop i in 0..<(raw.len() - nd.len() + 1) {
        if match_at(raw, i, nd) -> return i
    }
    -1
}

rfind: fn(text: String, needle: String) -> Int Never! {
    if needle.bytes().len() == 0 -> return text.bytes().len()
    raw: text.bytes()
    nd: needle.bytes()
    if nd.len() > raw.len() -> return -1
    i := raw.len() - nd.len()
    loop i >= 0 {
        if match_at(raw, i, nd) -> return i
        i = i - 1
    }
    -1
}

count: fn(text: String, needle: String) -> Int Never! {
    if needle.bytes().len() == 0 -> return text.bytes().len() + 1
    n := 0
    i := 0
    step: needle.bytes().len()
    loop {
        j: find(slice_str(text, i, text.bytes().len()), needle)
        if j < 0 -> return n
        n = n + 1
        i = i + j + step
    }
}

replace: fn(text: String, old: String, new: String, count: Int) -> String Never! {
    if old.bytes().len() == 0 -> return text.copy()
    out := ""
    i := 0
    done := 0
    loop {
        rest: slice_str(text, i, text.bytes().len())
        j: find(rest, old)
        if j < 0 || (count >= 0 && done >= count) -> return "{out}{rest}"
        out = "{out}{slice_str(rest, 0, j)}{new}"
        i = i + j + old.bytes().len()
        done = done + 1
    }
}

starts_with: fn(text: String, prefix: String) -> Bool Never! {
    a: text.bytes()
    b: prefix.bytes()
    if b.len() > a.len() -> return false
    loop i in 0..<b.len() {
        if a[i] != b[i] -> return false
    }
    true
}

ends_with: fn(text: String, suffix: String) -> Bool Never! {
    a: text.bytes()
    b: suffix.bytes()
    if b.len() > a.len() -> return false
    off: a.len() - b.len()
    loop i in 0..<b.len() {
        if a[off + i] != b[i] -> return false
    }
    true
}

strip_prefix: fn(text: String, prefix: String) -> String Never! {
    if starts_with(text, prefix) -> return slice_str(text, prefix.bytes().len(), text.bytes().len())
    return text.copy()
}

strip_suffix: fn(text: String, suffix: String) -> String Never! {
    if ends_with(text, suffix) {
        return slice_str(text, 0, text.bytes().len() - suffix.bytes().len())
    }
    return text.copy()
}

parse_int: fn(text: String) -> Int? Never! { parse_int_base(text, 10) }

/// Parse the canonical integer representation used by String.parse.
parse: fn(text: String) -> Int? Never! { parse_int(text) }

parse_int_base: fn(text: String, base: Int) -> Int? Never! {
    if base < 2 || base > 36 -> return None
    raw: text.bytes()
    if raw.len() == 0 -> return None
    sign := 1
    i := 0
    if {
        raw[0] == (U8{45}) -> {
            sign = -1
            i = 1
        }
        raw[0] == (U8{43}) -> { i = 1 }
    }
    if i >= raw.len() -> return None
    n := 0
    any := false
    loop i < raw.len() {
        d: digit_value(raw[i])
        if d < 0 || d >= base -> return None
        n = n * base + d
        any = true
        i = i + 1
    }
    if !any -> return None
    Val(sign * n)
}

parse_float: fn(text: String) -> Float? Never! {
    raw: text.bytes()
    if raw.len() == 0 -> return None
    sign := Float{1}
    i := 0
    if {
        raw[0] == (U8{45}) -> {
            sign = Float{-1}
            i = 1
        }
        raw[0] == (U8{43}) -> { i = 1 }
    }
    acc := Float{0}
    seen := false
    loop i < raw.len() {
        n: raw[i]
        if n == 46 || n == 101 || n == 69 -> break
        d: n
        if d < 48 || d > 57 -> return None
        acc = acc * Float{10} + Float{d - 48}
        seen = true
        i = i + 1
    }
    if i < raw.len() && raw[i] == (U8{46}) {
        i = i + 1
        place := Float{1} / Float{10}
        loop i < raw.len() {
            n: raw[i]
            if n == 101 || n == 69 -> break
            d: n
            if d < 48 || d > 57 -> return None
            acc = acc + Float{d - 48} * place
            place = place / Float{10}
            seen = true
            i = i + 1
        }
    }
    if i < raw.len() && (raw[i] == (U8{101}) || raw[i] == (U8{69})) {
        i = i + 1
        exp_sign := 1
        if {
            i < raw.len() && raw[i] == (U8{45}) -> {
                exp_sign = -1
                i = i + 1
            }
            i < raw.len() && raw[i] == (U8{43}) -> { i = i + 1 }
        }
        exp := 0
        if i >= raw.len() -> return None
        loop i < raw.len() {
            d: raw[i]
            if d < 48 || d > 57 -> return None
            exp = exp * 10 + (d - 48)
            if exp > 10000 -> return None
            i = i + 1
        }
        pow := Float{1}
        k := 0
        loop k < exp {
            pow = pow * Float{10}
            k = k + 1
        }
        if exp_sign < 0 -> acc = acc / pow else -> acc = acc * pow
    }
    if !seen || i != raw.len() -> return None
    Val(sign * acc)
}

is_digit: fn(text: String) -> Bool Never! {
    if text.bytes().len() == 0 -> return false
    loop b in text.bytes() {
        n: b
        if n < 48 || n > 57 -> return false
    }
    true
}

is_alnum: fn(text: String) -> Bool Never! {
    if text.bytes().len() == 0 -> return false
    loop b in text.bytes() {
        n: b
        letter := (n >= 65 && n <= 90) || (n >= 97 && n <= 122)
        digit := n >= 48 && n <= 57
        if !letter && !digit -> return false
    }
    true
}

chars: fn(text: String) -> [String] Never! { unicode.scalars(text) }


match_at: fn(raw: [U8], i: Int, needle: [U8]) -> Bool {
    loop j in 0..<needle.len() {
        if raw[i + j] != needle[j] -> return false
    }
    true
}

slice_b: fn(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i >= raw.len() -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i = i + 1
    }
}

slice_str: fn(text: String, start: Int, end: Int) -> String { slice_b(text.bytes(), start, end) }

digit_value: fn(b: U8) -> Int Never! {
    n: b
    if n >= 48 && n <= 57 -> return n - 48
    if n >= 65 && n <= 90 -> return n - 55
    if n >= 97 && n <= 122 -> return n - 87
    return -1
}

join: fn(parts: [String], sep: String) -> String Never! {
    s := ""
    i := 0
    loop i < parts.len() {
        if i == 0 -> s = parts[0] else -> s = "{s}{sep}{parts[i]}"
        i = i + 1
    }
    s
}

splitlines: fn(text: String, keepends: Bool) -> [String] Never! {
    raw: text.bytes()
    out := [String]{}
    start := 0
    i := 0
    loop i < raw.len() {
        n: raw[i]
        if n == 10 || n == 13 {
            end := i
            eat := 1
            if n == 13 && i + 1 < raw.len() && raw[i + 1] == (U8{10}) -> eat = 2
            if keepends -> out.push(slice_b(raw, start, i + eat)) else {
                out.push(slice_b(raw, start, end))
            }
            i = i + eat
            start = i
            next
        }
        i = i + 1
    }
    if start <= raw.len() -> out.push(slice_b(raw, start, raw.len()))
    out
}

lstrip: fn(text: String) -> String Never! {
    raw: text.bytes()
    i := 0
    loop i < raw.len() {
        n: raw[i]
        if n != 32 && n != 9 && n != 10 && n != 13 -> return slice_b(raw, i, raw.len())
        i = i + 1
    }
    ""
}

rstrip: fn(text: String) -> String Never! {
    raw: text.bytes()
    i := raw.len()
    loop i > 0 {
        n: raw[i - 1]
        if n != 32 && n != 9 && n != 10 && n != 13 -> return slice_b(raw, 0, i)
        i = i - 1
    }
    ""
}

strip: fn(text: String) -> String Never! { lstrip(rstrip(text)) }

ljust: fn(text: String, width: Int, fill: String) -> String Never! {
    pad: fill_to(fill)
    n := width - text.bytes().len()
    if n <= 0 -> return text.copy()
    "{text}{repeat_char(pad, n)}"
}

rjust: fn(text: String, width: Int, fill: String) -> String Never! {
    pad: fill_to(fill)
    n := width - text.bytes().len()
    if n <= 0 -> return text.copy()
    "{repeat_char(pad, n)}{text}"
}

center: fn(text: String, width: Int, fill: String) -> String Never! {
    pad: fill_to(fill)
    n := width - text.bytes().len()
    if n <= 0 -> return text.copy()
    left: n /% 2
    "{repeat_char(pad, left)}{text}{repeat_char(pad, n - left)}"
}

zfill: fn(text: String, width: Int) -> String Never! {
    raw: text.bytes()
    sign := ""
    rest := text
    if raw.len() > 0 && (raw[0] == (U8{45}) || raw[0] == (U8{43})) {
        sign = slice_b(raw, 0, 1)
        rest = slice_b(raw, 1, raw.len())
    }
    n := width - text.bytes().len()
    if n <= 0 -> return text.copy()
    "{sign}{repeat_char("0", n)}{rest}"
}

capitalize: fn(text: String) -> String Never! {
    raw: text.bytes()
    if raw.len() == 0 -> return text.copy()
    first: ascii_case(raw[0], true)
    out := [U8]{first}
    i := 1
    loop i < raw.len() {
        out.push(ascii_case(raw[i], false))
        i = i + 1
    }
    String.from_bytes(out) ?? text
}

title: fn(text: String) -> String Never! {
    raw: text.bytes()
    out := [U8]{}
    word := true
    loop b in raw {
        n: b
        letter := (n >= 65 && n <= 90) || (n >= 97 && n <= 122)
        if letter {
            out.push(ascii_case(b, word))
            word = false
        } else {
            out.push(b)
            word = true
        }
    }
    String.from_bytes(out) ?? text
}

/// Python `string.capwords`: collapse whitespace and capitalize each word.
capwords: fn(text: String) -> String Never! {
    parts := split_ws(text)
    i := 0
    loop i < parts.len() {
        parts[i] = capitalize(parts[i])
        i = i + 1
    }
    join(parts, " ")
}

swapcase: fn(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n: b
        if {
            n >= 65 && n <= 90 -> { out.push(U8{n + 32}) }
            n >= 97 && n <= 122 -> { out.push(U8{n - 32}) }
            else -> { out.push(b) }
        }
    }
    String.from_bytes(out) ?? text
}

lower: fn(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n: b
        if n >= 65 && n <= 90 -> out.push(U8{n + 32}) else -> out.push(b)
    }
    String.from_bytes(out) ?? text
}

upper: fn(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n: b
        if n >= 97 && n <= 122 -> out.push(U8{n - 32}) else -> out.push(b)
    }
    String.from_bytes(out) ?? text
}

is_space: fn(text: String) -> Bool Never! {
    if text.bytes().len() == 0 -> return false
    loop b in text.bytes() {
        n: b
        if n != 32 && n != 9 && n != 10 && n != 13 -> return false
    }
    true
}

/// Every byte is an ASCII space or tab, as C `isblank`. Empty text is false.
is_blank: fn(text: String) -> Bool Never! {
    if text.bytes().len() == 0 -> return false
    loop b in text.bytes() {
        n: b
        if n != 32 && n != 9 -> return false
    }
    true
}

/// Every byte is visible ASCII, `!` through `~`, as C `isgraph`. Empty text is false.
is_graphic: fn(text: String) -> Bool Never! {
    if text.bytes().len() == 0 -> return false
    loop b in text.bytes() {
        n: b
        if n < 33 || n > 126 -> return false
    }
    true
}

/// Every byte is visible ASCII that is neither a letter nor a digit, as C
/// `ispunct`: symbols such as `$`, `+` and `~` count. Empty text is false.
is_punctuation: fn(text: String) -> Bool Never! {
    if text.bytes().len() == 0 -> return false
    loop b in text.bytes() {
        n: b
        if n < 33 || n > 126 -> return false
        if (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) -> return false
    }
    true
}

/// Every byte is a hexadecimal digit, `0-9`, `a-f` or `A-F`, as C `isxdigit`.
/// Empty text is false.
is_hex_digit: fn(text: String) -> Bool Never! {
    if text.bytes().len() == 0 -> return false
    loop b in text.bytes() {
        n: b
        digit: n >= 48 && n <= 57
        lower: n >= 97 && n <= 102
        upper: n >= 65 && n <= 70
        if !digit && !lower && !upper -> return false
    }
    true
}

is_lower: fn(text: String) -> Bool Never! {
    any := false
    loop b in text.bytes() {
        n: b
        if n >= 65 && n <= 90 -> return false
        if n >= 97 && n <= 122 -> any = true
    }
    any
}

is_upper: fn(text: String) -> Bool Never! {
    any := false
    loop b in text.bytes() {
        n: b
        if n >= 97 && n <= 122 -> return false
        if n >= 65 && n <= 90 -> any = true
    }
    any
}

/// A titlecased word starts upper/title and continues lower; uncased text alone is false.
is_title: fn(text: String) -> Bool Never! {
    has_cased := false
    expect_upper := true
    loop ch in unicode.scalars(text) {
        lower: unicode.lower(ch)
        upper: unicode.upper(ch)
        if lower != upper {
            // Uppercase and titlecase scalars both have a distinct lowercase mapping.
            starts_word: ch != lower
            if starts_word != expect_upper -> return false
            has_cased = true
            expect_upper = false
        } else if unicode.is_alphabetic(ch) {
            return false
        } else {
            expect_upper = true
        }
    }
    has_cased
}

is_ascii: fn(text: String) -> Bool Never! {
    loop b in text.bytes() {
        n: b
        if n > 127 -> return false
    }
    true
}

is_identifier: fn(text: String) -> Bool Never! {
    raw: text.bytes()
    if raw.len() == 0 -> return false
    n0: raw[0]
    ok0 := n0 == 95 || (n0 >= 65 && n0 <= 90) || (n0 >= 97 && n0 <= 122)
    if !ok0 -> return false
    loop b in raw {
        n: b
        if n == 95 -> next
        if n >= 48 && n <= 57 -> next
        if n >= 65 && n <= 90 -> next
        if n >= 97 && n <= 122 -> next
        return false
    }
    true
}

/// Python `str` spellings over the same UTF-8 byte-preserving primitives.
startswith: fn(text: String, prefix: String) -> Bool Never! { starts_with(text, prefix) }
endswith: fn(text: String, suffix: String) -> Bool Never! { ends_with(text, suffix) }
removeprefix: fn(text: String, prefix: String) -> String Never! { strip_prefix(text, prefix) }
removesuffix: fn(text: String, suffix: String) -> String Never! { strip_suffix(text, suffix) }
rindex: fn(text: String, needle: String) -> Int Never! { rfind(text, needle) }
encode: fn(text: String) -> [U8] Never! { text.bytes() }
isalpha: fn(text: String) -> Bool Never! {
    if text.bytes().len() == 0 -> return false
    loop b in text.bytes() {
        n: b
        if !((n >= 65 && n <= 90) || (n >= 97 && n <= 122)) -> return false
    }
    true
}
isdecimal: fn(text: String) -> Bool Never! { is_digit(text) }
isnumeric: fn(text: String) -> Bool Never! { is_digit(text) }
isalnum: fn(text: String) -> Bool Never! { is_alnum(text) }
isascii: fn(text: String) -> Bool Never! { is_ascii(text) }
isdigit: fn(text: String) -> Bool Never! { is_digit(text) }
isidentifier: fn(text: String) -> Bool Never! { is_identifier(text) }
islower: fn(text: String) -> Bool Never! { is_lower(text) }
isspace: fn(text: String) -> Bool Never! { is_space(text) }
istitle: fn(text: String) -> Bool Never! { is_title(text) }
isupper: fn(text: String) -> Bool Never! { is_upper(text) }
isprintable: fn(text: String) -> Bool Never! {
    loop b in text.bytes() {
        n: b
        if n < 32 || n > 126 -> return false
    }
    true
}
/// Expand tab stops in decoded-scalar columns, resetting at either CR or LF.
expandtabs: fn(text: String, tabsize: Int) -> String Never! {
    out := ""
    column := 0
    width := tabsize
    if width < 0 -> width = 0
    loop ch in unicode.scalars(text) {
        n: ch.bytes()[0]
        if {
            n == 9 -> {
                spaces := 0
                if width > 0 -> spaces = width - (column % width)
                loop _ in 0..<spaces -> out = "{out} "
                column = column + spaces
            }
            else -> {
                out = "{out}{ch}"
                if n == 10 || n == 13 -> column = 0 else -> column = column + 1
            }
        }
    }
    out
}


find_from: fn(text: String, needle: String, start: Int) -> Int Never! {
    s := start
    if s < 0 -> s = 0
    rest: slice_str(text, s, text.bytes().len())
    j: find(rest, needle)
    if j < 0 -> return -1
    s + j
}

rfind_from: fn(text: String, needle: String, end: Int) -> Int Never! {
    e := end
    if e > text.bytes().len() -> e = text.bytes().len()
    rfind(slice_str(text, 0, e), needle)
}

index: fn(text: String, needle: String) -> Int Never! {
    i: find(text, needle)
    if i < 0 -> return -1
    i
}

contains: fn(text: String, needle: String) -> Bool Never! { find(text, needle) >= 0 }

parse_bool: fn(text: String) -> Bool? Never! {
    stripped: strip(text) ?? return None
    t: lower(stripped) ?? return None
    if t == {
        "true" | "1" | "yes" | "on" -> Val(true)
        "false" | "0" | "no" | "off" -> Val(false)
        else -> None
    }
}

parse_kv: fn(text: String, sep: String) -> (key: String, ok: Bool, value: String) Never! {
    p: partition(text, sep)
    if p.sep.bytes().len() == 0 -> return (key: strip(text), value: "", ok: false)
    (key: strip(p.head), value: strip(p.tail), ok: true)
}

split_ws: fn(text: String) -> [String] Never! {
    raw: text.bytes()
    out := [String]{}
    start := -1
    i := 0
    loop i <= raw.len() {
        space := false
        if i == raw.len() -> space = true else {
            n: raw[i]
            space = n == 32 || n == 9 || n == 10 || n == 13
        }
        if {
            space -> {
                if start >= 0 {
                    out.push(slice_b(raw, start, i))
                    start = -1
                }
            }
            start < 0 -> { start = i }
        }
        i = i + 1
    }
    out
}

unescape_c: fn(text: String) -> String Never! {
    raw: text.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{92}) && i + 1 < raw.len() {
            n: raw[i + 1]
            if {
                n == 110 -> { out.push(U8{10}) }
                n == 116 -> { out.push(U8{9}) }
                n == 114 -> { out.push(U8{13}) }
                n == 92 -> { out.push(U8{92}) }
                n == 34 -> { out.push(U8{34}) }
                else -> { out.push(raw[i + 1]) }
            }
            i = i + 2
            next
        }
        out.push(raw[i])
        i = i + 1
    }
    String.from_bytes(out) ?? text
}

escape_c: fn(text: String) -> String Never! {
    out := ""
    loop b in text.bytes() {
        n: b
        if {
            n == 10 -> { out = "{out}\\n" }
            n == 9 -> { out = "{out}\\t" }
            n == 13 -> { out = "{out}\\r" }
            n == 92 -> { out = "{out}\\\\" }
            n == 34 -> { out = "{out}\\\"" }
            else -> { out = "{out}{String.from_bytes([U8]{b}) ?? ""}" }
        }
    }
    out
}

// The byte-oriented padding contract retains the first fill byte, or a space.
// Restored with ascii_case from the pre-merge implementation (2aa8b0349).
fill_to: fn(fill: String) -> String {
    if fill.bytes().len() == 0 -> return " "
    slice_b(fill.bytes(), 0, 1)
}

repeat_char: fn(ch: String, n: Int) -> String {
    s := ""
    i := 0
    loop i < n {
        s = "{s}{ch}"
        i = i + 1
    }
    s
}


ascii_case: fn(b: U8, upper: Bool) -> U8 {
    n: b
    if upper {
        if n >= 97 && n <= 122 -> return (U8{n - 32})
        return b
    }
    if n >= 65 && n <= 90 -> return (U8{n + 32})
    b
}

#Test("parse padding and ASCII capitalization retain their byte contract") {
    assert_eq(ljust("a", 3, ""), "a  ")
    assert_eq(rjust("a", 3, "_"), "__a")
    assert_eq(center("a", 4, "_"), "_a__")
    assert_eq(capitalize("hELLO"), "Hello")
    assert_eq(title("hELLO wORLD"), "Hello World")
}

// String's line and field methods (BuiltinMethods CoreSource rows): the
// compiler checks `text.first_lines(n)` as `__string_first_lines(text, n)`.
// Lines follow `lines()`: LF ends a line, one CR before it is dropped, and a
// final LF adds no empty line.

// `text.trim_newlines()`: `text` without its trailing LFs, as shell `$(…)`
// drops them. Any other trailing whitespace stays.
__string_trim_newlines: fn(text: String) -> String Never! {
    raw: text.bytes()
    end := raw.len()
    loop end > 0 && raw[end - 1] == (U8{10}) -> end = end - 1
    if end == raw.len() -> return text.copy()
    kept := [U8]{}
    loop at in 0..<end -> kept.push(raw[at])
    String.from_bytes(kept) ?? panic("dropping trailing LFs keeps whole UTF-8 scalars")
}

// `text.first_lines(n)`: the first `n` lines (`head -n`); every line when
// there are fewer, none when `n` is not positive.
__string_first_lines: fn(text: String, count: Int) -> [String] Never! {
    lines: text.lines()
    kept := [String]{}
    loop at in 0..<lines.len() {
        if at >= count -> return kept
        kept.push(lines[at].copy())
    }
    kept
}

// `text.last_lines(n)`: the last `n` lines (`tail -n`); every line when
// there are fewer, none when `n` is not positive.
__string_last_lines: fn(text: String, count: Int) -> [String] Never! {
    lines: text.lines()
    start := lines.len() - count
    if count <= 0 -> start = lines.len()
    if start < 0 -> start = 0
    kept := [String]{}
    loop at in start..<lines.len() -> kept.push(lines[at].copy())
    kept
}

// `text.has_line_prefix(prefix)`: whether some line starts with `prefix`
// (`grep -q '^prefix'` with `prefix` read literally).
__string_has_line_prefix: fn(text: String, prefix: String) -> Bool Never! {
    loop line in text.lines() {
        if line.starts_with(prefix) -> return true
    }
    false
}

// `text.tsv_records()`: each line split on every tab, so an empty field
// stays empty and a line with no tab is one field.
__string_tsv_records: fn(text: String) -> [[String]] Never! {
    records := [[String]]{}
    loop line in text.lines() -> records.push(line.split("\t").to_list())
    records
}

#Test("String line and field methods follow the lines() rule") {
    assert_eq(__string_trim_newlines("out\n\n"), "out")
    assert_eq(__string_trim_newlines("out \t"), "out \t")
    assert_eq(__string_trim_newlines("\n"), "")
    assert_eq(__string_first_lines("a\nb\r\nc\n", 2), [String]{"a", "b"})
    assert_eq(__string_first_lines("a\nb", 5), [String]{"a", "b"})
    assert_eq(__string_first_lines("a\nb", 0).len(), 0)
    assert_eq(__string_last_lines("a\nb\nc\n", 2), [String]{"b", "c"})
    assert_eq(__string_last_lines("a\nb", 5), [String]{"a", "b"})
    assert_eq(__string_last_lines("a\nb", -1).len(), 0)
    assert(__string_has_line_prefix("x\n## head\n", "## "))
    assert(!__string_has_line_prefix("x ## head\n", "## "))
    records: __string_tsv_records("k\tv\n\tempty\nlone\n")
    assert_eq(records.len(), 3)
    assert_eq(records[0], [String]{"k", "v"})
    assert_eq(records[1], [String]{"", "empty"})
    assert_eq(records[2], [String]{"lone"})
}

// `text.compare_version(other)`: the order of GNU `sort -V` in the C locale
// (gnulib filevercmp, then sort's byte-order last resort). Digit runs compare
// as numbers, leading zeros aside; outside them a letter sorts by itself, `~`
// before everything (even the end, so `1.0~rc1` comes before `1.0`) and any
// other byte after the letters. A trailing file suffix (`.tar.gz`: `.` and a
// letter or `~`, then letters, digits and `~`) counts only to break a tie.
// The empty string comes first, then `.`, `..` and the other names that start
// with a dot. Versions that tie (`a01`, `a1`) fall back to byte order.
__string_compare_version: fn(text: String, other: String) -> Ordering Never! {
    order: __version_file_order(text.bytes(), other.bytes())
    if order != 0 -> return order <=> 0
    text <=> other
}

// filevercmp: below zero when `a` sorts first, above zero when `b` does.
__version_file_order: fn(a: [U8], b: [U8]) -> Int Never! {
    if a.len() == 0 || b.len() == 0 -> return a.len() - b.len()
    a_hidden: a[0] == (U8{46})
    b_hidden: b[0] == (U8{46})
    if a_hidden != b_hidden -> return if a_hidden -> -1 else -> 1
    if a_hidden {
        a_rank: __version_dot_rank(a)
        b_rank: __version_dot_rank(b)
        if a_rank < 2 || b_rank < 2 -> return a_rank - b_rank
    }
    a_prefix: __version_prefix_len(a)
    b_prefix: __version_prefix_len(b)
    order: __version_runs_order(a, a_prefix, b, b_prefix)
    if order != 0 || (a_prefix == a.len() && b_prefix == b.len()) -> return order
    __version_runs_order(a, a.len(), b, b.len())
}

// `.` is 0, `..` is 1 and any other name that starts with a dot is 2.
__version_dot_rank: fn(name: [U8]) -> Int Never! {
    if name.len() == 1 -> return 0
    if name.len() == 2 && name[1] == (U8{46}) -> return 1
    2
}

// The length of `name` without its trailing file suffix: the runs of `.`, a
// letter or `~`, then letters, digits and `~` that end it. The first byte is
// never part of the suffix.
__version_prefix_len: fn(name: [U8]) -> Int Never! {
    at := 0
    prefix := 0
    loop at < name.len() {
        at += 1
        prefix = at
        loop at + 1 < name.len() && name[at] == (U8{46}) && (__version_letter(name[at + 1]) || name[at + 1] == (U8{126})) {
            at += 2
            loop at < name.len() && (__version_letter(name[at]) || __version_digit(name[at]) || name[at] == (U8{126})) -> at += 1
        }
    }
    prefix
}

// verrevcmp over `a[0..<a_end]` and `b[0..<b_end]`: alternate runs of
// non-digits, compared byte by byte by weight, and digit runs, compared as
// numbers.
__version_runs_order: fn(a: [U8], a_end: Int, b: [U8], b_end: Int) -> Int Never! {
    i := 0
    j := 0
    loop i < a_end || j < b_end {
        loop __version_text_at(a, i, a_end) || __version_text_at(b, j, b_end) {
            difference: __version_weight(a, i, a_end) - __version_weight(b, j, b_end)
            if difference != 0 -> return difference
            i += 1
            j += 1
        }
        loop i < a_end && a[i] == (U8{48}) -> i += 1
        loop j < b_end && b[j] == (U8{48}) -> j += 1
        first := 0
        loop i < a_end && j < b_end && __version_digit(a[i]) && __version_digit(b[j]) {
            if first == 0 -> first = Int.from_u8(a[i]) - Int.from_u8(b[j])
            i += 1
            j += 1
        }
        if i < a_end && __version_digit(a[i]) -> return 1
        if j < b_end && __version_digit(b[j]) -> return -1
        if first != 0 -> return first
    }
    0
}

// A byte's weight outside a digit run: the end -1, a digit 0, a letter
// itself, `~` -2 and any other byte after every letter.
__version_weight: fn(name: [U8], at: Int, end: Int) -> Int Never! {
    if at >= end -> return -1
    byte: name[at]
    if __version_digit(byte) -> return 0
    if __version_letter(byte) -> return Int.from_u8(byte)
    if byte == (U8{126}) -> return -2
    Int.from_u8(byte) + 256
}

__version_digit: fn(byte: U8) -> Bool Never! { byte >= (U8{48}) && byte <= (U8{57}) }

// Whether `name[at]` is before `end` and outside a digit run.
__version_text_at: fn(name: [U8], at: Int, end: Int) -> Bool Never! { at < end && !__version_digit(name[at]) }

__version_letter: fn(byte: U8) -> Bool Never! { (byte >= (U8{65}) && byte <= (U8{90})) || (byte >= (U8{97}) && byte <= (U8{122})) }

#Test("compare_version is GNU sort -V order") {
    rows := [String]{"6067c10", "file.tar.gz", "a1", "1.10", "", "B", "1.0", "..", "6067c9", "a01", "1.9", ".hidden", "file.tar", "1.0~rc1", "a", ".", "1.2", "x.1", "x-1"}
    rows.sort_by((left: String, right: String) -> __string_compare_version(left, right))
    assert_eq(rows, [String]{"", ".", "..", ".hidden", "1.0~rc1", "1.0", "1.2", "1.9", "1.10", "6067c9", "6067c10", "B", "a", "a01", "a1", "file.tar", "file.tar.gz", "x-1", "x.1"})
    assert_eq(__string_compare_version("a1", "a1"), Ordering.Equal)
    assert_eq(__string_compare_version("v2", "v010"), Ordering.Less)
    assert_eq(__string_compare_version("1.0", "1.0~"), Ordering.Greater)
    assert_eq(__string_compare_version("pkg-1.2.tar.gz", "pkg-1.10.tar"), Ordering.Less)
}
