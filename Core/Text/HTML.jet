package: {
    name: "core.text.html"
    version: "0.0.1"
    edition: "2026"
    description: "HTML escaping, entity decoding, and tag stripping."
    license: "MIT"
    outputs: {
        html: .Library{ entry: html }
    }
}

use {
    unicode: core.text
    core.grammar.error.[TextSpot]
    html_syntax: __core_text_syntax_html
}

// XML-safe escaping and bounded entity decoding. Decoding preserves literal
// UTF-8 and unknown entities; tag stripping is a span operation, not a parser.
escape: fn(text: String) -> String Never! { escape_quote(text, true) }

escape_quote: fn(text: String, quote: Bool) -> String Never! {
    ^out: ""
    loop ch in unicode.scalars(text) {
        if ch == "&" -> out = "{out}&amp;" else if ch == "<" -> out = "{out}&lt;" else if ch == ">" {
            out = "{out}&gt;"
        } else if quote && ch == "\"" { out = "{out}&quot;" } else if quote && ch == "'" {
            out = "{out}&#x27;"
        } else { out = "{out}{ch}" }
    }
    out
}

unescape: fn(text: String) -> String Never! {
    raw: text.bytes()
    ^out: [U8]{}
    ^i: 0
    loop i < raw.len() {
        if raw[i] != (U8{38}) {
            out.push(raw[i])
            i += 1
            next
        }
        ^semi: i + 1
        loop semi < raw.len() && semi - i <= 32 {
            if raw[semi] == (U8{59}) -> break
            semi += 1
        }
        if semi < raw.len() && raw[semi] == (U8{59}) {
            name: String.from_bytes(slice_b(raw, i + 1, semi)) ?? ""
            decoded: entity(name)
            decoded_raw: decoded.bytes()
            if decoded_raw.len() > 0 {
                loop byte in decoded_raw -> out.push(byte)
                i = semi + 1
                next
            }
        }
        out.push(raw[i])
        i += 1
    }
    String.from_bytes(out) ?? text
}

strip_tags: fn(text: String) -> String Never! {
    raw: text.bytes()
    ^out: [U8]{}
    ^i: 0
    loop i < raw.len() {
        if raw[i] != (U8{60}) {
            out.push(raw[i])
            i += 1
            next
        }
        ^close: i + 1
        loop close < raw.len() && raw[close] != (U8{62}) -> close += 1
        if close >= raw.len() {
            out.push(raw[i])
            i += 1
            next
        }
        i = close + 1
    }
    String.from_bytes(out) ?? text
}

unescape_and_strip: fn(text: String) -> String Never! { unescape(strip_tags(text)) }

attr_escape: fn(text: String) -> String Never! { escape_quote(text, true) }

text_escape: fn(text: String) -> String Never! { escape_quote(text, false) }

/// Where a hole sits inside a checked `HTML{…}` literal, chosen at build time
/// by the HTML grammar and attribute classifier.
HTMLSlot: enum {
    Text,
    QuotedAttr,
    UnquotedAttr,
    URLQuotedStart,
    URLUnquotedStart,
    URLQuotedPrefix,
    URLUnquotedPrefix,
    RefusedAttr,
    TagName,
    RawText,
}

priv html_slot_from_code: fn(code: Int) -> HTMLSlot Never! {
    if code == {
        html_syntax.HTML_SLOT_TEXT -> HTMLSlot.Text
        html_syntax.HTML_SLOT_QUOTED_ATTR -> HTMLSlot.QuotedAttr
        html_syntax.HTML_SLOT_UNQUOTED_ATTR -> HTMLSlot.UnquotedAttr
        html_syntax.HTML_SLOT_URL_QUOTED_START -> HTMLSlot.URLQuotedStart
        html_syntax.HTML_SLOT_URL_UNQUOTED_START -> HTMLSlot.URLUnquotedStart
        html_syntax.HTML_SLOT_URL_QUOTED_PREFIX -> HTMLSlot.URLQuotedPrefix
        html_syntax.HTML_SLOT_URL_UNQUOTED_PREFIX -> HTMLSlot.URLUnquotedPrefix
        html_syntax.HTML_SLOT_REFUSED_ATTR -> HTMLSlot.RefusedAttr
        html_syntax.HTML_SLOT_TAG_NAME -> HTMLSlot.TagName
        html_syntax.HTML_SLOT_RAW_TEXT -> HTMLSlot.RawText
        else -> HTMLSlot.Text
    }
}

// Checked HTML markup. `HTML{"…{value}…"}` checks well-formedness and classifies
// every hole at build time through the HTML grammar, escaping each hole for its
// exact slot: text (`& < >`), quoted attribute (`& < > " '`), unquoted attribute
// (plus whitespace, `=`, backtick; empty -> `""`), URL start (Go `isSafeURL` ->
// `about:invalid#jet` on unsafe schemes, including for `URL` values), and URL
// after a fixed prefix (RFC 3986 percent-encoding + attribute escaping). An
// `HTML` value composes raw only in `Text`. `HTML.raw(text)` is the audited
// escape hatch.
HTML: struct {
    markup: String,

    impl Display {
        display: fn(self) -> String { self.markup.copy() }
    }

    impl Debug {
        debug: fn(^^self) -> String { self.markup }
    }

    impl Equatable {
        equal: fn(self, rhs: HTML) -> Bool { self.markup == rhs.markup }
    }
}

impl HTML {
    text: fn(self) -> String Never! { self.markup.copy() }

    raw: fn(text: String) -> HTML Never! { HTML{markup: text.copy()} }
}

impl HTML.CheckedText {
    Error: HTMLLiteralError,
    Hole: String,
    Slot: HTMLSlot,

    check: fn(parts: [String]) -[]> Checked<[String], HTMLSlot> HTMLLiteralError! {
        codes: html_syntax.html_check_parts(parts) ?? return Err(HTMLLiteralError{reason: err.reason.copy(), at: TextSpot{part: err.part, offset: err.offset}})
        slots: loop code in codes -> html_slot_from_code(code)
        Ok(Checked{shape: parts.copy(), slots: slots})
    }

    accepts: fn(slot: HTMLSlot, _hole: TypeId) -[]> String? {
        if slot == {
            .TagName -> Val("a hole cannot be an HTML tag name; write the tag name literally")
            .RawText -> Val("a hole cannot sit inside a raw-text element (`<script>` or `<style>`)")
            .RefusedAttr -> Val("a hole cannot sit inside a script, style, `srcdoc`, or `srcset` attribute")
            .Text | .QuotedAttr | .UnquotedAttr | .URLQuotedStart | .URLUnquotedStart | .URLQuotedPrefix | .URLUnquotedPrefix -> None
        }
    }

    encode_hole: fn<T: Printable>(value: T, slot: HTMLSlot) -[]> String {
        if slot == .Text {
            if T == {
                HTML -> return value.markup.copy()
                else -> return text_escape("{value}")
            }
        }
        raw: "{value}"
        if slot == {
            .QuotedAttr -> attr_escape(raw)
            .UnquotedAttr -> html_syntax.html_escape_unquoted(raw)
            .URLQuotedStart -> attr_escape(html_syntax.html_safe_url(raw))
            .URLUnquotedStart -> html_syntax.html_escape_unquoted(html_syntax.html_safe_url(raw))
            .URLQuotedPrefix -> attr_escape(html_syntax.html_url_prefix_encode(raw))
            .URLUnquotedPrefix -> html_syntax.html_escape_unquoted(html_syntax.html_url_prefix_encode(raw))
            .Text | .RefusedAttr | .TagName | .RawText -> ""
        }
    }

    build: fn(parts: [String], holes: [String]) -[]> HTML {
        ^pieces: [String]{parts[0].copy()}
        loop index in 0..<holes.len() {
            pieces.push(holes[index].copy())
            pieces.push(parts[index + 1].copy())
        }
        HTML{markup: pieces.join("")}
    }
}

// Why a checked HTML literal was rejected: the compiler reports it under the
// checked text rejection's code at `at`, with `reason` as its Why.
#Error
HTMLLiteralError: struct {
    reason: String,
    at: TextSpot,
}

impl HTMLLiteralError.Diagnostic {
    code: "E2712",

    what: fn(self) -> String { "this checked text type rejected its body" }

    why: fn(self) -> String { "{self.reason}" }

    fix: fn(self) -> String { "fix the body so it satisfies the type's declared text grammar" }
}

entity: fn(name: String) -> String {
    if name == "amp" -> return "&"
    if name == "lt" -> return "<"
    if name == "gt" -> return ">"
    if name == "quot" -> return "\""
    if name == "apos" -> return "'"
    if name == "nbsp" -> return " "
    if name == "copy" -> return "©"
    if name == "reg" -> return "®"
    if name == "trade" -> return "™"
    if name == "mdash" -> return "—"
    if name == "ndash" -> return "–"
    if name == "hellip" -> return "…"
    raw: name.bytes()
    if raw.len() < 2 || raw[0] != (U8{35}) -> return ""
    ^n: 0
    ^i: 1
    ^base: 10
    if raw[1] == (U8{120}) || raw[1] == (U8{88}) {
        base = 16
        i = 2
    }
    if i >= raw.len() -> return ""
    loop i < raw.len() {
        ^digit: if base == 16 -> hex_val(raw[i]) else -> decimal_val(raw[i])
        d: digit ?? return ""
        // Saturate outside the scalar range, but still validate every digit.
        if n > (1114111 - d) /% base -> n = 1114112 else -> n = n * base + d
        i += 1
    }
    scalar(n)
}

scalar: fn(n: Int) -> String {
    if n == 0 || n > 1114111 || (n >= 55296 && n <= 57343) -> return "�"
    ^out: [U8]{}
    if n < 128 -> out.push(U8{n}) else if n < 2048 {
        out.push(U8{(192) | (n >> 6)})
        out.push(U8{(128) | ((n) & 63)})
    } else if n < 65536 {
        out.push(U8{(224) | (n >> 12)})
        out.push(U8{(128) | (((n >> 6)) & 63)})
        out.push(U8{(128) | ((n) & 63)})
    } else {
        out.push(U8{(240) | (n >> 18)})
        out.push(U8{(128) | (((n >> 12)) & 63)})
        out.push(U8{(128) | (((n >> 6)) & 63)})
        out.push(U8{(128) | ((n) & 63)})
    }
    String.from_bytes(out) ?? "�"
}

decimal_val: fn(b: U8) -> Int? {
    n: Int{b}
    if n < 48 || n > 57 -> return None
    Val(n - 48)
}

hex_val: fn(b: U8) -> Int? {
    n: Int{b}
    if n >= 48 && n <= 57 -> return Val(n - 48)
    if n >= 65 && n <= 70 -> return Val(n - 55)
    if n >= 97 && n <= 102 -> return Val(n - 87)
    None
}

slice_b: fn(raw: [U8], start: Int, end: Int) -> [U8] {
    ^out: [U8]{}
    ^i: start
    loop {
        if i >= end || i < 0 || i >= raw.len() -> return out
        out.push(raw[i])
        i += 1
    }
}
