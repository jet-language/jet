package: {
    name: "core.text.html"
    version: "0.0.1"
    edition: "2026"
    description: "HTML escaping, entity decoding, and tag stripping."
    license: "MIT"
    outputs: {
        html: .Library{ entry: html }
    }
}

use unicode: core.text

// XML-safe escaping and bounded entity decoding. Decoding preserves literal
// UTF-8 and unknown entities; tag stripping is a span operation, not a parser.
escape: fn(text: String) -> String Never! { escape_quote(text, true) }

escape_quote: fn(text: String, quote: Bool) -> String Never! {
    out := ""
    loop ch in unicode.scalars(text) {
        if ch == "&" -> out = "{out}&amp;"
        else if ch == "<" -> out = "{out}&lt;"
        else if ch == ">" -> out = "{out}&gt;"
        else if quote && ch == "\"" -> out = "{out}&quot;"
        else if quote && ch == "'" -> out = "{out}&#x27;"
        else -> out = "{out}{ch}"
    }
    out
}

unescape: fn(text: String) -> String Never! {
    raw: text.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        if raw[i] != (U8{38}) {
            out.push(raw[i])
            i = i + 1
            next
        }
        semi := i + 1
        loop semi < raw.len() && semi - i <= 32 {
            if raw[semi] == (U8{59}) -> break
            semi = semi + 1
        }
        if semi < raw.len() && raw[semi] == (U8{59}) {
            name: String.from_bytes(slice_b(raw, i + 1, semi)) ?? ""
            decoded: entity(name)
            decoded_raw: decoded.bytes()
            if decoded_raw.len() > 0 {
                loop byte in decoded_raw -> out.push(byte)
                i = semi + 1
                next
            }
        }
        out.push(raw[i])
        i = i + 1
    }
    String.from_bytes(out) ?? text
}

strip_tags: fn(text: String) -> String Never! {
    raw: text.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        if raw[i] != (U8{60}) {
            out.push(raw[i])
            i = i + 1
            next
        }
        close := i + 1
        loop close < raw.len() && raw[close] != (U8{62}) -> close = close + 1
        if close >= raw.len() {
            out.push(raw[i])
            i = i + 1
            next
        }
        i = close + 1
    }
    String.from_bytes(out) ?? text
}

unescape_and_strip: fn(text: String) -> String Never! { unescape(strip_tags(text)) }
attr_escape: fn(text: String) -> String Never! { escape_quote(text, true) }
text_escape: fn(text: String) -> String Never! { escape_quote(text, false) }

// Checked HTML markup. `HTML{"…{value}…"}` escapes each hole unless the hole
// is itself HTML; `HTML.raw(text)` is the audited escape hatch.
HTML: struct {
    markup: String
    impl Display {
        display: fn(self) -> String { self.markup.copy() }
    }
    impl Debug {
        debug: fn(&&self) -> String { self.markup }
    }
    impl Equatable {
        equal: fn(self, rhs: HTML) -> Bool { self.markup == rhs.markup }
    }
}

impl HTML {
    text: fn(self) -> String Never! { self.markup.copy() }
    raw: fn(text: String) -> HTML Never! { HTML{markup: text.copy()} }
}

// A checked `HTML{…}` literal: each hole becomes markup, an HTML value as it
// is and any other value as its escaped display text.
impl HTML.CheckedText {
    Error: Never
    Hole: String

    check: fn(_text: String) Never! -[]> { return Ok() }

    encode_hole: fn<T: Printable>(value: T) -[]> String {
        if T == {
            HTML -> value.markup.copy()
            else -> escape("{value}")
        }
    }

    build: fn(parts: [String], holes: [String]) -[]> HTML {
        markup := parts[0].copy()
        loop index in 0..<holes.len() -> markup = "{markup}{holes[index]}{parts[index + 1]}"
        HTML{markup: markup}
    }
}

entity: fn(name: String) -> String {
    if name == "amp" -> return "&"
    if name == "lt" -> return "<"
    if name == "gt" -> return ">"
    if name == "quot" -> return "\""
    if name == "apos" -> return "'"
    if name == "nbsp" -> return " "
    if name == "copy" -> return "©"
    if name == "reg" -> return "®"
    if name == "trade" -> return "™"
    if name == "mdash" -> return "—"
    if name == "ndash" -> return "–"
    if name == "hellip" -> return "…"
    raw: name.bytes()
    if raw.len() < 2 || raw[0] != (U8{35}) -> return ""
    n := 0
    i := 1
    base := 10
    if raw[1] == (U8{120}) || raw[1] == (U8{88}) {
        base = 16
        i = 2
    }
    if i >= raw.len() -> return ""
    loop i < raw.len() {
        digit := if base == 16 -> hex_val(raw[i]) else -> decimal_val(raw[i])
        d: digit ?? return ""
        // Saturate outside the scalar range, but still validate every digit.
        if n > (1114111 - d) /% base -> n = 1114112
        else -> n = n * base + d
        i = i + 1
    }
    scalar(n)
}

scalar: fn(n: Int) -> String {
    if n == 0 || n > 1114111 || (n >= 55296 && n <= 57343) -> return "�"
    out := [U8]{}
    if n < 128 -> out.push(U8{n})
    else if n < 2048 {
        out.push(U8{(192).bit_or((n >> 6))})
        out.push(U8{(128).bit_or(((n).bit_and(63)))})
    } else if n < 65536 {
        out.push(U8{(224).bit_or((n >> 12))})
        out.push(U8{(128).bit_or((((n >> 6)).bit_and(63)))})
        out.push(U8{(128).bit_or(((n).bit_and(63)))})
    } else {
        out.push(U8{(240).bit_or((n >> 18))})
        out.push(U8{(128).bit_or((((n >> 12)).bit_and(63)))})
        out.push(U8{(128).bit_or((((n >> 6)).bit_and(63)))})
        out.push(U8{(128).bit_or(((n).bit_and(63)))})
    }
    String.from_bytes(out) ?? "�"
}

decimal_val: fn(b: U8) -> Int? {
    n: Int.from_u8(b)
    if n < 48 || n > 57 -> return None
    Val(n - 48)
}

hex_val: fn(b: U8) -> Int? {
    n: Int.from_u8(b)
    if n >= 48 && n <= 57 -> return Val(n - 48)
    if n >= 65 && n <= 70 -> return Val(n - 55)
    if n >= 97 && n <= 102 -> return Val(n - 87)
    None
}

slice_b: fn(raw: [U8], start: Int, end: Int) -> [U8] {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i < 0 || i >= raw.len() -> return out
        out.push(raw[i])
        i = i + 1
    }
}
