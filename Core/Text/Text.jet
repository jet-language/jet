package: {
    name: "core.text"
    version: "0.0.1"
    edition: "2026"
    description: "Unicode text, ASCII helpers, and display formatting."
    license: "MIT"
    outputs: {
        text: .Library{ entry: text }
    }
}

// core.text — strings as Unicode scalar sequences.
//
// Jet `String` is UTF-8. Counting, trimming, and case mapping are defined on
// scalars, not raw bytes, except where a function is named `byte_*`. UTF-8
// decode, Hangul NFD/NFC, grapheme segmentation, and East-Asian width are Jet.
// Word/sentence boundaries implement UAX #29 over pinned Unicode 17.0.0
// tables, shared with the Rust verification tier. Full case folding and case
// mapping use the shared runtime tables.
//
// Predicates on the empty string are false (`is_alphabetic("")` is false).
// `splitn` / `rsplitn` take a maximum part count, matching Rust `splitn`.


fmt: module
parse: module
wrap: module
html: module
combinators: module

use {
    segment_tables: __core_text_segmentation_tables
    text_unicode_string: core.text.runtime.kernel_unicode_string
    text_width: core.text.runtime.kernel_text_width
    text_asset: core.text.runtime.unicode_assets
    text_tables: core.text.runtime.top_unicode_tables
    text_unicode_name_index: core.text.runtime.assets.unicode_name_index
    collation_table: __core_text_collation_table
    text_normal: core.text.runtime.kernel_text_normal
    text_ccc: core.text.runtime.assets.unicode_ccc
    text_category: core.text.runtime.assets.unicode_general_category
    unicode_category.[general_category, is_graphic_cp, punctuation_scalars]
}

/// The consuming text scanner `Cursor.over(text)`: the runtime's cursor
/// handle (core-library.md, "Cursor — consuming text scanner"). Only the
/// runtime fills the `priv handle`, and the handle has no equality or order,
/// so the cursor refuses the Equatable and Comparable derives.
#[!Equatable, !Comparable]
Cursor: struct {
    priv handle: Int
}

/// Byte length of UTF-8 `text`. Equal to `text.bytes().len()`.
byte_count: fn(text: String) -> Int Never! { text.bytes().len() }

is_ascii: fn(text: String) -> Bool Never! {
    loop b in text.bytes() {
        if b > (U8{127}) -> return false
    }
    true
}

/// Unicode scalar count (replacement character U+FFFD counts as one).
scalar_count: fn(text: String) -> Int Never! { decode_scalars(text).len() }

scalars: fn(text: String) -> [String] Never! {
    out := [String]{}
    loop cp in decode_scalars(text) -> out.push(encode_cp(cp))
    out
}

/// Full Unicode lowercase mapping (`"İ"` lowers to `"i̇"`). The String method
/// routes to the one shared runtime case table, so both spellings agree (I9).
lower: fn(text: String) -> String Never! { text.to_lower() }

/// Full Unicode uppercase mapping (`"ß"` uppers to `"SS"`), through the same
/// shared runtime case table as the String method.
upper: fn(text: String) -> String Never! { text.to_upper() }

/// Unicode full case folding (CaseFolding.txt status C+F): `"Straße"` folds to
/// `"strasse"`. The String method routes to the one shared runtime fold table.
casefold: fn(text: String) -> String Never! { text.casefold() }

caseless_eq: fn(left: String, right: String) -> Bool Never! { casefold(left) == casefold(right) }

nfc: fn(text: String) -> String Never! { compose(decompose(text, false)) }
nfd: fn(text: String) -> String Never! { encode_cps(decompose(text, false)) }
nfkc: fn(text: String) -> String Never! { compose(decompose(text, true)) }
nfkd: fn(text: String) -> String Never! { encode_cps(decompose(text, true)) }

graphemes: fn(text: String) -> [String] Never! { split_graphemes(text) }
words: fn(text: String) -> [String] Never! { split_words(text) }
sentences: fn(text: String) -> [String] Never! { split_sentences(text) }
/// Unicode 17.0.0 scalar labels: `U+XXXX NAME`, with legacy control names.
/// Scalars absent from the pinned name index are labeled `UNASSIGNED`.
inspect: fn(text: String) -> [String] Never! {
    out := [String]{}
    loop cp in decode_scalars(text) -> out.push("{hex_cp(cp)} {unicode_name(cp)}")
    out
}

/// `"index:scalar"` pairs, index in bytes.
char_indices: fn(text: String) -> [String] Never! {
    out := [String]{}
    loop pair in decode_indexed(text) -> out.push("{pair.index}:{encode_cp(pair.cp)}")
    out
}

display_width: fn(text: String) -> Int Never! {
    bytes: text.bytes()
    if __printable_ascii(bytes) -> return bytes.len()
    total := 0
    loop cluster in split_graphemes(text) -> total = total + text_width.cluster_width(decode_scalars(cluster))
    total
}

// Whether every byte is printable ASCII, space through `~`: each is a
// grapheme of its own, one column wide, so display_width needs no lookup.
__printable_ascii: fn(bytes: [U8]) -> Bool Never! {
    loop b in bytes {
        if b < (U8{32}) || b > (U8{126}) -> return false
    }
    true
}

grapheme_views: fn(text: String) -> [String] Never! { graphemes(text) }
word_views: fn(text: String) -> [String] Never! { words(text) }
line_views: fn(text: String) -> [String] Never! { split_lines(text) }
byte_views: fn(text: String) -> [String] Never! {
    out := [String]{}
    loop b in text_unicode_string.utf8_bytes(text) -> out.push("{b}")
    out
}

is_alphabetic: fn(text: String) -> Bool Never! {
    raw: text.bytes()
    if raw.len() == 0 -> return false
    bytes: raw[0..<raw.len()]
    at := 0
    loop at < bytes.len() {
        byte: bytes[at]
        if byte >= (U8{128}) -> break
        if !ascii_alpha(byte) -> return false
        at += 1
    }
    if at == bytes.len() -> return true
    alphabetic_suffix(bytes, at, segment_tables.UNICODE_ALPHABETIC)
}

is_numeric: fn(text: String) -> Bool Never! {
    raw: text.bytes()
    if raw.len() == 0 -> return false
    bytes: raw[0..<raw.len()]
    at := 0
    loop at < bytes.len() {
        byte: bytes[at]
        if byte >= (U8{128}) -> break
        if byte < (U8{48}) || byte > (U8{57}) -> return false
        at += 1
    }
    if at == bytes.len() -> return true
    numeric_suffix(bytes, at, segment_tables.UNICODE_NUMERIC)
}

is_whitespace: fn(text: String) -> Bool Never! {
    if text.bytes().len() == 0 -> return false
    loop cp in decode_scalars(text) {
        if !is_space_cp(cp) -> return false
    }
    true
}

/// Every scalar is a tab or a space separator (General_Category Zs), as C
/// `iswblank`. Line and paragraph separators are not blank. Empty text is false.
is_blank: fn(text: String) -> Bool Never! {
    cps: decode_scalars(text)
    if cps.len() == 0 -> return false
    loop cp in cps {
        if cp != 9 && general_category(cp, text_category.UNICODE_GENERAL_CATEGORY) != GC_ZS -> return false
    }
    true
}

/// Every scalar is visible: not whitespace, not a control (Cc) and not a
/// separator (Zs, Zl, Zp), as C `iswgraph`. Format characters and unassigned
/// scalars are graphic, as they are printable for `String.isprintable`. Empty
/// text is false.
is_graphic: fn(text: String) -> Bool Never! {
    cps: decode_scalars(text)
    if cps.len() == 0 -> return false
    loop cp in cps {
        if !is_graphic_cp(cp, general_category(cp, text_category.UNICODE_GENERAL_CATEGORY)) -> return false
    }
    true
}

/// Every scalar is graphic and is neither a letter (Alphabetic), a digit
/// (Numeric), a combining mark (Mn, Mc, Me) nor a format character (Cf), as C
/// `iswpunct`: symbols such as `$`, `+` and `€` count. Empty text is false.
is_punctuation: fn(text: String) -> Bool Never! {
    cps: decode_scalars(text)
    if cps.len() == 0 -> return false
    punctuation_scalars(cps, segment_tables.UNICODE_ALPHABETIC, segment_tables.UNICODE_NUMERIC)
}

/// True iff any scalar is Unicode 17 Cc.
/// Empty text is false. Scan UTF-8 bytes without per-scalar allocation.
has_control: fn(value: String) -> Bool Never! {
    after_c2 := false
    loop b in value.bytes() {
        if b < (U8{32}) || b == (U8{127}) -> return true
        if after_c2 && b >= (U8{128}) && b <= (U8{159}) -> return true
        after_c2 = b == (U8{194})
    }
    false
}

trim: fn(text: String) -> String Never! { trim_end(trim_start(text)) }

trim_start: fn(text: String) -> String Never! {
    pairs: decode_indexed(text)
    i := 0
    loop i < pairs.len() {
        if !is_space_cp(pairs[i].cp) -> break
        i = i + 1
    }
    if i >= pairs.len() -> return ""
    slice_bytes(text.bytes(), pairs[i].index, text.bytes().len())
}

trim_end: fn(text: String) -> String Never! {
    pairs: decode_indexed(text)
    end := text.bytes().len()
    i := pairs.len() - 1
    loop i >= 0 {
        if !is_space_cp(pairs[i].cp) {
            end = pairs[i].index + text_unicode_string.utf8_width_at(text.bytes(), pairs[i].index)
            break
        }
        i = i - 1
    }
    slice_bytes(text.bytes(), 0, end)
}

/// The text Latin-1 (ISO 8859-1) `bytes` spell: each byte is the scalar with
/// its number, so every byte sequence decodes and none is lost, as node's
/// `toString('latin1')` and Python's `decode("latin-1")` read bytes.
decode_latin1: fn(bytes: [U8]) -> String Never! {
    out := [U8]{}
    loop byte in bytes {
        if byte < (U8{128}) -> out.push(byte) else -> out.extend([U8]{U8{192 + Int{byte} /% 64}, U8{128 + Int{byte} %% 64}})
    }
    String.from_bytes(out) ?? ""
}

/// The integer `text` starts with, as `parseInt(text, 10)` and C's `strtol`
/// read one: the whitespace `trim_start` skips, an optional `+` or `-`, then
/// the longest run of ASCII digits; whatever follows is ignored. None when no
/// digit comes first. Int is exact at any size, so no long run rounds.
leading_int: fn(text: String) -> Int? Never! {
    raw: trim_start(text).bytes()
    negative: raw.len() > 0 && raw[0] == (U8{45})
    start: if negative || (raw.len() > 0 && raw[0] == (U8{43})) -> 1 else -> 0
    end := start
    loop end < raw.len() && raw[end] >= (U8{48}) && raw[end] <= (U8{57}) -> end += 1
    if end == start -> return None
    digits: slice_bytes(raw, start, end)
    Val(Int.parse(if negative -> "-{digits}" else -> digits) ?? return None)
}

/// Pad on the left until `width` UTF-8 scalars. Empty `fill` returns text unchanged.
pad_start: fn(text: String, width: Int, fill: String) -> String Never! { pad_side(text, width, fill, true) }

pad_end: fn(text: String, width: Int, fill: String) -> String Never! { pad_side(text, width, fill, false) }

center: fn(text: String, width: Int, fill: String) -> String Never! {
    extra: width - scalar_count(text)
    if extra <= 0 || scalar_count(fill) == 0 -> return text.copy()
    left: extra /% 2
    pad_end(pad_start(text, scalar_count(text) + left, fill), width, fill)
}

starts_any: fn(text: String, prefixes: [String]) -> Bool Never! {
    loop p in prefixes {
        if starts_with(text, p) -> return true
    }
    false
}

ends_any: fn(text: String, suffixes: [String]) -> Bool Never! {
    loop s in suffixes {
        if ends_with(text, s) -> return true
    }
    false
}

/// At most `n` parts. `n <= 0` yields an empty list.
splitn: fn(text: String, sep: String, n: Int) -> [String] Never! { split_limit(text, sep, n, false) }

rsplitn: fn(text: String, sep: String, n: Int) -> [String] Never! { split_limit(text, sep, n, true) }


ascii_alpha: fn(b: U8) -> Bool {
    n: b
    (n >= 65 && n <= 90) || (n >= 97 && n <= 122)
}

ascii_space: fn(b: U8) -> Bool {
    n: b
    n == 32 || n == 9 || n == 10 || n == 11 || n == 12 || n == 13
}

slice_bytes: fn(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    lo := start
    hi := end
    if lo < 0 -> lo = 0
    if hi > raw.len() -> hi = raw.len()
    if hi < lo -> hi = lo
    i := lo
    loop {
        if i >= hi -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i = i + 1
    }
}

starts_with: fn(text: String, prefix: String) -> Bool {
    a: text_unicode_string.utf8_bytes(text)
    b: text_unicode_string.utf8_bytes(prefix)
    if b.len() > a.len() -> return false
    loop i in 0..<b.len() {
        if a[i] != b[i] -> return false
    }
    true
}

ends_with: fn(text: String, suffix: String) -> Bool {
    a: text_unicode_string.utf8_bytes(text)
    b: text_unicode_string.utf8_bytes(suffix)
    if b.len() > a.len() -> return false
    off: a.len() - b.len()
    loop i in 0..<b.len() {
        if a[off + i] != b[i] -> return false
    }
    true
}

pad_side: fn(text: String, width: Int, fill: String, left: Bool) -> String {
    extra: width - scalar_count(text)
    units: scalars(fill)
    if extra <= 0 || units.len() == 0 -> return text.copy()
    added := [String]{}
    i := 0
    loop added.len() < extra {
        added.push(units[i])
        i = (i + 1) % units.len()
    }
    prefix := ""
    suffix := ""
    loop part in added {
        if left -> prefix = "{prefix}{part}" else -> suffix = "{suffix}{part}"
    }
    "{prefix}{text}{suffix}"
}

split_limit: fn(text: String, sep: String, n: Int, from_right: Bool) -> [String] {
    if n <= 0 -> return [String]{}
    if n == 1 || text_unicode_string.utf8_bytes(sep).len() == 0 -> return [String]{text}
    parts := [String]{}
    rest := text
    loop {
        if parts.len() + 1 >= n {
            parts.push(rest)
            return parts
        }
        at: find_sep(rest, sep, from_right)
        if at < 0 {
            parts.push(rest)
            return parts
        }
        if from_right {
            parts.push(slice_bytes(text_unicode_string.utf8_bytes(rest), at + text_unicode_string.utf8_bytes(sep).len(), text_unicode_string.utf8_bytes(rest).len()))
            rest = slice_bytes(text_unicode_string.utf8_bytes(rest), 0, at)
        } else {
            parts.push(slice_bytes(text_unicode_string.utf8_bytes(rest), 0, at))
            rest = slice_bytes(text_unicode_string.utf8_bytes(rest), at + text_unicode_string.utf8_bytes(sep).len(), text_unicode_string.utf8_bytes(rest).len())
        }
    }
}

find_sep: fn(text: String, sep: String, from_right: Bool) -> Int {
    hay: text.bytes()
    needle: sep.bytes()
    if needle.len() == 0 || needle.len() > hay.len() -> return -1
    last: hay.len() - needle.len()
    if from_right {
        i := last
        loop {
            if i < 0 -> return -1
            if match_at(hay, needle, i) -> return i
            i = i - 1
        }
    }
    loop i in 0..<(last + 1) {
        if match_at(hay, needle, i) -> return i
    }
    -1
}

match_at: fn(hay: [U8], needle: [U8], start: Int) -> Bool {
    loop i in 0..<needle.len() {
        if hay[start + i] != needle[i] -> return false
    }
    true
}

IndexedCp: struct {
    index: Int
    cp: Int
}

decode_scalars: fn(text: String) -> [Int] Never! { text_width.decode_scalars(text) }

decode_indexed: fn(text: String) -> [IndexedCp] Never! {
    raw: text_unicode_string.utf8_bytes(text)
    out := [IndexedCp]{}
    i := 0
    loop {
        if i >= raw.len() -> return out
        start: i
        first: Int{raw[i]}
        width: text_unicode_string.utf8_width_at(raw, i)
        if width == 1 {
            if first < 128 {
                out.push(IndexedCp{index: start, cp: first})
            } else {
                out.push(IndexedCp{index: start, cp: 65533})
            }
            i = i + 1
            next
        }
        cp := 0
        if width == 2 -> cp = (first).bit_and(31)
        if width == 3 -> cp = (first).bit_and(15)
        if width == 4 -> cp = (first).bit_and(7)
        valid := true
        k := 1
        loop k < width {
            byte: Int{raw[i + k]}
            if byte < 128 || byte >= 192 {
                valid = false
                break
            }
            cp = ((cp << 6)).bit_or(((byte).bit_and(63)))
            k = k + 1
        }
        if !valid {
            out.push(IndexedCp{index: start, cp: 65533})
            i = i + 1
            next
        }
        out.push(IndexedCp{index: start, cp: cp})
        i = i + width
    }
}

encode_cp: fn(cp: Int) -> String {
    out := [U8]{}
    text_unicode_string.append_cp(out, cp)
    String.from_bytes(out) ?? ""
}

encode_cps: fn(cps: [Int]) -> String {
    out := ""
    loop cp in cps -> out = "{out}{encode_cp(cp)}"
    out
}

// Read parameters borrow the canonical tables without creating owned locals.
// Their stable-place windows stay inside the suffix scan and never escape.
alphabetic_suffix: fn(bytes: View<U8>, offset: Int, table: [U8]) -> Bool Never! {
    window: table[0..<table.len()]
    at := offset
    loop at < bytes.len() {
        scalar: unicode_scalar_at(bytes, at)
        if !is_alpha_cp(scalar.cp, window) -> return false
        at = scalar.end
    }
    true
}

numeric_suffix: fn(bytes: View<U8>, offset: Int, table: [U8]) -> Bool Never! {
    window: table[0..<table.len()]
    at := offset
    loop at < bytes.len() {
        scalar: unicode_scalar_at(bytes, at)
        if !is_digit_cp(scalar.cp, window) -> return false
        at = scalar.end
    }
    true
}

is_alpha_cp: fn(cp: Int, table: View<U8>) -> Bool Never! {
    if cp < 128 -> return (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122)
    segment_contains(table, cp)
}

is_digit_cp: fn(cp: Int, table: View<U8>) -> Bool Never! {
    if cp < 128 -> return cp >= 48 && cp <= 57
    segment_contains(table, cp)
}

// Callers pass bytes of a valid UTF-8 String and an offset at a scalar start.
// Read one scalar in place instead of materializing both decoder vectors.
unicode_scalar_at: fn(raw: View<U8>, at: Int) -> (cp: Int, end: Int) Never! {
    first: Int{raw[at]}
    if first < 128 -> return (cp: first, end: at + 1)
    width := 2
    cp := first.bit_and(31)
    if first >= 240 {
        width = 4
        cp = first.bit_and(7)
    } else if first >= 224 {
        width = 3
        cp = first.bit_and(15)
    }
    loop offset in 1..<width {
        cp = (cp << 6).bit_or((Int{raw[at + offset]}.bit_and(63)))
    }
    (cp: cp, end: at + width)
}

is_space_cp: fn(cp: Int) -> Bool {
    if cp >= 9 && cp <= 13 -> return true
    if cp == 32 || cp == 133 || cp == 160 -> return true
    if cp == 5760 || cp == 8239 || cp == 8287 || cp == 12288 -> return true
    if cp >= 8192 && cp <= 8202 -> return true
    if cp == 8232 || cp == 8233 -> return true
    false
}

// General_Category tags of UNICODE_GENERAL_CATEGORY, in the order of GC_TAGS in
// Tools/agent/UnicodeTables.jet; every other category reads as GC_OTHER.
GC_CC: 0
GC_CF: 1
GC_MC: 4
GC_ZS: 5
GC_ZL: 6
GC_ZP: 7
GC_OTHER: 8

// General_Category reads behind the character classes: not part of the text
// surface.
priv unicode_category: module {
    general_category: fn(cp: Int, table: [U8]) -> Int Never! { text_asset.asset_tag(table, cp, GC_OTHER) }

    is_graphic_cp: fn(cp: Int, category: Int) -> Bool Never! {
        !is_space_cp(cp) && category != GC_CC && category != GC_ZS && category != GC_ZL && category != GC_ZP
    }

    // Cf, Mn, Me and Mc are the tags GC_CF through GC_MC.
    punctuation_scalars: fn(cps: [Int], alphabetic: [U8], numeric: [U8]) -> Bool Never! {
        alpha_window: alphabetic[0..<alphabetic.len()]
        numeric_window: numeric[0..<numeric.len()]
        loop cp in cps {
            category: general_category(cp, text_category.UNICODE_GENERAL_CATEGORY)
            if !is_graphic_cp(cp, category) -> return false
            if category >= GC_CF && category <= GC_MC -> return false
            if is_alpha_cp(cp, alpha_window) || is_digit_cp(cp, numeric_window) -> return false
        }
        true
    }
}

combining_class: fn(cp: Int) -> Int {
    if cp >= 768 && cp <= 879 -> return 230
    if cp >= 7616 && cp <= 7679 -> return 230
    if cp >= 8400 && cp <= 8432 -> return 230
    if cp >= 65056 && cp <= 65071 -> return 230
    0
}

is_extend: fn(cp: Int) -> Bool { combining_class(cp) != 0 || (cp >= 0xFE00 && cp <= 0xFE0F) || (cp >= 0x1F3FB && cp <= 0x1F3FF) || cp == 0x200C || cp == 0x200D || cp == 0xFF9E || cp == 0xFF9F }

C_SBASE: 44032
C_LBASE: 4352
C_VBASE: 4449
C_TBASE: 4519
C_LCOUNT: 19
C_VCOUNT: 21
C_TCOUNT: 28
C_NCOUNT: 588
C_SCOUNT: 11172

hangul_decompose: fn(cp: Int) -> [Int] {
    sindex: cp - C_SBASE
    if sindex < 0 || sindex >= C_SCOUNT -> return [Int]{cp}
    l: C_LBASE + sindex /% C_NCOUNT
    v: C_VBASE + (sindex % C_NCOUNT) /% C_TCOUNT
    t: C_TBASE + sindex % C_TCOUNT
    if t == C_TBASE -> return [Int]{l, v}
    [Int]{l, v, t}
}

hangul_compose: fn(a: Int, b: Int) -> Int? {
    lindex: a - C_LBASE
    if lindex >= 0 && lindex < C_LCOUNT {
        vindex: b - C_VBASE
        if vindex >= 0 && vindex < C_VCOUNT -> return Val(C_SBASE + (lindex * C_VCOUNT + vindex) * C_TCOUNT)
    }
    sindex: a - C_SBASE
    if sindex >= 0 && sindex < C_SCOUNT && sindex % C_TCOUNT == 0 {
        tindex: b - C_TBASE
        if tindex > 0 && tindex < C_TCOUNT -> return Val(a + tindex)
    }
    None
}

decompose: fn(text: String, compat: Bool) -> [Int] {
    raw := [Int]{}
    loop cp in decode_scalars(text) {
        pieces: decompose_cp(cp, compat)
        loop p in pieces -> raw.push(p)
    }
    canon_order(raw)
}

decompose_cp: fn(cp: Int, compat: Bool) -> [Int] {
    if cp >= C_SBASE && cp < C_SBASE + C_SCOUNT -> return hangul_decompose(cp)
    if cp == 192 -> return [Int]{65, 768}
    if cp == 193 -> return [Int]{65, 769}
    if cp == 194 -> return [Int]{65, 770}
    if cp == 195 -> return [Int]{65, 771}
    if cp == 196 -> return [Int]{65, 776}
    if cp == 197 -> return [Int]{65, 778}
    if cp == 199 -> return [Int]{67, 807}
    if cp == 200 -> return [Int]{69, 768}
    if cp == 201 -> return [Int]{69, 769}
    if cp == 202 -> return [Int]{69, 770}
    if cp == 203 -> return [Int]{69, 776}
    if cp == 204 -> return [Int]{73, 768}
    if cp == 205 -> return [Int]{73, 769}
    if cp == 206 -> return [Int]{73, 770}
    if cp == 207 -> return [Int]{73, 776}
    if cp == 209 -> return [Int]{78, 771}
    if cp == 210 -> return [Int]{79, 768}
    if cp == 211 -> return [Int]{79, 769}
    if cp == 212 -> return [Int]{79, 770}
    if cp == 213 -> return [Int]{79, 771}
    if cp == 214 -> return [Int]{79, 776}
    if cp == 217 -> return [Int]{85, 768}
    if cp == 218 -> return [Int]{85, 769}
    if cp == 219 -> return [Int]{85, 770}
    if cp == 220 -> return [Int]{85, 776}
    if cp == 221 -> return [Int]{89, 769}
    if cp == 224 -> return [Int]{97, 768}
    if cp == 225 -> return [Int]{97, 769}
    if cp == 226 -> return [Int]{97, 770}
    if cp == 227 -> return [Int]{97, 771}
    if cp == 228 -> return [Int]{97, 776}
    if cp == 229 -> return [Int]{97, 778}
    if cp == 231 -> return [Int]{99, 807}
    if cp == 232 -> return [Int]{101, 768}
    if cp == 233 -> return [Int]{101, 769}
    if cp == 234 -> return [Int]{101, 770}
    if cp == 235 -> return [Int]{101, 776}
    if cp == 236 -> return [Int]{105, 768}
    if cp == 237 -> return [Int]{105, 769}
    if cp == 238 -> return [Int]{105, 770}
    if cp == 239 -> return [Int]{105, 776}
    if cp == 241 -> return [Int]{110, 771}
    if cp == 242 -> return [Int]{111, 768}
    if cp == 243 -> return [Int]{111, 769}
    if cp == 244 -> return [Int]{111, 770}
    if cp == 245 -> return [Int]{111, 771}
    if cp == 246 -> return [Int]{111, 776}
    if cp == 249 -> return [Int]{117, 768}
    if cp == 250 -> return [Int]{117, 769}
    if cp == 251 -> return [Int]{117, 770}
    if cp == 252 -> return [Int]{117, 776}
    if cp == 253 -> return [Int]{121, 769}
    if cp == 255 -> return [Int]{121, 776}
    if cp == 304 -> return [Int]{73, 775}
    if compat {
        if cp >= 65281 && cp <= 65374 -> return [Int]{cp - 65248}
        if cp == 64256 -> return [Int]{102, 102}
        if cp == 64257 -> return [Int]{102, 105}
        if cp == 64258 -> return [Int]{102, 108}
        if cp == 64259 -> return [Int]{102, 102, 105}
        if cp == 64260 -> return [Int]{102, 102, 108}
        if cp == 64261 -> return [Int]{115, 116}
        if cp == 64262 -> return [Int]{115, 116}
        if cp == 185 -> return [Int]{49}
        if cp == 178 -> return [Int]{50}
        if cp == 179 -> return [Int]{51}
    }
    [Int]{cp}
}

canon_order: fn(cps: [Int]) -> [Int] {
    out := [Int]{}
    loop c in cps -> out.push(c)
    i := 1
    loop {
        if i >= out.len() -> return out
        cc: combining_class(out[i])
        prev: combining_class(out[i - 1])
        if cc != 0 && prev > cc {
            tmp: out[i]
            out[i] = out[i - 1]
            out[i - 1] = tmp
            if i > 1 {
                i = i - 1
                next
            }
        }
        i = i + 1
    }
}

compose: fn(cps: [Int]) -> String {
    if cps.len() == 0 -> return ""
    out := [Int]{}
    starter := -1
    last_class := -1
    loop cp in cps {
        cc: combining_class(cp)
        if starter >= 0 {
            composed: compose_pair(out[starter], cp)
            if composed != None && last_class < cc {
                out[starter] = composed
                next
            }
        }
        out.push(cp)
        if cc == 0 {
            starter = out.len() - 1
            last_class = -1
        } else {
            last_class = cc
        }
    }
    encode_cps(out)
}

compose_pair: fn(a: Int, b: Int) -> Int? {
    h: hangul_compose(a, b)
    if h != None -> return Val(h)
    if b == 768 {
        if a == 65 -> return Val(192)
        if a == 69 -> return Val(200)
        if a == 73 -> return Val(204)
        if a == 79 -> return Val(210)
        if a == 85 -> return Val(217)
        if a == 97 -> return Val(224)
        if a == 101 -> return Val(232)
        if a == 105 -> return Val(236)
        if a == 111 -> return Val(242)
        if a == 117 -> return Val(249)
    }
    if b == 769 {
        if a == 65 -> return Val(193)
        if a == 69 -> return Val(201)
        if a == 73 -> return Val(205)
        if a == 79 -> return Val(211)
        if a == 85 -> return Val(218)
        if a == 89 -> return Val(221)
        if a == 97 -> return Val(225)
        if a == 101 -> return Val(233)
        if a == 105 -> return Val(237)
        if a == 111 -> return Val(243)
        if a == 117 -> return Val(250)
        if a == 121 -> return Val(253)
    }
    if b == 770 {
        if a == 65 -> return Val(194)
        if a == 69 -> return Val(202)
        if a == 73 -> return Val(206)
        if a == 79 -> return Val(212)
        if a == 85 -> return Val(219)
        if a == 97 -> return Val(226)
        if a == 101 -> return Val(234)
        if a == 105 -> return Val(238)
        if a == 111 -> return Val(244)
        if a == 117 -> return Val(251)
    }
    if b == 771 {
        if a == 65 -> return Val(195)
        if a == 78 -> return Val(209)
        if a == 79 -> return Val(213)
        if a == 97 -> return Val(227)
        if a == 110 -> return Val(241)
        if a == 111 -> return Val(245)
    }
    if b == 775 && a == 73 -> return Val(304)
    if b == 776 {
        if a == 65 -> return Val(196)
        if a == 69 -> return Val(203)
        if a == 73 -> return Val(207)
        if a == 79 -> return Val(214)
        if a == 85 -> return Val(220)
        if a == 97 -> return Val(228)
        if a == 101 -> return Val(235)
        if a == 105 -> return Val(239)
        if a == 111 -> return Val(246)
        if a == 117 -> return Val(252)
        if a == 121 -> return Val(255)
    }
    if b == 778 {
        if a == 65 -> return Val(197)
        if a == 97 -> return Val(229)
    }
    if b == 807 {
        if a == 67 -> return Val(199)
        if a == 99 -> return Val(231)
    }
    None
}

split_graphemes: fn(text: String) -> [String] {
    cps: decode_scalars(text)
    if cps.len() == 0 -> return [String]{}
    out := [String]{}
    cluster := [Int]{cps[0]}
    ri_run := if is_ri(cps[0]) -> 1 else -> 0
    i := 1
    loop {
        if i >= cps.len() {
            out.push(encode_cps(cluster))
            return out
        }
        prev: cluster[cluster.len() - 1]
        cur: cps[i]
        break_here := grapheme_break(prev, cur)
        // GB11 needs a pictographic Extend* prefix before the ZWJ.
        if prev == 0x200D && is_emoji(cur) -> break_here = !has_emoji_zwj_prefix(cluster)
        if is_ri(prev) && is_ri(cur) && ri_run % 2 == 0 -> break_here = true
        if break_here {
            out.push(encode_cps(cluster))
            cluster = [Int]{cur}
            ri_run = if is_ri(cur) -> 1 else -> 0
        } else {
            cluster.push(cur)
            if is_ri(cur) -> ri_run = ri_run + 1 else -> ri_run = 0
        }
        i = i + 1
    }
}

grapheme_break: fn(prev: Int, cur: Int) -> Bool {
    // GB3 CR × LF
    if prev == 13 && cur == 10 -> return false
    // GB4 / GB5
    if prev == 13 || prev == 10 || is_grapheme_control(prev) -> return true
    if cur == 13 || cur == 10 || is_grapheme_control(cur) -> return true
    // GB6-8 Hangul
    if is_l(prev) && (is_l(cur) || is_v(cur) || is_lv(cur) || is_lvt(cur)) -> return false
    if (is_lv(prev) || is_v(prev)) && (is_v(cur) || is_t(cur)) -> return false
    if (is_lvt(prev) || is_t(prev)) && is_t(cur) -> return false
    // GB9 Extend / ZWJ
    if is_extend(cur) || cur == 0x200D -> return false
    // GB9a SpacingMark (approx: Mc)
    if cur >= 0x0903 && cur <= 0x0903 -> return false
    // GB12/13 RI × RI
    if is_ri(prev) && is_ri(cur) -> return false
    true
}
has_emoji_zwj_prefix: fn(cluster: [Int]) -> Bool {
    i := cluster.len() - 2
    loop i >= 0 {
        cp: cluster[i]
        if cp == 0x200D -> return false
        if !is_extend(cp) -> return is_emoji(cp)
        i = i - 1
    }
    false
}


is_grapheme_control: fn(cp: Int) -> Bool { (cp < 32 && cp != 9 && cp != 10 && cp != 13) || (cp >= 127 && cp <= 159) }
is_l: fn(cp: Int) -> Bool { cp >= C_LBASE && cp < C_LBASE + C_LCOUNT }
is_v: fn(cp: Int) -> Bool { cp >= C_VBASE && cp < C_VBASE + C_VCOUNT }
is_t: fn(cp: Int) -> Bool { cp >= C_TBASE + 1 && cp < C_TBASE + C_TCOUNT }
is_lv: fn(cp: Int) -> Bool {
    s: cp - C_SBASE
    s >= 0 && s < C_SCOUNT && s % C_TCOUNT == 0
}
is_lvt: fn(cp: Int) -> Bool {
    s: cp - C_SBASE
    s >= 0 && s < C_SCOUNT && s % C_TCOUNT != 0
}
is_ri: fn(cp: Int) -> Bool { cp >= 127462 && cp <= 127487 }
is_emoji: fn(cp: Int) -> Bool { (cp >= 0x1F300 && cp <= 0x1FAFF) || (cp >= 0x2600 && cp <= 0x27BF) }

// UAX #29 WB/SB algorithm adapted from 7c42badbb's text segmentation port. Tags
// are the generator's WORD_TAGS / SENTENCE_TAGS.
WB_CR: 1
WB_LF: 2
WB_NEWLINE: 3
WB_EXTEND: 4
WB_ZWJ: 5
WB_RI: 6
WB_FORMAT: 7
WB_KATAKANA: 8
WB_HEBREW: 9
WB_ALETTER: 10
WB_SINGLEQUOTE: 11
WB_DOUBLEQUOTE: 12
WB_MIDNUMLET: 13
WB_MIDLETTER: 14
WB_MIDNUM: 15
WB_NUMERIC: 16
WB_EXTENDNUMLET: 17
WB_WSEGSPACE: 18
SB_CR: 1
SB_LF: 2
SB_EXTEND: 3
SB_SEP: 4
SB_FORMAT: 5
SB_SP: 6
SB_LOWER: 7
SB_UPPER: 8
SB_OLETTER: 9
SB_NUMERIC: 10
SB_ATERM: 11
SB_SCONTINUE: 12
SB_STERM: 13
SB_CLOSE: 14

// JUCD schema 1, explicit little-endian 3-byte scalar range endpoints.
// Tables are checksum-verified and round-tripped by the generator, not decoded
// into another allocation at startup. Header size is 40 bytes.
segment_uint: fn(table: View<U8>, at: Int) -> Int Never! {
    Int{table[at]}.bit_or((Int{table[at + 1]} << 8)).bit_or((Int{table[at + 2]} << 16))
}
segment_row: fn(table: View<U8>, cp: Int, stride: Int) -> Int Never! {
    low := 0
    high := (table.len() - 40) /% stride
    loop low < high {
        mid: (low + high) /% 2
        row: 40 + mid * stride
        if cp < segment_uint(table, row) -> high = mid
        else if cp > segment_uint(table, row + 3) -> low = mid + 1
        else -> return row
    }
    -1
}
segment_tag: fn(table: View<U8>, cp: Int) -> Int Never! {
    row: segment_row(table, cp, 7)
    if row < 0 -> return 0
    Int{table[row + 6]}
}
segment_contains: fn(table: View<U8>, cp: Int) -> Bool Never! { segment_row(table, cp, 6) >= 0 }

WordUnit: struct { class: Int, first: Int, last: Int, end: Int }
is_word_newline: fn(class: Int) -> Bool Never! { class == WB_NEWLINE || class == WB_CR || class == WB_LF }
is_ahletter: fn(class: Int) -> Bool Never! { class == WB_ALETTER || class == WB_HEBREW }
is_midletter_q: fn(class: Int) -> Bool Never! { class == WB_MIDLETTER || class == WB_MIDNUMLET || class == WB_SINGLEQUOTE }
is_midnum_q: fn(class: Int) -> Bool Never! { class == WB_MIDNUM || class == WB_MIDNUMLET || class == WB_SINGLEQUOTE }

// WB4: ignore Extend/Format/ZWJ after any non-newline unit, retaining its
// actual last scalar class for WB3c and WB3d. Ends are exclusive byte offsets.
word_reduce: fn(pairs: [IndexedCp], byte_len: Int) -> [WordUnit] Never! {
    units := [WordUnit]{}
    table: segment_tables.UNICODE_WORD_BREAK
    window: table[0..<table.len()]
    loop i in 0..<pairs.len() {
        cp: pairs[i].cp
        class: segment_tag(window, cp)
        end: if i + 1 < pairs.len() -> pairs[i + 1].index else -> byte_len
        count: units.len()
        if count > 0 && (class == WB_EXTEND || class == WB_FORMAT || class == WB_ZWJ) {
            base: units[count - 1].class
            if !is_word_newline(base) {
                first: units[count - 1].first
                units[count - 1] = WordUnit{class: base, first: first, last: class, end: end}
                next
            }
        }
        units.push(WordUnit{class: class, first: cp, last: class, end: end})
    }
    units
}
word_break_at: fn(units: [WordUnit], i: Int, pictographic: View<U8>) -> Bool Never! {
    pc: units[i].class
    cc: units[i + 1].class
    n: units.len()
    if pc == WB_CR && cc == WB_LF -> return false // WB3
    if is_word_newline(pc) || is_word_newline(cc) -> return true // WB3a/b
    if units[i].last == WB_ZWJ && segment_contains(pictographic, units[i + 1].first) -> return false // WB3c
    if pc == WB_WSEGSPACE && cc == WB_WSEGSPACE && units[i].last == WB_WSEGSPACE -> return false // WB3d
    if is_ahletter(pc) && is_ahletter(cc) -> return false // WB5
    if is_ahletter(pc) && is_midletter_q(cc) && i + 2 < n && is_ahletter(units[i + 2].class) -> return false // WB6
    if is_ahletter(cc) && is_midletter_q(pc) && i >= 1 && is_ahletter(units[i - 1].class) -> return false // WB7
    if pc == WB_HEBREW && cc == WB_SINGLEQUOTE -> return false // WB7a
    if pc == WB_HEBREW && cc == WB_DOUBLEQUOTE && i + 2 < n && units[i + 2].class == WB_HEBREW -> return false // WB7b
    if pc == WB_DOUBLEQUOTE && cc == WB_HEBREW && i >= 1 && units[i - 1].class == WB_HEBREW -> return false // WB7c
    if pc == WB_NUMERIC && cc == WB_NUMERIC -> return false // WB8
    if is_ahletter(pc) && cc == WB_NUMERIC -> return false // WB9
    if pc == WB_NUMERIC && is_ahletter(cc) -> return false // WB10
    if cc == WB_NUMERIC && is_midnum_q(pc) && i >= 1 && units[i - 1].class == WB_NUMERIC -> return false // WB11
    if pc == WB_NUMERIC && is_midnum_q(cc) && i + 2 < n && units[i + 2].class == WB_NUMERIC -> return false // WB12
    if pc == WB_KATAKANA && cc == WB_KATAKANA -> return false // WB13
    if (is_ahletter(pc) || pc == WB_NUMERIC || pc == WB_KATAKANA || pc == WB_EXTENDNUMLET) && cc == WB_EXTENDNUMLET -> return false // WB13a
    if pc == WB_EXTENDNUMLET && (is_ahletter(cc) || cc == WB_NUMERIC || cc == WB_KATAKANA) -> return false // WB13b
    true // WB999
}
word_boundaries: fn(pairs: [IndexedCp], byte_len: Int) -> [Int] Never! {
    out := [Int]{}
    if pairs.len() == 0 -> return out
    units: word_reduce(pairs, byte_len)
    pictographic: segment_tables.UNICODE_EXTENDED_PICTOGRAPHIC
    pictographic_window: pictographic[0..<pictographic.len()]
    ri_run := 0
    loop i in 0..<units.len() {
        class: units[i].class
        ri_run = if class == WB_RI -> ri_run + 1 else -> 0
        if i + 1 < units.len() {
            split: if class == WB_RI && units[i + 1].class == WB_RI -> ri_run % 2 == 0 else -> word_break_at(units, i, pictographic_window)
            if split -> out.push(units[i].end)
        }
    }
    out.push(byte_len)
    out
}
split_words: fn(text: String) -> [String] Never! {
    raw: text.bytes()
    pairs: decode_indexed(text)
    alphabetic: segment_tables.UNICODE_ALPHABETIC
    numeric: segment_tables.UNICODE_NUMERIC
    alphabetic_window: alphabetic[0..<alphabetic.len()]
    numeric_window: numeric[0..<numeric.len()]
    out := [String]{}
    start := 0
    at := 0
    loop end in word_boundaries(pairs, raw.len()) {
        keep := false
        loop at < pairs.len() && pairs[at].index < end {
            if !keep -> keep = segment_contains(alphabetic_window, pairs[at].cp) || segment_contains(numeric_window, pairs[at].cp)
            at = at + 1
        }
        if keep -> out.push(slice_bytes(raw, start, end))
        start = end
    }
    out
}

SentenceUnit: struct { class: Int, end: Int }
is_sentence_para: fn(class: Int) -> Bool Never! { class == SB_SEP || class == SB_CR || class == SB_LF }
sentence_lower_follows: fn(units: [SentenceUnit], from: Int) -> Bool Never! {
    k := from
    loop k < units.len() {
        class: units[k].class
        if class == SB_LOWER -> return true
        if class == SB_OLETTER || class == SB_UPPER || is_sentence_para(class) || class == SB_STERM || class == SB_ATERM -> return false
        k = k + 1
    }
    false
}
// SB998/SB999 do NOT break. SB11 places the boundary after SATerm Close* Sp*
// unless the SB8/SB8a/SB9/SB10 context suppresses it.
sentence_breaks: fn(units: [SentenceUnit]) -> [Bool] Never! {
    n: units.len()
    breaks := [Bool]{}
    loop _ in 1..<n -> breaks.push(false)
    i := 0
    loop i + 1 < n {
        current: units[i].class
        if current == SB_CR && units[i + 1].class == SB_LF {
            i = i + 1 // SB3
            next
        }
        if is_sentence_para(current) {
            breaks[i] = true // SB4
            i = i + 1
            next
        }
        if current == SB_ATERM || current == SB_STERM {
            if current == SB_ATERM && units[i + 1].class == SB_NUMERIC {
                i = i + 1 // SB6
                next
            }
            if current == SB_ATERM && i > 0 && (units[i - 1].class == SB_UPPER || units[i - 1].class == SB_LOWER) && units[i + 1].class == SB_UPPER {
                i = i + 1 // SB7
                next
            }
            j := i + 1
            loop j < n && units[j].class == SB_CLOSE -> j = j + 1
            close_end: j
            loop j < n && units[j].class == SB_SP -> j = j + 1
            sp_end: j
            sb9: close_end < n && is_sentence_para(units[close_end].class)
            sb10: sp_end < n && (units[sp_end].class == SB_SP || is_sentence_para(units[sp_end].class))
            sb8a: sp_end < n && (units[sp_end].class == SB_SCONTINUE || units[sp_end].class == SB_STERM || units[sp_end].class == SB_ATERM)
            sb8: current == SB_ATERM && sentence_lower_follows(units, sp_end)
            if !(sb9 || sb10 || sb8a || sb8) && sp_end > 0 && sp_end - 1 < breaks.len() -> breaks[sp_end - 1] = true // SB11
            i = if sp_end > i -> sp_end else -> i + 1
            next
        }
        i = i + 1
    }
    breaks
}
sentence_boundaries: fn(pairs: [IndexedCp], byte_len: Int) -> [Int] Never! {
    out := [Int]{}
    if pairs.len() == 0 -> return out
    units := [SentenceUnit]{}
    table: segment_tables.UNICODE_SENTENCE_BREAK
    window: table[0..<table.len()]
    loop i in 0..<pairs.len() {
        class: segment_tag(window, pairs[i].cp)
        end: if i + 1 < pairs.len() -> pairs[i + 1].index else -> byte_len
        count: units.len()
        if count > 0 && (class == SB_EXTEND || class == SB_FORMAT) {
            base: units[count - 1].class
            if !is_sentence_para(base) {
                units[count - 1] = SentenceUnit{class: base, end: end}
                next
            }
        }
        units.push(SentenceUnit{class: class, end: end})
    }
    breaks: sentence_breaks(units)
    loop i in 0..<breaks.len() {
        if breaks[i] -> out.push(units[i].end)
    }
    out.push(byte_len)
    out
}
split_sentences: fn(text: String) -> [String] Never! {
    raw: text.bytes()
    out := [String]{}
    start := 0
    loop end in sentence_boundaries(decode_indexed(text), raw.len()) {
        sentence: slice_bytes(raw, start, end).trim()
        if sentence != "" -> out.push(sentence)
        start = end
    }
    out
}

split_lines: fn(text: String) -> [String] {
    raw: text.bytes()
    if raw.len() == 0 -> return [String]{}
    out := [String]{}
    start := 0
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{10}) || raw[i] == (U8{13}) {
            out.push(slice_bytes(raw, start, i))
            if raw[i] == (U8{13}) && i + 1 < raw.len() && raw[i + 1] == (U8{10}) -> i = i + 1
            i = i + 1
            start = i
            next
        }
        i = i + 1
    }
    if start < raw.len() -> out.push(slice_bytes(raw, start, raw.len()))
    out
}


hex_cp: fn(cp: Int) -> String {
    hex: "0123456789ABCDEF"
    hb: hex.bytes()
    n := cp
    digits := [U8]{}
    if n == 0 -> digits.push(U8{48})
    loop {
        if n == 0 -> break
        digits.push(hb[n % 16])
        n = n /% 16
    }
    // pad to 4
    loop {
        if digits.len() >= 4 -> break
        digits.push(U8{48})
    }
    out := [U8]{85, 43} // U+
    i := digits.len() - 1
    loop {
        if i < 0 -> return String.from_bytes(out) ?? ""
        out.push(digits[i])
        i = i - 1
    }
}

// The Unicode 17.0.0 name of `cp` from the pinned UNICODE_NAME_INDEX asset
// (Tools/agent/UnicodeTables.jet; control scalars carry their Unicode 1.0
// names), or `UNASSIGNED` when the index has no row: one binary search over the
// asset's sorted rows and one copy of the name's UTF-8 bytes.
unicode_name: fn(cp: Int) -> String Never! {
    // #4318/#4392: capture the static list once and keep its borrows in scope.
    asset: text_unicode_name_index.UNICODE_NAME_INDEX
    assert(text_asset.valid(asset, 8, 11), "invalid Unicode asset schema/version/extent")
    pool_start: text_asset.uint(asset[0..<asset.len()], 28, 4)
    index: asset[40..<pool_start]
    names: asset[pool_start..<asset.len()]
    span: text_tables.name_span(index, names, cp) ?? return "UNASSIGNED"
    name := [U8]{}
    loop at in span.start..<(span.start + span.length) -> name.push(names[at])
    String.from_bytes(name) ?? "UNASSIGNED"
}

// Unicode's default collation order. This is UTS #10 over
// the CLDR 48 root table for Unicode 17.0.0 (Core/Text/CollationTable.jet),
// and English uses it untailored. Variable weighting is non-ignorable. Levels
// 1-3 are followed by an identical level on the NFD scalars, so `collate` is
// Equal only for canonically equivalent text. String `<` and sort() keep byte
// order, which is LC_COLLATE=C order.

/// Compares `left` and `right` in Unicode's default collation order, the
/// order English speakers read (`apple` < `Banana` < `éclair` < `zebra`).
collate: fn(left: String, right: String) -> Ordering Never! {
    compare_collation_keys(collation_key(left), collation_key(right))
}

/// The bytes whose byte order is `collate` order: sort by
/// `collation_key(value)` to build one key per item instead of comparing
/// with `collate` at every step.
collation_key: fn(value: String) -> [U8] Never! {
    scalars: decode_scalars(text_normal.normalize(value, false, false))
    elements: collation_elements(scalars)
    key := [U8]{}
    loop level in 0..<3 {
        width: if level == 2 -> 1 else -> 2
        at := level
        loop at < elements.len() {
            weight: elements[at]
            if weight != 0 -> push_collation_weight(key, weight, width)
            at += 3
        }
        push_collation_weight(key, 0, width)
    }
    loop scalar in scalars -> push_collation_weight(key, scalar, 3)
    key
}

compare_collation_keys: fn(left: [U8], right: [U8]) -> Ordering Never! {
    at := 0
    loop at < left.len() && at < right.len() {
        if left[at] != right[at] -> return if left[at] < right[at] -> Ordering.Less else -> Ordering.Greater
        at += 1
    }
    left.len() <=> right.len()
}

push_collation_weight: fn(key: &[U8], weight: Int, width: Int) Never! {
    loop at in 0..<width -> key.push(U8{(weight >> (8 * (width - 1 - at))).bit_and(Int{255})})
}

COLLATION_ABSENT: 16777215

// UTS #10 S2: the collation elements of NFD scalars as flat (primary,
// secondary, tertiary) triples. Each step takes the longest contiguous table
// key, then extends it with unblocked non-starters (discontiguous contraction).
collation_elements: fn(scalars: [Int]) -> [Int] Never! {
    // #4318/#4392: bind each asset once and keep its views in this scope.
    elements_asset: collation_table.COLLATION_ELEMENTS
    contractions_asset: collation_table.COLLATION_CONTRACTIONS
    ideographs_asset: collation_table.COLLATION_UNIFIED_IDEOGRAPHS
    ccc_asset: text_ccc.UNICODE_CCC
    assert(text_asset.valid(elements_asset, 9, 7), "invalid collation asset schema/version/extent")
    assert(text_asset.valid(contractions_asset, 10, 13), "invalid collation asset schema/version/extent")
    assert(text_asset.valid(ideographs_asset, 2, 6), "invalid collation asset schema/version/extent")
    assert(text_asset.valid(ccc_asset, 3, 7), "invalid Unicode asset schema/version/extent")
    elements_bytes: elements_asset[0..<elements_asset.len()]
    contractions_bytes: contractions_asset[0..<contractions_asset.len()]
    ideographs_bytes: ideographs_asset[0..<ideographs_asset.len()]
    ccc_bytes: ccc_asset[0..<ccc_asset.len()]
    singles: elements_asset[40..<text_asset.uint(elements_bytes, 28, 4)]
    pool: elements_asset[text_asset.uint(elements_bytes, 28, 4)..<elements_asset.len()]
    contractions: contractions_asset[40..<text_asset.uint(contractions_bytes, 28, 4)]
    ideographs: ideographs_asset[40..<text_asset.uint(ideographs_bytes, 28, 4)]
    ccc: ccc_asset[40..<text_asset.uint(ccc_bytes, 28, 4)]
    out := [Int]{}
    taken := [Bool]{}
    loop _scalar in scalars -> taken.push(false)
    at := 0
    loop at < scalars.len() {
        if taken[at] {
            at += 1
            next
        }
        key := [Int]{scalars[at]}
        row := -1
        next_at := at + 1
        loop next_at < scalars.len() && key.len() < 3 && !taken[next_at] {
            found: collation_contraction_row(contractions, key, scalars[next_at])
            if found < 0 -> break
            key.push(scalars[next_at])
            row = found
            next_at += 1
        }
        // S2.1.1-S2.1.3: a non-starter is unblocked when every skipped scalar
        // between it and the key has a lower combining class.
        skipped_class := 0
        probe := next_at
        loop probe < scalars.len() && key.len() < 3 {
            class: text_asset.range_tag(ccc, scalars[probe], 0)
            if class == 0 -> break
            if !taken[probe] {
                found: if class > skipped_class -> collation_contraction_row(contractions, key, scalars[probe]) else -> -1
                if found >= 0 {
                    key.push(scalars[probe])
                    taken[probe] = true
                    row = found
                } else {
                    skipped_class = class
                }
            }
            probe += 1
        }
        if row >= 0 {
            first: text_asset.uint(contractions, row + 9, 3)
            count: text_asset.uint(contractions, row + 12, 1)
            collation_push_elements(out, pool, first, count)
        } else {
            collation_single_elements(out, singles, pool, ideographs, scalars[at])
        }
        at = next_at
    }
    out
}

// The byte offset of the contraction row for `key` + `scalar`, or -1.
collation_contraction_row: fn(contractions: View<U8>, key: [Int], scalar: Int) -> Int Never! {
    target: collation_rank(key, scalar)
    low := 0
    high := contractions.len() /% 13
    loop low < high {
        mid: (low + high) /% 2
        row: mid * 13
        rank: collation_row_rank(contractions, row)
        if {
            rank < target -> low = mid + 1
            rank > target -> high = mid
            else -> return row
        }
    }
    -1
}

// Keys order as the generator sorted them: three 21-bit places, the first
// scalar as is and later ones plus one, with zero past the key's end.
collation_rank: fn(key: [Int], scalar: Int) -> Int Never! {
    rank := 0
    used := 0
    loop part in key {
        rank = rank * 2097152 + (if used == 0 -> part else -> part + 1)
        used += 1
    }
    rank = rank * 2097152 + scalar + 1
    used += 1
    loop _pad in used..<3 -> rank *= 2097152
    rank
}

collation_row_rank: fn(contractions: View<U8>, row: Int) -> Int Never! {
    rank := text_asset.uint(contractions, row, 3)
    loop place in 1..<3 {
        scalar: text_asset.uint(contractions, row + place * 3, 3)
        rank = rank * 2097152 + (if scalar == COLLATION_ABSENT -> 0 else -> scalar + 1)
    }
    rank
}

collation_push_elements: fn(out: &[Int], pool: View<U8>, first: Int, count: Int) Never! {
    loop index in first..<first + count {
        at: index * 5
        out.push(text_asset.uint(pool, at, 2))
        out.push(text_asset.uint(pool, at + 2, 2))
        out.push(text_asset.uint(pool, at + 4, 1))
    }
}

// A single scalar's table elements, or its UTS #10 section 10.1.3 implicit
// weights when the table does not list it.
collation_single_elements: fn(out: &[Int], singles: View<U8>, pool: View<U8>, ideographs: View<U8>, scalar: Int) Never! {
    low := 0
    high := singles.len() /% 7
    loop low < high {
        mid: (low + high) /% 2
        row: mid * 7
        found: text_asset.uint(singles, row, 3)
        if {
            found < scalar -> low = mid + 1
            found > scalar -> high = mid
            else -> {
                collation_push_elements(out, pool, text_asset.uint(singles, row + 3, 3), text_asset.uint(singles, row + 6, 1))
                return
            }
        }
    }
    implicit: collation_implicit(ideographs, scalar)
    out.push(implicit.base)
    out.push(32)
    out.push(2)
    out.push(implicit.trail)
    out.push(0)
    out.push(0)
}

// UTS #10 (UCA 17.0.0) section 10.1.3: [.AAAA.0020.0002][.BBBB.0000.0000].
collation_implicit: fn(ideographs: View<U8>, scalar: Int) -> (base: Int, trail: Int) Never! {
    if (scalar >= 94208 && scalar <= 100351) || (scalar >= 101632 && scalar <= 101759) -> return (base: 64256, trail: (scalar - 94208).bit_or(32768))
    if (scalar >= 100352 && scalar <= 101119) || (scalar >= 101760 && scalar <= 101887) -> return (base: 64257, trail: (scalar - 100352).bit_or(32768))
    if scalar >= 110960 && scalar <= 111359 -> return (base: 64258, trail: (scalar - 110960).bit_or(32768))
    if scalar >= 101120 && scalar <= 101631 -> return (base: 64259, trail: (scalar - 101120).bit_or(32768))
    trail: scalar.bit_and(32767).bit_or(32768)
    if !text_asset.contains(ideographs, scalar) -> return (base: 64448 + (scalar >> 15), trail: trail)
    // Core Han: the CJK Unified Ideographs and CJK Compatibility Ideographs blocks.
    core_han: (scalar >= 19968 && scalar <= 40959) || (scalar >= 63744 && scalar <= 64255)
    (base: (if core_han -> 64320 else -> 64384) + (scalar >> 15), trail: trail)
}

#Test("decode_latin1 keeps every byte as the scalar of its number") {
    assert_eq(decode_latin1("!<arch>\n".bytes()), "!<arch>\n")
    nbsp: String.from_bytes([U8]{U8{194}, U8{160}}) ?? ""
    assert_eq(decode_latin1([U8]{U8{65}, U8{233}, U8{160}, U8{255}}), "Aé{nbsp}ÿ")
    assert_eq(decode_latin1([U8]{U8{195}, U8{169}}), "Ã©")
    assert_eq(decode_latin1([U8]{}), "")
}

#Test("leading_int reads parseInt's sign and digits after leading whitespace") {
    assert_eq(leading_int("1234      "), Val(1234))
    assert_eq(leading_int(" \t-42abc"), Val(-42))
    assert_eq(leading_int("+7"), Val(7))
    assert_eq(leading_int("007"), Val(7))
    nbsp: String.from_bytes([U8]{U8{194}, U8{160}}) ?? ""
    assert_eq(leading_int("{nbsp}12"), Val(12))
    assert_eq(leading_int("-99999999999999999999 "), Val(-99999999999999999999))
    assert(leading_int("") == None)
    assert(leading_int("  ") == None)
    assert(leading_int("-") == None)
    assert(leading_int("+-1") == None)
    assert(leading_int("x12") == None)
    assert(leading_int(".5") == None)
}
