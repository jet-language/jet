// Compiler-owned String receiver methods.
//
// This source part is scheduled with `core.text` but is deliberately not a
// public Core module. Receiver-first functions keep the canonical primitive
// `String` identity while giving the standard method surface a Jet-owned body.
// The loader also schedules it for any source that calls one of these methods,
// so every program reaches the same Jet body (I9). It depends only on the
// Unicode runtime kernels, never on the public text modules.
use {
    string_unicode: core.text.runtime.kernel_unicode_string
    string_normal: core.text.runtime.kernel_text_normal
    string_width: core.text.runtime.kernel_text_width
}

// S41: `len` counts Unicode scalars, the items `loop c in s.chars()` visits.
// UTF-8 byte length is `count_bytes()` (or `text.byte_count`).
len: fn(receiver: String) -> Int {
    receiver.chars().len()
}

// Unicode 17 case mapping (jet_unicode_lower/upper,
// jet_text_casefold/title/capitalize/swapcase).
lower: fn(receiver: String) -> String { string_unicode.lower(receiver) }
to_lower: fn(receiver: String) -> String { string_unicode.lower(receiver) }
upper: fn(receiver: String) -> String { string_unicode.upper(receiver) }
to_upper: fn(receiver: String) -> String { string_unicode.upper(receiver) }
casefold: fn(receiver: String) -> String { string_unicode.casefold(receiver) }
title: fn(receiver: String) -> String { string_unicode.title(receiver) }
to_title: fn(receiver: String) -> String { string_unicode.title(receiver) }
capitalize: fn(receiver: String) -> String { string_unicode.capitalize(receiver) }
swapcase: fn(receiver: String) -> String { string_unicode.swapcase(receiver) }
to_ascii_lower: fn(receiver: String) -> String { string_unicode.ascii_lower(receiver) }
to_ascii_upper: fn(receiver: String) -> String { string_unicode.ascii_upper(receiver) }

// Unicode White_Space trimming (Rust jet_unicode_trim*, jet_text_parse_*strip).
trim: fn(receiver: String) -> String { string_unicode.trim(receiver) }
strip: fn(receiver: String) -> String { string_unicode.trim(receiver) }
trim_start: fn(receiver: String) -> String { string_unicode.trim_start(receiver) }
lstrip: fn(receiver: String) -> String { string_unicode.trim_start(receiver) }
trim_end: fn(receiver: String) -> String { string_unicode.trim_end(receiver) }
rstrip: fn(receiver: String) -> String { string_unicode.trim_end(receiver) }

// Scalar predicates over the pinned Unicode 17 properties. Empty text is false
// except for isascii/isprintable.
is_alphabetic: fn(receiver: String) -> Bool { string_unicode.is_alphabetic(receiver) }
isalpha: fn(receiver: String) -> Bool { string_unicode.is_alphabetic(receiver) }
is_numeric: fn(receiver: String) -> Bool { string_unicode.is_numeric(receiver) }
isnumeric: fn(receiver: String) -> Bool { string_unicode.is_numeric(receiver) }
is_whitespace: fn(receiver: String) -> Bool { string_unicode.is_whitespace(receiver) }
isspace: fn(receiver: String) -> Bool { string_unicode.is_whitespace(receiver) }
isalnum: fn(receiver: String) -> Bool { string_unicode.is_alnum(receiver) }
isprintable: fn(receiver: String) -> Bool { string_unicode.isprintable(receiver) }
isidentifier: fn(receiver: String) -> Bool { string_unicode.is_identifier(receiver) }
is_lower: fn(receiver: String) -> Bool { string_unicode.is_lower(receiver) }
islower: fn(receiver: String) -> Bool { string_unicode.is_lower(receiver) }
is_upper: fn(receiver: String) -> Bool { string_unicode.is_upper(receiver) }
isupper: fn(receiver: String) -> Bool { string_unicode.is_upper(receiver) }
istitle: fn(receiver: String) -> Bool { string_unicode.is_title(receiver) }

// Rust jet_text_unicode_is_ascii: every UTF-8 byte is ASCII; empty is true.
is_ascii: fn(receiver: String) -> Bool { ascii_only(receiver) }
isascii: fn(receiver: String) -> Bool { ascii_only(receiver) }
ascii_only: fn(text: String) -> Bool {
    loop b in string_unicode.utf8_bytes(text) {
        if b > (U8{127}) -> return false
    }
    true
}

// Rust jet_text_isdecimal/isdigit: nonempty and every scalar is ASCII 0-9,
// so every UTF-8 byte is one.
isdecimal: fn(receiver: String) -> Bool { ascii_digits(receiver) }
isdigit: fn(receiver: String) -> Bool { ascii_digits(receiver) }
ascii_digits: fn(text: String) -> Bool {
    raw: string_unicode.utf8_bytes(text)
    if raw.len() == 0 -> return false
    loop b in raw {
        if b < (U8{48}) || b > (U8{57}) -> return false
    }
    true
}

// Rust jet_text_parse_find/rfind: UTF-8 byte offset, -1 when absent; an empty
// needle matches at 0 (find) or at the byte length (rfind).
find: fn(receiver: String, needle: String) -> Int {
    byte_find(string_unicode.utf8_bytes(receiver), string_unicode.utf8_bytes(needle), false)
}
rfind: fn(receiver: String, needle: String) -> Int {
    byte_find(string_unicode.utf8_bytes(receiver), string_unicode.utf8_bytes(needle), true)
}
byte_find: fn(raw: [U8], needle: [U8], last: Bool) -> Int {
    if needle.len() > raw.len() -> return -1
    span: raw.len() - needle.len()
    loop k in 0..<(span + 1) {
        at: if last -> span - k else -> k
        if bytes_match_at(raw, at, needle) -> return at
    }
    -1
}
bytes_match_at: fn(raw: [U8], at: Int, needle: [U8]) -> Bool {
    loop j in 0..<needle.len() {
        if raw[at + j] != needle[j] -> return false
    }
    true
}
byte_text: fn(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    loop i in start..<end -> &out.push(raw[i])
    String.from_bytes(out) ?? panic("a split at a matched UTF-8 needle stays on scalar boundaries")
}

// Rust jet_text_parse_partition/rpartition: split around the first/last `sep`;
// absent -> (text, "", "") / ("", "", text).
partition: fn(receiver: String, sep: String) -> (head: String, sep: String, tail: String) {
    raw: string_unicode.utf8_bytes(receiver)
    needle: string_unicode.utf8_bytes(sep)
    at: byte_find(raw, needle, false)
    if at < 0 -> return (head: receiver.copy(), sep: "", tail: "")
    (head: byte_text(raw, 0, at), sep: sep.copy(), tail: byte_text(raw, at + needle.len(), raw.len()))
}
rpartition: fn(receiver: String, sep: String) -> (head: String, sep: String, tail: String) {
    raw: string_unicode.utf8_bytes(receiver)
    needle: string_unicode.utf8_bytes(sep)
    at: byte_find(raw, needle, true)
    if at < 0 -> return (head: "", sep: "", tail: receiver.copy())
    (head: byte_text(raw, 0, at), sep: sep.copy(), tail: byte_text(raw, at + needle.len(), raw.len()))
}

// Rust jet_text_remove_prefix/suffix: byte-exact affix, otherwise unchanged.
removeprefix: fn(receiver: String, prefix: String) -> String { strip_affix(receiver, prefix, true) }
remove_prefix: fn(receiver: String, prefix: String) -> String { strip_affix(receiver, prefix, true) }
removesuffix: fn(receiver: String, suffix: String) -> String { strip_affix(receiver, suffix, false) }
remove_suffix: fn(receiver: String, suffix: String) -> String { strip_affix(receiver, suffix, false) }
strip_affix: fn(text: String, affix: String, front: Bool) -> String {
    raw: string_unicode.utf8_bytes(text)
    cut: string_unicode.utf8_bytes(affix)
    if cut.len() > raw.len() -> return text.copy()
    base: if front -> 0 else -> raw.len() - cut.len()
    loop j in 0..<cut.len() {
        if raw[base + j] != cut[j] -> return text.copy()
    }
    if front -> return byte_text(raw, cut.len(), raw.len())
    byte_text(raw, 0, raw.len() - cut.len())
}

// Rust jet_text_expandtabs: columns count scalars; `\n`/`\r` reset the column;
// a tab pads to the next multiple of tabsize, and tabsize <= 0 drops tabs.
expandtabs: fn(receiver: String, tabsize: Int) -> String {
    raw: string_unicode.utf8_bytes(receiver)
    width: if tabsize < 0 -> 0 else -> tabsize
    out := [U8]{}
    column := 0
    at := 0
    loop at < raw.len() {
        b: raw[at]
        step: string_unicode.utf8_width_at(raw, at)
        if b == (U8{9}) {
            if width > 0 {
                spaces: width - (column %% width)
                loop _ in 0..<spaces -> &out.push(U8{32})
                column = column + spaces
            }
        } else {
            loop i in at..<(at + step) -> &out.push(raw[i])
            if b == (U8{10}) || b == (U8{13}) -> column = 0 else -> column = column + 1
        }
        at = at + step
    }
    String.from_bytes(out) ?? panic("tab expansion keeps whole UTF-8 scalars")
}

// Rust jet_text_normalize_nfc: Unicode 17.0.0 canonical composition (NFC).
normalize: fn(receiver: String) -> String { string_normal.normalize(receiver, false, true) }

// Rust jet_text_pad_start/pad_end/center(_ref): pad to `width` display columns
// (portable-default grapheme widths) with whole first-grapheme units of `fill`;
// a remainder, empty fill or unusable unit pads with spaces.
pad_start: fn(receiver: String, width: Int, fill: String) -> String { string_width.pad(receiver, width, fill, true, false) }
rjust: fn(receiver: String, width: Int, fill: String) -> String { string_width.pad(receiver, width, fill, true, false) }
pad_end: fn(receiver: String, width: Int, fill: String) -> String { string_width.pad(receiver, width, fill, false, true) }
ljust: fn(receiver: String, width: Int, fill: String) -> String { string_width.pad(receiver, width, fill, false, true) }
center: fn(receiver: String, width: Int, fill: String) -> String { string_width.pad(receiver, width, fill, true, true) }

// Rust jet_text_compare: `str::cmp`, i.e. lexicographic UTF-8 byte order.
compare: fn(receiver: String, other: String) -> Int {
    a: string_unicode.utf8_bytes(receiver)
    b: string_unicode.utf8_bytes(other)
    n := a.len()
    if b.len() < n -> n = b.len()
    loop i in 0..<n {
        if a[i] < b[i] -> return -1
        if a[i] > b[i] -> return 1
    }
    if a.len() < b.len() -> return -1
    if a.len() > b.len() -> return 1
    0
}

// Rust jet_text_reverse: `chars().rev()`; whole scalars, never split bytes.
reverse: fn(receiver: String) -> String {
    raw: string_unicode.utf8_bytes(receiver)
    out := [U8]{}
    end := raw.len()
    loop end > 0 {
        start := end - 1
        loop start > 0 && (raw[start].bit_and(U8{192})) == (U8{128}) -> start = start - 1
        loop i in start..<end -> &out.push(raw[i])
        end = start
    }
    String.from_bytes(out) ?? panic("reversed scalars are valid UTF-8")
}

// Rust jet_text_zfill: width counts scalars; a leading `+`/`-` stays in front.
zfill: fn(receiver: String, width: Int) -> String {
    raw: string_unicode.utf8_bytes(receiver)
    length := 0
    loop b in raw {
        if (b.bit_and(U8{192})) != (U8{128}) -> length = length + 1
    }
    if width <= length -> return receiver.copy()
    out := [U8]{}
    body := 0
    if raw.len() > 0 && (raw[0] == (U8{43}) || raw[0] == (U8{45})) {
        &out.push(raw[0])
        body = 1
    }
    loop _ in 0..<(width - length) -> &out.push(U8{48})
    loop i in body..<raw.len() -> &out.push(raw[i])
    String.from_bytes(out) ?? panic("zero-filled text is valid UTF-8")
}
