package: {
    name: "core.perf"
    version: "0.0.1"
    edition: "2026"
    description: "Runtime fidelity signal."
    license: "MIT"
    outputs: {
        perf: .Library{ entry: perf }
    }
}

use core: core

// core.perf — a process-global 0.0..=1.0 fidelity knob for adaptive work.
// Values outside the unit interval are rejected with `PerfError.OutOfRange`.
// The host stores one atomic word; validation, defaults and encoding are Jet.
Perf: struct {
    fidelity: Float,
}

/// The one way to set fidelity wrongly is a number outside
/// 0.0..=1.0 (NaN included); the case carries the rejected number.
#Error
PerfError: enum {
    OutOfRange(Float),
}

fidelity: fn() -[Env]> Float Never! {
    encoded: core.perf.__read_bits()
    if encoded == 0 -> return default_fidelity()
    core.math.from_bits(encoded - 1)
}

default_fidelity: fn() -> Float Never! { 1.0 }

override_fidelity: fn(value: Float) -[Env]> PerfError! {
    if core.math.is_nan(value) || value < 0.0 || value > 1.0 {
        return Err(PerfError.OutOfRange(value))
    }
    // Preserve the existing f32 precision, including a negative zero.
    rounded: Float.from_f32(F32.from_float(value) ?? panic("validated fidelity cannot overflow F32"))
    core.perf.__write_bits(core.math.to_bits(rounded) + 1)
}

reset_fidelity: fn() -[Env]> Never! { core.perf.__write_bits(0) }

/// Under `jet perf run --lens=alloc`, keeps a heap snapshot named `name`:
/// the program's live blocks by the line that allocated them, which
/// `jet perf view` lists. Any other run keeps nothing.
heap_mark: fn(name: String) -[Env]> Never! { core.perf.__heap_mark(name) }

of: fn(fidelity: Float) -> Perf Never! {
    v := fidelity
    if core.math.is_nan(v) -> v = 1.0
    if v < 0.0 -> v = 0.0
    if v > 1.0 -> v = 1.0
    {fidelity: v}
}

is_full: fn(perf: Perf) -> Bool Never! { perf.fidelity >= 1.0 }

is_low: fn(perf: Perf) -> Bool Never! { perf.fidelity < 0.25 }

scale: fn(perf: Perf, work: Int) -> Int Never! {
    n: checked(Int{core.math.trunc((Float{work}) * perf.fidelity)}) ?? panic("scaled work must be finite")
    if n < 0 -> return 0
    n
}

/// A profiling zone: under `jet perf run`, the time from `zone(name)` to
/// the end of the block that holds it is one row of the run's timeline,
/// beside the samples and the closed core.log spans, and `jet perf view`
/// totals each name's zones. Readable but not constructible outside this
/// module.
Zone: struct {
    name: String,
    start: Int,

    impl Close {
        close: fn(&&self) Never! { core.perf.__zone_close(self.name, self.start) }
    }
}

/// Opens a zone named `name` that closes when the block holding it ends:
/// `_z: perf.zone("broadphase")`. Outside `jet perf run` it records
/// nothing.
zone: fn(name: String) -> Zone Never! { Zone{name: name, start: core.perf.__zone_open_named(name)} }

/// Marks the end of one frame on the `jet perf run` timeline; `jet perf
/// view` reports the frames' mean and longest interval.
frame: fn() Never! { core.perf.__frame() }

/// Records `value` on the plot named `name` at this moment of the `jet
/// perf run` timeline.
plot: fn(name: String, value: Float) Never! { core.perf.__plot_float(name, value) }

/// One pass of the progress point `name`: `jet perf run --lens=causal`
/// predicts how much sooner each such pass comes if a line were faster, as
/// it does for each closed zone and each finished task. Outside that lens
/// it records nothing.
progress: fn(name: String) Never! { core.perf.__progress(name) }

/// A marker for the functions to profile: `#Perf.Profiled` on a function or
/// method, or on a package header to reach every function of the package.
/// A program with no `build: fn` that holds a marked function, in its own
/// package or in a dependency, builds with `profile` run on it; a
/// `build: fn` runs it itself, as `perf.profile(b.compiler(app))`. No
/// `authority` row asks for the rewrite: the marker is the consent.
Profiled: struct {
    impl Marker {
        sites: [.Package, .Function, .Method],
    }
}

/// The compile-time handler behind `#Perf.Profiled`, which the build runs
/// on each program that holds a marked function. Each checked function the
/// marker reaches gets a zone named after it around its body, so under
/// `jet perf run` each call is one zone row; an unmarked function stays as
/// written. The new body reads the zone through `jet_profiled_zone`, the
/// import the build adds to the rewritten function's module, so a function
/// whose file never imports core.perf (one a package header marks) is
/// profiled the same way.
profile: fn(meta: Compiler) {
    meta.events(
        watch: .Functions{marked: Profiled{}},
        fn(event) {
            if event == .Checked(.Function(f)) {
                name: f.name
                meta.rewrite_body(
                    f,
                    #code {
                        _zone: jet_profiled_zone.zone(#{name})
                        #{f.body}
                    },
                )
            }
        },
    )
}

#Test("perf fidelity round-trips through overrides") {
    reset_fidelity()
    assert(fidelity() == 1.0)
    override_fidelity(0.1) ?? panic("valid fidelity")
    expected: Float.from_f32(F32.from_float(0.1) ?? panic("valid F32"))
    assert(fidelity() == expected)
    override_fidelity(-0.0) ?? panic("valid negative zero")
    assert(core.math.to_bits(fidelity()) == core.math.to_bits(-0.0))
    reset_fidelity()
    assert(fidelity() == default_fidelity())
}

#Test("perf fidelity rejection keeps state") {
    override_fidelity(0.5) ?? panic("valid fidelity")
    rejected: if override_fidelity(core.math.NAN) == {
        .Ok(_) -> false
        .Err(_) -> true
    }
    unchanged: fidelity() == 0.5
    reset_fidelity()
    assert(rejected && unchanged)
}
