package {
    name: "core.sync"
    version: "0.0.1"
    edition: "2026"
    description: "CRDT counters, maps, lists, and text."
    license: "MIT"
    outputs: { sync: .Library{ entry: sync } }
}

// D-SYNC1=A / D-DBPOLICY1=A: identities survive merges and policy authority
// binds a row owner to a user, rather than an unrelated list of actions.
use core.text as text

MAX_TEXT :: 1048576
MAX_ATOMS :: 4194304
MAX_REPLICAS :: 4096
MAX_ENTRIES :: 100000
MAX_CLOCK :: 18446744073709551615
MIN_VALUE :: -9223372036854775808
MAX_VALUE :: 9223372036854775807

pub struct SyncTextAtom {
    pub replica: String
    pub counter: Int
    pub after: String
    pub scalar: String
    pub deleted: Bool
}

pub struct SyncText {
    pub atoms: [SyncTextAtom]
    pub valid: Bool
}

pub struct CounterCount {
    pub positive: Int
    pub negative: Int
}

pub struct SyncCounter {
    pub counts: [String:CounterCount]
    pub valid: Bool
}

pub struct LWW {
    pub value: String
    pub ts: Int
    pub replica: String
    pub deleted: Bool
}

pub struct SyncMap {
    pub replica: String
    pub clock: Int
    pub entries: [String:LWW]
    pub valid: Bool
}

pub struct RGAItem {
    pub replica: String
    pub value: String
}

pub struct SyncList {
    pub items: [RGAItem]
    pub valid: Bool
}

pub enum RowPolicyExpr {
    AllowAll
    OwnerEqualsUser
}

pub struct RowPolicy {
    pub table: String
    pub expression: RowPolicyExpr
}

fn valid_token(value: String) -> Bool Never! {
    value.trim() != "" && value.bytes().len() <= MAX_TEXT && !text.has_control(value)
}

fn atom_id(replica: String, counter: Int) -> String Never! {
    "{replica.bytes().len()}:{replica}:{counter}"
}

fn invalid_text() -> SyncText Never! { SyncText{atoms: [SyncTextAtom]{}, valid: false} }
fn invalid_counter() -> SyncCounter Never! { SyncCounter{counts: [String:CounterCount]{}, valid: false} }
fn invalid_map() -> SyncMap Never! { SyncMap{replica: "", clock: 0, entries: [String:LWW]{}, valid: false} }
fn invalid_list() -> SyncList Never! { SyncList{items: [RGAItem]{}, valid: false} }

// RGA traversal groups siblings by their anchor. Later Lamport writes precede
// older siblings, with replica names breaking a concurrent-clock tie.
fn text_order(doc: SyncText) -> [Int] Never! {
    children := [String:[Int]]{}
    loop (index, atom) in doc.atoms {
        siblings := children.get(atom.after) ?? [Int]{}
        &siblings.push(index)
        _ :: &children.add(atom.after, siblings)
    }
    loop anchor in children.keys() {
        siblings := children.get(anchor) ?? [Int]{}
        &siblings.sort_by((left: Int, right: Int) -> {
            a :: doc.atoms[left]
            b :: doc.atoms[right]
            if a.counter == b.counter -> b.replica <=> a.replica else -> b.counter <=> a.counter
        })
        _ :: &children.add(anchor, siblings)
    }
    pending := children.get("") ?? [Int]{}
    &pending.reverse()
    order := [Int]{}
    seen := [Int:Bool]{}
    loop pending.len() > 0 {
        index :: &pending.pop() ?? break
        if seen.get(index) != None -> break
        _ :: &seen.add(index, true)
        &order.push(index)
        atom :: doc.atoms[index]
        siblings := children.get(atom_id(atom.replica, atom.counter)) ?? [Int]{}
        &siblings.reverse()
        loop child in siblings -> &pending.push(child)
    }
    order
}

fn text_visible(doc: SyncText) -> [Int] Never! {
    visible := [Int]{}
    loop index in text_order(doc) {
        if !doc.atoms[index].deleted -> &visible.push(index)
    }
    visible
}

fn text_clock(doc: SyncText) -> Int Never! {
    clock := 0
    loop atom in doc.atoms {
        if atom.counter > clock -> clock = atom.counter
    }
    clock
}

fn insert_after(doc: &SyncText, replica: String, anchor: String, inserted: [String]) Never! {
    after := anchor
    clock := text_clock(doc)
    loop scalar in inserted {
        clock += 1
        &doc.atoms.push(SyncTextAtom{replica: replica, counter: clock, after: after, scalar: scalar, deleted: false})
        after = atom_id(replica, clock)
    }
}

pub fn text_new(replica: String, value: String) -> SyncText Never! {
    if !valid_token(replica) || value.bytes().len() > MAX_TEXT -> return invalid_text()
    doc := SyncText{atoms: [SyncTextAtom]{}, valid: true}
    insert_after(&doc, replica, "", text.scalars(value))
    doc
}

pub fn text_set(doc: SyncText, replica: String, value: String) -> SyncText Never! {
    inserted :: text.scalars(value)
    if !doc.valid || !valid_token(replica) || value.bytes().len() > MAX_TEXT
        || doc.atoms.len() + inserted.len() > MAX_ATOMS
        || text_clock(doc) + 1 + inserted.len() > MAX_CLOCK -> return ~doc
    updated := doc
    loop index in text_visible(updated) -> updated.atoms[index].deleted = true
    insert_after(&updated, replica, "", inserted)
    updated
}

pub fn text_edit(doc: SyncText, replica: String, index: Int, delete_count: Int, value: String) -> SyncText Never! {
    inserted :: text.scalars(value)
    if !doc.valid || !valid_token(replica) || index < 0 || delete_count < 0
        || value.bytes().len() > MAX_TEXT || doc.atoms.len() + inserted.len() > MAX_ATOMS
        || text_clock(doc) + 1 + inserted.len() > MAX_CLOCK -> return ~doc
    visible :: text_visible(doc)
    if index > visible.len() || delete_count > visible.len() - index -> return ~doc
    anchor := ""
    if index > 0 {
        atom :: doc.atoms[visible[index - 1]]
        anchor = atom_id(atom.replica, atom.counter)
    }
    updated := doc
    loop offset in 0..<delete_count -> updated.atoms[visible[index + offset]].deleted = true
    insert_after(&updated, replica, anchor, inserted)
    updated
}

pub fn text_merge(left: SyncText, right: SyncText) -> SyncText Never! {
    if !left.valid || !right.valid -> return invalid_text()
    merged := [String:SyncTextAtom]{}
    loop atoms in [left.atoms, right.atoms] {
        loop atom in atoms {
            if !valid_token(atom.replica) || atom.counter <= 0 || atom.counter > MAX_CLOCK
                || text.scalars(atom.scalar).len() != 1 -> return invalid_text()
            id :: atom_id(atom.replica, atom.counter)
            previous :: merged.get(id)
            if previous == .Val(existing) {
                if existing.scalar != atom.scalar || existing.after != atom.after -> return invalid_text()
                updated := existing
                updated.deleted = existing.deleted || atom.deleted
                _ :: &merged.add(id, updated)
            } else -> _ :: &merged.add(id, atom)
        }
    }
    if merged.len() > MAX_ATOMS -> return invalid_text()
    atoms := [SyncTextAtom]{}
    ids := merged.keys().to_list()
    &ids.sort()
    loop id in ids -> &atoms.push(merged.get(id) ?? return invalid_text())
    doc :: SyncText{atoms: atoms, valid: true}
    if text_order(doc).len() != doc.atoms.len() -> return invalid_text()
    doc
}

pub fn text_show(doc: SyncText) -> String Never! {
    if !doc.valid -> return "SyncError(invalid SyncText)"
    parts := [String]{}
    loop index in text_visible(doc) -> &parts.push(doc.atoms[index].scalar)
    "SyncText({parts.join("")})"
}

pub fn text_metadata(doc: SyncText) -> String Never! {
    if !doc.valid -> return "SyncError(invalid SyncText)"
    clocks := [String:Int]{}
    loop atom in doc.atoms {
        previous :: clocks.get(atom.replica) ?? 0
        if atom.counter > previous -> _ :: &clocks.add(atom.replica, atom.counter)
    }
    replicas := clocks.keys().to_list()
    &replicas.sort()
    parts := [String]{}
    loop replica in replicas -> &parts.push("{replica}={clocks.get(replica) ?? 0}")
    "LamportClock({parts.join(",")})"
}

pub fn counter_new(replica: String, value: Int) -> SyncCounter Never! {
    if !valid_token(replica) || value < MIN_VALUE || value > MAX_VALUE -> return invalid_counter()
    counts := [String:CounterCount]{}
    _ :: &counts.add(replica, CounterCount{positive: if value >= 0 -> value else -> 0, negative: if value < 0 -> -value else -> 0})
    SyncCounter{counts: counts, valid: true}
}

pub fn counter_inc(counter: SyncCounter, replica: String, delta: Int) -> SyncCounter Never! {
    if !counter.valid || !valid_token(replica) -> return ~counter
    if delta < MIN_VALUE || delta > MAX_VALUE -> return invalid_counter()
    updated := counter
    count := updated.counts.get(replica) ?? CounterCount{positive: 0, negative: 0}
    if delta >= 0 -> count.positive += delta else -> count.negative -= delta
    if count.positive > MAX_CLOCK || count.negative > MAX_CLOCK -> return invalid_counter()
    _ :: &updated.counts.add(replica, count)
    if updated.counts.len() > MAX_REPLICAS || !counter_total_valid(updated) -> return invalid_counter()
    updated
}

fn counter_total(counter: SyncCounter) -> Int Never! {
    total := 0
    loop replica in counter.counts.keys() {
        count :: counter.counts.get(replica) ?? CounterCount{positive: 0, negative: 0}
        total += count.positive - count.negative
    }
    total
}

fn counter_total_valid(counter: SyncCounter) -> Bool Never! {
    total :: counter_total(counter)
    total >= MIN_VALUE && total <= MAX_VALUE
}

pub fn counter_merge(left: SyncCounter, right: SyncCounter) -> SyncCounter Never! {
    if !left.valid || !right.valid -> return invalid_counter()
    counts := [String:CounterCount]{}
    loop source in [left.counts, right.counts] {
        loop replica in source.keys() {
            if !valid_token(replica) -> return invalid_counter()
            incoming :: source.get(replica) ?? return invalid_counter()
            count := counts.get(replica) ?? CounterCount{positive: 0, negative: 0}
            if incoming.positive < 0 || incoming.negative < 0 || incoming.positive > MAX_CLOCK || incoming.negative > MAX_CLOCK -> return invalid_counter()
            if incoming.positive > count.positive -> count.positive = incoming.positive
            if incoming.negative > count.negative -> count.negative = incoming.negative
            _ :: &counts.add(replica, count)
        }
    }
    merged :: SyncCounter{counts: counts, valid: true}
    if merged.counts.len() > MAX_REPLICAS || !counter_total_valid(merged) -> return invalid_counter()
    merged
}

pub fn counter_value(counter: SyncCounter) -> Int Never! {
    if !counter.valid -> return 0
    counter_total(counter)
}

pub fn map_new() -> SyncMap Never! { SyncMap{replica: "local", clock: 0, entries: [String:LWW]{}, valid: true} }

pub fn map_set(map: SyncMap, key: String, value: String) -> SyncMap Never! {
    if !map.valid || !valid_token(map.replica) || !valid_token(key) || value.bytes().len() > MAX_TEXT -> return ~map
    if map.clock >= MAX_CLOCK -> return invalid_map()
    entries := map.entries
    _ :: &entries.add(key, LWW{value: value, ts: map.clock + 1, replica: map.replica, deleted: false})
    if entries.len() > MAX_ENTRIES -> return invalid_map()
    SyncMap{replica: map.replica, clock: map.clock + 1, entries: entries, valid: true}
}

pub fn map_get(map: SyncMap, key: String) -> String? Never! {
    if !map.valid -> return None
    entry :: map.entries.get(key) ?? return None
    if entry.deleted -> return None
    Val(entry.value)
}

pub fn map_merge(left: SyncMap, right: SyncMap) -> SyncMap Never! {
    if !left.valid || !right.valid -> return invalid_map()
    entries := [String:LWW]{}
    clock := 0
    loop source in [left.entries, right.entries] {
        loop key in source.keys() {
            incoming :: source.get(key) ?? return invalid_map()
            if !valid_token(key) || !valid_token(incoming.replica) || incoming.ts <= 0
                || incoming.ts > MAX_CLOCK || incoming.value.bytes().len() > MAX_TEXT -> return invalid_map()
            if incoming.ts > clock -> clock = incoming.ts
            previous :: entries.get(key)
            replace := true
            if previous == .Val(existing) {
                replace = incoming.ts > existing.ts || (incoming.ts == existing.ts
                    && (incoming.replica > existing.replica || (incoming.replica == existing.replica && incoming.value > existing.value)))
            }
            if replace -> _ :: &entries.add(key, incoming)
        }
    }
    if entries.len() > MAX_ENTRIES -> return invalid_map()
    SyncMap{replica: left.replica, clock: clock, entries: entries, valid: true}
}

fn escape_display(value: String) -> String Never! {
    parts := [String]{}
    loop scalar in text.scalars(value) {
        if scalar == "\\" || scalar == "," || scalar == "=" || scalar == "|" || scalar == ":" || scalar == "/" -> &parts.push("\\")
        &parts.push(scalar)
    }
    parts.join("")
}

pub fn map_show(map: SyncMap) -> String Never! {
    if !map.valid -> return "SyncError(invalid SyncMap)"
    keys := map.entries.keys().to_list()
    &keys.sort()
    parts := [String]{}
    loop key in keys {
        entry :: map.entries.get(key) ?? next
        if !entry.deleted -> &parts.push("{escape_display(key)}={escape_display(entry.value)}")
    }
    "SyncMap({parts.join(",")})"
}

pub fn list_new() -> SyncList Never! { SyncList{items: [RGAItem]{}, valid: true} }

pub fn list_push(list: SyncList, replica: String, value: String) -> SyncList Never! {
    if !list.valid || !valid_token(replica) || value.bytes().len() > MAX_TEXT -> return ~list
    loop item in list.items {
        if item.replica == replica && item.value == value -> return ~list
    }
    if list.items.len() >= MAX_ENTRIES -> return invalid_list()
    updated := list
    &updated.items.push(RGAItem{replica: replica, value: value})
    &updated.items.sort_by((left: RGAItem, right: RGAItem) -> if left.replica == right.replica -> left.value <=> right.value else -> left.replica <=> right.replica)
    updated
}

pub fn list_merge(left: SyncList, right: SyncList) -> SyncList Never! {
    if !left.valid || !right.valid -> return invalid_list()
    merged := left
    loop item in right.items {
        if !valid_token(item.replica) || item.value.bytes().len() > MAX_TEXT -> return invalid_list()
        merged = list_push(merged, item.replica, item.value)
    }
    loop item in merged.items {
        if !valid_token(item.replica) || item.value.bytes().len() > MAX_TEXT -> return invalid_list()
    }
    merged
}

pub fn list_show(list: SyncList) -> String Never! {
    if !list.valid -> return "SyncError(invalid SyncList)"
    parts := [String]{}
    loop item in list.items -> &parts.push("{escape_display(item.replica)}:{escape_display(item.value)}")
    "SyncList({parts.join("|")})"
}

pub fn policy_new(table: String, expression: String) -> RowPolicy String! {
    name :: table.trim()
    value :: expression.trim()
    if !valid_token(name) || !valid_token(value) -> return Err("row policy needs a table and expression")
    index := 0
    loop byte in name.bytes() {
        n :: Int.from_u8(byte)
        letter :: (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 95
        if !letter && (index == 0 || n < 48 || n > 57) -> return Err("row policy table must be a simple identifier")
        index += 1
    }
    if value == "true" -> return Ok(RowPolicy{table: name, expression: RowPolicyExpr.AllowAll})
    if value == "owner == user" -> return Ok(RowPolicy{table: name, expression: RowPolicyExpr.OwnerEqualsUser})
    Err("unsupported row policy expression `{value}`; supported forms are `true` and `owner == user`")
}

pub fn policy_allows(policy: RowPolicy, user: String, row_owner: String) -> Bool Never! {
    if !valid_token(user) || !valid_token(row_owner) -> return false
    if policy.expression == {
        .AllowAll -> true
        .OwnerEqualsUser -> user == row_owner
    }
}

pub fn policy_show(policy: RowPolicy) -> String Never! {
    expression :: if policy.expression == {
        .AllowAll -> "true"
        .OwnerEqualsUser -> "owner == user"
    }
    "RowPolicy(table={policy.table}, expr={expression})"
}
