package {
    name: "core.sync"
    version: "0.0.1"
    edition: "2026"
    description: "CRDT counters, maps, lists, and text."
    license: "MIT"
    outputs: {
        sync: .Library{ entry: sync }
    }
}
// core.sync — D-SYNC1=A replica-aware CRDT value types. Every write names the
// replica that made it, so replicas that edit apart merge to one value in
// either order and neither loses its work. A carrier that breaks a bound or
// carries a malformed identity becomes invalid: it shows as `SyncError(...)`,
// reads as empty, and every merge with it stays invalid rather than silently
// truncating. Database row policies are not here: they live in core.db
// (D-DBPOLICY-CHECK1=A); the RowPolicy below is the closed allow/deny action
// list.
use core.text as unicode

MAX_TEXT :: 1048576
MAX_ATOMS :: 4194304
MAX_REPLICAS :: 4096
MAX_ENTRIES :: 100000
MAX_INT :: 9223372036854775807

// One character of a SyncText. `(replica, counter)` is its identity; `after`
// is the identity of the character it was inserted after ("" = document
// start). A deleted character stays as a tombstone so later merges agree.
struct SyncTextAtom {
    replica: String
    counter: Int
    after: String
    scalar: String
    deleted: Bool
}

struct SyncText {
    atoms: [SyncTextAtom]
    valid: Bool
}

struct CounterCount {
    positive: Int
    negative: Int
}

struct SyncCounter {
    counts: [String:CounterCount]
    valid: Bool
}

// One register of a SyncMap. A deleted entry stays as a tombstone so a merge
// with a replica that still holds the old value cannot bring it back.
struct LWW {
    value: String
    clock: Int
    writer: String
    deleted: Bool
}

struct SyncMap {
    entries: [String:LWW]
    valid: Bool
}

struct RGAItem {
    replica: String
    value: String
}

struct SyncList {
    items: [RGAItem]
    valid: Bool
}

struct RowPolicy {
    allow: [String]
    deny: [String]
}

// ---- SyncText: an RGA sequence of single-scalar atoms --------------------

fn text_new(replica: String, value: String) -> SyncText Never! {
    doc :: SyncText{atoms: [SyncTextAtom]{}, valid: true}
    if !valid_token(replica) || value.len() > MAX_TEXT -> return invalid_text()
    inserted :: unicode.scalars(value)
    if inserted.len() > MAX_ATOMS -> return invalid_text()
    insert_after(doc, replica, "", inserted)
}

// Replace the whole document: every visible character becomes a tombstone and
// the new text is written at the start, so a replica that never saw the
// tombstones still converges after a merge.
fn text_set(doc: SyncText, replica: String, value: String) -> SyncText Never! {
    if !doc.valid || !valid_token(replica) || value.len() > MAX_TEXT -> return doc.copy()
    inserted :: unicode.scalars(value)
    if doc.atoms.len() + inserted.len() > MAX_ATOMS || clock_exhausted(doc, inserted.len()) -> return doc.copy()
    deleted :: mark_deleted(doc, text_visible(doc))
    insert_after(deleted, replica, "", inserted)
}

// One edit at a visible position: delete `delete_count` characters starting
// at `index` (Unicode scalar positions), then insert `value` there. The insert
// anchors to the character before the edited range, so it survives a
// concurrent edit of that range.
fn text_edit(doc: SyncText, replica: String, index: Int, delete_count: Int, value: String) -> SyncText Never! {
    if !doc.valid || !valid_token(replica) || index < 0 || delete_count < 0 || value.len() > MAX_TEXT -> return doc.copy()
    inserted :: unicode.scalars(value)
    if doc.atoms.len() + inserted.len() > MAX_ATOMS || clock_exhausted(doc, inserted.len()) -> return doc.copy()
    visible :: text_visible(doc)
    if index > visible.len() || delete_count > visible.len() - index -> return doc.copy()
    anchor := ""
    if index > 0 {
        before :: doc.atoms[visible[index - 1]]
        anchor = atom_id(before.replica, before.counter)
    }
    removed := [Int]{}
    loop offset in 0..<delete_count -> &removed.push(visible[index + offset])
    deleted :: mark_deleted(doc, removed)
    insert_after(deleted, replica, anchor, inserted)
}

// Union of both atom sets. Nothing is dropped; a deletion seen by either side
// stays. One identity with two readings (a replica name reused by two
// writers) or an atom whose anchor is missing makes the merge invalid.
fn text_merge(left: SyncText, right: SyncText) -> SyncText Never! {
    if !left.valid || !right.valid -> return invalid_text()
    merged := [String:SyncTextAtom]{}
    sides :: [[SyncTextAtom]]{left.atoms, right.atoms}
    loop side in sides {
        loop atom in side {
            if !valid_token(atom.replica) || atom.counter <= 0 || unicode.scalars(atom.scalar).len() != 1 -> return invalid_text()
            id :: atom_id(atom.replica, atom.counter)
            previous :: merged.get(id)
            if previous == .None {
                _ :: &merged.add(id, atom)
            } else {
                existing :: previous
                if existing.scalar != atom.scalar || existing.after != atom.after -> return invalid_text()
                if atom.deleted && !existing.deleted -> _ :: &merged.add(id, atom)
            }
        }
    }
    if merged.len() > MAX_ATOMS -> return invalid_text()
    atoms := [SyncTextAtom]{}
    loop id in merged.keys() {
        atom :: merged.get(id) ?? next
        &atoms.push(atom)
    }
    doc :: SyncText{atoms: atoms, valid: true}
    if text_order(doc).len() != doc.atoms.len() -> return invalid_text()
    doc
}

fn text_show(doc: SyncText) -> String Never! {
    if !doc.valid -> return "SyncError(invalid SyncText)"
    out := ""
    loop index in text_visible(doc) -> out = "{out}{doc.atoms[index].scalar}"
    "SyncText({out})"
}

// The highest counter each replica has written. This is a Lamport clock, not
// a vector clock: it orders writes but cannot decide causality.
fn text_metadata(doc: SyncText) -> String Never! {
    if !doc.valid -> return "SyncError(invalid SyncText)"
    clocks := [String:Int]{}
    loop atom in doc.atoms {
        seen :: clocks.get(atom.replica) ?? 0
        if atom.counter > seen -> _ :: &clocks.add(atom.replica, atom.counter)
    }
    replicas := [String]{}
    loop replica in clocks.keys() -> &replicas.push(replica)
    &replicas.sort()
    out := ""
    loop replica in replicas {
        if out != "" -> out = "{out},"
        out = "{out}{replica}={clocks.get(replica) ?? 0}"
    }
    "LamportClock({out})"
}

// ---- SyncCounter: per-replica positive/negative maxima (PN-counter) -------

fn counter_new(replica: String, value: Int) -> SyncCounter Never! {
    if !valid_token(replica) -> return invalid_counter()
    counter :: SyncCounter{counts: [String:CounterCount]{}, valid: true}
    counter_inc(counter, replica, value)
}

fn counter_inc(counter: SyncCounter, replica: String, delta: Int) -> SyncCounter Never! {
    if !counter.valid || !valid_token(replica) -> return counter.copy()
    count := counter.counts.get(replica) ?? CounterCount{positive: 0, negative: 0}
    if counter.counts.get(replica) == .None && counter.counts.len() >= MAX_REPLICAS -> return invalid_counter()
    if delta >= 0 {
        if count.positive > MAX_INT - delta -> return invalid_counter()
        count.positive = count.positive + delta
    } else {
        // `delta` is negative, so `MAX_INT + delta` cannot overflow.
        if count.negative > MAX_INT + delta -> return invalid_counter()
        count.negative = count.negative - delta
    }
    counts := counter.counts
    _ :: &counts.add(replica, count)
    updated :: SyncCounter{counts: counts, valid: true}
    if counter_total(updated) == .None -> return invalid_counter()
    updated
}

fn counter_merge(left: SyncCounter, right: SyncCounter) -> SyncCounter Never! {
    if !left.valid || !right.valid -> return invalid_counter()
    counts := [String:CounterCount]{}
    sides :: [[String:CounterCount]]{left.counts, right.counts}
    loop side in sides {
        loop replica in side.keys() {
            incoming :: side.get(replica) ?? return invalid_counter()
            if !valid_token(replica) || incoming.positive < 0 || incoming.negative < 0 -> return invalid_counter()
            count := counts.get(replica) ?? CounterCount{positive: 0, negative: 0}
            if incoming.positive > count.positive -> count.positive = incoming.positive
            if incoming.negative > count.negative -> count.negative = incoming.negative
            _ :: &counts.add(replica, count)
        }
    }
    if counts.len() > MAX_REPLICAS -> return invalid_counter()
    merged :: SyncCounter{counts: counts, valid: true}
    if counter_total(merged) == .None -> return invalid_counter()
    merged
}

fn counter_value(counter: SyncCounter) -> Int Never! {
    if !counter.valid -> return 0
    counter_total(counter) ?? 0
}

// ---- SyncMap: last-writer-wins registers under a map-wide Lamport clock ---

fn map_new() -> SyncMap Never! { SyncMap{entries: [String:LWW]{}, valid: true} }

// A write takes the next clock past every entry the map has observed, so a
// write after a remote observation never loses to that older value.
fn map_set(map: SyncMap, key: String, value: String) -> SyncMap Never! {
    if !map.valid || !valid_token(key) || value.len() > MAX_TEXT -> return map.copy()
    write_entry(map, key, LWW{value: value, clock: 0, writer: "local", deleted: false})
}

// Delete by writing a tombstone at the next clock.
fn map_delete(map: SyncMap, key: String) -> SyncMap Never! {
    if !map.valid || !valid_token(key) -> return map.copy()
    write_entry(map, key, LWW{value: "", clock: 0, writer: "local", deleted: true})
}

// An invalid map answers nothing, like its show; a deleted key is absent.
fn map_get(map: SyncMap, key: String) -> String? Never! {
    if !map.valid -> return None
    entry :: map.entries.get(key) ?? return None
    if entry.deleted -> return None
    Val(entry.value)
}

// Per key the larger clock wins. Equal clocks order by writer; one writer's
// fork lets a deletion win, then orders by value.
fn map_merge(left: SyncMap, right: SyncMap) -> SyncMap Never! {
    if !left.valid || !right.valid -> return invalid_map()
    entries := [String:LWW]{}
    sides :: [[String:LWW]]{left.entries, right.entries}
    loop side in sides {
        loop key in side.keys() {
            incoming :: side.get(key) ?? return invalid_map()
            if !valid_token(key) || !valid_token(incoming.writer) || incoming.clock <= 0 || incoming.value.len() > MAX_TEXT -> return invalid_map()
            previous :: entries.get(key)
            replace := true
            if previous != .None {
                existing :: previous
                replace = incoming.clock > existing.clock
                if incoming.clock == existing.clock {
                    replace = incoming.writer > existing.writer
                    if incoming.writer == existing.writer {
                        replace = incoming.value > existing.value
                        if incoming.deleted != existing.deleted -> replace = incoming.deleted
                    }
                }
            }
            if replace -> _ :: &entries.add(key, incoming)
        }
    }
    if entries.len() > MAX_ENTRIES -> return invalid_map()
    SyncMap{entries: entries, valid: true}
}

fn map_show(map: SyncMap) -> String Never! {
    if !map.valid -> return "SyncError(invalid SyncMap)"
    keys := [String]{}
    loop key in map.entries.keys() -> &keys.push(key)
    &keys.sort()
    out := ""
    loop key in keys {
        entry :: map.entries.get(key) ?? next
        if entry.deleted -> next
        if out != "" -> out = "{out},"
        out = "{out}{escape_display(key)}={escape_display(entry.value)}"
    }
    "SyncMap({out})"
}

// ---- SyncList: an add-wins set of (replica, value) items in one order -----

fn list_new() -> SyncList Never! { SyncList{items: [RGAItem]{}, valid: true} }

fn list_push(list: SyncList, replica: String, value: String) -> SyncList Never! {
    if !list.valid || !valid_token(replica) || value.len() > MAX_TEXT -> return list.copy()
    loop item in list.items {
        if item.replica == replica && item.value == value -> return list.copy()
    }
    if list.items.len() >= MAX_ENTRIES -> return invalid_list()
    SyncList{items: insert_item(list.items, RGAItem{replica: replica, value: value}), valid: true}
}

fn list_merge(left: SyncList, right: SyncList) -> SyncList Never! {
    if !left.valid || !right.valid -> return invalid_list()
    items := [RGAItem]{}
    sides :: [[RGAItem]]{left.items, right.items}
    loop side in sides {
        loop item in side {
            if !valid_token(item.replica) || item.value.len() > MAX_TEXT -> return invalid_list()
            present := false
            loop seen in items {
                if seen.replica == item.replica && seen.value == item.value -> present = true
            }
            if !present -> items = insert_item(items, item)
        }
    }
    if items.len() > MAX_ENTRIES -> return invalid_list()
    SyncList{items: items, valid: true}
}

fn list_show(list: SyncList) -> String Never! {
    if !list.valid -> return "SyncError(invalid SyncList)"
    out := ""
    loop item in list.items {
        if out != "" -> out = "{out}|"
        out = "{out}{escape_display(item.replica)}:{escape_display(item.value)}"
    }
    "SyncList({out})"
}

// ---- RowPolicy: closed allow/deny action list ------------------------------

fn policy_new() -> RowPolicy Never! { RowPolicy{allow: [String]{}, deny: [String]{}} }

fn policy_grant(policy: RowPolicy, action: String) -> RowPolicy Never! {
    if action.len() == 0 || contains(policy.allow, action) -> return policy.copy()
    allow := policy.allow.copy()
    &allow.push(action)
    RowPolicy{allow: allow, deny: policy.deny.copy()}
}

fn policy_deny(policy: RowPolicy, action: String) -> RowPolicy Never! {
    if action.len() == 0 || contains(policy.deny, action) -> return policy.copy()
    deny := policy.deny.copy()
    &deny.push(action)
    RowPolicy{allow: policy.allow.copy(), deny: deny}
}

fn policy_revoke(policy: RowPolicy, action: String) -> RowPolicy Never! {
    allow := [String]{}
    loop item in policy.allow.copy() {
        if item != action -> &allow.push(item)
    }
    deny := [String]{}
    loop item in policy.deny.copy() {
        if item != action -> &deny.push(item)
    }
    RowPolicy{allow: allow, deny: deny}
}

fn policy_allows(policy: RowPolicy, action: String) -> Bool Never! {
    loop d in policy.deny {
        if d == action || d == "*" -> return false
    }
    if policy.allow.len() == 0 -> return true
    loop a in policy.allow {
        if a == action || a == "*" -> return true
    }
    false
}

fn policy_show(policy: RowPolicy) -> String Never! {
    "allow={policy.allow.len()} deny={policy.deny.len()}"
}

// ---- helpers ----------------------------------------------------------------

// A replica name, key, or writer: not blank, bounded, and free of control
// characters.
fn valid_token(value: String) -> Bool Never! {
    value.trim() != "" && value.len() <= MAX_TEXT && !unicode.has_control(value)
}

fn atom_id(replica: String, counter: Int) -> String Never! {
    "{replica.len()}:{replica}:{counter}"
}

fn invalid_text() -> SyncText Never! { SyncText{atoms: [SyncTextAtom]{}, valid: false} }

fn invalid_counter() -> SyncCounter Never! { SyncCounter{counts: [String:CounterCount]{}, valid: false} }

fn invalid_map() -> SyncMap Never! { SyncMap{entries: [String:LWW]{}, valid: false} }

// Store `entry` under `key` at the next clock past every entry observed.
fn write_entry(map: SyncMap, key: String, entry: LWW) -> SyncMap Never! {
    clock := 0
    loop name in map.entries.keys() {
        seen :: map.entries.get(name) ?? next
        if seen.clock > clock -> clock = seen.clock
    }
    if clock >= MAX_INT -> return invalid_map()
    if map.entries.get(key) == .None && map.entries.len() >= MAX_ENTRIES -> return invalid_map()
    entries := map.entries
    _ :: &entries.add(key, LWW{value: entry.value, clock: clock + 1, writer: entry.writer, deleted: entry.deleted})
    SyncMap{entries: entries, valid: true}
}

fn invalid_list() -> SyncList Never! { SyncList{items: [RGAItem]{}, valid: false} }

// Reading order. Atoms sharing an anchor are ordered by descending counter,
// then descending replica, so concurrent inserts at one point land in the same
// order on every replica. An atom whose anchor is absent is unreachable and
// stays out of the order instead of moving to the start.
fn text_order(doc: SyncText) -> [Int] Never! {
    children := [String:[Int]]{}
    loop index in 0..<doc.atoms.len() {
        anchor :: doc.atoms[index].after
        siblings := children.get(anchor) ?? [Int]{}
        &siblings.push(index)
        _ :: &children.add(anchor, siblings)
    }
    order := [Int]{}
    stack := reversed_children(doc, children, "")
    loop stack.len() > 0 {
        index :: &stack.pop() ?? break
        &order.push(index)
        atom :: doc.atoms[index]
        loop child in reversed_children(doc, children, atom_id(atom.replica, atom.counter)) -> &stack.push(child)
    }
    order
}

// The children of `anchor` in reverse reading order, ready to push on a stack.
fn reversed_children(doc: SyncText, children: [String:[Int]], anchor: String) -> [Int] Never! {
    siblings :: children.get(anchor) ?? [Int]{}
    sorted := [Int]{}
    loop index in siblings {
        position := 0
        loop position < sorted.len() && reads_before(doc, sorted[position], index) -> position += 1
        &sorted.push(index)
        moved := sorted.len() - 1
        loop moved > position {
            sorted[moved] = sorted[moved - 1]
            moved -= 1
        }
        sorted[position] = index
    }
    reversed := [Int]{}
    cursor := sorted.len()
    loop cursor > 0 {
        cursor -= 1
        &reversed.push(sorted[cursor])
    }
    reversed
}

fn reads_before(doc: SyncText, left: Int, right: Int) -> Bool Never! {
    a :: doc.atoms[left]
    b :: doc.atoms[right]
    if a.counter != b.counter -> return a.counter > b.counter
    a.replica > b.replica
}

fn text_visible(doc: SyncText) -> [Int] Never! {
    visible := [Int]{}
    loop index in text_order(doc) {
        if !doc.atoms[index].deleted -> &visible.push(index)
    }
    visible
}

// The document-wide Lamport clock: the largest counter any replica wrote.
fn text_clock(doc: SyncText) -> Int Never! {
    clock := 0
    loop atom in doc.atoms {
        if atom.counter > clock -> clock = atom.counter
    }
    clock
}

// Writing `count` more characters would mint a counter past the largest Int.
fn clock_exhausted(doc: SyncText, count: Int) -> Bool Never! {
    text_clock(doc) > MAX_INT - count - 1
}

fn mark_deleted(doc: SyncText, indices: [Int]) -> SyncText Never! {
    marked := [Int:Bool]{}
    loop index in indices -> _ :: &marked.add(index, true)
    atoms := [SyncTextAtom]{}
    loop index in 0..<doc.atoms.len() {
        atom :: doc.atoms[index]
        if marked.get(index) == .None {
            &atoms.push(atom)
        } else {
            &atoms.push(SyncTextAtom{replica: atom.replica, counter: atom.counter, after: atom.after, scalar: atom.scalar, deleted: true})
        }
    }
    SyncText{atoms: atoms, valid: doc.valid}
}

// Write `inserted` as a chain of atoms after `anchor`, each with its own
// identity so a later insert can land between any two characters.
fn insert_after(doc: SyncText, replica: String, anchor: String, inserted: [String]) -> SyncText Never! {
    atoms := doc.atoms
    after := anchor
    clock := text_clock(doc)
    loop scalar in inserted {
        clock += 1
        &atoms.push(SyncTextAtom{replica: replica, counter: clock, after: after, scalar: scalar, deleted: false})
        after = atom_id(replica, clock)
    }
    SyncText{atoms: atoms, valid: doc.valid}
}

// The checked sum of every replica's positive minus negative count; None when
// it leaves Int.
fn counter_total(counter: SyncCounter) -> Int? Never! {
    total := 0
    loop replica in counter.counts.keys() {
        count :: counter.counts.get(replica) ?? next
        if count.positive < 0 || count.negative < 0 -> return None
        if total > 0 && count.positive > MAX_INT - total -> return None
        total = total + count.positive
        if total < 0 && count.negative > MAX_INT + total + 1 -> return None
        total = total - count.negative
    }
    Val(total)
}

// Items stay sorted by replica, then value, so every replica shows one order.
fn insert_item(items: [RGAItem], item: RGAItem) -> [RGAItem] Never! {
    out := [RGAItem]{}
    placed := false
    loop existing in items {
        later := existing.replica > item.replica
        if existing.replica == item.replica -> later = existing.value > item.value
        if !placed && later {
            &out.push(item)
            placed = true
        }
        &out.push(existing)
    }
    if !placed -> &out.push(item)
    out
}

// Shown keys, values, and replica names escape the separators the shown form
// uses, so the text reads back unambiguously.
fn escape_display(value: String) -> String Never! {
    out := ""
    loop scalar in unicode.scalars(value) {
        if scalar == "\\" || scalar == "," || scalar == "=" || scalar == "|" || scalar == ":" || scalar == "/" -> out = "{out}\\"
        out = "{out}{scalar}"
    }
    out
}

fn contains(items: [String], value: String) -> Bool {
    loop item in items {
        if item == value -> return true
    }
    false
}
