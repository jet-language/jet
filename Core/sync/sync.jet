package {
    name: "core.sync"
    version: "0.1.0"
    edition: "2026"
    description: "CRDT counters, maps, lists, and text."
    license: "MIT"
    outputs: {
        sync: .Library{ entry: sync }
    }
}
// core.sync — state-based CRDTs. G-counters, LWW-registers in a map
// RGA-ish lists (id + value + tombstone), and LWW text. Merge is a
// join: max per replica, last-writer-wins by timestamp.
pub struct SyncCounter {
    pub replica: String
    pub counts: [String:Int]
}

pub struct SyncMap {
    pub replica: String
    pub clock: Int
    pub entries: [String:Lww]
}

pub struct Lww {
    pub value: String
    pub ts: Int
    pub replica: String
    pub deleted: Bool
}

pub struct SyncList {
    pub replica: String
    pub clock: Int
    pub items: [RgaItem]
}

pub struct RgaItem {
    pub id: String
    pub value: String
    pub tombstone: Bool
}

pub struct SyncText {
    pub replica: String
    pub clock: Int
    pub value: String
    pub ts: Int
}

pub struct RowPolicy {
    pub allow: [String]
    pub deny: [String]
}

pub fn counter_new() -> SyncCounter { SyncCounter{replica: "local", counts: [String:Int]{}} }

pub fn counter_inc(counter: SyncCounter) -> SyncCounter {
    cur :: counter.counts.get(counter.replica) ?? 0
    SyncCounter{replica: counter.replica, counts: counter.counts.add(counter.replica, cur + 1)}
}

pub fn counter_merge(left: SyncCounter, right: SyncCounter) -> SyncCounter {
    out := left.counts
    loop k in right.counts.keys() {
        rv :: right.counts.get(k) ?? 0
        lv :: out.get(k) ?? 0
        if rv > lv -> out = out.add(k, rv)
    }
    SyncCounter{replica: left.replica, counts: out}
}

pub fn counter_value(counter: SyncCounter) -> Int {
    n := 0
    loop k in counter.counts.keys() -> n = n + (counter.counts.get(k) ?? 0)
    n
}

pub fn map_new() -> SyncMap { SyncMap{replica: "local", clock: 0, entries: [String:Lww]{}} }

pub fn map_set(map: SyncMap, key: String, value: String) -> SyncMap {
    ts := map.clock + 1
    e :: Lww{value: value, ts: ts, replica: map.replica, deleted: false}
    SyncMap{replica: map.replica, clock: ts, entries: map.entries.add(key, e)}
}

pub fn map_get(map: SyncMap, key: String) -> ?String {
    e :: map.entries.get(key) ?? return None
    if e.deleted -> return None
    Val(e.value)
}

pub fn map_merge(left: SyncMap, right: SyncMap) -> SyncMap {
    out := left.entries
    loop k in right.entries.keys() {
        rv :: right.entries.get(k) ?? Lww{value: "", ts: 0, replica: "", deleted: false}
        lv :: out.get(k)
        if lv == .None -> out = out.add(k, rv) else {
            l :: lv ?? rv
            if rv.ts > l.ts || (rv.ts == l.ts && rv.replica > l.replica) -> out = out.add(k, rv)
        }
    }
    clock := left.clock
    if right.clock > clock -> clock = right.clock
    SyncMap{replica: left.replica, clock: clock, entries: out}
}

pub fn map_show(map: SyncMap) -> String {
    out := "{{"
    first := true
    loop k in map.entries.keys() {
        e :: map.entries.get(k) ?? Lww{value: "", ts: 0, replica: "", deleted: true}
        if e.deleted -> next
        if !first -> out = "{out},"
        first = false
        out = "{out}{k}:{e.value}"
    }
    "{out}}}"
}

pub fn list_new() -> SyncList { SyncList{replica: "local", clock: 0, items: [RgaItem]{}} }

pub fn list_push(list: SyncList, value: String) -> SyncList {
    clock := list.clock + 1
    id := "{list.replica}:{clock}"
    items := [RgaItem]{}
    items.push(RgaItem{id: id, value: value, tombstone: false})
    SyncList{replica: list.replica, clock: clock, items: items}
}

pub fn list_merge(left: SyncList, right: SyncList) -> SyncList {
    seen := [String:RgaItem]{}
    order := [String]{}
    items := [RgaItem]{}
    loop id in order -> items.push(seen.get(id) ?? RgaItem{id: id, value: "", tombstone: true})
    clock := left.clock
    if right.clock > clock -> clock = right.clock
    SyncList{replica: left.replica, clock: clock, items: items}
}

pub fn list_show(list: SyncList) -> String {
    out := "["
    first := true
    "{out}]"
}

pub fn text_new() -> SyncText { SyncText{replica: "local", clock: 0, value: "", ts: 0} }

pub fn text_set(text: SyncText, value: String) -> SyncText {
    ts := text.clock + 1
    SyncText{replica: text.replica, clock: ts, value: value, ts: ts}
}

pub fn text_edit(text: SyncText, value: String) -> SyncText { text_set(text, value) }

pub fn text_merge(left: SyncText, right: SyncText) -> SyncText {
    if right.ts > left.ts || (right.ts == left.ts && right.replica > left.replica) {
        clock := left.clock
        if right.clock > clock -> clock = right.clock
        return SyncText{replica: left.replica, clock: clock, value: right.value, ts: right.ts}
    }
    clock := left.clock
    if right.clock > clock -> clock = right.clock
    SyncText{replica: left.replica, clock: clock, value: left.value, ts: left.ts}
}

pub fn text_show(text: SyncText) -> String { text.value }

pub fn text_metadata(text: SyncText) -> String { "{text.replica}@{text.ts}" }

pub fn policy_new() -> RowPolicy { RowPolicy{allow: [String]{}, deny: [String]{}} }

pub fn policy_allows(policy: RowPolicy, action: String) -> Bool {
    loop d in policy.deny {
        if d == action || d == "*" -> return false
    }
    if policy.allow.len() == 0 -> return true
    loop a in policy.allow {
        if a == action || a == "*" -> return true
    }
    false
}

pub fn policy_show(policy: RowPolicy) -> String {
    "allow={policy.allow.len()} deny={policy.deny.len()}"
}
