//RS /// Shared object-safe seam for callback jobs owned by one origin runtime.
//RS ///
//RS /// Implementations must balance `session_started` and `session_finished`.
//RS /// `close_admission` prevents new registrations but does not reject cleanup or
//RS /// Ready jobs from sessions that already hold a registration. A drain reports
//RS /// `Pending` until real callback sessions have closed and all queued jobs are
//RS /// consumed. Jobs are joined in batches outside tracker locks; all job and join
//RS /// failures are accumulated rather than short-circuiting. If a drain unwinds,
//RS /// active and unjoined handles and their completion debt must remain available
//RS /// for the next drain. `Complete` is valid only once no callback session or
//RS /// job remains; accumulated failures remain available for repeat reporting.
//RS pub trait SourceCallbackJobOwner: Send + Sync {
//RS     /// Admit one callback session before creating its owned session state.
//RS     /// On success, acquire exactly one session registration; on error, change
//RS     /// no registration count.
//RS     fn session_started(&self) -> Result<(), String>;
//RS     /// Balance one admitted session after normal or abandonment cleanup
//RS     /// completes; missing registrations are an invariant error, never saturated.
//RS     fn session_finished(&self);
//RS     /// Seal session admission while existing sessions may still submit jobs.
//RS     fn close_admission(&self);
//RS     /// Return the exact owned job if admission is rejected. Existing
//RS     /// registrations may submit cleanup and Ready jobs after close.
//RS     fn submit(&self, job: SourceCallbackJob) -> Result<(), SourceCallbackJob>;
//RS     fn drain(&self) -> SourceCallbackJobDrainOutcome;
//RS }
