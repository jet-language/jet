//RS     P: Send + 'static,
//RS     C: Send + 'static,
//RS     X: Send + 'static,
//RS     R: Send + 'static,
//RS {
//RS     /// Callback payload lease selected for release.
//RS     pub fn callback_id(&self) -> SourceCallbackId {
//RS         self.callback
