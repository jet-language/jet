//RS /// Owner-side release event. It owns the original registered payload exactly
//RS /// once. The owner runs Source/Eval cleanup on `payload_mut`, then calls
//RS /// `complete`; dropping an uncompleted event requeues that same payload.
//RS pub struct SourceCallbackRelease<P, C, X, R> {
//RS     state: Arc<Mutex<CallbackState<P, C, X, R>>>,
//RS     callback: SourceCallbackId,
//RS     payload: Option<P>,
//RS     completed: bool,
