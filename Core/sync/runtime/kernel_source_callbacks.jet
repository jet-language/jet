//RS //! Per-session transport for retained Source callback invocations.
//RS //!
//RS //! This module deliberately does not know how a callback is evaluated. A
//RS //! request owns only a command, task context, and one-shot reply channel; the
//RS //! session owner pumps requests and uses its own retained Source/Eval graph to
//RS //! execute them. Payloads and identities are session-local: there is no
//RS //! process-wide callback table and no machine pointer in this transport.
//RS 
//RS use std::collections::{HashMap, VecDeque};
//RS use std::fmt;
//RS use std::sync::{Arc, Condvar, Mutex, MutexGuard, Weak};
