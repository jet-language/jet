// Rust: crates/jet-codegen/src/Prelude/CoreLib/SyncPublish.rs:370
// A canonical display is merged into typed session state. Duplicate delivery is
// idempotent, and transport publication occurs only after releasing the lock.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/SyncPublish.rs:375
fn jet_sync_publish(session_id: String, doc_show: String) -> String {
    trimmed := session_id.trim() // #4303
    if trimmed.is_empty() || session_id.len() > MAX_SYNC_SESSION || session_id.chars().any(Char.is_control) {
        return "SyncError(invalid session)"
    }
    document :: JetSyncDocument.parse(doc_show) ?? return "SyncError(document is not a canonical CRDT value)"
    // GATE #4565: kernel primitive
    sessions := match #Unsafe("hold the session mutex for the complete state transition; reject poison") { jet_sync_sessions().lock() } {
        Ok(sessions) -> sessions
        Err(_) -> return "SyncError(session registry is unavailable)"
    }
    if !sessions.contains_key(session_id) && sessions.len() >= MAX_SYNC_ENTRIES -> return "SyncError(session limit exceeded)"
    state := sessions.entry(session_id.clone()).or_insert_with(fn() { JetSyncSessionState{generation: U64{0}, document: document.clone()} })
    changed := false
    if state.document != document {
        merged :: state.document.merge(document) ?? return "SyncError(document merge denied)"
        if state.document != merged {
            generation :: state.generation.checked_add(U64{1}) ?? return "SyncError(session generation exhausted)"
            state.generation = generation
            state.document = ^merged
            changed = true
        }
    } else if state.generation == U64{0} {
        state.generation = U64{1}
        changed = true
    }
    receipt :: JetSyncReceipt{session_id: ^session_id, generation: state.generation, document: state.document.clone()}
    shown :: receipt.show()
    transport :: if changed { Val("sync:{receipt.session_id}:{receipt.generation}:{receipt.document.representation}") } else { None }
    // GATE #4565: kernel primitive
    #Unsafe("release the mutex guard before invoking the external transport publisher") { drop(^sessions) }
    if transport is Val(transport) -> jet_live_publish_transport("sync:{receipt.session_id}", ^transport)
    ^shown
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/SyncPublish.rs:436
// D-SYNC1: document first, session named by `over:` at the Core boundary.
