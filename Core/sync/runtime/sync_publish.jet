// Rust: crates/jet-codegen/src/Prelude/CoreLib/SyncPublish.rs:365
// GATE #4565: kernel primitive
#Unsafe("initialize one process-lifetime mutex registry with OnceLock; lend its retained storage")
fn jet_sync_sessions() -> @Mutex<[String:JetSyncSessionState]> {
