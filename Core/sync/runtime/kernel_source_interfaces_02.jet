//RS                 failure: method.failure.clone(),
//RS             },
//RS         })
//RS     }
//RS }
//RS 
//RS /// Full result of one native interface invocation. The owned call remains
//RS /// available on failure so the caller can write back every mutable argument
//RS /// and discharge every physical transfer receipt before returning the error.
//RS pub struct NativeInterfaceCompletion {
//RS     outcome: Result<MirRuntimeValue, NativeInterfaceError>,
//RS     call: NativeInterfaceCall,
//RS }
//RS 
//RS impl NativeInterfaceCompletion {
//RS     pub fn outcome(&self) -> Result<&MirRuntimeValue, &NativeInterfaceError> {
//RS         self.outcome.as_ref()
//RS     }
//RS 
//RS     pub fn call(&self) -> &NativeInterfaceCall {
//RS         &self.call
//RS     }
//RS 
//RS     pub fn into_parts(
//RS         self,
//RS     ) -> (
//RS         Result<MirRuntimeValue, NativeInterfaceError>,
//RS         NativeInterfaceCall,
//RS     ) {
//RS         (self.outcome, self.call)
//RS     }
//RS }
//RS 
//RS #[derive(Clone, Debug, PartialEq, Eq)]
//RS pub enum NativeInterfaceError {
//RS     InvalidMetadata(String),
//RS     InvalidCall(String),
//RS     MissingBinding,
//RS     DuplicateBinding,
//RS     AmbiguousBinding,
//RS     /// A second function value with the same checked signature was bound on a
//RS     /// carrier root that already exposes one; JIT function values would be
//RS     /// indistinguishable, so the registration is refused up front.
//RS     CallableRootCollision {
//RS         key: String,
//RS         object: NativeInterfaceObjectId,
//RS     },
//RS     ReceiverMismatch,
//RS     SignatureMismatch,
//RS     ExecutionMismatch,
//RS     IdentityExhausted,
//RS     UnresolvedTransfers(Vec<usize>),
//RS     Handler(String),
//RS     /// The handler unwound. The completion still carries the owned call with
//RS     /// every argument row, committed receipt, and pending transfer intact.
//RS     HandlerPanicked(String),
//RS }
//RS 
//RS impl fmt::Display for NativeInterfaceError {
//RS     fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
//RS         match self {
//RS             Self::InvalidMetadata(detail) => write!(formatter, "invalid native interface metadata: {detail}"),
//RS             Self::InvalidCall(detail) => write!(formatter, "invalid native interface call: {detail}"),
//RS             Self::MissingBinding => formatter.write_str("no native interface binding is active for this checked receiver"),
//RS             Self::DuplicateBinding => formatter.write_str("native interface method binding is duplicated"),
//RS             Self::AmbiguousBinding => formatter.write_str("native interface receiver matches more than one checked binding"),
//RS             Self::CallableRootCollision { key, object } => write!(
//RS                 formatter,
//RS                 "native callable `{key}` shares a carrier root ({object:?}) and checked signature with an existing function value; bind it on its own root"
//RS             ),
//RS             Self::ReceiverMismatch => formatter.write_str("native interface receiver does not carry the retained binding root"),
//RS             Self::SignatureMismatch => formatter.write_str("native interface signature does not match its checked MIR method"),
//RS             Self::ExecutionMismatch => formatter.write_str("native interface binding belongs to a different checked execution or artifact"),
//RS             Self::IdentityExhausted => formatter.write_str("native interface object identity space is exhausted"),
//RS             Self::UnresolvedTransfers(arguments) => write!(formatter, "native interface call has unresolved owned transfers for arguments {arguments:?}"),
//RS             Self::Handler(detail) => write!(formatter, "native interface handler failed: {detail}"),
//RS             Self::HandlerPanicked(detail) => write!(formatter, "native interface handler panicked: {detail}"),
//RS         }
//RS     }
//RS }
//RS 
//RS impl std::error::Error for NativeInterfaceError {}
