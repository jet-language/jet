//RS //! Checked, invocation-scoped dispatch for native implementations of private MIR traits.
//RS //!
//RS //! A binding associates one checked trait method with a non-owning registered carrier identity;
//RS //! its physical root remains in an external carrier. The set is activated around a specific
//RS //! artifact execution; nested calls restore the previous activation, and task workers must
//RS //! explicitly activate their own set. Calls own every argument until a completion (including
//RS //! failures and handler unwinds) returns the exact argument rows and transfer receipts. Move
//RS //! payloads remain in call-owned escrow until an explicit disposition commits; handlers borrow
//RS //! a recoverable ownership guard, and rejected offers remain in the completion unless taken.
//RS 
//RS use jet_foundation::Diagnostics::Span;
//RS use jet_foundation::MIR::{
//RS     MirAccess, MirArtifactId, MirExecutionIdentity, MirFailureCarrier, MirFieldId, MirNativeOwned,
//RS     MirParam, MirPreludeCallId, MirProgram, MirRuntimeValue, MirTraitId, MirTraitMethodId,
//RS     MirTraitRef, MirType, MirTypeId, MirTypeKind,
//RS };
//RS use std::any::{Any, TypeId};
//RS use std::cell::{Cell, RefCell};
//RS use std::fmt;
//RS use std::marker::PhantomData;
//RS use std::panic::AssertUnwindSafe;
//RS use std::rc::Rc;
//RS use std::sync::atomic::{AtomicU64, Ordering};
//RS use std::sync::{Arc, Mutex, Weak};
//RS 
