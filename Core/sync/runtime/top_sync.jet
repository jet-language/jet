// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:198
// Write a chain of independently identified characters after an anchor.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:201
fn jet_sync_text_insert_after(doc: &JetSyncText, replica: &String, anchor: (String, U64)?, text: &String) -> {
    anchor := ^anchor
    counter := jet_sync_text_next_counter(doc)
    loop ch in text.chars() {
        doc.atoms.push(JetSyncTextAtom{replica: replica.to_string(), counter, after: ^anchor, ch, deleted: false})
        anchor = Val((replica.to_string(), counter))
        counter += 1
    }
}
