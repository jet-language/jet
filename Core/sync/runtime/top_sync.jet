                chars := ch.chars()
                single :: match (chars.next(),chars.next()) { (Some(ch),None) -> Some(ch), _ -> None }
                match (anchor,single) {
                    (Ok(anchor),Some(ch)) if jet_sync_token_is_valid(&replica) && counter > 0 -> {
                        id :: (replica.clone(),counter)
