// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:299
// Union retains all atoms; deletion is monotone. Over-limit merge is invalid, never truncated.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:302
fn jet_sync_text_merge(a: &JetSyncText, b: &JetSyncText) -> JetSyncText {
    if !a.valid || !b.valid -> return JetSyncText{atoms: [], valid: false}
    // GATE #4499: exact composite identity-key equality/order.
    merged: [(String, U64):JetSyncTextAtom] := [:]
    loop atom in a.atoms.iter().chain(&b.atoms) {
        if !jet_sync_token_is_valid(&atom.replica) || atom.counter == 0
            || atom.after.as_ref().is_some_and(fn((replica, counter)) { !jet_sync_token_is_valid(replica) || *counter == 0 }) {
            return JetSyncText{atoms: [], valid: false}
        }
        key :: (atom.replica.clone(), atom.counter)
        match merged.get_mut(&key) {
            Val(existing) -> {
                // Identity collision with different reading/anchor is a malformed fork.
                if existing.ch != atom.ch || existing.after != atom.after -> return JetSyncText{atoms: [], valid: false}
                existing.deleted = existing.deleted || atom.deleted
            }
            None -> { _ :: merged.insert(^key, atom.clone()) }
        }
    }
    if merged.len() > MAX_SYNC_ATOMS -> return JetSyncText{atoms: [], valid: false}
    keys :: merged.keys().cloned().collect::<[(String, U64)]>().sorted()
    atoms :: keys.into_iter().map(fn(key) { merged.remove(&key).unwrap() }).collect()
    merged :: JetSyncText{atoms: ^atoms, valid: true}
    // Reject cycle/orphan rather than silently dropping unreachable atoms in show.
    if jet_sync_text_order(&merged).len() != merged.atoms.len() -> return JetSyncText{atoms: [], valid: false}
    merged
}
