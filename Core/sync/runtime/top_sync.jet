// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:1222
fn jet_sync_object(tree: &DataTree,expected: &[String],label: &String) -> &[(String,DataTree)] [FieldError]! {
    match tree {
        DataTree.Object(fields) -> {
            if fields.len() != expected.len() || fields.iter().any(fn((key,_)) { !expected.iter().any(fn(name) { *name == key }) })
                || expected.iter().any(fn(name) { !fields.iter().any(fn((key,_)) { key == name }) }) {
