// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:410
fn jet_sync_counter_invalid() -> JetSyncCounter { JetSyncCounter{counts: [], valid: false} }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:417
fn jet_sync_counter_inc(counter: JetSyncCounter, replica: String, delta: I64) -> JetSyncCounter {
    counter := ^counter
    if !counter.valid || !jet_sync_token_is_valid(&replica) -> return counter
    if Val((_, positive, negative)) :: counter.counts.iter_mut().find(fn((r, _, _)) { r == &replica }) {
        if delta >= 0 {
            next :: positive.checked_add(delta as U64) ?? return jet_sync_counter_invalid()
            *positive = next
        } else {
            next :: negative.checked_add(delta.unsigned_abs()) ?? return jet_sync_counter_invalid()
            *negative = next
        }
    } else {
        if counter.counts.len() >= MAX_SYNC_REPLICAS -> return jet_sync_counter_invalid()
        counter.counts.push((^replica, if delta >= 0 { delta as U64 } else { 0 },
            if delta < 0 { delta.unsigned_abs() } else { 0 }))
    }
    counter.counts.sort_by(fn(left, right) { left.0.cmp(&right.0) })
    if jet_sync_counter_total(&counter.counts).is_none() -> return jet_sync_counter_invalid()
    counter
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:455
fn jet_sync_counter_total(counts: &[(String, U64, U64)]) -> I64? {
    total: I128 := 0
    loop (_, positive, negative) in counts {
        total = total.checked_add(I128.from(*positive))?.checked_sub(I128.from(*negative))?
    }
    I64.try_from(total).ok()
