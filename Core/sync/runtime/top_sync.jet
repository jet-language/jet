// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:259
// Indices are Unicode scalars. Anchor before the replacement survives concurrent edits.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:262
fn jet_sync_text_edit(doc: JetSyncText, replica: String, index: I64, delete_count: I64, insert: String) -> JetSyncText {
    doc := ^doc
    inserted :: insert.chars().count()
    if !doc.valid || !jet_sync_token_is_valid(&replica) || index < 0 || delete_count < 0
        || insert.len() > MAX_SYNC_TEXT || doc.atoms.len().saturating_add(inserted) > MAX_SYNC_ATOMS
        || jet_sync_text_clock_exhausted(&doc, inserted) -> return doc
