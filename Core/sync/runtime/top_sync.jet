            fields :: match jet_sync_object(value,&["replica","counter","after","ch","deleted"],"SyncText atom") {
                Ok(fields) -> fields,
                Err(entry_errors) -> { jet_sync_frame_entry(&errors,index,^entry_errors); continue }
            }
            entry_errors := []
            replica :: jet_sync_decode_field(fields,"replica","SyncText atom",&entry_errors,fn(tree) { jet_sync_decode_string(tree,"SyncText.replica") })
            counter :: jet_sync_decode_field(fields,"counter","SyncText atom",&entry_errors,fn(tree) { jet_sync_decode_u64(tree,"SyncText.counter") })
            after :: jet_sync_decode_field(fields,"after","SyncText atom",&entry_errors,fn(tree) { jet_sync_decode_string(tree,"SyncText.after") })
            ch :: jet_sync_decode_field(fields,"ch","SyncText atom",&entry_errors,fn(tree) { jet_sync_decode_string(tree,"SyncText.ch") })
            deleted :: jet_sync_decode_field(fields,"deleted","SyncText atom",&entry_errors,fn(tree) {
                match tree { DataTree.Bool(value) -> Ok(*value), _ -> Err(jet_sync_decode_error("SyncText.deleted expects a Bool")) }
            })
            if (Some(replica),Some(counter),Some(after),Some(ch),Some(deleted)) :: (replica,counter,after,ch,deleted) {
                anchor :: if after.is_empty() { Ok(None) } else {
                    match after.rsplit_once(':') {
                        Some((replica,counter)) -> match counter.parse::<U64>() {
                            Ok(counter) if jet_sync_token_is_valid(replica) && counter > 0 -> Ok(Some((replica.to_string(),counter))),
                            _ -> Err(())
                        },
                        None -> Err(())
                    }
