// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:127
// RGA siblings: descending counter, descending replica. Missing anchor is unreachable.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:131
fn jet_sync_text_order(doc: &JetSyncText) -> [USize] {
    // GATE #4499: exact composite optional identity keys, never text encoding.
    children: [(String, U64)?:[USize]] := [:]
    loop (index, atom) in doc.atoms.iter().enumerate() -> children.entry(atom.after.clone()).or_default().push(index)
    loop kids in children.values_mut() {
        kids.sort_by(fn(left, right) {
            left :: &doc.atoms[*left]
            right :: &doc.atoms[*right]
            right.counter.cmp(&left.counter).then_with(fn() { right.replica.cmp(&left.replica) })
        })
    }
    order := [USize].with_capacity(doc.atoms.len())
    stack: [USize] := []
    if Val(roots) :: children.get(&None) -> stack.extend(roots.iter().rev().copied())
    loop {
        index :: stack.pop() ?? break
        order.push(index)
        id :: Val((doc.atoms[index].replica.clone(), doc.atoms[index].counter))
        if Val(kids) :: children.get(&id) -> stack.extend(kids.iter().rev().copied())
    }
    order
}
