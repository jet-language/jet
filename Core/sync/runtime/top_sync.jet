// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:465
fn jet_sync_counter_merge(a: &JetSyncCounter, b: &JetSyncCounter) -> JetSyncCounter {
    if !a.valid || !b.valid -> return JetSyncCounter{counts: [], valid: false}
    merged: [String:(U64, U64)] := [:]
    loop (replica, positive, negative) in a.counts.iter().chain(&b.counts) {
        if !jet_sync_token_is_valid(replica) -> return JetSyncCounter{counts: [], valid: false}
        entry :: merged.entry(replica.clone()).or_insert((0, 0))
        entry.0 = entry.0.max(*positive)
        entry.1 = entry.1.max(*negative)
    }
    if merged.len() > MAX_SYNC_REPLICAS -> return JetSyncCounter{counts: [], valid: false}
    keys :: merged.keys().cloned().collect::<[String]>().sorted()
    counts :: keys.into_iter().map(fn(replica) {
        (positive, negative) :: merged.remove(&replica).unwrap()
        (^replica, positive, negative)
    }).collect()
    if jet_sync_counter_total(&counts).is_none() -> return jet_sync_counter_invalid()
    JetSyncCounter{counts: ^counts, valid: true}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:503
fn jet_sync_counter_value(counter: &JetSyncCounter) -> I64 {
    if !counter.valid -> return 0
    jet_sync_counter_total(&counter.counts).unwrap_or(0)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:510
fn jet_sync_counter_metadata(counter: &JetSyncCounter) -> String {
    if !counter.valid -> return "SyncError(invalid SyncCounter)"
    parts :: counter.counts.iter().map(fn((replica, positive, negative)) { format!("{replica}=+{positive}/-{negative}") }).collect::<[String]>().join(",")
    format!("PNCounter({parts})")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:523
fn jet_sync_map_new() -> JetSyncMap { JetSyncMap{entries: [],valid: true} }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:530
fn jet_sync_map_set_replica(map: JetSyncMap,replica: String,key: String,value: String) -> JetSyncMap {
    if !map.valid || !jet_sync_token_is_valid(&replica) || !jet_sync_token_is_valid(&key) || value.len() > MAX_SYNC_TEXT { return ^map }
    // Writes advance beyond every observed remote clock.
    next_clock :: map.entries.iter().map(fn((_,_,clock,_)) { *clock }).max().unwrap_or(0).checked_add(1)
    if next_clock.is_none() { return JetSyncMap{entries: [],valid: false} }
    if Some((_,v,clock,writer)) :: map.entries.iter_mut().find(fn((k,_,_,_)) { k == &key }) {
        *v = ^value
        *clock = next_clock.unwrap()
        *writer = ^replica
    } else {
        if map.entries.len() >= MAX_SYNC_ENTRIES { return JetSyncMap{entries: [],valid: false} }
        map.entries.push((^key,^value,next_clock.unwrap(),^replica))
    }
    map.entries.sort_by(fn(left,right) { left.0.cmp(&right.0) })
    ^map
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:578
fn jet_sync_map_set(map: JetSyncMap,key: String,value: String) -> JetSyncMap { jet_sync_map_set_replica(^map,"local",^key,^value) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:585
// Invalid carriers deny every read, not only show/metadata/encode.
fn jet_sync_map_get(map: &JetSyncMap,key: &String) -> String? {
    if !map.valid { return None }
    map.entries.iter().find(fn((k,_,_,_)) { k == key }).map(fn((_,v,_,_)) { v.clone() })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:595
fn jet_sync_map_merge(a: &JetSyncMap,b: &JetSyncMap) -> JetSyncMap {
    if !a.valid || !b.valid { return JetSyncMap{entries: [],valid: false} }
    merged: [String:(String,U64,String)] := [:]
    for (key,value,clock,writer) in a.entries.iter().chain(&b.entries) {
        if !jet_sync_token_is_valid(key) || !jet_sync_token_is_valid(writer) || *clock == 0 || value.len() > MAX_SYNC_TEXT { return JetSyncMap{entries: [],valid: false} }
        replace :: merged.get(key).map_or(true,fn((existing,existing_clock,existing_writer)) {
            *clock > *existing_clock || (*clock == *existing_clock && (writer.as_str(),value.as_str()) > (existing_writer.as_str(),existing.as_str()))
        })
        if replace { merged.insert(key.clone(),(value.clone(),*clock,writer.clone())) }
    }
    if merged.len() > MAX_SYNC_ENTRIES { return JetSyncMap{entries: [],valid: false} }
    keys :: merged.keys().cloned().collect::<[String]>().sorted()
    entries :: keys.into_iter().map(fn(key) { (value,clock,writer) :: merged.remove(&key).unwrap(); (^key,^value,clock,^writer) }).collect()
    JetSyncMap{entries: ^entries,valid: true}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:642
fn jet_sync_map_show(map: &JetSyncMap) -> String {
    if !map.valid { return "SyncError(invalid SyncMap)" }
    parts :: map.entries.iter().map(fn((k,v,_,_)) { "{jet_sync_escape_display(k)}={jet_sync_escape_display(v)}" }).collect::<[String]>().join(",")
    "SyncMap({parts})"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:661
fn jet_sync_map_metadata(map: &JetSyncMap) -> String {
    if !map.valid { return "SyncError(invalid SyncMap)" }
    parts :: map.entries.iter().map(fn((key,_,clock,writer)) { "{jet_sync_escape_display(key)}@{jet_sync_escape_display(writer)}={clock}" }).collect::<[String]>().join(",")
    "LWWMap({parts})"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:680
// Wire identity is canonical Codable JSON, not a new key-order requirement.
fn jet_sync_value_id<T: __jet_Encode>(value: &T) -> String { render_datatree_json(&value.jet_encode(),true,0) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:687
fn jet_sync_value_show<T: __jet_Encode>(value: &T) -> String { render_datatree_json(&value.jet_encode(),false,0) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:691
fn jet_sync_map_new_generic<K,V>() -> JetSyncMapGeneric<K,V> { JetSyncMapGeneric{entries: [],valid: true} }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:698
fn jet_sync_map_set_generic<K: __jet_Encode,V: __jet_Encode>(map: JetSyncMapGeneric<K,V>,replica: String,key: K,value: V) -> JetSyncMapGeneric<K,V> {
    if !map.valid || !jet_sync_token_is_valid(&replica) { return ^map }
    key_id :: jet_sync_value_id(&key)
    if key_id.len() > MAX_SYNC_TEXT || jet_sync_value_id(&value).len() > MAX_SYNC_TEXT { return ^map }
    next_clock :: map.entries.iter().map(fn((_,_,clock,_)) { *clock }).max().unwrap_or(0).checked_add(1)
    if next_clock.is_none() { return JetSyncMapGeneric{entries: [],valid: false} }
    if Some((existing_key,existing_value,clock,writer)) :: map.entries.iter_mut().find(fn((existing_key,_,_,_)) { jet_sync_value_id(existing_key) == key_id }) {
        *existing_key = ^key
        *existing_value = ^value
        *clock = next_clock.unwrap()
        *writer = ^replica
    } else if map.entries.len() < MAX_SYNC_ENTRIES { map.entries.push((^key,^value,next_clock.unwrap(),^replica)) }
