// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:371
// Highest written counter per replica: Lamport metadata, not causal vector clock.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:374
fn jet_sync_text_metadata(doc: &JetSyncText) -> String {
    if !doc.valid -> return "SyncError(invalid SyncText)"
    clocks: [&String:U64] := [:]
    loop atom in &doc.atoms {
        slot :: clocks.entry(&atom.replica).or_insert(0)
        if atom.counter > *slot -> *slot = atom.counter
    }
    keys :: clocks.keys().copied().collect::<[&String]>().sorted()
    parts :: keys.into_iter().map(fn(replica) { format!("{replica}={}", clocks[replica]) }).collect::<[String]>().join(",")
    format!("LamportClock({parts})")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:393
fn jet_sync_counter_new(replica: String, value: I64) -> JetSyncCounter {
    if !jet_sync_token_is_valid(&replica) -> return JetSyncCounter{counts: [], valid: false}
