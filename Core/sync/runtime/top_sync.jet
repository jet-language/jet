// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:176
// Document-wide Lamport clock, not per-replica; sibling order compares replicas.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:180
fn jet_sync_text_next_counter(doc: &JetSyncText) -> U64 {
    doc.atoms.iter().map(fn(atom) { atom.counter }).max().unwrap_or(0).saturating_add(1)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:189
// Refuse exhausted clock rather than minting a duplicate identity by saturation.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Sync.rs:191
fn jet_sync_text_clock_exhausted(doc: &JetSyncText, count: USize) -> Bool {
    U64.try_from(count).ok().and_then(fn(count) { jet_sync_text_next_counter(doc).checked_add(count) }).is_none()
