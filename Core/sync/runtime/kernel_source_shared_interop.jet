//RS /// The physical operations supplied by the owner of one typed Shared root.
//RS ///
//RS /// Each operation must invoke its callback exactly once while the canonical
//RS /// read/edit permit is held. An edit callback error is a transport or codec
//RS /// failure and aborts the physical edit; a successful edit callback commits
//RS /// the value supplied by the callback under that same permit. A semantic
//RS /// Source callback error is an ordinary value in the callback's successful
//RS /// result and therefore still commits. `acquire_guard` holds the same
//RS /// physical permit until the returned guard is dropped.
//RS pub trait SourceSharedInteropBackend: Send + Sync + 'static {
//RS     fn with_read(
//RS         &self,
//RS         callback: &mut dyn FnMut(&MirRuntimeValue) -> Result<(), String>,
//RS     ) -> crate::Memory::shared_protocol::JetSharedPhysicalOperationOutcome<()>;
//RS     fn with_read_revision(
//RS         &self,
//RS         callback: &mut dyn FnMut(&MirRuntimeValue, u64) -> Result<(), String>,
//RS     ) -> crate::Memory::shared_protocol::JetSharedPhysicalOperationOutcome<()>;
//RS 
//RS     fn with_edit(
//RS         &self,
//RS         callback: &mut dyn FnMut(&mut MirRuntimeValue) -> Result<(), String>,
//RS     ) -> crate::Memory::shared_protocol::JetSharedPhysicalOperationOutcome<()>;
//RS     fn replace_if_revision(
//RS         &self,
//RS         expected_revision: u64,
//RS         replacement: MirRuntimeValue,
//RS     ) -> crate::Memory::shared_protocol::JetSharedPhysicalOperationOutcome<(bool, u64)>;
//RS 
//RS     fn acquire_guard(
//RS         &self,
//RS         editable: bool,
//RS     ) -> crate::Memory::shared_protocol::JetSharedPhysicalOperationOutcome<
//RS         Box<dyn SourceSharedInteropGuard>,
//RS     >;
//RS }
