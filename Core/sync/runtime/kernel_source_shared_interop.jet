//RS /// One checked, identity-preserving physical Shared root.
//RS ///
//RS /// Cloning this value aliases the same backend and therefore the same physical
//RS /// root.  `identity` is only an in-process equality key for sidecar lookup; it
//RS /// is never emitted into MIR or used as a language-level handle.
//RS #[derive(Clone)]
//RS pub struct SourceSharedInterop {
//RS     type_id: u64,
//RS     backend: Arc<dyn SourceSharedInteropBackend>,
//RS     owner_identity: Option<usize>,
//RS     protocol_order_key: Option<usize>,
//RS     owner_lifecycle: Option<Arc<OwnerLifecycle>>,
//RS     owner_alias_lifecycle: Option<Arc<OwnerAliasLifecycle>>,
//RS     owner_alias_lease: Option<Arc<SourceSharedInteropOwnerAlias>>,
//RS     typed_owner: Option<Arc<dyn Any + Send + Sync>>,
//RS     resource_lease_owner: Option<Arc<dyn Any + Send + Sync>>,
//RS     resident_root: bool,
//RS     completion_delivery: Arc<Mutex<Option<SourceSharedInteropCompletionDelivery>>>,
//RS     payload_finalizer_installer: Option<SourceSharedInteropPayloadFinalizerInstaller>,
//RS }
//RS 
//RS #[derive(Clone)]
//RS pub struct SourceSharedInteropWeak {
//RS     type_id: u64,
//RS     identity: usize,
//RS     physical_identity: Option<usize>,
//RS     protocol_order_key: Option<usize>,
