package {
    name: "core.term"
    version: "0.0.1"
    edition: "2026"
    description: "Stdio, prompts, and terminal style."
    license: "MIT"
    outputs: {
        term: .Library{ entry: term }
    }
}
use core as core
// core.term — the connected terminal.
//
// `print` / `eprint` write UTF-8. `input` / `readline` / `read_until` read
// lines. `input_secret` disables echo. `style` is a no-op when stdout is not
// a TTY unless `style_force` is used. Width and height fall back to 80x24.
//
// ANSI SGR parsing is Jet. Byte IO is host (fd 0/1/2).
pub struct Reader {
    pub fd: Int
}

pub struct Writer {
    pub fd: Int
}

pub struct StdinHandle {
    pub fd: Int
}

pub struct Stdout {
    pub fd: Int

    pub fn write(&self, text: String) IOError! -[IO]> {
        stdio_write(text, false, false)
    }
    pub fn write_line(&self, text: String) IOError! -[IO]> {
        stdio_write(text, true, false)
    }
    pub fn write_bytes(&self, bytes: [U8]) IOError! -[IO]> {
        stdio_bytes(bytes, false)
    }
    pub fn flush(&self) IOError! -[IO]> {
        stdio_flush(false)
    }
    pub fn is_tty(&self) -[IO]> Bool Never! {
        core.term.__stdout_terminal()
    }
}

pub struct Stderr {
    pub fd: Int

    pub fn write(&self, text: String) IOError! -[IO]> {
        stdio_write(text, false, true)
    }
    pub fn write_line(&self, text: String) IOError! -[IO]> {
        stdio_write(text, true, true)
    }
    pub fn write_bytes(&self, bytes: [U8]) IOError! -[IO]> {
        stdio_bytes(bytes, true)
    }
    pub fn flush(&self) IOError! -[IO]> {
        stdio_flush(true)
    }
    pub fn is_tty(&self) -[IO]> Bool Never! {
        core.term.__stderr_terminal()
    }
}

// D-TERM1: the one `Key` value `read_key()` answers on every tier.
pub enum Key {
    Char(Char)
    Enter
    Escape
    Backspace
    Tab
    Delete
    Up
    Down
    Left
    Right
    F(Int)
    Ctrl(Char)
    Unknown
}
pub fn print(text: String) Never! -[IO, Time.Wait]> {
    out :: core.term.stdout()
    &out.write_line(text).drop("stdout write")
}

pub fn eprint(text: String) Never! -[IO, Time.Wait]> {
    out :: stderr()
    &out.write("{text}\n").drop("stderr write")
}

pub fn input(prompt: String{""}) -[IO, Time.Wait]> String IOError! {
    core.term.input(prompt)
}

pub fn input_secret(prompt: String) -[IO, Time.Wait]> String IOError! {
    core.term.input_secret(prompt)
}

pub fn read_all_input() -[IO, Time.Wait]> String IOError! { core.term.read_all_input() }

pub fn readline() -[IO, Time.Wait]> String IOError! { core.term.readline() }

pub fn read_until(delimiter: String) -[IO, Time.Wait]> String IOError! {
    if delimiter.len() == 0 -> return Err(term_input_error("read_until", delimiter, "delimiter must not be empty"))
    core.term.read_until(delimiter)
}

pub fn binread(path: String) -[FS, IO, Time.Wait]> [U8] IOError! {
    core.files.read_bytes(path)
}

pub fn binwrite(path: String, bytes: [U8]) IOError! -[FS, IO, Time.Wait]> {
    core.files.write_bytes(path, bytes)
}

pub fn confirm(prompt: String) -[IO, Time.Wait]> Bool Never! {
    answer :: input("{prompt} [y/N] ") ?? ""
    confirm_answer(answer)
}

pub fn choose(prompt: String, options: [String]) -[IO, Time.Wait]> String IOError! {
    if options.len() == 0 -> return Err(term_input_error("choose", prompt, "choose needs at least one item"))
    core.term.choose(prompt, options)
}

pub fn stdin() -> StdinHandle Never! { core.term.stdin() }

pub fn stdout() -> Stdout Never! { Stdout{fd: 1} }

pub fn stderr() -> Stderr Never! { Stderr{fd: 2} }

pub fn buffered() -> StdinHandle Never! { stdin() }

pub fn terminal_width() -[IO]> Int Never! { core.term.terminal_width() }

pub fn terminal_height() -[IO]> Int Never! { core.term.terminal_height() }

pub fn style(style: String, text: String) -[IO]> String Never! { core.term.style(style, text) }

pub fn style_force(style: String, text: String) -> String Never! {
    codes :: sgr(style)
    if codes.len() == 0 -> return ~text
    esc :: String.from_bytes([U8]{27}) ?? ""
    return "{esc}[{codes}m{text}{esc}[0m"
}


pub fn read_key() -[IO, Time.Wait]> Key Never! { core.term.read_key() }

pub struct WinSize {
    pub w: Int
    pub h: Int
}
pub fn progress(label: String) IOError! -[IO, Time.Wait]> { core.term.progress(label) }

fn term_input_error(operation: String, resource: String, cause: String) -> IOError Never! {
    IOError.InvalidInput(IOContext{
        operation: .Read,
        resource: Val(resource),
        os_code: None,
        cause: Val("{operation}: {cause}"),
    })
}

fn confirm_answer(answer: String) -> Bool Never! {
    normalized :: ascii_lower(answer.trim())
    normalized == "y" || normalized == "yes"
}
fn sgr(spec: String) -> String {
    parts := [String]{}
    cur := [U8]{}
    loop b in spec.bytes() {
        if b == (U8{32}) || b == (U8{44}) || b == (U8{59}) {
            token :: ascii_lower(String.from_bytes(cur) ?? "")
            cur = [U8]{}
            code :: token_code(token)
            if code.len() > 0 -> &parts.push(code)
        } else { &cur.push(b) }
    }
    token :: ascii_lower(String.from_bytes(cur) ?? "")
    code :: token_code(token)
    if code.len() > 0 -> &parts.push(code)
    out := ""
    loop i in 0..<parts.len() {
        if i > 0 -> out = "{out};"
        out = "{out}{parts[i]}"
    }
    out
}

fn token_code(token: String) -> String {
    numeric :: parse_int(token) ?? -1
    if numeric >= 0 && numeric <= 109 -> return "{numeric}"
    if token == {
        "bold" -> "1"
        "dim" -> "2"
        "italic" -> "3"
        "underline" -> "4"
        "inverse" | "reverse" -> "7"
        "strike" | "strikethrough" -> "9"
        "black" -> "30"
        "red" -> "31"
        "green" -> "32"
        "yellow" -> "33"
        "blue" -> "34"
        "magenta" -> "35"
        "cyan" -> "36"
        "white" -> "37"
        "bg-black" -> "40"
        "bg-red" -> "41"
        "bg-green" -> "42"
        "bg-yellow" -> "43"
        "bg-blue" -> "44"
        "bg-magenta" -> "45"
        "bg-cyan" -> "46"
        "bg-white" -> "47"
        "reset" -> "0"
        else -> ""
    }
}

fn chomp(text: String) -> String {
    raw :: text.bytes()
    n := raw.len()
    if n > 0 && raw[n - 1] == (U8{10}) -> n = n - 1
    if n > 0 && raw[n - 1] == (U8{13}) -> n = n - 1
    slice_bytes(raw, 0, n)
}

fn slice_bytes(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    i := start
    loop {
        if i >= end -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}

fn ends_with_bytes(hay: [U8], needle: [U8]) -> Bool {
    if needle.len() > hay.len() -> return false
    off :: hay.len() - needle.len()
    loop i in 0..<needle.len() {
        if hay[off + i] != needle[i] -> return false
    }
    true
}

fn ascii_lower(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n :: b
        if n >= 65 && n <= 90 -> &out.push(U8{n + 32}) else -> &out.push(b)
    }
    String.from_bytes(out) ?? text
}

fn parse_int(text: String) -> Int? {
    n := 0
    any := false
    loop b in text.bytes() {
        d :: b
        if d < 48 || d > 57 -> return None
        if n > 922337203685477580 || (n == 922337203685477580 && d > 7) -> return None
        n = n * 10 + (d - 48)
        any = true
    }
    if !any -> return None
    Val(n)
}


fn stdio_error(operation: IOOperation, resource: String, cause: String) -> IOError Never! {
    IOError.Other(IOContext{
        operation: operation,
        resource: Val(resource),
        os_code: None,
        cause: Val(cause),
    })
}

fn stdio_checkpoint(operation: IOOperation, resource: String, selector: String) IOError! {
    if core.term.__stdio_fault(selector) {
        return Err(stdio_error(operation, resource, "fault injected: {selector}"))
    }
    Ok()
}

fn stdio_result(cause: String?, operation: IOOperation, resource: String) IOError! {
    if cause == {
        .Val(text) -> Err(stdio_error(operation, resource, text))
        .None -> Ok()
    }
}

fn stdio_terminal(stderr: Bool) -> Bool Never! {
    if stderr -> return core.term.__stderr_terminal()
    core.term.__stdout_terminal()
}

// Term.rs:152-160,168-176 holds one lock across write_all and flush.
// The raw operation receives this source decision; it never re-decides it.
fn stdio_write(text: String, newline: Bool, stderr: Bool) IOError! -[IO]> {
    resource :: if stderr -> "stderr" else -> "stdout"
    stdio_checkpoint(.Write, resource, "IO.Write")
    flush :: text.len() > 0 || newline || stdio_terminal(stderr)
    stdio_result(core.term.__stdio_write(text, newline, stderr, flush), .Write, resource)
}

fn stdio_bytes(bytes: [U8], stderr: Bool) IOError! -[IO]> {
    resource :: if stderr -> "stderr" else -> "stdout"
    stdio_checkpoint(.Write, resource, "IO.Write")
    flush :: bytes.len() > 0 || stdio_terminal(stderr)
    stdio_result(core.term.__stdio_bytes(bytes, stderr, flush), .Write, resource)
}

fn stdio_flush(stderr: Bool) IOError! -[IO]> {
    resource :: if stderr -> "stderr" else -> "stdout"
    stdio_checkpoint(.Flush, resource, "IO.Flush")
    stdio_result(core.term.__stdio_flush(stderr), .Flush, resource)
}

#Test("stdio source tokens retain declared fields and record equality") {
    assert(stdout().fd == 1 && stderr().fd == 2)
    assert(stdout() == Stdout{fd: 1})
    assert(stderr() == Stderr{fd: 2})
    assert(stdout() != Stdout{fd: 9})
    assert(stderr() != Stderr{fd: 9})
}

#Test("stdio source errors preserve Other, resource, and verbatim cause") {
    if stdio_result(Val("custom Windows console error"), .Write, "stdout") == {
        .Err(error) -> if error == {
            .Other(context) -> {
                assert(context.operation == .Write && context.resource == (Val("stdout")))
                assert(context.os_code == None && context.cause == (Val("custom Windows console error")))
            }
            else -> panic("stdio error kind")
        }
        .Ok(_) -> panic("stdio failure must be reported")
    }
    stdio_result(None, .Flush, "stderr").drop("successful raw flush")
}

#Test("confirmation accepts only an ASCII case-insensitive yes") {
    assert(confirm_answer(" y "))
    assert(confirm_answer(" YeS\t"))
    assert(!confirm_answer(""))
    assert(!confirm_answer("no"))
    assert(!confirm_answer("yés"))
}
