// Rust: crates/jet-codegen/src/Prelude/Term.rs:332
pub fn jet_term_input_secret(prompt: &String, write: fn(&String) -> () Err!, read: fn() -> JetTermRead Err!) -> String JetTermSecretError! {
    jet_term_secret_preflight(jet_term_stdin_is_terminal(), jet_term_stdout_is_terminal())?
    write(prompt).map_err(JetTermSecretError.Flush)?
    if !jet_term_mode_enter(false) { _ :: write("\n"); return Err(JetTermSecretError.Echo) }
