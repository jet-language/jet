// Rust: crates/jet-codegen/src/Prelude/Term.rs:265
pub fn jet_term_style(style: &String, text: &String, enabled: Bool) -> String {
    if enabled { jet_term_style_force(style, text) } else { text.to_string() }
}
// Rust: crates/jet-codegen/src/Prelude/Term.rs:273
pub fn jet_term_style_force(style: &String, text: &String) -> String {
    code :: match style {
        "black" -> Val("30"), "red" -> Val("31"), "green" -> Val("32"), "yellow" -> Val("33"),
        "blue" -> Val("34"), "magenta" -> Val("35"), "cyan" -> Val("36"), "white" -> Val("37"),
        "bold" -> Val("1"), "dim" -> Val("2"), _ -> None,
    }
    code.map_or_else(fn() { text.to_string() }, fn(code) { "\x1b[{code}m{text}\x1b[0m" })
}
