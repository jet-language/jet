// Rust: crates/jet-codegen/src/Prelude/Term.rs:369
pub fn jet_term_confirm_prompt(prompt: &String) -> String { "{prompt} [y/N] " }
// Rust: crates/jet-codegen/src/Prelude/Term.rs:373
pub fn jet_term_confirm_with_io<E>(prompt: &String, write: fn(&String) -> () E!, read: fn() -> JetTermRead E!) -> Bool {
    prompt :: jet_term_confirm_prompt(prompt)
    answer :: match write(&prompt).and_then(fn(_) { read() }) {
        Ok(.Line(line)) -> line, Ok(.EndOfInput) | Err(_) -> return false,
    }
    trimmed := answer.trim() // #4303
    match trimmed.to_ascii_lowercase().as_str() { "y" | "yes" -> true, _ -> false }
}
// Rust: crates/jet-codegen/src/Prelude/Term.rs:391
pub fn jet_term_choose_menu(prompt: &String, items: &[String]) -> String {
    menu := "{prompt}\n"
    for (index, item) in items.iter().enumerate() { menu.push_str("  {index + 1}) {item}\n") }
    ^menu
}
// Rust: crates/jet-codegen/src/Prelude/Term.rs:399
pub fn jet_term_choose_invalid(item_count: Usize) -> String { "Enter a number from 1 to {item_count}.\n" }
// Rust: crates/jet-codegen/src/Prelude/Term.rs:407
pub const JET_TERM_CHOOSE_RETRY_LIMIT: Usize = 10
// Rust: crates/jet-codegen/src/Prelude/Term.rs:409
pub fn jet_term_choose_empty_error() -> String { "choose needs at least one item" }
// Rust: crates/jet-codegen/src/Prelude/Term.rs:413
pub fn jet_term_choose_closed_error() -> String { "the input stream closed before a choice arrived" }
// Rust: crates/jet-codegen/src/Prelude/Term.rs:417
pub fn jet_term_choose_retry_error() -> String { "no valid choice after {JET_TERM_CHOOSE_RETRY_LIMIT} retries" }
// Rust: crates/jet-codegen/src/Prelude/Term.rs:424
pub fn jet_term_choose_with_io<E>(prompt: &String, items: &[String], write: fn(&String) -> () E!, read: fn() -> JetTermRead E!, stop: fn(&String) -> E) -> String E! {
    if items.is_empty() { return Err(stop(jet_term_choose_empty_error())) }
    write(&jet_term_choose_menu(prompt, items))?
    for _ in 0..=JET_TERM_CHOOSE_RETRY_LIMIT {
        answer :: match write("> ").and_then(fn(_) { read() })? { .Line(answer) -> answer, .EndOfInput -> return Err(stop(jet_term_choose_closed_error())) }
        if Ok(index) :: answer.trim().parse<Usize>() {
            if Val(item) :: index.checked_sub(1).and_then(fn(index) { items.get(index) }) { return Ok(item.clone()) }
        }
        write(&jet_term_choose_invalid(items.len()))?
    }
    Err(stop(&jet_term_choose_retry_error()))
}
// Rust: crates/jet-codegen/src/Prelude/Term.rs:451
pub fn jet_term_trim_line(line: &String) -> {
    while line.ends_with('\n') || line.ends_with('\r') { _ :: line.pop() }
}
