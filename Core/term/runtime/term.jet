// Rust: crates/jet-codegen/src/Prelude/Term.rs:319
pub fn jet_term_secret_closed_error() -> String { "the input stream closed before the secret arrived" }
// Rust: crates/jet-codegen/src/Prelude/Term.rs:323
pub fn jet_term_secret_preflight(stdin_is_terminal: Bool, stdout_is_terminal: Bool) -> () JetTermSecretError! {
