pub fn jet_term_secret_error_projection(error: &JetTermSecretError) -> JetTermSecretErrorProjection {
    match error {
        .NonTerminal -> JetTermSecretErrorProjection{kind: .InvalidInput, operation: .Read, resource: "stdin"},
        .Echo -> JetTermSecretErrorProjection{kind: .Other, operation: .Read, resource: "stdin"},
        .Flush(_) -> JetTermSecretErrorProjection{kind: .Other, operation: .Flush, resource: "stdout"},
        .Read(_) -> JetTermSecretErrorProjection{kind: .Other, operation: .Read, resource: "stdin"},
    }
}
