//RS /// The name of the one process-wide fact below. The CLI sets it; every mirror
//RS /// of this file reads it, so no tier carries a second switch to keep in step.
//RS pub(crate) const JET_TERM_PROGRAM_OWNS_STREAMS: &str = "JET_PROGRAM_OWNS_STREAMS";
//RS /// Machine mode is set by the CLI before an in-process tier starts.  Human
//RS /// progress and decoration must never enter that stream.
//RS pub(crate) const JET_TERM_MACHINE_OUTPUT: &str = "JET_MACHINE_OUTPUT";
//RS 
//RS pub(crate) fn jet_term_machine_output() -> bool {
//RS     std::env::var_os(JET_TERM_MACHINE_OUTPUT).is_some_and(|value| value == "1")
//RS }
//RS 
//RS 
//RS /// Does the running program own the process's stdout and stderr?
//RS ///
//RS /// An AOT program always does: it writes its own streams and nothing reads them
//RS /// back. The two in-process tiers do not by default, because an embedder — the
//RS /// REPL, a notebook cell, `dev_iteration` in a golden harness — consumes the
//RS /// run's output from `RunOutcome` as data, so their adapters must accumulate it
//RS /// instead of writing it. The one-shot `jet run` / `jet dev` verbs are not
//RS /// embedders: they re-print that buffer verbatim and nothing else consumes it,
//RS /// so they hand the streams to the program and say so here.
//RS ///
//RS /// Terminal detection alone could not answer this. It said "not mine" for every
//RS /// piped run, so the in-process tiers withheld a piped program's output until
//RS /// the run ENDED: a program that prints and keeps running — a server, a watch
//RS /// loop, anything with a `loop` — printed nothing that an AOT build of the same
//RS /// source printed immediately, and nothing outside the process could ever
//RS /// synchronise with a program while it ran.
//RS pub(crate) fn jet_term_program_owns_streams() -> bool {
//RS     *JET_TERM_PROGRAM_OWNS_STREAMS_FACT
//RS }
//RS 
//RS /// The fact is read once: the CLI decides it before the program starts, and a
//RS /// run cannot change hands halfway through its own output.
//RS static JET_TERM_PROGRAM_OWNS_STREAMS_FACT: std::sync::LazyLock<bool> =
//RS     std::sync::LazyLock::new(|| {
//RS         std::env::var_os(JET_TERM_PROGRAM_OWNS_STREAMS).is_some_and(|value| value == "1")
//RS     });
//RS 
//RS /// Where a program write goes: the real stream, or the caller's buffer. Framing
//RS /// decisions keep asking `jet_term_*_is_terminal` — a pipe still gets no
//RS /// carriage-return progress frames when the program owns it.
//RS pub(crate) fn jet_term_stdout_is_program_stream() -> bool {
//RS     jet_term_stdout_is_terminal() || jet_term_program_owns_streams()
//RS }
//RS 
//RS pub(crate) fn jet_term_stderr_is_program_stream() -> bool {
//RS     jet_term_stderr_is_terminal() || jet_term_program_owns_streams()
//RS }
