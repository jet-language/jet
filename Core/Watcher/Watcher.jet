package: {
    name: "core.watcher"
    version: "0.0.1"
    edition: "2026"
    description: "Filesystem, process, and port watches."
    license: "MIT"
    outputs: {
        watcher: .Library{ entry: watcher }
    }
}

use core: core


files: fn(path: String) -[FS]> WatchHandle IOError! {
    core.watcher.__files(path)
}

process_pid: fn(pid: Int) -> WatchHandle Never! {
    core.watcher.__process_pid(pid)
}

port: fn(host: String, port: Int) -[Net]> WatchHandle Never! {
    core.watcher.__port(host, port)
}

set: fn() -> WatchSet Never! { core.watcher.__set() }


add: fn(set: WatchSet, handle: WatchHandle) -[IO]> WatchSet Never! {
    set.add(handle)
    set.copy()
}

remove: fn(set: WatchSet, target: String) -> WatchSet IOError! {
    if target.len() == 0 {
        return Err(IOError.InvalidInput(IOContext{
            operation: .Resolve,
            resource: Val(target),
            os_code: None,
            cause: Val("empty target"),
        }))
    }
    Err(IOError.Other(IOContext{
        operation: .Resolve,
        resource: Val(target),
        os_code: None,
        cause: Val("watch sets do not support removal"),
    }))
}

contains: fn(set: WatchSet, target: String) -> Bool IOError! {
    if target.len() == 0 -> return Ok(false)
    Err(IOError.Other(IOContext{
        operation: .Resolve,
        resource: Val(target),
        os_code: None,
        cause: Val("watch sets do not expose target lookup"),
    }))
}

len: fn(set: WatchSet) -> Int Never! {
    summary_count(set.summary())
}

kind: fn(handle: WatchHandle) -> String Never! {
    summary_kind(handle.summary())
}

target: fn(handle: WatchHandle) -> String Never! {
    summary_target(handle.summary())
}


WatchDomain: enum {
    File
    Process
    Port

    impl Equatable {
        equal: fn(self, rhs: WatchDomain) -> Bool { watch_domain_tag(self) == watch_domain_tag(rhs) }
    }
}

WatchEventKind: enum {
    Created
    Modified
    Removed
    Error
    Exited
    Ready
}

// WatchEvent.kind has always exposed WatchKind in checked programs. The
// independently exported WatchEventKind above remains a distinct public enum.
WatchKind: enum {
    Created
    Modified
    Removed
    Error
    Exited
    Ready

    impl Equatable {
        equal: fn(self, rhs: WatchKind) -> Bool { watch_kind_tag(self) == watch_kind_tag(rhs) }
    }
}

watch_domain_tag: fn(value: WatchDomain) -> Int Never! {
    if value == {
        .File -> 0
        .Process -> 1
        .Port -> 2
    }
}
watch_kind_tag: fn(value: WatchKind) -> Int Never! {
    if value == {
        .Created -> 0
        .Modified -> 1
        .Removed -> 2
        .Error -> 3
        .Exited -> 4
        .Ready -> 5
    }
}
watch_domain_name: fn(value: WatchDomain) -> String Never! {
    if value == {
        .File -> "File"
        .Process -> "Process"
        .Port -> "Port"
    }
}
watch_kind_name: fn(value: WatchKind) -> String Never! {
    if value == {
        .Created -> "Created"
        .Modified -> "Modified"
        .Removed -> "Removed"
        .Error -> "Error"
        .Exited -> "Exited"
        .Ready -> "Ready"
    }
}
WatchEvent: struct {
    domain: WatchDomain
    kind: WatchKind
    path: String
    detail: String
    pid: Int
    port: Int

    __show: fn(self) -> String Never! {
        "WatchEvent {{ domain: {watch_domain_name(self.domain)}, kind: {watch_kind_name(self.kind)}, path: {self.path}, detail: {self.detail} }}"
    }
    __debug: fn(self) -> String Never! {
        "WatchEvent {{ domain: {watch_domain_name(self.domain)}, kind: {watch_kind_name(self.kind)}, path: {self.path:Debug}, detail: {self.detail:Debug}, pid: {self.pid}, port: {self.port} }}"
    }

    impl Equatable {
        equal: fn(self, rhs: WatchEvent) -> Bool {
            self.domain == rhs.domain && self.kind == rhs.kind && self.path == rhs.path &&
            self.detail == rhs.detail && self.pid == rhs.pid && self.port == rhs.port
        }
    }
}
watch_domain_of: fn(target: Int) -> WatchDomain Never! {
    if {
        target == 1 -> WatchDomain.Process
        target == 2 -> WatchDomain.Port
        else -> WatchDomain.File
    }
}

watch_kind_named: fn(name: String) -> WatchKind Never! {
    if {
        name == "Created" -> WatchKind.Created
        name == "Modified" -> WatchKind.Modified
        name == "Removed" -> WatchKind.Removed
        name == "Error" -> WatchKind.Error
        name == "Exited" -> WatchKind.Exited
        else -> WatchKind.Ready
    }
}

// WatchHandle: a shared watch whose poll diffs its target and hands each event
// to the handle's own Event<WatchEvent>. The runtime answers three texts per
// event (kind, path, detail); the domain, pid and port come from the handle's
// target.
impl WatchHandle {
    poll: fn(self) -[IO]> [WatchEvent] Never! {
        texts: core.watcher.__poll(self)
        target: core.watcher.__target(self)
        number: core.watcher.__number(self)
        pid: if target == 1 -> number else -> 0
        port: if target == 2 -> number else -> 0
        bus: core.watcher.__event(self)
        out := [WatchEvent]{}
        at := 0
        loop at + 2 < texts.len() {
            ev: WatchEvent{domain: watch_domain_of(target), kind: watch_kind_named(texts[at]), path: texts[at + 1], detail: texts[at + 2], pid: pid, port: port}
            out.push(ev.copy())
            _ := bus.emit(ev)
            at = at + 3
        }
        out
    }

    events: fn(self) -[IO]> [WatchEvent] Never! { self.poll() }

    on: fn(self, scope: EventScope, handler: fn(WatchEvent)) -> Subscription Never! {
        core.watcher.__event(self).on(scope, handler)
    }

    once: fn(self, scope: EventScope, handler: fn(WatchEvent)) -> Subscription Never! {
        core.watcher.__event(self).once(scope, handler)
    }

    cancel: fn(self) Never! -[IO]> { core.watcher.__cancel(self) }

    is_active: fn(self) -> Bool Never! { core.watcher.__is_active(self) }

    summary: fn(self) -> String Never! {
        target: core.watcher.__target(self)
        if target == 1 -> return "watch process {core.watcher.__number(self)}"
        if target == 2 -> return "watch port {core.watcher.__text(self)}:{core.watcher.__number(self)}"
        "watch file {core.watcher.__text(self)}"
    }
}

// WatchSet: a shared list of handles polled in order.
impl WatchSet {
    add: fn(self, handle: WatchHandle) Never! -[IO]> { core.watcher.__set_add(self, handle) }

    poll: fn(self) -[IO]> [WatchEvent] Never! {
        out := [WatchEvent]{}
        loop index in 0..<core.watcher.__set_len(self) {
            loop ev in core.watcher.__set_get(self, index).poll() -> out.push(ev)
        }
        out
    }

    events: fn(self) -[IO]> [WatchEvent] Never! { self.poll() }

    summary: fn(self) -> String Never! { "watchset handles={core.watcher.__set_len(self)}" }
}

#Test("WatchEvent source layout keeps all fields and independent copies") {
    event: WatchEvent{domain: .Process, kind: .Exited, path: "p", detail: "gone", pid: -1, port: 65535}
    cloned_event := event.copy()
    assert(event.equal(cloned_event))
    cloned_event.path = "changed"
    assert_eq(event.path, "p")
    assert(!event.equal(cloned_event))
    assert_eq(event.pid, -1)
    assert_eq(event.port, 65535)
    assert_eq(watch_domain_tag(event.domain), 1)
    assert_eq(watch_kind_tag(event.kind), 4)
    assert_eq(event.__show(), "WatchEvent {{ domain: Process, kind: Exited, path: p, detail: gone }}")
    assert_eq(event.__debug(), "WatchEvent {{ domain: Process, kind: Exited, path: \"p\", detail: \"gone\", pid: -1, port: 65535 }}")
}

#Test("WatchEvent enum tags retain the native order and old exported enum") {
    assert_eq(watch_domain_tag(.File), 0)
    assert_eq(watch_domain_tag(.Port), 2)
    assert_eq(watch_kind_tag(.Created), 0)
    assert_eq(watch_kind_tag(.Modified), 1)
    assert_eq(watch_kind_tag(.Removed), 2)
    assert_eq(watch_kind_tag(.Error), 3)
    assert_eq(watch_kind_tag(.Ready), 5)
    old: WatchEventKind.Ready
    ready: if old == {
        .Ready -> true
        .Created | .Modified | .Removed | .Error | .Exited -> false
    }
    assert(ready)
}

recursive: fn(path: String) -[FS]> WatchHandle IOError! {
    // The host file watcher already snapshots directories recursively.
    files(path)
}

debounce: fn(handle: WatchHandle, ms: Int) -> WatchHandle IOError! {
    if ms < 0 {
        return Err(IOError.InvalidInput(IOContext{
            operation: .Resolve,
            resource: Val(target(handle)),
            os_code: None,
            cause: Val("negative debounce interval"),
        }))
    }
    Err(IOError.Other(IOContext{
        operation: .Resolve,
        resource: Val(target(handle)),
        os_code: None,
        cause: Val("debounce is not supported by the host watcher"),
    }))
}

poll: fn(handle: WatchHandle) -[IO]> [WatchEvent] Never! { handle.poll() }

events: fn(handle: WatchHandle) -[IO]> [WatchEvent] Never! { handle.events() }

cancel: fn(handle: WatchHandle) Never! -[IO]> { handle.cancel() }

is_active: fn(handle: WatchHandle) -> Bool Never! { handle.is_active() }

summary: fn(handle: WatchHandle) -> String Never! { handle.summary() }

drain: fn(set: WatchSet) -[IO]> [WatchEvent] Never! { set.poll() }

summary_kind: fn(text: String) -> String {
    if has_prefix(text, "watch file ") -> return "file"
    if has_prefix(text, "watch process ") -> return "process"
    if has_prefix(text, "watch port ") -> return "port"
    "watch"
}

summary_target: fn(text: String) -> String Never! {
    if has_prefix(text, "watch file ") -> return suffix(text, 11)
    if has_prefix(text, "watch process ") -> return suffix(text, 14)
    if has_prefix(text, "watch port ") -> return suffix(text, 11)
    ""
}

summary_count: fn(text: String) -> Int {
    seen := false
    n := 0
    loop b in text.bytes() {
        if seen {
            if b < 48 || b > 57 -> return n
            n = n * 10 + (b - 48)
        } else if b == 61 {
            seen = true
        }
    }
    n
}

has_prefix: fn(text: String, prefix: String) -> Bool Never! {
    raw := text.bytes()
    want := prefix.bytes()
    if want.len() > raw.len() -> return false
    loop i in 0..<want.len() {
        if raw[i] != want[i] -> return false
    }
    true
}

suffix: fn(text: String, start: Int) -> String Never! {
    raw := text.bytes()
    out := [U8]{}
    i := start
    loop {
        if i >= raw.len() -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i = i + 1
    }
}

