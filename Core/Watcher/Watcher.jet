package {
    name: "core.watcher"
    version: "0.0.1"
    edition: "2026"
    description: "Filesystem, process, and port watches."
    license: "MIT"
    outputs: {
        watcher: .Library{ entry: watcher }
    }
}

use core as core


fn files(path: String) -[FS]> WatchHandle IOError! {
    core.watcher.__files(path)
}

fn process_pid(pid: Int) -> WatchHandle Never! {
    core.watcher.__process_pid(pid)
}

fn port(host: String, port: Int) -[Net]> WatchHandle Never! {
    core.watcher.__port(host, port)
}

fn set() -> WatchSet Never! { core.watcher.__set() }


fn add(set: WatchSet, handle: WatchHandle) -[IO]> WatchSet Never! {
    set.add(handle)
    set.copy()
}

fn remove(set: WatchSet, target: String) -> WatchSet IOError! {
    if target.len() == 0 {
        return Err(IOError.InvalidInput(IOContext{
            operation: .Resolve,
            resource: Val(target),
            os_code: None,
            cause: Val("empty target"),
        }))
    }
    Err(IOError.Other(IOContext{
        operation: .Resolve,
        resource: Val(target),
        os_code: None,
        cause: Val("watch sets do not support removal"),
    }))
}

fn contains(set: WatchSet, target: String) -> Bool IOError! {
    if target.len() == 0 -> return Ok(false)
    Err(IOError.Other(IOContext{
        operation: .Resolve,
        resource: Val(target),
        os_code: None,
        cause: Val("watch sets do not expose target lookup"),
    }))
}

fn len(set: WatchSet) -> Int Never! {
    summary_count(set.summary())
}

fn kind(handle: WatchHandle) -> String Never! {
    summary_kind(handle.summary())
}

fn target(handle: WatchHandle) -> String Never! {
    summary_target(handle.summary())
}


enum WatchDomain {
    File
    Process
    Port
}

enum WatchEventKind {
    Created
    Modified
    Removed
    Error
    Exited
    Ready
}

// WatchEvent.kind has always exposed WatchKind in checked programs. The
// independently exported WatchEventKind above remains a distinct public enum.
enum WatchKind {
    Created
    Modified
    Removed
    Error
    Exited
    Ready
}

fn watch_domain_tag(value: WatchDomain) -> Int Never! {
    if value == {
        .File -> 0
        .Process -> 1
        .Port -> 2
    }
}
fn watch_kind_tag(value: WatchKind) -> Int Never! {
    if value == {
        .Created -> 0
        .Modified -> 1
        .Removed -> 2
        .Error -> 3
        .Exited -> 4
        .Ready -> 5
    }
}
fn watch_domain_name(value: WatchDomain) -> String Never! {
    if value == {
        .File -> "File"
        .Process -> "Process"
        .Port -> "Port"
    }
}
fn watch_kind_name(value: WatchKind) -> String Never! {
    if value == {
        .Created -> "Created"
        .Modified -> "Modified"
        .Removed -> "Removed"
        .Error -> "Error"
        .Exited -> "Exited"
        .Ready -> "Ready"
    }
}
impl WatchDomain.Equatable {
    fn equal(self, rhs: WatchDomain) -> Bool { watch_domain_tag(self) == watch_domain_tag(rhs) }
}
impl WatchKind.Equatable {
    fn equal(self, rhs: WatchKind) -> Bool { watch_kind_tag(self) == watch_kind_tag(rhs) }
}

struct WatchEvent {
    domain: WatchDomain
    kind: WatchKind
    path: String
    detail: String
    pid: Int
    port: Int
}

impl WatchEvent {
    fn __show(self) -> String Never! {
        "WatchEvent {{ domain: {watch_domain_name(self.domain)}, kind: {watch_kind_name(self.kind)}, path: {self.path}, detail: {self.detail} }}"
    }
    fn __debug(self) -> String Never! {
        "WatchEvent {{ domain: {watch_domain_name(self.domain)}, kind: {watch_kind_name(self.kind)}, path: {self.path:Debug}, detail: {self.detail:Debug}, pid: {self.pid}, port: {self.port} }}"
    }
}
impl WatchEvent.Equatable {
    fn equal(self, rhs: WatchEvent) -> Bool {
        self.domain == rhs.domain && self.kind == rhs.kind && self.path == rhs.path &&
        self.detail == rhs.detail && self.pid == rhs.pid && self.port == rhs.port
    }
}

#Test("WatchEvent source layout keeps all fields and independent copies") {
    event :: WatchEvent{domain: .Process, kind: .Exited, path: "p", detail: "gone", pid: -1, port: 65535}
    cloned_event := event.copy()
    assert(event.equal(cloned_event))
    cloned_event.path = "changed"
    assert_eq(event.path, "p")
    assert(!event.equal(cloned_event))
    assert_eq(event.pid, -1)
    assert_eq(event.port, 65535)
    assert_eq(watch_domain_tag(event.domain), 1)
    assert_eq(watch_kind_tag(event.kind), 4)
    assert_eq(event.__show(), "WatchEvent {{ domain: Process, kind: Exited, path: p, detail: gone }}")
    assert_eq(event.__debug(), "WatchEvent {{ domain: Process, kind: Exited, path: \"p\", detail: \"gone\", pid: -1, port: 65535 }}")
}

#Test("WatchEvent enum tags retain the native order and old exported enum") {
    assert_eq(watch_domain_tag(.File), 0)
    assert_eq(watch_domain_tag(.Port), 2)
    assert_eq(watch_kind_tag(.Created), 0)
    assert_eq(watch_kind_tag(.Modified), 1)
    assert_eq(watch_kind_tag(.Removed), 2)
    assert_eq(watch_kind_tag(.Error), 3)
    assert_eq(watch_kind_tag(.Ready), 5)
    old :: WatchEventKind.Ready
    ready :: if old == {
        .Ready -> true
        else -> false
    }
    assert(ready)
}

fn recursive(path: String) -[FS]> WatchHandle IOError! {
    // The host file watcher already snapshots directories recursively.
    files(path)
}

fn debounce(handle: WatchHandle, ms: Int) -> WatchHandle IOError! {
    if ms < 0 {
        return Err(IOError.InvalidInput(IOContext{
            operation: .Resolve,
            resource: Val(target(handle)),
            os_code: None,
            cause: Val("negative debounce interval"),
        }))
    }
    Err(IOError.Other(IOContext{
        operation: .Resolve,
        resource: Val(target(handle)),
        os_code: None,
        cause: Val("debounce is not supported by the host watcher"),
    }))
}

fn poll(handle: WatchHandle) -[IO]> [WatchEvent] Never! { handle.poll() }

fn events(handle: WatchHandle) -[IO]> [WatchEvent] Never! { handle.events() }

fn cancel(handle: WatchHandle) Never! -[IO]> { handle.cancel() }

fn is_active(handle: WatchHandle) -> Bool Never! { handle.is_active() }

fn summary(handle: WatchHandle) -> String Never! { handle.summary() }

fn drain(set: WatchSet) -[IO]> [WatchEvent] Never! { set.poll() }

fn summary_kind(text: String) -> String {
    if has_prefix(text, "watch file ") -> return "file"
    if has_prefix(text, "watch process ") -> return "process"
    if has_prefix(text, "watch port ") -> return "port"
    "watch"
}

fn summary_target(text: String) -> String Never! {
    if has_prefix(text, "watch file ") -> return suffix(text, 11)
    if has_prefix(text, "watch process ") -> return suffix(text, 14)
    if has_prefix(text, "watch port ") -> return suffix(text, 11)
    ""
}

fn summary_count(text: String) -> Int {
    seen := false
    n := 0
    loop b in text.bytes() {
        if seen {
            if b < 48 || b > 57 -> return n
            n = n * 10 + (b - 48)
        } else if b == 61 {
            seen = true
        }
    }
    n
}

fn has_prefix(text: String, prefix: String) -> Bool Never! {
    raw := text.bytes()
    want := prefix.bytes()
    if want.len() > raw.len() -> return false
    loop i in 0..<want.len() {
        if raw[i] != want[i] -> return false
    }
    true
}

fn suffix(text: String, start: Int) -> String Never! {
    raw := text.bytes()
    out := [U8]{}
    i := start
    loop {
        if i >= raw.len() -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}

