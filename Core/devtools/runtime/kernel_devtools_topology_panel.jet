// DevtoolsTopologyPanel.rs:1-1807. Sole bounded topology owner (#2454).
// Main publishes this private fragment and the Foundation Devtools dependencies.
// Facts intentionally contain no credentials, authority proof or opaque handles.
// #4392/#4318: retaining projections and Unicode byte views need canonical loans;
// bootstrap utf8_bytes still materializes bytes. No native/allocation proof claimed.
use jet_foundation.Devtools.Observation as topology_event
use jet_foundation.Encoding.Json as topology_json
use core.text.runtime.kernel_unicode_string as topology_text
use core.text.runtime.unicode_assets as topology_assets
use core.text.runtime.assets.unicode_white_space as topology_whitespace

// Rust constants :10-15; byte lengths, never scalar lengths.
pub JET_DEVTOOLS_TOPOLOGY_MAX_FACTS :: 256
pub JET_DEVTOOLS_TOPOLOGY_MAX_RESTARTS :: 64
JET_DEVTOOLS_TOPOLOGY_MAX_TEXT_BYTES :: 256
JET_DEVTOOLS_TOPOLOGY_MAX_RESTART_BUDGET :: U32{1000}
JET_DEVTOOLS_TOPOLOGY_MAX_RESTART_WINDOW_MS :: U64{86400000}
JET_DEVTOOLS_TOPOLOGY_MAX_BYTES :: U64{1099511627776}

// Rust :18-59. Typed topology errors are distinct from protocol Err! strings.
#Error
pub enum JetDevtoolsTopologyError {
    TooManyFacts
    TooManyRestarts(id: String)
    DuplicateIdentity(id: String)
    InvalidText(field: String)
    InvalidEndpointAddress
    InvalidRestartHistory(id: String)
    InvalidRestartPolicy(id: String)
    InvalidByteCount(id: String)
    Cycle(id: String)
    MissingParent(child_id: String, parent_id: String)
    UnknownRoot(id: String)
}
impl JetDevtoolsTopologyError {
    // Rust Display::fmt :33.
    pub fn show(self) -> String Never! {
        if self == {
            .TooManyFacts -> "topology fact limit exceeded"
            .TooManyRestarts(id) -> "restart history limit exceeded for `{id}`"
            .DuplicateIdentity(id) -> "duplicate topology identity `{id}`"
            .InvalidText(field) -> "invalid topology {field}"
            .InvalidEndpointAddress -> "invalid topology endpoint address"
            .InvalidRestartHistory(id) -> "invalid restart history for `{id}`"
            .InvalidRestartPolicy(id) -> "invalid restart policy for `{id}`"
            .InvalidByteCount(id) -> "invalid endpoint byte count for `{id}`"
            .Cycle(id) -> "topology cycle at `{id}`"
            .MissingParent(child, parent) -> "topology parent `{parent}` for `{child}` is missing"
            .UnknownRoot(id) -> "unknown topology root `{id}`"
        }
    }
}
