// Rust :206-235,303-307,327-359.
pub struct JetDevtoolsTopologyRestartPolicy {
    pub strategy: JetDevtoolsTopologyRestartStrategy
    pub max_restarts: U32
    pub window_ms: U64
}
impl JetDevtoolsTopologyRestartPolicy {
    pub fn new(strategy: JetDevtoolsTopologyRestartStrategy, max_restarts: U32, window_ms: U64) -> JetDevtoolsTopologyRestartPolicy JetDevtoolsTopologyError! {
        policy :: JetDevtoolsTopologyRestartPolicy{strategy: strategy, max_restarts: max_restarts, window_ms: window_ms}
        jet_devtools_topology_validate_restart_policy(policy, "<policy>") ?? return Err(err)
        policy
    }
    pub fn render_json(self) -> String Never! {
        strategy :: jet_devtools_topology_json_string(self.strategy.as_str())
        "{{\"strategy\":{strategy},\"max_restarts\":{self.max_restarts},\"window_ms\":{self.window_ms}}}"
    }
}
pub struct JetDevtoolsTopologyRestartFact { pub at_ms: U64, pub duration_ms: U64, pub reason: JetDevtoolsTopologyRestartReason }
pub struct JetDevtoolsTopologyFreshness { pub state: JetDevtoolsTopologyFreshnessState, pub observed_at_ms: U64 }
impl JetDevtoolsTopologyFreshness {
    pub fn fresh(at: U64) -> JetDevtoolsTopologyFreshness Never! { JetDevtoolsTopologyFreshness{state: .Fresh, observed_at_ms: at} }
    pub fn stale(at: U64) -> JetDevtoolsTopologyFreshness Never! { JetDevtoolsTopologyFreshness{state: .Stale, observed_at_ms: at} }
    pub fn unknown(at: U64) -> JetDevtoolsTopologyFreshness Never! { JetDevtoolsTopologyFreshness{state: .Unknown, observed_at_ms: at} }
    pub fn default() -> JetDevtoolsTopologyFreshness Never! { JetDevtoolsTopologyFreshness.unknown(U64{0}) }
}

// Rust :409-469. Constructors move all caller-owned fact payloads.
pub struct JetDevtoolsTopologySupervisorFact {
    pub id: String
    pub source: String
    pub parent_id: String?
    pub state: JetDevtoolsTopologySupervisorState
    pub restart_history: [JetDevtoolsTopologyRestartFact]
    pub owner: String?
    pub restart_policy: JetDevtoolsTopologyRestartPolicy?
    pub failure: JetDevtoolsTopologyFailureKind?
    pub duration_ms: U64?
    pub freshness: JetDevtoolsTopologyFreshness
}
impl JetDevtoolsTopologySupervisorFact {
    pub fn new(id: ^String, source: ^String, parent_id: ^String?, state: JetDevtoolsTopologySupervisorState, restart_history: ^[JetDevtoolsTopologyRestartFact], freshness: JetDevtoolsTopologyFreshness) -> JetDevtoolsTopologySupervisorFact JetDevtoolsTopologyError! {
        fact :: JetDevtoolsTopologySupervisorFact{id: ^id, source: ^source, parent_id: ^parent_id, state: state, restart_history: ^restart_history, owner: None, restart_policy: None, failure: None, duration_ms: None, freshness: freshness}
        jet_devtools_topology_validate_supervisor(fact) ?? return Err(err)
        fact
    }
    pub fn with_owner(^self, owner: ^String) -> JetDevtoolsTopologySupervisorFact Never! {
        fact := ^self
        fact.owner = Val(^owner)
        fact
    }
    pub fn with_restart_policy(^self, policy: ^JetDevtoolsTopologyRestartPolicy) -> JetDevtoolsTopologySupervisorFact Never! {
        fact := ^self
        fact.restart_policy = Val(^policy)
        fact
    }
    pub fn with_failure(^self, failure: JetDevtoolsTopologyFailureKind) -> JetDevtoolsTopologySupervisorFact Never! {
        fact := ^self
        fact.failure = Val(failure)
        fact
    }
    pub fn with_duration_ms(^self, duration_ms: U64) -> JetDevtoolsTopologySupervisorFact Never! {
        fact := ^self
        fact.duration_ms = Val(duration_ms)
        fact
    }
    // Rust :794. Protocol errors preserve their exact original message.
    pub fn to_protocol_event(self, source: ^String) -> topology_event.JetDevtoolsEvent Err! {
        jet_devtools_topology_validate_supervisor(self) ?? return Err(err.show())
        jet_devtools_topology_event(self.freshness.observed_at_ms, ^source, "Supervisor", self.id, jet_devtools_topology_supervisor_fields(self))
    }
}
