            &values.push(jet_devtools_request_panel_object([String]{name, "{key}:{rendered}"}))
        }
    }
    if values.is_empty() -> return Ok(None)
    Ok(Val("[{values.join(",")}]"))
}
fn jet_devtools_request_panel_source_frames(frames: [JetDevtoolsSourceFrame]) -> String Err! {
    values := [String]{}
    loop frame in frames -> &values.push(jet_devtools_request_panel_source_frame_fields(frame) ?? return Err(err))
    Ok("[{values.join(",")}]")
}
fn jet_devtools_request_panel_payload(values: [(String, (@d.JetDevtoolsValue)?)]) -> String? Err! {
    fields := [String]{}
    loop (key, optional) in values {
        if optional == .Val(value) {
            name :: jet_devtools_request_panel_json_string(key) ?? return Err(err)
            rendered :: jet_devtools_request_panel_value_json(value) ?? return Err(err)
            &fields.push("{name}:{rendered}")
        }
    }
    if fields.is_empty() -> return Ok(None)
    Ok(Val(jet_devtools_request_panel_object(fields)))
}
fn jet_devtools_request_panel_value_json(value: d.JetDevtoolsValue) -> String Err! {
    out := [U8]{}
    d.render_value(value, &out) ?? return Err(err)
    Ok(String.from_bytes(out) ?? panic("devtools value writer preserves UTF-8"))
}
fn jet_devtools_request_panel_text_field(key: String, value: String) -> String Err! {
    name :: jet_devtools_request_panel_json_string(key) ?? return Err(err)
    rendered :: jet_devtools_request_panel_json_string(value) ?? return Err(err)
    Ok("{name}:{rendered}")
}
fn jet_devtools_request_panel_u64_field(key: String, value: U64) -> String Never! { "\"{key}\":{value}" }
fn jet_devtools_request_panel_bool_field(key: String, value: Bool) -> String Never! {
    rendered :: if value -> "true" else -> "false"
    "\"{key}\":{rendered}"
}
fn jet_devtools_request_panel_freshness(freshness: JetDevtoolsRequestPanelFreshness) -> String Never! {
    if freshness.is_stale() -> "stale" else -> "fresh"
}
fn jet_devtools_request_panel_object(fields: [String]) -> String Never! { "{{{fields.join(",")}}}" }
fn jet_devtools_request_panel_json_string(value: String) -> String Err! {
    out := [U8]{}
    d.render_text(value, &out) ?? return Err(err)
    Ok(String.from_bytes(out) ?? panic("devtools text writer preserves UTF-8"))
}

// Rust :963–989. Projection owns the deliberate snapshot copies; row does not.
pub struct JetDevtoolsRequestPanelProjection {
    pub request_id: String
    pub request: JetDevtoolsRequestFact?
    pub response: JetDevtoolsResponseFact?
    pub access_events: [JetDevtoolsAccessEvent]
    pub queries: [JetDevtoolsQueryFact]
    pub exceptions: [JetDevtoolsExceptionFact]
    pub source_frames: [JetDevtoolsSourceFrame]
    pub log_links: [JetDevtoolsLogLink]
    pub trace_links: [JetDevtoolsTraceLink]
    pub freshness: JetDevtoolsRequestPanelFreshness
}
struct JetDevtoolsRequestPanelRow {
    request: JetDevtoolsRequestFact?
    response: JetDevtoolsResponseFact?
    access_events: [JetDevtoolsAccessEvent]
    queries: [JetDevtoolsQueryFact]
    exceptions: [JetDevtoolsExceptionFact]
    source_frames: [JetDevtoolsSourceFrame]
    log_links: [JetDevtoolsLogLink]
    trace_links: [JetDevtoolsTraceLink]
}
impl JetDevtoolsRequestPanelRow {
    fn default() -> JetDevtoolsRequestPanelRow Never! {
        JetDevtoolsRequestPanelRow{request: None, response: None, access_events: [JetDevtoolsAccessEvent]{}, queries: [JetDevtoolsQueryFact]{}, exceptions: [JetDevtoolsExceptionFact]{}, source_frames: [JetDevtoolsSourceFrame]{}, log_links: [JetDevtoolsLogLink]{}, trace_links: [JetDevtoolsTraceLink]{}}
    }
    // #4392: mutable .Val binding must retain the original optional owner.
    fn set_freshness(&self, freshness: JetDevtoolsRequestPanelFreshness) Never! {
        if &self.request == .Val(request) -> request.freshness = freshness
        if &self.response == .Val(response) -> response.freshness = freshness
        loop i in 0..<self.access_events.len() -> self.access_events[i].freshness = freshness
        loop i in 0..<self.queries.len() -> self.queries[i].freshness = freshness
        loop i in 0..<self.exceptions.len() {
            self.exceptions[i].freshness = freshness
            loop j in 0..<self.exceptions[i].source_frames.len() -> self.exceptions[i].source_frames[j].freshness = freshness
        }
        loop i in 0..<self.source_frames.len() -> self.source_frames[i].freshness = freshness
        loop i in 0..<self.log_links.len() -> self.log_links[i].freshness = freshness
        loop i in 0..<self.trace_links.len() -> self.trace_links[i].freshness = freshness
    }
    fn mark_stale(&self) Never! { &self.set_freshness(.Stale) }
    fn mark_fresh(&self) Never! { &self.set_freshness(.Fresh) }
    fn freshness(self) -> JetDevtoolsRequestPanelFreshness Never! {
        if self.request == .Val(fact) { if fact.freshness.is_stale() -> return .Stale }
        if self.response == .Val(fact) { if fact.freshness.is_stale() -> return .Stale }
        loop fact in self.access_events { if fact.freshness.is_stale() -> return .Stale }
        loop fact in self.queries { if fact.freshness.is_stale() -> return .Stale }
        loop fact in self.exceptions {
            if fact.freshness.is_stale() -> return .Stale
            loop frame in fact.source_frames { if frame.freshness.is_stale() -> return .Stale }
        }
        loop fact in self.source_frames { if fact.freshness.is_stale() -> return .Stale }
        loop fact in self.log_links { if fact.freshness.is_stale() -> return .Stale }
        loop fact in self.trace_links { if fact.freshness.is_stale() -> return .Stale }
        .Fresh
    }
}
// Rust :1081–1353. String-keyed built-in map preserves keyed lookup complexity.
// FIFO order uses the canonical Queue, not an array queue. #4500 retaining
// indexed read and #4392 map-field loans must not lower to cloned snapshots.
pub struct JetDevtoolsRequestPanelState {
    capacity: Int
    rows: [String: JetDevtoolsRequestPanelRow]
    order: Queue<String>
    selected_request_id: String?
}
impl JetDevtoolsRequestPanelState {
    pub fn default() -> JetDevtoolsRequestPanelState Never! { JetDevtoolsRequestPanelState.new() }
    pub fn new() -> JetDevtoolsRequestPanelState Never! { JetDevtoolsRequestPanelState.with_capacity(JET_DEVTOOLS_REQUEST_PANEL_MAX_ROWS) }
    pub fn with_capacity(capacity: Int) -> JetDevtoolsRequestPanelState Never! {
        bounded := capacity
        if bounded < 1 -> bounded = 1
        if bounded > JET_DEVTOOLS_REQUEST_PANEL_MAX_ROWS -> bounded = JET_DEVTOOLS_REQUEST_PANEL_MAX_ROWS
        JetDevtoolsRequestPanelState{capacity: bounded, rows: [String: JetDevtoolsRequestPanelRow]{}, order: Queue.new(), selected_request_id: None}
    }
    pub fn capacity(self) -> Int Never! { self.capacity }
    pub fn len(self) -> Int Never! { self.rows.len() }
    pub fn is_empty(self) -> Bool Never! { self.rows.is_empty() }
    pub fn request_ids(self) -> [String] Never! {
        keys := self.rows.keys().to_list()
        &keys.sort()
        keys
    }
    pub fn ingest(&self, fact: ^JetDevtoolsRequestPanelFact) Err! {
        if fact == {
            .Request(value) -> &self.ingest_request(^value)
            .Response(value) -> &self.ingest_response(^value)
            .Access(value) -> &self.ingest_access(^value)
            .Query(value) -> &self.ingest_query(^value)
            .Exception(value) -> &self.ingest_exception(^value)
            .SourceFrame(value) -> &self.ingest_source_frame(^value)
            .LogLink(value) -> &self.ingest_log_link(^value)
            .TraceLink(value) -> &self.ingest_trace_link(^value)
        }
    }
    pub fn ingest_request(&self, fact: ^JetDevtoolsRequestFact) Err! {
        jet_devtools_request_panel_validate_request(fact) ?? return Err(err)
        &fact.route_inputs.sort_by((left: JetDevtoolsRouteInput, right: JetDevtoolsRouteInput) -> left.name <=> right.name)
        id :: ~fact.id
        &self.ensure_row(id)
        self.rows[id].request = Val(^fact)
        Ok()
    }
    pub fn ingest_response(&self, fact: ^JetDevtoolsResponseFact) Err! {
        jet_devtools_request_panel_validate_response(fact) ?? return Err(err)
        id :: ~fact.request_id
        &self.ensure_row(id)
        self.rows[id].response = Val(^fact)
        Ok()
    }
    pub fn ingest_access(&self, fact: ^JetDevtoolsAccessEvent) Err! {
        jet_devtools_request_panel_validate_access(fact) ?? return Err(err)
        id :: ~fact.request_id
        &self.ensure_row(id)
        jet_devtools_request_panel_upsert_access(&self.rows[id].access_events, ^fact)
        Ok()
    }
    pub fn ingest_query(&self, fact: ^JetDevtoolsQueryFact) Err! {
        jet_devtools_request_panel_validate_query(fact) ?? return Err(err)
        id :: ~fact.request_id
        &self.ensure_row(id)
        jet_devtools_request_panel_upsert_query(&self.rows[id].queries, ^fact)
        Ok()
    }
    pub fn ingest_exception(&self, fact: ^JetDevtoolsExceptionFact) Err! {
        jet_devtools_request_panel_validate_exception(fact) ?? return Err(err)
        jet_devtools_request_panel_normalize_frames(&fact.source_frames)
        id :: ~fact.request_id
        &self.ensure_row(id)
        jet_devtools_request_panel_upsert_exception(&self.rows[id].exceptions, ^fact)
        Ok()
    }
    pub fn ingest_source_frame(&self, fact: ^JetDevtoolsSourceFrame) Err! {
        jet_devtools_request_panel_validate_source_frame(fact) ?? return Err(err)
        id :: ~fact.request_id
        &self.ensure_row(id)
        jet_devtools_request_panel_upsert_source_frame(&self.rows[id].source_frames, ^fact)
        Ok()
    }
    pub fn ingest_log_link(&self, fact: ^JetDevtoolsLogLink) Err! {
        jet_devtools_request_panel_validate_log_link(fact) ?? return Err(err)
        id :: ~fact.request_id
        &self.ensure_row(id)
        jet_devtools_request_panel_upsert_log_link(&self.rows[id].log_links, ^fact)
        Ok()
    }
    pub fn ingest_trace_link(&self, fact: ^JetDevtoolsTraceLink) Err! {
        jet_devtools_request_panel_validate_trace_link(fact) ?? return Err(err)
        id :: ~fact.request_id
        &self.ensure_row(id)
        jet_devtools_request_panel_upsert_trace_link(&self.rows[id].trace_links, ^fact)
        Ok()
    }
    pub fn project(self, request_id: String) -> JetDevtoolsRequestPanelProjection? Never! {
        if !self.rows.has_key(request_id) -> return None
        frames := ~self.rows[request_id].source_frames
        loop exception in self.rows[request_id].exceptions -> jet_devtools_request_panel_merge_frames(&frames, exception.source_frames)
        jet_devtools_request_panel_normalize_frames(&frames)
        Val(JetDevtoolsRequestPanelProjection{
            request_id: ~request_id, request: ~self.rows[request_id].request, response: ~self.rows[request_id].response,
            access_events: ~self.rows[request_id].access_events, queries: ~self.rows[request_id].queries,
            exceptions: ~self.rows[request_id].exceptions, source_frames: frames,
            log_links: ~self.rows[request_id].log_links, trace_links: ~self.rows[request_id].trace_links,
            freshness: self.rows[request_id].freshness()
        })
    }
    pub fn select(self, request_id: String) -> JetDevtoolsRequestPanelProjection? Never! { self.project(request_id) }
    pub fn project_all(self) -> [JetDevtoolsRequestPanelProjection] Never! {
        out := [JetDevtoolsRequestPanelProjection]{}
        loop id in self.request_ids() {
            if self.project(id) == .Val(projection) -> &out.push(projection)
        }
        out
    }
    pub fn rows(self) -> [JetDevtoolsRequestPanelProjection] Never! { self.project_all() }
    pub fn set_selection(&self, request_id: String?) -> Bool Never! {
        if request_id == .None { self.selected_request_id = None; return true }
        if request_id == .Val(id) {
            if !self.rows.has_key(id) -> return false
            self.selected_request_id = request_id
            return true
        }
        false
    }
    pub fn selected_request_id(self) -> (@String)? Never! from self {
        if self.selected_request_id == .Val(id) -> return Val(@id)
        None
    }
    pub fn selected(self) -> JetDevtoolsRequestPanelProjection? Never! {
        id :: self.selected_request_id ?? return None
        self.project(id)
    }
    pub fn freshness(self, request_id: String) -> JetDevtoolsRequestPanelFreshness? Never! {
        if !self.rows.has_key(request_id) -> return None
        Val(self.rows[request_id].freshness())
    }
    pub fn mark_stale(&self) Never! {
        loop id in self.rows.keys() -> &self.rows[id].mark_stale()
    }
    pub fn mark_fresh(&self, request_id: String) -> Bool Never! {
        if !self.rows.has_key(request_id) -> return false
        &self.rows[request_id].mark_fresh()
        true
    }
    pub fn to_protocol_events(self, source: String) -> [d.JetDevtoolsEvent] Err! {
        events := [d.JetDevtoolsEvent]{}
        loop i in 0..<self.order.len() {
            id :: self.order[i] // #4500: retaining Queue element loan.
            if !self.rows.has_key(id) -> continue
            if self.rows[id].request == .Val(fact) -> &events.push(fact.to_protocol_event(~source) ?? return Err(err))
            if self.rows[id].response == .Val(fact) -> &events.push(fact.to_protocol_event(~source) ?? return Err(err))
            loop fact in self.rows[id].access_events -> &events.push(fact.to_protocol_event(~source) ?? return Err(err))
            loop fact in self.rows[id].queries -> &events.push(fact.to_protocol_event(~source) ?? return Err(err))
            loop fact in self.rows[id].exceptions -> &events.push(fact.to_protocol_event(~source) ?? return Err(err))
            loop fact in self.rows[id].source_frames -> &events.push(fact.to_protocol_event(~source) ?? return Err(err))
            loop fact in self.rows[id].log_links -> &events.push(fact.to_protocol_event(~source) ?? return Err(err))
            loop fact in self.rows[id].trace_links -> &events.push(fact.to_protocol_event(~source) ?? return Err(err))
        }
        Ok(events)
    }
    pub fn protocol_events(self, source: String) -> [d.JetDevtoolsEvent] Err! { self.to_protocol_events(source) }
    // ensure_row's mutable row return is fused into each indexed caller above.
    fn ensure_row(&self, request_id: String) Never! {
        if self.rows.has_key(request_id) -> return
        if self.rows.len() == self.capacity {
            if &self.order.pop_front() == .Val(evicted) {
                _ :: &self.rows.remove(evicted)
                if self.selected_request_id == .Val(evicted) -> self.selected_request_id = None
            }
        }
        &self.order.push_back(~request_id)
        self.rows[~request_id] = JetDevtoolsRequestPanelRow.default()
    }
}
pub fn jet_devtools_request_panel_ingest(state: &JetDevtoolsRequestPanelState, fact: ^JetDevtoolsRequestPanelFact) Err! { &state.ingest(^fact) }
pub fn jet_devtools_request_panel_select(state: JetDevtoolsRequestPanelState, request_id: String) -> JetDevtoolsRequestPanelProjection? Never! { state.select(request_id) }
pub fn jet_devtools_request_panel_project(state: JetDevtoolsRequestPanelState, request_id: String) -> JetDevtoolsRequestPanelProjection? Never! { state.project(request_id) }

// Rust :1376–1499. Validation is BEFORE any state mutation, including eviction.
fn jet_devtools_request_panel_validate_request(fact: JetDevtoolsRequestFact) Err! {
    jet_devtools_request_panel_validate_text(fact.id, "request id", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.method, "request method", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.route, "request route", true) ?? return Err(err)
    if fact.route_inputs.len() > JET_DEVTOOLS_REQUEST_PANEL_MAX_ROUTE_INPUTS -> return Err("jet.devtools.v1 request panel route inputs exceed the Prelude limit")
    // Last positions preserve Rust's earliest duplicate/error precedence without
    // a suffix scan for each input. The prepass does not validate or publish.
    last := [String: Int]{}
    loop i in 0..<fact.route_inputs.len() -> last[~fact.route_inputs[i].name] = i
    loop i in 0..<fact.route_inputs.len() {
        jet_devtools_request_panel_validate_text(fact.route_inputs[i].name, "route input name", true) ?? return Err(err)
        fact.route_inputs[i].value.validate("route input {i}") ?? return Err(err)
        if last[fact.route_inputs[i].name] > i -> return Err("jet.devtools.v1 request panel contains duplicate route input `{fact.route_inputs[i].name}`")
    }
    fact.payload.validate("request payload")
}
fn jet_devtools_request_panel_validate_response(fact: JetDevtoolsResponseFact) Err! {
    jet_devtools_request_panel_validate_text(fact.request_id, "response request id", true) ?? return Err(err)
    fact.payload.validate("response payload")
}
fn jet_devtools_request_panel_validate_access(fact: JetDevtoolsAccessEvent) Err! {
    jet_devtools_request_panel_validate_text(fact.id, "access id", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.request_id, "access request id", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.operation, "access operation", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.target, "access target", true) ?? return Err(err)
    fact.payload.validate("access payload")
}
fn jet_devtools_request_panel_validate_query(fact: JetDevtoolsQueryFact) Err! {
    jet_devtools_request_panel_validate_text(fact.id, "query id", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.request_id, "query request id", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.name, "query name", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.source_identity, "query source identity", true) ?? return Err(err)
    fact.payload.validate("query payload")
}
fn jet_devtools_request_panel_validate_exception(fact: JetDevtoolsExceptionFact) Err! {
    jet_devtools_request_panel_validate_text(fact.id, "exception id", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.request_id, "exception request id", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.kind, "exception kind", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.code, "exception code", false) ?? return Err(err)
    if fact.source_frames.len() > JET_DEVTOOLS_REQUEST_PANEL_MAX_SOURCE_FRAMES -> return Err("jet.devtools.v1 request panel exception frames exceed the Prelude limit")
    loop frame in fact.source_frames {
        jet_devtools_request_panel_validate_source_frame(frame) ?? return Err(err)
        if frame.request_id != fact.request_id -> return Err("jet.devtools.v1 request panel exception frame request id does not match")
    }
    fact.message.validate("exception message") ?? return Err(err)
    fact.payload.validate("exception payload")
}
fn jet_devtools_request_panel_validate_source_frame(fact: JetDevtoolsSourceFrame) Err! {
    jet_devtools_request_panel_validate_text(fact.id, "source frame id", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.request_id, "source frame request id", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.function, "source frame function", false) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.file, "source frame file", true) ?? return Err(err)
    fact.source_line.validate("source frame line")
}
fn jet_devtools_request_panel_validate_log_link(fact: JetDevtoolsLogLink) Err! {
    jet_devtools_request_panel_validate_text(fact.id, "log link id", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.request_id, "log link request id", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.target, "log link target", true)
}
fn jet_devtools_request_panel_validate_trace_link(fact: JetDevtoolsTraceLink) Err! {
    jet_devtools_request_panel_validate_text(fact.id, "trace link id", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.request_id, "trace link request id", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.span_id, "trace span id", true) ?? return Err(err)
    jet_devtools_request_panel_validate_text(fact.target, "trace link target", true)
}
fn jet_devtools_request_panel_validate_text(value: String, field: String, required: Bool) Err! {
    if required && value.is_empty() -> return Err("jet.devtools.v1 request panel {field} is empty")
    if value.count_bytes() > d.JET_DEVTOOLS_MAX_TEXT_BYTES -> return Err("jet.devtools.v1 request panel {field} exceeds the Prelude limit")
    if !text.isprintable(value) -> return Err("jet.devtools.v1 request panel {field} contains a control character")
    Ok()
}
// Rust :1501–1509: stable sort THEN adjacent-ID dedup, not global-ID dedup.
// Duplicates separated by another frame_index intentionally remain. Compaction
// consumes slots rather than cloning frames or repeatedly shifting suffixes.
fn jet_devtools_request_panel_normalize_frames(frames: &[JetDevtoolsSourceFrame]) Never! {
    &frames.sort_by((left: JetDevtoolsSourceFrame, right: JetDevtoolsSourceFrame) -> request_panel_frame_order(left, right))
    write := 0
    loop read in 0..<frames.len() {
        if write == 0 || frames[write - 1].id != frames[read].id {
            // #4500 (@T links) / #4392: disjoint slot transfer, no clone.
            if write != read -> frames[write] = ^frames[read]
            write = write + 1
        }
    }
    if write > JET_DEVTOOLS_REQUEST_PANEL_MAX_SOURCE_FRAMES -> write = JET_DEVTOOLS_REQUEST_PANEL_MAX_SOURCE_FRAMES
    loop frames.len() > write -> _ :: &frames.pop()
}
fn request_panel_frame_order(left: JetDevtoolsSourceFrame, right: JetDevtoolsSourceFrame) -> Ordering Never! {
    index :: left.frame_index <=> right.frame_index
    if index != .Equal -> return index
    left.id <=> right.id
}
fn jet_devtools_request_panel_merge_frames(destination: &[JetDevtoolsSourceFrame], incoming: [JetDevtoolsSourceFrame]) Never! {
    // Match the first original ID even when normalize kept nonadjacent repeated
    // IDs. Each exception normalizes separately, preserving replacement order.
    positions := [String: Int]{}
    loop i in 0..<destination.len() {
        if !positions.has_key(destination[i].id) -> positions[~destination[i].id] = i
    }
    loop frame in incoming {
        if positions.has_key(frame.id) {
            destination[positions[frame.id]] = ~frame
        } else {
            positions[~frame.id] = destination.len()
            &destination.push(~frame)
        }
    }
    jet_devtools_request_panel_normalize_frames(&destination)
}
fn jet_devtools_request_panel_upsert_access(values: &[JetDevtoolsAccessEvent], value: ^JetDevtoolsAccessEvent) Never! {
    at := 0
    loop at < values.len() && values[at].id != value.id -> at = at + 1
    if at < values.len() { values[at] = ^value } else { &values.push(^value) }
    &values.sort_by((left: JetDevtoolsAccessEvent, right: JetDevtoolsAccessEvent) -> request_panel_access_order(left, right))
    jet_devtools_request_panel_trim_tail(&values, JET_DEVTOOLS_REQUEST_PANEL_MAX_ACCESS_EVENTS)
}
fn request_panel_access_order(left: JetDevtoolsAccessEvent, right: JetDevtoolsAccessEvent) -> Ordering Never! {
    time :: left.at_ms <=> right.at_ms
    if time != .Equal -> return time
    left.id <=> right.id
}
fn jet_devtools_request_panel_upsert_query(values: &[JetDevtoolsQueryFact], value: ^JetDevtoolsQueryFact) Never! {
    at := 0
    loop at < values.len() && values[at].id != value.id -> at = at + 1
    if at < values.len() { values[at] = ^value } else { &values.push(^value) }
    &values.sort_by((left: JetDevtoolsQueryFact, right: JetDevtoolsQueryFact) -> request_panel_query_order(left, right))
    jet_devtools_request_panel_trim_tail(&values, JET_DEVTOOLS_REQUEST_PANEL_MAX_QUERIES)
}
fn request_panel_query_order(left: JetDevtoolsQueryFact, right: JetDevtoolsQueryFact) -> Ordering Never! {
    time :: left.started_at_ms <=> right.started_at_ms
    if time != .Equal -> return time
    left.id <=> right.id
}
fn jet_devtools_request_panel_upsert_exception(values: &[JetDevtoolsExceptionFact], value: ^JetDevtoolsExceptionFact) Never! {
    at := 0
    loop at < values.len() && values[at].id != value.id -> at = at + 1
    if at < values.len() { values[at] = ^value } else { &values.push(^value) }
    &values.sort_by((left: JetDevtoolsExceptionFact, right: JetDevtoolsExceptionFact) -> request_panel_exception_order(left, right))
    jet_devtools_request_panel_trim_tail(&values, JET_DEVTOOLS_REQUEST_PANEL_MAX_EXCEPTIONS)
}
fn request_panel_exception_order(left: JetDevtoolsExceptionFact, right: JetDevtoolsExceptionFact) -> Ordering Never! {
    time :: left.at_ms <=> right.at_ms
    if time != .Equal -> return time
    left.id <=> right.id
}
fn jet_devtools_request_panel_upsert_source_frame(values: &[JetDevtoolsSourceFrame], value: ^JetDevtoolsSourceFrame) Never! {
    at := 0
    loop at < values.len() && values[at].id != value.id -> at = at + 1
    if at < values.len() { values[at] = ^value } else { &values.push(^value) }
    jet_devtools_request_panel_normalize_frames(&values)
}
fn jet_devtools_request_panel_upsert_log_link(values: &[JetDevtoolsLogLink], value: ^JetDevtoolsLogLink) Never! {
    at := 0
    loop at < values.len() && values[at].id != value.id -> at = at + 1
    if at < values.len() { values[at] = ^value } else { &values.push(^value) }
    &values.sort_by((left: JetDevtoolsLogLink, right: JetDevtoolsLogLink) -> request_panel_log_order(left, right))
    jet_devtools_request_panel_trim_tail(&values, JET_DEVTOOLS_REQUEST_PANEL_MAX_LINKS)
}
fn request_panel_log_order(left: JetDevtoolsLogLink, right: JetDevtoolsLogLink) -> Ordering Never! {
    time :: left.at_ms <=> right.at_ms
    if time != .Equal -> return time
    left.id <=> right.id
}
fn jet_devtools_request_panel_upsert_trace_link(values: &[JetDevtoolsTraceLink], value: ^JetDevtoolsTraceLink) Never! {
    at := 0
    loop at < values.len() && values[at].id != value.id -> at = at + 1
    if at < values.len() { values[at] = ^value } else { &values.push(^value) }
    &values.sort_by((left: JetDevtoolsTraceLink, right: JetDevtoolsTraceLink) -> request_panel_trace_order(left, right))
    jet_devtools_request_panel_trim_tail(&values, JET_DEVTOOLS_REQUEST_PANEL_MAX_LINKS)
}
fn request_panel_trace_order(left: JetDevtoolsTraceLink, right: JetDevtoolsTraceLink) -> Ordering Never! {
    time :: left.at_ms <=> right.at_ms
    if time != .Equal -> return time
    left.id <=> right.id
}
fn jet_devtools_request_panel_trim_tail<T>(values: &[T], limit: Int) Never! {
    remove :: values.len() - limit
    if remove <= 0 -> return
    // #4500 (@T links) / #4392: disjoint slot transfer, then suffix cleanup.
    loop i in 0..<limit -> values[i] = ^values[i + remove]
    loop values.len() > limit -> _ :: &values.pop()
}
