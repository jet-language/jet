// DevtoolsDatabasePanel.rs:1-1409. Typed, payload-free database facts only.
// No driver, SQL, binding values, connection URLs, credentials or native handles.
// Publication dependency: packet0176 owns devtools.JetDevtoolsEvent.from_parts
// and JET_DEVTOOLS_MAX_TEXT_BYTES. Never substitute a private event envelope.
// #4318/#4392: text.utf8_bytes must become a retained byte loan for allocation parity.
// #4392: borrowed scalar/optional-field result loans below retain their fact owner.
// Shared typed capacity storage is gated on its canonical producer, not emulated.
use kernel_storage_leaves as db_storage
use core.devtools.runtime.devtools as devtools
use core.text.runtime.kernel_unicode_string as db_text
use core.text.runtime.unicode_assets as db_assets
use core.text.runtime.assets.unicode_white_space as db_space
use core.text.runtime.assets.unicode_general_category as db_category

pub JET_DEVTOOLS_DATABASE_PANEL_ID :: "database"
pub JET_DEVTOOLS_DATABASE_EXPLAIN_CAPABILITY :: "DB.Explain"
pub JET_DEVTOOLS_DATABASE_CREDENTIAL_CAPABILITY :: "DB.Credentials"
pub JET_DEVTOOLS_DATABASE_MAX_HISTORY :: 256
pub JET_DEVTOOLS_DATABASE_MAX_BINDINGS :: 256
pub JET_DEVTOOLS_DATABASE_MAX_PLAN_ROWS :: 256
pub JET_DEVTOOLS_DATABASE_MAX_EXPLAIN_TIMEOUT_MS :: U64{30000}

#Error
#Equatable
pub enum JetDevtoolsDatabaseFactError {
    EmptyField(field: String)
    OversizedField(field: String)
    InvalidIdentity(field: String)
    InvalidLimit(field: String)
    InvalidPoolCounts
    DuplicateIdentity(field: String)
    UnsupportedStatement
    MissingExplainAuthority
    MismatchedExplainAuthority
    InvalidTimestamp
    InvalidPlanRow
    Protocol(message: String)
}
impl JetDevtoolsDatabaseFactError {
    pub fn message(self) -> String Never! {
        if self == {
            .EmptyField { field } -> return "database {field} must not be empty"
            .OversizedField { field } -> return "database {field} exceeds the Prelude text limit"
            .InvalidIdentity { field } -> return "database {field} must be a stable identity"
            .InvalidLimit { field } -> return "database {field} is outside its limit"
            .InvalidPoolCounts -> return "database pool counts exceed the configured maximum"
            .DuplicateIdentity { field } -> return "database {field} identity is duplicated"
            .UnsupportedStatement -> return "database EXPLAIN requires a read-only statement"
            .MissingExplainAuthority -> return "database EXPLAIN requires an explicit DB.Explain grant"
            .MismatchedExplainAuthority -> return "database EXPLAIN grant does not match the requested capability and query identity"
            .InvalidTimestamp -> return "database EXPLAIN timestamps must be monotonic"
            .InvalidPlanRow -> return "database EXPLAIN plan row is invalid"
            .Protocol { message } -> return ~message
        }
    }
}
fn jet_devtools_database_validate_text(value: String, field: String) JetDevtoolsDatabaseFactError! {
    if value.is_empty() -> return Err(JetDevtoolsDatabaseFactError.EmptyField(field))
    raw :: db_text.utf8_bytes(value)
    if raw.len() > devtools.JET_DEVTOOLS_MAX_TEXT_BYTES -> return Err(JetDevtoolsDatabaseFactError.OversizedField(field))
    at := 0
    loop at < raw.len() {
        if db_assets.asset_tag(db_category.UNICODE_GENERAL_CATEGORY, db_text.scalar_at(raw, at), 8) == 0 -> return Err(JetDevtoolsDatabaseFactError.InvalidIdentity(field))
        at = at + db_text.utf8_width_at(raw, at)
    }
}
fn jet_devtools_database_validate_identity(value: String, field: String) JetDevtoolsDatabaseFactError! {
    jet_devtools_database_validate_text(value, field) ?? return Err(err)
    raw :: db_text.utf8_bytes(value)
    at := 0
    loop at < raw.len() {
        if db_assets.asset_contains(db_space.UNICODE_WHITE_SPACE, db_text.scalar_at(raw, at)) -> return Err(JetDevtoolsDatabaseFactError.InvalidIdentity(field))
        at = at + db_text.utf8_width_at(raw, at)
    }
}
fn jet_devtools_database_validate_optional_text(value: String?, field: String) JetDevtoolsDatabaseFactError! {
    if value == .Val(text) -> jet_devtools_database_validate_text(text, field) ?? return Err(err)
}
fn db_hex_nibble(n: Int) -> U8 Never! {
    U8{if n < 10 -> 48 + n else -> 87 + n}
}
fn jet_devtools_database_json_string(value: String) -> String Never! {
    raw :: db_text.utf8_bytes(value)
    out := db_storage.jet_storage_list_with_capacity<U8>(raw.len() + 2)
    &out.push(U8{34})
    at := 0
    loop at < raw.len() {
        cp :: db_text.scalar_at(raw, at)
        if cp == 34 { &out.push(U8{92}); &out.push(U8{34}) }
        else if cp == 92 { &out.push(U8{92}); &out.push(U8{92}) }
        else if cp == 10 { &out.push(U8{92}); &out.push(U8{110}) }
        else if cp == 13 { &out.push(U8{92}); &out.push(U8{114}) }
        else if cp == 9 { &out.push(U8{92}); &out.push(U8{116}) }
        else if db_assets.asset_tag(db_category.UNICODE_GENERAL_CATEGORY, cp, 8) == 0 {
            &out.push(U8{92})
            &out.push(U8{117})
            &out.push(db_hex_nibble((cp >> 12) & 15))
            &out.push(db_hex_nibble((cp >> 8) & 15))
            &out.push(db_hex_nibble((cp >> 4) & 15))
            &out.push(db_hex_nibble(cp & 15))
        } else -> db_text.append_cp(&out, cp)
        at = at + db_text.utf8_width_at(raw, at)
    }
    &out.push(U8{34})
    String.from_bytes(^out) ?? panic("database JSON must be UTF-8")
}
fn jet_devtools_database_json_optional(value: String?) -> String Never! {
    if value == .Val(text) -> return jet_devtools_database_json_string(text)
    "null"
}
fn db_json_number(value: U64?) -> String Never! {
    if value == .Val(number) -> return "{number}"
    "null"
}
// Fixed-width saturating laws; no widened/host-sized arithmetic or overflow.
fn db_sat_add(a: U64, b: U64) -> U64 Never! {
    max :: U64{18446744073709551615}
    if b > max - a -> return max
    a + b
}
fn db_sat_sub(a: U64, b: U64) -> U64 Never! { if b > a -> U64{0} else -> a - b }
fn db_sat_mul_1000(a: U64) -> U64 Never! {
    max :: U64{18446744073709551615}
    if a > max /% U64{1000} -> return max
    a * U64{1000}
}

#Equatable
pub enum JetDevtoolsDatabasePoolLifecycle { Open Draining Drained }
impl JetDevtoolsDatabasePoolLifecycle {
    pub fn as_str(self) -> String Never! {
        if self == .Open -> return "open"
        if self == .Draining -> return "draining"
        "drained"
    }
    fn discriminant(self) -> Int Never! {
        if self == .Open -> return 0
        if self == .Draining -> return 1
        2
    }
    // Rust derived Ord/PartialOrd use declaration order, NOT rendered labels.
    pub fn compare(self, other: JetDevtoolsDatabasePoolLifecycle) -> Ordering Never! { self.discriminant() <=> other.discriminant() }
}
#Equatable
pub enum JetDevtoolsDatabasePoolPressure { Idle Normal Elevated Saturated Exhausted Draining Drained }
impl JetDevtoolsDatabasePoolPressure {
    pub fn as_str(self) -> String Never! {
        if self == .Idle -> return "idle"
        if self == .Normal -> return "normal"
        if self == .Elevated -> return "elevated"
        if self == .Saturated -> return "saturated"
        if self == .Exhausted -> return "exhausted"
        if self == .Draining -> return "draining"
        "drained"
    }
    fn discriminant(self) -> Int Never! {
        if self == .Idle -> return 0
        if self == .Normal -> return 1
        if self == .Elevated -> return 2
        if self == .Saturated -> return 3
        if self == .Exhausted -> return 4
        if self == .Draining -> return 5
        6
    }
    pub fn compare(self, other: JetDevtoolsDatabasePoolPressure) -> Ordering Never! { self.discriminant() <=> other.discriminant() }
}
#Equatable
pub struct JetDevtoolsDatabasePoolStats {
    pub pool_id: String
    pub lifecycle: JetDevtoolsDatabasePoolLifecycle
    pub max_connections: U64
    pub available_connections: U64
    pub leased_connections: U64
    pub opening_connections: U64
    pub waiting_requests: U64
    pub timed_out_requests: U64
    pub acquire_count: U64
    pub release_count: U64
    pub open_failures: U64
    pub unhealthy_connections: U64
    pub replacement_count: U64
    pub replacement_failures: U64
    pub observed_at_ms: U64
}
impl JetDevtoolsDatabasePoolStats {
    pub fn new(pool_id: String, lifecycle: JetDevtoolsDatabasePoolLifecycle, max_connections: U64, available_connections: U64, leased_connections: U64, opening_connections: U64, waiting_requests: U64, timed_out_requests: U64, acquire_count: U64, release_count: U64, open_failures: U64, unhealthy_connections: U64, replacement_count: U64, replacement_failures: U64, observed_at_ms: U64) -> JetDevtoolsDatabasePoolStats JetDevtoolsDatabaseFactError! {
        jet_devtools_database_validate_identity(pool_id, "pool_id") ?? return Err(err)
        if max_connections == U64{0} -> return Err(JetDevtoolsDatabaseFactError.InvalidLimit("max_connections"))
        if db_sat_add(db_sat_add(available_connections, leased_connections), opening_connections) > max_connections -> return Err(JetDevtoolsDatabaseFactError.InvalidPoolCounts)
        JetDevtoolsDatabasePoolStats{pool_id, lifecycle, max_connections, available_connections, leased_connections, opening_connections, waiting_requests, timed_out_requests, acquire_count, release_count, open_failures, unhealthy_connections, replacement_count, replacement_failures, observed_at_ms}
    }
    pub fn reserved_connections(self) -> U64 Never! { db_sat_add(db_sat_add(self.available_connections, self.leased_connections), self.opening_connections) }
    pub fn available_capacity(self) -> U64 Never! { db_sat_sub(self.max_connections, self.reserved_connections()) }
    pub fn utilization_milli(self) -> U64 Never! {
        if self.max_connections == U64{0} -> return U64{1000}
        value :: db_sat_mul_1000(self.reserved_connections()) /% self.max_connections
        if value > U64{1000} -> U64{1000} else -> value
    }
    pub fn pressure(self) -> JetDevtoolsDatabasePoolPressure Never! {
        if self.lifecycle == .Draining -> return JetDevtoolsDatabasePoolPressure.Draining
        if self.lifecycle == .Drained -> return JetDevtoolsDatabasePoolPressure.Drained
        if self.available_capacity() == U64{0} {
            if self.waiting_requests > U64{0} -> return JetDevtoolsDatabasePoolPressure.Exhausted
            return JetDevtoolsDatabasePoolPressure.Saturated
        }
        if self.waiting_requests > U64{0} || self.utilization_milli() >= U64{750} -> return JetDevtoolsDatabasePoolPressure.Elevated
        if self.reserved_connections() == U64{0} -> return JetDevtoolsDatabasePoolPressure.Idle
        JetDevtoolsDatabasePoolPressure.Normal
    }
    pub fn freshness_ms(self, now_ms: U64) -> U64 Never! { db_sat_sub(now_ms, self.observed_at_ms) }
    pub fn render_json(self) -> String Never! { self.render_json_at(self.observed_at_ms) }
    pub fn render_json_at(self, now_ms: U64) -> String Never! {
        id :: jet_devtools_database_json_string(self.pool_id)
        lifecycle :: jet_devtools_database_json_string(self.lifecycle.as_str())
        reserved :: self.reserved_connections()
        available :: self.available_capacity()
        utilization :: self.utilization_milli()
        pressure :: jet_devtools_database_json_string(self.pressure().as_str())
        freshness :: self.freshness_ms(now_ms)
        "{{\"pool_id\":{id},\"lifecycle\":{lifecycle},\"max_connections\":{self.max_connections},\"available_connections\":{self.available_connections},\"leased_connections\":{self.leased_connections},\"opening_connections\":{self.opening_connections},\"waiting_requests\":{self.waiting_requests},\"timed_out_requests\":{self.timed_out_requests},\"acquire_count\":{self.acquire_count},\"release_count\":{self.release_count},\"open_failures\":{self.open_failures},\"unhealthy_connections\":{self.unhealthy_connections},\"replacement_count\":{self.replacement_count},\"replacement_failures\":{self.replacement_failures},\"reserved_connections\":{reserved},\"available_capacity\":{available},\"utilization_milli\":{utilization},\"pressure\":{pressure},\"observed_at_ms\":{self.observed_at_ms},\"freshness_ms\":{freshness}}}"
    }
    pub fn to_protocol_event(self, source: String) -> devtools.JetDevtoolsEvent JetDevtoolsDatabaseFactError! {
        devtools.JetDevtoolsEvent.from_parts(self.observed_at_ms, source, "DatabasePool", ~self.pool_id, self.render_json()) ?? return Err(JetDevtoolsDatabaseFactError.Protocol(err))
    }
}
#Equatable
pub struct JetDevtoolsDatabaseTableUsage { pub table_id: String, pub rows_read: U64, pub rows_written: U64 }
impl JetDevtoolsDatabaseTableUsage {
    pub fn new(table_id: String, rows_read: U64, rows_written: U64) -> JetDevtoolsDatabaseTableUsage JetDevtoolsDatabaseFactError! {
        jet_devtools_database_validate_identity(table_id, "table_id") ?? return Err(err)
        JetDevtoolsDatabaseTableUsage{table_id, rows_read, rows_written}
    }
}
