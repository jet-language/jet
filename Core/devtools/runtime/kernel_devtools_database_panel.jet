pub struct JetDevtoolsDatabaseIndexUsage { pub index_id: String, pub used: Bool, pub rows_examined: U64 }
impl JetDevtoolsDatabaseIndexUsage {
    pub fn new(index_id: String, used: Bool, rows_examined: U64) -> JetDevtoolsDatabaseIndexUsage JetDevtoolsDatabaseFactError! {
        jet_devtools_database_validate_identity(index_id, "index_id") ?? return Err(err)
        JetDevtoolsDatabaseIndexUsage{index_id, used, rows_examined}
    }
