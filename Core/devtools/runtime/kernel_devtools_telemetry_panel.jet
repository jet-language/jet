        if self == {
            .Trace -> U8{0}
            .Debug -> U8{1}
            .Info -> U8{2}
            .Warn -> U8{3}
            .Error -> U8{4}
            .Fatal -> U8{5}
        }
    }
    pub fn as_str(self) -> String Never! {
        if self == {
            .Trace -> "trace"
            .Debug -> "debug"
            .Info -> "info"
            .Warn -> "warn"
            .Error -> "error"
            .Fatal -> "fatal"
        }
    }
}
#Equatable
pub enum JetDevtoolsLogValue {
    Boolean(value: Bool)
    Integer(value: I64)
    Float(value: Float)
    Text(value: String)
}
impl JetDevtoolsLogValue {
    pub fn boolean(value: Bool) -> JetDevtoolsLogValue Never! { JetDevtoolsLogValue.Boolean(value) }
    pub fn integer(value: I64) -> JetDevtoolsLogValue Never! { JetDevtoolsLogValue.Integer(value) }
    pub fn float(value: Float) -> JetDevtoolsLogValue Never! { JetDevtoolsLogValue.Float(value) }
    pub fn text(value: String) -> JetDevtoolsLogValue Never! { JetDevtoolsLogValue.Text(value) }
    fn validate(self) JetDevtoolsTelemetryError! {
        if self == {
            .Float(value) -> { if !math.is_finite(value) -> return Err(JetDevtoolsTelemetryError.InvalidLogValue) }
            .Text(value) -> jet_devtools_telemetry_require_text(value, "log value") ?? return Err(err)
            _ -> {}
        }
        Ok()
    }
}
pub struct JetDevtoolsLogField {
    pub key: String
    pub value: JetDevtoolsLogValue?
    pub redacted: Bool
}
impl JetDevtoolsLogField {
    pub fn new(key: String) -> JetDevtoolsLogField Never! { JetDevtoolsLogField{key: key, value: None, redacted: false} }
    pub fn publish(^self, value: JetDevtoolsLogValue) -> JetDevtoolsLogField Never! {
        field := ^self
        value.validate() ?? return ^field
        if !field.redacted -> field.value = Val(value)
        ^field
    }
    pub fn redact(^self) -> JetDevtoolsLogField Never! {
        field := ^self
        field.value = None
        field.redacted = true
        ^field
    }
    fn validate(self) JetDevtoolsTelemetryError! {
        jet_devtools_telemetry_require_text(self.key, "log field key") ?? return Err(err)
        if self.value == .Val(value) -> value.validate() ?? return Err(err)
        Ok()
    }
}

// Rust:889-1062.
pub struct JetDevtoolsLogRecord {
    pub index: U64
    pub timestamp_ns: U64
    pub level: JetDevtoolsLogLevel
    pub body: String?
    pub fields: [JetDevtoolsLogField]
    pub identity: JetDevtoolsTelemetryContext
}
impl JetDevtoolsLogRecord {
    pub fn new(timestamp_ns: U64, level: JetDevtoolsLogLevel, identity: JetDevtoolsTelemetryContext) -> JetDevtoolsLogRecord Never! {
        JetDevtoolsLogRecord{index: U64{0}, timestamp_ns: timestamp_ns, level: level, body: None, fields: [JetDevtoolsLogField]{}, identity: identity}
    }
    pub fn publish_body(^self, body: String) -> JetDevtoolsLogRecord Never! {
        record := ^self
        record.body = Val(body)
        ^record
    }
    pub fn with_field(^self, field: JetDevtoolsLogField) -> JetDevtoolsLogRecord Never! {
        record := ^self
        field.validate() ?? return ^record
        if record.fields.len() < 16 {
            loop existing in record.fields {
                if existing.key == field.key -> return ^record
            }
            &record.fields.push(field)
            &record.fields.sort_by(item -> item.key)
        }
        ^record
    }
    pub fn source_id(self) -> @String Never! from self { self.identity.source_id() }
    pub fn validate(self) JetDevtoolsTelemetryError! {
        self.identity.validate() ?? return Err(err)
        if self.body == .Val(body) -> jet_devtools_telemetry_require_text(body, "log body") ?? return Err(err)
        if self.fields.len() > 16 -> return Err(JetDevtoolsTelemetryError.TooManyFields)
