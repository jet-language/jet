    }
    pub fn to_protocol_event(self, source: String) -> d.JetDevtoolsEvent Err! {
        self.validate() ?? return Err(err.message())
        d.JetDevtoolsEvent.from_parts(U64{0}, source, "Metric", self.name, jet_devtools_telemetry_metric_instrument_fields(self))
    }
}
fn jet_devtools_telemetry_metric_instrument_fields(instrument: JetDevtoolsMetricInstrument) -> String Never! {
    fields := [String]{json_field("name", jet_devtools_telemetry_json_string(instrument.name)), json_field("kind", jet_devtools_telemetry_json_string(instrument.kind.as_str())), json_field("unit", jet_devtools_telemetry_json_string(instrument.unit)), json_field("description", jet_devtools_telemetry_json_string(instrument.description))}
    push_source_json(instrument.source, &fields)
    json_object(fields)
}

// Rust:423-551. Constructor and record both normalize tag order.
pub struct JetDevtoolsMetricPoint {
    pub index: U64
    pub timestamp_ns: U64
    pub instrument: String
    pub tags: [JetDevtoolsMetricTag]
    pub identity: JetDevtoolsTelemetryContext
    pub value: JetDevtoolsMetricValue?
}
impl JetDevtoolsMetricPoint {
    pub fn new(timestamp_ns: U64, instrument: String, ^tags: [JetDevtoolsMetricTag], identity: JetDevtoolsTelemetryContext) -> JetDevtoolsMetricPoint Never! {
        ordered := ^tags
        &ordered.sort_by(tag -> tag.key)
        JetDevtoolsMetricPoint{index: U64{0}, timestamp_ns: timestamp_ns, instrument: instrument, tags: ^ordered, identity: identity, value: None}
    }
    pub fn publish(^self, value: JetDevtoolsMetricValue) -> JetDevtoolsMetricPoint Never! {
        point := ^self
        value.validate() ?? return ^point
        point.value = Val(value)
        ^point
    }
    pub fn is_published(self) -> Bool Never! { self.value != None }
    pub fn validate(self) JetDevtoolsTelemetryError! {
        jet_devtools_telemetry_require_text(self.instrument, "metric instrument") ?? return Err(err)
        self.identity.validate() ?? return Err(err)
        if self.tags.len() > 16 -> return Err(JetDevtoolsTelemetryError.TooManyTags)
        // Preserve validation-before-duplicate precedence even for public unsorted tags.
        // String-key map gives linear expected work; never quadratic suffix scans.
        counts := [String: Int]{}
        loop tag in self.tags -> counts[tag.key] = (counts.get(tag.key) ?? 0) + 1
        loop tag in self.tags {
            tag.validate() ?? return Err(err)
            if counts[tag.key] > 1 -> return Err(JetDevtoolsTelemetryError.DuplicateTag(tag.key))
        }
        if self.value == .Val(value) -> value.validate() ?? return Err(err)
        Ok()
    }
    fn chart_point(self) -> JetDevtoolsMetricChartPoint Never! {
        JetDevtoolsMetricChartPoint{index: self.index, timestamp_ns: self.timestamp_ns, instrument: self.instrument, value: self.value, identity: self.identity}
    }
    fn table_row(self) -> JetDevtoolsMetricTableRow Never! {
        JetDevtoolsMetricTableRow{index: self.index, timestamp_ns: self.timestamp_ns, instrument: self.instrument, tags: self.tags, value: self.value, identity: self.identity}
    }
    pub fn to_protocol_event(self, source: String) -> d.JetDevtoolsEvent Err! {
        self.validate() ?? return Err(err.message())
        payload := None
        if self.value != None -> payload = Val(self.table_row().payload_json())
        d.JetDevtoolsEvent.from_parts_with_payload(self.timestamp_ns / U64{1000000}, source, "Metric", self.instrument, jet_devtools_telemetry_metric_fields(self), payload)
    }
}
fn jet_devtools_telemetry_metric_fields(point: JetDevtoolsMetricPoint) -> String Never! {
    fields := [String]{json_field("index", "{point.index}"), json_field("timestamp_ns", "{point.timestamp_ns}"), json_field("instrument", jet_devtools_telemetry_json_string(point.instrument))}
    push_source_json(point.identity.source, &fields)
    &fields.push(json_field("tags", jet_devtools_telemetry_tags_json(point.tags)))
    jet_devtools_telemetry_push_context_json(point.identity, &fields)
    json_object(fields)
}

// Rust:555-628. Projections own only their requested result, not a copied store.
pub struct JetDevtoolsMetricChartPoint {
    pub index: U64
    pub timestamp_ns: U64
    pub instrument: String
    pub value: JetDevtoolsMetricValue?
    pub identity: JetDevtoolsTelemetryContext
}
impl JetDevtoolsMetricChartPoint {
    pub fn source_id(self) -> @String Never! from self { self.identity.source_id() }
    pub fn trace_id(self) -> (@String)? Never! from self {
        if self.identity.trace_id == .Val(value) -> return Val(@value)
        None
    }
    pub fn span_id(self) -> (@String)? Never! from self {
        if self.identity.span_id == .Val(value) -> return Val(@value)
        None
    }
    pub fn payload_json(self) -> String Never! { metric_payload(self.index, self.timestamp_ns, self.instrument, self.identity, None, self.value) }
}
pub struct JetDevtoolsMetricTableRow {
    pub index: U64
    pub timestamp_ns: U64
    pub instrument: String
    pub tags: [JetDevtoolsMetricTag]
    pub value: JetDevtoolsMetricValue?
    pub identity: JetDevtoolsTelemetryContext
}
impl JetDevtoolsMetricTableRow {
    pub fn source_id(self) -> @String Never! from self { self.identity.source_id() }
    pub fn trace_id(self) -> (@String)? Never! from self {
        if self.identity.trace_id == .Val(value) -> return Val(@value)
        None
    }
    pub fn span_id(self) -> (@String)? Never! from self {
        if self.identity.span_id == .Val(value) -> return Val(@value)
        None
    }
    pub fn payload_json(self) -> String Never! { metric_payload(self.index, self.timestamp_ns, self.instrument, self.identity, Val(self.tags), self.value) }
}
fn metric_payload(index: U64, timestamp_ns: U64, instrument: String, identity: JetDevtoolsTelemetryContext, tags: [JetDevtoolsMetricTag]?, value: JetDevtoolsMetricValue?) -> String Never! {
    fields := [String]{json_field("index", "{index}"), json_field("timestamp_ns", "{timestamp_ns}"), json_field("instrument", jet_devtools_telemetry_json_string(instrument)), json_field("source_id", jet_devtools_telemetry_json_string(identity.source_id()))}
    if tags == .Val(present) -> &fields.push(json_field("tags", jet_devtools_telemetry_tags_json(present)))
    jet_devtools_telemetry_push_context_json(identity, &fields)
    if value == .Val(published) -> &fields.push(json_field("value", jet_devtools_telemetry_metric_value_json(published)))
    json_object(fields)
}

// Rust:633-709. Queue is the canonical bounded double-ended collection.
pub struct JetDevtoolsMetricSeries {
    pub instrument: JetDevtoolsMetricInstrument
    capacity_value: Int
    retained_points: Queue<JetDevtoolsMetricPoint>
    next_index: U64
}
impl JetDevtoolsMetricSeries {
    pub fn new(instrument: JetDevtoolsMetricInstrument, capacity: Int) -> JetDevtoolsMetricSeries Never! {
        JetDevtoolsMetricSeries{instrument: instrument, capacity_value: bounded_count(capacity, 256), retained_points: Queue.new<JetDevtoolsMetricPoint>(), next_index: U64{1}}
    }
    pub fn capacity(self) -> Int Never! { self.capacity_value }
    pub fn len(self) -> Int Never! { self.retained_points.len() }
    pub fn is_empty(self) -> Bool Never! { self.retained_points.is_empty() }
    // #4500: retaining Queue loan, not a contiguous slice of a wrapped deque.
    pub fn points(self) -> @Queue<JetDevtoolsMetricPoint> Never! from self { @self.retained_points }
    pub fn record(&self, ^point: JetDevtoolsMetricPoint) -> U64 JetDevtoolsTelemetryError! {
        incoming := ^point
        &incoming.tags.sort_by(tag -> tag.key)
        self.instrument.validate() ?? return Err(err)
        incoming.validate() ?? return Err(err)
        if incoming.instrument != self.instrument.name -> return Err(JetDevtoolsTelemetryError.InstrumentMismatch(self.instrument.name, incoming.instrument))
        if !self.retained_points.is_empty() {
            previous :: self.retained_points[self.retained_points.len() - 1].timestamp_ns // #4500
            if incoming.timestamp_ns < previous -> return Err(JetDevtoolsTelemetryError.NonMonotonicTimestamp(previous, incoming.timestamp_ns))
        }
        if self.next_index == (U64{18446744073709551615}) -> return Err(JetDevtoolsTelemetryError.SequenceExhausted("metric point"))
        index :: self.next_index
        incoming.index = index
        self.next_index = index + U64{1}
        if self.retained_points.len() == self.capacity_value -> _ :: &self.retained_points.pop_front()
        &self.retained_points.push_back(^incoming)
        Ok(index)
    }
    pub fn chart_points(self) -> [JetDevtoolsMetricChartPoint] Never! {
        rows := [JetDevtoolsMetricChartPoint]{}
        loop point in self.points() -> &rows.push(point.chart_point())
        rows
    }
    pub fn table_rows(self) -> [JetDevtoolsMetricTableRow] Never! {
        rows := [JetDevtoolsMetricTableRow]{}
        loop point in self.points() -> &rows.push(point.table_row())
        rows
    }
}
// Rust:714-774. Name order remains deterministic.
pub struct JetDevtoolsMetricStore {
    capacity: Int
    max_series: Int
    retained_series: [JetDevtoolsMetricSeries]
}
impl JetDevtoolsMetricStore {
    pub fn new(retention: JetDevtoolsTelemetryRetention) -> JetDevtoolsMetricStore Never! {
        JetDevtoolsMetricStore{capacity: retention.metric_points, max_series: retention.metric_series, retained_series: [JetDevtoolsMetricSeries]{}}
    }
    pub fn register(&self, instrument: JetDevtoolsMetricInstrument) JetDevtoolsTelemetryError! {
        instrument.validate() ?? return Err(err)
        loop series in self.retained_series {
            if series.instrument.name == instrument.name -> return Err(JetDevtoolsTelemetryError.DuplicateInstrument(instrument.name))
        }
        if self.retained_series.len() == self.max_series -> return Err(JetDevtoolsTelemetryError.CapacityExceeded("metric series"))
        &self.retained_series.push(JetDevtoolsMetricSeries.new(instrument, self.capacity))
        &self.retained_series.sort_by(series -> series.instrument.name)
        Ok()
    }
    pub fn series(self) -> View<JetDevtoolsMetricSeries> Never! from self { self.retained_series[0..<self.retained_series.len()] }
    pub fn record(&self, ^point: JetDevtoolsMetricPoint) -> U64 JetDevtoolsTelemetryError! {
        loop i in 0..<self.retained_series.len() {
            if self.retained_series[i].instrument.name == point.instrument -> return &self.retained_series[i].record(^point)
        }
        Err(JetDevtoolsTelemetryError.UnknownInstrument(point.instrument))
    }
    pub fn chart_points(self, instrument: String) -> [JetDevtoolsMetricChartPoint] Never! {
        loop series in self.retained_series {
            if series.instrument.name == instrument -> return series.chart_points()
        }
        [JetDevtoolsMetricChartPoint]{}
    }
    pub fn table_rows(self, instrument: String?) -> [JetDevtoolsMetricTableRow] Never! {
        rows := [JetDevtoolsMetricTableRow]{}
        loop series in self.retained_series {
            if instrument == .Val(name) {
                if name != series.instrument.name -> continue
            }
            loop point in series.points() -> &rows.push(point.table_row())
        }
        rows
    }
}

// Rust:777-884.
#[Equatable, Comparable]
pub enum JetDevtoolsLogLevel {
