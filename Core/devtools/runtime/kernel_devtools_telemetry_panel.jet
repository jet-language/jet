    pub file: String
    pub line: U32
    pub column: U32
    pub function: String
}
impl JetDevtoolsSourceIdentity {
    pub fn new(source_id: String, file: String, line: U32, column: U32, function: String) -> JetDevtoolsSourceIdentity Never! {
        JetDevtoolsSourceIdentity{source_id: source_id, file: file, line: line, column: column, function: function}
    }
    pub fn validate(self) JetDevtoolsTelemetryError! {
        jet_devtools_telemetry_require_text(self.source_id, "source id") ?? return Err(err)
        jet_devtools_telemetry_require_text(self.file, "source file") ?? return Err(err)
        jet_devtools_telemetry_require_text(self.function, "source function")
    }
}
// Rust:197-242. Neither trace ID is invented when untraced.
pub struct JetDevtoolsTelemetryContext {
    pub source: JetDevtoolsSourceIdentity
    pub trace_id: String?
    pub span_id: String?
    pub request_id: String?
}
impl JetDevtoolsTelemetryContext {
    pub fn new(source: JetDevtoolsSourceIdentity, trace_id: String?, span_id: String?, request_id: String?) -> JetDevtoolsTelemetryContext Never! {
        JetDevtoolsTelemetryContext{source: source, trace_id: trace_id, span_id: span_id, request_id: request_id}
    }
    pub fn validate(self) JetDevtoolsTelemetryError! {
        self.source.validate() ?? return Err(err)
        if self.trace_id == .Val(trace) {
            span :: self.span_id ?? return Err(JetDevtoolsTelemetryError.TraceContextIncomplete)
            jet_devtools_telemetry_require_text(trace, "trace id") ?? return Err(err)
            jet_devtools_telemetry_require_text(span, "span id") ?? return Err(err)
        } else if self.span_id != None {
            return Err(JetDevtoolsTelemetryError.TraceContextIncomplete)
        }
        if self.request_id == .Val(request) -> jet_devtools_telemetry_require_text(request, "request id") ?? return Err(err)
        Ok()
    }
    pub fn source_id(self) -> @String Never! from self { @self.source.source_id }
    pub fn is_traced(self) -> Bool Never! { self.trace_id != None }
}

