// Rust:9-17. Capacities are selected-independent bounded counts, not OS facts.
pub JET_DEVTOOLS_TELEMETRY_MAX_TAGS :: 16
pub JET_DEVTOOLS_TELEMETRY_MAX_TEXT_BYTES :: 16384
pub JET_DEVTOOLS_TELEMETRY_MAX_METRIC_SERIES :: 64
pub JET_DEVTOOLS_TELEMETRY_MAX_METRIC_POINTS :: 256
pub JET_DEVTOOLS_TELEMETRY_MAX_LOG_RECORDS :: 256
pub JET_DEVTOOLS_TELEMETRY_MAX_TRACE_SPANS :: 256
pub JET_DEVTOOLS_TELEMETRY_MAX_LINKED_LOGS :: 32
pub JET_DEVTOOLS_TELEMETRY_MAX_SLOW_WORK_ROWS :: 256
pub JET_DEVTOOLS_TELEMETRY_DEFAULT_SLOW_WORK_NS :: U64{100000000}

// Rust:23-69; default is the same development fact.
pub struct JetDevtoolsTelemetryRetention {
    pub metric_series: Int
    pub metric_points: Int
    pub log_records: Int
    pub trace_spans: Int
    pub linked_logs: Int
    pub slow_work_rows: Int
}
fn bounded_count(value: Int, maximum: Int) -> Int Never! {
    if value < 1 -> return 1
    if value > maximum -> return maximum
    value
}
impl JetDevtoolsTelemetryRetention {
    pub fn development() -> JetDevtoolsTelemetryRetention Never! {
        JetDevtoolsTelemetryRetention{metric_series: 64, metric_points: 256, log_records: 256, trace_spans: 256, linked_logs: 32, slow_work_rows: 256}
    }
    pub fn default() -> JetDevtoolsTelemetryRetention Never! { JetDevtoolsTelemetryRetention.development() }
    pub fn bounded(metric_series: Int, metric_points: Int, log_records: Int, trace_spans: Int, linked_logs: Int, slow_work_rows: Int) -> JetDevtoolsTelemetryRetention Never! {
        JetDevtoolsTelemetryRetention{metric_series: bounded_count(metric_series, 64), metric_points: bounded_count(metric_points, 256), log_records: bounded_count(log_records, 256), trace_spans: bounded_count(trace_spans, 256), linked_logs: bounded_count(linked_logs, 32), slow_work_rows: bounded_count(slow_work_rows, 256)}
    }
}

// Rust:72-157. Typed errors retain their exact payloads; message is Display.
#Error
pub enum JetDevtoolsTelemetryError {
    TextTooLong(field: String)
    EmptyIdentity(field: String)
    DuplicateTag(key: String)
    InvalidMetricValue
    InvalidLogValue
    TooManyTags
    TooManyFields
    CapacityExceeded(signal: String)
    UnknownInstrument(name: String)
    DuplicateInstrument(name: String)
    InstrumentMismatch(expected: String, actual: String)
    NonMonotonicTimestamp(previous: U64, actual: U64)
    TraceContextIncomplete
    TraceIdentityMismatch
    SpanIdentityMismatch
    InvalidSpanBounds(start_ns: U64, end_ns: U64)
    TooManyLinkedLogs
    SequenceExhausted(signal: String)
}
impl JetDevtoolsTelemetryError {
    pub fn message(self) -> String Never! {
        if self == {
            .TextTooLong(field) -> "devtools telemetry {field} exceeds 16384 bytes"
            .EmptyIdentity(field) -> "devtools telemetry {field} must not be empty"
            .DuplicateTag(key) -> "devtools telemetry tag `{key}` is duplicated"
            .InvalidMetricValue -> "devtools telemetry metric value must be finite"
            .InvalidLogValue -> "devtools telemetry log value must be finite"
            .TooManyTags -> "devtools telemetry metric has more than 16 tags"
            .TooManyFields -> "devtools telemetry log has more than 16 fields"
            .CapacityExceeded(signal) -> "devtools telemetry {signal} retention capacity is exhausted"
            .UnknownInstrument(name) -> "devtools telemetry instrument `{name}` is not registered"
            .DuplicateInstrument(name) -> "devtools telemetry instrument `{name}` is registered twice"
            .InstrumentMismatch(expected, actual) -> "devtools telemetry point names instrument `{actual}`, expected `{expected}`"
            .NonMonotonicTimestamp(previous, actual) -> "devtools telemetry timestamp moved backward from {previous} to {actual}"
            .TraceContextIncomplete -> "devtools telemetry trace and span ids must be present together"
            .TraceIdentityMismatch -> "devtools telemetry log and span trace ids do not match"
            .SpanIdentityMismatch -> "devtools telemetry log and span ids do not match"
            .InvalidSpanBounds(start_ns, end_ns) -> "devtools telemetry span ends at {end_ns} before start {start_ns}"
            .TooManyLinkedLogs -> "devtools telemetry span has more than 32 linked logs"
            .SequenceExhausted(signal) -> "devtools telemetry {signal} sequence is exhausted"
        }
    }
    // Rust Display::fmt:152; #Error supplies the typed Error identity.
    pub fn show(self) -> String Never! { self.message() }
}

