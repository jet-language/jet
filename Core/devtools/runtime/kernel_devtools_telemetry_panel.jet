        Err(JetDevtoolsTelemetryError.CapacityExceeded("log link"))
    }
    pub fn record_slow_work(&self, span_index: U64, threshold: JetDevtoolsSlowWorkThreshold) -> U64? JetDevtoolsTelemetryError! {
        loop span in self.traces.spans() {
            if span.index == span_index -> return &self.slow_work.record(span, threshold)
        }
        Err(JetDevtoolsTelemetryError.CapacityExceeded("slow-work span"))
    }
    pub fn metric_chart_points(self, instrument: String) -> [JetDevtoolsMetricChartPoint] Never! { self.metrics.chart_points(instrument) }
    pub fn metric_table_rows(self, instrument: String?) -> [JetDevtoolsMetricTableRow] Never! { self.metrics.table_rows(instrument) }
    pub fn query_logs(self, query: JetDevtoolsLogQuery) -> [JetDevtoolsLogQueryRow] Never! { self.logs.query(query) }
    pub fn trace_rows(self) -> [JetDevtoolsTraceRow] Never! { self.traces.rows() }
    pub fn trace_log_links(self, span_index: U64) -> [JetDevtoolsTraceLogLink] Never! { self.traces.linked_logs(span_index, self.logs) }
    pub fn slow_work_rows(self) -> [JetDevtoolsSlowWorkRow] Never! {
        rows := [JetDevtoolsSlowWorkRow]{}
        loop row in self.slow_work.rows() -> &rows.push(row)
        rows
    }
    pub fn to_protocol_events(self, source: String) -> [d.JetDevtoolsEvent] Err! {
        events := [d.JetDevtoolsEvent]{}
        loop series in self.metrics.series() {
            &events.push(series.instrument.to_protocol_event(source) ?? return Err(err))
            loop point in series.points() -> &events.push(point.to_protocol_event(source) ?? return Err(err))
        }
        loop record in self.logs.records() -> &events.push(record.to_protocol_event(source) ?? return Err(err))
        loop span in self.traces.spans() {
            &events.push(span.to_protocol_event(source) ?? return Err(err))
            loop link in linked_logs_for_span(span, self.logs) -> &events.push(link.to_protocol_event(source) ?? return Err(err))
        }
        loop row in self.slow_work.rows() -> &events.push(row.to_protocol_event(source) ?? return Err(err))
        Ok(events)
    }
    pub fn protocol_events(self, source: String) -> [d.JetDevtoolsEvent] Err! { self.to_protocol_events(source) }
}

// Rust:1929-2050. Object field fragments join once: no growing-string loops.
fn jet_devtools_telemetry_require_text(value: String, field: String) JetDevtoolsTelemetryError! {
    if value.is_empty() -> return Err(JetDevtoolsTelemetryError.EmptyIdentity(field))
    if value.count_bytes() > 16384 -> return Err(JetDevtoolsTelemetryError.TextTooLong(field))
    Ok()
}
fn json_field(key: String, rendered: String) -> String Never! { "\"{key}\":{rendered}" }
fn json_object(fields: [String]) -> String Never! { "{{{fields.join(",")}}}" }
fn json_array(values: [String]) -> String Never! { "[{values.join(",")}]" }
fn push_source_json(source: JetDevtoolsSourceIdentity, fields: &[String]) Never! {
    &fields.push(json_field("source_id", jet_devtools_telemetry_json_string(source.source_id)))
    &fields.push(json_field("source_file", jet_devtools_telemetry_json_string(source.file)))
    &fields.push(json_field("source_line", "{source.line}"))
    &fields.push(json_field("source_column", "{source.column}"))
    &fields.push(json_field("source_function", jet_devtools_telemetry_json_string(source.function)))
}
fn jet_devtools_telemetry_push_context_json(identity: JetDevtoolsTelemetryContext, fields: &[String]) Never! {
    if identity.trace_id == .Val(trace) -> &fields.push(json_field("trace_id", jet_devtools_telemetry_json_string(trace)))
    if identity.span_id == .Val(span) -> &fields.push(json_field("span_id", jet_devtools_telemetry_json_string(span)))
    if identity.request_id == .Val(request) -> &fields.push(json_field("request_id", jet_devtools_telemetry_json_string(request)))
}
fn jet_devtools_telemetry_metric_value_json(value: JetDevtoolsMetricValue) -> String Never! {
    if value == {
        .Integer(number) -> "{number}"
        .Float(number) -> "{number}"
    }
}
fn jet_devtools_telemetry_metric_tag_value_json(value: JetDevtoolsMetricTagValue) -> String Never! {
    if value == {
        .Boolean(boolean) -> "{boolean}"
        .Integer(number) -> "{number}"
        .Text(string) -> jet_devtools_telemetry_json_string(string)
    }
}
fn jet_devtools_telemetry_tags_json(tags: [JetDevtoolsMetricTag]) -> String Never! {
    rows := [String]{}
    loop tag in tags -> &rows.push(json_object([String]{json_field("key", jet_devtools_telemetry_json_string(tag.key)), json_field("value", jet_devtools_telemetry_metric_tag_value_json(tag.value))}))
    json_array(rows)
}
fn jet_devtools_telemetry_log_value_json(value: JetDevtoolsLogValue) -> String Never! {
    if value == {
        .Boolean(boolean) -> "{boolean}"
        .Integer(number) -> "{number}"
        .Float(number) -> "{number}"
        .Text(string) -> jet_devtools_telemetry_json_string(string)
    }
}
fn jet_devtools_telemetry_log_fields_json(fields: [JetDevtoolsLogField]) -> String Never! {
    rows := [String]{}
    loop field in fields {
        parts := [String]{json_field("key", jet_devtools_telemetry_json_string(field.key))}
        if field.value == .Val(value) -> &parts.push(json_field("value", jet_devtools_telemetry_log_value_json(value)))
        if field.redacted -> &parts.push("\"redacted\":true")
        &rows.push(json_object(parts))
    }
    json_array(rows)
}
fn jet_devtools_telemetry_optional_string_json(value: String?) -> String Never! {
    if value == .Val(string) -> return jet_devtools_telemetry_json_string(string)
    "null"
}
fn jet_devtools_telemetry_u64_array_json(values: [U64]) -> String Never! {
    rows := [String]{}
    loop value in values -> &rows.push("{value}")
    json_array(rows)
}
fn jet_devtools_telemetry_json_string(value: String) -> String Never! {
    // Rust char::is_control is Unicode General_Category Cc, including DEL/C1.
    // Sole byte-read seam currently materializes (#4318/#4392); allocation
    // parity is gated on its retaining borrowed-result cutover, not claimed here.
    raw :: text.utf8_bytes(value)
    out := [U8]{U8{34}}
    at := 0
    loop at < raw.len() {
        cp :: text.scalar_at(raw, at)
        if cp == 34 || cp == 92 {
            &out.push(U8{92})
            text.append_cp(&out, cp)
        } else if cp == 10 {
            &out.push(U8{92})
            &out.push(U8{110})
        } else if cp == 13 {
            &out.push(U8{92})
            &out.push(U8{114})
        } else if cp == 9 {
            &out.push(U8{92})
            &out.push(U8{116})
        } else if cp == 8 {
            &out.push(U8{92})
            &out.push(U8{98})
        } else if cp == 12 {
            &out.push(U8{92})
            &out.push(U8{102})
        } else if asset.asset_tag(category.UNICODE_GENERAL_CATEGORY, cp, 8) == 0 {
            &out.push(U8{92})
            &out.push(U8{117})
            &out.push(encoding.hex_nibble((cp >> 12) & 15))
            &out.push(encoding.hex_nibble((cp >> 8) & 15))
            &out.push(encoding.hex_nibble((cp >> 4) & 15))
            &out.push(encoding.hex_nibble(cp & 15))
        } else {
            text.append_cp(&out, cp)
        }
        at = at + text.utf8_width_at(raw, at)
    }
    &out.push(U8{34})
    String.from_bytes(out) ?? panic("telemetry JSON string produced invalid UTF-8")
}
