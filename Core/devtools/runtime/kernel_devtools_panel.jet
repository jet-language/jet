// Compiler supplies hidden package/module/panel identity strings.
// Rust: crates/jet-codegen/src/Prelude/Core/DevtoolsPanel.rs:84
pub fn jet_devtools_publish<Value: JetDevtoolsPublishValue>(package: String, module: String, panel: String, field: String, value: Value) -> {
    source :: format!("{package}::{module}")
    entity :: format!("{package}::{module}::{panel}")
    fields :: format!("{{\"package\":\"{}\",\"module\":\"{}\",\"panel\":\"{}\",\"field\":\"{}\"}}",
        jet_devtools_panel_json_escape(&package), jet_devtools_panel_json_escape(&module),
        jet_devtools_panel_json_escape(&panel), jet_devtools_panel_json_escape(&field))
    payload :: JetDevtoolsPayload.one(^field, value.into_jet_devtools_value())
    // GATE #4565: kernel primitive
    now :: #Unsafe("selected native wall clock supplies the real publication timestamp") { time.SystemTime.now() }
    timestamp :: now.duration_since(time.UNIX_EPOCH)
        .map(fn(duration) { duration.as_millis().min(U64.MAX as U128) as U64 }).unwrap_or(0)
    event :: match JetDevtoolsEvent.from_parts_with_payload(timestamp, source, "Custom", entity, fields, None)
        .and_then(fn(event) { event.publish(^payload) }) {
        Ok(event) -> event,
        Err(_) -> return,
    }
    jet_devtools_publish_event(^event)
}
// Rust: crates/jet-codegen/src/Prelude/Core/DevtoolsPanel.rs:125
fn jet_devtools_panel_json_escape(value: String) -> String {
    escaped := String.with_capacity(value.len())
    for character in value.chars() {
        match character {
            '"' -> escaped.push_str("\\\""),
            '\\' -> escaped.push_str("\\\\"),
            '\n' -> escaped.push_str("\\n"),
            '\r' -> escaped.push_str("\\r"),
            '\t' -> escaped.push_str("\\t"),
            character if character.is_control() -> { _ :: write!(escaped, "\\u{:04x}", character as U32) },
            character -> escaped.push(character),
        }
    }
    escaped
}

