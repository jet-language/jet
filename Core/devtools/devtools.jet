
package {
    name: "core.devtools"
    version: "0.0.1"
    edition: "2026"
    description: "Devtools publish channel."
    license: "MIT"
    outputs: {
        devtools: .Library{ entry: devtools }
    }
}
// core.devtools — the typed inspector publication boundary.
//
// The checked `field:`/`value:` form is lowered with package, module, and
// panel identity into the host's canonical `jet.devtools.v1` event. The
// provider validates and constructs that event before fanning it out to every
// installed sink. This unit-returning API does not claim durable delivery:
// when no sink is installed, observation is explicitly unavailable rather
// than reported as a successful persisted write.
