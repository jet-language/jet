// D-SERVICE-JIT1/I9: marshal only at the tier boundary; canonical Prelude owns policy.
use jet_foundation.AST.CtValue
use jet_foundation.Diagnostics.[Diagnostic, Span]
use jet_foundation.MIR.MirRuntimeValue
use jet_codegen.Comptime.ServicesLite as ServicesLite
use jet_codegen.Comptime.SyncLite as SyncLite
use jet_codegen.Comptime.display_core_pure_value
use jet_codegen.Comptime.ServicesLite.[JetServiceEndpoint, JetServiceExecutionScope, JetServiceError]
use core.tasks.runtime.scheduler.[jet_scheduler_wait_without_unwind, jet_std_time_sleep_duration_ns, JetSchedulerWait]
use core.service.runtime.workflow_wait.JetServiceWorkflowWait

// Rust: crates/jet-codegen/src/Prelude/Service.rs:10
fn workflow_wait(nanos: I64) -> JetServiceWorkflowWait<()> {
    // GATE #4565: kernel primitive
    #Unsafe("scheduler records wait outcome without unwinding across the service workflow boundary") {
        match jet_scheduler_wait_without_unwind(fn() { jet_std_time_sleep_duration_ns(nanos) }) {
            .Ready(()) -> .Ready(())
            .Cancelled -> .Cancelled
            .Deadline(reason) -> .Deadline(^reason)
            .Panicked(reason) -> .Panicked(^reason)
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Service.rs:29
fn service_runtime(store: String, retention_ms: I64) -> CtValue {
    runtime :: ServicesLite.jet_services_runtime(^store, retention_ms)
    CtValue.Struct{type_name: "ServiceRuntime",
        fields: [("store", CtValue.Str(^runtime.store)), ("retention_ms", CtValue.Int(runtime.retention_ms))]}
}
// Rust: crates/jet-codegen/src/Prelude/Service.rs:40
fn service_show(value: &CtValue) -> String? {
    ServicesLite.service_show_value(value).or_else(fn() { SyncLite.sync_show_value(value) })
}
// Rust: crates/jet-codegen/src/Prelude/Service.rs:47
fn services_apply_runtime(method: String, args: &[MirRuntimeValue], span: Span) -> MirRuntimeValue Diagnostic! {
    ServicesLite.with_workflow_wait(workflow_wait, fn() { ServicesLite.apply_runtime(method, args, span) })
}
// Rust: crates/jet-codegen/src/Prelude/Service.rs:57
fn services_start_runtime(receiver: &MirRuntimeValue, span: Span,
    dispatch: fn(String, &JetServiceEndpoint) -> () JetServiceError!) -> MirRuntimeValue Diagnostic! {
    ServicesLite.with_workflow_wait(workflow_wait, fn() {
        ServicesLite.apply_runtime_start_with_dispatcher(receiver, span, ^dispatch)
    })
}
// Rust: crates/jet-codegen/src/Prelude/Service.rs:75
fn services_runtime_apply_runtime(receiver: &MirRuntimeValue, method: String, args: &[MirRuntimeValue], span: Span)
    -> MirRuntimeValue Diagnostic! {
    ServicesLite.apply_runtime_method_mir(receiver, method, args, span)
}
// Rust: crates/jet-codegen/src/Prelude/Service.rs:84
fn services_take_mut_runtime(value: MirRuntimeValue) -> (MirRuntimeValue, MirRuntimeValue) MirRuntimeValue! {
    ServicesLite.take_mut_runtime(^value)
}
// Rust: crates/jet-codegen/src/Prelude/Service.rs:90
fn service_runtime_runtime(store: String, retention_ms: I64) -> MirRuntimeValue {
    ServicesLite.service_runtime_value(^store, retention_ms)
}
// Rust: crates/jet-codegen/src/Prelude/Service.rs:94
fn sync_apply_runtime(method: String, args: &[MirRuntimeValue], span: Span) -> MirRuntimeValue Diagnostic! {
    args :: args.iter().map(ServicesLite.runtime_to_ct_value).collect<[CtValue] Diagnostic!>()?
    SyncLite.apply(method, &args, span).and_then(fn(value) { ServicesLite.ct_to_runtime_value(&value) })
}
// Rust: crates/jet-codegen/src/Prelude/Service.rs:107
fn service_endpoint_runtime(value: &MirRuntimeValue) -> JetServiceEndpoint? {
    ServicesLite.service_endpoint_runtime(value)
}
// Rust: crates/jet-codegen/src/Prelude/Service.rs:113
fn jet_services_execution_scope(endpoint: &JetServiceEndpoint) -> JetServiceExecutionScope JetServiceError! {
    ServicesLite.jet_services_execution_scope(endpoint)
}
// Rust: crates/jet-codegen/src/Prelude/Service.rs:122
fn service_display_runtime(value: &MirRuntimeValue) -> String? {
    if ServicesLite.service_display_value_runtime(value) is Val(rendered) -> return Val(^rendered)
    if ServicesLite.service_show_value_runtime(value) is Val(rendered) -> return Val(^rendered)
    value :: ServicesLite.runtime_to_ct_value(value).ok()?
    SyncLite.sync_show_value(&value).or_else(fn() { display_core_pure_value(&value) })
}

