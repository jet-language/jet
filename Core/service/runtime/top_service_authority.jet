fn service_authority_operation_lock(runtime: &JetServiceRuntime,operation: &String) -> ServiceAuthorityFileLock JetServiceError! {
    input := [U8].new()
    store :: service_authority_store_identity(&runtime.store)
    for field in [store.as_bytes(),operation.as_bytes()] {
        input.extend_from_slice(&(field.len() as U64).to_be_bytes())
        input.extend_from_slice(field)
    }
    digest :: sha256_bytes(&input)
    service_authority_file_lock(&runtime.store,&"op-{service_authority_hex(&digest)}")
}
