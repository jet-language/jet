    service_authority_validate_text(&runtime.store,"service store",SERVICE_AUTH_MAX_STORE,false)?
    if runtime.retention_ms < 0 { return Err(JetServiceError.Policy("service retention must be zero or positive")) }
    service_authority_validate_store_path(&runtime.store)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:478
// GATE #4565: kernel primitive
#Unsafe("resolve native current directory then lexically normalize selected-platform path components")
fn service_authority_store_identity(store: &String) -> String {
    path :: OSPath.from(store)
    absolute :: if path.is_absolute() { path.to_path_buf() } else { env.current_dir().map(fn(directory) { directory.join(&path) }).unwrap_or_else(fn(_) { path.to_path_buf() }) }
    normalized := OSPath.new()
    for component in absolute.components() {
        match component {
            Component.CurDir -> {},
            Component.ParentDir -> { _ :: normalized.pop() },
            component -> normalized.push(component.as_os_str())
        }
    }
    normalized.to_string_lossy().into_owned()
}
