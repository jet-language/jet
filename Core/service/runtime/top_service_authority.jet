        if target.selected_family() == "unix" { options.mode(0o600) }
        match options.open(&path) {
            Ok(file) -> {
                marker :: service_authority_now().to_string()
                file.write_all(marker.as_bytes()).map_err(fn(error) { service_authority_error("could not initialize service lock: {error}") })?
                file.sync_all().map_err(fn(error) { service_authority_error("could not commit service lock: {error}") })?
                return Ok(ServiceAuthorityFileLock{path})
            },
            Err(error) -> {
                if error.kind() == ErrorKind.AlreadyExists {
                    now :: service_authority_now()
                    stale :: fs.metadata(&path).and_then(fn(metadata) { metadata.modified() }).ok()
                        .and_then(fn(modified) { modified.elapsed().ok() })
                        .is_some_and(fn(age) { age >= Duration.from_millis(SERVICE_AUTH_LOCK_STALE_MS as U64) })
                    if stale { _ :: fs.remove_file(&path); continue }
                    if now.saturating_sub(started) >= SERVICE_AUTH_LOCK_TIMEOUT_MS {
                        return Err(service_authority_error("service authority lock remained held beyond its recovery budget"))
                    }
                    sleep(Duration.from_millis(1))
                } else { return Err(service_authority_error("could not create service authority lock: {error}")) }
            }
        }
    }
}
