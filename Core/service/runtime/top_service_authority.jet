pub fn jet_services_endpoint_receive(endpoint: &JetServiceEndpoint) -> String JetServiceError! {
    service_authority_validate_endpoint(endpoint)?
    (started,draining,channel) :: service_authority_channel(endpoint)?
    if !started && (!draining || channel.depth() == 0) { return Err(JetServiceError.NotStarted("service worker is not running")) }
    match channel.try_recv() {
        Ok(message) -> Ok(^message),
        Err(JetServiceChannelError.Empty) -> Err(JetServiceError.Ambiguous("service endpoint mailbox is empty")),
        Err(JetServiceChannelError.Closed) -> Err(JetServiceError.NotStarted("service endpoint mailbox is closed")),
        Err(JetServiceChannelError.Full(_)) -> Err(JetServiceError.Policy("service channel returned an invalid receive result"))
    }
}
