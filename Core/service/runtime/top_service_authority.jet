// GATE #4565: kernel primitive
#Unsafe("validate exact issued identity while endpoint registry is locked")
fn service_authority_require_registered_endpoint(endpoint: &JetServiceEndpoint) -> () JetServiceError! {
    service_authority_validate_endpoint(endpoint)?
    key :: service_endpoint_key(&endpoint.authority,&endpoint.worker,endpoint.generation)
    registry :: service_endpoint_registry().lock().map_err(fn(_) { service_authority_error("service endpoint registry lock is poisoned") })?
    state :: registry.get(&key).ok_or_else(fn() { JetServiceError.Revoked("service endpoint authority was not issued in this process") })?
    if state.tree != endpoint.tree || state.worker != endpoint.worker || state.authority != endpoint.authority || state.generation != endpoint.generation {
        return Err(JetServiceError.Revoked("service endpoint authority does not match its issued identity"))
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:600
fn service_authority_validate_opaque_token(value: &String) -> () JetServiceError! {
    token :: value.strip_prefix(SERVICE_AUTHORITY_TOKEN_PREFIX)
        .filter(fn(token) { token.len() == SERVICE_AUTHORITY_TOKEN_BYTES*2 })
        .filter(fn(token) { token.bytes().all(fn(byte) { byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase() }) })
        .ok_or_else(fn() { JetServiceError.Policy("service authority must be a provider-issued opaque token") })?
    if token.is_empty() { return Err(JetServiceError.Policy("service authority must be a provider-issued opaque token")) }
    Ok(())
}
