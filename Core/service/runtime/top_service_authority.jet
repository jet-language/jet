fn service_authority_validate_text(value: &String,label: &String,max: USize,allow_empty: Bool) -> () JetServiceError! {
    if (!allow_empty && value.is_empty()) || value.len() > max || value.chars().any(fn(c) { c.is_control() }) {
        return Err(JetServiceError.Policy("{label} is empty, too long, or contains control characters"))
    }
    Ok(())
}
