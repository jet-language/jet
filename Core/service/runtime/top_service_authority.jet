fn service_authority_retention_deadline(now: I64,retention_ms: I64) -> I64 {
    if retention_ms == 0 { I64.MAX } else { now.saturating_add(retention_ms) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:508
fn service_authority_entry_expired(entry: &ServiceAuthorityEntry,now: I64) -> Bool {
    entry.state != JetDeliveryState.DeadLettered && entry.state != JetDeliveryState.Cancelled &&
        match entry.retained_until { Some(until) -> until <= now, None -> entry.expires <= now }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:518
// GATE #4565: kernel primitive
// #4409: distinguish NotFound from other inspection errors; never follow symlinks.
#Unsafe("inspect store and every ancestor with symlink_metadata, without following links")
fn service_authority_validate_store_path(store: &String) -> () JetServiceError! {
    path :: OSPath.from(store)
    match fs.symlink_metadata(&path) {
        Ok(metadata) -> {
            if metadata.file_type().is_symlink() || !metadata.file_type().is_file() {
                return Err(JetServiceError.Policy("service authority store must be a regular file, not a symlink"))
            }
        },
        Err(error) -> {
            if error.kind() != ErrorKind.NotFound { return Err(service_authority_error("could not inspect service authority store: {error}")) }
        }
    }
    parent := path.parent()
    while Some(directory) :: parent {
        match fs.symlink_metadata(directory) {
            Ok(metadata) -> {
                if metadata.file_type().is_symlink() || !metadata.is_dir() {
                    return Err(JetServiceError.Policy("service authority store parent must be a real directory"))
                }
            },
            Err(error) -> {
                if error.kind() != ErrorKind.NotFound { return Err(service_authority_error("could not inspect service store parent: {error}")) }
            }
        }
        parent = directory.parent()
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:555
fn service_authority_validate_endpoint(endpoint: &JetServiceEndpoint) -> () JetServiceError! {
    service_authority_validate_text(&endpoint.tree,"service tree",256,false)?
    service_authority_validate_text(&endpoint.worker,"service worker",256,false)?
    service_authority_validate_opaque_token(&endpoint.authority)?
    _ :: service_authority_signing_key(&endpoint.authority)?
    if endpoint.generation < 1 { return Err(JetServiceError.Policy("service endpoint generation must be positive")) }
    Ok(())
}
