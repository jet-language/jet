        Ok(()) -> Ok(()),
        Err(JetServiceChannelError.Full(_)) -> Err(JetServiceError.Full("service endpoint mailbox is full")),
        Err(JetServiceChannelError.Closed) -> Err(JetServiceError.NotStarted("service endpoint mailbox is closed")),
        Err(JetServiceChannelError.Empty) -> Err(JetServiceError.Policy("service channel returned an invalid send result"))
