// GATE #4565: kernel primitive
#Unsafe("exclusive create lock with private Unix mode, fsync, stale recovery and bounded native wait")
fn service_authority_file_lock(store: &String,suffix: &String) -> ServiceAuthorityFileLock JetServiceError! {
    service_authority_validate_store_path(store)?
    path :: OSPath.from("{store}.{suffix}.lock")
    if Some(parent) :: path.parent().filter(fn(parent) { !parent.as_os_str().is_empty() }) {
        fs.create_dir_all(parent).map_err(fn(error) { service_authority_error("could not create service lock directory: {error}") })?
    }
    started :: service_authority_now()
    loop {
