    }
    if started && new_state.partitioned { return Err(JetServiceError.Partitioned("new service endpoint authority is partitioned")) }
    new_state.generation = new_endpoint.generation
    new_state.started = started
    new_state.draining = draining
    new_state.partitioned = false
    new_state.channel = new_endpoint.channel.clone().or_else(fn() { old_state.channel.clone() })
