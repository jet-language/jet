            }
            return Err(JetServiceError.Partitioned("service endpoint authority is not registered"))
        }
    }
    if state.tree != endpoint.tree || state.worker != endpoint.worker { return Err(JetServiceError.Revoked("service endpoint authority does not match its tree")) }
    if state.partitioned { return Err(JetServiceError.Partitioned("service endpoint authority is partitioned")) }
    if state.generation != endpoint.generation { return Err(JetServiceError.Stale("service endpoint generation {endpoint.generation} is not current (current generation {state.generation})")) }
    if !state.started { return Err(JetServiceError.NotStarted("service worker `{endpoint.worker}` is not running")) }
    if state.draining { return Err(JetServiceError.NotStarted("service endpoint is draining")) }
    channel :: state.channel.clone().or_else(fn() { endpoint.channel.clone() }).ok_or_else(fn() { JetServiceError.Partitioned("service endpoint mailbox is not connected") })?
