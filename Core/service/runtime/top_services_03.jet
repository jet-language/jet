// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:5310
// Apply to replayed durable state first. A rejected record never reaches the file.
// Workflow file locks order processes; append also takes the shared process lock.
fn jet_services_workflow_append(tree: &JetServiceTree, payload: String) -> () JetServiceError! {
    authority :: jet_services_workflow_authority(tree)?
    _workflow_lock :: service_authority_file_lock(&authority.store, "workflow")?
    applied := jet_services_workflow_replay(&authority)?
    loop durable in &applied {
        if Some(current) :: tree.workflows.iter().find(fn(workflow) { workflow.run_id == durable.run_id }) {
            durable.replay_cursor = current.replay_cursor
        }
    }
    if applied != tree.workflows {
        return Err(jet_services_state_error("in-memory workflow history does not match the durable workflow log"))
    }
    jet_services_workflow_apply(&applied, &payload)?
    if applied.len() > MAX_SERVICE_WORKFLOW_STEPS -> return Err(JetServiceError.Policy("workflow run limit exceeded"))
    record :: jet_services_state_record(&"v{authority.version}:", &payload)
    jet_services_state_store_append(&authority, &record)?
    tree.workflows = ^applied
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:5343
fn jet_services_workflow_append_handle(handle: &JetWorkflowHandle, payload: String) -> () JetServiceError! {
    _workflow_lock :: service_authority_file_lock(&handle.authority.store, "workflow")?
    applied := jet_services_workflow_replay(&handle.authority)?
    // GATE #4565: kernel primitive
    #Unsafe("hold workflow handle state mutex during durable replay comparison, append and cursor commit") {
        state := handle.state.lock().map_err(fn(_) { JetServiceError.Policy("workflow handle state lock is poisoned") })?
        run_id :: state.run_id
        index :: applied.iter().position(fn(workflow) { workflow.run_id == run_id })
            .ok_or_else(fn() { JetServiceError.Unknown("workflow run {run_id} not found") })?
        applied[index].replay_cursor = state.replay_cursor
        if applied[index] != *state {
            return Err(jet_services_state_error("workflow handle history does not match the durable workflow log"))
        }
        jet_services_workflow_apply(&applied, &payload)?
        record :: jet_services_state_record(&"v{handle.authority.version}:", &payload)
        jet_services_state_store_append(&handle.authority, &record)?
        *state = applied.into_iter().find(fn(workflow) { workflow.run_id == run_id })
            .ok_or_else(fn() { jet_services_state_error("workflow handle disappeared after append") })?
        state.replay_cursor = state.history.len()
        Ok(())
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:5375
fn jet_services_workflow_store_load(tree: &JetServiceTree) -> [JetServiceWorkflow] JetServiceError! {
    authority :: jet_services_workflow_authority(tree)?
    jet_services_workflow_replay(&authority)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:5382
fn jet_services_workflow_start_id(tree: &JetServiceTree, id: String, version: I64) -> I64 JetServiceError! {
    if !tree.started -> return Err(JetServiceError.NotStarted("service tree is not started"))
    jet_services_workflow_sync_tree(tree)?
    if id.trim().is_empty() || id.chars().any(fn(c) { c.is_control() }) || id.len() > MAX_SERVICE_NAME {
        return Err(JetServiceError.Policy("workflow id must be non-empty and visible"))
    }
    if version < 1 -> return Err(JetServiceError.Policy("workflow version must be >= 1"))
    if Some(existing) :: tree.workflows.iter_mut().find(fn(workflow) { workflow.id == id && workflow.version == version }) {
        // Begin a deterministic replay pass; new decisions may append after recorded history ends.
        existing.replay_cursor = 1
        return Ok(existing.run_id)
    }
    if tree.workflows.iter().any(fn(workflow) { workflow.id == id && workflow.version != version && workflow.outcome.is_none() }) {
        return Err(JetServiceError.Policy("workflow `{id}` already has a different active version"))
    }
    run_id :: tree.workflows.iter().map(fn(workflow) { workflow.run_id }).max().unwrap_or(0).checked_add(1)
        .ok_or_else(fn() { JetServiceError.Policy("workflow run id exhausted") })?
    jet_services_workflow_append(tree, "workflow-start:{run_id}:{version}:{jet_services_workflow_frame(&id)}")?
    if Some(workflow) :: tree.workflows.iter_mut().find(fn(workflow) { workflow.run_id == run_id }) -> workflow.replay_cursor = 1
    Ok(run_id)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:5444
fn jet_services_workflow_start(tree: &JetServiceTree, id: String, version: I64) -> JetWorkflowHandle JetServiceError! {
    run_id :: jet_services_workflow_start_id(tree, ^id, version)?
    jet_services_workflow_handle(tree, run_id)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:5453
fn jet_services_workflow_sleep(handle: &JetWorkflowHandle, nanos: I64) -> () JetServiceError! {
    expected :: "sleep:{nanos}"
    // GATE #4565: kernel primitive
    #Unsafe("consume recorded wait decision under handle mutex, releasing it before scheduler wait") {
        workflow := handle.state.lock().map_err(fn(_) { JetServiceError.Policy("workflow handle state lock is poisoned") })?
        if workflow.replay_cursor != 0 {
            if jet_services_workflow_replay_event(&workflow, &expected)? {
                match workflow.history.get(workflow.replay_cursor).map(fn(entry) { entry.as_str() }) {
                    Some("sleep-cancelled") -> {
                        workflow.replay_cursor += 1
                        workflow.status = JetTaskStatus.CancelRequested
                        workflow.outcome = Some(JetTaskOutcome.Cancelled)
                        return Err(JetServiceError.Policy("workflow sleep was cancelled"))
                    }
                    Some("sleep-deadline") -> {
                        workflow.replay_cursor += 1
                        workflow.status = JetTaskStatus.Paused
                        workflow.outcome = Some(JetTaskOutcome.DeadlineBlown)
                        return Err(JetServiceError.Policy("workflow sleep deadline expired"))
                    }
                    _ -> {}
                }
                return Ok(())
            }
        } else {
            workflow.replay_cursor = workflow.history.len()
        }
    }
    jet_services_workflow_append_handle(handle, "workflow-wait-sleep:{jet_services_workflow_run_id(handle)}:{nanos}")?
    match core.service.runtime.service.workflow_wait(nanos) {
        core.service.runtime.workflow_wait.JetServiceWorkflowWait.Ready(()) -> Ok(())
        core.service.runtime.workflow_wait.JetServiceWorkflowWait.Cancelled -> {
            jet_services_workflow_append_handle(handle, "workflow-wait-sleep-cancelled:{jet_services_workflow_run_id(handle)}")?
            Err(JetServiceError.Policy("workflow sleep was cancelled"))
        }
        core.service.runtime.workflow_wait.JetServiceWorkflowWait.Deadline(_) -> {
            jet_services_workflow_append_handle(handle, "workflow-wait-sleep-deadline:{jet_services_workflow_run_id(handle)}")?
            Err(JetServiceError.Policy("workflow sleep deadline expired"))
        }
        core.service.runtime.workflow_wait.JetServiceWorkflowWait.Panicked(reason) -> Err(JetServiceError.Policy("workflow sleep failed: {reason}"))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:5525
fn jet_services_workflow_activity_wait(handle: &JetWorkflowHandle, activity: String, argument: String) -> String JetServiceError! {
    jet_services_workflow_token(&activity, "activity", MAX_SERVICE_NAME)?
    if argument.len() > MAX_SERVICE_MESSAGE || argument.chars().any(fn(c) { c.is_control() }) {
        return Err(JetServiceError.Policy("workflow activity argument is outside the bounded visible range"))
