fn service_state_temp_sequence() -> U64 {
    // GATE #4565: kernel primitive
    #Unsafe("initialize and increment atomic temporary filename sequence with relaxed ordering") {
        SERVICE_STATE_TEMP_SEQUENCE.get_or_init(fn() { AtomicU64.new(0) }).fetch_add(1, Ordering.Relaxed)
    }
}
