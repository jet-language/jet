// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3798
fn jet_services_rollout_store_load(tree: &JetServiceTree) -> JetServiceRolloutState? JetServiceError! {
    if tree.state_authority.is_none() -> return Ok(None)
    authority :: tree.state_authority.as_ref().unwrap()
    path :: jet_services_rollout_path(authority)?
    // GATE #4565: kernel primitive
    #Unsafe("serialize rollout journal reads with the retained authority mutex and file lock") {
        _guard :: service_authority_lock().lock().map_err(fn(_) { jet_services_state_error("service rollout lock is poisoned") })?
        _file_lock :: service_authority_file_lock(&path, "rollout")?
        rollout_path :: OSPath.new(&path)
        if !rollout_path.exists() -> return Ok(None)
        info :: metadata(rollout_path).map_err(fn(error) { jet_services_state_error("cannot inspect service rollout journal: {error}") })?
        if info.len() > (MAX_SERVICE_ROLLOUT_BYTES as U64) {
            return Err(jet_services_state_error("service rollout journal exceeds its byte limit"))
        }
        file := File.open(rollout_path).map_err(fn(error) { jet_services_state_error("cannot open service rollout journal: {error}") })?
        bytes := [U8].new()
        Read.read_to_end(&file, &bytes).map_err(fn(error) { jet_services_state_error("cannot read service rollout journal: {error}") })?
        jet_services_rollout_decode(&tree.name, &bytes).map(fn(state) { Some(^state) })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3831
fn jet_services_rollout_store_write(tree: &JetServiceTree) -> () JetServiceError! {
    if tree.state_authority.is_none() -> return Ok(())
    authority :: tree.state_authority.as_ref().unwrap()
    path :: jet_services_rollout_path(authority)?
    bytes :: jet_services_rollout_encode(&tree.name, &jet_services_rollout_snapshot(tree))?
    // GATE #4565: kernel primitive
    #Unsafe("atomically publish a synced private rollout journal under authority locks; clean failed temporary files") {
        _guard :: service_authority_lock().lock().map_err(fn(_) { jet_services_state_error("service rollout lock is poisoned") })?
        _file_lock :: service_authority_file_lock(&path, "rollout")?
        rollout_path :: OSPath.new(&path)
        if Some(parent) :: rollout_path.parent().filter(fn(parent) { !parent.as_os_str().is_empty() }) {
            create_dir_all(parent).map_err(fn(error) { jet_services_state_error("cannot create service rollout directory: {error}") })?
        }
        jet_services_state_validate_path(rollout_path)?
        temporary :: OSPath.from("{path}.jet-rollout-{id()}-{service_authority_now()}-{service_state_temp_sequence()}")
        result :: (fn() -> () JetServiceError! {
            options := OpenOptions.new()
            options.write(true).create_new(true)
            if selected_family() == "unix" -> options.mode(0o600)
            file := options.open(&temporary).map_err(fn(error) { jet_services_state_error("cannot create temporary rollout journal: {error}") })?
            Write.write_all(&file, &bytes).map_err(fn(error) { jet_services_state_error("cannot write service rollout journal: {error}") })?
            Write.flush(&file).map_err(fn(error) { jet_services_state_error("cannot flush service rollout journal: {error}") })?
            file.sync_all().map_err(fn(error) { jet_services_state_error("cannot sync service rollout journal: {error}") })?
            rename(&temporary, rollout_path).map_err(fn(error) { jet_services_state_error("cannot publish service rollout journal: {error}") })?
            Ok(())
        })()
        if result.is_err() -> _ :: remove_file(&temporary)
        result
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3889
fn jet_services_restore_rollout_state(tree: &JetServiceTree) -> () JetServiceError! {
    loaded :: jet_services_rollout_store_load(tree)?
    if loaded.is_none() -> return Ok(())
    state :: loaded.unwrap()
    if state.workers.len() != tree.workers.len() {
        return Err(jet_services_state_error("rollout journal worker topology does not match the service declaration"))
    }
    receipt :: state.last_upgrade.clone()
    if Some(receipt) :: &receipt {
        if receipt.rollback_available {
            authority :: tree.state_authority.as_ref().ok_or_else(fn() { jet_services_state_error("rollout receipt has no state authority") })?
            expected_store :: jet_services_rollback_store_path(authority, receipt.from_generation)?
            if receipt.rollback_store != expected_store {
                return Err(jet_services_state_error("rollout receipt names a rollback store outside its state authority"))
            }
            jet_services_state_validate_path(OSPath.new(&receipt.rollback_store))?
            // GATE #4565: kernel primitive
            #Unsafe("inspect the rollback store without substituting in-memory state") {
                if !OSPath.new(&receipt.rollback_store).is_file() {
                    return Err(jet_services_state_error("rollout receipt names a missing rollback store"))
                }
            }
            rollback_authority := authority.clone()
            rollback_authority.store = receipt.rollback_store.clone()
            _ :: jet_services_state_store_load(&rollback_authority, &tree.state_adapter)?
        }
    }
    worker_generations := [I64].with_capacity(tree.workers.len())
    loop worker in &tree.workers {
        (_, generation) :: state.workers.iter().find(fn(entry) { entry.0 == worker.name })
            .ok_or_else(fn() { jet_services_state_error("rollout journal is missing worker {worker.name}") })?
        worker_generations.push(*generation)
    }
    restored_directory := [(String, String, I64)].with_capacity(state.directory.len())
    loop (name, worker_name, generation) in &state.directory {
        worker_generation :: state.workers.iter().find(fn(entry) { &entry.0 == worker_name })
            .map(fn(entry) { entry.1 })
            .ok_or_else(fn() { jet_services_state_error("rollout journal directory entry {name} names an unknown worker") })?
        if worker_generation != *generation {
            return Err(jet_services_state_error("rollout journal directory generation is inconsistent"))
        }
        _worker :: tree.workers.iter().find(fn(worker) { &worker.name == worker_name })
            .ok_or_else(fn() { jet_services_state_error("rollout journal directory entry {name} names an unknown worker") })?
        restored_directory.push((name.clone(), worker_name.clone(), *generation))
    }
    tree.generation = state.generation
    tree.previous_generation = state.previous_generation
    tree.last_upgrade = ^receipt
    tree.draining = ^state.draining
    tree.partitioned = ^state.partitioned
    loop (worker, generation) in tree.workers.iter_mut().zip(^worker_generations) {
        worker.endpoint.generation = generation
        worker.mailbox.endpoint = worker.endpoint.clone()
        service_authority_register(&worker.endpoint, false)?
        jet_services_authority_update_partitioned(&worker.endpoint, tree.partitioned.iter().any(fn(name) { name == &worker.name }))?
        jet_services_authority_update_draining(&worker.endpoint, tree.draining.iter().any(fn(name) { name == &worker.name }))?
    }
    tree.directory.clear()
    loop (name, worker_name, generation) in ^restored_directory {
        worker :: tree.workers.iter().find(fn(worker) { worker.name == worker_name })
            .ok_or_else(fn() { JetServiceError.Unknown("restored directory worker disappeared") })?
        if worker.endpoint.generation != generation {
            return Err(jet_services_state_error("rollout journal directory generation does not match its worker"))
        }
        endpoint :: worker.endpoint.clone()
        signature :: service_authority_sign_directory(&tree.authority, &tree.name, &name, &endpoint)?
        tree.directory.push((^name, ^endpoint, ^signature))
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4006
fn jet_services_state_read_line(bytes: &[U8], offset: &USize, label: &String) -> String JetServiceError! {
    rest :: bytes.get(*offset..).ok_or_else(fn() { jet_services_state_error("{label} is truncated") })?
    end :: rest.iter().position(fn(byte) { *byte == 10 }).ok_or_else(fn() { jet_services_state_error("{label} is truncated") })?
    line :: from_utf8(&rest[..end]).map_err(fn(_) { jet_services_state_error("{label} is not valid UTF-8") })?
    *offset = offset.saturating_add(end + 1)
    Ok(line.to_string())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4024
fn jet_services_state_read_frame(bytes: &[U8], offset: &USize, label: &String) -> String JetServiceError! {
    start :: *offset
    rest :: bytes.get(start..).ok_or_else(fn() { jet_services_state_error("{label} is truncated") })?
    colon :: rest.iter().position(fn(byte) { *byte == 58 }).ok_or_else(fn() { jet_services_state_error("{label} length is missing") })?
    length :: from_utf8(&rest[..colon]).ok().and_then(fn(text) { text.parse<USize>().ok() })
        .ok_or_else(fn() { jet_services_state_error("{label} length is invalid") })?
    if length > MAX_SERVICE_MESSAGE -> return Err(jet_services_state_error("{label} exceeds the state record limit"))
    payload_start :: start.checked_add(colon + 1).ok_or_else(fn() { jet_services_state_error("{label} offset overflow") })?
    payload_end :: payload_start.checked_add(length).ok_or_else(fn() { jet_services_state_error("{label} length overflows the store") })?
    payload :: bytes.get(payload_start..payload_end).ok_or_else(fn() { jet_services_state_error("{label} is truncated") })?
    value :: from_utf8(payload).map_err(fn(_) { jet_services_state_error("{label} is not valid UTF-8") })?
    *offset = payload_end
    Ok(value.to_string())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4061
fn jet_services_state_encode(authority: &JetServiceStateAuthority, adapter: &JetServiceStateAdapter, records: &[String]) -> [U8] JetServiceError! {
    if records.len() > MAX_SERVICE_STATE_RECORDS || adapter == JetServiceStateAdapter.Snapshot && records.len() > 1 {
        return Err(JetServiceError.Policy("service state record limit exceeded"))
    }
    prefix :: "v{authority.version}:"
    bytes := jet_services_state_header(authority, adapter)
    loop record in records {
        jet_services_read_state_record(&prefix, record)?
        if record.len() > MAX_SERVICE_MESSAGE || record.chars().any(fn(c) { c.is_control() }) {
            return Err(JetServiceError.Policy("service state record contains invalid bytes"))
        }
        bytes.extend_from_slice(&jet_services_state_frame(record))
        if bytes.len() > MAX_SERVICE_STATE_BYTES -> return Err(JetServiceError.Policy("service state store exceeds its byte limit"))
    }
    Ok(bytes)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4092
fn jet_services_state_decode(authority: &JetServiceStateAuthority, adapter: &JetServiceStateAdapter, bytes: &[U8]) -> [String] JetServiceError! {
    if bytes.len() > MAX_SERVICE_STATE_BYTES -> return Err(jet_services_state_error("service state store exceeds its byte limit"))
    offset := 0
    if jet_services_state_read_line(bytes, &offset, "state magic")? != "JET-SERVICE-STATE/1" {
        return Err(jet_services_state_error("service state magic is invalid"))
    }
    expected_adapter :: "adapter:{jet_services_state_adapter_name(adapter)}"
    if jet_services_state_read_line(bytes, &offset, "state adapter")? != expected_adapter {
        return Err(jet_services_state_error("service state adapter does not match the declared adapter"))
    }
    schema_line :: jet_services_state_read_line(bytes, &offset, "state schema")?
    schema_prefix :: "schema:"
    schema_meta :: schema_line.strip_prefix(schema_prefix).ok_or_else(fn() { jet_services_state_error("service state schema header is invalid") })?
    (schema_len_text, schema) :: schema_meta.split_once(':').ok_or_else(fn() { jet_services_state_error("service state schema length is invalid") })?
    schema_len :: schema_len_text.parse<USize>().map_err(fn(_) { jet_services_state_error("service state schema length is invalid") })?
    if schema_len != schema.len() || schema_len != authority.schema.len() || schema_len > MAX_SERVICE_STATE_SCHEMA {
        return Err(jet_services_state_error("service state schema length does not match the authority"))
    }
    if schema != authority.schema -> return Err(jet_services_state_error("service state schema does not match the authority"))
    version_line :: jet_services_state_read_line(bytes, &offset, "state version")?
    version :: version_line.strip_prefix("version:").and_then(fn(text) { text.parse<I64>().ok() })
        .ok_or_else(fn() { jet_services_state_error("service state version is invalid") })?
    if version != authority.version {
        return Err(jet_services_state_error("service state version {version} does not match authority version {authority.version}"))
    }
    migration_line :: jet_services_state_read_line(bytes, &offset, "state migration")?
    migration_meta :: migration_line.strip_prefix("migration:").ok_or_else(fn() { jet_services_state_error("state migration header is invalid") })?
    (migration_len_text, migration) :: migration_meta.split_once(':').ok_or_else(fn() { jet_services_state_error("state migration length is invalid") })?
    migration_len :: migration_len_text.parse<USize>().map_err(fn(_) { jet_services_state_error("state migration length is invalid") })?
    if migration_len != migration.len() || migration_len > 32 {
        return Err(jet_services_state_error("state migration length does not match the authority"))
    }
    if migration != authority.migration -> return Err(jet_services_state_error("state migration policy does not match the authority"))
    prefix :: "v{authority.version}:"
    records := [String].new()
    loop offset < bytes.len() {
        if records.len() >= MAX_SERVICE_STATE_RECORDS -> return Err(jet_services_state_error("service state record limit exceeded"))
        record :: jet_services_state_read_frame(bytes, &offset, "state record")?
        jet_services_read_state_record(&prefix, &record)?
        records.push(^record)
    }
    if adapter == JetServiceStateAdapter.Snapshot && records.len() > 1 {
        return Err(jet_services_state_error("snapshot store contains more than one record"))
    }
    Ok(records)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4189
fn jet_services_state_store_read_unlocked(authority: &JetServiceStateAuthority, adapter: &JetServiceStateAdapter) -> [String] JetServiceError! {
    path :: OSPath.new(&authority.store)
    jet_services_state_validate_path(path)?
    // GATE #4565: kernel primitive
    #Unsafe("read real state file and preserve metadata limits and native IO errors") {
        if !path.exists() -> return Ok([])
        info :: metadata(path).map_err(fn(error) { jet_services_state_error("cannot inspect service state store: {error}") })?
        if info.len() > (MAX_SERVICE_STATE_BYTES as U64) -> return Err(jet_services_state_error("service state store exceeds its byte limit"))
        file := File.open(path).map_err(fn(error) { jet_services_state_error("cannot open service state store: {error}") })?
        bytes := [U8].new()
        Read.read_to_end(&file, &bytes).map_err(fn(error) { jet_services_state_error("cannot read service state store: {error}") })?
        jet_services_state_decode(authority, adapter, &bytes)
    }
}
