            .ok_or_else(fn() { jet_services_state_error("workflow all wait has no start record") })?
        if workflow.outcome.is_some() -> return Err(jet_services_state_error("workflow all wait follows a terminal workflow outcome"))
        workflow.history.push("all:{values.join(",")}")
        workflow.status = JetTaskStatus.Running
    } else if Some(fields) :: payload.strip_prefix("workflow-activity:") {
