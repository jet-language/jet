fn jet_services_rollout_path(authority: &JetServiceStateAuthority) -> String JetServiceError! {
    path :: "{authority.store}.rollout"
    service_authority_validate_text(&path, "service rollout journal", MAX_SERVICE_STATE_STORE, false)?
    jet_services_state_validate_path(OSPath.new(&path))?
    Ok(path)
}
