fn jet_services_workflow_field(input: &String, label: &String) -> &String JetServiceError! {
    (length_text, value) :: input.split_once(':').ok_or_else(fn() { jet_services_state_error("workflow {label} length is missing") })?
    length :: length_text.parse<USize>().map_err(fn(_) { jet_services_state_error("workflow {label} length is invalid") })?
    if length != value.len() || value.chars().any(fn(c) { c.is_control() }) {
