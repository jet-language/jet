// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4667
fn jet_services_workflow_take_field(input: &String, label: &String) -> (&String, &String) JetServiceError! {
    (length_text, tail) :: input.split_once(':').ok_or_else(fn() { jet_services_state_error("workflow {label} length is missing") })?
    length :: length_text.parse<USize>().map_err(fn(_) { jet_services_state_error("workflow {label} length is invalid") })?
    value :: tail.get(..length).ok_or_else(fn() { jet_services_state_error("workflow {label} length is not a character boundary") })?
    rest :: tail.get(length..).ok_or_else(fn() { jet_services_state_error("workflow {label} length is invalid") })?
    if value.chars().any(fn(c) { c.is_control() }) -> return Err(jet_services_state_error("workflow {label} contains control characters"))
