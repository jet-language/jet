fn jet_services_rollout_operation_lock(tree: &JetServiceTree) -> ServiceAuthorityFileLock? JetServiceError! {
    if Some(authority) :: tree.state_authority.as_ref() {
        return service_authority_file_lock(&authority.store, "rollout-operation").map(fn(lock) { Some(^lock) })
    }
    Ok(None)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3770
fn jet_services_rollout_store_assert_current(tree: &JetServiceTree) -> () JetServiceError! {
    if Some(persisted) :: jet_services_rollout_store_load(tree)? {
        if persisted != jet_services_rollout_snapshot(tree) {
            return Err(JetServiceError.Stale("service rollout state changed since this controller started"))
        }
    }
    Ok(())
}
