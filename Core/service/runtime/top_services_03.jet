// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4234
fn jet_services_state_store_write_unlocked(authority: &JetServiceStateAuthority, adapter: &JetServiceStateAdapter, records: &[String]) -> () JetServiceError! {
    bytes :: jet_services_state_encode(authority, adapter, records)?
    path :: OSPath.new(&authority.store)
    jet_services_state_validate_path(path)?
    // GATE #4565: kernel primitive
    #Unsafe("create a private state temporary file, sync and rename atomically; remove failed temporaries") {
        if Some(parent) :: path.parent().filter(fn(parent) { !parent.as_os_str().is_empty() }) {
            create_dir_all(parent).map_err(fn(error) { jet_services_state_error("cannot create service state directory: {error}") })?
        }
        // Check again after creating missing directories, without claiming a cross-process filesystem lock.
        jet_services_state_validate_path(path)?
        temporary :: OSPath.from("{authority.store}.jet-state-{id()}-{service_authority_now()}-{service_state_temp_sequence()}")
        result :: (fn() -> () JetServiceError! {
            options := OpenOptions.new()
            options.write(true).create_new(true)
            if selected_family() == "unix" -> options.mode(0o600)
            file := options.open(&temporary).map_err(fn(error) { jet_services_state_error("cannot create temporary state store: {error}") })?
            Write.write_all(&file, &bytes).map_err(fn(error) { jet_services_state_error("cannot write service state store: {error}") })?
            Write.flush(&file).map_err(fn(error) { jet_services_state_error("cannot flush service state store: {error}") })?
            file.sync_all().map_err(fn(error) { jet_services_state_error("cannot sync service state store: {error}") })?
            rename(&temporary, path).map_err(fn(error) { jet_services_state_error("cannot publish service state store: {error}") })?
            Ok(())
        })()
        if result.is_err() -> _ :: remove_file(&temporary)
        result
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4290
fn jet_services_state_store_write(authority: &JetServiceStateAuthority, adapter: &JetServiceStateAdapter, records: &[String]) -> () JetServiceError! {
