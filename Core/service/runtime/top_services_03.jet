//RS /// Consume one recorded decision. A replay mismatch is a safety error, not a
//RS /// new history entry: appending it would make the run look deterministic while
//RS /// changing the branch the workflow took.
//RS fn jet_services_workflow_replay_event(
//RS     workflow: &mut JetServiceWorkflow,
