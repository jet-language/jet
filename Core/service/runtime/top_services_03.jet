fn jet_services_state_store_load(authority: &JetServiceStateAuthority, adapter: &JetServiceStateAdapter) -> [String] JetServiceError! {
    // GATE #4565: kernel primitive
    #Unsafe("hold the process authority mutex throughout state load") {
        _guard :: service_authority_lock().lock().map_err(fn(_) { jet_services_state_error("service state lock is poisoned") })?
