// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4299
fn jet_services_state_validate_path(path: &OSPath) -> () JetServiceError! {
    // GATE #4565: kernel primitive
    #Unsafe("inspect file and each parent with symlink_metadata, rejecting symlinks and non-directories") {
        match symlink_metadata(path) {
            Ok(info) if info.file_type().is_symlink() -> return Err(jet_services_state_error("service state store must not be a symlink"))
            Ok(info) if !info.is_file() -> return Err(jet_services_state_error("service state store is not a regular file"))
            Ok(_) -> {}
            Err(error) if error.kind() == ErrorKind.NotFound -> {}
            Err(error) -> return Err(jet_services_state_error("cannot inspect service state store: {error}"))
        }
        if path.parent().is_none() -> return Ok(())
        current := path.parent().unwrap().to_path_buf()
        loop {
            match symlink_metadata(&current) {
                Ok(info) if info.file_type().is_symlink() -> return Err(jet_services_state_error("service state parent is a symlink: {current.display()}"))
                Ok(info) if !info.is_dir() -> return Err(jet_services_state_error("service state parent is not a directory: {current.display()}"))
                Ok(_) -> {}
                Err(error) if error.kind() == ErrorKind.NotFound -> {}
                Err(error) -> return Err(jet_services_state_error("cannot inspect service state parent: {error}"))
            }
            if current.parent().is_none() -> break
            next :: current.parent().unwrap()
            if next == current -> break
            current = next.to_path_buf()
        }
        Ok(())
    }
}
