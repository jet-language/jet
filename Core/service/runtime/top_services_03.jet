}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4710
fn jet_services_workflow_activity_step(activity: &String, key: &String, attempt: I64, max_attempts: I64) -> String {
    "activity:{activity}:{key}:{attempt}:{max_attempts}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4719
fn jet_services_workflow_activity_parts(step: &String) -> (&String, &String, I64, I64)? {
    parts := step.split(':')
    if parts.next()? != "activity" -> return None
    activity :: parts.next()?
    key :: parts.next()?
    attempt :: parts.next()?.parse<I64>().ok()?
    max_attempts :: parts.next()?.parse<I64>().ok()?
    if parts.next().is_some() -> return None
    Some((activity, key, attempt, max_attempts))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4736
fn jet_services_workflow_activity_index(workflow: &JetServiceWorkflow, key: &String) -> (USize, String, I64, I64)? {
    workflow.steps.iter().enumerate().find_map(fn((index, step)) {
        (activity, existing_key, attempt, max_attempts) :: jet_services_workflow_activity_parts(step)?
        (existing_key == key).then_some((index, activity.to_string(), attempt, max_attempts))
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4751
fn jet_services_workflow_activity_outcome(workflow: &JetServiceWorkflow, key: &String) -> (&JetTaskOutcome)? {
    workflow.activity_outcomes.iter().find(fn(entry) { &entry.0 == key }).map(fn(entry) { &entry.1 })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4762
fn jet_services_workflow_refresh_outcome(workflow: &JetServiceWorkflow) -> {
    keys: [&String] :: workflow.steps.iter().filter_map(fn(step) { jet_services_workflow_activity_parts(step).map(fn(parts) { parts.1 }) }).collect()
    if keys.is_empty() || keys.iter().any(fn(key) { !workflow.activity_outcomes.iter().any(fn(entry) { &entry.0 == key }) }) {
        workflow.outcome = None
        return
    }
    workflow.outcome = Some(workflow.activity_outcomes.iter().find_map(fn(entry) { entry.1.is_retryable_failure().then_some(entry.1.clone()) }).unwrap_or(JetTaskOutcome.Finished))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4786
fn jet_services_workflow_replay(authority: &JetServiceStateAuthority) -> [JetServiceWorkflow] JetServiceError! {
    records :: jet_services_state_store_load(authority, &JetServiceStateAdapter.EventLog)?
    prefix :: "v{authority.version}:"
    workflows := [JetServiceWorkflow].new()
    loop record in ^records {
        payload :: jet_services_read_state_record(&prefix, &record)?
        jet_services_workflow_apply(&workflows, payload)?
    }
    if workflows.len() > MAX_SERVICE_WORKFLOW_STEPS -> return Err(jet_services_state_error("workflow run limit exceeded"))
    Ok(workflows)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4802
fn jet_services_workflow_validate_step(step: &String) -> () JetServiceError! {
    if step.trim().is_empty() || step.len() > MAX_SERVICE_MESSAGE || step.chars().any(fn(c) { c.is_control() }) {
        return Err(JetServiceError.Policy("workflow step must be non-empty and visible"))
    }
    nondeterministic_markers :: ["time.", "random", "rand.", "io.", "channel", "spawn", "service.connect"]
    if nondeterministic_markers.iter().any(fn(marker) { step.contains(marker) }) {
        return Err(JetServiceError.Policy("workflow step reaches a non-deterministic effect; use a recorded activity"))
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4832
// Consume recorded decisions without appending divergent replay branches.
fn jet_services_workflow_replay_event(workflow: &JetServiceWorkflow, expected: &String) -> Bool JetServiceError! {
    if workflow.replay_cursor == 0 -> return Ok(false)
    match workflow.history.get(workflow.replay_cursor) {
        Some(actual) if actual == expected -> { workflow.replay_cursor += 1; Ok(true) }
        Some(actual) -> Err(JetServiceError.Policy("workflow replay diverged: expected `{actual}`, got `{expected}`"))
        None -> Ok(false)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4855
// Replay consumes the log-assigned retry number, not a new number derived from materialized state.
fn jet_services_workflow_replay_retry(workflow: &JetServiceWorkflow, key: &String, max_attempts: I64, outcome: &JetTaskOutcome) -> Bool JetServiceError! {
    if workflow.replay_cursor == 0 -> return Ok(false)
    if workflow.history.get(workflow.replay_cursor).is_none() -> return Ok(false)
    actual :: workflow.history.get(workflow.replay_cursor).unwrap()
    prefix :: "activity-retry:{key}@"
    suffix :: ":{outcome.jet_show()}"
    if !actual.starts_with(&prefix) || !actual.ends_with(&suffix) {
        return Err(JetServiceError.Policy("workflow replay diverged: expected retry for `{key}`, got `{actual}`"))
    }
    range := actual[prefix.len()..actual.len() - suffix.len()] // #4303
    (attempt_text, recorded_max_text) :: range.split_once('/').ok_or_else(fn() { JetServiceError.Policy("workflow replay has an invalid retry decision for `{key}`") })?
    attempt :: attempt_text.parse<I64>().map_err(fn(_) { JetServiceError.Policy("workflow replay has an invalid retry attempt for `{key}`") })?
    recorded_max_attempts :: recorded_max_text.parse<I64>().map_err(fn(_) { JetServiceError.Policy("workflow replay has an invalid retry limit for `{key}`") })?
    if attempt < 2 || attempt > max_attempts || recorded_max_attempts != max_attempts {
        return Err(JetServiceError.Policy("workflow replay retry definition for `{key}` changed"))
    }
    workflow.replay_cursor += 1
    Ok(true)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4903
// The sole workflow record reader is also the writer's in-memory apply path.
fn jet_services_workflow_apply(workflows: &[JetServiceWorkflow], payload: &String) -> () JetServiceError! {
    if Some(fields) :: payload.strip_prefix("workflow-start:") {
        (run_id_text, fields) :: fields.split_once(':').ok_or_else(fn() { jet_services_state_error("workflow start run id is missing") })?
        run_id :: run_id_text.parse<I64>().map_err(fn(_) { jet_services_state_error("workflow start run id is invalid") })?
        (version_text, fields) :: fields.split_once(':').ok_or_else(fn() { jet_services_state_error("workflow start version is missing") })?
        version :: version_text.parse<I64>().map_err(fn(_) { jet_services_state_error("workflow start version is invalid") })?
        id :: jet_services_workflow_field(fields, "id")?.to_string()
        if run_id <= 0 || version < 1 || id.trim().is_empty() || id.len() > MAX_SERVICE_NAME {
            return Err(jet_services_state_error("workflow start contains invalid identity"))
        }
        if workflows.iter().any(fn(workflow) { workflow.run_id == run_id || (workflow.id == id && workflow.version == version) }) {
            return Err(jet_services_state_error("workflow log contains a duplicate start record"))
        }
        workflows.push(JetServiceWorkflow{id: ^id, run_id, version, steps: [], history: ["start@v{version}"],
            replay_cursor: 0, status: JetTaskStatus.Running, activity_outcomes: [], outcome: None})
    } else if Some(fields) :: payload.strip_prefix("workflow-step:") {
        (run_id_text, fields) :: fields.split_once(':').ok_or_else(fn() { jet_services_state_error("workflow step run id is missing") })?
        run_id :: run_id_text.parse<I64>().map_err(fn(_) { jet_services_state_error("workflow step run id is invalid") })?
        step :: jet_services_workflow_field(fields, "step")?.to_string()
        jet_services_workflow_validate_step(&step).map_err(fn(_) { jet_services_state_error("workflow step contains invalid contents") })?
        workflow :: workflows.iter_mut().find(fn(workflow) { workflow.run_id == run_id })
            .ok_or_else(fn() { jet_services_state_error("workflow step has no start record") })?
        if workflow.outcome.is_some() -> return Err(jet_services_state_error("workflow step follows a terminal workflow outcome"))
        if workflow.steps.len() >= MAX_SERVICE_WORKFLOW_STEPS -> return Err(jet_services_state_error("workflow step history limit exceeded"))
        workflow.steps.push(step.clone())
        workflow.history.push("step:{step}")
    } else if Some(fields) :: payload.strip_prefix("workflow-wait-sleep:") {
        (run_id_text, nanos_text) :: fields.split_once(':').ok_or_else(fn() { jet_services_state_error("workflow sleep run id or duration is missing") })?
        run_id :: run_id_text.parse<I64>().map_err(fn(_) { jet_services_state_error("workflow sleep run id is invalid") })?
        nanos :: nanos_text.parse<I64>().map_err(fn(_) { jet_services_state_error("workflow sleep duration is invalid") })?
        if run_id < 1 -> return Err(jet_services_state_error("workflow sleep run id is invalid"))
        workflow :: workflows.iter_mut().find(fn(workflow) { workflow.run_id == run_id })
            .ok_or_else(fn() { jet_services_state_error("workflow sleep has no start record") })?
        if workflow.outcome.is_some() -> return Err(jet_services_state_error("workflow sleep follows a terminal workflow outcome"))
        workflow.history.push("sleep:{nanos}")
        workflow.status = JetTaskStatus.Running
    } else if Some(fields) :: payload.strip_prefix("workflow-wait-sleep-cancelled:") {
        run_id :: fields.parse<I64>().map_err(fn(_) { jet_services_state_error("workflow cancelled sleep run id is invalid") })?
        if run_id < 1 -> return Err(jet_services_state_error("workflow cancelled sleep run id is invalid"))
        workflow :: workflows.iter_mut().find(fn(workflow) { workflow.run_id == run_id })
            .ok_or_else(fn() { jet_services_state_error("workflow cancelled sleep has no start record") })?
        if workflow.outcome.is_some() || !workflow.history.last().is_some_and(fn(entry) { entry.starts_with("sleep:") }) {
            return Err(jet_services_state_error("workflow cancelled sleep is out of order"))
        }
        workflow.history.push("sleep-cancelled")
        workflow.status = JetTaskStatus.CancelRequested
        workflow.outcome = Some(JetTaskOutcome.Cancelled)
    } else if Some(fields) :: payload.strip_prefix("workflow-wait-sleep-deadline:") {
        run_id :: fields.parse<I64>().map_err(fn(_) { jet_services_state_error("workflow deadline sleep run id is invalid") })?
        if run_id < 1 -> return Err(jet_services_state_error("workflow deadline sleep run id is invalid"))
        workflow :: workflows.iter_mut().find(fn(workflow) { workflow.run_id == run_id })
            .ok_or_else(fn() { jet_services_state_error("workflow deadline sleep has no start record") })?
        if workflow.outcome.is_some() || !workflow.history.last().is_some_and(fn(entry) { entry.starts_with("sleep:") }) {
            return Err(jet_services_state_error("workflow deadline sleep is out of order"))
        }
        workflow.history.push("sleep-deadline")
        workflow.status = JetTaskStatus.Paused
        workflow.outcome = Some(JetTaskOutcome.DeadlineBlown)
    } else if Some(fields) :: payload.strip_prefix("workflow-wait-activity:") {
        (run_id_text, fields) :: fields.split_once(':').ok_or_else(fn() { jet_services_state_error("workflow activity wait run id is missing") })?
        run_id :: run_id_text.parse<I64>().map_err(fn(_) { jet_services_state_error("workflow activity wait run id is invalid") })?
        (activity, rest) :: jet_services_workflow_take_field(fields, "wait activity")?
        (argument, rest) :: jet_services_workflow_take_field(rest, "wait argument")?
        if run_id < 1 || rest != "" || jet_services_workflow_token(activity, "activity", MAX_SERVICE_NAME).is_err()
            || argument.len() > MAX_SERVICE_MESSAGE || argument.chars().any(fn(c) { c.is_control() }) {
            return Err(jet_services_state_error("workflow activity wait contains invalid fields"))
        }
        workflow :: workflows.iter_mut().find(fn(workflow) { workflow.run_id == run_id })
            .ok_or_else(fn() { jet_services_state_error("workflow activity wait has no start record") })?
        if workflow.outcome.is_some() -> return Err(jet_services_state_error("workflow activity wait follows a terminal workflow outcome"))
        workflow.history.push("activity:{activity}:{argument}")
        workflow.status = JetTaskStatus.Running
    } else if Some(fields) :: payload.strip_prefix("workflow-wait-all:") {
        (run_id_text, fields) :: fields.split_once(':').ok_or_else(fn() { jet_services_state_error("workflow all wait run id is missing") })?
        run_id :: run_id_text.parse<I64>().map_err(fn(_) { jet_services_state_error("workflow all wait run id is invalid") })?
        (count_text, initial_rest) :: fields.split_once(':').ok_or_else(fn() { jet_services_state_error("workflow all wait count is missing") })?
        rest := initial_rest
        count :: count_text.parse<USize>().map_err(fn(_) { jet_services_state_error("workflow all wait count is invalid") })?
        if run_id < 1 || count > MAX_SERVICE_WORKFLOW_STEPS {
            return Err(jet_services_state_error("workflow all wait count is outside the bounded range"))
        }
        values := [String].with_capacity(count)
