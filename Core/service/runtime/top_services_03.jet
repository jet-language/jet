fn jet_services_state_store_append(authority: &JetServiceStateAuthority, record: &String) -> () JetServiceError! {
    adapter :: JetServiceStateAdapter.EventLog
    // GATE #4565: kernel primitive
    #Unsafe("append and sync a real event frame under retained authority and file locks") {
        _guard :: service_authority_lock().lock().map_err(fn(_) { jet_services_state_error("service state lock is poisoned") })?
        _file_lock :: service_authority_file_lock(&authority.store, "state")?
        records :: jet_services_state_store_read_unlocked(authority, &adapter)?
        if records.len() >= MAX_SERVICE_STATE_RECORDS -> return Err(JetServiceError.Policy("event-log record limit exceeded"))
        path :: OSPath.new(&authority.store)
        if !path.exists() -> return jet_services_state_store_write_unlocked(authority, &adapter, &[record.to_string()])
        frame :: jet_services_state_frame(record)
        current_size :: path.metadata().map_err(fn(error) { jet_services_state_error("cannot inspect service state store before append: {error}") })?.len()
        if current_size.checked_add(frame.len() as U64).is_none_or(fn(size) { size > (MAX_SERVICE_STATE_BYTES as U64) }) {
            return Err(JetServiceError.Policy("service state store exceeds its byte limit"))
        }
        options := OpenOptions.new()
        options.append(true)
        if selected_family() == "unix" -> options.mode(0o600)
        file := options.open(path).map_err(fn(error) { jet_services_state_error("cannot append state store: {error}") })?
        Write.write_all(&file, &frame).map_err(fn(error) { jet_services_state_error("cannot append state event: {error}") })?
        Write.flush(&file).map_err(fn(error) { jet_services_state_error("cannot flush state event: {error}") })?
        file.sync_all().map_err(fn(error) { jet_services_state_error("cannot sync state event: {error}") })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4414
fn jet_services_read_state_record(prefix: &String, record: &String) -> &String JetServiceError! {
    body :: record.strip_prefix(prefix).ok_or_else(fn() { JetServiceError.Policy("state record schema is incompatible") })?
    (length, payload) :: body.split_once(':').ok_or_else(fn() { JetServiceError.Policy("state record is truncated") })?
    expected :: length.parse<USize>().map_err(fn(_) { JetServiceError.Policy("state record length is invalid") })?
