//RS         Some(actual) => Err(JetServiceError::Policy(format!(
//RS             "workflow replay diverged: expected `{actual}`, got `{expected}`"
//RS         ))),
//RS         None => Ok(false),
//RS     }
//RS }
//RS 
//RS /// Retry records include the attempt number assigned by the durable log. On a
//RS /// replay the materialized activity already contains that newest attempt, so
//RS /// the caller must consume the recorded number instead of deriving a new one
//RS /// from the materialized state.
//RS fn jet_services_workflow_replay_retry(
//RS     workflow: &mut JetServiceWorkflow,
//RS     key: &str,
//RS     max_attempts: i64,
//RS     outcome: &JetTaskOutcome,
//RS ) -> Result<bool, JetServiceError> {
//RS     if workflow.replay_cursor == 0 {
//RS         return Ok(false);
//RS     }
//RS     let Some(actual) = workflow.history.get(workflow.replay_cursor) else {
//RS         return Ok(false);
//RS     };
//RS     let prefix = format!("activity-retry:{key}@");
//RS     let suffix = format!(":{}", outcome.jet_show());
//RS     if !actual.starts_with(&prefix) || !actual.ends_with(&suffix) {
//RS         return Err(JetServiceError::Policy(format!(
//RS             "workflow replay diverged: expected retry for `{key}`, got `{actual}`"
//RS         )));
//RS     }
//RS     let range = &actual[prefix.len()..actual.len() - suffix.len()];
//RS     let (attempt_text, recorded_max_text) = range.split_once('/').ok_or_else(|| {
//RS         JetServiceError::Policy(format!(
//RS             "workflow replay has an invalid retry decision for `{key}`"
//RS         ))
//RS     })?;
//RS     let attempt = attempt_text.parse::<i64>().map_err(|_| {
//RS         JetServiceError::Policy(format!(
//RS             "workflow replay has an invalid retry attempt for `{key}`"
//RS         ))
//RS     })?;
//RS     let recorded_max_attempts = recorded_max_text.parse::<i64>().map_err(|_| {
//RS         JetServiceError::Policy(format!(
//RS             "workflow replay has an invalid retry limit for `{key}`"
