}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:4693
fn jet_services_workflow_token(value: &String, label: &String, max: USize) -> () JetServiceError! {
    if value.trim().is_empty() || value.len() > max || value.chars().any(fn(c) { c.is_control() }) || value.contains(':') {
        return Err(JetServiceError.Policy("workflow {label} must be non-empty, visible, bounded, and contain no `:`"))
