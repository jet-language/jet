}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3804
fn jet_job_queue_validate_payload(payload: &JetJobPayload) -> () JetServiceError! {
    service_authority_validate_text(payload.type_id, "job payload type", JET_JOB_QUEUE_MAX_TYPE, false)?
    if payload.bytes.len() > JET_JOB_QUEUE_MAX_PAYLOAD -> return Err(JetServiceError.Policy("job payload exceeds the bounded queue payload limit"))
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3819
fn jet_job_queue_validate_result(result: &JetJobResult) -> () JetServiceError! {
    service_authority_validate_text(result.type_id, "job result type", JET_JOB_QUEUE_MAX_TYPE, false)?
    if result.bytes.len() > JET_JOB_QUEUE_MAX_PAYLOAD -> return Err(JetServiceError.Policy("job result exceeds the bounded queue payload limit"))
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3834
fn jet_job_queue_validate_error(error: &JetJobError) -> () JetServiceError! {
    service_authority_validate_text(error.type_id, "job error type", JET_JOB_QUEUE_MAX_TYPE, false)?
    service_authority_validate_text(error.reason, "job error reason", JET_JOB_QUEUE_MAX_REASON, false)?
    if error.detail == Val(detail) {
        service_authority_validate_text(detail, "job error detail", JET_JOB_QUEUE_MAX_DETAIL, true)?
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3853
fn jet_job_queue_validate_enqueue(request: &JetJobEnqueue) -> () JetServiceError! {
    service_authority_validate_text(request.job_type, "job type", JET_JOB_QUEUE_MAX_TYPE, false)?
    jet_job_queue_validate_payload(&request.payload)?
    if request.delay_ms < 0 || request.delay_ms > JET_JOB_QUEUE_MAX_DELAY_MS -> return Err(JetServiceError.Policy("job delay must be non-negative and bounded"))
    if request.idempotency_key == Val(key) {
        service_authority_validate_text(key, "job idempotency key", JET_JOB_QUEUE_MAX_KEY, false)?
    }
    if request.request_id == Val(request_id) {
        service_authority_validate_text(request_id, "job request id", JET_JOB_QUEUE_MAX_REQUEST, false)?
    }
    Ok(())
}
