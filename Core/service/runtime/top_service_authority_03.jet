const JET_JOB_SERVICE_CLAIM_LIMIT: USize = 16
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:5838
// Engines supply checked identity lookup and typed invocation; lease and settlement remain here.
pub fn jet_job_service_queue_tick_dispatch<F: FnMut(String, &JetJobPayload) -> JetJobResult JetJobError!>(endpoint: &JetServiceEndpoint, limit: USize, dispatch: F) -> USize JetServiceError! {
    if limit == 0 -> return Ok(0)
    queue := JetJobQueue.open_default(endpoint, "default", JetJobQueuePolicy.default())?
    claims :: queue.claim(endpoint.worker, limit.min(JET_JOB_SERVICE_CLAIM_LIMIT))?
    settled := USize{0}
    loop claim in claims {
        // GATE #4565: kernel primitive
        outcome :: #Unsafe("catch native unwind only around typed dispatcher; queue claims settle outside the panic boundary") {
            catch_unwind(AssertUnwindSafe(fn() { dispatch(claim.receipt.job_type.as_str(), &claim.payload) }))
        }.map_err(fn(_) { JetJobError{type_id: claim.payload.type_id.clone(), reason: "panic", detail: Val("checked #Job `{claim.receipt.job_type}` dispatcher panicked")} }).and_then(fn(result) { ^result })
        match outcome {
            Ok(result) -> {
                checked :: JetJobResult.new(^result.type_id, ^result.bytes, result.publish).map_err(fn(error) {
                    JetJobError{type_id: claim.payload.type_id.clone(), reason: "invalid_result", detail: Val(error.jet_show())}
                })
                match checked {
                    Ok(result) -> { _ :: queue.acknowledge(&claim, ^result)? }
                    Err(error) -> { _ :: queue.fail(&claim, ^error)? }
                }
            }
            Err(error) -> { _ :: queue.fail(&claim, ^error)? }
        }
        settled += 1
    }
    Ok(settled)
}
