fn jet_job_queue_recover_expired_on_store(store: &JetJobQueueStore, authority: String, name: String, policy: &JetJobQueuePolicy, now: I64) -> [JetJobQueueDevtoolsTransition] JetServiceError! {
    rows :: store.query("{JET_JOB_QUEUE_SELECT} WHERE authority = ? AND queue = ? AND state = 'running' AND lease_until_ms IS NOT NULL AND lease_until_ms <= ? ORDER BY sequence", &[JetJobQueueValue.Text(authority.to_string()), JetJobQueueValue.Text(name.to_string()), JetJobQueueValue.Int(now)]).map_err(fn(error) { jet_job_queue_sql_error("lease recovery", error) })?
    observations := [JetJobQueueDevtoolsTransition].with_capacity(rows.len())
    loop row in &rows {
        record :: jet_job_queue_stored_record(row)?
        terminal :: record.attempts >= policy.max_attempts
        state :: if terminal { JetJobQueueState.DeadLettered } else { JetJobQueueState.Retrying }
        reason :: if terminal { "lease_expired_max_attempts" } else { "lease_expired" }
        duration_ms :: record.started_at_ms.map(fn(started) { now.saturating_sub(started) })
        extra :: [("finished_at_ms", JetJobQueueValue.Int(now)), ("due_at_ms", JetJobQueueValue.Int(now)), ("retry_at_ms", JetJobQueueValue.Int(now)), ("lease_owner", JetJobQueueValue.Null), ("lease_token", JetJobQueueValue.Null), ("lease_until_ms", JetJobQueueValue.Null), ("error_type", JetJobQueueValue.Text("jet.queue.lease")), ("error_reason", JetJobQueueValue.Text(reason.to_string())), ("error_detail", JetJobQueueValue.Null)]
        jet_job_queue_update_event(store, &record, state, record.attempts, now, Val(reason), duration_ms, record.lease_owner.as_deref(), &extra)?
        &observations.push(JetJobQueueDevtoolsTransition.from_record(&record, state, record.attempts, now, Val(reason), duration_ms, record.lease_owner.as_deref()))
    }
    Ok(^observations)
}
