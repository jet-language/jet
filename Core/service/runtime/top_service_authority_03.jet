//RS /// Run one bounded queue tick under the endpoint that issued the worker.
//RS /// Engines provide only checked identity lookup and typed invocation; claim,
//RS /// lease, validation, and settlement stay here.
//RS pub fn jet_job_service_queue_tick_dispatch<F>(
//RS     endpoint: &JetServiceEndpoint,
//RS     limit: usize,
//RS     mut dispatch: F,
//RS ) -> Result<usize, JetServiceError>
//RS where
//RS     F: FnMut(&str, &JetJobPayload) -> Result<JetJobResult, JetJobError>,
