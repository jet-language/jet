// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3593
fn jet_job_queue_panel_state(state: JetJobQueueState) -> String {
    match state {
        .Queued -> "enqueued"
        .Running -> "started"
        .Retrying -> "retrying"
        .Completed -> "completed"
        .Failed | .DeadLettered | .Cancelled -> "failed"
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3605
fn jet_job_queue_panel_failure(state: JetJobQueueState, reason: String?) -> String? {
    match state {
        .Cancelled -> Val("cancelled")
        .Failed | .DeadLettered -> {
            if reason.map_or(false, fn(value) -> value.starts_with("lease_expired")) -> Val("worker_lost")
            else -> Val("error")
        }
        .Queued | .Running | .Retrying | .Completed -> None
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3625
fn jet_job_queue_json_text(value: String) -> String {
    output := String.with_capacity(value.len().saturating_add(2))
    output.push('"')
    loop character in value.chars() {
        match character {
            '"' -> output.push_str("\\\"")
            '\\' -> output.push_str("\\\\")
            '\u{08}' -> output.push_str("\\b")
            '\u{0c}' -> output.push_str("\\f")
            '\n' -> output.push_str("\\n")
            '\r' -> output.push_str("\\r")
            '\t' -> output.push_str("\\t")
            character -> {
                if character.is_control() {
                    scalar :: character as U32
                    output.push_str("\\u{scalar:04x}")
                } else { output.push(character) }
            }
        }
    }
    output.push('"')
    ^output
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3647
fn jet_job_queue_json_optional_text(value: String?) -> String {
    value.map(jet_job_queue_json_text).unwrap_or_else(fn() -> "null")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3653
fn jet_job_queue_event_time(timestamp_ms: I64) -> U64 { timestamp_ms.max(0) as U64 }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3657
fn jet_job_queue_publish_transition(observation: &JetJobQueueDevtoolsTransition) -> () {
    duration :: observation.duration_ms.map(fn(value) -> value.to_string()).unwrap_or_else(fn() -> "null")
    worker :: jet_job_queue_json_optional_text(observation.worker.as_ref())
    request_id :: jet_job_queue_json_optional_text(observation.request_id.as_ref())
    failure :: jet_job_queue_json_optional_text(jet_job_queue_panel_failure(observation.state, observation.reason.as_ref()))
    reason :: jet_job_queue_json_optional_text(observation.reason.as_ref())
    event_text :: jet_job_queue_json_text(observation.event)
    state_text :: jet_job_queue_json_text(jet_job_queue_panel_state(observation.state))
    job_id :: jet_job_queue_json_text(observation.job_id)
    name :: jet_job_queue_json_text(observation.job_type)
    queue :: jet_job_queue_json_text(observation.queue)
    authority :: jet_job_queue_json_text(observation.authority)
    fields :: "{{\"event\":{event_text},\"state\":{state_text},\"job_id\":{job_id},\"name\":{name},\"queue\":{queue},\"attempts\":{observation.attempts},\"duration_ms\":{duration},\"worker\":{worker},\"request_id\":{request_id},\"failure\":{failure},\"reason\":{reason},\"sequence\":{observation.sequence},\"authority\":{authority},\"labels\":{{}}}}"
    if JetDevtoolsEvent.from_parts(jet_job_queue_event_time(observation.timestamp_ms), JET_JOB_QUEUE_DEVTOOLS_SOURCE, "Job", observation.job_id.clone(), ^fields) == Ok(event) {
        jet_devtools_publish_event(^event)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3696
fn jet_job_queue_publish_transitions<I: IntoIterator<Item=JetJobQueueDevtoolsTransition>>(observations: I) -> () {
    loop observation in observations { jet_job_queue_publish_transition(&observation) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3704
fn jet_job_queue_publish_status(status: &JetJobQueueStatus) -> () {
    entity :: "{status.authority}:{status.queue}"
    job_id :: jet_job_queue_json_text(entity)
    queue :: jet_job_queue_json_text(status.queue)
    authority :: jet_job_queue_json_text(status.authority)
    fields :: "{{\"event\":\"status\",\"state\":\"status\",\"job_id\":{job_id},\"name\":{queue},\"queue\":{queue},\"attempts\":0,\"duration_ms\":null,\"worker\":null,\"request_id\":null,\"failure\":null,\"reason\":null,\"sequence\":0,\"authority\":{authority},\"queued\":{status.queued},\"running\":{status.running},\"retrying\":{status.retrying},\"completed\":{status.completed},\"failed\":{status.failed},\"dead_lettered\":{status.dead_lettered},\"cancelled\":{status.cancelled},\"depth\":{status.depth},\"wait_ms\":{status.wait_ms},\"throughput\":{status.throughput},\"capacity\":{status.capacity},\"paused\":{status.paused},\"freshness_ms\":{status.freshness_ms},\"labels\":{{}}}}"
    if JetDevtoolsEvent.from_parts(jet_job_queue_event_time(service_authority_now()), JET_JOB_QUEUE_DEVTOOLS_SOURCE, "Job", entity, ^fields) == Ok(event) {
        jet_devtools_publish_event(^event)
    }
}
