// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:4036
fn jet_job_queue_framed(input: &[U8], field: &[U8]) -> () {
    input.extend_from_slice(&(field.len() as U64).to_be_bytes())
    input.extend_from_slice(field)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:4041
fn jet_job_queue_record_signature(authority: String, id: String, queue: String, job_type: String,
    sequence: I64, due_at_ms: I64, payload: &[U8]) -> String JetServiceError! {
    key :: service_authority_signing_key(authority)?
    payload_digest :: sha256_bytes(payload)
    input := [U8].with_capacity(128)
    jet_job_queue_framed(&input, "jet-job-queue-v1".as_bytes())
    jet_job_queue_framed(&input, authority.as_bytes())
    jet_job_queue_framed(&input, id.as_bytes())
    jet_job_queue_framed(&input, queue.as_bytes())
    jet_job_queue_framed(&input, job_type.as_bytes())
    jet_job_queue_framed(&input, sequence.to_string().as_bytes())
    jet_job_queue_framed(&input, due_at_ms.to_string().as_bytes())
    jet_job_queue_framed(&input, &payload_digest)
    Ok(service_authority_hex(hmac_sha256_raw(key, input)))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:4064
fn jet_job_queue_id(authority: String, queue: String, sequence: I64, job_type: String, payload: &[U8]) -> String {
    payload_digest :: sha256_bytes(payload)
    input := [U8].with_capacity(128)
    jet_job_queue_framed(&input, "jet-job-id-v1".as_bytes())
    jet_job_queue_framed(&input, authority.as_bytes())
    jet_job_queue_framed(&input, queue.as_bytes())
    jet_job_queue_framed(&input, sequence.to_string().as_bytes())
    jet_job_queue_framed(&input, job_type.as_bytes())
    jet_job_queue_framed(&input, &payload_digest)
    "jq-{service_authority_hex(sha256_bytes(input))}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:4082
fn jet_job_queue_make_receipt(record: &JetJobQueueStoredRecord, delivery: JetJobQueueDeliveryPolicy, duplicate: Bool) -> JetJobQueueReceipt {
    JetJobQueueReceipt{
        id: record.id.clone(), authority: record.authority.clone(), queue: record.queue.clone(),
        job_type: record.job_type.clone(), state: record.state, sequence: record.sequence,
        attempts: record.attempts, due_at_ms: record.due_at_ms, accepted_at_ms: record.accepted_at_ms,
        request_id: record.request_id.clone(), idempotency_key: record.idempotency_key.clone(),
        lease_until_ms: record.lease_until_ms,
        duration_ms: record.started_at_ms.zip(record.finished_at_ms).map(fn((started, finished)) -> finished.saturating_sub(started)),
        error_reason: record.error_reason.clone(), delivery: delivery, duplicate: duplicate, signature: record.signature.clone()
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:4111
fn jet_job_queue_record(record: &JetJobQueueStoredRecord, delivery: JetJobQueueDeliveryPolicy, include_payload: Bool) -> JetJobQueueRecord {
    payload :: if include_payload && record.payload_public -> Val(JetJobPayload{type_id: record.payload_type.clone(), bytes: record.payload.clone(), publish: true}) else -> None
    result :: if include_payload && record.result_public {
        record.result.as_ref().zip(record.result_type.as_ref()).map(fn((bytes, type_id)) ->
            JetJobResult{type_id: type_id.clone(), bytes: bytes.clone(), publish: true})
    } else { None }
    error :: record.error_type.as_ref().zip(record.error_reason.as_ref()).map(fn((type_id, reason)) ->
        JetJobError{type_id: type_id.clone(), reason: reason.clone(), detail: record.error_detail.clone()})
    JetJobQueueRecord{receipt: jet_job_queue_make_receipt(record, delivery, false), payload: ^payload,
        result: ^result, error: ^error, started_at_ms: record.started_at_ms, finished_at_ms: record.finished_at_ms}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:4152
fn jet_job_queue_backoff(policy: &JetJobQueuePolicy, attempts: U32) -> I64 {
    exponent :: attempts.saturating_sub(1).min(20)
    multiplier :: I64{1}.checked_shl(exponent).unwrap_or(I64.MAX)
    policy.retry_delay_ms.saturating_mul(multiplier).min(policy.max_retry_delay_ms)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:4161
fn jet_job_queue_token(id: String, worker: String) -> String JetServiceError! {
    entropy := jet_crypto_entropy_bytes(24).map_err(fn(_) -> JetServiceError.Policy("queue lease token could not obtain cryptographic entropy"))?
    input := [U8].with_capacity(64)
    jet_job_queue_framed(&input, id.as_bytes())
    jet_job_queue_framed(&input, worker.as_bytes())
    jet_job_queue_framed(&input, &jet_job_queue_now_ms().to_string().into_bytes())
    input.append(&entropy)
    Ok("lease-{service_authority_hex(sha256_bytes(input))}")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:4173
fn jet_job_queue_sql_error(operation: String, detail: JetServiceError) -> JetServiceError {
    match detail {
        .Unavailable(message) -> JetServiceError.Unavailable("queue {operation}: {message}")
        .Policy(message) -> JetServiceError.Policy("queue {operation}: {message}")
        .Revoked(message) -> JetServiceError.Revoked("queue {operation}: {message}")
        .Stale(message) -> JetServiceError.Stale("queue {operation}: {message}")
        other -> ^other
    }
}
