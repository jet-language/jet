//RS     mailbox: JetServiceMailbox,
//RS     /// The restart instants this worker has spent, oldest first. This list is
//RS     /// the one restart fact: `services.restarts` and the supervisor's escalation
//RS     /// check both read it through `JetServiceRestartBudget::spent`, and a restart
//RS     /// prunes it through `prune`, so no separate counter can drift from the
//RS     /// policy window.
//RS     restarts: Vec<i64>,
//RS     running: bool,
//RS     /// Bytes accepted into and delivered from the bounded endpoint mailbox.
//RS     /// These counters are transport facts; message contents never cross the
//RS     /// topology protocol boundary.
//RS     received_bytes: u64,
//RS     sent_bytes: u64,
//RS     task: std::sync::Arc<std::sync::Mutex<JetServiceSupervisorState>>,
