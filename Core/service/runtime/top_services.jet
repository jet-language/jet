// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:1006
impl JetTaskOutcome {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:1007
    fn wire(self: &Self) -> String {
        match self {
            .Finished -> "Finished"
            .Panicked(reason) -> format!("Panicked:{}", jet_services_workflow_frame(reason))
            .Cancelled -> "Cancelled"
            .DeadlineBlown -> "DeadlineBlown"
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:1018
    fn from_wire(value: &String) -> Self JetServiceError! {
        match value {
            "Finished" -> Ok(Self.Finished)
            "Cancelled" -> Ok(Self.Cancelled)
            "DeadlineBlown" -> Ok(Self.DeadlineBlown)
            value -> {
                reason :: value.strip_prefix("Panicked:").ok_or_else(fn() { jet_services_state_error("unknown task outcome") })?
                outcome :: Self.Panicked(jet_services_workflow_field(reason, "panic reason")?.to_string())
                if outcome.is_valid() { Ok(^outcome) }
                else { Err(jet_services_state_error("invalid task outcome")) }
            }
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:1038
    fn is_retryable_failure(self: &Self) -> Bool { !matches!(self, Self.Finished) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:1042
    fn is_valid(self: &Self) -> Bool {
        match self {
            .Panicked(reason) -> !reason.trim().is_empty() && reason.len() <= MAX_SERVICE_MESSAGE
                && !reason.chars().any(fn(c) { c.is_control() })
            _ -> true
        }
    }
}
