// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:482
fn jet_services_publish_endpoint_fact_with_transport(endpoint: &JetServiceEndpoint, authority_state: JetDevtoolsTopologyEndpointAuthorityState, owner: String?, connection: JetDevtoolsTopologyEndpointConnectionState, bytes_in: U64?, bytes_out: U64?, restart_policy: JetDevtoolsTopologyRestartPolicy?) -> {
    worker_id :: jet_services_topology_worker_id(&endpoint.tree, &endpoint.worker)
    fact :: JetDevtoolsTopologyEndpointFact.new(
