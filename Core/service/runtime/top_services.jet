        JET_SERVICES_TOPOLOGY_SOURCE, Val(^worker_id), JetDevtoolsTopologyEndpointScheme.Unix,
        jet_services_topology_address(&endpoint.tree, &endpoint.worker), None, authority_state,
        JetDevtoolsTopologyFreshness.fresh(jet_services_topology_now())
    ).map(fn(fact) {
        fact := fact.with_connection(connection)
        if owner :: owner -> fact = fact.with_owner(^owner)
        if bytes_in :: bytes_in -> fact.bytes_in = Val(bytes_in)
        if bytes_out :: bytes_out -> fact.bytes_out = Val(bytes_out)
        if restart_policy :: restart_policy -> fact = fact.with_restart_policy(^restart_policy)
        fact
    })
    match fact { Ok(fact) -> jet_services_topology_publish_fact(JetDevtoolsTopologyFact.Endpoint(^fact)), Err(_) -> {} }
}
