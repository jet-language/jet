// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:287
fn jet_services_topology_publish_state(state: &JetServiceSupervisorState) -> {
    kind :: state.topology_kind ?? return
    id :: state.topology_id.as_ref() ?? return
    observed_at_ms :: jet_services_topology_now()
    freshness :: JetDevtoolsTopologyFreshness.fresh(observed_at_ms)
    parent_id :: state.topology_parent_id.clone()
    owner :: state.topology_owner.clone()
    restart_policy :: state.topology_restart_policy.clone()
    duration_ms :: state.topology_duration_ms.or_else(fn() {
        state.topology_started_at_ms.map(fn(started) { observed_at_ms.saturating_sub(started) })
    })
    failure :: jet_services_topology_failure(&state.status, state.failure.as_ref())
    wait_target :: state.topology_wait_target.clone()
    history :: state.topology_restart_history.clone()
    fact :: match kind {
        .Supervisor -> {
            status :: match state.status {
                .Starting -> JetDevtoolsTopologySupervisorState.Starting
                .Running -> JetDevtoolsTopologySupervisorState.Running
                .Failed | .Partitioned -> JetDevtoolsTopologySupervisorState.Failed
                .Cancelling -> JetDevtoolsTopologySupervisorState.Stopping
                .Stopped -> JetDevtoolsTopologySupervisorState.Stopped
                .Escalated -> JetDevtoolsTopologySupervisorState.Escalated
            }
            JetDevtoolsTopologySupervisorFact.new(id.clone(), JET_SERVICES_TOPOLOGY_SOURCE, parent_id, status, history, freshness).map(fn(fact) {
                fact := ^fact
                if owner :: owner.clone() -> fact = fact.with_owner(^owner)
                if restart_policy :: restart_policy.clone() -> fact = fact.with_restart_policy(^restart_policy)
                if failure :: failure -> fact = fact.with_failure(failure)
                if duration_ms :: duration_ms -> fact = fact.with_duration_ms(duration_ms)
                JetDevtoolsTopologyFact.Supervisor(^fact)
            })
        }
        .Task -> {
            status :: match state.status {
                .Starting -> JetDevtoolsTopologyTaskState.Created
                .Running -> if wait_target.is_some() -> JetDevtoolsTopologyTaskState.Waiting else -> JetDevtoolsTopologyTaskState.Running
                .Failed | .Escalated | .Partitioned -> JetDevtoolsTopologyTaskState.Failed
                .Cancelling | .Stopped -> JetDevtoolsTopologyTaskState.Cancelled
            }
            JetDevtoolsTopologyTaskFact.new(id.clone(), JET_SERVICES_TOPOLOGY_SOURCE, parent_id, status, history, freshness).map(fn(fact) {
                fact := ^fact
                if owner :: owner.clone() -> fact = fact.with_owner(^owner)
                if wait_target :: wait_target.clone() -> fact = fact.with_wait_target(^wait_target)
                if duration_ms :: duration_ms -> fact = fact.with_duration_ms(duration_ms)
                if failure :: failure -> fact = fact.with_failure(failure)
                if restart_policy :: restart_policy.clone() -> fact = fact.with_restart_policy(^restart_policy)
                JetDevtoolsTopologyFact.Task(^fact)
            })
        }
    }
    match fact { Ok(fact) -> jet_services_topology_publish_fact(^fact), Err(_) -> {} }
}
