// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:56
impl JetServiceRestartBudget {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:58
    fn ratified_default() -> Self { Self{max: SERVICE_RESTART_MAX, per_ms: SERVICE_RESTART_WINDOW_MS} }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:65
    fn is_valid(self: &Self) -> Bool { self.max >= 1 && self.max <= MAX_SERVICE_RESTART_BUDGET && self.per_ms >= 1 }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:72
    fn window_start(self: &Self, now: I64) -> I64 { now.saturating_sub(self.per_ms) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:79
    fn spent(self: &Self, restarts: &[I64], now: I64) -> I64 {
        start :: self.window_start(now)
        restarts.iter().filter(fn(at) { **at > start }).count() as I64
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:86
    fn prune(self: &Self, restarts: &[I64], now: I64) -> {
        start :: self.window_start(now)
        restarts.retain(fn(at) { *at > start })
    }
}
