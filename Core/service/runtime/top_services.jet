const JET_SERVICES_TOPOLOGY_SOURCE: String = "service-runtime"
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:190
fn jet_services_topology_now() -> U64 {
    // GATE #4565: kernel primitive — actual epoch clock, source's zero on error.
    #Unsafe("read native wall clock and retain checked epoch and millisecond conversion") {
        SystemTime.now().duration_since(UNIX_EPOCH).ok()
            .and_then(fn(duration) { U64.try_from(duration.as_millis()).ok() }).unwrap_or(0)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:198
fn jet_services_topology_restart_policy(restart: &JetServiceRestart, budget: &JetServiceRestartBudget) -> JetDevtoolsTopologyRestartPolicy? {
    strategy :: match restart {
        .OneForOne -> JetDevtoolsTopologyRestartStrategy.OneForOne
        .OneForAll -> JetDevtoolsTopologyRestartStrategy.OneForAll
        .RestForOne -> JetDevtoolsTopologyRestartStrategy.RestForOne
    }
    max_restarts :: U32.try_from(budget.max).ok() ?? return None
    window_ms :: U64.try_from(budget.per_ms).ok() ?? return None
    JetDevtoolsTopologyRestartPolicy.new(strategy, max_restarts, window_ms).ok()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:212
fn jet_services_topology_failure(status: &JetServiceSupervisorStatus, failure: (&JetTaskFailure)?) -> JetDevtoolsTopologyFailureKind? {
    match status {
        .Escalated -> Val(JetDevtoolsTopologyFailureKind.Escalated)
        .Partitioned -> Val(JetDevtoolsTopologyFailureKind.WorkerLost)
        _ -> failure.map(fn(failure) {
            match failure {
                .Cancelled -> JetDevtoolsTopologyFailureKind.Cancelled
                .DeadlineBlown -> JetDevtoolsTopologyFailureKind.TimedOut
                .Panicked(_) -> JetDevtoolsTopologyFailureKind.Failed
            }
        })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:229
fn jet_services_topology_finish(state: &JetServiceSupervisorState, at_ms: U64) -> {
    if state.topology_duration_ms.is_none() {
        state.topology_duration_ms = state.topology_started_at_ms.map(fn(started) { at_ms.saturating_sub(started) })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:236
fn jet_services_topology_id(kind: &String, tree: &String, member: (&String)?) -> String {
    value :: match member { Val(member) -> format!("service:{kind}:{tree}:{member}"), None -> format!("service:{kind}:{tree}") }
    if value.len() <= JET_SERVICES_TOPOLOGY_MAX_ID -> return value
    format!("service:{kind}:{}", service_authority_hex(&sha256_bytes(value.as_bytes())))
}
