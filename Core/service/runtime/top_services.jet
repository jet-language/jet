// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:446
fn jet_services_record_topology_restart(task: &Arc<Mutex<JetServiceSupervisorState>>, at_ms: U64, reason: JetDevtoolsTopologyRestartReason) -> () JetServiceError! {
