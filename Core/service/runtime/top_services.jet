// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:796
fn jet_services_new_mailbox(endpoint: JetServiceEndpoint, capacity: I64, messages: [String]) -> JetServiceMailbox JetServiceError! {
    channel_capacity :: USize.try_from(capacity).map_err(fn(_) {
        JetServiceError.Policy("mailbox capacity is outside the platform range")
    })?
    if messages.len() > channel_capacity {
        return Err(JetServiceError.Policy("mailbox messages exceed the bounded channel capacity"))
    }
    // GATE #4565: kernel primitive
    channel :: #Unsafe("allocate real bounded native channel with restored queue; preserve allocation failure") {
        Arc.new(JetServiceChannel.new(channel_capacity, ^messages).map_err(fn(_) {
            JetServiceError.Policy("mailbox channel could not restore its queued messages")
        })?)
    }
    endpoint := ^endpoint
    endpoint.channel = Val(channel.clone())
    Ok(JetServiceMailbox{endpoint: ^endpoint, capacity, channel: ^channel})
}
