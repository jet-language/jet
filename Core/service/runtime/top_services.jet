//RS /// D-SERVICE1=D's ratified default restart policy: `OneForOne` with a bounded
//RS /// budget of five restarts per minute, escalating to the parent group when the
//RS /// budget is spent. These are the *default* values of a policy row a group
//RS /// carries as data (D-CONC-SCHED1: "a restart rule is data on that group, no
//RS /// new mechanism") — not a global ceiling read at the one failure site.
//RS const SERVICE_RESTART_MAX: i64 = 5;
//RS const SERVICE_RESTART_WINDOW_MS: i64 = 60_000;
//RS /// The largest restart budget a group may declare. It bounds the retained
//RS /// restart-instant window, so supervision cannot grow unbounded state.
//RS const MAX_SERVICE_RESTART_BUDGET: i64 = 1_000;
//RS 
//RS #[derive(Clone, Debug, PartialEq, Eq)]
//RS enum JetServiceRestart {
//RS     OneForOne,
//RS     OneForAll,
//RS     RestForOne,
//RS }
//RS 
//RS /// D-SERVICE1=D: the restart budget is typed data carried by the group that
//RS /// supervises a worker, so the supervisor decides from its own policy row
//RS /// instead of a global ceiling. `max` restarts are allowed inside a `per_ms`
//RS /// window; spending the budget escalates to the parent group.
//RS #[derive(Clone, Debug, PartialEq, Eq)]
//RS struct JetServiceRestartBudget {
//RS     max: i64,
//RS     per_ms: i64,
//RS }
//RS 
//RS impl JetServiceRestartBudget {
//RS     /// The ratified default: `.OneForOne(max: 5, per: time.minutes(1))`.
//RS     fn ratified_default() -> Self {
//RS         Self {
//RS             max: SERVICE_RESTART_MAX,
//RS             per_ms: SERVICE_RESTART_WINDOW_MS,
//RS         }
//RS     }
//RS 
//RS     fn is_valid(&self) -> bool {
//RS         self.max >= 1 && self.max <= MAX_SERVICE_RESTART_BUDGET && self.per_ms >= 1
//RS     }
//RS 
//RS     /// The one place the window boundary is computed. `spent` and `prune` both
//RS     /// read it, so the number the supervisor checks and the number it keeps
//RS     /// cannot disagree.
//RS     fn window_start(&self, now: i64) -> i64 {
//RS         now.saturating_sub(self.per_ms)
//RS     }
//RS 
//RS     /// How much of the budget is spent at `now`. A restart older than the
//RS     /// window no longer spends budget, which is what "bounded restart budget
//RS     /// per window" means.
//RS     fn spent(&self, restarts: &[i64], now: i64) -> i64 {
//RS         let start = self.window_start(now);
//RS         restarts.iter().filter(|at| **at > start).count() as i64
//RS     }
//RS 
//RS     /// Drop the instants the window no longer counts, so the list length is
//RS     /// always the spent budget.
//RS     fn prune(&self, restarts: &mut Vec<i64>, now: i64) {
//RS         let start = self.window_start(now);
//RS         restarts.retain(|at| *at > start);
//RS     }
//RS }
