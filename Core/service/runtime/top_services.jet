//RS const MAX_SERVICE_IDEMPOTENCY: usize = 100_000;
//RS const MAX_SERVICE_DEAD_LETTERS: usize = 100_000;
//RS const MAX_SERVICE_STATE_RECORDS: usize = 100_000;
//RS const MAX_SERVICE_STATE_SCHEMA: usize = 256;
//RS const MAX_SERVICE_STATE_STORE: usize = 4096;
//RS const MAX_SERVICE_STATE_BYTES: usize = 128 * 1024 * 1024;
