    loop group in &tree.groups -> group.restart = tree.restart.clone()
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:1460
fn jet_services_worker(tree: &JetServiceTree, name: String, handler: JetServiceWorkerHandler, handler_name: String, capacity: I64) -> JetServiceEndpoint JetServiceError! {
    if tree.started -> return Err(JetServiceError.Policy("cannot add workers after start"))
    if capacity <= 0 || capacity > MAX_SERVICE_CAPACITY {
        return Err(JetServiceError.Policy("mailbox capacity must be positive and bounded"))
    }
    if name.trim().is_empty() || name.chars().any(fn(c) { c.is_control() }) || name.len() > MAX_SERVICE_NAME {
        return Err(JetServiceError.Policy("worker name must be non-empty and visible"))
    }
    if handler_name.trim().is_empty() || handler_name.chars().any(fn(c) { c.is_control() }) || handler_name.len() > MAX_SERVICE_NAME {
        return Err(JetServiceError.Policy("worker handler name must be non-empty and visible"))
    }
    if tree.workers.len() >= MAX_SERVICE_WORKERS -> return Err(JetServiceError.Policy("service tree worker limit exceeded"))
    if tree.workers.iter().any(fn(w) { w.name == name }) {
        return Err(JetServiceError.Unknown(format!("worker `{name}` already exists in tree `{}`", tree.name)))
    }
    if tree.authority.is_empty() -> tree.authority = service_authority_provider_issue()?
    endpoint :: service_authority_endpoint_unchecked(tree.name.clone(), name.clone(), tree.generation, tree.authority.clone())?
    mailbox :: jet_services_new_mailbox(^endpoint, capacity, [])?
    endpoint :: mailbox.endpoint.clone()
    // Allocate the mailbox first: channel failure must not publish ghost authority.
    service_authority_register(&endpoint, false)?
    // GATE #4565: kernel primitive
    task :: #Unsafe("retain one real native worker state shared by worker and supervisor") {
        Arc.new(Mutex.new(JetServiceSupervisorState.new(JetServiceSupervisorStatus.Stopped)))
    }
    jet_services_bind_topology(&task, JetServiceTopologyKind.Task, jet_services_topology_worker_id(&tree.name, &name), Val(jet_services_topology_root_id(&tree.name)))?
    tree.workers.push(JetServiceWorker{handler_name: ^handler_name, handler, name: ^name,
        endpoint: endpoint.clone(), mailbox: ^mailbox, restarts: [], running: false,
        received_bytes: 0, sent_bytes: 0, task: ^task})
    Ok(^endpoint)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:1542
fn jet_services_group(tree: &JetServiceTree, name: String, workers: [String]) -> () JetServiceError! {
    if tree.started -> return Err(JetServiceError.Policy("cannot add groups after start"))
    if name.trim().is_empty() || name.chars().any(fn(c) { c.is_control() }) || name.len() > MAX_SERVICE_NAME
        || workers.is_empty() || workers.len() > MAX_SERVICE_WORKERS {
        return Err(JetServiceError.Policy("service group needs a visible name and at least one worker"))
    }
    if tree.groups.iter().any(fn(group) { group.name == name }) {
        return Err(JetServiceError.Policy(format!("group `{name}` already exists")))
    }
    loop w in &workers {
        if !tree.workers.iter().any(fn(worker) { &worker.name == w }) {
            return Err(JetServiceError.Unknown(format!("group `{name}` references unknown worker `{w}`")))
        }
    }
    if workers.iter().any(fn(worker) {
        tree.groups.iter().any(fn(group) { group.workers.iter().any(fn(member) { member == worker }) })
    }) -> return Err(JetServiceError.Policy("a worker can belong to only one service supervisor group"))
    if workers.iter().enumerate().any(fn((index, worker)) { workers[..index].iter().any(fn(seen) { seen == worker }) }) {
        return Err(JetServiceError.Policy(format!("group `{name}` lists a worker more than once")))
    }
    parent_id :: jet_services_topology_group_id(&tree.name, &name)
    loop worker_name in &workers {
        if Val(worker) :: tree.workers.iter().find(fn(worker) { &worker.name == worker_name }) {
            jet_services_reparent_topology(&worker.task, Val(parent_id.clone()))?
        }
    }
    tree.groups.push(JetServiceGroup{name: ^name, restart: tree.restart.clone(), budget: tree.restart_budget.clone(), workers: ^workers})
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:1607
fn jet_services_build_runtime_groups(tree: &JetServiceTree) -> () JetServiceError! {
    // GATE #4565: kernel primitive
    #Unsafe("retain native root and child task groups, register each worker exactly once, and own every join boundary") {
        group :: Arc.new(JetTaskGroupRuntime.new())
        supervisor_tasks := []
        assigned := [false; tree.workers.len()]
        loop definition in &tree.groups {
            child :: Arc.new(JetTaskGroupRuntime.new())
            supervisor :: Arc.new(Mutex.new(JetServiceSupervisorState.new(JetServiceSupervisorStatus.Starting)))
            jet_services_bind_topology(&supervisor, JetServiceTopologyKind.Supervisor,
                jet_services_topology_group_id(&tree.name, &definition.name), Val(jet_services_topology_root_id(&tree.name)))?
            jet_services_set_topology_policy(&supervisor, &definition.restart, &definition.budget)?
            loop worker_name in &definition.workers {
                index :: tree.workers.iter().position(fn(worker) { &worker.name == worker_name })
                    .ok_or_else(fn() { JetServiceError.Unknown(format!("worker `{worker_name}` disappeared")) })?
                assigned[index] = true
                child.register(tree.workers[index].task.clone())
            }
            group.register(JetServiceSupervisorTask{state: supervisor.clone(), child: child.clone()})
            jet_services_task_start(&supervisor)?
            supervisor_tasks.push(^supervisor)
        }
        // Ungrouped workers still own a supervisor boundary and join on close.
        ungrouped: Arc<JetTaskGroupRuntime<Arc<Mutex<JetServiceSupervisorState>>>>? := None
        loop (index, worker) in tree.workers.iter().enumerate() {
            if assigned[index] -> continue
            child :: ungrouped.get_or_insert_with(fn() { Arc.new(JetTaskGroupRuntime.new()) })
            child.register(worker.task.clone())
        }
        if Val(child) :: ungrouped {
            supervisor :: Arc.new(Mutex.new(JetServiceSupervisorState.new(JetServiceSupervisorStatus.Starting)))
            jet_services_bind_topology(&supervisor, JetServiceTopologyKind.Supervisor,
                jet_services_topology_group_id(&tree.name, "ungrouped"), Val(jet_services_topology_root_id(&tree.name)))?
            jet_services_set_topology_policy(&supervisor, &tree.restart, &tree.restart_budget)?
            group.register(JetServiceSupervisorTask{state: supervisor.clone(), child: child.clone()})
            jet_services_task_start(&supervisor)?
            supervisor_tasks.push(^supervisor)
        }
        tree.task_group = ^group
        tree.supervisor_tasks = ^supervisor_tasks
        Ok(())
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:1678
fn jet_services_start_with_worker_dispatcher<F: FnMut(&String, JetServiceWorkerHandler, &JetServiceEndpoint) -> () JetServiceError!>(
    tree: &JetServiceTree, dispatch: F) -> () JetServiceError! {
    dispatch := ^dispatch
    if tree.started -> return Err(JetServiceError.Policy("service tree is already started"))
    _rollout_lock :: jet_services_rollout_operation_lock(tree)?
    jet_services_restore_rollout_state(tree)?
    jet_services_validate_tree(tree)?
    if tree.name.trim().is_empty() || tree.name.chars().any(fn(c) { c.is_control() }) || tree.name.len() > MAX_SERVICE_NAME {
        return Err(JetServiceError.Policy("service tree name must be non-empty and visible"))
    }
    if tree.workers.is_empty() -> return Err(JetServiceError.Policy("service tree has no workers"))
    durable_records :: match (&tree.state_adapter, &tree.state_authority) {
        (JetServiceStateAdapter.Empty, None) -> []
        (JetServiceStateAdapter.Snapshot, Val(authority)) -> jet_services_state_store_load(authority, &JetServiceStateAdapter.Snapshot)?
        (JetServiceStateAdapter.EventLog, Val(authority)) -> jet_services_state_store_load(authority, &JetServiceStateAdapter.EventLog)?
        (JetServiceStateAdapter.Empty, Val(_)) | (JetServiceStateAdapter.Snapshot, None) | (JetServiceStateAdapter.EventLog, None) -> {
            return Err(JetServiceError.Policy("durable service state needs its injected authority"))
        }
    }
    match &tree.state_adapter {
        .Empty -> {
            if tree.snapshot.is_some() || !tree.event_log.is_empty() {
                return Err(JetServiceError.Policy("Empty state adapter cannot contain durable records"))
            }
        }
        .Snapshot -> {
            if !tree.event_log.is_empty() {
                return Err(JetServiceError.Policy("Snapshot state adapter cannot contain event-log records"))
            }
            if durable_records.len() > 1 -> return Err(jet_services_state_error("snapshot store contains more than one record"))
        }
        .EventLog -> {
            if tree.snapshot.is_some() -> return Err(JetServiceError.Policy("EventLog state adapter cannot contain a snapshot"))
            if tree.event_log.len() > MAX_SERVICE_STATE_RECORDS -> return Err(JetServiceError.Policy("event-log record limit exceeded"))
        }
    }
    match &tree.state_adapter {
        .Snapshot -> tree.snapshot = durable_records.into_iter().next()
        .EventLog -> tree.event_log = ^durable_records
        .Empty -> {}
    }
    if tree.state_authority.is_some() {
        durable_workflows := jet_services_workflow_store_load(tree)?
        // Replay position is live state; compare histories at durable beginning.
        materialized_workflows := tree.workflows.clone()
        loop workflow in &materialized_workflows -> workflow.replay_cursor = 0
        if !materialized_workflows.is_empty() && materialized_workflows != durable_workflows {
            return Err(jet_services_state_error("in-memory workflow history does not match the durable workflow log"))
        }
        loop workflow in &durable_workflows -> workflow.replay_cursor = 0
        tree.workflows = ^durable_workflows
    }
    // Reopen stopped channels from the one durable queue before publication.
    preserve_mailboxes :: tree.delivery == JetServiceDelivery.DurableAtLeastOnce
    loop worker in &tree.workers {
        // GATE #4565: kernel primitive
        messages :: if preserve_mailboxes {
            #Unsafe("snapshot the actual bounded FIFO before replacing a closed mailbox") { worker.mailbox.channel.snapshot() }
        } else { [] }
        worker.mailbox = jet_services_new_mailbox(worker.mailbox.endpoint.clone(), worker.mailbox.capacity, ^messages)?
        worker.endpoint = worker.mailbox.endpoint.clone()
    }
    jet_services_build_runtime_groups(tree)?
    activated := [JetServiceEndpoint].with_capacity(tree.workers.len())
    loop index in 0..tree.workers.len() {
        draining :: tree.draining.iter().any(fn(name) { name == &tree.workers[index].name })
        partitioned :: tree.partitioned.iter().any(fn(name) { name == &tree.workers[index].name })
        // GATE #4565: kernel primitive
        running :: !partitioned && (!draining || #Unsafe("inspect the native queue depth under its FIFO mutex") {
            tree.workers[index].mailbox.channel.depth() > 0
        })
        // Keep the drain authority gate for accepted receipts while its task stops.
        authority_started :: !partitioned && (running || draining)
        tree.workers[index].running = running
        if !running {
            // GATE #4565: kernel primitive
            #Unsafe("update stopped/partitioned native worker state under its own mutex") {
                if Ok(state) :: tree.workers[index].task.lock() {
                    state.status = if partitioned { JetServiceSupervisorStatus.Partitioned } else { JetServiceSupervisorStatus.Stopped }
                    state.failure = partitioned.then_some(JetTaskFailure.Cancelled)
                }
            }
        } else { jet_services_task_start(&tree.workers[index].task)? }
        endpoint :: tree.workers[index].endpoint.clone()
        result :: match jet_services_authority_update(&endpoint, authority_started) {
            Ok(()) -> Ok(())
            Err(JetServiceError.Partitioned(_)) | Err(JetServiceError.Unavailable(_)) -> service_authority_register(&endpoint, authority_started)
            Err(error) -> Err(^error)
        }.and_then(fn(()) {
            if running { jet_services_bind_delivery_endpoint(&tree.delivery, tree.state_authority.as_ref(), &endpoint) }
            else { Ok(()) }
        }).and_then(fn(()) {
            if running { dispatch(&tree.workers[index].handler_name, tree.workers[index].handler, &endpoint) }
            else { Ok(()) }
        })
        if Err(error) :: result {
            rollback_error := None
            _ :: jet_services_authority_update(&endpoint, false)
            loop endpoint in &activated {
                if Err(error) :: jet_services_authority_update(endpoint, false) {
                    rollback_error = Val(^error)
                    break
                }
            }
            loop worker in &tree.workers -> worker.running = false
            jet_services_close_runtime_groups(tree)
            return Err(match rollback_error {
                Val(rollback_error) -> JetServiceError.Policy(format!("{}; service authority activation rollback failed: {}", error.jet_show(), rollback_error.jet_show()))
                None -> ^error
            })
        }
        activated.push(^endpoint)
    }
    tree.started = true
    if Err(error) :: jet_services_rollout_store_write(tree) {
        tree.started = false
        jet_services_close_runtime_groups(tree)
        loop worker in &tree.workers {
            worker.running = false
            _ :: jet_services_authority_update(&worker.endpoint, false)
            _ :: jet_services_authority_update_draining(&worker.endpoint, false)
        }
        jet_services_publish_root_state(tree, JetDevtoolsTopologySupervisorState.Failed)
        return Err(^error)
    }
    jet_services_publish_tree_topology(tree, JetDevtoolsTopologySupervisorState.Running)
    Ok(())
}
