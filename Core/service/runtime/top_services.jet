// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:572
fn jet_services_publish_tree_topology(tree: &JetServiceTree, root_state: JetDevtoolsTopologySupervisorState) -> {
    jet_services_publish_root_state(tree, root_state)
    for supervisor in &tree.supervisor_tasks {
        // GATE #4565: kernel primitive
        match #Unsafe("borrow each native supervisor state for topology publication") { supervisor.lock() } {
            Ok(state) -> jet_services_topology_publish_state(&state)
            Err(_) -> {}
        }
    }
    for worker in &tree.workers {
        // GATE #4565: kernel primitive
        restart_policy :: #Unsafe("borrow the worker's real restart policy under its native guard") {
            worker.task.lock().ok().and_then(fn(state) { state.topology_restart_policy.clone() })
        }
        // GATE #4565: kernel primitive
        match #Unsafe("borrow the worker state for topology publication") { worker.task.lock() } {
            Ok(state) -> jet_services_topology_publish_state(&state)
            Err(_) -> {}
        }
        partitioned :: tree.partitioned.iter().any(fn(name) { name == &worker.name })
        draining :: tree.draining.iter().any(fn(name) { name == &worker.name })
        authority_state :: if partitioned -> JetDevtoolsTopologyEndpointAuthorityState.Revoked
            else if worker.running || draining -> JetDevtoolsTopologyEndpointAuthorityState.Verified
            else -> JetDevtoolsTopologyEndpointAuthorityState.Unverified
        connection :: if partitioned -> JetDevtoolsTopologyEndpointConnectionState.Closed
            else if draining -> JetDevtoolsTopologyEndpointConnectionState.Draining
            else if worker.running && worker.endpoint.channel.is_some() -> JetDevtoolsTopologyEndpointConnectionState.Connected
            else -> JetDevtoolsTopologyEndpointConnectionState.Unknown
        worker_id :: jet_services_topology_worker_id(&worker.endpoint.tree, &worker.name)
        jet_services_publish_endpoint_fact_with_transport(&worker.endpoint, authority_state, Val(^worker_id), connection, Val(worker.received_bytes), Val(worker.sent_bytes), ^restart_policy)
        (readiness, reason) :: if partitioned -> (JetDevtoolsTopologyReadinessState.NotReady, JetDevtoolsTopologyReadinessReason.AuthorityRevoked)
            else if worker.running -> (JetDevtoolsTopologyReadinessState.Ready, JetDevtoolsTopologyReadinessReason.ProbePassed)
            else -> (JetDevtoolsTopologyReadinessState.NotReady, JetDevtoolsTopologyReadinessReason.Stopped)
        jet_services_publish_readiness_fact(&worker.endpoint, readiness, reason)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:640
fn jet_services_task_start(task: &Arc<Mutex<JetServiceSupervisorState>>) -> () JetServiceError! {
    snapshot :: {
        // GATE #4565: kernel primitive
        state := #Unsafe("mutate native service task state and release the guard before publishing") { task.lock() }
            .map_err(fn(_) { JetServiceError.Policy("service task state lock is poisoned") })?
        state.status = JetServiceSupervisorStatus.Running
        state.failure = None
        state.joined = false
        state.topology_wait_target = None
