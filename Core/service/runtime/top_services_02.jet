fn jet_services_start_with_queue_dispatcher<F: FnMut(&String, &JetServiceEndpoint) -> () JetServiceError!>(
    tree: &JetServiceTree, dispatch: F) -> () JetServiceError! {
    dispatch := ^dispatch
