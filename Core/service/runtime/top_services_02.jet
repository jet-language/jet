// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3334
fn jet_services_state_adapter_name(adapter: &JetServiceStateAdapter) -> String {
    match adapter { JetServiceStateAdapter.Empty -> "empty", JetServiceStateAdapter.Snapshot -> "snapshot", JetServiceStateAdapter.EventLog -> "event-log" }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3342
fn jet_services_state_frame(payload: &String) -> [U8] {
    frame := "{payload.len()}:".into_bytes()
    frame.extend_from_slice(payload.as_bytes())
    ^frame
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3348
fn jet_services_state_header(authority: &JetServiceStateAuthority, adapter: &JetServiceStateAdapter) -> [U8] {
    header := "JET-SERVICE-STATE/1\nadapter:".as_bytes().to_vec()
    header.extend_from_slice(jet_services_state_adapter_name(adapter).as_bytes())
    header.extend_from_slice("\nschema:".as_bytes())
    header.extend_from_slice(&jet_services_state_frame(&authority.schema))
    header.extend_from_slice("\nversion:".as_bytes())
    header.extend_from_slice(authority.version.to_string().as_bytes())
    header.extend_from_slice("\nmigration:".as_bytes())
    header.extend_from_slice(&jet_services_state_frame(&authority.migration))
    header.extend_from_slice("\n".as_bytes())
    ^header
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3364
fn jet_services_state_error<T: Into<String>>(message: T) -> JetServiceError {
    message :: message.into()
    JetServiceError.Policy("{message}; repair or replace the state store before retrying")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3371
fn jet_services_rollout_scalar<T: Display>(lines: &[U8], label: &String, value: T) -> {
    lines.extend_from_slice(label.as_bytes())
    lines.push(58)
    lines.extend_from_slice(value.to_string().as_bytes())
    lines.push(10)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3382
fn jet_services_rollout_frame(lines: &[U8], label: &String, value: &String) -> () JetServiceError! {
    if value.len() > MAX_SERVICE_MESSAGE || value.chars().any(fn(c) { c.is_control() }) {
        return Err(jet_services_state_error("rollout journal {label} contains invalid text"))
    }
    lines.extend_from_slice(label.as_bytes())
    lines.push(58)
    lines.extend_from_slice(&jet_services_state_frame(value))
    lines.push(10)
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3399
fn jet_services_rollout_read_line(lines: &Lines, label: &String) -> String JetServiceError! {
    line :: lines.next().ok_or_else(fn() { jet_services_state_error("rollout journal {label} is truncated") })?
    line.strip_prefix("{label}:").map(fn(value) { value.to_string() })
        .ok_or_else(fn() { jet_services_state_error("rollout journal {label} is invalid") })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3411
fn jet_services_rollout_read_scalar(lines: &Lines, label: &String) -> I64 JetServiceError! {
    jet_services_rollout_read_line(lines, label)?.parse<I64>()
        .map_err(fn(_) { jet_services_state_error("rollout journal {label} is invalid") })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3420
fn jet_services_rollout_read_count(lines: &Lines, label: &String) -> Usize JetServiceError! {
    count :: jet_services_rollout_read_line(lines, label)?.parse<Usize>()
        .map_err(fn(_) { jet_services_state_error("rollout journal {label} is invalid") })?
    if count > MAX_SERVICE_WORKERS -> return Err(jet_services_state_error("rollout journal {label} exceeds the worker limit"))
    Ok(count)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3435
fn jet_services_rollout_read_bool(lines: &Lines, label: &String) -> Bool JetServiceError! {
    match jet_services_rollout_read_line(lines, label)?.as_str() {
        "0" -> Ok(false)
        "1" -> Ok(true)
        _ -> Err(jet_services_state_error("rollout journal {label} is invalid"))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3448
fn jet_services_rollout_read_frame(lines: &Lines, label: &String) -> String JetServiceError! {
    value :: jet_services_rollout_read_line(lines, label)?
    (length, payload) :: value.split_once(":").ok_or_else(fn() { jet_services_state_error("rollout journal {label} length is missing") })?
    length :: length.parse<Usize>().map_err(fn(_) { jet_services_state_error("rollout journal {label} length is invalid") })?
    if length != payload.len() || length > MAX_SERVICE_MESSAGE || payload.chars().any(fn(c) { c.is_control() }) {
        return Err(jet_services_state_error("rollout journal {label} frame is invalid"))
    }
    Ok(payload.to_string())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3470
fn jet_services_rollout_name(value: &String, label: &String) -> () JetServiceError! {
    if value.trim().is_empty() || value.chars().any(fn(c) { c.is_control() }) || value.len() > MAX_SERVICE_NAME {
        return Err(jet_services_state_error("rollout journal {label} is not a valid service name"))
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3482
fn jet_services_rollout_snapshot(tree: &JetServiceTree) -> JetServiceRolloutState {
    JetServiceRolloutState{generation: tree.generation, previous_generation: tree.previous_generation,
        last_upgrade: tree.last_upgrade.clone(),
        workers: tree.workers.iter().map(fn(worker) { (worker.name.clone(), worker.endpoint.generation) }).collect(),
        draining: tree.draining.clone(), partitioned: tree.partitioned.clone(),
        directory: tree.directory.iter().map(fn((name, endpoint, _)) { (name.clone(), endpoint.worker.clone(), endpoint.generation) }).collect()
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3504
fn jet_services_rollout_encode(tree_name: &String, state: &JetServiceRolloutState) -> [U8] JetServiceError! {
    bytes := "JET-SERVICE-ROLLOUT/1\n".as_bytes().to_vec()
    jet_services_rollout_frame(&bytes, &"tree", tree_name)?
    jet_services_rollout_scalar(&bytes, &"generation", state.generation)
    jet_services_rollout_scalar(&bytes, &"previous", state.previous_generation)
    match &state.last_upgrade {
        None -> jet_services_rollout_scalar(&bytes, &"upgrade", "none")
        Some(receipt) -> {
            jet_services_rollout_scalar(&bytes, &"upgrade", "present")
            jet_services_rollout_scalar(&bytes, &"upgrade_from", receipt.from_generation)
            jet_services_rollout_scalar(&bytes, &"upgrade_to", receipt.to_generation)
            jet_services_rollout_frame(&bytes, &"upgrade_migration", &receipt.migration)?
            jet_services_rollout_frame(&bytes, &"upgrade_store", &receipt.rollback_store)?
            jet_services_rollout_scalar(&bytes, &"upgrade_available", if receipt.rollback_available { 1 } else { 0 })
            jet_services_rollout_scalar(&bytes, &"pinned_count", receipt.pinned_shards.len())
            loop name in &receipt.pinned_shards -> jet_services_rollout_frame(&bytes, &"pinned", name)?
        }
    }
    jet_services_rollout_scalar(&bytes, &"worker_count", state.workers.len())
    loop (name, generation) in &state.workers {
        jet_services_rollout_frame(&bytes, &"worker", name)?
        jet_services_rollout_scalar(&bytes, &"worker_generation", generation)
    }
    jet_services_rollout_scalar(&bytes, &"draining_count", state.draining.len())
    loop name in &state.draining -> jet_services_rollout_frame(&bytes, &"draining", name)?
    jet_services_rollout_scalar(&bytes, &"partitioned_count", state.partitioned.len())
    loop name in &state.partitioned -> jet_services_rollout_frame(&bytes, &"partitioned", name)?
    jet_services_rollout_scalar(&bytes, &"directory_count", state.directory.len())
    loop (name, worker, generation) in &state.directory {
        jet_services_rollout_frame(&bytes, &"directory_name", name)?
        jet_services_rollout_frame(&bytes, &"directory_worker", worker)?
        jet_services_rollout_scalar(&bytes, &"directory_generation", generation)
    }
    digest :: sha256_bytes(&bytes)
    bytes.extend_from_slice("checksum:".as_bytes())
    bytes.extend_from_slice(service_authority_hex(&digest).as_bytes())
    bytes.push(10)
    if bytes.len() > MAX_SERVICE_ROLLOUT_BYTES -> return Err(jet_services_state_error("rollout journal exceeds its byte limit"))
    Ok(^bytes)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3562
fn jet_services_rollout_decode(tree_name: &String, bytes: &[U8]) -> JetServiceRolloutState JetServiceError! {
    if bytes.len() > MAX_SERVICE_ROLLOUT_BYTES || bytes.last() != Some(&U8{10}) {
        return Err(jet_services_state_error("rollout journal exceeds its byte limit or is not newline terminated"))
    }
    marker :: "\nchecksum:".as_bytes()
    marker_start :: bytes.windows(marker.len()).rposition(fn(window) { window == marker })
        .ok_or_else(fn() { jet_services_state_error("rollout journal checksum is missing") })?
    checksum_start :: marker_start + 1 + "checksum:".len()
    checksum_end :: bytes.len() - 1
    checksum :: from_utf8(&bytes[checksum_start..checksum_end])
        .map_err(fn(_) { jet_services_state_error("rollout journal checksum is not valid UTF-8") })?
    if checksum.len() != 64 || !checksum.bytes().all(fn(byte) { byte.is_ascii_hexdigit() }) -> return Err(jet_services_state_error("rollout journal checksum is invalid"))
    expected :: service_authority_hex(&sha256_bytes(&bytes[..marker_start + 1]))
    if checksum != expected -> return Err(jet_services_state_error("rollout journal checksum does not match its contents"))
    text :: from_utf8(&bytes[..marker_start + 1]).map_err(fn(_) { jet_services_state_error("rollout journal is not valid UTF-8") })?
    lines := text.lines()
    if lines.next() != Some("JET-SERVICE-ROLLOUT/1") -> return Err(jet_services_state_error("rollout journal magic is invalid"))
    if jet_services_rollout_read_frame(&lines, &"tree")? != tree_name -> return Err(jet_services_state_error("rollout journal belongs to a different service tree"))
    generation :: jet_services_rollout_read_scalar(&lines, &"generation")?
    previous_generation :: jet_services_rollout_read_scalar(&lines, &"previous")?
    if generation < 1 || previous_generation < 0 || previous_generation >= generation -> return Err(jet_services_state_error("rollout journal generation order is invalid"))
    last_upgrade :: match jet_services_rollout_read_line(&lines, &"upgrade")?.as_str() {
        "none" -> None
        "present" -> {
            from_generation :: jet_services_rollout_read_scalar(&lines, &"upgrade_from")?
            to_generation :: jet_services_rollout_read_scalar(&lines, &"upgrade_to")?
            migration :: jet_services_rollout_read_frame(&lines, &"upgrade_migration")?
            rollback_store :: jet_services_rollout_read_frame(&lines, &"upgrade_store")?
            rollback_available :: jet_services_rollout_read_bool(&lines, &"upgrade_available")?
            pinned_count :: jet_services_rollout_read_count(&lines, &"pinned_count")?
            pinned_shards := [String].with_capacity(pinned_count)
            loop _ in 0..pinned_count {
                name :: jet_services_rollout_read_frame(&lines, &"pinned")?
                jet_services_rollout_name(&name, &"pinned shard")?
                if pinned_shards.iter().any(fn(seen) { seen == &name }) -> return Err(jet_services_state_error("rollout journal contains a duplicate pinned shard"))
                pinned_shards.push(^name)
            }
            if from_generation < 1 || to_generation <= from_generation || to_generation != generation || from_generation != previous_generation {
                return Err(jet_services_state_error("rollout journal receipt generations do not match the active generation"))
            }
            _ :: jet_services_migration_from_name(&migration)?
            if rollback_available != !rollback_store.is_empty() -> return Err(jet_services_state_error("rollout journal rollback availability is inconsistent"))
            Some(JetServiceUpgradeReceipt{from_generation, to_generation, migration: ^migration, rollback_store: ^rollback_store,
                rollback_available, pinned_shards: ^pinned_shards})
        }
        _ -> return Err(jet_services_state_error("rollout journal upgrade marker is invalid"))
    }
    if last_upgrade.is_none() && previous_generation != 0 -> return Err(jet_services_state_error("rollout journal has a previous generation without a receipt"))
    worker_count :: jet_services_rollout_read_count(&lines, &"worker_count")?
    workers := [(String, I64)].with_capacity(worker_count)
    loop _ in 0..worker_count {
        name :: jet_services_rollout_read_frame(&lines, &"worker")?
        jet_services_rollout_name(&name, &"worker")?
        worker_generation :: jet_services_rollout_read_scalar(&lines, &"worker_generation")?
        if worker_generation < 1 || (worker_generation != generation && last_upgrade.as_ref().is_none_or(fn(receipt) { worker_generation != receipt.from_generation })) {
            return Err(jet_services_state_error("rollout journal worker generation is not allowed"))
        }
        if workers.iter().any(fn((seen, _)) { seen == &name }) -> return Err(jet_services_state_error("rollout journal contains a duplicate worker"))
        workers.push((^name, worker_generation))
    }
    draining_count :: jet_services_rollout_read_count(&lines, &"draining_count")?
    draining := [String].with_capacity(draining_count)
    loop _ in 0..draining_count {
        name :: jet_services_rollout_read_frame(&lines, &"draining")?
        jet_services_rollout_name(&name, &"draining worker")?
        if draining.iter().any(fn(seen) { seen == &name }) -> return Err(jet_services_state_error("rollout journal contains a duplicate draining worker"))
        draining.push(^name)
    }
    partitioned_count :: jet_services_rollout_read_count(&lines, &"partitioned_count")?
    partitioned := [String].with_capacity(partitioned_count)
    loop _ in 0..partitioned_count {
        name :: jet_services_rollout_read_frame(&lines, &"partitioned")?
        jet_services_rollout_name(&name, &"partitioned worker")?
        if partitioned.iter().any(fn(seen) { seen == &name }) || draining.iter().any(fn(seen) { seen == &name }) {
            return Err(jet_services_state_error("rollout journal has overlapping or duplicate worker state"))
        }
        partitioned.push(^name)
    }
    directory_count :: jet_services_rollout_read_count(&lines, &"directory_count")?
    directory := [(String, String, I64)].with_capacity(directory_count)
    loop _ in 0..directory_count {
        name :: jet_services_rollout_read_frame(&lines, &"directory_name")?
        worker :: jet_services_rollout_read_frame(&lines, &"directory_worker")?
        jet_services_rollout_name(&name, &"directory name")?
        jet_services_rollout_name(&worker, &"directory worker")?
        worker_generation :: jet_services_rollout_read_scalar(&lines, &"directory_generation")?
        if worker_generation < 1 || directory.iter().any(fn((seen, _, _)) { seen == &name }) -> return Err(jet_services_state_error("rollout journal directory entry is invalid"))
        directory.push((^name, ^worker, worker_generation))
    }
    if lines.next().is_some() -> return Err(jet_services_state_error("rollout journal has trailing records"))
    Ok(JetServiceRolloutState{generation, previous_generation, last_upgrade: ^last_upgrade,
        workers: ^workers, draining: ^draining, partitioned: ^partitioned, directory: ^directory})
}

