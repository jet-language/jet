    }
    (message, should_stop, mailbox_before, snapshot) :: {
        worker :: jet_services_find_worker_mut(tree, endpoint)?
        if !worker.running && worker.mailbox.channel.depth() == 0 -> return Err(JetServiceError.NotStarted("worker `{worker.name}` is not running"))
        mailbox_before :: worker.mailbox.channel.snapshot()
