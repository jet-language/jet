    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3276
fn jet_services_set_state_snapshot(tree: &JetServiceTree, store: JetServiceStateStore, schema: String, version: I64, migration: String) -> () JetServiceError! {
    if tree.started -> return Err(JetServiceError.Policy("cannot change state adapter after start"))
    if tree.snapshot.is_some() || !tree.event_log.is_empty() -> return Err(JetServiceError.Policy("cannot replace a state adapter after it has records"))
    migration :: jet_services_migration_from_name(&migration)?
    authority :: jet_services_state_authority(&store, ^schema, version, ^migration)?
    tree.state_adapter = JetServiceStateAdapter.Snapshot
    tree.state_authority = Some(jet_services_attach_state_authority(&authority, JetServiceStateAdapter.Snapshot)?)
    Ok(())
}
