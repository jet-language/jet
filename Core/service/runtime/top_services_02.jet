            }
            Err(JetServiceChannelError.Closed) -> return Err(JetServiceError.NotStarted("mailbox for `{worker.name}` is closed"))
            Err(JetServiceChannelError.Full(_)) -> return Err(JetServiceError.Policy("service channel returned an invalid receive result"))
        }
        message_bytes :: message.len() as U64
        worker.sent_bytes = worker.sent_bytes.saturating_add(message_bytes)
        // GATE #4565: kernel primitive
        snapshot :: #Unsafe("snapshot synchronized worker state after receiving without retaining mutex guard") {
            if Ok(state) :: worker.task.lock() {
                state.status = JetServiceSupervisorStatus.Running
                state.topology_wait_target = None
                Some(state.clone())
            } else { None }
        }
        should_stop :: worker.mailbox.channel.depth() == 0
        (^message, should_stop, ^mailbox_before, ^snapshot)
    }
    if Some(snapshot) :: snapshot.as_ref() -> jet_services_topology_publish_state(snapshot)
    if draining && should_stop {
        if Err(error) :: jet_services_finish_drain(tree, endpoint) {
            restore :: tree.workers.iter_mut().find(fn(worker) { worker.endpoint == endpoint })
                .ok_or_else(fn() { JetServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} disappeared while restoring a drained mailbox") })
                .and_then(fn(worker) { jet_services_restore_mailbox(worker, ^mailbox_before, draining) })
            return Err(match restore {
                Ok(()) -> ^error
                Err(restore_error) -> JetServiceError.Policy("{error.jet_show()}; drained mailbox restore failed: {restore_error.jet_show()}")
            })
        }
    }
