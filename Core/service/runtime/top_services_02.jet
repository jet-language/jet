// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3123
fn jet_services_send_durable(tree: &JetServiceTree, endpoint: &JetServiceEndpoint, message: String, idempotency_key: String) -> JetDelivery JetServiceError! {
    if tree.delivery != JetServiceDelivery.DurableAtLeastOnce -> return Err(JetServiceError.Policy("send_durable requires DurableAtLeastOnce delivery"))
    authority :: tree.state_authority.as_ref().ok_or_else(fn() { JetServiceError.Policy("durable service delivery needs its injected authority") })?
    // Delivery framing has its own sibling file; sharing state store would corrupt adapter reads.
    runtime :: JetServiceRuntime{store: jet_services_delivery_store(&authority.store), retention_ms: 0}
    if idempotency_key.is_empty() || idempotency_key.len() > MAX_SERVICE_NAME || idempotency_key.chars().any(fn(c) { c.is_control() }) {
        return Err(JetServiceError.Policy("durable send requires a non-empty idempotency key"))
    }
    if message.len() > MAX_SERVICE_MESSAGE || message.chars().any(fn(c) { c.is_control() }) -> return Err(JetServiceError.Policy("service message exceeds the 1 MiB limit"))
    if !tree.started -> return Err(JetServiceError.NotStarted("service tree is not started"))
    jet_services_validate_endpoint(tree, endpoint)?
    draining :: tree.draining.iter().any(fn(name) { name == &endpoint.worker })
    if draining -> return Err(JetServiceError.Unavailable("service endpoint is draining"))
    local_id :: service_authority_id(&runtime, endpoint, &message, &idempotency_key)
    if jet_services_local_delivery_ids(tree, endpoint, &runtime.store).iter().any(fn(id) { id == &local_id }) {
        return Ok(JetDelivery{id: ^local_id, store: runtime.store.clone(), duplicate: true,
            authority: endpoint.authority.clone(), generation: endpoint.generation})
    }
    delivery :: jet_services_runtime_send(&runtime, endpoint, &message, &idempotency_key)?
    id :: delivery.id.clone()
    if jet_services_delivery_status(&delivery)? != JetDeliveryState.Accepted -> return Ok(^delivery)
    before :: tree.workers.iter().find(fn(worker) { worker.name == endpoint.worker }).map(fn(worker) { worker.mailbox.channel.snapshot() })
        .ok_or_else(fn() { JetServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not in this tree") })?
    if Err(error) :: jet_services_send(tree, endpoint, message.clone()) {
        if JetServiceError.Full(_) :: error {
            _ :: jet_services_runtime_dead_letter(&runtime, &delivery)
            if tree.dead_letters.len() < MAX_SERVICE_DEAD_LETTERS -> tree.dead_letters.push(^id)
        }
        return Err(^error)
    }
    if Err(error) :: jet_services_authority_mark_delivered(&runtime.store, &id) {
        rollback :: tree.workers.iter_mut().find(fn(worker) { worker.name == endpoint.worker })
            .ok_or_else(fn() { JetServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} disappeared during durable delivery") })
            .and_then(fn(worker) { jet_services_restore_mailbox(worker, ^before, draining) })
        return Err(match rollback {
            Ok(()) -> ^error
            Err(rollback_error) -> JetServiceError.Policy("{error.jet_show()}; mailbox rollback failed: {rollback_error.jet_show()}")
        })
    }
    if tree.idempotency_seen.len() < MAX_SERVICE_IDEMPOTENCY && !tree.idempotency_seen.iter().any(fn((key, _, _)) { key == &idempotency_key }) {
        tree.idempotency_seen.push((^idempotency_key, endpoint.clone(), ^message))
    }
    Ok(^delivery)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3245
fn jet_services_dead_letter_count(tree: &JetServiceTree) -> I64 { tree.dead_letters.len() as I64 }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3249
fn jet_services_drain_dead_letters(tree: &JetServiceTree) -> I64 JetServiceError! {
    if !tree.started -> return Err(JetServiceError.NotStarted("service tree is not started"))
    n :: tree.dead_letters.len() as I64
    tree.dead_letters.clear()
    Ok(n)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3260
fn jet_services_set_state_empty(tree: &JetServiceTree) -> () JetServiceError! {
    if tree.started -> return Err(JetServiceError.Policy("cannot change state adapter after start"))
    if tree.snapshot.is_some() || !tree.event_log.is_empty() -> return Err(JetServiceError.Policy("cannot discard state records while selecting Empty state adapter"))
