// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2843
fn jet_services_mailbox_depth(tree: &JetServiceTree, endpoint: &JetServiceEndpoint) -> I64 JetServiceError! {
    jet_services_validate_endpoint(tree, endpoint)?
    tree.workers.iter().find(fn(worker) { worker.name == endpoint.worker && worker.endpoint.tree == endpoint.tree })
        .map(fn(worker) { worker.mailbox.channel.depth() as I64 })
        .ok_or_else(fn() { JetServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not in this tree") })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2860
fn jet_services_local_delivery_ids(tree: &JetServiceTree, endpoint: &JetServiceEndpoint, store: &String) -> [String] {
    worker :: tree.workers.iter().find(fn(worker) {
        worker.name == endpoint.worker && worker.endpoint.tree == endpoint.tree
            && worker.endpoint.authority == endpoint.authority && worker.endpoint.generation == endpoint.generation
    })
    if worker.is_none() -> return []
    messages :: worker.unwrap().mailbox.channel.snapshot()
    runtime :: JetServiceRuntime{store: store.to_string(), retention_ms: 0}
    tree.idempotency_seen.iter().filter_map(fn((key, recorded_endpoint, message)) {
        if recorded_endpoint.tree != endpoint.tree || recorded_endpoint.worker != endpoint.worker
            || recorded_endpoint.authority != endpoint.authority || !messages.iter().any(fn(queued) { queued == message }) -> return None
        Some(service_authority_id(&runtime, recorded_endpoint, message, key))
    }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2902
fn jet_services_supervising_policy(tree: &JetServiceTree, worker: &String) -> (JetServiceRestart, JetServiceRestartBudget) {
    tree.groups.iter().find(fn(group) { group.workers.iter().any(fn(name) { name == worker }) })
        .map(fn(group) { (group.restart.clone(), group.budget.clone()) })
        .unwrap_or_else(fn() { (tree.restart.clone(), tree.restart_budget.clone()) })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2913
fn jet_services_fail_worker(tree: &JetServiceTree, endpoint: &JetServiceEndpoint) -> () JetServiceError! {
    if !tree.started -> return Err(JetServiceError.NotStarted("service tree is not started"))
    jet_services_validate_endpoint(tree, endpoint)?
    // One policy row controls restart and escalation together.
    (restart, budget) :: jet_services_supervising_policy(tree, &endpoint.worker)
    now :: service_authority_now()
    preserve_mailboxes :: tree.delivery == JetServiceDelivery.DurableAtLeastOnce
    worker_name :: endpoint.worker.clone()
    start :: tree.workers.iter().position(fn(worker) { worker.name == worker_name })
        .ok_or_else(fn() { JetServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not in this tree") })?
    supervisor_index :: tree.groups.iter().position(fn(group) { group.workers.iter().any(fn(name) { name == &worker_name }) })
        .unwrap_or(tree.groups.len())
    scope :: if Some(group) :: tree.groups.iter().find(fn(group) { group.workers.iter().any(fn(name) { name == &worker_name }) }) {
        group.workers.iter().filter_map(fn(name) { tree.workers.iter().position(fn(worker) { &worker.name == name }) }).collect()
    } else {
        tree.workers.iter().enumerate()
            .filter(fn((_, worker)) { !tree.groups.iter().any(fn(group) { group.workers.iter().any(fn(name) { name == &worker.name }) }) })
            .map(fn((index, _)) { index }).collect()
    }
    start_in_scope :: scope.iter().position(fn(index) { index == start }).unwrap_or(0)
    target_indices := []
    match restart {
        JetServiceRestart.OneForOne -> target_indices.push(start)
        JetServiceRestart.OneForAll -> target_indices.extend(scope.iter().copied())
        JetServiceRestart.RestForOne -> target_indices.extend(scope.iter().skip(start_in_scope).copied())
    }
    loop index in &target_indices {
        worker :: &tree.workers[index]
        if budget.spent(&worker.restarts, now) >= budget.max {
            reason :: "worker `{worker.name}` spent its restart budget of {budget.max} per {budget.per_ms}ms; the supervisor escalates to its parent group"
            loop worker in &tree.workers -> _ :: jet_services_task_escalate(&worker.task, reason.clone())
            loop supervisor in &tree.supervisor_tasks -> _ :: jet_services_task_escalate(supervisor, reason.clone())
            loop worker in &tree.workers {
                worker.running = false
                _ :: jet_services_authority_update(&worker.endpoint, false).or_else(fn(_) { service_authority_register(&worker.endpoint, false) })
            }
            jet_services_close_runtime_groups(tree)
            tree.started = false
            jet_services_publish_tree_topology(tree, JetDevtoolsTopologySupervisorState.Escalated)
            return Err(JetServiceError.Unavailable(^reason))
        }
    }
    desired_running :: tree.workers.iter().enumerate().map(fn((index, worker)) {
        if target_indices.iter().any(fn(target) { target == index }) {
            !tree.partitioned.iter().any(fn(name) { name == &worker.name })
        } else { worker.running }
    }).collect()
    authority_updated := [Usize].new()
    loop (index, worker) in tree.workers.iter().enumerate() {
        if Err(error) :: jet_services_authority_update(&worker.endpoint, desired_running[index]) {
            rollback_error := None
            loop rollback_index in authority_updated.into_iter().rev() {
                if Err(error) :: jet_services_authority_update(&tree.workers[rollback_index].endpoint, tree.workers[rollback_index].running) {
                    _ :: rollback_error.get_or_insert(^error)
                }
            }
            return Err(match rollback_error {
                Some(rollback_error) -> JetServiceError.Policy("{error.jet_show()}; service failure authority rollback failed: {rollback_error.jet_show()}")
                None -> ^error
            })
        }
        authority_updated.push(index)
    }
    _ :: jet_services_task_fail(&tree.workers[start].task, "worker `{worker_name}` failed under supervisor")
    if Some(supervisor) :: tree.supervisor_tasks.get(supervisor_index) -> _ :: jet_services_task_fail(supervisor, "supervisor restarted worker `{worker_name}`")
    loop index in ^target_indices -> jet_services_restart_worker(&tree.workers[index], &budget, now, preserve_mailboxes)
    if Some(supervisor) :: tree.supervisor_tasks.get(supervisor_index) -> _ :: jet_services_task_restart(supervisor)
    // Restart cannot silently rejoin an authority-partitioned side of the graph.
    loop worker in &tree.workers {
        if tree.partitioned.iter().any(fn(name) { name == &worker.name }) {
            worker.running = false
            // GATE #4565: kernel primitive
            #Unsafe("retain partitioned service status and cancelled failure under the native task mutex") {
                if Ok(state) :: worker.task.lock() {
                    state.status = JetServiceSupervisorStatus.Partitioned
                    state.failure = Some(JetTaskFailure.Cancelled)
                }
            }
        }
    }
    jet_services_publish_tree_topology(tree, JetDevtoolsTopologySupervisorState.Running)
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:3076
fn jet_services_restarts(tree: &JetServiceTree, endpoint: &JetServiceEndpoint) -> I64 JetServiceError! {
    jet_services_validate_endpoint(tree, endpoint)?
    (_, budget) :: jet_services_supervising_policy(tree, &endpoint.worker)
    now :: service_authority_now()
    tree.workers.iter().find(fn(worker) { worker.name == endpoint.worker && worker.endpoint.tree == endpoint.tree })
        .map(fn(worker) { budget.spent(&worker.restarts, now) })
        .ok_or_else(fn() { JetServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not in this tree") })
}
