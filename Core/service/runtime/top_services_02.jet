// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:1922
fn jet_services_close_runtime_groups(tree: &JetServiceTree) -> {
    // GATE #4565: kernel primitive
    #Unsafe("replace owned root task group and cancel/join all retained supervisors and workers without detachment") {
        root :: replace(&tree.task_group, Arc.new(JetTaskGroupRuntime.new()))
        root.close_with_cancel(jet_services_cancel_supervisor, jet_services_join_supervisor)
        tree.supervisor_tasks.clear()
        loop worker in &tree.workers -> jet_services_join_task(worker.task.clone())
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:1934
fn jet_services_stop(tree: &JetServiceTree) -> () JetServiceError! {
    _rollout_lock :: jet_services_rollout_operation_lock(tree)?
    jet_services_publish_root_state(tree, JetDevtoolsTopologySupervisorState.Stopping)
    jet_services_close_runtime_groups(tree)
    preserve_mailboxes :: tree.delivery == JetServiceDelivery.DurableAtLeastOnce
    reset_partition :: tree.state_adapter == JetServiceStateAdapter.Empty
    first_error := None
    loop worker in &tree.workers {
        worker.running = false
        if reset_partition {
            if Err(error) :: jet_services_authority_update_partitioned(&worker.endpoint, false) -> _ :: first_error.get_or_insert(^error)
        }
        if Err(error) :: jet_services_authority_update(&worker.endpoint, false) -> _ :: first_error.get_or_insert(^error)
        if Err(error) :: jet_services_authority_update_draining(&worker.endpoint, false) -> _ :: first_error.get_or_insert(^error)
        if !preserve_mailboxes -> worker.mailbox.channel.clear()
        worker.mailbox.channel.close()
    }
    if tree.state_adapter == JetServiceStateAdapter.Empty {
        // Empty restart clears state; Snapshot/EventLog are explicit durable alternatives.
        tree.snapshot = None
        tree.event_log.clear()
        tree.dead_letters.clear()
        tree.idempotency_seen.clear()
        tree.directory.clear()
        tree.draining.clear()
        tree.partitioned.clear()
        tree.workflows.clear()
    }
    tree.started = false
    jet_services_publish_tree_topology(tree, JetDevtoolsTopologySupervisorState.Stopped)
    match first_error { Some(error) -> Err(^error), None -> Ok(()) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:1979
fn jet_services_restart_worker(worker: &JetServiceWorker, budget: &JetServiceRestartBudget, at: I64, preserve_mailbox: Bool) -> {
    worker.restarts.push(at)
    budget.prune(&worker.restarts, at)
    worker.running = true
    messages :: if preserve_mailbox { worker.mailbox.channel.snapshot() } else { [] }
    worker.mailbox.channel.close()
    worker.mailbox = jet_services_new_mailbox(worker.mailbox.endpoint.clone(), worker.mailbox.capacity, ^messages)
        .expect("validated service mailbox must restart with its bounded queue")
    _ :: jet_services_record_topology_restart(&worker.task,
        U64.try_from(at.max(0)).unwrap_or_else(fn(_) { jet_services_topology_now() }), JetDevtoolsTopologyRestartReason.Failed)
    _ :: jet_services_task_restart(&worker.task)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2011
fn jet_services_generation_is_pinned(tree: &JetServiceTree, worker: &String, generation: I64) -> Bool {
    tree.last_upgrade.as_ref().is_some_and(fn(receipt) {
        receipt.to_generation == tree.generation && receipt.from_generation == generation
            && receipt.pinned_shards.iter().any(fn(name) { name == worker })
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2022
fn jet_services_discharge_task(task: Arc<Mutex<JetServiceSupervisorState>>) -> () JetServiceError! {
    jet_services_cancel_task(&task)
    jet_services_join_task(task.clone())
    // GATE #4565: kernel primitive
    #Unsafe("verify joined service task under native mutex; poisoned state is an error, not detach") {
        state :: task.lock().map_err(fn(_) { JetServiceError.Policy("service task state lock is poisoned during drain") })?
        if !state.joined -> return Err(JetServiceError.Policy("service drain could not discharge its task handle"))
        Ok(())
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2038
fn jet_services_restart_tasks(tasks: &[Arc<Mutex<JetServiceSupervisorState>>]) -> () JetServiceError! {
    loop task in tasks -> jet_services_task_start(task)?
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2050
fn jet_services_discharge_workers(tree: &JetServiceTree, excluded_workers: &[String]) -> [Arc<Mutex<JetServiceSupervisorState>>] JetServiceError! {
    tasks :: tree.workers.iter()
        .filter(fn(worker) { worker.running && !excluded_workers.iter().any(fn(excluded) { excluded == &worker.name }) })
        .map(fn(worker) { worker.task.clone() }).collect()
    discharged := [Arc<Mutex<JetServiceSupervisorState>>].with_capacity(tasks.len())
    loop task in ^tasks {
        if Err(error) :: jet_services_discharge_task(task.clone()) {
            recovery := ^discharged
            recovery.push(^task)
            recovery_result :: jet_services_restart_tasks(&recovery)
            return Err(match recovery_result {
                Ok(()) -> ^error
                Err(recovery_error) -> JetServiceError.Policy("{error.jet_show()}; service task recovery failed: {recovery_error.jet_show()}")
            })
        }
        discharged.push(^task)
    }
    Ok(^discharged)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2085
fn jet_services_finish_drain(tree: &JetServiceTree, endpoint: &JetServiceEndpoint) -> () JetServiceError! {
    _rollout_lock :: jet_services_rollout_operation_lock(tree)?
    jet_services_validate_endpoint(tree, endpoint)?
    worker_index :: tree.workers.iter().position(fn(worker) {
        worker.name == endpoint.worker && worker.endpoint.tree == endpoint.tree
            && worker.endpoint.authority == endpoint.authority && worker.endpoint.generation == endpoint.generation
    }).ok_or_else(fn() { JetServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not in this tree") })?
    (worker_name, task, worker_endpoint, disposition) :: {
        worker :: &tree.workers[worker_index]
        disposition :: if jet_services_generation_is_pinned(tree, &worker.name, worker.endpoint.generation) {
            JetServiceDrainDisposition.PinShard
        } else { JetServiceDrainDisposition.Cancel }
        (worker.name.clone(), worker.task.clone(), worker.endpoint.clone(), disposition)
    }
    match disposition {
        JetServiceDrainDisposition.PinShard -> {
            // Drain old handle before promotion starts the new generation.
            jet_services_discharge_task(task.clone())?
            match jet_services_promote_worker_generation(tree, &worker_name) {
                Ok(true) -> {}
                Ok(false) -> {
                    _ :: jet_services_task_start(&task)
                    return Err(JetServiceError.Unavailable("drained shard has uncommitted durable delivery"))
                }
                Err(error) -> {
                    _ :: jet_services_task_start(&task)
                    return Err(^error)
                }
            }
        }
        JetServiceDrainDisposition.Cancel -> {
            jet_services_authority_update(&worker_endpoint, false)?
            if Err(error) :: jet_services_discharge_task(task.clone()) {
                recovery :: jet_services_authority_update(&worker_endpoint, true)
                return Err(match recovery {
                    Ok(()) -> ^error
                    Err(recovery_error) -> JetServiceError.Policy("{error.jet_show()}; drain authority recovery failed: {recovery_error.jet_show()}")
                })
            }
            tree.workers[worker_index].running = false
            // Retain completed drain intent until rollout commits the new generation.
        }
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2167
fn jet_services_worker_generation_allowed(tree: &JetServiceTree, worker: &JetServiceWorker) -> Bool {
    worker.endpoint.generation == tree.generation || jet_services_generation_is_pinned(tree, &worker.name, worker.endpoint.generation)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2172
fn jet_services_endpoint_generation_allowed(tree: &JetServiceTree, endpoint: &JetServiceEndpoint) -> Bool {
    endpoint.generation == tree.generation || jet_services_generation_is_pinned(tree, &endpoint.worker, endpoint.generation)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2180
fn jet_services_validate_endpoint(tree: &JetServiceTree, endpoint: &JetServiceEndpoint) -> () JetServiceError! {
    if endpoint.authority != tree.authority || endpoint.tree != tree.name {
        return Err(JetServiceError.Revoked("service endpoint {endpoint.tree}/{endpoint.worker} is not issued by this authority"))
    }
    if !jet_services_endpoint_generation_allowed(tree, endpoint) {
        return Err(JetServiceError.Stale("service endpoint {endpoint.tree}/{endpoint.worker}@g{endpoint.generation} is stale (current generation {tree.generation})"))
    }
    jet_services_authority_validate(endpoint)?
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2200
fn jet_services_validate_tree(tree: &JetServiceTree) -> () JetServiceError! {
    if tree.name.trim().is_empty() || tree.name.chars().any(fn(c) { c.is_control() }) || tree.name.len() > MAX_SERVICE_NAME
        || (tree.authority.trim().is_empty() && (tree.started || !tree.workers.is_empty()))
        || tree.authority.len() > MAX_SERVICE_NAME || tree.authority.chars().any(fn(c) { c.is_control() })
        || tree.generation < 1 || tree.previous_generation < 0 || tree.workers.len() > MAX_SERVICE_WORKERS
        || tree.groups.len() > MAX_SERVICE_WORKERS || tree.idempotency_seen.len() > MAX_SERVICE_IDEMPOTENCY
        || tree.dead_letters.len() > MAX_SERVICE_DEAD_LETTERS || tree.event_log.len() > MAX_SERVICE_STATE_RECORDS
        || tree.partitioned.len() > MAX_SERVICE_WORKERS || tree.workflows.len() > MAX_SERVICE_WORKFLOW_STEPS
        || !tree.restart_budget.is_valid() {
        return Err(JetServiceError.Policy("service tree metadata is invalid or exceeds its limit"))
    }
    worker_exists :: fn(name: &String, generation: I64) {
        tree.workers.iter().any(fn(worker) {
            worker.name == name && worker.endpoint.tree == tree.name && worker.endpoint.authority == tree.authority
                && worker.endpoint.generation == generation && jet_services_worker_generation_allowed(tree, worker)
        })
    }
    worker_name_exists :: fn(name: &String) {
        tree.workers.iter().any(fn(worker) {
            worker.name == name && worker.endpoint.tree == tree.name && worker.endpoint.authority == tree.authority
        })
    }
    worker_names := [String].with_capacity(tree.workers.len())
    loop worker in &tree.workers {
        messages :: worker.mailbox.channel.snapshot()
        depth :: messages.len()
        if worker.name.trim().is_empty() || worker.name.chars().any(fn(c) { c.is_control() }) || worker.name.len() > MAX_SERVICE_NAME
            || worker.endpoint.tree != tree.name || worker.endpoint.worker != worker.name || worker.endpoint.authority != tree.authority
            || !jet_services_worker_generation_allowed(tree, worker) || worker.restarts.iter().any(fn(at) { at < 0 })
            || worker.restarts.len() as I64 > MAX_SERVICE_RESTART_BUDGET
            || worker.restarts.windows(2).any(fn(pair) { pair[0] > pair[1] })
            || (tree.partitioned.iter().any(fn(name) { name == &worker.name }) && worker.running)
            || worker.mailbox.endpoint != worker.endpoint || worker.mailbox.capacity <= 0 || worker.mailbox.capacity > MAX_SERVICE_CAPACITY
            || depth > MAX_SERVICE_MESSAGES || depth > worker.mailbox.capacity as Usize
            || messages.iter().any(fn(message) { message.len() > MAX_SERVICE_MESSAGE || message.chars().any(fn(c) { c.is_control() }) }) {
            return Err(JetServiceError.Policy("service worker or mailbox state is invalid"))
        }
        if worker_names.iter().any(fn(seen) { seen == &worker.name }) -> return Err(JetServiceError.Policy("service worker names must be unique"))
        worker_names.push(worker.name.clone())
    }
    if tree.partitioned.iter().any(fn(name) {
        name.trim().is_empty() || name.chars().any(fn(c) { c.is_control() }) || name.len() > MAX_SERVICE_NAME || !worker_name_exists(name)
    }) || tree.partitioned.iter().enumerate().any(fn((index, name)) { tree.partitioned[..index].iter().any(fn(seen) { seen == name }) }) {
        return Err(JetServiceError.Policy("service partition state is invalid"))
    }
    group_names := [String].with_capacity(tree.groups.len())
    grouped_workers := []
    loop group in &tree.groups {
        if group.name.trim().is_empty() || group.name.chars().any(fn(c) { c.is_control() }) || group.name.len() > MAX_SERVICE_NAME
            || group.workers.is_empty() || group.workers.len() > MAX_SERVICE_WORKERS || !group.budget.is_valid()
            || group.workers.iter().any(fn(name) { !worker_name_exists(name) })
            || group.workers.iter().enumerate().any(fn((index, name)) { group.workers[..index].iter().any(fn(seen) { seen == name }) })
            || group.workers.iter().any(fn(name) { grouped_workers.iter().any(fn(seen) { seen == name }) })
            || group_names.iter().any(fn(seen) { seen == &group.name }) {
            return Err(JetServiceError.Policy("service group state is invalid"))
        }
        group_names.push(group.name.clone())
        grouped_workers.extend(group.workers.iter().cloned())
    }
    match (&tree.state_adapter, &tree.state_authority) {
        (JetServiceStateAdapter.Empty, None) -> {
            if tree.snapshot.is_some() || !tree.event_log.is_empty() -> return Err(JetServiceError.Policy("Empty state adapter cannot contain durable records"))
        }
        (JetServiceStateAdapter.Snapshot, Some(authority)) -> {
            checked :: jet_services_attach_state_authority(authority, JetServiceStateAdapter.Snapshot)?
            prefix :: "v{checked.version}:"
            if !tree.event_log.is_empty() -> return Err(JetServiceError.Policy("Snapshot state adapter cannot contain event-log records"))
            if Some(snapshot) :: &tree.snapshot {
                if snapshot.len() > MAX_SERVICE_MESSAGE -> return Err(JetServiceError.Policy("snapshot record exceeds the state record limit"))
                _ :: jet_services_read_state_record(&prefix, snapshot)?
            }
        }
        (JetServiceStateAdapter.EventLog, Some(authority)) -> {
            checked :: jet_services_attach_state_authority(authority, JetServiceStateAdapter.EventLog)?
            prefix :: "v{checked.version}:"
            if tree.snapshot.is_some() -> return Err(JetServiceError.Policy("EventLog state adapter cannot contain a snapshot"))
            loop event in &tree.event_log {
                if event.len() > MAX_SERVICE_MESSAGE || event.chars().any(fn(c) { c.is_control() }) -> return Err(JetServiceError.Policy("event record exceeds the state record limit"))
                _ :: jet_services_read_state_record(&prefix, event)?
            }
        }
        (JetServiceStateAdapter.Empty, Some(_)) | (JetServiceStateAdapter.Snapshot, None) | (JetServiceStateAdapter.EventLog, None) -> {
            return Err(JetServiceError.Policy("service state adapter and authority do not match"))
        }
    }
    if !tree.workflows.is_empty() && tree.state_authority.is_none() -> return Err(JetServiceError.Policy("workflow history requires the injected service state authority"))
    idempotency_keys := []
    loop (key, endpoint, message) in &tree.idempotency_seen {
        if key.is_empty() || key.len() > MAX_SERVICE_NAME || key.chars().any(fn(c) { c.is_control() })
            || message.len() > MAX_SERVICE_MESSAGE || message.chars().any(fn(c) { c.is_control() })
            || endpoint.tree != tree.name || endpoint.authority != tree.authority || !jet_services_endpoint_generation_allowed(tree, endpoint)
            || !worker_exists(&endpoint.worker, endpoint.generation) || idempotency_keys.iter().any(fn(seen) { seen == key }) {
            return Err(JetServiceError.Policy("durable idempotency state is invalid"))
        }
        idempotency_keys.push(key.clone())
    }
    if tree.directory.len() > MAX_SERVICE_WORKERS -> return Err(JetServiceError.Policy("service directory entry limit exceeded"))
    directory_names := []
    loop (name, endpoint, signature) in &tree.directory {
        if name.trim().is_empty() || name.chars().any(fn(c) { c.is_control() }) || name.len() > MAX_SERVICE_NAME
            || endpoint.tree != tree.name || endpoint.authority != tree.authority || !jet_services_endpoint_generation_allowed(tree, endpoint)
            || !worker_exists(&endpoint.worker, endpoint.generation) || signature.len() != 64
            || !signature.bytes().all(fn(byte) { byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase() })
            || directory_names.iter().any(fn(seen) { seen == name }) {
            return Err(JetServiceError.Policy("service directory state is invalid"))
        }
        if service_authority_validate_directory(&tree.authority, &tree.name, name, endpoint, signature).is_err() {
            return Err(JetServiceError.Policy("service directory state is invalid"))
        }
        directory_names.push(name.clone())
    }
    if tree.draining.len() > tree.workers.len() || tree.draining.iter().any(fn(name) { !worker_name_exists(name) }) {
        return Err(JetServiceError.Policy("service draining state is invalid"))
    }
    if Some(receipt) :: &tree.last_upgrade {
        if receipt.from_generation != tree.previous_generation || receipt.to_generation != tree.generation
            || receipt.from_generation < 1 || receipt.to_generation <= receipt.from_generation
            || receipt.pinned_shards.len() > tree.workers.len() || receipt.pinned_shards.iter().any(fn(name) { !worker_name_exists(name) })
            || receipt.pinned_shards.iter().enumerate().any(fn((index, name)) { receipt.pinned_shards[..index].iter().any(fn(seen) { seen == name }) })
            || tree.workers.iter().any(fn(worker) {
                receipt.pinned_shards.iter().any(fn(name) { name == &worker.name }) && worker.endpoint.generation != receipt.from_generation
            }) {
            return Err(JetServiceError.Policy("service upgrade receipt or pinned shard state is invalid"))
        }
    } else if tree.previous_generation != 0 {
        return Err(JetServiceError.Policy("service tree has a previous generation without an upgrade receipt"))
    }
    workflow_ids := [(String, I64, Bool)].new()
    loop workflow in &tree.workflows {
        if workflow.id.trim().is_empty() || workflow.id.chars().any(fn(c) { c.is_control() }) || workflow.id.len() > MAX_SERVICE_NAME
            || workflow.run_id <= 0 || workflow.version < 1 || workflow.steps.len() > MAX_SERVICE_WORKFLOW_STEPS
            || workflow.history.len() > MAX_SERVICE_WORKFLOW_STEPS || workflow.replay_cursor > workflow.history.len()
            || workflow.steps.iter().any(fn(step) { step.trim().is_empty() || step.chars().any(fn(c) { c.is_control() }) || step.len() > MAX_SERVICE_MESSAGE })
            || workflow.history.iter().any(fn(entry) { entry.trim().is_empty() || entry.chars().any(fn(c) { c.is_control() }) || entry.len() > MAX_SERVICE_MESSAGE })
            || workflow.activity_outcomes.len() > MAX_SERVICE_WORKFLOW_STEPS
            || workflow.activity_outcomes.iter().any(fn((key, outcome)) {
                key.trim().is_empty() || key.len() > MAX_SERVICE_NAME || key.chars().any(fn(c) { c.is_control() })
                    || match outcome {
                        JetTaskOutcome.Panicked(reason) -> reason.trim().is_empty() || reason.len() > MAX_SERVICE_MESSAGE || reason.chars().any(fn(c) { c.is_control() })
                        _ -> false
                    }
            })
            || workflow_ids.iter().any(fn((id, version, _)) { id == &workflow.id && version == workflow.version })
            || (workflow.outcome.is_none() && workflow_ids.iter().any(fn((id, _, live)) { id == &workflow.id && live })) {
            return Err(JetServiceError.Policy("service workflow state is invalid"))
        }
        workflow_ids.push((workflow.id.clone(), workflow.version, workflow.outcome.is_none()))
    }
    if tree.chaos_fails < 0 -> return Err(JetServiceError.Policy("service chaos counter is invalid"))
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2533
fn jet_services_find_worker_mut(tree: &JetServiceTree, endpoint: &JetServiceEndpoint) -> &JetServiceWorker JetServiceError! {
    jet_services_validate_endpoint(tree, endpoint)?
    tree.workers.iter_mut().find(fn(worker) {
        worker.name == endpoint.worker && worker.endpoint.tree == endpoint.tree
            && worker.endpoint.authority == endpoint.authority && worker.endpoint.generation == endpoint.generation
    }).ok_or_else(fn() { JetServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not in this tree") })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2554
fn jet_services_send(tree: &JetServiceTree, endpoint: &JetServiceEndpoint, message: String) -> () JetServiceError! {
    if !tree.started -> return Err(JetServiceError.NotStarted("service tree is not started"))
    jet_services_validate_endpoint(tree, endpoint)?
    if message.len() > MAX_SERVICE_MESSAGE || message.chars().any(fn(c) { c.is_control() }) {
        return Err(JetServiceError.Policy("service message exceeds the 1 MiB limit"))
    }
    message_bytes :: message.len() as U64
    draining :: tree.draining.iter().any(fn(name) { name == &endpoint.worker })
    (worker_name, capacity, running) :: {
        worker :: jet_services_find_worker_mut(tree, endpoint)?
        (worker.name.clone(), worker.mailbox.capacity, worker.running)
    }
    if !running || draining -> return Err(JetServiceError.NotStarted("worker `{worker_name}` is not running"))
    match service_authority_try_send(endpoint, ^message) {
        Ok(()) -> {}
        Err(JetServiceError.Full(_)) -> return Err(JetServiceError.Full("mailbox for `{worker_name}` is full (capacity {capacity})"))
        Err(error) -> return Err(^error)
    }
    if Ok(worker) :: jet_services_find_worker_mut(tree, endpoint) {
        worker.received_bytes = worker.received_bytes.saturating_add(message_bytes)
        // GATE #4565: kernel primitive
        #Unsafe("sample native service task state under mutex; drop guard before topology publication") {
            if Ok(state) :: worker.task.lock() {
                state.status = JetServiceSupervisorStatus.Running
                state.topology_wait_target = None
                snapshot :: state.clone()
                drop(^state)
                jet_services_topology_publish_state(&snapshot)
            }
        }
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2605
fn jet_services_restore_mailbox(worker: &JetServiceWorker, messages: [String], draining: Bool) -> () JetServiceError! {
    worker.mailbox.channel.close()
    worker.mailbox = jet_services_new_mailbox(worker.mailbox.endpoint.clone(), worker.mailbox.capacity, ^messages)?
    worker.endpoint = worker.mailbox.endpoint.clone()
    // Publish replacement channel before endpoint rehydration; rollback must not route into the closed queue.
    jet_services_authority_update(&worker.endpoint, worker.running || draining)?
    Ok(())
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:2625
fn jet_services_receive(tree: &JetServiceTree, endpoint: &JetServiceEndpoint) -> String JetServiceError! {
    if !tree.started -> return Err(JetServiceError.NotStarted("service tree is not started"))
    jet_services_validate_endpoint(tree, endpoint)?
    draining :: tree.draining.iter().any(fn(name) { name == &endpoint.worker })
    available :: tree.workers.iter().find(fn(worker) {
        worker.name == endpoint.worker && worker.endpoint.tree == endpoint.tree
            && worker.endpoint.authority == endpoint.authority && worker.endpoint.generation == endpoint.generation
    }).map(fn(worker) {
        if worker.running || draining { worker.mailbox.capacity.saturating_sub(worker.mailbox.channel.depth() as I64) } else { 0 }
    }).ok_or_else(fn() { JetServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not in this tree") })?
    // Drain closes sends but must consume durable receipts already in flight.
    if available > 0 {
        local_delivery_ids :: if tree.delivery == JetServiceDelivery.DurableAtLeastOnce {
            tree.state_authority.as_ref().map(fn(authority) {
                jet_services_local_delivery_ids(tree, endpoint, &jet_services_delivery_store(&authority.store))
            }).unwrap_or_default()
        } else { [] }
        pending :: jet_services_authority_take_pending(endpoint, available, &local_delivery_ids)?
        if !pending.is_empty() {
            worker :: jet_services_find_worker_mut(tree, endpoint)?
            remaining := pending.clone()
            loop (id, message, store) in ^pending {
                before :: worker.mailbox.channel.snapshot()
                if Err(error) :: worker.mailbox.channel.try_send(message.clone()) {
                    delivery_error :: match error {
                        JetServiceChannelError.Full(_) -> JetServiceError.Policy("service authority delivery exceeded mailbox capacity")
                        JetServiceChannelError.Closed -> JetServiceError.NotStarted("service authority worker mailbox is closed")
                        JetServiceChannelError.Empty -> JetServiceError.Policy("service channel returned an invalid send result")
                    }
                    rollback :: jet_services_authority_requeue_pending(endpoint, remaining.clone())
                    if Err(rollback_error) :: rollback {
                        mailbox :: jet_services_restore_mailbox(worker, ^before, draining)
                        return Err(match mailbox {
                            Ok(()) -> JetServiceError.Policy("{delivery_error.jet_show()}; authority rollback failed: {rollback_error.jet_show()}; unmarked receipts remain recoverable from the authority log")
                            Err(mailbox_error) -> JetServiceError.Policy("{delivery_error.jet_show()}; authority rollback failed: {rollback_error.jet_show()}; mailbox rollback failed: {mailbox_error.jet_show()}")
                        })
                    }
                    jet_services_restore_mailbox(worker, ^before, draining).map_err(fn(rollback_error) {
                        JetServiceError.Policy("{delivery_error.jet_show()}; mailbox rollback failed: {rollback_error.jet_show()}")
                    })?
                    return Err(^delivery_error)
                }
                if Err(error) :: jet_services_authority_mark_delivered(&store, &id) {
                    // Marker failure restores pre-send queue; authority suffix stays recoverable.
                    rollback :: jet_services_authority_requeue_pending(endpoint, remaining.clone())
                    if Err(rollback_error) :: rollback {
                        mailbox :: jet_services_restore_mailbox(worker, ^before, draining)
                        return Err(match mailbox {
                            Ok(()) -> JetServiceError.Policy("{error.jet_show()}; authority rollback failed: {rollback_error.jet_show()}; unmarked receipts remain recoverable from the authority log")
                            Err(mailbox_error) -> JetServiceError.Policy("{error.jet_show()}; authority rollback failed: {rollback_error.jet_show()}; mailbox rollback failed: {mailbox_error.jet_show()}")
                        })
                    }
                    jet_services_restore_mailbox(worker, ^before, draining).map_err(fn(rollback_error) {
                        JetServiceError.Policy("{error.jet_show()}; mailbox rollback failed: {rollback_error.jet_show()}")
                    })?
                    return Err(^error)
                }
                _ :: remaining.remove(0)
            }
