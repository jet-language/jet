}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:5924
fn jet_services_directory_register(tree: &JetServiceTree,name: String,endpoint: JetServiceEndpoint) -> () JetServiceError! {
    if !tree.started { return Err(JetServiceError.NotStarted("service tree is not started")) }
    _rollout_lock :: jet_services_rollout_operation_lock(tree)?
    if name.trim().is_empty() || name.chars().any(fn(c) { c.is_control() }) || name.len() > MAX_SERVICE_NAME { return Err(JetServiceError.Policy("directory name must be non-empty and visible")) }
    if endpoint.generation != tree.generation { return Err(JetServiceError.Policy("endpoint generation {endpoint.generation} does not match tree generation {tree.generation}")) }
    jet_services_validate_endpoint(tree,&endpoint)?
    worker :: tree.workers.iter().find(fn(worker) { worker.endpoint == endpoint }).ok_or_else(fn() { JetServiceError.Unknown("endpoint {endpoint.tree}/{endpoint.worker} is not a worker in this generation") })?
    if !worker.running { return Err(JetServiceError.NotStarted("worker `{worker.name}` is not running")) }
    if tree.directory.len() >= MAX_SERVICE_WORKERS && !tree.directory.iter().any(fn((entry,_,_)) { entry == &name }) { return Err(JetServiceError.Policy("service directory entry limit exceeded")) }
    signature :: jet_services_directory_signature(tree,&name,&endpoint)?
    previous :: tree.directory.iter().find(fn((entry,_,_)) { entry == &name }).cloned()
    tree.directory.retain(fn((n,_,_)) { n != &name })
    tree.directory.push((name.clone(),^endpoint,^signature))
    if Err(error) :: jet_services_rollout_store_write(tree) {
        tree.directory.retain(fn((entry,_,_)) { entry != &name })
        if Some(previous) :: previous { tree.directory.push(^previous) }
        return Err(^error)
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:5991
fn jet_services_directory_resolve(tree: &JetServiceTree,name: &String) -> JetServiceEndpoint JetServiceError! {
    (entry,endpoint,signature) :: tree.directory.iter().find(fn((entry,_,_)) { entry == name }).ok_or_else(fn() { JetServiceError.Unknown("directory has no entry `{name}`") })?
    if !jet_services_endpoint_generation_allowed(tree,endpoint) { return Err(JetServiceError.Stale("directory entry `{name}` is from generation {endpoint.generation}")) }
    service_authority_validate_directory(&tree.authority,&tree.name,entry,endpoint,signature)?
    match jet_services_authority_validate(endpoint) {
        Ok(()) -> {},
        Err(JetServiceError.NotStarted(message)) -> { return Err(JetServiceError.Expired(^message)) },
        Err(error) -> { return Err(^error) }
    }
    if !tree.workers.iter().any(fn(worker) { worker.running && worker.name == endpoint.worker && worker.endpoint.tree == endpoint.tree && worker.endpoint.authority == endpoint.authority && worker.endpoint.generation == endpoint.generation }) {
        return Err(JetServiceError.Expired("directory entry `{name}` no longer names a running worker"))
    }
    if tree.draining.iter().any(fn(worker) { worker == &endpoint.worker }) { return Err(JetServiceError.Unavailable("directory entry `{name}` is draining")) }
    Ok(endpoint.clone())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6047
fn jet_services_directory_signature(tree: &JetServiceTree,name: &String,endpoint: &JetServiceEndpoint) -> String JetServiceError! {
    service_authority_sign_directory(&tree.authority,&tree.name,name,endpoint)
}
