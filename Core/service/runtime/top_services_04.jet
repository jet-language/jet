fn jet_services_directory_generation(tree: &JetServiceTree) -> I64 { tree.generation }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6059
fn jet_services_drain_worker(tree: &JetServiceTree,endpoint: &JetServiceEndpoint) -> () JetServiceError! {
    if !tree.started { return Err(JetServiceError.NotStarted("service tree is not started")) }
    _rollout_lock :: jet_services_rollout_operation_lock(tree)?
    name :: { worker :: jet_services_find_worker_mut(tree,endpoint)?; worker.name.clone() }
    if tree.draining.iter().any(fn(n) { n == &name }) { return jet_services_authority_update_draining(endpoint,true) }
    // Set gate before inspecting queue; sends cannot enter after empty observation.
    jet_services_authority_update_draining(endpoint,true)?
    (empty,worker_endpoint,task) :: {
        worker :: jet_services_find_worker_mut(tree,endpoint)?
        (worker.mailbox.channel.depth() == 0,worker.endpoint.clone(),worker.task.clone())
    }
    if empty {
        if Some(worker) :: tree.workers.iter_mut().find(fn(worker) { worker.name == name }) { worker.running = false }
        if Err(error) :: jet_services_discharge_task(task.clone()) {
            recovery :: jet_services_task_start(&task).and_then(fn(()) { jet_services_authority_update(&worker_endpoint,true) })
                .and_then(fn(()) { jet_services_authority_update_draining(&worker_endpoint,false) })
            if Some(worker) :: tree.workers.iter_mut().find(fn(worker) { worker.name == name }) { worker.running = recovery.is_ok() }
            return Err(match recovery { Ok(()) -> ^error, Err(recovery_error) -> JetServiceError.Policy("{error.jet_show()}; drain authority recovery failed: {recovery_error.jet_show()}") })
        }
    }
    tree.draining.push(name.clone())
    if Err(error) :: jet_services_rollout_store_write(tree) {
        tree.draining.retain(fn(draining) { draining != &name })
        recovery :: if empty {
            jet_services_task_start(&task).and_then(fn(()) { jet_services_authority_update(&worker_endpoint,true) })
                .and_then(fn(()) { jet_services_authority_update_draining(&worker_endpoint,false) })
        } else { jet_services_authority_update_draining(&worker_endpoint,false) }
        if Some(worker) :: tree.workers.iter_mut().find(fn(worker) { worker.name == name }) { worker.running = if empty { recovery.is_ok() } else { worker.running } }
        return Err(match recovery { Ok(()) -> ^error, Err(recovery_error) -> JetServiceError.Policy("{error.jet_show()}; drain journal recovery failed: {recovery_error.jet_show()}") })
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6135
fn jet_services_partition_worker(tree: &JetServiceTree,endpoint: &JetServiceEndpoint) -> () JetServiceError! {
    if !tree.started { return Err(JetServiceError.NotStarted("service tree is not started")) }
    _rollout_lock :: jet_services_rollout_operation_lock(tree)?
    (name,was_running,task,worker_endpoint) :: {
        worker := jet_services_find_worker_mut(tree,endpoint)?
        was_running :: worker.running
        worker.running = false
        (worker.name.clone(),was_running,worker.task.clone(),worker.endpoint.clone())
    }
    added_partition :: if !tree.partitioned.iter().any(fn(existing) { existing == &name }) {
        if tree.partitioned.len() >= MAX_SERVICE_WORKERS {
            if Some(worker) :: tree.workers.iter_mut().find(fn(worker) { worker.name == endpoint.worker }) { worker.running = was_running }
            return Err(JetServiceError.Policy("service partition limit exceeded"))
        }
        tree.partitioned.push(name.clone())
        true
    } else { false }
    if Err(error) :: jet_services_authority_update_partitioned(&worker_endpoint,true) {
        if added_partition { tree.partitioned.retain(fn(existing) { existing != &name }) }
        if Some(worker) :: tree.workers.iter_mut().find(fn(worker) { worker.name == endpoint.worker }) { worker.running = was_running }
        return Err(^error)
    }
    if was_running {
        if Err(error) :: jet_services_discharge_task(task.clone()) {
            recovery :: jet_services_authority_update_partitioned(&worker_endpoint,false).and_then(fn(()) { jet_services_authority_update(&worker_endpoint,true) })
            tree.partitioned.retain(fn(existing) { existing != &name })
            if Some(worker) :: tree.workers.iter_mut().find(fn(worker) { worker.name == name }) { worker.running = recovery.is_ok() }
            return Err(match recovery { Ok(()) -> ^error, Err(recovery_error) -> JetServiceError.Policy("{error.jet_show()}; partition authority recovery failed: {recovery_error.jet_show()}") })
        }
    }
    if Err(error) :: jet_services_rollout_store_write(tree) {
        tree.partitioned.retain(fn(existing) { existing != &name })
        recovery :: jet_services_authority_update_partitioned(&worker_endpoint,false).and_then(fn(()) {
            if was_running { jet_services_task_start(&task).and_then(fn(()) { jet_services_authority_update(&worker_endpoint,true) }) } else { Ok(()) }
        })
        if Some(worker) :: tree.workers.iter_mut().find(fn(worker) { worker.name == name }) { worker.running = if was_running { recovery.is_ok() } else { false } }
        return Err(match recovery { Ok(()) -> ^error, Err(recovery_error) -> JetServiceError.Policy("{error.jet_show()}; partition journal recovery failed: {recovery_error.jet_show()}") })
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6241
fn jet_services_reconcile_worker(tree: &JetServiceTree,endpoint: &JetServiceEndpoint) -> () JetServiceError! {
    if !tree.started { return Err(JetServiceError.NotStarted("service tree is not started")) }
    _rollout_lock :: jet_services_rollout_operation_lock(tree)?
    jet_services_validate_endpoint(tree,endpoint).or_else(fn(error) {
        match error { JetServiceError.Partitioned(_) -> Ok(()), other -> Err(^other) }
    })?
    index :: tree.partitioned.iter().position(fn(name) { name == &endpoint.worker })
        .ok_or_else(fn() { JetServiceError.Unknown("worker `{endpoint.worker}` is not partitioned") })?
    (old_generation,worker_endpoint,task) :: {
        worker :: tree.workers.iter_mut().find(fn(worker) {
            worker.name == endpoint.worker && worker.endpoint.tree == endpoint.tree
                && worker.endpoint.authority == endpoint.authority && worker.endpoint.generation == endpoint.generation
        }).ok_or_else(fn() { JetServiceError.Unknown("reconciled worker disappeared") })?
        (worker.endpoint.generation,worker.endpoint.clone(),worker.task.clone())
    }
    // Discharge the old handle even when partitioning was persisted before join.
    jet_services_discharge_task(task.clone())?
    if Some(worker) :: tree.workers.iter_mut().find(fn(worker) { worker.name == endpoint.worker }) { worker.running = true }
    partitioned_name :: tree.partitioned.remove(index)
    result :: if old_generation != tree.generation {
        match jet_services_promote_worker_generation(tree,&endpoint.worker) {
            Ok(true) -> Ok(()),
            Ok(false) -> Err(JetServiceError.Unavailable("partitioned worker has uncommitted durable delivery")),
            Err(error) -> Err(^error)
        }
    } else {
        jet_services_authority_update_partitioned(&worker_endpoint,false)
            .and_then(fn(()) { jet_services_authority_update(&worker_endpoint,true) })
            .and_then(fn(()) { jet_services_task_start(&task) })
    }
    if Err(error) :: result {
        _ :: jet_services_authority_update_partitioned(&worker_endpoint,true)
        tree.partitioned.insert(index,^partitioned_name)
        if Some(worker) :: tree.workers.iter_mut().find(fn(worker) { worker.name == endpoint.worker }) { worker.running = false }
        return Err(^error)
    }
    jet_services_rollout_store_write(tree)?
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6323
fn jet_services_prepare_rollback(tree: &JetServiceTree) -> (String,Bool,String) JetServiceError! {
    if tree.state_authority.is_none() { return Ok(("",false,"none")) }
    authority :: tree.state_authority.as_ref().unwrap()
    if authority.migration == "forward_only" { return Ok(("",false,authority.migration.clone())) }
    rollback_store :: jet_services_rollback_store_path(authority,tree.generation)?
    records :: jet_services_state_store_load(authority,&tree.state_adapter)?
    rollback_authority := authority.clone()
    rollback_authority.store = rollback_store.clone()
    jet_services_state_store_write(&rollback_authority,&tree.state_adapter,&records)?
    Ok((^rollback_store,true,authority.migration.clone()))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6342
fn jet_services_discard_rollback_store(path: &String) -> () JetServiceError! {
    if path.is_empty() { return Ok(()) }
    // GATE #4565: kernel primitive
    #Unsafe("remove the failed rollout's rollback file; only NotFound is idempotent success") {
        match remove_file(path) {
            Ok(()) -> Ok(()),
            Err(error) if error.kind() == ErrorKind.NotFound -> Ok(()),
            Err(error) -> Err(jet_services_state_error("cannot retire failed service rollback store: {error}"))
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6355
fn jet_services_rollout_failure(primary: JetServiceError,authority: () JetServiceError!,tasks: () JetServiceError!,rollback_store: () JetServiceError!) -> JetServiceError {
    recovery_errors := []
    if Err(error) :: authority { recovery_errors.push("authority rollback failed: {error.jet_show()}") }
    if Err(error) :: tasks { recovery_errors.push("handoff task recovery failed: {error.jet_show()}") }
    if Err(error) :: rollback_store { recovery_errors.push("rollback store cleanup failed: {error.jet_show()}") }
    if recovery_errors.is_empty() { ^primary }
    else { JetServiceError.Policy("{primary.jet_show()}; {recovery_errors.join(\"; \")}") }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6382
fn jet_services_restore_rollback(tree: &JetServiceTree,receipt: &JetServiceUpgradeReceipt) -> () JetServiceError! {
    if !receipt.rollback_available { return Ok(()) }
    authority :: tree.state_authority.as_ref().ok_or_else(fn() { JetServiceError.Policy("upgrade receipt requires a state authority") })?
    expected_store :: jet_services_rollback_store_path(authority,receipt.from_generation)?
    if receipt.rollback_store != expected_store { return Err(jet_services_state_error("rollout receipt names a rollback store outside its state authority")) }
    rollback_authority := authority.clone()
    rollback_authority.store = receipt.rollback_store.clone()
    _rollback_lock :: service_authority_file_lock(&receipt.rollback_store,"rollback")?
    // GATE #4565: kernel primitive
    #Unsafe("inspect the rollback store as a real regular file under its retained file lock") {
        if !OSPath.new(&receipt.rollback_store).is_file() { return Err(jet_services_state_error("service rollback store is missing or not a regular file")) }
    }
    records :: jet_services_state_store_load(&rollback_authority,&tree.state_adapter)?
    jet_services_state_store_write(authority,&tree.state_adapter,&records)?
    match tree.state_adapter {
        JetServiceStateAdapter.Snapshot -> tree.snapshot = records.first().cloned(),
        JetServiceStateAdapter.EventLog -> tree.event_log = ^records,
        JetServiceStateAdapter.Empty -> {}
    }
    // GATE #4565: kernel primitive
    #Unsafe("retire the consumed rollback store, propagating native IO failure") {
        remove_file(&receipt.rollback_store).map_err(fn(error) { jet_services_state_error("cannot retire service rollback store: {error}") })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6422
fn jet_services_promote_worker_generation(tree: &JetServiceTree,worker_name: &String) -> Bool JetServiceError! {
    (old_endpoint,new_endpoint,running,task) :: {
        worker :: tree.workers.iter().find(fn(worker) { worker.name == worker_name }).ok_or_else(fn() { JetServiceError.Unknown("worker `{worker_name}` disappeared") })?
        new_endpoint := worker.endpoint.clone()
        new_endpoint.generation = tree.generation
        (worker.endpoint.clone(),^new_endpoint,!tree.partitioned.iter().any(fn(name) { name == worker_name }),worker.task.clone())
    }
    if jet_services_authority_has_uncommitted(&old_endpoint)? { return Ok(false) }
    // Promotion owns cancel/join even for endpoint-driven drain completion.
    jet_services_discharge_task(task.clone())?
    old_draining :: tree.draining.iter().any(fn(name) { name == worker_name })
    service_authority_rotate(&old_endpoint,&new_endpoint,running,false)?
    if running {
        if Err(error) :: jet_services_bind_delivery_endpoint(&tree.delivery,tree.state_authority.as_ref(),&new_endpoint) {
            recovery :: service_authority_rotate(&new_endpoint,&old_endpoint,running,old_draining)
            return Err(match recovery { Ok(()) -> ^error, Err(recovery_error) -> JetServiceError.Policy("{error.jet_show()}; service authority recovery failed: {recovery_error.jet_show()}") })
        }
    }
    if running {
        if Err(error) :: jet_services_task_start(&task) {
            recovery :: service_authority_rotate(&new_endpoint,&old_endpoint,running,old_draining)
            return Err(match recovery { Ok(()) -> ^error, Err(recovery_error) -> JetServiceError.Policy("{error.jet_show()}; service authority recovery failed: {recovery_error.jet_show()}") })
        }
    }
    promoted_endpoint :: {
        worker :: tree.workers.iter_mut().find(fn(worker) { worker.name == worker_name }).ok_or_else(fn() { JetServiceError.Unknown("worker `{worker_name}` disappeared") })?
        worker.endpoint = new_endpoint.clone()
        worker.mailbox.endpoint = ^new_endpoint
        worker.running = running
        worker.endpoint.clone()
    }
    tree_name :: tree.name.clone()
    authority :: tree.authority.clone()
    for (name,endpoint,signature) in &tree.directory {
        if endpoint.worker == worker_name {
            *endpoint = promoted_endpoint.clone()
            *signature = service_authority_sign_directory(&authority,&tree_name,name,endpoint)?
        }
    }
    for (_,endpoint,_) in &tree.idempotency_seen { if endpoint.worker == worker_name { endpoint.generation = tree.generation } }
    if Some(receipt) :: tree.last_upgrade.as_mut() { receipt.pinned_shards.retain(fn(name) { name != worker_name }) }
    tree.draining.retain(fn(name) { name != worker_name })
    jet_services_rollout_store_write(tree)?
    Ok(true)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6522
fn jet_services_restore_handoff_authority(tree: &JetServiceTree,old_endpoints: &[JetServiceEndpoint],next_endpoints: &[JetServiceEndpoint],running: &[Bool],pinned_shards: &[String]) -> () JetServiceError! {
    first_error := None
    for (index,old_endpoint) in old_endpoints.iter().enumerate() {
        if pinned_shards.iter().any(fn(name) { name == &old_endpoint.worker }) { continue }
        _ :: jet_services_authority_update(&next_endpoints[index],false)
        if Err(error) :: service_authority_register(old_endpoint,running[index]) { first_error.get_or_insert(^error); continue }
        if Err(error) :: jet_services_authority_update_draining(old_endpoint,tree.draining.iter().any(fn(name) { name == &old_endpoint.worker })) {
            first_error.get_or_insert(^error)
            continue
        }
        if running[index] {
            if Err(error) :: jet_services_bind_delivery_endpoint(&tree.delivery,tree.state_authority.as_ref(),old_endpoint) { first_error.get_or_insert(^error) }
        }
    }
    match first_error { Some(error) -> Err(^error), None -> Ok(()) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6562
fn jet_services_handoff_generation(tree: &JetServiceTree) -> I64 JetServiceError! {
    if !tree.started { return Err(JetServiceError.NotStarted("service tree is not started")) }
    _rollout_lock :: jet_services_rollout_operation_lock(tree)?
    jet_services_rollout_store_assert_current(tree)?
    pinned_before_handoff :: tree.last_upgrade.as_ref().map(fn(receipt) { receipt.pinned_shards.clone() }).unwrap_or_else(fn() { tree.draining.clone() })
    for worker_name in pinned_before_handoff {
        can_promote :: tree.workers.iter().find(fn(worker) { worker.name == worker_name }).is_some_and(fn(worker) {
            !tree.partitioned.iter().any(fn(name) { name == &worker.name }) && worker.mailbox.channel.depth() == 0
                && jet_services_generation_is_pinned(tree,&worker.name,worker.endpoint.generation)
        })
        if can_promote { _ :: jet_services_promote_worker_generation(tree,&worker_name)? }
    }
    if tree.last_upgrade.as_ref().is_some_and(fn(receipt) { !receipt.pinned_shards.is_empty() }) {
        return Err(JetServiceError.Policy("cannot start another handoff while pinned shards are draining"))
    }
    from_generation :: tree.generation
    to_generation :: tree.generation.checked_add(1).ok_or_else(fn() { JetServiceError.Policy("service generation exhausted") })?
    pinned_shards := []
    for worker in &tree.workers {
        has_uncommitted :: jet_services_authority_has_uncommitted(&worker.endpoint)?
        if tree.partitioned.iter().any(fn(name) { name == &worker.name })
            || (tree.draining.iter().any(fn(name) { name == &worker.name }) && worker.mailbox.channel.depth() > 0) || has_uncommitted {
            pinned_shards.push(worker.name.clone())
        }
    }
    (rollback_store,rollback_available,migration) :: jet_services_prepare_rollback(tree)?
    old_endpoints :: tree.workers.iter().map(fn(worker) { worker.endpoint.clone() }).collect()
    running :: tree.workers.iter().map(fn(worker) { worker.running }).collect()
    next_running := running.clone()
    for (index,worker) in tree.workers.iter().enumerate() {
        if !pinned_shards.iter().any(fn(name) { name == &worker.name }) && tree.draining.iter().any(fn(name) { name == &worker.name }) { next_running[index] = true }
    }
    next_endpoints := old_endpoints.clone()
    for (index,endpoint) in next_endpoints.iter_mut().enumerate() {
        if !pinned_shards.iter().any(fn(name) { name == &tree.workers[index].name }) { endpoint.generation = to_generation }
    }
    tree_name :: tree.name.clone()
    authority :: tree.authority.clone()
    next_directory := tree.directory.clone()
    for (name,endpoint,signature) in &next_directory {
        if pinned_shards.iter().any(fn(pinned) { pinned == &endpoint.worker }) { continue }
        endpoint.generation = to_generation
        *signature = service_authority_sign_directory(&authority,&tree_name,name,endpoint)?
    }
    next_idempotency := tree.idempotency_seen.clone()
    for (_,endpoint,_) in &next_idempotency {
        if !pinned_shards.iter().any(fn(name) { name == &endpoint.worker }) { endpoint.generation = to_generation }
    }
    suspended_tasks :: match jet_services_discharge_workers(tree,&pinned_shards) {
        Ok(tasks) -> ^tasks,
        Err(error) -> {
            cleanup :: jet_services_discard_rollback_store(&rollback_store)
            return Err(jet_services_rollout_failure(^error,Ok(()),Ok(()),^cleanup))
        }
    }
    for (index,worker) in tree.workers.iter().enumerate() {
        if pinned_shards.iter().any(fn(name) { name == &worker.name }) { continue }
        old_endpoint :: &old_endpoints[index]
        endpoint :: &next_endpoints[index]
        result :: service_authority_rotate(old_endpoint,endpoint,next_running[index],false).and_then(fn(()) {
            if next_running[index] { jet_services_bind_delivery_endpoint(&tree.delivery,tree.state_authority.as_ref(),endpoint) } else { Ok(()) }
        })
        if Err(error) :: result {
            rollback :: jet_services_restore_handoff_authority(tree,&old_endpoints,&next_endpoints,&running,&pinned_shards)
            tasks :: jet_services_restart_tasks(&suspended_tasks)
            cleanup :: jet_services_discard_rollback_store(&rollback_store)
            return Err(jet_services_rollout_failure(^error,^rollback,^tasks,^cleanup))
        }
    }
    started_tasks: [Arc<Mutex<JetServiceSupervisorState>>] = []
    for (index,worker) in tree.workers.iter().enumerate() {
        if pinned_shards.iter().any(fn(name) { name == &worker.name }) || !next_running[index] { continue }
        if Err(error) :: jet_services_task_start(&worker.task) {
            task_recovery := Ok(())
            for task in &started_tasks {
                if Err(recovery_error) :: jet_services_discharge_task(task.clone()) { task_recovery = Err(^recovery_error); break }
            }
            rollback :: jet_services_restore_handoff_authority(tree,&old_endpoints,&next_endpoints,&running,&pinned_shards)
            tasks :: jet_services_restart_tasks(&suspended_tasks).and(^task_recovery)
            cleanup :: jet_services_discard_rollback_store(&rollback_store)
            return Err(jet_services_rollout_failure(^error,^rollback,^tasks,^cleanup))
        }
        started_tasks.push(worker.task.clone())
    }
    tree.previous_generation = from_generation
    tree.generation = to_generation
    for (index,worker) in tree.workers.iter_mut().enumerate() {
        if pinned_shards.iter().any(fn(name) { name == &worker.name }) {
            if tree.partitioned.iter().any(fn(name) { name == &worker.name }) { worker.running = false }
            continue
        }
        worker.running = next_running[index]
        worker.endpoint = next_endpoints[index].clone()
        worker.mailbox.endpoint = next_endpoints[index].clone()
    }
    tree.directory = ^next_directory
    tree.idempotency_seen = ^next_idempotency
    tree.last_upgrade = Some(JetServiceUpgradeReceipt{from_generation,to_generation,migration,rollback_store,rollback_available,pinned_shards: pinned_shards.clone()})
    tree.draining.retain(fn(name) { pinned_shards.iter().any(fn(pinned) { pinned == name }) })
    jet_services_rollout_store_write(tree)?
    Ok(tree.generation)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6758
fn jet_services_upgrade_receipt(tree: &JetServiceTree) -> JetServiceUpgradeReceipt JetServiceError! {
    tree.last_upgrade.clone().ok_or_else(fn() { JetServiceError.Policy("service tree has no completed generation handoff") })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6766
fn jet_services_restore_rollback_authority(tree: &JetServiceTree,current_endpoints: &[JetServiceEndpoint],rollback_endpoints: &[JetServiceEndpoint],running: &[Bool],draining: &[String]) -> () JetServiceError! {
    first_error := None
    for endpoint in rollback_endpoints { _ :: jet_services_authority_update(endpoint,false) }
    for (index,endpoint) in current_endpoints.iter().enumerate() {
        if Err(error) :: service_authority_register(endpoint,running[index]) { first_error.get_or_insert(^error); continue }
        if Err(error) :: jet_services_authority_update_draining(endpoint,draining.iter().any(fn(name) { name == &endpoint.worker })) {
            first_error.get_or_insert(^error)
            continue
        }
        if running[index] {
            if Err(error) :: jet_services_bind_delivery_endpoint(&tree.delivery,tree.state_authority.as_ref(),endpoint) { first_error.get_or_insert(^error) }
        }
    }
    match first_error { Some(error) -> Err(^error), None -> Ok(()) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6805
fn jet_services_rollback_generation(tree: &JetServiceTree) -> I64 JetServiceError! {
    if !tree.started { return Err(JetServiceError.NotStarted("service tree is not started")) }
    _rollout_lock :: jet_services_rollout_operation_lock(tree)?
    jet_services_rollout_store_assert_current(tree)?
    if tree.previous_generation <= 0 { return Err(JetServiceError.Policy("no previous generation to roll back to")) }
    receipt :: tree.last_upgrade.clone().ok_or_else(fn() { JetServiceError.Policy("service tree has no rollback receipt") })?
    if receipt.to_generation != tree.generation || receipt.from_generation != tree.previous_generation {
        return Err(JetServiceError.Stale("service rollback receipt does not match the active generation"))
    }
    if receipt.migration == "forward_only" {
        return Err(JetServiceError.Policy("forward-only state migration cannot roll back; publish a forward recovery generation"))
    }
    current_endpoints :: tree.workers.iter().map(fn(worker) { worker.endpoint.clone() }).collect()
    rollback_endpoints :: current_endpoints.iter().map(fn(endpoint) {
        rollback_endpoint := endpoint.clone()
        rollback_endpoint.generation = receipt.from_generation
        ^rollback_endpoint
    }).collect()
    running :: tree.workers.iter().map(fn(worker) { worker.running }).collect()
    suspended_tasks :: jet_services_discharge_workers(tree,&[])?
    rollback_draining :: tree.draining.clone()
    for (index,endpoint) in rollback_endpoints.iter().enumerate() {
        result :: if current_endpoints[index].generation == endpoint.generation {
            if running[index] { jet_services_bind_delivery_endpoint(&tree.delivery,tree.state_authority.as_ref(),endpoint) } else { Ok(()) }
        } else {
            service_authority_rotate(&current_endpoints[index],endpoint,running[index],rollback_draining.iter().any(fn(name) { name == &endpoint.worker }))
                .and_then(fn(()) {
                    if running[index] { jet_services_bind_delivery_endpoint(&tree.delivery,tree.state_authority.as_ref(),endpoint) } else { Ok(()) }
                })
        }
        if Err(error) :: result {
            rollback :: jet_services_restore_rollback_authority(tree,&current_endpoints,&rollback_endpoints,&running,&tree.draining)
            tasks :: jet_services_restart_tasks(&suspended_tasks)
            return Err(jet_services_rollout_failure(^error,^rollback,^tasks,Ok(())))
        }
    }
    started_tasks: [Arc<Mutex<JetServiceSupervisorState>>] = []
    for (index,worker) in tree.workers.iter().enumerate() {
        if !running[index] { continue }
        if Err(error) :: jet_services_task_start(&worker.task) {
            task_recovery := Ok(())
            for task in &started_tasks {
                if Err(recovery_error) :: jet_services_discharge_task(task.clone()) { task_recovery = Err(^recovery_error); break }
            }
            rollback :: jet_services_restore_rollback_authority(tree,&current_endpoints,&rollback_endpoints,&running,&tree.draining)
            tasks :: jet_services_restart_tasks(&suspended_tasks).and(^task_recovery)
            return Err(jet_services_rollout_failure(^error,^rollback,^tasks,Ok(())))
        }
        started_tasks.push(worker.task.clone())
    }
    if Err(error) :: jet_services_restore_rollback(tree,&receipt) {
        rollback :: jet_services_restore_rollback_authority(tree,&current_endpoints,&rollback_endpoints,&running,&tree.draining)
        tasks :: jet_services_restart_tasks(&suspended_tasks)
        return Err(jet_services_rollout_failure(^error,^rollback,^tasks,Ok(())))
    }
    tree.generation = receipt.from_generation
    tree.previous_generation = 0
    for (index,worker) in tree.workers.iter_mut().enumerate() {
        worker.endpoint = rollback_endpoints[index].clone()
        worker.mailbox.endpoint = rollback_endpoints[index].clone()
    }
    tree_name :: tree.name.clone()
    authority :: tree.authority.clone()
    for (name,endpoint,signature) in &tree.directory {
        endpoint.generation = tree.generation
        *signature = service_authority_sign_directory(&authority,&tree_name,name,endpoint)?
    }
    for (_,endpoint,_) in &tree.idempotency_seen { endpoint.generation = tree.generation }
    tree.draining = ^rollback_draining
    tree.last_upgrade = None
    jet_services_rollout_store_write(tree)?
    Ok(tree.generation)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6954
fn jet_services_chaos_fail(tree: &JetServiceTree) -> I64 JetServiceError! {
    if !tree.started { return Err(JetServiceError.NotStarted("service tree is not started")) }
    tree.chaos_fails = tree.chaos_fails.checked_add(1).ok_or_else(fn() { JetServiceError.Policy("chaos failure counter exhausted") })?
    endpoint :: tree.workers.iter().find(fn(worker) { worker.running }).map(fn(worker) { worker.endpoint.clone() })
        .ok_or_else(fn() { JetServiceError.Partitioned("chaos failure has no reachable service worker") })?
    jet_services_fail_worker(tree,&endpoint)?
    Ok(tree.chaos_fails)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:6978
fn jet_services_workflow_observation(workflows: &[JetServiceWorkflow]) -> String {
    running := 0
    paused := 0
    cancel_requested := 0
    pending := 0
    finished := 0
    panicked := 0
    cancelled := 0
    deadline_blown := 0
    for workflow in workflows {
        match &workflow.status {
            JetTaskStatus.Running -> running += 1,
            JetTaskStatus.Paused -> paused += 1,
            JetTaskStatus.CancelRequested -> cancel_requested += 1
        }
        match workflow.outcome.as_ref() {
            None -> pending += 1,
            Some(JetTaskOutcome.Finished) -> finished += 1,
            Some(JetTaskOutcome.Panicked(_)) -> panicked += 1,
            Some(JetTaskOutcome.Cancelled) -> cancelled += 1,
            Some(JetTaskOutcome.DeadlineBlown) -> deadline_blown += 1
        }
    }
    "workflows={workflows.len()},statuses={{running:{running},paused:{paused},cancel_requested:{cancel_requested}}},outcomes={{pending:{pending},finished:{finished},panicked:{panicked},cancelled:{cancelled},deadline_blown:{deadline_blown}}}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:7007
fn jet_services_observe(tree: &JetServiceTree) -> String {
    rollback :: tree.last_upgrade.as_ref().is_some_and(fn(receipt) { receipt.rollback_available })
    "Observe(workers={tree.workers.len()}, started={tree.started}, generation={tree.generation}, dead_letters={tree.dead_letters.len()}, events={tree.event_log.len()}, chaos={tree.chaos_fails}, draining={tree.draining.len()}, partitions={tree.partitioned.len()}, rollback={rollback}, {jet_services_workflow_observation(&tree.workflows)})"
}

