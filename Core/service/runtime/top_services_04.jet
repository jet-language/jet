fn jet_services_workflow_history<R: JetWorkflowRunId>(tree: &JetServiceTree,run_id: R) -> String JetServiceError! {
    run_id :: run_id.jet_workflow_run_id()
    jet_services_workflow_replay(&jet_services_workflow_authority(tree)?)?.iter().find(fn(w) { w.run_id == run_id })
