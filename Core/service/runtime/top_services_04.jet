// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:5561
fn jet_services_workflow_all(handle: &JetWorkflowHandle,values: [String]) -> [String] JetServiceError! {
    if values.len() > MAX_SERVICE_WORKFLOW_STEPS || values.iter().any(fn(value) { value.len() > MAX_SERVICE_MESSAGE || value.chars().any(fn(c) { c.is_control() }) }) {
        return Err(JetServiceError.Policy("workflow all wait values are outside the bounded visible range"))
    }
    expected :: "all:{values.join(\",\")}"
    // GATE #4565: kernel primitive
    #Unsafe("inspect and advance shared workflow replay cursor under handle mutex") {
        workflow := handle.state.lock().map_err(fn(_) { JetServiceError.Policy("workflow handle state lock is poisoned") })?
        if workflow.replay_cursor != 0 {
            if jet_services_workflow_replay_event(&workflow,&expected)? { return Ok(^values) }
        } else { workflow.replay_cursor = workflow.history.len() }
    }
    payload := "workflow-wait-all:{jet_services_workflow_run_id(handle)}:{values.len()}:"
    for value in &values { payload.push_str(&jet_services_workflow_frame(value)) }
    jet_services_workflow_append_handle(handle,^payload)?
    Ok(^values)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:5599
fn jet_services_workflow_step<R: JetWorkflowRunId>(tree: &JetServiceTree,run_id: R,step: String) -> () JetServiceError! {
    run_id :: run_id.jet_workflow_run_id()
    if !tree.started { return Err(JetServiceError.NotStarted("service tree is not started")) }
    jet_services_workflow_sync_tree(tree)?
    jet_services_workflow_validate_step(&step)?
    index :: tree.workflows.iter().position(fn(w) { w.run_id == run_id }).ok_or_else(fn() { JetServiceError.Unknown("workflow run {run_id} not found") })?
    replaying :: tree.workflows[index].replay_cursor != 0
    if replaying {
        expected :: "step:{step}"
        if jet_services_workflow_replay_event(&tree.workflows[index],&expected)? { return Ok(()) }
    } else { tree.workflows[index].replay_cursor = tree.workflows[index].history.len() }
    if tree.workflows[index].outcome.is_some() { return Err(JetServiceError.Policy("workflow step follows a terminal workflow outcome")) }
    if tree.workflows[index].steps.len() >= MAX_SERVICE_WORKFLOW_STEPS { return Err(JetServiceError.Policy("workflow step history limit exceeded")) }
    jet_services_workflow_append(tree,"workflow-step:{run_id}:{jet_services_workflow_frame(&step)}")?
    if replaying { tree.workflows[index].replay_cursor += 1 } else { tree.workflows[index].replay_cursor = tree.workflows[index].history.len() }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:5651
fn jet_services_workflow_activity<R: JetWorkflowRunId>(tree: &JetServiceTree,run_id: R,activity: String,key: String,max_attempts: I64) -> JetTaskStatus JetServiceError! {
    run_id :: run_id.jet_workflow_run_id()
    if !tree.started { return Err(JetServiceError.NotStarted("service tree is not started")) }
    jet_services_workflow_sync_tree(tree)?
    jet_services_workflow_token(&activity,"activity",MAX_SERVICE_NAME)?
    jet_services_workflow_token(&key,"idempotency key",MAX_SERVICE_NAME)?
    if max_attempts < 1 || max_attempts > MAX_SERVICE_ACTIVITY_ATTEMPTS { return Err(JetServiceError.Policy("workflow activity retry limit is outside the bounded range")) }
    workflow_index :: tree.workflows.iter().position(fn(workflow) { workflow.run_id == run_id }).ok_or_else(fn() { JetServiceError.Unknown("workflow run {run_id} not found") })?
    replaying :: tree.workflows[workflow_index].replay_cursor != 0
    if Some((_,existing_activity,_,existing_max_attempts)) :: jet_services_workflow_activity_index(&tree.workflows[workflow_index],&key) {
        if existing_activity != activity || existing_max_attempts != max_attempts { return Err(JetServiceError.Policy("workflow activity `{key}` does not match its recorded definition")) }
        if replaying {
            expected :: "activity:{activity}:{key}@1/{max_attempts}"
            if jet_services_workflow_replay_event(&tree.workflows[workflow_index],&expected)? { return Ok(JetTaskStatus.Running) }
        }
        return Ok(tree.workflows[workflow_index].status.clone())
    }
    if !replaying { tree.workflows[workflow_index].replay_cursor = tree.workflows[workflow_index].history.len() }
    else {
        expected :: "activity:{activity}:{key}@1/{max_attempts}"
        if Some(actual) :: tree.workflows[workflow_index].history.get(tree.workflows[workflow_index].replay_cursor) {
            if actual == &expected { return Err(JetServiceError.Policy("workflow replay activity is missing its durable state")) }
            return Err(JetServiceError.Policy("workflow replay diverged: expected `{actual}`, got `{expected}`"))
        }
    }
    if tree.workflows[workflow_index].outcome.is_some() { return Err(JetServiceError.Policy("workflow activity follows a terminal workflow outcome")) }
    jet_services_workflow_append(tree,"workflow-activity:{run_id}:1:{max_attempts}:{jet_services_workflow_frame(&activity)}{jet_services_workflow_frame(&key)}")?
    tree.workflows[workflow_index].replay_cursor = tree.workflows[workflow_index].history.len()
    Ok(JetTaskStatus.Running)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:5735
fn jet_services_workflow_activity_retry<R: JetWorkflowRunId>(tree: &JetServiceTree,run_id: R,key: String,outcome: JetTaskOutcome) -> JetTaskStatus JetServiceError! {
    run_id :: run_id.jet_workflow_run_id()
    if !tree.started { return Err(JetServiceError.NotStarted("service tree is not started")) }
    jet_services_workflow_sync_tree(tree)?
    jet_services_workflow_token(&key,"idempotency key",MAX_SERVICE_NAME)?
    workflow_index :: tree.workflows.iter().position(fn(workflow) { workflow.run_id == run_id }).ok_or_else(fn() { JetServiceError.Unknown("workflow run {run_id} not found") })?
    replaying :: tree.workflows[workflow_index].replay_cursor != 0
    (_,_,attempt,max_attempts) :: jet_services_workflow_activity_index(&tree.workflows[workflow_index],&key).ok_or_else(fn() { JetServiceError.Unknown("activity key `{key}` not found") })?
    if !outcome.is_retryable_failure() { return Err(JetServiceError.Policy("a finished activity cannot be retried")) }
    if !outcome.is_valid() { return Err(JetServiceError.Policy("workflow activity outcome is invalid")) }
    if replaying && jet_services_workflow_replay_retry(&tree.workflows[workflow_index],&key,max_attempts,&outcome)? { return Ok(JetTaskStatus.Paused) }
    if tree.workflows[workflow_index].outcome.is_some() || jet_services_workflow_activity_outcome(&tree.workflows[workflow_index],&key).is_some() {
        return Err(JetServiceError.Policy("workflow activity retry follows a terminal activity"))
    }
    if attempt >= max_attempts { return Err(JetServiceError.Policy("workflow activity retry limit exhausted")) }
    if !replaying { tree.workflows[workflow_index].replay_cursor = tree.workflows[workflow_index].history.len() }
    next_attempt :: attempt+1
    jet_services_workflow_append(tree,"workflow-activity-retry:{run_id}:{next_attempt}:{jet_services_workflow_frame(&key)}{jet_services_workflow_frame(&outcome.wire())}")?
    if replaying { tree.workflows[workflow_index].replay_cursor += 1 } else { tree.workflows[workflow_index].replay_cursor = tree.workflows[workflow_index].history.len() }
    Ok(JetTaskStatus.Paused)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Services.rs:5813
fn jet_services_workflow_activity_complete<R: JetWorkflowRunId>(tree: &JetServiceTree,run_id: R,key: String,outcome: JetTaskOutcome) -> JetTaskOutcome JetServiceError! {
    run_id :: run_id.jet_workflow_run_id()
    if !tree.started { return Err(JetServiceError.NotStarted("service tree is not started")) }
    jet_services_workflow_sync_tree(tree)?
    jet_services_workflow_token(&key,"idempotency key",MAX_SERVICE_NAME)?
    if !outcome.is_valid() { return Err(JetServiceError.Policy("workflow activity outcome is invalid")) }
    workflow_index :: tree.workflows.iter().position(fn(workflow) { workflow.run_id == run_id }).ok_or_else(fn() { JetServiceError.Unknown("workflow run {run_id} not found") })?
    if jet_services_workflow_activity_index(&tree.workflows[workflow_index],&key).is_none() { return Err(JetServiceError.Unknown("activity key `{key}` not found")) }
    replaying :: tree.workflows[workflow_index].replay_cursor != 0
    if replaying {
        done :: "activity-done:{key}"
        result :: "activity-result:{outcome.jet_show()}"
        cursor :: tree.workflows[workflow_index].replay_cursor
        match (tree.workflows[workflow_index].history.get(cursor),tree.workflows[workflow_index].history.get(cursor+1)) {
            (Some(actual_done),Some(actual_result)) -> {
                if actual_done == &done && actual_result == &result { tree.workflows[workflow_index].replay_cursor += 2; return Ok(^outcome) }
                return Err(JetServiceError.Policy("workflow replay diverged: expected completion for `{key}`, got `{actual_done}`"))
            },
            (Some(actual),_) -> { return Err(JetServiceError.Policy("workflow replay diverged: expected completion for `{key}`, got `{actual}`")) },
            (None,_) -> {}
        }
    }
    if Some(existing) :: jet_services_workflow_activity_outcome(&tree.workflows[workflow_index],&key) {
        if existing == &outcome { return Ok(^outcome) }
        return Err(JetServiceError.Policy("workflow activity completion conflicts with its recorded outcome"))
    }
    if !replaying { tree.workflows[workflow_index].replay_cursor = tree.workflows[workflow_index].history.len() }
    jet_services_workflow_append(tree,"workflow-activity-done:{run_id}:{jet_services_workflow_frame(&key)}{jet_services_workflow_frame(&outcome.wire())}")?
    if replaying { tree.workflows[workflow_index].replay_cursor += 2 } else { tree.workflows[workflow_index].replay_cursor = tree.workflows[workflow_index].history.len() }
    Ok(^outcome)
}
