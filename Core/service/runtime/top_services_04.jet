fn jet_services_workflow_outcome<R: JetWorkflowRunId>(tree: &JetServiceTree,run_id: R) -> JetTaskOutcome JetServiceError! {
    run_id :: run_id.jet_workflow_run_id()
    jet_services_workflow_replay(&jet_services_workflow_authority(tree)?)?.iter().find(fn(workflow) { workflow.run_id == run_id })
