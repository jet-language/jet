fn service_authority_validate_delivery_runtime(runtime: &JetServiceRuntime, delivery: &JetDelivery) -> Unit JetServiceError! {
    if service_authority_store_identity(&runtime.store) != delivery.store -> return Err(JetServiceError.Revoked("delivery handle belongs to another authority store"))
