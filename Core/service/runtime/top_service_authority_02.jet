#Unsafe("operation and registry mutexes guard reservation removal before the durable delivering marker")
pub fn jet_services_authority_mark_delivered(store: &String, id: &String) -> () JetServiceError! {
    service_authority_validate_text(id, "service id", SERVICE_AUTH_MAX_KEY, false)?
    runtime :: JetServiceRuntime{store:store.clone(), retention_ms:0}
    service_authority_validate_runtime(&runtime)?
    _operation_lock :: service_authority_operation_lock(&runtime, id)?
    _guard :: service_authority_lock().lock().map_err(fn(_) { service_authority_error("service authority lock is poisoned") })?
    entries :: service_authority_entries(&runtime, &service_authority_read(&runtime)?)?
    entry := entries.iter().find(fn(entry) { entry.id == id })
        .ok_or_else(fn() { JetServiceError.Unknown("service id `{id}` is unknown") })?
    if entry.dead {
        service_authority_remove_pending_entry(&runtime, entry)?
        return Err(JetServiceError.Unavailable("cannot deliver a dead-lettered service receipt"))
    }
    if entry.state == JetDeliveryState.Cancelled {
        service_authority_remove_pending_entry(&runtime, entry)?
        return Err(JetServiceError.Unavailable("cannot deliver a cancelled delivery"))
    }
    if !entry.delivered_to_worker {
        // Recovery source remains the log if the marker fails after reservation
        // removal, so the caller can restore the whole suffix without loss.
        service_authority_remove_pending_entry(&runtime, entry)?
        service_authority_append_event(&runtime, entry, JetDeliveryState.Delivering, entry.attempts, service_authority_now())?
    } else { service_authority_remove_pending_entry(&runtime, entry)? }
    Ok(())
}
