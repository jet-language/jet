// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3329
#Clone
#Debug
#Comparable
struct JetJobQueuePolicy {
    delivery: JetJobQueueDeliveryPolicy
    max_attempts: U32
    lease_ms: I64
    retry_delay_ms: I64
    max_retry_delay_ms: I64
    capacity: USize
    retention_ms: I64
    publish_payload: Bool
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3341
    fn default() -> Self {
        Self{delivery: JetJobQueueDeliveryPolicy.AtLeastOnce, max_attempts: 3, lease_ms: 30000, retry_delay_ms: 1000, max_retry_delay_ms: 60000, capacity: 1024, retention_ms: 7 * 24 * 60 * 60 * 1000, publish_payload: false}
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3356
    fn validate(self: &Self) -> Unit JetServiceError! {
        if self.delivery != JetJobQueueDeliveryPolicy.AtLeastOnce -> return Err(JetServiceError.Policy("queue delivery policy must be explicit at-least-once"))
        if self.max_attempts == 0 || self.max_attempts > JET_JOB_QUEUE_MAX_ATTEMPTS -> return Err(JetServiceError.Policy("queue max attempts must be between 1 and {JET_JOB_QUEUE_MAX_ATTEMPTS}"))
        if self.lease_ms <= 0 || self.lease_ms > JET_JOB_QUEUE_MAX_LEASE_MS -> return Err(JetServiceError.Policy("queue lease must be positive and bounded"))
        if self.retry_delay_ms < 0 || self.max_retry_delay_ms < self.retry_delay_ms || self.max_retry_delay_ms > JET_JOB_QUEUE_MAX_DELAY_MS -> return Err(JetServiceError.Policy("queue retry delays are outside the supported range"))
        if self.capacity == 0 || self.capacity > JET_JOB_QUEUE_MAX_INSPECT -> return Err(JetServiceError.Policy("queue capacity must be positive and bounded"))
        if self.retention_ms < 0 || self.retention_ms > JET_JOB_QUEUE_MAX_DELAY_MS -> return Err(JetServiceError.Policy("queue retention is outside the supported range"))
        Ok(())
    }
}
