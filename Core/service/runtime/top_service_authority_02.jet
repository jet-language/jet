// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3535
#Clone
#Debug
struct JetJobQueueDevtoolsTransition {
    event: String
    authority: String
    queue: String
    job_type: String
    job_id: String
    sequence: I64
    state: JetJobQueueState
    attempts: U32
    timestamp_ms: I64
    reason: String?
    duration_ms: I64?
    worker: String?
    request_id: String?
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3552
    fn from_record(record: &JetJobQueueStoredRecord, state: JetJobQueueState, attempts: U32, timestamp_ms: I64, reason: String?, duration_ms: I64?, worker: String?) -> Self {
        event :: match state { .Queued -> "enqueue", .Running -> "start", .Retrying -> "retry", .Completed -> "complete", .Failed | .DeadLettered | .Cancelled -> "fail" }
        Self{event: event, authority: record.authority.clone(), queue: record.queue.clone(), job_type: record.job_type.clone(), job_id: record.id.clone(), sequence: record.event_sequence.saturating_add(1), state: state, attempts: attempts, timestamp_ms: timestamp_ms, reason: reason.map(fn(reason) { reason.to_string() }), duration_ms: duration_ms, worker: worker.map(fn(worker) { worker.to_string() }), request_id: record.request_id.clone()}
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:3587
    fn with_event(self: Self, event: String) -> Self {
        self := ^self
        self.event = event
        ^self
    }
}

