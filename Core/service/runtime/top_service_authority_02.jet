fn service_authority_entries(runtime: &JetServiceRuntime, records: &[(Char, [String])]) -> [ServiceAuthorityEntry] JetServiceError! {
    entries := [ServiceAuthorityEntry]{}
    loop (op, fields) in records {
        match (*op, fields.as_slice()) {
            ('S', [id, key, authority, tree, worker, generation, message, created, expires, signature]) -> {
                generation :: generation.parse<I64>().map_err(fn(_) { service_authority_error("service send generation is malformed") })?
                created :: created.parse<I64>().map_err(fn(_) { service_authority_error("service send timestamp is malformed") })?
                expires :: expires.parse<I64>().map_err(fn(_) { service_authority_error("service send expiry is malformed") })?
                endpoint :: service_authority_endpoint_unchecked(tree.clone(), worker.clone(), generation, authority.clone())?
                service_authority_validate_text(key, "service idempotency key", SERVICE_AUTH_MAX_KEY, false)?
                service_authority_validate_text(message, "service message", SERVICE_AUTH_MAX_MESSAGE, true)?
                expected_id :: service_authority_id(runtime, &endpoint, message, key)
                if id != &expected_id -> return Err(service_authority_error("service receipt identity does not match its authority fields"))
                expected_signature :: service_delivery_acceptance_signature(authority, generation, id, key, tree, worker, message, created, expires)?
                supplied_signature :: service_authority_unhex(signature).ok_or_else(fn() { service_authority_error("service acceptance signature is malformed") })?
                expected_bytes :: service_authority_unhex(&expected_signature).ok_or_else(fn() { service_authority_error("service acceptance signature is malformed") })?
                if !constant_time_equal_bytes(&expected_bytes, &supplied_signature) -> return Err(service_authority_error("service acceptance signature does not validate"))
                entry :: ServiceAuthorityEntry{id: id.clone(), key: key.clone(), tree: tree.clone(), worker: worker.clone(), authority: authority.clone(), generation: generation, message: message.clone(), created: created, expires: expires, retained_until: None, attempts: 0, state: JetDeliveryState.Accepted, event_sequence: 1, delivered_to_worker: false, delivered: false, dead: false}
                if entries.iter().any(fn(previous) { previous.id.as_str() == id.as_str() }) -> return Err(service_authority_error("service authority log contains duplicate acceptance"))
                if entries.iter().any(fn(previous) { previous.key.as_str() == key.as_str() }) -> return Err(service_authority_error("service authority log contains duplicate idempotency work"))
                &entries.push(^entry)
            }
            ('K', [id, until, signature]) -> {
                until :: until.parse<I64>().map_err(fn(_) { service_authority_error("service retention deadline is malformed") })?
                entry := &entries.iter_mut().find(fn(entry) { entry.id.as_str() == id.as_str() }).ok_or_else(fn() { service_authority_error("service retention references an unknown id") })?
                expected :: service_delivery_retention_signature(entry, until)?
                expected :: service_authority_unhex(&expected).ok_or_else(fn() { service_authority_error("service retention signature is malformed") })?
                supplied :: service_authority_unhex(signature).ok_or_else(fn() { service_authority_error("service retention signature is malformed") })?
                if !constant_time_equal_bytes(&expected, &supplied) -> return Err(service_authority_error("service retention signature does not validate"))
                entry.retained_until = Val(until)
            }
            ('E', [id, sequence, state, attempts, timestamp, signature]) -> {
                sequence :: sequence.parse<I64>().map_err(fn(_) { service_authority_error("delivery event sequence is malformed") })?
                attempts :: attempts.parse<I64>().map_err(fn(_) { service_authority_error("delivery event attempts are malformed") })?
                timestamp :: timestamp.parse<I64>().map_err(fn(_) { service_authority_error("delivery event timestamp is malformed") })?
                state :: service_delivery_state_parse(state)?
                entry := &entries.iter_mut().find(fn(entry) { entry.id.as_str() == id.as_str() }).ok_or_else(fn() { service_authority_error("delivery event references an unknown id") })?
                if sequence != entry.event_sequence.saturating_add(1) -> return Err(service_authority_error("delivery event sequence is not monotonic"))
                service_delivery_transition_allowed(entry, state, attempts)?
                expected :: service_delivery_event_signature(&entry.authority, entry.generation, id, sequence, state, attempts, timestamp)?
                expected :: service_authority_unhex(&expected).ok_or_else(fn() { service_authority_error("delivery event signature is malformed") })?
                supplied :: service_authority_unhex(signature).ok_or_else(fn() { service_authority_error("delivery event signature is malformed") })?
                if !constant_time_equal_bytes(&expected, &supplied) -> return Err(service_authority_error("delivery event signature does not validate"))
                entry.event_sequence = sequence
                entry.attempts = attempts
                entry.state = state
                entry.delivered_to_worker = state == JetDeliveryState.Delivering || state == JetDeliveryState.Delivered
                entry.delivered = state == JetDeliveryState.Delivered
                entry.dead = state == JetDeliveryState.DeadLettered
