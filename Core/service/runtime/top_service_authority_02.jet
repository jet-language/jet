// GATE #4565: kernel primitive
#Unsafe("hold per-delivery and registry native locks while loading, cleaning expired work, and authenticating handle identity")
fn service_authority_delivery_entry(delivery: &JetDelivery) -> (JetServiceRuntime, ServiceAuthorityEntry, [(Char, [String])]) JetServiceError! {
    service_authority_validate_text(&delivery.id, "delivery id", SERVICE_AUTH_MAX_KEY, false)?
    runtime :: JetServiceRuntime{store: delivery.store.clone(), retention_ms: 0}
    service_authority_validate_runtime(&runtime)?
    _operation_lock :: service_authority_operation_lock(&runtime, &delivery.id)?
    _guard :: service_authority_lock().lock().map_err(fn(_) { service_authority_error("service authority lock is poisoned") })?
    records := service_authority_read(&runtime)?
    entries := service_authority_entries(&runtime, &records)?
    if service_authority_cleanup_expired(&runtime, &entries, service_authority_now())? {
        records = service_authority_read(&runtime)?
        entries = service_authority_entries(&runtime, &records)?
    }
    entry :: entries.into_iter().find(fn(entry) { entry.id == delivery.id }).ok_or_else(fn() { JetServiceError.Unknown("delivery `{delivery.id}` is unknown") })?
    if delivery.authority != entry.authority -> return Err(JetServiceError.Revoked("delivery handle authority does not match its receipt"))
    if delivery.generation != entry.generation -> return Err(JetServiceError.Stale("delivery handle generation does not match its receipt"))
    Ok((^runtime, ^entry, ^records))
}
