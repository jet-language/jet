// GATE #4565: kernel primitive
#Unsafe("read endpoint registry under lock, then inspect durable receipts without retaining its guard")
pub fn jet_services_authority_has_uncommitted(endpoint: &JetServiceEndpoint) -> Bool JetServiceError! {
    service_authority_validate_endpoint(endpoint)?
    key :: service_endpoint_key(&endpoint.authority, &endpoint.worker, endpoint.generation)
    store :: {
        registry :: service_endpoint_registry().lock().map_err(fn(_) { service_authority_error("service endpoint registry lock is poisoned") })?
        state := registry.get(&key).ok_or_else(fn() { JetServiceError.Partitioned("service endpoint authority is not registered") })?
        if state.tree != endpoint.tree || state.worker != endpoint.worker {
            return Err(JetServiceError.Revoked("service endpoint authority does not match its tree"))
        }
        state.store.as_ref().and_then(fn((store, generation)) { (*generation == endpoint.generation).then(fn() { store.clone() }) })
    }
    store :: store ?? return Ok(false)
    runtime :: JetServiceRuntime{store:^store, retention_ms:0}
    entries :: service_authority_entries(&runtime, &service_authority_read(&runtime)?)?
    now :: service_authority_now()
    Ok(entries.iter().any(fn(entry) {
        entry.tree == endpoint.tree && entry.worker == endpoint.worker && entry.state != JetDeliveryState.Cancelled
            && service_authority_entry_routes_to_endpoint(&runtime, entry, endpoint)
            // Pin shard for every live durable receipt, including pending queue.
            // Explicit retry alone performs redelivery; this only retains route.
            && !entry.delivered && !entry.dead && entry.retained_until.is_none() && !service_authority_entry_expired(entry, now)
    }))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:1886
fn service_authority_enqueue_entry(runtime: &JetServiceRuntime, entry: &ServiceAuthorityEntry) -> () JetServiceError! {
    endpoint :: service_authority_current_endpoint(runtime, entry)?
    if endpoint.tree != entry.tree || endpoint.worker != entry.worker {
        return Err(JetServiceError.Revoked("service receipt endpoint no longer names its worker"))
    }
    jet_services_authority_enqueue(runtime, &endpoint, &entry.id, &entry.message)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:1899
fn service_authority_entry_routes_to_endpoint(runtime: &JetServiceRuntime, entry: &ServiceAuthorityEntry, endpoint: &JetServiceEndpoint) -> Bool {
    if entry.tree != endpoint.tree || entry.worker != endpoint.worker { return false }
    if entry.authority == endpoint.authority && entry.generation == endpoint.generation { return true }
    // Restart changes provider authority but not durable logical identity.
    // Authenticate the resolved route; never rewrite receipt or retry sideways.
    service_authority_current_endpoint(runtime, entry).is_ok_and(fn(current) {
        current.tree == endpoint.tree && current.worker == endpoint.worker && current.generation == endpoint.generation
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:1922
fn service_authority_hex(bytes: &[U8]) -> String {
    output := String.with_capacity(bytes.len() * 2)
    for byte in bytes { output.push_str("{byte:02x}") }
    ^output
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:1930
fn service_authority_unhex(value: &String) -> [U8]? {
    if value.len() % 2 != 0 { return None }
    bytes := [U8].with_capacity(value.len() / 2)
    for pair in value.as_bytes().chunks_exact(2) {
        high :: (pair[0] as Char).to_digit(16)? as U8
        low :: (pair[1] as Char).to_digit(16)? as U8
        bytes.push((high << 4) | low)
    }
    Val(^bytes)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:1944
fn service_authority_field(value: &String) -> String {
    encoded :: service_authority_hex(value.as_bytes())
    "{value.len()}:{encoded}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:1952
fn service_authority_record(op: Char, fields: &[String]) -> String {
    record := op.to_string()
    for field in fields {
        record.push('|')
        record.push_str(&service_authority_field(field))
    }
    record.push('\n')
    ^record
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:1962
fn service_authority_parse_record(line: &String) -> (Char, [String]) JetServiceError! {
    parts := line.split('|')
    op :: parts.next().and_then(fn(value) { value.chars().next() })
        .ok_or_else(fn() { service_authority_error("service authority record has no operation") })?
    fields := [String]{}
    for part in parts {
        (length, encoded) := part.split_once(':').ok_or_else(fn() { service_authority_error("service authority field is malformed") })?
        length :: length.parse::<USize>().map_err(fn(_) { service_authority_error("service authority field length is malformed") })?
        bytes :: service_authority_unhex(encoded).ok_or_else(fn() { service_authority_error("service authority field is not hex") })?
        if bytes.len() != length { return Err(service_authority_error("service authority field length does not match")) }
        value :: String.from_utf8(^bytes).map_err(fn(_) { service_authority_error("service authority field is not UTF-8") })?
        fields.push(^value)
    }
    Ok((op, ^fields))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:1990
// GATE #4565: kernel primitive
#Unsafe("read real locked append-only store with byte/record bounds and reject syntactically complete non-newline tail")
fn service_authority_read(runtime: &JetServiceRuntime) -> [(Char, [String])] JetServiceError! {
    service_authority_validate_store_path(&runtime.store)?
    _file_lock :: service_authority_file_lock(&runtime.store, "store")?
    file := match OpenOptions.new().read(true).open(OSPath.new(&runtime.store)) {
        Ok(file) -> ^file
        Err(error) if error.kind() == ErrorKind.NotFound -> return Ok([])
        Err(error) -> return Err(service_authority_error("could not open service store: {error}"))
    }
    size :: file.metadata().map_err(fn(error) { service_authority_error("could not inspect service store: {error}") })?.len()
    if size > SERVICE_AUTH_MAX_BYTES { return Err(JetServiceError.Policy("service authority log exceeds its byte limit")) }
    contents := String.new()
    file.read_to_string(&contents).map_err(fn(error) { service_authority_error("could not read service store: {error}") })?
    if contents.lines().count() > SERVICE_AUTH_MAX_RECORDS { return Err(JetServiceError.Policy("service authority log is full")) }
    // Ignore only syntactically incomplete crash tail; complete no-newline
    // record is truncated and must fail closed instead of becoming history.
    (complete, tail) := contents.rfind('\n').map(fn(end) { (&contents[..end], &contents[end + 1..]) }).unwrap_or(("", &contents))
    if !tail.is_empty() && service_authority_parse_record(tail).is_ok() {
        return Err(service_authority_error("service authority log ends with a truncated record"))
    }
    complete.lines().map(service_authority_parse_record).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:2043
// GATE #4565: kernel primitive
#Unsafe("locked store repairs only incomplete crash tail and fsyncs repair and appended durable record")
fn service_authority_append(runtime: &JetServiceRuntime, op: Char, fields: &[String]) -> () JetServiceError! {
    service_authority_validate_store_path(&runtime.store)?
    _file_lock :: service_authority_file_lock(&runtime.store, "store")?
    record :: service_authority_record(op, fields)
    options := OpenOptions.new()
    options.create(true).append(true).read(true).write(true)
    if target.selected_family() == "unix" { options.mode(0o600) }
    file := options.open(OSPath.new(&runtime.store)).map_err(fn(error) { service_authority_error("could not open service store: {error}") })?
    current_size :: file.metadata().map_err(fn(error) { service_authority_error("could not inspect service store: {error}") })?.len()
    record_size :: U64.try_from(record.len()).map_err(fn(_) { JetServiceError.Policy("service receipt record is too large") })?
    if current_size.checked_add(record_size).is_none_or(fn(size) { size > SERVICE_AUTH_MAX_BYTES }) {
        return Err(JetServiceError.Policy("service authority log exceeds its byte limit"))
    }
    file.seek(SeekFrom.Start(0)).map_err(fn(error) { service_authority_error("could not seek service store: {error}") })?
    contents := String.new()
    file.read_to_string(&contents).map_err(fn(error) { service_authority_error("could not read service store before append: {error}") })?
    complete_end :: contents.rfind('\n').map(fn(end) { end + 1 }).unwrap_or(0)
    tail := &contents[complete_end..]
    if !tail.is_empty() {
        if service_authority_parse_record(tail).is_ok() {
            return Err(service_authority_error("service authority log ends with a truncated record"))
        }
        file.set_len(complete_end as U64).map_err(fn(error) { service_authority_error("could not repair service authority log tail: {error}") })?
        file.sync_all().map_err(fn(error) { service_authority_error("could not commit service authority log repair: {error}") })?
    }
    file.seek(SeekFrom.End(0)).map_err(fn(error) { service_authority_error("could not seek service store for append: {error}") })?
    file.write_all(record.as_bytes()).map_err(fn(error) { service_authority_error("could not append service receipt: {error}") })?
    file.sync_all().map_err(fn(error) { service_authority_error("could not commit service receipt: {error}") })
}
