// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ServiceAuthority.rs:2493
fn jet_services_delivery_events(delivery: &JetDelivery) -> [JetDeliveryEvent] JetServiceError! {
    (_, entry, records) :: service_authority_delivery_entry(delivery)?
    events := [JetDeliveryEvent]{}
    loop (op, fields) in records {
        match (op, fields.as_slice()) {
            ('S', [id, key, authority, tree, worker, generation, message, created, expires, signature]) if id == &delivery.id -> {
                generation :: generation.parse<I64>().map_err(fn(_) { service_authority_error("delivery event generation is malformed") })?
                timestamp :: created.parse<I64>().map_err(fn(_) { service_authority_error("delivery event timestamp is malformed") })?
                if !events.is_empty() -> return Err(service_authority_error("delivery event sequence is not monotonic"))
