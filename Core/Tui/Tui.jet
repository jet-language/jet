package: {
    name: "core.tui"
    version: "0.0.1"
    edition: "2026"
    description: "Terminal UI layout, color, and events."
    license: "MIT"
    outputs: {
        tui: .Library{ entry: tui }
    }
}
use {
    tui_sys: core.sys
    core: core
    ui: core.ui
    core.ui.[Rect, UINode]
    math: core.math
}

// core.tui — the portable terminal presentation layer.
//
// Models and layout are pure. Environment and stdout-terminal facts cross
// provider seams; drawing remains owned by the selected UI backend.

TUIEvent: enum {
    Key(code: String, modifiers: Int)
    Resize(size: ui.Size)
    Timer(id: String, elapsed_ms: Int)
    IO(channel: String, payload: [U8])
    Focus(focused: Bool)
    Interrupt
    Close
}

TUIColorProfile: enum {
    ANSI16
    ANSI256
    TrueColor
    ASCII
}

TUIColor: enum {
    ANSI16(Int)
    ANSI256(Int)
    RGB(red: Int, green: Int, blue: Int)
}

TUIDirection: enum {
    Horizontal
    Vertical
}

TUIConstraint: enum {
    Length(Float)
    Min(Float)
    Max(Float)
    Percent(Float)
    Fill(Float)
}

TUICapabilities: struct {
    profile: TUIColorProfile
    color: Bool
    unicode: Bool
    mouse: Bool
    resize: Bool
    clipboard: Bool
    width: Int
    height: Int
}

TUIStyle: struct {
    foreground: TUIColor?
    background: TUIColor?
    bold: Bool
    dim: Bool
    underline: Bool
}

TUIListState: struct {
    selected: Int
    offset: Int
}

capabilities: fn() -> TUICapabilities Never! {
    capabilities_from_inputs(capability_inputs())
}

// The Rust original samples host facts. Runtime leaves do not choose a
// presentation profile, parse dimensions, or apply the NO_COLOR override.
TUICapabilityInputs: struct {
    columns: String?
    lines: String?
    term: String?
    color_term: String?
    ascii: Bool
    forced: Bool
    no_color: Bool
    terminal: Bool
    usize_max: U64
}

capability_env_bytes: fn(name: String) -> [U8]? Never! {
    result := [U8]?{None}
    #Unsafe("Core TUI reads owned encoded OS environment bytes from the current host; no UTF-8 assumption") {
        result = core.tui.__cap_env_bytes(name)
    }
    result
}

capability_env_text: fn(name: String) -> String? Never! {
    raw: capability_env_bytes(name) ?? return None
    capability_text(raw)
}

capability_text: fn(raw: [U8]) -> String? Never! {
    Val(String.from_bytes(raw) ?? return None)
}

capability_env_flag: fn(name: String) -> Bool Never! {
    capability_raw_flag(capability_env_bytes(name))
}

capability_raw_flag: fn(value: [U8]?) -> Bool Never! {
    if value == .Val(raw) -> return raw != [U8]{48}
    false
}

capability_stdout_terminal: fn() -> Bool Never! {
    result := false
    #Unsafe("Core TUI samples the same stdout terminal fact consumed by terminal style/progress") {
        result = core.term.__stdout_terminal()
    }
    result
}

capability_inputs: fn() -> TUICapabilityInputs Never! {
    // env::var: invalid UTF-8 is absent.
    columns: capability_env_text("COLUMNS")
    lines: capability_env_text("LINES")
    term: capability_env_text("TERM")
    color_term: capability_env_text("COLORTERM")
    // env::var_os: presence and raw != "0".
    ascii: capability_env_flag("JET_TUI_ASCII")
    forced: capability_env_flag("FORCE_COLOR")
    no_color: capability_env_bytes("NO_COLOR") != None
    terminal: capability_stdout_terminal()
    TUICapabilityInputs{
        columns: columns, lines: lines, term: term, color_term: color_term,
        ascii: ascii, forced: forced, no_color: no_color, terminal: terminal,
        usize_max: tui_sys.usize_max()
    }
}

capability_dimension: fn(text: String?, fallback: Int, maximum: U64) -> Int Never! {
    value: text ?? return fallback
    raw: value.bytes()
    at := 0
    if raw.len() > 0 && raw[0] == (U8{43}) -> at = 1
    if at == raw.len() -> return fallback
    parsed := U64{0}
    loop at < raw.len() {
        byte: raw[at]
        if byte < (U8{48}) || byte > (U8{57}) -> return fallback
        digit: U64{Int.from_u8(byte) - 48}
        if parsed > (maximum - digit) / (U64{10}) -> return fallback
        parsed = parsed * U64{10} + digit
        at += 1
    }
    if parsed == (U64{0}) -> return fallback
    Int.from_u64(parsed)
}

capability_ascii_lower: fn(text: String) -> String Never! {
    raw: text.bytes()
    out := [U8]{}
    loop byte in raw {
        if byte >= (U8{65}) && byte <= (U8{90}) -> out.push(U8{Int.from_u8(byte) + 32})
        else -> out.push(byte)
    }
    String.from_bytes(out) ?? panic("ASCII case conversion preserves UTF-8")
}

capabilities_from_inputs: fn(inputs: TUICapabilityInputs) -> TUICapabilities Never! {
    term: capability_ascii_lower(inputs.term ?? "")
    color_term: capability_ascii_lower(inputs.color_term ?? "")
    profile := TUIColorProfile.ANSI16
    if inputs.ascii || term == "dumb" -> profile = TUIColorProfile.ASCII
    else if color_term == "truecolor" || color_term == "24bit" || term.contains("truecolor") || term.contains("24bit") -> profile = TUIColorProfile.TrueColor
    else if term.contains("256color") -> profile = TUIColorProfile.ANSI256
    rich: profile != TUIColorProfile.ASCII
    TUICapabilities{
        profile: profile,
        color: !inputs.no_color && rich && (inputs.terminal || inputs.forced),
        unicode: rich, mouse: rich && !inputs.no_color, resize: rich,
        clipboard: rich && !inputs.no_color,
        width: capability_dimension(inputs.columns, 80, inputs.usize_max),
        height: capability_dimension(inputs.lines, 24, inputs.usize_max)
    }
}

ascii: fn(value: String) -> String Never! {
    raw: value.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        width: utf8_width(raw[i])
        n: scalar_at(raw, i, width)
        i += width
        out.push(U8{ascii_scalar(n)})
    }
    String.from_bytes(out) ?? ""
}
color_ansi16: fn(index: Int) -> TUIColor Never! { TUIColor.ANSI16(clamp_int(index, 15)) }
color_ansi256: fn(index: Int) -> TUIColor Never! { TUIColor.ANSI256(clamp_int(index, 255)) }
color_rgb: fn(red: Int, green: Int, blue: Int) -> TUIColor Never! {
    TUIColor.RGB{red: clamp_int(red, 255), green: clamp_int(green, 255), blue: clamp_int(blue, 255)}
}

style: fn() -> TUIStyle Never! {
    TUIStyle{foreground: None, background: None, bold: false, dim: false, underline: false}
}
style_bold: fn(s: TUIStyle, enabled: Bool) -> TUIStyle Never! {
    result := s
    result.bold = enabled
    result
}
style_dim: fn(s: TUIStyle, enabled: Bool) -> TUIStyle Never! {
    result := s
    result.dim = enabled
    result
}
style_underline: fn(s: TUIStyle, enabled: Bool) -> TUIStyle Never! {
    result := s
    result.underline = enabled
    result
}
style_foreground: fn(s: TUIStyle, color: TUIColor) -> TUIStyle Never! {
    result := s
    result.foreground = Val(color)
    result
}
style_background: fn(s: TUIStyle, color: TUIColor) -> TUIStyle Never! {
    result := s
    result.background = Val(color)
    result
}
style_text: fn(value: String, s: TUIStyle, caps: TUICapabilities) -> String Never! {
    text := value
    if !caps.unicode -> text = ascii(text)
    if !caps.color -> return text
    if caps.profile == .ASCII -> return text
    codes := [String]{}
    if s.bold -> codes.push("1")
    if s.dim -> codes.push("2")
    if s.underline -> codes.push("4")
    if s.foreground == .Val(color) -> codes.push(color_code(color, caps.profile, false))
    if s.background == .Val(color) -> codes.push(color_code(color, caps.profile, true))
    if codes.len() == 0 -> return text
    escape: String.from_bytes([U8]{27}) ?? ""
    "{escape}[{codes.join(";")}m{text}{escape}[0m"
}
display_width: fn(value: String) -> Int Never! {
    raw: value.bytes()
    result := 0
    i := 0
    escape := false
    loop i < raw.len() {
        width: utf8_width(raw[i])
        n: scalar_at(raw, i, width)
        i += width
        if escape {
            if n == 64 || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) -> escape = false
        } else if n == 27 -> escape = true
        else -> result += scalar_display_width(n)
    }
    result
}

length: fn(value: Float) -> TUIConstraint Never! { TUIConstraint.Length(nonnegative(value)) }
min: fn(value: Float) -> TUIConstraint Never! { TUIConstraint.Min(nonnegative(value)) }
max: fn(value: Float) -> TUIConstraint Never! { TUIConstraint.Max(nonnegative(value)) }
percent: fn(value: Float) -> TUIConstraint Never! {
    TUIConstraint.Percent(bounded_float(value, 100.0))
}
fill: fn(weight: Float) -> TUIConstraint Never! { TUIConstraint.Fill(normalized_weight(weight)) }
horizontal: fn() -> TUIDirection Never! { TUIDirection.Horizontal }
vertical: fn() -> TUIDirection Never! { TUIDirection.Vertical }

layout: fn(area: Rect, direction: TUIDirection, constraints: [TUIConstraint]) -> [Rect] Never! {
    total := nonnegative(area.height)
    if direction == .Horizontal -> total = nonnegative(area.width)
    sizes := [Float]{}
    desired_total := Float{0.0}
    fill_weight := Float{0.0}
    normalized := constraints
    loop i in 0..<normalized.len() {
        desired := Float{0.0}
        if normalized[i] == {
            .Length(value) -> desired = nonnegative(value)
            .Min(value) -> desired = nonnegative(value)
            .Max(value) -> desired = nonnegative(value)
            .Percent(value) -> desired = total * bounded_float(value, 100.0) / 100.0
            .Fill(weight) -> {
                value: normalized_weight(weight)
                normalized[i] = TUIConstraint.Fill(value)
                fill_weight += value
            }
        }
        sizes.push(desired)
        desired_total += desired
    }
    scale := Float{1.0}
    if desired_total > total && desired_total > 0.0 -> scale = total / desired_total
    used := Float{0.0}
    loop i in 0..<sizes.len() {
        sizes[i] = sizes[i] * scale
        used += sizes[i]
    }
    remaining: nonnegative(total - used)
    if fill_weight > 0.0 {
        loop i in 0..<normalized.len() {
            if normalized[i] == .Fill(weight) -> sizes[i] = remaining * weight / fill_weight
        }
    }
    result := [Rect]{}
    cursor := Float{0.0}
    loop size in sizes {
        frame := Rect{x: area.x, y: area.y + cursor, width: area.width, height: size}
        if direction == .Horizontal -> frame = Rect{x: area.x + cursor, y: area.y, width: size, height: area.height}
        result.push(frame)
        cursor += size
    }
    result
}

list: fn(items: [String]) -> UINode Never! {
    caps: capabilities()
    children := [UINode]{}
    rows := caps.height
    if rows < 1 -> rows = 1
    count := items.len()
    if count > rows -> count = rows
    loop index in 0..<count {
        prefix := "  "
        if index == 0 -> prefix = "> "
        children.push(ui.text(truncate_text("{prefix}{items[index]}", caps.width)))
    }
    if children.len() == 0 -> children.push(ui.text(""))
    ui.box(children)
}

table: fn(headers: [String], rows: [[String]]) -> ui.UINode Never! {
    columns := headers.len()
    loop row in rows {
        if row.len() > columns -> columns = row.len()
    }
    if columns == 0 -> return ui.text("")
    caps: capabilities()
    children := [UINode]{}
    if headers.len() > 0 -> children.push(ui.text(table_line(headers, columns, caps.width)))
    loop row in rows -> children.push(ui.text(table_line(row, columns, caps.width)))
    ui.box(children)
}

list_state: fn() -> TUIListState Never! { TUIListState{selected: 0, offset: 0} }
list_state_select: fn(state: TUIListState, index: Int) -> TUIListState Never! {
    result := state
    result.selected = nonnegative_int(index)
    result
}
list_state_selected: fn(state: TUIListState) -> Int Never! { state.selected }
list_state_offset: fn(state: TUIListState, offset: Int) -> TUIListState Never! {
    result := state
    result.offset = nonnegative_int(offset)
    result
}

key_event: fn(code: String) -> TUIEvent Never! { TUIEvent.Key{code: code, modifiers: 0} }
key_event_modifiers: fn(code: String, modifiers: Int) -> TUIEvent Never! {
    TUIEvent.Key{code: code, modifiers: modifiers.bit_and(255)}
}
resize_event: fn(width: Float, height: Float) -> TUIEvent Never! {
    TUIEvent.Resize{size: ui.Size{width: width, height: height}}
}
timer_event: fn(id: String, elapsed_ms: Int) -> TUIEvent Never! {
    TUIEvent.Timer{id: id, elapsed_ms: elapsed_ms}
}
io_event: fn(channel: String, payload: [U8]) -> TUIEvent Never! {
    TUIEvent.IO{channel: channel, payload: payload}
}
focus_event: fn(focused: Bool) -> TUIEvent Never! { TUIEvent.Focus{focused: focused} }
interrupt_event: fn() -> TUIEvent Never! { TUIEvent.Interrupt }
close_event: fn() -> TUIEvent Never! { TUIEvent.Close }

ColorWords: struct {
    kind: Int
    word: Int
}

StyleWords: struct {
    foreground: ColorWords
    background: ColorWords
    flags: Int
}

color_words: fn(color: TUIColor?) -> ColorWords Never! {
    if color == .Val(value) {
        if value == {
            .ANSI16(index) -> return ColorWords{kind: 1, word: clamp_int(index, 15)}
            .ANSI256(index) -> return ColorWords{kind: 2, word: clamp_int(index, 255)}
            .RGB(red, green, blue) -> return ColorWords{
                kind: 3,
                word: (clamp_int(red, 255) << 16).bit_or((clamp_int(green, 255) << 8)).bit_or(clamp_int(blue, 255)),
            }
        }
    }
    ColorWords{kind: 0, word: 0}
}

style_words: fn(value: TUIStyle) -> StyleWords Never! {
    flags := 0
    if value.bold -> flags = flags.bit_or(1)
    if value.dim -> flags = flags.bit_or(2)
    if value.underline -> flags = flags.bit_or(4)
    StyleWords{foreground: color_words(value.foreground), background: color_words(value.background), flags: flags}
}

truncate_text: fn(value: String, limit: Int) -> String Never! {
    if limit <= 0 -> return ""
    raw: value.bytes()
    out := [U8]{}
    used := 0
    index := 0
    escape := false
    loop index < raw.len() {
        size: utf8_width(raw[index])
        scalar: scalar_at(raw, index, size)
        start: index
        index += size
        if escape {
            if scalar == 64 || (scalar >= 65 && scalar <= 90) || (scalar >= 97 && scalar <= 122) -> escape = false
        } else if scalar == 27 -> escape = true
        else {
            width: scalar_display_width(scalar)
            if used + width > limit -> break
            loop offset in 0..<size -> out.push(raw[start + offset])
            used += width
        }
    }
    String.from_bytes(out) ?? ""
}

table_line: fn(values: [String], columns: Int, width: Int) -> String Never! {
    column_width: nonnegative_int(width - (columns - 1) * 3) /% columns
    out := ""
    loop index in 0..<columns {
        if index > 0 -> out += " | "
        value := ""
        if index < values.len() -> value = values[index]
        value = truncate_text(value, column_width)
        out += value
        if index + 1 < columns {
            padding: nonnegative_int(column_width - display_width(value))
            loop unused in 0..<padding -> out += " "
        }
    }
    truncate_text(out, width)
}

normalized_weight: fn(weight: Float) -> Float Never! {
    // This conversion is bounded and truncating: positive half ties round up.
    rounded: Int.from_float(bounded_float(weight, 65535.0) + 0.5) ?? panic("a bounded weight is finite")
    Float{clamp_int(rounded, 65535)}
}

nonnegative_int: fn(value: Int) -> Int Never! {
    if value < 0 -> return 0
    value
}
clamp_int: fn(value: Int, upper: Int) -> Int Never! {
    if value > upper -> return upper
    nonnegative_int(value)
}
nonnegative: fn(value: Float) -> Float Never! {
    if value - value != 0.0 || value < 0.0 -> return 0.0
    value
}
bounded_float: fn(value: Float, upper: Float) -> Float Never! {
    result: nonnegative(value)
    if result > upper -> return upper
    result
}
rgb_cube: fn(value: Int) -> Int Never! {
    if value < 48 -> return 0
    if value < 115 -> return 1
    clamp_int((value - 55) /% 40, 5)
}
rgb_ansi16: fn(red: Int, green: Int, blue: Int) -> Int Never! {
    index := 0
    brightest := red
    if green > brightest -> brightest = green
    if blue > brightest -> brightest = blue
    if red > 96 -> index = index.bit_or(1)
    if green > 96 -> index = index.bit_or(2)
    if blue > 96 -> index = index.bit_or(4)
    if index == 0 && brightest > 48 -> index = 7
    if brightest > 170 -> index += 8
    index
}
color_code: fn(color: TUIColor, profile: TUIColorProfile, background: Bool) -> String Never! {
    base := 38
    if background -> base = 48
    if profile == .ASCII -> return ""
    if color == {
        .RGB(red, green, blue) -> {
            if profile == .TrueColor -> return "{base};2;{red};{green};{blue}"
            if profile == .ANSI256 {
                index: 16 + 36 * rgb_cube(red) + 6 * rgb_cube(green) + rgb_cube(blue)
                return "{base};5;{index}"
            }
            return color_code(TUIColor.ANSI16(rgb_ansi16(red, green, blue)), profile, background)
        }
        .ANSI256(index) -> {
            if profile == .ANSI16 -> return color_code(TUIColor.ANSI16(index % 16), profile, background)
            return "{base};5;{index}"
        }
        .ANSI16(index) -> {
            value: index % 16
            if profile == .ANSI16 {
                if value < 8 -> return "{base - 8 + value}"
                return "{base + 44 + value}"
            }
            return "{base};5;{value}"
        }
    }
}


utf8_width: fn(byte: U8) -> Int Never! {
    n: Int.from_u8(byte)
    if n < 128 -> return 1
    if n < 224 -> return 2
    if n < 240 -> return 3
    4
}

scalar_at: fn(raw: [U8], offset: Int, width: Int) -> Int Never! {
    value := Int.from_u8(raw[offset])
    if width == 1 -> return value
    value = value.bit_and(((1 << (7 - width)) - 1))
    i := 1
    loop i < width {
        value = (value << 6).bit_or((Int.from_u8(raw[offset + i]).bit_and(63)))
        i += 1
    }
    value
}

ascii_scalar: fn(n: Int) -> Int Never! {
    if n == 0x2500 || n == 0x2501 || n == 0x2550 -> return 45
    if n == 0x2502 || n == 0x2503 || n == 0x2551 -> return 124
    if n == 0x250C || n == 0x250F || n == 0x2554 || n == 0x2510 || n == 0x2513 || n == 0x2557 ||
       n == 0x2514 || n == 0x2517 || n == 0x255A || n == 0x2518 || n == 0x251B || n == 0x255D ||
       n == 0x251C || n == 0x2524 || n == 0x252C || n == 0x2534 || n == 0x253C || n == 0x254B || n == 0x256C -> return 43
    if n == 0x2192 || n == 0x21D2 || n == 0x279C -> return 62
    if n == 0x2190 || n == 0x21D0 -> return 60
    if n == 0x2191 || n == 0x21D1 -> return 94
    if n == 0x2193 || n == 0x21D3 -> return 118
    if n < 128 -> return n
    63
}

scalar_display_width: fn(n: Int) -> Int Never! {
    if n < 32 || (n >= 0x7F && n <= 0x9F) ||
       (n >= 0x0300 && n <= 0x036F) || (n >= 0x0483 && n <= 0x0489) ||
       (n >= 0x0591 && n <= 0x05BD) || (n >= 0x0610 && n <= 0x061A) ||
       (n >= 0x064B && n <= 0x065F) || (n >= 0x1AB0 && n <= 0x1AFF) ||
       (n >= 0x1DC0 && n <= 0x1DFF) || (n >= 0x20D0 && n <= 0x20FF) ||
       (n >= 0xFE20 && n <= 0xFE2F) -> return 0
    if (n >= 0x1100 && n <= 0x115F) || (n >= 0x2329 && n <= 0x232A) ||
       (n >= 0x2E80 && n <= 0x303E) || (n >= 0x3040 && n <= 0xA4CF) ||
       (n >= 0xAC00 && n <= 0xD7A3) || (n >= 0xF900 && n <= 0xFAFF) ||
       (n >= 0xFE10 && n <= 0xFE19) || (n >= 0xFE30 && n <= 0xFE6F) ||
       (n >= 0xFF00 && n <= 0xFF60) || (n >= 0xFFE0 && n <= 0xFFE6) ||
       (n >= 0x1F300 && n <= 0x1FAFF) -> return 2
    1
}

// core.ui's TUI backend writes a leaf's label into its grid with this:
// `cells` holds rows of `cols` scalars, and `label` goes along `row` from
// column `col` with its ANSI escapes stripped, projected to ASCII without
// `unicode`. A zero-width scalar takes no cell, a wide one blanks the cell
// after it, and the label stops at the row's end.
__write_cells: fn(&cells: [Int], cols: Int, row: Int, col: Int, label: String, unicode: Bool) Never! {
    raw: label.bytes()
    at := col
    offset := 0
    escape := false
    loop offset < raw.len() && at < cols {
        width: utf8_width(raw[offset])
        n: scalar_at(raw, offset, width)
        offset += width
        if escape {
            // An escape sequence ends at its final letter (or `@`).
            if n == 64 || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) -> escape = false
        } else if n == 27 {
            escape = true
        } else {
            shown: if unicode -> n else -> ascii_scalar(n)
            cells_wide: scalar_display_width(shown)
            if cells_wide > 0 {
                cells[row * cols + at] = shown
                if cells_wide == 2 && at + 1 < cols -> cells[row * cols + at + 1] = 32
                at += cells_wide
            }
        }
    }
}

#Test("TUI ASCII projection and display width") {
    assert(ascii("─━═│┃║┌┏╔┐┓╗└┗╚┘┛╝├┤┬┴┼╋╬") == "---|||+++++++++++++++++++")
    assert(ascii("→⇒➜←⇐↑⇑↓⇓é🙂") == ">>><<^^vv??")
    assert(display_width("é") == 1)
    assert(display_width("界🙂") == 4)
    assert(display_width("\n\t") == 0)
    escape: String.from_bytes([U8]{27}) ?? ""
    assert(display_width("{escape}[31mred{escape}[0m") == 3)
    assert(display_width("{escape}[31") == 0)
}

#Test("TUI color, style and list-state policy") {
    if color_ansi16(-1) == .ANSI16(index) -> assert(index == 0)
    if color_ansi16(99) == .ANSI16(index) -> assert(index == 15)
    if color_ansi256(999) == .ANSI256(index) -> assert(index == 255)
    if color_rgb(-1, 128, 999) == .RGB(red, green, blue) {
        assert(red == 0 && green == 128 && blue == 255)
    }
    selected: list_state_select(list_state(), -3)
    assert(list_state_selected(selected) == 0)
    shifted: list_state_offset(selected, 12)
    assert(shifted.offset == 12)
    bold: style_bold(style(), true)
    assert(bold.bold && !bold.dim && !bold.underline)
    dim: style_dim(bold, true)
    assert(dim.bold && dim.dim)
    underlined: style_underline(dim, true)
    assert(underlined.underline)
}

#Test("TUI layout scales fixed constraints and apportions fill") {
    area: ui.rect(2.0, 3.0, 100.0, 20.0)
    frames: layout(area, horizontal(), [TUIConstraint]{length(20.0), fill(1.0), fill(3.0)})
    assert(frames.len() == 3)
    assert(frames[0].x == 2.0 && frames[0].width == 20.0)
    assert(frames[1].x == 22.0 && frames[1].width == 20.0)
    assert(frames[2].x == 42.0 && frames[2].width == 60.0)
    scaled: layout(area, vertical(), [TUIConstraint]{length(30.0), min(10.0)})
    assert(scaled[0].height == 15.0 && scaled[1].height == 5.0)
    assert(layout(area, horizontal(), [TUIConstraint]{}).len() == 0)
    if fill(1.5) == .Fill(weight) -> assert(weight == 2.0)
    if percent(200.0) == .Percent(value) -> assert(value == 100.0)
}

#Test("TUI event payloads preserve byte truncation") {
    if key_event_modifiers("A", -1) == .Key(code, modifiers) {
        assert(code == "A" && modifiers == 255)
    }
    if timer_event("tick", -2) == .Timer(id, elapsed) -> assert(id == "tick" && elapsed == -2)
    if io_event("pipe", [U8]{0, 255}) == .IO(channel, payload) {
        assert(channel == "pipe" && payload.len() == 2 && payload[1] == U8{255})
    }
}

#Test("TUI style code ordering and color-profile projection") {
    s: style_background(style_foreground(style_underline(style_dim(style_bold(style(), true), true), true), color_rgb(255, 0, 0)), color_ansi16(9))
    escape: String.from_bytes([U8]{27}) ?? ""
    assert(color_code(color_rgb(255, 0, 0), TUIColorProfile.TrueColor, false) == "38;2;255;0;0")
    assert(color_code(color_rgb(255, 0, 0), TUIColorProfile.ANSI256, false) == "38;5;196")
    assert(color_code(color_rgb(255, 0, 0), TUIColorProfile.ANSI16, false) == "91")
    assert(s.bold && s.dim && s.underline)
    caps: capabilities()
    if !caps.color -> assert(style_text("jet", s, caps) == "jet")
    assert(escape.len() == 1)
}

#Test("TUI style words normalize and the TUI backend shows styled text plain") {
    styled: style_background(style_foreground(style_bold(style(), true), color_rgb(12, 34, 56)), color_ansi16(2))
    words: style_words(styled)
    assert(words.foreground.kind == 3 && words.foreground.word == 795192)
    assert(words.background.kind == 1 && words.background.word == 2 && words.flags == 1)
    escape: String.from_bytes([U8]{27}) ?? ""
    backend: ui.tui_backend()
    ui.mount(backend, ui.text("{escape}[1;38;2;12;34;56mjet{escape}[0m"))
    assert_eq(backend.frame_lines(), [String]{"jet"})
}

#Test("TUI cells strip escapes, skip zero-width scalars and widen wide ones") {
    cells := [Int]{46, 46, 46, 46, 46, 46}
    escape: String.from_bytes([U8]{27}) ?? ""
    acute: String.from_bytes([U8]{0xCC, 0x81}) ?? ""
    __write_cells(cells, 3, 1, 0, "{escape}[31m界{acute}x", true)
    assert_eq(cells, [Int]{46, 46, 46, 0x754C, 32, 120})
    __write_cells(cells, 3, 0, 1, "→ab", false)
    assert_eq(cells, [Int]{46, 62, 97, 0x754C, 32, 120})
}

#Test("TUI list/table formatting keeps scalar widths and empty cells") {
    assert(truncate_text("a界b", 3) == "a界")
    assert(truncate_text("a界b", 2) == "a")
    assert(truncate_text("áb", 1) == "á")
    assert(table_line([String]{"x"}, 2, 9) == "x   | ")
}

#Test("TUI sampled capability policy preserves raw environment and usize rules") {
    inputs := TUICapabilityInputs{
        columns: Val("+00120"), lines: Val("0"), term: Val("XTERM-256COLOR"),
        color_term: None, ascii: false, forced: false, no_color: false,
        terminal: true, usize_max: U64{4294967295}
    }
    caps: capabilities_from_inputs(inputs)
    assert(caps.profile == .ANSI256 && caps.color && caps.unicode)
    assert(caps.width == 120 && caps.height == 24)
    inputs.no_color = true
    inputs.forced = true
    overridden: capabilities_from_inputs(inputs)
    assert(!overridden.color && !overridden.mouse && !overridden.clipboard)
    assert(overridden.unicode && overridden.resize)
    inputs.no_color = false
    inputs.term = Val("DUMB")
    plain: capabilities_from_inputs(inputs)
    assert(plain.profile == .ASCII && !plain.color && !plain.unicode && !plain.resize)
    assert(capability_dimension(Val("4294967296"), 80, U64{4294967295}) == 80)
    assert(capability_dimension(Val("18446744073709551616"), 80, core.sys.usize_max()) == 80)
    assert(capability_dimension(Val(" 120"), 80, U64{4294967295}) == 80)
    assert(capability_dimension(Val("-1"), 80, U64{4294967295}) == 80)
    invalid: capability_text([U8]{255})
    assert(invalid == None && capability_dimension(invalid, 80, U64{4294967295}) == 80)
    assert((capability_text([U8]{104, 195, 169}) ?? "") == "hé")
    // Raw var_os checks distinguish an absent flag, an empty flag, and "0".
    assert(!capability_raw_flag(None))
    assert(capability_raw_flag(Val([U8]{})))
    assert(!capability_raw_flag(Val([U8]{48})))
    assert(capability_raw_flag(Val([U8]{255})))
}
