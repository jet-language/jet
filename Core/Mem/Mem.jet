package: {
    name: "core.mem"
    version: "0.0.1"
    edition: "2026"
    description: "Regions, blocks, the allocator trait, arenas, pins, atomics, and volatile access."
    license: "MIT"
    outputs: {
        mem: .Library{ entry: mem }
    }
}

use {
    builtin: jet_builtins
    core: core
    mem: core.mem
    rt: jet.runtime.mem
}

scope: module

#Error
AllocError: struct {
    requested_bytes: Int,
    allocator: String,

    impl Describe {
        public: fn(self) -> String Never! { "Memory allocation failed." }

        detail: fn(self) -> String Never! {
            "memory allocation of {self.requested_bytes} bytes refused by allocator `{self.allocator}`"
        }
    }
}

// Allocator and pointer values are compiler-owned nominal surfaces. Their
// methods are lowered by the memory CoreLib; source keeps only the canonical
// type arities, never a fake runtime state carrier.
// `Pool` is the slot allocator and takes no type argument; the generic
// `Slots<T>` is the ambient generational store, a separate type. Each allocator owns its
// storage, so it is `Close`: a copy would release that storage twice. Its
// runtime handle's drop releases the storage once the close has run, so the
// close itself has nothing left to do. The storage belongs to the thread
// that made it, so each allocator is `#Local`.
#Local
Arena: struct {
    // An arena whose first block holds `capacity` bytes; it grows by further
    // blocks as allocations need them.
    new: fn(capacity: Int{4096}) -> Arena Never! { rt.arena(capacity) }

    impl Close {
        close: fn(^^self) {}
    }
}

#Local
Bump: struct {
    // A bump allocator whose first block holds `capacity` bytes.
    new: fn(capacity: Int{65536}) -> Bump Never! { rt.bump(capacity) }

    impl Close {
        close: fn(^^self) {}
    }
}

// A Fixed allocator works in storage that its call's own frame holds, so the
// compiler builds each of its constructors where the call stands, found by
// the role that constructor fills. That call must directly initialize a
// lexical binding, which keeps the storage for the binding's scope. The
// constructors' bodies never run.
#Local
Fixed: struct {
    // `size` bytes of inline storage in the calling frame. `size` is a
    // positive compile-time Int.
    #Builtin.Role(.FixedFrame) new: fn(size: Int) -> Fixed Never! { panic("`Fixed.new` is built at its call") }

    // The mutable `[Byte#N]` buffer `bytes`, borrowed until the handle
    // closes.
    #Builtin.Role(.FixedOver) over: fn<B>(bytes: ^B) -> Fixed Never! { panic("`Fixed.over` is built at its call") }
    impl Close {
        close: fn(^^self) {}
    }
}

#Local
Pool: struct {
    // A slot allocator with `slots` slots, one allocation each.
    new: fn(slots: Int) -> Pool Never! { rt.pool(slots) }

    impl Close {
        close: fn(^^self) {}
    }
}

Pin: struct<T> {}

// The compiler builds `address_of` and `pin` where the call stands, found by
// the role each fills: each works on the caller's own storage, and neither
// body runs. `address_of` is the inert numeric address of the place
// `value` names, never of a copy.
#Builtin.Role(.MemAddressOf) address_of: fn<T>(value: T) -> Int Never! { panic("`address_of` is built at its call") }

// A write window on `place` that it cannot move out of, typed `Pin<T>`.
// Pinning a `Pin<T>` keeps that pin.
#Builtin.Role(.MemPin) pin: fn<T>(place: ^T) -> Pin<T> Never! { panic("`pin` is built at its call") }

// Every raw memory primitive here is a compiler intrinsic (the list above
// `__type_size`) or `#Inline(Always)`, so a call of one costs what the
// direct spelling costs at O1 and O2.
#[Inline(Always), Unsafe("`addr` is the address of a live, aligned `T` that stays valid for every use of the returned pointer")]
from_addr: fn<T>(addr: Int) -> *T Never! { mem.Ptr<T>.from_addr(addr) }

#[Builtin.Role(.InlineVolatileRead), Unsafe("`pointer` names a live, aligned, readable `T` for the whole access")]
volatile_read: fn<T>(pointer: *T) -> T Never! { core.mem.volatile_read<T>(pointer) }

#[Builtin.Role(.InlineVolatileWrite), Unsafe("`pointer` names a live, aligned, writable `T` for the whole access")]
volatile_write: fn<T>(pointer: *T, value: T) Never! { core.mem.volatile_write<T>(pointer, value) }

// `count` Ts at `to` become the `count` at `from`, as one move of their bytes,
// so the two ranges may overlap. No copy or drop runs on the Ts moved or
// overwritten. A count of zero or less moves nothing.
#[Builtin.Role(.InlineMemCopy), Unsafe("`to` and `from` each name `count` live, aligned `T`s, and a T that owns a resource has one owner after the copy")]
copy: fn<T>(to: *T, from: *T, count: Int) Never! { core.mem.copy<T>(to, from, count) }

// Each of the `count` Ts at `to` becomes a copy of `value`; nothing runs on
// the Ts overwritten. A count of zero or less writes nothing.
#[Builtin.Role(.InlineMemFill), Unsafe("`to` names `count` live, aligned, writable `T`s that hold no value to drop")]
fill: fn<T>(to: *T, value: T, count: Int) Never! { core.mem.fill<T>(to, value, count) }

// The List at `values` grows by the `count` Ts at `from`, as one move of
// their bytes; nothing runs on the Ts moved. A full List's buffer grows to
// twice its capacity, or to the new length when that is more, and its own
// elements move first, so `from` may name them. False, and the List as it
// was, when `count` is negative or the growth fails; a count of zero appends
// nothing.
#[Builtin.Role(.InlineListAppend), Unsafe("`from` names `count` live, aligned `T`s, and a T that owns a resource has one owner after the append")]
list_append: fn<T>(values: ^[T], from: *T, count: Int) -> Bool Never! {
    core.mem.list_append<T>(values, from, count)
}

// The `count` Ts at `to` become `values[start..<start + count]`, as one move
// of their bytes, so the two may overlap; nothing runs on the Ts moved or
// overwritten. A range that is not inside `values` stops the run as a slice
// of it does; a count of zero copies nothing.
#[Builtin.Role(.InlineListCopy), Unsafe("`to` names `count` live, aligned, writable `T`s that hold no value to drop, and a T that owns a resource has one owner after the copy")]
list_copy: fn<T>(to: *T, values: [T], start: Int, count: Int) Never! {
    core.mem.list_copy<T>(to, values, start, count)
}

// `size` bytes of fresh heap storage aligned to `align`, as a byte pointer
// (`cast<U>` gives the typed view), or None when `size` is not above zero,
// `align` is not a power of two, or the heap refuses. The bytes are not
// cleared. The word 24 bytes before them keeps the size for `free_raw`.
#[Builtin.Role(.InlineAllocRaw), Unsafe("the storage is used only through pointers derived from the result, and `free_raw` releases it exactly once")]
alloc_raw: fn(size: Int, align: Int) -> mem.Ptr<U8>? Never! { core.mem.alloc_raw(size, align) }

// Releases the storage `alloc_raw` gave `pointer`; the pointer is taken, so
// the binding is gone after the call.
#[Builtin.Role(.InlineFreeRaw), Unsafe("`pointer` came unchanged from `alloc_raw`, is not released yet, and no copy of it is used after")]
free_raw: fn(pointer: ^^mem.Ptr<U8>) Never! { core.mem.free_raw(pointer) }

// The memory sentry's account of an OS mapping, kept by the kernel's mapping
// primitives alone (Region's reserve and close here, and JetBackend's
// os_map, os_map_with and os_unmap; E3113 refuses any other caller).
// `mapped` makes the whole pages over `bytes` at `address` live storage, as
// `alloc_raw` does its block, so a checked access inside them passes;
// `unmapping`, just before the pages go, takes them out of the live storage
// without writing them, so a checked access after is R0801. An image
// without the sentry builds neither call.
#[Builtin.Role(.InlineMapped), Unsafe("`address` starts a mapping of `bytes` that the caller just made and alone owns")]
mapped: fn(address: Int, bytes: Int) Never! { core.mem.mapped(address, bytes) }

#[Builtin.Role(.InlineUnmapping), Unsafe("`address` and `bytes` name pages of a mapping the caller owns, which it unmaps next, so nothing reads or writes them after")]
unmapping: fn(address: Int, bytes: Int) Never! { core.mem.unmapping(address, bytes) }

// The `View<T>` over the `count` Ts at `pointer`, which lives no longer than
// `owner`: sema ties the View to `owner` as it ties any declared view to its
// source, so the View cannot be read after `owner` is moved, consumed or
// closed, nor leave the scope that holds `owner`. A kernel hands out its
// storage this way, naming the handle that owns it. A `count` below zero is
// an empty View. Reads are ordinary View reads: an index the type proves in
// bounds is a bare load, any other one compare against the length.
#[Inline(Always), Unsafe("`pointer` names `count` live, aligned Ts that `owner` keeps alive and unchanged by anything else while the View lives")]
window: fn<T, O>(owner: O, pointer: *T, count: Int) -> View<T> Never! from owner {
    __view_from_raw<T, O>(owner, pointer, if count < 0 -> 0 else -> count)
}

// The bare View header `window` builds: no check and no call. A compiler
// intrinsic, as the List layout operations below are. Reserved `__` name,
// never public.
#[Builtin.Role(.InlineViewFromRaw), Unsafe("`pointer` names `count` live, aligned Ts that `owner` keeps alive, and `count` is not negative")]
priv __view_from_raw: fn<T, O>(owner: O, pointer: *T, count: Int) -> View<T> Never! from owner {
    __view_from_raw<T, O>(owner, pointer, count)
}

// `dst = value`, written without filling the cache where the target has a
// non-temporal store of the value's width (x86-64: `movnti` for four- and
// eight-byte values), else an ordinary store. For a large output written
// once and not read again soon. The writes are ordered before the next
// call and the function's return.
#Builtin.Role(.InlineStreamStore) stream_store: fn<T>(dst: ^T, value: T) Never! {
    core.mem.stream_store<T>(dst, value)
}

// The raw List layout operations Core's encoding and crypto storage measure
// and grow its Lists with: T's List stride in bytes, a List's capacity, and
// growing a List to exactly `len + additional` elements (false when the
// allocation fails). Reserved `__` names, never public.
//
// Each operation here, and `volatile_read`, `volatile_write`, `copy`, `fill`,
// `list_append`, `list_copy`, `alloc_raw`, `free_raw`, `mapped`, `unmapping`
// and `stream_store` above, is a compiler intrinsic:
// the compiler builds every call inline (JetIR Build.jet IR_CORE_INTRINSICS)
// and never builds the body, so a body names only the declaration's own
// operation.
#Builtin.Role(.InlineTypeSize) priv __type_size: fn<T>() -> Int Never! { __type_size<T>() }

#Builtin.Role(.InlineListCapacity) priv __list_capacity: fn<T>(values: [T]) -> Int Never! {
    __list_capacity<T>(values)
}

#Builtin.Role(.InlineListReserveExact) priv __list_reserve_exact: fn<T>(values: ^[T], additional: Int) -> Bool Never! {
    __list_reserve_exact<T>(values, additional)
}

// `p.offset(n)` and `p.byte_offset(n)` on a raw pointer `*T`: the pointer
// `n` elements (at T's List stride) or `n` bytes past `p`. Pointer math is
// audit-gated: the compiler checks the method as a call of these, inside
// `#Unsafe` only. Reserved `__` names, never public.
#[Builtin.Role(.InlinePtrOffset), Unsafe("`pointer` and the T `count` elements past it lie in one live allocation")]
priv __ptr_offset: fn<T>(pointer: *T, count: Int) -> *T Never! { __ptr_offset<T>(pointer, count) }

#[Builtin.Role(.InlinePtrByteOffset), Unsafe("`pointer` and the address `bytes` past it lie in one live allocation")]
priv __ptr_byte_offset: fn<T>(pointer: *T, bytes: Int) -> *T Never! {
    __ptr_byte_offset<T>(pointer, bytes)
}

// A region's fresh pages: `__region_reserve` maps `bytes` of private pages,
// which the system commits on first touch, and answers their address, or 0
// when the size is not positive or the system refuses; `__region_release`
// unmaps them at the length reserved. Compiler intrinsics as the List layout
// operations above are. Reserved `__` names, never public.
#[Builtin.Role(.InlineRegionReserve), Unsafe("the pages are fresh and private; the caller unmaps them once, with `__region_release` at the length it reserved")]
priv __region_reserve: fn(bytes: Int) -> Int Never! { __region_reserve(bytes) }

#[Builtin.Role(.InlineRegionRelease), Unsafe("`address` and `bytes` are a mapping `__region_reserve` answered, and nothing reads or writes its pages again")]
priv __region_release: fn(address: Int, bytes: Int) Never! { __region_release(address, bytes) }

/// A span of address space that allocators take their blocks from.
/// `reserve` maps fresh pages, which the system commits on first touch, and
/// `close` unmaps them. `adopt` wraps memory the caller already owns and never
/// unmaps it. `claim` hands blocks out in address order and never reuses
/// them; reuse is the allocator's job.
Region: struct {
    priv base: Int,
    priv size: Int,
    priv cursor: Int,
    priv mapped: Bool,

    /// A region of `bytes` of fresh private memory. A size of zero or less,
    /// or a system refusal, is an AllocError.
    reserve: fn(bytes: Int) -> Region AllocError! {
        if bytes <= 0 -> return Err(AllocError{requested_bytes: bytes, allocator: "Region"})
        ^address: 0
        #Unsafe("the runtime maps fresh private pages that no other owner can see; the region unmaps them once, at close") {
            address = __region_reserve(bytes)
            if address != 0 -> mapped(address, bytes)
        }
        if address == 0 -> return Err(AllocError{requested_bytes: bytes, allocator: "Region"})
        Ok(Region{base: address, size: bytes, cursor: 0, mapped: true})
    }

    /// A region over `bytes` of memory at `address` that the caller owns.
    #Unsafe("`address` names `bytes` of live, writable memory that nothing else reads or writes while the region and its blocks live")
    adopt: fn(address: Int, bytes: Int) -> Region Never! {
        Region{base: address, size: if bytes < 0 -> 0 else -> bytes, cursor: 0, mapped: false}
    }

    /// The first address of the region.
    address: fn(self) -> Int Never! { self.base }

    /// The size of the region in bytes.
    size: fn(self) -> Int Never! { self.size }

    /// The bytes that `claim` has not handed out yet.
    remaining: fn(self) -> Int Never! { self.size - self.cursor }

    /// The next `size` bytes at a multiple of `align`, which must be a power
    /// of two. None when the size or alignment is invalid, or the region has
    /// no room left.
    claim: fn(^self, size: Int, align: Int) -> Block? Never! {
        if size <= 0 || align <= 0 || align & align - 1 != 0 -> return None
        mask: align - 1
        limit: self.base + self.size
        next: self.base + self.cursor
        if mask > limit - next -> return None
        start: (next + mask) &~ mask
        if size > limit - start -> return None
        self.cursor = start + size - self.base
        Val(Block{address: start, size: size})
    }

    impl Close {
        close: fn(^^self) {
            if !self.mapped {
                return
            }
            #Unsafe("the region mapped these pages at reserve, and no block of it is used after close") {
                unmapping(self.base, self.size)
                __region_release(self.base, self.size)
            }
        }
    }
}

/// A span of bytes that a region or an allocator handed out. A block is
/// single use: it ends by going back to an allocator's `release`, and it
/// cannot be copied or forged. `split` and `join` change it in place.
#SingleUse Block: struct {
    priv address: Int,
    priv size: Int,

    /// The first address of the block.
    address: fn(self) -> Int Never! { self.address }

    /// The size of the block in bytes.
    size: fn(self) -> Int Never! { self.size }

    /// Keeps the first `at` bytes and returns the rest as a new block.
    /// `at` must lie strictly inside the block.
    split: fn(^self, at: Int) -> Block Never! {
        if at <= 0 || at >= self.size {
            panic("mem.Block.split: the split point {at} is outside a block of {self.size} bytes")
        }
        tail: Block{address: self.address + at, size: self.size - at}
        self.size = at
        tail
    }

    /// Grows the block over `next`, which must start where this block ends.
    join: fn(^self, next: ^^Block) Never! {
        if self.address + self.size != next.address {
            panic("mem.Block.join: the blocks at {self.address} and {next.address} are not neighbors")
        }
        self.size += next.size
        #Unsafe("`next`'s bytes now belong to this block, so its release duty is this block's") {
            consume(next)
        }
    }
}

/// The allocator trait. `allocate` answers a block of at least `size` bytes
/// at a multiple of `align`, or an AllocError. `release` takes a block back.
/// `resize` changes a block's size in place and answers whether it could;
/// on false the block is unchanged. Neither fails: the runtime calls
/// `release` for a `#Context(allocator:)` block inside a drop.
Allocator: trait {
    allocate: fn(^self, size: Int, align: Int) -> Block AllocError!,
    release: fn(^self, block: ^^Block) Never!,
    resize: fn(^self, block: ^Block, new_size: Int) -> Bool Never!,
}

// The runtime's call into `allocator` for a `#Context(allocator:)` block
// (JetRuntime Alloc.jet alloc_user_call): op 0 allocates x bytes at align y
// and answers the address, 0 when refused; op 1 releases the x bytes at
// address y, a block op 0 answered. The block borrows the allocator, so the
// call holds its address, not a copy: the block's checks keep the allocator
// in place and unchanged until the block ends, and the runtime calls this
// only inside it. The sentry witness is off for that read because the
// address was taken in this function's frame, which has returned by then.
// The closure's type has no failure: the runtime takes its result as a bare
// Int, and `-> Int Never!` here would make it a failure-carrying result.
#Builtin.Role(.AllocatorHandler) priv __allocator_handler: fn<A: Allocator>(allocator: A) -> fn(Int, Int, Int) -> Int {
    ^address: 0
    #Unsafe("the allocator is a place the `#Context(allocator:)` block keeps in place until it ends") {
        address = mem.address_of(allocator)
    }
    fn(op: Int, x: Int, y: Int) {
        ^answer: 0
        #Unsafe("the runtime calls this only inside the block, while the allocator at `address` is live, in place and borrowed by nothing else") {
            #Policy(sentries: .Off) {
                ^held: mem.Ptr<A>.from_addr(address)
                if op == 0 {
                    block: held.*.allocate(x, y) ?? return 0
                    answer = block.address()
                    consume(block)
                } else { held.*.release(Block{address: y, size: x}) }
            }
        }
        answer
    }
}

// The blocks of `context.allocator`: `__context_take` answers the address
// of `size` bytes at a multiple of `align` that the current allocator
// serves, or 0 when it refuses; `__context_give` hands such a block of
// `size` bytes back to the allocator that served it; `__context_room`
// answers the bytes from the address to the end of what was served, the
// most the block can grow to (0 for a user allocator's block, which only
// that allocator can resize). Compiler intrinsics as the region operations
// above are.
#Builtin.Role(.InlineContextTake) priv __context_take: fn(size: Int, align: Int) -> Int Never! {
    __context_take(size, align)
}

#Builtin.Role(.InlineContextGive) priv __context_give: fn(address: Int, size: Int) Never! {
    __context_give(address, size)
}

#Builtin.Role(.InlineContextRoom) priv __context_room: fn(address: Int) -> Int Never! {
    __context_room(address)
}

// The allocator behind `context.allocator`. It holds no state: each call
// goes to whichever allocator is current then, the innermost
// `#Context(allocator:)` block's, else the program heap.
priv __ContextAllocator: struct {
    impl Allocator {
        allocate: fn(^self, size: Int, align: Int) -> Block AllocError! {
            if size <= 0 -> return Err(AllocError{requested_bytes: size, allocator: "context"})
            address: __context_take(size, align)
            if address == 0 -> return Err(AllocError{requested_bytes: size, allocator: "context"})
            Ok(Block{address: address, size: size})
        }

        release: fn(^self, block: ^^Block) Never! {
            __context_give(block.address, block.size)
            #Unsafe("the block's bytes went back to the allocator that served them") {
                consume(block)
            }
        }

        resize: fn(^self, block: ^Block, new_size: Int) -> Bool Never! {
            if new_size <= 0 || new_size > __context_room(block.address) -> return false
            block.size = new_size
            true
        }
    }
}

// `context.allocator`'s value (JetSema Places.jet
// sema_expression_context_allocator).
#Builtin.Role(.ContextAllocator) priv __context_allocator: fn() -> Allocator Never! {
    __ContextAllocator{}
}
