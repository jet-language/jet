package: {
    name: "core.game"
    version: "0.0.1"
    edition: "2026"
    description: "Backend-neutral game scene, replay, and frame loop."
    license: "MIT"
    outputs: {
        game: .Library{ entry: game }
    }
}

use game_rt: jet.runtime.rt

// core.game — canonical scene/replay/backend handles.
//
// The runtime owns frame scheduling, input snapshots, and presentation.
// Scene, Replay, and Backend are opaque compiler-owned handles. Their
// registered constructors retain scene assets, input, replay, and scheduling
// state; a plain source record cannot represent those runtime identities.
// Runs the scene's frame loop and returns its transcript. The loop borrows
// the scene mutably, so the scene is a `:=` name, not a temporary. The loop
// itself is the runtime's (jet.runtime.rt.game_run).
run: fn(scene: GameScene, replay: GameReplay?{None}, backend: GameBackend?{None}, frames: Int?{None}) -> String {
    game_rt.game_run(scene, replay, backend, frames)
}
