package: {
    name: "core.encoding"
    version: "0.0.1"
    edition: "2026"
    description: "Codecs and the shared Dyn interchange model."
    license: "MIT"
    outputs: {
        encoding: .Library{ entry: encoding }
    }
}
// core.encoding — interchange codecs and the one dynamic value tree.
//
// Every format in this package speaks the same two verbs: `parse` (text or
// bytes → `Dyn`) and `to_string` / `to_bytes` (value → wire). JSON, JSONL
// CSV, TOML, YAML, XML, CBOR and ETF are nested modules so a program pays only
// for the format it imports. Hex, Base32, and Base64 are byte alphabets, not
// Dyn adapters; they live beside the formats because they are the usual
// way to carry those bytes through text.
//
// This is compiler-owned Core source and is loaded as the `core.encoding`
// package entry. Its nested modules share the carriers below; only narrow
// host capabilities (for example filesystem reads requested by a public
// query API) remain effectful.
// Portable codecs below are written in Jet.
//
// Invariants:
// - `Dyn` is the only user-facing dynamic tree. There is no `Data` alias.
// - Objects keep insertion order. Integers and floats stay distinct variants.
// - The closed cases are Null, Bool, Int, Float, Text, Bytes, DateTime, Array,
//   and Object. Bytes text is padded RFC 4648 base64; DateTime text is canonical
//   RFC 3339 with a fixed offset. TOML/YAML/CBOR retain their native kinds;
//   JSON/JSONL/CSV render them as text. XML retains its separate node schema.
// - No codec fabricates a value for malformed input. Syntax problems are
//   `EncodingError`; alphabet helpers use their local typed errors.
// - Whole-value codecs are pure (`->`) and callers pass text or bytes directly.
hex: module

base32: module

base64: module

json: module

jsonl: module

csv: module
toml: module
yaml: module

xml: module

cbor: module

eetf: module

binary: module

ini: module

use {
    base64: core.encoding.base64
    stream: __core_encoding_stream
    time: core.time
}

/// Handle-free streaming events. Number is public; writers reject it as Unsupported.
DataEvent: enum {
    Null
    Bool(Bool)
    Int(Int)
    Float(Float)
    Number(String)
    Text(String)
    Bytes([U8])
    ArrayStart
    ArrayEnd
    ObjectStart
    Key(String)
    ObjectEnd
}

#Equatable
EncodingFormat: enum {
    JSON
    JSONL
    CSV
    TOML
    YAML
    XML
    CBOR
    ETF
}
impl EncodingFormat {
    as_str: fn(self) -> String Never! {
        if self == {
            .JSON -> "JSON"
            .JSONL -> "JSONL"
            .CSV -> "CSV"
            .TOML -> "TOML"
            .YAML -> "YAML"
            .XML -> "XML"
            .CBOR -> "CBOR"
            .ETF -> "ETF"
        }
    }
}

#Equatable
EncodingErrorKind: enum {
    Syntax
    Truncated
    Unsupported
    Limit
    IO
    State
}
encoding_kind_name: fn(kind: EncodingErrorKind) -> String Never! {
    if kind == {
        .Syntax -> "Syntax"
        .Truncated -> "Truncated"
        .Unsupported -> "Unsupported"
        .Limit -> "Limit"
        .IO -> "IO"
        .State -> "State"
    }
}

#Equatable
EncodingCause: struct {
    kind: String
    os_code: Int?
    message: String
}

/// The same location ladder used by the seed encoding error kernel.
encoding_error_text: fn(format: String, kind: String, byte_offset: Int, line: Int?, column: Int?, path: String, reason: String) -> String Never! {
    out := "{format} {kind} at byte {byte_offset}"
    if line == {
        Val(value) -> out = "{out}, line {value}"
        None -> {}
    }
    if column == {
        Val(value) -> out = "{out}, column {value}"
        None -> {}
    }
    if path != "" -> out = "{out}, path {path}"
    "{out}: {reason}"
}

#[Error, Equatable]
EncodingError: struct {
    format: EncodingFormat
    kind: EncodingErrorKind
    byte_offset: Int
    line: Int?
    column: Int?
    path: String
    reason: String
    cause: EncodingCause?
    impl Display {
        display: fn(self) -> String { self.display_text() }
    }
    impl Debug {
        debug: fn(&&self) -> String { self.display_text() }
    }
}
impl EncodingError {
    new: fn(format: EncodingFormat, kind: EncodingErrorKind, byte_offset: Int, line: Int?, column: Int?, path: String, reason: String) -> EncodingError Never! {
        EncodingError{format: format, kind: kind, byte_offset: byte_offset, line: line, column: column, path: path, reason: reason, cause: None}
    }
    with_cause: fn(self, cause: EncodingCause) -> EncodingError Never! {
        EncodingError{format: self.format, kind: self.kind, byte_offset: self.byte_offset, line: self.line, column: self.column, path: self.path.copy(), reason: self.reason.copy(), cause: Val(cause)}
    }
    cause: fn(self) -> EncodingCause? Never! { self.cause.copy() }
    display_text: fn(self) -> String Never! {
        encoding_error_text(self.format.as_str(), encoding_kind_name(self.kind), self.byte_offset, self.line, self.column, self.path, self.reason)
    }
}

#Equatable
EncodingLimits: struct {
    buffer_bytes: Int
    max_depth: Int
    max_item_bytes: Int
    max_total_bytes: Int?
    max_expansion_depth: Int
    max_expansion_bytes: Int
}
impl EncodingLimits {
    safe: fn() -> EncodingLimits Never! {
        EncodingLimits{buffer_bytes: 65536, max_depth: 256, max_item_bytes: 16777216, max_total_bytes: None, max_expansion_depth: 32, max_expansion_bytes: 8388608}
    }
}

/// Error returned by the root hexadecimal decoder.
#Error
HexError: struct {
    reason: String
    impl Display {
        display: fn(self) -> String { self.reason }
    }
    impl Debug {
        debug: fn(&&self) -> String { self.reason }
    }
}
impl HexError {
    new: fn(reason: String) -> HexError Never! { HexError{reason: reason} }
}
/// Convert one nibble to lowercase ASCII. Callers must pass `0..15`.
hex_nibble: fn(n: Int) -> U8 Never! {
    if n < 10 -> return (U8{48 + n})
    (U8{87 + n})
}

/// Hex alphabet lookup. Accepts `0-9A-Fa-f`. Other bytes are absent.
hex_value: fn(b: U8) -> Int? Never! {
    n: Int.from_u8(b)
    if n >= 48 && n <= 57 -> return Val(n - 48)
    if n >= 97 && n <= 102 -> return Val(n - 87)
    if n >= 65 && n <= 70 -> return Val(n - 55)
    None
}

/// Lowercase hex of `bytes`. Allocates `2 * bytes.len()` ASCII bytes.
bytes_to_hex: fn(bytes: [U8]) -> String Never! {
    out := [U8]{}
    loop b in bytes {
        n: Int.from_u8(b)
        out.push(hex_nibble(n /% 16))
        out.push(hex_nibble(n %% 16))
    }
    String.from_bytes(out) ?? ""
}

/// Decode a hex string into bytes. Whitespace is rejected; length must be even.
hex_to_bytes: fn(text: String) -> [U8] HexError! {
    raw: text.bytes()
    if raw.len() %% 2 != 0 {
        return Err(HexError{reason: "odd-length hex string; hex text encodes whole bytes, so the length must be even"})
    }
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        hi: hex_value(raw[i]) ?? return Err(HexError{reason: "invalid hex digit; expected 0-9, a-f, or A-F"})
        lo: hex_value(raw[i + 1]) ?? return Err(HexError{reason: "invalid hex digit; expected 0-9, a-f, or A-F"})
        out.push(U8{hi * 16 + lo})
        i = i + 2
    }
    Ok(out)
}

// The failure text of `input.csv<Row>()` / `input.json<Row>()`
// (csv.__input_csv, json.__input_json): every FieldError of the input, one
// per line, under a head naming the `format`. They fail with it as an `Err`,
// so a script's `run: fn()` passes it up as it is.
__input_failure: fn(format: String, failures: [FieldError]) -> String Never! {
    shown := "the input is not {format} that decodes as the expected records:"
    loop failure in failures {
        at: if failure.path.is_empty() -> "" else -> "{failure.path}: "
        shown += "\n  {at}{failure.reason}"
    }
    shown
}

// Typed `tree.decode<T>()` of a container or F32 T with no Decode
// implementation of its own, and `FieldError.under`. JetIR calls these by name
// (BuildDyn.jet ir_dyn_decode, ir_decode_under); scalars cross the runtime's
// canonical jet_rt_codec_decode_* adapters instead. The generic parameter is
// not spelled `T` (see json.__decode_typed).

// `FieldError.under(segment, inner)`: every error of `inner` framed under
// `segment`; a success passes through.
__decode_under: fn<Item>(segment: String, inner: Item [FieldError]!) -> Item [FieldError]! {
    value: inner ?? return Err(loop error in err -> decode_under(segment, error))
    Ok(value)
}

// A List: each Array item decodes in order; a failing item's errors are
// framed under `[index]` and every failure fails the List.
__decode_list: fn<Item: Decode>(tree: Dyn) -> [Item] [FieldError]! {
    if tree == {
        .Array(items) -> {
            values := [Item]{}
            failures := [FieldError]{}
            loop (index, item) in items {
                if item.decode<Item>() == {
                    .Ok(value) -> values.push(value)
                    .Err(errors) -> loop error in errors -> failures.push(decode_under("[{index}]", error))
                }
            }
            if failures.len() > 0 -> return Err(failures)
            Ok(values)
        }
        else -> Err(decode_expected("a list", tree))
    }
}

// A fixed List `[Item#length]`: the List decode of exactly `length` items.
__decode_fixed_list: fn<Item: Decode>(tree: Dyn, length: Int) -> [Item] [FieldError]! {
    values: tree.decode<[Item]>() ?? return Err(err)
    if values.len() != length -> return Err([FieldError]{FieldError{path: "", reason: "expected a fixed list of length {length}, found {values.len()}"}})
    Ok(values)
}

// A byte List ([U8]) also takes Dyn.Bytes as is and Text as strict padded
// standard base64.
__decode_bytes: fn(tree: Dyn) -> [U8] [FieldError]! {
    if tree == {
        .Bytes(bytes) -> Ok(bytes.copy())
        .Text(text) -> {
            bytes: base64.decode(text) ?? return Err([FieldError]{FieldError{path: "", reason: err.reason}})
            Ok(bytes)
        }
        else -> __decode_list<U8>(tree)
    }
}

// An F32: a Float decode inside the F32 range.
__decode_f32: fn(tree: Dyn) -> F32 [FieldError]! {
    value: tree.decode<Float>() ?? return Err(err)
    single: F32.from_float(value) ?? return Err([FieldError]{FieldError{path: "", reason: "expected F32, found out-of-range Float"}})
    Ok(single)
}

// An Option: Null is None; any other value is Some of its decode, whose errors
// pass through unframed.
__decode_option: fn<Item: Decode>(tree: Dyn) -> Item? [FieldError]! {
    if tree == {
        .Null -> Ok(None)
        else -> {
            value: tree.decode<Item>() ?? return Err(err)
            Ok(Val(value))
        }
    }
}

// A String-keyed Map: each Object entry decodes in entry order (a repeated key
// keeps the later value); an entry's errors are framed under its key and every
// failure fails the Map.
__decode_map: fn<Item: Decode>(tree: Dyn) -> [String: Item] [FieldError]! {
    if tree == {
        .Object(entries) -> {
            values := [String: Item]{}
            failures := [FieldError]{}
            loop entry in entries {
                if entry.value.decode<Item>() == {
                    .Ok(value) -> values[entry.key] = value
                    .Err(errors) -> loop error in errors -> failures.push(decode_under(entry.key, error))
                }
            }
            if failures.len() > 0 -> return Err(failures)
            Ok(values)
        }
        else -> Err(decode_expected("an object", tree))
    }
}

// A Dyn target decodes as its own copy.
__decode_dyn: fn(tree: Dyn) -> Dyn [FieldError]! {
    Ok(tree.copy())
}

// The input of a typed decode, read in document order: the Dyn tree reader
// (`__DecodeTree`) and core.encoding.json's text cursor. A generated Decode
// reads a record's members through it, and `capture` hands one whole value to
// a type that decodes from a tree. Core-private.
__DecodeSource: trait {
    // Enters the Object at the cursor; false (nothing read) for any other value.
    begin_object: fn(&self) -> Bool Never!
    // Moves to the open Object's next member, its value at the cursor; false,
    // and the Object closed, after the last one.
    next_key: fn(&self) -> Bool Never!
    key_is: fn(self, name: String) -> Bool Never!
    key_text: fn(self) -> String Never!
    // Enters the Array at the cursor; false (nothing read) for any other value.
    begin_array: fn(&self) -> Bool Never!
    // Moves to the open Array's next item; false, and the Array closed,
    // after the last one.
    next_item: fn(&self) -> Bool Never!
    // Reads a Null at the cursor; false (nothing read) for any other value.
    take_null: fn(&self) -> Bool Never!
    // Reads past the value at the cursor.
    skip: fn(&self) Never!
    // The value at the cursor as its typed-decode tree.
    capture: fn(&self) -> Dyn Never!
    read_int: fn(&self) -> Int [FieldError]!
    read_bool: fn(&self) -> Bool [FieldError]!
    read_float: fn(&self) -> Float [FieldError]!
    read_string: fn(&self) -> String [FieldError]!
}

// Typed decode from a `__DecodeSource`, in
// document order. JetIR lowers `__Decoding.read<Target, Source>` by its target
// (BuildDyn.jet ir_decoding_read): a generated Decode's `__read`, a List,
// Option or String-keyed Map helper below, a scalar read, else this body,
// which decodes the value at the cursor as a tree. Each route returns what
// this body returns for the same input. The generic parameters are not
// spelled `T` (see json.__decode_typed).
__Decoding: struct {}

impl __Decoding {
    read: fn<Target: Decode, Source: __DecodeSource>(reader: &Source) -> Target [FieldError]! {
        value: reader.capture().decode<Target>() ?? return Err(err)
        Ok(value)
    }

    // __decode_list, item by item: a failing item's errors are framed under
    // `[index]`. Any value but an Array decodes as a tree, for its error.
    read_list: fn<Item: Decode, Source: __DecodeSource>(reader: &Source) -> [Item] [FieldError]! {
        if !reader.begin_array() {
            listed: reader.capture().decode<[Item]>() ?? return Err(err)
            return Ok(listed)
        }
        values := [Item]{}
        failures := [FieldError]{}
        index := 0
        loop reader.next_item() {
            if __Decoding.read<Item, Source>(reader) == {
                .Ok(value) -> values.push(value)
                .Err(errors) -> loop error in errors -> failures.push(decode_under("[{index}]", error))
            }
            index += 1
        }
        if failures.len() > 0 -> return Err(failures)
        Ok(values)
    }

    // __decode_option: Null is None; any other value is Some of its read,
    // whose errors pass through unframed.
    read_option: fn<Item: Decode, Source: __DecodeSource>(reader: &Source) -> Item? [FieldError]! {
        if reader.take_null() -> return Ok(None)
        value: __Decoding.read<Item, Source>(reader)
        Ok(Val(value))
    }

    // __decode_map, member by member: a repeated key keeps the later value and
    // an entry's errors are framed under its key. Any value but an Object
    // decodes as a tree, for its error.
    read_map: fn<Item: Decode, Source: __DecodeSource>(reader: &Source) -> [String: Item] [FieldError]! {
        if !reader.begin_object() {
            mapped: reader.capture().decode<[String: Item]>() ?? return Err(err)
            return Ok(mapped)
        }
        values := [String: Item]{}
        failures := [FieldError]{}
        loop reader.next_key() {
            key: reader.key_text()
            if __Decoding.read<Item, Source>(reader) == {
                .Ok(value) -> values[key] = value
                .Err(errors) -> loop error in errors -> failures.push(decode_under(key, error))
            }
        }
        if failures.len() > 0 -> return Err(failures)
        Ok(values)
    }

    read_int: fn<Source: __DecodeSource>(reader: &Source) -> Int [FieldError]! { reader.read_int() }
    read_bool: fn<Source: __DecodeSource>(reader: &Source) -> Bool [FieldError]! { reader.read_bool() }
    read_float: fn<Source: __DecodeSource>(reader: &Source) -> Float [FieldError]! { reader.read_float() }
    read_string: fn<Source: __DecodeSource>(reader: &Source) -> String [FieldError]! { reader.read_string() }
}

// A Dyn tree as a `__DecodeSource`: a generated Decode's `decode(tree)` reads
// the tree through its `__read`. A read at the cursor is `tree.decode<T>()`
// of the value there, and a repeated Object key's first value is the
// member's (`tree.field`). The open containers are a stack of the
// containers themselves and the position read in each.
__DecodeTree: struct {
    // The value at the cursor.
    pending: Dyn
    key: String
    open: [Dyn]
    at: [Int]
}

impl __DecodeTree {
    new: fn(tree: Dyn) -> __DecodeTree Never! {
        __DecodeTree{pending: tree.copy(), key: "", open: [Dyn]{}, at: [Int]{}}
    }

    enter: fn(&self) Never! {
        self.open.push(self.pending.copy())
        self.pending = Dyn.Null
        self.at.push(-1)
    }

    leave: fn(&self) Never! {
        _ := self.open.pop()
        _ := self.at.pop()
    }
}

impl __DecodeTree.__DecodeSource {
    begin_object: fn(&self) -> Bool Never! {
        object: if self.pending == {
            .Object(_) -> true
            else -> false
        }
        if object -> self.enter()
        object
    }

    next_key: fn(&self) -> Bool Never! {
        top: self.open.len() - 1
        if top < 0 -> return false
        position: self.at[top] + 1
        found := false
        key := ""
        value := Dyn.Null
        if self.open[top] == {
            .Object(entries) -> {
                if position < entries.len() {
                    key = entries[position].key.copy()
                    value = entries[position].value.copy()
                    found = true
                }
            }
            else -> {}
        }
        if !found {
            self.leave()
            return false
        }
        self.at[top] = position
        self.key = key
        self.pending = value
        true
    }

    key_is: fn(self, name: String) -> Bool Never! { self.key == name }

    key_text: fn(self) -> String Never! { self.key.copy() }

    begin_array: fn(&self) -> Bool Never! {
        array: if self.pending == {
            .Array(_) -> true
            else -> false
        }
        if array -> self.enter()
        array
    }

    next_item: fn(&self) -> Bool Never! {
        top: self.open.len() - 1
        if top < 0 -> return false
        position: self.at[top] + 1
        found := false
        value := Dyn.Null
        if self.open[top] == {
            .Array(items) -> {
                if position < items.len() {
                    value = items[position].copy()
                    found = true
                }
            }
            else -> {}
        }
        if !found {
            self.leave()
            return false
        }
        self.at[top] = position
        self.pending = value
        true
    }

    take_null: fn(&self) -> Bool Never! {
        if self.pending == {
            .Null -> true
            else -> false
        }
    }

    skip: fn(&self) Never! { self.pending = Dyn.Null }

    capture: fn(&self) -> Dyn Never! {
        value: self.pending.copy()
        self.pending = Dyn.Null
        value
    }

    read_int: fn(&self) -> Int [FieldError]! {
        value: self.pending.decode<Int>() ?? return Err(err)
        Ok(value)
    }

    read_bool: fn(&self) -> Bool [FieldError]! {
        value: self.pending.decode<Bool>() ?? return Err(err)
        Ok(value)
    }

    read_float: fn(&self) -> Float [FieldError]! {
        value: self.pending.decode<Float>() ?? return Err(err)
        Ok(value)
    }

    read_string: fn(&self) -> String [FieldError]! {
        value: self.pending.decode<String>() ?? return Err(err)
        Ok(value)
    }
}

// `error` framed under the path `segment`: an empty child path is the segment,
// an indexed child path joins without a dot.
decode_under: fn(segment: String, error: FieldError) -> FieldError Never! {
    path: if error.path == "" -> segment.copy() else if error.path.starts_with("[") -> "{segment}{error.path}" else -> "{segment}.{error.path}"
    FieldError{path: path, reason: error.reason.copy()}
}

// The one root failure "expected {expected}, found {kind}" (__dyn_kind).
decode_expected: fn(expected: String, tree: Dyn) -> [FieldError] Never! {
    [FieldError]{FieldError{path: "", reason: "expected {expected}, found {__dyn_kind(tree)}"}}
}

// The decode diagnostic's name for a Dyn variant: the one dyn_kind
// vocabulary. Time and Math decodes report through it, and
// Tools/agent/RuntimeGenerators.jet generates the runtime's and the web
// tier's tables from these arms.
__dyn_kind: fn(tree: Dyn) -> String Never! {
    if tree == {
        .Null -> "Null"
        .Bool(_) -> "Bool"
        .Int(_) -> "Int"
        .Float(_) -> "Float"
        .Number(_) -> "number"
        .Text(_) -> "Text"
        .Bytes(_) -> "Bytes"
        .DateTime(_) -> "DateTime"
        .Array(_) -> "a list"
        .Object(_) -> "an object"
    }
}

/// 32-bit wrap used by hashes and CBOR integer codecs. Jet `Int` is exact; mask
/// after arithmetic to get machine-word wrapping without a second integer type.
wrap32: fn(n: Int) -> Int Never! { n.bit_and(4294967295) }

#Test("every Dyn variant has one decode kind in Core and in the runtime scalar decodes") {
    stamp: Dyn.DateTime(time.zoned(time.from_unix_seconds(0), time.utc()))
    number: stream.typed_number("1")
    trees: [(tree: Dyn, kind: String)]{
        (tree: Dyn.Null, kind: "Null"), (tree: Dyn.Bool(true), kind: "Bool"), (tree: Dyn.Int(1), kind: "Int"),
        (tree: Dyn.Float(1.5), kind: "Float"), (tree: number, kind: "number"), (tree: Dyn.Text("a"), kind: "Text"),
        (tree: Dyn.Bytes([U8]{1}), kind: "Bytes"), (tree: stamp, kind: "DateTime"),
        (tree: Dyn.Array([Dyn]{}), kind: "a list"), (tree: Dyn.object(), kind: "an object")
    }
    loop entry in trees {
        assert_eq(__dyn_kind(entry.tree), entry.kind)
        if entry.tree.decode<[Int]>() == {
            .Err(errors) -> assert_eq(errors[0].reason, "expected a list, found {entry.kind}")
            .Ok(_) -> assert_eq(entry.kind, "a list")
        }
        if entry.tree.decode<[String: Int]>() == {
            .Err(errors) -> assert_eq(errors[0].reason, "expected an object, found {entry.kind}")
            .Ok(_) -> assert_eq(entry.kind, "an object")
        }
        // The runtime's Bool decode names a Text leaf by its Debug text.
        if entry.kind != "Text" {
            if entry.tree.decode<Bool>() == {
                .Err(errors) -> assert_eq(errors[0].reason, "expected Bool, found {entry.kind}")
                .Ok(_) -> assert_eq(entry.kind, "Bool")
            }
        }
    }
}

