package {
    name: "core.encoding"
    version: "0.0.1"
    edition: "2026"
    description: "Codecs and the shared Dyn interchange model."
    license: "MIT"
    outputs: {
        encoding: .Library{ entry: encoding }
    }
}
// core.encoding — interchange codecs and the one dynamic value tree.
//
// Every format in this package speaks the same two verbs: `parse` (text or
// bytes → `Dyn`) and `to_string` / `to_bytes` (value → wire). JSON, JSONL
// CSV, TOML, YAML, XML, and CBOR are nested modules so a program pays only for
// the format it imports. Hex, Base32, and Base64 are byte alphabets, not
// Dyn adapters; they live beside the formats because they are the usual
// way to carry those bytes through text.
//
// This is compiler-owned Core source and is loaded as the `core.encoding`
// package entry. Its nested modules share the carriers below; only narrow
// host capabilities (for example filesystem reads requested by a public
// query API) remain effectful.
// Portable codecs below are written in Jet.
//
// Invariants:
// - `Dyn` is the only user-facing dynamic tree. There is no `Data` alias.
// - Objects keep insertion order. Integers and floats stay distinct variants.
// - The closed cases are Null, Bool, Int, Float, Text, Bytes, DateTime, Array,
//   and Object. Bytes text is padded RFC 4648 base64; DateTime text is canonical
//   RFC 3339 with a fixed offset. TOML/YAML/CBOR retain their native kinds;
//   JSON/JSONL/CSV render them as text. XML retains its separate node schema.
// - No codec fabricates a value for malformed input. Syntax problems are
//   `EncodingError`; alphabet helpers use their local typed errors.
// - Whole-value codecs are pure (`->`) and callers pass text or bytes directly.
module hex

module base32

module base64

module json

module jsonl

module csv
module toml
module yaml

module xml

module cbor

module binary

module ini

use core.encoding.base64 as base64

/// Handle-free streaming events. Number is public; writers reject it as Unsupported.
enum DataEvent {
    Null
    Bool(Bool)
    Int(Int)
    Float(Float)
    Number(String)
    Text(String)
    Bytes([U8])
    ArrayStart
    ArrayEnd
    ObjectStart
    Key(String)
    ObjectEnd
}

#Equatable
enum EncodingFormat {
    JSON
    JSONL
    CSV
    TOML
    YAML
    XML
    CBOR
}
impl EncodingFormat {
    fn as_str(self) -> String Never! {
        if self == {
            .JSON -> "JSON"
            .JSONL -> "JSONL"
            .CSV -> "CSV"
            .TOML -> "TOML"
            .YAML -> "YAML"
            .XML -> "XML"
            .CBOR -> "CBOR"
        }
    }
}

#Equatable
enum EncodingErrorKind {
    Syntax
    Truncated
    Unsupported
    Limit
    IO
    State
}
fn encoding_kind_name(kind: EncodingErrorKind) -> String Never! {
    if kind == {
        .Syntax -> "Syntax"
        .Truncated -> "Truncated"
        .Unsupported -> "Unsupported"
        .Limit -> "Limit"
        .IO -> "IO"
        .State -> "State"
    }
}

#Equatable
struct EncodingCause {
    kind: String
    os_code: Int?
    message: String
}

/// The same location ladder used by the seed encoding error kernel.
fn encoding_error_text(format: String, kind: String, byte_offset: Int, line: Int?, column: Int?, path: String, reason: String) -> String Never! {
    out := "{format} {kind} at byte {byte_offset}"
    if line == {
        Val(value) -> out = "{out}, line {value}"
        None -> {}
    }
    if column == {
        Val(value) -> out = "{out}, column {value}"
        None -> {}
    }
    if path != "" -> out = "{out}, path {path}"
    "{out}: {reason}"
}

#[Error, Equatable]
struct EncodingError {
    format: EncodingFormat
    kind: EncodingErrorKind
    byte_offset: Int
    line: Int?
    column: Int?
    path: String
    reason: String
    cause: EncodingCause?
    impl Display {
        fn display(self) -> String { self.display_text() }
    }
    impl Debug {
        fn debug(^self) -> String { self.display_text() }
    }
}
impl EncodingError {
    fn new(format: EncodingFormat, kind: EncodingErrorKind, byte_offset: Int, line: Int?, column: Int?, path: String, reason: String) -> EncodingError Never! {
        EncodingError{format: format, kind: kind, byte_offset: byte_offset, line: line, column: column, path: path, reason: reason, cause: None}
    }
    fn with_cause(self, cause: EncodingCause) -> EncodingError Never! {
        EncodingError{format: self.format, kind: self.kind, byte_offset: self.byte_offset, line: self.line, column: self.column, path: self.path.copy(), reason: self.reason.copy(), cause: Val(cause)}
    }
    fn cause(self) -> EncodingCause? Never! { self.cause.copy() }
    fn display_text(self) -> String Never! {
        encoding_error_text(self.format.as_str(), encoding_kind_name(self.kind), self.byte_offset, self.line, self.column, self.path, self.reason)
    }
}

#Equatable
struct EncodingLimits {
    buffer_bytes: Int
    max_depth: Int
    max_item_bytes: Int
    max_total_bytes: Int?
    max_expansion_depth: Int
    max_expansion_bytes: Int
}
impl EncodingLimits {
    fn safe() -> EncodingLimits Never! {
        EncodingLimits{buffer_bytes: 65536, max_depth: 256, max_item_bytes: 16777216, max_total_bytes: None, max_expansion_depth: 32, max_expansion_bytes: 8388608}
    }
}

/// Error returned by the root hexadecimal decoder.
#Error
struct HexError {
    reason: String
    impl Display {
        fn display(self) -> String { self.reason }
    }
    impl Debug {
        fn debug(^self) -> String { self.reason }
    }
}
impl HexError {
    fn new(reason: String) -> HexError Never! { HexError{reason: reason} }
}
/// Convert one nibble to lowercase ASCII. Callers must pass `0..15`.
fn hex_nibble(n: Int) -> U8 Never! {
    if n < 10 -> return (U8{48 + n})
    (U8{87 + n})
}

/// Hex alphabet lookup. Accepts `0-9A-Fa-f`. Other bytes are absent.
fn hex_value(b: U8) -> Int? Never! {
    n :: Int.from_u8(b)
    if n >= 48 && n <= 57 -> return Val(n - 48)
    if n >= 97 && n <= 102 -> return Val(n - 87)
    if n >= 65 && n <= 70 -> return Val(n - 55)
    None
}

/// Lowercase hex of `bytes`. Allocates `2 * bytes.len()` ASCII bytes.
fn bytes_to_hex(bytes: [U8]) -> String Never! {
    out := [U8]{}
    loop b in bytes {
        n :: Int.from_u8(b)
        &out.push(hex_nibble(n /% 16))
        &out.push(hex_nibble(n %% 16))
    }
    String.from_bytes(out) ?? ""
}

/// Decode a hex string into bytes. Whitespace is rejected; length must be even.
fn hex_to_bytes(text: String) -> [U8] HexError! {
    raw :: text.bytes()
    if raw.len() %% 2 != 0 {
        return Err(HexError{reason: "odd-length hex string; hex text encodes whole bytes, so the length must be even"})
    }
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        hi :: hex_value(raw[i]) ?? return Err(HexError{reason: "invalid hex digit; expected 0-9, a-f, or A-F"})
        lo :: hex_value(raw[i + 1]) ?? return Err(HexError{reason: "invalid hex digit; expected 0-9, a-f, or A-F"})
        &out.push(U8{hi * 16 + lo})
        i = i + 2
    }
    Ok(out)
}

// Typed `tree.decode<T>()` of a container T with no Decode implementation of
// its own (Rust EncodingTraits.rs:457-535), and `FieldError.under`. JetIR
// calls these by name (BuildDyn.jet ir_dyn_decode, ir_decode_under); scalars
// cross the runtime's canonical jet_rt_codec_decode_* adapters instead. The
// generic parameter is not spelled `T` (see json.__decode_typed).

// `FieldError.under(segment, inner)`: every error of `inner` framed under
// `segment`; a success passes through.
fn __decode_under<Item>(segment: String, inner: Item [FieldError]!) -> Item [FieldError]! {
    value :: inner ?? return Err(loop error in err -> decode_under(segment, error))
    Ok(value)
}

// A List: each Array item decodes in order; a failing item's errors are
// framed under `[index]` and every failure fails the List.
fn __decode_list<Item: Decode>(tree: Dyn) -> [Item] [FieldError]! {
    if tree == {
        .Array(items) -> {
            values := [Item]{}
            failures := [FieldError]{}
            loop (index, item) in items {
                if item.decode<Item>() == {
                    .Ok(value) -> &values.push(value)
                    .Err(errors) -> loop error in errors -> &failures.push(decode_under("[{index}]", error))
                }
            }
            if failures.len() > 0 -> return Err(failures)
            Ok(values)
        }
        else -> Err(decode_expected("a list", tree))
    }
}

// A byte List ([U8], EncodingTraits.rs:457-478) also takes Dyn.Bytes as is
// and Text as strict padded standard base64.
fn __decode_bytes(tree: Dyn) -> [U8] [FieldError]! {
    if tree == {
        .Bytes(bytes) -> Ok(bytes.copy())
        .Text(text) -> {
            bytes :: base64.decode(text) ?? return Err([FieldError]{FieldError{path: "", reason: err.reason}})
            Ok(bytes)
        }
        else -> __decode_list<U8>(tree)
    }
}

// An Option (EncodingTraits.rs:494-501): Null is None; any other value is
// Some of its decode, whose errors pass through unframed.
fn __decode_option<Item: Decode>(tree: Dyn) -> Item? [FieldError]! {
    if tree == {
        .Null -> Ok(None)
        else -> {
            value :: tree.decode<Item>() ?? return Err(err)
            Ok(Val(value))
        }
    }
}

// A String-keyed Map (EncodingTraits.rs:502-535): each Object entry decodes in
// entry order (a repeated key keeps the later value); an entry's errors are
// framed under its key and every failure fails the Map.
fn __decode_map<Item: Decode>(tree: Dyn) -> [String: Item] [FieldError]! {
    if tree == {
        .Object(entries) -> {
            values := [String: Item]{}
            failures := [FieldError]{}
            loop entry in entries {
                if entry.value.decode<Item>() == {
                    .Ok(value) -> values[entry.key] = value
                    .Err(errors) -> loop error in errors -> &failures.push(decode_under(entry.key, error))
                }
            }
            if failures.len() > 0 -> return Err(failures)
            Ok(values)
        }
        else -> Err(decode_expected("an object", tree))
    }
}

// A Dyn target decodes as its own copy (EncodingTraits.rs:491-493).
fn __decode_dyn(tree: Dyn) -> Dyn [FieldError]! {
    Ok(tree.copy())
}

// `error` framed under the path `segment` (FieldError.rs:18-26): an empty
// child path is the segment, an indexed child path joins without a dot.
fn decode_under(segment: String, error: FieldError) -> FieldError Never! {
    path :: if error.path == "" -> segment.copy() else if error.path.starts_with("[") -> "{segment}{error.path}" else -> "{segment}.{error.path}"
    FieldError{path: path, reason: error.reason.copy()}
}

// The one root failure "expected {expected}, found {kind}", with the
// DynKind.rs dyn_kind vocabulary.
fn decode_expected(expected: String, tree: Dyn) -> [FieldError] Never! {
    kind :: if tree == {
        .Null -> "null"
        .Bool(_) -> "Bool"
        .Int(_) -> "Int"
        .Float(_) -> "Float"
        .Number(_) -> "number"
        .Text(_) -> "Text"
        .Bytes(_) -> "Bytes"
        .DateTime(_) -> "DateTime"
        .Array(_) -> "a list"
        .Object(_) -> "an object"
    }
    [FieldError]{FieldError{path: "", reason: "expected {expected}, found {kind}"}}
}

/// 32-bit wrap used by hashes and CBOR integer codecs. Jet `Int` is exact; mask
/// after arithmetic to get machine-word wrapping without a second integer type.
fn wrap32(n: Int) -> Int Never! { n.bit_and(4294967295) }


