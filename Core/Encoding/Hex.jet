use core as core
use core.encoding as encoding
use core.archive as archive
use core.encoding.base64 as base64

// Both public spellings name one error type.
alias HexError :: encoding.HexError

// core.encoding.hex — RFC 4648 §8 hexadecimal alphabet.
//
// `encode` always emits lowercase `0-9a-f` with no whitespace, no `0x` prefix
// and no separators. `decode` accepts mixed case and rejects every other byte
// including whitespace and an odd number of digits. There is no ignore-whitespace
// mode; strip input first if a wire format wrapped the hex.
//

// Both functions are pure. `encode` allocates `2 * data.len()` bytes of ASCII.
fn u8_int(b: U8) -> Int Never! { Int.from_u8(b) }


/// Encode `data` as lowercase hexadecimal text.
fn encode(data: [U8]) -> String Never! { encoding.bytes_to_hex(data) }

/// Decode hexadecimal text into bytes. Fails when the length is odd or a digit
/// is outside `0-9A-Fa-f`.
fn decode(text: String) -> [U8] HexError! { encoding.hex_to_bytes(text) }

fn digit(b: U8) -> Int? {
    n :: u8_int(b)
    if n >= 48 && n <= 57 -> return Val(n - 48)
    if n >= 97 && n <= 102 -> return Val(n - 87)
    if n >= 65 && n <= 70 -> return Val(n - 55)
    None
}

fn encode_upper(data: [U8]) -> String Never! {
    out := [U8]{}
    loop b in data {
        n :: u8_int(b)
        &out.push(nibble_upper(n >> 4))
        &out.push(nibble_upper(n.bit_and(15)))
    }
    String.from_bytes(out) ?? ""
}

fn encode_prefixed(data: [U8]) -> String Never! { "0x{encode(data)}" }

fn is_hex(text: String) -> Bool Never! {
    raw :: text.bytes()
    if raw.len() == 0 || raw.len() %% 2 != 0 -> return false
    loop b in raw {
        if digit(b) == None -> return false
    }
    true
}

fn nibble_upper(n: Int) -> U8 {
    if n < 10 -> return (U8{48 + n})
    (U8{55 + n})
}

/// Python `binascii.hexlify`.
fn hexlify(data: [U8]) -> String Never! { encode(data) }

/// Python `binascii.unhexlify`.
fn unhexlify(text: String) -> [U8] HexError! { decode(text) }

fn b2a_hex(data: [U8]) -> String Never! { encode(data) }

fn a2b_hex(text: String) -> [U8] HexError! { decode(text) }

/// Python `binascii.b2a_base64`: one unwrapped standard Base64 line.
fn b2a_base64(data: [U8]) -> String Never! { "{core.encoding.base64.encode(data)}\n" }

fn a2b_base64(text: String) -> [U8] HexError! {
    if base64.decodebytes(text) == {
        .Ok(value) -> return Ok(value)
        .Err(error) -> return Err(HexError{reason: error.reason})
    }
}

/// Python `binascii.crc_hqx` (CRC-CCITT).
fn crc_hqx(data: [U8], value: Int) -> Int Never! {
    crc := value.bit_and(65535)
    loop b in data {
        crc = crc.bit_xor((u8_int(b) << 8))
        loop _ in 0..<8 {
            if crc.bit_and(32768) != 0 -> crc = ((crc << 1).bit_xor(4129)).bit_and(65535) else {
                crc = (crc << 1).bit_and(65535)
            }
        }
    }
    crc
}

/// Python `binascii.crc32` (ISO 3309, non-negative result).
fn crc32(data: [U8]) -> Int Never! { archive.crc32(data) }

/// Python `binascii.b2a_qp` basic text form.
fn b2a_qp(data: [U8]) -> String Never! {
    out := ""
    loop byte in data {
        n :: u8_int(byte)
        if {
            n == 10 -> { out = "{out}\n" }
            (n >= 33 && n <= 60) || (n >= 62 && n <= 126) || n == 32 || n == 9 -> {
                out = "{out}{String.from_bytes([U8]{byte}) ?? ""}"
            }
            else -> { out = "{out}={qp_hex(n /% 16)}{qp_hex(n %% 16)}" }
        }
    }
    out
}

fn a2b_qp(text: String) -> [U8] Never! {
    raw :: text.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{61}) && i + 2 < raw.len() {
            if raw[i + 1] == (U8{10}) {
                i = i + 2
                next
            }
            hi :: digit(raw[i + 1]) ?? {
                &out.push(raw[i])
                i = i + 1
                next
            }
            lo :: digit(raw[i + 2]) ?? {
                &out.push(raw[i])
                i = i + 1
                next
            }
            &out.push(U8{hi * 16 + lo})
            i = i + 3
            next
        }
        &out.push(raw[i])
        i = i + 1
    }
    out
}

fn b2a_uu(data: [U8]) -> String Never! {
    out := ""
    i := 0
    if data.len() == 0 -> return "{uu_char(0)}\n"
    loop i < data.len() {
        count := data.len() - i
        if count > 45 -> count = 45
        out = "{out}{uu_char(count)}"
        j := 0
        loop j < count {
            pos :: i + j
            a :: u8_int(data[pos])
            b :: if j + 1 < count -> u8_int(data[pos + 1]) else -> 0
            c :: if j + 2 < count -> u8_int(data[pos + 2]) else -> 0
            out = "{out}{uu_char(a >> 2)}{uu_char(((((a << 4)).bit_xor((b >> 4)))).bit_and(63))}{uu_char(((((b << 2)).bit_xor((c >> 6)))).bit_and(63))}{uu_char((c).bit_and(63))}"
            j += 3
        }
        out = "{out}\n"
        i += count
    }
    out
}

fn a2b_uu(text: String) -> [U8] Never! {
    raw :: text.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{10}) || raw[i] == (U8{13}) {
            i += 1
            next
        }
        count := uu_value(raw[i])
        i += 1
        if count < 0 || count > 45 -> break
        groups := (count + 2) /% 3
        needed := groups * 4
        if i + needed > raw.len() -> break
        produced := 0
        loop produced < count {
            a :: uu_value(raw[i])
            b :: uu_value(raw[i + 1])
            c :: uu_value(raw[i + 2])
            d :: uu_value(raw[i + 3])
            &out.push(to_u8(((a << 2)).bit_xor((b >> 4))))
            produced += 1
            if produced < count {
                &out.push(to_u8(((b << 4)).bit_xor((c >> 2))))
                produced += 1
            }
            if produced < count {
                &out.push(to_u8(((c << 6)).bit_xor(d)))
                produced += 1
            }
            i += 4
        }
        loop i < raw.len() && raw[i] != (U8{10}) && raw[i] != (U8{13}) -> i += 1
    }
    out
}
fn qp_hex(n: Int) -> U8 { nibble_upper(n) }

fn uu_char(n: Int) -> U8 {
    if n == 0 -> return (U8{96})
    U8{32 + ((n).bit_and(63))}
}

fn uu_value(byte: U8) -> Int {
    n :: u8_int(byte)
    if n == 96 -> return 0
    ((n - 32)).bit_and(63)
}

fn encode_sep(data: [U8], sep: String) -> String Never! {
    out := [U8]{}
    separator :: sep.bytes()
    loop i in 0..<data.len() {
        if i > 0 {
            loop b in separator -> &out.push(b)
        }
        n :: u8_int(data[i])
        &out.push(encoding.hex_nibble(n >> 4))
        &out.push(encoding.hex_nibble(n.bit_and(15)))
    }
    String.from_bytes(out) ?? ""
}

/// 16-byte rows of offset, hex, and ASCII. Unprintable bytes become `.`.
fn dump(data: [U8]) -> String Never! {
    out := [U8]{}
    offset := 0
    shifts :: [Int]{28, 24, 20, 16, 12, 8, 4, 0}
    loop offset < data.len() {
        loop shift in shifts {
            &out.push(encoding.hex_nibble((offset >> shift).bit_and(15)))
        }
        &out.push(U8{32})
        &out.push(U8{32})
        loop i in 0..<16 {
            if i > 0 -> &out.push(U8{32})
            if offset + i < data.len() {
                n :: u8_int(data[offset + i])
                &out.push(encoding.hex_nibble(n >> 4))
                &out.push(encoding.hex_nibble(n.bit_and(15)))
            } else {
                &out.push(U8{32})
                &out.push(U8{32})
            }
        }
        &out.push(U8{32})
        &out.push(U8{32})
        end := offset + 16
        if end > data.len() -> end = data.len()
        loop i in offset..<end {
            n :: u8_int(data[i])
            if n >= 32 && n <= 126 -> &out.push(data[i])
            else -> &out.push(U8{46})
        }
        &out.push(U8{10})
        offset += 16
    }
    String.from_bytes(out) ?? ""
}

/// Low byte of `n`. The mask runs in `Int`, so a wide value never reaches the
/// checked `U8{}` conversion.
fn to_u8(n: Int) -> U8 Never! {
    v :: (n).bit_and(255)
    (U8{v})
}

#Test("hex kernel vectors") {
    assert(encode([U8]{0, 15, 16, 255}) == "000f10ff")
    assert(encode_upper([U8]{10, 255}) == "0AFF")
    decoded :: decode("aF00") ?? panic("valid hex")
    assert(decoded == [U8]{175, 0})
    if decode("f") == {
        .Ok(_) -> panic("odd-length hex accepted")
        .Err(error) -> assert(error.reason == "odd-length hex string; hex text encodes whole bytes, so the length must be even")
    }
    if decode("xz") == {
        .Ok(_) -> panic("invalid hex digit accepted")
        .Err(error) -> assert(error.reason == "invalid hex digit; expected 0-9, a-f, or A-F")
    }
    assert(!is_hex(""))
    assert(!is_hex("0"))
    assert(is_hex("aF"))
    assert(encode_sep([U8]{0, 255}, ":") == "00:ff")
    assert(crc_hqx("123456789".bytes(), 0) == 12739)
    assert(crc32("123456789".bytes()) == 3421780262)
    assert(dump([U8]{}) == "")
    assert(dump([U8]{65}) == "00000000  41                                               A\n")
}
