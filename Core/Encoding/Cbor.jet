use {
    core: core
    // Whole-value and bounded streaming CBOR; typed `decode<T>` reads the parsed tree.
    core.encoding.[Dyn, DataEvent, EncodingError, EncodingLimits]
    stream: __core_encoding_stream
    math: core.math
    parser: __core_encoding_cbor_parse
    codec: __core_encoding_cbor_stream
    core.files.[FileReader, FileWriter]
    typed_errors.[typed_parse_error]
}

CBORReader: struct {
    input: codec.CBORPull

    next: fn(&self) -[IO, Time.Wait]> DataEvent? EncodingError! { self.input.next() }
}

CBORWriter: struct {
    output: codec.CBORPush

    write: fn(&self, event: &&DataEvent) EncodingError! -[IO, Time.Wait]> { self.output.write(event) }
    flush: fn(&self) EncodingError! -[IO, Time.Wait]> { self.output.flush() }
    finish: fn(&self) EncodingError! -[IO, Time.Wait]> { self.output.finish() }
}

reader: fn(input: &&FileReader, limits: EncodingLimits{EncodingLimits.safe()}) -[FS]> CBORReader EncodingError! {
    source: codec.reader(input, limits) ?? return Err(err)
    Ok(CBORReader{input: source.move()})
}

writer: fn(output: &&FileWriter, limits: EncodingLimits{EncodingLimits.safe()}) -[FS]> CBORWriter EncodingError! {
    target: codec.writer(output, limits) ?? return Err(err)
    Ok(CBORWriter{output: target.move()})
}

#Equatable
CBOROptions: struct {
    max_depth: Int
    max_items: Int
    max_bytes: Int
    require_canonical: Bool
}
impl CBOROptions {
    safe: fn() -> CBOROptions Never! {
        CBOROptions{max_depth: 256, max_items: 1000000, max_bytes: 1073741824, require_canonical: false}
    }
}
#Equatable
CBORErrorKind: enum {
    Syntax
    Truncated
    Unsupported
    Limit
    TypeMismatch
    TrailingData
    NonCanonical
}
#[Error, Equatable]
CBORError: struct {
    kind: CBORErrorKind
    byte_offset: Int
    path: String
    reason: String
    impl Display {
        display: fn(self) -> String { self.display_text() }
    }
    impl Debug {
        debug: fn(&&self) -> String { self.display_text() }
    }
}
impl CBORError {
    kind_name: fn(self) -> String Never! {
        if self.kind == {
            .Syntax -> "Syntax"
            .Truncated -> "Truncated"
            .Unsupported -> "Unsupported"
            .Limit -> "Limit"
            .TypeMismatch -> "TypeMismatch"
            .TrailingData -> "TrailingData"
            .NonCanonical -> "NonCanonical"
        }
    }
    display_text: fn(self) -> String Never! {
        out := "CBOR {self.kind_name()} at byte {self.byte_offset}"
        if self.path != "" -> out = "{out}, path {self.path}"
        "{out}: {self.reason}"
    }
}


to_bytes: fn<T: Encode>(value: T) -> [U8] CBORError! { encode(value.encode(), false) }
to_bytes_canonical: fn<T: Encode>(value: T) -> [U8] CBORError! { encode(value.encode(), true) }

unsupported: fn(path: String, reason: String) -> CBORError Never! {
    CBORError{kind: .Unsupported, byte_offset: 0, path: path, reason: reason}
}

validate: fn(value: Dyn, path: String) CBORError! {
    #Unsafe("inspect private typed carriers without changing public Dyn variants") {
        if value == {
            .Number(_) -> {
                if value.decode<Int>() == .Err(_) {
                    number: value.decode<Float>() ?? return Err(unsupported(path, "number {value} is outside the CBOR Int and float64 range"))
                    if !math.is_finite(number) -> return Err(unsupported(path, "number {value} is outside the CBOR Int and float64 range"))
                }
            }
            .Array(items) -> {
                loop i in 0..<items.len() -> validate(items[i], "{path}[{i}]") ?? return Err(err)
            }
            .Object(_) -> {
                loop entry in stream.object_entries(value) -> validate(entry.value, "{path}[{entry.key:Debug}]") ?? return Err(err)
            }
            .Null | .Bool(_) | .Int(_) | .Float(_) | .Text(_) | .Bytes(_) | .DateTime(_) -> {}
        }
    }
}

encode: fn(value: Dyn, canonical: Bool) -> [U8] CBORError! {
    validate(value, "$") ?? return Err(err)
    out := [U8]{}
    encode_value(value, out, canonical) ?? return Err(err)
    Ok(out)
}

append_uint: fn(out: &[U8], value: Int, width: Int) Never! {
    loop i in 0..<width -> out.push(U8{(value >> ((width - i - 1) * 8)).bit_and(255)})
}

append_length: fn(out: &[U8], major: Int, value: Int) Never! {
    if value < 24 -> out.push(U8{(major << 5).bit_or(value)})
    else {
        width: if value <= 255 -> 1 else if value <= 65535 -> 2 else if value <= 4294967295 -> 4 else -> 8
        additional: if width == 1 -> 24 else if width == 2 -> 25 else if width == 4 -> 26 else -> 27
        out.push(U8{(major << 5).bit_or(additional)})
        append_uint(out, value, width)
    }
}


append_float: fn(out: &[U8], value: Float) Never! {
    bits: math.to_bits(value)
    if parser.narrow_bits(bits, 5, 10) == .Val(half) {
        out.push(U8{249})
        append_uint(out, half, 2)
    } else if parser.narrow_bits(bits, 8, 23) == .Val(single) {
        out.push(U8{250})
        append_uint(out, single, 4)
    } else {
        out.push(U8{251})
        append_uint(out, bits, 8)
    }
}

key_before: fn(left: String, right: String) -> Bool Never! {
    a: left.bytes()
    b: right.bytes()
    if a.len() != b.len() -> return a.len() < b.len()
    loop i in 0..<a.len() {
        if a[i] != b[i] -> return a[i] < b[i]
    }
    false
}

encode_value: fn(value: Dyn, out: &[U8], canonical: Bool) CBORError! {
    #Unsafe("validated private carriers retain byte strings for typed Encode") {
        if value == {
            .Null -> out.push(U8{246})
            .Bool(b) -> out.push(if b -> U8{245} else -> U8{244})
            // An Int past major types 0 and 1 is a bignum: tag 2 or 3 over
            // its big-endian magnitude (parser.bignum_bytes).
            .Int(n) -> {
                if parser.integer_fits(n) {
                    if n >= 0 -> append_length(out, 0, n)
                    else -> append_length(out, 1, -(n + 1))
                } else {
                    out.push(parser.bignum_head(n))
                    magnitude: parser.bignum_bytes(parser.bignum_magnitude(n))
                    append_length(out, 2, magnitude.len())
                    loop byte in magnitude -> out.push(byte)
                }
            }
            .Float(n) -> append_float(out, n)
            // A validated Number lexeme is its exact Int when integral, else its float64.
            .Number(_) -> {
                if value.decode<Int>() == {
                    .Ok(n) -> encode_value(Dyn.Int(n), out, canonical) ?? return Err(err)
                    .Err(_) -> append_float(out, value.decode<Float>() ?? return Err(unsupported("$", "number {value} is outside the CBOR Int and float64 range")))
                }
            }
            .Text(text) -> {
                bytes: text.bytes()
                append_length(out, 3, bytes.len())
                loop byte in bytes -> out.push(byte)
            }
            .Bytes(bytes) -> {
                append_length(out, 2, bytes.len())
                loop byte in bytes -> out.push(byte)
            }
            // DateTime is tag 0 over its RFC 3339 text.
            .DateTime(_) -> {
                out.push(U8{192})
                encode_value(Dyn.Text(value.to_text() ?? ""), out, canonical) ?? return Err(err)
            }
            .Array(items) -> {
                append_length(out, 4, items.len())
                loop item in items -> encode_value(item, out, canonical) ?? return Err(err)
            }
            .Object(_) -> {
                entries: stream.object_entries(value)
                loop i in 0..<entries.len() {
                    loop j in 0..<i {
                        if entries[j].key == entries[i].key -> return Err(unsupported("$", "duplicate encoded CBOR map key"))
                    }
                }
                append_length(out, 5, entries.len())
                if canonical {
                    order := [Int]{}
                    loop i in 0..<entries.len() {
                        order.push(i)
                        j := order.len() - 1
                        loop j > 0 && key_before(entries[order[j]].key, entries[order[j - 1]].key) {
                            // Snapshot the indexed value before mutating its owner.
                            // A read binding here retains a borrow of order[j - 1].
                            old: order[j - 1].copy()
                            order[j - 1] = order[j]
                            order[j] = old
                            j -= 1
                        }
                    }
                    loop i in order {
                        encode_value(Dyn.Text(entries[i].key), out, canonical) ?? return Err(err)
                        encode_value(entries[i].value, out, canonical) ?? return Err(err)
                    }
                } else {
                    loop entry in entries {
                        encode_value(Dyn.Text(entry.key), out, canonical) ?? return Err(err)
                        encode_value(entry.value, out, canonical) ?? return Err(err)
                    }
                }
            }
        }
    }
}

#Test("CBOR preferred float widths and integer encoding") {
    assert_eq(to_bytes(Dyn.Null) ?? panic("null encodes"), [U8]{246})
    assert_eq(to_bytes(Dyn.Int(-1)) ?? panic("-1 encodes"), [U8]{32})
    assert_eq(to_bytes(Dyn.Int(256)) ?? panic("256 encodes"), [U8]{25, 1, 0})
    assert_eq(to_bytes(Dyn.Float(Float{1.5})) ?? panic("1.5 encodes"), [U8]{249, 62, 0})
    assert_eq(parser.narrow_bits(4607182418800017408, 5, 10), Val(15360))
}

parse: fn(bytes: [U8], options: CBOROptions{CBOROptions{max_depth: 256, max_items: 1000000, max_bytes: 1073741824, require_canonical: false}}) -> Dyn CBORError! {
    parser.parse(bytes, options)
}

// Typed `decode<T>(bytes)`: the parsed tree decodes into the target. A parse
// failure is one FieldError at the failing item, its path spelled as the
// decoder spells paths (`$["id"]` reads `["id"]`). The parameter is not
// spelled `T`: explicit-argument inference binds by name, so a generic
// caller's `decode<[T]>` would read as `T := [T]`.
decode: fn<Target: Decode>(bytes: [U8], options: CBOROptions{CBOROptions.safe()}) -> Target [FieldError]! {
    tree: parser.parse(bytes, options) ?? return Err([FieldError]{typed_parse_error(err)})
    value: tree.decode<Target>() ?? return Err(err)
    Ok(value)
}

// The parse failure behind `decode<T>`, as one FieldError: not part of the
// cbor surface.
priv typed_errors: module {
    typed_parse_error: fn(error: CBORError) -> FieldError Never! {
        FieldError{path: error.path.removeprefix("$"), reason: "CBOR {error.kind_name()} at byte {error.byte_offset}: {error.reason}"}
    }
}

#Test("CBOR whole-value parser preserves limits and indefinite forms") {
    assert((parse([U8]{24, 24}) ?? panic("one-byte uint parses")) == Dyn.Int(24))
    assert((parse([U8]{159, 1, 2, 255}) ?? panic("indefinite array parses")) == Dyn.Array([Dyn]{Dyn.Int(1), Dyn.Int(2)}))
    assert((parse([U8]{249, 62, 0}) ?? panic("half float parses")) == Dyn.Float(Float{1.5}))
    assert((parse([U8]{65, 0}) ?? panic("byte string parses")) == Dyn.Bytes([U8]{0}))
    if parse([U8]{1, 2}) == .Err(error) -> assert(error.kind == .TrailingData) else -> panic("trailing root accepted")
}

#Test("CBOR major types 0 and 1 stay exact Ints out to 2^64-1 and -2^64, and wide Int trees compare equal") {
    // #4362: 2^63 and 2^64-1 decode exactly into the one `Dyn.Int` case.
    assert((parse([U8]{27, 128, 0, 0, 0, 0, 0, 0, 0}) ?? panic("2^63 parses")) == Dyn.Int(9223372036854775808))
    assert((parse([U8]{27, 255, 255, 255, 255, 255, 255, 255, 255}) ?? panic("2^64-1 parses")) == Dyn.Int(18446744073709551615))
    assert((parse([U8]{59, 255, 255, 255, 255, 255, 255, 255, 255}) ?? panic("-2^64 parses")) == Dyn.Int(-18446744073709551616))
    assert_eq(to_bytes(Dyn.Int(-18446744073709551616)) ?? panic("-2^64 encodes"), [U8]{59, 255, 255, 255, 255, 255, 255, 255, 255})
    // A wider Int is a bignum, tag 2 or tag 3 over its big-endian magnitude.
    assert_eq(to_bytes(Dyn.Int(18446744073709551616)) ?? panic("2^64 encodes"), [U8]{194, 73, 1, 0, 0, 0, 0, 0, 0, 0, 0})
    assert_eq(to_bytes(Dyn.Int(-18446744073709551617)) ?? panic("-2^64-1 encodes"), [U8]{195, 73, 1, 0, 0, 0, 0, 0, 0, 0, 0})
    assert((parse([U8]{194, 73, 1, 0, 0, 0, 0, 0, 0, 0, 0}) ?? panic("tag 2 bignum parses")) == Dyn.Int(18446744073709551616))
    assert((parse([U8]{195, 73, 1, 0, 0, 0, 0, 0, 0, 0, 0}) ?? panic("tag 3 bignum parses")) == Dyn.Int(-18446744073709551617))
    // Two separately built 2^128+1 trees are equal; a neighbour is not.
    wide: 340282366920938463463374607431768211457
    left: Dyn.Array([Dyn]{Dyn.Int(wide)})
    right: Dyn.Array([Dyn]{Dyn.Int(340282366920938463463374607431768211456 + 1)})
    assert(left == right)
    assert(left != Dyn.Array([Dyn]{Dyn.Int(wide - 1)}))
}

#Test("CBOR stream definite and indefinite containers and text chunks") {
    dir: core.files.temp_dir("jet-cbor-events") ?? panic("temp")
    path: "{dir.path}/events.cbor"
    core.files.write_bytes(path, [U8]{159, 130, 1, 2, 191, 97, 107, 127, 97, 97, 97, 98, 255, 255, 255}) ?? panic("fixture")
    input: core.files.open(path) ?? panic("open")
    source := reader(input) ?? panic("reader")
    expected: [DataEvent]{.ArrayStart, .ArrayStart, .Int(1), .Int(2), .ArrayEnd, .ObjectStart, .Key("k"), .Text("ab"), .ObjectEnd, .ArrayEnd}
    loop event in expected {
        if source.next() == .Ok(read) -> assert_eq(read, Val(event)) else -> panic("event reads")
    }
    if source.next() == .Ok(end) -> assert_eq(end, None) else -> panic("end reads")
    if source.next() == .Ok(after) -> assert_eq(after, None) else -> panic("end stays")
}

#Test("CBOR stream reads all float widths and sticky item limit") {
    dir: core.files.temp_dir("jet-cbor-floats") ?? panic("temp")
    path: "{dir.path}/floats.cbor"
    core.files.write_bytes(path, [U8]{131, 249, 62, 0, 250, 71, 195, 80, 0, 251, 63, 241, 153, 153, 153, 153, 153, 154}) ?? panic("fixture")
    input: core.files.open(path) ?? panic("open")
    source := reader(input) ?? panic("reader")
    expected: [DataEvent]{.ArrayStart, .Float(Float{1.5}), .Float(Float{100000.0}), .Float(Float{1.1}), .ArrayEnd}
    loop event in expected {
        if source.next() == .Ok(read) -> assert_eq(read, Val(event)) else -> panic("float event reads")
    }
    if source.next() == .Ok(end) -> assert_eq(end, None) else -> panic("end reads")
    core.files.write_bytes(path, [U8]{98, 97, 98}) ?? panic("fixture")
    limited_input: core.files.open(path) ?? panic("open")
    limits := EncodingLimits.safe()
    limits.max_item_bytes = 1
    limited := reader(limited_input, limits) ?? panic("reader")
    first := EncodingError?{None}
    if limited.next() == {
        .Err(failure) -> {
            assert_eq(failure.reason, "max_item_bytes 1 exceeded")
            assert_eq(failure.byte_offset, 0)
            first = Val(failure)
        }
        .Val(_) | .None -> panic("item limit must fail")
    }
    if limited.next() == .Err(failure) -> assert_eq(Val(failure), first) else -> panic("failure must be sticky")
}

#Test("CBOR writer sorts encoded keys and flush does not complete a container") {
    dir: core.files.temp_dir("jet-cbor-write") ?? panic("temp")
    path: "{dir.path}/sorted.cbor"
    output: core.files.create(path) ?? panic("create")
    sink := writer(output) ?? panic("writer")
    sink.write(DataEvent.ObjectStart) ?? panic("object")
    sink.write(DataEvent.Key("aa")) ?? panic("key")
    sink.write(DataEvent.Int(1)) ?? panic("value")
    sink.flush() ?? panic("flush")
    assert_eq(core.files.read_bytes(path) ?? panic("read"), [U8]{})
    sink.write(DataEvent.Key("b")) ?? panic("key")
    sink.write(DataEvent.Float(Float{1.5})) ?? panic("value")
    sink.write(DataEvent.ObjectEnd) ?? panic("end")
    sink.finish() ?? panic("finish")
    sink.finish() ?? panic("repeat finish")
    assert_eq(core.files.read_bytes(path) ?? panic("read"), [U8]{162, 97, 98, 249, 62, 0, 98, 97, 97, 1})
    if sink.write(DataEvent.Null) == .Err(failure) -> assert_eq(failure.reason, "write called after finish") else -> panic("write after finish must fail")
}

#Test("CBOR writer incomplete finish is sticky and total limit is checked at root") {
    dir: core.files.temp_dir("jet-cbor-finish") ?? panic("temp")
    path: "{dir.path}/partial.cbor"
    output: core.files.create(path) ?? panic("create")
    sink := writer(output) ?? panic("writer")
    sink.write(DataEvent.ArrayStart) ?? panic("start")
    sink.flush() ?? panic("flush incomplete")
    if sink.finish() == .Err(failure) -> assert_eq(failure.reason, "finish requires one complete CBOR root") else -> panic("incomplete finish must fail")
    if sink.flush() == .Err(failure) -> assert_eq(failure.reason, "finish requires one complete CBOR root") else -> panic("flush must retain first failure")
    limited_output: core.files.create("{dir.path}/limit.cbor") ?? panic("create")
    limits := EncodingLimits.safe()
    limits.max_total_bytes = Val(1)
    limited := writer(limited_output, limits) ?? panic("writer")
    limited.write(DataEvent.ArrayStart) ?? panic("start")
    limited.write(DataEvent.Int(1)) ?? panic("item")
    if limited.write(DataEvent.ArrayEnd) == .Err(failure) -> assert_eq(failure.reason, "max_total_bytes 1 exceeded") else -> panic("root wire limit must fail")
}

#Test("CBOR stream reads integers out to 2^64-1 and -2^64 and refuses to write a wider Int") {
    dir: core.files.temp_dir("jet-cbor-wide") ?? panic("temp")
    path: "{dir.path}/wide.cbor"
    core.files.write_bytes(path, [U8]{130, 27, 255, 255, 255, 255, 255, 255, 255, 255, 59, 255, 255, 255, 255, 255, 255, 255, 255}) ?? panic("fixture")
    input: core.files.open(path) ?? panic("open")
    source := reader(input) ?? panic("reader")
    expected: [DataEvent]{.ArrayStart, .Int(18446744073709551615), .Int(-18446744073709551616), .ArrayEnd}
    loop event in expected {
        if source.next() == .Ok(read) -> assert_eq(read, Val(event)) else -> panic("event reads")
    }
    output: core.files.create("{dir.path}/out.cbor") ?? panic("create")
    sink := writer(output) ?? panic("writer")
    if sink.write(DataEvent.Int(18446744073709551616)) == .Err(failure) -> assert_eq(failure.kind, .Unsupported) else -> panic("2^64 written")
}
