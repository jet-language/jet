use {
    core.encoding.[Dyn, EncodingError, EncodingErrorKind, EncodingFormat, Format, FormatError]
    base64: core.encoding.base64
    core.time.[ZonedDateTime]
    stream: __core_encoding_stream
    json: core.encoding.json
}

syntax_error: fn(format: EncodingFormat, offset: Int, line: Int, column: Int, path: String, reason: String) -> EncodingError Never! {
    {
        format: format,
        kind: EncodingErrorKind.Syntax,
        byte_offset: offset,
        line: Val(line),
        column: Val(column),
        path: path,
        reason: reason,
        cause: None,
    }
}

priv unsupported_error: fn(reason: String) -> EncodingError Never! {
    error := syntax_error(EncodingFormat.YAML, 0, 1, 1, "", reason)
    error.kind = EncodingErrorKind.Unsupported
    error
}

// core.encoding.yaml — JSON-compatible YAML 1.2 plus simple block maps/lists.
//
// This source codec covers JSON, `key: value` maps, `- item` lists, JSON
// flow collections as values, a leading `---` document marker, `|` / `>`
// folded scalars, comments, !!binary, and offset timestamps. Unknown syntax,
// anchors and aliases included, fails closed rather than silently delegating.
//
// A key repeated in one map is a Syntax error at the repeat that names the
// key and the line and column of its first appearance.
// `parse_allow_duplicates` keeps the later value in the first key's position
// instead. A JSON-shaped document is JSON's, with JSON's rule.
parse: fn(text: String) -> Dyn EncodingError! { parse_yaml(text, 1, 0, false) }

/// YAML → `Dyn`, except that a key repeated in one map keeps the later value
/// at the first key's position.
parse_allow_duplicates: fn(text: String) -> Dyn EncodingError! { parse_yaml(text, 1, 0, true) }

decode: fn(text: String) -> Dyn EncodingError! { parse_yaml(text, 1, 0, false) }

// Compiler-private typed entry for `yaml.decode<T>(text)`: the document's
// tree decodes into the target, a parse failure as one root FieldError.
priv __decode_typed: fn<Target: Decode>(text: String) -> Target [FieldError]! {
    tree: parse_yaml(text, 1, 0, false) ?? return Err([FieldError]{FieldError{path: "", reason: "invalid YAML: {err.reason}"}})
    value: tree.decode<Target>() ?? return Err(err)
    Ok(value)
}

to_string: fn<T: Encode>(value: T) -> String Never! {
    text: render_yaml(value.encode(), 0).trim_end()
    if text == "" -> "{{}}" else -> text
}

/// YAML as a `Format`: UTF-8 text, read as `parse` reads it and written as
/// `to_string` writes it.
///
/// ```jet
/// tree: parse("port: 80") ?? panic("{err}")
/// back: Codec.read(Codec.write(tree) ?? panic("{err}")) ?? panic("{err}")
/// to_string(back) == to_string(tree) // => true
/// ```
Codec: struct {
    impl Format {
        name: "yaml",

        read: fn(bytes: [U8]) -> Dyn FormatError! {
            text: String.from_bytes(bytes) ?? return Err(FormatError{format: "yaml", reason: "the bytes are not UTF-8"})
            tree: parse(text) ?? return Err(FormatError{format: "yaml", reason: err.display_text()})
            Ok(tree)
        }

        write: fn(tree: Dyn) -> [U8] FormatError! { Ok(to_string(tree).bytes()) }
    }
}

#Test("the YAML format writes a map and reads it back") {
    tree: parse("port: 80\nhost: a") ?? panic("YAML")
    bytes: Codec.write(tree) ?? panic("write")
    back: Codec.read(bytes) ?? panic("read")
    assert_eq(to_string(back), to_string(tree))
    if Codec.read([U8]{255}) == {
        .Ok(_) -> { panic("bytes that are not UTF-8 read as YAML") }
        .Err(failure) -> assert_eq(failure.reason, "the bytes are not UTF-8")
    }
}

// Where a row starts in the source: its line, the column of its first byte
// and its byte offset.
priv YAMLPlace: struct {
    line: Int,
    column: Int,
    offset: Int,
}

priv yaml_error: fn(place: YAMLPlace, path: String, reason: String) -> EncodingError Never! {
    syntax_error(EncodingFormat.YAML, place.offset, place.line, place.column, path, reason)
}

// The place `skipped` bytes after `place`, on its line.
priv shifted: fn(place: YAMLPlace, skipped: Int) -> YAMLPlace Never! {
    YAMLPlace{line: place.line, column: place.column + skipped, offset: place.offset + skipped}
}

// The place of the first non-blank byte of `row`, which starts at `place`.
priv row_place: fn(place: YAMLPlace, row: String) -> YAMLPlace Never! {
    shifted(place, row.count_bytes() - lstrip(row).count_bytes())
}

// `text` starts at source line `line`, column 1, byte `offset`.
priv parse_yaml: fn(text: String, line: Int, offset: Int, allow_duplicates: Bool) -> Dyn EncodingError! {
    trimmed: trim_yaml(text)
    if trimmed.len() == 0 -> return Ok(Dyn.Null)
    if looks_json(trimmed) -> return parse_json_document(text, line, offset, allow_duplicates)
    raw: text.bytes()
    start := 0
    row_line := line
    column := 1
    loop start < raw.len() && (raw[start] == (U8{32}) || raw[start] == (U8{9}) || raw[start] == (U8{10}) || raw[start] == (U8{13})) {
        if raw[start] == (U8{10}) {
            row_line += 1
            column = 1
        } else { column += 1 }
        start += 1
    }
    end := raw.len()
    loop end > start && (raw[end - 1] == (U8{32}) || raw[end - 1] == (U8{9}) || raw[end - 1] == (U8{10}) || raw[end - 1] == (U8{13})) {
        end -= 1
    }
    rows := [String]{}
    places := [YAMLPlace]{}
    row_start := start
    buf := [U8]{}
    loop index in start..<end {
        b: raw[index]
        if b == (U8{10}) {
            place: YAMLPlace{line: row_line, column: column, offset: offset + row_start}
            rows.push(String.from_bytes(buf) ?? return Err(yaml_error(place, "", "invalid UTF-8 in YAML input")))
            places.push(place)
            buf = [U8]{}
            row_line += 1
            column = 1
            row_start = index + 1
            next
        }
        if b == (U8{13}) -> next
        buf.push(b)
    }
    if buf.len() > 0 {
        place: YAMLPlace{line: row_line, column: column, offset: offset + row_start}
        rows.push(String.from_bytes(buf) ?? return Err(yaml_error(place, "", "invalid UTF-8 in YAML input")))
        places.push(place)
    }
    parse_block(rows, places, allow_duplicates)
}

// A JSON-shaped document, read by JSON with its positions in the YAML
// source: blanks then line breaks stand in for the text before it.
priv parse_json_document: fn(text: String, line: Int, offset: Int, allow_duplicates: Bool) -> Dyn EncodingError! {
    if offset == 0 {
        return if allow_duplicates -> json.parse_allow_duplicates(text) else -> json.parse(text)
    }
    padded := [U8]{}
    loop _ in 0..<(offset - (line - 1)) -> padded.push(U8{32})
    loop _ in 0..<(line - 1) -> padded.push(U8{10})
    loop b in text.bytes() -> padded.push(b)
    source: String.from_bytes(padded) ?? panic("ASCII blanks before UTF-8 text keep it UTF-8")
    if allow_duplicates -> json.parse_allow_duplicates(source) else -> json.parse(source)
}

looks_json: fn(text: String) -> Bool Never! {
    loop b in text.bytes() {
        n: b
        if n == 32 || n == 9 || n == 10 || n == 13 -> next
        return n == 123 || n == 91
    }
    false
}

// `rows` with where each starts in the source (`places`).
priv parse_block: fn(rows: [String], places: [YAMLPlace], allow_duplicates: Bool) -> Dyn EncodingError! {
    if rows.len() == 0 -> return Ok(Dyn.Null)
    first := ""
    first_index := 0
    loop row_index in 0..<rows.len() {
        row: rows[row_index]
        if !is_blank_or_comment(row) {
            first = row
            first_index = row_index
            break
        }
    }
    if first.len() == 0 -> return Ok(Dyn.Null)
    first_body: trim_yaml(strip_inline_comment(first))
    if first_body == "---" {
        if first_index + 1 >= rows.len() -> return Ok(Dyn.Null)
        document := [String]{}
        loop j in first_index + 1..<rows.len() -> document.push(rows[j].copy())
        start: places[first_index + 1]
        return parse_yaml(join_lines(document), start.line, start.offset, allow_duplicates)
    }
    if first_body == "|" || first_body == ">" || first_body == "!!binary |" || first_body == "!!binary >" {
        block: parse_block_scalar(rows, first_index, leading_spaces(first), first_body == ">" || first_body == "!!binary >")
        if first_body.starts_with("!!binary") {
            return parse_scalar("!!binary {block.value}", allow_duplicates)
        }
        return Ok(Dyn.Text(block.value))
    }
    if starts_list(first) {
        return parse_list(rows, places, leading_spaces(first), allow_duplicates)
    }
    if !is_map_entry(first) -> return parse_scalar(trim_yaml(first), allow_duplicates)
    parse_map(rows, places, leading_spaces(first), allow_duplicates)
}

starts_list: fn(line: String) -> Bool Never! {
    s: lstrip(line)
    bytes: s.bytes()
    if bytes.len() < 2 -> return false
    bytes[0] == (U8{45}) && (bytes[1] == (U8{32}) || bytes[1] == (U8{9}))
}

// A timestamp's internal colons are not YAML mapping separators.
is_map_entry: fn(text: String) -> Bool Never! {
    raw: text.bytes()
    quote := 0
    loop i in 0..<raw.len() {
        n: raw[i]
        if quote != 0 {
            if n == quote -> quote = 0
        } else if n == 34 || n == 39 { quote = n } else if n == 58 {
            if i + 1 == raw.len() || raw[i + 1] == (U8{32}) || raw[i + 1] == (U8{9}) -> return true
        }
    }
    false
}

parse_block_scalar: fn(rows: [String], start: Int, parent_indent: Int, folded: Bool) -> {value: String, next: Int} Never! {
    lines := [String]{}
    i := start + 1
    content_indent := -1
    loop i < rows.len() {
        line: rows[i]
        if line.len() == 0 {
            lines.push("")
            i += 1
            next
        }
        pad: leading_spaces(line)
        if pad <= parent_indent -> break
        if content_indent < 0 -> content_indent = pad
        if pad < content_indent -> break
        lines.push(strip_indent(line, content_indent))
        i += 1
    }
    out := ""
    loop j in 0..<lines.len() {
        if j > 0 {
            previous: lines[j - 1]
            if folded && previous.len() > 0 && lines[j].len() > 0 -> out = "{out} " else {
                out = "{out}\n"
            }
        }
        out = "{out}{lines[j]}"
    }
    if lines.len() > 0 -> out = "{out}\n"
    {value: out, next: i}
}

strip_indent: fn(text: String, columns: Int) -> String Never! {
    raw: text.bytes()
    consumed := 0
    i := 0
    loop i < raw.len() && consumed < columns {
        if raw[i] == (U8{32}) {
            consumed += 1
            i += 1
            next
        }
        if raw[i] == (U8{9}) {
            consumed += 2
            i += 1
            next
        }
        break
    }
    if i >= raw.len() -> return ""
    String.from_bytes(raw[i..raw.len() - 1]) ?? ""
}

priv parse_map: fn(rows: [String], places: [YAMLPlace], indent: Int, allow_duplicates: Bool) -> Dyn EncodingError! {
    // Keys keep arrival order. The temporary `seen` maps each key to its
    // entry, and `firsts` holds where each entry's key is, for a repeat's
    // report; both are freed with the map.
    entries := [{key: String, value: Dyn}]{}
    firsts := [YAMLPlace]{}
    seen := [String:Int]{}
    i := 0
    loop i < rows.len() {
        line: rows[i]
        if is_blank_or_comment(line) {
            i += 1
            next
        }
        pad: leading_spaces(line)
        if pad < indent -> break
        place: row_place(places[i], line)
        if pad > indent -> return Err(yaml_error(place, "", "unexpected indentation in YAML map"))
        body: lstrip(line)
        cut: split_once(body, 58)
        if cut.before == body -> return Err(yaml_error(place, "", "YAML map entry needs ':'"))
        key: trim_yaml(cut.before)
        if key.len() == 0 -> return Err(yaml_error(place, "", "YAML map key is empty"))
        at: seen.get(key) ?? -1
        if at >= 0 && !allow_duplicates {
            first: firsts[at]
            return Err(yaml_error(place, key, "duplicate key `{key}` (first at line {first.line}, column {first.column})"))
        }
        rest: trim_yaml(strip_inline_comment(cut.after))
        i += 1
        value := Dyn.Null
        if rest == "|" || rest == ">" {
            block: parse_block_scalar(rows, i - 1, pad, rest == ">")
            value = Dyn.Text(block.value)
            i = block.next
        } else if rest.len() == 0 {
            child_rows := [String]{}
            child_places := [YAMLPlace]{}
            loop i < rows.len() {
                child: rows[i]
                if is_blank_or_comment(child) {
                    i += 1
                    next
                }
                if leading_spaces(child) <= pad -> break
                child_rows.push(child.copy())
                child_places.push(places[i])
                i += 1
            }
            value = parse_block(child_rows, child_places, allow_duplicates)
        } else { value = parse_scalar(rest, allow_duplicates) }
        // parse_allow_duplicates: the later value, at the first key's position.
        if at >= 0 -> entries[at].value = value else {
            _: seen.add(key.copy(), entries.len())
            entries.push({key: key, value: value})
            firsts.push(place)
        }
    }
    Ok(stream.object_from_entries(entries))
}

priv parse_list: fn(rows: [String], places: [YAMLPlace], indent: Int, allow_duplicates: Bool) -> Dyn EncodingError! {
    items := [Dyn]{}
    i := 0
    loop i < rows.len() {
        line: rows[i]
        if is_blank_or_comment(line) {
            i += 1
            next
        }
        pad: leading_spaces(line)
        if pad < indent -> break
        if pad > indent {
            return Err(yaml_error(row_place(places[i], line), "", "unexpected indentation in YAML list"))
        }
        body: lstrip(line)
        bytes: body.bytes()
        if bytes.len() == 0 || bytes[0] != (U8{45}) {
            return Err(yaml_error(row_place(places[i], line), "", "YAML list item needs '-'"))
        }
        rest := ""
        if bytes.len() > 1 -> rest = trim_yaml(drop_prefix(body, 2))
        i += 1
        if rest == "|" || rest == ">" || rest == "!!binary |" || rest == "!!binary >" {
            block: parse_block_scalar(rows, i - 1, pad, rest == ">" || rest == "!!binary >")
            if rest.starts_with("!!binary") {
                items.push(parse_scalar("!!binary {block.value}", allow_duplicates))
            } else { items.push(Dyn.Text(block.value)) }
            i = block.next
        } else if rest.len() == 0 {
            child_rows := [String]{}
            child_places := [YAMLPlace]{}
            loop i < rows.len() {
                child: rows[i]
                if is_blank_or_comment(child) {
                    i += 1
                    next
                }
                if leading_spaces(child) <= pad -> break
                child_rows.push(child.copy())
                child_places.push(places[i])
                i += 1
            }
            items.push(parse_block(child_rows, child_places, allow_duplicates))
        } else if is_map_entry(rest) {
            // The item's map: its first entry follows the `-`, the rest
            // are the deeper rows below it, each with its indent removed.
            map_rows := [String]{rest}
            map_places := [YAMLPlace]{shifted(places[i - 1], line.count_bytes() - lstrip(drop_prefix(body, 2)).count_bytes())}
            loop i < rows.len() {
                child: rows[i]
                if is_blank_or_comment(child) {
                    map_rows.push("")
                    map_places.push(places[i])
                    i += 1
                    next
                }
                if leading_spaces(child) <= pad -> break
                entry: strip_indent(child, pad + 2)
                map_places.push(shifted(places[i], child.count_bytes() - entry.count_bytes()))
                map_rows.push(entry)
                i += 1
            }
            items.push(parse_map(map_rows, map_places, 0, allow_duplicates))
        } else { items.push(parse_scalar(strip_inline_comment(rest), allow_duplicates)) }
    }
    Ok(Dyn.Array(items))
}

priv parse_scalar: fn(text: String, allow_duplicates: Bool) -> Dyn EncodingError! {
    clean: trim_yaml(strip_inline_comment(text))
    if clean.starts_with("&") || clean.starts_with("*") {
        return Err(unsupported_error("YAML anchors and aliases (&name, *name) are not supported"))
    }
    stamp_text := clean
    if clean.starts_with("!!timestamp") -> stamp_text = unquote(trim_yaml(drop_prefix(clean, 11)))
    raw: stamp_text.bytes()
    if !clean.starts_with("\"") && !clean.starts_with("'") && raw.len() >= 28 && (raw[raw.len() - 9] == (U8{43}) || raw[raw.len() - 9] == (U8{45})) && raw[raw.len() - 6] == (U8{58}) && raw[raw.len() - 3] == (U8{58}) {
        error := syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "date-time offsets with seconds are unsupported")
        error.kind = EncodingErrorKind.Unsupported
        return Err(error)
    }
    if clean.starts_with("!!binary") {
        encoded: unquote(trim_yaml(drop_prefix(clean, 8)))
        compact := [U8]{}
        loop b in encoded.bytes() {
            if b != (U8{32}) && b != (U8{9}) && b != (U8{10}) && b != (U8{13}) -> compact.push(b)
        }
        bytes: base64.decode(String.from_bytes(compact) ?? "") ?? return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "invalid !!binary base64"))
        return Ok(Dyn.Bytes(bytes))
    }
    if clean.starts_with("!!timestamp") {
        stamp: Dyn.Text(unquote(trim_yaml(drop_prefix(clean, 11))))
        z: stamp.decode<ZonedDateTime>() ?? return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "invalid !!timestamp RFC 3339 date-time"))
        if z.offset_seconds() %% 60 != 0 {
            error := syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "date-time offset must be whole minutes")
            error.kind = EncodingErrorKind.Unsupported
            return Err(error)
        }
        return Ok(Dyn.DateTime(z))
    }
    if clean.starts_with("[") || clean.starts_with("{{") {
        if allow_duplicates {
            return json.parse_allow_duplicates(clean) ?? return Err(unsupported_error("YAML flow collections must be JSON"))
        }
        return json.parse(clean) ?? return Err(unsupported_error("YAML flow collections must be JSON"))
    }
    if clean.starts_with("\"") || clean.starts_with("'") -> return Ok(Dyn.Text(unquote(clean)))
    stamp: Dyn.Text(clean)
    if stamp.decode<ZonedDateTime>() == {
        .Ok(z) -> {
            if z.offset_seconds() %% 60 != 0 {
                error := syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "date-time offset must be whole minutes")
                error.kind = EncodingErrorKind.Unsupported
                return Err(error)
            }
            return Ok(Dyn.DateTime(z))
        }
        .Err(_) -> { _ := 0 }
    }
    if clean == {
        "null" | "~" -> return Ok(Dyn.Null)
        "true" -> return Ok(Dyn.Bool(true))
        "false" -> return Ok(Dyn.Bool(false))
        else -> { _ := 0 }
    }
    // #4602: a number keeps its exact JSON-number lexeme as `Number`.
    if Int.parse(clean) == {
        .Ok(n) -> return Ok(stream.typed_number("{n}"))
        .Err(_) -> { _ := 0 }
    }
    if Float.parse(clean) == {
        .Ok(n) -> return Ok(number_tree(clean.copy(), n))
        .Err(_) -> { _ := 0 }
    }
    Ok(Dyn.Text(unquote(clean)))
}

// A float keeps its own spelling when it is a JSON number token (`+` dropped),
// else its shortest decimal spelling; `.inf` and `.nan` have no lexeme and stay
// `Float`. Rust twin: jet-foundation.
number_tree: fn(clean: &&String, value: Float) -> Dyn Never! {
    unsigned := clean.move()
    raw: unsigned.bytes()
    if raw.len() > 0 && raw[0] == (U8{43}) {
        unsigned = String.from_bytes(raw[1..<raw.len()]) ?? panic("removing an ASCII prefix preserves UTF-8")
    }
    if is_json_number_token(unsigned) -> return stream.typed_number(unsigned)
    shown := "{value}"
    if is_json_number_token(shown) -> return stream.typed_number(shown)
    Dyn.Float(value)
}

is_json_number_token: fn(text: String) -> Bool Never! {
    b: text.bytes()
    i := 0
    if i < b.len() && b[i] == (U8{45}) -> i += 1
    if i >= b.len() -> return false
    if b[i] == (U8{48}) -> i += 1 else {
        if b[i] < (U8{49}) || b[i] > (U8{57}) -> return false
        loop i < b.len() && b[i] >= (U8{48}) && b[i] <= (U8{57}) -> i += 1
    }
    if i < b.len() && b[i] == (U8{46}) {
        i += 1
        fraction: i
        loop i < b.len() && b[i] >= (U8{48}) && b[i] <= (U8{57}) -> i += 1
        if i == fraction -> return false
    }
    if i < b.len() && (b[i] == (U8{101}) || b[i] == (U8{69})) {
        i += 1
        if i < b.len() && (b[i] == (U8{43}) || b[i] == (U8{45})) -> i += 1
        exponent: i
        loop i < b.len() && b[i] >= (U8{48}) && b[i] <= (U8{57}) -> i += 1
        if i == exponent -> return false
    }
    i == b.len()
}

render_yaml: fn(value: Dyn, indent: Int) -> String Never! {
    if value == {
        .Object(_) -> render_yaml_object(value, indent)
        .Array(items) -> render_yaml_array(items, indent)
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) -> "{spaces(indent)}{yaml_leaf(value)}\n"
    }
}

nonempty_collection: fn(value: Dyn) -> Bool Never! {
    if value == {
        .Object(_) -> stream.object_entries(value).len() > 0
        .Array(items) -> items.len() > 0
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) -> false
    }
}

render_yaml_array: fn(items: [Dyn], indent: Int) -> String Never! {
    pad: spaces(indent)
    out := ""
    loop item in items {
        if nonempty_collection(item) -> out = "{out}{pad}-\n{render_yaml(item, indent + 2)}" else {
            out = "{out}{pad}- {yaml_leaf(item)}\n"
        }
    }
    out
}

render_yaml_object: fn(value: Dyn, indent: Int) -> String Never! {
    pad: spaces(indent)
    entries: stream.object_entries(value)
    if entries.len() == 0 -> return "{pad}{{}}\n"
    out := ""
    loop pair in entries {
        key: yaml_key(pair.key)
        if nonempty_collection(pair.value) {
            out = "{out}{pad}{key}:\n"
            if pair.value == {
                .Array(items) -> out = "{out}{render_yaml_array(items, indent)}"
                .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> {
                    out = "{out}{render_yaml(pair.value, indent + 2)}"
                }
            }
        } else { out = "{out}{pad}{key}: {yaml_leaf(pair.value)}\n" }
    }
    out
}

yaml_key: fn(key: String) -> String Never! {
    if key == "" || key.contains(":") || key.contains(" ") || key.contains("#") {
        return "{key:Debug}"
    }
    key.copy()
}

yaml_leaf: fn(value: Dyn) -> String Never! {
    #Unsafe("inspect compiler-private Bytes and typed carriers; public Dyn variants are unchanged") {
        return if value == {
            .Null -> "null"
            .Bool(v) -> "{v}"
            .Int(n) -> "{n}"
            .Float(n) -> "{n:Debug}"
            // A JSON-shaped document parses through json.parse, which keeps
            // each number's exact lexeme (#4602); that text is a YAML number.
            .Number(text) -> text.copy()
            .Text(s) -> yaml_scalar(s)
            // A YAML timestamp is its plain RFC 3339 scalar, as the parser reads one.
            .DateTime(_) -> value.to_text() ?? panic("DateTime always has an RFC 3339 representation")
            // Bytes are a `!!binary` base64 scalar, as the parser reads one.
            .Bytes(bytes) -> "!!binary {base64.encode(bytes)}"
            .Array(items) -> {
                out := "["
                loop i in 0..<items.len() {
                    if i > 0 -> out = "{out}, "
                    out = "{out}{yaml_leaf(items[i])}"
                }
                "{out}]"
            }
            .Object(_) -> {
                out := "{{"
                first := true
                loop pair in stream.object_entries(value) {
                    if !first -> out = "{out}, "
                    first = false
                    out = "{out}{yaml_key(pair.key)}: {yaml_leaf(pair.value)}"
                }
                "{out}}}"
            }
        }
    }
}

trim_yaml: fn(text: String) -> String Never! {
    raw: text.bytes()
    start := 0
    end := raw.len()
    loop start < end {
        n: raw[start]
        if n == 32 || n == 9 || n == 10 || n == 13 {
            start += 1
            next
        }
        break
    }
    loop end > start {
        n: raw[end - 1]
        if n == 32 || n == 9 || n == 10 || n == 13 {
            end -= 1
            next
        }
        break
    }
    if end <= start -> return ""
    String.from_bytes(raw[start..end - 1]) ?? ""
}

strip_inline_comment: fn(text: String) -> String Never! {
    raw: text.bytes()
    quote := 0
    i := 0
    loop i < raw.len() {
        n: raw[i]
        if quote != 0 {
            if n == quote -> quote = 0
        } else if n == 34 || n == 39 { quote = n } else if n == 35 && (i == 0 || raw[i - 1] == 32 || raw[i - 1] == 9) {
            if i == 0 -> return ""
            return String.from_bytes(raw[0..i - 1]) ?? ""
        }
        i += 1
    }
    text.copy()
}

yaml_scalar: fn(text: String) -> String Never! {
    needs := text == "" || text == "null" || text == "Null" || text == "NULL" || text == "~" || text == "true" || text == "True" || text == "TRUE" || text == "false" || text == "False" || text == "FALSE"
    if text.starts_with(" ") || text.ends_with(" ") || text.contains(": ") || text.contains(" #") || text.contains("\n") || parses_as_number(text) {
        needs = true
    }
    raw: text.bytes()
    if raw.len() > 0 {
        loop b in "-?:[]{{}}#&*!|>'\"%@`".bytes() {
            if raw[0] == b -> needs = true
        }
    }
    if needs -> "{text:Debug}" else -> text
}

parses_as_number: fn(text: String) -> Bool Never! {
    raw: text.bytes()
    digits := raw.len() > 0
    loop i in 0..<raw.len() {
        n: Int{raw[i]}
        if i == 0 && (n == 43 || n == 45) {
            if raw.len() == 1 -> digits = false
            next
        }
        if n < 48 || n > 57 -> digits = false
    }
    if digits && Int.parse(text) == .Ok(n) && n >= -9223372036854775808 && n <= 9223372036854775807 {
        return true
    }
    Float.parse(text) == .Ok(_)
}

lstrip: fn(text: String) -> String Never! {
    raw: text.bytes()
    start := 0
    loop start < raw.len() {
        n: raw[start]
        if n == 32 || n == 9 {
            start += 1
            next
        }
        break
    }
    if start >= raw.len() -> return ""
    String.from_bytes(raw[start..raw.len() - 1]) ?? ""
}

leading_spaces: fn(text: String) -> Int Never! {
    n := 0
    loop b in text.bytes() {
        if b == (U8{32}) {
            n += 1
            next
        }
        if b == (U8{9}) {
            n += 2
            next
        }
        break
    }
    n
}

is_blank_or_comment: fn(line: String) -> Bool Never! {
    s: lstrip(line)
    if s.len() == 0 -> return true
    s.bytes()[0] == (U8{35})
}

split_once: fn(text: String, sep: U8) -> {after: String, before: String} Never! {
    raw: text.bytes()
    loop i in 0..<raw.len() {
        if raw[i] == sep {
            before := ""
            if i > 0 -> before = String.from_bytes(raw[0..i - 1]) ?? ""
            after := ""
            if i + 1 < raw.len() -> after = String.from_bytes(raw[i + 1..raw.len() - 1]) ?? ""
            return {before: before, after: after}
        }
    }
    {before: text.copy(), after: ""}
}

drop_prefix: fn(text: String, n: Int) -> String Never! {
    raw: text.bytes()
    if raw.len() <= n -> return ""
    String.from_bytes(raw[n..raw.len() - 1]) ?? ""
}

join_lines: fn(rows: [String]) -> String Never! {
    out := ""
    loop i in 0..<rows.len() {
        if i > 0 -> out = "{out}\n"
        out = "{out}{rows[i]}"
    }
    out
}

spaces: fn(n: Int) -> String {
    out := ""
    loop _ in 0..<n -> out = "{out} "
    out
}

unquote: fn(text: String) -> String Never! {
    raw: text.bytes()
    if raw.len() < 2 -> return text.copy()
    if (raw[0] != (U8{34}) && raw[0] != (U8{39})) || raw[raw.len() - 1] != raw[0] {
        return text.copy()
    }
    out := [U8]{}
    i := 1
    loop i < raw.len() - 1 {
        if raw[0] == (U8{34}) && raw[i] == (U8{92}) && i + 1 < raw.len() - 1 {
            i += 1
            if raw[i] == (U8{110}) -> out.push(U8{10}) else if raw[i] == (U8{114}) {
                out.push(U8{13})
            } else if raw[i] == (U8{116}) { out.push(U8{9}) } else if raw[i] == (U8{34}) || raw[i] == (U8{92}) {
                out.push(raw[i])
            } else { out.push(raw[i]) }
        } else { out.push(raw[i]) }
        i += 1
    }
    String.from_bytes(out) ?? text.copy()
}

#Test("YAML renderer preserves scalar quoting") {
    assert(to_string(Dyn.Text("é")) == "é")
    assert(to_string(Dyn.Text("NULL")) == "\"NULL\"")
    assert(to_string(Dyn.Text("a b")) == "a b")
    assert(to_string(Dyn.Text("a: b")) == "\"a: b\"")
    assert(to_string(Dyn.Array([Dyn]{})) == "{{}}")
}

#Test("YAML reads a document marker and JSON flow values, and refuses anchors") {
    tree: parse("---\n# a config\nflowlist: [1, 2, 3]\nempty: {{}}\n") ?? panic("YAML")
    assert_eq(json.to_string(tree) ?? panic("JSON"), "{{\"flowlist\":[1,2,3],\"empty\":{{}}}}")
    if parse("base: &b\n  host: local\nuse: *b\n") == {
        .Ok(_) -> { panic("an anchor must fail closed") }
        .Err(error) -> {
            assert(error.kind == EncodingErrorKind.Unsupported)
            assert_eq(error.reason, "YAML anchors and aliases (&name, *name) are not supported")
        }
    }
    if parse("items: [a, b]\n") == {
        .Ok(_) -> { panic("a non-JSON flow collection must fail closed") }
        .Err(error) -> assert_eq(error.reason, "YAML flow collections must be JSON")
    }
}

#Test("YAML names a repeated key, where it repeats and where it first appears") {
    if parse("a: 1\nb: 2\na: 3\n") == {
        .Ok(_) -> { panic("a repeated key must fail") }
        .Err(error) -> {
            assert(error.kind == EncodingErrorKind.Syntax)
            assert_eq(error.reason, "duplicate key `a` (first at line 1, column 1)")
            assert(error.line == Val(3) && error.column == Val(1) && error.byte_offset == 10)
            assert_eq(error.path, "a")
        }
    }
    if parse("name: a\nb:\n  c: 1\n  c: 2\n") == {
        .Ok(_) -> { panic("a repeated nested key must fail") }
        .Err(error) -> {
            assert_eq(error.reason, "duplicate key `c` (first at line 3, column 3)")
            assert(error.line == Val(4) && error.column == Val(3))
        }
    }
    if parse("list:\n  - id: 1\n    id: 2\n") == {
        .Ok(_) -> { panic("a key repeated in a list item's map must fail") }
        .Err(error) -> {
            assert_eq(error.reason, "duplicate key `id` (first at line 2, column 5)")
            assert(error.line == Val(3) && error.column == Val(5))
        }
    }
    if parse("---\n{{\"a\": 1, \"a\": 2}}") == {
        .Ok(_) -> { panic("a repeated name in a JSON document must fail") }
        .Err(error) -> {
            assert_eq(error.reason, "duplicate object key `a` (first at line 2, column 2)")
            assert(error.line == Val(2))
        }
    }
    tree: parse_allow_duplicates("a: 1\nb: 2\na: 3\n") ?? panic("allowed YAML")
    assert_eq(json.to_string(tree) ?? panic("JSON"), "{{\"a\":3,\"b\":2}}")
}
