// core.encoding.validate — the use-site rule builder.
//
// `Validate.over(value)` is the builder for rules that need context a
// struct's `validate { … }` block cannot see. It shares that block's
// vocabulary: `.check(condition, at: field, "message")` adds one
// `FieldError{path: "field", reason: message}` when the condition fails (Sema
// checks that `at:` names a field of `T` and passes its name), and `.finish()`
// returns the value or every collected failure. Each step consumes the builder
// it is called on. The bare name `Validate` loads this module on demand, so a
// program that never builds a rule set never loads it.
Validate: struct<T> {
    value: T
    errors: [FieldError]

    over: fn(value: T) -> Validate<T> Never! {
        // copy: the builder owns the checked value; the caller keeps its own
        Validate<T>{value: value.copy(), errors: [FieldError]{}}
    }

    check: fn(&&self, holds: Bool, at: String, reason: String) -> Validate<T> Never! {
        if holds -> return self
        errors := self.errors
        errors.push(FieldError{path: at, reason: reason})
        Validate<T>{value: self.value, errors: errors}
    }

    finish: fn(&&self) -> T [FieldError]! {
        if !self.errors.is_empty() -> return Err(self.errors)
        self.value
    }
}
