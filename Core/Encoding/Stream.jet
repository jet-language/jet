// Compiler-private encoding stream policy shared by JSON and JSONL.
// The public wrappers preserve the shipped text/file return shapes.
// Write leaves take borrowed View<U8> windows; EOF remains an optional success,
// distinct from typed EncodingError failures propagated by the stream policy.
use core.encoding.[DataEvent, Dyn, EncodingCause, EncodingError, EncodingErrorKind, EncodingFormat, EncodingLimits]
use core.encoding as encoding
use core.files.[FileReader, FileWriter]
use core.mem as mem
use core.math as math

// #4737: preserve insertion order without materializing a map or cloning a tree.
fn object_entries(value: Dyn) -> View<(key: String, value: Dyn)> Never! from value {
    if value == .Object(_) {
        #Unsafe("the Object variant was checked immediately before borrowing its ordered backing") {
            return encoding.__object_entries_view(value)
        }
    }
    panic("Object entry view requires an Object")
}

fn object_from_entries(entries: ^[(key: String, value: Dyn)]) -> Dyn Never! {
    #Unsafe("transfer the owned ordered entries allocation into the native Object carrier") {
        return encoding.__object_from_entries(^entries)
    }
}

fn bytes_payload(value: Dyn) -> View<U8> Never! from value {
    #Unsafe("check the private Bytes variant immediately before borrowing its backing") {
        if value == .Bytes(_) -> return encoding.__bytes_view(value)
    }
    panic("byte payload requires a Bytes carrier")
}

fn typed_number(text: ^String) -> Dyn Never! {
    #Unsafe("the shared parser validated this exact numeric lexeme") {
        return Dyn.Number(text)
    }
}

fn typed_string(text: ^String) -> Dyn Never! {
    #Unsafe("retain decoded JSON text until the target Decode contract is known") {
        return encoding.__typed_text(^text)
    }
}

struct AllocationState {
    used: Int
    limit: Int
}

struct AllocationBudget {
    state: Shared<AllocationState>

    fn charge(self, bytes: Int) -> Bool Never! {
        guard := self.state.guard_edit()
        updated :: guard.value.used + bytes
        if updated > guard.value.limit -> return false
        guard.value.used = updated
        true
    }

    fn release(self, bytes: Int) Never! {
        guard := self.state.guard_edit()
        updated :: guard.value.used - bytes
        guard.value.used = if updated < 0 -> 0 else -> updated
    }
}

fn heap_ceiling(limits: EncodingLimits) -> Int Never! {
    limits.buffer_bytes + limits.max_item_bytes + limits.max_expansion_bytes + limits.max_depth * 256 + 65536
}

fn budget(limits: EncodingLimits) -> AllocationBudget Never! {
    AllocationBudget{state: shared AllocationState{used: 0, limit: heap_ceiling(limits)}}
}

#Error
enum __ReserveFailure {
    Heap
    Allocation
}

fn reserve<T>(allocation: AllocationBudget, values: &[T], additional: Int) -> Bool Never! {
    __reserve_checked<T>(allocation, &values, additional) ?? return false
    true
}

fn __reserve_checked<T>(allocation: AllocationBudget, values: &[T], additional: Int) __ReserveFailure! {
    old :: mem.__list_capacity<T>(values) * mem.__type_size<T>()
    requested :: (values.len() + additional) * mem.__type_size<T>()
    if additional == 0 || requested <= old -> return
    growth :: requested - old
    if !allocation.charge(growth) {
        values = [T]{}
        allocation.release(old)
        return Err(.Heap)
    }
    if !mem.__list_reserve_exact<T>(&values, additional) {
        allocation.release(growth)
        actual :: mem.__list_capacity<T>(values) * mem.__type_size<T>()
        values = [T]{}
        allocation.release(actual)
        return Err(.Allocation)
    }
    actual :: mem.__list_capacity<T>(values) * mem.__type_size<T>()
    if actual < old || (actual > requested && !allocation.charge(actual - requested)) {
        values = [T]{}
        allocation.release(requested)
        return Err(.Heap)
    }
    if actual < requested -> allocation.release(requested - actual)
}

struct FoldBudget {
    decoded: Int
    tracked: Int
}

fn validate_limits(limits: EncodingLimits) EncodingError! {
    reason := ""
    if limits.buffer_bytes < 4096 || limits.buffer_bytes > 16777216 -> reason = "buffer_bytes {limits.buffer_bytes} is outside 4096..16777216"
    else if limits.max_depth < 1 || limits.max_depth > 4096 -> reason = "max_depth {limits.max_depth} is outside 1..4096"
    else if limits.max_item_bytes < 1 || limits.max_item_bytes > 1073741824 -> reason = "max_item_bytes {limits.max_item_bytes} is outside 1..1073741824"
    else if limits.max_expansion_depth < 0 || limits.max_expansion_depth > 256 -> reason = "max_expansion_depth {limits.max_expansion_depth} is outside 0..256"
    else if limits.max_expansion_bytes < 0 || limits.max_expansion_bytes > 1073741824 -> reason = "max_expansion_bytes {limits.max_expansion_bytes} is outside 0..1073741824"
    if reason == "" && limits.max_total_bytes == .Val(total) {
        if total < 0 -> reason = "max_total_bytes {total} is outside 0..Int.max"
    }
    if reason != "" -> return Err(stream_error(EncodingErrorKind.Limit, 0, 1, 1, reason))
}

fn stream_error(kind: EncodingErrorKind, offset: Int, line: Int, column: Int, reason: String) -> EncodingError Never! {
    EncodingError{format: .JSON, kind: kind, byte_offset: offset, line: Val(line), column: Val(column), path: "", reason: reason, cause: None}
}

fn io_error(offset: Int, line: Int, column: Int, cause: EncodingCause) -> EncodingError Never! {
    error := stream_error(.IO, offset, line, column, "file IO failed")
    error.cause = Val(cause)
    error
}

// Size-compatible frame slots use machine integers, not exact Int carriers.
enum ReadFrame {
    ArrayValueOrEnd(first: Bool, index: U64)
    ArrayCommaOrEnd(U64)
    ObjectKeyOrEnd(Bool)
    ObjectColonValue(key: String, key_heap: U64)
    ObjectCommaOrEnd(key: String, key_heap: U64)
}

struct JSONPull {
    input: FileReader
    limits: EncodingLimits
    total: Int
    offset: Int
    line: Int
    column: Int
    lookahead: U8?
    frames: [ReadFrame]
    root_started: Bool
    eof: Bool
    record_mode: Bool
    typed_numbers: Bool
    terminal: EncodingError?
    allocation: AllocationBudget
    output_heap: Int

    fn next(&self) -[IO, Time.Wait]> DataEvent? EncodingError! {
        if self.terminal == .Val(first) -> return Err(first)
        result :: if &self.next_inner() == {
            .Ok(value) -> value
            .Err(failure) -> {
                error := failure
                if error.path == "" -> error.path = self.path()
                &self.discard()
                self.terminal = Val(error)
                return Err(error)
            }
        }
        self.allocation.release(self.output_heap)
        self.output_heap = 0
        if result == None && self.eof -> &self.discard()
        Ok(result)
    }

    fn path(self) -> String Never! {
        out := "$"
        loop frame in self.frames {
            if frame == {
                .ArrayValueOrEnd(_, index) | .ArrayCommaOrEnd(index) -> out = "{out}[{index}]"
                .ObjectColonValue(key, _) | .ObjectCommaOrEnd(key, _) -> out = "{out}[{quote_path(key)}]"
                .ObjectKeyOrEnd(_) -> {}
            }
        }
        out
    }

    fn discard(&self) Never! {
        bytes := mem.__list_capacity<ReadFrame>(self.frames) * mem.__type_size<ReadFrame>()
        loop frame in self.frames {
            if frame == {
                .ObjectColonValue(_, heap) | .ObjectCommaOrEnd(_, heap) -> bytes += Int.from_u64(heap)
                else -> {}
            }
        }
        self.frames = [ReadFrame]{}
        self.allocation.release(bytes + self.output_heap)
        self.output_heap = 0
    }

    fn error(self, kind: EncodingErrorKind, reason: String) -> EncodingError Never! {
        stream_error(kind, self.offset, self.line, self.column, reason)
    }

    fn item_error(self, item: String) -> EncodingError Never! {
        self.error(.Limit, "JSON {item} allocation exceeded the bounded codec heap ceiling")
    }

    fn fill(&self) -[IO, Time.Wait]> U8? EncodingError! {
        if self.lookahead != None -> return Ok(self.lookahead)
        if encoding.__read_byte(&self.input) == {
            .Ok(value) -> {
                self.lookahead = value
                return Ok(value)
            }
            .Err(cause) -> return Err(io_error(self.offset, self.line, self.column, cause))
        }
    }

    fn consume(&self) -[IO, Time.Wait]> U8? EncodingError! {
        byte :: &self.fill()
        if byte == None -> return Ok(None)
        if self.limits.max_total_bytes == .Val(max) {
            if self.total >= max -> return Err(self.error(.Limit, "max_total_bytes {max} exceeded"))
        }
        self.lookahead = None
        self.total += 1
        self.offset += 1
        if byte == (Val(U8{10})) {
            self.line += 1
            self.column = 1
        } else { self.column += 1 }
        Ok(Val(byte))
    }

    fn skip_ws(&self) EncodingError! -[IO, Time.Wait]> {
        loop {
            byte :: &self.fill()
            if byte == (Val(U8{32})) || byte == (Val(U8{9})) || (!self.record_mode && (byte == (Val(U8{10})) || byte == (Val(U8{13})))) {
                _ :: &self.consume()
            } else {
                return
            }
        }
    }

    fn expect(&self, want: U8, context: String) EncodingError! -[IO, Time.Wait]> {
        byte :: &self.consume()
        if byte == .Val(got) {
            if got == want -> return
            column :: if self.column > 0 -> self.column - 1 else -> 0
            return Err(stream_error(.Syntax, self.offset - 1, self.line, column, "expected {context} but found {debug_byte(got)}"))
        }
        return Err(self.error(.Truncated, "expected {context} before end of input"))
    }

    fn append(&self, bytes: &[U8], byte: U8, item: String) EncodingError! {
        needed :: bytes.len() + 1
        if needed > self.limits.max_item_bytes -> return Err(self.error(.Limit, "max_item_bytes {self.limits.max_item_bytes} exceeded"))
        capacity :: mem.__list_capacity<U8>(bytes)
        if needed > capacity {
            grown := if capacity < 1 -> 2 else -> capacity * 2
            if grown < needed -> grown = needed
            additional :: grown - bytes.len()
            if !reserve<U8>(self.allocation, &bytes, additional) -> return Err(self.item_error(item))
        }
        &bytes.push(byte)
    }

    fn hex4(&self) -[IO, Time.Wait]> Int EncodingError! {
        value := 0
        loop _ in 0..<4 {
            byte :: &self.consume()
            if byte == None -> return Err(self.error(.Truncated, "incomplete Unicode escape"))
            got :: byte
            digit :: encoding.hex_value(got) ?? return Err(stream_error(.Syntax, self.offset - 1, self.line, self.column - 1, "Unicode escape contains a non-hex digit"))
            value = value * 16 + digit
        }
        Ok(value)
    }

    fn read_string(&self) -[IO, Time.Wait]> String EncodingError! {
        &self.expect(U8{34}, "a string")
        bytes := [U8]{}
        &self.read_string_bytes(&bytes) ?? {
            self.allocation.release(mem.__list_capacity<U8>(bytes))
            return Err(err)
        }
        capacity :: mem.__list_capacity<U8>(bytes)
        encoding.__utf8_validate(bytes) ?? {
            self.allocation.release(capacity)
            return Err(self.error(.Syntax, "JSON string is not valid UTF-8"))
        }
        text := ""
        #Unsafe("the shared UTF-8 validator just accepted this owned byte allocation") {
            text = encoding.__bytes_into_text(^bytes)
        }
        self.output_heap = capacity
        Ok(text)
    }

    fn read_string_bytes(&self, bytes: &[U8]) EncodingError! -[IO, Time.Wait]> {
        loop {
            byte :: &self.consume()
            if byte == None -> return Err(self.error(.Truncated, "unterminated JSON string"))
            got :: byte
            if got == (U8{34}) -> return
            if got <= (U8{31}) -> return Err(stream_error(.Syntax, self.offset - 1, self.line, self.column - 1, "unescaped control byte in JSON string"))
            if got != (U8{92}) {
                &self.append(&bytes, got, "string")
                next
            }
            escaped :: &self.consume()
            if escaped == None -> return Err(self.error(.Truncated, "incomplete JSON escape"))
            esc :: escaped
            if esc == (U8{34}) || esc == (U8{92}) || esc == (U8{47}) -> &self.append(&bytes, esc, "string")
            else if esc == (U8{98}) -> &self.append(&bytes, U8{8}, "string")
            else if esc == (U8{102}) -> &self.append(&bytes, U8{12}, "string")
            else if esc == (U8{110}) -> &self.append(&bytes, U8{10}, "string")
            else if esc == (U8{114}) -> &self.append(&bytes, U8{13}, "string")
            else if esc == (U8{116}) -> &self.append(&bytes, U8{9}, "string")
            else if esc == (U8{117}) {
                cp := &self.hex4()
                if cp >= 55296 && cp <= 56319 {
                    &self.expect(U8{92}, "a low-surrogate escape")
                    &self.expect(U8{117}, "a low-surrogate escape")
                    low :: &self.hex4()
                    if low < 56320 || low > 57343 -> return Err(stream_error(.Syntax, self.offset - 4, self.line, self.column - 4, "high surrogate is not followed by a low surrogate"))
                    cp = 65536 + ((cp - 55296) << 10) + low - 56320
                } else if cp >= 56320 && cp <= 57343 -> return Err(stream_error(.Syntax, self.offset - 4, self.line, self.column - 4, "unpaired low surrogate"))
                if cp < 128 -> &self.append(&bytes, U8{cp}, "string")
                else if cp < 2048 {
                    &self.append(&bytes, U8{(192).bit_or(cp >> 6)}, "string")
                    &self.append(&bytes, U8{(128).bit_or(cp.bit_and(63))}, "string")
                } else if cp < 65536 {
                    &self.append(&bytes, U8{(224).bit_or(cp >> 12)}, "string")
                    &self.append(&bytes, U8{(128).bit_or((cp >> 6).bit_and(63))}, "string")
                    &self.append(&bytes, U8{(128).bit_or(cp.bit_and(63))}, "string")
                } else {
                    &self.append(&bytes, U8{(240).bit_or(cp >> 18)}, "string")
                    &self.append(&bytes, U8{(128).bit_or((cp >> 12).bit_and(63))}, "string")
                    &self.append(&bytes, U8{(128).bit_or((cp >> 6).bit_and(63))}, "string")
                    &self.append(&bytes, U8{(128).bit_or(cp.bit_and(63))}, "string")
                }
            } else { return Err(stream_error(.Syntax, self.offset - 1, self.line, self.column - 1, "unknown JSON escape")) }
        }
    }

    fn number(&self, first: U8) -[IO, Time.Wait]> DataEvent EncodingError! {
        bytes := [U8]{}
        &self.number_bytes(&bytes, first) ?? {
            self.allocation.release(mem.__list_capacity<U8>(bytes))
            return Err(err)
        }
        start :: self.offset - bytes.len()
        if !valid_number(bytes) {
            self.allocation.release(mem.__list_capacity<U8>(bytes))
            return Err(stream_error(.Syntax, start, self.line, self.column, "invalid JSON number"))
        }
        capacity :: mem.__list_capacity<U8>(bytes)
        encoding.__utf8_validate(bytes) ?? {
            self.allocation.release(capacity)
            return Err(stream_error(.Syntax, start, self.line, self.column, "JSON number is not valid UTF-8"))
        }
        text := ""
        #Unsafe("the shared UTF-8 validator just accepted this owned ASCII token") {
            text = encoding.__bytes_into_text(^bytes)
        }
        if self.typed_numbers {
            self.output_heap = capacity
            #Unsafe("retain a validated number lexeme in the private event carrier until typed decoding") {
                return Ok(DataEvent.Number(text))
            }
        }
        if parse_int64(text) == .Val(value) {
            self.allocation.release(capacity)
            return Ok(DataEvent.Int(value))
        }
        value :: Float.parse(text) ?? {
            self.allocation.release(capacity)
            return Err(stream_error(.Unsupported, start, self.line, self.column, "JSON number is outside the Dyn numeric range"))
        }
        self.allocation.release(capacity)
        if !math.is_finite(value) -> return Err(stream_error(.Unsupported, start, self.line, self.column, "JSON number is outside the Dyn numeric range"))
        Ok(DataEvent.Float(value))
    }

    fn number_bytes(&self, bytes: &[U8], first: U8) EncodingError! -[IO, Time.Wait]> {
        &self.append(&bytes, first, "number")
        loop {
            byte :: &self.fill()
            if byte == None -> return
            got :: byte
            n :: Int.from_u8(got)
            if !((n >= 48 && n <= 57) || n == 45 || n == 43 || n == 46 || n == 101 || n == 69) -> return
            &self.append(&bytes, got, "number")
            _ :: &self.consume()
        }
    }

    fn literal(&self, tail: [U8#4], count: Int, value: DataEvent) -[IO, Time.Wait]> DataEvent EncodingError! {
        loop i in 0..<count -> &self.expect(tail[i], "JSON literal")
        Ok(value)
    }

    fn push_frame(&self, frame: ReadFrame) EncodingError! {
        count :: self.frames.len()
        if count >= mem.__list_capacity<ReadFrame>(self.frames) {
            capacity :: mem.__list_capacity<ReadFrame>(self.frames)
            next_capacity :: if capacity == 0 -> 1 else -> capacity * 2
            if !reserve<ReadFrame>(self.allocation, &self.frames, next_capacity - count) -> return Err(self.error(.Limit, "JSON reader frame allocation exceeded the bounded codec heap ceiling"))
        }
        &self.frames.push(frame)
    }

    fn parse_value(&self) -[IO, Time.Wait]> DataEvent EncodingError! {
        &self.skip_ws()
        first :: &self.consume()
        if first == None -> return Err(self.error(.Truncated, "expected a JSON value"))
        byte :: first
        if byte == (U8{110}) -> return &self.literal([U8#4]{117, 108, 108, 0}, 3, DataEvent.Null)
        if byte == (U8{116}) -> return &self.literal([U8#4]{114, 117, 101, 0}, 3, DataEvent.Bool(true))
        if byte == (U8{102}) -> return &self.literal([U8#4]{97, 108, 115, 101}, 4, DataEvent.Bool(false))
        if byte == (U8{34}) {
            self.lookahead = Val(byte)
            self.offset -= 1
            self.total -= 1
            self.column -= 1
            text :: &self.read_string()
            return Ok(DataEvent.Text(text))
        }
        if byte == (U8{91}) || byte == (U8{123}) {
            if self.frames.len() >= self.limits.max_depth -> return Err(stream_error(.Limit, self.offset - 1, self.line, self.column - 1, "max_depth {self.limits.max_depth} exceeded"))
            if byte == (U8{91}) {
                &self.push_frame(.ArrayValueOrEnd{first: true, index: U64{0}})
                return Ok(DataEvent.ArrayStart)
            }
            &self.push_frame(.ObjectKeyOrEnd(true))
            return Ok(DataEvent.ObjectStart)
        }
        if byte == (U8{45}) || (byte >= (U8{48}) && byte <= (U8{57})) -> return &self.number(byte)
        return Err(stream_error(.Syntax, self.offset - 1, self.line, self.column - 1, "unexpected byte {debug_byte(byte)} while reading a JSON value"))
    }

    fn next_inner(&self) -[IO, Time.Wait]> DataEvent? EncodingError! {
        if self.eof -> return Ok(None)
        loop {
            &self.skip_ws()
            count :: self.frames.len()
            if count == 0 {
                if !self.root_started {
                    self.root_started = true
                    value :: &self.parse_value()
                    return Ok(Val(value))
                }
                byte :: &self.fill()
                if byte == None {
                    self.eof = true
                    return Ok(None)
                }
                if self.record_mode {
                    if byte == (Val(U8{13})) {
                        _ :: &self.consume()
                        if &self.fill() != (Val(U8{10})) -> return Err(stream_error(.Syntax, self.offset - 1, self.line, self.column - 1, "JSONL records use LF or CRLF; bare CR is not a record ending"))
                    } else if byte != (Val(U8{10})) -> return Err(self.error(.Syntax, "trailing input after JSONL record value"))
                    _ :: &self.consume()
                    self.root_started = false
                    return Ok(None)
                }
                return Err(self.error(.Syntax, "trailing input after JSON root"))
            }
            frame :: self.frames[count - 1]
            if frame == {
                .ArrayValueOrEnd(first, index) -> {
                    byte :: &self.fill()
                    if byte == (Val(U8{93})) {
                        if !first -> return Err(self.error(.Syntax, "expected a JSON value after `,`"))
                        _ :: &self.consume()
                        _ :: &self.frames.pop()
                        return Ok(Val(DataEvent.ArrayEnd))
                    }
                    if !first && byte == None -> return Err(self.error(.Truncated, "unterminated JSON array"))
                    self.frames[count - 1] = .ArrayCommaOrEnd(index)
                    event :: &self.parse_value()
                    return Ok(Val(event))
                }
                .ArrayCommaOrEnd(index) -> {
                    byte :: &self.fill()
                    if byte == (Val(U8{44})) {
                        _ :: &self.consume()
                        self.frames[count - 1] = .ArrayValueOrEnd{first: false, index: index + U64{1}}
                    } else if byte == (Val(U8{93})) {
                        _ :: &self.consume()
                        _ :: &self.frames.pop()
                        return Ok(Val(DataEvent.ArrayEnd))
                    } else {
                        if byte == None -> return Err(self.error(.Truncated, "unterminated JSON array"))
                        return Err(self.error(.Syntax, "expected `,` or `]` after array value"))
                    }
                }
                .ObjectKeyOrEnd(first) -> {
                    byte :: &self.fill()
                    if byte == (Val(U8{125})) {
                        if !first -> return Err(self.error(.Syntax, "expected an object key after `,`"))
                        _ :: &self.consume()
                        _ :: &self.frames.pop()
                        return Ok(Val(DataEvent.ObjectEnd))
                    }
                    if !first && byte == None -> return Err(self.error(.Truncated, "unterminated JSON object"))
                    if byte != (Val(U8{34})) -> return Err(self.error(.Syntax, "expected a quoted object key"))
                    key :: &self.read_string()
                    heap :: key.count_bytes()
                    if !self.allocation.charge(heap) -> return Err(self.item_error("string"))
                    self.frames[count - 1] = .ObjectColonValue{key: key.copy(), key_heap: U64{heap}}
                    return Ok(Val(DataEvent.Key(key)))
                }
                .ObjectColonValue(_, heap) -> {
                    // Retire and replace the top frame in its reserved slot:
                    // the key moves once before mutating the input cursor.
                    owned :: &self.frames.pop() ?? panic("matched JSON object frame")
                    if ^owned == {
                        .ObjectColonValue(key, _) -> {
                            &self.frames.push(ReadFrame.ObjectCommaOrEnd{key: ^key, key_heap: heap})
                        }
                        else -> panic("matched JSON colon frame")
                    }
                    &self.expect(U8{58}, "`:` after object key")
                    event :: &self.parse_value()
                    return Ok(Val(event))
                }
                .ObjectCommaOrEnd(_, heap) -> {
                    byte :: &self.fill()
                    if byte == (Val(U8{44})) {
                        _ :: &self.consume()
                        self.frames[count - 1] = .ObjectKeyOrEnd(false)
                        self.allocation.release(Int.from_u64(heap))
                    } else if byte == (Val(U8{125})) {
                        _ :: &self.consume()
                        _ :: &self.frames.pop()
                        self.allocation.release(Int.from_u64(heap))
                        return Ok(Val(DataEvent.ObjectEnd))
                    } else {
                        if byte == None -> return Err(self.error(.Truncated, "unterminated JSON object"))
                        return Err(self.error(.Syntax, "expected `,` or `}}` after object value"))
                    }
                }
            }
        }
    }

    fn fold_charge(self, bytes: Int, heap: &FoldBudget) EncodingError! {
        if heap.decoded + bytes > self.limits.max_item_bytes -> return Err(self.item_error("record"))
        heap.decoded += bytes
    }

    fn fold_text(self, value: ^String, heap: &FoldBudget) -> String EncodingError! {
        self.fold_charge(value.count_bytes(), &heap)
        #Unsafe("transfer already validated UTF-8 storage to inspect its actual owned capacity") {
            bytes :: encoding.__text_into_bytes(^value)
            capacity :: mem.__list_capacity<U8>(bytes)
            if !self.allocation.charge(capacity) -> return Err(self.item_error("record"))
            heap.tracked += capacity
            return Ok(encoding.__bytes_into_text(^bytes))
        }
    }


    fn fold(&self, event: ^DataEvent, heap: &FoldBudget) -[IO, Time.Wait]> Dyn EncodingError! {
        #Unsafe("the private numeric event is projected only into the matching typed tree carrier") {
            if event == .Number(value) {
                text :: self.fold_text(^value, &heap)
                return Ok(Dyn.Number(text))
            }
        }
        if event == {
            .Null -> {
                self.fold_charge(1, &heap)
                return Ok(Dyn.Null)
            }
            .Bool(value) -> {
                self.fold_charge(1, &heap)
                return Ok(Dyn.Bool(value))
            }
            .Int(value) -> {
                self.fold_charge(8, &heap)
                return Ok(Dyn.Int(value))
            }
            .Float(value) -> {
                self.fold_charge(8, &heap)
                return Ok(Dyn.Float(value))
            }
            .Text(value) -> {
                text :: self.fold_text(^value, &heap)
                return Ok(Dyn.Text(text))
            }
            .ArrayStart -> {
                values := [Dyn]{}
                loop {
                    child :: &self.next()
                    if child == None -> return Err(self.error(.Truncated, "unterminated JSON array"))
                    item :: child
                    if item == .ArrayEnd -> return Ok(Dyn.Array(values))
                    value :: &self.fold(^item, &heap)
                    fold_reserve<Dyn>(self, &values, &heap)
                    &values.push(value)
                }
            }
            .ObjectStart -> {
                entries := [(key: String, value: Dyn)]{}
                loop {
                    child :: &self.next()
                    if child == None -> return Err(self.error(.Truncated, "unterminated JSON object"))
                    item :: child
                    if item == .ObjectEnd -> return Ok(object_from_entries(^entries))
                    if item == .Key(key) {
                        loop entry in entries {
                            if entry.key == key -> return Err(self.error(.Syntax, "duplicate object key `{key}`"))
                        }
                        owned_key :: self.fold_text(^key, &heap)
                        first :: &self.next()
                        if first == None -> return Err(self.error(.Truncated, "object key has no value"))
                        value :: &self.fold(^first, &heap)
                        fold_reserve<(key: String, value: Dyn)>(self, &entries, &heap)
                        &entries.push((key: owned_key, value: value))
                    } else { return Err(self.error(.State, "expected an object key")) }
                }
            }
            else -> return Err(self.error(.State, "expected a JSON value"))
        }
    }
}

fn fold_reserve<T>(parser: JSONPull, values: &[T], heap: &FoldBudget) EncodingError! {
    old :: mem.__list_capacity<T>(values) * mem.__type_size<T>()
    additional :: if values.len() == mem.__list_capacity<T>(values) -> if values.len() == 0 -> 1 else -> values.len() else -> 0
    if additional == 0 -> return
    if !reserve<T>(parser.allocation, &values, additional) {
        heap.tracked -= old
        return Err(parser.item_error("record"))
    }
    heap.tracked += mem.__list_capacity<T>(values) * mem.__type_size<T>() - old
}

fn json_reader(input: ^FileReader, limits: EncodingLimits) -> JSONPull EncodingError! {
    validate_limits(limits)
    Ok(JSONPull{input: input, limits: limits, total: 0, offset: 0, line: 1, column: 1, lookahead: None, frames: [ReadFrame]{}, root_started: false, eof: false, record_mode: false, typed_numbers: false, terminal: None, allocation: budget(limits), output_heap: 0})
}

fn valid_number(bytes: [U8]) -> Bool Never! {
    i := 0
    if bytes.len() > 0 && bytes[0] == (U8{45}) -> i = 1
    if i >= bytes.len() -> return false
    if bytes[i] == (U8{48}) -> i += 1
    else if bytes[i] >= (U8{49}) && bytes[i] <= (U8{57}) {
        i += 1
        loop i < bytes.len() && bytes[i] >= (U8{48}) && bytes[i] <= (U8{57}) -> i += 1
    } else { return false }
    if i < bytes.len() && bytes[i] == (U8{46}) {
        i += 1
        start :: i
        loop i < bytes.len() && bytes[i] >= (U8{48}) && bytes[i] <= (U8{57}) -> i += 1
        if i == start -> return false
    }
    if i < bytes.len() && (bytes[i] == (U8{101}) || bytes[i] == (U8{69})) {
        i += 1
        if i < bytes.len() && (bytes[i] == (U8{43}) || bytes[i] == (U8{45})) -> i += 1
        start :: i
        loop i < bytes.len() && bytes[i] >= (U8{48}) && bytes[i] <= (U8{57}) -> i += 1
        if i == start -> return false
    }
    i == bytes.len()
}

fn debug_byte(byte: U8) -> String Never! {
    n :: Int.from_u8(byte)
    if n == 39 -> return "'\\''"
    if n == 34 -> return "'\"'"
    bytes := [U8]{}
    if n < 128 -> &bytes.push(byte)
    else {
        &bytes.push(U8{(192).bit_or((n >> 6))})
        &bytes.push(U8{(128).bit_or((n.bit_and(63)))})
    }
    shown :: (String.from_bytes(bytes) ?? "").debug()
    "'{shown.slice(1, shown.len() - 1)}'"
}

fn quote_path(text: String) -> String Never! { text.debug() }
// RFC 8785 admits an Int only when binary64 holds it exactly: its odd part
// must fit in the 53-bit significand.
fn int_is_binary64(n: Int) -> Bool Never! {
    odd := n
    loop odd != 0 && odd %% 2 == 0 {
        odd = odd /% 2
    }
    if odd < 0 -> odd = -odd
    odd <= 9007199254740992
}

// ECMAScript Number::toString (ECMA-262 7.1.12.1) for a finite binary64, as
// RFC 8785 requires. `"{value}"` supplies the shortest round-trip digits; this
// function only re-spells them: exponent form below 1e-6 and from 1e21,
// positional otherwise, `e+`/`e-` exponents, and `-0` as `0`.
fn jcs_number(value: Float) -> String Never! {
    if value == (Float{0.0}) -> return "0"
    negative :: value < (Float{0.0})
    magnitude := value
    if negative -> magnitude = -value
    digits := [U8]{}
    exponent_bytes := [U8]{}
    decimal := -1
    in_exponent := false
    loop b in "{magnitude}".bytes() {
        if in_exponent {
            &exponent_bytes.push(b)
            next
        }
        if b == (U8{101}) || b == (U8{69}) {
            in_exponent = true
            next
        }
        if b == (U8{46}) {
            decimal = digits.len()
            next
        }
        &digits.push(b)
    }
    if decimal < 0 -> decimal = digits.len()
    exponent := 0
    if exponent_bytes.len() > 0 -> exponent = Int.parse(String.from_bytes(exponent_bytes) ?? "0") ?? 0
    leading := 0
    loop leading < digits.len() && digits[leading] == (U8{48}) {
        leading += 1
    }
    significant := [U8]{}
    loop i in leading..<digits.len() -> &significant.push(digits[i])
    loop significant.len() > 1 && significant[significant.len() - 1] == (U8{48}) {
        _ :: &significant.pop()
    }
    n :: decimal + exponent - leading
    k :: significant.len()
    out := [U8]{}
    if negative -> &out.push(U8{45})
    if n > 0 && n <= 21 {
        if k <= n {
            loop b in significant -> &out.push(b)
            loop _ in 0..<(n - k) -> &out.push(U8{48})
        } else {
            loop i in 0..<n -> &out.push(significant[i])
            &out.push(U8{46})
            loop i in n..<k -> &out.push(significant[i])
        }
        return String.from_bytes(out) ?? ""
    }
    if n > -6 && n <= 0 {
        write_ascii(&out, "0.")
        loop _ in 0..<(0 - n) -> &out.push(U8{48})
        loop b in significant -> &out.push(b)
        return String.from_bytes(out) ?? ""
    }
    &out.push(significant[0])
    if k > 1 {
        &out.push(U8{46})
        loop i in 1..<k -> &out.push(significant[i])
    }
    &out.push(U8{101})
    e :: n - 1
    if e >= 0 -> &out.push(U8{43})
    write_ascii(&out, "{e}")
    String.from_bytes(out) ?? ""
}

// UTF-16 code units of a key, the RFC 8785 sort order.
fn utf16_units(text: String) -> [Int] Never! {
    units := [Int]{}
    bytes :: text.bytes()
    length :: bytes.len()
    i := 0
    loop i < length {
        b :: Int.from_u8(bytes[i])
        cp := b
        width := 1
        if b >= 240 {
            cp = ((b.bit_and(7)) << 18).bit_or(((Int.from_u8(bytes[i + 1]).bit_and(63)) << 12)).bit_or(((Int.from_u8(bytes[i + 2]).bit_and(63)) << 6)).bit_or((Int.from_u8(bytes[i + 3]).bit_and(63)))
            width = 4
        }
        if b >= 224 && b < 240 {
            cp = ((b.bit_and(15)) << 12).bit_or(((Int.from_u8(bytes[i + 1]).bit_and(63)) << 6)).bit_or((Int.from_u8(bytes[i + 2]).bit_and(63)))
            width = 3
        }
        if b >= 192 && b < 224 {
            cp = ((b.bit_and(31)) << 6).bit_or((Int.from_u8(bytes[i + 1]).bit_and(63)))
            width = 2
        }
        if cp >= 65536 {
            &units.push(55296 + ((cp - 65536) >> 10))
            &units.push(56320 + ((cp - 65536).bit_and(1023)))
        } else {
            &units.push(cp)
        }
        i += width
    }
    units
}

fn compare_units(left: [Int], right: [Int]) -> Int Never! {
    n := left.len()
    if right.len() < n -> n = right.len()
    loop i in 0..<n {
        if left[i] < right[i] -> return -1
        if left[i] > right[i] -> return 1
    }
    if left.len() < right.len() -> return -1
    if left.len() > right.len() -> return 1
    0
}

// Stable bottom-up merge sort of key indices: O(n log n) comparisons.
fn sort_by_units(units: [[Int]]) -> [Int] Never! {
    order := [Int]{}
    loop i in 0..<units.len() -> &order.push(i)
    width := 1
    loop width < order.len() {
        merged := [Int]{}
        start := 0
        loop start < order.len() {
            middle := start + width
            if middle > order.len() -> middle = order.len()
            end := start + 2 * width
            if end > order.len() -> end = order.len()
            left := start
            right := middle
            loop left < middle || right < end {
                take_left := right >= end
                if !take_left && left < middle -> take_left = compare_units(units[order[left]], units[order[right]]) <= 0
                if take_left {
                    &merged.push(order[left])
                    left += 1
                } else {
                    &merged.push(order[right])
                    right += 1
                }
            }
            start = end
        }
        order = merged
        width = width * 2
    }
    order
}

fn text_from_bytes(bytes: ^[U8]) -> String EncodingError! {
    encoding.__utf8_validate(bytes) ?? return Err(stream_error(.Syntax, 0, 1, 1, err))
    #Unsafe("the shared UTF-8 validator just accepted this owned allocation") {
        return Ok(encoding.__bytes_into_text(^bytes))
    }
}

fn byte_at(text: String, index: Int) -> U8 Never! {
    length :: text.count_bytes()
    if index < 0 || index >= length -> panic("the list has {length} items, so position {index} doesn't exist")
    result := U8{0}
    #Unsafe("the byte position was checked against this String's storage length") {
        result = encoding.__string_byte(text, U64{index})
    }
    result
}

fn write_ascii(out: &[U8], text: String) Never! {
    loop b in text.bytes() -> &out.push(b)
}

enum WriteFrame {
    Array(Bool)
    ObjectKey(Bool)
    ObjectValue
}

struct CanonicalFrame {
    is_object: Bool
    first: Bool
    entries: [(key: String, value: [U8])]
    key: String?
    value: [U8]
    retained: U64
}

struct JSONPush {
    output: FileWriter
    limits: EncodingLimits
    frames: [WriteFrame]
    root_written: Bool
    finished: Bool
    terminal: EncodingError?
    total: Int
    canonical: Bool
    canonical_frames: [CanonicalFrame]
    canonical_retained: Int

    fn error(self, kind: EncodingErrorKind, reason: String) -> EncodingError Never! {
        stream_error(kind, self.total, 1, self.total + 1, reason)
    }

    fn state_error(self, reason: String) -> EncodingError Never! { self.error(.State, reason) }

    fn discard(&self) Never! {
        self.frames = [WriteFrame]{}
        self.canonical_frames = [CanonicalFrame]{}
        self.canonical_retained = 0
    }

    fn ensure_total(self, additional: Int) EncodingError! {
        if self.limits.max_total_bytes == .Val(max) {
            if self.total + additional > max -> return Err(self.error(.Limit, "max_total_bytes {max} exceeded"))
        }
    }

    fn write_bytes(&self, bytes: View<U8>) EncodingError! -[IO]> {
        self.ensure_total(bytes.len())
        encoding.__write_bytes(&self.output, bytes) ?? return Err(io_error(self.total, 1, self.total + 1, err))
        self.total += bytes.len()
    }

    fn write_byte(&self, value: U8) EncodingError! -[IO]> {
        buffer :: [U8#1]{value}
        window :: buffer[0..<1]
        &self.write_bytes(window)
    }

    fn write_literal(&self, bytes: [U8#5], count: Int) EncodingError! -[IO]> {
        window :: bytes[0..<count]
        &self.write_bytes(window)
    }

    fn canonical_byte(&self, value: U8) EncodingError! -[IO]> {
        buffer :: [U8#1]{value}
        window :: buffer[0..<1]
        &self.canonical_emit(window)
    }

    fn write_text(&self, text: String) EncodingError! -[IO]> {
        self.ensure_total(text.count_bytes())
        encoding.__write_text(&self.output, text) ?? return Err(io_error(self.total, 1, self.total + 1, err))
        self.total += text.count_bytes()
    }

    fn quoted_len(self, text: String) -> Int EncodingError! {
        size := 0
        loop i in 0..<text.count_bytes() {
            byte :: Int.from_u8(byte_at(text, i))
            size += if byte == 34 || byte == 92 || byte == 10 || byte == 13 || byte == 9 || byte == 8 || byte == 12 -> 2 else if byte < 32 -> 6 else -> 1
        }
        if size > self.limits.max_item_bytes -> return Err(self.error(.Limit, "max_item_bytes {self.limits.max_item_bytes} exceeded"))
        Ok(size)
    }

    fn quote_into(self, out: &[U8], text: String) Never! {
        &out.push(U8{34})
        i := 0
        loop i < text.count_bytes() {
            scratch := [U8#6]{0, 0, 0, 0, 0, 0}
            count :: escaped_unit(text, i, &scratch)
            loop j in 0..<count -> &out.push(scratch[j])
            i += scalar_width(byte_at(text, i))
        }
        &out.push(U8{34})
    }

    fn write_quoted(&self, text: String) EncodingError! -[IO]> {
        _ :: self.quoted_len(text)
        &self.write_byte(U8{34})
        i := 0
        loop i < text.count_bytes() {
            scratch := [U8#6]{0, 0, 0, 0, 0, 0}
            count :: escaped_unit(text, i, &scratch)
            window :: scratch[0..<count]
            &self.write_bytes(window)
            i += scalar_width(byte_at(text, i))
        }
        &self.write_byte(U8{34})
    }

    fn value_prefix_len(self) -> Int EncodingError! {
        if self.frames.len() == 0 {
            if self.root_written -> return Err(self.state_error("JSON writer accepts exactly one root"))
            return Ok(0)
        }
        if self.frames[self.frames.len() - 1] == {
            .Array(first) -> Ok(if first -> 0 else -> 1)
            .ObjectValue -> Ok(0)
            .ObjectKey(_) -> Err(self.state_error("JSON object expects Key before a value"))
        }
    }

    fn before_value(&self) EncodingError! -[IO]> {
        if self.frames.len() == 0 {
            if self.root_written -> return Err(self.state_error("JSON writer accepts exactly one root"))
            self.root_written = true
            return
        }
        at :: self.frames.len() - 1
        if self.frames[at] == {
            .Array(first) -> {
                if !first -> &self.write_byte(U8{44})
                self.frames[at] = .Array(false)
            }
            .ObjectValue -> self.frames[at] = .ObjectKey(false)
            .ObjectKey(_) -> return Err(self.state_error("JSON object expects Key before a value"))
        }
    }

    fn write(&self, event: ^DataEvent) EncodingError! -[IO]> {
        if self.terminal == .Val(error) -> return Err(error)
        if self.canonical {
            &self.write_canonical(^event) ?? {
                &self.discard()
                self.terminal = Val(err)
                return Err(err)
            }
        } else {
            &self.write_normal(^event) ?? {
                &self.discard()
                self.terminal = Val(err)
                return Err(err)
            }
        }
    }

    fn write_normal(&self, event: ^DataEvent) EncodingError! -[IO]> {
        if self.finished -> return Err(self.state_error("write called after finish"))
        if event == {
            .Key(key) -> {
                if self.frames.len() == 0 -> return Err(self.state_error("Key is only valid while an object expects a key"))
                at :: self.frames.len() - 1
                first := false
                if self.frames[at] == .ObjectKey(is_first) {
                    first = is_first
                } else {
                    return Err(self.state_error("Key is only valid while an object expects a key"))
                }
                inner :: self.quoted_len(key)
                self.ensure_total(inner + 3 + if first -> 0 else -> 1)
                if !first -> &self.write_byte(U8{44})
                &self.write_quoted(key)
                &self.write_byte(U8{58})
                self.frames[at] = .ObjectValue
                return
            }
            .ArrayEnd -> {
                if self.frames.len() == 0 -> return Err(self.state_error("ArrayEnd does not match an open array"))
                if self.frames[self.frames.len() - 1] == {
                    .Array(_) -> {}
                    else -> return Err(self.state_error("ArrayEnd does not match an open array"))
                }
                &self.write_byte(U8{93})
                _ :: &self.frames.pop()
                return
            }
            .ObjectEnd -> {
                if self.frames.len() == 0 -> return Err(self.state_error("ObjectEnd does not match an open object"))
                if self.frames[self.frames.len() - 1] == .ObjectValue -> return Err(self.state_error("object key has no value"))
                if self.frames[self.frames.len() - 1] == {
                    .ObjectKey(_) -> {}
                    else -> return Err(self.state_error("ObjectEnd does not match an open object"))
                }
                &self.write_byte(U8{125})
                _ :: &self.frames.pop()
                return
            }
            else -> {}
        }
        payload := ""
        size := 0
        if event == {
            .Null -> size = 4
            .Bool(value) -> size = if value -> 4 else -> 5
            .Int(value) -> {
                payload = "{value}"
                size = payload.count_bytes()
            }
            .Float(value) -> {
                if !math.is_finite(value) -> return Err(self.error(.Unsupported, "JSON cannot encode a non-finite Float"))
                payload = wire_float(value)
                size = payload.count_bytes()
            }
            .Text(value) -> size = self.quoted_len(value) + 2
            .ArrayStart | .ObjectStart -> {
                if self.frames.len() >= self.limits.max_depth -> return Err(self.error(.Limit, "max_depth {self.limits.max_depth} exceeded"))
                size = 1
            }
            else -> return Err(self.error(.Unsupported, "internal JSON carriers cannot be written as DataEvent values"))
        }
        self.ensure_total(self.value_prefix_len() + size)
        &self.before_value()
        if event == {
            .Null -> &self.write_literal([U8#5]{110, 117, 108, 108, 0}, 4)
            .Bool(value) -> {
                if value -> &self.write_literal([U8#5]{116, 114, 117, 101, 0}, 4)
                else -> &self.write_literal([U8#5]{102, 97, 108, 115, 101}, 5)
            }
            .Text(value) -> &self.write_quoted(value)
            .ArrayStart -> {
                &self.write_byte(U8{91})
                &self.frames.push(.Array(true))
            }
            .ObjectStart -> {
                &self.write_byte(U8{123})
                &self.frames.push(.ObjectKey(true))
            }
            else -> &self.write_text(payload)
        }
    }

    fn canonical_charge(&self, at: Int, bytes: Int) EncodingError! {
        updated :: self.canonical_retained + bytes
        ceiling :: self.limits.max_item_bytes * 2 + self.limits.buffer_bytes + self.limits.max_depth * 128
        if updated > ceiling -> return Err(self.error(.Limit, "canonical JSON workspace exceeded bounded max_item_bytes {self.limits.max_item_bytes}"))
        self.canonical_frames[at].retained += U64{bytes}
        self.canonical_retained = updated
    }

    fn canonical_sink(self) -> Int? Never! {
        at := self.canonical_frames.len()
        loop at > 0 {
            at -= 1
            if self.canonical_frames[at].is_object -> return Val(at)
        }
        None
    }

    fn canonical_emit(&self, bytes: View<U8>) EncodingError! -[IO]> {
        if self.canonical_sink() == .Val(at) {
            needed :: self.canonical_frames[at].value.len() + bytes.len()
            if needed > self.limits.max_item_bytes -> return Err(self.error(.Limit, "max_item_bytes {self.limits.max_item_bytes} exceeded by canonical object"))
            capacity :: mem.__list_capacity<U8>(self.canonical_frames[at].value)
            growth :: if needed > capacity -> needed - capacity else -> 0
            &self.canonical_charge(at, growth)
            if growth > 0 && !mem.__list_reserve_exact<U8>(&self.canonical_frames[at].value, growth) -> return Err(self.error(.Limit, "canonical JSON object allocation failed within configured bounds"))
            loop byte in bytes -> &self.canonical_frames[at].value.push(byte)
        } else { &self.write_bytes(bytes) }
    }

    fn canonical_quote(self, text: String) -> [U8] EncodingError! {
        size :: self.quoted_len(text) + 2
        out := [U8]{}
        if !mem.__list_reserve_exact<U8>(&out, size) -> return Err(self.error(.Limit, "canonical JSON string allocation failed within configured bounds"))
        self.quote_into(&out, text)
        Ok(out)
    }

    fn canonical_before_value(&self) EncodingError! -[IO]> {
        if self.canonical_frames.len() == 0 {
            if self.root_written -> return Err(self.state_error("JSON writer accepts exactly one root"))
            self.root_written = true
            return
        }
        at :: self.canonical_frames.len() - 1
        if !self.canonical_frames[at].is_object {
            if !self.canonical_frames[at].first -> &self.canonical_byte(U8{44})
            self.canonical_frames[at].first = false
        } else {
            if self.canonical_frames[at].key == None -> return Err(self.state_error("canonical JSON object expects Key before a value"))
            if self.canonical_frames[at].value.len() != 0 -> return Err(self.state_error("canonical JSON object value is already active"))
        }
    }

    fn canonical_complete_value(&self) EncodingError! {
        if self.canonical_frames.len() == 0 -> return
        at :: self.canonical_frames.len() - 1
        if !self.canonical_frames[at].is_object || self.canonical_frames[at].key == None -> return
        capacity :: mem.__list_capacity<(key: String, value: [U8])>(self.canonical_frames[at].entries)
        length :: self.canonical_frames[at].entries.len()
        growth :: if length == capacity -> (if capacity < 1 -> 2 else -> capacity * 2) - capacity else -> 0
        bytes :: growth * mem.__type_size<(key: String, value: [U8])>()
        &self.canonical_charge(at, bytes)
        if growth > 0 && !mem.__list_reserve_exact<(key: String, value: [U8])>(&self.canonical_frames[at].entries, growth) -> return Err(self.error(.Limit, "canonical JSON entry allocation failed within configured bounds"))
        frame := &self.canonical_frames.pop() ?? panic("canonical value requires an active object frame")
        key :: ^frame.key ?? ""
        value :: ^frame.value
        frame.key = None
        frame.value = [U8]{}
        &frame.entries.push((key: key, value: value))
        &self.canonical_frames.push(^frame)
    }

    fn canonical_render_object(&self) -> [U8] EncodingError! {
        frame := &self.canonical_frames.pop() ?? return Err(self.state_error("ObjectEnd does not match a complete canonical object"))
        if !frame.is_object || frame.key != None -> return Err(self.state_error("ObjectEnd does not match a complete canonical object"))
        if frame.value.len() != 0 -> return Err(self.state_error("canonical JSON object value was not completed"))
        &frame.entries.sort_by((left: (key: String, value: [U8]), right: (key: String, value: [U8])) -> {
            comparison :: compare_text_units(left.key, right.key)
            if comparison < 0 -> .Less else if comparison > 0 -> .Greater else -> .Equal
        })
        loop i in 1..<frame.entries.len() {
            if frame.entries[i - 1].key == frame.entries[i].key {
                self.canonical_retained -= Int.from_u64(frame.retained)
                return Err(self.error(.Syntax, "JCS requires unique object keys"))
            }
        }
        size := 2
        quoted := [[U8]]{}
        loop i in 0..<frame.entries.len() {
            text :: self.canonical_quote(frame.entries[i].key)
            size += (if i > 0 -> 1 else -> 0) + text.len() + 1 + frame.entries[i].value.len()
            &quoted.push(text)
        }
        if size > self.limits.max_item_bytes {
            self.canonical_retained -= Int.from_u64(frame.retained)
            return Err(self.error(.Limit, "max_item_bytes {self.limits.max_item_bytes} exceeded by canonical object"))
        }
        out := [U8]{}
        if !mem.__list_reserve_exact<U8>(&out, size) {
            self.canonical_retained -= Int.from_u64(frame.retained)
            return Err(self.error(.Limit, "canonical JSON object allocation failed within configured bounds"))
        }
        &out.push(U8{123})
        loop i in 0..<frame.entries.len() {
            if i > 0 -> &out.push(U8{44})
            loop byte in quoted[i] -> &out.push(byte)
            &out.push(U8{58})
            loop byte in frame.entries[i].value -> &out.push(byte)
        }
        &out.push(U8{125})
        self.canonical_retained -= Int.from_u64(frame.retained)
        Ok(out)
    }

    fn write_canonical(&self, event: ^DataEvent) EncodingError! -[IO]> {
        if self.finished -> return Err(self.state_error("write called after finish"))
        if event == {
            .Key(key) -> {
                if self.canonical_frames.len() == 0 -> return Err(self.state_error("Key is only valid while an object expects a key"))
                at :: self.canonical_frames.len() - 1
                if !self.canonical_frames[at].is_object -> return Err(self.state_error("Key is only valid while an object expects a key"))
                if self.canonical_frames[at].key != None -> return Err(self.state_error("canonical JSON object key has no value"))
                loop entry in self.canonical_frames[at].entries {
                    if entry.key == key -> return Err(self.error(.Syntax, "JCS requires unique object keys"))
                }
                &self.canonical_charge(at, key.count_bytes())
                self.canonical_frames[at].key = Val(key)
                return
            }
            .ArrayEnd -> {
                if self.canonical_frames.len() == 0 || self.canonical_frames[self.canonical_frames.len() - 1].is_object -> return Err(self.state_error("ArrayEnd does not match an open array"))
                &self.canonical_byte(U8{93})
                _ :: &self.canonical_frames.pop()
                &self.canonical_complete_value()
                return
            }
            .ObjectEnd -> {
                if self.canonical_frames.len() == 0 -> return Err(self.state_error("ObjectEnd does not match an open object"))
                at :: self.canonical_frames.len() - 1
                if self.canonical_frames[at].is_object && self.canonical_frames[at].key != None -> return Err(self.state_error("object key has no value"))
                if !self.canonical_frames[at].is_object -> return Err(self.state_error("ObjectEnd does not match an open object"))
                object :: &self.canonical_render_object()
                window :: object[0..<object.len()]
                &self.canonical_emit(window)
                &self.canonical_complete_value()
                return
            }
            else -> {}
        }
        if (event == .ArrayStart || event == .ObjectStart) && self.canonical_frames.len() >= self.limits.max_depth -> return Err(self.error(.Limit, "max_depth {self.limits.max_depth} exceeded"))
        encoded := [U8]{}
        if event == {
            .Null -> encoded = [U8]{110, 117, 108, 108}
            .Bool(value) -> encoded = if value -> [U8]{116, 114, 117, 101} else -> [U8]{102, 97, 108, 115, 101}
            .Int(value) -> {
                if !int_is_binary64(value) -> return Err(self.error(.Unsupported, "JCS requires Int exactly representable as IEEE 754 binary64; encode this integer as Text"))
                number :: jcs_number(Float{value})
                encoded = encoding.__text_into_bytes(^number)
            }
            .Float(value) -> {
                if !math.is_finite(value) -> return Err(self.error(.Unsupported, "JCS cannot encode a non-finite Float"))
                number :: jcs_number(value)
                encoded = encoding.__text_into_bytes(^number)
            }
            .Text(value) -> encoded = self.canonical_quote(value)
            .ArrayStart | .ObjectStart -> {}
            else -> return Err(self.error(.Unsupported, "internal JSON carriers cannot be written as DataEvent values"))
        }
        &self.canonical_before_value()
        if event == {
            .ArrayStart -> {
                &self.canonical_byte(U8{91})
                &self.canonical_frames.push(canonical_frame(false))
            }
            .ObjectStart -> &self.canonical_frames.push(canonical_frame(true))
            else -> {
                window :: encoded[0..<encoded.len()]
                &self.canonical_emit(window)
                &self.canonical_complete_value()
            }
        }
    }

    fn flush(&self) EncodingError! -[IO]> {
        if self.terminal == .Val(error) -> return Err(error)
        encoding.__flush(&self.output) ?? {
            error :: io_error(self.total, 1, self.total + 1, err)
            &self.discard()
            self.terminal = Val(error)
            return Err(error)
        }
    }

    fn finish(&self) EncodingError! -[IO]> {
        if self.terminal == .Val(error) -> return Err(error)
        if self.finished -> return
        open :: if self.canonical -> self.canonical_frames.len() != 0 else -> self.frames.len() != 0
        if !self.root_written || open {
            error :: self.state_error("finish requires one structurally complete JSON root")
            &self.discard()
            self.terminal = Val(error)
            return Err(error)
        }
        &self.flush()
        self.finished = true
    }
}

fn scalar_width(byte: U8) -> Int Never! {
    if byte < (U8{128}) -> 1 else if byte < (U8{224}) -> 2 else if byte < (U8{240}) -> 3 else -> 4
}

fn escaped_unit(text: String, at: Int, out: &[U8#6]) -> Int Never! {
    byte :: byte_at(text, at)
    n :: Int.from_u8(byte)
    if n == 34 || n == 92 || n == 10 || n == 13 || n == 9 || n == 8 || n == 12 {
        out[0] = U8{92}
        out[1] = if n == 10 -> U8{110} else if n == 13 -> U8{114} else if n == 9 -> U8{116} else if n == 8 -> U8{98} else if n == 12 -> U8{102} else -> byte
        return 2
    }
    if n < 32 {
        out[0] = U8{92}
        out[1] = U8{117}
        out[2] = U8{48}
        out[3] = U8{48}
        out[4] = encoding.hex_nibble(n >> 4)
        out[5] = encoding.hex_nibble(n.bit_and(15))
        return 6
    }
    width :: scalar_width(byte)
    loop i in 0..<width -> out[i] = byte_at(text, at + i)
    width
}

fn json_writer(output: ^FileWriter, limits: EncodingLimits, canonical: Bool) -> JSONPush EncodingError! {
    validate_limits(limits)
    Ok(JSONPush{output: output, limits: limits, frames: [WriteFrame]{}, root_written: false, finished: false, terminal: None, total: 0, canonical: canonical, canonical_frames: [CanonicalFrame]{}, canonical_retained: 0})
}

fn canonical_frame(is_object: Bool) -> CanonicalFrame Never! {
    CanonicalFrame{is_object: is_object, first: true, entries: [(key: String, value: [U8])]{}, key: None, value: [U8]{}, retained: U64{0}}
}

fn next_text_unit(text: String, at: Int) -> (unit: Int, position: Int, pending: Int) Never! {
    first :: Int.from_u8(byte_at(text, at))
    width :: scalar_width(U8{first})
    codepoint := first
    if width == 2 -> codepoint = ((first.bit_and(31)) << 6).bit_or((Int.from_u8(byte_at(text, at + 1)).bit_and(63)))
    else if width == 3 -> codepoint = ((first.bit_and(15)) << 12).bit_or(((Int.from_u8(byte_at(text, at + 1)).bit_and(63)) << 6)).bit_or((Int.from_u8(byte_at(text, at + 2)).bit_and(63)))
    else if width == 4 -> codepoint = ((first.bit_and(7)) << 18).bit_or(((Int.from_u8(byte_at(text, at + 1)).bit_and(63)) << 12)).bit_or(((Int.from_u8(byte_at(text, at + 2)).bit_and(63)) << 6)).bit_or((Int.from_u8(byte_at(text, at + 3)).bit_and(63)))
    if codepoint < 65536 -> return (unit: codepoint, position: at + width, pending: -1)
    (unit: 55296 + ((codepoint - 65536) >> 10), position: at + width, pending: 56320 + ((codepoint - 65536).bit_and(1023)))
}

fn compare_text_units(left: String, right: String) -> Int Never! {
    li := 0
    ri := 0
    lp := -1
    rp := -1
    loop {
        left_end :: li >= left.count_bytes() && lp < 0
        right_end :: ri >= right.count_bytes() && rp < 0
        if left_end && right_end -> return 0
        if left_end -> return -1
        if right_end -> return 1
        lu := lp
        ru := rp
        if lp >= 0 -> lp = -1
        else {
            decoded :: next_text_unit(left, li)
            lu = decoded.unit
            li = decoded.position
            lp = decoded.pending
        }
        if rp >= 0 -> rp = -1
        else {
            decoded :: next_text_unit(right, ri)
            ru = decoded.unit
            ri = decoded.position
            rp = decoded.pending
        }
        if lu < ru -> return -1
        if lu > ru -> return 1
    }
}

fn parse_int64(text: String) -> Int? Never! {
    length :: text.count_bytes()
    if length == 0 || length > 20 -> return None
    negative :: byte_at(text, 0) == (U8{45})
    at := if negative -> 1 else -> 0
    if at == length -> return None
    magnitude := U64{0}
    loop at < length {
        byte :: Int.from_u8(byte_at(text, at))
        if byte < 48 || byte > 57 -> return None
        digit :: U64{byte - 48}
        if magnitude > (U64{922337203685477580}) -> return None
        if magnitude == (U64{922337203685477580}) && digit > (if negative -> U64{8} else -> U64{7}) -> return None
        magnitude = magnitude * U64{10} + digit
        at += 1
    }
    if negative {
        if magnitude == (U64{9223372036854775808}) -> return Val(-9223372036854775808)
        return Val(-Int.from_u64(magnitude))
    }
    Val(Int.from_u64(magnitude))
}

fn ascii_text(bytes: ^[U8]) -> String Never! {
    encoding.__utf8_validate(bytes) ?? panic("Core ASCII formatter produced invalid UTF-8")
    out := ""
    #Unsafe("the shared UTF-8 validator accepted this exact owned formatter buffer") {
        out = encoding.__bytes_into_text(^bytes)
    }
    out
}

// Rust's shipped stream writer used binary64 Display, not Jet's Debug-style
// Float display. Re-spell the existing shortest digits without another kernel.
fn wire_float(value: Float) -> String Never! {
    shown :: "{value}"
    bytes := [U8]{}
    #Unsafe("transfer the owned UTF-8 String buffer before re-spelling its shortest digits") {
        bytes = encoding.__text_into_bytes(^shown)
    }
    negative :: bytes[0] == (U8{45})
    start :: if negative -> 1 else -> 0
    decimal := -1
    exponent_at := bytes.len()
    loop i in start..<bytes.len() {
        if bytes[i] == (U8{46}) -> decimal = i - start
        if bytes[i] == (U8{101}) || bytes[i] == (U8{69}) {
            exponent_at = i
            break
        }
    }
    if decimal < 0 -> decimal = exponent_at - start
    exponent := 0
    if exponent_at < bytes.len() {
        at := exponent_at + 1
        exponent_negative := false
        if bytes[at] == (U8{45}) || bytes[at] == (U8{43}) {
            exponent_negative = bytes[at] == (U8{45})
            at += 1
        }
        loop at < bytes.len() {
            exponent = exponent * 10 + Int.from_u8(bytes[at]) - 48
            at += 1
        }
        if exponent_negative -> exponent = -exponent
        loop bytes.len() > exponent_at -> _ :: &bytes.pop()
    }
    dot := -1
    loop i in start..<bytes.len() {
        if bytes[i] == (U8{46}) {
            dot = i
            break
        }
    }
    if dot >= 0 {
        loop i in dot..<(bytes.len() - 1) -> bytes[i] = bytes[i + 1]
        _ :: &bytes.pop()
    }
    position :: decimal + exponent
    loop bytes.len() - start > 1 && bytes[bytes.len() - 1] == (U8{48}) && bytes.len() - start > position -> _ :: &bytes.pop()
    digits :: bytes.len() - start
    if position >= digits {
        loop _ in 0..<(position - digits) -> &bytes.push(U8{48})
    } else if position > 0 {
        &bytes.push(U8{0})
        i := bytes.len() - 1
        loop i > start + position {
            bytes[i] = bytes[i - 1]
            i -= 1
        }
        bytes[start + position] = U8{46}
    } else {
        prefix :: 2 - position
        loop _ in 0..<prefix -> &bytes.push(U8{0})
        i := bytes.len() - 1
        loop i >= start + prefix {
            bytes[i] = bytes[i - prefix]
            i -= 1
        }
        bytes[start] = U8{48}
        bytes[start + 1] = U8{46}
        loop zero_index in (start + 2)..<(start + prefix) -> bytes[zero_index] = U8{48}
    }
    ascii_text(^bytes)
}

struct JSONLinesPull {
    parser: JSONPull
    record_index: Int
    terminal: EncodingError?

    fn next(&self) -[IO, Time.Wait]> Dyn? EncodingError! {
        if self.terminal == .Val(error) -> return Err(error)
        value :: if &self.next_inner() == {
            .Ok(row) -> row
            .Err(failure) -> {
                error := failure
                error.format = .JSONL
                error.path = "/{self.record_index}{error.path}"
                &self.parser.discard()
                self.terminal = Val(error)
                return Err(error)
            }
        }
        Ok(value)
    }

    fn next_inner(&self) -[IO, Time.Wait]> Dyn? EncodingError! {
        loop {
            &self.parser.skip_ws()
            byte :: &self.parser.fill()
            if byte == None -> return Ok(None)
            if byte == (Val(U8{10})) {
                _ :: &self.parser.consume()
                next
            }
            if byte == (Val(U8{13})) {
                _ :: &self.parser.consume()
                if &self.parser.fill() != (Val(U8{10})) -> return Err(self.parser.error(.Syntax, "JSONL records use LF or CRLF; bare CR is not a record ending"))
                _ :: &self.parser.consume()
                next
            }
            break
        }
        first :: &self.parser.next()
        if first == None -> return Ok(None)
        heap := FoldBudget{decoded: 0, tracked: 0}
        tree :: &self.parser.fold(^first, &heap) ?? {
            self.parser.allocation.release(heap.tracked)
            return Err(err)
        }
        end :: if &self.parser.next() == {
            .Ok(value) -> value
            .Err(error) -> {
                self.parser.allocation.release(heap.tracked)
                return Err(error)
            }
        }
        self.parser.allocation.release(heap.tracked)
        if end != None -> return Err(self.parser.error(.Syntax, "trailing input after JSONL record value"))
        self.record_index += 1
        Ok(Val(tree))
    }
}

fn jsonl_reader(input: ^FileReader, limits: EncodingLimits, typed_numbers: Bool) -> JSONLinesPull EncodingError! {
    parser := json_reader(^input, limits) ?? return Err(err)
    parser.record_mode = true
    parser.typed_numbers = typed_numbers
    Ok(JSONLinesPull{parser: parser, record_index: 0, terminal: None})
}

fn write_tree(writer: &JSONPush, value: Dyn) EncodingError! -[IO]> {
    if value == {
        .Null -> &writer.write(DataEvent.Null)
        .Bool(v) -> &writer.write(DataEvent.Bool(v))
        .Int(v) -> &writer.write(DataEvent.Int(v))
        .Float(v) -> &writer.write(DataEvent.Float(v))
        .Text(v) -> &writer.write(DataEvent.Text(v))
        .Array(values) -> {
            &writer.write(DataEvent.ArrayStart)
            loop child in values -> write_tree(&writer, child)
            &writer.write(DataEvent.ArrayEnd)
        }
        .Object(_) -> {
            &writer.write(DataEvent.ObjectStart)
            loop entry in object_entries(value) {
                &writer.write(DataEvent.Key(entry.key))
                write_tree(&writer, entry.value)
            }
            &writer.write(DataEvent.ObjectEnd)
        }
    }
}

fn jsonl_under(error: EncodingError, segment: String) -> EncodingError Never! {
    out := error
    suffix :: if out.path.starts_with("$") -> out.path.slice(1, out.path.len()) else -> out.path
    out.path = "{segment}{suffix}"
    out
}

fn jsonl_tree_size(value: Dyn, depth: Int, limits: EncodingLimits) -> Int EncodingError! {
    if (value == .Array(_) || value == .Object(_)) && depth >= limits.max_depth {
        out := stream_error(.Limit, 0, 1, 1, "max_depth {limits.max_depth} exceeded")
        out.path = "$"
        return Err(out)
    }
    size := 0
    if value == {
        .Null | .Bool(_) -> size = 1
        .Int(_) -> size = 8
        .Float(number) -> {
            if !math.is_finite(number) {
                out := stream_error(.Unsupported, 0, 1, 1, "JSON cannot encode a non-finite Float")
                out.path = "$"
                return Err(out)
            }
            size = 8
        }
        .Text(text) -> size = text.count_bytes()
        .Array(items) -> {
            size = 1
            loop index in 0..<items.len() {
                child :: jsonl_tree_size(items[index], depth + 1, limits) ?? return Err(jsonl_under(err, "$[{index}]"))
                size += child
            }
        }
        .Object(_) -> {
            size = 1
            loop entry in object_entries(value) {
                child :: jsonl_tree_size(entry.value, depth + 1, limits) ?? return Err(jsonl_under(err, "$[{quote_path(entry.key)}]"))
                size += entry.key.count_bytes() + child
            }
        }
        else -> {
            reason := "internal JSON carrier escaped typed decode"
            kind := EncodingErrorKind.State
            #Unsafe("classify the private Bytes carrier without borrowing or exposing its payload") {
                if value == .Bytes(_) {
                    reason = "JSON cannot encode Bytes; encode bytes as Text explicitly"
                    kind = EncodingErrorKind.Unsupported
                }
            }
            out := stream_error(kind, 0, 1, 1, reason)
            out.path = "$"
            return Err(out)
        }
    }
    if size > limits.max_item_bytes {
        out := stream_error(.Limit, 0, 1, 1, "max_item_bytes {limits.max_item_bytes} exceeded")
        out.path = "$"
        return Err(out)
    }
    Ok(size)
}

fn jsonl_wire_add(writer: JSONPush, left: Int, right: Int) -> Int EncodingError! {
    if left > 18446744073709551615 - right -> return Err(writer.error(.Limit, "JSONL record wire size overflow"))
    Ok(left + right)
}

fn jsonl_wire_size(writer: JSONPush, value: Dyn) -> Int EncodingError! {
    if value == {
        .Null -> Ok(4)
        .Bool(flag) -> Ok(if flag -> 4 else -> 5)
        .Int(number) -> Ok("{number}".count_bytes())
        .Float(number) -> Ok(wire_float(number).count_bytes())
        .Text(text) -> jsonl_wire_add(writer, writer.quoted_len(text) ?? return Err(err), 2)
        .Array(items) -> {
            size := 2
            loop index in 0..<items.len() {
                size = jsonl_wire_add(writer, size, if index > 0 -> 1 else -> 0) ?? return Err(err)
                child :: jsonl_wire_size(writer, items[index]) ?? return Err(err)
                size = jsonl_wire_add(writer, size, child) ?? return Err(err)
            }
            Ok(size)
        }
        .Object(_) -> {
            size := 2
            first := true
            loop entry in object_entries(value) {
                size = jsonl_wire_add(writer, size, if first -> 0 else -> 1) ?? return Err(err)
                key :: writer.quoted_len(entry.key) ?? return Err(err)
                size = jsonl_wire_add(writer, size, key) ?? return Err(err)
                size = jsonl_wire_add(writer, size, 3) ?? return Err(err)
                child :: jsonl_wire_size(writer, entry.value) ?? return Err(err)
                size = jsonl_wire_add(writer, size, child) ?? return Err(err)
                first = false
            }
            Ok(size)
        }
        else -> Err(writer.error(.State, "internal JSON carrier escaped typed decode"))
    }
}

// Native JSONL policy: close the prior LF before validating the next record,
// reserve this record plus LF, and leave its LF pending across flush/drop.
struct JSONLinesPush {
    writer: JSONPush
    finished: Bool
    terminal: EncodingError?
    record_index: Int
    pending_lf: Bool

    fn write(&self, value: ^Dyn) EncodingError! -[IO]> {
        if self.terminal == .Val(error) -> return Err(error)
        if self.finished -> return &self.fail(self.writer.state_error("write called after finish"))
        if self.pending_lf {
            self.writer.ensure_total(1) ?? return &self.fail(err)
            &self.writer.write_byte(U8{10}) ?? return &self.fail(err)
            self.pending_lf = false
        }
        _ :: jsonl_tree_size(value, 0, self.writer.limits) ?? {
            out := err
            out.byte_offset = self.writer.total
            out.line = Val(self.record_index + 1)
            out.column = Val(1)
            return &self.fail(out)
        }
        wire :: jsonl_wire_size(self.writer, value) ?? return &self.fail(err)
        if wire == 18446744073709551615 {
            return &self.fail(stream_error(.Limit, self.writer.total, self.record_index + 1, 1, "JSONL record wire size overflow"))
        }
        self.writer.ensure_total(wire + 1) ?? return &self.fail(err)
        write_tree(&self.writer, value) ?? return &self.fail(err)
        if self.writer.frames.len() != 0 -> return &self.fail(self.writer.state_error("JSONL record writer left an open container"))
        self.writer.root_written = false
        self.pending_lf = true
        self.record_index += 1
    }

    fn fail(&self, error: EncodingError) EncodingError! {
        first := jsonl_under(error, "$[{self.record_index}]")
        first.format = .JSONL
        if self.terminal == None -> &self.writer.discard()
        if self.terminal == .Val(prior) -> return Err(prior)
        self.terminal = Val(first)
        return Err(first)
    }

    fn flush(&self) EncodingError! -[IO]> {
        if self.terminal == .Val(error) -> return Err(error)
        &self.writer.flush() ?? return &self.fail(err)
    }

    fn finish(&self) EncodingError! -[IO]> {
        if self.terminal == .Val(error) -> return Err(error)
        if self.finished -> return
        if self.pending_lf {
            self.writer.ensure_total(1) ?? return &self.fail(err)
            &self.writer.write_byte(U8{10}) ?? return &self.fail(err)
            self.pending_lf = false
        }
        &self.flush()
        self.finished = true
    }
}

fn jsonl_writer(output: ^FileWriter, limits: EncodingLimits) -> JSONLinesPush EncodingError! {
    writer :: json_writer(^output, limits, false) ?? {
        error := err
        error.format = .JSONL
        return Err(error)
    }
    Ok(JSONLinesPush{writer: ^writer, finished: false, terminal: None, record_index: 0, pending_lf: false})
}

#Test("borrowed Object entries preserve insertion order") {
    tree :: object_from_entries(^[(key: String, value: Dyn)]{
        (key: "z", value: Dyn.Int(1)),
        (key: "a", value: Dyn.Text("kept")),
    })
    entries :: object_entries(tree)
    assert_eq(entries.len(), 2)
    assert_eq(entries[0].key, "z")
    assert_eq(entries[1].key, "a")
}

#Test("owned UTF8 transfers preserve byte storage contents") {
    original :: String.from_bytes([U8]{97, 240, 159, 153, 130, 122}) ?? panic("UTF-8 text")
    #Unsafe("owned validated UTF-8 allocation transfers in the encoding source seam") {
        bytes :: encoding.__text_into_bytes(^original)
        capacity :: mem.__list_capacity<U8>(bytes)
        restored :: encoding.__bytes_into_text(^bytes)
        roundtrip :: encoding.__text_into_bytes(^restored)
        assert_eq(mem.__list_capacity<U8>(roundtrip), capacity)
        assert_eq(roundtrip, [U8]{97, 240, 159, 153, 130, 122})
    }
}

#Test("expansion limits are checked even with an explicit total bound") {
    limits := EncodingLimits.safe()
    limits.max_total_bytes = Val(1000)
    limits.max_expansion_depth = 257
    if validate_limits(limits) == {
        .Err(error) -> assert_eq(error.kind, EncodingErrorKind.Limit)
        .Ok(_) -> panic("invalid expansion limit accepted")
    }
}

#Test("JSONL preflight counts decoded tree bytes and retains nested error paths") {
    limits := EncodingLimits.safe()
    assert_eq(jsonl_tree_size(Dyn.Int(4), 0, limits) ?? panic("size"), 8)
    limits.max_item_bytes = 4
    value :: object_from_entries([(key: "a", value: Dyn.Text("longer"))])
    if jsonl_tree_size(value, 0, limits) == {
        .Err(error) -> {
            assert_eq(error.kind, EncodingErrorKind.Limit)
            assert_eq(error.path, "$[\"a\"]")
        }
        else -> panic("oversized nested text must fail before any output")
    }
    projected :: jsonl_under(stream_error(.State, 0, 1, 1, "state"), "$[2]")
    assert_eq(projected.path, "$[2]")
}

#Test("JSONL preflight classifies private Bytes without exposing its payload") {
    #Unsafe("exercise the typed Encode byte carrier at the JSON preflight boundary") {
        value :: Dyn.Bytes([U8]{1, 2})
        if jsonl_tree_size(value, 0, EncodingLimits.safe()) == {
            .Err(error) -> {
                assert_eq(error.kind, EncodingErrorKind.Unsupported)
                assert_eq(error.reason, "JSON cannot encode Bytes; encode bytes as Text explicitly")
                assert_eq(error.path, "$")
            }
            else -> panic("JSON must reject byte carriers before output")
        }
    }
}

#Test("JSON colon transitions move the top key frame before input mutation") {
    frames := [ReadFrame]{ReadFrame.ObjectColonValue{key: "kept", key_heap: U64{4}}}
    count :: frames.len()
    owned :: &frames.pop() ?? panic("top frame")
    if ^owned == {
        .ObjectColonValue(key, heap) -> {
            &frames.push(ReadFrame.ObjectCommaOrEnd{key: ^key, key_heap: heap})
        }
        else -> panic("colon frame")
    }
    assert_eq(frames.len(), count)
    if frames[0] == {
        .ObjectCommaOrEnd(key, heap) -> {
            assert_eq(key, "kept")
            assert_eq(heap, U64{4})
        }
        else -> panic("completed colon frame")
    }
}
