use {
    core: core
    // Standalone Erlang External Term Format, version 131 (OTP 29.0.6 / ERTS
    // 17.0.6): one term, not node distribution, LOCAL_EXT or a BEAM runtime.
    core.encoding.[Dyn, EncodingError, EncodingErrorKind, EncodingFormat, EncodingLimits]
    rt: jet.runtime.encoding
    stream: __core_encoding_stream
    json: core.encoding.json
    binary: core.encoding.binary
    zlib: __core_encoding_zlib
    math: core.math
}

ETF_VERSION: 131
// The private carrier key of an encoded Atom (see `Atom`).
ATOM_KEY: "$etf_atom"

/// How records and String-keyed maps are laid out: an ETF map, or a proper
/// list of `{Key, Value}` 2-tuples. (The codec ruling calls it `Layout`; Core
/// enum names are unique and `core.compiler.lang` owns that one.)
#Equatable
TermLayout: enum {
    Map
    Proplist
}

/// How Jet strings travel: a UTF-8 binary, or a byte list (STRING_EXT or
/// LIST_EXT) of UTF-8 bytes, never a guess at Unicode code points.
#Equatable
StringEncoding: enum {
    UTF8Binary
    UTF8ByteList
}

/// How `[U8]` byte arrays are written: a binary, or a byte list.
#Equatable
ByteEncoding: enum {
    Binary
    List
}

/// An ETF atom: owned, validated UTF-8 text of at most 255 characters.
/// Ordinary strings never become atoms; only an `Atom` (and a record key) does.
#Equatable
Atom: struct {
    name: String

    new: fn(name: String) -> Atom EncodingError! {
        if scalar_count(name) > 255 -> return Err(etf_error(.Limit, 0, "", "an atom has at most 255 characters"))
        Ok(Atom{name: name})
    }

    /// An Atom encodes as a one-entry object under a private key the ETF writer
    /// alone turns into an atom; other codecs see that object.
    impl Encode {
        encode: fn(self) -> Dyn { stream.object_from_entries([(key: String, value: Dyn)]{(key: ATOM_KEY, value: Dyn.Text(self.name.copy()))}) }
    }

    /// An Atom reads any atom, including `true`, `false` and `nil`, which other
    /// targets see as Bool and null.
    impl Decode {
        decode: fn(tree: Dyn) -> Atom [FieldError]! {
            if tree == .Text(name) -> return atom_field(name)
            if tree == .Bool(value) -> return Ok(Atom{name: if value -> "true" else -> "false"})
            if tree == .Null -> return Ok(Atom{name: "nil"})
            if atom_name(tree) == Val(name) -> return atom_field(name)
            Err([FieldError{path: "", reason: "expected an atom, found {tree}"}])
        }
    }
}
atom_field: fn(name: String) -> Atom [FieldError]! {
    atom: Atom.new(name) ?? return Err([FieldError{path: "", reason: err.reason}])
    Ok(atom)
}

// The name an encoded Atom carries, if `tree` is one.
atom_name: fn(tree: Dyn) -> String? Never! {
    if tree == .Object(_) {
        entries: stream.object_entries(tree)
        if entries.len() == 1 && entries[0].key == ATOM_KEY && entries[0].value == .Text(name) -> return Val(name.copy())
    }
    None
}

// Unicode scalars in `text`: its bytes that do not continue a sequence.
scalar_count: fn(text: String) -> Int Never! {
    count := 0
    loop b in text.bytes() {
        if (Int{b}).bit_and(192) != 128 -> count += 1
    }
    count
}

/// The one-way JSON view of one standalone ETF term.
///
/// The whole input is one version-131 term (COUNT-ETF-131
/// `83 74 00 00 00 01 6d 00 00 00 05 "count" 61 02` is `{"count":2}`);
/// trailing bytes are an error. Conversion loses what JSON cannot say:
/// - integers and bignums are exact JSON numbers; floats use the JSON writer;
/// - the atoms `true` and `false` become booleans and every other atom
///   becomes text, so an atom and a UTF-8 binary key read alike;
/// - proper lists, NIL and tuples become arrays, so a tuple and a list of the
///   same elements look alike; STRING_EXT is the byte list it encodes, an
///   array of integers, as the equivalent LIST_EXT is;
/// - a binary becomes Base64 text, as `Dyn` bytes always do in JSON; a
///   bitstring that is not byte-aligned is Unsupported;
/// - a map key may be an atom, a UTF-8 binary or a proper list of Unicode
///   scalars, and becomes text; any other key, or two keys that become the
///   same text, is an error;
/// - pids, ports, references, funs, exports, LOCAL_EXT, atom-cache references,
///   distribution headers and improper lists are Unsupported.
///
/// Limits: the input and the JSON output are charged to `max_total_bytes`,
/// nesting to `max_depth`, and each atom, binary, byte list, bignum and a
/// compressed term's declared and inflated size to `max_item_bytes`.
to_json: fn(bytes: [U8], limits: EncodingLimits{EncodingLimits.safe()}) -> String EncodingError! {
    tree: read(bytes, true, .Map, .UTF8Binary, limits) ?? return Err(err)
    text: json.dumps(tree) ?? return Err(err)
    if limits.max_total_bytes == Val(total) && text.bytes().len() > total {
        return Err(etf_error(.Limit, 0, "", "max_total_bytes {total} exceeded by the JSON output"))
    }
    Ok(text)
}

/// A typed value from one standalone ETF term, through
/// the shared `Decode` model:
/// - integers are exact `Int`s and floats `Float`s; a typed read range-checks
///   fixed-width targets;
/// - `true`/`false` atoms decode a `Bool`, `nil` an absent optional, and any
///   atom an `Atom`; other atoms decode a `String` only as their text;
/// - a binary decodes a `String` (strict UTF-8) under `strings: .UTF8Binary`,
///   and a byte list does under `.UTF8ByteList`; a `[U8]` reads either a
///   binary or a byte list, whatever `byte_arrays` says;
/// - lists and tuples decode lists; a record or `[String: T]` map reads an
///   ETF map, or under `layout: .Proplist` a list whose first element is a
///   2-tuple; keys may be atoms or strictly UTF-8 binaries or byte lists, and
///   duplicates are errors;
/// - the native identities, improper lists and unaligned bitstrings are
///   Unsupported, as in `to_json`, and so is a non-finite float.
/// Errors carry the wire path; limits are charged as `to_json` charges them.
decode: fn<T: Decode>(bytes: [U8], layout: TermLayout{.Map}, strings: StringEncoding{.UTF8Binary}, byte_arrays: ByteEncoding{.Binary}, limits: EncodingLimits{EncodingLimits.safe()}) -> T [FieldError]! {
    tree: read(bytes, false, layout, strings, limits) ?? return Err([FieldError]{FieldError{path: err.path, reason: "{err.kind:Debug}: {err.reason}"}})
    previous: rt.etf_strings_enter(if strings == .UTF8Binary -> 1 else -> 2)
    if tree.decode<T>() == {
        .Ok(value) -> {
            rt.etf_strings_leave(previous)
            return Ok(value)
        }
        .Err(failures) -> {
            rt.etf_strings_leave(previous)
            return Err(failures)
        }
    }
}

/// One standalone version-131 term from a typed value:
/// - `Int` is SMALL_INTEGER, INTEGER or an exact SMALL/LARGE_BIG; `Float`
///   is NEW_FLOAT; `Bool` is `true`/`false` and an absent optional `nil`;
/// - `String` (and a DateTime's RFC 3339 text) is a UTF-8 binary, or a byte
///   list under `strings: .UTF8ByteList`; `[U8]` is a binary, or a byte list
///   under `byte_arrays: .List`; an empty byte list is NIL;
/// - lists are proper lists (NIL when empty) and `Atom` is a UTF-8 atom;
/// - a record or map is an ETF map, or under `layout: .Proplist` a list of
///   `{Key, Value}` 2-tuples. `Dyn` does not tell a record from a
///   `[String: T]` map, so every object key is written as a UTF-8 atom of at
///   most 255 characters.
/// The output is charged to `max_total_bytes`, nesting to `max_depth` and
/// each payload to `max_item_bytes`.
encode: fn<T: Encode>(value: T, layout: TermLayout{.Map}, strings: StringEncoding{.UTF8Binary}, byte_arrays: ByteEncoding{.Binary}, limits: EncodingLimits{EncodingLimits.safe()}) -> [U8] EncodingError! {
    writer := TermWriter{out: [U8]{U8{131}}, layout: layout, strings: strings, byte_arrays: byte_arrays, limits: limits}
    writer.term(value.encode(), "$", 1) ?? return Err(err)
    if limits.max_total_bytes == Val(total) && writer.out.len() > total {
        return Err(etf_error(.Limit, 0, "", "max_total_bytes {total} exceeded by the ETF output"))
    }
    Ok(writer.out)
}

etf_error: fn(kind: EncodingErrorKind, offset: Int, path: String, reason: String) -> EncodingError Never! {
    EncodingError{format: .ETF, kind: kind, byte_offset: offset, line: None, column: None, path: path, reason: reason, cause: None}
}

u32_at: fn(bytes: [U8], at: Int) -> Int Never! {
    (Int{bytes[at]} << 24).bit_or((Int{bytes[at + 1]} << 16)).bit_or((Int{bytes[at + 2]} << 8)).bit_or(Int{bytes[at + 3]})
}

slice: fn(bytes: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    loop i in start..<end -> out.push(bytes[i])
    out
}

// The one reader behind `to_json` (`view`) and `decode`.
read: fn(bytes: [U8], view: Bool, layout: TermLayout, strings: StringEncoding, limits: EncodingLimits) -> Dyn EncodingError! {
    if limits.max_total_bytes == Val(total) && bytes.len() > total {
        return Err(etf_error(.Limit, total, "", "max_total_bytes {total} exceeded"))
    }
    if bytes.len() == 0 -> return Err(etf_error(.Truncated, 0, "", "a standalone ETF term starts with version byte 131"))
    if (Int{bytes[0]}) != ETF_VERSION -> return Err(etf_error(.Syntax, 0, "", "a standalone ETF term starts with version byte 131, not {Int{bytes[0]}}"))
    if bytes.len() < 2 -> return Err(etf_error(.Truncated, 1, "$", "the version byte is not followed by a term"))
    op: Int{bytes[1]}
    if op == 80 {
        // COMPRESSED: a four-byte inflated size, then a zlib stream to the end.
        if bytes.len() < 6 -> return Err(etf_error(.Truncated, bytes.len(), "$", "a compressed term needs its four-byte inflated size"))
        size: u32_at(bytes, 2)
        if size > limits.max_item_bytes -> return Err(etf_error(.Limit, 2, "$", "max_item_bytes {limits.max_item_bytes} exceeded by a compressed term of {size} bytes"))
        inflated := [U8]{}
        status: zlib.decompress_into(slice(bytes, 6, bytes.len()), inflated)
        if status != zlib.C_INFLATE_OK -> return Err(etf_error(.Syntax, 6, "$", "the compressed term is not a valid zlib stream ({zlib.fault(status)})"))
        if inflated.len() != size {
            return Err(etf_error(.Syntax, 2, "$", "the compressed term declares {size} inflated bytes but inflates to {inflated.len()}"))
        }
        reader := TermReader{bytes: inflated, at: 0, compressed_at: 1, limits: limits, view: view, layout: layout, strings: strings}
        tree: reader.term("$", 1) ?? return Err(err)
        if reader.at != reader.bytes.len() -> return Err(reader.fail(.Syntax, "$", "trailing bytes after the compressed term"))
        return Ok(tree)
    }
    reader := TermReader{bytes: bytes, at: 1, compressed_at: -1, limits: limits, view: view, layout: layout, strings: strings}
    tree: reader.term("$", 1) ?? return Err(err)
    if reader.at != reader.bytes.len() -> return Err(reader.fail(.Syntax, "", "trailing bytes after the term"))
    Ok(tree)
}

// What the native identity tags this data profile refuses are.
identity_name: fn(op: Int) -> String? Never! {
    if op == 88 || op == 103 -> return Val("a pid")
    if op == 89 || op == 102 || op == 120 -> return Val("a port")
    if op == 90 || op == 101 || op == 114 -> return Val("a reference")
    if op == 112 || op == 117 -> return Val("a fun")
    if op == 113 -> return Val("an export")
    if op == 121 -> return Val("a LOCAL_EXT term")
    if op == 82 -> return Val("an atom-cache reference")
    if op == 68 || op == 69 -> return Val("a distribution header")
    None
}

TermReader: struct {
    bytes: [U8]
    at: Int
    // The wire offset of the COMPRESSED tag when `bytes` is its inflated
    // term (errors inside it report that offset), or -1.
    compressed_at: Int
    limits: EncodingLimits
    // The JSON view: `nil` stays text, a list key is Unicode scalars and
    // Proplist recognition is off.
    view: Bool
    layout: TermLayout
    strings: StringEncoding

    fail: fn(self, kind: EncodingErrorKind, path: String, reason: String) -> EncodingError Never! {
        etf_error(kind, if self.compressed_at >= 0 -> self.compressed_at else -> self.at, path, reason)
    }

    need: fn(self, count: Int, path: String) EncodingError! {
        if count > self.bytes.len() - self.at -> return Err(self.fail(.Truncated, path, "the term ends {count - (self.bytes.len() - self.at)} bytes early"))
    }

    byte: fn(&self) -> Int Never! {
        value: Int{self.bytes[self.at]}
        self.at += 1
        value
    }

    take_u16: fn(&self) -> Int Never! {
        high: self.byte()
        low: self.byte()
        (high << 8).bit_or(low)
    }

    take_u32: fn(&self) -> Int Never! {
        value: u32_at(self.bytes, self.at)
        self.at += 4
        value
    }

    // A length-prefixed payload's byte count, checked against the item limit
    // and the bytes left before anything is allocated.
    item: fn(self, count: Int, path: String, what: String) EncodingError! {
        if count > self.limits.max_item_bytes -> return Err(self.fail(.Limit, path, "max_item_bytes {self.limits.max_item_bytes} exceeded by {what} of {count} bytes"))
        self.need(count, path) ?? return Err(err)
    }

    // An arity is checked against the bytes left (each element takes at
    // least `per` bytes) before the loop that reads it.
    arity: fn(self, count: Int, per: Int, path: String) EncodingError! {
        if count > (self.bytes.len() - self.at) /% per -> return Err(self.fail(.Truncated, path, "an arity of {count} is longer than the bytes left"))
    }

    term: fn(&self, path: String, depth: Int) -> Dyn EncodingError! {
        if depth > self.limits.max_depth -> return Err(self.fail(.Limit, path, "max_depth {self.limits.max_depth} exceeded"))
        self.need(1, path) ?? return Err(err)
        op: self.byte()
        if op == 97 {
            self.need(1, path) ?? return Err(err)
            value: self.byte()
            return Ok(Dyn.Int(value))
        }
        if op == 98 {
            self.need(4, path) ?? return Err(err)
            raw: self.take_u32()
            return Ok(Dyn.Int(if raw >= 2147483648 -> raw - 4294967296 else -> raw))
        }
        if op == 110 || op == 111 {
            self.need(if op == 110 -> 2 else -> 5, path) ?? return Err(err)
            count := 0
            if op == 110 -> count = self.byte() else -> count = self.take_u32()
            self.need(1, path) ?? return Err(err)
            sign: self.byte()
            if sign > 1 -> return Err(self.fail(.Syntax, path, "a bignum sign byte is 0 or 1, not {sign}"))
            self.item(count, path, "a bignum") ?? return Err(err)
            magnitude := 0
            loop i in 0..<count -> magnitude = magnitude * 256 + (Int{self.bytes[self.at + count - 1 - i]})
            self.at += count
            return Ok(Dyn.Int(if sign == 1 -> -magnitude else -> magnitude))
        }
        if op == 70 {
            self.need(8, path) ?? return Err(err)
            value: binary.unpack_f64be(self.bytes, self.at) ?? return Err(self.fail(.Syntax, path, "a NEW_FLOAT_EXT needs eight bytes"))
            self.at += 8
            return self.finite(value, path)
        }
        if op == 99 {
            // FLOAT_EXT: 31 bytes of printf text, NUL-padded.
            self.need(31, path) ?? return Err(err)
            text := [U8]{}
            loop i in 0..<31 {
                b: self.bytes[self.at + i]
                if b == (U8{0}) -> break
                text.push(b)
            }
            self.at += 31
            digits: stream.text_from_bytes(text) ?? return Err(self.fail(.Syntax, path, "a FLOAT_EXT is not ASCII text"))
            value: Float.parse(digits.trim()) ?? return Err(self.fail(.Syntax, path, "a FLOAT_EXT does not hold a float"))
            return self.finite(value, path)
        }
        if op == 100 || op == 115 || op == 118 || op == 119 {
            name: self.atom(op, path) ?? return Err(err)
            if name == "true" -> return Ok(Dyn.Bool(true))
            if name == "false" -> return Ok(Dyn.Bool(false))
            if name == "nil" && !self.view -> return Ok(Dyn.Null)
            return Ok(Dyn.Text(name))
        }
        if op == 104 || op == 105 {
            self.need(if op == 104 -> 1 else -> 4, path) ?? return Err(err)
            count := 0
            if op == 104 -> count = self.byte() else -> count = self.take_u32()
            return self.elements(count, path, depth)
        }
        if op == 106 -> return Ok(Dyn.Array([Dyn]{}))
        if op == 107 {
            self.need(2, path) ?? return Err(err)
            count: self.take_u16()
            self.item(count, path, "a byte list") ?? return Err(err)
            items := [Dyn]{}
            loop _ in 0..<count {
                value: self.byte()
                items.push(Dyn.Int(value))
            }
            return Ok(Dyn.Array(items))
        }
        if op == 108 {
            self.need(4, path) ?? return Err(err)
            count: self.take_u32()
            proplist: !self.view && self.layout == .Proplist && count > 0 && self.bytes.len() - self.at >= 2 && Int{self.bytes[self.at]} == 104 && Int{self.bytes[self.at + 1]} == 2
            tree := Dyn.Null
            if proplist {
                tree = self.pairs(count, path, depth) ?? return Err(err)
            } else {
                tree = self.elements(count, path, depth) ?? return Err(err)
            }
            self.need(1, path) ?? return Err(err)
            if (Int{self.bytes[self.at]}) != 106 -> return Err(self.fail(.Unsupported, path, "an improper list (its tail is not NIL)"))
            self.at += 1
            return Ok(tree)
        }
        if op == 109 || op == 77 {
            self.need(if op == 109 -> 4 else -> 5, path) ?? return Err(err)
            count: self.take_u32()
            if op == 77 {
                bits: self.byte()
                if bits != 8 -> return Err(self.fail(.Unsupported, path, "a bitstring whose last byte holds {bits} bits is not byte-aligned"))
            }
            self.item(count, path, "a binary") ?? return Err(err)
            payload: slice(self.bytes, self.at, self.at + count)
            self.at += count
            return Ok(Dyn.Bytes(payload))
        }
        if op == 116 {
            self.need(4, path) ?? return Err(err)
            count: self.take_u32()
            self.arity(count, 2, path) ?? return Err(err)
            entries := [(key: String, value: Dyn)]{}
            loop i in 0..<count {
                key: self.key("{path}[key {i}]") ?? return Err(err)
                loop entry in entries {
                    if entry.key == key -> return Err(self.fail(.Syntax, path, "two map keys are the text {key:Debug}"))
                }
                value: self.term("{path}[{key:Debug}]", depth + 1) ?? return Err(err)
                entries.push((key: key, value: value))
            }
            return Ok(stream.object_from_entries(entries))
        }
        if op == 80 -> return Err(self.fail(.Unsupported, path, "a compressed term is only the whole input"))
        if identity_name(op) == Val(name) -> return Err(self.fail(.Unsupported, path, "{name} (tag {op}) is a native identity, not data"))
        Err(self.fail(.Syntax, path, "{op} is not an ETF term tag"))
    }

    finite: fn(self, value: Float, path: String) -> Dyn EncodingError! {
        if !math.is_finite(value) -> return Err(self.fail(.Unsupported, path, "a non-finite float is not data"))
        Ok(Dyn.Float(value))
    }

    elements: fn(&self, count: Int, path: String, depth: Int) -> Dyn EncodingError! {
        self.arity(count, 1, path) ?? return Err(err)
        items := [Dyn]{}
        loop i in 0..<count {
            item: self.term("{path}[{i}]", depth + 1) ?? return Err(err)
            items.push(item)
        }
        Ok(Dyn.Array(items))
    }

    // A proplist: `count` `{Key, Value}` 2-tuples, read as an object.
    pairs: fn(&self, count: Int, path: String, depth: Int) -> Dyn EncodingError! {
        self.arity(count, 4, path) ?? return Err(err)
        entries := [(key: String, value: Dyn)]{}
        loop i in 0..<count {
            self.need(2, path) ?? return Err(err)
            tuple: self.byte()
            arity: self.byte()
            if tuple != 104 || arity != 2 -> return Err(self.fail(.Syntax, "{path}[{i}]", "a proplist element is a {{Key, Value}} 2-tuple"))
            key: self.key("{path}[{i}]") ?? return Err(err)
            loop entry in entries {
                if entry.key == key -> return Err(self.fail(.Syntax, path, "two proplist keys are the text {key:Debug}"))
            }
            value: self.term("{path}[{key:Debug}]", depth + 1) ?? return Err(err)
            entries.push((key: key, value: value))
        }
        Ok(stream.object_from_entries(entries))
    }

    // An atom's text: Latin-1 for the deprecated ATOM_EXT and SMALL_ATOM_EXT,
    // strict UTF-8 of at most 255 characters otherwise.
    atom: fn(&self, op: Int, path: String) -> String EncodingError! {
        self.need(if op == 100 || op == 118 -> 2 else -> 1, path) ?? return Err(err)
        count := 0
        if op == 100 || op == 118 -> count = self.take_u16() else -> count = self.byte()
        self.item(count, path, "an atom") ?? return Err(err)
        raw := [U8]{}
        if op == 100 || op == 115 {
            loop i in 0..<count -> append_scalar(raw, Int{self.bytes[self.at + i]})
        } else {
            raw = slice(self.bytes, self.at, self.at + count)
        }
        self.at += count
        text: stream.text_from_bytes(raw) ?? return Err(self.fail(.Syntax, path, "an atom is not valid UTF-8"))
        if scalar_count(text) > 255 -> return Err(self.fail(.Syntax, path, "an atom has more than 255 characters"))
        Ok(text)
    }

    // A map or proplist key as text: an atom, a UTF-8 binary or a proper
    // byte list. The JSON view reads a list's elements as Unicode scalars;
    // typed decode reads them as UTF-8 bytes.
    key: fn(&self, path: String) -> String EncodingError! {
        self.need(1, path) ?? return Err(err)
        op: self.byte()
        if op == 100 || op == 115 || op == 118 || op == 119 -> return self.atom(op, path)
        if op == 109 {
            self.need(4, path) ?? return Err(err)
            count: self.take_u32()
            self.item(count, path, "a binary key") ?? return Err(err)
            raw: slice(self.bytes, self.at, self.at + count)
            self.at += count
            text: stream.text_from_bytes(raw) ?? return Err(self.fail(.Syntax, path, "a binary key is not valid UTF-8"))
            return Ok(text)
        }
        if op == 106 -> return Ok("")
        if op == 107 || op == 108 {
            raw := [U8]{}
            if op == 107 {
                self.need(2, path) ?? return Err(err)
                count: self.take_u16()
                self.item(count, path, "a byte-list key") ?? return Err(err)
                loop _ in 0..<count {
                    element: self.byte()
                    if self.view -> append_scalar(raw, element) else -> raw.push(U8{element})
                }
            } else {
                self.need(4, path) ?? return Err(err)
                count: self.take_u32()
                self.arity(count, 2, path) ?? return Err(err)
                loop _ in 0..<count {
                    self.need(1, path) ?? return Err(err)
                    element: self.byte()
                    scalar := -1
                    if element == 97 {
                        self.need(1, path) ?? return Err(err)
                        scalar = self.byte()
                    } else if element == 98 {
                        self.need(4, path) ?? return Err(err)
                        scalar = self.take_u32()
                    }
                    if self.view {
                        if scalar < 0 || scalar > 1114111 || (scalar >= 55296 && scalar <= 57343) -> return Err(self.fail(.Syntax, path, "a list key holds something other than Unicode scalars"))
                        append_scalar(raw, scalar)
                    } else {
                        if scalar < 0 || scalar > 255 -> return Err(self.fail(.Syntax, path, "a list key holds something other than bytes"))
                        raw.push(U8{scalar})
                    }
                    if raw.len() > self.limits.max_item_bytes -> return Err(self.fail(.Limit, path, "max_item_bytes {self.limits.max_item_bytes} exceeded by a list key"))
                }
                self.need(1, path) ?? return Err(err)
                tail: self.byte()
                if tail != 106 -> return Err(self.fail(.Unsupported, path, "an improper list (its tail is not NIL)"))
            }
            text: stream.text_from_bytes(raw) ?? return Err(self.fail(.Syntax, path, "a list key is not UTF-8 text"))
            return Ok(text)
        }
        if identity_name(op) == Val(name) -> return Err(self.fail(.Unsupported, path, "{name} (tag {op}) is a native identity, not data"))
        Err(self.fail(.Unsupported, path, "a key with tag {op} is not text"))
    }
}

TermWriter: struct {
    out: [U8]
    layout: TermLayout
    strings: StringEncoding
    byte_arrays: ByteEncoding
    limits: EncodingLimits

    put: fn(&self, value: Int) Never! { self.out.push(U8{value.bit_and(255)}) }

    put_u16: fn(&self, value: Int) Never! {
        self.put(value >> 8)
        self.put(value)
    }

    put_u32: fn(&self, value: Int) Never! {
        self.put(value >> 24)
        self.put(value >> 16)
        self.put(value >> 8)
        self.put(value)
    }

    item: fn(self, count: Int, path: String, what: String) EncodingError! {
        if count > self.limits.max_item_bytes -> return Err(etf_error(.Limit, self.out.len(), path, "max_item_bytes {self.limits.max_item_bytes} exceeded by {what} of {count} bytes"))
        if count > 4294967295 -> return Err(etf_error(.Limit, self.out.len(), path, "{what} of {count} bytes exceeds the ETF length field"))
    }

    term: fn(&self, tree: Dyn, path: String, depth: Int) EncodingError! {
        if depth > self.limits.max_depth -> return Err(etf_error(.Limit, self.out.len(), path, "max_depth {self.limits.max_depth} exceeded"))
        #Unsafe("inspect private typed carriers without changing public Dyn variants") {
            if tree == {
                .Null -> self.atom("nil", path) ?? return Err(err)
                .Bool(value) -> self.atom(if value -> "true" else -> "false", path) ?? return Err(err)
                .Int(value) -> self.put_int(value, path) ?? return Err(err)
                .Float(value) -> self.put_float(value, path) ?? return Err(err)
                // A Number lexeme is its exact Int when integral, else its float64.
                .Number(_) -> {
                    if tree.decode<Int>() == {
                        .Ok(value) -> self.put_int(value, path) ?? return Err(err)
                        .Err(_) -> self.put_float(tree.decode<Float>() ?? return Err(etf_error(.Unsupported, self.out.len(), path, "number {tree} is outside the ETF Int and float range")), path) ?? return Err(err)
                    }
                }
                .Text(text) -> self.payload(text.bytes(), self.strings == .UTF8Binary, path) ?? return Err(err)
                .Bytes(bytes) -> self.payload(bytes, self.byte_arrays == .Binary, path) ?? return Err(err)
                .DateTime(_) -> self.payload((tree.to_text() ?? "").bytes(), self.strings == .UTF8Binary, path) ?? return Err(err)
                .Array(items) -> {
                    if items.len() == 0 {
                        self.put(106)
                        return
                    }
                    self.item(items.len(), path, "a list") ?? return Err(err)
                    self.put(108)
                    self.put_u32(items.len())
                    loop i in 0..<items.len() -> self.term(items[i], "{path}[{i}]", depth + 1) ?? return Err(err)
                    self.put(106)
                }
                .Object(_) -> {
                    if atom_name(tree) == Val(name) -> return self.atom(name, path)
                    entries: stream.object_entries(tree)
                    self.item(entries.len(), path, "a map") ?? return Err(err)
                    if self.layout == .Map {
                        self.put(116)
                        self.put_u32(entries.len())
                    } else {
                        if entries.len() == 0 {
                            self.put(106)
                            return
                        }
                        self.put(108)
                        self.put_u32(entries.len())
                    }
                    loop entry in entries {
                        if self.layout == .Proplist {
                            self.put(104)
                            self.put(2)
                        }
                        self.atom(entry.key, "{path}[{entry.key:Debug}]") ?? return Err(err)
                        self.term(entry.value, "{path}[{entry.key:Debug}]", depth + 1) ?? return Err(err)
                    }
                    if self.layout == .Proplist -> self.put(106)
                }
            }
        }
    }

    atom: fn(&self, name: String, path: String) EncodingError! {
        if scalar_count(name) > 255 -> return Err(etf_error(.Limit, self.out.len(), path, "an atom has at most 255 characters"))
        bytes: name.bytes()
        if bytes.len() <= 255 {
            self.put(119)
            self.put(bytes.len())
        } else {
            self.put(118)
            self.put_u16(bytes.len())
        }
        loop b in bytes -> self.out.push(b)
    }

    put_int: fn(&self, value: Int, path: String) EncodingError! {
        if value >= 0 && value <= 255 {
            self.put(97)
            self.put(value)
            return
        }
        if value >= -2147483648 && value <= 2147483647 {
            self.put(98)
            self.put_u32(value.bit_and(4294967295))
            return
        }
        digits := [U8]{}
        rest := if value < 0 -> -value else -> value
        loop rest > 0 {
            digits.push(U8{rest % 256})
            rest = rest /% 256
        }
        self.item(digits.len(), path, "a bignum") ?? return Err(err)
        if digits.len() <= 255 {
            self.put(110)
            self.put(digits.len())
        } else {
            self.put(111)
            self.put_u32(digits.len())
        }
        self.put(if value < 0 -> 1 else -> 0)
        loop b in digits -> self.out.push(b)
    }

    put_float: fn(&self, value: Float, path: String) EncodingError! {
        if !math.is_finite(value) -> return Err(etf_error(.Unsupported, self.out.len(), path, "a non-finite float has no ETF form"))
        bits: binary.pack_f64be(value) ?? return Err(etf_error(.Unsupported, self.out.len(), path, "a float has no ETF form"))
        self.put(70)
        loop b in bits -> self.out.push(b)
    }

    // Bytes as a binary, or as a byte list: NIL when empty, STRING_EXT up to
    // 65535 bytes, else a LIST_EXT of small integers.
    payload: fn(&self, bytes: [U8], as_binary: Bool, path: String) EncodingError! {
        self.item(bytes.len(), path, if as_binary -> "a binary" else -> "a byte list") ?? return Err(err)
        if as_binary {
            self.put(109)
            self.put_u32(bytes.len())
            loop b in bytes -> self.out.push(b)
            return
        }
        if bytes.len() == 0 {
            self.put(106)
            return
        }
        if bytes.len() <= 65535 {
            self.put(107)
            self.put_u16(bytes.len())
            loop b in bytes -> self.out.push(b)
            return
        }
        self.put(108)
        self.put_u32(bytes.len())
        loop b in bytes {
            self.put(97)
            self.out.push(b)
        }
        self.put(106)
    }
}

// UTF-8 bytes of one Unicode scalar.
append_scalar: fn(out: &[U8], scalar: Int) Never! {
    if scalar < 128 {
        out.push(U8{scalar})
    } else if scalar < 2048 {
        out.push(U8{192 + (scalar >> 6)})
        out.push(U8{128 + scalar.bit_and(63)})
    } else if scalar < 65536 {
        out.push(U8{224 + (scalar >> 12)})
        out.push(U8{128 + (scalar >> 6).bit_and(63)})
        out.push(U8{128 + scalar.bit_and(63)})
    } else {
        out.push(U8{240 + (scalar >> 18)})
        out.push(U8{128 + (scalar >> 12).bit_and(63)})
        out.push(U8{128 + (scalar >> 6).bit_and(63)})
        out.push(U8{128 + scalar.bit_and(63)})
    }
}

#Test("ETF COUNT-ETF-131 fixtures, JSON view and typed round trip") {
    binary_key: [U8]{131, 116, 0, 0, 0, 1, 109, 0, 0, 0, 5, 99, 111, 117, 110, 116, 97, 2}
    atom_key: [U8]{131, 116, 0, 0, 0, 1, 119, 5, 99, 111, 117, 110, 116, 97, 2}
    assert_eq(to_json(binary_key) ?? panic("binary-key ETF converts"), "{{\"count\":2}}")
    assert_eq(to_json(atom_key) ?? panic("atom-key ETF converts"), "{{\"count\":2}}")
    assert_eq(encode(stream.object_from_entries([(key: String, value: Dyn)]{(key: "count", value: Dyn.Int(2))})) ?? panic("object encodes"), atom_key)
}
