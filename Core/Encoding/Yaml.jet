use core.encoding.[Dyn, EncodingError, EncodingErrorKind, EncodingFormat]
use core.encoding.base64 as base64
use core.time.[ZonedDateTime]
use __core_encoding_stream as stream

fn syntax_error(format: EncodingFormat, offset: Int, line: Int, column: Int, path: String, reason: String) -> EncodingError Never! {
    {
        format: format,
        kind: EncodingErrorKind.Syntax,
        byte_offset: offset,
        line: Val(line),
        column: Val(column),
        path: path,
        reason: reason,
        cause: None,
    }
}
use core.encoding.json as json

// core.encoding.yaml — JSON-compatible YAML 1.2 plus simple block maps/lists.
//
// This source codec covers JSON, `key: value` maps, `- item` lists,
// `|` / `>` folded scalars, comments, !!binary, and offset timestamps.
// Unknown syntax fails closed rather than silently delegating.
fn parse(text: String) -> Dyn EncodingError! { parse_yaml(text) }

fn decode(text: String) -> Dyn EncodingError! { parse_yaml(text) }

fn to_string<T: Encode>(value: T) -> String Never! {
    text :: render_yaml(value.encode(), 0).trim_end()
    if text == "" -> "{{}}" else -> text
}


fn parse_yaml(text: String) -> Dyn EncodingError! {
    trimmed :: trim_yaml(text)
    if trimmed.len() == 0 -> return Ok(Dyn.Null)
    if looks_json(trimmed) -> return json.parse(trimmed)
    parse_block(trimmed)
}

fn looks_json(text: String) -> Bool Never! {
    loop b in text.bytes() {
        n :: b
        if n == 32 || n == 9 || n == 10 || n == 13 -> next
        return n == 123 || n == 91
    }
    false
}

fn parse_block(text: String) -> Dyn EncodingError! {
    rows := [String]{}
    buf := [U8]{}
    loop b in text.bytes() {
        if b == (U8{10}) {
            &rows.push(String.from_bytes(buf) ?? return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "invalid UTF-8 in YAML input")))
            buf = [U8]{}
            next
        }
        if b == (U8{13}) -> next
        &buf.push(b)
    }
    if buf.len() > 0 -> &rows.push(String.from_bytes(buf) ?? return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "invalid UTF-8 in YAML input")))
    if rows.len() == 0 -> return Ok(Dyn.Null)
    first := ""
    first_index := 0
    loop row_index in 0..<rows.len() {
        row :: rows[row_index]
        if !is_blank_or_comment(row) {
            first = row
            first_index = row_index
            break
        }
    }
    if first.len() == 0 -> return Ok(Dyn.Null)
    first_body :: trim_yaml(strip_inline_comment(first))
    if first_body == "|" || first_body == ">" || first_body == "!!binary |" || first_body == "!!binary >" {
        block :: parse_block_scalar(rows, first_index, leading_spaces(first), first_body == ">" || first_body == "!!binary >")
        if first_body.starts_with("!!binary") -> return parse_scalar("!!binary {block.value}")
        return Ok(Dyn.Text(block.value))
    }
    if starts_list(first) -> return parse_list(rows, leading_spaces(first))
    if !is_map_entry(first) -> return parse_scalar(trim_yaml(first))
    parse_map(rows, leading_spaces(first))
}

fn starts_list(line: String) -> Bool Never! {
    s :: lstrip(line)
    bytes :: s.bytes()
    if bytes.len() < 2 -> return false
    bytes[0] == (U8{45}) && (bytes[1] == (U8{32}) || bytes[1] == (U8{9}))
}

// A timestamp's internal colons are not YAML mapping separators.
fn is_map_entry(text: String) -> Bool Never! {
    raw :: text.bytes()
    quote := 0
    loop i in 0..<raw.len() {
        n :: raw[i]
        if quote != 0 {
            if n == quote -> quote = 0
        } else if n == 34 || n == 39 {
            quote = n
        } else if n == 58 {
            if i + 1 == raw.len() || raw[i + 1] == (U8{32}) || raw[i + 1] == (U8{9}) -> return true
        }
    }
    false
}

fn parse_block_scalar(rows: [String], start: Int, parent_indent: Int, folded: Bool) -> (value: String, next: Int) Never! {
    lines := [String]{}
    i := start + 1
    content_indent := -1
    loop i < rows.len() {
        line :: rows[i]
        if line.len() == 0 {
            &lines.push("")
            i += 1
            next
        }
        pad :: leading_spaces(line)
        if pad <= parent_indent -> break
        if content_indent < 0 -> content_indent = pad
        if pad < content_indent -> break
        &lines.push(strip_indent(line, content_indent))
        i += 1
    }
    out := ""
    loop j in 0..<lines.len() {
        if j > 0 {
            previous :: lines[j - 1]
            if folded && previous.len() > 0 && lines[j].len() > 0 {
                out = "{out} "
            } else {
                out = "{out}\n"
            }
        }
        out = "{out}{lines[j]}"
    }
    if lines.len() > 0 -> out = "{out}\n"
    (value: out, next: i)
}

fn strip_indent(text: String, columns: Int) -> String Never! {
    raw :: text.bytes()
    consumed := 0
    i := 0
    loop i < raw.len() && consumed < columns {
        if raw[i] == (U8{32}) {
            consumed += 1
            i += 1
            next
        }
        if raw[i] == (U8{9}) {
            consumed += 2
            i += 1
            next
        }
        break
    }
    if i >= raw.len() -> return ""
    String.from_bytes(raw[i..raw.len() - 1]) ?? ""
}


fn parse_map(rows: [String], indent: Int) -> Dyn EncodingError! {
    // Keys keep arrival order; the temporary key set
    // rejects a repeated name and is freed with the map.
    entries := [(key: String, value: Dyn)]{}
    seen := [String: Bool]{}
    i := 0
    loop i < rows.len() {
        line :: rows[i]
        if is_blank_or_comment(line) {
            i += 1
            next
        }
        pad :: leading_spaces(line)
        if pad < indent -> break
        if pad > indent -> return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "unexpected indentation in YAML map"))
        body :: lstrip(line)
        cut :: split_once(body, 58)
        if cut.before == body -> return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "YAML map entry needs ':'"))
        key :: trim_yaml(cut.before)
        if key.len() == 0 -> return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "YAML map key is empty"))
        if seen.has_key(key) -> return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "duplicate YAML map key"))
        _ :: &seen.add(key, true)
        rest :: trim_yaml(strip_inline_comment(cut.after))
        i += 1
        if rest == "|" || rest == ">" {
            block :: parse_block_scalar(rows, i - 1, pad, rest == ">")
            &entries.push((key: key, value: Dyn.Text(block.value)))
            i = block.next
        } else if rest.len() == 0 {
            child_rows := [String]{}
            loop i < rows.len() {
                child :: rows[i]
                if is_blank_or_comment(child) {
                    i += 1
                    next
                }
                if leading_spaces(child) <= pad -> break
                &child_rows.push(child)
                i += 1
            }
            &entries.push((key: key, value: parse_block(join_lines(child_rows))))
        } else {
            &entries.push((key: key, value: parse_scalar(rest)))
        }
    }
    Ok(stream.object_from_entries(^entries))
}

fn parse_list(rows: [String], indent: Int) -> Dyn EncodingError! {
    items := [Dyn]{}
    i := 0
    loop i < rows.len() {
        line :: rows[i]
        if is_blank_or_comment(line) {
            i += 1
            next
        }
        pad :: leading_spaces(line)
        if pad < indent -> break
        if pad > indent -> return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "unexpected indentation in YAML list"))
        body :: lstrip(line)
        bytes :: body.bytes()
        if bytes.len() == 0 || bytes[0] != (U8{45}) -> return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "YAML list item needs '-'"))
        rest := ""
        if bytes.len() > 1 -> rest = trim_yaml(drop_prefix(body, 2))
        i += 1
        if rest == "|" || rest == ">" || rest == "!!binary |" || rest == "!!binary >" {
            block :: parse_block_scalar(rows, i - 1, pad, rest == ">" || rest == "!!binary >")
            if rest.starts_with("!!binary") -> &items.push(parse_scalar("!!binary {block.value}"))
            else -> &items.push(Dyn.Text(block.value))
            i = block.next
        } else if rest.len() == 0 {
            child_rows := [String]{}
            loop i < rows.len() {
                child :: rows[i]
                if is_blank_or_comment(child) {
                    i += 1
                    next
                }
                if leading_spaces(child) <= pad -> break
                &child_rows.push(child)
                i += 1
            }
            &items.push(parse_block(join_lines(child_rows)))
        } else if is_map_entry(rest) {
            map_rows := [String]{rest}
            loop i < rows.len() {
                child :: rows[i]
                if is_blank_or_comment(child) {
                    &map_rows.push("")
                    i += 1
                    next
                }
                if leading_spaces(child) <= pad -> break
                &map_rows.push(strip_indent(child, pad + 2))
                i += 1
            }
            &items.push(parse_map(map_rows, 0))
        } else {
            &items.push(parse_scalar(strip_inline_comment(rest)))
        }
    }
    Ok(Dyn.Array(items))
}

fn parse_scalar(text: String) -> Dyn EncodingError! {
    clean :: trim_yaml(strip_inline_comment(text))
    stamp_text := clean
    if clean.starts_with("!!timestamp") -> stamp_text = unquote(trim_yaml(drop_prefix(clean, 11)))
    raw :: stamp_text.bytes()
    if !clean.starts_with("\"") && !clean.starts_with("'") && raw.len() >= 28 && (raw[raw.len() - 9] == (U8{43}) || raw[raw.len() - 9] == (U8{45})) && raw[raw.len() - 6] == (U8{58}) && raw[raw.len() - 3] == (U8{58}) {
        error := syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "date-time offsets with seconds are unsupported")
        error.kind = EncodingErrorKind.Unsupported
        return Err(error)
    }
    if clean.starts_with("!!binary") {
        encoded :: unquote(trim_yaml(drop_prefix(clean, 8)))
        compact := [U8]{}
        loop b in encoded.bytes() {
            if b != (U8{32}) && b != (U8{9}) && b != (U8{10}) && b != (U8{13}) -> &compact.push(b)
        }
        bytes :: base64.decode(String.from_bytes(compact) ?? "") ?? return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "invalid !!binary base64"))
        return Ok(Dyn.Bytes(bytes))
    }
    if clean.starts_with("!!timestamp") {
        stamp :: Dyn.Text(unquote(trim_yaml(drop_prefix(clean, 11))))
        z :: stamp.decode<ZonedDateTime>() ?? return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "invalid !!timestamp RFC 3339 date-time"))
        if z.offset_seconds() %% 60 != 0 {
            error := syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "date-time offset must be whole minutes")
            error.kind = EncodingErrorKind.Unsupported
            return Err(error)
        }
        return Ok(Dyn.DateTime(z))
    }
    if clean == "{{}}" -> return Ok(Dyn.object())
    if clean.starts_with("\"") || clean.starts_with("'") -> return Ok(Dyn.Text(unquote(clean)))
    stamp :: Dyn.Text(clean)
    if stamp.decode<ZonedDateTime>() == {
        .Ok(z) -> {
            if z.offset_seconds() %% 60 != 0 {
                error := syntax_error(EncodingFormat.YAML, 0, 1, 1, "", "date-time offset must be whole minutes")
                error.kind = EncodingErrorKind.Unsupported
                return Err(error)
            }
            return Ok(Dyn.DateTime(z))
        }
        .Err(_) -> { _ := 0 }
    }
    if clean == {
        "null" | "~" -> return Ok(Dyn.Null)
        "true" -> return Ok(Dyn.Bool(true))
        "false" -> return Ok(Dyn.Bool(false))
        else -> { _ := 0 }
    }
    // #4602: a number keeps its exact JSON-number lexeme as `Number`.
    if Int.parse(clean) == {
        .Ok(n) -> return Ok(stream.typed_number("{n}"))
        else -> { _ := 0 }
    }
    if Float.parse(clean) == {
        .Ok(n) -> return Ok(number_tree(clean.copy(), n))
        else -> { _ := 0 }
    }
    Ok(Dyn.Text(unquote(clean)))
}

// A float keeps its own spelling when it is a JSON number token (`+`
// dropped), else its shortest decimal spelling; `.inf` and `.nan` have no
// lexeme and stay `Float`. Rust twin: jet-foundation JSONNumber.rs.
fn number_tree(clean: ^String, value: Float) -> Dyn Never! {
    unsigned := ^clean
    raw :: unsigned.bytes()
    if raw.len() > 0 && raw[0] == (U8{43}) {
        unsigned = String.from_bytes(raw[1..<raw.len()]) ?? panic("removing an ASCII prefix preserves UTF-8")
    }
    if is_json_number_token(unsigned) -> return stream.typed_number(^unsigned)
    shown := "{value}"
    if is_json_number_token(shown) -> return stream.typed_number(^shown)
    Dyn.Float(value)
}

fn is_json_number_token(text: String) -> Bool Never! {
    b :: text.bytes()
    i := 0
    if i < b.len() && b[i] == (U8{45}) -> i += 1
    if i >= b.len() -> return false
    if b[i] == (U8{48}) {
        i += 1
    } else {
        if b[i] < (U8{49}) || b[i] > (U8{57}) -> return false
        loop i < b.len() && b[i] >= (U8{48}) && b[i] <= (U8{57}) -> i += 1
    }
    if i < b.len() && b[i] == (U8{46}) {
        i += 1
        fraction :: i
        loop i < b.len() && b[i] >= (U8{48}) && b[i] <= (U8{57}) -> i += 1
        if i == fraction -> return false
    }
    if i < b.len() && (b[i] == (U8{101}) || b[i] == (U8{69})) {
        i += 1
        if i < b.len() && (b[i] == (U8{43}) || b[i] == (U8{45})) -> i += 1
        exponent :: i
        loop i < b.len() && b[i] >= (U8{48}) && b[i] <= (U8{57}) -> i += 1
        if i == exponent -> return false
    }
    i == b.len()
}

fn render_yaml(value: Dyn, indent: Int) -> String Never! {
    if value == {
        .Object(_) -> render_yaml_object(value, indent)
        .Array(items) -> render_yaml_array(items, indent)
        else -> "{spaces(indent)}{yaml_leaf(value)}\n"
    }
}

fn nonempty_collection(value: Dyn) -> Bool Never! {
    if value == {
        .Object(_) -> stream.object_entries(value).len() > 0
        .Array(items) -> items.len() > 0
        else -> false
    }
}

fn render_yaml_array(items: [Dyn], indent: Int) -> String Never! {
    pad :: spaces(indent)
    out := ""
    loop item in items {
        if nonempty_collection(item) {
            out = "{out}{pad}-\n{render_yaml(item, indent + 2)}"
        } else {
            out = "{out}{pad}- {yaml_leaf(item)}\n"
        }
    }
    out
}

fn render_yaml_object(value: Dyn, indent: Int) -> String Never! {
    pad :: spaces(indent)
    entries :: stream.object_entries(value)
    if entries.len() == 0 -> return "{pad}{{}}\n"
    out := ""
    loop pair in entries {
        key :: yaml_key(pair.key)
        if nonempty_collection(pair.value) {
            out = "{out}{pad}{key}:\n"
            if pair.value == {
                .Array(items) -> out = "{out}{render_yaml_array(items, indent)}"
                else -> out = "{out}{render_yaml(pair.value, indent + 2)}"
            }
        } else {
            out = "{out}{pad}{key}: {yaml_leaf(pair.value)}\n"
        }
    }
    out
}

fn yaml_key(key: String) -> String Never! {
    if key == "" || key.contains(":") || key.contains(" ") || key.contains("#") -> return "{key:Debug}"
    key.copy()
}

fn yaml_leaf(value: Dyn) -> String Never! {
    #Unsafe("inspect compiler-private Bytes and typed carriers; public Dyn variants are unchanged") {
        return if value == {
            .Null -> "null"
            .Bool(v) -> "{v}"
            .Int(n) -> "{n}"
            .Float(n) -> "{n:Debug}"
            .Number(_) -> panic("internal JSON carrier escaped typed decode")
            .Text(s) -> yaml_scalar(s)
            .Bytes(bytes) -> {
                out := "["
                loop i in 0..<bytes.len() {
                    if i > 0 -> out = "{out}, "
                    out = "{out}{Int.from_u8(bytes[i])}"
                }
                "{out}]"
            }
            .Array(items) -> {
                out := "["
                loop i in 0..<items.len() {
                    if i > 0 -> out = "{out}, "
                    out = "{out}{yaml_leaf(items[i])}"
                }
                "{out}]"
            }
            .Object(_) -> {
                out := "{{"
                first := true
                loop pair in stream.object_entries(value) {
                    if !first -> out = "{out}, "
                    first = false
                    out = "{out}{yaml_key(pair.key)}: {yaml_leaf(pair.value)}"
                }
                "{out}}}"
            }
        }
    }
}

fn trim_yaml(text: String) -> String Never! {
    raw :: text.bytes()
    start := 0
    end := raw.len()
    loop start < end {
        n :: raw[start]
        if n == 32 || n == 9 || n == 10 || n == 13 {
            start += 1
            next
        }
        break
    }
    loop end > start {
        n :: raw[end - 1]
        if n == 32 || n == 9 || n == 10 || n == 13 {
            end -= 1
            next
        }
        break
    }
    if end <= start -> return ""
    String.from_bytes(raw[start..end - 1]) ?? ""
}

fn strip_inline_comment(text: String) -> String Never! {
    raw :: text.bytes()
    quote := 0
    i := 0
    loop i < raw.len() {
        n :: raw[i]
        if quote != 0 {
            if n == quote -> quote = 0
        } else if n == 34 || n == 39 {
            quote = n
        } else if n == 35 && (i == 0 || raw[i - 1] == 32 || raw[i - 1] == 9) {
            if i == 0 -> return ""
            return String.from_bytes(raw[0..i - 1]) ?? ""
        }
        i += 1
    }
    text.copy()
}

fn yaml_scalar(text: String) -> String Never! {
    needs := text == "" || text == "null" || text == "Null" || text == "NULL" || text == "~" || text == "true" || text == "True" || text == "TRUE" || text == "false" || text == "False" || text == "FALSE"
    if text.starts_with(" ") || text.ends_with(" ") || text.contains(": ") || text.contains(" #") || text.contains("\n") || parses_as_number(text) -> needs = true
    raw :: text.bytes()
    if raw.len() > 0 {
        loop b in "-?:[]{{}}#&*!|>'\"%@`".bytes() {
            if raw[0] == b -> needs = true
        }
    }
    if needs -> "{text:Debug}" else -> text
}

fn parses_as_number(text: String) -> Bool Never! {
    raw :: text.bytes()
    digits := raw.len() > 0
    loop i in 0..<raw.len() {
        n :: Int.from_u8(raw[i])
        if i == 0 && (n == 43 || n == 45) {
            if raw.len() == 1 -> digits = false
            next
        }
        if n < 48 || n > 57 -> digits = false
    }
    if digits && Int.parse(text) == .Ok(n) && n >= -9223372036854775808 && n <= 9223372036854775807 -> return true
    Float.parse(text) == .Ok(_)
}

fn lstrip(text: String) -> String Never! {
    raw :: text.bytes()
    start := 0
    loop start < raw.len() {
        n :: raw[start]
        if n == 32 || n == 9 {
            start += 1
            next
        }
        break
    }
    if start >= raw.len() -> return ""
    String.from_bytes(raw[start..raw.len() - 1]) ?? ""
}

fn leading_spaces(text: String) -> Int Never! {
    n := 0
    loop b in text.bytes() {
        if b == (U8{32}) {
            n += 1
            next
        }
        if b == (U8{9}) {
            n += 2
            next
        }
        break
    }
    n
}

fn is_blank_or_comment(line: String) -> Bool Never! {
    s :: lstrip(line)
    if s.len() == 0 -> return true
    s.bytes()[0] == (U8{35})
}

fn split_once(text: String, sep: U8) -> (after: String, before: String) Never! {
    raw :: text.bytes()
    loop i in 0..<raw.len() {
        if raw[i] == sep {
            before := ""
            if i > 0 -> before = String.from_bytes(raw[0..i - 1]) ?? ""
            after := ""
            if i + 1 < raw.len() -> after = String.from_bytes(raw[i + 1..raw.len() - 1]) ?? ""
            return (before: before, after: after)
        }
    }
    (before: text.copy(), after: "")
}

fn drop_prefix(text: String, n: Int) -> String Never! {
    raw :: text.bytes()
    if raw.len() <= n -> return ""
    String.from_bytes(raw[n..raw.len() - 1]) ?? ""
}

fn join_lines(rows: [String]) -> String Never! {
    out := ""
    loop i in 0..<rows.len() {
        if i > 0 -> out = "{out}\n"
        out = "{out}{rows[i]}"
    }
    out
}

fn spaces(n: Int) -> String {
    out := ""
    loop _ in 0..<n -> out = "{out} "
    out
}

fn unquote(text: String) -> String Never! {
    raw :: text.bytes()
    if raw.len() < 2 -> return text.copy()
    if (raw[0] != (U8{34}) && raw[0] != (U8{39})) || raw[raw.len() - 1] != raw[0] -> return text.copy()
    out := [U8]{}
    i := 1
    loop i < raw.len() - 1 {
        if raw[0] == (U8{34}) && raw[i] == (U8{92}) && i + 1 < raw.len() - 1 {
            i += 1
            if raw[i] == (U8{110}) -> &out.push(U8{10})
            else if raw[i] == (U8{114}) -> &out.push(U8{13})
            else if raw[i] == (U8{116}) -> &out.push(U8{9})
            else if raw[i] == (U8{34}) || raw[i] == (U8{92}) -> &out.push(raw[i])
            else -> &out.push(raw[i])
        } else {
            &out.push(raw[i])
        }
        i += 1
    }
    String.from_bytes(out) ?? text.copy()
}

#Test("YAML renderer preserves scalar quoting") {
    assert(to_string(Dyn.Text("é")) == "é")
    assert(to_string(Dyn.Text("NULL")) == "\"NULL\"")
    assert(to_string(Dyn.Text("a b")) == "a b")
    assert(to_string(Dyn.Text("a: b")) == "\"a: b\"")
    assert(to_string(Dyn.Array([Dyn]{})) == "{{}}")
}
