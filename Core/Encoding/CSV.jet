use {
    core: core
    core.encoding.[Dyn, EncodingCause, EncodingError, EncodingErrorKind, EncodingFormat, EncodingLimits, Format, FormatError, __DecodeSource, __Decoding]
    json: core.encoding.json
    base64: core.encoding.base64
    stream: __core_encoding_stream
    encoding: core.encoding
    rt: jet.runtime.encoding
    mem: core.mem
}

syntax_error: fn(format: EncodingFormat, offset: Int, line: Int, column: Int, path: String, reason: String) -> EncodingError Never! {
    {
        format: format,
        kind: EncodingErrorKind.Syntax,
        byte_offset: offset,
        line: Val(line),
        column: Val(column),
        path: path,
        reason: reason,
        cause: None,
    }
}

unsupported_error: fn(format: EncodingFormat, offset: Int, reason: String) -> EncodingError Never! {
    {
        format: format,
        kind: EncodingErrorKind.Unsupported,
        byte_offset: offset,
        line: None,
        column: None,
        path: "",
        reason: reason,
        cause: None,
    }
}

// core.encoding.csv — RFC 4180 tables as field rows.
//
// `rows` is the physical codec: it does not guess types. Every cell stays
// text. Quotes wrap a field; `""` is a literal quote. `parse` / `to_string`
// lift those rows into `Dyn` arrays so CSV participates in the shared
// tree without a second table type.
//
// Typed `decode<T>` owns native header-to-record and row-error policy here:
// its byte scanner (`TypedCSV`) streams each record into `T` as a
// `__DecodeSource`, keeps a syntax error as its typed failure carrier, and
// maps diagnostic text to FieldError.
// Streaming reads distinguish optional EOF from typed IO failures, and writes
// borrow bounded byte windows over existing registered file leaves.
CSVRow: struct {
    line: Int,
    fields: [String],
}

/// Physical rows. `delimiter` is one character other than a quote
/// or a line ending; `header: true` drops the first record (the header) and
/// returns only data records; `skip_blank` drops records with no field
/// content. Every `CSVRow.line` is the one-based physical line where that
/// record opens.
rows: fn(text: String, delimiter: String{","}, header: Bool{false}, skip_blank: Bool{true}) -> [CSVRow] EncodingError! {
    delimiter_bytes: delimiter.bytes()
    if delimiter.len() != 1 || delimiter_bytes[0] == (U8{34}) || delimiter_bytes[0] == (U8{10}) || delimiter_bytes[0] == (U8{13}) {
        return Err(unsupported_error(EncodingFormat.CSV, 0, "a CSV delimiter is one character other than a quote or a line ending"))
    }
    parse_rows_with(text, delimiter_bytes, header, skip_blank)
}

/// Header-named typed rows. A data record must have exactly the header's
/// cell count; a short or long record is a `row N` failure, and failures from
/// every data record are accumulated in row order.
/// Cells decode inside the runtime's text-cell scope (Rust
/// `jet_decode_text_cells`): a Text cell parses as an Int, Float or Bool
/// target, and the previous scope is restored before returning.
// Each record streams into its row through the scanner's `__DecodeSource`:
// no record tree is built, and its cells are read from the input's bytes.
decode: fn<T: Decode>(text: String) -> [T] [FieldError]! {
    csv := TypedCSV.new(text)
    if csv.next() -> csv.header = csv.fields()
    values := [T]{}
    errors := [FieldError]{}
    previous: rt.text_cells_enter()
    index := 0
    loop csv.next() {
        index += 1
        if csv.count() != csv.header.len() {
            errors.push(FieldError{path: "row {index}", reason: ragged_reason(index, csv.count(), csv.header.len())})
            next
        }
        csv.cursor = TYPED_CSV_RECORD
        // `??` hands the decoded row over; a match would copy it out.
        value: __Decoding.read<T, TypedCSV>(csv) ?? {
            loop failure in err {
                out := failure
                out.path = if out.path == "" -> "row {index}" else if out.path.starts_with("[") -> "row {index}{out.path}" else -> "row {index}.{out.path}"
                errors.push(out)
            }
            next
        }
        values.push(value)
    }
    rt.text_cells_leave(previous)
    if csv.failure == .Val(error) {
        return Err([FieldError]{FieldError{path: "", reason: error.reason}})
    }
    if errors.len() == 0 -> Ok(values) else -> Err(errors)
}

// `input.csv<Row>()` (JetSema sema_call_try_ambient_input_method): the lines
// of the ambient `input` as one table whose first record is the header,
// decoded as `decode<Row>` decodes text. Every failed row is listed in the
// one `Err` it fails with (encoding.__input_failure).
priv __input_csv: fn<Row: Decode>(lines: &&Iter<String>) -> [Row] Err! {
    text := ""
    loop line in lines {
        text += line
        text += "\n"
    }
    rows: decode<Row>(text) ?? return Err(encoding.__input_failure("CSV", err))
    Ok(rows)
}

// A record whose cell count differs from the header's is malformed: no cell is
// invented for a short record and none is dropped from a long one.
ragged_reason: fn(record: Int, cells: Int, columns: Int) -> String Never! {
    "CSV row {record} has {cells} fields; the header has {columns}"
}

// Whole-value typed CSV keeps the streaming reader's record and error
// contract but no streaming EncodingLimits: the shipped whole-value decoder
// is unbounded.
#Error
TypedCSVError: struct {
    reason: String,
}

// `TypedCSV.cursor` while the record itself is at the cursor; -1 once its
// object is open and before its first member.
TYPED_CSV_RECORD: -2

// The typed scanner over a String's bytes. `next` reads one record as the
// byte spans of its fields in `raw`: an unquoted field is the bytes up to its
// comma or line ending, a quoted one the bytes between its quotes, in which
// every `""` pair stands for one quote when the field is in `escapes`. A
// record ends at LF or CRLF (a bare CR is malformed), or at the end of the
// input.
//
// As a `__DecodeSource` the current record is one object whose members are
// the header's names, in order, each a text cell of its field, as the tree
// `{header[i]: Dyn.Text(field i)}` reads: a cell is built only when it is
// read, and an Int, Float or Bool cell in plain decimal form is parsed in
// place, to what the cell's text-cell decode gives.
priv TypedCSV: struct {
    raw: [U8],
    // The next byte to scan, and the line it is on and that line's first byte.
    at: Int,
    line: Int,
    line_start: Int,
    // The one-based number of the record being scanned.
    record: Int,
    // Each field's start and end in `raw`, and the fields with `""` escapes.
    spans: [Int],
    escapes: [Int],
    // The syntax error that ended the scan.
    failure: TypedCSVError?,
    header: [String],
    // TYPED_CSV_RECORD, or the open record's member at the cursor:
    // header.len() once it is closed.
    cursor: Int,

    new: fn(text: String) -> TypedCSV Never! {
        TypedCSV{raw: text.bytes(), at: 0, line: 1, line_start: 0, record: 1, spans: [Int]{}, escapes: [Int]{}, failure: None, header: [String]{}, cursor: TYPED_CSV_RECORD}
    }

    // Fails the scan at byte `at` of the current line: the column counts
    // scalars.
    fail: fn(&self, at: Int, reason: String) Never! {
        column := 1
        loop index in self.line_start..<at {
            byte: Int{self.raw[index]}
            if byte < 128 || byte >= 192 -> column += 1
        }
        self.failure = Val(TypedCSVError{reason: "Jet.MalformedRingInput: CSV row {self.record}, line {self.line}, column {column} — {reason}"})
    }

    // After a field, at its comma, line ending or the end of the input: true
    // when the record goes on to another field. Any other byte fails the scan.
    delimit: fn(&self, quoted: Bool) -> Bool Never! {
        if self.at >= self.raw.len() -> return false
        byte: Int{self.raw[self.at]}
        if byte == 44 {
            self.at += 1
            return true
        }
        if byte == 13 {
            if self.at + 1 >= self.raw.len() || self.raw[self.at + 1] != (U8{10}) {
                self.fail(self.at, "bare CR is not a record ending")
                return false
            }
            self.at += 1
        } else if byte != 10 {
            self.fail(self.at, if quoted -> "only quote, comma, CRLF, LF, or EOF may follow a closing quote" else -> "quote inside an unquoted field")
            return false
        }
        self.at += 1
        self.line += 1
        self.line_start = self.at
        false
    }

    // Scans the next record's fields; false, with none scanned, at the end of
    // the input or on a syntax error, which `failure` keeps.
    next: fn(&self) -> Bool Never! {
        self.spans.clear()
        self.escapes.clear()
        length: self.raw.len()
        if self.failure != None || self.at >= length -> return false
        loop {
            quoted: self.at < length && self.raw[self.at] == (U8{34})
            if quoted {
                self.at += 1
                start: self.at
                escaped := false
                loop {
                    if self.at >= length {
                        self.fail(length, "quoted field ended before its closing quote")
                        return false
                    }
                    byte: Int{self.raw[self.at]}
                    if byte == 34 {
                        if self.at + 1 >= length || self.raw[self.at + 1] != (U8{34}) -> break
                        escaped = true
                        self.at += 2
                        next
                    }
                    self.at += 1
                    if byte == 10 {
                        self.line += 1
                        self.line_start = self.at
                    }
                }
                if escaped -> self.escapes.push(self.spans.len() /% 2)
                self.spans.push(start)
                self.spans.push(self.at)
                self.at += 1
            } else {
                start: self.at
                at := start
                loop at < length {
                    byte: self.raw[at]
                    if byte == (U8{34}) || byte == (U8{44}) || byte == (U8{13}) || byte == (U8{10}) {
                        break
                    }
                    at += 1
                }
                self.at = at
                self.spans.push(start)
                self.spans.push(at)
            }
            if !self.delimit(quoted) -> break
        }
        if self.failure != None -> return false
        self.record += 1
        true
    }

    count: fn(self) -> Int Never! { self.spans.len() /% 2 }

    // Field `column` of the scanned record as text.
    text: fn(self, column: Int) -> String Never! {
        start: self.spans[2 * column]
        end: self.spans[2 * column + 1]
        escaped := false
        loop index in self.escapes {
            if index == column -> escaped = true
        }
        if !escaped -> return field_text(self.raw.slice(start, end))
        bytes := [U8]{}
        at := start
        loop at < end {
            bytes.push(self.raw[at])
            at += if self.raw[at] == (U8{34}) -> 2 else -> 1
        }
        field_text(bytes)
    }

    fields: fn(self) -> [String] Never! {
        loop column in 0..<self.count() -> self.text(column)
    }

    member: fn(self) -> Bool Never! { self.cursor >= 0 && self.cursor < self.header.len() }

    // The plain decimal Int of field `column`: an optional minus and 1 to 18
    // digits. None for any other text, which decodes as its cell.
    plain_int: fn(self, column: Int) -> Int? Never! {
        at := self.spans[2 * column]
        end: self.spans[2 * column + 1]
        negative: at < end && self.raw[at] == (U8{45})
        if negative -> at += 1
        if at == end || end - at > 18 -> return None
        value := 0
        loop at < end {
            digit: Int{self.raw[at]} - 48
            if digit < 0 || digit > 9 -> return None
            value = value * 10 + digit
            at += 1
        }
        Val(if negative -> 0 - value else -> value)
    }

    // The plain decimal Float of field `column`: an optional minus, digits
    // and an optional dot with digits after it, 15 digits at most. Their
    // integer and its power of ten are exact binary64 values, so the quotient
    // is the correctly rounded value the cell's parse gives. None for any
    // other text, which decodes as its cell.
    plain_float: fn(self, column: Int) -> Float? Never! {
        at := self.spans[2 * column]
        end: self.spans[2 * column + 1]
        negative: at < end && self.raw[at] == (U8{45})
        if negative -> at += 1
        whole := 0
        digits := 0
        fraction := -1
        loop at < end {
            byte: Int{self.raw[at]}
            at += 1
            if byte == 46 && fraction < 0 && digits > 0 {
                fraction = 0
                next
            }
            if byte < 48 || byte > 57 || digits == 15 -> return None
            whole = whole * 10 + (byte - 48)
            digits += 1
            if fraction >= 0 -> fraction += 1
        }
        if digits == 0 || fraction == 0 -> return None
        scale := 1.0
        places := fraction
        loop places > 0 {
            scale *= 10.0
            places -= 1
        }
        value: Float{whole} / scale
        Val(if negative -> -value else -> value)
    }

    // The cell at the cursor as its tree, for a read it does not take in place.
    cell: fn(self) -> Dyn Never! { Dyn.Text(self.text(self.cursor)) }

    impl __DecodeSource {
        begin_object: fn(&self) -> Bool Never! {
            if self.cursor != TYPED_CSV_RECORD -> return false
            self.cursor = -1
            true
        }

        next_key: fn(&self) -> Bool Never! {
            if self.cursor < -1 || self.cursor >= self.header.len() -> return false
            self.cursor += 1
            self.cursor < self.header.len()
        }

        key_is: fn(self, name: String) -> Bool Never! {
            self.member() && self.header[self.cursor] == name
        }

        key_text: fn(self) -> String Never! {
            if self.member() -> self.header[self.cursor].copy() else -> ""
        }

        object_members: fn(self) -> Int Never! { -1 }

        begin_array: fn(&self) -> Bool Never! { false }

        next_item: fn(&self) -> Bool Never! { false }

        take_null: fn(&self) -> Bool Never! { false }

        skip: fn(&self) Never! {}

        capture: fn(&self) -> Dyn Never! {
            if self.member() -> return self.cell()
            if self.cursor != TYPED_CSV_RECORD -> return Dyn.Null
            entries := [{key: String, value: Dyn}]{}
            loop column in 0..<self.header.len() {
                entries.push({key: self.header[column].copy(), value: Dyn.Text(self.text(column))})
            }
            stream.object_from_entries(entries)
        }

        read_int: fn(&self) -> Int [FieldError]! {
            if self.member() {
                if self.plain_int(self.cursor) == .Val(value) -> return Ok(value)
            }
            value: self.capture().decode<Int>() ?? return Err(err)
            Ok(value)
        }

        // An escaped field holds a quote, so it is never one of these.
        read_bool: fn(&self) -> Bool [FieldError]! {
            if self.member() {
                start: self.spans[2 * self.cursor]
                size: self.spans[2 * self.cursor + 1] - start
                if size == 4 && self.raw[start] == (U8{116}) && self.raw[start + 1] == (U8{114}) && self.raw[start + 2] == (U8{117}) && self.raw[start + 3] == (U8{101}) {
                    return Ok(true)
                }
                if size == 5 && self.raw[start] == (U8{102}) && self.raw[start + 1] == (U8{97}) && self.raw[start + 2] == (U8{108}) && self.raw[start + 3] == (U8{115}) && self.raw[start + 4] == (U8{101}) {
                    return Ok(false)
                }
            }
            value: self.capture().decode<Bool>() ?? return Err(err)
            Ok(value)
        }

        read_float: fn(&self) -> Float [FieldError]! {
            if self.member() {
                if self.plain_float(self.cursor) == .Val(value) -> return Ok(value)
            }
            value: self.capture().decode<Float>() ?? return Err(err)
            Ok(value)
        }

        read_string: fn(&self) -> String [FieldError]! {
            if self.member() -> return Ok(self.text(self.cursor))
            value: self.capture().decode<String>() ?? return Err(err)
            Ok(value)
        }
    }
}

// Every record of `text` as its fields' text.
typed_records: fn(text: String) -> [[String]] TypedCSVError! {
    csv := TypedCSV.new(text)
    records := [[String]]{}
    loop csv.next() -> records.push(csv.fields())
    if csv.failure == .Val(error) -> return Err(error)
    Ok(records)
}

/// `rows` lifted into `Dyn`: one array of text cells per record, under the
/// same delimiter, header and blank-record options.
parse: fn(text: String, delimiter: String{","}, header: Bool{false}, skip_blank: Bool{true}) -> Dyn EncodingError! {
    physical: rows(text, delimiter, header, skip_blank) ?? return Err(err)
    items := [Dyn]{}
    loop row in physical {
        fields := [Dyn]{}
        loop field in row.fields -> fields.push(Dyn.Text(field))
        items.push(Dyn.Array(fields))
    }
    Ok(Dyn.Array(items))
}

/// CSV as a `Format`: UTF-8 text whose tree is `parse`'s, one array of text
/// cells per record, written back as `to_string` writes it.
///
/// ```jet
/// tree: parse("a,b\n1,2\n") ?? panic("{err}")
/// back: Codec.read(Codec.write(tree) ?? panic("{err}")) ?? panic("{err}")
/// to_string(back) == to_string(tree) // => true
/// ```
Codec: struct {
    impl Format {
        name: "csv",

        read: fn(bytes: [U8]) -> Dyn FormatError! {
            text: String.from_bytes(bytes) ?? return Err(FormatError{format: "csv", reason: "the bytes are not UTF-8"})
            tree: parse(text) ?? return Err(FormatError{format: "csv", reason: err.display_text()})
            Ok(tree)
        }

        write: fn(tree: Dyn) -> [U8] FormatError! {
            if !(tree == .Array(_)) {
                return Err(FormatError{format: "csv", reason: "CSV writes an array of rows or records"})
            }
            Ok(to_string(tree).bytes())
        }
    }
}

#Test("the CSV format writes rows and reads them back") {
    tree: parse("a,b\n1,2\n") ?? panic("CSV")
    bytes: Codec.write(tree) ?? panic("write")
    back: Codec.read(bytes) ?? panic("read")
    assert_eq(to_string(back), to_string(tree))
    if Codec.write(Dyn.Int(1)) == {
        .Ok(_) -> { panic("a number wrote as CSV") }
        .Err(failure) -> assert_eq(failure.reason, "CSV writes an array of rows or records")
    }
}

// `rows` is a list of row arrays or records, or the row-array tree `parse`
// returns; each encodes to one array of rows, so `parse` round-trips.
// `formulas` says what a text cell that opens a formula is written as.
to_string: fn<T: Encode>(rows: T, formulas: CSVFormulas{CSVFormulas.Escape}) -> String Never! {
    encoded: rows.encode()
    items: if encoded == {
        .Array(values) -> values
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> panic("csv.to_string needs rows or records")
    }
    if items.len() == 0 -> return ""
    out := ""
    if items[0] == .Object(_) {
        header := [String]{}
        loop entry in stream.object_entries(items[0]) -> header.push(entry.key)
        out = encode_row(header, formulas)
        loop tree in items {
            if !(tree == .Object(_)) -> panic("csv.to_string needs rows or records")
            fields := [String]{}
            loop key in header {
                cell := ""
                loop entry in stream.object_entries(tree) {
                    if entry.key == key {
                        cell = formula_cell(entry.value, formulas)
                        break
                    }
                }
                fields.push(cell)
            }
            out = "{out}\n{encode_row(fields, CSVFormulas.Keep)}"
        }
    } else {
        loop i in 0..<items.len() {
            if items[i] == {
                .Array(cells) -> {
                    fields := [String]{}
                    loop cell in cells -> fields.push(formula_cell(cell, formulas))
                    if i > 0 -> out = "{out}\n"
                    out = "{out}{encode_row(fields, CSVFormulas.Keep)}"
                }
                .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> {
                    panic("csv.to_string needs rows or records")
                }
            }
        }
    }
    out
}

// A cell is text: Bytes and DateTime carry the base64 and RFC 3339 texts JSON
// writes for them, and any other tree is its JSON text.
csv_cell: fn(value: Dyn) -> String Never! {
    if value == {
        .Text(text) -> text
        .Int(n) -> "{n}"
        .Float(n) -> "{n:Debug}"
        .Bool(b) -> "{b}"
        .Null -> ""
        .Bytes(bytes) -> base64.encode(bytes)
        .DateTime(_) -> value.to_text() ?? ""
        .Number(_) | .Array(_) | .Object(_) -> json.to_string(value) ?? panic("CSV cell cannot be represented as JSON")
    }
}

/// What a writer does with a text cell a spreadsheet would run as a formula:
/// one that opens with `=`, `+`, `-`, `@`, a tab or a carriage return and is
/// not a number (OWASP CSV injection). `Escape` writes it after an
/// apostrophe; `Keep` writes it as it is. Reading never strips an
/// apostrophe, so a cell that already opens with one round-trips exactly.
CSVFormulas: enum {
    Escape,
    Keep,
}

// Does `formulas` escape text cell `cell`: it opens a formula and is not a
// number such as `-12.5`.
priv formula_escaped: fn(cell: String, formulas: CSVFormulas) -> Bool Never! {
    if formulas == .Keep || cell.count_bytes() == 0 -> return false
    lead: stream.byte_at(cell, 0)
    if lead == (U8{61}) || lead == (U8{64}) || lead == (U8{9}) || lead == (U8{13}) -> return true
    if lead != (U8{43}) && lead != (U8{45}) -> return false
    _ := Float.parse(cell) ?? return true
    false
}

// A record cell's text (`csv_cell`), after an apostrophe when it is a text
// cell `formulas` escapes; a number, a Bool or a byte string is never one.
priv formula_cell: fn(value: Dyn, formulas: CSVFormulas) -> String Never! {
    cell: csv_cell(value)
    if value == .Text(_) && formula_escaped(cell, formulas) -> return "'{cell}"
    cell
}

delimiter_at: fn(raw: [U8], i: Int, delimiter: [U8]) -> Bool {
    if i + delimiter.len() > raw.len() -> return false
    loop k in 0..<delimiter.len() {
        if raw[i + k] != delimiter[k] -> return false
    }
    true
}

// A field's bytes as text. They are a String's bytes, cut only at an ASCII
// quote, CR or LF, or around a whole match of the delimiter's complete UTF-8
// encoding (plus `""` escapes as ASCII quotes). UTF-8 is self-synchronizing,
// as a lead byte never equals a continuation byte, so every cut is a scalar
// boundary and the bytes are complete UTF-8. They are still checked rather
// than taken under `#Unsafe`: a field is short, and the check (a word of
// ASCII at a time) costs less than entering and leaving an unsafe scope for
// every field.
field_text: fn(bytes: [U8]) -> String Never! {
    String.from_bytes(bytes) ?? panic("internal: a CSV field was cut inside a UTF-8 scalar")
}

// An unquoted field is the bytes from its start to its delimiter or line
// break, taken as one slice; a quoted field collects its unescaped bytes.
// It keeps the streaming reader's contract: a record ends at LF or CRLF (a bare
// CR is malformed); errors carry the reader's kind, reason, path and one-based
// line and column (counted in scalars); `header` drops the first record and
// `skip_blank` drops each record whose fields are all empty.
parse_rows_with: fn(text: String, delimiter: [U8], header: Bool, skip_blank: Bool) -> [CSVRow] EncodingError! {
    raw: text.bytes()
    first: delimiter[0]
    width: delimiter.len()
    name: if width == 1 && first == 44 -> "comma" else -> "delimiter"
    rows := [CSVRow]{}
    fields := [String]{}
    field := [U8]{}
    start := 0
    line := 1
    row_line := 1
    column := 1
    record := 0
    i := 0
    quoted := false
    closed := false
    loop i < raw.len() {
        b: raw[i]
        n: b
        if fields.len() == 0 && i == start && !quoted && !closed -> row_line = line
        if quoted {
            if n == 34 {
                if i + 1 < raw.len() && raw[i + 1] == (U8{34}) {
                    field.push(U8{34})
                    i += 2
                    column += 2
                    next
                }
                quoted = false
                closed = true
                i += 1
                column += 1
                next
            }
            field.push(b)
            i += 1
            if n == 10 {
                line += 1
                column = 1
            } else if n < 128 || n >= 192 { column += 1 }
            next
        }
        if n == 13 && (i + 1 >= raw.len() || raw[i + 1] != (U8{10})) {
            // The reader reports a bare CR when the next byte (or EOF) arrives.
            at: if i + 1 < raw.len() -> i + 1 else -> i
            return Err(syntax_error(EncodingFormat.CSV, at, line, column, "$[{record}][{fields.len()}]", "bare CR is not a record ending"))
        }
        if closed {
            if n == first && (width == 1 || delimiter_at(raw, i, delimiter)) {
                fields.push(field_text(field))
                field = [U8]{}
                closed = false
                i += width
                start = i
                column += 1
                next
            }
            if n != 10 && n != 13 {
                return Err(syntax_error(EncodingFormat.CSV, i, line, column, "$[{record}][{fields.len()}]", "only quote, {name}, CRLF, LF, or EOF may follow a closing quote"))
            }
            fields.push(field_text(field))
            field = [U8]{}
            closed = false
        } else if n == 34 {
            if i != start {
                return Err(syntax_error(EncodingFormat.CSV, i, line, column, "$[{record}][{fields.len()}]", "quote inside an unquoted field"))
            }
            quoted = true
            i += 1
            column += 1
            next
        } else if n == first && (width == 1 || delimiter_at(raw, i, delimiter)) {
            fields.push(field_text(raw.slice(start, i)))
            i += width
            start = i
            column += 1
            next
        } else if n == 10 || n == 13 { fields.push(field_text(raw.slice(start, i))) } else {
            // The rest of the unquoted field, up to its next quote, delimiter
            // byte or line break.
            i += 1
            column += 1
            loop i < raw.len() {
                c: raw[i]
                if c == 34 || c == first || c == 10 || c == 13 -> break
                if c < 128 || c >= 192 -> column += 1
                i += 1
            }
            next
        }
        // LF or CRLF ends the record.
        if kept_record(fields, record, header, skip_blank) {
            rows.push(CSVRow{line: row_line, fields: fields.move()})
        }
        fields = [String]{}
        record += 1
        if n == 13 -> i += 1
        line += 1
        column = 1
        i += 1
        start = i
    }
    if quoted {
        return Err(codec_error(.Truncated, raw.len() - 1, line, column, "$[{record}][{fields.len()}]", "quoted field ended before its closing quote"))
    }
    if closed || i > start || fields.len() > 0 {
        if closed -> fields.push(field_text(field)) else {
            fields.push(field_text(raw.slice(start, i)))
        }
        if kept_record(fields, record, header, skip_blank) {
            rows.push(CSVRow{line: row_line, fields: fields.move()})
        }
    }
    Ok(rows)
}

kept_record: fn(fields: [String], record: Int, header: Bool, skip_blank: Bool) -> Bool Never! {
    if header && record == 0 -> return false
    if !skip_blank -> return true
    loop field in fields {
        if field.len() > 0 -> return true
    }
    false
}

priv encode_row: fn(fields: [String], formulas: CSVFormulas) -> String {
    out := ""
    loop i in 0..<fields.len() {
        if i > 0 -> out = "{out},"
        out = "{out}{encode_field(fields[i], formulas)}"
    }
    out
}

priv encode_field: fn(field: String, formulas: CSVFormulas) -> String {
    if formula_escaped(field, formulas) -> return encode_field("'{field}", CSVFormulas.Keep)
    needs := false
    loop b in field.bytes() {
        n: b
        if n == 44 || n == 34 || n == 10 || n == 13 -> needs = true
    }
    if !needs -> return field.copy()
    out := [U8]{34}
    loop b in field.bytes() {
        if b == (U8{34}) {
            out.push(U8{34})
            out.push(U8{34})
        } else { out.push(b) }
    }
    out.push(U8{34})
    String.from_bytes(out) ?? field
}

DictRow: struct {
    fields: [String],
    values: [String],
}

dict_rows: fn(text: String) -> [DictRow] EncodingError! {
    physical: parse_rows_with(text, [U8]{44}, false, true)
    if physical.len() == 0 -> return Ok([DictRow]{})
    header: physical[0].fields
    out := [DictRow]{}
    loop i in 1..<physical.len() {
        record: physical[i]
        if record.fields.len() != header.len() {
            return Err(codec_error(.Syntax, 0, record.line, 1, "$[{i}]", ragged_reason(i, record.fields.len(), header.len())))
        }
        out.push(DictRow{fields: header.copy(), values: record.fields.copy()})
    }
    Ok(out)
}

dict_get: fn(row: DictRow, key: String) -> String? Never! {
    i := 0
    loop i < row.fields.len() {
        if row.fields[i] == key -> return Val(row.values[i])
        i += 1
    }
    None
}

dict_get_or: fn(row: DictRow, key: String, fallback: String) -> String Never! {
    dict_get(row, key) ?? fallback
}

write_dict: fn(rows: [DictRow], formulas: CSVFormulas{CSVFormulas.Escape}) -> String Never! {
    if rows.len() == 0 -> return ""
    out := "{encode_row(rows[0].fields, formulas)}\n"
    loop row in rows -> out = "{out}{encode_row(row.values, formulas)}\n"
    out
}

fieldnames: fn(rows: [DictRow]) -> [String] Never! {
    if rows.len() == 0 -> return [String]{}
    rows[0].fields
}

#Test("CSV typed renderer retains whole-value wire layout") {
    assert(to_string([[String]{"a", "b"}, [String]{"c,d", "e"}]) == "a,b\n\"c,d\",e")
    assert(to_string([[String]{}]) == "")
}

codec_error: fn(kind: EncodingErrorKind, offset: Int, line: Int, column: Int, path: String, reason: String) -> EncodingError Never! {
    EncodingError{format: .CSV, kind: kind, byte_offset: offset, line: Val(line), column: Val(column), path: path, reason: reason, cause: None}
}

csv_limits: fn(limits: EncodingLimits) EncodingError! {
    stream.validate_limits(limits) ?? {
        error := err
        error.format = .CSV
        return Err(error)
    }
}

// A bounded record writer to any byte sink (a FileWriter, a socket, or any
// other `Writer`). Each record goes to it in one write, its CRLF in another.
CSVWriter: struct<W: Writer> {
    output: W,
    limits: EncodingLimits,
    terminal: EncodingError?,
    total: Int,
    record_index: Int,
    finished: Bool,
    pending_crlf: Bool,
    // The bytes of one write to `output`, kept so their room is reused.
    buffer: [U8],
    // What a text cell that opens a formula is written as.
    formulas: CSVFormulas,

    error: fn(self, kind: EncodingErrorKind, field: Int, reason: String) -> EncodingError Never! {
        codec_error(kind, self.total, self.record_index + 1, 1, "$[{self.record_index}][{field}]", reason)
    }

    io_error: fn(self, cause: EncodingCause) -> EncodingError Never! {
        error := self.error(.IO, 0, "file IO failed")
        error.cause = Val(cause)
        error
    }

    // Writes `buffer` to the sink, if it holds any bytes, and empties it.
    drain: fn(&self) -[IO]> EncodingError! {
        if self.buffer.len() == 0 {
            return
        }
        self.output.write_bytes(self.buffer) ?? {
            self.buffer.clear()
            return Err(self.io_error(stream.io_cause(err)))
        }
        self.buffer.clear()
    }

    close_record: fn(&self) -[IO]> EncodingError! {
        if !self.pending_crlf {
            return
        }
        if self.limits.max_total_bytes == .Val(limit) {
            if self.total > limit - 2 {
                return Err(self.error(.Limit, 0, "max_total_bytes {limit} exceeded"))
            }
        }
        self.buffer.push(U8{13})
        self.buffer.push(U8{10})
        self.drain() ?? return Err(err)
        self.total += 2
        self.pending_crlf = false
    }

    write_inner: fn(&self, row: [String]) -[IO]> EncodingError! {
        if self.finished -> return Err(self.error(.State, 0, "write called after finish"))
        self.close_record() ?? return Err(err)
        decoded := 0
        wire := 0
        loop i in 0..<row.len() {
            field: row[i]
            decoded += field.count_bytes()
            if decoded > self.limits.max_item_bytes {
                return Err(self.error(.Limit, i, "max_item_bytes {self.limits.max_item_bytes} exceeded"))
            }
            quoted := false
            quotes := 0
            loop at in 0..<field.count_bytes() {
                byte: stream.byte_at(field, at)
                if byte == (U8{34}) -> quotes += 1
                if byte == (U8{44}) || byte == (U8{34}) || byte == (U8{13}) || byte == (U8{10}) {
                    quoted = true
                }
            }
            escaped: if formula_escaped(field, self.formulas) -> 1 else -> 0
            wire += field.count_bytes() + escaped + (if quoted -> 2 + quotes else -> 0) + (if i > 0 -> 1 else -> 0)
        }
        if self.limits.max_total_bytes == .Val(limit) {
            if wire > limit - self.total - 2 {
                last: if row.len() > 0 -> row.len() - 1 else -> 0
                return Err(self.error(.Limit, last, "max_total_bytes {limit} exceeded"))
            }
        }
        loop i in 0..<row.len() {
            if i > 0 -> self.buffer.push(U8{44})
            field: row[i]
            quoted := false
            loop at in 0..<field.count_bytes() {
                byte: stream.byte_at(field, at)
                if byte == (U8{44}) || byte == (U8{34}) || byte == (U8{13}) || byte == (U8{10}) {
                    quoted = true
                }
            }
            if quoted -> self.buffer.push(U8{34})
            if formula_escaped(field, self.formulas) -> self.buffer.push(U8{39})
            loop at in 0..<field.count_bytes() {
                byte: stream.byte_at(field, at)
                self.buffer.push(byte)
                if quoted && byte == (U8{34}) -> self.buffer.push(byte)
            }
            if quoted -> self.buffer.push(U8{34})
        }
        self.drain() ?? return Err(err)
        self.total += wire
        self.pending_crlf = true
        self.record_index += 1
    }

    write: fn(&self, row: &&[String]) -[IO]> EncodingError! {
        if self.terminal == .Val(error) -> return Err(error)
        self.write_inner(row) ?? {
            self.terminal = Val(err)
            return Err(err)
        }
    }

    // A held CRLF is written first, so a flushed file ends on a whole record.
    flush: fn(&self) -[IO]> EncodingError! {
        if self.terminal == .Val(error) -> return Err(error)
        self.close_record() ?? {
            self.terminal = Val(err)
            return Err(err)
        }
        self.output.flush() ?? {
            error: self.io_error(stream.io_cause(err))
            self.terminal = Val(error)
            return Err(error)
        }
    }

    finish: fn(&self) -[IO]> EncodingError! {
        if self.terminal == .Val(error) -> return Err(error)
        if self.finished {
            return
        }
        self.flush() ?? return Err(err)
        self.finished = true
    }
}

writer: fn<W: Writer>(target: &&W, limits: EncodingLimits{EncodingLimits.safe()}, formulas: CSVFormulas{CSVFormulas.Escape}) -> CSVWriter<W> EncodingError! {
    csv_limits(limits) ?? return Err(err)
    Ok(CSVWriter<W>{output: target.move(), limits: limits, terminal: None, total: 0, record_index: 0, finished: false, pending_crlf: false, buffer: [U8]{}, formulas: formulas})
}

// A record that takes its fields, not a copy of them.
priv csv_row: fn(line: Int, fields: &&[String]) -> CSVRow Never! {
    CSVRow{line: line, fields: fields.move()}
}

// A bounded record reader over any byte source (a FileReader, a socket, or
// any other `Reader`), read `buffer_bytes` at a time.
CSVReader: struct<R: Reader> {
    input: R,
    limits: EncodingLimits,
    delimiter: Int,
    // One entry per byte value: 1 for each byte that ends a run of plain
    // field bytes (a quote, CR, LF, the delimiter, any byte from 128).
    priv stops: [U8],
    header: Bool,
    skip_blank: Bool,
    field: [U8],
    fields: [String],
    fields_heap: Int,
    // The last record's field count: a new record's fields start with room for that many.
    record_width: Int,
    allocation: stream.AllocationBudget,
    quoted: Bool,
    after_quote: Bool,
    pending_cr: Bool,
    pending_cr_line: Int,
    pending_cr_column: Int,
    record: Int,
    parser_line: Int,
    parser_column: Int,
    record_line: Int,
    record_has_content: Bool,
    ended_record: Bool,
    saw_input: Bool,
    total: Int,
    offset: Int,
    line: Int,
    column: Int,
    eof: Bool,
    terminal: EncodingError?,
    char0: U8,
    char1: U8,
    char2: U8,
    char3: U8,
    char_width: Int,
    // The bytes read ahead from `input` (buffer_bytes at a time, charged to
    // `allocation` once), and how many of them `byte` has taken.
    buffer: [U8],
    buffered: Int,
    priv plain_chunk: String,
    priv plain_start: Int,
    priv plain_end: Int,
    priv plain_checked: Bool,

    path: fn(self) -> String Never! { "$[{self.record - 1}][{self.fields.len()}]" }

    parser_error: fn(self, kind: EncodingErrorKind, line: Int, column: Int, reason: String) -> EncodingError Never! {
        offset: if self.offset > 0 -> self.offset - 1 else -> 0
        codec_error(kind, offset, line, column, self.path(), reason)
    }

    capacity_error: fn(self) -> EncodingError Never! {
        codec_error(.Limit, self.offset, self.parser_line, self.parser_column, self.path(), "CSV record heap exceeded the bounded codec heap ceiling")
    }

    byte: fn(&self) -[IO]> U8? EncodingError! {
        if self.buffered == self.buffer.len() {
            if mem.__list_capacity<U8>(self.buffer) == 0 && !stream.reserve<U8>(self.allocation, self.buffer, self.limits.buffer_bytes) {
                return Err(self.capacity_error())
            }
            self.buffer.clear()
            self.buffered = 0
            self.plain_checked = false
            // A Reader may grow the buffer past its reserve (FileReader keeps
            // its error words there); the growth is charged like any other.
            capacity: mem.__list_capacity<U8>(self.buffer)
            count: self.input.read_into(self.buffer, self.limits.buffer_bytes) ?? {
                error := codec_error(.IO, self.offset, self.line, self.column, self.path(), "file IO failed")
                error.cause = Val(stream.io_cause(err))
                return Err(error)
            }
            grown: mem.__list_capacity<U8>(self.buffer) - capacity
            if grown > 0 && !self.allocation.charge(grown) -> return Err(self.capacity_error())
            if count == 0 -> return Ok(None)
        }
        byte: self.buffer[self.buffered]
        self.buffered += 1
        if self.limits.max_total_bytes == .Val(limit) {
            if self.total >= limit {
                return Err(codec_error(.Limit, self.offset, self.line, self.column, self.path(), "max_total_bytes {limit} exceeded"))
            }
        }
        self.total += 1
        self.offset += 1
        if byte == 10 {
            self.line += 1
            self.column = 1
        } else { self.column += 1 }
        Ok(Val(byte))
    }

    utf8_error: fn(self, offset: Int) -> EncodingError Never! {
        codec_error(.Syntax, offset, self.line, self.column, self.path(), "CSV input is not valid UTF-8")
    }

    character: fn(&self) -[IO]> Int? EncodingError! {
        first: if self.byte() == {
            .Ok(value) -> value
            .Err(error) -> {
                return Err(error)
            }
        }
        self.char0 = first ?? return Ok(None)
        n: Int{self.char0}
        width: if n <= 127 -> 1 else if n >= 194 && n <= 223 -> 2 else if n >= 224 && n <= 239 -> 3 else if n >= 240 && n <= 244 -> 4 else -> 0
        if width == 0 -> return Err(self.utf8_error(self.offset - 1))
        self.char_width = width
        loop i in 1..<width {
            byte: if self.byte() == {
                .Ok(value) -> value
                .Err(error) -> {
                    return Err(error)
                }
            }
            continuation: byte ?? return Err(self.utf8_error(self.offset))
            if i == 1 -> self.char1 = continuation else if i == 2 -> self.char2 = continuation else {
                self.char3 = continuation
            }
        }
        loop i in 1..<width {
            b: Int{self.character_byte(i)}
            if b < 128 || b > 191 -> return Err(self.utf8_error(self.offset - width))
        }
        second: Int{self.char1}
        if (n == 224 && second < 160) || (n == 237 && second > 159) || (n == 240 && second < 144) || (n == 244 && second > 143) {
            return Err(self.utf8_error(self.offset - width))
        }
        value := n & (if width == 1 -> 127 else if width == 2 -> 31 else if width == 3 -> 15 else -> 7)
        loop i in 1..<width -> value = (value << 6) | (Int{self.character_byte(i)} & 63)
        Ok(Val(value))
    }

    character_byte: fn(self, index: Int) -> U8 Never! {
        if index == 0 -> self.char0 else if index == 1 -> self.char1 else if index == 2 -> self.char2 else -> self.char3
    }

    append: fn(&self, byte: U8) EncodingError! {
        capacity: mem.__list_capacity<U8>(self.field)
        if self.field.len() == capacity {
            grown: if capacity < 8 -> 8 else -> capacity * 2
            additional: grown - self.field.len()
            if !stream.reserve<U8>(self.allocation, self.field, additional) {
                return Err(self.capacity_error())
            }
        }
        self.field.push(byte)
    }

    // Room for one more field, once `fields` is full.
    __grow_fields: fn(&self) EncodingError! {
        capacity: mem.__list_capacity<String>(self.fields)
        grown: if capacity == 0 && self.record_width > 4 -> self.record_width else if capacity < 4 -> 4 else -> capacity * 2
        additional: grown - self.fields.len()
        if !stream.reserve<String>(self.allocation, self.fields, additional) {
            return Err(self.capacity_error())
        }
    }

    finish_field: fn(&self) EncodingError! {
        if self.fields.len() == mem.__list_capacity<String>(self.fields) {
            self.__grow_fields() ?? return Err(err)
        }
        self.fields_heap += mem.__list_capacity<U8>(self.field)
        text := ""
        #Unsafe("each completed UTF-8 scalar was validated before its original bytes entered this field") {
            text = rt.bytes_into_text(self.field)
        }
        self.field = [U8]{}
        self.fields.push(text)
    }

    finish_record: fn(&self) -> CSVRow? EncodingError! {
        self.finish_field() ?? return Err(err)
        self.__end_record()
    }

    // The record whose last field is already in `fields`.
    __end_record: fn(&self) -> CSVRow? EncodingError! {
        number: self.record
        line: self.record_line
        content: self.record_has_content
        self.record += 1
        self.record_line = self.parser_line
        self.record_has_content = false
        self.ended_record = true
        self.record_width = self.fields.len()
        if (self.header && number == 1) || (self.skip_blank && !content) {
            loop self.fields.len() > 0 -> _: self.fields.pop()
            self.allocation.release(self.fields_heap)
            self.fields_heap = 0
            return Ok(None)
        }
        heap: mem.__list_capacity<String>(self.fields) * mem.__type_size<String>() + self.fields_heap
        row: csv_row(line, self.fields.move())
        self.fields = [String]{}
        self.fields_heap = 0
        self.allocation.release(heap)
        Ok(Val(row))
    }

    push: fn(&self, character: Int) -> CSVRow? EncodingError! {
        appended := 0
        if self.pending_cr {
            if self.quoted && character == 10 -> appended = 2
        } else if self.quoted {
            if self.after_quote {
                if character == 34 -> appended = 1
            } else if character != 34 { appended = self.char_width }
        } else if character != 34 && character != 13 && character != 10 && character != self.delimiter {
            appended = self.char_width
        }
        if self.field.len() + appended > self.limits.max_item_bytes {
            return Err(self.parser_error(.Limit, self.parser_line, self.parser_column, "max_item_bytes {self.limits.max_item_bytes} exceeded"))
        }
        self.saw_input = true
        if self.pending_cr {
            if character != 10 {
                return Err(self.parser_error(.Syntax, self.pending_cr_line, self.pending_cr_column, "bare CR is not a record ending"))
            }
            self.pending_cr = false
            self.parser_line += 1
            self.parser_column = 0
            if self.quoted {
                self.append(U8{13}) ?? return Err(err)
                self.append(U8{10}) ?? return Err(err)
                self.record_has_content = true
                return Ok(None)
            }
            return self.finish_record()
        }
        self.ended_record = false
        self.parser_column += 1
        if self.quoted {
            if self.after_quote {
                if character == 34 {
                    self.append(U8{34}) ?? return Err(err)
                    self.record_has_content = true
                    self.after_quote = false
                    return Ok(None)
                }
                if character == self.delimiter {
                    self.finish_field() ?? return Err(err)
                    self.quoted = false
                    self.after_quote = false
                    return Ok(None)
                }
                if character == 13 || character == 10 {
                    self.quoted = false
                    self.after_quote = false
                } else {
                    name: if self.delimiter == 44 -> "comma" else -> "delimiter"
                    return Err(self.parser_error(.Syntax, self.parser_line, self.parser_column, "only quote, {name}, CRLF, LF, or EOF may follow a closing quote"))
                }
            } else {
                if character == 34 -> self.after_quote = true else {
                    loop i in 0..<self.char_width {
                        self.append(self.character_byte(i)) ?? return Err(err)
                    }
                    self.record_has_content = true
                    if character == 10 {
                        self.parser_line += 1
                        self.parser_column = 0
                    }
                }
                return Ok(None)
            }
        }
        if character == 34 {
            if self.field.len() != 0 {
                return Err(self.parser_error(.Syntax, self.parser_line, self.parser_column, "quote inside an unquoted field"))
            }
            self.quoted = true
        } else if character == self.delimiter { self.finish_field() ?? return Err(err) } else if character == 13 {
            self.pending_cr = true
            self.pending_cr_line = self.parser_line
            self.pending_cr_column = self.parser_column
        } else if character == 10 {
            self.parser_line += 1
            self.parser_column = 0
            return self.finish_record()
        } else {
            loop i in 0..<self.char_width -> self.append(self.character_byte(i)) ?? return Err(err)
            self.record_has_content = true
        }
        Ok(None)
    }

    // The bytes of unquoted fields waiting in the buffer, and the delimiters
    // between them, taken as `byte`, `character` and `push` would take them
    // one at a time. It stops before any byte that could start a quote, make
    // the field grow, or reach a limit; `character` and `push` take that one.
    // A whole ASCII field that starts at an empty field and ends at the
    // delimiter or LF inside the buffer becomes its text in one copy, and its
    // LF ends the record here.
    __take_plain: fn(&self) -> CSVRow? EncodingError! {
        loop !self.quoted && !self.pending_cr && self.buffered < self.buffer.len() {
            room := self.buffer.len() - self.buffered
            if self.limits.max_total_bytes == .Val(limit) -> room = min(room, limit - self.total)
            if room <= 0 -> return Ok(None)
            b: self.buffer[self.buffered]
            if b < 128 && (Int{b}) == self.delimiter {
                self.buffered += 1
                self.total += 1
                self.offset += 1
                self.column += 1
                self.saw_input = true
                self.ended_record = false
                self.parser_column += 1
                self.char0 = b
                self.char_width = 1
                self.finish_field() ?? return Err(err)
                next
            }
            if self.field.len() == 0 {
                start: self.buffered
                scan: start + min(room, self.limits.max_item_bytes + 1)
                end := start
                loop end < scan && self.stops[Int{self.buffer[end]}] == 0 -> end += 1
                taken: end - start
                if taken > 0 && end < start + room && taken <= self.limits.max_item_bytes {
                    t: self.buffer[end]
                    lf: t == 10
                    if lf || (Int{t}) == self.delimiter {
                        if self.fields.len() == mem.__list_capacity<String>(self.fields) {
                            self.__grow_fields() ?? return Err(err)
                        }
                        if !self.allocation.charge(taken) -> return Err(self.capacity_error())
                        self.fields_heap += taken
                        #Unsafe("every byte of the field is below 128, so it is whole UTF-8") {
                            self.fields.push(rt.bytes_into_text(self.buffer[start..<end]))
                        }
                        self.buffered = end + 1
                        self.total += taken + 1
                        self.offset += taken + 1
                        self.saw_input = true
                        self.ended_record = false
                        self.record_has_content = true
                        self.char0 = t
                        self.char_width = 1
                        if lf {
                            self.line += 1
                            self.column = 1
                            self.parser_line += 1
                            self.parser_column = 0
                            return self.__end_record()
                        }
                        self.column += taken + 1
                        self.parser_column += taken + 1
                        next
                    }
                }
            }
            count: min(room, min(mem.__list_capacity<U8>(self.field), self.limits.max_item_bytes) - self.field.len())
            taken := 0
            loop taken < count {
                c: self.buffer[self.buffered + taken]
                if self.stops[Int{c}] != 0 -> break
                self.field.push(c)
                taken += 1
            }
            if taken == 0 -> return Ok(None)
            self.buffered += taken
            self.total += taken
            self.offset += taken
            self.column += taken
            self.parser_column += taken
            self.saw_input = true
            self.ended_record = false
            self.record_has_content = true
            self.char0 = self.buffer[self.buffered - 1]
            self.char_width = 1
        }
        Ok(None)
    }

    __finish_plain_chunk: fn(&self) {
        consumed: self.buffered - self.plain_start
        self.total += consumed
        self.offset += consumed
        self.line = self.record_line
        self.parser_line = self.record_line
        self.column = 1
        self.parser_column = 0
        self.saw_input = true
        self.ended_record = true
        self.record_has_content = false
        self.char0 = U8{10}
        self.char_width = 1
        self.plain_end = 0
        self.plain_start = 0
        self.plain_chunk = ""
    }

    // When the remaining bytes in `self.buffer` are pure ASCII with no quotes
    // or carriage returns and fit within the reader's item/total/heap budgets,
    // convert the buffer to one String once and slice plain fields directly
    // from it up to the last LF in the buffer.
    __prime_plain_chunk: fn(&self) {
        if self.quoted || self.pending_cr || self.field.len() != 0 || self.fields.len() != 0 {
            return
        }
        self.plain_checked = true
        self.plain_end = 0
        if self.delimiter >= 128 {
            return
        }
        buf_len: self.buffer.len()
        remaining: buf_len - self.buffered
        if remaining <= 1 -> return
        if self.limits.max_total_bytes == .Val(limit) && self.total + remaining > limit -> return
        if remaining > self.limits.max_item_bytes -> return
        if self.allocation.used + remaining * 4 > self.allocation.limit -> return
        last_lf := buf_len - 1
        loop last_lf >= self.buffered && self.buffer[last_lf] != 10 -> last_lf -= 1
        if last_lf < self.buffered -> return
        chunk: String.from_bytes(self.buffer) ?? return
        if chunk.len() != buf_len || chunk.contains("\"") || chunk.contains("\r") -> return
        self.plain_chunk = chunk
        self.plain_start = self.buffered
        self.plain_end = last_lf + 1
    }

    __next_plain_row: fn(&self) -> CSVRow? {
        delim: U8{self.delimiter}
        loop self.buffered < self.plain_end {
            line_start: self.buffered
            number: self.record
            line_num: self.record_line
            self.record = number + 1
            self.record_line = line_num + 1
            if self.header && number == 1 {
                pos := line_start
                loop self.buffer[pos] != 10 -> pos += 1
                self.buffered = pos + 1
                if self.buffered >= self.plain_end -> self.__finish_plain_chunk()
                next
            }
            if self.skip_blank && self.buffer[line_start] == 10 {
                self.buffered = line_start + 1
                if self.buffered >= self.plain_end -> self.__finish_plain_chunk()
                next
            }
            pos := line_start
            parts: csv_plain_fields(self.buffer, self.plain_chunk, pos, delim, self.record_width)
            self.buffered = pos
            self.record_width = parts.len()
            if pos >= self.plain_end -> self.__finish_plain_chunk()
            return Val(csv_row(line_num, parts.move()))
        }
        None
    }

    next_inner: fn(&self) -[IO]> CSVRow? EncodingError! {
        if self.eof -> return Ok(None)
        loop {
            if self.buffered < self.plain_end {
                if self.__next_plain_row() == .Val(row) -> return Ok(Val(row))
            }
            if !self.plain_checked && self.buffered < self.buffer.len() {
                self.__prime_plain_chunk()
                if self.buffered < self.plain_end {
                    if self.__next_plain_row() == .Val(row) -> return Ok(Val(row))
                }
            }
            plain: if self.__take_plain() == {
                .Ok(record) -> record
                .Err(error) -> {
                    return Err(error)
                }
            }
            if plain != None -> return Ok(Val(plain))
            character: if self.character() == {
                .Ok(value) -> value
                .Err(error) -> {
                    return Err(error)
                }
            }
            if character == .Val(value) {
                row: if self.push(value) == {
                    .Ok(record) -> record
                    .Err(error) -> {
                        return Err(error)
                    }
                }
                if row != None -> return Ok(Val(row))
            } else {
                self.eof = true
                if self.pending_cr {
                    return Err(self.parser_error(.Syntax, self.pending_cr_line, self.pending_cr_column, "bare CR is not a record ending"))
                }
                if self.quoted && !self.after_quote {
                    return Err(self.parser_error(.Truncated, self.parser_line, self.parser_column + 1, "quoted field ended before its closing quote"))
                }
                if self.ended_record || !self.saw_input -> return Ok(None)
                self.quoted = false
                self.after_quote = false
                return self.finish_record()
            }
        }
    }

    next: fn(&self) -[IO]> CSVRow? EncodingError! {
        if self.buffered < self.plain_end {
            if self.__next_plain_row() == .Val(row) -> return Ok(Val(row))
        }
        if self.terminal == .Val(error) -> return Err(error)
        result: if self.next_inner() == {
            .Ok(row) -> row
            .Err(error) -> {
                self.terminal = Val(error)
                return Err(error)
            }
        }
        Ok(result)
    }
}

priv csv_plain_fields: fn(buffer: [U8], chunk: String, pos: &Int, delim: U8, width: Int) -> [String] Never! {
    parts := [String]{}
    if width > 0 {
        _: mem.__list_reserve_exact<String>(parts, width)
    }
    start := pos
    i := pos
    // For any delimiter above LF (comma is 44), any byte > delim is plain data.
    if delim > 10 {
        loop {
            b: buffer[i]
            if b > delim {
                i += 1
                next
            }
            if b == delim {
                parts.push(chunk.slice(start..<i))
                i += 1
                start = i
                next
            }
            if b == 10 {
                parts.push(chunk.slice(start..<i))
                pos = i + 1
                return parts
            }
            i += 1
        }
    }
    loop {
        b: buffer[i]
        if b == delim {
            parts.push(chunk.slice(start..<i))
            i += 1
            start = i
            next
        }
        if b == 10 {
            parts.push(chunk.slice(start..<i))
            pos = i + 1
            return parts
        }
        i += 1
    }
}

reader: fn<R: Reader>(source: &&R, limits: EncodingLimits{EncodingLimits.safe()}, delimiter: String{","}, header: Bool{false}, skip_blank: Bool{false}) -> CSVReader<R> EncodingError! {
    csv_limits(limits) ?? return Err(err)
    raw: delimiter.bytes()
    reason: "a CSV delimiter is one character other than a quote or a line ending"
    if raw.len() == 0 || raw.len() > 4 {
        return Err(unsupported_error(EncodingFormat.CSV, 0, reason))
    }
    n: Int{raw[0]}
    width: if n < 128 -> 1 else if n < 224 -> 2 else if n < 240 -> 3 else -> 4
    if raw.len() != width || n == 34 || n == 13 || n == 10 {
        return Err(unsupported_error(EncodingFormat.CSV, 0, reason))
    }
    code := n & (if width == 1 -> 127 else if width == 2 -> 31 else if width == 3 -> 15 else -> 7)
    loop i in 1..<width -> code = (code << 6) | (Int{raw[i]} & 63)
    stops := [U8]{}
    loop b in 0..<256 {
        stops.push(if b >= 128 || b == 34 || b == 13 || b == 10 || b == code -> U8{1} else -> U8{0})
    }
    Ok(CSVReader<R>{input: source.move(), limits: limits, delimiter: code, stops: stops, header: header, skip_blank: skip_blank, field: [U8]{}, fields: [String]{}, fields_heap: 0, record_width: 0, allocation: stream.budget(limits), quoted: false, after_quote: false, pending_cr: false, pending_cr_line: 1, pending_cr_column: 1, record: 1, parser_line: 1, parser_column: 0, record_line: 1, record_has_content: false, ended_record: false, saw_input: false, total: 0, offset: 0, line: 1, column: 1, eof: false, terminal: None, char0: U8{0}, char1: U8{0}, char2: U8{0}, char3: U8{0}, char_width: 0, buffer: [U8]{}, buffered: 0, plain_chunk: "", plain_start: 0, plain_end: 0, plain_checked: false})
}

#Test("typed CSV whole records preserve blank rows, doubled quotes and Unicode columns") {
    input: stream.text_from_bytes([U8]{97, 44, 98, 13, 10, 34, 120, 34, 34, 121, 34, 44, 122, 13, 10, 10}) ?? panic("UTF-8")
    records: typed_records(input) ?? panic("CSV")
    assert_eq(records.len(), 3)
    assert_eq(records[1][0], "x\"y")
    assert_eq(records[2], [String]{""})
    if typed_records("é\"") == {
        .Err(error) -> {
            assert_eq(error.reason, "Jet.MalformedRingInput: CSV row 1, line 1, column 2 — quote inside an unquoted field")
        }
        .Ok(_) -> panic("unquoted quote must fail")
    }
    if typed_records("\"x") == {
        .Err(error) -> {
            assert_eq(error.reason, "Jet.MalformedRingInput: CSV row 1, line 1, column 3 — quoted field ended before its closing quote")
        }
        .Ok(_) -> panic("unfinished quoted field must fail")
    }
}

// The eager rows engine keeps the streaming reader's (and typed decode's)
// record and error contract.
rows_error: fn(text: String) -> EncodingError Never! {
    if rows(text) == {
        .Err(error) -> error
        .Ok(_) -> panic("malformed CSV was accepted: {text}")
    }
}

#Test("eager CSV rows share the reader's errors, blank records and header") {
    bare: rows_error("a\rb")
    assert_eq("{bare.reason} {bare.line ?? 0}:{bare.column ?? 0} {bare.path}", "bare CR is not a record ending 1:2 $[0][0]")
    quote: rows_error("x\né\"")
    assert_eq("{quote.reason} {quote.line ?? 0}:{quote.column ?? 0} {quote.path}", "quote inside an unquoted field 2:2 $[1][0]")
    open: rows_error("a,\"x")
    assert(open.kind == .Truncated)
    assert_eq("{open.reason} {open.line ?? 0}:{open.column ?? 0} {open.path}", "quoted field ended before its closing quote 1:5 $[0][1]")
    kept: rows(",,\n\"\"\nx\n") ?? panic("blank records")
    assert_eq(kept.len(), 1)
    assert_eq(kept[0].line, 3)
    headed: rows("\nh\nv", header: true) ?? panic("header")
    assert_eq(headed.len(), 2)
    assert_eq(headed[0].fields, [String]{"h"})
    if dict_rows("a,b\n1\n") == {
        .Err(error) -> { assert_eq(error.reason, "CSV row 1 has 1 fields; the header has 2") }
        .Ok(_) -> panic("a short dict row must fail")
    }
}

#Test("CSV structured cells retain compact JSON text") {
    assert_eq(csv_cell(Dyn.Array([Dyn]{Dyn.Int(1), Dyn.Bool(true)})), "[1,true]")
}

#Test("CSV Bytes cells are base64 text") {
    assert_eq(csv_cell(Dyn.Bytes([U8]{104, 105})), "aGk=")
}
