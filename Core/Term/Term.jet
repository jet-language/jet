package: {
    name: "core.term"
    version: "0.0.1"
    edition: "2026"
    description: "Stdio, prompts, and terminal style."
    license: "MIT"
    outputs: {
        term: .Library{ entry: term }
    }
}
use {
    core: core
    rt: jet.runtime.term
    fmt: core.text.fmt
    core.files.[FileReader]
}
// core.term — the connected terminal.
//
// `print` / `eprint` write UTF-8. `readline` / `read_until` read lines, and
// the ambient `input` is every line of the program's input (__InputLines).
// `input_secret` disables echo. `style` is a no-op when stdout is not a TTY
// unless `style_force` is used. Width and height fall back to 80x24.
//
// ANSI SGR parsing is Jet. Byte IO is host (fd 0/1/2).
// The binary cursor `Reader.over(bytes)`. As the Prelude `Reader` it hands
// out the bytes not yet read, the same ones `take` would: an empty list once
// it is at its end. It is the runtime's cursor handle, which has no equality
// or order, so it refuses the Equatable and Comparable derives.
#[!Equatable, !Comparable]
Reader: struct {
    fd: Int

    impl Reader {
        read: fn(&self, limit: Int) -> [U8] IOError! { cursor_read(self, limit) }

        read_into: fn(&self, buffer: &[U8], limit: Int) -> Int IOError! {
            bytes: cursor_read(self, limit) ?? return Err(err)
            count: bytes.len()
            buffer.extend(bytes)
            Ok(count)
        }
    }
}

Writer: struct {
    fd: Int
}

StdinHandle: struct {
    fd: Int

    // The declaration's fd is informational; every token reads shared stdin.
    // The Rust original owns no independent unread buffer or close operation.
    // The raw leaf already drops the line's trailing LF and CR bytes.
    read_line: fn(&self) -[IO, Time.Wait]> String? IOError! {
        stdio_checkpoint(.Read, "stdin", "IO.Read")
        rt.stdin_line()
    }
    // Whether standard input is a terminal, mirroring
    // Stdout.is_tty and Stderr.is_tty. It reads no input and never fails; the read
    // receiver lets a temporary ask (`stdin().is_tty()`).
    is_tty: fn(self) -[IO]> Bool Never! {
        rt.terminal8_stdin_tty()
    }

    // As the Prelude `Reader`, standard input hands out up to `limit` bytes,
    // waiting until it has them or the input ends; an empty list is the end.
    impl Reader {
        read: fn(&self, limit: Int) -[IO, Time.Wait]> [U8] IOError! {
            if limit <= 0 -> return Err(terminal_invalid("the read limit must be positive"))
            __take_bytes(limit)
        }

        read_into: fn(&self, buffer: &[U8], limit: Int) -[IO, Time.Wait]> Int IOError! {
            bytes: self.read(limit) ?? return Err(err)
            count: bytes.len()
            buffer.extend(bytes)
            Ok(count)
        }
    }
}

// The ambient `input`: the lines of the files the program was given, in
// order, else of standard input (awk's file operands, perl's `<>`). Lowering
// walks `read_line` as a lazy `Iter<String>` (THandleOp.LinesIter). A file
// that does not open ends the walk with its IOError, as any line source's
// read error does; one file is open at a time.
__InputLines: struct {
    priv paths: [String]
    priv at: Int
    priv open: [FileReader]

    read_line: fn(&self) -[IO, FS.Read, Time.Wait]> String? IOError! {
        if self.paths.is_empty() {
            handle := stdin()
            return handle.read_line()
        }
        loop true {
            if self.open.is_empty() {
                if self.at == self.paths.len() -> return Ok(None)
                reader: core.files.open(self.paths[self.at])
                self.open = [FileReader]{reader}
                self.at += 1
            }
            line: self.open[0].read_line()
            if line != None -> return Ok(line)
            self.open = [FileReader]{}
        }
        Ok(None)
    }
}

Stdout: struct {
    fd: Int

    write: fn(&self, text: String) IOError! -[IO]> {
        stdio_write(text, false, false)
    }
    write_line: fn(&self, text: String) IOError! -[IO]> {
        stdio_write(text, true, false)
    }
    write_bytes: fn(&self, bytes: [U8]) IOError! -[IO]> {
        stdio_bytes(bytes, false)
    }
    flush: fn(&self) IOError! -[IO]> {
        stdio_flush(false)
    }
    // A pure query: the read receiver lets a temporary ask (`stdout().is_tty()`).
    is_tty: fn(self) -[IO]> Bool Never! {
        rt.stdout_terminal()
    }
}

Stderr: struct {
    fd: Int

    write: fn(&self, text: String) IOError! -[IO]> {
        stdio_write(text, false, true)
    }
    write_line: fn(&self, text: String) IOError! -[IO]> {
        stdio_write(text, true, true)
    }
    write_bytes: fn(&self, bytes: [U8]) IOError! -[IO]> {
        stdio_bytes(bytes, true)
    }
    flush: fn(&self) IOError! -[IO]> {
        stdio_flush(true)
    }
    is_tty: fn(self) -[IO]> Bool Never! {
        rt.stderr_terminal()
    }
}

// The one `Key` value, for `read_key()` and for native windows' key events
// (core.ui): `Char` holds the key's character, `F(n)` the function key n.
// A terminal reports `Ctrl(c)` for a control chord; a window reports the
// Control key itself and its modifier state instead. `Insert`, the
// navigation keys and the modifier keys come from windows only.
Key: enum {
    Char(Char)
    Enter
    Escape
    Backspace
    Tab
    Delete
    Insert
    Up
    Down
    Left
    Right
    Home
    End
    PageUp
    PageDown
    Shift
    Control
    Alt
    Super
    CapsLock
    F(Int)
    Ctrl(Char)
    Unknown
}

// How `print` shows the values it formats, set for a block by
// `#Context(print: term.PrintStyle{…})` and read as `context.print`: an
// Int in `int_base`, zero-padded to `int_min_digits` digits after its
// sign; a Float with `float_digits` decimals rounded half away from zero,
// or in its ordinary form when None; list and tuple elements joined by
// `list_separator`; and the labels of a generated struct or variant
// rendering shown when `field_names`. Core/Text/Fmt.jet's radix and decimal
// formatting makes the text. A prepared String, interpolation, Debug,
// `to_string` and `eprint` are unchanged, and the text of a Display or
// Printable implementation is its own.
PrintBase: enum {
    Binary
    Octal
    Decimal
    Hex
}

PrintStyle: struct {
    int_base: PrintBase = .Decimal
    int_min_digits: Int = 0
    float_digits: Int? = None
    list_separator: String = ", "
    field_names: Bool = true
}

// The style `context.print` reads where no `#Context(print: …)` block set
// one, and the key such a block sets (sema ContextKeys.jet
// sema_context_field_key).
__print_style: PrintStyle{}

// The text `print` shows for an Int under the task's print style (JetIR
// BuildTypes.jet ir_print_style_scalar calls it by name).
__print_int: fn(n: Int) -> String Never! {
    style: context.print
    base: if style.int_base == {
        .Binary -> 2
        .Octal -> 8
        .Decimal -> 10
        .Hex -> 16
    }
    if base == 10 && style.int_min_digits <= 0 -> return "{n}"
    fmt.__radix_signed_width(n, base, style.int_min_digits)
}

// The text `print` shows for a Float under the task's print style.
__print_float: fn(n: Float) -> String Never! {
    digits: context.print.float_digits ?? return "{n}"
    fmt.decimal(n, digits)
}

// The text between the elements of a list or tuple `print` shows.
__print_separator: fn() -> String Never! { context.print.list_separator }

// Whether `print` shows the labels of a struct or variant it renders.
__print_field_names: fn() -> Bool Never! { context.print.field_names }

print: fn(text: String) Never! -[IO, Time.Wait]> {
    out := stdout()
    out.write_line(text).drop("stdout write")
}

// The write's failure is discarded, so eprint skips stdio_write's IOError:
// the same IO.Write checkpoint, then the same raw write (stderr ignores
// `flush`; stdio_write passes true for any nonempty text), whose cause text
// is dropped unread.
eprint: fn(text: String) Never! -[IO, Time.Wait]> {
    if rt.stdio_fault("IO.Write") -> return
    _: rt.stdio_write("{text}\n", false, true, true)
}

// jet_std_io_input: the prompt is written and stdout flushed, then one line
// is read without its line ending; a closed stream reads as "".
readline: fn(prompt: String{""}) -[IO, Time.Wait]> String IOError! {
    terminal_prompt(prompt, false)
    line: terminal_line()
    Ok(line ?? "")
}

input_secret: fn(prompt: String) -[IO, Time.Wait]> String IOError! {
    if !rt.terminal8_stdin_tty() || !rt.terminal8_stdout_tty() -> return Err(terminal_invalid("secret input needs a terminal"))
    cause: terminal_secret_write(prompt)
    if cause != None -> return Err(terminal_other(.Flush, Val("stdout"), cause))
    if !rt.terminal8_mode_enter(false) {
        _: terminal_secret_write("\n")
        return Err(terminal_other(.Read, Val("stdin"), "could not disable terminal echo"))
    }
    result: terminal_secret_read()
    _: terminal_secret_write("\n")
    if result.cause != None -> return Err(terminal_other(.Read, Val("stdin"), result.cause ?? ""))
    if result.eof -> return Err(terminal_other(.Read, Val("stdin"), "the input stream closed before the secret arrived"))
    Ok(chomp(result.line))
}

read_all_input: fn() -[IO, Time.Wait]> String IOError! {
    terminal_read_preflight()
    result: rt.terminal8_read_all()
    if result.read_error != None -> return Err(terminal_other(.Read, Val("stdin"), result.read_error ?? ""))
    Ok(result.input)
}

read_until: fn(delimiter: String) -[IO, Time.Wait]> String IOError! {
    if delimiter.is_empty() -> return Err(terminal_other(.Read, Val("stdin"), "empty delimiter"))
    terminal_read_preflight()
    result: rt.terminal8_read_until(delimiter)
    if result.read_error != None -> return Err(terminal_other(.Read, Val("stdin"), result.read_error ?? ""))
    Ok(result.input)
}

__take_bytes: fn(n: Int) -[IO, Time.Wait]> [U8] IOError! {
    if n < 0 -> return Err(terminal_other(.Read, Val("stdin"), "negative take"))
    terminal_read_preflight()
    result: rt.terminal8_take(n)
    if result.read_error != None -> return Err(terminal_other(.Read, Val("stdin"), result.read_error ?? ""))
    Ok(result.bytes)
}

// Up to `limit` of the bytes the cursor has not read; a cursor at its end
// gives none.
cursor_read: fn(cursor: &Reader, limit: Int) -> [U8] IOError! {
    if limit <= 0 -> return Err(IOError.InvalidInput(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("the read limit must be positive")}))
    left: cursor.remaining()
    bytes: cursor.take(if limit < left -> limit else -> left) ?? return Err(terminal_other(.Read, None, err))
    Ok(bytes)
}


binread: fn(path: String) -[FS, IO, Time.Wait]> [U8] IOError! {
    core.files.read_bytes(path)
}

binwrite: fn(path: String, bytes: [U8]) IOError! -[FS, IO, Time.Wait]> {
    core.files.write_bytes(path, bytes)
}

confirm: fn(prompt: String) -[IO, Time.Wait]> Bool Never! {
    terminal_prompt("{prompt} [y/N] ", false) ?? return false
    answer: terminal_line() ?? ""
    confirm_answer(answer)
}

choose: fn(prompt: String, options: [String]) -[IO, Time.Wait]> String IOError! {
    if options.len() == 0 -> return Err(terminal_invalid("choose needs at least one item"))
    terminal_prompt(choose_menu(prompt, options), true)
    loop attempt in 0..<11 {
        terminal_prompt("> ", true)
        read: terminal_line()
        answer: read ?? return Err(terminal_invalid("the input stream closed before a choice arrived"))
        index: choose_index(answer)
        if index != None {
            n: index
            if n > 0 && n <= options.len() -> return Ok(options[n - 1])
        }
        terminal_prompt("Enter a number from 1 to {options.len()}.\n", true)
    }
    Err(terminal_invalid("no valid choice after 10 retries"))
}

stdin: fn() -> StdinHandle Never! { StdinHandle{fd: 0} }

// What the ambient `input` reads (__InputLines): the program's arguments name
// its files; none means standard input.
__input_lines: fn() -[Exec.Args]> __InputLines Never! {
    __InputLines{paths: core.process.args(), at: 0, open: [FileReader]{}}
}

// `input.edit(change)` (JetSema sema_call_try_ambient_input_method): each
// file the program's arguments name has every line replaced by `change(line)`
// and is rewritten at once (files.write_atomic), as `perl -i -pe` edits
// in place. Each line ending, CRLF or LF, and a missing final one stay as
// they were; a file no line of which changes is not rewritten. With no file
// named, the lines of `lines` (standard input) are printed changed. A file
// that cannot be read or replaced stops the edit with its IOError; the files
// before it stay edited.
__input_edit: fn(&&lines: Iter<String>, change: fn(String) -> String Never!) IOError! -[IO, FS.Read, FS.Write, Exec.Args, Time.Wait]> {
    paths: core.process.args()
    if paths.len() == 0 {
        loop line in lines -> print(change(line))
        return Ok()
    }
    loop path in paths {
        text: core.files.read(path) ?? return Err(err)
        edited: __input_edit_text(text, change)
        if edited != text -> core.files.write_atomic(path, edited.bytes()) ?? return Err(err)
    }
    Ok()
}

// `text` with each line replaced by `change(line)`; the line endings stay.
__input_edit_text: fn(text: String, change: fn(String) -> String Never!) -> String Never! {
    edited := ""
    pieces: text.split("\n").to_list()
    loop at in 0..<pieces.len() {
        piece: pieces[at]
        last: at + 1 == pieces.len()
        // The text after the final LF is no line when it is empty.
        if last && piece.is_empty() -> next
        crlf: piece.ends_with("\r")
        content: if crlf -> piece.slice(0..<piece.len() - 1) else -> piece.copy()
        edited += change(content)
        if crlf -> edited += "\r"
        if !last -> edited += "\n"
    }
    edited
}

stdout: fn() -> Stdout Never! { Stdout{fd: 1} }

stderr: fn() -> Stderr Never! { Stderr{fd: 2} }

buffered: fn() -> StdinHandle Never! { stdin() }

terminal_width: fn() -[IO]> Int Never! {
    from_env: positive_dimension(rt.terminal8_env("COLUMNS"))
    if from_env != None -> return from_env
    size: rt.terminal8_stty()
    if size != None -> return size.w
    80
}

terminal_height: fn() -[IO]> Int Never! {
    from_env: positive_dimension(rt.terminal8_env("LINES"))
    if from_env != None -> return from_env
    size: rt.terminal8_stty()
    if size != None -> return size.h
    24
}

style: fn(style: String, text: String) -[IO]> String Never! {
    if !terminal_style_enabled() -> return text.copy()
    code: legacy_style_code(style)
    if code.is_empty() -> return text.copy()
    esc: String.from_bytes([U8]{27}) ?? ""
    "{esc}[{code}m{text}{esc}[0m"
}

style_force: fn(style: String, text: String) -> String Never! {
    codes: sgr(style)
    if codes.len() == 0 -> return text.copy()
    esc: String.from_bytes([U8]{27}) ?? ""
    return "{esc}[{codes}m{text}{esc}[0m"
}


read_key: fn() -[IO, Time.Wait]> Key Never! {
    raw: rt.terminal8_key_bytes()
    decode_key(raw.bytes, raw.platform)
}

WinSize: struct {
    w: Int
    h: Int
}
progress: fn(label: String) IOError! -[IO, Time.Wait]> {
    if rt.terminal8_machine_output() -> return Ok()
    // Without a terminal on stderr the label is a plain stdout line, so a
    // piped run still records its progress.
    if !rt.terminal8_stderr_tty() {
        terminal_write_preflight("stdout")
        line_cause: rt.terminal8_write_stdout("{label}\n", true)
        if line_cause != None -> return Err(terminal_other(.Flush, Val("stdout"), line_cause))
        return Ok()
    }
    terminal_write_preflight("stderr")
    carriage_return: "\r"
    cause: rt.terminal8_write_stderr("{carriage_return}{label}", true)
    if cause != None -> return Err(terminal_other(.Flush, Val("stderr"), cause))
    Ok()
}

decode_key: fn(raw: [U8], platform: Int) -> Key Never! {
    if platform == 0 || raw.len() == 0 -> return .Unknown
    if raw.len() == 1 {
        b: Int{raw[0]}
        if b == 13 || b == 10 -> return .Enter
        if b == 27 -> return .Escape
        if b == 127 || b == 8 -> return .Backspace
        if b == 9 -> return .Tab
        if platform == 1 && b >= 1 && b <= 26 {
            text: String.from_bytes([U8]{U8{b + 96}}) ?? ""
            return .Ctrl(text.chars()[0])
        }
        if b < 128 {
            text: String.from_bytes(raw) ?? ""
            return .Char(text.chars()[0])
        }
    }
    if raw.len() >= 3 && raw[0] == (U8{27}) && raw[1] == (U8{91}) {
        if raw.len() == 3 {
            if raw[2] == {
                65 -> return .Up
                66 -> return .Down
                67 -> return .Right
                68 -> return .Left
                else -> {}
            }
        }
        if raw.len() == 4 && raw[2] == (U8{51}) && raw[3] == (U8{126}) -> return .Delete
        if platform == 1 && raw[raw.len() - 1] == (U8{126}) {
            n: positive_dimension(Val(slice_bytes(raw, 2, raw.len() - 1))) ?? -1
            key: if n == {
                11 -> 1
                12 -> 2
                13 -> 3
                14 -> 4
                15 -> 5
                17 -> 6
                18 -> 7
                19 -> 8
                20 -> 9
                21 -> 10
                23 -> 11
                24 -> 12
                else -> 0
            }
            if key > 0 -> return .F(key)
        }
        return .Unknown
    }
    if platform == 2 -> return .Unknown
    text: String.from_bytes(raw) ?? return .Unknown
    chars: text.chars()
    if chars.len() == 0 {
        return .Unknown
    }
    Key.Char(chars[0])
}

#Test("terminal keys retain platform-specific CSI and UTF-8 behavior") {
    assert_eq(decode_key([U8]{27, 91, 65}, 1), Key.Up)
    assert_eq(decode_key([U8]{27, 91, 49, 49, 126}, 1), Key.F(1))
    assert_eq(decode_key([U8]{27, 91, 49, 49, 126}, 2), Key.Unknown)
    assert_eq(decode_key([U8]{3}, 1), Key.Ctrl('c'))
    assert_eq(decode_key([U8]{195, 169}, 1), Key.Char('é'))
    assert_eq(decode_key([U8]{195}, 1), Key.Unknown)
    carriage_return: "\r"
    assert_eq(chomp("a{carriage_return}{carriage_return}\n"), "a")
}

#Test("input edit keeps each line ending and a missing final line break") {
    cr: "\r"
    assert_eq(__input_edit_text("a cat{cr}\nno\nlast cat", fn(line) { line.replace("cat", "dog") }), "a dog{cr}\nno\nlast dog")
    assert_eq(__input_edit_text("cat\n", fn(line) { line.upper() }), "CAT\n")
    assert_eq(__input_edit_text("", fn(line) { line.upper() }), "")
}


// Raw leaves expose host operations only. Prompt fault probes must both run
// before the first byte is written, and each caller owns its error projection.
terminal_other: fn(operation: IOOperation, resource: String?, cause: String) -> IOError Never! {
    IOError.Other(IOContext{operation: operation, resource: resource, os_code: None, cause: Val(cause)})
}

terminal_invalid: fn(cause: String) -> IOError Never! {
    IOError.InvalidInput(IOContext{operation: .Read, resource: Val("stdin"), os_code: None, cause: Val(cause)})
}

terminal_write_preflight: fn(resource: String) IOError! -[IO, Time.Wait]> {
    if rt.terminal8_fault("IO.Write") -> return Err(terminal_other(.Write, Val(resource), "fault injected: IO.Write"))
    if rt.terminal8_fault("IO.Flush") -> return Err(terminal_other(.Flush, Val(resource), "fault injected: IO.Flush"))
    Ok()
}

terminal_prompt: fn(text: String, choose: Bool) IOError! -[IO, Time.Wait]> {
    terminal_write_preflight("stdout")
    cause: rt.terminal8_write_stdout(text, true)
    if cause != None {
        if choose -> return Err(terminal_other(.Write, Val("stdout"), cause))
        return Err(terminal_other(.Flush, None, cause))
    }
    Ok()
}

terminal_read_preflight: fn() IOError! -[IO, Time.Wait]> {
    if rt.terminal8_fault("IO.Read") -> return Err(terminal_other(.Read, Val("stdin"), "fault injected: IO.Read"))
    Ok()
}
terminal_line: fn() -[IO, Time.Wait]> String? IOError! {
    if rt.terminal8_fault("IO.Read") -> return Err(terminal_other(.Read, Val("stdin"), "fault injected: IO.Read"))
    result: rt.terminal8_line()
    if result.read_error != None -> return Err(terminal_other(.Read, Val("stdin"), result.read_error ?? ""))
    if result.eof -> return Ok(None)
    Ok(Val(chomp(result.line)))
}

terminal_secret_write: fn(text: String) -[IO, Time.Wait]> String? Never! {
    if rt.terminal8_fault("IO.Write") -> return Val("fault injected: IO.Write")
    if rt.terminal8_fault("IO.Flush") -> return Val("fault injected: IO.Flush")
    rt.terminal8_write_stdout(text, true)
}

terminal_secret_read: fn() -[IO, Time.Wait]> (eof: Bool, line: String, cause: String?) Never! {
    _guard: core.mem.scope.guard(fn() { rt.terminal8_mode_leave() })
    if rt.terminal8_fault("IO.Read") -> return (eof: false, line: "", cause: Val("fault injected: IO.Read"))
    read: rt.terminal8_line()
    (eof: read.eof, line: read.line, cause: read.read_error)
}

choose_menu: fn(prompt: String, options: [String]) -> String Never! {
    menu := "{prompt}\n"
    loop i in 0..<options.len() -> menu = "{menu}  {i + 1}) {options[i]}\n"
    menu
}

choose_index: fn(answer: String) -> Int? Never! {
    raw: answer.trim().bytes()
    start := 0
    if raw.len() > 0 && raw[0] == (U8{43}) -> start = 1
    if start >= raw.len() -> return None
    n := 0
    loop i in start..<raw.len() {
        d: Int{raw[i]} - 48
        if d < 0 || d > 9 -> return None
        // Values above Int::MAX cannot select any source array entry.
        if n > 922337203685477580 || (n == 922337203685477580 && d > 7) -> return None
        n = n * 10 + d
    }
    Val(n)
}

positive_dimension: fn(value: String?) -> Int? Never! {
    text: value ?? return None
    n: choose_index(text) ?? return None
    // Rust parse::<i64> allows a leading +, but not surrounding whitespace.
    if text != text.trim() || n <= 0 -> return None
    Val(n)
}

terminal_style_enabled: fn() -[IO]> Bool Never! {
    mode: rt.terminal8_color_mode()
    if mode == 1 -> return true
    if mode == 2 -> return false
    if rt.terminal8_env_has("NO_COLOR") -> return false
    if rt.terminal8_env_has("FORCE_COLOR") -> return true
    rt.terminal8_stdout_tty()
}

legacy_style_code: fn(style: String) -> String Never! {
    if style == {
        "black" -> "30"
        "red" -> "31"
        "green" -> "32"
        "yellow" -> "33"
        "blue" -> "34"
        "magenta" -> "35"
        "cyan" -> "36"
        "white" -> "37"
        "bold" -> "1"
        "dim" -> "2"
        else -> ""
    }
}

#Test("choose menu and numeric answers preserve the terminal contract") {
    assert_eq(choose_menu("Pick", ["a", "b"]), "Pick\n  1) a\n  2) b\n")
    assert_eq(choose_index(" +02\t"), Val(2))
    assert_eq(choose_index("-1"), None)
    assert_eq(choose_index("１２"), None)
    assert_eq(choose_index("+"), None)
    assert_eq(choose_index("9223372036854775808"), None)
    assert_eq(positive_dimension(Val(" +80")), None)
    assert_eq(positive_dimension(Val("+80")), Val(80))
    assert_eq(positive_dimension(Val("0")), None)
}

#Test("legacy style accepts only the canonical ten exact names") {
    assert_eq(legacy_style_code("red"), "31")
    assert_eq(legacy_style_code("bold"), "1")
    assert_eq(legacy_style_code("RED"), "")
    assert_eq(legacy_style_code("underline"), "")
    assert_eq(legacy_style_code("31"), "")
}

confirm_answer: fn(answer: String) -> Bool Never! {
    normalized: ascii_lower(answer.trim())
    normalized == "y" || normalized == "yes"
}
sgr: fn(spec: String) -> String {
    parts := [String]{}
    cur := [U8]{}
    loop b in spec.bytes() {
        if b == (U8{32}) || b == (U8{44}) || b == (U8{59}) {
            token: ascii_lower(String.from_bytes(cur) ?? "")
            cur = [U8]{}
            code: token_code(token)
            if code.len() > 0 -> parts.push(code)
        } else { cur.push(b) }
    }
    token: ascii_lower(String.from_bytes(cur) ?? "")
    code: token_code(token)
    if code.len() > 0 -> parts.push(code)
    out := ""
    loop i in 0..<parts.len() {
        if i > 0 -> out = "{out};"
        out = "{out}{parts[i]}"
    }
    out
}

token_code: fn(token: String) -> String {
    numeric: parse_int(token) ?? -1
    if numeric >= 0 && numeric <= 109 -> return "{numeric}"
    if token == {
        "bold" -> "1"
        "dim" -> "2"
        "italic" -> "3"
        "underline" -> "4"
        "inverse" | "reverse" -> "7"
        "strike" | "strikethrough" -> "9"
        "black" -> "30"
        "red" -> "31"
        "green" -> "32"
        "yellow" -> "33"
        "blue" -> "34"
        "magenta" -> "35"
        "cyan" -> "36"
        "white" -> "37"
        "bg-black" -> "40"
        "bg-red" -> "41"
        "bg-green" -> "42"
        "bg-yellow" -> "43"
        "bg-blue" -> "44"
        "bg-magenta" -> "45"
        "bg-cyan" -> "46"
        "bg-white" -> "47"
        "reset" -> "0"
        else -> ""
    }
}

chomp: fn(text: String) -> String {
    raw: text.bytes()
    n := raw.len()
    loop n > 0 && (raw[n - 1] == (U8{10}) || raw[n - 1] == (U8{13})) -> n = n - 1
    slice_bytes(raw, 0, n)
}

slice_bytes: fn(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    i := start
    loop {
        if i >= end -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i = i + 1
    }
}

ends_with_bytes: fn(hay: [U8], needle: [U8]) -> Bool {
    if needle.len() > hay.len() -> return false
    off: hay.len() - needle.len()
    loop i in 0..<needle.len() {
        if hay[off + i] != needle[i] -> return false
    }
    true
}

ascii_lower: fn(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n: b
        if n >= 65 && n <= 90 -> out.push(U8{n + 32}) else -> out.push(b)
    }
    String.from_bytes(out) ?? text
}

parse_int: fn(text: String) -> Int? {
    n := 0
    any := false
    loop b in text.bytes() {
        d: b
        if d < 48 || d > 57 -> return None
        if n > 922337203685477580 || (n == 922337203685477580 && d > 7) -> return None
        n = n * 10 + (d - 48)
        any = true
    }
    if !any -> return None
    Val(n)
}

#Test("stdin source token preserves its declaration") {
    assert(stdin().fd == 0 && buffered().fd == 0)
    assert(stdin() == StdinHandle{fd: 0})
    assert(stdin() != StdinHandle{fd: 9})
}

stdio_error: fn(operation: IOOperation, resource: String, cause: String) -> IOError Never! {
    IOError.Other(IOContext{
        operation: operation.copy(),
        resource: Val(resource),
        os_code: None,
        cause: Val(cause),
    })
}

stdio_checkpoint: fn(operation: IOOperation, resource: String, selector: String) IOError! {
    if rt.stdio_fault(selector) {
        return Err(stdio_error(operation, resource, "fault injected: {selector}"))
    }
    Ok()
}

stdio_result: fn(cause: String?, operation: IOOperation, resource: String) IOError! {
    if cause == {
        .Val(text) -> Err(stdio_error(operation, resource, text))
        .None -> Ok()
    }
}

// The runtime's one stdout policy, chosen from the TTY fact, decides when
// buffered bytes are written: at each LF on a terminal, else when the buffer
// fills, at an explicit flush or at a named boundary. stderr is never held.
// So a write never asks for a flush of its own.
stdio_write: fn(text: String, newline: Bool, stderr: Bool) IOError! -[IO]> {
    resource: if stderr -> "stderr" else -> "stdout"
    stdio_checkpoint(.Write, resource, "IO.Write")
    stdio_result(rt.stdio_write(text, newline, stderr, false), .Write, resource)
}

stdio_bytes: fn(bytes: [U8], stderr: Bool) IOError! -[IO]> {
    resource: if stderr -> "stderr" else -> "stdout"
    stdio_checkpoint(.Write, resource, "IO.Write")
    stdio_result(rt.stdio_bytes(bytes, stderr, false), .Write, resource)
}

stdio_flush: fn(stderr: Bool) IOError! -[IO]> {
    resource: if stderr -> "stderr" else -> "stdout"
    stdio_checkpoint(.Flush, resource, "IO.Flush")
    stdio_result(rt.stdio_flush(stderr), .Flush, resource)
}

#Test("stdio source tokens retain declared fields and record equality") {
    assert(stdout().fd == 1 && stderr().fd == 2)
    assert(stdout() == Stdout{fd: 1})
    assert(stderr() == Stderr{fd: 2})
    assert(stdout() != Stdout{fd: 9})
    assert(stderr() != Stderr{fd: 9})
}

#Test("stdio source errors preserve Other, resource, and verbatim cause") {
    if stdio_result(Val("custom Windows console error"), .Write, "stdout") == {
        .Err(error) -> if error == {
            .Other(context) -> {
                assert(context.operation == .Write && context.resource == (Val("stdout")))
                assert(context.os_code == None && context.cause == (Val("custom Windows console error")))
            }
            .InvalidInput(_) | .NotFound(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> panic("stdio error kind")
        }
        .Ok(_) -> panic("stdio failure must be reported")
    }
    stdio_result(None, .Flush, "stderr").drop("successful raw flush")
}

#Test("confirmation accepts only an ASCII case-insensitive yes") {
    assert(confirm_answer(" y "))
    assert(confirm_answer(" YeS\t"))
    assert(!confirm_answer(""))
    assert(!confirm_answer("no"))
    assert(!confirm_answer("yés"))
}

#Test("negative byte take fails before reading stdin") {
    if __take_bytes(-1) == {
        .Err(_) -> {}
        .Ok(_) -> panic("a negative take must fail")
    }
}
