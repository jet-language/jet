// core.compiler.lang — closed menus the compiler itself consults.
//
// These enums are the public names of marker arguments (`#Inline`, `#Layout`
// `#FX`, `#Meta`, `#Job`, `#Off`, `#Rename`, …). Variant spellings match
// `Policy::canonical_rule_arg_variants`. They are values, not a second
// type system: a Jet program names a variant; the compiler records the fact.
/// Calling convention for `#Import` / `#Export`.
ABI: enum {
    System
    Cdecl
    Stdcall
    Fastcall
    Win64
    Sysv64
}

/// Overflow behaviour for integer arithmetic markers.
ArithmeticMode: enum {
    Checked
    Wrapping
    Saturating
}

/// Build condition of `#Off(.Release)`: the closed menu of builds that erase
/// the marked code. A bare `#Off` erases it from every build.
BuildCondition: enum {
    Release
}

/// Effect roots that may appear in an `effect_name` row. The cases are the
/// machine roots of Compiler/Prelude/Effects.jet, then Core's service effects
/// of Core/Effects/Effects.jet, then the metaprogramming effects of
/// Core/Compiler/Meta.jet, written by Tools/agent/CoreSourceRows.jet.
Effect: enum {
    Net
    FS
    IO
    Time
    Rand
    Env
    Exec
    GPU
    FFI
    Browser
    Panic
    Mem
    DB
    Log
    Secret
    Meta
}

/// Foreign language named by `#FFI(<lang>)`. The cases are the languages of
/// the `FFI` effect in Compiler/Prelude/Effects.jet, written by
/// Tools/agent/CoreSourceRows.jet; an inline body needs a language with an
/// inline binder.
FFILanguage: enum {
    Go
    Java
    DotNet
    Fortran
    Cobol
    Tcl
    Lua
    Ada
    Pascal
    Dart
    PowerShell
    Perl
    Ruby
    Php
    R
    Com
    C
    Cpp
    Asm
    Py
    Octave
    Rust
    JS
    Swift
}

/// Inlining hint for `#Inline`.
InlineMode: enum {
    Hint
    Always
    Never
}

/// `#Job` publication scope.
JobScope: enum {
    Dev
    Ship
    Internal
}

/// Parallel kernel marker.
KernelMode: enum {
    Parallel
}

/// Representation requested by `#Layout`.
Layout: enum {
    C
    Columnar
}

/// `#Meta(maturity: …)` closed set.
Maturity: enum {
    Experimental
    Tested
    Hardened
}

/// `#Memo` bound. `None` means "do not memoize".
MemoBound: enum {
    Default
    Unset
}

/// Wire casing for codecs (`#Rename(.Camel)` on a type).
NamingCase: enum {
    Camel
    Snake
    Pascal
    Kebab
    Screaming
}

/// Proof obligation intensity.
ObligationMode: enum {
    Unspecified
    GateOnly
    Obligations
    PerSite
    Track
    Skip
}

/// Source path named by a marker argument. Empty variant menu: the value is
/// the path text.
Path: struct {
    text: String
}

/// Build / capability policy knobs.
PolicySetting: enum {
    Allow
    Deny
    Unsafe
    GC
    ExplicitUnits
    Copies
    Sentries
    /// `arithmetic: .Wrapping`: the fixed-width arithmetic mode of one body.
    Arithmetic(mode: ArithmeticMode)
    Writes
    Explicit
    On
    Off
}

/// Placement site for a marker struct's `sites` setting in `impl Marker`.
Site: enum {
    Package
    File
    Module
    Function
    Method
    Block
    Statement
    Expression
    Type
    Impl
    Trait
    Declaration
    Constant
    Field
    Variant
    Parameter
    Test
    Operation
    Text
    /// A match arm, after its body (`1 -> { a() } #Through`).
    Arm
}

/// Typestate tag named by `#State`. The compiler threads the name; this
/// struct is the runtime projection.
State: struct {
    name: String
}

/// Built-in taint tags (`#Tag`).
TaintKind: enum {
    Input
    PII
    Secret
    Credential
}

/// A tag's timing (`timing:` in a `tag` body). A `.Fixed`
/// value's time and memory addresses must not depend on it: sema refuses a
/// branch, index, division, shift, allocation size or call target on it
/// (E0737), an `Int` or `Float` holding it (E0738), and arithmetic that
/// could stop on it (E0739). `Secret` is `.Fixed`; every other tag, and a
/// declared tag without `timing:`, is `.Free`.
TagTiming: enum {
    Free
    Fixed
}

/// What a tag protects (`protects:` in a `tag` body): `.Secrecy`, where its
/// value may flow, or `.Integrity`, what may flow into a place that needs a
/// trusted value. `Input` is `.Integrity`; every other tag, and a declared
/// tag without `protects:`, is `.Secrecy`.
TagProtects: enum {
    Secrecy
    Integrity
}

/// Codegen target family.
Target: enum {
    Native
    Web
    Wasm
    JS
    Freestanding
    OS
}

/// Rule-reflection track.
Track: enum {
    Frontend
    Backend
    Runtime
    Tooling
}
