// core.compiler.lang — closed menus the compiler itself consults.
//
// These enums are the public names of marker arguments (`#Inline`, `#Layout`
// `#FX`, `#Meta`, `#Job`, `#Off`, `#Rename`, …). Variant spellings match
// `Policy::canonical_rule_arg_variants`. They are values, not a second
// type system: a Jet program names a variant; the compiler records the fact.
/// Calling convention for `#Import` / `#Export`.
ABI: enum {
    System
    Cdecl
    Stdcall
    Fastcall
    Win64
    Sysv64
}

/// Build condition of `#Off(.Release)` and `#On(.Deep)`: the closed menu of
/// builds a switch attribute names. `#Off(.Release)` erases the marked code
/// from release builds, and a bare `#Off` from every build; `#On(.Deep)`
/// keeps it only where `--deep-checks` selects it.
BuildCondition: enum {
    Release
    Deep
}

/// `#Codable(only: …)`: the one codec direction a type derives.
CodableDirection: enum {
    Encode
    Decode
}

/// `#Codable(.Skip)` / `#Codable(.Flatten)`: a field's wire form.
CodableField: enum {
    Skip
    Flatten
}

/// `#Codable(tag: …)`: how an enum names its case on the wire. `External`
/// keys the payload by the case name, `Field("kind")` writes the name under
/// that key, and `Untagged` (written `.None`) writes no name.
CodableTag: enum {
    External
    Field
    Untagged
}

/// `#Codable(unknown: .Deny)`: a decoded key the struct doesn't declare fails.
CodableUnknown: enum {
    Deny
}

// BEGIN GENERATED by Tools/Agent/CoreSourceRows.jet from the effect sources; do not edit.
/// Effect roots that may appear in an `effect_name` row: the machine roots
/// of Compiler/Prelude/Effects.jet, then Core's service effects of
/// Core/Effects/Effects.jet, then the metaprogramming effects of
/// Core/Compiler/Meta.jet.
Effect: enum {
    Net
    FS
    IO
    Time
    Rand
    Env
    Exec
    GPU
    FFI
    Browser
    Panic
    Mem
    Unsafe
    DB
    Log
    Secret
    Meta
}

/// Foreign language named by `#FFI(<lang>)`: the languages of the `FFI`
/// effect in Compiler/Prelude/Effects.jet; an inline body needs a language with an
/// inline binder.
FFILanguage: enum {
    Go
    Java
    DotNet
    Fortran
    Cobol
    Tcl
    Lua
    Ada
    Pascal
    Dart
    PowerShell
    Perl
    Ruby
    Php
    R
    Com
    C
    Cpp
    Asm
    Py
    Octave
    Rust
    JS
    Swift
}

// END GENERATED

/// Inlining hint for `#Inline`.
InlineMode: enum {
    Hint
    Always
    Never
}

/// `#Job` publication scope.
JobScope: enum {
    Dev
    Ship
    Internal
}

/// Parallel kernel marker.
KernelMode: enum {
    Parallel
}

/// Representation requested by `#Layout`.
Layout: enum {
    C
    Columnar
}

/// `#Memo` bound. `None` means "do not memoize".
MemoBound: enum {
    Default
    Unset
}

/// Wire casing for codecs (`#Rename(.Camel)` on a type).
NamingCase: enum {
    Camel
    Snake
    Pascal
    Kebab
    Screaming
}

/// Proof obligation intensity.
ObligationMode: enum {
    Unspecified
    GateOnly
    Obligations
    PerSite
    Track
    Skip
}

/// The fixed-width overflow mode `#Overflow(.Stop)` opens over one function,
/// method or block body: an overflowing `+`, `-`, `*`, `**`, signed negation
/// or narrowing `T{x}` inside it stops, wraps or saturates.
OverflowMode: enum {
    Stop
    Wrapping
    Saturating
}

/// Source path named by a marker argument. Empty variant menu: the value is
/// the path text. Sema reads it at compile time; its bare name is the runtime
/// `Path` handle's, which has no `text` field, so it refuses the Equatable and
/// Comparable derives rather than build them over that handle.
#[!Equatable, !Comparable]
Path: struct {
    text: String
}

/// Build / capability policy knobs.
PolicySetting: enum {
    Allow
    Deny
    Unsafe
    GC
    ExplicitUnits
    Copies
    Sentries
    Writes
    Failures
    Explicit
    On
    Off
}

/// The run-time policy `#Runtime(.NoEager)` opens over one function, method
/// or block body: `NoEager` computes no local value of it while compiling and
/// still runs an explicit `#run`; `Only` also refuses every compile-time run
/// of it.
RuntimeMode: enum {
    NoEager
    Only
}

/// Typestate tag: a state named in a type's `state { … }` section. The
/// compiler threads the name; this struct is the runtime projection.
State: struct {
    name: String
}

/// A value tag's timing (`timing:` in its `impl Marker` block). A `.Fixed`
/// value's time and memory addresses must not depend on it: sema refuses a
/// branch, index, division, shift, allocation size or call target on it
/// (E0737), an `Int` or `Float` holding it (E0738), and arithmetic that
/// could stop on it (E0739). Prelude's `Secret` is `.Fixed`; every other
/// tag, and a declared tag without `timing:`, is `.Free`.
TagTiming: enum {
    Free
    Fixed
}

/// What a value tag protects (`protects:` in its `impl Marker` block):
/// `.Secrecy`, where its value may flow, or `.Integrity`, what may flow into
/// a place that needs a trusted value. Prelude's `Input` is `.Integrity`;
/// every other tag, and a declared tag without `protects:`, is `.Secrecy`.
TagProtects: enum {
    Secrecy
    Integrity
}

/// Codegen target family.
Target: enum {
    Native
    Web
    Wasm
    JS
    Freestanding
    OS
}

/// Rule-reflection track.
Track: enum {
    Frontend
    Backend
    Runtime
    Tooling
}
