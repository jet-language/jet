// core.compiler.lang — closed menus the compiler itself consults.
//
// These enums are the public names of marker arguments (`#Inline`, `#Layout`
// `#FX`, `#Meta`, `#Job`, `#RenameAll`, …). Variant spellings match
// `Policy::canonical_rule_arg_variants`. They are values, not a second
// type system: a Jet program names a variant; the compiler records the fact.
/// Calling convention for `#Import` / `#Export`.
ABI: enum {
    System
    Cdecl
    Stdcall
    Fastcall
    Win64
    Sysv64
}

/// Overflow behaviour for integer arithmetic markers.
ArithmeticMode: enum {
    Checked
    Wrapping
    Saturating
}

/// Effect roots that may appear in an `effect_name` row. The cases are the
/// machine roots of Compiler/Prelude/Effects.jet, then Core's service effects
/// of Core/Effects/Effects.jet, written by Tools/agent/CoreSourceRows.jet.
Effect: enum {
    Net
    FS
    IO
    Time
    Rand
    Env
    Exec
    GPU
    FFI
    Browser
    Panic
    Mem
    DB
    Log
    Secret
}

/// Guest language named by `#Import`.
FFILanguage: enum {
    C
    Cpp
    Asm
}

/// Inlining hint for `#Inline`.
InlineMode: enum {
    Hint
    Always
    Never
}

/// `#Job` publication scope.
JobScope: enum {
    Dev
    Ship
    Internal
}

/// Parallel kernel marker.
KernelMode: enum {
    Parallel
}

/// Representation requested by `#Layout`.
Layout: enum {
    C
    Columnar
}

/// `#Meta(maturity: …)` closed set.
Maturity: enum {
    Experimental
    Tested
    Hardened
}

/// `#Memo` bound. `None` means "do not memoize".
MemoBound: enum {
    Default
    Unset
}

/// Field-rename policy for codecs (`#RenameAll`).
NamingCase: enum {
    Camel
    Snake
    Pascal
    Kebab
    Screaming
}

/// Proof obligation intensity.
ObligationMode: enum {
    Unspecified
    GateOnly
    Obligations
    PerSite
    Track
    Skip
}

/// Source path named by a marker argument. Empty variant menu: the value is
/// the path text.
Path: struct {
    text: String
}

/// Build / capability policy knobs.
PolicySetting: enum {
    Allow
    Deny
    Unsafe
    GC
    ExplicitUnits
    Copies
    Sentries
    Explicit
    On
    Off
}

/// Placement site for a marker struct's `sites` setting in `impl Marker`.
Site: enum {
    Package
    File
    Module
    Function
    Method
    Block
    Statement
    Expression
    Type
    Impl
    Trait
    Declaration
    Constant
    Field
    Variant
    Parameter
    Test
    Operation
    Text
}

/// Typestate tag named by `#State`. The compiler threads the name; this
/// struct is the runtime projection.
State: struct {
    name: String
}

/// Built-in taint tags (`#Tag`).
TaintKind: enum {
    Input
    PII
    Secret
    Credential
}

/// Codegen target family.
Target: enum {
    Native
    Web
    Wasm
    JS
    Freestanding
    OS
}

/// Rule-reflection track.
Track: enum {
    Frontend
    Backend
    Runtime
    Tooling
}
