package: {
    name: "core.compiler"
    version: "0.0.1"
    edition: "2026"
    description: "Typed compile-time front-end and package views."
    license: "MIT"
    outputs: {
        compiler: .Library{ entry: compiler }
    }
}
use {
    query_rows.[program_fact]
}
lang: module

Token: struct {
    kind: String
    text: String
    line: Int
    column: Int
}

Pair: struct {
    left: String
    right: String
}

/// One place library code runs inside the compiler: the code its author
/// writes and the row it runs under. The Meta effects are declared beside
/// this file, in Meta.jet; reading the program needs none.
ExtensionPoint: struct {
    name: String
    entry: String
    row: [String]
}

/// Every extension point and its row. A marker whose `expand` writes its own
/// row may narrow it to `-[]>`, which makes it a lint: it reads the program and
/// may reject or warn, but writes no declarations.
EXTENSION_POINTS: [ExtensionPoint]{
    ExtensionPoint{name: "Compile-time value", entry: `#run { … }`, row: [String]{}},
    ExtensionPoint{name: "Marker expansion", entry: "Marker.expand(self, target: Target)", row: [String]{"Meta.Generate"}},
    ExtensionPoint{name: "Derive", entry: "Derive.expand(target: Target)", row: [String]{"Meta.Generate"}},
    ExtensionPoint{name: "Lint", entry: "Marker.expand(self, target: Target)", row: [String]{}},
}

/// The compiler stage that makes a checked fact available. This is not the
/// language phase `#phase` reads.
CompilerStage: enum { Parsed Resolved Typed Prepared Emitted }

/// A compiler-issued snapshot identity. Source names and casts can't make
/// one; only the compiler issues it, with the snapshot it names.
SnapshotID: struct {
    priv digest: String

    text: fn(self) -> String Never! { self.digest.copy() }
}

/// A compiler-issued authorization scope, named by a `Denied` failure.
ScopeID: struct {
    priv name: String

    text: fn(self) -> String Never! { self.name.copy() }
}

/// Why a metadata query has no complete answer. A missing fact is never an
/// empty success: an empty list means the checked answer is empty.
MetadataFailure: enum {
    Unavailable(required_stage: CompilerStage, reason: String)
    Unsupported(capability: String)
    Stale(requested: SnapshotID, current: SnapshotID)
    Invalid(diagnostics: [CompilerDiagnostic])
    Denied(scope: ScopeID, reason: String)
    Truncated(limit: Int, observed: Int)
}

/// A failed metadata query: the failure, the query's spelling and, when the
/// query names a place in source, that place.
#Error
MetadataError: struct {
    kind: MetadataFailure
    query: String
    source: SourceSpan?

    impl Display {
        display: fn(self) -> String {
            if self.kind == {
                .Unavailable(stage, reason) -> {
                    needed: if stage == {
                        .Parsed -> "parsing"
                        .Resolved -> "resolution"
                        .Typed -> "type checking"
                        .Prepared -> "preparation"
                        .Emitted -> "emission"
                    }
                    "{self.query}: unavailable before {needed}: {reason}"
                }
                .Unsupported(capability) -> "{self.query}: unsupported: {capability}"
                .Stale(requested, current) -> "{self.query}: snapshot {requested.text()} is stale; the current one is {current.text()}"
                .Invalid(diagnostics) -> "{self.query}: the snapshot did not check ({diagnostics.len()} diagnostics)"
                .Denied(scope, reason) -> "{self.query}: denied in {scope.text()}: {reason}"
                .Truncated(limit, observed) -> "{self.query}: {observed} rows match, over the limit of {limit}"
            }
        }
    }
}

/// The kinds of fact a store holds. In the executable schema they are its
/// marker rules and its typed fact reads; in a checked program they are the
/// markers its declarations carry, each marker's written arguments, and the
/// typed facts the checker recorded. A store asked for a kind it doesn't
/// hold refuses with `Unsupported`.
FactKind: enum { Marker MarkerArg Read }

/// One row of the toolchain's executable schema.
SchemaFact: struct {
    kind: FactKind
    /// The row's canonical name: the marker or the read it declares.
    name: String
    /// Where the row applies: a marker rule's sites, a fact read's planes.
    scope: [String]
}

/// The running toolchain's executable schema, as `compiler.schema()` issues
/// it: an immutable snapshot that `query` reads.
SchemaSnapshot: struct {
    priv id: SnapshotID
    priv facts: [SchemaFact]

    identity: fn(self) -> SnapshotID Never! { self.id.copy() }
}

/// Where a program fact sits: its package, its module, and the type or
/// function it belongs to.
FactScope: struct {
    package: String
    module: String
    item: String
}

/// One fact of a checked program: a marker a declaration carries, one
/// argument of such a marker, or a typed fact the checker recorded on a type
/// or function.
ProgramFact: struct {
    kind: FactKind
    /// The marker's name, `Marker.argument` for a marker argument, or the
    /// recorded fact's name.
    name: String
    /// The canonical identity of the type or function it belongs to.
    subject: String
    /// The row's stable identity: `subject#kind:name`, then `@n` for the
    /// n-th repeat of the same name on the same subject.
    identity: String
    scope: FactScope
    /// The checked program's revision: the content hash of its sources.
    source: SnapshotID
}

/// The immutable snapshot a query reads: the running toolchain's schema, or
/// a program checked through the normal pipeline (`b.program` in a build).
FactSource: enum {
    Schema(snapshot: SchemaSnapshot)
    Program(program: ProgramInfo)
}

/// One fact a query returns, tagged by the store it comes from.
Fact: enum {
    Schema(fact: SchemaFact)
    Program(fact: ProgramFact)
}

/// A point in a run's recorded timeline, in milliseconds from the run's
/// start. A query without one reads the source's complete recorded view.
QueryTime: struct {
    elapsed_ms: Int
}

/// The facts of `kind` in `source`, in the source's canonical order: a
/// program's types, then its functions, each in declaration order. Facts a
/// query can't answer completely are a `MetadataError`, never a shorter list:
/// more matches than `limit` is `Truncated`.
query: fn(source: FactSource, kind: FactKind, at: QueryTime?{None}, limit: Int?{None}) -> [Fact] MetadataError! {
    rows := [Fact]{}
    if source == {
        .Schema(snapshot) -> {
            if at != None -> return Err(MetadataError{kind: MetadataFailure.Unsupported{capability: "a time view of a schema snapshot"}, query: "query", source: None})
            if kind == FactKind.MarkerArg -> return Err(MetadataError{kind: MetadataFailure.Unsupported{capability: "marker-argument facts of the schema store"}, query: "query", source: None})
            loop fact in snapshot.facts {
                if fact.kind == kind -> rows.push(Fact.Schema{fact: fact.copy()})
            }
        }
        .Program(program) -> {
            if at != None -> return Err(MetadataError{kind: MetadataFailure.Unsupported{capability: "a time view of a checked program"}, query: "query", source: None})
            revision: SnapshotID{digest: program.revision()}
            loop package in program.packages() {
                loop info in package.types {
                    seen := [String]{}
                    scope: FactScope{package: package.name.copy(), module: info.module.copy(), item: info.name.copy()}
                    if kind == {
                        .Marker -> { loop marker in info.markers -> rows.push(program_fact(kind, marker.name, info.identity, scope, revision, seen)) }
                        .MarkerArg -> {
                            loop marker in info.markers {
                                loop arg in marker.args -> rows.push(program_fact(kind, "{marker.name}.{arg.name}", info.identity, scope, revision, seen))
                            }
                        }
                        .Read -> { loop fact in info.facts -> rows.push(program_fact(kind, fact.name, info.identity, scope, revision, seen)) }
                    }
                }
            }
            if kind == FactKind.Read {
                loop package in program.packages() {
                    loop function in package.functions {
                        seen := [String]{}
                        scope: FactScope{package: package.name.copy(), module: function.module.copy(), item: function.name.copy()}
                        loop fact in function.facts -> rows.push(program_fact(kind, fact.name, function.identity, scope, revision, seen))
                    }
                }
            }
        }
    }
    if limit == .Val(most) {
        if rows.len() > most -> return Err(MetadataError{kind: MetadataFailure.Truncated{limit: most, observed: rows.len()}, query: "query", source: None})
    }
    Ok(rows)
}

// The rows `query` builds, not part of the compiler surface.
priv query_rows: module {
    // One program row. `seen` holds the names already given on this subject,
    // so a repeated name gets its `@n` identity.
    program_fact: fn(kind: FactKind, name: String, subject: String, scope: FactScope, revision: SnapshotID, seen: &[String]) -> Fact Never! {
        word: if kind == {
            .Marker -> "marker"
            .MarkerArg -> "marker-arg"
            .Read -> "read"
        }
        repeat := 0
        loop earlier in seen {
            if earlier == name -> repeat += 1
        }
        seen.push(name.copy())
        identity: if repeat == 0 -> "{subject}#{word}:{name}" else -> "{subject}#{word}:{name}@{repeat}"
        Fact.Program{fact: ProgramFact{kind: kind, name: name.copy(), subject: subject.copy(), identity: identity, scope: scope.copy(), source: revision.copy()}}
    }
}
