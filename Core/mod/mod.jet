package {
    name: "core.mod"
    version: "0.0.1"
    edition: "2026"
    description: "Load a compiled Jet compiled from disk."
    license: "MIT"
    outputs: {
        mod: .Library{ entry: mod }
    }
}
use core as core
use core.mod.runtime.top_mod as mod_wire

module runtime

// core.mod — a compiled Jet unit loaded under an explicit read grant.
//
// The canonical Foundation codec and private runtime policy own validation and
// ABI refusal meaning. The native provider owns staging and handle lifetime:
// `Mod` remains opaque and dropping it releases the mapped native module.

/// D-MOD-ERR1=A: each case asks the caller for a different action. `Denied`:
/// the grant refuses the path or an effect the library declares. `NotFound`:
/// nothing is at the path. `Invalid`: the file is damaged or is not a
/// library. `Unsupported`: another Jet version, ABI or platform built it, or
/// loading is not available here. Each case holds the provider's reason.
#Error
pub enum ModError {
    Denied(String)
    NotFound(String)
    Invalid(String)
    Unsupported(String)
}

pub fn load(path: String, grant: ModGrant) -[FS, Exec]> Mod ModError! {
    if core.mod.load(path, grant: grant) == {
        .Ok(loaded) -> Ok(loaded)
        .Err(reason) -> Err(mod_wire.mod_error(reason))
    }
}
pub struct CompiledModule {
    pub path: String
    pub handle: Int
}

// The provider exposes no `jet_mod_unload` operation.  `Mod` owns its native
// handle and unloads on drop; a legacy value cannot truthfully be turned into
// a detached carrier, so preserve the export as a typed refusal.
pub fn unload(compiled: CompiledModule) -[FS]> CompiledModule ModError! {
    Err(ModError.Unsupported("core.mod.unload is unavailable: loaded Mod handles are provider-owned and unload on drop"))
}


pub fn is_loaded(compiled: CompiledModule) -> Bool Never! {
    compiled.handle > 0
}

pub fn path(compiled: CompiledModule) -> String Never! {
    compiled.path
}

