package {
    name: "core.mod"
    version: "0.1.0"
    edition: "2026"
    description: "Load a compiled Jet compiled from disk."
    license: "MIT"
    outputs: {
        mod: .Library{ entry: mod }
    }
}
use core as core

// core.mod — a compiled Jet unit loaded under an explicit read grant.
//
// The provider owns artifact validation, staging, ABI checks, and handle
// lifetime.  The returned `Mod` is opaque; dropping it releases the native
// module, so source cannot manufacture a detached or already-unloaded handle.
pub fn load(path: String, grant: ModGrant) -[FS, Exec]> Mod Err! {
    core.mod.load(path, grant: grant)
}
pub struct CompiledModule {
    pub path: String
    pub handle: Int
}

// The provider exposes no `jet_mod_unload` operation.  `Mod` owns its native
// handle and unloads on drop; a legacy value cannot truthfully be turned into
// a detached carrier, so preserve the export as a typed refusal.
pub fn unload(compiled: CompiledModule) -[FS]> CompiledModule Err! {
    Err("core.mod.unload is unavailable: loaded Mod handles are provider-owned and unload on drop")
}

pub fn is_loaded(compiled: CompiledModule) -> Bool {
    compiled.handle > 0
}

pub fn path(compiled: CompiledModule) -> String {
    compiled.path
}

