package {
    name: "core.files"
    version: "0.0.1"
    edition: "2026"
    description: "Filesystem handles, paths, and whole-file convenience."
    license: "MIT"
    outputs: {
        files: .Library{ entry: files }
    }
}
use core as core
use core.text as unicode


use core.sys as sys
// core.files — one filesystem surface.
//
// Whole-file helpers (`read`, `write`, `write_bytes`, `append_all`) and
// streaming constructors (`open`, `create`, `append`) share this namespace.
// `append_all` is the whole-file twin so it does not collide with a handle
// `.append` method. Each filesystem call names the leaf it needs: reads and
// queries are `-[FS.Read]>`, changes are `-[FS.Write]>`, and a call that does
// both keeps `-[FS]>`; current-directory and environment helpers additionally
// carry `-[Env]>`. Missing files,
// permission denials, and type mismatches are `IOError`; nothing here panics
// on a bad path.
//
// `exists` / `is_dir` return booleans rather than errors: a path that cannot
// be observed is treated as absent. `walk` / `walk_files` / `walk_parallel`
// take an optional ignore-file name (`.gitignore` style).
//
// The OS door is the typed `core.files` provider: open/read/write/stat,
// directory, link, temp, lock, and metadata calls route through it. Walk,
// glob, copy composition, and path math remain Jet.
// Open readers, writers, temporary files and directories, and locks own their
// provider resources until their lexical scope exits or they are consumed by
// `close(^handle)`. A writer's explicit `flush()` remains fallible.
// Directory copies preserve that boundary: only regular files are copied;
// symlink and other special entries are never dereferenced.


pub struct DirEntry {
    pub name: String
    pub path: String
    pub is_dir: Bool
}

pub struct Stat {
    pub size: Int
    pub modified_ms: Int
    pub created_ms: Int
    pub readonly: Bool
    pub is_file: Bool
    pub is_dir: Bool
    pub is_symlink: Bool
    pub kind: String
    pub mode: Int
}

pub struct WalkEntry {
    pub path: String
    pub relative: String
    pub is_dir: Bool
    pub depth: Int
}

pub struct FileScope {
    pub authority: Authority
}

pub struct MappedFile {
    pub path: String
    pub bytes: [U8]
}

pub struct TempDir {
    path: String
}

pub struct TempFile {
    path: String
}

pub struct FileLock {
    path: String
}

pub struct FileReader {
    path: String
}

pub struct FileWriter {
    path: String
}


pub fn scope(authority: Authority) -[FS]> FileScope Never! { {authority: authority} }


pub fn open(path: String) -[FS.Read]> FileReader IOError! { core.files.open(path) }


pub fn create(path: String) -[FS.Write]> FileWriter IOError! { core.files.create(path) }


pub fn append(path: String) -[FS.Write]> FileWriter IOError! { core.files.append(path) }



fn io_err(operation: String, path: String, message: String) -> IOError Never! {
    if operation == "write" || operation == "mkdir" || operation == "truncate" {
        return IOError.InvalidInput(IOContext{
            operation: .Write,
            resource: Val(path),
            os_code: None,
            cause: Val(message),
        })
    }
    if operation == "resolve" || operation == "home" || operation == "samefile" {
        return IOError.InvalidInput(IOContext{
            operation: .Resolve,
            resource: Val(path),
            os_code: None,
            cause: Val(message),
        })
    }
    IOError.InvalidInput(IOContext{
        operation: .Read,
        resource: Val(path),
        os_code: None,
        cause: Val(message),
    })
}


pub fn read_bytes(path: String) -[FS.Read]> [U8] IOError! { core.files.read_bytes(path) }


pub fn read(path: String) -[FS.Read]> String IOError! {
    bytes :: read_bytes(~path)
    Ok(String.from_bytes(bytes) ?? return Err(io_err("read", path, "file is not valid UTF-8")))
}


pub fn map(path: String) -[FS.Read]> MappedFile IOError! { core.files.map(path) }


pub fn write(path: String, text: String) IOError! -[FS.Write]> { core.files.write(path, text) }


pub fn write_bytes(path: String, bytes: [U8]) IOError! -[FS.Write]> { core.files.write_bytes(path, bytes) }


pub fn append_all(path: String, text: String) IOError! -[FS.Write]> { core.files.append_all(path, text) }


pub fn write_atomic(path: String, bytes: [U8]) IOError! -[FS.Write]> {
    core.files.write_atomic(path, bytes)
}


pub fn read_at(path: String, offset: Int, count: Int) -[FS.Read]> [U8] IOError! {
    core.files.read_at(path, offset, count)
}


pub fn write_at(path: String, offset: Int, bytes: [U8]) IOError! -[FS.Write]> {
    core.files.write_at(path, offset, bytes)
}


pub fn fsync(path: String) IOError! -[FS.Write]> { core.files.fsync(path) }


fn exists_impl(path: String) -> Bool Never! { core.files.exists(path) }


pub fn exists(path: String) -[FS]> Bool Never! { exists_impl(path) }


pub fn is_dir(path: String) -[FS.Read]> Bool Never! { core.files.is_dir(path) }


pub fn stat(path: String) -[FS.Read]> Stat IOError! { core.files.stat(path) }


pub fn set_mode(path: String, mode: Int) IOError! -[FS.Write]> { core.files.set_mode(path, mode) }


fn anchor_for_parts(drive: String, absolute: Bool) -> String Never! {
    if drive.bytes().len() > 0 -> return ~drive
    if absolute -> return "/"
    ""
}


fn join_parts(parts: [String]) -> String Never! {
    s := ""
    first := true
    loop p in parts {
        if p.bytes().len() == 0 -> next
        if first {
            s = p
            first = false
        } else { s = "{s}/{p}" }
    }
    s
}


fn compose(anchor: String, parts: [String]) -> String Never! {
    s :: join_parts(parts)
    if anchor == "/" {
        if s.bytes().len() == 0 -> return "/"
        return "/{s}"
    }
    if anchor.bytes().len() > 0 {
        if s.bytes().len() == 0 -> return "{anchor}/"
        return "{anchor}/{s}"
    }
    if s.bytes().len() == 0 -> return "."
    s
}


fn is_letter(b: U8) -> Bool Never! {
    n :: b
    (n >= 65 && n <= 90) || (n >= 97 && n <= 122)
}


fn is_abs_impl(path: String) -> Bool Never! {
    raw :: (~path).bytes()
    if raw.len() == 0 -> return false
    if raw[0] == (U8{47}) || raw[0] == (U8{92}) -> return true
    raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{58})
}

pub fn is_abs(path: String) -> Bool Never! { is_abs_impl(path) }


fn is_separator(b: U8) -> Bool Never! { b == (U8{47}) || b == (U8{92}) }


fn slice(raw: [U8], start: Int, end: Int) -> String Never! {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i < 0 || i >= raw.len() -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}


fn split_slash_impl(path: String) -> [String] Never! {
    raw :: (~path).bytes()
    out := [String]{}
    start := 0
    i := 0
    loop i < raw.len() {
        n :: raw[i]
        if n == 47 || n == 92 {
            &out.push(slice(raw, start, i))
            start = i + 1
        }
        i = i + 1
    }
    &out.push(slice(raw, start, raw.len()))
    out
}

pub fn split_slash(path: String) -> [String] Never! { split_slash_impl(path) }


fn collapse_impl(path: String) -> String Never! {
    raw :: (~path).bytes()
    if raw.len() == 0 -> return "."
    absolute := is_abs_impl(path)
    drive := ""
    start := 0
    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{58}) {
        drive = slice(raw, 0, 2)
        start = 2
        if start < raw.len() && is_separator(raw[start]) -> start = start + 1
    } else if absolute {
        start = 1
        loop start < raw.len() && is_separator(raw[start]) -> start = start + 1
    }
    tail :: slice(raw, start, raw.len())
    out := [String]{}
    loop p in split_slash_impl(tail) {
        if p == "" || p == "." -> next
        if p == ".." {
            if out.len() > 0 {
                prev :: out[out.len() - 1]
                if prev != ".." {
                    _ :: &out.pop()
                    next
                }
            }
            if !absolute -> &out.push("..")
            next
        }
        &out.push(p)
    }
    compose(anchor_for_parts(drive, absolute), out)
}

pub fn collapse(path: String) -> String Never! { collapse_impl(path) }


fn strip_leading_separators(path: String) -> String Never! {
    raw :: (~path).bytes()
    i := 0
    loop i < raw.len() && is_separator(raw[i]) -> i = i + 1
    slice(raw, i, raw.len())
}


fn join_impl(a: String, b: String) -> String Never! {
    if b.bytes().len() == 0 -> return ~a
    if is_abs_impl(b) -> return ~b
    if a.bytes().len() == 0 -> return ~b
    clean_b :: strip_leading_separators(b)
    if clean_b.bytes().len() == 0 -> return ~a
    last :: a.bytes()[a.bytes().len() - 1]
    if is_separator(last) -> return "{a}{clean_b}"
    "{a}/{clean_b}"
}

pub fn join(a: String, b: String) -> String Never! { join_impl(a, b) }


pub fn absolute(path: String) -[FS, Env]> String IOError! {
    if is_abs_impl(~path) -> return Ok(collapse_impl(~path))
    cwd :: sys.current_dir()
    Ok(collapse_impl(join_impl(cwd, path)))
}


pub fn canonicalize(path: String) -[FS, Env]> String IOError! {
    core.files.canonicalize(path)
}


pub fn list_dir(path: String) -[FS.Read]> [DirEntry] IOError! { core.files.list_dir(path) }


pub fn create_dir(path: String) IOError! -[FS.Write]> { core.files.create_dir(path) }


fn dirname_impl(path: String) -> String Never! {
    raw :: (~path).bytes()
    if raw.len() == 0 -> return ""
    end := raw.len()
    loop end > 1 && is_separator(raw[end - 1]) {
        end = end - 1
    }
    if end == 0 -> return "/"
    i := end - 1
    loop i >= 0 {
        if is_separator(raw[i]) {
            if i == 0 -> return "/"
            prefix := slice(raw, 0, i)
            if prefix.bytes().len() == 2 && prefix.bytes()[1] == (U8{58}) {
                return "{prefix}/"
            }
            return prefix
        }
        i = i - 1
    }
    if end >= 2 && is_letter(raw[0]) && raw[1] == (U8{58}) -> return slice(raw, 0, 2)
    ""
}

pub fn dirname(path: String) -> String Never! { dirname_impl(path) }


pub fn create_dir_all(path: String) IOError! -[FS]> {
    if (~path).bytes().len() == 0 -> return Ok()
    if exists(~path) ?? panic("exists failed") {
        info :: stat(~path)
        if info.is_dir -> return Ok()
        return Err(io_err("mkdir", path, "path exists and is not a directory"))
    }
    parent :: dirname_impl(~path)
    if parent.bytes().len() > 0 && parent != path -> create_dir_all(parent)
    if !(exists(~path) ?? panic("exists failed")) -> core.files.create_dir(path)
    return Ok()
}


pub fn remove(path: String) IOError! -[FS.Write]> { core.files.remove(path) }


pub fn remove_dir(path: String) IOError! -[FS.Write]> { core.files.remove_dir(path) }


pub fn remove_all(path: String) IOError! -[FS]> {
    if is_dir(~path) ?? panic("is_dir failed") {
        entries :: list_dir(~path)
        loop e in entries -> remove_all(e.path)
    }
    if lexists(~path) ?? panic("lexists failed") -> core.files.remove(path)
    return Ok()
}


fn copy_file_impl(from: String, to: String) IOError! -[FS]> {
    bytes :: core.files.read_bytes(from)
    parent :: dirname_impl(~to)
    if parent.bytes().len() > 0 -> core.files.create_dir_all(parent)
    core.files.write_bytes(~to, bytes)
}


pub fn copy_dir(from: String, to: String) IOError! -[FS]> {
    create_dir_all(~to)
    entries :: list_dir(from)
    loop e in entries {
        dest :: join_impl(~to, e.name)
        if e.is_dir {
            copy_dir(e.path, dest)
        } else {
            info :: stat(e.path)
            if info.is_file && !info.is_symlink -> copy_file_impl(e.path, dest)
        }
    }
    return Ok()
}


pub fn rename(from: String, to: String) IOError! -[FS.Write]> { core.files.rename(from, to) }


/// Create `link` as a symbolic link naming `original`. The link text is stored
/// as given and is not resolved; later path operations follow it, so lexical
/// `Path.is_within` cannot see an escape through a link — compare
/// `canonicalize` results instead.
pub fn symlink(original: String, link: String) IOError! -[FS.Write]> { core.files.symlink(original, link) }


pub fn hard_link(original: String, link: String) IOError! -[FS.Write]> { core.files.hard_link(original, link) }


pub fn read_link(path: String) -[FS.Read]> String IOError! { core.files.read_link(path) }


fn split_lines(text: String) -> [String] Never! {
    raw :: (~text).bytes()
    out := [String]{}
    start := 0
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{10}) {
            line := slice(raw, start, i)
            if line.bytes().len() > 0 && line.bytes()[line.bytes().len() - 1] == (U8{13}) {
                line = slice(line.bytes(), 0, line.bytes().len() - 1)
            }
            &out.push(line)
            start = i + 1
        }
        i = i + 1
    }
    if start < raw.len() -> &out.push(slice(raw, start, raw.len()))
    out
}


fn trim(text: String) -> String Never! {
    raw :: (~text).bytes()
    a := 0
    b := raw.len()
    loop a < b {
        n :: raw[a]
        if n == 32 || n == 9 -> a = a + 1 else -> break
    }
    loop b > a {
        n :: raw[b - 1]
        if n == 32 || n == 9 -> b = b - 1 else { break }
    }
    slice(raw, a, b)
}


fn glob_bytes(pat: [U8], pi: Int, name: [U8], ni: Int) -> Bool Never! {
    if pi >= pat.len() -> return ni >= name.len()
    if pat[pi] == (U8{42}) {
        if glob_bytes(pat, pi + 1, name, ni) -> return true
        if ni < name.len() -> return glob_bytes(pat, pi, name, ni + 1)
        return false
    }
    if ni >= name.len() -> return false
    if pat[pi] == (U8{63}) -> return glob_bytes(pat, pi + 1, name, ni + 1)
    if pat[pi] == (U8{91}) {
        j := pi + 1
        negated := false
        if j < pat.len() && (pat[j] == (U8{33}) || pat[j] == (U8{94})) {
            negated = true
            j = j + 1
        }
        matched := false
        closed := false
        loop j < pat.len() {
            if pat[j] == (U8{93}) {
                closed = true
                break
            }
            if j + 2 < pat.len() && pat[j + 1] == (U8{45}) && pat[j + 2] != (U8{93}) {
                if name[ni] >= pat[j] && name[ni] <= pat[j + 2] -> matched = true
                j = j + 3
            } else {
                if name[ni] == pat[j] -> matched = true
                j = j + 1
            }
        }
        if !closed -> return pat[pi] == name[ni] && glob_bytes(pat, pi + 1, name, ni + 1)
        if negated -> matched = !matched
        if !matched -> return false
        return glob_bytes(pat, j + 1, name, ni + 1)
    }
    if pat[pi] == name[ni] -> return glob_bytes(pat, pi + 1, name, ni + 1)
    false
}


fn glob_seg(pat: String, name: String) -> Bool Never! { glob_bytes(pat.bytes(), 0, name.bytes(), 0) }


fn glob_parts(pat: [String], pi: Int, tgt: [String], ti: Int) -> Bool Never! {
    if pi >= pat.len() -> return ti >= tgt.len()
    if pat[pi] == "**" {
        if glob_parts(pat, pi + 1, tgt, ti) -> return true
        if ti < tgt.len() -> return glob_parts(pat, pi, tgt, ti + 1)
        return false
    }
    if ti >= tgt.len() -> return false
    if !glob_seg(pat[pi], tgt[ti]) -> return false
    glob_parts(pat, pi + 1, tgt, ti + 1)
}


fn glob_parts_for(path: String) -> [String] Never! {
    raw :: (~path).bytes()
    out := [String]{}
    drive := ""
    absolute := is_abs_impl(path)
    start := 0
    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{58}) {
        drive = slice(raw, 0, 2)
        start = 2
        if start < raw.len() && is_separator(raw[start]) -> start = start + 1
    } else if absolute {
        &out.push("/")
        start = 1
        loop start < raw.len() && is_separator(raw[start]) -> start = start + 1
    }
    if drive.bytes().len() > 0 -> &out.push(drive)
    loop p in split_slash_impl(slice(raw, start, raw.len())) {
        if p.bytes().len() > 0 -> &out.push(p)
    }
    out
}


fn glob_match_impl(pattern: String, path: String) -> Bool Never! {
    pp :: glob_parts_for(pattern)
    tt :: glob_parts_for(path)
    glob_parts(pp, 0, tt, 0)
}

pub fn glob_match(pattern: String, path: String) -> Bool Never! { glob_match_impl(pattern, path) }


fn has_separator(path: String) -> Bool Never! {
    loop b in (~path).bytes() {
        if is_separator(b) -> return true
    }
    false
}


fn anchor_of(path: String) -> String Never! {
    raw :: (~path).bytes()
    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{58}) -> return slice(raw, 0, 2)
    if raw.len() > 0 && is_separator(raw[0]) -> return "/"
    ""
}


fn path_parts(path: String) -> [String] Never! {
    raw :: (~path).bytes()
    start := 0
    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{58}) {
        start = 2
        if start < raw.len() && is_separator(raw[start]) -> start = start + 1
    } else if raw.len() > 0 && is_separator(raw[0]) {
        start = 1
        loop start < raw.len() && is_separator(raw[start]) -> start = start + 1
    }
    out := [String]{}
    loop p in split_slash_impl(slice(raw, start, raw.len())) {
        if p.bytes().len() > 0 -> &out.push(p)
    }
    out
}


fn relative_impl(path: String, start: String) -> String Never! {
    a :: collapse_impl(path)
    b :: collapse_impl(start)
    if anchor_of(a) != anchor_of(b) -> return a
    ap :: path_parts(a)
    bp :: path_parts(b)
    i := 0
    loop i < ap.len() && i < bp.len() {
        if ap[i] != bp[i] -> break
        i = i + 1
    }
    out := [String]{}
    j := i
    loop j < bp.len() {
        &out.push("..")
        j = j + 1
    }
    loop i < ap.len() {
        &out.push(ap[i])
        i = i + 1
    }
    s :: join_parts(out)
    if s.bytes().len() == 0 -> return "."
    s
}

pub fn relative(path: String, start: String) -> String Never! { relative_impl(path, start) }


fn ignored(name: String, path: String, root: String, skip: [String]) -> Bool Never! {
    rel :: relative_impl(path, root)
    loop pat in skip {
        if has_separator(pat) {
            if glob_match_impl(pat, rel) -> return true
        } else if glob_seg(pat, name) -> return true
    }
    false
}


fn walk_rec(path: String, root: String, skip: [String], files_only: Bool) -[FS]> [WalkEntry] IOError! {
    out := [WalkEntry]{}
    entries :: core.files.list_dir(~path)
    loop e in entries {
        if ignored(e.name, ~e.path, ~root, ~skip) -> next
        rel :: relative_impl(~e.path, ~root)
        depth := 1
        loop b in rel.bytes() {
            if is_separator(b) -> depth = depth + 1
        }
        if e.is_dir {
            if !files_only -> &out.push(WalkEntry{path: e.path, relative: rel, is_dir: true, depth: depth})
            kids :: walk_rec(~e.path, ~root, ~skip, files_only)
            loop k in kids -> &out.push(k)
        } else if !files_only || !e.is_dir {
            &out.push(WalkEntry{path: e.path, relative: rel, is_dir: false, depth: depth})
        }
    }
    Ok(out)
}


fn walk_impl(root: String, ignore: String?, files_only: Bool) -[FS]> [WalkEntry] IOError! {
    skip := [String]{}
    ign :: ignore ?? ""
    if ign.bytes().len() > 0 {
        text :: core.files.read(join_impl(~root, ~ign))
        loop line in split_lines(text) {
            t :: trim(line)
            if t.bytes().len() == 0 -> next
            if t.bytes()[0] == (U8{35}) -> next
            &skip.push(t)
        }
        &skip.push(ign)
    }
    entries :: walk_rec(~root, ~root, ~skip, files_only)
    Ok(entries)
}


pub fn walk(root: String, ignore: String?) -[FS]> [WalkEntry] IOError! {
    walk_impl(root, ignore, false)
}


pub fn walk_parallel(root: String, ignore: String?) -[FS]> [WalkEntry] IOError! {
    // Cooperative Jet has no thread pool yet; the walk is the same walk.
    walk_impl(root, ignore, false)
}


pub fn walk_files(root: String, ignore: String?) -[FS]> [WalkEntry] IOError! {
    walk_impl(root, ignore, true)
}


fn has_meta(seg: String) -> Bool Never! {
    loop b in seg.bytes() {
        n :: b
        if n == 42 || n == 63 || n == 91 -> return true
    }
    false
}


fn glob_root(pattern: String) -> String Never! {
    parts :: split_slash_impl(pattern)
    static := [String]{}
    i := 0
    loop i < parts.len() {
        if has_meta(parts[i]) -> break
        &static.push(parts[i])
        i = i + 1
    }
    if !is_abs_impl(pattern) {
        root :: join_parts(static)
        if root.bytes().len() == 0 -> return "."
        return root
    }
    drive := ""
    raw :: pattern.bytes()
    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{58}) -> drive = slice(raw, 0, 2)
    body := [String]{}
    j := 0
    if drive.bytes().len() > 0 && static.len() > 0 && static[0] == drive -> j = 1
    loop j < static.len() {
        &body.push(static[j])
        j = j + 1
    }
    compose(anchor_for_parts(drive, true), body)
}


pub fn glob(pattern: String) -[FS]> [String] IOError! {
    if !has_meta(~pattern) {
        if exists_impl(~pattern) -> return Ok([String]{~pattern})
        return Ok([String]{})
    }
    root :: glob_root(~pattern)
    entries :: core.files.walk(~root)
    out := [String]{}
    loop e in entries {
        candidate := e.path
        relative_candidate := ~candidate
        cbytes :: candidate.bytes()
        if cbytes.len() >= 2 && cbytes[0] == (U8{46}) && is_separator(cbytes[1]) {
            relative_candidate = slice(cbytes, 2, cbytes.len())
        }
        if glob_match_impl(~pattern, ~candidate) || glob_match_impl(~pattern, relative_candidate) {
            &out.push(candidate)
        }
    }
    Ok(out)
}


pub fn temp_dir(prefix: String) -[FS]> TempDir IOError! { core.files.temp_dir(prefix) }


pub fn temp_file(prefix: String) -[FS]> TempFile IOError! { core.files.temp_file(prefix) }


/// Take an exclusive lock by creating `path` (create-new). A second `lock` on
/// a held path fails with an `IOError`; the lock file is removed when the
/// returned `FileLock` leaves scope, which makes the path available again.
pub fn lock(path: String) -[FS]> FileLock IOError! { core.files.lock(path) }


pub fn basename(path: String) -> String Never! {
    raw :: (~path).bytes()
    i := raw.len() - 1
    loop i >= 0 {
        if raw[i] == (U8{47}) || raw[i] == (U8{92}) -> return slice(raw, i + 1, raw.len())
        i = i - 1
    }
    ~path
}


pub fn suffix(path: String) -> String Never! {
    name :: basename(path)
    raw :: name.bytes()
    i := raw.len() - 1
    loop i > 0 {
        if raw[i] == (U8{46}) -> return slice(raw, i, raw.len())
        i = i - 1
    }
    ""
}


pub fn stem(path: String) -> String Never! {
    name :: basename(path)
    raw :: name.bytes()
    i := raw.len() - 1
    loop i > 0 {
        if raw[i] == (U8{46}) -> return slice(raw, 0, i)
        i = i - 1
    }
    ~name
}


pub fn with_suffix(path: String, next: String) -> String Never! {
    dir :: dirname(path)
    base :: stem(path)
    joined :: "{base}{next}"
    if dir.bytes().len() == 0 -> return joined
    join(dir, joined)
}


pub fn with_name(path: String, name: String) -> String Never! {
    dir :: dirname(path)
    if dir.bytes().len() == 0 -> return ~name
    join(dir, name)
}


pub fn is_absolute(path: String) -> Bool Never! { is_abs(path) }


fn is_file_impl(path: String) -> Bool Never! {
    info :: core.files.stat(path) ?? return false
    info.is_file
}

pub fn is_file(path: String) -[FS]> Bool Never! { is_file_impl(path) }


pub fn is_symlink(path: String) -[FS]> Bool Never! {
    info :: core.files.stat(path) ?? return false
    info.is_symlink
}


pub fn cwd() -[FS, Env]> String IOError! { sys.current_dir() }


pub fn home() -[FS, Env]> String IOError! {
    core.sys.home_dir() ?? return Err(io_err("home", "", "home directory unavailable"))
}


pub fn expanduser(path: String) -[FS, Env]> String IOError! {
    raw :: (~path).bytes()
    if raw.len() == 0 || raw[0] != (U8{126}) -> return Ok(~path)
    h :: home()
    if raw.len() == 1 -> return Ok(h)
    if raw[1] == (U8{47}) || raw[1] == (U8{92}) -> return Ok(join_impl(h, slice(raw, 2, raw.len())))
    Ok(~path)
}


pub fn touch(path: String) IOError! -[FS]> {
    if exists_impl(~path) {
        core.files.fsync(path)
        return Ok()
    }
    parent :: dirname_impl(~path)
    if parent.bytes().len() > 0 -> core.files.create_dir_all(parent)
    core.files.write_bytes(path, [U8]{})
}


pub fn relocate(from: String, to: String) IOError! -[FS]> { core.files.rename(from, to) }


/// Python-compatible spelling for an atomic replacement rename.
pub fn replace(from: String, to: String) IOError! -[FS]> { relocate(from, to) }


/// Return `path` relative to `start`, using the same normalized path rules.
pub fn relativeto(path: String, start: String) -> String Never! { relative(path, start) }


/// Python-compatible spelling for `set_mode`.
pub fn chmod(path: String, mode: Int) IOError! -[FS]> { core.files.set_mode(path, mode) }


/// Copy the bytes of `from` to `to`, creating missing parent directories.
/// Unlike Python's `shutil.copy2`, permission bits and timestamps are not
/// copied: the new file takes the default mode.
pub fn copy2(from: String, to: String) IOError! -[FS]> { copy_file_impl(from, to) }


/// Python-compatible spelling for a single-file copy.
pub fn copyfile(from: String, to: String) IOError! -[FS]> { copy2(from, to) }


/// Create one directory, or all missing parents when `parents` is true.
pub fn mkdir(path: String, parents: Bool) IOError! -[FS]> {
    if parents -> return core.files.create_dir_all(path)
    core.files.create_dir(path)
}


pub fn rmdir(path: String) IOError! -[FS]> { core.files.remove_dir(path) }


pub fn unlink(path: String) IOError! -[FS]> { core.files.remove(path) }


pub fn joinpath(a: String, b: String) -> String Never! { join(a, b) }


/// Python `os` spellings backed by the same checked filesystem surface.
pub fn getcwd() -[FS, Env]> String IOError! { cwd() }


pub fn chdir(path: String) IOError! -[FS, Env]> { sys.set_current_dir(path) }


pub fn scandir(path: String) -[FS]> [DirEntry] IOError! { core.files.list_dir(path) }


pub fn gettempdir() -[Env]> String Never! { sys.temp_dir() }


pub fn getenv(name: String) -[Env]> String? Never! { sys.get(name) }


pub fn read_lines(path: String) -[FS]> [String] IOError! {
    text :: core.files.read(path)
    Ok(split_lines(text))
}


pub fn write_lines(path: String, lines: [String]) IOError! -[FS]> {
    s := ""
    loop line in lines -> s = "{s}{line}\n"
    core.files.write(path, s)
}


pub fn commonpath(paths: [String]) -> String Never! {
    if paths.len() == 0 -> return ""
    first :: collapse_impl(paths[0])
    anchor := anchor_of(first)
    parts := path_parts(first)
    loop p in paths {
        cur :: collapse_impl(p)
        if anchor_of(cur) != anchor -> return ""
        next :: path_parts(cur)
        n := parts.len()
        if next.len() < n -> n = next.len()
        k := 0
        loop k < n {
            if parts[k] != next[k] -> break
            k = k + 1
        }
        kept := [String]{}
        i := 0
        loop i < k {
            &kept.push(parts[i])
            i = i + 1
        }
        parts = kept
    }
    compose(anchor, parts)
}


pub fn fnmatch(name: String, pattern: String) -> Bool Never! { glob_match(pattern, name) }


fn split_path_env(text: String) -> [String] Never! {
    raw :: (~text).bytes()
    out := [String]{}
    start := 0
    i := 0
    sep := 58
    loop b in raw {
        if b == (U8{59}) {
            sep = 59
            break
        }
    }
    loop i <= raw.len() {
        n := 0
        if i < raw.len() -> n = raw[i]
        if i == raw.len() || n == sep {
            &out.push(slice(raw, start, i))
            start = i + 1
        }
        i = i + 1
    }
    out
}


pub fn which(name: String) -[FS, Env]> String? Never! {
    if is_abs_impl(~name) {
        if is_file_impl(~name) -> return Val(~name)
        return None
    }
    path_var :: sys.get("PATH") ?? ""
    loop dir in split_path_env(path_var) {
        base := dir
        if base.bytes().len() == 0 -> base = "."
        cand :: join_impl(~base, ~name)
        if is_file_impl(cand) -> return Val(cand)
    }
    None
}


fn slice_path(text: String, start: Int, end: Int) -> String Never! {
    raw :: (~text).bytes()
    out := [U8]{}
    i := start
    loop {
        if i >= end || i < 0 || i >= raw.len() -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}


pub fn splitext(path: String) -> (ext: String, root: String) Never! {
    ext :: suffix(~path)
    if ext.bytes().len() == 0 -> return (root: ~path, ext: "")
    root :: slice_path(~path, 0, (~path).bytes().len() - ext.bytes().len())
    (root: root, ext: ext)
}


pub fn split(path: String) -> (dir: String, name: String) Never! {
    (dir: dirname(path), name: basename(path))
}


pub fn normpath(path: String) -> String Never! { collapse(path) }


pub fn getsize(path: String) -[FS]> Int IOError! {
    s :: core.files.stat(path)
    Ok(s.size)
}


pub fn getmtime(path: String) -[FS]> Int IOError! {
    s :: core.files.stat(path)
    Ok(s.modified_ms)
}


pub fn lexists(path: String) -[FS]> Bool Never! { exists_impl(~path) || is_symlink(~path) }


pub fn samefile(a: String, b: String) -[FS]> Bool IOError! {
    sa :: core.files.stat(a)
    sb :: core.files.stat(b)
    _ :: sa
    _ :: sb
    Err(io_err("samefile", a, "file identity requires provider inode/device support"))
}


pub fn commonprefix(paths: [String]) -> String Never! {
    if paths.len() == 0 -> return ""
    pref := ~paths[0]
    loop p in paths {
        n := pref.bytes().len()
        if p.bytes().len() < n -> n = p.bytes().len()
        i := 0
        loop i < n {
            if pref.bytes()[i] != p.bytes()[i] -> break
            i = i + 1
        }
        pref = slice_path(pref, 0, i)
    }
    pref
}


pub fn expandvars(path: String) -[Env]> String IOError! {
    raw :: (~path).bytes()
    out := ""
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{36}) {
            i = i + 1
            braced := false
            if i < raw.len() && raw[i] == (U8{123}) {
                braced = true
                i = i + 1
            }
            start := i
            loop i < raw.len() {
                n :: raw[i]
                if braced && n == 125 -> break
                letter := (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 95 || (n >= 48 && n <= 57)
                if !braced && !letter -> break
                i = i + 1
            }
            key :: slice_path(path, start, i)
            if braced && i < raw.len() && raw[i] == (U8{125}) -> i = i + 1
            val :: sys.get(key) ?? ""
            out = "{out}{val}"
            next
        }
        out = "{out}{String.from_bytes([U8]{raw[i]}) ?? ""}"
        i = i + 1
    }
    Ok(out)
}


pub fn move(from: String, to: String) IOError! -[FS]> { core.files.rename(from, to) }


pub fn rmtree(path: String) IOError! -[FS]> { core.files.remove_all(path) }


pub fn makedirs(path: String) IOError! -[FS]> { core.files.create_dir_all(path) }


pub fn listdir(path: String) -[FS]> [String] IOError! {
    entries :: core.files.list_dir(path)
    out := [String]{}
    loop e in entries -> &out.push(e.name)
    Ok(out)
}


pub fn glob_recursive(pattern: String) -[FS]> [String] IOError! { core.files.glob(pattern) }


pub fn fnmatch_filter(names: [String], pattern: String) -> [String] Never! {
    out := [String]{}
    loop n in names {
        if fnmatch(n, pattern) -> &out.push(n)
    }
    out
}


pub fn is_mount(path: String) -[FS]> Bool Never! {
    if !core.files.is_dir(~path) -> return false
    parent :: dirname(~path)
    if parent == path -> return true
    false
}


pub fn ensure_parent(path: String) IOError! -[FS]> { core.files.create_dir_all(dirname_impl(path)) }


fn slice_bytes(raw: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i < 0 || i >= raw.len() -> return ~out
        &out.push(raw[i])
        i = i + 1
    }
}


pub fn readdir(path: String) -[FS]> [DirEntry] IOError! { core.files.list_dir(path) }


pub fn walkdir(root: String, ignore: String?) -[FS]> [WalkEntry] IOError! { walk_impl(root, ignore, false) }


pub fn truncate(path: String, size: Int) IOError! -[FS]> {
    if size < 0 -> return Err(io_err("truncate", path, "negative size"))
    bytes :: core.files.read_bytes(~path)
    if size < bytes.len() {
        core.files.write_bytes(~path, slice_bytes(bytes, 0, size))
    } else {
        out := bytes
        loop out.len() < size -> &out.push(U8{0})
        core.files.write_bytes(~path, out)
    }
}


pub fn createdirectory(path: String) IOError! -[FS]> { core.files.create_dir(path) }


pub fn filesize(path: String) -[FS]> Int IOError! {
    info :: core.files.stat(path)
    Ok(info.size)
}


pub fn delete(path: String) IOError! -[FS]> { core.files.remove(path) }


pub fn cp(from: String, to: String) IOError! -[FS]> { copy2(from, to) }


pub fn rm(path: String) IOError! -[FS]> { core.files.remove(path) }


pub fn realpath(path: String) -[FS, Env]> String IOError! { core.files.canonicalize(path) }


pub fn pwd() -[FS, Env]> String IOError! { cwd() }


pub fn tmpdir(prefix: String) -[FS]> String IOError! {
    temp :: core.files.temp_dir(prefix)
    Ok(temp.path)
}


pub fn topath(path: String) -[FS, Env]> String IOError! { core.files.canonicalize(path) }


pub fn cd(path: String) IOError! -[FS, Env]> { sys.set_current_dir(path) }


