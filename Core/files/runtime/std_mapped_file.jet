//RS /// Shared low-level map entry. FSIo owns fault injection and the public Core
//RS /// projection; this function owns the deterministic IOError conversion for the
//RS /// native mapping operation.
//RS pub(crate) fn jet_std_files_map(path: &String) -> Result<JetMappedFile, IOError> {
//RS     JetMappedStorage::open(path)
//RS         .map(JetMappedFile::new)
