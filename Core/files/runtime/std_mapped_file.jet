// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/MappedFile.rs:10
fn jet_mapped_source_identity(key: String) -> String {
    digest :: jet_sha256_raw(key.as_bytes())
    identity := String.with_capacity(71)
    identity.push_str("sha256-")
    for byte in digest -> identity.push_str(format("{:02x}", byte))
    ^identity
}
