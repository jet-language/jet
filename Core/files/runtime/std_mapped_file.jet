//RS /// A private read-only mapping. The file descriptor/handle and native mapping
//RS /// are owned by an `Arc` so every returned byte view pins the storage until its
//RS /// own final drop. There is intentionally no `Clone` or mutable accessor.
//RS pub struct JetMappedFile {
//RS     storage: std::sync::Arc<JetMappedStorage>,
//RS }
