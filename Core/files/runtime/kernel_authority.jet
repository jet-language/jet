pub struct JetMappedWriterRefusal { pub path: String, pub reason: String }
// Rust: crates/jet-codegen/src/Prelude/Core/Authority.rs:50
pub fn jet_mapped_writer_refusal(path: String) -> JetMappedWriterRefusal? Never! {
