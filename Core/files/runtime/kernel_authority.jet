pub fn jet_mapped_register(key: String) Never! {
    #Unsafe("hold mapped registry mutex; recover poisoned state like the reference") {
        paths := JET_MAPPED_PATHS.lock() ?? err.into_inner()
        count :: paths.get(key) ?? USize{0}
        paths[key.to_string()] = count + USize{1}
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Authority.rs:22
pub fn jet_mapped_unregister(key: String) Never! {
    #Unsafe("hold mapped registry mutex while releasing one registered owner") {
        paths := JET_MAPPED_PATHS.lock() ?? err.into_inner()
        count :: paths.get(key) ?? return
        if count > USize{1} -> paths[key] = count - USize{1}
        else -> _ :: &paths.remove(key)
    }
}
