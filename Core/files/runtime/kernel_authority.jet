pub fn jet_mapped_path_is_live(path: String) -> Bool Never! {
    key :: jet_mapped_path_key(path)
    #Unsafe("read mapped owner count under the same shared registry mutex") {
        paths :: JET_MAPPED_PATHS.lock() ?? err.into_inner()
        (paths.get(key) ?? USize{0}) != USize{0}
    }
}
