// Rust: crates/jet-codegen/src/Prelude/Core/Authority.rs:168
fn jet_authority_covers(held: String, requested: String) -> Bool Never! {
    if held == requested -> return true
    tail := requested.strip_prefix(held) ?? return false // #4303
    tail.starts_with('.') || tail.starts_with(':') || tail.starts_with('/')
}
