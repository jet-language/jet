pub fn jet_mapped_path_key(path: String) -> String Never! {
    #Unsafe("canonicalize native path or retain lexical fallback without following a Rust runtime bridge") {
        value :: fs.canonicalize(OSPath.from(path)) ?? OSPath.from(path)
        value.to_string_lossy().to_string()
