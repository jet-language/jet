// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/PathFiles.rs:231
fn jet_path_write_atomic(p: &JetPath, content: &[U8]) -> () IOError! {
    path_s :: p.inner.to_string_lossy().to_string()
    if jet_std_files_writer_refusal(&path_s) is Val(error) -> return Err(^error)
    if jet_fault_should_fail("FS.Write") ->
        return Err(IOError.other(.Write, Val(path_s.clone()), "fault injected: FS.Write"))
    parent :: p.inner.parent().ok_or_else(fn() {
        io_error_at(.Write, &path_s, io.Error.new(.InvalidInput, "path has no parent directory"))
    })?
    // The lexical empty parent of a relative filename means the current directory.
    dir :: if parent.as_os_str().is_empty() { OSPath.from(".") } else { parent }
    // GATE #4565: kernel primitive
    existing_permissions :: #Unsafe("snapshot existing target permissions if available") {
        fs.metadata(&p.inner).ok().map(fn(metadata) { metadata.permissions() })
    }
    temp := JetAtomicTemp.create(&dir)
        .map_err(fn(error) { io_error_at(.Write, dir.to_string_lossy().to_string(), ^error) })?
    #Unsafe("write content into exclusive sibling; owner cleans up every early error") {
        temp.file_mut().write_all(content)
    }.map_err(fn(error) { io_error_at(.Write, temp.path.to_string_lossy().to_string(), ^error) })?
    if existing_permissions is Val(permissions) {
        #Unsafe("preserve target permissions on exclusively owned sibling") {
            temp.file_mut().set_permissions(^permissions)
        }.map_err(fn(error) { io_error_at(.Write, temp.path.to_string_lossy().to_string(), ^error) })?
    }
    #Unsafe("durably sync exclusive replacement content before closing descriptor") {
        temp.file_mut().sync_all()
    }.map_err(fn(error) { io_error_at(.Flush, temp.path.to_string_lossy().to_string(), ^error) })?
    temp.close()
    jet_atomic_replace(&temp.path, &p.inner).map_err(fn(error) { io_error_at(.Write, &path_s, ^error) })?
    temp.commit()
    jet_atomic_sync_parent(&dir).map_err(fn(error) { io_error_at(.Flush, &path_s, ^error) })
}
