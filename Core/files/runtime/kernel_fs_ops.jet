use Jetpack.Foundation.Source.Syntax.*
// Shared filesystem kernels; adapters own fault observation and public IOError projection.
use core.files.runtime.kernel_authority.[JetFileScope]
use Jetpack.Foundation.Source.TreeHash as tree
use core.sys.target as target
use std.fs as fs
use std.io as io

// Rust: crates/jet-codegen/src/Prelude/Core/FSOps.rs:10
pub fn jet_fs_rename(from: String, to: String) io.Error! {
    // GATE #4565: kernel primitive — native rename and exact OS errors.
    #Unsafe("rename native paths through the selected filesystem provider") { fs.rename(OSPath.from(from), OSPath.from(to)) }
}
// Rust: crates/jet-codegen/src/Prelude/Core/FSOps.rs:14
pub fn jet_fs_open(path: String) -> fs.File io.Error! {
    // GATE #4565: kernel primitive — owned native read descriptor.
    #Unsafe("open a real read descriptor; caller owns its close") { fs.File.open(OSPath.from(path)) }
}
// Rust: crates/jet-codegen/src/Prelude/Core/FSOps.rs:18
pub fn jet_fs_canonicalize(path: String) -> String io.Error! {
    // GATE #4565: kernel primitive — selected provider canonicalization.
    resolved :: #Unsafe("canonicalize path while preserving the native IO error") { fs.canonicalize(OSPath.from(path)) } ?? return Err(err)
    Ok(resolved.to_string_lossy().to_string())
}
// Rust: crates/jet-codegen/src/Prelude/Core/FSOps.rs:28
pub fn jet_fs_scope_read(scope: JetFileScope, path: String) -> [U8] io.Error! {
    requested :: OSPath.from(path)
    last_error := None
    loop root in scope.roots() {
        relative :: if requested.is_absolute() {
            if not root.allow_absolute() -> continue
            stripped :: requested.strip_prefix(root.path()) ?? continue
            jet_fs_scope_relative(stripped) ?? return Err(err)
        } else -> jet_fs_scope_relative(requested) ?? return Err(err)
        // The canonical retained descriptor-relative reader owns every no-follow
        // open; lexical strip_prefix above is not a security boundary.
        if tree.foundation_read_file_nofollow_at_root(root.path().to_string_lossy().to_string(), relative.to_string_lossy().to_string(), @MAX_TREE_FILE_BYTES) == {
            Ok(bytes) -> return Ok(bytes)
            Err(error) -> last_error = Val(error)
        }
    }
    Err(last_error ?? jet_fs_scope_denied())
}
// Rust: crates/jet-codegen/src/Prelude/Core/FSOps.rs:58
fn jet_fs_scope_relative(path: OSPath) -> OSPath io.Error! {
    relative := OSPath.new()
    has_component := false
    loop component in path.components() {
        if component == {
            .Normal(name) -> { &relative.push(name); has_component = true }
            .CurDir -> {}
            .ParentDir | .RootDir | .Prefix(_) -> return Err(jet_fs_scope_denied())
        }
    }
    if not has_component -> return Err(jet_fs_scope_denied())
    Ok(relative)
}
// Rust: crates/jet-codegen/src/Prelude/Core/FSOps.rs:79
fn jet_fs_scope_denied() -> io.Error Never! {
    io.Error.new(.PermissionDenied, "path is outside the granted FS.Read root")
}
// Rust: crates/jet-codegen/src/Prelude/Core/FSOps.rs:86
pub fn jet_fs_glob(pattern: String) -> [String] io.Error! {
    split :: pattern.find(['*', '?']) ?? pattern.len()
    prefix := pattern.slice(0, split) // #4303
    // GATE #4483: selected-target MAIN_SEPARATOR, not the build host's separator.
    separator :: if target.selected_family() == "windows" -> '\\' else -> '/'
    base :: if prefix.rsplit_once(separator) == {
        Val((directory, _)) -> if directory.is_empty() -> "." else -> directory.to_string()
        None -> "."
    }
    matches := [String]{}
    collect_glob_entries(OSPath.from(base), &matches) ?? return Err(err)
    &matches.retain(fn(path) { jet_fs_glob_match(pattern, path) })
    &matches.sort()
    Ok(matches)
}
// Rust: crates/jet-codegen/src/Prelude/Core/FSOps.rs:99
fn collect_glob_entries(root: OSPath, output: &[String]) io.Error! {
    // GATE #4565: kernel primitive — real directory enumeration, metadata and native names.
    entries := #Unsafe("enumerate the real directory without changing native error precedence") {
        fs.read_dir(root) ?? return Err(err)
    }.collect_results() ?? return Err(err)
    &entries.sort_by_key(fn(entry) { entry.file_name() })
    loop entry in entries {
        path :: entry.path()
        &output.push(path.to_string_lossy().to_string())
        kind :: entry.file_type() ?? return Err(err)
        if kind.is_dir() -> collect_glob_entries(path, &output) ?? return Err(err)
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/Core/FSOps.rs:112
pub fn jet_fs_glob_match(pattern: String, text: String) -> Bool Never! {
    // Rust: crates/jet-codegen/src/Prelude/Core/FSOps.rs:113
    fn inner(pattern: View<U8>, text: View<U8>, p: Int, t: Int) -> Bool Never! {
        if p == pattern.len() -> return t == text.len()
        if pattern[p] == {
            U8{42} -> inner(pattern, text, p + 1, t) || (t < text.len() && inner(pattern, text, p, t + 1))
            U8{63} -> t < text.len() && inner(pattern, text, p + 1, t + 1)
            character -> t < text.len() && character == text[t] && inner(pattern, text, p + 1, t + 1)
        }
    }
    inner(pattern.bytes(), text.bytes(), 0, 0)
}
