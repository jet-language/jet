// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSRuntimeOps.rs:106
fn jet_std_fs_temp_path(prefix: &String) -> String {
    clean :: prefix.chars().map(fn(character) {
        if character.is_ascii_alphanumeric() { character } else { '_' }
    }).collect<String>()
    // GATE #4565: kernel primitive
    #Unsafe("read native time, process identity and selected-provider temp directory for source temporary naming") {
        nanos :: SystemTime.now().duration_since(UNIX_EPOCH).map(fn(duration) { duration.as_nanos() }).unwrap_or(0)
        process_id :: std.process.id()
        std.env.temp_dir().join("{clean}_{process_id}_{nanos}").to_string_lossy().to_string()
    }
}
