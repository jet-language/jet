// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSRuntimeOps.rs:305
pub fn jet_std_fs_chown(path: &String, owner: I64, group: I64) -> () IOError! {
    if target.selected_family() != "unix" ->
        return Err(IOError.other(.Write, None, "chown is unavailable on this platform"))
    owner :: if owner == -1 { U32.MAX } else {
        U32.try_from(owner).map_err(fn(_) { IOError.other(.Write, Val(path.clone()), "owner must be -1 or a non-negative u32") })?
    }
    group :: if group == -1 { U32.MAX } else {
        U32.try_from(group).map_err(fn(_) { IOError.other(.Write, Val(path.clone()), "group must be -1 or a non-negative u32") })?
    }
    c_path :: CString.new(path.as_bytes()).map_err(fn(_) {
        IOError.other(.Write, Val(path.clone()), "path contains an interior NUL")
    })?
    // GATE #4565: kernel primitive
    if #Unsafe("validated U32 IDs or -1 sentinels and NUL-free native path precede POSIX chown") {
        chown(c_path.as_ptr(), owner, group)
    } == 0 { Ok(()) } else {
        Err(io_error_at(.Write, path, #Unsafe("capture POSIX errno immediately after failed chown") { io.Error.last_os_error() }))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSRuntimeOps.rs:366
pub fn jet_std_fs_set_mode(path: &String, mode: I64) -> () IOError! {
    if jet_fault_should_fail("FS.Write") ->
        return Err(IOError.other(.Write, Val(path.clone()), "fault injected: FS.Write"))
    // GATE #4565: kernel primitive
    if target.selected_family() == "unix" {
        if mode < 0 or mode > U32.MAX as I64 ->
            return Err(IOError.other(.Write, Val(path.clone()), "file mode must be between 0 and u32::MAX"))
        permissions :: #Unsafe("construct selected Unix native mode bits after checked U32 range") { fs.Permissions.from_mode(mode as U32) }
        return #Unsafe("set actual native file permissions") { fs.set_permissions(OSPath.from(path), ^permissions) }
            .map_err(fn(error) { io_error_at(.Write, path, ^error) })
    }
    if mode != 0 and mode != 1 ->
        return Err(IOError.other(.Write, Val(path.clone()), "file mode must contain only the readonly bit on this platform"))
    permissions := #Unsafe("query native permissions for selected non-Unix readonly bit update") { fs.metadata(OSPath.from(path)) }
        .map_err(fn(error) { io_error_at(.Write, path, ^error) })?.permissions()
    permissions.set_readonly(mode == 1)
    #Unsafe("set actual native readonly permissions") { fs.set_permissions(OSPath.from(path), ^permissions) }
        .map_err(fn(error) { io_error_at(.Write, path, ^error) })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSRuntimeOps.rs:405
pub fn jet_std_fs_symlink(from: &String, to: &String) -> () IOError! {
    if jet_fault_should_fail("FS.Write") ->
        return Err(IOError.other(.Write, Val(to.clone()), "fault injected: FS.Write"))
    // GATE #4565: kernel primitive
    if target.selected_family() == "unix" {
        return #Unsafe("create real selected Unix symbolic link") { unix_fs.symlink(OSPath.from(from), OSPath.from(to)) }
            .map_err(fn(e) { io_error_at(.Write, to, ^e) })
    }
    if target.selected_os() == .Windows {
        meta :: #Unsafe("query actual source type for Windows file/directory symbolic link choice") { fs.metadata(OSPath.from(from)) }
            .map_err(fn(e) { io_error_at(.Read, from, ^e) })?
        if meta.is_dir() {
            return #Unsafe("create real selected Windows directory symbolic link") { windows_fs.symlink_dir(OSPath.from(from), OSPath.from(to)) }
                .map_err(fn(e) { io_error_at(.Write, to, ^e) })
        }
        return #Unsafe("create real selected Windows file symbolic link") { windows_fs.symlink_file(OSPath.from(from), OSPath.from(to)) }
            .map_err(fn(e) { io_error_at(.Write, to, ^e) })
    }
    Err(IOError.other(.Write, Val(to.clone()), "symbolic links are unavailable on this platform"))
}
