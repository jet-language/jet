// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSRuntimeOps.rs:247
pub struct JetFsStat {
    pub size: I64, pub modified_ms: I64, pub created_ms: I64, pub readonly: Bool,
    pub is_file: Bool, pub is_dir: Bool, pub is_symlink: Bool, pub kind: String, pub mode: I64,
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSRuntimeOps.rs:259
pub fn jet_fs_stat(path: &String) -> JetFsStat IOError! {
    if jet_fault_should_fail("FS.Read") ->
        return Err(IOError.other(.Read, Val(path.clone()), "fault injected: FS.Read"))
    // GATE #4565: kernel primitive
    meta :: #Unsafe("query actual lstat-style metadata without following symbolic links") { fs.symlink_metadata(OSPath.from(path)) }
        .map_err(fn(e) { io_error_at(.Read, path, ^e) })?
    ft :: meta.file_type()
    modified_ms :: meta.modified().ok().and_then(system_time_ms).unwrap_or(0)
    created_ms :: meta.created().ok().and_then(system_time_ms).unwrap_or(0)
    kind :: if ft.is_symlink() { "symlink" } else if ft.is_dir() { "dir" } else if ft.is_file() { "file" } else { "other" }
    Ok(JetFsStat {
        size: meta.len() as I64, modified_ms, created_ms, readonly: meta.permissions().readonly(),
        is_file: ft.is_file(), is_dir: ft.is_dir(), is_symlink: ft.is_symlink(), kind, mode: mode_of(&meta),
    })
}
