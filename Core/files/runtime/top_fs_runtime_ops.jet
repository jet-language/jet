// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSRuntimeOps.rs:38
pub fn jet_std_fs_scope_read(scope: &JetFileScope, path: &String) -> String IOError! {
    if jet_fault_should_fail("FS.Read") ->
        return Err(IOError.other(.Read, Val(path.clone()), "fault injected: FS.Read"))
    bytes :: jet_fs_scope_read(scope, path).map_err(fn(error) { io_error_at(.Read, path, ^error) })?
    // #4409: invalid UTF-8 retains the canonical source InvalidData error projection.
    String.from_utf8(^bytes).map_err(fn(error) {
        io_error_at(.Read, path, io.Error.new(.InvalidData, ^error))
    })
}
