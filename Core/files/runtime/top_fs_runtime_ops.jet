pub fn jet_std_fs_absolute(path: &String) -> String IOError! {
    p :: OSPath.from(path)
    abs :: if p.is_absolute() { p.to_path_buf() } else {
        // GATE #4565: kernel primitive
        #Unsafe("query actual native cwd for lexical absolute resolution") { std.env.current_dir() }
            .map_err(fn(e) { IOError.other(.Resolve, None, ^e) })?.join(p)
    }
