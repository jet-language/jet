// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSRuntimeOps.rs:448
fn mode_of(meta: &fs.Metadata) -> I64 {
    if target.selected_family() == "unix" {
        // GATE #4565: kernel primitive — selected Unix metadata layout.
        return #Unsafe("read native metadata mode including file kind bits") { meta.mode() as I64 }
    }
    // Non-Unix has no portable mode bits: preserve readonly as 0/1.
    I64.from(U8.from(meta.permissions().readonly()))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSRuntimeOps.rs:452
pub fn jet_std_fs_read_at(path: &String, offset: I64, len: I64) -> [U8] IOError! {
    if jet_fault_should_fail("FS.Read") ->
        return Err(IOError.other(.Read, Val(path.clone()), "fault injected: FS.Read"))
    // GATE #4565: kernel primitive
    f := #Unsafe("open real native file for source single-read positional operation") { fs.File.open(OSPath.from(path)) }
        .map_err(fn(e) { io_error_at(.Read, path, ^e) })?
    #Unsafe("seek owned native descriptor to clamped source offset") { f.seek(SeekFrom.Start(offset.max(0) as U64)) }
        .map_err(fn(e) { io_error_at(.Read, path, ^e) })?
    buf := [U8].repeat(U8{0}, len.max(0) as USize)
    n :: #Unsafe("read once into initialized exclusive buffer, preserving partial-read result") { f.read(&buf) }
        .map_err(fn(e) { io_error_at(.Read, path, ^e) })?
    buf.truncate(n)
    Ok(^buf)
}
