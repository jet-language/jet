// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSWriteOps.rs:1
// Shared filesystem write/fault policy; native paths remain OSPath at the kernel boundary.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSWriteOps.rs:5
pub fn jet_std_fs_write_bytes(path: &String, bytes: &[U8]) -> () IOError! {
    if jet_std_files_writer_refusal(path) is Val(error) -> return Err(^error)
    if jet_fault_should_fail("FS.Write") ->
        return Err(IOError.other(.Write, Val(path.clone()), "fault injected: FS.Write"))
    // GATE #4565: kernel primitive
    #Unsafe("write borrowed initialized bytes to the selected native filesystem path") {
        fs.write(OSPath.from(path), bytes)
    }.map_err(fn(error) { io_error_at(.Write, path, ^error) })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSWriteOps.rs:23
pub fn jet_std_fs_write_at(path: &String, offset: I64, bytes: &[U8]) -> () IOError! {
    if jet_std_files_writer_refusal(path) is Val(error) -> return Err(^error)
    if jet_fault_should_fail("FS.Write") ->
        return Err(IOError.other(.Write, Val(path.clone()), "fault injected: FS.Write"))
    // GATE #4565: kernel primitive
    file := #Unsafe("open/create writable file without truncation for positional write") {
        fs.OpenOptions.new().create(true).write(true).open(OSPath.from(path))
    }.map_err(fn(error) { io_error_at(.Write, path, ^error) })?
    #Unsafe("seek owned native descriptor to clamped non-negative source offset") {
        file.seek(SeekFrom.Start(offset.max(0) as U64))
    }.map_err(fn(error) { io_error_at(.Write, path, ^error) })?
    #Unsafe("complete native write from borrowed initialized input bytes") {
        file.write_all(bytes)
    }.map_err(fn(error) { io_error_at(.Write, path, ^error) })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSWriteOps.rs:50
pub fn jet_std_fs_write_atomic(path: &String, bytes: &[U8]) -> () IOError! {
    if jet_std_files_writer_refusal(path) is Val(error) -> return Err(^error)
    if jet_fault_should_fail("FS.Write") ->
        return Err(IOError.other(.Write, Val(path.clone()), "fault injected: FS.Write"))
    target_path :: OSPath.from(path)
    parent :: target_path.parent().unwrap_or_else(fn() { OSPath.from(".") })
    temp_path := None
    temp_file := None
    // GATE #4565: kernel primitive
    for sequence in U64{0}..U64{128} {
        process_id :: #Unsafe("read native process identity for create-new atomic sibling naming") { std.process.id() }
        candidate :: parent.join(".jet_tmp_{process_id}_{sequence}")
        match #Unsafe("create-new reserves one real sibling file exclusively without overwriting another writer") {
            fs.OpenOptions.new().create_new(true).write(true).open(&candidate)
        } {
            Ok(file) -> { temp_path = Val(^candidate); temp_file = Val(^file); break }
            Err(error) -> {
                if error.kind() == .AlreadyExists -> continue
                return Err(io_error_at(.Write, path, ^error))
            }
        }
    }
    temp_path :: temp_path ?? return Err(IOError.other(.Write, Val(path.clone()), "could not reserve an atomic-write temporary file"))
    temp_file := temp_file.expect("atomic temporary file must exist")
    existing_permissions :: #Unsafe("snapshot target permissions if the target exists") {
        fs.metadata(&target_path).ok().map(fn(m) { m.permissions() })
    }
    match #Unsafe("write all content to the exclusively owned atomic sibling") { temp_file.write_all(bytes) } {
        Err(error) -> {
            #Unsafe("best-effort removal of our reserved sibling after failed write") { _ :: fs.remove_file(&temp_path) }
            return Err(io_error_at(.Write, temp_path.to_string_lossy().to_string(), ^error))
        }
        Ok(_) -> {}
    }
    if existing_permissions is Val(permissions) {
        match #Unsafe("preserve target permissions on the atomic replacement sibling") { temp_file.set_permissions(^permissions) } {
            Err(error) -> {
                #Unsafe("best-effort removal of our reserved sibling after permission failure") { _ :: fs.remove_file(&temp_path) }
                return Err(io_error_at(.Write, temp_path.to_string_lossy().to_string(), ^error))
            }
            Ok(_) -> {}
        }
    }
    match #Unsafe("flush native file content and metadata before renaming replacement") { temp_file.sync_all() } {
        Err(error) -> {
            #Unsafe("best-effort removal of our reserved sibling after sync failure") { _ :: fs.remove_file(&temp_path) }
            return Err(io_error_at(.Flush, temp_path.to_string_lossy().to_string(), ^error))
        }
        Ok(_) -> {}
    }
    drop(^temp_file)
    match #Unsafe("atomically rename the owned flushed sibling over target") { fs.rename(&temp_path, &target_path) } {
        Err(error) -> {
            #Unsafe("best-effort removal of our reserved sibling after rename failure") { _ :: fs.remove_file(&temp_path) }
            return Err(io_error_at(.Write, path, ^error))
        }
        Ok(_) -> {}
    }
    if target.selected_family() == "unix" {
        #Unsafe("sync parent directory after replacement on selected Unix targets") {
            fs.File.open(parent).and_then(fn(dir) { dir.sync_all() })
        }.map_err(fn(error) { io_error_at(.Flush, path, ^error) })?
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSWriteOps.rs:143
pub fn jet_std_io_binwrite(path: &String, bytes: &[U8]) -> () IOError! {
    jet_std_fs_write_bytes(path, bytes)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSWriteOps.rs:150
pub fn jet_std_io_buffered() -> JetStdinReader { jet_std_io_stdin() }

