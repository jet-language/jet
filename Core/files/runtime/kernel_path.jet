// Rust: crates/jet-codegen/src/Prelude/Core/Path.rs:3
fn jet_std_path_lexical_source(path: String) -> String Never! {
    // A read return shares the unchanged String owner (Rust Cow::Borrowed).
    if path.contains('\\') -> path.replace('\\', "/") else -> path
}
