// Identical ancestor/symlink/NotADirectory policy uses that existing owner;
// callers import it directly, no alternate validator or compatibility wrapper.
// Rust: crates/jet-codegen/src/Prelude/Core/Path.rs:173
pub fn jet_std_path_walk(path: String) -> [String] Never! {
    root :: OSPath.from(path)
    if jet_fs_validate_walk_root(root) is Err(_) -> return []
    result := [String]{}
    stack := [root]
    visited := [OSPath:Bool]{} // GATE #4499: native OSPath key identity, never string encoding.
    // GATE #4565: kernel primitive — native canonicalization and directory stream.
    #Unsafe("enumerate native directories while suppressing only the reference's best-effort errors") {
        loop stack.pop() is Val(directory) {
            if jet_fs_validate_walk_root(directory) is Err(_) -> continue
            canonical :: fs.canonicalize(directory) ?? continue
            if visited.contains_key(canonical) -> continue
            visited[^canonical] = true
            entries :: fs.read_dir(directory) ?? continue
            loop entry_result in entries {
                entry :: entry_result ?? continue
                path :: entry.path()
                &result.push(path.to_string_lossy().to_string())
                if entry.file_type() is Ok(kind) -> if kind.is_dir() -> &stack.push(^path)
            }
        }
    }
    result
}
