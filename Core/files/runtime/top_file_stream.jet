// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FileStream.rs:1
// Shared streaming policy; buffers retain native descriptors and classify errors once.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FileStream.rs:8
pub fn jet_std_files_open(path: &String) -> JetFileReader IOError! {
    if jet_fault_should_fail("FS.Read") ->
        return Err(IOError.other(.Read, Val(path.clone()), "fault injected: FS.Read"))
    file :: jet_fs_open(path).map_err(fn(error) { io_error_at(.Read, path, ^error) })?
    Ok(JetFileReader { inner: BufReader.new(^file), path: path.clone() })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FileStream.rs:24
pub fn jet_std_files_create(path: &String) -> JetFileWriter IOError! {
    if jet_fault_should_fail("FS.Write") ->
        return Err(IOError.other(.Write, Val(path.clone()), "fault injected: FS.Write"))
    if jet_std_files_writer_refusal(path) is Val(error) -> return Err(^error)
    // GATE #4565: kernel primitive
    file :: #Unsafe("create/truncate native file only after injected fault and mapped-writer refusal checks") {
        fs.File.create(OSPath.from(path))
    }.map_err(fn(error) { io_error_at(.Write, path, ^error) })?
    Ok(JetFileWriter { inner: BufWriter.new(^file), path: path.clone() })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FileStream.rs:43
pub fn jet_std_files_append(path: &String) -> JetFileWriter IOError! {
    if jet_fault_should_fail("FS.Write") ->
        return Err(IOError.other(.Write, Val(path.clone()), "fault injected: FS.Write"))
    if jet_std_files_writer_refusal(path) is Val(error) -> return Err(^error)
    // GATE #4565: kernel primitive
    file :: #Unsafe("open/create append-only native file after shared fault/refusal policy") {
        fs.OpenOptions.new().create(true).append(true).open(OSPath.from(path))
    }.map_err(fn(error) { io_error_at(.Write, path, ^error) })?
    Ok(JetFileWriter { inner: BufWriter.new(^file), path: path.clone() })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FileStream.rs:65
pub fn jet_std_file_reader_path(reader: &JetFileReader) -> String { reader.path.clone() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FileStream.rs:69
pub fn jet_std_file_reader_read_line(reader: &JetFileReader) -> String? IOError! {
    if jet_fault_should_fail("FS.Read") ->
        return Err(IOError.other(.Read, Val(reader.path.clone()), "fault injected: FS.Read"))
    line := String.new()
    // GATE #4565: kernel primitive
    match #Unsafe("pull one line from the retained buffered native file descriptor") { reader.inner.read_line(&line) } {
        Ok(0) -> Ok(None)
        Ok(_) -> {
            loop {
                if not line.ends_with('\n') and not line.ends_with('\r') -> break
                _ :: line.pop()
            }
            Ok(Val(^line))
        }
        Err(error) -> Err(io_error_at(.Read, &reader.path, ^error))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FileStream.rs:98
pub fn jet_std_file_writer_write_line(writer: &JetFileWriter, line: &String) -> () IOError! {
    if jet_fault_should_fail("FS.Write") ->
        return Err(IOError.other(.Write, Val(writer.path.clone()), "fault injected: FS.Write"))
    // GATE #4565: kernel primitive
    #Unsafe("write borrowed line bytes then exactly one LF through retained buffered native writer") {
        writer.inner.write_all(line.as_bytes()).and_then(fn(_) { writer.inner.write_all(&[U8{10}]) })
    }.map_err(fn(error) { io_error_at(.Write, &writer.path, ^error) })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FileStream.rs:120
pub fn jet_std_file_writer_flush(writer: &JetFileWriter) -> () IOError! {
    if jet_fault_should_fail("FS.Write") ->
        return Err(IOError.other(.Write, Val(writer.path.clone()), "fault injected: FS.Write"))
    // GATE #4565: kernel primitive
    #Unsafe("flush retained buffered file writer and project actual native flush errors") {
        writer.inner.flush()
    }.map_err(fn(error) { io_error_at(.Flush, &writer.path, ^error) })
}
