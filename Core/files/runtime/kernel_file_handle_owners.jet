// Rust: crates/jet-codegen/src/Prelude/Core/FileHandleOwners.rs:19
fn jet_fs_drop_owned_path(path: OSPath, cleanup: Rc<Unit>, is_dir: Bool) Never! {
    // GATE #4565: kernel primitive — last-owner detection and best-effort native deletion.
    #Unsafe("only the last shared cleanup owner removes the native path") {
        if Rc.strong_count(cleanup) == 1 {
            if is_dir -> _ :: fs.remove_dir_all(path)
            else -> _ :: fs.remove_file(path)
        }
    }
}
impl Drop for JetTempDirOwner {
    // Rust: crates/jet-codegen/src/Prelude/Core/FileHandleOwners.rs:30
    fn drop(self: &JetTempDirOwner) Never! { jet_fs_drop_owned_path(self.path, self.cleanup, true) }
}
impl Drop for JetTempFileOwner {
    // Rust: crates/jet-codegen/src/Prelude/Core/FileHandleOwners.rs:36
    fn drop(self: &JetTempFileOwner) Never! { jet_fs_drop_owned_path(self.path, self.cleanup, false) }
}
impl Drop for JetFileLockOwner {
    // Rust: crates/jet-codegen/src/Prelude/Core/FileHandleOwners.rs:42
    fn drop(self: &JetFileLockOwner) Never! { jet_fs_drop_owned_path(self.path, self.cleanup, false) }
