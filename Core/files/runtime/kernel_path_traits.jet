use core.files.runtime.kernel_path_components as path_value
use core.collections.runtime.kernel_siphash13 as path_sip

// Rust 8bab26f4f68e0e26f0bb7960be334d5b520ea452 std/path.rs Path/PathBuf
// Eq/Ord/Hash, Prefix's derived Ord/Hash, ffi/os_str.rs encoded-byte laws.
// No second component scanner/value/equality engine. Native ingress chooses
// exactly one platform (#4494); a mixed-platform private carrier has NO Rust
// comparison law. #4483 selects machine facts; #4499 owns user-key admission.
pub fn equal(left: path_value.OSPath, right: path_value.OSPath) -> Bool Never! {
    path_value.equals(left, right)
}
fn compare_bytes(left: path_value.OSPath, a: path_value.PathSpan, right: path_value.OSPath, b: path_value.PathSpan) -> Ordering Never! {
    size :: min(a.end - a.start, b.end - b.start)
    loop at in 0..<size {
        x :: left.encoded[a.start + at]
        y :: right.encoded[b.start + at]
        if x < y -> return Ordering.Less
        if x > y -> return Ordering.Greater
    }
    if a.end - a.start < b.end - b.start -> return Ordering.Less
    if a.end - a.start > b.end - b.start -> return Ordering.Greater
    Ordering.Equal
}
// Derived enum order, NOT the internal parser's PrefixKind declaration order.
fn prefix_rank(prefix: path_value.PathPrefix) -> Int Never! {
    if prefix.kind == path_value.PrefixKind.Verbatim -> return 0
    if prefix.kind == path_value.PrefixKind.VerbatimUNC -> return 1
    if prefix.kind == path_value.PrefixKind.VerbatimDisk -> return 2
    if prefix.kind == path_value.PrefixKind.DeviceNS -> return 3
    if prefix.kind == path_value.PrefixKind.UNC -> return 4
    assert(prefix.kind == path_value.PrefixKind.Disk)
    5
}
fn component_rank(component: path_value.PathComponent) -> Int Never! {
    if component.kind == path_value.ComponentKind.Prefix -> return 0
    if component.kind == path_value.ComponentKind.RootDir -> return 1
    if component.kind == path_value.ComponentKind.CurDir -> return 2
    if component.kind == path_value.ComponentKind.ParentDir -> return 3
    4
}
fn compare_prefix(left: path_value.OSPath, p: path_value.PathPrefix, right: path_value.OSPath, q: path_value.PathPrefix) -> Ordering Never! {
    a :: prefix_rank(p)
    b :: prefix_rank(q)
    if a < b -> return Ordering.Less
    if a > b -> return Ordering.Greater
    if p.kind == path_value.PrefixKind.Disk || p.kind == path_value.PrefixKind.VerbatimDisk {
        if p.drive < q.drive -> return Ordering.Less
        if p.drive > q.drive -> return Ordering.Greater
        return Ordering.Equal
    }
    first :: compare_bytes(left, p.first, right, q.first)
    if first != Ordering.Equal -> return first
    if p.kind == path_value.PrefixKind.UNC || p.kind == path_value.PrefixKind.VerbatimUNC {
        return compare_bytes(left, p.second, right, q.second)
    }
    Ordering.Equal
}
fn compare_component(left: path_value.OSPath, a: path_value.PathComponent, right: path_value.OSPath, b: path_value.PathComponent) -> Ordering Never! {
    x :: component_rank(a)
    y :: component_rank(b)
    if x < y -> return Ordering.Less
    if x > y -> return Ordering.Greater
    if a.kind == path_value.ComponentKind.Prefix {
        return compare_prefix(left, path_value.parse_prefix_span(left, a.span), right, path_value.parse_prefix_span(right, b.span))
    }
    if a.kind == path_value.ComponentKind.Normal -> return compare_bytes(left, a.span, right, b.span)
    Ordering.Equal
}
// compare_components: raw-byte shared-prefix fast path and Iterator::cmp.
pub fn compare(left: path_value.OSPath, right: path_value.OSPath) -> Ordering Never! {
    assert(left.platform == right.platform)
    a := path_value.components(left)
    b := path_value.components(right)
    if a.prefix.len == 0 && b.prefix.len == 0 {
        common := 0
        size :: min(left.encoded.len(), right.encoded.len())
        loop common < size && left.encoded[common] == right.encoded[common] -> common += 1
        if common == left.encoded.len() && common == right.encoded.len() -> return Ordering.Equal
        at := common
        loop at > 0 {
            at -= 1
            if path_value.is_separator(left.platform, left.encoded[at], false) {
                a.start = at + 1
                b.start = at + 1
                a.front = 2
                b.front = 2
                break
            }
        }
    }
    loop {
        x :: path_value.next(left, &a)
        y :: path_value.next(right, &b)
        if x == .Val(first) {
            second :: y ?? return Ordering.Greater
            order :: compare_component(left, first, right, second)
            if order != Ordering.Equal -> return order
        } else {
            if y == None -> return Ordering.Equal
            return Ordering.Less
        }
    }
}
// OsStr::hash -> [u8]::hash -> write_length_prefix(usize) + raw byte slice.
fn hash_os_span(state: &path_sip.SipHasher13, path: path_value.OSPath, extent: path_value.PathSpan) Never! {
    path_sip.write_usize(&state, U64{extent.end - extent.start})
    path_sip.write_span(&state, path.encoded, extent.start, extent.end)
}
fn hash_prefix(state: &path_sip.SipHasher13, path: path_value.OSPath, prefix: path_value.PathPrefix) Never! {
    // Rust derive hashes mem::discriminant via isize/native-endian usize.
    path_sip.write_usize(&state, U64{prefix_rank(prefix)})
    if prefix.kind == path_value.PrefixKind.Disk || prefix.kind == path_value.PrefixKind.VerbatimDisk {
        path_sip.write_u8(&state, prefix.drive)
        return
    }
    hash_os_span(&state, path, prefix.first)
    if prefix.kind == path_value.PrefixKind.UNC || prefix.kind == path_value.PrefixKind.VerbatimUNC {
        hash_os_span(&state, path, prefix.second)
    }
}
fn chunk_next(bits: U64, size: Int, machine: path_sip.HashMachine) -> U64 Never! {
    if path_sip.machine_is_32(machine) {
        sum :: bits.wrapping_add(U64{size}) & U64{0xffffffff}
        return (sum >> 2) | ((sum & U64{3}) << 30)
    }
    bits.wrapping_add(U64{size}).rotate_right(2)
}
// Path::hash: EXACT source byte-scan framing (not component Vec hashing).
// Root/CurDir may collide naturally; the hash is never an identity/equality.
pub fn hash_into(path: path_value.OSPath, state: &path_sip.SipHasher13) Never! {
    prefix :: path_value.parse_prefix(path)
    if prefix.len > 0 -> hash_prefix(&state, path, prefix)
    verbatim :: path_value.prefix_verbatim(prefix)
    component_start := prefix.len
    bits := U64{0}
    loop at in prefix.len..<path.encoded.len() {
        if path_value.is_separator(path.platform, path.encoded[at], verbatim) {
            if at > component_start {
                bits = chunk_next(bits, at - component_start, state.machine)
                path_sip.write_span(&state, path.encoded, component_start, at)
            }
            component_start = at + 1
            if !verbatim && component_start < path.encoded.len() && path.encoded[component_start] == (U8{46}) {
                if component_start + 1 == path.encoded.len() {
                    component_start += 1
                } else {
                    if path_value.is_separator(path.platform, path.encoded[component_start + 1], false) -> component_start += 1
                }
            }
        }
    }
    if component_start < path.encoded.len() {
        bits = chunk_next(bits, path.encoded.len() - component_start, state.machine)
        path_sip.write_span(&state, path.encoded, component_start, path.encoded.len())
    }
    path_sip.write_usize(&state, bits)
}
// CT01 Other identity consumes this after CLI-owned canonicalize; no CLI hash.
// Explicit facts only: this function does not guess/activate selected target.
pub fn default_hash(path: path_value.OSPath, machine: path_sip.HashMachine, checked_length: Bool) -> U64 Never! {
    state := path_sip.new_with_machine(U64{0}, U64{0}, machine, checked_length)
    hash_into(path, &state)
    path_sip.finish(state)
}
