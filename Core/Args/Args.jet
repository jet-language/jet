package {
    name: "core.args"
    version: "0.0.1"
    edition: "2026"
    description: "Command-line specs and configuration merge."
    license: "MIT"
    outputs: {
        args: .Library{ entry: args }
    }
}
use core :: core


// core.args — argv decoding against a declarative spec.
//
// `ArgsSpec` and typed `decode`/`merge` use the one checked native contract.
// Source helpers below inspect untyped argv trees; the `__cli_*` helpers at
// the end parse argv for the compiler-generated typed `#CLI` entry.
fn slice_str(text: String, start: Int, end: Int) -> String {
    raw :: text.bytes()
    s :: if start < 0 -> 0 else -> start
    e :: if end > raw.len() -> raw.len() else -> end
    if e < s -> return ""
    String.from_bytes(raw.slice(s, e)) ?? ""
}

fn drop_prefix(text: String, count: Int) -> String {
    slice_str(text, count, text.bytes().len())
}



fn decode_argv(argv: [String]) -> Dyn Never! {
    // Options keep their argv order.
    entries := [(key: String, value: Dyn)]{}
    positionals := [Dyn]{}
    i := 0
    // Skip argv[0] (program name) when present.
    if argv.len() > 0 -> i = 1
    loop {
        if i >= argv.len() -> break
        a :: argv[i]
        if a == "--" {
            i = i + 1
            loop {
                if i >= argv.len() -> break
                &positionals.push(Dyn.Text(argv[i].copy()))
                i = i + 1
            }
            break
        }
        if starts(a, "--") && a.bytes().len() > 2 {
            rest :: drop_prefix(a, 2)
            eq :: index_of(rest, "=")
            if eq >= 0 {
                key :: slice_str(rest, 0, eq)
                val :: slice_str(rest, eq + 1, rest.bytes().len())
                put_entry(&entries, key, parse_atom(val))
                i = i + 1
                next
            }
            if starts(rest, "no-") && rest.bytes().len() > 3 {
                put_entry(&entries, drop_prefix(rest, 3), Dyn.Bool(false))
                i = i + 1
                next
            }
            // A following negative number is a value, not another option.
            if i + 1 < argv.len() && argv[i + 1] != "--" && (!starts(argv[i + 1], "-") || negative_number(argv[i + 1])) {
                put_entry(&entries, rest, parse_atom(argv[i + 1]))
                i = i + 2
                next
            }
            put_entry(&entries, rest, Dyn.Bool(true))
            i = i + 1
            next
        }
        if a == "-h" {
            put_entry(&entries, "help", Dyn.Bool(true))
            put_entry(&entries, "h", Dyn.Bool(true))
            i = i + 1
            next
        }
        if starts(a, "-") && a.bytes().len() > 1 {
            // Clustered short flags: -abc. Repeated flags become counts.
            raw :: a.bytes()
            loop k in 1..<raw.len() {
                ch :: String.from_bytes([U8]{raw[k]}) ?? ""
                put_entry(&entries, ch, Dyn.Bool(true))
                if ch == "h" -> put_entry(&entries, "help", Dyn.Bool(true))
            }
            i = i + 1
            next
        }
        &positionals.push(Dyn.Text(a.copy()))
        i = i + 1
    }
    if argv.len() > 0 -> put_entry(&entries, "0", Dyn.Text(argv[0].copy()))
    &entries.push((key: "_", value: Dyn.Array(positionals)))
    Dyn.Object(entries)
}



fn parse_atom(text: String) -> Dyn {
    if text == {
        "true" -> return Dyn.Bool(true)
        "false" -> return Dyn.Bool(false)
        "null" -> return Dyn.Null
        else -> { _ := 0 }
    }
    n := 0
    sign := 1
    i := 0
    raw :: text.bytes()
    if raw.len() > 0 && raw[0] == (U8{45}) {
        sign = -1
        i = 1
    }
    if i >= raw.len() -> Dyn.Text(text.copy())
    loop {
        if i >= raw.len() -> return Dyn.Int(sign * n)
        d :: raw[i]
        if d < 48 || d > 57 -> return Dyn.Text(text.copy())
        n = n * 10 + (d - 48)
        i = i + 1
    }
}
fn negative_number(text: String) -> Bool {
    raw :: text.bytes()
    if raw.len() < 2 || raw[0] != (U8{45}) -> return false
    i := 1
    loop i < raw.len() {
        if raw[i] < 48 || raw[i] > 57 -> return false
        i += 1
    }
    true
}

// The first value named `key`, scanning the object's ordered pairs.
fn object_get(entries: [(key: String, value: Dyn)], key: String) -> Dyn? {
    loop pair in entries {
        if pair.key == key -> return Val(pair.value)
    }
    None
}

// Bind `key` to `value`: an existing key keeps its place, a new key goes last.
fn object_set(entries: &[(key: String, value: Dyn)], key: String, value: Dyn) {
    loop i in 0..<entries.len() {
        if entries[i].key == key {
            entries[i] = (key: key, value: value)
            return
        }
    }
    &entries.push((key: key, value: value))
}

fn add_flag_entry(entries: &[(key: String, value: Dyn)], key: String, old: Dyn, value: Dyn) {
    if old == {
        .Bool(previous) -> {
            if previous {
                object_set(&entries, key, Dyn.Int(2))
            } else {
                object_set(&entries, key, value)
            }
        }
        .Int(count) -> {
            if count > 0 {
                object_set(&entries, key, Dyn.Int(count + 1))
            } else {
                object_set(&entries, key, value)
            }
        }
        else -> { object_set(&entries, key, value) }
    }
}

fn put_entry(entries: &[(key: String, value: Dyn)], key: String, value: Dyn) {
    old :: object_get(entries, key)
    if old == .None {
        &entries.push((key: key, value: value))
        return
    }
    previous :: old
    if value == {
        .Bool(flag_value) -> {
            if flag_value {
                add_flag_entry(&entries, key, previous, value)
            } else {
                object_set(&entries, key, value)
            }
        }
        else -> {
            object_set(&entries, key, value)
        }
    }
}

#Test("repeated value options replace their tuple slot without changing order") {
    entries := [(key: String, value: Dyn)]{
        (key: "first", value: Dyn.Text("old")),
        (key: "second", value: Dyn.Int(2)),
    }
    put_entry(&entries, "first", Dyn.Text("new"))
    assert(entries.len() == 2)
    assert(entries[0].key == "first")
    assert(entries[1].key == "second")
    assert(object_get(entries, "first") == Val(Dyn.Text("new")))
}


fn starts(text: String, prefix: String) -> Bool {
    a :: text.bytes()
    b :: prefix.bytes()
    if b.len() > a.len() -> return false
    loop i in 0..<b.len() {
        if a[i] != b[i] -> return false
    }
    true
}

fn index_of(text: String, needle: String) -> Int {
    hay :: text.bytes()
    nd :: needle.bytes()
    if nd.len() == 0 -> return 0
    if nd.len() > hay.len() -> return -1
    loop i in 0..<(hay.len() - nd.len() + 1) {
        ok := true
        loop j in 0..<nd.len() {
            if hay[i + j] != nd[j] -> ok = false
        }
        if ok -> return i
    }
    -1
}


fn get_text(tree: Dyn, key: String) -> String Never! {
    if tree == {
        .Object(entries) -> {
            v :: object_get(entries, key)
            value :: v ?? return ""
            if value == {
                .Text(s) -> return s.copy()
                .Int(n) -> return "{n}"
                .Float(n) -> return "{n}"
                .Bool(b) -> {
                    if b -> return "true"
                    return "false"
                }
                else -> return ""
            }
        }
        else -> return ""
    }
    ""
}

fn get_bool(tree: Dyn, key: String) -> Bool Never! {
    if tree == {
        .Object(entries) -> {
            v :: object_get(entries, key)
            value :: v ?? return false
            if value == {
                .Bool(b) -> return b
                .Int(n) -> return n != 0
                .Text(s) -> {
                    if s == "true" || s == "1" || s == "yes" -> return true
                    return false
                }
                else -> return false
            }
        }
        else -> return false
    }
    false
}

fn get_int(tree: Dyn, key: String) -> Int Never! {
    if tree == {
        .Object(entries) -> {
            v :: object_get(entries, key)
            value :: v ?? return 0
            if value == {
                .Int(n) -> return n
                else -> return 0
            }
        }
        else -> return 0
    }
    0
}

fn positionals(tree: Dyn) -> [String] Never! {
    out := [String]{}
    if tree == {
        .Object(entries) -> {
            v :: object_get(entries, "_")
            value :: v ?? return out
            if value == {
                .Array(items) -> {
                    loop item in items {
                        if item == {
                            .Text(s) -> &out.push(s.copy())
                            else -> { _ := 0 }
                        }
                    }
                }
                else -> { _ := 0 }
            }
        }
        else -> { _ := 0 }
    }
    out
}

fn program(tree: Dyn) -> String Never! { get_text(tree, "0") }

fn help_text(name: String, summary: String) -> String Never! { "{name} — {summary}\n\nOptions:\n  -h, --help    Show this help\n  --flag        Boolean flag\n  --key value   Key/value option\n" }

fn has(tree: Dyn, key: String) -> Bool Never! {
    if tree == {
        .Object(entries) -> {
            v :: object_get(entries, key)
            if v == .None -> return false
            return true
        }
        else -> return false
    }
    false
}

struct ArgDef {
    name: String
    dest: String
    help: String
    flag: Bool
    required: Bool
    default_text: String
}


fn define(name: String, help: String, flag: Bool) -> ArgDef Never! {
    ArgDef{
    name: name,
    dest: name,
    help: help,
    flag: flag,
    required: false,
    default_text: "",
    }
}

fn dest(def: ArgDef, dest: String) -> ArgDef Never! {
    ArgDef{
    name: def.name,
    dest: dest,
    help: def.help,
    flag: def.flag,
    required: def.required,
    default_text: def.default_text,
    }
}

fn required(def: ArgDef) -> ArgDef Never! {
    ArgDef{
    name: def.name,
    dest: def.dest,
    help: def.help,
    flag: def.flag,
    required: true,
    default_text: def.default_text,
    }
}

fn default_value(def: ArgDef, value: String) -> ArgDef Never! {
    ArgDef{
    name: def.name,
    dest: def.dest,
    help: def.help,
    flag: def.flag,
    required: def.required,
    default_text: value,
    }
}

fn get_or(tree: Dyn, key: String, fallback: String) -> String Never! {
    if has(tree, key) -> return get_text(tree, key)
    fallback.copy()
}
fn get_choice(tree: Dyn, key: String, choices: [String]) -> String? Never! {
    v :: get_text(tree, key)
    if v.bytes().len() == 0 -> return None
    result :: v.copy()
    loop c in choices {
        if c == v.copy() -> return Val(result.copy())
    }
    None
}

fn missing_required(tree: Dyn, defs: [ArgDef]) -> [String] Never! {
    out := [String]{}
    loop d in defs {
        if d.required && !has(tree, d.dest) && !has(tree, d.name) -> &out.push(d.name.copy())
    }
    out
}
fn apply_defaults(tree: Dyn, defs: [ArgDef]) -> Dyn Never! {
    out := tree
    loop d in defs {
        if d.default_text.bytes().len() == 0 -> next
        if out.copy() == {
            .Object(entries) -> {
                if object_get(entries, d.dest) == .None && object_get(entries, d.name) == .None {
                    next_entries := entries.copy()
                    &next_entries.push((key: d.dest, value: parse_atom(d.default_text)))
                    out = Dyn.Object(next_entries)
                }
            }
            else -> { _ := 0 }
        }
    }
    out
}

fn usage(name: String, defs: [ArgDef]) -> String Never! {
    s := "usage: {name}"
    loop d in defs {
        token := "--{d.name}"
        if !d.flag -> token = "{token} <{d.dest}>"
        if d.required {
            s = "{s} {token}"
        } else {
            s = "{s} [{token}]"
        }
    }
    "{s} [args...]"
}

fn help_from(name: String, summary: String, defs: [ArgDef]) -> String Never! {
    s := "{usage(name, defs)}\n\n{summary}\n\nOptions:\n"
    loop d in defs {
        flag := "--{d.name}"
        if !d.flag -> flag = "{flag} <{d.dest}>"
        req := ""
        if d.required -> req = " (required)"
        def := ""
        if d.default_text.bytes().len() > 0 -> def = " [default: {d.default_text}]"
        s = "{s}  {flag}    {d.help}{req}{def}\n"
    }
    s = "{s}  -h, --help    Show this help\n"
    s
}

fn remainder(tree: Dyn) -> [String] Never! { positionals(tree) }

fn count_flag(tree: Dyn, key: String) -> Int Never! {
    n :: get_int(tree, key)
    if n > 0 -> return n
    if get_bool(tree, key) -> return 1
    0
}

fn wants_help(tree: Dyn) -> Bool Never! { get_bool(tree, "help") || has(tree, "h") }

// D-SHAPE-CLI1 / D-CLI-POS1 / D-CLI-FIELD-MARKERS1 / D-CLI-GLOBAL1: the typed
// `fn run(args: T)` entry. For a `#CLI` struct `T` the compiler generates
// `__jet_cli_run` (JetSema Registration/CliEntry.jet). When `T` declares no
// commands the compiler writes a parser for exactly the inputs of `T`: help
// and error texts are literals, and it calls only the small `__cli_*`
// helpers its inputs need (the Float check only for a Float input). A `T`
// with commands writes its inputs and commands as one data table and the
// help text of every level as text; the entry hands both to `__cli_spec`
// and parses the process argument vector with `__cli_parse` (`__cli_parse_float` when an
// input is a Float). Help, usage and error texts are the D-ARGS1 builder's
// (`JetArgsSpec::help`, `jet_args_parse_mode`).

// Value kinds of a non-flag input.
CLI_TEXT :: 0
CLI_INT :: 1
CLI_FLOAT :: 2
CLI_CHOICE :: 3
CLI_BOOL :: 4

// One `--flag` (a presence flag) or `--name VALUE` option. A positional input
// also fills from bare argv in declaration order (D-CLI-POS1=A). `env` is the
// value of the input's environment variable when it names one that is set.
struct CLIInput {
    name: String
    short: String
    flag: Bool
    kind: Int
    choices: [String]
    default: String?
    env: String?
    required: Bool
    positional: Bool
}

// One command word: a method or bound function of the program struct. `help`
// is its help text after the program name.
struct CLICommand {
    name: String
    help: String
    inputs: [CLIInput]
}

// `help` is the root help text after the program name.
struct CLISpec {
    help: String
    version: String?
    inputs: [CLIInput]
    commands: [CLICommand]
}

// One parse level: the root spec, or one command with the root inputs
// inherited (they parse at the command level but stay out of its help).
struct CLILevel {
    program: String
    help: String
    accepts_version: Bool
    inherited: [CLIInput]
    local: [CLIInput]
    commands: [CLICommand]
}

// Text values by input name. A spec has a handful of inputs, so a list
// lookup replaces a hash map.
struct CLIValues {
    names: [String]
    values: [String]
}

// `status` -1 runs the entry; 0 prints `message` to stdout and returns; any
// other status prints `message` to stderr and exits with it. `explicit` names
// the inputs argv gave.
struct CLIParsed {
    flag_names: [String]
    flags: [Bool]
    options: CLIValues
    explicit: [String]
    positionals: [String]
    command: String
    status: Int
    message: String
}

struct CLITableCursor {
    table: String
    raw: [U8]
    at: Int
}

// The table field at the cursor: its decimal byte length, `:`, its bytes.
fn cli_take(cursor: &CLITableCursor) -> String Never! {
    length := 0
    loop cursor.raw[cursor.at] != (U8{58}) {
        length = length * 10 + Int{cursor.raw[cursor.at]} - 48
        cursor.at += 1
    }
    start :: cursor.at + 1
    cursor.at = start + length
    slice_str(cursor.table, start, start + length)
}

// The spec the generated entry of a `#CLI` struct with commands wrote as
// `table` (CliEntry.jet sema_cli_entry_spec_line). Each record opens with one
// tag byte. `c` starts a command; its name and help text follow. `i` is an
// input of the root, or of the last command: the kind digit, then `f`, `r`,
// `p`, `d` and `e` (or `-`) for flag, required, positional, has-default and
// names-a-variable, then its name, its short name, its default when it has
// one and, for a choice, the number of choices and each choice. Each text
// field is its decimal byte length, `:` and the bytes. `envs` holds the
// environment value of each input that names a variable, in table order.
fn __cli_spec(table: String, help: String, version: String, has_version: Bool, envs: [String?]) -> CLISpec Never! {
    spec := CLISpec{help: help.copy(), version: if has_version -> Val(version.copy()) else -> None, inputs: [CLIInput]{}, commands: [CLICommand]{}}
    cursor := CLITableCursor{table: table.copy(), raw: table.bytes(), at: 0}
    env_index := 0
    loop cursor.at < cursor.raw.len() {
        if cursor.raw[cursor.at] == (U8{99}) {
            cursor.at += 1
            name :: cli_take(&cursor)
            command_help :: cli_take(&cursor)
            &spec.commands.push(CLICommand{name: name, help: command_help, inputs: [CLIInput]{}})
            next
        }
        kind :: Int{cursor.raw[cursor.at + 1]} - 48
        flag :: cursor.raw[cursor.at + 2] == (U8{102})
        required :: cursor.raw[cursor.at + 3] == (U8{114})
        positional :: cursor.raw[cursor.at + 4] == (U8{112})
        has_default :: cursor.raw[cursor.at + 5] == (U8{100})
        has_env :: cursor.raw[cursor.at + 6] == (U8{101})
        cursor.at += 7
        name :: cli_take(&cursor)
        short :: cli_take(&cursor)
        default := String?{None}
        if has_default -> default = Val(cli_take(&cursor))
        choices := [String]{}
        if kind == CLI_CHOICE {
            count :: Int.parse(cli_take(&cursor)) ?? 0
            loop _ in 0..<count -> &choices.push(cli_take(&cursor))
        }
        env := String?{None}
        if has_env {
            env = envs[env_index].copy()
            env_index += 1
        }
        input :: CLIInput{name: name, short: short, flag: flag, kind: kind, choices: ^choices, default: ^default, env: ^env, required: required, positional: positional}
        last :: spec.commands.len() - 1
        if last < 0 {
            &spec.inputs.push(input)
        } else {
            &spec.commands[last].inputs.push(input)
        }
    }
    spec
}

// Rust `jet_args_source_program_name`: argv[0]'s file name without `.jet`.
fn cli_program_name(argv0: String) -> String Never! {
    raw :: argv0.bytes()
    start := 0
    loop i in 0..<raw.len() {
        if raw[i] == (U8{47}) || raw[i] == (U8{92}) -> start = i + 1
    }
    name :: slice_str(argv0, start, raw.len())
    length :: name.bytes().len()
    if length > 4 && slice_str(name, length - 4, length) == ".jet" -> return slice_str(name, 0, length - 4)
    name
}

// Rust `JetArgsSpec::help`; the text after the program name is the
// compiler's (CliEntry.jet sema_cli_entry_help).
fn cli_usage(level: CLILevel) -> String Never! {
    "Usage: {level.program}{level.help}"
}

fn cli_root_level(spec: CLISpec, program: String) -> CLILevel Never! {
    CLILevel{program: program.copy(), help: spec.help.copy(), accepts_version: spec.version != None, inherited: [CLIInput]{}, local: spec.inputs.copy(), commands: spec.commands.copy()}
}

// Rust `jet_args_subcommand`: a command inherits every root input; its own
// input of the same name gives way to the inherited one.
fn cli_command_level(spec: CLISpec, program: String, command: CLICommand) -> CLILevel Never! {
    local := [CLIInput]{}
    loop input in command.inputs {
        shadowed := false
        loop parent in spec.inputs {
            if parent.name == input.name && parent.flag == input.flag -> shadowed = true
        }
        if !shadowed -> &local.push(input.copy())
    }
    CLILevel{program: program.copy(), help: command.help.copy(), accepts_version: spec.version != None, inherited: spec.inputs.copy(), local: ^local, commands: [CLICommand]{}}
}

fn cli_all(level: CLILevel) -> [CLIInput] Never! {
    all := level.inherited.copy()
    loop input in level.local -> &all.push(input.copy())
    all
}

// The input named `name`: a presence flag when `flag`, else a value option.
fn cli_find(inputs: [CLIInput], name: String, flag: Bool) -> Int Never! {
    loop (index, input) in inputs {
        if input.name == name && input.flag == flag -> return index
    }
    -1
}

fn cli_find_short(inputs: [CLIInput], short: String) -> Int Never! {
    loop (index, input) in inputs {
        if input.short.bytes().len() > 0 && input.short == short -> return index
    }
    -1
}

// The index of `name` in `names`, or -1.
fn cli_slot(names: [String], name: String) -> Int Never! {
    loop (index, entry) in names {
        if entry == name -> return index
    }
    -1
}

fn cli_lookup(values: CLIValues, name: String) -> String? Never! {
    slot :: cli_slot(values.names, name)
    if slot < 0 -> return None
    Val(values.values[slot].copy())
}

fn cli_store(values: &CLIValues, name: String, value: String) Never! {
    slot :: cli_slot(values.names, name)
    if slot >= 0 {
        values.values[slot] = value.copy()
        return
    }
    &values.names.push(name.copy())
    &values.values.push(value.copy())
}

fn cli_get_flag(parsed: CLIParsed, name: String) -> Bool? Never! {
    slot :: cli_slot(parsed.flag_names, name)
    if slot < 0 -> return None
    Val(parsed.flags[slot])
}

fn cli_set_flag(parsed: &CLIParsed, name: String, value: Bool) Never! {
    slot :: cli_slot(parsed.flag_names, name)
    if slot >= 0 {
        parsed.flags[slot] = value
        return
    }
    &parsed.flag_names.push(name.copy())
    &parsed.flags.push(value)
}

fn cli_mark(parsed: &CLIParsed, name: String) Never! {
    if !parsed.explicit.contains(name) -> &parsed.explicit.push(name.copy())
}

fn cli_parsed(status: Int, message: String) -> CLIParsed Never! {
    CLIParsed{flag_names: [String]{}, flags: [Bool]{}, options: CLIValues{names: [String]{}, values: [String]{}}, explicit: [String]{}, positionals: [String]{}, command: "", status: status, message: message.copy()}
}

fn cli_failed(message: String) -> CLIParsed Never! {
    cli_parsed(2, message)
}

// `text` padded with spaces to `width` bytes (the ArgsSpec help columns).
fn cli_pad(text: String, width: Int) -> String Never! {
    out := text.copy()
    count := text.bytes().len()
    loop count < width {
        out = "{out} "
        count += 1
    }
    out
}

fn cli_ascii_lower(text: String) -> String Never! {
    out := [U8]{}
    loop byte in text.bytes() {
        if byte >= 65 && byte <= 90 {
            &out.push(byte + U8{32})
        } else {
            &out.push(byte)
        }
    }
    String.from_bytes(out) ?? ""
}

fn __cli_is_int(text: String) -> Bool Never! {
    _ := Int.parse(text) ?? return false
    true
}

fn __cli_is_float(text: String) -> Bool Never! {
    _ := Float.parse(text) ?? return false
    true
}

// Whether `text` reads as a Bool value: `true` or `false` in any case.
fn __cli_is_bool(text: String) -> Bool Never! {
    lower :: cli_ascii_lower(text)
    lower == "true" || lower == "false"
}

// Rust `jet_args_store_option`: "" when `value` fits the input, else the
// refusal. `float_ok` checks a Float value.
fn cli_store_error(input: CLIInput, value: String, float_ok: fn(String) -> Bool Never!) -> String Never! {
    if input.kind == CLI_INT && !__cli_is_int(value) -> return __cli_int_refusal(input.name, value)
    if input.kind == CLI_FLOAT && !float_ok(value) -> return __cli_float_refusal(input.name, value)
    if input.kind == CLI_CHOICE && !input.choices.contains(value) -> return __cli_choice_refusal(input.name, value, input.choices.join(", "))
    ""
}

fn cli_edit_distance(a: String, b: String) -> Int Never! {
    left :: a.bytes()
    right :: b.bytes()
    previous := [Int]{}
    loop j in 0..<(right.len() + 1) -> &previous.push(j)
    loop (i, x) in left {
        current := [Int]{i + 1}
        loop (j, y) in right {
            best := previous[j]
            if x != y {
                if previous[j + 1] < best -> best = previous[j + 1]
                if current[j] < best -> best = current[j]
                best += 1
            }
            &current.push(best)
        }
        previous = ^current
    }
    previous[right.len()]
}

// Rust `jet_args_unknown`.
fn cli_unknown(name: String, inputs: [CLIInput], help: String) -> String Never! {
    names :: loop input in inputs -> input.name.copy()
    "{__cli_unknown(name, names)}\n\n{help}"
}

// The refusal of the unknown option `--name`, with the first of `names`
// within two edits as a suggestion.
fn __cli_unknown(name: String, names: [String]) -> String Never! {
    loop known in names {
        if cli_edit_distance(known, name) <= 2 -> return "unknown option `--{name}`\ndid you mean `--{known}`?"
    }
    "unknown option `--{name}`"
}

// Rust `jet_args_parse_mode` over argv[start..]: options, flags, shorts, one
// command word and the positional fill, with the explicit > env > default
// precedence.
fn cli_parse_level(spec: CLISpec, level: CLILevel, argv: [String], start: Int, float_ok: fn(String) -> Bool Never!) -> CLIParsed Never! {
    all :: cli_all(level)
    out := cli_parsed(-1, "")
    root_help :: start >= argv.len() && level.commands.len() > 0
    cli_set_flag(&out, "help", false)
    cli_set_flag(&out, "version", false)
    fallbacks := CLIValues{names: [String]{}, values: [String]{}}
    loop input in all {
        if input.flag {
            cli_set_flag(&out, input.name, false)
            next
        }
        if input.env == .Val(value) {
            cli_store(&fallbacks, input.name, value)
        } else if input.default == .Val(value) {
            cli_store(&fallbacks, input.name, value)
        }
    }
    i := start
    loop i < argv.len() {
        arg :: argv[i].copy()
        if arg == "--" {
            i += 1
            loop i < argv.len() {
                &out.positionals.push(argv[i].copy())
                i += 1
            }
            break
        }
        if starts(arg, "--") {
            rest :: drop_prefix(arg, 2)
            if rest == "help" || (rest == "version" && level.accepts_version) {
                cli_set_flag(&out, rest, true)
                cli_mark(&out, rest)
                i += 1
                next
            }
            eq :: if rest.bytes().len() > 0 -> index_of(rest, "=") else -> -1
            if eq >= 0 {
                name :: slice_str(rest, 0, eq)
                value :: slice_str(rest, eq + 1, rest.bytes().len())
                option :: cli_find(all, name, false)
                if option >= 0 {
                    refusal :: cli_store_error(all[option], value, float_ok)
                    if refusal.bytes().len() > 0 -> return cli_failed(refusal)
                    cli_store(&out.options, name, value)
                    cli_mark(&out, name)
                } else if cli_find(all, name, true) >= 0 {
                    return cli_failed("--{name} is a flag; it takes no value (got `={value}`)\n\n{cli_usage(level)}")
                } else {
                    return cli_failed(cli_unknown(name, all, cli_usage(level)))
                }
            } else if cli_find(all, rest, true) >= 0 {
                cli_set_flag(&out, rest, true)
                cli_mark(&out, rest)
            } else {
                option :: cli_find(all, rest, false)
                if option < 0 -> return cli_failed(cli_unknown(rest, all, cli_usage(level)))
                i += 1
                if i >= argv.len() -> return cli_failed("`--{rest}` requires a value\n\n{cli_usage(level)}")
                refusal :: cli_store_error(all[option], argv[i], float_ok)
                if refusal.bytes().len() > 0 -> return cli_failed(refusal)
                cli_store(&out.options, rest, argv[i])
                cli_mark(&out, rest)
            }
            i += 1
            next
        }
        if starts(arg, "-") && arg.bytes().len() > 1 {
            rest :: drop_prefix(arg, 1)
            length :: rest.bytes().len()
            k := 0
            loop k < length {
                short :: slice_str(rest, k, k + 1)
                found :: cli_find_short(all, short)
                if found < 0 -> return cli_failed(if length > 1 -> "unknown option `-{short}`\n\n{cli_usage(level)}" else -> "unknown option `-{rest}`\n\n{cli_usage(level)}")
                input :: all[found].copy()
                if input.flag {
                    cli_set_flag(&out, input.name, true)
                    cli_mark(&out, input.name)
                    k += 1
                    next
                }
                // A value option takes the rest of a cluster, else the next word.
                value := slice_str(rest, k + 1, length)
                if value.bytes().len() == 0 {
                    i += 1
                    if i >= argv.len() -> return cli_failed("`-{short}` requires a value\n\n{cli_usage(level)}")
                    value = argv[i].copy()
                }
                refusal :: cli_store_error(input, value, float_ok)
                if refusal.bytes().len() > 0 -> return cli_failed(refusal)
                cli_store(&out.options, input.name, value)
                cli_mark(&out, input.name)
                break
            }
            i += 1
            next
        }
        if out.command.bytes().len() == 0 {
            command_index := -1
            loop (index, command) in level.commands {
                if command.name == arg {
                    command_index = index
                    break
                }
            }
            if command_index >= 0 {
                command :: level.commands[command_index].copy()
                nested :: cli_parse_level(spec, cli_command_level(spec, level.program, command), argv, i + 1, float_ok)
                if nested.status >= 0 -> return nested
                loop (index, name) in nested.flag_names {
                    if nested.explicit.contains(name) || cli_slot(out.flag_names, name) < 0 -> cli_set_flag(&out, name, nested.flags[index])
                }
                loop (index, name) in nested.options.names {
                    if nested.explicit.contains(name) || cli_slot(out.options.names, name) < 0 -> cli_store(&out.options, name, nested.options.values[index])
                }
                loop value in nested.positionals -> &out.positionals.push(value.copy())
                loop name in nested.explicit -> cli_mark(&out, name)
                out.command = command.name.copy()
                break
            }
            if level.commands.len() > 0 -> return cli_failed("unknown command `{arg}`\n\n{cli_usage(level)}")
        }
        &out.positionals.push(arg.copy())
        i += 1
    }
    // D-CLI-POS1=A named-wins: a named value satisfies its positional slot and
    // consumes one bare value without shifting later positionals.
    bare := 0
    missing := [String]{}
    filled := [String]{}
    loop input in all {
        if !input.positional -> next
        if cli_slot(out.options.names, input.name) >= 0 {
            if bare < out.positionals.len() -> bare += 1
            next
        }
        if bare < out.positionals.len() {
            value :: out.positionals[bare].copy()
            refusal :: cli_store_error(input, value, float_ok)
            if refusal.bytes().len() > 0 -> return cli_failed(refusal)
            cli_store(&out.options, input.name, value)
            bare += 1
        } else if cli_lookup(fallbacks, input.name) == .Val(value) {
            cli_store(&out.options, input.name, value)
            &filled.push(input.name.copy())
        } else {
            &missing.push(input.name.copy())
        }
    }
    if out.command.bytes().len() == 0 && bare < out.positionals.len() -> return cli_failed("{__cli_surplus(out.positionals, bare)}\n\n{cli_usage(level)}")
    loop input in all {
        if input.flag || filled.contains(input.name) || cli_slot(out.options.names, input.name) >= 0 -> next
        if cli_lookup(fallbacks, input.name) == .Val(value) -> cli_store(&out.options, input.name, value)
    }
    asked_help :: cli_get_flag(out, "help") ?? false
    if missing.len() > 0 && !root_help && !asked_help -> return cli_failed("{__cli_missing(missing)}\n\n{cli_usage(level)}")
    loop input in all {
        if input.required && !input.flag && cli_slot(out.options.names, input.name) < 0 && !root_help && !asked_help -> return cli_failed("missing required option `--{input.name}`\n\n{cli_usage(level)}")
    }
    out
}

// Parses argv (argv[0] names the program) against `spec`; the generated
// entry prints `--help`, `--version`, the bare command list and every
// refusal from the returned status.
fn cli_parse(spec: CLISpec, argv: [String], float_ok: fn(String) -> Bool Never!) -> CLIParsed Never! {
    program :: cli_program_name(if argv.len() > 0 -> argv[0].copy() else -> "")
    root :: cli_root_level(spec, program)
    parsed := cli_parse_level(spec, root, argv, 1, float_ok)
    if parsed.status >= 0 -> return parsed
    if cli_get_flag(parsed, "help") ?? false {
        parsed.status = 0
        parsed.message = cli_usage(root)
        loop command in spec.commands {
            if command.name == parsed.command -> parsed.message = "Usage: {program}{command.help}"
        }
        return parsed
    }
    if spec.version == .Val(version) && (cli_get_flag(parsed, "version") ?? false) {
        parsed.status = 0
        parsed.message = version.copy()
        return parsed
    }
    // A bare invocation of a command program asks what it can do.
    if spec.commands.len() > 0 && parsed.command.bytes().len() == 0 {
        parsed.status = 0
        parsed.message = cli_usage(root)
        return parsed
    }
    // Environment and default values decode like argv values.
    inputs := spec.inputs.copy()
    loop command in spec.commands {
        if command.name == parsed.command {
            loop input in command.inputs -> &inputs.push(input.copy())
        }
    }
    loop input in inputs {
        if input.flag -> next
        value :: cli_lookup(parsed.options, input.name) ?? next
        reason :: if {
            input.kind == CLI_INT && !__cli_is_int(value) -> "is not a whole number"
            input.kind == CLI_FLOAT && !float_ok(value) -> "is not a number"
            input.kind == CLI_BOOL && !__cli_is_bool(value) -> "is not true or false"
            else -> ""
        }
        if reason.bytes().len() > 0 -> return cli_failed("invalid value for --{input.name}: `{value}` {reason}\n\n{cli_usage(root)}")
    }
    parsed
}

fn __cli_parse(spec: CLISpec, argv: [String]) -> CLIParsed Never! {
    cli_parse(spec, argv, (text: String) -> false)
}

// The parse of a spec with a Float input.
fn __cli_parse_float(spec: CLISpec, argv: [String]) -> CLIParsed Never! {
    cli_parse(spec, argv, (text: String) -> __cli_is_float(text))
}

fn __cli_status(parsed: CLIParsed) -> Int Never! { parsed.status }
fn __cli_message(parsed: CLIParsed) -> String Never! { parsed.message.copy() }
fn __cli_command_name(parsed: CLIParsed) -> String Never! { parsed.command.copy() }
fn __cli_flag(parsed: CLIParsed, name: String) -> Bool Never! { cli_get_flag(parsed, name) ?? false }
fn __cli_explicit(parsed: CLIParsed, name: String) -> Bool Never! { parsed.explicit.contains(name) }
fn __cli_value(parsed: CLIParsed, name: String) -> String? Never! { cli_lookup(parsed.options, name) }

// The decoded value of an input from its text, `value` (None when absent).
fn __cli_text_of(value: String?) -> String Never! { value.copy() ?? "" }
fn __cli_int_of(value: String?) -> Int Never! { Int.parse(__cli_text_of(value)) ?? 0 }
fn __cli_float_of(value: String?) -> Float Never! { Float.parse(__cli_text_of(value)) ?? 0.0 }
fn __cli_bool_of(value: String?) -> Bool Never! { cli_ascii_lower(__cli_text_of(value)) == "true" }
fn __cli_text_opt_of(value: String?) -> String? Never! { value.copy() }
fn __cli_int_opt_of(value: String?) -> Int? Never! {
    if value == None -> return None
    Val(__cli_int_of(value))
}
fn __cli_float_opt_of(value: String?) -> Float? Never! {
    if value == None -> return None
    Val(__cli_float_of(value))
}
fn __cli_bool_opt_of(value: String?) -> Bool? Never! {
    if value == None -> return None
    Val(__cli_bool_of(value))
}

// The start vector the compiler's generated entry parses: the program name,
// then the program's words. User code reads `process.args()` instead.
fn __cli_argv() -[Exec.Args]> [String] Never! { core.process.argv() }
// The pieces of the parser the compiler writes for a `#CLI` struct without
// commands. `help` is the root help text after the program name.
fn __cli_usage(argv: [String], help: String) -> String Never! {
    "Usage: {cli_program_name(if argv.len() > 0 -> argv[0].copy() else -> "")}{help}"
}
fn __cli_with_usage(message: String, argv: [String], help: String) -> String Never! {
    "{message}\n\n{__cli_usage(argv, help)}"
}
fn __cli_long(arg: String) -> Bool Never! { starts(arg, "--") }
fn __cli_short(arg: String) -> Bool Never! { starts(arg, "-") && arg.bytes().len() > 1 }
fn __cli_rest(text: String, start: Int) -> String Never! { slice_str(text, start, text.bytes().len()) }
fn __cli_slice(text: String, start: Int, end: Int) -> String Never! { slice_str(text, start, end) }
fn __cli_eq(text: String) -> Int Never! {
    loop (at, byte) in text.bytes() {
        if byte == (U8{61}) -> return at
    }
    -1
}
fn __cli_int_refusal(name: String, value: String) -> String Never! {
    "`--{name}` expects an Int, got `{value}`\n\nfix: pass a whole number to `--{name}`"
}
fn __cli_float_refusal(name: String, value: String) -> String Never! {
    "`--{name}` expects a Float, got `{value}`\n\nfix: pass a number to `--{name}`"
}
fn __cli_choice_refusal(name: String, value: String, choices: String) -> String Never! {
    "`--{name}` expects one of: {choices}; got `{value}`"
}
fn __cli_flag_value(name: String, value: String) -> String Never! {
    "--{name} is a flag; it takes no value (got `={value}`)"
}
fn __cli_surplus(positionals: [String], start: Int) -> String Never! {
    surplus := [String]{}
    loop index in start..<positionals.len() -> &surplus.push("`{positionals[index]}`")
    plural :: if surplus.len() == 1 -> "" else -> "s"
    "unexpected argument{plural}: {surplus.join(", ")}"
}
fn __cli_missing(names: [String]) -> String Never! {
    plural :: if names.len() == 1 -> "" else -> "s"
    "missing required argument{plural}: {names.join(", ")}"
}

// D-ARGS1: the `args.spec()` builder (Rust `JetArgsSpec`). A spec keeps its
// nested command specs in one list of levels: level 0 is the spec itself and
// a command entry names the level of its own spec. The compiler lowers each
// checked `ArgsSpec` / `ParsedArgs` method to the `__args_*` / `__parsed_*`
// helper of the same name (JetIR CoreReach.jet ir_args_helper).

// Entry kinds of one spec level.
ARG_FLAG :: 0
ARG_OPTION :: 1
ARG_POSITIONAL :: 2
ARG_COMMAND :: 3

// A flag, value option, positional or command word. `value` is the option's
// CLI_TEXT / CLI_INT / CLI_FLOAT / CLI_CHOICE kind; `nested` is a command's
// level.
struct ArgEntry {
    kind: Int
    name: String
    short: String?
    help: String
    meta: String
    default: String?
    env: String?
    required: Bool
    repeat: Bool
    value: Int
    choices: [String]
    nested: Int
}

// One spec. `inherited` holds the parent inputs a command parses but keeps
// out of its help and completion.
struct ArgsLevel {
    entries: [ArgEntry]
    inherited: [ArgEntry]
    description: String?
    version: String?
    inherited_version: Bool
}

struct ArgsSpec {
    levels: [ArgsLevel]
}

struct ParsedArgs {
    flags: [String:Bool]
    options: [String:[String]]
    positionals: [String]
    subcommand: String?
    explicit_flags: [String:Bool]
    explicit_options: [String:Bool]
}

fn spec() -> ArgsSpec Never! {
    ArgsSpec{levels: [ArgsLevel]{ArgsLevel{entries: [ArgEntry]{}, inherited: [ArgEntry]{}, description: None, version: None, inherited_version: false}}}
}

fn args_entry(kind: Int, name: String, short: String?, help: String, meta: String, default: String?, env: String?, required: Bool, repeat: Bool, value: Int) -> ArgEntry Never! {
    ArgEntry{kind: kind, name: name.copy(), short: short.copy(), help: help.copy(), meta: meta.copy(), default: default.copy(), env: env.copy(), required: required, repeat: repeat, value: value, choices: [String]{}, nested: -1}
}

fn args_option_entry(name: String, help: String, meta: String, value: Int) -> ArgEntry Never! {
    args_entry(ARG_OPTION, name, None, help, meta, None, None, false, false, value)
}

fn args_with(^spec: ArgsSpec, ^entry: ArgEntry) -> ArgsSpec Never! {
    out := ^spec
    &out.levels[0].entries.push(^entry)
    out
}

fn __args_description(^spec: ArgsSpec, description: String) -> ArgsSpec Never! {
    out := ^spec
    out.levels[0].description = Val(description.copy())
    out
}

fn __args_version(^spec: ArgsSpec, version: String) -> ArgsSpec Never! {
    out := ^spec
    out.levels[0].version = Val(version.copy())
    out
}

fn __args_flag(^spec: ArgsSpec, name: String, help: String) -> ArgsSpec Never! {
    args_with(^spec, args_entry(ARG_FLAG, name, None, help, "", None, None, false, false, CLI_TEXT))
}

fn __args_flag_short(^spec: ArgsSpec, name: String, short: String, help: String) -> ArgsSpec Never! {
    args_with(^spec, args_entry(ARG_FLAG, name, Val(short.copy()), help, "", None, None, false, false, CLI_TEXT))
}

fn __args_option(^spec: ArgsSpec, name: String, help: String, meta: String) -> ArgsSpec Never! {
    args_with(^spec, args_option_entry(name, help, meta, CLI_TEXT))
}

fn __args_option_short(^spec: ArgsSpec, name: String, short: String, help: String, meta: String) -> ArgsSpec Never! {
    args_with(^spec, args_entry(ARG_OPTION, name, Val(short.copy()), help, meta, None, None, false, false, CLI_TEXT))
}

fn __args_option_default(^spec: ArgsSpec, name: String, help: String, meta: String, default: String) -> ArgsSpec Never! {
    args_with(^spec, args_entry(ARG_OPTION, name, None, help, meta, Val(default.copy()), None, false, false, CLI_TEXT))
}

fn __args_option_env(^spec: ArgsSpec, name: String, help: String, meta: String, env: String) -> ArgsSpec Never! {
    args_with(^spec, args_entry(ARG_OPTION, name, None, help, meta, None, Val(env.copy()), false, false, CLI_TEXT))
}

fn __args_option_int(^spec: ArgsSpec, name: String, help: String, meta: String) -> ArgsSpec Never! {
    args_with(^spec, args_option_entry(name, help, meta, CLI_INT))
}

fn __args_option_float(^spec: ArgsSpec, name: String, help: String, meta: String) -> ArgsSpec Never! {
    args_with(^spec, args_option_entry(name, help, meta, CLI_FLOAT))
}

// `choices` is a comma list; each choice is trimmed and an empty one dropped.
fn __args_option_choice(^spec: ArgsSpec, name: String, help: String, meta: String, choices: String) -> ArgsSpec Never! {
    entry := args_option_entry(name, help, meta, CLI_CHOICE)
    loop part in choices.split(",") {
        choice :: part.trim()
        if choice.bytes().len() > 0 -> &entry.choices.push(choice.copy())
    }
    args_with(^spec, ^entry)
}

fn __args_repeat(^spec: ArgsSpec, name: String, help: String, meta: String) -> ArgsSpec Never! {
    args_with(^spec, args_entry(ARG_OPTION, name, None, help, meta, None, None, false, true, CLI_TEXT))
}

fn __args_required_option(^spec: ArgsSpec, name: String, help: String, meta: String) -> ArgsSpec Never! {
    args_with(^spec, args_entry(ARG_OPTION, name, None, help, meta, None, None, true, false, CLI_TEXT))
}

fn __args_positional(^spec: ArgsSpec, name: String, help: String) -> ArgsSpec Never! {
    args_with(^spec, args_entry(ARG_POSITIONAL, name, None, help, "", None, None, false, false, CLI_TEXT))
}

fn args_same_input(left: ArgEntry, right: ArgEntry) -> Bool Never! {
    left.kind == right.kind && left.kind != ARG_COMMAND && left.name == right.name
}

// Rust `jet_args_subcommand`: the command inherits every parent input; its
// own input of the same name gives way to the inherited one. Its levels move
// after the parent's, so each nested level index shifts by the parent count.
fn __args_subcommand(^spec: ArgsSpec, name: String, help: String, ^command: ArgsSpec) -> ArgsSpec Never! {
    out := ^spec
    nested := ^command
    inherited := out.levels[0].inherited.copy()
    loop entry in out.levels[0].entries {
        if entry.kind != ARG_COMMAND -> &inherited.push(entry.copy())
    }
    kept := [ArgEntry]{}
    loop entry in nested.levels[0].entries {
        shadowed := false
        loop parent in inherited {
            if args_same_input(parent, entry) -> shadowed = true
        }
        if !shadowed -> &kept.push(entry.copy())
    }
    nested.levels[0].entries = ^kept
    loop entry in inherited {
        present := false
        loop parent in nested.levels[0].inherited {
            if args_same_input(parent, entry) -> present = true
        }
        if !present -> &nested.levels[0].inherited.push(entry.copy())
    }
    nested.levels[0].inherited_version = nested.levels[0].inherited_version || out.levels[0].inherited_version || out.levels[0].version != None
    if nested.levels[0].inherited_version -> nested.levels[0].version = None
    offset :: out.levels.len()
    loop level in nested.levels {
        moved := level.copy()
        loop index in 0..<moved.entries.len() {
            if moved.entries[index].kind == ARG_COMMAND -> moved.entries[index].nested = moved.entries[index].nested + offset
        }
        &out.levels.push(^moved)
    }
    entry := args_entry(ARG_COMMAND, name, None, help, "", None, None, false, false, CLI_TEXT)
    entry.nested = offset
    &out.levels[0].entries.push(^entry)
    out
}

fn args_label(entry: ArgEntry) -> String Never! {
    out := "--{entry.name}"
    if entry.short == .Val(short) -> out = "-{short}, {out}"
    if entry.kind == ARG_OPTION -> out = "{out} {entry.meta}"
    out
}

// Rust `JetArgsSpec::help` for one level. Every level names the program
// argv[0] runs as.
fn args_help(spec: ArgsSpec, at: Int) -[Exec.Args]> String Never! {
    argv :: core.process.argv()
    s := "Usage: {cli_program_name(if argv.len() > 0 -> argv[0].copy() else -> "")}"
    positional_count := 0
    loop entry in spec.levels[at].entries {
        if entry.kind == ARG_POSITIONAL {
            s = "{s} {entry.name}"
            positional_count += 1
        }
    }
    s = "{s} [options]\n"
    if spec.levels[at].description == .Val(description) -> s = "{s}\n{description}\n"
    if positional_count > 0 {
        s = "{s}\nArguments:\n"
        loop entry in spec.levels[at].entries {
            if entry.kind == ARG_POSITIONAL -> s = "{s}  {cli_pad(entry.name, 22)} {entry.help}\n"
        }
    }
    if positional_count == spec.levels[at].entries.len() -> return s
    s = "{s}\nOptions:\n"
    loop entry in spec.levels[at].entries {
        if entry.kind == ARG_FLAG {
            s = "{s}  {cli_pad(args_label(entry), 24)} {entry.help}\n"
        } else if entry.kind == ARG_OPTION {
            note := entry.help.copy()
            if entry.required -> note = "{note} (required)"
            if entry.repeat -> note = "{note} (repeatable)"
            if entry.default == .Val(value) {
                note = "{note} [default: {value}]"
                if entry.env != None -> note = "{note} [precedence: flag > env > default]"
            }
            if entry.env == .Val(key) -> note = "{note} [env: {key}]"
            if entry.value == CLI_CHOICE -> note = "{note} [choices: {entry.choices.join(", ")}]"
            s = "{s}  {cli_pad(args_label(entry), 24)} {note}\n"
        } else if entry.kind == ARG_COMMAND {
            s = "{s}  {cli_pad(entry.name, 24)} {entry.help}\n"
        }
    }
    s = "{s}  {cli_pad("--help", 24)} show this help\n"
    if spec.levels[at].version != None -> s = "{s}  {cli_pad("--version", 24)} show version\n"
    s
}

fn __args_help(spec: ArgsSpec) -[Exec.Args]> String Never! {
    args_help(spec, 0)
}

// Rust `jet_args_completion`: the words a shell completes, in declaration
// order.
fn __args_completion(spec: ArgsSpec, shell: String) -> String Never! {
    words := [String]{"--help"}
    if spec.levels[0].version != None -> &words.push("--version")
    loop entry in spec.levels[0].entries {
        if entry.kind == ARG_FLAG || entry.kind == ARG_OPTION {
            &words.push("--{entry.name}")
            if entry.short == .Val(short) -> &words.push("-{short}")
        } else {
            &words.push(entry.name.copy())
        }
    }
    "{shell} completion: {words.join(" ")}"
}

// Rust `jet_args_all_entries`: the inherited inputs, then the level's own.
fn args_all(level: ArgsLevel) -> [ArgEntry] Never! {
    all := level.inherited.copy()
    loop entry in level.entries {
        if entry.kind != ARG_COMMAND -> &all.push(entry.copy())
    }
    all
}

fn args_find(all: [ArgEntry], kind: Int, name: String) -> Int Never! {
    loop (index, entry) in all {
        if entry.kind == kind && entry.name == name -> return index
    }
    -1
}

fn args_find_short(all: [ArgEntry], short: String) -> Int Never! {
    loop (index, entry) in all {
        if entry.kind != ARG_FLAG && entry.kind != ARG_OPTION -> next
        if entry.short == .Val(letter) {
            if letter == short -> return index
        }
    }
    -1
}

// Rust `jet_args_store_option`: "" after storing `value`, else the refusal.
// A repeatable option keeps every value; another keeps the last.
fn args_store(options: &[String:[String]], entry: ArgEntry, value: String) -> String Never! {
    if entry.value == CLI_INT && !__cli_is_int(value) -> return __cli_int_refusal(entry.name, value)
    if entry.value == CLI_FLOAT && !__cli_is_float(value) -> return __cli_float_refusal(entry.name, value)
    if entry.value == CLI_CHOICE && !entry.choices.contains(value) -> return __cli_choice_refusal(entry.name, value, entry.choices.join(", "))
    values := if entry.repeat -> (options.get(entry.name) ?? [String]{}).copy() else -> [String]{}
    &values.push(value.copy())
    options[entry.name.copy()] = ^values
    ""
}

// Rust `jet_args_unknown`.
fn args_unknown(name: String, all: [ArgEntry], help: String) -> String Never! {
    suggestion := ""
    loop entry in all {
        if (entry.kind == ARG_FLAG || entry.kind == ARG_OPTION) && cli_edit_distance(entry.name, name) <= 2 {
            suggestion = "\ndid you mean `--{entry.name}`?"
            break
        }
    }
    "unknown option `--{name}`{suggestion}\n\n{help}"
}

fn args_parsed() -> ParsedArgs Never! {
    ParsedArgs{flags: [String:Bool]{}, options: [String:[String]]{}, positionals: [String]{}, subcommand: None, explicit_flags: [String:Bool]{}, explicit_options: [String:Bool]{}}
}

// Rust `jet_args_parse_mode` for level `at` over argv[start..] into `out`:
// "" after a parse, else the refusal. Options, flags, short clusters, one
// command word and the positional fill, with explicit > env > default.
fn args_parse_level(spec: ArgsSpec, at: Int, argv: [String], start: Int, out: &ParsedArgs) -[Env, Exec.Args]> String Never! {
    all :: args_all(spec.levels[at])
    has_commands := false
    loop entry in spec.levels[at].entries {
        if entry.kind == ARG_COMMAND -> has_commands = true
    }
    accepts_version :: spec.levels[at].version != None || spec.levels[at].inherited_version
    root_help :: start >= argv.len() && has_commands
    out.flags["help"] = false
    out.flags["version"] = false
    fallbacks := [String:String]{}
    loop entry in all {
        if entry.kind == ARG_FLAG {
            out.flags[entry.name.copy()] = false
            next
        }
        if entry.kind != ARG_OPTION -> next
        environment :: if entry.env == .Val(key) -> core.process.env_get(key) else -> String?{None}
        if environment == .Val(value) {
            fallbacks[entry.name.copy()] = value.copy()
        } else if entry.default == .Val(value) {
            fallbacks[entry.name.copy()] = value.copy()
        }
    }
    i := start
    loop i < argv.len() {
        arg :: argv[i].copy()
        if arg == "--" {
            i += 1
            loop i < argv.len() {
                &out.positionals.push(argv[i].copy())
                i += 1
            }
            break
        }
        if starts(arg, "--") {
            rest :: drop_prefix(arg, 2)
            if rest == "help" || (rest == "version" && accepts_version) {
                out.flags[rest.copy()] = true
                out.explicit_flags[rest.copy()] = true
                i += 1
                next
            }
            eq :: if rest.bytes().len() > 0 -> index_of(rest, "=") else -> -1
            if eq >= 0 {
                name :: slice_str(rest, 0, eq)
                value :: slice_str(rest, eq + 1, rest.bytes().len())
                option :: args_find(all, ARG_OPTION, name)
                if option >= 0 {
                    refusal :: args_store(&out.options, all[option], value)
                    if refusal.bytes().len() > 0 -> return refusal
                    out.explicit_options[name.copy()] = true
                } else if args_find(all, ARG_FLAG, name) >= 0 {
                    return "--{name} is a flag; it takes no value (got `={value}`)\n\n{args_help(spec, at)}"
                } else {
                    return args_unknown(name, all, args_help(spec, at))
                }
            } else if args_find(all, ARG_FLAG, rest) >= 0 {
                out.flags[rest.copy()] = true
                out.explicit_flags[rest.copy()] = true
            } else {
                option :: args_find(all, ARG_OPTION, rest)
                if option < 0 -> return args_unknown(rest, all, args_help(spec, at))
                i += 1
                if i >= argv.len() -> return "`--{rest}` requires a value\n\n{args_help(spec, at)}"
                refusal :: args_store(&out.options, all[option], argv[i])
                if refusal.bytes().len() > 0 -> return refusal
                out.explicit_options[rest.copy()] = true
            }
            i += 1
            next
        }
        if starts(arg, "-") && arg.bytes().len() > 1 {
            rest :: drop_prefix(arg, 1)
            length :: rest.bytes().len()
            k := 0
            loop k < length {
                short :: slice_str(rest, k, k + 1)
                found :: args_find_short(all, short)
                if found < 0 -> return "unknown option `-{short}`\n\n{args_help(spec, at)}"
                if all[found].kind == ARG_FLAG {
                    out.flags[all[found].name.copy()] = true
                    out.explicit_flags[all[found].name.copy()] = true
                    k += 1
                    next
                }
                // A value option takes the rest of a cluster, else the next word.
                value := slice_str(rest, k + 1, length)
                if value.bytes().len() == 0 {
                    i += 1
                    if i >= argv.len() -> return "`-{short}` requires a value\n\n{args_help(spec, at)}"
                    value = argv[i].copy()
                }
                refusal :: args_store(&out.options, all[found], value)
                if refusal.bytes().len() > 0 -> return refusal
                out.explicit_options[all[found].name.copy()] = true
                break
            }
            i += 1
            next
        }
        if out.subcommand == None {
            command := -1
            loop entry in spec.levels[at].entries {
                if entry.kind == ARG_COMMAND && entry.name == arg {
                    command = entry.nested
                    break
                }
            }
            if command >= 0 {
                nested := args_parsed()
                refusal :: args_parse_level(spec, command, argv, i + 1, &nested)
                if refusal.bytes().len() > 0 -> return refusal
                loop (name, value) in nested.flags {
                    if nested.explicit_flags.get(name) != None || out.flags.get(name) == None -> out.flags[name.copy()] = value
                }
                loop (name, values) in nested.options {
                    if nested.explicit_options.get(name) != None || out.options.get(name) == None -> out.options[name.copy()] = values.copy()
                }
                loop value in nested.positionals -> &out.positionals.push(value.copy())
                loop (name, value) in nested.explicit_flags -> out.explicit_flags[name.copy()] = value
                loop (name, value) in nested.explicit_options -> out.explicit_options[name.copy()] = value
                out.subcommand = Val(arg.copy())
                break
            }
            if has_commands -> return "unknown command `{arg}`\n\n{args_help(spec, at)}"
        }
        &out.positionals.push(arg.copy())
        i += 1
    }
    // D-CLI-POS1=A named-wins: a named value satisfies its positional slot and
    // consumes one bare value without shifting later positionals.
    bare := 0
    missing := [String]{}
    loop entry in all {
        if entry.kind != ARG_POSITIONAL -> next
        if out.options.get(entry.name) != None {
            if bare < out.positionals.len() -> bare += 1
            next
        }
        if bare < out.positionals.len() {
            value :: out.positionals[bare].copy()
            option :: args_find(all, ARG_OPTION, entry.name)
            if option >= 0 {
                refusal :: args_store(&out.options, all[option], value)
                if refusal.bytes().len() > 0 -> return refusal
            } else {
                out.options[entry.name.copy()] = [String]{value.copy()}
            }
            bare += 1
        } else if fallbacks.get(entry.name) == .Val(value) {
            out.options[entry.name.copy()] = [String]{value.copy()}
        } else {
            &missing.push(entry.name.copy())
        }
    }
    if out.subcommand == None && bare < out.positionals.len() {
        surplus := [String]{}
        loop index in bare..<out.positionals.len() -> &surplus.push("`{out.positionals[index]}`")
        plural :: if surplus.len() == 1 -> "" else -> "s"
        return "unexpected argument{plural}: {surplus.join(", ")}\n\n{args_help(spec, at)}"
    }
    loop (name, value) in fallbacks {
        if out.options.get(name) == None -> out.options[name.copy()] = [String]{value.copy()}
    }
    asked_help :: out.flags.get("help") ?? false
    if missing.len() > 0 && !root_help && !asked_help {
        plural :: if missing.len() == 1 -> "" else -> "s"
        return "missing required argument{plural}: {missing.join(", ")}\n\n{args_help(spec, at)}"
    }
    loop entry in all {
        if entry.kind == ARG_OPTION && entry.required && out.options.get(entry.name) == None && !root_help && !asked_help -> return "missing required option `--{entry.name}`\n\n{args_help(spec, at)}"
    }
    ""
}

// Parses the user's words (`process.args()`, no program name); a refusal
// is the Err's message.
fn __args_parse(spec: ArgsSpec, args: [String]) -[Env, Exec.Args]> ParsedArgs Err! {
    out := args_parsed()
    refusal :: args_parse_level(spec, 0, args, 0, &out)
    if refusal.bytes().len() > 0 -> return Err(refusal)
    Ok(out)
}

// Rust `jet_args_parse_or_exit`: `--help` prints the help and exits 0; a
// refusal goes to stderr and exits 2.
fn __args_parse_or_exit(spec: ArgsSpec, args: [String]) -[Env, Exec, Exec.Args, IO, Time.Wait]> ParsedArgs Never! {
    out := args_parsed()
    refusal :: args_parse_level(spec, 0, args, 0, &out)
    if refusal.bytes().len() > 0 {
        core.term.eprint(refusal)
        core.process.exit(2)
    }
    if out.flags.get("help") ?? false {
        print(args_help(spec, 0))
        core.process.exit(0)
    }
    out
}

fn __parsed_flag(parsed: ParsedArgs, name: String) -> Bool Never! { parsed.flags.get(name) ?? false }

// The last value given, so a repeated plain option reads its final word.
fn __parsed_option(parsed: ParsedArgs, name: String) -> String? Never! {
    values :: parsed.options.get(name) ?? return None
    if values.len() == 0 -> return None
    Val(values[values.len() - 1].copy())
}

fn __parsed_option_int(parsed: ParsedArgs, name: String) -> Int? Never! {
    text :: __parsed_option(parsed, name) ?? return None
    value :: Int.parse(text) ?? return None
    Val(value)
}

fn __parsed_option_float(parsed: ParsedArgs, name: String) -> Float? Never! {
    text :: __parsed_option(parsed, name) ?? return None
    value :: Float.parse(text) ?? return None
    Val(value)
}

fn __parsed_options(parsed: ParsedArgs, name: String) -> [String] Never! { (parsed.options.get(name) ?? [String]{}).copy() }

fn __parsed_positional(parsed: ParsedArgs, index: Int) -> String? Never! {
    if index < 0 || index >= parsed.positionals.len() -> return None
    Val(parsed.positionals[index].copy())
}

fn __parsed_subcommand(parsed: ParsedArgs) -> String? Never! { parsed.subcommand.copy() }
