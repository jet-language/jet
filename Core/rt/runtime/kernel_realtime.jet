// Rust: crates/jet-codegen/src/Prelude/Core/Realtime.rs:182
pub fn jet_rt_deadline_offset_ns(rate_hz: I64, frames_per_buffer: I64, index: U128) -> I64 {
    if rate_hz <= 0 || frames_per_buffer <= 0 -> return 0
    frame_numerator :: (frames_per_buffer as U128).saturating_mul(JET_REALTIME_NANOS_PER_SECOND)
    numerator :: frame_numerator.saturating_mul(index)
    numerator.checked_div(rate_hz as U128).unwrap_or(U128.MAX).min(I64.MAX as U128) as I64
}
// Rust: crates/jet-codegen/src/Prelude/Core/Realtime.rs:194
fn jet_rt_deadline(start: JetInstant, start_identity: I64, rate_hz: I64,
    frames_per_buffer: I64, index: U128) -> (JetInstant, I64) {
    offset :: jet_rt_deadline_offset_ns(rate_hz, frames_per_buffer, index)
    (start.plus_duration_ns(offset), start_identity.saturating_add(offset))
}
// Rust: crates/jet-codegen/src/Prelude/Core/Realtime.rs:208
fn jet_rt_atomic_saturating_add(value: &AtomicI64, increment: I64) -> {
    // GATE #4565: kernel primitive
    #Unsafe("CAS update preserves saturation without lost concurrent increments") {
        _ :: value.fetch_update(Ordering.AcqRel, Ordering.Acquire, fn(current) { Val(current.saturating_add(increment)) })
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Realtime.rs:219
fn jet_rt_atomic_max(value: &AtomicI64, candidate: I64) -> {
    // GATE #4565: kernel primitive
    #Unsafe("weak CAS retries observed value until scalar maximum is published") {
        current := value.load(Ordering.Acquire)
        while current < candidate {
            match value.compare_exchange_weak(current, candidate, Ordering.AcqRel, Ordering.Acquire) {
                Ok(_) -> return,
                Err(observed) -> current = observed,
            }
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Realtime.rs:234
fn jet_rt_run(shared: Arc<JetRealtimeShared>, callback: (fn(&[F64]) -> ()) + Send, buffer: [F64]) -> {
    (first_deadline, _) :: jet_rt_deadline(shared.start, shared.start_identity,
        shared.requested_rate_hz, shared.requested_frames, 1)
    schedule := JetRealtimeSchedule{start: shared.start, next_deadline: first_deadline, end: None}
    callback_index := U128{1}
    // GATE #4565: kernel primitive
    #Unsafe("worker retains callback and reusable buffer; release/acquire publishes bounded facts; unwind cancels") {
        while !shared.cancelled.load(Ordering.Acquire) {
            deadline_identity :: shared.next_deadline_identity.load(Ordering.Acquire)
            jet_time_sleep_until(&schedule.next_deadline)
            if shared.cancelled.load(Ordering.Acquire) -> break
            started_identity :: jet_time_monotonic_now_ns()
            lateness :: started_identity.saturating_sub(deadline_identity).max(0)
            if lateness > 0 {
                jet_rt_atomic_saturating_add(&shared.missed, 1)
                jet_rt_atomic_max(&shared.max_lateness_ns, lateness)
            }
            callback_ok :: native_panic.catch_unwind(native_panic.AssertUnwindSafe(fn() { callback(&buffer) })).is_ok()
            if !callback_ok {
                shared.cancelled.store(true, Ordering.Release)
                break
            }
            callback_skipped :: shared.callback_skipped.swap(false, Ordering.AcqRel)
            if callback_skipped {
                if lateness == 0 { jet_rt_atomic_saturating_add(&shared.missed, 1) }
            } else {
                jet_rt_atomic_saturating_add(&shared.completed_callbacks, 1)
                jet_rt_atomic_saturating_add(&shared.completed_frames, shared.requested_frames)
            }
            callback_index = callback_index.saturating_add(1)
            next_index :: callback_index.min(U64.MAX as U128) as U64
            shared.next_callback.store(next_index, Ordering.Release)
            (next_deadline, next_identity) :: jet_rt_deadline(schedule.start, shared.start_identity,
                shared.requested_rate_hz, shared.requested_frames, callback_index)
            schedule.next_deadline = next_deadline
            shared.next_deadline_identity.store(next_identity, Ordering.Release)
        }
        schedule.end = Val(JetInstant.now())
        if schedule.end.is_some() {
            end_identity :: jet_time_monotonic_now_ns()
            shared.end_identity.store(end_identity, Ordering.Release)
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Realtime.rs:338
struct JetRealtimeSchedule { start: JetInstant, next_deadline: JetInstant, end: JetInstant? }
// Rust: crates/jet-codegen/src/Prelude/Core/Realtime.rs:347
pub fn jet_rt_callback(rate_hz: I64, frames_per_buffer: I64,
    callback: (fn(&[F64]) -> ()) + Send) -> JetRealtimeStream {
    // GATE #4565: kernel primitive
    skipped :: #Unsafe("own shared nonblocking skip signal before worker starts") { Arc.new(AtomicBool.new(false)) }
    jet_rt_callback_with_skip(rate_hz, frames_per_buffer, ^callback, ^skipped)
}
// Rust: crates/jet-codegen/src/Prelude/Core/Realtime.rs:364
pub fn jet_rt_callback_with_skip(rate_hz: I64, frames_per_buffer: I64,
    callback: (fn(&[F64]) -> ()) + Send, callback_skipped: Arc<AtomicBool>) -> JetRealtimeStream {
    assert(rate_hz > 0, "real-time callback rate must be positive")
    jet_scheduler_world_reject_uncontrolled("foreign")
    assert(frames_per_buffer > 0, "real-time callback frame count must be positive")
    frame_count :: Usize.try_from(frames_per_buffer).expect("real-time callback frame count is outside the platform range")
    buffer :: [F64].filled(frame_count, 0.0)
    start :: JetInstant.now()
    start_identity :: jet_time_monotonic_now_ns()
    (_, first_deadline_identity) :: jet_rt_deadline(start, start_identity, rate_hz, frames_per_buffer, 1)
    // GATE #4565: kernel primitive
    #Unsafe("owned worker captures shared state, callback and buffer; mutex serializes the one join handle") {
        callback_skipped.store(false, Ordering.Release)
        shared :: Arc.new(JetRealtimeShared{
            requested_rate_hz: rate_hz, requested_frames: frames_per_buffer, start: start,
            start_identity: start_identity, next_callback: AtomicU64.new(1),
            next_deadline_identity: AtomicI64.new(first_deadline_identity),
            completed_callbacks: AtomicI64.new(0), completed_frames: AtomicI64.new(0),
            missed: AtomicI64.new(0), max_lateness_ns: AtomicI64.new(0), end_identity: AtomicI64.new(0),
            cancelled: AtomicBool.new(false), callback_skipped: ^callback_skipped,
        })
        worker_shared :: shared.clone()
        worker :: thread.spawn(fn() { jet_rt_run(^worker_shared, ^callback, ^buffer) })
        JetRealtimeStream{shared: ^shared, worker: Arc.new(Mutex.new(Val(^worker)))}
    }
}
