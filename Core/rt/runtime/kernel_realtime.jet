        #Unsafe("SPSC producer writes fixed f64 bit cells without allocation or blocking") {
            sequence :: self.write_sequence.load(Ordering.Relaxed)
            read :: self.read_sequence.load(Ordering.Acquire)
            if sequence.wrapping_sub(read) >= self.slots.len() as U64 -> return false
            slot :: &self.slots[(sequence % self.slots.len() as U64) as Usize]
