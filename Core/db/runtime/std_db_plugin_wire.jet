}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1272
pub fn jet_db_decode_observed_execute_result(wire: &String) -> (I64, JetDbQueryRuntimeFacts) DBError! {
    if wire.len() > DB_MAX_WIRE_BYTES { return Err(DBError{message: "database observed execute exceeds the wire-size limit"}) }
    if Val(error) :: db_observed_error(wire) { return Err(^error) }
    body :: wire.strip_prefix("X:").ok_or_else(fn() { DBError{message: "database observed execute has an unknown envelope"} })?
    bytes :: body.as_bytes()
    pos := 0
    affected := None
    elapsed_ms := None
    plan_wire := None
    while pos < bytes.len() {
        (tag, payload) :: db_read_tagged(bytes, &pos).map_err(fn(message) { DBError{message: ^message} })?
        match tag {
            'A' if affected.is_none() -> { affected = Val(payload.parse<I64>().map_err(fn(error) { DBError{message: "database runtime affected row count is invalid"} })?) },
            'D' if elapsed_ms.is_none() -> { elapsed_ms = Val(db_runtime_number(&payload, "elapsed time")?) },
            'P' if plan_wire.is_none() -> { plan_wire = Val(^payload) },
            _ -> return Err(DBError{message: "database observed execute has an invalid or duplicate field"}),
        }
    }
    affected :: affected.ok_or_else(fn() { DBError{message: "database observed execute has no affected row count"} })?
    elapsed_ms :: elapsed_ms.ok_or_else(fn() { DBError{message: "database observed execute has no elapsed time"} })?
    plan_wire :: plan_wire.ok_or_else(fn() { DBError{message: "database observed execute has no plan"} })?
    affected :: U64.try_from(affected).map_err(fn(error) { DBError{message: "database runtime affected row count is negative"} })?
    Ok((I64.try_from(affected).unwrap_or(I64.MAX), JetDbQueryRuntimeFacts{rows_returned: None, rows_affected: Val(affected), elapsed_ms: elapsed_ms, plan: db_decode_plan(&plan_wire)?}))
