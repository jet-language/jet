// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:39
fn render_db_value(value: &DBValue) -> String {
    match value {
        .Null -> "null".to_string(),
        .Int(n) -> n.to_string(),
        .Float(n) -> n.to_string(),
        .Text(text) -> text.clone(),
        .Bool(value) -> value.to_string(),
        .Blob(bytes) -> bytes.debug(),
    }
}
impl DBValue {
