// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1994
fn db_migration_row_text(row: &JetDBRow, key: &String) -> String DBError! {
    row.get(key).ok_or_else(fn() { DBError{message: "migration ledger row has no `{key}` field"} })?
        .text().map_err(fn(message) { DBError{message: ^message} })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2003
fn db_migration_row_u64(row: &JetDBRow, key: &String) -> U64 DBError! {
    value :: row.get(key).ok_or_else(fn() { DBError{message: "migration ledger row has no `{key}` field"} })?
        .int().map_err(fn(message) { DBError{message: ^message} })?
    U64.try_from(value).map_err(fn(error) { DBError{message: "migration ledger `{key}` is negative"} })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2016
fn db_migration_row_optional_text(row: &JetDBRow, key: &String) -> String? DBError! {
    value :: row.get(key).ok_or_else(fn() { DBError{message: "migration ledger row has no `{key}` field"} })?
    if value.is_null() { Ok(None) } else { value.text().map(Val).map_err(fn(message) { DBError{message: ^message} }) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2033
fn db_migration_parse_row(row: &JetDBRow) -> JetMigrationLedgerRow DBError! {
    transition_key :: db_migration_row_text(row, "transition_key")?
    migration_key :: db_migration_row_text(row, "migration_key")?
    operation :: db_migration_row_text(row, "operation")?
    status :: db_migration_row_text(row, "status")?
    step_ids :: db_migration_row_text(row, "step_ids")?
    step_ids :: if step_ids.is_empty() { [] } else { step_ids.split('\n').map(fn(value) { value.to_string() }).collect<[String]>() }
    step_count :: Usize.try_from(db_migration_row_u64(row, "step_count")?).map_err(fn(error) { DBError{message: "migration ledger step count is outside the host range"} })?
    started_unix_ms :: db_migration_row_u64(row, "started_unix_ms")? as U128
    finished_unix_ms :: db_migration_row_u64(row, "finished_unix_ms")? as U128
    lock :: JetMigrationLock.parse(&db_migration_row_text(row, "lock_mode")?)?
    outcome :: JetMigrationOutcome{
        receipt_id: transition_key.clone(), operation: ^operation, status: ^status,
        target: db_migration_row_text(row, "target")?, target_identity: db_migration_row_text(row, "target_identity")?,
        source_identity: db_migration_row_text(row, "source_identity")?, schema_identity: db_migration_row_text(row, "schema_identity")?,
        database_identity: db_migration_row_text(row, "database_identity")?, tool_identity: db_migration_row_text(row, "tool_identity")?,
        from_version: db_migration_row_u64(row, "from_version")?, to_version: db_migration_row_u64(row, "to_version")?,
        step_count: step_count, step_ids: ^step_ids, checksum: db_migration_row_text(row, "checksum")?,
        lock: lock, risk: db_migration_row_text(row, "risk")?, started_unix_ms: started_unix_ms,
        finished_unix_ms: finished_unix_ms, error: db_migration_row_optional_text(row, "error")?,
    }
    Ok(JetMigrationLedgerRow{transition_key: ^transition_key, migration_key: ^migration_key, outcome: ^outcome})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2078
fn db_migration_rows<B: JetDBBackend>(backend: &B) -> [JetMigrationLedgerRow] DBError! {
    rows :: backend.query(&(
        "SELECT transition_key, migration_key, target, target_identity, database_identity, source_identity, schema_identity, tool_identity, operation, status, from_version, to_version, step_count, step_ids, checksum, lock_mode, risk, started_unix_ms, finished_unix_ms, error FROM __jet_migrations ORDER BY sequence".to_string(),
        []), true)?
    rows.iter().map(db_migration_parse_row).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2090
fn db_migration_state_from_rows(query: &JetMigrationStateRequest, rows: &[JetMigrationLedgerRow]) -> JetMigrationState DBError! {
    current_version: U64 := 0
    receipts := [JetMigrationOutcome].new()
    drift := [String].new()
    hash: U64 := 0xcbf29ce484222325
    db_hash_field(&hash, &query.target)
    db_hash_field(&hash, &query.target_identity)
    db_hash_field(&hash, &query.database_identity)
    db_hash_field(&hash, &query.source_identity)
    for row in rows {
        receipt :: &row.outcome
        if receipt.target != query.target { continue }
        receipts.push(receipt.clone())
        db_hash_field(&hash, &row.transition_key)
        db_hash_field(&hash, &receipt.checksum)
        if receipt.target_identity != query.target_identity {
            drift.push("migration transition `{row.transition_key}` has a foreign target identity")
            continue
        }
        if receipt.database_identity != query.database_identity {
            drift.push("migration transition `{row.transition_key}` has a foreign database identity")
            continue
        }
        if receipt.source_identity != query.source_identity {
            drift.push("migration transition `{row.transition_key}` was created from a different migration catalog")
            continue
        }
        if receipt.schema_identity != query.schema_identity {
            drift.push("migration transition `{row.transition_key}` has a mismatched schema identity")
            continue
        }
        if receipt.step_count != receipt.step_ids.len() {
            drift.push("migration transition `{row.transition_key}` has an invalid step count")
            continue
        }
        if receipt.status != "applied" {
            drift.push("migration transition `{row.transition_key}` has unresolved status `{receipt.status}`")
            continue
        }
        match JetMigrationOperation.parse(&receipt.operation) {
            Ok(.Direct) -> {},
            Ok(.Apply | .Rollback) -> {
                if receipt.from_version != current_version {
                    drift.push("migration transition `{row.transition_key}` starts at {receipt.from_version}, but canonical state is at {current_version}")
                    continue
                }
                current_version = receipt.to_version
            },
            Err(error) -> drift.push("migration transition `{row.transition_key}` has unknown operation `{receipt.operation}`"),
        }
    }
    Ok(JetMigrationState{
        target: query.target.clone(), target_identity: query.target_identity.clone(), database_identity: query.database_identity.clone(),
        source_identity: query.source_identity.clone(), schema_identity: query.schema_identity.clone(),
        current_version: current_version, checksum: "migration-state:{hash:016x}", receipts: ^receipts, drift: ^drift,
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2183
fn db_migration_error(message: String) -> DBError { DBError{message: ^message} }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2189
fn db_migration_insert_values(outcome: &JetMigrationOutcome, migration_key: &String) -> SQL {
    step_ids :: outcome.step_ids.join("\n")
    (
        "INSERT INTO __jet_migrations (transition_key, migration_key, target, target_identity, database_identity, source_identity, schema_identity, tool_identity, operation, status, from_version, to_version, step_count, step_ids, checksum, lock_mode, risk, started_unix_ms, finished_unix_ms, error) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)".to_string(),
        [DBValue.Text(outcome.receipt_id.clone()), DBValue.Text(migration_key.to_string()),
        DBValue.Text(outcome.target.clone()), DBValue.Text(outcome.target_identity.clone()),
        DBValue.Text(outcome.database_identity.clone()), DBValue.Text(outcome.source_identity.clone()),
        DBValue.Text(outcome.schema_identity.clone()), DBValue.Text(outcome.tool_identity.clone()),
        DBValue.Text(outcome.operation.clone()), DBValue.Text(outcome.status.clone()),
        DBValue.Int(outcome.from_version as I64), DBValue.Int(outcome.to_version as I64),
        DBValue.Int(outcome.step_count as I64), DBValue.Text(^step_ids), DBValue.Text(outcome.checksum.clone()),
        DBValue.Text(outcome.lock.as_str().to_string()), DBValue.Text(outcome.risk.clone()),
        DBValue.Int(outcome.started_unix_ms as I64), DBValue.Int(outcome.finished_unix_ms as I64),
        outcome.error.as_ref().map(fn(value) { DBValue.Text(value.clone()) }).unwrap_or(DBValue.Null)],
    )
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2223
pub fn jet_db_migration_state<B: JetDBBackend>(backend: &B, query: &JetMigrationStateRequest) -> JetMigrationState DBError! {
    if query.target.is_empty() || query.target_identity.is_empty() || query.database_identity.is_empty()
        || query.source_identity.is_empty() || query.schema_identity.is_empty() {
        return Err(db_migration_error("migration state query has incomplete identity"))
    }
    // Schema bootstrap writes the ledger: acquire SQLite's authoritative write lock.
    if !backend.begin_with_lock(JetMigrationLock.Exclusive) { return Err(db_migration_error("could not begin migration state read")) }
    if Err(error) :: db_migration_ensure_schema(backend) { backend.rollback(); return Err(^error) }
    rows :: match db_migration_rows(backend) { Ok(rows) -> rows, Err(error) -> { backend.rollback(); return Err(^error) } }
    state :: match db_migration_state_from_rows(query, &rows) { Ok(state) -> state, Err(error) -> { backend.rollback(); return Err(^error) } }
    if backend.commit() { Ok(^state) }
    else { backend.rollback(); Err(db_migration_error("could not commit migration state read")) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2266
pub fn jet_db_migration_request<B: JetDBBackend>(backend: &B, request: &JetMigrationRequest) -> JetMigrationOutcome DBError! {
    db_migration_validate_request(request)?
    if !backend.begin_with_lock(request.lock) { return Err(db_migration_error("could not begin migration `{request.migration_key}`")) }
    if Err(error) :: db_migration_ensure_schema(backend) { backend.rollback(); return Err(^error) }
    rows :: match db_migration_rows(backend) { Ok(rows) -> rows, Err(error) -> { backend.rollback(); return Err(^error) } }
    query :: JetMigrationStateRequest{
        target: request.target.clone(), target_identity: request.target_identity.clone(), database_identity: request.database_identity.clone(),
        source_identity: request.source_identity.clone(), schema_identity: request.schema_identity.clone(),
    }
    state :: match db_migration_state_from_rows(&query, &rows) { Ok(state) -> state, Err(error) -> { backend.rollback(); return Err(^error) } }
    if state.drift.len() > 0 {
        backend.rollback()
        return Err(db_migration_error("migration target `{request.target}` has unreconciled state: {state.drift.join("; ")}"))
    }
    checksum :: jet_db_migration_request_checksum(request)
    latest :: rows.iter().filter(fn(row) { row.migration_key == request.migration_key && row.outcome.target == request.target }).next_back()
    if Val(previous) :: latest {
        if previous.outcome.status == "applied" && previous.outcome.operation == request.operation.as_str() {
            if previous.outcome.checksum == checksum {
                if backend.commit() {
                    outcome := previous.outcome.clone()
                    // Steps applied this call: idempotent replay applies none.
                    outcome.step_count = 0
                    outcome.step_ids.clear()
                    return Ok(^outcome)
                }
                backend.rollback()
                return Err(db_migration_error("could not commit idempotent migration read"))
            }
            backend.rollback()
            return Err(db_migration_error("migration `{request.migration_key}` checksum changed"))
        }
    }
    if request.operation != JetMigrationOperation.Direct && request.from_version != state.current_version {
        backend.rollback()
        return Err(db_migration_error("migration target `{request.target}` is at version {state.current_version}, not {request.from_version}"))
    }
    predecessor :: latest.map(fn(row) { &row.transition_key })
    transition_key :: db_migration_transition_key(request, &checksum, predecessor)
    started :: db_migration_now_ms()
    for step in &request.steps {
        if Err(error) :: backend.execute(&step.sql, true) { backend.rollback(); return Err(^error) }
    }
    finished :: db_migration_now_ms()
    outcome :: JetMigrationOutcome{
        receipt_id: ^transition_key, operation: request.operation.as_str().to_string(), status: "applied",
        target: request.target.clone(), target_identity: request.target_identity.clone(), source_identity: request.source_identity.clone(),
        schema_identity: request.schema_identity.clone(), database_identity: request.database_identity.clone(), tool_identity: request.tool_identity.clone(),
        from_version: request.from_version, to_version: request.to_version, step_count: request.steps.len(),
        step_ids: request.steps.iter().map(db_migration_step_id).collect(), checksum: ^checksum, lock: request.lock,
        risk: request.risk.clone(), started_unix_ms: started, finished_unix_ms: finished, error: None,
    }
    if Err(error) :: backend.execute(&db_migration_insert_values(&outcome, &request.migration_key), true) {
        backend.rollback()
        return Err(^error)
    }
    if backend.commit() { Ok(^outcome) }
    else { backend.rollback(); Err(db_migration_error("could not commit migration `{request.migration_key}`")) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2396
// One transaction state machine for ordinary db.transaction calls.
pub trait JetDBBackend {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2397
    fn begin(self: &Self) -> Bool
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2398
    fn begin_with_lock(self: &Self, _lock: JetMigrationLock) -> Bool { self.begin() }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2401
    fn commit(self: &Self) -> Bool
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2402
    fn rollback(self: &Self) ->
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2403
    fn execute(self: &Self, sql: &SQL, allow_schema: Bool) -> I64 DBError!
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2404
    fn query(self: &Self, sql: &SQL, allow_schema: Bool) -> [JetDBRow] DBError!
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2411
pub fn jet_db_transaction<B: JetDBBackend>(backend: &B, label: &String, steps: &[SQL]) -> I64 DBError! {
    if !backend.begin() { return Err(DBError{message: "could not begin transaction: {label}"}) }
    done: I64 := 0
    for sql in steps {
        match backend.execute(sql, false) {
            Ok(value) -> { done += 1 },
            Err(error) -> { backend.rollback(); return Err(^error) },
        }
    }
    if backend.commit() { Ok(done) }
    else { backend.rollback(); Err(DBError{message: "could not commit transaction"}) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:2441
pub fn jet_db_migrate<B: JetDBBackend>(backend: &B, name: &String, steps: &[SQL]) -> I64 DBError! {
    request :: JetMigrationRequest.direct(name.clone(), steps.to_vec())
    jet_db_migration_request(backend, &request).map(fn(outcome) { outcome.step_count as I64 })
}

