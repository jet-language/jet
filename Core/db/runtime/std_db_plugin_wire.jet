            'L' if truncated.is_none() -> { truncated = Val(db_runtime_bool(&payload, "truncation flag")?) },
            'P' if plan_wire.is_none() -> { plan_wire = Val(^payload) },
            _ -> return Err(DBError{message: "database EXPLAIN has an invalid or duplicate field"}),
        }
