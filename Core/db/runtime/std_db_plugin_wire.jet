//RS // ── core.db wire codec ──────────────────────────────────────────────────────
//RS // The FFI bridge crate (built only when a program uses `core.db`, Source/FFI.rs)
//RS // and this always-compiled prelude are two independently built Rust crates —
//RS // they can't share types, so bind params and result rows cross that boundary as
//RS // plain `String`s in a small tagged-length wire format (mirrored byte-for-byte
//RS // in Source/Prelude/DB.rs). A value is `<tag><decimal-length>:<payload-bytes>`;
//RS // a list is a decimal item count + `:` + that many back-to-back items. Every
//RS // length is a byte count, so arbitrary text — including an "injection-looking"
//RS // literal — round-trips exactly with no escaping. `Blob` payloads use an ASCII
//RS // hexadecimal envelope so arbitrary bytes remain lossless across the String
//RS // boundary.
//RS // parity: guard tests/corelib.rs::core_db_implements_driver_trait
//RS fn db_encode_tagged(tag: char, payload: &str) -> String {
//RS     format!("{tag}{}:{payload}", payload.len())
//RS }
//RS 
//RS fn db_hex_encode(bytes: &[u8]) -> String {
//RS     const HEX: &[u8; 16] = b"0123456789abcdef";
//RS     let mut out = String::with_capacity(bytes.len() * 2);
//RS     for byte in bytes {
//RS         out.push(HEX[(byte >> 4) as usize] as char);
//RS         out.push(HEX[(byte & 0x0f) as usize] as char);
//RS     }
//RS     out
//RS }
//RS 
//RS pub fn jet_db_encode_params(params: &Vec<DBValue>) -> String {
//RS     let mut out = String::new();
//RS     out.push_str(&params.len().to_string());
//RS     out.push(':');
//RS     for p in params {
//RS         out.push_str(&match p {
//RS             DBValue::Null => db_encode_tagged('N', ""),
//RS             DBValue::Int(n) => db_encode_tagged('I', &n.to_string()),
//RS             DBValue::Float(f) => db_encode_tagged('F', &f.to_string()),
//RS             DBValue::Text(s) => db_encode_tagged('T', s),
//RS             DBValue::Bool(b) => db_encode_tagged('B', if *b { "1" } else { "0" }),
//RS             DBValue::Blob(bytes) => db_encode_tagged('X', &db_hex_encode(bytes)),
//RS         });
//RS     }
//RS     out
//RS }
//RS 
