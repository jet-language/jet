    "transition:{hash:016x}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1874
fn db_migration_now_ms() -> U128 { U128.try_from(jet_std_time_now()).unwrap_or(0) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1878
fn db_migration_validate_request(request: &JetMigrationRequest) -> () DBError! {
    for (name, value) in [
        ("migration key", &request.migration_key), ("target", &request.target),
        ("target identity", &request.target_identity), ("database identity", &request.database_identity),
        ("source identity", &request.source_identity), ("schema identity", &request.schema_identity),
        ("tool identity", &request.tool_identity), ("risk", &request.risk),
    ] {
        if value.is_empty() || value.chars().any(Char.is_control) { return Err(DBError{message: "migration {name} is empty or contains control characters"}) }
    }
    if request.operation == JetMigrationOperation.Apply && request.to_version <= request.from_version {
        return Err(DBError{message: "migration apply target version must be ahead of its source"})
    }
    if request.operation == JetMigrationOperation.Rollback && request.to_version >= request.from_version {
        return Err(DBError{message: "migration rollback target version must be below its source"})
    }
    if request.steps.len() > I64.MAX as Usize || request.from_version > I64.MAX as U64 || request.to_version > I64.MAX as U64 {
        return Err(DBError{message: "migration request exceeds the SQLite integer range"})
    }
    previous := 0
    for step in &request.steps {
        if step.ordinal == 0 || step.ordinal <= previous { return Err(DBError{message: "migration step ordinals must be positive and increasing"}) }
        previous = step.ordinal
        if step.sql.0.trim().is_empty() || step.sql.0.contains(TEXT_NUL) || step.sql.0.chars().any(Char.is_control)
            || step.risk.is_empty() || step.risk.chars().any(Char.is_control) {
            return Err(DBError{message: "migration step contains empty or invalid SQL metadata"})
        }
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1939
const MIGRATION_LEDGER_SCHEMA: String = "CREATE TABLE IF NOT EXISTS __jet_migrations (sequence INTEGER PRIMARY KEY AUTOINCREMENT, transition_key TEXT NOT NULL UNIQUE, migration_key TEXT NOT NULL, target TEXT NOT NULL, target_identity TEXT NOT NULL, database_identity TEXT NOT NULL, source_identity TEXT NOT NULL, schema_identity TEXT NOT NULL, tool_identity TEXT NOT NULL, operation TEXT NOT NULL, status TEXT NOT NULL, from_version INTEGER NOT NULL, to_version INTEGER NOT NULL, step_count INTEGER NOT NULL, step_ids TEXT NOT NULL, checksum TEXT NOT NULL, lock_mode TEXT NOT NULL, risk TEXT NOT NULL, started_unix_ms INTEGER NOT NULL, finished_unix_ms INTEGER NOT NULL, error TEXT)"
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1941
fn db_migration_ensure_schema<B: JetDBBackend>(backend: &B) -> () DBError! {
    _ :: backend.execute(&(MIGRATION_LEDGER_SCHEMA.to_string(), []), true)?
    columns :: backend.query(&("PRAGMA table_info(__jet_migrations)".to_string(), []), true)?
    canonical :: ["sequence", "transition_key", "migration_key", "target", "target_identity",
        "database_identity", "source_identity", "schema_identity", "tool_identity", "operation",
        "status", "from_version", "to_version", "step_count", "step_ids", "checksum", "lock_mode",
        "risk", "started_unix_ms", "finished_unix_ms", "error"]
    if columns.len() != canonical.len() || columns.iter().zip(canonical).any(fn((row, expected)) {
        !row.get("name").and_then(fn(value) { value.text().ok() }).is_some_and(fn(name) { name == expected })
    }) { return Err(DBError{message: "migration ledger uses a non-canonical schema"}) }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1988
