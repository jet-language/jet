// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:820
pub fn jet_db_apply_compiled_migration_policy_with_proof(sql: &SQL, table: &String, compiled: JetRowPolicyExpr, user: &String) -> JetDBPolicyApplication DBError! {
