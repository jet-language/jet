// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:829
fn jet_db_policy_application(sql: SQL, table: &String, compiled: JetRowPolicyExpr, operation: &String, user: &String,
    user_bind_index: Usize?) -> JetDBPolicyApplication {
    JetDBPolicyApplication{sql: ^sql, proof: JetDBPolicyProof{table: table.to_string(), operation: operation.to_string(),
        predicate: compiled.sql_predicate().to_string(), user: user.to_string(), user_bind_index: user_bind_index}}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:849
fn jet_db_apply_policy_inner(sql: &SQL, table: &String, compiled: JetRowPolicyExpr, user: &String, allow_schema: Bool) -> JetDBPolicyApplication DBError! {
    policy_table :: table
    sql_text :: &sql.0
    params :: &sql.1
    if sql_text.len() > 1024 * 1024 || sql_text.chars().any(fn(ch) { ch == ';' || ch as U32 == 0 || (ch.is_control() && !ch.is_whitespace()) }) {
        return Err(DBError{message: "policy-scoped SQL must be one statement without control characters"})
    }
    if db_sql_contains_comment(sql_text) { return Err(DBError{message: "policy-scoped SQL cannot contain comments"}) }
    trimmed_user := user.trim() // #4303
    if trimmed_user.is_empty() || user.len() > 1024 * 1024 || user.chars().any(fn(ch) { ch.is_control() }) {
        return Err(DBError{message: "policy user identity is empty, too long, or contains control characters"})
    }
    tokens :: db_sql_tokens(sql_text)
    first :: match tokens.first() { Val(token) -> &token.2, None -> return Err(DBError{message: "policy-scoped SQL is empty"}) }
    if db_sql_is_migration_metadata(sql_text) {
        if !allow_schema { return Err(DBError{message: "migration metadata is managed only by db.migrate"}) }
        return Ok(jet_db_policy_application(sql.clone(), policy_table, compiled, "migration-metadata", user, None))
    }
    kind :: first.as_str()
    if kind != "select" && kind != "update" && kind != "delete" && kind != "insert" {
        if kind == "create" || kind == "alter" || kind == "drop" || kind == "pragma" || kind == "begin" || kind == "commit" || kind == "rollback" {
            if allow_schema { return Ok(jet_db_policy_application(sql.clone(), policy_table, compiled, "migration-schema", user, None)) }
            return Err(DBError{message: "schema and transaction-control SQL is only allowed in db.migrate or through the scope transaction controls"})
        }
        return Err(DBError{message: "row policy supports SELECT, INSERT, UPDATE, and DELETE only"})
    }
    expected_table :: policy_table.to_ascii_lowercase()
    if db_sql_target_table(&tokens, kind).as_deref() != Val(expected_table.as_str()) {
        return Err(DBError{message: "policy scope targets table `{policy_table}`"})
    }
    if !db_sql_simple_target(sql_text, &tokens, kind) {
        return Err(DBError{message: "policy-scoped SQL must name one simple target table without joins or subqueries"})
    }
    if !compiled.requires_owner_filter() { return Ok(jet_db_policy_application(sql.clone(), policy_table, compiled, kind, user, None)) }
    if kind == "insert" {
        (columns, owner_index) :: match db_sql_insert_columns_and_values(sql_text, &tokens) {
            Val(value) -> value,
            None -> return Err(DBError{message: "owner policy requires INSERT columns and `?` values with an owner column"}),
        }
        if columns.len() != params.len() { return Err(DBError{message: "owner policy INSERT bind count does not match its columns"}) }
        scoped_params := params.clone()
        scoped_params[owner_index] = DBValue.Text(user.to_string())
        return Ok(jet_db_policy_application((sql_text.to_string(), ^scoped_params), policy_table, compiled, kind, user, Val(owner_index)))
    }
    if kind == "update" && db_sql_update_mutates_owner(&tokens) { return Err(DBError{message: "owner policy does not allow changing the owner column"}) }
    where_token :: tokens.iter().find(fn(token) { token.2 == "where" }).map(fn(token) { (token.0, token.1) })
    insertion :: where_token.and_then(fn(pair) { db_sql_clause_start(&tokens, pair.1) })
        .or_else(fn() { db_sql_clause_start(&tokens, 0) }).unwrap_or_else(fn() { sql_text.len() })
    user_index :: db_sql_placeholder_count(&sql_text[..insertion])
    if user_index > params.len() { return Err(DBError{message: "policy-scoped SQL bind count does not match its placeholders"}) }
    scoped_params := params.clone()
    scoped_params.insert(user_index, DBValue.Text(user.to_string()))
    (head, tail) :: sql_text.split_at(insertion)
    trimmed_tail := tail.trim() // #4303
    suffix :: if trimmed_tail.is_empty() { String.new() } else {
        suffix_text := tail.trim_start() // #4303
        " {suffix_text}"
    }
    scoped_sql :: if Val((where_start, where_end)) :: where_token {
        condition := sql_text[where_end..insertion].trim() // #4303
        if condition.is_empty() { return Err(DBError{message: "policy-scoped SQL has an empty WHERE clause"}) }
        "{sql_text[..where_start]}WHERE ({condition}) AND owner = ?{suffix}"
    } else {
        trimmed_head := head.trim_end() // #4303
        "{trimmed_head} WHERE owner = ?{suffix}"
    }
