    pub fn is_null(self: &Self) -> Bool { self == DBValue.Null }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:54
    pub fn int(self: &Self) -> I64 Err! {
        match self { .Int(n) -> Ok(*n), _ -> Err("expected an int, got {render_db_value(self)}") }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:60
    pub fn float(self: &Self) -> F64 Err! {
        match self {
            .Float(n) -> Ok(*n), .Int(n) -> Ok(*n as F64),
            _ -> Err("expected a float, got {render_db_value(self)}"),
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:67
    pub fn text(self: &Self) -> String Err! {
        match self { .Text(text) -> Ok(text.clone()), _ -> Err("expected text, got {render_db_value(self)}") }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:73
    pub fn bool(self: &Self) -> Bool Err! {
        // SQLite BOOLEAN query results retain INTEGER 0/1 affinity.
        match self {
            .Bool(value) -> Ok(*value), .Int(0) -> Ok(false), .Int(1) -> Ok(true),
            _ -> Err("expected a bool, got {render_db_value(self)}"),
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:82
    pub fn blob(self: &Self) -> [U8] Err! {
        match self { .Blob(bytes) -> Ok(bytes.clone()), _ -> Err("expected a blob, got {render_db_value(self)}") }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:91
pub fn jet_db_row_value(row: &JetDBRow, key: &String) -> DBValue DBError! {
