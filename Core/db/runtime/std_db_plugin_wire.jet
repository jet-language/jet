// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:210
const DB_MAX_METADATA_BYTES: Usize = 64 * 1024
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:211
const DB_MAX_METADATA_TABLES: Usize = 256
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:212
const DB_MAX_PLAN_ROWS: Usize = 256
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:214
fn db_read_metadata_field(bytes: &[U8], pos: &Usize) -> String DBError! {
    len_start :: *pos
    loop {
        byte :: match bytes.get(*pos) { Val(value) -> *value, None -> break }
        if byte == b':' { break }
        if !byte.is_ascii_digit() { return Err(DBError{message: "database metadata length is not decimal"}) }
        *pos += 1
    }
    if *pos == len_start || bytes.get(*pos) != Val(&b':') {
        return Err(DBError{message: "database metadata has no field delimiter"})
    }
    length :: std.str.from_utf8(&bytes[len_start..*pos]).ok()
        .and_then(fn(value) { value.parse<Usize>().ok() })
        .ok_or_else(fn() { DBError{message: "database metadata field length is invalid"} })?
    *pos += 1
    end :: (*pos).checked_add(length).ok_or_else(fn() { DBError{message: "database metadata field length overflow"} })?
    value :: bytes.get(*pos..end).ok_or_else(fn() { DBError{message: "database metadata field is truncated"} })?
    *pos = end
    String.from_utf8(value.to_vec()).map_err(fn(error) { DBError{message: "database metadata field is not UTF-8"} })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:251
fn db_metadata_number(value: String, what: &String) -> U64 DBError! {
    value.parse<U64>().map_err(fn(error) { DBError{message: "database metadata {what} is invalid"} })
}
impl JetDbQueryMetadata {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:258
    pub fn from_wire(wire: &String) -> Self DBError! {
        if wire.len() > DB_MAX_METADATA_BYTES { return Err(DBError{message: "database metadata exceeds the wire-size limit"}) }
        bytes :: wire.as_bytes()
        if !bytes.starts_with(b"JDB1:") { return Err(DBError{message: "database metadata has an unknown version"}) }
        pos := 5 as Usize
        source_file :: db_read_metadata_field(bytes, &pos)?
        source_id :: db_read_metadata_field(bytes, &pos)?
        source_start :: db_metadata_number(db_read_metadata_field(bytes, &pos)?, "source span start")?
        source_end :: db_metadata_number(db_read_metadata_field(bytes, &pos)?, "source span end")?
        statement_identity :: db_read_metadata_field(bytes, &pos)?
        table_count :: Usize.try_from(db_metadata_number(db_read_metadata_field(bytes, &pos)?, "table count")?)
            .map_err(fn(error) { DBError{message: "database metadata table count overflows usize"} })?
        if source_file.is_empty() || source_id.is_empty() || statement_identity.is_empty() {
            return Err(DBError{message: "database metadata has an empty source or statement identity"})
        }
        if source_end < source_start { return Err(DBError{message: "database metadata source span is inverted"}) }
        if table_count > DB_MAX_METADATA_TABLES { return Err(DBError{message: "database metadata table count exceeds the limit"}) }
        table_facts := [].with_capacity(table_count)
        for i in 0..table_count {
            table_id :: db_read_metadata_field(bytes, &pos)?
            read :: match db_read_metadata_field(bytes, &pos)?.as_str() {
                "1" -> true, "0" -> false, _ -> return Err(DBError{message: "database metadata read flag is invalid"}),
            }
            write :: match db_read_metadata_field(bytes, &pos)?.as_str() {
                "1" -> true, "0" -> false, _ -> return Err(DBError{message: "database metadata write flag is invalid"}),
            }
            if table_id.is_empty() || (!read && !write) { return Err(DBError{message: "database metadata has an invalid table fact"}) }
            if table_facts.iter().any(fn(fact) { fact.table_id == table_id }) {
                return Err(DBError{message: "database metadata repeats a table fact"})
            }
            table_facts.push(JetDbTableFact{table_id: ^table_id, read: read, write: write})
        }
        if pos != bytes.len() { return Err(DBError{message: "database metadata has trailing bytes"}) }
        Ok(Self{source_id: ^source_id, source_file: ^source_file, source_start: source_start, source_end: source_end,
            statement_identity: ^statement_identity, table_facts: ^table_facts})
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:358
// EXPLAIN accepts only one comment-free SELECT, not CTEs or mutations.
pub fn jet_db_validate_explain_sql(sql: &SQL) -> () DBError! {
    text := sql.0.trim() // #4303
    if text.is_empty() || text.contains(';') || db_sql_contains_comment(text) {
        return Err(DBError{message: "database EXPLAIN accepts one comment-free SELECT"})
    }
    tokens :: db_sql_tokens(text)
    if tokens.first().map(fn(token) { token.2.as_str() }) != Val("select") {
        return Err(DBError{message: "database EXPLAIN accepts read-only SELECT statements only"})
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:379
// The backend cannot receive rewritten SQL without the accompanying policy proof.
#Clone
#Debug
#Equatable
pub struct JetDBPolicyProof { table: String, operation: String, predicate: String, user: String, user_bind_index: Usize? }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:388
#Clone
#Debug
#Equatable
pub struct JetDBPolicyApplication { pub sql: SQL, pub proof: JetDBPolicyProof }
impl JetDBPolicyApplication {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:394
    pub fn into_sql(self: ^Self) -> SQL DBError! {
        row_filter_proved :: self.proof.predicate == "true" || self.proof.operation.starts_with("migration-") ||
            self.proof.user_bind_index.is_some_and(fn(index) { self.sql.1.get(index) == Val(&DBValue.Text(self.proof.user.clone())) })
        if !row_filter_proved { return Err(DBError{message: "row policy proof does not match the rewritten SQL binds"}) }
        if self.proof.predicate == "true" || self.proof.operation.starts_with("migration-") ||
            self.proof.operation == "insert" || self.sql.0.contains("owner = ?") { Ok(^self.sql) }
        else { Err(DBError{message: "row policy proof does not match the rewritten SQL predicate"}) }
    }
}

// The closed RowPolicy owner is included beside this fragment on every tier.
// Public raw text compiles at the boundary; scoped calls consume the compiled enum.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:426
fn db_sql_tokens(sql: &String) -> [(Usize, Usize, String)] {
    bytes :: sql.as_bytes()
    tokens := []
    i := 0 as Usize
    loop {
        if i >= bytes.len() { break }
        if bytes[i] == b'\'' {
            i += 1
            loop {
                if i >= bytes.len() { break }
                if bytes[i] == b'\'' {
                    if bytes.get(i + 1) == Val(&b'\'') { i += 2 }
                    else { i += 1; break }
                } else { i += 1 }
            }
            continue
        }
        if bytes[i].is_ascii_alphanumeric() || bytes[i] == b'_' {
            start :: i
            i += 1
            loop {
                if i >= bytes.len() || !(bytes[i].is_ascii_alphanumeric() || bytes[i] == b'_') { break }
                i += 1
            }
            tokens.push((start, i, sql[start..i].to_ascii_lowercase()))
        } else { i += 1 }
    }
    tokens
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:465
// Reject comments outside string literals; a trailing -- could hide a policy.
fn db_sql_contains_comment(sql: &String) -> Bool {
    bytes :: sql.as_bytes()
    i := 0 as Usize
    loop {
        if i >= bytes.len() { break }
        if bytes[i] == b'\'' {
            i += 1
            loop {
                if i >= bytes.len() { break }
                if bytes[i] == b'\'' {
                    if bytes.get(i + 1) == Val(&b'\'') { i += 2 }
                    else { i += 1; break }
                } else { i += 1 }
            }
            continue
        }
        if bytes.get(i..i + 2) == Val(b"--") || bytes.get(i..i + 2) == Val(b"/*") || bytes.get(i..i + 2) == Val(b"*/") { return true }
        i += 1
    }
    false
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:496
fn db_sql_target_index(tokens: &[(Usize, Usize, String)], kind: &String) -> Usize? {
    keyword :: match kind { "select" -> "from", "delete" -> "from", "insert" -> "into", _ -> kind }
    tokens.iter().position(fn(token) { token.2 == keyword }).and_then(fn(index) { index.checked_add(1) })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:508
fn db_sql_target_table(tokens: &[(Usize, Usize, String)], kind: &String) -> String? {
    index :: db_sql_target_index(tokens, kind)?
    tokens.get(index).map(fn(token) { token.2.clone() })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:520
// Deterministic relation footprint, shared with transaction invalidation.
pub fn jet_db_write_set(steps: &[SQL]) -> String {
    tables := BTreeSet.new()
    for sql in steps {
        trimmed := sql.0.trim() // #4303
        tokens :: db_sql_tokens(trimmed)
        kind :: match tokens.first() { Val(token) -> &token.2, None -> continue }
        table :: match kind.as_str() {
            "insert" -> db_sql_target_table(&tokens, kind),
            "update" -> db_sql_target_table(&tokens, kind),
            "delete" -> db_sql_target_table(&tokens, kind),
            "create", "alter", "drop" -> {
                table_index :: tokens.iter().position(fn(token) { token.2 == "table" }).and_then(fn(index) { index.checked_add(1) })
                table_index.and_then(fn(index) {
                    index := index
                    if kind == "create" || kind == "drop" {
                        loop {
                            word :: tokens.get(index).map(fn(token) { token.2.as_str() })
                            if word != Val("if") && word != Val("not") && word != Val("exists") { break }
                            index = index.checked_add(1)?
                        }
                    }
                    tokens.get(index).map(fn(token) { token.2.clone() })
                })
            },
            _ -> None,
        }
        if Val(table) :: table { _ :: tables.insert(^table) }
    }
    tables.into_iter().collect().join(",")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:559
// Fail closed on aliases, joins or subqueries: an unqualified owner predicate
// cannot prove which relation owns a row.
fn db_sql_simple_target(sql: &String, tokens: &[(Usize, Usize, String)], kind: &String) -> Bool {
    count :: fn(word: &String) { tokens.iter().filter(fn(token) { token.2 == word }).count() }
    if count("join") > 0 || count("union") > 0 || count("with") > 0 || count("except") > 0 ||
        count("intersect") > 0 || count("conflict") > 0 || count("upsert") > 0 || count("replace") > 0 ||
        count("select") > (if kind == "select" { 1 } else { 0 }) ||
        count("from") > (if kind == "select" || kind == "delete" { 1 } else { 0 }) { return false }
    target :: match db_sql_target_index(tokens, kind) { Val(index) -> index, None -> return false }
    target_end :: match tokens.get(target) { Val(token) -> token.1, None -> return false }
    match kind {
        "select", "delete" -> {
            clause :: tokens.iter().skip(target + 1).find(fn(token) {
                word :: token.2.as_str()
                word == "where" || word == "order" || word == "group" || word == "limit" || word == "offset" || word == "returning"
            }).map(fn(token) { token.0 }).unwrap_or(sql.len())
            remainder := sql[target_end..clause].trim() // #4303
            remainder.is_empty()
        },
        "update" -> {
            set :: match tokens.iter().enumerate().skip(target + 1).find(fn(pair) { pair.1.2 == "set" }) {
                Val(pair) -> pair, None -> return false,
            }
            _ :: set.0
            remainder := sql[target_end..set.1.0].trim() // #4303
            remainder.is_empty()
        },
        "insert" -> count("values") == 1 && count("select") == 0,
        _ -> false,
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:617
fn db_sql_insert_columns_and_values(sql: &String, tokens: &[(Usize, Usize, String)]) -> ([String], Usize)? {
    into :: tokens.iter().position(fn(token) { token.2 == "into" })?
    table_end :: tokens.get(into.checked_add(1)?)?.1
    values_index :: tokens.iter().position(fn(token) { token.2 == "values" })?
    column_start :: sql[table_end..].find('(')?.checked_add(table_end)?
    column_end :: sql[column_start..].find(')')?.checked_add(column_start)?
    value_token_end :: tokens.get(values_index)?.1
    value_start :: sql[value_token_end..].find('(')?.checked_add(value_token_end)?
    value_end :: sql[value_start..].find(')')?.checked_add(value_start)?
    columns :: sql[column_start + 1..column_end].split(',').map(fn(value) { value.trim() }).collect()
    values :: sql[value_start + 1..value_end].split(',').map(fn(value) { value.trim() }).collect()
    if columns.is_empty() || columns.len() != values.len() || columns.iter().any(fn(column) {
        column.is_empty() || !column.chars().all(fn(ch) { ch.is_ascii_alphanumeric() || ch == '_' })
    }) || values.iter().any(fn(value) { value != "?" }) { return None }
    owner :: columns.iter().position(fn(column) { column.eq_ignore_ascii_case("owner") })?
    Val((columns.into_iter().map(fn(column) { column.to_ascii_lowercase() }).collect(), owner))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:659
fn db_sql_clause_start(tokens: &[(Usize, Usize, String)], after: Usize) -> Usize? {
    tokens.iter().filter(fn(token) {
        word :: token.2.as_str()
        word == "order" || word == "group" || word == "limit" || word == "offset" || word == "returning"
    }).find(fn(token) { token.0 > after }).map(fn(token) { token.0 })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:672
fn db_sql_placeholder_count(sql: &String) -> Usize {
    bytes :: sql.as_bytes()
    count := 0 as Usize
    i := 0 as Usize
    loop {
        if i >= bytes.len() { break }
        quote :: match bytes[i] {
            b'\'', b'"', b'`' -> Val(bytes[i]),
            b'[' -> {
                i += 1
                loop { if i >= bytes.len() || bytes[i] == b']' { break }; i += 1 }
                if i < bytes.len() { i += 1 }
                None
            },
            b'?' -> { count += 1; i += 1; None },
            _ -> { i += 1; None },
        }
        quote :: match quote { Val(value) -> value, None -> continue }
        i += 1
        loop {
            if i >= bytes.len() { break }
            if bytes[i] == quote {
                if bytes.get(i + 1) == Val(&quote) { i += 2 }
                else { i += 1; break }
            } else { i += 1 }
        }
    }
    count
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:719
fn db_sql_update_mutates_owner(tokens: &[(Usize, Usize, String)]) -> Bool {
    set_index :: match tokens.iter().position(fn(token) { token.2 == "set" }) { Val(index) -> index, None -> return false }
    end_index :: tokens.iter().enumerate().skip(set_index + 1).find(fn(pair) {
        word :: pair.1.2.as_str()
        word == "where" || word == "order" || word == "group" || word == "limit" || word == "offset" || word == "returning"
    }).map(fn(pair) { pair.0 }).unwrap_or(tokens.len())
    tokens[set_index + 1..end_index].iter().any(fn(token) { token.2 == "owner" })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:740
fn db_sql_is_migration_metadata(sql: &String) -> Bool {
    normalized :: sql.split_whitespace().collect().join(" ").to_ascii_lowercase()
    normalized.starts_with("create table if not exists __jet_migrations") ||
        normalized.starts_with("create table __jet_migrations") ||
        normalized.starts_with("pragma table_info(__jet_migrations") ||
        (normalized.starts_with("select ") && normalized.contains(" from __jet_migrations")) ||
        normalized.starts_with("insert into __jet_migrations")
}
