// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1418
fn db_decode_value(tag: Char, payload: &String) -> DBValue Err! {
    match tag {
        'N' if payload.is_empty() -> Ok(DBValue.Null),
        'I' -> payload.parse<I64>().map(DBValue.Int).map_err(fn(error) { "database integer value is invalid".to_string() }),
        'F' -> {
            value :: payload.parse<F64>().map_err(fn(error) { "database float value is invalid".to_string() })?
            if !value.is_finite() { return Err("database float value is not finite") }
            Ok(DBValue.Float(value))
        },
        'T' -> Ok(DBValue.Text(payload.to_string())),
        'B' -> match payload { "0" -> Ok(DBValue.Bool(false)), "1" -> Ok(DBValue.Bool(true)), _ -> Err("database boolean value is invalid") },
        'X' -> db_hex_decode(payload).map(DBValue.Blob),
        'N' -> Err("database null value has a non-empty payload"),
        _ -> Err("database wire contains an unknown value tag"),
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1447
pub fn jet_db_decode_query_result(wire: &String) -> [JetDBRow] DBError! {
