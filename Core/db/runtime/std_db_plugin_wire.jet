// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1401
fn db_hex_decode(payload: &String) -> [U8] Err! {
    if payload.len() % 2 != 0 { return Err("database blob value has odd hexadecimal length") }
    bytes := [U8].with_capacity(payload.len() / 2)
    for pair in payload.as_bytes().chunks_exact(2) {
        high :: (pair[0] as Char).to_digit(16).ok_or_else(fn() { "database blob value is not hexadecimal".to_string() })?
        low :: (pair[1] as Char).to_digit(16).ok_or_else(fn() { "database blob value is not hexadecimal".to_string() })?
        bytes.push(((high << 4) | low) as U8)
    }
    Ok(^bytes)
