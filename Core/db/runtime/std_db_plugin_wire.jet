// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1728
fn db_hash_field(hash: &U64, value: &String) -> {
    for byte in (value.len() as U64).to_le_bytes() { *hash ^= byte as U64; *hash = hash.wrapping_mul(0x100000001b3) }
    for byte in value.as_bytes() { *hash ^= *byte as U64; *hash = hash.wrapping_mul(0x100000001b3) }
    *hash ^= 0xff
    *hash = hash.wrapping_mul(0x100000001b3)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1741
fn db_hash_value(hash: &U64, value: &DBValue) -> {
    match value {
        .Null -> db_hash_field(hash, "N"),
        .Int(value) -> { db_hash_field(hash, "I"); db_hash_field(hash, &value.to_string()) },
        .Float(value) -> { db_hash_field(hash, "F"); db_hash_field(hash, &value.to_bits().to_string()) },
        .Text(value) -> { db_hash_field(hash, "T"); db_hash_field(hash, value) },
        .Bool(value) -> db_hash_field(hash, if *value { "B1" } else { "B0" }),
        .Blob(value) -> {
            db_hash_field(hash, "X")
            for byte in value { *hash ^= *byte as U64; *hash = hash.wrapping_mul(0x100000001b3) }
            *hash ^= 0xff
            *hash = hash.wrapping_mul(0x100000001b3)
        },
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1769
fn db_hash_sql(hash: &U64, sql: &SQL) -> {
    db_hash_field(hash, &sql.0)
    db_hash_field(hash, &(sql.1.len() as U64).to_string())
    for value in &sql.1 { db_hash_value(hash, value) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1780
// D-TYPEDSQL-SINK1=A: preserve public db.migrate(name, steps) checksum identity.
pub fn jet_db_migration_checksum(steps: &[SQL]) -> String {
    hash: U64 := 0xcbf29ce484222325
    for sql in steps {
        for b in sql.0.as_bytes() { hash ^= *b as U64; hash = hash.wrapping_mul(0x100000001b3) }
        hash ^= 0xfe
        hash = hash.wrapping_mul(0x100000001b3)
        for param in &sql.1 {
            encoded :: match param {
                .Null -> "N".to_string(), .Int(value) -> "I{value}", .Float(value) -> "F{value}",
                .Text(value) -> "T{value}", .Bool(value) -> "B{if *value { 1 } else { 0 }}",
                .Blob(value) -> "X{db_hex_encode(value)}",
            }
            for b in encoded.as_bytes() { hash ^= *b as U64; hash = hash.wrapping_mul(0x100000001b3) }
            hash ^= 0xfd
            hash = hash.wrapping_mul(0x100000001b3)
        }
        hash ^= 0xff
        hash = hash.wrapping_mul(0x100000001b3)
    }
    "{hash:016x}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1811
pub fn jet_db_migration_request_checksum(request: &JetMigrationRequest) -> String {
    if request.operation == JetMigrationOperation.Direct {
        steps :: request.steps.iter().map(fn(step) { step.sql.clone() }).collect<[SQL]>()
        return jet_db_migration_checksum(&steps)
    }
    hash: U64 := 0xcbf29ce484222325
    db_hash_field(&hash, "jet.db.migration/v2")
    db_hash_field(&hash, request.operation.as_str())
    db_hash_field(&hash, &request.migration_key)
    db_hash_field(&hash, &request.target)
    db_hash_field(&hash, &request.target_identity)
    db_hash_field(&hash, &request.database_identity)
    db_hash_field(&hash, &request.source_identity)
    db_hash_field(&hash, &request.schema_identity)
    db_hash_field(&hash, &request.tool_identity)
    db_hash_field(&hash, &request.from_version.to_string())
    db_hash_field(&hash, &request.to_version.to_string())
    db_hash_field(&hash, request.lock.as_str())
    db_hash_field(&hash, &request.risk)
    db_hash_field(&hash, &(request.steps.len() as U64).to_string())
    for step in &request.steps {
        db_hash_field(&hash, &step.ordinal.to_string())
        db_hash_field(&hash, step.lock.as_str())
        db_hash_field(&hash, &step.risk)
        db_hash_sql(&hash, &step.sql)
        if Val(inverse) :: &step.inverse_sql { db_hash_field(&hash, "inverse"); db_hash_sql(&hash, inverse) }
        else { db_hash_field(&hash, "no-inverse") }
    }
    "migration-v2:{hash:016x}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1850
fn db_migration_step_id(step: &JetMigrationSql) -> String {
    hash: U64 := 0xcbf29ce484222325
    db_hash_field(&hash, &step.ordinal.to_string())
    db_hash_field(&hash, step.lock.as_str())
    db_hash_field(&hash, &step.risk)
    db_hash_sql(&hash, &step.sql)
    "step:{hash:016x}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1859
fn db_migration_transition_key(request: &JetMigrationRequest, checksum: &String, predecessor: (&String)?) -> String {
    hash: U64 := 0xcbf29ce484222325
    db_hash_field(&hash, "transition")
    db_hash_field(&hash, request.operation.as_str())
    db_hash_field(&hash, &request.migration_key)
    db_hash_field(&hash, &request.target_identity)
    db_hash_field(&hash, checksum)
