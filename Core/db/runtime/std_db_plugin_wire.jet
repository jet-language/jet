    timed_out :: timed_out.ok_or_else(fn() { DBError{message: "database EXPLAIN has no timeout flag"} })?
    truncated :: truncated.ok_or_else(fn() { DBError{message: "database EXPLAIN has no truncation flag"} })?
    plan_wire :: plan_wire.ok_or_else(fn() { DBError{message: "database EXPLAIN has no plan"} })?
