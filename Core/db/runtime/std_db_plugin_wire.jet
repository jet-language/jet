// Tagged-length codec: lengths count UTF-8 bytes, not characters. Blob payload
// bytes use hexadecimal so all payloads cross the text wire without loss.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1037
fn db_encode_tagged(tag: Char, payload: &String) -> String { "{tag}{payload.len()}:{payload}" }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1041
fn db_hex_encode(bytes: &[U8]) -> String {
    const HEX: [U8#16] = b"0123456789abcdef"
    out := String.with_capacity(bytes.len() * 2)
    for byte in bytes { out.push(HEX[(byte >> 4) as Usize] as Char); out.push(HEX[(byte & 0x0f) as Usize] as Char) }
    out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1051
pub fn jet_db_encode_params(params: &[DBValue]) -> String {
    out := String.new()
    out.push_str(params.len().to_string())
    out.push(':')
    for value in params {
        out.push_str(match value {
            .Null -> db_encode_tagged('N', ""),
            .Int(n) -> db_encode_tagged('I', n.to_string()),
            .Float(n) -> db_encode_tagged('F', n.to_string()),
            .Text(text) -> db_encode_tagged('T', text),
            .Bool(value) -> db_encode_tagged('B', if *value { "1" } else { "0" }),
            .Blob(bytes) -> db_encode_tagged('X', db_hex_encode(bytes)),
        })
    }
    out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1068
const DB_MAX_WIRE_BYTES: Usize = 64 * 1024 * 1024
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1069
const DB_MAX_ROWS: Usize = 1_000_000
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1070
const DB_MAX_COLUMNS: Usize = 100_000
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1072
fn db_read_tagged(bytes: &[U8], pos: &Usize) -> (Char, String) Err! {
    tag :: *bytes.get(*pos).ok_or_else(fn() { "database wire ended before a value tag".to_string() })? as Char
    *pos += 1
    len_start :: *pos
    loop {
        byte :: match bytes.get(*pos) { Val(value) -> *value, None -> break }
        if byte == b':' { break }
        if !byte.is_ascii_digit() { return Err("database wire length is not decimal") }
        *pos += 1
    }
    if *pos == len_start || bytes.get(*pos) != Val(&b':') { return Err("database wire has no value length delimiter") }
    length :: std.str.from_utf8(&bytes[len_start..*pos])
        .map_err(fn(error) { "database wire length is not UTF-8".to_string() })?
        .parse<Usize>().map_err(fn(error) { "database wire value length overflows usize".to_string() })?
    *pos += 1
    end :: (*pos).checked_add(length).ok_or_else(fn() { "database wire value length overflows the input".to_string() })?
    payload :: std.str.from_utf8(bytes.get(*pos..end).ok_or_else(fn() { "database wire value is truncated".to_string() })?)
        .map_err(fn(error) { "database wire value is not UTF-8".to_string() })?.to_string()
    *pos = end
    Ok((tag, ^payload))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1108
fn db_runtime_number(payload: &String, what: &String) -> U64 DBError! {
    payload.parse<U64>().map_err(fn(error) { DBError{message: "database runtime {what} is invalid"} })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1114
fn db_runtime_bool(payload: &String, what: &String) -> Bool DBError! {
    match payload { "0" -> Ok(false), "1" -> Ok(true), _ -> Err(DBError{message: "database runtime {what} is invalid"}) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1124
fn db_decode_plan(payload: &String) -> [JetDbQueryPlanFact] DBError! {
    bytes :: payload.as_bytes()
    colon :: match bytes.iter().position(fn(byte) { *byte == b':' }) {
        Val(value) -> value, None -> return Err(DBError{message: "database runtime plan is missing its row-count delimiter"}),
    }
    count :: std.str.from_utf8(&bytes[..colon]).ok().and_then(fn(value) { value.parse<Usize>().ok() })
        .ok_or_else(fn() { DBError{message: "database runtime plan row count is invalid"} })?
    if count > DB_MAX_PLAN_ROWS { return Err(DBError{message: "database runtime plan row count exceeds the limit"}) }
    pos := colon + 1
    plan := [JetDbQueryPlanFact].with_capacity(count)
    for _ in 0..count {
        ordinal := None
        parent := None
        operation := None
        relation := None
        index := None
        for _ in 0..5 {
            (tag, value) :: db_read_tagged(bytes, &pos).map_err(fn(message) { DBError{message: ^message} })?
            match tag {
                'I' if ordinal.is_none() -> { ordinal = Val(db_runtime_number(&value, "plan ordinal")?) },
                'P' if parent.is_none() -> { parent = Val(db_runtime_number(&value, "plan parent")?) },
                'O' if operation.is_none() && !value.is_empty() -> { operation = Val(^value) },
                'T' if relation.is_none() -> { relation = (!value.is_empty()).then_some(^value) },
                'X' if index.is_none() -> { index = (!value.is_empty()).then_some(^value) },
                _ -> return Err(DBError{message: "database runtime plan has an invalid or duplicate field"}),
            }
        }
        plan.push(JetDbQueryPlanFact{
            ordinal: ordinal.ok_or_else(fn() { DBError{message: "database runtime plan has no ordinal"} })?,
            parent: parent.ok_or_else(fn() { DBError{message: "database runtime plan has no parent"} })?,
            operation: operation.ok_or_else(fn() { DBError{message: "database runtime plan has no operation"} })?,
            relation: ^relation, index: ^index,
        })
    }
    if pos != bytes.len() { return Err(DBError{message: "database runtime plan has trailing bytes"}) }
    Ok(^plan)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1193
fn db_observed_error(wire: &String) -> DBError? {
    wire.strip_prefix("E:").map(fn(message) { DBError{message: message.to_string()} })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1200
pub fn jet_db_decode_observed_query_result(wire: &String) -> ([JetDBRow], JetDbQueryRuntimeFacts) DBError! {
    if wire.len() > DB_MAX_WIRE_BYTES { return Err(DBError{message: "database observed query exceeds the wire-size limit"}) }
    if Val(error) :: db_observed_error(wire) { return Err(^error) }
    body :: wire.strip_prefix("Q:").ok_or_else(fn() { DBError{message: "database observed query has an unknown envelope"} })?
    bytes :: body.as_bytes()
    pos := 0
    rows_wire := None
    row_count := None
    elapsed_ms := None
    plan_wire := None
    while pos < bytes.len() {
        (tag, payload) :: db_read_tagged(bytes, &pos).map_err(fn(message) { DBError{message: ^message} })?
        match tag {
            'R' if rows_wire.is_none() -> { rows_wire = Val(^payload) },
            'N' if row_count.is_none() -> { row_count = Val(db_runtime_number(&payload, "row count")?) },
            'D' if elapsed_ms.is_none() -> { elapsed_ms = Val(db_runtime_number(&payload, "elapsed time")?) },
            'P' if plan_wire.is_none() -> { plan_wire = Val(^payload) },
            _ -> return Err(DBError{message: "database observed query has an invalid or duplicate field"}),
        }
    }
    rows_wire :: rows_wire.ok_or_else(fn() { DBError{message: "database observed query has no rows"} })?
    rows :: jet_db_decode_query_result(&"O:{rows_wire}")?
    actual_count :: row_count.ok_or_else(fn() { DBError{message: "database observed query has no row count"} })?
    if actual_count != rows.len() as U64 { return Err(DBError{message: "database observed query row count does not match its rows"}) }
    elapsed_ms :: elapsed_ms.ok_or_else(fn() { DBError{message: "database observed query has no elapsed time"} })?
    plan_wire :: plan_wire.ok_or_else(fn() { DBError{message: "database observed query has no plan"} })?
