            (tag, name) :: db_read_tagged(bytes, &pos).map_err(fn(message) { DBError{message: ^message} })?
            if tag != 'C' { return Err(DBError{message: "database row column has an invalid tag"}) }
            (vtag, vpayload) :: db_read_tagged(bytes, &pos).map_err(fn(message) { DBError{message: ^message} })?
            value :: db_decode_value(vtag, &vpayload).map_err(fn(message) { DBError{message: ^message} })?
            if row.insert(^name, ^value).is_some() { return Err(DBError{message: "database row contains a duplicate column"}) }
        }
        rows.push(^row)
        if pos <= row_start { return Err(DBError{message: "database row decoder made no progress"}) }
    }
    if pos != bytes.len() { return Err(DBError{message: "database result contains trailing wire bytes"}) }
    Ok(^rows)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1539
pub fn jet_db_first_row(rows: [JetDBRow]) -> JetOutcome<JetDBRow, JetAbsent> {
    jet_outcome_of(rows.into_iter().next())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:1544
pub fn jet_db_decode_execute_result(wire: &String) -> I64 DBError! {
    if wire.len() > DB_MAX_WIRE_BYTES { return Err(DBError{message: "database execute result exceeds the wire-size limit"}) }
    if Val(n) :: wire.strip_prefix("O:") {
        count :: n.parse<I64>().map_err(fn(error) { DBError{message: "database affected-row count is invalid"} })?
        if count < 0 { return Err(DBError{message: "database affected-row count is negative"}) }
        return Ok(count)
    }
    msg :: wire.strip_prefix("E:").unwrap_or(wire)
    if msg.is_empty() { return Err(DBError{message: "database execute result has no error message"}) }
    Err(DBError{message: msg.to_string()})
}
