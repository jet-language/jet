// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DBPluginWire.rs:116
// Preserve caller column order and skip missing fields; host supplies conversion.
pub fn jet_db_row_project<T>(row: &JetDBRow, names: &[(String, String)], convert: fn(&DBValue) -> T) -> [(String, T)] {
    names.iter().filter_map(fn((db_name, json_name)) {
        row.get(db_name).map(fn(value) { (json_name.to_string(), convert(value)) })
    }).collect()
}
