// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HandlesRaylib.rs:918
fn jet_raylib_key_code(name: &String) -> I32 {
    match name {
        "Space" | "space" -> 32, "Enter" | "enter" -> 257,
        "Escape" | "escape" | "Esc" | "esc" -> 256,
        "Right" | "right" -> 262, "Left" | "left" -> 263,
        "Down" | "down" -> 264, "Up" | "up" -> 265,
        "A" | "a" -> 65, "D" | "d" -> 68, "S" | "s" -> 83, "W" | "w" -> 87,
        _ -> -1
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HandlesRaylib.rs:935
fn jet_raylib_key_down(name: &String) -> Bool {
    key :: jet_raylib_key_code(name)
    if key < 0 -> return false
    // GATE #4565: kernel primitive
    #Unsafe("sample native key only for a live window; consumed debugger input is not gameplay input") {
        if JET_RAYLIB_WINDOW_OPEN.load(Ordering.SeqCst) {
            if Val(api) :: jet_raylib_api() {
                pressed :: (api.is_key_down)(key)
                if jet_devtools_native_input(.Key{code: name.clone(), pressed}) -> return false
                return pressed
            }
        }
    }
    false
}
