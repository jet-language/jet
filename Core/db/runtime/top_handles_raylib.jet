fn jet_db_pool_hooks() -> JetDbPoolHooks<JetDbConnection> {
    JetDbPoolHooks.new(fn(path: &String) {
        // GATE #4565: kernel primitive
        handle :: #Unsafe("pool opening calls the real native database outside the pool lock") { db_kernel.jet_db_open(path) }
        if handle == 0 -> Err(jet_db_pool_error("database pool backend open failed"))
        else -> Ok(JetDbConnection{handle})
    }, fn(connection: &JetDbConnection) {
        // GATE #4565: kernel primitive
        #Unsafe("check health of the leased database handle") { db_kernel.jet_db_health(connection.handle) }
    }, fn(connection: &JetDbConnection) {
        // GATE #4565: kernel primitive
        #Unsafe("reset transaction state before database reuse") { db_kernel.jet_db_reset(connection.handle) }
    }, fn(connection: JetDbConnection) {
        // GATE #4565: kernel primitive
        #Unsafe("consume and close the pool driver handle exactly once") { _ :: db_kernel.jet_db_close(connection.handle) }
    })
}
