// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HandlesRaylib.rs:322
#Derive(Clone, Copy, Debug)
struct JetPlugin { handle: U64 }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HandlesRaylib.rs:331
// The original macro's typed wire boundary is owned here, not expanded through Rust.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HandlesRaylib.rs:333
fn jet_plugin_load(path: &String, authority_wire: &String) -> JetPlugin {
    wire :: plugin_kernel.jet_plugin_load(path, authority_wire)
    match wire.strip_prefix("O:").and_then(fn(value) { value.parse<U64>().ok() }) {
        Val(handle) if handle != 0 -> JetPlugin{handle}
        _ -> {
            message :: wire.strip_prefix("E:").unwrap_or("plugin load failed")
            jet_runtime_stop("E3001", "", 0, message)
        }
    }
}
