    // GATE #4565: kernel primitive
    #Unsafe("validated gamepad and button codes call the optional native function; debugger consumption wins") {
        if JET_RAYLIB_WINDOW_OPEN.load(Ordering.SeqCst) {
            if Val(api) :: jet_raylib_api() {
                if Val(is_gamepad_button_down) :: api.is_gamepad_button_down {
                    pressed :: is_gamepad_button_down(gamepad, button_code)
                    if jet_devtools_native_input(.Gamepad{gamepad: gamepad as I64, control: button.clone(), pressed}) -> return false
                    return pressed
                }
            }
        }
    }
    false
}
