// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HandlesRaylib.rs:548
fn jet_raylib_draw_native_command(command: &JetDevtoolsNativeDrawCommand) -> {
    // GATE #4565: kernel primitive
    #Unsafe("native raylib pointers require a live window and matching C geometry/color ABI") {
        if !JET_RAYLIB_WINDOW_OPEN.load(Ordering.SeqCst) -> return
        api :: jet_raylib_api() ?? return
        match command {
            .Rectangle{x, y, width, height, color} -> {
                (api.draw_rectangle)(*x, *y, *width, *height, JetRaylibCColor{r: color.red, g: color.green, b: color.blue, a: color.alpha})
            }
            .Text{text, x, y, size, color} -> {
                text_c :: jet_raylib_cstring(text)
                (api.draw_text)(text_c.as_ptr(), *x, *y, (*size).max(1), JetRaylibCColor{r: color.red, g: color.green, b: color.blue, a: color.alpha})
            }
        }
