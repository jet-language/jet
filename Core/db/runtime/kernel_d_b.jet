//RS // DBValue heap record ABI (same 2-slot shape as DataTree): [disc:i64, payload].
//RS const DV_NULL: i64 = 0;
//RS const DV_INT: i64 = 1;
//RS const DV_FLOAT: i64 = 2;
//RS const DV_TEXT: i64 = 3;
//RS const DV_BOOL: i64 = 4;
//RS const DV_BLOB: i64 = 5;
