//RS     /// JIT-local policy capabilities. The token is passed through Cranelift
//RS     /// as the DBScope value; the policy and user never become mutable heap
//RS     /// fields visible to Jet code.
//RS     static DB_SCOPES: std::cell::RefCell<
//RS         HashMap<u64, (u64, String, wire::JetRowPolicyExpr, String, Option<String>)>,
//RS     > = std::cell::RefCell::new(HashMap::new());
