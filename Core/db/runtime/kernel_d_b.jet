//RS     static DB_LEASES: std::cell::RefCell<HashMap<u64, Arc<Mutex<pool::JetDbLease<u64>>>>> =
//RS         std::cell::RefCell::new(HashMap::new());
//RS     /// Direct `core.db` handles are tracked separately from pool drivers. A
//RS     /// console captures these handles without reopening their path.
//RS     static DB_CONNECTIONS: std::cell::RefCell<BTreeSet<u64>> =
//RS         std::cell::RefCell::new(BTreeSet::new());
//RS }
