const JET_DB_POOL_DEFAULT_TIMEOUT_MS: I64 = 30_000
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DbPool.rs:750
fn jet_db_pool_effective_deadline(deadline: I64?) -> I64? {
    // GATE #4565: kernel primitive
    #Unsafe("use current context deadline and wall-clock millisecond primitive without resetting an explicit deadline") {
        match (deadline, jet_ctx_deadline_ms()) {
            (Some(explicit), Some(context)) -> Some(explicit.min(context))
            (Some(explicit), None) -> Some(explicit)
            (None, Some(context)) -> Some(context)
            (None, None) -> Some(jet_std_time_now().saturating_add(JET_DB_POOL_DEFAULT_TIMEOUT_MS))
        }
    }
}
