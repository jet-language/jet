    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DbPool.rs:98
struct JetDbPoolState<D> {
    lifecycle: JetDbPoolLifecycle
    max: USize
    available: [D]
    leased: USize
    opening: USize
    waiters: VecDeque<U64>
    next_ticket: U64
    acquires: U64
    releases: U64
    timeouts: U64
    open_failures: U64
    unhealthy: U64
    replacements: U64
    replacement_failures: U64
}
impl<D> JetDbPoolState<D> {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DbPool.rs:116
    fn new(max: USize) -> Self {
        Self{lifecycle: .Open, max: max, available: [], leased: 0, opening: 0,
            waiters: VecDeque.new(), next_ticket: 0, acquires: 0, releases: 0,
            timeouts: 0, open_failures: 0, unhealthy: 0, replacements: 0, replacement_failures: 0}
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DbPool.rs:135
    fn reserved(self: &Self) -> USize { self.available.len().saturating_add(self.leased).saturating_add(self.opening) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DbPool.rs:142
    fn enqueue_waiter(self: &Self) -> U64 {
        ticket :: self.next_ticket
        self.next_ticket = self.next_ticket.wrapping_add(1)
        self.waiters.push_back(ticket)
        ticket
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DbPool.rs:149
    fn waiter_is_turn(self: &Self, ticket: U64) -> Bool { self.waiters.front().copied() == Some(ticket) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DbPool.rs:153
    fn claim_waiter(self: &Self, ticket: U64) -> {
        debug_assert(self.waiter_is_turn(ticket))
        _ :: self.waiters.pop_front()
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DbPool.rs:158
    fn remove_waiter(self: &Self, ticket: U64) -> {
        if self.waiters.iter().position(fn(queued) { queued == ticket }) == Some(index) {
            _ :: self.waiters.remove(index)
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DbPool.rs:164
    fn mark_drained(self: &Self) -> {
        if self.lifecycle == .Draining and self.available.is_empty() and self.leased == 0 and self.opening == 0 {
            self.lifecycle = .Drained
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DbPool.rs:174
    fn receipt(self: &Self) -> JetDbPoolReceipt {
        // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DbPool.rs:175
        fn count(value: USize) -> I64 { I64.try_from(value).unwrap_or(I64.MAX) }
        // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DbPool.rs:178
        fn events(value: U64) -> I64 { I64.try_from(value).unwrap_or(I64.MAX) }
        JetDbPoolReceipt{lifecycle: self.lifecycle, max: count(self.max), available: count(self.available.len()),
            leased: count(self.leased), opening: count(self.opening),
            ready: self.lifecycle == .Open and self.available.len().saturating_add(self.leased) > 0,
            acquires: events(self.acquires), releases: events(self.releases), timeouts: events(self.timeouts),
            open_failures: events(self.open_failures), unhealthy: events(self.unhealthy),
            replacements: events(self.replacements), replacement_failures: events(self.replacement_failures)}
    }
}
