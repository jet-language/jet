//RS /// Release every native database owner a run created, while the native
//RS /// connection table is still alive. Leases go first so their drivers return
//RS /// to their pools; dropping the pools then closes the pooled drivers, and the
//RS /// remaining direct handles close last. Left to thread-local destruction, a
//RS /// pool could close its drivers after the connection table was destroyed.
//RS pub(crate) fn release_db_resources() {
//RS     DB_SCOPES.with(|scopes| scopes.borrow_mut().clear());
//RS     DB_LEASES.with(|leases| {
//RS         let _ = std::mem::take(&mut *leases.borrow_mut());
//RS     });
//RS     DB_POOLS.with(|pools| {
//RS         let _ = std::mem::take(&mut *pools.borrow_mut());
//RS     });
//RS     let connections = DB_CONNECTIONS.with(|connections| {
//RS         std::mem::take(&mut *connections.borrow_mut())
//RS     });
//RS     for handle in connections {
//RS         let _ = runtime::jet_db_close(handle);
//RS     }
//RS }
