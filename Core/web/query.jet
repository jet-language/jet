// core.web.query — typed live-query state and mutation transitions.
C_MAX_QUERY_KEY :: 256

C_MAX_QUERY_PAYLOAD :: 1048576

C_MAX_QUERY_SUBSCRIBERS :: 1000000


#Error
pub enum WebQueryError {
    Offline
    Conflict
    Invalid
}

pub enum WebQueryStatus {
    Pending
    Fresh
    Stale
    Fetching
    Error
    Offline
}

pub enum WebMutationStatus {
    Idle
    Pending
    Success
    Error
    Settled
}

pub enum WebQueryNetworkMode {
    Online
    Always
    OfflineFirst
}

pub struct WebQueryState {
    pub status: WebQueryStatus
    pub generation: Int
    pub online: Bool
}

pub struct WebQuery {
    pub key: String
    pub data: String
    pub status: WebQueryStatus
    pub error: String
    pub generation: Int
    pub mode: WebQueryNetworkMode
    pub online: Bool
    pub subscribers: Int
}

pub struct WebMutationState {
    pub status: WebMutationStatus
    pub data: String
    pub error: String
}
pub struct WebQuerySeed {
    pub data: String
    pub generation: Int
    pub subscribers: Int
}

pub fn new(key: String, initial: WebQuerySeed) -> WebQuery {
    generation := initial.generation
    if generation < 1 -> generation = 1
    subscribers := initial.subscribers
    if subscribers < 0 -> subscribers = 0
    if subscribers > C_MAX_QUERY_SUBSCRIBERS -> subscribers = C_MAX_QUERY_SUBSCRIBERS
    status := WebQueryStatus.Fresh
    error := ""
    if !valid_key(key) || initial.data.len() > C_MAX_QUERY_PAYLOAD {
        status = WebQueryStatus.Error
        error = "invalid"
    }
    WebQuery{key: ~key, data: initial.data, status: status, error: error, generation: generation, mode: WebQueryNetworkMode.Online, online: true, subscribers: subscribers}
}

pub fn live(key: String, data: String, url: String, loader: fn() -> String) -> WebQuery {
    loaded := data
    if url.len() > 0 -> loaded = loader()
    status := WebQueryStatus.Fresh
    error := ""
    if !valid_key(key) || loaded.len() > C_MAX_QUERY_PAYLOAD {
        status = WebQueryStatus.Error
        error = "invalid"
    }
    WebQuery{key: ~key, data: loaded, status: status, error: error, generation: 1, mode: WebQueryNetworkMode.Online, online: true, subscribers: 0}
}

pub fn get(q: WebQuery) -> String { q.data }
pub fn show(q: WebQuery) -> String { "{q.key}={q.data}" }

pub fn state(q: WebQuery) -> WebQueryState {
    WebQueryState{status: q.status, generation: q.generation, online: q.online}
}

pub fn state_signal(q: WebQuery) -> String { "{q.key}:{status_name(q.status)}:{q.generation}" }

pub fn mutation_state(q: WebQuery) -> WebMutationState {
    status := WebMutationStatus.Idle
    if q.status == WebQueryStatus.Pending || q.status == WebQueryStatus.Fetching -> status = WebMutationStatus.Pending
    if q.status == WebQueryStatus.Error || q.status == WebQueryStatus.Offline -> status = WebMutationStatus.Error
    if q.status == WebQueryStatus.Fresh -> status = WebMutationStatus.Success
    WebMutationState{status: status, data: q.data, error: q.error}
}

pub fn mutation_signal(q: WebQuery) -> String { "{status_name(q.status)}:{q.generation}" }

pub fn subscribe(key: String) -> WebQuery {
    status := WebQueryStatus.Stale
    error := ""
    if !valid_key(key) {
        status = WebQueryStatus.Error
        error = "invalid"
    }
    WebQuery{key: ~key, data: "", status: status, error: error, generation: 1, mode: WebQueryNetworkMode.Online, online: true, subscribers: 1}
}

pub fn invalidate(q: &WebQuery) -> Int {
    q.status = WebQueryStatus.Stale
    q.generation = q.generation + 1
    q.generation
}

pub fn refresh(q: &WebQuery) WebQueryError! {
    if q.status == WebQueryStatus.Fetching || q.status == WebQueryStatus.Pending -> return Err(WebQueryError.Invalid)
    if !q.online && q.mode != WebQueryNetworkMode.Always {
        q.status = WebQueryStatus.Offline
        q.error = "offline"
        q.generation = q.generation + 1
        return Err(WebQueryError.Offline)
    }
    q.status = WebQueryStatus.Fetching
    q.error = ""
    q.generation = q.generation + 1
    return Ok()
}

pub fn cancel(q: &WebQuery) -> Bool {
    if q.status == WebQueryStatus.Fetching || q.status == WebQueryStatus.Pending {
        q.status = WebQueryStatus.Stale
        q.error = "cancelled"
        q.generation = q.generation + 1
        return true
    }
    false
}

pub fn queue(q: &WebQuery, data: String) -> Int WebQueryError! {
    if data.len() > C_MAX_QUERY_PAYLOAD -> return Err(WebQueryError.Invalid)
    if q.status == WebQueryStatus.Fetching || q.status == WebQueryStatus.Pending -> return Err(WebQueryError.Invalid)
    q.data = ~data
    q.status = WebQueryStatus.Pending
    q.error = ""
    q.generation = q.generation + 1
    q.generation
}

pub fn retry(q: &WebQuery, replay: fn(String)) -> Int WebQueryError! {
    if q.status == WebQueryStatus.Fetching || q.status == WebQueryStatus.Pending -> return Err(WebQueryError.Invalid)
    if !q.online && q.mode != WebQueryNetworkMode.Always -> return Err(WebQueryError.Offline)
    q.status = WebQueryStatus.Fetching
    q.error = ""
    replay(~q.key)
    q.generation = q.generation + 1
    q.generation
}

pub fn mutate(q: &WebQuery, key: String, expected: String?, mutation: fn(String) -> String) -> WebMutationState {
    if !valid_key(key) || key != q.key {
        q.status = WebQueryStatus.Error
        q.error = "key"
        q.generation = q.generation + 1
        return WebMutationState{status: WebMutationStatus.Error, data: q.data, error: q.error}
    }
    if expected != None {
        actual :: expected
        if actual.len() > C_MAX_QUERY_PAYLOAD || actual != q.data {
            q.status = WebQueryStatus.Error
            q.error = "conflict"
            q.generation = q.generation + 1
            return WebMutationState{status: WebMutationStatus.Error, data: q.data, error: q.error}
        }
    }
    if !q.online && q.mode != WebQueryNetworkMode.Always && q.mode != WebQueryNetworkMode.OfflineFirst {
        q.status = WebQueryStatus.Offline
        q.error = "offline"
        q.generation = q.generation + 1
        return WebMutationState{status: WebMutationStatus.Error, data: q.data, error: q.error}
    }
    q.status = WebQueryStatus.Pending
    q.error = ""
    next := mutation(q.data)
    if next.len() > C_MAX_QUERY_PAYLOAD {
        q.status = WebQueryStatus.Error
        q.error = "payload"
        q.generation = q.generation + 1
        return WebMutationState{status: WebMutationStatus.Error, data: q.data, error: q.error}
    }
    q.data = ~next
    q.generation = q.generation + 1
    if !q.online && q.mode == WebQueryNetworkMode.OfflineFirst {
        q.error = "offline"
        return WebMutationState{status: WebMutationStatus.Pending, data: q.data, error: q.error}
    }
    q.status = WebQueryStatus.Fresh
    WebMutationState{status: WebMutationStatus.Success, data: q.data, error: ""}
}

pub fn mutate_with_invalidations(q: &WebQuery, key: String, expected: String?, invalidations: [String], mutation: fn(String) -> String) -> WebMutationState {
    if invalidations.len() > C_MAX_QUERY_SUBSCRIBERS {
        q.status = WebQueryStatus.Error
        q.error = "invalidations"
        q.generation = q.generation + 1
        return WebMutationState{status: WebMutationStatus.Error, data: q.data, error: q.error}
    }
    loop target in invalidations {
        if !valid_key(target) {
            q.status = WebQueryStatus.Error
            q.error = "invalidations"
            q.generation = q.generation + 1
            return WebMutationState{status: WebMutationStatus.Error, data: q.data, error: q.error}
        }
    }
    result :: mutate(q, key, expected, mutation)
    if result.status == WebMutationStatus.Success && invalidations.len() > 0 {
        return WebMutationState{status: WebMutationStatus.Settled, data: result.data, error: ""}
    }
    result
}

pub fn set_online(q: &WebQuery, online: Bool) {
    if q.online == online -> return
    q.online = online
    q.generation = q.generation + 1
    if !online {
        q.status = WebQueryStatus.Offline
        q.error = "offline"
    } else if q.status == WebQueryStatus.Offline {
        q.status = WebQueryStatus.Stale
        q.error = ""
    }
}

pub fn set_mode(q: &WebQuery, mode: WebQueryNetworkMode) {
    if q.mode == mode -> return
    q.mode = mode
    q.generation = q.generation + 1
    if q.online || mode != WebQueryNetworkMode.Always -> return
    if q.status == WebQueryStatus.Offline {
        q.status = WebQueryStatus.Stale
        q.error = ""
    }
}


pub fn facts(q: WebQuery) -> String {
    "{{\"key\":\"{esc_json(q.key)}\",\"status\":\"{status_name(q.status)}\",\"generation\":{q.generation},\"online\":{bool_json(q.online)},\"subscribers\":{q.subscribers}}}"
}

fn valid_key(key: String) -> Bool {
    if key.len() == 0 || key.len() > C_MAX_QUERY_KEY -> return false
    loop b in key.bytes() {
        n :: Int.from_u8(b)
        if n < 33 || n == 127 -> return false
    }
    true
}

fn esc_json(text: String) -> String {
    out := [U8]{}
    hex :: "0123456789abcdef".bytes()
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        if n == 34 || n == 92 {
            &out.push(U8{92})
            &out.push(b)
        } else if n == 8 {
            &out.push(U8{92})
            &out.push(U8{98})
        } else if n == 10 {
            &out.push(U8{92})
            &out.push(U8{110})
        } else if n == 12 {
            &out.push(U8{92})
            &out.push(U8{102})
        } else if n == 13 {
            &out.push(U8{92})
            &out.push(U8{114})
        } else if n == 9 {
            &out.push(U8{92})
            &out.push(U8{116})
        } else if n < 32 || n == 127 {
            &out.push(U8{92})
            &out.push(U8{117})
            &out.push(U8{48})
            &out.push(U8{48})
            &out.push(hex[n /% 16])
            &out.push(hex[n %% 16])
        } else {
            &out.push(b)
        }
    }
    String.from_bytes(out) ?? ""
}
fn status_name(s: WebQueryStatus) -> String {
    if s == {
        WebQueryStatus.Pending -> "pending"
        WebQueryStatus.Fresh -> "fresh"
        WebQueryStatus.Stale -> "stale"
        WebQueryStatus.Fetching -> "fetching"
        WebQueryStatus.Error -> "error"
        else -> "offline"
    }
}

fn bool_json(b: Bool) -> String {
    if b -> return "true"
    "false"
}
