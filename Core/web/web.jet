package {
    name: "core.web"
    version: "0.1.0"
    edition: "2026"
    description: "App, pages, live queries, forms, and browser tests."
    license: "MIT"
    outputs: {
        web: .Library{ entry: web }
    }
}

// core.web — server-rendered apps on `core.http`.
//
// An `App` owns routes, live-query keys, and session auth. Nested modules
// own router, store, forms, table, virtual windows, storage, and browser
// tests. Nothing here talks to a browser; `core.http` is the wire.

module browser
module devserver
module forms
module query
module router
module storage
module store
module table
module virtual

pub struct App {
    pub name: String
    pub pages: [Page]
    pub live: [LiveQuery]
    pub sessions: [Session]
}

pub struct Page {
    pub path: String
    pub title: String
    pub body: String
}

pub struct Context {
    pub path: String
    pub method: String
    pub session: String
}

pub struct Mount {
    pub path: String
    pub page: String
}

pub struct Auth {
    pub kind: String
    pub client_id: String
}

pub struct Session {
    pub id: String
    pub user: String
}

pub struct LiveQuery {
    pub key: String
    pub data: String
    pub generation: Int
    pub subscribers: Int
}

pub fn app() -> App { App{name: "app", pages: [Page]{}, live: [LiveQuery]{}, sessions: [Session]{}} }

pub fn page(path: String, title: String) -> Page { Page{path: path, title: title, body: ""} }

pub fn form() -> Page { Page{path: "/form", title: "form", body: "<form></form>"} }

pub fn on(app: App, path: String, title: String) -> App {
    pages := [Page]{}
    loop p in app.pages -> pages.push(p)
    pages.push(Page{path: path, title: title, body: ""})
    App{name: app.name, pages: pages, live: app.live, sessions: app.sessions}
}

pub fn openapi(app: App) -> String {
    paths := ""
    loop p in app.pages {
        if paths.len() > 0 -> paths = "{paths},"
        paths = "{paths}\"{p.path}\":{{\"get\":{{\"summary\":\"{p.title}\"}}}}"
    }
    "{{\"openapi\":\"3.0.0\",\"info\":{{\"title\":\"{app.name}\",\"version\":\"0.1.0\"}},\"paths\":{{{paths}}}}}"
}

pub fn value(app: App, key: String) -> String {
    loop q in app.live {
        if q.key == key -> return q.data
    }
    ""
}

pub fn storage() -> String { "local" }

pub fn auth() -> Auth { Auth{kind: "session", client_id: ""} }

pub fn auth_oauth(client_id: String) -> Auth { Auth{kind: "oauth", client_id: client_id} }

pub fn auth_routes(auth: Auth) -> [String] {
    if {
        auth.kind == "oauth" -> return [String]{"/auth/login", "/auth/callback", "/auth/logout"}
        else -> [String]{"/login", "/logout"}
    }
}

pub fn auth_show(auth: Auth) -> String { "{auth.kind}:{auth.client_id}" }

pub fn live(key: String, data: String) -> LiveQuery { LiveQuery{key: key, data: data, generation: 1, subscribers: 0} }

pub fn live_get(q: LiveQuery) -> String { q.data }

pub fn live_show(q: LiveQuery) -> String { "{q.key}@{q.generation}" }

pub fn live_stats(app: App) -> String {
    n := 0
    subs := 0
    loop q in app.live {
        n = n + 1
        subs = subs + q.subscribers
    }
    "live={n} subscribers={subs}"
}

pub fn subscribe(q: LiveQuery) -> LiveQuery {
    LiveQuery{key: q.key, data: q.data, generation: q.generation, subscribers: q.subscribers + 1}
}

pub fn sync(q: LiveQuery, data: String) -> LiveQuery {
    LiveQuery{key: q.key, data: data, generation: q.generation + 1, subscribers: q.subscribers}
}

pub fn invalidate(q: LiveQuery) -> LiveQuery {
    LiveQuery{key: q.key, data: q.data, generation: q.generation + 1, subscribers: q.subscribers}
}

pub fn transact_invalidate(q: LiveQuery) -> LiveQuery { invalidate(q) }

pub fn signal_push(q: LiveQuery, payload: String) -> LiveQuery { sync(q, payload) }
