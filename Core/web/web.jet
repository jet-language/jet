package {
    name: "core.web"
    version: "0.1.0"
    edition: "2026"
    description: "App, pages, live queries, forms, and browser tests."
    license: "MIT"
    outputs: {
        web: .Library{ entry: web }
    }
}

use core as core
use core.web.forms.[WebFormError, WebFormInput, WebFormTyped]

// core.web — server-rendered apps on `core.http`.
//
// An `App` owns routes, live-query keys, and session auth. Nested modules
// own router, store, forms, table, virtual windows, storage, and browser
// tests. Nothing here talks to a browser; `core.http` is the wire.

module browser
module devserver
module forms
module query
module router
module storage
module store
module table
module virtual

pub struct App {
    pub name: String
    pub pages: [WebPage]
    pub live: [LiveQuery]
    pub sessions: [Session]
}

pub struct WebPage {
    pub title: String
    pub body: String
}

pub struct WebEvent {
    pub path: String
    pub title: String
    pub payload: String
}

pub struct Context {
    pub path: String
    pub method: String
    pub session: String
}

pub struct Mount {
    pub path: String
    pub page: String
}

pub struct Auth {
    pub kind: String
    pub client_id: String
}

pub struct Session {
    pub id: String
    pub user_id: String
}

pub struct LiveQuery {
    pub key: String
    pub data: String
    pub generation: Int
    pub subscribers: Int
}

pub fn app() -> App { App{name: "app", pages: [WebPage]{}, live: [LiveQuery]{}, sessions: [Session]{}} }

pub fn page(title: String, body: String) -> WebPage { WebPage{title: title, body: body} }

pub fn form(input: WebFormInput, action: String) -> WebFormTyped !WebFormError {
    core.web.forms.typed(input, action)
}


pub fn on(path: String, title: String, handler: fn(WebEvent)) -[Browser]> {
    core.web.on(path, title, handler)
}

pub fn openapi(router: HTTPRouter) -> String {
    core.web.openapi(router)
}

pub fn value(key: String) -> String { ~key }

pub fn storage() -> String { "local" }

pub fn auth(kind: String) -> Auth { Auth{kind: kind, client_id: ""} }

pub fn auth_oauth(auth: Auth, client_id: String) -> Auth {
    Auth{kind: "oauth", client_id: client_id}
}

pub fn auth_routes(auth: Auth) -> [String] {
    if {
        auth.kind == "oauth" -> return [String]{"/auth/login", "/auth/callback", "/auth/logout"}
        else -> [String]{"/login", "/logout"}
    }
}

pub fn auth_show(auth: Auth) -> String { "{auth.kind}:{auth.client_id}" }

pub fn live(key: String, data: String) -> LiveQuery { LiveQuery{key: key, data: data, generation: 1, subscribers: 0} }

pub fn subscribe(key: String) -> LiveQuery { LiveQuery{key: key, data: "", generation: 1, subscribers: 1} }

pub fn invalidate(key: String) -> Int { key_token(key) }

pub fn transact_invalidate(key: String) -> Int { key_token(key) + 1 }

pub fn live_get(q: LiveQuery) -> String { q.data }

pub fn live_show(q: LiveQuery) -> String { "{q.key}@{q.generation}" }

pub fn live_stats() -> String { "live=0 subscribers=0" }

pub fn signal_push(q: LiveQuery, payload: String) -> LiveQuery { sync_query(q, payload) }

pub fn sync(key: String, data: String) -> String {
    "{key}:{data}"
}

fn sync_query(q: LiveQuery, data: String) -> LiveQuery {
    LiveQuery{key: q.key, data: data, generation: q.generation + 1, subscribers: q.subscribers}
}

fn key_token(key: String) -> Int {
    n := 5381
    loop b in key.bytes() -> n = ((n * 33) + b) %% 2147483647
    n
}

