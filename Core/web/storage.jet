package {
    name: "core.web.storage"
    version: "0.0.1"
    edition: "2026"
    description: "Portable browser storage namespaces."
    license: "MIT"
    outputs: {
        storage: .Library{ entry: storage }
    }
}

// core.web.storage — web storage namespaces.


pub struct WebStorage {
    pub ns: String
}

pub fn local() -> WebStorage Never! { {ns: "local"} }

pub fn session() -> WebStorage Never! { {ns: "session"} }

pub fn kind_local() -> String Never! { "local" }

pub fn kind_session() -> String Never! { "session" }
