use core as core

// core.web.storage.local — origin-local key/value store.
pub fn get(key: String) -> ?String { core.web.storage.local.get(key) }

pub fn set(key: String, value: String) { core.web.storage.local.set(key, value) }

pub fn remove(key: String) { core.web.storage.local.remove(key) }

pub fn clear() { core.web.storage.local.clear() }

pub fn get_or(key: String, fallback: String) -> String { get(key) ?? fallback }

pub fn has(key: String) -> Bool { get(key) != None }

