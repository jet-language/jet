use core as core

// core.web.storage.local — origin-local key/value store.
pub fn get(key: String) -> String? Never! { core.web.storage.local.get(key) }

pub fn set(key: String, value: String) Never! { core.web.storage.local.set(key, value) }

pub fn remove(key: String) Never! { core.web.storage.local.remove(key) }

pub fn clear() Never! { core.web.storage.local.clear() }

pub fn get_or(key: String, fallback: String) -> String Never! { get(key) ?? fallback }

pub fn has(key: String) -> Bool Never! { get(key) != None }

