use core as core

// core.web.storage.local — origin-local key/value store.
fn get(key: String) -> String? Never! { core.web.storage.local.get(key) }

fn set(key: String, value: String) Never! { core.web.storage.local.set(key, value) }

fn remove(key: String) Never! { core.web.storage.local.remove(key) }

fn clear() Never! { core.web.storage.local.clear() }

fn get_or(key: String, fallback: String) -> String Never! { get(key) ?? fallback }

fn has(key: String) -> Bool Never! { get(key) != None }

