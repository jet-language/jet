// core.web.storage.local — origin-local key/value store.
pub fn get(key: String) -> ?String { host_storage_get("local", key) }

pub fn set(key: String, value: String) { host_storage_set("local", key, value) }

pub fn remove(key: String) { host_storage_remove("local", key) }

pub fn clear() { host_storage_clear("local") }

fn host_storage_get(ns: String, key: String) -> ?String { panic("host_storage_get") }

fn host_storage_set(ns: String, key: String, value: String) { panic("host_storage_set") }

fn host_storage_remove(ns: String, key: String) { panic("host_storage_remove") }

fn host_storage_clear(ns: String) { panic("host_storage_clear") }

pub fn get_or(key: String, fallback: String) -> String {
    host_storage_get("local", key) ?? fallback
}

pub fn has(key: String) -> Bool { host_storage_get("local", key) != None }
