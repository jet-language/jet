use core as core

// core.web.storage.session — tab-scoped key/value store.
fn get(key: String) -> String? Never! { core.web.storage.session.get(key) }

fn set(key: String, value: String) Never! { core.web.storage.session.set(key, value) }

fn remove(key: String) Never! { core.web.storage.session.remove(key) }

fn clear() Never! { core.web.storage.session.clear() }

fn get_or(key: String, fallback: String) -> String Never! { get(key) ?? fallback }

fn has(key: String) -> Bool Never! { get(key) != None }
