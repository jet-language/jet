use core as core

// core.web.storage.session — tab-scoped key/value store.
pub fn get(key: String) -> String? { core.web.storage.session.get(key) }

pub fn set(key: String, value: String) { core.web.storage.session.set(key, value) }

pub fn remove(key: String) { core.web.storage.session.remove(key) }

pub fn clear() { core.web.storage.session.clear() }

pub fn get_or(key: String, fallback: String) -> String { get(key) ?? fallback }

pub fn has(key: String) -> Bool { get(key) != None }
