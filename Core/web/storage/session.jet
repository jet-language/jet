use core as core

// core.web.storage.session — tab-scoped key/value store.
pub fn get(key: String) -> String? Never! { core.web.storage.session.get(key) }

pub fn set(key: String, value: String) Never! { core.web.storage.session.set(key, value) }

pub fn remove(key: String) Never! { core.web.storage.session.remove(key) }

pub fn clear() Never! { core.web.storage.session.clear() }

pub fn get_or(key: String, fallback: String) -> String Never! { get(key) ?? fallback }

pub fn has(key: String) -> Bool Never! { get(key) != None }
