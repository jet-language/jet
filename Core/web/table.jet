// core.web.table — typed rows, sorting, filtering, and paging.
C_MAX_TABLE_PAGE_SIZE :: 4096

C_MAX_TABLE_COLUMNS :: 256

C_MAX_TABLE_ROWS :: 1048576
C_MAX_TABLE_INDEX :: 2147483647



#Error
pub enum WebTableError {
    NotFound
    Invalid
}

pub enum WebTableSortDirection {
    Ascending
    Descending
}

pub enum WebTablePageMode {
    Client
    Server
}

pub struct WebTableSort {
    pub column: String
    pub descending: Bool
}

pub struct WebTableFilter {
    pub column: String
    pub value: String
}

pub struct WebTableColumn<T> {
    pub name: String
    pub label: String
    pub project: fn(T) -> String
}

pub struct WebTableRow<T> {
    pub key: String
    pub value: T
}

pub struct WebTablePage<T> {
    pub rows: [WebTableRow<T>]
    pub index: Int
    pub size: Int
    pub total: Int
}

pub struct WebTableState {
    pub sort: WebTableSort
    pub filter: WebTableFilter
    pub page_index: Int
    pub page_size: Int
    pub selected: [String]
    pub focus: String
    pub page_mode: WebTablePageMode
}

pub struct WebTable<T> {
    pub columns: [WebTableColumn<T>]
    pub rows: [WebTableRow<T>]
    pub state: WebTableState
}

pub fn new<T>(columns: String, rows: [T]) -> WebTable<T> {
    cols := parse_columns<T>(columns)
    keyed := [WebTableRow<T>]{ }
    loop i in 0..<rows.len() -> keyed.push(WebTableRow<T>{key: "{i}", value: rows[i]})
    WebTable<T>{columns: cols, rows: keyed, state: default_state()}
}

pub fn new_keyed<T>(columns: String, rows: [T], key_fn: fn(T) -> String) -> WebTable<T> {
    cols := parse_columns<T>(columns)
    keyed := [WebTableRow<T>]{ }
    loop row in rows -> keyed.push(WebTableRow<T>{key: key_fn(row), value: row})
    WebTable<T>{columns: cols, rows: keyed, state: default_state()}
}

pub fn column<T>(name: String, label: String, project: ^fn(T) -> String) -> WebTableColumn<T> {
    WebTableColumn<T>{name: name, label: label, project: project}
}

pub fn with_column<T>(table: &WebTable<T>, col: WebTableColumn<T>) -> WebTable<T> {
    if col.name.len() == 0 || table.columns.len() >= C_MAX_TABLE_COLUMNS -> return ~table
    loop existing in table.columns {
        if existing.name == col.name -> return ~table
    }
    cols := copy_columns<T>(table.columns)
    cols.push(col)
    table.columns = cols
    ~table
}

pub fn with_server_page<T>(table: &WebTable<T>, fetch: fn(WebTableState) -> WebTablePage<T>) -> WebTable<T> {
    page :: fetch(table.state)
    if page.index < 0 || page.index > C_MAX_TABLE_INDEX || page.size < 1 || page.size > C_MAX_TABLE_PAGE_SIZE || page.total < 0 || page.total > C_MAX_TABLE_ROWS || page.rows.len() > C_MAX_TABLE_ROWS || page.rows.len() > page.total {
        return ~table
    }
    table.rows = page.rows
    table.state.page_index = page.index
    table.state.page_size = page.size
    table.state.page_mode = WebTablePageMode.Server
    ~table
}

pub fn state<T>(table: WebTable<T>) -> WebTableState { table.state }

pub fn facts<T>(table: WebTable<T>) -> String {
    "{{\"rows\":{table.rows.len()},\"page\":{table.state.page_index},\"page_size\":{table.state.page_size}}}"
}

pub fn keys<T>(table: WebTable<T>) -> [String] !WebTableError {
    out := [String]{ }
    loop row in table.rows -> out.push(row.key)
    Ok(out)
}

pub fn page_state<T>(table: WebTable<T>) -> WebTablePage<T> !WebTableError {
    if table.state.page_size < 1 || table.state.page_size > C_MAX_TABLE_PAGE_SIZE || table.state.page_index < 0 || table.state.page_index > C_MAX_TABLE_INDEX -> return Err(WebTableError.Invalid)
    rows := projected_rows<T>(table)
    start := table.state.page_index * table.state.page_size
    if start > rows.len() -> start = rows.len()
    finish := start + table.state.page_size
    if finish > rows.len() -> finish = rows.len()
    visible := [WebTableRow<T>]{}
    loop i in start..<finish -> visible.push(rows[i])
    Ok(WebTablePage<T>{rows: visible, index: table.state.page_index, size: table.state.page_size, total: rows.len()})
}

pub fn sort<T>(rows: [T], descending: Bool, key_fn: fn(T) -> String) -> [T] {
    out := copy_values<T>(rows)
    n := out.len()
    if n < 2 -> return out
    loop i in 0..<n {
        loop j in 0..<(n - 1) {
            a := key_fn(out[j])
            b := key_fn(out[j + 1])
            swap := a > b
            if descending -> swap = a < b
            if swap {
                tmp := out[j]
                out[j] = out[j + 1]
                out[j + 1] = tmp
            }
        }
    }
    out
}

pub fn filter<T>(rows: [T], predicate: fn(T) -> Bool) -> [T] {
    out := [T]{ }
    loop row in rows {
        if predicate(row) -> out.push(row)
    }
    out
}

pub fn page<T>(rows: [T], index: Int, size: Int) -> WebTablePage<T> !WebTableError {
    if size < 1 || size > C_MAX_TABLE_PAGE_SIZE || index < 0 || index > C_MAX_TABLE_INDEX -> return Err(WebTableError.Invalid)
    start := index * size
    if start > rows.len() -> start = rows.len()
    finish := start + size
    if finish > rows.len() -> finish = rows.len()
    out := [WebTableRow<T>]{ }
    loop i in start..<finish -> out.push(WebTableRow<T>{key: "{i}", value: rows[i]})
    Ok(WebTablePage<T>{rows: out, index: index, size: size, total: rows.len()})
}

pub fn sort_by<T>(table: &WebTable<T>, name: String, direction: WebTableSortDirection) -> WebTable<T> {
    table.state.sort = WebTableSort{column: name, descending: direction == WebTableSortDirection.Descending}
    table.state.page_index = 0
    ~table
}

pub fn filter_by<T>(table: &WebTable<T>, name: String, value: String) -> WebTable<T> {
    table.state.filter = WebTableFilter{column: name, value: value}
    table.state.page_index = 0
    ~table
}

pub fn paginate<T>(table: &WebTable<T>, index: Int, size: Int) -> WebTable<T> {
    i := index
    if i < 0 -> i = 0
    if i > C_MAX_TABLE_INDEX -> i = C_MAX_TABLE_INDEX
    n := size
    if n < 1 -> n = 25
    if n > C_MAX_TABLE_PAGE_SIZE -> n = C_MAX_TABLE_PAGE_SIZE
    table.state.page_index = i
    table.state.page_size = n
    ~table
}

pub fn set_rows<T>(table: &WebTable<T>, rows: [T]) !WebTableError {
    if rows.len() > C_MAX_TABLE_ROWS -> return Err(WebTableError.Invalid)
    keyed := [WebTableRow<T>]{ }
    loop i in 0..<rows.len() -> keyed.push(WebTableRow<T>{key: "{i}", value: rows[i]})
    table.rows = keyed
    table.state.page_index = 0
    table.state.selected = [String]{}
    table.state.focus = ""
    return Ok()
}

pub fn set_selected<T>(table: &WebTable<T>, key: String, on: Bool) -> WebTable<T> !WebTableError {
    if !has_key<T>(table.rows, key) -> return Err(WebTableError.NotFound)
    selected := [String]{ }
    loop item in table.state.selected {
        if item != key -> selected.push(item)
    }
    if on -> selected.push(key)
    table.state.selected = selected
    Ok(~table)
}

pub fn toggle_selection<T>(table: &WebTable<T>, key: String) -> WebTable<T> !WebTableError {
    enabled := true
    loop item in table.state.selected {
        if item == key -> enabled = false
    }
    set_selected<T>(table, key, enabled)
}

pub fn focus<T>(table: &WebTable<T>, key: String) -> WebTable<T> !WebTableError {
    if !has_key<T>(table.rows, key) -> return Err(WebTableError.NotFound)
    table.state.focus = key
    Ok(~table)
}

pub fn clear_focus<T>(table: &WebTable<T>) -> WebTable<T> {
    table.state.focus = ""
    ~table
}

pub fn focused_key<T>(table: WebTable<T>) -> ?String {
    if table.state.focus.len() == 0 -> return None
    Val(table.state.focus)
}

pub fn clear_selection<T>(table: &WebTable<T>) -> WebTable<T> {
    table.state.selected = [String]{ }
    ~table
}

pub fn selected_keys<T>(table: WebTable<T>) -> [String] { table.state.selected }

pub fn selected_rows<T>(table: WebTable<T>) -> [WebTableRow<T>] !WebTableError {
    out := [WebTableRow<T>]{ }
    seen := [String]{}
    loop key in table.state.selected {
        if contains_key(seen, key) -> next
        loop row in table.rows {
            if row.key == key {
                out.push(row)
                seen.push(~key)
                break
            }
        }
    }
    Ok(out)
}

pub fn insert_row<T>(table: &WebTable<T>, row: T) -> String !WebTableError {
    if table.rows.len() >= C_MAX_TABLE_ROWS -> return Err(WebTableError.Invalid)
    key := "{table.rows.len()}"
    loop {
        if !has_key<T>(table.rows, key) -> break
        key = "{table.rows.len() + 1}"
    }
    table.rows.push(WebTableRow<T>{key: key, value: row})
    Ok(key)
}

pub fn replace_row<T>(table: &WebTable<T>, key: String, row: T) !WebTableError {
    loop i in 0..<table.rows.len() {
        if table.rows[i].key == key {
            table.rows[i] = WebTableRow<T>{key: key, value: row}
            return Ok()
        }
    }
    return Err(WebTableError.NotFound)
}

pub fn update_row<T: Clone>(table: &WebTable<T>, key: String, transform: fn(T) -> T) !WebTableError {
    loop i in 0..<table.rows.len() {
        if table.rows[i].key == key {
            updated :: transform(~table.rows[i].value) ?? ~table.rows[i].value
            table.rows[i] = WebTableRow<T>{key: ~table.rows[i].key, value: updated}
            return Ok()
        }
    }
    return Err(WebTableError.NotFound)
}

pub fn remove_row<T>(table: &WebTable<T>, key: String) -> T !WebTableError {
    if table.rows.len() == 0 -> return Err(WebTableError.NotFound)
    remaining := [WebTableRow<T>]{}
    found := false
    removed := table.rows[0].value
    loop row in table.rows {
        if row.key == key {
            removed = row.value
            found = true
        } else {
            remaining.push(row)
        }
    }
    if !found -> return Err(WebTableError.NotFound)
    table.rows = remaining
    selected := [String]{}
    loop item in table.state.selected {
        if item != key -> selected.push(item)
    }
    table.state.selected = selected
    if table.state.focus == key -> table.state.focus = ""
    if table.state.page_index > 0 {
        visible := projected_rows<T>(~table)
        page_size := table.state.page_size
        if page_size < 1 -> page_size = 25
        if page_size > C_MAX_TABLE_PAGE_SIZE -> page_size = C_MAX_TABLE_PAGE_SIZE
        table.state.page_size = page_size
        pages := (visible.len() + page_size - 1) /% page_size
        if pages < 1 -> pages = 1
        if table.state.page_index >= pages -> table.state.page_index = pages - 1
    }
    Ok(removed)
}

pub fn first_page<T>(table: &WebTable<T>) -> WebTable<T> {
    table.state.page_index = 0
    ~table
}

pub fn next_page<T>(table: &WebTable<T>) -> WebTable<T> {
    if table.state.page_size < 1 -> table.state.page_size = 25
    if table.state.page_size > C_MAX_TABLE_PAGE_SIZE -> table.state.page_size = C_MAX_TABLE_PAGE_SIZE
    rows := projected_rows<T>(~table)
    pages := (rows.len() + table.state.page_size - 1) /% table.state.page_size
    if pages < 1 -> pages = 1
    if table.state.page_index + 1 < pages -> table.state.page_index = table.state.page_index + 1
    ~table
}

pub fn last_page<T>(table: &WebTable<T>) -> WebTable<T> !WebTableError {
    if table.state.page_size < 1 || table.state.page_size > C_MAX_TABLE_PAGE_SIZE -> return Err(WebTableError.Invalid)
    rows := projected_rows<T>(~table)
    pages := (rows.len() + table.state.page_size - 1) /% table.state.page_size
    if pages < 1 -> pages = 1
    table.state.page_index = pages - 1
    Ok(~table)
}

pub fn visible_rows<T>(table: WebTable<T>, plan: WebVirtualPlan) -> [WebTableRow<T>] !WebTableError {
    projected := projected_rows<T>(table)
    start := plan.start
    if start < 0 -> start = 0
    if start > projected.len() -> start = projected.len()
    end := plan.end
    if end < start -> end = start
    if end > projected.len() -> end = projected.len()
    if end - start > C_MAX_TABLE_PAGE_SIZE -> end = start + C_MAX_TABLE_PAGE_SIZE
    if end > projected.len() -> end = projected.len()
    out := [WebTableRow<T>]{ }
    loop i in start..<end -> out.push(projected[i])
    Ok(out)
}
fn projected_rows<T>(table: WebTable<T>) -> [WebTableRow<T>] {
    rows := [WebTableRow<T>]{}
    filter_index := column_index<T>(table.columns, table.state.filter.column)
    loop row in table.rows {
        if filter_index < 0 || table.state.filter.value.len() == 0 {
            rows.push(row)
        } else {
            text := table.columns[filter_index].project(row.value)
            if contains_text(text, table.state.filter.value) -> rows.push(row)
        }
    }
    sort_index := column_index<T>(table.columns, table.state.sort.column)
    if sort_index >= 0 && rows.len() > 1 {
        loop i in 0..<rows.len() {
            loop j in 0..<(rows.len() - 1) {
                left := table.columns[sort_index].project(rows[j].value)
                right := table.columns[sort_index].project(rows[j + 1].value)
                swap := left > right
                if table.state.sort.descending -> swap = left < right
                if swap {
                    temp := rows[j]
                    rows[j] = rows[j + 1]
                    rows[j + 1] = temp
                }
            }
        }
    }
    rows
}

fn column_index<T>(columns: [WebTableColumn<T>], name: String) -> Int {
    if name.len() == 0 -> return -1
    loop i in 0..<columns.len() {
        if columns[i].name == name -> return i
    }
    -1
}

fn contains_text(text: String, needle: String) -> Bool {
    if needle.len() == 0 -> return true
    a := text.bytes()
    b := needle.bytes()
    if b.len() > a.len() -> return false
    loop i in 0..<(a.len() - b.len() + 1) {
        match := true
        loop j in 0..<b.len() {
            if a[i + j] != b[j] -> match = false
        }
        if match -> return true
    }
    false
}
fn contains_key(items: [String], key: String) -> Bool {
    loop item in items {
        if item == key -> return true
    }
    false
}
fn has_control_text(text: String) -> Bool {
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        if n < 32 || n == 127 -> return true
    }
    false
}

fn default_state() -> WebTableState {
    WebTableState{sort: WebTableSort{column: "", descending: false}, filter: WebTableFilter{column: "", value: ""}, page_index: 0, page_size: 25, selected: [String]{ }, focus: "", page_mode: WebTablePageMode.Client}
}
fn parse_columns<T>(text: String) -> [WebTableColumn<T>] {
    out := [WebTableColumn<T>]{ }
    loop raw_name in split_commas(text) {
        name :: trim(~raw_name)
        if out.len() >= C_MAX_TABLE_COLUMNS -> next
        if name.len() > 0 && name.len() <= 128 && !has_control_text(name) -> out.push(WebTableColumn<T>{name: ~name, label: ~name, project: default_project})
    }
    out
}
fn default_project<T: Printable>(value: T) -> String { "{value}" }

fn split_commas(text: String) -> [String] {
    raw := text.bytes()
    out := [String]{ }
    start := 0
    loop i in 0..<raw.len() {
        if raw[i] == (U8{44}) {
            out.push(slice_text(text, start, i))
            start = i + 1
        }
    }
    if start <= raw.len() -> out.push(slice_text(text, start, raw.len()))
    out
}

fn copy_values<T>(values: [T]) -> [T] {
    out := [T]{ }
    loop value in values -> out.push(value)
    out
}

fn copy_columns<T>(columns: [WebTableColumn<T>]) -> [WebTableColumn<T>] {
    out := [WebTableColumn<T>]{ }
    loop column in columns -> out.push(column)
    out
}

fn trim(text: String) -> String {
    raw := text.bytes()
    start := 0
    end := raw.len()
    loop start < end {
        n :: Int.from_u8(raw[start])
        if n == 32 || n == 9 -> start = start + 1 else -> break
    }
    loop end > start {
        n :: Int.from_u8(raw[end - 1])
        if n == 32 || n == 9 -> end = end - 1 else -> break
    }
    slice_text(text, start, end)
}
fn has_key<T>(rows: [WebTableRow<T>], key: String) -> Bool {
    loop row in rows {
        if row.key == key -> return true
    }
    false
}

fn slice_text(text: String, start: Int, end: Int) -> String {
    raw := text.bytes()
    out := [U8]{ }
    i := start
    loop {
        if i < 0 || i >= end || i >= raw.len() -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i = i + 1
    }
}
