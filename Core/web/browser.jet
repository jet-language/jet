use core as core

// core.web.browser — headed/headless browser control for tests.
//
// Connect talks to the host WebSocket transport using versioned BiDi.
// Profiles and timeout validation remain offline-checkable.

C_MAX_SOURCE_BYTES :: 1048576

C_MAX_SOURCE_NAME :: 256

#Error
pub struct BrowserError {
    kind: String

    impl Display {
        fn display(self) -> String {
            if self.kind == {
                "invalid profile" -> "browser profile is not supported"
                "invalid timeout" -> "browser timeout must be between 1 and 600000 milliseconds"
                "unsupported protocol" -> "browser protocol is not available in this session"
                "timeout" -> "browser operation timed out"
                "closed" -> "browser session is closed"
                "transport" -> "browser transport failed"
                "missing lock" -> "no locked browser for this engine in .jet/lock"
                "unknown engine" -> "browser engine is not supported"
                "missing binary" -> "locked browser binary was not found"
                "size mismatch" -> "locked browser binary size drifted"
                "invalid lock" -> "browser lock entry is incomplete"
                else -> "browser protocol failed"
            }
        }
    }
}

pub enum BrowserPrivacy {
    Default
    Isolated
}

pub enum BrowserProtocol {
    CDP
    WebDriver
}

pub struct BrowserTimeout {
    milliseconds: Int
}

pub struct BrowserProfile {
    name: String
    version: String
}

pub struct BrowserAbilities {
    pub javascript: Bool
    pub screenshots: Bool
}

pub struct Browser {
    pub id: Int
    pub browser_profile: BrowserProfile
    pub url: String
    pub closed: Bool
}

pub struct BrowserContext {
    pub id: Int
    pub browser: Int
}

pub struct BrowserPage {
    pub id: Int
    pub url: String
    pub title: String
}

pub struct BrowserFrame {
    pub id: Int
    pub page_id: Int
    pub url: String
}

pub struct BrowserLocator {
    pub selector: String
    pub page_id: Int
}

pub struct BrowserLocked {
    pub reason: String
}

pub struct BrowserIntercept {
    pub url: String
    pub status: Int
}

pub struct BrowserEvent {
    pub kind: String
    pub target: String
}

pub struct BrowserReceipt {
    pub ok: Bool
    pub detail: String
}

pub struct BrowserTrace {
    pub events: [String]
}

pub struct BrowserTestConfig {
    pub headless: Bool
    pub timeout_ms: Int
    pub base_url: String
}

pub struct BrowserTestCase {
    pub name: String
    pub ok: Bool
    pub detail: String
}

pub struct BrowserReport {
    pub title: String
    pub cases: [BrowserTestCase]
}

pub struct BrowserServer {
    pub url: String
    pub running: Bool
    pub logs: String
    native: BrowserTestServer?
}

pub fn config() -> BrowserTestConfig BrowserError! {
    core.web.browser.config()
}

pub fn config_from_env() -[Env, FS]> BrowserTestConfig BrowserError! {
    core.web.browser.config_from_env()
}


pub fn make_profile(name: String) -> BrowserProfile BrowserError! { profile(name) }

// Browser.rs:578-594: no trimming, case folding, timeout clamping, or fallback.
pub fn profile(name: String) -> BrowserProfile BrowserError! {
    version :: if name == {
        "bidi-2025.5" -> "2025.5"
        "bidi-2024.11" -> "2024.11"
        else -> return Err(BrowserError{kind: "invalid profile"})
    }
    Ok(BrowserProfile{name: name, version: version})
}

pub fn timeout(ms: Int) -> BrowserTimeout BrowserError! {
    if ms < 1 || ms > 600000 -> return Err(BrowserError{kind: "invalid timeout"})
    Ok(BrowserTimeout{milliseconds: ms})
}

pub fn locked(engine: String) -[FS, IO]> BrowserLocked BrowserError! {
    core.web.browser.locked(engine)

}
pub fn connect() -[Net]> Browser BrowserError! { core.web.browser.connect("default") }

pub fn connect_browser_profile(p: BrowserProfile, t: BrowserTimeout) -[Net]> Browser BrowserError! {
    endpoint := "{p.name}"
    core.web.browser.connect_profile(endpoint, p, t)
}



pub fn selected(page: BrowserPage, selector: String) -> BrowserLocator Never! {
    BrowserLocator{selector: selector, page_id: page.id}
}
pub fn begin_named(config: BrowserTestConfig, test: String, engine: String, attempt: Int, source_path: String, line: Int, column: Int) -[Net]> BrowserTestFixture BrowserError! {
    core.web.browser.begin_named(config, test, engine, attempt, source_path, line, column)
}

pub fn fixture_context(browser: Browser) -> BrowserContext Never! { BrowserContext{id: browser.id, browser: browser.id} }

pub fn fixture_page(ctx: BrowserContext, url: String) -> BrowserPage Never! {
    BrowserPage{id: ctx.id, url: url, title: ""}
}


pub fn fixture_source(name: String, body: String) -> String BrowserError! {
    generate_source(name, body, "")
}

pub fn generate_source(name: String, body: String, base_url: String) -> String BrowserError! {
    if name.len() == 0 || name.len() > C_MAX_SOURCE_NAME || body.len() > C_MAX_SOURCE_BYTES || base_url.len() > C_MAX_SOURCE_BYTES {
        return Err(BrowserError{kind: "protocol"})
    }
    url := base_url
    if url.len() == 0 -> url = "/"
    test_name := source_name(name)
    escaped :: esc_source(url)
    out := "// generated browser test\nfn {test_name}() {{\n    _ :: \"{escaped}\"\n    {body}\n}}\n"
    if out.len() > C_MAX_SOURCE_BYTES -> return Err(BrowserError{kind: "protocol"})
    Ok(out)
}

pub fn report_new(title: String) -> BrowserReport Never! { BrowserReport{title: title, cases: [BrowserTestCase]{}} }

pub fn report_add_case(report: BrowserReport, name: String, ok: Bool) -> BrowserReport Never! {
    cases := [BrowserTestCase]{}
    loop c in report.cases -> &cases.push(c)
    &cases.push(BrowserTestCase{name: name, ok: ok, detail: ""})
    BrowserReport{title: report.title, cases: cases}
}

pub fn report_html(report: BrowserReport) -> String Never! {
    out := "<!doctype html><html><head><title>{esc(report.title)}</title></head><body><h1>{esc(report.title)}</h1><ol>"
    loop c in report.cases {
        cls := "pass"
        if !c.ok -> cls = "fail"
        out = "{out}<li class=\"{cls}\">{esc(c.name)}</li>"
    }
    out = "{out}</ol></body></html>"
    out
}

pub fn report_json(report: BrowserReport) -> String Never! {
    out := "{{\"title\":\"{esc_json(report.title)}\",\"passed\":{passed(report)},\"failed\":{failed(report)},\"cases\":["
    loop i in 0..<report.cases.len() {
        c :: report.cases[i]
        if i > 0 -> out = "{out},"
        ok := "true"
        if !c.ok -> ok = "false"
        out = "{out}{{\"name\":\"{esc_json(c.name)}\",\"ok\":{ok}}}"
    }
    "{out}]}}"
}

pub fn report_text(report: BrowserReport) -> String Never! {
    out := "{report.title}\n"
    loop c in report.cases {
        mark := "ok"
        if !c.ok -> mark = "FAIL"
        out = "{out}[{mark}] {c.name}\n"
    }
    out = "{out}{passed(report)} passed, {failed(report)} failed\n"
    out
}

pub fn report_exit_code(report: BrowserReport) -> Int Never! {
    if failed(report) > 0 -> return 1
    0
}

pub fn write_report(report: BrowserReport, path: String) IOError! {
    core.files.write(path, report_text(report))
}

pub fn server_start(root: String) -[Net]> BrowserServer BrowserError! {
    if root.len() > C_MAX_SOURCE_BYTES -> return Err(BrowserError{kind: "protocol"})
    cfg := BrowserTestConfig{headless: true, timeout_ms: 5000, base_url: root}
    native :: core.web.browser.server_start(cfg)
    Ok(BrowserServer{url: native.url(), running: true, logs: native.logs(), native: Val(native)})
}
pub fn watch_changed(path: String) -[FS, Net]> Bool BrowserError! {
    // The public carrier has no prior mtime.  A negative baseline is the
    // provider's explicit "no snapshot" value; zero would fabricate one.
    core.web.browser.watch_changed(path, -1)
}

pub fn server_stop(server: BrowserServer) -> BrowserServer Never! {
    if server.native == None -> return BrowserServer{url: server.url, running: false, logs: server.logs, native: None}
    native :: server.native ?? return BrowserServer{url: server.url, running: false, logs: server.logs, native: None}
    _ :: core.web.browser.server_stop(native)
    BrowserServer{url: server.url, running: false, logs: server.logs, native: None}
}

pub fn server_url(server: BrowserServer) -> String Never! { server.url }

pub fn server_logs(server: BrowserServer) -> String Never! { server.logs }



fn passed(report: BrowserReport) -> Int Never! {
    n := 0
    loop c in report.cases {
        if c.ok -> n = n + 1
    }
    n
}

fn failed(report: BrowserReport) -> Int Never! { report.cases.len() - passed(report) }

fn esc(text: String) -> String {
    raw :: text.bytes()
    out := [U8]{}
    loop b in raw {
        n :: b
        if n == 38 {
            push_str(&out, "&amp;")
        } else {
            if n == 60 {
                push_str(&out, "&lt;")
            } else {
                if n == 62 {
                    push_str(&out, "&gt;")
                } else {
                    if n == 34 {
                        push_str(&out, "&quot;")
                    } else {
                        if n == 39 -> push_str(&out, "&#39;") else -> &out.push(b)
                    }
                }
            }
        }
    }
    String.from_bytes(out) ?? ""
}

fn esc_json(text: String) -> String {
    raw :: text.bytes()
    out := [U8]{}
    loop b in raw {
        n :: b
        if n == 34 || n == 92 {
            &out.push(U8{92})
            &out.push(b)
        } else {
            if n == 10 {
                push_str(&out, "\\n")
            } else {
                if n == 13 {
                    push_str(&out, "\\r")
                } else {
                    if n == 9 -> push_str(&out, "\\t") else -> &out.push(b)
                }
            }
        }
    }
    String.from_bytes(out) ?? ""
}

fn push_str(out: &[U8], s: String) Never! {
    loop b in s.bytes() -> &out.push(b)
}
fn source_name(text: String) -> String Never! {
    raw :: text.bytes()
    out := [U8]{}
    loop i in 0..<raw.len() {
        n :: raw[i]
        ok := (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 95
        if ok {
            if i == 0 && n >= 48 && n <= 57 -> &out.push(U8{95})
            &out.push(n)
        } else {
            &out.push(U8{95})
        }
    }
    if out.len() == 0 -> return "generated_browser_test"
    String.from_bytes(out) ?? "generated_browser_test"
}

fn esc_source(text: String) -> String Never! {
    raw :: text.bytes()
    out := [U8]{}
    loop b in raw {
        if b == (U8{92}) || b == (U8{34}) {
            &out.push(U8{92})
            &out.push(b)
        } else {
            if b == (U8{10}) {
                push_str(&out, "\\n")
            } else {
                if b == (U8{13}) -> push_str(&out, "\\r") else -> &out.push(b)
            }
        }
    }
    String.from_bytes(out) ?? ""
}


#Test("browser profiles keep exact version pins") {
    current :: profile("bidi-2025.5") ?? panic("current profile rejected")
    previous :: profile("bidi-2024.11") ?? panic("previous profile rejected")
    assert_eq(current.name, "bidi-2025.5")
    assert_eq(current.version, "2025.5")
    assert_eq(previous.version, "2024.11")
    loop invalid in [String]{"", "default", "BIDI-2025.5", " bidi-2025.5", "bidi-2025.5 "} {
        if profile(invalid) == {
            .Ok(_) -> panic("invalid profile accepted")
            .Err(error) -> assert_eq("{error}", "browser profile is not supported")
        }
    }
}

#Test("browser timeout preserves both bounds and exact refusal text") {
    minimum :: timeout(1) ?? panic("minimum timeout rejected")
    maximum :: timeout(600000) ?? panic("maximum timeout rejected")
    assert_eq(minimum.milliseconds, 1)
    assert_eq(maximum.milliseconds, 600000)
    loop invalid in [Int]{-1, 0, 600001, 9223372036854775807} {
        if timeout(invalid) == {
            .Ok(_) -> panic("invalid timeout accepted")
            .Err(error) -> assert_eq("{error}", "browser timeout must be between 1 and 600000 milliseconds")
        }
    }
}

#Test("browser errors use the shipped display vocabulary") {
    assert_eq("{BrowserError{kind: "unsupported protocol"}}", "browser protocol is not available in this session")
    assert_eq("{BrowserError{kind: "timeout"}}", "browser operation timed out")
    assert_eq("{BrowserError{kind: "closed"}}", "browser session is closed")
    assert_eq("{BrowserError{kind: "transport"}}", "browser transport failed")
    assert_eq("{BrowserError{kind: "missing lock"}}", "no locked browser for this engine in .jet/lock")
    assert_eq("{BrowserError{kind: "unknown engine"}}", "browser engine is not supported")
    assert_eq("{BrowserError{kind: "missing binary"}}", "locked browser binary was not found")
    assert_eq("{BrowserError{kind: "size mismatch"}}", "locked browser binary size drifted")
    assert_eq("{BrowserError{kind: "invalid lock"}}", "browser lock entry is incomplete")
    assert_eq("{BrowserError{kind: "protocol"}}", "browser protocol failed")
}
