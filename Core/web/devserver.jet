// core.web.devserver — hot-reload wrapper around an App.
pub struct DevServer {
    pub app_name: String
    pub url: String
    pub watching: Bool
}

pub fn app() -> DevServer Never! { {app_name: "app", url: "http://127.0.0.1:3000", watching: true} }

pub fn for_app(name: String) -> DevServer Never! {
    {app_name: name, url: "http://127.0.0.1:3000", watching: true}
}

pub fn url(host: String, port: Int) -> String Never! { "http://{host}:{port}" }

pub fn is_local(host: String) -> Bool Never! {
    host == "127.0.0.1" || host == "localhost" || host == "::1"
}
