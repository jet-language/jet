C_MAX_STORE_NAME :: 256
C_MAX_STORE_SUBSCRIBERS :: 1000000


// core.web.store — typed state history, transactions, and patches.

#Error
pub enum WebStoreError {
    NotFound
    Invalid
}

pub struct WebStore<T> {
    pub name: String
    pub value: T
    pub history: [T]
    pub cursor: Int
    pub generation: Int
    pub history_enabled: Bool
    pub history_limit: Int
    pub subs: Int
}

pub struct WebStoreEvent {
    pub kind: String
    pub cursor: Int
    pub generation: Int
    pub diff: String
}

pub struct WebStoreTransaction<T> {
    pub label: String
    pub value: T
}

pub struct WebStorePatch<T> {
    pub store: WebStore<T>
    pub backup: T
    pub active: Bool
}

pub struct WebStoreSubscription {
    pub id: Int
    pub active: Bool
    pub selector: String
}

pub struct WebStoreInspection {
    pub name: String
    pub cursor: Int
    pub generation: Int
    pub history_len: Int
}

pub struct Derived<T> {
    pub value: T
}

pub fn new<T>(name: String, value: T) -> WebStore<T> {
    WebStore<T>{name: name, value: value, history: [T]{value}, cursor: 0, generation: 1, history_enabled: true, history_limit: 1000, subs: 0}
}

pub fn with_history<T>(name: String, value: T, limit: Int) -> WebStore<T> {
    store := new<T>(name, value)
    n := limit
    if n < 1 -> n = 1
    if n > 1000 -> n = 1000
    store.history_limit = n
    store
}

pub fn value<T>(store: WebStore<T>) -> T { store.value }
pub fn get<T>(store: WebStore<T>) -> T { store.value }
pub fn signal<T>(store: WebStore<T>) -> String { "{store.name}:{store.generation}" }
pub fn state_signal<T>(store: WebStore<T>) -> String { signal<T>(store) }

pub fn transaction<T>(store: &WebStore<T>, label: String, values: [String], apply: fn(T)) -> WebStoreTransaction<T> {
    apply(store.value)
    record<T>(&store)
    WebStoreTransaction<T>{label: label, value: store.value}
}

pub fn update<T>(store: &WebStore<T>, label: String, values: [String], apply: fn(T)) -> WebStoreTransaction<T> {
    transaction<T>(&store, label, values, apply)
}

pub fn batch<T>(store: &WebStore<T>, label: String, values: [String], apply: fn(T)) -> WebStoreTransaction<T> {
    transaction<T>(&store, label, values, apply)
}

pub fn set<T>(store: &WebStore<T>, value: T) -> WebStoreTransaction<T> {
    store.value = value
    record<T>(&store)
    WebStoreTransaction<T>{label: "set", value: store.value}
}

pub fn set_state<T>(store: &WebStore<T>, value: T) -> WebStoreTransaction<T> { set<T>(&store, value) }

pub fn optimistic<T>(store: &WebStore<T>, label: String, values: [String], apply: fn(T)) -> WebStorePatch<T> {
    backup := store.value
    apply(store.value)
    record<T>(&store)
    WebStorePatch<T>{store: ~store, backup: backup, active: true}
}

pub fn patch<T>(store: &WebStore<T>, label: String, values: [String], apply: fn(T)) -> WebStorePatch<T> {
    optimistic<T>(&store, label, values, apply)
}

pub fn patch_generation<T>(patch: WebStorePatch<T>) -> Int { patch.store.generation }
pub fn patch_active<T>(patch: WebStorePatch<T>) -> Bool { patch.active }

pub fn patch_transaction<T>(patch: WebStorePatch<T>) -> WebStoreTransaction<T> {
    WebStoreTransaction<T>{label: "patch", value: patch.store.value}
}

pub fn patch_commit<T>(patch: &WebStorePatch<T>) -> WebStoreTransaction<T> {
    patch.active = false
    WebStoreTransaction<T>{label: "patch_commit", value: patch.store.value}
}

pub fn patch_rollback<T>(patch: &WebStorePatch<T>) -> ?WebStore<T> {
    if !patch.active -> return None
    store := patch.store
    store.value = patch.backup
    _ :: record<T>(&store)
    patch.active = false
    Val(store)
}

pub fn back<T>(store: &WebStore<T>) -> ?WebStore<T> {
    cursor :: store.cursor
    jump<T>(&store, cursor - 1)
}
pub fn forward<T>(store: &WebStore<T>) -> ?WebStore<T> {
    cursor :: store.cursor
    jump<T>(&store, cursor + 1)
}
pub fn restore<T>(store: &WebStore<T>) -> ?WebStore<T> {
    cursor :: store.cursor
    jump<T>(&store, cursor)
}

pub fn jump<T>(store: &WebStore<T>, index: Int) -> ?WebStore<T> {
    if index < 0 || index >= store.history.len() -> return None
    store.value = store.history[index]
    store.cursor = index
    store.generation = store.generation + 1
    Val(store)
}

pub fn scrub<T>(store: &WebStore<T>, index: Int) -> ?WebStore<T> { jump<T>(&store, index) }

pub fn history<T>(store: WebStore<T>) -> [WebStoreTransaction<T>] {
    out := [WebStoreTransaction<T>]{ }
    loop value in store.history -> out.push(WebStoreTransaction<T>{label: "history", value: value})
    out
}

pub fn history_at<T>(store: WebStore<T>, index: Int) -> ?WebStoreTransaction<T> {
    if index < 0 || index >= store.history.len() -> return None
    Val(WebStoreTransaction<T>{label: "history", value: store.history[index]})
}

pub fn events<T>(store: WebStore<T>) -> [WebStoreEvent] {
    out := [WebStoreEvent]{ }
    loop i in 0..<store.history.len() -> out.push(WebStoreEvent{kind: "commit", cursor: i, generation: store.generation - (store.history.len() - 1 - i), diff: "history"})
    out
}

pub fn events_since<T>(store: WebStore<T>, cursor: Int) -> [WebStoreEvent] {
    out := [WebStoreEvent]{ }
    loop event in events<T>(store) {
        if event.cursor >= cursor -> out.push(event)
    }
    out
}

pub fn clear_history<T>(store: &WebStore<T>) {
    store.history = [T]{store.value}
    store.cursor = 0
    store.generation = store.generation + 1
}

pub fn set_history_limit<T>(store: &WebStore<T>, limit: Int) {
    n := limit
    if n < 1 -> n = 1
    if n > 1000 -> n = 1000
    if n == store.history_limit -> return
    store.history_limit = n
    if store.history.len() > n -> store.history = tail<T>(store.history, n)
    if store.cursor >= store.history.len() -> store.cursor = store.history.len() - 1
    store.generation = store.generation + 1
}

pub fn history_enabled<T>(store: WebStore<T>) -> Bool { store.history_enabled }
pub fn history_limit<T>(store: WebStore<T>) -> Int { store.history_limit }
pub fn cursor<T>(store: WebStore<T>) -> Int { store.cursor }
pub fn current_generation<T>(store: WebStore<T>) -> Int { store.generation }

pub fn subscribe<T>(store: &WebStore<T>, callback: fn(T)) -> WebStoreSubscription {
    if store.subs >= C_MAX_STORE_SUBSCRIBERS -> return WebStoreSubscription{id: store.subs, active: false, selector: ""}
    callback(store.value)
    store.subs = store.subs + 1
    WebStoreSubscription{id: store.subs, active: true, selector: ""}
}

pub fn subscription_unsubscribe(subscription: &WebStoreSubscription) { subscription.active = false }
pub fn subscription_active(subscription: WebStoreSubscription) -> Bool { subscription.active }

pub fn subscribe_selector<T, U>(store: &WebStore<T>, project: fn(T) -> U, callback: fn(U)) -> WebStoreSubscription {
    if store.subs >= C_MAX_STORE_SUBSCRIBERS -> return WebStoreSubscription{id: store.subs, active: false, selector: "derived"}
    callback(project(store.value))
    store.subs = store.subs + 1
    WebStoreSubscription{id: store.subs, active: true, selector: "derived"}
}

pub fn derived<T, U>(store: WebStore<T>, project: fn(T) -> U) -> Derived<U> { Derived<U>{value: project(store.value)} }
pub fn selector<T, U>(store: WebStore<T>, project: fn(T) -> U) -> Derived<U> { derived<T, U>(store, project) }

pub fn inspect<T>(store: WebStore<T>) -> WebStoreInspection {
    WebStoreInspection{name: store.name, cursor: store.cursor, generation: store.generation, history_len: store.history.len()}
}

pub fn facts_json<T>(store: WebStore<T>) -> String {
    "{{\"name\":\"{esc_json(store.name)}\",\"cursor\":{store.cursor},\"generation\":{store.generation},\"history\":{store.history.len()}}}"
}

pub fn event_json<T>(store: WebStore<T>) -> String {
    "{{\"name\":\"{esc_json(store.name)}\",\"cursor\":{store.cursor},\"generation\":{store.generation}}}"
}

fn record<T>(store: &WebStore<T>) !Never {
    store.generation = store.generation + 1
    if !store.history_enabled -> return
    if store.cursor + 1 < store.history.len() {
        kept := [T]{}
        loop i in 0..<(store.cursor + 1) -> kept.push(store.history[i])
        store.history = kept
    }
    store.history.push(store.value)
    if store.history.len() > store.history_limit -> store.history = tail<T>(store.history, store.history_limit)
    store.cursor = store.history.len() - 1
}

fn tail<T>(values: [T], count: Int) -> [T] !Never {
    start := values.len() - count
    if start < 0 -> start = 0
    out := [T]{ }
    loop i in start..<values.len() -> out.push(values[i])
    out
}
fn esc_json(text: String) -> String {
    out := ""
    loop b in text.bytes() {
        if b == (U8{34}) {
            out = "{out}\\\""
        } else if b == (U8{92}) {
            out = "{out}\\\\"
        } else if b == (U8{10}) {
            out = "{out}\\n"
        } else if b == (U8{13}) {
            out = "{out}\\r"
        } else if b == (U8{9}) {
            out = "{out}\\t"
        } else {
            out = "{out}{String.from_bytes([U8]{b}) ?? ""}"
        }
    }
    out
}
