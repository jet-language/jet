use core.reactive as reactive

C_MAX_STORE_NAME :: 256
C_MAX_STORE_SUBSCRIBERS :: 1000000


// core.web.store — typed state history, transactions, and patches.

#Error
pub enum WebStoreError {
    NotFound
    Invalid
}

pub struct WebStore<T> {
    pub name: String
    pub state: Signal<T>
    pub initial: T
    pub transactions: [WebStoreTransaction<T>]
    pub event_log: [WebStoreEvent]
    pub history: [T]
    pub cursor: Int
    pub generation: Int
    pub history_enabled: Bool
    pub history_limit: Int
    pub subs: Int
}

impl WebStore<T> {
    pub fn value(self) -> T Never! { value<T>(self) }
    pub fn get(self) -> T Never! { value<T>(self) }
    pub fn facts_json(self) -> String Never! { facts_json<T>(self) }
    pub fn event_json(self) -> String Never! { event_json<T>(self) }
    pub fn history(self) -> [WebStoreTransaction<T>] Never! { history<T>(self) }
    pub fn events(self) -> [WebStoreEvent] Never! { events<T>(self) }
    pub fn signal(self) -> Signal<T> Never! { signal<T>(self) }
    pub fn state_signal(self) -> Signal<T> Never! { state_signal<T>(self) }
    pub fn set(&self, value: T) -> WebStoreTransaction<T> Never! { set<T>(&self, value) }
    pub fn transact(&self, label: String, apply: fn() Never!) -> WebStoreTransaction<T> Never! { transaction<T>(&self, label, [String]{}, apply) }
    pub fn back(&self) -> WebStore<T>? Never! { back<T>(&self) }
    pub fn forward(&self) -> WebStore<T>? Never! { forward<T>(&self) }
    pub fn jump(&self, index: Int) -> WebStore<T>? Never! { jump<T>(&self, index) }
}

pub struct WebStoreEvent {
    pub kind: String
    pub cursor: Int
    pub generation: Int
    pub diff: String
    pub transaction: String
}

pub struct WebStoreTransaction<T> {
    pub action: String
    pub after: T
    pub generation: Int
    pub changed_fields: [String]
    pub before: T
    pub diff: String
}

pub struct WebStorePatch<T> {
    pub store: WebStore<T>
    pub backup: T
    pub transaction: WebStoreTransaction<T>
    pub active: Bool
}

pub struct WebStoreSubscription {
    pub id: Int
    pub active: Bool
    pub selector: String
}

pub struct WebStoreInspection {
    pub name: String
    pub cursor: Int
    pub generation: Int
    pub history_len: Int
}

pub struct Derived<T> {
    pub value: T
}

impl Derived<T> {
    pub fn get(self) -> T Never! { self.value }
}

pub fn new<T>(name: String, value: T) -> WebStore<T> Never! {
    WebStore<T>{name: name, state: reactive.signal(value), initial: value, history: [T]{}, transactions: [WebStoreTransaction<T>]{}, event_log: [WebStoreEvent]{}, cursor: 0, generation: 0, history_enabled: true, history_limit: 1000, subs: 0}
}

pub fn with_history<T>(name: String, value: T, limit: Int) -> WebStore<T> Never! {
    store := new<T>(name, value)
    n := limit
    if n < 1 -> n = 1
    if n > 1000 -> n = 1000
    store.history_limit = n
    store
}

pub fn value<T>(store: WebStore<T>) -> T Never! { store.state.get() }
pub fn get<T>(store: WebStore<T>) -> T Never! { value<T>(store) }
pub fn signal<T>(store: WebStore<T>) -> Signal<T> Never! { store.state }
pub fn state_signal<T>(store: WebStore<T>) -> Signal<T> Never! { signal<T>(store) }

pub fn transaction<T>(store: &WebStore<T>, label: String, values: [String], apply: fn() Never!) -> WebStoreTransaction<T> Never! {
    before :: value<T>(~store)
    apply()
    record<T>(&store, label, values, before)
}

pub fn update<T>(store: &WebStore<T>, label: String, values: [String], apply: fn() Never!) -> WebStoreTransaction<T> Never! {
    transaction<T>(&store, label, values, apply)
}

pub fn batch<T>(store: &WebStore<T>, label: String, values: [String], apply: fn() Never!) -> WebStoreTransaction<T> Never! {
    transaction<T>(&store, label, values, apply)
}

pub fn set<T>(store: &WebStore<T>, value: T) -> WebStoreTransaction<T> Never! {
    before :: get<T>(~store)
    store.state.set(value)
    record<T>(&store, "set", [String]{}, before)
}

pub fn set_state<T>(store: &WebStore<T>, value: T) -> WebStoreTransaction<T> Never! { set<T>(&store, value) }

pub fn optimistic<T>(store: &WebStore<T>, label: String, values: [String], apply: fn() Never!) -> WebStorePatch<T> Never! {
    backup := value<T>(~store)
    apply()
    transaction :: record<T>(&store, label, values, backup)
    WebStorePatch<T>{store: ~store, backup: backup, transaction: transaction, active: true}
}

pub fn patch<T>(store: &WebStore<T>, label: String, values: [String], apply: fn() Never!) -> WebStorePatch<T> Never! {
    optimistic<T>(&store, label, values, apply)
}

pub fn patch_generation<T>(patch: WebStorePatch<T>) -> Int Never! { patch.store.generation }
pub fn patch_active<T>(patch: WebStorePatch<T>) -> Bool Never! { patch.active }

pub fn patch_transaction<T>(patch: WebStorePatch<T>) -> WebStoreTransaction<T> Never! {
    patch.transaction
}

pub fn patch_commit<T>(patch: &WebStorePatch<T>) -> WebStoreTransaction<T> Never! {
    patch.active = false
    patch_transaction<T>(patch)
}

pub fn patch_rollback<T>(patch: &WebStorePatch<T>) -> WebStore<T>? Never! {
    if !patch.active -> return None
    store := patch.store
    before :: value<T>(store)
    store.state.set(patch.backup)
    _ :: record<T>(&store, "rollback", [String]{}, before)
    patch.active = false
    Val(store)
}

pub fn back<T>(store: &WebStore<T>) -> WebStore<T>? Never! {
    cursor :: store.cursor
    jump<T>(&store, cursor - 1)
}
pub fn forward<T>(store: &WebStore<T>) -> WebStore<T>? Never! {
    cursor :: store.cursor
    jump<T>(&store, cursor + 1)
}
pub fn restore<T>(store: &WebStore<T>) -> WebStore<T>? Never! {
    cursor :: store.cursor
    jump<T>(&store, cursor)
}

pub fn jump<T>(store: &WebStore<T>, index: Int) -> WebStore<T>? Never! {
    if index < 0 || index > store.history.len() -> return None
    store.state.set(if index == 0 -> store.initial else -> store.history[index - 1])
    store.cursor = index
    store.generation = store.generation + 1
    Val(store)
}

pub fn scrub<T>(store: &WebStore<T>, index: Int) -> WebStore<T>? Never! { jump<T>(&store, index) }

pub fn history<T>(store: WebStore<T>) -> [WebStoreTransaction<T>] Never! {
    store.transactions
}

pub fn history_at<T>(store: WebStore<T>, index: Int) -> WebStoreTransaction<T>? Never! {
    if index < 0 || index >= store.transactions.len() -> return None
    Val(store.transactions[index])
}

pub fn events<T>(store: WebStore<T>) -> [WebStoreEvent] Never! {
    store.event_log
}

pub fn events_since<T>(store: WebStore<T>, cursor: Int) -> [WebStoreEvent] Never! {
    out := [WebStoreEvent]{ }
    loop event in events<T>(store) {
        if event.cursor >= cursor -> &out.push(event)
    }
    out
}

pub fn clear_history<T>(store: &WebStore<T>) Never! {
    store.initial = value<T>(~store)
    store.history = [T]{}
    store.transactions = [WebStoreTransaction<T>]{}
    store.event_log = [WebStoreEvent]{}
    store.cursor = 0
    store.generation = store.generation + 1
}

pub fn set_history_limit<T>(store: &WebStore<T>, limit: Int) Never! {
    n := limit
    if n < 1 -> n = 1
    if n > 1000 -> n = 1000
    if n == store.history_limit -> return
    store.history_limit = n
    trim<T>(&store)
    store.generation = store.generation + 1
}

pub fn history_enabled<T>(store: WebStore<T>) -> Bool Never! { store.history_enabled }
pub fn history_limit<T>(store: WebStore<T>) -> Int Never! { store.history_limit }
pub fn cursor<T>(store: WebStore<T>) -> Int Never! { store.cursor }
pub fn current_generation<T>(store: WebStore<T>) -> Int Never! { store.generation }

pub fn subscribe<T>(store: &WebStore<T>, callback: fn(T)) -> WebStoreSubscription Never! {
    if store.subs >= C_MAX_STORE_SUBSCRIBERS -> return WebStoreSubscription{id: store.subs, active: false, selector: ""}
    callback(value<T>(~store))
    store.subs = store.subs + 1
    WebStoreSubscription{id: store.subs, active: true, selector: ""}
}

pub fn subscription_unsubscribe(subscription: &WebStoreSubscription) Never! { subscription.active = false }
pub fn subscription_active(subscription: WebStoreSubscription) -> Bool Never! { subscription.active }

pub fn subscribe_selector<T, U, E>(store: &WebStore<T>, project: fn(T) -> U E!, callback: fn(U)) -> WebStoreSubscription E! {
    if store.subs >= C_MAX_STORE_SUBSCRIBERS -> return WebStoreSubscription{id: store.subs, active: false, selector: "derived"}
    callback(project(value<T>(~store)))
    store.subs = store.subs + 1
    WebStoreSubscription{id: store.subs, active: true, selector: "derived"}
}

pub fn derived<T, U, E>(store: WebStore<T>, project: fn(T) -> U E!) -> Derived<U> E! { Derived<U>{value: project(value<T>(store))} }
pub fn selector<T, U, E>(store: WebStore<T>, project: fn(T) -> U E!) -> Derived<U> E! { derived<T, U, E>(store, project) }

pub fn inspect<T>(store: WebStore<T>) -> WebStoreInspection Never! {
    WebStoreInspection{name: store.name, cursor: store.cursor, generation: store.generation, history_len: store.history.len()}
}

pub fn facts_json<T>(store: WebStore<T>) -> String Never! {
    "{{\"name\":\"{esc_json(store.name)}\",\"generation\":{store.generation},\"cursor\":{store.cursor},\"history_length\":{store.transactions.len()},\"history_limit\":{store.history_limit},\"event_length\":{store.event_log.len()},\"history_enabled\":{store.history_enabled}}}"
}

pub fn event_json<T>(store: WebStore<T>) -> String Never! {
    if store.event_log.len() == 0 -> return "{{\"name\":\"{esc_json(store.name)}\",\"transaction\":\"\",\"diff\":\"\",\"cursor\":{store.cursor}}}"
    event :: store.event_log[store.event_log.len() - 1]
    "{{\"name\":\"{esc_json(store.name)}\",\"transaction\":\"{esc_json(event.transaction)}\",\"diff\":\"{esc_json(event.diff)}\",\"cursor\":{store.cursor}}}"
}

fn record<T>(store: &WebStore<T>, action: String, fields: [String], before: T) -> WebStoreTransaction<T> Never! {
    store.generation = store.generation + 1
    changed := [String]{}
    loop field in fields -> &changed.push("\"{esc_json(field)}\"")
    diff :: "{{\"kind\":\"transaction\",\"generation\":{store.generation},\"action\":\"{esc_json(action)}\",\"changed_fields\":[{changed.join(",")}]}}"
    transaction :: WebStoreTransaction<T>{action: action, after: value<T>(~store), generation: store.generation, changed_fields: fields, before: before, diff: diff}
    if store.history_enabled {
        if store.cursor < store.history.len() {
            kept := [T]{}
            entries := [WebStoreTransaction<T>]{}
            loop i in 0..<store.cursor {
                &kept.push(store.history[i])
                &entries.push(store.transactions[i])
            }
            store.history = kept
            store.transactions = entries
        }
        &store.history.push(value<T>(~store))
        &store.transactions.push(transaction)
        store.cursor = store.history.len()
        &store.event_log.push(WebStoreEvent{kind: "commit", cursor: store.cursor, generation: store.generation, diff: diff, transaction: "{action}#{store.generation}"})
        trim<T>(&store)
    }
    transaction
}

fn trim<T>(store: &WebStore<T>) Never! {
    excess :: store.history.len() - store.history_limit
    if excess > 0 {
        store.initial = store.history[excess - 1]
        store.history = tail<T>(store.history, store.history_limit)
        store.transactions = tail<WebStoreTransaction<T>>(store.transactions, store.history_limit)
        store.cursor = store.cursor - excess
        if store.cursor < 0 -> store.cursor = 0
    }
    if store.event_log.len() > store.history_limit -> store.event_log = tail<WebStoreEvent>(store.event_log, store.history_limit)
}

fn tail<T>(values: [T], count: Int) -> [T] Never! {
    start := values.len() - count
    if start < 0 -> start = 0
    out := [T]{ }
    loop i in start..<values.len() -> &out.push(values[i])
    out
}
fn esc_json(text: String) -> String {
    out := ""
    loop b in text.bytes() {
        if b == (U8{34}) {
            out = "{out}\\\""
        } else if b == (U8{92}) {
            out = "{out}\\\\"
        } else if b == (U8{10}) {
            out = "{out}\\n"
        } else if b == (U8{13}) {
            out = "{out}\\r"
        } else if b == (U8{9}) {
            out = "{out}\\t"
        } else {
            out = "{out}{String.from_bytes([U8]{b}) ?? ""}"
        }
    }
    out
}
