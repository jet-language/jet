C_MAX_STORE_NAME :: 256
C_MAX_STORE_SUBSCRIBERS :: 1000000


// core.web.store — typed state history, transactions, and patches.

#Error
enum WebStoreError {
    NotFound
    Invalid
}

struct WebStore<T> {
    name: String
    value: T
    history: [T]
    cursor: Int
    generation: Int
    history_enabled: Bool
    history_limit: Int
    subs: Int
}

struct WebStoreEvent {
    kind: String
    cursor: Int
    generation: Int
    diff: String
}

struct WebStoreTransaction<T> {
    label: String
    value: T
}

struct WebStorePatch<T> {
    store: WebStore<T>
    backup: T
    active: Bool
}

struct WebStoreSubscription {
    id: Int
    active: Bool
    selector: String
}

struct WebStoreInspection {
    name: String
    cursor: Int
    generation: Int
    history_len: Int
}

struct Derived<T> {
    value: T
}

fn new<T>(name: String, value: T) -> WebStore<T> Never! {
    WebStore<T>{name: name, value: value, history: [T]{value}, cursor: 0, generation: 1, history_enabled: true, history_limit: 1000, subs: 0}
}

fn with_history<T>(name: String, value: T, limit: Int) -> WebStore<T> Never! {
    store := new<T>(name, value)
    n := limit
    if n < 1 -> n = 1
    if n > 1000 -> n = 1000
    store.history_limit = n
    store
}

fn value<T>(store: WebStore<T>) -> T Never! { store.value }
fn get<T>(store: WebStore<T>) -> T Never! { store.value }
fn signal<T>(store: WebStore<T>) -> String Never! { "{store.name}:{store.generation}" }
fn state_signal<T>(store: WebStore<T>) -> String Never! { signal<T>(store) }

fn transaction<T>(store: &WebStore<T>, label: String, values: [String], apply: fn(T)) -> WebStoreTransaction<T> Never! {
    apply(store.value)
    record<T>(&store)
    WebStoreTransaction<T>{label: label, value: store.value}
}

fn update<T>(store: &WebStore<T>, label: String, values: [String], apply: fn(T)) -> WebStoreTransaction<T> Never! {
    transaction<T>(&store, label, values, apply)
}

fn batch<T>(store: &WebStore<T>, label: String, values: [String], apply: fn(T)) -> WebStoreTransaction<T> Never! {
    transaction<T>(&store, label, values, apply)
}

fn set<T>(store: &WebStore<T>, value: T) -> WebStoreTransaction<T> Never! {
    store.value = value
    record<T>(&store)
    WebStoreTransaction<T>{label: "set", value: store.value}
}

fn set_state<T>(store: &WebStore<T>, value: T) -> WebStoreTransaction<T> Never! { set<T>(&store, value) }

fn optimistic<T>(store: &WebStore<T>, label: String, values: [String], apply: fn(T)) -> WebStorePatch<T> Never! {
    backup := store.value
    apply(store.value)
    record<T>(&store)
    WebStorePatch<T>{store: ~store, backup: backup, active: true}
}

fn patch<T>(store: &WebStore<T>, label: String, values: [String], apply: fn(T)) -> WebStorePatch<T> Never! {
    optimistic<T>(&store, label, values, apply)
}

fn patch_generation<T>(patch: WebStorePatch<T>) -> Int Never! { patch.store.generation }
fn patch_active<T>(patch: WebStorePatch<T>) -> Bool Never! { patch.active }

fn patch_transaction<T>(patch: WebStorePatch<T>) -> WebStoreTransaction<T> Never! {
    WebStoreTransaction<T>{label: "patch", value: patch.store.value}
}

fn patch_commit<T>(patch: &WebStorePatch<T>) -> WebStoreTransaction<T> Never! {
    patch.active = false
    WebStoreTransaction<T>{label: "patch_commit", value: patch.store.value}
}

fn patch_rollback<T>(patch: &WebStorePatch<T>) -> WebStore<T>? Never! {
    if !patch.active -> return None
    store := patch.store
    store.value = patch.backup
    _ :: record<T>(&store)
    patch.active = false
    Val(store)
}

fn back<T>(store: &WebStore<T>) -> WebStore<T>? Never! {
    cursor :: store.cursor
    jump<T>(&store, cursor - 1)
}
fn forward<T>(store: &WebStore<T>) -> WebStore<T>? Never! {
    cursor :: store.cursor
    jump<T>(&store, cursor + 1)
}
fn restore<T>(store: &WebStore<T>) -> WebStore<T>? Never! {
    cursor :: store.cursor
    jump<T>(&store, cursor)
}

fn jump<T>(store: &WebStore<T>, index: Int) -> WebStore<T>? Never! {
    if index < 0 || index >= store.history.len() -> return None
    store.value = store.history[index]
    store.cursor = index
    store.generation = store.generation + 1
    Val(store)
}

fn scrub<T>(store: &WebStore<T>, index: Int) -> WebStore<T>? Never! { jump<T>(&store, index) }

fn history<T>(store: WebStore<T>) -> [WebStoreTransaction<T>] Never! {
    out := [WebStoreTransaction<T>]{ }
    loop value in store.history -> &out.push(WebStoreTransaction<T>{label: "history", value: value})
    out
}

fn history_at<T>(store: WebStore<T>, index: Int) -> WebStoreTransaction<T>? Never! {
    if index < 0 || index >= store.history.len() -> return None
    Val(WebStoreTransaction<T>{label: "history", value: store.history[index]})
}

fn events<T>(store: WebStore<T>) -> [WebStoreEvent] Never! {
    out := [WebStoreEvent]{ }
    loop i in 0..<store.history.len() -> &out.push(WebStoreEvent{kind: "commit", cursor: i, generation: store.generation - (store.history.len() - 1 - i), diff: "history"})
    out
}

fn events_since<T>(store: WebStore<T>, cursor: Int) -> [WebStoreEvent] Never! {
    out := [WebStoreEvent]{ }
    loop event in events<T>(store) {
        if event.cursor >= cursor -> &out.push(event)
    }
    out
}

fn clear_history<T>(store: &WebStore<T>) Never! {
    store.history = [T]{store.value}
    store.cursor = 0
    store.generation = store.generation + 1
}

fn set_history_limit<T>(store: &WebStore<T>, limit: Int) Never! {
    n := limit
    if n < 1 -> n = 1
    if n > 1000 -> n = 1000
    if n == store.history_limit -> return
    store.history_limit = n
    if store.history.len() > n -> store.history = tail<T>(store.history, n)
    if store.cursor >= store.history.len() -> store.cursor = store.history.len() - 1
    store.generation = store.generation + 1
}

fn history_enabled<T>(store: WebStore<T>) -> Bool Never! { store.history_enabled }
fn history_limit<T>(store: WebStore<T>) -> Int Never! { store.history_limit }
fn cursor<T>(store: WebStore<T>) -> Int Never! { store.cursor }
fn current_generation<T>(store: WebStore<T>) -> Int Never! { store.generation }

fn subscribe<T>(store: &WebStore<T>, callback: fn(T)) -> WebStoreSubscription Never! {
    if store.subs >= C_MAX_STORE_SUBSCRIBERS -> return WebStoreSubscription{id: store.subs, active: false, selector: ""}
    callback(store.value)
    store.subs = store.subs + 1
    WebStoreSubscription{id: store.subs, active: true, selector: ""}
}

fn subscription_unsubscribe(subscription: &WebStoreSubscription) Never! { subscription.active = false }
fn subscription_active(subscription: WebStoreSubscription) -> Bool Never! { subscription.active }

fn subscribe_selector<T, U, E>(store: &WebStore<T>, project: fn(T) -> U E!, callback: fn(U)) -> WebStoreSubscription E! {
    if store.subs >= C_MAX_STORE_SUBSCRIBERS -> return WebStoreSubscription{id: store.subs, active: false, selector: "derived"}
    callback(project(store.value))
    store.subs = store.subs + 1
    WebStoreSubscription{id: store.subs, active: true, selector: "derived"}
}

fn derived<T, U, E>(store: WebStore<T>, project: fn(T) -> U E!) -> Derived<U> E! { Derived<U>{value: project(store.value)} }
fn selector<T, U, E>(store: WebStore<T>, project: fn(T) -> U E!) -> Derived<U> E! { derived<T, U, E>(store, project) }

fn inspect<T>(store: WebStore<T>) -> WebStoreInspection Never! {
    WebStoreInspection{name: store.name, cursor: store.cursor, generation: store.generation, history_len: store.history.len()}
}

fn facts_json<T>(store: WebStore<T>) -> String Never! {
    "{{\"name\":\"{esc_json(store.name)}\",\"cursor\":{store.cursor},\"generation\":{store.generation},\"history\":{store.history.len()}}}"
}

fn event_json<T>(store: WebStore<T>) -> String Never! {
    "{{\"name\":\"{esc_json(store.name)}\",\"cursor\":{store.cursor},\"generation\":{store.generation}}}"
}

fn record<T>(store: &WebStore<T>) Never! {
    store.generation = store.generation + 1
    if !store.history_enabled -> return
    if store.cursor + 1 < store.history.len() {
        kept := [T]{}
        loop i in 0..<(store.cursor + 1) -> &kept.push(store.history[i])
        store.history = kept
    }
    &store.history.push(store.value)
    if store.history.len() > store.history_limit -> store.history = tail<T>(store.history, store.history_limit)
    store.cursor = store.history.len() - 1
}

fn tail<T>(values: [T], count: Int) -> [T] Never! {
    start := values.len() - count
    if start < 0 -> start = 0
    out := [T]{ }
    loop i in start..<values.len() -> &out.push(values[i])
    out
}
fn esc_json(text: String) -> String {
    out := ""
    loop b in text.bytes() {
        if b == (U8{34}) {
            out = "{out}\\\""
        } else if b == (U8{92}) {
            out = "{out}\\\\"
        } else if b == (U8{10}) {
            out = "{out}\\n"
        } else if b == (U8{13}) {
            out = "{out}\\r"
        } else if b == (U8{9}) {
            out = "{out}\\t"
        } else {
            out = "{out}{String.from_bytes([U8]{b}) ?? ""}"
        }
    }
    out
}
