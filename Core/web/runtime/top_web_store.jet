#Unsafe("read native wall clock; preserve zero when epoch subtraction or width conversion fails")
fn jet_web_store_now_ms() -> U64 {
    SystemTime.now().duration_since(UNIX_EPOCH).ok().and_then(fn(duration) { U64.try_from(duration.as_millis()).ok() }).unwrap_or(0)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebStore.rs:42
fn jet_web_store_json(value: String) -> String { "{value:?}" }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebStore.rs:46
fn jet_web_store_event_entity(name: String) -> String {
    if !name.is_empty() && name.len() <= JET_WEB_STORE_MAX_NAME && !name.chars().any(Char.is_control) { name.to_string() }
    else { "store" }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebStore.rs:57
fn jet_web_store_publish_event(name: String, event: &JetWebStoreEvent) -> Unit {
    if !jet_web_runtime_devtools_enabled() -> return
    fields :: "\{\"name\":{jet_web_store_json(name)},\"transaction\":{jet_web_store_json(event.transaction_label())},\"diff\":{event.diff_json()},\"cursor\":{event.cursor},\"generation\":{event.generation},\"kind\":{jet_web_store_json(event.kind.as_str())}\}"
    if JetDevtoolsEvent.from_parts(jet_web_store_now_ms(), "core.web.store", "Store", jet_web_store_event_entity(name), fields) == Ok(protocol_event) {
        jet_devtools_publish_event(^protocol_event)
    }
}
