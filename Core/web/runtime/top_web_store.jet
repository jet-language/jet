    fn navigate(self: &Self, navigation: JetWebStoreNavigation) -> T? {
        _transaction_lock :: self.transaction_lock.lock()
        (value, event) :: {
            ledger := self.ledger.lock().unwrap_or_else(fn(error) { error.into_inner() })
            if !jet_web_store_history_capture_enabled() || ledger.history_limit == 0 || ledger.history.is_empty() -> return None
            current_cursor :: ledger.cursor
            (target_cursor, value, generation, action) :: match navigation {
                .Back -> {
                    target_cursor :: current_cursor.checked_sub(1)?
                    value :: if target_cursor == 0 { ledger.initial.clone() } else { ledger.history.get(target_cursor - 1)?.after.clone() }
                    generation :: if target_cursor == 0 { 0 } else { ledger.history.get(target_cursor - 1)?.generation }
                    (target_cursor, ^value, generation, "back")
                }
                .Forward -> {
                    transaction :: ledger.history.get(current_cursor)?
                    (current_cursor + 1, transaction.after.clone(), transaction.generation, "forward")
                }
                .Jump(generation) -> {
                    if generation == 0 { (0, ledger.initial.clone(), 0, "jump:0") }
                    else {
                        (index, transaction) :: ledger.history.iter().enumerate().find(fn((_, transaction)) { transaction.generation == generation })?
                        (index + 1, transaction.after.clone(), transaction.generation, "jump:{generation}")
                    }
                }
            }
            if target_cursor == current_cursor -> return Val(^value)
            _ :: self.shared.replace(value.clone())
            ledger.cursor = target_cursor
            ledger.current_generation = generation
            sequence :: &ledger.reserve_sequence()
            event :: &ledger.record_event(sequence, .Navigation, generation, ^action, [])
            (^value, ^event)
        }
        self.signal.set(value.clone())
        if event == Val(event) { self.transaction_lock.defer_event(self.name.clone(), ^event) }
        Val(^value)
    }
