        event :: ledger.events.back() ?? return "\{\"name\":\"{jet_web_store_json_escape(&self.name)}\",\"transaction\":\"\",\"diff\":\"\{\}\",\"cursor\":{ledger.cursor}\}"
        diff :: jet_web_store_json_escape(event.diff_json())
