enum JetWebStoreNavigation { Back, Forward, Jump(U64) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebStore.rs:962
pub fn jet_web_store<T: Clone + Send + Sync>(name: String, initial: T) -> JetWebStore<T> {
    jet_web_store_with_history(^name, ^initial, jet_web_store_default_history_limit())
