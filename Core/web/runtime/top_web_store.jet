        JetWebStoreInspection{value: ^value, generation: ledger.current_generation, cursor: ledger.cursor as U64, history: ledger.history.iter().cloned().collect(), events: ledger.events.iter().cloned().collect(), history_limit: ledger.history_limit, history_enabled: jet_web_store_history_capture_enabled()}
    }
