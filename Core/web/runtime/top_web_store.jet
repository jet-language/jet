// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebStore.rs:1295
fn jet_web_store_fields(fields: [String]) -> [String] {
    result := [String]{}
    loop field in fields.into_iter().take(JET_WEB_STORE_MAX_FIELDS) {
        if !field.is_empty() && field.len() <= JET_WEB_STORE_MAX_FIELD && !field.chars().any(Char.is_control) && !result.iter().any(fn(existing) { existing == &field }) {
            &result.push(^field)
        }
    }
    &result.sort_unstable()
    ^result
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebStore.rs:1310
fn jet_web_store_action(action: String) -> String {
    action :: if action.is_empty() { "update" } else { ^action }
    sanitized := String.new()
    loop character in action.chars().filter(fn(character) { !character.is_control() }) {
        if sanitized.len() + character.len_utf8() > JET_WEB_STORE_MAX_FIELD -> break
        &sanitized.push(character)
    }
    if sanitized.is_empty() { "update" } else { ^sanitized }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebStore.rs:1331
fn jet_web_store_json_escape(value: String) -> String {
    escaped := String.with_capacity(value.len())
    loop character in value.chars() {
        match character {
            '"' -> &escaped.push_str("\\\"")
            '\\' -> &escaped.push_str("\\\\")
            '\n' -> &escaped.push_str("\\n")
            '\r' -> &escaped.push_str("\\r")
            '\t' -> &escaped.push_str("\\t")
            character if character.is_control() -> &escaped.push_str("\\u{character as U32:04x}")
            character -> &escaped.push(character)
        }
    }
    ^escaped
}

