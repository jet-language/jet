// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebStore.rs:969
// GATE #4565: kernel primitive
#Unsafe("type-and-name registry retains compatible stores under native mutex; incompatible/unretained constructors stay independent")
pub fn jet_web_store_with_history<T: Clone + Send + Sync>(name: String, initial: T, history_limit: I64) -> JetWebStore<T> {
    retain :: !name.is_empty() && name.len() <= JET_WEB_STORE_MAX_NAME && !name.chars().any(Char.is_control)
    key :: (TypeId.of<T>(), name.clone())
    registry := jet_web_store_registry().lock().unwrap_or_else(fn(error) { error.into_inner() })
    if registry.get(&key).and_then(fn(value) { value.downcast_ref<JetWebStore<T>>() }) == Val(existing) -> return existing.clone()
    if !retain || registry.len() >= JET_WEB_STORE_MAX_REGISTRY {
        drop(^registry)
        return JetWebStore.new(^name, ^initial, history_limit)
    }
    store :: JetWebStore.new(^name, ^initial, history_limit)
    _ :: &registry.insert(^key, Box.new(store.clone()))
    ^store
}
