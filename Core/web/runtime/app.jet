// Rust: crates/jet-codegen/src/Prelude/App.rs:475
fn jet_app_router_value_type(ty: String) -> JetWebRouterValueType Never! {
    match ty {
        "Int" -> .Int, "Bool" -> .Bool, "Float" -> .Float, "String" | "Text" -> .String, _ -> .Json
    }
}
// Rust: crates/jet-codegen/src/Prelude/App.rs:485
fn jet_app_search_field(item: String) -> JetAppSearchField Err! {
    (name, raw_ty) :: item.split_once('=').ok_or_else(() -> "invalid search field binding `{item}`")?
    (ty, required) :: match raw_ty.strip_suffix('?') {
        Val(ty) -> (ty, false), None -> (raw_ty, true)
    }
    if name.is_empty() || ty.is_empty() -> return Err("invalid search field binding `{item}`")
    Ok(JetAppSearchField{name: name.to_string(), ty: ty.to_string(), required})
}
// Rust: crates/jet-codegen/src/Prelude/App.rs:505
pub fn jet_app_route_binding(spec: String) -> [JetAppRouteBinding] Never! {
    spec.split(';').filter(item -> not item.is_empty()).map(item -> {
        if item == "d" -> return Ok(JetAppRouteBinding.Data)
        if item.strip_prefix("p:") is Val(rest) {
            (name, ty) :: rest.split_once('=').ok_or_else(() -> "invalid path binding `{item}`")?
            if name.is_empty() || ty.is_empty() -> return Err("invalid path binding `{item}`")
            return Ok(JetAppRouteBinding.Path{name: name.to_string(), ty: ty.to_string()})
        }
        if item.strip_prefix("s=") is Val(rest) {
            (codec, field_text) :: rest.split_once(':').ok_or_else(() -> "invalid search binding `{item}`")?
            fields :: field_text.split(',').filter(field -> not field.is_empty()).map(jet_app_search_field)
                .collect<[JetAppSearchField] Err!>()?
            scalar :: match codec {
                "json" -> None
                "query" if fields.len() == 1 -> Val(~fields[0].name)
                _ -> return Err("invalid search binding `{item}`")
            }
            return Ok(JetAppRouteBinding.Search{codec: codec.to_string(), fields: ^fields, scalar})
        }
        Err("invalid route input binding `{item}`")
    }).collect<[JetAppRouteBinding] Err!>()
        .unwrap_or_else(error -> jet_app_invalid("invalid app route binding: {error}"))
}

// Rust: crates/jet-codegen/src/Prelude/App.rs:553
fn jet_app_scalar_search_tree(navigation: JetWebNavigation, name: String, fields: [JetAppSearchField]) -> DataTree Err! {
    match navigation.search.get(name) {
        Val(value) -> Ok(DataTree.Text(~value))
        None if fields.iter().any(field -> field.name == name && not field.required) -> Ok(DataTree.Null)
        None -> Err("route `{navigation.route}` has no search field `{name}`")
    }
}
// Rust: crates/jet-codegen/src/Prelude/App.rs:571
pub struct JetAppRouteInputs {
    binding: View<JetAppRouteBinding>
    navigation: @JetWebNavigation
    data: @String
}
impl JetAppRouteInputs {
    // Rust: crates/jet-codegen/src/Prelude/App.rs:581
    pub fn tree(self, index: Int) -> DataTree Err! {
        route :: self.navigation.route
        binding :: self.binding.get(index).ok_or_else(() -> "route `{route}` input {index} has no checked binding")?
        Ok(match binding {
            .Path{name, ..} -> DataTree.Text(self.navigation.params.get(name)
                .map(value -> ~value).ok_or_else(() -> "route `{route}` has no path parameter `{name}`")?)
            .Search{scalar: Val(name), fields, ..} -> jet_app_scalar_search_tree(self.navigation, name, fields)?
            .Search{..} -> DataTree.Object(self.navigation.search.iter()
                .map((name, value) -> (~name, DataTree.Text(~value))).collect())
            .Data -> DataTree.TypedText(self.data.to_string())
        })
    }
    // Rust: crates/jet-codegen/src/Prelude/App.rs:611
    pub fn arity(self) -> Int Never! { self.binding.len() }
    // Rust: crates/jet-codegen/src/Prelude/App.rs:615
    pub fn decode<T: __jet_Decode>(self, index: Int) -> T Err! {
        route :: self.navigation.route
        binding :: self.binding.get(index).ok_or_else(() -> "route `{route}` input {index} has no checked binding")?
        tree :: match binding {
            .Path{name, ..} -> DataTree.Text(self.navigation.params.get(name)
                .map(value -> ~value).ok_or_else(() -> "route `{route}` has no path parameter `{name}`")?)
            .Search{scalar: Val(name), fields, ..} -> jet_app_scalar_search_tree(self.navigation, name, fields)?
            .Search{..} -> DataTree.Object(self.navigation.search.iter()
                .map((name, value) -> (~name, DataTree.Text(~value))).collect())
            .Data -> return jet_enc_json_decode<T>(self.data.to_string())
                .map_err(errors -> "route `{route}` loader data: {errors:?}")
        }
        T.jet_decode(tree).map_err(errors -> "route `{route}` {binding.label()}: {errors:?}")
    }
}
