// Rust: crates/jet-codegen/src/Prelude/App.rs:871
fn jet_app_binding_facts(binding: [JetAppRouteBinding]) -> ([JetAppRouteField], [JetAppRouteField], String) Never! {
    path_params := [JetAppRouteField]{}
    search_params := [JetAppRouteField]{}
    search_codec := "query"
    loop entry in binding {
        match entry {
            .Path{name, ty} -> &path_params.push(JetAppRouteField{name: ~name, ty: ~ty, codec: "path", required: true, default: None})
            .Search{codec, fields, ..} -> {
                search_codec = ~codec
                &search_params.extend(fields.iter().map(field ->
                    JetAppRouteField{name: ~field.name, ty: ~field.ty, codec: ~codec, required: field.required, default: None}))
            }
            .Data -> {}
        }
    }
    (^path_params, ^search_params, ^search_codec)
}
