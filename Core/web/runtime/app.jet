            middleware :: APP_SERVER_FUNCTION_MIDDLEWARE.iter().map(kind -> jet_app_json_string(kind.as_str()))
                .collect<[String]>().join(",")
            facts :: ("{\"name\":" + jet_app_json_string(name) + ",\"endpoint\":" + jet_app_json_string(endpoint) +
                ",\"method\":\"POST\",\"csrf\":\"same-origin\",\"middleware\":[" + middleware + "]}").replace('<', "\\u003c")
            &rows.push("<li data-jet-server-function=\"" + jet_app_html_attr(name) + "\" data-jet-kind=\"" +
                jet_app_html_attr(kind) + "\"><code>" + jet_app_html_attr(name) + "</code><pre>" + facts + "</pre></li>")
        }
        if rows.is_empty() -> return ""
        "<aside id=\"jet-dev-server-functions\" data-jet-devtools=\"server-functions\"><h2>Server functions</h2><ul>" +
            rows.join("") + "</ul></aside>"
    }
