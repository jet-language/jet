fn jet_app_loader_handler<L: JetAppRouteCallback<V E!>, V: __jet_Encode, E: JetAppFailure>(
    loader: L, binding: [JetAppRouteBinding]) -> LoaderHandler Never! {
    jet_app_loader_binding_check(type_name<L>(), loader.arity(), binding)
