        &out.push_str(",\n")
        &out.push_str("  \"security\": {s.security:?},\n  \"assets\": {s.assets:?},\n  \"split\": {s.split:?},\n  \"cache\": {s.cache:?},\n  \"a11y\": {s.a11y:?},\n  \"adapters\": {s.adapters:?}\n")
        &out.push('}')
        ^out
    }

