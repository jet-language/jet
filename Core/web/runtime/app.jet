            Ok(current) -> {
                handler :: self.lock().routes.iter().find(route -> route.path == current.route)
                    .map(route -> (~route.handler, ~route.error))
                match handler {
                    Val((handler, error)) -> match handler(current, navigation.data) {
                        Ok(page) -> (I64{200}, page)
                        Err(message) -> (I64{500}, JetApp.boundary_page(error, "Route error", message))
                    }
                    None -> (I64{500}, JetWebPage{title: "Route error",
                        body: "route `{current.route}` is not registered on the app graph"})
                }
            }
            Err(message) -> {
                error_boundary :: navigation.current.and_then(current ->
                    self.lock().routes.iter().find(route -> route.path == current.route).and_then(route -> ~route.error))
                status :: if navigation.current.is_some() { I64{500} }
                    else if message.starts_with("no web route matches") { I64{404} } else { I64{400} }
                page :: if status == I64{404} {
                    not_found :: ~self.lock().not_found
                    JetApp.boundary_page(not_found, "Not found", message)
                } else {
