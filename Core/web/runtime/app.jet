    fn query_dev_panel(self) -> String Never! { jet_web_query_dev_panel() }
    // Rust: crates/jet-codegen/src/Prelude/App.rs:1665
    fn form_dev_panel(self) -> String Never! { jet_web_form_dev_panel() }
    // Rust: crates/jet-codegen/src/Prelude/App.rs:1670
    fn html(self, response: JetAppResponse, dev: Bool) -> String Never! {
        reload :: if dev {
            "<script>\nconst source = new EventSource(\"/__jet/reload\");\nsource.onmessage = () => location.reload();\n</script>"
        } else { "" }
        route_data :: match response.navigation.current {
            Val(current) if response.status == I64{200} -> {
                route_data_body :: if response.navigation.data.is_empty() { "null" }
                    else { response.navigation.data.replace('<', "\\u003c") }
                "<script type=\"application/json\" id=\"jet-route-data\" data-route=\"" + jet_app_html_attr(current.route) +
                    "\" data-url=\"" + jet_app_html_attr(current.url) + "\" data-status=\"" +
                    response.navigation.status.name() + "\">" + route_data_body + "</script>"
            }
            _ -> ""
        }
        server_functions :: if dev { self.server_function_dev_panel() } else { "" }
        queries :: if dev { self.query_dev_panel() } else { "" }
        forms :: if dev { self.form_dev_panel() } else { "" }
        "<!doctype html><html><head><meta charset=\"utf-8\"><title>" + response.page.title +
            "</title></head><body>" + response.page.body + route_data + reload + server_functions + queries + forms + "</body></html>"
    }
