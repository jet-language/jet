// Rust: crates/jet-codegen/src/Prelude/App.rs:231
#Derive(Clone, Debug, Default, Eq, PartialEq)
pub struct JetAppRouteFacts {
    pub route_identity: String
    pub path_params: [JetAppRouteField]
    pub search_params: [JetAppRouteField]
    pub search_codec: String
    pub loader_contract: JetAppLoaderFacts?
    pub pending_boundary: String?
    pub not_found_boundary: String?
    pub error_boundary: String?
    pub mode: JetAppRenderMode
    pub reason: [String]
    pub effects: [String]
    pub interactive: Bool
    pub loader: String?
    pub form: String?
    pub cache: String
    pub override_mode: JetAppRenderMode?
    pub pending_boundary_id: U64?
    pub island_identity: String?
    pub hydration_trigger: JetAppHydrationTrigger?
}
impl JetAppRouteFacts {
    // Rust: crates/jet-codegen/src/Prelude/App.rs:254
    pub fn with_mode(mode: JetAppRenderMode) -> JetAppRouteFacts Never! {
        facts := JetAppRouteFacts.default()
        facts.mode = mode
        facts.reason = ["explicit render mode `{mode.as_str()}`"]
        facts.override_mode = Val(mode)
        ^facts
    }
    // Rust: crates/jet-codegen/src/Prelude/App.rs:263
    fn json(self) -> String Never! {
        reason :: self.reason.iter().map(value -> jet_app_json_string(value)).collect<[String]>().join(",")
        effects :: self.effects.iter().map(value -> jet_app_json_string(value)).collect<[String]>().join(",")
        path_params :: self.path_params.iter().map(jet_app_route_field_json).collect<[String]>().join(",")
        search_params :: self.search_params.iter().map(jet_app_route_field_json).collect<[String]>().join(",")
        loader :: self.loader.map(jet_app_json_string).unwrap_or("null")
        loader_contract :: self.loader_contract.map(jet_app_loader_facts_json).unwrap_or("null")
        form :: self.form.map(jet_app_json_string).unwrap_or("null")
        override_mode :: self.override_mode.map(mode -> jet_app_json_string(mode.as_str())).unwrap_or("null")
        pending_boundary_id :: self.pending_boundary_id.map(id -> id.to_string()).unwrap_or("null")
        pending :: self.pending_boundary.map(jet_app_json_string).unwrap_or("null")
        not_found :: self.not_found_boundary.map(jet_app_json_string).unwrap_or("null")
        error :: self.error_boundary.map(jet_app_json_string).unwrap_or("null")
        island :: self.island_identity.map(identity -> {
            trigger :: self.hydration_trigger.unwrap_or(.Immediate)
            "{\"identity\":" + jet_app_json_string(identity) + ",\"hydration_trigger\":" +
                jet_app_json_string(trigger.as_str()) + ",\"resume_payload\":{\"captures\":[],\"serializable\":false}}"
        }).unwrap_or("null")
        search_codec :: if self.search_codec.is_empty() { "query" } else { self.search_codec }
        cache :: if self.cache.is_empty() { "unspecified" } else { self.cache }
        "{\"route_identity\":" + jet_app_json_string(self.route_identity) +
            ",\"path_params\":[" + path_params + "],\"search_params\":[" + search_params +
            "],\"search_codec\":" + jet_app_json_string(search_codec) +
            ",\"loader_contract\":" + loader_contract + ",\"pending_boundary\":" + pending +
            ",\"not_found_boundary\":" + not_found + ",\"error_boundary\":" + error +
            ",\"mode\":" + jet_app_json_string(self.mode.as_str()) + ",\"reason\":[" + reason +
            "],\"effects\":[" + effects + "],\"interactive\":" + self.interactive.to_string() +
            ",\"loader\":" + loader + ",\"form\":" + form + ",\"cache\":" + jet_app_json_string(cache) +
            ",\"override_mode\":" + override_mode + ",\"pending_boundary_id\":" + pending_boundary_id +
            ",\"island\":" + island + "}"
    }
}
// Rust: crates/jet-codegen/src/Prelude/App.rs:364
fn jet_app_route_field_json(field: JetAppRouteField) -> String Never! {
    default :: field.default.map(jet_app_json_string).unwrap_or("null")
    "{\"name\":" + jet_app_json_string(field.name) + ",\"ty\":" + jet_app_json_string(field.ty) +
        ",\"codec\":" + jet_app_json_string(field.codec) + ",\"required\":" + field.required.to_string() +
        ",\"default\":" + default + "}"
}
// Rust: crates/jet-codegen/src/Prelude/App.rs:380
fn jet_app_loader_facts_json(loader: JetAppLoaderFacts) -> String Never! {
    "{\"handler\":" + jet_app_json_string(loader.handler) + ",\"data_type\":" + jet_app_json_string(loader.data_type) +
        ",\"dependency\":" + jet_app_json_string(loader.dependency) + ",\"preload\":" + loader.preload.to_string() +
        ",\"cache_identity\":" + jet_app_json_string(loader.cache_identity) + "}"
}
// Rust: crates/jet-codegen/src/Prelude/App.rs:391
fn jet_app_route_identity(path: String) -> String Never! {
    hash := U64{0xcbf29ce484222325}
    loop byte in path.as_bytes() {
        hash = hash ^ U64{byte}
        hash = hash.wrapping_mul(U64{0x100000001b3})
    }
    "route-{hash:016x}"
}
// Rust: crates/jet-codegen/src/Prelude/App.rs:400
fn jet_app_json_string(value: String) -> String Never! {
    out := String.with_capacity(value.len() + 2)
    &out.push('"')
    loop character in value.chars() {
        match character {
            '"' -> &out.push_str("\\\"")
            '\\' -> &out.push_str("\\\\")
            '\n' -> &out.push_str("\\n")
            '\r' -> &out.push_str("\\r")
            '\t' -> &out.push_str("\\t")
            character if U32{character} < U32{0x20} -> &out.push_str("\\u{U32{character}:04x}")
            character -> &out.push(character)
        }
    }
    &out.push('"')
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/App.rs:420
fn jet_app_html_attr(value: String) -> String Never! {
    out := String.with_capacity(value.len())
    loop character in value.chars() {
        match character {
            '&' -> &out.push_str("&amp;"), '<' -> &out.push_str("&lt;")
            '>' -> &out.push_str("&gt;"), '"' -> &out.push_str("&quot;")
            character -> &out.push(character)
        }
    }
    ^out
}
