//RS     /// `.loader(route, loader)`: the route handler value only names the
//RS     /// route in source; sema proves it is the handler of the route registered
//RS     /// immediately before, which is where the loader attaches.
//RS     pub fn jet_app_loader<T, L, V, E>(
//RS         app: &JetApp,
//RS         _route: T,
//RS         loader: L,
//RS         binding: String,
//RS     ) -> JetApp
//RS     where
//RS         T: 'static,
//RS         L: JetAppRouteCallback<Result<V, E>>,
//RS         V: super::__jet_Encode + 'static,
//RS         E: JetAppFailure + 'static,
//RS     {
//RS         app.loader(loader, jet_app_route_binding(&binding), false)
