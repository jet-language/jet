// Rust: crates/jet-codegen/src/Prelude/App.rs:55
fn jet_app_server_function<I: __jet_Decode, O: __jet_Encode, E: JetAppFailure, F: fn(I) -> O E!>(
    name: String, source_id: String, handler: F) -> JetWebServerFunction Never! {
    input_type :: type_name<I>().to_string()
    output_type :: type_name<O>().to_string()
    error_type :: type_name<E>().to_string()
    dispatch: JetWebServerFnHandler :: Arc.new((_context, body) -> {
        input :: jet_enc_json_decode<I>(body.to_string()).map_err(errors ->
            JetWebServerFnError.InvalidInput("{errors:?}"))?
        match handler(^input) {
            Ok(output) -> Ok(jet_enc_json_to_string(output))
            Err(error) -> Err(JetWebServerFnError.Handler{code: "application_error", message: error.into_app_failure()})
        }
    })
    jet_web_server_fn_typed(name, source_id, "POST", input_type, output_type, error_type, dispatch)
        .unwrap_or_else(error -> jet_app_invalid("invalid app server function: {error:?}"))
}
// Rust: crates/jet-codegen/src/Prelude/App.rs:94
fn jet_app_unit_server_function<O: __jet_Encode, E: JetAppFailure, F: fn() -> O E!>(
    name: String, source_id: String, handler: F) -> JetWebServerFunction Never! {
    output_type :: type_name<O>().to_string()
    error_type :: type_name<E>().to_string()
    dispatch: JetWebServerFnHandler :: Arc.new((_context, _body) -> {
        match handler() {
            Ok(output) -> Ok(jet_enc_json_to_string(output))
            Err(error) -> Err(JetWebServerFnError.Handler{code: "application_error", message: error.into_app_failure()})
        }
    })
    jet_web_server_fn_typed(name, source_id, "POST", "Unit", output_type, error_type, dispatch)
        .unwrap_or_else(error -> jet_app_invalid("invalid app server function: {error:?}"))
}
