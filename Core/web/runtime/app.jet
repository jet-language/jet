// Rust: crates/jet-codegen/src/Prelude/App.rs:766
fn jet_app_page_handler<F: JetAppRouteCallback<R>, R: JetAppPageOutput>(
    handler: F, binding: [JetAppRouteBinding]) -> PageHandler Never! {
    if binding.len() != handler.arity() {
        jet_app_invalid("app route handler `{type_name<F>()}` takes {handler.arity()} inputs but the checked binding has {binding.len()}")
    }
    Arc.new((navigation, data) -> {
        inputs :: JetAppRouteInputs{binding: binding[0..<binding.len()], navigation: @navigation, data: @data}
        handler.call_route(inputs)?.into_page()
    })
}
// Rust: crates/jet-codegen/src/Prelude/App.rs:789
fn jet_app_boundary_handler<F: JetAppRouteCallback<R>, R: JetAppPageOutput>(handler: F) -> BoundaryHandler Never! {
    if handler.arity() != 0 -> jet_app_invalid("app boundary handler `{type_name<F>()}` must take no inputs")
    navigation :: JetWebNavigation{url: "", route: "", params: [:], search: [:]}
    Arc.new(() -> {
        inputs :: JetAppRouteInputs{binding: [], navigation: @navigation, data: @""}
        handler.call_route(inputs)?.into_page()
    })
}
// Rust: crates/jet-codegen/src/Prelude/App.rs:816
fn jet_app_loader_binding_check(identity: String, arity: Int, binding: [JetAppRouteBinding]) -> Never! {
    if binding.len() != arity {
        jet_app_invalid("app loader `{identity}` takes {arity} inputs but the checked binding has {binding.len()}")
    }
    if binding.iter().any(binding -> binding is .Data) {
        jet_app_invalid("app loader `{identity}` cannot consume its own route data")
    }
}
