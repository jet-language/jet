    Search { codec: String, fields: [JetAppSearchField], scalar: String? }
    Data
}
impl JetAppRouteBinding {
    // Rust: crates/jet-codegen/src/Prelude/App.rs:465
    fn label(self) -> String Never! {
        match self {
            .Path{name, ..} -> "path parameter `{name}`"
            .Search{scalar: Val(name), ..} -> "search field `{name}`"
            .Search{..} -> "search record"
            .Data -> "loader data"
        }
    }
