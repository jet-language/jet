    fn build_router(state: JetAppState) -> JetWebRouter Never! {
        router := JetWebRouter.new()
        loop route in state.routes {
            params := [JetWebRouterField]{}
            search := [JetWebRouterField]{}
            codec := JetWebRouterSearchCodec.Query
