fn jet_web_query_dev_state(status: WebQueryStatus) -> String {
    match status { WebQueryStatus.Pending -> "pending", WebQueryStatus.Fresh -> "fresh", WebQueryStatus.Stale -> "stale", WebQueryStatus.Fetching -> "fetching", WebQueryStatus.Error -> "error", WebQueryStatus.Offline -> "offline" }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:551
fn jet_web_query_publish_state(key: String, footprint: String, state: &JetWebQueryState, observers: I64, cause: String, mutation: WebMutationStatus, freshness_ms: U64) -> {
    if !jet_web_runtime_devtools_enabled() -> return
    state_name :: jet_web_query_dev_state(state.status)
    fields :: "\{\"name\":{jet_web_query_json(key)},\"state\":{jet_web_query_json(state_name)},\"footprint\":{jet_web_query_json(footprint)},\"freshness_ms\":{freshness_ms},\"observers\":{observers.max(0)},\"invalidation_cause\":{jet_web_query_json(cause)},\"mutation_state\":{jet_web_query_json(mutation.name())}\}"
    if JetDevtoolsEvent.from_parts(jet_web_query_now_ms(), "core.web.query", "Query", key.to_string(), fields) is Ok(event) -> jet_devtools_publish_event(event)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:585
fn jet_web_query_publish_mutation(key: String, lifecycle: JetDevtoolsMutationLifecycle, rollback: Bool) -> {
    if !jet_web_runtime_devtools_enabled() -> return
    lifecycle_name :: match lifecycle {
        JetDevtoolsMutationLifecycle.Started -> "started"
        JetDevtoolsMutationLifecycle.Committed -> "committed"
        JetDevtoolsMutationLifecycle.Failed -> "failed"
        JetDevtoolsMutationLifecycle.RolledBack -> "rolled_back"
    }
    fields :: "\{\"name\":{jet_web_query_json(key)},\"lifecycle\":{jet_web_query_json(lifecycle_name)},\"rollback\":{rollback}\}"
    if JetDevtoolsEvent.from_parts(jet_web_query_now_ms(), "core.web.query", "Mutation", key.to_string(), fields) is Ok(event) -> jet_devtools_publish_event(event)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:616
// GATE #4565: kernel primitive
#Unsafe("count queued mutations while holding native queue mutex; preserve unavailable fallback")
fn jet_web_query_queue_count(key: String) -> Int {
    queue := JET_WEB_QUERY_OFFLINE_QUEUE.lock() ?? return 0
    if jet_web_query_queue_load(&queue).is_err() -> return 0
    queue.entries.iter().filter(fn(entry) { entry.key == key }).count()
