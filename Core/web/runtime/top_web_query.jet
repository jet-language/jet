    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:1538
    fn set_mutation(self: &Self, state: JetWebMutationState) -> {
        self.mutation.set(state.clone())
        if state.status == WebMutationStatus.Pending {
            jet_web_query_publish_mutation(&self.key, JetDevtoolsMutationLifecycle.Started, state.rollback)
        } else if state.status == WebMutationStatus.Success {
            jet_web_query_publish_mutation(&self.key, JetDevtoolsMutationLifecycle.Committed, state.rollback)
        } else if state.status == WebMutationStatus.Error {
            jet_web_query_publish_mutation(&self.key, JetDevtoolsMutationLifecycle.Failed, state.rollback)
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:1549
    fn publish_state(self: &Self, state: &JetWebQueryState, cause: String) -> {
        observers :: self.live.as_ref().map(jet_app_live_observers).unwrap_or(0)
        jet_web_query_publish_state(&self.key, &self.footprint, state, observers, cause, self.mutation.get().status,
            self.live.as_ref().map(jet_app_live_freshness_ms).unwrap_or(0))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:1569
    fn sync_live_state(self: &Self) -> {
        live :: self.live.as_ref() ?? return
        live :: jet_app_live_snapshot(live)
        state := self.state.get()
        state.value = live.value.clone()
        state.generation = live.lifecycle.generation
        state.queued = jet_web_query_queue_count(&self.key)
        if !live.lifecycle.error.is_empty() {
            state.status = WebQueryStatus.Error
            state.error = live.lifecycle.error
        } else if live.lifecycle.refreshing {
            state.status = WebQueryStatus.Fetching
            state.error.clear()
        } else if live.lifecycle.dirty {
            state.status = if state.offline { WebQueryStatus.Offline } else { WebQueryStatus.Stale }
        } else if !state.offline && (state.status != WebQueryStatus.Pending || !live.value.is_empty()) {
            state.status = WebQueryStatus.Fresh
            state.error.clear()
        }
        if state != self.state.get() -> self.set_state(state, "live-sync")
