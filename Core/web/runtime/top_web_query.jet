// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:424
// GATE #4565: kernel primitive
#Unsafe("hold query panel registry mutex across identity lookup and retained signal replacement")
fn jet_web_query_register_panel_fact(query: &JetWebQuery) -> {
    facts := JET_WEB_QUERY_PANEL_FACTS.lock() ?? return
    if facts.iter_mut().find(fn(fact) { fact.key == query.key }) is Val(fact) {
        fact.footprint = query.footprint.clone()
        fact.state = query.state.clone()
        fact.mutation = query.mutation.clone()
        fact.live = query.live.clone()
        fact.mode = query.mode.clone()
        return
    }
    facts.push(JetWebQueryPanelFact{key: query.key.clone(), footprint: query.footprint.clone(), state: query.state.clone(), mutation: query.mutation.clone(), live: query.live.clone(), mode: query.mode.clone()})
}
