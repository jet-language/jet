}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:454
// Development-only facts expose identity/lifecycle and byte counts, never values or errors.
// GATE #4565: kernel primitive
#Unsafe("snapshot panel and live lifecycle facts under their native registry guards")
pub fn jet_web_query_dev_panel() -> String {
    facts :: JET_WEB_QUERY_PANEL_FACTS.lock() ?? return ""
    rows: [String] := []
    for fact in facts.iter() {
        state :: fact.state.get()
        mutation :: fact.mutation.get()
        mode :: fact.mode.lock().map(fn(mode) { mode.name() }).unwrap_or("unknown")
        (generation, observers, freshness_ms, cause) :: fact.live.as_ref().and_then(fn(live) {
            registry :: jet_live_registry().lock() ?? return None
            stored :: registry.queries.get(&live.id)?
            Val((stored.lifecycle.generation, if stored.sink.is_some() { 1 } else { 0 },
                jet_live_age_ms(stored.lifecycle.fresh_at_ms), stored.lifecycle.invalidation_cause.clone()))
        }).unwrap_or((state.generation, 0, 0, "none"))
        facts_text :: "key={fact.key},footprint={fact.footprint},state={jet_web_query_dev_state(state.status)},generation={generation},freshness_ms={freshness_ms},observers={observers},cause={cause},mode={mode},mutation={mutation.status.name()},queued={state.queued},value_bytes={state.value.len()},error_bytes={state.error.len()}"
        rows.push("<li data-jet-query-key=\"{jet_web_query_html_attr(fact.key)}\"><code>{jet_web_query_html_attr(fact.key)}</code><pre>{jet_web_query_html_attr(facts_text)}</pre></li>")
    }
    if rows.is_empty() -> return ""
    "<aside id=\"jet-dev-queries\" data-jet-devtools=\"queries\"><h2>Queries</h2><ul>{rows.join("")}</ul></aside>"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:516
// GATE #4565: kernel primitive
#Unsafe("hold query panel registry while projecting identity-only JSON facts")
pub fn jet_web_query_facts_json() -> String {
    facts :: JET_WEB_QUERY_PANEL_FACTS.lock() ?? return "[]"
    items :: facts.iter().map(fn(fact) {
        kind :: if fact.footprint.starts_with("ext:") { "subscribe" } else { "live" }
        "\{\"key\":{jet_web_query_json(fact.key)},\"footprint\":{jet_web_query_json(fact.footprint)},\"source\":\"runtime\",\"kind\":{jet_web_query_json(kind)}\}"
    }).collect<[String]>().join(",")
    "[{items}]"
}
