#Unsafe("select durable queue location from the actual OS environment")
fn jet_web_query_queue_path() -> OSPath? {
    if env.var_os("JET_WEB_QUERY_QUEUE_PATH") is Val(path) {
        if !path.is_empty() -> return Val(OSPath.from(path))
    }
    base :: env.var_os("XDG_STATE_HOME").map(OSPath.from)
        .or_else(fn() { env.var_os("HOME").map(fn(home) { OSPath.from(home).join(".local/state") }) })?
    Val(base.join("jet").join("web-query-queue.v1"))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:67
fn jet_web_query_hex(value: String) -> String {
    HEX :: "0123456789abcdef".as_bytes()
    encoded := String.with_capacity(value.len().saturating_mul(2))
    for byte in value.as_bytes() {
        encoded.push(HEX[(byte >> 4) as Int] as Char)
        encoded.push(HEX[(byte & 0x0f) as Int] as Char)
    }
    encoded
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:77
fn jet_web_query_unhex(value: String) -> String? {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:78
    fn nibble(byte: U8) -> U8? {
        match byte {
            48..=57 -> Val(byte - 48)
            97..=102 -> Val(byte - 97 + 10)
            65..=70 -> Val(byte - 65 + 10)
            _ -> None
        }
    }
    if value.len() % 2 != 0 -> return None
    bytes: [U8] := [U8].with_capacity(value.len() / 2)
    for pair in value.as_bytes().chunks_exact(2) -> bytes.push((nibble(pair[0])? << 4) | nibble(pair[1])?)
    String.from_utf8(bytes).ok()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:96
fn jet_web_query_durability_error<D: Display>(detail: D) -> String { "offline mutation durability unavailable: {detail}" }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:100
// GATE #4565: kernel primitive
#Unsafe("read the actual durable queue file, preserving not-found and native read failures")
fn jet_web_query_queue_load(queue: &JetWebQueryQueueState) -> () Err! {
    if queue.loaded -> return queue.load_error.clone().map_or(Ok(()), Err)
    queue.loaded = true
    path :: jet_web_query_queue_path() ?? {
        error :: jet_web_query_durability_error("no state directory is available")
        queue.load_error = Val(error.clone())
        return Err(error)
    }
    contents :: match fs.read_to_string(&path) {
        Ok(contents) -> contents
        Err(error) if error.kind() == ErrorKind.NotFound -> return Ok(())
        Err(error) -> {
            error :: jet_web_query_durability_error(error)
            queue.load_error = Val(error.clone())
            return Err(error)
        }
    }
    parsed :: fn() -> () Err! {
        lines := contents.lines()
        if lines.next() != Val(JET_WEB_QUERY_QUEUE_FORMAT) -> return Err(jet_web_query_durability_error("queue file has an unknown format"))
        for line in lines.filter(fn(line) { !line.is_empty() }) {
            fields: [String] :: line.split('\t').collect()
            match fields.as_slice() {
                ["next", sequence] -> {
                    queue.next_sequence = sequence.parse<U64>().map_err(fn(_) { jet_web_query_durability_error("queue sequence is not an integer") })?
                }
                ["entry", sequence, key, payload, invalidations] -> {
                    if queue.entries.len() >= JET_WEB_QUERY_MAX_QUEUE -> return Err(jet_web_query_durability_error("queue file exceeds the entry limit"))
                    sequence :: sequence.parse<U64>().map_err(fn(_) { jet_web_query_durability_error("queued mutation sequence is not an integer") })?
                    key :: jet_web_query_unhex(key).ok_or_else(fn() { jet_web_query_durability_error("queued mutation key is not valid UTF-8") })?
                    payload :: jet_web_query_unhex(payload).ok_or_else(fn() { jet_web_query_durability_error("queued mutation payload is not valid UTF-8") })?
                    invalidations :: if invalidations.is_empty() { [] } else {
                        invalidations.split(',').map(fn(target) {
                            jet_web_query_unhex(target).ok_or_else(fn() { jet_web_query_durability_error("queued invalidation target is not valid UTF-8") })
                        }).collect<[String] Err!>()?
                    }
                    queue.next_sequence = queue.next_sequence.max(sequence)
                    queue.entries.push_back(JetWebQueryQueuedMutation{sequence, key, payload, invalidations})
                }
                _ -> return Err(jet_web_query_durability_error("queue file contains an invalid row"))
            }
        }
        Ok(())
    }()
    if parsed is Err(error) {
        queue.load_error = Val(error.clone())
        return Err(error)
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:196
// GATE #4565: kernel primitive
#Unsafe("persist actual queue via same-directory temporary file and atomic native rename; remove failed temporary")
fn jet_web_query_queue_persist(queue: &JetWebQueryQueueState) -> () Err! {
    path :: jet_web_query_queue_path() ?? return Err(jet_web_query_durability_error("no state directory is available"))
    contents := "{JET_WEB_QUERY_QUEUE_FORMAT}\nnext\t{queue.next_sequence}\n"
    for entry in &queue.entries {
        invalidations :: entry.invalidations.iter().map(jet_web_query_hex).collect<[String]>().join(",")
        contents.push_str("entry\t{entry.sequence}\t{jet_web_query_hex(entry.key)}\t{jet_web_query_hex(entry.payload)}\t{invalidations}\n")
    }
    if path.parent() is Val(parent) -> fs.create_dir_all(parent).map_err(jet_web_query_durability_error)?
    temp :: path.with_extension("v1.tmp.{process.id()}")
    fs.write(&temp, contents).map_err(jet_web_query_durability_error)?
    if fs.rename(&temp, &path) is Err(error) {
        _ :: fs.remove_file(&temp)
        return Err(jet_web_query_durability_error(error))
    }
    Ok(())
}
