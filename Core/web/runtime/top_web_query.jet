// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:626
// GATE #4565: kernel primitive
#Unsafe("serialize durable enqueue and roll back entry and sequence on persistence failure, recovering poisoned queue")
fn jet_web_query_enqueue(key: String, payload: String, invalidations: [String]) -> Int Err! {
    queue := JET_WEB_QUERY_OFFLINE_QUEUE.lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() })
    jet_web_query_queue_load(&queue)?
    key_count :: queue.entries.iter().filter(fn(entry) { entry.key == key }).count()
    if queue.entries.len() >= JET_WEB_QUERY_MAX_QUEUE || key_count >= JET_WEB_QUERY_MAX_QUEUE -> return Err("offline query queue is full")
    previous_sequence :: queue.next_sequence
    queue.next_sequence = queue.next_sequence.saturating_add(1).max(1)
    sequence :: queue.next_sequence
    queue.entries.push_back(JetWebQueryQueuedMutation{sequence, key: key.to_string(), payload, invalidations})
    if jet_web_query_queue_persist(&queue) is Err(error) {
        _ :: queue.entries.pop_back()
        queue.next_sequence = previous_sequence
        return Err(error)
    }
    Ok(key_count.saturating_add(1))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:656
// GATE #4565: kernel primitive
#Unsafe("snapshot this key's durable replay entries under the recovered queue guard")
fn jet_web_query_queued(key: String) -> [JetWebQueryQueuedMutation] Err! {
    queue := JET_WEB_QUERY_OFFLINE_QUEUE.lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() })
    jet_web_query_queue_load(&queue)?
    Ok(queue.entries.iter().filter(fn(entry) { entry.key == key }).cloned().collect())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:669
// GATE #4565: kernel primitive
#Unsafe("persist removal under queue guard and restore the same entry position if persistence fails")
fn jet_web_query_remove_queued(key: String, sequence: U64) -> () Err! {
    queue := JET_WEB_QUERY_OFFLINE_QUEUE.lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() })
    jet_web_query_queue_load(&queue)?
    index :: queue.entries.iter().position(fn(entry) { entry.key == key && entry.sequence == sequence }) ?? return Ok(())
    removed :: queue.entries.remove(index)
    if jet_web_query_queue_persist(&queue) is Err(error) {
        if removed is Val(removed) -> queue.entries.insert(index, removed)
        return Err(error)
    }
    Ok(())
}

impl JetWebQuery {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:692
    // GATE #4565: kernel primitive
    #Unsafe("retain query policy and mutation serialization in shared native mutexes")
