    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:1409
    fn retry_with<F: Fn(String) -> () Err!>(self: &Self, send: F) -> Int Err! {
        if !self.is_online() -> return Err("query replay paused while offline")
        entries :: jet_web_query_queued(&self.key)?
        sent: Int := 0
        for entry in entries {
            if send(entry.payload.clone()) is Err(error) {
                error :: jet_web_query_bound_error(error)
                mutation := self.mutation.get()
                mutation.status = WebMutationStatus.Error
                mutation.error = error.clone()
                mutation.paused = true
                mutation.queued = jet_web_query_queue_count(&self.key)
                self.set_mutation(mutation.clone())
                settled := mutation
                settled.status = WebMutationStatus.Settled
                self.set_mutation(settled)
                state := self.state.get()
                state.queued = jet_web_query_queue_count(&self.key)
                state.offline = true
                state.status = WebQueryStatus.Offline
                state.error = error.clone()
                self.set_state(state, "replay-error")
                return Err(error)
            }
            if jet_web_query_remove_queued(&self.key, entry.sequence) is Err(error) {
                error :: jet_web_query_bound_error(error)
                mutation := self.mutation.get()
                mutation.status = WebMutationStatus.Error
                mutation.error = error.clone()
                mutation.paused = true
                mutation.queued = jet_web_query_queue_count(&self.key)
                self.set_mutation(mutation.clone())
                settled := mutation
                settled.status = WebMutationStatus.Settled
                self.set_mutation(settled)
                state := self.state.get()
                state.queued = jet_web_query_queue_count(&self.key)
                state.offline = true
                state.status = WebQueryStatus.Offline
                state.error = error.clone()
                self.set_state(state, "replay-persist-error")
                return Err(error)
            }
            self.invalidate_targets(&entry.invalidations)
            sent = sent.saturating_add(1)
            queued :: jet_web_query_queue_count(&self.key)
            mutation := self.mutation.get()
            mutation.status = WebMutationStatus.Success
            mutation.paused = false
            mutation.queued = queued
            mutation.replayed = mutation.replayed.saturating_add(1)
            mutation.error.clear()
            self.set_mutation(mutation.clone())
            settled := mutation
            settled.status = WebMutationStatus.Settled
            self.set_mutation(settled)
            state := self.state.get()
            state.queued = queued
            state.offline = queued > 0
            state.status = if state.offline { WebQueryStatus.Offline } else { WebQueryStatus.Fresh }
            state.error.clear()
            self.set_state(state, "replayed")
        }
        Ok(sent)
    }
