// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:241
fn jet_web_query_valid_key(key: String) -> Bool {
    !key.trim().is_empty() && key.len() <= JET_WEB_QUERY_MAX_KEY && key.chars().all(fn(character) { !character.is_control() })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebQuery.rs:246
fn jet_web_query_targets(targets: [String]) -> [String] Err! {
    if targets.len() > JET_WEB_QUERY_MAX_INVALIDATIONS -> return Err("query invalidation list exceeds {JET_WEB_QUERY_MAX_INVALIDATIONS} entries")
    normalized: [String] := [String].with_capacity(targets.len())
    for target in targets {
        target := target.trim() // #4303
        if target.is_empty() || target.len() > JET_WEB_QUERY_MAX_INVALIDATION_TARGET || target.chars().any(fn(c) { c.is_control() }) {
            return Err("query invalidation target is invalid")
        }
        if target.strip_prefix("key:").is_some_and(fn(key) { key.trim().is_empty() }) -> return Err("query invalidation target is invalid")
        if !normalized.iter().any(fn(existing) { existing.as_str() == target }) -> normalized.push(target.to_string())
    }
    Ok(normalized)
}
