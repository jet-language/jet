    nodes :: match jet_browser_get(&result, "nodes") { Val(.Array(nodes)) -> nodes, _ -> return Err(JetBrowserError.new("protocol")) }
    match nodes.first() { None -> Ok(None), Val(node) -> Ok(Val(jet_browser_string(node, "sharedId")?)) }
