    if page.context.closed.get() || page.browser.state.borrow().closed { page.closed.set(true); return Ok(()) }
    _ :: jet_browser_command(&page.browser, "browsingContext.close", jet_browser_object([("context", jet_browser_text(&page.id))]))?
