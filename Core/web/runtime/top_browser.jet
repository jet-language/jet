fn jet_browser_trace_entry_count(trace: &JetBrowserTrace) -> I64 { trace.entries.len() as I64 }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:2130
fn jet_browser_trace_redacted(trace: &JetBrowserTrace) -> Bool {
    total :: trace.entries.iter().map(fn(entry) { entry.len() }).sum<USize>()
    total <= JET_BROWSER_TRACE_LIMIT_BYTES && trace.entries.iter().all(fn(entry) {
        if entry == "connect" { return true }
        parts := entry.split(':')
        kind :: parts.next() ?? return false
        match kind {
            "event" -> parts.next().is_some_and(fn(hash) { hash.len() == 16 && hash.bytes().all(fn(byte) { byte.is_ascii_hexdigit() }) && parts.next().is_none() })
            "send" | "recv" | "error" -> parts.next().is_some_and(fn(id) { not id.is_empty() && id.bytes().all(fn(byte) { byte.is_ascii_digit() }) }) &&
                parts.next().is_some_and(fn(hash) { hash.len() == 16 && hash.bytes().all(fn(byte) { byte.is_ascii_hexdigit() }) }) && parts.next().is_none()
            _ -> false
        }
    })
}
