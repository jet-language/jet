fn jet_browser_css_attr_equals(attr: &String, value: &String) -> String {
    escaped := String.with_capacity(value.len())
    for ch in value.chars() {
        match ch { '\\' | '"' -> { escaped.push('\\'); escaped.push(ch) }, _ -> escaped.push(ch) }
    }
    "[{attr}=\"{escaped}\"]"
}
