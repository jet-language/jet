// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:601
fn jet_browser_parse_locked(raw: &String, engine: &String) -> JetBrowserLocked JetBrowserError! {
    current := None
    in_browser := false
    found := None
    for line in raw.lines() {
        line := line.trim() // #4303
        if line.is_empty() || line.starts_with('#') { continue }
        if line.starts_with('[') {
            if in_browser {
                if current.take() is Val(entry) { if entry.engine == engine { found = Val(^entry) } }
            }
            in_browser = line == "[[browser]]"
            if in_browser { current = Val(JetBrowserLocked{engine: "", version: "", binary: "", protocol: "", size: 0, output_hash: ""}) }
            continue
        }
        if not in_browser { continue }
        entry := current.as_mut() ?? continue
        (key, val) :: line.split_once('=') ?? continue
        key := key.trim() // #4303
        val := val.trim().trim_matches('"') // #4303
        match key {
            "engine" -> entry.engine = val.to_string()
            "version" -> entry.version = val.to_string()
            "binary" -> entry.binary = val.to_string()
            "protocol" -> entry.protocol = val.to_string()
            "size" -> entry.size = val.parse<I64>().map_err(fn(_) { JetBrowserError.new("invalid lock") })?
            "output-hash" -> entry.output_hash = val.to_string()
            _ -> {}
        }
    }
    if in_browser { if current.take() is Val(entry) { if entry.engine == engine { found = Val(^entry) } } }
    locked :: found.ok_or_else(fn() { JetBrowserError.new("missing lock") })?
    if locked.engine.is_empty() || locked.binary.is_empty() || locked.protocol.is_empty() || locked.output_hash.is_empty() { return Err(JetBrowserError.new("invalid lock")) }
    Ok(^locked)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:672
// GATE #4565: kernel primitive
#Unsafe("selected filesystem reads lock and verifies actual binary existence and size without executing it")
fn jet_browser_locked(engine: &String) -> JetBrowserLocked JetBrowserError! {
    engine_name :: match engine.as_str() { "chromium" | "firefox" | "webkit" -> engine.as_str(), _ -> return Err(JetBrowserError.new("unknown engine")) }
    root :: jet_browser_project_root()
    lock_path :: OSPath.from(&root).join(".jet/lock")
    raw :: fs.read_to_string(&lock_path).map_err(fn(_) { JetBrowserError.new("missing lock") })?
    locked :: jet_browser_parse_locked(&raw, engine_name)?
    path :: OSPath.from(&locked.binary)
    if not path.is_file() { return Err(JetBrowserError.new("missing binary")) }
    size :: fs.metadata(path).map_err(fn(_) { JetBrowserError.new("missing binary") })?.len() as I64
    if size != locked.size { return Err(JetBrowserError.new("size mismatch")) }
    Ok(^locked)
}
