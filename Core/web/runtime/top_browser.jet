fn jet_browser_locator_query_with_timeout(locator: &JetBrowserLocator, timeout_ms: I64) -> String? JetBrowserError! {
    if locator.page.closed.get() || locator.page.context.closed.get() { return Err(JetBrowserError.new("closed")) }
