fn jet_browser_locator_pointer(locator: &JetBrowserLocator, shared_id: &String, down_up: Bool) -> Unit JetBrowserError! {
    origin :: jet_browser_object([("type", jet_browser_text("element")), ("element", jet_browser_object([("sharedId", jet_browser_text(shared_id))]))])
    actions := [jet_browser_object([("type", jet_browser_text("pointerMove")), ("x", DataTree.Float(0.0)), ("y", DataTree.Float(0.0)), ("origin", ^origin)])]
