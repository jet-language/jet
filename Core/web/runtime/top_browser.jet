fn jet_browser_trace_push(state: &JetBrowserState, entry: String) -> {
    if entry.len() > JET_BROWSER_TRACE_LIMIT_BYTES { return }
    loop state.trace_bytes.saturating_add(entry.len()) > JET_BROWSER_TRACE_LIMIT_BYTES {
        if state.trace.is_empty() { break }
        state.trace_bytes = state.trace_bytes.saturating_sub(state.trace.remove(0).len())
    }
    state.trace_bytes += entry.len()
    state.trace.push(^entry)
}
