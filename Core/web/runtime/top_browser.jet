// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:379
fn jet_browser_event_network_facts(value: &DataTree) -> (String, String, String, Bool, I64) {
    params :: jet_browser_get(value, "params") ?? return ("", "", "", false, 0)
    is_blocked :: match jet_browser_get(params, "isBlocked") { Val(.Bool(true)) -> true, _ -> false }
    request :: jet_browser_get(params, "request")
    request_id :: request.and_then(fn(request) { jet_browser_string(request, "request").ok() }).unwrap_or_default()
    request_method :: request.and_then(fn(request) { jet_browser_string(request, "method").ok() }).unwrap_or_default()
    url_hash :: request.and_then(fn(request) { jet_browser_string(request, "url").ok() })
        .or_else(fn() { jet_browser_string(params, "url").ok() }).map(fn(url) { jet_browser_fact_hash(&url) }).unwrap_or_default()
    status_code :: jet_browser_get(params, "response").and_then(fn(response) {
        match jet_browser_get(response, "status") {
            Val(.Int(value)) if *value >= 0 && *value <= 599 -> Val(*value as I64)
            Val(.Float(value)) if value.is_finite() && value.fract() == 0.0 && *value >= 0.0 && *value <= 599.0 -> Val(*value as I64)
            Val(.Number(value)) -> value.parse<I64>().ok().filter(fn(value) { *value >= 0 && *value <= 599 })
            _ -> None
        }
    }).unwrap_or(0)
    (^request_id, ^request_method, ^url_hash, is_blocked, status_code)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:419
fn jet_browser_event_download_facts(value: &DataTree) -> (String, String) {
    params :: jet_browser_get(value, "params") ?? return ("", "")
