fn jet_browser_locator_fingerprint(locator: &JetBrowserLocator) -> String {
    identity := locator.locator_type.clone()
    identity.push(':'); identity.push_str(&locator.role)
    identity.push(':'); identity.push_str(&locator.name)
    identity.push(':'); identity.push_str(&locator.value)
    jet_browser_fact_hash(&identity)
