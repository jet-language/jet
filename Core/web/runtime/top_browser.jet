    suggested_filename_hash :: jet_browser_string(params, "suggestedFilename").map(fn(name) { jet_browser_fact_hash(&name) }).unwrap_or_default()
    (^download_id, ^suggested_filename_hash)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:430
fn jet_browser_capture_event(state: &JetBrowserState, value: &DataTree) -> Bool JetBrowserError! {
    kind :: match jet_browser_get(value, "type") {
        Val(.Text(kind)) | Val(.TypedText(kind)) -> kind
        _ -> return Err(JetBrowserError.new("protocol"))
    }
    if kind != "event" { return Ok(false) }
    method :: jet_browser_string(value, "method")?
    (request_id, request_method, url_hash, is_blocked, status_code) :: jet_browser_event_network_facts(value)
    (download_id, suggested_filename_hash) :: jet_browser_event_download_facts(value)
    jet_browser_trace_push(state, "event:{jet_browser_fact_hash(&method)}")
    if state.events.len() == JET_BROWSER_EVENT_LIMIT { _ :: state.events.pop_front() }
    state.events.push_back(JetBrowserEvent{method: ^method, request_id: ^request_id, request_method: ^request_method,
        url_hash: ^url_hash, is_blocked: is_blocked, status_code: status_code, download_id: ^download_id, suggested_filename_hash: ^suggested_filename_hash})
    Ok(true)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:463
fn jet_browser_profile_allows(profile: &String, method: &String) -> Bool {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:464
    const BIDI_2024_11: [String] = [
        "session.status", "session.new", "session.end", "session.subscribe",
        "browser.createUserContext", "browser.removeUserContext", "browser.setDownloadBehavior",
        "browsingContext.create", "browsingContext.close", "browsingContext.getTree",
        "browsingContext.navigate", "browsingContext.reload", "browsingContext.locateNodes",
        "browsingContext.captureScreenshot", "browsingContext.print", "input.performActions",
        "input.releaseActions", "input.setFiles", "network.addIntercept", "network.continueRequest",
        "network.failRequest", "network.provideResponse", "network.removeIntercept", "storage.getCookies",
        "storage.setCookie", "storage.deleteCookies", "script.callFunction", "script.disown",
        "script.evaluate", "script.getRealms", "goog:cdp.sendCommand"
    ]
    match profile {
        "bidi-2024.11" -> BIDI_2024_11.contains(&method)
        "bidi-2025.5" -> BIDI_2024_11.contains(&method) || method == "permissions.setPermission" || method == "webExtension.install" || method == "webExtension.uninstall"
        _ -> false
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:512
fn jet_browser_command_with_timeout(browser: &JetBrowser, method: &String, params: DataTree, timeout_ms: I64) -> DataTree JetBrowserError! {
    state := browser.state.borrow_mut()
    if state.closed { return Err(JetBrowserError.new("closed")) }
    if not jet_browser_profile_allows(&state.profile, method) { return Err(JetBrowserError.new("unsupported protocol")) }
    if method == "goog:cdp.sendCommand" && not state.cdp { return Err(JetBrowserError.new("unsupported protocol")) }
    // GATE #4565: kernel primitive
    deadline :: #Unsafe("one absolute native monotonic deadline bounds entire BiDi command") { time.Instant.now() + time.Duration.from_millis(timeout_ms as U64) }
    state.conn.set_timeout(jet_browser_remaining_ms(deadline)?).map_err(jet_browser_ws_error)?
    id :: state.next_id
    state.next_id += 1
    request :: jet_browser_object([("id", DataTree.Int(Int{id})), ("method", jet_browser_text(method)), ("params", ^params)])
    text :: render_json(&request, false, 0)
    method_hash :: jet_browser_fact_hash(method)
    jet_browser_trace_push(&state, "send:{id}:{method_hash}")
    jet_ws_send_text(&state.conn, &text).map_err(jet_browser_ws_error)?
    loop {
        response :: jet_browser_recv_json(&state, deadline)?
        if jet_browser_capture_event(&state, &response)? { continue }
        if jet_browser_id(&response) != Val(id) { return Err(JetBrowserError.new("protocol")) }
        response_type :: jet_browser_string(&response, "type")?
        if response_type == "error" || jet_browser_get(&response, "error").is_some() {
            jet_browser_trace_push(&state, "error:{id}:{method_hash}")
            return Err(JetBrowserError.new("protocol"))
        }
        if response_type != "success" { return Err(JetBrowserError.new("protocol")) }
        result :: jet_browser_get(&response, "result").cloned() ?? return Err(JetBrowserError.new("protocol"))
        jet_browser_trace_push(&state, "recv:{id}:{method_hash}")
        return Ok(^result)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:569
fn jet_browser_command(browser: &JetBrowser, method: &String, params: DataTree) -> DataTree JetBrowserError! {
    timeout_ms :: browser.state.borrow().timeout_ms
    jet_browser_command_with_timeout(browser, method, ^params, timeout_ms)
}
