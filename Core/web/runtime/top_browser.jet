fn jet_browser_profile(name: &String) -> JetBrowserProfile JetBrowserError! {
    version :: match name.as_str() {
        "bidi-2025.5" -> "2025.5"
        "bidi-2024.11" -> "2024.11"
        _ -> return Err(JetBrowserError.new("invalid profile"))
    }
    Ok(JetBrowserProfile{name: name.clone(), version: version.to_string()})
}
