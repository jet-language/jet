// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:732
fn jet_browser_connect_profile(endpoint: &String, profile: &JetBrowserProfile, timeout: JetBrowserTimeout) -> JetBrowser JetBrowserError! {
    conn :: jet_ws_connect(endpoint).map_err(jet_browser_ws_error)?
    conn.set_timeout(timeout.milliseconds).map_err(jet_browser_ws_error)?
    browser :: JetBrowser{state: Rc.new(RefCell.new(JetBrowserState{conn: ^conn, next_id: 1,
        closed: false, session_started: false, timeout_ms: timeout.milliseconds, profile: profile.name.clone(),
        cdp: false, trace: ["connect"], trace_bytes: "connect".len(), events: VecDeque.new(), test_actions: None}))}
    status :: jet_browser_command(&browser, "session.status", jet_browser_object([]))?
    ready :: match jet_browser_get(&status, "ready") { Val(.Bool(true)) -> true, _ -> false }
    message :: match jet_browser_get(&status, "message") { Val(.Text(_)) | Val(.TypedText(_)) -> true, _ -> false }
    if not ready || not message { return Err(JetBrowserError.new("protocol")) }
    new_session :: jet_browser_command(&browser, "session.new",
        jet_browser_object([("capabilities", jet_browser_object([("alwaysMatch", jet_browser_object([]))]))]))?
    browser.state.borrow_mut().session_started = true
    _session_id :: jet_browser_string(&new_session, "sessionId")?
    capabilities :: jet_browser_get(&new_session, "capabilities").filter(fn(value) { match value { .Object(_) -> true, _ -> false } })
        .ok_or_else(fn() { JetBrowserError.new("protocol") })?
    cdp :: jet_browser_get(capabilities, "goog:cdp").is_some_and(fn(value) { match value { .Bool(true) -> true, _ -> false } })
    browser.state.borrow_mut().cdp = cdp
    Ok(^browser)
}
