}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:32
fn jet_browser_record_action(browser: &JetBrowser, entry: String) -> {
    if entry.is_empty() || entry.len() > JET_BROWSER_ACTION_LIMIT_BYTES { return }
    actions :: browser.state.borrow().test_actions.clone() ?? return
    actions := actions.borrow_mut()
    if actions.len() == JET_BROWSER_ACTION_LIMIT { _ :: actions.remove(0) }
    actions.push(^entry)
}
