// CDP Domain.command shape cannot silently become a second BiDi spelling.
fn jet_browser_cdp_method_ok(method: &String) -> Bool {
    (domain, command) :: method.split_once('.') ?? return false
    if method.bytes().filter(fn(b) { *b == 46 }).count() != 1 || domain.is_empty() || command.is_empty() || method.contains(':') { return false }
    domain_chars := domain.chars()
    first :: domain_chars.next() ?? return false
    first.is_ascii_uppercase() && domain_chars.all(fn(c) { c.is_ascii_alphanumeric() }) &&
        command.chars().next().is_some_and(fn(c) { c.is_ascii_alphabetic() }) && command.chars().all(fn(c) { c.is_ascii_alphanumeric() })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:2078
fn jet_browser_protocol_send(protocol: &JetBrowserProtocol, method: &String, params_json: &String) -> String JetBrowserError! {
    params :: parse_json_strict(params_json).map_err(fn(_) { JetBrowserError.new("protocol") })?
    if params is not DataTree.Object(_) { return Err(JetBrowserError.new("protocol")) }
    result :: if protocol.kind == "bidi" {
        if method.starts_with("goog:cdp.") { return Err(JetBrowserError.new("unsupported protocol")) }
        jet_browser_command(&protocol.browser, method, ^params)?
    } else if protocol.kind == "cdp" {
        if not protocol.browser.state.borrow().cdp { return Err(JetBrowserError.new("unsupported protocol")) }
        if not jet_browser_cdp_method_ok(method) { return Err(JetBrowserError.new("protocol")) }
        jet_browser_command(&protocol.browser, "goog:cdp.sendCommand", jet_browser_object([("method", jet_browser_text(method)), ("params", ^params)]))?
    } else { return Err(JetBrowserError.new("unsupported protocol")) }
    Ok(render_json(&result, false, 0))
}
