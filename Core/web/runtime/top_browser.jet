fn jet_browser_locator_wire(locator: &JetBrowserLocator) -> DataTree JetBrowserError! {
    match locator.locator_type.as_str() {
        "accessibility" -> {
            value := []
            if not locator.role.is_empty() { value.push(("role", jet_browser_text(&locator.role))) }
            if not locator.name.is_empty() { value.push(("name", jet_browser_text(&locator.name))) }
            if value.is_empty() { return Err(JetBrowserError.new("protocol")) }
            Ok(jet_browser_object([("type", jet_browser_text("accessibility")), ("value", jet_browser_object(^value))]))
        }
        "css" | "innerText" -> Ok(jet_browser_object([("type", jet_browser_text(&locator.locator_type)), ("value", jet_browser_text(&locator.value))]))
        _ -> Err(JetBrowserError.new("protocol"))
    }
}
