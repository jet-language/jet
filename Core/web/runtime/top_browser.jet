fn jet_browser_collect_frame_ids(node: &DataTree, out: &[String]) -> Unit JetBrowserError! {
    out.push(jet_browser_string(node, "context")?)
    match jet_browser_get(node, "children") {
        None -> Ok(())
        Val(.Array(children)) -> { for child in children { jet_browser_collect_frame_ids(child, out)? }; Ok(()) }
        Val(_) -> Err(JetBrowserError.new("protocol"))
    }
}
