// GATE #4565: kernel primitive
#Unsafe("locator wait uses native absolute deadline and actual 10ms sleep, no fabricated readiness")
fn jet_browser_locator_wait(locator: &JetBrowserLocator, timeout: JetBrowserTimeout) -> Unit JetBrowserError! {
    jet_browser_record_locator_action(locator, "wait")
    deadline :: time.Instant.now() + time.Duration.from_millis(timeout.milliseconds as U64)
    loop {
        remaining :: jet_browser_remaining_ms(deadline)?
        if jet_browser_locator_query_with_timeout(locator, remaining)?.is_some() { return Ok(()) }
        std.thread.sleep(time.Duration.from_millis(10))
    }
}
