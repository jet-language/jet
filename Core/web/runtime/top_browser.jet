fn jet_browser_page_frames(page: &JetBrowserPage) -> [JetBrowserFrame] JetBrowserError! {
    if page.state.closed.get() || page.state.context.closed.get() { return Err(JetBrowserError.new("closed")) }
    result :: jet_browser_command(&page.state.browser, "browsingContext.getTree", jet_browser_object([("root", jet_browser_text(&page.state.id))]))?
    contexts :: match jet_browser_get(&result, "contexts") { Val(.Array(contexts)) -> contexts, _ -> return Err(JetBrowserError.new("protocol")) }
    ids := []
    for node in contexts { jet_browser_collect_frame_ids(node, &ids)? }
    Ok(ids.into_iter().map(fn(id) { jet_browser_frame_from_page(page, ^id) }).collect())
