// GATE #4565: kernel primitive
#Unsafe("reverify native binary metadata with original missing-binary/size error precedence")
fn jet_browser_locked_verify(locked: &JetBrowserLocked) -> Unit JetBrowserError! {
    path :: OSPath.from(&locked.binary)
    if not path.is_file() { return Err(JetBrowserError.new("missing binary")) }
    size :: fs.metadata(path).map_err(fn(_) { JetBrowserError.new("missing binary") })?.len() as I64
    if size != locked.size { return Err(JetBrowserError.new("size mismatch")) }
    Ok(())
}

