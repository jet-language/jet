#Unsafe("gone wait shares one absolute native deadline and reference polling cadence")
fn jet_browser_locator_wait_gone(locator: &JetBrowserLocator, timeout: JetBrowserTimeout) -> Unit JetBrowserError! {
    jet_browser_record_locator_action(locator, "wait-gone")
    deadline :: time.Instant.now() + time.Duration.from_millis(timeout.milliseconds as U64)
    loop {
        remaining :: jet_browser_remaining_ms(deadline)?
        if jet_browser_locator_query_with_timeout(locator, remaining)?.is_none() { return Ok(()) }
        std.thread.sleep(time.Duration.from_millis(10))
    }
