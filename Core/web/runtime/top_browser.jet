// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:242
fn jet_browser_trace_push(state: &JetBrowserState, entry: String) -> {
    if entry.len() > JET_BROWSER_TRACE_LIMIT_BYTES { return }
    loop state.trace_bytes.saturating_add(entry.len()) > JET_BROWSER_TRACE_LIMIT_BYTES {
        if state.trace.is_empty() { break }
        state.trace_bytes = state.trace_bytes.saturating_sub(state.trace.remove(0).len())
    }
    state.trace_bytes += entry.len()
    state.trace.push(^entry)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:256
fn jet_browser_fact_hash(value: &String) -> String {
    hash := U64{0xcbf2_9ce4_8422_2325}
    for byte in value.as_bytes() { hash ^= U64.from(*byte); hash = hash.wrapping_mul(0x0000_0100_0000_01b3) }
    "{hash:016x}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:265
fn jet_browser_object(entries: [(String, DataTree)]) -> DataTree {
    .Object(entries.into_iter().map(fn((key, value)) { (key.to_string(), ^value) }).collect())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:274
fn jet_browser_text(value: &String) -> DataTree { .Text(value.to_string()) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:278
fn jet_browser_get(value: &DataTree, key: &String) -> &DataTree? {
    match value {
        .Object(fields) -> fields.iter().find_map(fn((name, value)) { if name == key { Val(value) } else { None } })
        _ -> None
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:290
fn jet_browser_string(value: &DataTree, key: &String) -> String JetBrowserError! {
    match jet_browser_get(value, key) { Val(.Text(text)) | Val(.TypedText(text)) -> Ok(text.clone()), _ -> Err(JetBrowserError.new("protocol")) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:302
fn jet_browser_id(value: &DataTree) -> I64? {
    match jet_browser_get(value, "id") {
        Val(.Int(value)) if *value >= 0 -> Val(*value as I64)
        Val(.Float(value)) if value.is_finite() && value.fract() == 0.0 && *value >= 0.0 && *value <= I64.MAX as Float -> Val(*value as I64)
        Val(.Number(value)) -> value.parse<I64>().ok().filter(fn(value) { *value >= 0 })
        _ -> None
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:318
fn jet_browser_ws_error(error: JetWsError) -> JetBrowserError {
    match error { .Timeout -> JetBrowserError.new("timeout"), .Closed -> JetBrowserError.new("closed"), _ -> JetBrowserError.new("transport") }
}
impl JetWsConn {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Browser.rs:327
    // GATE #4565: kernel primitive
    #Unsafe("borrow actual retained websocket stream for read/write native timeouts")
    fn set_timeout(self: &Self, milliseconds: I64) -> Unit JetWsError! {
        duration :: time.Duration.from_millis(U64.try_from(milliseconds).map_err(fn(_) { JetWsError.IO(operation: "set websocket timeout") })?)
        self.stream.borrow().set_read_timeout(Val(duration)).map_err(fn(_) { JetWsError.IO(operation: "set websocket read timeout") })?
        self.stream.borrow().set_write_timeout(Val(duration)).map_err(fn(_) { JetWsError.IO(operation: "set websocket write timeout") })?
        Ok(())
    }
}
