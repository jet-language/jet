fn jet_browser_next_event(browser: &JetBrowser, timeout: JetBrowserTimeout) -> JetBrowserEvent JetBrowserError! {
    state := browser.state.borrow_mut()
    if state.closed { return Err(JetBrowserError.new("closed")) }
    if state.events.pop_front() is Val(event) { return Ok(^event) }
    // GATE #4565: kernel primitive
    deadline :: #Unsafe("one absolute native deadline bounds next event receipt") { time.Instant.now() + time.Duration.from_millis(timeout.milliseconds as U64) }
    loop {
        value :: jet_browser_recv_json(&state, deadline)?
        if jet_browser_capture_event(&state, &value)? { return state.events.pop_front().ok_or_else(fn() { JetBrowserError.new("protocol") }) }
        return Err(JetBrowserError.new("protocol"))
    }
}
