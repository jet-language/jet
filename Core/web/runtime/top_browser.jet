fn jet_browser_navigation_url(url: &String) -> String {
    if url.contains("://") || url.starts_with("about:") || url.starts_with("data:") { return url.clone() }
    base :: #Unsafe("resolve test-relative URL from actual test server environment precedence") {
        env.var("JET_TEST_WEB_SERVER_URL").or_else(fn(_) { env.var("JET_BROWSER_TEST_SERVER_URL") }).unwrap_or_default()
    }
    if base.is_empty() { return url.clone() }
    "{base.trim_end_matches('/')}/{url.trim_start_matches('/')}"
}
