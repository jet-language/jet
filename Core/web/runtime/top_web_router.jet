fn jet_web_router_split_url(url: &String) -> (&String,&String) Err! {
    if url.is_empty() || url.len() > JET_WEB_ROUTER_MAX_URL || !url.starts_with('/') { return Err("navigation URL must be an absolute path beginning with `/`") }
    (path,query) := url.split_once('?').unwrap_or((url,"")) // #4303
    if path.contains('#') || query.contains('#') { return Err("URL fragments are not accepted by the server navigation contract") }
    Ok((path,query))
}
