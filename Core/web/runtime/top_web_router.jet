fn jet_web_router_decode(value: &String,plus_as_space: Bool) -> String Err! {
    normalized := if plus_as_space && value.as_bytes().contains(&b'+') { value.replace('+'," ") } else { value }
    decoded :: jet_url_percent_decode_str(normalized)?
    if decoded.chars().any(fn(character) { character.is_control() }) { return Err("URL component contains a control character") }
    Ok(^decoded)
}
