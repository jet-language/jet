// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebRouter.rs:215
fn jet_web_router_parse_json_search(query: &String) -> [String:String] Err! {
    if query.is_empty() { return Ok([:]) }
    encoded: String? := None
    for pair in query.split('&') {
        if pair.is_empty() { continue }
        (raw_key,raw_value) := pair.split_once('=').unwrap_or((pair,"")) // #4303
        key :: jet_web_router_decode(raw_key,true)?
        if key != "search" { return Err("JSON search codec accepts only the `search` query parameter, got `{key}`") }
        if encoded.replace(jet_web_router_decode(raw_value,true)?).is_some() { return Err("JSON search parameter `search` is repeated") }
    }
    if encoded.is_none() { return Ok([:]) }
    value :: parse_json_strict(&encoded.unwrap()).map_err(fn(error) { "invalid JSON search value: {error.reason}" })?
    match value {
        DataTree.Object(entries) -> {
            if entries.len() > JET_WEB_ROUTER_MAX_PARAMS { return Err("navigation has too many search parameters") }
            entries.into_iter().map(fn((key,value)) {
                if !jet_http_route_name(&key) { return Err("search parameter `{key}` has an invalid name") }
                Ok((^key,jet_web_router_json_value_text(&value)?))
            }).collect()
        },
        _ -> Err("JSON search value must be an object")
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebRouter.rs:259
fn jet_web_router_json_value_text(value: &DataTree) -> String Err! {
    match value {
        DataTree.Text(text) | DataTree.TypedText(text) -> Ok(text.clone()),
        DataTree.Bool(value) -> Ok(value.to_string()),
        DataTree.Int(value) -> Ok(value.to_string()),
        DataTree.Float(value) if value.is_finite() -> Ok(value.to_string()),
        DataTree.Float(_) -> Err("JSON search number must be finite"),
        DataTree.Number(value) -> Ok(value.clone()),
        DataTree.Null | DataTree.Array(_) | DataTree.Object(_) | DataTree.Bytes(_) -> Ok(render_json(value,false,0))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebRouter.rs:275
fn jet_web_router_parse_query(query: &String) -> [String:String] Err! {
    values: [String:String] := [:]
    if query.is_empty() { return Ok(^values) }
    for pair in query.split('&') {
        if pair.is_empty() { continue }
        (raw_key,raw_value) := pair.split_once('=').unwrap_or((pair,"")) // #4303
        key :: jet_web_router_decode(raw_key,true)?
        if !jet_http_route_name(&key) { return Err("search parameter `{key}` has an invalid name") }
        if values.contains_key(&key) { return Err("search parameter `{key}` is repeated") }
        value :: jet_web_router_decode(raw_value,true)?
        values.insert(^key,^value)
        if values.len() > JET_WEB_ROUTER_MAX_PARAMS { return Err("navigation has too many search parameters") }
    }
    Ok(^values)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebRouter.rs:301
fn jet_web_router_parse_value(field: &JetWebRouterField,raw: (&String)?) -> String? Err! {
    raw :: raw.or(field.default.as_ref())
    if raw.is_none() {
        if field.required { return Err("missing required parameter `{field.name}`") }
        return Ok(None)
    }
    raw :: raw.unwrap()
    normalized :: match field.value_type {
        WebRouterValueType.String -> raw.clone(),
        WebRouterValueType.Int -> raw.parse::<I64>().map(fn(value) { value.to_string() }).map_err(fn(_) { "parameter `{field.name}` expects Int, got `{raw}`" })?,
        WebRouterValueType.Bool -> match raw.as_str() { "true" | "1" -> "true", "false" | "0" -> "false", _ -> { return Err("parameter `{field.name}` expects Bool, got `{raw}`") } },
        WebRouterValueType.Float -> {
            value :: raw.parse::<Float>().map_err(fn(_) { "parameter `{field.name}` expects Float, got {raw}" })?
            if !value.is_finite() { return Err("parameter `{field.name}` expects a finite Float") }
            value.to_string()
        },
        WebRouterValueType.JSON -> {
            _ :: parse_json_strict(raw).map_err(fn(error) { "parameter `{field.name}` expects JSON: {error.reason}" })?
            raw.clone()
        }
    }
    Ok(Some(^normalized))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebRouter.rs:344
fn jet_web_router_json_value_for_field(field: &JetWebRouterField,raw: &String) -> DataTree Err! {
    match field.value_type {
        WebRouterValueType.String -> Ok(DataTree.Text(raw.to_string())),
        WebRouterValueType.Int -> raw.parse::<I64>().map(DataTree.Int).map_err(fn(_) { "parameter `{field.name}` expects Int, got {raw}" }),
        WebRouterValueType.Bool -> match raw { "true" -> Ok(DataTree.Bool(true)), "false" -> Ok(DataTree.Bool(false)), _ -> Err("parameter `{field.name}` expects Bool, got {raw}") },
        WebRouterValueType.Float -> raw.parse::<Float>().ok().filter(fn(value) { value.is_finite() }).map(DataTree.Float).ok_or_else(fn() { "parameter `{field.name}` expects Float, got {raw}" }),
        WebRouterValueType.JSON -> parse_json_strict(raw).map_err(fn(error) { "parameter `{field.name}` expects JSON: {error.reason}" })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebRouter.rs:370
fn jet_web_router_typed_values(fields: &[JetWebRouterField],values: &[String:String]) -> [String:String] Err! {
    typed: [String:String] := [:]
    for field in fields {
        value :: jet_web_router_parse_value(field,values.get(&field.name))?
        if Some(value) :: value { typed.insert(field.name.clone(),^value) }
    }
    Ok(^typed)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebRouter.rs:384
fn jet_web_router_validate_search(fields: &[JetWebRouterField],values: &[String:String]) -> () Err! {
    keys :: values.keys().cloned().collect::<[String]>().sorted()
    for key in &keys {
        if !fields.iter().any(fn(field) { field.name == *key }) { return Err("search parameter `{key}` is not declared for this route") }
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebRouter.rs:396
// Navigation status is canonically core.web.router.WebNavigationStatus.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebRouter.rs:407
fn jet_web_router_validate_fields(pattern: &JetHTTPRoutePattern,params: &[JetWebRouterField],search: &[JetWebRouterField]) -> () Err! {
    path_names: [String:Bool] := [:]
    for segment in &pattern.segments {
        match segment { JetHTTPRouteSegment.Param(name) | JetHTTPRouteSegment.CatchAll(name) -> { path_names.insert(name.clone(),true) }, JetHTTPRouteSegment.Static(_) -> {} }
    }
    declared: [String:Bool] := [:]
    for field in params {
        if !jet_http_route_name(&field.name) { return Err("route parameter `{field.name}` has an invalid name") }
        if !path_names.contains_key(&field.name) { return Err("route parameter `{field.name}` is not present in the route pattern") }
        if field.required && field.default.is_some() { return Err("required route parameter `{field.name}` cannot have a default") }
        if Some(default) :: field.default.as_ref() { _ :: jet_web_router_parse_value(field,Some(default))? }
        if declared.insert(field.name.clone(),true).is_some() { return Err("route parameter `{field.name}` is declared more than once") }
    }
    names :: path_names.keys().cloned().collect::<[String]>().sorted()
    for name in &names {
        if !declared.contains_key(name) { return Err("route pattern parameter `{name}` has no typed declaration") }
    }
    for field in search {
        if !jet_http_route_name(&field.name) { return Err("search parameter `{field.name}` has an invalid name") }
        if field.required && field.default.is_some() { return Err("required search parameter `{field.name}` cannot have a default") }
        if Some(default) :: field.default.as_ref() { _ :: jet_web_router_parse_value(field,Some(default))? }
        if declared.insert(field.name.clone(),true).is_some() { return Err("parameter `{field.name}` is declared more than once") }
    }
    Ok(())
}
