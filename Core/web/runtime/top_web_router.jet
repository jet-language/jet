                match segment {
                    .Static(value) -> path.push_str(&jet_http_route_encode_segment(value.clone(), false))
                    .Param(name) -> path.push_str(&jet_http_route_encode_segment(typed_params.get(name).ok_or_else(fn() { "missing `{name}`" })?.clone(), false))
                    .CatchAll(name) -> path.push_str(&jet_http_route_encode_segment(typed_params.get(name).ok_or_else(fn() { "missing `{name}`" })?.clone(), true))
