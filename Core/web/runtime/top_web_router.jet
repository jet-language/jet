// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebRouter.rs:32
fn jet_web_router_cache_key(route: &JetWebRoute,navigation: &JetWebNavigation) -> String {
    key := route.identity.clone()
    key.push_str("|p")
    param_names :: navigation.params.keys().cloned().collect::<[String]>().sorted()
    for name in &param_names {
        value :: &navigation.params[name]
        key.push('|'); key.push_str(&name.len().to_string()); key.push(':'); key.push_str(name)
        key.push('='); key.push_str(&value.len().to_string()); key.push(':'); key.push_str(value)
    }
    key.push_str("|s")
    search_names :: navigation.search.keys().cloned().collect::<[String]>().sorted()
    for name in &search_names {
        value :: &navigation.search[name]
        key.push('|'); key.push_str(&name.len().to_string()); key.push(':'); key.push_str(name)
        key.push('='); key.push_str(&value.len().to_string()); key.push(':'); key.push_str(value)
    }
    ^key
}
