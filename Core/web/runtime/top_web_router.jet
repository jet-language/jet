                        fields: [String:&JetWebRouterField] := [:]
                        loop field in &route.search -> fields.insert(field.name.clone(), field)
                        entries: [(String, DataTree)] := []
                        loop key in keys {
                            field :: fields.get(&key).ok_or_else(fn() { "search parameter `{key}` is not declared" })?
                            entries.push((key.clone(), jet_web_router_json_value_for_field(field, &typed_search[&key])?))
                        }
                        encoded :: render_json(&DataTree.Object(entries), false, 0)
                        path.push_str("search=")
