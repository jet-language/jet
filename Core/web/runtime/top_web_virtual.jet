    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:173
    pub fn set_window(self: &Self, window: WebVirtualWindow) -> () { self.window.set(^window) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:177
    pub fn scroll_to(self: &Self, scroll_offset: Int) -> () {
        current :: self.window()
        self.set_window(jet_web_virtual_window(current.total_count, scroll_offset, current.viewport_size, current.estimated_item_size, current.overscan).with_measured_count(current.measured_count))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:191
    pub fn resize(self: &Self, viewport_size: Int) -> () {
