// Canonical plan carrier: core.web.virtual.WebVirtualPlan, with sparse measurements.
impl WebVirtualPlan {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:312
    pub fn visible_count(self: &Self) -> Int { self.end.saturating_sub(self.start) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:316
    pub fn is_empty(self: &Self) -> Bool { self.start >= self.end }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:320
    pub fn contains(self: &Self, index: Int) -> Bool { index >= self.start && index < self.end }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:324
    pub fn range(self: &Self) -> (Int, Int) { (self.start, self.end) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:328
    pub fn row_size(self: &Self, index: Int) -> Int {
        self.measurements.binary_search_by_key(&index, fn(entry) { entry.0 }).ok()
            .and_then(fn(position) { self.measurements.get(position).map(fn(entry) { entry.1 }) }).unwrap_or(self.estimated_item_size)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:336
    pub fn offset_for(self: &Self, index: Int) -> Int { jet_web_virtual_plan_offset(self.total_count, self.estimated_item_size, &self.measurements, index) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:345
    pub fn indices(self: &Self) -> [Int] { jet_web_virtual_plan_indices(self) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:352
    pub fn measurement_exchange(self: &Self, updates: &[(Int, Int)]) -> Self {
        measurements := self.measurements.clone()
        loop (index, size) in updates.iter().take(JET_WEB_VIRTUAL_MAX_MEASUREMENTS) {
            jet_web_virtual_upsert_measurement(&measurements, self.total_count, index, size)
        }
        estimate :: jet_web_virtual_plan_estimate(self.estimated_item_size, &measurements)
        jet_web_virtual_plan_reflow(self.total_count, self.scroll_offset, self.viewport_width, self.viewport_height, estimate, self.overscan, ^measurements, Val((self.anchor_index, self.anchor_offset)))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:376
    pub fn with_measurement(self: &Self, index: Int, size: Int) -> Self { self.measurement_exchange(&[(index, size)]) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:380
    pub fn with_measurements(self: &Self, measurements: &[(Int, Int)]) -> Self { self.measurement_exchange(measurements) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:384
    pub fn within_frame_budget(self: &Self, max_visible_items: Int) -> Bool { self.visible_count() <= max_visible_items.max(0) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:388
    pub fn facts_json(self: &Self) -> String {
        measurements :: self.measurements.iter().map(fn(entry) { "{{\"index\":{entry.0},\"size\":{entry.1}}}" }).collect<[String]>().join(",")
        "{{\"total_count\":{self.total_count},\"scroll_offset\":{self.scroll_offset},\"viewport_width\":{self.viewport_width},\"viewport_height\":{self.viewport_height},\"estimated_item_size\":{self.estimated_item_size},\"overscan\":{self.overscan},\"start\":{self.start},\"end\":{self.end},\"total_size\":{self.total_size},\"measured_count\":{self.measured_count},\"anchor_index\":{self.anchor_index},\"anchor_offset\":{self.anchor_offset},\"measurements\":[{measurements}]}}"
    }
}
