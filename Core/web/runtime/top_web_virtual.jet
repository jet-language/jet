// Canonical viewport carrier: core.web.virtual.WebVirtualPlanViewport; plan is a JetSignal<WebVirtualPlan>.
impl WebVirtualPlanViewport {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:420
    pub fn new(plan: WebVirtualPlan) -> Self { Self{plan: JetSignal.new(^plan)} }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:426
