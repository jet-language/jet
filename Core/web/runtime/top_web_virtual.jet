// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:218
pub fn jet_web_virtual_window_measured(total_count: Int, scroll_offset: Int, viewport_size: Int, fallback_item_size: Int, overscan: Int, measurements: &[Int]) -> WebVirtualWindow {
    measured_total := 0
    measured_count := 0
    loop size in measurements {
        if size <= 0 { continue }
        if measured_count >= JET_WEB_VIRTUAL_MAX_MEASUREMENTS as Int { break }
        measured_total = measured_total.saturating_add(size)
        measured_count = measured_count.saturating_add(1)
    }
    estimate :: if measured_count == 0 { fallback_item_size.max(1) } else { measured_total.checked_div(measured_count).unwrap_or(fallback_item_size.max(1)).max(1) }
    jet_web_virtual_window(total_count, scroll_offset, viewport_size, estimate, overscan).with_measured_count(measured_count)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:255
pub fn jet_web_virtual_slice<T: Clone>(rows: &[T], window: &WebVirtualWindow) -> [T] {
    start :: USize.try_from(window.start.max(0)).unwrap_or(USize.MAX).min(rows.len())
    end :: USize.try_from(window.end.max(window.start)).unwrap_or(USize.MAX).min(rows.len()).min(start.saturating_add(JET_WEB_VIRTUAL_MAX_VISIBLE as USize))
    if start >= end { [] } else { rows[start..<end].to_vec() }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:274
pub fn jet_web_virtual_indices(window: &WebVirtualWindow) -> [Int] {
    if window.start >= window.end { return [] }
    end :: window.end.min(window.start.saturating_add(JET_WEB_VIRTUAL_MAX_VISIBLE))
    (window.start..<end).collect<[Int]>()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:284
pub fn jet_web_virtual_viewport(window: WebVirtualWindow) -> JetWebVirtualViewport { JetWebVirtualViewport.new(^window) }
