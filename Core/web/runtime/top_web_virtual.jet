// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:481
pub fn jet_web_virtual_plan(total_count: Int, scroll_offset: Int, viewport_width: Int, viewport_height: Int, estimated_item_size: Int, overscan: Int) -> WebVirtualPlan {
    jet_web_virtual_plan_reflow(total_count, scroll_offset, viewport_width, viewport_height, estimated_item_size, overscan, [], None)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:501
pub fn jet_web_virtual_plan_measured(total_count: Int, scroll_offset: Int, viewport_width: Int, viewport_height: Int, fallback_item_size: Int, overscan: Int, measurements: &[(Int, Int)]) -> WebVirtualPlan {
    measurements := measurements.iter().copied().filter(fn(entry) { entry.0 >= 0 && entry.0 < total_count.max(0) && entry.1 > 0 }).take(JET_WEB_VIRTUAL_MAX_MEASUREMENTS).collect<[(Int, Int)]>()
    jet_web_virtual_normalize_measurements(total_count, &measurements)
    estimate :: jet_web_virtual_plan_estimate(fallback_item_size, &measurements)
    jet_web_virtual_plan_reflow(total_count, scroll_offset, viewport_width, viewport_height, estimate, overscan, ^measurements, None)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:531
pub fn jet_web_virtual_plan_from_sizes(total_count: Int, scroll_offset: Int, viewport_width: Int, viewport_height: Int, fallback_item_size: Int, overscan: Int, sizes: &[Int]) -> WebVirtualPlan {
    measurements :: sizes.iter().enumerate().filter_map(fn(entry) {
        if entry.1 > 0 { Val((Int.try_from(entry.0).unwrap_or(I64.MAX), entry.1)) } else { None }
    }).take(JET_WEB_VIRTUAL_MAX_MEASUREMENTS).collect<[(Int, Int)]>()
    jet_web_virtual_plan_measured(total_count, scroll_offset, viewport_width, viewport_height, fallback_item_size, overscan, &measurements)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:559
pub fn jet_web_virtual_plan_indices(plan: &WebVirtualPlan) -> [Int] {
    if plan.start >= plan.end { return [] }
    end :: plan.end.min(plan.start.saturating_add(JET_WEB_VIRTUAL_MAX_VISIBLE))
    (plan.start..<end).collect<[Int]>()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:569
pub fn jet_web_virtual_plan_slice<T: Clone>(rows: &[T], plan: &WebVirtualPlan) -> [T] {
    start :: USize.try_from(plan.start.max(0)).unwrap_or(USize.MAX).min(rows.len())
    end :: USize.try_from(plan.end.max(plan.start)).unwrap_or(USize.MAX).min(rows.len()).min(start.saturating_add(JET_WEB_VIRTUAL_MAX_VISIBLE as USize))
    if start >= end { [] } else { rows[start..<end].to_vec() }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:588
fn jet_web_virtual_normalize_measurements(total_count: Int, measurements: &[(Int, Int)]) -> () {
    total_count :: total_count.max(0)
    measurements.retain(fn(entry) { entry.0 >= 0 && entry.0 < total_count && entry.1 > 0 })
    measurements.sort_by_key(fn(entry) { entry.0 })
    // Stable sorting plus reverse/dedup/reverse keeps the newest duplicate.
    measurements.reverse()
    measurements.dedup_by_key(fn(entry) { entry.0 })
    measurements.reverse()
    measurements.truncate(JET_WEB_VIRTUAL_MAX_MEASUREMENTS)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:606
fn jet_web_virtual_plan_estimate(fallback_item_size: Int, measurements: &[(Int, Int)]) -> Int {
    total := 0
    count := 0
    loop (_, size) in measurements.iter().take(JET_WEB_VIRTUAL_MAX_MEASUREMENTS) {
        if size > 0 { total = total.saturating_add(size); count = count.saturating_add(1) }
    }
    if count == 0 { fallback_item_size.max(1) } else { total.checked_div(count).unwrap_or(fallback_item_size.max(1)).max(1) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:627
fn jet_web_virtual_plan_reflow(total_count: Int, scroll_offset: Int, viewport_width: Int, viewport_height: Int, estimated_item_size: Int, overscan: Int, measurements: [(Int, Int)], anchor: (Int, Int)?) -> WebVirtualPlan {
    total_count :: total_count.max(0)
    viewport_width :: viewport_width.max(0)
    viewport_height :: viewport_height.max(0)
    estimated_item_size :: estimated_item_size.max(1)
    overscan :: overscan.clamp(0, JET_WEB_VIRTUAL_MAX_VISIBLE)
    measurements := ^measurements
    jet_web_virtual_normalize_measurements(total_count, &measurements)
    total_size :: jet_web_virtual_plan_total_size(total_count, estimated_item_size, &measurements)
    max_offset :: total_size.saturating_sub(viewport_height)
    requested_offset :: match anchor {
        Val((anchor_index, anchor_offset)) -> jet_web_virtual_plan_offset(total_count, estimated_item_size, &measurements, anchor_index).saturating_add(anchor_offset.max(0))
        None -> scroll_offset
    }
    scroll_offset :: requested_offset.max(0).min(max_offset)
    (first_visible, last_visible) :: jet_web_virtual_plan_visible_range(total_count, viewport_height, scroll_offset, estimated_item_size, &measurements)
    requested_start :: first_visible.saturating_sub(overscan)
    requested_end :: last_visible.saturating_add(overscan).min(total_count)
    (start, end) :: if requested_end.saturating_sub(requested_start) > JET_WEB_VIRTUAL_MAX_VISIBLE {
        start :: first_visible.saturating_sub(JET_WEB_VIRTUAL_MAX_VISIBLE /% 2).min(total_count)
        (start, start.saturating_add(JET_WEB_VIRTUAL_MAX_VISIBLE).min(total_count))
    } else { (requested_start, requested_end) }
    anchor_index :: first_visible.min(total_count)
    anchor_offset :: scroll_offset.saturating_sub(jet_web_virtual_plan_offset(total_count, estimated_item_size, &measurements, anchor_index))
    WebVirtualPlan{total_count: total_count, scroll_offset: scroll_offset, viewport_width: viewport_width, viewport_height: viewport_height, estimated_item_size: estimated_item_size, overscan: overscan, start: start, end: end, total_size: total_size, measured_count: Int.try_from(measurements.len()).unwrap_or(I64.MAX), anchor_index: anchor_index, anchor_offset: anchor_offset, measurements: ^measurements}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:712
fn jet_web_virtual_plan_total_size(total_count: Int, estimated_item_size: Int, measurements: &[(Int, Int)]) -> Int {
    total := total_count.saturating_mul(estimated_item_size)
    loop (_, size) in measurements {
        if size >= estimated_item_size { total = total.saturating_add(size.saturating_sub(estimated_item_size)) }
        else { total = total.saturating_sub(estimated_item_size.saturating_sub(size)) }
    }
    total
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:728
fn jet_web_virtual_plan_offset(total_count: Int, estimated_item_size: Int, measurements: &[(Int, Int)], index: Int) -> Int {
    index :: index.max(0).min(total_count)
    offset := index.saturating_mul(estimated_item_size)
    loop (row, size) in measurements {
        if row >= index { break }
        if size >= estimated_item_size { offset = offset.saturating_add(size.saturating_sub(estimated_item_size)) }
        else { offset = offset.saturating_sub(estimated_item_size.saturating_sub(size)) }
    }
    offset
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:749
fn jet_web_virtual_plan_visible_range(total_count: Int, viewport_height: Int, scroll_offset: Int, estimated_item_size: Int, measurements: &[(Int, Int)]) -> (Int, Int) {
    if total_count == 0 || viewport_height == 0 { return (0, 0) }
    first_visible :: jet_web_virtual_plan_first_row(total_count, scroll_offset, estimated_item_size, measurements)
    viewport_end :: scroll_offset.saturating_add(viewport_height)
    last_visible :: jet_web_virtual_plan_first_start_at_or_after(total_count, viewport_end, estimated_item_size, measurements).max(first_visible.saturating_add(1)).min(total_count)
    (first_visible, last_visible)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:777
fn jet_web_virtual_plan_first_row(total_count: Int, offset: Int, estimated_item_size: Int, measurements: &[(Int, Int)]) -> Int {
    low := 0
    high := total_count
    loop low < high {
        middle :: low.saturating_add(high).checked_div(2).unwrap_or(low)
        end :: jet_web_virtual_plan_offset(total_count, estimated_item_size, measurements, middle.saturating_add(1))
        if end <= offset { low = middle.saturating_add(1) } else { high = middle }
    }
    low.min(total_count)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:802
fn jet_web_virtual_plan_first_start_at_or_after(total_count: Int, offset: Int, estimated_item_size: Int, measurements: &[(Int, Int)]) -> Int {
    low := 0
    high := total_count
    loop low < high {
        middle :: low.saturating_add(high).checked_div(2).unwrap_or(low)
        start :: jet_web_virtual_plan_offset(total_count, estimated_item_size, measurements, middle)
        if start < offset { low = middle.saturating_add(1) } else { high = middle }
    }
    low.min(total_count)
}
