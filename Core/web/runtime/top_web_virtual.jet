// Headless viewport virtualization; bounded sparse geometry, no per-source-row layout table.
use core.web.virtual.[WebVirtualWindow, WebVirtualPlan, WebVirtualPlanViewport]
use core.reactive.runtime.std_reactive_event_watch.JetSignal

