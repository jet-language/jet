const JET_WEB_VIRTUAL_MAX_MEASUREMENTS: USize = 4096
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:8
const JET_WEB_VIRTUAL_MAX_VISIBLE: Int = 4096
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:10
#Derive(Clone)
pub struct JetWebVirtualViewport { window: JetSignal<WebVirtualWindow> }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:14
// Canonical window carrier: core.web.virtual.WebVirtualWindow.
impl WebVirtualWindow {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:30
    pub fn visible_count(self: &Self) -> Int { self.end.saturating_sub(self.start) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:34
    pub fn is_empty(self: &Self) -> Bool { self.start >= self.end }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:38
    pub fn contains(self: &Self, index: Int) -> Bool { index >= self.start && index < self.end }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:42
    pub fn range(self: &Self) -> (Int, Int) { (self.start, self.end) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:48
    pub fn with_measurement(self: &Self, index: Int, size: Int) -> Self {
        if index < 0 || index >= self.total_count || size <= 0 { return self.clone() }
        measured_count :: self.measured_count.saturating_add(1)
        measured_total :: self.estimated_item_size.saturating_mul(self.measured_count).saturating_add(size)
        estimate :: measured_total.checked_div(measured_count).unwrap_or(self.estimated_item_size).max(1)
        jet_web_virtual_window(self.total_count, self.scroll_offset, self.viewport_size, estimate, self.overscan).with_measured_count(measured_count)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:71
    fn with_measured_count(self: Self, measured_count: Int) -> Self {
        out := ^self
        out.measured_count = measured_count.max(0)
        ^out
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:76
    pub fn within_frame_budget(self: &Self, max_visible_items: Int) -> Bool { self.visible_count() <= max_visible_items.max(0) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:80
    pub fn facts_json(self: &Self) -> String {
        "{{\"total_count\":{self.total_count},\"scroll_offset\":{self.scroll_offset},\"viewport_size\":{self.viewport_size},\"estimated_item_size\":{self.estimated_item_size},\"overscan\":{self.overscan},\"start\":{self.start},\"end\":{self.end},\"total_size\":{self.total_size},\"measured_count\":{self.measured_count}}}"
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebVirtual.rs:98
pub fn jet_web_virtual_window(total_count: Int, scroll_offset: Int, viewport_size: Int, estimated_item_size: Int, overscan: Int) -> WebVirtualWindow {
    total_count :: total_count.max(0)
    viewport_size :: viewport_size.max(0)
    estimated_item_size :: estimated_item_size.max(1)
    overscan :: overscan.clamp(0, JET_WEB_VIRTUAL_MAX_VISIBLE)
    total_size :: total_count.saturating_mul(estimated_item_size)
    max_offset :: total_size.saturating_sub(viewport_size)
    scroll_offset :: scroll_offset.max(0).min(max_offset)
    first_visible :: if total_count == 0 { 0 } else { (scroll_offset /% estimated_item_size).min(total_count) }
    visible_rows :: if viewport_size == 0 { 0 } else {
        viewport_size.saturating_add(estimated_item_size.saturating_sub(1)).checked_div(estimated_item_size).unwrap_or(0).min(JET_WEB_VIRTUAL_MAX_VISIBLE)
    }
    last_visible :: first_visible.saturating_add(visible_rows).min(total_count)
    requested_start :: first_visible.saturating_sub(overscan)
    requested_end :: last_visible.saturating_add(overscan).min(total_count)
    (start, end) :: if requested_end.saturating_sub(requested_start) > JET_WEB_VIRTUAL_MAX_VISIBLE {
        start :: first_visible.saturating_sub(JET_WEB_VIRTUAL_MAX_VISIBLE /% 2).min(total_count)
        (start, start.saturating_add(JET_WEB_VIRTUAL_MAX_VISIBLE).min(total_count))
    } else { (requested_start, requested_end) }
    WebVirtualWindow{total_count: total_count, scroll_offset: scroll_offset, viewport_size: viewport_size, estimated_item_size: estimated_item_size, overscan: overscan, start: start, end: end, total_size: total_size, measured_count: 0}
}
