fn jet_web_virtual_upsert_measurement(measurements: &[(Int, Int)], total_count: Int, index: Int, size: Int) -> () {
    if index < 0 || index >= total_count || size <= 0 { return }
    if Val(existing) :: measurements.iter_mut().find(fn(entry) { entry.0 == index }) { existing.1 = size; return }
    if measurements.len() < JET_WEB_VIRTUAL_MAX_MEASUREMENTS { measurements.push((index, size)) }
}
