// Rust:419-521. No Int/floating timestamp conversion.
#[Equatable]
pub struct JetWebHydrationTiming {
    pub trigger: JetWebHydrationTrigger
    pub started_at_ns: U64
    pub completed_at_ns: U64?
}
impl JetWebHydrationTiming {
    pub fn started(started_at_ns: U64) -> JetWebHydrationTiming Never! { JetWebHydrationTiming.started_with_trigger(.Manual, started_at_ns) }
    pub fn started_with_trigger(trigger: JetWebHydrationTrigger, started_at_ns: U64) -> JetWebHydrationTiming Never! {
        JetWebHydrationTiming{trigger: trigger, started_at_ns: started_at_ns, completed_at_ns: None}
    }
    pub fn new(started_at_ns: U64, completed_at_ns: U64?) -> JetWebHydrationTiming JetWebPendingError! { JetWebHydrationTiming.new_with_trigger(.Manual, started_at_ns, completed_at_ns) }
    pub fn new_with_trigger(trigger: JetWebHydrationTrigger, started_at_ns: U64, completed_at_ns: U64?) -> JetWebHydrationTiming JetWebPendingError! {
        timing :: JetWebHydrationTiming{trigger: trigger, started_at_ns: started_at_ns, completed_at_ns: completed_at_ns}
        timing.validate() ?? return Err(err)
        Ok(timing)
    }
    pub fn complete(&self, completed_at_ns: U64) JetWebPendingError! {
        if completed_at_ns < self.started_at_ns -> return Err(.InvalidHydrationTiming(self.started_at_ns, completed_at_ns))
        if self.completed_at_ns != None -> return Err(.InvalidLifecycle(.Ready, "hydration_complete"))
        self.completed_at_ns = Val(completed_at_ns)
        Ok()
    }
    pub fn validate(self) JetWebPendingError! {
        if self.completed_at_ns == .Val(completed) {
            if completed < self.started_at_ns -> return Err(.InvalidHydrationTiming(self.started_at_ns, completed))
        }
        Ok()
    }
    pub fn is_complete(self) -> Bool Never! { self.completed_at_ns != None }
    pub fn duration_ns(self) -> U64? Never! {
        if self.completed_at_ns == .Val(completed) -> return Val(completed - self.started_at_ns)
        None
    }
    pub fn render_json(self) -> String Never! {
        "{{\"started_at_ns\":{self.started_at_ns},\"completed_at_ns\":{optional_u64_json(self.completed_at_ns)},\"duration_ns\":{optional_u64_json(self.duration_ns())},\"trigger\":{jet_web_pending_json_string(self.trigger.as_str())}}}"
    }
}
