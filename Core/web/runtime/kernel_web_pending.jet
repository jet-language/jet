// WebPending.rs:1-2145 — backend-neutral typed streaming/hydration kernel.
// Private generated-App owner: core.web.runtime.kernel_web_pending, not core.web.
// Publication: module runtime in web.jet; module kernel_web_pending in runtime.
// #4500: retaining Queue/map element loans and borrowed String byte ingress.
// #4494: the process-global LazyLock<Mutex<registry>> and poison recovery have
// no published native ABI. The registry below is the SAME guarded data model;
// methods port the bodies inside the original lock, NOT a host/global provider.
// No lock/global function is fabricated. Native integration must acquire that
// single process-static guard, recover the poisoned guard, call these methods,
// and release on EVERY success/error rail (Rust:1808-1814,1865-2081).
use core.text.runtime.kernel_unicode_string as text

// Rust:11-16. Fixed policy capacities, independent of selected pointer width.
pub JET_WEB_PENDING_MAX_CHUNKS :: 64
pub JET_WEB_PENDING_MAX_BUFFER_BYTES :: 1048576
pub JET_WEB_PENDING_MAX_FACTS :: 256
pub JET_WEB_PENDING_MAX_IDENTITY_BYTES :: 1024
pub JET_WEB_PENDING_MAX_BOUNDARY_BYTES :: 256
pub JET_WEB_STREAM_REGISTRY_MAX :: 256

#[Equatable, Comparable]
pub enum JetWebPendingState { Pending; Ready; Failed }
impl JetWebPendingState {
    pub fn default() -> JetWebPendingState Never! { .Pending }
    pub fn as_str(self) -> String Never! { if self == { .Pending -> "pending"; .Ready -> "ready"; .Failed -> "failed" } }
    pub fn is_pending(self) -> Bool Never! { self == .Pending }
    pub fn is_ready(self) -> Bool Never! { self == .Ready }
    pub fn is_failed(self) -> Bool Never! { self == .Failed }
}
