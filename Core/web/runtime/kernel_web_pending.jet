    Begin
    Chunk
    Commit
    Fail
    Cancel
    Rollback
    HydrationStart
    HydrationComplete
    Reject
}
impl JetWebPendingTransactionKind {
    pub fn as_str(self) -> String Never! {
        if self == {
            .Begin -> "begin"
            .Chunk -> "chunk"
            .Commit -> "commit"
            .Fail -> "fail"
            .Cancel -> "cancel"
            .Rollback -> "rollback"
            .HydrationStart -> "hydration_start"
            .HydrationComplete -> "hydration_complete"
            .Reject -> "reject"
        }
    }
}
// Rust:110-236,615-623. Error payloads, precedence, codes and Display preserved.
#Error
#[Equatable]
pub enum JetWebPendingError {
    InvalidIdentity(field: String)
    InvalidBoundary(field: String)
    InvalidLimit(field: String, actual: Int, maximum: Int)
    IdentityMismatch(expected: JetWebIslandIdentity, actual: JetWebIslandIdentity)
    InvalidChunkSequence(expected: U64, actual: U64)
    Backpressure(dimension: JetWebPendingBackpressureDimension, limit: Int, buffered: Int, incoming: Int)
    ContentTooLarge(limit: Int, actual: Int)
    InvalidLifecycle(state: JetWebPendingState, operation: String)
    MissingFinalChunk
    InvalidHydrationTiming(started_at_ns: U64, completed_at_ns: U64)
    HydrationIdentityMismatch(expected: JetWebIslandIdentity, actual: JetWebIslandIdentity)
    NonMonotonicTimestamp(previous: U64, actual: U64)
    SequenceExhausted(kind: String)
    StreamIdentityMismatch(expected: JetWebStreamId, actual: JetWebStreamId)
}
impl JetWebPendingError {
    pub fn code(self) -> String Never! {
        if self == {
            .InvalidIdentity(_) -> "invalid_identity"
            .InvalidBoundary(_) -> "invalid_boundary"
            .InvalidLimit(_, _, _) -> "invalid_limit"
            .IdentityMismatch(_, _) -> "identity_mismatch"
            .InvalidChunkSequence(_, _) -> "invalid_chunk_sequence"
            .Backpressure(_, _, _, _) -> "backpressure"
            .ContentTooLarge(_, _) -> "content_too_large"
            .InvalidLifecycle(_, _) -> "invalid_lifecycle"
            .MissingFinalChunk -> "missing_final_chunk"
            .InvalidHydrationTiming(_, _) -> "invalid_hydration_timing"
            .HydrationIdentityMismatch(_, _) -> "hydration_identity_mismatch"
            .NonMonotonicTimestamp(_, _) -> "non_monotonic_timestamp"
            .SequenceExhausted(_) -> "sequence_exhausted"
            .StreamIdentityMismatch(_, _) -> "stream_identity_mismatch"
        }
    }
    pub fn message(self) -> String Never! {
        if self == {
            .InvalidIdentity(field) -> "web pending {field} identity is empty, oversized, or contains control text"
            .InvalidBoundary(field) -> "web pending boundary {field} is empty, oversized, or contains control text"
            .InvalidLimit(field, actual, maximum) -> "web pending {field} limit {actual} is outside 1..={maximum}"
            .IdentityMismatch(expected, actual) -> "web pending identity mismatch: expected {expected.compact()}, got {actual.compact()}"
            .InvalidChunkSequence(expected, actual) -> "web pending chunk sequence is out of order: expected {expected}, got {actual}"
            .Backpressure(dimension, limit, buffered, incoming) -> "web pending {dimension.as_str()} backpressure: limit {limit}, buffered {buffered}, incoming {incoming}"
            .ContentTooLarge(limit, actual) -> "web pending content is {actual} bytes; maximum is {limit}"
            .InvalidLifecycle(state, operation) -> "web pending cannot perform {operation} while state is {state.as_str()}"
            .MissingFinalChunk -> "web pending cannot commit before the final chunk"
            .InvalidHydrationTiming(started_at_ns, completed_at_ns) -> "web hydration completed at {completed_at_ns} before it started at {started_at_ns}"
            .HydrationIdentityMismatch(expected, actual) -> "web hydration identity mismatch: expected {expected.compact()}, got {actual.compact()}"
            .NonMonotonicTimestamp(previous, actual) -> "web pending timestamp moved backward from {previous} to {actual}"
            .SequenceExhausted(kind) -> "web pending {kind} sequence is exhausted"
            .StreamIdentityMismatch(expected, actual) -> "web stream identity mismatch: expected {expected.compact()}, got {actual.compact()}"
        }
    }
    pub fn show(self) -> String Never! { self.message() }
    pub fn render_json(self) -> String Never! {
        "{{\"code\":{jet_web_pending_json_string(self.code())},\"message\":{jet_web_pending_json_string(self.message())}}}"
    }
}
