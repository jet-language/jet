        Ok(^receipt)
    }
    // Rust:1958-1976. Errors do not evict; success does, including old content.
    fn fail(&self, stream_id: JetWebStreamId, error: ^JetWebPendingError, at_ns: U64) -> JetWebPendingReceipt JetWebPendingError! {
        self.require_entry(stream_id.boundary_id()) ?? return Err(err)
        key :: stream_id.boundary_id().as_str()
        self.entries[key].validate_id(stream_id, false, "fail") ?? return Err(err)
        receipt :: &self.entries[key].boundary.fail_for(stream_id.identity(), ^error, at_ns) ?? return Err(err)
        self.entries[key].active_stream = None
        _ :: &self.entries.remove(key)
        Ok(^receipt)
    }
    // Rust:1980-2021. Never let stale work cancel/rollback a newer generation.
    fn cancel(&self, stream_id: JetWebStreamId, at_ns: U64) -> JetWebPendingReceipt JetWebPendingError! {
        self.require_entry(stream_id.boundary_id()) ?? return Err(err)
        key :: stream_id.boundary_id().as_str()
        self.entries[key].validate_id(stream_id, false, "cancel") ?? return Err(err)
        receipt :: &self.entries[key].boundary.cancel_for(stream_id.identity(), at_ns) ?? return Err(err)
        self.entries[key].active_stream = None
        _ :: &self.entries.remove(key)
        Ok(^receipt)
    }
    fn rollback(&self, stream_id: JetWebStreamId, at_ns: U64) -> JetWebPendingReceipt JetWebPendingError! {
        self.require_entry(stream_id.boundary_id()) ?? return Err(err)
        key :: stream_id.boundary_id().as_str()
        self.entries[key].validate_id(stream_id, false, "rollback") ?? return Err(err)
        receipt :: &self.entries[key].boundary.rollback_for(stream_id.identity(), at_ns) ?? return Err(err)
        self.entries[key].active_stream = None
        _ :: &self.entries.remove(key)
        Ok(^receipt)
    }
    // Rust:2024-2059. Hydration uses COMMITTED, not active, stream identity.
    fn hydration_start(&self, stream_id: JetWebStreamId, trigger: JetWebHydrationTrigger, started_at_ns: U64) -> JetWebPendingReceipt JetWebPendingError! {
        self.require_entry(stream_id.boundary_id()) ?? return Err(err)
        key :: stream_id.boundary_id().as_str()
        self.entries[key].validate_id(stream_id, true, "hydration_start") ?? return Err(err)
        &self.entries[key].boundary.hydration_start_with_trigger(~stream_id.identity(), trigger, started_at_ns)
    }
    fn hydration_complete(&self, stream_id: JetWebStreamId, completed_at_ns: U64) -> JetWebPendingReceipt JetWebPendingError! {
        self.require_entry(stream_id.boundary_id()) ?? return Err(err)
        key :: stream_id.boundary_id().as_str()
        self.entries[key].validate_id(stream_id, true, "hydration_complete") ?? return Err(err)
        receipt :: &self.entries[key].boundary.hydration_complete(~stream_id.identity(), completed_at_ns) ?? return Err(err)
        _ :: &self.entries.remove(key)
        Ok(^receipt)
    }
    // Rust:2062-2082. Deterministic JSON; no additional host rendering layer.
    fn receipt_json(self, boundary_id: JetWebBoundaryId) -> String JetWebPendingError! {
        self.require_entry(boundary_id) ?? return Err(err)
        Ok(self.entries[boundary_id.as_str()].boundary.receipt().render_json())
    }
    fn projection_json(self, boundary_id: JetWebBoundaryId, target: JetWebPendingProjectionTarget) -> String JetWebPendingError! {
        self.require_entry(boundary_id) ?? return Err(err)
        Ok(self.entries[boundary_id.as_str()].boundary.project(target).render_json())
    }
}
// Rust:2084-2123. Rust char::is_control is exactly Unicode Cc, U+0000..001F
// and U+007F..009F; not whitespace or arbitrary category-C scalars.
fn contains_control(value: String) -> Bool Never! {
    raw :: text.utf8_bytes(value) // #4500 borrowed UTF8 producer required
    at := 0
    loop at < raw.len() {
        cp :: text.scalar_at(raw, at)
        if cp < 32 || (cp >= 127 && cp <= 159) -> return true
        at += text.utf8_width_at(raw, at)
    }
    false
}
fn jet_web_pending_validate_identity(value: String, field: String) JetWebPendingError! {
    size :: text.utf8_bytes(value).len()
    if size == 0 || size > JET_WEB_PENDING_MAX_IDENTITY_BYTES || contains_control(value) -> return Err(.InvalidIdentity(field))
    Ok()
}
fn jet_web_pending_validate_boundary(value: String, field: String) JetWebPendingError! {
    size :: text.utf8_bytes(value).len()
    if size == 0 || size > JET_WEB_PENDING_MAX_BOUNDARY_BYTES || contains_control(value) -> return Err(.InvalidBoundary(field))
    Ok()
}
fn jet_web_pending_validate_limit(actual: Int, maximum: Int, field: String) JetWebPendingError! {
    // Negative Int is outside Rust's usize domain; counts never narrow a U64.
    if actual <= 0 || actual > maximum -> return Err(.InvalidLimit(field, actual, maximum))
    Ok()
}
fn optional_u64_json(value: U64?) -> String Never! { if value == .Val(n) -> return "{n}"; "null" }
fn optional_error_json(value: JetWebPendingError?) -> String Never! { if value == .Val(error) -> return error.render_json(); "null" }
fn optional_hydration_json(value: JetWebHydrationTiming?) -> String Never! { if value == .Val(timing) -> return timing.render_json(); "null" }
// Rust:2125-2145. Exact compact byte-preserving JSON (including C1 controls,
// backspace and formfeed); a general JSON codec has different escaping law.
fn jet_web_pending_json_string(value: String) -> String Never! {
    out := [U8]{U8{34}}
    raw :: text.utf8_bytes(value)
    at := 0
    loop at < raw.len() {
        cp :: text.scalar_at(raw, at)
        width :: text.utf8_width_at(raw, at)
        if {
            cp == 34 -> { &out.push(U8{92}); &out.push(U8{34}) }
            cp == 92 -> { &out.push(U8{92}); &out.push(U8{92}) }
            cp == 10 -> { &out.push(U8{92}); &out.push(U8{110}) }
            cp == 13 -> { &out.push(U8{92}); &out.push(U8{114}) }
            cp == 9 -> { &out.push(U8{92}); &out.push(U8{116}) }
            cp == 8 -> { &out.push(U8{92}); &out.push(U8{98}) }
            cp == 12 -> { &out.push(U8{92}); &out.push(U8{102}) }
            cp < 32 || (cp >= 127 && cp <= 159) -> {
                &out.push(U8{92}); &out.push(U8{117})
                loop shift in [Int]{12, 8, 4, 0} {
                    digit :: (cp >> shift) & 15
                    &out.push(U8{if digit < 10 -> 48 + digit else -> 87 + digit})
                }
            }
            else -> loop i in at..<(at + width) -> &out.push(raw[i])
        }
        at += width
    }
    &out.push(U8{34})
    String.from_bytes(^out) ?? panic("web pending JSON produced invalid UTF-8")
}
