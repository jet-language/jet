fn verify_parent(parent_path: &OSPath, parent_final: String, parent: &File) -> () io.Error! {
    if normalize(final_path(parent)?) != parent_final {
        return Err(io.Error.new(.PermissionDenied, "devserver parent moved while it was held"))
