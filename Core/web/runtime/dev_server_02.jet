fn replace_file_in_parent(parent_path: &OSPath, parent_final: String, parent: &File,
    value: &OsStr, bytes: &[U8]) -> () io.Error! {
    // GATE #4565: kernel primitive
    #Unsafe("temporary output is retained, flushed and identity-checked across rename into the verified parent") {
        verify_parent(parent_path, parent_final, parent)?
        match open_file_in_parent(parent_path, parent_final, value, false, parent) {
            Ok(_) -> {}
            Err(error) if error.kind() == .NotFound -> {}
            Err(error) -> return Err(^error)
        }
        temporary_name :: ".jet-devserver-output-{process_id()}-{JET_DEVSERVER_STAGING_COUNTER.fetch_add(1, Ordering.Relaxed)}"
        temporary_path :: parent_path.join(temporary_name)
        temporary := open_existing(&temporary_path, GENERIC_READ | GENERIC_WRITE | DELETE, true, true, false)?
        if verify_parent(parent_path, parent_final, parent) is Err(error) {
            _ :: delete_handle(&temporary)
            return Err(^error)
        }
        temporary_id :: match check_regular(&temporary) {
            Ok(identity) -> identity
            Err(error) -> {
                _ :: delete_handle(&temporary)
                return Err(^error)
            }
        }
        result :: (fn() -> () io.Error! {
            temporary.write_all(bytes)?
            temporary.sync_all()?
            if check_regular(&temporary)? != temporary_id {
                return Err(io.Error.new(.PermissionDenied, "temporary devserver output identity changed"))
            }
            rename_into(&temporary, parent, value)?
            (published, published_id) :: open_file_in_parent(parent_path, parent_final, value, true, parent)?
            if published_id != temporary_id {
                _ :: delete_handle(&published)
                return Err(io.Error.new(.PermissionDenied, "published devserver output identity changed"))
            }
            Ok(())
        })()
        if result is Err(error) {
            _ :: delete_handle(&temporary)
            return Err(^error)
        }
        Ok(())
    }
}
