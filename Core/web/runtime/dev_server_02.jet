fn clear_publication_journal(path: &OSPath, final_path: String, directory: &File, names: &[String]) -> {
    for value in names {
        if open_file_in_parent(path, final_path, OsStr.new(value), true, directory) is Ok((file, _)) {
            _ :: delete_handle(&file)
        }
    }
    _ :: delete_handle(directory)
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:1966
fn rollback_publication(root_path: &OSPath, root_final: String, root: &File,
    journal_path: &OSPath, journal_final: String, journal: &File,
    backed_up: &[String], published: &[String]) -> {
    for value in published.iter().rev() {
        if open_file_in_parent(root_path, root_final, OsStr.new(value), true, root) is Ok((file, _)) {
            _ :: delete_handle(&file)
        }
    }
    for value in backed_up.iter().rev() {
        if open_file_in_parent(journal_path, journal_final, OsStr.new(value), true, journal) is Ok((file, _)) {
            _ :: rename_into(&file, root, OsStr.new(value))
        }
    }
}
