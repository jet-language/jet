fn open_root(path: &OSPath) -> JetDevServerOutputRoot io.Error! {
    // GATE #4565: kernel primitive
    #Unsafe("secure Windows root open rejects reparses and verifies the retained directory final path") {
        reject_reparse_components(path)?
        expected_path :: if path.is_absolute() { path.to_path_buf() } else { current_dir()?.join(path) }
        expected :: normalize(expected_path.to_string_lossy().into_owned())
        directory :: open_existing_with_share(path, GENERIC_READ | GENERIC_WRITE, false, false, true, FILE_SHARE_ALL)?
        check_directory(&directory)?
        if normalize(final_path(&directory)?) != expected {
            return Err(io.Error.new(.PermissionDenied, "devserver output root changed during secure open"))
        }
        Ok(JetDevServerOutputRoot.new(^directory))
    }
}
