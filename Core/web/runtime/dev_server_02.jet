fn is_child(parent: String, candidate: String) -> Bool {
    prefix := parent.trim_end_matches(['\\', '/']) // #4303
    candidate.strip_prefix(prefix).is_some_and(fn(tail) { tail.starts_with('\\') })
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:1830
fn parent_of(path: String) -> String? { path.rsplit_once('\\').map(fn((parent, _)) { parent }) }
