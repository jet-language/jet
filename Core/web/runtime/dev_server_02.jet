fn jet_devserver_publish_build(root: &JetDevServerOutputRoot, staging: &JetDevServerStaging, html: (&[U8])?)
    -> () io.Error! {
    if target.selected_os() != .Windows && target.selected_family() != .Unix {
        return Err(jet_devserver_secure_output_unavailable())
    }
    // GATE #4565: kernel primitive
    #Unsafe("hold publication mutex across the complete transactional file publication") {
        publication :: root.publication_lock.lock().map_err(fn(_) {
            io.Error.new(.Other, "devserver publication lock poisoned")
        })?
        if target.selected_os() == .Windows { publish_build(root, staging, html) }
        else { unix_output.publish_build(root, staging, html) }
    }
}
