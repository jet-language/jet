// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:2194
fn publish_build(root: &JetDevServerOutputRoot, staging: &JetDevServerStaging, html: (&[U8])?) -> () io.Error! {
    root_path :: OSPath.from(final_path(&root.directory)?)
    root_final :: normalize(final_path(&root.directory)?)
    staging_final :: normalize(final_path(&staging.directory)?)
    build_path :: staging.path.join("build")
    (build, build_final) :: open_dir_in_parent(&staging.path, staging_final, OsStr.new("build"), false, &staging.directory)?
    if html is Val(bytes) {
        replace_file_in_parent(&build_path, build_final, &build, OsStr.new("index.html"), bytes)?
    }
    for value in JET_DEVSERVER_OUTPUT_FILES {
        _ :: open_file_in_parent(&build_path, build_final, OsStr.new(value), false, &build)?
        match open_file_in_parent(&root_path, root_final, OsStr.new(value), false, &root.directory) {
            Ok(_) -> {}
            Err(error) if error.kind() == .NotFound -> {}
            Err(error) -> return Err(^error)
        }
    }
    (journal_path, journal_name, journal, journal_final) :: create_publication_journal(&root_path, root_final, &root.directory)?
    backed_up := [String]{}
    published := [String]{}
    result :: (fn() -> () io.Error! {
        for value in JET_DEVSERVER_OUTPUT_FILES {
            match open_file_in_parent(&root_path, root_final, OsStr.new(value), true, &root.directory) {
                Ok((old, _)) -> {
                    rename_into(&old, &journal, OsStr.new(value))?
                    backed_up.push(value)
                }
                Err(error) if error.kind() == .NotFound -> {}
                Err(error) -> return Err(^error)
            }
        }
        for value in JET_DEVSERVER_OUTPUT_FILES {
            (source, source_id) :: open_file_in_parent(&build_path, build_final, OsStr.new(value), true, &build)?
            rename_into(&source, &root.directory, OsStr.new(value))?
            published.push(value)
            (_, published_id) :: open_file_in_parent(&root_path, root_final, OsStr.new(value), true, &root.directory)?
            if published_id != source_id {
                return Err(io.Error.new(.PermissionDenied, "published devserver output identity changed"))
            }
        }
        flush(&root.directory)
    })()
    if result is Err(error) {
        rollback_publication(&root_path, root_final, &root.directory, &journal_path,
            journal_final, &journal, &backed_up, &published)
        clear_publication_journal(&journal_path, journal_final, &journal, &JET_DEVSERVER_OUTPUT_FILES)
        return Err(^error)
    }
    clear_publication_journal(&journal_path, journal_final, &journal, &JET_DEVSERVER_OUTPUT_FILES)
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:2314
fn cleanup(root: &JetDevServerOutputRoot, staging: &JetDevServerStaging) -> () io.Error! {
    root_path :: OSPath.from(final_path(&root.directory)?)
    root_final :: normalize(final_path(&root.directory)?)
    staging_final :: normalize(final_path(&staging.directory)?)
    if open_dir_in_parent(&staging.path, staging_final, OsStr.new("build"), true, &staging.directory) is Ok((build, build_final)) {
        for value in JET_DEVSERVER_STAGING_FILES {
            if open_file_in_parent(&staging.path.join("build"), build_final, OsStr.new(value), true, &build) is Ok((file, _)) {
                _ :: delete_handle(&file)
            }
        }
        source :: "{staging.source_stem}.rs"
        if open_file_in_parent(&staging.path.join("build"), build_final, OsStr.new(source), true, &build) is Ok((file, _)) {
            _ :: delete_handle(&file)
        }
        _ :: delete_handle(&build)
    }
    (staging_path, _) :: open_dir_in_parent(&root_path, root_final, OsStr.new(staging.name), true, &root.directory)?
    delete_handle(&staging_path)
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:2361
fn prepare_build_command(command: &Command, staging: &JetDevServerStaging) -> File? io.Error! {
    guard :: open_existing_with_share(&staging.path, GENERIC_READ, false, false, true, FILE_SHARE_ALL)?
    check_directory(&guard)?
    if !same_object(&guard, &staging.directory)? {
        return Err(io.Error.new(.PermissionDenied, "devserver staging directory changed before the build"))
    }
    command.current_dir(&staging.path)
    Ok(Val(^guard))
}
