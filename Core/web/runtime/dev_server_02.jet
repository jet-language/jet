fn delete_handle(file: &File) -> () io.Error! {
    // GATE #4565: kernel primitive
    #Unsafe("Windows disposition request deletes only the object held by this checked file handle") {
        info := FileDispositionInfo{delete_file: 1}
        if SetFileInformationByHandle(file.as_raw_handle(), FILE_DISPOSITION_INFO_CLASS,
            (&info as *FileDispositionInfo).cast(), mem.size_of<FileDispositionInfo>() as U32) == 0 {
            return Err(io.Error.last_os_error())
        }
        Ok(())
    }
}
