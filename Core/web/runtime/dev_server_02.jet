fn same_object(left: &File, right: &File) -> Bool io.Error! {
    (left_volume, left_index, _) :: file_id(left)?
    (right_volume, right_index, _) :: file_id(right)?
    Ok(left_volume == right_volume && left_index == right_index)
}
