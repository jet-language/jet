fn create_staging(root: &JetDevServerOutputRoot, path: &OSPath, source_stem: String)
    -> JetDevServerStaging io.Error! {
    // GATE #4565: kernel primitive
    #Unsafe("create staging only beneath the retained and identity-verified output authority") {
        name :: path.file_name().ok_or_else(fn() { io.Error.new(.InvalidInput, "staging has no name") })?
        root_path :: OSPath.from(final_path(&root.directory)?)
        staging_path :: root_path.join(name)
        root_final :: normalize(final_path(&root.directory)?)
        verify_parent(&root_path, root_final, &root.directory)?
        create_dir(&staging_path)?
        reject_reparse_components(&staging_path)?
        (directory, actual) :: open_dir_in_parent(&root_path, root_final, name, false, &root.directory)?
        if !is_child(root_final, actual) {
            return Err(io.Error.new(.PermissionDenied, "devserver staging escaped its output root"))
        }
        Ok(JetDevServerStaging{path: ^staging_path, name: name.to_string_lossy().into_owned(),
            source_stem: source_stem.to_string(), directory: ^directory})
    }
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:2141
fn open_relative(current: File, current_path: OSPath, relative: &OSPath) -> File io.Error! {
    current := ^current
    current_path := ^current_path
    current_final := normalize(final_path(&current)?)
    components :: relative.components().collect<[Component]>()
    if components.is_empty() -> return Err(io.Error.new(.InvalidInput, "empty relative path"))
    for component in &components[..components.len() - 1] {
        value :: match component {
            .Normal(value) -> value
            _ -> return Err(io.Error.new(.InvalidInput, "devserver path is not relative"))
        }
        (directory, actual) :: open_dir_in_parent(&current_path, current_final, value, false, &current)?
        current_path.push(value)
        current = ^directory
        current_final = ^actual
    }
    value :: match components.last().unwrap() {
        .Normal(value) -> value
        _ -> return Err(io.Error.new(.InvalidInput, "devserver path is not relative"))
    }
    (file, _) :: open_file_in_parent(&current_path, current_final, value, false, &current)?
    _ :: ^current
    Ok(^file)
}
