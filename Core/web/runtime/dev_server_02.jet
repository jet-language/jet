    reject_reparse_components(parent_path)?
    opened :: open_existing(parent_path, GENERIC_READ, false, false, true)?
    check_directory(&opened)?
    if normalize(final_path(&opened)?) != parent_final || !same_object(parent, &opened)? {
        return Err(io.Error.new(.PermissionDenied, "devserver parent identity changed"))
    }
    Ok(())
}
