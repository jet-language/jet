fn rename_into(source: &File, parent: &File, value: &OsStr) -> () io.Error! {
    // GATE #4565: kernel primitive
    #Unsafe("aligned variable-length Windows rename info owns its UTF-16 tail and targets the retained parent handle") {
        file_name :: value.encode_wide().collect<[U16]>()
        offset :: mem.offset_of<FileRenameInfo>("file_name")
        size :: offset + file_name.len() * mem.size_of<U16>()
        storage := [USize].repeat(0, size.div_ceil(mem.size_of<USize>()))
        info :: storage.as_mut_ptr().cast<FileRenameInfo>()
        (*info).replace_if_exists = 1
        (*info).root_directory = parent.as_raw_handle()
        (*info).file_name_length = (file_name.len() * 2) as U32
        ptr.copy_nonoverlapping(file_name.as_ptr(), (*info).file_name.as_mut_ptr(), file_name.len())
        if SetFileInformationByHandle(source.as_raw_handle(), FILE_RENAME_INFO_CLASS,
            storage.as_mut_ptr().cast(), size as U32) == 0 {
            return Err(io.Error.last_os_error())
        }
        Ok(())
    }
}
