fn jet_devserver_static_relative_path(path: String) -> String? {
    relative := if path == "/" { "index.html" } else { path.trim_start_matches('/') } // #4303
    bytes :: relative.as_bytes()
    windows_drive_prefix :: bytes.len() >= 2 && bytes[0].is_ascii_alphabetic() && bytes[1] == b':'
    if path.contains("..") || relative.is_empty() || relative.starts_with('/') || relative.starts_with('\\')
        || relative.contains('\\') || windows_drive_prefix
        || OSPath.new(relative).components().any(fn(component) {
            match component { .Prefix(_) | .RootDir -> true, _ -> false }
        })
        || !jet_devserver_windows_components_are_safe(OSPath.new(relative)) {
        None
    } else { Val(relative) }
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:2627
fn jet_devserver_windows_component_is_safe(name: &OsStr) -> Bool {
    text := name.to_string_lossy() // #4303
    if text.is_empty() || text.chars().last().is_some_and(fn(character) { character == ' ' || character == '.' })
        || text.chars().any(fn(character) {
            character.is_control() || match character {
                ':' | '\\' | '<' | '>' | '"' | '|' | '?' | '*' -> true
                _ -> false
            }
        }) -> return false
    stem := text.split('.').next().unwrap_or_default() // #4303
    upper :: stem.to_ascii_uppercase()
    match upper.as_str() {
        "CON" | "CONIN$" | "CONOUT$" | "PRN" | "AUX" | "NUL" | "CLOCK$"
        | "COM1" | "COM2" | "COM3" | "COM4" | "COM5" | "COM6" | "COM7" | "COM8" | "COM9"
        | "LPT1" | "LPT2" | "LPT3" | "LPT4" | "LPT5" | "LPT6" | "LPT7" | "LPT8" | "LPT9"
        | "COM¹" | "COM²" | "COM³" | "LPT¹" | "LPT²" | "LPT³" -> false
        _ -> true
    }
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:2679
fn jet_devserver_windows_components_are_safe(relative: &OSPath) -> Bool {
    relative.components().all(fn(component) {
        match component { .Normal(name) -> jet_devserver_windows_component_is_safe(name), _ -> false }
    })
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:2688
fn jet_devserver_content_type_for(path: &OSPath) -> String {
    match path.extension().and_then(fn(e) { e.to_str() }) {
        Val("html") -> "text/html; charset=utf-8"
        Val("js") -> "application/javascript; charset=utf-8"
        Val("wasm") -> "application/wasm"
        Val("json") -> "application/json; charset=utf-8"
        Val("css") -> "text/css; charset=utf-8"
        _ -> "application/octet-stream"
    }
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:2699
fn jet_devserver_live_reload_script() -> String {
    script :: """<script>
(function () {
  var jetDevVersion = null;
  setInterval(function () {
    fetch("/__jet_dev_version", { cache: "no-store" })
      .then(function (r) { return r.text(); })
      .then(function (v) {
        if (jetDevVersion === null) { jetDevVersion = v; return; }
        if (v !== jetDevVersion) { location.reload(); }
      })
      .catch(function () {});
  }, """
    script + JET_DEVSERVER_LIVE_RELOAD_POLL_MS.to_string() + """);
})();
</script>
"""
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:2720
fn jet_devserver_write_response<W: Write>(stream: &W, status: String, content_type: String, body: &[U8]) -> () io.Error! {
    jet_devserver_write_response_parts(stream, status, content_type, &[body])
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:2729
fn jet_devserver_write_response_parts<W: Write>(stream: &W, status: String, content_type: String, parts: &[&[U8]])
    -> () io.Error! {
    body_len :: parts.iter().try_fold(USize{0}, fn(total, part) {
        total.checked_add(part.len()).ok_or_else(fn() { io.Error.new(.InvalidData, "devserver response length overflow") })
    })?
    if body_len > JET_DEVSERVER_MAX_RESPONSE_BYTES {
        return Err(io.Error.new(.InvalidData, "devserver response exceeds the response budget"))
    }
    header :: "HTTP/1.1 {status}\r\nContent-Type: {content_type}\r\nContent-Length: {body_len}\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n"
    stream.write_all(header.as_bytes())?
    for part in parts { stream.write_all(part)? }
    stream.flush()
}
