pub fn jet_devserver_html(server: &JetDevServer, path: String) -> JetDevServer { server.html(^path) }
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:2767
pub fn jet_devserver_port(server: &JetDevServer, port: I64) -> JetDevServer { server.port(port) }
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:2771
pub fn jet_devserver_serve(server: &JetDevServer) -> { server.serve() }
