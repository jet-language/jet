fn jet_openapi_canonicalize_route(route: &JetOpenApiRouteFact) -> () {
    route.parameters.sort_by(fn(left, right) { left.location.cmp(&right.location).then_with(fn() { left.name.cmp(&right.name) }) })
    route.responses.sort_by(fn(left, right) { left.status.cmp(&right.status).then_with(fn() { left.description.cmp(&right.description) }) })
    for requirement in &route.security { requirement.scopes.sort() }
    route.security.sort_by(fn(left, right) { left.scheme.cmp(&right.scheme).then_with(fn() { left.scopes.cmp(&right.scopes) }) })
    for parameter in &route.parameters { jet_openapi_canonicalize_schema(&parameter.schema) }
    if Val(body) :: &route.request_body { jet_openapi_canonicalize_schema(&body.schema) }
    for response in &route.responses { if Val(schema) :: &response.schema { jet_openapi_canonicalize_schema(schema) } }
}
