// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/OpenAPI.rs:1552
pub fn jet_web_openapi_from_contracts(routes: &[(String, String, String)]) -> String Err! {
    inputs := [JetOpenApiRouteInput].with_capacity(routes.len())
    for (method, pattern, contract_json) in routes {
        if contract_json.is_empty() { return Err("E2805: route `{method} {pattern}` has no checked OpenAPI contract") }
        input :: jet_openapi_contract_input(contract_json)?
        if !input.method.as_str().eq_ignore_ascii_case(method) { return Err("E2805: checked OpenAPI method `{input.method.as_str()}` does not match route method `{method}`") }
        route_pattern :: jet_http_route_pattern(pattern)?
        if input.pattern != route_pattern { return Err("E2805: checked OpenAPI pattern does not match route pattern `{pattern}`") }
        inputs.push(^input)
