fn jet_openapi_contract_input(contract: &String) -> JetOpenApiRouteInput Err! {
    value :: parse_json_strict(contract).map_err(fn(error) { "invalid checked OpenAPI route contract: {error.reason}" })?
    object :: jet_openapi_contract_object(&value)?
    method :: JetOpenApiHttpMethod.parse(&jet_openapi_contract_text(object, "method")?)?
    pattern_text :: jet_openapi_contract_text(object, "pattern")?
    pattern :: jet_http_route_pattern(&pattern_text)?
    expected_path :: jet_http_route_openapi_path(&pattern)
    path :: jet_openapi_contract_text(object, "path")?
    if path != expected_path { return Err("checked OpenAPI route path does not match its route pattern") }
    parameters :: jet_openapi_contract_array(object, "parameters")?.iter().map(jet_openapi_contract_parameter).collect::<[JetOpenApiParameter] Err!>()?
    responses :: jet_openapi_contract_array(object, "responses")?.iter().map(jet_openapi_contract_response).collect::<[JetOpenApiResponse] Err!>()?
    if responses.is_empty() { return Err("checked OpenAPI route contract has no responses") }
    security :: jet_openapi_contract_array(object, "security")?.iter().map(jet_openapi_contract_security).collect::<[JetOpenApiSecurityRequirement] Err!>()?
    input := JetOpenApiRouteInput.new(method, ^pattern, jet_openapi_contract_text(object, "operation_id")?, ^parameters, jet_openapi_contract_request_body(jet_openapi_contract_field(object, "request_body")?)?, ^responses, ^security, jet_openapi_contract_text(object, "provenance")?)
    input.summary = jet_openapi_contract_optional_text(object, "summary")?
    Ok(^input)
}
