// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/OpenAPI.rs:1209
fn jet_openapi_json_string(value: &String) -> String {
    out := String.with_capacity(value.len() + 2)
    out.push('"')
    for character in value.chars() {
        match character {
            '"' -> out.push_str("\\\"")
            '\\' -> out.push_str("\\\\")
            '\n' -> out.push_str("\\n")
            '\r' -> out.push_str("\\r")
            '\t' -> out.push_str("\\t")
            character if character.is_control() -> out.push_str("\\u{character as U32:04x}")
            character -> out.push(character)
        }
    }
    out.push('"')
    ^out
}
