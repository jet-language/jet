// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/OpenAPI.rs:1588
fn jet_openapi_router_inputs(router: &JetHTTPRouter) -> [JetOpenApiRouteInput] Err! {
    inputs := [JetOpenApiRouteInput].with_capacity(router.routes.len())
    for route in &router.routes {
        if route.contract_json.is_empty() { return Err("E2805: route `{route.method} {route.template}` has no checked OpenAPI contract") }
        input :: jet_openapi_contract_input(&route.contract_json)?
        if !input.method.as_str().eq_ignore_ascii_case(&route.method) { return Err("E2805: checked OpenAPI method `{input.method.as_str()}` does not match route method `{route.method}`") }
        route_pattern :: jet_http_route_pattern(&route.template)?
        if input.pattern != route_pattern { return Err("E2805: checked OpenAPI pattern does not match route pattern `{route.template}`") }
        inputs.push(^input)
    }
    Ok(^inputs)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/OpenAPI.rs:1619
// Visual WebRouter routes have no HTTP contract and are intentionally excluded.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/OpenAPI.rs:1621
pub fn jet_web_openapi(router: &JetHTTPRouter) -> String {
    inputs :: match jet_openapi_router_inputs(router) { Ok(inputs) -> ^inputs, Err(error) -> jet_runtime_stop("E2805", "", 0, &error) }
    match jet_web_openapi_from_routes(^inputs, "Jet HTTP Router", "1", []) { Ok(document) -> ^document, Err(error) -> jet_runtime_stop("E2805", "", 0, &error) }
}

