fn jet_openapi_canonicalize_schema(schema: &JetOpenApiSchema) -> () {
    match schema {
        JetOpenApiSchema.Array(item) | JetOpenApiSchema.Nullable(item) -> jet_openapi_canonicalize_schema(item)
