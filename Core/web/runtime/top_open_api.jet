fn jet_openapi_security_scheme_json(scheme: &JetOpenApiSecurityScheme) -> String {
    out := "{{\"type\":{jet_openapi_json_string(&scheme.kind)}"
    if Val(location) :: &scheme.location { out.push_str(",\"in\":{jet_openapi_json_string(location)}") }
    if Val(name) :: &scheme.parameter_name { out.push_str(",\"name\":{jet_openapi_json_string(name)}") }
    if Val(value) :: &scheme.scheme { out.push_str(",\"scheme\":{jet_openapi_json_string(value)}") }
