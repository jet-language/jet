// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:439
fn jet_browser_test_begin(config: &JetBrowserTestConfig, test: &String, engine: &String,
    attempt: I64, source: JetBrowserTestSource) -> JetBrowserTestSession JetBrowserError! {
    locked :: jet_browser_locked(engine)?
    endpoint :: jet_browser_test_endpoint(engine)?
    profile :: jet_browser_test_profile(&locked)?
    browser :: jet_browser_connect_profile(endpoint, &profile, config.timeout)?
    actions :: Rc.new(RefCell.new([]))
    jet_browser_test_attach_actions(&browser, .Val(actions.clone()))
    context :: jet_browser_context(&browser)?
    page :: if jet_browser_context_page(&context) == {
        .Ok(page) -> page
        .Err(error) -> {
            _ :: jet_browser_context_close(&context)
            _ :: jet_browser_close(&browser)
            return Err(error)
        }
    }
    // Older profiles can reject optional events; their native queue is authoritative.
    for event in ["log.entryAdded", "network.beforeRequestSent", "network.responseStarted",
        "network.fetchError", "browsingContext.consoleMessage"] {
        _ :: jet_browser_subscribe(&browser, event.to_string())
    }
    // GATE #4565: kernel primitive — monotonic clock.
    started :: #Unsafe("record the actual monotonic attempt start") { Instant.now() }
    Ok(JetBrowserTestSession { browser, context, page, actions, config: config.clone(),
        test: test.clone(), engine: engine.clone(), attempt, source, started })
}
