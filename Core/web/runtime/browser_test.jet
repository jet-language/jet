// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:45
fn jet_browser_test_config_value(root: String, key: String) -> String? {
    // GATE #4565: kernel primitive — actual filesystem read.
    contents :: #Unsafe("read browser-tests.conf from the selected project root") {
        fs.read_to_string(OSPath.from_text(root).join("browser-tests.conf")).ok()
    }?
    for raw in contents.lines() {
        line := raw.trim() // #4303
        if line.split_once('=') == .Val((name, value)) {
            if name.trim().eq_ignore_ascii_case(key) {
                text := value.trim() // #4303
                return .Val(text.to_string())
            }
        }
    }
    .None
}
impl JetBrowserTestConfig {
    // Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:60
    fn from_environment() -> JetBrowserTestConfig JetBrowserError! {
        // GATE #4565: kernel primitive — selected process environment.
        #Unsafe("read browser-test configuration from the actual process environment") {
            project_root :: jet_browser_project_root()
            browser_text :: env.var("JET_TEST_BROWSERS").ok()
                .or_else(fn() { env.var("JET_TEST_BROWSER").ok() })
                .or_else(fn() { jet_browser_test_config_value(project_root, "browsers") })
                .unwrap_or("chromium")
            engines :: jet_browser_test_engines(browser_text)?
            retries :: env.var("JET_TEST_RETRIES").ok()
                .or_else(fn() { jet_browser_test_config_value(project_root, "retries") })
                .and_then(fn(value) { value.parse<I64>().ok() }).unwrap_or(0)
            if retries < 0 || retries > JET_BROWSER_TEST_MAX_RETRIES -> return Err(JetBrowserError.new("protocol"))
            timeout_ms :: env.var("JET_TEST_TIMEOUT_MS").ok()
                .or_else(fn() { jet_browser_test_config_value(project_root, "timeout-ms") })
                .and_then(fn(value) { value.parse<I64>().ok() }).unwrap_or(JET_BROWSER_TEST_DEFAULT_TIMEOUT_MS)
            timeout :: jet_browser_timeout(timeout_ms)?
            reporter :: env.var("JET_TEST_REPORTER").ok()
                .or_else(fn() { jet_browser_test_config_value(project_root, "reporter") })
                .unwrap_or("text").to_ascii_lowercase()
            if reporter != "text" && reporter != "json" && reporter != "html" -> return Err(JetBrowserError.new("protocol"))
            artifact_dir :: env.var("JET_TEST_ARTIFACTS").ok()
                .or_else(fn() { jet_browser_test_config_value(project_root, "artifacts") })
                .unwrap_or_else(fn() { OSPath.from_text(project_root).join(".jet/browser-tests/artifacts").to_string_lossy().into_owned() })
            report_path :: env.var("JET_TEST_REPORT").ok()
                .or_else(fn() { jet_browser_test_config_value(project_root, "report") })
                .unwrap_or_else(fn() { OSPath.from_text(project_root).join(".jet/browser-tests/report.json").to_string_lossy().into_owned() })
            server_url :: env.var("JET_TEST_WEB_SERVER_URL").ok()
                .or_else(fn() { env.var("JET_BROWSER_TEST_SERVER_URL").ok() })
                .or_else(fn() { jet_browser_test_config_value(project_root, "server-url") }).unwrap_or("")
            server_command :: env.var("JET_TEST_WEB_SERVER_CMD").ok()
                .or_else(fn() { env.var("JET_BROWSER_TEST_SERVER_CMD").ok() })
                .or_else(fn() { jet_browser_test_config_value(project_root, "webServer") })
                .or_else(fn() { jet_browser_test_config_value(project_root, "web_server") })
                .map(jet_browser_test_split_command).unwrap_or([])
            server_reuse :: env.var("JET_TEST_WEB_SERVER_REUSE").ok().map(fn(value) {
                text := value.trim() // #4303
                lowered :: text.to_ascii_lowercase()
                lowered == "1" || lowered == "true" || lowered == "yes" || lowered == "on"
            }).or_else(fn() {
                jet_browser_test_config_value(project_root, "server").map(fn(value) { value.eq_ignore_ascii_case("reuse") })
            }).unwrap_or(false)
            server_cwd :: env.var("JET_TEST_WEB_SERVER_CWD").ok()
                .or_else(fn() { jet_browser_test_config_value(project_root, "server-cwd") }).unwrap_or_else(fn() { project_root.clone() })
            Ok(JetBrowserTestConfig {
                engines, retries, timeout,
                filter: env.var("JET_TEST_FILTER").ok()
                    .or_else(fn() { jet_browser_test_config_value(project_root, "filter") }).unwrap_or(""),
                reporter, server_reuse,
                ui: jet_browser_test_env_bool("JET_TEST_BROWSER_UI", false),
                visual: jet_browser_test_env_bool("JET_TEST_BROWSER_VISUAL", false),
                watch: jet_browser_test_env_bool("JET_TEST_WATCH", false),
                trace_on_retry: jet_browser_test_env_bool("JET_TEST_TRACE_ON_RETRY", true),
                trace_all: jet_browser_test_env_bool("JET_TEST_TRACE", false),
                server_url, server_command, server_cwd, artifact_dir, report_path, source_root: project_root
            })
        }
    }
}
