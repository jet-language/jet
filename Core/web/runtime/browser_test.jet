// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:532
fn jet_browser_test_drain_events(browser: &JetBrowser) -> [JetBrowserTestEventFact] {
    events: [JetBrowserTestEventFact] := []
    loop {
        event :: if jet_browser_next_event(browser, JetBrowserTimeout { milliseconds: 1 }) == {
            .Ok(event) -> event
            .Err(_) -> break
        }
        method :: jet_browser_event_kind(&event)
        kind :: if method.starts_with("log.") || method.contains("console") -> "console"
            else if method.starts_with("network.") -> "network" else -> "event"
        events.push(JetBrowserTestEventFact { kind: kind.to_string(),
            request_id_hash: jet_browser_fact_hash(jet_browser_event_request_id(&event)),
            request_method: jet_browser_event_request_method(&event),
            url_hash: jet_browser_event_url_hash(&event),
            status_code: jet_browser_event_status_code(&event),
            is_blocked: jet_browser_event_is_blocked(&event) })
        if events.len() == JET_BROWSER_EVENT_LIMIT -> break
    }
    ^events
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:562
fn jet_browser_test_safe_component(value: String, fallback: String) -> String {
    safe := String.new()
    for ch in value.chars() {
        safe.push(if ch.is_ascii_alphanumeric() || ch == '_' || ch == '-' || ch == '.' -> ch else -> '_')
    }
    if safe.is_empty() || safe == "." || safe == ".." -> fallback.to_string() else -> ^safe
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:580
fn jet_browser_test_attempt_dir(session: &JetBrowserTestSession) -> OSPath {
    OSPath.from_text(session.config.artifact_dir)
        .join(jet_browser_test_safe_component(session.test, "test"))
        .join(jet_browser_test_safe_component(session.engine, "engine"))
        .join(format("attempt-{}", session.attempt))
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:587
fn jet_browser_test_write_bytes(path: &OSPath, bytes: &[U8]) -> Unit JetBrowserError! {
    if bytes.len() > JET_BROWSER_TEST_MAX_ARTIFACT_BYTES -> return Err(JetBrowserError.new("protocol"))
    // GATE #4565: kernel primitive — real directory creation and file write.
    #Unsafe("write bounded browser artifacts to the actual selected filesystem") {
        if path.parent() == .Val(parent) {
            fs.create_dir_all(parent).map_err(fn(_) { JetBrowserError.new("transport") })?
        }
        fs.write(path, bytes).map_err(fn(_) { JetBrowserError.new("transport") })
    }
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:597
fn jet_browser_test_capture_text_snapshot(session: &JetBrowserTestSession, kind: String,
    result: String JetBrowserError!, snapshots: &[JetBrowserTestSnapshot], path: OSPath?) -> Unit {
    value :: if result == { .Ok(value) -> value; .Err(_) -> return }
    full_hash :: jet_browser_fact_hash(value)
    bytes :: value.len()
    retained :: if bytes > JET_BROWSER_TEST_MAX_SNAPSHOT_BYTES {
        String.from_utf8_lossy(value.as_bytes()[..JET_BROWSER_TEST_MAX_SNAPSHOT_BYTES]).into_owned()
    } else -> value
    artifact_path := String.new()
    if path == .Val(target) {
        if jet_browser_test_write_bytes(&target, retained.as_bytes()).is_ok() {
            artifact_path = target.to_string_lossy().into_owned()
        }
    }
    snapshots.push(JetBrowserTestSnapshot { kind: kind.to_string(), hash: full_hash,
        bytes, path: artifact_path, source: session.source.clone() })
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:629
fn jet_browser_test_capture_binary_artifact(session: &JetBrowserTestSession, name: String, mime: String,
    result: String JetBrowserError!, artifacts: &[JetBrowserTestArtifact]) -> Unit {
    encoded :: if result == { .Ok(value) -> value; .Err(_) -> return }
    bytes :: if jet_browser_test_base64_decode(encoded) == { .Ok(value) -> value; .Err(_) -> return }
    if bytes.len() > JET_BROWSER_TEST_MAX_ARTIFACT_BYTES -> return
    path :: jet_browser_test_attempt_dir(session).join(jet_browser_test_safe_component(name, "artifact"))
    if jet_browser_test_write_bytes(&path, &bytes).is_err() -> return
    artifacts.push(JetBrowserTestArtifact { name: name.to_string(), path: path.to_string_lossy().into_owned(),
        mime: mime.to_string(), bytes: bytes.len(), hash: jet_browser_fact_hash(String.from_utf8_lossy(&bytes)),
        source: session.source.clone() })
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:660
fn jet_browser_test_capture_facts(session: &JetBrowserTestSession, include_payloads: Bool)
    -> ([JetBrowserTestSnapshot], [JetBrowserTestArtifact], [JetBrowserTestEventFact]) {
    snapshots: [JetBrowserTestSnapshot] := []
    artifacts: [JetBrowserTestArtifact] := []
    dir :: jet_browser_test_attempt_dir(session)
    dom_path :: if include_payloads -> .Val(dir.join("dom.html")) else -> .None
    jet_browser_test_capture_text_snapshot(session, "url", jet_browser_page_url(&session.page), &snapshots, .None)
    jet_browser_test_capture_text_snapshot(session, "title", jet_browser_page_title(&session.page), &snapshots, .None)
    jet_browser_test_capture_text_snapshot(session, "text", jet_browser_page_text(&session.page), &snapshots, .None)
    jet_browser_test_capture_text_snapshot(session, "dom", jet_browser_page_dom(&session.page), &snapshots, dom_path)
    if include_payloads || session.config.visual {
        jet_browser_test_capture_binary_artifact(session, "screenshot.png", "image/png",
            jet_browser_page_screenshot(&session.page), &artifacts)
    }
    events :: jet_browser_test_drain_events(&session.browser)
    (^snapshots, ^artifacts, events)
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:713
fn jet_browser_test_finish(session: JetBrowserTestSession, result: Unit JetBrowserError!,
    expected_failure: Bool) -> JetBrowserTestAttempt {
    raw_passed :: result.is_ok()
    error :: result.err().map_or_else(fn() { String.new() }, fn(error) { error.jet_show() })
    passed :: if expected_failure -> !raw_passed else -> raw_passed
    retry_requested :: session.attempt > 0 && session.config.trace_on_retry
    trace_requested :: session.config.trace_all || retry_requested
    include_payloads :: !raw_passed || trace_requested || session.config.ui
    (snapshots, artifacts, events) :: jet_browser_test_capture_facts(&session, include_payloads)
    trace :: if !raw_passed || trace_requested || session.config.ui -> jet_browser_trace(&session.browser).entries else -> []
    actions :: jet_browser_test_parse_actions(&session.actions.borrow())
    // GATE #4565: kernel primitive — actual monotonic elapsed time.
    duration_ms :: #Unsafe("measure browser attempt elapsed time") { I64.try_from(session.started.elapsed().as_millis()).unwrap_or(I64.MAX) }
    _ :: jet_browser_page_close(&session.page)
    _ :: jet_browser_context_close(&session.context)
    _ :: jet_browser_close(&session.browser)
    JetBrowserTestAttempt { test: session.test, engine: session.engine, attempt: session.attempt,
        passed, expected_failure, duration_ms, source: session.source, actions, snapshots, events, artifacts, trace, error }
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:758
fn jet_browser_test_setup_failure(test: &String, engine: &String, attempt: I64, expected_failure: Bool,
    source: JetBrowserTestSource, error: JetBrowserError) -> JetBrowserTestAttempt {
    JetBrowserTestAttempt { test: test.clone(), engine: engine.clone(), attempt, passed: false, expected_failure,
        duration_ms: 0, source, actions: [], snapshots: [], events: [], artifacts: [], trace: [], error: error.jet_show() }
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:783
type JetBrowserTestBody = fn(&JetBrowserPage) -> Unit JetBrowserError!
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:785
fn jet_browser_test_run_case(config: &JetBrowserTestConfig, name: &String, source: JetBrowserTestSource,
    expected_failure: Bool, body: JetBrowserTestBody) -> JetBrowserTestCase {
    if !jet_browser_test_selected(config, name) {
        return JetBrowserTestCase { name: name.clone(), selected: false, attempts: [] }
    }
    attempts: [JetBrowserTestAttempt] := []
    for engine in &config.engines {
        for attempt in 0..=config.retries {
            attempt_result :: if jet_browser_test_begin(config, name, engine, attempt, source.clone()) == {
                .Ok(session) -> {
                    result :: body(&session.page)
                    jet_browser_test_finish(^session, result, expected_failure)
                }
                .Err(error) -> jet_browser_test_setup_failure(name, engine, attempt, expected_failure, source.clone(), error)
            }
            passed :: attempt_result.passed
            attempts.push(^attempt_result)
            if passed -> break
        }
    }
    JetBrowserTestCase { name: name.clone(), selected: true, attempts: ^attempts }
}

// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:831
pub fn jet_browser_test_report_add_case(report: JetBrowserTestReport, case: JetBrowserTestCase) -> JetBrowserTestReport {
    report.cases.push(^case)
    report.cases.sort_by(fn(left, right) { left.name.cmp(right.name) })
    ^report
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:840
pub fn jet_browser_test_report_exit_code(report: &JetBrowserTestReport) -> I64 {
    for case in &report.cases {
        if case.selected && case.attempts.last().map_or(true, fn(attempt) { !attempt.passed }) -> return 1
    }
    0
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:853
fn jet_browser_test_report_summary(report: &JetBrowserTestReport) -> String {
    passed := 0
    failed := 0
    skipped := 0
    for case in &report.cases {
        if !case.selected -> skipped += 1
        else if case.attempts.last().is_some_and(fn(attempt) { attempt.passed }) && !case.attempts.is_empty() -> passed += 1
        else -> failed += 1
    }
    format("{} passed, {} failed, {} skipped", passed, failed, skipped)
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:871
fn jet_browser_test_json_source(source: &JetBrowserTestSource) -> DataTree {
    jet_browser_object([("path", jet_browser_text(source.path)),
        ("line", DataTree.Float(F64.from(source.line))), ("column", DataTree.Float(F64.from(source.column)))])
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:879
fn jet_browser_test_json_attempt(attempt: &JetBrowserTestAttempt) -> DataTree {
    actions :: DataTree.Array(attempt.actions.iter().map(fn(action) {
        jet_browser_object([("sequence", DataTree.Float(action.sequence as F64)),
            ("kind", jet_browser_text(action.kind)), ("fact", jet_browser_text(action.fact)),
            ("source", jet_browser_test_json_source(&attempt.source))])
    }).collect())
    snapshots :: DataTree.Array(attempt.snapshots.iter().map(fn(snapshot) {
        jet_browser_object([("kind", jet_browser_text(snapshot.kind)), ("hash", jet_browser_text(snapshot.hash)),
            ("bytes", DataTree.Float(snapshot.bytes as F64)), ("path", jet_browser_text(snapshot.path)),
            ("source", jet_browser_test_json_source(&snapshot.source))])
    }).collect())
    events :: DataTree.Array(attempt.events.iter().map(fn(event) {
        jet_browser_object([("kind", jet_browser_text(event.kind)), ("requestIdHash", jet_browser_text(event.request_id_hash)),
            ("requestMethod", jet_browser_text(event.request_method)), ("urlHash", jet_browser_text(event.url_hash)),
            ("statusCode", DataTree.Float(event.status_code as F64)), ("isBlocked", DataTree.Bool(event.is_blocked))])
    }).collect())
    artifacts :: DataTree.Array(attempt.artifacts.iter().map(fn(artifact) {
        jet_browser_object([("name", jet_browser_text(artifact.name)), ("path", jet_browser_text(artifact.path)),
            ("mime", jet_browser_text(artifact.mime)), ("bytes", DataTree.Float(artifact.bytes as F64)),
            ("hash", jet_browser_text(artifact.hash)), ("source", jet_browser_test_json_source(&artifact.source))])
    }).collect())
    trace :: DataTree.Array(attempt.trace.iter().map(jet_browser_text).collect())
    jet_browser_object([("test", jet_browser_text(attempt.test)), ("engine", jet_browser_text(attempt.engine)),
        ("attempt", DataTree.Float(attempt.attempt as F64)), ("passed", DataTree.Bool(attempt.passed)),
        ("expectedFailure", DataTree.Bool(attempt.expected_failure)), ("durationMs", DataTree.Float(attempt.duration_ms as F64)),
        ("source", jet_browser_test_json_source(&attempt.source)), ("actions", actions), ("snapshots", snapshots),
        ("events", events), ("artifacts", artifacts), ("trace", trace),
        ("error", if attempt.error.is_empty() -> DataTree.Null else -> jet_browser_text(attempt.error))])
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:984
fn jet_browser_test_json(report: &JetBrowserTestReport) -> String {
    cases :: DataTree.Array(report.cases.iter().map(fn(case) {
        jet_browser_object([("name", jet_browser_text(case.name)), ("selected", DataTree.Bool(case.selected)),
            ("attempts", DataTree.Array(case.attempts.iter().map(jet_browser_test_json_attempt).collect()))])
    }).collect())
    render_json(jet_browser_object([("schema", jet_browser_text("jet.browser.test/v1")),
        ("sourceRoot", jet_browser_text(report.source_root)), ("reporter", jet_browser_text(report.reporter)),
        ("ui", DataTree.Bool(report.ui)), ("watch", DataTree.Bool(report.watch)),
        ("summary", jet_browser_text(jet_browser_test_report_summary(report))),
        ("exitCode", DataTree.Float(jet_browser_test_report_exit_code(report) as F64)), ("cases", cases)]), true, 0)
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:1025
pub fn jet_browser_test_report_json(report: &JetBrowserTestReport) -> String { jet_browser_test_json(report) }
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:1029
pub fn jet_browser_test_report_text(report: &JetBrowserTestReport) -> String { jet_browser_test_text(report) }
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:1033
pub fn jet_browser_test_report_html(report: &JetBrowserTestReport) -> String { jet_browser_test_html(report) }
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:1037
fn jet_browser_test_text(report: &JetBrowserTestReport) -> String {
    out := format("Browser tests: {}\n", jet_browser_test_report_summary(report))
    for case in &report.cases {
        if !case.selected {
            out.push_str(format("SKIP {}\n", case.name))
            continue
        }
        for attempt in &case.attempts {
            out.push_str(format("{} {} [{}] attempt={} duration={}ms\n",
                if attempt.passed -> "PASS" else -> "FAIL", attempt.test, attempt.engine, attempt.attempt, attempt.duration_ms))
            if !attempt.error.is_empty() -> out.push_str(format("  error: {}\n", attempt.error))
            for action in &attempt.actions -> out.push_str(format("  action {}: {} {}\n", action.sequence, action.kind, action.fact))
            for snapshot in &attempt.snapshots {
                out.push_str(format("  snapshot {}: {} bytes={} hash={}{}\n", snapshot.kind, snapshot.path, snapshot.bytes, snapshot.hash,
                    if snapshot.source.path.is_empty() -> "" else -> format(" source={}:{}", snapshot.source.path, snapshot.source.line)))
            }
            for event in &attempt.events {
                out.push_str(format("  {} request={} method={} url={} status={} blocked={}\n",
                    event.kind, event.request_id_hash, event.request_method, event.url_hash, event.status_code, event.is_blocked))
            }
            for artifact in &attempt.artifacts -> out.push_str(format("  attachment {}: {}\n", artifact.name, artifact.path))
            if !attempt.trace.is_empty() -> out.push_str(format("  trace: {}\n", attempt.trace.join(",")))
        }
    }
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:1095
fn jet_browser_test_html_json(value: String) -> String {
