// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:213
fn jet_browser_test_engines(raw: String) -> [String] JetBrowserError! {
    requested: [String] := []
    for part in raw.split(fn(ch) { ch == ',' || ch.is_ascii_whitespace() }) {
        text := part.trim() // #4303
        value :: text.to_ascii_lowercase()
        if value.is_empty() -> continue
        if value != "chromium" && value != "firefox" && value != "webkit" -> return Err(JetBrowserError.new("unknown engine"))
        if !requested.contains(value) -> requested.push(^value)
    }
    if requested.is_empty() || requested.len() > JET_BROWSER_TEST_MAX_ENGINES -> return Err(JetBrowserError.new("unknown engine"))
    engines: [String] := []
    for value in ["chromium", "firefox", "webkit"] {
        if requested.contains(value) -> engines.push(value.to_string())
    }
    Ok(^engines)
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:239
fn jet_browser_test_split_command(raw: String) -> [String] {
    command: [String] := []
    value := String.new()
    quote: Char? := .None
    for ch in raw.chars() {
        if quote == .Val(delimiter) {
            if ch == delimiter -> quote = .None
            else -> value.push(ch)
        } else if ch == '\'' || ch == '"' {
            quote = .Val(ch)
        } else if ch.is_ascii_whitespace() {
            if !value.is_empty() {
                command.push(^value)
                value = String.new()
            }
        } else -> value.push(ch)
    }
    if !value.is_empty() -> command.push(^value)
    ^command
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:262
pub fn jet_browser_test_selected(config: &JetBrowserTestConfig, name: &String) -> Bool {
    if config.filter.trim().is_empty() -> return true
    for pattern in config.filter.split(fn(ch) { ch == ',' || ch.is_ascii_whitespace() }) {
        if !pattern.is_empty() && jet_browser_test_glob_match(pattern, name) -> return true
    }
    false
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:273
fn jet_browser_test_glob_match(pattern_text: String, value_text: String) -> Bool {
    pattern :: pattern_text.as_bytes()
    value :: value_text.as_bytes()
    p := 0
    v := 0
    star: Int? := .None
    star_value := 0
    while v < value.len() {
        if p < pattern.len() && (pattern[p] == value[v] || pattern[p] == 63) {
            p += 1
            v += 1
        } else if p < pattern.len() && pattern[p] == 42 {
            star = .Val(p)
            p += 1
            star_value = v
        } else if star == .Val(star_position) {
            p = star_position + 1
            star_value += 1
            v = star_value
        } else -> return false
    }
    while p < pattern.len() && pattern[p] == 42 -> p += 1
    p == pattern.len()
}
