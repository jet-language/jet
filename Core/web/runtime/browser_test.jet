// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:1350
fn jet_browser_test_host_port(url: String) -> (String, U16)? {
    stripped :: url.strip_prefix("http://").or_else(fn() { url.strip_prefix("https://") })?
    authority := stripped.split('/').next()? // #4303
    if authority.is_empty() || authority.contains('@') -> return .None
    if authority.rsplit_once(':') == .Val((host, port)) {
        if host.is_empty() -> return .None
        return .Val((host.to_string(), port.parse<U16>().ok()?))
    }
    .Val((authority.to_string(), 80))
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:1367
fn jet_browser_test_base64_decode(value: String) -> [U8] JetBrowserError! {
    output := [U8].with_capacity(value.len() * 3 / 4)
    quartet: [U8] := [0, 0, 0, 0]
    count := 0
    for byte in value.bytes() {
        if byte.is_ascii_whitespace() -> continue
        if byte == 61 -> quartet[count] = 64
        else if byte >= 65 && byte <= 90 -> quartet[count] = byte - 65
        else if byte >= 97 && byte <= 122 -> quartet[count] = byte - 97 + 26
        else if byte >= 48 && byte <= 57 -> quartet[count] = byte - 48 + 52
        else if byte == 43 -> quartet[count] = 62
        else if byte == 47 -> quartet[count] = 63
        else -> return Err(JetBrowserError.new("protocol"))
        count += 1
        if count != 4 -> continue
        output.push((quartet[0] << 2) | (quartet[1] >> 4))
        if quartet[2] != 64 -> output.push((quartet[1] << 4) | (quartet[2] >> 2))
        if quartet[3] != 64 -> output.push((quartet[2] << 6) | quartet[3])
        if output.len() > JET_BROWSER_TEST_MAX_SCREENSHOT_BYTES -> return Err(JetBrowserError.new("protocol"))
        count = 0
    }
    if count != 0 -> return Err(JetBrowserError.new("protocol"))
    Ok(^output)
}

