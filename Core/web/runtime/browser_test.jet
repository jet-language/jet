// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:1144
pub fn jet_browser_test_write_report(report: &JetBrowserTestReport, path: &String) -> Unit JetBrowserError! {
    rendered :: jet_browser_test_render(report)
    target :: OSPath.from_text(path)
    jet_browser_test_write_bytes(&target, rendered.as_bytes())?
    if report.ui || report.reporter == "html" {
        viewer :: target.with_extension("html")
        jet_browser_test_write_bytes(&viewer, jet_browser_test_html(report).as_bytes())?
    }
