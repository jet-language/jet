fn jet_browser_test_env_bool(name: String, default: Bool) -> Bool {
    // GATE #4565: kernel primitive — process environment.
    value :: #Unsafe("read a browser-test boolean from the actual process environment") { env.var(name).ok() }
    if value == .Val(raw) {
        text := raw.trim() // #4303
        if text.to_ascii_lowercase() == {
            "1" | "true" | "yes" | "on" -> return true
            "0" | "false" | "no" | "off" -> return false
            _ -> return default
        }
