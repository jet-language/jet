// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:1157
pub fn jet_browser_test_watch_changed(path: &String, last_modified_ms: I64) -> Bool JetBrowserError! {
    // GATE #4565: kernel primitive — filesystem metadata and real wall-clock timestamps.
    #Unsafe("read actual browser-test source modification time") {
        metadata :: if fs.metadata(OSPath.from_text(path)) == {
            .Ok(value) -> value
            .Err(_) -> return Ok(last_modified_ms >= 0)
        }
        modified_ms :: metadata.modified().ok().and_then(fn(time) { time.duration_since(UNIX_EPOCH).ok() })
            .map(fn(duration) { I64.try_from(duration.as_millis()).unwrap_or(I64.MAX) }).unwrap_or(0)
        Ok(modified_ms > last_modified_ms)
    }
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:1175
fn jet_browser_test_escape_source(value: String) -> String {
    escaped := String.with_capacity(value.len())
    for ch in value.chars() {
        if ch == {
            '\\' -> escaped.push_str("\\\\")
            '"' -> escaped.push_str("\\\"")
            '\n' -> escaped.push_str("\\n")
            '\r' -> escaped.push_str("\\r")
            '\t' -> escaped.push_str("\\t")
            _ -> escaped.push(ch)
        }
    }
    ^escaped
}
// Rust: crates/jet-codegen/src/Prelude/BrowserTest.rs:1190
pub fn jet_browser_test_generate_source(name: &String, route: &String, output: &String) -> String JetBrowserError! {
    if name.is_empty() || !name.chars().all(fn(ch) { ch.is_ascii_alphanumeric() || ch == '_' }) || route.is_empty() {
        return Err(JetBrowserError.new("protocol"))
    }
    escaped_route :: jet_browser_test_escape_source(route)
    source :: format("use core.web.browser\n\n#Test fn {}(page: BrowserPage) {{\n  page.goto(\"{}\")\n}}\n", name, escaped_route)
    jet_browser_test_write_bytes(&OSPath.from_text(output), source.as_bytes())?
    Ok(source)
}

