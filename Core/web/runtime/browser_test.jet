fn jet_browser_test_server_capture<R: Read + Send>(reader: R, logs: Arc<Mutex<[U8]>>) -> Unit {
    // GATE #4565: kernel primitive — owned background pipe reader and shared mutex.
    #Unsafe("drain the actual child pipe on an owned thread; retain the same bounded log prefix") {
        _ :: thread.spawn(fn() {
            bytes: [U8] := []
            _ :: reader.read_to_end(&bytes)
            bytes.truncate(JET_BROWSER_TEST_MAX_SERVER_LOG_BYTES)
            if logs.lock() == .Ok(output) {
