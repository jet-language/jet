        ordered := paths.keys().collect<[String]>()
        &ordered.sort()
        Val(Self{paths: ^ordered})
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/LiveQuery.rs:71
    fn display(self: &Self) -> String { self.paths.join(",") }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/LiveQuery.rs:75
    fn intersects(self: &Self, other: &Self) -> Bool {
        self.paths.iter().any(fn(left) { other.paths.iter().any(fn(right) {
            left == right || left.strip_prefix(right).is_some_and(fn(rest) { rest.starts_with('.') })
                || right.strip_prefix(left).is_some_and(fn(rest) { rest.starts_with('.') })
        }) })
    }
}
