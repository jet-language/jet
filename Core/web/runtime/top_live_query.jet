fn jet_app_transact_invalidate(write_set: String) -> I64 {
    trimmed := write_set.trim() // #4303
    if trimmed.is_empty() -> return JET_LIVE_ERR_INVALID_INPUT
    total: I64 := 0
    loop part in write_set.split(fn(c) { c == ',' || c == ';' || c == ' ' }) {
        footprint := part.trim() // #4303
        if !footprint.is_empty() {
            hit :: jet_app_invalidate_with_cause(footprint.to_string(), "transaction:{footprint}")
            if hit < 0 -> return hit
            total = total.saturating_add(hit)
        }
    }
    total
}
