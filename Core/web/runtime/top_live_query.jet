// GATE #4565: kernel primitive
#Unsafe("read live result from canonical native registry without exposing callback error contents")
fn jet_app_live_get(query: &JetLiveQuery) -> String {
    state :: jet_live_registry().lock() ?? return "LiveError(live registry unavailable)"
    stored :: state.queries.get(&query.id) ?? return "LiveError(live query is closed)"
    if !stored.lifecycle.active -> return "LiveError(live query is closed)"
    if !stored.lifecycle.error.is_empty() -> return "LiveError(live query callback failed)"
    stored.value.clone()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/LiveQuery.rs:887
// GATE #4565: kernel primitive
#Unsafe("format canonical live query observation under native registry guard")
fn jet_app_live_show(query: &JetLiveQuery) -> String {
    state :: jet_live_registry().lock() ?? return "LiveQueryError(id={query.id}, reason=live registry unavailable)"
    stored :: state.queries.get(&query.id) ?? return "LiveQueryError(id={query.id}, reason=live query is closed)"
    source :: if jet_live_is_external(&stored.footprint) { "external" } else { "database" }
    observers :: if stored.sink.is_some() { 1 } else { 0 }
    "LiveQuery(id={query.id},key={stored.key},source={source},footprint={stored.footprint.display()},generation={stored.lifecycle.generation},active={stored.lifecycle.active},dirty={stored.lifecycle.dirty},refreshing={stored.lifecycle.refreshing},observers={observers},freshness_ms={jet_live_age_ms(stored.lifecycle.fresh_at_ms)},cause={stored.lifecycle.invalidation_cause},value_bytes={stored.value.len()},error_bytes={stored.lifecycle.error.len()})"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/LiveQuery.rs:917
// GATE #4565: kernel primitive
#Unsafe("format canonical bounded live registry counters under native guard")
fn jet_app_live_stats() -> String {
    state :: jet_live_registry().lock() ?? return "LiveStats(error=live registry unavailable)"
    active :: state.queries.values().filter(fn(query) { query.lifecycle.active }).count()
    refreshing :: state.queries.values().filter(fn(query) { query.lifecycle.active && query.lifecycle.refreshing }).count()
    "LiveStats(queries={state.queries.len()},active={active},refreshing={refreshing},limit={JET_LIVE_MAX_QUERIES},evictions={state.evictions},invalidations={state.invalidations},ws_pushes={state.ws_pushes})"
}
