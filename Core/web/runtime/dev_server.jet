            version :: Arc.clone(version)
            output_root :: Arc.clone(output_root)
            _ :: thread.spawn(fn() { jet_devserver_serve_forever(^listener, ^version, ^output_root) })
        }
        println("App preview: http://127.0.0.1:{bound_port}/")
        println("watching {app_file} … (Ctrl-C to stop)")
        _ :: io.stdout().flush()
        last_mtime := jet_devserver_mtime(app_path)
        loop {
            thread.sleep(Duration.from_millis(U64{120}))
            now :: jet_devserver_mtime(app_path)
            if now != last_mtime {
                last_mtime = now
                thread.sleep(Duration.from_millis(U64{30}))
