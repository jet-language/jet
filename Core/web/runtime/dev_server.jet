// GATE #4565: kernel primitive
#Unsafe("canonicalize selected project root and output, rejecting escape after real directory validation")
fn jet_devserver_build_dir() -> OSPath Err! {
    root :: env.var_os("JET_PROJECT_ROOT").map(OSPath.from).ok_or_else(fn() { "JET_PROJECT_ROOT is required under `jet dev`" })?
    if !root.is_absolute() -> return Err("JET_PROJECT_ROOT must be absolute")
    root :: fs.canonicalize(root).map_err(e -> e.to_string())?
    build :: root.join(".jet").join("build")
    jet_devserver_ensure_directory(build).map_err(e -> e.to_string())?
    real :: fs.canonicalize(build).map_err(e -> e.to_string())?
    if !real.starts_with(root) -> return Err("web output directory escapes the selected project root")
    Ok(^real)
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:573
// GATE #4565: kernel primitive
#Unsafe("inspect symlink metadata before recursively creating directories; preserve native error kinds")
fn jet_devserver_ensure_directory(path: OSPath) -> () Error! {
    match fs.symlink_metadata(path) {
        Ok(metadata) if metadata.file_type().is_symlink() -> Err(Error.new(ErrorKind.PermissionDenied, "directory must not be a symlink"))
        Ok(metadata) if metadata.is_dir() -> Ok(())
        Ok(_) -> Err(Error.new(ErrorKind.AlreadyExists, "path is not a directory"))
        Err(error) if error.kind() == ErrorKind.NotFound -> {
            if path.parent().filter(parent -> !parent.as_os_str().is_empty()) is Val(parent) -> jet_devserver_ensure_directory(parent)?
            fs.create_dir(path)
        }
        Err(error) -> Err(^error)
    }
}
