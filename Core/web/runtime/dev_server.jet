// GATE #4565: kernel primitive
#Unsafe("hold the publication mutex for descriptor-relative reads of a consistent bounded response")
fn jet_devserver_serve_static<W: Write>(stream: &W, path: String, output_root: JetDevServerOutputRoot) -> () Error! {
    rel :: match jet_devserver_static_relative_path(path) {
        Val(rel) -> rel
        None -> return jet_devserver_write_response(&stream, "400 Bad Request", "text/plain; charset=utf-8", "bad path".as_bytes())
    }
    file_path :: OSPath.from_text(rel)
    is_index :: file_path.file_name().and_then(f -> f.to_str()) == Val("index.html")
    content_type :: jet_devserver_content_type_for(file_path)
    script :: is_index.then(jet_devserver_live_reload_script)
    read_limit :: script.as_ref().map_or(JET_DEVSERVER_MAX_RESPONSE_BYTES, script -> JET_DEVSERVER_MAX_RESPONSE_BYTES.checked_sub(script.len()).unwrap_or(0))
    bytes :: {
        _publication :: output_root.publication_lock.lock().map_err(_ -> Error.new(ErrorKind.Other, "devserver publication lock poisoned"))?
        file :: match jet_devserver_open_held_beneath(output_root, OSPath.from_text(rel)) {
            Ok(file) -> ^file
            Err(error) if error.kind() == ErrorKind.NotFound -> {
                body :: "not found: {path}"
                return jet_devserver_write_response(&stream, "404 Not Found", "text/plain; charset=utf-8", body.as_bytes())
            }
            Err(_) -> return jet_devserver_write_response(&stream, "400 Bad Request", "text/plain; charset=utf-8", "bad path".as_bytes())
        }
        match jet_devserver_read_bounded(^file, read_limit) {
            Ok(bytes) -> ^bytes
            Err(_) -> {
                body :: "not found: {path}"
                return jet_devserver_write_response(&stream, "404 Not Found", "text/plain; charset=utf-8", body.as_bytes())
            }
        }
    }
    if script is Val(script) {
        if std.str.from_utf8(bytes).is_err() {
            body :: "not found: {path}"
            return jet_devserver_write_response(&stream, "404 Not Found", "text/plain; charset=utf-8", body.as_bytes())
        }
        if jet_devserver_find_body_end(bytes) is Val(index) {
            parts :: [bytes[..index], script.as_bytes(), bytes[index..]]
            return jet_devserver_write_response_parts(&stream, "200 OK", content_type, parts)
        }
        parts :: [bytes[..], script.as_bytes()]
        return jet_devserver_write_response_parts(&stream, "200 OK", content_type, parts)
    }
    jet_devserver_write_response(&stream, "200 OK", content_type, bytes)
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:1440
fn jet_devserver_find_body_end(bytes: [U8]) -> USize? {
    MARKER :: "</body>".as_bytes()
    bytes.windows(MARKER.len()).position(window -> window.iter().zip(MARKER).all(pair -> pair.0.to_ascii_lowercase() == pair.1))
}

