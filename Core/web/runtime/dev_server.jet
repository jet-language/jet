        read :: jet_devserver_read_line_bounded(&reader, &line, JET_DEVSERVER_MAX_LINE_BYTES)?
        if read == 0 || line == "\r\n" || line == "\n" -> break
        header_count = header_count.checked_add(1).ok_or_else(fn() { Error.new(ErrorKind.InvalidData, "too many devserver headers") })?
        header_bytes = header_bytes.checked_add(read).ok_or_else(fn() { Error.new(ErrorKind.InvalidData, "devserver headers exceed the request budget") })?
        if header_count > JET_DEVSERVER_MAX_HEADER_COUNT || header_bytes > JET_DEVSERVER_MAX_HEADER_BYTES {
            return Err(Error.new(ErrorKind.InvalidData, "devserver headers exceed the request budget"))
