    }
    content_length :: content_length.unwrap_or(USize{0})
    if content_length > JET_DEVSERVER_MAX_REQUEST_BODY_BYTES -> return Err(Error.new(ErrorKind.InvalidData, "devserver request body exceeds 1 MiB"))
    if content_length != 0 -> return Err(Error.new(ErrorKind.InvalidData, "devserver GET requests must not contain a body"))
    if method != "GET" {
        return jet_devserver_write_response(&stream, "405 Method Not Allowed", "text/plain; charset=utf-8", "jet dev's web server only handles GET".as_bytes())
    }
    path :: target.split('?').next().unwrap_or("/")
    if path == "/__jet_dev_version" {
