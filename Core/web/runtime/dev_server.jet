    parts := request_line.split_whitespace()
    method :: parts.next().unwrap_or("")
    target :: parts.next().unwrap_or("")
    request_version :: parts.next().unwrap_or("")
    if method.is_empty() || target.is_empty() || request_version != "HTTP/1.1" || parts.next().is_some() {
