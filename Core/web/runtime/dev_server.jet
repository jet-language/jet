#Unsafe("read actual source metadata and modification time without substituting a fake timestamp")
fn jet_devserver_mtime(path: OSPath) -> SystemTime? { fs.metadata(path).and_then(m -> m.modified()).ok() }
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:223
// GATE #4565: kernel primitive
#Unsafe("bind only loopback sockets; preserve address-in-use fallback and actual failure diagnostics")
fn jet_devserver_bind(port: U16?) -> TcpListener {
    if port is Val(port) {
        return match TcpListener.bind(("127.0.0.1", port)) {
            Ok(listener) -> ^listener
            Err(e) -> {
                eprintln("error: couldn't bind to port {port}: {e}")
                if e.kind() == ErrorKind.AddrInUse -> eprintln(" fix: stop whatever's using port {port}, or pick another with `.port(n)`")
                process.exit(1)
            }
        }
    }
    loop port in JET_DEVSERVER_PORT_RANGE {
        match TcpListener.bind(("127.0.0.1", port)) {
            Ok(listener) -> return ^listener
            Err(e) if e.kind() == ErrorKind.AddrInUse -> next
            Err(e) -> { eprintln("error: couldn't start the dev server: {e}"); process.exit(1) }
        }
    }
    eprintln("error: every port from 8080 to 8089 is already in use")
    eprintln(" fix: free one of those ports, or pick one explicitly with `.port(n)`")
    process.exit(1)
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:261
// GATE #4565: kernel primitive
#Unsafe("forward exact indexed environment settings into the owned build command")
fn jet_devserver_forward_build_profile_and_settings(command: &Command) -> {
    if env.var("JET_DEV_PROFILE") is Ok(profile) {
        if !profile.is_empty() -> _ :: command.arg("--profile={profile}")
    }
    if env.var_os("JET_DEV_SMALL").is_some() -> _ :: command.arg("--small")
    count :: env.var("JET_DEV_SETTING_COUNT").ok().and_then(value -> value.parse<USize>().ok()).unwrap_or(0)
    loop index in 0..<count {
        key :: env.var("JET_DEV_SETTING_{index}_KEY").ok()
        value :: env.var("JET_DEV_SETTING_{index}_VALUE").ok()
        if (key, value) is (Val(key), Val(value)) -> _ :: command.arg("--set={key}={value}")
    }
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:293
// GATE #4565: kernel primitive
#Unsafe("rebuild in fresh held staging authority, relay actual diagnostics and clean staging on every reported failure")
fn jet_devserver_rebuild(app_file: String, html_override: String?, is_rebuild: Bool, held_output_root: JetDevServerOutputRoot?) -> JetDevServerOutputRoot? {
    abs_file :: match fs.canonicalize(OSPath.from_text(app_file)) {
        Ok(p) -> ^p
        Err(e) -> { eprintln("error: couldn't resolve `{app_file}`: {e}"); return None }
    }
    if jet_devserver_validate_source(abs_file) is Err(e) {
        eprintln("error: source file is not safe to compile: {e}")
        return None
    }
    out_dir :: match jet_devserver_build_dir() {
        Ok(path) -> ^path
        Err(e) -> { eprintln("error: web output directory is not safe: {e}"); return None }
    }
    output_root :: match held_output_root {
        Val(root) -> match root.clone_directory() {
            Ok(root) -> ^root
            Err(e) -> { eprintln("error: couldn't clone the held web output directory: {e}"); return None }
        }
        None -> match jet_devserver_open_output_root(out_dir) {
            Ok(root) -> ^root
            Err(e) -> { eprintln("error: web output directory is not safe: {e}"); return None }
        }
    }
    staging_name :: ".jet-devserver-staging-{process.id()}-{JET_DEVSERVER_STAGING_COUNTER.fetch_add(U64{1}, Ordering.Relaxed)}"
    staging_root :: out_dir.join(staging_name)
    source_stem :: jet_devserver_source_stem(abs_file)
    staging :: match jet_devserver_create_staging(output_root, staging_root, source_stem) {
        Ok(staging) -> ^staging
        Err(e) -> { eprintln("error: couldn't create a staging folder for the rebuild: {e}"); return None }
    }
    jet_bin :: env.var("JET_BIN").unwrap_or_else(_ -> "jet")
    command := Command.new(jet_bin)
    _ :: command.args(["build", "--target=web"]).arg(abs_file)
    jet_devserver_forward_build_profile_and_settings(&command)
    command_guard :: match jet_devserver_prepare_build_command(&command, staging) {
        Ok(guard) -> ^guard
        Err(e) -> {
            eprintln("error: couldn't hold the build staging directory: {e}")
            _ :: jet_devserver_cleanup_staging(output_root, staging)
            return None
        }
    }
    out :: jet_devserver_command_output_bounded(&command, JET_DEVSERVER_MAX_CHILD_OUTPUT_BYTES)
    drop(^command_guard)
    out :: match out {
        Ok(o) -> ^o
        Err(e) -> {
            eprintln("error: couldn't run `{jet_bin} build --target=web`: {e}")
            eprintln(" fix: make sure `jet` is on PATH, or run this program via `jet dev` (which passes its own path in JET_BIN)")
            _ :: jet_devserver_cleanup_staging(output_root, staging)
            return None
        }
    }
    if !out.status.success() {
        if is_rebuild -> eprintln("\n— {app_file} changed —")
        _ :: io.stderr().write_all(out.stdout)
        _ :: io.stderr().write_all(out.stderr)
        _ :: jet_devserver_cleanup_staging(output_root, staging)
        return None
    }
    html_bytes := None
    if html_override is Val(html_path) {
        source_dir :: OSPath.from_text(app_file).parent().unwrap_or(OSPath.from_text("."))
        match jet_devserver_read_inside(source_dir, html_path) {
            Ok(bytes) -> html_bytes = Val(^bytes)
            Err(e) -> {
                eprintln("error: `.html(\"{html_path}\")` names a file that doesn't exist: {e}")
                _ :: jet_devserver_cleanup_staging(output_root, staging)
                return None
            }
        }
    }
    if jet_devserver_publish_build(output_root, staging, html_bytes.as_deref()) is Err(e) {
        eprintln("error: couldn't finalize web build: {e}")
        _ :: jet_devserver_cleanup_staging(output_root, staging)
        return None
    }
    _ :: jet_devserver_cleanup_staging(output_root, staging)
    if is_rebuild -> eprintln("[dev] rebuilt after change to {app_file}")
    Val(^output_root)
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:430
// GATE #4565: kernel primitive
#Unsafe("own the actual build child and both pipe-reader threads; kill and reap on shared budget or read failure")
fn jet_devserver_command_output_bounded(command: &Command, limit: USize) -> Output Error! {
    child := command.stdout(Stdio.piped()).stderr(Stdio.piped()).spawn()?
    stdout :: child.stdout.take().ok_or_else(fn() { Error.new(ErrorKind.Other, "build stdout pipe was not available") })
    stderr :: child.stderr.take().ok_or_else(fn() { Error.new(ErrorKind.Other, "build stderr pipe was not available") })
    (stdout, stderr) :: match (stdout, stderr) {
        (Ok(stdout), Ok(stderr)) -> (^stdout, ^stderr)
        (stdout, stderr) -> {
            _ :: child.kill()
            _ :: child.wait()
            return Err(stdout.err().or_else(fn() { stderr.err() }).expect("missing build pipe error"))
        }
    }
    budget :: Arc.new(AtomicUsize.new(0))
    exceeded :: Arc.new(AtomicBool.new(false))
    read_failed :: Arc.new(AtomicBool.new(false))
    stdout_join :: jet_devserver_spawn_output_reader(^stdout, limit, Arc.clone(budget), Arc.clone(exceeded), Arc.clone(read_failed))
    stderr_join :: jet_devserver_spawn_output_reader(^stderr, limit, ^budget, Arc.clone(exceeded), Arc.clone(read_failed))
    status :: loop {
        if exceeded.load(Ordering.Acquire) || read_failed.load(Ordering.Acquire) {
            _ :: child.kill()
            break child.wait()?
        }
        match child.try_wait()? { Val(status) -> break status, None -> thread.sleep(Duration.from_millis(U64{1})) }
    }
    stdout :: stdout_join.join().map_err(_ -> Error.new(ErrorKind.Other, "build stdout reader panicked"))??
    stderr :: stderr_join.join().map_err(_ -> Error.new(ErrorKind.Other, "build stderr reader panicked"))??
    if exceeded.load(Ordering.Acquire) -> return Err(Error.new(ErrorKind.InvalidData, "build child output exceeds the aggregate output budget"))
    Ok(Output{status: status, stdout: ^stdout, stderr: ^stderr})
}
// Rust: crates/jet-codegen/src/Prelude/DevServer.rs:507
// GATE #4565: kernel primitive
#Unsafe("transfer one real read pipe to its joined thread; reserve bounded aggregate bytes by compare-exchange")
fn jet_devserver_spawn_output_reader<R: Read + Send>(reader: ^R, limit: USize, budget: ^Arc<AtomicUsize>, exceeded: ^Arc<AtomicBool>, read_failed: ^Arc<AtomicBool>) -> thread.JoinHandle<[U8] Error!> {
    thread.spawn(fn() {
        reader := ^reader
        bytes := [U8]{}
        chunk := Array<U8, 8192>.from_fn(_ -> U8{0})
        loop {
            count :: match reader.read(&chunk) {
                Ok(count) -> count
                Err(error) -> { read_failed.store(true, Ordering.Release); return Err(^error) }
            }
            if count == 0 -> return Ok(^bytes)
            used := budget.load(Ordering.Acquire)
            kept :: loop {
                available :: limit.saturating_sub(used)
                kept :: available.min(count)
                next_used :: used.saturating_add(kept)
                match budget.compare_exchange(used, next_used, Ordering.AcqRel, Ordering.Acquire) {
                    Ok(_) -> break kept
                    Err(next_used) -> used = next_used
                }
            }
            if kept < count { exceeded.store(true, Ordering.Release); return Ok(^bytes) }
            bytes.extend_from_slice(chunk[0..<count])
        }
    })
}
