        name := name.trim().to_ascii_lowercase() // #4303
        value := value.trim() // #4303
        if name.is_empty() || name.bytes().any(byte -> byte.is_ascii_whitespace() || byte.is_ascii_control()) {
            return Err(Error.new(ErrorKind.InvalidData, "malformed devserver header name"))
        }
        duplicate :: match name.as_str() {
            "authorization" -> { duplicate :: saw_authorization; saw_authorization = true; duplicate }
            "content-length" -> { duplicate :: saw_content_length; saw_content_length = true; duplicate }
            "host" -> { duplicate :: saw_host; saw_host = true; duplicate }
            "origin" -> { duplicate :: saw_origin; saw_origin = true; duplicate }
            "transfer-encoding" -> { duplicate :: saw_transfer_encoding; saw_transfer_encoding = true; duplicate }
            _ -> false
        }
        if duplicate -> return Err(Error.new(ErrorKind.InvalidData, "duplicate devserver security header"))
        if name == "transfer-encoding" -> return Err(Error.new(ErrorKind.InvalidData, "devserver does not accept transfer-encoded requests"))
        if name == "content-length" {
            content_length = Val(value.parse::<USize>().map_err(_ -> Error.new(ErrorKind.InvalidData, "invalid devserver content length"))?)
