// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:161
// Development-only opt-in output intentionally exposes values; release HTML never calls it.
fn jet_web_form_dev_panel() -> String {
    if !jet_web_runtime_devtools_enabled() -> return ""
    // GATE #4565: kernel primitive
    #Unsafe("snapshot opt-in dev form facts while holding the sole panel registry mutex") {
        locked :: JET_WEB_FORM_PANEL_FACTS.lock()
        if locked.is_err() -> return ""
        facts :: locked.unwrap()
        rows := [String].new()
        loop fact in facts.iter() {
            state :: fact.state.get()
            lifecycle :: fact.lifecycle.get()
            names: [String] := state.fields.keys().cloned().collect()
            names.sort()
            field_errors :: names.iter().filter(fn(name) { !state.fields[name].errors.is_empty() }).map(fn(name) {
                "{jet_web_form_escape(name)}={jet_web_form_escape(&state.fields[name].errors.join("; "))}"
            }).collect<[String]>().join(",")
            validation_phase :: if state.fields.values().any(fn(field) { field.validating }) { "validating" } else { state.status.name() }
            facts_text :: format!("values=[{}],touched=[{}],validation_phase={},lifecycle={},submissions={},field_errors=[{}],form_error={}",
                jet_web_form_panel_values(&state), jet_web_form_panel_names(&state, fn(field) { field.touched }),
                validation_phase, lifecycle.status.name(), state.submission_count, field_errors, jet_web_form_escape(&state.error))
            rows.push(format!("<li data-jet-form-id=\"{}\" data-jet-form-type=\"{}\" data-jet-form-action=\"{}\"><code>{}</code><pre>{}</pre></li>",
                fact.id, jet_web_form_escape(&fact.type_name), jet_web_form_escape(&fact.action),
                jet_web_form_escape(&fact.type_name), jet_web_form_escape(&facts_text)))
        }
        if rows.is_empty() -> return ""
        format!("<aside id=\"jet-dev-forms\" data-jet-devtools=\"forms\"><h2>Forms</h2><ul>{}</ul></aside>", rows.join(""))
    }
}
