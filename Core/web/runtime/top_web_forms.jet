// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:924
fn jet_web_form_input_type(value_type: WebFormValueType) -> &String {
    match value_type { .String -> "text", .Int -> "number", .Bool -> "checkbox", .Float -> "number" }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:933
fn jet_web_form_valid_name(name: &String) -> Bool {
    chars := name.chars()
    first :: chars.next()
    first.is_some_and(fn(c) { c == '_' || c.is_ascii_alphabetic() }) && chars.all(fn(c) { c == '_' || c.is_ascii_alphanumeric() })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:939
fn jet_web_form_validate_value(value: &String, value_type: WebFormValueType, required: Bool) -> [String] {
    errors := [String].new()
    if required && value.trim().is_empty() { errors.push("value is required"); return errors }
    if value.trim().is_empty() -> return errors
    match value_type {
        .String -> {}
        .Int -> { if value.parse<I64>().is_err() -> errors.push("expected Int") }
        .Bool -> { if value != "true" && value != "false" && value != "1" && value != "0" -> errors.push("expected Bool") }
        .Float -> match value.parse<F64>() {
            Ok(number) if number.is_finite() -> {}
            _ -> errors.push("expected finite Float")
        }
    }
    errors
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:972
fn jet_web_form_validate_field(field: &WebFormFieldState, validators: (&[JetWebFormValidator])?) -> [String] {
    errors := jet_web_form_validate_value(&field.value, field.value_type, field.required)
    if Some(validators) :: validators {
        loop validator in validators {
            if Err(error) :: validator(field.value.clone()) -> errors.push(jet_web_form_bound_error(^error))
        }
    }
    errors
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:987
fn jet_web_form_bound_error(error: String) -> String {
    if error.len() <= JET_WEB_FORM_MAX_ERROR -> return error
    error.char_indices().take_while(fn((index, _)) { *index < JET_WEB_FORM_MAX_ERROR }).map(fn((_, character)) { character }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:998
fn jet_web_form_encode(value: &String) -> String {
    out := String.with_capacity(value.len())
    loop byte in value.bytes() {
        if byte.is_ascii_alphanumeric() || byte == 45 || byte == 95 || byte == 46 || byte == 126 {
            out.push(byte as Char)
        } else if byte == 32 {
            out.push('+')
        } else {
            out.push('%')
            out.push(Char.from("0123456789ABCDEF".as_bytes()[(byte >> 4) as USize]))
            out.push(Char.from("0123456789ABCDEF".as_bytes()[(byte & 0x0f) as USize]))
        }
    }
    out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:1014
fn jet_web_form_escape(value: &String) -> String {
    out := String.with_capacity(value.len())
    loop character in value.chars() {
        match character {
            '&' -> out.push_str("&amp;")
            '<' -> out.push_str("&lt;")
            '>' -> out.push_str("&gt;")
            '\"' -> out.push_str("&quot;")
            '\'' -> out.push_str("&#39;")
            _ -> out.push(character)
        }
    }
    out
}
