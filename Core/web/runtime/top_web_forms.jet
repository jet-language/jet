fn jet_web_form_event_entity(action: &String) -> String {
    if !action.trim().is_empty() && action.len() <= JET_WEB_FORM_MAX_NAME && action.chars().all(fn(character) { !character.is_control() }) {
        action.to_string()
    } else { "form" }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:30
fn jet_web_form_publish_state(state: &JetWebFormState, cause: &String) -> {
    if !jet_web_runtime_devtools_enabled() -> return
    invalid :: state.fields.values().filter(fn(field) { !field.errors.is_empty() }).count()
    validating :: state.fields.values().filter(fn(field) { field.validating }).count()
    touched :: state.fields.values().filter(fn(field) { field.touched }).count()
    fields :: format!("{{\"status\":{},\"field_count\":{},\"invalid_count\":{},\"validating_count\":{},\"touched_count\":{},\"submissions\":{},\"error_bytes\":{},\"result_bytes\":{},\"cause\":{}}}",
        jet_web_form_json(state.status.name()), state.fields.len(), invalid, validating, touched,
        state.submission_count, state.error.len(), state.result.len(), jet_web_form_json(cause))
    if Ok(event) :: JetDevtoolsEvent.from_parts(jet_web_form_now_ms(), "core.web.forms", "Form", jet_web_form_event_entity(&state.action), ^fields) {
        jet_devtools_publish_event(^event)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:59
