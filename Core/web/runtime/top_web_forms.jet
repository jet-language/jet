// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:60
fn jet_web_form_now_ms() -> U64 {
    // GATE #4565: kernel primitive
    #Unsafe("read wall clock for opt-in devtools event timestamp") {
        SystemTime.now().duration_since(UNIX_EPOCH).ok().and_then(fn(duration) { U64.try_from(duration.as_millis()).ok() }).unwrap_or(0)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:68
fn jet_web_form_publish_lifecycle(type_name: &String, lifecycle: &JetWebFormLifecycle, state: &JetWebFormState) -> {
    if !jet_web_runtime_devtools_enabled() -> return
    entity :: if jet_web_form_valid_type_name(type_name) { type_name.to_string() } else { "typed-form" }
    fields :: format!("{{\"lifecycle\":{},\"generation\":{},\"form_status\":{},\"error_bytes\":{},\"result_bytes\":{}}}",
        jet_web_form_json(lifecycle.status.name()), lifecycle.generation, jet_web_form_json(state.status.name()),
        lifecycle.error.len(), lifecycle.result.len())
    if Ok(event) :: JetDevtoolsEvent.from_parts(jet_web_form_now_ms(), "core.web.forms", "Form", ^entity, ^fields) {
        jet_devtools_publish_event(^event)
    }
}
