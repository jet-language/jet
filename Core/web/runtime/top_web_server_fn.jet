// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebServerFn.rs:20
fn jet_web_server_fn_clean(value: &String, limit: USize) -> String {
    result := String.with_capacity(value.len().min(limit))
    loop character in value.chars() {
        if result.len() >= limit -> break
        if character.is_control() { result.push(' ') } else { result.push(character) }
    }
    trimmed := result.trim() // #4303
    trimmed.to_string()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebServerFn.rs:35
fn jet_web_server_fn_json_string(value: &String) -> String {
    out := String.with_capacity(value.len().saturating_add(2))
    out.push('"')
    loop character in value.chars() {
        match character {
            '"' -> out.push_str("\\\"")
            '\\' -> out.push_str("\\\\")
            '\n' -> out.push_str("\\n")
            '\r' -> out.push_str("\\r")
            '\t' -> out.push_str("\\t")
            character if character.is_control() -> out.push_str(&format!("\\u{:04x}", character as U32))
            character -> out.push(character)
        }
    }
    out.push('"')
    out
}
