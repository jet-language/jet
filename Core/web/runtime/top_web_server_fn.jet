            .EndpointNotFound -> "the server function endpoint was not found"
            .UnsupportedMediaType -> "the server function body format is not supported"
            .InvalidOutput -> "the server function returned an invalid wire value"
            .InvalidContext -> "the request context is invalid"
            .Unauthorized -> "authentication is required"
            .Cancelled -> "the server function call was cancelled"
            .TimedOut -> "the server function call timed out"
