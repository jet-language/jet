            43 -> out.push(32)
            37 if index + 2 < bytes.len() -> {
                high :: jet_web_server_fn_hex(bytes[index + 1]).ok_or(.InvalidInput("form input contains an invalid escape"))?
                low :: jet_web_server_fn_hex(bytes[index + 2]).ok_or(.InvalidInput("form input contains an invalid escape"))?
                out.push(high << 4 | low)
                index += 2
            }
            37 -> return Err(.InvalidInput("form input contains an incomplete escape"))
            byte -> out.push(byte)
        }
        index += 1
    }
