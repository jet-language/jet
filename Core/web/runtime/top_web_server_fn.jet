fn jet_web_server_fn_form_field(body: &String, wanted: &String) -> String? {
    body.split('&').find_map(fn(pair) {
        (raw_key, raw_value) :: pair.split_once('=').unwrap_or((pair, ""))
        key :: jet_web_server_fn_form_decode(raw_key).ok()?
        if key == wanted { jet_web_server_fn_form_decode(raw_value).ok() } else { None }
    })
}
