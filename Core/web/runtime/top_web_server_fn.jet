        97..=102 -> Some(value - 97 + 10)
        65..=70 -> Some(value - 65 + 10)
        _ -> None
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebServerFn.rs:1347
fn jet_web_server_fn_form_decode(value: &String) -> String JetWebServerFnError! {
    bytes :: value.as_bytes()
    out := [U8].with_capacity(value.len())
