    pub fn selected_rows(self: &Self) -> [WebTableRow<T>] Err! {
        selected :: self.state().selected_keys.into_iter().map(fn(key) { (^key, true) }).collect<[String: Bool]>()
        rows :: if self.server_page.is_some() {
            match self.loaded_page() { Val(page) -> page.keyed_rows(), None -> self.rows_with_keys()? }
        } else { self.rows_with_keys()? }
