        columns :: self.columns()
        column_json :: columns.iter().map(fn((name, cell_type)) {
            format("{{\"name\":\"{}\",\"type\":\"{}\"}}", jet_web_table_json_escape(name), jet_web_table_json_escape(cell_type))
        }).collect<[String]>().join(",")
        page :: self.loaded_page()
        total_rows :: page.as_ref().map(fn(page) { page.total_rows }).unwrap_or(0)
        page_count :: page.as_ref().map(fn(page) { page.page_count }).unwrap_or(0)
        status :: self.status()
        error :: self.error()
        format(
            "{{\"name\":\"{}\",\"identity\":\"{}\",\"key\":\"{}\",\"columns\":[{}],\"page_index\":{},\"page_size\":{},\"page_mode\":\"{}\",\"selected_keys\":[{}],\"selection_anchor\":{},\"focus_key\":{},\"has_explicit_key\":{},\"sort\":{},\"filter\":{},\"loaded_page\":{},\"total_rows\":{},\"page_count\":{},\"status\":\"{}\",\"loading\":{},\"error\":\"{}\"}}",
            jet_web_table_json_escape(&self.name), jet_web_table_json_escape(&self.name), jet_web_table_json_escape(&self.name),
            column_json, state.page_index.max(0), state.page_size.clamp(1, JET_WEB_TABLE_MAX_PAGE_SIZE),
            if state.page_mode.is_server() { "server" } else { "client" },
            jet_web_table_string_list_json(&state.selected_keys),
            state.selection_anchor.as_ref().map(fn(key) { format("\"{}\"", jet_web_table_json_escape(key)) }).unwrap_or_else(fn() { "null" }),
            state.focus_key.as_ref().map(fn(key) { format("\"{}\"", jet_web_table_json_escape(key)) }).unwrap_or_else(fn() { "null" }),
            self.has_explicit_key(),
            state.sort.as_ref().map(fn(sort) {
                format("{{\"column\":\"{}\",\"direction\":\"{}\"}}", jet_web_table_json_escape(&sort.column), if sort.direction.is_descending() { "desc" } else { "asc" })
            }).unwrap_or_else(fn() { "null" }),
            state.filter.as_ref().map(fn(filter) {
