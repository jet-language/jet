    // Renderers supply nodes; this headless table supplies keyed semantic rows only.
    pub fn render_page<R, F: Fn(&T, String) -> R>(self: &Self, render: F) -> [R] Err! {
        Ok(self.page()?.keyed_rows().iter().map(fn(row) { render(&row.value, &row.key) }).collect())
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:998
    pub fn render_virtual<R, F: Fn(&T, String) -> R>(self: &Self, plan: &JetWebVirtualPlan, render: F) -> [R] Err! {
        Ok(self.visible_rows(plan)?.iter().map(fn(row) { render(&row.value, &row.key) }).collect())
    }
}

