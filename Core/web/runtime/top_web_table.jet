            if self.loaded_page() is Val(page) { return Ok(^page.row_keys) }
        }
        Ok(jet_web_table_rows_with_keys(&self.rows(), self.row_key.as_ref())?.into_iter().map(fn(row) { ^row.key }).collect())
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:710
    pub fn rows_with_keys(self: &Self) -> [WebTableRow<T>] Err! {
        if self.server_page.is_some() {
            if self.loaded_page() is Val(page) { return Ok(page.keyed_rows()) }
        }
        jet_web_table_rows_with_keys(&self.rows(), self.row_key.as_ref())
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:719
    pub fn selected_keys(self: &Self) -> [String] { self.state().selected_keys }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:722
    pub fn focused_key(self: &Self) -> String? { self.state().focus_key }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:726
    pub fn focus(self: &Self, key: String) -> Self Err! {
        if !jet_web_table_key_is_valid(&key) {
            return Err("table focus key must be non-empty, bounded, and printable")
        }
        state := self.state()
        state.focus_key = Val(^key)
