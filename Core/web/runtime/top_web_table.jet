}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1333
pub fn jet_web_table_page<T: Clone>(rows: &[T], page_index: I64, page_size: I64) -> JetWebTablePage<T> {
    page_size :: page_size.clamp(1, JET_WEB_TABLE_MAX_PAGE_SIZE)
    total_rows :: I64.try_from(rows.len()).unwrap_or(I64.MAX)
    page_count :: if total_rows == 0 { 0 } else {
        total_rows.saturating_add(page_size.saturating_sub(1)).checked_div(page_size).unwrap_or(0)
    }
    page_index :: if page_count == 0 { 0 } else { page_index.max(0).min(page_count - 1) }
    start :: USize.try_from(page_index.saturating_mul(page_size).min(total_rows)).unwrap_or(USize.MAX).min(rows.len())
    end :: start.saturating_add(USize.try_from(page_size).unwrap_or(USize.MAX)).min(rows.len())
    JetWebTablePage{rows: rows[start..<end].to_vec(), row_keys: (start..<end).map(fn(index) { "index:{index}" }).collect(), total_rows: total_rows, page_index: page_index, page_size: page_size, page_count: page_count}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1371
fn jet_web_table_validate_server_page<T>(page: JetWebTablePage<T>, row_key: JetWebTableRowKey<T>?) -> JetWebTablePage<T> Err! {
    if page.total_rows < 0 { return Err("server table page has negative total_rows") }
    if page.page_size < 1 || page.page_size > JET_WEB_TABLE_MAX_PAGE_SIZE {
        return Err("server table page_size must be between 1 and {JET_WEB_TABLE_MAX_PAGE_SIZE}")
    }
    if page.page_index < 0 { return Err("server table page has negative page_index") }
    if page.rows.len() > page.page_size as USize { return Err("server table returned more rows than page_size") }
    expected_count :: if page.total_rows == 0 { 0 } else {
        page.total_rows.saturating_add(page.page_size - 1).checked_div(page.page_size).unwrap_or(0)
    }
    if page.page_count != expected_count { return Err("server table page_count does not match total_rows") }
    if expected_count == 0 {
        if page.page_index != 0 || !page.rows.is_empty() || !page.row_keys.is_empty() {
            return Err("empty server table page has invalid page_index, rows, or keys")
        }
    } else if page.page_index >= expected_count { return Err("server table page_index is out of range") }
    if page.total_rows > 0 && page.rows.is_empty() { return Err("non-empty server table result returned an empty page") }
    if expected_count > 0 && page.page_index.saturating_add(1) < expected_count && page.rows.len() != page.page_size as USize {
        return Err("non-final server table pages must be full")
    }
    if row_key is Val(key) {
        // Explicit accessor keys are canonical, ignoring stale/positional loader keys.
        page.row_keys = page.rows.iter().map(fn(row) { key(row) }).collect()
    } else if page.row_keys.is_empty() && !page.rows.is_empty() {
        page_start :: page.page_index.saturating_mul(page.page_size).max(0)
        page.row_keys = page.rows.iter().enumerate().map(fn((offset, _)) { "index:{page_start.saturating_add(offset as I64)}" }).collect()
    }
    if page.row_keys.len() != page.rows.len() { return Err("server table row_keys must align with rows") }
    jet_web_table_validate_keys(&page.row_keys)?
    Ok(^page)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1440
fn jet_web_table_materialize<T: Clone>(rows: &[T], state: &JetWebTableState, columns: &[JetWebTableColumn<T>], row_key: JetWebTableRowKey<T>?) -> JetWebTablePage<T> Err! {
    jet_web_table_validate_columns(columns)?
    selected := jet_web_table_rows_with_keys(rows, row_key)?
    if &state.filter is Val(filter) {
        column :: columns.iter().find(fn(column) { column.name == filter.column }).ok_or_else(fn() { "table filter column `{filter.column}` has no accessor" })?
        selected.retain(fn(entry) { column.value(&entry.value).contains(filter.value.as_str()) })
    }
    if &state.sort is Val(sort) {
        column :: columns.iter().find(fn(column) { column.name == sort.column }).ok_or_else(fn() { "table sort column `{sort.column}` has no accessor" })?
        descending :: sort.direction.is_descending()
        // Stable sorting retains source order for equal cells, with identity attached.
        selected.sort_by(fn(left, right) {
            ordering :: column.value(&left.value).cmp(&column.value(&right.value))
            if descending { ordering.reverse() } else { ordering }
        })
    }
    Ok(jet_web_table_page_keyed(&selected, state.page_index, state.page_size))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1479
fn jet_web_table_page_state_changed(previous: &JetWebTableState, next: &JetWebTableState) -> Bool {
    previous.sort != next.sort || previous.filter != next.filter || previous.page_index != next.page_index || previous.page_size != next.page_size || previous.page_mode != next.page_mode
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1489
fn jet_web_table_query_boundary_changed(previous: &JetWebTableState, next: &JetWebTableState) -> Bool {
    previous.sort != next.sort || previous.filter != next.filter || previous.page_size != next.page_size || previous.page_mode != next.page_mode
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1499
fn jet_web_table_normalize_state(state: JetWebTableState) -> JetWebTableState {
    state.page_index = state.page_index.max(0)
    state.page_size = state.page_size.clamp(1, JET_WEB_TABLE_MAX_PAGE_SIZE)
    state.selected_keys.retain(fn(key) { jet_web_table_key_is_valid(key) })
    state.selected_keys.sort()
    state.selected_keys.dedup()
    if state.selection_anchor.as_ref().is_some_and(fn(key) { !state.selected_keys.iter().any(fn(selected) { selected == key }) }) {
        state.selection_anchor = None
    }
    if state.focus_key.as_ref().is_some_and(fn(key) { !jet_web_table_key_is_valid(key) }) { state.focus_key = None }
    state
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1524
fn jet_web_table_reconcile_state<T>(state: JetWebTableState, rows: &[T], row_key: JetWebTableRowKey<T>?) -> JetWebTableState {
    state := jet_web_table_normalize_state(^state)
    keys :: match jet_web_table_row_keys(rows, row_key) { Ok(keys) -> keys, Err(_) -> return state }
    keys :: keys.into_iter().map(fn(key) { (^key, true) }).collect<[String: Bool]>()
    state.selected_keys.retain(fn(key) { keys.contains_key(key) })
    if state.selection_anchor.as_ref().is_some_and(fn(key) { !keys.contains_key(key) }) { state.selection_anchor = None }
    if state.focus_key.as_ref().is_some_and(fn(key) { !keys.contains_key(key) }) { state.focus_key = None }
    state
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1552
fn jet_web_table_key_is_valid(key: String) -> Bool {
    !key.is_empty() && key.len() <= JET_WEB_TABLE_MAX_KEY_BYTES && !key.chars().any(fn(character) { character.is_control() })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1558
fn jet_web_table_validate_keys(keys: &[String]) -> Unit Err! {
    seen := [String: Bool]{}
    loop key in keys {
        if !jet_web_table_key_is_valid(key) { return Err("table row key must be non-empty, bounded, and printable") }
        if seen.insert(key.clone(), true).is_some() { return Err("table row key `{key}` is duplicated") }
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1571
fn jet_web_table_validate_columns<T>(columns: &[JetWebTableColumn<T>]) -> Unit Err! {
    seen := [String: Bool]{}
    loop column in columns {
        if !jet_web_table_key_is_valid(&column.name) { return Err("table column name must be non-empty, bounded, and printable") }
        if !jet_web_table_key_is_valid(&column.cell_type) { return Err("table column cell type must be non-empty, bounded, and printable") }
        if seen.insert(column.name.clone(), true).is_some() { return Err("table column `{column.name}` is duplicated") }
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1589
fn jet_web_table_row_keys<T>(rows: &[T], row_key: JetWebTableRowKey<T>?) -> [String] Err! {
    keys :: rows.iter().enumerate().map(fn((index, row)) {
        row_key.map(fn(key) { key(row) }).unwrap_or_else(fn() { "index:{index}" })
    }).collect<[String]>()
    jet_web_table_validate_keys(&keys)?
    Ok(^keys)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1604
fn jet_web_table_rows_with_keys<T: Clone>(rows: &[T], row_key: JetWebTableRowKey<T>?) -> [WebTableRow<T>] Err! {
    Ok(rows.iter().cloned().zip(jet_web_table_row_keys(rows, row_key)?).map(fn((value, key)) { WebTableRow{value: ^value, key: ^key} }).collect())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1616
fn jet_web_table_page_keyed<T: Clone>(rows: &[WebTableRow<T>], page_index: I64, page_size: I64) -> JetWebTablePage<T> {
    page_size :: page_size.clamp(1, JET_WEB_TABLE_MAX_PAGE_SIZE)
    total_rows :: I64.try_from(rows.len()).unwrap_or(I64.MAX)
    page_count :: if total_rows == 0 { 0 } else {
        total_rows.saturating_add(page_size.saturating_sub(1)).checked_div(page_size).unwrap_or(0)
    }
    page_index :: if page_count == 0 { 0 } else { page_index.max(0).min(page_count - 1) }
    start :: USize.try_from(page_index.saturating_mul(page_size).min(total_rows)).unwrap_or(USize.MAX).min(rows.len())
    end :: start.saturating_add(USize.try_from(page_size).unwrap_or(USize.MAX)).min(rows.len())
    JetWebTablePage{
        rows: rows[start..<end].iter().map(fn(row) { row.value.clone() }).collect(),
        row_keys: rows[start..<end].iter().map(fn(row) { row.key.clone() }).collect(),
        total_rows: total_rows, page_index: page_index, page_size: page_size, page_count: page_count
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1661
fn jet_web_table_string_list_json(values: &[String]) -> String {
    values.iter().map(fn(value) { format("\"{}\"", jet_web_table_json_escape(value)) }).collect<[String]>().join(",")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1669
fn jet_web_table_json_escape(value: String) -> String {
    escaped := String.with_capacity(value.len())
    loop character in value.chars() {
        match character {
            '"' -> escaped.push_str("\\\"")
            '\\' -> escaped.push_str("\\\\")
            '\n' -> escaped.push_str("\\n")
            '\r' -> escaped.push_str("\\r")
            '\t' -> escaped.push_str("\\t")
            character if character.is_control() -> escaped.push_str(&format("\\u{:04x}", character as U32))
            character -> escaped.push(character)
        }
    }
    escaped
}

