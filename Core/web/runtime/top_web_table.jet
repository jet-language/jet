// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:1306
pub fn jet_web_table_sort<T: Clone, F: Fn(&T) -> String>(rows: &[T], descending: Bool, key: F) -> [T] {
    sorted := rows.clone()
    sorted.sort_by(fn(left, right) {
        ordering :: key(left).cmp(&key(right))
        if descending { ordering.reverse() } else { ordering }
    })
    sorted
}
