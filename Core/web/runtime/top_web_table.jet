        self.set_state(^state)
        self.clone()
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:744
    pub fn set_selected(self: &Self, key: String, selected: Bool) -> Self Err! {
        if !jet_web_table_key_is_valid(&key) {
            return Err("table selection key must be non-empty, bounded, and printable")
        }
        state := self.state()
        if selected { state.selected_keys.push(key.clone()) }
        else { state.selected_keys.retain(fn(existing) { existing != &key }) }
        if selected {
            state.selection_anchor = Val(key.clone())
            state.focus_key = Val(^key)
        } else if state.selection_anchor.as_deref() == Val(key.as_str()) {
            state.selection_anchor = state.selected_keys.first().cloned()
        }
        self.set_state(^state)
        Ok(self.clone())
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:764
    pub fn toggle_selection(self: &Self, key: String) -> Self Err! {
        selected :: self.state().selected_keys.iter().any(fn(value) { value == &key })
        self.set_selected(^key, !selected)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:769
    pub fn clear_selection(self: &Self) -> Self {
        state := self.state()
        state.selected_keys.clear()
        state.selection_anchor = None
        self.set_state(^state)
        self.clone()
    }
