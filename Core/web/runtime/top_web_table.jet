    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:825
    pub fn replace_row(self: &Self, key: String, row: T) -> Unit Err! {
        if !jet_web_table_key_is_valid(key) { return Err("table row key must be non-empty, bounded, and printable") }
        rows := self.rows()
        keyed :: jet_web_table_rows_with_keys(&rows, self.row_key.as_ref())?
        index :: keyed.iter().position(fn(existing) { existing.key == key }).ok_or_else(fn() { "table row key `{key}` was not found" })?
        replacement_key :: self.row_key.as_ref().map(fn(row_key) { row_key(&row) }).unwrap_or_else(fn() { "index:{index}" })
        if replacement_key != key { return Err("table row replacement cannot change the row key") }
        rows[index] = ^row
        _ :: jet_web_table_rows_with_keys(&rows, self.row_key.as_ref())?
        self.set_rows(^rows)
        Ok(())
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:849
    pub fn update_row<F: FnOnce(&T)>(self: &Self, key: String, update: F) -> Unit Err! {
        if !jet_web_table_key_is_valid(key) { return Err("table row key must be non-empty, bounded, and printable") }
        rows := self.rows()
        keyed :: jet_web_table_rows_with_keys(&rows, self.row_key.as_ref())?
        index :: keyed.iter().position(fn(row) { row.key == key }).ok_or_else(fn() { "table row key `{key}` was not found" })?
        update(&rows[index])
        updated_key :: self.row_key.as_ref().map(fn(row_key) { row_key(&rows[index]) }).unwrap_or_else(fn() { "index:{index}" })
        if updated_key != key { return Err("table row updates cannot change the row key") }
        _ :: jet_web_table_rows_with_keys(&rows, self.row_key.as_ref())?
        self.set_rows(^rows)
        Ok(())
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:876
    pub fn remove_row(self: &Self, key: String) -> T Err! {
        rows := self.rows()
        keyed :: jet_web_table_rows_with_keys(&rows, self.row_key.as_ref())?
        index :: keyed.iter().position(fn(row) { row.key == key }).ok_or_else(fn() { "table row key `{key}` was not found" })?
        removed :: rows.remove(index)
        self.set_rows(^rows)
        Ok(^removed)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:888
    pub fn first_page(self: &Self) -> Self { self.paginate(0, self.state().page_size) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:891
    pub fn next_page(self: &Self) -> Self {
        page :: match self.loaded_page() {
            Val(page) -> page
            None -> match self.page() { Ok(page) -> page, Err(_) -> return self.clone() }
        }
        next_index :: match page.next_page() { Val(index) -> index, None -> return self.clone() }
        self.paginate(next_index, page.page_size)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:907
    pub fn last_page(self: &Self) -> Self Err! {
        page :: match self.loaded_page() { Val(page) -> page, None -> self.page()? }
        Ok(self.paginate(page.last_page(), page.page_size))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebTable.rs:916
    pub fn visible_rows(self: &Self, plan: &JetWebVirtualPlan) -> [WebTableRow<T>] Err! {
        if self.server_page.is_some() {
            page :: self.loaded_page().ok_or_else(fn() { "server table visible rows require a loaded page" })?
            rows :: page.keyed_rows()
            loaded_count :: I64.try_from(rows.len()).unwrap_or(I64.MAX)
            global_indices :: plan.total_count == page.total_rows && plan.total_count > loaded_count
            page_start :: page.page_index.saturating_mul(page.page_size).max(0)
            // Whole-result plans use global indices; loaded-page plans use local indices.
            return Ok(plan.indices().into_iter().filter_map(fn(index) {
                local :: if global_indices { index.checked_sub(page_start)? } else { index }
                USize.try_from(local).ok().and_then(fn(local) { rows.get(local).cloned() })
            }).collect())
        }
        state :: self.state()
        visible := jet_web_table_rows_with_keys(&self.rows(), self.row_key.as_ref())?
        if &state.filter is Val(filter) {
            column :: self.columns.iter().find(fn(column) { column.name == filter.column }).ok_or_else(fn() { "table filter column `{filter.column}` has no accessor" })?
            visible.retain(fn(row) { column.value(&row.value).contains(filter.value.as_str()) })
        }
        if &state.sort is Val(sort) {
            column :: self.columns.iter().find(fn(column) { column.name == sort.column }).ok_or_else(fn() { "table sort column `{sort.column}` has no accessor" })?
            descending :: sort.direction.is_descending()
            visible.sort_by(fn(left, right) {
                ordering :: column.value(&left.value).cmp(&column.value(&right.value))
                if descending { ordering.reverse() } else { ordering }
            })
        }
        Ok(plan.indices().into_iter().filter_map(fn(index) { USize.try_from(index).ok() }).filter_map(fn(index) { visible.get(index).cloned() }).collect())
    }
