        key :: self.row_key.as_ref().map(fn(key) { key(&row) }).unwrap_or_default()
        if !jet_web_table_key_is_valid(&key) { return Err("table row key must be non-empty, bounded, and printable") }
        rows := self.rows()
        existing :: jet_web_table_rows_with_keys(&rows, self.row_key.as_ref())?
        if existing.iter().any(fn(existing) { existing.key == key }) { return Err("table row key `{key}` is duplicated") }
        rows.push(^row)
