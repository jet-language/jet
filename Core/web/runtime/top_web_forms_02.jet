// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:2341
fn jet_web_form_validate_text(value: &String,kind: &String) -> () Err! {
    if value.is_empty() { return Err("{kind} must not be empty") }
    if value.len() > JET_WEB_FORM_MAX_NAME { return Err("{kind} exceeds {JET_WEB_FORM_MAX_NAME} bytes") }
    if value.chars().any(fn(c) { c.is_control() }) { return Err("{kind} contains a control character") }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:2354
fn jet_web_form_human_label(name: &String) -> String {
    label := String.new()
    for (index,word) in name.split(['_','-']).enumerate() {
        if word.is_empty() { continue }
        if index > 0 { label.push(' ') }
        chars := word.chars()
        if Some(first) :: chars.next() { label.extend(first.to_uppercase()); label.extend(chars) }
    }
    ^label
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:2372
fn jet_web_form_valid_type_name(name: &String) -> Bool { !name.is_empty() && name.split("::").all(jet_web_form_valid_name) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:2379
fn jet_web_form_field_id(type_name: &String,wire_name: &String) -> String {
    id := String.with_capacity(type_name.len()+wire_name.len()+1)
    for character in type_name.chars().chain(['-']).chain(wire_name.chars()) {
        if character.is_ascii_alphanumeric() || character == '_' || character == '-' { id.push(character) } else { id.push('-') }
    }
    ^id
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:2391
fn jet_web_form_decode_component(value: &String) -> String Err! {
    bytes :: value.as_bytes()
    decoded := [U8].with_capacity(bytes.len())
    index := 0
    while index < bytes.len() {
        match bytes[index] {
            b'+' -> decoded.push(b' '),
            b'%' -> {
                if index+2 >= bytes.len() { return Err("form body contains an incomplete percent escape") }
                high :: jet_web_form_hex(bytes[index+1]).ok_or_else(fn() { "form body contains an invalid percent escape" })?
                low :: jet_web_form_hex(bytes[index+2]).ok_or_else(fn() { "form body contains an invalid percent escape" })?
                decoded.push((high << 4) | low)
                index += 2
            },
            byte -> decoded.push(byte)
        }
        index += 1
        if decoded.len() > JET_WEB_FORM_MAX_VALUE { return Err("decoded form value exceeds {JET_WEB_FORM_MAX_VALUE} bytes") }
    }
    value :: String.from_utf8(^decoded).map_err(fn(_) { "form body contains invalid UTF-8" })?
    if value.chars().any(fn(c) { c.is_control() }) { return Err("form value contains a control character") }
    Ok(^value)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/WebForms.rs:2427
fn jet_web_form_hex(value: U8) -> U8? {
    match value { b'0'..=b'9' -> Some(value-b'0'), b'a'..=b'f' -> Some(value-b'a'+10), b'A'..=b'F' -> Some(value-b'A'+10), _ -> None }
}
