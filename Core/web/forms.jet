// core.web.forms — typed HTML forms and validation carriers.

C_MAX_FORM_BYTES :: 1048576

C_MAX_FORM_FIELDS :: 256

C_MAX_FORM_TEXT :: 1048576

#Error
pub enum WebFormError {
    Invalid
    Missing
    Validation
}

pub enum WebFormValueType {
    String
    Int
    Bool
    Float
}

pub enum WebFormControl {
    Text
    Email
    URL
    Password
    Number
    Date
    Checkbox
    Hidden
}

pub enum WebFormStatus {
    Idle
    Dirty
    Validating
    Invalid
    Submitting
    Submitted
    Error
}

pub enum WebFormValidationTiming {
    Immediate
    Debounced
    OnBlur
}

pub struct WebFormFieldSpec {
    pub name: String
    pub value_type: WebFormValueType
    pub required: Bool
    pub default: String?
    pub label: String
    pub control: WebFormControl
    pub group: String?
    pub wire_name: String
}

pub struct WebFormFieldState {
    pub name: String
    pub value_type: WebFormValueType
    pub required: Bool
    pub value: String
    pub touched: Bool
    pub validating: Bool
    pub errors: [String]
}

pub struct WebForm {
    pub action: String
    pub method: String
    pub fields: [WebFormFieldState]
    pub status: WebFormStatus
    pub form_error: String
    pub focused: String
}

pub struct WebFormState {
    pub status: WebFormStatus
    pub fields: [String:WebFormFieldState]
    pub action: String
    pub method: String
    pub result: String
    pub error: String
    pub submission_count: Int
}

pub struct WebFormInput {
    pub type_name: String
    pub fields: [WebFormFieldSpec]
}

pub struct WebFormTyped {
    pub form: WebForm
    pub action: String
    pub input: WebFormInput
}

pub struct WebFormActionError {
    pub field_errors: [String:[String]]
    pub form_errors: [String]
}

pub struct WebFormDecodedInput {
    pub type_name: String
    pub values: [String:String]
    pub wire_values: [String:String]
}

pub struct WebFormValidationChain {
    pub form: WebFormTyped
    pub field: String
    pub valid: Bool
}

pub struct WebFormValidation {
    pub form: WebFormTyped
    pub pending: Bool
}

pub struct WebFormTypedSubmission {
    pub form: WebFormTyped
    pub pending: Bool
}

pub struct WebFormErrorState {
    pub fields: [String:[String]]
    pub form: [String]
}

pub enum WebFormLifecycleStatus {
    Idle
    Pending
    Submitting
    Success
    Failure
    Cancelled
}

pub struct WebFormLifecycle {
    pub status: WebFormLifecycleStatus
    pub result: String
    pub error: String
    pub generation: Int
}

pub fn new(action: String) -> WebForm Never! {
    WebForm{action: action, method: "POST", fields: [WebFormFieldState]{}, status: WebFormStatus.Idle, form_error: "", focused: ""}
}

pub fn field(form: WebForm, name: String, kind: String, required: Bool) -> WebForm WebFormError! {
    if name.len() == 0 || name.len() > 128 || !valid_name(~name) || !valid_kind(~kind) -> return Err(WebFormError.Invalid)
    out := ~form
    loop item in out.fields {
        if item.name == name -> return Err(WebFormError.Invalid)
    }
    if out.fields.len() >= C_MAX_FORM_FIELDS -> return Err(WebFormError.Invalid)
    &out.fields.push(WebFormFieldState{name: ~name, value_type: parse_kind(~kind), required: required, value: "", touched: false, validating: false, errors: [String]{}})
    Ok(out)
}

pub fn set(form: &WebForm, name: String, value: String) WebFormError! {
    if value.len() > C_MAX_FORM_TEXT -> return Err(WebFormError.Invalid)
    loop i in 0..<form.fields.len() {
        if form.fields[i].name == name {
            form.fields[i].value = ~value
            form.fields[i].errors = [String]{}
            form.fields[i].touched = true
            form.fields[i].validating = false
            form.status = WebFormStatus.Dirty
            return Ok()
        }
    }
    return Err(WebFormError.Missing)
}

pub fn blur(form: &WebForm, name: String) WebFormError! {
    found := false
    valid := false
    loop field in form.fields {
        if field.name == name {
            found = true
            valid = validate_field_form(&form, ~name)
            break
        }
    }
    if !found -> return Err(WebFormError.Missing)
    if !valid -> return Err(WebFormError.Validation)
    form.status = WebFormStatus.Dirty
    form.focused = ""
    return Ok()
}

pub fn validate(form: &WebForm) WebFormError! {
    if !apply_validation(&form) -> return Err(WebFormError.Validation)
    return Ok()
}

pub fn validate_async(form: WebForm) -> WebForm Never! {
    out := ~form
    out.status = WebFormStatus.Validating
    out
}

pub fn submit(form: &WebForm) -> String WebFormError! {
    if !apply_validation(&form) -> return Err(WebFormError.Validation)
    form.status = WebFormStatus.Submitted
    html(~form)
}

pub fn no_script(form: WebForm) -> String WebFormError! { html(form) }
pub fn html(form: WebForm) -> String Never! { render_html(form) }
pub fn show(form: WebForm) -> String Never! { render_html(form) }

pub fn input(name: String, fields: [WebFormFieldSpec]) -> WebFormInput WebFormError! {
    if !valid_name(~name) || fields.len() == 0 || fields.len() > C_MAX_FORM_FIELDS -> return Err(WebFormError.Invalid)
    names := [String]{}
    wires := [String]{}
    loop field in fields {
        if !valid_name(field.name) || !valid_name(field.wire_name) -> return Err(WebFormError.Invalid)
        if field.default == .Val(default) {
            if default.len() > C_MAX_FORM_TEXT || has_control_text(~default) -> return Err(WebFormError.Invalid)
        }
        if contains_name(names, field.name) || contains_name(wires, field.wire_name) -> return Err(WebFormError.Invalid)
        &names.push(field.name)
        &wires.push(field.wire_name)
    }
    Ok(WebFormInput{type_name: ~name, fields: copy_fields(fields)})
}

pub fn input_rename(input: WebFormInput, old_name: String, new_name: String) -> WebFormInput WebFormError! {
    if !valid_name(new_name) -> return Err(WebFormError.Invalid)
    out := ~input
    renamed := false
    loop i in 0..<out.fields.len() {
        if out.fields[i].name == old_name {
            out.fields[i].name = ~new_name
            out.fields[i].wire_name = ~new_name
            renamed = true
        }
    }
    if !renamed -> return Err(WebFormError.Missing)
    if !fields_valid(out.fields) -> return Err(WebFormError.Invalid)
    Ok(out)
}

pub fn input_exclude(input: WebFormInput, name: String) -> WebFormInput WebFormError! {
    if name.len() == 0 -> return Err(WebFormError.Invalid)
    fields := [WebFormFieldSpec]{}
    found := false
    loop item in input.fields {
        if item.name == name -> found = true else -> &fields.push(item)
    }
    if !found -> return Err(WebFormError.Missing)
    if !fields_valid(fields) -> return Err(WebFormError.Invalid)
    Ok(WebFormInput{type_name: ~input.type_name, fields: fields})
}

pub fn input_group(input: WebFormInput, prefix: String, suffix: String) -> WebFormInput WebFormError! {
    if prefix.len() == 0 && suffix.len() == 0 -> return Err(WebFormError.Invalid)
    fields := [WebFormFieldSpec]{}
    loop item in input.fields {
        &fields.push(WebFormFieldSpec{name: "{prefix}{item.name}{suffix}", value_type: item.value_type, required: item.required, default: item.default, label: item.label, control: item.control, group: item.group, wire_name: "{prefix}{item.wire_name}{suffix}"})
    }
    if !fields_valid(fields) -> return Err(WebFormError.Invalid)
    Ok(WebFormInput{type_name: ~input.type_name, fields: fields})
}

pub fn input_replace(input: WebFormInput, name: String, replacement: WebFormFieldSpec) -> WebFormInput WebFormError! {
    if !valid_name(name) || !valid_name(replacement.name) || !valid_name(replacement.wire_name) -> return Err(WebFormError.Invalid)
    out := ~input
    found := false
    loop i in 0..<out.fields.len() {
        if out.fields[i].name == name {
            out.fields[i] = replacement
            found = true
        }
    }
    if !found -> return Err(WebFormError.Missing)
    if !fields_valid(out.fields) -> return Err(WebFormError.Invalid)
    Ok(~out)
}

pub fn typed(input: WebFormInput, action: String) -> WebFormTyped WebFormError! {
    if action.len() == 0 || action.len() > C_MAX_FORM_TEXT || !fields_valid(input.fields) -> return Err(WebFormError.Invalid)
    states := states_from_specs(input.fields)
    Ok(WebFormTyped{form: WebForm{action: ~action, method: "POST", fields: states, status: WebFormStatus.Idle, form_error: "", focused: ""}, action: action, input: input})
}

pub fn typed_set(form: &WebFormTyped, name: String, value: String) WebFormError! {
    set(&form.form, name, value)
}

pub fn typed_set_async_validator(form: &WebFormTyped, name: String, timing: WebFormValidationTiming, delay_ms: Int, validator: fn(String)) WebFormError! {
    _ :: ~timing
    _ :: delay_ms
    if name.len() == 0 -> return Err(WebFormError.Missing)
    loop i in 0..<form.form.fields.len() {
        if form.form.fields[i].name == name {
            if form.form.fields[i].value.len() > C_MAX_FORM_TEXT -> return Err(WebFormError.Invalid)
            form.form.fields[i].validating = true
            form.form.status = WebFormStatus.Validating
            validator(~form.form.fields[i].value)
            form.form.fields[i].validating = false
            valid := validate_field_form(&form.form, name)
            if valid -> form.form.status = WebFormStatus.Dirty else -> form.form.status = WebFormStatus.Invalid
            return Ok()
        }
    }
    return Err(WebFormError.Missing)
}

pub fn typed_set_action<E>(form: WebFormTyped, handler: fn(WebFormDecodedInput) -> String E!) E! {
    decoded :: decoded_from_input(form)
    _ :: handler(decoded)
}

pub fn action_error() -> WebFormActionError Never! { WebFormActionError{field_errors: [String:[String]]{}, form_errors: [String]{}} }
pub fn action_field_error(error: WebFormActionError, field: String, message: String) -> WebFormActionError Never! {
    if field.len() == 0 || field.len() > 128 || message.len() == 0 || message.len() > C_MAX_FORM_TEXT -> return ~error
    out := ~error
    existing :: out.field_errors.get(field)
    if existing == None {
        _ :: &out.field_errors.add(~field, [String]{~message})
    } else {
        errors := ~existing
        if errors.len() >= C_MAX_FORM_FIELDS -> return out
        &errors.push(~message)
        _ :: &out.field_errors.add(~field, errors)
    }
    out
}

pub fn action_form_error(error: WebFormActionError, message: String) -> WebFormActionError Never! {
    if message.len() == 0 || message.len() > C_MAX_FORM_TEXT -> return ~error
    out := ~error
    if out.form_errors.len() < C_MAX_FORM_FIELDS -> &out.form_errors.push(~message)
    out
}


pub fn typed_blur(form: &WebFormTyped, name: String) WebFormError! { blur(&form.form, name) }
pub fn typed_validate(form: &WebFormTyped) WebFormError! { validate(&form.form) }
pub fn typed_validate_async(form: WebFormTyped) -> WebFormValidation Never! {
    out := ~form
    out.form.status = WebFormStatus.Validating
    WebFormValidation{form: out, pending: true}
}

pub fn typed_validate_field(form: WebFormTyped, name: String, timing: WebFormValidationTiming, validator: fn(String)) -> WebFormValidationChain Never! {
    _ :: ~timing
    out := ~form
    valid := false
    loop i in 0..<out.form.fields.len() {
        if out.form.fields[i].name == name {
            out.form.fields[i].validating = true
            out.form.status = WebFormStatus.Validating
            validator(~out.form.fields[i].value)
            out.form.fields[i].validating = false
            valid = validate_field_form(&out.form, ~name)
            if valid -> out.form.status = WebFormStatus.Dirty else -> out.form.status = WebFormStatus.Invalid
            break
        }
    }
    WebFormValidationChain{form: out, field: name, valid: valid}
}

pub fn typed_validation_render(chain: WebFormValidationChain) -> String Never! {
    if chain.valid -> return "{chain.field}:valid"
    "{chain.field}:invalid"
}

pub fn typed_submit(form: &WebFormTyped) -> String WebFormError! {
    if !apply_validation(&form.form) -> return Err(WebFormError.Validation)
    form.form.status = WebFormStatus.Submitted
    typed_html(~form)
}
pub fn typed_no_script(form: &WebFormTyped) -> String WebFormError! { typed_html(~form) }
pub fn typed_submit_async(form: WebFormTyped) -> WebFormTypedSubmission Never! {
    out := ~form
    out.form.status = WebFormStatus.Submitting
    WebFormTypedSubmission{form: out, pending: true}
}

pub fn typed_post(form: WebFormTyped, body: String) -> String WebFormError! {
    if body.len() > C_MAX_FORM_BYTES || !valid_encoding(~body) -> return Err(WebFormError.Invalid)
    decoded :: decode_typed_input(form.input, ~body) ?? return Err(WebFormError.Invalid)
    encode_typed_input(form.input, decoded)
}

pub fn typed_decode_post(form: WebFormTyped, body: String) -> WebFormDecodedInput WebFormError! {
    if body.len() > C_MAX_FORM_BYTES || !valid_encoding(~body) -> return Err(WebFormError.Invalid)
    decode_typed_input(form.input, ~body) ?? return Err(WebFormError.Invalid)
}

pub fn typed_html(form: WebFormTyped) -> String Never! { render_typed_html(form) }
pub fn typed_show(form: WebFormTyped) -> String Never! { render_typed_html(form) }

pub fn typed_state(form: WebFormTyped) -> String Never! { status_name(form.form.status) }
pub fn typed_lifecycle(form: WebFormTyped) -> WebFormLifecycle Never! { lifecycle(form.form.status) }

pub fn typed_errors(form: WebFormTyped) -> WebFormErrorState Never! {
    names := [String:[String]]{ }
    loop field in form.form.fields {
        if field.errors.len() > 0 -> _ :: &names.add(~field.name, ~field.errors)
    }
    form_errors := [String]{}
    if form.form.form_error.len() > 0 -> &form_errors.push(~form.form.form_error)
    WebFormErrorState{fields: names, form: form_errors}
}

pub fn typed_focus(form: &WebFormTyped, name: String) WebFormError! {
    if name.len() == 0 -> return Err(WebFormError.Missing)
    loop item in form.form.fields {
        if item.name == name {
            form.form.focused = ~name
            return Ok()
        }
    }
    return Err(WebFormError.Missing)
}

pub fn typed_cancel(form: &WebFormTyped) Never! {
    form.form.status = WebFormStatus.Idle
    form.form.form_error = ""
}

pub fn typed_select_field(form: WebFormTyped, name: String) -> WebFormFieldState WebFormError! {
    loop field in form.form.fields {
        if field.name == name -> return Ok(~field)
    }
    return Err(WebFormError.Missing)
}

pub fn typed_validation_wait(validation: &WebFormValidation) WebFormError! {
    result :: validate(&validation.form.form)
    validation.pending = false
    result
}

pub fn typed_validation_cancel(validation: &WebFormValidation) Never! {
    validation.pending = false
    validation.form.form.status = WebFormStatus.Idle
}

pub fn typed_submission_wait(submission: &WebFormTypedSubmission) -> String WebFormError! {
    result :: typed_submit(&submission.form)
    submission.pending = false
    result
}

pub fn typed_submission_cancel(submission: &WebFormTypedSubmission) Never! {
    submission.pending = false
    submission.form.form.status = WebFormStatus.Idle
}
fn render_typed_html(form: WebFormTyped) -> String Never! {
    out := "<form action=\"{esc(form.form.action)}\" method=\"{esc(form.form.method)}\">"
    loop spec in form.input.fields {
        value := ""
        errors := [String]{}
        loop field in form.form.fields {
            if field.name == spec.name {
                value = ~field.value
                errors = ~field.errors
                break
            }
        }
        typ := "text"
        if spec.control == WebFormControl.Email -> typ = "email"
        if spec.control == WebFormControl.URL -> typ = "url"
        if spec.control == WebFormControl.Password -> typ = "password"
        if spec.control == WebFormControl.Number -> typ = "number"
        if spec.control == WebFormControl.Date -> typ = "date"
        if spec.control == WebFormControl.Checkbox -> typ = "checkbox"
        if spec.control == WebFormControl.Hidden -> typ = "hidden"
        req := ""
        if spec.required -> req = " required"
        checked := ""
        if spec.control == WebFormControl.Checkbox && (value == "true" || value == "1") -> checked = " checked"
        label := spec.label
        if label.len() == 0 -> label = spec.name
        out = "{out}<label>{esc(label)}<input name=\"{esc(spec.wire_name)}\" type=\"{typ}\" value=\"{esc(value)}\"{req}{checked}></label>"
        if errors.len() > 0 -> out = "{out}<span class=\"error\">{esc(errors[0])}</span>"
    }
    if form.form.form_error.len() > 0 -> out = "{out}<p class=\"error\">{esc(form.form.form_error)}</p>"
    "{out}<button type=\"submit\">Submit</button></form>"
}



fn render_html(form: WebForm) -> String Never! {
    out := "<form action=\"{esc(form.action)}\" method=\"{esc(form.method)}\">"
    loop field in form.fields {
        typ := "text"
        if field.value_type == WebFormValueType.Int || field.value_type == WebFormValueType.Float -> typ = "number"
        if field.value_type == WebFormValueType.Bool -> typ = "checkbox"
        req := ""
        if field.required -> req = " required"
        checked := ""
        if field.value_type == WebFormValueType.Bool && (field.value == "true" || field.value == "1") -> checked = " checked"
        out = "{out}<label>{esc(field.name)}<input name=\"{esc(field.name)}\" type=\"{typ}\" value=\"{esc(field.value)}\"{req}{checked}></label>"
        if field.errors.len() > 0 -> out = "{out}<span class=\"error\">{esc(field.errors[0])}</span>"
    }
    if form.form_error.len() > 0 -> out = "{out}<p class=\"error\">{esc(form.form_error)}</p>"
    "{out}<button type=\"submit\">Submit</button></form>"
}

fn valid_kind(kind: String) -> Bool Never! {
    kind == "string" || kind == "int" || kind == "bool" || kind == "float"
}

fn parse_kind(kind: String) -> WebFormValueType Never! {
    if kind == "int" -> return WebFormValueType.Int
    if kind == "bool" -> return WebFormValueType.Bool
    if kind == "float" -> return WebFormValueType.Float
    WebFormValueType.String
}

fn validation_error(field: WebFormFieldState) -> String Never! {
    if field.required && field.value.len() == 0 -> return "required"
    if field.value.len() == 0 -> return ""
    if field.value_type == WebFormValueType.Int && !is_int(field.value) -> return "int"
    if field.value_type == WebFormValueType.Float && !is_float(field.value) -> return "float"
    if field.value_type == WebFormValueType.Bool && !is_bool(field.value) -> return "bool"
    ""
}

fn apply_validation(form: &WebForm) -> Bool Never! {
    ok := true
    loop i in 0..<form.fields.len() {
        err := validation_error(form.fields[i])
        form.fields[i].errors = [String]{}
        if err.len() > 0 {
            &form.fields[i].errors.push(~err)
            ok = false
        }
        form.fields[i].touched = true
    }
    form.status = WebFormStatus.Dirty
    if !ok -> form.status = WebFormStatus.Invalid
    ok
}

fn validate_field_form(form: &WebForm, name: String) -> Bool Never! {
    loop i in 0..<form.fields.len() {
        if form.fields[i].name == name {
            err := validation_error(form.fields[i])
            form.fields[i].errors = [String]{}
            if err.len() > 0 -> &form.fields[i].errors.push(~err)
            form.fields[i].touched = true
            return err.len() == 0
        }
    }
    false
}


fn lifecycle(status: WebFormStatus) -> WebFormLifecycle {
    lifecycle_status := WebFormLifecycleStatus.Idle
    if status == WebFormStatus.Validating -> lifecycle_status = WebFormLifecycleStatus.Pending
    if status == WebFormStatus.Submitting -> lifecycle_status = WebFormLifecycleStatus.Submitting
    if status == WebFormStatus.Submitted -> lifecycle_status = WebFormLifecycleStatus.Success
    if status == WebFormStatus.Invalid || status == WebFormStatus.Error -> lifecycle_status = WebFormLifecycleStatus.Failure
    WebFormLifecycle{status: lifecycle_status, result: "", error: "", generation: 0}
}

fn status_name(status: WebFormStatus) -> String {
    if status == {
        WebFormStatus.Idle -> "idle"
        WebFormStatus.Dirty -> "dirty"
        WebFormStatus.Validating -> "validating"
        WebFormStatus.Invalid -> "invalid"
        WebFormStatus.Submitting -> "submitting"
        WebFormStatus.Submitted -> "submitted"
        else -> "error"
    }
}

fn copy_fields(fields: [WebFormFieldSpec]) -> [WebFormFieldSpec] Never! {
    out := [WebFormFieldSpec]{ }
    loop field in fields -> &out.push(field)
    out
}

fn states_from_specs(fields: [WebFormFieldSpec]) -> [WebFormFieldState] Never! {
    out := [WebFormFieldState]{}
    loop field in fields {
        value := ""
        if field.default != None -> value = field.default ?? ""
        &out.push(WebFormFieldState{name: field.name, value_type: field.value_type, required: field.required, value: value, touched: false, validating: false, errors: [String]{}})
    }
    out
}


fn decoded_from_input(form: WebFormTyped) -> WebFormDecodedInput {
    values := [String:String]{}
    wire_values := [String:String]{}
    loop spec in form.input.fields {
        value := ""
        loop field in form.form.fields {
            if field.name == spec.name {
                value = field.value
                break
            }
        }
        _ :: &values.add(~spec.name, ~value)
        _ :: &wire_values.add(~spec.wire_name, ~value)
    }
    WebFormDecodedInput{type_name: form.input.type_name, values: values, wire_values: wire_values}
}

fn encode_typed_input(input: WebFormInput, decoded: WebFormDecodedInput) -> String Never! {
    out := ""
    loop i in 0..<input.fields.len() {
        if i > 0 -> out = "{out}&"
        spec :: input.fields[i]
        value :: decoded.wire_values.get(spec.wire_name) ?? ""
        out = "{out}{url_encode(spec.wire_name)}={url_encode(value)}"
    }
    out
}

fn decode_typed_input(input: WebFormInput, body: String) -> WebFormDecodedInput? {
    states := states_from_specs(input.fields)
    seen := [String]{}
    if body.len() > 0 {
        pairs := split_amp(body)
        if pairs.len() > C_MAX_FORM_FIELDS -> return None
        loop pair in pairs {
            if pair.len() == 0 -> return None
            eq := find_byte(pair, 61)
            if eq <= 0 -> return None
            key := url_decode(slice_text(pair, 0, eq))
            value := url_decode(slice_text(pair, eq + 1, pair.len()))
            if !valid_name(key) || has_control_text(key) || has_control_text(value) || value.len() > C_MAX_FORM_TEXT -> return None
            if contains_name(seen, key) -> return None
            index := wire_index(input.fields, key)
            if index < 0 -> return None
            states[index].value = ~value
            &seen.push(~key)
        }
    }
    loop i in 0..<input.fields.len() {
        spec :: input.fields[i]
        if spec.required && !contains_name(seen, spec.wire_name) -> return None
    }
    values := [String:String]{}
    wire_values := [String:String]{}
    loop i in 0..<input.fields.len() {
        spec :: input.fields[i]
        value :: states[i].value
        _ :: &values.add(~spec.name, ~value)
        _ :: &wire_values.add(~spec.wire_name, ~value)
    }
    Val(WebFormDecodedInput{type_name: input.type_name, values: values, wire_values: wire_values})
}

fn wire_index(fields: [WebFormFieldSpec], wire_name: String) -> Int Never! {
    loop i in 0..<fields.len() {
        if fields[i].wire_name == wire_name -> return i
    }
    -1
}

fn find_byte(text: String, wanted: Int) -> Int Never! {
    raw := text.bytes()
    loop i in 0..<raw.len() {
        if Int.from_u8(raw[i]) == wanted -> return i
    }
    -1
}

fn split_amp(text: String) -> [String] Never! {
    out := [String]{ }
    start := 0
    raw := text.bytes()
    loop i in 0..<raw.len() {
        if raw[i] == (U8{38}) {
            &out.push(slice_text(text, start, i))
            start = i + 1
        }
    }
    if start <= raw.len() -> &out.push(slice_text(text, start, raw.len()))
    out
}

fn url_encode(text: String) -> String Never! {
    out := ""
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        if (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 45 || n == 46 || n == 95 || n == 126 {
            ch := String.from_bytes([U8]{b}) ?? ""
            out = "{out}{ch}"
        } else if n == 32 {
            out = "{out}+"
        } else {
            out = "{out}%{hex(n /% 16)}{hex(n %% 16)}"
        }
    }
    out
}

fn url_decode(text: String) -> String Never! {
    out := [U8]{}
    raw := text.bytes()
    i := 0
    loop {
        if i >= raw.len() -> return String.from_bytes(out) ?? text
        b :: raw[i]
        if b == (U8{43}) {
            &out.push(U8{32})
            i = i + 1
            next
        }
        if b == (U8{37}) && i + 2 < raw.len() {
            hi := hex_value(raw[i + 1])
            lo := hex_value(raw[i + 2])
            if hi >= 0 && lo >= 0 {
                &out.push(U8{hi * 16 + lo})
                i = i + 3
                next
            }
        }
        &out.push(b)
        i = i + 1
    }
}
fn valid_encoding(text: String) -> Bool Never! {
    raw := text.bytes()
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{37}) {
            if i + 2 >= raw.len() || hex_value(raw[i + 1]) < 0 || hex_value(raw[i + 2]) < 0 -> return false
            i = i + 3
        } else {
            i = i + 1
        }
    }
    true
}
fn fields_valid(fields: [WebFormFieldSpec]) -> Bool Never! {
    if fields.len() == 0 || fields.len() > C_MAX_FORM_FIELDS -> return false
    names := [String]{}
    wires := [String]{}
    loop field in fields {
        if !valid_name(field.name) || !valid_name(field.wire_name) -> return false
        if field.label.len() > C_MAX_FORM_TEXT -> return false
        if field.default == .Val(default) {
            if default.len() > C_MAX_FORM_TEXT || has_control_text(~default) -> return false
        }
        if contains_name(names, field.name) || contains_name(wires, field.wire_name) -> return false
        &names.push(field.name)
        &wires.push(field.wire_name)
    }
    true
}

fn valid_name(text: String) -> Bool Never! {
    raw := text.bytes()
    if raw.len() == 0 || raw.len() > 128 -> return false
    loop b in raw {
        n :: Int.from_u8(b)
        if n < 33 || n == 127 || n == 38 || n == 61 -> return false
    }
    true
}

fn contains_name(names: [String], value: String) -> Bool Never! {
    loop name in names {
        if name == value -> return true
    }
    false
}

fn has_control_text(text: String) -> Bool Never! {
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        if n < 32 || n == 127 -> return true
    }
    false
}

fn hex(n: Int) -> String Never! {
    digits := "0123456789ABCDEF"
    slice_text(digits, n, n + 1)
}

fn hex_value(b: U8) -> Int Never! {
    n :: Int.from_u8(b)
    if n >= 48 && n <= 57 -> return n - 48
    if n >= 65 && n <= 70 -> return n - 55
    if n >= 97 && n <= 102 -> return n - 87
    return -1
}

fn is_int(text: String) -> Bool Never! {
    raw := text.bytes()
    if raw.len() == 0 -> return false
    i := 0
    if raw[0] == (U8{45}) -> i = 1
    if i >= raw.len() -> return false
    loop i < raw.len() {
        if raw[i] < 48 || raw[i] > 57 -> return false
        i = i + 1
    }
    true
}

fn is_float(text: String) -> Bool Never! {
    raw := text.bytes()
    if raw.len() == 0 -> return false
    dots := 0
    digits := 0
    loop b in raw {
        if b == (U8{46}) -> dots = dots + 1 else if b >= 48 && b <= 57 -> digits = digits + 1 else -> return false
    }
    dots <= 1 && digits > 0
}

fn is_bool(text: String) -> Bool Never! { text == "true" || text == "false" || text == "1" || text == "0" }

fn esc(text: String) -> String Never! {
    raw := text.bytes()
    out := [U8]{ }
    loop b in raw {
        if b == 38 -> push_str(&out, "&amp;") else if b == 60 -> push_str(&out, "&lt;") else if b == 62 -> push_str(&out, "&gt;") else if b == 34 -> push_str(&out, "&quot;") else -> &out.push(b)
    }
    String.from_bytes(out) ?? ""
}

fn push_str(out: &[U8], value: String) Never! { loop b in value.bytes() -> &out.push(b) }

fn slice_text(text: String, start: Int, end: Int) -> String Never! {
    raw := text.bytes()
    out := [U8]{ }
    i := start
    loop {
        if i < 0 || i >= end || i >= raw.len() -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}
