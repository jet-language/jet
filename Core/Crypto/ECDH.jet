// SPDX-License-Identifier: Apache-2.0
// Translated from Mbed TLS 3.6.7 (library/ecdh.c); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: elliptic-curve Diffie-Hellman (SEC1 3.3.1).
//
// A port of mbedtls 3.6.7's ecdh.c in its default (non-legacy) context:
// the primitives and the TLS key-exchange context that writes and reads
// ServerECDHParams (RFC 8422 5.4) and the client's ECPoint.
use {
    core
    cipher: __core_crypto_cipher
    bn: __core_crypto_bignum
    __core_crypto_bignum.[RNG]
    ecp: __core_crypto_ecp
}

/// Which key get_params imports: ours (private and public) or the peer's
/// public point (mbedtls_ecdh_side).
ECDHSide: enum {
    Ours
    Theirs
}

/// An ECDH exchange (mbedtls_ecdh_context): the group, our key pair (d, Q),
/// the peer's point Qp and the shared secret z. grp_id is Unknown until
/// setup.
ECDHContext: struct {
    grp_id: ecp.GroupID
    point_format: ecp.PointFormat
    grp: ecp.EcpGroup
    d: bn.Mpi
    q: ecp.Point
    qp: ecp.Point
    z: bn.Mpi
}

/// A context with no group (mbedtls_ecdh_init).
ecdh_new: fn() -> ECDHContext Never! {
    ECDHContext{
        grp_id: ecp.GroupID.Unknown, point_format: ecp.PointFormat.Uncompressed, grp: ecp.empty_group(),
        d: bn.mpi(), q: ecp.point_new(), qp: ecp.point_new(), z: bn.mpi(),
    }
}

/// A private key d and public key d G (mbedtls_ecdh_gen_public).
ecdh_gen_public: fn<R: RNG>(grp: ecp.EcpGroup, rng: &R) -> (d: bn.Mpi, q: ecp.Point) ecp.EcpError! {
    d: ecp.gen_privkey(grp, rng)
    q: ecp.ecp_mul(grp, d, grp.g, rng)
    Ok((d: d, q: q))
}

/// The shared secret x(d Q), with the multiplication blinded from rng
/// (mbedtls_ecdh_compute_shared). BadInput when d Q is the point at
/// infinity.
ecdh_compute_shared: fn<R: RNG>(grp: ecp.EcpGroup, q: ecp.Point, d: bn.Mpi, rng: &R) -> bn.Mpi ecp.EcpError! {
    pt: ecp.ecp_mul(grp, d, q, rng)
    if ecp.is_zero(pt) -> return Err(.BadInput)
    Ok(bn.copy_mpi_ct(pt.x))
}

/// The context's curve; Unknown before setup (mbedtls_ecdh_get_grp_id).
ecdh_grp_id: fn(ctx: ECDHContext) -> ecp.GroupID Never! { ctx.grp_id }

/// Reset ctx for curve `id` (mbedtls_ecdh_setup): FeatureUnavailable for a
/// curve it cannot load.
ecdh_setup: fn(ctx: &ECDHContext, id: ecp.GroupID) ecp.EcpError! {
    ctx.point_format = .Uncompressed
    ctx.grp_id = id
    ctx.d = bn.mpi()
    ctx.q = ecp.point_new()
    ctx.qp = ecp.point_new()
    ctx.z = bn.mpi()
    ctx.grp = ecp.group_load(id) ?? {
        ctx.grp = ecp.empty_group()
        return Err(.FeatureUnavailable)
    }
}

/// A fresh key pair and the ServerECDHParams { ECParameters, ECPoint }
/// holding its public point, at most blen bytes (mbedtls_ecdh_make_params).
ecdh_make_params: fn<R: RNG>(ctx: &ECDHContext, blen: Int, rng: &R) -> [U8] ecp.EcpError! {
    if ctx.grp.pbits == 0 -> return Err(.BadInput)
    pair: ecdh_gen_public(ctx.grp, rng)
    ctx.d = pair.d.move()
    ctx.q = pair.q.move()
    out := ecp.tls_write_group(ctx.grp, blen)
    pt: ecp.tls_write_point(ctx.grp, ctx.q, ctx.point_format, blen - out.len())
    loop b in pt -> out.push(b)
    Ok(out)
}

/// Set ctx up from the ServerECDHParams at the start of buf and take its
/// point as the peer's (mbedtls_ecdh_read_params); the bytes read.
ecdh_read_params: fn(ctx: &ECDHContext, buf: [U8]) -> Int ecp.EcpError! {
    group: ecp.tls_read_group_id(buf)
    ecdh_setup(ctx, group.id)
    rest: cipher.bytes_of(buf, group.used, buf.len() - group.used)
    point: ecp.tls_read_point(ctx.grp, rest)
    ctx.qp = point.pt.move()
    Ok(group.used + point.used)
}

/// Import key into ctx: the whole pair as ours or the public point as the
/// peer's (mbedtls_ecdh_get_params). The first call sets up the context
/// for key's curve; later keys must be on the same curve, else BadInput.
ecdh_get_params: fn(ctx: &ECDHContext, key: ecp.Keypair, side: ECDHSide) ecp.EcpError! {
    if {
        ctx.grp_id == .Unknown -> ecdh_setup(ctx, key.grp.id)
        ctx.grp_id != key.grp.id -> return Err(.BadInput)
    }
    if side == {
        .Theirs -> ctx.qp = ecp.point_copy(key.q)
        .Ours -> {
            ctx.q = ecp.point_copy(key.q)
            ctx.d = bn.copy_mpi_ct(key.d)
        }
    }
}

/// A fresh key pair and the client's ECPoint of its public point, at most
/// blen bytes (mbedtls_ecdh_make_public).
ecdh_make_public: fn<R: RNG>(ctx: &ECDHContext, blen: Int, rng: &R) -> [U8] ecp.EcpError! {
    if ctx.grp.pbits == 0 -> return Err(.BadInput)
    pair: ecdh_gen_public(ctx.grp, rng)
    ctx.d = pair.d.move()
    ctx.q = pair.q.move()
    out: ecp.tls_write_point(ctx.grp, ctx.q, ctx.point_format, blen)
    Ok(out)
}

/// Take the client's ECPoint, exactly all of buf, as the peer's point
/// (mbedtls_ecdh_read_public).
ecdh_read_public: fn(ctx: &ECDHContext, buf: [U8]) ecp.EcpError! {
    point: ecp.tls_read_point(ctx.grp, buf)
    ctx.qp = point.pt.move()
    if point.used != buf.len() -> return Err(.BadInput)
}

/// The shared secret as the field size in bytes, little-endian on the
/// Montgomery curves (RFC 7748), at most blen bytes
/// (mbedtls_ecdh_calc_secret).
ecdh_calc_secret: fn<R: RNG>(ctx: &ECDHContext, blen: Int, rng: &R) -> [U8] ecp.EcpError! {
    if ctx.grp.pbits == 0 -> return Err(.BadInput)
    ctx.z = ecdh_compute_shared(ctx.grp, ctx.qp, ctx.d, rng)
    p_bytes: (ctx.grp.pbits + 7) /% 8
    if p_bytes > blen -> return Err(.BufferTooSmall)
    if ecp.group_type(ctx.grp) == .Montgomery {
        le: bn.write_binary_le(ctx.z, p_bytes) ?? return Err(.Mpi(err))
        return Ok(le)
    }
    be: bn.write_binary(ctx.z, p_bytes) ?? return Err(.Mpi(err))
    Ok(be)
}
