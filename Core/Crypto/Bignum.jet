// SPDX-License-Identifier: Apache-2.0
// Translated from Mbed TLS 3.6.7 (library/bignum_core.c, library/bignum.c); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: multi-precision integers.
//
// A port of mbedtls 3.6.7's bignum_core.c (fixed-width limb arithmetic) and
// bignum.c (signed, growable integers):
// - Schoolbook multiplication (HAC 14.12) and long division (HAC 14.20,
//   Knuth TAOCP vol. 2 section 4.3.1 algorithm D for the two-limb step).
// - Montgomery multiplication (HAC 14.36) and fixed-window exponentiation
//   (HAC 14.82), constant time in the exponent unless it is public.
// - Constant-time GCD and modular inverse for an odd modulus (Ide, Takagi
//   et al., "Efficient constant-time GCD and modular inversion", IEICE
//   Trans. Inf. & Syst. E106.D(9), 2023, algorithms 7 and 8).
// - Miller-Rabin primality (HAC 4.24, FIPS 186-4 appendix C.3) and prime
//   generation (FIPS 186-4 appendix B.3.3).
//
// Limbs are 64 bits, least significant first. The helpers documented as
// constant time compute every condition as a mask from arithmetic, never
// with a branch or an index that depends on the operands, as mbedtls's
// constant_time_internal.h does.
use {
    core
    cipher: __core_crypto_cipher
}

LIMB_BITS: 64
LIMB_BYTES: 8
/// MBEDTLS_MPI_MAX_LIMBS: the most limbs a number may grow to.
MAX_LIMBS: 10000
/// MBEDTLS_MPI_MAX_BITS: the widest exponent and modulus `exp_mod` takes.
MAX_BITS: 8192
/// MBEDTLS_MPI_WINDOW_SIZE: the widest exponentiation window.
WINDOW_SIZE: 3
/// MBEDTLS_MPI_RW_BUFFER_SIZE: the line buffer of `read_file_data` and
/// `write_file_text`, room for a MAX_BITS decimal number and a short label.
RW_BUFFER_SIZE: 2484

/// Why a big-number operation failed (MBEDTLS_ERR_MPI_*).
#Error
MpiError: enum {
    /// An argument outside the function's domain.
    BadInput
    /// A digit outside the radix.
    InvalidCharacter
    /// The output is too small for the value.
    BufferTooSmall
    /// The result would be negative where only non-negative values exist.
    NegativeValue
    DivisionByZero
    /// The value lacks the asked-for property: no inverse exists, it is not
    /// prime, or no draw landed in range.
    NotAcceptable
    /// The number would need more than MAX_LIMBS limbs.
    AllocFailed
    /// The random source failed.
    Random
    /// The file text holds no line to read (MBEDTLS_ERR_MPI_FILE_IO_ERROR).
    FileIO
}

/// The random source of the drawing functions (mbedtls's f_rng and p_rng).
/// `fill` writes `out.len()` random bytes and reports whether it could.
RNG: trait {
    fill: fn(&self, out: &[U8]) -[]> Bool Never!
}

// ---------------------------------------------------------------------------
// Constant-time primitives. Each condition is the low bit of a U64.

/// 1 when x is not zero.
#Policy(arithmetic: .Wrapping)
ct_bool: fn(x: U64) -> U64 Never! { x.bit_or(U64{0} - x) >> 63 }

/// 1 when a < b: the borrow out of a - b (Hacker's Delight 2-13).
#Policy(arithmetic: .Wrapping)
ct_lt: fn(a: U64, b: U64) -> U64 Never! {
    na: a.bit_not()
    na.bit_and(b).bit_or(na.bit_or(b).bit_and(a - b)) >> 63
}

/// All ones when the condition bit is 1, else zero.
#Policy(arithmetic: .Wrapping)
ct_mask: fn(bit: U64) -> U64 Never! { U64{0} - bit }

/// a when mask is all ones, b when it is zero.
ct_select: fn(mask: U64, a: U64, b: U64) -> U64 Never! { b.bit_xor(mask.bit_and(a.bit_xor(b))) }

/// The 128-bit product of a and b as its high and low halves, from four
/// 32-bit partial products.
#Policy(arithmetic: .Wrapping)
mul_wide: fn(a: U64, b: U64) -> (hi: U64, lo: U64) Never! {
    m: U64{0xffffffff}
    a0: a.bit_and(m)
    a1: a >> 32
    b0: b.bit_and(m)
    b1: b >> 32
    p00: a0 * b0
    p01: a0 * b1
    p10: a1 * b0
    p11: a1 * b1
    mid: (p00 >> 32) + p01.bit_and(m) + p10.bit_and(m)
    (hi: p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32), lo: (mid << 32).bit_or(p00.bit_and(m)))
}

copy_limbs: fn(dst: &[U64], src: [U64], limbs: Int) Never! {
    loop i in 0..<limbs -> dst[i] = src[i]
}

zero_limbs: fn(x: &[U64], limbs: Int) Never! {
    loop i in 0..<limbs -> x[i] = U64{0}
}

// ---------------------------------------------------------------------------
// The core layer: fixed-width numbers of `limbs` limbs (bignum_core.c).

/// The leading zero bits of a limb; 64 for zero.
core_clz: fn(a: U64) -> Int Never! { a.leading_zeros() }

/// The bit length of the first `limbs` limbs of a.
core_bitlen: fn(a: [U64], limbs: Int) -> Int Never! {
    i := limbs - 1
    loop i >= 0 {
        if a[i] != (U64{0}) -> return i * LIMB_BITS + LIMB_BITS - core_clz(a[i])
        i -= 1
    }
    0
}

/// 1 when min <= a, in constant time; `limbs` must be at least 1.
core_uint_le_mpi: fn(min: U64, a: [U64], limbs: Int) -> U64 Never! {
    min_le_lsl: ct_lt(a[0], min).bit_xor(U64{1})
    msll := U64{0}
    loop i in 1..<limbs -> msll = msll.bit_or(ct_bool(a[i]))
    msll.bit_or(min_le_lsl)
}

/// 1 when a < b, both of `limbs` limbs, in constant time.
core_lt_ct: fn(a: [U64], b: [U64], limbs: Int) -> U64 Never! {
    ret := U64{0}
    done := U64{0}
    i := limbs
    loop i > 0 {
        gt: ct_lt(b[i - 1], a[i - 1])
        done = done.bit_or(gt)
        lt: ct_lt(a[i - 1], b[i - 1])
        ret = ret.bit_or(lt.bit_and(done.bit_xor(U64{1})))
        done = done.bit_or(lt)
        i -= 1
    }
    ret
}

/// 1 when a has a bit set above bit `pos`, in constant time.
core_bits_above: fn(a: [U64], pos: Int) -> U64 Never! {
    seen := U64{0}
    loop i in 0..<a.len() {
        low: i * LIMB_BITS
        if low > pos {
            seen = seen.bit_or(a[i])
        } else if low + LIMB_BITS > pos + 1 {
            seen = seen.bit_or(a[i] >> (pos - low + 1))
        }
    }
    ct_bool(seen)
}

/// x = a when `assign` is 1, in constant time.
core_cond_assign: fn(x: &[U64], a: [U64], limbs: Int, assign: U64) Never! {
    mask: ct_mask(assign)
    loop i in 0..<limbs -> x[i] = ct_select(mask, a[i], x[i])
}

/// Swap x and y when `swap` is 1, in constant time.
core_cond_swap: fn(x: &[U64], y: &[U64], limbs: Int, swap: U64) Never! {
    mask: ct_mask(swap)
    loop i in 0..<limbs {
        t: x[i]
        x[i] = ct_select(mask, y[i], t)
        y[i] = ct_select(mask, t, y[i])
    }
}

/// Byte i (little-endian) of the number in a.
get_byte: fn(a: [U64], i: Int) -> U8 Never! {
    wrapping(U8{a[i /% LIMB_BYTES] >> ((i % LIMB_BYTES) * 8)})
}

/// Little-endian `input` into the `x_limbs` limbs of x.
core_read_le: fn(x: &[U64], x_limbs: Int, input: [U8]) MpiError! {
    if x_limbs < (input.len() + LIMB_BYTES - 1) /% LIMB_BYTES -> return Err(.BufferTooSmall)
    zero_limbs(x, x_limbs)
    loop i in 0..<input.len() -> x[i /% LIMB_BYTES] = x[i /% LIMB_BYTES].bit_or(U64.from_u8(input[i]) << ((i % LIMB_BYTES) * 8))
}

/// Big-endian `input` into the `x_limbs` limbs of x.
core_read_be: fn(x: &[U64], x_limbs: Int, input: [U8]) MpiError! {
    n: input.len()
    if x_limbs < (n + LIMB_BYTES - 1) /% LIMB_BYTES -> return Err(.BufferTooSmall)
    zero_limbs(x, x_limbs)
    loop i in 0..<n -> x[i /% LIMB_BYTES] = x[i /% LIMB_BYTES].bit_or(U64.from_u8(input[n - 1 - i]) << ((i % LIMB_BYTES) * 8))
}

/// The number in a's first `a_limbs` limbs as `out_len` little-endian bytes.
/// When out_len is the shorter, the dropped bytes must be zero.
core_write_le: fn(a: [U64], a_limbs: Int, out_len: Int) -> [U8] MpiError! {
    stored: a_limbs * LIMB_BYTES
    if !core_fits(a, a_limbs, out_len) -> return Err(.BufferTooSmall)
    out := cipher.zero_bytes(out_len)
    loop i in 0..<(if stored < out_len -> stored else -> out_len) -> out[i] = get_byte(a, i)
    Ok(out)
}

/// The number in a's first `a_limbs` limbs as `out_len` big-endian bytes.
core_write_be: fn(a: [U64], a_limbs: Int, out_len: Int) -> [U8] MpiError! {
    stored: a_limbs * LIMB_BYTES
    if !core_fits(a, a_limbs, out_len) -> return Err(.BufferTooSmall)
    out := cipher.zero_bytes(out_len)
    loop i in 0..<(if stored < out_len -> stored else -> out_len) -> out[out_len - 1 - i] = get_byte(a, i)
    Ok(out)
}

/// Whether the number in a's first `a_limbs` limbs fits `out_len` bytes,
/// read in constant time. Callers write a value below a modulus of that many
/// bytes, so the verdict is fixed by construction; a larger value gets
/// BufferTooSmall, as from mbedtls.
core_fits: fn(a: [U64], a_limbs: Int, out_len: Int) -> Bool Never! {
    stored: a_limbs * LIMB_BYTES
    if stored <= out_len -> return true
    extra := U8{0}
    loop i in out_len..<stored -> extra = extra.bit_or(get_byte(a, i))
    extra == U8{0}
}

/// x >>= count over `limbs` limbs.
core_shift_r: fn(x: &[U64], limbs: Int, count: Int) Never! {
    v0: count /% LIMB_BITS
    v1: count % LIMB_BITS
    if v0 > limbs || (v0 == limbs && v1 > 0) {
        zero_limbs(x, limbs)
        return
    }
    if v0 > 0 {
        loop i in 0..<limbs - v0 -> x[i] = x[i + v0]
        loop i in limbs - v0..<limbs -> x[i] = U64{0}
    }
    if v1 > 0 {
        r0 := U64{0}
        i := limbs
        loop i > 0 {
            r1: x[i - 1] << (LIMB_BITS - v1)
            x[i - 1] = (x[i - 1] >> v1).bit_or(r0)
            r0 = r1
            i -= 1
        }
    }
}

/// x <<= count over `limbs` limbs; bits shifted past the top are lost.
core_shift_l: fn(x: &[U64], limbs: Int, count: Int) Never! {
    v0: count /% LIMB_BITS
    v1: count % LIMB_BITS
    if v0 > 0 {
        i := limbs
        loop i > v0 {
            x[i - 1] = x[i - v0 - 1]
            i -= 1
        }
        loop i > 0 {
            x[i - 1] = U64{0}
            i -= 1
        }
    }
    if v1 > 0 && v0 < limbs {
        r0 := U64{0}
        loop i in v0..<limbs {
            r1: x[i] >> (LIMB_BITS - v1)
            x[i] = (x[i] << v1).bit_or(r0)
            r0 = r1
        }
    }
}

/// x = a + b over `limbs` limbs; the carry out.
#Policy(arithmetic: .Wrapping)
core_add: fn(x: &[U64], a: [U64], b: [U64], limbs: Int) -> U64 Never! {
    c := U64{0}
    loop i in 0..<limbs {
        t: c + a[i]
        c = ct_lt(t, a[i])
        s: t + b[i]
        c += ct_lt(s, b[i])
        x[i] = s
    }
    c
}

/// x += a over `limbs` limbs when `cond` is 1, in constant time; the carry.
#Policy(arithmetic: .Wrapping)
core_add_if: fn(x: &[U64], a: [U64], limbs: Int, cond: U64) -> U64 Never! {
    mask: ct_mask(cond)
    c := U64{0}
    loop i in 0..<limbs {
        add: a[i].bit_and(mask)
        t: c + x[i]
        c = ct_lt(t, x[i])
        s: t + add
        c += ct_lt(s, add)
        x[i] = s
    }
    c
}

/// x = a - b over `limbs` limbs; the borrow out.
#Policy(arithmetic: .Wrapping)
core_sub: fn(x: &[U64], a: [U64], b: [U64], limbs: Int) -> U64 Never! {
    c := U64{0}
    loop i in 0..<limbs {
        z: ct_lt(a[i], c)
        t: a[i] - c
        c = ct_lt(t, b[i]) + z
        x[i] = t - b[i]
    }
    c
}

/// x = a - c over `limbs` limbs for one limb c; the borrow out.
#Policy(arithmetic: .Wrapping)
core_sub_int: fn(x: &[U64], a: [U64], c: U64, limbs: Int) -> U64 Never! {
    borrow := c
    loop i in 0..<limbs {
        s: a[i]
        t: s - borrow
        borrow = ct_lt(s, t)
        x[i] = t
    }
    borrow
}

/// d[off..<off + d_len] += s[0..<s_len] * b; the carry out. d_len must be at
/// least s_len; a shorter d gives a wrong result, never a write past it.
#Policy(arithmetic: .Wrapping)
core_mla: fn(d: &[U64], off: Int, d_len: Int, s: [U64], s_len: Int, b: U64) -> U64 Never! {
    n: if d_len < s_len -> d_len else -> s_len
    c := U64{0}
    loop i in 0..<n {
        p: mul_wide(s[i], b)
        lo: p.lo + c
        hi := p.hi + ct_lt(lo, c)
        r: d[off + i] + lo
        hi += ct_lt(r, lo)
        d[off + i] = r
        c = hi
    }
    loop i in n..<d_len {
        r: d[off + i] + c
        c = ct_lt(r, c)
        d[off + i] = r
    }
    c
}

/// x = a * b, x of a_limbs + b_limbs limbs.
core_mul: fn(x: &[U64], a: [U64], a_limbs: Int, b: [U64], b_limbs: Int) Never! {
    zero_limbs(x, a_limbs + b_limbs)
    loop i in 0..<b_limbs -> _: core_mla(x, i, a_limbs + 1, a, a_limbs, b[i])
}

/// -n^-1 mod 2^64 for odd n[0], by Newton iteration (Tom St Denis).
#Policy(arithmetic: .Wrapping)
core_montmul_init: fn(n: [U64]) -> U64 Never! {
    x := n[0]
    x += (n[0] + U64{2}).bit_and(U64{4}) << 1
    loop _ in 0..<4 -> x *= U64{2} - n[0] * x
    U64{0} - x
}

/// x = a * b * R^-1 mod n, R = 2^(64 * an_limbs) (HAC 14.36). a and n have
/// an_limbs limbs, b has b_limbs <= an_limbs, and a * b < R * n. t is
/// scratch of at least 2 * an_limbs + 1 limbs. The final subtraction always
/// runs and its result is chosen by mask.
#Policy(arithmetic: .Wrapping)
core_montmul: fn(x: &[U64], a: [U64], b: [U64], b_limbs: Int, n: [U64], an_limbs: Int, mm: U64, t: &[U64]) Never! {
    zero_limbs(t, 2 * an_limbs + 1)
    loop i in 0..<an_limbs {
        u0: a[i]
        u1: (t[i] + u0 * b[0]) * mm
        _: core_mla(t, i, an_limbs + 2, b, b_limbs, u0)
        _: core_mla(t, i, an_limbs + 2, n, an_limbs, u1)
    }
    // T is now t[an_limbs..]; move it down so the subtraction reads it from 0.
    loop j in 0..<an_limbs + 1 -> t[j] = t[an_limbs + j]
    carry: t[an_limbs]
    borrow: core_sub(x, t, n, an_limbs)
    // T < N: (0, 1), keep T. N <= T < R: (0, 0), and T >= R: (1, 1), keep
    // T - N. (1, 0) cannot happen.
    core_cond_assign(x, t, an_limbs, carry.bit_xor(borrow))
}

/// R^2 mod n, R = 2^(64 * n.p.len()), in exactly n.p.len() limbs or more.
core_get_mont_r2_unsafe: fn(n: Mpi) -> Mpi MpiError! {
    x := from_int(1)
    shift_l(x, n.p.len() * 2 * LIMB_BITS) ?? return Err(err)
    r := mod_mpi(x, n) ?? return Err(err)
    shrink(r, n.p.len()) ?? return Err(err)
    Ok(r)
}

/// dest = table[index] of `count` entries of `limbs` limbs, reading every
/// entry so the index never shows in the access pattern.
core_ct_uint_table_lookup: fn(dest: &[U64], table: [U64], limbs: Int, count: Int, index: U64) Never! {
    loop i in 0..<count {
        mask: ct_mask(ct_bool(U64{i}.bit_xor(index)).bit_xor(U64{1}))
        loop j in 0..<limbs -> dest[j] = ct_select(mask, table[i * limbs + j], dest[j])
    }
}

/// n_bytes random bytes read as a big-endian number into x's `x_limbs`
/// limbs. The byte order is the one RFC 6979 section 3.3 expects of a
/// deterministic ECDSA nonce. A failed draw leaves neither its bytes nor
/// a partial x behind.
core_fill_random: fn<R: RNG>(x: &[U64], x_limbs: Int, n_bytes: Int, rng: &R) MpiError! {
    if x_limbs < (n_bytes + LIMB_BYTES - 1) /% LIMB_BYTES -> return Err(.BadInput)
    buf := cipher.zero_bytes(n_bytes)
    if !rng.fill(buf) {
        core.crypto.wipe(buf)
        return Err(.Random)
    }
    core_read_be(x, x_limbs, buf) ?? {
        core.crypto.wipe(buf)
        cipher.wipe_words(x)
        return Err(err)
    }
    core.crypto.wipe(buf)
}

/// A uniform draw min <= x < n over `limbs` limbs, by rejection: the leftmost
/// bitlen(n) bits of each fill, as RFC 6979 section 3.3 does. A failure
/// leaves no rejected draw in x.
core_random: fn<R: RNG>(x: &[U64], min: U64, n: [U64], limbs: Int, rng: &R) MpiError! {
    n_bits: core_bitlen(n, limbs)
    n_bytes: (n_bits + 7) /% 8
    // When n is crypto-sized one try almost always lands; a small n needs
    // many more to keep the failure probability negligible.
    count := if n_bytes > 4 -> 30 else -> 250
    loop {
        core_fill_random(x, limbs, n_bytes, rng) ?? {
            cipher.wipe_words(x)
            return Err(err)
        }
        core_shift_r(x, limbs, 8 * n_bytes - n_bits)
        count -= 1
        if count == 0 {
            cipher.wipe_words(x)
            return Err(.NotAcceptable)
        }
        if draw_in_range(x, min, n, limbs) -> return
    }
}

/// Whether a rejection-sampling draw is in [min, n), read in constant time.
/// A rejected draw is thrown away and an accepted one says only that it is
/// in range, so the verdict is public.
draw_in_range: fn(x: [U64], min: U64, n: [U64], limbs: Int) -> Bool Never! {
    core_uint_le_mpi(min, x, limbs).bit_and(core_lt_ct(x, n, limbs)) == U64{1}
}

/// The window width of exponentiation for an exponent of `ebits` bits.
exp_mod_window: fn(ebits: Int) -> Int Never! { if ebits > 79 -> WINDOW_SIZE else -> 1 }

/// x = a^e mod n with a in Montgomery form and the result in Montgomery
/// form. a and n have an_limbs limbs; rr is R^2 mod n. The exponent's bits
/// are read from bit `start_bit` of limb `start_limb` of e down: a secret
/// exponent starts past its top limb (limb e.len(), bit 0), so every limb
/// is processed. Each window is chosen by a full table scan, so the time
/// and access pattern depend only on the start. Left-to-right k-ary
/// exponentiation, one bit per step (HAC 14.82).
core_exp_mod: fn(x: &[U64], a: [U64], n: [U64], an_limbs: Int, e: [U64], start_limb: Int, start_bit: Int, rr: [U64]) Never! {
    limb_index := start_limb
    bit_index := start_bit
    wsize: exp_mod_window(limb_index * LIMB_BITS)
    welem: 1 << wsize
    mm: core_montmul_init(n)
    table := cipher.words(welem * an_limbs)
    selected := cipher.words(an_limbs)
    temp := cipher.words(2 * an_limbs + 1)
    row := cipher.words(an_limbs)
    prev := cipher.words(an_limbs)
    // W[0] = 1 and W[1] = A in Montgomery form; W[i] = W[i - 1] * W[1].
    one := cipher.words(an_limbs)
    one[0] = U64{1}
    core_montmul(row, one, rr, an_limbs, n, an_limbs, mm, temp)
    loop j in 0..<an_limbs -> table[j] = row[j]
    loop j in 0..<an_limbs -> table[an_limbs + j] = a[j]
    copy_limbs(prev, a, an_limbs)
    loop i in 2..<welem {
        core_montmul(row, prev, a, an_limbs, n, an_limbs, mm, temp)
        loop j in 0..<an_limbs -> table[i * an_limbs + j] = row[j]
        copy_limbs(prev, row, an_limbs)
    }
    loop j in 0..<an_limbs -> x[j] = table[j]
    window_bits := 0
    window := U64{0}
    loop {
        copy_limbs(prev, x, an_limbs)
        core_montmul(x, prev, prev, an_limbs, n, an_limbs, mm, temp)
        if bit_index == 0 {
            limb_index -= 1
            bit_index = LIMB_BITS - 1
        } else {
            bit_index -= 1
        }
        window_bits += 1
        window = (window << 1).bit_or((e[limb_index] >> bit_index).bit_and(U64{1}))
        last: bit_index == 0 && limb_index == 0
        if window_bits == wsize || last {
            core_ct_uint_table_lookup(selected, table, an_limbs, welem, window)
            copy_limbs(prev, x, an_limbs)
            core_montmul(x, prev, selected, an_limbs, n, an_limbs, mm, temp)
            window = U64{0}
            window_bits = 0
        }
        if last -> break
    }
    cipher.wipe_words(table)
    cipher.wipe_words(selected)
    cipher.wipe_words(temp)
    cipher.wipe_words(row)
    cipher.wipe_words(prev)
}

/// 1 when any of a's first `limbs` limbs is not zero, in constant time.
core_check_zero_ct: fn(a: [U64], limbs: Int) -> U64 Never! {
    bits := U64{0}
    loop i in 0..<limbs -> bits = bits.bit_or(a[i])
    ct_bool(bits)
}

/// x = a * R mod n, given rr = R^2 mod n.
core_to_mont_rep: fn(x: &[U64], a: [U64], n: [U64], an_limbs: Int, mm: U64, rr: [U64], t: &[U64]) Never! {
    core_montmul(x, a, rr, an_limbs, n, an_limbs, mm, t)
}

/// x = a * R^-1 mod n.
core_from_mont_rep: fn(x: &[U64], a: [U64], n: [U64], an_limbs: Int, mm: U64, t: &[U64]) Never! {
    core_montmul(x, a, [U64]{U64{1}}, 1, n, an_limbs, mm, t)
}

/// x = a - b mod n with a and b in [0, n).
core_sub_mod: fn(x: &[U64], a: [U64], b: [U64], n: [U64], limbs: Int) Never! {
    c: core_sub(x, a, b, limbs)
    _: core_add_if(x, n, limbs, c)
}

/// x = a + b mod n with a and b in [0, n).
core_add_mod: fn(x: &[U64], a: [U64], b: [U64], n: [U64], limbs: Int) Never! {
    sum := cipher.words(limbs)
    carry: core_add(sum, a, b, limbs)
    borrow: core_sub(x, sum, n, limbs)
    // a + b < n: (0, 1), keep the sum; otherwise keep a + b - n, as in
    // core_montmul.
    core_cond_assign(x, sum, limbs, carry.bit_xor(borrow))
    cipher.wipe_words(sum)
}

/// x = a * b mod n for a < R and b < n, all of an_limbs limbs: the
/// Montgomery product a b R^-1, then its product with rr = R^2 mod n.
core_mul_mod: fn(x: &[U64], a: [U64], b: [U64], n: [U64], an_limbs: Int, mm: U64, rr: [U64], t: &[U64]) Never! {
    ab := cipher.words(an_limbs)
    core_montmul(ab, a, b, an_limbs, n, an_limbs, mm, t)
    core_montmul(x, ab, rr, an_limbs, n, an_limbs, mm, t)
    cipher.wipe_words(ab)
}

/// x = a * R mod n for any a of a_limbs limbs, given rr = R^2 mod n: Horner
/// over a's an_limbs-limb chunks from the top, x = x R + chunk R mod n by
/// two Montgomery products and a modular sum each, so no division and no
/// test of a's or n's limbs.
core_to_mont_rep_wide: fn(x: &[U64], a: [U64], a_limbs: Int, n: [U64], an_limbs: Int, mm: U64, rr: [U64], t: &[U64]) Never! {
    zero_limbs(x, an_limbs)
    chunk := cipher.words(an_limbs)
    high := cipher.words(an_limbs)
    low := cipher.words(an_limbs)
    k := (a_limbs + an_limbs - 1) /% an_limbs
    loop k > 0 {
        k -= 1
        loop j in 0..<an_limbs {
            at: k * an_limbs + j
            chunk[j] = if at < a_limbs -> a[at] else -> U64{0}
        }
        copy_limbs(low, x, an_limbs)
        core_montmul(high, low, rr, an_limbs, n, an_limbs, mm, t)
        core_montmul(low, chunk, rr, an_limbs, n, an_limbs, mm, t)
        core_add_mod(x, high, low, n, an_limbs)
    }
    cipher.wipe_words(chunk)
    cipher.wipe_words(high)
    cipher.wipe_words(low)
}

/// x = a mod n for any a of a_limbs limbs, in n's an_limbs limbs, given
/// rr = R^2 mod n: into Montgomery form by core_to_mont_rep_wide and out
/// again, with no division.
core_mod_wide: fn(x: &[U64], a: [U64], a_limbs: Int, n: [U64], an_limbs: Int, mm: U64, rr: [U64], t: &[U64]) Never! {
    m := cipher.words(an_limbs)
    core_to_mont_rep_wide(m, a, a_limbs, n, an_limbs, mm, rr, t)
    core_from_mont_rep(x, m, n, an_limbs, mm, t)
    cipher.wipe_words(m)
}

/// R^2 mod n, R = 2^(64 * n.p.len()), in n.p.len() limbs, for odd n: 1 mod
/// n doubled mod n 2 * 64 * n.p.len() times, each doubling's reduction
/// chosen by mask, so a secret modulus (a CRT prime) shows nothing.
core_get_mont_r2_ct: fn(n: Mpi) -> Mpi MpiError! {
    an: n.p.len()
    x := zeros(an) ?? return Err(err)
    // 1 mod n: 0 when n is 1.
    x.p[0] = core_uint_le_mpi(U64{2}, n.p, an)
    d := cipher.words(an)
    loop _ in 0..<(2 * an * LIMB_BITS) {
        carry := U64{0}
        loop i in 0..<an {
            d[i] = (x.p[i] << 1).bit_or(carry)
            carry = x.p[i] >> 63
        }
        borrow: core_sub(x.p, d, n.p, an)
        core_cond_assign(x.p, d, an, carry.bit_xor(borrow))
    }
    cipher.wipe_words(d)
    Ok(x)
}

/// x = x / 2 mod n for odd n and x in [0, n): add n first when x is odd.
core_div2_mod_odd: fn(x: &[U64], n: [U64], limbs: Int) Never! {
    c: core_add_if(x, n, limbs, x[0].bit_and(U64{1}))
    core_shift_r(x, limbs, 1)
    x[limbs - 1] = x[limbs - 1].bit_or(c << 63)
}

/// g = gcd(a, n) and, with `inverse`, i = a^-1 mod n when g is 1, in
/// constant time, for odd n and a <= n (a of a_limbs <= n_limbs limbs).
/// g and i get n_limbs limbs. The binary algorithm of Ide et al. (algorithm
/// 8 made readable): each step keeps one of u, v and v - u, halves another
/// and drops the third, mirroring the moves on the cofactors q and r mod n;
/// bitlen(a) + bitlen(n) steps reach the fixed point u = 0, v = gcd.
core_gcd_modinv_odd: fn(g: &[U64], i: &[U64], inverse: Bool, a: [U64], a_limbs: Int, n: [U64], n_limbs: Int) Never! {
    an: if a_limbs > n_limbs -> n_limbs else -> a_limbs
    u := cipher.words(n_limbs)
    copy_limbs(u, a, an)
    v := cipher.words(n_limbs)
    copy_limbs(v, n, n_limbs)
    d := cipher.words(n_limbs)
    t1 := cipher.words(n_limbs)
    t2 := cipher.words(n_limbs)
    q := cipher.words(n_limbs)
    r := cipher.words(n_limbs)
    r[0] = U64{1}
    loop _ in 0..<(an + n_limbs) * LIMB_BITS {
        u_odd: u[0].bit_and(U64{1})
        v_odd: v[0].bit_and(U64{1})
        u_odd_v_odd: u_odd.bit_and(v_odd)
        u_odd_v_even: u_odd.bit_and(v_odd.bit_xor(U64{1}))
        // u <= v, so v - u never borrows.
        _: core_sub(d, v, u, n_limbs)
        copy_limbs(t1, d, n_limbs)
        core_cond_assign(t1, u, n_limbs, u_odd_v_odd)
        copy_limbs(t2, u, n_limbs)
        core_cond_assign(t2, v, n_limbs, u_odd_v_even)
        core_cond_assign(t2, d, n_limbs, u_odd_v_odd)
        core_shift_r(t2, n_limbs, 1)
        copy_limbs(u, t1, n_limbs)
        copy_limbs(v, t2, n_limbs)
        swap: core_lt_ct(v, u, n_limbs)
        core_cond_swap(u, v, n_limbs, swap)
        if inverse {
            core_sub_mod(d, q, r, n, n_limbs)
            copy_limbs(t1, d, n_limbs)
            core_cond_assign(t1, r, n_limbs, u_odd_v_odd)
            copy_limbs(t2, r, n_limbs)
            core_cond_assign(t2, q, n_limbs, u_odd_v_even)
            core_cond_assign(t2, d, n_limbs, u_odd_v_odd)
            core_div2_mod_odd(t2, n, n_limbs)
            copy_limbs(r, t1, n_limbs)
            copy_limbs(q, t2, n_limbs)
            core_cond_swap(r, q, n_limbs, swap)
        }
    }
    copy_limbs(g, v, n_limbs)
    if inverse -> copy_limbs(i, q, n_limbs)
    cipher.wipe_words(u)
    cipher.wipe_words(v)
    cipher.wipe_words(d)
    cipher.wipe_words(t1)
    cipher.wipe_words(t2)
    cipher.wipe_words(q)
    cipher.wipe_words(r)
}

// ---------------------------------------------------------------------------
// Signed numbers (bignum.c).

/// A signed multi-precision integer (mbedtls_mpi). `s` is 1 or -1, and -1
/// only for a non-zero value. `p` holds the magnitude, least significant
/// limb first; its length is the allocated limb count, so zero may have any
/// number of limbs, none included. Closing wipes the limbs.
Mpi: struct {
    s: Int
    p: [U64]
}

impl Mpi.Close {
    close: fn(&&self) {
        p := self.p.move()
        cipher.wipe_words(p)
    }
}

/// Zero with no limbs (mbedtls_mpi_init).
mpi: fn() -> Mpi Never! { Mpi{s: 1, p: [U64]{}} }

/// |z| as a limb, the most negative Int64 included.
#Policy(arithmetic: .Wrapping)
sint_abs: fn(z: Int) -> U64 Never! {
    if z >= 0 -> return U64{z}
    U64{-(z + 1)} + U64{1}
}

/// z in one limb (mbedtls_mpi_lset on a fresh number).
from_int: fn(z: Int) -> Mpi Never! {
    p := cipher.words(1)
    p[0] = sint_abs(z)
    Mpi{s: if z < 0 -> -1 else -> 1, p: p}
}

/// Grow x to at least `limbs` limbs. The old storage is wiped.
grow: fn(x: &Mpi, limbs: Int) MpiError! {
    if limbs > MAX_LIMBS -> return Err(.AllocFailed)
    if x.p.len() >= limbs -> return
    p := cipher.words(limbs)
    copy_limbs(p, x.p, x.p.len())
    cipher.wipe_words(x.p)
    x.p = p
}

/// Shrink x to its significant limbs but at least `limbs`; grow it when it
/// has fewer.
shrink: fn(x: &Mpi, limbs: Int) MpiError! {
    if limbs > MAX_LIMBS -> return Err(.AllocFailed)
    if x.p.len() <= limbs -> return grow(x, limbs)
    i := x.p.len() - 1
    loop i > 0 && x.p[i] == (U64{0}) -> i -= 1
    keep: if i + 1 < limbs -> limbs else -> i + 1
    p := cipher.words(keep)
    copy_limbs(p, x.p, keep)
    cipher.wipe_words(x.p)
    x.p = p
}

/// Zero in exactly `limbs` limbs.
zeros: fn(limbs: Int) -> Mpi MpiError! {
    if limbs > MAX_LIMBS -> return Err(.AllocFailed)
    Ok(Mpi{s: 1, p: cipher.words(limbs)})
}

/// The count of x's limbs up to its most significant non-zero one.
used_limbs: fn(x: Mpi) -> Int Never! {
    i := x.p.len()
    loop i > 0 && x.p[i - 1] == (U64{0}) -> i -= 1
    i
}

/// A copy of y in its significant limbs, at least one when y has any
/// (mbedtls_mpi_copy into a fresh number; not constant time).
copy_mpi: fn(y: Mpi) -> Mpi Never! {
    if y.p.len() == 0 -> return mpi()
    i := used_limbs(y)
    if i == 0 -> i = 1
    p := cipher.words(i)
    copy_limbs(p, y.p, i)
    Mpi{s: y.s, p: p}
}

/// A copy of y with all its limbs, leading zero ones too, so no limb is
/// tested: copy_mpi (mbedtls_mpi_copy) for a secret.
copy_mpi_ct: fn(y: Mpi) -> Mpi Never! { Mpi{s: y.s, p: y.p.copy()} }

/// x = y in place, as mbedtls_mpi_copy: x keeps its limbs, grown to y's
/// significant ones (at least one) and zeroed above them; an empty y zeroes
/// x. Results replace a number through this rather than by rebinding it
/// (#6702: rebinding a Close local closes the old value twice).
set_mpi: fn(x: &Mpi, y: Mpi) MpiError! {
    if y.p.len() == 0 {
        if x.p.len() != 0 {
            x.s = 1
            zero_limbs(x.p, x.p.len())
        }
        return
    }
    i := used_limbs(y)
    if i == 0 -> i = 1
    x.s = y.s
    if x.p.len() < i {
        grow(x, i) ?? return Err(err)
    } else {
        loop j in i..<x.p.len() -> x.p[j] = U64{0}
    }
    copy_limbs(x.p, y.p, i)
}

/// x = y in place with all of y's limbs, leading zero ones too, so no limb
/// is tested: set_mpi for a secret, as copy_mpi_ct is copy_mpi for one.
/// x is grown to y's length and zeroed above it.
set_mpi_ct: fn(x: &Mpi, y: Mpi) MpiError! {
    x.s = y.s
    if x.p.len() < y.p.len() {
        grow(x, y.p.len()) ?? return Err(err)
    } else {
        loop j in y.p.len()..<x.p.len() -> x.p[j] = U64{0}
    }
    copy_limbs(x.p, y.p, y.p.len())
}

/// Exchange x and y.
swap: fn(x: &Mpi, y: &Mpi) Never! {
    s: x.s
    x.s = y.s
    y.s = s
    p := x.p.copy()
    x.p = y.p.copy()
    y.p = p.move()
}

/// x = z, keeping x's limbs.
lset: fn(x: &Mpi, z: Int) MpiError! {
    grow(x, 1) ?? return Err(err)
    zero_limbs(x.p, x.p.len())
    x.p[0] = sint_abs(z)
    x.s = if z < 0 -> -1 else -> 1
}

/// Bit `pos` of |x|.
get_bit: fn(x: Mpi, pos: Int) -> Int Never! { Int.from_u64(limb_bit(x, pos)) }

/// Bit `pos` of |x| as a word, 0 past its limbs: the limb and the shift
/// come from the position alone, so a secret's bit is read with no test of
/// its value.
limb_bit: fn(x: Mpi, pos: Int) -> U64 Never! {
    if x.p.len() * LIMB_BITS <= pos -> return U64{0}
    (x.p[pos /% LIMB_BITS] >> (pos % LIMB_BITS)).bit_and(U64{1})
}

/// Set bit `pos` of |x| to `val`, 0 or 1, growing x for a 1.
set_bit: fn(x: &Mpi, pos: Int, val: Int) MpiError! {
    if val != 0 && val != 1 -> return Err(.BadInput)
    off: pos /% LIMB_BITS
    idx: pos % LIMB_BITS
    if x.p.len() * LIMB_BITS <= pos {
        if val == 0 -> return
        grow(x, off + 1) ?? return Err(err)
    }
    x.p[off] = x.p[off].bit_and((U64{1} << idx).bit_not()).bit_or(U64{val} << idx)
}

/// The count of trailing zero bits of |x|; 0 for zero.
lsb: fn(x: Mpi) -> Int Never! {
    loop i in 0..<x.p.len() {
        if x.p[i] != (U64{0}) -> return i * LIMB_BITS + x.p[i].trailing_zeros()
    }
    0
}

/// The bit length of |x|.
bitlen: fn(x: Mpi) -> Int Never! { core_bitlen(x.p, x.p.len()) }

/// The byte length of |x|.
size: fn(x: Mpi) -> Int Never! { (bitlen(x) + 7) >> 3 }

/// The value of digit `c` in `radix`, or InvalidCharacter.
digit: fn(c: U8, radix: Int) -> U64 MpiError! {
    v: Int.from_u8(c)
    d := 255
    if v >= 0x30 && v <= 0x39 -> d = v - 0x30
    if v >= 0x41 && v <= 0x46 -> d = v - 0x37
    if v >= 0x61 && v <= 0x66 -> d = v - 0x57
    if d >= radix -> return Err(.InvalidCharacter)
    Ok(U64{d})
}

/// The number written in `s` in `radix` 2 to 16, with an optional leading
/// '-'. The empty text is zero with no limbs.
read_string: fn(radix: Int, s: String) -> Mpi MpiError! {
    if radix < 2 || radix > 16 -> return Err(.BadInput)
    text: s.bytes()
    if text.len() == 0 -> return Ok(mpi())
    start: if text[0] == (U8{0x2d}) -> 1 else -> 0
    slen: text.len() - start
    x := mpi()
    if radix == 16 {
        limbs: (slen * 4 + LIMB_BITS - 1) /% LIMB_BITS
        grow(x, limbs) ?? return Err(err)
        lset(x, 0) ?? return Err(err)
        loop j in 0..<slen {
            d: digit(text[start + slen - 1 - j], radix) ?? return Err(err)
            x.p[j /% 16] = x.p[j /% 16].bit_or(d << ((j % 16) * 4))
        }
    } else {
        lset(x, 0) ?? return Err(err)
        loop i in 0..<slen {
            d: digit(text[start + i], radix) ?? return Err(err)
            t: mul_int(x, U64{radix}) ?? return Err(err)
            next_x: add_int(t, Int.from_u64(d)) ?? return Err(err)
            set_mpi(x, next_x) ?? return Err(err)
        }
    }
    if start == 1 && bitlen(x) != 0 -> x.s = -1
    Ok(x)
}

HEX_DIGITS: "0123456789ABCDEF"

/// x in `radix` 2 to 16, upper-case, with a '-' when negative; hex comes in
/// whole bytes. `buflen` is the C buffer the text and its terminating NUL
/// must fit, as mbedtls_mpi_write_string checks it.
write_string: fn(x: Mpi, radix: Int, buflen: Int) -> String MpiError! {
    if radix < 2 || radix > 16 -> return Err(.BadInput)
    n := bitlen(x)
    if radix >= 4 -> n >>= 1
    if radix >= 16 -> n >>= 1
    // NUL, the rounding of the halvings, and a sign; then even for hex.
    n += 3
    n += n % 2
    if buflen < n -> return Err(.BufferTooSmall)
    digits: HEX_DIGITS.bytes()
    out := [U8]{}
    room := buflen
    if x.s == -1 {
        out.push(U8{0x2d})
        room -= 1
    }
    if radix == 16 {
        started := false
        i := x.p.len()
        loop i > 0 {
            j := LIMB_BYTES
            loop j > 0 {
                c: Int.from_u64((x.p[i - 1] >> ((j - 1) * 8)).bit_and(U64{0xff}))
                if c != 0 || started || i + j == 2 {
                    out.push(digits[c /% 16])
                    out.push(digits[c % 16])
                    started = true
                }
                j -= 1
            }
            i -= 1
        }
    } else {
        t := copy_mpi(x)
        t.s = 1
        reversed := [U8]{}
        loop {
            if reversed.len() >= room -> return Err(.BufferTooSmall)
            r: mod_int(t, radix) ?? return Err(err)
            qr: div_int(t, radix) ?? return Err(err)
            set_mpi(t, qr.q) ?? return Err(err)
            reversed.push(digits[Int.from_u64(r)])
            if cmp_int(t, 0) == 0 -> break
        }
        i := reversed.len()
        loop i > 0 {
            out.push(reversed[i - 1])
            i -= 1
        }
    }
    Ok(String.from_bytes(out) ?? "")
}

/// mbedtls_mpi_read_file over the file's bytes: the first line, read as
/// fgets reads it into RW_BUFFER_SIZE bytes and cut at a NUL as strlen cuts
/// it, minus the line end; the number is the trailing run of `radix` digits
/// after the last non-digit, so a sign before it is not part of it.
read_file_data: fn(radix: Int, data: [U8]) -> Mpi MpiError! {
    if radix < 2 || radix > 16 -> return Err(.BadInput)
    if data.len() == 0 -> return Err(.FileIO)
    line := [U8]{}
    loop b in data {
        if line.len() == RW_BUFFER_SIZE - 2 -> break
        line.push(b)
        if b == (U8{10}) -> break
    }
    loop i in 0..<line.len() {
        if line[i] == (U8{0}) {
            loop line.len() > i -> _: line.pop()
            break
        }
    }
    if line.len() == RW_BUFFER_SIZE - 2 -> return Err(.BufferTooSmall)
    if line.len() > 0 && line[line.len() - 1] == (U8{10}) -> _: line.pop()
    if line.len() > 0 && line[line.len() - 1] == (U8{13}) -> _: line.pop()
    p := line.len()
    loop p > 0 {
        if digit(line[p - 1], radix) == .Err(_) -> break
        p -= 1
    }
    tail := [U8]{}
    loop i in p..<line.len() -> tail.push(line[i])
    read_string(radix, String.from_bytes(tail) ?? "")
}

/// mbedtls_mpi_write_file's text: `prefix`, x in `radix`, and CR LF.
write_file_text: fn(prefix: String, x: Mpi, radix: Int) -> String MpiError! {
    s: write_string(x, radix, RW_BUFFER_SIZE - 2) ?? return Err(err)
    Ok("{prefix}{s}\r\n")
}

/// The unsigned little-endian `buf` in exactly ceil(len / 8) limbs.
read_binary_le: fn(buf: [U8]) -> Mpi MpiError! {
    x := zeros((buf.len() + LIMB_BYTES - 1) /% LIMB_BYTES) ?? return Err(err)
    core_read_le(x.p, x.p.len(), buf) ?? return Err(err)
    Ok(x)
}

/// The unsigned big-endian `buf` in exactly ceil(len / 8) limbs.
read_binary: fn(buf: [U8]) -> Mpi MpiError! {
    x := zeros((buf.len() + LIMB_BYTES - 1) /% LIMB_BYTES) ?? return Err(err)
    core_read_be(x.p, x.p.len(), buf) ?? return Err(err)
    Ok(x)
}

/// |x| as `buflen` little-endian bytes.
write_binary_le: fn(x: Mpi, buflen: Int) -> [U8] MpiError! { core_write_le(x.p, x.p.len(), buflen) }

/// |x| as `buflen` big-endian bytes, zero-padded on the left.
write_binary: fn(x: Mpi, buflen: Int) -> [U8] MpiError! { core_write_be(x.p, x.p.len(), buflen) }

/// x <<= count, growing x as needed.
shift_l: fn(x: &Mpi, count: Int) MpiError! {
    bits: bitlen(x) + count
    if x.p.len() * LIMB_BITS < bits -> grow(x, (bits + LIMB_BITS - 1) /% LIMB_BITS) ?? return Err(err)
    core_shift_l(x.p, x.p.len(), count)
}

/// x >>= count.
shift_r: fn(x: &Mpi, count: Int) Never! {
    if x.p.len() != 0 -> core_shift_r(x.p, x.p.len(), count)
}

/// The sign of |x| - |y|: -1, 0 or 1.
cmp_abs: fn(x: Mpi, y: Mpi) -> Int Never! {
    i := used_limbs(x)
    j: used_limbs(y)
    if i > j -> return 1
    if j > i -> return -1
    loop i > 0 {
        if x.p[i - 1] > y.p[i - 1] -> return 1
        if x.p[i - 1] < y.p[i - 1] -> return -1
        i -= 1
    }
    0
}

/// The sign of x - y: -1, 0 or 1.
cmp_mpi: fn(x: Mpi, y: Mpi) -> Int Never! {
    i := used_limbs(x)
    j: used_limbs(y)
    if i == 0 && j == 0 -> return 0
    if i > j -> return x.s
    if j > i -> return -y.s
    if x.s > 0 && y.s < 0 -> return 1
    if y.s > 0 && x.s < 0 -> return -1
    loop i > 0 {
        if x.p[i - 1] > y.p[i - 1] -> return x.s
        if x.p[i - 1] < y.p[i - 1] -> return -x.s
        i -= 1
    }
    0
}

/// The sign of x - z.
cmp_int: fn(x: Mpi, z: Int) -> Int Never! { cmp_mpi(x, from_int(z)) }

/// 1 when x < y, in constant time; x and y must have the same limb count.
lt_mpi_ct: fn(x: Mpi, y: Mpi) -> U64 MpiError! {
    if x.p.len() != y.p.len() -> return Err(.BadInput)
    x_neg: U64{(x.s.bit_and(2)) >> 1}
    y_neg: U64{(y.s.bit_and(2)) >> 1}
    different: x_neg.bit_xor(y_neg)
    result: different.bit_and(x_neg)
    // Same signs: compare magnitudes, the other way round when negative.
    a_lt_b: core_lt_ct(x.p, y.p, x.p.len())
    b_lt_a: core_lt_ct(y.p, x.p, x.p.len())
    lt: ct_select(ct_mask(x_neg), b_lt_a, a_lt_b)
    Ok(result.bit_or(different.bit_xor(U64{1}).bit_and(lt)))
}

/// The sign `a` when the condition bit is 1, else `b`, in constant time.
ct_sign_if: fn(cond: U64, a: Int, b: Int) -> Int Never! {
    Int.from_u64(ct_select(ct_mask(cond), U64{a + 1}, U64{b + 1})) - 1
}

/// x = y when `assign` is 1, else x unchanged, without revealing which.
/// x grows to y's limb count; its limbs above y's are zeroed on assignment.
safe_cond_assign: fn(x: &Mpi, y: Mpi, assign: Int) MpiError! {
    grow(x, y.p.len()) ?? return Err(err)
    cond: ct_bool(U64{assign.bit_and(0xff)})
    x.s = ct_sign_if(cond, y.s, x.s)
    core_cond_assign(x.p, y.p, y.p.len(), cond)
    keep: ct_mask(cond.bit_xor(U64{1}))
    loop i in y.p.len()..<x.p.len() -> x.p[i] = x.p[i].bit_and(keep)
}

/// Swap x and y when `swap` is 1, without revealing whether it happened.
safe_cond_swap: fn(x: &Mpi, y: &Mpi, swap: Int) MpiError! {
    cond: ct_bool(U64{swap.bit_and(0xff)})
    grow(x, y.p.len()) ?? return Err(err)
    grow(y, x.p.len()) ?? return Err(err)
    s: x.s
    x.s = ct_sign_if(cond, y.s, x.s)
    y.s = ct_sign_if(cond, s, y.s)
    core_cond_swap(x.p, y.p, x.p.len(), cond)
}

/// |a| + |b| (HAC 14.7).
#Policy(arithmetic: .Wrapping)
add_abs: fn(a: Mpi, b: Mpi) -> Mpi MpiError! {
    x := copy_mpi(a)
    x.s = 1
    j := used_limbs(b)
    if j == 0 -> return Ok(x)
    grow(x, j) ?? return Err(err)
    c := U64{0}
    loop i in 0..<j {
        t: x.p[i] + c
        c = ct_lt(t, c)
        s: t + b.p[i]
        c += ct_lt(s, b.p[i])
        x.p[i] = s
    }
    loop c != (U64{0}) {
        if j >= x.p.len() -> grow(x, j + 1) ?? return Err(err)
        x.p[j] = x.p[j] + c
        c = ct_lt(x.p[j], c)
        j += 1
    }
    Ok(x)
}

/// |a| - |b| in a's limb count, or NegativeValue when |a| < |b|
/// (HAC 14.9, 14.10).
#Policy(arithmetic: .Wrapping)
sub_abs: fn(a: Mpi, b: Mpi) -> Mpi MpiError! {
    n: used_limbs(b)
    if n > a.p.len() -> return Err(.NegativeValue)
    x := zeros(a.p.len()) ?? return Err(err)
    copy_limbs(x.p, a.p, a.p.len())
    carry := core_sub(x.p, a.p, b.p, n)
    loop i in n..<x.p.len() {
        s: x.p[i]
        t: s - carry
        carry = ct_lt(s, t)
        x.p[i] = t
    }
    if carry != (U64{0}) -> return Err(.NegativeValue)
    Ok(x)
}

/// a + b * flip for flip 1 or -1.
add_sub_mpi: fn(a: Mpi, b: Mpi, flip: Int) -> Mpi MpiError! {
    s: a.s
    if a.s * b.s * flip < 0 {
        cmp: cmp_abs(a, b)
        if cmp >= 0 {
            x := sub_abs(a, b) ?? return Err(err)
            // |a| = |b| gives zero, which is positive.
            x.s = if cmp == 0 -> 1 else -> s
            return Ok(x)
        }
        x := sub_abs(b, a) ?? return Err(err)
        x.s = -s
        return Ok(x)
    }
    x := add_abs(a, b) ?? return Err(err)
    x.s = s
    Ok(x)
}

/// a + b.
add_mpi: fn(a: Mpi, b: Mpi) -> Mpi MpiError! { add_sub_mpi(a, b, 1) }

/// a - b.
sub_mpi: fn(a: Mpi, b: Mpi) -> Mpi MpiError! { add_sub_mpi(a, b, -1) }

/// a + b for an Int64 b.
add_int: fn(a: Mpi, b: Int) -> Mpi MpiError! { add_mpi(a, from_int(b)) }

/// a - b for an Int64 b.
sub_int: fn(a: Mpi, b: Int) -> Mpi MpiError! { sub_mpi(a, from_int(b)) }

/// a * b (HAC 14.12). A zero product is still computed in full and is
/// positive.
mul_mpi: fn(a: Mpi, b: Mpi) -> Mpi MpiError! {
    i: used_limbs(a)
    j: used_limbs(b)
    x := zeros(if i + j == 0 -> 1 else -> i + j) ?? return Err(err)
    core_mul(x.p, a.p, i, b.p, j)
    x.s = if i == 0 || j == 0 -> 1 else -> a.s * b.s
    Ok(x)
}

/// a * b for one limb b, as a + a * (b - 1) through the multiply-add.
#Policy(arithmetic: .Wrapping)
mul_int: fn(a: Mpi, b: U64) -> Mpi MpiError! {
    n: used_limbs(a)
    if b == (U64{0}) || n == 0 -> return Ok(from_int(0))
    x := zeros(n + 1) ?? return Err(err)
    copy_limbs(x.p, a.p, n)
    x.s = a.s
    _: core_mla(x.p, 0, x.p.len(), a.p, n, b - U64{1})
    Ok(x)
}

/// (u1 * 2^64 + u0) / d, saturating at 2^64 - 1 when u1 >= d or d is 0
/// (Knuth TAOCP vol. 2 section 4.3.1 algorithm D on 32-bit halves).
#Policy(arithmetic: .Wrapping)
int_div_int: fn(high: U64, low: U64, divisor: U64) -> U64 Never! {
    if divisor == (U64{0}) || high >= divisor -> return U64{0}.bit_not()
    radix: U64{1} << 32
    half: radix - U64{1}
    s: core_clz(divisor)
    d: divisor << s
    u1 := high << s
    if s > 0 -> u1 = u1.bit_or(low >> (LIMB_BITS - s))
    u0: low << s
    d1: d >> 32
    d0: d.bit_and(half)
    u0_msw: u0 >> 32
    u0_lsw: u0.bit_and(half)
    q1 := u1 /% d1
    r0 := u1 - d1 * q1
    loop q1 >= radix || q1 * d0 > radix * r0 + u0_msw {
        q1 -= U64{1}
        r0 += d1
        if r0 >= radix -> break
    }
    rax: u1 * radix + (u0_msw - q1 * d)
    q0 := rax /% d1
    r0 = rax - q0 * d1
    loop q0 >= radix || q0 * d0 > radix * r0 + u0_lsw {
        q0 -= U64{1}
        r0 += d1
        if r0 >= radix -> break
    }
    q1 * radix + q0
}

/// The quotient and remainder of a / b: a = q * b + r, q truncated toward
/// zero and r taking a's sign (HAC 14.20).
div_mpi: fn(a: Mpi, b: Mpi) -> (q: Mpi, r: Mpi) MpiError! {
    if cmp_int(b, 0) == 0 -> return Err(.DivisionByZero)
    if cmp_abs(a, b) < 0 -> return Ok((q: from_int(0), r: copy_mpi(a)))
    x := copy_mpi(a)
    y := copy_mpi(b)
    x.s = 1
    y.s = 1
    z := zeros(a.p.len() + 2) ?? return Err(err)
    k := bitlen(y) % LIMB_BITS
    if k < LIMB_BITS - 1 {
        k = LIMB_BITS - 1 - k
        shift_l(x, k) ?? return Err(err)
        shift_l(y, k) ?? return Err(err)
    } else {
        k = 0
    }
    n: x.p.len() - 1
    t: y.p.len() - 1
    shift_l(y, LIMB_BITS * (n - t)) ?? return Err(err)
    loop cmp_mpi(x, y) >= 0 {
        z.p[n - t] = z.p[n - t].wrapping_add(U64{1})
        diff: sub_mpi(x, y) ?? return Err(err)
        set_mpi(x, diff) ?? return Err(err)
    }
    shift_r(y, LIMB_BITS * (n - t))
    i := n
    loop i > t {
        // x keeps at least n + 1 limbs, as mbedtls's in-place x does.
        grow(x, n + 1) ?? return Err(err)
        at: i - t - 1
        z.p[at] = if x.p[i] >= y.p[t] -> U64{0}.bit_not() else -> int_div_int(x.p[i], x.p[i - 1], y.p[t])
        t2 := zeros(3) ?? return Err(err)
        t2.p[0] = if i < 2 -> U64{0} else -> x.p[i - 2]
        t2.p[1] = if i < 1 -> U64{0} else -> x.p[i - 1]
        t2.p[2] = x.p[i]
        z.p[at] = z.p[at].wrapping_add(U64{1})
        loop {
            z.p[at] = z.p[at].wrapping_sub(U64{1})
            t1 := zeros(2) ?? return Err(err)
            t1.p[0] = if t < 1 -> U64{0} else -> y.p[t - 1]
            t1.p[1] = y.p[t]
            product: mul_int(t1, z.p[at]) ?? return Err(err)
            if cmp_mpi(product, t2) <= 0 -> break
        }
        t1 := mul_int(y, z.p[at]) ?? return Err(err)
        shift_l(t1, LIMB_BITS * at) ?? return Err(err)
        diff: sub_mpi(x, t1) ?? return Err(err)
        set_mpi(x, diff) ?? return Err(err)
        if cmp_int(x, 0) < 0 {
            back := copy_mpi(y)
            shift_l(back, LIMB_BITS * at) ?? return Err(err)
            sum: add_mpi(x, back) ?? return Err(err)
            set_mpi(x, sum) ?? return Err(err)
            z.p[at] = z.p[at].wrapping_sub(U64{1})
        }
        i -= 1
    }
    q := copy_mpi(z)
    q.s = a.s * b.s
    shift_r(x, k)
    x.s = a.s
    r := copy_mpi(x)
    if cmp_int(r, 0) == 0 -> r.s = 1
    Ok((q: q, r: r))
}

/// a / b and a mod b for an Int64 b, as `div_mpi`.
div_int: fn(a: Mpi, b: Int) -> (q: Mpi, r: Mpi) MpiError! { div_mpi(a, from_int(b)) }

/// a mod b in [0, b) for b > 0.
mod_mpi: fn(a: Mpi, b: Mpi) -> Mpi MpiError! {
    if cmp_int(b, 0) < 0 -> return Err(.NegativeValue)
    qr: div_mpi(a, b) ?? return Err(err)
    r := copy_mpi(qr.r)
    loop cmp_int(r, 0) < 0 {
        sum: add_mpi(r, b) ?? return Err(err)
        set_mpi(r, sum) ?? return Err(err)
    }
    loop cmp_mpi(r, b) >= 0 {
        diff: sub_mpi(r, b) ?? return Err(err)
        set_mpi(r, diff) ?? return Err(err)
    }
    Ok(r)
}

/// a mod b in [0, b) for an Int64 b > 0.
#Policy(arithmetic: .Wrapping)
mod_int: fn(a: Mpi, b: Int) -> U64 MpiError! {
    if b == 0 -> return Err(.DivisionByZero)
    if b < 0 -> return Err(.NegativeValue)
    if b == 1 || a.p.len() == 0 -> return Ok(U64{0})
    if b == 2 -> return Ok(a.p[0].bit_and(U64{1}))
    d: U64{b}
    y := U64{0}
    i := a.p.len()
    loop i > 0 {
        x := a.p[i - 1]
        y = (y << 32).bit_or(x >> 32)
        y -= (y /% d) * d
        x <<= 32
        y = (y << 32).bit_or(x >> 32)
        y -= (y /% d) * d
        i -= 1
    }
    if a.s < 0 && y != (U64{0}) -> y = d - y
    Ok(y)
}

/// rr = R^2 mod n for odd n > 1, R = 2^(64 * n.p.len()), unless rr already
/// holds it: the cache `exp_mod` and `mod_ct` keep beside a modulus. It is
/// computed in constant time, since the modulus may be a CRT prime.
mont_r2: fn(rr: &Mpi, n: Mpi) MpiError! {
    if rr.p.len() == 0 {
        computed := core_get_mont_r2_ct(n) ?? return Err(err)
        swap(rr, computed)
    } else {
        grow(rr, n.p.len()) ?? return Err(err)
    }
}

/// a mod n for odd n > 1 and a >= 0 of any length, in n's limb count, with
/// no division and no test of either's limbs (core_mod_wide). `rr` caches
/// R^2 mod n as for `exp_mod`.
mod_ct: fn(a: Mpi, n: Mpi, rr: &Mpi) -> Mpi MpiError! {
    if a.s < 0 -> return Err(.BadInput)
    mont_r2(rr, n) ?? return Err(err)
    an: n.p.len()
    x := zeros(an) ?? return Err(err)
    mm: core_montmul_init(n.p)
    t := cipher.words(2 * an + 1)
    core_mod_wide(x.p, a.p, a.p.len(), n.p, an, mm, rr.p, t)
    cipher.wipe_words(t)
    Ok(x)
}

/// x's limbs in exactly `limbs` limbs: zero-extended, or cut where a value
/// in range has only zero limbs. Only x's limb count is tested.
limbs_of: fn(x: Mpi, limbs: Int) -> [U64] Never! {
    out := cipher.words(limbs)
    loop i in 0..<(if x.p.len() < limbs -> x.p.len() else -> limbs) -> out[i] = x.p[i]
    out
}

/// a^e mod n for odd n > 0 and e >= 0, both at most MAX_BITS. `rr` caches
/// R^2 mod n between calls: empty, it is computed and stored. The exponent's
/// bits are read from bit `start_bit` of limb `start_limb` of `ep` down.
/// |a| of any length enters Montgomery form by core_to_mont_rep_wide, so an
/// a at or above n is reduced with no division; the result has n's limb
/// count.
exp_mod_from: fn(a: Mpi, ep: [U64], start_limb: Int, start_bit: Int, n: Mpi, rr: &Mpi) -> Mpi MpiError! {
    an: n.p.len()
    mont_r2(rr, n) ?? return Err(err)
    x := zeros(an) ?? return Err(err)
    mm: core_montmul_init(n.p)
    t := cipher.words(2 * an + 1)
    m := cipher.words(an)
    core_to_mont_rep_wide(m, a.p, a.p.len(), n.p, an, mm, rr.p, t)
    core_exp_mod(x.p, m, n.p, an, ep, start_limb, start_bit, rr.p)
    copy_limbs(m, x.p, an)
    core_from_mont_rep(x.p, m, n.p, an, mm, t)
    // A negative a with an odd exponent: the result is n - |a|^e mod n
    // (zero stays zero), chosen by mask on the exponent's low bit.
    if a.s == -1 {
        negated := cipher.words(an)
        _: core_sub(negated, n.p, x.p, an)
        odd: ep[0].bit_and(U64{1})
        nonzero: core_check_zero_ct(x.p, an)
        core_cond_assign(x.p, negated, an, odd.bit_and(nonzero))
        cipher.wipe_words(negated)
    }
    cipher.wipe_words(t)
    cipher.wipe_words(m)
    Ok(x)
}

/// The modulus checks `exp_mod` and `exp_mod_unsafe` share: odd n > 0 at
/// most MAX_BITS wide. A CRT prime is a secret modulus, so n's bits are
/// read with no test of them and only the verdict leaves.
exp_mod_modulus_ok: fn(n: Mpi) -> Bool Never! {
    if n.s < 0 || n.p.len() == 0 -> return false
    ok: n.p[0].bit_and(U64{1}).bit_and(core_bits_above(n.p, MAX_BITS - 1).bit_xor(U64{1}))
    ok == U64{1}
}

/// a^e mod n for odd n > 0 and e >= 0, n at most MAX_BITS and e at most
/// MAX_BITS / LIMB_BITS limbs, in time that never depends on e
/// (mbedtls_mpi_exp_mod). e is read over the larger of its own and n's limb
/// count with the window that length fixes, so its bit length does not
/// show either. A negative e is told by its sign alone.
exp_mod: fn(a: Mpi, e: Mpi, n: Mpi, rr: &Mpi) -> Mpi MpiError! {
    if !exp_mod_modulus_ok(n) || e.s < 0 || e.p.len() > MAX_BITS /% LIMB_BITS -> return Err(.BadInput)
    if e.p.len() == 0 -> return Ok(from_int(1))
    limbs := n.p.len()
    if e.p.len() > limbs -> limbs = e.p.len()
    ep := cipher.words(limbs)
    copy_limbs(ep, e.p, e.p.len())
    x := exp_mod_from(a, ep, limbs, 0, n, rr) ?? {
        cipher.wipe_words(ep)
        return Err(err)
    }
    cipher.wipe_words(ep)
    Ok(x)
}

/// a^e mod n for a public e; the time depends on e (mbedtls_mpi_exp_mod_unsafe).
exp_mod_unsafe: fn(a: Mpi, e: Mpi, n: Mpi, rr: &Mpi) -> Mpi MpiError! {
    if !exp_mod_modulus_ok(n) || cmp_int(e, 0) < 0 || bitlen(e) > MAX_BITS -> return Err(.BadInput)
    if e.p.len() == 0 -> return Ok(from_int(1))
    e_bits := bitlen(e)
    if e_bits == 0 -> e_bits = 1
    exp_mod_from(a, e.p, e_bits /% LIMB_BITS, e_bits % LIMB_BITS, n, rr)
}

/// gcd(a, n) and, with `inverse`, a^-1 mod n (meaningful when the gcd is
/// 1), in constant time, for odd n and 0 <= a <= n; `inverse` needs n > 1.
/// Both results have n's limb count; `i` is empty without `inverse`.
gcd_modinv_odd: fn(a: Mpi, n: Mpi, inverse: Bool) -> (g: Mpi, i: Mpi) MpiError! {
    if !modinv_args_ok(a, n, inverse) -> return Err(.BadInput)
    g := zeros(n.p.len()) ?? return Err(err)
    i := if inverse -> zeros(n.p.len()) ?? return Err(err) else -> mpi()
    // The working copy of a is wiped: a may be a blinded nonce or key.
    ap := if a.p.len() == 0 -> [U64]{U64{0}} else -> a.p.copy()
    an: if a.p.len() >= n.p.len() -> n.p.len() else if a.p.len() != 0 -> a.p.len() else -> 1
    core_gcd_modinv_odd(g.p, i.p, inverse, ap, an, n.p, n.p.len())
    cipher.wipe_words(ap)
    Ok((g: g, i: i))
}

/// Whether gcd_modinv_odd may run on a and n: 0 <= a <= n, n odd, and n > 1
/// for an inverse. n may be a CRT prime and a a blinding draw, so their
/// limbs are read in constant time and only the verdict leaves.
modinv_args_ok: fn(a: Mpi, n: Mpi, inverse: Bool) -> Bool Never! {
    if a.s < 0 || n.s < 0 || n.p.len() == 0 -> return false
    nl: n.p.len()
    low := cipher.words(nl)
    high := U64{0}
    loop i in 0..<a.p.len() {
        if i < nl -> low[i] = a.p[i] else -> high = high.bit_or(a.p[i])
    }
    ok := core_lt_ct(n.p, low, nl).bit_or(ct_bool(high)).bit_xor(U64{1})
    ok = ok.bit_and(n.p[0].bit_and(U64{1}))
    if inverse -> ok = ok.bit_and(core_uint_le_mpi(U64{2}, n.p, nl))
    cipher.wipe_words(low)
    ok == U64{1}
}

/// gcd(a, b) >= 0; gcd(0, b) = |b|. Constant time once both are non-zero.
gcd: fn(a: Mpi, b: Mpi) -> Mpi MpiError! {
    ta := copy_mpi(a)
    tb := copy_mpi(b)
    ta.s = 1
    tb.s = 1
    grow(ta, if tb.p.len() != 0 -> tb.p.len() else -> 1) ?? return Err(err)
    grow(tb, ta.p.len()) ?? return Err(err)
    if core_check_zero_ct(ta.p, ta.p.len()) == (U64{0}) -> return Ok(copy_mpi(tb))
    if core_check_zero_ct(tb.p, tb.p.len()) == (U64{0}) -> return Ok(copy_mpi(ta))
    // Odd inputs: set the shared power of two aside.
    za: lsb(ta)
    zb: lsb(tb)
    shift_r(ta, za)
    shift_r(tb, zb)
    swap: core_lt_ct(tb.p, ta.p, ta.p.len())
    core_cond_swap(ta.p, tb.p, ta.p.len(), swap)
    result: gcd_modinv_odd(ta, tb, false) ?? return Err(err)
    g := copy_mpi(result.g)
    grow(g, result.g.p.len()) ?? return Err(err)
    shift_l(g, if za > zb -> zb else -> za) ?? return Err(err)
    Ok(g)
}

/// `size` random bytes as a big-endian number in exactly ceil(size / 8)
/// limbs.
fill_random: fn<R: RNG>(size: Int, rng: &R) -> Mpi MpiError! {
    x := zeros((size + LIMB_BYTES - 1) /% LIMB_BYTES) ?? return Err(err)
    if size == 0 -> return Ok(x)
    core_fill_random(x.p, x.p.len(), size, rng) ?? return Err(err)
    Ok(x)
}

/// A uniform draw min <= x < n, in n's limb count (mbedtls_mpi_random).
random: fn<R: RNG>(min: Int, n: Mpi, rng: &R) -> Mpi MpiError! {
    if min < 0 -> return Err(.BadInput)
    if cmp_int(n, min) <= 0 -> return Err(.BadInput)
    x := zeros(n.p.len()) ?? return Err(err)
    core_random(x.p, U64{min}, n.p, x.p.len(), rng) ?? return Err(err)
    Ok(x)
}

/// a^-1 mod n for odd n and any a.
inv_mod_odd: fn(a: Mpi, n: Mpi) -> Mpi MpiError! {
    t: mod_mpi(a, n) ?? return Err(err)
    result: gcd_modinv_odd(t, n, true) ?? return Err(err)
    if cmp_int(result.g, 1) != 0 -> return Err(.NotAcceptable)
    Ok(copy_mpi(result.i))
}

/// a^-1 mod n for even n, odd a and 1 < a < n. The constant-time inverse
/// needs an odd modulus, so it finds the other half of the Bezout relation,
/// i = n^-1 mod a, and then n * i = 1 + k * a gives a^-1 = n - k.
inv_mod_even_in_range: fn(a: Mpi, n: Mpi) -> Mpi MpiError! {
    i: mod_mpi(n, a) ?? return Err(err)
    result: gcd_modinv_odd(i, a, true) ?? return Err(err)
    if cmp_int(result.g, 1) != 0 -> return Err(.NotAcceptable)
    ni: mul_mpi(result.i, n) ?? return Err(err)
    ni_minus: sub_int(ni, 1) ?? return Err(err)
    k: div_mpi(ni_minus, a) ?? return Err(err)
    sub_mpi(n, k.q)
}

/// a^-1 mod n for even n and odd a in any range.
inv_mod_even: fn(a: Mpi, n: Mpi) -> Mpi MpiError! {
    aa: mod_mpi(a, n) ?? return Err(err)
    cmp: cmp_int(aa, 1)
    if cmp < 0 -> return Err(.NotAcceptable)
    if cmp == 0 -> return Ok(from_int(1))
    inv_mod_even_in_range(aa, n)
}

/// a^-1 mod n for n > 1; NotAcceptable when no inverse exists.
inv_mod: fn(a: Mpi, n: Mpi) -> Mpi MpiError! {
    if cmp_int(n, 1) <= 0 -> return Err(.BadInput)
    if get_bit(n, 0) == 1 -> return inv_mod_odd(a, n)
    if get_bit(a, 0) == 1 -> return inv_mod_even(a, n)
    // Both even: 2 divides the gcd.
    Err(.NotAcceptable)
}

// ---------------------------------------------------------------------------
// Primes.

/// The odd primes up to SMALL_PRIMES_LIMIT (mbedtls's small_prime table,
/// 3 to 997), multiplied, in 22 limbs.
SMALL_PRIMES_LIMIT: 997
small_primes_product: fn() -> Mpi Never! {
    Mpi{s: 1, p: [U64]{
        U64{0x95dfd0bb976a134b}, U64{0x7b9fa420a4102ca7}, U64{0x6561f5c0dfd6189d}, U64{0xbfd5a830fb7935fc},
        U64{0xfb89bbfb2cba37db}, U64{0xe5e818991d8cc2ad}, U64{0x9d618a965dc9778d}, U64{0xe0570734f43e4139},
        U64{0xa24667433a54f14a}, U64{0x4505fca231e50c83}, U64{0xe137857afc661df0}, U64{0x32bca20d6280e017},
        U64{0x35e3b5006884ce6d}, U64{0xdfd8d592e40d1914}, U64{0xa8d9e83b387d1c20}, U64{0x6cf703b4e611acf6},
        U64{0x6a2ff98f3af23d78}, U64{0x026de448a966727b}, U64{0x0ba9f7f2cb32c769}, U64{0xc7ea54bf9d7252d3},
        U64{0x8121e1f0c58af3f5}, U64{0x00000005f078618e}
    }}
}

/// Trial division for positive x: true when x is a small prime, false when
/// it has no small factor, NotAcceptable when it has one. Small numbers are
/// divided directly; larger ones take a gcd with the product of the small
/// primes.
check_small_factors: fn(x: Mpi) -> Bool MpiError! {
    if x.p[0].bit_and(U64{1}) == (U64{0}) -> return Err(.NotAcceptable)
    if cmp_int(x, SMALL_PRIMES_LIMIT) <= 0 {
        v: Int.from_u64(x.p[0])
        d := 2
        loop v % d != 0 -> d += 1
        if v == d -> return Ok(true)
        return Err(.NotAcceptable)
    }
    g: gcd(small_primes_product(), x) ?? return Err(err)
    if cmp_int(g, 1) == 0 -> return Ok(false)
    Err(.NotAcceptable)
}

/// Miller-Rabin with `rounds` random bases 1 < a < x - 1 (HAC 4.24).
miller_rabin: fn<R: RNG>(x: Mpi, rounds: Int, rng: &R) MpiError! {
    w: sub_int(x, 1) ?? return Err(err)
    s: lsb(w)
    r := copy_mpi(w)
    shift_r(r, s)
    rr := mpi()
    loop _ in 0..<rounds {
        count := 0
        a := mpi()
        loop {
            drawn: fill_random(x.p.len() * LIMB_BYTES, rng) ?? return Err(err)
            set_mpi(a, drawn) ?? return Err(err)
            j: bitlen(a)
            k: bitlen(w)
            if j > k {
                top: a.p.len() - 1
                keep: k - top * LIMB_BITS - 1
                a.p[top] = if keep <= 0 -> U64{0} else -> a.p[top].bit_and((U64{1} << keep) - U64{1})
            }
            if count > 30 -> return Err(.NotAcceptable)
            count += 1
            if cmp_mpi(a, w) < 0 && cmp_int(a, 1) > 0 -> break
        }
        power: exp_mod(a, r, x, rr) ?? return Err(err)
        set_mpi(a, power) ?? return Err(err)
        if cmp_mpi(a, w) == 0 || cmp_int(a, 1) == 0 -> next
        j := 1
        loop j < s && cmp_mpi(a, w) != 0 {
            sq: mul_mpi(a, a) ?? return Err(err)
            reduced: mod_mpi(sq, x) ?? return Err(err)
            set_mpi(a, reduced) ?? return Err(err)
            if cmp_int(a, 1) == 0 -> break
            j += 1
        }
        if cmp_mpi(a, w) != 0 || cmp_int(a, 1) == 0 -> return Err(.NotAcceptable)
    }
}

/// Probabilistic primality of |x|: trial division, then `rounds` of
/// Miller-Rabin. NotAcceptable when composite.
is_prime_ext: fn<R: RNG>(x: Mpi, rounds: Int, rng: &R) MpiError! {
    xx: Mpi{s: 1, p: x.p.copy()}
    if cmp_int(xx, 0) == 0 || cmp_int(xx, 1) == 0 -> return Err(.NotAcceptable)
    if cmp_int(xx, 2) == 0 -> return
    certain: check_small_factors(xx) ?? return Err(err)
    if certain -> return
    miller_rabin(xx, rounds, rng)
}

/// ceil(2^63.5): a top limb at least this makes an n-limb number at least
/// (64n - 1) + 0.5 bits long.
CEIL_MAXUINT_DIV_SQRT2: U64{0xb504f333f9de6485}

/// A random prime of `nbits` bits, 3 to MAX_BITS (FIPS 186-4 appendix
/// B.3.3 for RSA when nbits is 1024 or 1536 and `low_err` is set). `dh`
/// asks for a safe prime: (x - 1) / 2 prime too. Miller-Rabin rounds give
/// an error probability of 2^-80 (HAC table 4.4) or with `low_err` 2^-100
/// (HAC fact 4.48).
gen_prime: fn<R: RNG>(nbits: Int, rng: &R, dh: Bool{false}, low_err: Bool{false}) -> Mpi MpiError! {
    if nbits < 3 || nbits > MAX_BITS -> return Err(.BadInput)
    n: (nbits + LIMB_BITS - 1) /% LIMB_BITS
    rounds: if {
        low_err && nbits >= 1450 -> 4
        low_err && nbits >= 1150 -> 5
        low_err && nbits >= 1000 -> 6
        low_err && nbits >= 850 -> 7
        low_err && nbits >= 750 -> 8
        low_err && nbits >= 500 -> 13
        low_err && nbits >= 250 -> 28
        low_err && nbits >= 150 -> 40
        low_err -> 51
        nbits >= 1300 -> 2
        nbits >= 850 -> 3
        nbits >= 650 -> 4
        nbits >= 350 -> 8
        nbits >= 250 -> 12
        nbits >= 150 -> 18
        else -> 27
    }
    loop {
        x := fill_random(n * LIMB_BYTES, rng) ?? return Err(err)
        // At least (nbits - 1) + 0.5 bits (FIPS 186-4 B.3.3 steps 4.4, 5.5).
        if x.p[n - 1] < CEIL_MAXUINT_DIV_SQRT2 -> next
        k: n * LIMB_BITS
        if k > nbits -> shift_r(x, k - nbits)
        x.p[0] = x.p[0].bit_or(U64{1})
        if !dh {
            if is_prime_ext(x, rounds, rng) == .Err(e) {
                if e != .NotAcceptable -> return Err(e)
            } else {
                return Ok(x)
            }
        } else {
            // y and x = 2y + 1 both prime needs x = 2 mod 3; keep x = 3 mod 4.
            x.p[0] = x.p[0].bit_or(U64{2})
            r: mod_int(x, 3) ?? return Err(err)
            if r == (U64{0}) {
                sum: add_int(x, 8) ?? return Err(err)
                set_mpi(x, sum) ?? return Err(err)
            }
            if r == (U64{1}) {
                sum: add_int(x, 4) ?? return Err(err)
                set_mpi(x, sum) ?? return Err(err)
            }
            y := copy_mpi(x)
            shift_r(y, 1)
            loop {
                if safe_prime_step(x, y, rounds, rng) == .Err(e) {
                    if e != .NotAcceptable -> return Err(e)
                } else {
                    return Ok(x)
                }
                // Keep y = (x - 1) / 2, y = 1 mod 2 and y = 2 mod 3.
                next_x: add_int(x, 12) ?? return Err(err)
                set_mpi(x, next_x) ?? return Err(err)
                next_y: add_int(y, 6) ?? return Err(err)
                set_mpi(y, next_y) ?? return Err(err)
            }
        }
    }
}

/// One safe-prime candidate: small factors of x and y before Miller-Rabin
/// on either.
safe_prime_step: fn<R: RNG>(x: Mpi, y: Mpi, rounds: Int, rng: &R) MpiError! {
    _: check_small_factors(x) ?? return Err(err)
    _: check_small_factors(y) ?? return Err(err)
    miller_rabin(x, rounds, rng) ?? return Err(err)
    miller_rabin(y, rounds, rng)
}

#Test("mbedtls bignum.c self-test vectors: product, quotient and remainder, exponentiation, inverse and gcd") {
    a: read_string(16, "EFE021C2645FD1DC586E69184AF4A31ED5F53E93B5F123FA41680867BA110131944FE7952E2517337780CB0DB80E61AAE7C8DDC6C5C6AADEB34EB38A2F40D5E6") ?? panic("A")
    e: read_string(16, "B2E7EFD37075B9F03FF989C7C5051C2034D2A323810251127E7BF8625A4F49A5F3E27F4DA8BD59C47D6DAABA4C8127BD5B5C25763222FEFCCFC38B832366C29E") ?? panic("E")
    n: read_string(16, "0066A198186C18C10B2F5ED9B522752A9830B69916E535C8F047518A889A43A594B6BED27A168D31D4A52F88925AA8F5") ?? panic("N")
    x: mul_mpi(a, n) ?? panic("mul")
    assert((write_string(x, 16, 1000) ?? "") == "602AB7ECA597A3D6B56FF9829A5E8B859E857EA95A03512E2BAE7391688D264AA5663B0341DB9CCFD2C4C5F421FEC8148001B72E848A38CAE1C65F78E56ABDEFE12D3C039B8A02D6BE593F0BBBDA56F1ECF677152EF804370C1A305CAF3B5BF130879B56C61DE584A0F53A2447A51E")
    qr: div_mpi(a, n) ?? panic("div")
    // write_string pads hex to whole bytes, so compare this odd-length value as a number.
    u: read_string(16, "256567336059E52CAE22925474705F39A94") ?? panic("U")
    assert(cmp_mpi(qr.q, u) == 0)
    assert((write_string(qr.r, 16, 1000) ?? "") == "6613F26162223DF488E9CD48CC132C7A0AC93C701B001B092E4E5B9F73BCD27B9EE50D0657C77F374E903CDFA4C642")
    rr := mpi()
    x3: exp_mod(a, e, n, rr) ?? panic("exp_mod")
    assert((write_string(x3, 16, 1000) ?? "") == "36E139AEA55215609D2816998ED020BBBD96C37890F65171D948E9BC7CBAA4D9325D24D6A3C12710F10A09FA08AB87")
    x3u: exp_mod_unsafe(a, e, n, rr) ?? panic("exp_mod_unsafe")
    assert(cmp_mpi(x3u, x3) == 0)
    x4: inv_mod(a, n) ?? panic("inv_mod")
    assert((write_string(x4, 16, 1000) ?? "") == "3A0AAEDD7E784FC07D8F9EC6E3BFD5C3DBA76456363A10869622EAC2DD84ECC5B8A74DAC4D09E03B5E0BE779F2DF61")
    pairs: [Int]{693, 609, 21, 1764, 868, 28, 768454923, 542167814, 1}
    loop k in 0..<3 {
        g: gcd(from_int(pairs[3 * k]), from_int(pairs[3 * k + 1])) ?? panic("gcd")
        assert(cmp_int(g, pairs[3 * k + 2]) == 0)
    }
}

#Test("The small-prime product is the product of every odd prime up to 997") {
    p := from_int(1)
    loop v in 3..<(SMALL_PRIMES_LIMIT + 1) {
        d := 2
        loop v % d != 0 -> d += 1
        if d == v {
            product: mul_int(p, U64{v}) ?? panic("mul_int")
            set_mpi(p, product) ?? panic("set_mpi")
        }
    }
    assert(cmp_mpi(p, small_primes_product()) == 0)
    assert(check_small_factors(from_int(997)) ?? false)
    assert(check_small_factors(from_int(991 * 997)) == .Err(.NotAcceptable))
    big: read_string(16, "FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF") ?? panic("big")
    assert(check_small_factors(big) == .Err(.NotAcceptable))
}

#Test("The most negative Int64 round-trips through lset, add, sub, div and mod") {
    most_positive: 9223372036854775807
    most_negative: 0 - most_positive - 1
    a := mpi()
    lset(a, most_negative) ?? panic("lset")
    assert(a.s == -1 && a.p.len() == 1 && a.p[0] == (U64{1} << 63))
    assert(cmp_int(a, most_negative) == 0)
    x: add_int(a, most_negative) ?? panic("add_int")
    assert(x.s == -1 && x.p.len() == 2 && x.p[0] == (U64{0}) && x.p[1] == (U64{1}))
    y: sub_int(a, most_negative) ?? panic("sub_int")
    assert(cmp_int(y, 0) == 0)
    d: div_int(a, most_negative) ?? panic("div_int")
    assert(cmp_int(d.q, 1) == 0 && cmp_int(d.r, 0) == 0)
    assert(mod_int(a, most_negative) == .Err(.NegativeValue))
}

#Test("set_mpi_ct keeps every limb of its source, leading zero ones too, and zeroes a longer target above them") {
    y: read_binary([U8]{U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{7}}) ?? panic("read")
    assert(y.p.len() == 2)
    short := mpi()
    set_mpi_ct(short, y) ?? panic("grow")
    assert(short.p.len() == 2 && short.p[0] == (U64{7}) && short.p[1] == (U64{0}) && cmp_int(short, 7) == 0)
    trimmed := mpi()
    set_mpi(trimmed, y) ?? panic("set")
    assert(trimmed.p.len() == 1 && cmp_mpi(trimmed, short) == 0)
    long: read_string(16, "112233445566778899AABBCCDDEEFF00") ?? panic("long")
    wide := copy_mpi_ct(long)
    set_mpi_ct(wide, from_int(-5)) ?? panic("wide")
    assert(wide.s == -1 && wide.p.len() == long.p.len() && cmp_int(wide, -5) == 0)
    loop j in 1..<wide.p.len() -> assert(wide.p[j] == (U64{0}))
}

#Test("Strings, bytes and files round-trip, with mbedtls's error for each malformed input") {
    x: read_string(10, "-128") ?? panic("read")
    assert((write_string(x, 16, 100) ?? "") == "-80")
    assert(write_string(x, 10, 4) == .Err(.BufferTooSmall))
    assert(read_string(16, "12g") == .Err(.InvalidCharacter))
    assert(read_string(17, "1") == .Err(.BadInput))
    z: read_string(10, "-0") ?? panic("read -0")
    assert(z.s == 1 && bitlen(z) == 0)
    b: read_binary([U8]{0x01, 0x02, 0x03}) ?? panic("read_binary")
    be: write_binary(b, 5) ?? panic("write_binary")
    assert(be == [U8]{0x00, 0x00, 0x01, 0x02, 0x03})
    le: write_binary_le(b, 4) ?? panic("write_binary_le")
    assert(le == [U8]{0x03, 0x02, 0x01, 0x00})
    assert(write_binary(b, 2) == .Err(.BufferTooSmall))
    text: write_file_text("v = ", x, 16) ?? panic("write_file_text")
    assert(text == "v = -80\r\n")
    back: read_file_data(16, text.bytes()) ?? panic("read_file_data")
    assert((write_string(back, 10, 100) ?? "") == "128")
    assert(read_file_data(16, [U8]{}) == .Err(.FileIO))
}

#Test("Exponentiation, inverse and gcd reject the inputs mbedtls rejects") {
    rr := mpi()
    assert(exp_mod(from_int(3), from_int(5), from_int(8), rr) == .Err(.BadInput))
    assert(exp_mod(from_int(3), from_int(-1), from_int(7), rr) == .Err(.BadInput))
    r: exp_mod(from_int(-3), from_int(3), from_int(7), rr) ?? panic("exp_mod")
    assert(cmp_int(r, 1) == 0)
    assert(inv_mod(from_int(2), from_int(4)) == .Err(.NotAcceptable))
    i: inv_mod(from_int(3), from_int(8)) ?? panic("inv_mod even")
    assert(cmp_int(i, 3) == 0)
    assert(div_int(from_int(1), 0) == .Err(.DivisionByZero))
    assert(gcd_modinv_odd(from_int(3), from_int(1), true) == .Err(.BadInput))
}

/// A generator of `left` draws of 0xFF bytes, then failures: below a
/// small bound every draw is rejected.
FailingDraws: struct {
    left: Int
}

impl FailingDraws.RNG {
    fill: fn(&self, out: &[U8]) -> Bool Never! {
        if self.left == 0 -> return false
        self.left -= 1
        loop i in 0..<out.len() -> out[i] = U8{0xFF}
        true
    }
}

#Test("A failed or exhausted random draw leaves no rejected draw in its output") {
    n: [U64]{U64{5}}
    lefts: [Int]{0, 3, 1000}
    loop left in lefts {
        x := [U64]{U64{0x5A5A5A5A5A5A5A5A}}
        rng := FailingDraws{left: left}
        if left == 1000 {
            assert(core_random(x, U64{1}, n, 1, rng) == .Err(.NotAcceptable))
        } else {
            assert(core_random(x, U64{1}, n, 1, rng) == .Err(.Random))
        }
        assert(x[0] == (U64{0}))
    }
}
