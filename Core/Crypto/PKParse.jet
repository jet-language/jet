// Private Core source part: parsing public and private keys.
//
// A port of mbedtls 3.6.7's pkparse.c with PEM, PKCS #5 and PKCS #12 and
// MBEDTLS_PK_PARSE_EC_EXTENDED: SubjectPublicKeyInfo, PKCS#1 RSA keys, SEC1
// EC keys with named or specified curves, RFC 8410 X25519 and X448 keys,
// and PKCS#8 keys, plain or encrypted with PBES2 or a PKCS #12 PBE scheme,
// each as DER or PEM.
//
// mbedtls reads PEM only from a NUL-terminated buffer; here every input is
// tried as PEM text up to its first NUL byte, and a DER key holds no PEM
// header before it. The file loaders (mbedtls_pk_parse_keyfile and
// mbedtls_pk_parse_public_keyfile) are left to the caller, who reads the
// file and passes its bytes.
use {
    core
    cipher: __core_crypto_cipher
    bn: __core_crypto_bignum
    __core_crypto_bignum.[RNG]
    asn1: __core_crypto_asn1
    oids: __core_crypto_oid
    ecp: __core_crypto_ecp
    rsa: __core_crypto_rsa
    pem: __core_crypto_pem
    pkcs5: __core_crypto_pkcs5
    pkcs12: __core_crypto_pkcs12
    pk: __core_crypto_pk
}

// The SEQUENCE tag, constructed.
SEQUENCE: 0x30

/// The algorithm, parameters and RFC 8410 curve of an AlgorithmIdentifier.
PKAlg: struct {
    kind: oids.PKType
    params: asn1.ASN1Buf
    grp: ecp.GroupID
}

// ---------------------------------------------------------------------------
// EC parameters
// ---------------------------------------------------------------------------

// pk_group_from_specified and pk_group_id_from_group: the curve of the
// library whose P, A, B, N, G.X and the parity of G.Y a SpecifiedECDomain
// (SEC 1 C.2) gives. Only a prime field is supported, and the base point
// must be compressed, as mbedtls reads it into a group with no curve yet.
group_id_from_specified: fn(data: [U8], params: asn1.ASN1Buf) -> ecp.GroupID pk.PKError! {
    p := params.p
    end: params.p + params.len
    ver: asn1.get_int(data, p, end) ?? return Err(.KeyInvalidFormat(Val(err)))
    if ver < 1 || ver > 3 -> return Err(.KeyInvalidFormat(None))
    field_len: asn1.get_tag(data, p, end, SEQUENCE) ?? return Err(.Asn1(err))
    end_field: p + field_len
    oid_len: asn1.get_tag(data, p, end_field, asn1.ASN1_OID) ?? return Err(.Asn1(err))
    if !oids.is(oids.OID_ANSI_X9_62_PRIME_FIELD, data, asn1.ASN1Buf{tag_id: asn1.ASN1_OID, p: p, len: oid_len}) -> return Err(.FeatureUnavailable)
    p += oid_len
    prime: asn1.get_mpi(data, p, end_field) ?? return Err(.KeyInvalidFormat(Val(err)))
    pbits: bn.bitlen(prime)
    if p != end_field -> return Err(.KeyInvalidFormat(Val(.LengthMismatch)))
    curve_len: asn1.get_tag(data, p, end, SEQUENCE) ?? return Err(.Asn1(err))
    end_curve: p + curve_len
    a_len: asn1.get_tag(data, p, end_curve, asn1.ASN1_OCTET_STRING) ?? return Err(.KeyInvalidFormat(Val(err)))
    a: bn.read_binary(cipher.bytes_of(data, p, a_len)) ?? return Err(.KeyInvalidFormat(Val(.Mpi(err))))
    p += a_len
    b_len: asn1.get_tag(data, p, end_curve, asn1.ASN1_OCTET_STRING) ?? return Err(.KeyInvalidFormat(Val(err)))
    b: bn.read_binary(cipher.bytes_of(data, p, b_len)) ?? return Err(.KeyInvalidFormat(Val(.Mpi(err))))
    p += b_len
    // The optional seed is skipped.
    if asn1.get_tag(data, p, end_curve, asn1.ASN1_BIT_STRING) == {
        .Ok(seed_len) -> p += seed_len
        .Err(_) -> {}
    }
    if p != end_curve -> return Err(.KeyInvalidFormat(Val(.LengthMismatch)))
    g_len: asn1.get_tag(data, p, end, asn1.ASN1_OCTET_STRING) ?? return Err(.KeyInvalidFormat(Val(err)))
    if g_len < 1 || (data[p] != (U8{2}) && data[p] != (U8{3})) || g_len != bn.size(prime) + 1 -> return Err(.KeyInvalidFormat(None))
    gx: bn.read_binary(cipher.bytes_of(data, p + 1, g_len - 1)) ?? return Err(.KeyInvalidFormat(Val(.Mpi(err))))
    gy_parity: Int.from_u8(data[p]) - 2
    p += g_len
    order: asn1.get_mpi(data, p, end) ?? return Err(.KeyInvalidFormat(Val(err)))
    nbits: bn.bitlen(order)
    // Optional elements after the order are allowed.
    loop id in ecp.grp_id_list() {
        known: ecp.group_load(id) ?? return Err(.Ecp(err))
        same_field: pbits == known.pbits && nbits == known.nbits && bn.cmp_mpi(prime, known.p) == 0
        same_curve: bn.cmp_mpi(a, known.a) == 0 && bn.cmp_mpi(b, known.b) == 0 && bn.cmp_mpi(order, known.n) == 0
        same_base: bn.cmp_mpi(gx, known.g.x) == 0 && bn.cmp_int(known.g.z, 1) == 0 && gy_parity == bn.get_bit(known.g.y, 0)
        if same_field && same_curve && same_base -> return Ok(id)
    }
    Err(.Ecp(.FeatureUnavailable))
}

// pk_get_ecparams: ECParameters, a namedCurve OID or a SpecifiedECDomain
// SEQUENCE, that must end at `end`.
get_ecparams: fn(data: [U8], p: &Int, end: Int) -> asn1.ASN1Buf pk.PKError! {
    if end - p < 1 -> return Err(.KeyInvalidFormat(Val(.OutOfData)))
    tag_id: Int.from_u8(data[p])
    if tag_id != asn1.ASN1_OID && tag_id != SEQUENCE -> return Err(.KeyInvalidFormat(Val(.UnexpectedTag)))
    len: asn1.get_tag(data, p, end, tag_id) ?? return Err(.KeyInvalidFormat(Val(err)))
    params: asn1.ASN1Buf{tag_id: tag_id, p: p, len: len}
    p += len
    if p != end -> return Err(.KeyInvalidFormat(Val(.LengthMismatch)))
    Ok(params)
}

// pk_use_ecparams: load the curve the parameters name or specify.
use_ecparams: fn(data: [U8], params: asn1.ASN1Buf, key: &pk.PKContext) pk.PKError! {
    id := ecp.GroupID.Unknown
    if {
        params.tag_id == asn1.ASN1_OID -> id = oids.ec_grp(data, params) ?? return Err(.UnknownNamedCurve)
        else -> id = group_id_from_specified(data, params)
    }
    pk.pk_ecc_set_group(key, id)
}

// pk_use_ecparams_rfc8410: an X25519 or X448 AlgorithmIdentifier has no
// parameters.
use_ecparams_rfc8410: fn(params: asn1.ASN1Buf, id: ecp.GroupID, key: &pk.PKContext) pk.PKError! {
    if params.tag_id != 0 || params.len != 0 -> return Err(.KeyInvalidFormat(None))
    pk.pk_ecc_set_group(key, id)
}

// pk_parse_key_rfc8410_der: the CurvePrivateKey OCTET STRING in
// data[at..at + len], which must end at `end`; the public key is derived.
parse_key_rfc8410_der: fn<R: RNG>(key: &pk.PKContext, data: [U8], at: Int, len: Int, end: Int, rng: &R) pk.PKError! {
    p := at
    key_len: asn1.get_tag(data, p, at + len, asn1.ASN1_OCTET_STRING) ?? return Err(.KeyInvalidFormat(Val(err)))
    if p + key_len != end -> return Err(.KeyInvalidFormat(None))
    pk.pk_ecc_set_key(key, cipher.bytes_of(data, p, key_len))
    pk.pk_ecc_set_pubkey_from_prv(key, rng)
}

// ---------------------------------------------------------------------------
// SubjectPublicKeyInfo
// ---------------------------------------------------------------------------

// pk_get_pk_alg: the key algorithm of an AlgorithmIdentifier, an RFC 8410
// curve OID being an EC key on that curve. RSA takes no parameters but NULL.
get_pk_alg: fn(data: [U8], p: &Int, end: Int) -> PKAlg pk.PKError! {
    got: asn1.get_alg(data, p, end) ?? return Err(.InvalidAlg(Val(err)))
    kind := oids.PKType.RSA
    grp := ecp.GroupID.Unknown
    if oids.pk_alg(data, got.alg) == {
        .Ok(k) -> kind = k
        .Err(_) -> {
            grp = oids.ec_grp_algid(data, got.alg) ?? return Err(.UnknownPKAlg)
            kind = .ECKey
        }
    }
    if kind == .RSA && ((got.params.tag_id != asn1.ASN1_NULL && got.params.tag_id != 0) || got.params.len != 0) -> return Err(.InvalidAlg(None))
    Ok(PKAlg{kind: kind, params: got.params, grp: grp})
}

/// The key of the SubjectPublicKeyInfo at data[p..end]; p moves past it
/// (mbedtls_pk_parse_subpubkey).
pk_parse_subpubkey: fn(data: [U8], p: &Int, end: Int) -> pk.PKContext pk.PKError! {
    len: asn1.get_tag(data, p, end, SEQUENCE) ?? return Err(.KeyInvalidFormat(Val(err)))
    info_end: p + len
    alg: get_pk_alg(data, p, info_end)
    bits_len: asn1.get_bitstring_null(data, p, info_end) ?? return Err(.InvalidPubkey(Val(err)))
    if p + bits_len != info_end -> return Err(.InvalidPubkey(Val(.LengthMismatch)))
    kind: pk.pk_info_from_type(alg.kind) ?? return Err(.UnknownPKAlg)
    key := pk.pk_new()
    pk.pk_setup(key, Val(kind))
    body: cipher.bytes_of(data, p, info_end - p)
    if kind == {
        .RSA -> {
            if rsa.rsa_parse_pubkey(body) == {
                .Ok(r) -> key.rsa = r
                .Err(e) -> {
                    if e == {
                        .Asn1(a) -> return Err(.InvalidPubkey(Val(a)))
                        else -> return Err(.InvalidPubkey(None))
                    }
                }
            }
        }
        .ECKey | .ECKeyDH -> {
            if {
                pk.is_rfc8410_group(alg.grp) -> use_ecparams_rfc8410(alg.params, alg.grp, key)
                else -> use_ecparams(data, alg.params, key)
            }
            pk.pk_ecc_set_pubkey(key, body)
        }
        else -> return Err(.UnknownPKAlg)
    }
    p = info_end
    Ok(key)
}

// ---------------------------------------------------------------------------
// Private keys
// ---------------------------------------------------------------------------

// pk_parse_key_sec1_der: an ECPrivateKey (RFC 5915). The curve comes from
// the optional parameters or was set before; the public key from the
// optional publicKey, or from the private value when it is absent or
// compressed on a curve that cannot decompress it.
parse_key_sec1_der: fn<R: RNG>(key: &pk.PKContext, data: [U8], rng: &R) pk.PKError! {
    p := 0
    len: asn1.get_tag(data, p, data.len(), SEQUENCE) ?? return Err(.KeyInvalidFormat(Val(err)))
    end: p + len
    version: asn1.get_int(data, p, end) ?? return Err(.KeyInvalidFormat(Val(err)))
    if version != 1 -> return Err(.KeyInvalidVersion)
    d_len: asn1.get_tag(data, p, end, asn1.ASN1_OCTET_STRING) ?? return Err(.KeyInvalidFormat(Val(err)))
    d_at: p
    p += d_len
    pubkey_done := false
    if p != end {
        if asn1.get_tag(data, p, end, asn1.ASN1_CONTEXT_SPECIFIC.bit_or(asn1.ASN1_CONSTRUCTED)) == {
            .Ok(params_len) -> {
                params_end: p + params_len
                params: get_ecparams(data, p, params_end)
                use_ecparams(data, params, key)
            }
            .Err(e) -> {
                if e != .UnexpectedTag -> return Err(.KeyInvalidFormat(Val(e)))
            }
        }
    }
    pk.pk_ecc_set_key(key, cipher.bytes_of(data, d_at, d_len))
    if p != end {
        if asn1.get_tag(data, p, end, asn1.ASN1_CONTEXT_SPECIFIC.bit_or(asn1.ASN1_CONSTRUCTED).bit_or(1)) == {
            .Ok(pub_len) -> {
                end2: p + pub_len
                bits_len: asn1.get_bitstring_null(data, p, end2) ?? return Err(.KeyInvalidFormat(Val(err)))
                if p + bits_len != end2 -> return Err(.KeyInvalidFormat(Val(.LengthMismatch)))
                if pk.pk_ecc_set_pubkey(key, cipher.bytes_of(data, p, end2 - p)) == {
                    .Ok(_) -> pubkey_done = true
                    .Err(e) -> {
                        if e != .Ecp(.FeatureUnavailable) -> return Err(.KeyInvalidFormat(None))
                    }
                }
            }
            .Err(e) -> {
                if e != .UnexpectedTag -> return Err(.KeyInvalidFormat(Val(e)))
            }
        }
    }
    if !pubkey_done -> pk.pk_ecc_set_pubkey_from_prv(key, rng)
}

// pk_parse_key_pkcs8_unencrypted_der: a PrivateKeyInfo (RFC 5208) holding
// an RSA, SEC1 EC or RFC 8410 key, that must fill data.
parse_key_pkcs8_unencrypted_der: fn<R: RNG>(data: [U8], rng: &R) -> pk.PKContext pk.PKError! {
    p := 0
    len: asn1.get_tag(data, p, data.len(), SEQUENCE) ?? return Err(.KeyInvalidFormat(Val(err)))
    end: p + len
    version: asn1.get_int(data, p, end) ?? return Err(.KeyInvalidFormat(Val(err)))
    if version != 0 -> return Err(.KeyInvalidVersion)
    alg: get_pk_alg(data, p, end)
    key_len: asn1.get_tag(data, p, end, asn1.ASN1_OCTET_STRING) ?? return Err(.KeyInvalidFormat(Val(err)))
    if key_len < 1 -> return Err(.KeyInvalidFormat(Val(.OutOfData)))
    kind: pk.pk_info_from_type(alg.kind) ?? return Err(.UnknownPKAlg)
    key := pk.pk_new()
    pk.pk_setup(key, Val(kind))
    body: cipher.bytes_of(data, p, key_len)
    if kind == {
        .RSA -> key.rsa = rsa.rsa_parse_key(body) ?? return Err(.RSA(err))
        .ECKey | .ECKeyDH -> {
            if {
                pk.is_rfc8410_group(alg.grp) -> {
                    use_ecparams_rfc8410(alg.params, alg.grp, key)
                    parse_key_rfc8410_der(key, data, p, key_len, end, rng)
                }
                else -> {
                    use_ecparams(data, alg.params, key)
                    parse_key_sec1_der(key, body, rng)
                }
            }
        }
        else -> return Err(.UnknownPKAlg)
    }
    if p + key_len != data.len() -> return Err(.KeyInvalidFormat(Val(.LengthMismatch)))
    Ok(key)
}

/// The key of an EncryptedPrivateKeyInfo (PKCS#8) under `pwd`: PBES2 or a
/// PKCS #12 PBE scheme decrypts a PrivateKeyInfo
/// (mbedtls_pk_parse_key_pkcs8_encrypted_der). A wrong password is
/// PasswordMismatch.
pk_parse_key_pkcs8_encrypted_der: fn<R: RNG>(data: [U8], pwd: [U8], rng: &R) -> pk.PKContext pk.PKError! {
    if pwd.len() == 0 -> return Err(.PasswordRequired)
    p := 0
    len: asn1.get_tag(data, p, data.len(), SEQUENCE) ?? return Err(.KeyInvalidFormat(Val(err)))
    end: p + len
    pbe: asn1.get_alg(data, p, end) ?? return Err(.KeyInvalidFormat(Val(err)))
    enc_len: asn1.get_tag(data, p, end, asn1.ASN1_OCTET_STRING) ?? return Err(.KeyInvalidFormat(Val(err)))
    enc: cipher.bytes_of(data, p, enc_len)
    plain := [U8]{}
    if pkcs12.pbe_alg(data, pbe.alg) == {
        .Val(scheme) -> {
            plain = pkcs12.pkcs12_pbe(data, pbe.params, .Decrypt, scheme.info, scheme.md, pwd, enc) ?? return Err(pkcs12_refusal(err))
        }
        .None -> {
            if !oids.is(oids.OID_PKCS5_PBES2, data, pbe.alg) -> return Err(.FeatureUnavailable)
            plain = pkcs5.pbes2(data, pbe.params, .Decrypt, pwd, enc) ?? return Err(pkcs5_refusal(err))
        }
    }
    if parse_key_pkcs8_unencrypted_der(plain, rng) == {
        .Ok(key) -> {
            core.crypto.wipe(plain)
            Ok(key)
        }
        .Err(e) -> {
            core.crypto.wipe(plain)
            Err(e)
        }
    }
}

// A PBE failure as mbedtls reports it: a wrong password as PK's, the rest
// as the scheme's.
pkcs12_refusal: fn(e: pkcs5.PBEError) -> pk.PKError Never! {
    if e == .PasswordMismatch -> return pk.PKError.PasswordMismatch
    pk.PKError.PKCS12(e)
}

pkcs5_refusal: fn(e: pkcs5.PBEError) -> pk.PKError Never! {
    if e == .PasswordMismatch -> return pk.PKError.PasswordMismatch
    pk.PKError.PKCS5(e)
}

// A PEM read that found no block passes; any other failure is the key's,
// a password one as PK's when the block was read with the password.
pem_absent: fn(e: pem.PEMError, with_password: Bool{false}) pk.PKError! {
    if e != .NoHeaderFooterPresent {
        if with_password && e == .PasswordMismatch -> return Err(.PasswordMismatch)
        if with_password && e == .PasswordRequired -> return Err(.PasswordRequired)
        return Err(.PEM(e))
    }
}

// An RSA key set up from a PKCS#1 RSAPrivateKey.
rsa_private_key: fn(der: [U8]) -> pk.PKContext pk.PKError! {
    key := pk.pk_new()
    pk.pk_setup(key, Val(.RSA))
    key.rsa = rsa.rsa_parse_key(der) ?? return Err(.RSA(err))
    Ok(key)
}

// An EC key set up from a SEC1 ECPrivateKey.
ec_private_key: fn<R: RNG>(der: [U8], rng: &R) -> pk.PKContext pk.PKError! {
    key := pk.pk_new()
    pk.pk_setup(key, Val(.ECKey))
    parse_key_sec1_der(key, der, rng)
    Ok(key)
}

/// A private key in any format mbedtls reads, PEM first: PKCS#1 RSA and
/// SEC1 EC (with `pwd` for an encrypted block), PKCS#8, and encrypted
/// PKCS#8; then DER, trying encrypted PKCS#8 when a password is given,
/// PKCS#8, PKCS#1 and SEC1 in turn (mbedtls_pk_parse_key). A DER key no
/// parser takes is KeyInvalidFormat.
pk_parse_key: fn<R: RNG>(key: [U8], pwd: [U8]?, rng: &R) -> pk.PKContext pk.PKError! {
    if key.len() == 0 -> return Err(.KeyInvalidFormat(None))
    if pem.pem_read_buffer("-----BEGIN RSA PRIVATE KEY-----", "-----END RSA PRIVATE KEY-----", key, pwd) == {
        .Ok(block) -> return rsa_private_key(block.der)
        .Err(e) -> pem_absent(e, with_password: true) ?? return Err(err)
    }
    if pem.pem_read_buffer("-----BEGIN EC PRIVATE KEY-----", "-----END EC PRIVATE KEY-----", key, pwd) == {
        .Ok(block) -> return ec_private_key(block.der, rng)
        .Err(e) -> pem_absent(e, with_password: true) ?? return Err(err)
    }
    if pem.pem_read_buffer("-----BEGIN PRIVATE KEY-----", "-----END PRIVATE KEY-----", key, None) == {
        .Ok(block) -> return parse_key_pkcs8_unencrypted_der(block.der, rng)
        .Err(e) -> pem_absent(e) ?? return Err(err)
    }
    password: pwd ?? [U8]{}
    if pem.pem_read_buffer("-----BEGIN ENCRYPTED PRIVATE KEY-----", "-----END ENCRYPTED PRIVATE KEY-----", key, None) == {
        .Ok(block) -> return pk_parse_key_pkcs8_encrypted_der(block.der, password, rng)
        .Err(e) -> pem_absent(e) ?? return Err(err)
    }
    if password.len() != 0 {
        if pk_parse_key_pkcs8_encrypted_der(key, password, rng) == {
            .Ok(parsed) -> return Ok(parsed)
            .Err(e) -> {
                if e == .PasswordMismatch -> return Err(e)
            }
        }
    }
    if parse_key_pkcs8_unencrypted_der(key, rng) == {
        .Ok(parsed) -> return Ok(parsed)
        .Err(_) -> {}
    }
    if rsa_private_key(key) == {
        .Ok(parsed) -> return Ok(parsed)
        .Err(_) -> {}
    }
    if ec_private_key(key, rng) == {
        .Ok(parsed) -> return Ok(parsed)
        .Err(_) -> {}
    }
    Err(.KeyInvalidFormat(None))
}

/// A public key: PEM PKCS#1 RSAPublicKey or SubjectPublicKeyInfo, else DER
/// RSAPublicKey or SubjectPublicKeyInfo (mbedtls_pk_parse_public_key).
pk_parse_public_key: fn(key: [U8]) -> pk.PKContext pk.PKError! {
    if key.len() == 0 -> return Err(.KeyInvalidFormat(None))
    if pem.pem_read_buffer("-----BEGIN RSA PUBLIC KEY-----", "-----END RSA PUBLIC KEY-----", key, None) == {
        .Ok(block) -> {
            parsed := pk.pk_new()
            pk.pk_setup(parsed, Val(.RSA))
            parsed.rsa = rsa.rsa_parse_pubkey(block.der) ?? return Err(.RSA(err))
            return Ok(parsed)
        }
        .Err(e) -> pem_absent(e) ?? return Err(err)
    }
    if pem.pem_read_buffer("-----BEGIN PUBLIC KEY-----", "-----END PUBLIC KEY-----", key, None) == {
        .Ok(block) -> {
            p := 0
            return pk_parse_subpubkey(block.der, p, block.der.len())
        }
        .Err(e) -> pem_absent(e) ?? return Err(err)
    }
    if rsa.rsa_parse_pubkey(key) == {
        .Ok(r) -> {
            parsed := pk.pk_new()
            pk.pk_setup(parsed, Val(.RSA))
            parsed.rsa = r
            return Ok(parsed)
        }
        .Err(e) -> {
            if e != .Asn1(.UnexpectedTag) -> return Err(.RSA(e))
        }
    }
    p := 0
    pk_parse_subpubkey(key, p, key.len())
}

#Test("A SubjectPublicKeyInfo on a named curve parses, and broken encodings fail as mbedtls does") {
    // secp256r1 generator point as an id-ecPublicKey SubjectPublicKeyInfo.
    der: [U8]{
        0x30, 0x59, 0x30, 0x13, 0x06, 0x07, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01, 0x06, 0x08, 0x2a,
        0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07, 0x03, 0x42, 0x00, 0x04, 0x6b, 0x17, 0xd1, 0xf2, 0xe1,
        0x2c, 0x42, 0x47, 0xf8, 0xbc, 0xe6, 0xe5, 0x63, 0xa4, 0x40, 0xf2, 0x77, 0x03, 0x7d, 0x81, 0x2d,
        0xeb, 0x33, 0xa0, 0xf4, 0xa1, 0x39, 0x45, 0xd8, 0x98, 0xc2, 0x96, 0x4f, 0xe3, 0x42, 0xe2, 0xfe,
        0x1a, 0x7f, 0x9b, 0x8e, 0xe7, 0xeb, 0x4a, 0x7c, 0x0f, 0x9e, 0x16, 0x2b, 0xce, 0x33, 0x57, 0x6b,
        0x31, 0x5e, 0xce, 0xcb, 0xb6, 0x40, 0x68, 0x37, 0xbf, 0x51, 0xf5
    }
    key: pk_parse_public_key(der) ?? panic("parse")
    assert(pk.pk_get_name(key) == "EC" && pk.pk_get_bitlen(key) == 256 && key.ec.grp.id == .Secp256r1)
    assert(refusal(pk_parse_public_key([U8]{})) == Val(.KeyInvalidFormat(None)))
    // The DER RSAPublicKey reader sees the truncated outer SEQUENCE first.
    assert(refusal(pk_parse_public_key(cipher.bytes_of(der, 0, der.len() - 1))) == Val(.RSA(.Asn1(.OutOfData))))
}

// The error of a parse, None when it succeeded.
refusal: fn(got: pk.PKContext pk.PKError!) -> pk.PKError? Never! {
    if got == {
        .Ok(_) -> None
        .Err(e) -> Val(e)
    }
}
