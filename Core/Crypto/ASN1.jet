// SPDX-License-Identifier: Apache-2.0
// Translated from Mbed TLS 3.6.7 (library/asn1parse.c, library/asn1write.c); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: DER parsing and writing.
//
// A port of mbedtls 3.6.7's asn1parse.c and asn1write.c. A reader walks
// `data` from the cursor `p` up to `end`, and each call moves the cursor past
// what it took, as the C functions move `*p`. A writer fills `buf` backwards
// from the cursor `p` down to `start` and returns the byte count it wrote, so
// nested structures are written innermost first. Parsed items refer to their
// bytes by offset into the parsed buffer.
use {
    core
    cipher: __core_crypto_cipher
    bn: __core_crypto_bignum
}

/// DER tags (ITU X.690).
ASN1_BOOLEAN: 0x01
ASN1_INTEGER: 0x02
ASN1_BIT_STRING: 0x03
ASN1_OCTET_STRING: 0x04
ASN1_NULL: 0x05
ASN1_OID: 0x06
ASN1_ENUMERATED: 0x0A
ASN1_UTF8_STRING: 0x0C
ASN1_SEQUENCE: 0x10
ASN1_SET: 0x11
ASN1_PRINTABLE_STRING: 0x13
ASN1_T61_STRING: 0x14
ASN1_IA5_STRING: 0x16
ASN1_UTC_TIME: 0x17
ASN1_GENERALIZED_TIME: 0x18
ASN1_UNIVERSAL_STRING: 0x1C
ASN1_BMP_STRING: 0x1E
ASN1_PRIMITIVE: 0x00
ASN1_CONSTRUCTED: 0x20
ASN1_CONTEXT_SPECIFIC: 0x80

/// The class, primitive/constructed and number fields of a tag byte.
ASN1_TAG_CLASS_MASK: 0xC0
ASN1_TAG_PC_MASK: 0x20
ASN1_TAG_VALUE_MASK: 0x1F

/// Why a DER item could not be read or written (MBEDTLS_ERR_ASN1_*).
#Error
ASN1Error: enum {
    /// The input ends inside the item (OUT_OF_DATA).
    OutOfData
    /// The item has another tag (UNEXPECTED_TAG).
    UnexpectedTag
    /// A malformed length, or a value out of range (INVALID_LENGTH).
    InvalidLength
    /// The item does not end where its container does (LENGTH_MISMATCH).
    LengthMismatch
    /// The content is not valid for the type (INVALID_DATA).
    InvalidData
    /// The output buffer has too little room (BUF_TOO_SMALL).
    BufTooSmall
    /// A sequence visitor stopped the walk with this code.
    Stopped(Int)
    /// Reading or writing a big number failed.
    Mpi(bn.MpiError)
}

impl bn.MpiError -> ASN1Error { ASN1Error.Mpi(self) }

/// An item's tag and the offset and length of its content in the parsed
/// buffer (mbedtls_asn1_buf). `p` is -1 for an absent item.
ASN1Buf: struct {
    tag_id: Int
    p: Int
    len: Int
}

/// The absent item: no tag, no content.
asn1_none: fn() -> ASN1Buf Never! { ASN1Buf{tag_id: 0, p: -1, len: 0} }

/// A BIT STRING's content after the unused-bits byte (mbedtls_asn1_bitstring).
ASN1Bitstring: struct {
    len: Int
    unused_bits: Int
    p: Int
}

/// An OID and its value, one attribute of a name or one extension
/// (mbedtls_asn1_named_data). In a list the first entry is the head;
/// `next_merged` joins an entry with the next into one multi-valued RDN.
NamedData: struct {
    oid: [U8]
    val_tag: Int
    val: [U8]
    next_merged: Bool
}

/// Whether `tag_id` is one of the string types X.509 names may hold
/// (MBEDTLS_ASN1_IS_STRING_TAG).
is_string_tag: fn(tag_id: Int) -> Bool Never! {
    if tag_id < 0 || tag_id >= 32 -> return false
    strings: (1 << ASN1_BMP_STRING).bit_or(1 << ASN1_UTF8_STRING).bit_or(1 << ASN1_T61_STRING)
        .bit_or(1 << ASN1_IA5_STRING).bit_or(1 << ASN1_UNIVERSAL_STRING).bit_or(1 << ASN1_PRINTABLE_STRING)
    (1 << tag_id).bit_and(strings) != 0
}

/// Whether the content of `buf` in `data` is the encoded OID `oid`
/// (the negation of MBEDTLS_OID_CMP).
oid_is: fn(oid: [U8], data: [U8], buf: ASN1Buf) -> Bool Never! {
    if buf.len != oid.len() || buf.p < 0 -> return false
    loop i in 0..<oid.len() {
        if layout_byte(data, buf.p + i) != oid[i] -> return false
    }
    true
}

// ---------------------------------------------------------------------------
// Parsing.

/// data[at], a byte of a DER item's layout: a tag or length byte, the
/// content of a small INTEGER (a version or a count), a BIT STRING's
/// unused-bits count or an OID byte. The parsers read the layout through it
/// alone; key material is copied out whole (cipher.bytes_of) and read by
/// its own parser. In a private key the layout around the key material
/// holds no key bit, so the emission check takes this byte as public.
layout_byte: fn(data: [U8], at: Int) -> U8 Never! { data[at] }

/// A definite length of at most four bytes, which must fit before `end`
/// (mbedtls_asn1_get_len).
get_len: fn(data: [U8], p: &Int, end: Int) -> Int ASN1Error! {
    if end - p < 1 -> return Err(.OutOfData)
    first: Int.from_u8(layout_byte(data, p))
    len := 0
    if first.bit_and(0x80) == 0 {
        len = first
        p += 1
    } else {
        n: first.bit_and(0x7F)
        if n == 0 || n > 4 -> return Err(.InvalidLength)
        if end - p <= n -> return Err(.OutOfData)
        p += 1
        loop _ in 0..<n {
            len = (len << 8).bit_or(Int.from_u8(layout_byte(data, p)))
            p += 1
        }
    }
    if len > end - p -> return Err(.OutOfData)
    Ok(len)
}

/// The length of an item that must carry `tag_id` (mbedtls_asn1_get_tag).
get_tag: fn(data: [U8], p: &Int, end: Int, tag_id: Int) -> Int ASN1Error! {
    if end - p < 1 -> return Err(.OutOfData)
    if Int.from_u8(layout_byte(data, p)) != tag_id -> return Err(.UnexpectedTag)
    p += 1
    len: get_len(data, p, end)
    Ok(len)
}

/// A BOOLEAN; any non-zero byte is true (mbedtls_asn1_get_bool).
get_bool: fn(data: [U8], p: &Int, end: Int) -> Bool ASN1Error! {
    len: get_tag(data, p, end, ASN1_BOOLEAN)
    if len != 1 -> return Err(.InvalidLength)
    val: data[p] != (U8{0})
    p += 1
    Ok(val)
}

/// A non-negative INTEGER or ENUMERATED that fits a 32-bit int; leading
/// zero bytes are skipped, negative values refused.
get_tagged_int: fn(data: [U8], p: &Int, end: Int, tag_id: Int) -> Int ASN1Error! {
    len := get_tag(data, p, end, tag_id)
    // An empty content is malformed: zero is 020100.
    if len == 0 -> return Err(.InvalidLength)
    if layout_byte(data, p).bit_and(U8{0x80}) != (U8{0}) -> return Err(.InvalidLength)
    loop len > 0 && layout_byte(data, p) == (U8{0}) {
        p += 1
        len -= 1
    }
    if len > 4 -> return Err(.InvalidLength)
    if len == 4 && layout_byte(data, p).bit_and(U8{0x80}) != (U8{0}) -> return Err(.InvalidLength)
    val := 0
    loop _ in 0..<len {
        val = (val << 8).bit_or(Int.from_u8(layout_byte(data, p)))
        p += 1
    }
    Ok(val)
}

/// A non-negative INTEGER that fits a 32-bit int (mbedtls_asn1_get_int).
get_int: fn(data: [U8], p: &Int, end: Int) -> Int ASN1Error! {
    val: get_tagged_int(data, p, end, ASN1_INTEGER)
    Ok(val)
}

/// A non-negative ENUMERATED that fits a 32-bit int (mbedtls_asn1_get_enum).
get_enum: fn(data: [U8], p: &Int, end: Int) -> Int ASN1Error! {
    val: get_tagged_int(data, p, end, ASN1_ENUMERATED)
    Ok(val)
}

/// An INTEGER as a big number. The content is read as unsigned, so a
/// negative INTEGER gives its two's-complement bytes, and an empty content
/// gives zero (mbedtls_asn1_get_mpi).
get_mpi: fn(data: [U8], p: &Int, end: Int) -> bn.Mpi ASN1Error! {
    len: get_tag(data, p, end, ASN1_INTEGER)
    bytes: cipher.bytes_of(data, p, len)
    p += len
    x: bn.read_binary(bytes)
    Ok(x)
}

/// A BIT STRING that must end at `end` (mbedtls_asn1_get_bitstring).
get_bitstring: fn(data: [U8], p: &Int, end: Int) -> ASN1Bitstring ASN1Error! {
    len := get_tag(data, p, end, ASN1_BIT_STRING)
    if len < 1 -> return Err(.OutOfData)
    len -= 1
    unused: Int.from_u8(layout_byte(data, p))
    if unused > 7 -> return Err(.InvalidLength)
    p += 1
    bs: ASN1Bitstring{len: len, unused_bits: unused, p: p}
    p += len
    if p != end -> return Err(.LengthMismatch)
    Ok(bs)
}

/// A BIT STRING with no unused bits, the cursor left on its content; the
/// content length (mbedtls_asn1_get_bitstring_null).
get_bitstring_null: fn(data: [U8], p: &Int, end: Int) -> Int ASN1Error! {
    len := get_tag(data, p, end, ASN1_BIT_STRING)
    if len == 0 -> return Err(.InvalidData)
    len -= 1
    if layout_byte(data, p) != (U8{0}) -> return Err(.InvalidData)
    p += 1
    Ok(len)
}

/// What mbedtls_asn1_traverse_sequence_of calls for each entry it accepts:
/// the entry's tag and the offset and length of its content. A result other
/// than 0 ends the walk with ASN1Error.Stopped of that code.
SequenceVisitor: trait {
    visit: fn(&self, tag_id: Int, start: Int, len: Int) -> Int Never!
}

/// Walk a SEQUENCE that must end at `end`. Every entry's tag must satisfy
/// tag & must_mask == must_val; `visitor` sees the entries whose tag
/// satisfies tag & may_mask == may_val (mbedtls_asn1_traverse_sequence_of).
traverse_sequence_of: fn<V: SequenceVisitor>(data: [U8], p: &Int, end: Int, must_mask: Int, must_val: Int, may_mask: Int, may_val: Int, visitor: &V) ASN1Error! {
    len := get_tag(data, p, end, ASN1_CONSTRUCTED.bit_or(ASN1_SEQUENCE))
    if p + len != end -> return Err(.LengthMismatch)
    loop p < end {
        tag_id: Int.from_u8(layout_byte(data, p))
        p += 1
        if tag_id.bit_and(must_mask) != must_val -> return Err(.UnexpectedTag)
        len = get_len(data, p, end)
        if tag_id.bit_and(may_mask) == may_val {
            code: visitor.visit(tag_id, p, len)
            if code != 0 -> return Err(.Stopped(code))
        }
        p += len
    }
}

/// Collects the entries of a SEQUENCE OF.
SequenceItems: struct {
    items: [ASN1Buf]
}

impl SequenceItems.SequenceVisitor {
    visit: fn(&self, tag_id: Int, start: Int, len: Int) -> Int Never! {
        self.items.push(ASN1Buf{tag_id: tag_id, p: start, len: len})
        0
    }
}

/// The entries of a SEQUENCE OF items that all carry `tag_id`, in order;
/// empty for an empty sequence (mbedtls_asn1_get_sequence_of).
get_sequence_of: fn(data: [U8], p: &Int, end: Int, tag_id: Int) -> [ASN1Buf] ASN1Error! {
    seq := SequenceItems{items: [ASN1Buf]{}}
    traverse_sequence_of(data, p, end, 0xFF, tag_id, 0, 0, seq)
    Ok(seq.items.move())
}

/// An AlgorithmIdentifier: the OID, and the parameters, asn1_none() when there
/// are none (mbedtls_asn1_get_alg).
get_alg: fn(data: [U8], p: &Int, end: Int) -> (alg: ASN1Buf, params: ASN1Buf) ASN1Error! {
    len: get_tag(data, p, end, ASN1_CONSTRUCTED.bit_or(ASN1_SEQUENCE))
    if end - p < 1 -> return Err(.OutOfData)
    alg_tag: Int.from_u8(layout_byte(data, p))
    seq_end: p + len
    alg_len: get_tag(data, p, seq_end, ASN1_OID)
    alg: ASN1Buf{tag_id: alg_tag, p: p, len: alg_len}
    p += alg_len
    if p == seq_end -> return Ok((alg: alg, params: asn1_none()))
    params_tag: Int.from_u8(layout_byte(data, p))
    p += 1
    params_len: get_len(data, p, seq_end)
    params: ASN1Buf{tag_id: params_tag, p: p, len: params_len}
    p += params_len
    if p != seq_end -> return Err(.LengthMismatch)
    Ok((alg: alg, params: params))
}

/// An AlgorithmIdentifier whose parameters are NULL or absent
/// (mbedtls_asn1_get_alg_null).
get_alg_null: fn(data: [U8], p: &Int, end: Int) -> ASN1Buf ASN1Error! {
    got: get_alg(data, p, end)
    if (got.params.tag_id != ASN1_NULL && got.params.tag_id != 0) || got.params.len != 0 -> return Err(.InvalidData)
    Ok(got.alg)
}

/// The index of the first entry of `list` with OID `oid`
/// (mbedtls_asn1_find_named_data).
find_named_data: fn(list: [NamedData], oid: [U8]) -> Int? {
    loop i in 0..<list.len() {
        if list[i].oid == oid -> return Val(i)
    }
    None
}

// ---------------------------------------------------------------------------
// Writing: each call writes before the cursor and moves it back.

/// A definite length, short form below 0x80 (mbedtls_asn1_write_len).
write_len: fn(buf: &[U8], p: &Int, start: Int, len: Int) -> Int ASN1Error! {
    if len < 0 || len > 0xFFFFFFFF -> return Err(.InvalidLength)
    required := 1
    if len >= 0x80 {
        l := len
        loop l != 0 {
            required += 1
            l >>= 8
        }
    }
    if required > p - start -> return Err(.BufTooSmall)
    v := len
    p -= 1
    buf[p] = U8{v.bit_and(0xFF)}
    v >>= 8
    loop v != 0 {
        p -= 1
        buf[p] = U8{v.bit_and(0xFF)}
        v >>= 8
    }
    if required > 1 {
        p -= 1
        buf[p] = U8{0x80 + required - 1}
    }
    Ok(required)
}

/// One tag byte (mbedtls_asn1_write_tag).
write_tag: fn(buf: &[U8], p: &Int, start: Int, tag_id: Int) -> Int ASN1Error! {
    if p - start < 1 -> return Err(.BufTooSmall)
    p -= 1
    buf[p] = U8{tag_id.bit_and(0xFF)}
    Ok(1)
}

/// The length and tag before `len` content bytes already written; the total.
write_len_and_tag: fn(buf: &[U8], p: &Int, start: Int, len: Int, tag_id: Int) -> Int ASN1Error! {
    n: write_len(buf, p, start, len)
    t: write_tag(buf, p, start, tag_id)
    Ok(len + n + t)
}

/// `bytes` verbatim (mbedtls_asn1_write_raw_buffer).
write_raw_buffer: fn(buf: &[U8], p: &Int, start: Int, bytes: [U8]) -> Int ASN1Error! {
    if p < start || p - start < bytes.len() -> return Err(.BufTooSmall)
    p -= bytes.len()
    loop i in 0..<bytes.len() -> buf[p + i] = bytes[i]
    Ok(bytes.len())
}

/// An INTEGER holding |x|, with a leading zero byte when a non-negative
/// value's top bit is set; zero is 020100 (mbedtls_asn1_write_mpi).
write_mpi: fn(buf: &[U8], p: &Int, start: Int, x: bn.Mpi) -> Int ASN1Error! {
    len := bn.size(x)
    if len == 0 -> len = 1
    if p < start || p - start < len -> return Err(.BufTooSmall)
    bytes: bn.write_binary(x, len)
    p -= len
    loop i in 0..<len -> buf[p + i] = bytes[i]
    if x.s == 1 && buf[p].bit_and(U8{0x80}) != (U8{0}) {
        if p - start < 1 -> return Err(.BufTooSmall)
        p -= 1
        buf[p] = U8{0}
        len += 1
    }
    total: write_len_and_tag(buf, p, start, len, ASN1_INTEGER)
    Ok(total)
}

/// NULL (mbedtls_asn1_write_null).
write_null: fn(buf: &[U8], p: &Int, start: Int) -> Int ASN1Error! {
    total: write_len_and_tag(buf, p, start, 0, ASN1_NULL)
    Ok(total)
}

/// An OBJECT IDENTIFIER from its encoded content (mbedtls_asn1_write_oid).
write_oid: fn(buf: &[U8], p: &Int, start: Int, oid: [U8]) -> Int ASN1Error! {
    len: write_raw_buffer(buf, p, start, oid)
    total: write_len_and_tag(buf, p, start, len, ASN1_OID)
    Ok(total)
}

/// An AlgorithmIdentifier around parameters of `par_len` bytes already
/// written; with `has_par` and no parameters, a NULL is written for them
/// (mbedtls_asn1_write_algorithm_identifier_ext).
write_algorithm_identifier_ext: fn(buf: &[U8], p: &Int, start: Int, oid: [U8], par_len: Int, has_par: Bool{true}) -> Int ASN1Error! {
    len := 0
    if has_par {
        if par_len == 0 {
            len += write_null(buf, p, start)
        } else {
            len += par_len
        }
    }
    len += write_oid(buf, p, start, oid)
    total: write_len_and_tag(buf, p, start, len, ASN1_CONSTRUCTED.bit_or(ASN1_SEQUENCE))
    Ok(total)
}

/// An AlgorithmIdentifier with parameters (mbedtls_asn1_write_algorithm_identifier).
write_algorithm_identifier: fn(buf: &[U8], p: &Int, start: Int, oid: [U8], par_len: Int) -> Int ASN1Error! {
    total: write_algorithm_identifier_ext(buf, p, start, oid, par_len)
    Ok(total)
}

/// A BOOLEAN, true as 0xFF (mbedtls_asn1_write_bool).
write_bool: fn(buf: &[U8], p: &Int, start: Int, value: Bool) -> Int ASN1Error! {
    if p - start < 1 -> return Err(.BufTooSmall)
    p -= 1
    buf[p] = if value -> U8{0xFF} else -> U8{0}
    total: write_len_and_tag(buf, p, start, 1, ASN1_BOOLEAN)
    Ok(total)
}

/// An INTEGER or ENUMERATED of a 32-bit int. A negative value writes only
/// its low byte, as mbedtls does.
write_tagged_int: fn(buf: &[U8], p: &Int, start: Int, value: Int, tag_id: Int) -> Int ASN1Error! {
    len := 0
    v := value
    if p - start < 1 -> return Err(.BufTooSmall)
    len += 1
    p -= 1
    buf[p] = U8{v.bit_and(0xFF)}
    v >>= 8
    loop v > 0 {
        if p - start < 1 -> return Err(.BufTooSmall)
        len += 1
        p -= 1
        buf[p] = U8{v.bit_and(0xFF)}
        v >>= 8
    }
    if buf[p].bit_and(U8{0x80}) != (U8{0}) {
        if p - start < 1 -> return Err(.BufTooSmall)
        p -= 1
        buf[p] = U8{0}
        len += 1
    }
    total: write_len_and_tag(buf, p, start, len, tag_id)
    Ok(total)
}

/// An INTEGER (mbedtls_asn1_write_int).
write_int: fn(buf: &[U8], p: &Int, start: Int, value: Int) -> Int ASN1Error! {
    total: write_tagged_int(buf, p, start, value, ASN1_INTEGER)
    Ok(total)
}

/// An ENUMERATED (mbedtls_asn1_write_enum).
write_enum: fn(buf: &[U8], p: &Int, start: Int, value: Int) -> Int ASN1Error! {
    total: write_tagged_int(buf, p, start, value, ASN1_ENUMERATED)
    Ok(total)
}

/// `text` under `tag_id` (mbedtls_asn1_write_tagged_string).
write_tagged_string: fn(buf: &[U8], p: &Int, start: Int, tag_id: Int, text: [U8]) -> Int ASN1Error! {
    len: write_raw_buffer(buf, p, start, text)
    total: write_len_and_tag(buf, p, start, len, tag_id)
    Ok(total)
}

/// A UTF8String (mbedtls_asn1_write_utf8_string).
write_utf8_string: fn(buf: &[U8], p: &Int, start: Int, text: [U8]) -> Int ASN1Error! {
    total: write_tagged_string(buf, p, start, ASN1_UTF8_STRING, text)
    Ok(total)
}

/// A PrintableString (mbedtls_asn1_write_printable_string).
write_printable_string: fn(buf: &[U8], p: &Int, start: Int, text: [U8]) -> Int ASN1Error! {
    total: write_tagged_string(buf, p, start, ASN1_PRINTABLE_STRING, text)
    Ok(total)
}

/// An IA5String (mbedtls_asn1_write_ia5_string).
write_ia5_string: fn(buf: &[U8], p: &Int, start: Int, text: [U8]) -> Int ASN1Error! {
    total: write_tagged_string(buf, p, start, ASN1_IA5_STRING, text)
    Ok(total)
}

/// A named BIT STRING of the first `bits` bits of `bytes`: trailing zero bits
/// are dropped, as DER requires (mbedtls_asn1_write_named_bitstring).
write_named_bitstring: fn(buf: &[U8], p: &Int, start: Int, bytes: [U8], bits: Int) -> Int ASN1Error! {
    byte_len: (bits + 7) /% 8
    unused_bits: byte_len * 8 - bits
    n := bits
    if n != 0 {
        cur := byte_len - 1
        shifted := bytes[cur] >> unused_bits
        loop {
            bit: shifted.bit_and(U8{1})
            shifted >>= 1
            if bit != (U8{0}) -> break
            n -= 1
            if n == 0 -> break
            if n %% 8 == 0 {
                cur -= 1
                shifted = bytes[cur]
            }
        }
    }
    total: write_bitstring(buf, p, start, bytes, n)
    Ok(total)
}

/// A BIT STRING of the first `bits` bits of `bytes`, the unused bits of its
/// last byte cleared (mbedtls_asn1_write_bitstring).
write_bitstring: fn(buf: &[U8], p: &Int, start: Int, bytes: [U8], bits: Int) -> Int ASN1Error! {
    byte_len := (bits + 7) /% 8
    unused_bits: byte_len * 8 - bits
    if p < start || p - start < byte_len + 1 -> return Err(.BufTooSmall)
    len: byte_len + 1
    if byte_len > 0 {
        byte_len -= 1
        p -= 1
        buf[p] = bytes[byte_len].bit_and(((U8{1} << unused_bits) - U8{1}).bit_not())
        p -= byte_len
        loop i in 0..<byte_len -> buf[p + i] = bytes[i]
    }
    p -= 1
    buf[p] = U8{unused_bits}
    total: write_len_and_tag(buf, p, start, len, ASN1_BIT_STRING)
    Ok(total)
}

/// An OCTET STRING (mbedtls_asn1_write_octet_string).
write_octet_string: fn(buf: &[U8], p: &Int, start: Int, bytes: [U8]) -> Int ASN1Error! {
    len: write_raw_buffer(buf, p, start, bytes)
    total: write_len_and_tag(buf, p, start, len, ASN1_OCTET_STRING)
    Ok(total)
}

/// Set the value of the entry with OID `oid` to a copy of `val`, adding the
/// entry at the head of `list` when there is none; the entry's index
/// (mbedtls_asn1_store_named_data).
store_named_data: fn(list: &[NamedData], oid: [U8], val: [U8]) -> Int Never! {
    if find_named_data(list, oid) == .Val(at) {
        list[at].val = val.copy()
        return at
    }
    list.insert(0, NamedData{oid: oid.copy(), val_tag: 0, val: val.copy(), next_merged: false})
    0
}

#Test("An INTEGER written backwards reads back to the same value and end") {
    buf := cipher.zero_bytes(32)
    p := 32
    n: write_int(buf, p, 0, 0x1234) ?? panic("write_int")
    assert(n == 4 && p == 28)
    v: get_int(buf, p, 32) ?? panic("get_int")
    assert(v == 0x1234 && p == 32)
}
