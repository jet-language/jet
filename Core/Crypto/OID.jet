// Translated from Mbed TLS 3.6.7 (library/oid.c, include/mbedtls/oid.h); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: object identifiers.
//
// A port of mbedtls 3.6.7's oid.c and the OID values of oid.h. An OID is the
// DER content of an OBJECT IDENTIFIER, without tag and length. The lookups
// take the parsed buffer and the item's ASN1Buf, as the parsers hold them, and
// answer with the algorithm or attribute the OID names; the reverse lookups
// give the OID for an algorithm. The PBES2 and PKCS#12 cipher tables live with
// the cipher layer they name, in the pkcs5 and pkcs12 parts.
use {
    core
    asn1: __core_crypto_asn1
    hashes: __core_crypto_md
    ecp: __core_crypto_ecp
}

/// Why an OID lookup failed (MBEDTLS_ERR_OID_*).
#Error
OIDError: enum {
    /// No table row has this OID or this algorithm (NOT_FOUND).
    NotFound
}

/// The public-key algorithm an OID names (mbedtls_pk_type_t, without NONE).
PKType: enum {
    RSA
    ECKey
    ECKeyDH
    ECDSA
    RSAAlt
    RSASSAPSS
    Opaque
}

/// One bit per X.509 v3 extension (MBEDTLS_OID_X509_EXT_*), the set a
/// certificate records in its extension mask.
X509_EXT_AUTHORITY_KEY_IDENTIFIER: 0x1
X509_EXT_SUBJECT_KEY_IDENTIFIER: 0x2
X509_EXT_KEY_USAGE: 0x4
X509_EXT_CERTIFICATE_POLICIES: 0x8
X509_EXT_POLICY_MAPPINGS: 0x10
X509_EXT_SUBJECT_ALT_NAME: 0x20
X509_EXT_ISSUER_ALT_NAME: 0x40
X509_EXT_SUBJECT_DIRECTORY_ATTRS: 0x80
X509_EXT_BASIC_CONSTRAINTS: 0x100
X509_EXT_NAME_CONSTRAINTS: 0x200
X509_EXT_POLICY_CONSTRAINTS: 0x400
X509_EXT_EXTENDED_KEY_USAGE: 0x800
X509_EXT_CRL_DISTRIBUTION_POINTS: 0x1000
X509_EXT_INIHIBIT_ANYPOLICY: 0x2000
X509_EXT_FRESHEST_CRL: 0x4000
X509_EXT_NS_CERT_TYPE: 0x10000

/// The largest number of components an OID string may have
/// (MBEDTLS_OID_MAX_COMPONENTS).
OID_MAX_COMPONENTS: 128

/// The OIDs of oid.h that the library uses, expanded to their DER content.
OID_AT_CN: [U8]{0x55, 0x04, 0x03}
OID_AT_SUR_NAME: [U8]{0x55, 0x04, 0x04}
OID_AT_SERIAL_NUMBER: [U8]{0x55, 0x04, 0x05}
