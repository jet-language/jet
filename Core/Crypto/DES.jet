// SPDX-License-Identifier: Apache-2.0
// Translated from Mbed TLS 3.6.7 (library/des.c); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: DES and Triple-DES (FIPS 46-3, NIST SP 800-67).
//
// A port of mbedtls 3.6.7's des.c: the single-DES and two- and three-key
// Triple-DES (EDE) key schedules, ECB and CBC, the key parity helpers and
// the weak-key table. As in mbedtls, the rounds index the expanded S-box
// tables with key-dependent data: DES has no constant-time form here, and
// is kept for legacy interoperability (PKCS #12, PKCS #5 PBES2, old
// cipher suites).
use {
    core
    cipher: __core_crypto_cipher
}

/// Why a DES operation failed.
#Error
DESError: enum {
    /// The data, or an IV, is not whole 8-byte blocks
    /// (MBEDTLS_ERR_DES_INVALID_INPUT_LENGTH, -0x0032).
    InvalidInputLength
    /// The key is not the 8, 16 or 24 bytes its schedule takes; C takes
    /// fixed-size arrays.
    InvalidKeyLength
}

/// The direction of a CBC operation (MBEDTLS_DES_ENCRYPT, MBEDTLS_DES_DECRYPT).
DESMode: enum {
    Encrypt
    Decrypt
}

/// The bytes of a single DES key, parity bits included.
DES_KEY_SIZE: 8
/// The bytes of a DES block.
DES_BLOCK_SIZE: 8

/// An expanded DES or Triple-DES key: 32 subkey words per DES pass, in the
/// order the key's direction runs them; one pass for DES, three for
/// Triple-DES (mbedtls_des_context, mbedtls_des3_context).
DESKey: struct {
    sk: [U32]
}

impl DESKey.Close {
    close: fn(&&self) {
        sk := self.sk.move()
        loop i in 0..<sk.len() -> sk[i] = U32{0}
    }
}

// The expanded S-boxes: SB1..SB8 fold each S-box with the P permutation.
SB1: [U32]{
    0x01010400, 0x00000000, 0x00010000, 0x01010404, 0x01010004, 0x00010404, 0x00000004, 0x00010000,
    0x00000400, 0x01010400, 0x01010404, 0x00000400, 0x01000404, 0x01010004, 0x01000000, 0x00000004,
    0x00000404, 0x01000400, 0x01000400, 0x00010400, 0x00010400, 0x01010000, 0x01010000, 0x01000404,
    0x00010004, 0x01000004, 0x01000004, 0x00010004, 0x00000000, 0x00000404, 0x00010404, 0x01000000,
    0x00010000, 0x01010404, 0x00000004, 0x01010000, 0x01010400, 0x01000000, 0x01000000, 0x00000400,
    0x01010004, 0x00010000, 0x00010400, 0x01000004, 0x00000400, 0x00000004, 0x01000404, 0x00010404,
    0x01010404, 0x00010004, 0x01010000, 0x01000404, 0x01000004, 0x00000404, 0x00010404, 0x01010400,
    0x00000404, 0x01000400, 0x01000400, 0x00000000, 0x00010004, 0x00010400, 0x00000000, 0x01010004,
