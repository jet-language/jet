// SPDX-License-Identifier: Apache-2.0
// Translated from Mbed TLS 3.6.7 (library/x509_crt.c); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: X.509 certificates.
//
// A port of mbedtls 3.6.7's x509_crt.c: Certificate and TBSCertificate
// (RFC 5280 section 4.1) with the v3 extensions mbedtls reads (basic
// constraints, key usage, extended key usage, subject and authority key
// identifiers, subject alternative names, Netscape certificate type and
// certificate policies), PEM bundles, mbedtls_x509_crt_info, the key usage
// checks, and chain verification with its profiles, CRL checks and name
// checks.
//
// A certificate keeps its own copy of the DER (`raw`); every ASN1Buf in it
// is an offset into `raw`. A chain is a list, the leaf first, as mbedtls
// chains them through `next`.
use {
    core
    cipher: __core_crypto_cipher
    hashes: __core_crypto_md
    asn1: __core_crypto_asn1
    oids: __core_crypto_oid
    ecp: __core_crypto_ecp
    pk: __core_crypto_pk
    pkparse: __core_crypto_pkparse
    pem: __core_crypto_pem
    x509: __core_crypto_x509
    x509crl: __core_crypto_x509crl
}

/// An AuthorityKeyIdentifier (mbedtls_x509_authority): the keyIdentifier,
/// and the authorityCertIssuer GeneralNames with the
/// authorityCertSerialNumber, which come together or not at all.
X509Authority: struct {
    key_identifier: asn1.ASN1Buf
    authority_cert_issuer: [asn1.ASN1Buf]
    authority_cert_serial_number: asn1.ASN1Buf
}

/// One parsed certificate (mbedtls_x509_crt).
/// - `raw`: the certificate's DER, which every buffer below indexes.
/// - `version`: 1, 2 or 3.
/// - `issuer_raw`, `subject_raw`: the names' DER, compared when chaining.
/// - `ext_types`: the oid X509_EXT_* bits of the extensions present.
/// - `max_pathlen`: the basicConstraints pathLenConstraint plus one, zero
///   when unlimited.
/// - `sig_md`, `sig_pk`, `sig_opts`: the signature algorithm, with the
///   RSASSA-PSS options when it is RSASSA-PSS.
X509Crt: struct {
    raw: [U8]
    tbs: asn1.ASN1Buf
    version: Int
    serial: asn1.ASN1Buf
    sig_oid: asn1.ASN1Buf
    issuer_raw: asn1.ASN1Buf
    subject_raw: asn1.ASN1Buf
    issuer: [asn1.NamedData]
    subject: [asn1.NamedData]
    valid_from: x509.X509Time
    valid_to: x509.X509Time
    pk_raw: asn1.ASN1Buf
    pk: pk.PKContext
    issuer_id: asn1.ASN1Buf
    subject_id: asn1.ASN1Buf
    v3_ext: asn1.ASN1Buf
    subject_alt_names: [asn1.ASN1Buf]
    subject_key_id: asn1.ASN1Buf
    authority_key_id: X509Authority
    certificate_policies: [asn1.ASN1Buf]
    ext_types: Int
    ca_istrue: Bool
    max_pathlen: Int
    key_usage: Int
    ext_key_usage: [asn1.ASN1Buf]
    ns_cert_type: Int
    sig: asn1.ASN1Buf
    sig_md: hashes.Md?
    sig_pk: oids.PKType?
    sig_opts: pk.PSSOptions?
}

/// A handler for the extensions mbedtls does not know
/// (mbedtls_x509_crt_ext_cb_t). `call` gets the certificate so far, its DER,
/// the extension's OID, whether it is critical, and the extnValue content
/// data[p..<end]. An error fails the parse when the extension is critical.
/// The handler is pure, so the TLS engine can parse with it.
X509ExtCallback: struct {
    call: fn(X509Crt, [U8], asn1.ASN1Buf, Bool, Int, Int) x509.X509Error! -[]>
}

// The SEQUENCE tag, constructed.
X509CRT_SEQUENCE: 0x30

/// An empty certificate (mbedtls_x509_crt_init).
x509_crt_new: fn() -> X509Crt Never! {
    X509Crt{
        raw: [U8]{}
        tbs: asn1.asn1_none()
        version: 0
        serial: asn1.asn1_none()
        sig_oid: asn1.asn1_none()
        issuer_raw: asn1.asn1_none()
        subject_raw: asn1.asn1_none()
        issuer: [asn1.NamedData]{}
        subject: [asn1.NamedData]{}
        valid_from: x509.X509Time{year: 0, mon: 0, day: 0, hour: 0, min: 0, sec: 0}
        valid_to: x509.X509Time{year: 0, mon: 0, day: 0, hour: 0, min: 0, sec: 0}
        pk_raw: asn1.asn1_none()
        pk: pk.pk_new()
        issuer_id: asn1.asn1_none()
        subject_id: asn1.asn1_none()
        v3_ext: asn1.asn1_none()
        subject_alt_names: [asn1.ASN1Buf]{}
        subject_key_id: asn1.asn1_none()
        authority_key_id: X509Authority{key_identifier: asn1.asn1_none(), authority_cert_issuer: [asn1.ASN1Buf]{}, authority_cert_serial_number: asn1.asn1_none()}
        certificate_policies: [asn1.ASN1Buf]{}
        ext_types: 0
        ca_istrue: false
        max_pathlen: 0
        key_usage: 0
        ext_key_usage: [asn1.ASN1Buf]{}
        ns_cert_type: 0
        sig: asn1.asn1_none()
        sig_md: None
        sig_pk: None
        sig_opts: None
    }
}

// x509_get_version: the explicit [0] version, v1 (0) when absent.
x509_crt_get_version: fn(data: [U8], p: &Int, end: Int) -> Int x509.X509Error! {
    if asn1.get_tag(data, p, end, x509.x509_explicit(0)) == {
        .Ok(len) -> {
            v_end: p + len
            ver: asn1.get_int(data, p, v_end) ?? return Err(.InvalidVersion(Val(err)))
            if p != v_end -> return Err(.InvalidVersion(Val(.LengthMismatch)))
            Ok(ver)
        }
        .Err(e) -> {
            if e == .UnexpectedTag -> return Ok(0)
            Err(.InvalidFormat(Val(e)))
        }
    }
}

// x509_get_dates: Validity, notBefore then notAfter.
x509_crt_get_dates: fn(data: [U8], p: &Int, end: Int) -> (from: x509.X509Time, to: x509.X509Time) x509.X509Error! {
    len: asn1.get_tag(data, p, end, X509CRT_SEQUENCE) ?? return Err(.InvalidDate(Val(err)))
    d_end: p + len
    from: x509.x509_get_time(data, p, d_end)
    to: x509.x509_get_time(data, p, d_end)
    if p != d_end -> return Err(.InvalidDate(Val(.LengthMismatch)))
    Ok((from: from, to: to))
}

// x509_get_uid: an implicit [n] unique identifier, kept unparsed; none
// when absent.
x509_crt_get_uid: fn(data: [U8], p: &Int, end: Int, n: Int) -> asn1.ASN1Buf x509.X509Error! {
    if p == end -> return Ok(asn1.asn1_none())
    tag_id: Int{data[p]}
    if asn1.get_tag(data, p, end, x509.x509_explicit(n)) == {
        .Ok(len) -> {
            uid: asn1.ASN1Buf{tag_id: tag_id, p: p, len: len}
            p += len
            Ok(uid)
        }
        .Err(e) -> {
            if e == .UnexpectedTag -> return Ok(asn1.asn1_none())
            Err(.InvalidFormat(Val(e)))
        }
    }
}

// x509_get_basic_constraints: cA, which must be a BOOLEAN when the
// SEQUENCE is not empty, and the pathLenConstraint plus one.
x509_crt_get_basic_constraints: fn(data: [U8], p: &Int, end: Int) -> (ca: Bool, max_pathlen: Int) x509.X509Error! {
    len: asn1.get_tag(data, p, end, X509CRT_SEQUENCE) ?? return Err(.InvalidExtensions(Val(err)))
    if p == end -> return Ok((ca: false, max_pathlen: 0))
    if end - p != len -> return Err(.InvalidExtensions(None))
    ca: asn1.get_bool(data, p, end) ?? return Err(.InvalidExtensions(Val(err)))
    if p == end -> return Ok((ca: ca, max_pathlen: 0))
    max_pathlen: asn1.get_int(data, p, end) ?? return Err(.InvalidExtensions(Val(err)))
    if p != end -> return Err(.InvalidExtensions(Val(.LengthMismatch)))
    if max_pathlen == 0x7FFFFFFF -> return Err(.InvalidExtensions(Val(.InvalidLength)))
    Ok((ca: ca, max_pathlen: max_pathlen + 1))
}

// x509_get_ext_key_usage: one or more KeyPurposeId OIDs.
x509_crt_get_ext_key_usage: fn(data: [U8], p: &Int, end: Int) -> [asn1.ASN1Buf] x509.X509Error! {
    usages: asn1.get_sequence_of(data, p, end, asn1.ASN1_OID) ?? return Err(.InvalidExtensions(Val(err)))
    if usages.len() == 0 -> return Err(.InvalidExtensions(Val(.InvalidLength)))
    Ok(usages)
}

// x509_get_subject_key_id: the KeyIdentifier OCTET STRING, which must fill
// the extension.
x509_crt_get_subject_key_id: fn(data: [U8], p: &Int, end: Int) -> asn1.ASN1Buf x509.X509Error! {
    len: asn1.get_tag(data, p, end, asn1.ASN1_OCTET_STRING) ?? return Err(.InvalidExtensions(Val(err)))
    id: asn1.ASN1Buf{tag_id: asn1.ASN1_OCTET_STRING, p: p, len: len}
    p += len
    if p != end -> return Err(.InvalidExtensions(Val(.LengthMismatch)))
    Ok(id)
}

// x509_get_authority_key_id: the optional [0] keyIdentifier, then the [1]
// authorityCertIssuer and [2] authorityCertSerialNumber together.
x509_crt_get_authority_key_id: fn(data: [U8], p: &Int, end: Int) -> X509Authority x509.X509Error! {
    out := X509Authority{key_identifier: asn1.asn1_none(), authority_cert_issuer: [asn1.ASN1Buf]{}, authority_cert_serial_number: asn1.asn1_none()}
    len := asn1.get_tag(data, p, end, X509CRT_SEQUENCE) ?? return Err(.InvalidExtensions(Val(err)))
    if p + len != end -> return Err(.InvalidExtensions(Val(.LengthMismatch)))
    if asn1.get_tag(data, p, end, asn1.ASN1_CONTEXT_SPECIFIC) == {
        .Ok(id_len) -> {
            // The [0] content is the KeyIdentifier OCTET STRING's.
            out.key_identifier = asn1.ASN1Buf{tag_id: asn1.ASN1_OCTET_STRING, p: p, len: id_len}
            p += id_len
        }
        .Err(e) -> {
            if e != .UnexpectedTag -> return Err(.InvalidExtensions(Val(e)))
        }
    }
    if p < end {
        len = asn1.get_tag(data, p, end, x509.x509_explicit(1)) ?? return Err(.InvalidExtensions(Val(err)))
        out.authority_cert_issuer = x509.x509_get_subject_alt_name_ext(data, p, p + len)
        len = asn1.get_tag(data, p, end, asn1.ASN1_CONTEXT_SPECIFIC.bit_or(2)) ?? return Err(.InvalidExtensions(Val(err)))
        out.authority_cert_serial_number = asn1.ASN1Buf{tag_id: asn1.ASN1_INTEGER, p: p, len: len}
        p += len
    }
    if p != end -> return Err(.InvalidExtensions(Val(.LengthMismatch)))
    Ok(out)
}

// x509_get_certificate_policies: each PolicyInformation's OID, its
// qualifiers skipped. Any policy other than anyPolicy makes the result
// FeatureUnavailable once the whole extension has been read; `policies`
// holds them either way.
x509_crt_get_certificate_policies: fn(data: [U8], p: &Int, end: Int, policies: &[asn1.ASN1Buf]) x509.X509Error! {
    len := asn1.get_tag(data, p, end, X509CRT_SEQUENCE) ?? return Err(.InvalidExtensions(Val(err)))
    if p + len != end -> return Err(.InvalidExtensions(Val(.LengthMismatch)))
    if len == 0 -> return Err(.InvalidExtensions(Val(.LengthMismatch)))
    unsupported := false
    loop p < end {
        len = asn1.get_tag(data, p, end, X509CRT_SEQUENCE) ?? return Err(.InvalidExtensions(Val(err)))
        policy_end: p + len
        len = asn1.get_tag(data, p, policy_end, asn1.ASN1_OID) ?? return Err(.InvalidExtensions(Val(err)))
        policy: asn1.ASN1Buf{tag_id: asn1.ASN1_OID, p: p, len: len}
        if !oids.is(oids.OID_ANY_POLICY, data, policy) -> unsupported = true
        policies.push(policy)
        p += len
        if p < policy_end {
            len = asn1.get_tag(data, p, policy_end, X509CRT_SEQUENCE) ?? return Err(.InvalidExtensions(Val(err)))
            p += len
        }
        if p != policy_end -> return Err(.InvalidExtensions(Val(.LengthMismatch)))
    }
    if p != end -> return Err(.InvalidExtensions(Val(.LengthMismatch)))
    if unsupported -> return Err(.FeatureUnavailable(None))
}

// x509_get_crt_ext: the explicit [3] Extensions. An extension the OID
// table lacks goes to the callback, or is skipped unless critical; a known
// one may appear once.
x509_crt_get_ext: fn(crt: &X509Crt, data: [U8], p: &Int, end: Int, cb: X509ExtCallback?) x509.X509Error! {
    if p == end -> return
    crt.v3_ext = x509.x509_get_ext(data, p, end, 3)
    exts_end: crt.v3_ext.p + crt.v3_ext.len
    loop p < exts_end {
        len := asn1.get_tag(data, p, exts_end, X509CRT_SEQUENCE) ?? return Err(.InvalidExtensions(Val(err)))
        end_ext_data: p + len
        len = asn1.get_tag(data, p, end_ext_data, asn1.ASN1_OID) ?? return Err(.InvalidExtensions(Val(err)))
        extn_oid: asn1.ASN1Buf{tag_id: asn1.ASN1_OID, p: p, len: len}
        p += len
        is_critical := false
        if asn1.get_bool(data, p, end_ext_data) == {
            .Ok(value) -> is_critical = value
            .Err(e) -> {
                if e != .UnexpectedTag -> return Err(.InvalidExtensions(Val(e)))
            }
        }
        len = asn1.get_tag(data, p, end_ext_data, asn1.ASN1_OCTET_STRING) ?? return Err(.InvalidExtensions(Val(err)))
        start_ext_octet: p
        end_ext_octet: p + len
        if end_ext_octet != end_ext_data -> return Err(.InvalidExtensions(Val(.LengthMismatch)))
        ext_type: oids.x509_ext_type(data, extn_oid) ?? 0
        if ext_type == 0 {
            given := cb
            if given == {
                .Val(handler) -> {
                    call: handler.call
                    if call(crt, data, extn_oid, is_critical, p, end_ext_octet) == {
                        .Err(e) -> {
                            if is_critical -> return Err(e)
                        }
                        .Ok(_) -> {}
                    }
                }
                .None -> {
                    if is_critical -> return Err(.InvalidExtensions(Val(.UnexpectedTag)))
                }
            }
            p = end_ext_octet
            next
        }
        if crt.ext_types.bit_and(ext_type) != 0 -> return Err(.InvalidExtensions(None))
        crt.ext_types = crt.ext_types.bit_or(ext_type)
        if {
            ext_type == oids.X509_EXT_BASIC_CONSTRAINTS -> {
                got: x509_crt_get_basic_constraints(data, p, end_ext_octet)
                crt.ca_istrue = got.ca
                crt.max_pathlen = got.max_pathlen
            }
            ext_type == oids.X509_EXT_KEY_USAGE -> crt.key_usage = x509.x509_get_key_usage(data, p, end_ext_octet)
            ext_type == oids.X509_EXT_EXTENDED_KEY_USAGE -> crt.ext_key_usage = x509_crt_get_ext_key_usage(data, p, end_ext_octet)
            ext_type == oids.X509_EXT_SUBJECT_KEY_IDENTIFIER -> crt.subject_key_id = x509_crt_get_subject_key_id(data, p, end_ext_data)
            ext_type == oids.X509_EXT_AUTHORITY_KEY_IDENTIFIER -> crt.authority_key_id = x509_crt_get_authority_key_id(data, p, end_ext_octet)
            ext_type == oids.X509_EXT_SUBJECT_ALT_NAME -> crt.subject_alt_names = x509.x509_get_subject_alt_name(data, p, end_ext_octet)
            ext_type == oids.X509_EXT_NS_CERT_TYPE -> crt.ns_cert_type = x509.x509_get_ns_cert_type(data, p, end_ext_octet)
            ext_type == oids.X509_EXT_CERTIFICATE_POLICIES -> {
                if x509_crt_get_certificate_policies(data, p, end_ext_octet, crt.certificate_policies) == {
                    .Err(e) -> {
                        // The callback may take a policy mbedtls cannot
                        // enforce; otherwise only a critical one fails.
                        unavailable: if e == {
                            .FeatureUnavailable(_) -> true
                            .UnknownOid | .InvalidFormat(_) | .InvalidVersion(_) | .InvalidSerial(_) | .InvalidAlg(_) | .InvalidAlgOid(_) | .InvalidName(_) | .InvalidDate(_) | .InvalidSignature(_) | .InvalidExtensions(_) | .UnknownVersion | .UnknownSigAlg(_) | .SigMismatch | .CertVerifyFailed(_) | .CertUnknownFormat | .BadInput | .BufferTooSmall | .FatalError | .Callback(_) | .Asn1(_) | .PK(_) | .PEM(_) | .OID(_) -> false
                        }
                        handled := false
                        given := cb
                        if unavailable && given == .Val(handler) {
                            call: handler.call
                            if call(crt, data, extn_oid, is_critical, start_ext_octet, end_ext_octet) == {
                                .Ok(_) -> handled = true
                                .Err(_) -> {}
                            }
                        }
                        if !handled && (is_critical || !unavailable) -> return Err(e)
                    }
                    .Ok(_) -> {}
                }
            }
            else -> {
                // Known to the OID table but not parsed here.
                if is_critical -> return Err(.FeatureUnavailable(None))
                p = end_ext_octet
            }
        }
    }
    if p != exts_end -> return Err(.InvalidExtensions(Val(.LengthMismatch)))
}

// x509_crt_parse_der_core: one Certificate from the start of buf; the
// bytes after it are ignored.
x509_crt_parse_der_core: fn(buf: [U8], cb: X509ExtCallback?) -> X509Crt x509.X509Error! {
    crt := x509_crt_new()
    p := 0
    outer_len: asn1.get_tag(buf, p, buf.len(), X509CRT_SEQUENCE) ?? return Err(.InvalidFormat(None))
    crt_len: p + outer_len
    data: cipher.bytes_of(buf, 0, crt_len)
    crt_end: crt_len
    crt.tbs.p = p
    len := asn1.get_tag(data, p, crt_end, X509CRT_SEQUENCE) ?? return Err(.InvalidFormat(Val(err)))
    end: p + len
    crt.tbs.len = end - crt.tbs.p
    crt.version = x509_crt_get_version(data, p, end)
    crt.serial = x509.x509_get_serial(data, p, end)
    alg1: x509.x509_get_alg(data, p, end)
    crt.sig_oid = alg1.alg
    if crt.version < 0 || crt.version > 2 -> return Err(.UnknownVersion)
    crt.version += 1
    sig_alg: x509.x509_get_sig_alg(data, crt.sig_oid, alg1.params)
    crt.sig_md = sig_alg.md
    crt.sig_pk = Val(sig_alg.pk)
    crt.sig_opts = sig_alg.pss
    // issuer
    crt.issuer_raw.p = p
    len = asn1.get_tag(data, p, end, X509CRT_SEQUENCE) ?? return Err(.InvalidFormat(Val(err)))
    crt.issuer = x509.x509_get_name(data, p, p + len)
    crt.issuer_raw.len = p - crt.issuer_raw.p
    dates: x509_crt_get_dates(data, p, end)
    crt.valid_from = dates.from
    crt.valid_to = dates.to
    // subject, which may be empty
    crt.subject_raw.p = p
    len = asn1.get_tag(data, p, end, X509CRT_SEQUENCE) ?? return Err(.InvalidFormat(Val(err)))
    if len > 0 -> crt.subject = x509.x509_get_name(data, p, p + len)
    crt.subject_raw.len = p - crt.subject_raw.p
    // SubjectPublicKeyInfo
    crt.pk_raw.p = p
    crt.pk = pkparse.pk_parse_subpubkey(data, p, end) ?? return Err(.PK(err))
    crt.pk_raw.len = p - crt.pk_raw.p
    if crt.version == 2 || crt.version == 3 {
        crt.issuer_id = x509_crt_get_uid(data, p, end, 1)
        crt.subject_id = x509_crt_get_uid(data, p, end, 2)
    }
    if crt.version == 3 -> x509_crt_get_ext(crt, data, p, end, cb)
    if p != end -> return Err(.InvalidFormat(Val(.LengthMismatch)))
    // signatureAlgorithm, which must repeat the TBSCertificate's, and
    // signatureValue.
    alg2: x509.x509_get_alg(data, p, crt_end)
    same_oid: crt.sig_oid.len == alg2.alg.len && cipher.bytes_of(data, crt.sig_oid.p, crt.sig_oid.len) == cipher.bytes_of(data, alg2.alg.p, alg2.alg.len)
    same_params: alg1.params.tag_id == alg2.params.tag_id && alg1.params.len == alg2.params.len && (alg1.params.len == 0 || cipher.bytes_of(data, alg1.params.p, alg1.params.len) == cipher.bytes_of(data, alg2.params.p, alg2.params.len))
    if !same_oid || !same_params -> return Err(.SigMismatch)
    crt.sig = x509.x509_get_sig(data, p, crt_end)
    if p != crt_end -> return Err(.InvalidFormat(Val(.LengthMismatch)))
    crt.raw = data
    Ok(crt)
}

/// Parse one DER certificate from the start of buf and append it to chain
/// (mbedtls_x509_crt_parse_der); on failure the chain is unchanged.
x509_crt_parse_der: fn(chain: &[X509Crt], buf: [U8]) x509.X509Error! {
    crt: x509_crt_parse_der_core(buf, None)
    chain.push(crt)
}

/// x509_crt_parse_der with a handler for unknown extensions
/// (mbedtls_x509_crt_parse_der_with_ext_cb).
x509_crt_parse_der_with_ext_cb: fn(chain: &[X509Crt], buf: [U8], cb: X509ExtCallback) x509.X509Error! {
    crt: x509_crt_parse_der_core(buf, Val(cb))
    chain.push(crt)
}

// The PEM armor of a certificate.
X509CRT_PEM_BEGIN: "-----BEGIN CERTIFICATE-----"
X509CRT_PEM_END: "-----END CERTIFICATE-----"

/// One DER certificate, or one or more PEM ones, appended to chain
/// (mbedtls_x509_crt_parse). The input is PEM when its text up to the first
/// NUL byte holds a BEGIN CERTIFICATE line. With PEM, every block that
/// reads is appended, and the result is the number of blocks that did not;
/// when none reads, the first block's failure, or CertUnknownFormat when
/// there is no block.
x509_crt_parse: fn(chain: &[X509Crt], buf: [U8]) -> Int x509.X509Error! {
    if pem.pem_block_len(X509CRT_PEM_BEGIN, X509CRT_PEM_END, buf) == None {
        x509_crt_parse_der(chain, buf)
        return Ok(0)
    }
    success := false
    errors := [x509.X509Error]{}
    rest := buf.copy()
    loop {
        used: pem.pem_block_len(X509CRT_PEM_BEGIN, X509CRT_PEM_END, rest) ?? break
        if pem.pem_read_buffer(X509CRT_PEM_BEGIN, X509CRT_PEM_END, rest, None) == {
            .Ok(block) -> {
                if x509_crt_parse_der(chain, block.der) == {
                    .Ok(_) -> success = true
                    .Err(e) -> errors.push(e)
                }
            }
            .Err(e) -> errors.push(x509.X509Error.PEM(e))
        }
        rest = cipher.bytes_of(rest, used, rest.len() - used)
    }
    if success -> return Ok(errors.len())
    if errors.len() == 0 -> return Err(.CertUnknownFormat)
    Err(errors[0].copy())
}

/// Whether the certificate's basicConstraints say cA; InvalidExtensions
/// when it has none (mbedtls_x509_crt_get_ca_istrue).
x509_crt_get_ca_istrue: fn(crt: X509Crt) -> Bool x509.X509Error! {
    if crt.ext_types.bit_and(oids.X509_EXT_BASIC_CONSTRAINTS) == 0 -> return Err(.InvalidExtensions(None))
    Ok(crt.ca_istrue)
}

/// The bits of `ext_type` among the extensions the certificate holds
/// (mbedtls_x509_crt_has_ext_type).
x509_crt_has_ext_type: fn(crt: X509Crt, ext_type: Int) -> Int Never! { crt.ext_types.bit_and(ext_type) }

// The descriptions of a list of OIDs, "???" for one the table lacks
// (x509_info_ext_key_usage and x509_info_cert_policies).
x509_crt_info_oids: fn(out: &[U8], data: [U8], items: [asn1.ASN1Buf], policies: Bool) {
    sep := ""
    loop item in items {
        desc := "???"
        if policies -> desc = oids.certificate_policies(data, item) ?? "???"
        if !policies -> desc = oids.extended_key_usage(data, item) ?? "???"
        out.extend("{sep}{desc}".bytes())
        sep = ", "
    }
}

/// The text mbedtls prints for a certificate, each line after `prefix`
/// (mbedtls_x509_crt_info).
x509_crt_info: fn(prefix: String, crt: X509Crt) -> [U8] x509.X509Error! {
    data: crt.raw
    out := [U8]{}
    out.extend("{prefix}cert. version     : {crt.version}\n".bytes())
    out.extend("{prefix}serial number     : ".bytes())
    out.extend(x509.x509_serial_gets(data, crt.serial))
    out.extend("\n{prefix}issuer name       : ".bytes())
    out.extend(x509.x509_dn_gets(crt.issuer))
    out.extend("\n{prefix}subject name      : ".bytes())
    out.extend(x509.x509_dn_gets(crt.subject))
    out.extend("\n{prefix}issued  on        : {x509.x509_time_text(crt.valid_from)}".bytes())
    out.extend("\n{prefix}expires on        : {x509.x509_time_text(crt.valid_to)}".bytes())
    out.extend("\n{prefix}signed using      : ".bytes())
    if crt.sig_pk == {
        .Val(kind) -> out.extend(x509.x509_sig_alg_gets(data, crt.sig_oid, x509.X509SigAlg{md: crt.sig_md, pk: kind, pss: crt.sig_opts}))
        .None -> out.extend("???".bytes())
    }
    key_size := x509.x509_key_size_helper(pk.pk_get_name(crt.pk))
    loop key_size.len() < 18 -> key_size = "{key_size} "
    out.extend("\n{prefix}{key_size}: {pk.pk_get_bitlen(crt.pk)} bits".bytes())
    if crt.ext_types.bit_and(oids.X509_EXT_BASIC_CONSTRAINTS) != 0 {
        ca_text: if crt.ca_istrue -> "true" else -> "false"
        out.extend("\n{prefix}basic constraints : CA={ca_text}".bytes())
        if crt.max_pathlen > 0 -> out.extend(", max_pathlen={crt.max_pathlen - 1}".bytes())
    }
    if crt.ext_types.bit_and(oids.X509_EXT_SUBJECT_ALT_NAME) != 0 {
        out.extend("\n{prefix}subject alt name  :".bytes())
        x509.x509_info_subject_alt_name(out, data, crt.subject_alt_names, prefix)
    }
    if crt.ext_types.bit_and(oids.X509_EXT_NS_CERT_TYPE) != 0 {
        out.extend("\n{prefix}cert. type        : ".bytes())
        x509.x509_info_cert_type(out, crt.ns_cert_type)
    }
    if crt.ext_types.bit_and(oids.X509_EXT_KEY_USAGE) != 0 {
        out.extend("\n{prefix}key usage         : ".bytes())
        x509.x509_info_key_usage(out, crt.key_usage)
    }
    if crt.ext_types.bit_and(oids.X509_EXT_EXTENDED_KEY_USAGE) != 0 {
        out.extend("\n{prefix}ext key usage     : ".bytes())
        x509_crt_info_oids(out, data, crt.ext_key_usage, false)
    }
    if crt.ext_types.bit_and(oids.X509_EXT_CERTIFICATE_POLICIES) != 0 {
        out.extend("\n{prefix}certificate policies : ".bytes())
        x509_crt_info_oids(out, data, crt.certificate_policies, true)
    }
    out.extend("\n".bytes())
    Ok(out)
}

/// BadInput unless the certificate allows every usage in `usage`, the
/// encipherOnly and decipherOnly bits only when asked for; a certificate
/// without keyUsage allows all (mbedtls_x509_crt_check_key_usage).
x509_crt_check_key_usage: fn(crt: X509Crt, usage: Int) x509.X509Error! {
    if crt.ext_types.bit_and(oids.X509_EXT_KEY_USAGE) == 0 -> return
    may_mask: x509.X509_KU_ENCIPHER_ONLY.bit_or(x509.X509_KU_DECIPHER_ONLY)
    usage_must: usage - usage.bit_and(may_mask)
    held_must: crt.key_usage - crt.key_usage.bit_and(may_mask)
    if held_must.bit_and(usage_must) != usage_must -> return Err(.BadInput)
    usage_may: usage.bit_and(may_mask)
    if crt.key_usage.bit_and(may_mask).bit_or(usage_may) != usage_may -> return Err(.BadInput)
}

/// BadInput unless the certificate's extendedKeyUsage lists `usage_oid` or
/// anyExtendedKeyUsage; a certificate without the extension allows all
/// (mbedtls_x509_crt_check_extended_key_usage).
x509_crt_check_extended_key_usage: fn(crt: X509Crt, usage_oid: [U8]) x509.X509Error! {
    if crt.ext_types.bit_and(oids.X509_EXT_EXTENDED_KEY_USAGE) == 0 -> return
    loop item in crt.ext_key_usage {
        if asn1.oid_is(usage_oid, crt.raw, item) -> return
        if oids.is(oids.OID_ANY_EXTENDED_KEY_USAGE, crt.raw, item) -> return
    }
    Err(.BadInput)
}

/// A verification profile (mbedtls_x509_crt_profile): the digests,
/// public-key types and curves a chain may use, each a mask of
/// x509_id_flag bits of their mbedtls numbers, and the shortest RSA key in
/// bits.
X509CrtProfile: struct {
    allowed_mds: Int
    allowed_pks: Int
    allowed_curves: Int
    rsa_min_bitlen: Int
}

/// The mask bit of an mbedtls digest, key type or curve number
/// (MBEDTLS_X509_ID_FLAG).
x509_id_flag: fn(id: Int) -> Int Never! { 1 << (id - 1) }

/// A digest's mbedtls_md_type_t number.
x509_md_number: fn(md: hashes.Md) -> Int Never! {
    if md == {
        .MD5 -> 0x03
        .RIPEMD160 -> 0x04
        .SHA1 -> 0x05
        .SHA224 -> 0x08
        .SHA256 -> 0x09
        .SHA384 -> 0x0A
        .SHA512 -> 0x0B
        .SHA3x224 -> 0x10
        .SHA3x256 -> 0x11
        .SHA3x384 -> 0x12
        .SHA3x512 -> 0x13
    }
}

/// A key type's mbedtls_pk_type_t number.
x509_pk_number: fn(kind: oids.PKType) -> Int Never! {
    if kind == {
        .RSA -> 1
        .ECKey -> 2
        .ECKeyDH -> 3
        .ECDSA -> 4
        .RSAAlt -> 5
        .RSASSAPSS -> 6
        .Opaque -> 7
    }
}

/// A curve's mbedtls_ecp_group_id number, 0 for none.
x509_curve_number: fn(id: ecp.GroupID) -> Int Never! {
    if id == {
        .Unknown -> 0
        .Secp192r1 -> 1
        .Secp224r1 -> 2
        .Secp256r1 -> 3
        .Secp384r1 -> 4
        .Secp521r1 -> 5
        .Bp256r1 -> 6
        .Bp384r1 -> 7
        .Bp512r1 -> 8
        .Curve25519 -> 9
        .Secp192k1 -> 10
        .Secp224k1 -> 11
        .Secp256k1 -> 12
        .Curve448 -> 13
    }
}

/// The profile mask bit of a digest.
x509_md_flag: fn(md: hashes.Md) -> Int Never! { x509_id_flag(x509_md_number(md)) }

/// The profile mask bit of a key type.
x509_pk_flag: fn(kind: oids.PKType) -> Int Never! { x509_id_flag(x509_pk_number(kind)) }

/// The profile mask bit of a curve.
x509_curve_flag: fn(id: ecp.GroupID) -> Int Never! { x509_id_flag(x509_curve_number(id)) }

// The curves of 128-bit security and above that both the default and the
// next profile allow.
x509_curves_128: fn() -> Int Never! {
    x509_curve_flag(.Secp256r1).bit_or(x509_curve_flag(.Secp384r1)).bit_or(x509_curve_flag(.Secp521r1))
        .bit_or(x509_curve_flag(.Bp256r1)).bit_or(x509_curve_flag(.Bp384r1)).bit_or(x509_curve_flag(.Bp512r1))
}

// SHA-256, SHA-384 and SHA-512.
x509_mds_sha2: fn() -> Int Never! { x509_md_flag(.SHA256).bit_or(x509_md_flag(.SHA384)).bit_or(x509_md_flag(.SHA512)) }

/// The default profile (mbedtls_x509_crt_profile_default): SHA-2 and SHA-3
/// of 256 bits and more, any key type, the curves of 128-bit security and
/// above, RSA keys of 2048 bits and more.
x509_crt_profile_default: fn() -> X509CrtProfile Never! {
    mds: x509_mds_sha2().bit_or(x509_md_flag(.SHA3x256)).bit_or(x509_md_flag(.SHA3x384)).bit_or(x509_md_flag(.SHA3x512))
    X509CrtProfile{allowed_mds: mds, allowed_pks: 0xFFFFFFF, allowed_curves: x509_curves_128(), rsa_min_bitlen: 2048}
}

/// The profile mbedtls means to make the default
/// (mbedtls_x509_crt_profile_next): SHA-2 of 256 bits and more, any key
/// type, the default's curves and secp256k1, RSA keys of 2048 bits and
/// more.
x509_crt_profile_next: fn() -> X509CrtProfile Never! {
    curves: x509_curves_128().bit_or(x509_curve_flag(.Secp256k1))
    X509CrtProfile{allowed_mds: x509_mds_sha2(), allowed_pks: 0xFFFFFFF, allowed_curves: curves, rsa_min_bitlen: 2048}
}

/// NSA Suite B (mbedtls_x509_crt_profile_suiteb, RFC 6460): SHA-256 and
/// SHA-384 with ECDSA on P-256 or P-384 only.
x509_crt_profile_suiteb: fn() -> X509CrtProfile Never! {
    X509CrtProfile{
        allowed_mds: x509_md_flag(.SHA256).bit_or(x509_md_flag(.SHA384))
        allowed_pks: x509_pk_flag(.ECDSA).bit_or(x509_pk_flag(.ECKey))
        allowed_curves: x509_curve_flag(.Secp256r1).bit_or(x509_curve_flag(.Secp384r1))
        rsa_min_bitlen: 0
    }
}

/// The profile that allows nothing (mbedtls_x509_crt_profile_none).
x509_crt_profile_none: fn() -> X509CrtProfile Never! {
    X509CrtProfile{allowed_mds: 0, allowed_pks: 0, allowed_curves: 0, rsa_min_bitlen: 0xFFFFFFFF}
}

// x509_profile_check_md_alg: the profile allows the digest; no digest never.
x509_profile_check_md_alg: fn(profile: X509CrtProfile, md: hashes.Md?) -> Bool Never! {
    given: md ?? return false
    profile.allowed_mds.bit_and(x509_md_flag(given)) != 0
}

// x509_profile_check_pk_alg: the profile allows the key type; none never.
x509_profile_check_pk_alg: fn(profile: X509CrtProfile, kind: oids.PKType?) -> Bool Never! {
    given: kind ?? return false
    profile.allowed_pks.bit_and(x509_pk_flag(given)) != 0
}

// x509_profile_check_key: an RSA key long enough, or an EC key on an
// allowed curve.
x509_profile_check_key: fn(profile: X509CrtProfile, key: pk.PKContext) -> Bool Never! {
    kind: pk.pk_get_type(key) ?? return false
    if kind == .RSA || kind == .RSASSAPSS -> return pk.pk_get_bitlen(key) >= profile.rsa_min_bitlen
    if kind != .ECDSA && kind != .ECKey && kind != .ECKeyDH -> return false
    gid: pk.pk_get_ec_group_id(key)
    gid != .Unknown && profile.allowed_curves.bit_and(x509_curve_flag(gid)) != 0
}

// x509_memcasecmp: a[a_at..] and b[b_at..] agree over len bytes, ASCII
// letters without regard to case.
x509_memcasecmp: fn(a: [U8], a_at: Int, b: [U8], b_at: Int, len: Int) -> Bool Never! {
    loop i in 0..<len {
        x: a[a_at + i]
        diff: Int{x.bit_xor(b[b_at + i])}
        if diff == 0 -> next
        c: Int{x}
        letter: (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
        if diff != 32 || !letter -> return false
    }
    true
}

// x509_check_wildcard: `name` is "*." and a suffix that matches `cn` from
// its first dot on, the dot not first.
x509_check_wildcard: fn(cn: [U8], name: [U8]) -> Bool Never! {
    if name.len() < 3 || name[0] != (U8{42}) || name[1] != (U8{46}) -> return false
    cn_idx := 0
    loop i in 0..<cn.len() {
        if cn[i] == (U8{46}) {
            cn_idx = i
            break
        }
    }
    if cn_idx == 0 -> return false
    cn.len() - cn_idx == name.len() - 1 && x509_memcasecmp(name, 1, cn, cn_idx, name.len() - 1)
}

// x509_string_cmp: two name values are equal, UTF8String and
// PrintableString ones without regard to ASCII case and to which of the two
// types each is.
x509_string_cmp: fn(a: asn1.NamedData, b: asn1.NamedData) -> Bool Never! {
    if a.val_tag == b.val_tag && a.val == b.val -> return true
    a_text: a.val_tag == asn1.ASN1_UTF8_STRING || a.val_tag == asn1.ASN1_PRINTABLE_STRING
    b_text: b.val_tag == asn1.ASN1_UTF8_STRING || b.val_tag == asn1.ASN1_PRINTABLE_STRING
    a_text && b_text && a.val.len() == b.val.len() && x509_memcasecmp(a.val, 0, b.val, 0, a.val.len())
}

// x509_name_cmp: two names are equal attribute by attribute, with the same
// multi-valued RDN grouping.
x509_name_cmp: fn(a: [asn1.NamedData], b: [asn1.NamedData]) -> Bool Never! {
    if a.len() != b.len() -> return false
    loop i in 0..<a.len() {
        if a[i].oid != b[i].oid || a[i].next_merged != b[i].next_merged -> return false
        if !x509_string_cmp(a[i], b[i]) -> return false
    }
    true
}

// The text of each verification flag, bit 0 first (the
// X509_CRT_ERROR_INFO list).
X509_CRT_VERIFY_STRINGS: [String]{
    "The certificate validity has expired",
    "The certificate has been revoked (is on a CRL)",
    "The certificate Common Name (CN) does not match with the expected CN",
    "The certificate is not correctly signed by the trusted CA",
    "The CRL is not correctly signed by the trusted CA",
    "The CRL is expired",
    "Certificate was missing",
    "Certificate verification was skipped",
    "Other reason (can be used by verify callback)",
    "The certificate validity starts in the future",
    "The CRL is from the future",
    "Usage does not match the keyUsage extension",
    "Usage does not match the extendedKeyUsage extension",
    "Usage does not match the nsCertType extension",
    "The certificate is signed with an unacceptable hash.",
    "The certificate is signed with an unacceptable PK alg (eg RSA vs ECDSA).",
    "The certificate is signed with an unacceptable key (eg bad curve, RSA too short).",
    "The CRL is signed with an unacceptable hash.",
    "The CRL is signed with an unacceptable PK alg (eg RSA vs ECDSA).",
    "The CRL is signed with an unacceptable key (eg bad curve, RSA too short)."
}

/// A line after `prefix` for each verification flag set in `flags`, in
/// flag order, and one for any bit no flag names
/// (mbedtls_x509_crt_verify_info).
x509_crt_verify_info: fn(prefix: String, flags: Int) -> [U8] Never! {
    out := [U8]{}
    rest := flags
    loop bit in 0..<X509_CRT_VERIFY_STRINGS.len() {
        code: 1 << bit
        if rest.bit_and(code) == 0 -> next
        out.extend("{prefix}{X509_CRT_VERIFY_STRINGS[bit]}\n".bytes())
        rest = rest.bit_xor(code)
    }
    if rest != 0 -> out.extend("{prefix}Unknown reason (this should not happen)\n".bytes())
    out
}

// x509_crt_check_cn: `name` (a dNSName or CN value) is `cn` without regard
// to ASCII case, or a wildcard matching it.
x509_crt_check_cn: fn(name: [U8], cn: [U8]) -> Bool Never! {
    if name.len() == cn.len() && x509_memcasecmp(cn, 0, name, 0, cn.len()) -> return true
    x509_check_wildcard(cn, name)
}

// The byte at src[p], 0 past the end, as the NUL that ends a C string.
x509_cn_byte: fn(src: [U8], p: Int) -> Int Never! {
    if p >= src.len() -> return 0
    Int{src[p]}
}

// x509_inet_pton_ipv4: a dotted-quad IPv4 address from src[start..] to its
// end, each part 0 to 255 without leading zeros; None when malformed.
x509_inet_pton_ipv4: fn(src: [U8], start: Int) -> [U8]? Never! {
    p := start
    out := [U8]{}
    loop {
        octet := 0
        num_digits := 0
        loop num_digits < 3 {
            digit: x509_cn_byte(src, p) - 48
            if digit < 0 || digit > 9 -> break
            if octet == 0 && num_digits > 0 -> return None
            octet = octet * 10 + digit
            num_digits += 1
            p += 1
        }
        if octet >= 256 || num_digits == 0 -> return None
        out.push(U8{octet})
        if out.len() >= 4 -> break
        dot: x509_cn_byte(src, p)
        p += 1
        if dot != 46 -> break
    }
    if out.len() != 4 || x509_cn_byte(src, p) != 0 -> return None
    Val(out)
}

// x509_inet_pton_ipv6: an IPv6 address in RFC 4291 text form, with at most
// one "::" and an optional trailing IPv4 part, to its 16 bytes; None when
// malformed.
x509_inet_pton_ipv6: fn(src: [U8]) -> [U8]? Never! {
    groups := [Int]{0, 0, 0, 0, 0, 0, 0, 0}
    p := 0
    nonzero_groups := 0
    zero_group_start := -1
    loop {
        group := 0
        num_digits := 0
        loop num_digits < 4 {
            digit: x509.x509_hex_value(x509_cn_byte(src, p))
            if digit < 0 -> break
            group = group * 16 + digit
            num_digits += 1
            p += 1
        }
        if num_digits != 0 {
            groups[nonzero_groups] = group
            nonzero_groups += 1
            c: x509_cn_byte(src, p)
            if c == 0 -> break
            if c == 46 {
                if (nonzero_groups < 6 && zero_group_start == -1) || nonzero_groups >= 7 -> break
                // Back to the start of the IPv4 part, which held one group.
                p -= 1
                loop x509_cn_byte(src, p) != 58 -> p -= 1
                p += 1
                nonzero_groups -= 1
                v4: x509_inet_pton_ipv4(src, p) ?? break
                groups[nonzero_groups] = Int{v4[0]} * 256 + Int{v4[1]}
                groups[nonzero_groups + 1] = Int{v4[2]} * 256 + Int{v4[3]}
                nonzero_groups += 2
                p = src.len()
                break
            }
            if c != 58 -> return None
        } else {
            if zero_group_start != -1 || x509_cn_byte(src, p) != 58 -> return None
            zero_group_start = nonzero_groups
            if zero_group_start == 0 {
                p += 1
                if x509_cn_byte(src, p) != 58 -> return None
            }
            if x509_cn_byte(src, p + 1) == 0 {
                p += 1
                break
            }
        }
        p += 1
        if nonzero_groups >= 8 -> break
    }
    if x509_cn_byte(src, p) != 0 -> return None
    if zero_group_start != -1 {
        if nonzero_groups > 6 -> return None
        zero_groups: 8 - nonzero_groups
        groups_after: nonzero_groups - zero_group_start
        loop k in 0..<groups_after {
            from: nonzero_groups - 1 - k
            groups[from + zero_groups] = groups[from]
        }
        loop k in 0..<zero_groups -> groups[zero_group_start + k] = 0
    } else if nonzero_groups != 8 {
        return None
    }
    out := [U8]{}
    loop g in groups {
        out.push(U8{g >> 8})
        out.push(U8{g.bit_and(0xFF)})
    }
    Val(out)
}

/// The address a host name given as an IP address stands for, 4 bytes for
/// IPv4 and 16 for IPv6 (a ':' in it), empty when it is neither
/// (mbedtls_x509_crt_parse_cn_inet_pton).
x509_crt_parse_cn_inet_pton: fn(cn: [U8]) -> [U8] Never! {
    is_v6 := false
    loop c in cn {
        if c == (U8{0}) -> break
        if c == (U8{58}) {
            is_v6 = true
            break
        }
    }
    found: if is_v6 -> x509_inet_pton_ipv6(cn) else -> x509_inet_pton_ipv4(cn, 0)
    found ?? [U8]{}
}

// The bytes of a subjectAltName entry.
x509_crt_san_bytes: fn(crt: X509Crt, san: asn1.ASN1Buf) -> [U8] Never! { cipher.bytes_of(crt.raw, san.p, san.len) }

// The GeneralName number of a subjectAltName entry.
x509_crt_san_type: fn(san: asn1.ASN1Buf) -> Int Never! { san.tag_id.bit_and(asn1.ASN1_TAG_VALUE_MASK) }

// x509_crt_check_san_ip: `cn` is an IP address that an iPAddress entry
// holds.
x509_crt_check_san_ip: fn(crt: X509Crt, cn: [U8]) -> Bool Never! {
    ip: x509_crt_parse_cn_inet_pton(cn)
    if ip.len() == 0 -> return false
    loop san in crt.subject_alt_names {
        if x509_crt_san_type(san) == x509.X509_SAN_IP_ADDRESS && x509_crt_san_bytes(crt, san) == ip -> return true
    }
    false
}

// x509_crt_check_san_uri: a uniformResourceIdentifier entry is exactly
// `cn`.
x509_crt_check_san_uri: fn(crt: X509Crt, cn: [U8]) -> Bool Never! {
    loop san in crt.subject_alt_names {
        if x509_crt_san_type(san) == x509.X509_SAN_UNIFORM_RESOURCE_IDENTIFIER && x509_crt_san_bytes(crt, san) == cn -> return true
    }
    false
}

// x509_crt_check_san: a dNSName entry matches `cn`, else an iPAddress or a
// URI entry does.
x509_crt_check_san: fn(crt: X509Crt, cn: [U8]) -> Bool Never! {
    san_ip := false
    san_uri := false
    loop san in crt.subject_alt_names {
        kind: x509_crt_san_type(san)
        if kind == x509.X509_SAN_DNS_NAME && x509_crt_check_cn(x509_crt_san_bytes(crt, san), cn) -> return true
        if kind == x509.X509_SAN_IP_ADDRESS -> san_ip = true
        if kind == x509.X509_SAN_UNIFORM_RESOURCE_IDENTIFIER -> san_uri = true
    }
    if san_ip && x509_crt_check_san_ip(crt, cn) -> return true
    san_uri && x509_crt_check_san_uri(crt, cn)
}

// x509_crt_verify_name: CN_MISMATCH unless the subjectAltName, or without
// one a subject CN, matches `cn`.
x509_crt_verify_name: fn(crt: X509Crt, cn: [U8]) -> Int Never! {
    if crt.ext_types.bit_and(oids.X509_EXT_SUBJECT_ALT_NAME) != 0 {
        if x509_crt_check_san(crt, cn) -> return 0
        return x509.X509_BADCERT_CN_MISMATCH
    }
    loop entry in crt.subject {
        if entry.oid == oids.OID_AT_CN && x509_crt_check_cn(entry.val, cn) -> return 0
    }
    x509.X509_BADCERT_CN_MISMATCH
}

// x509_crt_is_revoked: a CRL entry has the certificate's serial number.
x509_crt_is_revoked: fn(serial: [U8], crl: x509crl.X509Crl) -> Bool Never! {
    loop entry in crl.entries {
        if entry.serial.len == 0 -> break
        if cipher.bytes_of(crl.raw, entry.serial.p, entry.serial.len) == serial -> return true
    }
    false
}

// A signature as its signer's key checks it: the digest of the signed
// bytes, None when the algorithm names no digest, and the algorithm.
X509Signed: struct {
    hash: [U8]?
    md: hashes.Md?
    kind: oids.PKType?
    opts: pk.PSSOptions?
    sig: [U8]
}

// The digest of `tbs` under `md`, None without one.
x509_crt_digest: fn(md: hashes.Md?, tbs: [U8]) -> [U8]? Never! {
    given: md ?? return None
    Val(hashes.hash(given, tbs))
}

// A certificate's signature over its TBSCertificate.
x509_crt_signed: fn(crt: X509Crt) -> X509Signed Never! {
    tbs: cipher.bytes_of(crt.raw, crt.tbs.p, crt.tbs.len)
    sig: cipher.bytes_of(crt.raw, crt.sig.p, crt.sig.len)
    X509Signed{hash: x509_crt_digest(crt.sig_md, tbs), md: crt.sig_md, kind: crt.sig_pk, opts: crt.sig_opts, sig: sig}
}

// x509_crt_check_signature: the signer's key can make and verifies the
// signature.
x509_crt_check_signature: fn(signed: X509Signed, signer: &X509Crt) -> Bool Never! {
    hash: signed.hash ?? return false
    kind: signed.kind ?? return false
    if !pk.pk_can_do(signer.pk, kind) -> return false
    if pk.pk_verify_ext(kind, signed.opts, signer.pk, signed.md, hash, signed.sig) == {
        .Ok(_) -> true
        .Err(_) -> false
    }
}

// x509_crt_verifycrl: the CRL flags for the certificate with serial
// `serial` that `ca` issued, from the first of `crls` that `ca` issued and
// whose signature holds.
x509_crt_verifycrl: fn(serial: [U8], ca: &X509Crt, crls: [x509crl.X509Crl], profile: X509CrtProfile, now: x509.X509Time) -> Int Never! {
    flags := 0
    loop i in 0..<crls.len() {
        if crls[i].version == 0 || !x509_name_cmp(crls[i].issuer, ca.subject) -> next
        if x509_crt_key_usage_ok(ca, x509.X509_KU_CRL_SIGN) == false {
            flags = flags.bit_or(x509.X509_BADCRL_NOT_TRUSTED)
            break
        }
        if !x509_profile_check_md_alg(profile, crls[i].sig_md) -> flags = flags.bit_or(x509.X509_BADCRL_BAD_MD)
        if !x509_profile_check_pk_alg(profile, crls[i].sig_pk) -> flags = flags.bit_or(x509.X509_BADCRL_BAD_PK)
        tbs: cipher.bytes_of(crls[i].raw, crls[i].tbs.p, crls[i].tbs.len)
        sig: cipher.bytes_of(crls[i].raw, crls[i].sig.p, crls[i].sig.len)
        signed: X509Signed{hash: x509_crt_digest(crls[i].sig_md, tbs), md: crls[i].sig_md, kind: crls[i].sig_pk, opts: crls[i].sig_opts, sig: sig}
        if signed.hash == None {
            flags = flags.bit_or(x509.X509_BADCRL_NOT_TRUSTED)
            break
        }
        if !x509_profile_check_key(profile, ca.pk) -> flags = flags.bit_or(x509.X509_BADCERT_BAD_KEY)
        if !x509_crt_check_signature(signed, ca) {
            flags = flags.bit_or(x509.X509_BADCRL_NOT_TRUSTED)
            break
        }
        if x509.x509_time_cmp(crls[i].next_update, now) < 0 -> flags = flags.bit_or(x509.X509_BADCRL_EXPIRED)
        if x509.x509_time_cmp(crls[i].this_update, now) > 0 -> flags = flags.bit_or(x509.X509_BADCRL_FUTURE)
        if x509_crt_is_revoked(serial, crls[i]) {
            flags = flags.bit_or(x509.X509_BADCERT_REVOKED)
            break
        }
    }
    flags
}

// Whether the certificate allows every usage in `usage`.
x509_crt_key_usage_ok: fn(crt: X509Crt, usage: Int) -> Bool Never! {
    if x509_crt_check_key_usage(crt, usage) == {
        .Ok(_) -> true
        .Err(_) -> false
    }
}

// x509_crt_check_parent: `parent` named the issuer `issuer` and, unless it
// is a trusted root (`top`) of version 1 or 2, a CA that may sign
// certificates.
x509_crt_check_parent: fn(issuer: [asn1.NamedData], parent: X509Crt, top: Bool) -> Bool Never! {
    if !x509_name_cmp(issuer, parent.subject) -> return false
    if top && parent.version < 3 -> return true
    parent.ca_istrue && x509_crt_key_usage_ok(parent, x509.X509_KU_KEY_CERT_SIGN)
}

// A parent found for a certificate: its index in the list searched,
// whether it is a trusted root, and whether its key verifies the child's
// signature.
X509Parent: struct {
    index: Int
    trusted: Bool
    signature_is_good: Bool
}

// x509_crt_find_parent_in: the first suitable parent in cands[from..] that
// is within its validity period, else the first suitable one. A trusted
// root (`top`) must verify the signature; an intermediate's path length
// limit must allow the path_cnt certificates below it, self_cnt of them
// self-issued.
x509_crt_find_parent_in: fn(issuer: [asn1.NamedData], signed: X509Signed, cands: &[X509Crt], from: Int, top: Bool, path_cnt: Int, self_cnt: Int, now: x509.X509Time) -> X509Parent? Never! {
    fallback := -1
    fallback_good := false
    loop j in from..<cands.len() {
        if !x509_crt_check_parent(issuer, cands[j], top) -> next
        if cands[j].max_pathlen > 0 && cands[j].max_pathlen < 1 + path_cnt - self_cnt -> next
        good: x509_crt_check_signature(signed, cands[j])
        if top && !good -> next
        current: x509.x509_time_cmp(cands[j].valid_to, now) >= 0 && x509.x509_time_cmp(cands[j].valid_from, now) <= 0
        if current -> return Val(X509Parent{index: j, trusted: top, signature_is_good: good})
        if fallback == -1 {
            fallback = j
            fallback_good = good
        }
    }
    if fallback == -1 -> return None
    Val(X509Parent{index: fallback, trusted: top, signature_is_good: fallback_good})
}

// x509_crt_find_parent: the parent of chain[child], first among the
// trusted roots, then among the certificates after it in the chain.
x509_crt_find_parent: fn(chain: &[X509Crt], trust_ca: &[X509Crt], child: Int, path_cnt: Int, self_cnt: Int, now: x509.X509Time) -> X509Parent? Never! {
    issuer: chain[child].issuer.copy()
    signed: x509_crt_signed(chain[child])
    if x509_crt_find_parent_in(issuer, signed, trust_ca, 0, true, path_cnt, self_cnt, now) == {
        .Val(found) -> return Val(found)
        .None -> {}
    }
    x509_crt_find_parent_in(issuer, signed, chain, child + 1, false, path_cnt, self_cnt, now)
}

// x509_crt_check_ee_locally_trusted: a self-issued leaf that is itself one
// of the trusted roots.
x509_crt_check_ee_locally_trusted: fn(crt: X509Crt, trust_ca: [X509Crt]) -> Bool Never! {
    if !x509_name_cmp(crt.issuer, crt.subject) -> return false
    loop j in 0..<trust_ca.len() {
        if trust_ca[j].raw == crt.raw -> return true
    }
    false
}

// The validity flags of a certificate at `now`.
x509_crt_time_flags: fn(crt: X509Crt, now: x509.X509Time) -> Int Never! {
    flags := 0
    if x509.x509_time_cmp(crt.valid_to, now) < 0 -> flags = flags.bit_or(x509.X509_BADCERT_EXPIRED)
    if x509.x509_time_cmp(crt.valid_from, now) > 0 -> flags = flags.bit_or(x509.X509_BADCERT_FUTURE)
    flags
}

/// One certificate of the chain verification builds
/// (mbedtls_x509_crt_verify_chain_item): trust_ca[index] when `trusted`,
/// else chain[index], with the flags found for it.
X509ChainItem: struct {
    trusted: Bool
    index: Int
    flags: Int
}

// x509_crt_verify_chain: the chain from chain[0] up to a trusted root, or
// as far as parents are found, each certificate with its flags. More than
// X509_MAX_INTERMEDIATE_CA certificates below the root are FatalError.
x509_crt_verify_chain: fn(chain: &[X509Crt], trust_ca: &[X509Crt], ca_crl: [x509crl.X509Crl], profile: X509CrtProfile, now: x509.X509Time) -> [X509ChainItem] x509.X509Error! {
    items := [X509ChainItem]{}
    child := 0
    child_trusted := false
    self_cnt := 0
    loop {
        if child_trusted {
            items.push(X509ChainItem{trusted: true, index: child, flags: x509_crt_time_flags(trust_ca[child], now)})
            return Ok(items)
        }
        flags := x509_crt_time_flags(chain[child], now)
        if !x509_profile_check_md_alg(profile, chain[child].sig_md) -> flags = flags.bit_or(x509.X509_BADCERT_BAD_MD)
        if !x509_profile_check_pk_alg(profile, chain[child].sig_pk) -> flags = flags.bit_or(x509.X509_BADCERT_BAD_PK)
        if items.len() == 0 && x509_crt_check_ee_locally_trusted(chain[child], trust_ca) {
            items.push(X509ChainItem{trusted: false, index: child, flags: flags})
            return Ok(items)
        }
        found: x509_crt_find_parent(chain, trust_ca, child, items.len(), self_cnt, now)
        parent: found ?? {
            items.push(X509ChainItem{trusted: false, index: child, flags: flags.bit_or(x509.X509_BADCERT_NOT_TRUSTED)})
            return Ok(items)
        }
        if items.len() != 0 && x509_name_cmp(chain[child].issuer, chain[child].subject) -> self_cnt += 1
        if !parent.trusted && items.len() + 1 > x509.X509_MAX_INTERMEDIATE_CA -> return Err(.FatalError)
        if !parent.signature_is_good -> flags = flags.bit_or(x509.X509_BADCERT_NOT_TRUSTED)
        serial: cipher.bytes_of(chain[child].raw, chain[child].serial.p, chain[child].serial.len)
        flags = flags.bit_or(x509_crt_parent_flags(chain, trust_ca, parent, serial, ca_crl, profile, now))
        items.push(X509ChainItem{trusted: false, index: child, flags: flags})
        child = parent.index
        child_trusted = parent.trusted
    }
}

// The flags a certificate takes from its parent: BAD_KEY for a key the
// profile refuses, and those of the parent's CRLs.
x509_crt_parent_flags: fn(chain: &[X509Crt], trust_ca: &[X509Crt], parent: X509Parent, serial: [U8], ca_crl: [x509crl.X509Crl], profile: X509CrtProfile, now: x509.X509Time) -> Int Never! {
    if parent.trusted -> return x509_crt_signer_flags(trust_ca, parent.index, serial, ca_crl, profile, now)
    x509_crt_signer_flags(chain, parent.index, serial, ca_crl, profile, now)
}

// The parent-side flags for the signer list[at].
x509_crt_signer_flags: fn(list: &[X509Crt], at: Int, serial: [U8], ca_crl: [x509crl.X509Crl], profile: X509CrtProfile, now: x509.X509Time) -> Int Never! {
    flags := 0
    if !x509_profile_check_key(profile, list[at].pk) -> flags = x509.X509_BADCERT_BAD_KEY
    flags.bit_or(x509_crt_verifycrl(serial, list[at], ca_crl, profile, now))
}

/// A verification callback (the f_vrfy of mbedtls_x509_crt_verify): `call`
/// gets each certificate of the built chain, the root first, with its depth
/// (0 for the leaf) and its flags, and returns the flags to keep. An error
/// stops verification and is its result, CertVerifyFailed turned into
/// FatalError. The callback is pure, so the TLS engine can verify with it.
X509VerifyCallback: struct {
    call: fn(X509Crt, Int, Int) -[]> Int x509.X509Error!
}

// One callback call for the chain item at `depth`.
x509_crt_verify_call: fn(callback: X509VerifyCallback, chain: [X509Crt], trust_ca: [X509Crt], item: X509ChainItem, depth: Int) -> Int x509.X509Error! {
    call: callback.call
    if item.trusted -> return call(trust_ca[item.index], depth, item.flags)
    call(chain[item.index], depth, item.flags)
}

/// The chain verification builds for `chain` (the leaf first, then any
/// intermediates) up to one of the trusted roots `trust_ca`, leaf first,
/// each certificate with its flags under `profile` and the roots' CRLs
/// `ca_crl` at the UTC date `now`; the leaf's include the name check
/// against `cn` when given and the profile's check of its key (the
/// chain-building half of mbedtls_x509_crt_verify_with_profile). BadInput
/// for an empty chain; FatalError for a chain too long.
x509_crt_verify_items: fn(chain: &[X509Crt], trust_ca: &[X509Crt], ca_crl: [x509crl.X509Crl], profile: X509CrtProfile, cn: [U8]?, now: x509.X509Time) -> [X509ChainItem] x509.X509Error! {
    if chain.len() == 0 -> return Err(.BadInput)
    ee_flags := 0
    if cn == {
        .Val(name) -> ee_flags = x509_crt_verify_name(chain[0], name)
        .None -> {}
    }
    if !x509_profile_check_pk_alg(profile, pk.pk_get_type(chain[0].pk)) -> ee_flags = ee_flags.bit_or(x509.X509_BADCERT_BAD_PK)
    if !x509_profile_check_key(profile, chain[0].pk) -> ee_flags = ee_flags.bit_or(x509.X509_BADCERT_BAD_KEY)
    items := x509_crt_verify_chain(chain, trust_ca, ca_crl, profile, now)
    items[0].flags = items[0].flags.bit_or(ee_flags)
    Ok(items)
}

/// Verify `chain` (the leaf first, then any intermediates) against the
/// trusted roots `trust_ca` and their CRLs `ca_crl` under `profile`, the
/// leaf's name against `cn` when given (mbedtls_x509_crt_verify_with_profile).
/// Each certificate of the built chain, the root first, goes through
/// `vrfy` when given, which may change its flags. CertVerifyFailed carries
/// the flags of the whole chain when any is set; any other error means the
/// chain could not be examined.
x509_crt_verify_with_profile: fn(chain: &[X509Crt], trust_ca: &[X509Crt], ca_crl: [x509crl.X509Crl], profile: X509CrtProfile, cn: [U8]?, vrfy: X509VerifyCallback?) x509.X509Error! {
    x509_crt_verify_with_profile_at(chain, trust_ca, ca_crl, profile, cn, vrfy, x509.x509_now())
}

/// x509_crt_verify_with_profile at the UTC date `now` instead of the
/// current one; core.net.tls passes its handshake clock's date.
x509_crt_verify_with_profile_at: fn(chain: &[X509Crt], trust_ca: &[X509Crt], ca_crl: [x509crl.X509Crl], profile: X509CrtProfile, cn: [U8]?, vrfy: X509VerifyCallback?, now: x509.X509Time) x509.X509Error! {
    items: x509_crt_verify_items(chain, trust_ca, ca_crl, profile, cn, now)
    flags := 0
    loop k in 0..<items.len() {
        depth: items.len() - 1 - k
        cur := items[depth].flags
        if vrfy == {
            .Val(callback) -> {
                if x509_crt_verify_call(callback, chain, trust_ca, items[depth], depth) == {
                    .Ok(kept) -> cur = kept
                    .Err(e) -> return Err(x509_crt_callback_error(e))
                }
            }
            .None -> {}
        }
        flags = flags.bit_or(cur)
    }
    if flags != 0 -> return Err(.CertVerifyFailed(flags))
}

// A callback's failure as verification reports it: CertVerifyFailed
// becomes FatalError, so that it never carries flags the chain lacks.
x509_crt_callback_error: fn(e: x509.X509Error) -> x509.X509Error Never! {
    if e == {
        .CertVerifyFailed(_) -> .FatalError
        .FeatureUnavailable(_) | .UnknownOid | .InvalidFormat(_) | .InvalidVersion(_) | .InvalidSerial(_) | .InvalidAlg(_) | .InvalidAlgOid(_) | .InvalidName(_) | .InvalidDate(_) | .InvalidSignature(_) | .InvalidExtensions(_) | .UnknownVersion | .UnknownSigAlg(_) | .SigMismatch | .CertUnknownFormat | .BadInput | .BufferTooSmall | .FatalError | .Callback(_) | .Asn1(_) | .PK(_) | .PEM(_) | .OID(_) -> e
    }
}

/// x509_crt_verify_with_profile under the default profile
/// (mbedtls_x509_crt_verify).
x509_crt_verify: fn(chain: &[X509Crt], trust_ca: &[X509Crt], ca_crl: [x509crl.X509Crl], cn: [U8]?, vrfy: X509VerifyCallback?) x509.X509Error! {
    x509_crt_verify_with_profile(chain, trust_ca, ca_crl, x509_crt_profile_default(), cn, vrfy)
}
