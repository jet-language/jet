// SPDX-License-Identifier: Apache-2.0
// Translated from Mbed TLS 3.6.7 (library/cipher.c, library/cipher_wrap.c); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: the generic cipher layer.
//
// A port of mbedtls 3.6.7's cipher.c and cipher_wrap.c: one context type
// that runs any of the 83 ciphers of mbedtls's definitions table (AES,
// ARIA, Camellia, DES and Triple-DES in their block modes, AES-XTS, GCM and
// CCM over the 128-bit ciphers, ChaCha20, ChaCha20-Poly1305, the NIST key
// wraps and the NULL cipher) through setkey, set_iv, update_ad, update,
// finish and the tag calls, with mbedtls's partial-block caching, CBC
// padding and error codes, plus the one-shot crypt and auth_*_ext.
//
// Where the C contract cannot be expressed it is enforced by the types: a
// context always has a cipher (no NULL info), the operation and the padding
// mode are enums (no out-of-range values), and output buffers grow to fit
// (no output-size arguments). The padding checks read every byte of the
// block and decide from masks, as mbedtls's constant-time get_*_padding.
use {
    core
    cipher: __core_crypto_cipher
    __core_crypto_cipher.[ForwardBlock]
    aead: __core_crypto_aead
    des: __core_crypto_des
    block128: __core_crypto_block
}

/// Why a cipher-layer call refused. The first five are the cipher layer's
/// own codes; the rest are the module codes mbedtls passes through.
#Error
CipherLayerError: enum {
    /// MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE (-0x6080): the call does not
    /// apply to the cipher's mode, or an IV longer than 16 bytes.
    FeatureUnavailable
    /// MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA (-0x6100): a wrong key length, a
    /// short IV, a call in the wrong direction or before setkey.
    BadInputData
    /// MBEDTLS_ERR_CIPHER_INVALID_PADDING (-0x6200).
    InvalidPadding
    /// MBEDTLS_ERR_CIPHER_FULL_BLOCK_EXPECTED (-0x6280): ECB input that is
    /// not one block, or CBC data that does not end on a block without
    /// padding.
    FullBlockExpected
    /// MBEDTLS_ERR_CIPHER_AUTH_FAILED (-0x6300): a tag or key-wrap
    /// integrity check did not verify.
    AuthFailed
    /// MBEDTLS_ERR_AES_INVALID_INPUT_LENGTH (-0x0022): an XTS data unit
    /// outside 16 bytes to 2^24 bytes.
    AESInvalidInputLength
    /// MBEDTLS_ERR_GCM_BAD_INPUT (-0x0014): an empty IV, a tag length
    /// outside 4..16, or data past the GCM limits or after the AAD closed.
    GCMBadInput
    /// MBEDTLS_ERR_CCM_BAD_INPUT (-0x000D): a nonce, length or call order
    /// the CCM state machine refuses.
    CCMBadInput
    /// MBEDTLS_ERR_CHACHAPOLY_BAD_STATE (-0x0054): AAD after data, or data
    /// or a tag before the AAD started.
    ChaChaPolyBadState
    /// MBEDTLS_ERR_CHACHA20_BAD_INPUT_DATA (-0x0051): a ChaCha20-Poly1305
    /// nonce that is not 12 bytes, or data past the block counter's end.
    ChaCha20BadInput
}

// The DES, ARIA and Camellia modes fail only on lengths this layer always
// passes whole, and on stream offsets it keeps in range.
impl des.DESError -> CipherLayerError { CipherLayerError.BadInputData }

impl block128.BlockError -> CipherLayerError { CipherLayerError.BadInputData }

/// The block cipher or stream cipher family (mbedtls_cipher_id_t).
CipherID: enum {
    Null
    AES
    DES
    DES3
    Camellia
    ARIA
    ChaCha20
}

/// How the cipher is run (mbedtls_cipher_mode_t). `Stream` is ChaCha20 and
/// the NULL cipher.
CipherMode: enum {
    ECB
    CBC
    CFB
    OFB
    CTR
    GCM
    Stream
    CCM
    CCMStarNoTag
    XTS
    ChaChaPoly
    KW
    KWP
}

/// The direction setkey fixes (mbedtls_operation_t).
CipherOperation: enum {
    Encrypt
    Decrypt
}

/// One row of the cipher table (mbedtls_cipher_info_t). `iv_size` is the
/// default IV length; `variable_iv` lets set_iv take another.
CipherInfo: struct {
    name: String
    id: CipherID
    mode: CipherMode
    key_bits: Int
    iv_size: Int
    block_size: Int
    variable_iv: Bool
}

/// The ciphers in the order of mbedtls's mbedtls_cipher_definitions.
CIPHER_INFO: [CipherInfo]{
    CipherInfo{name: "AES-128-ECB", id: CipherID.AES, mode: CipherMode.ECB, key_bits: 128, iv_size: 0, block_size: 16, variable_iv: false},
