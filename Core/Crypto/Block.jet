#Test("ARIA and Camellia match the RFC 5794 and RFC 3713 known answers and the modes undo themselves") {
    key: [U8]{0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F,
        0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1A, 0x1B, 0x1C, 0x1D, 0x1E, 0x1F}
    plain: [U8]{0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF}
    // RFC 5794 appendix A.3, ARIA-256.
    a_enc: aria_setkey_enc(key) ?? panic("key")
    a_ct: block_crypt_ecb(a_enc, plain) ?? panic("ecb")
    assert(a_ct == [U8]{0xF9, 0x2B, 0xD7, 0xC7, 0x9F, 0xB7, 0x2E, 0x2F, 0x2B, 0x8F, 0x80, 0xC1, 0x97, 0x2D, 0x24, 0xFC})
    a_dec: aria_setkey_dec(key) ?? panic("key")
    assert((block_crypt_ecb(a_dec, a_ct) ?? panic("ecb")) == plain)
    // RFC 3713 appendix A, 128-bit key.
    c_key: [U8]{0x01, 0x23, 0x45, 0x67, 0x89, 0xAB, 0xCD, 0xEF, 0xFE, 0xDC, 0xBA, 0x98, 0x76, 0x54, 0x32, 0x10}
    c_enc: camellia_setkey_enc(c_key) ?? panic("key")
    c_ct: block_crypt_ecb(c_enc, c_key) ?? panic("ecb")
    assert(c_ct == [U8]{0x67, 0x67, 0x31, 0x38, 0x54, 0x96, 0x69, 0x73, 0x08, 0x57, 0x06, 0x56, 0x48, 0xEA, 0xBE, 0x43})
    c_dec: camellia_setkey_dec(c_key) ?? panic("key")
    assert((block_crypt_ecb(c_dec, c_ct) ?? panic("ecb")) == c_key)
    // CBC, CFB128 and CTR round trips, with the streams split mid-block.
    two := plain.copy()
    loop b in key -> two.push(b)
    iv := c_key.copy()
    sealed: block_crypt_cbc(c_enc, .Encrypt, iv, two) ?? panic("cbc")
    iv2 := c_key.copy()
    assert((block_crypt_cbc(c_dec, .Decrypt, iv2, sealed) ?? panic("cbc")) == two)
    assert(iv == iv2)
    assert(block_crypt_cbc(a_enc, .Encrypt, iv, [U8]{1, 2, 3}) == .Err(.InvalidInputLength))
    off := 0
    civ := c_key.copy()
    head: block_crypt_cfb128(a_enc, .Encrypt, off, civ, cipher.bytes_of(two, 0, 5)) ?? panic("cfb")
    tail: block_crypt_cfb128(a_enc, .Encrypt, off, civ, cipher.bytes_of(two, 5, two.len() - 5)) ?? panic("cfb")
    assert(off == (two.len() %% 16))
    whole := head.copy()
    loop b in tail -> whole.push(b)
    doff := 0
    div := c_key.copy()
    assert((block_crypt_cfb128(a_enc, .Decrypt, doff, div, whole) ?? panic("cfb")) == two)
    bad := 16
    assert(block_crypt_cfb128(a_enc, .Encrypt, bad, div, two) == .Err(.BadInputData))
    n := 0
    ctr := cipher.zero_bytes(16)
    stream := cipher.zero_bytes(16)
    first: block_crypt_ctr(c_enc, n, ctr, stream, cipher.bytes_of(two, 0, 7)) ?? panic("ctr")
    rest: block_crypt_ctr(c_enc, n, ctr, stream, cipher.bytes_of(two, 7, two.len() - 7)) ?? panic("ctr")
    joined := first.copy()
    loop b in rest -> joined.push(b)
    n2 := 0
    ctr2 := cipher.zero_bytes(16)
    stream2 := cipher.zero_bytes(16)
    assert((block_crypt_ctr(c_enc, n2, ctr2, stream2, joined) ?? panic("ctr")) == two)
    assert(camellia_setkey_enc([U8]{1, 2, 3}) == .Err(.BadInputData))
}
