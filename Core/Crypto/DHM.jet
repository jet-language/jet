#Test("Two FFDHE2048 contexts agree on the secret, and out-of-range public values are refused") {
    rng := drbg.hmac_drbg_new(.SHA256)
    drbg.hmac_drbg_seed_buf(rng, "Dhm.jet self-test".bytes())
    server := dhm_new()
    p: bn.read_binary(FFDHE2048_P) ?? panic("P")
    g: bn.read_binary(FFDHE2048_G) ?? panic("G")
    dhm_set_group(server, p, g) ?? panic("set_group")
    assert(dhm_get_bitlen(server) == 2048)
    params: dhm_make_params(server, 256, rng) ?? panic("make_params")
    client := dhm_new()
    at := 0
    dhm_read_params(client, params, at, params.len()) ?? panic("read_params")
    assert(at == params.len())
    client_public: dhm_make_public(client, 256, 256, rng) ?? panic("make_public")
    dhm_read_public(server, client_public) ?? panic("server read_public")
    server_public: bn.write_binary(server.gx, 256) ?? panic("server gx")
    dhm_read_public(client, server_public) ?? panic("client read_public")
    server_secret: dhm_calc_secret(server, rng) ?? panic("server secret")
    client_secret: dhm_calc_secret(client, rng) ?? panic("client secret")
    assert(server_secret == client_secret)
    // Reusing the private value squares the blinding pair; the secret stays.
    again: dhm_calc_secret(server, rng) ?? panic("server secret again")
    assert(again == server_secret)
    dhm_read_public(server, [U8]{1}) ?? panic("read_public 1")
    assert(dhm_calc_secret(server, rng) == .Err(.BadInput))
    assert(dhm_read_public(server, [U8]{}) == .Err(.BadInput))
}

#Test("DHParams DER yields the group, with or without privateValueLength") {
    // SEQUENCE { INTEGER 23, INTEGER 5 } and SEQUENCE { INTEGER 23, INTEGER 5, INTEGER 160 }.
    ctx: dhm_parse_der([U8]{0x30, 0x06, 0x02, 0x01, 0x17, 0x02, 0x01, 0x05}) ?? panic("DER")
    assert(bn.cmp_int(dhm_get_value(ctx, .P), 23) == 0)
    assert(bn.cmp_int(dhm_get_value(ctx, .G), 5) == 0)
    with_length: dhm_parse_der([U8]{0x30, 0x0A, 0x02, 0x01, 0x17, 0x02, 0x01, 0x05, 0x02, 0x02, 0x00, 0xA0}) ?? panic("DER with length")
    assert(dhm_get_len(with_length) == 1)
    assert(dhm_parse_der([U8]{0x30, 0x03, 0x02, 0x01, 0x17}) == .Err(.InvalidFormat(.OutOfData)))
    assert(dhm_parse_der([U8]{0x31, 0x00}) == .Err(.InvalidFormat(.UnexpectedTag)))
}
