// SPDX-License-Identifier: Apache-2.0
// Translated from Mbed TLS 3.6.7 (library/dhm.c); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: finite-field Diffie-Hellman-Merkle (RFC 2631
// key agreement as TLS 1.2's DHE uses it).
//
// A port of mbedtls 3.6.7's dhm.c: ServerKeyExchange parameters, the public
// values, the shared secret and the DHParams encoding (DER, or PEM "DH
// PARAMETERS"), with the RFC 3526 and RFC 7919 groups. Every public value is
// range-checked to 2..p - 2 (CVE-2005-2643), and the secret blinds the peer's
// value with Kocher's method, squaring the blinding pair on each reuse of the
// same private value.
use {
    core
    cipher: __core_crypto_cipher
    bn: __core_crypto_bignum
    __core_crypto_bignum.[RNG]
    asn1: __core_crypto_asn1
    drbg: __core_crypto_drbg
    pem: __core_crypto_pem
}

/// Why a DHM operation failed (MBEDTLS_ERR_DHM_*). A payload is the bignum
/// or DER error mbedtls adds to the DHM code.
#Error
DHMError: enum {
    /// Bad input parameters, or a public value outside 2..p - 2
    /// (BAD_INPUT_DATA, -0x3080).
    BadInput
    /// A ServerKeyExchange number does not read (READ_PARAMS_FAILED, -0x3100).
    ReadParamsFailed(bn.MpiError)
    /// Making the private value or the parameters failed
    /// (MAKE_PARAMS_FAILED, -0x3180). None: no private value in range.
    MakeParamsFailed(bn.MpiError?)
    /// The peer's public value does not read (READ_PUBLIC_FAILED, -0x3200).
    ReadPublicFailed(bn.MpiError)
    /// Making the private value or the public value failed
    /// (MAKE_PUBLIC_FAILED, -0x3280). None: no private value in range.
    MakePublicFailed(bn.MpiError?)
    /// Computing the shared secret failed (CALC_SECRET_FAILED, -0x3300).
    CalcSecretFailed(bn.MpiError)
    /// The DHParams encoding is malformed (INVALID_FORMAT, -0x3380).
    InvalidFormat(asn1.ASN1Error)
    /// The group does not copy in (SET_GROUP_FAILED, -0x3580).
    SetGroupFailed(bn.MpiError)
    /// A bignum error on its own (MBEDTLS_ERR_MPI_*).
    Mpi(bn.MpiError)
    /// A PEM "DH PARAMETERS" block does not read (MBEDTLS_ERR_PEM_*).
    PEM(pem.PEMError)
}

impl bn.MpiError -> DHMError { DHMError.Mpi(self) }

/// One value of a DHM context, for dhm_get_value (mbedtls_dhm_parameter).
DHMParam: enum {
    /// The prime modulus.
    P
    /// The generator.
    G
    /// Our private value.
    X
    /// Our public value g^x mod p.
    GX
    /// The peer's public value g^y mod p.
    GY
    /// The shared secret g^xy mod p.
    K
}

/// A DHM key exchange (mbedtls_dhm_context): the group p and g, our private
/// value x and public value gx, the peer's gy, the secret k, the cached
/// R^2 mod p, and the blinding pair vi, vf = vi^-x for the private value px
/// they were made for.
DHMContext: struct {
    p: bn.Mpi
    g: bn.Mpi
    x: bn.Mpi
    gx: bn.Mpi
    gy: bn.Mpi
    k: bn.Mpi
    rp: bn.Mpi
    vi: bn.Mpi
    vf: bn.Mpi
    px: bn.Mpi
}

/// An empty context (mbedtls_dhm_init).
dhm_new: fn() -> DHMContext Never! {
    DHMContext{
        p: bn.mpi(), g: bn.mpi(), x: bn.mpi(), gx: bn.mpi(), gy: bn.mpi(),
        k: bn.mpi(), rp: bn.mpi(), vi: bn.mpi(), vf: bn.mpi(), px: bn.mpi(),
    }
}

/// The bit length of p (mbedtls_dhm_get_bitlen).
dhm_get_bitlen: fn(ctx: DHMContext) -> Int Never! { bn.bitlen(ctx.p) }

/// The byte length of p (mbedtls_dhm_get_len).
dhm_get_len: fn(ctx: DHMContext) -> Int Never! { bn.size(ctx.p) }

/// A copy of one value (mbedtls_dhm_get_value).
dhm_get_value: fn(ctx: DHMContext, param: DHMParam) -> bn.Mpi Never! {
    if param == {
        .P -> bn.copy_mpi(ctx.p)
        .G -> bn.copy_mpi(ctx.g)
        .X -> bn.copy_mpi(ctx.x)
        .GX -> bn.copy_mpi(ctx.gx)
        .GY -> bn.copy_mpi(ctx.gy)
        .K -> bn.copy_mpi(ctx.k)
    }
}

// One ServerKeyExchange number: a 2-byte big-endian length and its bytes.
read_bignum: fn(data: [U8], p: &Int, end: Int) -> bn.Mpi DHMError! {
    if end - p < 2 -> return Err(.BadInput)
    n: (Int.from_u8(data[p]) << 8).bit_or(Int.from_u8(data[p + 1]))
    p += 2
    if end - p < n -> return Err(.BadInput)
    x: bn.read_binary(cipher.bytes_of(data, p, n)) ?? return Err(.ReadParamsFailed(err))
    p += n
    Ok(x)
}

// BadInput unless 2 <= param <= p - 2.
check_range: fn(param: bn.Mpi, p: bn.Mpi) DHMError! {
    u: bn.sub_int(p, 2)
    if bn.cmp_int(param, 2) < 0 || bn.cmp_mpi(param, u) > 0 -> return Err(.BadInput)
}

/// Read p, g and the peer's gy from data[p..end] and check gy's range
/// (mbedtls_dhm_read_params).
dhm_read_params: fn(ctx: &DHMContext, data: [U8], p: &Int, end: Int) DHMError! {
    np: read_bignum(data, p, end)
    bn.set_mpi(ctx.p, np)
    ng: read_bignum(data, p, end)
    bn.set_mpi(ctx.g, ng)
    ngy: read_bignum(data, p, end)
    bn.set_mpi(ctx.gy, ngy)
    check_range(ctx.gy, ctx.p)
}

// A uniform r in 2..m - 2.
random_below: fn<R: RNG>(m: bn.Mpi, rng: &R) -> bn.Mpi bn.MpiError! {
    r: bn.random(3, m, rng)
    out: bn.sub_int(r, 1)
    Ok(out)
}

// A private value of x_size random bytes, or uniform in 2..p - 2 when
// x_size is at least p's length. MakeParamsFailed(None) when no draw falls
// in range; any other bignum error stays bare for the caller to wrap.
private_value: fn<R: RNG>(p: bn.Mpi, x_size: Int, rng: &R) -> bn.Mpi DHMError! {
    if x_size < bn.size(p) {
        small: bn.fill_random(x_size, rng)
        return Ok(small)
    }
    x: random_below(p, rng) ?? return Err(if err == {
        .NotAcceptable -> DHMError.MakeParamsFailed(None)
        .BadInput | .InvalidCharacter | .BufferTooSmall | .NegativeValue | .DivisionByZero | .AllocFailed | .Random | .FileIO -> DHMError.Mpi(err)
    })
    Ok(x)
}

// A fresh private value x and gx = g^x mod p, range-checked.
make_common: fn<R: RNG>(ctx: &DHMContext, x_size: Int, rng: &R) DHMError! {
    if bn.cmp_int(ctx.p, 0) == 0 || x_size < 0 -> return Err(.BadInput)
    x: private_value(ctx.p, x_size, rng)
    bn.set_mpi(ctx.x, x)
    gx: bn.exp_mod(ctx.g, ctx.x, ctx.p, ctx.rp)
    bn.set_mpi(ctx.gx, gx)
    check_range(ctx.gx, ctx.p)
}

// A number as its 2-byte length and its bytes without leading zeros.
push_number: fn(out: &[U8], x: bn.Mpi) bn.MpiError! {
    n: bn.size(x)
    out.push(U8{(n >> 8).bit_and(0xFF)})
    out.push(U8{n.bit_and(0xFF)})
    bytes: bn.write_binary(x, n)
    out.extend(bytes)
}

/// Make a private value of x_size bytes (as large as p allows when x_size
/// is at least p's length) and return the ServerKeyExchange parameters p,
/// g and g^x, each with a 2-byte length and no leading zero bytes
/// (mbedtls_dhm_make_params).
dhm_make_params: fn<R: RNG>(ctx: &DHMContext, x_size: Int, rng: &R) -> [U8] DHMError! {
    if make_common(ctx, x_size, rng) == .Err(e) {
        return Err(if e == .Mpi(m) -> DHMError.MakeParamsFailed(Val(m)) else -> e.copy())
    }
    out := [U8]{}
    push_number(out, ctx.p) ?? return Err(.MakeParamsFailed(Val(err)))
    push_number(out, ctx.g) ?? return Err(.MakeParamsFailed(Val(err)))
    push_number(out, ctx.gx) ?? return Err(.MakeParamsFailed(Val(err)))
    Ok(out)
}

/// Set the group from p and g (mbedtls_dhm_set_group).
dhm_set_group: fn(ctx: &DHMContext, p: bn.Mpi, g: bn.Mpi) DHMError! {
    bn.set_mpi(ctx.p, p) ?? return Err(.SetGroupFailed(err))
    bn.set_mpi(ctx.g, g) ?? return Err(.SetGroupFailed(err))
}

/// Take the peer's public value, 1 to p's length big-endian bytes
/// (mbedtls_dhm_read_public). Its range is checked by dhm_calc_secret.
dhm_read_public: fn(ctx: &DHMContext, input: [U8]) DHMError! {
    if input.len() < 1 || input.len() > dhm_get_len(ctx) -> return Err(.BadInput)
    gy: bn.read_binary(input) ?? return Err(.ReadPublicFailed(err))
    bn.set_mpi(ctx.gy, gy)
}

/// Make a private value of x_size bytes and return g^x as olen big-endian
/// bytes, 1 <= olen <= p's length (mbedtls_dhm_make_public).
dhm_make_public: fn<R: RNG>(ctx: &DHMContext, x_size: Int, olen: Int, rng: &R) -> [U8] DHMError! {
    if olen < 1 || olen > dhm_get_len(ctx) -> return Err(.BadInput)
    if make_common(ctx, x_size, rng) == .Err(e) {
        return Err(if e == {
            .MakeParamsFailed(_) -> DHMError.MakePublicFailed(None)
            .Mpi(m) -> DHMError.MakePublicFailed(Val(m))
            .BadInput | .ReadParamsFailed(_) | .ReadPublicFailed(_) | .MakePublicFailed(_) | .CalcSecretFailed(_) | .InvalidFormat(_) | .SetGroupFailed(_) | .PEM(_) -> e.copy()
        })
    }
    out: bn.write_binary(ctx.gx, olen) ?? return Err(.MakePublicFailed(Val(err)))
    Ok(out)
}

// Refresh vi and vf (Kocher, CRYPTO'96, section 10): none the first time a
// private value is used, then squares of the pair, made fresh when it was
// none.
update_blinding: fn<R: RNG>(ctx: &DHMContext, rng: &R) bn.MpiError! {
    if bn.cmp_mpi(ctx.x, ctx.px) != 0 {
        bn.set_mpi(ctx.px, ctx.x)
        bn.lset(ctx.vi, 1)
        bn.lset(ctx.vf, 1)
        return
    }
    if bn.cmp_int(ctx.vi, 1) != 0 {
        vi_sq: bn.mul_mpi(ctx.vi, ctx.vi)
        vi: bn.mod_mpi(vi_sq, ctx.p)
        bn.set_mpi(ctx.vi, vi)
        vf_sq: bn.mul_mpi(ctx.vf, ctx.vf)
        vf: bn.mod_mpi(vf_sq, ctx.p)
        bn.set_mpi(ctx.vf, vf)
        return
    }
    fresh_vi: random_below(ctx.p, rng)
    bn.set_mpi(ctx.vi, fresh_vi)
    // vf = vi^-x = (vi^-1)^x mod p.
    inv: bn.gcd_modinv_odd(ctx.vi, ctx.p, true)
    fresh_vf: bn.exp_mod(inv.i, ctx.x, ctx.p, ctx.rp)
    bn.set_mpi(ctx.vf, fresh_vf)
}

// k = ((gy * vi)^x * vf) mod p.
calc_core: fn<R: RNG>(ctx: &DHMContext, rng: &R) bn.MpiError! {
    update_blinding(ctx, rng)
    gy_vi: bn.mul_mpi(ctx.gy, ctx.vi)
    gyb: bn.mod_mpi(gy_vi, ctx.p)
    kb: bn.exp_mod(gyb, ctx.x, ctx.p, ctx.rp)
    k_vf: bn.mul_mpi(kb, ctx.vf)
    k: bn.mod_mpi(k_vf, ctx.p)
    bn.set_mpi(ctx.k, k)
}

/// The shared secret gy^x mod p without leading zero bytes, as TLS 1.2
/// requires (RFC 5246 section 8.1.2), after checking gy's range
/// (mbedtls_dhm_calc_secret).
dhm_calc_secret: fn<R: RNG>(ctx: &DHMContext, rng: &R) -> [U8] DHMError! {
    check_range(ctx.gy, ctx.p)
    calc_core(ctx, rng) ?? return Err(.CalcSecretFailed(err))
    out: bn.write_binary(ctx.k, bn.size(ctx.k)) ?? return Err(.CalcSecretFailed(err))
    Ok(out)
}

/// The group of a DER DHParams, SEQUENCE { prime INTEGER, generator
/// INTEGER, privateValueLength INTEGER OPTIONAL }, the optional length read
/// and dropped (mbedtls_dhm_parse_dhm on DER input).
dhm_parse_der: fn(der: [U8]) -> DHMContext DHMError! {
    ctx := dhm_new()
    p := 0
    len: asn1.get_tag(der, p, der.len(), asn1.ASN1_CONSTRUCTED.bit_or(asn1.ASN1_SEQUENCE)) ?? return Err(.InvalidFormat(err))
    end: p + len
    prime: asn1.get_mpi(der, p, end) ?? return Err(.InvalidFormat(err))
    bn.set_mpi(ctx.p, prime)
    generator: asn1.get_mpi(der, p, end) ?? return Err(.InvalidFormat(err))
    bn.set_mpi(ctx.g, generator)
    if p != end {
        _: asn1.get_mpi(der, p, end) ?? return Err(.InvalidFormat(err))
        if p != end -> return Err(.InvalidFormat(.LengthMismatch))
    }
    Ok(ctx)
}

/// The group of a DHParams (mbedtls_dhm_parse_dhm): PEM "DH PARAMETERS"
/// when the input ends in a NUL byte and holds that block, as a text file
/// read for parsing does; DER otherwise.
dhm_parse_dhm: fn(input: [U8]) -> DHMContext DHMError! {
    if input.len() == 0 || input[input.len() - 1] != (U8{0}) -> return dhm_parse_der(input)
    if pem.pem_read_buffer("-----BEGIN DH PARAMETERS-----", "-----END DH PARAMETERS-----", input, None) == {
        .Ok(block) -> dhm_parse_der(block.der)
        .Err(.NoHeaderFooterPresent) -> dhm_parse_der(input)
        .Err(e) -> Err(.PEM(e))
    }
}

