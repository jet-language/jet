// Private Core source part: writing X.509 certificates and requests.
//
// A port of mbedtls 3.6.7's x509_create.c, x509write.c, x509write_crt.c and
// x509write_csr.c without PSA keys: distinguished names from their string
// form (RFC 4514 text, RFC 5280 Appendix A.1 attribute names), extensions,
// subjectAltName lists, and v1 to v3 certificates (RFC 5280 section 4.1) and
// PKCS #10 certificate requests (RFC 2986) signed with an RSA or ECDSA key,
// as DER or PEM.
//
// The DER pieces fill buf[start..p] backwards from p, as mbedtls's fill
// their buffer backwards from its end, and return the length written. The
// certificate and request writers take the size of the buffer mbedtls
// writes into, so a structure that does not fit fails as it does there, and
// return the DER; the PEM writers return the text, which grows to fit it.
use {
    core
    cipher: __core_crypto_cipher
    __core_crypto_bignum.[RNG]
    hashes: __core_crypto_md
    asn1: __core_crypto_asn1
    oids: __core_crypto_oid
    rsa: __core_crypto_rsa
    pem: __core_crypto_pem
    pk: __core_crypto_pk
    pkwrite: __core_crypto_pkwrite
    x509: __core_crypto_x509
}

/// Certificate versions as the version field holds them
/// (MBEDTLS_X509_CRT_VERSION_1 to _3).
X509_CRT_VERSION_1: 0
X509_CRT_VERSION_2: 1
X509_CRT_VERSION_3: 2

/// The longest serial number RFC 5280 section 4.1.2.2 allows, in bytes
/// (MBEDTLS_X509_RFC5280_MAX_SERIAL_LEN).
X509_RFC5280_MAX_SERIAL_LEN: 20

/// A validity time as the writers keep it: YYYYMMDDHHMMSS and a Z
/// (MBEDTLS_X509_RFC5280_UTC_TIME_LEN).
X509_RFC5280_UTC_TIME_LEN: 15

// The bytes of the string form of a name.
X509_CREATE_EQUALS: U8{61}
X509_CREATE_COMMA: U8{44}
X509_CREATE_NUL: U8{0}
X509_CREATE_ZULU: U8{90}

// The bytes a backslash may escape in a value (RFC 4514 section 3):
// space , = + < > # ; " and backslash.
X509_CREATE_ESCAPABLE: [U8]{32, 44, 61, 43, 60, 62, 35, 59, 34, 92}

// The tags of the structures the writers build.
X509_CREATE_SEQUENCE: 0x30
X509_CREATE_SET: 0x31

// The text of `text` up to its first NUL, where the C string ends.
x509_create_c_text: fn(text: String) -> [U8] Never! {
    s: text.bytes()
    end := 0
    loop end < s.len() && s[end] != X509_CREATE_NUL -> end += 1
    cipher.bytes_of(s, 0, end)
}

// The byte at s[at], the terminating NUL at or past `end`.
x509_create_byte: fn(s: [U8], at: Int, end: Int) -> U8 Never! {
    if at < end -> return s[at]
    X509_CREATE_NUL
}

// One attribute type's OID and the string tag its values take by default
// (x509_attr_descriptor_t).
X509AttrDescr: struct {
    oid: [U8]
    default_tag: Int
}

// The descriptor of one attribute type.
x509_attr: fn(oid: [U8], default_tag: Int) -> X509AttrDescr? Never! {
    Val(X509AttrDescr{oid: oid.copy(), default_tag: default_tag})
}

// The attribute type a short or long name of RFC 5280 Appendix A.1 names,
// None for any other (x509_attrs and x509_attr_descr_from_name). "R" names
// emailAddress, as mbedtls has it.
x509_attr_descr_from_name: fn(name: [U8]) -> X509AttrDescr? Never! {
    text: String.from_bytes(name) ?? return None
    utf8: asn1.ASN1_UTF8_STRING
    printable: asn1.ASN1_PRINTABLE_STRING
    ia5: asn1.ASN1_IA5_STRING
    if text == {
        "CN" | "commonName" -> x509_attr(oids.OID_AT_CN, utf8)
        "C" | "countryName" -> x509_attr(oids.OID_AT_COUNTRY, printable)
        "O" | "organizationName" -> x509_attr(oids.OID_AT_ORGANIZATION, utf8)
        "L" | "locality" -> x509_attr(oids.OID_AT_LOCALITY, utf8)
        "R" | "emailAddress" -> x509_attr(oids.OID_PKCS9_EMAIL, ia5)
        "OU" | "organizationalUnitName" -> x509_attr(oids.OID_AT_ORG_UNIT, utf8)
        "ST" | "stateOrProvinceName" -> x509_attr(oids.OID_AT_STATE, utf8)
        "serialNumber" -> x509_attr(oids.OID_AT_SERIAL_NUMBER, printable)
        "postalAddress" -> x509_attr(oids.OID_AT_POSTAL_ADDRESS, printable)
        "postalCode" -> x509_attr(oids.OID_AT_POSTAL_CODE, printable)
        "dnQualifier" -> x509_attr(oids.OID_AT_DN_QUALIFIER, printable)
        "title" -> x509_attr(oids.OID_AT_TITLE, utf8)
        "surName" | "SN" -> x509_attr(oids.OID_AT_SUR_NAME, utf8)
        "givenName" | "GN" -> x509_attr(oids.OID_AT_GIVEN_NAME, utf8)
        "initials" -> x509_attr(oids.OID_AT_INITIALS, utf8)
        "pseudonym" -> x509_attr(oids.OID_AT_PSEUDONYM, utf8)
        "generationQualifier" -> x509_attr(oids.OID_AT_GENERATION_QUALIFIER, utf8)
        "domainComponent" | "DC" -> x509_attr(oids.OID_DOMAIN_COMPONENT, ia5)
        else -> None
    }
}

// The byte the two hexadecimal digits at s[at] and s[at + 1] spell, -1 when
// either is no digit (hexpair_to_int).
x509_create_hexpair: fn(s: [U8], at: Int) -> Int Never! {
    hi: x509.x509_hex_value(Int.from_u8(s[at]))
    lo: x509.x509_hex_value(Int.from_u8(s[at + 1]))
    if hi < 0 || lo < 0 -> return -1
    hi * 16 + lo
}

// An attribute value in RFC 4514 string form, s[from..to], with its escapes
// undone: a backslash before a special byte or two hexadecimal digits
// (parse_attribute_value_string). An escaped NUL, a backslash before
// anything else, or a value of X509_MAX_DN_NAME_SIZE bytes is InvalidName.
x509_create_value_string: fn(s: [U8], from: Int, to: Int) -> [U8] x509.X509Error! {
    out := [U8]{}
    c := from
    loop c < to {
        if s[c] == x509.X509_BACKSLASH {
            c += 1
            n: if c + 1 < to -> x509_create_hexpair(s, c) else -> -1
            if n != -1 {
                if n == 0 -> return Err(.InvalidName(None))
                out.push(U8{n})
                c += 1
            } else if c < to && X509_CREATE_ESCAPABLE.contains(s[c]) {
                out.push(s[c])
            } else {
                return Err(.InvalidName(None))
            }
        } else {
            out.push(s[c])
        }
        if out.len() == x509.X509_MAX_DN_NAME_SIZE -> return Err(.InvalidName(None))
        c += 1
    }
    Ok(out)
}

// A "#" value: the hexadecimal DER of one item, s[from..to]; its content
// and tag (parse_attribute_value_hex_der_encoded). Odd or bad digits, DER
// over X509_MAX_DN_NAME_SIZE + 4 bytes, a malformed length, content over
// X509_MAX_DN_NAME_SIZE bytes, or a NUL in a string type is InvalidName.
x509_create_value_hex_der: fn(s: [U8], from: Int, to: Int) -> (val: [U8], tag_id: Int) x509.X509Error! {
    digits: to - from
    if digits %% 2 != 0 -> return Err(.InvalidName(None))
    der_len: digits /% 2
    if der_len > x509.X509_MAX_DN_NAME_SIZE + 4 || der_len < 1 -> return Err(.InvalidName(None))
    der := [U8]{}
    loop i in 0..<der_len {
        v: x509_create_hexpair(s, from + 2 * i)
        if v < 0 -> return Err(.InvalidName(None))
        der.push(U8{v})
    }
    tag_id: Int.from_u8(der[0])
    p := 1
    val_len: asn1.get_len(der, p, der_len) ?? return Err(.InvalidName(None))
    if val_len > x509.X509_MAX_DN_NAME_SIZE -> return Err(.InvalidName(None))
    val: cipher.bytes_of(der, p, val_len)
    if asn1.is_string_tag(tag_id) && val.contains(X509_CREATE_NUL) -> return Err(.InvalidName(None))
    Ok((val: val, tag_id: tag_id))
}

/// Parse a name in string form, "C=NL,O=Example,CN=host", into `head`,
/// which must be empty (mbedtls_x509_string_to_names). Each attribute type
/// is a name of RFC 5280 Appendix A.1 or a numeric OID; each value is
/// RFC 4514 text with escapes, or `#` and the hexadecimal DER of one item,
/// which a numeric OID requires. Spaces after a comma are skipped, a
/// repeated attribute type replaces the earlier value, and the entries go
/// to the head of the list, so the last attribute is first. The text ends at
/// its first NUL, as the C string does. BadInput when `head` holds names;
/// InvalidName for malformed text or text with no attribute.
x509_string_to_names: fn(head: &[asn1.NamedData], name: String) x509.X509Error! {
    if head.len() != 0 -> return Err(.BadInput)
    s: x509_create_c_text(name)
    end: s.len()
    start := 0
    c := 0
    oid := [U8]{}
    default_tag := 0
    in_attr_type := true
    numericoid := false
    parsed := false
    loop c <= end {
        ch: x509_create_byte(s, c, end)
        if in_attr_type && ch == X509_CREATE_EQUALS {
            type_name: cipher.bytes_of(s, start, c - start)
            if x509_attr_descr_from_name(type_name) == {
                .Val(descr) -> {
                    oid = descr.oid
                    default_tag = descr.default_tag
                    numericoid = false
                }
                .None -> {
                    text: String.from_bytes(type_name) ?? return Err(.InvalidName(None))
                    oid = oids.from_numeric_string(text) ?? return Err(.InvalidName(None))
                    numericoid = true
                }
            }
            start = c + 1
            in_attr_type = false
        }
        if !in_attr_type && ((ch == X509_CREATE_COMMA && s[c - 1] != x509.X509_BACKSLASH) || c == end) {
            if start == c -> return Err(.InvalidName(None))
            value := [U8]{}
            tag_id := default_tag
            if s[start] == x509.X509_HASH_SIGN {
                der: x509_create_value_hex_der(s, start + 1, c)
                value = der.val
                tag_id = der.tag_id
            } else {
                if numericoid -> return Err(.InvalidName(None))
                value = x509_create_value_string(s, start, c)
            }
            at: asn1.store_named_data(head, oid, value)
            head[at].val_tag = tag_id
            loop c < end && x509_create_byte(s, c + 1, end) == x509.X509_SPACE -> c += 1
            start = c + 1
            in_attr_type = true
            parsed = true
        }
        c += 1
    }
    if !parsed -> return Err(.InvalidName(None))
}

/// Add the extension `oid` to `head`, or replace its value, with the DER
/// value `val` (mbedtls_x509_set_extension). The stored value is the
/// critical flag as one byte and then `val`, as mbedtls stores it.
x509_set_extension: fn(head: &[asn1.NamedData], oid: [U8], critical: Bool, val: [U8]) Never! {
    stored := [U8]{}
    stored.push(if critical -> U8{1} else -> U8{0})
    loop b in val -> stored.push(b)
    _: asn1.store_named_data(head, oid, stored)
}

// One RelativeDistinguishedName: the SET of the single
// AttributeTypeAndValue `entry` (x509_write_name).
x509_write_name: fn(buf: &[U8], p: &Int, start: Int, entry: asn1.NamedData) -> Int asn1.ASN1Error! {
    len := asn1.write_tagged_string(buf, p, start, entry.val_tag, entry.val)
    len += asn1.write_oid(buf, p, start, entry.oid)
    len = asn1.write_len_and_tag(buf, p, start, len, X509_CREATE_SEQUENCE)
    total: asn1.write_len_and_tag(buf, p, start, len, X509_CREATE_SET)
    Ok(total)
}

/// A Name: the SEQUENCE of one RDN per entry of `names`, the first written
/// last, so a list x509_string_to_names built reads back in its text's
/// order (mbedtls_x509_write_names).
x509_write_names: fn(buf: &[U8], p: &Int, start: Int, names: [asn1.NamedData]) -> Int asn1.ASN1Error! {
    len := 0
    loop entry in names -> len += x509_write_name(buf, p, start, entry)
    total: asn1.write_len_and_tag(buf, p, start, len, X509_CREATE_SEQUENCE)
    Ok(total)
}

/// A signature after its AlgorithmIdentifier: `oid`, with NULL parameters
/// unless `pk_alg` is ECDSA, whose parameters RFC 5480 and RFC 5758 leave
/// absent, then `sig` as a BIT STRING (mbedtls_x509_write_sig).
x509_write_sig: fn(buf: &[U8], p: &Int, start: Int, oid: [U8], sig: [U8], pk_alg: oids.PKType) -> Int asn1.ASN1Error! {
    if p < start || p - start < sig.len() -> return Err(.BufTooSmall)
    p -= sig.len()
    loop i in 0..<sig.len() -> buf[p + i] = sig[i]
    if p - start < 1 -> return Err(.BufTooSmall)
    p -= 1
    buf[p] = U8{0}
    len := asn1.write_len_and_tag(buf, p, start, sig.len() + 1, asn1.ASN1_BIT_STRING)
    len += asn1.write_algorithm_identifier_ext(buf, p, start, oid, 0, pk_alg != .ECDSA)
    Ok(len)
}

// One Extension: its OID, critical TRUE when the stored flag byte is set,
// and the rest of the stored value as the OCTET STRING extnValue
// (x509_write_extension).
x509_write_extension: fn(buf: &[U8], p: &Int, start: Int, ext: asn1.NamedData) -> Int asn1.ASN1Error! {
    len := asn1.write_octet_string(buf, p, start, cipher.bytes_of(ext.val, 1, ext.val.len() - 1))
    if ext.val[0] != (U8{0}) -> len += asn1.write_bool(buf, p, start, true)
    len += asn1.write_oid(buf, p, start, ext.oid)
    total: asn1.write_len_and_tag(buf, p, start, len, X509_CREATE_SEQUENCE)
    Ok(total)
}

/// Every extension of `exts`, the first written last, with no SEQUENCE
/// around them (mbedtls_x509_write_extensions).
x509_write_extensions: fn(buf: &[U8], p: &Int, start: Int, exts: [asn1.NamedData]) -> Int asn1.ASN1Error! {
    len := 0
    loop ext in exts -> len += x509_write_extension(buf, p, start, ext)
    Ok(len)
}

/// One GeneralName of a subjectAltName to write (mbedtls_x509_san_list's
/// node). `kind` is its x509.X509_SAN_* tag number: a dNSName, rfc822Name,
/// URI or iPAddress is the bytes of `name`, a directoryName the names of
/// `directory`, the first written last as x509_write_names writes them.
X509SanEntry: struct {
    kind: Int
    name: [U8]
    directory: [asn1.NamedData]
}

// Whether a GeneralName of tag number `kind` is written from bytes of its
// own rather than from names.
x509write_san_unstructured: fn(kind: Int) -> Bool Never! {
    kind == x509.X509_SAN_DNS_NAME || kind == x509.X509_SAN_RFC822_NAME || kind == x509.X509_SAN_UNIFORM_RESOURCE_IDENTIFIER || kind == x509.X509_SAN_IP_ADDRESS
}

// The SEQUENCE of GeneralNames of `sans`, the first written last.
x509write_san_der: fn(buf: &[U8], p: &Int, sans: [X509SanEntry]) -> Int asn1.ASN1Error! {
    len := 0
    loop san in sans {
        if san.kind == x509.X509_SAN_DIRECTORY_NAME {
            names: x509_write_names(buf, p, 0, san.directory)
            len += asn1.write_len_and_tag(buf, p, 0, names, asn1.ASN1_CONTEXT_SPECIFIC.bit_or(asn1.ASN1_CONSTRUCTED).bit_or(x509.X509_SAN_DIRECTORY_NAME))
        } else {
            len += asn1.write_tagged_string(buf, p, 0, asn1.ASN1_CONTEXT_SPECIFIC.bit_or(san.kind), san.name)
        }
    }
    total: asn1.write_len_and_tag(buf, p, 0, len, X509_CREATE_SEQUENCE)
    Ok(total)
}

/// Set the subjectAltName extension of `extensions` to the GeneralNames of
/// `sans`, not critical (mbedtls_x509_write_set_san_common).
/// FeatureUnavailable for a kind other than dNSName, rfc822Name, URI,
/// iPAddress or directoryName.
x509_write_set_san_common: fn(extensions: &[asn1.NamedData], sans: [X509SanEntry]) x509.X509Error! {
    // The most the list can take: a tag and up to 4 length bytes around
    // each value, and two of each around each name of a directoryName.
    buf_len := 0
    loop san in sans {
        if x509write_san_unstructured(san.kind) {
            buf_len += san.name.len() + 5
        } else if san.kind == x509.X509_SAN_DIRECTORY_NAME {
            loop entry in san.directory -> buf_len += 10 + entry.oid.len() + entry.val.len()
            buf_len += 5
        } else {
            return Err(.FeatureUnavailable(None))
        }
    }
    buf_len += 5
    buf := cipher.zero_bytes(buf_len)
    p := buf_len
    len: x509write_san_der(buf, p, sans) ?? return Err(.Asn1(err))
    x509_set_extension(extensions, oids.OID_SUBJECT_ALT_NAME, false, cipher.bytes_of(buf, p, len))
}

// A key failure as mbedtls returns it: its bare ASN.1 code for a buffer the
// key does not fit, the PK error otherwise.
x509write_pk_failure: fn(e: pk.PKError) -> x509.X509Error Never! {
    if e == .Asn1(a) -> return x509.X509Error.Asn1(a)
    x509.X509Error.PK(e)
}

// The signature algorithm of `key`: RSA for an RSA or RSA-alt key, ECDSA
// for an EC one; InvalidAlg for none.
x509write_pk_alg: fn(key: pk.PKContext) -> oids.PKType x509.X509Error! {
    if pk.pk_can_do(key, .RSA) -> return Ok(.RSA)
    if pk.pk_can_do(key, .ECDSA) -> return Ok(.ECDSA)
    Err(.InvalidAlg(None))
}

// The DER of a whole certificate or request: `tbs` and its signature in a
// buffer of `size` bytes, written as mbedtls writes them, the signature at
// the buffer's end and `tbs` before it.
x509write_signed: fn(size: Int, tbs: [U8], sig_oid: [U8], sig: [U8], pk_alg: oids.PKType) -> [U8] asn1.ASN1Error! {
    buf := cipher.zero_bytes(size)
    c2 := size
    sig_len: x509_write_sig(buf, c2, tbs.len(), sig_oid, sig, pk_alg)
    c := c2 - tbs.len()
    loop i in 0..<tbs.len() -> buf[c + i] = tbs[i]
    total: asn1.write_len_and_tag(buf, c, 0, tbs.len() + sig_len, X509_CREATE_SEQUENCE)
    Ok(cipher.bytes_of(buf, c, total))
}

// ---- certificates (x509write_crt.c) ----

/// A certificate to write (mbedtls_x509write_cert). `version` is an
/// X509_CRT_VERSION_* value, `md_alg` the digest the issuer signs, and the
/// two keys are set directly; the setters below fill the rest.
X509WriteCert: struct {
    version: Int
    serial: [U8]
    subject_key: pk.PKContext
    issuer_key: pk.PKContext
    subject: [asn1.NamedData]
    issuer: [asn1.NamedData]
    md_alg: hashes.Md?
    not_before: [U8]
    not_after: [U8]
    extensions: [asn1.NamedData]
}

/// A version 3 certificate with no keys, names, serial, validity, digest or
/// extensions (mbedtls_x509write_crt_init).
x509write_crt_new: fn() -> X509WriteCert Never! {
    X509WriteCert{
        version: X509_CRT_VERSION_3, serial: [U8]{}, subject_key: pk.pk_new(), issuer_key: pk.pk_new(),
        subject: [asn1.NamedData]{}, issuer: [asn1.NamedData]{}, md_alg: None,
        not_before: cipher.zero_bytes(X509_RFC5280_UTC_TIME_LEN), not_after: cipher.zero_bytes(X509_RFC5280_UTC_TIME_LEN),
        extensions: [asn1.NamedData]{},
    }
}

/// Set the subject from its string form (mbedtls_x509write_crt_set_subject_name;
/// see x509_string_to_names).
x509write_crt_set_subject_name: fn(ctx: &X509WriteCert, name: String) x509.X509Error! {
    ctx.subject = [asn1.NamedData]{}
    x509_string_to_names(ctx.subject, name)
}

/// Set the issuer from its string form (mbedtls_x509write_crt_set_issuer_name).
x509write_crt_set_issuer_name: fn(ctx: &X509WriteCert, name: String) x509.X509Error! {
    ctx.issuer = [asn1.NamedData]{}
    x509_string_to_names(ctx.issuer, name)
}

/// Set the serial number to the big-endian bytes `serial`
/// (mbedtls_x509write_crt_set_serial_raw); BadInput past
/// X509_RFC5280_MAX_SERIAL_LEN bytes.
x509write_crt_set_serial_raw: fn(ctx: &X509WriteCert, serial: [U8]) x509.X509Error! {
    if serial.len() > X509_RFC5280_MAX_SERIAL_LEN -> return Err(.BadInput)
    ctx.serial = serial.copy()
}

/// Set the validity period from two YYYYMMDDHHMMSS times in UTC
/// (mbedtls_x509write_crt_set_validity); BadInput for any other length.
/// A year before 2050 is written as UTCTime, a later one as
/// GeneralizedTime (RFC 5280 section 4.1.2.5).
x509write_crt_set_validity: fn(ctx: &X509WriteCert, not_before: String, not_after: String) x509.X509Error! {
    before := x509_create_c_text(not_before)
    after := x509_create_c_text(not_after)
    if before.len() != X509_RFC5280_UTC_TIME_LEN - 1 || after.len() != X509_RFC5280_UTC_TIME_LEN - 1 -> return Err(.BadInput)
    before.push(X509_CREATE_ZULU)
    after.push(X509_CREATE_ZULU)
    ctx.not_before = before
    ctx.not_after = after
}

/// Set the subjectAltName extension (mbedtls_x509write_crt_set_subject_alternative_name;
/// see x509_write_set_san_common).
x509write_crt_set_subject_alternative_name: fn(ctx: &X509WriteCert, sans: [X509SanEntry]) x509.X509Error! {
    x509_write_set_san_common(ctx.extensions, sans)
}

/// Add or replace the extension `oid` with the DER value `val`
/// (mbedtls_x509write_crt_set_extension).
x509write_crt_set_extension: fn(ctx: &X509WriteCert, oid: [U8], critical: Bool, val: [U8]) Never! {
    x509_set_extension(ctx.extensions, oid, critical, val)
}

// The BasicConstraints value: cA TRUE and the path length for a CA, an
// empty SEQUENCE otherwise.
x509write_basic_constraints_der: fn(buf: &[U8], p: &Int, is_ca: Bool, max_pathlen: Int) -> Int asn1.ASN1Error! {
    len := 0
    if is_ca {
        if max_pathlen >= 0 -> len += asn1.write_int(buf, p, 0, max_pathlen)
        len += asn1.write_bool(buf, p, 0, true)
    }
    total: asn1.write_len_and_tag(buf, p, 0, len, X509_CREATE_SEQUENCE)
    Ok(total)
}

/// Set the basicConstraints extension, critical for a CA
/// (mbedtls_x509write_crt_set_basic_constraints, RFC 5280 section
/// 4.2.1.9); a negative `max_pathlen` leaves the path unlimited. BadInput
/// for a CA path length over 127.
x509write_crt_set_basic_constraints: fn(ctx: &X509WriteCert, is_ca: Bool, max_pathlen: Int) x509.X509Error! {
    if is_ca && max_pathlen > 127 -> return Err(.BadInput)
    buf := cipher.zero_bytes(9)
    p := 9
    len: x509write_basic_constraints_der(buf, p, is_ca, max_pathlen) ?? return Err(.Asn1(err))
    x509_set_extension(ctx.extensions, oids.OID_BASIC_CONSTRAINTS, is_ca, cipher.bytes_of(buf, p, len))
}

// The identifier `hash` under `tag_id`, inside a SEQUENCE for an
// AuthorityKeyIdentifier.
x509write_key_identifier_der: fn(buf: &[U8], p: &Int, hash: [U8], tag_id: Int, authority: Bool) -> Int asn1.ASN1Error! {
    len := asn1.write_tagged_string(buf, p, 0, tag_id, hash)
    if authority -> len = asn1.write_len_and_tag(buf, p, 0, len, X509_CREATE_SEQUENCE)
    Ok(len)
}

// The subjectKeyIdentifier of the subject key, or the AuthorityKeyIdentifier
// of the issuer key: the SHA-1 of the key's subjectPublicKey bits, method 1
// of RFC 5280 section 4.2.1.2 (mbedtls_x509write_crt_set_key_identifier).
x509write_crt_set_key_identifier: fn(ctx: &X509WriteCert, authority: Bool) x509.X509Error! {
    // A tag, a length and two MPIs, as mbedtls sizes it.
    size: rsa.MPI_MAX_SIZE * 2 + 20
    buf := cipher.zero_bytes(size)
    p := size
    if authority {
        _: pkwrite.pk_write_pubkey(ctx.issuer_key, buf, p, 0) ?? return Err(x509write_pk_failure(err))
    } else {
        _: pkwrite.pk_write_pubkey(ctx.subject_key, buf, p, 0) ?? return Err(x509write_pk_failure(err))
    }
    hash: hashes.hash(.SHA1, cipher.bytes_of(buf, p, size - p))
    p = size
    tag_id: if authority -> asn1.ASN1_CONTEXT_SPECIFIC else -> asn1.ASN1_OCTET_STRING
    len: x509write_key_identifier_der(buf, p, hash, tag_id, authority) ?? return Err(.Asn1(err))
    oid: if authority -> oids.OID_AUTHORITY_KEY_IDENTIFIER else -> oids.OID_SUBJECT_KEY_IDENTIFIER
    x509_set_extension(ctx.extensions, oid, false, cipher.bytes_of(buf, p, len))
}

/// Set the subjectKeyIdentifier extension from the subject key
/// (mbedtls_x509write_crt_set_subject_key_identifier).
x509write_crt_set_subject_key_identifier: fn(ctx: &X509WriteCert) x509.X509Error! {
    x509write_crt_set_key_identifier(ctx, false)
}

/// Set the authorityKeyIdentifier extension from the issuer key
/// (mbedtls_x509write_crt_set_authority_key_identifier).
x509write_crt_set_authority_key_identifier: fn(ctx: &X509WriteCert) x509.X509Error! {
    x509write_crt_set_key_identifier(ctx, true)
}

// The keyUsage bits mbedtls writes.
X509WRITE_KU_ALLOWED: 0x80FF

/// Set the keyUsage extension, critical, from X509_KU_* bits
/// (mbedtls_x509write_crt_set_key_usage, RFC 5280 section 4.2.1.3);
/// FeatureUnavailable for any other bit.
x509write_crt_set_key_usage: fn(ctx: &X509WriteCert, key_usage: Int) x509.X509Error! {
    if key_usage.bit_and(X509WRITE_KU_ALLOWED.bit_not()) != 0 -> return Err(.FeatureUnavailable(None))
    ku: [U8]{U8{key_usage.bit_and(0xFF)}, U8{(key_usage >> 8).bit_and(0xFF)}}
    buf := cipher.zero_bytes(5)
    p := 5
    len: asn1.write_named_bitstring(buf, p, 0, ku, 9) ?? return Err(.Asn1(err))
    if len < 3 || len > 5 -> return Err(.InvalidFormat(None))
    x509_set_extension(ctx.extensions, oids.OID_KEY_USAGE, true, cipher.bytes_of(buf, p, len))
}

// The ExtKeyUsageSyntax of the KeyPurposeId OIDs `exts`, in order.
x509write_ext_key_usage_der: fn(buf: &[U8], p: &Int, exts: [[U8]]) -> Int asn1.ASN1Error! {
    len := 0
    i := exts.len()
    loop i > 0 {
        i -= 1
        len += asn1.write_oid(buf, p, 0, exts[i])
    }
    total: asn1.write_len_and_tag(buf, p, 0, len, X509_CREATE_SEQUENCE)
    Ok(total)
}

/// Set the extKeyUsage extension, critical, to the KeyPurposeId OIDs
/// `exts` in order (mbedtls_x509write_crt_set_ext_key_usage, RFC 5280
/// section 4.2.1.12). BadInput for no OID, and the ASN.1 BufTooSmall past
/// the 256 bytes mbedtls gives the value.
x509write_crt_set_ext_key_usage: fn(ctx: &X509WriteCert, exts: [[U8]]) x509.X509Error! {
    if exts.len() == 0 -> return Err(.BadInput)
    buf := cipher.zero_bytes(256)
    p := 256
    len: x509write_ext_key_usage_der(buf, p, exts) ?? return Err(.Asn1(err))
    x509_set_extension(ctx.extensions, oids.OID_EXTENDED_KEY_USAGE, true, cipher.bytes_of(buf, p, len))
}

// A one-byte named BIT STRING, as the Netscape cert type and a request's
// key usage take it.
x509write_byte_bitstring: fn(bits: U8) -> [U8] x509.X509Error! {
    buf := cipher.zero_bytes(4)
    p := 4
    len: asn1.write_named_bitstring(buf, p, 0, [U8]{bits}, 8) ?? return Err(.Asn1(err))
    Ok(cipher.bytes_of(buf, p, len))
}

/// Set the Netscape certificate type extension from X509_NS_CERT_TYPE_*
/// bits (mbedtls_x509write_crt_set_ns_cert_type).
x509write_crt_set_ns_cert_type: fn(ctx: &X509WriteCert, ns_cert_type: U8) x509.X509Error! {
    bits: x509write_byte_bitstring(ns_cert_type)
    x509_set_extension(ctx.extensions, oids.OID_NS_CERT_TYPE, false, bits)
}

// A validity time: UTCTime without the century before 2050, else
// GeneralizedTime (x509_write_time, RFC 5280 section 4.1.2.5).
x509write_time: fn(buf: &[U8], p: &Int, t: [U8]) -> Int asn1.ASN1Error! {
    utc: t[0] < U8{50} || (t[0] == U8{50} && t[1] == U8{48} && t[2] < U8{53})
    if utc {
        short: asn1.write_tagged_string(buf, p, 0, asn1.ASN1_UTC_TIME, cipher.bytes_of(t, 2, t.len() - 2))
        return Ok(short)
    }
    long: asn1.write_tagged_string(buf, p, 0, asn1.ASN1_GENERALIZED_TIME, t)
    Ok(long)
}

// The TBSCertificate's fields from the extensions down to the subject.
x509write_crt_tail: fn(ctx: X509WriteCert, buf: &[U8], c: &Int) -> Int asn1.ASN1Error! {
    len := 0
    if ctx.version == X509_CRT_VERSION_3 {
        len = x509_write_extensions(buf, c, 0, ctx.extensions)
        len = asn1.write_len_and_tag(buf, c, 0, len, X509_CREATE_SEQUENCE)
        len = asn1.write_len_and_tag(buf, c, 0, len, asn1.ASN1_CONTEXT_SPECIFIC.bit_or(asn1.ASN1_CONSTRUCTED).bit_or(3))
    }
    Ok(len)
}

// The TBSCertificate's fields from the subject Name up to the signature
// AlgorithmIdentifier.
x509write_crt_head: fn(ctx: X509WriteCert, buf: &[U8], c: &Int, sig_oid: [U8], pk_alg: oids.PKType) -> Int asn1.ASN1Error! {
    len := x509_write_names(buf, c, 0, ctx.subject)
    validity := x509write_time(buf, c, ctx.not_after)
    validity += x509write_time(buf, c, ctx.not_before)
    len += asn1.write_len_and_tag(buf, c, 0, validity, X509_CREATE_SEQUENCE)
    len += x509_write_names(buf, c, 0, ctx.issuer)
    len += asn1.write_algorithm_identifier_ext(buf, c, 0, sig_oid, 0, pk_alg != .ECDSA)
    Ok(len)
}

// The TBSCertificate's version, if any, and the SEQUENCE around `len`
// bytes of fields.
x509write_crt_version: fn(ctx: X509WriteCert, buf: &[U8], c: &Int, fields: Int) -> Int asn1.ASN1Error! {
    len := fields
    if ctx.version != X509_CRT_VERSION_1 {
        v: asn1.write_int(buf, c, 0, ctx.version)
        len += asn1.write_len_and_tag(buf, c, 0, v, asn1.ASN1_CONTEXT_SPECIFIC.bit_or(asn1.ASN1_CONSTRUCTED))
    }
    total: asn1.write_len_and_tag(buf, c, 0, len, X509_CREATE_SEQUENCE)
    Ok(total)
}

/// The certificate as DER, signed by the issuer key with `rng` for RSA
/// blinding (mbedtls_x509write_crt_der). It is written as mbedtls writes it
/// into a buffer of `size` bytes, so a certificate that does not fit is the
/// ASN.1 BufTooSmall (or BufferTooSmall for the serial's sign byte).
/// InvalidAlg for an issuer key that is neither RSA nor EC, the OID
/// NOT_FOUND for a digest with no signature algorithm, and the key or
/// signing failure otherwise.
x509write_crt_der: fn<R: RNG>(ctx: &X509WriteCert, size: Int, rng: &R) -> [U8] x509.X509Error! {
    pk_alg: x509write_pk_alg(ctx.issuer_key)
    sig_oid: oids.oid_by_sig_alg(pk_alg, ctx.md_alg) ?? return Err(.OID(err))
    buf := cipher.zero_bytes(size)
    c := size
    len := x509write_crt_tail(ctx, buf, c) ?? return Err(.Asn1(err))
    len += pkwrite.pk_write_pubkey_der(ctx.subject_key, buf, c, 0) ?? return Err(x509write_pk_failure(err))
    len += x509write_crt_head(ctx, buf, c, sig_oid, pk_alg) ?? return Err(.Asn1(err))
    // Serial ::= INTEGER, with a 0x00 byte first when its top bit is set.
    serial_len := asn1.write_raw_buffer(buf, c, 0, ctx.serial) ?? return Err(.Asn1(err))
    if buf[c].bit_and(U8{0x80}) != (U8{0}) {
        if c < 1 -> return Err(.BufferTooSmall)
        c -= 1
        buf[c] = U8{0}
        serial_len += 1
    }
    len += asn1.write_len_and_tag(buf, c, 0, serial_len, asn1.ASN1_INTEGER) ?? return Err(.Asn1(err))
    len = x509write_crt_version(ctx, buf, c, len) ?? return Err(.Asn1(err))
    tbs: cipher.bytes_of(buf, c, len)
    md: ctx.md_alg ?? return Err(.BadInput)
    sig: pk.pk_sign(ctx.issuer_key, ctx.md_alg, hashes.hash(md, tbs), pk.PK_SIGNATURE_MAX_SIZE, rng) ?? return Err(.PK(err))
    der: x509write_signed(size, tbs, sig_oid, sig, pk_alg) ?? return Err(.Asn1(err))
    Ok(der)
}

/// The certificate as a PEM "CERTIFICATE" block (mbedtls_x509write_crt_pem;
/// see x509write_crt_der).
x509write_crt_pem: fn<R: RNG>(ctx: &X509WriteCert, size: Int, rng: &R) -> [U8] x509.X509Error! {
    der: x509write_crt_der(ctx, size, rng)
    Ok(pem.pem_write_buffer("-----BEGIN CERTIFICATE-----\n", "-----END CERTIFICATE-----\n", der))
}

// ---- certificate requests (x509write_csr.c) ----

/// A certificate request to write (mbedtls_x509write_csr). `key` and
/// `md_alg` are set directly; the setters below fill the rest.
X509WriteCSR: struct {
    key: pk.PKContext
    subject: [asn1.NamedData]
    md_alg: hashes.Md?
    extensions: [asn1.NamedData]
}

/// A request with no key, subject, digest or extensions
/// (mbedtls_x509write_csr_init).
x509write_csr_new: fn() -> X509WriteCSR Never! {
    X509WriteCSR{key: pk.pk_new(), subject: [asn1.NamedData]{}, md_alg: None, extensions: [asn1.NamedData]{}}
}

/// Set the subject from its string form (mbedtls_x509write_csr_set_subject_name;
/// see x509_string_to_names).
x509write_csr_set_subject_name: fn(ctx: &X509WriteCSR, name: String) x509.X509Error! {
    ctx.subject = [asn1.NamedData]{}
    x509_string_to_names(ctx.subject, name)
}

/// Add or replace the extension `oid` with the DER value `val`
/// (mbedtls_x509write_csr_set_extension).
x509write_csr_set_extension: fn(ctx: &X509WriteCSR, oid: [U8], critical: Bool, val: [U8]) Never! {
    x509_set_extension(ctx.extensions, oid, critical, val)
}

/// Set the subjectAltName extension (mbedtls_x509write_csr_set_subject_alternative_name;
/// see x509_write_set_san_common).
x509write_csr_set_subject_alternative_name: fn(ctx: &X509WriteCSR, sans: [X509SanEntry]) x509.X509Error! {
    x509_write_set_san_common(ctx.extensions, sans)
}

/// Set the keyUsage extension, not critical, from the X509_KU_* bits of
/// one byte (mbedtls_x509write_csr_set_key_usage).
x509write_csr_set_key_usage: fn(ctx: &X509WriteCSR, key_usage: U8) x509.X509Error! {
    bits: x509write_byte_bitstring(key_usage)
    x509_set_extension(ctx.extensions, oids.OID_KEY_USAGE, false, bits)
}

/// Set the Netscape certificate type extension from X509_NS_CERT_TYPE_*
/// bits (mbedtls_x509write_csr_set_ns_cert_type).
x509write_csr_set_ns_cert_type: fn(ctx: &X509WriteCSR, ns_cert_type: U8) x509.X509Error! {
    bits: x509write_byte_bitstring(ns_cert_type)
    x509_set_extension(ctx.extensions, oids.OID_NS_CERT_TYPE, false, bits)
}

// The CertificationRequestInfo's attributes: the extensionRequest of the
// extensions when there are any, inside the [0] of attributes.
x509write_csr_attributes: fn(ctx: X509WriteCSR, buf: &[U8], c: &Int) -> Int asn1.ASN1Error! {
    len := x509_write_extensions(buf, c, 0, ctx.extensions)
    if len != 0 {
        len = asn1.write_len_and_tag(buf, c, 0, len, X509_CREATE_SEQUENCE)
        len = asn1.write_len_and_tag(buf, c, 0, len, X509_CREATE_SET)
        len += asn1.write_oid(buf, c, 0, oids.OID_PKCS9_CSR_EXT_REQ)
        len = asn1.write_len_and_tag(buf, c, 0, len, X509_CREATE_SEQUENCE)
    }
    total: asn1.write_len_and_tag(buf, c, 0, len, asn1.ASN1_CONSTRUCTED.bit_or(asn1.ASN1_CONTEXT_SPECIFIC))
    Ok(total)
}

// The CertificationRequestInfo's subject and version 0, and the SEQUENCE
// around `len` bytes of fields.
x509write_csr_info: fn(ctx: X509WriteCSR, buf: &[U8], c: &Int, fields: Int) -> Int asn1.ASN1Error! {
    len := fields
    len += x509_write_names(buf, c, 0, ctx.subject)
    len += asn1.write_int(buf, c, 0, 0)
    total: asn1.write_len_and_tag(buf, c, 0, len, X509_CREATE_SEQUENCE)
    Ok(total)
}

/// The request as DER, signed by its key with `rng` for RSA blinding
/// (mbedtls_x509write_csr_der). It is written as mbedtls writes it into a
/// buffer of `size` bytes, so a request that does not fit is the ASN.1
/// BufTooSmall. BadInput for no digest, the signing failure, then
/// InvalidAlg for a key that is neither RSA nor EC and the OID NOT_FOUND
/// for a digest with no signature algorithm.
x509write_csr_der: fn<R: RNG>(ctx: &X509WriteCSR, size: Int, rng: &R) -> [U8] x509.X509Error! {
    buf := cipher.zero_bytes(size)
    c := size
    len := x509write_csr_attributes(ctx, buf, c) ?? return Err(.Asn1(err))
    len += pkwrite.pk_write_pubkey_der(ctx.key, buf, c, 0) ?? return Err(x509write_pk_failure(err))
    len = x509write_csr_info(ctx, buf, c, len) ?? return Err(.Asn1(err))
    tbs: cipher.bytes_of(buf, c, len)
    md: ctx.md_alg ?? return Err(.BadInput)
    sig: pk.pk_sign(ctx.key, ctx.md_alg, hashes.hash(md, tbs), pk.PK_SIGNATURE_MAX_SIZE, rng) ?? return Err(.PK(err))
    pk_alg: x509write_pk_alg(ctx.key)
    sig_oid: oids.oid_by_sig_alg(pk_alg, ctx.md_alg) ?? return Err(.OID(err))
    der: x509write_signed(size, tbs, sig_oid, sig, pk_alg) ?? return Err(.Asn1(err))
    Ok(der)
}

/// The request as a PEM "CERTIFICATE REQUEST" block
/// (mbedtls_x509write_csr_pem; see x509write_csr_der).
x509write_csr_pem: fn<R: RNG>(ctx: &X509WriteCSR, size: Int, rng: &R) -> [U8] x509.X509Error! {
    der: x509write_csr_der(ctx, size, rng)
    Ok(pem.pem_write_buffer("-----BEGIN CERTIFICATE REQUEST-----\n", "-----END CERTIFICATE REQUEST-----\n", der))
}

#Test("A string name writes as the Name it reads back as, a repeated type replacing the earlier") {
    names := [asn1.NamedData]{}
    x509_string_to_names(names, "C=NL, O=Example\\, Inc,CN=a,CN=b") ?? panic("string_to_names")
    assert(names.len() == 3)
    buf := cipher.zero_bytes(128)
    p := 128
    len: x509_write_names(buf, p, 0, names) ?? panic("write_names")
    assert(p + len == 128)
    q := p
    seq_len: asn1.get_tag(buf, q, 128, X509_CREATE_SEQUENCE) ?? panic("sequence")
    parsed: x509.x509_get_name(buf, q, q + seq_len) ?? panic("get_name")
    text: x509.x509_dn_gets(parsed) ?? panic("dn_gets")
    assert(text == "C=NL, O=Example\\, Inc, CN=b".bytes())
    assert(x509_string_to_names(names, "CN=c") == .Err(.BadInput))
    empty := [asn1.NamedData]{}
    assert(x509_string_to_names(empty, "CN") == .Err(.InvalidName(None)))
    assert(x509_string_to_names(empty, "2.5.4.3=text") == .Err(.InvalidName(None)))
}

#Test("The keyUsage setter takes only the bits RFC 5280 defines, and a v3 serial longer than 20 bytes is refused") {
    crt := x509write_crt_new()
    assert(x509write_crt_set_key_usage(crt, 0x0100) == .Err(.FeatureUnavailable(None)))
    x509write_crt_set_key_usage(crt, x509.X509_KU_DIGITAL_SIGNATURE.bit_or(x509.X509_KU_DECIPHER_ONLY)) ?? panic("key_usage")
    // BIT STRING of 9 bits: 7 unused, 0x80 then 0x80.
    assert(crt.extensions[0].val == [U8]{1, 0x03, 0x03, 0x07, 0x80, 0x80})
    assert(x509write_crt_set_serial_raw(crt, cipher.zero_bytes(21)) == .Err(.BadInput))
    assert(x509write_crt_set_validity(crt, "2024010100000", "20250101000000") == .Err(.BadInput))
}
