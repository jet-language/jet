package: {
    name: "core.crypto"
    version: "0.0.1"
    edition: "2026"
    description: "Typed cryptography: hashes in Jet, envelopes on the host."
    license: "MIT"
    outputs: {
        crypto: .Library{ entry: crypto }
    }
}
use {
    core
    rawcrypto: core.crypto.expert
    random: core.crypto.random
    core.crypto.vault.[KeyUnlock, WrappedVaultKey]
    core.files.[basename, dirname, join]
    rt: jet.runtime.files
    fixedcrypto: __core_crypto_ct
    hashes: __core_crypto_md
    byte_words.[load_le32, push_le32]
    chacha20_core.[chacha20_rounds, chacha20_state, chacha20_words]
}

// core.crypto - safe envelopes and expert primitives.
//
// This package is the typed rung. Beginner APIs hide nonce handling and
// algorithm choice. Raw algorithm control lives in `core.crypto.expert` and
// requires an audited `#Unsafe` region at the call site.
//
// Written in Jet:
// - SHA-1 / SHA-2 / SHA-3 / BLAKE3
// - HMAC-SHA256, HKDF-SHA256 expand, PBKDF2-HMAC-SHA256
// - ChaCha20-Poly1305, X25519, Ed25519, AES-256-GCM (expert)
// - constant-time equality
// - UUID v4/v5/v7 (v4/v7 need host CSPRNG; v5 is pure)
//
// The only host cells are the OS CSPRNG and file bytes for file_seal.
//
// Secret-bearing types are nominal. Do not log them; `Show` must not print
// key bytes. Fail closed: a missing RNG is an error, never a fallback to
// a weak generator.
expert: module

random: module

uuid: module

vault: module

use jetc: __core_crypto_jetc

// Private whole-record physical facts for the temporary syscall seed.
// `linux` is a compile-time host capability, consumed once at parent open.
__JetcRaw: struct { value: Int, errno: Int, bytes: [U8], linux: Bool }
__JetcStat: struct {
    status: Int, errno: Int, dev: Int, ino: Int, len: Int,
    mtime: Int, mtime_ns: Int, nlink: Int, is_file: Bool, is_dir: Bool,
}
JetcFd: struct {
    priv fd: Int

    // Close reads the consumed receiver in place. Rebinding it (`owner: &&self`)
    // would make a second owner whose scope-end Close re-enters this one.
    impl Close {
        close: fn(&&self) {
            if self.fd >= 0 -> _: core.crypto.__jetc_close(self.fd)
        }
    }
} // priv: a literal elsewhere could close any descriptor at scope end
JetcTemp: struct {
    file: JetcFd
    path: String?

    impl Close {
        close: fn(&&self) {
            // Best-effort cleanup: Close cannot fail, so a removal error is dropped.
            if self.path == .Val(path) {
                core.files.__remove_raw(path).drop("temp removal at close is best-effort")
            }
        }
    }
}
#Error
CryptoError: enum {
    OpenFailed
    VerifyFailed
    KeyRejected
    Length
    Unavailable
}

#Error
FileCryptoError: enum {
    OpenFailed
    SealFailed
    SourceIO
    DestinationExists
    DestinationIO
}

Digest256: struct {
    bytes: [U8]

    as_bytes: fn(self) -> [U8] Never! { self.bytes }

    hex: fn(self) -> String Never! { hex_encode(self.bytes) }

    impl Display { display: fn(self) -> String { self.hex() } }
}

Digest512: struct {
    bytes: [U8]

    as_bytes: fn(self) -> [U8] Never! { self.bytes }

    hex: fn(self) -> String Never! { hex_encode(self.bytes) }

    impl Display { display: fn(self) -> String { self.hex() } }
}

/// Streaming SHA-256 (FIPS 180-4): `update` absorbs input as it arrives,
/// holding at most one partial 64-byte block, so a large input is never held
/// whole.
Hasher: struct {
    priv ctx: hashes.HashCtx

    new: fn() -> Hasher Never! { {ctx: hashes.hash_start(.SHA256)} }

    update: fn(&self, bytes: [U8]) Never! { hashes.hash_update(self.ctx, bytes) }

    /// The lowercase hex SHA-256 of everything absorbed so far; the hasher
    /// can keep absorbing afterwards.
    digest: fn(self) -> String Never! {
        done := hashes.hash_clone(self.ctx)
        hex_encode(hashes.hash_finish(done))
    }
}

/// Hashlib-style module constructors for the default SHA-256 hasher.
new: fn() -> Hasher Never! { Hasher.new() }

update: fn(hasher: &Hasher, bytes: [U8]) Never! { hasher.update(bytes) }

digest: fn(hasher: &&Hasher) -> String Never! { hasher.digest() }

#!Encode
Secret: struct {
    bytes: [U8]

    /// The UTF-8 bytes of `text` as secret material.
    from_text: fn(text: String) -> Secret Never! { Secret{bytes: text.bytes()} }

    from_bytes: fn(bytes: [U8]) -> Secret Never! { Secret{bytes: bytes} }

    // Configuration codecs construct the nominal secret from text.
    // There is deliberately no Encode implementation that could reveal its bytes.
    impl Decode {
        decode: fn(tree: Dyn) -> Secret [FieldError]! {
            if tree == .Text(text) -> return Ok(Secret.from_text(text))
            return Err([FieldError{path: "", reason: "expected a string"}])
        }
    }

    // Secret-bearing values wipe their bytes when they close.
    // Close takes the resident buffer out of the consumed receiver and zeroes that
    // same allocation before it is released. Rebinding `self.move()` instead would make a
    // second owner whose scope-end Close re-enters this one.
    impl Close {
        close: fn(&&self) {
            bytes := self.bytes.move()
            core.crypto.wipe(bytes)
        }
    }
}

SigningKey: struct {
    bytes: [U8]

    /// A fresh Ed25519 seed from the OS CSPRNG. There is no fallback generator.
    new_random: fn() -[Rand]> SigningKey CryptoError! {
        seed: random.bytes(32) ?? return Err(CryptoError.Unavailable)
        Ok(SigningKey{bytes: seed})
    }

    /// An Ed25519 seed. It must be exactly 32 bytes.
    from_bytes: fn(bytes: [U8]) -> SigningKey CryptoError! {
        if bytes.len() != 32 -> return Err(CryptoError.Length)
        Ok(SigningKey{bytes: bytes})
    }

    /// The RFC 8032 public key for this seed.
    public_key: fn(self) -> VerifyKey Never! { VerifyKey{bytes: ed25519_public_raw(self.bytes)} }

    impl Close {
        close: fn(&&self) {
            bytes := self.bytes.move()
            core.crypto.wipe(bytes)
        }
    }
}

VerifyKey: struct {
    bytes: [U8]

    /// An encoded Ed25519 public key. It must be exactly 32 bytes.
    from_bytes: fn(bytes: [U8]) -> VerifyKey CryptoError! {
        if bytes.len() != 32 -> return Err(CryptoError.Length)
        Ok(VerifyKey{bytes: bytes})
    }
}

X25519SecretKey: struct {
    bytes: [U8]

    /// A fresh X25519 private key from the OS CSPRNG.
    new_random: fn() -[Rand]> X25519SecretKey CryptoError! {
        key: random.bytes(32) ?? return Err(CryptoError.Unavailable)
        Ok(X25519SecretKey{bytes: key})
    }

    /// A raw X25519 private key. It must be exactly 32 bytes.
    from_bytes: fn(bytes: [U8]) -> X25519SecretKey CryptoError! {
        if bytes.len() != 32 -> return Err(CryptoError.Length)
        Ok(X25519SecretKey{bytes: bytes})
    }

    /// The RFC 7748 public key. A key that isn't 32 bytes stops with a panic;
    /// `x25519_public` is the checked form.
    public_key: fn(self) -> X25519PublicKey Never! { X25519PublicKey{bytes: x25519_scalarmult(self.bytes, x25519_base_point())} }

    impl Close {
        close: fn(&&self) {
            bytes := self.bytes.move()
            core.crypto.wipe(bytes)
        }
    }
}

X25519PublicKey: struct {
    bytes: [U8]

    /// A raw X25519 public key. It must be exactly 32 bytes.
    from_bytes: fn(bytes: [U8]) -> X25519PublicKey CryptoError! {
        if bytes.len() != 32 -> return Err(CryptoError.Length)
        Ok(X25519PublicKey{bytes: bytes})
    }

    /// Parse the Bech32m recipient text written by `text`. Anything else,
    /// including uppercase, truncation and a bad checksum, is `KeyRejected`.
    from_text: fn(text: String) -> X25519PublicKey CryptoError! {
        bytes: x25519_recipient_decode(text) ?? return Err(CryptoError.KeyRejected)
        Ok(X25519PublicKey{bytes: bytes})
    }

    /// Bech32m recipient text: `jetx25519` + `1` + 52 data symbols + checksum.
    text: fn(self) -> String Never! { x25519_recipient_encode(self.bytes) }
}

SharedSecret: struct {
    bytes: [U8]

    impl Close {
        close: fn(&&self) {
            bytes := self.bytes.move()
            core.crypto.wipe(bytes)
        }
    }
}

Signature: struct {
    bytes: [U8]

    /// An Ed25519 signature. It must be exactly 64 bytes.
    from_bytes: fn(bytes: [U8]) -> Signature CryptoError! {
        if bytes.len() != 64 -> return Err(CryptoError.Length)
        Ok(Signature{bytes: bytes})
    }
}

Sealed: struct {
    bytes: [U8]
}

sealed_bytes: fn(value: Sealed) -> [U8] Never! { value.bytes }

WrappedKey: struct {
    bytes: [U8]
}

// Vault key-wrap carriers have one canonical source owner in core.crypto.vault.
__vault_wrapped_from_bytes: fn(bytes: &&[U8]) -> WrappedVaultKey KeyWrapError! {
    #Unsafe("vault key import: validate a serialized wrapped carrier at the typed crypto boundary") {
        wrapped: core.crypto.vault.__wrapped_from_bytes(bytes) ?? return Err(KeyWrapError{reason: err.reason})
        return Ok(wrapped)
    }
}
__vault_wrapped_bytes: fn(wrapped: WrappedVaultKey) -> [U8] Never! {
    #Unsafe("vault key import: expose the authenticated wrapped carrier, not plaintext key material") {
        return core.crypto.vault.__wrapped_bytes(wrapped)
    }
}
__vault_unlock_recipient: fn(identity: X25519SecretKey) -> KeyUnlock Never! {
    #Unsafe("vault key import: construct the typed recipient unlock request") {
        return core.crypto.vault.__key_unlock_recipient(identity)
    }
}
__vault_unlock_passphrase: fn(passphrase: Secret) -> KeyUnlock Never! {
    #Unsafe("vault key import: construct the typed passphrase unlock request") {
        return core.crypto.vault.__key_unlock_passphrase(passphrase)
    }
}

PasswordHash: struct {
    text: String
}

#Error
KeyWrapError: struct {
    reason: String
}

/// SHA-256 (FIPS 180-4). Allocates a 32-byte digest. Text hashes its UTF-8
/// bytes, so `sha256("hello")` equals `sha256("hello".bytes())`.
sha256: fn(input: [U8] | String) -> Digest256 Never! {
    if input == {
        .M__U8_(bytes) -> Digest256{bytes: hashes.hash(.SHA256, bytes)}
        .String(text) -> Digest256{bytes: hashes.hash(.SHA256, text.bytes())}
    }
}

/// SHA-224 (FIPS 180-4).
sha224: fn(bytes: [U8]) -> String Never! { hex_encode(hashes.hash(.SHA224, bytes)) }

/// SHA-1 (FIPS 180-4). Prefer SHA-256; this exists for UUID v5 and legacy checks.
sha1: fn(bytes: [U8]) -> String Never! { hex_encode(hashes.hash(.SHA1, bytes)) }

/// SHA-384 (FIPS 180-4).
sha384: fn(bytes: [U8]) -> String Never! { hex_encode(hashes.hash(.SHA384, bytes)) }

/// SHA-512 (FIPS 180-4).
sha512: fn(bytes: [U8]) -> Digest512 Never! { {bytes: hashes.hash(.SHA512, bytes)} }

/// SHA-3 (FIPS 202).
sha3_224: fn(bytes: [U8]) -> String Never! { hex_encode(hashes.hash(.SHA3x224, bytes)) }

sha3_256: fn(bytes: [U8]) -> String Never! { hex_encode(hashes.hash(.SHA3x256, bytes)) }

sha3_384: fn(bytes: [U8]) -> String Never! { hex_encode(hashes.hash(.SHA3x384, bytes)) }

sha3_512: fn(bytes: [U8]) -> String Never! { hex_encode(hashes.hash(.SHA3x512, bytes)) }

/// BLAKE3-256. Tree hasher, 32-byte output.
blake3: fn(bytes: [U8]) -> Digest256 Never! { {bytes: blake3_raw(bytes)} }

/// HMAC-SHA256 (RFC 2104; test vectors RFC 4231).
hmac_sha256: fn(key: [U8], data: [U8]) -> [U8] Never! { hashes.hmac(.SHA256, key, data) }

/// HKDF-SHA256 (RFC 5869), extract then expand. `len` is 0..=8160. The output
/// is a `Secret` so callers cannot print it by accident.
hkdf_sha256: fn(ikm: [U8], salt: [U8], info: [U8], len: Int) -> Secret CryptoError! {
    if len < 0 || len > 8160 -> return Err(CryptoError.Length)
    out: hashes.hkdf(.SHA256, salt, ikm, info, len) ?? return Err(CryptoError.Length)
    Ok(Secret{bytes: out})
}

/// PBKDF2-HMAC-SHA256 (RFC 8018 section 5.2).
pbkdf2_hmac: fn(password: [U8], salt: [U8], iterations: Int, key_len: Int) -> [U8] CryptoError! {
    if iterations < 1 || key_len < 1 || key_len > 67108864 -> return Err(CryptoError.Length)
    Ok(hashes.pbkdf2(.SHA256, password, salt, iterations, key_len))
}

// Zeroes the buffer in place. The qualified call is deliberate: inside this
// package it selects the primitive Core route, so this public entry owns the
// user-facing signature.
wipe: fn(bytes: &[U8]) Never! { core.crypto.wipe(bytes) }

/// Whether a and b hold the same bytes, in time that depends only on their
/// lengths: the bytes fold into one U8 difference, with no branch on them.
constant_time_equal_bytes: fn(a: [U8], b: [U8]) -> Bool Never! {
    diff := U8{0}
    if a.len() != b.len() -> diff = U8{1}
    n: a.len()
    m: b.len()
    limit := n
    if m > limit -> limit = m
    loop i in 0..<limit {
        left := U8{0}
        right := U8{0}
        if i < n -> left = a[i]
        if i < m -> right = b[i]
        diff = diff.bit_or(left.bit_xor(right))
    }
    diff == U8{0}
}

constant_time_equal: fn(a: Secret, b: Secret) -> Bool Never! {
    constant_time_equal_bytes(a.bytes, b.bytes)
}

// X25519 recipients + XChaCha20-Poly1305.
//
// JETV1 wire format:
// `JETV` || version || suite || flags || recipient_count ||
// ephemeral_public || salt || payload_nonce ||
// sorted recipient stanzas || plaintext_length || ciphertext||tag.
seal: fn(recipients: [X25519PublicKey], bytes: [U8], aad: [U8]) -[Rand]> Sealed CryptoError! {
    if recipients.len() == 0 || recipients.len() > 256 -> return Err(CryptoError.KeyRejected)
    if bytes.len() > 16777216 || aad.len() > 16777216 -> return Err(CryptoError.Length)
    loop recipient in recipients {
        if recipient.bytes.len() != 32 -> return Err(CryptoError.KeyRejected)
    }
    sorted: canonical_recipients(recipients)
    loop i in 1..<sorted.len() {
        if key_order(sorted[i - 1].bytes, sorted[i].bytes) >= 0 {
            return Err(CryptoError.KeyRejected)
        }
    }
    eph_sk: random.bytes(32) ?? return Err(CryptoError.Unavailable)
    eph_pk: x25519_public(X25519SecretKey{bytes: copy_bytes(eph_sk)}) ?? return Err(CryptoError.KeyRejected)
    salt: random.bytes(16) ?? return Err(CryptoError.Unavailable)
    nonce: random.bytes(24) ?? return Err(CryptoError.Unavailable)
    file_key: random.bytes(32) ?? return Err(CryptoError.Unavailable)
    header := [U8]{}
    loop b in "JETV".bytes() -> header.push(b)
    header.push(U8{1})
    header.push(U8{1})
    header.push(U8{0})
    header.push(U8{0})
    header.push(wrapping(U8{sorted.len() /% 256}))
    header.push(wrapping(U8{sorted.len() %% 256}))
    loop b in eph_pk.bytes -> header.push(b)
    loop b in salt -> header.push(b)
    loop b in nonce -> header.push(b)
    stanzas := [U8]{}
    loop rec in sorted {
        shared: x25519(X25519SecretKey{bytes: copy_bytes(eph_sk)}, rec) ?? return Err(CryptoError.KeyRejected)
        key_info := [U8]{}
        loop b in "JETV1 wrap".bytes() -> key_info.push(b)
        loop b in eph_pk.bytes -> key_info.push(b)
        loop b in rec.bytes -> key_info.push(b)
        kek: hkdf_sha256(shared.bytes, salt, key_info, 32) ?? return Err(CryptoError.Length)
        nonce_info := [U8]{}
        loop b in "JETV1 nonce".bytes() -> nonce_info.push(b)
        loop b in eph_pk.bytes -> nonce_info.push(b)
        loop b in rec.bytes -> nonce_info.push(b)
        wrap_nonce: hkdf_sha256(shared.bytes, salt, nonce_info, 24) ?? return Err(CryptoError.Length)
        stanza_aad := [U8]{}
        loop b in "JETV1 stanza".bytes() -> stanza_aad.push(b)
        loop b in header -> stanza_aad.push(b)
        loop b in rec.bytes -> stanza_aad.push(b)
        wrapped: xchacha_seal(kek.bytes, wrap_nonce.bytes, stanza_aad, file_key)
        if wrapped.len() != 48 -> return Err(CryptoError.Length)
        loop b in rec.bytes -> stanzas.push(b)
        loop b in wrapped -> stanzas.push(b)
    }
    payload_aad := [U8]{}
    loop b in "JETV1 payload".bytes() -> payload_aad.push(b)
    loop b in header -> payload_aad.push(b)
    loop b in stanzas -> payload_aad.push(b)
    loop b in aad -> payload_aad.push(b)
    body: xchacha_seal(file_key, nonce, payload_aad, bytes)
    out := [U8]{}
    loop b in header -> out.push(b)
    loop b in stanzas -> out.push(b)
    _: append_be32(out, bytes.len()) ?? return Err(CryptoError.Length)
    loop b in body -> out.push(b)
    Ok(Sealed{bytes: out})
}

open_sealed: fn(identity: X25519SecretKey, box: Sealed, aad: [U8]) -> [U8] CryptoError! {
    raw: box.bytes
    if aad.len() > 16777216 -> return Err(CryptoError.OpenFailed)
    if raw.len() < 182 || raw.len() > 16797798 -> return Err(CryptoError.OpenFailed)
    if slice_u8(raw, 0, 4) != "JETV".bytes() -> return Err(CryptoError.OpenFailed)
    if raw[4] != (U8{1}) || raw[5] != (U8{1}) || raw[6] != (U8{0}) || raw[7] != (U8{0}) {
        return Err(CryptoError.OpenFailed)
    }
    count: ((Int.from_u8(raw[8]) << 8)).bit_or(Int.from_u8(raw[9]))
    if count < 1 || count > 256 -> return Err(CryptoError.OpenFailed)
    len_offset: 82 + count * 80
    if raw.len() < len_offset + 20 -> return Err(CryptoError.OpenFailed)
    payload_len: read_be32(raw, len_offset)
    payload_end: len_offset + 4 + payload_len + 16
    if payload_len > 16777216 || raw.len() != payload_end -> return Err(CryptoError.OpenFailed)
    previous := [U8]{}
    loop index in 0..<count {
        current: slice_u8(raw, 82 + index * 80, 82 + index * 80 + 32)
        if index > 0 && key_order(previous, current) >= 0 -> return Err(CryptoError.OpenFailed)
        previous = current
    }
    own_public: x25519_public(identity) ?? return Err(CryptoError.KeyRejected)
    stanza_index := -1
    loop index in 0..<count {
        current: slice_u8(raw, 82 + index * 80, 82 + index * 80 + 32)
        if constant_time_equal_bytes(current, own_public.bytes) -> stanza_index = index
    }
    if stanza_index < 0 -> return Err(CryptoError.OpenFailed)
    eph: slice_u8(raw, 10, 42)
    shared: x25519(identity, X25519PublicKey{bytes: copy_bytes(eph)}) ?? return Err(CryptoError.KeyRejected)
    salt: slice_u8(raw, 42, 58)
    key_info := [U8]{}
    loop b in "JETV1 wrap".bytes() -> key_info.push(b)
    loop b in eph -> key_info.push(b)
    loop b in own_public.bytes -> key_info.push(b)
    kek: hkdf_sha256(shared.bytes, salt, key_info, 32) ?? return Err(CryptoError.Length)
    nonce_info := [U8]{}
    loop b in "JETV1 nonce".bytes() -> nonce_info.push(b)
    loop b in eph -> nonce_info.push(b)
    loop b in own_public.bytes -> nonce_info.push(b)
    wrap_nonce: hkdf_sha256(shared.bytes, salt, nonce_info, 24) ?? return Err(CryptoError.Length)
    stanza_aad := [U8]{}
    loop b in "JETV1 stanza".bytes() -> stanza_aad.push(b)
    loop b in slice_u8(raw, 0, 82) -> stanza_aad.push(b)
    loop b in own_public.bytes -> stanza_aad.push(b)
    stanza_start: 82 + stanza_index * 80
    wrapped: slice_u8(raw, stanza_start + 32, stanza_start + 80)
    file_key_opt: xchacha_open(kek.bytes, wrap_nonce.bytes, stanza_aad, wrapped)
    file_key: file_key_opt ?? return Err(CryptoError.OpenFailed)
    if file_key.len() != 32 -> return Err(CryptoError.OpenFailed)
    payload_aad := [U8]{}
    loop b in "JETV1 payload".bytes() -> payload_aad.push(b)
    loop b in slice_u8(raw, 0, 82) -> payload_aad.push(b)
    loop b in slice_u8(raw, 82, len_offset) -> payload_aad.push(b)
    loop b in aad -> payload_aad.push(b)
    nonce: slice_u8(raw, 58, 82)
    body: slice_u8(raw, len_offset + 4, raw.len())
    opened: xchacha_open(file_key, nonce, payload_aad, body) ?? return Err(CryptoError.OpenFailed)
    Ok(opened)
}

canonical_recipients: fn(items: [X25519PublicKey]) -> [X25519PublicKey] Never! {
    out := [X25519PublicKey]{}
    loop item in items -> out.push(X25519PublicKey{bytes: copy_bytes(item.bytes)})
    i := 1
    loop i < out.len() {
        current := out[i]
        j := i
        loop j > 0 && key_order(out[j - 1].bytes, current.bytes) > 0 {
            out[j] = out[j - 1]
            j = j - 1
        }
        out[j] = current
        i = i + 1
    }
    out
}

key_order: fn(a: [U8], b: [U8]) -> Int Never! {
    if a.len() != b.len() {
        if a.len() < b.len() -> return -1
        return 1
    }
    loop i in 0..<a.len() {
        x: Int.from_u8(a[i])
        y: Int.from_u8(b[i])
        if x < y -> return -1
        if x > y -> return 1
    }
    0
}

append_be32: fn(out: &[U8], n: Int) -> Bool CryptoError! {
    out.push(wrapping(U8{n >> 24}))
    out.push(wrapping(U8{n >> 16}))
    out.push(wrapping(U8{n >> 8}))
    out.push(wrapping(U8{n}))
    true
}

open: fn(identity: X25519SecretKey, box: Sealed, aad: [U8]) -> [U8] CryptoError! {
    open_sealed(identity, box, aad)
}

file_seal: fn(recipients: [X25519PublicKey], source: Path, destination: Path) FileCryptoError! -[FS, Rand]> {
    canonical: jetc.canonical(recipients)
    parent: jetc_parent(destination.to_string())
    // The portable oracle deliberately has no race-safe source snapshot.
    if !parent.linux -> return Err(.SourceIO)
    input: jetc_source(source.to_string(), .SourceIO)
    metadata: jetc_stat(input, .SourceIO)
    if metadata.len < 0 || metadata.len > jetc.MAX_PLAIN -> return Err(.SourceIO)
    stage: jetc_stage(parent)
    jetc_cancel_checkpoint()
    hash := hashes.hash_start(.SHA256)
    length := 0
    loop {
        jetc_cancel_checkpoint()
        part: jetc_read(input, jetc.CHUNK, "seal-source-read", .SourceIO)
        if part.bytes.len() == 0 -> break
        length += part.bytes.len()
        if length > jetc.MAX_PLAIN -> return Err(.SourceIO)
        hashes.hash_update(hash, part.bytes)
        jetc_write(stage.file, part.bytes, "seal-stage-write")
    }
    if length != metadata.len -> return Err(.SourceIO)
    expected: hashes.hash_finish(hash)
    jetc_sync(stage.file, "seal-stage-fsync")
    jetc_seek(stage.file, .DestinationIO)
    staged: jetc_digest(stage.file, length, "seal-stage-read")
    if !constant_time_equal_bytes(staged, expected) -> return Err(.SourceIO)
    second: jetc_source(source.to_string(), .SourceIO)
    if !jetc_same_source(metadata, jetc_stat(second, .SourceIO)) -> return Err(.SourceIO)
    current: jetc_digest(second, length, "seal-source-recheck-read")
    if !constant_time_equal_bytes(current, expected) -> return Err(.SourceIO)
    jetc_seek(stage.file, .DestinationIO)
    stage_metadata: jetc_stat(stage.file, .SourceIO)
    jetc_seal_stage(canonical, parent, stage, length, expected, stage_metadata, false)
    Ok()
}

file_open: fn(identity: X25519SecretKey, source: Path, destination: Path) FileCryptoError! -[FS]> {
    input: jetc_source(source.to_string(), .OpenFailed)
    metadata: jetc_stat(input, .OpenFailed)
    fixed: jetc_read_exact(input, 20, "open-input-read", .OpenFailed)
    header_size: jetc.header_length(fixed.bytes, metadata.len)
    header: jetc_read_exact(input, header_size, "open-input-read", .OpenFailed)
    reader := jetc.reader(identity, fixed.bytes, header.bytes, metadata.len)
    parent: jetc_parent(destination.to_string())
    output := jetc_temp(parent, "jetc-open")
    jetc_cancel_checkpoint()
    loop reader.remaining > 0 {
        jetc_cancel_checkpoint()
        framing: jetc_read_exact(input, 5, "open-input-read", .OpenFailed)
        size: jetc.integer(framing.bytes, 0, 4)
        if !jetc.record_shape(size, framing.bytes[4]) -> return Err(.OpenFailed)
        encrypted: jetc_read_exact(input, size + jetc.TAG, "open-input-read", .OpenFailed)
        clear: jetc.open_chunk(reader, framing.bytes, encrypted.bytes)
        jetc_write(output.file, clear.bytes, "open-output-write")
    }
    trailing: jetc_read(input, 1, "open-input-read", .OpenFailed)
    jetc.finish(reader, trailing.bytes)
    jetc_publish(output, parent, "open")
    Ok()
}

// Internal source-owned migration coordinator, shared with expert.migrate_v1.
// The legacy grammar intentionally retains its bounded whole-buffer contract.
__migrate_v1: fn(key: [U8], source: Path, recipients: [X25519PublicKey], destination: Path) -[FS, Rand]> Bool FileCryptoError! {
    if source.to_string() == destination.to_string() -> return Err(.DestinationExists)
    input: jetc_source(source.to_string(), .SourceIO)
    total: jetc_stat(input, .SourceIO).len
    if total > 1073741858 -> return Err(.OpenFailed)
    data := Secret{bytes: [U8]{}}
    loop {
        jetc_cancel_checkpoint()
        part: jetc_read(input, jetc.CHUNK, "migrate-v1-read-io", .SourceIO)
        if part.bytes.len() == 0 -> break
        if data.bytes.len() + part.bytes.len() > 1073741858 -> return Err(.OpenFailed)
        loop byte in part.bytes -> data.bytes.push(byte)
    }
    if data.bytes.len() != total -> return Err(.SourceIO)
    plain := Secret{bytes: [U8]{}}
    #Unsafe("the expert API explicitly authorizes authenticated legacy-v1 migration") {
        plain.bytes = core.crypto.expert.open_v1(key, data.bytes) ?? return Err(.OpenFailed)
    }
    canonical: jetc.canonical(recipients)
    parent: jetc_parent(destination.to_string())
    stage: jetc_stage(parent)
    jetc_cancel_checkpoint()
    jetc_write(stage.file, plain.bytes, "migrate-stage-write")
    jetc_sync(stage.file, "migrate-stage-fsync")
    metadata: jetc_stat(stage.file, .DestinationIO)
    jetc_seek(stage.file, .DestinationIO)
    hash := hashes.hash_start(.SHA256)
    hashes.hash_update(hash, plain.bytes)
    expected: hashes.hash_finish(hash)
    jetc_seal_stage(canonical, parent, stage, plain.bytes.len(), expected, metadata, true)
    Ok(true)
}

JetcParent: struct {
    directory: JetcFd, path: String, destination: String,
    name: String, metadata: __JetcStat, linux: Bool,
}
jetc_min: fn(left: Int, right: Int) -> Int Never! {
    if left < right -> left else -> right
}
jetc_fd: fn(raw: __JetcRaw, error: FileCryptoError) -> JetcFd FileCryptoError! {
    if raw.value < 0 -> return Err(error)
    Ok(JetcFd{fd: raw.value})
}
jetc_stat: fn(file: JetcFd, error: FileCryptoError) -> __JetcStat FileCryptoError! {
    result: core.crypto.__jetc_stat(file.fd)
    if result.status < 0 -> return Err(error)
    Ok(result)
}
jetc_walk_directory: fn(path: String) -> JetcFd FileCryptoError! {
    current := jetc_fd(core.crypto.__jetc_open_directory(if path.starts_with("/") -> "/" else -> "."), .DestinationIO)
    loop name in path.split("/") {
        if name == "" || name == "." -> next
        if name == ".." -> return Err(.DestinationIO)
        next: jetc_fd(core.crypto.__jetc_open_child_directory(current.fd, name), .DestinationIO)
        close(current)
        current = next.move()
    }
    Ok(current)
}
jetc_parent: fn(destination: String) -> JetcParent FileCryptoError! {
    loop byte in destination.bytes() {
        if byte == (U8{0}) -> return Err(.DestinationIO)
    }
    name: basename(destination)
    if name == "" || name == "." || name == ".." -> return Err(.DestinationIO)
    parent_text: dirname(destination)
    path: if parent_text == "" -> "." else -> parent_text
    opened: core.crypto.__jetc_open_directory(path)
    linux: opened.linux
    directory := jetc_fd(opened, .DestinationIO)
    if linux {
        checked: jetc_walk_directory(path)
        close(directory)
        directory = checked.move()
    }
    metadata: jetc_stat(directory, .DestinationIO)
    if !metadata.is_dir -> return Err(.DestinationIO)
    Ok(JetcParent{directory: directory.move(), path: path, destination: destination,
        name: name, metadata: metadata, linux: linux})
}
jetc_source: fn(path: String, error: FileCryptoError) -> JetcFd FileCryptoError! {
    file: jetc_fd(core.crypto.__jetc_open_source(path), error)
    if !jetc_stat(file, error).is_file -> return Err(error)
    Ok(file)
}
jetc_same_source: fn(left: __JetcStat, right: __JetcStat) -> Bool Never! {
    identity: if rt.os_family() == "unix" -> left.dev == right.dev && left.ino == right.ino else -> true
    identity && left.len == right.len && left.mtime == right.mtime && left.mtime_ns == right.mtime_ns
}
jetc_temp: fn(parent: JetcParent, prefix: String) -> JetcTemp FileCryptoError! {
    if parent.linux {
        file: jetc_fd(core.crypto.__jetc_tmpfile(parent.directory.fd), .DestinationIO)
        if jetc_stat(file, .DestinationIO).nlink != 0 -> return Err(.DestinationIO)
        return Ok(JetcTemp{file: file.move(), path: None})
    }
    pid: core.files.__atomic_pid()
    loop attempt in 0..<128 {
        sequence: parent.directory.fd * 128 + attempt
        name: ".{prefix}-{pid}-{sequence}"
        path: join(parent.path, name)
        result: core.crypto.__jetc_create_named(path)
        if result.value >= 0 -> return Ok(JetcTemp{file: JetcFd{fd: result.value}, path: Val(path)})
        if !jetc_exists_errno(result.errno) -> return Err(.DestinationIO)
    }
    Err(.DestinationIO)
}
jetc_stage: fn(parent: JetcParent) -> JetcTemp FileCryptoError! {
    stage := jetc_temp(parent, "jetc-stage")
    if stage.path == .Val(path) {
        core.files.__remove_raw(path) ?? return Err(.DestinationIO)
        stage.path = None
    }
    Ok(stage)
}
jetc_io_fault: fn(name: String, error: FileCryptoError) FileCryptoError! {
    if rt.fault_should_fail(name) -> return Err(error)
    Ok()
}
jetc_read: fn(file: JetcFd, count: Int, name: String, error: FileCryptoError) -> Secret FileCryptoError! {
    loop {
        if rt.fault_should_fail("{name}.interrupted") -> next
        jetc_io_fault(name, error)
        if rt.fault_should_fail("{name}.eof") -> return Ok(Secret{bytes: [U8]{}})
        requested: if rt.fault_should_fail("{name}.short") -> jetc_min(count, 17) else -> count
        result: core.crypto.__jetc_read(file.fd, requested)
        if result.value < 0 {
            if result.errno == 4 && rt.os_family() == "unix" -> next
            return Err(error)
        }
        return Ok(Secret{bytes: result.bytes.move()})
    }
}
jetc_read_exact: fn(file: JetcFd, count: Int, name: String, error: FileCryptoError) -> Secret FileCryptoError! {
    if count == 0 -> return Ok(Secret{bytes: [U8]{}})
    out := jetc_read(file, jetc_min(count, jetc.CHUNK), name, error)
    if out.bytes.len() == 0 -> return Err(error)
    loop out.bytes.len() < count {
        part: jetc_read(file, jetc_min(count - out.bytes.len(), jetc.CHUNK), name, error)
        if part.bytes.len() == 0 -> return Err(error)
        loop byte in part.bytes -> out.bytes.push(byte)
    }
    Ok(out)
}
jetc_write: fn(file: JetcFd, bytes: [U8], name: String) FileCryptoError! {
    jetc_write_span(file, bytes, 0, bytes.len(), name)
}
jetc_write_span: fn(file: JetcFd, bytes: [U8], start: Int, end: Int, name: String) FileCryptoError! {
    offset := start
    loop offset < end {
        if rt.fault_should_fail("{name}.interrupted") -> next
        jetc_io_fault(name, .DestinationIO)
        if rt.fault_should_fail("{name}.zero") -> return Err(.DestinationIO)
        count: if rt.fault_should_fail("{name}.short") -> jetc_min(end - offset, 17) else -> end - offset
        result: core.crypto.__jetc_write(file.fd, bytes, offset, count)
        if result.value < 0 {
            if result.errno == 4 && rt.os_family() == "unix" -> next
            return Err(.DestinationIO)
        }
        if result.value == 0 -> return Err(.DestinationIO)
        offset += result.value
    }
    Ok()
}
jetc_seek: fn(file: JetcFd, error: FileCryptoError) FileCryptoError! {
    if core.crypto.__jetc_seek(file.fd, 0).value < 0 -> return Err(error)
    Ok()
}
jetc_sync: fn(file: JetcFd, name: String) FileCryptoError! {
    jetc_io_fault(name, .DestinationIO)
    if core.crypto.__jetc_fsync(file.fd).value < 0 -> return Err(.DestinationIO)
    Ok()
}
jetc_digest: fn(file: JetcFd, expected_length: Int, name: String) -> [U8] FileCryptoError! {
    hash := hashes.hash_start(.SHA256)
    length := 0
    loop {
        jetc_cancel_checkpoint()
        part: jetc_read(file, jetc.CHUNK, name, .SourceIO)
        if part.bytes.len() == 0 -> break
        length += part.bytes.len()
        if length > expected_length || length > jetc.MAX_PLAIN -> return Err(.SourceIO)
        hashes.hash_update(hash, part.bytes)
    }
    if length != expected_length -> return Err(.SourceIO)
    Ok(hashes.hash_finish(hash))
}
jetc_revalidate: fn(parent: JetcParent) FileCryptoError! {
    current: if parent.linux -> jetc_walk_directory(parent.path) else -> jetc_fd(core.crypto.__jetc_open_directory(parent.path), .DestinationIO)
    before: if parent.linux -> jetc_stat(parent.directory, .DestinationIO) else -> parent.metadata
    after: jetc_stat(current, .DestinationIO)
    if before.dev != after.dev || before.ino != after.ino -> return Err(.DestinationIO)
    Ok()
}
// Publishes through the caller's temporary, which stays its one owner: a
// rebound `JetcTemp.move()` parameter became a second owner that closed the same
// descriptor (and removed the same path) again at scope end.
jetc_publish: fn(output: &JetcTemp, parent: JetcParent, operation: String) FileCryptoError! {
    jetc_cancel_checkpoint()
    if parent.linux {
        jetc_sync(output.file, "{operation}-output-fsync")
        jetc_revalidate(parent)
        result: core.crypto.__jetc_link(output.file.fd, parent.directory.fd, parent.name)
        if result.value < 0 {
            if jetc_exists_errno(result.errno) -> return Err(.DestinationExists)
            return Err(.DestinationIO)
        }
        jetc_sync(parent.directory, "{operation}-directory-fsync")
    } else {
        if core.crypto.__jetc_fsync(output.file.fd).value < 0 -> return Err(.DestinationIO)
        _: core.crypto.__jetc_close(output.file.fd)
        output.file.fd = -1
        jetc_revalidate(parent)
        path: output.path ?? return Err(.DestinationIO)
        if core.files.__hard_link_raw(path, parent.destination) == {
            .Err(error) -> {
                if error == .AlreadyExists(_) -> return Err(.DestinationExists)
                return Err(.DestinationIO)
            }
            .Ok(_) -> {}
        }
        core.files.__remove_raw(path) ?? return Err(.DestinationIO)
        directory: jetc_fd(core.crypto.__jetc_open_directory(parent.path), .DestinationIO)
        if core.crypto.__jetc_fsync(directory.fd).value < 0 -> return Err(.DestinationIO)
        output.path = None
    }
    Ok()
}
jetc_seal_stage: fn(recipients: [jetc.Recipient], parent: JetcParent, stage: JetcTemp,
    length: Int, expected: [U8], metadata: __JetcStat, verify: Bool) FileCryptoError! -[FS, Rand]> {
    // Ratified snapshot/cancellation ordering: no RNG1 on observed cancel.
    jetc_cancel_checkpoint()
    file_id: jetc_random(16)
    file_key: jetc_random(32)
    ephemeral: jetc_random(32)
    nonce_prefix: jetc_random(16)
    writer := jetc.writer(recipients, length, file_id.bytes, file_key, ephemeral, nonce_prefix.bytes)
    jetc_cancel_checkpoint()
    output := jetc_temp(parent, "jetc-output")
    operation: if verify -> "migrate" else -> "seal"
    jetc_write_span(output.file, writer.prefix, 0, 20, "{operation}-output-write")
    jetc_write_span(output.file, writer.prefix, 20, writer.prefix.len(), "{operation}-output-write")
    jetc_seek(stage.file, .SourceIO)
    hash := hashes.hash_start(.SHA256)
    loop !writer.final {
        jetc_cancel_checkpoint()
        count: jetc_min(writer.remaining, jetc.CHUNK)
        plain: jetc_read_exact(stage.file, count, "{operation}-stage-read", .SourceIO)
        hashes.hash_update(hash, plain.bytes)
        if count < jetc.CHUNK {
            trailing: jetc_read(stage.file, 1, "{operation}-stage-read", .SourceIO)
            if trailing.bytes.len() != 0 || !jetc_same_source(metadata, jetc_stat(stage.file, .SourceIO)) -> return Err(.SourceIO)
            if !constant_time_equal_bytes(hashes.hash_finish(hash), expected) -> return Err(.SourceIO)
        }
        record: jetc.seal_chunk(writer, plain.bytes)
        jetc_write_span(output.file, record.framing, 0, 4, "{operation}-output-write")
        jetc_write_span(output.file, record.framing, 4, 5, "{operation}-output-write")
        jetc_write(output.file, record.cipher, "{operation}-output-write")
    }
    if verify {
        jetc_sync(output.file, "migrate-verify-fsync")
        jetc_io_fault("migrate-reopen-verify", .DestinationIO)
        if jetc_verify_output(output.file, writer, length) == {
            .Ok(_) -> {}
            .Err(error) -> {
                if error == .SourceIO -> return Err(.SourceIO)
                return Err(.DestinationIO)
            }
        }
    }
    jetc_publish(output, parent, operation)
    Ok()
}

jetc_random: fn(length: Int) -[Rand]> Secret FileCryptoError! {
    if random.bytes(length) == {
        .Ok(bytes) -> Ok(Secret{bytes: bytes})
        .Err(_) -> Err(.SealFailed)
    }
}
jetc_exists_errno: fn(errno: Int) -> Bool Never! {
    errno == 17 || (core.files.__path_windows() && (errno == 80 || errno == 183))
}

jetc_cancel_checkpoint: fn() FileCryptoError! {
    if core.tasks.__task_cancelled() ?? false -> return Err(.SourceIO)
    Ok()
}
jetc_verify_output: fn(input: JetcFd, writer: jetc.Writer, length: Int) FileCryptoError! {
    jetc_seek(input, .OpenFailed)
    metadata: jetc_stat(input, .OpenFailed)
    if metadata.len != writer.prefix.len() + (jetc.body_length(length) ?? return Err(.OpenFailed)) -> return Err(.OpenFailed)
    prefix: jetc_read_exact(input, writer.prefix.len(), "migrate-verify-read", .OpenFailed)
    // Exact equality also verifies every original recipient stanza, ephemeral
    // key and header tag, without retaining writer ephemeral private material.
    if !constant_time_equal_bytes(prefix.bytes, writer.prefix) -> return Err(.OpenFailed)
    reader := jetc.ChunkReader{header_hash: writer.header_hash, key: Secret{bytes: writer.key.bytes.copy()},
        nonce_prefix: writer.nonce_prefix, remaining: metadata.len - writer.prefix.len(), index: 1, final: false}
    loop reader.remaining > 0 {
        jetc_cancel_checkpoint()
        framing: jetc_read_exact(input, 5, "migrate-verify-read", .OpenFailed)
        size: jetc.integer(framing.bytes, 0, 4)
        if !jetc.record_shape(size, framing.bytes[4]) -> return Err(.OpenFailed)
        encrypted: jetc_read_exact(input, size + jetc.TAG, "migrate-verify-read", .OpenFailed)
        _clear: jetc.open_chunk(reader, framing.bytes, encrypted.bytes)
    }
    trailing: jetc_read(input, 1, "migrate-verify-read", .OpenFailed)
    jetc.finish(reader, trailing.bytes)
    jetc_cancel_checkpoint()
    Ok()
}


sign: fn(signing_key: SigningKey, bytes: [U8]) -> Signature CryptoError! {
    if signing_key.bytes.len() != 32 -> return Err(CryptoError.KeyRejected)
    Ok(Signature{bytes: ed25519_sign_raw(signing_key.bytes, bytes)})
}

verify: fn(verify_key: VerifyKey, bytes: [U8], signature: Signature) -> Bool CryptoError! {
    if verify_key.bytes.len() != 32 || signature.bytes.len() != 64 {
        return Err(CryptoError.KeyRejected)
    }
    Ok(ed25519_verify_raw(verify_key.bytes, bytes, signature.bytes))
}

x25519: fn(secret_key: X25519SecretKey, public_key: X25519PublicKey) -> SharedSecret CryptoError! {
    if secret_key.bytes.len() != 32 || public_key.bytes.len() != 32 {
        return Err(CryptoError.KeyRejected)
    }
    shared: x25519_scalarmult(secret_key.bytes, public_key.bytes)
    if all_zero(shared) -> return Err(CryptoError.KeyRejected)
    Ok(SharedSecret{bytes: shared})
}

x25519_public: fn(secret_key: X25519SecretKey) -> X25519PublicKey CryptoError! {
    if secret_key.bytes.len() != 32 -> return Err(CryptoError.KeyRejected)
    Ok(X25519PublicKey{bytes: x25519_scalarmult(secret_key.bytes, x25519_base_point())})
}

/// The RFC 7748 X25519 base point, u = 9.
x25519_base_point: fn() -> [U8] Never! {
    base := [U8]{}
    loop _ in 0..<32 -> base.push(U8{0})
    base[0] = (U8{9})
    base
}

/// Bech32m generator polymod (BIP 350).
bech32_polymod: fn(values: [Int]) -> Int Never! {
    generators: [Int]{0x3b6a57b2, 0x26508e6d, 0x1ea119fa, 0x3d4233dd, 0x2a1462b3}
    chk := 1
    loop v in values {
        top: chk >> 25
        chk = ((((chk).bit_and(0x1ffffff)) << 5)).bit_xor(v)
        loop i in 0..<5 {
            if (((top >> i)).bit_and(1)) == 1 -> chk = (chk).bit_xor(generators[i])
        }
    }
    chk
}

bech32_hrp_expand: fn(hrp: String) -> [Int] Never! {
    raw: hrp.bytes()
    out := [Int]{}
    loop b in raw -> out.push(Int.from_u8(b) >> 5)
    out.push(0)
    loop b in raw -> out.push((Int.from_u8(b)).bit_and(31))
    out
}

bech32_charset: fn() -> [U8] Never! { "qpzry9x8gf2tvdw0s3jn54khce6mua7l".bytes() }

bech32_value: fn(b: U8) -> Int? {
    i := 0
    loop c in bech32_charset() {
        if c == b -> return Val(i)
        i += 1
    }
    None
}

C_BECH32M_CONST: 0x2bc830a3

x25519_recipient_encode: fn(key: [U8]) -> String Never! {
    data := [Int]{}
    acc := 0
    bits := 0
    loop b in key {
        acc = ((((acc << 8)).bit_or(Int.from_u8(b)))).bit_and(4095)
        bits += 8
        loop bits >= 5 {
            bits -= 5
            data.push(((acc >> bits)).bit_and(31))
        }
    }
    if bits > 0 -> data.push(((acc << (5 - bits))).bit_and(31))
    input := bech32_hrp_expand("jetx25519")
    loop v in data -> input.push(v)
    loop _ in 0..<6 -> input.push(0)
    polymod: (bech32_polymod(input)).bit_xor(C_BECH32M_CONST)
    charset: bech32_charset()
    out := [U8]{}
    loop b in "jetx255191".bytes() -> out.push(b)
    loop v in data -> out.push(charset[v])
    loop i in 0..<6 -> out.push(charset[((polymod >> (5 * (5 - i)))).bit_and(31)])
    String.from_bytes(out) ?? panic("invalid UTF-8 in Bech32m recipient")
}

/// Exact-size decode: HRP (9) + separator + 52 data symbols + 6 checksum
/// symbols. Nonzero padding bits are rejected so each key has one spelling.
x25519_recipient_decode: fn(text: String) -> [U8]? {
    raw: text.bytes()
    if raw.len() != 68 -> return None
    prefix: "jetx255191".bytes()
    loop i in 0..<10 {
        if raw[i] != prefix[i] -> return None
    }
    values := [Int]{}
    loop i in 10..<68 {
        v: bech32_value(raw[i]) ?? return None
        values.push(v)
    }
    check := bech32_hrp_expand("jetx25519")
    loop v in values -> check.push(v)
    if bech32_polymod(check) != C_BECH32M_CONST -> return None
    out := [U8]{}
    acc := 0
    bits := 0
    loop i in 0..<52 {
        acc = ((((acc << 5)).bit_or(values[i]))).bit_and(4095)
        bits += 5
        if bits >= 8 {
            bits -= 8
            out.push(wrapping(U8{acc >> bits}))
        }
    }
    if ((acc).bit_and(((1 << bits) - 1))) != 0 -> return None
    if out.len() != 32 -> return None
    Val(out)
}

all_zero: fn(bytes: [U8]) -> Bool Never! {
    diff := U8{0}
    loop b in bytes -> diff = diff.bit_or(b)
    diff == U8{0}
}

x25519_shared: fn(secret_key: X25519SecretKey, public_key: X25519PublicKey) -> SharedSecret CryptoError! {
    x25519(secret_key, public_key)
}

/// Generate a fresh X25519 private key for the beginner envelope helpers.
generatekey: fn() -[Rand]> X25519SecretKey CryptoError! {
    bytes: random.bytes(32) ?? return Err(CryptoError.Unavailable)
    Ok(X25519SecretKey{bytes: bytes})
}

privateencrypt: fn(key: X25519SecretKey, bytes: [U8]) -[Rand]> Sealed CryptoError! {
    public: x25519_public(key) ?? return Err(CryptoError.KeyRejected)
    seal([X25519PublicKey]{public}, bytes, [U8]{})
}

privatedecrypt: fn(key: X25519SecretKey, box: Sealed) -> [U8] CryptoError! {
    open_sealed(key, box, [U8]{})
}

publicencrypt: fn(key: X25519PublicKey, bytes: [U8]) -[Rand]> Sealed CryptoError! {
    seal([X25519PublicKey]{key}, bytes, [U8]{})
}

wrap: fn(key: Secret, recipient: X25519PublicKey) -[Rand]> WrappedKey CryptoError! {
    if recipient.bytes.len() != 32 || key.bytes.len() > 1048576 {
        return Err(CryptoError.KeyRejected)
    }
    eph_sk: random.bytes(32) ?? return Err(CryptoError.Unavailable)
    eph_pk: x25519_public(X25519SecretKey{bytes: copy_bytes(eph_sk)}) ?? return Err(CryptoError.KeyRejected)
    salt: random.bytes(16) ?? return Err(CryptoError.Unavailable)
    shared: x25519(X25519SecretKey{bytes: copy_bytes(eph_sk)}, recipient) ?? return Err(CryptoError.KeyRejected)
    key_info := [U8]{}
    loop b in "JETW1 key".bytes() -> key_info.push(b)
    loop b in eph_pk.bytes -> key_info.push(b)
    loop b in recipient.bytes -> key_info.push(b)
    kek: hkdf_sha256(shared.bytes, salt, key_info, 32) ?? return Err(CryptoError.Length)
    nonce_info := [U8]{}
    loop b in "JETW1 nonce".bytes() -> nonce_info.push(b)
    loop b in eph_pk.bytes -> nonce_info.push(b)
    loop b in recipient.bytes -> nonce_info.push(b)
    nonce: hkdf_sha256(shared.bytes, salt, nonce_info, 24) ?? return Err(CryptoError.Length)
    header := [U8]{}
    loop b in "JETW".bytes() -> header.push(b)
    header.push(U8{1})
    header.push(U8{1})
    header.push(U8{0})
    header.push(U8{0})
    loop b in recipient.bytes -> header.push(b)
    loop b in eph_pk.bytes -> header.push(b)
    loop b in salt -> header.push(b)
    _: append_be32(header, key.bytes.len()) ?? return Err(CryptoError.Length)
    // JETW1 AAD is the domain label followed by the 92-byte header; `unwrap`
    // authenticates the same bytes.
    wrap_aad := [U8]{}
    loop b in "JETW1 wrap".bytes() -> wrap_aad.push(b)
    loop b in header -> wrap_aad.push(b)
    body: xchacha_seal(kek.bytes, nonce.bytes, wrap_aad, key.bytes)
    out := [U8]{}
    loop b in header -> out.push(b)
    loop b in body -> out.push(b)
    Ok(WrappedKey{bytes: out})
}

unwrap: fn(recipient: X25519SecretKey, wrapped: WrappedKey) -> Secret CryptoError! {
    raw: wrapped.bytes
    if raw.len() < 108 || raw.len() > 1048684 -> return Err(CryptoError.KeyRejected)
    if slice_u8(raw, 0, 4) != "JETW".bytes() || raw[4] != (U8{1}) || raw[5] != (U8{1}) || raw[6] != (U8{0}) || raw[7] != (U8{0}) {
        return Err(CryptoError.OpenFailed)
    }
    key_len: read_be32(raw, 88)
    if key_len > 1048576 || raw.len() != 92 + key_len + 16 -> return Err(CryptoError.OpenFailed)
    own_public: x25519_public(recipient) ?? return Err(CryptoError.KeyRejected)
    expected_recipient: slice_u8(raw, 8, 40)
    if !constant_time_equal_bytes(own_public.bytes, expected_recipient) {
        return Err(CryptoError.OpenFailed)
    }
    eph: slice_u8(raw, 40, 72)
    salt: slice_u8(raw, 72, 88)
    shared: x25519(recipient, X25519PublicKey{bytes: copy_bytes(eph)}) ?? return Err(CryptoError.KeyRejected)
    key_info := [U8]{}
    loop b in "JETW1 key".bytes() -> key_info.push(b)
    loop b in eph -> key_info.push(b)
    loop b in expected_recipient -> key_info.push(b)
    kek: hkdf_sha256(shared.bytes, salt, key_info, 32) ?? return Err(CryptoError.Length)
    nonce_info := [U8]{}
    loop b in "JETW1 nonce".bytes() -> nonce_info.push(b)
    loop b in eph -> nonce_info.push(b)
    loop b in expected_recipient -> nonce_info.push(b)
    nonce: hkdf_sha256(shared.bytes, salt, nonce_info, 24) ?? return Err(CryptoError.Length)
    wrap_aad := [U8]{}
    loop b in "JETW1 wrap".bytes() -> wrap_aad.push(b)
    loop b in slice_u8(raw, 0, 92) -> wrap_aad.push(b)
    body: slice_u8(raw, 92, raw.len())
    plain: xchacha_open(kek.bytes, nonce.bytes, wrap_aad, body) ?? return Err(CryptoError.OpenFailed)
    if plain.len() != key_len -> return Err(CryptoError.OpenFailed)
    Ok(Secret{bytes: plain})
}

password_hash: fn(password: Secret) -[Rand]> PasswordHash CryptoError! {
    if password.bytes.len() > 1048576 -> return Err(CryptoError.Length)
    salt: random.bytes(16) ?? return Err(CryptoError.Unavailable)
    password_hash_with_salt(password, salt)
}

password_hash_with_salt: fn(password: Secret, salt: [U8]) -> PasswordHash CryptoError! {
    if password.bytes.len() > 1048576 || salt.len() < 8 || salt.len() > 64 {
        return Err(CryptoError.Length)
    }
    dk := Secret{bytes: [U8]{}}
    #Unsafe("crypto expert: Argon2id password hashing") {
        dk = rawcrypto.argon2id(password, salt.copy(), 65536, 3, 1, 32) ?? return Err(CryptoError.Unavailable)
    }
    text: "$argon2id$v=19$m=65536,t=3,p=1${phc_b64_encode(salt)}${phc_b64_encode(dk.bytes)}"
    Ok(PasswordHash{text: text})
}

password_verify: fn(password: Secret, stored: PasswordHash) -> Bool CryptoError! {
    if password.bytes.len() > 1048576 -> return Err(CryptoError.Length)
    parts: split_dollar(stored.text)
    if parts.len() != 6 || parts[1] != "argon2id" || parts[2] != "v=19" {
        return Err(CryptoError.KeyRejected)
    }
    params: split_comma(parts[3])
    if params.len() != 3 -> return Err(CryptoError.KeyRejected)
    memory: parse_prefixed_int(params[0], "m=") ?? return Err(CryptoError.KeyRejected)
    iterations: parse_prefixed_int(params[1], "t=") ?? return Err(CryptoError.KeyRejected)
    lanes: parse_prefixed_int(params[2], "p=") ?? return Err(CryptoError.KeyRejected)
    if memory < 8192 || memory > 262144 || iterations < 1 || iterations > 10 || lanes < 1 || lanes > 8 || memory < 8 * lanes || memory * iterations > 1048576 {
        return Err(CryptoError.Length)
    }
    salt: phc_b64_decode(parts[4]) ?? return Err(CryptoError.KeyRejected)
    want: phc_b64_decode(parts[5]) ?? return Err(CryptoError.KeyRejected)
    if salt.len() < 8 || salt.len() > 64 || want.len() < 16 || want.len() > 64 {
        return Err(CryptoError.Length)
    }
    got := Secret{bytes: [U8]{}}
    #Unsafe("crypto expert: Argon2id password verification") {
        got = rawcrypto.argon2id(password, salt, memory, iterations, lanes, want.len()) ?? return Err(CryptoError.Unavailable)
    }
    Ok(constant_time_equal_bytes(got.bytes, want))
}

parse_prefixed_int: fn(text: String, prefix: String) -> Int? {
    raw: text.bytes()
    wanted: prefix.bytes()
    if raw.len() <= wanted.len() -> return None
    i := 0
    loop b in wanted {
        if raw[i] != b -> return None
        i += 1
    }
    value: String.from_bytes(slice_u8(raw, wanted.len(), raw.len())) ?? return None
    parse_int(value)
}

split_comma: fn(text: String) -> [String] Never! {
    out := [String]{}
    current := [U8]{}
    loop b in text.bytes() {
        if b == (U8{44}) {
            out.push(String.from_bytes(current) ?? panic("invalid UTF-8 in PHC parameter"))
            current = [U8]{}
        } else { current.push(b) }
    }
    out.push(String.from_bytes(current) ?? panic("invalid UTF-8 in PHC parameter"))
    out
}

/// PHC string format B64: RFC 4648 standard alphabet, no `=` padding. Each
/// digit is computed from its six bits (`b64_digit`), with no table lookup or
/// branch on them: the bytes are a password hash's.
phc_b64_encode: fn(bytes: [U8]) -> String Never! {
    out := [U8]{}
    i := 0
    loop i + 3 <= bytes.len() {
        n: ((U32{bytes[i]} << 16).bit_or(U32{bytes[i + 1]} << 8)).bit_or(U32{bytes[i + 2]})
        out.push(__b64_digit(n >> 18))
        out.push(__b64_digit(n >> 12))
        out.push(__b64_digit(n >> 6))
        out.push(__b64_digit(n))
        i += 3
    }
    rest: bytes.len() - i
    if rest == 1 {
        n: U32{bytes[i]} << 16
        out.push(__b64_digit(n >> 18))
        out.push(__b64_digit(n >> 12))
    }
    if rest == 2 {
        n: (U32{bytes[i]} << 16).bit_or(U32{bytes[i + 1]} << 8)
        out.push(__b64_digit(n >> 18))
        out.push(__b64_digit(n >> 12))
        out.push(__b64_digit(n >> 6))
    }
    String.from_bytes_lossy(out)
}

/// The base64 digit of `n`'s low six bits `v`: `A`-`Z`, `a`-`z`, `0`-`9`,
/// `+`, `/`, computed as `A` plus the offsets of the ranges `v` is past, each
/// a mask from the borrow of a wrapping subtraction.
#Policy(arithmetic: .Wrapping)
__b64_digit: fn(n: U32) -> U8 Never! {
    v: n.bit_and(U32{63})
    c := v + U32{65}
    c += ((U32{25} - v) >> 8).bit_and(U32{6})
    c -= ((U32{51} - v) >> 8).bit_and(U32{75})
    c -= ((U32{61} - v) >> 8).bit_and(U32{15})
    c += ((U32{62} - v) >> 8).bit_and(U32{3})
    wrapping(U8{c})
}

/// Strict inverse of `phc_b64_encode`: rejects padding, a one-character
/// tail, and non-zero trailing bits.
phc_b64_decode: fn(text: String) -> [U8]? {
    raw: text.bytes()
    out := [U8]{}
    n := 0
    bits := 0
    loop b in raw {
        value: phc_b64_value(b) ?? return None
        n = ((n << 6)).bit_or(value)
        bits += 6
        if bits >= 8 {
            bits -= 8
            out.push(wrapping(U8{n >> bits}))
            n = (n).bit_and(((1 << bits) - 1))
        }
    }
    if bits >= 6 || n != 0 -> return None
    Val(out)
}

phc_b64_value: fn(b: U8) -> Int? {
    alphabet: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    i := 0
    loop c in alphabet.bytes() {
        if c == b -> return Val(i)
        i += 1
    }
    None
}

read_be32: fn(data: [U8], offset: Int) -> Int Never! {
    if offset < 0 || offset + 4 > data.len() -> return 0
    ((((Int.from_u8(data[offset]) << 24)).bit_or((Int.from_u8(data[offset + 1]) << 16))).bit_or((Int.from_u8(data[offset + 2]) << 8))).bit_or(Int.from_u8(data[offset + 3]))
}

// Byte-order loads behind ChaCha20, not part of the crypto surface.
priv byte_words: module {
    load_le32: fn(bytes: [U8], off: Int) -> U32 Never! {
        if off + 3 >= bytes.len() -> return U32{0}
        U32{bytes[off]}.bit_or(U32{bytes[off + 1]} << 8).bit_or(U32{bytes[off + 2]} << 16).bit_or(U32{bytes[off + 3]} << 24)
    }

    push_le32: fn(out: &[U8], value: U32) Never! {
        loop k in 0..<4 -> out.push(wrapping(U8{value >> (8 * k)}))
    }
}

copy_bytes: fn(bytes: [U8]) -> [U8] Never! {
    out := [U8]{}
    loop b in bytes -> out.push(b)
    out
}

/// The lowercase hex of `bytes`, each digit computed with no branch or table
/// lookup on it (`hex_digit`): the bytes may be a key's.
hex_encode: fn(bytes: [U8]) -> String Never! {
    out := [U8]{}
    loop b in bytes {
        n: U32{b}
        out.push(__hex_digit(n >> 4))
        out.push(__hex_digit(n.bit_and(U32{15})))
    }
    String.from_bytes_lossy(out)
}

/// The lowercase hex digit of `n` (0 to 15): `0` plus `n`, and the 39 from
/// `9` to `a` when `n` is past 9, a mask from the borrow of `9 - n`.
#Policy(arithmetic: .Wrapping)
__hex_digit: fn(n: U32) -> U8 Never! {
    wrapping(U8{n + U32{48} + ((U32{9} - n) >> 8).bit_and(U32{39})})
}

slice_u8: fn(bytes: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i >= bytes.len() -> return out
        out.push(bytes[i])
        i = i + 1
    }
}

split_dollar: fn(text: String) -> [String] Never! {
    out := [String]{}
    cur := [U8]{}
    loop b in text.bytes() {
        if b == (U8{36}) {
            out.push(String.from_bytes(cur) ?? panic("invalid UTF-8 in PHC field"))
            cur = [U8]{}
        } else { cur.push(b) }
    }
    out.push(String.from_bytes(cur) ?? panic("invalid UTF-8 in PHC field"))
    out
}

parse_int: fn(text: String) -> Int? {
    n := 0
    any := false
    loop b in text.bytes() {
        d: Int.from_u8(b)
        if d < 48 || d > 57 -> return None
        n = n * 10 + (d - 48)
        any = true
    }
    if !any -> return None
    Val(n)
}

hex_decode: fn(text: String) -> [U8]? {
    raw: text.bytes()
    if raw.len() % 2 != 0 -> return None
    out := [U8]{}
    i := 0
    loop {
        if i >= raw.len() -> return Val(out.copy())
        hi: hex_val(raw[i]) ?? return None
        lo: hex_val(raw[i + 1]) ?? return None
        out.push(wrapping(U8{hi * 16 + lo}))
        i = i + 2
    }
}

hex_val: fn(b: U8) -> Int? {
    n: Int.from_u8(b)
    if n >= 48 && n <= 57 -> return Val(n - 48)
    if n >= 97 && n <= 102 -> return Val(n - 87)
    if n >= 65 && n <= 70 -> return Val(n - 55)
    None
}

// The ChaCha20 block pieces behind chacha20_block. They are outside the
// exported core.crypto items, so they are private.
priv chacha20_core: module {
    /// RFC 8439 ChaCha20 state: constants, key, 32-bit block counter, nonce.
    chacha20_state: fn(key: [U8], nonce: [U8], counter: Int) -> [U32] Never! {
        [U32]{
            U32{0x61707865},
            U32{0x3320646e},
            U32{0x79622d32},
            U32{0x6b206574},
            load_le32(key, 0),
            load_le32(key, 4),
            load_le32(key, 8),
            load_le32(key, 12),
            load_le32(key, 16),
            load_le32(key, 20),
            load_le32(key, 24),
            load_le32(key, 28),
            wrapping(U32{counter}),
            load_le32(nonce, 0),
            load_le32(nonce, 4),
            load_le32(nonce, 8),
        }
    }

    /// The sixteen-word working buffer every block of one call reuses.
    chacha20_words: fn() -> [U32] Never! {
        w := [U32]{}
        loop _ in 0..<16 -> w.push(U32{0})
        w
    }

    /// The twenty ChaCha rounds of `state` into `w`, before the final addition.
    chacha20_rounds: fn(state: [U32], w: &[U32]) Never! {
        loop i in 0..<16 -> w[i] = state[i]
        loop _ in 0..<10 {
            qr(w, 0, 4, 8, 12)
            qr(w, 1, 5, 9, 13)
            qr(w, 2, 6, 10, 14)
            qr(w, 3, 7, 11, 15)
            qr(w, 0, 5, 10, 15)
            qr(w, 1, 6, 11, 12)
            qr(w, 2, 7, 8, 13)
            qr(w, 3, 4, 9, 14)
        }
    }
}

#Policy(arithmetic: .Wrapping)
chacha20_block: fn(key: [U8], nonce: [U8], counter: Int) -> [U8] Never! {
    state: chacha20_state(key, nonce, counter)
    w := chacha20_words()
    chacha20_rounds(state, w)
    out := [U8]{}
    loop i in 0..<16 -> push_le32(out, w[i] + state[i])
    out
}

#Policy(arithmetic: .Wrapping)
qr: fn(s: &[U32], ia: Int, ib: Int, ic: Int, id: Int) Never! {
    a := s[ia]
    b := s[ib]
    c := s[ic]
    d := s[id]
    a += b
    d = (d.bit_xor(a)).rotate_left(16)
    c += d
    b = (b.bit_xor(c)).rotate_left(12)
    a += b
    d = (d.bit_xor(a)).rotate_left(8)
    c += d
    b = (b.bit_xor(c)).rotate_left(7)
    s[ia] = a
    s[ib] = b
    s[ic] = c
    s[id] = d
}

#Policy(arithmetic: .Wrapping)
chacha20_xor: fn(key: [U8], nonce: [U8], counter: Int, plain: [U8]) -> [U8] Never! {
    state := chacha20_state(key, nonce, counter)
    w := chacha20_words()
    out := [U8]{}
    i := 0
    loop i < plain.len() {
        chacha20_rounds(state, w)
        loop k in 0..<16 {
            word: w[k] + state[k]
            loop shift in 0..<4 {
                if i >= plain.len() -> return out
                out.push(plain[i].bit_xor(wrapping(U8{word >> (8 * shift)})))
                i += 1
            }
        }
        state[12] = state[12] + U32{1}
    }
    out
}

poly1305: fn(key: [U8], data: [U8]) -> [U8] Never! {
    #Unsafe("crypto expert: the authenticated envelope owns the one-time Poly1305 key and MAC framing") {
        return fixedcrypto.poly1305(key, data)
    }
}

le_bytes: fn(n: Int, width: Int) -> [U8] Never! {
    out := [U8]{}
    v := n
    loop i in 0..<width {
        out.push(wrapping(U8{v}))
        v = v >> 8
    }
    out
}

pad16: fn(n: Int) -> [U8] Never! {
    out := [U8]{}
    rem: (16 - (n % 16)) % 16
    loop i in 0..<rem -> out.push(U8{0})
    out
}

chacha_poly_seal: fn(key: [U8], nonce: [U8], aad: [U8], plain: [U8]) -> [U8] Never! {
    otk: chacha20_block(key, nonce, 0)
    ct: chacha20_xor(key, nonce, 1, plain)
    mac_data := [U8]{}
    loop b in aad -> mac_data.push(b)
    loop b in pad16(aad.len()) -> mac_data.push(b)
    loop b in ct -> mac_data.push(b)
    loop b in pad16(ct.len()) -> mac_data.push(b)
    loop b in le_bytes(aad.len(), 8) -> mac_data.push(b)
    loop b in le_bytes(ct.len(), 8) -> mac_data.push(b)
    auth_tag: poly1305(otk, mac_data)
    out := [U8]{}
    loop b in ct -> out.push(b)
    loop b in auth_tag -> out.push(b)
    out
}

chacha_poly_open: fn(key: [U8], nonce: [U8], aad: [U8], cipher: [U8]) -> [U8]? {
    if cipher.len() < 16 -> return None
    ct: slice_u8(cipher, 0, cipher.len() - 16)
    auth_tag: slice_u8(cipher, cipher.len() - 16, cipher.len())
    otk: chacha20_block(key, nonce, 0)
    mac_data := [U8]{}
    loop b in aad -> mac_data.push(b)
    loop b in pad16(aad.len()) -> mac_data.push(b)
    loop b in ct -> mac_data.push(b)
    loop b in pad16(ct.len()) -> mac_data.push(b)
    loop b in le_bytes(aad.len(), 8) -> mac_data.push(b)
    loop b in le_bytes(ct.len(), 8) -> mac_data.push(b)
    expect: poly1305(otk, mac_data)
    if !constant_time_equal_bytes(auth_tag, expect) -> return None
    Val(chacha20_xor(key, nonce, 1, ct))
}

hchacha20: fn(key: [U8], nonce16: [U8]) -> [U8] Never! {
    state: [U32]{
        U32{0x61707865},
        U32{0x3320646e},
        U32{0x79622d32},
        U32{0x6b206574},
        load_le32(key, 0),
        load_le32(key, 4),
        load_le32(key, 8),
        load_le32(key, 12),
        load_le32(key, 16),
        load_le32(key, 20),
        load_le32(key, 24),
        load_le32(key, 28),
        load_le32(nonce16, 0),
        load_le32(nonce16, 4),
        load_le32(nonce16, 8),
        load_le32(nonce16, 12),
    }
    w := chacha20_words()
    chacha20_rounds(state, w)
    out := [U8]{}
    loop k in 0..<4 -> push_le32(out, w[k])
    loop k in 12..<16 -> push_le32(out, w[k])
    out
}

xchacha_seal: fn(key: [U8], nonce24: [U8], aad: [U8], plain: [U8]) -> [U8] Never! {
    sub: hchacha20(key, slice_u8(nonce24, 0, 16))
    n := [U8]{0, 0, 0, 0}
    loop b in slice_u8(nonce24, 16, 24) -> n.push(b)
    chacha_poly_seal(sub, n, aad, plain)
}

xchacha_open: fn(key: [U8], nonce24: [U8], aad: [U8], cipher: [U8]) -> [U8]? {
    sub: hchacha20(key, slice_u8(nonce24, 0, 16))
    n := [U8]{0, 0, 0, 0}
    loop b in slice_u8(nonce24, 16, 24) -> n.push(b)
    chacha_poly_open(sub, n, aad, cipher)
}

x25519_scalarmult: fn(sk: [U8], u: [U8]) -> [U8] Never! {
    #Unsafe("crypto expert: typed key agreement validates key widths and rejects all-zero shared secrets") {
        return fixedcrypto.x25519(sk, u)
    }
}

/// RFC 8032 5.1.5: the encoded public key A = [s]B for a 32-byte seed.
ed25519_public_raw: fn(seed: [U8]) -> [U8] Never! { fixedcrypto.ed_public(seed) }

ed25519_sign_raw: fn(seed: [U8], msg: [U8]) -> [U8] Never! {
    #Unsafe("crypto expert: typed signing keys validate the Ed25519 seed width") {
        return fixedcrypto.ed_sign(seed, msg)
    }
}

ed25519_verify_raw: fn(pk: [U8], msg: [U8], sig: [U8]) -> Bool Never! {
    #Unsafe("crypto expert: typed verification validates public key and signature widths before strict verification") {
        return fixedcrypto.ed_verify(pk, msg, sig)
    }
}

// Existing public coordinate carrier. Secret arithmetic uses private fixed limbs.
EdPoint: struct {
    x: Int
    y: Int
}


C_BLAKE3_IV: [U32]{U32{0x6A09E667}, U32{0xBB67AE85}, U32{0x3C6EF372}, U32{0xA54FF53A}, U32{0x510E527F}, U32{0x9B05688C}, U32{0x1F83D9AB}, U32{0x5BE0CD19}}

