    4,
    7,
    11,
    15,
    5,
    0,
    1,
    9,
    8,
    6,
    14,
    10,
    2,
    12,
    3,
    4,
    7,
    13,
}

// BLAKE3 works on 32-bit words (U32, wrapping where the specification's sums
// are modulo 2^32), so a word of the input is never an Int's: no overflow
// check or wider form branches on it.
blake3_raw: fn(input: [U8]) -> [U8] {
    if input.len() <= 1024 -> return blake3_root_chunk(input)
    // tree: 1024-byte chunks
    chunks := [U32]{}  // flattened chaining values 8 words each
    i := 0
    idx := 0
    loop {
        if i >= input.len() -> break
        end := i + 1024
        if end > input.len() -> end = input.len()
        cv: __blake3_chunk(slice_u8(input, i, end), idx, i + 1024 >= input.len() && (idx == 0 || end - i < 1024) && idx == 0)
        loop w in cv -> chunks.push(w)
        i = end
        idx = idx + 1
    }
    // parent merge until one cv; last is root
    n: chunks.len() /% 8
    cvs := chunks
    count := n
    loop {
        if count == 1 {
            out := [U8]{}
            loop k in 0..<8 -> push_le32(out, cvs[k])
            return out
        }
        next := [U32]{}
        p := 0
        loop {
            if p + 16 <= cvs.len() {
                left := [U32]{}
                right := [U32]{}
                loop k in 0..<8 -> left.push(cvs[p + k])
                loop k in 0..<8 -> right.push(cvs[p + 8 + k])
                is_root := p + 16 >= cvs.len() && next.len() == 0 && (cvs.len() - p) == 16
                cv: __blake3_parent(left, right, is_root)
                loop w in cv -> next.push(w)
                p = p + 16
            } else {
                loop k in p..<cvs.len() -> next.push(cvs[k])
                break
            }
        }
        cvs = next
        count = cvs.len() /% 8
    }
}

__blake3_chunk: fn(data: [U8], chunk_index: Int, is_root: Bool) -> [U32] {
    cv := C_BLAKE3_IV
    blocks := (data.len() + 63) /% 64
    if blocks == 0 -> blocks = 1
    loop i in 0..<blocks {
        start: i * 64
        end := start + 64
        if end > data.len() -> end = data.len()
        block := [U8]{}
        loop b in slice_u8(data, start, end) -> block.push(b)
        loop {
            if block.len() >= 64 -> break
            block.push(U8{0})
        }
        flags := 0
        if i == 0 -> flags = (flags).bit_or(1)
        if i == blocks - 1 -> flags = (flags).bit_or(2)
        if is_root && i == blocks - 1 -> flags = (flags).bit_or(8)
        cv = __blake3_compress(cv, block, chunk_index, end - start, flags)
    }
    cv
}

blake3_root_chunk: fn(data: [U8]) -> [U8] {
    cv: __blake3_chunk(data, 0, true)
    out := [U8]{}
    loop k in 0..<8 -> push_le32(out, cv[k])
    out
}

__blake3_parent: fn(left: [U32], right: [U32], is_root: Bool) -> [U32] {
    block := [U8]{}
    loop w in left -> push_le32(block, w)
    loop w in right -> push_le32(block, w)
    flags := 4
    if is_root -> flags = (flags).bit_or(8)
    __blake3_compress(C_BLAKE3_IV, block, 0, 64, flags)
}

#Policy(arithmetic: .Wrapping)
__blake3_compress: fn(cv: [U32], block: [U8], counter: Int, block_len: Int, flags: Int) -> [U32] {
    m := [U32]{}
    loop i in 0..<16 -> m.push(load_le32(block, i * 4))
    s := [U32]{
        cv[0],
        cv[1],
        cv[2],
        cv[3],
        cv[4],
        cv[5],
        cv[6],
        cv[7],
        C_BLAKE3_IV[0],
        C_BLAKE3_IV[1],
        C_BLAKE3_IV[2],
        C_BLAKE3_IV[3],
        wrapping(U32{counter}),
        wrapping(U32{counter >> 32}),
        wrapping(U32{block_len}),
        wrapping(U32{flags}),
    }
    loop r in 0..<7 {
        base: r * 16
        __blake3_g(s, 0, 4, 8, 12, m[C_BLAKE3_MSG[base + 0]], m[C_BLAKE3_MSG[base + 1]])
        __blake3_g(s, 1, 5, 9, 13, m[C_BLAKE3_MSG[base + 2]], m[C_BLAKE3_MSG[base + 3]])
        __blake3_g(s, 2, 6, 10, 14, m[C_BLAKE3_MSG[base + 4]], m[C_BLAKE3_MSG[base + 5]])
        __blake3_g(s, 3, 7, 11, 15, m[C_BLAKE3_MSG[base + 6]], m[C_BLAKE3_MSG[base + 7]])
        __blake3_g(s, 0, 5, 10, 15, m[C_BLAKE3_MSG[base + 8]], m[C_BLAKE3_MSG[base + 9]])
        __blake3_g(s, 1, 6, 11, 12, m[C_BLAKE3_MSG[base + 10]], m[C_BLAKE3_MSG[base + 11]])
        __blake3_g(s, 2, 7, 8, 13, m[C_BLAKE3_MSG[base + 12]], m[C_BLAKE3_MSG[base + 13]])
        __blake3_g(s, 3, 4, 9, 14, m[C_BLAKE3_MSG[base + 14]], m[C_BLAKE3_MSG[base + 15]])
    }
    out := [U32]{}
    loop i in 0..<8 -> out.push(s[i].bit_xor(s[i + 8]))
    out
}

/// BLAKE3 quarter-round G: right rotations by 16, 12, 8 and 7.
#Policy(arithmetic: .Wrapping)
__blake3_g: fn(s: &[U32], a: Int, b: Int, c: Int, d: Int, mx: U32, my: U32) {
    s[a] = s[a] + s[b] + mx
    s[d] = (s[d].bit_xor(s[a])).rotate_right(16)
    s[c] = s[c] + s[d]
    s[b] = (s[b].bit_xor(s[c])).rotate_right(12)
    s[a] = s[a] + s[b] + my
    s[d] = (s[d].bit_xor(s[a])).rotate_right(8)
    s[c] = s[c] + s[d]
    s[b] = (s[b].bit_xor(s[c])).rotate_right(7)
}

#Test("BLAKE3 matches the reference vectors (input bytes i mod 251) across one block, one chunk and a chunk tree") {
    lengths: [Int]{0, 1, 1023, 1024, 1025, 2049, 3073, 5121, 8193}
    want: [String]{
        "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262",
        "2d3adedff11b61f14c886e35afa036736dcd87a74d27b5c1510225d0f592e213",
        "10108970eeda3eb932baac1428c7a2163b0e924c9a9e25b35bba72b28f70bd11",
        "42214739f095a406f3fc83deb889744ac00df831c10daa55189b5d121c855af7",
        "d00278ae47eb27b34faecf67b4fe263f82d5412916c1ffd97c8cb7fb814b8444",
        "5f4d72f40d7a5f82b15ca2b2e44b1de3c2ef86c426c95c1af0b6879522563030",
        "7124b49501012f81cc7f11ca069ec9226cecb8a2c850cfe644e327d22d3e1cd3",
        "628bd2cb2004694adaab7bbd778a25df25c47b9d4155a55f8fbd79f2fe154cff",
        "bab6c09cb8ce8cf459261398d2e7aef35700bf488116ceb94a36d0f5f1b7bc3b",
    }
    loop k in 0..<lengths.len() {
        data := [U8]{}
        loop i in 0..<lengths[k] -> data.push(U8{i %% 251})
        assert_eq(blake3(data).hex(), want[k])
    }
}

#Test("Hex and PHC base64 digits match their alphabets at every value") {
    bytes := [U8]{}
    loop i in 0..<256 -> bytes.push(U8{i})
    hex: hex_encode(bytes).bytes()
    digits: "0123456789abcdef".bytes()
    loop i in 0..<256 {
        assert_eq(hex[2 * i], digits[i /% 16])
        assert_eq(hex[2 * i + 1], digits[i %% 16])
    }
    alphabet: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".bytes()
    loop v in 0..<64 -> assert_eq(__b64_digit(wrapping(U32{v})), alphabet[v])
    assert_eq(phc_b64_encode("abcd".bytes()), "YWJjZA")
    assert_eq(phc_b64_decode(phc_b64_encode(bytes)) ?? panic("decode"), bytes)
}

#Test("JETC2 streaming hash matches the one-shot digest across partial blocks") {
    data := [U8]{}
    loop i in 0..<257 -> data.push(U8{i %% 251})
    hash := hashes.hash_start(.SHA256)
    offset := 0
    loop offset < data.len() {
        end: jetc_min(offset + 17, data.len())
        hashes.hash_update_range(hash, data, offset, end - offset)
        offset = end
    }
    assert(hashes.hash_finish(hash) == sha256(data).bytes)
    assert(hash.used == 0)
}

#Test("JETC2 streaming hash finalizes one- and two-block padding in place") {
    lengths: [Int]{0, 55, 56, 63, 64, 65, 127}
    loop length in lengths {
        data := [U8]{}
        loop index in 0..<length -> data.push(U8{index %% 251})
        hash := hashes.hash_start(.SHA256)
        hashes.hash_update(hash, data)
        assert(hashes.hash_finish(hash) == sha256(data).bytes)
        assert(hash.used == 0)
    }
}

#Test("SHA-256 host block compression agrees with the Jet rounds at every length and offset") {
    lengths := [Int]{}
    loop length in 0..<200 -> lengths.push(length)
    lengths.push(4109)
    offsets: [Int]{0, 1, 3, 8}
    loop length in lengths {
        data := [U8]{}
        loop index in 0..<length -> data.push(U8{(index * 167 + length * 31) %% 256})
        loop off in offsets {
            if off <= length {
                count: (length - off) /% 64
                iv: [U32]{0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19}
                fast := iv.copy()
                scalar := iv.copy()
                if !core.crypto.__sha256_blocks(fast, data, off, count) -> hashes.sha256_blocks(fast, data, off, count)
                hashes.sha256_blocks(scalar, data, off, count)
                assert(fast == scalar)
            }
        }
    }
}

#Test("Hasher fed in chunks of every size matches the one-shot SHA-256, and digest leaves it absorbing") {
    chunk_sizes: [Int]{1, 3, 55, 63, 64, 65, 127, 200}
    loop length in 0..<200 {
        data := [U8]{}
        loop index in 0..<length -> data.push(U8{(index * 89 + length) %% 256})
        want: sha256(data).hex()
        loop chunk in chunk_sizes {
            hasher := Hasher.new()
            offset := 0
            loop offset < length {
                end: if offset + chunk < length -> offset + chunk else -> length
                part := [U8]{}
                loop index in offset..<end -> part.push(data[index])
                hasher.update(part)
                offset = end
            }
            assert_eq(hasher.digest(), want)
        }
        // A digest in the middle neither ends nor changes the stream.
        split := Hasher.new()
        half: length /% 2
        head := [U8]{}
        tail := [U8]{}
        loop index in 0..<half -> head.push(data[index])
        loop index in half..<length -> tail.push(data[index])
        split.update(head)
        assert_eq(split.digest(), sha256(head).hex())
        split.update(tail)
        assert_eq(split.digest(), want)
    }
}

#Test("Hasher streams FIPS 180-2's one million 'a' bytes in 4000-byte updates") {
    block := [U8]{}
    loop _ in 0..<4000 -> block.push(U8{0x61})
    hasher := new()
    loop _ in 0..<250 -> update(hasher, block)
    assert_eq(digest(hasher), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")
}

#Test("JETC2 never overwrites destinations and removes unauthenticated outputs") {
    if rt.os_family() == "unix" && !core.files.__path_windows() {
        root: core.files.mktemp("jetc-source-contract")
        core.files.create_dir_all(root) ?? panic("create directory")
        source: Path.from(core.files.join(root, "source"))
        sealed: Path.from(core.files.join(root, "sealed"))
        opened: Path.from(core.files.join(root, "opened"))
        failed: Path.from(core.files.join(root, "failed"))
        source.write_atomic([U8]{0, 1, 2}) ?? panic("source")
        key_bytes := [U8]{}
        loop _ in 0..<32 -> key_bytes.push(U8{7})
        identity: X25519SecretKey{bytes: key_bytes}
        recipient: x25519_public(identity) ?? panic("identity")
        parent: jetc_parent(sealed.to_string()) ?? panic("parent")
        if parent.linux {
            file_seal([recipient], source, sealed) ?? panic("seal")
            before: core.files.read_bytes(sealed.to_string()) ?? panic("read sealed")
            assert(if file_seal([recipient], source, sealed) == {
                .Err(.DestinationExists) -> true
                .Ok(_) | .Err(_) -> false
            })
            assert((core.files.read_bytes(sealed.to_string()) ?? panic("read unchanged sealed")) == before)
            opened.write_atomic([U8]{9, 8, 7}) ?? panic("existing output")
            assert(if file_open(identity, sealed, opened) == {
                .Err(.DestinationExists) -> true
                .Ok(_) | .Err(_) -> false
            })
            assert((core.files.read_bytes(opened.to_string()) ?? panic("read existing output")) == ([U8]{9, 8, 7}))
            corrupt := before.copy()
            corrupt[corrupt.len() - 1] = corrupt[corrupt.len() - 1].bit_xor(U8{1})
            sealed.write_atomic(corrupt) ?? panic("tamper")
            assert(if file_open(identity, sealed, failed) == {
                .Err(.OpenFailed) -> true
                .Ok(_) | .Err(_) -> false
            })
            assert(!core.files.exists(failed.to_string()))
            assert((core.files.read_bytes(source.to_string()) ?? panic("read source")) == ([U8]{0, 1, 2}))
        }
        core.files.remove_all(root) ?? panic("cleanup")
    }
}
