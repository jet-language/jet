// SPDX-License-Identifier: Apache-2.0
// Translated from Mbed TLS 3.6.7 (library/aes.c, library/cmac.c, library/nist_kw.c, library/cipher.c); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: AES and its modes.
//
// - AES with 128-, 192- and 256-bit keys (FIPS 197).
// - The ECB, CBC, CFB128, CFB8, OFB and CTR modes (NIST SP 800-38A).
// - XTS-AES (IEEE 1619-2007, NIST SP 800-38E).
// - CMAC (NIST SP 800-38B, RFC 4493) and AES-CMAC-PRF-128 (RFC 4615).
// - Key wrap KW and KWP (NIST SP 800-38F; RFC 3394, RFC 5649).
// - The CBC paddings of the mbedtls cipher layer: PKCS #7 (RFC 5652
//   section 6.3), ISO/IEC 7816-4 one-and-zeros, ANSI X.923 zeros-and-length,
//   and zeros.
//
// The Jet AES is bitsliced, so no table index or branch depends on a key or
// data byte. It runs four blocks at a time in eight U64 bit planes, in the
// plane layout of Thomas Pornin's constant-time aes_ct64 (BearSSL). The
// S-box is the Boyar-Peralta circuit ("A depth-16 circuit for the AES S-box",
// 2011). On a host with AES-NI the same block operations run through
// core.crypto.__aes_blocks. Both compute FIPS 197, so every tier has one
// meaning; a host without the instructions runs these rounds.
use {
    core
    mem: core.mem
}

/// An expanded AES key.
/// - `sk`: the bitsliced round keys, eight words per round for the four
///   block slots.
/// - `rk`: the FIPS 197 round-key bytes, 16 per round.
/// - `dk`: the equivalent inverse cipher's round keys (FIPS 197 section
///   5.3.5), only for a key set up to decrypt, else empty.
/// The host leaf reads `rk` and `dk`; the Jet rounds read `sk`.
AESKey: struct {
    rounds: Int
    sk: [U64]
    rk: [U8]
    dk: [U8]

    impl Close {
        close: fn(&&self) {
            sk := self.sk.move()
            loop i in 0..<sk.len() -> sk[i] = U64{0}
            rk := self.rk.move()
            core.crypto.wipe(rk)
            dk := self.dk.move()
            core.crypto.wipe(dk)
        }
    }

    impl ForwardBlock {
        encrypt_one: fn(self, b: &[U8]) Never! { encrypt_in_place(self, b) }
        ctr32_blocks: fn(self, ctr: &[U8], src: [U8], off: Int, count: Int, out: &[U8]) Never! { blocks(self, CTR32, ctr, src, off, count, out) }
        cbc_blocks: fn(self, iv: &[U8], src: [U8], off: Int, count: Int, out: &[U8]) Never! { blocks(self, CBC_ENC, iv, src, off, count, out) }
    }
}

// The block operations of `blocks`. Every operation reads and writes whole
// 16-byte blocks; `iv` is the chaining value it carries from call to call.
// - ECB_ENC, ECB_DEC: no chaining.
// - CBC_ENC, CBC_DEC: iv is the previous ciphertext block.
// - CTR: iv is the counter block, incremented as one 128-bit big-endian
//   integer (SP 800-38A appendix B.1).
// - CTR32: increments only its last 32 bits (GCM's inc32, SP 800-38D
//   section 6.2).
// - CFB_ENC, CFB_DEC: CFB128; iv is the previous ciphertext block.
// - OFB: iv is the previous keystream block.
// - XTS_ENC, XTS_DEC: iv is the tweak, multiplied by x after every block
//   (IEEE 1619-2007 section 5.2).
ECB_ENC: 0
ECB_DEC: 1
CBC_ENC: 2
CBC_DEC: 3
CTR: 4
CTR32: 5
CFB_ENC: 6
CFB_DEC: 7
OFB: 8
XTS_ENC: 9
XTS_DEC: 10

// Exact-capacity buffers. Secret-bearing buffers are never grown
// geometrically, which could leave freed copies behind.
words: fn(count: Int) -> [U64] Never! {
    w := [U64]{}
    #Unsafe("Core cipher workspace reserves its complete operation-owned word capacity before filling") {
        if !mem.__list_reserve_exact<U64>(w, count) -> panic("cipher workspace allocation failed")
    }
    loop _ in 0..<count -> w.push(U64{0})
    w
}

zero_bytes: fn(count: Int) -> [U8] Never! {
    out := [U8]{}
    reserve(out, count)
    loop _ in 0..<count -> out.push(U8{0})
    out
}

/// Grow `out`'s capacity by exactly `count` bytes before they are appended.
reserve: fn(out: &[U8], count: Int) Never! {
    #Unsafe("Core cipher output reserves its exact public output width before filling") {
        if !mem.__list_reserve_exact<U8>(out, count) -> panic("cipher output allocation failed")
    }
}

/// `count` bytes of `src` from `off`, in a buffer of exactly that size.
bytes_of: fn(src: [U8], off: Int, count: Int) -> [U8] Never! {
    out := [U8]{}
    reserve(out, count)
    loop i in 0..<count -> out.push(src[off + i])
    out
}

wipe_words: fn(w: &[U64]) Never! { loop i in 0..<w.len() -> w[i] = U64{0} }

le32: fn(b: [U8], off: Int) -> U64 Never! {
    U64.from_u8(b[off]).bit_or(U64.from_u8(b[off + 1]) << 8).bit_or(U64.from_u8(b[off + 2]) << 16).bit_or(U64.from_u8(b[off + 3]) << 24)
}

// The low byte of `x` (wrapping): no test of the value.
low_byte: fn(x: U64) -> U8 Never! { wrapping(U8{x}) }

// ---------------------------------------------------------------------------
// Bitsliced AES. q[j] holds bit j of every byte of four blocks: bit
// 16 * row + 4 * column + slot.

swap_planes: fn(q: &[U64], a: Int, b: Int, low: U64, high: U64, shift: Int) Never! {
    x: q[a]
    y: q[b]
    q[a] = x.bit_and(low).bit_or(y.bit_and(low) << shift)
    q[b] = (x.bit_and(high) >> shift).bit_or(y.bit_and(high))
}

/// The bit-matrix transpose between byte-interleaved blocks and bit planes;
/// it is its own inverse.
ortho: fn(q: &[U64]) Never! {
    l1: U64{0x5555555555555555}
    h1: U64{0xaaaaaaaaaaaaaaaa}
    swap_planes(q, 0, 1, l1, h1, 1)
    swap_planes(q, 2, 3, l1, h1, 1)
    swap_planes(q, 4, 5, l1, h1, 1)
    swap_planes(q, 6, 7, l1, h1, 1)
    l2: U64{0x3333333333333333}
    h2: U64{0xcccccccccccccccc}
    swap_planes(q, 0, 2, l2, h2, 2)
    swap_planes(q, 1, 3, l2, h2, 2)
    swap_planes(q, 4, 6, l2, h2, 2)
    swap_planes(q, 5, 7, l2, h2, 2)
    l4: U64{0x0f0f0f0f0f0f0f0f}
    h4: U64{0xf0f0f0f0f0f0f0f0}
    swap_planes(q, 0, 4, l4, h4, 4)
    swap_planes(q, 1, 5, l4, h4, 4)
    swap_planes(q, 2, 6, l4, h4, 4)
    swap_planes(q, 3, 7, l4, h4, 4)
}

spread: fn(x: U64) -> U64 Never! {
    a: x.bit_or(x << 16).bit_and(U64{0x0000ffff0000ffff})
    a.bit_or(a << 8).bit_and(U64{0x00ff00ff00ff00ff})
}

gather: fn(x: U64) -> U64 Never! {
    a: x.bit_and(U64{0x00ff00ff00ff00ff})
    b: a.bit_or(a >> 8).bit_and(U64{0x0000ffff0000ffff})
    b.bit_or(b >> 16).bit_and(U64{0xffffffff})
}

/// Block `slot`'s four little-endian words into q[slot] and q[slot + 4].
interleave_in: fn(q: &[U64], slot: Int, b: [U8], off: Int) Never! {
    x0: spread(le32(b, off))
    x1: spread(le32(b, off + 4))
    x2: spread(le32(b, off + 8))
    x3: spread(le32(b, off + 12))
    q[slot] = x0.bit_or(x2 << 8)
    q[slot + 4] = x1.bit_or(x3 << 8)
}

put_word: fn(out: &[U8], at: Int, w: U64) Never! {
    out[at] = low_byte(w)
    out[at + 1] = low_byte(w >> 8)
    out[at + 2] = low_byte(w >> 16)
    out[at + 3] = low_byte(w >> 24)
}

/// Block `slot` of q into out[at..<at + 16].
interleave_out: fn(q: [U64], slot: Int, out: &[U8], at: Int) Never! {
    q0: q[slot]
    q1: q[slot + 4]
    put_word(out, at, gather(q0))
    put_word(out, at + 4, gather(q1))
    put_word(out, at + 8, gather(q0 >> 8))
    put_word(out, at + 12, gather(q1 >> 8))
}

/// The AES S-box on every byte of the planes: the Boyar-Peralta circuit's
/// top linear layer, 32 AND gates of GF(2^4) inversion, then its bottom
/// linear layer. x0 is a byte's most significant bit.
sbox: fn(q: &[U64]) Never! {
    x0: q[7]
    x1: q[6]
    x2: q[5]
    x3: q[4]
    x4: q[3]
    x5: q[2]
    x6: q[1]
    x7: q[0]
    y14: x3.bit_xor(x5)
    y13: x0.bit_xor(x6)
    y9: x0.bit_xor(x3)
    y8: x0.bit_xor(x5)
    t0: x1.bit_xor(x2)
    y1: t0.bit_xor(x7)
    y4: y1.bit_xor(x3)
    y12: y13.bit_xor(y14)
    y2: y1.bit_xor(x0)
    y5: y1.bit_xor(x6)
    y3: y5.bit_xor(y8)
    t1: x4.bit_xor(y12)
    y15: t1.bit_xor(x5)
    y20: t1.bit_xor(x1)
    y6: y15.bit_xor(x7)
    y10: y15.bit_xor(t0)
    y11: y20.bit_xor(y9)
    y7: x7.bit_xor(y11)
    y17: y10.bit_xor(y11)
    y19: y10.bit_xor(y8)
    y16: t0.bit_xor(y11)
    y21: y13.bit_xor(y16)
    y18: x0.bit_xor(y16)
    t2: y12.bit_and(y15)
    t3: y3.bit_and(y6)
    t4: t3.bit_xor(t2)
    t5: y4.bit_and(x7)
    t6: t5.bit_xor(t2)
    t7: y13.bit_and(y16)
    t8: y5.bit_and(y1)
    t9: t8.bit_xor(t7)
    t10: y2.bit_and(y7)
    t11: t10.bit_xor(t7)
    t12: y9.bit_and(y11)
    t13: y14.bit_and(y17)
    t14: t13.bit_xor(t12)
    t15: y8.bit_and(y10)
    t16: t15.bit_xor(t12)
    t17: t4.bit_xor(t14)
    t18: t6.bit_xor(t16)
    t19: t9.bit_xor(t14)
    t20: t11.bit_xor(t16)
    t21: t17.bit_xor(y20)
    t22: t18.bit_xor(y19)
    t23: t19.bit_xor(y21)
    t24: t20.bit_xor(y18)
    t25: t21.bit_xor(t22)
    t26: t21.bit_and(t23)
    t27: t24.bit_xor(t26)
    t28: t25.bit_and(t27)
    t29: t28.bit_xor(t22)
    t30: t23.bit_xor(t24)
    t31: t22.bit_xor(t26)
    t32: t31.bit_and(t30)
    t33: t32.bit_xor(t24)
    t34: t23.bit_xor(t33)
    t35: t27.bit_xor(t33)
    t36: t24.bit_and(t35)
    t37: t36.bit_xor(t34)
    t38: t27.bit_xor(t36)
    t39: t29.bit_and(t38)
    t40: t25.bit_xor(t39)
    t41: t40.bit_xor(t37)
    t42: t29.bit_xor(t33)
    t43: t29.bit_xor(t40)
    t44: t33.bit_xor(t37)
    t45: t42.bit_xor(t41)
    z0: t44.bit_and(y15)
    z1: t37.bit_and(y6)
    z2: t33.bit_and(x7)
    z3: t43.bit_and(y16)
    z4: t40.bit_and(y1)
    z5: t29.bit_and(y7)
    z6: t42.bit_and(y11)
    z7: t45.bit_and(y17)
    z8: t41.bit_and(y10)
    z9: t44.bit_and(y12)
    z10: t37.bit_and(y3)
    z11: t33.bit_and(y4)
    z12: t43.bit_and(y13)
    z13: t40.bit_and(y5)
    z14: t29.bit_and(y2)
    z15: t42.bit_and(y9)
    z16: t45.bit_and(y14)
    z17: t41.bit_and(y8)
    t46: z15.bit_xor(z16)
    t47: z10.bit_xor(z11)
    t48: z5.bit_xor(z13)
    t49: z9.bit_xor(z10)
    t50: z2.bit_xor(z12)
    t51: z2.bit_xor(z5)
    t52: z7.bit_xor(z8)
    t53: z0.bit_xor(z3)
    t54: z6.bit_xor(z7)
    t55: z16.bit_xor(z17)
    t56: z12.bit_xor(t48)
    t57: t50.bit_xor(t53)
    t58: z4.bit_xor(t46)
    t59: z3.bit_xor(t54)
    t60: t46.bit_xor(t57)
    t61: z14.bit_xor(t57)
    t62: t52.bit_xor(t58)
    t63: t49.bit_xor(t58)
    t64: z4.bit_xor(t59)
    t65: t61.bit_xor(t62)
    t66: z1.bit_xor(t63)
    s0: t59.bit_xor(t63)
    s6: t56.bit_xor(t62.bit_not())
    s7: t48.bit_xor(t60.bit_not())
    t67: t64.bit_xor(t65)
    s3: t53.bit_xor(t66)
    s4: t51.bit_xor(t66)
    s5: t47.bit_xor(t65)
    s1: t64.bit_xor(s3.bit_not())
    s2: t55.bit_xor(t67.bit_not())
    q[7] = s0
    q[6] = s1
    q[5] = s2
    q[4] = s3
    q[3] = s4
    q[2] = s5
    q[1] = s6
    q[0] = s7
}

/// The affine map T(y) = A^-1(y + 0x63) on the planes. It is an involution
/// with S^-1 = T . S . T, since S(x) = A(x^-1) + 0x63.
inv_affine: fn(q: &[U64]) Never! {
    q0: q[0].bit_not()
    q1: q[1].bit_not()
    q2: q[2]
    q3: q[3]
    q4: q[4]
    q5: q[5].bit_not()
    q6: q[6].bit_not()
    q7: q[7]
    q[7] = q1.bit_xor(q4).bit_xor(q6)
    q[6] = q0.bit_xor(q3).bit_xor(q5)
    q[5] = q7.bit_xor(q2).bit_xor(q4)
    q[4] = q6.bit_xor(q1).bit_xor(q3)
    q[3] = q5.bit_xor(q0).bit_xor(q2)
    q[2] = q4.bit_xor(q7).bit_xor(q1)
    q[1] = q3.bit_xor(q6).bit_xor(q0)
    q[0] = q2.bit_xor(q5).bit_xor(q7)
}

inv_sbox: fn(q: &[U64]) Never! {
    inv_affine(q)
    sbox(q)
    inv_affine(q)
}

/// ShiftRows: row r of every block rotates left by r columns.
shift_rows: fn(q: &[U64]) Never! {
    loop i in 0..<8 {
        x: q[i]
        q[i] = x.bit_and(U64{0x000000000000ffff}).bit_or(x.bit_and(U64{0x00000000fff00000}) >> 4).bit_or(x.bit_and(U64{0x00000000000f0000}) << 12).bit_or(x.bit_and(U64{0x0000ff0000000000}) >> 8).bit_or(x.bit_and(U64{0x000000ff00000000}) << 8).bit_or(x.bit_and(U64{0xf000000000000000}) >> 12).bit_or(x.bit_and(U64{0x0fff000000000000}) << 4)
    }
}

inv_shift_rows: fn(q: &[U64]) Never! {
    loop i in 0..<8 {
        x: q[i]
        q[i] = x.bit_and(U64{0x000000000000ffff}).bit_or(x.bit_and(U64{0x000000000fff0000}) << 4).bit_or(x.bit_and(U64{0x00000000f0000000}) >> 12).bit_or(x.bit_and(U64{0x000000ff00000000}) << 8).bit_or(x.bit_and(U64{0x0000ff0000000000}) >> 8).bit_or(x.bit_and(U64{0x000f000000000000}) << 12).bit_or(x.bit_and(U64{0xfff0000000000000}) >> 4)
    }
}

/// The next row of the same column.
row_next: fn(x: U64) -> U64 Never! { (x >> 16).bit_or(x << 48) }

/// The row two below in the same column.
row_opposite: fn(x: U64) -> U64 Never! { (x << 32).bit_or(x >> 32) }

/// MixColumns: a0' = 2(a0 + a1) + a1 + a2 + a3 for every column, where
/// doubling moves plane j to j + 1 and folds plane 7 into planes 0, 1, 3
/// and 4 (x^8 = x^4 + x^3 + x + 1).
mix_columns: fn(q: &[U64]) Never! {
    q0: q[0]
    q1: q[1]
    q2: q[2]
    q3: q[3]
    q4: q[4]
    q5: q[5]
    q6: q[6]
    q7: q[7]
    r0: row_next(q0)
    r1: row_next(q1)
    r2: row_next(q2)
    r3: row_next(q3)
    r4: row_next(q4)
    r5: row_next(q5)
    r6: row_next(q6)
    r7: row_next(q7)
    q[0] = q7.bit_xor(r7).bit_xor(r0).bit_xor(row_opposite(q0.bit_xor(r0)))
    q[1] = q0.bit_xor(r0).bit_xor(q7).bit_xor(r7).bit_xor(r1).bit_xor(row_opposite(q1.bit_xor(r1)))
    q[2] = q1.bit_xor(r1).bit_xor(r2).bit_xor(row_opposite(q2.bit_xor(r2)))
    q[3] = q2.bit_xor(r2).bit_xor(q7).bit_xor(r7).bit_xor(r3).bit_xor(row_opposite(q3.bit_xor(r3)))
    q[4] = q3.bit_xor(r3).bit_xor(q7).bit_xor(r7).bit_xor(r4).bit_xor(row_opposite(q4.bit_xor(r4)))
    q[5] = q4.bit_xor(r4).bit_xor(r5).bit_xor(row_opposite(q5.bit_xor(r5)))
    q[6] = q5.bit_xor(r5).bit_xor(r6).bit_xor(row_opposite(q6.bit_xor(r6)))
    q[7] = q6.bit_xor(r6).bit_xor(r7).bit_xor(row_opposite(q7.bit_xor(r7)))
}

/// InvMixColumns as MixColumns after the circulant (05, 00, 04, 00):
/// circ(0e, 0b, 0d, 09) = circ(02, 03, 01, 01) * circ(05, 00, 04, 00), so
/// a_r' = a_r + 4 (a_r + a_{r+2}) and then MixColumns.
inv_mix_columns: fn(q: &[U64]) Never! {
    w0: q[0].bit_xor(row_opposite(q[0]))
    w1: q[1].bit_xor(row_opposite(q[1]))
    w2: q[2].bit_xor(row_opposite(q[2]))
    w3: q[3].bit_xor(row_opposite(q[3]))
    w4: q[4].bit_xor(row_opposite(q[4]))
    w5: q[5].bit_xor(row_opposite(q[5]))
    w6: q[6].bit_xor(row_opposite(q[6]))
    w7: q[7].bit_xor(row_opposite(q[7]))
    // Planes of 4w: doubling twice.
    q[0] = q[0].bit_xor(w6)
    q[1] = q[1].bit_xor(w6).bit_xor(w7)
    q[2] = q[2].bit_xor(w0).bit_xor(w7)
    q[3] = q[3].bit_xor(w1).bit_xor(w6)
    q[4] = q[4].bit_xor(w2).bit_xor(w6).bit_xor(w7)
    q[5] = q[5].bit_xor(w3).bit_xor(w7)
    q[6] = q[6].bit_xor(w4)
    q[7] = q[7].bit_xor(w5)
    mix_columns(q)
}

add_round_key: fn(q: &[U64], sk: [U64], round: Int) Never! {
    base: round * 8
    loop i in 0..<8 -> q[i] = q[i].bit_xor(sk[base + i])
}

/// FIPS 197 section 5.1 Cipher on the four blocks in q.
encrypt_planes: fn(k: AESKey, q: &[U64]) Never! {
    add_round_key(q, k.sk, 0)
    loop round in 1..<k.rounds {
        sbox(q)
        shift_rows(q)
        mix_columns(q)
        add_round_key(q, k.sk, round)
    }
    sbox(q)
    shift_rows(q)
    add_round_key(q, k.sk, k.rounds)
}

/// FIPS 197 section 5.3 InvCipher on the four blocks in q.
decrypt_planes: fn(k: AESKey, q: &[U64]) Never! {
    add_round_key(q, k.sk, k.rounds)
    round := k.rounds - 1
    loop round > 0 {
        inv_shift_rows(q)
        inv_sbox(q)
        add_round_key(q, k.sk, round)
        inv_mix_columns(q)
        round -= 1
    }
    inv_shift_rows(q)
    inv_sbox(q)
    add_round_key(q, k.sk, 0)
}

/// `count` (1 to 4) blocks of `src` from `off` through the cipher into
/// out[at..], in place. Unused slots carry zeros.
crypt4: fn(k: AESKey, decrypt: Bool, q: &[U64], src: [U8], off: Int, count: Int, out: &[U8], at: Int) Never! {
    loop slot in 0..<4 {
        if slot < count {
            interleave_in(q, slot, src, off + 16 * slot)
        } else {
            q[slot] = U64{0}
            q[slot + 4] = U64{0}
        }
    }
    ortho(q)
    if decrypt -> decrypt_planes(k, q) else -> encrypt_planes(k, q)
    ortho(q)
    loop slot in 0..<count -> interleave_out(q, slot, out, at + 16 * slot)
}

/// SubWord (FIPS 197 section 5.2) of a 32-bit word.
sub_word: fn(q: &[U64], x: U64) -> U64 Never! {
    wipe_words(q)
    q[0] = x
    ortho(q)
    sbox(q)
    ortho(q)
    q[0].bit_and(U64{0xffffffff})
}

// GF(2^8) doubling modulo x^8 + x^4 + x^3 + x + 1, without a branch.
#Policy(arithmetic: .Wrapping)
xtime: fn(a: U8) -> U8 Never! {
    (a << 1).bit_xor(U8{0x1b}.bit_and(U8{0} - (a >> 7)))
}

/// InvMixColumns of the round key at rk[off..<off + 16] into out[at..].
inv_mix_key: fn(rk: [U8], off: Int, out: &[U8], at: Int) Never! {
    loop c in 0..<4 {
        i: off + 4 * c
        a0: rk[i]
        a1: rk[i + 1]
        a2: rk[i + 2]
        a3: rk[i + 3]
        // 9a, 11a, 13a and 14a from a, 2a, 4a and 8a.
        b0: xtime(a0)
        b1: xtime(a1)
        b2: xtime(a2)
        b3: xtime(a3)
        c0: xtime(b0)
        c1: xtime(b1)
        c2: xtime(b2)
        c3: xtime(b3)
        d0: xtime(c0)
        d1: xtime(c1)
        d2: xtime(c2)
        d3: xtime(c3)
        e0: d0.bit_xor(c0).bit_xor(b0)
        e1: d1.bit_xor(c1).bit_xor(b1)
        e2: d2.bit_xor(c2).bit_xor(b2)
        e3: d3.bit_xor(c3).bit_xor(b3)
        n0: d0.bit_xor(a0)
        n1: d1.bit_xor(a1)
        n2: d2.bit_xor(a2)
        n3: d3.bit_xor(a3)
        l0: d0.bit_xor(b0).bit_xor(a0)
        l1: d1.bit_xor(b1).bit_xor(a1)
        l2: d2.bit_xor(b2).bit_xor(a2)
        l3: d3.bit_xor(b3).bit_xor(a3)
        h0: d0.bit_xor(c0).bit_xor(a0)
        h1: d1.bit_xor(c1).bit_xor(a1)
        h2: d2.bit_xor(c2).bit_xor(a2)
        h3: d3.bit_xor(c3).bit_xor(a3)
        // [0e 0b 0d 09] circulant.
        o: at + 4 * c
        out[o] = e0.bit_xor(l1).bit_xor(h2).bit_xor(n3)
        out[o + 1] = n0.bit_xor(e1).bit_xor(l2).bit_xor(h3)
        out[o + 2] = h0.bit_xor(n1).bit_xor(e2).bit_xor(l3)
        out[o + 3] = l0.bit_xor(h1).bit_xor(n2).bit_xor(e3)
    }
}

/// The FIPS 197 section 5.2 KeyExpansion of a 16-, 24- or 32-byte key;
/// `decrypt` also derives the equivalent inverse cipher's keys. None for
/// any other key length. The schedule's branches test only public word
/// indices.
aes_key: fn(key: [U8], decrypt: Bool) -> AESKey? Never! {
    rounds: if key.len() == {
        16 -> 10
        24 -> 12
        32 -> 14
        else -> return None
    }
    nk: key.len() /% 4
    total: (rounds + 1) * 4
    q := words(8)
    w := words(total)
    loop i in 0..<nk -> w[i] = le32(key, 4 * i)
    rcon := U64{1}
    j := 0
    loop i in nk..<total {
        tmp := w[i - 1]
        if j == 0 {
            // RotWord on a little-endian word, SubWord, then Rcon.
            tmp = ((tmp << 24).bit_or(tmp >> 8)).bit_and(U64{0xffffffff})
            tmp = sub_word(q, tmp).bit_xor(rcon)
            rcon = U64.from_u8(xtime(low_byte(rcon)))
        } else if nk > 6 && j == 4 {
            tmp = sub_word(q, tmp)
        }
        w[i] = tmp.bit_xor(w[i - nk])
        j += 1
        if j == nk -> j = 0
    }
    sk := words((rounds + 1) * 8)
    rk := zero_bytes(total * 4)
    loop i in 0..<total -> put_word(rk, 4 * i, w[i])
    loop round in 0..<rounds + 1 {
        interleave_in(q, 0, rk, 16 * round)
        q[1] = q[0]
        q[2] = q[0]
        q[3] = q[0]
        q[5] = q[4]
        q[6] = q[4]
        q[7] = q[4]
        ortho(q)
        loop i in 0..<8 -> sk[8 * round + i] = q[i]
    }
    dk := [U8]{}
    if decrypt {
        dk = zero_bytes(total * 4)
        loop i in 0..<16 {
            dk[i] = rk[16 * rounds + i]
            dk[16 * rounds + i] = rk[i]
        }
        loop round in 1..<rounds -> inv_mix_key(rk, 16 * (rounds - round), dk, 16 * round)
    }
    wipe_words(q)
    wipe_words(w)
    Val(AESKey{rounds: rounds, sk: sk, rk: rk, dk: dk})
}

// ---------------------------------------------------------------------------
// Block operations.

xor_into: fn(dst: &[U8], at: Int, a: [U8], a_off: Int, b: [U8], b_off: Int, count: Int) Never! {
    loop i in 0..<count -> dst[at + i] = a[a_off + i].bit_xor(b[b_off + i])
}

/// Add one to the 16-byte counter as a big-endian integer of its last
/// `width` bytes (16 for CTR, 4 for CTR32). The counter is public.
increment: fn(ctr: &[U8], width: Int) Never! {
    carry := U64{1}
    loop i in 0..<width {
        n: U64.from_u8(ctr[15 - i]) + carry
        ctr[15 - i] = low_byte(n)
        carry = n >> 8
    }
}

/// The tweak times x in GF(2^128), little-endian (IEEE 1619-2007 section
/// 5.2): a one-bit left shift with x^128 = x^7 + x^2 + x + 1, without a
/// branch on the secret carry.
#Policy(arithmetic: .Wrapping)
xts_double: fn(t: &[U8]) Never! {
    a := U64{0}
    b := U64{0}
    loop i in 0..<8 {
        a = a.bit_or(U64.from_u8(t[i]) << (8 * i))
        b = b.bit_or(U64.from_u8(t[8 + i]) << (8 * i))
    }
    ra: (a << 1).bit_xor(U64{0x87}.bit_and(U64{0} - (b >> 63)))
    rb: (a >> 63).bit_or(b << 1)
    loop i in 0..<8 {
        t[i] = low_byte(ra >> (8 * i))
        t[8 + i] = low_byte(rb >> (8 * i))
    }
}

/// Append the `count` whole blocks of `src` from `off` under `op` to `out`.
/// `iv` is the 16-byte chaining value the operation updates (see CBC_ENC
/// and below). The host leaf runs them when it can; otherwise the
/// bitsliced rounds run, four independent blocks at a time.
blocks: fn(k: AESKey, op: Int, iv: &[U8], src: [U8], off: Int, count: Int, out: &[U8]) Never! {
    if count <= 0 -> return
    reserve(out, count * 16)
    if core.crypto.__aes_blocks(if op == ECB_DEC || op == CBC_DEC || op == XTS_DEC -> k.dk else -> k.rk, k.rounds, op, iv, src, off, count, out) -> return
    blocks_portable(k, op, iv, src, off, count, out)
}

/// `blocks` on the bitsliced rounds alone.
blocks_portable: fn(k: AESKey, op: Int, iv: &[U8], src: [U8], off: Int, count: Int, out: &[U8]) Never! {
    if count <= 0 -> return
    base: out.len()
    loop _ in 0..<count * 16 -> out.push(U8{0})
    q := words(8)
    buf := zero_bytes(64)
    pad := zero_bytes(64)
    done := 0
    if op == ECB_ENC || op == ECB_DEC {
        loop done < count {
            n: if count - done < 4 -> count - done else -> 4
            crypt4(k, op == ECB_DEC, q, src, off + 16 * done, n, out, base + 16 * done)
            done += n
        }
    } else if op == CBC_DEC {
        loop done < count {
            n: if count - done < 4 -> count - done else -> 4
            at: off + 16 * done
            crypt4(k, true, q, src, at, n, buf, 0)
            // Each plaintext is D(C_i) + C_{i-1}; C_{-1} is the iv.
            loop i in 0..<16 -> pad[i] = iv[i]
            loop i in 16..<16 * n -> pad[i] = src[at + i - 16]
            xor_into(out, base + 16 * done, buf, 0, pad, 0, 16 * n)
            loop i in 0..<16 -> iv[i] = src[at + 16 * (n - 1) + i]
            done += n
        }
    } else if op == CTR || op == CTR32 {
        width: if op == CTR -> 16 else -> 4
        loop done < count {
            n: if count - done < 4 -> count - done else -> 4
            loop b in 0..<n {
                loop i in 0..<16 -> pad[16 * b + i] = iv[i]
                increment(iv, width)
            }
            crypt4(k, false, q, pad, 0, n, buf, 0)
            xor_into(out, base + 16 * done, buf, 0, src, off + 16 * done, 16 * n)
            done += n
        }
    } else if op == XTS_ENC || op == XTS_DEC {
        tweaked := zero_bytes(64)
        loop done < count {
            n: if count - done < 4 -> count - done else -> 4
            at: off + 16 * done
            // pad holds the n tweaks, tweaked the tweaked inputs.
            loop b in 0..<n {
                loop i in 0..<16 -> pad[16 * b + i] = iv[i]
                xts_double(iv)
            }
            xor_into(tweaked, 0, src, at, pad, 0, 16 * n)
            crypt4(k, op == XTS_DEC, q, tweaked, 0, n, buf, 0)
            xor_into(out, base + 16 * done, buf, 0, pad, 0, 16 * n)
            done += n
        }
        core.crypto.wipe(tweaked)
    } else {
        // CBC_ENC, CFB_ENC, CFB_DEC and OFB chain every block on the last.
        loop done < count {
            at: off + 16 * done
            o: base + 16 * done
            if op == CBC_ENC {
                xor_into(pad, 0, src, at, iv, 0, 16)
                crypt4(k, false, q, pad, 0, 1, buf, 0)
                loop i in 0..<16 {
                    out[o + i] = buf[i]
                    iv[i] = buf[i]
                }
            } else {
                crypt4(k, false, q, iv, 0, 1, buf, 0)
                loop i in 0..<16 {
                    c: buf[i].bit_xor(src[at + i])
                    out[o + i] = c
                    iv[i] = if op == CFB_ENC -> c else if op == CFB_DEC -> src[at + i] else -> buf[i]
                }
            }
            done += 1
        }
    }
    wipe_words(q)
    core.crypto.wipe(buf)
    core.crypto.wipe(pad)
}

/// One block of `src` at `off` encrypted into out[at..<at + 16], in place.
encrypt_block: fn(k: AESKey, src: [U8], off: Int, out: &[U8], at: Int) Never! {
    one := [U8]{}
    blocks(k, ECB_ENC, zero_bytes(16), src, off, 1, one)
    loop i in 0..<16 -> out[at + i] = one[i]
    core.crypto.wipe(one)
}

/// The 16-byte block `b` replaced by its encryption.
encrypt_in_place: fn(k: AESKey, b: &[U8]) Never! {
    one := [U8]{}
    blocks(k, ECB_ENC, zero_bytes(16), b, 0, 1, one)
    loop i in 0..<16 -> b[i] = one[i]
    core.crypto.wipe(one)
}

/// The forward direction of a 128-bit block cipher, all GCM and CCM
/// (__core_crypto_aead) run on: AES here, ARIA and Camellia in
/// __core_crypto_block, as mbedtls's gcm.c and ccm.c run on any cipher with
/// 16-byte blocks. The key must hold an encryption schedule.
ForwardBlock: trait {
    /// The 16-byte block `b` replaced by its encryption.
    encrypt_one: fn(self, b: &[U8]) Never!
    /// `count` whole blocks of `src` from `off` XORed with the keystream of
    /// the counter block `ctr`, appended to `out`; `ctr` ends incremented
    /// by `count` in its last 32 bits (the CTR32 operation of `blocks`).
    ctr32_blocks: fn(self, ctr: &[U8], src: [U8], off: Int, count: Int, out: &[U8]) Never!
    /// `count` whole blocks of `src` from `off` CBC-encrypted from the
    /// chaining value `iv`, appended to `out`; `iv` ends holding the last
    /// ciphertext block (the CBC_ENC operation of `blocks`).
    cbc_blocks: fn(self, iv: &[U8], src: [U8], off: Int, count: Int, out: &[U8]) Never!
}

// ---------------------------------------------------------------------------
// The SP 800-38A modes, with mbedtls's streaming offsets.

/// ECB over `count` whole blocks.
ecb: fn(k: AESKey, decrypt: Bool, src: [U8], off: Int, count: Int, out: &[U8]) Never! {
    blocks(k, if decrypt -> ECB_DEC else -> ECB_ENC, zero_bytes(16), src, off, count, out)
}

/// CBC over `len` bytes, a multiple of 16; false, appending nothing, for
/// any other length.
cbc: fn(k: AESKey, decrypt: Bool, iv: &[U8], src: [U8], off: Int, len: Int, out: &[U8]) -> Bool Never! {
    if len %% 16 != 0 -> return false
    blocks(k, if decrypt -> CBC_DEC else -> CBC_ENC, iv, src, off, len /% 16, out)
    true
}

/// CTR over `len` bytes with the 128-bit counter `counter`. `stream` holds
/// the current keystream block and `offset` the bytes of it already used;
/// the new offset is returned (mbedtls_aes_crypt_ctr). As there, `stream`
/// ends holding the last keystream block used.
ctr: fn(k: AESKey, offset: Int, counter: &[U8], stream: &[U8], src: [U8], off: Int, len: Int, out: &[U8]) -> Int Never! {
    n := offset
    at := off
    end: off + len
    reserve(out, len)
    loop n != 0 && at < end {
        out.push(src[at].bit_xor(stream[n]))
        n = (n + 1) %% 16
        at += 1
    }
    // All but the last whole block in bulk; that one and the tail go
    // through `stream`.
    whole: (end - at) /% 16
    if whole > 1 {
        blocks(k, CTR, counter, src, at, whole - 1, out)
        at += (whole - 1) * 16
    }
    loop at < end {
        if n == 0 {
            encrypt_block(k, counter, 0, stream, 0)
            increment(counter, 16)
        }
        out.push(src[at].bit_xor(stream[n]))
        n = (n + 1) %% 16
        at += 1
    }
    n
}

/// CFB128 over `len` bytes; `offset` bytes of the current block are used.
/// Returns the new offset (mbedtls_aes_crypt_cfb128).
cfb128: fn(k: AESKey, decrypt: Bool, offset: Int, iv: &[U8], src: [U8], off: Int, len: Int, out: &[U8]) -> Int Never! {
    n := offset
    at := off
    end: off + len
    reserve(out, len)
    loop n != 0 && at < end {
        c: if decrypt -> src[at] else -> src[at].bit_xor(iv[n])
        out.push(src[at].bit_xor(iv[n]))
        iv[n] = c
        n = (n + 1) %% 16
        at += 1
    }
    whole: (end - at) /% 16
    blocks(k, if decrypt -> CFB_DEC else -> CFB_ENC, iv, src, at, whole, out)
    at += whole * 16
    if at < end {
        encrypt_in_place(k, iv)
        loop at < end {
            c: if decrypt -> src[at] else -> src[at].bit_xor(iv[n])
            out.push(src[at].bit_xor(iv[n]))
            iv[n] = c
            n += 1
            at += 1
        }
    }
    n
}

/// CFB8 over `len` bytes: one block encryption per byte
/// (mbedtls_aes_crypt_cfb8).
cfb8: fn(k: AESKey, decrypt: Bool, iv: &[U8], src: [U8], off: Int, len: Int, out: &[U8]) Never! {
    ks := zero_bytes(16)
    reserve(out, len)
    loop i in 0..<len {
        encrypt_block(k, iv, 0, ks, 0)
        b: src[off + i]
        c: ks[0].bit_xor(b)
        out.push(c)
        loop j in 0..<15 -> iv[j] = iv[j + 1]
        iv[15] = if decrypt -> b else -> c
    }
    core.crypto.wipe(ks)
}

/// OFB over `len` bytes; returns the new offset (mbedtls_aes_crypt_ofb).
ofb: fn(k: AESKey, offset: Int, iv: &[U8], src: [U8], off: Int, len: Int, out: &[U8]) -> Int Never! {
    n := offset
    at := off
    end: off + len
    reserve(out, len)
    loop n != 0 && at < end {
        out.push(src[at].bit_xor(iv[n]))
        n = (n + 1) %% 16
        at += 1
    }
    whole: (end - at) /% 16
    blocks(k, OFB, iv, src, at, whole, out)
    at += whole * 16
    if at < end {
        encrypt_in_place(k, iv)
        loop at < end {
            out.push(src[at].bit_xor(iv[n]))
            n += 1
            at += 1
        }
    }
    n
}

// ---------------------------------------------------------------------------
// XTS-AES.

/// The data key and the tweak key of XTS-AES-128 or XTS-AES-256.
XTSKey: struct {
    crypt: AESKey
    tweak: AESKey
}

/// The two halves of a 32- or 64-byte XTS key: the first encrypts the
/// data, the second the tweak. None for any other length.
xts_key: fn(key: [U8], decrypt: Bool) -> XTSKey? Never! {
    if key.len() != 32 && key.len() != 64 -> return None
    half: key.len() /% 2
    data_half := bytes_of(key, 0, half)
    tweak_half := bytes_of(key, half, half)
    crypt: aes_key(data_half, decrypt) ?? return None
    tweak: aes_key(tweak_half, false) ?? return None
    core.crypto.wipe(data_half)
    core.crypto.wipe(tweak_half)
    Val(XTSKey{crypt: crypt, tweak: tweak})
}

/// XTS-AES over one data unit of `len` bytes, 16 up to 2^20 blocks, with
/// ciphertext stealing for a partial last block (IEEE 1619-2007 sections
/// 5.3.2 and 5.4.2). False, appending nothing, for any other length.
xts: fn(xk: XTSKey, decrypt: Bool, data_unit: [U8], src: [U8], off: Int, len: Int, out: &[U8]) -> Bool Never! {
    if len < 16 || len > 16777216 -> return false
    full := len /% 16
    leftover: len %% 16
    tweak := zero_bytes(16)
    encrypt_block(xk.tweak, data_unit, 0, tweak, 0)
    op: if decrypt -> XTS_DEC else -> XTS_ENC
    base: out.len()
    reserve(out, len)
    // A decryption that steals runs its last full block on the tweak after
    // the stolen block's.
    if leftover != 0 && decrypt -> full -= 1
    blocks(xk.crypt, op, tweak, src, off, full, out)
    if leftover == 0 {
        core.crypto.wipe(tweak)
        return true
    }
    steal := tweak.copy()
    if decrypt {
        xts_double(tweak)
        blocks(xk.crypt, op, tweak, src, off + 16 * full, 1, out)
    }
    // out's last whole block gives the partial block its leading bytes and
    // the stolen block its tail.
    last: base + 16 * (len /% 16 - 1)
    tail := zero_bytes(16)
    loop i in 0..<leftover {
        tail[i] = src[off + 16 * (len /% 16) + i].bit_xor(steal[i])
        out.push(out[last + i])
    }
    loop i in leftover..<16 -> tail[i] = out[last + i].bit_xor(steal[i])
    one := [U8]{}
    blocks(xk.crypt, if decrypt -> ECB_DEC else -> ECB_ENC, zero_bytes(16), tail, 0, 1, one)
    loop i in 0..<16 -> out[last + i] = one[i].bit_xor(steal[i])
    core.crypto.wipe(one)
    core.crypto.wipe(tail)
    core.crypto.wipe(steal)
    core.crypto.wipe(tweak)
    true
}

// ---------------------------------------------------------------------------
// CMAC.

/// The 16-byte block doubled in GF(2^128), big-endian (SP 800-38B section
/// 6.1): a one-bit left shift, then 0x87 into the last byte when the shifted
/// out bit was set, without a branch on it.
#Policy(arithmetic: .Wrapping)
cmac_double: fn(b: &[U8]) Never! {
    carry: U8{0} - (b[0] >> 7)
    loop i in 0..<15 -> b[i] = (b[i] << 1).bit_or(b[i + 1] >> 7)
    b[15] = (b[15] << 1).bit_xor(U8{0x87}.bit_and(carry))
}

/// The AES-CMAC of `msg` (SP 800-38B section 6.2), 16 bytes.
cmac: fn(k: AESKey, msg: [U8]) -> [U8] Never! {
    sub := zero_bytes(16)
    encrypt_in_place(k, sub)
    cmac_double(sub)
    n := (msg.len() + 15) /% 16
    complete := n > 0 && msg.len() %% 16 == 0
    if n == 0 -> n = 1
    // K1 for a complete last block, else K2 and the 10* padding.
    if !complete -> cmac_double(sub)
    last := zero_bytes(16)
    start: 16 * (n - 1)
    loop i in 0..<16 {
        at: start + i
        m: if at < msg.len() -> msg[at] else if at == msg.len() -> U8{0x80} else -> U8{0}
        last[i] = m.bit_xor(sub[i])
    }
    x := zero_bytes(16)
    chain := [U8]{}
    blocks(k, CBC_ENC, x, msg, 0, n - 1, chain)
    blocks(k, CBC_ENC, x, last, 0, 1, chain)
    core.crypto.wipe(chain)
    core.crypto.wipe(last)
    core.crypto.wipe(sub)
    x
}

/// AES-CMAC-PRF-128 (RFC 4615 section 3): a key that is not 16 bytes is
/// first reduced to AES-CMAC(0^128, key).
cmac_prf_128: fn(key: [U8], msg: [U8]) -> [U8] Never! {
    derived := if key.len() == 16 -> key.copy() else -> {
        zero_key: aes_key(zero_bytes(16), false) ?? panic("AES-128 key")
        cmac(zero_key, key)
    }
    k: aes_key(derived, false) ?? panic("AES-128 key")
    core.crypto.wipe(derived)
    cmac(k, msg)
}

// ---------------------------------------------------------------------------
// Key wrap.

/// Why a key wrap or an authenticated mode (core.crypto.__core_crypto_aead)
/// refused.
#Error
CipherError: enum {
    /// A length or parameter outside the algorithm's limits.
    Input
    /// The tag, the integrity check value or the padding did not verify.
    Auth
}

// SP 800-38F section 6.2: ICV1 for KW and the ICV2 prefix of KWP.
KW_ICV1: 0xa6
KWP_ICV2: [U8]{0xa6, 0x59, 0x59, 0xa6}

/// W (SP 800-38F section 6.1, algorithm 1) over buf = A || R1 || ... || Rn
/// in place: 6n rounds of A || R_i encrypted, then A ^= t.
kw_w: fn(k: AESKey, buf: &[U8]) Never! {
    n: buf.len() /% 8 - 1
    block := zero_bytes(16)
    one := zero_bytes(16)
    t := 1
    loop _ in 0..<6 {
        loop i in 1..<n + 1 {
            loop b in 0..<8 {
                block[b] = buf[b]
                block[8 + b] = buf[8 * i + b]
            }
            encrypt_block(k, block, 0, one, 0)
            loop b in 0..<8 {
                buf[b] = one[b].bit_xor(low_byte(U64{t} >> (56 - 8 * b)))
                buf[8 * i + b] = one[8 + b]
            }
            t += 1
        }
    }
    core.crypto.wipe(block)
    core.crypto.wipe(one)
}

/// W^-1 (SP 800-38F section 6.1, algorithm 2) in place.
kw_w_inverse: fn(k: AESKey, buf: &[U8]) Never! {
    n: buf.len() /% 8 - 1
    block := zero_bytes(16)
    one := [U8]{}
    t := 6 * n
    loop _ in 0..<6 {
        i := n
        loop i >= 1 {
            loop b in 0..<8 {
                block[b] = buf[b].bit_xor(low_byte(U64{t} >> (56 - 8 * b)))
                block[8 + b] = buf[8 * i + b]
            }
            one = [U8]{}
            blocks(k, ECB_DEC, zero_bytes(16), block, 0, 1, one)
            loop b in 0..<8 {
                buf[b] = one[b]
                buf[8 * i + b] = one[8 + b]
            }
            core.crypto.wipe(one)
            t -= 1
            i -= 1
        }
    }
    core.crypto.wipe(block)
}

/// KW-AE or, `padded`, KWP-AE (SP 800-38F sections 6.2 and 6.3) of
/// `plain` under an encryption key.
kw_wrap: fn(k: AESKey, padded: Bool, plain: [U8]) -> [U8] CipherError! {
    len: plain.len()
    if padded {
        if len < 1 || len > 4294967295 -> return Err(.Input)
    } else {
        if len < 16 || len %% 8 != 0 || len > 0x1ffffffffffffff8 -> return Err(.Input)
    }
    pad: if padded -> (8 - len %% 8) %% 8 else -> 0
    buf := zero_bytes(8 + len + pad)
    if padded {
        loop i in 0..<4 -> buf[i] = KWP_ICV2[i]
        loop i in 0..<4 -> buf[4 + i] = low_byte(U64{len} >> (24 - 8 * i))
    } else {
        loop i in 0..<8 -> buf[i] = U8{KW_ICV1}
    }
    loop i in 0..<len -> buf[8 + i] = plain[i]
    if padded && len <= 8 {
        // A single semiblock is one AES block (section 6.3, step 2).
        out := [U8]{}
        ecb(k, false, buf, 0, 1, out)
        core.crypto.wipe(buf)
        return Ok(out)
    }
    kw_w(k, buf)
    Ok(buf)
}

/// KW-AD or, `padded`, KWP-AD of `wrapped` under a decryption key. The
/// integrity check, the length and the padding are compared without a
/// branch on their bytes; only the combined verdict is.
kw_unwrap: fn(k: AESKey, padded: Bool, wrapped: [U8]) -> [U8] CipherError! {
    len: wrapped.len()
    if padded {
        if len < 16 || len > 4294967296 || len %% 8 != 0 -> return Err(.Input)
    } else {
        if len < 24 || len > 0x200000000000000 || len %% 8 != 0 -> return Err(.Input)
    }
    buf := [U8]{}
    if padded && len == 16 {
        ecb(k, true, wrapped, 0, 1, buf)
    } else {
        buf = bytes_of(wrapped, 0, len)
        kw_w_inverse(k, buf)
    }
    diff := U64{0}
    plen := U64{len - 8}
    if padded {
        loop i in 0..<4 -> diff = diff.bit_or(U64.from_u8(buf[i].bit_xor(KWP_ICV2[i])))
        mli := U64{0}
        loop i in 0..<4 -> mli = (mli << 8).bit_or(U64.from_u8(buf[4 + i]))
        // The padding is len - 8 - MLI bytes: 0 to 7, and all zero. An MLI
        // past len - 8 fails, and is capped there, without a branch.
        room: U64{len - 8}
        over: ct_gt(mli, room)
        capped: mli.bit_and(over.bit_not()).bit_or(room.bit_and(over))
        padding: room.wrapping_sub(capped)
        diff = diff.bit_or(over).bit_or(ct_gt(padding, U64{7}))
        zeros: padding.bit_and(U64{7})
        loop i in 0..<8 {
            // Byte 8 + (len - 16) + i is padding when i >= 8 - zeros.
            inside: ct_gt(U64{i + 1}, U64{8}.wrapping_sub(zeros))
            diff = diff.bit_or(inside.bit_and(U64.from_u8(buf[len - 8 + i])))
        }
        plen = capped
    } else {
        loop i in 0..<8 -> diff = diff.bit_or(U64.from_u8(buf[i].bit_xor(U8{KW_ICV1})))
    }
    if !kw_unwrap_ok(diff) {
        core.crypto.wipe(buf)
        return Err(.Auth)
    }
    out := bytes_of(buf, 8, kw_unwrapped_len(plen))
    core.crypto.wipe(buf)
    Ok(out)
}

/// Whether a key unwrap's integrity check, length and padding all held:
/// the combined verdict, revealed as mbedtls_nist_kw_unwrap returns it.
kw_unwrap_ok: fn(diff: U64) -> Bool Never! { diff == U64{0} }

/// An unwrapped key's length, revealed once kw_unwrap_ok holds: the caller
/// is handed that many bytes. It is below 2^32 (the wrapped input is at
/// most 2^32 bytes), so it is built as a 32-bit word: a wider one would
/// test its range on the way to an Int.
kw_unwrapped_len: fn(plen: U64) -> Int Never! { Int{wrapping(U32{plen})} }

/// All ones when a > b, else zero, for a and b below 2^63, without a
/// branch.
#Policy(arithmetic: .Wrapping)
ct_gt: fn(a: U64, b: U64) -> U64 Never! { U64{0} - ((b - a) >> 63) }

// ---------------------------------------------------------------------------
// CBC padding (mbedtls cipher.c).

CBCPadding: enum {
    /// PKCS #7: n bytes of value n.
    PKCS7
    /// ISO/IEC 7816-4: 0x80, then zeros.
    OneAndZeros
    /// ANSI X.923: zeros, then the count.
    ZerosAndLen
    /// Zeros; an all-zero tail is indistinguishable from padding.
    Zeros
    /// No padding: the input must be whole blocks.
    Unpadded
}

/// Fill out[data_len..<len] with `mode`'s padding, so out[0..<len] is one
/// padded block (mbedtls's add_*_padding). `.Unpadded` writes nothing, as
/// mbedtls has no add function for it.
cbc_add_padding: fn(mode: CBCPadding, out: &[U8], len: Int, data_len: Int) Never! {
    if mode == .Unpadded -> return
    fill: len - data_len
    loop i in data_len..<len {
        out[i] = if mode == {
            .PKCS7 -> U8{fill}
            .OneAndZeros -> if i == data_len -> U8{0x80} else -> U8{0}
            .ZerosAndLen -> if i == len - 1 -> U8{fill} else -> U8{0}
            .Zeros | .Unpadded -> U8{0}
        }
    }
}

/// What a padding check found in a decrypted block, as words under masks:
/// the data bytes before the padding (0 when the padding is malformed) and
/// `bad`, all ones when it is. Both stay secret until the cipher finishes
/// (CipherLayer.jet `padding_len`, `padding_valid`); an Int would test
/// its range on every use.
CBCPaddingCheck: struct {
    data_len: U64
    bad: U64
}

/// All ones when x is not zero, else zero, without a branch.
#Policy(arithmetic: .Wrapping)
ct_nonzero: fn(x: U64) -> U64 Never! { U64{0} - ((x.bit_or(U64{0} - x)) >> 63) }

/// The padding of the `len`-byte block at input[off] (mbedtls's
/// get_*_padding). Every byte is read and the result built from masks,
/// without a branch on the block's bytes:
/// - PKCS7: the last byte n must be 1..len and the last n bytes all n.
/// - OneAndZeros: the last non-zero byte must be 0x80.
/// - ZerosAndLen: the last byte n must be 1..len, after n - 1 zeros.
/// - Zeros: the data ends at the last non-zero byte; never invalid.
/// - Unpadded: all `len` bytes are data.
#Policy(arithmetic: .Wrapping)
cbc_get_padding: fn(mode: CBCPadding, input: [U8], off: Int, len: Int) -> CBCPaddingCheck Never! {
    total: U64{len}
    if mode == {
        .Unpadded -> CBCPaddingCheck{data_len: total, bad: U64{0}}
        .PKCS7 | .ZerosAndLen -> {
            n: U64.from_u8(input[off + len - 1])
            bad := ct_gt(n, total).bit_or(ct_nonzero(n).bit_not())
            pad_idx: total - n
            want: if mode == .PKCS7 -> n else -> U64{0}
            checked: if mode == .PKCS7 -> len else -> len - 1
            loop i in 0..<checked {
                inside: ct_gt(U64{i + 1}, pad_idx)
                bad = bad.bit_or(inside.bit_and(ct_nonzero(U64.from_u8(input[off + i]).bit_xor(want))))
            }
            CBCPaddingCheck{data_len: pad_idx.bit_and(bad.bit_not()), bad: bad}
        }
        .OneAndZeros -> {
            in_padding := U64{0}.bit_not()
            bad := U64{0}.bit_not()
            at := U64{0}
            i := len - 1
            loop i >= 0 {
                b: U64.from_u8(input[off + i])
                nonzero: ct_nonzero(b)
                hit: nonzero.bit_and(in_padding)
                at = U64{i}.bit_and(hit).bit_or(at.bit_and(hit.bit_not()))
                bad = ct_nonzero(b.bit_xor(U64{0x80})).bit_and(hit).bit_or(bad.bit_and(hit.bit_not()))
                in_padding = in_padding.bit_and(nonzero.bit_not())
                i -= 1
            }
            CBCPaddingCheck{data_len: at.bit_and(bad.bit_not()), bad: bad}
        }
        .Zeros -> {
            done := U64{0}
            at := U64{0}
            i := len
            loop i > 0 {
                was: done
                done = done.bit_or(ct_nonzero(U64.from_u8(input[off + i - 1])))
                turned: done.bit_xor(was)
                at = U64{i}.bit_and(turned).bit_or(at.bit_and(turned.bit_not()))
                i -= 1
            }
            CBCPaddingCheck{data_len: at, bad: U64{0}}
        }
    }
}

// ---------------------------------------------------------------------------

#Test("FIPS 197 appendix C known answers for AES-128, AES-192 and AES-256 in both directions") {
    plain: [U8]{0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff}
    keys: [[U8]]{
        [U8]{0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f},
        [U8]{0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17},
        [U8]{0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f},
    }
    expected: [[U8]]{
        [U8]{0x69, 0xc4, 0xe0, 0xd8, 0x6a, 0x7b, 0x04, 0x30, 0xd8, 0xcd, 0xb7, 0x80, 0x70, 0xb4, 0xc5, 0x5a},
        [U8]{0xdd, 0xa9, 0x7c, 0xa4, 0x86, 0x4c, 0xdf, 0xe0, 0x6e, 0xaf, 0x70, 0xa0, 0xec, 0x0d, 0x71, 0x91},
        [U8]{0x8e, 0xa2, 0xb7, 0xca, 0x51, 0x67, 0x45, 0xbf, 0xea, 0xfc, 0x49, 0x90, 0x4b, 0x49, 0x60, 0x89},
    }
    loop (i, key) in keys {
        k: aes_key(key, true) ?? panic("AES key")
        sealed := [U8]{}
        ecb(k, false, plain, 0, 1, sealed)
        assert(sealed == expected[i])
        opened := [U8]{}
        ecb(k, true, sealed, 0, 1, opened)
        assert(opened == plain)
    }
    assert(aes_key([U8]{1, 2, 3}, false) == None)
}

#Test("SP 800-38A F.2.1 CBC-AES128, F.5.1 CTR-AES128 and F.4.1 OFB-AES128 agree with the Jet rounds four blocks at a time") {
    key: [U8]{0x2b, 0x7e, 0x15, 0x16, 0x28, 0xae, 0xd2, 0xa6, 0xab, 0xf7, 0x15, 0x88, 0x09, 0xcf, 0x4f, 0x3c}
    plain: [U8]{0x6b, 0xc1, 0xbe, 0xe2, 0x2e, 0x40, 0x9f, 0x96, 0xe9, 0x3d, 0x7e, 0x11, 0x73, 0x93, 0x17, 0x2a, 0xae, 0x2d, 0x8a, 0x57, 0x1e, 0x03, 0xac, 0x9c, 0x9e, 0xb7, 0x6f, 0xac, 0x45, 0xaf, 0x8e, 0x51, 0x30, 0xc8, 0x1c, 0x46, 0xa3, 0x5c, 0xe4, 0x11, 0xe5, 0xfb, 0xc1, 0x19, 0x1a, 0x0a, 0x52, 0xef, 0xf6, 0x9f, 0x24, 0x45, 0xdf, 0x4f, 0x9b, 0x17, 0xad, 0x2b, 0x41, 0x7b, 0xe6, 0x6c, 0x37, 0x10}
    k: aes_key(key, true) ?? panic("AES key")
    iv: [U8]{0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f}
    chain := iv.copy()
    sealed := [U8]{}
    assert(cbc(k, false, chain, plain, 0, 64, sealed))
    assert(sealed == [U8]{0x76, 0x49, 0xab, 0xac, 0x81, 0x19, 0xb2, 0x46, 0xce, 0xe9, 0x8e, 0x9b, 0x12, 0xe9, 0x19, 0x7d, 0x50, 0x86, 0xcb, 0x9b, 0x50, 0x72, 0x19, 0xee, 0x95, 0xdb, 0x11, 0x3a, 0x91, 0x76, 0x78, 0xb2, 0x73, 0xbe, 0xd6, 0xb8, 0xe3, 0xc1, 0x74, 0x3b, 0x71, 0x16, 0xe6, 0x9e, 0x22, 0x22, 0x95, 0x16, 0x3f, 0xf1, 0xca, 0xa1, 0x68, 0x1f, 0xac, 0x09, 0x12, 0x0e, 0xca, 0x30, 0x75, 0x86, 0xe1, 0xa7})
    chain = iv.copy()
    opened := [U8]{}
    assert(cbc(k, true, chain, sealed, 0, 64, opened))
    assert(opened == plain)
    counter := [U8]{0xf0, 0xf1, 0xf2, 0xf3, 0xf4, 0xf5, 0xf6, 0xf7, 0xf8, 0xf9, 0xfa, 0xfb, 0xfc, 0xfd, 0xfe, 0xff}
    stream := zero_bytes(16)
    streamed := [U8]{}
    assert(ctr(k, 0, counter, stream, plain, 0, 64, streamed) == 0)
    assert(streamed == [U8]{0x87, 0x4d, 0x61, 0x91, 0xb6, 0x20, 0xe3, 0x26, 0x1b, 0xef, 0x68, 0x64, 0x99, 0x0d, 0xb6, 0xce, 0x98, 0x06, 0xf6, 0x6b, 0x79, 0x70, 0xfd, 0xff, 0x86, 0x17, 0x18, 0x7b, 0xb9, 0xff, 0xfd, 0xff, 0x5a, 0xe4, 0xdf, 0x3e, 0xdb, 0xd5, 0xd3, 0x5e, 0x5b, 0x4f, 0x09, 0x02, 0x0d, 0xb0, 0x3e, 0xab, 0x1e, 0x03, 0x1d, 0xda, 0x2f, 0xbe, 0x03, 0xd1, 0x79, 0x21, 0x70, 0xa0, 0xf3, 0x00, 0x9c, 0xee})
    chain = iv.copy()
    fed := [U8]{}
    assert(ofb(k, 0, chain, plain, 0, 64, fed) == 0)
    assert(fed == [U8]{0x3b, 0x3f, 0xd9, 0x2e, 0xb7, 0x2d, 0xad, 0x20, 0x33, 0x34, 0x49, 0xf8, 0xe8, 0x3c, 0xfb, 0x4a, 0x77, 0x89, 0x50, 0x8d, 0x16, 0x91, 0x8f, 0x03, 0xf5, 0x3c, 0x52, 0xda, 0xc5, 0x4e, 0xd8, 0x25, 0x97, 0x40, 0x05, 0x1e, 0x9c, 0x5f, 0xec, 0xf6, 0x43, 0x44, 0xf7, 0xa8, 0x22, 0x60, 0xed, 0xcc, 0x30, 0x4c, 0x65, 0x28, 0xf6, 0x59, 0xc7, 0x78, 0x66, 0xa5, 0x10, 0xd9, 0xc1, 0xd6, 0xae, 0x5e})
}

#Test("RFC 4493 AES-CMAC and RFC 3394 key wrap known answers") {
    key: [U8]{0x2b, 0x7e, 0x15, 0x16, 0x28, 0xae, 0xd2, 0xa6, 0xab, 0xf7, 0x15, 0x88, 0x09, 0xcf, 0x4f, 0x3c}
    k: aes_key(key, false) ?? panic("AES key")
    assert(cmac(k, [U8]{}) == [U8]{0xbb, 0x1d, 0x69, 0x29, 0xe9, 0x59, 0x37, 0x28, 0x7f, 0xa3, 0x7d, 0x12, 0x9b, 0x75, 0x67, 0x46})
    assert(cmac(k, [U8]{0x6b, 0xc1, 0xbe, 0xe2, 0x2e, 0x40, 0x9f, 0x96, 0xe9, 0x3d, 0x7e, 0x11, 0x73, 0x93, 0x17, 0x2a}) == [U8]{0x07, 0x0a, 0x16, 0xb4, 0x6b, 0x4d, 0x41, 0x44, 0xf7, 0x9b, 0xdd, 0x9d, 0xd0, 0x4a, 0x28, 0x7c})
    kek: [U8]{0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f}
    data: [U8]{0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff}
    wrap_key: aes_key(kek, true) ?? panic("AES key")
    wrapped: kw_wrap(wrap_key, false, data) ?? panic("wrap")
    assert(wrapped == [U8]{0x1f, 0xa6, 0x8b, 0x0a, 0x81, 0x12, 0xb4, 0x47, 0xae, 0xf3, 0x4b, 0xd8, 0xfb, 0x5a, 0x7b, 0x82, 0x9d, 0x3e, 0x86, 0x23, 0x71, 0xd2, 0xcf, 0xe5})
    assert((kw_unwrap(wrap_key, false, wrapped) ?? panic("unwrap")) == data)
    forged := wrapped.copy()
    forged[3] = forged[3].bit_xor(U8{1})
    refused: if kw_unwrap(wrap_key, false, forged) == {
        .Ok(_) -> false
        .Err(e) -> e == .Auth
    }
    assert(refused)
}

#Test("The AES host leaf agrees with the bitsliced rounds on every operation, key size, block count and offset") {
    src := [U8]{}
    loop i in 0..<160 -> src.push(U8{(i * 37 + 11) %% 256})
    loop size in ([Int]{16, 24, 32}) {
        key := [U8]{}
        loop i in 0..<size -> key.push(U8{(i * 13 + 5) %% 256})
        k: aes_key(key, true) ?? panic("AES key")
        loop op in ECB_ENC..<XTS_DEC + 1 {
            loop count in 1..<10 {
                loop off in ([Int]{0, 3}) {
                    // A non-empty `out` checks that both append after it.
                    fast := [U8]{0xee}
                    slow := [U8]{0xee}
                    fast_iv := bytes_of(src, 144, 16)
                    slow_iv := bytes_of(src, 144, 16)
                    blocks(k, op, fast_iv, src, off, count, fast)
                    blocks_portable(k, op, slow_iv, src, off, count, slow)
                    assert(fast == slow)
                    assert(fast_iv == slow_iv)
                }
            }
        }
    }
}
