// SPDX-License-Identifier: Apache-2.0
// Translated from Mbed TLS 3.6.7 (library/pk.c, library/pk_wrap.c, library/pk_ecc.c); Copyright The Mbed TLS Contributors; see LICENSE-mbedtls and NOTICE-mbedtls beside this file.
// Private Core source part: the public-key abstraction layer.
//
// A port of mbedtls 3.6.7's pk.c, pk_wrap.c and pk_ecc.c in the library's
// default configuration (no PSA keys): one context holds an RSA key, an
// elliptic-curve key (EC, EC_DH or ECDSA) or an RSA-alt key whose private
// operations are callbacks, and dispatches signing, verification,
// encryption, decryption and the public/private pair check by key type.
//
// Where the C contract cannot be expressed it is enforced by the types: a
// hash or signature is a byte list whose length is its size (no NULL with a
// length, and an empty hash is refused rather than read as one digest long),
// outputs grow to fit their bound, and the RSA-alt callbacks are closures
// over their own key and generator, so they take no generator argument.
use {
    core
    cipher: __core_crypto_cipher
    bn: __core_crypto_bignum
    __core_crypto_bignum.[RNG]
    hashes: __core_crypto_md
    asn1: __core_crypto_asn1
    oids: __core_crypto_oid
    ecp: __core_crypto_ecp
    ecdsa: __core_crypto_ecdsa
    rsa: __core_crypto_rsa
    pem: __core_crypto_pem
    pkcs5: __core_crypto_pkcs5
}

/// The longest signature any key here makes (MBEDTLS_PK_SIGNATURE_MAX_SIZE:
/// the largest RSA modulus, which exceeds the widest ECDSA signature).
PK_SIGNATURE_MAX_SIZE: 1024

/// Why a public-key operation, or parsing or writing a key, failed
/// (MBEDTLS_ERR_PK_*), or the error of the layer below that mbedtls passes
/// on unchanged.
#Error
PKError: enum {
    /// The key cannot do this operation (TYPE_MISMATCH, -0x3F00).
    TypeMismatch
    /// Bad input parameters, or a context that is not set up
    /// (BAD_INPUT_DATA, -0x3E80).
    BadInput
    /// The key's version is not supported (KEY_INVALID_VERSION, -0x3D80).
    KeyInvalidVersion
    /// The key is malformed (KEY_INVALID_FORMAT, -0x3D00), with the ASN.1
    /// error mbedtls adds to the code.
    KeyInvalidFormat(asn1.ASN1Error?)
    /// The private value is not a key on its curve (KEY_INVALID_FORMAT plus
    /// the MBEDTLS_ERR_ECP_* code).
    KeyInvalidFormatEcp(ecp.EcpError)
    /// The key's algorithm is not RSA, EC or EC_DH, or has no context here
    /// (UNKNOWN_PK_ALG, -0x3C80).
    UnknownPKAlg
    /// The key is encrypted and no password was given
    /// (PASSWORD_REQUIRED, -0x3C00).
    PasswordRequired
    /// The password does not decrypt the key (PASSWORD_MISMATCH, -0x3B80).
    PasswordMismatch
    /// The public key is malformed (INVALID_PUBKEY, -0x3B00), with the
    /// ASN.1 error mbedtls adds to the code.
    InvalidPubkey(asn1.ASN1Error?)
    /// The AlgorithmIdentifier is malformed (INVALID_ALG, -0x3A80), with the
    /// ASN.1 error mbedtls adds to the code.
    InvalidAlg(asn1.ASN1Error?)
    /// The namedCurve is not a curve of the library
    /// (UNKNOWN_NAMED_CURVE, -0x3A00).
    UnknownNamedCurve
    /// The key type, field type or encryption scheme is not supported
    /// (FEATURE_UNAVAILABLE, -0x3980).
    FeatureUnavailable
    /// The signature verifies but is followed by more bytes
    /// (SIG_LEN_MISMATCH, -0x3900).
    SigLenMismatch
    /// The signature does not fit the given size (BUFFER_TOO_SMALL, -0x3880).
    BufferTooSmall
    /// An RSA failure (MBEDTLS_ERR_RSA_*, or an ASN.1 code of a PKCS#1 key).
    RSA(rsa.RSAError)
    /// An elliptic-curve failure (MBEDTLS_ERR_ECP_*).
    Ecp(ecp.EcpError)
    /// An ECDSA signature failure (MBEDTLS_ERR_ECP_*, plus the ASN.1 code of
    /// a malformed signature).
    ECDSA(ecdsa.ECDSAError)
    /// A bare ASN.1 failure (MBEDTLS_ERR_ASN1_*): a malformed specified
    /// curve, or an output buffer too small.
    Asn1(asn1.ASN1Error)
    /// A curve or algorithm with no OID (MBEDTLS_ERR_OID_NOT_FOUND).
    Oid(oids.OIDError)
    /// A malformed PEM block (MBEDTLS_ERR_PEM_*).
    PEM(pem.PEMError)
    /// PBES2 failed on an encrypted PKCS#8 key (MBEDTLS_ERR_PKCS5_*).
    PKCS5(pkcs5.PBEError)
    /// PKCS #12 PBE failed on an encrypted PKCS#8 key
    /// (MBEDTLS_ERR_PKCS12_*).
    PKCS12(pkcs5.PBEError)
}

// The ASN.1 and OID failures lift; RSA, EC and ECDSA ones are wrapped where
// they occur, as each of those also lifts the big-number failure ASN.1 does.
impl asn1.ASN1Error -> PKError { PKError.Asn1(self) }
impl oids.OIDError -> PKError { PKError.Oid(self) }

/// An RSA key held outside the library (mbedtls_pk_rsa_alt_*_func):
/// decrypt(input, output_max_len), sign(md, hash), and the modulus length
/// in bytes. The functions are pure, so the TLS engine can call them.
RSAAltKey: struct {
    decrypt: fn([U8], Int) -[]> [U8] PKError!
    sign: fn(hashes.Md?, [U8]) -[]> [U8] PKError!
    key_len: fn() -[]> Int
}

/// The RSASSA-PSS verification options (mbedtls_pk_rsassa_pss_options): the
/// MGF1 digest and the salt length, or rsa.SALT_LEN_ANY.
PSSOptions: struct {
    mgf1_hash_id: hashes.Md?
    expected_salt_len: Int
}

/// One value pk_debug shows (mbedtls_pk_debug_type).
PKDebugValue: enum {
    Mpi(bn.Mpi)
    Point(ecp.Point)
}

/// A named public value of a key (mbedtls_pk_debug_item).
PKDebugItem: struct {
    name: String
    value: PKDebugValue
}

/// A key (mbedtls_pk_context): its type, None until set up, and the RSA,
/// elliptic-curve or RSA-alt key that type uses.
PKContext: struct {
    kind: oids.PKType?
    rsa: rsa.RSAContext
    ec: ecp.Keypair
    alt: RSAAltKey?
}

/// A context with no key (mbedtls_pk_init).
pk_new: fn() -> PKContext Never! {
    PKContext{kind: None, rsa: rsa.rsa_new(), ec: ecp.keypair_new(), alt: None}
}

/// The type pk_setup takes for `kind`: RSA, EC, EC_DH and ECDSA have one,
/// RSA-alt is set up by pk_setup_rsa_alt and the rest by none
/// (mbedtls_pk_info_from_type).
pk_info_from_type: fn(kind: oids.PKType) -> oids.PKType? Never! {
    if kind == {
        .RSA -> Val(kind)
        .ECKey -> Val(kind)
        .ECKeyDH -> Val(kind)
        .ECDSA -> Val(kind)
        else -> None
    }
}

/// Give a context with no key the empty key of type `info`
/// (mbedtls_pk_setup). BadInput for no type, a type pk_info_from_type does
/// not give, or a context already set up.
pk_setup: fn(ctx: &PKContext, info: oids.PKType?) PKError! {
    given: info ?? return Err(.BadInput)
    kind: pk_info_from_type(given) ?? return Err(.BadInput)
    if ctx.kind != None -> return Err(.BadInput)
    ctx.kind = Val(kind)
    ctx.rsa = rsa.rsa_new()
    ctx.ec = ecp.keypair_new()
}

/// Make a context with no key an RSA-alt key (mbedtls_pk_setup_rsa_alt).
pk_setup_rsa_alt: fn(ctx: &PKContext, key: RSAAltKey) PKError! {
    if ctx.kind != None -> return Err(.BadInput)
    ctx.kind = Val(.RSAAlt)
    ctx.alt = Val(key)
}

/// Whether the key can do operations of type `kind`: RSA does RSA and
/// RSASSA-PSS, EC does EC, EC_DH and ECDSA, EC_DH does EC and EC_DH, ECDSA
/// and RSA-alt only their own (mbedtls_pk_can_do).
pk_can_do: fn(ctx: PKContext, kind: oids.PKType) -> Bool Never! {
    own: ctx.kind ?? return false
    if own == {
        .RSA -> kind == .RSA || kind == .RSASSAPSS
        .ECKey -> kind == .ECKey || kind == .ECKeyDH || kind == .ECDSA
        .ECKeyDH -> kind == .ECKey || kind == .ECKeyDH
        .ECDSA -> kind == .ECDSA
        .RSAAlt -> kind == .RSA
        else -> false
    }
}

/// The key's type, None when not set up (mbedtls_pk_get_type).
pk_get_type: fn(ctx: PKContext) -> oids.PKType? Never! { ctx.kind }

/// The key type's name, "invalid PK" when not set up (mbedtls_pk_get_name).
pk_get_name: fn(ctx: PKContext) -> String Never! {
    own: ctx.kind ?? return "invalid PK"
    if own == {
        .RSA -> "RSA"
        .ECKey -> "EC"
        .ECKeyDH -> "EC_DH"
        .ECDSA -> "ECDSA"
        .RSAAlt -> "RSA-alt"
        else -> "invalid PK"
    }
}

/// The key size in bits: the modulus of an RSA key, eight times the length
/// of an RSA-alt key, the field of an EC key; 0 when not set up
/// (mbedtls_pk_get_bitlen).
pk_get_bitlen: fn(ctx: PKContext) -> Int Never! {
    own: ctx.kind ?? return 0
    if own == {
        .RSA -> rsa.rsa_get_bitlen(ctx.rsa)
        .RSAAlt -> 8 * alt_key_len(ctx)
        else -> ctx.ec.grp.pbits
    }
}

/// The key size in bytes (mbedtls_pk_get_len).
pk_get_len: fn(ctx: PKContext) -> Int Never! { (pk_get_bitlen(ctx) + 7) /% 8 }

/// The curve of an EC, EC_DH or ECDSA key; Unknown for any other
/// (mbedtls_pk_get_ec_group_id).
pk_get_ec_group_id: fn(ctx: PKContext) -> ecp.GroupID Never! {
    own: ctx.kind ?? return .Unknown
    if own == {
        .ECKey -> ctx.ec.grp.id
        .ECKeyDH -> ctx.ec.grp.id
        .ECDSA -> ctx.ec.grp.id
        else -> .Unknown
    }
}

/// Whether the curve is one RFC 8410 encodes without parameters
/// (MBEDTLS_PK_IS_RFC8410_GROUP_ID).
is_rfc8410_group: fn(id: ecp.GroupID) -> Bool Never! { id == .Curve25519 || id == .Curve448 }

/// Whether the key is an X25519 or X448 key (mbedtls_pk_is_rfc8410).
pk_is_rfc8410: fn(ctx: PKContext) -> Bool Never! { is_rfc8410_group(pk_get_ec_group_id(ctx)) }

alt_key_len: fn(ctx: PKContext) -> Int Never! {
    alt: ctx.alt ?? return 0
    key_len: alt.key_len
    key_len()
}

/// Verify `sig` over `hash` (mbedtls_pk_verify). An RSA signature longer
/// than the modulus that verifies is SigLenMismatch, as is an ECDSA one
/// followed by more bytes.
pk_verify: fn(ctx: &PKContext, md: hashes.Md?, hash: [U8], sig: [U8]) PKError! {
    own: ctx.kind ?? return Err(.BadInput)
    if hash.len() == 0 -> return Err(.BadInput)
    if own == {
        .RSA -> rsa_verify_wrap(ctx.rsa, md, hash, sig)
        .ECKey | .ECDSA -> ecdsa_verify_wrap(ctx.ec, hash, sig)
        else -> return Err(.TypeMismatch)
    }
}

// rsa_verify_wrap: the signature is the modulus's length of bytes.
rsa_verify_wrap: fn(key: &rsa.RSAContext, md: hashes.Md?, hash: [U8], sig: [U8]) PKError! {
    if md == None && hash.len() > 0xFFFFFFFF -> return Err(.BadInput)
    rsa_len: key.len
    if sig.len() < rsa_len -> return Err(.RSA(.VerifyFailed))
    rsa.rsa_pkcs1_verify(key, md, hash, cipher.bytes_of(sig, 0, rsa_len)) ?? return Err(.RSA(err))
    if sig.len() > rsa_len -> return Err(.SigLenMismatch)
}

// ecdsa_verify_wrap: the digest is not used, only the hash.
ecdsa_verify_wrap: fn(key: ecp.Keypair, hash: [U8], sig: [U8]) PKError! {
    if ecdsa.ecdsa_read_signature(key, hash, sig) == {
        .Ok(_) -> {}
        .Err(e) -> {
            if e == .Ecp(.SigLenMismatch) -> return Err(.SigLenMismatch)
            return Err(.ECDSA(e))
        }
    }
}

/// Verify `sig` as a signature of type `kind`; RSASSA-PSS takes options,
/// any other type none (mbedtls_pk_verify_ext).
pk_verify_ext: fn(kind: oids.PKType, options: PSSOptions?, ctx: &PKContext, md: hashes.Md?, hash: [U8], sig: [U8]) PKError! {
    own: ctx.kind ?? return Err(.BadInput)
    if !pk_can_do(ctx, kind) -> return Err(.TypeMismatch)
    if kind == {
        .RSASSAPSS -> {
            if own != .RSA -> return Err(.FeatureUnavailable)
            if md == None && hash.len() > 0xFFFFFFFF -> return Err(.BadInput)
            opts: options ?? return Err(.BadInput)
            len: pk_get_len(ctx)
            if sig.len() < len -> return Err(.RSA(.VerifyFailed))
            rsa_len: ctx.rsa.len
            rsa.rsa_rsassa_pss_verify_ext(ctx.rsa, md, hash, opts.mgf1_hash_id, opts.expected_salt_len, cipher.bytes_of(sig, 0, rsa_len)) ?? return Err(.RSA(err))
            if sig.len() > len -> return Err(.SigLenMismatch)
        }
        else -> {
            if options == {
                .Val(_) -> return Err(.BadInput)
                .None -> {}
            }
            pk_verify(ctx, md, hash, sig)
        }
    }
}

/// Sign `hash`, the signature at most sig_size bytes: RSA with the key's
/// padding, ECDSA deterministically (RFC 6979) (mbedtls_pk_sign).
pk_sign: fn<R: RNG>(ctx: &PKContext, md: hashes.Md?, hash: [U8], sig_size: Int, rng: &R) -> [U8] PKError! {
    own: ctx.kind ?? return Err(.BadInput)
    if hash.len() == 0 -> return Err(.BadInput)
    if own == {
        .RSA -> rsa_sign_wrap(ctx.rsa, md, hash, sig_size, rng)
        .ECKey -> ecdsa_sign_wrap(ctx.ec, md, hash, sig_size, rng)
        .ECDSA -> ecdsa_sign_wrap(ctx.ec, md, hash, sig_size, rng)
        .RSAAlt -> rsa_alt_sign_wrap(ctx, md, hash, sig_size)
        else -> Err(.TypeMismatch)
    }
}

rsa_sign_wrap: fn<R: RNG>(key: &rsa.RSAContext, md: hashes.Md?, hash: [U8], sig_size: Int, rng: &R) -> [U8] PKError! {
    if md == None && hash.len() > 0xFFFFFFFF -> return Err(.BadInput)
    if sig_size < key.len -> return Err(.BufferTooSmall)
    sig: rsa.rsa_pkcs1_sign(key, rng, md, hash) ?? return Err(.RSA(err))
    Ok(sig)
}

// ecdsa_sign_wrap: deterministic ECDSA needs the digest; mbedtls refuses
// MD_NONE with ECP_BAD_INPUT_DATA.
ecdsa_sign_wrap: fn<R: RNG>(key: ecp.Keypair, md: hashes.Md?, hash: [U8], sig_size: Int, rng: &R) -> [U8] PKError! {
    digest: md ?? return Err(.ECDSA(.Ecp(.BadInput)))
    sig: ecdsa.ecdsa_write_signature(key, digest, hash, sig_size, rng) ?? return Err(.ECDSA(err))
    Ok(sig)
}

rsa_alt_sign_wrap: fn(ctx: PKContext, md: hashes.Md?, hash: [U8], sig_size: Int) -> [U8] PKError! {
    alt: ctx.alt ?? return Err(.BadInput)
    if hash.len() > 0xFFFFFFFF -> return Err(.BadInput)
    key_len: alt.key_len
    sig_len: key_len()
    if sig_len > PK_SIGNATURE_MAX_SIZE -> return Err(.BadInput)
    if sig_len > sig_size -> return Err(.BufferTooSmall)
    sign: alt.sign
    sig: sign(md, hash)
    Ok(sig)
}

/// Sign `hash` as a signature of type `kind`: RSASSA-PSS with the largest
/// salt whatever the key's padding, any other type as pk_sign
/// (mbedtls_pk_sign_ext).
pk_sign_ext: fn<R: RNG>(kind: oids.PKType, ctx: &PKContext, md: hashes.Md?, hash: [U8], sig_size: Int, rng: &R) -> [U8] PKError! {
    if ctx.kind == None -> return Err(.BadInput)
    if !pk_can_do(ctx, kind) -> return Err(.TypeMismatch)
    if kind != .RSASSAPSS -> return pk_sign(ctx, md, hash, sig_size, rng)
    if sig_size < pk_get_len(ctx) -> return Err(.BufferTooSmall)
    if hash.len() == 0 -> return Err(.BadInput)
    sig: rsa.rsa_rsassa_pss_sign_no_mode_check(ctx.rsa, rng, md, hash) ?? return Err(.RSA(err))
    Ok(sig)
}

/// Decrypt `input`, the plaintext at most osize bytes (mbedtls_pk_decrypt).
pk_decrypt: fn<R: RNG>(ctx: &PKContext, input: [U8], osize: Int, rng: &R) -> [U8] PKError! {
    own: ctx.kind ?? return Err(.BadInput)
    if own == .RSA {
        if input.len() != ctx.rsa.len -> return Err(.RSA(.BadInput(None)))
        out: rsa.rsa_pkcs1_decrypt(ctx.rsa, rng, input, osize) ?? return Err(.RSA(err))
        return Ok(out)
    }
    if own == .RSAAlt {
        alt: ctx.alt ?? return Err(.BadInput)
        if input.len() != alt_key_len(ctx) -> return Err(.RSA(.BadInput(None)))
        decrypt: alt.decrypt
        out: decrypt(input, osize)
        return Ok(out)
    }
    Err(.TypeMismatch)
}

/// Encrypt `input` under the key; the ciphertext, a modulus long, must fit
/// osize bytes (mbedtls_pk_encrypt).
pk_encrypt: fn<R: RNG>(ctx: &PKContext, input: [U8], osize: Int, rng: &R) -> [U8] PKError! {
    own: ctx.kind ?? return Err(.BadInput)
    if own != .RSA -> return Err(.TypeMismatch)
    if ctx.rsa.len > osize -> return Err(.RSA(.OutputTooLarge))
    out: rsa.rsa_pkcs1_encrypt(ctx.rsa, rng, input) ?? return Err(.RSA(err))
    Ok(out)
}

/// Check that `prv` is the private key of `public` (mbedtls_pk_check_pair):
/// both of one type, or an RSA-alt key checked against an RSA one by a
/// test signature.
pk_check_pair: fn<R: RNG>(public: &PKContext, prv: &PKContext, rng: &R) PKError! {
    pub_kind: public.kind ?? return Err(.BadInput)
    prv_kind: prv.kind ?? return Err(.BadInput)
    if prv_kind == {
        .RSA -> {
            if pub_kind != .RSA -> return Err(.TypeMismatch)
            rsa.rsa_check_pub_priv(public.rsa, prv.rsa) ?? return Err(.RSA(err))
        }
        .RSAAlt -> {
            if pub_kind != .RSA -> return Err(.TypeMismatch)
            rsa_alt_check_pair(public, prv) ?? return Err(err)
        }
        else -> {
            if pub_kind != prv_kind -> return Err(.TypeMismatch)
            ecp.check_pub_priv(public.ec, prv.ec, rng) ?? return Err(.Ecp(err))
        }
    }
}

// rsa_alt_check_pair: the sizes agree and the alt key's signature of 32
// bytes of 0x2a verifies under the public key.
rsa_alt_check_pair: fn(public: &PKContext, prv: PKContext) PKError! {
    if pk_get_bitlen(prv) != rsa.rsa_get_bitlen(public.rsa) -> return Err(.RSA(.KeyCheckFailed(None)))
    hash := [U8]{}
    loop _ in 0..<32 -> hash.push(U8{0x2a})
    sig: rsa_alt_sign_wrap(prv, None, hash, rsa.MPI_MAX_SIZE)
    if rsa_verify_wrap(public.rsa, None, hash, sig) == {
        .Ok(_) -> {}
        .Err(_) -> return Err(.RSA(.KeyCheckFailed(None)))
    }
}

/// The key's public values: N and E of RSA, Q of EC (mbedtls_pk_debug).
/// An RSA-alt key shows none: TypeMismatch.
pk_debug: fn(ctx: PKContext) -> [PKDebugItem] PKError! {
    own: ctx.kind ?? return Err(.BadInput)
    if own == .RSAAlt -> return Err(.TypeMismatch)
    if own == .RSA {
        return Ok([PKDebugItem]{
            PKDebugItem{name: "rsa.N", value: .Mpi(bn.copy_mpi(ctx.rsa.n))},
            PKDebugItem{name: "rsa.E", value: .Mpi(bn.copy_mpi(ctx.rsa.e))}
        })
    }
    Ok([PKDebugItem]{PKDebugItem{name: "eckey.Q", value: .Point(ecp.point_copy(ctx.ec.q))}})
}

// ---------------------------------------------------------------------------
// Elliptic-curve keys (pk_ecc.c)
// ---------------------------------------------------------------------------

/// Load curve `id` into an EC key; a key already on another curve is
/// KeyInvalidFormat (mbedtls_pk_ecc_set_group).
pk_ecc_set_group: fn(ctx: &PKContext, id: ecp.GroupID) PKError! {
    if ctx.ec.grp.id != .Unknown && ctx.ec.grp.id != id -> return Err(.KeyInvalidFormat(None))
    ctx.ec.grp = ecp.group_load(id) ?? return Err(.Ecp(err))
}

/// Read the private value `key` on the key's curve
/// (mbedtls_pk_ecc_set_key).
pk_ecc_set_key: fn(ctx: &PKContext, key: [U8]) PKError! {
    id: ctx.ec.grp.id
    if ecp.read_key(id, ctx.ec, key) == {
        .Ok(_) -> {}
        .Err(e) -> return Err(.KeyInvalidFormatEcp(e))
    }
}

/// Read the public point `point` and check it is on the key's curve
/// (mbedtls_pk_ecc_set_pubkey).
pk_ecc_set_pubkey: fn(ctx: &PKContext, point: [U8]) PKError! {
    ctx.ec.q = ecp.point_read_binary(ctx.ec.grp, point) ?? return Err(.Ecp(err))
    ecp.check_pubkey(ctx.ec.grp, ctx.ec.q) ?? return Err(.Ecp(err))
}

/// Set the public point to d G (mbedtls_pk_ecc_set_pubkey_from_prv).
pk_ecc_set_pubkey_from_prv: fn<R: RNG>(ctx: &PKContext, rng: &R) PKError! {
    ctx.ec.q = ecp.ecp_mul(ctx.ec.grp, ctx.ec.d, ctx.ec.grp.g, rng) ?? return Err(.Ecp(err))
}

#Test("A context is nothing until set up once, and each type does its own operations") {
    ctx := pk_new()
    assert(!pk_can_do(ctx, .RSA) && pk_get_bitlen(ctx) == 0 && pk_get_name(ctx) == "invalid PK" && pk_get_type(ctx) == None)
    assert(pk_setup(ctx, None) == .Err(.BadInput))
    assert(pk_setup(ctx, pk_info_from_type(.RSAAlt)) == .Err(.BadInput))
    pk_setup(ctx, pk_info_from_type(.ECKeyDH)) ?? panic("setup")
    assert(pk_setup(ctx, pk_info_from_type(.ECKey)) == .Err(.BadInput))
    assert(pk_get_name(ctx) == "EC_DH" && pk_can_do(ctx, .ECKey) && !pk_can_do(ctx, .ECDSA))
    assert(pk_verify(ctx, .SHA256, [U8]{1}, [U8]{2}) == .Err(.TypeMismatch))
    assert(pk_verify(ctx, .SHA256, [U8]{}, [U8]{2}) == .Err(.BadInput))
    if pk_debug(pk_new()) == {
        .Ok(_) -> panic("debug")
        .Err(e) -> assert(e == .BadInput)
    }
}
