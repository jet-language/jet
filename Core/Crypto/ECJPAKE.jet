// Private Core source part: elliptic-curve J-PAKE (Thread 1.0, RFC 8236).
//
// A port of mbedtls 3.6.7's ecjpake.c: the two-round password-authenticated
// key exchange of TLS-ECJPAKE, with Schnorr zero-knowledge proofs. Section
// numbers refer to the Thread v1.0 specification. The shared secret s only
// enters products through ecjpake_mul_secret, blinded by a random multiple
// of N, and points multiplied by a secret go through the blinded comb.
use {
    core
    cipher: __core_crypto_cipher
    bn: __core_crypto_bignum
    __core_crypto_bignum.[RNG]
    hashes: __core_crypto_md
    ecp: __core_crypto_ecp
}

/// The side of the exchange (mbedtls_ecjpake_role).
ECJPAKERole: enum {
    Client
    Server
}

/// An EC J-PAKE exchange (mbedtls_ecjpake_context): our private keys
/// xm1, xm2 and public keys pm1 = xm1 G, pm2 = xm2 G; the peer's round-one
/// keys pp1, pp2 and round-two key pp; the shared secret s.
ECJPAKEContext: struct {
    md: hashes.Md
    grp: ecp.EcpGroup
    role: ECJPAKERole
    point_format: ecp.PointFormat
    pm1: ecp.Point
    pm2: ecp.Point
    pp1: ecp.Point
    pp2: ecp.Point
    pp: ecp.Point
    xm1: bn.Mpi
    xm2: bn.Mpi
    s: bn.Mpi
}

/// A context for `role` over `md` and curve `id` with shared secret
/// `secret`, big-endian (mbedtls_ecjpake_setup).
ecjpake_setup: fn(role: ECJPAKERole, md: hashes.Md, id: ecp.GroupID, secret: [U8]) -> ECJPAKEContext ecp.EcpError! {
    grp: ecp.group_load(id)
    s: bn.read_binary(secret) ?? return Err(.Mpi(err))
    Ok(ECJPAKEContext{
        md: md, grp: grp, role: role, point_format: .Uncompressed,
        pm1: ecp.point_new(), pm2: ecp.point_new(), pp1: ecp.point_new(), pp2: ecp.point_new(), pp: ecp.point_new(),
        xm1: bn.mpi(), xm2: bn.mpi(), s: s,
    })
}

/// Encode points compressed or not (mbedtls_ecjpake_set_point_format).
ecjpake_set_point_format: fn(ctx: &ECJPAKEContext, format: ecp.PointFormat) Never! { ctx.point_format = format }

/// BadInput unless ctx has a curve and a secret (mbedtls_ecjpake_check).
ecjpake_check: fn(ctx: ECJPAKEContext) ecp.EcpError! {
    if ctx.grp.id == .Unknown || ctx.s.p.len() == 0 -> return Err(.BadInput)
}

/// Our identity in the proofs.
id_mine: fn(ctx: ECJPAKEContext) -> [U8] Never! {
    if ctx.role == .Client -> return "client".bytes().copy()
    "server".bytes().copy()
}

/// The peer's identity in the proofs.
id_peer: fn(ctx: ECJPAKEContext) -> [U8] Never! {
    if ctx.role == .Client -> return "server".bytes().copy()
    "client".bytes().copy()
}

/// MBEDTLS_ECP_MAX_PT_LEN three times with lengths, plus a 6-byte identity
/// and its length: the bound of the proof hash input (ECJPAKE_HASH_BUF_LEN).
HASH_BUF_LEN: 421

/// A big-endian 32-bit length.
push_u32: fn(out: &[U8], v: Int) Never! {
    out.push(U8{(v >> 24).bit_and(0xff)})
    out.push(U8{(v >> 16).bit_and(0xff)})
    out.push(U8{(v >> 8).bit_and(0xff)})
    out.push(U8{v.bit_and(0xff)})
}

/// A point after its 32-bit length, within `limit` bytes of out
/// (ecjpake_write_len_point).
write_len_point: fn(out: &[U8], limit: Int, grp: ecp.EcpGroup, format: ecp.PointFormat, pt: ecp.Point) ecp.EcpError! {
    if limit - out.len() < 5 -> return Err(.BufferTooSmall)
    bytes: ecp.point_write_binary(grp, pt, format, limit - out.len() - 4)
    push_u32(out, bytes.len())
    loop b in bytes -> out.push(b)
}

/// The proof challenge H(G, V, X, id) mod N (7.4.2.2.2.1).
ecjpake_hash: fn(md: hashes.Md, grp: ecp.EcpGroup, format: ecp.PointFormat, g: ecp.Point, v: ecp.Point, x: ecp.Point, id: [U8]) -> bn.Mpi ecp.EcpError! {
    buf := [U8]{}
    write_len_point(buf, HASH_BUF_LEN, grp, format, g)
    write_len_point(buf, HASH_BUF_LEN, grp, format, v)
    write_len_point(buf, HASH_BUF_LEN, grp, format, x)
    if HASH_BUF_LEN - buf.len() < 4 + id.len() -> return Err(.BufferTooSmall)
    push_u32(buf, id.len())
    loop b in id -> buf.push(b)
    digest: hashes.hash(md, buf)
    h: bn.read_binary(digest) ?? return Err(.Mpi(err))
    out: bn.mod_mpi(h, grp.n) ?? return Err(.Mpi(err))
    Ok(out)
}

/// Parse an ECSchnorrZKP { ECPoint V; opaque r<1..2^8-1>; } at p and check
/// it proves knowledge of log_G X: V = r G + h X (7.4.2.2.2, 7.4.2.3.3).
zkp_read: fn(md: hashes.Md, grp: ecp.EcpGroup, format: ecp.PointFormat, g: ecp.Point, x: ecp.Point, id: [U8], buf: [U8], p: &Int) ecp.EcpError! {
    end: buf.len()
    v: ecp.tls_read_point(grp, cipher.bytes_of(buf, p, end - p))
    p += v.used
    if end - p < 1 -> return Err(.BadInput)
    r_len: Int.from_u8(buf[p])
    p += 1
    if end - p < r_len || r_len == 0 -> return Err(.BadInput)
    r: bn.read_binary(cipher.bytes_of(buf, p, r_len)) ?? return Err(.Mpi(err))
    p += r_len
    h: ecjpake_hash(md, grp, format, g, v.pt, x, id)
    vv: ecp.ecp_muladd(grp, h, x, r, g)
    if !ecp.point_eq(vv, v.pt) -> return Err(.VerifyFailed)
}

/// A proof of knowledge of x = log_G X as an ECSchnorrZKP appended to out,
/// within `limit` bytes (7.4.2.3.2).
zkp_write: fn<R: RNG>(md: hashes.Md, grp: ecp.EcpGroup, format: ecp.PointFormat, g: ecp.Point, x: bn.Mpi, big_x: ecp.Point, id: [U8], out: &[U8], limit: Int, rng: &R) ecp.EcpError! {
    // r = v - x h mod N for an ephemeral (v, V = v G).
    pair: ecp.gen_keypair_base(grp, g, rng)
    h: ecjpake_hash(md, grp, format, g, pair.q, big_x, id)
    xh: bn.mul_mpi(h, x) ?? return Err(.Mpi(err))
    d: bn.sub_mpi(pair.d, xh) ?? return Err(.Mpi(err))
    r: bn.mod_mpi(d, grp.n) ?? return Err(.Mpi(err))
    pt: ecp.tls_write_point(grp, pair.q, format, limit - out.len())
    loop b in pt -> out.push(b)
    len: bn.size(r)
    if limit - out.len() < 1 + len || len > 255 -> return Err(.BufferTooSmall)
    out.push(U8{len})
    rb: bn.write_binary(r, len) ?? return Err(.Mpi(err))
    loop b in rb -> out.push(b)
}

/// Parse an ECJPAKEKeyKP { ECPoint X; ECSchnorrZKP zkp; } at p and check
/// its proof; the verified X (7.4.2.2.1).
kkp_read: fn(md: hashes.Md, grp: ecp.EcpGroup, format: ecp.PointFormat, g: ecp.Point, id: [U8], buf: [U8], p: &Int) -> ecp.Point ecp.EcpError! {
    x: ecp.tls_read_point(grp, cipher.bytes_of(buf, p, buf.len() - p))
    p += x.used
    if ecp.is_zero(x.pt) -> return Err(.InvalidKey)
    zkp_read(md, grp, format, g, x.pt, id, buf, p)
    Ok(x.pt.move())
}

/// A fresh key pair (x, X = x G) as an ECJPAKEKeyKP appended to out.
kkp_write: fn<R: RNG>(md: hashes.Md, grp: ecp.EcpGroup, format: ecp.PointFormat, g: ecp.Point, id: [U8], out: &[U8], limit: Int, rng: &R) -> (d: bn.Mpi, q: ecp.Point) ecp.EcpError! {
    pair: ecp.gen_keypair_base(grp, g, rng)
    pt: ecp.tls_write_point(grp, pair.q, format, limit - out.len())
    loop b in pt -> out.push(b)
    zkp_write(md, grp, format, g, pair.d, pair.q, id, out, limit, rng)
    Ok(pair)
}

/// Read the peer's round-one ECJPAKEKeyKPPairList, exactly all of buf
/// (mbedtls_ecjpake_read_round_one).
ecjpake_read_round_one: fn(ctx: &ECJPAKEContext, buf: [U8]) ecp.EcpError! {
    p := 0
    id: id_peer(ctx)
    ctx.pp1 = kkp_read(ctx.md, ctx.grp, ctx.point_format, ctx.grp.g, id, buf, p)
    ctx.pp2 = kkp_read(ctx.md, ctx.grp, ctx.point_format, ctx.grp.g, id, buf, p)
    if p != buf.len() -> return Err(.BadInput)
}

/// Our round-one ECJPAKEKeyKPPairList of two fresh key pairs, at most
/// limit bytes (mbedtls_ecjpake_write_round_one).
ecjpake_write_round_one: fn<R: RNG>(ctx: &ECJPAKEContext, limit: Int, rng: &R) -> [U8] ecp.EcpError! {
    out := [U8]{}
    id: id_mine(ctx)
    a: kkp_write(ctx.md, ctx.grp, ctx.point_format, ctx.grp.g, id, out, limit, rng)
    ctx.xm1 = a.d.move()
    ctx.pm1 = a.q.move()
    b: kkp_write(ctx.md, ctx.grp, ctx.point_format, ctx.grp.g, id, out, limit, rng)
    ctx.xm2 = b.d.move()
    ctx.pm2 = b.q.move()
    Ok(out)
}

/// A + B + C (ecjpake_ecp_add3).
add3: fn(grp: ecp.EcpGroup, a: ecp.Point, b: ecp.Point, c: ecp.Point) -> ecp.Point ecp.EcpError! {
    one: bn.from_int(1)
    ab: ecp.ecp_muladd(grp, one, a, one, b)
    abc: ecp.ecp_muladd(grp, one, ab, one, c)
    Ok(abc)
}

/// Read the peer's round-two ECJPAKEKeyKP, after the curve when a client
/// reads the server's, exactly all of buf (mbedtls_ecjpake_read_round_two;
/// C: 7.4.2.5, S: 7.4.2.6). Its base is G = Xm1 + Xm2 + Xp1.
ecjpake_read_round_two: fn(ctx: &ECJPAKEContext, buf: [U8]) ecp.EcpError! {
    g: add3(ctx.grp, ctx.pm1, ctx.pm2, ctx.pp1)
    p := 0
    if ctx.role == .Client {
        group: ecp.tls_read_group_id(buf)
        if group.id != ctx.grp.id -> return Err(.FeatureUnavailable)
        p = group.used
    }
    ctx.pp = kkp_read(ctx.md, ctx.grp, ctx.point_format, g, id_peer(ctx), buf, p)
    if p != buf.len() -> return Err(.BadInput)
}

/// sign X S mod N with S blinded as S + b N for a random 128-bit b
/// (ecjpake_mul_secret).
ecjpake_mul_secret: fn<R: RNG>(x: bn.Mpi, s: bn.Mpi, n: bn.Mpi, rng: &R, negate: Bool{false}) -> bn.Mpi ecp.EcpError! {
    b: bn.fill_random(16, rng) ?? return Err(.Mpi(err))
    bnn: bn.mul_mpi(b, n) ?? return Err(.Mpi(err))
    blinded: bn.add_mpi(bnn, s) ?? return Err(.Mpi(err))
    prod := bn.mul_mpi(x, blinded) ?? return Err(.Mpi(err))
    if negate -> prod.s = 0 - prod.s
    out: bn.mod_mpi(prod, n) ?? return Err(.Mpi(err))
    Ok(out)
}

/// Our round-two message: xm = xm2 s, Xm = xm G for G = Xp1 + Xp2 + Xm1,
/// as an ECJPAKEKeyKP after the curve when the server writes, at most limit
/// bytes (mbedtls_ecjpake_write_round_two; S: 7.4.2.5, C: 7.4.2.6).
ecjpake_write_round_two: fn<R: RNG>(ctx: &ECJPAKEContext, limit: Int, rng: &R) -> [U8] ecp.EcpError! {
    g: add3(ctx.grp, ctx.pp1, ctx.pp2, ctx.pm1)
    xm: ecjpake_mul_secret(ctx.xm2, ctx.s, ctx.grp.n, rng)
    big_xm: ecp.ecp_mul(ctx.grp, xm, g, rng)
    out := [U8]{}
    if ctx.role == .Server {
        group: ecp.tls_write_group(ctx.grp, limit)
        loop b in group -> out.push(b)
    }
    pt: ecp.tls_write_point(ctx.grp, big_xm, ctx.point_format, limit - out.len())
    loop b in pt -> out.push(b)
    zkp_write(ctx.md, ctx.grp, ctx.point_format, g, xm, big_xm, id_mine(ctx), out, limit, rng)
    Ok(out)
}

/// K = (Xp - Xp2 xm2 s) xm2 (7.4.2.7, 7.4.2.8).
derive_k: fn<R: RNG>(ctx: ECJPAKEContext, rng: &R) -> ecp.Point ecp.EcpError! {
    m: ecjpake_mul_secret(ctx.xm2, ctx.s, ctx.grp.n, rng, negate: true)
    one: bn.from_int(1)
    t: ecp.ecp_muladd(ctx.grp, one, ctx.pp, m, ctx.pp2)
    k: ecp.ecp_mul(ctx.grp, ctx.xm2, t, rng)
    Ok(k)
}

/// The premaster secret H(x(K)), BufferTooSmall when the digest exceeds
/// limit bytes (mbedtls_ecjpake_derive_secret).
ecjpake_derive_secret: fn<R: RNG>(ctx: ECJPAKEContext, limit: Int, rng: &R) -> [U8] ecp.EcpError! {
    if limit < hashes.md_size(ctx.md) -> return Err(.BufferTooSmall)
    k: derive_k(ctx, rng)
    kx := bn.write_binary(k.x, (ctx.grp.pbits + 7) /% 8) ?? return Err(.Mpi(err))
    pms: hashes.hash(ctx.md, kx)
    core.crypto.wipe(kx)
    Ok(pms)
}

/// K itself as an encoded point of at most limit bytes
/// (mbedtls_ecjpake_write_shared_key).
ecjpake_write_shared_key: fn<R: RNG>(ctx: ECJPAKEContext, limit: Int, rng: &R) -> [U8] ecp.EcpError! {
    k: derive_k(ctx, rng)
    out: ecp.point_write_binary(ctx.grp, k, ctx.point_format, limit)
    Ok(out)
}
