
package {
    name: "core.models"
    version: "0.1.0"
    edition: "2026"
    description: "On-disk model weights."
    license: "MIT"
    outputs: {
        models: .Library{ entry: models }
    }
}
// core.models — the compiler-owned model provider boundary.
//
// Model outputs are opened directly with
// `core.models.open<Trait>("output")`. Sema checks the literal output,
// source trait, package metadata, and provider contract before execution.
// This source package does not fabricate plain model handles or forward an
// unimplemented tensor-name dispatcher.
