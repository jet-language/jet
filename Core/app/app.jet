package {
    name: "app"
    version: "0.0.1"
    edition: "2026"
    description: "Process-level live queries, sync, and auth configuration."
    license: "MIT"
    outputs: {
        app: .Library{ entry: app }
    }
}
AUTH_MAX_PROVIDERS :: 64
// Process-wide live queries and sync sessions retain runtime-owned identity.
// Source publishes the vocabulary and delegates to that one ambient registry.
use app as provider

#Error
pub enum AppError {
    Invalid
    Unsupported
}

pub struct Auth {
    pub users_table: String
    pub providers: [String]
}

pub struct Session {
    pub id: String
    pub user_id: String
    pub cookie: String
    pub expires_at: Int
}

pub struct LiveQuery {}
pub fn auth(users_table: String) -> Auth Never! {
    Auth{users_table: canonical_table(users_table), providers: [String]{}}
}

pub fn auth_oauth(auth: Auth, providers: String) -> Auth Never! {
    configured := [String]{}
    loop comma_group in providers.split(",") {
        loop raw in comma_group.split(" ") {
            provider :: raw.trim()
            if valid_provider(provider) && !contains_string(configured, provider) && configured.len() < AUTH_MAX_PROVIDERS {
                &configured.push(~provider)
            }
        }
    }
    Auth{users_table: canonical_table(auth.users_table), providers: configured}
}

pub fn auth_routes(auth: Auth) -> String Never! {
    table := canonical_table(auth.users_table)
    routes := [String]{
        "POST /login -> password ({table})",
        "POST /logout -> revoke session",
        "GET /magic -> begin magic link",
        "POST /magic -> consume magic link",
    }
    providers := canonical_providers(auth.providers)
    loop provider in providers {
        &routes.push("GET /oauth/{provider}/begin")
        &routes.push("GET /oauth/{provider}/callback")
    }
    "AuthRoutes({routes.join("; ")})"
}

pub fn auth_show(auth: Auth) -> String Never! {
    table := canonical_table(auth.users_table)
    providers := canonical_providers(auth.providers)
    "Auth(users={table}, providers=[{providers.join(",")}])"
}
fn canonical_table(value: String) -> String {
    if valid_identifier(value) -> return ~value
    ""
}

fn canonical_providers(values: [String]) -> [String] {
    providers := [String]{}
    loop provider in values {
        if valid_provider(provider) && !contains_string(providers, provider) && providers.len() < AUTH_MAX_PROVIDERS {
            &providers.push(~provider)
        }
    }
    providers
}

pub fn live(key: String, data: String) -> LiveQuery Never! { provider.live(key, data) }

pub fn live_get(q: LiveQuery) -> String Never! { provider.live_get(q) }

pub fn live_show(q: LiveQuery) -> String Never! { provider.live_show(q) }

pub fn live_stats() -> String Never! { provider.live_stats() }

pub fn subscribe(source: String) -> LiveQuery Never! { provider.subscribe(source) }

pub fn invalidate(footprint: String) -> Int Never! { provider.invalidate(footprint) }

pub fn transact_invalidate(write_set: String) -> Int Never! { provider.transact_invalidate(write_set) }

pub fn signal_push(q: LiveQuery, payload: String) -> LiveQuery Never! { provider.signal_push(q, payload) }

pub fn sync(doc_show: String, over: String) -> String Never! { provider.sync(doc_show, over) }

fn valid_provider(value: String) -> Bool {
    if value == "" || value.len() > 64 -> return false
    loop byte in value.bytes() {
        n :: Int.from_u8(byte)
        allowed ::
            (n >= 48 && n <= 57) ||
            (n >= 65 && n <= 90) ||
            (n >= 97 && n <= 122) ||
            n == 95 || n == 45
        if !allowed -> return false
    }
    true
}

fn valid_identifier(value: String) -> Bool {
    trimmed :: value.trim()
    if trimmed == "" || trimmed.len() > 128 || value != trimmed -> return false
    loop byte in trimmed.bytes() {
        n :: Int.from_u8(byte)
        allowed ::
            (n >= 48 && n <= 57) ||
            (n >= 65 && n <= 90) ||
            (n >= 97 && n <= 122) ||
            n == 95
        if !allowed -> return false
    }
    true
}


fn contains_string(values: [String], value: String) -> Bool {
    loop item in values {
        if item == value -> return true
    }
    false
}
