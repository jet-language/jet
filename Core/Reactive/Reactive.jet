package: {
    name: "core.reactive"
    version: "0.0.1"
    edition: "2026"
    description: "Signals, derived values, and effects."
    license: "MIT"
    outputs: {
        reactive: .Library{ entry: reactive }
    }
}
loadable: module

// Reactive values are immutable Jet carriers. `signal` builds a fresh cell at
// version 0; the runtime provider owns the retained `computed`, `derived` and
// `effect` closures, which return shared, dependency-tracked cells; keeping
// the transition rules here makes the source-level API deterministic as well.
Signal: struct<T> {
    value: T
    version: Int
}

Computed: struct<T> {
    value: T
    version: Int
}

Derived: struct<T> {
    value: T
    version: Int
}

Effect: struct {
    last: Int
    active: Bool
}

unsubscribe: fn(e: Effect) -> Effect Never! {
    Effect{last: e.last, active: false}
}

is_active: fn(e: Effect) -> Bool Never! { e.active }

signal: fn<T>(value: T) -> Signal<T> Never! {
    Signal<T>{value: value, version: 0}
}

set: fn<T>(sig: Signal<T>, value: T) -> Signal<T> Never! {
    Signal<T>{value: value, version: sig.version + 1}
}

set_if_changed: fn(sig: Signal<Int>, value: Int) -> Signal<Int> Never! {
    if sig.value == value -> return sig.copy()
    set(sig, value)
}

changed: fn(sig: Signal<Int>, value: Int) -> Bool Never! { sig.value != value }

computed_update: fn(c: Computed<Int>, delta: Int) -> Computed<Int> Never! {
    computed_set(c, c.value + delta)
}

computed_version: fn<T>(c: Computed<T>) -> Int Never! { c.version }

effect_run_if: fn(e: Effect, value: Int) -> Effect Never! {
    if e.active && e.last == value -> return e.copy()
    effect_run(e, value)
}

effect_changed: fn(e: Effect, value: Int) -> Bool Never! { !e.active || e.last != value }

get: fn<T>(sig: Signal<T>) -> T Never! { sig.value }

version: fn<T>(sig: Signal<T>) -> Int Never! { sig.version }

update: fn(sig: Signal<Int>, delta: Int) -> Signal<Int> Never! { set(sig, sig.value + delta) }

computed_get: fn<T>(c: Computed<T>) -> T Never! { c.value }

computed_set: fn<T>(c: Computed<T>, value: T) -> Computed<T> Never! {
    Computed<T>{value: value, version: c.version + 1}
}

effect_run: fn(e: Effect, value: Int) -> Effect Never! {
    if !e.active || e.last != value -> return Effect{last: value, active: true}
    e.copy()
}

effect_last: fn(e: Effect) -> Int Never! { e.last }
