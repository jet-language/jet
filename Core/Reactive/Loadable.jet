// core.reactive.loadable — bounded async slot states.
// The provider owns scheduling and transport; this carrier owns the legal
// state transitions and never manufactures a success value from an error.
Loadable: enum<T, E> {
    Idle
    Loading
    Loaded(T)
    Failed(E)
}

idle: fn<T, E>() -> Loadable<T, E> Never! { Loadable.Idle }

loading: fn<T, E>() -> Loadable<T, E> Never! { Loadable.Loading }

loaded: fn<T, E>(value: T) -> Loadable<T, E> Never! { Loadable.Loaded(value) }

failed: fn<T, E>(reason: E) -> Loadable<T, E> Never! { Loadable.Failed(reason) }

is_idle: fn<T, E>(state: Loadable<T, E>) -> Bool Never! {
    if state == {
        .Idle -> true
        else -> false
    }
}
is_loading: fn<T, E>(state: Loadable<T, E>) -> Bool Never! {
    if state == {
        .Loading -> true
        else -> false
    }
}
is_loaded: fn<T, E>(state: Loadable<T, E>) -> Bool Never! {
    if state == {
        .Loaded(_) -> true
        else -> false
    }
}
is_failed: fn<T, E>(state: Loadable<T, E>) -> Bool Never! {
    if state == {
        .Failed(_) -> true
        else -> false
    }
}

value: fn<T, E>(state: Loadable<T, E>) -> T? Never! {
    if state == {
        .Loaded(value) -> Val(value)
        else -> None
    }
}

reason: fn<T, E>(state: Loadable<T, E>) -> E? Never! {
    if state == {
        .Failed(message) -> Val(message)
        else -> None
    }
}

// Retry starts a fresh attempt only from an idle or failed state.  A loaded
// result is stable, and retrying an in-flight request must not discard it.
retry: fn<T, E>(state: Loadable<T, E>) -> Loadable<T, E> Never! {
    if is_failed<T, E>(state) || is_idle<T, E>(state) -> return Loadable.Loading
    state.copy()
}
