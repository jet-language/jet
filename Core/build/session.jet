// Private compiler service linkage, not a second public Build API. The trusted
// build/comptime wrapper binds these symbols after ordinary checking. Handles
// remain the compiler's BuildContext/BuildPlan/BuildAction/... nominal values.
// Source owns session mutation, validation and projection on every tier.
use core.crypto as build_crypto
use core.build.[BuildGraph, BuildGraphTarget, BuildGraphAction, BuildGraphActionKey, BuildGraphFile, BuildGraphNode, BuildGraphInputDigest]

priv struct BuildSessionPolicy {
    legacy_denied: String?
    plugins_denied: String?
    plugin_grants: [String:[String]]
}

priv enum BuildSessionValue {
    Unit
    Text(value: String)
    Bool(value: Bool)
    Int(value: Int)
    Char(value: Char)
    Enum(variant: String)
    List(values: [BuildSessionValue])
    Handle(type_name: String, session: Int, id: Int)
    Span(start: Int, end: Int)
}

priv struct BuildSessionDiagnostic {
    code: String
    what: String
    why: String
    fix: String
    start: Int
    end: Int
}

priv enum BuildSessionReply {
    Value(value: BuildSessionValue)
    Failure(error: BuildSessionDiagnostic)
    HostRequest(method: String, args: [BuildSessionValue])
}

priv struct BuildSessionGeneratedModule {
    name: String
    path: String
    source: String
    source_digest: String
    plugin: Int?
}

priv struct BuildSessionContribution {
    key: String
    value: BuildSessionValue
    source: String
    start: Int
    end: Int
}

priv struct BuildSessionToolchain {
    name: String
    role: String
    host_triple: String
    target_triple: String
    sdk: String?
    linker: String?
    sysroot: String?
}

priv struct BuildSessionProbe {
    name: String
    kind: String
    value: String
    code: String
    reproducibility: String
    toolchain: Int
}

priv struct BuildSessionSigning {
    name: String
    label: String
}

priv struct BuildSessionPlugin {
    name: String
    version: String
    api_version: String
    component_digest: String
    grants: [String]
}

priv struct BuildSessionAction {
    name: String
    inputs: [String]
    outputs: [String]
    argv: [String]
    caps: [String]
    toolchain: Int
    probes: [Int]
    signing: Int?
    kind: String
    pools: [String]
    env: [String:String]
    env_allowlist: [String]
    helpers: [String:String]
    labels: [String:String]
    cache: String
    legacy: String?
    plugin: Int?
    compiler_owned: Bool{false}
    variant_identity: String?{None}
}

priv struct BuildSessionTarget {
    name: String
    kind: String
    sources: [String]
    inputs: [String]
    outputs: [String]
    actions: [Int]
    deps: [Int]
    probes: [Int]
    toolchain: Int
    signing: Int?
    metadata: [String:String]
    plugin: Int?
}

priv struct BuildSessionState {
    id: Int
    active: Bool
    package: String
    compiler_version: String
    policy: BuildSessionPolicy
    actions: [BuildSessionAction]
    targets: [BuildSessionTarget]
    toolchains: [BuildSessionToolchain]
    signing: [BuildSessionSigning]
    probes: [BuildSessionProbe]
    plugins: [BuildSessionPlugin]
    generated: [BuildSessionGeneratedModule]
    contributions: [BuildSessionContribution]
    diagnostics: [BuildSessionDiagnostic]
    nodes: [BuildGraphNode]
    start: Int
    end: Int
}

priv struct BuildSession { storage: Shared<BuildSessionState> }

priv fn build_session_new(session_id: Int, package: String, compiler_version: String, policy: BuildSessionPolicy) -> BuildSession Never! {
    {storage: shared BuildSessionState{
        id: session_id, active: true, package: package, compiler_version: compiler_version, policy: policy,
        actions: [BuildSessionAction]{}, targets: [BuildSessionTarget]{},
        toolchains: [BuildSessionToolchain]{{name: "host", role: "host", host_triple: "host", target_triple: "host", sdk: None, linker: None, sysroot: None}},
        signing: [BuildSessionSigning]{}, probes: [BuildSessionProbe]{}, plugins: [BuildSessionPlugin]{},
        generated: [BuildSessionGeneratedModule]{}, contributions: [BuildSessionContribution]{},
        diagnostics: [BuildSessionDiagnostic]{}, nodes: [BuildGraphNode]{}, start: 0, end: 0,
    }}
}

priv fn build_session_abort(session: &BuildSession) -> Void Never! {
    permit := session.storage.guard_edit()
    permit.value.active = false
}

priv fn build_session_diag(state: BuildSessionState, what: String) -> BuildSessionDiagnostic {
    {code: "E3502", what: what, why: "build plans require typed, declared graph facts", fix: "correct the declared build inputs", start: state.start, end: state.end}
}

priv fn build_session_fail(state: BuildSessionState, what: String) -> BuildSessionReply {
    .Failure(build_session_diag(state, what))
}

priv fn build_session_text(args: [BuildSessionValue], index: Int) -> String? {
    if index < args.len() && args[index] == .Text(text) -> return Val(text)
    None
}

priv fn build_session_strings(args: [BuildSessionValue], index: Int) -> [String]? {
    if index >= args.len() -> return None
    if args[index] == .List(values) {
        out := [String]{}
        loop value in values {
            if value == {.Text(text) -> &out.push(text) else -> return None}
        }
        return Val(out)
    }
    None
}

priv fn build_session_handle(state: BuildSessionState, value: BuildSessionValue, kind: String) -> Int? {
    if value == .Handle(type_name, session, id) {
        if type_name != kind || session != state.id -> return None
        if kind == "BuildPlan" && id >= -1 && id < state.targets.len() -> return Val(id)
        if id < 0 -> return None
        count :: if kind == {
            "BuildAction" -> state.actions.len()
            "BuildTarget" -> state.targets.len()
            "BuildToolchain" -> state.toolchains.len()
            "BuildProbe" -> state.probes.len()
            "BuildSigningIdentity" -> state.signing.len()
            else -> 0
        }
        if id < count -> return Val(id)
    }
    None
}

priv fn build_session_handles(state: BuildSessionState, args: [BuildSessionValue], index: Int, kind: String) -> [Int]? {
    if index >= args.len() -> return None
    if args[index] == .List(values) {
        out := [Int]{}
        loop value in values -> &out.push(build_session_handle(state, value, kind) ?? return None)
        return Val(out)
    }
    None
}

priv fn build_session_path(path: String) -> Bool {
    if path.trim() == "" || path.starts_with("/") -> return false
    loop part in path.split("/") { if part == ".." -> return false }
    true
}

priv fn build_session_paths(paths: [String]) -> Bool {
    loop path in paths { if !build_session_path(path) -> return false }
    true
}

priv fn build_session_map(entries: [String]) -> [String:String]? {
    out := [String:String]{}
    loop entry in entries {
        parts :: entry.split_once("=") ?? return None
        out[parts.before] = parts.after
    }
    Val(out)
}

priv fn build_session_unique(values: [String]) -> [String] {
    out := [String]{}
    loop value in values -> build_session_append_unique(&out, value)
    &out.sort()
    out
}

priv fn build_session_caps(values: [String]) -> [String]? {
    // Rust BuildEffect declaration order, not lexical string order.
    out := [String]{}
    normalized := [String]{}
    loop value in values {
        if value.contains(".") -> return None
        lower :: value.to_lower()
        if !build_session_contains_string([String]{"net", "fs", "io", "db", "time", "rand", "env", "exec", "log", "gpu"}, lower) -> return None
        build_session_append_unique(&normalized, lower)
    }
    loop flag in [String]{"net", "fs", "io", "db", "time", "rand", "env", "exec", "log", "gpu"} {
        if build_session_contains_string(normalized, flag) -> &out.push(flag)
    }
    Val(out)
}

priv fn build_session_pools(values: [String]) -> [String] {
    known :: [String]{"cpu", "memory", "linker", "console", "gpu"}
    out := [String]{}
    custom := [String]{}
    loop value in values {
        lower :: value.to_lower()
        if build_session_contains_string(known, lower) -> build_session_append_unique(&out, lower)
        else -> build_session_append_unique(&custom, value)
    }
    ordered := [String]{}
    loop value in known { if build_session_contains_string(out, value) -> &ordered.push(value) }
    &custom.sort()
    loop value in custom -> &ordered.push(value)
    ordered
}

priv fn build_session_kind(value: String) -> String? {
    lower :: value.to_lower()
    if lower == "source_archive" -> return Val("source-archive")
    if build_session_contains_string([String]{"compile", "docs", "debug", "source-archive", "generic"}, lower) -> return Val(lower)
    None
}

priv fn build_session_call(session: &BuildSession, method: String, args: [BuildSessionValue], generated_source: String?, in_impure_gate: Bool, start: Int, end: Int) -> BuildSessionReply Never! {
    permit := session.storage.guard_edit()
    state := &permit.value
    state.start = start
    state.end = end
    if !state.active -> return build_session_fail(state, "build context expired")
    if method == "action" || method == "legacy" {
        index :: if method == "action" -> 4 else -> 5
        caps :: build_session_strings(args, index) ?? return build_session_fail(state, "build action effects must be a list of strings")
        if caps.len() > 0 && !in_impure_gate -> return build_session_fail(state, "`b.{method}` touches the ambient world and must be inside `#Impure(\"reason\")`")
        return build_session_add_action(state, method, args)
    }
    if method.starts_with("add_") -> return build_session_add_target(state, method, args)
    if method == "toolchain" -> return build_session_add_toolchain(state, args)
    if method == "signing" -> return build_session_add_signing(state, args)
    if method == "probe" -> return build_session_add_probe(state, args, in_impure_gate)
    if method == "generate" {
        if args.len() != 1 -> return build_session_fail(state, "`b.generate` requires a name and typed item block")
        name :: build_session_text(args, 0) ?? return build_session_fail(state, "generated module name must be a string")
        source :: generated_source ?? return build_session_fail(state, "`b.generate` requires a typed item block; source strings are retired")
        path :: ".jet/generated/{state.package}/{build_session_safe_name(name)}.jet"
        return build_session_add_generated(state, BuildSessionGeneratedModule{name: name, path: path, source: source, source_digest: "", plugin: None})
    }
    if method == "plan" {
        if args.len() > 1 -> return build_session_fail(state, "`b.plan` accepts zero or one default target")
        default := -1
        if args.len() == 1 -> default = build_session_handle(state, args[0], "BuildTarget") ?? return build_session_fail(state, "default target does not belong to this build")
        return .Value(.Handle("BuildPlan", state.id, default))
    }
    if method == "contribute" {
        if args.len() != 2 -> return build_session_fail(state, "`b.contribute` requires a fact name and one value")
        name :: build_session_text(args, 0) ?? return build_session_fail(state, "build fact name must be a string")
        if name.trim() == "" || name.contains(".") -> return build_session_fail(state, "`b.contribute` needs one declared setting name, such as `cache_slots`")
        if args[1] == {.Bool(_) | .Int(_) | .Char(_) | .Text(_) | .Enum(_) -> {} else -> return build_session_fail(state, "`b.contribute` accepts only Bool, Int, Char, String, or a fieldless enum value")}
        &state.contributions.push(BuildSessionContribution{key: "Build.Settings.{name}", value: args[1], source: "{state.package}::build", start: start, end: end})
        return .Value(.Unit)
    }
    if method == "error" -> return build_session_project_error(state, args)
    if method == "plugin" {
        if args.len() != 2 || build_session_text(args, 0) == None || build_session_text(args, 1) == None -> return build_session_fail(state, "`b.plugin` requires manifest and component paths")
        if !in_impure_gate -> return build_session_fail(state, "`b.plugin` touches the ambient world and must be inside `#Impure(\"reason\")`")
        if state.policy.plugins_denied != None -> return build_session_fail(state, "wasm build plugin denied: {state.policy.plugins_denied ?? ""}")
        return .HostRequest(method, args)
    }
    // These calls use the existing locked input host service; no graph action
    // is run and no generated source is written by this request.
    if method == "find" || method == "embed" || method == "fetch" -> return .HostRequest(method, args)
    build_session_fail(state, "unknown build method `{method}`")
}

priv fn build_session_safe_name(name: String) -> String {
    bytes := [U8]{}
    loop byte in name.bytes() {
        n :: Int.from_u8(byte)
        if (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 95 || n == 45 -> &bytes.push(byte)
        else if n < 128 || n >= 192 -> &bytes.push(U8{95})
    }
    String.from_bytes(bytes) ?? panic("invalid generated module name")
}

priv fn build_session_add_generated(state: &BuildSessionState, module: BuildSessionGeneratedModule) -> BuildSessionReply {
    if module.name.trim() == "" || module.path.trim() == "" || module.source.trim() == "" -> return build_session_fail(state, "generated module `{module.name}` has an empty field")
    if !module.path.starts_with(".jet/generated/") || !module.path.ends_with(".jet") || !build_session_path(module.path) -> return build_session_fail(state, "invalid generated module path `{module.path}`")
    loop action in state.actions { if build_session_contains_string(action.outputs, module.path) -> return build_session_fail(state, "generated module `{module.name}` at `{module.path}` overlaps an action output") }
    loop old in state.generated {
        if old.name == module.name -> return build_session_fail(state, "duplicate generated module name `{module.name}`")
        if old.path == module.path -> return build_session_fail(state, "duplicate generated module path `{module.path}`")
    }
    checked := module
    checked.source_digest = "sha256:{build_crypto.sha256(checked.source.bytes()).hex()}"
    &state.generated.push(checked)
    .Value(.Unit)
}

priv fn build_session_add_toolchain(state: &BuildSessionState, args: [BuildSessionValue]) -> BuildSessionReply {
    if args.len() < 2 || args.len() > 6 -> return build_session_fail(state, "`b.toolchain` accepts two through six string arguments")
    texts := [String]{}
    loop index in 0..<args.len() -> &texts.push(build_session_text(args, index) ?? return build_session_fail(state, "toolchain fields must be strings"))
    name :: texts[0]
    if name.trim() == "" -> return build_session_fail(state, "empty toolchain name")
    loop old in state.toolchains { if old.name == name -> return build_session_fail(state, "duplicate toolchain name `{name}`") }
    host :: if texts.len() >= 3 -> texts[2] else -> "host"
    if texts[1].trim() == "" || host.trim() == "" -> return build_session_fail(state, "toolchain `{name}` has an empty triple")
    loop index in 3..<texts.len() { if texts[index].trim() == "" -> return build_session_fail(state, "toolchain `{name}` has an empty identity field") }
    id :: state.toolchains.len()
    &state.toolchains.push(BuildSessionToolchain{name: name, role: "target", target_triple: texts[1], host_triple: host, sdk: if texts.len() >= 4 -> Val(texts[3]) else -> None, linker: if texts.len() >= 5 -> Val(texts[4]) else -> None, sysroot: if texts.len() >= 6 -> Val(texts[5]) else -> None})
    .Value(.Handle("BuildToolchain", state.id, id))
}

priv fn build_session_add_signing(state: &BuildSessionState, args: [BuildSessionValue]) -> BuildSessionReply {
    if args.len() != 2 -> return build_session_fail(state, "`b.signing` requires name and label")
    name :: build_session_text(args, 0) ?? return build_session_fail(state, "signing name must be a string")
    label :: build_session_text(args, 1) ?? return build_session_fail(state, "signing label must be a string")
    if name.trim() == "" || label.trim() == "" -> return build_session_fail(state, "signing identity has an empty field")
    loop old in state.signing { if old.name == name -> return build_session_fail(state, "duplicate signing identity name `{name}`") }
    id :: state.signing.len()
    &state.signing.push(BuildSessionSigning{name: name, label: label})
    .Value(.Handle("BuildSigningIdentity", state.id, id))
}

priv fn build_session_add_probe(state: &BuildSessionState, args: [BuildSessionValue], in_impure_gate: Bool) -> BuildSessionReply {
    if args.len() < 3 || args.len() > 6 -> return build_session_fail(state, "`b.probe` accepts three through six arguments")
    name :: build_session_text(args, 0) ?? return build_session_fail(state, "probe name must be a string")
    kind :: build_session_text(args, 1) ?? return build_session_fail(state, "probe kind must be a string")
    value :: build_session_text(args, 2) ?? return build_session_fail(state, "probe value must be a string")
    reproducible_gate := false
    loop index in 0..<args.len() { if index + 2 >= args.len() && args[index] == .Text(text) { if text.to_lower() == "reproducible" -> reproducible_gate = true } }
    if !reproducible_gate && !in_impure_gate -> return build_session_fail(state, "`b.probe` touches the ambient world and must be inside `#Impure(\"reason\")`")
    if name.trim() == "" || value.trim() == "" -> return build_session_fail(state, "probe has an empty field")
    loop old in state.probes { if old.name == name -> return build_session_fail(state, "duplicate probe name `{name}`") }
    code := ""
    control := 3
    if kind == "compile_check" {
        if args.len() < 4 -> return build_session_fail(state, "compile_check requires source code")
        code = build_session_text(args, 3) ?? return build_session_fail(state, "compile_check source must be a string")
        if code.trim() == "" -> return build_session_fail(state, "compile_check source cannot be empty")
        control = 4
    } else {
        if !build_session_contains_string([String]{"find_program", "pkg_config", "header"}, kind) -> return build_session_fail(state, "unknown typed probe kind `{kind}`")
        if args.len() > 5 -> return build_session_fail(state, "non-compile probes accept at most one reproducibility value and one toolchain")
    }
    if kind == "header" {
        invalid := !build_session_path(value)
        loop byte in value.bytes() {
            if byte == U8{0} || byte == U8{10} || byte == U8{13} || byte == U8{34} || byte == U8{60} || byte == U8{62} -> invalid = true
        }
        if invalid -> return build_session_fail(state, "invalid header probe name `{value}`")
    }
    reproducibility := "ambient"
    toolchain := 0
    if control < args.len() {
        if args[control] == .Text(text) {
            reproducibility = text.to_lower()
            if reproducibility != "ambient" && reproducibility != "reproducible" -> return build_session_fail(state, "probe reproducibility must be `ambient` or `reproducible`")
            control += 1
        }
        if control < args.len() -> toolchain = build_session_handle(state, args[control], "BuildToolchain") ?? return build_session_fail(state, "probe toolchain does not belong to this build")
    }
    // All source probe constructors use ambient-record provenance without a
    // lock. Rust rejects reproducible classification on these same values.
    if reproducibility == "reproducible" -> return build_session_fail(state, "probe `{name}` requires locked provenance")
    id :: state.probes.len()
    &state.probes.push(BuildSessionProbe{name: name, kind: kind, value: value, code: code, reproducibility: reproducibility, toolchain: toolchain})
    .Value(.Handle("BuildProbe", state.id, id))
}

priv fn build_session_project_error(state: &BuildSessionState, args: [BuildSessionValue]) -> BuildSessionReply {
    if args.len() != 5 -> return build_session_fail(state, "`b.error` requires SourceSpan, code, what, why, and fix")
    start := state.start
    end := state.end
    if args[0] == {.Span(first, last) -> { start = first end = last } else -> return build_session_fail(state, "argument 1 must be SourceSpan")}
    code :: build_session_text(args, 1) ?? return build_session_fail(state, "build rule code must be a string")
    what :: build_session_text(args, 2) ?? return build_session_fail(state, "build rule what must be a string")
    why :: build_session_text(args, 3) ?? return build_session_fail(state, "build rule why must be a string")
    fix :: build_session_text(args, 4) ?? return build_session_fail(state, "build rule fix must be a string")
    reserved := code.len() > 1 && (code.starts_with("E") || code.starts_with("W"))
    bytes :: code.bytes()
    loop index in 1..<bytes.len() { if bytes[index] < (U8{48}) || bytes[index] > (U8{57}) -> reserved = false }
    diagnostic := BuildSessionDiagnostic{code: code, what: what, why: why, fix: fix, start: start, end: end}
    if reserved {
        diagnostic = BuildSessionDiagnostic{code: "E3530", what: "build rule code `{code}` is reserved", why: "codes beginning with E or W followed only by digits belong to the compiler", fix: "use a project prefix such as `ORG01`", start: start, end: end}
    } else if code.trim() == "" || what.trim() == "" || why.trim() == "" || fix.trim() == "" {
        diagnostic = build_session_diag(state, "build rule errors require non-empty code, what, why, and fix")
    }
    &state.diagnostics.push(diagnostic)
    .Value(.Unit)
}

priv fn build_session_contains_string(values: [String], value: String) -> Bool Never! {
    loop item in values { if item == value -> return true }
    false
}
priv fn build_session_append_unique(values: &[String], value: String) Never! {
    if !build_session_contains_string(values, value) -> &values.push(value)
}
