package {
    name: "core.mem"
    version: "0.0.1"
    edition: "2026"
    description: "Arenas, pins, atomics, and volatile access."
    license: "MIT"
    outputs: {
        mem: .Library{ entry: mem }
    }
}
module scope
use core as core
use core.mem as mem
#Error
pub struct AllocError {
    pub requested_bytes: Int
    pub allocator: String
}

// Allocator and pointer values are compiler-owned nominal surfaces. Their
// constructors and methods are lowered by the memory CoreLib; source keeps
// only the canonical type arities, never a fake runtime state carrier.
pub struct Arena {}

pub struct Bump {}

pub struct Fixed {}

pub struct Pool<T> {}

pub struct Pin<T> {}


pub fn address_of<T>(value: T) -> Int Never! { core.mem.address_of<T>(value) }

#Unsafe("`addr` is the address of a live, aligned `T` that stays valid for every use of the returned pointer") pub fn from_addr<T>(addr: Int) -> *T Never! {
    mem.Ptr<T>.from_addr(addr)
}

#Unsafe("`pointer` names a live, aligned, readable `T` for the whole access") pub fn volatile_read<T>(pointer: *T) -> T Never! {
    core.mem.volatile_read<T>(pointer)
}

#Unsafe("`pointer` names a live, aligned, writable `T` for the whole access") pub fn volatile_write<T>(pointer: *T, value: T) Never! {
    core.mem.volatile_write<T>(pointer, value)
}
