package {
    name: "core.mem"
    version: "0.0.1"
    edition: "2026"
    description: "Arenas, pins, atomics, and volatile access."
    license: "MIT"
    outputs: {
        mem: .Library{ entry: mem }
    }
}
module scope
use core as core
use core.mem as mem
#Error
struct AllocError {
    requested_bytes: Int
    allocator: String
}

// Allocator and pointer values are compiler-owned nominal surfaces. Their
// constructors and methods are lowered by the memory CoreLib; source keeps
// only the canonical type arities, never a fake runtime state carrier.
struct Arena {}

struct Bump {}

struct Fixed {}

struct Pool<T> {}

struct Pin<T> {}


#Unsafe("`addr` is the address of a live, aligned `T` that stays valid for every use of the returned pointer") fn from_addr<T>(addr: Int) -> *T Never! {
    // INTERIM (self-host cut, card #4971): the Jet-authored parser has no
    // `alias.Ptr<T>.from_addr(addr)` form yet, and the embedded Core must parse.
    panic("mem.from_addr is unavailable until the native parser reads `mem.Ptr<T>.from_addr` (card #4971)")
}

#Unsafe("`pointer` names a live, aligned, readable `T` for the whole access") fn volatile_read<T>(pointer: *T) -> T Never! {
    core.mem.volatile_read<T>(pointer)
}

#Unsafe("`pointer` names a live, aligned, writable `T` for the whole access") fn volatile_write<T>(pointer: *T, value: T) Never! {
    core.mem.volatile_write<T>(pointer, value)
}

// Encoding stream storage uses the canonical private __list_capacity,
// __list_reserve_exact, and __type_size kernels. They are compiler-typed raw
// layout/capacity operations, not public aliases or source wrappers.

