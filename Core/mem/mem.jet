package {
    name: "core.mem"
    version: "0.0.1"
    edition: "2026"
    description: "Arenas, pins, atomics, and volatile access."
    license: "MIT"
    outputs: {
        mem: .Library{ entry: mem }
    }
}
module scope
module runtime
use core as core
use core.mem as mem
#Error
pub struct AllocError {
    pub requested_bytes: Int
    pub allocator: String
}

// Allocator and pointer values are compiler-owned nominal surfaces. Their
// constructors and methods are lowered by the memory CoreLib; source keeps
// only the canonical type arities, never a fake runtime state carrier.
pub struct Arena {}

pub struct Bump {}

pub struct Fixed {}

pub struct Pool<T> {}

pub struct Pin<T> {}


pub fn address_of<T>(value: T) -> Int Never! { core.mem.address_of<T>(value) }

pub fn from_addr<T>(addr: Int) -> *T Never! {
    #Unsafe("raw address is an audited typed pointer boundary") {
        return mem.Ptr<T>.from_addr(addr)
    }
}

pub fn volatile_read<T>(pointer: *T) -> T Never! {
    #Unsafe("volatile access requires an audited typed pointer") {
        return core.mem.volatile_read<T>(pointer)
    }
}

pub fn volatile_write<T>(pointer: *T, value: T) Never! {
    #Unsafe("volatile access requires an audited typed pointer") {
        core.mem.volatile_write<T>(pointer, value)
    }
}
