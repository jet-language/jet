//RS     // ── Smart Context runtime ───────────────────────────────────────────────
//RS     //
//RS     // `#Context(allocator: a) { … }` compiles to a `JetContextGuard` RAII value
//RS     // that saves the old ambient allocator pointer and restores it on Drop.
//RS     // Restore fires on all exit paths: normal exit, `return`, `break`, `?`,
//RS     // and panic unwind — satisfying Q2 = Cβ (per-block restore).
//RS     //
//RS     // The thread-local holds a raw `*const u8` (type-erased allocator pointer).
//RS     // Safety: Jet sema guarantees the allocator variable is declared before the
//RS     // `#Context` block and lives for at least the block's duration, so the
//RS     // pointer is always valid while the guard is live. This is the same
//RS     // lifetime-extension trust as the `alloc` helper above.
//RS     //
//RS     // I1: no `unsafe` leaks to user-visible generated Rust — this module is the
//RS     // one audited exception (stripped from the I1 golden-test check in golden.rs).
//RS 
//RS     thread_local! {
//RS         // Raw pointer to the current ambient allocator (None = use default heap).
//RS         static JET_CTX_ALLOC: std::cell::Cell<Option<*const u8>> =
//RS             std::cell::Cell::new(None);
//RS     }
//RS 
//RS     /// RAII guard: pushes a new ambient allocator on construction, pops it on Drop.
//RS     /// Drop is called on all exit paths (return, break, ?, panic unwind).
//RS     pub struct JetContextGuard {
//RS         saved: Option<*const u8>,
//RS     }
//RS 
//RS     impl Drop for JetContextGuard {
//RS         fn drop(&mut self) {
//RS             JET_CTX_ALLOC.with(|c| c.set(self.saved));
//RS         }
//RS     }
