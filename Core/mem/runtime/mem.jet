// PORT-PENDING 0181 crates-jet-codegen-src-prelude-mem: crates/jet-codegen/src/Prelude/Mem.rs:1-835
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS     // D-ALLOC2 / D-REGION1 (ratified 2026-06-21): real bump-allocated arena +
//RS     // scope-bound regions. The c05 upgrade — replaces the owned-clone stub where
//RS     // `alloc(v)` just returned `v` with a real shared bump buffer.
//RS     //
//RS     // Soundness contract (the runtime half; the sema half lives in
//RS     // Source/Sema/CheckerOwnership.rs as E0631/E0632):
//RS     //   * `alloc(&self, v) -> &'arena mut T` hands out a reference *into* the
//RS     //     arena's storage, tied to the arena's borrow — the typed-arena pattern.
//RS     //     Chunks live in a `RefCell` (interior mutability) so `alloc` takes
//RS     //     `&self` and many live views may coexist.
//RS     //   * `reset(&mut self)` reuses storage; terminal release is the shared
//RS     //     compiler-owned `close(^resource)` protocol,
//RS     //     so rustc itself forbids reset/close while any view is live: a borrow
//RS     //     held by an outstanding `&'arena mut T` view conflicts with the
//RS     //     `&mut`/`move`. Jet's sema rejects first (E0632) so I2 holds — rustc
//RS     //     never speaks — but the signatures are the backstop.
//RS     //
//RS     // I6: zero external crates — plain std Rust only.
//RS     // The one vetted lifetime-extension lives here, inside the core.mem
//RS     // helper module; it never leaks into user-visible generated code.
//RS     use std::cell::{Cell, RefCell};
//RS     use std::ptr::NonNull;
//RS 
//RS     pub use super::AllocError;
//RS     pub use super::jet_uninit_semantics::{JetUninit, JetUninitFixed};
