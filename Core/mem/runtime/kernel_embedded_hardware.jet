// Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:585
pub struct JetRegister<W: JetRegisterValue, A: JetRegisterAccess, B: JetRegisterBackend, const VOLATILE: Bool> {
    backend: &B
    address: U64
    marker: PhantomData<fn() -> (W, A)>
}
impl<W: JetRegisterValue, A: JetRegisterAccess, B: JetRegisterBackend, const VOLATILE: Bool> JetRegister<W, A, B, VOLATILE> {
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:602
    pub fn new(backend: &B, address: U64) -> JetRegister<W, A, B, VOLATILE> {
        JetRegister{backend: backend, address: address, marker: PhantomData}
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:610
    pub fn from_spec(backend: &B, base: U64, spec: &JetRegisterSpec) -> JetRegister<W, A, B, VOLATILE> JetRegisterError! {
        if spec.width != W.WIDTH -> return Err(.WidthMismatch(spec.width, W.WIDTH))
        if spec.access != A.MODE -> return Err(.AccessMismatch(spec.access, A.MODE))
        if spec.volatile != VOLATILE -> return Err(.VolatileMismatch(spec.volatile, VOLATILE))
        address :: base.checked_add(spec.offset) ?? return Err(.AddressOverflow)
        if address % spec.width.bytes() != 0 -> return Err(.Misaligned)
        Ok(JetRegister<W, A, B, VOLATILE>.new(backend, address))
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:642
    pub fn address(self: &JetRegister<W, A, B, VOLATILE>) -> U64 { self.address }
}
impl<W: JetRegisterValue, A: JetRegisterReadable, B: JetRegisterBackend, const VOLATILE: Bool> JetRegister<W, A, B, VOLATILE> {
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:653
    pub fn read(self: &JetRegister<W, A, B, VOLATILE>) -> W {
        W.from_bits(self.backend.read(self.address, W.WIDTH, VOLATILE))
    }
}
impl<W: JetRegisterValue, A: JetRegisterWritable, B: JetRegisterBackend, const VOLATILE: Bool> JetRegister<W, A, B, VOLATILE> {
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:664
    pub fn write(self: &JetRegister<W, A, B, VOLATILE>, value: W) -> {
        self.backend.write(self.address, W.WIDTH, value.into_bits(), VOLATILE)
    }
}
