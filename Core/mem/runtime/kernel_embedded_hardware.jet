//RS // JET_EMBEDDED_HARDWARE_HOST_BEGIN: std-only replay and resident bridge.
//RS // ── Erased adapter bridge ───────────────────────────────────────────────────
//RS 
//RS /// The typed target-adapter seam keeps checked AOT metadata as strings.
//RS /// Resident/JIT code uses the erased companion trait below after it has
//RS /// deliberately allocated compile-time string handles.
//RS pub trait JetHardwareHost {
//RS     fn setup(
//RS         &mut self,
//RS         profile_id: &str,
//RS         setup_kind: &str,
//RS         item: &str,
//RS         width_or_vector: i64,
//RS         ownership_or_handler: &str,
//RS     ) -> i64;
//RS 
//RS     fn register_read(
//RS         &mut self,
//RS         profile_id: &str,
//RS         block: &str,
//RS         register: &str,
//RS         width: i64,
//RS     ) -> i64;
//RS 
//RS     fn register_write(
//RS         &mut self,
//RS         profile_id: &str,
//RS         block: &str,
//RS         register: &str,
//RS         width: i64,
//RS         value: i64,
//RS     ) -> i64;
//RS 
//RS     fn dma_start(
//RS         &mut self,
//RS         profile_id: &str,
//RS         channel: &str,
//RS         address: u64,
//RS         bytes: u64,
//RS     ) -> i64;
//RS 
//RS     fn dma_wait(&mut self, profile_id: &str, channel: &str, token: i64) -> i64;
//RS 
//RS     fn trigger_interrupt(&mut self, _vector: u16) -> i64 {
//RS         JET_HARDWARE_UNAVAILABLE
//RS     }
//RS }
//RS 
//RS /// Erased JIT adapter seam. String handles are allocated by the resident
//RS /// compiler and resolved by its host; this trait is never used by AOT.
//RS pub trait JetHardwareErasedHost {
//RS     fn setup(
//RS         &mut self,
//RS         profile_id: i64,
//RS         setup_kind: i64,
//RS         item: i64,
//RS         width_or_vector: i64,
//RS         ownership_or_handler: i64,
//RS     ) -> i64;
//RS 
//RS     fn register_read(&mut self, profile_id: i64, block: i64, register: i64, width: i64) -> i64;
//RS 
//RS     fn register_write(
//RS         &mut self,
//RS         profile_id: i64,
//RS         block: i64,
//RS         register: i64,
//RS         width: i64,
//RS         value: i64,
//RS     ) -> i64;
//RS 
//RS     fn dma_start(
//RS         &mut self,
//RS         profile_id: i64,
//RS         channel: i64,
//RS         address: i64,
//RS         bytes: i64,
//RS     ) -> i64;
//RS 
//RS     fn dma_wait(&mut self, profile_id: i64, channel: i64, token: i64) -> i64;
//RS 
//RS     /// Register a compile-time string handle before the first call. This is
//RS     /// an adapter-only side channel; it never crosses the generated ABI.
//RS     fn register_string_handle(&mut self, _handle: i64, _value: &str) {}
//RS 
//RS     /// Queue a canonical replay event for a bound hardware interrupt. This is
//RS     /// adapter-only and never part of generated program ABI.
//RS     fn trigger_interrupt(&mut self, _vector: u16) -> i64 {
//RS         JET_HARDWARE_UNAVAILABLE
//RS     }
//RS }
//RS 
//RS /// Setup kind values passed by MIR package setup installation.
