//RS /// The only backend that performs target MMIO.  The selected profile has
//RS /// already validated the address, width, alignment, and volatile fact before
//RS /// generated code reaches this kernel.  User code never enters this block.
//RS #[derive(Clone, Copy, Debug, Default)]
//RS pub struct JetVolatileRegisterBackend;
//RS 
//RS impl JetRegisterBackend for JetVolatileRegisterBackend {
//RS     fn read(&self, address: u64, width: JetRegisterWidth, volatile_access: bool) -> u64 {
//RS         // SAFETY: TargetMachineFacts validate the MMIO region and generated
//RS         // register types validate width/alignment.  This is the vetted target
//RS         // adapter seam; no user pointer or address reaches these operations.
//RS         unsafe {
//RS             match (width, volatile_access) {
//RS                 (JetRegisterWidth::U8, true) => core::ptr::read_volatile(address as *const u8) as u64,
//RS                 (JetRegisterWidth::U16, true) => {
//RS                     core::ptr::read_volatile(address as *const u16) as u64
//RS                 }
//RS                 (JetRegisterWidth::U32, true) => {
//RS                     core::ptr::read_volatile(address as *const u32) as u64
//RS                 }
//RS                 (JetRegisterWidth::U64, true) => core::ptr::read_volatile(address as *const u64),
//RS                 (JetRegisterWidth::U8, false) => core::ptr::read(address as *const u8) as u64,
//RS                 (JetRegisterWidth::U16, false) => core::ptr::read(address as *const u16) as u64,
//RS                 (JetRegisterWidth::U32, false) => core::ptr::read(address as *const u32) as u64,
//RS                 (JetRegisterWidth::U64, false) => core::ptr::read(address as *const u64),
//RS             }
//RS         }
//RS     }
//RS 
//RS     fn write(&self, address: u64, width: JetRegisterWidth, value: u64, volatile_access: bool) {
//RS         // SAFETY: see `read`; the generated profile fact owns the address and
//RS         // width, and the operation is confined to this vetted kernel.
//RS         unsafe {
//RS             match (width, volatile_access) {
//RS                 (JetRegisterWidth::U8, true) => {
//RS                     core::ptr::write_volatile(address as *mut u8, value as u8)
//RS                 }
//RS                 (JetRegisterWidth::U16, true) => {
//RS                     core::ptr::write_volatile(address as *mut u16, value as u16)
//RS                 }
//RS                 (JetRegisterWidth::U32, true) => {
//RS                     core::ptr::write_volatile(address as *mut u32, value as u32)
//RS                 }
//RS                 (JetRegisterWidth::U64, true) => {
//RS                     core::ptr::write_volatile(address as *mut u64, value)
//RS                 }
//RS                 (JetRegisterWidth::U8, false) => core::ptr::write(address as *mut u8, value as u8),
//RS                 (JetRegisterWidth::U16, false) => {
//RS                     core::ptr::write(address as *mut u16, value as u16)
//RS                 }
//RS                 (JetRegisterWidth::U32, false) => {
//RS                     core::ptr::write(address as *mut u32, value as u32)
//RS                 }
//RS                 (JetRegisterWidth::U64, false) => core::ptr::write(address as *mut u64, value),
//RS             }
//RS         }
//RS     }
//RS }
