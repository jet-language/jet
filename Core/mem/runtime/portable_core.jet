// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:42
// GATE #4565: kernel primitive
pub static __JET_LAST_TARGET_STATUS: AtomicI32 = #Unsafe("atomic selected-target status starts at zero") { AtomicI32.new(0) }
// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:46
fn jet_stop_rich<M: fmt.Display>(code: String, context: JetRuntimeStopContext, message: &fmt.Display, locals: M?) -> Never {
    row :: jet_runtime_diagnostic_row(code)
    jet_target_failure_render(jet_runtime_stop_status(row), fn(out) -> jet_write_runtime_stop(
        out, row, code, context, message, locals.as_ref().map(fn(value) -> value as &fmt.Display)))
}
// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:62
pub fn jet_runtime_boundary<T>(run: fn() -> T) -> T { run() }
// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:72
pub fn jet_entry_error_exit<E: fmt.Debug>(error: E) -> Never {
    row :: jet_runtime_diagnostic_row("E3001")
    jet_target_failure_render(jet_runtime_stop_status(row), fn(out) -> jet_write_runtime_stop(out, row, "E3001",
        JetRuntimeStopContext{file: "", line: 0, function: "", source_line: "", column: 1, caret_len: 1, expected_type: ""},
        &fmt.arguments("{error:?}"), None))
}
// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:96
pub fn jet_runtime_stop(code: String, file: String, line: U32, message: String) -> Never {
    jet_stop_rich(code, JetRuntimeStopContext{file: file, line: line, function: "", source_line: "", column: 1, caret_len: 1,
        expected_type: message.rsplit_once(" — expected ").map(fn(pair) -> pair.1).unwrap_or(message)}, &message, None as fmt.Arguments?)
}
// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:109
pub fn jet_panic(file: String, line: U32, message: String) -> Never {
    jet_panic_rich(file, line, "", "", 1, 1, message, None as fmt.Arguments?)
}
// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:114
pub fn jet_arithmetic_stop(file: String, line: U32, message: String) -> Never { jet_runtime_stop("E3010", file, line, message) }
// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:119
pub fn jet_todo_stop(file: String, line: U32, expected_type: String) -> Never { jet_runtime_stop("E3011", file, line, expected_type) }
// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:129
pub fn jet_panic_rich<M: fmt.Display>(file: String, line: U32, fn_name: String, source_line: String, col: U32, caret_len: U32, message: String, locals: M?) -> Never {
    jet_stop_rich("E3001", JetRuntimeStopContext{file: file, line: line, function: fn_name, source_line: source_line,
        column: col, caret_len: caret_len, expected_type: message}, &message, locals)
}
// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:151
pub fn jet_require<M: fmt.Display>(condition: Bool, message: String, file: String, line: U32, fn_name: String, source_line: String, col: U32, caret_len: U32, locals: M?) -> {
    if not condition -> jet_panic_rich(file, line, fn_name, source_line, col, caret_len, message, locals)
}
// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:176
pub fn jet_require_eq<L: fmt.Display, R: fmt.Display, M: fmt.Display>(condition: Bool, left_debug: L, right_debug: R, file: String, line: U32, fn_name: String, source_line: String, col: U32, caret_len: U32, locals: M?) -> {
    if not condition {
        message :: jet_require_eq_message(&left_debug, &right_debug)
        jet_stop_rich("E3001", JetRuntimeStopContext{file: file, line: line, function: fn_name, source_line: source_line,
            column: col, caret_len: caret_len, expected_type: ""}, &message, locals)
    }
}
// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:203
pub fn print(args: fmt.Arguments) -> { jet_target_print(args) }
// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:210
pub fn println(args: fmt.Arguments = fmt.arguments("")) -> { jet_target_println(args) }
// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:220
pub fn eprint(args: fmt.Arguments) -> { jet_target_report(args) }
// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:227
pub fn eprintln(args: fmt.Arguments = fmt.arguments("")) -> { jet_target_reportln(args) }
