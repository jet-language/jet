// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:274
fn jet_fixed_value(result: JetFixedArithmeticResult, file: String, line: U32) -> I64 {
    match result {
        .Value(value) -> value
        .Absent -> jet_arithmetic_stop(file, line, "This checked fixed-width operation has no result")
        .Trap(error) -> jet_fixed_error_stop(error, file, line)
    }
}
// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:285
fn jet_fixed_error_stop(error: JetFixedArithmeticError, file: String, line: U32) -> Never {
    jet_stop_rich(JET_ARITHMETIC_CODE, JetRuntimeStopContext{file: file, line: line, function: "", source_line: "",
        column: 1, caret_len: 1, expected_type: ""}, &error, None as fmt.Arguments?)
}
