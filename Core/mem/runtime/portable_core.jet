// Rust: crates/jet-codegen/src/Prelude/PortableCore.rs:354
fn jet_fixed_option<T>(result: JetFixedArithmeticResult, map: fn(I64) -> T) -> T? {
    match result {
        .Value(value) -> Val(map(value))
        .Absent -> None
        .Trap(_) -> None
    }
}
