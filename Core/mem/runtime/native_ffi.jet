//RS 
//RS /// The bridge's panic reporter, as a plain Rust `fn`.
//RS ///
//RS /// D-JITUNWIND1 (#1995 / #1997): the `extern "C"` frame the bridge actually
//RS /// calls is the shim `host_seam::guarded` generates below, never this body. That
//RS /// is the whole point of the rule — rustc gives an `extern "C"` *body* an
//RS /// abort-on-unwind shim, so had this stayed `extern "C" fn` a panic raised here
//RS /// would die as `thread caused non-unwinding panic` at its own edge, before any
//RS /// guarded seam below it could catch.
//RS ///
//RS /// This seam is worth naming because the bridge calls it *precisely* when
//RS /// something already went wrong: a foreign function failed inside a `*_cabi`
//RS /// trampoline that generated code called, so a Cranelift frame is on the stack
//RS /// below every line of this body — the lossy decode's allocation, the
//RS /// `ACTIVE_RUNTIME` borrow, and `set_trap`'s report formatting alike.
//RS fn ffi_reporter(message: *const u8, len: usize) {
//RS     let message = if message.is_null() {
//RS         "a foreign function panicked".into()
//RS     } else {
//RS         // JET_VETTED_UNSAFE_BEGIN: ffi_reporter
//RS         String::from_utf8_lossy(unsafe { std::slice::from_raw_parts(message, len) }).into_owned()
//RS         // JET_VETTED_UNSAFE_END: ffi_reporter
//RS     };
//RS     Concurrency::with_runtime_mut(|rt| rt.set_ffi_runtime_stop(&message));
//RS }
//RS 
//RS /// Record a host fault on the active runtime. Every bridge/atomic failure
//RS /// reports through the runtime's fault path so the resident run stops the same
//RS /// way AOT's `jet_ffi_*` trampolines stop: by fault, not by silent zero.
//RS fn trap(msg: &str) {
//RS     Concurrency::with_runtime_mut(|rt| rt.set_host_fault(msg));
//RS }
