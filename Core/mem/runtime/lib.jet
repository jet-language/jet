//RS     /// Ordered map; each entry keeps the raw key handle for `keys()` and the
//RS     /// packed value word used by the JIT ABI.
//RS     Map(BTreeMap<JetMapKey, (i64, i64)>),
//RS     Record(Vec<JetVal>),
//RS     /// A record handle stored in another record. Keeping the distinction from
//RS     /// `Int` lets recursive map-key marshalling follow the declared field
//RS     /// shape without mistaking an integer that happens to equal an arena index
//RS     /// for a nested record.
//RS     RecordRef(i64),
//RS     // D-INTBIG1: exact Int spill carrier. Reuses `CtBigInt` (jet-foundation)
//RS     // limb-for-limb so a JIT-computed spilled Int prints byte-identical to the
//RS     // AOT and comptime exact integer paths (R12 parity).
//RS     ExactInt(jet_foundation::Numeric::CtBigInt),
//RS }
//RS 
//RS /// Cell representation of an integer-backed list. Exact `Int` cells may hold
//RS /// a tagged pointer to a spilled exact integer, so storing one retains it.
//RS /// Fixed-width 64-bit words (`I64`, `U64`) use every bit pattern: they are
//RS /// never read as exact-integer pointers, and `U64` words order unsigned.
//RS #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
//RS pub enum IntCells {
//RS     #[default]
//RS     Exact,
//RS     Word { unsigned: bool },
//RS }
