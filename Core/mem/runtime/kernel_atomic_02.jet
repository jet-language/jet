//RS /// Marker for Jet's exact `Int` atomic lane.
//RS ///
//RS /// Jet's source `Int` and fixed-width `I64` both use an `i64` ABI word, but
//RS /// they have different arithmetic and comparison laws. Keeping this marker
//RS /// distinct makes that difference part of the generated Rust type rather than
//RS /// a convention hidden in an adapter.
//RS #[derive(Clone, Copy, Debug, Eq, PartialEq)]
//RS pub struct JetAtomicInt;
//RS 
