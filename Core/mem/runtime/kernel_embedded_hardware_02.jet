// Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2592
pub struct JetDmaRuntime { facts: @JetHardwareFacts, next_sequence: U64 }
impl JetDmaRuntime {
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2598
    pub fn new(facts: @JetHardwareFacts) -> JetDmaRuntime Never! { JetDmaRuntime{facts, next_sequence: U64{0}} }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2605
    pub fn start<T>(self: &JetDmaRuntime, channel: String, buffer: ^JetDmaBuffer<T>) -> JetDmaTransfer<T> JetDmaError! {
        spec :: self.facts.dma_channel(channel).ok_or(JetDmaError.UnknownChannel)?
        if spec.ownership != .Transfer -> return Err(.BorrowedChannel)
        width :: spec.transfer_width.bytes()
        if buffer.bytes == U64{0} -> return Err(.ZeroLength)
        if buffer.address % width != U64{0} || buffer.bytes % width != U64{0} -> return Err(.AddressMisaligned)
        if spec.max_transfer_bytes.is_some_and(limit -> buffer.bytes > limit) -> return Err(.TransferTooLarge)
        sequence :: self.next_sequence
        self.next_sequence = self.next_sequence.saturating_add(U64{1})
        Ok(JetDmaTransfer.new(spec, sequence, ^buffer))
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2638
    pub fn start_replay<T>(self: &JetDmaRuntime, channel: String, buffer: ^JetDmaBuffer<T>) -> JetDmaTransfer<T> JetDmaError! {
        transfer := self.start(channel, ^buffer)?
        &transfer.mark_complete()
        Ok(^transfer)
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2648
    pub fn next_sequence(self) -> U64 Never! { self.next_sequence }
}
