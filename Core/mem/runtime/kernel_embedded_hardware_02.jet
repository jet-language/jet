impl<C, const BINDINGS: USize, const PENDING: USize> JetInterruptController<C, BINDINGS, PENDING> {
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2241
    pub fn new(facts: @JetHardwareFacts) -> JetInterruptController<C, BINDINGS, PENDING> Never! {
        JetInterruptController{facts, bindings: [JetInterruptBinding<C>?; BINDINGS].filled(None),
            pending: [U16; PENDING].filled(U16{0}), head: USize{0}, tail: USize{0}, pending_len: USize{0}, dropped: USize{0}}
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2253
    pub fn bind(self: &JetInterruptController<C, BINDINGS, PENDING>, vector: U16, handler: JetInterruptHandler<C>) -> JetInterruptError! {
        spec :: self.facts.interrupt_vector(vector).ok_or(JetInterruptError.UnknownVector)?
        if not spec.bounded -> return Err(.UnboundedVector)
