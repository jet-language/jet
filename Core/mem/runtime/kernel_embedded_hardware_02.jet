// Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:1790
pub fn jet_hardware_dma_wait_typed<T: JetDmaPayload>(profile_id: String, channel: String, transfer: ^JetDmaTransfer<T>) -> T Never! {
    owned := ^transfer
    if owned.channel() != channel -> jet_panic("<core.hardware>", 0, "DMA wait channel does not match checked transfer")
    token :: owned.host_token()
    if token <= I64{0} -> jet_panic("<core.hardware>", 0, "DMA wait transfer has no host token")
    // GATE #4565: kernel primitive
    status :: #Unsafe("provider waits for completion of this transfer's matching positive host token") {
        jet_hardware_with_current_host(host -> host.dma_wait(profile_id, channel, token))
    }
    if status != I64{0} -> jet_panic("<core.hardware>", 0, "DMA wait adapter reported unavailable status")
    &owned.mark_complete()
    owned.wait().unwrap_or_else(_ -> jet_panic("<core.hardware>", 0, "DMA wait completed without an owned buffer")).into_inner()
}
