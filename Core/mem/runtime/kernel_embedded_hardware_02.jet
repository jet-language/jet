// Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:1909
#Derive(Clone, Copy, Debug, Eq, PartialEq)
#Error
pub enum JetRegisterReplayError { Full, Duplicate }
impl<const N: USize> JetRegisterReplay<N> {
