impl<const N: USize> JetRegisterBackend for JetRegisterReplay<N> {
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:1969
    fn read(self, address: U64, width: JetRegisterWidth, _volatile_access: Bool) -> U64 Never! { self.value(address, width).unwrap_or(U64{0}) }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:1973
    fn write(self, address: U64, width: JetRegisterWidth, value: U64, _volatile_access: Bool) -> Never! {
