    // Only the real provider completion or deterministic replay can release the retained frame resource.
    pub fn mark_complete(self: &JetDmaTransfer<T>) -> Never! {
        self.state = .Complete
        if self.completion_handle is Val(handle) {
            if handle.signal() is Err(error) -> jet_panic("<core.hardware>", 0, error)
        } else if current_frame_completion_state().is_some() {
            jet_panic("<core.hardware>", 0, "checked DMA completion is missing its submission binding")
        }
