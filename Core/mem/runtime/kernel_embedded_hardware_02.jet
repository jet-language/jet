    // An incomplete wait returns the same owning transfer for a later retry.
    pub fn wait(^self) -> JetDmaBuffer<T> JetDmaWaitError<T>! {
        owned := ^self
        if not owned.is_complete() -> return Err(.Incomplete(^owned))
        match &owned.buffer.take() {
            Val(buffer) -> Ok(^buffer)
            None -> Err(.Incomplete(^owned))
        }
    }
