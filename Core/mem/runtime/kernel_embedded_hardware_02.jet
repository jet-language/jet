        self.pending_len += USize{1}
        Ok(())
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2291
    pub fn dispatch_next(self: &JetInterruptController<C, BINDINGS, PENDING>, context: &C) -> JetInterruptDispatch Never! {
        if self.pending_len == USize{0} -> return .Empty
        vector :: self.pending[self.head]
        self.head = ring_next(self.head, PENDING)
        self.pending_len -= USize{1}
        if self.binding(vector) is Val(binding) {
            match binding.handler { .Context(handler) -> handler(context), .Bare(handler) -> handler() }
        }
        .Dispatched(vector)
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2307
    pub fn dispatch_all(self: &JetInterruptController<C, BINDINGS, PENDING>, context: &C) -> USize Never! {
        dispatched := USize{0}
        loop self.pending_len != USize{0} {
            _ :: self.dispatch_next(context)
            dispatched += USize{1}
        }
        dispatched
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2316
    pub fn clear_pending(self: &JetInterruptController<C, BINDINGS, PENDING>) -> Never! {
        self.head = USize{0}
        self.tail = USize{0}
        self.pending_len = USize{0}
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2322
    pub fn pending_len(self) -> USize Never! { self.pending_len }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2326
    pub fn dropped(self) -> USize Never! { self.dropped }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2330
    pub fn binding_count(self) -> USize Never! { USize{self.bindings.iter().filter(slot -> slot.is_some()).count()} }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2334
    fn binding_index(self, vector: U16) -> USize? Never! {
        self.bindings.iter().position(slot -> slot.is_some_and(binding -> binding.vector == vector)).map(index -> USize{index})
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2341
    fn binding(self, vector: U16) -> JetInterruptBinding<C>? Never! {
        self.binding_index(vector).and_then(index -> self.bindings[index])
