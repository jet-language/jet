}
// Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2347
fn ring_next(index: USize, capacity: USize) -> USize Never! {
    if capacity == USize{0} || index + USize{1} == capacity { USize{0} } else { index + USize{1} }
}
