    pub fn new() -> JetRegisterReplay<N> Never! { JetRegisterReplay{cells: [JetReplayCell; N].from_fn(_ -> JetReplayCell.empty())} }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:1921
    pub fn define(self: &JetRegisterReplay<N>, address: U64, width: JetRegisterWidth, initial: U64) -> JetRegisterReplayError! {
        if self.cells.iter().any(cell -> cell.defined && cell.address == address) -> return Err(.Duplicate)
        cell :: &self.cells.iter_mut().find(cell -> not cell.defined).ok_or(JetRegisterReplayError.Full)?
        cell.defined = true
        cell.address = address
        cell.width = width
        cell.value.set(initial)
        Ok(())
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:1944
    pub fn define_spec(self: &JetRegisterReplay<N>, base: U64, spec: JetRegisterSpec, initial: U64) -> JetRegisterReplayError! {
        address :: base.saturating_add(spec.offset)
        self.define(address, spec.width, initial)
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:1954
    pub fn value(self, address: U64, width: JetRegisterWidth) -> U64? Never! {
        self.cells.iter().find(cell -> cell.defined && cell.address == address && cell.width == width).map(cell -> cell.value.get())
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:1963
    pub fn default() -> JetRegisterReplay<N> Never! { JetRegisterReplay.new<N>() }
}
