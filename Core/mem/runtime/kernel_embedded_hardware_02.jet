        slot :: &self.bindings.iter_mut().find(slot -> slot.is_none()).ok_or(JetInterruptError.BindingTableFull)?
        slot = Val(JetInterruptBinding{vector, handler})
        Ok(())
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2274
    pub fn raise(self: &JetInterruptController<C, BINDINGS, PENDING>, vector: U16) -> JetInterruptError! {
        if self.facts.interrupt_vector(vector).is_none() -> return Err(.UnknownVector)
        if self.binding_index(vector).is_none() -> return Err(.UnboundVector)
        if self.pending_len == PENDING {
            self.dropped = self.dropped.saturating_add(USize{1})
            return Err(.QueueFull)
