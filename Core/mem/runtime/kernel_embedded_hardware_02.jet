    pub fn sequence(self) -> U64 Never! { self.sequence }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2555
    pub fn state(self) -> JetDmaTransferState Never! { self.state }
    // Rust: crates/jet-codegen/src/Prelude/Core/EmbeddedHardware.rs:2559
    pub fn is_complete(self) -> Bool Never! { self.state is .Complete }
