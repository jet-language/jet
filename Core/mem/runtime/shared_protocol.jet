// GATE #4565: kernel primitive
#Unsafe("remove the exact native Rc identity only from the calling thread's transaction stack")
fn jet_shared_transaction_pop(state: &Rc<RefCell<JetSharedTransactionState>>) -> {
    JET_SHARED_TRANSACTION_STACK.with(fn(stack) {
        stack := stack.borrow_mut()
        if Val(index) :: stack.iter().rposition(fn(entry) {
            entry.upgrade().is_some_and(fn(candidate) { Rc.ptr_eq(&candidate, state) })
        }) { stack.remove(index) }
    })
}
// Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:689
// GATE #4565: kernel primitive
#Unsafe("merge thread-confined child working values and invalidate parent tickets with Release publication")
fn jet_shared_transaction_merge_nested(parent: &Rc<RefCell<JetSharedTransactionState>>, child_parts: [JetSharedTransactionPart], child_rollbacks: [Box<fn() -> ()>]) -> {
    parent := parent.borrow_mut()
    parts :: parent.parts.as_mut().expect("nested Shared transaction parent already committed")
    loop child in child_parts.drain(..) {
        parent_part :: jet_shared_transaction_part_mut(parts, &child.protocol)
        if child.writes {
            loop snapshot in &parent_part.snapshots { snapshot.store(false, Ordering.Release) }
        }
        if Val(staged) :: child.staged.take() {
            if Val(parent_staged) :: parent_part.staged.as_ref() { staged.merge_into(parent_staged.as_ref()) }
            else { parent_part.staged = Val(^staged) }
        }
        parent_part.writes |= child.writes
        parent_part.deltas.append(&child.deltas)
        if !parent_part.has_commit_hook {
            parent_part.stage_hooks.append(&child.stage_hooks)
            parent_part.commit_hooks.append(&child.commit_hooks)
            parent_part.has_commit_hook = child.has_commit_hook
        }
        parent_part.snapshots.append(&child.snapshots)
    }
    parent.rollback_hooks.as_mut().expect("nested Shared transaction parent has no rollback hooks").append(&child_rollbacks)
}
// Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:729
// GATE #4565: kernel primitive
#Unsafe("begin on the calling thread's weak stack and retain the process gate only for an outermost transaction")
pub fn jet_shared_transaction_begin() -> JetSharedTransaction {
    parent :: JET_SHARED_TRANSACTION_STACK.with(fn(stack) {
        stack.borrow().last().and_then(fn(parent) { parent.upgrade() }).map(fn(parent) { Rc.downgrade(&parent) })
    })
    gate :: parent.is_none().then(JetSharedTransactionGate.enter)
    state :: Rc.new(RefCell.new(JetSharedTransactionState{parts: Val([]), rollback_hooks: Val([]), parent: ^parent}))
    JET_SHARED_TRANSACTION_STACK.with(fn(stack) { stack.borrow_mut().push(Rc.downgrade(&state)) })
    JetSharedTransaction{state: ^state, _gate: ^gate}
}

