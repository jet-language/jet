    // Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:270
    fn reacquire(self: &Self, cancelled: &fn() -> Bool) -> Bool
    // Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:271
    fn stage_value(self: &Self, _value: Box<Any>) -> () Err! {
        Err("canonical Shared owner does not support typed transaction staging")
    }
    // Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:274
    fn discard_staged(self: &Self) -> () Err! { Ok(()) }
    // Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:277
    fn into_any(self: Arc<Self>) -> Arc<Any>
}
// Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:280
impl JetSharedProtocol {
    // Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:281
    pub fn new() -> Arc<Self> {
        // GATE #4565: kernel primitive
        #Unsafe("construct one native mutex and condition variable per canonical Shared lock") {
            Arc.new(Self{state: Mutex.new(JetSharedLockState.default()), wake: Condvar.new()})
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:288
    pub fn acquire(self: &Arc<Self>, editable: Bool, cancelled: fn() -> Bool) -> Arc<JetSharedPermit>? {
        // GATE #4565: kernel primitive
        #Unsafe("mutex and timed condition wait serialize writer-preferring acquisition; cancellation restores waiter count") {
            state := self.state.lock().unwrap_or_else(fn(error) { error.into_inner() })
            if editable -> state.writers_waiting += 1
            loop {
                if cancelled() {
                    if editable {
                        state.writers_waiting -= 1
                        self.wake.notify_all()
                    }
                    return None
                }
                available :: if editable { !state.writer && state.readers == 0 }
                    else { !state.writer && state.writers_waiting == 0 }
                if available {
                    if editable {
                        state.writers_waiting -= 1
                        state.writer = true
                    } else { state.readers += 1 }
                    return Val(Arc.new(JetSharedPermit{protocol: self.clone(), editable: editable, held: AtomicBool.new(true)}))
                }
                (next, _) :: self.wake.wait_timeout(^state, std.time.Duration.from_millis(10))
                    .unwrap_or_else(fn(error) { error.into_inner() })
                state = ^next
            }
        }
    }
}
