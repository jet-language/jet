fn jet_shared_transaction_part(parts: &[JetSharedTransactionPart], protocol: &Arc<JetSharedCanonicalOwner>) -> (&JetSharedTransactionPart)? {
    parts.iter().find(fn(part) { part.protocol.owner_identity() == protocol.owner_identity() })
