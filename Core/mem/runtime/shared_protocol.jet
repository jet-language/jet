// GATE #4565: kernel primitive
#Unsafe("walk only the native weak parent chain of the current thread's transaction")
fn jet_shared_transaction_has_writes(state: &Rc<RefCell<JetSharedTransactionState>>, protocol: &Arc<JetSharedCanonicalOwner>) -> Bool {
    (writes, parent) :: {
        state :: state.borrow()
        writes :: state.parts.as_deref()
            .and_then(fn(parts) { jet_shared_transaction_part(parts, protocol) })
            .is_some_and(fn(part) { part.writes })
        (writes, state.parent.clone())
    }
    writes || parent.is_some_and(fn(parent) {
        parent.upgrade().is_some_and(fn(parent) { jet_shared_transaction_has_writes(&parent, protocol) })
    })
}
