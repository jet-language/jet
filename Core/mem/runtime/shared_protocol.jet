fn jet_shared_condition_wait_registered_with_handoff(permit: &JetSharedCanonicalPermit, registration: JetConditionRegistration, waiter: Arc<JetConditionWaiter>, handoff: (&JetSharedWaitHandoff)?) -> () ()! {
    cleanup := JetConditionWaitCleanup{registration: Val(^registration), permit: permit, waiter: waiter.as_ref(), released: false}
    if Val(owner) :: handoff.as_deref_mut() {
        if owner.suspend().is_err() {
            _ :: owner.abort()
            return Err(())
