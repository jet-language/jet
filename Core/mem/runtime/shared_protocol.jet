pub fn jet_shared_condition_wait<E>(permit: &JetSharedCanonicalPermit, condition: &Arc<JetConditionProtocol>, ready: fn() -> Bool E!, waiter: fn() -> Arc<JetConditionWaiter>) -> () JetConditionWaitError<E>! {
