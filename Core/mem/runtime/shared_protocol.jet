// Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:379
fn jet_shared_acquire_ordered_by<O: JetSharedCanonicalOwner, P: JetSharedCanonicalPermit>(participants: [(Usize, Arc<O>, Bool)], acquire: fn(Arc<O>, Bool) -> Arc<P> Err!) -> [(Usize, Bool, Arc<P>)] Err! {
    ordered := participants.drain(..).map(fn(row) {
        (index, owner, editable) :: row
        (index, owner.owner_identity(), owner.protocol_order_key(), editable, ^owner)
    }).collect()
    ordered.sort_unstable_by_key(fn(row) { (row.2, row.1, row.0) })
    acquired := [(Usize, Bool, Arc<P>)].with_capacity(ordered.len())
    start := Usize{0}
    loop start < ordered.len() {
        (_, owner_identity, order_key, first_editable, owner) :: &ordered[start]
        end := start + 1
        editable := first_editable
        loop end < ordered.len() && ordered[end].1 == owner_identity {
            if ordered[end].2 != order_key -> return Err("one physical Shared owner reported inconsistent protocol ordering keys")
            editable = editable || ordered[end].3
            end += 1
        }
        permit :: acquire(owner.clone(), editable)?
        loop row in ordered.slice(start, end) {
            acquired.push((row.0, row.3, Arc.clone(&permit)))
        }
        start = end
    }
    Ok(^acquired)
}
