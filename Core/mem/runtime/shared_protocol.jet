impl Drop for JetSharedTransaction {
    // Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:1026
    fn drop(self: &Self) -> {
        // GATE #4565: kernel primitive
        #Unsafe("take rollback hooks exactly once before the gate field releases the native process gate") {
            state :: self.state.clone()
            rollback_hooks :: {
                state := state.borrow_mut()
                if state.parts.take().is_some() { state.rollback_hooks.take() } else { None }
            }
            if Val(hooks) :: rollback_hooks {
                jet_shared_transaction_pop(&state)
                loop hook in hooks.drain(..) { hook() }
            }
        }
    }
}

