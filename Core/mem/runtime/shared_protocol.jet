            discard_errors := [String]{}
            loop permit in permits.iter().flatten() {
                if Err(discard_error) :: permit.discard_staged() { discard_errors.push(^discard_error) }
            }
            drop(^permits)
            loop hook in rollback_hooks.drain(..) { hook() }
            if !discard_errors.is_empty() {
                details :: discard_errors.join("; ")
                return Err("{error}; failed to discard staged Shared values: {details}")
