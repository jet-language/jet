fn jet_shared_transaction_part_mut(parts: &[JetSharedTransactionPart], protocol: &Arc<JetSharedCanonicalOwner>) -> &JetSharedTransactionPart {
    if Val(index) :: parts.iter().position(fn(part) { part.protocol.owner_identity() == protocol.owner_identity() }) {
        assert_eq(parts[index].protocol.protocol_order_key(), protocol.protocol_order_key(),
            "one physical Shared owner reported inconsistent protocol ordering keys")
        return &parts[index]
