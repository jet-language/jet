// Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:89
pub fn jet_shared_scalar_kind<T>() -> JetSharedScalarKind? {
    // GATE #4565: kernel primitive
    #Unsafe("native static TypeId equality classifies only exact losslessly encoded scalar types") {
        ty :: TypeId.of<T>()
        if ty == TypeId.of<I8>() -> return Val(.I8)
        if ty == TypeId.of<U8>() -> return Val(.U8)
        if ty == TypeId.of<I16>() -> return Val(.I16)
        if ty == TypeId.of<U16>() -> return Val(.U16)
        if ty == TypeId.of<I32>() -> return Val(.I32)
        if ty == TypeId.of<U32>() -> return Val(.U32)
        if ty == TypeId.of<I64>() -> return Val(.I64)
        if ty == TypeId.of<U64>() -> return Val(.U64)
        if ty == TypeId.of<F32>() -> return Val(.F32)
        if ty == TypeId.of<F64>() -> return Val(.F64)
        if ty == TypeId.of<Bool>() -> return Val(.Bool)
        if ty == TypeId.of<Char>() -> return Val(.Char)
        None
    }
}
