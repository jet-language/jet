// GATE #4565: kernel primitive
#Unsafe("thread-confined RefCell views and native exact downcasts never escape their transaction thread")
fn jet_shared_transaction_staged_from<T>(state: &Rc<RefCell<JetSharedTransactionState>>, protocol: &Arc<JetSharedCanonicalOwner>) -> Rc<RefCell<T>>? {
