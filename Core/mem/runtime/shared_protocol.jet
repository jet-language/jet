            .and_then(fn(part) { part.staged.as_ref() })
            .and_then(fn(staged) {
                staged.as_any().downcast_ref<JetSharedTxnValueImpl<T>>().map(fn(staged) { staged.value.clone() })
            })
        (staged, state.parent.clone())
    }
    staged.or_else(fn() {
        parent.and_then(fn(parent) { parent.upgrade() })
            .and_then(fn(parent) { jet_shared_transaction_staged_from<T>(&parent, protocol) })
    })
}
