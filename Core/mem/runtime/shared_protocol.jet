        Val(owner) -> owner.resume(parked.is_err())
        None -> Ok(true)
    }
    if !matches(resumed, Ok(true)) {
        if Val(owner) :: handoff.as_deref_mut() { _ :: owner.abort() }
        cleanup.abandon()
        return Err(())
    }
    reacquired :: cleanup.finish()
    if reacquired.is_err() {
        if Val(owner) :: handoff.as_deref_mut() { _ :: owner.abort() }
