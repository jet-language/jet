//RS // D-EXEC1: the C-ABI export surface of the one compiled runtime.
//RS //
//RS // The Jet-native backend (Compiler/JetBackend, contract in
//RS // Docs/research/jet-backend-design-2026-10-01.md, "Calls into the compiled
//RS // runtime") calls the runtime by symbol with the System V convention. Every
//RS // export below is a carrier adapter over the Prelude function AOT already
//RS // calls: no export decides meaning of its own (I9).
//RS //
//RS // Carrier rules, one machine word each:
//RS // - `Int` is the exact-Int carrier word (inline, or a tagged big-integer
//RS //   owner). Kernels that take native `i64` are adapted the way generated
//RS //   Rust adapts them (`native_int_input` / `native_int_result`).
//RS // - `String` is an owned `Box<String>` handle. `jet_rt_string_drop` and
//RS //   `jet_rt_string_builder_finish` consume their argument; every other
//RS //   String parameter is borrowed and stays owned by the caller.
//RS // - `Bool` parameters are a word holding 0 or 1; `Bool` results are returned
//RS //   in the low byte.
//RS // - A cursor handle is an owned `Box<JetLoopRangeCursor>`.
//RS //
//RS // Generated code has no unwind tables, so no unwind may leave an export. A
//RS // stop renders and exits the process exactly as the AOT entry boundary does.
//RS #[cfg(not(target_arch = "wasm32"))]
//RS mod jet_c_abi {
//RS     use std::panic::{catch_unwind, resume_unwind, AssertUnwindSafe};
//RS 
//RS     type JetCString = *mut String;
//RS 
//RS     /// Run one export body; a caught unwind ends the process through the AOT
//RS     /// entry boundary's report carriers instead of entering generated frames.
//RS     #[inline(always)]
//RS     fn guard<T>(run: impl FnOnce() -> T) -> T {
//RS         match catch_unwind(AssertUnwindSafe(run)) {
//RS             Ok(value) => value,
//RS             Err(payload) => stop(payload),
//RS         }
//RS     }
//RS 
//RS     #[cold]
//RS     fn stop(payload: Box<dyn std::any::Any + Send>) -> ! {
//RS         // The boundary renders a runtime report and exits; any other payload
//RS         // is a host fault, which ends like a panic leaving an AOT `main` (the
//RS         // panic hook has already printed it).
//RS         let _ = catch_unwind(AssertUnwindSafe(move || {
//RS             super::jet_runtime_boundary(move || -> () { resume_unwind(payload) })
//RS         }));
//RS         std::process::exit(101)
//RS     }
//RS 
//RS     fn bytes<'a>(ptr: *const u8, len: usize) -> &'a [u8] {
//RS         if len == 0 {
//RS             return &[];
//RS         }
//RS         // SAFETY: the caller passes `len` initialized bytes at `ptr` (static
//RS         // data emitted by the backend) that outlive this call.
//RS         unsafe { std::slice::from_raw_parts(ptr, len) }
//RS     }
//RS 
//RS     fn text(ptr: *const u8, len: usize) -> std::borrow::Cow<'static, str> {
//RS         String::from_utf8_lossy(bytes(ptr, len))
//RS     }
//RS 
//RS     fn handle(value: String) -> JetCString {
//RS         Box::into_raw(Box::new(value))
//RS     }
//RS 
//RS     fn view<'a>(value: JetCString) -> &'a str {
//RS         // SAFETY: `value` is a live handle from `handle` that the caller owns
//RS         // for the duration of this call.
//RS         unsafe { (*value).as_str() }
//RS     }
//RS 
//RS     fn builder<'a>(value: JetCString) -> &'a mut String {
//RS         // SAFETY: `value` is a live builder from `jet_rt_string_builder_new`;
//RS         // the caller owns it exclusively for the duration of this call.
//RS         unsafe { &mut *value }
//RS     }
//RS 
//RS     fn take(value: JetCString) -> String {
//RS         // SAFETY: the caller transfers its owned handle from `handle`.
//RS         *unsafe { Box::from_raw(value) }
//RS     }
//RS 
//RS     fn line_of(line: i64) -> u32 {
//RS         u32::try_from(line).unwrap_or(0)
//RS     }
