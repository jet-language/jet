    pub struct GcMutex {
        locked: AtomicBool
        value: UnsafeCell<T>
    }
    // Rust: crates/jet-rt/src/__gc_portable.rs:19
    // GATE #4494: native Send attestation requires exactly T: Send.
    impl GcMutex.Send where T: Send {}
    // Rust: crates/jet-rt/src/__gc_portable.rs:20
    // GATE #4494: native Sync attestation requires exactly T: Send.
    impl GcMutex.Sync where T: Send {}

    // Rust: crates/jet-rt/src/__gc_portable.rs:22
    pub struct GcMutexGuard {
        mutex: View<GcMutex>
    }
