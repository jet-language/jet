    impl GcMutexGuard.Deref {
        // Rust: crates/jet-rt/src/__gc_portable.rs:27
        type Target = T
        // Rust: crates/jet-rt/src/__gc_portable.rs:29
        fn deref(self) -> View<T> {
            // The guard holds the lock through Drop, excluding another mutable guard.
            #Unsafe("guard owns the acquired lock while lending its shared value") {
                self.mutex.value.get().as_ref()
            }
        }
    }
    // Rust: crates/jet-rt/src/__gc_portable.rs:36
    impl GcMutexGuard.DerefMut {
        // Rust: crates/jet-rt/src/__gc_portable.rs:37
        fn deref_mut(&self) -> ViewMut<T> {
            #Unsafe("this exclusive guard is the sole lock owner during its mutable loan") {
                self.mutex.value.get().as_mut()
            }
        }
    }
    // Rust: crates/jet-rt/src/__gc_portable.rs:44
    impl GcMutexGuard.Drop {
        // Rust: crates/jet-rt/src/__gc_portable.rs:45
        fn drop(&self) -> {
            self.mutex.locked.store(false, Ordering.Release)
        }
    }
    // Rust: crates/jet-rt/src/__gc_portable.rs:50
    #Error
    pub struct GcPoisonError { value: T }
    // Rust: crates/jet-rt/src/__gc_portable.rs:52
    impl GcPoisonError {
        // Rust: crates/jet-rt/src/__gc_portable.rs:53
        pub fn into_inner(^self) -> T { ^self.value }
    }
    // Rust: crates/jet-rt/src/__gc_portable.rs:58
    #Error
    pub enum GcTryLockError {
        WouldBlock
        Poisoned(T)
    }
    // Rust: crates/jet-rt/src/__gc_portable.rs:63
    impl GcMutex {
        // Rust: crates/jet-rt/src/__gc_portable.rs:64
        pub fn new(value: ^T) -> GcMutex {
            GcMutex{locked: AtomicBool.new(false), value: UnsafeCell.new(^value)}
        }
        // Rust: crates/jet-rt/src/__gc_portable.rs:71
        pub fn into_inner(^self) -> T GcPoisonError! {
            Ok(self.value.into_inner())
        }
        // Rust: crates/jet-rt/src/__gc_portable.rs:76
        fn acquire(self) -> {
            loop self.locked.compare_exchange(false, true, Ordering.Acquire, Ordering.Relaxed).is_err() {
                spin_loop()
            }
        }
        // Rust: crates/jet-rt/src/__gc_portable.rs:86
        pub fn lock(self) -> GcMutexGuard gc_portable<GcMutexGuard>.GcPoisonError! {
            self.acquire()
            Ok(GcMutexGuard{mutex: self})
        }
        // Rust: crates/jet-rt/src/__gc_portable.rs:91
        pub fn try_lock(self) -> GcMutexGuard gc_portable<GcMutexGuard>.GcTryLockError! {
            if self.locked.compare_exchange(false, true, Ordering.Acquire, Ordering.Relaxed).is_ok() {
                Ok(GcMutexGuard{mutex: self})
            } else {
                Err(gc_portable<GcMutexGuard>.GcTryLockError.WouldBlock)
            }
        }
        // Rust: crates/jet-rt/src/__gc_portable.rs:103
        pub fn get_mut(&self) -> ViewMut<T> gc_portable<ViewMut<T>>.GcPoisonError! {
            // Exclusive mutex access proves that no guard can be active.
            Ok(self.value.get_mut())
        }
    }
    // Rust: crates/jet-rt/src/__gc_portable.rs:111
    pub struct GcOnce {
