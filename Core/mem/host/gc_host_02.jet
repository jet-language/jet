        value: UnsafeCell<MaybeUninit<T>>
    }
    // Rust: crates/jet-rt/src/__gc_portable.rs:116
    // GATE #4494: Sync requires T: Send + Sync; publication uses release/acquire.
    impl GcOnce.Sync where T: Send + Sync {}
    // Rust: crates/jet-rt/src/__gc_portable.rs:117
    // GATE #4494: Send requires T: Send.
    impl GcOnce.Send where T: Send {}
