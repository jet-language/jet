    impl GcOnce {
        // Rust: crates/jet-rt/src/__gc_portable.rs:120
        pub fn new() -> GcOnce {
            GcOnce{state: AtomicU8.new(0), value: UnsafeCell.new(MaybeUninit<T>.uninit())}
        }
        // Rust: crates/jet-rt/src/__gc_portable.rs:127
        // GATE #4494: self and its returned loan have static extent, and init is
        // consuming FnOnce. The no-OS panic policy aborts during initialization.
        pub fn get_or_init(self, init: ^FnOnce<T>) -> View<T> {
            if self.state.load(Ordering.Acquire) != 2 && self.state.compare_exchange(0, 1, Ordering.Acquire, Ordering.Relaxed).is_ok() {
                #Unsafe("the successful initializing CAS grants sole access to the uninitialized cell") {
                    self.value.get().as_mut().write(init())
                }
                self.state.store(2, Ordering.Release)
            } else {
                loop self.state.load(Ordering.Acquire) != 2 { spin_loop() }
            }
            #Unsafe("acquire observed release publication of the single initialized static value") {
                self.value.get().as_ref().assume_init_ref()
            }
        }
    }
}
// Rust: crates/jet-rt/src/__gc_portable.rs:147
NEXT_OBJECT_ID :: gc_portable<U64>.GcMutex.new(1)
// Rust: crates/jet-rt/src/__gc_portable.rs:149
pub fn gc_next_object_id() -> U64 GCFault! {
    next := NEXT_OBJECT_ID.lock().map_err(_ -> GCFault.HeapPoisoned)?
    id :: next.deref()
    next.deref_mut() = id.checked_add(1) ?? return Err(GCFault.IDExhausted)
    Ok(id)
}
// Rust: crates/jet-rt/src/__gc_portable.rs:156
pub fn gc_catch_unwind<R>(f: ^FnOnce<R>) -> R GcPanic! {
    // Portable panic policy aborts; successful completion returns the real value.
    Ok(f())
}
// Rust: crates/jet-rt/src/__gc_portable.rs:163
pub fn gc_resume_unwind(_payload: ^GcPanic) -> Never {
    jet_target_exit(101)
}
// Rust: crates/jet-rt/src/__gc_portable.rs:167
pub fn gc_initialize_trace() -> GCFault! {
    // No hosted filesystem/env/time adapter. Allocation and collection are unchanged.
    Ok()
}
// Rust: crates/jet-rt/src/__gc_portable.rs:173
pub fn gc_runtime_or_exit(fault: GCFault) -> Never {
    jet_target_failure_render(1, out -> gc_write_failure(out, fault))
}
