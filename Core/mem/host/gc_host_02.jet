use core.cell.UnsafeCell
use core.mem.MaybeUninit
use core.ops.[Deref, DerefMut, Drop]
use core.sync.atomic.[AtomicBool, AtomicU8, Ordering]
use core.hint.spin_loop
use core.mem.runtime.gc_core.[GCFault, GCObjectID, GCPromotionSite]
use jet_rt.[GcPanic, jet_target_exit, jet_target_failure_render]
use core.mem.runtime.gc_host_policy.gc_write_failure
// GATE #4494: UnsafeCell/MaybeUninit, target atomics, guard loans, Send/Sync
// attestations and terminal target-exit/render leaves use native Core names.
// This no-OS adapter keeps real collection in the canonical gc_core owner.
// #4483: AtomicBool/AtomicU8 and spin_loop are selected-target primitives,
// never hosted Mutex/Once substitutions. #4499 and #4409 are not used here.

// Rust: crates/jet-rt/src/__gc_portable.rs:14
pub module gc_portable<T> {
