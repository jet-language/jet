    count :: U32.from_le_bytes(buf[0..4].try_into().unwrap()) as USize
    assert(count <= (buf.len() - 4) / 8, "map-string-int count")
    i := USize{4}
    out := JetMap<String, JetInt>.new()
    for _ in 0..count {
