        row :: jet_runtime_diagnostic_row("E3001")
        jet_target_failure_render(jet_runtime_stop_status(row), fn(out) -> jet_write_runtime_stop(out, row, "E3001",
            JetRuntimeStopContext{file: file, line: line, function: "", source_line: "", column: 1, caret_len: 1, expected_type: ""}, &message, None))
    }
    jet_target_exit(101)
}
