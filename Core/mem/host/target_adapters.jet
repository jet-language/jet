fn jet_panic_handler(info: core.panic.PanicInfo) -> Never {
    if __JET_TARGET_PANIC_REPORT {
        (file, line) :: info.location().map(fn(location) -> (location.file(), location.line())).unwrap_or(("", U32{0}))
