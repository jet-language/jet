package {
    name: "core.mod"
    version: "0.0.1"
    edition: "2026"
    description: "Load a compiled Jet compiled from disk."
    license: "MIT"
    outputs: {
        mod: .Library{ entry: mod }
    }
}
use core as core
use core.text.parse as parse

// core.mod — a compiled Jet unit loaded under an explicit read grant.
//
// Source owns loader sequencing and typed refusals. Private raw operations
// retain the existing header parser, native mapping, and owning resources.
// Dropping the context closes its native handle before removing staged bytes.

/// Each case asks the caller for a different action. `Denied`:
/// the grant refuses the path or an effect the library declares. `NotFound`:
/// nothing is at the path. `Invalid`: the file is damaged or is not a
/// library. `Unsupported`: another Jet version, ABI or platform built it, or
/// loading is not available here. Each case holds the provider's reason.
#Error
enum ModError {
    Denied(String)
    NotFound(String)
    Invalid(String)
    Unsupported(String)
}

struct __LoadContext { handle: Int }

impl __LoadContext.Close {
    fn close(^self) {
        core.mod.__close_context(self.handle)
    }
}

fn load(path: String, grant: ModGrant) -[FS, Exec]> Mod ModError! {
    if !core.mod.__supported() ->
        return Err(ModError.Unsupported("Mod.load is not supported on target `{core.mod.__os()}`"))
    handle :: core.mod.__read_context(path, grant) ?? return Err(mod_error(err))
    context :: __LoadContext{handle: handle}
    core.mod.__parse_context(handle) ?? return Err(ModError.Invalid(err))
    core.mod.__check_context(handle) ?? return Err(mod_error(err))
    if !core.mod.__context_digest(handle) ->
        return Err(ModError.Invalid("cannot map library payload: `{core.mod.__context_name(handle)}` has a content digest that does not match its metadata"))
    core.mod.__stage_context(handle) ?? return Err(ModError.Invalid(err))
    core.mod.__open_context(handle) ?? return Err(ModError.Invalid("cannot map library payload: {err}"))
    text_exports := false
    loop index in 0..<core.mod.__exports_count(handle) {
        info :: core.mod.__export_info(handle, index)
        text_exports = text_exports || info.text
        core.mod.__resolve_export(handle, index) ?? return Err(ModError.Invalid("E1341: library `{core.mod.__context_name(handle)}` metadata names `{info.name}`, but the payload has no `{info.symbol}` export: {err}"))
    }
    if text_exports {
        core.mod.__resolve_symbol(handle, "jet_text_free") ?? return Err(ModError.Invalid("E1341: library `{core.mod.__context_name(handle)}` has Text exports but no `jet_text_free` allocator release export: {err}"))
    }
    // Finish consumes the raw owner; the lexical Close sees an empty slot.
    Ok(core.mod.__finish_context(handle))
}
struct CompiledModule {
    path: String
    handle: Int
}

// The provider exposes no `jet_mod_unload` operation.  `Mod` owns its native
// handle and unloads on drop; a legacy value cannot truthfully be turned into
// a detached carrier, so preserve the export as a typed refusal.
fn unload(compiled: CompiledModule) -[FS]> CompiledModule ModError! {
    Err(ModError.Unsupported("core.mod.unload is unavailable: loaded Mod handles are provider-owned and unload on drop"))
}

// The provider reports a refusal as `<Case>: <reason>` (Top/Mod.rs
// `JetModFailure`); an untagged reason is a malformed request, so `Invalid`.
fn mod_error(reason: String) -> ModError Never! {
    if reason.starts_with("Denied: ") -> return ModError.Denied(parse.strip_prefix(reason, "Denied: "))
    if reason.starts_with("NotFound: ") -> return ModError.NotFound(parse.strip_prefix(reason, "NotFound: "))
    if reason.starts_with("Invalid: ") -> return ModError.Invalid(parse.strip_prefix(reason, "Invalid: "))
    if reason.starts_with("Unsupported: ") -> return ModError.Unsupported(parse.strip_prefix(reason, "Unsupported: "))
    ModError.Invalid(reason)
}

fn is_loaded(compiled: CompiledModule) -> Bool Never! {
    compiled.handle > 0
}

fn path(compiled: CompiledModule) -> String Never! {
    compiled.path
}

#Test("module loader preserves tagged refusal categories and reasons") {
    assert_eq(mod_error("Denied: outside roots"), ModError.Denied("outside roots"))
    assert_eq(mod_error("NotFound: absent"), ModError.NotFound("absent"))
    assert_eq(mod_error("Invalid: bad header"), ModError.Invalid("bad header"))
    assert_eq(mod_error("Unsupported: target"), ModError.Unsupported("target"))
    assert_eq(mod_error("untagged"), ModError.Invalid("untagged"))
}

