package {
    name: "core.regex"
    version: "0.0.1"
    edition: "2026"
    description: "Checked regular expressions."
    license: "MIT"
    outputs: {
        regex: .Library{ entry: regex }
    }
}

// core.regex — one engine, compile-checked literals, fallible runtime.
//
// `Regex{"..."}` literals are checked by the compiler, which runs this
// parser. `compile` is for patterns that arrive at run time. The engine is a
// Thompson/Pike VM: the pattern is parsed as Unicode scalars, compiles to
// Consume/Save/Split/Assert/Match instructions, and one scan advances every
// live thread a scalar at a time, so matching is linear in the text with no
// recursion and no budget. Matching is leftmost-first, as in RE2 and Rust:
// the leftmost match wins, and among matches starting there alternation
// prefers its earlier arm and a repetition its greedy (or, with a trailing
// `?`, lazy) count.
// - captures numbered by their `(`, `(?:…)`, `(?<name>…)`/`(?P<name>…)`,
//   `*` `+` `?` `{n}` `{n,}` `{n,m}` (counts up to MAX_REPEAT), each with a
//   lazy `?` form, `.`, `^`, `$` and `\z` (end of text), `\A`, `\b`/`\B`
//   (ASCII word boundary);
// - escapes `\n \r \t \f \v \a`, `\xHH`, `\uHHHH`, `\x{…}`/`\u{…}`, and `\`
//   before ASCII punctuation or a space for that character;
// - classes match scalars: `[]`/`[^]` members and ranges, `\d` and `\w`
//   (ASCII), `\s` (Unicode White_Space), `\p{L}`/`\pL`/`\p{Letter}`/
//   `\p{Alphabetic}` (Alphabetic), `\p{N}`/`\p{Number}` (Numeric),
//   `\p{White_Space}`/`\p{Whitespace}`, and the negations `\D \W \S \P{…}`,
//   inside `[]` too;
// - `ignore_case` compares Unicode simple lowercase mappings;
// - backreferences, lookaround and inline flags are syntax errors.
// Match.start and Match.end count characters (Unicode scalars), so they
// compose with String indexing. A pattern that does not compile fails with
// a RegexError naming the character position and the reason, never a panic.

/// Why a pattern did not compile: `offset` is the zero-based character
/// (Unicode scalar) position in the pattern where the problem is.
#Error
struct RegexError {
    offset: Int
    reason: String
    impl Display {
        fn display(self) -> String { "invalid regex at position {self.offset}: {self.reason}" }
    }
    impl Debug {
        fn debug(^self) -> String Never! { "invalid regex at position {self.offset}: {self.reason}" }
    }
}

/// Displays as its inline-flag letters: `i` ignore_case, `m` multiline,
/// `s` dot_matches_newline (`"im"`; `""` for the defaults).
struct RegexFlags {
    ignore_case: Bool
    multiline: Bool
    dot_matches_newline: Bool
    impl Display {
        fn display(self) -> String {
            i :: if self.ignore_case -> "i" else -> ""
            m :: if self.multiline -> "m" else -> ""
            s :: if self.dot_matches_newline -> "s" else -> ""
            "{i}{m}{s}"
        }
    }
}

/// A compiled program: one row per instruction in `ops`/`args`/`ends`/
/// `negs`/`xs`/`ys`, and one row per class member in `kinds`/`los`/`his`.
struct Regex {
    pattern: String
    flags: RegexFlags
    priv ops: [Int]
    priv args: [Int]
    priv ends: [Int]
    priv negs: [Bool]
    priv xs: [Int]
    priv ys: [Int]
    priv kinds: [Int]
    priv los: [Int]
    priv his: [Int]
    priv start: Int
    priv anchored_start: Bool
    priv groups: Int
    priv names: [String]
}

/// `start` and `end` are character (Unicode scalar) positions in the text.
/// `groups` holds each capture group's text, `""` for a group that took no
/// part; `group`, `group_start` and `group_end` tell the two apart.
struct Match {
    start: Int
    end: Int
    text: String
    groups: [String]
    priv spans: [Int]
    priv names: [String]
}

impl Regex {
    fn is_match(self, text: String) -> Bool Never! { is_match(self, text) }
    fn full_match(self, text: String) -> Bool Never! { full_match(self, text) }
    fn match(self, text: String) -> Match? Never! { match(self, text) }
    fn find(self, text: String) -> String? Never! { find(self, text) }
    fn find_all(self, text: String) -> [String] Never! { find_all(self, text) }
    fn matches(self, text: String) -> [Match] Never! { matches(self, text) }
    fn split(self, text: String) -> [String] Never! { split(self, text) }
    fn split_limit(self, text: String, n: Int) -> [String] Never! { split_limit(self, text, n) }
    fn replace(self, text: String, replacement: String) -> String Never! { replace(self, text, replacement) }
    fn replace_first(self, text: String, replacement: String) -> String Never! { replace_first(self, text, replacement) }

    /// Replace every match with what `replacer` returns for it.
    fn replace_all_with(self, text: String, replacer: fn(Match) -> String Never!) -> String Never! {
        raw :: text.bytes()
        out := [U8]{}
        cur := 0
        chars := CharCursor{byte: 0, count: 0}
        loop run in scan(self, raw, false, false, self.groups > 0, false, -1) {
            k := cur
            loop k < run.start {
                &out.push(raw[k])
                k = k + 1
            }
            m :: make_match(self, raw, run, &chars)
            loop b in replacer(m).bytes() -> &out.push(b)
            cur = run.end
        }
        loop cur < raw.len() {
            &out.push(raw[cur])
            cur = cur + 1
        }
        String.from_bytes(out) ?? ""
    }
}

impl Match {
    /// Group `n`'s text: 0 is the whole match; None when the pattern has no
    /// group `n` or the group took no part in this match.
    fn group(self, n: Int) -> String? Never! {
        if n == 0 -> return Val(self.text.copy())
        if n < 0 || n > self.groups.len() || self.spans[2 * n - 2] < 0 -> return None
        Val(self.groups[n - 1].copy())
    }

    /// The text of the group named `name`, as `group` reports it.
    fn name(self, name: String) -> String? Never! {
        loop g in 0..<self.names.len() {
            if self.names[g] != "" && self.names[g] == name -> return self.group(g + 1)
        }
        None
    }

    /// The character position where group `n` starts (0 is the whole match).
    fn group_start(self, n: Int) -> Int? Never! {
        if n == 0 -> return Val(self.start)
        if n < 0 || n > self.groups.len() || self.spans[2 * n - 2] < 0 -> return None
        Val(self.spans[2 * n - 2])
    }

    /// The character position where group `n` ends (0 is the whole match).
    fn group_end(self, n: Int) -> Int? Never! {
        if n == 0 -> return Val(self.end)
        if n < 0 || n > self.groups.len() || self.spans[2 * n - 2] < 0 -> return None
        Val(self.spans[2 * n - 1])
    }
}

fn flags(ignore_case: Bool, multiline: Bool, dot_matches_newline: Bool) -> RegexFlags Never! {
    RegexFlags{
    ignore_case: ignore_case,
    multiline: multiline,
    dot_matches_newline: dot_matches_newline,
    }
}

/// Quote regex metacharacters in `text` so it matches as a literal.
fn escape(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        if is_meta(b) -> &out.push(U8{92})
        &out.push(b)
    }
    String.from_bytes(out) ?? ""
}

fn compile(pattern: String) -> Regex RegexError! { compile_with(pattern, flags(false, false, false)) }

fn compile_with(pattern: String, flags: RegexFlags) -> Regex RegexError! {
    p := PatternParser{
    cps: decode_all(pattern.bytes()),
    i: 0,
    depth: 0,
    nodes: [Node]{},
    kids: [Int]{},
    kinds: [Int]{},
    los: [Int]{},
    his: [Int]{},
    groups: 0,
    names: [String]{},
    }
    root :: &p.parse_alt(-1)
    if p.i != p.cps.len() -> return Err(fail(p.i, "this `)` has no matching `(`"))
    c := Compiler{
    nodes: p.nodes,
    kids: p.kids,
    ops: [Int]{},
    args: [Int]{},
    ends: [Int]{},
    negs: [Bool]{},
    xs: [Int]{},
    ys: [Int]{},
    too_big: false,
    }
    frag :: &c.compile(root)
    if c.too_big -> return Err(fail(0, "the pattern compiles to more than {MAX_PROGRAM} instructions; use smaller repetition counts"))
    done :: &c.push(OP_MATCH, 0, 0, false)
    &c.patch(frag.outs, done)
    first :: frag.start
    // Only an absolute start anchor pins every match to position 0.
    anchored :: c.ops[first] == OP_ASSERT && (c.args[first] == A_TEXT_START || (c.args[first] == A_LINE_START && !flags.multiline))
    Ok(Regex{
    pattern: pattern,
    flags: flags,
    ops: c.ops,
    args: c.args,
    ends: c.ends,
    negs: c.negs,
    xs: c.xs,
    ys: c.ys,
    kinds: p.kinds,
    los: p.los,
    his: p.his,
    start: first,
    anchored_start: anchored,
    groups: p.groups,
    names: p.names,
    })
}

fn is_match(pattern: Regex, text: String) -> Bool Never! {
    scan(pattern, text.bytes(), false, false, false, true, 1).len() > 0
}

fn full_match(pattern: Regex, text: String) -> Bool Never! {
    scan(pattern, text.bytes(), true, true, false, true, 1).len() > 0
}

fn match(pattern: Regex, text: String) -> Match? Never! { find_match(pattern, text) }
fn finditer(pattern: Regex, text: String) -> [Match] Never! { matches(pattern, text) }

/// The source-owned engine has no process-global cache to mutate. Report that
/// capability explicitly instead of pretending a purge happened.
fn purge() RegexError! {
    return Err(RegexError{offset: 0, reason: "core.regex keeps no pattern cache to purge"})
}

fn find(pattern: Regex, text: String) -> String? Never! {
    raw :: text.bytes()
    runs :: scan(pattern, raw, false, false, false, false, 1)
    if runs.len() == 0 -> return None
    Val(slice(raw, runs[0].start, runs[0].end))
}

fn find_all(pattern: Regex, text: String) -> [String] Never! {
    raw :: text.bytes()
    out := [String]{}
    loop run in scan(pattern, raw, false, false, false, false, -1) -> &out.push(slice(raw, run.start, run.end))
    out
}

fn matches(pattern: Regex, text: String) -> [Match] Never! {
    raw :: text.bytes()
    out := [Match]{}
    chars := CharCursor{byte: 0, count: 0}
    loop run in scan(pattern, raw, false, false, pattern.groups > 0, false, -1) {
        m :: make_match(pattern, raw, run, &chars)
        &out.push(m)
    }
    out
}

fn split(pattern: Regex, text: String) -> [String] Never! { split_limit(pattern, text, 0) }

fn split_limit(pattern: Regex, text: String, n: Int) -> [String] Never! {
    raw :: text.bytes()
    if n == 1 -> return [String]{text}
    limit := -1
    if n > 1 -> limit = n - 1
    out := [String]{}
    cur := 0
    loop run in scan(pattern, raw, false, false, false, false, limit) {
        &out.push(slice(raw, cur, run.start))
        cur = run.end
    }
    &out.push(slice(raw, cur, raw.len()))
    out
}

/// Replace every match, expanding `replacement` as `expand` does.
fn replace(pattern: Regex, text: String, replacement: String) -> String Never! { replace_n(pattern, text, replacement, false) }

/// Expand a replacement template for one match: `$N` and `${N}` insert group
/// N (`$0` is the whole match), `${name}` the named group, and `$$` one `$`.
/// A group the pattern lacks, or one that took no part, inserts nothing; any
/// other `$` is literal text.
fn expand(m: Match, template: String) -> String Never! {
    raw :: template.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        b :: raw[i]
        i = i + 1
        if b != (U8{36}) || i >= raw.len() {
            &out.push(b)
            next
        }
        n :: Int.from_u8(raw[i])
        if n == 36 {
            &out.push(b)
            i = i + 1
            next
        }
        if n >= 48 && n <= 57 {
            j := i
            loop j < raw.len() && raw[j] >= 48 && raw[j] <= 57 -> j = j + 1
            loop c in group_by_reference(m, raw, i, j).bytes() -> &out.push(c)
            i = j
            next
        }
        if n == 123 {
            j := i + 1
            loop j < raw.len() && raw[j] != (U8{125}) -> j = j + 1
            if j < raw.len() {
                loop c in group_by_reference(m, raw, i + 1, j).bytes() -> &out.push(c)
                i = j + 1
                next
            }
        }
        &out.push(b)
    }
    String.from_bytes(out) ?? ""
}

/// The text `raw[from..<to]` names in a template: a group number when it is
/// all digits, otherwise a group name.
fn group_by_reference(m: Match, raw: [U8], from: Int, to: Int) -> String Never! {
    if from == to -> return ""
    index := 0
    k := from
    loop k < to {
        d :: Int.from_u8(raw[k])
        if d < 48 || d > 57 {
            return m.name(slice(raw, from, to)) ?? ""
        }
        if index > (INT_MAX - (d - 48)) /% 10 -> return ""
        index = index * 10 + (d - 48)
        k = k + 1
    }
    m.group(index) ?? ""
}

fn replace_first(pattern: Regex, text: String, replacement: String) -> String Never! { replace_n(pattern, text, replacement, true) }

fn replace_n(pattern: Regex, text: String, replacement: String, first_only: Bool) -> String Never! {
    raw :: text.bytes()
    limit := -1
    if first_only -> limit = 1
    out := [U8]{}
    cur := 0
    chars := CharCursor{byte: 0, count: 0}
    loop run in scan(pattern, raw, false, false, pattern.groups > 0, false, limit) {
        k := cur
        loop k < run.start {
            &out.push(raw[k])
            k = k + 1
        }
        m :: make_match(pattern, raw, run, &chars)
        loop b in expand(m, replacement).bytes() -> &out.push(b)
        cur = run.end
    }
    rest := cur
    loop rest < raw.len() {
        &out.push(raw[rest])
        rest = rest + 1
    }
    String.from_bytes(out) ?? ""
}

INT_MAX :: 9223372036854775807

// The most a counted repetition `{n,m}` may repeat, as in RE2: the program
// grows with the count, so the cap keeps compile size proportional to the
// pattern text.
MAX_REPEAT :: 1000

// How deep groups may nest. Parsing and compiling recurse once per group
// level, so the cap bounds their stack whatever the pattern.
MAX_NEST :: 250

// The most instructions a compiled program may hold. Nested counted
// repetitions multiply, so the cap bounds compile time and memory.
MAX_PROGRAM :: 100000

// Parse tree node kinds. A group or quantifier wraps `left`; a sequence or
// alternation lists its parts in `kids[lo..<hi]`, in priority order, and a
// class its members in rows `lo..<hi`. `a`/`b` hold a literal scalar, an
// assertion kind, a group index, or a quantifier's min/max (-1 = unbounded);
// `neg` marks a negated class or a lazy quantifier.
N_LIT :: 0
N_ANY :: 1
N_CLASS :: 2
N_ASSERT :: 3
N_EMPTY :: 4
N_SEQ :: 5
N_ALT :: 6
N_GROUP :: 7
N_STAR :: 8
N_PLUS :: 9
N_OPT :: 10
N_RANGE :: 11

// Zero-width assertion kinds: `^` (start of text, or after `\n` under
// multiline), `\A`, `$` and `\z` (end of text), `\b` (an ASCII word
// character on exactly one side) and `\B`.
A_LINE_START :: 0
A_TEXT_START :: 1
A_TEXT_END :: 2
A_WORD :: 3
A_NOT_WORD :: 4

// Class member kinds; `kind + K_NEGATED` is the member's complement, as in
// `[\D]` or `[\P{L}]`.
K_CHAR :: 0
K_RANGE :: 1
K_DIGIT :: 2
K_WORD :: 3
K_SPACE :: 4
K_ALPHA :: 5
K_NUMBER :: 6
K_NEGATED :: 8

struct Node {
    kind: Int
    a: Int
    b: Int
    left: Int
    neg: Bool
    lo: Int
    hi: Int
}

struct PatternParser {
    cps: [Int]
    i: Int
    depth: Int
    nodes: [Node]
    kids: [Int]
    kinds: [Int]
    los: [Int]
    his: [Int]
    groups: Int
    names: [String]
}

/// A syntax error at character `at` of the pattern.
fn fail(at: Int, reason: String) -> RegexError Never! { RegexError{offset: at, reason: reason} }

impl PatternParser {
    /// Arms in priority order. `open` is the position of the group's `(`,
    /// or -1 for the whole pattern, whose stray `)` the caller reports.
    fn parse_alt(&self, open: Int) -> Int RegexError! {
        arms := [Int]{}
        first :: &self.parse_seq()
        &arms.push(first)
        loop self.peek() == 124 {
            self.i = self.i + 1
            arm :: &self.parse_seq()
            &arms.push(arm)
        }
        if open >= 0 {
            if self.peek() != 41 -> return Err(fail(open, "this `(` is never closed by a `)`"))
            self.i = self.i + 1
        }
        if arms.len() == 1 -> return Ok(arms[0])
        Ok(&self.list(N_ALT, arms))
    }

    fn parse_seq(&self) -> Int RegexError! {
        parts := [Int]{}
        loop {
            c :: self.peek()
            if c < 0 || c == 124 || c == 41 -> break
            atom :: &self.parse_atom()
            piece :: &self.parse_quant(atom)
            &parts.push(piece)
        }
        if parts.len() == 0 -> return Ok(&self.emit(N_EMPTY, 0, 0, -1, false))
        if parts.len() == 1 -> return Ok(parts[0])
        Ok(&self.list(N_SEQ, parts))
    }

    fn parse_atom(&self) -> Int RegexError! {
        at :: self.i
        c :: &self.bump()
        if c == 46 -> return Ok(&self.emit(N_ANY, 0, 0, -1, false))
        if c == 94 -> return Ok(&self.emit(N_ASSERT, A_LINE_START, 0, -1, false))
        if c == 36 -> return Ok(&self.emit(N_ASSERT, A_TEXT_END, 0, -1, false))
        if c == 40 -> return &self.parse_group(at)
        if c == 91 -> return &self.parse_class(at)
        if c == 92 -> return &self.parse_escape_atom(at)
        if c == 42 || c == 43 || c == 63 -> return Err(fail(at, "`{scalar_text(c)}` has nothing to repeat"))
        if c == 123 -> return Err(fail(at, "`{{` has nothing to repeat; write `\\{{` for a literal brace"))
        Ok(&self.emit(N_LIT, c, 0, -1, false))
    }

    // Capture numbers follow the opening `(`.
    fn parse_group(&self, open: Int) -> Int RegexError! {
        if self.depth >= MAX_NEST -> return Err(fail(open, "groups may nest at most {MAX_NEST} deep"))
        capture := true
        name := ""
        if self.peek() == 63 {
            self.i = self.i + 1
            kind :: self.peek()
            after :: self.peek_at(1)
            if kind == 58 {
                self.i = self.i + 1
                capture = false
            } else if kind == 60 && after != 61 && after != 33 {
                self.i = self.i + 1
                name = &self.parse_group_name(open)
            } else if kind == 80 && after == 60 {
                self.i = self.i + 2
                name = &self.parse_group_name(open)
            } else if kind == 61 || kind == 33 || kind == 60 {
                return Err(fail(open, "lookaround is not supported; the engine stays linear in the text"))
            } else if kind == 105 || kind == 109 || kind == 115 || kind == 120 || kind == 85 || kind == 45 {
                return Err(fail(open, "inline flags are not supported; pass the flags to `compile_with`"))
            } else if kind < 0 {
                return Err(fail(open, "`(?` needs a group kind, as in `(?:…)` or `(?<name>…)`"))
            } else {
                return Err(fail(open, "`(?{scalar_text(kind)}` is not a group kind; use `(?:…)` or `(?<name>…)`"))
            }
        }
        index := 0
        if capture {
            self.groups = self.groups + 1
            index = self.groups
            &self.names.push(name)
        }
        self.depth = self.depth + 1
        inner :: &self.parse_alt(open)
        self.depth = self.depth - 1
        if !capture -> return Ok(inner)
        Ok(&self.emit(N_GROUP, index, 0, inner, false))
    }

    fn parse_group_name(&self, open: Int) -> String RegexError! {
        start :: self.i
        raw := [U8]{}
        loop {
            c :: self.peek()
            if c < 0 -> return Err(fail(open, "the group name is never closed by a `>`"))
            if c == 62 -> break
            if !is_group_name_char(c) -> return Err(fail(self.i, "a group name holds only ASCII letters, digits and `_`"))
            &raw.push(U8{c})
            self.i = self.i + 1
        }
        self.i = self.i + 1
        if raw.len() == 0 -> return Err(fail(start, "a named group needs a name"))
        if raw[0] >= 48 && raw[0] <= 57 -> return Err(fail(start, "a group name cannot start with a digit"))
        name :: String.from_bytes(raw) ?? ""
        loop other in self.names {
            if other == name -> return Err(fail(start, "the group name `{name}` is already taken"))
        }
        Ok(name)
    }

    fn parse_quant(&self, atom: Int) -> Int RegexError! {
        at :: self.i
        c :: self.peek()
        kind := N_STAR
        if c == 43 {
            kind = N_PLUS
        } else if c == 63 {
            kind = N_OPT
        } else if c == 123 {
            kind = N_RANGE
        } else if c != 42 {
            return Ok(atom)
        }
        self.i = self.i + 1
        lo := 0
        hi := -1
        if kind == N_RANGE {
            lo = &self.parse_count(at)
            hi = lo
            if self.peek() == 44 {
                self.i = self.i + 1
                hi = -1
                if self.peek() != 125 -> hi = &self.parse_count(at)
            }
            if self.peek() != 125 -> return Err(fail(at, "the counted repetition is never closed by a `}}`"))
            self.i = self.i + 1
            if lo > MAX_REPEAT || hi > MAX_REPEAT -> return Err(fail(at, "a counted repetition may repeat at most {MAX_REPEAT} times"))
            if hi >= 0 && hi < lo -> return Err(fail(at, "the repetition maximum {hi} is below its minimum {lo}"))
        }
        lazy := false
        if self.peek() == 63 {
            self.i = self.i + 1
            lazy = true
        }
        after :: self.peek()
        if after == 42 || after == 43 || after == 63 || after == 123 {
            return Err(fail(self.i, "a repetition cannot directly follow another; wrap the first in `(?:…)`"))
        }
        Ok(&self.emit(kind, lo, hi, atom, lazy))
    }

    /// A repetition count. Counts past MAX_REPEAT saturate, so the caller
    /// reports the cap and never an overflow.
    fn parse_count(&self, at: Int) -> Int RegexError! {
        n := 0
        got := false
        loop {
            d :: self.peek()
            if d < 48 || d > 57 -> break
            self.i = self.i + 1
            n = n * 10 + (d - 48)
            if n > MAX_REPEAT -> n = MAX_REPEAT + 1
            got = true
        }
        if !got -> return Err(fail(at, "a counted repetition needs a number, as in `{{3}}`, `{{3,}}` or `{{3,5}}`"))
        Ok(n)
    }

    // `]` first (after an optional `^`) is a member, so `[]a]` and `[^]]`
    // are classes.
    fn parse_class(&self, open: Int) -> Int RegexError! {
        neg := false
        if self.peek() == 94 {
            self.i = self.i + 1
            neg = true
        }
        lo :: self.kinds.len()
        loop {
            c :: self.peek()
            if c < 0 -> return Err(fail(open, "this `[` is never closed by a `]`"))
            if c == 93 && self.kinds.len() > lo {
                self.i = self.i + 1
                break
            }
            at :: self.i
            first :: &self.parse_class_item(self.kinds.len() == lo)
            if self.peek() == 45 && self.peek_at(1) != 93 && self.peek_at(1) >= 0 {
                self.i = self.i + 1
                last :: &self.parse_class_item(false)
                if first < 0 || last < 0 -> return Err(fail(at, "a class range needs one character at each end"))
                if last < first -> return Err(fail(at, "the class range `{scalar_text(first)}-{scalar_text(last)}` runs backwards"))
                &self.item(K_RANGE, first, last)
            } else if first >= 0 {
                &self.item(K_CHAR, first, first)
            } else {
                &self.item(-first - 1, 0, 0)
            }
        }
        Ok(&self.class_node(lo, neg))
    }

    /// One class member: a scalar (>= 0), or `-(kind + 1)` for a class
    /// escape such as `\d` or `\P{L}`. `leading` admits a literal `]`.
    fn parse_class_item(&self, leading: Bool) -> Int RegexError! {
        at :: self.i
        c :: &self.bump()
        if c == 93 && leading -> return Ok(c)
        if c == 91 -> return Err(fail(at, "write `\\[` for a literal `[` inside a class"))
        if c != 92 -> return Ok(c)
        &self.parse_escape(at, true)
    }

    fn parse_escape_atom(&self, at: Int) -> Int RegexError! {
        c :: self.peek()
        kind := -1
        if c == 98 -> kind = A_WORD
        if c == 66 -> kind = A_NOT_WORD
        if c == 65 -> kind = A_TEXT_START
        if c == 122 -> kind = A_TEXT_END
        if kind >= 0 {
            self.i = self.i + 1
            return Ok(&self.emit(N_ASSERT, kind, 0, -1, false))
        }
        code :: &self.parse_escape(at, false)
        if code >= 0 -> return Ok(&self.emit(N_LIT, code, 0, -1, false))
        member :: -code - 1
        lo :: self.kinds.len()
        if member >= K_NEGATED {
            &self.item(member - K_NEGATED, 0, 0)
            return Ok(&self.class_node(lo, true))
        }
        &self.item(member, 0, 0)
        Ok(&self.class_node(lo, false))
    }

    /// The escape after the `\` at `at`: a scalar (>= 0), or `-(kind + 1)`
    /// for a class escape.
    fn parse_escape(&self, at: Int, in_class: Bool) -> Int RegexError! {
        c :: &self.bump()
        if c < 0 -> return Err(fail(at, "a `\\` at the end of the pattern escapes nothing"))
        if c >= 48 && c <= 57 -> return Err(fail(at, "backreferences are not supported; the engine stays linear in the text"))
        if c == 100 -> return Ok(-(K_DIGIT + 1))
        if c == 68 -> return Ok(-(K_DIGIT + K_NEGATED + 1))
        if c == 119 -> return Ok(-(K_WORD + 1))
        if c == 87 -> return Ok(-(K_WORD + K_NEGATED + 1))
        if c == 115 -> return Ok(-(K_SPACE + 1))
        if c == 83 -> return Ok(-(K_SPACE + K_NEGATED + 1))
        if c == 112 {
            kind :: &self.parse_unicode_class(at)
            return Ok(-(kind + 1))
        }
        if c == 80 {
            kind :: &self.parse_unicode_class(at)
            return Ok(-(kind + K_NEGATED + 1))
        }
        if c == 110 -> return Ok(10)
        if c == 114 -> return Ok(13)
        if c == 116 -> return Ok(9)
        if c == 102 -> return Ok(12)
        if c == 118 -> return Ok(11)
        if c == 97 -> return Ok(7)
        if c == 120 || c == 117 -> return &self.parse_code_point(at, c)
        if in_class && (c == 98 || c == 66 || c == 65 || c == 122) {
            return Err(fail(at, "`\\{scalar_text(c)}` is an assertion, so it cannot appear inside `[]`"))
        }
        if is_escapable(c) -> return Ok(c)
        Err(fail(at, "`\\{scalar_text(c)}` is not an escape the regex engine knows; write `\\\\` for a literal backslash"))
    }

    /// `\xHH`, `\uHHHH`, or a braced `\x{…}`/`\u{…}` code point; `letter` is
    /// the `x` or `u`.
    fn parse_code_point(&self, at: Int, letter: Int) -> Int RegexError! {
        escape :: "\\{scalar_text(letter)}"
        value := 0
        if self.peek() == 123 {
            self.i = self.i + 1
            digits := 0
            loop self.peek() != 125 {
                h :: hex_value(self.peek())
                if h < 0 -> return Err(fail(at, "`{escape}{{…}}` needs hexadecimal digits closed by a `}}`"))
                self.i = self.i + 1
                digits = digits + 1
                if digits > 8 -> return Err(fail(at, "`{escape}{{…}}` names no Unicode scalar value"))
                value = value * 16 + h
            }
            self.i = self.i + 1
            if digits == 0 -> return Err(fail(at, "`{escape}{{}}` needs at least one hexadecimal digit"))
        } else {
            width :: if letter == 120 -> 2 else -> 4
            k := 0
            loop k < width {
                h :: hex_value(self.peek())
                if h < 0 -> return Err(fail(at, "`{escape}` needs exactly {width} hexadecimal digits, or braces as in `{escape}{{41}}`"))
                self.i = self.i + 1
                value = value * 16 + h
                k = k + 1
            }
        }
        if value > 1114111 || (value >= 55296 && value <= 57343) -> return Err(fail(at, "`{escape}` names no Unicode scalar value"))
        Ok(value)
    }

    /// The class after `\p`/`\P`: a braced name or a one-letter name.
    fn parse_unicode_class(&self, at: Int) -> Int RegexError! {
        raw := [U8]{}
        if self.peek() == 123 {
            self.i = self.i + 1
            loop {
                c :: &self.bump()
                if c < 0 -> return Err(fail(at, "the Unicode class name is never closed by a `}}`"))
                if c == 125 -> break
                if c > 127 -> return Err(fail(at, "a Unicode class name is ASCII, as in `\\p{{L}}`"))
                &raw.push(U8{c})
            }
        } else {
            c :: &self.bump()
            if !is_ascii_letter(c) -> return Err(fail(at, "`\\p` needs a class name, as in `\\p{{L}}` or `\\pL`"))
            &raw.push(U8{c})
        }
        name :: String.from_bytes(raw) ?? ""
        if name == "L" || name == "Letter" || name == "Alphabetic" -> return Ok(K_ALPHA)
        if name == "N" || name == "Number" -> return Ok(K_NUMBER)
        if name == "White_Space" || name == "Whitespace" -> return Ok(K_SPACE)
        Err(fail(at, "the Unicode class `{name}` is not supported; use L, Letter, Alphabetic, N, Number or White_Space"))
    }

    fn item(&self, kind: Int, lo: Int, hi: Int) Never! {
        &self.kinds.push(kind)
        &self.los.push(lo)
        &self.his.push(hi)
    }

    fn class_node(&self, lo: Int, neg: Bool) -> Int Never! {
        &self.nodes.push(Node{kind: N_CLASS, a: 0, b: 0, left: -1, neg: neg, lo: lo, hi: self.kinds.len()})
        self.nodes.len() - 1
    }

    fn emit(&self, kind: Int, a: Int, b: Int, left: Int, neg: Bool) -> Int Never! {
        &self.nodes.push(Node{kind: kind, a: a, b: b, left: left, neg: neg, lo: 0, hi: 0})
        self.nodes.len() - 1
    }

    fn list(&self, kind: Int, parts: [Int]) -> Int Never! {
        lo :: self.kids.len()
        loop part in parts -> &self.kids.push(part)
        &self.nodes.push(Node{kind: kind, a: 0, b: 0, left: -1, neg: false, lo: lo, hi: self.kids.len()})
        self.nodes.len() - 1
    }

    fn peek(self) -> Int Never! {
        if self.i >= self.cps.len() -> return -1
        self.cps[self.i]
    }

    fn peek_at(self, offset: Int) -> Int Never! {
        if self.i + offset >= self.cps.len() -> return -1
        self.cps[self.i + offset]
    }

    fn bump(&self) -> Int Never! {
        if self.i >= self.cps.len() -> return -1
        c :: self.cps[self.i]
        self.i = self.i + 1
        c
    }
}

fn hex_value(c: Int) -> Int Never! {
    if c >= 48 && c <= 57 -> return c - 48
    if c >= 97 && c <= 102 -> return c - 87
    if c >= 65 && c <= 70 -> return c - 55
    return -1
}

fn is_ascii_letter(c: Int) -> Bool Never! { (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }

// ASCII punctuation and space escape to themselves; `\<` and `\>` stay
// errors because other engines read them as word boundaries.
fn is_escapable(c: Int) -> Bool Never! {
    c >= 32 && c < 127 && c != 60 && c != 62 && !is_ascii_letter(c) && (c < 48 || c > 57)
}

// Program instructions. `args` holds a literal scalar, a Save slot (-1 =
// no-op), an assertion kind, or a class's first member row (`ends` its end).
// A consuming instruction continues at `xs`; Split prefers `xs` over `ys`,
// which makes the scan leftmost-first.
OP_LIT :: 0
OP_ANY :: 1
OP_CLASS :: 2
OP_SAVE :: 3
OP_SPLIT :: 4
OP_ASSERT :: 5
OP_MATCH :: 6

// A fragment's dangling exits: `inst` patches `xs`, `-inst - 1` patches `ys`.
struct Frag {
    start: Int
    outs: [Int]
}

struct Compiler {
    nodes: [Node]
    kids: [Int]
    ops: [Int]
    args: [Int]
    ends: [Int]
    negs: [Bool]
    xs: [Int]
    ys: [Int]
    too_big: Bool
}

impl Compiler {
    fn push(&self, op: Int, arg: Int, end: Int, neg: Bool) -> Int Never! {
        if self.ops.len() >= MAX_PROGRAM -> self.too_big = true
        &self.ops.push(op)
        &self.args.push(arg)
        &self.ends.push(end)
        &self.negs.push(neg)
        &self.xs.push(-1)
        &self.ys.push(-1)
        self.ops.len() - 1
    }

    fn single(&self, op: Int, arg: Int, end: Int, neg: Bool) -> Frag Never! {
        id :: &self.push(op, arg, end, neg)
        Frag{start: id, outs: [Int]{id}}
    }

    fn patch(&self, outs: [Int], target: Int) Never! {
        loop code in outs {
            if code >= 0 {
                self.xs[code] = target
            } else {
                self.ys[-code - 1] = target
            }
        }
    }

    /// `frag` then `after`; a `frag` with no start yet is empty.
    fn then(&self, frag: Frag, after: Frag) -> Frag Never! {
        if frag.start < 0 -> return after.copy()
        &self.patch(frag.outs, after.start)
        Frag{start: frag.start, outs: after.outs.copy()}
    }

    /// A Split whose preferred branch enters `body` (the later one when
    /// `lazy`); returns the exit code of the other branch.
    fn prefer(&self, split: Int, body: Int, lazy: Bool) -> Int Never! {
        if lazy {
            self.ys[split] = body
            return split
        }
        self.xs[split] = body
        return -split - 1
    }

    fn star(&self, node: Int, lazy: Bool) -> Frag Never! {
        atom :: &self.compile(node)
        split :: &self.push(OP_SPLIT, 0, 0, false)
        exit :: &self.prefer(split, atom.start, lazy)
        &self.patch(atom.outs, split)
        Frag{start: split, outs: [Int]{exit}}
    }

    fn optional(&self, node: Int, lazy: Bool) -> Frag Never! {
        atom :: &self.compile(node)
        split :: &self.push(OP_SPLIT, 0, 0, false)
        exit :: &self.prefer(split, atom.start, lazy)
        outs := atom.outs
        &outs.push(exit)
        Frag{start: split, outs: outs}
    }

    // Recursion here follows group and quantifier nesting, never the text
    // or the length of a sequence. Once the program passes MAX_PROGRAM the
    // rest compiles to nothing; the caller reports the error.
    fn compile(&self, node: Int) -> Frag Never! {
        if self.too_big -> return Frag{start: 0, outs: [Int]{}}
        n :: self.nodes[node].copy()
        if n.kind == N_LIT -> return &self.single(OP_LIT, n.a, 0, false)
        if n.kind == N_ANY -> return &self.single(OP_ANY, 0, 0, false)
        if n.kind == N_CLASS -> return &self.single(OP_CLASS, n.lo, n.hi, n.neg)
        if n.kind == N_ASSERT -> return &self.single(OP_ASSERT, n.a, 0, false)
        if n.kind == N_SEQ {
            frag := Frag{start: -1, outs: [Int]{}}
            k := n.lo
            loop k < n.hi {
                piece :: &self.compile(self.kids[k])
                frag = &self.then(frag, piece)
                k = k + 1
            }
            return frag
        }
        if n.kind == N_ALT {
            // A chain of Splits, each preferring its arm over the later ones.
            outs := [Int]{}
            start := -1
            pending := -1
            k := n.lo
            loop k < n.hi {
                split := -1
                if k + 1 < n.hi -> split = &self.push(OP_SPLIT, 0, 0, false)
                arm :: &self.compile(self.kids[k])
                entry := arm.start
                if split >= 0 {
                    self.xs[split] = arm.start
                    entry = split
                }
                if pending >= 0 {
                    self.ys[pending] = entry
                } else {
                    start = entry
                }
                pending = split
                loop code in arm.outs -> &outs.push(code)
                k = k + 1
            }
            return Frag{start: start, outs: outs}
        }
        if n.kind == N_GROUP {
            open :: &self.push(OP_SAVE, n.a * 2, 0, false)
            inner :: &self.compile(n.left)
            self.xs[open] = inner.start
            close :: &self.push(OP_SAVE, n.a * 2 + 1, 0, false)
            &self.patch(inner.outs, close)
            return Frag{start: open, outs: [Int]{close}}
        }
        if n.kind == N_STAR -> return &self.star(n.left, n.neg)
        if n.kind == N_PLUS {
            atom :: &self.compile(n.left)
            split :: &self.push(OP_SPLIT, 0, 0, false)
            exit :: &self.prefer(split, atom.start, n.neg)
            &self.patch(atom.outs, split)
            return Frag{start: atom.start, outs: [Int]{exit}}
        }
        if n.kind == N_OPT -> return &self.optional(n.left, n.neg)
        if n.kind == N_RANGE {
            // `{min,max}`: min required copies, then max - min optional
            // copies, or one star when unbounded.
            frag := Frag{start: -1, outs: [Int]{}}
            k := 0
            loop k < n.a && !self.too_big {
                piece :: &self.compile(n.left)
                frag = &self.then(frag, piece)
                k = k + 1
            }
            if n.b < 0 {
                tail :: &self.star(n.left, n.neg)
                frag = &self.then(frag, tail)
            } else {
                loop k < n.b && !self.too_big {
                    tail :: &self.optional(n.left, n.neg)
                    frag = &self.then(frag, tail)
                    k = k + 1
                }
            }
            if frag.start < 0 -> return &self.single(OP_SAVE, -1, 0, false)
            return frag
        }
        // N_EMPTY: a no-op save keeps the fragment shape uniform.
        &self.single(OP_SAVE, -1, 0, false)
    }
}

/// The scan's working set, allocated once per call and reused at every
/// scalar: threads are parallel Int rows in priority order (current threads
/// first, the next step's appended, then moved down), `seen` marks the pcs
/// reached in the current epoch, the epsilon stack is explicit, and
/// captures are a persistent list (`aslot`/`apos`/`aprev`) so forking a
/// thread copies one Int. `hi` is the text's end; under `full` a thread
/// matches only there.
struct VM {
    seen: [Int]
    epoch: Int
    hi: Int
    full: Bool
    sp: Int
    spc: [Int]
    sstart: [Int]
    scaps: [Int]
    nt: Int
    tpc: [Int]
    tstart: [Int]
    tcaps: [Int]
    m_pc: Int
    m_start: Int
    m_caps: Int
    aslot: [Int]
    apos: [Int]
    aprev: [Int]
}

struct Run {
    start: Int
    end: Int
    caps: [Int]
}

fn new_vm(size: Int, hi: Int, full: Bool) -> VM Never! {
    seen :: filled(size, -1)
    // Every pc is entered once per epoch and pushes at most two edges, and
    // the current and next thread sets hold at most one thread per pc, so
    // these rows never grow during the scan.
    rows :: 2 * size + 2
    VM{
    seen: seen,
    epoch: 0,
    hi: hi,
    full: full,
    sp: 0,
    spc: filled(rows, 0),
    sstart: filled(rows, 0),
    scaps: filled(rows, 0),
    nt: 0,
    tpc: filled(rows, 0),
    tstart: filled(rows, 0),
    tcaps: filled(rows, 0),
    m_pc: -1,
    m_start: -1,
    m_caps: -1,
    aslot: [Int]{},
    apos: [Int]{},
    aprev: [Int]{},
    }
}

impl VM {
    /// Drop every thread and capture record; the scan restarts afresh.
    fn reset(&self) Never! {
        self.nt = 0
        self.epoch = self.epoch + 1
        self.m_pc = -1
        &self.drop_captures()
    }

    fn drop_captures(&self) Never! {
        &self.aslot.clear()
        &self.apos.clear()
        &self.aprev.clear()
    }

    fn push_edge(&self, pc: Int, start: Int, caps: Int) Never! {
        self.spc[self.sp] = pc
        self.sstart[self.sp] = start
        self.scaps[self.sp] = caps
        self.sp = self.sp + 1
    }

    /// Follow every epsilon edge from `pc` with the explicit stack, in
    /// priority order, recording consuming and matching threads once per
    /// pc. The first Match reached is the epoch's preferred match.
    fn add(&self, re: Regex, text: [U8], pc: Int, start: Int, caps: Int, pos: Int, capture: Bool) Never! {
        &self.push_edge(pc, start, caps)
        loop self.sp > 0 {
            self.sp = self.sp - 1
            p :: self.spc[self.sp].copy()
            s :: self.sstart[self.sp].copy()
            c :: self.scaps[self.sp].copy()
            if self.seen[p] == self.epoch -> next
            self.seen[p] = self.epoch
            op :: re.ops[p]
            if op == OP_SAVE {
                head := c
                if capture && re.args[p] >= 0 {
                    &self.aslot.push(re.args[p])
                    &self.apos.push(pos)
                    &self.aprev.push(c)
                    head = self.aslot.len() - 1
                }
                &self.push_edge(re.xs[p], s, head)
                next
            }
            if op == OP_SPLIT {
                &self.push_edge(re.ys[p], s, c)
                &self.push_edge(re.xs[p], s, c)
                next
            }
            if op == OP_ASSERT {
                if assert_holds(re, text, re.args[p], pos, self.hi) -> &self.push_edge(re.xs[p], s, c)
                next
            }
            if op == OP_MATCH {
                if self.full && pos != self.hi -> next
                if self.m_pc < 0 {
                    self.m_pc = p
                    self.m_start = s
                    self.m_caps = c
                }
            }
            self.tpc[self.nt] = p
            self.tstart[self.nt] = s
            self.tcaps[self.nt] = c
            self.nt = self.nt + 1
        }
    }

    /// Advance every current thread over the scalar `cp` into a new epoch,
    /// then move the next threads down over the current ones. A Match
    /// thread cuts every lower-priority thread after it. The per-step paths
    /// use counted `loop k < n` forms: a range loop allocates its range each
    /// time it is entered.
    fn step(&self, re: Regex, text: [U8], cp: Int, next_pos: Int, capture: Bool) Never! {
        n :: self.nt
        self.epoch = self.epoch + 1
        self.m_pc = -1
        k := 0
        loop k < n {
            pc :: self.tpc[k].copy()
            start :: self.tstart[k].copy()
            caps :: self.tcaps[k].copy()
            k = k + 1
            if re.ops[pc] == OP_MATCH -> break
            if !consumes(re, pc, cp) -> next
            &self.add(re, text, re.xs[pc], start, caps, next_pos, capture)
        }
        m :: self.nt - n
        j := 0
        loop j < m {
            self.tpc[j] = self.tpc[n + j]
            self.tstart[j] = self.tstart[n + j]
            self.tcaps[j] = self.tcaps[n + j]
            j = j + 1
        }
        self.nt = m
    }

    fn slots(self, head: Int, start: Int, end: Int, groups: Int, capture: Bool) -> [Int] Never! {
        if !capture -> return [Int]{}
        out := filled((groups + 1) * 2, -1)
        at := head
        loop at >= 0 {
            slot :: self.aslot[at]
            if slot < out.len() && out[slot] < 0 -> out[slot] = self.apos[at]
            at = self.aprev[at]
        }
        out[0] = start
        out[1] = end
        out
    }
}

fn assert_holds(re: Regex, text: [U8], kind: Int, pos: Int, hi: Int) -> Bool Never! {
    if kind == A_LINE_START -> return pos == 0 || (re.flags.multiline && text[pos - 1] == (U8{10}))
    if kind == A_TEXT_START -> return pos == 0
    if kind == A_TEXT_END -> return pos == hi
    before :: pos > 0 && is_group_name_char(Int.from_u8(text[pos - 1]))
    after :: pos < hi && is_group_name_char(Int.from_u8(text[pos]))
    if kind == A_WORD -> return before != after
    before == after
}

fn filled(n: Int, value: Int) -> [Int] Never! {
    out := [Int]{}
    loop out.len() < n -> &out.push(value)
    out
}

fn next_search_pos(text: [U8], start: Int, end: Int, hi: Int) -> Int Never! {
    if end > start -> return end
    if end >= hi -> return hi + 1
    end + lead_width(text[end])
}

/// The leftmost-first scan: start threads enter one shared VM at each
/// scalar boundary until a match is found, the highest-priority thread's
/// match wins (greedy repeats run as far as they can, lazy ones stop
/// early, alternation prefers its first arm), and the scan resumes at the
/// non-overlap boundary. `anchored` starts only at 0; `full` also requires
/// the match to end at the text's end. Collects at most `limit` runs (all
/// when `limit` < 0).
fn scan(re: Regex, text: [U8], anchored: Bool, full: Bool, capture: Bool, stop_on_match: Bool, limit: Int) -> [Run] Never! {
    out := [Run]{}
    hi :: text.len()
    vm := new_vm(re.ops.len(), hi, full)
    pos := 0
    has_last := false
    last_start := 0
    last_end := 0
    last_caps := -1
    single_start :: anchored || re.anchored_start
    loop {
        if vm.m_pc >= 0 {
            has_last = true
            last_start = vm.m_start
            last_end = pos
            last_caps = vm.m_caps
        }
        if !has_last && (!single_start || pos == 0) {
            // With no live thread and no recorded match, no capture record
            // is reachable, so the list restarts empty instead of growing
            // with the text.
            if vm.nt == 0 -> &vm.drop_captures()
            &vm.add(re, text, re.start, pos, -1, pos, capture)
            if vm.m_pc >= 0 {
                has_last = true
                last_start = pos
                last_end = pos
                last_caps = vm.m_caps
            }
        }
        if has_last && stop_on_match {
            &out.push(Run{start: last_start, end: last_end, caps: [Int]{}})
            return out
        }
        // Emit once no thread outranks the recorded match.
        if has_last && (pos >= hi || vm.nt == 0 || re.ops[vm.tpc[0]] == OP_MATCH) {
            &out.push(Run{start: last_start, end: last_end, caps: vm.slots(last_caps, last_start, last_end, re.groups, capture)})
            if limit >= 0 && out.len() >= limit -> return out
            resume :: next_search_pos(text, last_start, last_end, hi)
            if resume > hi -> return out
            &vm.reset()
            has_last = false
            pos = resume
            next
        }
        if !has_last && (pos >= hi || (vm.nt == 0 && single_start)) -> return out
        next_pos :: pos + lead_width(text[pos])
        &vm.step(re, text, decode_at(text, pos), next_pos, capture)
        pos = next_pos
    }
}

fn consumes(re: Regex, pc: Int, cp: Int) -> Bool Never! {
    op :: re.ops[pc]
    if op == OP_LIT {
        lit :: re.args[pc]
        if lit == cp -> return true
        return re.flags.ignore_case && simple_fold(lit) == simple_fold(cp)
    }
    if op == OP_ANY -> return re.flags.dot_matches_newline || cp != 10
    hit := false
    k := re.args[pc]
    loop k < re.ends[pc] {
        if member_matches(re.kinds[k], re.los[k], re.his[k], cp, re.flags.ignore_case) {
            hit = true
            break
        }
        k = k + 1
    }
    hit != re.negs[pc]
}

fn member_matches(kind: Int, lo: Int, hi: Int, cp: Int, ignore_case: Bool) -> Bool Never! {
    if kind == K_CHAR {
        if lo == cp -> return true
        return ignore_case && simple_fold(lo) == simple_fold(cp)
    }
    if kind == K_RANGE {
        if lo <= cp && cp <= hi -> return true
        if !ignore_case -> return false
        // Under ignore_case a scalar is in the range when either case of it
        // is, so `[A-Z]` takes `q` and `[Z-a]` still takes `[`.
        lower :: simple_fold(cp)
        if lo <= lower && lower <= hi -> return true
        upper :: simple_upper(cp)
        return lo <= upper && upper <= hi
    }
    if kind >= K_NEGATED -> return !member_matches(kind - K_NEGATED, lo, hi, cp, ignore_case)
    if kind == K_DIGIT -> return cp >= 48 && cp <= 57
    if kind == K_WORD {
        return cp == 95 || (cp >= 48 && cp <= 57) || (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122)
    }
    if kind == K_SPACE {
        if cp < 128 -> return cp == 32 || (cp >= 9 && cp <= 13)
        return scalar_text(cp).is_whitespace()
    }
    if kind == K_ALPHA {
        if cp < 128 -> return (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122)
        return scalar_text(cp).is_alphabetic()
    }
    // K_NUMBER
    if cp < 128 -> return cp >= 48 && cp <= 57
    scalar_text(cp).is_numeric()
}

/// Unicode simple case folding as the Prelude computes it: the first scalar
/// of the scalar's lowercase mapping.
fn simple_fold(cp: Int) -> Int Never! {
    if cp < 128 {
        if cp >= 65 && cp <= 90 -> return cp + 32
        return cp
    }
    lowered :: scalar_text(cp).to_lower().bytes()
    if lowered.len() == 0 -> return cp
    decode_at(lowered, 0)
}

/// The first scalar of the scalar's uppercase mapping.
fn simple_upper(cp: Int) -> Int Never! {
    if cp < 128 {
        if cp >= 97 && cp <= 122 -> return cp - 32
        return cp
    }
    raised :: scalar_text(cp).to_upper().bytes()
    if raised.len() == 0 -> return cp
    decode_at(raised, 0)
}

fn scalar_text(cp: Int) -> String Never! {
    out := [U8]{}
    if cp < 128 {
        &out.push(U8{cp})
    } else if cp < 2048 {
        &out.push(U8{Int{192}.bit_or(cp >> 6)})
        &out.push(U8{Int{128}.bit_or(cp.bit_and(63))})
    } else if cp < 65536 {
        &out.push(U8{Int{224}.bit_or(cp >> 12)})
        &out.push(U8{Int{128}.bit_or((cp >> 6).bit_and(63))})
        &out.push(U8{Int{128}.bit_or(cp.bit_and(63))})
    } else {
        &out.push(U8{Int{240}.bit_or(cp >> 18)})
        &out.push(U8{Int{128}.bit_or((cp >> 12).bit_and(63))})
        &out.push(U8{Int{128}.bit_or((cp >> 6).bit_and(63))})
        &out.push(U8{Int{128}.bit_or(cp.bit_and(63))})
    }
    String.from_bytes(out) ?? ""
}

// UTF-8 width from a lead byte. Jet Strings are valid UTF-8.
fn lead_width(lead: U8) -> Int Never! {
    n :: Int.from_u8(lead)
    if n < 128 -> return 1
    if n < 224 -> return 2
    if n < 240 -> return 3
    4
}

fn decode_at(raw: [U8], i: Int) -> Int Never! {
    first :: Int.from_u8(raw[i])
    if first < 128 -> return first
    width :: lead_width(raw[i])
    cp := first.bit_and(7)
    if width == 2 -> cp = first.bit_and(31)
    if width == 3 -> cp = first.bit_and(15)
    k := 1
    loop k < width && i + k < raw.len() {
        cp = (cp << 6).bit_or(Int.from_u8(raw[i + k]).bit_and(63))
        k = k + 1
    }
    cp
}

fn decode_all(raw: [U8]) -> [Int] Never! {
    out := [Int]{}
    i := 0
    loop i < raw.len() {
        &out.push(decode_at(raw, i))
        i = i + lead_width(raw[i])
    }
    out
}

/// Byte offset -> character position, moving forward through one text.
struct CharCursor {
    byte: Int
    count: Int
}

impl CharCursor {
    fn at(&self, raw: [U8], byte: Int) -> Int Never! {
        if byte < self.byte {
            self.byte = 0
            self.count = 0
        }
        loop self.byte < byte && self.byte < raw.len() {
            b :: Int.from_u8(raw[self.byte])
            if b < 128 || b >= 192 -> self.count = self.count + 1
            self.byte = self.byte + 1
        }
        self.count
    }
}

fn find_match(pattern: Regex, text: String) -> Match? Never! {
    raw :: text.bytes()
    runs :: scan(pattern, raw, false, false, pattern.groups > 0, false, 1)
    if runs.len() == 0 -> return None
    chars := CharCursor{byte: 0, count: 0}
    Val(make_match(pattern, raw, runs[0], &chars))
}

/// The Match for one run; its captures come from the scan itself.
fn make_match(re: Regex, raw: [U8], run: Run, chars: &CharCursor) -> Match Never! {
    caps :: run.caps
    first :: &chars.at(raw, run.start)
    last :: &chars.at(raw, run.end)
    groups := [String]{}
    spans := [Int]{}
    g := 0
    loop g < re.groups {
        g = g + 1
        start := -1
        end := -1
        if 2 * g + 1 < caps.len() {
            start = caps[2 * g]
            end = caps[2 * g + 1]
        }
        if start >= 0 && end >= start {
            &groups.push(slice(raw, start, end))
            at :: first + char_count(raw, run.start, start)
            &spans.push(at)
            &spans.push(at + char_count(raw, start, end))
        } else {
            &groups.push("")
            &spans.push(-1)
            &spans.push(-1)
        }
    }
    Match{start: first, end: last, text: slice(raw, run.start, run.end), groups: groups, spans: spans, names: re.names.copy()}
}

/// The number of characters (Unicode scalars) in `raw[from..<to]`.
fn char_count(raw: [U8], from: Int, to: Int) -> Int Never! {
    count := 0
    i := from
    loop i < to {
        b :: Int.from_u8(raw[i])
        if b < 128 || b >= 192 -> count = count + 1
        i = i + 1
    }
    count
}

fn slice(raw: [U8], start: Int, end: Int) -> String Never! {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i >= raw.len() -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}

fn is_group_name_char(n: Int) -> Bool Never! {
    n == 95 ||
        (n >= 48 && n <= 57) ||
        (n >= 65 && n <= 90) ||
        (n >= 97 && n <= 122)
}

fn is_meta(b: U8) -> Bool Never! {
    n :: b
    n == 92 || n == 46 || n == 94 || n == 36 || n == 42 || n == 43 || n == 63 || n == 40 || n == 41 || n == 91 || n == 93 || n == 123 || n == 125 || n == 124
}
/// Python-style constructor spelling for a runtime pattern.
fn regex(pattern: String) -> Regex RegexError! { compile(pattern) }

/// Return the canonical source pattern represented by a compiled regex.
fn join(pattern: Regex) -> String Never! { pattern.pattern }
/// Python `re` spellings over the same compiled Regex carrier.
fn search(pattern: Regex, text: String) -> Match? Never! { match(pattern, text) }
fn findall(pattern: Regex, text: String) -> [String] Never! { find_all(pattern, text) }
fn fullmatch(pattern: Regex, text: String) -> Bool Never! { full_match(pattern, text) }
fn sub(pattern: Regex, text: String, replacement: String) -> String Never! {
    replace(pattern, text, replacement)
}
fn subn(pattern: Regex, text: String, replacement: String) -> (text: String, count: Int) Never! {
    ms :: matches(pattern, text)
    (text: replace(pattern, text, replacement), count: ms.len())
}
