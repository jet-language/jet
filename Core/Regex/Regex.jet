package {
    name: "core.regex"
    version: "0.0.1"
    edition: "2026"
    description: "Checked regular expressions."
    license: "MIT"
    outputs: {
        regex: .Library{ entry: regex }
    }
}

// core.regex — one engine, compile-checked literals, fallible runtime.
//
// `Regex{"..."}` literals are checked by the compiler. `compile` is for
// patterns that arrive at run time. The engine is a Thompson/Pike VM: the
// pattern is parsed as Unicode scalars, compiles to Consume/Save/Split/Assert/
// Match instructions, and one scan advances every live thread a scalar at a
// time, so matching is linear in the text with no recursion and no budget.
// - leftmost start, captures numbered by their `(`, `(?:…)`, `(?<name>…)`,
//   `*` `+` `?` `{n}` `{n,}` `{n,m}` (counts up to MAX_REPEAT), `.`, `^`,
//   `$` (end of text only);
// - classes match scalars: `[]`/`[^]` members and ranges, `\d` and `\w`
//   (ASCII), `\s` (Unicode White_Space), `\p{L}`/`\p{Letter}`/
//   `\p{Alphabetic}` (Alphabetic), `\p{N}`/`\p{Number}` (Numeric),
//   `\p{White_Space}`/`\p{Whitespace}`, and `\P{…}` outside `[]`;
// - `ignore_case` compares Unicode simple lowercase mappings;
// - backreferences and lookaround are syntax errors.
// Match.start and Match.end count characters (Unicode scalars), so they
// compose with String indexing. The scan reuses one set of thread lists for
// the whole text. A pattern that does not compile fails with RegexError,
// never a panic.

#Error
enum RegexError {
    Syntax
    Cache
}

/// Displays as its inline-flag letters: `i` ignore_case, `m` multiline,
/// `s` dot_matches_newline (`"im"`; `""` for the defaults).
struct RegexFlags {
    ignore_case: Bool
    multiline: Bool
    dot_matches_newline: Bool
    impl Display {
        fn display(self) -> String {
            i :: if self.ignore_case -> "i" else -> ""
            m :: if self.multiline -> "m" else -> ""
            s :: if self.dot_matches_newline -> "s" else -> ""
            "{i}{m}{s}"
        }
    }
}

struct Pattern {
    pattern: String
}

struct RegexFlag {
    name: String
    value: Int
}

/// A compiled program: one row per instruction in `ops`/`args`/`ends`/
/// `negs`/`xs`/`ys`, and one row per class member in `kinds`/`los`/`his`.
struct Regex {
    pattern: String
    flags: RegexFlags
    priv ops: [Int]
    priv args: [Int]
    priv ends: [Int]
    priv negs: [Bool]
    priv xs: [Int]
    priv ys: [Int]
    priv kinds: [Int]
    priv los: [Int]
    priv his: [Int]
    priv start: Int
    priv anchored_start: Bool
    priv groups: Int
    priv names: [String]
}

/// `start` and `end` are character (Unicode scalar) positions in the text.
/// `groups` holds each capture group's text, `""` for a group that took no
/// part; `group`, `group_start` and `group_end` tell the two apart.
struct Match {
    start: Int
    end: Int
    text: String
    groups: [String]
    priv spans: [Int]
    priv names: [String]
}

impl Regex {
    fn is_match(self, text: String) -> Bool Never! { is_match(self, text) }
    fn full_match(self, text: String) -> Bool Never! { full_match(self, text) }
    fn match(self, text: String) -> Match? Never! { match(self, text) }
    fn find(self, text: String) -> String? Never! { find(self, text) }
    fn find_all(self, text: String) -> [String] Never! { find_all(self, text) }
    fn matches(self, text: String) -> [Match] Never! { matches(self, text) }
    fn split(self, text: String) -> [String] Never! { split(self, text) }
    fn split_limit(self, text: String, n: Int) -> [String] Never! { split_limit(self, text, n) }
    fn replace(self, text: String, replacement: String) -> String Never! { replace(self, text, replacement) }
    fn replace_first(self, text: String, replacement: String) -> String Never! { replace_first(self, text, replacement) }

    /// Replace every match with what `replacer` returns for it.
    fn replace_all_with(self, text: String, replacer: fn(Match) -> String Never!) -> String Never! {
        raw :: text.bytes()
        out := [U8]{}
        cur := 0
        chars := CharCursor{byte: 0, count: 0}
        vm := new_vm(self.ops.len())
        loop run in scan_in(self, &vm, raw, 0, raw.len(), false, false, false, -1) {
            k := cur
            loop k < run.start {
                &out.push(raw[k])
                k = k + 1
            }
            m :: make_match(self, &vm, raw, run, &chars, true)
            loop b in replacer(m).bytes() -> &out.push(b)
            cur = run.end
        }
        loop cur < raw.len() {
            &out.push(raw[cur])
            cur = cur + 1
        }
        String.from_bytes(out) ?? ""
    }
}

impl Match {
    /// Group `n`'s text: 0 is the whole match; None when the pattern has no
    /// group `n` or the group took no part in this match.
    fn group(self, n: Int) -> String? Never! {
        if n == 0 -> return Val(self.text.copy())
        if n < 0 || n > self.groups.len() || self.spans[2 * n - 2] < 0 -> return None
        Val(self.groups[n - 1].copy())
    }

    /// The text of the group named `name`, as `group` reports it.
    fn name(self, name: String) -> String? Never! {
        loop g in 0..<self.names.len() {
            if self.names[g] != "" && self.names[g] == name -> return self.group(g + 1)
        }
        None
    }

    /// The character position where group `n` starts (0 is the whole match).
    fn group_start(self, n: Int) -> Int? Never! {
        if n == 0 -> return Val(self.start)
        if n < 0 || n > self.groups.len() || self.spans[2 * n - 2] < 0 -> return None
        Val(self.spans[2 * n - 2])
    }

    /// The character position where group `n` ends (0 is the whole match).
    fn group_end(self, n: Int) -> Int? Never! {
        if n == 0 -> return Val(self.end)
        if n < 0 || n > self.groups.len() || self.spans[2 * n - 2] < 0 -> return None
        Val(self.spans[2 * n - 1])
    }
}

fn flags(ignore_case: Bool, multiline: Bool, dot_matches_newline: Bool) -> RegexFlags Never! {
    RegexFlags{
    ignore_case: ignore_case,
    multiline: multiline,
    dot_matches_newline: dot_matches_newline,
    }
}

/// Quote regex metacharacters in `text` so it matches as a literal.
fn escape(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        if is_meta(b) -> &out.push(U8{92})
        &out.push(b)
    }
    String.from_bytes(out) ?? ""
}

fn compile(pattern: String) -> Regex RegexError! { compile_with(pattern, flags(false, false, false)) }

fn compile_with(pattern: String, flags: RegexFlags) -> Regex RegexError! {
    p := Parser{
    cps: decode_all(pattern.bytes()),
    i: 0,
    nodes: [Node]{},
    kinds: [Int]{},
    los: [Int]{},
    his: [Int]{},
    groups: 0,
    names: [String]{},
    }
    root :: &p.parse_alt(false)
    if p.i != p.cps.len() -> return Err(RegexError.Syntax)
    c := Compiler{
    nodes: p.nodes,
    ops: [Int]{},
    args: [Int]{},
    ends: [Int]{},
    negs: [Bool]{},
    xs: [Int]{},
    ys: [Int]{},
    }
    frag :: &c.compile(root)
    done :: &c.push(OP_MATCH, 0, 0, false)
    &c.patch(frag.outs, done)
    anchored :: c.ops[frag.start] == OP_ASSERT_START
    Ok(Regex{
    pattern: pattern,
    flags: flags,
    ops: c.ops,
    args: c.args,
    ends: c.ends,
    negs: c.negs,
    xs: c.xs,
    ys: c.ys,
    kinds: p.kinds,
    los: p.los,
    his: p.his,
    start: frag.start,
    anchored_start: anchored,
    groups: p.groups,
    names: p.names,
    })
}

fn is_match(pattern: Regex, text: String) -> Bool Never! {
    scan(pattern, text.bytes(), false, false, true, 1).len() > 0
}

fn full_match(pattern: Regex, text: String) -> Bool Never! {
    raw :: text.bytes()
    runs :: scan(pattern, raw, true, false, false, 1)
    runs.len() == 1 && runs[0].start == 0 && runs[0].end == raw.len()
}

fn match(pattern: Regex, text: String) -> Match? Never! { find_match(pattern, text) }
fn finditer(pattern: Regex, text: String) -> [Match] Never! { matches(pattern, text) }

/// The source-owned engine has no process-global cache to mutate. Report that
/// capability explicitly instead of pretending a purge happened.
fn purge() RegexError! {
    return Err(RegexError.Cache)
}

fn find(pattern: Regex, text: String) -> String? Never! {
    raw :: text.bytes()
    runs :: scan(pattern, raw, false, false, false, 1)
    if runs.len() == 0 -> return None
    Val(slice(raw, runs[0].start, runs[0].end))
}

fn find_all(pattern: Regex, text: String) -> [String] Never! {
    raw :: text.bytes()
    out := [String]{}
    loop run in scan(pattern, raw, false, false, false, -1) -> &out.push(slice(raw, run.start, run.end))
    out
}

fn matches(pattern: Regex, text: String) -> [Match] Never! {
    raw :: text.bytes()
    out := [Match]{}
    chars := CharCursor{byte: 0, count: 0}
    vm := new_vm(pattern.ops.len())
    loop run in scan_in(pattern, &vm, raw, 0, raw.len(), false, false, false, -1) {
        m :: make_match(pattern, &vm, raw, run, &chars, true)
        &out.push(m)
    }
    out
}

fn split(pattern: Regex, text: String) -> [String] Never! { split_limit(pattern, text, 0) }

fn split_limit(pattern: Regex, text: String, n: Int) -> [String] Never! {
    raw :: text.bytes()
    if n == 1 -> return [String]{text}
    limit := -1
    if n > 1 -> limit = n - 1
    out := [String]{}
    cur := 0
    loop run in scan(pattern, raw, false, false, false, limit) {
        &out.push(slice(raw, cur, run.start))
        cur = run.end
    }
    &out.push(slice(raw, cur, raw.len()))
    out
}

/// Replace every match, expanding `replacement` as `expand` does.
fn replace(pattern: Regex, text: String, replacement: String) -> String Never! { replace_n(pattern, text, replacement, false) }

/// Expand a replacement template for one match: `$N` and `${N}` insert group
/// N (`$0` is the whole match), `${name}` the named group, and `$$` one `$`.
/// A group the pattern lacks, or one that took no part, inserts nothing; any
/// other `$` is literal text.
fn expand(m: Match, template: String) -> String Never! {
    raw :: template.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        b :: raw[i]
        i = i + 1
        if b != (U8{36}) || i >= raw.len() {
            &out.push(b)
            next
        }
        n :: Int.from_u8(raw[i])
        if n == 36 {
            &out.push(b)
            i = i + 1
            next
        }
        if n >= 48 && n <= 57 {
            j := i
            loop j < raw.len() && raw[j] >= 48 && raw[j] <= 57 -> j = j + 1
            loop c in group_by_reference(m, raw, i, j).bytes() -> &out.push(c)
            i = j
            next
        }
        if n == 123 {
            j := i + 1
            loop j < raw.len() && raw[j] != (U8{125}) -> j = j + 1
            if j < raw.len() {
                loop c in group_by_reference(m, raw, i + 1, j).bytes() -> &out.push(c)
                i = j + 1
                next
            }
        }
        &out.push(b)
    }
    String.from_bytes(out) ?? ""
}

/// The text `raw[from..<to]` names in a template: a group number when it is
/// all digits, otherwise a group name.
fn group_by_reference(m: Match, raw: [U8], from: Int, to: Int) -> String Never! {
    if from == to -> return ""
    index := 0
    k := from
    loop k < to {
        d :: Int.from_u8(raw[k])
        if d < 48 || d > 57 {
            return m.name(slice(raw, from, to)) ?? ""
        }
        if index > (INT_MAX - (d - 48)) /% 10 -> return ""
        index = index * 10 + (d - 48)
        k = k + 1
    }
    m.group(index) ?? ""
}

fn replace_first(pattern: Regex, text: String, replacement: String) -> String Never! { replace_n(pattern, text, replacement, true) }

fn replace_n(pattern: Regex, text: String, replacement: String, first_only: Bool) -> String Never! {
    raw :: text.bytes()
    limit := -1
    if first_only -> limit = 1
    out := [U8]{}
    cur := 0
    chars := CharCursor{byte: 0, count: 0}
    vm := new_vm(pattern.ops.len())
    loop run in scan_in(pattern, &vm, raw, 0, raw.len(), false, false, false, limit) {
        k := cur
        loop k < run.start {
            &out.push(raw[k])
            k = k + 1
        }
        m :: make_match(pattern, &vm, raw, run, &chars, true)
        loop b in expand(m, replacement).bytes() -> &out.push(b)
        cur = run.end
    }
    rest := cur
    loop rest < raw.len() {
        &out.push(raw[rest])
        rest = rest + 1
    }
    String.from_bytes(out) ?? ""
}

INT_MAX :: 9223372036854775807

// The most a counted repetition `{n,m}` may repeat, as in RE2: the program
// grows with the count, so the cap keeps compile size proportional to the
// pattern text.
MAX_REPEAT :: 1000

// Parse tree node kinds. A quantifier node wraps `left`; `a`/`b` hold a
// literal scalar, a group index, or a quantifier's min/max (-1 = unbounded).
N_LIT :: 0
N_ANY :: 1
N_CLASS :: 2
N_START :: 3
N_END :: 4
N_EMPTY :: 5
N_SEQ :: 6
N_ALT :: 7
N_GROUP :: 8
N_STAR :: 9
N_PLUS :: 10
N_OPT :: 11
N_RANGE :: 12

// Class member kinds, the Prelude RegexClassItem set.
K_CHAR :: 0
K_RANGE :: 1
K_DIGIT :: 2
K_WORD :: 3
K_SPACE :: 4
K_ALPHA :: 5
K_NUMBER :: 6

struct Node {
    kind: Int
    a: Int
    b: Int
    left: Int
    right: Int
    neg: Bool
    lo: Int
    hi: Int
}

struct Parser {
    cps: [Int]
    i: Int
    nodes: [Node]
    kinds: [Int]
    los: [Int]
    his: [Int]
    groups: Int
    names: [String]
}

impl Parser {
    // Alternation arms nest to the right, so arm order is priority order.
    fn parse_alt(&self, close: Bool) -> Int RegexError! {
        arms := [Int]{}
        &arms.push(&self.parse_seq(close))
        loop self.peek() == 124 {
            self.i = self.i + 1
            &arms.push(&self.parse_seq(close))
        }
        if close {
            if self.peek() != 41 -> return Err(RegexError.Syntax)
            self.i = self.i + 1
        }
        acc := arms[arms.len() - 1]
        k := arms.len() - 2
        loop k >= 0 {
            acc = &self.emit(N_ALT, 0, 0, arms[k], acc)
            k = k - 1
        }
        Ok(acc)
    }

    fn parse_seq(&self, close: Bool) -> Int RegexError! {
        acc := -1
        loop {
            c :: self.peek()
            if c < 0 || c == 124 || (close && c == 41) -> break
            atom :: &self.parse_atom()
            piece :: &self.parse_quant(atom)
            if acc < 0 {
                acc = piece
            } else {
                acc = &self.emit(N_SEQ, 0, 0, acc, piece)
            }
        }
        if acc < 0 -> return Ok(&self.emit(N_EMPTY, 0, 0, -1, -1))
        Ok(acc)
    }

    fn parse_atom(&self) -> Int RegexError! {
        c :: &self.bump()
        if c < 0 -> return Err(RegexError.Syntax)
        if c == 46 -> return Ok(&self.emit(N_ANY, 0, 0, -1, -1))
        if c == 94 -> return Ok(&self.emit(N_START, 0, 0, -1, -1))
        if c == 36 -> return Ok(&self.emit(N_END, 0, 0, -1, -1))
        if c == 40 -> return &self.parse_group()
        if c == 91 -> return &self.parse_class()
        if c == 92 -> return &self.parse_escape_atom()
        if c == 41 || c == 42 || c == 43 || c == 63 || c == 123 -> return Err(RegexError.Syntax)
        Ok(&self.emit(N_LIT, c, 0, -1, -1))
    }

    // Capture numbers follow the opening `(`, as in the Prelude engine.
    fn parse_group(&self) -> Int RegexError! {
        name := ""
        if self.peek() == 63 {
            self.i = self.i + 1
            kind :: &self.bump()
            if kind == 58 -> return &self.parse_alt(true)
            if kind != 60 -> return Err(RegexError.Syntax)
            name = &self.parse_group_name()
        }
        self.groups = self.groups + 1
        index :: self.groups
        &self.names.push(name)
        inner :: &self.parse_alt(true)
        Ok(&self.emit(N_GROUP, index, 0, inner, -1))
    }

    fn parse_group_name(&self) -> String RegexError! {
        raw := [U8]{}
        loop {
            c :: &self.bump()
            if c < 0 -> return Err(RegexError.Syntax)
            if c == 62 -> break
            if !is_group_name_char(c) -> return Err(RegexError.Syntax)
            &raw.push(U8{c})
        }
        if raw.len() == 0 -> return Err(RegexError.Syntax)
        Ok(String.from_bytes(raw) ?? "")
    }

    fn parse_quant(&self, atom: Int) -> Int RegexError! {
        c :: self.peek()
        if c == 42 {
            self.i = self.i + 1
            return Ok(&self.emit(N_STAR, 0, 0, atom, -1))
        }
        if c == 43 {
            self.i = self.i + 1
            return Ok(&self.emit(N_PLUS, 0, 0, atom, -1))
        }
        if c == 63 {
            self.i = self.i + 1
            return Ok(&self.emit(N_OPT, 0, 0, atom, -1))
        }
        if c != 123 -> return Ok(atom)
        self.i = self.i + 1
        lo :: &self.parse_number()
        hi := lo
        if self.peek() == 44 {
            self.i = self.i + 1
            if self.peek() == 125 {
                hi = -1
            } else {
                hi = &self.parse_number()
            }
        }
        if &self.bump() != 125 -> return Err(RegexError.Syntax)
        if hi >= 0 && hi < lo -> return Err(RegexError.Syntax)
        if lo > MAX_REPEAT || hi > MAX_REPEAT -> return Err(RegexError.Syntax)
        Ok(&self.emit(N_RANGE, lo, hi, atom, -1))
    }

    fn parse_number(&self) -> Int RegexError! {
        n := 0
        got := false
        loop {
            d :: self.peek()
            if d < 48 || d > 57 -> break
            if n > (INT_MAX - (d - 48)) /% 10 -> return Err(RegexError.Syntax)
            self.i = self.i + 1
            n = n * 10 + (d - 48)
            got = true
        }
        if !got -> return Err(RegexError.Syntax)
        Ok(n)
    }

    // `]` first (after an optional `^`) is a member, so `[^]]` is a class.
    fn parse_class(&self) -> Int RegexError! {
        neg := false
        if self.peek() == 94 {
            self.i = self.i + 1
            neg = true
        }
        lo :: self.kinds.len()
        loop {
            c :: self.peek()
            if c < 0 -> return Err(RegexError.Syntax)
            if c == 93 && self.kinds.len() > lo {
                self.i = self.i + 1
                break
            }
            first := 93
            if c == 93 {
                self.i = self.i + 1
            } else {
                first = &self.parse_class_item()
            }
            if self.peek() == 45 && self.peek_at(1) != 93 {
                self.i = self.i + 1
                second :: &self.parse_class_char()
                if first < 0 -> return Err(RegexError.Syntax)
                &self.item(K_RANGE, first, second)
            } else if first >= 0 {
                &self.item(K_CHAR, first, first)
            } else {
                &self.item(-first, 0, 0)
            }
        }
        Ok(&self.class_node(lo, neg))
    }

    /// A member scalar (>= 0), or a negated member kind for `\d\w\s\p{…}`.
    fn parse_class_item(&self) -> Int RegexError! {
        if self.peek() != 92 -> return &self.parse_class_char()
        self.i = self.i + 1
        c :: &self.bump()
        if c < 0 || c == 80 -> return Err(RegexError.Syntax)
        if c == 100 -> return Ok(-K_DIGIT)
        if c == 119 -> return Ok(-K_WORD)
        if c == 115 -> return Ok(-K_SPACE)
        if c == 112 {
            kind :: &self.parse_unicode_class()
            return Ok(-kind)
        }
        Ok(escaped_literal(c))
    }

    fn parse_class_char(&self) -> Int RegexError! {
        c :: &self.bump()
        if c < 0 || c == 93 -> return Err(RegexError.Syntax)
        if c != 92 -> return Ok(c)
        e :: &self.bump()
        if e < 0 -> return Err(RegexError.Syntax)
        Ok(escaped_literal(e))
    }

    fn parse_escape_atom(&self) -> Int RegexError! {
        c :: &self.bump()
        if c < 0 -> return Err(RegexError.Syntax)
        // Backreferences are not linear; the Prelude engine rejects them too.
        if c >= 48 && c <= 57 -> return Err(RegexError.Syntax)
        kind := -1
        neg := false
        if c == 100 || c == 68 -> kind = K_DIGIT
        if c == 119 || c == 87 -> kind = K_WORD
        if c == 115 || c == 83 -> kind = K_SPACE
        if c == 68 || c == 87 || c == 83 || c == 80 -> neg = true
        if c == 112 || c == 80 -> kind = &self.parse_unicode_class()
        if kind < 0 -> return Ok(&self.emit(N_LIT, escaped_literal(c), 0, -1, -1))
        lo :: self.kinds.len()
        &self.item(kind, 0, 0)
        Ok(&self.class_node(lo, neg))
    }

    fn parse_unicode_class(&self) -> Int RegexError! {
        if &self.bump() != 123 -> return Err(RegexError.Syntax)
        raw := [U8]{}
        loop {
            c :: &self.bump()
            if c < 0 -> return Err(RegexError.Syntax)
            if c == 125 -> break
            if c > 127 -> return Err(RegexError.Syntax)
            &raw.push(U8{c})
        }
        name :: String.from_bytes(raw) ?? ""
        if name == "L" || name == "Letter" || name == "Alphabetic" -> return Ok(K_ALPHA)
        if name == "N" || name == "Number" -> return Ok(K_NUMBER)
        if name == "White_Space" || name == "Whitespace" -> return Ok(K_SPACE)
        Err(RegexError.Syntax)
    }

    fn item(&self, kind: Int, lo: Int, hi: Int) Never! {
        &self.kinds.push(kind)
        &self.los.push(lo)
        &self.his.push(hi)
    }

    fn class_node(&self, lo: Int, neg: Bool) -> Int Never! {
        &self.nodes.push(Node{kind: N_CLASS, a: 0, b: 0, left: -1, right: -1, neg: neg, lo: lo, hi: self.kinds.len()})
        self.nodes.len() - 1
    }

    fn emit(&self, kind: Int, a: Int, b: Int, left: Int, right: Int) -> Int Never! {
        &self.nodes.push(Node{kind: kind, a: a, b: b, left: left, right: right, neg: false, lo: 0, hi: 0})
        self.nodes.len() - 1
    }

    fn peek(self) -> Int Never! {
        if self.i >= self.cps.len() -> return -1
        self.cps[self.i]
    }

    fn peek_at(self, offset: Int) -> Int Never! {
        if self.i + offset >= self.cps.len() -> return -1
        self.cps[self.i + offset]
    }

    fn bump(&self) -> Int Never! {
        if self.i >= self.cps.len() -> return -1
        c :: self.cps[self.i]
        self.i = self.i + 1
        c
    }
}

fn escaped_literal(c: Int) -> Int Never! {
    if c == 110 -> return 10
    if c == 114 -> return 13
    if c == 116 -> return 9
    c
}

// Program instructions, the Prelude engine's RegexInst set. `args` holds a
// literal scalar, a Save slot (-1 = no-op), or a class's first member row
// (`ends` its end). A consuming instruction continues at `xs`; Split prefers
// `xs` over `ys` (leftmost-first).
OP_LIT :: 0
OP_ANY :: 1
OP_CLASS :: 2
OP_SAVE :: 3
OP_SPLIT :: 4
OP_ASSERT_START :: 5
OP_ASSERT_END :: 6
OP_MATCH :: 7

// A fragment's dangling exits: `inst` patches `xs`, `-inst - 1` patches `ys`.
struct Frag {
    start: Int
    outs: [Int]
}

struct Compiler {
    nodes: [Node]
    ops: [Int]
    args: [Int]
    ends: [Int]
    negs: [Bool]
    xs: [Int]
    ys: [Int]
}

impl Compiler {
    fn push(&self, op: Int, arg: Int, end: Int, neg: Bool) -> Int Never! {
        &self.ops.push(op)
        &self.args.push(arg)
        &self.ends.push(end)
        &self.negs.push(neg)
        &self.xs.push(-1)
        &self.ys.push(-1)
        self.ops.len() - 1
    }

    fn single(&self, op: Int, arg: Int, end: Int, neg: Bool) -> Frag Never! {
        id :: &self.push(op, arg, end, neg)
        Frag{start: id, outs: [Int]{id}}
    }

    fn patch(&self, outs: [Int], target: Int) Never! {
        loop code in outs {
            if code >= 0 {
                self.xs[code] = target
            } else {
                self.ys[-code - 1] = target
            }
        }
    }

    fn star(&self, node: Int) -> Frag Never! {
        atom :: &self.compile(node)
        split :: &self.push(OP_SPLIT, 0, 0, false)
        self.xs[split] = atom.start
        &self.patch(atom.outs, split)
        Frag{start: split, outs: [Int]{-split - 1}}
    }

    fn optional(&self, node: Int) -> Frag Never! {
        atom :: &self.compile(node)
        split :: &self.push(OP_SPLIT, 0, 0, false)
        self.xs[split] = atom.start
        outs := atom.outs
        &outs.push(-split - 1)
        Frag{start: split, outs: outs}
    }

    // Recursion here follows the pattern's nesting, never the text.
    fn compile(&self, node: Int) -> Frag Never! {
        n :: self.nodes[node].copy()
        if n.kind == N_LIT -> return &self.single(OP_LIT, n.a, 0, false)
        if n.kind == N_ANY -> return &self.single(OP_ANY, 0, 0, false)
        if n.kind == N_CLASS -> return &self.single(OP_CLASS, n.lo, n.hi, n.neg)
        if n.kind == N_START -> return &self.single(OP_ASSERT_START, 0, 0, false)
        if n.kind == N_END -> return &self.single(OP_ASSERT_END, 0, 0, false)
        if n.kind == N_SEQ {
            left :: &self.compile(n.left)
            right :: &self.compile(n.right)
            &self.patch(left.outs, right.start)
            return Frag{start: left.start, outs: right.outs}
        }
        if n.kind == N_ALT {
            left :: &self.compile(n.left)
            right :: &self.compile(n.right)
            split :: &self.push(OP_SPLIT, 0, 0, false)
            self.xs[split] = left.start
            self.ys[split] = right.start
            outs := left.outs
            loop code in right.outs -> &outs.push(code)
            return Frag{start: split, outs: outs}
        }
        if n.kind == N_GROUP {
            open :: &self.push(OP_SAVE, n.a * 2, 0, false)
            inner :: &self.compile(n.left)
            self.xs[open] = inner.start
            close :: &self.push(OP_SAVE, n.a * 2 + 1, 0, false)
            &self.patch(inner.outs, close)
            return Frag{start: open, outs: [Int]{close}}
        }
        if n.kind == N_STAR -> return &self.star(n.left)
        if n.kind == N_PLUS {
            atom :: &self.compile(n.left)
            split :: &self.push(OP_SPLIT, 0, 0, false)
            self.xs[split] = atom.start
            &self.patch(atom.outs, split)
            return Frag{start: atom.start, outs: [Int]{-split - 1}}
        }
        if n.kind == N_OPT -> return &self.optional(n.left)
        if n.kind == N_RANGE {
            // `{min,max}`: min required copies, then max - min optional
            // copies or one star, exactly the Prelude compile_range shape.
            frag := Frag{start: -1, outs: [Int]{}}
            loop k in 0..<n.a {
                piece :: &self.compile(n.left)
                if frag.start < 0 {
                    frag = piece
                } else {
                    &self.patch(frag.outs, piece.start)
                    frag = Frag{start: frag.start, outs: piece.outs}
                }
            }
            if frag.start < 0 -> frag = &self.single(OP_SAVE, -1, 0, false)
            if n.b < 0 {
                tail :: &self.star(n.left)
                &self.patch(frag.outs, tail.start)
                return Frag{start: frag.start, outs: tail.outs}
            }
            loop k in n.a..<n.b {
                tail :: &self.optional(n.left)
                &self.patch(frag.outs, tail.start)
                frag = Frag{start: frag.start, outs: tail.outs}
            }
            return frag
        }
        // N_EMPTY: a no-op save keeps the fragment shape uniform.
        &self.single(OP_SAVE, -1, 0, false)
    }
}

/// The scan's working set, allocated once per call and reused at every
/// scalar and every capture re-run: threads are parallel Int rows (current
/// threads first, the next step's appended, then moved down), `seen` marks
/// the pcs reached in the current epoch, the epsilon stack is explicit, and
/// captures are a persistent list (`aslot`/`apos`/`aprev`) so forking a
/// thread copies one Int. `lo`/`hi` bound the scanned text.
struct VM {
    seen: [Int]
    epoch: Int
    lo: Int
    hi: Int
    sp: Int
    spc: [Int]
    sstart: [Int]
    scaps: [Int]
    nt: Int
    tpc: [Int]
    tstart: [Int]
    tcaps: [Int]
    min_start: Int
    m_pc: Int
    m_start: Int
    m_caps: Int
    aslot: [Int]
    apos: [Int]
    aprev: [Int]
}

struct Run {
    start: Int
    end: Int
    caps: [Int]
}

fn new_vm(size: Int) -> VM Never! {
    seen :: filled(size, -1)
    // Every pc is entered once per epoch and pushes at most two edges, and
    // the current and next thread sets hold at most one thread per pc, so
    // these rows never grow during the scan.
    rows :: 2 * size + 2
    VM{
    seen: seen,
    epoch: 0,
    lo: 0,
    hi: 0,
    sp: 0,
    spc: filled(rows, 0),
    sstart: filled(rows, 0),
    scaps: filled(rows, 0),
    nt: 0,
    tpc: filled(rows, 0),
    tstart: filled(rows, 0),
    tcaps: filled(rows, 0),
    min_start: -1,
    m_pc: -1,
    m_start: -1,
    m_caps: -1,
    aslot: [Int]{},
    apos: [Int]{},
    aprev: [Int]{},
    }
}

impl VM {
    fn reset(&self) Never! {
        self.nt = 0
        self.epoch = self.epoch + 1
        self.min_start = -1
        self.m_pc = -1
    }

    /// Start a scan of `text[lo..hi]`, which the program sees as the whole
    /// text: `^` holds at `lo` and `$` at `hi`.
    fn begin(&self, lo: Int, hi: Int) Never! {
        &self.reset()
        self.sp = 0
        self.lo = lo
        self.hi = hi
        &self.aslot.clear()
        &self.apos.clear()
        &self.aprev.clear()
    }

    fn push_edge(&self, pc: Int, start: Int, caps: Int) Never! {
        self.spc[self.sp] = pc
        self.sstart[self.sp] = start
        self.scaps[self.sp] = caps
        self.sp = self.sp + 1
    }

    /// Follow every epsilon edge from `pc` with the explicit stack, in
    /// priority order, recording consuming and matching threads once per pc.
    fn add(&self, re: Regex, text: [U8], pc: Int, start: Int, caps: Int, pos: Int, capture: Bool) Never! {
        &self.push_edge(pc, start, caps)
        loop self.sp > 0 {
            self.sp = self.sp - 1
            p :: self.spc[self.sp].copy()
            s :: self.sstart[self.sp].copy()
            c :: self.scaps[self.sp].copy()
            if self.seen[p] == self.epoch -> next
            self.seen[p] = self.epoch
            op :: re.ops[p]
            if op == OP_SAVE {
                head := c
                if capture && re.args[p] >= 0 {
                    &self.aslot.push(re.args[p])
                    &self.apos.push(pos)
                    &self.aprev.push(c)
                    head = self.aslot.len() - 1
                }
                &self.push_edge(re.xs[p], s, head)
                next
            }
            if op == OP_SPLIT {
                &self.push_edge(re.ys[p], s, c)
                &self.push_edge(re.xs[p], s, c)
                next
            }
            if op == OP_ASSERT_START {
                if pos == self.lo || (re.flags.multiline && pos > self.lo && text[pos - 1] == (U8{10})) {
                    &self.push_edge(re.xs[p], s, c)
                }
                next
            }
            if op == OP_ASSERT_END {
                if pos == self.hi -> &self.push_edge(re.xs[p], s, c)
                next
            }
            if self.min_start < 0 || s < self.min_start -> self.min_start = s
            if op == OP_MATCH && (self.m_pc < 0 || s < self.m_start) {
                self.m_pc = p
                self.m_start = s
                self.m_caps = c
            }
            self.tpc[self.nt] = p
            self.tstart[self.nt] = s
            self.tcaps[self.nt] = c
            self.nt = self.nt + 1
        }
    }

    /// Advance every current thread over the scalar `cp` into a new epoch,
    /// then move the next threads down over the current ones. The per-step
    /// paths use counted `loop k < n` forms: a range loop allocates its
    /// range each time it is entered.
    fn step(&self, re: Regex, text: [U8], cp: Int, next_pos: Int, capture: Bool) Never! {
        n :: self.nt
        self.epoch = self.epoch + 1
        self.min_start = -1
        self.m_pc = -1
        k := 0
        loop k < n {
            pc :: self.tpc[k].copy()
            start :: self.tstart[k].copy()
            caps :: self.tcaps[k].copy()
            k = k + 1
            if re.ops[pc] > OP_CLASS -> next
            if !consumes(re, pc, cp) -> next
            &self.add(re, text, re.xs[pc], start, caps, next_pos, capture)
        }
        m :: self.nt - n
        j := 0
        loop j < m {
            self.tpc[j] = self.tpc[n + j]
            self.tstart[j] = self.tstart[n + j]
            self.tcaps[j] = self.tcaps[n + j]
            j = j + 1
        }
        self.nt = m
    }

    fn slots(self, head: Int, start: Int, end: Int, groups: Int, capture: Bool) -> [Int] Never! {
        if !capture -> return [Int]{}
        out := filled((groups + 1) * 2, -1)
        at := head
        loop at >= 0 {
            slot :: self.aslot[at]
            if slot < out.len() && out[slot] < 0 -> out[slot] = self.apos[at]
            at = self.aprev[at]
        }
        out[0] = start
        out[1] = end
        out
    }
}

fn filled(n: Int, value: Int) -> [Int] Never! {
    out := [Int]{}
    loop out.len() < n -> &out.push(value)
    out
}

fn next_search_pos(text: [U8], start: Int, end: Int, hi: Int) -> Int Never! {
    if end > start -> return end
    if end >= hi -> return hi + 1
    end + lead_width(text[end])
}

fn scan(re: Regex, text: [U8], anchored: Bool, capture: Bool, stop_on_match: Bool, limit: Int) -> [Run] Never! {
    vm := new_vm(re.ops.len())
    scan_in(re, &vm, text, 0, text.len(), anchored, capture, stop_on_match, limit)
}

/// The Prelude `regex_scan` over `text[lo..hi]`: start threads enter one
/// shared VM at each scalar boundary until the leftmost match begins; that
/// start's last match wins, and the scan resumes at the non-overlap
/// boundary. Collects at most `limit` runs (all when `limit` < 0).
fn scan_in(re: Regex, vm: &VM, text: [U8], lo: Int, hi: Int, anchored: Bool, capture: Bool, stop_on_match: Bool, limit: Int) -> [Run] Never! {
    out := [Run]{}
    &vm.begin(lo, hi)
    pos := lo
    winner := -1
    has_last := false
    last_start := 0
    last_end := 0
    last_caps := -1
    single_start :: anchored || (re.anchored_start && !re.flags.multiline)
    loop {
        can_start :: !re.anchored_start || re.flags.multiline || pos == lo
        if winner < 0 && can_start && (!anchored || pos == lo) {
            &vm.add(re, text, re.start, pos, -1, pos, capture)
        }
        if stop_on_match && vm.m_pc >= 0 {
            &out.push(Run{start: vm.m_start, end: pos, caps: [Int]{}})
            return out
        }
        if vm.nt == 0 && single_start -> return out
        if winner < 0 && vm.m_pc >= 0 -> winner = vm.m_start
        if winner >= 0 && vm.m_pc >= 0 && vm.m_start == winner {
            has_last = true
            last_start = vm.m_start
            last_end = pos
            last_caps = vm.m_caps
        }
        emit := false
        if pos == hi {
            if !has_last -> return out
            emit = true
        } else {
            next_pos :: pos + lead_width(text[pos])
            &vm.step(re, text, decode_at(text, pos), next_pos, capture)
            if stop_on_match && vm.m_pc >= 0 {
                &out.push(Run{start: vm.m_start, end: next_pos, caps: [Int]{}})
                return out
            }
            if winner >= 0 && vm.min_start != winner {
                if !has_last -> return out
                emit = true
            } else {
                pos = next_pos
            }
        }
        if emit {
            resume :: next_search_pos(text, last_start, last_end, hi)
            &out.push(Run{start: last_start, end: last_end, caps: vm.slots(last_caps, last_start, last_end, re.groups, capture)})
            has_last = false
            if limit >= 0 && out.len() >= limit -> return out
            if resume > hi -> return out
            &vm.reset()
            winner = -1
            pos = resume
        }
    }
}

fn consumes(re: Regex, pc: Int, cp: Int) -> Bool Never! {
    op :: re.ops[pc]
    if op == OP_LIT {
        lit :: re.args[pc]
        if lit == cp -> return true
        return re.flags.ignore_case && simple_fold(lit) == simple_fold(cp)
    }
    if op == OP_ANY -> return re.flags.dot_matches_newline || cp != 10
    hit := false
    k := re.args[pc]
    loop k < re.ends[pc] {
        if member_matches(re.kinds[k], re.los[k], re.his[k], cp, re.flags.ignore_case) {
            hit = true
            break
        }
        k = k + 1
    }
    hit != re.negs[pc]
}

fn member_matches(kind: Int, lo: Int, hi: Int, cp: Int, ignore_case: Bool) -> Bool Never! {
    if kind == K_CHAR {
        if lo == cp -> return true
        return ignore_case && simple_fold(lo) == simple_fold(cp)
    }
    if kind == K_RANGE {
        if !ignore_case -> return lo <= cp && cp <= hi
        folded :: simple_fold(cp)
        return simple_fold(lo) <= folded && folded <= simple_fold(hi)
    }
    if kind == K_DIGIT -> return cp >= 48 && cp <= 57
    if kind == K_WORD {
        return cp == 95 || (cp >= 48 && cp <= 57) || (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122)
    }
    if kind == K_SPACE {
        if cp < 128 -> return cp == 32 || (cp >= 9 && cp <= 13)
        return scalar_text(cp).is_whitespace()
    }
    if kind == K_ALPHA {
        if cp < 128 -> return (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122)
        return scalar_text(cp).is_alphabetic()
    }
    if cp < 128 -> return cp >= 48 && cp <= 57
    scalar_text(cp).is_numeric()
}

/// Unicode simple case folding as the Prelude computes it: the first scalar
/// of the scalar's lowercase mapping.
fn simple_fold(cp: Int) -> Int Never! {
    if cp < 128 {
        if cp >= 65 && cp <= 90 -> return cp + 32
        return cp
    }
    lowered :: scalar_text(cp).to_lower().bytes()
    if lowered.len() == 0 -> return cp
    decode_at(lowered, 0)
}

fn scalar_text(cp: Int) -> String Never! {
    out := [U8]{}
    if cp < 128 {
        &out.push(U8{cp})
    } else if cp < 2048 {
        &out.push(U8{Int{192}.bit_or(cp >> 6)})
        &out.push(U8{Int{128}.bit_or(cp.bit_and(63))})
    } else if cp < 65536 {
        &out.push(U8{Int{224}.bit_or(cp >> 12)})
        &out.push(U8{Int{128}.bit_or((cp >> 6).bit_and(63))})
        &out.push(U8{Int{128}.bit_or(cp.bit_and(63))})
    } else {
        &out.push(U8{Int{240}.bit_or(cp >> 18)})
        &out.push(U8{Int{128}.bit_or((cp >> 12).bit_and(63))})
        &out.push(U8{Int{128}.bit_or((cp >> 6).bit_and(63))})
        &out.push(U8{Int{128}.bit_or(cp.bit_and(63))})
    }
    String.from_bytes(out) ?? ""
}

// UTF-8 width from a lead byte. Jet Strings are valid UTF-8.
fn lead_width(lead: U8) -> Int Never! {
    n :: Int.from_u8(lead)
    if n < 128 -> return 1
    if n < 224 -> return 2
    if n < 240 -> return 3
    4
}

fn decode_at(raw: [U8], i: Int) -> Int Never! {
    first :: Int.from_u8(raw[i])
    if first < 128 -> return first
    width :: lead_width(raw[i])
    cp := first.bit_and(7)
    if width == 2 -> cp = first.bit_and(31)
    if width == 3 -> cp = first.bit_and(15)
    k := 1
    loop k < width && i + k < raw.len() {
        cp = (cp << 6).bit_or(Int.from_u8(raw[i + k]).bit_and(63))
        k = k + 1
    }
    cp
}

fn decode_all(raw: [U8]) -> [Int] Never! {
    out := [Int]{}
    i := 0
    loop i < raw.len() {
        &out.push(decode_at(raw, i))
        i = i + lead_width(raw[i])
    }
    out
}

/// Byte offset -> character position, moving forward through one text.
struct CharCursor {
    byte: Int
    count: Int
}

impl CharCursor {
    fn at(&self, raw: [U8], byte: Int) -> Int Never! {
        if byte < self.byte {
            self.byte = 0
            self.count = 0
        }
        loop self.byte < byte && self.byte < raw.len() {
            b :: Int.from_u8(raw[self.byte])
            if b < 128 || b >= 192 -> self.count = self.count + 1
            self.byte = self.byte + 1
        }
        self.count
    }
}

fn find_match(pattern: Regex, text: String) -> Match? Never! {
    raw :: text.bytes()
    vm := new_vm(pattern.ops.len())
    runs :: scan_in(pattern, &vm, raw, 0, raw.len(), false, true, false, 1)
    if runs.len() == 0 -> return None
    chars := CharCursor{byte: 0, count: 0}
    Val(make_match(pattern, &vm, raw, runs[0], &chars, false))
}

/// `rerun` recomputes captures by an anchored run over the matched window
/// alone (`^` at its start, `$` at its end), as the Prelude's Match does for
/// matches found without captures.
fn make_match(re: Regex, vm: &VM, raw: [U8], run: Run, chars: &CharCursor, rerun: Bool) -> Match Never! {
    caps := run.caps
    if rerun && re.groups > 0 {
        inner :: scan_in(re, &vm, raw, run.start, run.end, true, true, false, 1)
        if inner.len() == 1 -> caps = inner[0].caps
    }
    first :: &chars.at(raw, run.start)
    last :: &chars.at(raw, run.end)
    groups := [String]{}
    spans := [Int]{}
    g := 0
    loop g < re.groups {
        g = g + 1
        start := -1
        end := -1
        if 2 * g + 1 < caps.len() {
            start = caps[2 * g]
            end = caps[2 * g + 1]
        }
        if start >= 0 && end >= start {
            &groups.push(slice(raw, start, end))
            at :: first + char_count(raw, run.start, start)
            &spans.push(at)
            &spans.push(at + char_count(raw, start, end))
        } else {
            &groups.push("")
            &spans.push(-1)
            &spans.push(-1)
        }
    }
    Match{start: first, end: last, text: slice(raw, run.start, run.end), groups: groups, spans: spans, names: re.names.copy()}
}

/// The number of characters (Unicode scalars) in `raw[from..<to]`.
fn char_count(raw: [U8], from: Int, to: Int) -> Int Never! {
    count := 0
    i := from
    loop i < to {
        b :: Int.from_u8(raw[i])
        if b < 128 || b >= 192 -> count = count + 1
        i = i + 1
    }
    count
}

fn slice(raw: [U8], start: Int, end: Int) -> String Never! {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i >= raw.len() -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}

fn is_group_name_char(n: Int) -> Bool Never! {
    n == 95 ||
        (n >= 48 && n <= 57) ||
        (n >= 65 && n <= 90) ||
        (n >= 97 && n <= 122)
}

fn is_meta(b: U8) -> Bool Never! {
    n :: b
    n == 92 || n == 46 || n == 94 || n == 36 || n == 42 || n == 43 || n == 63 || n == 40 || n == 41 || n == 91 || n == 93 || n == 123 || n == 125 || n == 124
}
/// Python-style constructor spelling for a runtime pattern.
fn regex(pattern: String) -> Regex RegexError! { compile(pattern) }

/// Return the canonical source pattern represented by a compiled regex.
fn join(pattern: Regex) -> String Never! { pattern.pattern }
/// Python `re` spellings over the same compiled Regex carrier.
fn search(pattern: Regex, text: String) -> Match? Never! { match(pattern, text) }
fn findall(pattern: Regex, text: String) -> [String] Never! { find_all(pattern, text) }
fn fullmatch(pattern: Regex, text: String) -> Bool Never! { full_match(pattern, text) }
fn sub(pattern: Regex, text: String, replacement: String) -> String Never! {
    replace(pattern, text, replacement)
}
fn subn(pattern: Regex, text: String, replacement: String) -> (text: String, count: Int) Never! {
    ms :: matches(pattern, text)
    (text: replace(pattern, text, replacement), count: ms.len())
}
