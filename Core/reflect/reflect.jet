package {
    name: "core.reflect"
    version: "0.0.1"
    edition: "2026"
    description: "Runtime type names for values."
    license: "MIT"
    outputs: {
        reflect: .Library{ entry: reflect }
    }
}

// core.reflect — typed runtime reflection and explicit text inspection.

// `inspect` classifies caller-supplied text. The compiler-owned `of` intrinsic
// projects typed values and is intentionally not implemented by this module.

pub struct ReflectValue {
    pub type_name: String
    pub display: String
}

pub fn inspect(value: String) -> ReflectValue Never! { classify(value) }

fn classify(value: String) -> ReflectValue {
    t :: trim(value)
    if t.len() == 0 -> return (ReflectValue{type_name: "Empty", display: t})
    raw :: t.bytes()
    if raw.len() >= 2 && raw[0] == (U8{34}) && raw[raw.len() - 1] == (U8{34}) -> return (ReflectValue{type_name: "String", display: t})
    if raw.len() >= 2 && raw[0] == (U8{39}) && raw[raw.len() - 1] == (U8{39}) -> return (ReflectValue{type_name: "Char", display: t})
    if t == {
        "true" | "false" -> return (ReflectValue{type_name: "Bool", display: t})
        "None" -> return (ReflectValue{type_name: "Option", display: t})
        "null" -> return (ReflectValue{type_name: "Null", display: t})
        else -> { _ := 0 }
    }
    if starts(t, "Some(") -> return (ReflectValue{type_name: "Option", display: t})
    if starts(t, "Ok(") || starts(t, "Err(") -> return (ReflectValue{type_name: "Result", display: t})
    if raw[0] == (U8{91}) -> return (ReflectValue{type_name: "List", display: t})
    if raw[0] == (U8{123}) -> return (ReflectValue{type_name: "Struct", display: t})
    if is_number(t) -> return (ReflectValue{type_name: "Int", display: t})
    if Float.parse(t) == {
        .Ok(_) -> return (ReflectValue{type_name: "Float", display: t})
        else -> { _ := 0 }
    }
    name := ident_prefix(t)
    if name.len() > 0 -> return (ReflectValue{type_name: name, display: t})
    ReflectValue{type_name: "Value", display: t}
}

fn starts(text: String, prefix: String) -> Bool {
    a :: text.bytes()
    b :: prefix.bytes()
    if b.len() > a.len() -> return false
    loop i in 0..<b.len() {
        if a[i] != b[i] -> return false
    }
    true
}

fn trim(text: String) -> String {
    raw :: text.bytes()
    s := 0
    e := raw.len()
    loop s < e {
        n :: raw[s]
        if {
            n == (U8{32}) || n == (U8{9}) || n == (U8{10}) || n == (U8{13}) -> s += 1
            else -> break
        }
    }
    loop e > s {
        n :: raw[e - 1]
        if {
            n == (U8{32}) || n == (U8{9}) || n == (U8{10}) || n == (U8{13}) -> e -= 1
            else -> break
        }
    }
    out := [U8]{}
    loop i in s..<e -> &out.push(raw[i])
    String.from_bytes(out) ?? ""
}

fn is_number(text: String) -> Bool {
    raw :: text.bytes()
    if raw.len() == 0 -> return false
    i := 0
    if raw[0] == (U8{45}) || raw[0] == (U8{43}) {
        if raw.len() == 1 -> return false
        i = 1
    }
    loop i < raw.len() {
        n :: raw[i]
        if n < (U8{48}) || n > (U8{57}) -> return false
        i += 1
    }
    true
}

fn ident_prefix(text: String) -> String {
    raw :: text.bytes()
    out := [U8]{}
    loop i in 0..<raw.len() {
        n :: raw[i]
        ok :: (n >= (U8{65}) && n <= (U8{90})) || (n >= (U8{97}) && n <= (U8{122})) || n == (U8{95}) || (i > 0 && n >= (U8{48}) && n <= (U8{57}))
        if !ok -> break
        &out.push(raw[i])
    }
    String.from_bytes(out) ?? ""
}
