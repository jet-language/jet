    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Reflect.rs:42
    pub fn fields(self) -> [JetReflectField] { ~self.fields }
}
impl JetReflectField {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Reflect.rs:48
    pub fn name(self) -> String { ~self.name }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Reflect.rs:51
