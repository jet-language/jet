// Runtime projection of registered typed field rows; display text is not field storage.
// No second runtime type registry, raw-pointer cast, or textual classifier.
use core.prelude.runtime.kernel_values.[JetShow, JetDisplay]

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Reflect.rs:6
#Clone
pub struct JetReflectValue {
    type_name: String
    path: String
    display: String
    fields: [JetReflectField]
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Reflect.rs:14
#Clone
