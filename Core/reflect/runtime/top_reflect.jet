    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Reflect.rs:21
    pub fn from_field<T: JetShow>(value: T, type_name: String, path: String) -> JetReflectValue {
        // Outer reflection requires Display; individual fields use total Show.
        JetReflectValue{type_name: ~type_name, path: ~path, display: value.jet_show(), fields: [JetReflectField]{}}
