
package: {
    name: "core.process"
    version: "0.0.1"
    edition: "2026"
    description: "Process builders and receipt helpers."
    license: "MIT"
    outputs: {
        process: .Library{ entry: process }
    }
}
use {
    core: core
    files: core.files
    unicode: core.text
}

// Exact ProcessSignal shape. Signal arming shares the one native interrupt
// dispatcher; source owns mask and failure policy.
ProcessSignal: enum {
    Term
    Hup
    Int
}

// An argv-safe shell command. `Sh{"cmd {value}"}` splits its literal text on
// whitespace and keeps every hole as exactly one argv item; `Sh.raw(text)` is
// the audited whole-text split. A command runs in one call: `status()` with
// the terminal's stdio (a plain shell line), `ok()` for its verdict (stdout
// discarded, stderr passed through), `text()`/`lines()` for its stdout
// (`$(…)`), `run()` for the whole receipt, and `spec()` when it needs a
// directory, environment or limit first.
Sh: struct {
    argv: [String]
    impl Display {
        display: fn(self) -> String { self.argv.join(" ") }
    }
    impl Debug {
        debug: fn(&&self) -> String { self.argv.join(" ") }
    }
    impl Equatable {
        equal: fn(self, rhs: Sh) -> Bool { self.argv == rhs.argv }
    }
}

impl Sh {
    args: fn(self) -> [String] Never! { self.argv.copy() }
    raw: fn(text: String) -> Sh Never! {
        argv := [String]{}
        sh_split_into(text, argv)
        Sh{argv: argv}
    }
    // The command with `items` appended, each one argv item (`"$@"`).
    extend: fn(self, items: [String]) -> Sh Never! { Sh{argv: self.argv.concat(items)} }
    // The command's ProcessSpec, for a run that sets a directory,
    // environment, stdio or limit first.
    spec: fn(self) -[Exec]> ProcessSpec Never! { cmd(self.argv.copy()) }
    // Runs with the terminal's stdin, stdout and stderr, as a shell runs a
    // plain command line; its exit status as `exit_status` gives it.
    status: fn(self) -[Exec, Time.Wait]> Int IOError! {
        exit_status(self.spec().stdin(.Inherit).stdout(.Inherit).stderr(.Inherit).run())
    }
    // Whether the command runs and exits 0; its stdout is discarded and its
    // stderr passed through (`cmd >/dev/null`).
    ok: fn(self) -[Exec, Time.Wait]> Bool Never! {
        receipt: self.spec().stderr(.Inherit).run() ?? return false
        receipt.success
    }
    // The command's stdout without its trailing newlines, its stderr passed
    // through, whatever its status (`$(cmd)`).
    text: fn(self) -[Exec, Time.Wait]> String IOError! {
        output: self.spec().stderr(.Inherit).run().output
        bytes: output.bytes()
        end := bytes.len()
        loop end > 0 && bytes[end - 1] == (U8{10}) -> end -= 1
        if end == bytes.len() -> return output
        String.from_bytes_lossy(bytes.slice(0, end))
    }
    // The lines of the command's stdout, its stderr passed through, whatever
    // its status.
    lines: fn(self) -[Exec, Time.Wait]> [String] IOError! {
        self.spec().stderr(.Inherit).run().output.lines()
    }
    // The receipt of the command run with its stdout and stderr captured.
    run: fn(self) -[Exec, Time.Wait]> ProcessReceipt IOError! { self.spec().run() }
}

sh_split_into: fn(text: String, argv: &[String]) Never! {
    word := ""
    loop scalar in unicode.scalars(text) {
        if scalar.is_whitespace() {
            if word != "" -> argv.push(word)
            word = ""
        } else {
            word = "{word}{scalar}"
        }
    }
    if word != "" -> argv.push(word)
}

// A checked `Sh{…}` literal: literal text splits on whitespace and each
// hole's display text is one argv item.
impl Sh.CheckedText {
    Error: Never
    Hole: String

    check: fn(_text: String) Never! -[]> { return Ok() }

    encode_hole: fn<T: Printable>(value: T) -[]> String { "{value}" }

    build: fn(parts: [String], holes: [String]) -[]> Sh {
        argv := [String]{}
        sh_split_into(parts[0], argv)
        loop index in 0..<holes.len() {
            argv.push(holes[index].copy())
            sh_split_into(parts[index + 1], argv)
        }
        Sh{argv: argv}
    }
}


args: fn() -[Exec.Args]> [String] Never! { args_from_argv(core.process.argv()) }

check: fn(receipt: ProcessReceipt) IOError! {
    if receipt.success -> return Ok()
    limit_hit: receipt.limit_hit
    if limit_hit == {
        .None -> { _ := 0 }
        .Val(limit) -> return Err(IOError.ResourceLimit(limit))
    }
    if receipt.timed_out {
        return Err(IOError.TimedOut(IOContext{
            operation: .Resolve,
            resource: Val(receipt.executable_identity),
            os_code: None,
            cause: Val("process timed out"),
        }))
    }
    cause := "process exited unsuccessfully: code={receipt.code}"
    signal: receipt.signal.copy()
    if signal == {
        .None -> { _ := 0 }
        .Val(number) -> cause = "{cause}; signal={number}"
    }
    return Err(IOError.Other(IOContext{
        operation: .Resolve,
        resource: Val(receipt.executable_identity),
        os_code: None,
        cause: Val(cause),
    }))
}


stdin_text: fn(spec: ProcessSpec, text: String) IOError! -[Exec, Time.Wait]> {
    child: spec.stdin(.Stream).spawn()
    child.stdin.write_all(text.bytes())
    child.stdin.close()
    receipt: child.wait()
    check(receipt)
}

getoutput: fn(spec: ProcessSpec) -[Exec, Time.Wait]> String IOError! {
    receipt: spec.run()
    receipt.output
}

getstatusoutput: fn(spec: ProcessSpec) -[Exec, Time.Wait]> (status: Int, output: String) IOError! {
    receipt: spec.run()
    (status: receipt.code, output: combined_output(receipt))
}

shell: fn(line: String) -[Exec, Env]> ProcessSpec Never! {
    if core.sys.family() == "windows" -> return cmd([String]{"cmd", "/C", line})
    cmd([String]{"sh", "-c", line})
}

arg: fn(spec: ProcessSpec, extra: String) -> ProcessSpec Never! {
    spec.arg(extra)
}

args_extend: fn(spec: ProcessSpec, extra: [String]) -> ProcessSpec Never! {
    spec.args_extend(extra)
}


cmd: fn(argv: [String]) -[Exec]> ProcessSpec Never! {
    fields: default_fields(argv)
    terminal: fields.terminal ?? TerminalPolicy{size: TerminalSize{cols: 0, rows: 0}, mode: .Cooked}
    has_stdin: if fields.stdin == .Val(_) -> true else -> false
    has_terminal: if fields.terminal == .Val(_) -> true else -> false
    #Unsafe("transfer a fully initialized Jet process plan into the temporary native ProcessSpec carrier; paired environment columns have equal length") {
        return core.process.__spec_fields(fields.argv, fields.cwd != None, fields.cwd ?? "", fields.env_clear,
            fields.env_names, fields.env_values, fields.env_remove,
            has_stdin, fields.stdin ?? .Capture, fields.stdout, fields.stderr,
            fields.timeout_ms != None, fields.timeout_ms ?? 0,
            fields.output_limit != None, fields.output_limit ?? 0,
            fields.cpu_time_limit_ms != None, fields.cpu_time_limit_ms ?? 0,
            fields.memory_limit_bytes != None, fields.memory_limit_bytes ?? 0,
            fields.open_file_limit != None, fields.open_file_limit ?? 0,
            fields.detached, has_terminal, terminal,
            fields.policy_wire != None, fields.policy_wire ?? "")
    }
}

current_pid: fn() -[Env]> Int Never! { core.sys.getpid() }

cwd: fn(spec: ProcessSpec, path: String) -> ProcessSpec Never! { spec.cwd(path) }

env: fn(spec: ProcessSpec, key: String, value: String) -> ProcessSpec Never! {
    spec.env(key, value)
}

env_get: fn(name: String) -[Env]> String? Never! { core.sys.get(name) }

// A program's own exit status 101 becomes the user-error status 1 (S36): only
// a Jet defect (a compiler or runtime panic) ends with 101.
exit: fn(code: Int) -[Exec.Exit]> Never Never! {
    core.process.exit(if code == 101 -> 1 else -> code)
    loop {}
}

// Ends the program with `code` after `message` and a newline on stderr: a
// script's `echo "$message" >&2; exit $code` in one call. Status 101 maps to
// 1, as in `exit`.
fail: fn(code: Int, message: String) -[Exec.Exit, IO, Time.Wait]> Never Never! {
    core.term.eprint(message)
    exit(code)
}

/// End the process with exactly `code`, after the same cleanup boundary as
/// `process.exit`, without mapping 101 to the user-error status 1. Only a tool
/// that reports a Jet defect (a compiler panic) ends with 101.
#Unsafe("process exit_unmapped: the caller reports a Jet defect and owns the 101 defect status") exit_unmapped: fn(code: Int) -[Exec.Exit]> Never Never! {
    core.process.exit(code)
    loop {}
}

on_signal: fn(signal: ProcessSignal) Never! -[Exec]> {
    mask: if signal == {
        .Int -> 1
        .Hup -> 2
        .Term -> 4
    }
    if core.process.__signal_arm(mask) == {
        .Ok(_) -> {}
        .Err(message) -> panic("core.process.on_signal: {message}")
    }
}

pipeline: fn(steps: [ProcessSpec]) -[Exec, Time.Wait]> ProcessReceipt IOError! {
    if steps.len() == 0 {
        return Err(IOError.InvalidInput(IOContext{
            operation: .Resolve, resource: Val("process.pipeline([])"), os_code: None,
            cause: Val("process.pipeline needs at least one command"),
        }))
    }
    core.process.__pipeline_run(steps)
}

run_spec: fn(spec: ProcessSpec) -[Exec, Time.Wait]> ProcessReceipt IOError! {
    spec.run()
}

// A bounded worker pool. At most `jobs` specs run at once
// in one task group, and the results keep input order. A nonzero exit is an Ok
// receipt (the caller checks `.success`); a spec that cannot start is an Err in
// its own slot, so one bad spec never hides the others. Every child but a
// detached one is marked to die with this process (Linux PR_SET_PDEATHSIG).
run_all: fn(specs: [ProcessSpec], jobs: Int) -[Exec, Time.Wait]> [Result<ProcessReceipt, IOError>] IOError! {
    if jobs < 1 {
        return Err(IOError.InvalidInput(IOContext{
            operation: .Resolve, resource: Val("process.run_all"), os_code: None,
            cause: Val("process.run_all needs jobs >= 1, got {jobs}"),
        }))
    }
    results := [Result<ProcessReceipt, IOError>]{}
    task.group pool(limit: jobs) {
        handles: loop spec in specs -> task run_all_job(core.process.__spec_parent_death(spec))
        loop handle in handles {
            outcome: handle.join() ?? (receipt: None, error: Val(run_all_cancelled()))
            if outcome.receipt == {
                .Val(receipt) -> results.push(Ok(receipt))
                .None -> results.push(Err(outcome.error ?? run_all_cancelled()))
            }
        }
    }
    Ok(results)
}

run_all_job: fn(spec: ProcessSpec) -[Exec, Time.Wait]> (receipt: ProcessReceipt?, error: IOError?) Never! {
    if spec.run() == {
        .Ok(receipt) -> (receipt: Val(receipt), error: None)
        .Err(error) -> (receipt: None, error: Val(error))
    }
}

run_all_cancelled: fn() -> IOError Never! {
    IOError.Cancelled(IOContext{
        operation: .Resolve, resource: Val("process.run_all"), os_code: None,
        cause: Val("the job was cancelled before it finished"),
    })
}

// `ProcessSpec.abilities()`, the open keyed report of
// what a terminal-backed launch can use. Stable keys are the checked
// TerminalFact names; a preview fact is any other string key. Every host the
// runtime launches on opens a PTY (HostSpawn spawn_pty), so the report holds
// the three stable facts whatever the spec asks for.
__spec_abilities: fn(_spec: ProcessSpec) -> Set<String> Never! {
    Set.from([String]{"terminal", "resize", "raw"})
}

status_ok: fn(receipt: ProcessReceipt) -> Bool Never! {
    receipt.success
}


which: fn(name: String) -[FS, Env]> String? Never! {
    if name.len() == 0 -> return None
    if contains_path_separator(name) || path_is_absolute(name) {
        if resolves_to_file(name) -> return Val(name)
        return None
    }
    path: core.sys.get("PATH") ?? return None
    family: core.sys.family() ?? return None
    separator: path_separator_for_platform(family)
    loop directory in path_parts(path, separator) {
        candidate: path_join(directory, name)
        if resolves_to_file(candidate) -> return Val(candidate)
    }
    None
}
path_is_absolute: fn(path: String) -> Bool Never! {
    raw: path.bytes()
    if raw.len() == 0 -> return false
    if raw[0] == (U8{47}) || raw[0] == (U8{92}) -> return true
    raw.len() >= 3 &&
        ((raw[0] >= (U8{65}) && raw[0] <= (U8{90})) ||
            (raw[0] >= (U8{97}) && raw[0] <= (U8{122}))) &&
        raw[1] == (U8{58}) &&
        (raw[2] == (U8{47}) || raw[2] == (U8{92}))
}

// A PATH search follows a final link, as a shell does: package managers install tools as links.
resolves_to_file: fn(path: String) -[FS]> Bool Never! {
    row: core.files.__stat_at(-1, path, true) ?? return false
    row[0] == 0
}

path_join: fn(base: String, name: String) -> String Never! {
    if name.len() == 0 -> return base.copy()
    if path_is_absolute(name) || base.len() == 0 -> return name.copy()
    last: base.bytes()[base.bytes().len() - 1]
    if last == (U8{47}) || last == (U8{92}) -> return "{base}{name}"
    "{base}/{name}"
}

path_separator_for_platform: fn(family: String) -> U8 Never! {
    if family == "windows" -> return U8{59}
    U8{58}
}




call: fn(spec: ProcessSpec) -[Exec, Time.Wait]> Int IOError! {
    receipt: spec.run()
    receipt.code
}

capture: fn(spec: ProcessSpec) -[Exec, Time.Wait]> ProcessReceipt IOError! {
    spec.run()
}

check_call: fn(spec: ProcessSpec) -[Exec, Time.Wait]> ProcessReceipt IOError! {
    spec.run_checked()
}

check_output: fn(spec: ProcessSpec) -[Exec, Time.Wait]> String IOError! {
    receipt: check_call(spec)
    receipt.output
}


combined_output: fn(receipt: ProcessReceipt) -> String Never! {
    if receipt.output.len() == 0 -> return receipt.errors
    if receipt.errors.len() == 0 -> return receipt.output
    "{receipt.output}\n{receipt.errors}"
}

env_get_or: fn(name: String, fallback: String) -[Env]> String Never! {
    core.sys.get(name) ?? return fallback
}

env_keys: fn() -[Env]> [String] EnvError! { core.sys.vars() }

env_set: fn(spec: ProcessSpec, key: String, value: String) -> ProcessSpec Never! {
    spec.env(key, value)
}

env_truthy: fn(name: String) -[Env]> Bool Never! {
    value: core.sys.get(name) ?? return false
    lowered: core.text.lower(value)
    lowered == "1" || lowered == "true" || lowered == "yes" || lowered == "on"
}

failed: fn(receipt: ProcessReceipt) -> Bool Never! { !receipt.success }


list2cmdline: fn(argv: [String]) -> String Never! {
    out := ""
    first := true
    loop item in argv {
        if !first -> out = "{out} "
        out = "{out}{quote_arg(item)}"
        first = false
    }
    out
}

signal_number: fn(signal: ProcessSignal) -> Int Never! {
    if signal == {
        .Int -> 2
        .Term -> 15
        .Hup -> 1
    }
}

stderr_lines: fn(receipt: ProcessReceipt) -> [String] Never! {
    split_lines(receipt.errors)
}

stdout_lines: fn(receipt: ProcessReceipt) -> [String] Never! {
    split_lines(receipt.output)
}

exited: fn(receipt: ProcessReceipt) -> Bool Never! {
    receipt.signal == None && !receipt.timed_out
}

/// A finished child's exit status as the shell reports it in `$?`: 124 when
/// its timeout stopped it (as `timeout(1)` reports one), 128 + n after
/// signal n, else its exit code.
exit_status: fn(receipt: ProcessReceipt) -> Int Never! {
    if receipt.timed_out -> return 124
    if receipt.signal == .Val(number) -> return 128 + number
    receipt.code
}
contains_path_separator: fn(value: String) -> Bool Never! {
    loop byte in value.bytes() {
        if byte == (U8{47}) || byte == (U8{92}) -> return true
    }
    false
}

path_separator: fn(value: String) -> U8 {
    raw: value.bytes()
    if raw.len() > 0 -> return raw[0]
    U8{58}
}

path_parts: fn(value: String, separator: U8) -> [String] Never! {
    raw: value.bytes()
    out := [String]{}
    start := 0
    i := 0
    loop i <= raw.len() {
        if i == raw.len() || raw[i] == separator {
            if i == start -> out.push(".") else {
                out.push(String.from_bytes(slice_u8(raw, start, i)) ?? "")
            }
            start = i + 1
        }
        i = i + 1
    }
    out
}

split_lines: fn(value: String) -> [String] {
    raw: value.bytes()
    out := [String]{}
    start := 0
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{10}) || raw[i] == (U8{13}) {
            out.push(String.from_bytes(slice_u8(raw, start, i)) ?? "")
            if raw[i] == (U8{13}) && i + 1 < raw.len() && raw[i + 1] == (U8{10}) {
                i = i + 2
            } else {
                i = i + 1
            }
            start = i
        } else {
            i = i + 1
        }
    }
    if start < raw.len() -> out.push(String.from_bytes(slice_u8(raw, start, raw.len())) ?? "")
    out
}

quote_arg: fn(value: String) -> String {
    raw: value.bytes()
    needs_quote := raw.len() == 0
    loop byte in raw {
        if byte == (U8{9}) || byte == (U8{10}) || byte == (U8{13}) || byte == (U8{32}) {
            needs_quote = true
        }
    }
    out := [U8]{}
    if needs_quote -> out.push(U8{34})
    backslashes := 0
    loop byte in raw {
        if byte == (U8{92}) {
            backslashes = backslashes + 1
            next
        }
        if byte == (U8{34}) {
            count := backslashes * 2 + 1
            loop count > 0 {
                out.push(U8{92})
                count = count - 1
            }
            out.push(U8{34})
        } else {
            loop backslashes > 0 {
                out.push(U8{92})
                backslashes = backslashes - 1
            }
            out.push(byte)
        }
        backslashes = 0
    }
    if needs_quote {
        loop backslashes > 0 {
            out.push(U8{92})
            out.push(U8{92})
            backslashes = backslashes - 1
        }
        out.push(U8{34})
    } else {
        loop backslashes > 0 {
            out.push(U8{92})
            backslashes = backslashes - 1
        }
    }
    String.from_bytes(out) ?? value.copy()
}

slice_u8: fn(raw: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    i := start
    loop i < end {
        out.push(raw[i])
        i = i + 1
    }
    out
}


args_from_argv: fn(values: [String]) -> [String] Never! {
    if values.len() < 2 -> return [String]{}
    values[1..<values.len()]
}

#Test("process argument projection drops argv[0]") {
    assert(args_from_argv([String]{}) == [String]{})
    assert(args_from_argv([String]{"jet"}) == [String]{})
    assert(args_from_argv([String]{"tool", "", "a b"}) == [String]{"", "a b"})
}

#Test("Sh extends its argv item by item") {
    command: Sh{argv: [String]{"printf", "%s|"}}.extend([String]{"a b", "c"})
    assert(command.argv == [String]{"printf", "%s|", "a b", "c"})
    assert_eq(command.text() ?? "error", "a b|c|")
}

#Test("Sh runs a command whole: its verdict, stdout text and lines, status and receipt") {
    assert(Sh{argv: [String]{"true"}}.ok())
    assert(!Sh{argv: [String]{"false"}}.ok())
    assert(!Sh{argv: [String]{"/nonexistent/jet-sh-test"}}.ok())
    printed: Sh{argv: [String]{"printf", "%s\n", "a b", "c", ""}}
    assert_eq(printed.text() ?? "error", "a b\nc")
    assert((printed.lines() ?? [String]{}) == [String]{"a b", "c", ""})
    assert_eq(Sh{argv: [String]{"printf", "a \n"}}.text() ?? "error", "a ")
    assert_eq(Sh{argv: [String]{"printf", "plain"}}.text() ?? "error", "plain")
    assert_eq(Sh{argv: [String]{"true"}}.text() ?? "error", "")
    assert_eq(Sh{argv: [String]{"sh", "-c", "exit 3"}}.status() ?? -1, 3)
    assert_eq(Sh{argv: [String]{"sh", "-c", "kill -9 $$"}}.status() ?? -1, 137)
    receipt: Sh{argv: [String]{"sh", "-c", "echo out; exit 4"}}.run() ?? panic("sh did not start")
    assert(receipt.code == 4 && receipt.output == "out\n")
    assert_eq(exit_status(receipt), 4)
    killed: Sh{argv: [String]{"sh", "-c", "kill -9 $$"}}.run() ?? panic("sh did not start")
    assert_eq(exit_status(killed), 137)
    stopped: Sh{argv: [String]{"sleep", "10"}}.spec().timeout(1s).run() ?? panic("sleep did not start")
    assert_eq(exit_status(stopped), 124)
}

// Temporary native-carrier layout. This is not a second public builder API:
// the canonical ProcessSpec stays opaque and its existing methods stay intact.
ProcessFields: struct {
    argv: [String]
    cwd: String?
    env_clear: Bool
    env_names: [String]
    env_values: [String]
    env_remove: [String]
    stdin: ProcessStreamMode?
    stdout: ProcessStreamMode
    stderr: ProcessStreamMode
    timeout_ms: Int?
    output_limit: Int?
    cpu_time_limit_ms: Int?
    memory_limit_bytes: Int?
    open_file_limit: Int?
    detached: Bool
    terminal: TerminalPolicy?
    policy_wire: String?
}

default_fields: fn(argv: [String]) -> ProcessFields Never! {
    ProcessFields{
        argv: argv, cwd: None, env_clear: false,
        env_names: [String]{}, env_values: [String]{}, env_remove: [String]{},
        stdin: None, stdout: .Capture, stderr: .Capture,
        timeout_ms: None, output_limit: Val(67108864),
        cpu_time_limit_ms: None, memory_limit_bytes: None, open_file_limit: None,
        detached: false, terminal: None, policy_wire: None,
    }
}

#Test("command defaults are Jet-owned and keep empty argv deferred to spawn") {
    fields: default_fields([String]{})
    assert(fields.argv.len() == 0)
    assert(fields.cwd == None && !fields.env_clear)
    assert(fields.env_names.len() == 0 && fields.env_values.len() == 0 && fields.env_remove.len() == 0)
    assert(fields.stdin == None && fields.stdout == .Capture && fields.stderr == .Capture)
    assert(fields.timeout_ms == None)
    assert_eq(fields.output_limit, Val(67108864))
    assert(fields.cpu_time_limit_ms == None && fields.memory_limit_bytes == None && fields.open_file_limit == None)
    assert(!fields.detached && fields.terminal == None && fields.policy_wire == None)
}

// Process stdout/stderr readers wait on the child execution boundary, not FS.
__stdout_next_line: fn(stream: ProcessStdoutStream) -[Exec, Time.Wait]> String? IOError! {
    pipe_line(core.process.__stdout_line_bytes(stream))
}

__stderr_next_line: fn(stream: ProcessStderrStream) -[Exec, Time.Wait]> String? IOError! {
    pipe_line(core.process.__stderr_line_bytes(stream))
}

/// A child's output pipe read in pieces: `loop chunk in child.stdout.chunks(size)`
/// yields each non-empty piece of at most `size` bytes. The loop ends at end of
/// input or at the first failed read; a size below one fails before any read.
ProcessChunks: struct {
    __stdout: ProcessStdoutStream?{None}
    __stderr: ProcessStderrStream?{None}
    __size: Int
}

__ProcessChunkCursor: struct {
    stdout: ProcessStdoutStream?
    stderr: ProcessStderrStream?
    size: Int
    done: Bool
}

impl __ProcessChunkCursor.Iterator {
    Item: [U8]

    next: fn(&self) -[Exec, Time.Wait]> [U8]? {
        if self.done -> return None
        piece := [U8]{}
        if self.stdout == .Val(stream) {
            piece = stream.read(self.size) ?? [U8]{}
        } else if self.stderr == .Val(stream) {
            piece = stream.read(self.size) ?? [U8]{}
        }
        if piece.len() == 0 {
            self.done = true
            return None
        }
        Val(piece)
    }
}

impl ProcessChunks.Iterable {
    Iter: __ProcessChunkCursor

    iter: fn(&&self) -> __ProcessChunkCursor {
        __ProcessChunkCursor{stdout: self.__stdout, stderr: self.__stderr, size: self.__size, done: false}
    }
}

// The loop sources `child.stdout.chunks(size)` and `child.stderr.chunks(size)`
// check to (Sema ProcessHandles).
__stdout_chunks: fn(stream: ProcessStdoutStream, size: Int) -> ProcessChunks Never! {
    ProcessChunks{__stdout: Val(stream), __size: size}
}

__stderr_chunks: fn(stream: ProcessStderrStream, size: Int) -> ProcessChunks Never! {
    ProcessChunks{__stderr: Val(stream), __size: size}
}

pipe_line: fn(&&input: [U8]) -> String? IOError! {
    bytes := input.move()
    if bytes.len() == 0 -> return Ok(None)
    trim_pipe_line(bytes)
    text: String.from_bytes(bytes) ?? return Err(IOError.Other(IOContext{
        operation: .Read, resource: Val("process output"), os_code: None,
        cause: Val("stream did not contain valid UTF-8"),
    }))
    Ok(Val(text))
}

trim_pipe_line: fn(bytes: &[U8]) Never! {
    if bytes.len() > 0 && bytes[bytes.len() - 1] == (U8{10}) {
        _: bytes.pop()
        if bytes.len() > 0 && bytes[bytes.len() - 1] == (U8{13}) -> _: bytes.pop()
    }
}

#Test("pipe next_line preserves final bare CR and removes only one CR before LF") {
    final := [U8]{120, 13}
    trim_pipe_line(final)
    assert_eq(final, [U8]{120, 13})
    crlf := [U8]{120, 13, 13, 10}
    trim_pipe_line(crlf)
    assert_eq(crlf, [U8]{120, 13})
    if pipe_line([U8]{10}) == .Ok(line) -> assert_eq(line, Val("")) else -> panic("empty line")
    if pipe_line([U8]{}) == .Ok(end) -> assert_eq(end, None) else -> panic("EOF")
}
