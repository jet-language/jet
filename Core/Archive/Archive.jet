package: {
    name: "core.archive"
    version: "0.0.1"
    edition: "2026"
    description: "Zip/tar containers and checksums. Stream codecs are nested."
    license: "MIT"
    outputs: {
        archive: .Library{ entry: archive }
    }
}
use {
    zlib: __core_encoding_zlib
}
// core.archive — zip and tar containers.
//
// This package owns archive *containers*. Byte-stream codecs live in
// `core.archive.gzip` and `core.archive.zstd`. CRC-32, Adler-32 and inflate
// are the zlib kernel core.encoding shares (Core/Encoding/Zlib.jet). Deflate
// emits RFC 1951 stored blocks. Zip/tar containers are Jet; file bytes stay
// host cells.
//
// Checksums return the 32-bit value as a non-negative `Int` in `0..=2^32-1`.
// Decoders return a typed `ArchiveError`; an empty byte list is therefore a
// valid decoded value, never the malformed-input sentinel.
#Error
ArchiveError: enum {
    Malformed
    Unsupported
    Checksum
    NotFound
}
gzip: module

zstd: module

C_MAX_OUTPUT: 67108864

C_MAX_ENTRIES: 4096

C_MAX_JSON: 67108864

/// ISO 3309 CRC-32, reflected polynomial `0xEDB88320`.
crc32: fn(data: [U8]) -> Int Never! { zlib.crc32(data) }

/// Adler-32 (RFC 1950). Empty input is 1.
adler32: fn(data: [U8]) -> Int Never! { zlib.adler32(data) }

// The ArchiveError of a failed zlib kernel status.
zlib_error: fn(status: Int) -> ArchiveError Never! {
    if {
        status == zlib.C_INFLATE_UNSUPPORTED -> ArchiveError.Unsupported
        status == zlib.C_ZLIB_CHECKSUM -> ArchiveError.Checksum
        else -> ArchiveError.Malformed
    }
}

/// RFC 1951 deflate. Stored blocks keep the codec small while remaining
/// interoperable with every conforming inflater. Input above the 64 MiB
/// codec budget is `ArchiveError.Unsupported`, never an empty buffer.
deflate: fn(data: [U8]) -> [U8] ArchiveError! {
    if data.len() > C_MAX_OUTPUT -> return Err(ArchiveError.Unsupported)
    out := [U8]{}
    i := 0
    if data.len() == 0 {
        out.push(U8{1})
        out.push(U8{0})
        out.push(U8{0})
        out.push(U8{255})
        out.push(U8{255})
        return Ok(out)
    }
    loop i < data.len() {
        left := data.len() - i
        n := left
        if n > 65535 -> n = 65535
        last := 0
        if i + n >= data.len() -> last = 1
        out.push(wrapping(U8{last}))
        out.push(wrapping(U8{n}))
        out.push(wrapping(U8{n >> 8}))
        inv := 65535 - n
        out.push(wrapping(U8{inv}))
        out.push(wrapping(U8{inv >> 8}))
        loop k in 0..<n -> out.push(data[i + k])
        i = i + n
    }
    Ok(out)
}

/// RFC 1951 inflate. Stored, fixed Huffman, and dynamic Huffman.
inflate: fn(data: [U8]) -> [U8] ArchiveError! {
    out := [U8]{}
    status: zlib.inflate_into(data, out)
    if status != zlib.C_INFLATE_OK -> return Err(zlib_error(status))
    Ok(out)
}

/// Python `zlib.compress` / `zlib.decompress` compatible wrappers. Input above
/// the 64 MiB codec budget is `ArchiveError.Unsupported`.
compress: fn(data: [U8]) -> [U8] ArchiveError! {
    if data.len() > C_MAX_OUTPUT -> return Err(ArchiveError.Unsupported)
    payload: deflate(data)
    checksum: adler32(data)
    out := [U8]{(U8{120}), (U8{156})}
    loop byte in payload -> out.push(byte)
    out.push(wrapping(U8{checksum >> 24}))
    out.push(wrapping(U8{checksum >> 16}))
    out.push(wrapping(U8{checksum >> 8}))
    out.push(wrapping(U8{checksum}))
    Ok(out)
}

decompress: fn(data: [U8]) -> [U8] ArchiveError! {
    out := [U8]{}
    status: zlib.decompress_into(data, out)
    if status != zlib.C_INFLATE_OK -> return Err(zlib_error(status))
    Ok(out)
}

zip_decompress: fn(data: [U8]) -> [U8] ArchiveError! {
    files: zip_files(data)
    if files.len() == 0 -> return Err(ArchiveError.NotFound)
    Ok(files[0].data)
}

zip_names_json: fn(archive: [U8]) -> String ArchiveError! {
    names: zip_list(archive)
    out := [U8]{U8{91}}
    total := 1
    first := true
    loop n in names {
        escaped: json_escape(n)
        extra := escaped.len() + 2
        if !first -> extra = extra + 1
        if total + extra + 1 > C_MAX_JSON -> return Err(ArchiveError.Unsupported)
        names_json_push(out, escaped, first)
        total = total + extra
        first = false
    }
    names_json_finish(out)
}
/// Return the names stored in a ZIP archive.
list: fn(archive: [U8]) -> [String] ArchiveError! { zip_list(archive) }


/// An empty buffer opens a writer: the result is the valid empty ZIP that
/// `zip_write` extends and `zip_close` finishes. Any other buffer must already
/// be a well-formed ZIP.
zip_open: fn(archive: [U8]) -> [U8] ArchiveError! {
    if archive.len() == 0 -> return zip_from_files([ZipFile]{})
    _: zip_files(archive)
    Ok(archive)
}

zip_next: fn(reader: [U8], index: Int) -> String ArchiveError! {
    names: zip_list(reader)
    if index < 0 || index >= names.len() -> return Err(ArchiveError.NotFound)
    Ok(names[index])
}

zip_read: fn(reader: [U8], name: String) -> [U8] ArchiveError! {
    zip_extract(reader, name)
}

zip_write: fn(writer: [U8], name: String, data: [U8]) -> [U8] ArchiveError! {
    files := zip_parse_writer(writer)
    if files.len() >= C_MAX_ENTRIES -> return Err(ArchiveError.Unsupported)
    files.push(ZipFile{name: name, data: data})
    zip_from_files(files)
}

zip_close: fn(writer: [U8]) -> [U8] ArchiveError! {
    if writer.len() > 0 {
        _: zip_files(writer)
    }
    Ok(writer)
}

zip_extract: fn(archive: [U8], name: String) -> [U8] ArchiveError! {
    files: zip_files(archive)
    loop f in files {
        if f.name == name -> return Ok(f.data)
    }
    Err(ArchiveError.NotFound)
}
unzip: fn(archive: [U8], name: String) -> [U8] ArchiveError! { zip_extract(archive, name) }

/// Append one regular-file entry to an in-memory tar archive. A traversal,
/// absolute, NUL- or backslash-bearing name is `ArchiveError.Malformed`; data
/// or a result above the 64 MiB budget is `ArchiveError.Unsupported`. The
/// input archive is never returned unchanged as a silent refusal.
tar_add: fn(archive: [U8], name: String, data: [U8]) -> [U8] ArchiveError! {
    if !archive_name_valid(name) -> return Err(ArchiveError.Malformed)
    if data.len() > C_MAX_OUTPUT -> return Err(ArchiveError.Unsupported)
    nb: name.bytes()
    base_end := archive.len()
    if archive.len() >= 1024 && tar_end_valid(archive, archive.len() - 1024) {
        base_end = archive.len() - 1024
    }
    added := tar_record_size(data.len()) + 1024
    if nb.len() > 100 -> added = added + tar_record_size(nb.len() + 1)
    if base_end > C_MAX_OUTPUT || added > C_MAX_OUTPUT - base_end {
        return Err(ArchiveError.Unsupported)
    }
    out := [U8]{}
    loop i in 0..<base_end -> out.push(archive[i])
    if nb.len() > 100 {
        long_data := [U8]{}
        loop b in nb -> long_data.push(b)
        long_data.push(U8{0})
        append_tar_record(out, "././#LongLink", long_data, 76)
    }
    append_tar_record(out, name, data, 48)
    append_tar_end(out)
    Ok(out)
}



tar_get: fn(archive: [U8], name: String) -> [U8] ArchiveError! {
    if archive.len() == 0 -> return Err(ArchiveError.Malformed)
    i := 0
    entries := 0
    pending_name := ""
    has_pending_name := false
    found := [U8]{}
    matched := false
    saw_end := false
    loop i < archive.len() {
        if i + 512 > archive.len() -> return Err(ArchiveError.Malformed)
        hdr := [U8]{}
        loop k in 0..<512 -> hdr.push(archive[i + k])
        if tar_empty(hdr) {
            if !tar_end_valid(archive, i) -> return Err(ArchiveError.Malformed)
            saw_end = true
            i = archive.len()
            break
        }
        if !tar_checksum_valid(hdr) -> return Err(ArchiveError.Checksum)
        entries += 1
        if entries > C_MAX_ENTRIES -> return Err(ArchiveError.Unsupported)
        kind: u8_int(hdr[156])
        sz: tar_size(hdr)
        i += 512
        if sz > C_MAX_OUTPUT -> return Err(ArchiveError.Unsupported)
        if i + sz > archive.len() -> return Err(ArchiveError.Malformed)
        body := [U8]{}
        loop k in 0..<sz -> body.push(archive[i + k])
        i += sz
        if sz % 512 != 0 {
            pad := 512 - (sz % 512)
            if i + pad > archive.len() -> return Err(ArchiveError.Malformed)
            loop k in i..<(i + pad) {
                if archive[k] != (U8{0}) -> return Err(ArchiveError.Malformed)
            }
            i += pad
        }
        if kind == 76 {
            pending_name = tar_long_name(body)
            has_pending_name = true
            next
        }
        if kind == 120 {
            pax_name: tar_pax_name(body)
            if pax_name != "" {
                pending_name = pax_name
                has_pending_name = true
            }
            next
        }
        if kind != 0 && kind != 48 -> return Err(ArchiveError.Unsupported)
        normal_name: tar_name(hdr)
        entry_name := normal_name
        if has_pending_name {
            entry_name = pending_name.copy()
            has_pending_name = false
        }
        if !archive_name_valid(entry_name) -> return Err(ArchiveError.Malformed)
        if entry_name == name && !matched {
            found = body
            matched = true
        }
    }
    if !saw_end || has_pending_name -> return Err(ArchiveError.Malformed)
    if matched -> return Ok(found)
    Err(ArchiveError.NotFound)
}

tar_names_json: fn(archive: [U8]) -> String ArchiveError! {
    if archive.len() == 0 -> return Err(ArchiveError.Malformed)
    out := [U8]{U8{91}}
    total := 1
    first := true
    pending_name := ""
    has_pending_name := false
    i := 0
    entries := 0
    saw_end := false
    loop i < archive.len() {
        if i + 512 > archive.len() -> return Err(ArchiveError.Malformed)
        hdr := [U8]{}
        loop k in 0..<512 -> hdr.push(archive[i + k])
        if tar_empty(hdr) {
            if !tar_end_valid(archive, i) -> return Err(ArchiveError.Malformed)
            saw_end = true
            i = archive.len()
            break
        }
        if !tar_checksum_valid(hdr) -> return Err(ArchiveError.Checksum)
        entries += 1
        if entries > C_MAX_ENTRIES -> return Err(ArchiveError.Unsupported)
        kind: u8_int(hdr[156])
        sz: tar_size(hdr)
        i += 512
        if sz > C_MAX_OUTPUT -> return Err(ArchiveError.Unsupported)
        if i + sz > archive.len() -> return Err(ArchiveError.Malformed)
        body := [U8]{}
        loop k in 0..<sz -> body.push(archive[i + k])
        i += sz
        if sz % 512 != 0 {
            pad := 512 - (sz % 512)
            if i + pad > archive.len() -> return Err(ArchiveError.Malformed)
            loop k in i..<(i + pad) {
                if archive[k] != (U8{0}) -> return Err(ArchiveError.Malformed)
            }
            i += pad
        }
        if kind == 76 {
            pending_name = tar_long_name(body)
            has_pending_name = true
            next
        }
        if kind == 120 {
            pax_name: tar_pax_name(body)
            if pax_name != "" {
                pending_name = pax_name
                has_pending_name = true
            }
            next
        }
        if kind != 0 && kind != 48 -> return Err(ArchiveError.Unsupported)
        normal_name: tar_name(hdr)
        nm := normal_name
        if has_pending_name {
            nm = pending_name.copy()
            has_pending_name = false
        }
        if !archive_name_valid(nm) -> return Err(ArchiveError.Malformed)
        escaped: json_escape(nm)
        extra := escaped.len() + 2
        if !first -> extra += 1
        if total + extra + 1 > C_MAX_JSON -> return Err(ArchiveError.Unsupported)
        names_json_push(out, escaped, first)
        total += extra
        first = false
    }
    if !saw_end || has_pending_name -> return Err(ArchiveError.Malformed)
    names_json_finish(out)
}

// The names JSON grows in one byte buffer: rebuilding a String per name made
// listing an archive quadratic in the JSON size, minutes near C_MAX_JSON.
names_json_push: fn(out: &[U8], escaped: String, first: Bool) Never! {
    if !first -> out.push(U8{44})
    out.push(U8{34})
    loop b in escaped.bytes() -> out.push(b)
    out.push(U8{34})
}

names_json_finish: fn(out: [U8]) -> String ArchiveError! {
    done := out
    done.push(U8{93})
    String.from_bytes(done) ?? return Err(ArchiveError.Malformed)
}

ZipFile: struct {
    name: String
    data: [U8]
}

/// Encode stored ZIP entries. More than `C_MAX_ENTRIES` entries, or any size
/// above the 64 MiB budget, is `Unsupported`; an unsafe name is `Malformed`.
zip_from_files: fn(files: [ZipFile]) -> [U8] ArchiveError! {
    if files.len() > C_MAX_ENTRIES -> return Err(ArchiveError.Unsupported)
    materialized := 0
    encoded_size := 22
    loop f in files {
        nb: f.name.bytes()
        if !zip_name_valid(f.name) -> return Err(ArchiveError.Malformed)
        if f.data.len() > C_MAX_OUTPUT || nb.len() > 65535 -> return Err(ArchiveError.Unsupported)
        if nb.len() > C_MAX_OUTPUT - materialized -> return Err(ArchiveError.Unsupported)
        materialized = materialized + nb.len()
        if f.data.len() > C_MAX_OUTPUT - materialized -> return Err(ArchiveError.Unsupported)
        materialized = materialized + f.data.len()
        entry_size := 76 + nb.len() * 2 + f.data.len()
        if entry_size > C_MAX_OUTPUT - encoded_size -> return Err(ArchiveError.Unsupported)
        encoded_size = encoded_size + entry_size
    }
    out := [U8]{}
    offsets := [Int]{}
    loop f in files {
        offsets.push(out.len())
        crc: crc32(f.data)
        nb: f.name.bytes()
        put32(out, 0x04034b50)
        put16(out, 20)
        put16(out, 2048)
        put16(out, 0)
        put16(out, 0)
        put16(out, 0)
        put32(out, crc)
        put32(out, f.data.len())
        put32(out, f.data.len())
        put16(out, nb.len())
        put16(out, 0)
        loop b in nb -> out.push(b)
        loop b in f.data -> out.push(b)
    }
    cd: out.len()
    loop i in 0..<files.len() {
        f: files[i]
        nb: f.name.bytes()
        crc: crc32(f.data)
        put32(out, 0x02014b50)
        put16(out, 20)
        put16(out, 20)
        put16(out, 2048)
        put16(out, 0)
        put16(out, 0)
        put16(out, 0)
        put32(out, crc)
        put32(out, f.data.len())
        put32(out, f.data.len())
        put16(out, nb.len())
        put16(out, 0)
        put16(out, 0)
        put16(out, 0)
        put16(out, 0)
        put32(out, 0)
        put32(out, offsets[i])
        loop b in nb -> out.push(b)
    }
    cdlen: out.len() - cd
    put32(out, 0x06054b50)
    put16(out, 0)
    put16(out, 0)
    put16(out, files.len())
    put16(out, files.len())
    put32(out, cdlen)
    put32(out, cd)
    put16(out, 0)
    if out.len() > C_MAX_OUTPUT -> return Err(ArchiveError.Unsupported)
    Ok(out)
}

zip_files: fn(archive: [U8]) -> [ZipFile] ArchiveError! {
    if archive.len() == 0 -> return Err(ArchiveError.Malformed)
    files := [ZipFile]{}
    offsets := [Int]{}
    flags_list := [Int]{}
    methods := [Int]{}
    crcs := [Int]{}
    compressed_sizes := [Int]{}
    uncompressed_sizes := [Int]{}
    total := 0
    i := 0
    closed := false
    loop {
        if i + 4 > archive.len() -> return Err(ArchiveError.Malformed)
        sig: u32(archive, i)
        if sig == 0x06054b50 {
            if files.len() != 0 || i + 22 > archive.len() -> return Err(ArchiveError.Malformed)
            if u16(archive, i + 4) != 0 ||
                u16(archive, i + 6) != 0 ||
                u16(archive, i + 8) != 0 ||
                u16(archive, i + 10) != 0 ||
                u32(archive, i + 12) != 0 ||
                u32(archive, i + 16) != 0 {
                return Err(ArchiveError.Malformed)
            }
            comment_len: u16(archive, i + 20)
            if i + 22 + comment_len != archive.len() -> return Err(ArchiveError.Malformed)
            closed = true
            break
        }
        if sig == 0x02014b50 {
            if files.len() == 0 ||
                !zip_central_valid(
                    archive,
                    i,
                    files,
                    offsets,
                    flags_list,
                    methods,
                    crcs,
                    compressed_sizes,
                    uncompressed_sizes,
                ) {
                return Err(ArchiveError.Malformed)
            }
            closed = true
            break
        }
        if sig != 0x04034b50 -> return Err(ArchiveError.Malformed)
        if files.len() >= C_MAX_ENTRIES -> return Err(ArchiveError.Unsupported)
        if i + 30 > archive.len() -> return Err(ArchiveError.Malformed)
        entry_start := i
        flags: u16(archive, i + 6)
        method: u16(archive, i + 8)
        crc: u32(archive, i + 14)
        csz: u32(archive, i + 18)
        usz: u32(archive, i + 22)
        nlen: u16(archive, i + 26)
        elen: u16(archive, i + 28)
        if flags != 0 && flags != 2048 -> return Err(ArchiveError.Unsupported)
        if ((flags).bit_and(1)) != 0 || ((flags).bit_and(8)) != 0 -> return Err(ArchiveError.Unsupported)
        if method != 0 && method != 8 -> return Err(ArchiveError.Unsupported)
        if csz > C_MAX_OUTPUT -> return Err(ArchiveError.Unsupported)
        if usz > C_MAX_OUTPUT || usz > C_MAX_OUTPUT - total -> return Err(ArchiveError.Unsupported)
        if nlen > C_MAX_OUTPUT - total - usz -> return Err(ArchiveError.Unsupported)
        i = i + 30
        if i + nlen > archive.len() -> return Err(ArchiveError.Malformed)
        name: String.from_bytes(cut(archive, i, i + nlen)) ?? return Err(ArchiveError.Malformed)
        if !zip_name_valid(name) -> return Err(ArchiveError.Malformed)
        i = i + nlen
        if i + elen > archive.len() -> return Err(ArchiveError.Malformed)
        i = i + elen
        if i + csz > archive.len() -> return Err(ArchiveError.Malformed)
        payload: cut(archive, i, i + csz)
        i = i + csz
        data := payload.copy()
        if method == 8 {
            decoded: inflate(payload)
            data = decoded
        }
        if data.len() != usz -> return Err(ArchiveError.Malformed)
        if crc32(data) != crc -> return Err(ArchiveError.Checksum)
        total = total + nlen + data.len()
        offsets.push(entry_start)
        flags_list.push(flags)
        methods.push(method)
        crcs.push(crc)
        compressed_sizes.push(csz)
        uncompressed_sizes.push(usz)
        files.push(ZipFile{name: name, data: data})
    }
    if !closed -> return Err(ArchiveError.Malformed)
    Ok(files)
}

zip_list: fn(archive: [U8]) -> [String] ArchiveError! {
    names := [String]{}
    files: zip_files(archive)
    loop f in files -> names.push(f.name)
    Ok(names)
}

zip_parse_writer: fn(writer: [U8]) -> [ZipFile] ArchiveError! {
    if writer.len() == 0 -> return Ok([ZipFile]{})
    zip_files(writer)
}

zip_central_valid: fn(data: [U8], start: Int, files: [ZipFile], offsets: [Int], flags_list: [Int], methods: [Int], crcs: [Int], compressed_sizes: [Int], uncompressed_sizes: [Int]) -> Bool Never! {
    i := start
    index := 0
    loop {
        if i + 4 > data.len() -> return false
        sig: u32(data, i)
        if sig == 0x06054b50 {
            if index != files.len() || i + 22 > data.len() -> return false
            if u16(data, i + 4) != 0 ||
                u16(data, i + 6) != 0 ||
                u16(data, i + 8) != files.len() ||
                u16(data, i + 10) != files.len() ||
                u32(data, i + 12) != i - start ||
                u32(data, i + 16) != start {
                return false
            }
            comment_len: u16(data, i + 20)
            if i + 22 + comment_len != data.len() -> return false
            return true
        }
        if sig != 0x02014b50 || index >= files.len() || i + 46 > data.len() {
            return false
        }
        flags: u16(data, i + 8)
        method: u16(data, i + 10)
        crc: u32(data, i + 16)
        csz: u32(data, i + 20)
        usz: u32(data, i + 24)
        nlen: u16(data, i + 28)
        elen: u16(data, i + 30)
        clen: u16(data, i + 32)
        if flags != flags_list[index] ||
            method != methods[index] ||
            crc != crcs[index] ||
            csz != compressed_sizes[index] ||
            usz != uncompressed_sizes[index] ||
            u32(data, i + 42) != offsets[index] {
            return false
        }
        if i + 46 + nlen + elen + clen > data.len() -> return false
        name: String.from_bytes(cut(data, i + 46, i + 46 + nlen)) ?? return false
        if name != files[index].name -> return false
        i = i + 46 + nlen + elen + clen
        index = index + 1
    }
}

put16: fn(out: &[U8], n: Int) Never! {
    out.push(wrapping(U8{n}))
    out.push(wrapping(U8{n >> 8}))
}

put32: fn(out: &[U8], n: Int) Never! {
    out.push(wrapping(U8{n}))
    out.push(wrapping(U8{n >> 8}))
    out.push(wrapping(U8{n >> 16}))
    out.push(wrapping(U8{n >> 24}))
}

u16: fn(data: [U8], i: Int) -> Int Never! { (u8_int(data[i])).bit_or((u8_int(data[i + 1]) << 8)) }

u32: fn(data: [U8], i: Int) -> Int Never! {
    (((u8_int(data[i])).bit_or((u8_int(data[i + 1]) << 8))).bit_or((u8_int(data[i + 2]) << 16))).bit_or((u8_int(data[i + 3]) << 24))
}

cut: fn(data: [U8], a: Int, b: Int) -> [U8] Never! {
    out := [U8]{}
    i := a
    loop {
        if i >= b || i >= data.len() -> break
        out.push(data[i])
        i += 1
    }
    out
}

tar_header_kind: fn(name: String, size: Int, kind: Int) -> [U8] Never! {
    hdr := [U8]{}
    loop _ in 0..<512 -> hdr.push(U8{0})
    nb: name.bytes()
    loop i in 0..<nb.len() {
        if i >= 100 -> break
        hdr[i] = nb[i]
    }
    write_octal(hdr, 100, 8, 420)
    write_octal(hdr, 108, 8, 0)
    write_octal(hdr, 116, 8, 0)
    write_octal(hdr, 124, 12, size)
    write_octal(hdr, 136, 12, 0)
    hdr[156] = wrapping(U8{kind})
    // The ustar magic is part of the checksummed header, so it is written
    // before the checksum is summed.
    ustar: "ustar"
    loop i in 0..<5 -> hdr[257 + i] = ustar.bytes()[i]
    hdr[262] = (U8{0})
    hdr[263] = (U8{48})
    hdr[264] = (U8{48})
    loop i in 148..<156 -> hdr[i] = (U8{32})
    sum := 0
    loop b in hdr -> sum = sum + u8_int(b)
    write_octal(hdr, 148, 7, sum)
    hdr[155] = (U8{32})
    hdr
}

append_tar_record: fn(out: &[U8], name: String, data: [U8], kind: Int) Never! {
    hdr: tar_header_kind(name, data.len(), kind)
    loop b in hdr -> out.push(b)
    loop b in data -> out.push(b)
    if data.len() % 512 != 0 {
        loop _ in 0..<(512 - (data.len() % 512)) -> out.push(U8{0})
    }
}
append_tar_end: fn(out: &[U8]) Never! {
    loop _ in 0..<1024 -> out.push(U8{0})
}
tar_record_size: fn(size: Int) -> Int Never! {
    padded := size
    if size % 512 != 0 -> padded = padded + (512 - (size % 512))
    512 + padded
}

write_octal: fn(hdr: &[U8], off: Int, width: Int, value: Int) Never! {
    n := value
    i := off + width - 2
    hdr[off + width - 1] = (U8{0})
    loop i >= off {
        hdr[i] = wrapping(U8{48 + ((n).bit_and(7))})
        n = n >> 3
        i = i - 1
    }
}

archive_name_valid: fn(name: String) -> Bool Never! {
    raw: name.bytes()
    if raw.len() == 0 || raw[0] == (U8{47}) -> return false
    loop b in raw {
        if b == (U8{0}) || b == (U8{92}) -> return false
    }
    start := 0
    i := 0
    loop i <= raw.len() {
        if i == raw.len() || raw[i] == (U8{47}) {
            if i - start == 2 && raw[start] == (U8{46}) && raw[start + 1] == (U8{46}) -> return false
            start = i + 1
        }
        i = i + 1
    }
    true
}
zip_name_valid: fn(name: String) -> Bool Never! {
    if !archive_name_valid(name) -> return false
    loop b in name.bytes() {
        if b == (U8{92}) -> return false
    }
    true
}

tar_name: fn(hdr: [U8]) -> String ArchiveError! {
    end := 0
    loop end < 100 {
        if hdr[end] == (U8{0}) -> break
        end = end + 1
    }
    name: String.from_bytes(cut(hdr, 0, end)) ?? return Err(ArchiveError.Malformed)
    Ok(name)
}
tar_long_name: fn(body: [U8]) -> String ArchiveError! {
    end := 0
    terminated := false
    loop end < body.len() {
        if body[end] == (U8{0}) {
            terminated = true
            break
        }
        end = end + 1
    }
    if !terminated -> return Err(ArchiveError.Malformed)
    loop i in (end + 1)..<body.len() {
        if body[i] != (U8{0}) -> return Err(ArchiveError.Malformed)
    }
    name: String.from_bytes(cut(body, 0, end)) ?? return Err(ArchiveError.Malformed)
    Ok(name)
}

tar_pax_name: fn(body: [U8]) -> String ArchiveError! {
    i := 0
    found := ""
    has_found := false
    loop i < body.len() {
        len_end := i
        loop len_end < body.len() && body[len_end] != (U8{32}) {
            len_end += 1
        }
        if len_end == body.len() -> return Err(ArchiveError.Malformed)
        record_len: parse_decimal_limit(body, i, len_end, body.len()) ?? return Err(ArchiveError.Malformed)
        prefix_len := len_end - i + 1
        if record_len <= prefix_len || i + record_len > body.len() -> return Err(ArchiveError.Malformed)
        record_end := i + record_len
        if body[record_end - 1] != (U8{10}) -> return Err(ArchiveError.Malformed)
        field := len_end + 1
        value_end := record_end - 1
        if field + 5 <= value_end &&
            body[field] == (U8{112}) &&
            body[field + 1] == (U8{97}) &&
            body[field + 2] == (U8{116}) &&
            body[field + 3] == (U8{104}) &&
            body[field + 4] == (U8{61}) {
            value: String.from_bytes(cut(body, field + 5, value_end)) ?? return Err(ArchiveError.Malformed)
            if value == "" -> return Err(ArchiveError.Malformed)
            found = value
            has_found = true
        }
        i = record_end
    }
    if has_found -> Ok(found) else -> Ok("")
}

parse_decimal_limit: fn(data: [U8], start: Int, end: Int, limit: Int) -> Int? {
    if start >= end -> return None
    n := 0
    i := start
    loop i < end {
        d: u8_int(data[i])
        if d < 48 || d > 57 -> return None
        digit := d - 48
        if n > limit /% 10 || (n == limit /% 10 && digit > limit % 10) -> return None
        n = n * 10 + digit
        i = i + 1
    }
    Val(n)
}

tar_size: fn(hdr: [U8]) -> Int ArchiveError! {
    parse_octal(hdr, 124, 12, C_MAX_OUTPUT) ?? return Err(ArchiveError.Malformed)
}

parse_octal: fn(hdr: [U8], off: Int, width: Int, limit: Int) -> Int? {
    n := 0
    seen := false
    ended := false
    overflow := false
    loop i in 0..<width {
        d: u8_int(hdr[off + i])
        if d >= 48 && d <= 55 {
            if ended -> return None
            digit := d - 48
            if !overflow {
                if n > limit /% 8 || (n == limit /% 8 && digit > limit % 8) {
                    overflow = true
                } else {
                    n = n * 8 + digit
                }
            }
            seen = true
        } else if d == 0 || d == 32 {
            if seen -> ended = true
        } else {
            return None
        }
    }
    if !seen -> return Val(0)
    if overflow -> return Val(limit + 1)
    Val(n)
}

tar_checksum_valid: fn(hdr: [U8]) -> Bool Never! {
    stored: parse_octal(hdr, 148, 8, C_MAX_OUTPUT)
    if stored == {
        .None -> return false
        .Val(value) -> {
            sum := 0
            loop i in 0..<512 {
                if i >= 148 && i < 156 -> sum = sum + 32 else -> sum = sum + u8_int(hdr[i])
            }
            return value == sum
        }
    }
    false
}

tar_empty: fn(hdr: [U8]) -> Bool Never! {
    loop b in hdr {
        if b != (U8{0}) -> return false
    }
    true
}

tar_end_valid: fn(archive: [U8], start: Int) -> Bool Never! {
    if start > archive.len() || archive.len() - start < 1024 -> return false
    loop i in start..<archive.len() {
        if archive[i] != (U8{0}) -> return false
    }
    true
}
/// Escaping only replaces ASCII bytes with ASCII sequences, so UTF-8 input
/// stays valid; a failed rebuild is reported as `Malformed`, never as "".
json_escape: fn(value: String) -> String ArchiveError! {
    raw: value.bytes()
    out := [U8]{}
    loop b in raw {
        n: u8_int(b)
        if n == 92 {
            out.push(U8{92})
            out.push(U8{92})
        } else if n == 34 {
            out.push(U8{92})
            out.push(U8{34})
        } else if n == 8 {
            out.push(U8{92})
            out.push(U8{98})
        } else if n == 9 {
            out.push(U8{92})
            out.push(U8{116})
        } else if n == 10 {
            out.push(U8{92})
            out.push(U8{110})
        } else if n == 12 {
            out.push(U8{92})
            out.push(U8{102})
        } else if n == 13 {
            out.push(U8{92})
            out.push(U8{114})
        } else if n < 32 {
            out.push(U8{92})
            out.push(U8{117})
            out.push(U8{48})
            out.push(U8{48})
            out.push(hex_digit(n >> 4))
            out.push(hex_digit((n).bit_and(15)))
        } else {
            out.push(b)
        }
    }
    String.from_bytes(out) ?? return Err(ArchiveError.Malformed)
}

hex_digit: fn(n: Int) -> U8 Never! {
    if n < 10 -> return wrapping(U8{48 + n})
    wrapping(U8{87 + n})
}

u8_int: fn(b: U8) -> Int Never! { Int{b} }
/// Create a one-entry ZIP archive. An unsafe name is `ArchiveError.Malformed`;
/// data above the 64 MiB budget is `ArchiveError.Unsupported`.
create: fn(name: String, data: [U8]) -> [U8] ArchiveError! {
    zip_from_files([ZipFile]{ZipFile{name: name, data: data}})
}
