// core.data.plot — text and SVG charts from labelled series.
//
// A plan is a mark plus aligned `labels` / `values`. Rendering never talks to
// a GPU: `svg` / `bar_svg` / `line_svg` emit XML, `text` / `bar_text` /
// `line_text` emit a fixed-width sparkline. `inspect_json` is a compact
// schema fact for tests.
pub enum JetDataPlotMark {
    Bar
    Line
    Point
}

pub enum JetDataPlotChannel {
    X
    Y
    Color
    Size
}

pub enum JetDataPlotAggregate {
    Sum
    Mean
    Count
    Min
    Max
}

pub enum JetDataPlotFilterOp {
    Eq
    Ne
    Lt
    Le
    Gt
    Ge
}

pub enum JetDataPlotValue {
    Number
    Text
    Bool
}

pub enum JetDataPlotTransform {
    Identity
    Filter
    Aggregate
}

pub enum JetDataPlotScaleKind {
    Linear
    Log
    Band
}

pub enum JetDataPlotDomain {
    Auto
    Explicit
}

pub enum JetDataPlotLegendPosition {
    Top
    Bottom
    Left
    Right
}

pub enum JetDataPlotFacetKind {
    Wrap
    Grid
}

pub enum JetDataPlotInteraction {
    Hover
    Select
    Pan
}

pub enum JetDataPlotBackend {
    Svg
    Text
}

pub enum JetDataPlotSupport {
    Full
    Partial
    Unsupported
}

pub enum JetDataPlotErrorKind {
    Schema
    Encoding
    Render
}

pub enum JetDataPlotRenderFormat {
    Svg
    Text
    Json
}

pub struct JetDataPlotField {
    pub name: String
    pub kind: JetDataPlotValue
}

pub struct JetDataPlotSchema {
    pub fields: [JetDataPlotField]
}

pub struct JetDataPlotSourceFacts {
    pub rows: Int
    pub columns: Int
}

pub struct JetDataPlotEncoding {
    pub x: String
    pub y: String
    pub mark: JetDataPlotMark
}

pub struct JetDataPlotScale {
    pub kind: JetDataPlotScaleKind
    pub field: String
}

pub struct JetDataPlotAxis {
    pub field: String
    pub title: String
}

pub struct JetDataPlotLegend {
    pub position: JetDataPlotLegendPosition
}

pub struct JetDataPlotFacet {
    pub kind: JetDataPlotFacetKind
    pub field: String
}

pub struct JetDataPlotLayer {
    pub mark: JetDataPlotMark
    pub encoding: JetDataPlotEncoding
}

pub struct JetDataPlotAccessibility {
    pub title: String
    pub summary: String
}

pub struct JetDataPlotLayout {
    pub width: Int
    pub height: Int
}

pub struct JetDataPlotCapability {
    pub backend: JetDataPlotBackend
    pub support: JetDataPlotSupport
}

#Error
pub struct JetDataPlotError {
    pub kind: JetDataPlotErrorKind
    pub message: String
}

pub struct JetDataPlotColumn {
    pub name: String
    pub values: [String]
}

pub struct JetDataPlotSelectedRow {
    pub index: Int
}

pub struct JetDataPlotInspection {
    pub text: String
}

pub struct JetDataPlotRender {
    pub format: JetDataPlotRenderFormat
    pub body: String
}

pub struct JetDataPlotProjection {
    pub start: Int
    pub end: Int
}

pub struct JetDataPlotPlan {
    pub mark: JetDataPlotMark
    pub labels: [String]
    pub values: [Float]
    pub layout: JetDataPlotLayout
    pub encoding: JetDataPlotEncoding
    pub schema: JetDataPlotSchema
}

/// Build a chart plan. Values shorter than labels read as 0.
pub fn plot(mark: JetDataPlotMark, labels: [String], values: [Float]) -> JetDataPlotPlan {
    h := 24 * labels.len() + 16
    if mark == JetDataPlotMark.Line || mark == JetDataPlotMark.Point -> h = 120
    fields := [JetDataPlotField]{JetDataPlotField{name: "x", kind: JetDataPlotValue.Text}, JetDataPlotField{name: "y", kind: JetDataPlotValue.Number}}
    {
        mark: mark,
        labels: labels,
        values: values,
        layout: JetDataPlotLayout{width: 320, height: h},
        encoding: JetDataPlotEncoding{x: "x", y: "y", mark: mark},
        schema: JetDataPlotSchema{fields: fields},
    }
}

pub fn bar_text(labels: [String], values: [Int]) -> String {
    ys := [Float]{}
    loop v in values -> ys.push(Float{v})
    render_bar_text(labels, ys)
}

pub fn bar_svg(labels: [String], values: [Int]) -> String {
    ys := [Float]{}
    loop v in values -> ys.push(Float{v})
    render_bar_svg(labels, ys)
}

pub fn line_text(labels: [String], values: [Int]) -> String {
    ys := [Float]{}
    loop v in values -> ys.push(Float{v})
    render_line_text(labels, ys)
}

pub fn line_svg(labels: [String], values: [Int]) -> String {
    ys := [Float]{}
    loop v in values -> ys.push(Float{v})
    render_line_svg(labels, ys)
}

pub fn inspect(labels: [String], values: [Int]) -> String { bar_text(labels, values) }

pub fn inspect_json(plan: JetDataPlotPlan) -> String {
    mark := "bar"
    if plan.mark == JetDataPlotMark.Line -> mark = "line"
    if plan.mark == JetDataPlotMark.Point -> mark = "point"
    "{{\"mark\":\"{mark}\",\"n\":{plan.labels.len()},\"width\":{plan.layout.width},\"height\":{plan.layout.height}}}"
}

pub fn render(plan: JetDataPlotPlan) -> JetDataPlotRender {
    if plan.mark == JetDataPlotMark.Line {
        return {format: JetDataPlotRenderFormat.Svg, body: render_line_svg(plan.labels, plan.values)}
    }
    if plan.mark == JetDataPlotMark.Point {
        return {format: JetDataPlotRenderFormat.Svg, body: render_point_svg(plan.labels, plan.values)}
    }
    {format: JetDataPlotRenderFormat.Svg, body: render_bar_svg(plan.labels, plan.values)}
}

pub fn svg(plan: JetDataPlotPlan) -> String { render(plan).body }

pub fn text(plan: JetDataPlotPlan) -> String {
    if plan.mark == JetDataPlotMark.Line -> return render_line_text(plan.labels, plan.values)
    render_bar_text(plan.labels, plan.values)
}

pub fn show(plan: JetDataPlotPlan) -> String { text(plan) }

fn render_bar_text(labels: [String], values: [Float]) -> String {
    out := ""
    max := 1.0
    loop v in values {
        if v > max -> max = v
    }
    loop i in 0..<labels.len() {
        v := 0.0
        if i < values.len() -> v = values[i]
        w := 0
        if max > 0.0 -> w = (Int{v * 20.0 / max})
        bar := ""
        loop _ in 0..<w -> bar = "{bar}#"
        out = "{out}{labels[i]} | {bar} {v}\n"
    }
    out
}

fn render_bar_svg(labels: [String], values: [Float]) -> String {
    max := 1.0
    loop v in values {
        if v > max -> max = v
    }
    w := 320
    h := 24 * labels.len() + 16
    out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{w}\" height=\"{h}\">"
    loop i in 0..<labels.len() {
        v := 0.0
        if i < values.len() -> v = values[i]
        bw := 0
        if max > 0.0 -> bw = (Int{v * 200.0 / max})
        y := 8 + i * 24
        out = "{out}<text x=\"4\" y=\"{y + 12}\" font-size=\"12\">{labels[i]}</text>"
        out = "{out}<rect x=\"80\" y=\"{y}\" width=\"{bw}\" height=\"16\" fill=\"#4a90d9\"/>"
    }
    "{out}</svg>"
}

fn render_line_text(labels: [String], values: [Float]) -> String {
    out := ""
    loop i in 0..<labels.len() {
        v := 0.0
        if i < values.len() -> v = values[i]
        out = "{out}{labels[i]}={v}\n"
    }
    out
}

fn render_line_svg(labels: [String], values: [Float]) -> String {
    n :: labels.len()
    w := 320
    h := 120
    max := 1.0
    loop v in values {
        if v > max -> max = v
    }
    out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{w}\" height=\"{h}\"><polyline fill=\"none\" stroke=\"#4a90d9\" points=\""
    loop i in 0..<n {
        v := 0.0
        if i < values.len() -> v = values[i]
        x := 8
        if n > 1 -> x = i * (w - 16) / (n - 1) + 8
        y := h - 8
        if max > 0.0 -> y = h - 8 - (Int{v * (Float{h - 16}) / max})
        if i > 0 -> out = "{out} "
        out = "{out}{x},{y}"
    }
    "{out}\"/></svg>"
}

fn render_point_svg(labels: [String], values: [Float]) -> String {
    n :: labels.len()
    w := 320
    h := 120
    max := 1.0
    loop v in values {
        if v > max -> max = v
    }
    out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{w}\" height=\"{h}\">"
    loop i in 0..<n {
        v := 0.0
        if i < values.len() -> v = values[i]
        x := 8
        if n > 1 -> x = i * (w - 16) / (n - 1) + 8
        y := h - 8
        if max > 0.0 -> y = h - 8 - (Int{v * (Float{h - 16}) / max})
        out = "{out}<circle cx=\"{x}\" cy=\"{y}\" r=\"3\" fill=\"#4a90d9\"/>"
    }
    "{out}</svg>"
}
