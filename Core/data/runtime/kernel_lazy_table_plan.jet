    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1795
    pub fn append_unary(self: &JetTablePlan, operation: JetTableOperation, schema: JetTableSchema, callable: JetTableCallable?) -> JetTableNodeId JetTablePlanError! {
        input :: self.output
        self.append(operation, [input], ^schema, ^callable)
    }
}

