    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1709
    // Append the right-side scan without changing the current output.
    pub fn append_source(self: &JetTablePlan, source: JetTableSource) -> JetTableNodeId JetTablePlanError! {
        _ :: self.validate() ?? return Err(^err)
        id :: JetTableNodeId.new(self.nodes.len())
        node :: JetTableNode.scan(id, source.id.clone(), source.schema.clone(), jet_table_scan_facts(source))
        output :: self.output
        node_id :: self.append_node(^node) ?? return Err(^err)
        self.output = output
        Ok(node_id)
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1730
    // Parser/MIR construction permits invalid graphs; validate before use.
    pub fn from_parts<I: Into<JetTablePlanId>>(id: I, source: JetTableSource, nodes: [JetTableNode], output: JetTableNodeId) -> JetTablePlan {
        JetTablePlan{id: id.into(), source: ^source, nodes: ^nodes, output}
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1744
    pub fn output_node(self: JetTablePlan) -> &JetTableNode? { self.nodes.get(self.output.index()) }
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1748
    pub fn output_schema(self: JetTablePlan) -> &JetTableSchema? { self.output_node().map((node) -> &node.schema) }
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1752
    pub fn append_node(self: &JetTablePlan, node: JetTableNode) -> JetTableNodeId JetTablePlanError! {
        expected :: self.nodes.len()
        if node.id.index() != expected -> return Err(.NodeIdMismatch{expected, actual: node.id})
        id :: node.id
        old_output :: self.output
        self.nodes.push(^node)
        self.output = id
        if self.validate() == Err(error) {
            _ :: self.nodes.pop()
            self.output = old_output
            return Err(^error)
        }
        Ok(id)
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1772
    pub fn append(self: &JetTablePlan, operation: JetTableOperation, inputs: [JetTableNodeId], schema: JetTableSchema, callable: JetTableCallable?) -> JetTableNodeId JetTablePlanError! {
        id :: JetTableNodeId.new(self.nodes.len())
        node := JetTableNode.new(id, operation, ^inputs, ^schema)
        node.callable = ^callable
        if operation != .Scan {
            input_nodes :: node.inputs.iter().filter_map((input) -> self.nodes.get(input.index())).collect<[&JetTableNode]>()
            if input_nodes.len() == node.inputs.len() {
