    }
}

// Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1249
// Source metadata never carries its adapter's storage handle.
#Derive(Clone, Debug, Eq, PartialEq)
pub struct JetTableSource {
    pub id: JetTableSourceId
    pub schema: JetTableSchema
    pub rows: JetTableEstimate<U128>
    pub row_width_bytes: JetTableEstimate<U128>
}
impl JetTableSource {
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1260
    pub fn new<I: Into<JetTableSourceId>>(id: I, schema: JetTableSchema) -> JetTableSource {
        JetTableSource{id: id.into(), schema: ^schema, rows: .unavailable("source cardinality unavailable"),
            row_width_bytes: .unavailable("source row width unavailable")}
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1269
    pub fn with_rows(self: ^JetTableSource, rows: U128) -> JetTableSource { self.rows = .exact(rows); ^self }
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1274
    pub fn validate(self: JetTableSource) -> () JetTablePlanError! {
        _ :: self.id.validate().map_err((error) -> JetTablePlanError.Identity(^error)) ?? return Err(^err)
        _ :: self.schema.validate().map_err((error) -> JetTablePlanError.Schema(^error)) ?? return Err(^err)
        _ :: self.rows.validate().map_err((error) -> JetTablePlanError.Estimate(^error)) ?? return Err(^err)
        self.row_width_bytes.validate().map_err((error) -> JetTablePlanError.Estimate(^error))
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1285
    fn canonical_key(self: JetTableSource) -> String {
        "source={jet_table_escape(self.id.as_str())}:{self.schema.canonical_key()}:rows={self.rows.canonical_key()}:width={self.row_width_bytes.canonical_key()}"
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1299
// Preserve checked descriptor order and shared query identity derivation.
pub fn jet_table_plan_from_descriptors(row_type: String, columns: [String], rows: U128) -> JetTablePlan Err! {
    pairs := columns.chunks_exact(2)
    descriptors :: pairs.by_ref().map((pair) ->
        JetTableColumn.new(pair[0].clone(), JetTableTypeId.new(pair[1].clone()))).collect<[JetTableColumn]>()
    if !pairs.remainder().is_empty() -> return Err("table column metadata must contain alternating name/type pairs")
    row_type_id :: JetTableTypeId.new(row_type)
    schema :: JetTableSchema.new(^row_type_id, ^descriptors)
    source :: JetTableSource.new("data.query.source::<{row_type}>", ^schema).with_rows(rows)
    Ok(JetTablePlan.from_source("data.query::<{row_type}>", ^source))
}
// Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1330
fn jet_table_scan_facts(source: JetTableSource) -> JetTableFacts {
    output_bytes :: jet_table_estimate_mul(source.rows, source.row_width_bytes, "source output bytes unavailable")
    JetTableFacts{
        cardinality: JetTableCardinalityFacts{input_rows: [], output_rows: source.rows.clone(),
            rows_read: source.rows.clone(), rows_written: .exact(0)},
        cost: JetTableCostFacts{work_units: source.rows.clone(), memory_bytes: .exact(0), output_bytes: ^output_bytes}
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1351
pub fn jet_table_derive_facts(operation: JetTableOperation, inputs: [&JetTableNode], limit: U128?) -> JetTableFacts {
    input_rows :: inputs.iter().map((node) -> node.facts.cardinality.output_rows.clone()).collect<[JetTableEstimate<U128>]>()
    unknown :: (reason: String) -> JetTableEstimate<U128>.unavailable(reason)
    (output_rows, rows_read, rows_written, work_units, memory_bytes) :: if operation == {
        .Scan -> (unknown("scan facts require a source"), unknown("scan facts require a source"), JetTableEstimate<U128>.exact(0),
            unknown("scan facts require a source"), JetTableEstimate<U128>.exact(0))
        .Select | .Map -> {
            input :: input_rows.first().cloned().unwrap_or_else(() -> unknown("unary input cardinality unavailable"))
            (input.clone(), input.clone(), input.clone(), ^input, JetTableEstimate<U128>.exact(0))
        }
        .Filter -> {
            input :: input_rows.first().cloned().unwrap_or_else(() -> unknown("filter input cardinality unavailable"))
            (unknown("filter selectivity unavailable"), input.clone(), unknown("filter output cardinality unavailable"),
                ^input, JetTableEstimate<U128>.exact(0))
        }
        .Sort -> {
            input :: input_rows.first().cloned().unwrap_or_else(() -> unknown("sort input cardinality unavailable"))
            (input.clone(), input.clone(), input.clone(), unknown("sort comparison cost unavailable"), unknown("sort working memory unavailable"))
        }
        .Group -> {
            input :: input_rows.first().cloned().unwrap_or_else(() -> unknown("group input cardinality unavailable"))
            (unknown("group cardinality unavailable"), ^input, unknown("group output cardinality unavailable"),
                unknown("group aggregation cost unavailable"), unknown("group working memory unavailable"))
        }
        .Join -> {
            read :: if (input_rows.first(), input_rows.get(1)) == {
                (Some(left), Some(right)) -> jet_table_estimate_add(left, right, "join input cardinality unavailable")
                _ -> unknown("join input cardinality unavailable")
            }
            (unknown("join cardinality unavailable"), ^read, unknown("join output cardinality unavailable"),
                unknown("join matching cost unavailable"), unknown("join working memory unavailable"))
        }
        .Limit -> {
            input :: input_rows.first().cloned().unwrap_or_else(() -> unknown("limit input cardinality unavailable"))
            bound :: limit.unwrap_or(0)
            output :: jet_table_estimate_min(input, bound, "limit output cardinality unavailable")
            (output.clone(), output.clone(), output.clone(), ^output, JetTableEstimate<U128>.exact(0))
        }
    }
    JetTableFacts{
        cardinality: JetTableCardinalityFacts{input_rows: ^input_rows, output_rows: ^output_rows, rows_read: ^rows_read, rows_written: ^rows_written},
        cost: JetTableCostFacts{work_units: ^work_units, memory_bytes: ^memory_bytes,
            output_bytes: unknown("output bytes unavailable without a row width")}
    }
}

// Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1471
// Structured validation failures retain the failing identity and operation.
#Derive(Clone, Debug, Eq, PartialEq)
#Error
pub enum JetTablePlanError {
    Identity(JetTableIdentityError)
    Schema(JetTableSchemaError)
    Estimate(JetTableEstimateError)
    Facts(JetTableFactsError)
    Stream(JetTableStreamError)
    Batch(JetTableBatchError)
    EmptyPlan
    MissingScan
    InvalidOutput(JetTableNodeId)
    NodeIdMismatch { expected: Usize, actual: JetTableNodeId }
    UnknownInput { node: JetTableNodeId, input: JetTableNodeId }
    InputNotEarlier { node: JetTableNodeId, input: JetTableNodeId }
    Cycle(JetTableNodeId)
    WrongInputArity { node: JetTableNodeId, operation: JetTableOperation, expected: Usize, actual: Usize }
    MissingSource(JetTableNodeId)
    UnexpectedSource(JetTableNodeId)
    UnexpectedCallable(JetTableNodeId)
    UnexpectedJoinMetadata(JetTableNodeId)
    SourceMismatch
    SchemaMismatch { node: JetTableNodeId, input: JetTableNodeId }
    SelectionSchemaMismatch(JetTableNodeId)
    MissingCallable(JetTableNodeId)
    MissingCallableIdentity
    InvalidCallableIdentity(String)
    CallableParameterMismatch { node: JetTableNodeId, expected: JetTableTypeId, actual: JetTableTypeId }
    CallableResultMismatch { node: JetTableNodeId, expected: JetTableTypeId, actual: JetTableTypeId }
    MissingJoinKind(JetTableNodeId)
    InvalidJoinKey { node: JetTableNodeId, left: JetTableColumnId, right: JetTableColumnId }
    MissingLimit(JetTableNodeId)
    UnexpectedLimit(JetTableNodeId)
    UnexpectedSelection(JetTableNodeId)
    UnknownSelectedColumn { node: JetTableNodeId, column: JetTableColumnId }
    InvalidNote(JetTableNodeId)
    NotStreaming(JetTableNodeId)
}
impl Display for JetTablePlanError {
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1534
    fn fmt(self: JetTablePlanError, formatter: &Formatter) -> () std.fmt.Error! {
        if self == {
            .Identity(error) -> error.fmt(formatter)
            .Schema(error) -> error.fmt(formatter)
            .Estimate(error) -> error.fmt(formatter)
            .Facts(error) -> error.fmt(formatter)
            .Stream(error) -> error.fmt(formatter)
            .Batch(error) -> error.fmt(formatter)
            .EmptyPlan -> formatter.write_str("table plan has no nodes")
            .MissingScan -> formatter.write_str("table plan must start with a source scan")
            .InvalidOutput(id) -> formatter.write_fmt("table plan output node {id.index()} is missing")
            .NodeIdMismatch{expected, actual} -> formatter.write_fmt("table node id {actual.index()} does not match graph position {expected}")
            .UnknownInput{node, input} -> formatter.write_fmt("table node {node.index()} references unknown input {input.index()}")
            .InputNotEarlier{node, input} -> formatter.write_fmt("table node {node.index()} references non-previous input {input.index()}")
            .Cycle(node) -> formatter.write_fmt("table plan contains a cycle at node {node.index()}")
            .WrongInputArity{node, operation, expected, actual} -> formatter.write_fmt("table node {node.index()} operation `{operation}` needs {expected} inputs, got {actual}")
            .MissingSource(node) -> formatter.write_fmt("table scan node {node.index()} has no source")
            .UnexpectedSource(node) -> formatter.write_fmt("non-scan table node {node.index()} carries a source")
            .UnexpectedCallable(node) -> formatter.write_fmt("non-transform table node {node.index()} carries a callable")
            .UnexpectedJoinMetadata(node) -> formatter.write_fmt("non-join table node {node.index()} carries join metadata")
            .SourceMismatch -> formatter.write_str("table scan source or schema differs from plan source")
            .SchemaMismatch{node, input} -> formatter.write_fmt("table node {node.index()} schema does not preserve input node {input.index()} schema")
            .SelectionSchemaMismatch(node) -> formatter.write_fmt("table select node {node.index()} schema does not match selected columns")
            .MissingCallable(node) -> formatter.write_fmt("table node {node.index()} needs a checked callable")
            .MissingCallableIdentity -> formatter.write_str("table callable identity must not be empty")
            .InvalidCallableIdentity(id) -> formatter.write_fmt("table callable identity {id.debug()} contains a control character")
            .CallableParameterMismatch{node, expected, actual} -> formatter.write_fmt("table node {node.index()} callable takes {actual}, expected {expected}")
            .CallableResultMismatch{node, expected, actual} -> formatter.write_fmt("table node {node.index()} callable returns {actual}, expected {expected}")
            .MissingJoinKind(node) -> formatter.write_fmt("table join node {node.index()} has no join kind")
            .InvalidJoinKey{node, left, right} -> formatter.write_fmt("table join node {node.index()} has incompatible key pair {left} / {right}")
            .MissingLimit(node) -> formatter.write_fmt("table limit node {node.index()} has no row bound")
            .UnexpectedLimit(node) -> formatter.write_fmt("non-limit table node {node.index()} carries a row bound")
            .UnexpectedSelection(node) -> formatter.write_fmt("non-select table node {node.index()} carries selected columns")
            .UnknownSelectedColumn{node, column} -> formatter.write_fmt("table select node {node.index()} references unknown column {column}")
            .InvalidNote(node) -> formatter.write_fmt("table node {node.index()} note contains a control character")
            .NotStreaming(node) -> formatter.write_fmt("table node {node.index()} is explicitly materialized")
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1670
// The bounded graph owns metadata only; rows remain with source adapters.
#Derive(Clone, Debug, Eq, PartialEq)
pub struct JetTablePlan {
    pub id: JetTablePlanId
    pub source: JetTableSource
    pub nodes: [JetTableNode]
    pub output: JetTableNodeId
}
impl JetTablePlan {
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:1681
    pub fn new<I: Into<JetTablePlanId>, S: Into<JetTableSourceId>>(id: I, source: S, schema: JetTableSchema) -> JetTablePlan {
