// Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:210
fn jet_table_escape(value: String) -> String {
    escaped := String.with_capacity(value.len())
    loop character in value.chars() {
        if character == {
            '\\' -> escaped.push_str("\\\\")
            '|' -> escaped.push_str("\\|")
            ';' -> escaped.push_str("\\;")
            '=' -> escaped.push_str("\\=")
            ':' -> escaped.push_str("\\:")
            '\n' -> escaped.push_str("\\n")
            '\r' -> escaped.push_str("\\r")
            '\t' -> escaped.push_str("\\t")
            else -> escaped.push(character)
        }
    }
    ^escaped
}
// Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:228
fn jet_table_json_string(value: String) -> String {
    escaped := String.with_capacity(value.len().saturating_add(2))
    escaped.push('"')
    loop character in value.chars() {
        if character == {
            '"' -> escaped.push_str("\\\"")
            '\\' -> escaped.push_str("\\\\")
            '\n' -> escaped.push_str("\\n")
            '\r' -> escaped.push_str("\\r")
            '\t' -> escaped.push_str("\\t")
            '\u{08}' -> escaped.push_str("\\b")
            '\u{0c}' -> escaped.push_str("\\f")
            else -> {
                if character.is_control() -> escaped.push_str("\\u{(character as U32).hex(4)}")
                else -> escaped.push(character)
            }
        }
    }
    escaped.push('"')
    ^escaped
}
