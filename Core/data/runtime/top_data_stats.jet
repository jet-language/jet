// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataStats.rs:495
fn jet_data_stddev(values: &[F64]) -> F64 { jet_data_stddev_checked(values).unwrap_or(0.0) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataStats.rs:499
fn jet_data_rolling_mean(values: &[F64], width: I64) -> [F64] { jet_data_rolling_mean_checked(values, width.max(1)).unwrap_or_default() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataStats.rs:503
fn jet_data_describe(values: &[F64]) -> DataSummary {
    jet_data_describe_checked(values).unwrap_or(DataSummary{count: Int{values.len()}, sum: 0.0, mean: 0.0, min: 0.0, max: 0.0, median: 0.0, variance: 0.0, stddev: 0.0})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataStats.rs:516
fn jet_data_status_native(step: String) -> DataStatus {
    DataStatus{step: step, path: "native", clone_value: "none", ownership: "jet", trust: "native", fallback: "none", replacement: "native"}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataStats.rs:528
fn jet_data_bridge_tool_on_path(tool: String) -> Bool {
    // GATE #4565: kernel primitive
    #Unsafe("read OS PATH and inspect candidate tool file metadata; no provider is executed") {
        path :: match env.var_os("PATH") { Val(path) -> path; None -> return false }
        env.split_paths(&path).any(fn(dir) { dir.join(tool).is_file() })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataStats.rs:539
fn jet_data_bridge_path(step: String) -> String {
    if step == "r.*" && jet_data_bridge_tool_on_path("Rscript") {
        // GATE #4565: kernel primitive
        opt_in :: #Unsafe("R bridge availability requires explicit expert environment opt-in, not only a tool") { env.var("JET_DATA_R_BRIDGE").as_deref() == Ok("1") }
        if opt_in { return "available" }
    }
    "unavailable"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataStats.rs:553
fn jet_data_bridge_status(step: String) -> DataStatus {
    path :: jet_data_bridge_path(step)
    match step {
        "py.*" -> DataStatus{step: "py.*", path: path, clone_value: "owned-copy", ownership: "python-sidecar", trust: "untrusted-foreign", fallback: "none", replacement: "core.data native lists/query/stats"}
        "r.*" -> DataStatus{step: "r.*", path: path, clone_value: "owned-copy", ownership: "r-sidecar", trust: "untrusted-foreign", fallback: "none", replacement: "core.data Query<T> typed round-trip"}
        "gpu.*" -> DataStatus{step: "gpu.*", path: path, clone_value: "device-transfer", ownership: "device-buffer", trust: "untrusted-accelerator", fallback: "none", replacement: "core.data / Tensor native CPU path"}
        _ -> DataStatus{step: step, path: "unavailable", clone_value: "unknown", ownership: "unknown", trust: "untrusted-foreign", fallback: "none", replacement: "core.data native"}
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataStats.rs:595
fn jet_data_status() -> [DataStatus] {
    [jet_data_status_native("core.data.csv"), jet_data_status_native("core.data.stats"), jet_data_status_native("core.data.query"),
        jet_data_status_native("core.data.stream"), jet_data_status_native("core.data.schema"), jet_data_status_native("core.data.json"),
        jet_data_bridge_status("py.*"), jet_data_bridge_status("r.*"), jet_data_bridge_status("gpu.*")]
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataStats.rs:609
fn jet_data_normalize_bridge_provider(provider: String) -> String? {
    lower := provider.trim().trim_end_matches('.').to_ascii_lowercase() // #4303
    p := lower.strip_suffix(".*").unwrap_or(lower.as_str()) // #4303
    match p { "py" | "python" -> Val("py.*"); "r" -> Val("r.*"); "gpu" | "cuda" | "metal" | "vulkan" | "webgpu" -> Val("gpu.*"); _ -> None }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataStats.rs:621
fn jet_data_require_bridge(provider: &String) -> Result<(), DataError> {
    step :: match jet_data_normalize_bridge_provider(provider) {
        Val(step) -> step
        None -> return Err(jet_data_error(DataErrorKind.InvalidArgument, "require_bridge", "unknown data bridge provider `{provider}`; expected py, r, or gpu"))
    }
    status :: jet_data_bridge_status(step)
    if status.path == "available" { return Ok(()) }
    Err(jet_data_error(DataErrorKind.Bridge, "require_bridge", "{step} unavailable (clone_value={status.clone_value}, ownership={status.ownership}, trust={status.trust}, fallback={status.fallback}, replacement={status.replacement})"))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataStats.rs:643
fn jet_data_bar_text<K: JetShow, V: Clone + Ord + From<I64> + TryInto<I64> + Display>(groups: &[GroupValue<K, V>]) -> String {
    lines := [String]{}
    for group in groups {
        n :: group.value.clone().clamp(V.from(0), V.from(40)).try_into().ok().expect("plot width is clamped to 0..40") as I64
        bars :: "#".repeat(n as USize)
        lines.push("{group.key.jet_show()} | {bars} {group.value}")
    }
    lines.join("\n")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataStats.rs:665
fn jet_data_bar_svg<K: JetShow>(groups: &[GroupValue<K, I64>]) -> String {
    width :: 320.0
    row_h :: 24.0
    height :: 24.0 + row_h * (groups.len() as F64)
    max :: groups.iter().map(fn(group) { group.value }).max().unwrap_or(1).max(1) as F64
    out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"320\" height=\"{height as I64}\" viewBox=\"0 0 320 {height as I64}\">"
    out.push_str("<rect width=\"320\" height=\"100%\" fill=\"white\"/>")
    for (index, group) in groups.iter().enumerate() {
        y :: 18.0 + (index as F64) * row_h
        bar_w :: (((group.value.max(0) as F64) / max) * (width - 120.0)).round()
        out.push_str("<text x=\"8\" y=\"{y as I64}\" font-family=\"monospace\" font-size=\"12\">{jet_data_svg_escape(group.key.jet_show())}</text>")
        out.push_str("<rect x=\"96\" y=\"{(y - 12.0) as I64}\" width=\"{bar_w as I64}\" height=\"14\" fill=\"#2f6f73\"/>")
        out.push_str("<text x=\"{(104.0 + bar_w) as I64}\" y=\"{y as I64}\" font-family=\"monospace\" font-size=\"12\">{group.value}</text>")
    }
    out.push_str("</svg>")
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataStats.rs:707
fn jet_data_svg_escape(s: String) -> String { s.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;").replace('"', "&quot;") }
