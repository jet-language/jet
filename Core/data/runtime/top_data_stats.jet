fn jet_data_quantile(values: &[F64], q: F64) -> F64 { jet_data_quantile_checked(values, q.clamp(0.0, 1.0)).unwrap_or(0.0) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataStats.rs:491
