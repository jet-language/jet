    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:1901
    pub fn capabilities(self: &Self, backend: JetDataPlotBackend) -> [JetDataPlotCapability] {
        capabilities := [
            JetDataPlotCapability.supported(backend, "line"),
            JetDataPlotCapability.supported(backend, "bar"),
            JetDataPlotCapability.supported(backend, "point"),
            JetDataPlotCapability.supported(backend, "layers"),
            JetDataPlotCapability.supported(backend, "facets"),
            JetDataPlotCapability.supported(backend, "accessibility"),
        ]
        if backend == .Terminal {
            &capabilities.push(JetDataPlotCapability.degraded(backend, "svg",
                "terminal adapters emit text rather than SVG", "use the deterministic text projection"))
        } else { &capabilities.push(JetDataPlotCapability.supported(backend, "svg")) }
        loop interaction in &self.interactions {
            feature :: "interaction.{interaction.as_str()}"
            match backend {
                .Browser -> &capabilities.push(JetDataPlotCapability.degraded(backend, feature,
                    "a live client owns pointer and keyboard events",
                    "attach the browser interaction adapter to this checked plan"))
                .Terminal -> &capabilities.push(JetDataPlotCapability.unsupported(backend, feature,
                    "terminal output has no live pointer or keyboard session",
                    "inspect the source-backed selection or use browser.show"))
                .Native | .Export -> &capabilities.push(JetDataPlotCapability.degraded(backend, feature,
                    "this projection is static and does not own a live client",
                    "use the browser adapter for live interaction"))
            }
        }
        &capabilities.sort_by(fn(left, right) { left.feature.cmp(&right.feature) })
        ^capabilities
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:1949
    fn validate_transform(self: &Self, transform: &JetDataPlotTransform) -> JetDataPlotError! {
        match transform {
            .Filter{field, value, ..} -> {
                field :: self.schema.resolve(field)?
                if .Number(number) :: value {
                    if !number.is_finite() {
                        return Err(JetDataPlotError.non_finite("plot.transform", "filter literal must be finite").with_field(field.name.clone()))
                    }
                }
                if .Text(text) :: value {
                    if text.chars().any(fn(c) { c.is_control() }) {
                        return Err(JetDataPlotError.invalid("plot.transform", "filter text must not contain control characters").with_field(field.name.clone()))
                    }
                }
                if !jet_data_plot_filter_value_matches_type(value, &field.type_name) {
                    return Err(JetDataPlotError.invalid("plot.transform", "filter literal type does not match the table column")
                        .with_field(field.name.clone()).with_expected(field.type_name).with_actual(value.kind()))
                }
            }
            .Sort{field, ..} -> { _ :: self.schema.resolve(field)? }
            .Bin{field, step} -> {
                field :: self.schema.resolve(field)?
                if !jet_data_plot_numeric_type(&field.type_name) {
                    return Err(JetDataPlotError.invalid("plot.transform", "bin transform needs an integer or floating column").with_field(field.name))
                }
                if !step.is_finite() || step <= 0.0 {
                    return Err(JetDataPlotError.invalid("plot.transform", "bin step must be finite and positive").with_field(field.name))
                }
            }
            .Aggregate{group_by, field, aggregate} -> {
                loop field in group_by -> _ :: self.schema.resolve(field)?
                field :: self.schema.resolve(field)?
                if aggregate.needs_numeric() && !jet_data_plot_numeric_type(&field.type_name) {
                    return Err(JetDataPlotError.invalid("plot.transform", "numeric aggregation needs an integer or floating column")
                        .with_field(field.name).with_expected("numeric").with_actual(field.type_name))
                }
                if aggregate == .None {
                    return Err(JetDataPlotError.invalid("plot.transform", "aggregate transform needs a concrete aggregate").with_field(field.name))
                }
            }
        }
        Ok(())
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:2034
    fn validate_scale(self: &Self, scale: &JetDataPlotScale) -> JetDataPlotError! {
        encoding :: self.encodings.iter().find(fn(v) { v.channel == scale.channel })
            .ok_or_else(fn() { JetDataPlotError.invalid("plot.scale", "scale references a channel that is not encoded").with_channel(scale.channel) })?
        field :: self.schema.resolve(&encoding.field)?
        if scale.kind.needs_numeric() && !jet_data_plot_numeric_type(&field.type_name) {
            return Err(JetDataPlotError.invalid("plot.scale", "linear and log scales need an integer or floating column")
                .with_channel(scale.channel).with_field(field.name).with_expected("numeric").with_actual(field.type_name))
        }
        match &scale.domain {
            .Numeric{min, max} -> {
                if !min.is_finite() || !max.is_finite() || min >= max {
                    return Err(JetDataPlotError.invalid("plot.scale", "numeric scale domain must be finite and increasing").with_channel(scale.channel))
                }
                if scale.kind == .Log && min <= 0.0 {
                    return Err(JetDataPlotError.invalid("plot.scale", "log scale domain must be positive").with_channel(scale.channel))
                }
            }
            .Categories(values) -> {
                seen := BTreeSet.new()
                invalid := values.is_empty()
                loop value in values {
                    if value.trim().is_empty() || value.chars().any(fn(c) { c.is_control() }) || !seen.insert(value.clone()) {
                        invalid = true
                        break
                    }
                }
                if invalid {
                    return Err(JetDataPlotError.invalid("plot.scale", "categorical scale domain must contain unique non-empty labels").with_channel(scale.channel))
                }
                if scale.kind == .Linear || scale.kind == .Log {
                    return Err(JetDataPlotError.invalid("plot.scale", "numeric scales cannot use categorical domains").with_channel(scale.channel))
                }
            }
            .Auto -> {}
        }
        Ok(())
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:2104
    fn validate_layer(self: &Self, layer: &JetDataPlotLayer) -> JetDataPlotError! {
        if layer.name.trim().is_empty() || layer.name.chars().any(fn(c) { c.is_control() }) {
            return Err(JetDataPlotError.invalid("plot.layer", "plot layer name must be non-empty and control-free"))
        }
        if !layer.opacity.is_finite() || layer.opacity < 0.0 || layer.opacity > 1.0 {
            return Err(JetDataPlotError.invalid("plot.layer", "plot layer opacity must be finite and between zero and one").with_field(layer.name.clone()))
        }
        channels := BTreeSet.new()
        loop encoding in &layer.encodings {
            if !channels.insert(encoding.channel) {
                return Err(JetDataPlotError.invalid("plot.layer", "plot layer repeats an encoding channel")
                    .with_channel(encoding.channel).with_field(layer.name.clone()))
            }
            field :: self.schema.resolve(&encoding.field)?
            if encoding.aggregate.needs_numeric() && !jet_data_plot_numeric_type(&field.type_name) {
                return Err(JetDataPlotError.invalid("plot.layer", "numeric aggregation needs an integer or floating column")
                    .with_field(field.name).with_channel(encoding.channel))
            }
            if encoding.channel == .Size && !jet_data_plot_numeric_type(&field.type_name) {
                return Err(JetDataPlotError.invalid("plot.layer", "size encoding needs an integer or floating column")
                    .with_field(field.name).with_channel(encoding.channel))
            }
        }
        loop transform in &layer.transforms -> self.validate_transform(transform)?
        Ok(())
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:2154
    fn validate_mark_encodings(self: &Self, mark: JetDataPlotMark, encodings: [JetDataPlotEncoding]) -> JetDataPlotError! {
        x :: encodings.iter().find(fn(v) { v.channel == .X })
            .ok_or_else(fn() { JetDataPlotError.invalid("plot.mark", "plot mark needs an x encoding").with_mark(mark) })?
        y :: encodings.iter().find(fn(v) { v.channel == .Y })
            .ok_or_else(fn() { JetDataPlotError.invalid("plot.mark", "plot mark needs a y encoding").with_mark(mark) })?
        y_field :: self.schema.resolve(&y.field)?
        if !jet_data_plot_numeric_type(&y_field.type_name) {
            return Err(JetDataPlotError.invalid("plot.mark", "line, bar, and point marks need a numeric y encoding")
                .with_mark(mark).with_field(y_field.name).with_channel(.Y).with_expected("numeric").with_actual(y_field.type_name))
        }
        if x.aggregate.needs_numeric() {
            x_field :: self.schema.resolve(&x.field)?
            if !jet_data_plot_numeric_type(&x_field.type_name) {
                return Err(JetDataPlotError.invalid("plot.mark", "numeric x aggregation needs a numeric column")
                    .with_mark(mark).with_field(x_field.name).with_channel(.X))
            }
        }
        Ok(())
    }
}
