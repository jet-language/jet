// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:2262
#Derive(Clone, Debug, PartialEq)
pub struct JetDataPlotInspection {
    pub plan: JetDataPlotPlan
    pub selected_indices: [I64]
    pub selected_columns: [JetDataPlotField]
    pub selected_data: [JetDataPlotSelectedRow]
}
impl JetDataPlotInspection {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:2270
    pub fn text(self: &Self) -> String {
        plan :: self.plan.inspect_text().unwrap_or_else(fn(error) { error.to_string() })
        indices :: self.selected_indices.iter().map(fn(v) { v.to_string() }).collect<[String]>().join(",")
        columns :: self.selected_columns.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(",")
        out := "{plan} selected_indices=[{indices}] selected_columns=[{columns}] selected_data=["
        loop (position, row) in self.selected_data.iter().enumerate() {
            if position > 0 -> &out.push_str(",")
            values :: row.values.iter().map(fn((field, value)) {
                "{jet_data_plot_escape(&field.name)}={jet_data_plot_escape(&value.display_text())}"
            }).collect<[String]>().join(",")
            &out.push_str("{row.index}:[{values}]")
        }
        &out.push_str("]")
        ^out
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:2309
    pub fn json(self: &Self) -> String {
        out := "{\"plan\":"
        &out.push_str(jet_data_plot_plan_json(&self.plan))
        &out.push_str(",\"selected_indices\":[")
        &out.push_str(self.selected_indices.iter().map(fn(v) { v.to_string() }).collect<[String]>().join(","))
        &out.push_str("],\"selected_columns\":[")
        &out.push_str(self.selected_columns.iter().map(fn(field) {
            "{{\"id\":\"{jet_data_plot_json_escape(&field.id)}\",\"name\":\"{jet_data_plot_json_escape(&field.name)}\",\"type\":\"{jet_data_plot_json_escape(&field.type_name)}\"}}"
        }).collect<[String]>().join(","))
        &out.push_str("],\"selected_data\":[")
        &out.push_str(self.selected_data.iter().map(fn(row) {
            "{{\"index\":{row.index},\"values\":{jet_data_plot_values_json(&row.values)}}}"
        }).collect<[String]>().join(","))
        &out.push_str("]}")
        ^out
    }
}
