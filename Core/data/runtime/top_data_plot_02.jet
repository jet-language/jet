impl JetDataPlotPlan {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:1789
    pub fn canonical_key(self: &Self) -> String {
        encodings :: self.encodings.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(",")
        transforms :: self.transforms.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(",")
        scales :: self.scales.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(",")
        axes :: self.axes.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(",")
        legends :: self.legends.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(",")
        facets :: self.facets.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(",")
        layers :: self.layers.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(",")
        interactions :: self.interactions.iter().map(fn(v) { v.as_str() }).collect<[String]>().join(",")
        "version={JET_DATA_PLOT_SCHEMA_VERSION};source={self.source.canonical_key()};{self.schema.canonical_key()};limits={jet_data_plot_limits_key(&self.limits)};mark={self.mark.as_str()};encodings=[{encodings}];transforms=[{transforms}];scales=[{scales}];axes=[{axes}];legends=[{legends}];facets=[{facets}];layers=[{layers}];interactions=[{interactions}];accessibility={self.accessibility.canonical_key()};layout={self.layout.canonical_key()}"
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:1842
    pub fn inspect_text(self: &Self) -> String JetDataPlotError! {
        self.validate()?
        encodings :: self.encodings.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(",")
        transforms :: self.transforms.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(",")
        scales :: self.scales.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(",")
        axes :: self.axes.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(",")
        legends :: self.legends.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(",")
        facets :: self.facets.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(",")
        layers :: self.layers.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(",")
        interactions :: self.interactions.iter().map(fn(v) { v.as_str() }).collect<[String]>().join(",")
        Ok("plot version={JET_DATA_PLOT_SCHEMA_VERSION} source={self.source.canonical_key()} schema={self.schema.canonical_key()} limits={jet_data_plot_limits_key(&self.limits)} mark={self.mark.as_str()} encodings=[{encodings}] transforms=[{transforms}] scales=[{scales}] axes=[{axes}] legends=[{legends}] facets=[{facets}] layers=[{layers}] interactions=[{interactions}] layout={self.layout.canonical_key()} accessibility={self.accessibility.canonical_key()}")
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:1896
    pub fn inspect_json(self: &Self) -> String JetDataPlotError! {
        self.validate()?
        Ok(jet_data_plot_plan_json(self))
