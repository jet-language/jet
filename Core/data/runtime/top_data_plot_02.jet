// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3066
#Derive(Clone, Debug)
struct JetDataPlotDatum {
    ordinal: USize
    values: [(String, JetDataPlotValue)]
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3072
fn jet_data_plot_required_fields(plan: &JetDataPlotPlan) -> [JetDataPlotField] {
    fields := [JetDataPlotField]{}
    loop encoding in &plan.encodings -> jet_data_plot_push_field(&fields, &encoding.field)
    loop transform in &plan.transforms -> jet_data_plot_push_transform_fields(&fields, transform)
    loop facet in &plan.facets -> jet_data_plot_push_field(&fields, &facet.field)
    loop layer in &plan.layers {
        loop encoding in &layer.encodings -> jet_data_plot_push_field(&fields, &encoding.field)
        loop transform in &layer.transforms -> jet_data_plot_push_transform_fields(&fields, transform)
    }
    ^fields
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3094
fn jet_data_plot_push_transform_fields(fields: &[JetDataPlotField], transform: &JetDataPlotTransform) -> {
    match transform {
        .Filter{field, ..} | .Sort{field, ..} | .Bin{field, ..} -> jet_data_plot_push_field(fields, field)
        .Aggregate{group_by, field, ..} -> {
            loop group_field in group_by -> jet_data_plot_push_field(fields, group_field)
            jet_data_plot_push_field(fields, field)
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3113
fn jet_data_plot_push_field(fields: &[JetDataPlotField], field: &JetDataPlotField) -> {
    if !fields.iter().any(fn(known) { known.id == field.id }) -> &fields.push(field.clone())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3119
fn jet_data_plot_datum_value(datum: &JetDataPlotDatum, field: &JetDataPlotField) -> (&JetDataPlotValue)? {
    datum.values.iter().find(fn((id, _)) { id == &field.id }).map(fn((_, value)) { value })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3130
fn jet_data_plot_datum_value_mut(datum: &JetDataPlotDatum, field: &JetDataPlotField) -> (&JetDataPlotValue)? {
    datum.values.iter_mut().find(fn((id, _)) { id == &field.id }).map(fn((_, value)) { value })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3141
fn jet_data_plot_numeric_type(type_name: String) -> Bool {
    lower := type_name.trim().to_ascii_lowercase()
    lower := lower.strip_prefix("option<").and_then(fn(value) { value.strip_suffix(">") }).unwrap_or(&lower)
    lower.contains("int") || lower.contains("float") || lower.contains("number") ||
        lower.contains("decimal") || lower == "f64" || lower == "f32"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3155
fn jet_data_plot_value_matches_type(value: &JetDataPlotValue, type_name: String) -> Bool {
    if .Null :: value -> return true
    lower := type_name.trim().to_ascii_lowercase()
    lower := lower.strip_prefix("option<").and_then(fn(value) { value.strip_suffix(">") }).unwrap_or(&lower)
    match value {
        .Text(_) -> lower.contains("str") || lower.contains("string") || lower.contains("text")
        .Integer(_) -> lower.contains("int") || lower.contains("uint") || lower == "i64" || lower == "u64" || lower == "usize"
        .Number(_) -> jet_data_plot_numeric_type(lower)
        .Boolean(_) -> lower.contains("bool")
        .Null -> true
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3180
fn jet_data_plot_filter_value_matches_type(value: &JetDataPlotValue, type_name: String) -> Bool {
    match value {
        .Integer(_) | .Number(_) -> {
            if jet_data_plot_numeric_type(type_name) -> true
            else -> jet_data_plot_value_matches_type(value, type_name)
        }
        _ -> jet_data_plot_value_matches_type(value, type_name)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3194
fn jet_data_plot_compare_values(left: &JetDataPlotValue, right: &JetDataPlotValue) -> Ordering {
    match (left.number(), right.number()) {
        (Val(left), Val(right)) -> left.partial_cmp(&right).unwrap_or(.Equal)
        _ -> left.canonical_key().cmp(&right.canonical_key())
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3206
fn jet_data_plot_filter_matches(value: (&JetDataPlotValue)?, op: JetDataPlotFilterOp, expected: &JetDataPlotValue) -> Bool {
    if Val(value) :: value {
        ordering :: jet_data_plot_compare_values(value, expected)
        return match op {
            .Equal -> ordering == .Equal
            .NotEqual -> ordering != .Equal
            .Less -> ordering == .Less
            .LessEqual -> ordering != .Greater
            .Greater -> ordering == .Greater
            .GreaterEqual -> ordering != .Less
        }
    }
    false
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3225
fn jet_data_plot_check_output_limit(rows: [JetDataPlotDatum], limits: &DataLimits, operation: String) -> JetDataPlotError! {
    actual :: I64.try_from(rows.len()).unwrap_or(I64.MAX)
    if actual > limits.max_output_rows {
        error := JetDataPlotError.invalid(operation, "plot output row limit {limits.max_output_rows} exceeded")
            .with_expected(limits.max_output_rows.to_string()).with_actual(actual.to_string())
        error.kind = .Limit
        return Err(^error)
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3245
fn jet_data_plot_apply_transforms(rows: &[JetDataPlotDatum], transforms: [JetDataPlotTransform], limits: &DataLimits) -> JetDataPlotError! {
    loop transform in transforms {
        match transform {
            .Filter{field, op, value} -> {
                &rows.retain(fn(row) { jet_data_plot_filter_matches(jet_data_plot_datum_value(row, field), op, value) })
            }
            .Sort{field, descending} -> {
                actual :: I64.try_from(rows.len()).unwrap_or(I64.MAX)
                if actual > limits.max_sort_rows {
                    error := JetDataPlotError.invalid("plot.sort", "plot sort row limit {limits.max_sort_rows} exceeded")
                        .with_expected(limits.max_sort_rows.to_string()).with_actual(actual.to_string())
                    error.kind = .Limit
                    return Err(^error)
                }
                &rows.sort_by(fn(left, right) {
                    left_value :: jet_data_plot_datum_value(left, field).cloned().unwrap_or(.Null)
                    right_value :: jet_data_plot_datum_value(right, field).cloned().unwrap_or(.Null)
                    ordering :: jet_data_plot_compare_values(&left_value, &right_value)
                        .then_with(fn() { left.ordinal.cmp(&right.ordinal) })
                    if descending -> ordering.reverse()
                    else -> ordering
                })
            }
            .Bin{field, step} -> {
                loop row in rows.iter_mut() {
                    ordinal :: row.ordinal
                    if Val(value) :: jet_data_plot_datum_value_mut(row, field) {
                        if Val(number) :: value.number() {
                            if !number.is_finite() {
                                return Err(JetDataPlotError.non_finite("plot.transform", "bin transform received a non-finite value")
                                    .with_field(field.name.clone()).with_index(ordinal))
                            }
                            bucket :: (number / step).floor() * step
                            if !bucket.is_finite() {
                                return Err(JetDataPlotError.non_finite("plot.transform", "bin transform produced a non-finite bucket")
                                    .with_field(field.name.clone()).with_index(ordinal))
                            }
                            value = JetDataPlotValue.Number(jet_data_plot_normalize_zero(bucket))
                        }
                    }
                }
            }
            .Aggregate{group_by, field, aggregate} -> jet_data_plot_aggregate_rows(rows, group_by, field, aggregate, limits)?
        }
        jet_data_plot_check_output_limit(rows, limits, "plot.transform")?
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3329
fn jet_data_plot_aggregate_rows(rows: &[JetDataPlotDatum], group_by: [JetDataPlotField], field: &JetDataPlotField, aggregate: JetDataPlotAggregate, limits: &DataLimits) -> JetDataPlotError! {
    if aggregate == .None {
        return Err(JetDataPlotError.invalid("plot.aggregate", "aggregate operation must be concrete").with_field(field.name.clone()))
    }
    groups := BTreeMap<String, (JetDataPlotDatum, I64, F64, F64?, F64?)>.new()
    loop row in rows.drain(..) {
        key :: group_by.iter().map(fn(group_field) {
            jet_data_plot_datum_value(&row, group_field).map(fn(v) { v.canonical_key() }).unwrap_or_else(fn() { "null" })
        }).collect<[String]>().join("|")
        value :: jet_data_plot_datum_value(&row, field).and_then(fn(v) { v.number() })
        is_new_group :: !groups.contains_key(&key)
        if is_new_group && I64.try_from(groups.len()).unwrap_or(I64.MAX) >= limits.max_groups {
            error := JetDataPlotError.invalid("plot.aggregate", "plot group limit {limits.max_groups} exceeded")
                .with_expected(limits.max_groups.to_string()).with_actual(groups.len().to_string())
            error.kind = .Limit
            return Err(^error)
        }
        entry := groups.entry(^key).or_insert_with(fn() { (row.clone(), 0, 0.0, None, None) })
        entry.1 = entry.1.saturating_add(1)
        if Val(value) :: value {
            if !value.is_finite() {
                return Err(JetDataPlotError.non_finite("plot.aggregate", "aggregate received a non-finite value")
                    .with_field(field.name.clone()).with_index(entry.0.ordinal))
            }
            entry.2 += value
            entry.3 = Val(entry.3.map_or(value, fn(current) { current.min(value) }))
            entry.4 = Val(entry.4.map_or(value, fn(current) { current.max(value) }))
        }
    }
    if I64.try_from(groups.len()).unwrap_or(I64.MAX) > limits.max_output_rows {
        error := JetDataPlotError.invalid("plot.aggregate", "plot output row limit {limits.max_output_rows} exceeded")
            .with_expected(limits.max_output_rows.to_string()).with_actual(groups.len().to_string())
        error.kind = .Limit
        return Err(^error)
    }
    aggregated := [JetDataPlotDatum].with_capacity(groups.len())
    // BTreeMap iteration retains the Rust lexical group-key order.
    loop (_, (row, count, sum, minimum, maximum)) in groups {
        value :: match aggregate {
            .Count -> JetDataPlotValue.Integer(count)
            .Sum -> minimum.map(fn(_) { JetDataPlotValue.Number(jet_data_plot_normalize_zero(sum)) }).unwrap_or(.Null)
            .Mean -> minimum.map(fn(_) { JetDataPlotValue.Number(jet_data_plot_normalize_zero(sum / count as F64)) }).unwrap_or(.Null)
            .Min -> minimum.map(fn(v) { JetDataPlotValue.Number(jet_data_plot_normalize_zero(v)) }).unwrap_or(.Null)
            .Max -> maximum.map(fn(v) { JetDataPlotValue.Number(jet_data_plot_normalize_zero(v)) }).unwrap_or(.Null)
            .None -> panic("validated above")
        }
        if Val(existing) :: jet_data_plot_datum_value_mut(&row, field) { existing = ^value }
        else { &row.values.push((field.id.clone(), ^value)) }
        &aggregated.push(^row)
    }
    rows = ^aggregated
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3433
fn jet_data_plot_apply_encoding_aggregates(rows: &[JetDataPlotDatum], plan: &JetDataPlotPlan, encodings: [JetDataPlotEncoding], limits: &DataLimits) -> JetDataPlotError! {
    loop encoding in encodings {
        if encoding.aggregate == .None -> continue
        group_by :: encodings.iter().filter(fn(candidate) {
            candidate.channel != encoding.channel && candidate.aggregate == .None
        }).map(fn(candidate) { candidate.field.clone() }).collect<[JetDataPlotField]>()
        jet_data_plot_aggregate_rows(rows, &group_by, &encoding.field, encoding.aggregate, limits)?
        jet_data_plot_check_output_limit(rows, limits, "plot.aggregate")?
        if rows.is_empty() && plan.source.rows > 0 -> break
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3466
fn jet_data_plot_effective_encodings(root: [JetDataPlotEncoding], layer: [JetDataPlotEncoding]) -> [JetDataPlotEncoding] {
    effective := root.to_vec()
    loop encoding in layer {
        if Val(existing) :: effective.iter_mut().find(fn(existing) { existing.channel == encoding.channel }) {
            existing = encoding.clone()
        } else { &effective.push(encoding.clone()) }
    }
    ^effective
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3484
fn jet_data_plot_layer_rows(source_rows: [JetDataPlotDatum], plan: &JetDataPlotPlan, layer: (&JetDataPlotLayer)?) -> [JetDataPlotDatum] JetDataPlotError! {
    if Val(layer) :: layer {
        rows := source_rows.to_vec()
        jet_data_plot_apply_transforms(&rows, &layer.transforms, &plan.limits)?
        effective :: jet_data_plot_effective_encodings(&plan.encodings, &layer.encodings)
        jet_data_plot_apply_encoding_aggregates(&rows, plan, &effective, &plan.limits)?
        jet_data_plot_check_output_limit(&rows, &plan.limits, "plot.layer")?
        return Ok(^rows)
    }
    Ok(source_rows.to_vec())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3500
fn jet_data_plot_facet_buckets(rows: [JetDataPlotDatum], facets: [JetDataPlotFacet]) -> [(String, String, [JetDataPlotDatum])] {
    if facets.is_empty() -> return [("", "", rows.to_vec())]
    row_facets :: facets.iter().filter(fn(facet) { facet.kind == .Row }).collect<[&JetDataPlotFacet]>()
    column_facets :: facets.iter().filter(fn(facet) { facet.kind == .Column }).collect<[&JetDataPlotFacet]>()
    buckets := BTreeMap<(String, String), [JetDataPlotDatum]>.new()
    loop row in rows {
        row_key :: row_facets.iter().map(fn(facet) {
            jet_data_plot_datum_value(row, &facet.field).map(fn(v) { v.display_text() }).unwrap_or_else(fn() { "null" })
        }).collect<[String]>().join(" / ")
        column_key :: column_facets.iter().map(fn(facet) {
            jet_data_plot_datum_value(row, &facet.field).map(fn(v) { v.display_text() }).unwrap_or_else(fn() { "null" })
        }).collect<[String]>().join(" / ")
        &buckets.entry((^row_key, ^column_key)).or_default().push(row.clone())
    }
    buckets.into_iter().map(fn(((row_key, column_key), rows)) { (^row_key, ^column_key, ^rows) }).collect<[(String, String, [JetDataPlotDatum])]>()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3546
fn jet_data_plot_render_text(plan: &JetDataPlotPlan, rows: [JetDataPlotDatum], capabilities: [JetDataPlotCapability]) -> String JetDataPlotError! {
    out := plan.inspect_text()?
    &out.push_str("\ncapabilities=[")
    &out.push_str(capabilities.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(","))
    &out.push_str("]")
    layers := [(&JetDataPlotLayer)?]{None}
    if !plan.layers.is_empty() -> loop layer in &plan.layers -> &layers.push(Val(layer))
    fields :: jet_data_plot_required_fields(plan)
    loop (layer_index, layer) in layers.into_iter().enumerate() {
        layer_rows :: jet_data_plot_layer_rows(rows, plan, layer)?
        encodings :: layer.map(fn(layer) { jet_data_plot_effective_encodings(&plan.encodings, &layer.encodings) })
            .unwrap_or_else(fn() { plan.encodings.clone() })
        mark :: layer.map_or(plan.mark, fn(layer) { layer.mark })
        name :: layer.map_or("base", fn(layer) { layer.name.as_str() })
        opacity :: jet_data_plot_number(layer.map_or(1.0, fn(layer) { layer.opacity }))
        &out.push_str("\nlayer={layer_index} name={name} mark={mark.as_str()} opacity={opacity}")
        &out.push_str(" encodings=[")
        &out.push_str(encodings.iter().map(fn(v) { v.canonical_key() }).collect<[String]>().join(","))
        &out.push_str("]")
        loop (row_key, column_key, bucket) in jet_data_plot_facet_buckets(&layer_rows, &plan.facets) {
            &out.push_str("\nfacet[row={jet_data_plot_escape(&row_key)},column={jet_data_plot_escape(&column_key)}] rows=[")
            loop (position, row) in bucket.iter().enumerate() {
                if position > 0 -> &out.push_str(",")
                values :: fields.iter().filter_map(fn(field) {
                    jet_data_plot_datum_value(row, field).map(fn(value) {
                        "{jet_data_plot_escape(&field.name)}={jet_data_plot_escape(&value.display_text())}"
                    })
                }).collect<[String]>().join(",")
                &out.push_str("{row.ordinal}:")
                &out.push_str("{")
                &out.push_str(values)
                &out.push_str("}")
            }
            &out.push_str("]")
        }
    }
    Ok(^out)
}

