    }
}
impl<T> JetDataPlotColumn<T> {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:2230
    pub fn new(field: JetDataPlotField, accessor: fn(&T) -> JetDataPlotValue) -> Self {
        // GATE #4565: kernel primitive
        #Unsafe("allocate one shared typed plot accessor whose capture lifetime covers all retained rows") {
