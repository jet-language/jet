    pub fn canonical_key(self: &Self) -> String {
        keys :: self.nodes.iter().map(fn(node) { node.canonical_key() }).collect()
        "version={JET_LAZY_TABLE_PLAN_SCHEMA_VERSION};plan={jet_table_escape(self.id.as_str())};source={self.source.canonical_key()};output={self.output.index()};nodes=[{keys.join("|")}]"
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:2194
    pub fn inspect(self: &Self) -> JetTablePlanInspection JetTablePlanError! {
        self.validate()?
        Ok(JetTablePlanInspection{plan_id: self.id.clone(), source: self.source.clone(), output: self.output, nodes: self.nodes.clone()})
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:2204
    pub fn inspect_text(self: &Self) -> String JetTablePlanError! { Ok(self.inspect()?.to_text()) }
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:2208
    pub fn inspect_json(self: &Self) -> String JetTablePlanError! { Ok(self.inspect()?.to_json()) }
}
// Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:2218
// Owned deterministic projection preserves node order and typed identities.
#Clone
#Debug
#Equatable
pub struct JetTablePlanInspection { pub plan_id: JetTablePlanId, pub source: JetTableSource, pub output: JetTableNodeId, pub nodes: [JetTableNode] }
impl JetTablePlanInspection {
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:2226
    pub fn canonical_key(self: &Self) -> String {
        keys :: self.nodes.iter().map(fn(node) { node.canonical_key() }).collect()
        "version={JET_LAZY_TABLE_PLAN_SCHEMA_VERSION};plan={jet_table_escape(self.plan_id.as_str())};source={self.source.canonical_key()};output={self.output.index()};nodes=[{keys.join("|")}]"
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:2241
    pub fn to_text(self: &Self) -> String {
        lines := [].with_capacity(self.nodes.len().saturating_add(1))
        lines.push("plan {jet_table_escape(self.plan_id.as_str())} source={self.source.canonical_key()} output={self.output.index()} version={JET_LAZY_TABLE_PLAN_SCHEMA_VERSION}")
        lines.extend(self.nodes.iter().map(fn(node) { node.text() }))
        lines.join("\n")
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:2254
    pub fn to_json(self: &Self) -> String {
        nodes :: self.nodes.iter().map(fn(node) { node.json() }).collect()
        "{{\"version\":{JET_LAZY_TABLE_PLAN_SCHEMA_VERSION},\"plan_id\":{jet_table_json_string(self.plan_id.as_str())},\"source\":{jet_table_json_string(self.source.canonical_key())},\"output\":{self.output.index()},\"nodes\":[{nodes.join(",")}]}}"
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/LazyTablePlan.rs:2270
fn jet_table_detect_cycle(nodes: &[JetTableNode]) -> () JetTablePlanError! {
    colors := [].with_capacity(nodes.len())
    colors.resize(nodes.len(), 0 as U8)
    for start in 0..nodes.len() {
        if colors[start] != 0 { continue }
        colors[start] = 1
        stack := [(start, 0 as Usize)]
        loop {
            if stack.is_empty() { break }
            top :: stack.len() - 1
            node :: stack[top].0
            next_input :: stack[top].1
            if next_input >= nodes[node].inputs.len() { colors[node] = 2; _ :: stack.pop(); continue }
            input :: nodes[node].inputs[next_input]
            stack[top].1 += 1
            input_index :: input.index()
            if input_index >= nodes.len() { continue }
            match colors[input_index] {
                0 -> { colors[input_index] = 1; stack.push((input_index, 0)) },
                1 -> return Err(JetTablePlanError.Cycle(input)),
                _ -> {},
            }
        }
    }
    Ok(())
}
