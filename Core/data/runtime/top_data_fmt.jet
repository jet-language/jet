use core.prelude.runtime.std_common_types.DataPivotCell
use core.encoding.runtime.std_data_tree.[DataTree, FieldError, datatree_get, render_datatree_json,
    EncodingError, EncodingErrorKind, EncodingFormat]
use core.encoding.runtime.top_encoding_traits.[__jet_Encode, __jet_Decode]
use core.encoding.runtime.std_toml as toml
use core.encoding.runtime.std_yaml as yaml
use core.encoding.runtime.top_ring_csv_log_time_crypto.jet_ring_csv_render
use core.data.runtime.top_data_query.jet_data_query_indices
use core.mem.runtime.portable_core.jet_panic

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFmt.rs:1
fn jet_data_pivot_sum<T: Clone>(rows: &[T], row_key: fn(T) -> String,
    col_key: fn(T) -> String, value: fn(T) -> F64) -> [DataPivotCell] {
    // GATE #4499: composite keys use exact tuple/text equality, never concatenated keys.
    groups := [(String, String):(I64, F64)]{}
    for row in rows.iter().cloned() {
        key :: (row_key(row.clone()), col_key(row.clone()))
        entry :: groups.entry(^key).or_insert((I64{0}, F64{0.0}))
        entry.0 += 1
        entry.1 += value(^row)
    }
    // BTreeMap order: sort consumed keys once, without cloning rows or keys.
    ordered := groups.into_iter().collect<[((String, String), (I64, F64))]>()
    ordered.sort_by(fn(left, right) { left.0.cmp(&right.0) })
    ordered.into_iter().map(fn(((row_key, column_key), (count, sum))) {
        DataPivotCell { row_key: ^row_key, column_key: ^column_key, count, sum,
            mean: if count == 0 { F64{0.0} } else { sum / count as F64 } }
    }).collect()
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFmt.rs:33
// Typed CSV records take field order from the first Object; arrays already carry their header.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFmt.rs:36
fn jet_enc_csv_to_string<T: __jet_Encode>(values: &[T]) -> String {
    trees :: values.iter().map(fn(v) { v.jet_encode() }).collect<[DataTree]>()
    rows := [[String]]{}
    if trees.first() is Some(.Object(entries)) {
        header :: entries.iter().map(fn((k, _)) { k.clone() }).collect<[String]>()
        rows.push(header.clone())
        for tree in &trees {
            if not (tree is .Object(_)) ->
                jet_panic("<core.encoding.csv>", 0, "csv.to_string needs rows or records")
            record := [String].with_capacity(header.len())
            for key in &header {
                cell :: match datatree_get(tree, key) {
                    Some(.Text(s)) -> s.clone()
                    Some(.Int(n)) -> n.to_string()
                    Some(.Float(f)) -> "{f:?}"
                    Some(.Bool(b)) -> b.to_string()
                    Some(.Null), None -> ""
                    Some(other) -> render_datatree_json(other, false, 0)
                }
                record.push(^cell)
            }
            rows.push(^record)
        }
    } else {
        for tree in trees {
            cells :: match tree {
                .Array(cells) -> ^cells
                _ -> jet_panic("<core.encoding.csv>", 0, "csv.to_string needs rows or records")
            }
            rows.push(cells.iter().map(fn(cell) {
                match cell {
                    .Text(s) -> s.clone()
                    .Int(n) -> n.to_string()
                    .Float(f) -> "{f:?}"
                    .Bool(b) -> b.to_string()
                    .Null -> ""
                    other -> render_datatree_json(other, false, 0)
                }
            }).collect())
        }
    }
    jet_ring_csv_render(&rows)
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFmt.rs:91
// D-ENC-DYN1=A+: one rich tree owns nested tables, arrays-of-tables, dotted keys and scalars.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFmt.rs:95
fn jet_std_toml_parse(text: &String) -> DataTree EncodingError! {
    toml.parse_to_tree(text).map_err(fn(e) {
        EncodingError.new(.TOML, .Syntax, 0, Val(Int.from_usize(e.line)), None, "", ^e.message)
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFmt.rs:108
fn jet_std_toml_render(d: DataTree) -> String { toml.render(d) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFmt.rs:112
fn jet_enc_toml_decode<T: __jet_Decode>(text: &String) -> T [FieldError]! {
    tree :: toml.parse_to_tree(text).map_err(fn(e) {
        FieldError.one("invalid TOML (line {e.line}): {e.message}")
    })?
    // D-MIGRATE4: plain decode walks the migration chain silently.
    T.jet_decode(tree)
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFmt.rs:120
// D-ENC-YAML1: rich tree block/flow collections, typed scalars, documents and aliases.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFmt.rs:124
fn jet_std_yaml_parse(text: &String) -> DataTree EncodingError! {
    yaml.parse_to_tree(text).map_err(fn(e) {
        EncodingError.new(.YAML, .Syntax, 0, Val(Int.from_usize(e.line)), None, "", ^e.message)
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFmt.rs:137
fn jet_std_yaml_render(d: DataTree) -> String { yaml.render(&d) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFmt.rs:141
fn jet_enc_yaml_decode<T: __jet_Decode>(text: &String) -> T [FieldError]! {
    tree :: yaml.parse_to_tree(text).map_err(fn(e) {
        FieldError.one("invalid YAML (line {e.line}): {e.message}")
    })?
    // D-MIGRATE4: plain decode walks the migration chain silently.
    T.jet_decode(tree)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFmt.rs:148
fn jet_enc_toml_to_string<T: __jet_Encode>(v: &T) -> String { toml.render(v.jet_encode()) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFmt.rs:151
fn jet_enc_yaml_to_string<T: __jet_Encode>(v: &T) -> String { yaml.render(&v.jet_encode()) }

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFmt.rs:155
// Shared SQL plan owns field comparison and selected positions on every tier.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFmt.rs:159
fn jet_data_query_rows<T: __jet_Encode + Clone>(rows: &[T], sql: &String) -> [T] [FieldError]! {
    trees :: rows.iter().map(fn(row) { row.jet_encode() }).collect<[_]>()
    selected :: jet_data_query_indices(&trees, sql)?
    Ok(selected.into_iter().map(fn(index) { rows[index].clone() }).collect())
}

