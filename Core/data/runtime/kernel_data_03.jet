//RS // ── Deferred typed Query carriers ─────────────────────────────────────────
//RS //
//RS // Query is a normal heap value in the resident tier.  Keeping the source,
//RS // operation list, logical plan, and one-shot state in the carrier avoids a
//RS // process-global side table and gives derived queries the same clone/share
//RS // behaviour as the Prelude `DataQuery`.
//RS const QUERY_CARRIER_TAG: i64 = -2963;
//RS const GROUP_CARRIER_TAG: i64 = -2964;
//RS const QUERY_KIND_ROWS: i64 = 0;
//RS const QUERY_KIND_STREAM: i64 = 1;
//RS const QUERY_KIND_COMPUTED_GROUP: i64 = 2;
//RS const QUERY_REDUCER_COUNT: i64 = 1;
//RS const QUERY_REDUCER_SUM: i64 = 2;
//RS const QUERY_REDUCER_MEAN: i64 = 3;
//RS const QUERY_OPERATION_FILTER: i64 = 1;
//RS const QUERY_OPERATION_SORT: i64 = 2;
//RS const QUERY_FIELD_TAG: i64 = 0;
//RS const QUERY_FIELD_KIND: i64 = 1;
//RS const QUERY_FIELD_SOURCE: i64 = 2;
//RS const QUERY_FIELD_OPERATIONS: i64 = 3;
//RS const QUERY_FIELD_PLAN: i64 = 4;
//RS const QUERY_FIELD_STATE: i64 = 5;
//RS const QUERY_FIELD_GROUP: i64 = 6;
//RS const QUERY_FIELD_REDUCER: i64 = 7;
