// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3973
fn jet_data_plot_layer_json(layer: &JetDataPlotLayer) -> String {
    encodings :: layer.encodings.iter().map(jet_data_plot_encoding_json).collect<[String]>().join(",")
    transforms :: layer.transforms.iter().map(jet_data_plot_transform_json).collect<[String]>().join(",")
    "{{\"name\":\"{jet_data_plot_json_escape(&layer.name)}\",\"mark\":\"{layer.mark.as_str()}\",\"opacity\":{jet_data_plot_number(layer.opacity)},\"encodings\":[{encodings}],\"transforms\":[{transforms}]}}"
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3994
fn jet_data_plot_render_svg(plan: &JetDataPlotPlan, rows: [JetDataPlotDatum], capabilities: [JetDataPlotCapability], selection: [USize]) -> String JetDataPlotError! {
    layout :: &plan.layout
    buckets :: jet_data_plot_facet_buckets(rows, &plan.facets)
    bucket_count :: buckets.len().max(1)
    configured_columns :: plan.facets.iter().map(fn(facet) { facet.columns }).find(fn(columns) { *columns > 0 }).map(fn(columns) { columns as USize })
    configured_rows :: plan.facets.iter().map(fn(facet) { facet.rows }).find(fn(rows) { *rows > 0 }).map(fn(rows) { rows as USize })
    requested_columns :: configured_columns.unwrap_or_else(fn() { (bucket_count as F64).sqrt().ceil() as USize })
    rows_count :: configured_rows.unwrap_or_else(fn() { bucket_count.div_ceil(requested_columns.max(1)) }).clamp(1, bucket_count)
    columns :: requested_columns.max(bucket_count.div_ceil(rows_count)).clamp(1, bucket_count)
    chart_width :: layout.width - layout.margin_left - layout.margin_right
    chart_height :: layout.height - layout.margin_top - layout.margin_bottom
    cell_width :: chart_width / (columns as F64)
    cell_height :: chart_height / (rows_count as F64)
    label :: if plan.accessibility.title.is_empty() { "Jet data plot" } else { plan.accessibility.title.as_str() }
    interaction_contract :: plan.interactions.iter().map(fn(interaction) { interaction.as_str() }).collect<[String]>().join(",")
    capability_contract :: capabilities.iter().map(JetDataPlotCapability.canonical_key).collect<[String]>().join(",")
    selected_contract :: selection.iter().map(fn(index) { index.to_string() }).collect<[String]>().join(",")
    out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{jet_data_plot_number(layout.width)}\" height=\"{jet_data_plot_number(layout.height)}\" viewBox=\"0 0 {jet_data_plot_number(layout.width)} {jet_data_plot_number(layout.height)}\" role=\"img\" aria-label=\"{jet_data_plot_svg_escape(label)}\">"
    if !plan.accessibility.title.is_empty() { out.push_str("<title>{jet_data_plot_svg_escape(&plan.accessibility.title)}</title>") }
    if !plan.accessibility.description.is_empty() { out.push_str("<desc>{jet_data_plot_svg_escape(&plan.accessibility.description)}</desc>") }
    out.push_str("<metadata>")
    out.push_str(jet_data_plot_svg_escape(&jet_data_plot_plan_json(plan)))
    out.push_str("</metadata>")
    out.push_str("<g data-source=\"{jet_data_plot_svg_escape(&plan.source.source_identity)}\" data-table-plan=\"{jet_data_plot_svg_escape(&plan.source.table_plan_identity)}\" data-data-identity=\"{jet_data_plot_svg_escape(&plan.source.data_identity)}\" data-interactions=\"{jet_data_plot_svg_escape(&interaction_contract)}\" data-capabilities=\"{jet_data_plot_svg_escape(&capability_contract)}\" data-selection=\"{jet_data_plot_svg_escape(&selected_contract)}\">")
    if !plan.accessibility.summary.is_empty() {
        out.push_str("<text class=\"plot-summary\" x=\"{jet_data_plot_number(layout.margin_left)}\" y=\"{jet_data_plot_number(layout.margin_top - 20.0)}\">{jet_data_plot_svg_escape(&plan.accessibility.summary)}</text>")
    }
    layer_count :: plan.layers.len() + 1
    facet_index := 0
    while facet_index < bucket_count {
        // Only facet labels are borrowed here; the unused bucket row vector
        // is never cloned just to extract those labels.
        facet_row :: buckets.get(facet_index).map(fn(bucket) { bucket.0.as_str() }).unwrap_or("")
        facet_column :: buckets.get(facet_index).map(fn(bucket) { bucket.1.as_str() }).unwrap_or("")
        column :: facet_index % columns
        row :: facet_index /% columns
        left :: layout.margin_left + (column as F64) * cell_width
        top :: layout.margin_top + (row as F64) * cell_height
        area_left :: left + 8.0
        area_top :: top + 8.0
        area_width :: (cell_width - 16.0).max(1.0)
        area_height :: (cell_height - 16.0).max(1.0)
        if !facet_row.is_empty() || !facet_column.is_empty() {
            caption :: "{facet_row} {facet_column}"
            out.push_str("<text class=\"facet\" x=\"{jet_data_plot_number(area_left)}\" y=\"{jet_data_plot_number(area_top + 2.0)}\">{jet_data_plot_svg_escape(&caption)}</text>")
        }
        layer_index := 0
        while layer_index < layer_count {
            layer :: if layer_index == 0 { None } else { plan.layers.get(layer_index - 1) }
            effective :: layer.map(fn(layer) { jet_data_plot_effective_encodings(&plan.encodings, &layer.encodings) }).unwrap_or_else(fn() { plan.encodings.clone() })
            layer_rows :: if Val(layer) :: layer { jet_data_plot_layer_rows(rows, plan, Val(layer))? } else { rows.to_vec() }
            layer_rows :: if plan.facets.is_empty() { ^layer_rows } else {
                jet_data_plot_facet_buckets(layer_rows, &plan.facets).into_iter()
                    .find(fn(bucket) { bucket.0 == facet_row && bucket.1 == facet_column })
                    .map(fn(bucket) { ^bucket.2 }).unwrap_or_default()
            }
            mark :: layer.map_or(plan.mark, fn(layer) { layer.mark })
            opacity :: layer.map_or(1.0, fn(layer) { layer.opacity })
            out.push_str("<g class=\"plot-layer\" data-layer=\"{layer_index}\" data-mark=\"{mark.as_str()}\" opacity=\"{jet_data_plot_number(opacity)}\">")
            jet_data_plot_svg_draw_axes(&out, plan, effective, layer_rows, area_left, area_top, area_width, area_height)?
            jet_data_plot_svg_draw_marks(&out, plan, effective, layer_rows, mark, area_left, area_top, area_width, area_height)?
            out.push_str("</g>")
            layer_index += 1
        }
        facet_index += 1
    }
    jet_data_plot_svg_draw_legends(&out, plan, rows)?
    out.push_str("</g></svg>")
    Ok(^out)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:4178
fn jet_data_plot_svg_draw_legends(out: &String, plan: &JetDataPlotPlan, rows: [JetDataPlotDatum]) -> () JetDataPlotError! {
    top_x := plan.layout.margin_left
    bottom_x := plan.layout.margin_left
    right_y := plan.layout.margin_top
    left_y := plan.layout.margin_top
    loop legend in plan.legends {
        if !legend.visible -> continue
        encoding :: jet_data_plot_channel_encoding(plan.encodings, legend.channel) ?? continue
        categories :: jet_data_plot_categories(rows, &encoding.field, None)
        (x, y, vertical) :: match legend.position {
            .Top -> {
                position :: (top_x, (plan.layout.margin_top - 6.0).max(12.0), false)
                top_x += (legend.title.len() as F64 * 7.0).max(24.0) + 10.0
                position
            }
            .Bottom -> {
                position :: (bottom_x, (plan.layout.height - plan.layout.margin_bottom + 20.0).min(plan.layout.height - 4.0), false)
                bottom_x += (legend.title.len() as F64 * 7.0).max(24.0) + 10.0
                position
            }
            .Right -> {
                position :: ((plan.layout.width - plan.layout.margin_right + 8.0).min(plan.layout.width - 8.0), right_y, true)
                right_y += 20.0
                position
            }
            .Left -> {
                position :: ((plan.layout.margin_left - 120.0).max(8.0), left_y, true)
                left_y += 20.0
                position
            }
        }
        out.push_str("<g class=\"legend\" data-channel=\"{legend.channel.as_str()}\" data-position=\"{legend.position.as_str()}\"><text x=\"{jet_data_plot_number(x)}\" y=\"{jet_data_plot_number(y)}\">{jet_data_plot_svg_escape(&legend.title)}</text>")
        if vertical {
            category_y := y + 10.0
            loop category in categories {
                key :: JetDataPlotValue.Text(category.clone()).canonical_key()
                out.push_str("<rect x=\"{jet_data_plot_number(x)}\" y=\"{jet_data_plot_number(category_y)}\" width=\"8\" height=\"8\" fill=\"{jet_data_plot_palette_color(&key)}\"/><text x=\"{jet_data_plot_number(x + 12.0)}\" y=\"{jet_data_plot_number(category_y + 8.0)}\">{jet_data_plot_svg_escape(&category)}</text>")
                category_y += 20.0
            }
        } else {
            category_x := x + (legend.title.len() as F64 * 7.0).max(24.0) + 10.0
            loop category in categories {
                key :: JetDataPlotValue.Text(category.clone()).canonical_key()
                out.push_str("<rect x=\"{jet_data_plot_number(category_x)}\" y=\"{jet_data_plot_number(y - 8.0)}\" width=\"8\" height=\"8\" fill=\"{jet_data_plot_palette_color(&key)}\"/><text x=\"{jet_data_plot_number(category_x + 12.0)}\" y=\"{jet_data_plot_number(y)}\">{jet_data_plot_svg_escape(&category)}</text>")
                category_x += (category.len() as F64 * 7.0).max(24.0) + 22.0
            }
        }
        out.push_str("</g>")
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:4276
fn jet_data_plot_channel_encoding(encodings: [JetDataPlotEncoding], channel: JetDataPlotChannel) -> &JetDataPlotEncoding? from encodings {
    encodings.iter().find(fn(encoding) { encoding.channel == channel })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:4283
fn jet_data_plot_channel_scale(plan: &JetDataPlotPlan, channel: JetDataPlotChannel) -> &JetDataPlotScale? from plan {
    plan.scales.iter().find(fn(scale) { scale.channel == channel })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:4292
fn jet_data_plot_channel_axis(plan: &JetDataPlotPlan, channel: JetDataPlotChannel) -> &JetDataPlotAxis? from plan {
    plan.axes.iter().find(fn(axis) { axis.channel == channel })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:4301
fn jet_data_plot_numeric_bounds(rows: [JetDataPlotDatum], field: &JetDataPlotField, scale: &JetDataPlotScale?) -> (F64, F64) JetDataPlotError! {
    if Val(scale) :: scale {
        if .Numeric(min, max) :: scale.domain {
            if scale.kind == JetDataPlotScaleKind.Log {
                loop row in rows {
                    value :: jet_data_plot_datum_value(row, field).and_then(JetDataPlotValue.number) ?? continue
                    if !value.is_finite() || value <= 0.0 {
                        return Err(JetDataPlotError.invalid("plot.scale", "log plot scale needs strictly positive finite data").with_field(field.name.clone()).with_index(row.ordinal))
                    }
                }
            }
            return Ok((min, max))
        }
    }
    minimum := F64.INFINITY
    maximum := F64.NEG_INFINITY
    loop row in rows {
        value :: jet_data_plot_datum_value(row, field).and_then(JetDataPlotValue.number) ?? continue
        if !value.is_finite() {
            return Err(JetDataPlotError.non_finite("plot.scale", "plot scale received a non-finite value").with_field(field.name.clone()).with_index(row.ordinal))
        }
        if scale.is_some_and(fn(scale) { scale.kind == JetDataPlotScaleKind.Log }) && value <= 0.0 {
            return Err(JetDataPlotError.invalid("plot.scale", "log plot scale needs strictly positive data").with_field(field.name.clone()).with_index(row.ordinal))
        }
        minimum = minimum.min(value)
        maximum = maximum.max(value)
    }
    if !minimum.is_finite() || !maximum.is_finite() -> return Ok((0.0, 1.0))
    if minimum == maximum {
        padding :: minimum.abs().max(1.0) * 0.5
        minimum -= padding
        maximum += padding
    }
    Ok((minimum, maximum))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:4368
fn jet_data_plot_categories(rows: [JetDataPlotDatum], field: &JetDataPlotField, scale: &JetDataPlotScale?) -> [String] {
    if Val(scale) :: scale {
        if .Categories(values) :: scale.domain -> return values.clone()
    }
    categories := [String:Bool]{}
    loop row in rows {
        if Val(value) :: jet_data_plot_datum_value(row, field) { categories.insert(value.display_text(), true) }
    }
    keys := categories.keys().cloned().collect<[String]>()
    keys.sort()
    ^keys
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:4389
fn jet_data_plot_svg_x(value: &JetDataPlotValue, scale: &JetDataPlotScale?, categories: [String], minimum: F64, maximum: F64, left: F64, width: F64) -> F64 {
    numeric :: scale.map(fn(scale) { scale.kind.needs_numeric() }).unwrap_or_else(fn() { value.number().is_some() })
    reverse :: scale.map(fn(scale) { scale.reverse }).unwrap_or(false)
    if numeric {
        ratio := value.number().unwrap_or(minimum)
        if scale.is_some_and(fn(scale) { scale.kind == JetDataPlotScaleKind.Log }) {
            ratio = ratio.max(F64.MIN_POSITIVE).ln()
            min_log :: minimum.max(F64.MIN_POSITIVE).ln()
            max_log :: maximum.max(F64.MIN_POSITIVE).ln()
            ratio = (ratio - min_log) / (max_log - min_log).max(F64.EPSILON)
        } else {
            ratio = (ratio - minimum) / (maximum - minimum).max(F64.EPSILON)
        }
        ratio :: if scale.map(fn(scale) { scale.clamp }).unwrap_or(true) { ratio.clamp(0.0, 1.0) } else { ratio }
        ratio :: if reverse { 1.0 - ratio } else { ratio }
        left + ratio * width
    } else {
        key :: value.display_text()
        index :: categories.iter().position(fn(category) { category == &key }).unwrap_or(0)
        step :: width / (categories.len().max(1) as F64)
        position :: (index as F64) * step + step * 0.5
        if reverse { left + width - position } else { left + position }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:4432
fn jet_data_plot_svg_y(value: &JetDataPlotValue, scale: &JetDataPlotScale?, minimum: F64, maximum: F64, top: F64, height: F64) -> F64 {
    ratio := value.number().unwrap_or(minimum)
    if scale.is_some_and(fn(scale) { scale.kind == JetDataPlotScaleKind.Log }) {
        ratio = ratio.max(F64.MIN_POSITIVE).ln()
        min_log :: minimum.max(F64.MIN_POSITIVE).ln()
        max_log :: maximum.max(F64.MIN_POSITIVE).ln()
        ratio = (ratio - min_log) / (max_log - min_log).max(F64.EPSILON)
    } else {
        ratio = (ratio - minimum) / (maximum - minimum).max(F64.EPSILON)
    }
    ratio :: if scale.map(fn(scale) { scale.clamp }).unwrap_or(true) { ratio.clamp(0.0, 1.0) } else { ratio }
    if scale.is_some_and(fn(scale) { scale.reverse }) { top + ratio * height } else { top + (1.0 - ratio) * height }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:4460
fn jet_data_plot_svg_draw_axes(out: &String, plan: &JetDataPlotPlan, encodings: [JetDataPlotEncoding], rows: [JetDataPlotDatum], left: F64, top: F64, width: F64, height: F64) -> () JetDataPlotError! {
    x_encoding :: jet_data_plot_channel_encoding(encodings, JetDataPlotChannel.X) ?? return Err(JetDataPlotError.invalid("plot.svg", "plot mark has no x encoding"))
    y_encoding :: jet_data_plot_channel_encoding(encodings, JetDataPlotChannel.Y) ?? return Err(JetDataPlotError.invalid("plot.svg", "plot mark has no y encoding"))
    x_scale :: jet_data_plot_channel_scale(plan, JetDataPlotChannel.X)
    y_scale :: jet_data_plot_channel_scale(plan, JetDataPlotChannel.Y)
    x_categories :: jet_data_plot_categories(rows, &x_encoding.field, x_scale)
    x_numeric :: x_scale.map(fn(scale) { scale.kind.needs_numeric() }).unwrap_or_else(fn() {
        rows.iter().any(fn(row) { jet_data_plot_datum_value(row, &x_encoding.field).is_some_and(fn(value) { value.number().is_some() }) })
    })
    (x_minimum, x_maximum) :: if x_numeric { jet_data_plot_numeric_bounds(rows, &x_encoding.field, x_scale)? } else { (0.0, 1.0) }
    (y_minimum, y_maximum) :: jet_data_plot_numeric_bounds(rows, &y_encoding.field, y_scale)?
    x_axis :: jet_data_plot_channel_axis(plan, JetDataPlotChannel.X)
    y_axis :: jet_data_plot_channel_axis(plan, JetDataPlotChannel.Y)
    if y_axis.is_none_or(fn(axis) { axis.visible }) {
        out.push_str("<line class=\"axis y\" x1=\"{jet_data_plot_number(left)}\" y1=\"{jet_data_plot_number(top)}\" x2=\"{jet_data_plot_number(left)}\" y2=\"{jet_data_plot_number(top + height)}\"/>")
    }
    if x_axis.is_none_or(fn(axis) { axis.visible }) {
        out.push_str("<line class=\"axis x\" x1=\"{jet_data_plot_number(left)}\" y1=\"{jet_data_plot_number(top + height)}\" x2=\"{jet_data_plot_number(left + width)}\" y2=\"{jet_data_plot_number(top + height)}\"/>")
    }
    y_ticks :: y_axis.map_or(5, fn(axis) { axis.ticks }).clamp(0, 32) as USize
    loop tick in 0..=y_ticks {
        ratio :: if y_ticks == 0 { 0.0 } else { (tick as F64) / (y_ticks as F64) }
        value :: y_minimum + (y_maximum - y_minimum) * ratio
        position :: jet_data_plot_svg_y(&JetDataPlotValue.Number(value), y_scale, y_minimum, y_maximum, top, height)
        if y_axis.is_none_or(fn(axis) { axis.grid }) {
            out.push_str("<line class=\"grid\" x1=\"{jet_data_plot_number(left)}\" y1=\"{jet_data_plot_number(position)}\" x2=\"{jet_data_plot_number(left + width)}\" y2=\"{jet_data_plot_number(position)}\"/>")
        }
        label :: jet_data_plot_number(value)
        out.push_str("<text class=\"tick y\" x=\"{jet_data_plot_number(left - 6.0)}\" y=\"{jet_data_plot_number(position + 3.0)}\">{jet_data_plot_svg_escape(&label)}</text>")
    }
    if x_numeric {
        x_ticks :: x_axis.map_or(5, fn(axis) { axis.ticks }).clamp(0, 32) as USize
        loop tick in 0..=x_ticks {
            ratio :: if x_ticks == 0 { 0.0 } else { (tick as F64) / (x_ticks as F64) }
            value :: x_minimum + (x_maximum - x_minimum) * ratio
            position :: jet_data_plot_svg_x(&JetDataPlotValue.Number(value), x_scale, x_categories, x_minimum, x_maximum, left, width)
            label :: jet_data_plot_number(value)
            out.push_str("<text class=\"tick x\" x=\"{jet_data_plot_number(position)}\" y=\"{jet_data_plot_number(top + height + 18.0)}\">{jet_data_plot_svg_escape(&label)}</text>")
        }
    } else if !x_categories.is_empty() {
        loop category in x_categories {
            position :: jet_data_plot_svg_x(&JetDataPlotValue.Text(category.clone()), x_scale, x_categories, x_minimum, x_maximum, left, width)
            out.push_str("<text class=\"tick x\" x=\"{jet_data_plot_number(position)}\" y=\"{jet_data_plot_number(top + height + 18.0)}\">{jet_data_plot_svg_escape(&category)}</text>")
        }
    }
    if Val(axis) :: x_axis {
        if !axis.title.is_empty() {
            out.push_str("<text class=\"axis-title x\" x=\"{jet_data_plot_number(left + width * 0.5)}\" y=\"{jet_data_plot_number(top + height + 38.0)}\">{jet_data_plot_svg_escape(&axis.title)}</text>")
        }
    }
    if Val(axis) :: y_axis {
        if !axis.title.is_empty() {
            out.push_str("<text class=\"axis-title y\" x=\"{jet_data_plot_number(left - 46.0)}\" y=\"{jet_data_plot_number(top + height * 0.5)}\" transform=\"rotate(-90 {jet_data_plot_number(left - 46.0)} {jet_data_plot_number(top + height * 0.5)})\">{jet_data_plot_svg_escape(&axis.title)}</text>")
        }
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:4613
fn jet_data_plot_svg_draw_marks(out: &String, plan: &JetDataPlotPlan, encodings: [JetDataPlotEncoding], rows: [JetDataPlotDatum], mark: JetDataPlotMark, left: F64, top: F64, width: F64, height: F64) -> () JetDataPlotError! {
    x_encoding :: jet_data_plot_channel_encoding(encodings, JetDataPlotChannel.X) ?? return Err(JetDataPlotError.invalid("plot.svg", "plot mark has no x encoding"))
    y_encoding :: jet_data_plot_channel_encoding(encodings, JetDataPlotChannel.Y) ?? return Err(JetDataPlotError.invalid("plot.svg", "plot mark has no y encoding"))
    x_scale :: jet_data_plot_channel_scale(plan, JetDataPlotChannel.X)
    y_scale :: jet_data_plot_channel_scale(plan, JetDataPlotChannel.Y)
    categories :: jet_data_plot_categories(rows, &x_encoding.field, x_scale)
    x_numeric :: x_scale.map(fn(scale) { scale.kind.needs_numeric() }).unwrap_or_else(fn() {
        rows.iter().any(fn(row) { jet_data_plot_datum_value(row, &x_encoding.field).is_some_and(fn(value) { value.number().is_some() }) })
    })
    (x_minimum, x_maximum) :: if x_numeric { jet_data_plot_numeric_bounds(rows, &x_encoding.field, x_scale)? } else { (0.0, 1.0) }
    (y_minimum, y_maximum) :: jet_data_plot_numeric_bounds(rows, &y_encoding.field, y_scale)?
    color_encoding :: jet_data_plot_channel_encoding(encodings, JetDataPlotChannel.Color)
    size_encoding :: jet_data_plot_channel_encoding(encodings, JetDataPlotChannel.Size)
    text_encoding :: jet_data_plot_channel_encoding(encodings, JetDataPlotChannel.Text)
    match mark {
        .Line -> {
            paths := [String:[(F64, F64)]]{}
            loop row in rows {
                x_value :: jet_data_plot_datum_value(row, &x_encoding.field) ?? continue
                y_value :: jet_data_plot_datum_value(row, &y_encoding.field) ?? continue
                y_number :: y_value.number() ?? continue
                group :: color_encoding.and_then(fn(encoding) { jet_data_plot_datum_value(row, &encoding.field) }).map(JetDataPlotValue.canonical_key).unwrap_or_else(fn() { "default" })
                group :: if Val(encoding) :: jet_data_plot_channel_encoding(encodings, JetDataPlotChannel.Detail) {
                    detail :: jet_data_plot_datum_value(row, &encoding.field).map(JetDataPlotValue.canonical_key).unwrap_or_else(fn() { "null" })
                    "{group}|{detail}"
                } else { ^group }
                x :: jet_data_plot_svg_x(x_value, x_scale, categories, x_minimum, x_maximum, left, width)
                y :: jet_data_plot_svg_y(y_value, y_scale, y_minimum, y_maximum, top, height)
                if y_number.is_finite() { paths.entry(group).or_default().push((x, y)) }
            }
            groups := paths.keys().cloned().collect<[String]>()
            groups.sort()
            loop group in groups {
                points :: paths.get(&group) ?? panic("plot series key disappeared")
                if points.is_empty() -> continue
                text :: points.iter().map(fn(point) { "{jet_data_plot_number(point.0)} {jet_data_plot_number(point.1)}" }).collect<[String]>().join(" ")
                out.push_str("<polyline class=\"mark line\" data-series=\"{jet_data_plot_svg_escape(&group)}\" points=\"{text}\" fill=\"none\" stroke=\"{jet_data_plot_palette_color(&group)}\"/>")
            }
            if Val(encoding) :: text_encoding {
                loop row in rows {
                    x_value :: jet_data_plot_datum_value(row, &x_encoding.field) ?? continue
                    y_value :: jet_data_plot_datum_value(row, &y_encoding.field) ?? continue
                    if y_value.number().is_none() -> continue
                    x :: jet_data_plot_svg_x(x_value, x_scale, categories, x_minimum, x_maximum, left, width)
                    y :: jet_data_plot_svg_y(y_value, y_scale, y_minimum, y_maximum, top, height)
                    if Val(value) :: jet_data_plot_datum_value(row, &encoding.field) {
                        label :: value.display_text()
                        out.push_str("<text class=\"mark-label\" x=\"{jet_data_plot_number(x + 2.0)}\" y=\"{jet_data_plot_number(y - 4.0)}\">{jet_data_plot_svg_escape(&label)}</text>")
                    }
                }
            }
        }
        .Bar -> {
            count :: rows.len().max(1) as F64
            band_width :: width / count * 0.78
            baseline :: jet_data_plot_svg_y(&JetDataPlotValue.Number(0.0), y_scale, y_minimum, y_maximum, top, height)
            loop (position, row) in rows.iter().enumerate() {
                x_value :: jet_data_plot_datum_value(row, &x_encoding.field) ?? continue
                y_value :: jet_data_plot_datum_value(row, &y_encoding.field) ?? continue
                if y_value.number().is_none() -> continue
                x :: if x_numeric {
                    jet_data_plot_svg_x(x_value, x_scale, categories, x_minimum, x_maximum, left, width) - band_width * 0.5
                } else { left + (position as F64 + 0.5) * width / count - band_width * 0.5 }
                y :: jet_data_plot_svg_y(y_value, y_scale, y_minimum, y_maximum, top, height)
                top_edge :: y.min(baseline)
                bar_height :: (y - baseline).abs().max(1.0)
                color_key :: color_encoding.and_then(fn(encoding) { jet_data_plot_datum_value(row, &encoding.field) }).map(JetDataPlotValue.canonical_key).unwrap_or_else(fn() { "default" })
                out.push_str("<rect class=\"mark bar\" x=\"{jet_data_plot_number(x)}\" y=\"{jet_data_plot_number(top_edge)}\" width=\"{jet_data_plot_number(band_width)}\" height=\"{jet_data_plot_number(bar_height)}\" fill=\"{jet_data_plot_palette_color(&color_key)}\"/>")
                if Val(encoding) :: text_encoding {
                    if Val(value) :: jet_data_plot_datum_value(row, &encoding.field) {
                        label :: value.display_text()
                        out.push_str("<text class=\"mark-label\" x=\"{jet_data_plot_number(x + band_width * 0.5)}\" y=\"{jet_data_plot_number(top_edge - 4.0)}\">{jet_data_plot_svg_escape(&label)}</text>")
                    }
                }
            }
        }
        .Point -> {
            loop row in rows {
                x_value :: jet_data_plot_datum_value(row, &x_encoding.field) ?? continue
                y_value :: jet_data_plot_datum_value(row, &y_encoding.field) ?? continue
                if y_value.number().is_none() -> continue
                x :: jet_data_plot_svg_x(x_value, x_scale, categories, x_minimum, x_maximum, left, width)
                y :: jet_data_plot_svg_y(y_value, y_scale, y_minimum, y_maximum, top, height)
                radius :: size_encoding.and_then(fn(encoding) { jet_data_plot_datum_value(row, &encoding.field) }).and_then(JetDataPlotValue.number).map(fn(value) { 2.0 + value.abs().sqrt().min(7.0) }).unwrap_or(4.0)
                color_key :: color_encoding.and_then(fn(encoding) { jet_data_plot_datum_value(row, &encoding.field) }).map(JetDataPlotValue.canonical_key).unwrap_or_else(fn() { "default" })
                out.push_str("<circle class=\"mark point\" cx=\"{jet_data_plot_number(x)}\" cy=\"{jet_data_plot_number(y)}\" r=\"{jet_data_plot_number(radius)}\" fill=\"{jet_data_plot_palette_color(&color_key)}\"/>")
                if Val(encoding) :: text_encoding {
                    if Val(value) :: jet_data_plot_datum_value(row, &encoding.field) {
                        label :: value.display_text()
                        out.push_str("<text class=\"mark-label\" x=\"{jet_data_plot_number(x + radius + 2.0)}\" y=\"{jet_data_plot_number(y - radius - 2.0)}\">{jet_data_plot_svg_escape(&label)}</text>")
                    }
                }
            }
        }
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:4885
fn jet_data_plot_palette_color(key: String) -> String {
    COLORS :: [String#8]{"#2563eb", "#dc2626", "#059669", "#d97706", "#7c3aed", "#0891b2", "#db2777", "#4f46e5"}
    hash := U64{0}
    loop byte in key.bytes() { hash = hash.wrapping_mul(U64{131}).wrapping_add(U64.from_u8(byte)) }
    COLORS[(hash as USize) % COLORS.len()]
}
