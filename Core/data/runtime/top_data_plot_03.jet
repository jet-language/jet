    "{{\"channel\":\"{scale.channel.as_str()}\",\"kind\":\"{scale.kind.as_str()}\",\"domain\":{jet_data_plot_domain_json(&scale.domain)},\"clamp\":{scale.clamp},\"reverse\":{scale.reverse}}}"
}
