use core.data.runtime.top_data_plot_02.[jet_data_plot_facet_buckets, jet_data_plot_effective_encodings, jet_data_plot_layer_rows]
use core.data.runtime.top_data_plot.[JetDataPlotChannel, JetDataPlotScaleKind, JetDataPlotMark]
