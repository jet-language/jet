// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3627
fn jet_data_plot_plan_json(plan: &JetDataPlotPlan) -> String {
    out := "{"
    out.push_str("\"version\":{JET_DATA_PLOT_SCHEMA_VERSION},\"source\":{jet_data_plot_source_json(&plan.source)},\"schema\":{jet_data_plot_schema_json(&plan.schema)},\"limits\":{{\"max_groups\":{plan.limits.max_groups},\"max_sort_rows\":{plan.limits.max_sort_rows},\"max_join_rows\":{plan.limits.max_join_rows},\"max_output_rows\":{plan.limits.max_output_rows}}},\"mark\":\"{plan.mark.as_str()}\",\"encodings\":[")
    out.push_str(plan.encodings.iter().map(jet_data_plot_encoding_json).collect<[String]>().join(","))
    out.push_str("],\"transforms\":[")
    out.push_str(plan.transforms.iter().map(jet_data_plot_transform_json).collect<[String]>().join(","))
    out.push_str("],\"scales\":[")
    out.push_str(plan.scales.iter().map(jet_data_plot_scale_json).collect<[String]>().join(","))
    out.push_str("],\"axes\":[")
    out.push_str(plan.axes.iter().map(jet_data_plot_axis_json).collect<[String]>().join(","))
    out.push_str("],\"legends\":[")
    out.push_str(plan.legends.iter().map(jet_data_plot_legend_json).collect<[String]>().join(","))
    out.push_str("],\"facets\":[")
    out.push_str(plan.facets.iter().map(jet_data_plot_facet_json).collect<[String]>().join(","))
    out.push_str("],\"layers\":[")
    out.push_str(plan.layers.iter().map(jet_data_plot_layer_json).collect<[String]>().join(","))
    out.push_str("],\"interactions\":[")
    out.push_str(plan.interactions.iter().map(fn(interaction) { "\"{interaction.as_str()}\"" }).collect<[String]>().join(","))
    out.push_str("],\"accessibility\":")
    out.push_str("{{\"title\":\"{jet_data_plot_json_escape(&plan.accessibility.title)}\",\"description\":\"{jet_data_plot_json_escape(&plan.accessibility.description)}\",\"summary\":\"{jet_data_plot_json_escape(&plan.accessibility.summary)}\",\"keyboard\":{plan.accessibility.keyboard},\"announce_selection\":{plan.accessibility.announce_selection}}}")
    out.push_str(",\"layout\":{{\"width\":{jet_data_plot_number(plan.layout.width)},\"height\":{jet_data_plot_number(plan.layout.height)},\"margin_top\":{jet_data_plot_number(plan.layout.margin_top)},\"margin_right\":{jet_data_plot_number(plan.layout.margin_right)},\"margin_bottom\":{jet_data_plot_number(plan.layout.margin_bottom)},\"margin_left\":{jet_data_plot_number(plan.layout.margin_left)}}}}}")
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3731
fn jet_data_plot_json_escape(value: String) -> String {
    out := String.with_capacity(value.len())
    loop character in value.chars() {
        match character {
            '"' -> out.push_str("\\\"")
            '\\' -> out.push_str("\\\\")
            '\n' -> out.push_str("\\n")
            '\r' -> out.push_str("\\r")
            '\t' -> out.push_str("\\t")
            character if character.is_control() -> {
                code :: character as U32
                out.push_str("\\u{code:04x}")
            }
            character -> out.push(character)
        }
    }
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3749
fn jet_data_plot_escape(value: String) -> String {
    value.replace('\\', "\\\\").replace(';', "\\;").replace('|', "\\|").replace(',', "\\,").replace('=', "\\=")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3758
fn jet_data_plot_number(value: F64) -> String {
    value :: jet_data_plot_normalize_zero(value)
    if value.is_finite() { value.to_string() }
    else if value.is_nan() { "NaN" }
    else if value.is_sign_positive() { "inf" }
    else { "-inf" }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3771
fn jet_data_plot_normalize_zero(value: F64) -> F64 { if value == 0.0 { 0.0 } else { value } }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3779
fn jet_data_plot_source_json(source: &JetDataPlotSourceFacts) -> String {
    "{{\"table_plan\":\"{jet_data_plot_json_escape(&source.table_plan_identity)}\",\"source\":\"{jet_data_plot_json_escape(&source.source_identity)}\",\"schema\":\"{jet_data_plot_json_escape(&source.schema_identity)}\",\"row_type\":\"{jet_data_plot_json_escape(&source.row_type)}\",\"rows\":{source.rows},\"data_identity\":\"{jet_data_plot_json_escape(&source.data_identity)}\",\"provenance\":\"{jet_data_plot_json_escape(&source.provenance)}\"}}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3791
fn jet_data_plot_limits_key(limits: &DataLimits) -> String {
    "groups={limits.max_groups},sort={limits.max_sort_rows},join={limits.max_join_rows},output={limits.max_output_rows}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3799
fn jet_data_plot_schema_json(schema: &JetDataPlotSchema) -> String {
    columns :: schema.columns.iter().map(fn(field) {
        "{{\"id\":\"{jet_data_plot_json_escape(&field.id)}\",\"name\":\"{jet_data_plot_json_escape(&field.name)}\",\"type\":\"{jet_data_plot_json_escape(&field.type_name)}\"}}"
    }).collect<[String]>().join(",")
    "{{\"identity\":\"{jet_data_plot_json_escape(&schema.identity)}\",\"row_type\":\"{jet_data_plot_json_escape(&schema.row_type)}\",\"columns\":[{columns}]}}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3820
fn jet_data_plot_encoding_json(encoding: &JetDataPlotEncoding) -> String {
    "{{\"channel\":\"{encoding.channel.as_str()}\",\"field\":{jet_data_plot_field_json(&encoding.field)},\"aggregate\":\"{encoding.aggregate.as_str()}\"}}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3829
fn jet_data_plot_field_json(field: &JetDataPlotField) -> String {
    "{{\"id\":\"{jet_data_plot_json_escape(&field.id)}\",\"name\":\"{jet_data_plot_json_escape(&field.name)}\",\"type\":\"{jet_data_plot_json_escape(&field.type_name)}\"}}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3838
fn jet_data_plot_value_json(value: &JetDataPlotValue) -> String {
    match value {
        .Text(value) -> "{{\"kind\":\"text\",\"value\":\"{jet_data_plot_json_escape(value)}\"}}"
        .Integer(value) -> "{{\"kind\":\"integer\",\"value\":{value}}}"
        .Number(value) -> "{{\"kind\":\"number\",\"value\":{jet_data_plot_number(*value)}}}"
        .Boolean(value) -> "{{\"kind\":\"boolean\",\"value\":{value}}}"
        .Null -> "{\"kind\":\"null\",\"value\":null}"
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3857
fn jet_data_plot_values_json(values: [(JetDataPlotField, JetDataPlotValue)]) -> String {
    items :: values.iter().map(fn(pair) {
        "{{\"field\":{jet_data_plot_field_json(&pair.0)},\"value\":{jet_data_plot_value_json(&pair.1)}}}"
    }).collect<[String]>().join(",")
    "[{items}]"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3874
fn jet_data_plot_transform_json(transform: &JetDataPlotTransform) -> String {
    match transform {
        .Filter(field, op, value) -> "{{\"kind\":\"filter\",\"field\":{jet_data_plot_field_json(field)},\"op\":\"{op.as_str()}\",\"value\":{jet_data_plot_value_json(value)}}}"
        .Sort(field, descending) -> "{{\"kind\":\"sort\",\"field\":{jet_data_plot_field_json(field)},\"descending\":{descending}}}"
        .Bin(field, step) -> "{{\"kind\":\"bin\",\"field\":{jet_data_plot_field_json(field)},\"step\":{jet_data_plot_number(*step)}}}"
        .Aggregate(group_by, field, aggregate) -> {
            groups :: group_by.iter().map(jet_data_plot_field_json).collect<[String]>().join(",")
            "{{\"kind\":\"aggregate\",\"group_by\":[{groups}],\"field\":{jet_data_plot_field_json(field)},\"aggregate\":\"{aggregate.as_str()}\"}}"
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3911
fn jet_data_plot_domain_json(domain: &JetDataPlotDomain) -> String {
    match domain {
        .Auto -> "\"auto\""
        .Numeric(min, max) -> "{{\"kind\":\"numeric\",\"min\":{jet_data_plot_number(*min)},\"max\":{jet_data_plot_number(*max)}}}"
        .Categories(values) -> {
            items :: values.iter().map(fn(value) { "\"{jet_data_plot_json_escape(value)}\"" }).collect<[String]>().join(",")
            "{{\"kind\":\"categories\",\"values\":[{items}]}}"
        }
    }
}
