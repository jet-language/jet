// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3006
fn jet_data_loader_value<T: __jet_Encode>(value: &T,
    limits: &DataLimits) -> Result<DataLoader<T>, DataError> {
    content :: jet_data_loader_canonical_tree(&value.jet_encode())
    bytes :: content.into_bytes()
    jet_data_loader_check_payload(limits, bytes.len(), "data.value")?
    loader := jet_data_loader_new<T>(.Value, "value", "", [], .JSON,
        limits.clone(), jet_data_loader_authority("local", "")?)?
    loader.payload = Some(^bytes)
    Ok(^loader)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3026
fn jet_data_loader_check_payload(limits: &DataLimits, bytes: USize,
    operation: &String) -> Result<(), DataError> {
    LoaderKernel.check_payload(&jet_data_loader_kernel_limits(limits), bytes, operation)
        .map_err(jet_data_loader_kernel_error)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3039
fn jet_data_loader_quote(value: &String) -> String {
    output := String.with_capacity(value.len() + 2)
    output.push('"')
    loop character in value.chars() {
        match character {
            '"' -> output.push_str("\\\"")
            '\\' -> output.push_str("\\\\")
            '\n' -> output.push_str("\\n")
            '\r' -> output.push_str("\\r")
            '\t' -> output.push_str("\\t")
            character if character.is_control() -> output.push_str("\\u{character as U32:04x}")
            character -> output.push(character)
        }
    }
    output.push('"')
    ^output
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3059
fn jet_data_loader_canonical_tree(tree: &DataTree) -> String {
    match tree {
        .Null -> "null"
        .Bool(value) -> value.to_string()
        .Int(value) -> value.to_string()
        .Float(value) -> "{value:?}"
        .Number(value) -> value.clone()
        .TypedText(value) | .Text(value) -> jet_data_loader_quote(value)
        .Bytes(values) -> {
            body :: values.iter().map(fn(value) { value.to_string() }).collect<[String]>().join(",")
            "[{body}]"
        }
        .Array(values) -> {
            body :: values.iter().map(jet_data_loader_canonical_tree).collect<[String]>().join(",")
            "[{body}]"
        }
        .Object(entries) -> {
            entries := entries.clone()
            entries.sort_by(fn(left, right) { left.0.cmp(&right.0) })
            body :: entries.iter().map(fn(entry) {
                key :: jet_data_loader_quote(&entry.0)
                value :: jet_data_loader_canonical_tree(&entry.1)
                "{key}:{value}"
            }).collect<[String]>().join(",")
            "{{{body}}}"
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3104
fn jet_data_loader_schema(tree: &DataTree, format: DataFormat) -> DataSchema {
    schema := DataSchema.infer(tree, format)
    schema.identity = jet_data_loader_digest(schema.identity.as_bytes())
    ^schema
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3113
fn jet_data_loader_digest(bytes: &[U8]) -> String { LoaderKernel.digest(bytes) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3117
fn jet_data_loader_csv_tree(text: &String, limits: &DataLimits) -> Result<DataTree, DataError> {
    text :: text.to_string()
    rows :: jet_ring_csv_parse(&text, ",", false, false).map_err(fn(reason) {
        jet_data_loader_error(DataErrorKind.Decode, "data.loader.csv", ^reason)
    })?
    rows := rows.into_iter()
    header :: match rows.next() {
        Some(header) -> ^header
        None -> return Ok(DataTree.Array([]))
    }
    header_names: [String:Bool] := [:]
    loop name in &header {
        jet_data_loader_validate_public_text("CSV header", name, false)?
        if header_names.insert(name.clone(), true).is_some() {
            return Err(jet_data_loader_error(DataErrorKind.Decode, "data.loader.csv",
                "duplicate CSV header `{name}`"))
        }
    }
    values := []
    loop row in rows {
        if values.len() as I64 >= limits.max_output_rows {
            return Err(jet_data_loader_error(DataErrorKind.Limit, "data.loader.csv",
                "max_output_rows {limits.max_output_rows} exceeded"))
        }
        if row.len() > header.len() {
            return Err(jet_data_loader_error(DataErrorKind.Decode, "data.loader.csv",
                "CSV row has {row.len()} fields; header has {header.len()}"))
        }
        fields :: header.iter().enumerate().map(fn(entry) {
            (entry.1.clone(), row.get(entry.0).map(fn(value) { DataTree.Text(value.clone()) })
                .unwrap_or(DataTree.Null))
        }).collect()
        values.push(DataTree.Object(^fields))
    }
    Ok(DataTree.Array(^values))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3181
fn jet_data_loader_jsonl_tree(text: &String, limits: &DataLimits) -> Result<DataTree, DataError> {
    values := []
    loop (line_index, line) in text.lines().enumerate() {
        line := line.trim() // #4303
        if line.is_empty() -> continue
        if values.len() as I64 >= limits.max_output_rows {
            return Err(jet_data_loader_error(DataErrorKind.Limit, "data.loader.jsonl",
                "max_output_rows {limits.max_output_rows} exceeded"))
        }
        value :: parse_json_typed_datatree(line).map_err(fn(error) {
            reason :: match error.line {
                Ok(line) -> "invalid JSONL record at line {line_index + 1} (line {line}): {error.reason}"
                Err(_) -> "invalid JSONL record at line {line_index + 1}: {error.reason}"
            }
            jet_data_loader_error(DataErrorKind.Decode, "data.loader.jsonl", ^reason)
        })?
        values.push(^value)
    }
    Ok(DataTree.Array(^values))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3222
fn jet_data_loader_check_tree_rows(tree: &DataTree, limits: &DataLimits,
    operation: &String) -> Result<(), DataError> {
    if tree == DataTree.Array(rows) {
        if rows.len() as I64 > limits.max_output_rows {
            return Err(jet_data_loader_error(DataErrorKind.Limit, operation,
                "max_output_rows {limits.max_output_rows} exceeded"))
        }
    }
    Ok(())
}

use jet_foundation.[ArrowData, ArrowFileReader]
use core.data.[DataSchema, DataProvenance, DataSnapshotIdentity]
use core.prelude.runtime.std_common_types.[DataSnapshot]
use std.fs
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3244
// D-DATA-READER1=A: official Parquet provider ABI; Arrow IPC remains separate.
// GATE #4565: kernel primitive
#FFI(c)
fn jet_data_read(format: U8, input: *const U8, input_len: USize,
    limits: *const ArrowFileReader.ProviderLimits,
    out_schema: *mut *mut ArrowData.ArrowSchema,
    out_array: *mut *mut ArrowData.ArrowArray) -> I32
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3254
fn jet_data_arrow_limits(limits: &DataLimits) -> Result<ArrowData.ArrowLimits, DataError> {
    max_buffer_bytes :: USize.try_from(limits.encoding.max_expansion_bytes).map_err(fn(_) {
        jet_data_loader_error(DataErrorKind.Limit, "data.loader.parquet",
            "max_expansion_bytes cannot be represented by this target")
    })?
    max_total_i64 :: limits.encoding.max_total_bytes.ok().unwrap_or_else(fn() {
        limits.encoding.max_item_bytes.max(limits.encoding.max_expansion_bytes)
    })
    max_total_bytes :: USize.try_from(max_total_i64).map_err(fn(_) {
        jet_data_loader_error(DataErrorKind.Limit, "data.loader.parquet",
            "max_total_bytes cannot be represented by this target")
    })?
    Ok(ArrowData.ArrowLimits{max_rows: limits.max_output_rows, max_columns: 1024,
        max_children: limits.encoding.max_depth, max_dictionary_values: limits.max_output_rows,
        max_buffer_bytes: max_buffer_bytes, max_total_bytes: max_total_bytes})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3291
fn jet_data_arrow_error(error: ArrowData.ArrowError) -> DataError {
    kind :: match error.kind {
        .Limit -> DataErrorKind.Limit
        .ProducerFailure -> DataErrorKind.Bridge
        _ -> DataErrorKind.Decode
    }
    jet_data_loader_error(kind, "data.loader.parquet", error.to_string())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3302
fn jet_data_loader_parquet_tree(payload: &[U8], limits: &DataLimits) -> Result<DataTree, DataError> {
    arrow_limits :: jet_data_arrow_limits(limits)?
    // GATE #4565: kernel primitive
    #Unsafe("exact official provider C ABI; checked Arrow owner validates pointers, callbacks, offsets and buffers") {
        ArrowFileReader.register(jet_data_read).map_err(jet_data_arrow_error)?
        ArrowFileReader.read_tree(ArrowFileReader.FORMAT_PARQUET, payload, &arrow_limits)
            .map_err(jet_data_arrow_error)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3319
fn jet_data_loader_tree(payload: &[U8], format: DataFormat,
    limits: &DataLimits) -> Result<DataTree, DataError> {
    if format == .Parquet -> return jet_data_loader_parquet_tree(payload, limits)
    if format == .Arrow {
        return Err(jet_data_loader_error(DataErrorKind.Bridge, "data.loader",
            "Arrow IPC has a separate provider boundary; Parquet is the registered reader"))
    }
    text :: String.from_utf8(payload.to_vec()).map_err(fn(error) {
        jet_data_loader_error(DataErrorKind.Decode, "data.loader", "payload is not UTF-8: {error}")
    })?
    tree :: match format {
        .JSON -> parse_json_typed_datatree(&text).map_err(fn(error) {
            reason :: match error.line {
                Ok(line) -> "invalid JSON (line {line}): {error.reason}"
                Err(_) -> "invalid JSON: {error.reason}"
            }
            jet_data_loader_error(DataErrorKind.Decode, "data.loader.json", ^reason)
        })?
        .CSV -> jet_data_loader_csv_tree(&text, limits)?
        .JSONL -> jet_data_loader_jsonl_tree(&text, limits)?
        .Parquet | .Arrow -> unreachable()
    }
    jet_data_loader_check_tree_rows(&tree, limits, "data.loader")?
    Ok(^tree)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3362
fn jet_data_loader_payload<T>(loader: &DataLoader<T>) -> Result<([U8], Bool), DataError> {
    state :: jet_data_loader_kernel_state(loader)
    if LoaderKernel.payload(&state).map_err(jet_data_loader_kernel_error)? == Some(payload) {
        return Ok(^payload)
    }
    if loader.source.kind == .File and loader.source.member.is_empty() {
        // GATE #4565: kernel primitive
        payload :: #Unsafe("read the retained raw local path; public locator remains redacted in diagnostics") {
            fs.read(&loader.raw_locator)
        }.map_err(fn(error) {
            jet_data_loader_error(DataErrorKind.IO, "data.loader.file",
                "could not read `{loader.source.locator}`: {error}")
        })?
        jet_data_loader_check_payload(&loader.limits, payload.len(), "data.loader.file")?
        return Ok((^payload, loader.offline))
    }
    operation :: match loader.source.kind {
        .URL -> "data.loader.url"
        .Database -> "data.loader.database"
        .File -> "data.loader.archive"
        .Value -> "data.loader.value"
    }
    Err(jet_data_loader_error(DataErrorKind.Bridge, operation,
        "provider payload is missing; core does not access remote authority"))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3397
fn jet_data_loader_fail<T>(loader: &DataLoader<T>, error: DataError) -> DataError {
    kind :: match error.kind {
        .Limit -> LoaderKernel.ErrorKind.Limit
        .State -> LoaderKernel.ErrorKind.State
        .Bridge -> LoaderKernel.ErrorKind.Bridge
        _ -> LoaderKernel.ErrorKind.InvalidArgument
    }
    state := jet_data_loader_kernel_state(loader)
    LoaderKernel.fail(&state, &LoaderKernel.KernelError{kind: kind,
        operation: error.operation.clone(), reason: error.reason.clone()})
    jet_data_loader_apply_kernel(loader, ^state)
    ^error
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3427
fn jet_data_loader_snapshot<T: __jet_Decode + __jet_Encode>(
    loader: &DataLoader<T>) -> Result<DataSnapshot<T>, DataError> {
    if loader.cancelled {
        return Err(jet_data_loader_fail(loader, jet_data_loader_error(DataErrorKind.State,
            "data.loader", "loader was cancelled before snapshot")))
    }
    if jet_data_loader_validate_runtime(loader) == Err(error) {
        return Err(jet_data_loader_fail(loader, ^error))
    }
    jet_data_limits_validate(&loader.limits).map_err(fn(error) { jet_data_loader_fail(loader, ^error) })?
    (payload, offline) :: match jet_data_loader_payload(loader) {
        Ok(payload) -> ^payload
        Err(error) -> return Err(jet_data_loader_fail(loader, ^error))
    }
    tree :: match jet_data_loader_tree(&payload, loader.format, &loader.limits) {
        Ok(tree) -> ^tree
        Err(error) -> return Err(jet_data_loader_fail(loader, ^error))
    }
    value :: match T.jet_decode(&tree) {
        Ok(value) -> ^value
        Err(errors) -> return Err(jet_data_loader_fail(loader,
            jet_data_loader_error(DataErrorKind.Decode, "data.loader",
                jet_data_field_errors_reason(^errors))))
    }
    canonical :: jet_data_loader_canonical_tree(&value.jet_encode()).into_bytes()
    schema :: jet_data_loader_schema(&tree, loader.format)
    schema_id :: schema.identity.clone()
    provenance :: DataProvenance{source: loader.source.clone(), format: loader.format,
        authority: loader.authority.clone()}
    state := jet_data_loader_kernel_state(loader)
    facts :: match LoaderKernel.commit_snapshot(&state, ^payload, &canonical, &schema_id, offline) {
        Ok(facts) -> ^facts
        Err(error) -> return Err(jet_data_loader_fail(loader, jet_data_loader_kernel_error(^error)))
    }
    jet_data_loader_apply_kernel(loader, ^state)
    status :: loader.status.clone()
    identity :: DataSnapshotIdentity{id: "snapshot-{facts.snapshot_id}", source: "source-{facts.source_id}",
        content: ^facts.content_id, schema: ^facts.schema_id, format: loader.format}
    Ok(DataSnapshot{value: ^value, identity: ^identity, provenance: ^provenance,
        schema: ^schema, status: ^status, content: ^canonical})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3508
fn jet_data_loader_bind<T>(loader: &DataLoader<T>, payload: &[U8]) -> Result<(), DataError> {
    state := jet_data_loader_kernel_state(loader)
    if LoaderKernel.bind(&state, payload.clone()) == Err(error) {
        return Err(jet_data_loader_fail(loader, jet_data_loader_kernel_error(^error)))
    }
    jet_data_loader_apply_kernel(loader, ^state)
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3525
fn jet_data_loader_bind_text<T>(loader: &DataLoader<T>, payload: &String) -> Result<(), DataError> {
    jet_data_loader_bind(loader, &payload.as_bytes().to_vec())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3532
fn jet_data_loader_cancel<T>(loader: &DataLoader<T>) -> {
    state := jet_data_loader_kernel_state(loader)
    LoaderKernel.cancel(&state)
    jet_data_loader_apply_kernel(loader, ^state)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3538
fn jet_data_loader_offline<T>(loader: &DataLoader<T>, enabled: Bool) -> {
    state := jet_data_loader_kernel_state(loader)
    LoaderKernel.set_offline(&state, enabled)
    jet_data_loader_apply_kernel(loader, ^state)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3547
fn jet_data_loader_invalidate<T>(loader: &DataLoader<T>, cause: DataInvalidationCause) -> {
    state := jet_data_loader_kernel_state(loader)
    LoaderKernel.invalidate(&state, match cause {
        .NoCause -> LoaderKernel.InvalidationCause.NoCause
        .Loader -> LoaderKernel.InvalidationCause.Loader
        .Input -> LoaderKernel.InvalidationCause.Input
        .ArchiveMember -> LoaderKernel.InvalidationCause.ArchiveMember
        .Parameters -> LoaderKernel.InvalidationCause.Parameters
        .Credential -> LoaderKernel.InvalidationCause.Credential
        .Capability -> LoaderKernel.InvalidationCause.Capability
        .Manual -> LoaderKernel.InvalidationCause.Manual
    })
    jet_data_loader_apply_kernel(loader, ^state)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3584
fn jet_data_loader_needs_refresh<T>(loader: &DataLoader<T>) -> Bool {
    LoaderKernel.needs_refresh(&jet_data_loader_kernel_state(loader))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3588
fn jet_data_loader_ready<T>(loader: &DataLoader<T>) -> Bool {
    LoaderKernel.ready(&jet_data_loader_kernel_state(loader))
}
