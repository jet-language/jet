// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1794
fn jet_data_query_extreme_by<T: Clone, K: Clone + PartialOrd>(
    query: &DataQuery<T>, key: fn(T) -> K, extreme: JetDataExtreme,
    operation: &String) -> DataQuery<K> {
    source :: query.maintained_watch_source()
    tracking :: query.tracking.clone()
    steps := query.plan()
    steps.push(operation.rsplit(".").next().unwrap_or(operation).to_string())
    key :: Arc.new(key)
    input :: query.clone()
    compute_key :: key.clone()
    result := jet_data_reducer_query(tracking, ^steps, fn() {
        rows :: jet_data_query_collect(&input)?
        jet_data_extreme_materialized(^rows, compute_key.as_ref(), extreme, operation)
    })
    if source == Some(source) {
        result = result.with_watch_source(Rc.new(JetDataExtremeWatchSource{
            source: ^source, base: RefCell.new(None), key: ^key,
            extreme: extreme, operation: operation}))
    }
    ^result
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1830
fn jet_data_query_min<T: Clone, V: Clone + PartialOrd>(
    query: &DataQuery<T>, key: fn(T) -> V) -> DataQuery<V> {
    jet_data_query_extreme_by(query, key, JetDataExtreme.Min, "query.min")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1842
fn jet_data_query_max<T: Clone, V: Clone + PartialOrd>(
    query: &DataQuery<T>, key: fn(T) -> V) -> DataQuery<V> {
    jet_data_query_extreme_by(query, key, JetDataExtreme.Max, "query.max")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1856
fn jet_data_query_map_checked<T: Clone, U: Clone>(
    query: &DataQuery<T>, mapper: fn(T) -> Result<U, DataError>) -> DataQuery<U> {
    source :: query.maintained_watch_source()
    tracking :: query.tracking.clone()
    steps := query.plan()
    steps.push("map")
    mapper :: Arc.new(mapper)
    input :: query.clone()
    compute_mapper :: mapper.clone()
    mapped := jet_data_reducer_query(tracking, ^steps, fn() {
        rows :: jet_data_query_collect(&input)?
        rows.into_iter().map(fn(row) { compute_mapper(^row) }).collect()
    })
    if source == Some(source) {
        watch_source :: JetDataMapWatchSource{source: ^source, base: RefCell.new(None), map: ^mapper}
        mapped = mapped.with_watch_source(Rc.new(^watch_source))
    }
    ^mapped
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1887
fn jet_data_query_map<T: Clone, U: Clone>(
    query: &DataQuery<T>, mapper: fn(T) -> U) -> DataQuery<U> {
    jet_data_query_map_checked(query, fn(row) { Ok(mapper(^row)) })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1901
fn jet_data_reducer_query<O>(tracking: Rc<DataTrackedMeta>?, steps: [String],
    compute: fn() -> Result<[O], DataError>) -> DataQuery<O> {
    match tracking {
        Some(tracking) -> DataQuery.from_recomputation(^steps, ^tracking, compute)
        None -> DataQuery.from_computation(^steps, compute)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1916
fn jet_data_group_sum_query_checked<T: Clone, K: Clone + PartialEq, V: Clone + Add>(
    grouped: &DataGroupedQuery<T, K>,
    value: fn(T) -> Result<V, DataError>) -> DataQuery<GroupValue<K, V>> {
    query :: grouped.query.clone()
    key :: grouped.key.clone()
    value :: Arc.new(value)
    steps :: jet_data_grouped_steps(grouped, "sum")
    tracking :: query.tracking.clone()
    source :: query.tracked_reader()
    sum_recomputed :: type_name<V>() == "f32" or type_name<V>() == "f64"
    aggregate :: Arc.new(fn(values: &[V]) {
        values := values.iter().cloned()
        first :: match values.next() {
            Some(first) -> ^first
            None -> return Err(jet_data_error(DataErrorKind.State,
                "query.group_by.sum", "empty group has no sum"))
        }
        Ok(values.fold(^first, fn(total, value) { total + value }))
    })
    compute_query :: query.clone()
    compute_key :: key.clone()
    compute_value :: value.clone()
    result :: jet_data_reducer_query(tracking, steps, fn() {
        jet_data_group_sum_materialized(&compute_query, compute_key.as_ref(), compute_value.as_ref())
    })
    if source == Some(source) {
        result.with_watch_source(Rc.new(JetDataGroupWatchSource{
            source: ^source, operations: query.operations.clone(), key: ^key,
            value: ^value, aggregate: ^aggregate, operation: "query.group_by.sum",
            mode: if sum_recomputed -> "recomputed" else -> "incremental",
            recomputed: sum_recomputed, state: RefCell.new(None)}))
    } else { ^result }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1971
fn jet_data_group_sum_query<T: Clone, K: Clone + PartialEq, V: Clone + Add>(
    grouped: &DataGroupedQuery<T, K>, value: fn(T) -> V) -> DataQuery<GroupValue<K, V>> {
    jet_data_group_sum_query_checked(grouped, fn(row) { Ok(value(^row)) })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1986
fn jet_data_group_count_query<T: Clone, K: Clone + PartialEq, V: Clone + From<I64>>(
    grouped: &DataGroupedQuery<T, K>) -> DataQuery<GroupValue<K, V>> {
    query :: grouped.query.clone()
    key :: grouped.key.clone()
    steps :: jet_data_grouped_steps(grouped, "count")
    tracking :: query.tracking.clone()
    source :: query.tracked_reader()
    value :: Arc.new(fn(_: T) { Ok(V.from(1)) })
    aggregate :: Arc.new(fn(values: &[V]) { Ok(V.from(values.len() as I64)) })
    compute_query :: query.clone()
    compute_key :: key.clone()
    result :: jet_data_reducer_query(tracking, steps, fn() {
        rows :: jet_data_query_collect(&compute_query)?
        limits :: DataLimits.safe()
        groups: [(K, I64)] := []
        loop row in rows {
            group_key :: compute_key(^row)
            if groups.iter_mut().find(fn(entry) { entry.0 == group_key }) == Some(entry) {
                entry.1 = entry.1.saturating_add(1)
            } else {
                if groups.len() as I64 >= limits.max_groups {
                    return Err(jet_data_error(DataErrorKind.Limit,
                        "query.group_by.count", "max_groups {limits.max_groups} exceeded"))
                }
                groups.push((^group_key, 1))
            }
        }
        Ok(groups.into_iter().map(fn(entry) {
            GroupValue{key: ^entry.0, value: V.from(entry.1)}
        }).collect())
    })
    if source == Some(source) {
        result.with_watch_source(Rc.new(JetDataGroupWatchSource{
            source: ^source, operations: query.operations.clone(), key: ^key,
            value: ^value, aggregate: ^aggregate, operation: "query.group_by.count",
            mode: "incremental", recomputed: false, state: RefCell.new(None)}))
    } else { ^result }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2049
fn jet_data_group_mean_query_checked<T: Clone, K: Clone + PartialEq>(
    grouped: &DataGroupedQuery<T, K>,
    value: fn(T) -> Result<F64, DataError>) -> DataQuery<GroupValue<K, F64>> {
    query :: grouped.query.clone()
    key :: grouped.key.clone()
    source :: query.tracked_reader()
    steps :: jet_data_grouped_steps(grouped, "mean")
    tracking :: query.tracking.clone()
    aggregate :: Arc.new(fn(values: &[F64]) {
        if values.iter().any(fn(value) { not value.is_finite() }) {
            return Err(jet_data_error(DataErrorKind.NonFinite,
                "query.group_by.mean", "group values must be finite"))
        }
        if values.is_empty() {
            return Err(jet_data_error(DataErrorKind.State,
                "query.group_by.mean", "empty group has no mean"))
        }
        Ok(values.iter().copied().sum<F64>() / values.len() as F64)
    })
    value :: Arc.new(value)
    compute_query :: query.clone()
    compute_key :: key.clone()
    compute_value :: value.clone()
    result :: jet_data_reducer_query(tracking, steps, fn() {
        rows :: jet_data_query_collect(&compute_query)?
        limits :: DataLimits.safe()
        groups: [(K, F64, I64)] := []
        loop row in rows {
            group_key :: compute_key(row.clone())
            group_value :: compute_value(^row)?
            if not group_value.is_finite() {
                return Err(jet_data_error(DataErrorKind.NonFinite,
                    "query.group_by.mean", "group values must be finite"))
            }
            if groups.iter_mut().find(fn(entry) { entry.0 == group_key }) == Some(entry) {
                entry.1 += group_value
                entry.2 = entry.2.saturating_add(1)
            } else {
                if groups.len() as I64 >= limits.max_groups {
                    return Err(jet_data_error(DataErrorKind.Limit,
                        "query.group_by.mean", "max_groups {limits.max_groups} exceeded"))
                }
                groups.push((^group_key, group_value, 1))
            }
        }
        Ok(groups.into_iter().map(fn(entry) {
            GroupValue{key: ^entry.0, value: entry.1 / entry.2 as F64}
        }).collect())
    })
    if source == Some(source) {
        result.with_watch_source(Rc.new(JetDataGroupWatchSource{
            source: ^source, operations: query.operations.clone(), key: ^key,
            value: ^value, aggregate: ^aggregate, operation: "query.group_by.mean",
            mode: "recomputed", recomputed: true, state: RefCell.new(None)}))
    } else { ^result }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2142
fn jet_data_group_mean_query<T: Clone, K: Clone + PartialEq>(
    grouped: &DataGroupedQuery<T, K>, value: fn(T) -> F64) -> DataQuery<GroupValue<K, F64>> {
    jet_data_group_mean_query_checked(grouped, fn(row) { Ok(value(^row)) })
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2156
fn jet_data_csv_reader<T: __jet_Decode>(
    input: JetFileReader, limits: DataLimits) -> Result<DataStream, DataError> {
    jet_data_limits_validate(&limits)?
    reader :: jet_enc_csv_reader(^input, limits.encoding.clone(), ",", false, false)
        .map_err(fn(enc) { jet_data_from_encoding("csv_reader", Err(JetAbsent), ^enc) })?
    Ok(DataStream{inner: DataStreamInner.CSV{reader: ^reader, headers: None},
        limits: ^limits, terminal: None, eof: false, row_index: 0, cancelled: false})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2182
fn jet_data_json_reader<T: __jet_Decode>(
    input: JetFileReader, limits: DataLimits) -> Result<DataStream, DataError> {
    jet_data_limits_validate(&limits)?
    reader := jet_enc_json_reader(^input, limits.encoding.clone())
        .map_err(fn(enc) { jet_data_from_encoding("json_reader", Err(JetAbsent), ^enc) })?
    reader.typed_numbers = true
    Ok(DataStream{inner: DataStreamInner.JSON{reader: ^reader, array_started: false, array_done: false},
        limits: ^limits, terminal: None, eof: false, row_index: 0, cancelled: false})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2204
fn jet_data_jsonl_reader(input: JetFileReader, limits: DataLimits) -> Result<DataStream, DataError> {
    jet_data_limits_validate(&limits)?
    reader :: jet_enc_jsonl_reader(^input, limits.encoding.clone())
        .map_err(fn(enc) { jet_data_from_encoding("jsonl_reader", Err(JetAbsent), ^enc) })?
    Ok(DataStream{inner: DataStreamInner.JSONL{reader: ^reader},
        limits: ^limits, terminal: None, eof: false, row_index: 0, cancelled: false})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2221
fn jet_data_stream_fail<T>(stream: &DataStream, error: DataError) -> Result<T, DataError> {
    stream.terminal = Some(error.clone())
    Err(^error)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2229
fn jet_data_field_errors_reason(errors: [FieldError]) -> String {
    errors.into_iter().map(fn(error) {
        if error.path.is_empty() -> ^error.reason
        else -> "{error.path}: {error.reason}"
    }).collect<[String]>().join("; ")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2243
fn jet_data_stream_decode_csv_row<T: __jet_Decode>(
    headers: &[String], row: [String], row_index: I64) -> Result<T, DataError> {
    if row.len() != headers.len() {
        error := jet_data_error(DataErrorKind.Decode, "csv_reader",
            "CSV row has {row.len()} fields; expected {headers.len()}")
        error.row = Val(Int.from_i64(row_index))
        return Err(^error)
    }
    obj :: headers.iter().cloned().zip(row.into_iter().map(fn(value) { DataTree.Text(^value) })).collect()
    T.jet_decode(&DataTree.Object(^obj)).map_err(fn(errors) {
        error := jet_data_error(DataErrorKind.Decode, "csv_reader", jet_data_field_errors_reason(^errors))
        error.row = Val(Int.from_i64(row_index))
        ^error
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2280
// D-FAIL-CARRIER1=A: clean absence ends the stream; a broken row is a report.
fn jet_data_stream_next<T: __jet_Decode>(
    stream: &DataStream) -> Result<JetOutcome<T, JetAbsent>, DataError> {
    jet_data_stream_scan<T>(stream).map(jet_outcome_of)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2287
fn jet_data_stream_scan<T: __jet_Decode>(stream: &DataStream) -> Result<T?, DataError> {
    if stream.terminal == Some(error) -> return Err(error.clone())
    if stream.cancelled {
        return jet_data_stream_fail(stream, jet_data_error(DataErrorKind.State,
            "data.stream", "stream was cancelled before the next row"))
    }
    if stream.eof -> return Ok(None)
    match &stream.inner {
        DataStreamInner.CSV{reader, headers} -> {
            if headers.is_none() {
                match reader.next_record() {
                    Ok(Some(header)) -> headers = Some(^header.fields)
                    Ok(None) -> { stream.eof = true; return Ok(None) }
                    Err(enc) -> return jet_data_stream_fail(stream,
                        jet_data_from_encoding("csv_reader", Err(JetAbsent), ^enc))
                }
            }
            header :: headers.as_ref().unwrap().clone()
            match reader.next_record() {
                Ok(None) -> { stream.eof = true; Ok(None) }
                Ok(Some(row)) -> {
                    stream.row_index += 1
                    match jet_data_stream_decode_csv_row<T>(&header, ^row.fields, stream.row_index) {
                        Ok(value) -> Ok(Some(^value))
                        Err(error) -> jet_data_stream_fail(stream, ^error)
                    }
                }
                Err(enc) -> jet_data_stream_fail(stream,
                    jet_data_from_encoding("csv_reader", Ok(stream.row_index + 1), ^enc))
            }
        }
        DataStreamInner.JSON{reader, array_started, array_done} -> {
            if array_done -> { stream.eof = true; return Ok(None) }
            if not array_started {
                match reader.next_event() {
                    Ok(Some(DataEvent.ArrayStart)) -> array_started = true
                    Ok(Some(_)) -> return jet_data_stream_fail(stream,
                        jet_data_error(DataErrorKind.Decode, "json_reader",
                            "typed JSON stream requires a top-level array of objects"))
                    Ok(None) -> { stream.eof = true; return Ok(None) }
                    Err(enc) -> return jet_data_stream_fail(stream,
                        jet_data_from_encoding("json_reader", Err(JetAbsent), ^enc))
                }
            }
            first :: match reader.next_event() {
                Ok(None) -> { array_done = true; stream.eof = true; return Ok(None) }
                Ok(Some(DataEvent.ArrayEnd)) -> { array_done = true; stream.eof = true; return Ok(None) }
                Ok(Some(event)) -> ^event
                Err(enc) -> return jet_data_stream_fail(stream,
                    jet_data_from_encoding("json_reader", Ok(stream.row_index + 1), ^enc))
            }
            heap := match jet_json_fold_budget(reader) {
                Ok(heap) -> ^heap
                Err(enc) -> return jet_data_stream_fail(stream,
                    jet_data_from_encoding("json_reader", Ok(stream.row_index + 1), ^enc))
            }
            match jet_json_fold_from_event(reader, ^first, &heap) {
                Ok(tree) -> {
                    stream.row_index += 1
                    match T.jet_decode(&tree) {
                        Ok(value) -> Ok(Some(^value))
                        Err(errors) -> {
                            error := jet_data_error(DataErrorKind.Decode, "json_reader",
                                jet_data_field_errors_reason(^errors))
                            error.row = Val(Int.from_i64(stream.row_index))
                            jet_data_stream_fail(stream, ^error)
                        }
                    }
                }
                Err(enc) -> jet_data_stream_fail(stream,
                    jet_data_from_encoding("json_reader", Ok(stream.row_index + 1), ^enc))
            }
        }
        DataStreamInner.JSONL{reader} -> match reader.next_record() {
            Ok(None) -> { stream.eof = true; Ok(None) }
            Ok(Some(tree)) -> {
                stream.row_index += 1
                match T.jet_decode(&tree) {
                    Ok(value) -> Ok(Some(^value))
                    Err(errors) -> {
                        error := jet_data_error(DataErrorKind.Decode, "jsonl_reader",
                            jet_data_field_errors_reason(^errors))
                        error.row = Val(Int.from_i64(stream.row_index))
                        jet_data_stream_fail(stream, ^error)
                    }
                }
            }
            Err(enc) -> jet_data_stream_fail(stream,
                jet_data_from_encoding("jsonl_reader", Ok(stream.row_index + 1), ^enc))
        }
        DataStreamInner.Provider{format: _format, rows, cursor} -> {
            if cursor >= rows.len() -> { stream.eof = true; return Ok(None) }
            tree :: rows[cursor].clone()
            cursor += 1
            stream.row_index += 1
            match T.jet_decode(&tree) {
                Ok(value) -> Ok(Some(^value))
                Err(errors) -> {
                    error := jet_data_error(DataErrorKind.Decode, "data.provider",
                        jet_data_field_errors_reason(^errors))
                    error.row = Val(Int.from_i64(stream.row_index))
                    jet_data_stream_fail(stream, ^error)
                }
            }
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2483
fn jet_data_stream_collect<T: __jet_Decode + Clone>(stream: &DataStream) -> Result<[T], DataError> {
    jet_data_limits_validate(&stream.limits)?
    max_output_rows :: USize.try_from(stream.limits.max_output_rows).map_err(fn(_) {
        jet_data_error(DataErrorKind.Limit, "collect", "max_output_rows cannot be represented by this target")
    })?
    out := [T].with_capacity(max_output_rows.min(256))
    loop {
        match jet_data_stream_next<T>(stream)? {
            Err(JetAbsent) -> return Ok(^out)
            Ok(row) -> {
                if out.len() >= max_output_rows {
                    // Crossing fails before retaining the item that crosses.
                    return jet_data_stream_fail(stream, jet_data_error(DataErrorKind.Limit,
                        "collect", "max_output_rows {stream.limits.max_output_rows} exceeded"))
                }
                out.try_reserve_exact(1).map_err(fn(_) {
                    jet_data_error(DataErrorKind.Limit, "collect",
                        "output allocation exceeded the configured bound")
                })?
                out.push(^row)
            }
        }
    }
}

// D-DX-LOADERS1=A: core text loaders and deterministic snapshots share the
// provider carrier; there is no second cache or credential store.
use jet_foundation.PreludeDataFlow as LoaderKernel
use core.data.[DataAuthority, DataLoaderStatus, DataFreshness, DataInvalidationCause,
    DataFormat, DataSourceIdentity]
use core.prelude.runtime.std_common_types.[DataLoader, DataLoaderKind]
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2531
const JET_DATA_LOADER_MAX_PUBLIC_TEXT: USize = 4096
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2532
const JET_DATA_LOADER_MAX_STATUS_TEXT: USize = 1024
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2534
fn jet_data_loader_kernel_kind(kind: DataLoaderKind) -> LoaderKernel.LoaderKind {
    match kind {
        .File -> LoaderKernel.LoaderKind.File
        .URL -> LoaderKernel.LoaderKind.URL
        .Database -> LoaderKernel.LoaderKind.Database
        .Value -> LoaderKernel.LoaderKind.Value
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2547
fn jet_data_loader_kernel_limits(limits: &DataLimits) -> LoaderKernel.Limits {
    LoaderKernel.Limits{buffer_bytes: limits.encoding.buffer_bytes, max_depth: limits.encoding.max_depth,
        max_item_bytes: limits.encoding.max_item_bytes, max_total_bytes: limits.encoding.max_total_bytes.ok(),
        max_expansion_depth: limits.encoding.max_expansion_depth,
        max_expansion_bytes: limits.encoding.max_expansion_bytes, max_groups: limits.max_groups,
        max_sort_rows: limits.max_sort_rows, max_join_rows: limits.max_join_rows,
        max_output_rows: limits.max_output_rows}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2564
fn jet_data_loader_kernel_authority(authority: &DataAuthority) -> LoaderKernel.Authority {
    LoaderKernel.Authority{scope: authority.scope.clone(), revision: authority.revision.clone()}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2573
fn jet_data_loader_kernel_status(status: &DataLoaderStatus) -> LoaderKernel.Status {
    LoaderKernel.Status{identity: status.identity.clone(),
        freshness: match status.freshness {
            .Pending -> LoaderKernel.Freshness.Pending
            .Fresh -> LoaderKernel.Freshness.Fresh
            .Stale -> LoaderKernel.Freshness.Stale
            .Error -> LoaderKernel.Freshness.Error
            .Offline -> LoaderKernel.Freshness.Offline
            .Cancelled -> LoaderKernel.Freshness.Cancelled
        },
        invalidated_by: match status.invalidated_by {
            .NoCause -> LoaderKernel.InvalidationCause.NoCause
            .Loader -> LoaderKernel.InvalidationCause.Loader
            .Input -> LoaderKernel.InvalidationCause.Input
            .ArchiveMember -> LoaderKernel.InvalidationCause.ArchiveMember
            .Parameters -> LoaderKernel.InvalidationCause.Parameters
            .Credential -> LoaderKernel.InvalidationCause.Credential
