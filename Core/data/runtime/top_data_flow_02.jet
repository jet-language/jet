// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2899
fn jet_data_loader_format_for_locator(locator: &String) -> Result<DataFormat, DataError> {
    path := locator.split(fn(character) { character == '?' or character == '#' }).next().unwrap_or(locator)
    path = path.rsplit_once("/").map_or(path, fn(entry) { entry.1 })
    extension :: match path.rsplit_once(".").map(fn(entry) { entry.1 }) {
        Some(extension) -> extension
        None -> return Err(jet_data_loader_error(DataErrorKind.Bridge, "data.load",
            "source has no core format; import a provider package"))
    }
    jet_data_loader_format(extension)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:2917
fn jet_data_loader_load<T>(locator: &String, limits: &DataLimits) -> Result<DataLoader<T>, DataError> {
    format :: jet_data_loader_format_for_locator(locator)?
    if locator.starts_with("http://") or locator.starts_with("https://") {
        return jet_data_loader_url(locator, &format.as_str().to_string(), "network", limits)
    }
    jet_data_loader_file(locator, &format.as_str().to_string(), limits)
}
