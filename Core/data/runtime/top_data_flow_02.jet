            .Stale -> DataFreshness.Stale
            .Error -> DataFreshness.Error
            .Offline -> DataFreshness.Offline
            .Cancelled -> DataFreshness.Cancelled
        },
        invalidated_by: match status.invalidated_by {
            .NoCause -> DataInvalidationCause.NoCause
            .Loader -> DataInvalidationCause.Loader
            .Input -> DataInvalidationCause.Input
            .ArchiveMember -> DataInvalidationCause.ArchiveMember
            .Parameters -> DataInvalidationCause.Parameters
            .Credential -> DataInvalidationCause.Credential
            .Capability -> DataInvalidationCause.Capability
            .Manual -> DataInvalidationCause.Manual
        },
