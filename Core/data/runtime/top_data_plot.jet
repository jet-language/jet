// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:408
#Derive(Clone, Debug, PartialEq)
pub struct JetDataPlotField { pub id: String, pub name: String, pub type_name: String }
impl JetDataPlotField {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:416
    pub fn new<N: Into<String>, T: Into<String>>(name: N, type_name: T) -> Self {
        name :: name.into()
        type_name :: type_name.into()
        id :: column_identity(&name, &type_name)
        Self{id: ^id, name: ^name, type_name: ^type_name}
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:427
    pub fn with_id<I: Into<String>, N: Into<String>, T: Into<String>>(id: I, name: N, type_name: T) -> Self {
