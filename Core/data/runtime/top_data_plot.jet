pub struct DataPlotError { pub kind: String, pub operation: String, pub reason: String, pub index: I64? }
impl Display for DataPlotError {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:10
    fn fmt(self: &Self, f: &Formatter) -> () Err! {
        f.write_fmt("{self.kind} {self.operation}")?
