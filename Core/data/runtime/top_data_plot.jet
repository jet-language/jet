    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:439
    pub fn validate(self: &Self) -> () JetDataPlotError! {
        if self.id.trim().is_empty() || self.name.trim().is_empty() {
            return Err(JetDataPlotError.invalid("plot.schema", "plot column identity and name must not be empty").with_field(self.name.clone()))
        }
        if self.id.chars().chain(self.name.chars()).chain(self.type_name.chars()).any(fn(c) { c.is_control() }) {
            return Err(JetDataPlotError.invalid("plot.schema", "plot column metadata must not contain control characters").with_field(self.name.clone()))
        }
        if self.type_name.trim().is_empty() -> return Err(JetDataPlotError.invalid("plot.schema", "plot column type must not be empty").with_field(self.name.clone()))
        ()
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:470
    fn canonical_key(self: &Self) -> String { "{jet_data_plot_escape(&self.id)}:{jet_data_plot_escape(&self.name)}:{jet_data_plot_escape(&self.type_name)}" }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:480
#Derive(Clone, Debug, PartialEq)
pub struct JetDataPlotSchema { pub identity: String, pub row_type: String, pub columns: [JetDataPlotField] }
impl JetDataPlotSchema {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:488
    pub fn new<I: Into<String>, R: Into<String>>(identity: I, row_type: R, columns: [JetDataPlotField]) -> Self {
        Self{identity: identity.into(), row_type: row_type.into(), columns: ^columns}
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:500
    pub fn validate(self: &Self) -> () JetDataPlotError! {
        if self.identity.trim().is_empty() || self.row_type.trim().is_empty() {
            return Err(JetDataPlotError.invalid("plot.schema", "plot schema identity and row type must not be empty"))
        }
        if self.identity.chars().chain(self.row_type.chars()).any(fn(c) { c.is_control() }) {
            return Err(JetDataPlotError.invalid("plot.schema", "plot schema metadata must not contain control characters"))
        }
        names := [String: Bool]{}
        ids := [String: Bool]{}
        loop column in &self.columns {
            column.validate()?
            if names.contains_key(&column.name) -> return Err(JetDataPlotError.invalid("plot.schema", "plot schema repeats a column name").with_field(column.name.clone()))
            names.insert(column.name.clone(), true)
            if ids.contains_key(&column.id) -> return Err(JetDataPlotError.invalid("plot.schema", "plot schema repeats a column identity").with_field(column.name.clone()))
            ids.insert(column.id.clone(), true)
        }
        ()
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:540
    pub fn column_named(self: &Self, name: &String) -> &JetDataPlotField? { self.columns.iter().find(fn(column) { column.name == name }) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:544
    pub fn column_id(self: &Self, id: &String) -> &JetDataPlotField? { self.columns.iter().find(fn(column) { column.id == id }) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:548
    fn resolve(self: &Self, field: &JetDataPlotField) -> JetDataPlotField JetDataPlotError! {
        found :: self.column_id(&field.id).ok_or_else(fn() {
            JetDataPlotError.invalid("plot.schema", "plot encoding references an unknown table column identity")
                .with_field(field.name.clone()).with_expected(field.id.clone()).with_actual("missing")
        })?
        if found.name != field.name || found.type_name != field.type_name {
            return Err(JetDataPlotError.invalid("plot.schema", "plot encoding column type does not match the table schema")
                .with_field(field.name.clone()).with_expected(found.type_name.clone()).with_actual(field.type_name.clone()))
        }
        found.clone()
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:570
    fn canonical_key(self: &Self) -> String {
        columns :: self.columns.iter().map(fn(column) { column.canonical_key() }).collect<[String]>().join(",")
        "schema={jet_data_plot_escape(&self.identity)}:row={jet_data_plot_escape(&self.row_type)}:columns=[{columns}]"
    }
}
