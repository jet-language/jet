// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:19
fn jet_data_line_values<K>(groups: &[GroupValue<K, F64>]) -> [F64] { groups.iter().map(fn(group) { group.value }).collect() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:23
fn jet_data_line_options_validate(options: &DataLineOptions, operation: String) -> () DataPlotError! {
    if Ok(reference) :: options.reference {
        if !reference.is_finite() -> return Err(DataPlotError{kind: "NonFinite", operation: operation, reason: "reference line must be finite", index: None})
    }
    if options.style != "solid" && options.style != "dashed" && options.style != "dotted" {
        return Err(DataPlotError{kind: "InvalidArgument", operation: operation, reason: "line style must be solid, dashed, or dotted", index: None})
    }
    if options.color.is_empty() -> return Err(DataPlotError{kind: "InvalidArgument", operation: operation, reason: "line color must not be empty", index: None})
    ()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:56
fn jet_data_line_validate<K: JetShow>(groups: &[GroupValue<K, F64>], options: &DataLineOptions, operation: String) -> () DataPlotError! {
    loop (index, group) in groups.iter().enumerate() {
        if !group.value.is_finite() -> return Err(DataPlotError{kind: "NonFinite", operation: operation, reason: "plot values must be finite", index: Val(index as I64)})
    }
    jet_data_line_options_validate(options, operation)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:74
pub fn jet_data_line_text_plot_checked<K: JetShow>(groups: &[GroupValue<K, F64>], options: &DataLineOptions) -> String DataPlotError! {
    jet_data_line_validate(groups, options, "line_text")?
    jet_data_line_text(groups, options)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:82
pub fn jet_data_line_svg_plot_checked<K: JetShow>(groups: &[GroupValue<K, F64>], options: &DataLineOptions) -> String DataPlotError! {
    jet_data_line_validate(groups, options, "line_svg")?
    jet_data_line_svg(groups, options)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:90
pub fn jet_data_line_text<K: JetShow>(groups: &[GroupValue<K, F64>], options: &DataLineOptions) -> String {
    values :: jet_data_line_values(groups)
    labels :: groups.iter().map(fn(group) { group.key.jet_show() }).collect<[String]>().join(" | ")
    points :: values.iter().map(fn(value) {
        value :: jet_data_plot_normalize_zero(*value)
        "{value:.6}"
    }).collect<[String]>().join(" -> ")
    lines := [String]{}
    if !options.title.is_empty() { lines.push(options.title.clone()) }
    lines.push("{options.x_label}: {labels}")
    lines.push("{options.y_label}: {points}")
    markers :: if options.markers { "on" } else { "off" }
    lines.push("line: style={options.style} color={options.color} markers={markers}")
    if Ok(reference) :: options.reference {
        reference :: jet_data_plot_normalize_zero(reference)
        lines.push("reference: {reference:.6}")
    }
    if !options.legend.is_empty() { lines.push("legend: {options.legend}") }
    lines.join("\n")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:130
pub fn jet_data_line_svg<K: JetShow>(groups: &[GroupValue<K, F64>], options: &DataLineOptions) -> String {
    width :: F64{640.0}
    height :: F64{360.0}
    left :: F64{64.0}
    right :: F64{24.0}
    top :: F64{44.0}
    bottom :: F64{52.0}
    plot_width :: width - left - right
    plot_height :: height - top - bottom
    values :: jet_data_line_values(groups)
    min := values.iter().copied().fold(F64.INFINITY, F64.min)
    max := values.iter().copied().fold(F64.NEG_INFINITY, F64.max)
    if Ok(reference) :: options.reference { min = min.min(reference); max = max.max(reference) }
    if !min.is_finite() || !max.is_finite() { min = 0.0; max = 1.0 }
    if (max - min).abs() < F64.EPSILON { min -= 1.0; max += 1.0 }
    point :: fn(index: USize, value: F64) {
        x :: if groups.len() <= 1 { left + plot_width / 2.0 } else {
            left + plot_width * (index as F64) / ((groups.len() - 1) as F64)
        }
        y :: top + (max - value) / (max - min) * plot_height
        (x, y)
    }
    points :: values.iter().enumerate().map(fn(pair) {
        (x, y) :: point(pair.0, *pair.1)
        "{x:.3},{y:.3}"
    }).collect<[String]>().join(" ")
    dash :: match options.style.as_str() { "dashed" -> " stroke-dasharray=\"8 5\"", "dotted" -> " stroke-dasharray=\"2 5\"", _ -> "" }
    out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"640\" height=\"360\" viewBox=\"0 0 640 360\"><title>{jet_data_plot_svg_escape(&options.title)}</title>"
    out.push_str("<rect width=\"640\" height=\"360\" fill=\"white\"/>")
    out.push_str("<line x1=\"{left}\" y1=\"{top}\" x2=\"{left}\" y2=\"{height - bottom}\" stroke=\"#333\"/><line x1=\"{left}\" y1=\"{height - bottom}\" x2=\"{width - right}\" y2=\"{height - bottom}\" stroke=\"#333\"/>")
    if Ok(reference) :: options.reference {
        (_, y) :: point(0, reference)
        out.push_str("<line x1=\"{left}\" y1=\"{y:.3}\" x2=\"{width - right}\" y2=\"{y:.3}\" stroke=\"#888\" stroke-dasharray=\"4 4\"/>")
    }
    out.push_str("<polyline fill=\"none\" stroke=\"{jet_data_plot_svg_escape(&options.color)}\" stroke-width=\"2\"{dash} points=\"{points}\"/>")
    if options.markers {
        loop (index, value) in values.iter().enumerate() {
            (x, y) :: point(index, *value)
            out.push_str("<circle cx=\"{x:.3}\" cy=\"{y:.3}\" r=\"4\" fill=\"{jet_data_plot_svg_escape(&options.color)}\"/>")
        }
    }
    loop (index, group) in groups.iter().enumerate() {
        (x, _) :: point(index, values[index])
        out.push_str("<text x=\"{x:.3}\" y=\"{height - bottom + 18.0}\" text-anchor=\"middle\" font-family=\"monospace\" font-size=\"11\">{jet_data_plot_svg_escape(&group.key.jet_show())}</text>")
    }
    out.push_str("<text x=\"{width / 2.0}\" y=\"24\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"16\">{jet_data_plot_svg_escape(&options.title)}</text>")
    out.push_str("<text x=\"{width / 2.0}\" y=\"{height - 10.0}\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\">{jet_data_plot_svg_escape(&options.x_label)}</text>")
    out.push_str("<text x=\"16\" y=\"{height / 2.0}\" text-anchor=\"middle\" transform=\"rotate(-90 16 {height / 2.0})\" font-family=\"sans-serif\" font-size=\"12\">{jet_data_plot_svg_escape(&options.y_label)}</text>")
    if !options.legend.is_empty() {
        out.push_str("<text x=\"{width - right - 120.0}\" y=\"{top - 12.0}\" font-family=\"sans-serif\" font-size=\"12\" fill=\"{jet_data_plot_svg_escape(&options.color)}\">{jet_data_plot_svg_escape(&options.legend)}</text>")
    }
    out.push_str("</svg>")
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:252
fn jet_data_plot_svg_escape(s: &String) -> String { s.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;").replace('\"', "&quot;") }
