    jet_data_kernel_validate_limits(&jet_data_kernel_limits(limits.max_groups, limits.max_sort_rows, limits.max_join_rows, limits.max_output_rows))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:93
fn jet_data_canonical_unary_plan<T>(operation: JetTableOperation, operation_name: String, rows: Usize, result_type: JetTableTypeId, output_columns: [JetTableColumn]) -> JetTablePlan DataError! {
    // GATE #4565: kernel primitive
    row_type :: JetTableTypeId.new(#Unsafe("use the checked native static row type identity for canonical table descriptors") { any.type_name<T>() })
    input_schema :: JetTableSchema.new(row_type.clone(), [])
    source :: JetTableSource.new("data.{operation_name}.source", input_schema.clone()).with_rows(rows as U128)
    plan := JetTablePlan.from_source("data.{operation_name}", ^source)
    output_schema :: if operation == JetTableOperation.Sort { input_schema.clone() }
        else { JetTableSchema.new(result_type.clone(), ^output_columns) }
    callable_result :: if operation == JetTableOperation.Sort { JetTableTypeId.string() } else { result_type }
    callable :: JetTableCallable.new("data.{operation_name}", ^row_type, ^callable_result)
    node :: match operation {
        .Sort -> plan.append_sort(^output_schema, ^callable).map_err(fn(error) {
            jet_data_error(DataErrorKind.InvalidArgument, operation_name, "canonical table plan rejected: {error}")
        })?
        .Group -> {
            input :: plan.output
            plan.append(JetTableOperation.Group, [input], ^output_schema, Val(^callable)).map_err(fn(error) {
                jet_data_error(DataErrorKind.InvalidArgument, operation_name, "canonical table plan rejected: {error}")
            })?
        }
        _ -> return Err(jet_data_error(DataErrorKind.InvalidArgument, operation_name, "unsupported canonical unary operation"))
    }
    plan.nodes[node.index()].note = "rows={rows}"
    plan.validate().map_err(fn(error) {
        jet_data_error(DataErrorKind.InvalidArgument, operation_name, "canonical table plan rejected: {error}")
    })?
    Ok(^plan)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:164
fn jet_data_canonical_join_plan<T, U>(operation_name: String, kind: JetTableJoinKind, left_rows: Usize, right_rows: Usize) -> JetTablePlan DataError! {
    // GATE #4565: kernel primitive
    (left_name, right_name) :: #Unsafe("native static type identities define canonical join schemas, never payload addresses") { (any.type_name<T>(), any.type_name<U>()) }
    row_type :: JetTableTypeId.new(left_name)
    input_schema :: JetTableSchema.new(row_type, [])
    source :: JetTableSource.new("data.{operation_name}.left", ^input_schema).with_rows(left_rows as U128)
    plan := JetTablePlan.from_source("data.{operation_name}", ^source)
    left_type :: JetTableTypeId.new(left_name)
    right_type :: JetTableTypeId.new(right_name)
    right_schema :: JetTableSchema.new(right_type.clone(), [])
    right_source :: JetTableSource.new("data.{operation_name}.right", ^right_schema).with_rows(right_rows as U128)
    right :: plan.append_source(^right_source).map_err(fn(error) {
        jet_data_error(DataErrorKind.InvalidArgument, operation_name, "canonical table plan rejected: {error}")
    })?
    left_text :: left_type.as_str()
    right_text :: right_type.as_str()
    output_schema :: JetTableSchema.new(JetTableTypeId.new("DataJoin<{left_text},{right_text}>"), [
        JetTableColumn.new("left", ^left_type),
        JetTableColumn.new("right", if kind == JetTableJoinKind.Left { JetTableTypeId.new("JetOutcome<{right_text},JetAbsent>") } else { right_type })
    ])
    node :: plan.append_join(right, ^output_schema, kind, []).map_err(fn(error) {
        jet_data_error(DataErrorKind.InvalidArgument, operation_name, "canonical table plan rejected: {error}")
    })?
    // Adapter keys determine cardinality; scan bounds do not determine output.
    plan.nodes[node.index()].facts = JetTableFacts.unknown(2)
    plan.nodes[node.index()].note = "left_rows={left_rows};right_rows={right_rows};right_type={right_name}"
    plan.validate().map_err(fn(error) {
        jet_data_error(DataErrorKind.InvalidArgument, operation_name, "canonical table plan rejected: {error}")
    })?
    Ok(^plan)
}
