            } else { jet_data_query_collect(&left_input)? }
            right_rows :: if Val(cache) :: &compute_right_static_entries {
                jet_data_static_query_entries(&right_input, cache)?.into_iter().map(fn(entry) { ^entry.value }).collect()
            } else { jet_data_query_collect(&right_input)? }
            limits :: DataLimits.safe()
            match kind {
                .Inner -> {
                    left_key :: compute_left_key.clone()
                    right_key :: compute_right_key.clone()
                    join :: join.clone()
                    rows :: jet_data_inner_join_checked(&left_rows, &right_rows,
                        fn(row) { left_key(^row) }, fn(row) { right_key(^row) }, &limits)?
                    Ok(rows.into_iter().map(fn(row) { join(^row.left, Some(^row.right)) }).collect())
                }
                .Left -> {
                    left_key :: compute_left_key.clone()
                    right_key :: compute_right_key.clone()
                    join :: join.clone()
                    rows :: jet_data_left_join_checked(&left_rows, &right_rows,
                        fn(row) { left_key(^row) }, fn(row) { right_key(^row) }, &limits)?
                    Ok(rows.into_iter().map(fn(row) { join(^row.left, row.right.ok()) }).collect())
                }
            }
        })
        if left_source.is_some() || right_source.is_some() {
            left_source :: left_source.unwrap_or_else(fn() {
                entries :: match left_static_entries {
                    Some(entries) -> ^entries
                    None -> unreachable("missing static left join cache")
                }
                Rc.new(JetDataStaticWatchSource{query: left.clone(), entries: ^entries}) as Rc<DataWatchSource<T>>
            })
            right_source :: right_source.unwrap_or_else(fn() {
                entries :: match right_static_entries {
                    Some(entries) -> ^entries
                    None -> unreachable("missing static right join cache")
                }
                Rc.new(JetDataStaticWatchSource{query: right.clone(), entries: ^entries}) as Rc<DataWatchSource<U>>
            })
            result.with_watch_source(Rc.new(JetDataJoinWatchSource{left_source: ^left_source, right_source: ^right_source,
                left_key: ^left_key, right_key: ^right_key, join: ^join, kind: kind, operation: operation, state: RefCell.new(None)}))
        } else { ^result }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1470
fn jet_data_query_inner_join<T: Clone, U: Clone>(left: &DataQuery<T>, right: &DataQuery<U>, left_key: fn(T) -> String, right_key: fn(U) -> String) -> DataQuery<DataJoin<T, U>> {
    jet_data_join_query(left, right, ^left_key, ^right_key, JetDataJoinKind.Inner,
        fn(left, right) { DataJoin{left: ^left, right: right.expect("inner join invariant")} }, "query.inner_join")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1496
fn jet_data_query_left_join<T: Clone, U: Clone>(left: &DataQuery<T>, right: &DataQuery<U>, left_key: fn(T) -> String, right_key: fn(U) -> String) -> DataQuery<DataJoin<T, JetOutcome<U, JetAbsent>>> {
    jet_data_join_query(left, right, ^left_key, ^right_key, JetDataJoinKind.Left,
        fn(left, right) { DataJoin{left: ^left, right: right.ok_or(JetAbsent)} }, "query.left_join")
}

