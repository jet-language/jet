        right_static_entries :: if right_source.is_none() { Some(Rc.new(RefCell.new(None))) } else { None }
        tracking :: left.tracking.clone().or_else(fn() { right.tracking.clone() })
        steps := left.plan()
        steps.push(operation.strip_prefix("query.").unwrap_or(operation).to_string())
        left_input :: left.clone()
        right_input :: right.clone()
        left_key :: Arc.new(^left_key)
        right_key :: Arc.new(^right_key)
        join :: Arc.new(^join)
        compute_left_key :: left_key.clone()
        compute_right_key :: right_key.clone()
        compute_join :: join.clone()
        compute_left_static_entries :: left_static_entries.clone()
        compute_right_static_entries :: right_static_entries.clone()
        result :: jet_data_reducer_query(^tracking, ^steps, fn() {
            join :: compute_join.clone()
