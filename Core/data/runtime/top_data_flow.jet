// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:470
fn jet_data_collect_rows_checked<T: Clone>(rows_source: &DataQueryRows<T>, limits: &DataLimits) -> [T] DataError! {
    jet_data_limits_validate(limits)?
    max_output_rows :: Usize.try_from(limits.max_output_rows).map_err(fn(_) {
        jet_data_error(DataErrorKind.Limit, "query.collect", "max_output_rows cannot be represented by this target")
    })?
    cursor := rows_source.cursor()
    rows := [T].with_capacity(max_output_rows.min(256))
    loop {
        remaining :: max_output_rows.saturating_sub(rows.len())
        request :: remaining.saturating_add(1).min(256)
        batch :: cursor.next_batch_with_sort_limit(request, Val(limits.max_sort_rows)).map_err(fn(limit) {
            jet_data_error(DataErrorKind.Limit, limit.operation, "max_sort_rows {limit.limit} exceeded")
        })?
        if batch.len() > remaining {
            return Err(jet_data_error(DataErrorKind.Limit, "query.collect", "max_output_rows {limits.max_output_rows} exceeded"))
        }
        exhausted :: batch.len() < request
        // GATE #4565: kernel primitive
        #Unsafe("fallible bounded native reservation propagates allocation failure without publishing partial query output") {
            rows.try_reserve_exact(batch.len()).map_err(fn(_) {
                jet_data_error(DataErrorKind.Limit, "query.collect", "output allocation exceeded the configured bound")
            })?
        }
        rows.extend(^batch)
        if exhausted -> break
    }
    Ok(^rows)
}
