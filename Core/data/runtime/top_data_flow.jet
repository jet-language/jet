// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1607
#Derive(Clone, Copy)
enum JetDataExtreme { Min, Max }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1613
struct JetDataExtremeWatchSource<T, K> {
    source: Rc<DataWatchSource<T>>
    base: RefCell<[DataWatchEntry<T>]?>
    key: Arc<fn(T) -> K>
    extreme: JetDataExtreme
    operation: String
}
impl<T: Clone, K: Clone + PartialOrd> JetDataExtremeWatchSource<T, K> {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1624
    fn select(self, entries: &[DataWatchEntry<T>]) -> (K, U64) DataError! {
        selected := None
        loop entry in entries {
            candidate :: self.key(entry.value.clone())
            if !jet_data_extreme_key_finite(&candidate) {
                return Err(jet_data_error(DataErrorKind.NonFinite, self.operation, "extreme key must be finite"))
            }
            replace :: match &selected {
                None -> true
                Some((current, current_order)) -> {
                    ordering :: candidate.partial_cmp(current).ok_or_else(fn() {
                        jet_data_error(DataErrorKind.NonFinite, self.operation, "extreme key is not ordered")
                    })?
                    match self.extreme {
                        .Min -> ordering == Ordering.Less || (ordering == Ordering.Equal && entry.order < *current_order)
                        .Max -> ordering == Ordering.Greater || (ordering == Ordering.Equal && entry.order < *current_order)
                    }
                }
            }
            if replace -> selected = Some((^candidate, entry.order))
        }
        selected.ok_or_else(fn() { jet_data_error(DataErrorKind.Empty, self.operation, "empty query has no extreme") })
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1675
    fn materialize(self, materialized: DataWatchMaterialized<T>) -> DataWatchMaterialized<K> DataError! {
        (value, order) :: self.select(&materialized.entries)?
        Ok(DataWatchMaterialized{entries: [DataWatchEntry{order: order, key: None, value: ^value}],
            revision: materialized.revision, mode: materialized.mode, recomputed: materialized.recomputed,
            changed: materialized.changed, retained_rows: materialized.retained_rows})
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1695
impl<T: Clone, K: Clone + PartialOrd> JetDataExtremeWatchSource<T, K>.DataWatchSource<K> {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1698
    fn initial(self) -> DataWatchMaterialized<K> DataError! {
        materialized :: self.source.initial()?
        // GATE #4565: kernel primitive
        #Unsafe("retain original extreme input state through the native RefCell boundary") {
            *self.base.borrow_mut() = Some(materialized.entries.clone())
        }
        self.materialize(^materialized)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1704
    fn refresh(self, revision: U64, prior: &[DataWatchEntry<K>]) -> DataWatchMaterialized<K> DataError! {
        // GATE #4565: kernel primitive
        base :: #Unsafe("read the prior extreme source snapshot through native RefCell") { self.base.borrow().clone() }
            .ok_or_else(fn() { DataError.simple(DataErrorKind.State, "data.query.watch", "extreme watch was not initialized") })?
        materialized :: self.source.refresh(revision, &base)?
        if !materialized.changed && materialized.revision == revision {
            return Ok(DataWatchMaterialized{entries: prior.to_list(), revision: materialized.revision,
                mode: materialized.mode, recomputed: false, changed: false, retained_rows: materialized.retained_rows})
        }
        next_base :: materialized.entries.clone()
        output :: self.materialize(^materialized)?
        // GATE #4565: kernel primitive
        #Unsafe("commit extreme input state only after selecting a valid output key") { *self.base.borrow_mut() = Some(^next_base) }
        Ok(^output)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1734
fn jet_data_extreme_materialized<T: Clone, K: Clone + PartialOrd>(rows: [T], key: &fn(T) -> K, extreme: JetDataExtreme, operation: String) -> [K] DataError! {
    selected := None
    loop (order, row) in rows.into_iter().enumerate() {
        candidate :: key(^row)
        if !jet_data_extreme_key_finite(&candidate) {
            return Err(jet_data_error(DataErrorKind.NonFinite, operation, "extreme key must be finite"))
        }
        replace :: match &selected {
            None -> true
            Some((current, current_order)) -> {
                ordering :: candidate.partial_cmp(current).ok_or_else(fn() {
                    jet_data_error(DataErrorKind.NonFinite, operation, "extreme key is not ordered")
                })?
                match extreme {
                    .Min -> ordering == Ordering.Less || (ordering == Ordering.Equal && order as U64 < *current_order)
                    .Max -> ordering == Ordering.Greater || (ordering == Ordering.Equal && order as U64 < *current_order)
                }
            }
        }
        if replace -> selected = Some((^candidate, order as U64))
    }
    selected.map(fn((value, _)) { [^value] })
        .ok_or_else(fn() { jet_data_error(DataErrorKind.Empty, operation, "empty query has no extreme") })
}

