fn jet_data_query_group_by<T: Clone, K>(query: &DataQuery<T>, key: fn(T) -> K) -> DataGroupedQuery<T, K> {
    // GATE #4565: kernel primitive
    #Unsafe("retain one native shared callback for the grouped query without duplicating its source ownership") {
        DataGroupedQuery{query: query.clone(), key: Arc.new(^key)}
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:740
fn jet_data_group_sum_materialized<T: Clone, K: Clone + PartialEq, V: Clone + Add<Output=V>>(query: &DataQuery<T>, key: &fn(T) -> K, value: &fn(T) -> V DataError!) -> [GroupValue<K, V>] DataError! {
    rows :: jet_data_query_collect(query)?
    limits :: DataLimits.safe()
    groups := [(K, V)]{}
    loop row in rows {
        group_key :: key(row.clone())
        group_value :: value(row)?
        if Val((_, total)) :: groups.iter_mut().find(fn((existing, _)) { existing == &group_key }) {
            *total = total.clone() + ^group_value
        } else {
            if groups.len() as I64 >= limits.max_groups {
                return Err(jet_data_error(DataErrorKind.Limit, "query.group_by.sum", "max_groups {limits.max_groups} exceeded"))
            }
            groups.push((^group_key, ^group_value))
        }
    }
    if groups.len() as I64 > limits.max_output_rows {
        return Err(jet_data_error(DataErrorKind.Limit, "query.group_by.sum", "max_output_rows {limits.max_output_rows} exceeded"))
    }
    Ok(groups.into_iter().map(fn((key, value)) { GroupValue{key: ^key, value: ^value} }).collect())
}
