// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:59
fn jet_data_from_encoding(operation: String, row: JetOutcome<I64, JetAbsent>, enc: EncodingError) -> DataError {
    kind :: match enc.kind {
        .Limit -> DataErrorKind.Limit
        .IO -> DataErrorKind.IO
        .State -> DataErrorKind.State
        _ -> DataErrorKind.Decode
    }
    DataError{kind: kind, operation: operation, row: row.ok().map(fn(value) { Int{value} }),
        column: enc.column, index: None, reason: enc.reason.clone(), cause: Val(^enc)}
}
