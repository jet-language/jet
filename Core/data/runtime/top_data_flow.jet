// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:614
fn jet_data_query_filter<T: Clone>(query: &DataQuery<T>, predicate: fn(T) -> Bool) -> DataQuery<T> { query.filter(^predicate) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:624
fn jet_data_query_sort_by<T: Clone>(query: &DataQuery<T>, key: fn(T) -> String) -> DataQuery<T> { query.sort_by(^key) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:634
fn jet_data_query_apply_operations<T: Clone>(rows: &[T], operations: &[DataQueryOperation<T>], limits: &DataLimits) -> () DataError! {
    loop operation in operations {
        match operation {
            .Filter(predicate) -> rows.retain(fn(row) { predicate(row.clone()) })
            .SortBy(key) -> {
                if rows.len() as I64 > limits.max_sort_rows {
                    return Err(jet_data_error(DataErrorKind.Limit, "query.sort_by", "max_sort_rows {limits.max_sort_rows} exceeded"))
                }
                rows.sort_by_key(fn(row) { key(row.clone()) })
            }
        }
    }
    if rows.len() as I64 > limits.max_output_rows {
        return Err(jet_data_error(DataErrorKind.Limit, "query.collect", "max_output_rows {limits.max_output_rows} exceeded"))
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:666
fn jet_data_query_collect<T: Clone>(query: &DataQuery<T>) -> [T] DataError! {
    limits :: DataLimits.safe()
    if Val(rows_source) :: query.rows_frame() { return jet_data_collect_rows_checked(&rows_source, &limits) }
    if query.is_recomputed() {
        compute :: query.recomputation().ok_or_else(fn() {
            jet_data_error(DataErrorKind.State, "query.collect", "recomputable query has no producer")
        })?
        rows := compute?
        jet_data_query_apply_operations(&rows, &query.operations, &limits)?
        return Ok(^rows)
    }
    if query.is_computed() {
        compute :: query.take_computation().ok_or_else(fn() {
            jet_data_error(DataErrorKind.State, "query.collect", "query has already been collected")
        })?
        rows := compute()?
        jet_data_query_apply_operations(&rows, &query.operations, &limits)?
        return Ok(^rows)
    }
    Err(jet_data_error(DataErrorKind.State, "query.collect", "query source is unavailable"))
}
