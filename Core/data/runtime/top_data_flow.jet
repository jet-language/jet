// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:1338
fn jet_data_join_query<T: Clone, U: Clone, O: Clone>(left: &DataQuery<T>, right: &DataQuery<U>, left_key: fn(T) -> String, right_key: fn(U) -> String, kind: JetDataJoinKind, join: fn(T, U?) -> O, operation: String) -> DataQuery<O> {
