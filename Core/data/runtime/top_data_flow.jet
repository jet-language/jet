// Retain one deferred list query; never reopen the owned list.
fn jet_data_query<T: Clone>(rows: &[T]) -> DataQuery<T> {
    // GATE #4565: kernel primitive
    row_type :: #Unsafe("static native row type identity supplies checked compiler query metadata") { any.type_name<T>() }
    plan :: jet_table_plan_from_descriptors(row_type, &[], rows.len() as U128)
        .unwrap_or_else(fn(error) { panic("invalid compiler query metadata: {error}") })
    DataQuery.from_rows(rows.clone(), 0, ^plan)
}
