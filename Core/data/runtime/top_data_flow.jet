    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:251
fn jet_data_pivot_sum_checked<T: Clone>(rows: &[T], row_key: fn(T) -> String, col_key: fn(T) -> String, value: fn(T) -> F64, limits: &DataLimits) -> [DataPivotCell] DataError! {
    jet_data_limits_validate(limits)?
    plan :: jet_data_canonical_unary_plan<T>(JetTableOperation.Group, "pivot_sum", rows.len(), JetTableTypeId.new("DataPivotCell"), [
        JetTableColumn.new("row_key", JetTableTypeId.string()), JetTableColumn.new("column_key", JetTableTypeId.string()),
        JetTableColumn.new("count", JetTableTypeId.integer()), JetTableColumn.new("sum", JetTableTypeId.float()), JetTableColumn.new("mean", JetTableTypeId.float())
    ])?
    jet_data_plan_inspect(&plan, "pivot_sum")?
    keyed_rows :: rows.iter().cloned().map(fn(row) { (row_key(row.clone()), col_key(row.clone()), value(row)) }).collect()
    cells :: jet_data_pivot_sum_values(&keyed_rows, &jet_data_kernel_limits(limits.max_groups, limits.max_sort_rows, limits.max_join_rows, limits.max_output_rows))?
    Ok(cells.into_iter().map(fn(cell) {
        DataPivotCell{row_key: cell.row_key, column_key: cell.column_key, count: cell.count, sum: cell.sum, mean: cell.mean}
    }).collect())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:304
fn jet_data_pivot_sum_checked_default<T: Clone>(rows: &[T], row_key: fn(T) -> String, col_key: fn(T) -> String, value: fn(T) -> F64) -> [DataPivotCell] DataError! {
    jet_data_pivot_sum_checked(rows, ^row_key, ^col_key, ^value, &DataLimits.safe())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:327
fn jet_data_inner_join_checked<T: Clone, U: Clone>(left: &[T], right: &[U], left_key: fn(T) -> String, right_key: fn(U) -> String, limits: &DataLimits) -> [DataJoin<T, U>] DataError! {
    jet_data_limits_validate(limits)?
    plan :: jet_data_canonical_join_plan<T, U>("inner_join", JetTableJoinKind.Inner, left.len(), right.len())?
    jet_data_plan_inspect(&plan, "inner_join")?
    left_keys :: left.iter().cloned().map(fn(row) { left_key(row) }).collect()
    right_keys :: right.iter().cloned().map(fn(row) { right_key(row) }).collect()
    indices :: jet_data_join_indices(&left_keys, &right_keys, false,
        &jet_data_kernel_limits(limits.max_groups, limits.max_sort_rows, limits.max_join_rows, limits.max_output_rows))?
    joined := [DataJoin<T, U>].with_capacity(indices.len())
    loop index in indices {
        right_index :: index.right.ok_or_else(fn() { jet_data_error(DataErrorKind.State, "inner_join", "inner join kernel returned an absent right row") })?
        joined.push(DataJoin{left: left[index.left].clone(), right: right[right_index].clone()})
    }
    Ok(^joined)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:386
fn jet_data_inner_join_checked_default<T: Clone, U: Clone>(left: &[T], right: &[U], left_key: fn(T) -> String, right_key: fn(U) -> String) -> [DataJoin<T, U>] DataError! {
    jet_data_inner_join_checked(left, right, ^left_key, ^right_key, &DataLimits.safe())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:401
fn jet_data_left_join_checked<T: Clone, U: Clone>(left: &[T], right: &[U], left_key: fn(T) -> String, right_key: fn(U) -> String, limits: &DataLimits) -> [DataJoin<T, JetOutcome<U, JetAbsent>>] DataError! {
    jet_data_limits_validate(limits)?
    plan :: jet_data_canonical_join_plan<T, U>("left_join", JetTableJoinKind.Left, left.len(), right.len())?
    jet_data_plan_inspect(&plan, "left_join")?
    left_keys :: left.iter().cloned().map(fn(row) { left_key(row) }).collect()
    right_keys :: right.iter().cloned().map(fn(row) { right_key(row) }).collect()
    indices :: jet_data_join_indices(&left_keys, &right_keys, true,
        &jet_data_kernel_limits(limits.max_groups, limits.max_sort_rows, limits.max_join_rows, limits.max_output_rows))?
    Ok(indices.into_iter().map(fn(index) {
        DataJoin{left: left[index.left].clone(), right: index.right.map(fn(right_index) { right[right_index].clone() }).ok_or(JetAbsent{})}
    }).collect())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:455
fn jet_data_left_join_checked_default<T: Clone, U: Clone>(left: &[T], right: &[U], left_key: fn(T) -> String, right_key: fn(U) -> String) -> [DataJoin<T, JetOutcome<U, JetAbsent>>] DataError! {
