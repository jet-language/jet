// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3623
fn jet_data_loader_stream_from_payload<T>(loader: &DataLoader<T>, payload: [U8]) -> DataStream DataError! {
    tree :: match jet_data_loader_tree(&payload, loader.format, &loader.limits) {
        Ok(tree) -> ^tree
        Err(error) -> return Err(jet_data_loader_fail(loader, ^error))
    }
    rows :: match tree { DataTree.Array(rows) -> ^rows, value -> [^value] }
    if I64{rows.len()} > loader.limits.max_output_rows {
        return Err(jet_data_loader_fail(loader, jet_data_loader_error(DataErrorKind.Limit, "data.loader.stream", "max_output_rows {loader.limits.max_output_rows} exceeded")))
    }
    stream :: DataStream{inner: DataStreamInner.Provider{format: loader.format, rows: ^rows, cursor: 0}, limits: loader.limits.clone(), terminal: None, eof: false, row_index: 0, cancelled: false}
    loader.status.buffered_bytes = I64.try_from(payload.len()).unwrap_or(I64.MAX)
    loader.status.backpressure = loader.status.buffered_bytes > loader.limits.encoding.buffer_bytes
    Ok(^stream)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3663
fn jet_data_loader_stream<R: __jet_Decode, T>(loader: &DataLoader<T>) -> DataStream DataError! {
    if loader.cancelled { return Err(jet_data_loader_error(DataErrorKind.State, "data.loader.stream", "loader was cancelled")) }
    kernel_state :: jet_data_loader_kernel_state(loader)
    payload :: match PreludeDataFlow.payload(&kernel_state) {
        Ok(Val((payload, _offline))) -> Val(^payload)
        Ok(None) -> None
        Err(error) -> return Err(jet_data_loader_fail(loader, jet_data_loader_kernel_error(^error)))
    }
    if Val(payload) :: payload { return jet_data_loader_stream_from_payload(loader, ^payload) }
    if loader.format == DataFormat.Parquet {
        payload :: match jet_data_loader_payload(loader) {
            Ok((payload, _offline)) -> ^payload
            Err(error) -> return Err(jet_data_loader_fail(loader, ^error))
        }
        return jet_data_loader_stream_from_payload(loader, ^payload)
    }
    if loader.source.kind != DataLoaderKind.File || !loader.source.member.is_empty() {
        return Err(jet_data_loader_fail(loader, jet_data_loader_error(DataErrorKind.Bridge, "data.loader.stream", "provider-owned sources must expose a bounded DataStream directly")))
    }
    raw_locator :: loader.raw_locator.clone()
    source_locator :: loader.source.locator.clone()
    // GATE #4565: kernel primitive
    file :: #Unsafe("open the loader's retained OS path as an owned read handle; preserve native IO errors") {
        File.open(&raw_locator).map_err(fn(error) { jet_data_loader_error(DataErrorKind.IO, "data.loader.stream", "could not open `{source_locator}`: {error}") })
    }
    file :: match file { Ok(file) -> ^file, Err(error) -> return Err(jet_data_loader_fail(loader, ^error)) }
    // GATE #4565: kernel primitive
    input :: #Unsafe("move the open file into its single buffered reader owner") { JetFileReader{inner: BufReader.new(^file), path: ^raw_locator} }
    stream :: match loader.format {
        DataFormat.CSV -> jet_data_csv_reader<R>(^input, loader.limits.clone())
        DataFormat.JSON -> jet_data_json_reader<R>(^input, loader.limits.clone())
        DataFormat.JSONL -> jet_data_jsonl_reader(^input, loader.limits.clone())
        DataFormat.Parquet -> panic("Parquet payload handled before file stream")
        DataFormat.Arrow -> Err(jet_data_loader_error(DataErrorKind.Bridge, "data.loader.stream", "Arrow IPC has a separate provider boundary; Parquet is the registered reader"))
    }
    stream :: match stream { Ok(stream) -> ^stream, Err(error) -> return Err(jet_data_loader_fail(loader, ^error)) }
    loader.status.buffered_bytes = 0
    loader.status.backpressure = false
    Ok(^stream)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:3741
fn jet_data_stream_cancel(stream: &DataStream) -> () {
    stream.cancelled = true
    if stream.terminal.is_none() { stream.terminal = Val(jet_data_error(DataErrorKind.State, "data.stream", "stream was cancelled")) }
}
