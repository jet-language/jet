}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataFlow.rs:5023
fn jet_enc_csv_query<T: __jet_Decode + __jet_Encode + Clone>(path: &String, sql: &String) -> DataQuery<T> [FieldError]! {
    text :: jet_data_query_read(path)?
    csv_rows :: jet_ring_csv_parse(&text, ",", false, false).map_err(FieldError.one)?
    header :: csv_rows.first().cloned().unwrap_or_default()
    jet_data_query_validate_fields(&header, sql)?
    rows :: jet_enc_csv_decode<T>(&text)?
    jet_data_query_sql(&rows, sql)
}

