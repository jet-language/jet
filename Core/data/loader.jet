use core as core
use core.data.[DataAuthority, DataError, DataErrorKind, DataFormat, DataFreshness, DataInvalidationCause, DataLoader, DataLoaderKind, DataLoaderStatus, DataSnapshotIdentity, DataSourceIdentity, DataStream]

fn loader_error(kind: DataErrorKind, reason: String, operation: String) -> DataError !Never {
    DataError{
        kind: kind,
        operation: operation,
        row: None,
        column: None,
        index: None,
        reason: reason,
        cause: None,
    }
}

// core.data.loader — lifecycle for a typed, provider-owned DataLoader<T>.
//
// Payload bytes are a pending input until snapshot/stream validation commits
// them.  `last_good` is only changed by that commit, so bind/invalidate can
// retain a known snapshot without falsely reporting a fresh one.

pub fn bind<T>(loader: &DataLoader<T>, payload: [U8]) !DataError {
    if loader.cancelled -> return Err(loader_error(DataErrorKind.State, "loader was cancelled", source_path<T>(loader)))
    if !accepts_payload<T>(loader) {
        return Err(loader_error(
            DataErrorKind.InvalidArgument,
            "only URL, database, or archive-member loaders accept provider payloads",
            "data.loader.bind"
        ))
    }
    bytes := payload.len()
    if bytes > loader.limits.encoding.max_item_bytes {
        return Err(loader_error(DataErrorKind.Limit, "payload exceeds max_item_bytes", "data.loader.bind"))
    }
    if loader.limits.encoding.max_total_bytes != None {
        total :: loader.limits.encoding.max_total_bytes ?? 0
        if bytes > total {
            return Err(loader_error(DataErrorKind.Limit, "payload exceeds max_total_bytes", "data.loader.bind"))
        }
    }
    bound := copy_bytes(payload)
    loader.payload = Val(bound)
    loader.status.freshness = DataFreshness.Pending
    loader.status.error = ""
    loader.status.cleanup = if loader.last_good != None -> "retained" else -> "none"
    loader.status.buffered_bytes = bytes
    loader.status.backpressure = bytes > loader.limits.encoding.buffer_bytes
    loader.status.last_good = loader.last_good != None
    return
}

pub fn bind_text<T>(loader: &DataLoader<T>, text: String) !DataError {
    bind<T>(&loader, text.bytes())
}

pub fn authority<T>(loader: DataLoader<T>) -> DataAuthority { ~loader.authority }

pub fn status<T>(loader: DataLoader<T>) -> DataLoaderStatus { ~loader.status }

pub fn ready<T>(loader: DataLoader<T>) -> Bool {
    !loader.cancelled && !loader.status.backpressure
}

pub fn needs_refresh<T>(loader: DataLoader<T>) -> Bool {
    if loader.status.freshness == DataFreshness.Fresh
        || loader.status.freshness == DataFreshness.Offline
        || loader.status.freshness == DataFreshness.Cancelled {
        return false
    }
    true
}

pub fn snapshot_reusable(previous: DataSnapshotIdentity, current: DataSnapshotIdentity) -> Bool {
    previous.id == current.id
        && previous.source == current.source
        && previous.content == current.content
        && previous.schema == current.schema
        && previous.format == current.format
}

pub fn source_identity<T>(loader: DataLoader<T>) -> DataSourceIdentity { ~loader.source }

pub fn cancel<T>(loader: &DataLoader<T>) {
    loader.cancelled = true
    if loader.source.kind != DataLoaderKind.Value -> loader.payload = None
    loader.status.freshness = DataFreshness.Cancelled
    loader.status.error = "loader was cancelled"
    if loader.source.kind == DataLoaderKind.Value -> loader.status.cleanup = "retained" else -> loader.status.cleanup = "payload-released"
    loader.status.buffered_bytes = 0
    loader.status.backpressure = false
    loader.status.last_good = loader.last_good != None
}

pub fn offline<T>(loader: &DataLoader<T>, enabled: Bool) {
    loader.offline = enabled
    if enabled {
        if loader.payload == None && loader.last_good != None {
            loader.status.freshness = DataFreshness.Offline
        }
        return
    }
    if loader.status.freshness != DataFreshness.Offline -> return
    if loader.payload != None {
        loader.status.freshness = DataFreshness.Pending
    } else if loader.last_good != None && loader.status.invalidated_by == DataInvalidationCause.NoCause {
        loader.status.freshness = DataFreshness.Fresh
    } else if loader.last_good != None {
        loader.status.freshness = DataFreshness.Stale
    } else {
        loader.status.freshness = DataFreshness.Pending
    }
}

pub fn invalidate<T>(loader: &DataLoader<T>, cause: DataInvalidationCause) {
    loader.status.invalidated_by = ~cause
    loader.status.freshness = DataFreshness.Stale
    loader.status.error = ""
    if loader.source.kind != DataLoaderKind.Value -> loader.payload = None
    loader.status.cleanup = if loader.last_good != None -> "retained" else -> "none"
    loader.status.buffered_bytes = 0
    loader.status.backpressure = false
    loader.status.last_good = loader.last_good != None
}

pub fn stream<T: Decode>(loader: DataLoader<T>) -> DataStream<T> !DataError {
    if loader.cancelled -> return Err(loader_error(DataErrorKind.State, "loader stream was cancelled", source_path<T>(loader)))
    bytes_opt := loader.payload
    if bytes_opt == None && loader.offline -> bytes_opt = loader.last_good
    bytes :: bytes_opt ?? return Err(loader_error(DataErrorKind.State, "loader has no bound payload", source_path<T>(loader)))
    text :: String.from_bytes(bytes) ?? return Err(loader_error(DataErrorKind.Decode, "loader payload is not UTF-8", source_path<T>(loader)))
    rows := [T]{}
    if loader.format == DataFormat.CSV {
        rows = core.data.csv<T>(text) ?? return Err(loader_error(DataErrorKind.Decode, "CSV stream decode failed", source_path<T>(loader)))
    } else if loader.format == DataFormat.JSON {
        rows = core.data.json<T>(text) ?? return Err(loader_error(DataErrorKind.Decode, "JSON stream decode failed", source_path<T>(loader)))
    } else if loader.format == DataFormat.JSONL {
        rows = decode_jsonl<T>(text) ?? return Err(loader_error(DataErrorKind.Decode, "JSONL stream decode failed", source_path<T>(loader)))
    } else {
        return Err(loader_error(DataErrorKind.Bridge, "provider-backed stream is required for this format", source_path<T>(loader)))
    }
    if rows.len() > loader.limits.max_output_rows {
        return Err(loader_error(DataErrorKind.Limit, "max_output_rows exceeded", "data.loader.stream"))
    }
    core.data.stream.from_items<T>(&rows)
}

fn accepts_payload<T>(loader: DataLoader<T>) -> Bool !Never {
    if loader.source.kind == DataLoaderKind.URL || loader.source.kind == DataLoaderKind.Database -> return true
    loader.source.kind == DataLoaderKind.File && loader.source.member.len() > 0
}

fn decode_jsonl<T: Decode>(text: String) -> [T] !DataError {
    out := [T]{}
    raw := text.bytes()
    start := 0
    loop i in 0..<(raw.len() + 1) {
        if i < raw.len() && raw[i] != (U8{10}) -> next
        end := i
        if end > start && raw[end - 1] == (U8{13}) -> end = end - 1
        if end > start {
            line_bytes := raw[start..(end - 1)]
            line :: String.from_bytes(line_bytes) ?? return Err(loader_error(DataErrorKind.Decode, "JSONL row is not UTF-8", "data.loader.stream"))
            if !blank(line) {
                wrapped := "[{line}]"
                row :: core.data.json<T>(wrapped) ?? return Err(loader_error(DataErrorKind.Decode, "JSONL row decode failed", "data.loader.stream"))
                if row.len() != 1 -> return Err(loader_error(DataErrorKind.Decode, "JSONL row did not decode to one value", "data.loader.stream"))
                out.push(~row[0])
            }
        }
        start = i + 1
    }
    Ok(out)
}

fn blank(text: String) -> Bool !Never {
    if text.len() == 0 -> return true
    loop byte in text.bytes() {
        if byte != (U8{32}) && byte != (U8{9}) -> return false
    }
    true
}

fn source_path<T>(loader: DataLoader<T>) -> String !Never { loader.source.locator }

fn copy_bytes(bytes: [U8]) -> [U8] !Never {
    out := [U8]{}
    loop byte in bytes -> out.push(byte)
    out
}
