// Reservoir sample (Algorithm R).
//
// `add` updates the sample in place through a write receiver. Replacement
// draws come from a SplitMix64 stream carried in the value and seeded by
// `new`, so replaying a stream produces the same sample on every tier.
C_DEFAULT_K :: 32
C_INT_MAX :: 9223372036854775807

pub struct Reservoir {
    pub k: Int
    pub seen: Int
    pub items: [String]
    state: U64
}

pub fn new(k: Int{C_DEFAULT_K}) -> Reservoir Never! {
    capacity := k
    if capacity < 1 -> capacity = 1
    Reservoir{k: capacity, seen: 0, items: [String]{}, state: U64{0}}
}

impl Reservoir {
    /// Offer one item; every item seen so far is kept with equal probability.
    pub fn add(&self, item: String) Never! {
        if self.k < 1 -> self.k = 1
        if self.seen < self.items.len() -> self.seen = self.items.len()
        if self.seen < C_INT_MAX -> self.seen = self.seen + 1
        if self.items.len() < self.k {
            &self.items.push(item)
            return
        }
        self.state = self.state.wrapping_add(U64{11400714819323198485})
        z := (self.state ~| (self.state >> 30)).wrapping_mul(U64{13787848793156543929})
        z = (z ~| (z >> 27)).wrapping_mul(U64{10723151780598845931})
        z = z ~| (z >> 31)
        index :: Int.from_u64(z >> 1) %% self.seen
        if index < self.k -> self.items[index] = item
    }

    /// The current sample, in slot order.
    pub fn sample(self) -> [String] Never! {
        out := [String]{}
        loop item in self.items -> &out.push(item)
        out
    }
}
