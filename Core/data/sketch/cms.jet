// The shipped width-256/depth-4 count-min sketch. Seeded FNV hashing and
// unit increments live in Jet; shared storage retains native alias semantics.
use core.data.sketch as sketch

pub struct CountMinSketch {
    counters: Shared<[Int]>

    impl Display {
        fn display(self) -> String { "CountMinSketch" }
    }
}

pub fn new() -> CountMinSketch Never! { CountMinSketch.new() }

impl CountMinSketch {
    pub fn new() -> CountMinSketch Never! {
        counters := [Int]{}
        loop _ in 0..<1024 -> &counters.push(0)
        CountMinSketch{counters: shared ^counters}
    }

    pub fn add(self, key: String) Never! {
        (first, second) :: hashes(key)
        guard := self.counters.guard_edit()
        loop row in 0..<4 {
            index :: counter_index(first, second, row)
            if guard.value[index] < 4294967295 -> guard.value[index] = guard.value[index] + 1
        }
    }

    pub fn count(self, key: String) -> Int Never! {
        (first, second) :: hashes(key)
        guard :: self.counters.guard_read()
        count := guard.value[counter_index(first, second, 0)]
        loop row in 1..<4 {
            value :: guard.value[counter_index(first, second, row)]
            if value < count -> count = value
        }
        count
    }
}

fn hashes(key: String) -> (first: U64, second: U64) Never! {
    seed :: U64{14695981039346656037}
    (first: sketch.__fnv1a64(key, seed), second: sketch.__fnv1a64(key, seed.wrapping_add(U64{3735928559})))
}

fn counter_index(first: U64, second: U64, row: Int) -> Int Never! {
    column :: first.wrapping_add(second.wrapping_mul(U64{row + 1})) & U64{255}
    row * 256 + Int.from_u64(column)
}

/// Merge by adding corresponding counters, as the existing source API does.
/// Separate read scopes also permit merging two aliases of the same sketch.
pub fn merge(a: CountMinSketch, b: CountMinSketch) -> CountMinSketch Never! {
    counters := copy_counters(a)
    guard :: b.counters.guard_read()
    loop i in 0..<1024 -> counters[i] = counters[i] + guard.value[i]
    CountMinSketch{counters: shared ^counters}
}

fn copy_counters(value: CountMinSketch) -> [Int] Never! {
    guard :: value.counters.guard_read()
    ~guard.value
}

#Test("CMS retains unit counts, aliases and additive merge") {
    cms :: new()
    alias :: ~cms
    cms.add("hello")
    alias.add("hello")
    cms.add("world")
    assert_eq(cms.count("hello"), 2)
    assert_eq(cms.count("absent"), 0)
    combined :: merge(cms, alias)
    assert_eq(combined.count("hello"), 4)
}
