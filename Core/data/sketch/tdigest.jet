use core.math as math

// Deterministic weighted t-digest.  Centroids stay sorted by (mean, weight)
// and are compressed in that order, so the result does not depend on hash
// iteration or provider row order.  `add` updates the digest in place
// through a write receiver.
pub struct TDigest {
    pub delta: Float
    pub means: [Float]
    pub weights: [Float]
    pub total: Float
}

pub struct Centroid {
    pub mean: Float
    pub weight: Float
}

pub fn new() -> TDigest Never! {
    {delta: Float{100.0}, means: [Float]{}, weights: [Float]{}, total: Float{0.0}}
}

impl TDigest {
    /// Record one finite sample with a positive weight (1.0 by default).
    pub fn add(&self, x: Float, w: Float{1.0}) Never! {
        if !math.is_finite(x) || !math.is_finite(w) || w <= (Float{0.0}) -> return
        if !digest_shape_ok(self) {
            self.means = [Float]{}
            self.weights = [Float]{}
            self.total = Float{0.0}
        }
        if !math.is_finite(self.delta) || self.delta <= (Float{0.0}) -> self.delta = Float{100.0}
        total :: self.total + w
        if !math.is_finite(total) -> return
        &self.means.push(x)
        &self.weights.push(w)
        insert_sorted(&self.means, &self.weights)
        self.total = total
        if self.means.len() > 64 {
            packed :: compress(self.means, self.weights, self.delta, total)
            self.means = packed.means
            self.weights = packed.weights
        }
    }

    /// The interpolated value at quantile `q` in `0.0..=1.0`.
    pub fn quantile(self, q: Float) -> Float Never! { digest_quantile(self, q) }
}

fn digest_quantile(td: TDigest, q: Float) -> Float Never! {
    if !digest_shape_ok(td) || td.total <= (Float{0.0}) -> return Float{0.0}
    if !math.is_finite(q) -> return Float{0.0}
    if q <= (Float{0.0}) -> return td.means[0]
    if q >= (Float{1.0}) -> return td.means[td.means.len() - 1]

    // Interpolate between centroid centers rather than returning a step
    // function.  This keeps one-point and weighted samples exact while
    // making the result useful between centroids.
    target :: q * td.total
    cumulative := Float{0.0}
    previous_center := Float{0.0}
    loop i in 0..<td.means.len() {
        w :: td.weights[i]
        center :: cumulative + w / (Float{2.0})
        if target <= center {
            if i == 0 || center <= previous_center -> return td.means[i]
            fraction :: (target - previous_center) / (center - previous_center)
            return td.means[i - 1] + (td.means[i] - td.means[i - 1]) * fraction
        }
        cumulative = cumulative + w
        previous_center = center
    }
    td.means[td.means.len() - 1]
}

pub struct Packed {
    pub means: [Float]
    pub weights: [Float]
}

fn compress(means: [Float], weights: [Float], delta: Float, total: Float) -> Packed {
    if means.len() == 0 -> return Packed{means: [Float]{}, weights: [Float]{}}
    if delta <= (Float{0.0}) || total <= (Float{0.0}) -> return Packed{means: copy_floats(means), weights: copy_floats(weights)}
    om := [Float]{means[0]}
    ow := [Float]{weights[0]}
    cumulative := weights[0]
    loop i in 1..<means.len() {
        // t-digest's scale is smallest at the tails and largest near the
        // median.  A minimum capacity of one keeps tiny samples alive.
        q :: (cumulative - ow[ow.len() - 1] / (Float{2.0})) / total
        cap := total * (Float{4.0}) * q * ((Float{1.0}) - q) / delta
        if cap < (Float{1.0}) -> cap = Float{1.0}
        candidate :: ow[ow.len() - 1] + weights[i]
        if candidate <= cap {
            old_weight :: ~ow[ow.len() - 1]
            ow[ow.len() - 1] = candidate
            om[om.len() - 1] = (om[om.len() - 1] * old_weight + means[i] * weights[i]) / candidate
        } else {
            &om.push(means[i])
            &ow.push(weights[i])
        }
        cumulative = cumulative + weights[i]
    }
    Packed{means: om, weights: ow}
}

fn insert_sorted(means: &[Float], weights: &[Float]) {
    i := 1
    loop i < means.len() {
        j := i
        loop {
            if j <= 0 -> break
            if means[j - 1] < means[j] -> break
            if means[j - 1] == means[j] && weights[j - 1] <= weights[j] -> break
            tm :: ~means[j]
            means[j] = means[j - 1]
            means[j - 1] = tm
            tw :: ~weights[j]
            weights[j] = weights[j - 1]
            weights[j - 1] = tw
            j = j - 1
        }
        i = i + 1
    }
}

fn copy_floats(values: [Float]) -> [Float] {
    out := [Float]{}
    loop value in values -> &out.push(value)
    out
}

fn digest_shape_ok(td: TDigest) -> Bool {
    if td.means.len() == 0 || td.means.len() != td.weights.len() -> return false
    if !math.is_finite(td.delta) || td.delta <= (Float{0.0}) -> return false
    if !math.is_finite(td.total) || td.total <= (Float{0.0}) -> return false
    sum := Float{0.0}
    loop i in 0..<td.means.len() {
        if !math.is_finite(td.means[i]) || !math.is_finite(td.weights[i]) || td.weights[i] <= (Float{0.0}) -> return false
        if i > 0 && td.means[i] < td.means[i - 1] -> return false
        sum = sum + td.weights[i]
    }
    if !math.is_finite(sum) || sum <= (Float{0.0}) -> return false
    difference :: math.fabs(sum - td.total)
    scale := math.fabs(td.total)
    if scale < (Float{1.0}) -> scale = Float{1.0}
    difference <= Float{0.000000001} * scale
}
