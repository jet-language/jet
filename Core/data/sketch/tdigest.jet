// t-digest (Dunning). Centroids clustered by a scale of 100.
pub struct TDigest {
    pub delta: Float
    pub means: [Float]
    pub weights: [Float]
    pub total: Float
}

pub struct Centroid {
    pub mean: Float
    pub weight: Float
}

pub fn new() -> TDigest { {delta: 100.0, means: [Float]{}, weights: [Float]{}, total: 0.0} }

pub fn add(td: TDigest, x: Float, w: Float) -> TDigest {
    means := [Float]{}
    weights := [Float]{}
    loop m in td.means -> means.push(m)
    loop n in td.weights -> weights.push(n)
    means.push(x)
    weights.push(w)
    total := td.total + w
    // compress if too many centroids
    if means.len() > 64 {
        c :: compress(means, weights, td.delta, total)
        return {delta: td.delta, means: c.means, weights: c.weights, total: total}
    }
    {delta: td.delta, means: means, weights: weights, total: total}
}

pub fn quantile(td: TDigest, q: Float) -> Float {
    if td.means.len() == 0 -> return 0.0
    if q <= 0.0 -> return td.means[0]
    if q >= 1.0 -> return td.means[td.means.len() - 1]
    target :: q * td.total
    acc := 0.0
    loop i in 0..<td.means.len() {
        acc = acc + td.weights[i]
        if acc >= target -> return td.means[i]
    }
    td.means[td.means.len() - 1]
}

pub struct Packed {
    pub means: [Float]
    pub weights: [Float]
}

fn compress(means: [Float], weights: [Float], delta: Float, total: Float) -> Packed {
    // sort by mean (insertion)
    n :: means.len()
    loop i in 1..<n {
        j := i
        loop {
            if j <= 0 || means[j - 1] <= means[j] -> break
            tm :: means[j]
            means[j] = means[j - 1]
            means[j - 1] = tm
            tw :: weights[j]
            weights[j] = weights[j - 1]
            weights[j - 1] = tw
            j = j - 1
        }
    }
    om := [Float]{means[0]}
    ow := [Float]{weights[0]}
    acc := weights[0]
    loop i in 1..<n {
        // merge if the running quantile bin is small
        cap :: total / delta
        if ow[ow.len() - 1] + weights[i] <= cap {
            w :: ow[ow.len() - 1] + weights[i]
            m :: (om[om.len() - 1] * ow[ow.len() - 1] + means[i] * weights[i]) / w
            om[om.len() - 1] = m
            ow[ow.len() - 1] = w
        } else {
            om.push(means[i])
            ow.push(weights[i])
        }
        acc = acc + weights[i]
    }
    {means: om, weights: ow}
}
