// The shipped 256-register HyperLogLog, with one shared source carrier.
use core.math as math
use core.data.sketch as sketch

pub struct HyperLogLog {
    registers: Shared<[U8]>

    impl Display {
        fn display(self) -> String Never! { "HyperLogLog(count={self.count()})" }
    }
}

pub fn new() -> HyperLogLog Never! { HyperLogLog.new() }

impl HyperLogLog {
    pub fn new() -> HyperLogLog Never! {
        registers := [U8]{}
        loop _ in 0..<256 -> &registers.push(U8{0})
        HyperLogLog{registers: shared ^registers}
    }

    pub fn add(self, key: String) Never! {
        hash :: sketch.__fnv1a64(key, U64{14695981039346656037})
        index :: Int.from_u64(hash & U64{255})
        rest :: hash >> 8
        zeros :: if rest == (U64{0}) -> 57 else -> rest.leading_zeros() + 1
        guard :: self.registers.guard_edit()
        if zeros > Int.from_u8(guard.value[index]) -> guard.value[index] = U8{zeros}
    }

    pub fn count(self) -> Int Never! {
        guard :: self.registers.guard_read()
        empty := 0
        loop register in guard.value {
            if register == (U8{0}) -> empty = empty + 1
        }
        width :: Float{256.0}
        if empty > 0 -> return rounded_count(width * math.ln(width / Float{empty}))
        sum := Float{0.0}
        loop register in guard.value {
            sum = sum + math.from_bits((1023 - Int.from_u8(register)) << 52)
        }
        alpha :: Float{0.7213} / (Float{1.0} + Float{1.079} / width)
        rounded_count(alpha * width * width / sum)
    }
}

fn rounded_count(estimate: Float) -> Int Never! {
    if estimate >= (Float{9223372036854775807}) -> return 9223372036854775807
    math.round(estimate)
}

#Test("HLL preserves shipped distinct counts and shared updates") {
    hll :: new()
    assert_eq(hll.count(), 0)
    alias :: ~hll
    alias.add("apple")
    hll.add("banana")
    hll.add("cherry")
    hll.add("apple")
    assert_eq(alias.count(), 3)
}
