// HyperLogLog with 256 eight-bit registers.
//
// The register layout is deliberately the same as the native sketch carrier:
// `m` is the register count and `regs` stores one bounded rho value per
// register.  `add` updates the registers in place through a write receiver,
// so a stream of updates never copies the register table.
use core.math as math

C_REGISTERS :: 256
C_MAX_RHO :: 57


pub struct HLL {
    pub m: Int
    pub regs: [Int]
}

pub fn new() -> HLL Never! {
    HLL{m: C_REGISTERS, regs: zero_registers(C_REGISTERS)}
}

impl HLL {
    /// Record one key.
    pub fn add(&self, key: String) Never! {
        width := hll_width(self)
        if width <= 0 -> width = C_REGISTERS
        if self.m != width || self.regs.len() != width {
            self.regs = normalize_registers(self.regs, width)
            self.m = width
        }
        hash :: hash64(key)
        index :: register_index(hash, width)
        rest :: hash >> 8
        rho := C_MAX_RHO
        if rest != (U64{0}) -> rho = rest.leading_zeros() + 1
        if rho > self.regs[index] -> self.regs[index] = rho
    }

    /// The estimated number of distinct keys.
    pub fn count(self) -> Int Never! { hll_estimate(self) }
}

fn hll_estimate(hll: HLL) -> Int Never! {
    width :: hll_width(hll)
    if width <= 0 -> return 0
    regs :: normalize_registers(hll.regs, width)
    zero := 0
    sum := Float{0.0}
    loop r in regs {
        if r == 0 -> zero = zero + 1
        power := Float{1.0}
        loop _ in 0..<r -> power = power * Float{0.5}
        sum = sum + power
    }
    if zero > 0 {
        estimate :: Float{width} * math.ln(Float{width} / Float{zero})
        if estimate <= (Float{0.0}) -> return 0
        return Int{estimate + Float{0.5}}
    }
    if sum <= (Float{0.0}) -> return 0
    width_f :: Float{width}
    estimate :: Float{0.7213} / (Float{1.0} + Float{1.079} / width_f) * width_f * width_f / sum
    if estimate <= (Float{0.0}) -> return 0
    Int{estimate + Float{0.5}}
}

fn hash64(key: String) -> U64 {
    hash := U64{14695981039346656037}
    prime :: U64{1099511628211}
    loop byte in key.bytes() -> hash = (hash ~| U64.from_u8(byte)).wrapping_mul(prime)
    hash
}

fn register_index(hash: U64, width: Int) -> Int {
    if width <= 1 -> return 0
    if (width & (width - 1)) == 0 -> return Int.from_u64(hash & U64{width - 1})
    Int.from_u64(hash %% U64{width})
}

fn hll_width(hll: HLL) -> Int {
    if hll.m <= 0 || hll.regs.len() == 0 -> return 0
    width := hll.m
    if width > hll.regs.len() -> width = hll.regs.len()
    if width > C_REGISTERS -> width = C_REGISTERS
    width
}

fn zero_registers(width: Int) -> [Int] {
    out := [Int]{}
    if width <= 0 -> return out
    loop _ in 0..<width -> &out.push(0)
    out
}

fn normalize_registers(values: [Int], width: Int) -> [Int] {
    out := [Int]{}
    if width <= 0 -> return out
    loop i in 0..<width {
        value := 0
        if i < values.len() -> value = values[i]
        if value < 0 -> value = 0
        if value > 255 -> value = 255
        &out.push(value)
    }
    out
}

fn merge(a: HLL, b: HLL) -> HLL {
    aw :: hll_width(a)
    bw :: hll_width(b)
    if aw <= 0 -> return canonical(b)
    if bw <= 0 -> return canonical(a)
    width := aw
    if bw < width -> width = bw
    ar :: normalize_registers(a.regs, width)
    br :: normalize_registers(b.regs, width)
    regs := [Int]{}
    loop i in 0..<width {
        value := ar[i]
        if br[i] > value -> value = br[i]
        &regs.push(value)
    }
    HLL{m: width, regs: regs}
}

fn cardinality(hll: HLL) -> Int { hll_estimate(hll) }

fn canonical(hll: HLL) -> HLL {
    width :: hll_width(hll)
    if width <= 0 -> return HLL{m: 0, regs: [Int]{}}
    HLL{m: width, regs: normalize_registers(hll.regs, width)}
}
