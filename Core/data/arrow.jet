use core as core

use core.data.[DataError, Query]


// core.data.arrow — one checked owner for a foreign Arrow batch.
//
// Arrow's C data interface and Arrow IPC files are different contracts.  The
// C-data owner is carried by DataArrowBatch<T>; the provider owns validation
// and release, while this source-level adapter only preserves that owner.
// There is deliberately no path/String fallback here: an IPC reader would
// need its own format validator and bounded buffer owner.
pub struct DataArrowBatch<T> {}

/// Import is an ownership-preserving move.  The checked provider has already
/// validated the foreign buffers before this value reaches Jet.
pub fn import<T>(batch: ^DataArrowBatch<T>) -> DataArrowBatch<T> { batch }

/// Query execution is delegated to the checked provider row adapter. The
/// provider enforces bounded output and converts owned rows into the canonical
/// deferred `Query<T>` carrier before returning.
pub fn query<T>(batch: DataArrowBatch<T>) -> Query<T> !DataError {
    core.data.arrow.query(^batch)
}
