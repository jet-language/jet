package {
    name: "core.data"
    version: "0.1.0"
    edition: "2026"
    description: "Tabular data, loaders, sketches, and plots."
    license: "MIT"
    outputs: {
        data: .Library{ entry: data }
    }
}
// core.data — column-oriented snapshots over text cells.
//
// A snapshot is an in-memory table: named columns of equal length, a schema
// and a source identity. Codecs (`csv`, `json`) parse bytes the caller already
// holds. `file` / `url` / `database` are loaders; `load` is the host door.
// Joins, aggregates, and pivots are Jet. Nested `plot` owns chart types;
// this file re-declares the same names so `core.data` matches the live export
// table. Nested `loader` / `stream` / `arrow` / `sketch` stay their own rings.
module arrow

module loader

module stream

module plot

module sketch

pub enum DataFormat {
    Csv
    Json
    Jsonl
    Arrow
    Unknown
}

pub enum DataErrorKind {
    Syntax
    Missing
    Type
    Limit
    IO
    Unsupported
}

#Error
pub struct DataError {
    pub kind: DataErrorKind
    pub message: String
    pub path: String
}

