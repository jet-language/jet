#Equatable
pub enum DataFormat {
    CSV
    JSON
    JSONL
    Parquet
    Arrow
}


pub enum DataErrorKind {
    Decode
    Limit
    IO
    Empty
    InvalidArgument
    NonFinite
    Overflow
    State
    Bridge
    Unsupported
    DuplicateKey
    MissingKey
    WrongOwner
    StaleRevision
    InvalidValue
}

#Error
pub struct DataError {
    pub kind: DataErrorKind
    pub operation: String
    pub row: Int?
    pub column: Int?
    pub index: Int?
    pub reason: String
    pub cause: EncodingError?
}

impl DataError {
    pub fn new(kind: DataErrorKind, message: String, path: String) -> DataError Never! {
        return DataError{
            kind: kind,
            operation: ~path,
            row: None,
            column: None,
            index: None,
            reason: message,
            cause: None,
        }
    }
}
fn data_error(kind: DataErrorKind, message: String, operation: String) -> DataError Never! {
    DataError{
        kind: kind,
        operation: operation,
        row: None,
        column: None,
        index: None,
        reason: message,
        cause: None,
    }
}

fn data_error_at(kind: DataErrorKind, message: String, operation: String, index: Int) -> DataError Never! {
    DataError{
        kind: kind,
        operation: operation,
        row: None,
        column: None,
        index: Val(index),
        reason: message,
        cause: None,
    }
}

fn nonfinite(value: Float) -> Bool Never! {
    if math.is_finite(value) -> return false
    true
}


