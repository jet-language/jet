    assert(JetDataPlotBackend.Browser.as_str() == "browser")
    assert(JetDataPlotSupport.Degraded.as_str() == "degraded")
}

fn data_query_revision_contract() Never! {
    state :: shared Int{0}
    initial :: state.capture()
    assert(core.mem.__shared_revision<Int>(state) == 0)
    assert(core.mem.__snapshot_revision<Int, Int>(initial) == 0)
    if state.try_replace(^initial, 1) == {
        .Ok(published) -> assert(published)
        .Err(_) -> assert(false)
    }
    assert(core.mem.__shared_revision<Int>(state) == 1)
    next_ticket :: state.capture()
    assert(next_ticket.value() == 1)
    assert(core.mem.__snapshot_revision<Int, Int>(next_ticket) == 1)
}

#Test("Query revision metadata reads the canonical Shared owner and ticket") {
    data_query_revision_contract()
}

// Native DataTrackedState and its optimistic publication protocol. These
// helpers remain unregistered until the complete Query spine is cut over.
enum DataTrackedChangeKind<T> {
    Insert(row: T)
    Replace(before: T, after: T)
    Remove(row: T)
}

struct DataTrackedChange<T> {
    revision: Int
    order: Int
    kind: DataTrackedChangeKind<T>
}

struct DataTrackedState<T, K> {
    rows: [T]
    keys: [K]
    orders: [Int]
    next_order: Int
    changes: [DataTrackedChange<T>]
    key: fn(T) -> K
}

fn data_track_state_new<T, K: Equatable>(rows: [T], key: fn(T) -> K) -> Shared<DataTrackedState<T, K>> DataError! {
    limit :: DataLimits.safe().max_output_rows
    if rows.len() > limit -> return Err(data_error(.Limit, "retained rows {rows.len()} exceed max_output_rows {limit}", "data.track"))
    keys := [K]{}
    orders := [Int]{}
    loop (index, row) in rows {
        candidate :: key(row)
        loop existing in keys {
            if existing == candidate -> return Err(data_error(.DuplicateKey, "source keys must be unique", "data.track"))
        }
        &keys.push(candidate)
        &orders.push(index)
    }
    Ok(shared DataTrackedState<T, K>{rows: rows, keys: keys, orders: orders, next_order: keys.len(), changes: [DataTrackedChange<T>]{}, key: key})
}

fn data_track_state_update<T, K>(state: Shared<DataTrackedState<T, K>>, operation: String, update: fn(DataTrackedState<T, K>, Int) -> DataTrackedState<T, K> DataError!) DataError! {
    ticket :: state.capture()
    revision :: core.mem.__snapshot_revision<DataTrackedState<T, K>, DataTrackedState<T, K>>(ticket)
    if revision == 18446744073709551615 -> return Err(data_error(.Overflow, "source revision exhausted", operation))
    next_state :: update(ticket.value(), revision + 1) ?? return Err(err)
    if state.try_replace(^ticket, next_state) == {
        .Ok(published) -> {
            if published -> Ok(()) else -> Err(data_error(.StaleRevision, "source changed before publication", operation))
        }
        .Err(.WrongOwner) -> Err(data_error(.WrongOwner, "source snapshot belongs to another owner", operation))
        .Err(.GenerationExhausted) -> Err(data_error(.Overflow, "source revision exhausted", operation))
    }
}

fn data_track_change_capacity<T, K>(state: DataTrackedState<T, K>, operation: String) DataError! {
    limit :: DataLimits.safe().max_output_rows
    if state.changes.len() >= limit -> return Err(data_error(.Limit, "retained change state exceeds max_output_rows {limit}", operation))
    Ok(())
}

fn data_track_state_insert<T, K: Equatable>(owner: Shared<DataTrackedState<T, K>>, row: T) DataError! {
    data_track_state_update<T, K>(owner, "data.track.insert", (prior, revision) -> {
        state := ~prior
        candidate :: state.key(row)
        loop existing in state.keys {
            if existing == candidate -> return Err(data_error(.DuplicateKey, "source key already exists", "data.track.insert"))
        }
        limit :: DataLimits.safe().max_output_rows
        if state.rows.len() >= limit -> return Err(data_error(.Limit, "retained rows would exceed max_output_rows {limit}", "data.track.insert"))
        data_track_change_capacity<T, K>(state, "data.track.insert") ?? return Err(err)
        order :: state.next_order
        if order == 18446744073709551615 -> return Err(data_error(.Overflow, "source order exhausted", "data.track.insert"))
        state.next_order = order + 1
        &state.rows.push(row)
        &state.keys.push(candidate)
        &state.orders.push(order)
        &state.changes.push(DataTrackedChange<T>{revision: revision, order: order, kind: .Insert{row: row}})
        Ok(state)
    })
}

fn data_track_key_index<K: Equatable>(keys: [K], key: K) -> Int? Never! {
    loop (index, existing) in keys {
        if existing == key -> return Val(index)
    }
    None
}

fn data_track_state_replace<T, K: Equatable>(owner: Shared<DataTrackedState<T, K>>, key: K, row: T) DataError! {
    data_track_state_update<T, K>(owner, "data.track.replace", (prior, revision) -> {
        state := ~prior
        index :: data_track_key_index<K>(state.keys, key) ?? return Err(data_error(.MissingKey, "source key does not exist", "data.track.replace"))
        if state.key(row) != key -> return Err(data_error(.InvalidValue, "replacement row must retain its source key", "data.track.replace"))
        data_track_change_capacity<T, K>(state, "data.track.replace") ?? return Err(err)
        before :: ~state.rows[index]
        state.rows[index] = row
        &state.changes.push(DataTrackedChange<T>{revision: revision, order: state.orders[index], kind: .Replace{before: before, after: row}})
        Ok(state)
    })
}

fn data_track_state_remove<T, K: Equatable>(owner: Shared<DataTrackedState<T, K>>, key: K) DataError! {
    data_track_state_update<T, K>(owner, "data.track.remove", (prior, revision) -> {
        state := ~prior
        index :: data_track_key_index<K>(state.keys, key) ?? return Err(data_error(.MissingKey, "source key does not exist", "data.track.remove"))
        data_track_change_capacity<T, K>(state, "data.track.remove") ?? return Err(err)
        row :: state.rows.remove(index)
        state.keys.remove(index).drop("removed identity key")
        order :: state.orders.remove(index)
        &state.changes.push(DataTrackedChange<T>{revision: revision, order: order, kind: .Remove{row: row}})
        Ok(state)
    })
}

fn data_track_state_rows<T, K>(owner: Shared<DataTrackedState<T, K>>) -> [T] Never! {
    owner.capture().value().rows
}

fn data_track_state_entries<T, K>(owner: Shared<DataTrackedState<T, K>>) -> (revision: Int, entries: [DataTrackedEntry<T>]) Never! {
    ticket :: owner.capture()
    state :: ticket.value()
    entries := [DataTrackedEntry<T>]{}
    loop (index, row) in state.rows {
        &entries.push(DataTrackedEntry<T>{order: state.orders[index], value: row})
    }
    (revision: core.mem.__snapshot_revision<DataTrackedState<T, K>, DataTrackedState<T, K>>(ticket), entries: entries)
}

struct DataTrackedEntry<T> {
    order: Int
    value: T
}

fn data_track_state_changes<T, K>(owner: Shared<DataTrackedState<T, K>>, revision: Int) -> [DataTrackedChange<T>] DataError! {
    current :: core.mem.__shared_revision<DataTrackedState<T, K>>(owner)
    state :: owner.capture().value()
    if revision > current -> return Err(data_error(.StaleRevision, "requested revision is newer than the source", "data.query.watch"))
    next_revision :: if revision == 18446744073709551615 -> revision else -> revision + 1
    if state.changes.len() > 0 && next_revision < state.changes[0].revision -> return Err(data_error(.StaleRevision, "requested revision is no longer retained", "data.query.watch"))
    changes := [DataTrackedChange<T>]{}
    loop change in state.changes {
        if change.revision > revision -> &changes.push(change)
    }
    Ok(changes)
}

#Test("Tracked state keeps identity, order and revisions across shared handles") {
    owner :: data_track_state_new<Int, Int>([Int]{2, 4}, row -> row) ?? panic("track")
    alias :: owner
    data_track_state_insert<Int, Int>(owner, 6) ?? panic("insert")
    data_track_state_replace<Int, Int>(alias, 4, 4) ?? panic("replace")
    data_track_state_remove<Int, Int>(owner, 2) ?? panic("remove")
    snapshot :: data_track_state_entries<Int, Int>(alias)
    assert_eq(snapshot.revision, 3)
    assert_eq(snapshot.entries[0].order, 1)
    assert_eq(snapshot.entries[1].order, 2)
    assert_eq(data_track_state_rows<Int, Int>(owner), [Int]{4, 6})
    changes :: data_track_state_changes<Int, Int>(alias, 0) ?? panic("changes")
    assert_eq(changes.len(), 3)
}

enum DataQueryOperation<T> {
    Filter(predicate: fn(T) -> Bool)
    SortBy(key: fn(T) -> String)
}

struct DataTrackedReader<T> {
    rows: fn() -> [T]
    entries: fn() -> (revision: Int, entries: [DataTrackedEntry<T>])
    changes: fn(Int) -> [DataTrackedChange<T>] DataError!
    revision: fn() -> Int
    retained_rows: fn() -> Int
    plan: fn(Int) -> __TablePlan
}

struct DataTrackedMeta {
    revision: fn() -> Int
    retained_rows: fn() -> Int
}

struct DataQueryComputation<T> {
    producer: (fn() -> [T] DataError!)?
}

enum DataQuerySource<T> {
    Rows(rows: [T], missing: Int, plan: __TablePlan)
    Tracked(reader: DataTrackedReader<T>)
    Computed(compute: Shared<DataQueryComputation<T>>)
    Recomputed(compute: fn() -> [T] DataError!)
}

struct DataWatchEntry<T> {
    order: Int
    key: String?
    value: T
}

struct DataWatchMaterialized<T> {
    entries: [DataWatchEntry<T>]
    revision: Int
    mode: String
    recomputed: Bool
    changed: Bool
    retained_rows: Int
}

struct DataWatchSource<T> {
    initial: fn() -> DataWatchMaterialized<T> DataError!
    refresh: fn(Int, [DataWatchEntry<T>]) -> DataWatchMaterialized<T> DataError!
}

struct DataQueryState<T> {
    source: DataQuerySource<T>
    operations: [DataQueryOperation<T>]
    steps: [String]
    tracking: DataTrackedMeta?
    watch_source: DataWatchSource<T>?
    consumed: Shared<Bool>
}

fn data_query_state_rows<T>(rows: [T], missing: Int, plan: __TablePlan) -> DataQueryState<T> Never! {
    DataQueryState<T>{source: .Rows{rows: rows, missing: missing, plan: plan}, operations: [DataQueryOperation<T>]{}, steps: [String]{"scan"}, tracking: None, watch_source: None, consumed: shared false}
}

fn data_query_state_computed<T>(steps: [String], compute: fn() -> [T] DataError!) -> DataQueryState<T> Never! {
    DataQueryState<T>{source: .Computed{compute: shared DataQueryComputation<T>{producer: Val(compute)}}, operations: [DataQueryOperation<T>]{}, steps: steps, tracking: None, watch_source: None, consumed: shared false}
}

fn data_query_state_recomputed<T>(steps: [String], tracking: DataTrackedMeta, compute: fn() -> [T] DataError!) -> DataQueryState<T> Never! {
    DataQueryState<T>{source: .Recomputed{compute: compute}, operations: [DataQueryOperation<T>]{}, steps: steps, tracking: Val(tracking), watch_source: None, consumed: shared false}
}

fn data_query_state_tracked<T>(reader: DataTrackedReader<T>) -> DataQueryState<T> Never! {
    DataQueryState<T>{source: .Tracked{reader: reader}, operations: [DataQueryOperation<T>]{}, steps: [String]{"track"}, tracking: Val(DataTrackedMeta{revision: reader.revision, retained_rows: reader.retained_rows}), watch_source: None, consumed: shared false}
}

fn data_query_state_reducer<T>(tracking: DataTrackedMeta?, steps: [String], compute: fn() -> [T] DataError!) -> DataQueryState<T> Never! {
    if tracking == .Val(meta) -> data_query_state_recomputed<T>(steps, meta, compute)
    else -> data_query_state_computed<T>(steps, compute)
}

fn data_query_state_operation<T>(query: DataQueryState<T>, operation: DataQueryOperation<T>, step: String) -> DataQueryState<T> Never! {
    operations := ~query.operations
    &operations.push(operation)
    steps := ~query.steps
    &steps.push(step)
    watch_source := DataWatchSource<T>?{None}
    if query.watch_source == .Val(source) -> watch_source = Val(data_watch_operation_source<T>(source, operation))
    DataQueryState<T>{source: query.source, operations: operations, steps: steps, tracking: query.tracking, watch_source: watch_source, consumed: query.consumed}
}

fn data_query_take_computation<T>(query: DataQueryState<T>) -> (fn() -> [T] DataError!)? Never! {
    if query.source == .Computed(compute) {
        consumed := query.consumed.guard_edit()
        if consumed.value -> return None
        consumed.value = true
        consumed.drop("release the shared single-use gate before taking its producer")
        producer := compute.guard_edit()
        result :: ~producer.value.producer
        producer.value.producer = None
        return result
    }
    None
}

struct DataQueryPull<T> {
    next: fn() -> T? DataError!
}

struct DataQueryScan<T> {
    rows: [T]
    index: Int
}

struct DataQuerySort<T> {
    rows: [T]?
    index: Int
}

struct DataQueryKeyed<T> {
    key: String
    row: T
}

fn data_query_rows_pull<T>(rows: [T], operations: [DataQueryOperation<T>]) -> DataQueryPull<T> Never! {
    scan :: shared DataQueryScan<T>{rows: rows, index: 0}
    pull := DataQueryPull<T>{next: () -> {
        cursor := scan.guard_edit()
        if cursor.value.index >= cursor.value.rows.len() -> return Ok(None)
        row :: ~cursor.value.rows[cursor.value.index]
        cursor.value.index = cursor.value.index + 1
        Ok(Val(row))
    }}
    loop operation in operations {
        input :: ~pull
        if operation == {
            .Filter(predicate) -> {
                pull = DataQueryPull<T>{next: () -> {
                    loop {
                        row :: input.next() ?? return Err(err)
                        if row == {
                            .Val(value) -> { if predicate(value) -> return Ok(Val(value)) }
                            .None -> return Ok(None)
                        }
                    }
                }}
            }
            .SortBy(key) -> {
                sorted :: shared DataQuerySort<T>{rows: None, index: 0}
                pull = DataQueryPull<T>{next: () -> {
                    cursor := sorted.guard_edit()
                    if cursor.value.rows == None {
                        keyed := [DataQueryKeyed<T>]{}
                        limit :: DataLimits.safe().max_sort_rows
                        loop {
                            row :: input.next() ?? return Err(err)
                            if row == .None -> break
                            if keyed.len() >= limit -> return Err(data_error(.Limit, "max_sort_rows {limit} exceeded", "sort_by"))
                            if row == .Val(value) -> &keyed.push(DataQueryKeyed<T>{key: key(value), row: value})
                        }
                        values :: data_query_sort_keyed<T>(keyed)
                        cursor.value.rows = Val(values)
                    }
                    values :: cursor.value.rows ?? panic("sort rows initialized")
                    if cursor.value.index >= values.len() -> return Ok(None)
                    row :: ~values[cursor.value.index]
                    cursor.value.index = cursor.value.index + 1
                    Ok(Val(row))
                }}
            }
        }
    }
    pull
}

fn data_query_collect_pull<T>(pull: DataQueryPull<T>) -> [T] DataError! {
    limit :: DataLimits.safe().max_output_rows
    rows := [T]{}
    loop {
        // The native collector pulls in bounded batches of up to 256, including
        // one row beyond the output bound before reporting the limit.
        request :: if limit - rows.len() + 1 < 256 -> limit - rows.len() + 1 else -> 256
        batch := [T]{}
        loop batch.len() < request {
            row :: pull.next() ?? return Err(err)
            if row == {
                .None -> break
                .Val(value) -> &batch.push(value)
            }
        }
        if batch.len() > limit - rows.len() -> return Err(data_error(.Limit, "max_output_rows {limit} exceeded", "query.collect"))
        exhausted :: batch.len() < request
        loop row in batch -> &rows.push(row)
        if exhausted -> return Ok(rows)
    }
}

fn data_query_apply_operations<T>(rows: [T], operations: [DataQueryOperation<T>]) -> [T] DataError! {
    values := ~rows
    loop operation in operations {
        if operation == {
            .Filter(predicate) -> {
                filtered := [T]{}
                loop row in values { if predicate(row) -> &filtered.push(row) }
                values = filtered
            }
            .SortBy(key) -> {
                limit :: DataLimits.safe().max_sort_rows
                if values.len() > limit -> return Err(data_error(.Limit, "max_sort_rows {limit} exceeded", "query.sort_by"))
                keyed := [DataQueryKeyed<T>]{}
                loop row in values -> &keyed.push(DataQueryKeyed<T>{key: key(row), row: row})
                next_rows :: data_query_sort_keyed<T>(keyed)
                values = next_rows
            }
        }
    }
    limit :: DataLimits.safe().max_output_rows
    if values.len() > limit -> return Err(data_error(.Limit, "max_output_rows {limit} exceeded", "query.collect"))
    Ok(values)
}

fn data_query_state_collect<T>(query: DataQueryState<T>) -> [T] DataError! {
    if query.source == {
        .Rows(rows, _, _) -> data_query_collect_pull<T>(data_query_rows_pull<T>(rows, query.operations))
        .Tracked(reader) -> data_query_collect_pull<T>(data_query_rows_pull<T>(reader.rows(), query.operations))
        .Recomputed(compute) -> {
            rows :: compute() ?? return Err(err)
            data_query_apply_operations<T>(rows, query.operations)
        }
        .Computed(_) -> {
            compute :: data_query_take_computation<T>(query) ?? return Err(data_error(.State, "query has already been collected", "query.collect"))
            rows :: compute() ?? return Err(err)
            data_query_apply_operations<T>(rows, query.operations)
        }
    }
}

#Test("Computed derived Query states share their single-use producer") {
    query :: data_query_state_computed<Int>([String]{"stream"}, () -> Ok([Int]{1, 2, 3}))
    filtered :: data_query_state_operation<Int>(query, .Filter{predicate: row -> row > 1}, "filter")
    assert_eq(data_query_state_collect<Int>(filtered) ?? panic("first collect"), [Int]{2, 3})
    if data_query_state_collect<Int>(query) == {
        .Ok(_) -> panic("single-use query replayed")
        .Err(error) -> {
            assert(error.kind == .State)
            assert_eq(error.reason, "query has already been collected")
        }
    }
}

fn data_query_sort_keyed<T>(keyed: [DataQueryKeyed<T>]) -> [T] Never! {
    indices := [Int]{}
    loop index in 0..<keyed.len() -> &indices.push(index)
    // Reuse List's comparator sort. Explicit original positions make ties
    // stable regardless of the host sorting implementation.
    &indices.sort_by((left: Int, right: Int) -> {
        order :: keyed[left].key <=> keyed[right].key
        if order == Ordering.Equal -> left <=> right else -> order
    })
    rows := [T]{}
    loop index in indices -> &rows.push(keyed[index].row)
    rows
}

#Test("Query stable sort preserves tied String keys and UTF-8 byte order") {
    keyed :: [DataQueryKeyed<Int>]{
        DataQueryKeyed<Int>{key: "é", row: 1},
        DataQueryKeyed<Int>{key: "a", row: 2},
        DataQueryKeyed<Int>{key: "a", row: 3},
        DataQueryKeyed<Int>{key: "", row: 4},
    }
    assert_eq(data_query_sort_keyed<Int>(keyed), [Int]{4, 2, 3, 1})
}

fn data_watch_accepts<T>(operations: [DataQueryOperation<T>], row: T) -> (accepted: Bool, key: String?) Never! {
    sort_key := String?{None}
    loop operation in operations {
        if operation == {
            .Filter(predicate) -> { if !predicate(row) -> return (accepted: false, key: None) }
            .SortBy(key) -> { sort_key = Val(key(row)) }
        }
    }
    (accepted: true, key: sort_key)
}

fn data_watch_insert_entry<T>(entries: &[DataWatchEntry<T>], entry: DataWatchEntry<T>) Never! {
    position := 0
    loop position < entries.len() {
        existing :: entries[position]
        earlier := entry.order < existing.order
        if entry.key == .Val(left) && existing.key == .Val(right) {
            earlier = left < right || (left == right && entry.order < existing.order)
        }
        if earlier -> break
        position = position + 1
    }
    &entries.insert(position, entry)
}

fn data_watch_snapshot_entries<T>(rows: [DataTrackedEntry<T>], operations: [DataQueryOperation<T>]) -> [DataWatchEntry<T>] Never! {
    entries := [DataWatchEntry<T>]{}
    loop row in rows {
        accepted :: data_watch_accepts<T>(operations, row.value)
        if accepted.accepted -> data_watch_insert_entry<T>(&entries, DataWatchEntry<T>{order: row.order, key: accepted.key, value: row.value})
    }
    entries
}

fn data_watch_sort_limit<T>(reader: DataTrackedReader<T>, operations: [DataQueryOperation<T>]) DataError! {
    loop operation in operations {
        if operation == .SortBy(_) {
            limit :: DataLimits.safe().max_sort_rows
            if reader.retained_rows() > limit -> return Err(data_error(.Limit, "max_sort_rows {limit} exceeded", "data.query.watch"))
            break
        }
    }
    Ok(())
}

fn data_watch_apply_change<T>(entries: &[DataWatchEntry<T>], change: DataTrackedChange<T>, operations: [DataQueryOperation<T>]) Never! {
    index := Int?{None}
    loop (position, entry) in entries {
        if entry.order == change.order {
            index = Val(position)
            break
        }
    }
    if change.kind == {
        .Insert(row) -> {
            accepted :: data_watch_accepts<T>(operations, row)
            if accepted.accepted -> data_watch_insert_entry<T>(&entries, DataWatchEntry<T>{order: change.order, key: accepted.key, value: row})
        }
        .Replace(_, after) -> {
            if index == .Val(position) -> entries.remove(position).drop("replaced watch entry")
            accepted :: data_watch_accepts<T>(operations, after)
            if accepted.accepted -> data_watch_insert_entry<T>(&entries, DataWatchEntry<T>{order: change.order, key: accepted.key, value: after})
        }
        .Remove(_) -> {
            if index == .Val(position) -> entries.remove(position).drop("removed watch entry")
        }
    }
}

fn data_watch_tracked_source<T>(reader: DataTrackedReader<T>, operations: [DataQueryOperation<T>]) -> DataWatchSource<T> Never! {
    DataWatchSource<T>{
        initial: () -> {
            data_watch_sort_limit<T>(reader, operations) ?? return Err(err)
            snapshot :: reader.entries()
            Ok(DataWatchMaterialized<T>{entries: data_watch_snapshot_entries<T>(snapshot.entries, operations), revision: snapshot.revision, mode: "incremental", recomputed: false, changed: true, retained_rows: reader.retained_rows()})
        },
        refresh: (revision, prior) -> {
            data_watch_sort_limit<T>(reader, operations) ?? return Err(err)
            changes :: reader.changes(revision) ?? return Err(err)
            entries := ~prior
            loop change in changes -> data_watch_apply_change<T>(&entries, change, operations)
            Ok(DataWatchMaterialized<T>{entries: entries, revision: reader.revision(), mode: "incremental", recomputed: false, changed: reader.revision() != revision, retained_rows: reader.retained_rows()})
        },
    }
}

fn data_query_maintained_source<T>(query: DataQueryState<T>) -> DataWatchSource<T>? Never! {
    if query.watch_source == .Val(source) -> return Val(source)
    if query.source == .Tracked(reader) -> return Val(data_watch_tracked_source<T>(reader, query.operations))
    None
}

fn data_watch_apply_operation<T>(entries: [DataWatchEntry<T>], operation: DataQueryOperation<T>, retained_rows: Int) -> [DataWatchEntry<T>] DataError! {
    values := ~entries
    if operation == {
        .Filter(predicate) -> {
            filtered := [DataWatchEntry<T>]{}
            loop entry in values { if predicate(entry.value) -> &filtered.push(entry) }
            values = filtered
        }
        .SortBy(key) -> {
            limit :: DataLimits.safe().max_sort_rows
            if retained_rows > limit -> return Err(data_error(.Limit, "max_sort_rows {limit} exceeded", "data.query.watch"))
            loop index in 0..<values.len() -> values[index].key = Val(key(values[index].value))
            indices := [Int]{}
            loop index in 0..<values.len() -> &indices.push(index)
            &indices.sort_by((left: Int, right: Int) -> {
                order :: data_watch_optional_key_order(values[left].key, values[right].key)
                if order == Ordering.Equal -> left <=> right else -> order
            })
            sorted := [DataWatchEntry<T>]{}
            loop index in indices -> &sorted.push(values[index])
            values = sorted
        }
    }
    Ok(values)
}

fn data_watch_optional_key_order(left: String?, right: String?) -> Ordering Never! {
    if left == {
        .None -> { if right == .None -> Ordering.Equal else -> Ordering.Less }
        .Val(value) -> {
            if right == .Val(other) -> value <=> other else -> Ordering.Greater
        }
    }
}

fn data_watch_operation_source<T>(source: DataWatchSource<T>, operation: DataQueryOperation<T>) -> DataWatchSource<T> Never! {
    base :: shared [DataWatchEntry<T>]?{None}
    DataWatchSource<T>{
        initial: () -> {
            materialized :: source.initial() ?? return Err(err)
            entries :: data_watch_apply_operation<T>(materialized.entries, operation, materialized.retained_rows) ?? return Err(err)
            base_guard := base.guard_edit()
            base_guard.value = Val(materialized.entries)
            Ok(DataWatchMaterialized<T>{entries: entries, revision: materialized.revision, mode: materialized.mode, recomputed: materialized.recomputed, changed: materialized.changed, retained_rows: materialized.retained_rows})
        },
        refresh: (revision, prior) -> {
            previous :: base.capture().value() ?? return Err(data_error(.State, "derived watch was not initialized", "data.query.watch"))
            materialized :: source.refresh(revision, previous) ?? return Err(err)
            if !materialized.changed && materialized.revision == revision -> return Ok(DataWatchMaterialized<T>{entries: prior, revision: materialized.revision, mode: materialized.mode, recomputed: false, changed: false, retained_rows: materialized.retained_rows})
            entries :: data_watch_apply_operation<T>(materialized.entries, operation, materialized.retained_rows) ?? return Err(err)
            base_guard := base.guard_edit()
            base_guard.value = Val(materialized.entries)
            Ok(DataWatchMaterialized<T>{entries: entries, revision: materialized.revision, mode: materialized.mode, recomputed: materialized.recomputed, changed: materialized.changed, retained_rows: materialized.retained_rows})
        },
    }
}

fn data_watch_map_entries<T, U>(entries: [DataWatchEntry<T>], map: fn(T) -> U DataError!) -> [DataWatchEntry<U>] DataError! {
    mapped := [DataWatchEntry<U>]{}
    loop entry in entries {
        value :: map(entry.value) ?? return Err(err)
        &mapped.push(DataWatchEntry<U>{order: entry.order, key: None, value: value})
    }
    Ok(mapped)
}

fn data_watch_map_source<T, U>(source: DataWatchSource<T>, map: fn(T) -> U DataError!) -> DataWatchSource<U> Never! {
    base :: shared [DataWatchEntry<T>]?{None}
    DataWatchSource<U>{
        initial: () -> {
            materialized :: source.initial() ?? return Err(err)
            entries :: data_watch_map_entries<T, U>(materialized.entries, map) ?? return Err(err)
            base_guard := base.guard_edit()
            base_guard.value = Val(materialized.entries)
            Ok(DataWatchMaterialized<U>{entries: entries, revision: materialized.revision, mode: materialized.mode, recomputed: materialized.recomputed, changed: materialized.changed, retained_rows: materialized.retained_rows})
        },
        refresh: (revision, prior) -> {
            previous :: base.capture().value() ?? return Err(data_error(.State, "mapped watch was not initialized", "data.query.watch"))
            materialized :: source.refresh(revision, previous) ?? return Err(err)
            if !materialized.changed && materialized.revision == revision -> return Ok(DataWatchMaterialized<U>{entries: prior, revision: materialized.revision, mode: materialized.mode, recomputed: false, changed: false, retained_rows: materialized.retained_rows})
            entries :: data_watch_map_entries<T, U>(materialized.entries, map) ?? return Err(err)
            base_guard := base.guard_edit()
            base_guard.value = Val(materialized.entries)
            Ok(DataWatchMaterialized<U>{entries: entries, revision: materialized.revision, mode: materialized.mode, recomputed: materialized.recomputed, changed: materialized.changed, retained_rows: materialized.retained_rows})
        },
    }
}

fn data_query_state_map<T, U>(query: DataQueryState<T>, map: fn(T) -> U DataError!) -> DataQueryState<U> Never! {
    steps := ~query.steps
    &steps.push("map")
    mapped := data_query_state_reducer<U>(query.tracking, steps, () -> {
        rows :: data_query_state_collect<T>(query) ?? return Err(err)
        result := [U]{}
        loop row in rows {
            value :: map(row) ?? return Err(err)
            &result.push(value)
        }
        Ok(result)
    })
    if data_query_maintained_source<T>(query) == .Val(source) -> mapped.watch_source = Val(data_watch_map_source<T, U>(source, map))
    mapped
}

#Test("Watch optional sort keys use native None ordering") {
    assert(data_watch_optional_key_order(None, Val("")) == Ordering.Less)
    assert(data_watch_optional_key_order(Val(""), None) == Ordering.Greater)
    assert(data_watch_optional_key_order(None, None) == Ordering.Equal)
    assert(data_watch_optional_key_order(Val("same"), Val("same")) == Ordering.Equal)
}

#Test("Query Rows source retains its private opaque native plan") {
    rows :: [Int]{3, 1, 2}
    plan :: core.mem.__query_plan<Int>(rows)
    query :: data_query_state_rows<Int>(rows, 0, plan)
    assert_eq(data_query_state_collect<Int>(query) ?? panic("rows collect"), rows)
    assert_eq(data_query_state_collect<Int>(query) ?? panic("rows replay"), rows)
}

struct DataWatchLifecycle {
    generation: Int
    active: Bool
    dirty: Bool
    error: String
    fresh_at_ms: Int
    invalidation_cause: String
    refreshing: Bool
    cancelled: Bool
}

struct DataWatchState<T> {
    entries: [DataWatchEntry<T>]
    source_revision: Int
    mode: String
    retained_rows: Int
    recomputations: Int
    lifecycle: DataWatchLifecycle
}

struct DataWatchCore<T> {
    query: DataQueryState<T>
    source: DataWatchSource<T>
    state: Shared<DataWatchState<T>>
}

fn data_watch_lifecycle_active() -> DataWatchLifecycle Never! {
    DataWatchLifecycle{generation: 1, active: true, dirty: false, error: "", fresh_at_ms: core.mem.__watch_clock(), invalidation_cause: "", refreshing: false, cancelled: false}
}

fn data_watch_lifecycle_current(lifecycle: DataWatchLifecycle, generation: Int) -> Bool Never! {
    lifecycle.active && !lifecycle.cancelled && lifecycle.generation == generation
}

fn data_watch_lifecycle_begin(lifecycle: &DataWatchLifecycle, generation: Int) -> Bool Never! {
    if !data_watch_lifecycle_current(lifecycle, generation) || lifecycle.refreshing -> return false
    lifecycle.refreshing = true
    true
}

fn data_watch_lifecycle_fail(lifecycle: &DataWatchLifecycle, generation: Int, error: String) Never! {
    current :: data_watch_lifecycle_current(lifecycle, generation)
    lifecycle.refreshing = false
    if !current -> return
    lifecycle.error = error
    lifecycle.dirty = true
}

fn data_watch_lifecycle_publish(lifecycle: &DataWatchLifecycle, generation: Int) Never! {
    current :: data_watch_lifecycle_current(lifecycle, generation)
    lifecycle.refreshing = false
    if !current -> return
    lifecycle.dirty = false
    lifecycle.error = ""
    lifecycle.fresh_at_ms = core.mem.__watch_clock()
}

fn data_query_state_watch<T>(query: DataQueryState<T>) -> DataWatchCore<T> DataError! {
    source :: data_query_maintained_source<T>(query) ?? return Err(data_error(.Unsupported, "E2476: watch requires a maintained data.track source", "data.query.watch"))
    initial :: source.initial() ?? return Err(err)
    if initial.entries.len() > DataLimits.safe().max_output_rows -> return Err(data_error(.Limit, "maintained result exceeds max_output_rows", "data.query.watch"))
    recomputations :: if initial.recomputed -> 1 else -> 0
    Ok(DataWatchCore<T>{query: query, source: source, state: shared DataWatchState<T>{entries: initial.entries, source_revision: initial.revision, mode: initial.mode, retained_rows: initial.retained_rows, recomputations: recomputations, lifecycle: data_watch_lifecycle_active()}})
}

fn data_watch_core_cancel<T>(watch: DataWatchCore<T>) Never! {
    state := watch.state.guard_edit()
    if !state.value.lifecycle.active -> return
    if state.value.lifecycle.generation < 18446744073709551615 -> state.value.lifecycle.generation = state.value.lifecycle.generation + 1
    state.value.lifecycle.dirty = true
    state.value.lifecycle.refreshing = false
    state.value.lifecycle.cancelled = true
    state.value.lifecycle.invalidation_cause = "cancelled"
}

fn data_watch_core_get<T>(watch: DataWatchCore<T>) -> [T] DataError! {
    if !watch.state.capture().value().lifecycle.active -> return Err(data_error(.State, "watch is cancelled", "data.watch.get"))
    ticket :: watch.state.capture()
    current := ticket.value()
    generation :: current.lifecycle.generation
    if !data_watch_lifecycle_begin(&current.lifecycle, generation) -> return Err(data_error(.State, "watch is cancelled", "data.watch.get"))
    update := DataWatchMaterialized<T>?{None}
    failure := DataError?{None}
    if watch.source.refresh(current.source_revision, current.entries) == {
        .Ok(value) -> {
            if value.entries.len() > DataLimits.safe().max_output_rows -> failure = Val(data_error(.Limit, "maintained result exceeds max_output_rows", "data.watch.get"))
            else -> update = Val(value)
        }
        .Err(error) -> failure = Val(error)
    }
    if failure == .Val(error) {
        data_watch_lifecycle_fail(&current.lifecycle, generation, "{error}")
        // Failure is best-effort publication, exactly as the native watch.
        if watch.state.try_replace(^ticket, current) == {
            .Ok(_) -> {}
            .Err(_) -> {}
        }
        return Err(error)
    }
    materialized :: update ?? panic("successful watch refresh has a materialization")
    data_watch_lifecycle_publish(&current.lifecycle, generation)
    recomputations := current.recomputations
    if materialized.recomputed && recomputations < 18446744073709551615 -> recomputations = recomputations + 1
    next_state :: DataWatchState<T>{entries: materialized.entries, source_revision: materialized.revision, mode: materialized.mode, retained_rows: materialized.retained_rows, recomputations: recomputations, lifecycle: current.lifecycle}
    if !watch.state.capture().value().lifecycle.active -> return Err(data_error(.State, "watch was cancelled before publication", "data.watch.get"))
    if watch.state.try_replace(^ticket, next_state) == {
        .Ok(published) -> {
            if !published -> return Err(data_error(.StaleRevision, "watch state changed before publication", "data.watch.get"))
            state :: watch.state.capture().value()
            rows := [T]{}
            loop entry in state.entries -> &rows.push(entry.value)
            Ok(rows)
        }
        .Err(.WrongOwner) -> Err(data_error(.WrongOwner, "watch snapshot belongs to another owner", "data.watch.get"))
        .Err(.GenerationExhausted) -> Err(data_error(.Overflow, "watch publication revision exhausted", "data.watch.get"))
    }
}

fn data_watch_status_int(value: Int) -> Int Never! {
    if value > 9223372036854775807 -> 9223372036854775807 else -> value
}

fn data_watch_core_status<T>(watch: DataWatchCore<T>) -> DataWatchStatus Never! {
    state :: watch.state.capture().value()
    now :: core.mem.__watch_clock()
    age :: if now < state.lifecycle.fresh_at_ms -> 0 else -> now - state.lifecycle.fresh_at_ms
    DataWatchStatus{mode: state.mode, revision: data_watch_status_int(state.source_revision), retained_rows: data_watch_status_int(state.retained_rows), recomputations: data_watch_status_int(state.recomputations), active: state.lifecycle.active, generation: data_watch_status_int(state.lifecycle.generation), dirty: state.lifecycle.dirty, error: state.lifecycle.error, freshness_ms: data_watch_status_int(age), invalidation_cause: state.lifecycle.invalidation_cause, refreshing: state.lifecycle.refreshing, cancelled: state.lifecycle.cancelled}
}

#Test("Watch cancellation retains native lifecycle generation and active status") {
    lifecycle := DataWatchLifecycle{generation: 1, active: true, dirty: false, error: "", fresh_at_ms: 0, invalidation_cause: "", refreshing: false, cancelled: false}
    assert(data_watch_lifecycle_begin(&lifecycle, 1))
    data_watch_lifecycle_fail(&lifecycle, 1, "failed")
    assert(lifecycle.dirty)
    assert(!lifecycle.refreshing)
    assert_eq(lifecycle.error, "failed")
    lifecycle.cancelled = true
    assert(!data_watch_lifecycle_begin(&lifecycle, 1))
    assert_eq(data_watch_status_int(18446744073709551615), 9223372036854775807)
}
