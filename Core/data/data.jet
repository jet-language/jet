// Typed data declarations and provider-backed boundaries.
impl DataLimits {
    pub fn safe() -> DataLimits Never! {
        DataLimits{
            encoding: encoding.EncodingLimits.safe(),
            max_groups: 100000,
            max_sort_rows: 1000000,
            max_join_rows: 1000000,
            max_output_rows: 1000000,
        }
    }
}

pub fn track<T, K>(rows: [T], _key: fn(T) -> K) -> DataTracked<T, K> DataError! {
    Ok(DataTracked<T, K>{snapshot: snapshot_from_rows<T>(rows)})
}

pub fn file<T>(path: String, format: String, limits: DataLimits) -> DataLoader<T> DataError! {
    make_loader<T>(DataLoaderKind.File, path, "", [String]{}, format, "local", limits)
}

pub fn file_member<T>(path: String, member: String, format: String, limits: DataLimits) -> DataLoader<T> DataError! {
    make_loader<T>(DataLoaderKind.File, path, member, [String]{}, format, "local", limits)
}

pub fn url<T>(href: String, format: String, authority: String, limits: DataLimits) -> DataLoader<T> DataError! {
    make_loader<T>(DataLoaderKind.URL, href, "", [String]{}, format, authority, limits)
}

pub fn database<T>(query: String, parameters: [String], authority: String, limits: DataLimits) -> DataLoader<T> DataError! {
    make_loader<T>(DataLoaderKind.Database, query, "", parameters, "json", authority, limits)
}

pub fn value<T: Encode>(value: T, limits: DataLimits) -> DataLoader<T> DataError! {
    core.data.value<T>(value, limits)
}

/// Infer a core format from the final path extension, without reading the
/// source. Query/fragment suffixes do not participate in format detection.
pub fn load_default<T>(locator: String) -[FS, Net, DB]> DataLoader<T> DataError! {
    load<T>(locator, DataLimits.safe())
}

pub fn load<T>(locator: String, limits: DataLimits) -[FS, Net, DB]> DataLoader<T> DataError! {
    format :: locator_format(locator)
    if locator.starts_with("http://") || locator.starts_with("https://") {
        if url<T>(locator, format, "network", limits) == {
            .Ok(loader) -> return Ok(loader)
            .Err(error) -> return Err(load_format_error(error, format))
        }
    }
    if file<T>(locator, format, limits) == {
        .Ok(loader) -> Ok(loader)
        .Err(error) -> Err(load_format_error(error, format))
    }
}

fn load_format_error(error: DataError, format: String) -> DataError Never! {
    if error.kind == .InvalidArgument && error.reason == "unknown data format" {
        return data_error(DataErrorKind.Bridge, "format `{format}` is provider-owned; import its package", "data.loader")
    }
    ~error
}

fn locator_format(locator: String) -> String DataError! {
    path :: locator.split("?").to_list()[0].split("#").to_list()[0]
    segments :: path.split("/").to_list()
    name :: segments[segments.len() - 1]
    parts :: name.split(".").to_list()
    if parts.len() < 2 {
        return Err(data_error(DataErrorKind.Bridge, "source has no core format; import a provider package", "data.load"))
    }
    parts[parts.len() - 1]
}

#Test("load discovers the final path extension before query and fragment") {
    local :: load_default<Int>("dir.with.dot/items.CSV?version=.json#part") ?? panic("local loader")
    assert_eq(local.source.locator, "dir.with.dot/items.CSV?version=.json#part")
    assert(local.format == .CSV)
    remote :: load_default<Int>("https://example.test/items.ndjson#part.json") ?? panic("remote loader")
    assert(remote.source.kind == .URL)
    assert(remote.format == .JSONL)
    assert_eq(remote.authority.scope, "network")
    assert_eq(remote.limits.max_output_rows, 1000000)
}

#Test("load does not infer a format from a directory or query") {
    if load_default<Int>("dir.csv/items?format=.json") == {
        .Ok(_) -> panic("extensionless source accepted")
        .Err(error) -> {
            assert(error.kind == .Bridge)
            assert_eq(error.operation, "data.load")
            assert_eq(error.reason, "source has no core format; import a provider package")
        }
    }
    if load_default<Int>("items.txt") == {
        .Ok(_) -> panic("provider format accepted")
        .Err(error) -> {
            assert(error.kind == .Bridge)
            assert_eq(error.operation, "data.loader")
            assert_eq(error.reason, "format `txt` is provider-owned; import its package")
        }
    }
}

pub fn csv<T: Decode>(text: String) -> [T] DataError! {
    rows :: core.data.csv<T>(text) ?? return Err(data_error(DataErrorKind.Decode, "CSV decode failed", "csv"))
    Ok(rows)
}

pub fn json<T: Decode>(text: String) -> [T] DataError! {
    tree :: json_codec.__parse_typed(text) ?? return Err(data_error(DataErrorKind.Decode, "JSON decode failed", "json"))
    if tree == .Array(items) {
        rows := [T]{}
        loop item in items {
            row :: item.decode<T>() ?? return Err(data_error(DataErrorKind.Decode, "JSON decode failed", "json"))
            &rows.push(row)
        }
        return Ok(rows)
    }
    Err(data_error(DataErrorKind.Decode, "typed JSON requires a top-level array", "json"))
}

#Test("typed data JSON reuses exact number decoding") {
    rows :: json<Int>("[9007199254740993,1e2,-9007199254740993]") ?? panic("typed data JSON")
    assert_eq(rows, [Int]{9007199254740993, 100, -9007199254740993})
}

pub fn csv_reader<T: Decode>(reader: ^FileReader, limits: DataLimits) -> DataStream<T> DataError! {
    core.data.csv_reader<T>(^reader, limits)
}

pub fn json_reader<T: Decode>(reader: ^FileReader, limits: DataLimits) -> DataStream<T> DataError! {
    core.data.json_reader<T>(^reader, limits)
}

pub fn snapshot<T: [Encode, Decode]>(loader: &DataLoader<T>) -[FS, Net, DB]> DataSnapshot<T> DataError! {
    if loader.cancelled {
        return Err(data_error(DataErrorKind.State, "loader was cancelled before snapshot", loader.source.locator))
    }
    core.data.snapshot<T>(&loader)
}


pub fn schema<T>(rows: [T]) -> [DataColumn] Never! { core.data.schema(rows) }

pub fn count<T>(rows: [T]) -> Int Never! { rows.len() }

pub fn describe(values: [Float]) -> DataSummary DataError! {
    if values.len() == 0 -> return Err(data_error(DataErrorKind.Empty, "describe of empty data is undefined", "describe"))
    total := Float{0.0}
    if compensated_sum(values, "describe") == {
        .Ok(value) -> total = value
        .Err(error) -> return Err(error)
    }
    mean_value := total / Float{values.len()}
    if nonfinite(mean_value) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while computing mean", "describe"))
    minimum :: min(values) ?? return Err(data_error(DataErrorKind.NonFinite, "minimum failed while describing data", "describe"))
    maximum :: max(values) ?? return Err(data_error(DataErrorKind.NonFinite, "maximum failed while describing data", "describe"))
    middle :: median(values) ?? return Err(data_error(DataErrorKind.Empty, "median failed while describing data", "describe"))
    spread := Float{0.0}
    if variance(values) == {
        .Ok(value) -> spread = value
        .Err(error) -> return Err(error)
    }
    deviation := math.sqrt(spread)
    if nonfinite(deviation) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while computing standard deviation", "describe"))
    Ok(DataSummary{
        count: values.len(),
        sum: total,
        mean: normalize_zero(mean_value),
        min: normalize_zero(minimum),
        max: normalize_zero(maximum),
        median: normalize_zero(middle),
        variance: normalize_zero(spread),
        stddev: normalize_zero(deviation),
    })
}


pub fn sum(values: [Float]) -> Float DataError! {
    compensated_sum(values, "sum")
}

pub fn mean(values: [Float]) -> Float DataError! {
    if values.len() == 0 -> return Err(data_error(DataErrorKind.Empty, "mean of empty data is undefined", "mean"))
    total := Float{0.0}
    if compensated_sum(values, "mean") == {
        .Ok(value) -> total = value
        .Err(error) -> return Err(error)
    }
    mean_value := total / Float{values.len()}
    if nonfinite(mean_value) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while computing mean", "mean"))
    Ok(normalize_zero(mean_value))
}

pub fn min(values: [Float]) -> Float DataError! {
    if values.len() == 0 -> return Err(data_error(DataErrorKind.Empty, "min of empty data is undefined", "min"))
    first :: values[0]
    if nonfinite(first) -> return Err(data_error(DataErrorKind.NonFinite, "numeric input must be finite", "min"))
    out := first
    loop value in values {
        if nonfinite(value) -> return Err(data_error(DataErrorKind.NonFinite, "numeric input must be finite", "min"))
        if value < out -> out = value
    }
    Ok(normalize_zero(out))
}

pub fn max(values: [Float]) -> Float DataError! {
    if values.len() == 0 -> return Err(data_error(DataErrorKind.Empty, "max of empty data is undefined", "max"))
    first :: values[0]
    if nonfinite(first) -> return Err(data_error(DataErrorKind.NonFinite, "numeric input must be finite", "max"))
    out := first
    loop value in values {
        if nonfinite(value) -> return Err(data_error(DataErrorKind.NonFinite, "numeric input must be finite", "max"))
        if value > out -> out = value
    }
    Ok(normalize_zero(out))
}

pub fn variance(values: [Float]) -> Float DataError! {
    if values.len() == 0 -> return Err(data_error(DataErrorKind.Empty, "variance of empty data is undefined", "variance"))
    mean_value := Float{0.0}
    m2 := Float{0.0}
    n := Float{0.0}
    loop value in values {
        if nonfinite(value) -> return Err(data_error(DataErrorKind.NonFinite, "numeric input must be finite", "variance"))
        n = n + Float{1.0}
        delta := value - mean_value
        mean_value = mean_value + delta / n
        delta2 := value - mean_value
        m2 = m2 + delta * delta2
        if nonfinite(mean_value) || nonfinite(m2) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while computing variance", "variance"))
    }
    if m2 < (Float{0.0}) -> m2 = Float{0.0}
    result := m2 / n
    if nonfinite(result) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while computing variance", "variance"))
    Ok(normalize_zero(result))
}

pub fn stddev(values: [Float]) -> Float DataError! {
    value := Float{0.0}
    if variance(values) == {
        .Ok(result) -> value = result
        .Err(error) -> return Err(error)
    }
    result := math.sqrt(value)
    if nonfinite(result) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while computing standard deviation", "stddev"))
    Ok(normalize_zero(result))

}

pub fn median(values: [Float]) -> Float DataError! {
    quantile(values, Float{0.5})
}

pub fn quantile(values: [Float], q: Float) -> Float DataError! {
    if nonfinite(q) || q < (Float{0.0}) || q > (Float{1.0}) {
        return Err(data_error(DataErrorKind.InvalidArgument, "quantile q must be in 0.0 through 1.0", "quantile"))
    }
    if values.len() == 0 -> return Err(data_error(DataErrorKind.Empty, "quantile of empty data is undefined", "quantile"))
    limits := DataLimits.safe()
    if values.len() > limits.max_sort_rows -> return Err(data_error(DataErrorKind.Limit, "max_sort_rows exceeded", "quantile"))
    loop value in values {
        if nonfinite(value) -> return Err(data_error(DataErrorKind.NonFinite, "numeric input must be finite", "quantile"))
    }
    sorted := sort_floats(values)
    pos := q * Float{sorted.len() - 1}
    lo := Int{pos}
    hi := lo
    if (Float{lo}) < pos -> hi = lo + 1
    if hi >= sorted.len() -> hi = sorted.len() - 1
    if lo == hi -> return Ok(normalize_zero(sorted[lo]))
    frac := pos - Float{lo}
    result := sorted[lo] * (Float{1.0} - frac) + sorted[hi] * frac
    if nonfinite(result) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while interpolating quantile", "quantile"))
    Ok(normalize_zero(result))
}

pub fn rolling_mean(values: [Float], window: Int) -> [Float] DataError! {
    if window < 1 -> return Err(data_error(DataErrorKind.InvalidArgument, "rolling width must be positive", "rolling_mean"))
    limits := DataLimits.safe()
    if values.len() > limits.max_output_rows -> return Err(data_error(DataErrorKind.Limit, "max_output_rows exceeded", "rolling_mean"))
    loop index in 0..<values.len() {
        if nonfinite(values[index]) {
            return Err(data_error_at(DataErrorKind.NonFinite, "numeric input must be finite", "rolling_mean", index))
        }
    }
    out := [Float]{}
    loop i in 0..<values.len() {
        start := 0
        if window < i + 1 -> start = i - window + 1
        total := Float{0.0}
        if compensated_sum_range(values, start, i + 1, "rolling_mean") == {
            .Ok(value) -> total = value
            .Err(error) -> return Err(error)
        }
        n := i + 1 - start
        mean_value := total / Float{n}
        if nonfinite(mean_value) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while computing rolling mean", "rolling_mean"))
        &out.push(normalize_zero(mean_value))
    }
    Ok(out)
}

pub fn inner_join<T, U>(left: [T], right: [U], left_key: fn(T) -> String, right_key: fn(U) -> String) -> [DataJoin<T, U>] DataError! {
    limits := DataLimits.safe()
    left_keys := [String]{}
    right_keys := [String]{}
    loop row in left {
        key :: left_key(row) ?? return Err(data_error(DataErrorKind.Decode, "left join key failed", "inner_join"))
        &left_keys.push(key)
    }
    loop row in right {
        key :: right_key(row) ?? return Err(data_error(DataErrorKind.Decode, "right join key failed", "inner_join"))
        &right_keys.push(key)
    }
    // The output cardinality is known from per-key counts before any row is
    // built, so a limit breach costs O(left + right) rather than one push per
    // row up to max_join_rows.
    right_counts :: join_key_counts(right_keys)
    total := 0
    loop key in left_keys {
        total += right_counts.get(key) ?? 0
        if total > limits.max_join_rows {
            return Err(data_error(DataErrorKind.Limit, "max_join_rows exceeded", "inner_join"))
        }
    }
    out := [DataJoin<T, U>]{}
    loop left_index in 0..<left.len() {
        if (right_counts.get(left_keys[left_index]) ?? 0) == 0 -> next
        loop right_index in 0..<right.len() {
            if left_keys[left_index] != right_keys[right_index] -> next
            &out.push(DataJoin<T, U>{left: left[left_index], right: right[right_index]})
        }
    }
    if out.len() > limits.max_output_rows {
        return Err(data_error(DataErrorKind.Limit, "max_output_rows exceeded", "inner_join"))
    }
    Ok(out)
}

pub fn left_join<T, U>(left: [T], right: [U], left_key: fn(T) -> String, right_key: fn(U) -> String) -> [DataJoin<T, U?>] DataError! {
    limits := DataLimits.safe()
    left_keys := [String]{}
    right_keys := [String]{}
    loop row in left {
        key :: left_key(row) ?? return Err(data_error(DataErrorKind.Decode, "left join key failed", "left_join"))
        &left_keys.push(key)
    }
    loop row in right {
        key :: right_key(row) ?? return Err(data_error(DataErrorKind.Decode, "right join key failed", "left_join"))
        &right_keys.push(key)
    }
    // Every left row yields at least one output row; see inner_join.
    right_counts :: join_key_counts(right_keys)
    total := 0
    loop key in left_keys {
        matches := right_counts.get(key) ?? 0
        if matches == 0 -> matches = 1
        total += matches
        if total > limits.max_join_rows {
            return Err(data_error(DataErrorKind.Limit, "max_join_rows exceeded", "left_join"))
        }
    }
    out := [DataJoin<T, U?>]{}
    loop left_index in 0..<left.len() {
        if (right_counts.get(left_keys[left_index]) ?? 0) == 0 {
            &out.push(DataJoin<T, U?>{left: left[left_index], right: None})
            next
        }
        loop right_index in 0..<right.len() {
            if left_keys[left_index] != right_keys[right_index] -> next
            &out.push(DataJoin<T, U?>{left: left[left_index], right: Val(right[right_index])})
        }
    }
    if out.len() > limits.max_output_rows {
        return Err(data_error(DataErrorKind.Limit, "max_output_rows exceeded", "left_join"))
    }
    Ok(out)
}

fn join_key_counts(keys: [String]) -> [String:Int] Never! {
    counts := [String:Int]{}
    loop key in keys {
        seen :: counts.get(key) ?? 0
        _ :: &counts.add(key, seen + 1)
    }
    counts
}

pub fn pivot_sum<T>(rows: [T], row_key: fn(T) -> String, column_key: fn(T) -> String, value_fn: fn(T) -> Float) -> [DataPivotCell] DataError! {
    limits := DataLimits.safe()
    cells := [DataPivotCell]{}
    loop index in 0..<rows.len() {
        row := rows[index]
        row_name :: row_key(row) ?? return Err(data_error(DataErrorKind.Decode, "pivot row key failed", "pivot_sum"))
        column_name :: column_key(row) ?? return Err(data_error(DataErrorKind.Decode, "pivot column key failed", "pivot_sum"))
        amount :: value_fn(row) ?? return Err(data_error(DataErrorKind.Decode, "pivot value failed", "pivot_sum"))
        if nonfinite(amount) {
            return Err(data_error_at(DataErrorKind.NonFinite, "pivot values must be finite", "pivot_sum", index))
        }
        found := -1
        loop cell_index in 0..<cells.len() {
            if text_compare(cells[cell_index].row_key, row_name) == 0 && text_compare(cells[cell_index].column_key, column_name) == 0 {
                found = cell_index
                break
            }
        }
        if found < 0 {
            if cells.len() >= limits.max_groups {
                return Err(data_error(DataErrorKind.Limit, "max_groups exceeded", "pivot_sum"))
            }
            &cells.push(DataPivotCell{row_key: row_name, column_key: column_name, count: 1, sum: ~amount, mean: amount})
            next
        }
        cell := cells[found]
        cell.count = cell.count + 1
        cell.sum = cell.sum + amount
        if nonfinite(cell.sum) {
            return Err(data_error(DataErrorKind.Overflow, "finite overflow while pivoting", "pivot_sum"))
        }
        cells[found] = cell
    }
    if cells.len() > limits.max_output_rows {
        return Err(data_error(DataErrorKind.Limit, "max_output_rows exceeded", "pivot_sum"))
    }
    loop index in 0..<cells.len() {
        cell := cells[index]
        cell.mean = cell.sum / Float{cell.count}
        if nonfinite(cell.mean) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while pivoting", "pivot_sum"))
        cell.sum = normalize_zero(cell.sum)
        cell.mean = normalize_zero(cell.mean)
        cells[index] = cell
    }
    _ :: sort_pivot_cells(&cells)
    Ok(cells)
}

pub fn plot<T: Encode>(rows: [T]) -> JetDataPlot<T> DataError! {
    core.data.plot<T>(rows)
}

pub fn inspect<T>(plot: JetDataPlot<T>) -> JetDataPlotInspection DataError! {
    plan :: normalize_plot_plan(plot.plan)
    Ok(JetDataPlotInspection{text: plot_inspection_text(plan, plot.rows.len())})
}

pub fn inspect_json<T>(plot: JetDataPlot<T>) -> String DataError! {
    plan :: normalize_plot_plan(plot.plan)
    Ok(plot_plan_json(plan))
}

pub fn text<T>(plot: JetDataPlot<T>) -> String DataError! {
    plan :: normalize_plot_plan(plot.plan)
    Ok(render_plot_text(plan))
}

pub fn svg<T>(plot: JetDataPlot<T>) -> String DataError! {
    plan :: normalize_plot_plan(plot.plan)
    Ok(render_plot_svg(plan))
}

pub fn show<T>(plot: JetDataPlot<T>) -> JetDataPlotRender DataError! {
    render<T>(plot, JetDataPlotBackend.Browser)
}

pub fn render<T>(plot: JetDataPlot<T>, backend: JetDataPlotBackend) -> JetDataPlotRender DataError! {
    plan :: normalize_plot_plan(plot.plan)
    if backend == JetDataPlotBackend.Terminal {
        return Ok(JetDataPlotRender{format: JetDataPlotRenderFormat.Text, body: render_plot_text(plan)})
    }
    Ok(JetDataPlotRender{format: JetDataPlotRenderFormat.SVG, body: render_plot_svg(plan)})
}

pub fn bar_text(groups: [Group<String, Int>]) -> String DataError! {
    labels := [String]{}
    values := [Float]{}
    loop index in 0..<groups.len() {
        group :: groups[index]
        if group.value < 0 {
            return Err(data_error_at(DataErrorKind.InvalidArgument, "plot counts must be non-negative", "bar_text", index))
        }
        value := Float{group.value}
        if nonfinite(value) {
            return Err(data_error_at(DataErrorKind.Overflow, "plot count does not fit in a finite number", "bar_text", index))
        }
        &labels.push(group.key)
        &values.push(value)
    }
    Ok(render_bar_text(labels, values))
}

pub fn bar_svg(groups: [Group<String, Int>]) -> String DataError! {
    labels := [String]{}
    values := [Float]{}
    loop index in 0..<groups.len() {
        group :: groups[index]
        if group.value < 0 {
            return Err(data_error_at(DataErrorKind.InvalidArgument, "plot counts must be non-negative", "bar_svg", index))
        }
        value := Float{group.value}
        if nonfinite(value) {
            return Err(data_error_at(DataErrorKind.Overflow, "plot count does not fit in a finite number", "bar_svg", index))
        }
        &labels.push(group.key)
        &values.push(value)
    }
    Ok(render_bar_svg(labels, values))
}

pub fn line_text(groups: [Group<String, Float>], options: DataLineOptions) -> String DataError! {
    _ :: validate_line_options(options, "line_text")
    labels := [String]{}
