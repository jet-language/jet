#[Copy, Comparable, Hashable, Equatable]
pub enum DataFormat {
    CSV
    JSON
    JSONL
    Parquet
    Arrow
}


#Equatable
pub enum DataErrorKind {
    Decode
    Limit
    IO
    Empty
    InvalidArgument
    NonFinite
    Overflow
    State
    Bridge
    Unsupported
    DuplicateKey
    MissingKey
    WrongOwner
    StaleRevision
    InvalidValue
    impl Display {
        fn display(self) -> String Never! { data_error_kind_text(self) }
    }
    impl Debug {
        fn debug(self) -> String Never! { data_error_kind_text(self) }
    }
}

fn data_error_kind_text(kind: DataErrorKind) -> String Never! {
    if kind == {
        .Decode -> "Decode"
        .Limit -> "Limit"
        .IO -> "IO"
        .Empty -> "Empty"
        .InvalidArgument -> "InvalidArgument"
        .NonFinite -> "NonFinite"
        .Overflow -> "Overflow"
        .State -> "State"
        .Bridge -> "Bridge"
        .Unsupported -> "Unsupported"
        .DuplicateKey -> "DuplicateKey"
        .MissingKey -> "MissingKey"
        .WrongOwner -> "WrongOwner"
        .StaleRevision -> "StaleRevision"
        .InvalidValue -> "InvalidValue"
    }
}

#[Equatable, Error]
pub struct DataError {
    pub kind: DataErrorKind
    pub operation: String
    pub row: Int?
    pub column: Int?
    pub index: Int?
    pub reason: String
    pub cause: EncodingError?
    impl Display {
        fn display(self) -> String Never! { data_error_text(self) }
    }
    impl Debug {
        fn debug(self) -> String Never! { data_error_text(self) }
    }
}

impl DataError {
    pub fn new(kind: DataErrorKind, message: String, path: String) -> DataError Never! {
        return DataError{
            kind: kind,
            operation: ~path,
            row: None,
            column: None,
            index: None,
            reason: message,
            cause: None,
        }
    }
}
fn data_error(kind: DataErrorKind, message: String, operation: String) -> DataError Never! {
    DataError{
        kind: kind,
        operation: operation,
        row: None,
        column: None,
        index: None,
        reason: message,
        cause: None,
    }
}

fn data_error_text(error: DataError) -> String Never! {
    text := "{data_error_kind_text(error.kind)} {error.operation}"
    if error.row == .Val(row) -> text = "{text}, row {row}"
    if error.column == .Val(column) -> text = "{text}, column {column}"
    if error.index == .Val(index) -> text = "{text}, index {index}"
    "{text}: {error.reason}"
}

fn data_error_at(kind: DataErrorKind, message: String, operation: String, index: Int) -> DataError Never! {
    DataError{
        kind: kind,
        operation: operation,
        row: None,
        column: None,
        index: Val(index),
        reason: message,
        cause: None,
    }
}

fn nonfinite(value: Float) -> Bool Never! {
    if math.is_finite(value) -> return false
    true
}


