/// Native facts and live, explicitly opted-in bridge availability.
fn status() -[FS, Env]> [DataStatus] Never! {
    rows := [DataStatus]{}
    native_steps :: [String]{"core.data.csv", "core.data.stats", "core.data.query", "core.data.stream", "core.data.schema", "core.data.json"}
    loop step in native_steps {
        &rows.push(DataStatus{step: step, path: "native", clone_value: "none", ownership: "jet", trust: "native", fallback: "none", replacement: "native"})
    }
    bridge_steps :: [String]{"py.*", "r.*", "gpu.*"}
    loop step in bridge_steps -> &rows.push(bridge_status(step))
    rows
}

fn require_bridge(provider: String) DataError! -[FS, Env]> {
    step :: bridge_provider(provider) ?? return Err(data_error(DataErrorKind.InvalidArgument, "unknown data bridge provider `{provider}`; expected py, r, or gpu", "require_bridge"))
    facts :: bridge_status(step)
    if facts.path == "available" -> return Ok(())
    return Err(data_error(DataErrorKind.Bridge, "{step} unavailable (clone_value={facts.clone_value}, ownership={facts.ownership}, trust={facts.trust}, fallback={facts.fallback}, replacement={facts.replacement})", "require_bridge"))
}

fn bridge_provider(provider: String) -> String? Never! {
    name := trim(provider)
    loop name.ends_with(".") -> name = String.from_bytes(name.bytes()[0..<name.bytes().len() - 1]) ?? ""
    if name.ends_with(".*") -> name = String.from_bytes(name.bytes()[0..<name.bytes().len() - 2]) ?? ""
    name = upper(name)
    if name == "PY" || name == "PYTHON" -> return Val("py.*")
    if name == "R" -> return Val("r.*")
    if name == "GPU" || name == "CUDA" || name == "METAL" || name == "VULKAN" || name == "WEBGPU" -> return Val("gpu.*")
    None
}

fn bridge_status(step: String) -[FS, Env]> DataStatus Never! {
    path := "unavailable"
    if step == "r.*" && bridge_tool_on_path("Rscript") {
        if sys.get("JET_DATA_R_BRIDGE") == .Val(enabled) {
            if enabled == "1" -> path = "available"
        }
    }
    if step == "py.*" -> return DataStatus{step: step, path: path, clone_value: "owned-copy", ownership: "python-sidecar", trust: "untrusted-foreign", fallback: "none", replacement: "core.data native lists/query/stats"}
    if step == "r.*" -> return DataStatus{step: step, path: path, clone_value: "owned-copy", ownership: "r-sidecar", trust: "untrusted-foreign", fallback: "none", replacement: "core.data Query<T> typed round-trip"}
    DataStatus{step: step, path: path, clone_value: "device-transfer", ownership: "device-buffer", trust: "untrusted-accelerator", fallback: "none", replacement: "core.data / Tensor native CPU path"}
}

fn bridge_tool_on_path(tool: String) -[FS, Env]> Bool Never! {
    // Keep opaque native path bytes: PATH need not be UTF-8.
    path :: core.sys.__host_env("PATH") ?? return false
    windows :: sys.is_windows()
    delimiter :: if windows -> U8{59} else -> U8{58}
    directory := [U8]{}
    quoted := false
    index := 0
    loop {
        at_end :: index == path.len()
        if !at_end {
            b :: path[index]
            index += 1
            if windows && b == (U8{34}) {
                quoted = !quoted
                next
            }
            if b != delimiter || quoted {
                &directory.push(b)
                next
            }
        }
        if directory.len() > 0 {
            last :: directory[directory.len() - 1]
            drive_relative :: windows && directory.len() == 2 && directory[1] == (U8{58})
            if last != (U8{47}) && (!windows || last != (U8{92})) && !drive_relative {
                &directory.push(if windows -> U8{92} else -> U8{47})
            }
        }
        loop b in tool.bytes() -> &directory.push(b)
        is_file := false
        #Unsafe("native path bytes originate from the host environment and are split at ASCII boundaries") {
            is_file = core.data.__host_path_is_file(directory) ?? false
        }
        if is_file -> return true
        if at_end -> break
        directory = [U8]{}
    }
    false
}

fn make_loader<T>(kind: DataLoaderKind, locator: String, member: String, parameters: [String], format_name: String, authority_name: String, limits: DataLimits) -> DataLoader<T> DataError! {
    if !valid_encoding_limits(limits.encoding) {
        return Err(data_error(DataErrorKind.Limit, "encoding limits are outside their safe ranges", "data.loader"))
    }
    if limits.max_groups <= 0 || limits.max_sort_rows <= 0 || limits.max_join_rows <= 0 || limits.max_output_rows <= 0 {
        return Err(data_error(DataErrorKind.InvalidArgument, "data limits must be positive", "data.loader"))
    }
    if !valid_public_text(locator, false) {
        return Err(data_error(DataErrorKind.InvalidArgument, "source locator is invalid", "data.loader"))
    }
    if member.len() > 0 && !valid_public_text(member, false) {
        return Err(data_error(DataErrorKind.InvalidArgument, "archive member is invalid", "data.loader"))
    }
    if kind != DataLoaderKind.File && member.len() > 0 {
        return Err(data_error(DataErrorKind.InvalidArgument, "only file loaders may carry an archive member", "data.loader"))
    }
    loop parameter in parameters {
        if !valid_public_text(parameter, true) {
            return Err(data_error(DataErrorKind.InvalidArgument, "loader parameter is invalid", "data.loader"))
        }
    }
    if !valid_public_text(authority_name, false) || !valid_authority(authority_name) {
        return Err(data_error(DataErrorKind.InvalidArgument, "loader authority is invalid", "data.loader"))
    }
    format :: parse_format(format_name) ?? return Err(data_error(DataErrorKind.InvalidArgument, "unknown data format", "data.loader"))
    source := DataSourceIdentity{kind: kind, locator: public_locator(kind, locator), member: member, parameters: public_parameters(parameters)}
    authority := DataAuthority{scope: authority_name.copy(), revision: ""}
    status := DataLoaderStatus{
        identity: "",
        freshness: DataFreshness.Pending,
        invalidated_by: .NoCause,
        error: "",
        cleanup: "none",
        buffered_bytes: 0,
        backpressure: false,
        last_good: false,
    }
    Ok(DataLoader<T>{
        source: source,
        format: format,
        authority: authority,
        limits: limits,
        payload: None,
        last_good: None,
        cancelled: false,
        offline: false,
        status: status,
    })
}

fn public_parameters(values: [String]) -> [String] Never! {
    out := [String]{}
    loop value in values -> &out.push(public_parameter(value))
    out
}

fn public_parameter(value: String) -> String Never! {
    normalized := trim(value)
    if normalized.len() == 0 -> return ""
    parts :: normalized.split("=").to_list()
    if parts.len() < 2 -> return "value-{sha256(normalized.bytes()).hex()}"
    key :: trim(parts[0])
    if key.len() == 0 -> return "value-{sha256(normalized.bytes()).hex()}"
    parameter_value :: parts[1]
    upper_key :: upper(key)
    upper_value :: upper(parameter_value)
    sensitive_key := upper_key.contains("PASSWORD") || upper_key.contains("PASSWD") || upper_key.contains("PWD") || upper_key.contains("SECRET") || upper_key.contains("TOKEN") || upper_key.contains("CREDENTIAL") || upper_key.contains("AUTH") || upper_key.contains("API_KEY") || upper_key.contains("APIKEY") || upper_key.contains("ACCESS_KEY") || upper_key.contains("ACCESS-TOKEN") || upper_key.contains("SIGNATURE") || upper_key.contains("COOKIE") || upper_key.contains("SESSION") || upper_key.contains("PRIVATE_KEY") || upper_key.contains("PRIVATE-KEY") || upper_key.contains("BEARER")
    sensitive_value := upper_value.starts_with("BEARER ") || upper_value.starts_with("BASIC ") || upper_value.starts_with("-----BEGIN") || upper_value.starts_with("PASSWORD=") || upper_value.starts_with("SECRET=") || upper_value.starts_with("TOKEN=") || upper_value.starts_with("CREDENTIAL=") || upper_value.starts_with("AUTHORIZATION=")
    if sensitive_key || sensitive_value -> return "{key}=<redacted>"
    normalized
}

fn public_locator(kind: DataLoaderKind, locator: String) -> String Never! {
    if kind == DataLoaderKind.Database -> return "query-{sha256(locator.bytes()).hex()}"
    if kind != DataLoaderKind.URL -> return locator.copy()
    fragment_parts :: locator.split("#").to_list()
    without_fragment :: fragment_parts[0]
    query_parts :: without_fragment.split("?").to_list()
    base := query_parts[0]
    scheme_parts :: base.split("://").to_list()
    if scheme_parts.len() > 1 {
        path_parts :: scheme_parts[1].split("/").to_list()
        authority_parts :: path_parts[0].split("@").to_list()
        authority :: authority_parts[authority_parts.len() - 1]
        base = "{scheme_parts[0]}://{authority}"
        loop i in 1..<path_parts.len() -> base = "{base}/{path_parts[i]}"
    }
    if query_parts.len() == 1 -> return base
    public_query := [String]{}
    loop parameter in query_parts[1].split("&") -> &public_query.push(public_parameter(parameter))
    "{base}?{public_query.join("&")}"
}

fn valid_encoding_limits(limits: EncodingLimits) -> Bool Never! {
    if limits.buffer_bytes < 4096 || limits.buffer_bytes > 16777216 -> return false
    if limits.max_depth < 1 || limits.max_depth > 4096 -> return false
    if limits.max_item_bytes < 1 || limits.max_item_bytes > 1073741824 -> return false
    if limits.max_total_bytes != None {
        total :: limits.max_total_bytes ?? 0
        if total < 0 -> return false
    }
    if limits.max_expansion_depth < 0 || limits.max_expansion_depth > 256 -> return false
    if limits.max_expansion_bytes < 0 || limits.max_expansion_bytes > 1073741824 -> return false
    true
}

fn valid_public_text(text: String, allow_empty: Bool) -> Bool Never! {
    raw :: text.bytes()
    if raw.len() == 0 -> return allow_empty
    if raw.len() > 4096 -> return false
    has_nonspace := false
    loop byte in raw {
        if byte < (U8{32}) || byte == (U8{127}) -> return false
        if byte != (U8{32}) -> has_nonspace = true
    }
    has_nonspace
}

fn valid_authority(text: String) -> Bool Never! {
    normalized := upper(text)
    if normalized.starts_with("BEARER ") || normalized.starts_with("BASIC ") -> return false
    if normalized.starts_with("PASSWORD=") || normalized.starts_with("SECRET=") || normalized.starts_with("TOKEN=") || normalized.starts_with("CREDENTIAL=") || normalized.starts_with("AUTHORIZATION=") -> return false
    loop byte in text.bytes() {
        if byte == (U8{61}) || byte == (U8{38}) -> return false
    }
    true
}

fn parse_format(name: String) -> DataFormat? Never! {
    normalized := upper(name)
    if normalized == {
        "CSV" -> Val(DataFormat.CSV)
        "JSON" -> Val(DataFormat.JSON)
        "JSONL" -> Val(DataFormat.JSONL)
        "NDJSON" -> Val(DataFormat.JSONL)
        "PARQUET" -> Val(DataFormat.Parquet)
        "ARROW" -> Val(DataFormat.Arrow)
        "ARROW-IPC" -> Val(DataFormat.Arrow)
        "FEATHER" -> Val(DataFormat.Arrow)
        else -> None
    }
}


fn normalize_zero(value: Float) -> Float Never! {
    if value == (Float{0.0}) -> return Float{0.0}
    value
}

fn compensated_sum(values: [Float], operation: String) -> Float DataError! {
    compensated_sum_range(values, 0, values.len(), operation)
}

fn compensated_sum_range(values: [Float], start: Int, end: Int, operation: String) -> Float DataError! {
    total := Float{0.0}
    correction := Float{0.0}
    loop index in start..<end {
        value :: values[index]
        if nonfinite(value) {
            return Err(data_error_at(DataErrorKind.NonFinite, "numeric input must be finite", operation, index))
        }
        next_total := total + value
        if math.fabs(total) >= math.fabs(value) {
            correction = correction + (total - next_total) + value
        } else {
            correction = correction + (value - next_total) + total
        }
        total = next_total
        if nonfinite(total) || nonfinite(correction) {
            return Err(data_error(DataErrorKind.Overflow, "finite overflow while summing", operation))
        }
    }
    result := total + correction
    if nonfinite(result) -> return Err(data_error(DataErrorKind.Overflow, "finite overflow while summing", operation))
    Ok(normalize_zero(result))
}
fn sort_pivot_cells(cells: &[DataPivotCell]) Never! {
    loop i in 1..<cells.len() {
        j := i
        loop j > 0 {
            if !pivot_before(cells[j], cells[j - 1]) -> break
            current := cells[j]
            cells[j] = cells[j - 1]
            cells[j - 1] = current
            j = j - 1
        }
    }
}

fn pivot_before(left: DataPivotCell, right: DataPivotCell) -> Bool Never! {
    row_order := text_compare(left.row_key, right.row_key)
    if row_order < 0 -> return true
    if row_order > 0 -> return false
    text_compare(left.column_key, right.column_key) < 0
}

fn text_compare(left: String, right: String) -> Int Never! {
    a :: left.bytes()
    b :: right.bytes()
    n := a.len()
    if b.len() < n -> n = b.len()
    loop i in 0..<n {
        if a[i] < b[i] -> return -1
        if a[i] > b[i] -> return 1
    }
    if a.len() < b.len() -> return -1
    if a.len() > b.len() -> return 1
    0
}


fn snapshot_from_rows<T>(rows: [T]) -> DataSnapshot<[T]> Never! {
    source := DataSourceIdentity{kind: DataLoaderKind.Value, locator: "rows", member: "", parameters: [String]{}}
    authority := DataAuthority{scope: "local", revision: ""}
    return DataSnapshot<[T]>{
        value: rows,
        identity: DataSnapshotIdentity{id: "rows", source: "rows", content: "", schema: "", format: DataFormat.JSON},
        provenance: DataProvenance{source: source, format: DataFormat.JSON, authority: authority},
        schema: DataSchema{identity: "rows", format: DataFormat.JSON, columns: [DataColumn]{}, projection: None},
        status: DataLoaderStatus{identity: "rows", freshness: DataFreshness.Fresh, invalidated_by: .NoCause, error: "", cleanup: "", buffered_bytes: 0, backpressure: false, last_good: true},
        content: [U8]{},
    }
}

fn sort_floats(values: [Float]) -> [Float] Never! {
    out := [Float]{}
    loop value in values -> &out.push(value)
    loop i in 0..<out.len() {
        loop j in (i + 1)..<out.len() {
            if out[j] < out[i] {
                value := out[i]
                out[i] = out[j]
                out[j] = value
            }
        }
    }
    out
}
fn render_bar_text(labels: [String], values: [Float]) -> String Never! {
    bounds :: value_bounds(values)
    minimum :: bounds.min
    maximum :: bounds.max
    baseline := scale_between(Float{0.0}, minimum, maximum, 20)
    out := ""
    loop i in 0..<labels.len() {
        v := values[i]
        bar := ""
        if v >= (Float{0.0}) {
            width := 0
            if maximum > (Float{0.0}) -> width = scale_between(v, Float{0.0}, maximum, 20 - baseline)
            loop _ in 0..<baseline -> bar = "{bar} "
            loop _ in 0..<width -> bar = "{bar}#"
        } else {
            width := 0
            if minimum < (Float{0.0}) -> width = scale_between(v, minimum, Float{0.0}, baseline)
            loop _ in 0..<width -> bar = "{bar}<"
        }
        out = "{out}{labels[i]} | {bar} {v}\n"
    }
    out
}

fn render_bar_svg(labels: [String], values: [Float]) -> String Never! {
    bounds :: value_bounds(values)
    minimum :: bounds.min
    maximum :: bounds.max
    baseline := 100
    if maximum > minimum -> baseline = scale_between(Float{0.0}, minimum, maximum, 200)
    w := 320
    h := 24 * labels.len() + 16
    out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{w}\" height=\"{h}\">"
    loop i in 0..<labels.len() {
        v := values[i]
        y := 8 + i * 24
        x := 80 + baseline
        bw := 0
        if v >= (Float{0.0}) {
            if maximum > (Float{0.0}) -> bw = scale_between(v, Float{0.0}, maximum, 200 - baseline)
        } else {
            if minimum < (Float{0.0}) -> bw = scale_between(v, minimum, Float{0.0}, baseline)
            x = x - bw
        }
        out = "{out}<text x=\"4\" y=\"{y + 12}\" font-size=\"12\">{xml_escape(labels[i])}</text>"
        out = "{out}<rect x=\"{x}\" y=\"{y}\" width=\"{bw}\" height=\"16\" fill=\"#4a90d9\"/>"
    }
    "{out}<line x1=\"{80 + baseline}\" y1=\"0\" x2=\"{80 + baseline}\" y2=\"{h}\" stroke=\"#777\" stroke-width=\"1\"/></svg>"
}

fn render_line_text(labels: [String], values: [Float]) -> String Never! {
    out := ""
    loop i in 0..<labels.len() {
        out = "{out}{labels[i]}={values[i]}\n"
    }
    out
}

fn render_line_svg(labels: [String], values: [Float]) -> String Never! {
    n :: labels.len()
    w := 320
    h := 120
    bounds :: value_bounds(values)
    out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{w}\" height=\"{h}\"><polyline fill=\"none\" stroke=\"#4a90d9\" points=\""
    loop i in 0..<n {
        x := 8
        if n > 1 -> x = i * (w - 16) /% (n - 1) + 8
        y :: h - 8 - scale_between(values[i], bounds.min, bounds.max, h - 16)
        if i > 0 -> out = "{out} "
        out = "{out}{x},{y}"
    }
    "{out}\"/></svg>"
}

fn render_point_svg(labels: [String], values: [Float]) -> String Never! {
    n :: labels.len()
    w := 320
    h := 120
    bounds :: value_bounds(values)
    out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{w}\" height=\"{h}\">"
    loop i in 0..<n {
        x := 8
        if n > 1 -> x = i * (w - 16) /% (n - 1) + 8
        y :: h - 8 - scale_between(values[i], bounds.min, bounds.max, h - 16)
        out = "{out}<circle cx=\"{x}\" cy=\"{y}\" r=\"3\" fill=\"#4a90d9\"/>"
        out = "{out}<text x=\"{x}\" y=\"{h - 1}\" font-size=\"10\">{xml_escape(labels[i])}</text>"
    }
    "{out}</svg>"
}

fn value_bounds(values: [Float]) -> (min: Float, max: Float) Never! {
    minimum := Float{0.0}
    maximum := Float{0.0}
    loop value in values {
        if value < minimum -> minimum = value
        if value > maximum -> maximum = value
    }
    if minimum == maximum {
        minimum = minimum - (Float{1.0})
        maximum = maximum + (Float{1.0})
    }
    (min: minimum, max: maximum)
}

fn scale_between(value: Float, minimum: Float, maximum: Float, extent: Int) -> Int Never! {
    if extent <= 0 || maximum <= minimum -> return 0
    ratio := (value - minimum) / (maximum - minimum)
    if ratio <= (Float{0.0}) -> return 0
    if ratio >= (Float{1.0}) -> return extent
    Int.from_float(ratio * Float{extent}) ?? panic("plot coordinate must be finite")
}


fn validate_line_options(options: DataLineOptions, operation: String) DataError! {
    if options.reference != None {
        reference :: options.reference ?? Float{0.0}
        if nonfinite(reference) -> return Err(data_error(DataErrorKind.NonFinite, "reference line must be finite", operation))
    }
    if options.style != "solid" && options.style != "dashed" && options.style != "dotted" {
        return Err(data_error(DataErrorKind.InvalidArgument, "line style must be solid, dashed, or dotted", operation))
    }
    if options.color.len() == 0 -> return Err(data_error(DataErrorKind.InvalidArgument, "line color must not be empty", operation))
    return Ok()
}

fn normalize_plot_plan(plan: JetDataPlotPlan) -> JetDataPlotPlan DataError! {
    values := [Float]{}
    loop i in 0..<plan.labels.len() {
        value := Float{0.0}
        if i < plan.values.len() -> value = plan.values[i]
        if nonfinite(value) {
            return Err(data_error_at(DataErrorKind.NonFinite, "plot values must be finite", "plot", i))
        }
        &values.push(value)
    }
    height := 24 * plan.labels.len() + 16
    if plan.mark == JetDataPlotMark.Line || plan.mark == JetDataPlotMark.Point -> height = 120
    if height < 16 -> height = 16
    Ok(JetDataPlotPlan{
        mark: plan.mark,
        labels: plan.labels,
        values: values,
        layout: JetDataPlotLayout{width: 320, height: height},
        encoding: plan.encoding,
        schema: plan.schema,
    })
}

fn plot_mark_name(mark: JetDataPlotMark) -> String Never! {
    if mark == JetDataPlotMark.Line -> return "line"
    if mark == JetDataPlotMark.Point -> return "point"
    "bar"
}

fn plot_plan_json(plan: JetDataPlotPlan) -> String Never! {
    "{{\"mark\":\"{plot_mark_name(plan.mark)}\",\"n\":{plan.labels.len()},\"width\":{plan.layout.width},\"height\":{plan.layout.height}}}"
}

fn plot_inspection_text(plan: JetDataPlotPlan, rows: Int) -> String Never! {
    "plot mark={plot_mark_name(plan.mark)} rows={rows} labels={plan.labels.len()} width={plan.layout.width} height={plan.layout.height}"
}

fn render_plot_text(plan: JetDataPlotPlan) -> String Never! {
    if plan.mark == JetDataPlotMark.Line -> return render_line_text(plan.labels, plan.values)
    if plan.mark == JetDataPlotMark.Point {
        out := ""
        loop i in 0..<plan.labels.len() -> out = "{out}{plan.labels[i]}: {plan.values[i]}\n"
        return out
    }
    render_bar_text(plan.labels, plan.values)
}

fn render_plot_svg(plan: JetDataPlotPlan) -> String Never! {
    if plan.mark == JetDataPlotMark.Line -> return render_line_svg(plan.labels, plan.values)
    if plan.mark == JetDataPlotMark.Point -> return render_point_svg(plan.labels, plan.values)
    render_bar_svg(plan.labels, plan.values)
}

fn render_line_options_text(labels: [String], values: [Float], options: DataLineOptions) -> String Never! {
    points := ""
    loop i in 0..<values.len() {
        if i > 0 -> points = "{points} -> "
        points = "{points}{values[i]}"
    }
    label_text := ""
    loop i in 0..<labels.len() {
        if i > 0 -> label_text = "{label_text} | "
        label_text = "{label_text}{labels[i]}"
    }
    out := ""
    if options.title.len() > 0 -> out = "{out}{options.title}\n"
    out = "{out}{options.x_label}: {label_text}\n{options.y_label}: {points}\n"
    markers := "off"
    if options.markers -> markers = "on"
    out = "{out}line: style={options.style} color={options.color} markers={markers}"
    if options.reference != None {
        reference :: options.reference ?? Float{0.0}
        out = "{out}\nreference: {reference}"
    }
    if options.legend.len() > 0 -> out = "{out}\nlegend: {options.legend}"
    out
}

fn render_line_options_svg(labels: [String], values: [Float], options: DataLineOptions) -> String Never! {
    n := labels.len()
    w := 640
    h := 360
    left := 64
    right := 24
    top := 44
    bottom := 52
    plot_w := w - left - right
    plot_h := h - top - bottom
    minimum := Float{0.0}
    maximum := Float{0.0}
    loop value in values {
        if value < minimum -> minimum = value
        if value > maximum -> maximum = value
    }
    if options.reference != None {
        reference :: options.reference ?? Float{0.0}
        if reference < minimum -> minimum = reference
        if reference > maximum -> maximum = reference
    }
    if minimum == maximum {
        minimum = minimum - Float{1.0}
        maximum = maximum + Float{1.0}
    }
    out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{w}\" height=\"{h}\" viewBox=\"0 0 {w} {h}\"><title>{xml_escape(options.title)}</title><rect width=\"{w}\" height=\"{h}\" fill=\"white\"/>"
    points := ""
    loop i in 0..<n {
        x := left + plot_w /% 2
        if n > 1 -> x = left + plot_w * i /% (n - 1)
        y := top + (Int.from_float((maximum - values[i]) * Float{plot_h} / (maximum - minimum)) ?? panic("plot coordinate must be finite"))
        if i > 0 -> points = "{points} "
        points = "{points}{x},{y}"
    }
    dash := ""
    if options.style == "dashed" -> dash = " stroke-dasharray=\"8 5\""
    if options.style == "dotted" -> dash = " stroke-dasharray=\"2 5\""
    out = "{out}<polyline fill=\"none\" stroke=\"{xml_escape(options.color)}\" stroke-width=\"2\"{dash} points=\"{points}\"/>"
    if options.markers {
        loop i in 0..<n {
            x := left + plot_w /% 2
            if n > 1 -> x = left + plot_w * i /% (n - 1)
            y := top + (Int.from_float((maximum - values[i]) * Float{plot_h} / (maximum - minimum)) ?? panic("plot coordinate must be finite"))
            out = "{out}<circle cx=\"{x}\" cy=\"{y}\" r=\"4\" fill=\"{xml_escape(options.color)}\"/>"
        }
    }
    if options.reference != None {
        reference :: options.reference ?? Float{0.0}
        y := top + (Int.from_float((maximum - reference) * Float{plot_h} / (maximum - minimum)) ?? panic("plot reference must be finite"))
        out = "{out}<line x1=\"{left}\" y1=\"{y}\" x2=\"{w - right}\" y2=\"{y}\" stroke=\"#888\" stroke-dasharray=\"4 4\"/>"
    }
    loop i in 0..<n {
        x := left + plot_w /% 2
        if n > 1 -> x = left + plot_w * i /% (n - 1)
        out = "{out}<text x=\"{x}\" y=\"{h - bottom + 18}\" font-size=\"11\" text-anchor=\"middle\">{xml_escape(labels[i])}</text>"
    }
    out = "{out}<text x=\"{w /% 2}\" y=\"24\" text-anchor=\"middle\" font-size=\"16\">{xml_escape(options.title)}</text>"
    out = "{out}<text x=\"{w /% 2}\" y=\"{h - 10}\" text-anchor=\"middle\" font-size=\"12\">{xml_escape(options.x_label)}</text>"
    out = "{out}<text x=\"16\" y=\"{h /% 2}\" text-anchor=\"middle\" font-size=\"12\">{xml_escape(options.y_label)}</text>"
    if options.legend.len() > 0 -> out = "{out}<text x=\"{w - right - 120}\" y=\"{top - 12}\" fill=\"{xml_escape(options.color)}\">{xml_escape(options.legend)}</text>"
    "{out}</svg>"
}

fn xml_escape(text: String) -> String Never! {
    out := ""
    chunk := [U8]{}
    loop byte in text.bytes() {
        entity := ""
        if byte == (U8{38}) -> entity = "&amp;"
        else if byte == (U8{60}) -> entity = "&lt;"
        else if byte == (U8{62}) -> entity = "&gt;"
        else if byte == (U8{34}) -> entity = "&quot;"
        else if byte == (U8{39}) -> entity = "&apos;"
        if entity.len() > 0 {
            chunk_text :: String.from_bytes(chunk) ?? ""
            out = "{out}{chunk_text}{entity}"
            chunk = [U8]{}
        } else {
            &chunk.push(byte)
        }
    }
    tail :: String.from_bytes(chunk) ?? ""
    out = "{out}{tail}"
    out
}

fn trim(text: String) -> String Never! {
    raw :: text.bytes()
    s := 0
    e := raw.len()
    loop s < e {
        n :: raw[s]
        if n == 32 || n == 9 || n == 10 || n == 13 -> s = s + 1 else { break }
    }
    loop e > s {
        n :: raw[e - 1]
        if n == 32 || n == 9 || n == 10 || n == 13 -> e = e - 1 else { break }
    }
    if s == 0 && e == raw.len() -> return String.from_bytes(raw) ?? ""
    if e <= s -> return ""
    String.from_bytes(raw[s..(e - 1)]) ?? ""
}

fn upper(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n :: b
        if n >= 97 && n <= 122 -> &out.push(U8{n - 32}) else -> &out.push(b)
    }
    String.from_bytes(out) ?? ""
}

#Test("Plot aggregate absence is the native enum constructor") {
    none :: plot.__plot_aggregate_none()
    assert(none == plot.__plot_aggregate_none())
    assert(none != JetDataPlotAggregate.Sum)
}

// Native DataFlow.rs::jet_data_loader_canonical_tree sorts object keys by
// UTF-8 lexical order, but keeps Debug float spelling and exact Number text.
fn data_loader_put_text(out: &[U8], text: String) Never! {
    loop index in 0..<text.count_bytes() -> &out.push(encoding_stream.byte_at(text, index))
}

fn data_loader_put_control(out: &[U8], value: Int) Never! {
    &out.push(U8{92})
    &out.push(U8{117})
    &out.push(U8{48})
    &out.push(U8{48})
    hex :: "0123456789abcdef"
    &out.push(encoding_stream.byte_at(hex, value >> 4))
    &out.push(encoding_stream.byte_at(hex, value.bit_and(15)))
}

fn data_loader_quote(out: &[U8], text: String) Never! {
    &out.push(U8{34})
    index := 0
    loop index < text.count_bytes() {
        byte :: encoding_stream.byte_at(text, index)
        n :: Int.from_u8(byte)
        if n == 34 || n == 92 {
            &out.push(U8{92})
            &out.push(byte)
        } else if n == 10 || n == 13 || n == 9 {
            &out.push(U8{92})
            &out.push(if n == 10 -> U8{110} else if n == 13 -> U8{114} else -> U8{116})
        } else if n < 32 || n == 127 {
            data_loader_put_control(&out, n)
        } else if n == 194 && index + 1 < text.count_bytes() && Int.from_u8(encoding_stream.byte_at(text, index + 1)) <= 159 {
            // Rust char::is_control includes the C1 scalars U+0080..U+009F.
            index += 1
            data_loader_put_control(&out, Int.from_u8(encoding_stream.byte_at(text, index)))
        } else {
            &out.push(byte)
        }
        index += 1
    }
    &out.push(U8{34})
}

fn data_loader_render(out: &[U8], tree: encoding.Dyn) Never! {
    #Unsafe("inspect existing private Decode carriers only inside checked Core data source") {
        if tree == .Number(text) {
            data_loader_put_text(&out, text)
            return
        }
        if tree == .Bytes(bytes) {
            &out.push(U8{91})
            loop (index, byte) in bytes {
                if index != 0 -> &out.push(U8{44})
                data_loader_put_text(&out, "{byte}")
            }
            &out.push(U8{93})
            return
        }
    }
    if tree == {
        .Null -> data_loader_put_text(&out, "null")
        .Bool(value) -> data_loader_put_text(&out, if value -> "true" else -> "false")
        .Int(value) -> data_loader_put_text(&out, "{value}")
        .Float(value) -> data_loader_put_text(&out, "{value:Debug}")
        .Text(value) -> data_loader_quote(&out, value)
        .Array(values) -> {
            &out.push(U8{91})
            loop (index, value) in values {
                if index != 0 -> &out.push(U8{44})
                data_loader_render(&out, value)
            }
            &out.push(U8{93})
        }
        .Object(_) -> {
            // Sort the owned entries directly; the comparator captures no tree.
            entries := encoding_stream.object_entries(tree)
            &entries.sort_by((left: (key: String, value: Dyn), right: (key: String, value: Dyn)) -> left.key <=> right.key)
            &out.push(U8{123})
            loop (position, entry) in entries {
                if position != 0 -> &out.push(U8{44})
                data_loader_quote(&out, entry.key)
                &out.push(U8{58})
                data_loader_render(&out, entry.value)
            }
            &out.push(U8{125})
        }
        else -> panic("unknown native Dyn carrier")
    }
}

fn data_loader_check_payload(limits: DataLimits, bytes: Int, operation: String) DataError! {
    if bytes > limits.encoding.max_item_bytes -> return Err(data_error(.Limit, "payload is {bytes} bytes; max_item_bytes is {limits.encoding.max_item_bytes}", operation))
    if limits.encoding.max_total_bytes == .Val(limit) {
        if bytes > limit -> return Err(data_error(.Limit, "payload is {bytes} bytes; max_total_bytes is {limit}", operation))
    }
    Ok(())
}

#Encode
struct DataLoaderPortRecord {
    z: Float
    a: String
}

#Test("value loader preserves canonical payload and user-record return type") {
    record :: DataLoaderPortRecord{z: Float{2.0}, a: "x"}
    loader :: value<DataLoaderPortRecord>(record, DataLimits.safe()) ?? panic("value loader")
    payload :: loader.payload ?? panic("value payload")
    assert_eq(payload, [U8]{123, 34, 97, 34, 58, 34, 120, 34, 44, 34, 122, 34, 58, 50, 46, 48, 125})
    assert_eq(loader.source.kind, DataLoaderKind.Value)
    assert_eq(loader.source.locator, "value")
    assert_eq(loader.authority.scope, "local")
    assert_eq(loader.format, DataFormat.JSON)
    assert(loader.last_good == None)
    assert(!loader.cancelled)
    assert(!loader.offline)

    limits := DataLimits.safe()
    limits.encoding.max_item_bytes = 1
    limits.encoding.buffer_bytes = 1
    if value<String>("x", limits) == {
        .Err(error) -> {
            assert(error.kind == .Limit)
            assert_eq(error.operation, "data.value")
            assert_eq(error.reason, "payload is 3 bytes; max_item_bytes is 1")
        }
        else -> panic("value payload limit must precede constructor validation")
    }
}

#Test("value canonical strings retain native C0 and C1 control escaping") {
    text :: encoding_stream.text_from_bytes([U8]{8, 127, 194, 128, 194, 159, 9}) ?? panic("control text")
    out := [U8]{}
    data_loader_quote(&out, text)
    assert_eq(out, [U8]{34, 92, 117, 48, 48, 48, 56, 92, 117, 48, 48, 55, 102, 92, 117, 48, 48, 56, 48, 92, 117, 48, 48, 57, 102, 92, 116, 34})
}

#Test("data CSV and JSON preserve malformed input field-error strings") {
    if csv<Int>("n\n\"7\"x") == {
        .Err(errors) -> {
            assert_eq(errors.len(), 1)
            assert_eq(errors[0].path, "")
            assert_eq(errors[0].reason, "E2701: CSV row 2, line 2, column 4 — only quote, comma, CRLF, LF, or EOF may follow a closing quote")
        }
        else -> panic("malformed CSV accepted")
    }
    if json<Int>("[1e]") == {
        .Err(errors) -> {
            assert_eq(errors.len(), 1)
            assert_eq(errors[0].path, "")
            assert_eq(errors[0].reason, "invalid JSON (line 1): bad number")
        }
        else -> panic("malformed JSON accepted")
    }
}

