name: "core"
version: "0.0.1"
edition: "2026"
// Core's layer table, lowest layer first. A Core module names only modules of
// its own layer or a lower one. A module sits in the layer of the longest name
// listed here that it equals or sits under.
layers: {
    prelude: ["core.prelude", "core.mem", "core.reflect", "core.meta", "core.sync"]
    data: ["core.text", "core.math", "core.collections", "core.time", "core.encoding", "core.regex", "core.units", "core.compute", "core.log", "core.event"]
    system: ["core.sys", "core.rt", "core.files", "core.crypto", "core.net", "core.process", "core.tasks", "core.term", "core.watcher", "core.args", "core.perf", "core.testing", "core.plugin", "core.mod", "core.archive", "core.vendor"]
    services: ["core.http", "core.db", "core.data", "core.encoding.csv", "core.net.ws", "core.ui", "core.web", "core.app", "core.auth", "core.service", "core.jobs", "core.game", "core.reactive", "core.tui", "core.devtools", "core.build", "core.compiler"]
}
