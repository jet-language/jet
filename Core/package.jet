name: "core"
version: "0.0.1"
edition: "2026"
// Core's layer table, lowest layer first. A Core module names only modules of
// its own layer or a lower one. A module sits in the layer of the longest name
// listed here that it equals or sits under.
layers: {
    prelude: ["jet_builtins", "core.prelude", "core.mem", "core.reflect", "core.meta", "core.sync", "core.debug"]
    data: ["core.text", "core.math", "core.collections", "core.time", "core.encoding", "core.regex", "core.grammar", "core.units", "core.data", "core.compute", "core.crypto", "core.log", "core.event", "core.color", "core.target"]
    system: ["core.sys", "core.rt", "core.files", "core.net", "core.process", "core.tasks", "core.term", "core.watcher", "core.args", "core.perf", "core.testing", "core.plugin", "core.mod", "core.archive", "core.image", "core.vendor", "core.git", "core.actor"]
    services: ["core.http", "core.db", "core.net.ws", "core.ui", "core.web", "app", "core.auth", "core.service", "core.jobs", "core.game", "core.reactive", "core.tui", "core.devtools", "core.build", "core.compiler", "core.browser"]
}
// Core's memory kernel: the core.mem modules under Mem are the only Core
// modules whose `#Unsafe` regions allocate, read or write raw memory, step
// pointers, copy bytes or map pages; every other Core module reaches memory
// through their owners.
policy: {
    memory: .Kernel(["Mem"]),
}
