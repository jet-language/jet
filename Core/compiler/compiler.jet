package {
    name: "core.compiler"
    version: "0.1.0"
    edition: "2026"
    description: "Lex, parse, check, and package Jet from Jet."
    license: "MIT"
    outputs: {
        compiler: .Library{ entry: compiler }
    }
}
use core as core

// core.compiler — the Jet implementation of the read-only front-end surface.
//
// The scanner preserves token locations and reports malformed input as error
// tokens. The parser builds a source-bearing syntax tree with diagnostic data;
// the checker adds declaration and parameter checks without discarding parser
// failures. Package, lock, and source-map readers reject malformed files with
// the existing typed IOError carrier instead of manufacturing an empty view.
module lang

pub struct Token {
    pub kind: String
    pub text: String
    pub line: Int
    pub column: Int
}

pub fn lex(source: String) -> [Token] { scan(source) }

pub fn parse(source: String) -> DataTree { parse_source(source) }

pub fn check(source: String) -> [String] {
    tree :: parse(source)
    diags := [String]{}
    collect_tree_diagnostics(tree, &diags)
    walk_check(tree, &diags)
    diags
}

pub fn package(path: String) -[FS]> DataTree !IOError {
    text :: host_read_text(path)
    parsed :: parse_manifest_text(text)
    if parsed.value == .None {
        return Err(compiler_error("package", path, parse_diagnostic_message(parsed.diagnostics)))
    }
    parsed.value ?? return Err(compiler_error("package", path, "E1000: package parser produced no value"))
}

pub fn manifest(path: String) -[FS]> DataTree !IOError {
    text :: host_read_text(path)
    parsed :: parse_manifest_text(text)
    if parsed.value == .None {
        return Err(compiler_error("manifest", path, parse_diagnostic_message(parsed.diagnostics)))
    }
    parsed.value ?? return Err(compiler_error("manifest", path, "E1000: manifest parser produced no value"))
}

pub fn lock(path: String) -[FS]> DataTree !IOError {
    text :: host_read_text(path)
    parsed :: parse_lock_text(text)
    if parsed.value == .None {
        return Err(compiler_error("lock", path, parse_diagnostic_message(parsed.diagnostics)))
    }
    parsed.value ?? return Err(compiler_error("lock", path, "E1000: lock parser produced no value"))
}

pub fn profiles() -> [String] { [String]{"dev", "release", "test"} }

pub fn source_map(path: String) -[FS]> DataTree !IOError {
    text :: host_read_text(path)
    mapped :: source_map_text(path, text)
    if mapped == .None {
        return Err(compiler_error("source_map", path, "E1100: malformed source-map directive"))
    }
    mapped
}

struct Parser {
    tokens: [Token]
    index: Int
    diagnostics: [DataTree]
}

fn scan(source: String) -> [Token] {
    raw :: source.bytes()
    out := [Token]{}
    i := 0
    line := 1
    col := 1
    loop {
        if i >= raw.len() {
            out.push(Token{kind: "eof", text: "", line: line, column: col})
            return ~out
        }
        n :: raw[i]
        if n == 32 || n == 9 {
            i = i + 1
            col = col + 1
            next
        }
        if n == 10 {
            i = i + 1
            line = line + 1
            col = 1
            next
        }
        if n == 13 {
            i = i + 1
            next
        }
        if n == 47 && i + 1 < raw.len() && raw[i + 1] == (U8{47}) {
            i = i + 2
            col = col + 2
            loop {
                if i >= raw.len() || raw[i] == (U8{10}) -> break
                i = i + 1
                col = col + 1
            }
            next
        }
        if n == 47 && i + 1 < raw.len() && raw[i + 1] == (U8{42}) {
            start_line := line
            start_col := col
            i = i + 2
            col = col + 2
            closed := false
            loop {
                if i >= raw.len() -> break
                if raw[i] == (U8{10}) {
                    i = i + 1
                    line = line + 1
                    col = 1
                    next
                }
                if raw[i] == (U8{13}) {
                    i = i + 1
                    next
                }
                if raw[i] == (U8{42}) && i + 1 < raw.len() && raw[i + 1] == (U8{47}) {
                    i = i + 2
                    col = col + 2
                    closed = true
                    break
                }
                i = i + 1
                col = col + 1
            }
            if !closed {
                out.push(Token{kind: "error", text: "unterminated block comment", line: start_line, column: start_col})
                out.push(Token{kind: "eof", text: "", line: line, column: col})
                return ~out
            }
            next
        }
        start_line := line
        start_col := col
        if is_alpha(n) || n == (U8{95}) {
            j := i
            loop {
                if j >= raw.len() || !(is_alnum(raw[j]) || raw[j] == (U8{95})) -> break
                j = j + 1
            }
            text :: slice_bytes(raw, i, j)
            kind := "ident"
            if is_kw(text) -> kind = "kw"
            out.push(Token{kind: kind, text: text, line: start_line, column: start_col})
            col = col + (j - i)
            i = j
            next
        }
        if n >= (U8{48}) && n <= (U8{57}) {
            j := i
            loop {
                if j >= raw.len() || raw[j] < (U8{48}) || raw[j] > (U8{57}) -> break
                j = j + 1
            }
            if j < raw.len() && raw[j] == (U8{46}) {
                k := j + 1
                if k < raw.len() && raw[k] >= (U8{48}) && raw[k] <= (U8{57}) {
                    j = k + 1
                    loop {
                        if j >= raw.len() || raw[j] < (U8{48}) || raw[j] > (U8{57}) -> break
                        j = j + 1
                    }
                }
            }
            if j < raw.len() && (raw[j] == (U8{101}) || raw[j] == (U8{69})) {
                k := j + 1
                if k < raw.len() && (raw[k] == (U8{43}) || raw[k] == (U8{45})) -> k = k + 1
                digits := k
                loop {
                    if k >= raw.len() || raw[k] < (U8{48}) || raw[k] > (U8{57}) -> break
                    k = k + 1
                }
                if k > digits -> j = k
            }
            out.push(Token{kind: "number", text: slice_bytes(raw, i, j), line: start_line, column: start_col})
            col = col + (j - i)
            i = j
            next
        }
        if n == (U8{34}) || n == (U8{39}) {
            quote :: n
            j := i + 1
            closed := false
            loop {
                if j >= raw.len() -> break
                if raw[j] == quote {
                    j = j + 1
                    closed = true
                    break
                }
                if raw[j] == (U8{10}) || raw[j] == (U8{13}) -> break
                if raw[j] == (U8{92}) && j + 1 < raw.len() -> j = j + 1
                j = j + 1
            }
            kind := "string"
            text := slice_bytes(raw, i, j)
            if quote == (U8{39}) -> kind = "char"
            if !closed {
                kind = "error"
                text = "unterminated string"
            }
            out.push(Token{kind: kind, text: text, line: start_line, column: start_col})
            col = col + (j - i)
            i = j
            next
        }
        if i + 3 <= raw.len() {
            three :: slice_bytes(raw, i, i + 3)
            if three == "..." || three == "..=" || three == "??=" || three == "<<=" || three == ">>=" {
                out.push(Token{kind: "op", text: three, line: start_line, column: start_col})
                i = i + 3
                col = col + 3
                next
            }
        }
        if i + 2 <= raw.len() {
            two :: slice_bytes(raw, i, i + 2)
            if two == "->" || two == "-[" || two == "]>" || two == "=>" || two == "::" || two == ":=" || two == "==" || two == "!=" || two == "<=" || two == ">=" || two == "&&" || two == "||" || two == ".." || two == "??" || two == "<<" || two == ">>" || two == "+=" || two == "-=" || two == "*=" || two == "/=" || two == "%=" || two == "~|" || two == "~&" || two == "~^" {
                out.push(Token{kind: "op", text: two, line: start_line, column: start_col})
                i = i + 2
                col = col + 2
                next
            }
        }
        ch :: slice_bytes(raw, i, i + 1)
        out.push(Token{kind: "op", text: ch, line: start_line, column: start_col})
        i = i + 1
        col = col + 1
    }
}

impl Parser {
    fn eof(&self) -> Bool { self.index >= self.tokens.len() || self.tokens[self.index].kind == "eof" }

    fn peek(&self) -> ?Token {
        if self.index >= self.tokens.len() -> return None
        Val(self.tokens[self.index])
    }

    fn bump(&self) -> ?Token {
        if self.index >= self.tokens.len() -> return None
        token :: self.tokens[self.index]
        self.index = self.index + 1
        Val(token)
    }

    fn at(&self, text: String) -> Bool {
        token :: self.peek() ?? return false
        token.text == text
    }

    fn add_diagnostic(&self, code: String, message: String, token: Token, fix: String) {
        self.diagnostics.push(diagnostic_tree(code, message, token, fix))
    }

    fn parse_items(&self) -> [DataTree] {
        items := [DataTree]{}
        loop {
            if self.eof() -> return ~items
            token := self.peek() ?? return ~items
            if token.kind == "error" {
                self.add_diagnostic("E0001", token.text, token, "close the unterminated lexical construct")
                _ :: self.bump()
                next
            }
            public := false
            if token.text == "pub" {
                _ :: self.bump()
                public = true
                if self.eof() {
                    self.add_diagnostic("E0003", "expected a declaration after `pub`", token, "write a declaration after `pub`")
                    return ~items
                }
                token = self.peek() ?? return ~items
            }
            if token.text == "fn" {
                items.push(self.parse_fn(public))
                next
            }
            if token.text == "struct" || token.text == "enum" || token.text == "trait" || token.text == "impl" || token.text == "module" || token.text == "type" || token.text == "const" || token.text == "test" || token.text == "extern" {
                items.push(self.parse_decl(public))
                next
            }
            if token.text == "use" {
                items.push(self.parse_use())
                next
            }
            self.add_diagnostic("E0003", "unexpected token `{token.text}` at top level", token, "start a declaration or remove the token")
            _ :: self.bump()
        }
    }

    fn parse_fn(&self, public: Bool) -> DataTree {
        fn_token :: self.bump() ?? Token{kind: "kw", text: "fn", line: 1, column: 1}
        name := ""
        name_token := ~fn_token
        next :: self.peek()
        if next != .None {
            candidate :: next
            if candidate.kind == "ident" || candidate.kind == "kw" {
                name = ~candidate.text
                name_token = candidate
                _ :: self.bump()
            }
        }
        if name.len() == 0 {
            self.add_diagnostic("E0004", "function is missing a name", ~fn_token, "name the function")
        }
        params := self.parse_params()
        signature := self.parse_signature()
        body := [DataTree]{}
        has_body := false
        if self.at("{{") {
            has_body = true
            body = self.parse_block()
        } else if self.at(";") {
            _ :: self.bump()
        } else if self.eof() == false {
            self.add_diagnostic("E0005", "function is missing a body", name_token, "add `{{ ... }}` or terminate an external declaration with `;`")
        }
        entries := [String:DataTree]{}
        _ :: entries.add("kind", DataTree.Text("function"))
        _ :: entries.add("name", DataTree.Text(name))
        _ :: entries.add("public", DataTree.Bool(public))
        _ :: entries.add("line", DataTree.Int(fn_token.line))
        _ :: entries.add("column", DataTree.Int(fn_token.column))
        _ :: entries.add("params", DataTree.Array(params))
        _ :: entries.add("signature", DataTree.Text(signature))
        _ :: entries.add("body", DataTree.Array(body))
        _ :: entries.add("has_body", DataTree.Bool(has_body))
        DataTree.Object(entries)
    }

    fn parse_params(&self) -> [DataTree] {
        params := [DataTree]{}
        if !self.at("(") {
            token :: self.peek() ?? Token{kind: "eof", text: "", line: 1, column: 1}
            self.add_diagnostic("E0003", "expected `(` after function name", token, "write the parameter list")
            return ~params
        }
        _ :: self.bump()
        names := [String]{}
        loop {
            token := self.peek() ?? Token{kind: "eof", text: "", line: 1, column: 1}
            if token.kind == "eof" {
                self.add_diagnostic("E0003", "unterminated parameter list", token, "close the parameter list with `)`")
                return ~params
            }
            if token.text == ")" {
                _ :: self.bump()
                return ~params
            }
            if token.text == "," {
                _ :: self.bump()
                next
            }
            if token.text == "&" || token.text == "^" || token.text == "mut" {
                _ :: self.bump()
                token = self.peek() ?? token
            }
            if token.kind != "ident" && token.kind != "kw" {
                self.add_diagnostic("E0003", "expected a parameter name", token, "name each parameter before its type")
                _ :: self.bump()
                next
            }
            name :: token.text
            _ :: self.bump()
            if contains_string(names, name) {
                self.add_diagnostic("E1002", "duplicate parameter `{name}`", token, "rename one of the parameters")
            }
            names.push(name)
            type_text := ""
            if self.at(":") {
                _ :: self.bump()
                type_text = self.collect_until([String]{",", ")"})
            } else {
                self.add_diagnostic("E1003", "parameter `{name}` is missing a type", token, "add `: Type` to the parameter")
            }
            pentries := [String:DataTree]{}
            _ :: pentries.add("name", DataTree.Text(name))
            _ :: pentries.add("type", DataTree.Text(type_text))
            params.push(DataTree.Object(pentries))
            if self.at(",") -> _ :: self.bump()
        }
    }

    fn parse_signature(&self) -> String {
        parts := [String]{}
        loop {
            token :: self.peek() ?? return join_tokens(parts)
            if token.kind == "eof" || token.text == "{{" || token.text == ";" -> return join_tokens(parts)
            if token.text == "fn" || token.text == "struct" || token.text == "enum" -> return join_tokens(parts)
            parts.push(token.text)
            _ :: self.bump()
        }
    }
    fn parse_block(&self) -> [DataTree] {
        body := [DataTree]{}
        open :: self.bump() ?? Token{kind: "op", text: "{{", line: 1, column: 1}
        depth := 1
        loop {
            token :: self.peek() ?? {
                self.add_diagnostic("E0006", "unterminated block", open, "close the block with `}}`")
                return ~body
            }
            if token.kind == "eof" {
                self.add_diagnostic("E0006", "unterminated block", open, "close the block with `}}`")
                return ~body
            }
            if token.kind == "error" {
                self.add_diagnostic("E0001", token.text, token, "close the unterminated lexical construct")
                _ :: self.bump()
                next
            }
            if token.text == "{{" -> depth = depth + 1
            if token.text == "}}" {
                depth = depth - 1
                if depth == 0 {
                    _ :: self.bump()
                    return ~body
                }
            }
            body.push(atom_tree(token))
            _ :: self.bump()
        }
    }

    fn parse_decl(&self, public: Bool) -> DataTree {
        declaration :: self.bump() ?? Token{kind: "kw", text: "declaration", line: 1, column: 1}
        name := ""
        name_token := ~declaration
        next :: self.peek()
        if next != .None {
            candidate :: next
            if candidate.kind == "ident" || candidate.kind == "kw" {
                name = ~candidate.text
                name_token = candidate
                _ :: self.bump()
            }
        }
        if name.len() == 0 && declaration.text != "test" {
            self.add_diagnostic("E0004", "{declaration.text} declaration is missing a name", ~declaration, "name the declaration")
        }
        body := [DataTree]{}
        has_body := false
        if self.at("{{") {
            has_body = true
            body = self.parse_block()
        }
        entries := [String:DataTree]{}
        _ :: entries.add("kind", DataTree.Text(lower_kind(~declaration.text)))
        _ :: entries.add("name", DataTree.Text(name))
        _ :: entries.add("public", DataTree.Bool(public))
        _ :: entries.add("line", DataTree.Int(declaration.line))
        _ :: entries.add("column", DataTree.Int(declaration.column))
        _ :: entries.add("body", DataTree.Array(body))
        _ :: entries.add("has_body", DataTree.Bool(has_body))
        _ :: entries.add("name_token", DataTree.Text(name_token.text))
        DataTree.Object(entries)
    }

    fn parse_use(&self) -> DataTree {
        use_token :: self.bump() ?? Token{kind: "kw", text: "use", line: 1, column: 1}
        parts := [String]{}
        loop {
            token :: self.peek() ?? break
            if token.kind == "eof" || token.line > use_token.line && parts.len() > 0 -> break
            if token.text == ";" {
                _ :: self.bump()
                break
            }
            parts.push(token.text)
            _ :: self.bump()
        }
        entries := [String:DataTree]{}
        _ :: entries.add("kind", DataTree.Text("use"))
        _ :: entries.add("name", DataTree.Text(join_tokens(parts)))
        _ :: entries.add("public", DataTree.Bool(false))
        _ :: entries.add("line", DataTree.Int(use_token.line))
        _ :: entries.add("column", DataTree.Int(use_token.column))
        DataTree.Object(entries)
    }

    fn collect_until(&self, stops: [String]) -> String {
        parts := [String]{}
        depth := 0
        loop {
            token :: self.peek() ?? return join_tokens(parts)
            if token.kind == "eof" -> return join_tokens(parts)
            if depth == 0 && contains_string(stops, token.text) -> return join_tokens(parts)
            if token.text == "(" || token.text == "[" || token.text == "{{" -> depth = depth + 1
            if token.text == ")" || token.text == "]" || token.text == "}}" {
                if depth > 0 -> depth = depth - 1
            }
            parts.push(token.text)
            _ :: self.bump()
        }
    }
}

struct ParseResult {
    value: ?DataTree
    diagnostics: [DataTree]
}

fn parse_source(source: String) -> DataTree {
    parser := Parser{tokens: scan(source), index: 0, diagnostics: [DataTree]{}}
    items :: parser.parse_items()
    entries := [String:DataTree]{}
    _ :: entries.add("schema_version", DataTree.Int(1))
    _ :: entries.add("source", DataTree.Text(~source))
    _ :: entries.add("items", DataTree.Array(items))
    _ :: entries.add("diagnostics", DataTree.Array(parser.diagnostics))
    DataTree.Object(entries)
}

fn diagnostic_tree(code: String, message: String, token: Token, fix: String) -> DataTree {
    entries := [String:DataTree]{}
    _ :: entries.add("code", DataTree.Text(~code))
    _ :: entries.add("severity", DataTree.Text("error"))
    _ :: entries.add("message", DataTree.Text(~message))
    _ :: entries.add("line", DataTree.Int(token.line))
    _ :: entries.add("column", DataTree.Int(token.column))
    _ :: entries.add("fix", DataTree.Text(~fix))
    DataTree.Object(entries)
}

fn collect_tree_diagnostics(tree: DataTree, out: &[String]) {
    if tree == {
        .Object(entries) -> {
            diagnostics :: entries.get("diagnostics")
            if diagnostics != .None {
                values :: diagnostics
                if values == {
                    .Array(items) -> {
                        loop item in items {
                            out.push(format_diagnostic(item))
                        }
                    }
                    else -> return
                }
            }
            loop key in entries.keys() {
                value :: entries.get(key) ?? DataTree.Null
                if key != "diagnostics" -> collect_tree_diagnostics(value, &out)
            }
        }
        .Array(items) -> loop item in items -> collect_tree_diagnostics(item, &out)
        else -> return
    }
}

fn walk_check(tree: DataTree, diags: &[String]) {
    if tree == {
        .Object(root) -> {
            items :: root.get("items")
            if items != .None {
                seen := [String]{}
                values :: items
                if values == {
                    .Array(nodes) -> {
                        loop node in nodes {
                            name :: tree_text(tree_field(~node, "name"))
                            kind :: tree_text(tree_field(~node, "kind"))
                            if name.len() == 0 && kind != "use" {
                                diags.push("E1000: declaration has an empty name")
                            }
                            if name.len() > 0 && contains_string(seen, name) {
                                diags.push("E1001: duplicate declaration `{name}`")
                            }
                            if name.len() > 0 -> seen.push(name)
                            params :: tree_field(~node, "params")
                            if params != .None {
                                pvalues :: params
                                if pvalues == {
                                    .Array(ps) -> {
                                        pseen := [String]{}
                                        loop p in ps {
                                            pname :: tree_text(tree_field(~p, "name"))
                                            if pname.len() > 0 && contains_string(pseen, pname) {
                                                diags.push("E1002: duplicate parameter `{pname}` in `{name}`")
                                            }
                                            if pname.len() > 0 -> pseen.push(pname)
                                        }
                                    }
                                    else -> return
                                }
                            }
                        }
                    }
                    else -> return
                }
            }
        }
        else -> return
    }
}

fn format_diagnostic(tree: DataTree) -> String {
    code := tree_text(tree_field(~tree, "code"))
    message := tree_text(tree_field(~tree, "message"))
    line := tree_int(tree_field(~tree, "line"))
    column := tree_int(tree_field(~tree, "column"))
    if code.len() == 0 -> return "E1000: {message} at {line}:{column}"
    "{code}: {message} at {line}:{column}"
}

fn parse_diagnostic_message(diags: [DataTree]) -> String {
    if diags.len() == 0 -> return "E1000: malformed input"
    format_diagnostic(diags[0])
}

struct ManifestParser {
    tokens: [Token]
    index: Int
    diagnostics: [DataTree]
}

impl ManifestParser {
    fn eof(&self) -> Bool { self.index >= self.tokens.len() || self.tokens[self.index].kind == "eof" }

    fn peek(&self) -> ?Token {
        if self.index >= self.tokens.len() -> return None
        Val(self.tokens[self.index])
    }

    fn bump(&self) -> ?Token {
        if self.index >= self.tokens.len() -> return None
        token :: self.tokens[self.index]
        self.index = self.index + 1
        Val(token)
    }

    fn add_error(&self, message: String, token: Token) {
        self.diagnostics.push(diagnostic_tree("E1000", message, token, "correct the manifest syntax"))
    }

    fn document(&self) -> ?DataTree {
        token :: self.peek() ?? return None
        if token.text == "package" {
            _ :: self.bump()
            if !self.at("{{") {
                _ :: self.add_error("expected `{{` after `package`", token)
                return None
            }
            value :: self.object_value()
            if value == .None -> return None
            if !self.eof() {
                extra :: self.peek() ?? token
                _ :: self.add_error("unexpected token `{extra.text}` after package block", extra)
                return None
            }
            return Val(value)
        }
        if token.text == "{{" -> return self.object_value()
        entries := [String:DataTree]{}
        loop {
            if self.eof() -> break
            key_token :: self.bump() ?? break
            if key_token.kind == "error" {
                _ :: self.add_error(key_token.text, key_token)
                next
            }
            if key_token.text == "," -> next
            if key_token.kind != "ident" && key_token.kind != "kw" && key_token.kind != "string" {
                _ :: self.add_error("expected a manifest key", key_token)
                next
            }
            key := self.key_text(key_token)
            sep :: self.bump() ?? key_token
            if sep.text != ":" && sep.text != "=" {
                _ :: self.add_error("expected `:` or `=` after manifest key `{key}`", sep)
                next
            }
            value :: self.value()
            if value == .None -> next
            parsed :: value
            if entries.has_key(key) -> _ :: self.add_error("duplicate manifest key `{key}`", key_token)
            _ :: entries.add(key, parsed)
        }
        if entries.len() == 0 -> return None
        Val(DataTree.Object(entries))
    }

    fn value(&self) -> ?DataTree {
        token :: self.peek() ?? return None
        if token.kind == "string" || token.kind == "char" {
            _ :: self.bump()
            return Val(DataTree.Text(unquote(token.text)))
        }
        if token.kind == "number" {
            _ :: self.bump()
            return Val(parse_atom(token.text))
        }
        if token.text == "true" {
            _ :: self.bump()
            return Val(DataTree.Bool(true))
        }
        if token.text == "false" {
            _ :: self.bump()
            return Val(DataTree.Bool(false))
        }
        if token.text == "null" || token.text == "None" {
            _ :: self.bump()
            return Val(DataTree.Null)
        }
        if token.text == "{{" -> return self.object_value()
        if token.text == "[" -> return self.array_value()
        if token.text == "}}" || token.text == "]" || token.text == "," {
            _ :: self.add_error("expected a manifest value", token)
            return None
        }
        parts := [String]{}
        line := token.line
        loop {
            next :: self.peek() ?? break
            if next.kind == "eof" || next.text == "," || next.text == "}}" || next.text == "]" -> break
            if next.line > line && parts.len() > 0 -> break
            parts.push(next.text)
            _ :: self.bump()
        }
        if parts.len() == 0 {
            _ :: self.add_error("expected a manifest value", token)
            return None
        }
        Val(parse_atom(join_value_tokens(parts)))
    }

    fn object_value(&self) -> ?DataTree {
        open :: self.bump() ?? Token{kind: "op", text: "{{", line: 1, column: 1}
        entries := [String:DataTree]{}
        loop {
            token :: self.peek() ?? {
                _ :: self.add_error("unterminated object", open)
                return None
            }
            if token.text == "}}" {
                _ :: self.bump()
                return Val(DataTree.Object(entries))
            }
            if token.kind == "eof" {
                _ :: self.add_error("unterminated object", open)
                return None
            }
            if token.text == "," {
                _ :: self.bump()
                next
            }
            key_token :: self.bump() ?? open
            if key_token.kind != "ident" && key_token.kind != "kw" && key_token.kind != "string" {
                _ :: self.add_error("expected an object key", key_token)
                next
            }
            key := self.key_text(key_token)
            sep :: self.bump() ?? key_token
            if sep.text != ":" && sep.text != "=" {
                _ :: self.add_error("expected `:` or `=` after object key `{key}`", sep)
                next
            }
            value :: self.value()
            if value == .None {
                bad :: self.peek() ?? key_token
                if bad.text != "}}" -> _ :: self.bump()
                next
            }
            parsed :: value
            if entries.has_key(key) -> _ :: self.add_error("duplicate object key `{key}`", key_token)
            _ :: entries.add(key, parsed)
            if self.at(",") -> _ :: self.bump()
        }
    }

    fn array_value(&self) -> ?DataTree {
        open :: self.bump() ?? Token{kind: "op", text: "[", line: 1, column: 1}
        items := [DataTree]{}
        loop {
            token :: self.peek() ?? {
                _ :: self.add_error("unterminated array", open)
                return None
            }
            if token.text == "]" {
                _ :: self.bump()
                return Val(DataTree.Array(items))
            }
            if token.kind == "eof" {
                _ :: self.add_error("unterminated array", open)
                return None
            }
            if token.text == "," {
                _ :: self.bump()
                next
            }
            value :: self.value()
            if value == .None {
                bad :: self.peek() ?? open
                _ :: self.add_error("invalid array value", bad)
                _ :: self.bump()
                next
            }
            parsed :: value
            items.push(parsed)
            if self.at(",") -> _ :: self.bump()
        }
    }

    fn key_text(&self, first: Token) -> String {
        key := unquote(first.text)
        loop {
            punct :: self.peek() ?? return ~key
            if punct.text != "-" && punct.text != "." -> return ~key
            _ :: self.bump()
            part :: self.peek() ?? return ~key
            if part.kind != "ident" && part.kind != "kw" && part.kind != "number" -> return ~key
            key = "{key}{punct.text}{part.text}"
            _ :: self.bump()
        }
    }
    fn at(&self, text: String) -> Bool {
        token :: self.peek() ?? return false
        token.text == text
    }
}

fn parse_manifest_text(text: String) -> ParseResult {
    parser := ManifestParser{tokens: scan(text), index: 0, diagnostics: [DataTree]{}}
    value :: parser.document()
    if parser.diagnostics.len() > 0 -> return ParseResult{value: None, diagnostics: parser.diagnostics}
    if value == .None {
        token :: parser.peek() ?? Token{kind: "eof", text: "", line: 1, column: 1}
        _ :: parser.add_error("manifest is empty", token)
        return ParseResult{value: None, diagnostics: parser.diagnostics}
    }
    return ParseResult{value: Val(value), diagnostics: parser.diagnostics}
}
fn parse_lock_text(text: String) -> ParseResult {
    entries := [String:DataTree]{}
    section := ""
    array_section := false
    array_record_section := ""
    array_record := [String:DataTree]{}
    table_sections := [String]{}
    diagnostics := [DataTree]{}
    lines := split_lines(text)
    line_index := 0
    loop line_index < lines.len() {
        raw_line :: lines[line_index]
        line_index = line_index + 1
        clean :: strip_comment(raw_line)
        t :: trim(clean)
        if t.len() == 0 -> next
        if starts(t, "[[") {
            if array_record_section.len() > 0 {
                append_lock_array_record(&entries, ~array_record_section, ~array_record, &diagnostics, line_index)
                array_record = [String:DataTree]{}
            }
            if !ends(t, "]]") {
                diagnostics.push(diagnostic_tree("E1000", "unterminated lock array section", Token{kind: "op", text: t, line: line_index, column: 1}, "close the section with `]]`"))
                next
            }
            section = trim(slice_bytes(t.bytes(), 2, t.bytes().len() - 2))
            if section.len() == 0 {
                diagnostics.push(diagnostic_tree("E1000", "lock array section has an empty name", Token{kind: "op", text: t, line: line_index, column: 1}, "name the array section"))
                next
            }
            array_record_section = ~section
            array_section = true
            next
        }
        if starts(t, "[") {
            if array_record_section.len() > 0 {
                append_lock_array_record(&entries, ~array_record_section, ~array_record, &diagnostics, line_index)
                array_record = [String:DataTree]{}
                array_record_section = ""
            }
            if !ends(t, "]") {
                diagnostics.push(diagnostic_tree("E1000", "unterminated lock section", Token{kind: "op", text: t, line: line_index, column: 1}, "close the section with `]`"))
                next
            }
            section = trim(slice_bytes(t.bytes(), 1, t.bytes().len() - 1))
            if section.len() == 0 {
                diagnostics.push(diagnostic_tree("E1000", "lock section has an empty name", Token{kind: "op", text: t, line: line_index, column: 1}, "name the section"))
                next
            }
            if contains_string(table_sections, ~section) {
                diagnostics.push(diagnostic_tree("E1000", "duplicate lock section `{section}`", Token{kind: "ident", text: section, line: line_index, column: 1}, "remove the duplicate section"))
            } else {
                table_sections.push(section)
            }
            array_section = false
            next
        }
        kv :: split_once(t, "=")
        if kv.right.len() == 0 {
            diagnostics.push(diagnostic_tree("E1000", "lock entry is missing `=`", Token{kind: "op", text: t, line: line_index, column: 1}, "write `key = value`"))
            next
        }
        key :: trim(kv.left)
        if key.len() == 0 {
            diagnostics.push(diagnostic_tree("E1000", "lock entry has an empty key", Token{kind: "op", text: t, line: line_index, column: 1}, "name the lock entry"))
            next
        }
        parsed :: parse_literal_value(trim(kv.right))
        if parsed.value == .None {
            loop item in parsed.diagnostics -> diagnostics.push(item)
            next
        }
        value :: parsed.value ?? DataTree.Null
        if array_section {
            if array_record_section.len() == 0 -> array_record_section = ~section
            if array_record.has_key(key) {
                diagnostics.push(diagnostic_tree("E1000", "duplicate lock key `{key}` in array section `{section}`", Token{kind: "ident", text: key, line: line_index, column: 1}, "remove the duplicate entry"))
            } else {
                _ :: array_record.add(key, value)
            }
            next
        }
        if section.len() == 0 {
            if entries.has_key(key) {
                diagnostics.push(diagnostic_tree("E1000", "duplicate lock key `{key}`", Token{kind: "ident", text: key, line: line_index, column: 1}, "remove the duplicate entry"))
            }
            _ :: entries.add(key, value)
            next
        }
        old_section :: entries.get(section)
        section_entries := [String:DataTree]{}
        if old_section != .None {
            current_section :: old_section
            if current_section == {
                .Object(existing) -> section_entries = ~existing
                else -> diagnostics.push(diagnostic_tree("E1000", "lock section `{section}` is not an object", Token{kind: "ident", text: section, line: line_index, column: 1}, "use a table section rather than an array section"))
            }
        }
        if section_entries.has_key(key) {
            diagnostics.push(diagnostic_tree("E1000", "duplicate lock key `{key}` in section `{section}`", Token{kind: "ident", text: key, line: line_index, column: 1}, "remove the duplicate entry"))
        } else {
            _ :: section_entries.add(key, value)
        }
        _ :: entries.add(section, DataTree.Object(section_entries))
    }
    if array_record_section.len() > 0 {
        append_lock_array_record(&entries, ~array_record_section, ~array_record, &diagnostics, line_index)
    }
    if diagnostics.len() > 0 -> return ParseResult{value: None, diagnostics: diagnostics}
    ParseResult{value: Val(DataTree.Object(entries)), diagnostics: diagnostics}
}
fn append_lock_array_record(entries: &[String:DataTree], section: String, record: [String:DataTree], diagnostics: &[DataTree], line: Int) {
    if record.len() == 0 -> return
    old :: entries.get(section)
    if old == .None {
        _ :: entries.add(section, DataTree.Array([DataTree.Object(~record)]))
        return
    }
    current :: old
    if current == {
        .Array(items) -> {
            mutable_items := ~items
            mutable_items.push(DataTree.Object(~record))
            _ :: entries.add(section, DataTree.Array(mutable_items))
        }
        else -> diagnostics.push(diagnostic_tree("E1000", "lock section `{section}` is not an array", Token{kind: "ident", text: section, line: line, column: 1}, "use one section spelling consistently"))
    }
}


fn parse_literal_value(text: String) -> ParseResult {
    parser := ManifestParser{tokens: scan(text), index: 0, diagnostics: [DataTree]{}}
    value :: parser.value()
    if value == .None {
        if parser.diagnostics.len() == 0 {
            token :: parser.peek() ?? Token{kind: "eof", text: "", line: 1, column: 1}
            _ :: parser.add_error("expected a lock value", token)
        }
        return ParseResult{value: None, diagnostics: parser.diagnostics}
    }
    if !parser.eof() {
        token :: parser.peek() ?? Token{kind: "eof", text: "", line: 1, column: 1}
        _ :: parser.add_error("unexpected token `{token.text}` after lock value", token)
    }
    if parser.diagnostics.len() > 0 -> return ParseResult{value: None, diagnostics: parser.diagnostics}
    ParseResult{value: Val(value), diagnostics: parser.diagnostics}
}

fn source_map_text(path: String, text: String) -> ?DataTree {
    lines :: split_lines(text)
    mappings := [DataTree]{}
    sources := [String]{}
    current_source := ""
    entries := [String:DataTree]{}
    i := 0
    loop i < lines.len() {
        line_text :: trim(lines[i])
        line_no := i + 1
        if starts(line_text, "// jet:source-map") {
            rest :: trim(slice_bytes(line_text.bytes(), 17, line_text.bytes().len()))
            source := source_map_value(rest)
            if source.len() == 0 -> return None
            current_source = ~source
            if !contains_string(sources, ~source) -> sources.push(source)
        }
        if starts(line_text, "// jet:line") {
            rest :: trim(slice_bytes(line_text.bytes(), 11, line_text.bytes().len()))
            source_line := parse_nonnegative_int(rest)
            if source_line == None -> return None
            if current_source.len() == 0 -> return None
            mapping_entries := [String:DataTree]{}
            _ :: mapping_entries.add("generated_line", DataTree.Int(line_no))
            _ :: mapping_entries.add("source", DataTree.Text(~current_source))
            _ :: mapping_entries.add("source_line", DataTree.Int(source_line ?? 0))
            mappings.push(DataTree.Object(mapping_entries))
        }
        i = i + 1
    }
    _ :: entries.add("file", DataTree.Text(~path))
    _ :: entries.add("bytes", DataTree.Int(text.bytes().len()))
    _ :: entries.add("lines", DataTree.Int(lines.len()))
    _ :: entries.add("sources", strings_tree(sources))
    _ :: entries.add("mappings", DataTree.Array(mappings))
    _ :: entries.add("diagnostics", DataTree.Array([DataTree]{}))
    Val(DataTree.Object(entries))
}

fn source_map_value(text: String) -> String {
    raw :: trim(text)
    if starts(raw, "source=") -> return unquote(trim(slice_bytes(raw.bytes(), 7, raw.bytes().len())))
    if starts(raw, "source:") -> return unquote(trim(slice_bytes(raw.bytes(), 7, raw.bytes().len())))
    unquote(raw)
}

fn host_read_text(path: String) -[FS]> String !IOError {
    core.files.read(path)
}

fn compiler_error(operation: String, path: String, message: String) -> IOError {
    IOError.InvalidInput(IOContext{
        operation: .Read,
        resource: Val(path),
        os_code: None,
        cause: Val("{operation}: {message}"),
    })
}

fn atom_tree(t: Token) -> DataTree {
    entries := [String:DataTree]{}
    _ :: entries.add("kind", DataTree.Text(~t.kind))
    _ :: entries.add("text", DataTree.Text(~t.text))
    _ :: entries.add("line", DataTree.Int(t.line))
    _ :: entries.add("column", DataTree.Int(t.column))
    DataTree.Object(entries)
}

fn is_alpha(b: U8) -> Bool {
    n :: b
    (n >= 65 && n <= 90) || (n >= 97 && n <= 122)
}

fn is_alnum(b: U8) -> Bool {
    n :: b
    is_alpha(b) || (n >= 48 && n <= 57)
}

fn is_kw(text: String) -> Bool {
    text == "fn" || text == "pub" || text == "struct" || text == "enum" || text == "trait" || text == "impl" || text == "if" || text == "else" || text == "loop" || text == "return" || text == "package" || text == "module" || text == "let" || text == "use" || text == "type" || text == "const" || text == "test" || text == "extern" || text == "mut" || text == "in" || text == "true" || text == "false" || text == "null" || text == "None"
}

fn lower_kind(text: String) -> String {
    if text == "struct" -> return "struct"
    if text == "enum" -> return "enum"
    if text == "trait" -> return "trait"
    if text == "impl" -> return "impl"
    if text == "module" -> return "module"
    if text == "type" -> return "type_alias"
    if text == "const" -> return "const"
    if text == "test" -> return "test"
    if text == "extern" -> return "extern"
    return ~text
}

fn slice_bytes(raw: [U8], start: Int, end: Int) -> String {
    a := start
    b := end
    if a < 0 -> a = 0
    if b > raw.len() -> b = raw.len()
    if b < a -> return ""
    out := [U8]{}
    i := a
    loop {
        if i >= b -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i = i + 1
    }
}

fn split_lines(text: String) -> [String] {
    out := [String]{}
    cur := [U8]{}
    loop b in text.bytes() {
        if b == (U8{10}) {
            out.push(String.from_bytes(cur) ?? "")
            cur = [U8]{}
        } else {
            if b != (U8{13}) -> cur.push(b)
        }
    }
    if cur.len() > 0 || out.len() == 0 -> out.push(String.from_bytes(cur) ?? "")
    out
}

fn count_lines(text: String) -> Int {
    split_lines(text).len()
}

fn trim(text: String) -> String {
    raw :: text.bytes()
    a := 0
    b := raw.len()
    loop {
        if a >= b -> return ""
        n :: raw[a]
        if n != 32 && n != 9 -> break
        a = a + 1
    }
    loop {
        if b <= a -> return ""
        n :: raw[b - 1]
        if n != 32 && n != 9 -> break
        b = b - 1
    }
    slice_bytes(raw, a, b)
}

fn starts(text: String, prefix: String) -> Bool {
    a :: text.bytes()
    b :: prefix.bytes()
    if b.len() > a.len() -> return false
    loop i in 0..<b.len() {
        if a[i] != b[i] -> return false
    }
    true
}

fn ends(text: String, suffix: String) -> Bool {
    a :: text.bytes()
    b :: suffix.bytes()
    if b.len() > a.len() -> return false
    start := a.len() - b.len()
    loop i in 0..<b.len() {
        if a[start + i] != b[i] -> return false
    }
    true
}

pub struct Pair {
    pub left: String
    pub right: String
}

fn split_once(text: String, sep: String) -> Pair {
    hay :: text.bytes()
    nd :: sep.bytes()
    if nd.len() == 0 || nd.len() > hay.len() -> return Pair{left: ~text, right: ""}
    loop i in 0..<(hay.len() - nd.len() + 1) {
        ok := true
        loop j in 0..<nd.len() {
            if hay[i + j] != nd[j] -> ok = false
        }
        if ok -> return Pair{left: slice_bytes(hay, 0, i), right: slice_bytes(hay, i + nd.len(), hay.len())}
    }
    Pair{left: ~text, right: ""}
}

fn strip_comment(text: String) -> String {
    raw :: text.bytes()
    quote := 0
    i := 0
    loop {
        if i >= raw.len() -> return ~text
        b :: raw[i]
        if b == (U8{34}) || b == (U8{39}) {
            if quote == 0 {
                quote = b
            } else if quote == b {
                quote = 0
            }
        }
        if b == (U8{35}) && quote == 0 -> return slice_bytes(raw, 0, i)
        i = i + 1
    }
}

fn unquote(text: String) -> String {
    raw :: text.bytes()
    if raw.len() < 2 -> return ~text
    if !(raw[0] == (U8{34}) || raw[0] == (U8{39})) -> return ~text
    if raw[raw.len() - 1] != raw[0] -> return ~text
    out := [U8]{}
    i := 1
    loop {
        if i >= raw.len() - 1 -> return String.from_bytes(out) ?? ""
        b :: raw[i]
        if b == (U8{92}) && i + 1 < raw.len() - 1 {
            i = i + 1
            esc :: raw[i]
            if esc == (U8{110}) -> out.push(U8{10})
            else if esc == (U8{114}) -> out.push(U8{13})
            else if esc == (U8{116}) -> out.push(U8{9})
            else -> out.push(esc)
        } else {
            out.push(b)
        }
        i = i + 1
    }
}

fn parse_atom(text: String) -> DataTree {
    t :: trim(text)
    if t == "true" -> return DataTree.Bool(true)
    if t == "false" -> return DataTree.Bool(false)
    if t == "null" || t == "None" -> return DataTree.Null
    raw :: t.bytes()
    if raw.len() == 0 -> return DataTree.Text("")
    sign := 1
    i := 0
    if raw[0] == (U8{45}) {
        sign = -1
        i = 1
    }
    if i < raw.len() {
        n := 0
        valid := true
        j := i
        loop j < raw.len() {
            if raw[j] < (U8{48}) || raw[j] > (U8{57}) {
                valid = false
                break
            }
            n = n * 10 + (raw[j] - 48)
            j = j + 1
        }
        if valid -> return DataTree.Int(sign * n)
    }
    if t.bytes().len() > 0 {
        if Float.parse(t) == {
            .Ok(number) -> return DataTree.Float(number)
            else -> return DataTree.Text(unquote(t))
        }
    }
    DataTree.Text(unquote(t))
}

fn parse_nonnegative_int(text: String) -> ?Int {
    raw :: trim(text).bytes()
    if raw.len() == 0 -> return None
    n := 0
    loop b in raw {
        if b < (U8{48}) || b > (U8{57}) -> return None
        n = n * 10 + (b - 48)
    }
    Val(n)
}

fn join_tokens(parts: [String]) -> String {
    out := ""
    first := true
    loop part in parts {
        if !first -> out = "{out} "
        out = "{out}{part}"
        first = false
    }
    out
}

fn join_value_tokens(parts: [String]) -> String {
    out := ""
    loop part in parts -> out = "{out}{part}"
    out
}

fn contains_string(values: [String], wanted: String) -> Bool {
    loop value in values {
        if value == wanted -> return true
    }
    false
}

fn tree_field(tree: DataTree, name: String) -> ?DataTree {
    return Val(tree.field(name) ?? return None)
}

fn tree_text(value: ?DataTree) -> String {
    tree :: value ?? DataTree.Null
    tree.text() ?? ""
}

fn tree_int(value: ?DataTree) -> Int {
    tree :: value ?? DataTree.Int(0)
    tree.int() ?? 0
}

fn strings_tree(values: [String]) -> DataTree {
    items := [DataTree]{}
    loop value in values -> items.push(DataTree.Text(value))
    DataTree.Array(items)
}
