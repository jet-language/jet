package {
    name: "core.compiler"
    version: "0.1.0"
    edition: "2026"
    description: "Typed compile-time front-end and package views."
    license: "MIT"
    outputs: {
        compiler: .Library{ entry: compiler }
    }
}

// core.compiler is a read-only compile-time boundary. The compiler provider
// owns front-end state and package authority; these wrappers keep its typed
// result and failure carriers visible to source imports without manufacturing
// runtime or path-based fallbacks.
module lang

pub struct Token {
    pub kind: String
    pub text: String
    pub line: Int
    pub column: Int
}

pub struct Pair {
    pub left: String
    pub right: String
}

pub fn lex(_source: String) -> CompilerLexed !CompilerError {
    panic("core.compiler.lex requires compiler-owned compile-time evaluation")
}

pub fn parse(_source: String) -> CompilerSyntaxTree !CompilerError {
    panic("core.compiler.parse requires compiler-owned compile-time evaluation")
}

pub fn check(_tree: CompilerSyntaxTree) -> CompilerChecked !CompilerError {
    panic("core.compiler.check requires compiler-owned compile-time evaluation")
}

pub fn source_map(_source: String) -> CompilerSourceMap !CompilerError {
    panic("core.compiler.source_map requires compiler-owned compile-time evaluation")
}

pub fn manifest() -> CompilerManifest !CompilerPackageError {
    panic("core.compiler.manifest requires compiler-owned compile-time evaluation")
}

pub fn package() -> CompilerPackage !CompilerPackageError {
    panic("core.compiler.package requires compiler-owned compile-time evaluation")
}

pub fn lock() -> CompilerLock !CompilerPackageError {
    panic("core.compiler.lock requires compiler-owned compile-time evaluation")
}

pub fn profiles() -> CompilerProfileSet !CompilerPackageError {
    panic("core.compiler.profiles requires compiler-owned compile-time evaluation")
}
