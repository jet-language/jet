package {
    name: "core.compiler"
    version: "0.0.1"
    edition: "2026"
    description: "Typed compile-time front-end and package views."
    license: "MIT"
    outputs: {
        compiler: .Library{ entry: compiler }
    }
}

module lang

struct Token {
    kind: String
    text: String
    line: Int
    column: Int
}

struct Pair {
    left: String
    right: String
}
