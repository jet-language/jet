package {
    name: "core.compiler"
    version: "0.0.1"
    edition: "2026"
    description: "Typed compile-time front-end and package views."
    license: "MIT"
    outputs: {
        compiler: .Library{ entry: compiler }
    }
}

module lang

pub struct Token {
    pub kind: String
    pub text: String
    pub line: Int
    pub column: Int
}

pub struct Pair {
    pub left: String
    pub right: String
}
