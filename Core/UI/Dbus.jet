use {
    core: core
    sys: core.sys
    net: core.net
    math: core.math
    rt: jet.runtime.time
}

// __core_ui_dbus — a D-Bus client just big enough for the desktop portal's
// settings, a private part of core.ui.
//
// Speaks the D-Bus wire protocol itself over the session bus's Unix socket:
// no libdbus. It authenticates with SASL EXTERNAL (the kernel vouches for
// the process's uid), says Hello, calls methods and waits for their
// replies, and queues the signals its match rules ask for. It answers the
// calls made to the objects it serves (`serve`) and every other call made
// to it with UnknownMethod. It writes little-endian messages and reads
// every value type in them within the specification's limits; a malformed
// message is a typed `.Protocol` error, never a fault. No Unix descriptors
// are negotiated, so none ride along.
//
// The portal half reads org.freedesktop.appearance through
// org.freedesktop.portal.Settings (the colour scheme, the accent colour and
// the contrast preference) and follows its SettingChanged signals and the
// portal's restarts. It also asks the person for the camera and the
// location (org.freedesktop.portal.Camera and .Location) and reads their
// answer from the request's Response signal. The tray half puts an icon
// with a menu in the desktop's tray (org.kde.StatusNotifierItem and
// com.canonical.dbusmenu).

// The specification's limits: a whole message, one array, and how deep
// arrays and structs may each nest in a signature (values, variants
// included, nest at most twice that).
MESSAGE_MAX: 134217728

ARRAY_MAX: 67108864

NESTING_MAX: 32

SIGNATURE_MAX: 255

// One read from the socket.
RECEIVE_MAX: 65536

// The longest authentication line the bus may answer with.
LINE_MAX: 16384

// Signals kept until `signals` takes them, and calls kept until `next_call`
// does; older ones go first.
QUEUE_MAX: 256

// The header flag that asks for no reply.
NO_REPLY_EXPECTED: 1

// RequestName's flag that asks for a name no one owns, never a place in
// its queue, and the answers that mean the caller owns the name.
DO_NOT_QUEUE: 4

PRIMARY_OWNER: 1

ALREADY_OWNER: 4

// What `number`, `hex_digit`, `field_code` and `type_end` give for none.
NO_VALUE: -1

BUS_NAME: "org.freedesktop.DBus"

BUS_PATH: "/org/freedesktop/DBus"

UNKNOWN_METHOD: "org.freedesktop.DBus.Error.UnknownMethod"

PORTAL_NAME: "org.freedesktop.portal.Desktop"

PORTAL_PATH: "/org/freedesktop/portal/desktop"

SETTINGS: "org.freedesktop.portal.Settings"

APPEARANCE: "org.freedesktop.appearance"

#Error
DbusError: enum {
    NoBus(String),
    Connect(String),
    Auth(String),
    Protocol(String),
    Closed,
    Timeout(String),
    Failed(name: String, message: String),

    // No session bus is named, or only on a transport this client lacks.
    // The bus's socket could not be reached, read or written.
    // The bus refused the authentication.
    // The bus or a peer broke the wire protocol.
    // The bus closed the connection.
    // No answer came in time.
    // The peer answered a call with an error.
    impl Display {
        display: fn(self) -> String {
            if self == {
                .NoBus(text) -> "no session bus: {text}"
                .Connect(text) -> "{text}"
                .Auth(text) -> "{text}"
                .Protocol(text) -> "the bus broke the D-Bus protocol: {text}"
                .Closed -> "the bus closed the connection"
                .Timeout(text) -> "{text}"
                .Failed(name, message) -> "{name}: {message}"
            }
        }
    }
}

// A value on the wire, one variant per D-Bus type code but `h`: no Unix
// descriptors are negotiated, so none can be named. `Uint64` holds the
// unsigned value. An array carries its element signature, so an empty one
// still has a type.
DbusValue: enum {
    Byte(Int),
    Bool(Bool),
    Int16(Int),
    Uint16(Int),
    Int32(Int),
    Uint32(Int),
    Int64(Int),
    Uint64(Int),
    Double(Float),
    Text(String),
    Path(String),
    Signature(String),
    Variant(DbusValue),
    Array(signature: String, items: [DbusValue]),
    Struct([DbusValue]),
    Entry(key: DbusValue, value: DbusValue),
}

// The four message types, numbered as the header's type byte.
#[Specified, Layout(U8)]
DbusKind: enum {
    Call = 1,
    Return = 2,
    Error = 3,
    Signal = 4,
}

// One message. Empty strings and a zero reply serial are header fields
// left out; `signature` is the body's, filled in when a message is read.
DbusMessage: struct {
    kind: DbusKind,
    flags: Int,
    serial: Int,
    reply_serial: Int,
    path: String,
    interface: String,
    member: String,
    error_name: String,
    destination: String,
    sender: String,
    signature: String,
    body: [DbusValue],
}

// A connection to a bus: the unique name Hello gave, bytes read but not yet
// a whole message, the signals that arrived while a call waited, the
// object paths it serves (`serve`) and the calls made to them not yet
// taken (`next_call`).
DbusConnection: struct {
    stream: net.UnixStream,
    serial: Int,
    name: String,
    inbox: [U8],
    queued: [DbusMessage],
    served: [String],
    calls: [DbusMessage],
}

// A decoded message and the bytes it took; `used` is 0 while the bytes
// hold no whole message yet, and `message` is None for a message of a
// type this client ignores.
Decoded: struct {
    used: Int,
    message: DbusMessage?,
}

// Bytes being read: the message so far and where the current value ends.
Reader: struct {
    bytes: [U8],
    at: Int,
    end: Int,
}

// ---- connecting

// Connects to the session bus, authenticates and says Hello, waiting at most
// `timeout_ns` for the bus.
session: fn(timeout_ns: Int) -[Env, Net, Time]> DbusConnection DbusError! {
    address: sys.get("DBUS_SESSION_BUS_ADDRESS") ?? ""
    runtime: sys.get("XDG_RUNTIME_DIR") ?? ""
    path: session_path(address, runtime) ?? return Err(err)
    connect(path, timeout_ns)
}

// Where the system bus listens when DBUS_SYSTEM_BUS_ADDRESS is not set.
SYSTEM_BUS: "/run/dbus/system_bus_socket"

// Connects to the system bus, where system services such as the sensor
// proxy are, as `session` does to the session bus: the first `unix:path=`
// address in DBUS_SYSTEM_BUS_ADDRESS, else the standard socket.
system: fn(timeout_ns: Int) -[Env, Net, Time]> DbusConnection DbusError! {
    address: sys.get("DBUS_SYSTEM_BUS_ADDRESS") ?? ""
    if address == "" -> return connect(SYSTEM_BUS, timeout_ns)
    path: session_path(address, "") ?? return Err(err)
    connect(path, timeout_ns)
}

// Connects to the bus listening at `path`, authenticates as this process's
// user and says Hello.
connect: fn(path: String, timeout_ns: Int) -[Env, Net, Time]> DbusConnection DbusError! {
    stream: net.unix_connect(path) ?? return Err(DbusError.Connect("{path}: {err}"))
    start(stream, sys.getuid(), timeout_ns)
}

// Where the session bus listens: the first `unix:path=` (or
// `unix:runtime=yes`) address in `address`, a D-Bus server address list,
// else $XDG_RUNTIME_DIR/bus when no address is set.
session_path: fn(address: String, runtime: String) -> String DbusError! {
    if address == "" {
        if runtime == "" {
            return Err(DbusError.NoBus("neither DBUS_SESSION_BUS_ADDRESS nor XDG_RUNTIME_DIR is set"))
        }
        return Ok("{runtime}/bus")
    }
    loop entry in address.split(";").to_list() {
        if !entry.starts_with("unix:") -> next
        loop pair in after(entry, 5).split(",").to_list() {
            if pair.starts_with("path=") {
                path: unescape(after(pair, 5)) ?? return Err(DbusError.NoBus("the bus address {address} is malformed"))
                if path != "" -> return Ok(path)
            }
            if pair == "runtime=yes" && runtime != "" -> return Ok("{runtime}/bus")
        }
    }
    Err(DbusError.NoBus("no unix:path= address in {address}"))
}

// Authenticates as `uid` on a connected `stream` and says Hello.
start: fn(stream: &&net.UnixStream, uid: Int, timeout_ns: Int) -[Net, Time]> DbusConnection DbusError! {
    c := DbusConnection{stream: stream.move(), serial: 0, name: "", inbox: [U8]{}, queued: [DbusMessage]{}, served: [String]{}, calls: [DbusMessage]{}}
    deadline: now() + timeout_ns
    // The credentials byte, then the EXTERNAL mechanism with the uid as
    // hex-encoded decimal text.
    uid_hex: hex_text("{uid}")
    hello := [U8]{U8{0}}
    loop b in "AUTH EXTERNAL {uid_hex}\r\n".bytes() -> hello.push(b)
    send_bytes(c, hello) ?? return Err(err)
    line: read_line(c, deadline) ?? return Err(err)
    if !line.starts_with("OK ") {
        if line.starts_with("REJECTED") {
            return Err(DbusError.Auth("the bus refused EXTERNAL for uid {uid}: {line}"))
        }
        return Err(DbusError.Auth("the bus answered AUTH with {line}"))
    }
    send_bytes(c, "BEGIN\r\n".bytes()) ?? return Err(err)
    reply: call_until(c, BUS_NAME, BUS_PATH, BUS_NAME, "Hello", [DbusValue]{}, deadline) ?? return Err(err)
    if reply.body.len() != 1 {
        return Err(DbusError.Protocol("Hello answered {reply.signature}, not a name"))
    }
    if reply.body[0] == .Text(name) {
        c.name = name.copy()
        return Ok(c)
    }
    Err(DbusError.Protocol("Hello answered {reply.signature}, not a name"))
}

// One CRLF-ended line from the bus, before BEGIN.
read_line: fn(c: &DbusConnection, deadline: Int) -[Net, Time]> String DbusError! {
    loop {
        loop i in 1..<c.inbox.len() {
            if (Int{c.inbox[i - 1]}) == 13 && (Int{c.inbox[i]}) == 10 {
                line: String.from_bytes(c.inbox[0..<(i - 1)]) ?? return Err(DbusError.Auth("the bus answered with text that is not UTF-8"))
                c.inbox = c.inbox[(i + 1)..<c.inbox.len()].copy()
                return Ok(line)
            }
        }
        if c.inbox.len() > LINE_MAX {
            return Err(DbusError.Auth("the bus answered with a line over {LINE_MAX} bytes"))
        }
        receive_some(c, deadline, "authentication") ?? return Err(err)
    }
    Err(DbusError.Closed)
}

// ---- calls and signals

// Calls `member` and waits at most `timeout_ns` for its reply; an error
// reply is `.Failed`. Signals that arrive meanwhile are queued.
call: fn(c: &DbusConnection, destination: String, path: String, interface: String, member: String, body: [DbusValue], timeout_ns: Int) -[Net, Time]> DbusMessage DbusError! {
    call_until(c, destination, path, interface, member, body, now() + timeout_ns)
}

call_until: fn(c: &DbusConnection, destination: String, path: String, interface: String, member: String, body: [DbusValue], deadline: Int) -[Net, Time]> DbusMessage DbusError! {
    message := blank(DbusKind.Call)
    message.path = path
    message.interface = interface
    message.member = member
    message.destination = destination
    message.body = body
    serial: send(c, message) ?? return Err(err)
    loop {
        got: if next_message(c) == {
            .Err(err) -> {
                return Err(err)
            }
            .Ok(found) -> found
        }
        if got == .Val(m) {
            awaited: m.reply_serial == serial && m.kind != .Call && m.kind != .Signal
            if awaited {
                if m.kind == .Error -> return Err(failure(m))
                return Ok(m.copy())
            }
            set_aside(c, m.copy()) ?? return Err(err)
            next
        }
        receive_some(c, deadline, member) ?? return Err(err)
    }
    Err(DbusError.Closed)
}

// Sends `message` under the connection's next serial, which it returns.
send: fn(c: &DbusConnection, message: DbusMessage) -[Net, Time]> Int DbusError! {
    c.serial = if c.serial >= 4294967295 -> 1 else -> c.serial + 1
    bytes: encode(message, c.serial) ?? return Err(err)
    send_bytes(c, bytes) ?? return Err(err)
    Ok(c.serial)
}

// Asks the bus for the signals `rule` matches.
add_match: fn(c: &DbusConnection, rule: String, timeout_ns: Int) -[Net, Time]> DbusError! {
    _: call(c, BUS_NAME, BUS_PATH, BUS_NAME, "AddMatch", [DbusValue]{DbusValue.Text(rule)}, timeout_ns) ?? return Err(err)
    Ok()
}

// The signals queued and those that arrive within `timeout_ns` (0: only
// what is already here), oldest first.
signals: fn(c: &DbusConnection, timeout_ns: Int) -[Net, Time]> [DbusMessage] DbusError! {
    gather(c, if c.queued.len() > 0 -> 0 else -> timeout_ns) ?? return Err(err)
    out: c.queued.copy()
    c.queued.clear()
    Ok(out)
}

// Reads what arrives within `timeout_ns` (0: only what is already here) and
// sets each whole message aside (`set_aside`).
gather: fn(c: &DbusConnection, timeout_ns: Int) -[Net, Time]> DbusError! {
    ready: net.unix_wait(c.stream, timeout_ns) ?? return Err(DbusError.Connect("waiting for the bus failed: {err}"))
    if ready -> take_bytes(c) ?? return Err(err)
    loop {
        got: if next_message(c) == {
            .Err(err) -> {
                return Err(err)
            }
            .Ok(found) -> found
        }
        if got == .Val(m) {
            set_aside(c, m.copy()) ?? return Err(err)
            next
        }
        break
    }
    Ok()
}

// A message that is no reply being waited for: a signal is queued, a call
// to a served object waits for `next_call`, any other call that wants a
// reply hears that no method is here, and the rest go.
set_aside: fn(c: &DbusConnection, m: DbusMessage) -[Net, Time]> DbusError! {
    if m.kind == .Signal {
        if c.queued.len() >= QUEUE_MAX -> c.queued = c.queued[1..<c.queued.len()].copy()
        c.queued.push(m.copy())
        return Ok()
    }
    if m.kind != .Call -> return Ok()
    if c.served.contains(m.path) {
        if c.calls.len() >= QUEUE_MAX -> c.calls = c.calls[1..<c.calls.len()].copy()
        c.calls.push(m.copy())
        return Ok()
    }
    refuse(c, m, UNKNOWN_METHOD, "no method {m.interface}.{m.member} here")
}

// ---- serving objects

// Keeps the calls made to the object at `path` for `next_call`, which this
// connection answers (`answer`, `refuse`), instead of saying no method is
// there.
serve: fn(c: &DbusConnection, path: String) {
    if !c.served.contains(path) -> c.served.push(path.copy())
}

// Asks the bus for the well-known `name`, waiting at most `timeout_ns`;
// true when this connection owns it now, false when another does.
request_name: fn(c: &DbusConnection, name: String, timeout_ns: Int) -[Net, Time]> Bool DbusError! {
    reply: call(c, BUS_NAME, BUS_PATH, BUS_NAME, "RequestName", [DbusValue]{DbusValue.Text(name), DbusValue.Uint32(DO_NOT_QUEUE)}, timeout_ns) ?? return Err(err)
    if reply.body.len() == 1 {
        if reply.body[0] == .Uint32(code) {
            return Ok(code == PRIMARY_OWNER || code == ALREADY_OWNER)
        }
    }
    Err(DbusError.Protocol("RequestName answered {reply.signature}, not a code"))
}

// The oldest call to a served object that is here or arrives within
// `timeout_ns` (0: only what is already here); None when none came.
next_call: fn(c: &DbusConnection, timeout_ns: Int) -[Net, Time]> DbusMessage? DbusError! {
    gather(c, if c.calls.len() > 0 -> 0 else -> timeout_ns) ?? return Err(err)
    if c.calls.len() == 0 -> return Ok(None)
    first: c.calls[0].copy()
    c.calls = c.calls[1..<c.calls.len()].copy()
    Ok(Val(first))
}

// Answers the call `m` with `body`; a call that asked for no reply gets
// none.
answer: fn(c: &DbusConnection, m: DbusMessage, body: [DbusValue]) -[Net, Time]> DbusError! {
    if m.flags & NO_REPLY_EXPECTED != 0 -> return Ok()
    reply := blank(DbusKind.Return)
    reply.flags = NO_REPLY_EXPECTED
    reply.reply_serial = m.serial
    reply.destination = m.sender.copy()
    reply.body = body
    _: send(c, reply) ?? return Err(err)
    Ok()
}

// Answers the call `m` with the error `name`, which `text` explains; a call
// that asked for no reply gets none.
refuse: fn(c: &DbusConnection, m: DbusMessage, name: String, text: String) -[Net, Time]> DbusError! {
    if m.flags & NO_REPLY_EXPECTED != 0 -> return Ok()
    reply := blank(DbusKind.Error)
    reply.flags = NO_REPLY_EXPECTED
    reply.reply_serial = m.serial
    reply.error_name = name
    reply.destination = m.sender.copy()
    reply.body = [DbusValue]{DbusValue.Text(text)}
    _: send(c, reply) ?? return Err(err)
    Ok()
}

// Sends the signal `member` of `interface` from the object at `path` to
// whoever's match rules ask for it.
emit: fn(c: &DbusConnection, path: String, interface: String, member: String, body: [DbusValue]) -[Net, Time]> DbusError! {
    message := blank(DbusKind.Signal)
    message.flags = NO_REPLY_EXPECTED
    message.path = path
    message.interface = interface
    message.member = member
    message.body = body
    _: send(c, message) ?? return Err(err)
    Ok()
}

failure: fn(m: DbusMessage) -> DbusError {
    text: if m.body.len() > 0 -> string_of(m.body[0]) else -> ""
    DbusError.Failed{name: m.error_name.copy(), message: text}
}

// A message of `kind` with every header field left out and no body.
blank: fn(kind: DbusKind) -> DbusMessage {
    DbusMessage{
        kind: kind,
        flags: 0,
        serial: 0,
        reply_serial: 0,
        path: "",
        interface: "",
        member: "",
        error_name: "",
        destination: "",
        sender: "",
        signature: "",
        body: [DbusValue]{},
    }
}

// The next whole message read, if one is here.
next_message: fn(c: &DbusConnection) -> DbusMessage? DbusError! {
    loop {
        decoded: decode(c.inbox) ?? return Err(err)
        if decoded.used == 0 -> return Ok(None)
        c.inbox = c.inbox[decoded.used..<c.inbox.len()].copy()
        if decoded.message != None -> return Ok(decoded.message)
    }
    Ok(None)
}

// Waits until `deadline` for bytes from the bus and adds them to the inbox.
receive_some: fn(c: &DbusConnection, deadline: Int, what: String) -[Net, Time]> DbusError! {
    left: deadline - now()
    if left <= 0 -> return Err(DbusError.Timeout("the bus did not answer {what} in time"))
    ready: net.unix_wait(c.stream, left) ?? return Err(DbusError.Connect("waiting for the bus failed: {err}"))
    if !ready -> return Err(DbusError.Timeout("the bus did not answer {what} in time"))
    take_bytes(c)
}

// Reads what the socket holds into the inbox; descriptors are dropped.
take_bytes: fn(c: &DbusConnection) -[Net, Time]> DbusError! {
    got: net.unix_receive(c.stream, RECEIVE_MAX) ?? return Err(DbusError.Connect("reading from the bus failed: {err}"))
    if got.bytes.len() == 0 -> return Err(DbusError.Closed)
    loop b in got.bytes -> c.inbox.push(b)
    Ok()
}

send_bytes: fn(c: &DbusConnection, bytes: [U8]) -[Net, Time]> DbusError! {
    net.unix_send(c.stream, bytes, [sys.Fd]{}) ?? return Err(DbusError.Connect("writing to the bus failed: {err}"))
    Ok()
}

now: fn() -[Time]> Int { rt.clock_mono_ns() }

// ---- writing messages

// The wire bytes of `message` sent as `serial`; its body's signature comes
// from the values.
encode: fn(message: DbusMessage, serial: Int) -> [U8] DbusError! {
    body := [U8]{}
    signature := ""
    loop value in message.body {
        marshal(body, value)
        signature = "{signature}{signature_of(value)}"
    }
    if !valid_signature(signature) {
        return Err(DbusError.Protocol("a body of signature {signature} cannot be sent"))
    }
    fields := [DbusValue]{}
    if message.path != "" -> fields.push(header_field(1, DbusValue.Path(message.path.copy())))
    if message.interface != "" {
        fields.push(header_field(2, DbusValue.Text(message.interface.copy())))
    }
    if message.member != "" -> fields.push(header_field(3, DbusValue.Text(message.member.copy())))
    if message.error_name != "" {
        fields.push(header_field(4, DbusValue.Text(message.error_name.copy())))
    }
    if message.reply_serial != 0 {
        fields.push(header_field(5, DbusValue.Uint32(message.reply_serial)))
    }
    if message.destination != "" {
        fields.push(header_field(6, DbusValue.Text(message.destination.copy())))
    }
    if message.sender != "" -> fields.push(header_field(7, DbusValue.Text(message.sender.copy())))
    if signature != "" -> fields.push(header_field(8, DbusValue.Signature(signature)))
    out := [U8]{U8{108}, U8{message.kind.to_int()}, U8{message.flags & 255}, U8{1}}
    put_word(out, body.len(), 4)
    put_word(out, serial, 4)
    marshal(out, DbusValue.Array{signature: "(yv)", items: fields})
    pad(out, 8)
    if out.len() + body.len() > MESSAGE_MAX {
        return Err(DbusError.Protocol("a message of {out.len() + body.len()} bytes is over the limit"))
    }
    loop b in body -> out.push(b)
    Ok(out)
}

header_field: fn(code: Int, value: DbusValue) -> DbusValue {
    DbusValue.Struct([DbusValue]{DbusValue.Byte(code), DbusValue.Variant(value)})
}

// The signature of one value.
signature_of: fn(value: DbusValue) -> String {
    if value == {
        .Byte(_) -> "y"
        .Bool(_) -> "b"
        .Int16(_) -> "n"
        .Uint16(_) -> "q"
        .Int32(_) -> "i"
        .Uint32(_) -> "u"
        .Int64(_) -> "x"
        .Uint64(_) -> "t"
        .Double(_) -> "d"
        .Text(_) -> "s"
        .Path(_) -> "o"
        .Signature(_) -> "g"
        .Variant(_) -> "v"
        .Array(signature, _) -> "a{signature}"
        .Struct(fields) -> {
            inner := ""
            loop field in fields -> inner = "{inner}{signature_of(field)}"
            "({inner})"
        }
        .Entry(key, item) -> "{ascii(123)}{signature_of(key)}{signature_of(item)}{ascii(125)}"
    }
}

// Appends `value` aligned as the wire wants it; offsets count from the
// message's first byte, which `out` starts at.
marshal: fn(out: &[U8], value: DbusValue) {
    if value == {
        .Byte(n) -> { out.push(U8{n & 255}) }
        .Bool(flag) -> {
            pad(out, 4)
            bit: if flag -> 1 else -> 0
            put_word(out, bit, 4)
        }
        .Int16(n) -> { put_aligned(out, n, 2) }
        .Uint16(n) -> { put_aligned(out, n, 2) }
        .Int32(n) -> { put_aligned(out, n, 4) }
        .Uint32(n) -> { put_aligned(out, n, 4) }
        .Int64(n) -> { put_aligned(out, n, 8) }
        .Uint64(n) -> { put_aligned(out, n, 8) }
        .Double(f) -> { put_aligned(out, math.to_bits(f), 8) }
        .Text(text) -> { put_text(out, text) }
        .Path(text) -> { put_text(out, text) }
        .Signature(text) -> { put_signature(out, text) }
        .Variant(inner) -> {
            put_signature(out, signature_of(inner))
            marshal(out, inner)
        }
        .Array(signature, items) -> {
            pad(out, 4)
            length_at: out.len()
            put_word(out, 0, 4)
            element: signature.bytes()
            pad(out, if element.len() == 0 -> 1 else -> alignment_of(Int{element[0]}))
            start: out.len()
            loop item in items -> marshal(out, item)
            length: out.len() - start
            loop i in 0..<4 -> out[length_at + i] = U8{(length >> (8 * i)) & 255}
        }
        .Struct(fields) -> {
            pad(out, 8)
            loop field in fields -> marshal(out, field)
        }
        .Entry(key, item) -> {
            pad(out, 8)
            marshal(out, key)
            marshal(out, item)
        }
    }
}

put_aligned: fn(out: &[U8], value: Int, size: Int) {
    pad(out, size)
    put_word(out, value, size)
}

// `size` little-endian bytes of `value`, two's complement when negative.
put_word: fn(out: &[U8], value: Int, size: Int) {
    v: if value < 0 -> value + 18446744073709551616 else -> value
    loop i in 0..<size -> out.push(U8{(v >> (8 * i)) & 255})
}

put_text: fn(out: &[U8], text: String) {
    bytes: text.bytes()
    put_aligned(out, bytes.len(), 4)
    loop b in bytes -> out.push(b)
    out.push(U8{0})
}

put_signature: fn(out: &[U8], text: String) {
    bytes: text.bytes()
    out.push(U8{bytes.len() & 255})
    loop b in bytes -> out.push(b)
    out.push(U8{0})
}

pad: fn(out: &[U8], alignment: Int) {
    loop out.len() %% alignment != 0 -> out.push(U8{0})
}

// ---- reading messages

// The first message in `bytes`, if they hold a whole one.
decode: fn(bytes: [U8]) -> Decoded DbusError! {
    waiting: Decoded{used: 0, message: None}
    if bytes.len() < 16 -> return Ok(waiting)
    endian: Int{bytes[0]}
    if endian == 66 {
        return Err(DbusError.Protocol("a big-endian message arrived; only little-endian ones are read"))
    }
    if endian != 108 {
        return Err(DbusError.Protocol("a message starts with byte {endian}, not an endianness mark"))
    }
    version: Int{bytes[3]}
    if version != 1 {
        return Err(DbusError.Protocol("a message has protocol version {version}, not 1"))
    }
    body_length: word(bytes, 4, 4)
    serial: word(bytes, 8, 4)
    fields_length: word(bytes, 12, 4)
    if fields_length > ARRAY_MAX {
        return Err(DbusError.Protocol("a header's fields take {fields_length} bytes, over the limit"))
    }
    fields_end: 16 + fields_length
    body_at: fields_end + (8 - fields_end %% 8) %% 8
    total: body_at + body_length
    if total > MESSAGE_MAX {
        return Err(DbusError.Protocol("a message of {total} bytes is over the limit"))
    }
    if bytes.len() < total -> return Ok(waiting)
    if serial == 0 -> return Err(DbusError.Protocol("a message has serial 0"))
    r := Reader{bytes: bytes[0..<total].copy(), at: 12, end: body_at}
    header: read_value(r, "a(yv)".bytes(), 0, 0) ?? return Err(err)
    align(r, 8) ?? return Err(err)
    m := blank(DbusKind.Call)
    m.flags = Int{bytes[2]}
    m.serial = serial
    if header == .Array(_, fields) {
        loop field in fields { header_value(m, field) ?? return Err(err) }
    }
    r.end = total
    sig: m.signature.bytes()
    at := 0
    loop at < sig.len() {
        value: read_value(r, sig, at, 0) ?? return Err(err)
        m.body.push(value)
        at = type_end(sig, at, 0, 0)
    }
    if r.at != total {
        return Err(DbusError.Protocol("a body is {total - r.at} bytes longer than its signature {m.signature}"))
    }
    m.kind = DbusKind.from_int(Int{bytes[1]}) ?? return Ok(Decoded{used: total, message: None})
    missing: required_field(m)
    if missing != "" -> return Err(DbusError.Protocol("{kind_name(m.kind)} has no {missing}"))
    Ok(Decoded{used: total, message: Val(m)})
}

// Stores one header field in `m`; unknown codes are skipped.
header_value: fn(m: &DbusMessage, field: DbusValue) DbusError! {
    code: field_code(field)
    value: field_value(field) ?? return Err(DbusError.Protocol("a header field is not a code and a variant"))
    if code == 9 {
        return Err(DbusError.Protocol("a message carries Unix descriptors, which were not negotiated"))
    }
    if code < 1 || code > 8 -> return Ok()
    want: if code == {
        1 -> "o"
        5 -> "u"
        8 -> "g"
        else -> "s"
    }
    got: signature_of(value)
    if got != want {
        return Err(DbusError.Protocol("header field {code} holds a {got}, not a {want}"))
    }
    if code == 5 {
        m.reply_serial = number(value)
        return Ok()
    }
    text: string_of(value)
    if code == {
        1 -> m.path = text
        2 -> m.interface = text
        3 -> m.member = text
        4 -> m.error_name = text
        6 -> m.destination = text
        7 -> m.sender = text
        else -> m.signature = text
    }
    Ok()
}

// A header field's code, or -1.
field_code: fn(field: DbusValue) -> Int {
    if field == .Struct(parts) {
        if parts.len() == 2 {
            if parts[0] == .Byte(code) -> return code
        }
    }
    NO_VALUE
}

// What a header field's variant holds.
field_value: fn(field: DbusValue) -> DbusValue? {
    if field == .Struct(parts) {
        if parts.len() == 2 {
            if parts[1] == .Variant(value) -> return Val(value.copy())
        }
    }
    None
}

// The text of a string, object path or signature, or "".
string_of: fn(value: DbusValue) -> String {
    if value == .Text(text) -> return text.copy()
    if value == .Path(text) -> return text.copy()
    if value == .Signature(text) -> return text.copy()
    ""
}

// The header field a message of its kind lacks, or "".
required_field: fn(m: DbusMessage) -> String {
    calls: m.kind == .Call || m.kind == .Signal
    if {
        calls && m.path == "" -> "path"
        m.kind == .Signal && m.interface == "" -> "interface"
        calls && m.member == "" -> "member"
        !calls && m.reply_serial == 0 -> "reply serial"
        m.kind == .Error && m.error_name == "" -> "error name"
        else -> ""
    }
}

kind_name: fn(kind: DbusKind) -> String {
    if kind == {
        .Call -> "a method call"
        .Return -> "a method return"
        .Error -> "an error"
        .Signal -> "a signal"
    }
}

// Reads the value of the complete type at `sig[at]`; `depth` counts the
// containers it sits in.
read_value: fn(r: &Reader, sig: [U8], at: Int, depth: Int) -> DbusValue DbusError! {
    if depth > NESTING_MAX * 2 {
        return Err(DbusError.Protocol("values nest deeper than {NESTING_MAX * 2}"))
    }
    code: Int{sig[at]}
    if code == {
        121 | 98 | 110 | 113 | 105 | 117 | 120 | 116 | 100 -> read_fixed(r, code)
        115 | 111 -> read_string(r, code)
        103 -> read_signature_value(r)
        118 -> read_variant(r, depth)
        97 -> read_array(r, sig, at, depth)
        40 -> read_struct(r, sig, at, depth)
        104 -> Err(DbusError.Protocol("a message names a Unix descriptor, but none were negotiated"))
        else -> Err(DbusError.Protocol("type code {code} is not one this client reads"))
    }
}

// A byte, boolean, integer or double: as wide as it is aligned.
read_fixed: fn(r: &Reader, code: Int) -> DbusValue DbusError! {
    size: if code == 121 -> 1 else -> alignment_of(code)
    start: field(r, size) ?? return Err(err)
    n: word(r.bytes, start, size)
    if code == {
        121 -> Ok(DbusValue.Byte(n))
        98 -> if n > 1 -> Err(DbusError.Protocol("a boolean holds {n}")) else -> Ok(DbusValue.Bool(n == 1))
        110 -> Ok(DbusValue.Int16(signed(n, 16)))
        113 -> Ok(DbusValue.Uint16(n))
        105 -> Ok(DbusValue.Int32(signed(n, 32)))
        117 -> Ok(DbusValue.Uint32(n))
        120 -> Ok(DbusValue.Int64(signed(n, 64)))
        116 -> Ok(DbusValue.Uint64(n))
        else -> Ok(DbusValue.Double(math.from_bits(signed(n, 64))))
    }
}

// The two's-complement value of the `bits`-wide word `n`.
signed: fn(n: Int, bits: Int) -> Int { if n >= 1 << (bits - 1) -> n - (1 << bits) else -> n }

read_string: fn(r: &Reader, code: Int) -> DbusValue DbusError! {
    start: field(r, 4) ?? return Err(err)
    length: word(r.bytes, start, 4)
    text: read_text(r, length) ?? return Err(err)
    if code == 115 -> return Ok(DbusValue.Text(text))
    if !valid_path(text) -> return Err(DbusError.Protocol("{text} is not an object path"))
    Ok(DbusValue.Path(text))
}

read_signature_value: fn(r: &Reader) -> DbusValue DbusError! {
    text: read_signature(r) ?? return Err(err)
    Ok(DbusValue.Signature(text))
}

read_variant: fn(r: &Reader, depth: Int) -> DbusValue DbusError! {
    text: read_signature(r) ?? return Err(err)
    inner: text.bytes()
    if inner.len() == 0 || type_end(inner, 0, 0, 0) != inner.len() {
        return Err(DbusError.Protocol("a variant's signature {text} is not one complete type"))
    }
    value: read_value(r, inner, 0, depth + 1) ?? return Err(err)
    Ok(DbusValue.Variant(value))
}

read_array: fn(r: &Reader, sig: [U8], at: Int, depth: Int) -> DbusValue DbusError! {
    start: field(r, 4) ?? return Err(err)
    length: word(r.bytes, start, 4)
    if length > ARRAY_MAX {
        return Err(DbusError.Protocol("an array of {length} bytes is over the limit"))
    }
    element: at + 1
    align(r, alignment_of(Int{sig[element]})) ?? return Err(err)
    if length > r.end - r.at -> return Err(truncated())
    stop: r.at + length
    outer: r.end
    r.end = stop
    items := [DbusValue]{}
    loop r.at < stop {
        item: read_element(r, sig, element, depth + 1) ?? return Err(err)
        items.push(item)
    }
    r.end = outer
    element_text: String.from_bytes(sig[element..<type_end(sig, at, 0, 0)]) ?? ""
    Ok(DbusValue.Array{signature: element_text, items: items})
}

read_struct: fn(r: &Reader, sig: [U8], at: Int, depth: Int) -> DbusValue DbusError! {
    align(r, 8) ?? return Err(err)
    fields := [DbusValue]{}
    i := at + 1
    loop sig[i] != 41 {
        value: read_value(r, sig, i, depth + 1) ?? return Err(err)
        fields.push(value)
        i = type_end(sig, i, 0, 0)
    }
    Ok(DbusValue.Struct(fields))
}

// One array element: a dict entry when the element type opens with `{`.
read_element: fn(r: &Reader, sig: [U8], at: Int, depth: Int) -> DbusValue DbusError! {
    if (Int{sig[at]}) != 123 -> return read_value(r, sig, at, depth)
    align(r, 8) ?? return Err(err)
    key: read_value(r, sig, at + 1, depth + 1) ?? return Err(err)
    value: read_value(r, sig, at + 2, depth + 1) ?? return Err(err)
    Ok(DbusValue.Entry{key: key, value: value})
}

// Moves to the next `alignment` boundary over zero padding.
align: fn(r: &Reader, alignment: Int) DbusError! {
    loop r.at %% alignment != 0 {
        if r.at >= r.end -> return Err(truncated())
        if (Int{r.bytes[r.at]}) != 0 {
            return Err(DbusError.Protocol("padding at byte {r.at} is not zero"))
        }
        r.at += 1
    }
    Ok()
}

// The offset of an aligned `size`-byte field, which the reader moves past.
field: fn(r: &Reader, size: Int) -> Int DbusError! {
    align(r, size) ?? return Err(err)
    if size > r.end - r.at -> return Err(truncated())
    start: r.at
    r.at += size
    Ok(start)
}

// `length` bytes of UTF-8 and their NUL.
read_text: fn(r: &Reader, length: Int) -> String DbusError! {
    if length >= r.end - r.at -> return Err(truncated())
    start: r.at
    r.at += length + 1
    if (Int{r.bytes[start + length]}) != 0 {
        return Err(DbusError.Protocol("a string does not end in NUL"))
    }
    loop i in start..<(start + length) {
        if (Int{r.bytes[i]}) == 0 -> return Err(DbusError.Protocol("a string holds a NUL"))
    }
    text: String.from_bytes(r.bytes[start..<(start + length)]) ?? return Err(DbusError.Protocol("a string is not UTF-8"))
    Ok(text)
}

read_signature: fn(r: &Reader) -> String DbusError! {
    start: field(r, 1) ?? return Err(err)
    length: Int{r.bytes[start]}
    text: read_text(r, length) ?? return Err(err)
    if !valid_signature(text) -> return Err(DbusError.Protocol("{text} is not a signature"))
    Ok(text)
}

truncated: fn() -> DbusError {
    DbusError.Protocol("a value runs past the end of its message or array")
}

// `size` little-endian bytes at `at`, unsigned.
word: fn(bytes: [U8], at: Int, size: Int) -> Int {
    n := 0
    loop i in 0..<size -> n += (Int{bytes[at + i]}) << (8 * i)
    n
}

// ---- signatures

// Whether `text` is a sequence of complete types within the limits.
valid_signature: fn(text: String) -> Bool {
    sig: text.bytes()
    if sig.len() > SIGNATURE_MAX -> return false
    at := 0
    loop at < sig.len() {
        at = type_end(sig, at, 0, 0)
        if at < 0 -> return false
    }
    true
}

// Where the complete type at `sig[at]` ends, or -1 if none starts there;
// `arrays` and `structs` count the arrays and structs (dict entries
// included) around it.
type_end: fn(sig: [U8], at: Int, arrays: Int, structs: Int) -> Int {
    if at >= sig.len() -> return -1
    code: Int{sig[at]}
    if basic(code) || code == 118 -> return at + 1
    if code == 97 {
        if arrays >= NESTING_MAX -> return -1
        if at + 1 < sig.len() && (Int{sig[at + 1]}) == 123 {
            if structs >= NESTING_MAX || at + 2 >= sig.len() || !basic(Int{sig[at + 2]}) {
                return -1
            }
            value_end: type_end(sig, at + 3, arrays + 1, structs + 1)
            if value_end < 0 || value_end >= sig.len() || (Int{sig[value_end]}) != 125 -> return -1
            return value_end + 1
        }
        return type_end(sig, at + 1, arrays + 1, structs)
    }
    if code == 40 {
        if structs >= NESTING_MAX -> return -1
        i := at + 1
        if i < sig.len() && (Int{sig[i]}) == 41 -> return -1
        loop i < sig.len() && (Int{sig[i]}) != 41 {
            i = type_end(sig, i, arrays, structs + 1)
            if i < 0 -> return -1
        }
        if i >= sig.len() -> return -1
        return i + 1
    }
    NO_VALUE
}

// y b n q i u x t d s o g h.
basic: fn(code: Int) -> Bool {
    code == 121 || code == 98 || code == 110 || code == 113 || code == 105 || code == 117 || code == 120 || code == 116 || code == 100 || code == 115 || code == 111 || code == 103 || code == 104
}

alignment_of: fn(code: Int) -> Int {
    if code == {
        110 | 113 -> 2
        98 | 105 | 117 | 104 | 115 | 111 | 97 -> 4
        120 | 116 | 100 | 40 | 123 -> 8
        else -> 1
    }
}

// `/`, or `/`-separated non-empty runs of [A-Za-z0-9_].
valid_path: fn(text: String) -> Bool {
    bytes: text.bytes()
    if bytes.len() == 0 || (Int{bytes[0]}) != 47 -> return false
    if bytes.len() == 1 -> return true
    if (Int{bytes[bytes.len() - 1]}) == 47 -> return false
    loop i in 1..<bytes.len() {
        b: Int{bytes[i]}
        if b == 47 {
            if (Int{bytes[i - 1]}) == 47 -> return false
            next
        }
        word_byte: (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
        if !word_byte -> return false
    }
    true
}

// ---- text

ascii: fn(code: Int) -> String { String.from_bytes([U8]{U8{code}}) ?? "" }

// What follows the first `skip` bytes of `text`.
after: fn(text: String, skip: Int) -> String {
    bytes: text.bytes()
    if skip >= bytes.len() -> return ""
    String.from_bytes(bytes[skip..<bytes.len()]) ?? ""
}

// Each byte of `text` as two lower-case hex digits.
hex_text: fn(text: String) -> String {
    digits: "0123456789abcdef".bytes()
    out := [U8]{}
    loop b in text.bytes() {
        n: Int{b}
        out.push(digits[n >> 4])
        out.push(digits[n & 15])
    }
    String.from_bytes(out) ?? ""
}

// A D-Bus address value with its `%XX` escapes undone.
unescape: fn(text: String) -> String? {
    bytes: text.bytes()
    out := [U8]{}
    i := 0
    loop i < bytes.len() {
        if (Int{bytes[i]}) != 37 {
            out.push(bytes[i])
            i += 1
            next
        }
        if i + 2 >= bytes.len() -> return None
        high: hex_digit(Int{bytes[i + 1]})
        low: hex_digit(Int{bytes[i + 2]})
        if high < 0 || low < 0 -> return None
        out.push(U8{high * 16 + low})
        i += 3
    }
    decoded: String.from_bytes(out) ?? return None
    Val(decoded)
}

hex_digit: fn(b: Int) -> Int {
    if {
        b >= 48 && b <= 57 -> b - 48
        b >= 97 && b <= 102 -> b - 87
        b >= 65 && b <= 70 -> b - 55
        else -> NO_VALUE
    }
}

// ---- the portal's appearance settings

// The colour scheme the desktop prefers, numbered as the portal's
// color-scheme setting.
#[Specified, Layout(U8)]
PortalScheme: enum {
    NoPreference = 0,
    Dark = 1,
    Light = 2,
}

// The appearance the desktop asks apps for: `accent` is red, green and
// blue in 0..1, empty when the desktop sets none.
PortalAppearance: struct {
    scheme: PortalScheme,
    accent: [Float],
    high_contrast: Bool,
}

default_appearance: fn() -> PortalAppearance {
    PortalAppearance{scheme: PortalScheme.NoPreference, accent: [Float]{}, high_contrast: false}
}

// Reads org.freedesktop.appearance from the portal; a portal that is not
// running is `.Failed` with org.freedesktop.DBus.Error.ServiceUnknown.
appearance: fn(c: &DbusConnection, timeout_ns: Int) -[Net, Time]> PortalAppearance DbusError! {
    namespaces: DbusValue.Array{signature: "s", items: [DbusValue]{DbusValue.Text(APPEARANCE)}}
    reply: call(c, PORTAL_NAME, PORTAL_PATH, SETTINGS, "ReadAll", [DbusValue]{namespaces}, timeout_ns) ?? return Err(err)
    if reply.body.len() != 1 -> return Err(DbusError.Protocol("ReadAll answered {reply.signature}"))
    if reply.signature != "a{ascii(123)}sa{ascii(123)}sv{ascii(125)}{ascii(125)}" {
        return Err(DbusError.Protocol("ReadAll answered {reply.signature}"))
    }
    look := default_appearance()
    if reply.body[0] == .Array(_, groups) {
        loop group in groups {
            if group == .Entry(name, settings) {
                if name == DbusValue.Text(APPEARANCE) {
                    if settings == .Array(_, pairs) {
                        loop pair in pairs {
                            if pair == .Entry(key, value) {
                                if key == .Text(text) -> _: apply_setting(look, text, value.copy())
                            }
                        }
                    }
                }
            }
        }
    }
    Ok(look)
}

// Asks the bus for the appearance's SettingChanged signals and for the
// portal's comings and goings.
watch_appearance: fn(c: &DbusConnection, timeout_ns: Int) -[Net, Time]> DbusError! {
    q: ascii(39)
    add_match(c, "type={q}signal{q},interface={q}{SETTINGS}{q},member={q}SettingChanged{q},path={q}{PORTAL_PATH}{q},arg0={q}{APPEARANCE}{q}", timeout_ns) ?? return Err(err)
    add_match(c, "type={q}signal{q},sender={q}{BUS_NAME}{q},interface={q}{BUS_NAME}{q},member={q}NameOwnerChanged{q},arg0={q}{PORTAL_NAME}{q}", timeout_ns)
}

// Applies an appearance SettingChanged signal to `look`: whether it changed.
apply_signal: fn(look: &PortalAppearance, m: DbusMessage) -> Bool {
    if m.kind != .Signal || m.interface != SETTINGS || m.member != "SettingChanged" || m.body.len() != 3 {
        return false
    }
    if m.body[0] != DbusValue.Text(APPEARANCE) -> return false
    if m.body[1] == .Text(key) -> return apply_setting(look, key, m.body[2].copy())
    false
}

// Whether `m` says the portal has a new owner, so its settings are read anew.
portal_restarted: fn(m: DbusMessage) -> Bool {
    if m.kind != .Signal || m.interface != BUS_NAME || m.member != "NameOwnerChanged" || m.body.len() != 3 {
        return false
    }
    if m.body[0] != DbusValue.Text(PORTAL_NAME) -> return false
    if m.body[2] == .Text(owner) -> return owner != ""
    false
}

// Sets one appearance key from its value (a variant, once or twice wrapped
// as older portals' Read gave it): whether `look` changed. Values out of
// the portal's range read as unset.
apply_setting: fn(look: &PortalAppearance, key: String, value: DbusValue) -> Bool {
    plain := value.copy()
    loop _ in 0..<2 {
        unwrapped: if plain == .Variant(inner) -> inner.copy() else -> plain.copy()
        plain = unwrapped
    }
    if key == {
        "color-scheme" -> set_scheme(look, number(plain))
        "contrast" -> set_contrast(look, number(plain))
        "accent-color" -> set_accent(look, accent_of(plain))
        else -> false
    }
}

// color-scheme: 1 dark, 2 light, anything else no preference.
set_scheme: fn(look: &PortalAppearance, n: Int) -> Bool {
    scheme: PortalScheme.from_int(n) ?? PortalScheme.NoPreference
    if scheme == look.scheme -> return false
    look.scheme = scheme
    true
}

// contrast: 1 high, anything else normal.
set_contrast: fn(look: &PortalAppearance, n: Int) -> Bool {
    high: n == 1
    if high == look.high_contrast -> return false
    look.high_contrast = high
    true
}

set_accent: fn(look: &PortalAppearance, accent: [Float]) -> Bool {
    if accent == look.accent -> return false
    look.accent = accent
    true
}

// accent-color: three doubles in 0..1, else unset (empty).
accent_of: fn(value: DbusValue) -> [Float] {
    accent := [Float]{}
    if value == .Struct(parts) {
        loop part in parts {
            if part == .Double(f) {
                inside: f >= Float{0.0} && f <= Float{1.0}
                if inside -> accent.push(f)
            }
        }
        if accent.len() != 3 || parts.len() != 3 -> accent.clear()
    }
    accent
}

// An integer setting's value, or -1.
number: fn(value: DbusValue) -> Int {
    if value == .Uint32(n) -> return n
    if value == .Int32(n) -> return n
    if value == .Byte(n) -> return n
    NO_VALUE
}

// ---- the portal's device permissions

CAMERA: "org.freedesktop.portal.Camera"

LOCATION: "org.freedesktop.portal.Location"

REQUEST: "org.freedesktop.portal.Request"

SESSION: "org.freedesktop.portal.Session"

PROPERTIES: "org.freedesktop.DBus.Properties"

// The person's answer to a portal request, from its Response signal's code
// (0 allowed, 1 refused, 2 the request ended some other way or got no
// answer in time), or `Absent` when the device is not there to ask for.
PortalAnswer: enum {
    Allowed,
    Refused,
    Ended,
    Absent,
}

// Asks the portal for the camera and waits at most `timeout_ns` for the
// person's answer. A machine with no camera is `.Absent` without asking.
portal_camera: fn(c: &DbusConnection, timeout_ns: Int) -[Net, Time]> PortalAnswer DbusError! {
    deadline: now() + timeout_ns
    present: call_until(c, PORTAL_NAME, PORTAL_PATH, PROPERTIES, "Get", [DbusValue]{DbusValue.Text(CAMERA), DbusValue.Text("IsCameraPresent")}, deadline) ?? return Err(err)
    if present.body.len() != 1 || present.body[0] != DbusValue.Variant(DbusValue.Bool(true)) {
        return Ok(PortalAnswer.Absent)
    }
    watch(c, REQUEST, "Response", "", deadline) ?? return Err(err)
    token: request_token(c)
    asked: call_until(c, PORTAL_NAME, PORTAL_PATH, CAMERA, "AccessCamera", [DbusValue]{string_option("handle_token", token)}, deadline) ?? return Err(err)
    request: answered_path(asked, "AccessCamera") ?? return Err(err)
    response(c, request, deadline)
}

// Asks the portal for the device's location and waits at most `timeout_ns`
// for the person's answer: a location session is made and started, which
// is when the person is asked, and closed once they answer.
portal_location: fn(c: &DbusConnection, timeout_ns: Int) -[Net, Time]> PortalAnswer DbusError! {
    fix: located(c, timeout_ns, false) ?? return Err(err)
    Ok(fix.answer)
}

// A location the portal reported: degrees north and east, and how far off
// it may be, in metres (0 when the portal did not say).
PortalPlace: struct {
    latitude: Float,
    longitude: Float,
    accuracy: Float,
}

// The person's answer to a location request and, once they allowed it,
// the first location the portal reported in time.
PortalFix: struct {
    answer: PortalAnswer,
    place: PortalPlace?,
}

// Asks for the device's location as `portal_location` does and, once the
// person allows it, waits for the first location the session reports; the
// session is closed after it, or once `timeout_ns` ran out.
portal_place: fn(c: &DbusConnection, timeout_ns: Int) -[Net, Time]> PortalFix DbusError! {
    located(c, timeout_ns, true)
}

located: fn(c: &DbusConnection, timeout_ns: Int, wants_place: Bool) -[Net, Time]> PortalFix DbusError! {
    deadline: now() + timeout_ns
    opened: open_location(c, wants_place, timeout_ns) ?? return Err(err)
    place := PortalPlace?{None}
    if wants_place && opened.answer == .Allowed {
        place = if next_place(c, opened.path, deadline - now()) == {
            .Err(err) -> {
                return Err(err)
            }
            .Ok(found) -> found
        }
    }
    close_location(c, opened.path)
    Ok(PortalFix{answer: opened.answer, place: place})
}

// A location session the portal made, open until `close_location` closes
// it, and the person's answer to it.
PortalSession: struct {
    answer: PortalAnswer,
    path: String,
}

// Makes and starts a location session, which is when the person is asked,
// and waits at most `timeout_ns` for their answer. The session stays open:
// once the person allows it, it reports where the device is each time it
// moves, until `close_location` closes it. With `follows`, the bus is
// asked for those reports first.
open_location: fn(c: &DbusConnection, follows: Bool, timeout_ns: Int) -[Net, Time]> PortalSession DbusError! {
    deadline: now() + timeout_ns
    watch(c, REQUEST, "Response", "", deadline) ?? return Err(err)
    if follows -> watch(c, LOCATION, "LocationUpdated", "", deadline) ?? return Err(err)
    session_token: request_token(c)
    made: call_until(c, PORTAL_NAME, PORTAL_PATH, LOCATION, "CreateSession", [DbusValue]{string_option("session_handle_token", session_token)}, deadline) ?? return Err(err)
    session: answered_path(made, "CreateSession") ?? return Err(err)
    start_body: [DbusValue]{DbusValue.Path(session.copy()), DbusValue.Text(""), string_option("handle_token", request_token(c))}
    started: call_until(c, PORTAL_NAME, PORTAL_PATH, LOCATION, "Start", start_body, deadline) ?? return Err(err)
    request: answered_path(started, "Start") ?? return Err(err)
    answer: response(c, request, deadline) ?? return Err(err)
    Ok(PortalSession{answer: answer, path: session})
}

// Closes the location session at `session`, so the portal stops locating
// the device for it. The bus drops the connection's match rules when the
// connection closes.
close_location: fn(c: &DbusConnection, session: String) -[Net, Time]> {
    _: call(c, PORTAL_NAME, session, SESSION, "Close", [DbusValue]{}, CLOSE_WAIT_NS) ?? blank(DbusKind.Return)
}

// How long closing a location session, or giving a sensor back, may take.
CLOSE_WAIT_NS: 1000000000

// Asks the bus for every signal `member` of `interface` from the object at
// `path`, or from any when it is "": the portal sends each request's
// Response and each location session's LocationUpdated to the caller, and
// the reader picks out its own.
watch: fn(c: &DbusConnection, interface: String, member: String, path: String, deadline: Int) -[Net, Time]> DbusError! {
    q: ascii(39)
    from: if path == "" -> "" else -> ",path={q}{path}{q}"
    rule: "type={q}signal{q},interface={q}{interface}{q},member={q}{member}{q}{from}"
    _: call_until(c, BUS_NAME, BUS_PATH, BUS_NAME, "AddMatch", [DbusValue]{DbusValue.Text(rule)}, deadline) ?? return Err(err)
    Ok()
}

// The next LocationUpdated signal of the session at `session` that is here
// or arrives within `timeout_ns`, read as a place; `None` when none came.
next_place: fn(c: &DbusConnection, session: String, timeout_ns: Int) -[Net, Time]> PortalPlace? DbusError! {
    found: if next_signal(c, LOCATION, "LocationUpdated", "", DbusValue.Path(session), timeout_ns) == {
        .Err(err) -> {
            return Err(err)
        }
        .Ok(got) -> got
    }
    if found == .Val(m) {
        if m.body.len() == 2 -> return Ok(place_of(m.body[1]))
    }
    Ok(None)
}

// The first signal `member` of `interface` (any of its signals, when
// `member` is "") from the object at `path` (any, when it is "") whose
// first argument is `first`, here or arriving within
// `timeout_ns`. The signals before it go; those after it stay queued, in
// order, for the next read.
next_signal: fn(c: &DbusConnection, interface: String, member: String, path: String, first: DbusValue, timeout_ns: Int) -[Net, Time]> DbusMessage? DbusError! {
    deadline: now() + timeout_ns
    wait := 0
    loop {
        got: signals(c, wait) ?? return Err(err)
        loop i in 0..<got.len() {
            if got[i].interface != interface || got[i].body.len() == 0 -> next
            if member != "" && got[i].member != member -> next
            if path != "" && got[i].path != path -> next
            if got[i].body[0] != first -> next
            loop later in got[(i + 1)..<got.len()] -> c.queued.push(later.copy())
            return Ok(Val(got[i].copy()))
        }
        wait = deadline - now()
        if wait <= 0 -> return Ok(None)
    }
    Ok(None)
}

// The place a LocationUpdated signal's options give, when they name both
// coordinates.
place_of: fn(options: DbusValue) -> PortalPlace? {
    north: option_double(options, "Latitude") ?? return None
    east: option_double(options, "Longitude") ?? return None
    Val(PortalPlace{latitude: north, longitude: east, accuracy: option_double(options, "Accuracy") ?? Float{0.0}})
}

// The number `options` gives `name`, when it gives one.
option_double: fn(options: DbusValue, name: String) -> Float? {
    if option_value(options, name) == .Val(value) {
        if value == .Double(f) -> return Val(f)
    }
    None
}

// The value that `options`, an `a{sv}` dictionary, gives `name`, when it
// names it.
option_value: fn(options: DbusValue, name: String) -> DbusValue? {
    if options == .Array(_, entries) {
        loop entry in entries {
            if entry == .Entry(key, value) {
                if string_of(key) != name -> next
                if value == .Variant(inner) -> return Val(inner.copy())
            }
        }
    }
    None
}

SENSOR_PROXY: "net.hadess.SensorProxy"

SENSOR_PATH: "/net/hadess/SensorProxy"

COMPASS: "net.hadess.SensorProxy.Compass"

COMPASS_PATH: "/net/hadess/SensorProxy/Compass"

// A sensor the sensor proxy (iio-sensor-proxy) reads for its clients on the
// system bus: the accelerometer, which tells how the device is held, and
// the compass, which tells where it points.
Sensor: enum {
    Accelerometer,
    Compass,
}

// Where the proxy keeps a sensor: its object and interface, the name its
// Has, Claim and Release members end with, and the property it reports.
SensorSite: struct {
    path: String,
    interface: String,
    name: String,
    reading: String,
}

sensor_site: fn(sensor: Sensor) -> SensorSite {
    if sensor == {
        .Accelerometer -> SensorSite{path: SENSOR_PATH, interface: SENSOR_PROXY, name: "Accelerometer", reading: "AccelerometerOrientation"}
        .Compass -> SensorSite{path: COMPASS_PATH, interface: COMPASS, name: "Compass", reading: "CompassHeading"}
    }
}

// Claims `sensor` from the proxy, so it reads the sensor for this
// connection, and gives its reading now, waiting at most `timeout_ns`;
// `None`, with nothing claimed, when the device has no such sensor. Each
// change after comes in a PropertiesChanged signal, which `sensor_change`
// reads, until `release_sensor` gives the sensor back.
claim_sensor: fn(c: &DbusConnection, sensor: Sensor, timeout_ns: Int) -[Net, Time]> DbusValue? DbusError! {
    deadline: now() + timeout_ns
    site: sensor_site(sensor)
    has: call_until(c, SENSOR_PROXY, site.path, PROPERTIES, "Get", [DbusValue]{DbusValue.Text(site.interface), DbusValue.Text("Has{site.name}")}, deadline) ?? return Err(err)
    if has.body.len() != 1 || has.body[0] != DbusValue.Variant(DbusValue.Bool(true)) {
        return Ok(None)
    }
    watch(c, PROPERTIES, "PropertiesChanged", site.path, deadline) ?? return Err(err)
    _: call_until(c, SENSOR_PROXY, site.path, site.interface, "Claim{site.name}", [DbusValue]{}, deadline) ?? return Err(err)
    current: call_until(c, SENSOR_PROXY, site.path, PROPERTIES, "Get", [DbusValue]{DbusValue.Text(site.interface), DbusValue.Text(site.reading)}, deadline) ?? return Err(err)
    if current.body.len() == 1 {
        if current.body[0] == .Variant(inner) -> return Ok(Val(inner.copy()))
    }
    Err(DbusError.Protocol("Get {site.reading} answered {current.signature}, not a variant"))
}

// The next reading of the claimed `sensor` that is here or arrives within
// `timeout_ns`: the new value of its property in a PropertiesChanged
// signal of the proxy's; `None` when none came.
sensor_change: fn(c: &DbusConnection, sensor: Sensor, timeout_ns: Int) -[Net, Time]> DbusValue? DbusError! {
    deadline: now() + timeout_ns
    site: sensor_site(sensor)
    loop {
        found: if next_signal(c, PROPERTIES, "PropertiesChanged", site.path, DbusValue.Text(site.interface), deadline - now()) == {
            .Err(err) -> {
                return Err(err)
            }
            .Ok(got) -> got
        }
        m: found ?? return Ok(None)
        if m.body.len() < 2 -> next
        if option_value(m.body[1], site.reading) == .Val(value) -> return Ok(Val(value.copy()))
    }
    Ok(None)
}

// Gives `sensor` back to the proxy, so it stops reading it for this
// connection.
release_sensor: fn(c: &DbusConnection, sensor: Sensor) -[Net, Time]> {
    site: sensor_site(sensor)
    _: call(c, SENSOR_PROXY, site.path, site.interface, "Release{site.name}", [DbusValue]{}, CLOSE_WAIT_NS) ?? blank(DbusKind.Return)
}

// A token for the next request's object path, unique on this connection.
request_token: fn(c: &DbusConnection) -> String { "jet{c.serial + 1}" }

// A portal call's options: one string, `name`.
string_option: fn(name: String, value: String) -> DbusValue {
    options_of([DbusValue]{entry_of(name, DbusValue.Text(value))})
}

// One entry of a portal call's options: `name` gives `value`.
entry_of: fn(name: String, value: DbusValue) -> DbusValue {
    DbusValue.Entry{key: DbusValue.Text(name), value: DbusValue.Variant(value)}
}

// An `a{sv}` dictionary of `entries`.
options_of: fn(entries: [DbusValue]) -> DbusValue {
    DbusValue.Array{signature: "{ascii(123)}sv{ascii(125)}", items: entries}
}

// The object path a portal call answered with.
answered_path: fn(reply: DbusMessage, member: String) -> String DbusError! {
    if reply.body.len() == 1 {
        if reply.body[0] == .Path(path) -> return Ok(path.copy())
    }
    Err(DbusError.Protocol("{member} answered {reply.signature}, not an object path"))
}

// Waits until `deadline` for the Response signal of the request at
// `request` and reads its code; no answer by then is `.Ended`. The other
// signals it reads stay queued, in order, for their own readers.
response: fn(c: &DbusConnection, request: String, deadline: Int) -[Net, Time]> PortalAnswer DbusError! {
    got: reply(c, request, deadline) ?? return Err(err)
    Ok(got.answer)
}

// A portal request's Response: the person's answer and the results the
// portal gave with it, an `a{sv}` dictionary (empty when none came).
PortalReply: struct {
    answer: PortalAnswer,
    results: DbusValue,
}

// Waits as `response` does, and reads the Response's results too.
reply: fn(c: &DbusConnection, request: String, deadline: Int) -[Net, Time]> PortalReply DbusError! {
    wait := 0
    others := [DbusMessage]{}
    loop {
        got: signals(c, wait) ?? return Err(err)
        loop i in 0..<got.len() {
            code: response_code(got[i], request)
            if code == NO_VALUE {
                if others.len() >= QUEUE_MAX -> others = others[1..<others.len()].copy()
                others.push(got[i].copy())
                next
            }
            loop later in got[(i + 1)..<got.len()] -> others.push(later.copy())
            c.queued = others.concat(c.queued)
            results: if got[i].body.len() == 2 -> got[i].body[1].copy() else -> options_of([DbusValue]{})
            answer: if code == 0 -> PortalAnswer.Allowed else if code == 1 -> PortalAnswer.Refused else -> PortalAnswer.Ended
            return Ok(PortalReply{answer: answer, results: results})
        }
        wait = deadline - now()
        if wait <= 0 -> break
    }
    c.queued = others.concat(c.queued)
    Ok(PortalReply{answer: PortalAnswer.Ended, results: options_of([DbusValue]{})})
}

// The code of `m` when it is the Response signal of the request at
// `request`, or -1.
response_code: fn(m: DbusMessage, request: String) -> Int {
    if m.interface != REQUEST || m.member != "Response" || m.path != request || m.body.len() == 0 {
        return NO_VALUE
    }
    if m.body[0] == .Uint32(code) -> return code
    NO_VALUE
}

// ---- the portal's file dialogs

FILE_CHOOSER: "org.freedesktop.portal.FileChooser"

// A kind of file a file dialog offers: the name the dialog shows, and the
// glob patterns and media types a file of that kind matches.
FileFilter: struct {
    name: String,
    globs: [String],
    media: [String],
}

// Shows the portal's open dialog, titled `title`, offering `filters` (the
// first one chosen), and waits at most `timeout_ns` for the person. Gives
// the `file://` URI of the file they chose, for the caller to read, or None
// when they cancelled or chose nothing in time.
portal_open_file: fn(c: &DbusConnection, title: String, filters: [FileFilter], timeout_ns: Int) -[Net, Time]> String? DbusError! {
    file_dialog(c, "OpenFile", title, [DbusValue]{}, filters, timeout_ns)
}

// Shows the portal's open dialog, titled `title`, asking for a folder, and
// waits at most `timeout_ns` for the person. Gives the `file://` URI of the
// folder they chose, or None when they cancelled or chose nothing in time.
portal_open_folder: fn(c: &DbusConnection, title: String, timeout_ns: Int) -[Net, Time]> String? DbusError! {
    file_dialog(c, "OpenFile", title, [DbusValue]{entry_of("directory", DbusValue.Bool(true))}, [FileFilter]{}, timeout_ns)
}

// Shows the portal's save dialog, titled `title`, with the file name
// `suggested` filled in and `filters` offered (the first one chosen), and
// waits at most `timeout_ns` for the person. Gives the `file://` URI of
// the file they chose, for the caller to write, or None when they
// cancelled or chose nothing in time.
portal_save_file: fn(c: &DbusConnection, title: String, suggested: String, filters: [FileFilter], timeout_ns: Int) -[Net, Time]> String? DbusError! {
    file_dialog(c, "SaveFile", title, [DbusValue]{entry_of("current_name", DbusValue.Text(suggested))}, filters, timeout_ns)
}

// Shows the FileChooser dialog `member` with the options `named` beside
// its handle token and `filters`, and gives the URI of the one file or
// folder the person chose, or None when they chose none in time.
file_dialog: fn(c: &DbusConnection, member: String, title: String, named: [DbusValue], filters: [FileFilter], timeout_ns: Int) -[Net, Time]> String? DbusError! {
    deadline: now() + timeout_ns
    watch(c, REQUEST, "Response", "", deadline) ?? return Err(err)
    options := [DbusValue]{entry_of("handle_token", DbusValue.Text(request_token(c)))}
    loop option in named -> options.push(option.copy())
    if filters.len() > 0 {
        offered := [DbusValue]{}
        loop filter in filters -> offered.push(filter_value(filter))
        options.push(entry_of("filters", DbusValue.Array{signature: "(sa(us))", items: offered}))
        options.push(entry_of("current_filter", filter_value(filters[0])))
    }
    // No parent window: the dialog stands on its own.
    asked: call_until(c, PORTAL_NAME, PORTAL_PATH, FILE_CHOOSER, member, [DbusValue]{DbusValue.Text(""), DbusValue.Text(title), options_of(options)}, deadline) ?? return Err(err)
    request: answered_path(asked, member) ?? return Err(err)
    answered: reply(c, request, deadline) ?? return Err(err)
    if answered.answer != .Allowed -> return Ok(None)
    if option_value(answered.results, "uris") == .Val(uris) {
        if uris == .Array(_, items) {
            if items.len() > 0 {
                if items[0] == .Text(uri) -> return Ok(Val(uri.copy()))
            }
        }
    }
    Err(DbusError.Protocol("{member}'s response named no file"))
}

// A filter as the portal reads it: its name, then each glob pattern (kind
// 0) and media type (kind 1).
filter_value: fn(filter: FileFilter) -> DbusValue {
    patterns := [DbusValue]{}
    loop glob in filter.globs {
        patterns.push(DbusValue.Struct([DbusValue]{DbusValue.Uint32(0), DbusValue.Text(glob)}))
    }
    loop media in filter.media {
        patterns.push(DbusValue.Struct([DbusValue]{DbusValue.Uint32(1), DbusValue.Text(media)}))
    }
    DbusValue.Struct([DbusValue]{DbusValue.Text(filter.name), DbusValue.Array{signature: "(us)", items: patterns}})
}

// ---- notifications

NOTIFICATIONS: "org.freedesktop.Notifications"

NOTIFICATIONS_PATH: "/org/freedesktop/Notifications"

// The action a click on the notification itself invokes.
OPEN_ACTION: "default"

// Shows a notification through the desktop's notification service and
// gives its ID, waiting at most `timeout_ns`. `app` names the app it comes
// from and `desktop_id` the app's desktop entry. `title` is the summary,
// and `body` is the text under it, escaped when the service reads markup
// in it. A click on the notification invokes its `OPEN_ACTION`. Before it
// shows anything, it asks the bus for the service's ActionInvoked and
// NotificationClosed signals, which `notification_end` reads.
notify: fn(c: &DbusConnection, app: String, desktop_id: String, title: String, body: String, timeout_ns: Int) -[Net, Time]> Int DbusError! {
    deadline: now() + timeout_ns
    watch(c, NOTIFICATIONS, "ActionInvoked", NOTIFICATIONS_PATH, deadline) ?? return Err(err)
    watch(c, NOTIFICATIONS, "NotificationClosed", NOTIFICATIONS_PATH, deadline) ?? return Err(err)
    told: call_until(c, NOTIFICATIONS, NOTIFICATIONS_PATH, NOTIFICATIONS, "GetCapabilities", [DbusValue]{}, deadline) ?? return Err(err)
    marked := false
    if told.body.len() == 1 {
        if told.body[0] == .Array(_, items) {
            marked = items.contains(DbusValue.Text("body-markup"))
        }
    }
    text: if marked -> markup_text(body) else -> body
    actions: DbusValue.Array{signature: "s", items: [DbusValue]{DbusValue.Text(OPEN_ACTION), DbusValue.Text("Open")}}
    // The app's name, no notification to replace, no icon, the summary,
    // the body, the actions, the hints, and the service's own timeout.
    shown: call_until(c, NOTIFICATIONS, NOTIFICATIONS_PATH, NOTIFICATIONS, "Notify", [DbusValue]{DbusValue.Text(app), DbusValue.Uint32(0), DbusValue.Text(""), DbusValue.Text(title), DbusValue.Text(text), actions, string_option("desktop-entry", desktop_id), DbusValue.Int32(-1)}, deadline) ?? return Err(err)
    if shown.body.len() == 1 {
        if shown.body[0] == .Uint32(id) -> return Ok(id)
    }
    Err(DbusError.Protocol("Notify answered {shown.signature}, not a notification ID"))
}

// `text` as notification markup shows it: `&`, `<` and `>` escaped.
markup_text: fn(text: String) -> String {
    text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
}

// What became of the notification `id`, read from a signal that is here or
// arrives within `timeout_ns`: true when the person clicked the
// notification itself (its `OPEN_ACTION`), false when it closed or they
// chose another action, and `None` when neither came.
notification_end: fn(c: &DbusConnection, id: Int, timeout_ns: Int) -[Net, Time]> Bool? DbusError! {
    deadline: now() + timeout_ns
    loop {
        found: if next_signal(c, NOTIFICATIONS, "", NOTIFICATIONS_PATH, DbusValue.Uint32(id), deadline - now()) == {
            .Err(err) -> {
                return Err(err)
            }
            .Ok(got) -> got
        }
        m: found ?? return Ok(None)
        if m.member == "NotificationClosed" -> return Ok(Val(false))
        if m.member == "ActionInvoked" && m.body.len() == 2 {
            return Ok(Val(m.body[1] == DbusValue.Text(OPEN_ACTION)))
        }
    }
    Ok(None)
}

// ---- the tray and the menus it and a window's menu bar serve

WATCHER: "org.kde.StatusNotifierWatcher"

WATCHER_PATH: "/StatusNotifierWatcher"

ITEM: "org.kde.StatusNotifierItem"

ITEM_PATH: "/StatusNotifierItem"

MENU: "com.canonical.dbusmenu"

MENU_PATH: "/MenuBar"

INVALID_ARGS: "org.freedesktop.DBus.Error.InvalidArgs"

// The dbusmenu version this menu speaks.
MENU_VERSION: 3

// One entry of a menu this connection serves (dbusmenu): a label the person
// can choose, one shown but not `enabled`, a separator line, or a submenu
// of `children`. `shortcut` names the keys that choose it as dbusmenu
// names them (`["Control", "n"]`), empty for none.
MenuEntry: struct {
    label: String,
    enabled: Bool,
    separator: Bool,
    shortcut: [String],
    children: [MenuEntry],
}

// A menu this connection serves at MENU_PATH: its entries, and the
// revision of its layout, which grows each time the entries change
// (`menu_show`). The root is item 0 and the items after it are numbered
// depth first, each entry before its children: item `i` is entry `i - 1`
// of `menu_entries`.
ServedMenu: struct {
    entries: [MenuEntry],
    revision: Int,
}

// A tray icon this connection serves: its title, its icon (a name in the
// desktop's icon theme) and its menu.
Tray: struct {
    title: String,
    icon: String,
    menu: ServedMenu,
}

// Puts the icon `icon` titled `title` in the desktop's tray as the item of
// the process `pid`, with an empty menu until `menu_show`, waiting at most
// `timeout_ns`. It takes the item's well-known name, serves the item and
// its menu, and registers the item with the desktop's
// StatusNotifierWatcher; a desktop with no tray has none, and that call
// fails. `tray_answer` answers what the desktop then asks.
tray_start: fn(c: &DbusConnection, title: String, icon: String, pid: Int, timeout_ns: Int) -[Net, Time]> Tray DbusError! {
    deadline: now() + timeout_ns
    name: "{ITEM}-{pid}-1"
    owned: request_name(c, name, timeout_ns) ?? return Err(err)
    if !owned {
        return Err(DbusError.Failed{name: "org.freedesktop.DBus.Error.AddressInUse", message: "another connection owns {name}"})
    }
    serve(c, ITEM_PATH)
    menu: menu_start(c)
    _: call_until(c, WATCHER, WATCHER_PATH, WATCHER, "RegisterStatusNotifierItem", [DbusValue]{DbusValue.Text(name)}, deadline) ?? return Err(err)
    Ok(Tray{title: title, icon: icon, menu: menu})
}

// Serves a menu at MENU_PATH, empty until `menu_show`: a tray's, or a
// window's menu bar, which the window names by this connection's unique
// name and the path. `menu_answer` answers what the desktop then asks.
menu_start: fn(c: &DbusConnection) -> ServedMenu {
    serve(c, MENU_PATH)
    ServedMenu{entries: [MenuEntry]{}, revision: 1}
}

// Makes `entries` the menu's. When they differ from the entries it has,
// the layout's revision grows and the desktop hears LayoutUpdated, so it
// reads the menu again.
menu_show: fn(c: &DbusConnection, menu: &ServedMenu, entries: [MenuEntry]) -[Net, Time]> DbusError! {
    if entries == menu.entries -> return Ok()
    menu.entries = entries
    menu.revision += 1
    emit(c, MENU_PATH, MENU, "LayoutUpdated", [DbusValue]{DbusValue.Uint32(menu.revision), DbusValue.Int32(0)})
}

// Answers `m`, a call the desktop made to the tray's item or its menu, and
// gives the index in `menu_entries` of the entry the person chose when `m`
// says they clicked one they can choose.
tray_answer: fn(c: &DbusConnection, tray: Tray, m: DbusMessage) -[Net, Time]> Int? DbusError! {
    if m.path == ITEM_PATH && m.interface == PROPERTIES && (m.member == "GetAll" || (m.member == "Get" && m.body.len() == 2)) {
        answer_properties(c, m, tray_item_properties(tray)) ?? return Err(err)
        return Ok(None)
    }
    // A click, a middle click, a right click or a scroll on the icon: the
    // item is its menu (ItemIsMenu), so the desktop shows the menu.
    clicked: m.member == "Activate" || m.member == "SecondaryActivate" || m.member == "ContextMenu" || m.member == "Scroll"
    if m.path == ITEM_PATH && on(m, ITEM) && clicked {
        answer(c, m, [DbusValue]{}) ?? return Err(err)
        return Ok(None)
    }
    menu_answer(c, tray.menu, m)
}

// Answers `m`, a call the desktop made to the menu, and gives the index in
// `menu_entries` of the entry the person chose when `m` says they clicked
// one they can choose: enabled, and no separator or submenu.
menu_answer: fn(c: &DbusConnection, menu: ServedMenu, m: DbusMessage) -[Net, Time]> Int? DbusError! {
    if m.path == MENU_PATH && m.interface == PROPERTIES && (m.member == "GetAll" || (m.member == "Get" && m.body.len() == 2)) {
        answer_properties(c, m, menu_properties()) ?? return Err(err)
        return Ok(None)
    }
    if m.path == MENU_PATH && on(m, MENU) -> return menu_call(c, menu, m)
    refuse(c, m, UNKNOWN_METHOD, "no method {m.interface}.{m.member} here") ?? return Err(err)
    Ok(None)
}

// Answers a Properties GetAll or Get call with `props` (`a{sv}` entries).
answer_properties: fn(c: &DbusConnection, m: DbusMessage, props: [DbusValue]) -[Net, Time]> DbusError! {
    if m.member == "GetAll" -> return answer(c, m, [DbusValue]{options_of(props)})
    name: string_of(m.body[1])
    answer_property(c, m, props, name, "no property {name} here")
}

// Answers a dbusmenu call; see `menu_answer`.
menu_call: fn(c: &DbusConnection, menu: ServedMenu, m: DbusMessage) -[Net, Time]> Int? DbusError! {
    flat: menu_entries(menu.entries)
    if m.member == "GetLayout" && m.body.len() == 3 {
        parent: int_of(m.body[0]) ?? -1
        depth: int_of(m.body[1]) ?? -1
        if parent < 0 || parent > flat.len() {
            refuse(c, m, INVALID_ARGS, "no menu item {parent} here") ?? return Err(err)
            return Ok(None)
        }
        answer(c, m, [DbusValue]{DbusValue.Uint32(menu.revision), menu_layout(menu, flat, parent, depth)}) ?? return Err(err)
        return Ok(None)
    }
    if m.member == "GetGroupProperties" && m.body.len() == 2 {
        ids := [Int]{}
        if m.body[0] == .Array(_, items) {
            loop item in items -> ids.push(int_of(item) ?? -1)
        }
        if ids.len() == 0 {
            loop i in 0..<(flat.len() + 1) -> ids.push(i)
        }
        found := [DbusValue]{}
        loop id in ids {
            if id < 0 || id > flat.len() -> next
            found.push(DbusValue.Struct([DbusValue]{DbusValue.Int32(id), options_of(menu_item_props(flat, id))}))
        }
        answer(c, m, [DbusValue]{DbusValue.Array{signature: "(ia{ascii(123)}sv{ascii(125)})", items: found}}) ?? return Err(err)
        return Ok(None)
    }
    if m.member == "GetProperty" && m.body.len() == 2 {
        id: int_of(m.body[0]) ?? -1
        name: string_of(m.body[1])
        props: if id >= 0 && id <= flat.len() -> menu_item_props(flat, id) else -> [DbusValue]{}
        answer_property(c, m, props, name, "menu item {id} has no property {name}") ?? return Err(err)
        return Ok(None)
    }
    if m.member == "Event" && m.body.len() == 4 {
        answer(c, m, [DbusValue]{}) ?? return Err(err)
        return Ok(menu_chosen(flat, m.body[0], m.body[1]))
    }
    if m.member == "EventGroup" && m.body.len() == 1 {
        chosen := Int?{None}
        if m.body[0] == .Array(_, events) {
            loop event in events {
                if chosen != None -> break
                if event == .Struct(fields) {
                    if fields.len() == 4 -> chosen = menu_chosen(flat, fields[0], fields[1])
                }
            }
        }
        answer(c, m, [DbusValue]{DbusValue.Array{signature: "i", items: [DbusValue]{}}}) ?? return Err(err)
        return Ok(chosen)
    }
    // The menu is current before it opens: it says LayoutUpdated whenever
    // its entries change.
    if m.member == "AboutToShow" && m.body.len() == 1 {
        answer(c, m, [DbusValue]{DbusValue.Bool(false)}) ?? return Err(err)
        return Ok(None)
    }
    if m.member == "AboutToShowGroup" && m.body.len() == 1 {
        none: DbusValue.Array{signature: "i", items: [DbusValue]{}}
        answer(c, m, [DbusValue]{none.copy(), none}) ?? return Err(err)
        return Ok(None)
    }
    refuse(c, m, UNKNOWN_METHOD, "no method {m.interface}.{m.member} here") ?? return Err(err)
    Ok(None)
}

// Whether the call `m` is to `interface`; a call may leave its interface
// out.
on: fn(m: DbusMessage, interface: String) -> Bool { m.interface == interface || m.interface == "" }

// Answers the call `m` with the property `name` of `props` (`a{sv}`
// entries), as a variant, else with InvalidArgs saying `missing`.
answer_property: fn(c: &DbusConnection, m: DbusMessage, props: [DbusValue], name: String, missing: String) -[Net, Time]> DbusError! {
    found: option_value(options_of(props), name) ?? return refuse(c, m, INVALID_ARGS, missing)
    answer(c, m, [DbusValue]{DbusValue.Variant(found)})
}

// The number an Int32 or Uint32 holds.
int_of: fn(value: DbusValue) -> Int? {
    if value == .Int32(n) -> return Val(n)
    if value == .Uint32(n) -> return Val(n)
    None
}

// The entries of `entries` depth first, each before its children: entry
// `i` is the menu's item `i + 1`.
menu_entries: fn(entries: [MenuEntry]) -> [MenuEntry] {
    out := [MenuEntry]{}
    loop entry in entries {
        out.push(entry.copy())
        loop inner in menu_entries(entry.children) -> out.push(inner)
    }
    out
}

// How many items `entry` and the entries under it are.
menu_size: fn(entry: MenuEntry) -> Int {
    size := 1
    loop child in entry.children -> size += menu_size(child)
    size
}

// The index in `flat` (`menu_entries`) an Event with the item `id` and the
// event `event` chose: a click on an enabled entry that is no separator and
// opens no submenu.
menu_chosen: fn(flat: [MenuEntry], id: DbusValue, event: DbusValue) -> Int? {
    if event != DbusValue.Text("clicked") -> return None
    index: (int_of(id) ?? 0) - 1
    if index < 0 || index >= flat.len() -> return None
    entry: flat[index]
    if entry.separator || !entry.enabled || entry.children.len() > 0 -> return None
    Val(index)
}

// The `(ia{sv}av)` layout of the item `id` (0, the root, holds the entries)
// with its children `depth` levels down (-1: all).
menu_layout: fn(menu: ServedMenu, flat: [MenuEntry], id: Int, depth: Int) -> DbusValue {
    if id == 0 -> return menu_node(0, menu_item_props(flat, 0), menu.entries, depth)
    menu_node(id, menu_item_props(flat, id), flat[id - 1].children, depth)
}

// The layout of the item `id` with the properties `props`, whose children
// are `children`, numbered from `id + 1` on, `depth` levels down.
menu_node: fn(id: Int, props: [DbusValue], children: [MenuEntry], depth: Int) -> DbusValue {
    items := [DbusValue]{}
    if depth != 0 {
        child := id + 1
        loop entry in children {
            items.push(DbusValue.Variant(menu_node(child, menu_entry_props(entry), entry.children, depth - 1)))
            child += menu_size(entry)
        }
    }
    DbusValue.Struct([DbusValue]{DbusValue.Int32(id), options_of(props), DbusValue.Array{signature: "v", items: items}})
}

// The properties of the menu item `id` of `flat` (`menu_entries`): the
// root opens a submenu.
menu_item_props: fn(flat: [MenuEntry], id: Int) -> [DbusValue] {
    if id == 0 -> return [DbusValue]{entry_of("children-display", DbusValue.Text("submenu"))}
    menu_entry_props(flat[id - 1])
}

// The properties of `entry`'s item: a separator says so, and an entry has
// its label (`_` doubled, since a single one marks an access key), says
// when it is not enabled, names its shortcut's keys, and says when it
// opens a submenu.
menu_entry_props: fn(entry: MenuEntry) -> [DbusValue] {
    if entry.separator -> return [DbusValue]{entry_of("type", DbusValue.Text("separator"))}
    props := [DbusValue]{entry_of("label", DbusValue.Text(entry.label.replace("_", "__")))}
    if !entry.enabled -> props.push(entry_of("enabled", DbusValue.Bool(false)))
    if entry.shortcut.len() > 0 {
        keys := [DbusValue]{}
        loop key in entry.shortcut -> keys.push(DbusValue.Text(key))
        props.push(entry_of("shortcut", DbusValue.Array{signature: "as", items: [DbusValue]{DbusValue.Array{signature: "s", items: keys}}}))
    }
    if entry.children.len() > 0 {
        props.push(entry_of("children-display", DbusValue.Text("submenu")))
    }
    props
}

// The StatusNotifierItem's properties: an app's icon, always shown, whose
// menu is the whole item.
tray_item_properties: fn(tray: Tray) -> [DbusValue] {
    tip: DbusValue.Struct([DbusValue]{DbusValue.Text(""), DbusValue.Array{signature: "(iiay)", items: [DbusValue]{}}, DbusValue.Text(tray.title), DbusValue.Text("")})
    [DbusValue]{
        entry_of("Category", DbusValue.Text("ApplicationStatus")),
        entry_of("Id", DbusValue.Text(tray.title)),
        entry_of("Title", DbusValue.Text(tray.title)),
        entry_of("Status", DbusValue.Text("Active")),
        entry_of("IconName", DbusValue.Text(tray.icon)),
        entry_of("ToolTip", tip),
        entry_of("ItemIsMenu", DbusValue.Bool(true)),
        entry_of("Menu", DbusValue.Path(MENU_PATH)),
    }
}

// The dbusmenu object's properties.
menu_properties: fn() -> [DbusValue] {
    [DbusValue]{
        entry_of("Version", DbusValue.Uint32(MENU_VERSION)),
        entry_of("TextDirection", DbusValue.Text("ltr")),
        entry_of("Status", DbusValue.Text("normal")),
        entry_of("IconThemePath", DbusValue.Array{signature: "s", items: [DbusValue]{}}),
    }
}

// ---- test fixtures

// A connected pair of sockets: the client's end and a fake bus's.
TestBus: struct {
    client: net.UnixStream,
    server: net.UnixStream,
}

test_bus: fn(name: String) -[Env, Net, Time]> TestBus {
    path: "{sys.temp_dir()}/jet-core-dbus-{sys.getpid()}-{name}.sock"
    listener: net.unix_listen(path) ?? panic("listen on {path}: {err}")
    client: net.unix_connect(path) ?? panic("connect to {path}: {err}")
    server: net.unix_accept(listener) ?? panic("accept on {path}: {err}")
    TestBus{client: client, server: server}
}

// What the fake bus will answer, written before the client asks.
bus_says: fn(server: &net.UnixStream, bytes: [U8]) -[Net, Time]> {
    net.unix_send(server, bytes, [sys.Fd]{}) ?? panic("the fake bus could not write: {err}")
}

// Everything the client has written to the fake bus.
bus_heard: fn(server: &net.UnixStream) -[Net, Time]> [U8] {
    out := [U8]{}
    loop net.unix_wait(server, 0) ?? panic("the fake bus could not wait: {err}") {
        got: net.unix_receive(server, RECEIVE_MAX) ?? panic("the fake bus could not read: {err}")
        if got.bytes.len() == 0 -> break
        append(out, got.bytes)
    }
    out
}

hello_call: fn() -> DbusMessage {
    m := blank(DbusKind.Call)
    m.path = BUS_PATH
    m.interface = BUS_NAME
    m.member = "Hello"
    m.destination = BUS_NAME
    m
}

reply_to: fn(serial: Int, body: [DbusValue]) -> DbusMessage {
    m := blank(DbusKind.Return)
    m.reply_serial = serial
    m.sender = BUS_NAME
    m.body = body
    m
}

signal: fn(path: String, interface: String, member: String, body: [DbusValue]) -> DbusMessage {
    m := blank(DbusKind.Signal)
    m.path = path
    m.interface = interface
    m.member = member
    m.sender = BUS_NAME
    m.body = body
    m
}

wire: fn(m: DbusMessage, serial: Int) -> [U8] { encode(m, serial) ?? panic("encode: {err}") }

// The bytes `hex` spells.
hex_bytes: fn(hex: String) -> [U8] {
    digits: hex.bytes()
    out := [U8]{}
    loop i in 0..<(digits.len() /% 2) {
        out.push(U8{hex_digit(Int{digits[2 * i]}) * 16 + hex_digit(Int{digits[2 * i + 1]})})
    }
    out
}

append: fn(out: &[U8], bytes: [U8]) {
    loop b in bytes -> out.push(b)
}

// A message of type `kind` built field by field, for headers `encode`
// never writes.
framed: fn(kind: Int, fields: [DbusValue], body: [U8]) -> [U8] {
    out := [U8]{U8{108}, U8{kind}, U8{0}, U8{1}}
    put_word(out, body.len(), 4)
    put_word(out, 7, 4)
    marshal(out, DbusValue.Array{signature: "(yv)", items: fields})
    pad(out, 8)
    append(out, body)
    out
}

// The header of a signal whose body has `signature`.
signal_fields: fn(signature: String) -> [DbusValue] {
    fields := [DbusValue]{header_field(1, DbusValue.Path("/a")), header_field(2, DbusValue.Text("a.b")), header_field(3, DbusValue.Text("C"))}
    if signature != "" -> fields.push(header_field(8, DbusValue.Signature(signature)))
    fields
}

// The text of the protocol error `bytes` decode to.
protocol_error: fn(bytes: [U8]) -> String {
    if decode(bytes) == {
        .Ok(_) -> panic("a hostile message decoded")
        .Err(err) -> protocol_text(err)
    }
}

protocol_text: fn(problem: DbusError) -> String {
    if problem == .Protocol(text) -> return text.copy()
    panic("not a protocol error: {problem}")
}

error_kind: fn(problem: DbusError) -> String {
    if problem == {
        .NoBus(_) -> "NoBus"
        .Connect(_) -> "Connect"
        .Auth(_) -> "Auth"
        .Protocol(_) -> "Protocol"
        .Closed -> "Closed"
        .Timeout(_) -> "Timeout"
        .Failed(_, _) -> "Failed"
    }
}

start_error: fn(stream: &&net.UnixStream, timeout_ns: Int) -[Net, Time]> String {
    if start(stream.move(), 1000, timeout_ns) == {
        .Ok(_) -> "connected"
        .Err(err) -> error_kind(err)
    }
}

path_error: fn(address: String, runtime: String) -> String {
    if session_path(address, runtime) == {
        .Ok(path) -> "found {path}"
        .Err(err) -> error_kind(err)
    }
}

repeat: fn(text: String, times: Int) -> String {
    out := ""
    loop _ in 0..<times -> out = "{out}{text}"
    out
}

#Test("a Hello call is the bytes every D-Bus client sends") {
    want := hex_bytes("6c01000100000000010000006d000000")
    append(want, hex_bytes("01016f0015000000"))
    append(want, BUS_PATH.bytes())
    append(want, hex_bytes("000000"))
    append(want, hex_bytes("0201730014000000"))
    append(want, BUS_NAME.bytes())
    append(want, hex_bytes("00000000"))
    append(want, hex_bytes("0301730005000000"))
    append(want, "Hello".bytes())
    append(want, hex_bytes("000000"))
    append(want, hex_bytes("0601730014000000"))
    append(want, BUS_NAME.bytes())
    append(want, hex_bytes("00000000"))
    assert_eq(want.len(), 128)
    assert_eq(wire(hello_call(), 1), want)
}

#Test("every value type survives the wire") {
    open: ascii(123)
    close: ascii(125)
    entry: DbusValue.Entry{key: DbusValue.Text("k"), value: DbusValue.Variant(DbusValue.Bool(false))}
    inner: DbusValue.Array{signature: "y", items: [DbusValue]{DbusValue.Byte(9)}}
    body: [DbusValue]{
        DbusValue.Byte(255),
        DbusValue.Bool(true),
        DbusValue.Int16(-2),
        DbusValue.Uint16(65535),
        DbusValue.Int32(-5),
        DbusValue.Uint32(4294967295),
        DbusValue.Int64(-9223372036854775807),
        DbusValue.Uint64(18446744073709551615),
        DbusValue.Double(Float{-1.5}),
        DbusValue.Text("héllo"),
        DbusValue.Path("/a/b_1"),
        DbusValue.Signature("a{open}sv{close}"),
        DbusValue.Variant(DbusValue.Int32(7)),
        DbusValue.Array{signature: "x", items: [DbusValue]{}},
        DbusValue.Array{signature: "{open}sv{close}", items: [DbusValue]{entry}},
        DbusValue.Struct([DbusValue]{DbusValue.Byte(1), DbusValue.Double(Float{0.25}), inner}),
    }
    m := signal("/a", "a.b", "C", body.copy())
    m.destination = ":1.7"
    bytes: wire(m, 9)
    decoded: decode(bytes) ?? panic("decode: {err}")
    assert_eq(decoded.used, bytes.len())
    got: decoded.message ?? panic("a signal decoded as nothing")
    assert_eq(got.kind, DbusKind.Signal)
    assert_eq(got.serial, 9)
    assert_eq(got.path, "/a")
    assert_eq(got.interface, "a.b")
    assert_eq(got.member, "C")
    assert_eq(got.sender, BUS_NAME)
    assert_eq(got.destination, ":1.7")
    assert_eq(got.signature, "ybnqiuxtdsogvaxa{open}sv{close}(yday)")
    assert_eq(got.body, body)
    // An empty array of 8-aligned elements still pads to its first element.
    empty: wire(signal("/a", "a.b", "C", [DbusValue]{DbusValue.Array{signature: "x", items: [DbusValue]{}}}), 2)
    assert_eq(word(empty, 4, 4), 8)
    // Half a message is no message yet.
    assert_eq((decode(bytes[0..<10].copy()) ?? panic("short: {err}")).used, 0)
    assert_eq((decode(bytes[0..<(bytes.len() - 1)].copy()) ?? panic("short: {err}")).used, 0)
}

#Test("hostile messages are protocol errors, never faults") {
    hello: wire(hello_call(), 1)
    changed := fn(at: Int, value: Int) -> [U8] {
        out := hello.copy()
        out[at] = U8{value}
        out
    }
    assert_eq(protocol_error(changed(0, 66)), "a big-endian message arrived; only little-endian ones are read")
    assert_eq(protocol_error(changed(0, 120)), "a message starts with byte 120, not an endianness mark")
    assert_eq(protocol_error(changed(3, 2)), "a message has protocol version 2, not 1")
    assert_eq(protocol_error(changed(8, 0)), "a message has serial 0")
    assert_eq(protocol_error(changed(46, 1)), "padding at byte 46 is not zero")
    assert_eq(protocol_error(changed(20, 200)), "a value runs past the end of its message or array")
    huge_fields := hello.copy()
    huge_fields[15] = U8{4}
    huge_fields[12] = U8{1}
    assert_eq(protocol_error(huge_fields), "a header's fields take 67108865 bytes, over the limit")
    huge_body := hello.copy()
    huge_body[4] = U8{255}
    huge_body[5] = U8{255}
    huge_body[6] = U8{255}
    huge_body[7] = U8{7}
    assert_eq(protocol_error(huge_body), "a message of 134217855 bytes is over the limit")
    // Header fields: required ones, their types, and descriptors.
    assert_eq(protocol_error(framed(1, [DbusValue]{header_field(1, DbusValue.Path("/a"))}, [U8]{})), "a method call has no member")
    assert_eq(protocol_error(framed(1, [DbusValue]{header_field(1, DbusValue.Text("/a")), header_field(3, DbusValue.Text("m"))}, [U8]{})), "header field 1 holds a s, not a o")
    assert_eq(protocol_error(framed(3, [DbusValue]{header_field(4, DbusValue.Text("a.B"))}, [U8]{})), "an error has no reply serial")
    with_fds := signal_fields("")
    with_fds.push(header_field(9, DbusValue.Uint32(1)))
    assert_eq(protocol_error(framed(4, with_fds, [U8]{})), "a message carries Unix descriptors, which were not negotiated")
    // Values.
    assert_eq(protocol_error(framed(4, signal_fields("b"), [U8]{U8{2}, U8{0}, U8{0}, U8{0}})), "a boolean holds 2")
    assert_eq(protocol_error(framed(4, signal_fields("s"), [U8]{U8{2}, U8{0}, U8{0}, U8{0}, U8{255}, U8{254}, U8{0}})), "a string is not UTF-8")
    assert_eq(protocol_error(framed(4, signal_fields("s"), [U8]{U8{2}, U8{0}, U8{0}, U8{0}, U8{97}, U8{0}, U8{0}})), "a string holds a NUL")
    assert_eq(protocol_error(framed(4, signal_fields("s"), [U8]{U8{1}, U8{0}, U8{0}, U8{0}, U8{97}, U8{98}})), "a string does not end in NUL")
    assert_eq(protocol_error(framed(4, signal_fields("o"), [U8]{U8{3}, U8{0}, U8{0}, U8{0}, U8{97}, U8{47}, U8{98}, U8{0}})), "a/b is not an object path")
    assert_eq(protocol_error(framed(4, signal_fields("h"), [U8]{U8{0}, U8{0}, U8{0}, U8{0}})), "a message names a Unix descriptor, but none were negotiated")
    assert_eq(protocol_error(framed(4, signal_fields("ay"), [U8]{U8{1}, U8{0}, U8{0}, U8{4}})), "an array of 67108865 bytes is over the limit")
    assert_eq(protocol_error(framed(4, signal_fields("y"), [U8]{U8{1}, U8{2}})), "a body is 1 bytes longer than its signature y")
    assert_eq(protocol_error(framed(4, signal_fields("v"), [U8]{U8{2}, U8{105}, U8{105}, U8{0}, U8{1}, U8{0}, U8{0}, U8{0}})), "a variant's signature ii is not one complete type")
    deep := [U8]{}
    loop _ in 0..<65 -> append(deep, [U8]{U8{1}, U8{118}, U8{0}})
    append(deep, [U8]{U8{1}, U8{121}, U8{0}, U8{5}})
    assert_eq(protocol_error(framed(4, signal_fields("v"), deep)), "values nest deeper than 64")
    nested: "{repeat("a", 33)}y"
    assert_eq(protocol_error(framed(4, signal_fields(nested), [U8]{})), "{nested} is not a signature")
    // A message of a type this client does not know is skipped whole.
    unknown: framed(9, signal_fields("y"), [U8]{U8{1}})
    skipped: decode(unknown) ?? panic("an unknown type is an error: {err}")
    assert_eq(skipped.used, unknown.len())
    assert(skipped.message == None, "an unknown type is skipped")
}

#Test("signatures are complete types within the nesting limits") {
    open: ascii(123)
    close: ascii(125)
    good: [String]{"", "y", "a{open}sv{close}", "(ii)", "aa{open}s(ii){close}", "{repeat("a", 32)}y", "{repeat("(", 32)}y{repeat(")", 32)}", repeat("y", 255)}
    loop text in good -> assert(valid_signature(text), "{text} is a signature")
    bad: [String]{"a", "()", "{open}sv{close}", "a{open}vs{close}", "a{open}sss{close}", "(i", "i)", "z", "{repeat("a", 33)}y", "{repeat("(", 33)}y{repeat(")", 33)}", repeat("y", 256)}
    loop text in bad -> assert(!valid_signature(text), "{text} is not a signature")
}

#Test("the session bus is found from its address or the runtime directory") {
    assert_eq(session_path("unix:path=/run/user/1000/bus", "") ?? panic("{err}"), "/run/user/1000/bus")
    assert_eq(session_path("unix:path=/tmp/a%20b,guid=1234", "") ?? panic("{err}"), "/tmp/a b")
    assert_eq(session_path("tcp:host=x,port=1;unix:path=/b", "") ?? panic("{err}"), "/b")
    assert_eq(session_path("unix:runtime=yes", "/run/user/7") ?? panic("{err}"), "/run/user/7/bus")
    assert_eq(session_path("", "/run/user/7") ?? panic("{err}"), "/run/user/7/bus")
    assert_eq(path_error("", ""), "NoBus")
    assert_eq(path_error("unix:abstract=/tmp/dbus-x", ""), "NoBus")
    assert_eq(path_error("unix:path=/a%2", ""), "NoBus")
    assert_eq(path_error("unix:runtime=yes", ""), "NoBus")
}

#Test("a bus connection authenticates, reads the portal's appearance and hears it change") {
    open: ascii(123)
    close: ascii(125)
    bus := test_bus("appearance")
    ping := blank(DbusKind.Call)
    ping.path = "/x"
    ping.interface = "org.freedesktop.DBus.Peer"
    ping.member = "Ping"
    ping.sender = ":1.9"
    accent: DbusValue.Struct([DbusValue]{DbusValue.Double(Float{0.25}), DbusValue.Double(Float{0.5}), DbusValue.Double(Float{1.0})})
    settings: [DbusValue]{
        DbusValue.Entry{key: DbusValue.Text("color-scheme"), value: DbusValue.Variant(DbusValue.Uint32(1))},
        DbusValue.Entry{key: DbusValue.Text("accent-color"), value: DbusValue.Variant(accent)},
        DbusValue.Entry{key: DbusValue.Text("contrast"), value: DbusValue.Variant(DbusValue.Uint32(1))},
        DbusValue.Entry{key: DbusValue.Text("reduced-motion"), value: DbusValue.Variant(DbusValue.Uint32(1))},
    }
    group: DbusValue.Entry{key: DbusValue.Text(APPEARANCE), value: DbusValue.Array{signature: "{open}sv{close}", items: settings}}
    script := [U8]{}
    append(script, "OK 0123456789abcdef0123456789abcdef\r\n".bytes())
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.42")}), 1))
    append(script, wire(signal(BUS_PATH, BUS_NAME, "NameAcquired", [DbusValue]{DbusValue.Text(":1.42")}), 2))
    append(script, wire(ping, 3))
    append(script, wire(reply_to(2, [DbusValue]{DbusValue.Array{signature: "{open}sa{open}sv{close}{close}", items: [DbusValue]{group}}}), 4))
    bus_says(bus.server, script)
    c := start(bus.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    assert_eq(c.name, ":1.42")
    look := appearance(c, 1000000000) ?? panic("appearance: {err}")
    assert_eq(look.scheme, PortalScheme.Dark)
    assert_eq(look.accent, [Float]{Float{0.25}, Float{0.5}, Float{1.0}})
    assert(look.high_contrast, "the desktop asks for high contrast")
    // What the client said: the credentials byte, EXTERNAL for uid 1000,
    // BEGIN, Hello, ReadAll, and UnknownMethod for the Ping.
    heard: bus_heard(bus.server)
    want := [U8]{U8{0}}
    append(want, "AUTH EXTERNAL 31303030\r\nBEGIN\r\n".bytes())
    append(want, wire(hello_call(), 1))
    assert_eq(heard[0..<want.len()].copy(), want)
    rest: heard[want.len()..<heard.len()].copy()
    first: decode(rest) ?? panic("ReadAll: {err}")
    read_all: first.message ?? panic("ReadAll decoded as nothing")
    assert_eq(read_all.kind, DbusKind.Call)
    assert_eq(read_all.serial, 2)
    assert_eq(read_all.destination, PORTAL_NAME)
    assert_eq(read_all.path, PORTAL_PATH)
    assert_eq(read_all.interface, SETTINGS)
    assert_eq(read_all.member, "ReadAll")
    assert_eq(read_all.body, [DbusValue]{DbusValue.Array{signature: "s", items: [DbusValue]{DbusValue.Text(APPEARANCE)}}})
    second: decode(rest[first.used..<rest.len()].copy()) ?? panic("UnknownMethod: {err}")
    refusal: second.message ?? panic("UnknownMethod decoded as nothing")
    assert_eq(refusal.kind, DbusKind.Error)
    assert_eq(refusal.serial, 3)
    assert_eq(refusal.reply_serial, 3)
    assert_eq(refusal.error_name, UNKNOWN_METHOD)
    assert_eq(refusal.destination, ":1.9")
    assert_eq(first.used + second.used, rest.len())
    // The signal that came during the calls waited in the queue.
    queued: signals(c, 0) ?? panic("signals: {err}")
    assert_eq(queued.len(), 1)
    assert_eq(queued[0].member, "NameAcquired")
    // A setting changes, then the portal restarts.
    later := [U8]{}
    append(later, wire(signal(PORTAL_PATH, SETTINGS, "SettingChanged", [DbusValue]{DbusValue.Text(APPEARANCE), DbusValue.Text("color-scheme"), DbusValue.Variant(DbusValue.Uint32(2))}), 5))
    append(later, wire(signal(BUS_PATH, BUS_NAME, "NameOwnerChanged", [DbusValue]{DbusValue.Text(PORTAL_NAME), DbusValue.Text(":1.5"), DbusValue.Text(":1.6")}), 6))
    bus_says(bus.server, later)
    got: signals(c, 1000000000) ?? panic("signals: {err}")
    assert_eq(got.len(), 2)
    assert(apply_signal(look, got[0].copy()), "the colour scheme changed")
    assert_eq(look.scheme, PortalScheme.Light)
    assert(!apply_signal(look, got[0].copy()), "the same scheme again changes nothing")
    assert(!apply_signal(look, got[1].copy()), "a restart is no setting")
    assert(portal_restarted(got[1].copy()), "the portal has a new owner")
    assert(!portal_restarted(got[0].copy()), "a setting is no restart")
}

#Test("a refused uid, a missing portal, a closed bus and a silent bus are typed errors") {
    ok: "OK 0123456789abcdef0123456789abcdef\r\n".bytes()
    refused := test_bus("refused")
    bus_says(refused.server, "REJECTED EXTERNAL\r\n".bytes())
    assert_eq(start_error(refused.client.move(), 1000000000), "Auth")
    closed := test_bus("closed")
    bus_says(closed.server, ok.copy())
    net.unix_shutdown(closed.server, NetShutdown.Write) ?? panic("shutdown: {err}")
    assert_eq(start_error(closed.client.move(), 1000000000), "Closed")
    silent := test_bus("silent")
    bus_says(silent.server, ok.copy())
    assert_eq(start_error(silent.client.move(), 20000000), "Timeout")
    absent := test_bus("absent")
    missing := blank(DbusKind.Error)
    missing.reply_serial = 2
    missing.error_name = "org.freedesktop.DBus.Error.ServiceUnknown"
    missing.body = [DbusValue]{DbusValue.Text("The name is not activatable")}
    script := ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.43")}), 1))
    append(script, wire(missing, 2))
    bus_says(absent.server, script)
    c := start(absent.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    if appearance(c, 1000000000) == {
        .Ok(_) -> { panic("an absent portal answered") }
        .Err(err) -> {
            assert_eq(err, DbusError.Failed{name: "org.freedesktop.DBus.Error.ServiceUnknown", message: "The name is not activatable"})
        }
    }
}

#Test("the portal asks for the camera and the location and reads the person's answer") {
    ok: "OK 0123456789abcdef0123456789abcdef\r\n".bytes()
    no_options: DbusValue.Array{signature: "{ascii(123)}sv{ascii(125)}", items: [DbusValue]{}}
    camera := test_bus("camera")
    request: "{PORTAL_PATH}/request/1_42/jet4"
    script := ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.42")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{DbusValue.Variant(DbusValue.Bool(true))}), 2))
    append(script, wire(reply_to(3, [DbusValue]{}), 3))
    append(script, wire(reply_to(4, [DbusValue]{DbusValue.Path(request)}), 4))
    append(script, wire(signal("{PORTAL_PATH}/request/1_42/other", REQUEST, "Response", [DbusValue]{DbusValue.Uint32(1), no_options.copy()}), 5))
    append(script, wire(signal(request, REQUEST, "Response", [DbusValue]{DbusValue.Uint32(0), no_options.copy()}), 6))
    bus_says(camera.server, script)
    c := start(camera.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    assert_eq(portal_camera(c, 1000000000) ?? panic("camera: {err}"), PortalAnswer.Allowed)
    asked_camera: [String]{
        "org.freedesktop.DBus.Hello",
        "org.freedesktop.DBus.Properties.Get",
        "org.freedesktop.DBus.AddMatch",
        "org.freedesktop.portal.Camera.AccessCamera",
    }
    assert_eq(calls_heard(camera.server), asked_camera)
    // No camera: nobody is asked.
    none := test_bus("no-camera")
    script = ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.43")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{DbusValue.Variant(DbusValue.Bool(false))}), 2))
    bus_says(none.server, script)
    d := start(none.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    assert_eq(portal_camera(d, 1000000000) ?? panic("no camera: {err}"), PortalAnswer.Absent)
    assert_eq(calls_heard(none.server), [String]{"org.freedesktop.DBus.Hello", "org.freedesktop.DBus.Properties.Get"})
    // The location: refused, and the session closed after.
    place := test_bus("location")
    session: "{PORTAL_PATH}/session/1_44/jet3"
    started: "{PORTAL_PATH}/request/1_44/jet4"
    script = ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.44")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{}), 2))
    append(script, wire(reply_to(3, [DbusValue]{DbusValue.Path(session)}), 3))
    append(script, wire(reply_to(4, [DbusValue]{DbusValue.Path(started)}), 4))
    append(script, wire(signal(started, REQUEST, "Response", [DbusValue]{DbusValue.Uint32(1), no_options.copy()}), 5))
    append(script, wire(reply_to(5, [DbusValue]{}), 6))
    bus_says(place.server, script)
    e := start(place.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    assert_eq(portal_location(e, 1000000000) ?? panic("location: {err}"), PortalAnswer.Refused)
    asked_location: [String]{
        "org.freedesktop.DBus.Hello",
        "org.freedesktop.DBus.AddMatch",
        "org.freedesktop.portal.Location.CreateSession",
        "org.freedesktop.portal.Location.Start",
        "org.freedesktop.portal.Session.Close",
    }
    assert_eq(calls_heard(place.server), asked_location)
    // A request nobody answers in time has ended.
    quiet := test_bus("unanswered")
    script = ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.45")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{DbusValue.Variant(DbusValue.Bool(true))}), 2))
    append(script, wire(reply_to(3, [DbusValue]{}), 3))
    append(script, wire(reply_to(4, [DbusValue]{DbusValue.Path(request)}), 4))
    bus_says(quiet.server, script)
    f := start(quiet.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    assert_eq(portal_camera(f, 50000000) ?? panic("unanswered: {err}"), PortalAnswer.Ended)
}

#Test("a location session gives the first place it reports once the person allows it") {
    ok: "OK 0123456789abcdef0123456789abcdef\r\n".bytes()
    no_options: DbusValue.Array{signature: "{ascii(123)}sv{ascii(125)}", items: [DbusValue]{}}
    allowed := test_bus("place")
    session: "{PORTAL_PATH}/session/1_46/jet4"
    started: "{PORTAL_PATH}/request/1_46/jet5"
    here: place_options([Float]{Float{52.52}, Float{13.405}, Float{20.0}})
    elsewhere: place_options([Float]{Float{1.0}, Float{2.0}, Float{3.0}})
    script := ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.46")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{}), 2))
    append(script, wire(reply_to(3, [DbusValue]{}), 3))
    append(script, wire(reply_to(4, [DbusValue]{DbusValue.Path(session)}), 4))
    append(script, wire(reply_to(5, [DbusValue]{DbusValue.Path(started)}), 5))
    // Another session's report is not this one's, and the report may come
    // with the answer.
    append(script, wire(signal(PORTAL_PATH, LOCATION, "LocationUpdated", [DbusValue]{DbusValue.Path("{PORTAL_PATH}/session/1_46/other"), elsewhere}), 6))
    append(script, wire(signal(started, REQUEST, "Response", [DbusValue]{DbusValue.Uint32(0), no_options.copy()}), 7))
    append(script, wire(signal(PORTAL_PATH, LOCATION, "LocationUpdated", [DbusValue]{DbusValue.Path(session), here}), 8))
    append(script, wire(reply_to(6, [DbusValue]{}), 9))
    bus_says(allowed.server, script)
    c := start(allowed.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    fix: portal_place(c, 1000000000) ?? panic("place: {err}")
    assert_eq(fix.answer, PortalAnswer.Allowed)
    assert_eq(fix.place, Val(PortalPlace{latitude: Float{52.52}, longitude: Float{13.405}, accuracy: Float{20.0}}))
    asked: [String]{
        "org.freedesktop.DBus.Hello",
        "org.freedesktop.DBus.AddMatch",
        "org.freedesktop.DBus.AddMatch",
        "org.freedesktop.portal.Location.CreateSession",
        "org.freedesktop.portal.Location.Start",
        "org.freedesktop.portal.Session.Close",
    }
    assert_eq(calls_heard(allowed.server), asked)
    // Refused: no place, and nothing waited for.
    refused := test_bus("no-place")
    script = ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.47")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{}), 2))
    append(script, wire(reply_to(3, [DbusValue]{}), 3))
    append(script, wire(reply_to(4, [DbusValue]{DbusValue.Path("{PORTAL_PATH}/session/1_47/jet4")}), 4))
    append(script, wire(reply_to(5, [DbusValue]{DbusValue.Path("{PORTAL_PATH}/request/1_47/jet5")}), 5))
    append(script, wire(signal("{PORTAL_PATH}/request/1_47/jet5", REQUEST, "Response", [DbusValue]{DbusValue.Uint32(1), no_options.copy()}), 6))
    append(script, wire(reply_to(6, [DbusValue]{}), 7))
    bus_says(refused.server, script)
    d := start(refused.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    none: portal_place(d, 1000000000) ?? panic("no place: {err}")
    assert_eq(none.answer, PortalAnswer.Refused)
    assert_eq(none.place, None)
}

#Test("a location session reports each place until it is closed") {
    ok: "OK 0123456789abcdef0123456789abcdef\r\n".bytes()
    no_options: DbusValue.Array{signature: "{ascii(123)}sv{ascii(125)}", items: [DbusValue]{}}
    bus := test_bus("places")
    session: "{PORTAL_PATH}/session/1_48/jet4"
    started: "{PORTAL_PATH}/request/1_48/jet5"
    script := ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.48")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{}), 2))
    append(script, wire(reply_to(3, [DbusValue]{}), 3))
    append(script, wire(reply_to(4, [DbusValue]{DbusValue.Path(session)}), 4))
    append(script, wire(reply_to(5, [DbusValue]{DbusValue.Path(started)}), 5))
    append(script, wire(signal(started, REQUEST, "Response", [DbusValue]{DbusValue.Uint32(0), no_options.copy()}), 6))
    append(script, wire(signal(PORTAL_PATH, LOCATION, "LocationUpdated", [DbusValue]{DbusValue.Path(session), place_options([Float]{Float{52.52}, Float{13.405}, Float{20.0}})}), 7))
    // Another session's report is not this one's.
    append(script, wire(signal(PORTAL_PATH, LOCATION, "LocationUpdated", [DbusValue]{DbusValue.Path("{PORTAL_PATH}/session/1_48/other"), place_options([Float]{Float{1.0}, Float{2.0}, Float{3.0}})}), 8))
    append(script, wire(signal(PORTAL_PATH, LOCATION, "LocationUpdated", [DbusValue]{DbusValue.Path(session), place_options([Float]{Float{52.5201}, Float{13.4051}, Float{10.0}})}), 9))
    bus_says(bus.server, script)
    c := start(bus.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    opened: open_location(c, true, 1000000000) ?? panic("open: {err}")
    assert_eq(opened.answer, PortalAnswer.Allowed)
    assert_eq(opened.path, session)
    assert_eq(found_place(next_place(c, opened.path, 1000000000)), Val(PortalPlace{latitude: Float{52.52}, longitude: Float{13.405}, accuracy: Float{20.0}}))
    assert_eq(found_place(next_place(c, opened.path, 1000000000)), Val(PortalPlace{latitude: Float{52.5201}, longitude: Float{13.4051}, accuracy: Float{10.0}}))
    assert_eq(found_place(next_place(c, opened.path, 0)), PortalPlace?{None})
    bus_says(bus.server, wire(reply_to(6, [DbusValue]{}), 10))
    close_location(c, opened.path)
    asked: [String]{
        "org.freedesktop.DBus.Hello",
        "org.freedesktop.DBus.AddMatch",
        "org.freedesktop.DBus.AddMatch",
        "org.freedesktop.portal.Location.CreateSession",
        "org.freedesktop.portal.Location.Start",
        "org.freedesktop.portal.Session.Close",
    }
    assert_eq(calls_heard(bus.server), asked)
}

#Test("a sensor is claimed, read as it changes and given back") {
    ok: "OK 0123456789abcdef0123456789abcdef\r\n".bytes()
    bus := test_bus("accelerometer")
    script := ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.49")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{DbusValue.Variant(DbusValue.Bool(true))}), 2))
    append(script, wire(reply_to(3, [DbusValue]{}), 3))
    append(script, wire(reply_to(4, [DbusValue]{}), 4))
    append(script, wire(reply_to(5, [DbusValue]{DbusValue.Variant(DbusValue.Text("normal"))}), 5))
    // Another interface's change, and a change of another property, are
    // not the orientation's.
    append(script, wire(sensor_changed(SENSOR_PATH, "net.hadess.Other", "AccelerometerOrientation", DbusValue.Text("bottom-up")), 6))
    append(script, wire(sensor_changed(SENSOR_PATH, SENSOR_PROXY, "LightLevel", DbusValue.Double(Float{3.0})), 7))
    append(script, wire(sensor_changed(SENSOR_PATH, SENSOR_PROXY, "AccelerometerOrientation", DbusValue.Text("left-up")), 8))
    bus_says(bus.server, script)
    c := start(bus.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    assert_eq(found_value(claim_sensor(c, Sensor.Accelerometer, 1000000000)), Val(DbusValue.Text("normal")))
    assert_eq(found_value(sensor_change(c, Sensor.Accelerometer, 1000000000)), Val(DbusValue.Text("left-up")))
    assert_eq(found_value(sensor_change(c, Sensor.Accelerometer, 0)), DbusValue?{None})
    bus_says(bus.server, wire(reply_to(6, [DbusValue]{}), 9))
    release_sensor(c, Sensor.Accelerometer)
    asked: [String]{
        "org.freedesktop.DBus.Hello",
        "org.freedesktop.DBus.Properties.Get",
        "org.freedesktop.DBus.AddMatch",
        "net.hadess.SensorProxy.ClaimAccelerometer",
        "org.freedesktop.DBus.Properties.Get",
        "net.hadess.SensorProxy.ReleaseAccelerometer",
    }
    assert_eq(calls_heard(bus.server), asked)
    // A device with no compass: nothing is claimed.
    none := test_bus("no-compass")
    script = ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.50")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{DbusValue.Variant(DbusValue.Bool(false))}), 2))
    bus_says(none.server, script)
    d := start(none.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    assert_eq(found_value(claim_sensor(d, Sensor.Compass, 1000000000)), DbusValue?{None})
    assert_eq(calls_heard(none.server), [String]{"org.freedesktop.DBus.Hello", "org.freedesktop.DBus.Properties.Get"})
}

#Test("a notification is shown, escaped where the service reads markup, and read until it ends") {
    ok: "OK 0123456789abcdef0123456789abcdef\r\n".bytes()
    said: "Fix <b>the gate</b> & ship"
    bus := test_bus("notify")
    script := ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.51")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{}), 2))
    append(script, wire(reply_to(3, [DbusValue]{}), 3))
    append(script, wire(reply_to(4, [DbusValue]{texts([String]{"body", "body-markup", "actions"})}), 4))
    append(script, wire(reply_to(5, [DbusValue]{DbusValue.Uint32(7)}), 5))
    // Another notification's click, then this one's, then it closes.
    append(script, wire(signal(NOTIFICATIONS_PATH, NOTIFICATIONS, "ActionInvoked", [DbusValue]{DbusValue.Uint32(6), DbusValue.Text(OPEN_ACTION)}), 6))
    append(script, wire(signal(NOTIFICATIONS_PATH, NOTIFICATIONS, "ActionInvoked", [DbusValue]{DbusValue.Uint32(7), DbusValue.Text(OPEN_ACTION)}), 7))
    append(script, wire(signal(NOTIFICATIONS_PATH, NOTIFICATIONS, "NotificationClosed", [DbusValue]{DbusValue.Uint32(7), DbusValue.Uint32(2)}), 8))
    bus_says(bus.server, script)
    c := start(bus.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    shown: notify(c, "Crew", "crew", "Due today", said, 1000000000) ?? panic("notify: {err}")
    assert_eq(shown, 7)
    assert_eq(found_flag(notification_end(c, 7, 1000000000)), Val(true))
    assert_eq(found_flag(notification_end(c, 7, 1000000000)), Val(false))
    assert_eq(found_flag(notification_end(c, 7, 0)), Bool?{None})
    heard: messages_heard(bus.server)
    asked: [String]{
        "org.freedesktop.DBus.Hello",
        "org.freedesktop.DBus.AddMatch",
        "org.freedesktop.DBus.AddMatch",
        "org.freedesktop.Notifications.GetCapabilities",
        "org.freedesktop.Notifications.Notify",
    }
    assert_eq(heard.len(), asked.len())
    loop i in 0..<asked.len() -> assert_eq("{heard[i].interface}.{heard[i].member}", asked[i])
    sent: heard[4].body
    assert_eq(sent.len(), 8)
    assert_eq(sent[0], DbusValue.Text("Crew"))
    assert_eq(sent[3], DbusValue.Text("Due today"))
    assert_eq(sent[4], DbusValue.Text("Fix &lt;b&gt;the gate&lt;/b&gt; &amp; ship"))
    assert_eq(sent[5], texts([String]{OPEN_ACTION, "Open"}))
    assert_eq(sent[6], string_option("desktop-entry", "crew"))
    // A service that shows the body as plain text gets it as it is.
    plain := test_bus("notify-plain")
    script = ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.52")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{}), 2))
    append(script, wire(reply_to(3, [DbusValue]{}), 3))
    append(script, wire(reply_to(4, [DbusValue]{texts([String]{"body"})}), 4))
    append(script, wire(reply_to(5, [DbusValue]{DbusValue.Uint32(8)}), 5))
    bus_says(plain.server, script)
    d := start(plain.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    assert_eq(notify(d, "Crew", "crew", "Due today", said, 1000000000) ?? panic("notify: {err}"), 8)
    assert_eq(messages_heard(plain.server)[4].body[4], DbusValue.Text(said))
}

#Test("the portal's save dialog offers the file's name and kinds and gives the file the person chose") {
    ok: "OK 0123456789abcdef0123456789abcdef\r\n".bytes()
    csv: FileFilter{name: "CSV", globs: [String]{"*.csv"}, media: [String]{"text/csv"}}
    chosen: "file:///home/crew/Board%201.csv"
    bus := test_bus("save")
    request: "{PORTAL_PATH}/request/1_53/jet3"
    script := ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.53")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{}), 2))
    append(script, wire(reply_to(3, [DbusValue]{DbusValue.Path(request)}), 3))
    append(script, wire(signal(request, REQUEST, "Response", [DbusValue]{DbusValue.Uint32(0), options_of([DbusValue]{entry_of("uris", texts([String]{chosen}))})}), 4))
    bus_says(bus.server, script)
    c := start(bus.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    assert_eq(found_text(portal_save_file(c, "Save", "Board 1.csv", [FileFilter]{csv.copy()}, 1000000000)), Val(chosen))
    heard: messages_heard(bus.server)
    assert_eq(heard.len(), 3)
    assert_eq("{heard[2].interface}.{heard[2].member}", "org.freedesktop.portal.FileChooser.SaveFile")
    sent: heard[2].body
    assert_eq(sent.len(), 3)
    assert_eq(sent[0], DbusValue.Text(""))
    assert_eq(sent[1], DbusValue.Text("Save"))
    assert_eq(option_value(sent[2], "handle_token"), Val(DbusValue.Text("jet3")))
    assert_eq(option_value(sent[2], "current_name"), Val(DbusValue.Text("Board 1.csv")))
    filter: DbusValue.Struct([DbusValue]{DbusValue.Text("CSV"), DbusValue.Array{signature: "(us)", items: [DbusValue]{DbusValue.Struct([DbusValue]{DbusValue.Uint32(0), DbusValue.Text("*.csv")}), DbusValue.Struct([DbusValue]{DbusValue.Uint32(1), DbusValue.Text("text/csv")})}}})
    assert_eq(option_value(sent[2], "filters"), Val(DbusValue.Array{signature: "(sa(us))", items: [DbusValue]{filter.copy()}}))
    assert_eq(option_value(sent[2], "current_filter"), Val(filter))
    // The person cancels: no file, and nothing is offered but the name.
    cancelled := test_bus("save-cancelled")
    script = ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.54")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{}), 2))
    append(script, wire(reply_to(3, [DbusValue]{DbusValue.Path(request)}), 3))
    append(script, wire(signal(request, REQUEST, "Response", [DbusValue]{DbusValue.Uint32(1), options_of([DbusValue]{})}), 4))
    bus_says(cancelled.server, script)
    d := start(cancelled.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    assert_eq(found_text(portal_save_file(d, "Save", "notes.txt", [FileFilter]{}, 1000000000)), String?{None})
    options: messages_heard(cancelled.server)[2].body[2]
    assert_eq(option_value(options, "filters"), DbusValue?{None})
    assert_eq(option_value(options, "current_name"), Val(DbusValue.Text("notes.txt")))
}

#Test("the portal's open dialog offers the file kinds and gives the file the person chose") {
    ok: "OK 0123456789abcdef0123456789abcdef\r\n".bytes()
    csv: FileFilter{name: "CSV", globs: [String]{"*.csv"}, media: [String]{"text/csv"}}
    chosen: "file:///home/crew/tasks.csv"
    bus := test_bus("open")
    request: "{PORTAL_PATH}/request/1_55/jet3"
    script := ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.55")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{}), 2))
    append(script, wire(reply_to(3, [DbusValue]{DbusValue.Path(request)}), 3))
    append(script, wire(signal(request, REQUEST, "Response", [DbusValue]{DbusValue.Uint32(0), options_of([DbusValue]{entry_of("uris", texts([String]{chosen}))})}), 4))
    bus_says(bus.server, script)
    c := start(bus.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    assert_eq(found_text(portal_open_file(c, "Open", [FileFilter]{csv.copy()}, 1000000000)), Val(chosen))
    heard: messages_heard(bus.server)
    assert_eq(heard.len(), 3)
    assert_eq("{heard[2].interface}.{heard[2].member}", "org.freedesktop.portal.FileChooser.OpenFile")
    sent: heard[2].body
    assert_eq(sent[1], DbusValue.Text("Open"))
    assert_eq(option_value(sent[2], "handle_token"), Val(DbusValue.Text("jet3")))
    assert_eq(option_value(sent[2], "current_name"), DbusValue?{None})
    assert_eq(option_value(sent[2], "current_filter"), Val(filter_value(csv)))
    // The portal answers without a file: that is a protocol failure.
    empty := test_bus("open-empty")
    script = ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.56")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{}), 2))
    append(script, wire(reply_to(3, [DbusValue]{DbusValue.Path(request)}), 3))
    append(script, wire(signal(request, REQUEST, "Response", [DbusValue]{DbusValue.Uint32(0), options_of([DbusValue]{})}), 4))
    bus_says(empty.server, script)
    d := start(empty.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    assert(portal_open_file(d, "Open", [FileFilter]{}, 1000000000) == .Err(DbusError.Protocol("OpenFile's response named no file")))
}

#Test("a tray serves its item and menu, says when the menu changes and hears what the person chose") {
    ok: "OK 0123456789abcdef0123456789abcdef\r\n".bytes()
    bus := test_bus("tray")
    script := ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.60")}), 1))
    append(script, wire(reply_to(2, [DbusValue]{DbusValue.Uint32(PRIMARY_OWNER)}), 2))
    append(script, wire(reply_to(3, [DbusValue]{}), 3))
    // The desktop reads the item and the menu, then the person clicks the
    // second entry and the separator; a call to no served object is
    // refused.
    append(script, wire(desktop_call(ITEM_PATH, PROPERTIES, "GetAll", [DbusValue]{DbusValue.Text(ITEM)}), 4))
    append(script, wire(desktop_call(MENU_PATH, MENU, "GetLayout", [DbusValue]{DbusValue.Int32(0), DbusValue.Int32(-1), texts([String]{})}), 5))
    append(script, wire(desktop_call(MENU_PATH, MENU, "Event", menu_click(2)), 6))
    append(script, wire(desktop_call(MENU_PATH, "", "Event", menu_click(3)), 7))
    append(script, wire(desktop_call("/elsewhere", MENU, "GetLayout", [DbusValue]{DbusValue.Int32(0), DbusValue.Int32(-1), texts([String]{})}), 8))
    bus_says(bus.server, script)
    c := start(bus.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    tray := tray_start(c, "Crewboard", "crewboard", 42, 1000000000) ?? panic("tray: {err}")
    quit: menu_item("Quit", [String]{})
    line: MenuEntry{label: "", enabled: true, separator: true, shortcut: [String]{}, children: [MenuEntry]{}}
    first: [MenuEntry]{menu_item("Gate repair", [String]{}), menu_item("Spring_fair", [String]{}), line.copy(), quit.copy()}
    menu_show(c, tray.menu, first.copy()) ?? panic("show: {err}")
    chosen := [String]{}
    loop _ in 0..<4 {
        m: found_call(next_call(c, 1000000000)) ?? panic("no call came")
        got: found_choice(tray_answer(c, tray, m))
        chosen.push(if got == .Val(index) -> "{index}" else -> "-")
    }
    assert_eq(chosen.join(" "), "- - 1 -")
    assert_eq(found_call(next_call(c, 0)), DbusMessage?{None})
    // The same entries again change nothing; a new one is a new revision.
    menu_show(c, tray.menu, first.copy()) ?? panic("show: {err}")
    launch := menu_item("Launch", [String]{})
    launch.enabled = false
    menu_show(c, tray.menu, [MenuEntry]{launch, quit.copy()}) ?? panic("show: {err}")
    assert_eq(tray.menu.revision, 3)
    heard: messages_heard(bus.server)
    said := [String]{}
    loop m in heard {
        said.push(
            if m.kind == {
                .Call -> m.member.copy()
                .Signal -> "{m.member} {m.body}"
                .Return -> "return {m.reply_serial}"
                .Error -> "error {m.reply_serial} {m.error_name}"
            },
        )
    }
    assert_eq(said.join("\n"), "Hello\nRequestName\nRegisterStatusNotifierItem\nLayoutUpdated [Uint32(2), Int32(0)]\nerror 8 {UNKNOWN_METHOD}\nreturn 4\nreturn 5\nreturn 6\nreturn 7\nLayoutUpdated [Uint32(3), Int32(0)]")
    assert_eq(heard[1].body, [DbusValue]{DbusValue.Text("org.kde.StatusNotifierItem-42-1"), DbusValue.Uint32(DO_NOT_QUEUE)})
    assert_eq(heard[2].body, [DbusValue]{DbusValue.Text("org.kde.StatusNotifierItem-42-1")})
    item: heard[5].body[0]
    assert_eq(option_value(item, "IconName"), Val(DbusValue.Text("crewboard")))
    assert_eq(option_value(item, "ItemIsMenu"), Val(DbusValue.Bool(true)))
    assert_eq(option_value(item, "Menu"), Val(DbusValue.Path(MENU_PATH)))
    assert_eq(heard[6].body[0], DbusValue.Uint32(2))
    assert_eq(layout_tree(heard[6].body[1]), "Gate repair | Spring__fair | separator | Quit")
}

#Test("a menu bar serves its menus with their items' shortcuts and hears which item the person chose") {
    ok: "OK 0123456789abcdef0123456789abcdef\r\n".bytes()
    bus := test_bus("menubar")
    script := ok.copy()
    append(script, wire(reply_to(1, [DbusValue]{DbusValue.Text(":1.60")}), 1))
    // The desktop reads the whole menu, then the Edit menu alone; the
    // person clicks New Task, the File menu itself and Copy. The
    // connection serves no tray item, so a call to one is refused.
    append(script, wire(desktop_call(MENU_PATH, MENU, "GetLayout", [DbusValue]{DbusValue.Int32(0), DbusValue.Int32(-1), texts([String]{})}), 2))
    append(script, wire(desktop_call(MENU_PATH, MENU, "GetLayout", [DbusValue]{DbusValue.Int32(4), DbusValue.Int32(1), texts([String]{})}), 3))
    append(script, wire(desktop_call(MENU_PATH, MENU, "Event", menu_click(2)), 4))
    append(script, wire(desktop_call(MENU_PATH, MENU, "Event", menu_click(1)), 5))
    append(script, wire(desktop_call(MENU_PATH, MENU, "Event", menu_click(5)), 6))
    append(script, wire(desktop_call(ITEM_PATH, PROPERTIES, "GetAll", [DbusValue]{DbusValue.Text(ITEM)}), 7))
    bus_says(bus.server, script)
    c := start(bus.client.move(), 1000, 1000000000) ?? panic("start: {err}")
    menu := menu_start(c)
    file := menu_item("File", [String]{})
    file.children = [MenuEntry]{menu_item("New Task", [String]{"Control", "n"}), MenuEntry{label: "", enabled: true, separator: true, shortcut: [String]{}, children: [MenuEntry]{}}}
    edit := menu_item("Edit", [String]{})
    edit.children = [MenuEntry]{menu_item("Copy", [String]{"Control", "c"})}
    menu_show(c, menu, [MenuEntry]{file, edit}) ?? panic("show: {err}")
    chosen := [String]{}
    loop _ in 0..<5 {
        m: found_call(next_call(c, 1000000000)) ?? panic("no call came")
        got: found_choice(menu_answer(c, menu, m))
        chosen.push(if got == .Val(index) -> "{index}" else -> "-")
    }
    assert_eq(chosen.join(" "), "- - 1 - 4")
    heard: messages_heard(bus.server)
    said := [String]{}
    loop m in heard {
        said.push(if m.kind == .Return -> "return {m.reply_serial}" else if m.kind == .Error -> "error {m.reply_serial} {m.error_name}" else -> m.member.copy())
    }
    assert_eq(said.join("\n"), "Hello\nLayoutUpdated\nerror 7 {UNKNOWN_METHOD}\nreturn 2\nreturn 3\nreturn 4\nreturn 5\nreturn 6")
    assert_eq(layout_tree(heard[3].body[1]), "File(New Task[Control+n] | separator) | Edit(Copy[Control+c])")
    assert_eq(layout_tree(heard[4].body[1]), "Copy[Control+c]")
}

// An entry labelled `label` the person can choose, with the shortcut keys
// `shortcut`.
menu_item: fn(label: String, shortcut: [String]) -> MenuEntry {
    MenuEntry{label: label, enabled: true, separator: false, shortcut: shortcut, children: [MenuEntry]{}}
}

// A method call the desktop makes to the app's connection.
desktop_call: fn(path: String, interface: String, member: String, body: [DbusValue]) -> DbusMessage {
    m := blank(DbusKind.Call)
    m.path = path
    m.interface = interface
    m.member = member
    m.sender = ":1.9"
    m.destination = ":1.60"
    m.body = body
    m
}

// A dbusmenu Event's arguments: a click on the menu item `id`.
menu_click: fn(id: Int) -> [DbusValue] {
    [DbusValue]{DbusValue.Int32(id), DbusValue.Text("clicked"), DbusValue.Variant(DbusValue.Int32(0)), DbusValue.Uint32(0)}
}

// The children of a GetLayout answer's item: each one's label, or its type
// when it has no label, then its shortcut's keys in brackets and its own
// children in parentheses, separated by ` | `.
layout_tree: fn(layout: DbusValue) -> String {
    out := [String]{}
    if layout == .Struct(fields) {
        if fields[2] == .Array(_, children) {
            loop child in children {
                if child == .Variant(inner) {
                    if inner == .Struct(parts) {
                        found: option_value(parts[1], "label") ?? option_value(parts[1], "type") ?? DbusValue.Text("?")
                        text := string_of(found)
                        shortcut: option_value(parts[1], "shortcut") ?? DbusValue.Text("")
                        if shortcut == .Array(_, chords) {
                            loop chord in chords {
                                if chord == .Array(_, keys) {
                                    names := [String]{}
                                    loop key in keys -> names.push(string_of(key))
                                    text = "{text}[{names.join("+")}]"
                                }
                            }
                        }
                        below: layout_tree(inner)
                        if below != "" -> text = "{text}({below})"
                        out.push(text)
                    }
                }
            }
        }
    }
    out.join(" | ")
}

// The call a read gave, or the test fails with its error.
found_call: fn(got: DbusMessage? DbusError!) -> DbusMessage? {
    if got == {
        .Err(err) -> panic("call: {err}")
        .Ok(found) -> found
    }
}

// The entry an answer said the person chose, or the test fails with its
// error.
found_choice: fn(got: Int? DbusError!) -> Int? {
    if got == {
        .Err(err) -> panic("answer: {err}")
        .Ok(found) -> found
    }
}

// The text a read gave, or the test fails with its error.
found_text: fn(got: String? DbusError!) -> String? {
    if got == {
        .Err(err) -> panic("text: {err}")
        .Ok(found) -> found
    }
}

// An array of strings.
texts: fn(items: [String]) -> DbusValue {
    values := [DbusValue]{}
    loop item in items -> values.push(DbusValue.Text(item))
    DbusValue.Array{signature: "s", items: values}
}

// What a read of a notification's end gave, or the test fails with its
// error.
found_flag: fn(got: Bool? DbusError!) -> Bool? {
    if got == {
        .Err(err) -> panic("notification: {err}")
        .Ok(found) -> found
    }
}

// A LocationUpdated signal's options: latitude, longitude and accuracy.
place_options: fn(values: [Float]) -> DbusValue {
    names: [String]{"Latitude", "Longitude", "Accuracy"}
    items := [DbusValue]{}
    loop i in 0..<names.len() {
        items.push(DbusValue.Entry{key: DbusValue.Text(names[i]), value: DbusValue.Variant(DbusValue.Double(values[i]))})
    }
    DbusValue.Array{signature: "{ascii(123)}sv{ascii(125)}", items: items}
}

// A PropertiesChanged signal from the object at `path`: `property` of
// `interface` changed to `value`.
sensor_changed: fn(path: String, interface: String, property: String, value: DbusValue) -> DbusMessage {
    changed: DbusValue.Array{signature: "{ascii(123)}sv{ascii(125)}", items: [DbusValue]{DbusValue.Entry{key: DbusValue.Text(property), value: DbusValue.Variant(value)}}}
    signal(path, PROPERTIES, "PropertiesChanged", [DbusValue]{DbusValue.Text(interface), changed, DbusValue.Array{signature: "s", items: [DbusValue]{}}})
}

// The place a read gave, or the test fails with its error.
found_place: fn(got: PortalPlace? DbusError!) -> PortalPlace? {
    if got == {
        .Err(err) -> panic("place: {err}")
        .Ok(found) -> found
    }
}

// The value a read gave, or the test fails with its error.
found_value: fn(got: DbusValue? DbusError!) -> DbusValue? {
    if got == {
        .Err(err) -> panic("value: {err}")
        .Ok(found) -> found
    }
}

// The interface and member of each call the client made after it
// authenticated as uid 1000.
calls_heard: fn(server: &net.UnixStream) -[Net, Time]> [String] {
    out := [String]{}
    loop m in messages_heard(server) -> out.push("{m.interface}.{m.member}")
    out
}

// Each message the client sent after it authenticated as uid 1000.
messages_heard: fn(server: &net.UnixStream) -[Net, Time]> [DbusMessage] {
    heard: bus_heard(server)
    rest := heard[(1 + "AUTH EXTERNAL 31303030\r\nBEGIN\r\n".bytes().len())..<heard.len()].copy()
    out := [DbusMessage]{}
    loop rest.len() > 0 {
        decoded: decode(rest) ?? panic("decode: {err}")
        if decoded.used == 0 -> break
        if decoded.message == .Val(m) -> out.push(m.copy())
        rest = rest[decoded.used..<rest.len()].copy()
    }
    out
}
