            provenance :: if plan.action == .Generate || plan.action == .Rotate { JetVaultProvenance.Generated } else { JetVaultProvenance.Imported }
            record := JetVaultRecord{name: ~plan.name, key_type: T.TAG, generation: generation, status: .Active, provenance: provenance, opaque_id: opaque_id, created_unix_ms: unix_ms, status_unix_ms: unix_ms, record_hash: [U8; 32].filled(0), public_key_hash: public_key_hash, reason_hash: [U8; 32].filled(0), origin: None, key: ^key_bytes}
            record.record_hash = vault_record_hash(record)
            current = Val(vault_ref(store, record))
            &store.keys.push(^record)
