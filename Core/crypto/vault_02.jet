fn vault_quarantine_exact(dir: File, name: String, held: File, quarantine: String) -> Bool JetVaultError! {
    dirfd :: dir.as_raw_fd()
    visible :: vault_linux_openat(dirfd, name, 0, 0) ?? { if err.raw_os_error() == Val(2) -> return false; return Err(JetVaultError.Conflict) }
