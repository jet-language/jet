    if current_file == .Val(file) {
        if !(vault_remove_exact(dir_file, ".secrets.age.backup", file, ".secrets.age.backup.done.{hex_bytes(nonce)}") ?? return Err(err)) -> return Err(JetVaultError.DurabilityUnknown)
