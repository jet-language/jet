fn vault_commit_at<T: JetVaultKey>(root: OSPath, plan: ^JetVaultMutationPlan<T>, write: ^JetVaultWrite<T>, expected: JetVaultAction) -> (JetVaultKeyRef<T>?, JetVaultKeyRef<T>?) JetVaultError! {
