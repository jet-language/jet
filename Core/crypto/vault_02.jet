pub fn jet_vault_replace_strings_at(root: OSPath, pairs: ^[(String, String)]) -> () JetVaultError! {
    (canonical, _) :: vault_canonical_pairs(^pairs) ?? return Err(err)
    (store, start_hash, provider_hash, start_kind) := vault_read_at(root) ?? return Err(err)
