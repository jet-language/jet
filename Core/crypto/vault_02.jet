            key :: if &plan.imported.take() == .Val(bytes) { T.from_bytes(&bytes.0.take()) ?? return Err(err) } else { T.generate() ?? return Err(err) }
            public_key_hash :: vault_hash(["JVLT2 public key".as_bytes(), [U8]{T.TAG}, key.public_bytes()])
