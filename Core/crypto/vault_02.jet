// Rust: crates/jet-pkg-model/src/Prelude/VaultKeyWrap.rs:292
fn jvkw_export_to_recipients<T: JetVaultKey>(origin: ^JetVaultOrigin, key: ^Zeroizing<[U8]>, public: [U8; 32], created_unix_ms: U64, recipients: [JetX25519PublicKey]) -> JetWrappedVaultKey JetVaultKeyWrapError! {
