fn jvkw_argon(password: Secret, salt: [U8; 16], cancelled: fn() -> Bool, cancel_outcome: fn() -> (), wait_enter: fn() -> (), wait_leave: fn() -> ()) -> Zeroizing<[U8; 32]> JetVaultKeyWrapError! {
    if password.0.len() < 16 || password.0.len() > 1_048_576 -> return Err(JetVaultKeyWrapError.WeakPassphrase)
    params :: argon2.Params.new(65_536, 3, 1, Val(32)) ?? return Err(JetVaultKeyWrapError.Internal{incident_id: "jvkw-argon-params"})
    output :: jet_crypto_argon2id_run(password.0, salt, params, cancelled, wait_enter, wait_leave) ?? {
