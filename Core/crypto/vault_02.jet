        if action == .Revoke && record.status == .Revoked -> return Err(JetVaultError.Revoked)
    }
    public_key_hash :: if imported == .Val(bytes) { vault_public_hash(T.TAG, bytes) ?? return Err(err) } else { [U8; 32].filled(0) }
    key_digest :: if imported == .Val(bytes) { vault_key_digest(T.TAG, bytes) } else { [U8; 32].filled(0) }
    (reference_present, reference_repo, reference_generation, reference_opaque, reference_hash) :: if target == .Val(reference) {
