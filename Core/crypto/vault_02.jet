fn jvkw_source<T: JetVaultKey>(root: OSPath, reference: JetVaultKeyRef<T>) -> (JetVaultOrigin, Zeroizing<[U8]>, [U8; 32]) JetVaultKeyWrapError! {
    (store, _, _) :: vault_read_contents_at(root) ?? return Err(JetVaultKeyWrapError.Vault(err))
