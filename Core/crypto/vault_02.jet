fn vault_native_authorize(preview: String, repo_uuid: [U8; 16]) -> Bool {
    #If(test) {
        answer :: VAULT_AUTHORIZER.with((slot) -> slot.borrow_mut().as_mut().map((callback) -> callback(preview)))
        if answer == .Val(value) -> return value
    }
    if sys.target.selected_os() != "linux" -> return false
    tty :: fs.OpenOptions.new().read(true).write(true).open(OSPath.from("/dev/tty")) ?? return vault_headless_granted(repo_uuid)
    if tty.write_fmt("Vault write request: {preview}\nType `authorize` to continue:\n").is_err() -> return false
    reader_file :: tty.try_clone() ?? return false
    answer := String.new()
    success :: BufReader.new(^reader_file).read_line(&answer).is_ok()
    trimmed := answer.trim() // #4303
    success && trimmed == "authorize"
}
