fn jvkw_open_recipient(parsed: JvkwParsed, bytes: [U8], identity: JetX25519SecretKey) -> Zeroizing<[U8; 32]> JetVaultKeyWrapError! {
    #If(test) { JVKW_RECIPIENT_OPEN_COUNT.with((slot) -> slot.set(0)) }
    (count, ephemeral, salt, stanzas_at) :: if parsed.mode_header == .Recipient(c, e, s, a) { (c, e, s, a) } else { return Err(JetVaultKeyWrapError.OpenFailed) }
    private := Zeroizing([U8; 32].filled(0)); &private.0.copy_from_slice(identity.0)
    own_public :: x25519.x25519(private.0, x25519.X25519_BASEPOINT_BYTES)
    match_index :: (0..<count).find((index) -> { start :: stanzas_at + index * JVKW_RECIPIENT_STANZA_LEN; Bool.from(bytes[start..<start + 32].ct_eq(own_public)) })
    index :: match_index ?? 0
    stanza_at :: stanzas_at + index * JVKW_RECIPIENT_STANZA_LEN
    recipient_public :: bytes[stanza_at..<stanza_at + 32].try_into().unwrap()
    #If(test) { JVKW_RECIPIENT_OPEN_COUNT.with((slot) -> slot.set(slot.get() + 1)); JVKW_X25519_COUNT.with((slot) -> slot.set(slot.get() + 1)) }
    shared :: Zeroizing(x25519_checked(private.0, ephemeral) ?? return Err(JetVaultKeyWrapError.OpenFailed))
    key_info := "JVKW1 recipient key".into_bytes(); &key_info.extend_from_slice(parsed.export_id); &key_info.extend_from_slice(ephemeral); &key_info.extend_from_slice(recipient_public)
    nonce_info := "JVKW1 recipient nonce".into_bytes(); &nonce_info.extend_from_slice(parsed.export_id); &nonce_info.extend_from_slice(ephemeral); &nonce_info.extend_from_slice(recipient_public)
    #If(test) { JVKW_HKDF_COUNT.with((slot) -> slot.set(slot.get() + 1)) }
    kek :: Zeroizing(hkdf32(shared.0, salt, key_info) ?? return Err(JetVaultKeyWrapError.OpenFailed))
    #If(test) { JVKW_HKDF_COUNT.with((slot) -> slot.set(slot.get() + 1)) }
    nonce :: Zeroizing(hkdf24(shared.0, salt, nonce_info) ?? return Err(JetVaultKeyWrapError.OpenFailed))
    aad := "JVKW1 recipient aad".into_bytes(); &aad.extend_from_slice(bytes[..<stanzas_at]); &aad.extend_from_slice(recipient_public)
    #If(test) { JVKW_AEAD_COUNT.with((slot) -> slot.set(slot.get() + 1)) }
    cipher :: XChaCha20Poly1305.new_from_slice(kek.0) ?? return Err(JetVaultKeyWrapError.OpenFailed)
    opened := Zeroizing(cipher.decrypt(XNonce.from_slice(nonce.0), Payload{msg: bytes[stanza_at + 32..<stanza_at + 80], aad: aad}) ?? return Err(JetVaultKeyWrapError.OpenFailed))
    if match_index == None -> return Err(JetVaultKeyWrapError.OpenFailed)
    backup :: opened.0.as_slice().try_into() ?? return Err(JetVaultKeyWrapError.OpenFailed)
    zeroize(&opened.0)
    Zeroizing(backup)
}
// Rust: crates/jet-pkg-model/src/Prelude/VaultKeyWrap.rs:425
fn jvkw_open<T: JetVaultKey>(wrapped: JetWrappedVaultKey, unlock: JetVaultKeyUnlock, cancelled: fn() -> Bool, cancel_outcome: fn() -> (), wait_enter: fn() -> (), wait_leave: fn() -> ()) -> (JvkwParsed, Zeroizing<[U8]>, [U8; 32]) JetVaultKeyWrapError! {
    parsed :: jvkw_parse(wrapped.bytes) ?? return Err(err)
    backup_key :: if (parsed.mode, unlock) == {
        (.Recipient, .Recipient(identity)) -> jvkw_open_recipient(parsed, wrapped.bytes, identity) ?? return Err(err)
        (.Passphrase, .Passphrase(passphrase)) -> {
            salt :: if parsed.mode_header == .Passphrase(value) { value } else { return Err(JetVaultKeyWrapError.OpenFailed) }
            #If(test) { JVKW_PASSPHRASE_OPEN_COUNT.with((slot) -> slot.set(slot.get() + 1)) }
            jvkw_argon(passphrase, salt, cancelled, cancel_outcome, wait_enter, wait_leave) ?? {
                if err == .WeakPassphrase || err == .ResourceUnavailable -> return Err(err)
                return Err(JetVaultKeyWrapError.OpenFailed)
            }
        }
        else -> return Err(JetVaultKeyWrapError.OpenFailed)
    }
    aad := "JVKW1 payload".into_bytes(); &aad.extend_from_slice(wrapped.bytes[..<parsed.header_end])
    cipher :: XChaCha20Poly1305.new_from_slice(backup_key.0) ?? return Err(JetVaultKeyWrapError.OpenFailed)
    plaintext :: Zeroizing(cipher.decrypt(XNonce.from_slice(parsed.payload_nonce), Payload{msg: wrapped.bytes[parsed.header_end..], aad: aad}) ?? return Err(JetVaultKeyWrapError.OpenFailed))
    if plaintext.0.len() != 64 || parsed.key_type != T.TAG -> return Err(JetVaultKeyWrapError.OpenFailed)
    public :: plaintext.0[32..].try_into() ?? return Err(JetVaultKeyWrapError.OpenFailed)
    key :: Zeroizing(~plaintext.0[..<32])
    typed :: T.from_bytes(~key.0) ?? return Err(JetVaultKeyWrapError.OpenFailed)
    derived :: typed.public_bytes()
    if derived.len() != 32 || !Bool.from(derived.ct_eq(public)) -> return Err(JetVaultKeyWrapError.OpenFailed)
    (^parsed, ^key, public)
}
// Rust: crates/jet-pkg-model/src/Prelude/VaultKeyWrap.rs:450
pub struct JetVaultWrappedImportPlan<T> {
    name: String, key: Zeroizing<[U8]>, origin: JetVaultOrigin, mode: JetVaultKeyWrapMode, public_key_hash: [U8; 32], key_digest: [U8; 32], repo_uuid: [U8; 16], start_revision: U64, start_hash: [U8; 32], provider_hash: [U8; 32], start_kind: VaultStartKind, operation_hash: [U8; 32], existing: JetVaultKeyRef<T>?, destination_opaque_id: [U8; 16], transition_from: U64, transition_to: U64, issued: Instant, deadline: Instant, expires_unix_ms: U64
}
impl<T> JetVaultWrappedImportPlan<T> {
    // Rust: crates/jet-pkg-model/src/Prelude/VaultKeyWrap.rs:472
    fn debug(self) -> String { "WrappedImportPlan(<redacted>)" }
}
// Rust: crates/jet-pkg-model/src/Prelude/VaultKeyWrap.rs:475
pub fn jet_vault_prepare_import_wrapped_at<T: JetVaultKey>(root: OSPath, name: String, wrapped: ^JetWrappedVaultKey, unlock: JetVaultKeyUnlock) -> JetVaultWrappedImportPlan<T> JetVaultKeyWrapError! { jet_vault_prepare_import_wrapped_at_with_cancel<T>(root, name, ^wrapped, unlock, jet_crypto_never_cancelled, jet_crypto_ignore_cancel, jet_pwhash_wait_noop, jet_pwhash_wait_noop) }
// Rust: crates/jet-pkg-model/src/Prelude/VaultKeyWrap.rs:485
fn jvkw_provider_preflight(root: OSPath) -> () JetVaultKeyWrapError! {
    if sys.target.selected_os() == "linux" && sys.target.selected_env() == "gnu" && sys.target.selected_pointer_width() == 64 && (sys.target.selected_arch() == "x86_64" || sys.target.selected_arch() == "aarch64") {
        drop(vault_linux_dir(root) ?? return Err(JetVaultKeyWrapError.Vault(err)))
        return Ok()
    }
    Err(JetVaultKeyWrapError.Vault(JetVaultError.UnsupportedProvider))
}
// Rust: crates/jet-pkg-model/src/Prelude/VaultKeyWrap.rs:490
fn jet_vault_prepare_import_wrapped_at_with_cancel<T: JetVaultKey>(root: OSPath, name: String, wrapped: ^JetWrappedVaultKey, unlock: JetVaultKeyUnlock, cancelled: fn() -> Bool, cancel_outcome: fn() -> (), wait_enter: fn() -> (), wait_leave: fn() -> ()) -> JetVaultWrappedImportPlan<T> JetVaultKeyWrapError! {
    jvkw_provider_preflight(root) ?? return Err(err)
    jet_vault_validate_name(name) ?? return Err(JetVaultKeyWrapError.Vault(err))
    wrapped_hash :: vault_hash(["JVKW1 wrapped bytes".as_bytes(), wrapped.bytes])
    (parsed, key, public) :: jvkw_open<T>(wrapped, unlock, cancelled, cancel_outcome, wait_enter, wait_leave) ?? return Err(err)
    public_key_hash :: vault_hash(["JVLT2 public key".as_bytes(), [U8]{T.TAG}, public])
    key_digest :: vault_key_digest(T.TAG, key.0)
    (store, start_hash, provider_hash, start_kind) := vault_read_at(root) ?? return Err(JetVaultKeyWrapError.Vault(err))
    if start_kind != .V2 {
        provisional :: jvkw_random<16>() ?? return Err(err)
        if provisional.0 == [U8; 16].filled(0) -> return Err(JetVaultKeyWrapError.Internal{incident_id: "jvkw-zero-uuid"})
        store.repo_uuid = provisional.0
    }
    if store.keys.iter().any((record) -> record.name == name && record.key_type != T.TAG) -> return Err(JetVaultKeyWrapError.Vault(JetVaultError.WrongType))
    same_origin :: if store.repo_uuid == parsed.origin.repo_uuid {
        store.keys.iter().find((record) -> record.name == parsed.origin.name && record.generation == parsed.origin.generation && record.opaque_id == parsed.origin.opaque_id && record.record_hash == parsed.origin.record_hash)
    } else { None }
    existing :: if same_origin == .Val(record) {
        if record.key_type != T.TAG || record.public_key_hash != public_key_hash || vault_key_digest(T.TAG, record.key) != key_digest -> return Err(JetVaultKeyWrapError.OpenFailed)
        if record.status == .Revoked -> return Err(JetVaultKeyWrapError.Vault(JetVaultError.Revoked))
        Val(vault_ref(store, record))
    } else { None }
    transition_from :: store.keys.iter().find((record) -> record.name == name && record.key_type == T.TAG && record.status == .Active).map((record) -> record.generation) ?? 0
    transition_to :: if existing != None { transition_from } else { (store.keys.iter().filter((record) -> record.name == name && record.key_type == T.TAG).map((record) -> record.generation).max() ?? U64{0}).checked_add(1) ?? return Err(JetVaultKeyWrapError.Internal{incident_id: "jvkw-generation"}) }
    destination_opaque_id :: if existing != None { [U8; 16].filled(0) } else {
        value :: jvkw_random<16>() ?? return Err(err)
        if value.0 == [U8; 16].filled(0) -> return Err(JetVaultKeyWrapError.Internal{incident_id: "jvkw-zero-id"})
        value.0
    }
    operation := "JVKW1 import operation".into_bytes()
    &operation.extend_from_slice(store.repo_uuid); &operation.extend_from_slice(store.revision.to_le_bytes()); &operation.extend_from_slice(start_hash); &operation.extend_from_slice(provider_hash)
    &operation.push(T.TAG); jvkw_push_u16(&operation, name.len()) ?? return Err(err); &operation.extend_from_slice(name.as_bytes())
    &operation.extend_from_slice(parsed.origin.repo_uuid); jvkw_push_u16(&operation, parsed.origin.name.len()) ?? return Err(err); &operation.extend_from_slice(parsed.origin.name.as_bytes())
    &operation.extend_from_slice(parsed.origin.generation.to_le_bytes()); &operation.extend_from_slice(parsed.origin.opaque_id); &operation.extend_from_slice(parsed.origin.record_hash)
    &operation.extend_from_slice(public_key_hash); &operation.extend_from_slice(key_digest); &operation.extend_from_slice(wrapped_hash); &operation.extend_from_slice(destination_opaque_id)
    &operation.extend_from_slice(transition_from.to_le_bytes()); &operation.extend_from_slice(transition_to.to_le_bytes())
    operation_hash :: vault_hash([operation])
    issued :: Instant.now()
    deadline :: issued.checked_add(Duration.from_secs(300)) ?? return Err(JetVaultKeyWrapError.Internal{incident_id: "jvkw-deadline"})
    expires_unix_ms :: (jvkw_now_ms() ?? return Err(err)).checked_add(300_000) ?? return Err(JetVaultKeyWrapError.Internal{incident_id: "jvkw-deadline"})
    JetVaultWrappedImportPlan{name: ~name, key: ^key, origin: ^parsed.origin, mode: parsed.mode, public_key_hash: public_key_hash, key_digest: key_digest, repo_uuid: store.repo_uuid, start_revision: store.revision, start_hash: start_hash, provider_hash: provider_hash, start_kind: start_kind, operation_hash: operation_hash, existing: ^existing, destination_opaque_id: destination_opaque_id, transition_from: transition_from, transition_to: transition_to, issued: issued, deadline: deadline, expires_unix_ms: expires_unix_ms}
}
// Rust: crates/jet-pkg-model/src/Prelude/VaultKeyWrap.rs:534
pub fn jet_vault_authorize_wrapped_import_impl<T: JetVaultKey>(plan: JetVaultWrappedImportPlan<T>, reason: String) -> JetVaultWrite<T> JetVaultKeyWrapError! {
    vault_validate_reason(reason) ?? return Err(JetVaultKeyWrapError.Vault(err))
    now :: Instant.now()
    if now > plan.deadline || now.duration_since(plan.issued) > Duration.from_secs(300) -> return Err(JetVaultKeyWrapError.Vault(JetVaultError.Conflict))
    bytes := "JVKW1 authority preview".into_bytes()
    &bytes.extend_from_slice(plan.operation_hash); &bytes.push(T.TAG); &bytes.extend_from_slice(plan.repo_uuid); &bytes.extend_from_slice(plan.start_revision.to_le_bytes())
    jvkw_push_u16(&bytes, plan.name.len()) ?? return Err(err); &bytes.extend_from_slice(plan.name.as_bytes()); &bytes.extend_from_slice(plan.origin.repo_uuid)
    jvkw_push_u16(&bytes, plan.origin.name.len()) ?? return Err(err); &bytes.extend_from_slice(plan.origin.name.as_bytes()); &bytes.extend_from_slice(plan.origin.generation.to_le_bytes())
    &bytes.extend_from_slice(plan.transition_from.to_le_bytes()); &bytes.extend_from_slice(plan.transition_to.to_le_bytes()); jvkw_push_u16(&bytes, reason.len()) ?? return Err(err)
    &bytes.extend_from_slice(reason.as_bytes()); &bytes.extend_from_slice(plan.expires_unix_ms.to_le_bytes())
    preview_hash :: vault_hash([bytes])
    preview :: "import wrapped {T.NAME} {plan.origin.name} as {plan.name} from repository {vault_uuid_hex(plan.origin.repo_uuid)} generation {plan.origin.generation} into repository {vault_uuid_hex(plan.repo_uuid)} at revision {plan.start_revision}; bearer backup cannot be recalled by later source revocation; reason: {reason}; expires_unix_ms: {plan.expires_unix_ms}"
    if !vault_native_authorize(preview, plan.repo_uuid) -> return Err(JetVaultKeyWrapError.Vault(JetVaultError.AuthorityDenied))
    (user, session) :: vault_authority_identity() ?? return Err(JetVaultKeyWrapError.Vault(err))
    JetVaultWrite{operation_hash: plan.operation_hash, preview_hash: preview_hash, user: user, session: session, deadline: plan.deadline, marker: PhantomData<T>{}}
}
// Rust: crates/jet-pkg-model/src/Prelude/VaultKeyWrap.rs:546
pub fn jet_vault_commit_import_wrapped_at<T: JetVaultKey>(root: OSPath, write: ^JetVaultWrite<T>, plan: ^JetVaultWrappedImportPlan<T>) -> JetVaultKeyRef<T> JetVaultKeyWrapError! {
    now :: Instant.now()
    (user, session) :: vault_authority_identity() ?? return Err(JetVaultKeyWrapError.Vault(err))
    if now > plan.deadline || now.duration_since(plan.issued) > Duration.from_secs(300) || now > write.deadline || write.operation_hash != plan.operation_hash || write.preview_hash == [U8; 32].filled(0) || write.user != user || write.session != session -> return Err(JetVaultKeyWrapError.Vault(JetVaultError.Conflict))
    lock :: vault_acquire_lock(root, plan.repo_uuid, plan.start_revision, plan.start_hash) ?? return Err(JetVaultKeyWrapError.Vault(err))
    (store, current_hash, provider_hash, start_kind) := vault_read_at(root) ?? return Err(JetVaultKeyWrapError.Vault(err))
    if current_hash != plan.start_hash || provider_hash != plan.provider_hash || start_kind != plan.start_kind || (start_kind == .V2 && (store.repo_uuid != plan.repo_uuid || store.revision != plan.start_revision)) -> return Err(JetVaultKeyWrapError.Vault(JetVaultError.Conflict))
    if start_kind != .V2 -> store.repo_uuid = plan.repo_uuid
    if &plan.existing.take() == .Val(existing) {
        record :: vault_find(store, existing) ?? return Err(JetVaultKeyWrapError.Vault(err))
        if record.status == .Revoked -> return Err(JetVaultKeyWrapError.Vault(JetVaultError.Revoked))
        if record.public_key_hash != plan.public_key_hash || vault_key_digest(T.TAG, record.key) != plan.key_digest -> return Err(JetVaultKeyWrapError.OpenFailed)
        mode :: if plan.mode == .Recipient { "recipient" } else { "passphrase" }
        vault_audit_append_at(root, "import", mode, "AlreadyPresent", T.TAG, plan.origin, Val(plan.name)) ?? return Err(JetVaultKeyWrapError.Vault(err))
        drop(lock)
        return existing
    }
    if store.keys.iter().any((record) -> record.name == plan.name && record.key_type != T.TAG) -> return Err(JetVaultKeyWrapError.Vault(JetVaultError.WrongType))
    generation :: (store.keys.iter().filter((record) -> record.name == plan.name && record.key_type == T.TAG).map((record) -> record.generation).max() ?? U64{0}).checked_add(1) ?? return Err(JetVaultKeyWrapError.Internal{incident_id: "jvkw-generation"})
    if generation != plan.transition_to -> return Err(JetVaultKeyWrapError.Vault(JetVaultError.Conflict))
    unix_ms :: vault_lifecycle_unix_ms(store) ?? return Err(JetVaultKeyWrapError.Vault(err))
    loop record in &store.keys {
        if record.name == plan.name && record.key_type == T.TAG && record.status == .Active {
            record.status = .Retired; record.status_unix_ms = unix_ms
            record.reason_hash = vault_reason_hash(.Retired, "wrapped import") ?? return Err(JetVaultKeyWrapError.Vault(err))
        }
    }
    key :: T.from_bytes(&plan.key.0.take()) ?? return Err(JetVaultKeyWrapError.OpenFailed)
    key_bytes :: key.into_bytes()
    if vault_key_digest(T.TAG, key_bytes) != plan.key_digest -> return Err(JetVaultKeyWrapError.OpenFailed)
    record := JetVaultRecord{name: ~plan.name, key_type: T.TAG, generation: generation, status: .Active, provenance: .Imported, opaque_id: plan.destination_opaque_id, created_unix_ms: unix_ms, status_unix_ms: unix_ms, record_hash: [U8; 32].filled(0), public_key_hash: plan.public_key_hash, reason_hash: [U8; 32].filled(0), origin: Val(~plan.origin), key: ^key_bytes}
    record.record_hash = vault_record_hash(record)
    reference :: vault_ref(store, record)
    &store.keys.push(^record)
    store.revision = store.revision.checked_add(1) ?? return Err(JetVaultKeyWrapError.Internal{incident_id: "jvkw-revision"})
    vault_write_at(root, store, plan.start_hash, plan.provider_hash, plan.start_kind, plan.start_revision, ^lock) ?? return Err(JetVaultKeyWrapError.Vault(err))
    reference
}
