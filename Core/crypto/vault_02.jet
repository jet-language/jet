        if name == ".secrets.age.lock" && vault_test_fault("substitute-lock-after-check") {
            vault_linux_rename(dirfd, name, ".secrets.age.lock.acquired", VAULT_RENAME_NOREPLACE) ?? return Err(err)
            replacement :: vault_linux_openat(dirfd, name, 1 | VAULT_O_CREAT | VAULT_O_EXCL, 0o600) ?? return Err(JetVaultError.Conflict)
            replacement.write_all("replacement".as_bytes()) ?? return Err(JetVaultError.Conflict)
            replacement.sync_all() ?? return Err(JetVaultError.Conflict)
        }
    }
    vault_linux_rename(dirfd, name, quarantine, VAULT_RENAME_NOREPLACE) ?? return Err(err)
    moved :: vault_linux_openat(dirfd, quarantine, 0, 0) ?? return Err(JetVaultError.Conflict)
    if vault_same_inode(moved, held) -> return true
    _ :: vault_linux_rename(dirfd, quarantine, name, VAULT_RENAME_NOREPLACE)
    false
}
