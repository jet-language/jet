            .Cancelled -> { cancel_outcome(); return Err(JetVaultKeyWrapError.Internal{incident_id: "cancel-returned"}) }
            .ResourceUnavailable -> return Err(JetVaultKeyWrapError.ResourceUnavailable)
            .Backend -> return Err(JetVaultKeyWrapError.Internal{incident_id: "jvkw-argon-backend"})
        }
    }
    key := Zeroizing([U8; 32].filled(0)); &key.0.copy_from_slice(output.0)
