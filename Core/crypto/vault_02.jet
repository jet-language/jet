        if code == Val(38) || code == Val(22) -> return Err(JetVaultError.UnsupportedProvider)
        code == Val(3)
    }
    if !dead -> return Err(JetVaultError.Conflict)
    current_matches :: vault_read_contents_unrecovered_at(root).is_ok_and((tuple) -> tuple.0.revision == expected_revision && tuple.1 == expected_hash)
    backup_matches :: (vault_linux_read(root, ".secrets.age.backup") ?? return Err(err)).and_then((bytes) -> vault_decode_ciphertext_at(root, bytes).ok()).is_some_and((tuple) -> tuple.0.revision == expected_revision && tuple.1 == expected_hash)
    if !current_matches && !backup_matches -> return Err(JetVaultError.Conflict)
