fn vault_acquire_lock_mode(root: OSPath, repo_uuid: [U8; 16], revision: U64, start_hash: [U8; 32], recover_stale: Bool) -> VaultLockGuard JetVaultError! {
    dir :: vault_linux_dir(root) ?? return Err(err)
    dirfd :: dir.as_raw_fd()
    file :: vault_linux_openat(dirfd, ".secrets.age.lock", 1 | VAULT_O_CREAT | VAULT_O_EXCL, 0o600) ?? {
        code :: err.raw_os_error()
