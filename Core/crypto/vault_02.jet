    &operation.extend_from_slice(start_hash); &operation.extend_from_slice(provider_hash)
    &operation.push(action.byte()); &operation.push(T.TAG)
    push_u16(&operation, name.len()) ?? return Err(err); &operation.extend_from_slice(name.as_bytes())
    &operation.push(reference_present); &operation.extend_from_slice(reference_repo); &operation.extend_from_slice(reference_generation.to_le_bytes())
    &operation.extend_from_slice(reference_opaque); &operation.extend_from_slice(reference_hash)
    push_u16(&operation, reason.len()) ?? return Err(err); &operation.extend_from_slice(reason.as_bytes())
