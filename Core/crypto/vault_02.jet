pub fn jet_vault_authorize_write_impl<T: JetVaultKey>(plan: JetVaultMutationPlan<T>, reason: String) -> JetVaultWrite<T> JetVaultError! {
    vault_validate_reason(reason) ?? return Err(err)
    now :: Instant.now()
    if now > plan.deadline || now.duration_since(plan.issued) > Duration.from_secs(300) -> return Err(JetVaultError.Conflict)
    bytes := "JVLT2 authority preview".into_bytes()
    &bytes.extend_from_slice(plan.operation_hash); &bytes.push(plan.action.byte()); &bytes.push(T.TAG)
    &bytes.extend_from_slice(plan.repo_uuid); &bytes.extend_from_slice(plan.start_revision.to_le_bytes())
    push_u16(&bytes, plan.name.len()) ?? return Err(err); &bytes.extend_from_slice(plan.name.as_bytes())
    &bytes.extend_from_slice(plan.transition_from.to_le_bytes()); &bytes.extend_from_slice(plan.transition_to.to_le_bytes())
    push_u16(&bytes, plan.reason.len()) ?? return Err(err); &bytes.extend_from_slice(plan.reason.as_bytes())
    push_u16(&bytes, reason.len()) ?? return Err(err); &bytes.extend_from_slice(reason.as_bytes()); &bytes.extend_from_slice(plan.expires_unix_ms.to_le_bytes())
    preview_hash :: vault_hash([bytes])
    plan_reason :: if plan.reason.is_empty() { "<none>" } else { plan.reason }
    preview :: "{plan.action.text()} {T.NAME} {plan.name} {plan.transition_from} -> {plan.transition_to} in repository {vault_uuid_hex(plan.repo_uuid)} at revision {plan.start_revision}; reason: {plan_reason}; authority reason: {reason}; expires_unix_ms: {plan.expires_unix_ms}"
    if !vault_native_authorize(preview, plan.repo_uuid) -> return Err(JetVaultError.AuthorityDenied)
    (user, session) :: vault_authority_identity() ?? return Err(err)
    JetVaultWrite{operation_hash: plan.operation_hash, preview_hash: preview_hash, user: user, session: session, deadline: plan.deadline, marker: PhantomData<T>{}}
}
