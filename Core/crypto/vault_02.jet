    if nonce_bytes == [U8; 16].filled(0) -> return Err(JetVaultError.Internal{incident_id: "vault-zero-lock-nonce"})
    nonce :: hex_bytes(nonce_bytes)
    process_start :: vault_process_start(process.id()) ?? return Err(JetVaultError.UnsupportedProvider)
    file.write_fmt("repo={vault_uuid_hex(repo_uuid)} revision={revision} pid={process.id()} process-start={process_start} nonce={nonce} hash={hex_bytes(start_hash)}\n") ?? return Err(JetVaultError.IO{operation: "lock", redacted_path: "<vault-lock>"})
    file.sync_all() ?? return Err(JetVaultError.IO{operation: "lock", redacted_path: "<vault-lock>"})
    VaultLockGuard{dir: ^dir, file: ^file, nonce: ^nonce}
}
