    opaque_id :: jvkw_array<16>(bytes, &at) ?? return Err(err)
    record_hash :: jvkw_array<32>(bytes, &at) ?? return Err(err)
    _created_unix_ms :: jvkw_u64(bytes, &at) ?? return Err(err)
    export_id :: jvkw_array<16>(bytes, &at) ?? return Err(err)
    payload_nonce :: jvkw_array<24>(bytes, &at) ?? return Err(err)
    if repo_uuid == [U8; 16].filled(0) || generation == 0 || opaque_id == [U8; 16].filled(0) || record_hash == [U8; 32].filled(0) || export_id == [U8; 16].filled(0) -> return Err(JetVaultKeyWrapError.InvalidEncoding)
