    state := U32{2499746518}
    loop i in 0..<32 {
        random_key := [U8]{}
        data := [U8]{}
        loop j in 0..<(32 + sizes[i %% sizes.len()]) {
            state = state.bit_xor((state << 13))
            state = state.bit_xor((state >> 17))
            state = state.bit_xor((state << 5))
            if j < 32 -> &random_key.push(U8{state.bit_and(U32{255})})
            else -> &data.push(U8{state.bit_and(U32{255})})
        }
        assert(poly1305(random_key, data) == random_tags[i])
    }
}
