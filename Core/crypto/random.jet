use core as core
use core.crypto.[CryptoError]
use core.crypto as crypto
use core.encoding as random_encoding

// core.crypto.random - fail-closed CSPRNG.
//
// `bytes(n)` is one OS request, capped at 1,048,576 bytes. There is no
// fallback generator. A missing or rejected provider is `CryptoError.Unavailable`.
//
// This is not `core.math.random`. Math RNG is deterministic and seedable.
// Crypto RNG is neither. The kernel is `host_csprng`; bounds checks are Jet.
/// `n` random bytes from the OS CSPRNG. `n` must be 0..=1048576.
pub fn bytes(n: Int) -[Rand]> [U8] CryptoError! {
    if n < 0 || n > 1048576 -> return Err(.Length)
    if n == 0 -> return Ok([U8]{})
    out :: host_csprng(n) ?? return Err(.Unavailable)
    if out.len() != n -> return Err(.Unavailable)
    Ok(out)
}

fn host_csprng(n: Int) -[Rand]> [U8] CryptoError! {
    core.crypto.random.bytes(n) ?? return Err(.Unavailable)
}
 

pub fn u32() -[Rand]> U32 CryptoError! {
    b :: bytes(4) ?? return Err(.Unavailable)
    n := 0
    loop x in b {
        n = n * 256 + Int.from_u8(x)
    }
    Ok(U32{n})
}

pub fn u64() -[Rand]> U64 CryptoError! {
    b :: bytes(8) ?? return Err(.Unavailable)
    n := 0
    loop x in b {
        n = n * 256 + Int.from_u8(x)
    }
    Ok(U64{n})
}

pub fn int_range(lo: Int, hi: Int) -[Rand]> Int CryptoError! {
    if hi <= lo -> return Err(.Length)
    span :: hi - lo
    // A single 64-bit draw is the largest bounded source this API can
    // represent without manufacturing entropy. Reject the incomplete tail
    // instead of reducing it modulo `span` (which biases most ranges).
    if span > 18446744073709551616 -> return Err(.Length)
    limit :: 18446744073709551616 - (18446744073709551616 %% span)
    // A hostile or wedged provider must not turn rejection sampling into an
    // unbounded wait. 128 draws leaves a negligible false-rejection chance
    // for the accepted range sizes while preserving fail-closed behavior.
    attempts := 0
    loop {
        if attempts >= 128 -> return Err(.Unavailable)
        attempts += 1
        n :: random_word64() ?? return Err(.Unavailable)
        if n < limit -> return Ok(lo + (n %% span))
    }
}

fn random_word64() -[Rand]> Int CryptoError! {
    b :: bytes(8) ?? return Err(.Unavailable)
    n := 0
    loop x in b -> n = n * 256 + Int.from_u8(x)
    n
}

// Lowercase hex through the canonical core.encoding law over the drawn bytes.
pub fn token_hex(n: Int) -[Rand]> String CryptoError! {
    b :: bytes(n)
    view :: b[0..<b.len()]
    Ok(random_encoding.bytes_to_hex(view))
}

pub fn token_urlsafe(n: Int) -[Rand]> String CryptoError! {
    b :: bytes(n)
    alphabet :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    raw :: alphabet.bytes()
    out := [U8]{}
    i := 0
    loop i + 3 <= b.len() {
        v :: (Int.from_u8(b[i]) << 16) | (Int.from_u8(b[i + 1]) << 8) | Int.from_u8(b[i + 2])
        &out.push(raw[(v >> 18) & 63])
        &out.push(raw[(v >> 12) & 63])
        &out.push(raw[(v >> 6) & 63])
        &out.push(raw[v & 63])
        i += 3
    }
    rest :: b.len() - i
    if rest == 1 {
        v :: Int.from_u8(b[i]) << 16
        &out.push(raw[(v >> 18) & 63])
        &out.push(raw[(v >> 12) & 63])
    }
    if rest == 2 {
        v :: (Int.from_u8(b[i]) << 16) | (Int.from_u8(b[i + 1]) << 8)
        &out.push(raw[(v >> 18) & 63])
        &out.push(raw[(v >> 12) & 63])
        &out.push(raw[(v >> 6) & 63])
    }
    text :: String.from_bytes(out) ?? panic("invalid URL-safe token encoding")
    Ok(text)
}

pub fn choice(items: [String]) -[Rand]> String CryptoError! {
    if items.len() == 0 -> return Err(.Length)
    i :: int_range(0, items.len()) ?? return Err(.Unavailable)
    Ok(items[i])
}


pub fn token_bytes(n: Int) -[Rand]> [U8] CryptoError! { bytes(n) }

pub fn randbelow(n: Int) -[Rand]> Int CryptoError! {
    if n <= 0 -> return Err(.Length)
    int_range(0, n)
}

pub fn randbits(k: Int) -[Rand]> Int CryptoError! {
    if k < 0 || k > 8388608 -> return Err(.Length)
    if k == 0 -> return Ok(0)
    width :: (k + 7) /% 8
    b := bytes(width) ?? return Err(.Unavailable)
    excess :: width * 8 - k
    if excess > 0 -> b[0] = U8{Int.from_u8(b[0]) & (255 >> excess)}
    out := 0
    loop x in b -> out = (out << 8) | Int.from_u8(x)
    Ok(out)
}
 


pub fn compare_digest(a: [U8], b: [U8]) -> Bool Never! {
    crypto.constant_time_equal_bytes(a, b)
}

pub fn choice_int(items: [Int]) -[Rand]> Int CryptoError! {
    if items.len() == 0 -> return Err(.Length)
    i :: int_range(0, items.len()) ?? return Err(.Unavailable)
    Ok(items[i])
}

pub fn shuffle_ints(items: [Int]) -[Rand]> [Int] CryptoError! {
    out := [Int]{}
    loop x in items -> &out.push(x)
    i := out.len()
    loop i > 1 {
        i = i - 1
        j :: int_range(0, i + 1) ?? return Err(.Unavailable)
        a := out[i]
        b := out[j]
        tmp := [Int]{}
        k := 0
        loop k < out.len() {
            if {
                k == i -> { &tmp.push(b) }
                k == j -> { &tmp.push(a) }
                else -> { &tmp.push(out[k]) }
            }
            k = k + 1
        }
        out = tmp
    }
    Ok(out)
}
