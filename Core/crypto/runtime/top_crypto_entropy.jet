// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/CryptoEntropy.rs:184
fn jet_crypto_entropy_fill_loop(out: &[U8], provider: fn(&[U8]) -> JetCryptoEntropyStep) -> () JetCryptoError! {
    filled := USize{0}
    while filled < out.len() {
        when provider(&out[filled..]) {
            .Filled(n) if n > 0 && n <= out.len() - filled -> { filled += n }
            .Interrupted -> jet_crypto_entropy_zeroize(&out[filled..])
            .Filled(_) | .Failed -> {
                jet_crypto_entropy_zeroize(out)
                return Err(JetCryptoError.EntropyUnavailable)
            }
        }
    }
    Ok(())
}
