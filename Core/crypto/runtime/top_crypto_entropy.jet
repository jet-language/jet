}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/CryptoEntropy.rs:413
pub fn jet_crypto_entropy_bytes(count: I64) -> [U8] JetCryptoError! {
    if count < 0 -> return Err(JetCryptoError.InvalidLength(operation: "core.crypto.random.bytes", parameter: "count", expected: "non-negative", actual: count.unsigned_abs() as USize))
    if count > 1048576 -> return Err(JetCryptoError.OutputLength(operation: "core.crypto.random.bytes", minimum: 0, maximum: 1048576, actual: count))
    if count == 0 -> return Ok([])
    if target.selected_os() == "wasi" && target.selected_arch() == "wasm32" && (target.selected_env() == "p1" || target.selected_env() == "p2") {
        return jet_crypto_entropy_wasi_with(count as USize, fn(out) {
            match jet_crypto_entropy_wasi_attempt(out) { Ok(_) -> U16{0}; Err(errno) -> errno }
        })
    }
    out := [U8].filled(count as USize, 0)
    jet_crypto_entropy_fill_platform(&out)?
    Ok(^out)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/CryptoEntropy.rs:445
pub fn jet_crypto_entropy_fill(out: &[U8]) -> () JetCryptoError! {
    fresh := match jet_crypto_entropy_bytes(out.len() as I64) {
        Ok(bytes) -> ^bytes
        Err(error) -> { jet_crypto_entropy_zeroize(out); return Err(^error) }
    }
    out.copy_from_slice(&fresh)
    jet_crypto_entropy_zeroize(&fresh)
    Ok(())
}
