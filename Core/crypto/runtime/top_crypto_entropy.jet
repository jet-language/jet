// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/CryptoEntropy.rs:398
fn jet_crypto_entropy_fill_platform(out: &[U8]) -> () JetCryptoError! {
    #If(test) {
        // GATE #4565: kernel primitive
        scripted :: #Unsafe("test thread borrows its optional scripted provider") {
            JET_CRYPTO_ENTROPY_TEST_PROVIDER.with(fn(slot) {
                loan := slot.borrow_mut()
                loan.as_mut().map(fn(provider) { jet_crypto_entropy_fill_loop(out, provider) })
