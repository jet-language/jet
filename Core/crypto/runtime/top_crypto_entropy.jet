//RS 
//RS // D-CRYPTO-RNG1=A: the core.crypto.random.bytes shim lives beside its entropy
//RS // provider. It previously sat in Top/Process.rs, which only emits for
//RS // core.process, so a crypto-only program called a symbol that was absent.
//RS 
//RS // D-CRYPTO-RNG1=A: cryptographic bytes use the shared fail-closed OS provider.
//RS // Edition 2026 keeps this infallible Rust shim; failure takes the registered
//RS // E3001 path and never returns weak or partial bytes.
//RS pub(crate) fn jet_crypto_entropy_fail_closed(
//RS     operation: &str,
//RS     error: JetCryptoEntropyError,
//RS ) -> ! {
//RS     // D-FAIL-EXIT1: crypto has no private edge rule. An infallible crypto
//RS     // shim reports the ordinary E3001 program fault, and the execution tier's
//RS     // boundary owns the registered row, the rendering, delivery and cleanup.
//RS     //
//RS     // I2 — why the report is NOT built here: this file is embedded verbatim by
//RS     // four independent projections (the AOT kernel closure in
//RS     // Codegen/mod.rs, the Cranelift host in jet-jit/src/Crypto.rs, the
//RS     // comptime hosts in jet-comptime/src/Comptime, and the standalone
//RS     // `jet_ffi_*` bridge crate in jet-pkg-model/src/FFI.rs). Those projections
//RS     // do not all carry Foundation's registered-row adapter
//RS     // `jet_render_runtime_stop`: the bridge strips it with the rest of the host
//RS     // wrapper boundary and, unlike
//RS     // `push_embedded_outcome`, never appends a replacement. Rendering here
//RS     // therefore emitted a call whose definition lived in another projection's
//RS     // guard — rustc E0425 inside a crate Jet itself generated, surfaced to the
//RS     // user as E0705 against their `extern rust` line.
//RS     //
//RS     // So the fault leaves this file as the shared foreign-boundary stop
//RS     // message that `jet_runtime_boundary` (Prelude/Core.rs) already converts
//RS     // into the one registered E3001 report — the same protocol the generated
//RS     // bridge's own `ffi_panic` uses. This file now names no Prelude or
//RS     // Foundation symbol at all, so no projection can strip a definition out
//RS     // from under it.
//RS     std::panic::panic_any(format!("__jet_ffi_runtime__: {operation}: {error}"))
//RS }
//RS 
//RS /// D-SHAPE-RESOURCE1=A: the one vetted wipe behind `core.crypto.__zeroize`.
//RS /// Each secret-bearing Core type's `Close` hands its owned bytes here, so the
//RS /// zeroing is volatile and fenced and cannot be elided before the buffer is
//RS /// freed.
//RS pub fn jet_crypto_zeroize(mut bytes: Vec<u8>) {
//RS     jet_crypto_entropy_zeroize(&mut bytes);
//RS }
//RS 
//RS fn jet_crypto_uuid_format(bytes: &[u8; 16]) -> String {
//RS     format!(
//RS         "{:02x}{:02x}{:02x}{:02x}-{:02x}{:02x}-{:02x}{:02x}-{:02x}{:02x}-{:02x}{:02x}{:02x}{:02x}{:02x}{:02x}",
//RS         bytes[0],
//RS         bytes[1],
//RS         bytes[2],
//RS         bytes[3],
//RS         bytes[4],
//RS         bytes[5],
//RS         bytes[6],
//RS         bytes[7],
//RS         bytes[8],
//RS         bytes[9],
//RS         bytes[10],
//RS         bytes[11],
//RS         bytes[12],
//RS         bytes[13],
//RS         bytes[14],
