// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/CryptoEntropy.rs:7
#Error
#Clone
#Debug
#Eq
pub enum JetCryptoError {
    InvalidLength(operation: String, parameter: String, expected: String, actual: USize)
    InvalidEncoding(operation: String, value_kind: String)
    UnsupportedVersion(operation: String, version: U32)
    UnsupportedAlgorithm(operation: String, algorithm: String)
    OpenFailed
    NonContributoryKey
    OutputLength(operation: String, minimum: USize, maximum: USize, actual: I64)
    PasswordPolicy(reason: String)
    EntropyUnavailable
    ResourceUnavailable(resource: String)
    Internal(incident_id: String)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/CryptoEntropy.rs:23
impl Display for JetCryptoError {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/CryptoEntropy.rs:24
    fn fmt(self: &JetCryptoError, f: &Formatter) -> () core.fmt.Error! {
        text :: when self {
            .InvalidLength(operation, parameter, expected, actual) -> "{operation}: {parameter} must be {expected}; got {actual}"
            .InvalidEncoding(operation, value_kind) -> "{operation}: {value_kind} is not canonical"
            .UnsupportedVersion(operation, version) -> "{operation}: version {version} is not supported"
            .UnsupportedAlgorithm(operation, algorithm) -> "{operation}: algorithm {algorithm} is not supported"
            .OpenFailed -> "encrypted data could not be opened"
            .NonContributoryKey -> "X25519 peer key does not contribute to a shared secret"
            .OutputLength(operation, minimum, maximum, actual) -> "{operation}: output length must be {minimum}..{maximum}; got {actual}"
            .PasswordPolicy(_) -> "password hash is outside Jet's accepted policy"
            .EntropyUnavailable -> "the operating system could not provide cryptographic randomness"
            .ResourceUnavailable(resource) -> "{resource} is unavailable for this cryptographic operation"
            .Internal(incident_id) -> "Jet could not preserve a cryptographic invariant; incident {incident_id}"
        }
        f.write_str(text)
    }
}
