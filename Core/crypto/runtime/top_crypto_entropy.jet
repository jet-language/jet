fn jet_crypto_entropy_wasi_attempt(out: &[U8]) -> () U16! {
    // GATE #4565: kernel primitive
    #Unsafe("selected WASI preview imports fill borrowed initialized storage") {
        if target.selected_env() == "p1" {
            errno :: random_get(out.as_mut_ptr(), out.len())
            if errno == 0 { Ok(()) } else { Err(errno) }
        } else {
            for chunk in out.chunks_mut(8) {
                bytes :: get_random_u64().to_ne_bytes()
                chunk.copy_from_slice(&bytes[..chunk.len()])
            }
            Ok(())
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/CryptoEntropy.rs:313
fn jet_crypto_entropy_wasi_with(count: USize, provider: fn(&[U8]) -> U16) -> [U8] JetCryptoError! {
    const ERRNO_INTR: U16 = 27
    for generation in 0..17 {
        allocation := [U8].filled(count, 0)
        #If(test) { jet_crypto_entropy_observe_wasi_attempt(.Created, generation, allocation) }
        errno :: provider(&allocation)
        #If(test) { jet_crypto_entropy_observe_wasi_attempt(.ProviderReturned(errno), generation, allocation) }
        if errno == 0 {
            #If(test) { jet_crypto_entropy_observe_wasi_attempt(.Returned, generation, allocation) }
            return Ok(^allocation)
        }
        jet_crypto_entropy_zeroize(&allocation)
        #If(test) { jet_crypto_entropy_observe_wasi_attempt(.Zeroized, generation, allocation) }
        drop(^allocation)
        #If(test) { jet_crypto_entropy_observe_wasi_attempt(.Released, generation, []) }
        if errno != ERRNO_INTR || generation == 16 -> return Err(JetCryptoError.EntropyUnavailable)
    }
    unreachable()
}
