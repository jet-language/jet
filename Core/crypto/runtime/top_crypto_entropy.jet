fn jet_crypto_entropy_fill_native(out: &[U8]) -> () JetCryptoError! {
    arch :: target.selected_arch()
    if (arch == "x86_64" || arch == "aarch64") && target.selected_os() == "linux" && target.selected_env() == "gnu" {
        return jet_crypto_entropy_fill_loop(out, fn(suffix) {
            // GATE #4565: kernel primitive
            #Unsafe("getrandom fills initialized borrowed suffix; capture errno immediately after failure") {
                result :: getrandom(suffix.as_mut_ptr().cast<c_void>(), suffix.len(), 0)
                if result > 0 { .Filled(result as USize) }
                else if result < 0 && Error.last_os_error().raw_os_error() == Val(4) { .Interrupted }
                else { .Failed }
            }
        })
    }
    if (arch == "x86_64" || arch == "aarch64") && target.selected_os() == "macos" {
        return jet_crypto_entropy_fill_loop(out, fn(suffix) {
            // GATE #4565: kernel primitive
            status :: #Unsafe("Security fills the entire borrowed suffix") { SecRandomCopyBytes(Ptr.null(), suffix.len(), suffix.as_mut_ptr()) }
            if status == 0 { .Filled(suffix.len()) } else { .Failed }
        })
    }
    if (arch == "x86_64" || arch == "aarch64") && target.selected_os() == "windows" && target.selected_env() == "msvc" {
        return jet_crypto_entropy_fill_loop(out, fn(suffix) {
            // GATE #4565: kernel primitive
            status :: #Unsafe("BCrypt system-preferred RNG fills the borrowed suffix; count bounded by public entropy API") {
                BCryptGenRandom(Ptr.null(), suffix.as_mut_ptr(), suffix.len() as U32, 2)
            }
            if status == 0 { .Filled(suffix.len()) } else { .Failed }
        })
    }
    jet_crypto_entropy_zeroize(out)
    Err(JetCryptoError.EntropyUnavailable)
}
