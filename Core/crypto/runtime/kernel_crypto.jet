//RS /// D-CRYPTO-VAULT1=A / I9: the ambient (interpreter) tier reads the vault
//RS /// through the same `jet_vault_current_impl` this file's Cranelift host calls
//RS /// and AOT emits. Name validation, the store read and every `JetVaultError`
//RS /// row stay in `Prelude/SecretsCrypto.rs`; the engines differ only in how they
//RS /// carry the resulting handle. `None` here means the key tag is not one this
//RS /// vault knows, which is the caller's refusal to render, not a store outcome.
//RS pub(crate) fn vault_current_handle(
//RS     name: &str,
//RS     tag: i64,
//RS ) -> Option<Result<Option<i64>, runtime::JetVaultError>> {
//RS     let name = name.to_string();
//RS     match tag {
//RS         1 => Some(
//RS             runtime::jet_vault_current_impl::<runtime::JetSigningKey>(&name)
//RS                 .map(|key| key.map(|key| push(CryptoValue::KeyRefSigning(key)))),
//RS         ),
//RS         2 => Some(
//RS             runtime::jet_vault_current_impl::<runtime::JetX25519SecretKey>(&name)
//RS                 .map(|key| key.map(|key| push(CryptoValue::KeyRefX25519(key)))),
//RS         ),
//RS         _ => None,
//RS     }
//RS }
//RS 
//RS /// The ONE `impl Display for JetVaultKeyRef` rendering, read through the same
//RS /// handle registry `jet_jit_vault_key_ref_show` uses.
//RS pub(crate) fn vault_key_ref_text(handle: i64) -> Option<String> {
