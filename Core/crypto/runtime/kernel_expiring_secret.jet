use std.sync.[Mutex]
use core.mem.[Box]
use jet_std.[JetExpired]

// The one secret-lifetime wrapper. Sema restricts T to move-only, zeroizing
// secret types and the stored clock to a Send + Sync, owned static closure.
// Rust: crates/jet-codegen/src/Prelude/Core/ExpiringSecret.rs:3
struct JetExpiringSecret<T> {
    value: Mutex<T?>,
    deadline_ms: I64,
    clock: Box<fn() -> I64>,
}
impl<T> JetExpiringSecret<T> {
    // Rust: crates/jet-codegen/src/Prelude/Core/ExpiringSecret.rs:9
    fn new(value: T, ttl_ms: I64, clock: fn() -> I64) -> JetExpiringSecret<T> {
        deadline_ms :: clock().saturating_add(ttl_ms)
        // GATE #4565: kernel primitive
        guarded :: #Unsafe("mutex owns the one move-only secret; clock is owned Send+Sync") {
            Mutex.new(Val(^value))
        }
        JetExpiringSecret{value: ^guarded, deadline_ms: deadline_ms, clock: Box.new(^clock)}
    }
    // Rust: crates/jet-codegen/src/Prelude/Core/ExpiringSecret.rs:21
    fn with<R>(self, callback: fn(&T) -> R) -> R JetExpired! {
        // GATE #4565: kernel primitive
        value := #Unsafe("exclusive lock retains secret until callback returns; poisoned lock retains its owner") {
            self.value.lock().unwrap_or_else(fn(error) { error.into_inner() })
        }
        if (self.clock)() > self.deadline_ms { _ :: value.take() }
        match value.as_ref() {
            Val(secret) -> Ok(callback(secret)),
            None -> Err(JetExpired{}),
        }
    }
}

