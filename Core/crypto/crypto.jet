fn rotl64(x: Int, n: Int) -> Int {
    v :: x & @c_mask64
    r :: n & 63
    if r == 0 -> return v
    ((v << r) | (v >> (64 - r))) & @c_mask64
}

fn keccak(input: [U8], rate: Int, out_len: Int, delim: Int) -> [U8] {
    st := [Int]{}
    loop i in 0..<25 -> st.push(0)
    i := 0
    loop {
        if i + rate > input.len() -> break
        absorb(&st, slice_u8(input, i, i + rate), rate)
        keccak_f(&st)
        i = i + rate
    }
    last := [U8]{}
    loop {
        if i >= input.len() -> break
        last.push(input[i])
        i = i + 1
    }
    last.push(U8{delim})
    loop {
        if last.len() >= rate -> break
        last.push(U8{0})
    }
    last[rate - 1] = (U8{last[rate - 1] | 0x80})
    absorb(&st, last, rate)
    keccak_f(&st)
    out := [U8]{}
    loop {
        if out.len() >= out_len -> return slice_u8(out, 0, out_len)
        loop x in 0..<(rate / 8) {
            lane :: st[x]
            loop b in 0..<8 {
                if out.len() >= out_len -> return slice_u8(out, 0, out_len)
                out.push(to_u8((lane >> (b * 8))))
            }
        }
        keccak_f(&st)
    }
}

fn absorb(st: &[Int], block: [U8], rate: Int) {
    n :: block.len()
    loop x in 0..<(rate / 8) {
        lane := 0
        loop b in 0..<8 {
            idx :: x * 8 + b
            if idx < n -> lane = lane | (u8_int(block[idx]) << (b * 8))
        }
        st[x] = (st[x] ~| lane) & @c_mask64
    }
}

fn keccak_f(st: &[Int]) {
    loop round in 0..<24 {
        // theta
        c := [Int]{}
        loop x in 0..<5 {
            c.push((st[x] ~| st[x + 5] ~| st[x + 10] ~| st[x + 15] ~| st[x + 20]) & @c_mask64)
        }
        loop x in 0..<5 {
            d :: (c[(x + 4) % 5] ~| rotl64(c[(x + 1) % 5], 1)) & @c_mask64
            loop y in 0..<5 -> st[x + 5 * y] = (st[x + 5 * y] ~| d) & @c_mask64
        }
        // rho + pi
        next := [Int]{}
        loop i in 0..<25 -> next.push(0)
        loop x in 0..<5 {
            loop y in 0..<5 {
                idx :: x + 5 * y
                nx :: y
                ny :: (2 * x + 3 * y) % 5
                next[nx + 5 * ny] = rotl64(st[idx], @c_keccak_rot[idx])
            }
        }
        loop i in 0..<25 -> st[i] = next[i]
        // chi
        loop y in 0..<5 {
            row := [Int]{}
            loop x in 0..<5 -> row.push(st[x + 5 * y])
            loop x in 0..<5 {
                st[x + 5 * y] = (row[x] ~| (((row[(x + 1) % 5] ~| @c_mask64) & row[(x + 2) % 5]))) & @c_mask64
            }
        }
        st[0] = (st[0] ~| @c_keccak_rc[round]) & @c_mask64
    }
}

/// RFC 8439 ChaCha20. `counter` is the 32-bit block counter.
fn chacha20_block(key: [U8], nonce: [U8], counter: Int) -> [U8] {
    st := [Int]{
        0x61707865,
        0x3320646e,
        0x79622d32,
        0x6b206574,
        u32le(key, 0),
        u32le(key, 4),
        u32le(key, 8),
        u32le(key, 12),
        u32le(key, 16),
        u32le(key, 20),
        u32le(key, 24),
        u32le(key, 28),
        wrap32(counter),
        u32le(nonce, 0),
        u32le(nonce, 4),
        u32le(nonce, 8),
    }
    w := copy_ints(st)
    loop i in 0..<10 {
        // column rounds
        qr(&w, 0, 4, 8, 12)
        qr(&w, 1, 5, 9, 13)
        qr(&w, 2, 6, 10, 14)
        qr(&w, 3, 7, 11, 15)
        // diagonal
        qr(&w, 0, 5, 10, 15)
        qr(&w, 1, 6, 11, 12)
        qr(&w, 2, 7, 8, 13)
        qr(&w, 3, 4, 9, 14)
    }
    loop i in 0..<16 -> w[i] = wrap32(w[i] + st[i])
    out := [U8]{}
    loop i in 0..<16 {
        v :: w[i]
        out.push(to_u8(v))
        out.push(to_u8((v >> 8)))
        out.push(to_u8((v >> 16)))
        out.push(to_u8((v >> 24)))
    }
    out
}

fn qr(s: &[Int], a: Int, b: Int, c: Int, d: Int) {
    s[a] = wrap32(s[a] + s[b])
    s[d] = rotl32(s[d] ~| s[a], 16)
    s[c] = wrap32(s[c] + s[d])
    s[b] = rotl32(s[b] ~| s[c], 12)
    s[a] = wrap32(s[a] + s[b])
    s[d] = rotl32(s[d] ~| s[a], 8)
    s[c] = wrap32(s[c] + s[d])
    s[b] = rotl32(s[b] ~| s[c], 7)
}

fn u32le(bytes: [U8], off: Int) -> Int {
    if off + 3 >= bytes.len() -> return 0
    (u8_int(bytes[off]) | (u8_int(bytes[off + 1]) << 8) | (u8_int(bytes[off + 2]) << 16) | (u8_int(bytes[off + 3]) << 24)) & @c_mask32
}

fn chacha20_xor(key: [U8], nonce: [U8], counter: Int, plain: [U8]) -> [U8] {
    out := [U8]{}
    i := 0
    ctr := counter
    loop {
        if i >= plain.len() -> return out
        block :: chacha20_block(key, nonce, ctr)
        ctr = ctr + 1
        loop j in 0..<64 {
            if i >= plain.len() -> return out
            out.push(U8{plain[i] ~| block[j]})
            i = i + 1
        }
    }
}

fn poly1305(key: [U8], data: [U8]) -> [U8] {
    r := le_int(slice_u8(key, 0, 16))
    r = r & 0x0ffffffc0ffffffc0ffffffc0fffffff
    s := le_int(slice_u8(key, 16, 32))
    acc := 0
    poly_p :: (1 << 130) - 5
    i := 0
    loop {
        if i >= data.len() -> break
        chunk_len := 16
        if i + chunk_len > data.len() -> chunk_len = data.len() - i
        n :: le_int(slice_u8(data, i, i + chunk_len)) + (1 << (8 * chunk_len))
        acc = ((acc + n) * r) % poly_p
        i = i + chunk_len
    }
    acc = (acc + s)
    le_bytes(acc, 16)
}

fn le_int(bytes: [U8]) -> Int {
    n := 0
    loop i in 0..<bytes.len() -> n = n | (u8_int(bytes[i]) << (8 * i))
    n
}

fn le_bytes(n: Int, width: Int) -> [U8] {
    out := [U8]{}
    v := n
    loop i in 0..<width {
        out.push(to_u8(v))
        v = v >> 8
    }
    out
}

fn pad16(n: Int) -> [U8] {
    out := [U8]{}
    rem :: (16 - (n % 16)) % 16
    loop i in 0..<rem -> out.push(U8{0})
    out
}

fn chacha_poly_seal(key: [U8], nonce: [U8], aad: [U8], plain: [U8]) -> [U8] {
    otk :: chacha20_block(key, nonce, 0)
    ct :: chacha20_xor(key, nonce, 1, plain)
    mac_data := [U8]{}
    loop b in aad -> mac_data.push(b)
    loop b in pad16(aad.len()) -> mac_data.push(b)
    loop b in ct -> mac_data.push(b)
    loop b in pad16(ct.len()) -> mac_data.push(b)
    loop b in le_bytes(aad.len(), 8) -> mac_data.push(b)
    loop b in le_bytes(ct.len(), 8) -> mac_data.push(b)
    auth_tag :: poly1305(otk, mac_data)
    out := [U8]{}
    loop b in ct -> out.push(b)
    loop b in auth_tag -> out.push(b)
    out
}

fn chacha_poly_open(key: [U8], nonce: [U8], aad: [U8], cipher: [U8]) -> ?[U8] {
    if cipher.len() < 16 -> return None
    ct :: slice_u8(cipher, 0, cipher.len() - 16)
    auth_tag :: slice_u8(cipher, cipher.len() - 16, cipher.len())
    otk :: chacha20_block(key, nonce, 0)
    mac_data := [U8]{}
    loop b in aad -> mac_data.push(b)
    loop b in pad16(aad.len()) -> mac_data.push(b)
    loop b in ct -> mac_data.push(b)
    loop b in pad16(ct.len()) -> mac_data.push(b)
    loop b in le_bytes(aad.len(), 8) -> mac_data.push(b)
    loop b in le_bytes(ct.len(), 8) -> mac_data.push(b)
    expect :: poly1305(otk, mac_data)
    if !constant_time_equal_bytes(auth_tag, expect) -> return None
    Val(chacha20_xor(key, nonce, 1, ct))
}

fn hchacha20(key: [U8], nonce16: [U8]) -> [U8] {
    st := [Int]{
        0x61707865,
        0x3320646e,
        0x79622d32,
        0x6b206574,
        u32le(key, 0),
        u32le(key, 4),
        u32le(key, 8),
        u32le(key, 12),
        u32le(key, 16),
        u32le(key, 20),
        u32le(key, 24),
        u32le(key, 28),
        u32le(nonce16, 0),
        u32le(nonce16, 4),
        u32le(nonce16, 8),
        u32le(nonce16, 12),
    }
    loop i in 0..<10 {
        qr(&st, 0, 4, 8, 12)
        qr(&st, 1, 5, 9, 13)
        qr(&st, 2, 6, 10, 14)
        qr(&st, 3, 7, 11, 15)
        qr(&st, 0, 5, 10, 15)
        qr(&st, 1, 6, 11, 12)
        qr(&st, 2, 7, 8, 13)
        qr(&st, 3, 4, 9, 14)
    }
    out := [U8]{}
    loop k in 0..<4 -> hchacha_word(&out, st[k])
    loop k in 12..<16 -> hchacha_word(&out, st[k])
    out
}

fn hchacha_word(out: &[U8], v: Int) {
    out.push(to_u8(v))
    out.push(to_u8((v >> 8)))
    out.push(to_u8((v >> 16)))
    out.push(to_u8((v >> 24)))
}

fn xchacha_seal(key: [U8], nonce24: [U8], aad: [U8], plain: [U8]) -> [U8] {
    sub :: hchacha20(key, slice_u8(nonce24, 0, 16))
    n := [U8]{0, 0, 0, 0}
    loop b in slice_u8(nonce24, 16, 24) -> n.push(b)
    chacha_poly_seal(sub, n, aad, plain)
}

fn xchacha_open(key: [U8], nonce24: [U8], aad: [U8], cipher: [U8]) -> ?[U8] {
    sub :: hchacha20(key, slice_u8(nonce24, 0, 16))
    n := [U8]{0, 0, 0, 0}
    loop b in slice_u8(nonce24, 16, 24) -> n.push(b)
    chacha_poly_open(sub, n, aad, cipher)
}

@c_p25519 :: 57896044618658097711785492504343953926634992332820282019728792003956564819949

fn x25519_scalarmult(sk: [U8], u: [U8]) -> [U8] {
    k := copy_bytes(sk)
    if k.len() != 32 {
        padded := [U8]{}
        loop b in k -> padded.push(b)
        loop {
            if padded.len() >= 32 -> break
            padded.push(U8{0})
        }
        k = slice_u8(padded, 0, 32)
    }
    k[0] = (U8{k[0] & 248})
    k[31] = (U8{(k[31] & 127) | 64})
    x1 := le_int(u) % @c_p25519
    x2 := 1
    z2 := 0
    x3 := x1
    z3 := 1
    swap := 0
    t := 254
    loop {
        if t < 0 -> break
        kt :: (k[t / 8] >> (t % 8)) & 1
        if (swap ~| kt) == 1 {
            tmp :: x2
            x2 = x3
            x3 = tmp
            tmpz :: z2
            z2 = z3
            z3 = tmpz
        }
        swap = kt
        a :: (x2 + z2) % @c_p25519
        aa :: (a * a) % @c_p25519
        b :: (x2 - z2) % @c_p25519
        if b < 0 -> b = b + @c_p25519
        bb :: (b * b) % @c_p25519
        e :: (aa - bb) % @c_p25519
        if e < 0 -> e = e + @c_p25519
        c :: (x3 + z3) % @c_p25519
        d :: (x3 - z3) % @c_p25519
        if d < 0 -> d = d + @c_p25519
        da :: (d * a) % @c_p25519
        cb :: (c * b) % @c_p25519
        x3 = ((da + cb) * (da + cb)) % @c_p25519
        z3 = (x1 * (((da - cb) % @c_p25519 + @c_p25519) % @c_p25519) * (((da - cb) % @c_p25519 + @c_p25519) % @c_p25519)) % @c_p25519
        x2 = (aa * bb) % @c_p25519
        z2 = (e * (aa + (121665 * e) % @c_p25519)) % @c_p25519
        t = t - 1
    }
    if swap == 1 {
        tmp :: x2
        x2 = x3
        x3 = tmp
        tmpz :: z2
        z2 = z3
        z3 = tmpz
    }
    inv :: mod_pow(z2, @c_p25519 - 2, @c_p25519)
    out :: (x2 * inv) % @c_p25519
    le_bytes(out, 32)
}

fn mod_pow(base: Int, exp: Int, m: Int) -> Int {
    r := 1
    b := base % m
    e := exp
    loop {
        if e == 0 -> return r
        if e & 1 == 1 -> r = (r * b) % m
        b = (b * b) % m
        e = e >> 1
    }
}

// Ed25519 (RFC 8032). Twisted Edwards, SHA-512.
@c_ed_p :: @c_p25519

@c_ed_l :: 72370055773322622139731865630429942437067764208690717163587762967493611119873

@c_ed_d :: 37095705934669439331942182887173239785150454550392664706134657264234383020273

@c_ed_bx :: 15112221349535400772501151409588531511454012693041857206046113283949847762202

@c_ed_by :: 46316835694926478169428394003475163141307993866256225615783033603165251855960

fn ed25519_sign_raw(seed: [U8], msg: [U8]) -> [U8] {
    h :: sha512_raw(seed, @c_sha512_iv)
    a := clamp_scalar(le_int(slice_u8(h, 0, 32)))
    prefix :: slice_u8(h, 32, 64)
    point_a :: ed_scalarmult(a, @c_ed_bx, @c_ed_by)
    r_mat := [U8]{}
    loop b in prefix -> r_mat.push(b)
    loop b in msg -> r_mat.push(b)
    r :: le_int(sha512_raw(r_mat, @c_sha512_iv)) % @c_ed_l
    point_r :: ed_scalarmult(r, @c_ed_bx, @c_ed_by)
    encoded_r :: ed_encode(point_r.x, point_r.y)
    encoded_a :: ed_encode(point_a.x, point_a.y)
    k_mat := [U8]{}
    loop b in encoded_r -> k_mat.push(b)
    loop b in encoded_a -> k_mat.push(b)
    loop b in msg -> k_mat.push(b)
    k :: le_int(sha512_raw(k_mat, @c_sha512_iv)) % @c_ed_l
    s :: (r + k * a) % @c_ed_l
    out := [U8]{}
    loop b in encoded_r -> out.push(b)
    loop b in le_bytes(s, 32) -> out.push(b)
    out
}

fn ed25519_verify_raw(pk: [U8], msg: [U8], sig: [U8]) -> Bool {
    if pk.len() != 32 || sig.len() != 64 -> return false
    point_a :: ed_decode(pk) ?? return false
    encoded_r :: slice_u8(sig, 0, 32)
    s :: le_int(slice_u8(sig, 32, 64))
    if s >= @c_ed_l -> return false
    point_r :: ed_decode(encoded_r) ?? return false
    k_mat := [U8]{}
    loop b in encoded_r -> k_mat.push(b)
    loop b in pk -> k_mat.push(b)
    loop b in msg -> k_mat.push(b)
    k :: le_int(sha512_raw(k_mat, @c_sha512_iv)) % @c_ed_l
    sb :: ed_scalarmult(s, @c_ed_bx, @c_ed_by)
    k_point_a :: ed_scalarmult(k, point_a.x, point_a.y)
    r_plus_k_a :: ed_add(point_r.x, point_r.y, k_point_a.x, k_point_a.y)
    sb.x == r_plus_k_a.x && sb.y == r_plus_k_a.y
}

pub struct EdPoint {
    pub x: Int
    pub y: Int
}

fn ed_scalarmult(s: Int, x: Int, y: Int) -> EdPoint {
    rx := 0
    ry := 1
    bit := s
    px := x
    py := y
    loop {
        if bit == 0 -> return ({x: rx, y: ry})
        if bit & 1 == 1 {
            a :: ed_add(rx, ry, px, py)
            rx = a.x
            ry = a.y
        }
        dbl :: ed_add(px, py, px, py)
        px = dbl.x
        py = dbl.y
        bit = bit >> 1
    }
}

fn ed_add(x1: Int, y1: Int, x2: Int, y2: Int) -> EdPoint {
    p :: @c_ed_p
    x1x2 :: (x1 * x2) % p
    y1y2 :: (y1 * y2) % p
    x1y2 :: (x1 * y2) % p
    y1x2 :: (y1 * x2) % p
    dxxyy :: (@c_ed_d * x1x2 % p * y1y2) % p
    invx :: mod_pow((1 + dxxyy) % p, p - 2, p)
    invy :: mod_pow((1 - dxxyy + p) % p, p - 2, p)
    x3 :: ((x1y2 + y1x2) % p * invx) % p
    y3 :: ((y1y2 + x1x2) % p * invy) % p
    {x: x3, y: y3}
}

fn ed_encode(x: Int, y: Int) -> [U8] {
    out := le_bytes(y, 32)
    if (x & 1) == 1 -> out[31] = (U8{out[31] | 128})
    out
}

fn ed_decode(bytes: [U8]) -> ?EdPoint {
    yb := copy_bytes(bytes)
    sign :: (yb[31] >> 7) & 1
    yb[31] = (U8{yb[31] & 127})
    y :: le_int(yb)
    if y >= @c_ed_p -> return None
    y2 :: (y * y) % @c_ed_p
    u :: (y2 - 1 + @c_ed_p) % @c_ed_p
    v :: ((@c_ed_d * y2) % @c_ed_p + 1) % @c_ed_p
    x := mod_pow((u * mod_pow(v, @c_ed_p - 2, @c_ed_p)) % @c_ed_p, (@c_ed_p + 3) / 8, @c_ed_p)
    if (v * x % @c_ed_p * x % @c_ed_p) != u {
        sqrt_minus_one :: mod_pow(2, (@c_ed_p - 1) / 4, @c_ed_p)
        x = (x * sqrt_minus_one) % @c_ed_p
        if (v * x % @c_ed_p * x % @c_ed_p) != u -> return None
    }
    if (x & 1) != sign -> x = (@c_ed_p - x) % @c_ed_p
    Val(EdPoint{x: x, y: y})
}

fn clamp_scalar(n: Int) -> Int {
    b :: le_bytes(n, 32)
    b[0] = (U8{b[0] & 248})
    b[31] = (U8{(b[31] & 63) | 64})
    le_int(b)
}

@c_blake3_iv :: [Int]{0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19}

@c_blake3_msg :: [Int]{
