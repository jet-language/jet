package {
    name: "core.crypto"
    version: "0.1.0"
    edition: "2026"
    description: "Typed cryptography: hashes in Jet, envelopes on the host."
    license: "MIT"
    outputs: {
        crypto: .Library{ entry: crypto }
    }
}
use core
use core.files.path.[Path]
use core.crypto.expert as rawcrypto

// core.crypto - safe envelopes and expert primitives (D-ONCE-LAYER1=B).
//
// This package is the typed rung. Beginner APIs hide nonce handling and
// algorithm choice. Raw algorithm control lives in `core.crypto.expert` and
// requires an audited `#Unsafe` region at the call site.
//
// Written in Jet:
// - SHA-1 / SHA-2 / SHA-3 / BLAKE3
// - HMAC-SHA256, HKDF-SHA256 expand, PBKDF2-HMAC-SHA256
// - ChaCha20-Poly1305, X25519, Ed25519, AES-256-GCM (expert)
// - constant-time equality
// - UUID v4/v5/v7 (v4/v7 need host CSPRNG; v5 is pure)
//
// The only host cells are the OS CSPRNG and file bytes for file_seal.
//
// Secret-bearing types are nominal. Do not log them; `Show` must not print
// key bytes. Fail closed: a missing RNG is an error, never a fallback to
// a weak generator.
module expert

module random

module uuid

module vault

C_MASK32 :: 4294967295

C_MASK64 :: 18446744073709551615

#Error
pub enum CryptoError {
    OpenFailed
    VerifyFailed
    KeyRejected
    Length
    Unavailable
}

#Error
pub enum FileCryptoError {
    OpenFailed
    PublishFailed
    SourceMissing
}

pub struct Digest256 {
    pub bytes: [U8]

    pub fn as_bytes(self) -> [U8] { self.bytes }

    pub fn hex(self) -> String Never! { hex_encode(self.bytes) }
}

pub struct Digest512 {
    pub bytes: [U8]

    pub fn as_bytes(self) -> [U8] { self.bytes }

    pub fn hex(self) -> String Never! { hex_encode(self.bytes) }
}

pub struct Hasher {
    pub data: [U8]

    pub fn new() -> Hasher { {data: [U8]{}} }

    pub fn update(&self, bytes: [U8]) {
        loop b in bytes -> &self.data.push(b)
    }

    pub fn digest(self) -> String { sha256(self.data).hex() }
}

/// Hashlib-style module constructors for the default SHA-256 hasher.
pub fn new() -> Hasher { Hasher.new() }

pub fn update(hasher: &Hasher, bytes: [U8]) { &hasher.update(bytes) }

pub fn digest(hasher: ^Hasher) -> String { hasher.digest() }

pub struct Secret {
    pub bytes: [U8]

    /// The UTF-8 bytes of `text` as secret material.
    pub fn from_text(text: String) -> Secret { Secret{bytes: text.bytes()} }

    pub fn from_bytes(bytes: [U8]) -> Secret { Secret{bytes: bytes} }
}

// Secret-bearing values wipe their bytes when they close (D-SHAPE-RESOURCE1=A).
// The wipe consumes the byte buffer; the emptied field keeps the owner whole
// for its own release.
impl Secret.Close {
    fn close(^self) {
        secret := ^self
        core.crypto.__zeroize(^secret.bytes)
        secret.bytes = [U8]{}
    }
}

pub struct SigningKey {
    pub bytes: [U8]

    /// A fresh Ed25519 seed from the OS CSPRNG. There is no fallback generator.
    pub fn new_random() -[Rand]> SigningKey CryptoError! {
        seed :: core.crypto.random.bytes(32) ?? return Err(CryptoError.Unavailable)
        Ok(SigningKey{bytes: seed})
    }

    /// An Ed25519 seed. It must be exactly 32 bytes.
    pub fn from_bytes(bytes: [U8]) -> SigningKey CryptoError! {
        if bytes.len() != 32 -> return Err(CryptoError.Length)
        Ok(SigningKey{bytes: bytes})
    }

    /// The RFC 8032 public key for this seed.
    pub fn public_key(self) -> VerifyKey Never! { VerifyKey{bytes: ed25519_public_raw(self.bytes)} }
}

impl SigningKey.Close {
    fn close(^self) {
        key := ^self
        core.crypto.__zeroize(^key.bytes)
        key.bytes = [U8]{}
    }
}

pub struct VerifyKey {
    pub bytes: [U8]

    /// An encoded Ed25519 public key. It must be exactly 32 bytes.
    pub fn from_bytes(bytes: [U8]) -> VerifyKey CryptoError! {
        if bytes.len() != 32 -> return Err(CryptoError.Length)
        Ok(VerifyKey{bytes: bytes})
    }
}

pub struct X25519SecretKey {
    pub bytes: [U8]

    /// A fresh X25519 private key from the OS CSPRNG.
    pub fn new_random() -[Rand]> X25519SecretKey CryptoError! {
        key :: core.crypto.random.bytes(32) ?? return Err(CryptoError.Unavailable)
        Ok(X25519SecretKey{bytes: key})
    }

    /// A raw X25519 private key. It must be exactly 32 bytes.
    pub fn from_bytes(bytes: [U8]) -> X25519SecretKey CryptoError! {
        if bytes.len() != 32 -> return Err(CryptoError.Length)
        Ok(X25519SecretKey{bytes: bytes})
    }

    /// The RFC 7748 public key. A key that isn't 32 bytes stops with a panic;
    /// `x25519_public` is the checked form.
    pub fn public_key(self) -> X25519PublicKey { X25519PublicKey{bytes: x25519_scalarmult(self.bytes, x25519_base_point())} }
}

impl X25519SecretKey.Close {
    fn close(^self) {
        key := ^self
        core.crypto.__zeroize(^key.bytes)
        key.bytes = [U8]{}
    }
}

pub struct X25519PublicKey {
    pub bytes: [U8]

    /// A raw X25519 public key. It must be exactly 32 bytes.
    pub fn from_bytes(bytes: [U8]) -> X25519PublicKey CryptoError! {
        if bytes.len() != 32 -> return Err(CryptoError.Length)
        Ok(X25519PublicKey{bytes: bytes})
    }

    /// Parse the Bech32m recipient text written by `text`. Anything else,
    /// including uppercase, truncation and a bad checksum, is `KeyRejected`.
    pub fn from_text(text: String) -> X25519PublicKey CryptoError! {
        bytes :: x25519_recipient_decode(text) ?? return Err(CryptoError.KeyRejected)
        Ok(X25519PublicKey{bytes: bytes})
    }

    /// Bech32m recipient text: `jetx25519` + `1` + 52 data symbols + checksum.
    pub fn text(self) -> String Never! { x25519_recipient_encode(self.bytes) }
}

pub struct SharedSecret {
    pub bytes: [U8]
}

impl SharedSecret.Close {
    fn close(^self) {
        secret := ^self
        core.crypto.__zeroize(^secret.bytes)
        secret.bytes = [U8]{}
    }
}

pub struct Signature {
    pub bytes: [U8]

    /// An Ed25519 signature. It must be exactly 64 bytes.
    pub fn from_bytes(bytes: [U8]) -> Signature CryptoError! {
        if bytes.len() != 64 -> return Err(CryptoError.Length)
        Ok(Signature{bytes: bytes})
    }
}

pub struct Sealed {
    pub bytes: [U8]
}

pub fn sealed_bytes(value: Sealed) -> [U8] Never! { value.bytes }

pub struct WrappedKey {
    pub bytes: [U8]
}

pub struct WrappedVaultKey {
    pub bytes: [U8]
}

pub struct KeyUnlock {
    pub bytes: [U8]
}

pub struct PasswordHash {
    pub text: String
}

#Error
pub struct KeyWrapError {
    pub reason: String
}

/// SHA-256. Pure Jet, RFC 6234. Allocates a 32-byte digest.
pub fn sha256(bytes: [U8]) -> Digest256 Never! { {bytes: sha256_raw(bytes)} }

/// SHA-224. SHA-256 with the SHA-224 IV, truncated to 28 bytes.
pub fn sha224(bytes: [U8]) -> String { hex_encode(slice_u8(sha2_256(bytes, C_SHA224_IV), 0, 28)) }

/// SHA-1. RFC 3174. Prefer SHA-256; this exists for UUID v5 and legacy checks.
pub fn sha1(bytes: [U8]) -> String { hex_encode(sha1_raw(bytes)) }

/// SHA-384. SHA-512 with the SHA-384 IV, truncated to 48 bytes.
pub fn sha384(bytes: [U8]) -> String { hex_encode(slice_u8(sha512_raw(bytes, C_SHA384_IV), 0, 48)) }

/// SHA-512 (FIPS 180-4).
pub fn sha512(bytes: [U8]) -> Digest512 { {bytes: sha512_raw(bytes, C_SHA512_IV)} }

/// SHA-3 (FIPS 202). Keccak-f[1600] sponge, rate 1152/1088/832/576.
pub fn sha3_224(bytes: [U8]) -> String { hex_encode(keccak(bytes, 144, 28, 0x06)) }

pub fn sha3_256(bytes: [U8]) -> String { hex_encode(keccak(bytes, 136, 32, 0x06)) }

pub fn sha3_384(bytes: [U8]) -> String { hex_encode(keccak(bytes, 104, 48, 0x06)) }

pub fn sha3_512(bytes: [U8]) -> String { hex_encode(keccak(bytes, 72, 64, 0x06)) }

/// BLAKE3-256. Tree hasher, 32-byte output.
pub fn blake3(bytes: [U8]) -> Digest256 { {bytes: blake3_raw(bytes)} }

/// HMAC-SHA256 (RFC 4231).
pub fn hmac_sha256(key: [U8], data: [U8]) -> [U8] Never! { hmac_sha256_raw(key, data) }

/// HKDF-SHA256 expand. `len` is 0..=8160. The output is a `Secret` so callers
/// cannot print it by accident.
pub fn hkdf_sha256(ikm: [U8], salt: [U8], info: [U8], len: Int) -> Secret CryptoError! {
    if len < 0 || len > 8160 -> return Err(CryptoError.Length)
    prk :: hmac_sha256_raw(salt, ikm)
    out := [U8]{}
    last_block := [U8]{}
    counter := 1
    loop out.len() < len {
        material := [U8]{}
        loop b in last_block -> &material.push(b)
        loop b in info -> &material.push(b)
        &material.push(to_u8(counter))
        last_block = hmac_sha256_raw(~prk, material)
        loop b in last_block {
            if out.len() >= len -> break
            &out.push(b)
        }
        counter += 1
    }
    Ok(Secret{bytes: out})
}

/// PBKDF2-HMAC-SHA256.
pub fn pbkdf2_hmac(password: [U8], salt: [U8], iterations: Int, key_len: Int) -> [U8] CryptoError! {
    if iterations < 1 || key_len < 1 || key_len > 67108864 -> return Err(CryptoError.Length)
    blocks :: (key_len + 31) /% 32
    out := [U8]{}
    loop bi in 0..<blocks {
        salt_i := [U8]{}
        loop b in salt -> &salt_i.push(b)
        bn :: bi + 1
        &salt_i.push(to_u8(bn >> 24))
        &salt_i.push(to_u8(bn >> 16))
        &salt_i.push(to_u8(bn >> 8))
        &salt_i.push(to_u8(bn))
        u := hmac_sha256_raw(~password, salt_i)
        acc := copy_bytes(~u)
        loop round in 1..<iterations {
            u = hmac_sha256_raw(~password, u)
            loop j in 0..<32 -> acc[j] = to_u8(Int.from_u8(acc[j]) ~| Int.from_u8(u[j]))
        }
        loop b in acc {
            if out.len() >= key_len -> break
            &out.push(b)
        }
    }
    Ok(out)
}

pub fn constant_time_equal_bytes(a: [U8], b: [U8]) -> Bool Never! {
    diff := 0
    if a.len() != b.len() -> diff = 1
    n :: a.len()
    m :: b.len()
    limit := n
    if m > limit -> limit = m
    loop i in 0..<limit {
        left := 0
        right := 0
        if i < n -> left = Int.from_u8(a[i])
        if i < m -> right = Int.from_u8(b[i])
        diff = diff | (left ~| right)
    }
    diff == 0
}

pub fn constant_time_equal(a: Secret, b: Secret) -> Bool {
    constant_time_equal_bytes(a.bytes, b.bytes)
}

// X25519 recipients + XChaCha20-Poly1305.
//
// JETV1 wire format:
// `JETV` || version || suite || flags || recipient_count ||
// ephemeral_public || salt || payload_nonce ||
// sorted recipient stanzas || plaintext_length || ciphertext||tag.
pub fn seal(recipients: [X25519PublicKey], bytes: [U8], aad: [U8]) -[Rand]> Sealed CryptoError! {
    if recipients.len() == 0 || recipients.len() > 256 -> return Err(CryptoError.KeyRejected)
    if bytes.len() > 16777216 || aad.len() > 16777216 -> return Err(CryptoError.Length)
    loop recipient in recipients {
        if recipient.bytes.len() != 32 -> return Err(CryptoError.KeyRejected)
    }
    sorted :: canonical_recipients(recipients)
    loop i in 1..<sorted.len() {
        if key_order(~sorted[i - 1].bytes, ~sorted[i].bytes) >= 0 {
            return Err(CryptoError.KeyRejected)
        }
    }
    eph_sk :: core.crypto.random.bytes(32) ?? return Err(CryptoError.Unavailable)
    eph_pk :: x25519_public(X25519SecretKey{bytes: copy_bytes(~eph_sk)}) ?? return Err(CryptoError.KeyRejected)
    salt :: core.crypto.random.bytes(16) ?? return Err(CryptoError.Unavailable)
    nonce :: core.crypto.random.bytes(24) ?? return Err(CryptoError.Unavailable)
    file_key :: core.crypto.random.bytes(32) ?? return Err(CryptoError.Unavailable)
    header := [U8]{}
    loop b in "JETV".bytes() -> &header.push(b)
    &header.push(U8{1})
    &header.push(U8{1})
    &header.push(U8{0})
    &header.push(U8{0})
    &header.push(to_u8(sorted.len() /% 256))
    &header.push(to_u8(sorted.len() %% 256))
    loop b in eph_pk.bytes -> &header.push(b)
    loop b in salt -> &header.push(b)
    loop b in nonce -> &header.push(b)
    stanzas := [U8]{}
    loop rec in sorted {
        shared :: x25519(X25519SecretKey{bytes: copy_bytes(~eph_sk)}, ~rec) ?? return Err(CryptoError.KeyRejected)
        key_info := [U8]{}
        loop b in "JETV1 wrap".bytes() -> &key_info.push(b)
        loop b in eph_pk.bytes -> &key_info.push(b)
        loop b in rec.bytes -> &key_info.push(b)
        kek :: hkdf_sha256(~shared.bytes, ~salt, key_info, 32) ?? return Err(CryptoError.Length)
        nonce_info := [U8]{}
        loop b in "JETV1 nonce".bytes() -> &nonce_info.push(b)
        loop b in eph_pk.bytes -> &nonce_info.push(b)
        loop b in rec.bytes -> &nonce_info.push(b)
        wrap_nonce :: hkdf_sha256(~shared.bytes, ~salt, nonce_info, 24) ?? return Err(CryptoError.Length)
        stanza_aad := [U8]{}
        loop b in "JETV1 stanza".bytes() -> &stanza_aad.push(b)
        loop b in header -> &stanza_aad.push(b)
        loop b in rec.bytes -> &stanza_aad.push(b)
        wrapped :: xchacha_seal(kek.bytes, wrap_nonce.bytes, stanza_aad, ~file_key)
        if wrapped.len() != 48 -> return Err(CryptoError.Length)
        loop b in rec.bytes -> &stanzas.push(b)
        loop b in wrapped -> &stanzas.push(b)
    }
    payload_aad := [U8]{}
    loop b in "JETV1 payload".bytes() -> &payload_aad.push(b)
    loop b in header -> &payload_aad.push(b)
    loop b in stanzas -> &payload_aad.push(b)
    loop b in aad -> &payload_aad.push(b)
    body :: xchacha_seal(file_key, nonce, payload_aad, ~bytes)
    out := [U8]{}
    loop b in header -> &out.push(b)
    loop b in stanzas -> &out.push(b)
    _ :: append_be32(&out, bytes.len()) ?? return Err(CryptoError.Length)
    loop b in body -> &out.push(b)
    Ok(Sealed{bytes: out})
}

fn open_sealed(identity: X25519SecretKey, box: Sealed, aad: [U8]) -> [U8] CryptoError! {
    raw :: box.bytes
    if aad.len() > 16777216 -> return Err(CryptoError.OpenFailed)
    if raw.len() < 182 || raw.len() > 16797798 -> return Err(CryptoError.OpenFailed)
    if slice_u8(~raw, 0, 4) != "JETV".bytes() -> return Err(CryptoError.OpenFailed)
    if raw[4] != (U8{1}) || raw[5] != (U8{1}) || raw[6] != (U8{0}) || raw[7] != (U8{0}) {
        return Err(CryptoError.OpenFailed)
    }
    count :: (Int.from_u8(raw[8]) << 8) | Int.from_u8(raw[9])
    if count < 1 || count > 256 -> return Err(CryptoError.OpenFailed)
    len_offset :: 82 + count * 80
    if raw.len() < len_offset + 20 -> return Err(CryptoError.OpenFailed)
    payload_len :: read_be32(~raw, len_offset)
    payload_end :: len_offset + 4 + payload_len + 16
    if payload_len > 16777216 || raw.len() != payload_end -> return Err(CryptoError.OpenFailed)
    previous := [U8]{}
    loop index in 0..<count {
        current :: slice_u8(~raw, 82 + index * 80, 82 + index * 80 + 32)
        if index > 0 && key_order(~previous, ~current) >= 0 -> return Err(CryptoError.OpenFailed)
        previous = current
    }
    own_public :: x25519_public(identity) ?? return Err(CryptoError.KeyRejected)
    stanza_index := -1
    loop index in 0..<count {
        current :: slice_u8(~raw, 82 + index * 80, 82 + index * 80 + 32)
        if constant_time_equal_bytes(current, ~own_public.bytes) -> stanza_index = index
    }
    if stanza_index < 0 -> return Err(CryptoError.OpenFailed)
    eph :: slice_u8(~raw, 10, 42)
    shared :: x25519(identity, X25519PublicKey{bytes: copy_bytes(~eph)}) ?? return Err(CryptoError.KeyRejected)
    salt :: slice_u8(~raw, 42, 58)
    key_info := [U8]{}
    loop b in "JETV1 wrap".bytes() -> &key_info.push(b)
    loop b in eph -> &key_info.push(b)
    loop b in own_public.bytes -> &key_info.push(b)
    kek :: hkdf_sha256(~shared.bytes, ~salt, key_info, 32) ?? return Err(CryptoError.Length)
    nonce_info := [U8]{}
    loop b in "JETV1 nonce".bytes() -> &nonce_info.push(b)
    loop b in eph -> &nonce_info.push(b)
    loop b in own_public.bytes -> &nonce_info.push(b)
    wrap_nonce :: hkdf_sha256(~shared.bytes, ~salt, nonce_info, 24) ?? return Err(CryptoError.Length)
    stanza_aad := [U8]{}
    loop b in "JETV1 stanza".bytes() -> &stanza_aad.push(b)
    loop b in slice_u8(~raw, 0, 82) -> &stanza_aad.push(b)
    loop b in own_public.bytes -> &stanza_aad.push(b)
    stanza_start :: 82 + stanza_index * 80
    wrapped :: slice_u8(~raw, stanza_start + 32, stanza_start + 80)
    file_key_opt :: xchacha_open(kek.bytes, wrap_nonce.bytes, stanza_aad, wrapped)
    file_key :: file_key_opt ?? return Err(CryptoError.OpenFailed)
    if file_key.len() != 32 -> return Err(CryptoError.OpenFailed)
    payload_aad := [U8]{}
    loop b in "JETV1 payload".bytes() -> &payload_aad.push(b)
    loop b in slice_u8(~raw, 0, 82) -> &payload_aad.push(b)
    loop b in slice_u8(~raw, 82, len_offset) -> &payload_aad.push(b)
    loop b in aad -> &payload_aad.push(b)
    nonce :: slice_u8(~raw, 58, 82)
    body :: slice_u8(~raw, len_offset + 4, raw.len())
    opened :: xchacha_open(file_key, nonce, payload_aad, body) ?? return Err(CryptoError.OpenFailed)
    Ok(opened)
}

fn canonical_recipients(items: [X25519PublicKey]) -> [X25519PublicKey] Never! {
    out := [X25519PublicKey]{}
    loop item in items -> &out.push(X25519PublicKey{bytes: copy_bytes(item.bytes)})
    i := 1
    loop i < out.len() {
        current := out[i]
        j := i
        loop j > 0 && key_order(~out[j - 1].bytes, ~current.bytes) > 0 {
            out[j] = out[j - 1]
            j = j - 1
        }
        out[j] = current
        i = i + 1
    }
    out
}

fn key_order(a: [U8], b: [U8]) -> Int Never! {
    if a.len() != b.len() {
        if a.len() < b.len() -> return -1
        return 1
    }
    loop i in 0..<a.len() {
        x :: Int.from_u8(a[i])
        y :: Int.from_u8(b[i])
        if x < y -> return -1
        if x > y -> return 1
    }
    0
}

fn append_be32(out: &[U8], n: Int) -> Bool CryptoError! {
    &out.push(to_u8(n >> 24))
    &out.push(to_u8(n >> 16))
    &out.push(to_u8(n >> 8))
    &out.push(to_u8(n))
    true
}

pub fn open(identity: X25519SecretKey, box: Sealed, aad: [U8]) -> [U8] CryptoError! {
    open_sealed(identity, box, aad)
}

pub fn file_seal(recipients: [X25519PublicKey], source: Path, destination: Path) -[FS, Rand]> Bool FileCryptoError! {
    data :: host_read_file(source.raw) ?? return Err(FileCryptoError.SourceMissing)
    sealed :: seal(recipients, data, [U8]{}) ?? return Err(FileCryptoError.PublishFailed)
    host_write_file(destination.raw, sealed.bytes) ?? return Err(FileCryptoError.PublishFailed)
    Ok(true)
}

pub fn file_open(identity: X25519SecretKey, source: Path, destination: Path) -[FS]> Bool FileCryptoError! {
    data :: host_read_file(source.raw) ?? return Err(FileCryptoError.SourceMissing)
    plain :: open_sealed(identity, Sealed{bytes: data}, [U8]{}) ?? return Err(FileCryptoError.OpenFailed)
    host_write_file(destination.raw, plain) ?? return Err(FileCryptoError.PublishFailed)
    Ok(true)
}

pub fn sign(signing_key: SigningKey, bytes: [U8]) -> Signature CryptoError! {
    if signing_key.bytes.len() != 32 -> return Err(CryptoError.KeyRejected)
    Ok(Signature{bytes: ed25519_sign_raw(signing_key.bytes, bytes)})
}

pub fn verify(verify_key: VerifyKey, bytes: [U8], signature: Signature) -> Bool CryptoError! {
    if verify_key.bytes.len() != 32 || signature.bytes.len() != 64 {
        return Err(CryptoError.KeyRejected)
    }
    Ok(ed25519_verify_raw(verify_key.bytes, bytes, signature.bytes))
}

pub fn x25519(secret_key: X25519SecretKey, public_key: X25519PublicKey) -> SharedSecret CryptoError! {
    if secret_key.bytes.len() != 32 || public_key.bytes.len() != 32 {
        return Err(CryptoError.KeyRejected)
    }
    shared :: x25519_scalarmult(secret_key.bytes, public_key.bytes)
    if all_zero(~shared) -> return Err(CryptoError.KeyRejected)
    Ok(SharedSecret{bytes: shared})
}

pub fn x25519_public(secret_key: X25519SecretKey) -> X25519PublicKey CryptoError! {
    if secret_key.bytes.len() != 32 -> return Err(CryptoError.KeyRejected)
    Ok(X25519PublicKey{bytes: x25519_scalarmult(secret_key.bytes, x25519_base_point())})
}

/// The RFC 7748 X25519 base point, u = 9.
fn x25519_base_point() -> [U8] Never! {
    base := [U8]{}
    loop _ in 0..<32 -> &base.push(U8{0})
    base[0] = (U8{9})
    base
}

/// Bech32m generator polymod (BIP 350).
fn bech32_polymod(values: [Int]) -> Int Never! {
    generators :: [Int]{0x3b6a57b2, 0x26508e6d, 0x1ea119fa, 0x3d4233dd, 0x2a1462b3}
    chk := 1
    loop v in values {
        top :: chk >> 25
        chk = ((chk & 0x1ffffff) << 5) ~| v
        loop i in 0..<5 {
            if ((top >> i) & 1) == 1 -> chk = chk ~| generators[i]
        }
    }
    chk
}

fn bech32_hrp_expand(hrp: String) -> [Int] Never! {
    raw :: hrp.bytes()
    out := [Int]{}
    loop b in raw -> &out.push(Int.from_u8(b) >> 5)
    &out.push(0)
    loop b in raw -> &out.push(Int.from_u8(b) & 31)
    out
}

fn bech32_charset() -> [U8] Never! { "qpzry9x8gf2tvdw0s3jn54khce6mua7l".bytes() }

fn bech32_value(b: U8) -> Int? {
    i := 0
    loop c in bech32_charset() {
        if c == b -> return Val(i)
        i += 1
    }
    None
}

C_BECH32M_CONST :: 0x2bc830a3

fn x25519_recipient_encode(key: [U8]) -> String Never! {
    data := [Int]{}
    acc := 0
    bits := 0
    loop b in key {
        acc = ((acc << 8) | Int.from_u8(b)) & 4095
        bits += 8
        loop bits >= 5 {
            bits -= 5
            &data.push((acc >> bits) & 31)
        }
    }
    if bits > 0 -> &data.push((acc << (5 - bits)) & 31)
    input := bech32_hrp_expand("jetx25519")
    loop v in data -> &input.push(v)
    loop _ in 0..<6 -> &input.push(0)
    polymod :: bech32_polymod(input) ~| C_BECH32M_CONST
    charset :: bech32_charset()
    out := [U8]{}
    loop b in "jetx255191".bytes() -> &out.push(b)
    loop v in data -> &out.push(charset[v])
    loop i in 0..<6 -> &out.push(charset[(polymod >> (5 * (5 - i))) & 31])
    String.from_bytes(out) ?? panic("invalid UTF-8 in Bech32m recipient")
}

/// Exact-size decode: HRP (9) + separator + 52 data symbols + 6 checksum
/// symbols. Nonzero padding bits are rejected so each key has one spelling.
fn x25519_recipient_decode(text: String) -> [U8]? {
    raw :: text.bytes()
    if raw.len() != 68 -> return None
    prefix :: "jetx255191".bytes()
    loop i in 0..<10 {
        if raw[i] != prefix[i] -> return None
    }
    values := [Int]{}
    loop i in 10..<68 {
        v :: bech32_value(raw[i]) ?? return None
        &values.push(v)
    }
    check := bech32_hrp_expand("jetx25519")
    loop v in values -> &check.push(v)
    if bech32_polymod(check) != C_BECH32M_CONST -> return None
    out := [U8]{}
    acc := 0
    bits := 0
    loop i in 0..<52 {
        acc = ((acc << 5) | values[i]) & 4095
        bits += 5
        if bits >= 8 {
            bits -= 8
            &out.push(to_u8(acc >> bits))
        }
    }
    if (acc & ((1 << bits) - 1)) != 0 -> return None
    if out.len() != 32 -> return None
    Val(out)
}

fn all_zero(bytes: [U8]) -> Bool Never! {
    diff := 0
    loop b in bytes -> diff = diff | Int.from_u8(b)
    diff == 0
}

pub fn x25519_shared(secret_key: X25519SecretKey, public_key: X25519PublicKey) -> SharedSecret CryptoError! {
    x25519(secret_key, public_key)
}

/// Generate a fresh X25519 private key for the beginner envelope helpers.
pub fn generatekey() -[Rand]> X25519SecretKey CryptoError! {
    bytes :: core.crypto.random.bytes(32) ?? return Err(CryptoError.Unavailable)
    Ok(X25519SecretKey{bytes: bytes})
}

pub fn privateencrypt(key: X25519SecretKey, bytes: [U8]) -[Rand]> Sealed CryptoError! {
    public :: x25519_public(key) ?? return Err(CryptoError.KeyRejected)
    seal([X25519PublicKey]{public}, bytes, [U8]{})
}

pub fn privatedecrypt(key: X25519SecretKey, box: Sealed) -> [U8] CryptoError! {
    open_sealed(key, box, [U8]{})
}

pub fn publicencrypt(key: X25519PublicKey, bytes: [U8]) -[Rand]> Sealed CryptoError! {
    seal([X25519PublicKey]{key}, bytes, [U8]{})
}

pub fn publicdecrypt(key: X25519SecretKey, box: Sealed) -> [U8] CryptoError! {
    open_sealed(key, box, [U8]{})
}

pub fn wrap(key: Secret, recipient: X25519PublicKey) -[Rand]> WrappedKey CryptoError! {
    if recipient.bytes.len() != 32 || key.bytes.len() > 1048576 {
        return Err(CryptoError.KeyRejected)
    }
    eph_sk :: core.crypto.random.bytes(32) ?? return Err(CryptoError.Unavailable)
    eph_pk :: x25519_public(X25519SecretKey{bytes: copy_bytes(~eph_sk)}) ?? return Err(CryptoError.KeyRejected)
    salt :: core.crypto.random.bytes(16) ?? return Err(CryptoError.Unavailable)
    shared :: x25519(X25519SecretKey{bytes: copy_bytes(~eph_sk)}, ~recipient) ?? return Err(CryptoError.KeyRejected)
    key_info := [U8]{}
    loop b in "JETW1 key".bytes() -> &key_info.push(b)
    loop b in eph_pk.bytes -> &key_info.push(b)
    loop b in recipient.bytes -> &key_info.push(b)
    kek :: hkdf_sha256(~shared.bytes, ~salt, key_info, 32) ?? return Err(CryptoError.Length)
    nonce_info := [U8]{}
    loop b in "JETW1 nonce".bytes() -> &nonce_info.push(b)
    loop b in eph_pk.bytes -> &nonce_info.push(b)
    loop b in recipient.bytes -> &nonce_info.push(b)
    nonce :: hkdf_sha256(~shared.bytes, ~salt, nonce_info, 24) ?? return Err(CryptoError.Length)
    header := [U8]{}
    loop b in "JETW".bytes() -> &header.push(b)
    &header.push(U8{1})
    &header.push(U8{1})
    &header.push(U8{0})
    &header.push(U8{0})
    loop b in recipient.bytes -> &header.push(b)
    loop b in eph_pk.bytes -> &header.push(b)
    loop b in salt -> &header.push(b)
    wrap_aad := [U8]{}
    _ :: append_be32(&header, key.bytes.len()) ?? return Err(CryptoError.Length)
    loop b in header -> &wrap_aad.push(b)
    body :: xchacha_seal(kek.bytes, nonce.bytes, wrap_aad, key.bytes)
    out := [U8]{}
    loop b in header -> &out.push(b)
    loop b in body -> &out.push(b)
    Ok(WrappedKey{bytes: out})
}

pub fn unwrap(recipient: X25519SecretKey, wrapped: WrappedKey) -> Secret CryptoError! {
    raw :: wrapped.bytes
    if raw.len() < 108 || raw.len() > 1048684 -> return Err(CryptoError.KeyRejected)
    if slice_u8(~raw, 0, 4) != "JETW".bytes() || raw[4] != (U8{1}) || raw[5] != (U8{1}) || raw[6] != (U8{0}) || raw[7] != (U8{0}) {
        return Err(CryptoError.OpenFailed)
    }
    key_len :: read_be32(~raw, 88)
    if key_len > 1048576 || raw.len() != 92 + key_len + 16 -> return Err(CryptoError.OpenFailed)
    own_public :: x25519_public(recipient) ?? return Err(CryptoError.KeyRejected)
    expected_recipient :: slice_u8(~raw, 8, 40)
    if !constant_time_equal_bytes(~own_public.bytes, ~expected_recipient) {
        return Err(CryptoError.OpenFailed)
    }
    eph :: slice_u8(~raw, 40, 72)
    salt :: slice_u8(~raw, 72, 88)
    shared :: x25519(recipient, X25519PublicKey{bytes: copy_bytes(~eph)}) ?? return Err(CryptoError.KeyRejected)
    key_info := [U8]{}
    loop b in "JETW1 key".bytes() -> &key_info.push(b)
    loop b in eph -> &key_info.push(b)
    loop b in expected_recipient -> &key_info.push(b)
    kek :: hkdf_sha256(~shared.bytes, ~salt, key_info, 32) ?? return Err(CryptoError.Length)
    nonce_info := [U8]{}
    loop b in "JETW1 nonce".bytes() -> &nonce_info.push(b)
    loop b in eph -> &nonce_info.push(b)
    loop b in expected_recipient -> &nonce_info.push(b)
    nonce :: hkdf_sha256(~shared.bytes, ~salt, nonce_info, 24) ?? return Err(CryptoError.Length)
    wrap_aad := [U8]{}
    loop b in "JETW1 wrap".bytes() -> &wrap_aad.push(b)
    loop b in slice_u8(~raw, 0, 92) -> &wrap_aad.push(b)
    body :: slice_u8(~raw, 92, raw.len())
    plain :: xchacha_open(kek.bytes, nonce.bytes, wrap_aad, body) ?? return Err(CryptoError.OpenFailed)
    if plain.len() != key_len -> return Err(CryptoError.OpenFailed)
    Ok(Secret{bytes: plain})
}

pub fn password_hash(password: Secret) -[Rand]> PasswordHash CryptoError! {
    if password.bytes.len() > 1048576 -> return Err(CryptoError.Length)
    salt :: core.crypto.random.bytes(16) ?? return Err(CryptoError.Unavailable)
    password_hash_with_salt(password, salt)
}

pub fn password_hash_with_salt(password: Secret, salt: [U8]) -> PasswordHash CryptoError! {
    if password.bytes.len() > 1048576 || salt.len() < 8 || salt.len() > 64 {
        return Err(CryptoError.Length)
    }
    dk := Secret{bytes: [U8]{}}
    #Unsafe("crypto expert: Argon2id password hashing") {
        dk = rawcrypto.argon2id(password, ~salt, 65536, 3, 1, 32) ?? return Err(CryptoError.Unavailable)
    }
    text :: "$argon2id$v=19$m=65536,t=3,p=1${phc_b64_encode(salt)}${phc_b64_encode(dk.bytes)}"
    Ok(PasswordHash{text: text})
}

pub fn password_verify(password: Secret, stored: PasswordHash) -> Bool CryptoError! {
    if password.bytes.len() > 1048576 -> return Err(CryptoError.Length)
    parts :: split_dollar(stored.text)
    if parts.len() != 6 || parts[1] != "argon2id" || parts[2] != "v=19" {
        return Err(CryptoError.KeyRejected)
    }
    params :: split_comma(parts[3])
    if params.len() != 3 -> return Err(CryptoError.KeyRejected)
    memory :: parse_prefixed_int(params[0], "m=") ?? return Err(CryptoError.KeyRejected)
    iterations :: parse_prefixed_int(params[1], "t=") ?? return Err(CryptoError.KeyRejected)
    lanes :: parse_prefixed_int(params[2], "p=") ?? return Err(CryptoError.KeyRejected)
    if memory < 8192 || memory > 262144 || iterations < 1 || iterations > 10 || lanes < 1 || lanes > 8 || memory < 8 * lanes || memory * iterations > 1048576 {
        return Err(CryptoError.Length)
    }
    salt :: phc_b64_decode(parts[4]) ?? return Err(CryptoError.KeyRejected)
    want :: phc_b64_decode(parts[5]) ?? return Err(CryptoError.KeyRejected)
    if salt.len() < 8 || salt.len() > 64 || want.len() < 16 || want.len() > 64 {
        return Err(CryptoError.Length)
    }
    got := Secret{bytes: [U8]{}}
    #Unsafe("crypto expert: Argon2id password verification") {
        got = rawcrypto.argon2id(password, salt, memory, iterations, lanes, want.len()) ?? return Err(CryptoError.Unavailable)
    }
    Ok(constant_time_equal_bytes(got.bytes, want))
}

fn parse_prefixed_int(text: String, prefix: String) -> Int? {
    raw :: text.bytes()
    wanted :: prefix.bytes()
    if raw.len() <= wanted.len() -> return None
    i := 0
    loop b in wanted {
        if raw[i] != b -> return None
        i += 1
    }
    value :: String.from_bytes(slice_u8(raw, wanted.len(), raw.len())) ?? return None
    parse_int(value)
}

fn split_comma(text: String) -> [String] Never! {
    out := [String]{}
    current := [U8]{}
    loop b in text.bytes() {
        if b == (U8{44}) {
            &out.push(String.from_bytes(current) ?? panic("invalid UTF-8 in PHC parameter"))
            current = [U8]{}
        } else { &current.push(b) }
    }
    &out.push(String.from_bytes(current) ?? panic("invalid UTF-8 in PHC parameter"))
    out
}

/// PHC string format B64: RFC 4648 standard alphabet, no `=` padding.
fn phc_b64_encode(bytes: [U8]) -> String Never! {
    alphabet :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    raw :: alphabet.bytes()
    out := [U8]{}
    i := 0
    loop i + 3 <= bytes.len() {
        n :: (Int.from_u8(bytes[i]) << 16) | (Int.from_u8(bytes[i + 1]) << 8) | Int.from_u8(bytes[i + 2])
        &out.push(raw[(n >> 18) & 63])
        &out.push(raw[(n >> 12) & 63])
        &out.push(raw[(n >> 6) & 63])
        &out.push(raw[n & 63])
        i += 3
    }
    rest :: bytes.len() - i
    if rest == 1 {
        n :: Int.from_u8(bytes[i]) << 16
        &out.push(raw[(n >> 18) & 63])
        &out.push(raw[(n >> 12) & 63])
    }
    if rest == 2 {
        n :: (Int.from_u8(bytes[i]) << 16) | (Int.from_u8(bytes[i + 1]) << 8)
        &out.push(raw[(n >> 18) & 63])
        &out.push(raw[(n >> 12) & 63])
        &out.push(raw[(n >> 6) & 63])
    }
    String.from_bytes(out) ?? panic("invalid UTF-8 in PHC encoding")
}

/// Strict inverse of `phc_b64_encode`: rejects padding, a one-character
/// tail, and non-zero trailing bits.
fn phc_b64_decode(text: String) -> [U8]? {
    raw :: text.bytes()
    out := [U8]{}
    n := 0
    bits := 0
    loop b in raw {
        value :: phc_b64_value(b) ?? return None
        n = (n << 6) | value
        bits += 6
        if bits >= 8 {
            bits -= 8
            &out.push(to_u8(n >> bits))
            n = n & ((1 << bits) - 1)
        }
    }
    if bits >= 6 || n != 0 -> return None
    Val(out)
}

fn phc_b64_value(b: U8) -> Int? {
    alphabet :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    i := 0
    loop c in alphabet.bytes() {
        if c == b -> return Val(i)
        i += 1
    }
    None
}

fn host_read_file(path: String) -[FS]> [U8] FileCryptoError! {
    core.files.read_bytes(path) ?? return Err(FileCryptoError.SourceMissing)
}

fn host_write_file(path: String, bytes: [U8]) -[FS]> Bool FileCryptoError! {
    _ :: core.files.write_bytes(path, bytes) ?? return Err(FileCryptoError.PublishFailed)
    Ok(true)
}

