}

fn blake3_raw(input: [U8]) -> [U8] {
    if input.len() <= 1024 -> return blake3_root_chunk(input)
    // tree: 1024-byte chunks
    chunks := [Int]{}  // flattened chaining values 8 words each
    i := 0
    idx := 0
    loop {
        if i >= input.len() -> break
        end := i + 1024
        if end > input.len() -> end = input.len()
        cv :: blake3_chunk(slice_u8(~input, i, end), idx, i + 1024 >= input.len() && (idx == 0 || end - i < 1024) && idx == 0)
        loop w in cv -> &chunks.push(w)
        i = end
        idx = idx + 1
    }
    // parent merge until one cv; last is root
    n :: chunks.len() /% 8
    cvs := chunks
    count := n
    loop {
        if count == 1 {
            out := [U8]{}
            loop k in 0..<8 {
                v :: cvs[k]
                &out.push(to_u8(v))
                &out.push(to_u8((v >> 8)))
                &out.push(to_u8((v >> 16)))
                &out.push(to_u8((v >> 24)))
            }
            return out
        }
        next := [Int]{}
        p := 0
        loop {
            if p + 16 <= cvs.len() {
                left := [Int]{}
                right := [Int]{}
                loop k in 0..<8 -> &left.push(cvs[p + k])
                loop k in 0..<8 -> &right.push(cvs[p + 8 + k])
                is_root := p + 16 >= cvs.len() && next.len() == 0 && (cvs.len() - p) == 16
                cv :: blake3_parent(left, right, is_root)
                loop w in cv -> &next.push(w)
                p = p + 16
            } else {
                loop k in p..<cvs.len() -> &next.push(cvs[k])
                break
            }
        }
        cvs = next
        count = cvs.len() /% 8
    }
}

fn blake3_chunk(data: [U8], chunk_index: Int, is_root: Bool) -> [Int] {
    cv := copy_ints(C_BLAKE3_IV)
    blocks := (data.len() + 63) /% 64
    if blocks == 0 -> blocks = 1
    loop i in 0..<blocks {
        start :: i * 64
        end := start + 64
        if end > data.len() -> end = data.len()
        block := [U8]{}
        loop b in slice_u8(~data, start, end) -> &block.push(b)
        loop {
            if block.len() >= 64 -> break
            &block.push(U8{0})
        }
        flags := 0
        if i == 0 -> flags = flags | 1
        if i == blocks - 1 -> flags = flags | 2
        if is_root && i == blocks - 1 -> flags = flags | 8
        cv = blake3_compress(cv, block, chunk_index, end - start, flags)
    }
    cv
}

fn blake3_root_chunk(data: [U8]) -> [U8] {
    cv :: blake3_chunk(data, 0, true)
    out := [U8]{}
    loop k in 0..<8 {
        v :: cv[k]
        &out.push(to_u8(v))
        &out.push(to_u8((v >> 8)))
        &out.push(to_u8((v >> 16)))
        &out.push(to_u8((v >> 24)))
    }
    out
}

fn blake3_parent(left: [Int], right: [Int], is_root: Bool) -> [Int] {
    block := [U8]{}
    loop w in left {
        &block.push(to_u8(w))
        &block.push(to_u8((w >> 8)))
        &block.push(to_u8((w >> 16)))
        &block.push(to_u8((w >> 24)))
    }
    loop w in right {
        &block.push(to_u8(w))
        &block.push(to_u8((w >> 8)))
        &block.push(to_u8((w >> 16)))
        &block.push(to_u8((w >> 24)))
    }
    flags := 4
    if is_root -> flags = flags | 8
    blake3_compress(copy_ints(C_BLAKE3_IV), block, 0, 64, flags)
}

fn blake3_compress(cv: [Int], block: [U8], counter: Int, block_len: Int, flags: Int) -> [Int] {
    m := [Int]{}
    loop i in 0..<16 -> &m.push(u32le(~block, i * 4))
    s := [Int]{
        cv[0],
        cv[1],
        cv[2],
        cv[3],
        cv[4],
        cv[5],
        cv[6],
        cv[7],
        C_BLAKE3_IV[0],
        C_BLAKE3_IV[1],
        C_BLAKE3_IV[2],
        C_BLAKE3_IV[3],
        wrap32(counter),
        wrap32(counter >> 32),
        wrap32(block_len),
        wrap32(flags),
    }
    loop r in 0..<7 {
        base :: r * 16
        g(&s, 0, 4, 8, 12, m[C_BLAKE3_MSG[base + 0]], m[C_BLAKE3_MSG[base + 1]])
        g(&s, 1, 5, 9, 13, m[C_BLAKE3_MSG[base + 2]], m[C_BLAKE3_MSG[base + 3]])
        g(&s, 2, 6, 10, 14, m[C_BLAKE3_MSG[base + 4]], m[C_BLAKE3_MSG[base + 5]])
        g(&s, 3, 7, 11, 15, m[C_BLAKE3_MSG[base + 6]], m[C_BLAKE3_MSG[base + 7]])
        g(&s, 0, 5, 10, 15, m[C_BLAKE3_MSG[base + 8]], m[C_BLAKE3_MSG[base + 9]])
        g(&s, 1, 6, 11, 12, m[C_BLAKE3_MSG[base + 10]], m[C_BLAKE3_MSG[base + 11]])
        g(&s, 2, 7, 8, 13, m[C_BLAKE3_MSG[base + 12]], m[C_BLAKE3_MSG[base + 13]])
        g(&s, 3, 4, 9, 14, m[C_BLAKE3_MSG[base + 14]], m[C_BLAKE3_MSG[base + 15]])
    }
    out := [Int]{}
    loop i in 0..<8 -> &out.push(wrap32(s[i] ~| s[i + 8]))
    out
}

/// BLAKE3 quarter-round G: right rotations by 16, 12, 8 and 7.
fn g(s: &[Int], a: Int, b: Int, c: Int, d: Int, mx: Int, my: Int) {
    s[a] = wrap32(s[a] + s[b] + mx)
    s[d] = rotr32(s[d] ~| s[a], 16)
    s[c] = wrap32(s[c] + s[d])
    s[b] = rotr32(s[b] ~| s[c], 12)
    s[a] = wrap32(s[a] + s[b] + my)
    s[d] = rotr32(s[d] ~| s[a], 8)
    s[c] = wrap32(s[c] + s[d])
    s[b] = rotr32(s[b] ~| s[c], 7)
}
