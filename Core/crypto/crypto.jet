fn wrap32(n: Int) -> Int Never! { n & C_MASK32 }

fn u8_int(b: U8) -> Int Never! { Int.from_u8(b) }

fn read_be32(data: [U8], offset: Int) -> Int Never! {
    if offset < 0 || offset + 4 > data.len() -> return 0
    (Int.from_u8(data[offset]) << 24) | (Int.from_u8(data[offset + 1]) << 16) | (Int.from_u8(data[offset + 2]) << 8) | Int.from_u8(data[offset + 3])
}

/// Low 8 bits as `U8`. Mask in `Int` first so the constructor never sees a
/// value outside `0..=255`.
fn to_u8(n: Int) -> U8 Never! {
    v :: n & 255
    (U8{v})
}

/// Big-endian 32-bit word from four bytes at `i`.
fn be32_word(bytes: [U8], i: Int) -> Int Never! {
    (u8_int(bytes[i]) << 24) | (u8_int(bytes[i + 1]) << 16) | (u8_int(bytes[i + 2]) << 8) | u8_int(bytes[i + 3])
}

fn rotr32(x: Int, n: Int) -> Int Never! {
    v :: wrap32(x)
    wrap32((v >> n) | (v << (32 - n)))
}

fn sha256_raw(data: [U8]) -> [U8] Never! { sha2_256(data, C_SHA256_IV) }

fn sha2_256(data: [U8], iv: [Int]) -> [U8] Never! {
    msg := copy_bytes(~data)
    bit_len :: data.len() * 8
    &msg.push(U8{0x80})
    loop msg.len() % 64 != 56 -> &msg.push(U8{0})
    loop b in be64(bit_len) -> &msg.push(b)
    state := copy_ints(iv)
    loop off in 0..<msg.len(), 64 {
        w := [Int]{}
        loop t in 0..<16 {
            i :: off + t * 4
            &w.push(be32_word(~msg, i))
        }
        loop t in 16..<64 {
            s0 :: rotr32(w[t - 15], 7) ~| rotr32(w[t - 15], 18) ~| (w[t - 15] >> 3)
            s1 :: rotr32(w[t - 2], 17) ~| rotr32(w[t - 2], 19) ~| (w[t - 2] >> 10)
            &w.push(wrap32(w[t - 16] + s0 + w[t - 7] + s1))
        }
        a := state[0]
        b := state[1]
        c := state[2]
        d := state[3]
        e := state[4]
        f := state[5]
        g := state[6]
        h := state[7]
        loop t in 0..<64 {
            s1 :: rotr32(e, 6) ~| rotr32(e, 11) ~| rotr32(e, 25)
            ch :: (e & f) ~| ((e ~| C_MASK32) & g)
            temp1 :: wrap32(h + s1 + ch + C_SHA256_K[t] + w[t])
            s0 :: rotr32(a, 2) ~| rotr32(a, 13) ~| rotr32(a, 22)
            maj :: (a & b) ~| (a & c) ~| (b & c)
            temp2 :: wrap32(s0 + maj)
            h = g
            g = f
            f = e
            e = wrap32(d + temp1)
            d = c
            c = b
            b = a
            a = wrap32(temp1 + temp2)
        }
        state[0] = wrap32(state[0] + a)
        state[1] = wrap32(state[1] + b)
        state[2] = wrap32(state[2] + c)
        state[3] = wrap32(state[3] + d)
        state[4] = wrap32(state[4] + e)
        state[5] = wrap32(state[5] + f)
        state[6] = wrap32(state[6] + g)
        state[7] = wrap32(state[7] + h)
    }
    words_to_bytes(state, 4)
}

fn sha1_raw(data: [U8]) -> [U8] {
    msg := copy_bytes(~data)
    bit_len :: data.len() * 8
    &msg.push(U8{0x80})
    loop msg.len() % 64 != 56 -> &msg.push(U8{0})
    loop b in be64(bit_len) -> &msg.push(b)
    h0 := 0x67452301
    h1 := 0xefcdab89
    h2 := 0x98badcfe
    h3 := 0x10325476
    h4 := 0xc3d2e1f0
    loop off in 0..<msg.len(), 64 {
        w := [Int]{}
        loop t in 0..<16 {
            i :: off + t * 4
            &w.push(be32_word(~msg, i))
        }
        loop t in 16..<80 -> &w.push(rotl32(w[t - 3] ~| w[t - 8] ~| w[t - 14] ~| w[t - 16], 1))
        a := h0
        b := h1
        c := h2
        d := h3
        e := h4
        loop t in 0..<80 {
            f := 0
            k := 0
            if {
                t < 20 -> {
                    f = (b & c) | ((b ~| C_MASK32) & d)
                    k = 0x5a827999
                }
                t < 40 -> {
                    f = b ~| c ~| d
                    k = 0x6ed9eba1
                }
                t < 60 -> {
                    f = (b & c) | (b & d) | (c & d)
                    k = 0x8f1bbcdc
                }
                else -> {
                    f = b ~| c ~| d
                    k = 0xca62c1d6
                }
            }
            temp :: wrap32(rotl32(a, 5) + f + e + k + w[t])
            e = d
            d = c
            c = rotl32(b, 30)
            b = a
            a = temp
        }
        h0 = wrap32(h0 + a)
        h1 = wrap32(h1 + b)
        h2 = wrap32(h2 + c)
        h3 = wrap32(h3 + d)
        h4 = wrap32(h4 + e)
    }
    words_to_bytes([Int]{h0, h1, h2, h3, h4}, 4)
}

/// SHA-512 family (FIPS 180-4) over `U64` words with the given initial hash.
/// The message schedule is one 80-word buffer reused by every block.
fn sha512_raw(data: [U8], iv: [Int]) -> [U8] Never! {
    msg := copy_bytes(~data)
    bit_len :: data.len() * 8
    &msg.push(U8{0x80})
    loop msg.len() % 128 != 112 -> &msg.push(U8{0})
    loop b in be64(0) -> &msg.push(b)
    loop b in be64(bit_len) -> &msg.push(b)
    state := [U64]{}
    loop word in iv -> &state.push(U64{word})
    k := [U64]{}
    loop word in C_SHA512_K -> &k.push(U64{word})
    w := [U64]{}
    loop _ in 0..<80 -> &w.push(U64{0})
    loop off in 0..<msg.len(), 128 -> sha512_block(&state, &w, k, msg, off)
    out := [U8]{}
    loop word in state {
        loop i in 0..<8 -> &out.push(to_u8(Int.from_u64(word >> (56 - 8 * i))))
    }
    out
}

C_SHA512_K :: [Int]{
    0x428a2f98d728ae22,
    0x7137449123ef65cd,
    0xb5c0fbcfec4d3b2f,
    0xe9b5dba58189dbbc,
    0x3956c25bf348b538,
    0x59f111f1b605d019,
