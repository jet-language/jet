/// Big-endian word at `bytes[off]`.
fn load_be64(bytes: [U8], off: Int) -> U64 Never! {
    n := U64{0}
    loop i in 0..<8 -> n = (n << 8) | U64.from_u8(bytes[off + i])
    n
}

/// One SHA-512 compression of the 128-byte block at `msg[off]` into `state`.
#Arithmetic(.Wrapping)
fn sha512_block(state: &[U64], w: &[U64], k: [U64], msg: [U8], off: Int) Never! {
    loop t in 0..<16 -> w[t] = load_be64(msg, off + t * 8)
    loop t in 16..<80 {
        s0 :: w[t - 15].rotate_right(1) ~| w[t - 15].rotate_right(8) ~| (w[t - 15] >> 7)
        s1 :: w[t - 2].rotate_right(19) ~| w[t - 2].rotate_right(61) ~| (w[t - 2] >> 6)
        w[t] = w[t - 16] + s0 + w[t - 7] + s1
    }
    a := state[0]
    b := state[1]
    c := state[2]
    d := state[3]
    e := state[4]
    f := state[5]
    g := state[6]
    h := state[7]
    loop t in 0..<80 {
        s1 :: e.rotate_right(14) ~| e.rotate_right(18) ~| e.rotate_right(41)
        ch :: (e & f) ~| ((e ~| U64.MAX) & g)
        temp1 :: h + s1 + ch + k[t] + w[t]
        s0 :: a.rotate_right(28) ~| a.rotate_right(34) ~| a.rotate_right(39)
        maj :: (a & b) ~| (a & c) ~| (b & c)
        h = g
        g = f
        f = e
        e = d + temp1
        d = c
        c = b
        b = a
        a = temp1 + s0 + maj
    }
    state[0] = state[0] + a
    state[1] = state[1] + b
    state[2] = state[2] + c
    state[3] = state[3] + d
    state[4] = state[4] + e
    state[5] = state[5] + f
    state[6] = state[6] + g
    state[7] = state[7] + h
}

fn hmac_sha256_raw(key: [U8], data: [U8]) -> [U8] Never! {
    k := [U8]{}
    loop _ in 0..<64 -> &k.push(U8{0})
    if key.len() > 64 {
        digest :: sha256_raw(key)
        loop i in 0..<32 -> k[i] = digest[i]
    } else {
        loop i in 0..<key.len() -> k[i] = key[i]
    }
    inner := [U8]{}
    outer := [U8]{}
    loop b in k -> &inner.push(to_u8(u8_int(b) ~| 0x36))
    loop b in data -> &inner.push(b)
    inner_hash :: sha256_raw(inner)
    loop b in k -> &outer.push(to_u8(u8_int(b) ~| 0x5c))
    loop b in inner_hash -> &outer.push(b)
    sha256_raw(outer)
}

fn rotl32(x: Int, n: Int) -> Int Never! {
    v :: wrap32(x)
    wrap32((v << n) | (v >> (32 - n)))
}

fn be64(n: Int) -> [U8] Never! {
    [U8]{
        to_u8((n >> 56)),
        to_u8((n >> 48)),
        to_u8((n >> 40)),
        to_u8((n >> 32)),
        to_u8((n >> 24)),
        to_u8((n >> 16)),
        to_u8((n >> 8)),
        to_u8(n),
    }
}

fn words_to_bytes(words: [Int], width: Int) -> [U8] Never! {
    out := [U8]{}
    loop w in words {
        shift := (width - 1) * 8
        loop _ in 0..<width {
            &out.push(to_u8((w >> shift)))
            shift -= 8
        }
    }
    out
}

fn copy_bytes(bytes: [U8]) -> [U8] Never! {
    out := [U8]{}
    loop b in bytes -> &out.push(b)
    out
}

fn copy_ints(xs: [Int]) -> [Int] Never! {
    out := [Int]{}
    loop n in xs -> &out.push(n)
    out
}

fn hex_encode(bytes: [U8]) -> String Never! {
    out := [U8]{}
    loop b in bytes {
        n :: u8_int(b)
        &out.push(hex_nibble(n >> 4))
        &out.push(hex_nibble(n & 15))
    }
    String.from_bytes(out) ?? panic("invalid UTF-8 in hexadecimal encoding")
}

fn hex_nibble(n: Int) -> U8 Never! {
    if n < 10 -> return to_u8(48 + n)
    to_u8(87 + n)
}

fn slice_u8(bytes: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i >= bytes.len() -> return ~out
        &out.push(bytes[i])
        i = i + 1
    }
}

fn split_dollar(text: String) -> [String] Never! {
    out := [String]{}
    cur := [U8]{}
    loop b in text.bytes() {
        if b == (U8{36}) {
            &out.push(String.from_bytes(cur) ?? panic("invalid UTF-8 in PHC field"))
            cur = [U8]{}
        } else { &cur.push(b) }
    }
    &out.push(String.from_bytes(cur) ?? panic("invalid UTF-8 in PHC field"))
    out
}

fn parse_int(text: String) -> Int? {
    n := 0
    any := false
    loop b in text.bytes() {
        d :: Int.from_u8(b)
        if d < 48 || d > 57 -> return None
        n = n * 10 + (d - 48)
        any = true
    }
    if !any -> return None
    Val(n)
}

fn hex_decode(text: String) -> [U8]? {
    raw :: text.bytes()
    if raw.len() % 2 != 0 -> return None
    out := [U8]{}
    i := 0
    loop {
        if i >= raw.len() -> return Val(~out)
        hi :: hex_val(raw[i]) ?? return None
        lo :: hex_val(raw[i + 1]) ?? return None
        &out.push(to_u8(hi * 16 + lo))
        i = i + 2
    }
}

fn hex_val(b: U8) -> Int? {
    n :: Int.from_u8(b)
    if n >= 48 && n <= 57 -> return Val(n - 48)
    if n >= 97 && n <= 102 -> return Val(n - 87)
    if n >= 65 && n <= 70 -> return Val(n - 55)
    None
}

C_KECCAK_RC :: [Int]{
    0x0000000000000001,
    0x0000000000008082,
    0x800000000000808a,
    0x8000000080008000,
    0x000000000000808b,
    0x0000000080000001,
    0x8000000080008081,
    0x8000000000008009,
    0x000000000000008a,
    0x0000000000000088,
    0x0000000080008009,
    0x000000008000000a,
    0x000000008000808b,
    0x800000000000008b,
    0x8000000000008089,
    0x8000000000008003,
    0x8000000000008002,
    0x8000000000000080,
    0x000000000000800a,
    0x800000008000000a,
    0x8000000080008081,
    0x8000000000008080,
    0x0000000080000001,
    0x8000000080008008,
}

C_KECCAK_ROT :: [Int]{
    0,
    1,
    62,
    28,
    27,
    36,
    44,
    6,
    55,
    20,
    3,
    10,
    43,
    25,
    39,
    41,
    45,
    15,
    21,
    8,
    18,
    2,
    61,
    56,
    14,
}

fn rotl64(x: Int, n: Int) -> Int {
    v :: x & C_MASK64
    r :: n & 63
    if r == 0 -> return v
    ((v << r) | (v >> (64 - r))) & C_MASK64
}

fn keccak(input: [U8], rate: Int, out_len: Int, delim: Int) -> [U8] {
    st := [Int]{}
    loop i in 0..<25 -> &st.push(0)
    i := 0
    loop {
        if i + rate > input.len() -> break
        absorb(&st, slice_u8(~input, i, i + rate), rate)
        keccak_f(&st)
        i = i + rate
    }
    last := [U8]{}
    loop {
        if i >= input.len() -> break
        &last.push(input[i])
        i = i + 1
    }
    &last.push(U8{delim})
    loop {
        if last.len() >= rate -> break
        &last.push(U8{0})
    }
    last[rate - 1] = to_u8(u8_int(last[rate - 1]) | 0x80)
    absorb(&st, last, rate)
    keccak_f(&st)
    out := [U8]{}
    loop {
        if out.len() >= out_len -> return slice_u8(out, 0, out_len)
        loop x in 0..<(rate /% 8) {
            lane :: st[x]
            loop b in 0..<8 {
                if out.len() >= out_len -> return slice_u8(out, 0, out_len)
                &out.push(to_u8((lane >> (b * 8))))
            }
        }
        keccak_f(&st)
    }
}

fn absorb(st: &[Int], block: [U8], rate: Int) {
    n :: block.len()
    loop x in 0..<(rate /% 8) {
        lane := 0
        loop b in 0..<8 {
            idx :: x * 8 + b
            if idx < n -> lane = lane | (u8_int(block[idx]) << (b * 8))
        }
        st[x] = (st[x] ~| lane) & C_MASK64
    }
}

fn keccak_f(st: &[Int]) {
    loop round in 0..<24 {
        // theta
        c := [Int]{}
        loop x in 0..<5 {
            &c.push((st[x] ~| st[x + 5] ~| st[x + 10] ~| st[x + 15] ~| st[x + 20]) & C_MASK64)
        }
        loop x in 0..<5 {
            d :: (c[(x + 4) % 5] ~| rotl64(c[(x + 1) % 5], 1)) & C_MASK64
            loop y in 0..<5 -> st[x + 5 * y] = (st[x + 5 * y] ~| d) & C_MASK64
        }
        // rho + pi
        next := [Int]{}
        loop i in 0..<25 -> &next.push(0)
        loop x in 0..<5 {
            loop y in 0..<5 {
                idx :: x + 5 * y
                nx :: y
                ny :: (2 * x + 3 * y) % 5
                next[nx + 5 * ny] = rotl64(st[idx], C_KECCAK_ROT[idx])
            }
        }
        loop i in 0..<25 -> st[i] = next[i]
        // chi
        loop y in 0..<5 {
            row := [Int]{}
            loop x in 0..<5 -> &row.push(st[x + 5 * y])
            loop x in 0..<5 {
                st[x + 5 * y] = (row[x] ~| (((row[(x + 1) % 5] ~| C_MASK64) & row[(x + 2) % 5]))) & C_MASK64
            }
        }
        st[0] = (st[0] ~| C_KECCAK_RC[round]) & C_MASK64
    }
}

/// RFC 8439 ChaCha20. `counter` is the 32-bit block counter.
fn chacha20_block(key: [U8], nonce: [U8], counter: Int) -> [U8] Never! {
    st := [Int]{
        0x61707865,
        0x3320646e,
        0x79622d32,
        0x6b206574,
        u32le(~key, 0),
        u32le(~key, 4),
        u32le(~key, 8),
        u32le(~key, 12),
        u32le(~key, 16),
        u32le(~key, 20),
        u32le(~key, 24),
        u32le(~key, 28),
        wrap32(counter),
        u32le(~nonce, 0),
        u32le(~nonce, 4),
        u32le(~nonce, 8),
    }
    w := copy_ints(st)
    loop i in 0..<10 {
        // column rounds
        qr(&w, 0, 4, 8, 12)
        qr(&w, 1, 5, 9, 13)
        qr(&w, 2, 6, 10, 14)
        qr(&w, 3, 7, 11, 15)
        // diagonal
        qr(&w, 0, 5, 10, 15)
        qr(&w, 1, 6, 11, 12)
        qr(&w, 2, 7, 8, 13)
        qr(&w, 3, 4, 9, 14)
    }
    loop i in 0..<16 -> w[i] = wrap32(w[i] + st[i])
    out := [U8]{}
    loop i in 0..<16 {
        v :: w[i]
        &out.push(to_u8(v))
        &out.push(to_u8((v >> 8)))
        &out.push(to_u8((v >> 16)))
        &out.push(to_u8((v >> 24)))
    }
    out
}

fn qr(s: &[Int], a: Int, b: Int, c: Int, d: Int) Never! {
    s[a] = wrap32(s[a] + s[b])
    s[d] = rotl32(s[d] ~| s[a], 16)
    s[c] = wrap32(s[c] + s[d])
    s[b] = rotl32(s[b] ~| s[c], 12)
    s[a] = wrap32(s[a] + s[b])
    s[d] = rotl32(s[d] ~| s[a], 8)
    s[c] = wrap32(s[c] + s[d])
    s[b] = rotl32(s[b] ~| s[c], 7)
}

fn u32le(bytes: [U8], off: Int) -> Int Never! {
    if off + 3 >= bytes.len() -> return 0
    (u8_int(bytes[off]) | (u8_int(bytes[off + 1]) << 8) | (u8_int(bytes[off + 2]) << 16) | (u8_int(bytes[off + 3]) << 24)) & C_MASK32
}

fn chacha20_xor(key: [U8], nonce: [U8], counter: Int, plain: [U8]) -> [U8] Never! {
    out := [U8]{}
    i := 0
    ctr := counter
    loop {
        if i >= plain.len() -> return ~out
        block :: chacha20_block(~key, ~nonce, ctr)
        ctr = ctr + 1
        loop j in 0..<64 {
            if i >= plain.len() -> return ~out
            &out.push(to_u8(u8_int(plain[i]) ~| u8_int(block[j])))
            i = i + 1
        }
    }
}

fn poly1305(key: [U8], data: [U8]) -> [U8] Never! {
    r := le_int(slice_u8(~key, 0, 16))
    r = r & 0x0ffffffc0ffffffc0ffffffc0fffffff
    s := le_int(slice_u8(~key, 16, 32))
    acc := 0
    poly_p :: (1 << 130) - 5
    i := 0
    loop {
        if i >= data.len() -> break
        chunk_len := 16
        if i + chunk_len > data.len() -> chunk_len = data.len() - i
        n :: le_int(slice_u8(~data, i, i + chunk_len)) + (1 << (8 * chunk_len))
        acc = ((acc + n) * r) % poly_p
        i = i + chunk_len
    }
    acc = (acc + s)
    le_bytes(acc, 16)
}

fn le_int(bytes: [U8]) -> Int Never! {
    n := 0
    loop i in 0..<bytes.len() -> n = n | (u8_int(bytes[i]) << (8 * i))
    n
}

fn le_bytes(n: Int, width: Int) -> [U8] Never! {
    out := [U8]{}
    v := n
    loop i in 0..<width {
        &out.push(to_u8(v))
        v = v >> 8
    }
    out
}

fn pad16(n: Int) -> [U8] Never! {
    out := [U8]{}
    rem :: (16 - (n % 16)) % 16
    loop i in 0..<rem -> &out.push(U8{0})
    out
}

fn chacha_poly_seal(key: [U8], nonce: [U8], aad: [U8], plain: [U8]) -> [U8] Never! {
    otk :: chacha20_block(~key, ~nonce, 0)
    ct :: chacha20_xor(~key, ~nonce, 1, plain)
    mac_data := [U8]{}
    loop b in aad -> &mac_data.push(b)
    loop b in pad16(aad.len()) -> &mac_data.push(b)
    loop b in ct -> &mac_data.push(b)
    loop b in pad16(ct.len()) -> &mac_data.push(b)
    loop b in le_bytes(aad.len(), 8) -> &mac_data.push(b)
    loop b in le_bytes(ct.len(), 8) -> &mac_data.push(b)
    auth_tag :: poly1305(otk, mac_data)
    out := [U8]{}
    loop b in ct -> &out.push(b)
    loop b in auth_tag -> &out.push(b)
    out
}

fn chacha_poly_open(key: [U8], nonce: [U8], aad: [U8], cipher: [U8]) -> [U8]? {
    if cipher.len() < 16 -> return None
    ct :: slice_u8(~cipher, 0, cipher.len() - 16)
    auth_tag :: slice_u8(~cipher, cipher.len() - 16, cipher.len())
    otk :: chacha20_block(~key, ~nonce, 0)
    mac_data := [U8]{}
    loop b in aad -> &mac_data.push(b)
    loop b in pad16(aad.len()) -> &mac_data.push(b)
    loop b in ct -> &mac_data.push(b)
    loop b in pad16(ct.len()) -> &mac_data.push(b)
    loop b in le_bytes(aad.len(), 8) -> &mac_data.push(b)
    loop b in le_bytes(ct.len(), 8) -> &mac_data.push(b)
    expect :: poly1305(otk, mac_data)
    if !constant_time_equal_bytes(auth_tag, expect) -> return None
    Val(chacha20_xor(key, nonce, 1, ct))
}

fn hchacha20(key: [U8], nonce16: [U8]) -> [U8] Never! {
    st := [Int]{
        0x61707865,
        0x3320646e,
        0x79622d32,
        0x6b206574,
        u32le(~key, 0),
        u32le(~key, 4),
        u32le(~key, 8),
        u32le(~key, 12),
        u32le(~key, 16),
        u32le(~key, 20),
        u32le(~key, 24),
        u32le(~key, 28),
        u32le(~nonce16, 0),
        u32le(~nonce16, 4),
        u32le(~nonce16, 8),
        u32le(~nonce16, 12),
    }
    loop i in 0..<10 {
        qr(&st, 0, 4, 8, 12)
        qr(&st, 1, 5, 9, 13)
        qr(&st, 2, 6, 10, 14)
        qr(&st, 3, 7, 11, 15)
        qr(&st, 0, 5, 10, 15)
        qr(&st, 1, 6, 11, 12)
        qr(&st, 2, 7, 8, 13)
        qr(&st, 3, 4, 9, 14)
    }
    out := [U8]{}
    loop k in 0..<4 -> hchacha_word(&out, st[k])
    loop k in 12..<16 -> hchacha_word(&out, st[k])
    out
}

fn hchacha_word(out: &[U8], v: Int) Never! {
    &out.push(to_u8(v))
    &out.push(to_u8((v >> 8)))
    &out.push(to_u8((v >> 16)))
    &out.push(to_u8((v >> 24)))
}

fn xchacha_seal(key: [U8], nonce24: [U8], aad: [U8], plain: [U8]) -> [U8] Never! {
    sub :: hchacha20(key, slice_u8(~nonce24, 0, 16))
    n := [U8]{0, 0, 0, 0}
    loop b in slice_u8(~nonce24, 16, 24) -> &n.push(b)
    chacha_poly_seal(sub, n, aad, plain)
}

fn xchacha_open(key: [U8], nonce24: [U8], aad: [U8], cipher: [U8]) -> [U8]? {
    sub :: hchacha20(key, slice_u8(~nonce24, 0, 16))
    n := [U8]{0, 0, 0, 0}
    loop b in slice_u8(~nonce24, 16, 24) -> &n.push(b)
    chacha_poly_open(sub, n, aad, cipher)
}

C_P25519 :: 57896044618658097711785492504343953926634992332820282019728792003956564819949

fn x25519_scalarmult(sk: [U8], u: [U8]) -> [U8] Never! {
    k := copy_bytes(sk)
    if k.len() != 32 || u.len() != 32 -> panic("invalid X25519 input")
    k[0] = to_u8(u8_int(k[0]) & 248)
    k[31] = to_u8((u8_int(k[31]) & 127) | 64)
    public := copy_bytes(u)
    public[31] = to_u8(u8_int(public[31]) & 127)
    x1 := le_int(public) % C_P25519
    x2 := 1
    z2 := 0
    x3 := x1
    z3 := 1
    swap := 0
    t := 254
    loop {
        if t < 0 -> break
        kt :: (Int.from_u8(k[t /% 8]) >> (t %% 8)) & 1
        if (swap ~| kt) == 1 {
            tmp := x2
            x2 = x3
            x3 = tmp
            tmpz := z2
            z2 = z3
            z3 = tmpz
        }
        swap = kt
        a :: (x2 + z2) % C_P25519
        aa :: (a * a) % C_P25519
        b := (x2 - z2) % C_P25519
        if b < 0 -> b = b + C_P25519
        bb :: (b * b) % C_P25519
        e := (aa - bb) % C_P25519
        if e < 0 -> e = e + C_P25519
        c :: (x3 + z3) % C_P25519
        d := (x3 - z3) % C_P25519
        if d < 0 -> d = d + C_P25519
        da :: (d * a) % C_P25519
        cb :: (c * b) % C_P25519
        x3 = ((da + cb) * (da + cb)) % C_P25519
        z3 = (x1 * (((da - cb) % C_P25519 + C_P25519) % C_P25519) * (((da - cb) % C_P25519 + C_P25519) % C_P25519)) % C_P25519
        x2 = (aa * bb) % C_P25519
        z2 = (e * (aa + (121665 * e) % C_P25519)) % C_P25519
        t = t - 1
    }
    if swap == 1 {
        tmp := x2
        x2 = x3
        x3 = tmp
        tmpz := z2
        z2 = z3
        z3 = tmpz
    }
    inv :: mod_pow(z2, C_P25519 - 2, C_P25519)
    out :: (x2 * inv) % C_P25519
    le_bytes(out, 32)
}

fn mod_pow(base: Int, exp: Int, m: Int) -> Int Never! {
    r := 1
    b := base % m
    e := exp
    loop {
        if e == 0 -> return r
        if e & 1 == 1 -> r = (r * b) % m
        b = (b * b) % m
        e = e >> 1
    }
}

// Ed25519 (RFC 8032). Twisted Edwards, SHA-512.
C_ED_P :: 57896044618658097711785492504343953926634992332820282019728792003956564819949

C_ED_L :: 7237005577332262213973186563042994240857116359379907606001950938285454250989

C_ED_D :: 37095705934669439343138083508754565189542113879843219016388785533085940283555

C_ED_BX :: 15112221349535400772501151409588531511454012693041857206046113283949847762202

C_ED_BY :: 46316835694926478169428394003475163141307993866256225615783033603165251855960

/// RFC 8032 5.1.5: the encoded public key A = [s]B for a 32-byte seed.
fn ed25519_public_raw(seed: [U8]) -> [U8] Never! {
    h :: sha512_raw(seed, C_SHA512_IV)
    a :: clamp_scalar(le_int(slice_u8(~h, 0, 32)))
    point_a :: ed_scalarmult(a, C_ED_BX, C_ED_BY)
    ed_encode(point_a.x, point_a.y)
}

fn ed25519_sign_raw(seed: [U8], msg: [U8]) -> [U8] Never! {
    h :: sha512_raw(seed, C_SHA512_IV)
    a := clamp_scalar(le_int(slice_u8(~h, 0, 32)))
    prefix :: slice_u8(~h, 32, 64)
    point_a :: ed_scalarmult(a, C_ED_BX, C_ED_BY)
    r_mat := [U8]{}
    loop b in prefix -> &r_mat.push(b)
    loop b in msg -> &r_mat.push(b)
    r :: le_int(sha512_raw(r_mat, C_SHA512_IV)) % C_ED_L
    point_r :: ed_scalarmult(r, C_ED_BX, C_ED_BY)
    encoded_r :: ed_encode(point_r.x, point_r.y)
    encoded_a :: ed_encode(point_a.x, point_a.y)
    k_mat := [U8]{}
    loop b in encoded_r -> &k_mat.push(b)
    loop b in encoded_a -> &k_mat.push(b)
    loop b in msg -> &k_mat.push(b)
    k :: le_int(sha512_raw(k_mat, C_SHA512_IV)) % C_ED_L
    s :: (r + k * a) % C_ED_L
    out := [U8]{}
    loop b in encoded_r -> &out.push(b)
    loop b in le_bytes(s, 32) -> &out.push(b)
    out
}

fn ed25519_verify_raw(pk: [U8], msg: [U8], sig: [U8]) -> Bool Never! {
    if pk.len() != 32 || sig.len() != 64 -> return false
    point_a :: ed_decode(~pk) ?? return false
    encoded_r :: slice_u8(~sig, 0, 32)
    s :: le_int(slice_u8(~sig, 32, 64))
    if s >= C_ED_L -> return false
    point_r :: ed_decode(~encoded_r) ?? return false
    k_mat := [U8]{}
    loop b in encoded_r -> &k_mat.push(b)
    loop b in pk -> &k_mat.push(b)
    loop b in msg -> &k_mat.push(b)
    k :: le_int(sha512_raw(k_mat, C_SHA512_IV)) % C_ED_L
    sb :: ed_scalarmult(s, C_ED_BX, C_ED_BY)
    k_point_a :: ed_scalarmult(k, point_a.x, point_a.y)
    r_plus_k_a :: ed_add(point_r.x, point_r.y, k_point_a.x, k_point_a.y)
    sb.x == r_plus_k_a.x && sb.y == r_plus_k_a.y
}

pub struct EdPoint {
    pub x: Int
    pub y: Int
}

/// Double-and-add in extended twisted Edwards coordinates `[X, Y, Z, T]`
/// (one field inversion at the end instead of two per addition).
fn ed_scalarmult(s: Int, x: Int, y: Int) -> EdPoint Never! {
    p :: C_ED_P
    acc := [Int]{0, 1, 1, 0}
    addend := [Int]{x % p, y % p, 1, (x * y) % p}
    bit := s
    loop bit > 0 {
        if bit & 1 == 1 -> acc = ed_ext_add(acc, addend)
        addend = ed_ext_add(addend, addend)
        bit = bit >> 1
    }
    zinv :: mod_pow(acc[2], p - 2, p)
    EdPoint{x: (acc[0] * zinv) % p, y: (acc[1] * zinv) % p}
}

/// Unified extended-coordinate addition for a = -1 (Hisil et al. 2008,
/// add-2008-hwcd-3); complete because d is not a square.
fn ed_ext_add(a: [Int], b: [Int]) -> [Int] Never! {
    p :: C_ED_P
    ea :: ((a[1] - a[0] + p) * (b[1] - b[0] + p)) % p
    eb :: ((a[1] + a[0]) * (b[1] + b[0])) % p
    ec :: ((2 * C_ED_D * a[3]) % p * b[3]) % p
    ed :: (2 * a[2] * b[2]) % p
    e :: (eb - ea + p) % p
    f :: (ed - ec + p) % p
    g :: (ed + ec) % p
    h :: (eb + ea) % p
    [Int]{(e * f) % p, (g * h) % p, (f * g) % p, (e * h) % p}
}

fn ed_add(x1: Int, y1: Int, x2: Int, y2: Int) -> EdPoint Never! {
    p :: C_ED_P
    x1x2 :: (x1 * x2) % p
    y1y2 :: (y1 * y2) % p
    x1y2 :: (x1 * y2) % p
    y1x2 :: (y1 * x2) % p
    dxxyy :: (C_ED_D * x1x2 % p * y1y2) % p
    invx :: mod_pow((1 + dxxyy) % p, p - 2, p)
    invy :: mod_pow((1 - dxxyy + p) % p, p - 2, p)
    x3 :: ((x1y2 + y1x2) % p * invx) % p
    y3 :: ((y1y2 + x1x2) % p * invy) % p
    {x: x3, y: y3}
}

fn ed_encode(x: Int, y: Int) -> [U8] Never! {
    out := le_bytes(y, 32)
    if (x & 1) == 1 -> out[31] = to_u8(u8_int(out[31]) | 128)
    out
}

fn ed_decode(bytes: [U8]) -> EdPoint? {
    yb := copy_bytes(bytes)
    sign :: (Int.from_u8(yb[31]) >> 7) & 1
    yb[31] = to_u8(u8_int(yb[31]) & 127)
    y :: le_int(yb)
    if y >= C_ED_P -> return None
    y2 :: (y * y) % C_ED_P
    u :: (y2 - 1 + C_ED_P) % C_ED_P
    v :: ((C_ED_D * y2) % C_ED_P + 1) % C_ED_P
    x := mod_pow((u * mod_pow(v, C_ED_P - 2, C_ED_P)) % C_ED_P, (C_ED_P + 3) /% 8, C_ED_P)
    if (v * x % C_ED_P * x % C_ED_P) != u {
        sqrt_minus_one :: mod_pow(2, (C_ED_P - 1) /% 4, C_ED_P)
        x = (x * sqrt_minus_one) % C_ED_P
        if (v * x % C_ED_P * x % C_ED_P) != u -> return None
    }
    if (x & 1) != sign -> x = (C_ED_P - x) % C_ED_P
    Val(EdPoint{x: x, y: y})
}

fn clamp_scalar(n: Int) -> Int Never! {
    b := le_bytes(n, 32)
    b[0] = to_u8(u8_int(b[0]) & 248)
    b[31] = to_u8((u8_int(b[31]) & 63) | 64)
    le_int(b)
}

C_BLAKE3_IV :: [Int]{0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19}

