fn rotr64(x: Int, n: Int) -> Int {
    v :: wrap64(x)
    r :: n & 63
    if r == 0 -> return v
    wrap64((v >> r) | (v << (64 - r)))
}

fn sha2_512(data: [U8], iv: [Int]) -> [U8] {
    msg := copy_bytes(data)
    bit_len :: data.len() * 8
    msg.push(U8{0x80})
    loop msg.len() % 128 != 112 -> msg.push(U8{0})
    loop b in be64(0) -> msg.push(b)
    loop b in be64(bit_len) -> msg.push(b)
    state := copy_ints(iv)
    loop off in 0..<msg.len(), 128 {
        w := [Int]{}
        loop t in 0..<16 {
            i :: off + t * 8
            word := 0
            loop k in 0..<8 -> word = (word << 8) | u8_int(msg[i + k])
            w.push(wrap64(word))
        }
        loop t in 16..<80 {
            s0 :: rotr64(w[t - 15], 1) ~| rotr64(w[t - 15], 8) ~| (w[t - 15] >> 7)
            s1 :: rotr64(w[t - 2], 19) ~| rotr64(w[t - 2], 61) ~| (w[t - 2] >> 6)
            w.push(wrap64(w[t - 16] + s0 + w[t - 7] + s1))
        }
        a := state[0]
        b := state[1]
        c := state[2]
        d := state[3]
        e := state[4]
        f := state[5]
        g := state[6]
        h := state[7]
        loop t in 0..<80 {
            s1 :: rotr64(e, 14) ~| rotr64(e, 18) ~| rotr64(e, 41)
            ch :: (e & f) ~| ((e ~| @c_mask64) & g)
            temp1 :: wrap64(h + s1 + ch + @c_sha512_k[t] + w[t])
            s0 :: rotr64(a, 28) ~| rotr64(a, 34) ~| rotr64(a, 39)
            maj :: (a & b) ~| (a & c) ~| (b & c)
            temp2 :: wrap64(s0 + maj)
            h = g
            g = f
            f = e
            e = wrap64(d + temp1)
            d = c
            c = b
            b = a
            a = wrap64(temp1 + temp2)
        }
        state[0] = wrap64(state[0] + a)
        state[1] = wrap64(state[1] + b)
        state[2] = wrap64(state[2] + c)
        state[3] = wrap64(state[3] + d)
        state[4] = wrap64(state[4] + e)
        state[5] = wrap64(state[5] + f)
        state[6] = wrap64(state[6] + g)
        state[7] = wrap64(state[7] + h)
    }
    words_to_bytes(state, 8)
}

fn hmac_sha256_raw(key: [U8], data: [U8]) -> [U8] {
    k := [U8]{}
    loop _ in 0..<64 -> k.push(U8{0})
    if key.len() > 64 {
        digest :: sha256_raw(key)
        loop i in 0..<32 -> k[i] = digest[i]
    } else {
        loop i in 0..<key.len() -> k[i] = key[i]
    }
    inner := [U8]{}
    outer := [U8]{}
    loop b in k -> inner.push(U8{b ~| 0x36})
    loop b in data -> inner.push(b)
    inner_hash :: sha256_raw(inner)
    loop b in k -> outer.push(U8{b ~| 0x5c})
    loop b in inner_hash -> outer.push(b)
    sha256_raw(outer)
}

fn rotl32(x: Int, n: Int) -> Int {
    v :: wrap32(x)
    wrap32((v << n) | (v >> (32 - n)))
}

fn be64(n: Int) -> [U8] {
    [U8]{
        to_u8((n >> 56)),
        to_u8((n >> 48)),
        to_u8((n >> 40)),
        to_u8((n >> 32)),
        to_u8((n >> 24)),
        to_u8((n >> 16)),
        to_u8((n >> 8)),
        to_u8(n),
    }
}

fn words_to_bytes(words: [Int], width: Int) -> [U8] {
    out := [U8]{}
    loop w in words {
        shift := (width - 1) * 8
        loop _ in 0..<width {
            out.push(to_u8((w >> shift)))
            shift -= 8
        }
    }
    out
}

fn copy_bytes(bytes: [U8]) -> [U8] {
    out := [U8]{}
    loop b in bytes -> out.push(b)
    out
}

fn copy_ints(xs: [Int]) -> [Int] {
    out := [Int]{}
    loop n in xs -> out.push(n)
    out
}

fn hex_encode(bytes: [U8]) -> String {
    out := [U8]{}
    loop b in bytes {
        n :: u8_int(b)
        out.push(hex_nibble(n >> 4))
        out.push(hex_nibble(n & 15))
    }
    String.from_bytes(out) ?? ""
}

fn hex_nibble(n: Int) -> U8 {
    if n < 10 -> return (U8{48 + n})
    (U8{87 + n})
}

fn slice_u8(bytes: [U8], start: Int, end: Int) -> [U8] {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i >= bytes.len() -> return out
        out.push(bytes[i])
        i = i + 1
    }
}

fn split_dollar(text: String) -> [String] {
    out := [String]{}
    cur := [U8]{}
    loop b in text.bytes() {
        if b == (U8{36}) {
            out.push(String.from_bytes(cur) ?? "")
            cur = [U8]{}
        } else { cur.push(b) }
    }
    out.push(String.from_bytes(cur) ?? "")
    out
}

fn parse_int(text: String) -> ?Int {
    n := 0
    any := false
    loop b in text.bytes() {
        d :: b
        if d < 48 || d > 57 -> return None
        n = n * 10 + (d - 48)
        any = true
    }
    if !any -> return None
    Val(n)
}

fn hex_decode(text: String) -> ?[U8] {
    raw :: text.bytes()
    if raw.len() % 2 != 0 -> return None
    out := [U8]{}
    i := 0
    loop {
        if i >= raw.len() -> return Val(out)
        hi :: hex_val(raw[i]) ?? return None
        lo :: hex_val(raw[i + 1]) ?? return None
        out.push(U8{hi * 16 + lo})
        i = i + 2
    }
}

fn hex_val(b: U8) -> ?Int {
    n :: b
    if n >= 48 && n <= 57 -> return Val(n - 48)
    if n >= 97 && n <= 102 -> return Val(n - 87)
    if n >= 65 && n <= 70 -> return Val(n - 55)
    None
}

