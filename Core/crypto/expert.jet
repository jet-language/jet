// core.crypto.expert - raw-byte cryptography behind `#Unsafe`.
//
// Every function here is an interoperability control, not a beginner API.
// Callers own nonce uniqueness, key length, and algorithm choice. The typed
// `core.crypto` envelopes remain the default door.
//
// AES-256-GCM, XChaCha20-Poly1305, Ed25519, X25519, and bounded Argon2id
// are Jet. The OS CSPRNG stays a host cell.
use core
use core.crypto.[CryptoError, FileCryptoError, Secret, SharedSecret, Signature, SigningKey, X25519PublicKey, X25519SecretKey, constant_time_equal_bytes]
use core.crypto as crypto
use __core_crypto_ct as ct

C_AES_RCON :: [U8]{1, 2, 4, 8, 16, 32, 64, 128, 27, 54}

C_MASK32 :: 4294967295

/// BLAKE2b initialization vector (RFC 7693 2.6).
C_BLAKE2B_IV :: [Int]{
    0x6a09e667f3bcc908,
    0xbb67ae8584caa73b,
    0x3c6ef372fe94f82b,
    0xa54ff53a5f1d36f1,
    0x510e527fade682d1,
    0x9b05688c2b3e6c1f,
    0x1f83d9abfb41bd6b,
    0x5be0cd19137e2179,
}

fn wrap32(n: Int) -> Int Never! { n.bit_and(C_MASK32) }

fn rotl32(x: Int, n: Int) -> Int Never! {
    v :: (x).bit_and(C_MASK32)
    r :: (n).bit_and(31)
    if r == 0 -> return v
    ((((v << r)).bit_or((v >> (32 - r))))).bit_and(C_MASK32)
}

fn to_u8(n: Int) -> U8 Never! {
    v :: (n).bit_and(255)
    U8{v}
}

fn copy_bytes(bytes: [U8]) -> [U8] Never! {
    out := [U8]{}
    loop b in bytes -> &out.push(b)
    out
}

fn copy_ints(values: [Int]) -> [Int] Never! {
    out := [Int]{}
    loop value in values -> &out.push(value)
    out
}

fn slice_u8(bytes: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i >= bytes.len() -> return out
        &out.push(bytes[i])
        i = i + 1
    }
}

fn le_bytes(n: Int, width: Int) -> [U8] Never! {
    out := [U8]{}
    v := n
    loop i in 0..<width {
        &out.push(to_u8(v))
        v = v >> 8
    }
    out
}

fn x25519_scalarmult(sk: [U8], u: [U8]) -> [U8] Never! { ct.x25519(sk, u) }

fn ed25519_sign_raw(seed: [U8], msg: [U8]) -> [U8] Never! { ct.ed_sign(seed, msg) }

fn ed25519_verify_raw(pk: [U8], msg: [U8], sig: [U8]) -> Bool Never! { ct.ed_verify(pk, msg, sig) }


fn chacha20_block(key: [U8], nonce: [U8], counter: Int) -> [U8] Never! {
    st := [Int]{
        0x61707865,
        0x3320646e,
        0x79622d32,
        0x6b206574,
        u32le(key, 0),
        u32le(key, 4),
        u32le(key, 8),
        u32le(key, 12),
        u32le(key, 16),
        u32le(key, 20),
        u32le(key, 24),
        u32le(key, 28),
        wrap32(counter),
        u32le(nonce, 0),
        u32le(nonce, 4),
        u32le(nonce, 8),
    }
    w := copy_ints(st)
    loop _ in 0..<10 {
        qr(&w, 0, 4, 8, 12)
        qr(&w, 1, 5, 9, 13)
        qr(&w, 2, 6, 10, 14)
        qr(&w, 3, 7, 11, 15)
        qr(&w, 0, 5, 10, 15)
        qr(&w, 1, 6, 11, 12)
        qr(&w, 2, 7, 8, 13)
        qr(&w, 3, 4, 9, 14)
    }
    loop i in 0..<16 -> w[i] = wrap32(w[i] + st[i])
    out := [U8]{}
    loop i in 0..<16 {
        v :: w[i]
        &out.push(to_u8(v))
        &out.push(to_u8(v >> 8))
        &out.push(to_u8(v >> 16))
        &out.push(to_u8(v >> 24))
    }
    out
}

fn qr(s: &[Int], a: Int, b: Int, c: Int, d: Int) Never! {
    s[a] = wrap32(s[a] + s[b])
    s[d] = rotl32((s[d]).bit_xor(s[a]), 16)
    s[c] = wrap32(s[c] + s[d])
    s[b] = rotl32((s[b]).bit_xor(s[c]), 12)
    s[a] = wrap32(s[a] + s[b])
    s[d] = rotl32((s[d]).bit_xor(s[a]), 8)
    s[c] = wrap32(s[c] + s[d])
    s[b] = rotl32((s[b]).bit_xor(s[c]), 7)
}

fn u32le(bytes: [U8], off: Int) -> Int Never! {
    if off + 3 >= bytes.len() -> return 0
    (((((u8_int(bytes[off])).bit_or((u8_int(bytes[off + 1]) << 8))).bit_or((u8_int(bytes[off + 2]) << 16))).bit_or((u8_int(bytes[off + 3]) << 24)))).bit_and(C_MASK32)
}

fn chacha20_xor(key: [U8], nonce: [U8], counter: Int, plain: [U8]) -> [U8] Never! {
    out := [U8]{}
    i := 0
    ctr := counter
    loop {
        if i >= plain.len() -> return out
        block :: chacha20_block(key, nonce, ctr)
        ctr = ctr + 1
        loop j in 0..<64 {
            if i >= plain.len() -> return out
            &out.push(to_u8(u8_int(plain[i]).bit_xor(u8_int(block[j]))))
            i = i + 1
        }
    }
}

fn poly1305(key: [U8], data: [U8]) -> [U8] Never! { ct.poly1305(key, data) }

fn pad16(n: Int) -> [U8] Never! {
    out := [U8]{}
    rem :: (16 - (n % 16)) % 16
    loop _ in 0..<rem -> &out.push(U8{0})
    out
}

fn chacha_poly_seal(key: [U8], nonce: [U8], aad: [U8], plain: [U8]) -> [U8] Never! {
    otk :: chacha20_block(key, nonce, 0)
    ciphertext :: chacha20_xor(key, nonce, 1, plain)
    mac_data := [U8]{}
    loop b in aad -> &mac_data.push(b)
    loop b in pad16(aad.len()) -> &mac_data.push(b)
    loop b in ciphertext -> &mac_data.push(b)
    loop b in pad16(ciphertext.len()) -> &mac_data.push(b)
    loop b in le_bytes(aad.len(), 8) -> &mac_data.push(b)
    loop b in le_bytes(ciphertext.len(), 8) -> &mac_data.push(b)
    auth_tag :: poly1305(otk, mac_data)
    out := [U8]{}
    loop b in ciphertext -> &out.push(b)
    loop b in auth_tag -> &out.push(b)
    out
}

fn chacha_poly_open(key: [U8], nonce: [U8], aad: [U8], cipher: [U8]) -> [U8]? {
    if cipher.len() < 16 -> return None
    ciphertext :: slice_u8(cipher, 0, cipher.len() - 16)
    auth_tag :: slice_u8(cipher, cipher.len() - 16, cipher.len())
    otk :: chacha20_block(key, nonce, 0)
    mac_data := [U8]{}
    loop b in aad -> &mac_data.push(b)
    loop b in pad16(aad.len()) -> &mac_data.push(b)
    loop b in ciphertext -> &mac_data.push(b)
    loop b in pad16(ciphertext.len()) -> &mac_data.push(b)
    loop b in le_bytes(aad.len(), 8) -> &mac_data.push(b)
    loop b in le_bytes(ciphertext.len(), 8) -> &mac_data.push(b)
    expect :: poly1305(otk, mac_data)
    equal :: constant_time_equal_bytes(auth_tag, expect) ?? return None
    if equal -> return Val(chacha20_xor(key, nonce, 1, ciphertext))
    None
}


fn hchacha20(key: [U8], nonce16: [U8]) -> [U8] Never! {
    st := [Int]{
        0x61707865,
        0x3320646e,
        0x79622d32,
        0x6b206574,
        u32le(key, 0),
        u32le(key, 4),
        u32le(key, 8),
        u32le(key, 12),
        u32le(key, 16),
        u32le(key, 20),
        u32le(key, 24),
        u32le(key, 28),
        u32le(nonce16, 0),
        u32le(nonce16, 4),
        u32le(nonce16, 8),
        u32le(nonce16, 12),
    }
    loop _ in 0..<10 {
        qr(&st, 0, 4, 8, 12)
        qr(&st, 1, 5, 9, 13)
        qr(&st, 2, 6, 10, 14)
        qr(&st, 3, 7, 11, 15)
        qr(&st, 0, 5, 10, 15)
        qr(&st, 1, 6, 11, 12)
        qr(&st, 2, 7, 8, 13)
        qr(&st, 3, 4, 9, 14)
    }
    out := [U8]{}
    loop k in 0..<4 -> hchacha_word(&out, st[k])
    loop k in 12..<16 -> hchacha_word(&out, st[k])
    out
}

fn hchacha_word(out: &[U8], value: Int) Never! {
    &out.push(to_u8(value))
    &out.push(to_u8(value >> 8))
    &out.push(to_u8(value >> 16))
    &out.push(to_u8(value >> 24))
}

fn xchacha_seal(key: [U8], nonce24: [U8], aad: [U8], plain: [U8]) -> [U8] Never! {
    sub :: hchacha20(key, slice_u8(nonce24, 0, 16))
    nonce := [U8]{0, 0, 0, 0}
    loop b in slice_u8(nonce24, 16, 24) -> &nonce.push(b)
    chacha_poly_seal(sub, nonce, aad, plain)
}

fn xchacha_open(key: [U8], nonce24: [U8], aad: [U8], cipher: [U8]) -> [U8]? {
    sub :: hchacha20(key, slice_u8(nonce24, 0, 16))
    nonce := [U8]{0, 0, 0, 0}
    loop b in slice_u8(nonce24, 16, 24) -> &nonce.push(b)
    chacha_poly_open(sub, nonce, aad, cipher)
}

fn aes256gcm_seal(key: [U8], nonce: [U8], plain: [U8], aad: [U8]) -> [U8] CryptoError! {
    if key.len() != 32 || nonce.len() != 12 -> return Err(.Length)
    if plain.len() > 1073741824 || aad.len() > 16777216 -> return Err(.Length)
    Ok(aes_gcm_seal(key, nonce, aad, plain))
}

fn aes256gcm_open(key: [U8], nonce: [U8], cipher: [U8], aad: [U8]) -> [U8] CryptoError! {
    if key.len() != 32 || nonce.len() != 12 || cipher.len() < 16 || cipher.len() > 1073741840 {
        return Err(.Length)
    }
    if aad.len() > 16777216 -> return Err(.Length)
    p :: aes_gcm_open(key, nonce, aad, cipher) ?? return Err(.OpenFailed)
    Ok(p)
}

fn xchacha20poly1305_seal(key: [U8], nonce: [U8], plain: [U8], aad: [U8]) -> [U8] CryptoError! {
    if key.len() != 32 || nonce.len() != 24 -> return Err(.Length)
    if plain.len() > 1073741824 || aad.len() > 16777216 -> return Err(.Length)
    Ok(xchacha_seal(key, nonce, aad, plain))
}

fn xchacha20poly1305_open(key: [U8], nonce: [U8], cipher: [U8], aad: [U8]) -> [U8] CryptoError! {
    if key.len() != 32 || nonce.len() != 24 || cipher.len() < 16 || cipher.len() > 1073741840 {
        return Err(.Length)
    }
    if aad.len() > 16777216 -> return Err(.Length)
    p :: xchacha_open(key, nonce, aad, cipher) ?? return Err(.OpenFailed)
    Ok(p)
}

/// RFC 9106 Argon2id with bounded portable memory and one to eight lanes.
fn argon2id(password: Secret, salt: [U8], memory_kib: Int, iterations: Int, lanes: Int, output_len: Int) -> Secret CryptoError! {
    if password.bytes.len() > 1048576 || salt.len() < 8 || salt.len() > 64 || memory_kib < 8192 || memory_kib > 262144 || iterations < 1 || iterations > 10 || lanes < 1 || lanes > 8 || output_len < 16 || output_len > 64 {
        return Err(.Length)
    }
    if memory_kib < 8 * lanes || memory_kib * iterations > 1048576 -> return Err(.Length)
    memory_blocks :: (memory_kib /% (4 * lanes)) * (4 * lanes)
    if memory_blocks < 8 * lanes -> return Err(.Length)
    Ok(Secret{bytes: argon2id_raw(password.bytes, salt, memory_kib, iterations, lanes, output_len)})
}

fn ed25519_sign(secret: [U8], bytes: [U8]) -> Signature CryptoError! {
    if secret.len() != 32 -> return Err(.KeyRejected)
    Ok(Signature{bytes: ed25519_sign_raw(secret, bytes)})
}

fn ed25519_verify_strict(public: [U8], message: [U8], signature: [U8]) -> Bool CryptoError! {
    if public.len() != 32 || signature.len() != 64 || message.len() > 1073741824 {
        return Err(.Length)
    }
    result :: ct.ed_verify_strict(public, message, signature)
    if result < 0 -> return Err(.KeyRejected)
    Ok(result == 1)
}

fn hkdf_sha256_raw(ikm: [U8], salt: [U8], info: [U8], len: Int) -> Secret CryptoError! {
    if len < 0 || len > 8160 -> return Err(.Length)
    prk := hmac_sha256_local(salt, ikm)
    out := [U8]{}
    previous := [U8]{}
    counter := 1
    loop out.len() < len {
        material := [U8]{}
        loop b in previous -> &material.push(b)
        loop b in info -> &material.push(b)
        &material.push(to_u8(counter))
        previous = hmac_sha256_local(prk, material)
        loop b in previous {
            if out.len() >= len -> break
            &out.push(b)
        }
        counter = counter + 1
    }
    Ok(Secret{bytes: out})
}

fn hmac_sha256_local(key: [U8], data: [U8]) -> [U8] Never! { crypto.hmac_sha256(key, data) }

fn x25519_raw(secret_bytes: [U8], public_bytes: [U8]) -> Secret CryptoError! {
    if secret_bytes.len() != 32 || public_bytes.len() != 32 -> return Err(.KeyRejected)
    shared :: x25519_scalarmult(secret_bytes, public_bytes)
    if all_zero(shared) -> return Err(.KeyRejected)
    Ok(Secret{bytes: shared})
}

fn all_zero(bytes: [U8]) -> Bool Never! {
    diff := U8{0}
    loop b in bytes -> diff = diff.bit_or(b)
    diff == U8{0}
}

fn secret_bytes(secret: Secret) -> [U8] Never! { secret.bytes.copy() }

fn shared_secret_bytes(secret: SharedSecret) -> [U8] Never! { secret.bytes.copy() }

fn signing_key_bytes(key: SigningKey) -> [U8] Never! { key.bytes.copy() }

fn x25519_secret_bytes(key: X25519SecretKey) -> [U8] Never! { key.bytes.copy() }

fn open_v1_body(key: [U8], mode: U8, nonce: [U8], body: [U8]) -> [U8]? {
    if mode == (U8{1}) -> return chacha_poly_open(key, nonce, [U8]{}, body)
    if mode == (U8{2}) -> return aes_gcm_open(key, nonce, [U8]{}, body)
    None
}

fn open_v1(key: [U8], envelope: [U8]) -> [U8] CryptoError! {
    if key.len() != 32 || envelope.len() < 34 || envelope.len() > 1073741858 {
        return Err(.OpenFailed)
    }
    if slice_u8(envelope, 0, 4) != "JETC".bytes() || envelope[4] != (U8{1}) {
        return Err(.OpenFailed)
    }
    nonce :: slice_u8(envelope, 6, 18)
    body :: slice_u8(envelope, 18, envelope.len())
    opened :: open_v1_body(key, envelope[5], nonce, body)
    opened_bytes :: opened ?? return Err(.OpenFailed)
    Ok(opened_bytes)
}

fn migrate_v1(key: [U8], source: Path, recipients: [X25519PublicKey], destination: Path) -[FS, Rand]> Bool FileCryptoError! {
    crypto.__migrate_v1(key, source, recipients, destination)
}


fn aes_gcm_seal(key: [U8], nonce: [U8], aad: [U8], plain: [U8]) -> [U8] Never! {
    work := aes_workspace()
    state := zeros16()
    rk := aes256_expand(key, &state, &work)
    h := zeros16()
    aes256_encrypt_block(rk, h, &state, &work)
    loop i in 0..<16 -> h[i] = state[i]
    j0 := zeros16()
    loop i in 0..<12 -> j0[i] = nonce[i]
    j0[15] = U8{1}
    mask := zeros16()
    aes256_encrypt_block(rk, j0, &state, &work)
    loop i in 0..<16 -> mask[i] = state[i]
    out := aes_ctr(rk, j0, plain, plain.len(), &state, &work)
    auth_tag := gcm_tag(h, mask, aad, out, out.len())
    loop b in auth_tag -> &out.push(b)
    crypto.__zeroize(&rk)
    crypto.__zeroize(&state)
    crypto.__zeroize(&h)
    crypto.__zeroize(&mask)
    crypto.__zeroize(&auth_tag)
    aes_workspace_clear(&work)
    out
}

fn aes_gcm_open(key: [U8], nonce: [U8], aad: [U8], cipher: [U8]) -> [U8]? {
    body_len :: cipher.len() - 16
    work := aes_workspace()
    state := zeros16()
    rk := aes256_expand(key, &state, &work)
    h := zeros16()
    aes256_encrypt_block(rk, h, &state, &work)
    loop i in 0..<16 -> h[i] = state[i]
    j0 := zeros16()
    loop i in 0..<12 -> j0[i] = nonce[i]
    j0[15] = U8{1}
    mask := zeros16()
    aes256_encrypt_block(rk, j0, &state, &work)
    loop i in 0..<16 -> mask[i] = state[i]
    expect := gcm_tag(h, mask, aad, cipher, body_len)
    different := U8{0}
    loop i in 0..<16 -> different = different.bit_or((expect[i].bit_xor(cipher[body_len + i])))
    crypto.__zeroize(&h)
    crypto.__zeroize(&mask)
    crypto.__zeroize(&expect)
    // The only secret-result branch is after the complete tag comparison.
    // No plaintext is allocated or written before authentication succeeds.
    if different != (U8{0}) {
        crypto.__zeroize(&rk)
        crypto.__zeroize(&state)
        aes_workspace_clear(&work)
        return None
    }
    out :: aes_ctr(rk, j0, cipher, body_len, &state, &work)
    crypto.__zeroize(&rk)
    crypto.__zeroize(&state)
    aes_workspace_clear(&work)
    Val(out)
}

fn zeros16() -> [U8] Never! {
    out := [U8]{}
    loop i in 0..<16 -> &out.push(U8{0})
    out
}

fn inc32(block: &[U8]) Never! {
    // Four fixed steps; carry depends only on the public counter.
    carry := U64{1}
    loop i in 0..<4 {
        n :: U64.from_u8(block[15 - i]) + carry
        block[15 - i] = U8{n.bit_and(U64{255})}
        carry = n >> 8
    }
}

fn aes_ctr(rk: [U8], j0: [U8], data: [U8], count: Int, state: &[U8], work: &[U64]) -> [U8] Never! {
    out := [U8]{}
    ctr := copy_bytes(j0)
    i := 0
    loop i < count {
        inc32(&ctr)
        aes256_encrypt_block(rk, ctr, &state, &work)
        j := 0
        loop j < 16 && i < count {
            &out.push(data[i].bit_xor(state[j]))
            i = i + 1
            j = j + 1
        }
    }
    out
}

fn gcm_tag(h: [U8], ek0: [U8], aad: [U8], ct: [U8], count: Int) -> [U8] Never! {
    y := [U64]{U64{0}, U64{0}}
    high :: aes_load_be64(h, 0)
    low :: aes_load_be64(h, 8)
    ghash_blocks(&y, high, low, aad, aad.len())
    ghash_blocks(&y, high, low, ct, count)
    y[0] = y[0].bit_xor(U64{aad.len() * 8})
    y[1] = y[1].bit_xor(U64{count * 8})
    gf128_mul(&y, high, low)
    out := zeros16()
    loop i in 0..<16 {
        word :: y[i /% 8] >> (56 - 8 * (i %% 8))
        out[i] = U8{word.bit_and(U64{255})}.bit_xor(ek0[i])
    }
    y[0] = U64{0}
    y[1] = U64{0}
    out
}

fn aes_load_be64(bytes: [U8], off: Int) -> U64 Never! {
    word := U64{0}
    loop i in 0..<8 -> word = (word << 8).bit_or(U64.from_u8(bytes[off + i]))
    word
}

fn ghash_blocks(y: &[U64], high: U64, low: U64, data: [U8], count: Int) Never! {
    off := 0
    loop off < count {
        a := U64{0}
        b := U64{0}
        loop i in 0..<16 {
            byte := U64{0}
            if off + i < count -> byte = U64.from_u8(data[off + i])
            if i < 8 -> a = (a << 8).bit_or(byte) else -> b = (b << 8).bit_or(byte)
        }
        y[0] = y[0].bit_xor(a)
        y[1] = y[1].bit_xor(b)
        gf128_mul(&y, high, low)
        off = off + 16
    }
}

// D-WRAP-SCOPE1: masks are explicitly wrapping fixed-width subtraction.
#Arithmetic(.Wrapping)
fn gf128_mul(x: &[U64], high: U64, low: U64) Never! {
    a := x[0]
    b := x[1]
    vh := high
    vl := low
    zh := U64{0}
    zl := U64{0}
    loop _ in 0..<128 {
        mask :: U64{0} - (a >> 63)
        zh = zh.bit_xor((vh.bit_and(mask)))
        zl = zl.bit_xor((vl.bit_and(mask)))
        a = (a << 1).bit_or((b >> 63))
        b = b << 1
        reduction :: U64{0} - (vl.bit_and(U64{1}))
        vl = (vl >> 1).bit_or((vh << 63))
        vh = (vh >> 1).bit_xor((U64{0xe100000000000000}.bit_and(reduction)))
    }
    x[0] = zh
    x[1] = zl
}

fn u8_int(b: U8) -> Int Never! { Int.from_u8(b) }


// Six eight-plane banks, allocated once and reused by every round/block.
fn aes_workspace() -> [U64] Never! {
    work := [U64]{}
    loop _ in 0..<48 -> &work.push(U64{0})
    work
}

fn aes_workspace_clear(work: &[U64]) Never! {
    // Best-effort source stores: the byte buffers use the existing zeroizer.
    loop i in 0..<48 -> work[i] = U64{0}
}

fn aes256_expand(key: [U8], state: &[U8], work: &[U64]) -> [U8] Never! {
    w := [U8]{}
    loop b in key -> &w.push(b)
    loop i in 8..<60 {
        loop j in 0..<4 -> state[j] = w[(i - 1) * 4 + j]
        loop j in 4..<16 -> state[j] = U8{0}
        if i %% 8 == 0 {
            first :: state[0].copy()
            loop j in 0..<3 -> state[j] = state[j + 1]
            state[3] = first
            sub_bytes(&state, &work)
            state[0] = state[0].bit_xor(C_AES_RCON[i /% 8 - 1])
        } else {
            if i %% 8 == 4 -> sub_bytes(&state, &work)
        }
        loop j in 0..<4 -> &w.push(w[(i - 8) * 4 + j].bit_xor(state[j]))
    }
    w
}

fn aes256_encrypt_block(rk: [U8], block: [U8], s: &[U8], work: &[U64]) Never! {
    loop i in 0..<16 -> s[i] = block[i]
    add_round(&s, rk, 0)
    loop round in 1..<14 {
        sub_bytes(&s, &work)
        shift_rows(&s)
        mix_columns(&s)
        add_round(&s, rk, round)
    }
    sub_bytes(&s, &work)
    shift_rows(&s)
    add_round(&s, rk, 14)
}

fn add_round(s: &[U8], rk: [U8], round: Int) Never! {
    loop i in 0..<16 -> s[i] = s[i].bit_xor(rk[round * 16 + i])
}

// Bitsliced AES inverse followed by the FIPS-197 affine transform.
// All addresses and shifts depend only on public lane/plane indices.
fn sub_bytes(s: &[U8], w: &[U64]) Never! {
    loop p in 0..<8 {
        w[p] = U64{0}
        loop lane in 0..<16 -> w[p] = w[p].bit_or((((U64.from_u8(s[lane]) >> p).bit_and(U64{1})) << lane))
    }
    aes_square(&w, 0, 8)           // x^2
    aes_multiply(&w, 8, 0, 16)     // x^3
    aes_square(&w, 16, 24)         // x^6
    aes_square(&w, 24, 24)         // x^12
    aes_multiply(&w, 24, 16, 32)   // x^15
    loop p in 0..<8 -> w[16 + p] = w[32 + p]
    aes_square(&w, 16, 16)         // x^30
    aes_square(&w, 16, 16)         // x^60
    aes_square(&w, 16, 16)         // x^120
    aes_square(&w, 16, 16)         // x^240
    aes_multiply(&w, 16, 24, 32)   // x^252
    loop p in 0..<8 -> w[16 + p] = w[32 + p]
    aes_multiply(&w, 16, 8, 32)    // x^254 (zero also follows this chain)
    loop p in 0..<8 {
        w[p] = w[32 + p].bit_xor(w[32 + ((p + 4) %% 8)]).bit_xor(w[32 + ((p + 5) %% 8)]).bit_xor(w[32 + ((p + 6) %% 8)]).bit_xor(w[32 + ((p + 7) %% 8)])
        if ((0x63 >> p).bit_and(1)) != 0 -> w[p] = w[p].bit_xor(U64{65535})
    }
    loop lane in 0..<16 {
        byte := U64{0}
        loop p in 0..<8 -> byte = byte.bit_or((((w[p] >> lane).bit_and(U64{1})) << p))
        s[lane] = U8{byte}
    }
}

// Linear square modulo x^8+x^4+x^3+x+1, with locals permitting aliasing.
fn aes_square(w: &[U64], src: Int, dst: Int) Never! {
    a0 :: w[src].copy()
    a1 :: w[src + 1].copy()
    a2 :: w[src + 2].copy()
    a3 :: w[src + 3].copy()
    a4 :: w[src + 4].copy()
    a5 :: w[src + 5].copy()
    a6 :: w[src + 6].copy()
    a7 :: w[src + 7].copy()
    w[dst] = a0.bit_xor(a4).bit_xor(a6)
    w[dst + 1] = a4.bit_xor(a6).bit_xor(a7)
    w[dst + 2] = a1.bit_xor(a5)
    w[dst + 3] = a4.bit_xor(a5).bit_xor(a6).bit_xor(a7)
    w[dst + 4] = a2.bit_xor(a4).bit_xor(a7)
    w[dst + 5] = a5.bit_xor(a6)
    w[dst + 6] = a3.bit_xor(a5)
    w[dst + 7] = a6.bit_xor(a7)
}

// dst is distinct from a/b; bank 40 is the fixed multiply-by-x scratch.
fn aes_multiply(w: &[U64], a: Int, b: Int, dst: Int) Never! {
    loop p in 0..<8 {
        w[40 + p] = w[a + p]
        w[dst + p] = U64{0}
    }
    loop bit in 0..<8 {
        loop p in 0..<8 -> w[dst + p] = w[dst + p].bit_xor((w[40 + p].bit_and(w[b + bit])))
        high :: w[47].copy()
        loop p in 0..<7 -> w[47 - p] = w[46 - p]
        w[40] = high
        w[41] = w[41].bit_xor(high)
        w[43] = w[43].bit_xor(high)
        w[44] = w[44].bit_xor(high)
    }
}

fn shift_rows(s: &[U8]) Never! {
    t1 := s[1]
    t5 := s[5]
    t9 := s[9]
    t13 := s[13]
    s[1] = t5
    s[5] = t9
    s[9] = t13
    s[13] = t1
    t2 := s[2]
    t6 := s[6]
    t10 := s[10]
    t14 := s[14]
    s[2] = t10
    s[6] = t14
    s[10] = t2
    s[14] = t6
    t3 := s[3]
    t7 := s[7]
    t11 := s[11]
    t15 := s[15]
    s[15] = t11
    s[11] = t7
    s[7] = t3
    s[3] = t15
}

fn mix_columns(s: &[U8]) Never! {
    loop c in 0..<4 {
        i :: 4 * c
        a0 :: s[i].copy()
        a1 :: s[i + 1].copy()
        a2 :: s[i + 2].copy()
        a3 :: s[i + 3].copy()
        all :: a0.bit_xor(a1).bit_xor(a2).bit_xor(a3)
        s[i] = a0.bit_xor(all).bit_xor(xtime(a0.bit_xor(a1)))
        s[i + 1] = a1.bit_xor(all).bit_xor(xtime(a1.bit_xor(a2)))
        s[i + 2] = a2.bit_xor(all).bit_xor(xtime(a2.bit_xor(a3)))
        s[i + 3] = a3.bit_xor(all).bit_xor(xtime(a3.bit_xor(a0)))
    }
}

#Arithmetic(.Wrapping)
fn xtime(a: U8) -> U8 Never! {
    (a << 1).bit_xor((U8{0x1b}.bit_and((U8{0} - (a >> 7)))))
}

// NIST FIPS-197 / SP800-38A AES-256 block example:
// https://csrc.nist.gov/CSRC/media/Projects/Cryptographic-Standards-and-Guidelines/documents/examples/AES_Core256.pdf
// PDF SHA-256: 8caf33781b8d4b9564c7e95a7690e491ca1d95efe9a31cdea2977deaf4c7b4ce
// All four outputs also observed from seed aes 0.8.4 (aes/fixtures.json).
// Private block tests avoid adding a public raw-block API.
#Test("NIST AES-256 block cipher known answers") {
    key :: [U8]{0x60, 0x3d, 0xeb, 0x10, 0x15, 0xca, 0x71, 0xbe, 0x2b, 0x73, 0xae, 0xf0, 0x85, 0x7d, 0x77, 0x81, 0x1f, 0x35, 0x2c, 0x07, 0x3b, 0x61, 0x08, 0xd7, 0x2d, 0x98, 0x10, 0xa3, 0x09, 0x14, 0xdf, 0xf4}
    plain :: [[U8]]{
        [U8]{0x6b, 0xc1, 0xbe, 0xe2, 0x2e, 0x40, 0x9f, 0x96, 0xe9, 0x3d, 0x7e, 0x11, 0x73, 0x93, 0x17, 0x2a},
        [U8]{0xae, 0x2d, 0x8a, 0x57, 0x1e, 0x03, 0xac, 0x9c, 0x9e, 0xb7, 0x6f, 0xac, 0x45, 0xaf, 0x8e, 0x51},
        [U8]{0x30, 0xc8, 0x1c, 0x46, 0xa3, 0x5c, 0xe4, 0x11, 0xe5, 0xfb, 0xc1, 0x19, 0x1a, 0x0a, 0x52, 0xef},
        [U8]{0xf6, 0x9f, 0x24, 0x45, 0xdf, 0x4f, 0x9b, 0x17, 0xad, 0x2b, 0x41, 0x7b, 0xe6, 0x6c, 0x37, 0x10},
    }
    cipher :: [[U8]]{
        [U8]{0xf3, 0xee, 0xd1, 0xbd, 0xb5, 0xd2, 0xa0, 0x3c, 0x06, 0x4b, 0x5a, 0x7e, 0x3d, 0xb1, 0x81, 0xf8},
        [U8]{0x59, 0x1c, 0xcb, 0x10, 0xd4, 0x10, 0xed, 0x26, 0xdc, 0x5b, 0xa7, 0x4a, 0x31, 0x36, 0x28, 0x70},
        [U8]{0xb6, 0xed, 0x21, 0xb9, 0x9c, 0xa6, 0xf4, 0xf9, 0xf1, 0x53, 0xe7, 0xb1, 0xbe, 0xaf, 0xed, 0x1d},
        [U8]{0x23, 0x30, 0x4b, 0x7a, 0x39, 0xf9, 0xf3, 0xff, 0x06, 0x7d, 0x8d, 0x8f, 0x9e, 0x24, 0xec, 0xc7},
    }
    work := aes_workspace()
    state := zeros16()
    rk := aes256_expand(key, &state, &work)
    loop i in 0..<4 {
        aes256_encrypt_block(rk, plain[i], &state, &work)
        assert_eq(state, cipher[i])
    }
    crypto.__zeroize(&rk)
    crypto.__zeroize(&state)
    aes_workspace_clear(&work)
}

/// RFC 9106 Argon2id.  The portable implementation supports one to eight
/// lanes, with memory rounded down to a whole number of four-slice lanes.
/// Memory is one flat `[U64]` of 128-word blocks; every compression works in
/// place through four reused 128-word scratch blocks.
fn argon2id_raw(password: [U8], salt: [U8], memory_kib: Int, iterations: Int, lanes: Int, out_len: Int) -> [U8] Never! {
    memory_blocks :: (memory_kib /% (4 * lanes)) * (4 * lanes)
    lane_length :: memory_blocks /% lanes
    segment_length :: lane_length /% 4
    h0_input := [U8]{}
    loop b in le_bytes(lanes, 4) -> &h0_input.push(b)
    loop b in le_bytes(out_len, 4) -> &h0_input.push(b)
    loop b in le_bytes(memory_kib, 4) -> &h0_input.push(b)
    loop b in le_bytes(iterations, 4) -> &h0_input.push(b)
    loop b in le_bytes(0x13, 4) -> &h0_input.push(b)
    loop b in le_bytes(2, 4) -> &h0_input.push(b)
    loop b in le_bytes(password.len(), 4) -> &h0_input.push(b)
    loop b in password -> &h0_input.push(b)
    loop b in le_bytes(salt.len(), 4) -> &h0_input.push(b)
    loop b in salt -> &h0_input.push(b)
    loop b in le_bytes(0, 4) -> &h0_input.push(b)
    loop b in le_bytes(0, 4) -> &h0_input.push(b)
    h0 :: blake2b(h0_input, 64)
    memory := [U64]{}
    loop _ in 0..<(memory_blocks * 128) -> &memory.push(U64{0})
    loop lane in 0..<lanes {
        loop block_index in 0..<2 {
            init_input := copy_bytes(h0)
            loop b in le_bytes(block_index, 4) -> &init_input.push(b)
            loop b in le_bytes(lane, 4) -> &init_input.push(b)
            block_bytes :: argon2_blake2b_long(init_input, 1024)
            position :: lane * lane_length + block_index
            loop word in 0..<128 -> memory[position * 128 + word] = load_le64(block_bytes, word * 8, 1024)
        }
    }
    work := [U64]{}
    saved := [U64]{}
    address_block := [U64]{}
    input_block := [U64]{}
    loop _ in 0..<128 {
        &work.push(U64{0})
        &saved.push(U64{0})
        &address_block.push(U64{0})
        &input_block.push(U64{0})
    }
    loop pass in 0..<iterations {
        loop slice in 0..<4 {
            loop lane in 0..<lanes {
                data_independent :: pass == 0 && slice < 2
                first_block :: if pass == 0 && slice == 0 -> 2 else -> 0
                if data_independent {
                    input_block[0] = U64{pass}
                    input_block[1] = U64{lane}
                    input_block[2] = U64{slice}
                    input_block[3] = U64{memory_blocks}
                    input_block[4] = U64{iterations}
                    input_block[5] = U64{2}
                    input_block[6] = U64{0}
                    if first_block != 0 -> argon2_next_addresses(&address_block, &input_block, &saved)
                }
                loop index in first_block..<segment_length {
                    position :: lane * lane_length + slice * segment_length + index
                    previous_position :: if {
                        index == 0 && slice == 0 -> lane * lane_length + lane_length - 1
                        index == 0 -> lane * lane_length + slice * segment_length - 1
                        else -> position - 1
                    }
                    if data_independent && index %% 128 == 0 -> argon2_next_addresses(&address_block, &input_block, &saved)
                    random_word :: argon2_random_word(memory, address_block, data_independent, index, previous_position * 128)
                    reference_lane :: if pass == 0 && slice == 0 -> lane else -> Int.from_u64((random_word >> 32) %% U64{lanes})
                    same_lane :: reference_lane == lane
                    area :: if {
                        pass == 0 && slice == 0 -> index - 1
                        pass == 0 && same_lane -> slice * segment_length + index - 1
                        pass == 0 -> slice * segment_length - (if index == 0 -> 1 else -> 0)
                        same_lane -> lane_length - segment_length + index - 1
                        else -> lane_length - segment_length - (if index == 0 -> 1 else -> 0)
                    }
                    start :: if pass != 0 && slice != 3 -> (slice + 1) * segment_length else -> 0
                    reference_index :: (start + argon2_mapping((random_word).bit_and(U64{0xffffffff}), area)) %% lane_length
                    reference_position :: reference_lane * lane_length + reference_index
                    argon2_fill_block(&memory, &work, &saved, previous_position * 128, reference_position * 128, position * 128, pass != 0)
                }
            }
        }
    }
    loop word in 0..<128 -> work[word] = U64{0}
    loop lane in 0..<lanes {
        last :: (lane * lane_length + lane_length - 1) * 128
        loop word in 0..<128 -> work[word] = (work[word]).bit_xor(memory[last + word])
    }
    result_bytes := [U8]{}
    loop word in work {
        loop b in 0..<8 -> &result_bytes.push(U8{(word >> (b * 8)).bit_and(U64{255})})
    }
    argon2_blake2b_long(result_bytes, out_len)
}

/// Little-endian word at `off`; bytes at or past `end` read as zero padding.
fn load_le64(bytes: [U8], off: Int, end: Int) -> U64 Never! {
    n := U64{0}
    loop i in 0..<8 {
        if off + i < end -> n = (n).bit_or(U64.from_u8(bytes[off + i]) << (i * 8))
    }
    n
}

fn argon2_blake2b_long(data: [U8], out_len: Int) -> [U8] Never! {
    prefixed := [U8]{}
    loop b in le_bytes(out_len, 4) -> &prefixed.push(b)
    loop b in data -> &prefixed.push(b)
    if out_len <= 64 -> return blake2b(prefixed, out_len)
    out := [U8]{}
    value := blake2b(prefixed, 64)
    loop i in 0..<32 -> &out.push(value[i])
    produced := 32
    loop produced + 64 < out_len {
        value = blake2b(value, 64)
        loop i in 0..<32 -> &out.push(value[i])
        produced += 32
    }
    last :: blake2b(value, out_len - produced)
    loop b in last -> &out.push(b)
    out
}

/// Pseudo-random word for the next reference: the address block during the
/// data-independent slices, otherwise the first word of the previous block.
fn argon2_random_word(memory: [U64], address_block: [U64], data_independent: Bool, index: Int, previous: Int) -> U64 Never! {
    if data_independent -> return address_block[index %% 128]
    memory[previous]
}

/// RFC 9106 3.4.2: map J1 (below 2^32) onto the reference area.
fn argon2_mapping(j1: U64, area: Int) -> Int Never! {
    x :: Int.from_u64((j1 * j1) >> 32)
    y :: (area * x) >> 32
    area - 1 - y
}

/// Next 128 data-independent addresses, G(0, G(0, input)), after bumping the
/// input block's counter word.
fn argon2_next_addresses(address_block: &[U64], input_block: &[U64], saved: &[U64]) Never! {
    input_block[6] = input_block[6] + U64{1}
    loop i in 0..<128 {
        address_block[i] = input_block[i]
        saved[i] = input_block[i]
    }
    argon2_permute(&address_block)
    loop i in 0..<128 {
        mixed :: (address_block[i]).bit_xor(saved[i])
        address_block[i] = mixed
        saved[i] = mixed
    }
    argon2_permute(&address_block)
    loop i in 0..<128 -> address_block[i] = (address_block[i]).bit_xor(saved[i])
}

/// Compress block `previous` with block `reference` into block `next` of
/// `memory` (word offsets); later passes XOR into the existing block.
fn argon2_fill_block(memory: &[U64], work: &[U64], saved: &[U64], previous: Int, reference: Int, next: Int, with_xor: Bool) Never! {
    loop i in 0..<128 {
        mixed :: (memory[previous + i]).bit_xor(memory[reference + i])
        work[i] = mixed
        if with_xor -> saved[i] = (mixed).bit_xor(memory[next + i]) else -> saved[i] = mixed
    }
    argon2_permute(&work)
    loop i in 0..<128 -> memory[next + i] = (work[i]).bit_xor(saved[i])
}

/// Argon2 permutation P over a 128-word block, in place: eight row rounds of
/// sixteen consecutive words, then eight column rounds of word pairs.
fn argon2_permute(block: &[U64]) Never! {
    loop i in 0..<8 {
        b :: i * 16
        argon2_round(&block, b, b + 1, b + 2, b + 3, b + 4, b + 5, b + 6, b + 7, b + 8, b + 9, b + 10, b + 11, b + 12, b + 13, b + 14, b + 15)
    }
    loop i in 0..<8 {
        b :: i * 2
        argon2_round(&block, b, b + 1, b + 16, b + 17, b + 32, b + 33, b + 48, b + 49, b + 64, b + 65, b + 80, b + 81, b + 96, b + 97, b + 112, b + 113)
    }
}

fn argon2_round(v: &[U64], i0: Int, i1: Int, i2: Int, i3: Int, i4: Int, i5: Int, i6: Int, i7: Int, i8: Int, i9: Int, i10: Int, i11: Int, i12: Int, i13: Int, i14: Int, i15: Int) Never! {
    argon2_g(&v, i0, i4, i8, i12)
    argon2_g(&v, i1, i5, i9, i13)
    argon2_g(&v, i2, i6, i10, i14)
    argon2_g(&v, i3, i7, i11, i15)
    argon2_g(&v, i0, i5, i10, i15)
    argon2_g(&v, i1, i6, i11, i12)
    argon2_g(&v, i2, i7, i8, i13)
    argon2_g(&v, i3, i4, i9, i14)
}

/// BlaMka G: BLAKE2b G with each x + y replaced by
/// x + y + 2 * lo32(x) * lo32(y), all modulo 2^64.
#Arithmetic(.Wrapping)
fn argon2_g(v: &[U64], ia: Int, ib: Int, ic: Int, id: Int) Never! {
    lo :: U64{0xffffffff}
    a := v[ia]
    b := v[ib]
    c := v[ic]
    d := v[id]
    a = a + b + U64{2} * ((a).bit_and(lo)) * ((b).bit_and(lo))
    d = ((d).bit_xor(a)).rotate_right(32)
    c = c + d + U64{2} * ((c).bit_and(lo)) * ((d).bit_and(lo))
    b = ((b).bit_xor(c)).rotate_right(24)
    a = a + b + U64{2} * ((a).bit_and(lo)) * ((b).bit_and(lo))
    d = ((d).bit_xor(a)).rotate_right(16)
    c = c + d + U64{2} * ((c).bit_and(lo)) * ((d).bit_and(lo))
    b = ((b).bit_xor(c)).rotate_right(63)
    v[ia] = a
    v[ib] = b
    v[ic] = c
    v[id] = d
}

/// BLAKE2b (RFC 7693), unkeyed, `out_len` 1..=64. The state and the 16-word
/// work and message buffers are allocated once per call.
fn blake2b(data: [U8], out_len: Int) -> [U8] Never! {
    h := [U64]{}
    loop word in C_BLAKE2B_IV -> &h.push(U64{word})
    h[0] = (h[0]).bit_xor(U64{(0x01010000).bit_or(out_len)})
    v := [U64]{}
    m := [U64]{}
    loop _ in 0..<16 {
        &v.push(U64{0})
        &m.push(U64{0})
    }
    i := 0
    loop i + 128 < data.len() {
        blake2b_compress(&h, &v, &m, data, i, i + 128, false)
        i += 128
    }
    blake2b_compress(&h, &v, &m, data, i, data.len(), true)
    out := [U8]{}
    loop k in 0..<out_len -> &out.push(U8{(h[k /% 8] >> ((k %% 8) * 8)).bit_and(U64{255})})
    out
}

