fn blake2b_compress(h: &[Int], block: [U8], t: Int, last: Bool) {
    iv := [Int]{
        0x6a09e667f3bcc908,
        0xbb67ae8584caa73b,
        0x3c6ef372fe94f82b,
        0xa54ff53a5f1d36f1,
        0x510e527fade682d1,
        0x9b05688c2b3e6c1f,
        0x1f83d9abfb41bd6b,
        0x5be0cd19137e2179,
    }
    v := [Int]{}
    loop i in 0..<8 -> v.push(h[i])
    loop i in 0..<8 -> v.push(iv[i])
    v[12] = (v[12] ~| (t & mask64)) & mask64
    v[13] = (v[13] ~| ((t >> 64) & mask64)) & mask64
    if last -> v[14] = (v[14] ~| mask64) & mask64
    m := [Int]{}
    loop i in 0..<16 {
        n := 0
        loop b in 0..<8 -> n = n | ((block[i * 8 + b] & 255) << (b * 8))
        m.push(n & mask64)
    }
    loop r in 0..<12 {
        base :: r * 16
        mix64(&v, 0, 4, 8, 12, m[@c_blake2b_sigma[base + 0]], m[@c_blake2b_sigma[base + 1]])
        mix64(&v, 1, 5, 9, 13, m[@c_blake2b_sigma[base + 2]], m[@c_blake2b_sigma[base + 3]])
        mix64(&v, 2, 6, 10, 14, m[@c_blake2b_sigma[base + 4]], m[@c_blake2b_sigma[base + 5]])
        mix64(&v, 3, 7, 11, 15, m[@c_blake2b_sigma[base + 6]], m[@c_blake2b_sigma[base + 7]])
        mix64(&v, 0, 5, 10, 15, m[@c_blake2b_sigma[base + 8]], m[@c_blake2b_sigma[base + 9]])
        mix64(&v, 1, 6, 11, 12, m[@c_blake2b_sigma[base + 10]], m[@c_blake2b_sigma[base + 11]])
        mix64(&v, 2, 7, 8, 13, m[@c_blake2b_sigma[base + 12]], m[@c_blake2b_sigma[base + 13]])
        mix64(&v, 3, 4, 9, 14, m[@c_blake2b_sigma[base + 14]], m[@c_blake2b_sigma[base + 15]])
    }
    loop i in 0..<8 -> h[i] = (h[i] ~| v[i] ~| v[i + 8]) & mask64
}

fn mix64(v: &[Int], a: Int, b: Int, c: Int, d: Int, x: Int, y: Int) {
    v[a] = (v[a] + v[b] + x) & mask64
    v[d] = rotl64(v[d] ~| v[a], 32)
    v[c] = (v[c] + v[d]) & mask64
    v[b] = rotl64(v[b] ~| v[c], 24)
    v[a] = (v[a] + v[b] + y) & mask64
    v[d] = rotl64(v[d] ~| v[a], 16)
    v[c] = (v[c] + v[d]) & mask64
    v[b] = rotl64(v[b] ~| v[c], 63)
}
