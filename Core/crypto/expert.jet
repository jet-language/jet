/// Compress `data[start..<end]`, zero-padded to 128 bytes; `end` is also the
/// byte counter. `v` and `m` are the caller's 16-word scratch buffers.
fn blake2b_compress(h: &[U64], v: &[U64], m: &[U64], data: [U8], start: Int, end: Int, last: Bool) Never! {
    loop i in 0..<16 -> m[i] = load_le64(data, start + i * 8, end)
    loop i in 0..<8 {
        v[i] = h[i]
        v[i + 8] = U64{C_BLAKE2B_IV[i]}
    }
    v[12] = v[12] ~| U64{end}
    if last -> v[14] = v[14] ~| U64.MAX
    loop r in 0..<12 {
        base :: r * 16
        blake2b_mix(&v, 0, 4, 8, 12, m[C_BLAKE2B_SIGMA[base]], m[C_BLAKE2B_SIGMA[base + 1]])
        blake2b_mix(&v, 1, 5, 9, 13, m[C_BLAKE2B_SIGMA[base + 2]], m[C_BLAKE2B_SIGMA[base + 3]])
        blake2b_mix(&v, 2, 6, 10, 14, m[C_BLAKE2B_SIGMA[base + 4]], m[C_BLAKE2B_SIGMA[base + 5]])
        blake2b_mix(&v, 3, 7, 11, 15, m[C_BLAKE2B_SIGMA[base + 6]], m[C_BLAKE2B_SIGMA[base + 7]])
        blake2b_mix(&v, 0, 5, 10, 15, m[C_BLAKE2B_SIGMA[base + 8]], m[C_BLAKE2B_SIGMA[base + 9]])
        blake2b_mix(&v, 1, 6, 11, 12, m[C_BLAKE2B_SIGMA[base + 10]], m[C_BLAKE2B_SIGMA[base + 11]])
        blake2b_mix(&v, 2, 7, 8, 13, m[C_BLAKE2B_SIGMA[base + 12]], m[C_BLAKE2B_SIGMA[base + 13]])
        blake2b_mix(&v, 3, 4, 9, 14, m[C_BLAKE2B_SIGMA[base + 14]], m[C_BLAKE2B_SIGMA[base + 15]])
    }
    loop i in 0..<8 -> h[i] = h[i] ~| v[i] ~| v[i + 8]
}

/// BLAKE2b G (RFC 7693 3.1): right rotations by 32, 24, 16 and 63.
#Arithmetic(.Wrapping)
fn blake2b_mix(v: &[U64], ia: Int, ib: Int, ic: Int, id: Int, x: U64, y: U64) Never! {
    a := v[ia]
    b := v[ib]
    c := v[ic]
    d := v[id]
    a = a + b + x
    d = (d ~| a).rotate_right(32)
    c += d
    b = (b ~| c).rotate_right(24)
    a = a + b + y
    d = (d ~| a).rotate_right(16)
    c += d
    b = (b ~| c).rotate_right(63)
    v[ia] = a
    v[ib] = b
    v[ic] = c
    v[id] = d
}
