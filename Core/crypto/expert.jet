// core.crypto.expert - raw-byte cryptography behind `#Unsafe`.
//
// Every function here is an interoperability control, not a beginner API.
// Callers own nonce uniqueness, key length, and algorithm choice. The typed
// `core.crypto` envelopes remain the default door.
//
// AES-256-GCM, XChaCha20-Poly1305, Ed25519, X25519, and bounded Argon2id
// are Jet. The OS CSPRNG stays a host cell.
use core
use core.crypto.[CryptoError, FileCryptoError, Secret, SharedSecret, Signature, SigningKey, X25519SecretKey, constant_time_equal_bytes]
use core.crypto as crypto
use __core_crypto_ct as ct

C_AES_SBOX :: [Int]{99, 124, 119, 123, 242, 107, 111, 197, 48, 1, 103, 43, 254, 215, 171, 118, 202, 130, 201, 125, 250, 89, 71, 240, 173, 212, 162, 175, 156, 164, 114, 192, 183, 253, 147, 38, 54, 63, 247, 204, 52, 165, 229, 241, 113, 216, 49, 21, 4, 199, 35, 195, 24, 150, 5, 154, 7, 18, 128, 226, 235, 39, 178, 117, 9, 131, 44, 26, 27, 110, 90, 160, 82, 59, 214, 179, 41, 227, 47, 132, 83, 209, 0, 237, 32, 252, 177, 91, 106, 203, 190, 57, 74, 76, 88, 207, 208, 239, 170, 251, 67, 77, 51, 133, 69, 249, 2, 127, 80, 60, 159, 168, 81, 163, 64, 143, 146, 157, 56, 245, 188, 182, 218, 33, 16, 255, 243, 210, 205, 12, 19, 236, 95, 151, 68, 23, 196, 167, 126, 61, 100, 93, 25, 115, 96, 129, 79, 220, 34, 42, 144, 136, 70, 238, 184, 20, 222, 94, 11, 219, 224, 50, 58, 10, 73, 6, 36, 92, 194, 211, 172, 98, 145, 149, 228, 121, 231, 200, 55, 109, 141, 213, 78, 169, 108, 86, 244, 234, 101, 122, 174, 8, 186, 120, 37, 46, 28, 166, 180, 198, 232, 221, 116, 31, 75, 189, 139, 138, 112, 62, 181, 102, 72, 3, 246, 14, 97, 53, 87, 185, 134, 193, 29, 158, 225, 248, 152, 17, 105, 217, 142, 148, 155, 30, 135, 233, 206, 85, 40, 223, 140, 161, 137, 13, 191, 230, 66, 104, 65, 153, 45, 15, 176, 84, 187, 22}

C_AES_RCON :: [Int]{1, 2, 4, 8, 16, 32, 64, 128, 27, 54}

C_MASK32 :: 4294967295

/// BLAKE2b initialization vector (RFC 7693 2.6).
C_BLAKE2B_IV :: [Int]{
    0x6a09e667f3bcc908,
    0xbb67ae8584caa73b,
    0x3c6ef372fe94f82b,
    0xa54ff53a5f1d36f1,
    0x510e527fade682d1,
    0x9b05688c2b3e6c1f,
    0x1f83d9abfb41bd6b,
    0x5be0cd19137e2179,
}

fn wrap32(n: Int) -> Int Never! { n & C_MASK32 }

fn rotl32(x: Int, n: Int) -> Int Never! {
    v :: x & C_MASK32
    r :: n & 31
    if r == 0 -> return v
    ((v << r) | (v >> (32 - r))) & C_MASK32
}

fn to_u8(n: Int) -> U8 Never! {
    v :: n & 255
    U8{v}
}

fn copy_bytes(bytes: [U8]) -> [U8] Never! {
    out := [U8]{}
    loop b in bytes -> &out.push(b)
    out
}

fn copy_ints(values: [Int]) -> [Int] Never! {
    out := [Int]{}
    loop value in values -> &out.push(value)
    out
}

fn slice_u8(bytes: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i >= bytes.len() -> return out
        &out.push(bytes[i])
        i = i + 1
    }
}

fn le_bytes(n: Int, width: Int) -> [U8] Never! {
    out := [U8]{}
    v := n
    loop i in 0..<width {
        &out.push(to_u8(v))
        v = v >> 8
    }
    out
}

fn x25519_scalarmult(sk: [U8], u: [U8]) -> [U8] Never! { ct.x25519(sk, u) }

fn ed25519_sign_raw(seed: [U8], msg: [U8]) -> [U8] Never! { ct.ed_sign(seed, msg) }

fn ed25519_verify_raw(pk: [U8], msg: [U8], sig: [U8]) -> Bool Never! { ct.ed_verify(pk, msg, sig) }


fn chacha20_block(key: [U8], nonce: [U8], counter: Int) -> [U8] Never! {
    st := [Int]{
        0x61707865,
        0x3320646e,
        0x79622d32,
        0x6b206574,
        u32le(key, 0),
        u32le(key, 4),
        u32le(key, 8),
        u32le(key, 12),
        u32le(key, 16),
        u32le(key, 20),
        u32le(key, 24),
        u32le(key, 28),
        wrap32(counter),
        u32le(nonce, 0),
        u32le(nonce, 4),
        u32le(nonce, 8),
    }
    w := copy_ints(st)
    loop _ in 0..<10 {
        qr(&w, 0, 4, 8, 12)
        qr(&w, 1, 5, 9, 13)
        qr(&w, 2, 6, 10, 14)
        qr(&w, 3, 7, 11, 15)
        qr(&w, 0, 5, 10, 15)
        qr(&w, 1, 6, 11, 12)
        qr(&w, 2, 7, 8, 13)
        qr(&w, 3, 4, 9, 14)
    }
    loop i in 0..<16 -> w[i] = wrap32(w[i] + st[i])
    out := [U8]{}
    loop i in 0..<16 {
        v :: w[i]
        &out.push(to_u8(v))
        &out.push(to_u8(v >> 8))
        &out.push(to_u8(v >> 16))
        &out.push(to_u8(v >> 24))
    }
    out
}

fn qr(s: &[Int], a: Int, b: Int, c: Int, d: Int) Never! {
    s[a] = wrap32(s[a] + s[b])
    s[d] = rotl32(s[d] ~| s[a], 16)
    s[c] = wrap32(s[c] + s[d])
    s[b] = rotl32(s[b] ~| s[c], 12)
    s[a] = wrap32(s[a] + s[b])
    s[d] = rotl32(s[d] ~| s[a], 8)
    s[c] = wrap32(s[c] + s[d])
    s[b] = rotl32(s[b] ~| s[c], 7)
}

fn u32le(bytes: [U8], off: Int) -> Int Never! {
    if off + 3 >= bytes.len() -> return 0
    (u8_int(bytes[off]) | (u8_int(bytes[off + 1]) << 8) | (u8_int(bytes[off + 2]) << 16) | (u8_int(bytes[off + 3]) << 24)) & C_MASK32
}

fn chacha20_xor(key: [U8], nonce: [U8], counter: Int, plain: [U8]) -> [U8] Never! {
    out := [U8]{}
    i := 0
    ctr := counter
    loop {
        if i >= plain.len() -> return out
        block :: chacha20_block(key, nonce, ctr)
        ctr = ctr + 1
        loop j in 0..<64 {
            if i >= plain.len() -> return out
            &out.push(to_u8(u8_int(plain[i]) ~| u8_int(block[j])))
            i = i + 1
        }
    }
}

fn poly1305(key: [U8], data: [U8]) -> [U8] Never! { ct.poly1305(key, data) }

fn pad16(n: Int) -> [U8] Never! {
    out := [U8]{}
    rem :: (16 - (n % 16)) % 16
    loop _ in 0..<rem -> &out.push(U8{0})
    out
}

fn chacha_poly_seal(key: [U8], nonce: [U8], aad: [U8], plain: [U8]) -> [U8] Never! {
    otk :: chacha20_block(key, nonce, 0)
    ct :: chacha20_xor(key, nonce, 1, plain)
    mac_data := [U8]{}
    loop b in aad -> &mac_data.push(b)
    loop b in pad16(aad.len()) -> &mac_data.push(b)
    loop b in ct -> &mac_data.push(b)
    loop b in pad16(ct.len()) -> &mac_data.push(b)
    loop b in le_bytes(aad.len(), 8) -> &mac_data.push(b)
    loop b in le_bytes(ct.len(), 8) -> &mac_data.push(b)
    auth_tag :: poly1305(otk, mac_data)
    out := [U8]{}
    loop b in ct -> &out.push(b)
    loop b in auth_tag -> &out.push(b)
    out
}

fn chacha_poly_open(key: [U8], nonce: [U8], aad: [U8], cipher: [U8]) -> [U8]? {
    if cipher.len() < 16 -> return None
    ct :: slice_u8(cipher, 0, cipher.len() - 16)
    auth_tag :: slice_u8(cipher, cipher.len() - 16, cipher.len())
    otk :: chacha20_block(key, nonce, 0)
    mac_data := [U8]{}
    loop b in aad -> &mac_data.push(b)
    loop b in pad16(aad.len()) -> &mac_data.push(b)
    loop b in ct -> &mac_data.push(b)
    loop b in pad16(ct.len()) -> &mac_data.push(b)
    loop b in le_bytes(aad.len(), 8) -> &mac_data.push(b)
    loop b in le_bytes(ct.len(), 8) -> &mac_data.push(b)
    expect :: poly1305(otk, mac_data)
    equal :: constant_time_equal_bytes(auth_tag, expect) ?? return None
    if equal -> return Val(chacha20_xor(key, nonce, 1, ct))
    None
}


fn hchacha20(key: [U8], nonce16: [U8]) -> [U8] Never! {
    st := [Int]{
        0x61707865,
        0x3320646e,
        0x79622d32,
        0x6b206574,
        u32le(key, 0),
        u32le(key, 4),
        u32le(key, 8),
        u32le(key, 12),
        u32le(key, 16),
        u32le(key, 20),
        u32le(key, 24),
        u32le(key, 28),
        u32le(nonce16, 0),
        u32le(nonce16, 4),
        u32le(nonce16, 8),
        u32le(nonce16, 12),
    }
    loop _ in 0..<10 {
        qr(&st, 0, 4, 8, 12)
        qr(&st, 1, 5, 9, 13)
        qr(&st, 2, 6, 10, 14)
        qr(&st, 3, 7, 11, 15)
        qr(&st, 0, 5, 10, 15)
        qr(&st, 1, 6, 11, 12)
        qr(&st, 2, 7, 8, 13)
        qr(&st, 3, 4, 9, 14)
    }
    out := [U8]{}
    loop k in 0..<4 -> hchacha_word(&out, st[k])
    loop k in 12..<16 -> hchacha_word(&out, st[k])
    out
}

fn hchacha_word(out: &[U8], value: Int) Never! {
    &out.push(to_u8(value))
    &out.push(to_u8(value >> 8))
    &out.push(to_u8(value >> 16))
    &out.push(to_u8(value >> 24))
}

fn xchacha_seal(key: [U8], nonce24: [U8], aad: [U8], plain: [U8]) -> [U8] Never! {
    sub :: hchacha20(key, slice_u8(nonce24, 0, 16))
    nonce := [U8]{0, 0, 0, 0}
    loop b in slice_u8(nonce24, 16, 24) -> &nonce.push(b)
    chacha_poly_seal(sub, nonce, aad, plain)
}

fn xchacha_open(key: [U8], nonce24: [U8], aad: [U8], cipher: [U8]) -> [U8]? {
    sub :: hchacha20(key, slice_u8(nonce24, 0, 16))
    nonce := [U8]{0, 0, 0, 0}
    loop b in slice_u8(nonce24, 16, 24) -> &nonce.push(b)
    chacha_poly_open(sub, nonce, aad, cipher)
}

pub fn aes256gcm_seal(key: [U8], nonce: [U8], plain: [U8], aad: [U8]) -> [U8] CryptoError! {
    if key.len() != 32 || nonce.len() != 12 -> return Err(.Length)
    if plain.len() > 1073741824 || aad.len() > 16777216 -> return Err(.Length)
    Ok(aes_gcm_seal(key, nonce, aad, plain))
}

pub fn aes256gcm_open(key: [U8], nonce: [U8], cipher: [U8], aad: [U8]) -> [U8] CryptoError! {
    if key.len() != 32 || nonce.len() != 12 || cipher.len() < 16 || cipher.len() > 1073741840 {
        return Err(.Length)
    }
    if aad.len() > 16777216 -> return Err(.Length)
    p :: aes_gcm_open(key, nonce, aad, cipher) ?? return Err(.OpenFailed)
    Ok(p)
}

pub fn xchacha20poly1305_seal(key: [U8], nonce: [U8], plain: [U8], aad: [U8]) -> [U8] CryptoError! {
    if key.len() != 32 || nonce.len() != 24 -> return Err(.Length)
    if plain.len() > 1073741824 || aad.len() > 16777216 -> return Err(.Length)
    Ok(xchacha_seal(key, nonce, aad, plain))
}

pub fn xchacha20poly1305_open(key: [U8], nonce: [U8], cipher: [U8], aad: [U8]) -> [U8] CryptoError! {
    if key.len() != 32 || nonce.len() != 24 || cipher.len() < 16 || cipher.len() > 1073741840 {
        return Err(.Length)
    }
    if aad.len() > 16777216 -> return Err(.Length)
    p :: xchacha_open(key, nonce, aad, cipher) ?? return Err(.OpenFailed)
    Ok(p)
}

/// RFC 9106 Argon2id with bounded portable memory and one to eight lanes.
pub fn argon2id(password: Secret, salt: [U8], memory_kib: Int, iterations: Int, lanes: Int, output_len: Int) -> Secret CryptoError! {
    if password.bytes.len() > 1048576 || salt.len() < 8 || salt.len() > 64 || memory_kib < 8192 || memory_kib > 262144 || iterations < 1 || iterations > 10 || lanes < 1 || lanes > 8 || output_len < 16 || output_len > 64 {
        return Err(.Length)
    }
    if memory_kib < 8 * lanes || memory_kib * iterations > 1048576 -> return Err(.Length)
    memory_blocks :: (memory_kib /% (4 * lanes)) * (4 * lanes)
    if memory_blocks < 8 * lanes -> return Err(.Length)
    Ok(Secret{bytes: argon2id_raw(password.bytes, salt, memory_kib, iterations, lanes, output_len)})
}

pub fn ed25519_sign(secret: [U8], bytes: [U8]) -> Signature CryptoError! {
    if secret.len() != 32 -> return Err(.KeyRejected)
    Ok(Signature{bytes: ed25519_sign_raw(secret, bytes)})
}

pub fn ed25519_verify_strict(public: [U8], message: [U8], signature: [U8]) -> Bool CryptoError! {
    if public.len() != 32 || signature.len() != 64 || message.len() > 1073741824 {
        return Err(.Length)
    }
    result :: ct.ed_verify_strict(public, message, signature)
    if result < 0 -> return Err(.KeyRejected)
    Ok(result == 1)
}

pub fn hkdf_sha256_raw(ikm: [U8], salt: [U8], info: [U8], len: Int) -> Secret CryptoError! {
    if len < 0 || len > 8160 -> return Err(.Length)
    prk := hmac_sha256_local(salt, ikm)
    out := [U8]{}
    previous := [U8]{}
    counter := 1
    loop out.len() < len {
        material := [U8]{}
        loop b in previous -> &material.push(b)
        loop b in info -> &material.push(b)
        &material.push(to_u8(counter))
        previous = hmac_sha256_local(prk, material)
        loop b in previous {
            if out.len() >= len -> break
            &out.push(b)
        }
        counter = counter + 1
    }
    Ok(Secret{bytes: out})
}

fn hmac_sha256_local(key: [U8], data: [U8]) -> [U8] Never! { crypto.hmac_sha256(key, data) }

pub fn x25519_raw(secret_bytes: [U8], public_bytes: [U8]) -> Secret CryptoError! {
    if secret_bytes.len() != 32 || public_bytes.len() != 32 -> return Err(.KeyRejected)
    shared :: x25519_scalarmult(secret_bytes, public_bytes)
    if all_zero(shared) -> return Err(.KeyRejected)
    Ok(Secret{bytes: shared})
}

fn all_zero(bytes: [U8]) -> Bool Never! {
    diff := U8{0}
    loop b in bytes -> diff = diff | b
    diff == U8{0}
}

pub fn secret_bytes(secret: Secret) -> [U8] Never! { ~secret.bytes }

pub fn shared_secret_bytes(secret: SharedSecret) -> [U8] Never! { ~secret.bytes }

pub fn signing_key_bytes(key: SigningKey) -> [U8] Never! { ~key.bytes }

pub fn x25519_secret_bytes(key: X25519SecretKey) -> [U8] Never! { ~key.bytes }

fn open_v1_body(key: [U8], mode: U8, nonce: [U8], body: [U8]) -> [U8]? {
    if mode == (U8{1}) -> return chacha_poly_open(key, nonce, [U8]{}, body)
    if mode == (U8{2}) -> return aes_gcm_open(key, nonce, [U8]{}, body)
    None
}

pub fn open_v1(key: [U8], envelope: [U8]) -> [U8] CryptoError! {
    if key.len() != 32 || envelope.len() < 34 || envelope.len() > 1073741856 {
        return Err(.OpenFailed)
    }
    if slice_u8(envelope, 0, 4) != "JETC".bytes() || envelope[4] != (U8{1}) {
        return Err(.OpenFailed)
    }
    nonce :: slice_u8(envelope, 6, 18)
    body :: slice_u8(envelope, 18, envelope.len())
    opened :: open_v1_body(key, envelope[5], nonce, body)
    opened_bytes :: opened ?? return Err(.OpenFailed)
    Ok(opened_bytes)
}

pub fn migrate_v1(key: [U8], source: Path, recipients: [X25519PublicKey], destination: Path) -[FS, Rand]> Bool FileCryptoError! {
    data :: host_read_file(source.to_string()) ?? return Err(.SourceMissing)
    plain :: open_v1(key, data) ?? return Err(.OpenFailed)
    sealed :: crypto.seal(recipients, plain, [U8]{}) ?? return Err(.PublishFailed)
    sealed_bytes :: crypto.sealed_bytes(sealed)
    host_write_file(destination.to_string(), sealed_bytes) ?? return Err(.PublishFailed)
    Ok(true)
}

fn host_read_file(path: String) -[FS]> [U8] FileCryptoError! {
    core.files.read_bytes(path) ?? return Err(.SourceMissing)
}

fn host_write_file(path: String, bytes: [U8]) -[FS]> Bool FileCryptoError! {
    core.files.write_bytes(path, bytes) ?? return Err(.PublishFailed)
    Ok(true)
}

fn aes_gcm_seal(key: [U8], nonce: [U8], aad: [U8], plain: [U8]) -> [U8] Never! {
    rk :: aes256_expand(key)
    h :: aes256_encrypt_block(rk, zeros16())
    j0 := [U8]{}
    loop b in nonce -> &j0.push(b)
    loop i in 0..<4 -> &j0.push(U8{0})
    j0[15] = (U8{1})
    ctr :: inc32(j0)
    ct :: aes_ctr(rk, ctr, plain)
    auth_tag :: gcm_tag(h, aes256_encrypt_block(rk, j0), aad, ct)
    out := [U8]{}
    loop b in ct -> &out.push(b)
    loop b in auth_tag -> &out.push(b)
    out
}

fn aes_gcm_open(key: [U8], nonce: [U8], aad: [U8], cipher: [U8]) -> [U8]? {
    ct :: slice_u8(cipher, 0, cipher.len() - 16)
    auth_tag :: slice_u8(cipher, cipher.len() - 16, cipher.len())
    rk :: aes256_expand(key)
    h :: aes256_encrypt_block(rk, zeros16())
    j0 := [U8]{}
    loop b in nonce -> &j0.push(b)
    loop i in 0..<4 -> &j0.push(U8{0})
    j0[15] = (U8{1})
    expect :: gcm_tag(h, aes256_encrypt_block(rk, j0), aad, ct)
    equal :: constant_time_equal_bytes(auth_tag, expect) ?? return None
    if equal {
        ctr :: inc32(j0)
        return Val(aes_ctr(rk, ctr, ct))
    }
    None
}

fn zeros16() -> [U8] Never! {
    out := [U8]{}
    loop i in 0..<16 -> &out.push(U8{0})
    out
}

fn inc32(block: [U8]) -> [U8] Never! {
    out := copy_bytes(block)
    i := 15
    loop i >= 12 {
        n :: (u8_int(out[i]) + 1) & 255
        out[i] = (U8{n})
        if n != 0 -> break
        i = i - 1
    }
    out
}

fn aes_ctr(rk: [Int], ctr0: [U8], data: [U8]) -> [U8] Never! {
    out := [U8]{}
    ctr := copy_bytes(ctr0)
    i := 0
    loop i < data.len() {
        ks :: aes256_encrypt_block(rk, ctr)
        j := 0
        loop j < 16 && i < data.len() {
            &out.push(U8{data[i] ~| ks[j]})
            i = i + 1
            j = j + 1
        }
        if i < data.len() -> ctr = inc32(ctr)
    }
    out
}

fn gcm_tag(h: [U8], ek0: [U8], aad: [U8], ct: [U8]) -> [U8] Never! {
    y := 0
    h_value :: be_int(h)
    y = ghash_blocks(y, h_value, aad)
    y = ghash_blocks(y, h_value, ct)
    len_block := [U8]{}
    loop b in be_bytes(aad.len() * 8, 8) -> &len_block.push(b)
    loop b in be_bytes(ct.len() * 8, 8) -> &len_block.push(b)
    y = gf128_mul(y ~| be_int(len_block), h_value)
    tag_n :: y ~| be_int(ek0)
    be_bytes(tag_n, 16)
}

fn ghash_blocks(y0: Int, h_value: Int, data: [U8]) -> Int Never! {
    y := y0
    i := 0
    loop {
        if i >= data.len() -> return y
        block := [U8]{}
        loop {
            if block.len() >= 16 || i >= data.len() -> break
            &block.push(data[i])
            i = i + 1
        }
        loop {
            if block.len() >= 16 -> break
            &block.push(U8{0})
        }
        y = gf128_mul(y ~| be_int(block), h_value)
    }
}

fn gf128_mul(x: Int, y: Int) -> Int Never! {
    reduction_poly :: 0xE1000000000000000000000000000000
    mask :: (1 << 128) - 1
    z := 0
    v := y & mask
    a := x & mask
    loop i in 0..<128 {
        bit :: (a >> (127 - i)) & 1
        if bit == 1 -> z = z ~| v
        lsb :: v & 1
        v = v >> 1
        if lsb == 1 -> v = v ~| reduction_poly
    }
    z & mask
}

fn u8_int(b: U8) -> Int Never! { Int.from_u8(b) }

fn be_int(bytes: [U8]) -> Int Never! {
    n := 0
    loop b in bytes -> n = (n << 8) | u8_int(b)
    n
}

fn be_bytes(n: Int, width: Int) -> [U8] Never! {
    out := [U8]{}
    loop i in 0..<width -> &out.push(U8{0})
    v := n
    i := width - 1
    loop i >= 0 {
        out[i] = to_u8(v)
        v = v >> 8
        i = i - 1
    }
    out
}

fn aes256_expand(key: [U8]) -> [Int] Never! {
    w := [Int]{}
    loop i in 0..<8 -> &w.push(u32be(key, i * 4))
    loop i in 8..<60 {
        t := w[i - 1]
        if i % 8 == 0 -> t = subword(rotword(t)) ~| (C_AES_RCON[i /% 8 - 1] << 24) else {
            if i % 8 == 4 -> t = subword(t)
        }
        &w.push(wrap32(w[i - 8] ~| t))
    }
    w
}

fn rotword(w: Int) -> Int Never! { wrap32((w << 8) | ((w >> 24) & 255)) }

fn subword(w: Int) -> Int Never! {
    b0 :: C_AES_SBOX[(w >> 24) & 255]
    b1 :: C_AES_SBOX[(w >> 16) & 255]
    b2 :: C_AES_SBOX[(w >> 8) & 255]
    b3 :: C_AES_SBOX[w & 255]
    (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

fn u32be(bytes: [U8], off: Int) -> Int Never! {
    if off + 3 >= bytes.len() -> return 0
    ((u8_int(bytes[off]) << 24) | (u8_int(bytes[off + 1]) << 16) | (u8_int(bytes[off + 2]) << 8) | u8_int(bytes[off + 3])) & C_MASK32
}

fn aes256_encrypt_block(rk: [Int], block: [U8]) -> [U8] Never! {
    s := [Int]{}
    loop i in 0..<16 -> &s.push(u8_int(block[i]) & 255)
    add_round(&s, rk, 0)
    loop round in 1..<14 {
        sub_bytes(&s)
        shift_rows(&s)
        mix_columns(&s)
        add_round(&s, rk, round)
    }
    sub_bytes(&s)
    shift_rows(&s)
    add_round(&s, rk, 14)
    out := [U8]{}
    loop i in 0..<16 -> &out.push(U8{s[i]})
    out
}

fn add_round(s: &[Int], rk: [Int], round: Int) Never! {
    loop c in 0..<4 {
        w :: rk[round * 4 + c]
        s[4 * c] = s[4 * c] ~| ((w >> 24) & 255)
        s[4 * c + 1] = s[4 * c + 1] ~| ((w >> 16) & 255)
        s[4 * c + 2] = s[4 * c + 2] ~| ((w >> 8) & 255)
        s[4 * c + 3] = s[4 * c + 3] ~| (w & 255)
    }
}

fn sub_bytes(s: &[Int]) Never! {
    loop i in 0..<16 -> s[i] = C_AES_SBOX[s[i]]
}

fn shift_rows(s: &[Int]) Never! {
    t1 := s[1]
    t5 := s[5]
    t9 := s[9]
    t13 := s[13]
    s[1] = t5
    s[5] = t9
    s[9] = t13
    s[13] = t1
    t2 := s[2]
    t6 := s[6]
    t10 := s[10]
    t14 := s[14]
    s[2] = t10
    s[6] = t14
    s[10] = t2
    s[14] = t6
    t3 := s[3]
    t7 := s[7]
    t11 := s[11]
    t15 := s[15]
    s[15] = t11
    s[11] = t7
    s[7] = t3
    s[3] = t15
}

fn mix_columns(s: &[Int]) Never! {
    loop c in 0..<4 {
        i :: 4 * c
        a0 := s[i]
        a1 := s[i + 1]
        a2 := s[i + 2]
        a3 := s[i + 3]
        s[i] = gf8(a0, 2) ~| gf8(a1, 3) ~| a2 ~| a3
        s[i + 1] = a0 ~| gf8(a1, 2) ~| gf8(a2, 3) ~| a3
        s[i + 2] = a0 ~| a1 ~| gf8(a2, 2) ~| gf8(a3, 3)
        s[i + 3] = gf8(a0, 3) ~| a1 ~| a2 ~| gf8(a3, 2)
    }
}

fn gf8(a: Int, n: Int) -> Int Never! {
    if n == {
        1 -> a & 255
        2 -> xtime(a)
        3 -> xtime(a) ~| (a & 255)
        else -> a & 255
    }
}

fn xtime(a: Int) -> Int Never! {
    v :: (a << 1) & 255
    if (a & 128) != 0 -> return v ~| 0x1b
    v
}

/// RFC 9106 Argon2id.  The portable implementation supports one to eight
/// lanes, with memory rounded down to a whole number of four-slice lanes.
/// Memory is one flat `[U64]` of 128-word blocks; every compression works in
/// place through four reused 128-word scratch blocks.
fn argon2id_raw(password: [U8], salt: [U8], memory_kib: Int, iterations: Int, lanes: Int, out_len: Int) -> [U8] Never! {
    memory_blocks :: (memory_kib /% (4 * lanes)) * (4 * lanes)
    lane_length :: memory_blocks /% lanes
    segment_length :: lane_length /% 4
    h0_input := [U8]{}
    loop b in le_bytes(lanes, 4) -> &h0_input.push(b)
    loop b in le_bytes(out_len, 4) -> &h0_input.push(b)
    loop b in le_bytes(memory_kib, 4) -> &h0_input.push(b)
    loop b in le_bytes(iterations, 4) -> &h0_input.push(b)
    loop b in le_bytes(0x13, 4) -> &h0_input.push(b)
    loop b in le_bytes(2, 4) -> &h0_input.push(b)
    loop b in le_bytes(password.len(), 4) -> &h0_input.push(b)
    loop b in password -> &h0_input.push(b)
    loop b in le_bytes(salt.len(), 4) -> &h0_input.push(b)
    loop b in salt -> &h0_input.push(b)
    loop b in le_bytes(0, 4) -> &h0_input.push(b)
    loop b in le_bytes(0, 4) -> &h0_input.push(b)
    h0 :: blake2b(h0_input, 64)
    memory := [U64]{}
    loop _ in 0..<(memory_blocks * 128) -> &memory.push(U64{0})
    loop lane in 0..<lanes {
        loop block_index in 0..<2 {
            init_input := copy_bytes(h0)
            loop b in le_bytes(block_index, 4) -> &init_input.push(b)
            loop b in le_bytes(lane, 4) -> &init_input.push(b)
            block_bytes :: argon2_blake2b_long(init_input, 1024)
            position :: lane * lane_length + block_index
            loop word in 0..<128 -> memory[position * 128 + word] = load_le64(block_bytes, word * 8, 1024)
        }
    }
    work := [U64]{}
    saved := [U64]{}
    address_block := [U64]{}
    input_block := [U64]{}
    loop _ in 0..<128 {
        &work.push(U64{0})
        &saved.push(U64{0})
        &address_block.push(U64{0})
        &input_block.push(U64{0})
    }
    loop pass in 0..<iterations {
        loop slice in 0..<4 {
            loop lane in 0..<lanes {
                data_independent :: pass == 0 && slice < 2
                first_block :: if pass == 0 && slice == 0 -> 2 else -> 0
                if data_independent {
                    input_block[0] = U64{pass}
                    input_block[1] = U64{lane}
                    input_block[2] = U64{slice}
                    input_block[3] = U64{memory_blocks}
                    input_block[4] = U64{iterations}
                    input_block[5] = U64{2}
                    input_block[6] = U64{0}
                    if first_block != 0 -> argon2_next_addresses(&address_block, &input_block, &saved)
                }
                loop index in first_block..<segment_length {
                    position :: lane * lane_length + slice * segment_length + index
                    previous_position :: if {
                        index == 0 && slice == 0 -> lane * lane_length + lane_length - 1
                        index == 0 -> lane * lane_length + slice * segment_length - 1
                        else -> position - 1
                    }
                    if data_independent && index %% 128 == 0 -> argon2_next_addresses(&address_block, &input_block, &saved)
                    random_word :: argon2_random_word(memory, address_block, data_independent, index, previous_position * 128)
                    reference_lane :: if pass == 0 && slice == 0 -> lane else -> Int.from_u64((random_word >> 32) %% U64{lanes})
                    same_lane :: reference_lane == lane
                    area :: if {
                        pass == 0 && slice == 0 -> index - 1
                        pass == 0 && same_lane -> slice * segment_length + index - 1
                        pass == 0 -> slice * segment_length - (if index == 0 -> 1 else -> 0)
                        same_lane -> lane_length - segment_length + index - 1
                        else -> lane_length - segment_length - (if index == 0 -> 1 else -> 0)
                    }
                    start :: if pass != 0 && slice != 3 -> (slice + 1) * segment_length else -> 0
                    reference_index :: (start + argon2_mapping(random_word & U64{0xffffffff}, area)) %% lane_length
                    reference_position :: reference_lane * lane_length + reference_index
                    argon2_fill_block(&memory, &work, &saved, previous_position * 128, reference_position * 128, position * 128, pass != 0)
                }
            }
        }
    }
    loop word in 0..<128 -> work[word] = U64{0}
    loop lane in 0..<lanes {
        last :: (lane * lane_length + lane_length - 1) * 128
        loop word in 0..<128 -> work[word] = work[word] ~| memory[last + word]
    }
    result_bytes := [U8]{}
    loop word in work {
        loop b in 0..<8 -> &result_bytes.push(U8{(word >> (b * 8)) & U64{255}})
    }
    argon2_blake2b_long(result_bytes, out_len)
}

/// Little-endian word at `off`; bytes at or past `end` read as zero padding.
fn load_le64(bytes: [U8], off: Int, end: Int) -> U64 Never! {
    n := U64{0}
    loop i in 0..<8 {
        if off + i < end -> n |= U64.from_u8(bytes[off + i]) << (i * 8)
    }
    n
}

fn argon2_blake2b_long(data: [U8], out_len: Int) -> [U8] Never! {
    prefixed := [U8]{}
    loop b in le_bytes(out_len, 4) -> &prefixed.push(b)
    loop b in data -> &prefixed.push(b)
    if out_len <= 64 -> return blake2b(prefixed, out_len)
    out := [U8]{}
    value := blake2b(prefixed, 64)
    loop i in 0..<32 -> &out.push(value[i])
    produced := 32
    loop produced + 64 < out_len {
        value = blake2b(value, 64)
        loop i in 0..<32 -> &out.push(value[i])
        produced += 32
    }
    last :: blake2b(value, out_len - produced)
    loop b in last -> &out.push(b)
    out
}

/// Pseudo-random word for the next reference: the address block during the
/// data-independent slices, otherwise the first word of the previous block.
fn argon2_random_word(memory: [U64], address_block: [U64], data_independent: Bool, index: Int, previous: Int) -> U64 Never! {
    if data_independent -> return address_block[index %% 128]
    memory[previous]
}

/// RFC 9106 3.4.2: map J1 (below 2^32) onto the reference area.
fn argon2_mapping(j1: U64, area: Int) -> Int Never! {
    x :: Int.from_u64((j1 * j1) >> 32)
    y :: (area * x) >> 32
    area - 1 - y
}

/// Next 128 data-independent addresses, G(0, G(0, input)), after bumping the
/// input block's counter word.
fn argon2_next_addresses(address_block: &[U64], input_block: &[U64], saved: &[U64]) Never! {
    input_block[6] = input_block[6] + U64{1}
    loop i in 0..<128 {
        address_block[i] = input_block[i]
        saved[i] = input_block[i]
    }
    argon2_permute(&address_block)
    loop i in 0..<128 {
        mixed :: address_block[i] ~| saved[i]
        address_block[i] = mixed
        saved[i] = mixed
    }
    argon2_permute(&address_block)
    loop i in 0..<128 -> address_block[i] = address_block[i] ~| saved[i]
}

/// Compress block `previous` with block `reference` into block `next` of
/// `memory` (word offsets); later passes XOR into the existing block.
fn argon2_fill_block(memory: &[U64], work: &[U64], saved: &[U64], previous: Int, reference: Int, next: Int, with_xor: Bool) Never! {
    loop i in 0..<128 {
        mixed :: memory[previous + i] ~| memory[reference + i]
        work[i] = mixed
        if with_xor -> saved[i] = mixed ~| memory[next + i] else -> saved[i] = mixed
    }
    argon2_permute(&work)
    loop i in 0..<128 -> memory[next + i] = work[i] ~| saved[i]
}

/// Argon2 permutation P over a 128-word block, in place: eight row rounds of
/// sixteen consecutive words, then eight column rounds of word pairs.
fn argon2_permute(block: &[U64]) Never! {
    loop i in 0..<8 {
        b :: i * 16
        argon2_round(&block, b, b + 1, b + 2, b + 3, b + 4, b + 5, b + 6, b + 7, b + 8, b + 9, b + 10, b + 11, b + 12, b + 13, b + 14, b + 15)
    }
    loop i in 0..<8 {
        b :: i * 2
        argon2_round(&block, b, b + 1, b + 16, b + 17, b + 32, b + 33, b + 48, b + 49, b + 64, b + 65, b + 80, b + 81, b + 96, b + 97, b + 112, b + 113)
    }
}

fn argon2_round(v: &[U64], i0: Int, i1: Int, i2: Int, i3: Int, i4: Int, i5: Int, i6: Int, i7: Int, i8: Int, i9: Int, i10: Int, i11: Int, i12: Int, i13: Int, i14: Int, i15: Int) Never! {
    argon2_g(&v, i0, i4, i8, i12)
    argon2_g(&v, i1, i5, i9, i13)
    argon2_g(&v, i2, i6, i10, i14)
    argon2_g(&v, i3, i7, i11, i15)
    argon2_g(&v, i0, i5, i10, i15)
    argon2_g(&v, i1, i6, i11, i12)
    argon2_g(&v, i2, i7, i8, i13)
    argon2_g(&v, i3, i4, i9, i14)
}

/// BlaMka G: BLAKE2b G with each x + y replaced by
/// x + y + 2 * lo32(x) * lo32(y), all modulo 2^64.
#Arithmetic(.Wrapping)
fn argon2_g(v: &[U64], ia: Int, ib: Int, ic: Int, id: Int) Never! {
    lo :: U64{0xffffffff}
    a := v[ia]
    b := v[ib]
    c := v[ic]
    d := v[id]
    a = a + b + U64{2} * (a & lo) * (b & lo)
    d = (d ~| a).rotate_right(32)
    c = c + d + U64{2} * (c & lo) * (d & lo)
    b = (b ~| c).rotate_right(24)
    a = a + b + U64{2} * (a & lo) * (b & lo)
    d = (d ~| a).rotate_right(16)
    c = c + d + U64{2} * (c & lo) * (d & lo)
    b = (b ~| c).rotate_right(63)
    v[ia] = a
    v[ib] = b
    v[ic] = c
    v[id] = d
}

/// BLAKE2b (RFC 7693), unkeyed, `out_len` 1..=64. The state and the 16-word
/// work and message buffers are allocated once per call.
fn blake2b(data: [U8], out_len: Int) -> [U8] Never! {
    h := [U64]{}
    loop word in C_BLAKE2B_IV -> &h.push(U64{word})
    h[0] = h[0] ~| U64{0x01010000 | out_len}
    v := [U64]{}
    m := [U64]{}
    loop _ in 0..<16 {
        &v.push(U64{0})
        &m.push(U64{0})
    }
    i := 0
    loop i + 128 < data.len() {
        blake2b_compress(&h, &v, &m, data, i, i + 128, false)
        i += 128
    }
    blake2b_compress(&h, &v, &m, data, i, data.len(), true)
    out := [U8]{}
    loop k in 0..<out_len -> &out.push(U8{(h[k /% 8] >> ((k %% 8) * 8)) & U64{255}})
    out
}

