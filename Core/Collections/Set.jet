// core.collections.set — ordered unique string sets.
//
// The set stores first-seen values in a deterministic order. All public
// operations return owned values and leave their inputs unchanged.
StringSet: struct {
    items: [String]
}
copy_strings: fn(xs: [String]) -> [String] {
    out := [String]{}
    loop x in xs -> out.push(x.copy())
    out
}

has_string: fn(xs: [String], item: String) -> Bool Never! {
    loop x in xs {
        if x == item -> return true
    }
    false
}

new: fn() -> StringSet Never! { StringSet{items: [String]{}} }

from_list: fn(items: [String]) -> StringSet Never! {
    out := [String]{}
    loop item in items {
        if !has_string(out, item) -> out.push(item.copy())
    }
    StringSet{items: out}
}

add: fn(s: StringSet, item: String) -> StringSet Never! {
    if has_string(s.items, item) -> return StringSet{items: copy_strings(s.items)}
    items := copy_strings(s.items)
    items.push(item.copy())
    StringSet{items: items}
}

discard: fn(s: StringSet, item: String) -> StringSet Never! {
    items := [String]{}
    loop x in s.items {
        if x != item -> items.push(x.copy())
    }
    StringSet{items: items}
}

remove: fn(s: StringSet, item: String) -> StringSet? Never! {
    if !contains(s, item) -> return None
    Val(discard(s, item))
}

contains: fn(s: StringSet, item: String) -> Bool Never! {
    has_string(s.items, item)
}

len: fn(s: StringSet) -> Int Never! { s.items.len() }

is_empty: fn(s: StringSet) -> Bool Never! { s.items.len() == 0 }

to_list: fn(s: StringSet) -> [String] Never! { copy_strings(s.items) }

clear: fn(_s: StringSet) -> StringSet Never! { new() }

union: fn(a: StringSet, b: StringSet) -> StringSet Never! {
    items := copy_strings(a.items)
    loop x in b.items {
        if !has_string(items, x) -> items.push(x.copy())
    }
    StringSet{items: items}
}

intersection: fn(a: StringSet, b: StringSet) -> StringSet Never! {
    items := [String]{}
    loop x in a.items {
        if has_string(b.items, x) -> items.push(x.copy())
    }
    StringSet{items: items}
}

difference: fn(a: StringSet, b: StringSet) -> StringSet Never! {
    items := [String]{}
    loop x in a.items {
        if !has_string(b.items, x) -> items.push(x.copy())
    }
    StringSet{items: items}
}

symmetric_difference: fn(a: StringSet, b: StringSet) -> StringSet Never! {
    union(difference(a, b), difference(b, a))
}

issubset: fn(a: StringSet, b: StringSet) -> Bool Never! {
    loop x in a.items {
        if !contains(b, x) -> return false
    }
    true
}

issuperset: fn(a: StringSet, b: StringSet) -> Bool Never! { issubset(b, a) }

isdisjoint: fn(a: StringSet, b: StringSet) -> Bool Never! {
    loop x in a.items {
        if has_string(b.items, x) -> return false
    }
    true
}

clone_set: fn(s: StringSet) -> StringSet Never! {
    StringSet{items: copy_strings(s.items)}
}
