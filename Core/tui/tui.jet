package {
    name: "core.tui"
    version: "0.1.0"
    edition: "2026"
    description: "Terminal UI layout, color, and events."
    license: "MIT"
    outputs: {
        tui: .Library{ entry: tui }
    }
}
use core as core
use core.ui as ui
use core.ui.[Rect, UiNode]

// core.tui — the portable terminal presentation layer.
//
// Models and layout are pure.  Terminal dimensions are the sole provider
// seam; drawing remains owned by the selected UI backend.

pub enum TuiEvent {
    Key(code: String, modifiers: Int)
    Resize(size: ui.Size)
    Timer(id: String, elapsed_ms: Int)
    Io(channel: String, payload: [U8])
    Focus(focused: Bool)
    Interrupt
    Close
}

pub enum TuiColorProfile {
    Ansi16
    Ansi256
    TrueColor
    Ascii
}

pub enum TuiColor {
    Ansi16(Int)
    Ansi256(Int)
    Rgb(red: Int, green: Int, blue: Int)
}

pub enum TuiDirection {
    Horizontal
    Vertical
}

pub enum TuiConstraint {
    Length(Float)
    Min(Float)
    Max(Float)
    Percent(Float)
    Fill(Float)
}

pub struct TuiCapabilities {
    pub color_profile: TuiColorProfile
    pub color: Bool
    pub unicode: Bool
    pub mouse: Bool
    pub resize: Bool
    pub clipboard: Bool
    pub width: Int
    pub height: Int
}

pub struct TuiStyle {
    pub foreground: ?TuiColor
    pub background: ?TuiColor
    pub bold: Bool
    pub dim: Bool
    pub underline: Bool
}

pub struct TuiListState {
    pub selected: Int
    pub offset: Int
}

pub fn capabilities() -> TuiCapabilities {
    core.tui.capabilities()
}

pub fn ascii(value: String) -> String { core.tui.ascii(value) }
pub fn color_ansi16(index: Int) -> TuiColor { core.tui.color_ansi16(index) }
pub fn color_ansi256(index: Int) -> TuiColor { core.tui.color_ansi256(index) }
pub fn color_rgb(red: Int, green: Int, blue: Int) -> TuiColor {
    core.tui.color_rgb(red, green, blue)
}

pub fn style() -> TuiStyle { core.tui.style() }
pub fn style_bold(s: TuiStyle, enabled: Bool) -> TuiStyle {
    core.tui.style_bold(^s, enabled)
}
pub fn style_dim(s: TuiStyle, enabled: Bool) -> TuiStyle {
    core.tui.style_dim(^s, enabled)
}
pub fn style_underline(s: TuiStyle, enabled: Bool) -> TuiStyle {
    core.tui.style_underline(^s, enabled)
}
pub fn style_foreground(s: TuiStyle, color: TuiColor) -> TuiStyle {
    core.tui.style_foreground(^s, color)
}
pub fn style_background(s: TuiStyle, color: TuiColor) -> TuiStyle {
    core.tui.style_background(^s, color)
}
pub fn style_text(value: String, s: TuiStyle, caps: TuiCapabilities) -> String {
    core.tui.style_text(value, s, caps)
}
pub fn display_width(value: String) -> Int { core.tui.display_width(value) }

pub fn length(value: Float) -> TuiConstraint { core.tui.length(value) }
pub fn min(value: Float) -> TuiConstraint { core.tui.min(value) }
pub fn max(value: Float) -> TuiConstraint { core.tui.max(value) }
pub fn percent(value: Float) -> TuiConstraint { core.tui.percent(value) }
pub fn fill(weight: Float) -> TuiConstraint { core.tui.fill(weight) }
pub fn horizontal() -> TuiDirection { core.tui.horizontal() }
pub fn vertical() -> TuiDirection { core.tui.vertical() }

pub fn layout(area: Rect, direction: TuiDirection, constraints: [TuiConstraint]) -> [Rect] {
    owned_constraints :: ~constraints
    core.tui.layout(area, direction, ^owned_constraints)
}

pub fn list(items: [String]) -> UiNode {
    owned_items :: ~items
    core.tui.list(^owned_items)
}
pub fn table(headers: [String], rows: [[String]]) -> ui.UiNode {
    owned_headers :: ~headers
    owned_rows :: ~rows
    core.tui.table(^owned_headers, ^owned_rows)
}

pub fn list_state() -> TuiListState { core.tui.list_state() }
pub fn list_state_select(state: TuiListState, index: Int) -> TuiListState {
    core.tui.list_state_select(^state, index)
}
pub fn list_state_selected(state: TuiListState) -> Int {
    core.tui.list_state_selected(state)
}
pub fn list_state_offset(state: TuiListState, offset: Int) -> TuiListState {
    core.tui.list_state_offset(^state, offset)
}

pub fn key_event(code: String) -> TuiEvent { core.tui.key_event(code) }
pub fn key_event_modifiers(code: String, modifiers: Int) -> TuiEvent {
    core.tui.key_event_modifiers(code, modifiers)
}
pub fn resize_event(width: Float, height: Float) -> TuiEvent {
    core.tui.resize_event(width, height)
}
pub fn timer_event(id: String, elapsed_ms: Int) -> TuiEvent {
    core.tui.timer_event(id, elapsed_ms)
}
pub fn io_event(channel: String, payload: [U8]) -> TuiEvent {
    owned_payload :: ~payload
    core.tui.io_event(channel, ^owned_payload)
}
pub fn focus_event(focused: Bool) -> TuiEvent { core.tui.focus_event(focused) }
pub fn interrupt_event() -> TuiEvent { core.tui.interrupt_event() }
pub fn close_event() -> TuiEvent { core.tui.close_event() }

