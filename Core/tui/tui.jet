package {
    name: "core.tui"
    version: "0.0.1"
    edition: "2026"
    description: "Terminal UI layout, color, and events."
    license: "MIT"
    outputs: {
        tui: .Library{ entry: tui }
    }
}
use core as core
use core.ui as ui
use core.ui.[Rect, UINode]

// core.tui — the portable terminal presentation layer.
//
// Models and layout are pure.  Terminal dimensions are the sole provider
// seam; drawing remains owned by the selected UI backend.

enum TUIEvent {
    Key(code: String, modifiers: Int)
    Resize(size: ui.Size)
    Timer(id: String, elapsed_ms: Int)
    IO(channel: String, payload: [U8])
    Focus(focused: Bool)
    Interrupt
    Close
}

enum TUIColorProfile {
    ANSI16
    ANSI256
    TrueColor
    ASCII
}

enum TUIColor {
    ANSI16(Int)
    ANSI256(Int)
    RGB(red: Int, green: Int, blue: Int)
}

enum TUIDirection {
    Horizontal
    Vertical
}

enum TUIConstraint {
    Length(Float)
    Min(Float)
    Max(Float)
    Percent(Float)
    Fill(Float)
}

struct TUICapabilities {
    color_profile: TUIColorProfile
    color: Bool
    unicode: Bool
    mouse: Bool
    resize: Bool
    clipboard: Bool
    width: Int
    height: Int
}

struct TUIStyle {
    foreground: TUIColor?
    background: TUIColor?
    bold: Bool
    dim: Bool
    underline: Bool
}

struct TUIListState {
    selected: Int
    offset: Int
}

fn capabilities() -> TUICapabilities Never! {
    core.tui.capabilities()
}

fn ascii(value: String) -> String Never! { core.tui.ascii(value) }
fn color_ansi16(index: Int) -> TUIColor Never! { core.tui.color_ansi16(index) }
fn color_ansi256(index: Int) -> TUIColor Never! { core.tui.color_ansi256(index) }
fn color_rgb(red: Int, green: Int, blue: Int) -> TUIColor Never! {
    core.tui.color_rgb(red, green, blue)
}

fn style() -> TUIStyle Never! { core.tui.style() }
fn style_bold(s: TUIStyle, enabled: Bool) -> TUIStyle Never! {
    core.tui.style_bold(^s, enabled)
}
fn style_dim(s: TUIStyle, enabled: Bool) -> TUIStyle Never! {
    core.tui.style_dim(^s, enabled)
}
fn style_underline(s: TUIStyle, enabled: Bool) -> TUIStyle Never! {
    core.tui.style_underline(^s, enabled)
}
fn style_foreground(s: TUIStyle, color: TUIColor) -> TUIStyle Never! {
    core.tui.style_foreground(^s, color)
}
fn style_background(s: TUIStyle, color: TUIColor) -> TUIStyle Never! {
    core.tui.style_background(^s, color)
}
fn style_text(value: String, s: TUIStyle, caps: TUICapabilities) -> String Never! {
    core.tui.style_text(value, s, caps)
}
fn display_width(value: String) -> Int Never! { core.tui.display_width(value) }

fn length(value: Float) -> TUIConstraint Never! { core.tui.length(value) }
fn min(value: Float) -> TUIConstraint Never! { core.tui.min(value) }
fn max(value: Float) -> TUIConstraint Never! { core.tui.max(value) }
fn percent(value: Float) -> TUIConstraint Never! { core.tui.percent(value) }
fn fill(weight: Float) -> TUIConstraint Never! { core.tui.fill(weight) }
fn horizontal() -> TUIDirection Never! { core.tui.horizontal() }
fn vertical() -> TUIDirection Never! { core.tui.vertical() }

fn layout(area: Rect, direction: TUIDirection, constraints: [TUIConstraint]) -> [Rect] Never! {
    core.tui.layout(area, direction, ^constraints)
}

fn list(items: [String]) -> UINode Never! {
    core.tui.list(^items)
}

fn table(headers: [String], rows: [[String]]) -> ui.UINode Never! {
    core.tui.table(^headers, ^rows)
}

fn list_state() -> TUIListState Never! { core.tui.list_state() }
fn list_state_select(state: TUIListState, index: Int) -> TUIListState Never! {
    core.tui.list_state_select(^state, index)
}
fn list_state_selected(state: TUIListState) -> Int Never! {
    core.tui.list_state_selected(state)
}
fn list_state_offset(state: TUIListState, offset: Int) -> TUIListState Never! {
    core.tui.list_state_offset(^state, offset)
}

fn key_event(code: String) -> TUIEvent Never! { core.tui.key_event(code) }
fn key_event_modifiers(code: String, modifiers: Int) -> TUIEvent Never! {
    core.tui.key_event_modifiers(code, modifiers)
}
fn resize_event(width: Float, height: Float) -> TUIEvent Never! {
    core.tui.resize_event(width, height)
}
fn timer_event(id: String, elapsed_ms: Int) -> TUIEvent Never! {
    core.tui.timer_event(id, elapsed_ms)
}
fn io_event(channel: String, payload: [U8]) -> TUIEvent Never! {
    core.tui.io_event(channel, ^payload)
}
fn focus_event(focused: Bool) -> TUIEvent Never! { core.tui.focus_event(focused) }
fn interrupt_event() -> TUIEvent Never! { core.tui.interrupt_event() }
fn close_event() -> TUIEvent Never! { core.tui.close_event() }

