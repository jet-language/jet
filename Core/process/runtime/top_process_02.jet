#Unsafe("join every pipe relay even when one fails, returning the first observed typed IO error")
fn jet_process_join_pipeline_forwarders(forwarders: &[JoinHandle<() io.Error!>]) -> () IOError! {
    first_error := None
    loop while Val(forwarder) :: forwarders.pop() {
        result :: forwarder.join().map_err(fn(_) {
            IOError.other(IOOperation.Read, Val("pipeline stdout"), "pipeline output forwarder panicked")
