// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2438
// GATE #4565: kernel primitive
#Unsafe("kill the retained child or complete Windows job, never a detached lookup by name")
fn jet_process_inner_kill(inner: &ProcessHandle) -> () io.Error! {
    match inner {
        ProcessHandle.Std{child, job} -> {
            if target.selected_os() == .Windows {
                if Val(job) :: job { return jet_process_pty.terminate(job) }
            }
            child.kill()
        }
        ProcessHandle.Native{job, ..} -> jet_process_pty.terminate(job)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2455
// GATE #4565: kernel primitive
#Unsafe("read Linux proc status without inventing a resource classification on a raced read")
fn jet_process_linux_vm_size(pid: U32) -> U64? {
    path :: OSPath.new("/proc/{pid}/status")
    status :: std.fs.read_to_string(path).ok()?
    status.lines().find_map(fn(line) {
        value := line.strip_prefix("VmSize:")?.trim() // #4303
        kilobytes :: value.strip_suffix("kB")?.trim().parse::<U64>().ok()?
        Val(kilobytes.saturating_mul(1024))
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2466
// GATE #4565: kernel primitive
#Unsafe("count entries in the actual Linux process descriptor directory")
fn jet_process_linux_open_files(pid: U32) -> U64? {
    path :: OSPath.new("/proc/{pid}/fd")
    Val(std.fs.read_dir(path).ok()?.count() as U64)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2476
// Linux rlimits enforce ceilings; observation classifies ENOMEM/EMFILE before
// untyped child failure. A raced proc read leaves classification to the kernel.
fn jet_process_live_resource_limit(pid: U32, spec: &ProcessSpec) -> ProcessResourceLimit? {
    if target.selected_os() == .Linux {
        if Val(limit) :: spec.memory_limit_bytes {
            // RLIMIT_AS may reject the next allocation just below its ceiling.
            const MEMORY_OBSERVATION_WINDOW: U64 = 1024 * 1024
            threshold :: (limit.max(0) as U64).saturating_sub(MEMORY_OBSERVATION_WINDOW)
            if jet_process_linux_vm_size(pid).is_some_and(fn(used) { used >= threshold }) { return Val(ProcessResourceLimit.Memory) }
        }
        if Val(limit) :: spec.open_file_limit {
            if jet_process_linux_open_files(pid).is_some_and(fn(used) { used >= limit.max(0) as U64 }) {
                return Val(ProcessResourceLimit.OpenFiles)
            }
        }
    }
    None
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2506
// GATE #4565: kernel primitive
#Unsafe("query retained Windows job accounting for the checked process limits")
fn jet_process_inner_resource_limit(inner: &ProcessHandle, spec: &ProcessSpec) -> ProcessResourceLimit? io.Error! {
    job := match inner {
        ProcessHandle.Std{job, ..} -> job.as_ref()
        ProcessHandle.Native{job, ..} -> Val(job.as_ref())
    }
    job := job ?? return Ok(None)
    jet_process_pty.resource_limit_hit(job, jet_process_native_limits(spec)).map(fn(hit) {
        hit.map(fn(hit) { match hit {
            jet_process_pty.ResourceLimitKind.CpuTime -> ProcessResourceLimit.CpuTime
            jet_process_pty.ResourceLimitKind.Memory -> ProcessResourceLimit.Memory
        } })
    })
}
