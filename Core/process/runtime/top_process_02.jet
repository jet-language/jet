fn jet_process_forward_pipeline_output(reader: ChildStdout, writer: ChildStdin, limit: USize, budget: Arc<AtomicUsize>, limit_hit: Arc<AtomicBool>, cancel: Arc<AtomicBool>, groups: Arc<Mutex<[U32]>>) -> () io.Error! {
