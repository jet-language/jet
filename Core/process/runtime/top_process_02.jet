// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1819
struct JetProcessPipelineChild { child: Child, job: File? }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1825
// GATE #4565: kernel primitive
#Unsafe("Windows job attachment owns child handle and kills/reaps the child if attachment fails")
fn jet_process_pipeline_child(child: Child, spec: &ProcessSpec) -> JetProcessPipelineChild IOError! {
    child := ^child
    if target.selected_os() == .Windows {
        job :: if spec.detached { None } else {
            match jet_process_pty.attach_job(child.as_raw_handle(), jet_process_native_limits(spec)) {
                Ok(job) -> Val(^job)
                Err(error) -> {
                    _ :: child.kill()
                    _ :: child.wait()
                    return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(), ^error))
                }
            }
        }
        return Ok(JetProcessPipelineChild{child:^child, job:^job})
    }
    Ok(JetProcessPipelineChild{child:^child, job:None})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1861
// GATE #4565: kernel primitive
#Unsafe("stop the selected process tree before killing its direct child")
fn jet_process_pipeline_child_stop(child: &JetProcessPipelineChild) -> () {
    if target.selected_family() == "unix" { _ :: jet_process_pty.signal_group(child.child.id(), jet_process_signal_kill()) }
    if target.selected_os() == .Windows {
        if Val(job) :: child.job.take() { _ :: jet_process_pty.terminate(&job) }
    }
    _ :: child.child.kill()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1870
// GATE #4565: kernel primitive
#Unsafe("stop descendants after the direct child was already reaped")
fn jet_process_pipeline_child_stop_after_wait(child: &JetProcessPipelineChild) -> () {
    if target.selected_family() == "unix" { _ :: jet_process_pty.signal_group(child.child.id(), jet_process_signal_kill()) }
    if target.selected_os() == .Windows {
        if Val(job) :: child.job.take() { _ :: jet_process_pty.terminate(&job) }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1881
// GATE #4565: kernel primitive
#Unsafe("stop every pipeline child before waiting to avoid sequential tree shutdown deadlocks")
fn jet_process_pipeline_cleanup(children: &[JetProcessPipelineChild]) -> () {
    for child in children.iter_mut() { jet_process_pipeline_child_stop(child) }
    for child in children.iter_mut() { _ :: child.child.wait() }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1890
// GATE #4565: kernel primitive
#Unsafe("snapshot registered Unix group IDs under poison-recovering mutex before signaling them")
fn jet_process_pipeline_stop_groups(groups: &Arc<Mutex<[U32]>>) -> () {
    if target.selected_family() == "unix" {
        groups :: groups.lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() })
        for pid in groups.iter() { _ :: jet_process_pty.signal_group(*pid, jet_process_signal_kill()) }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1905
// GATE #4565: kernel primitive
#Unsafe("signal a real Unix process group; non-Unix pipeline stop uses its child handles")
fn jet_process_pipeline_stop_group(pid: U32) -> () {
    if target.selected_family() == "unix" { _ :: jet_process_pty.signal_group(pid, jet_process_signal_kill()) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1912
fn jet_process_stop_output(groups: &Arc<Mutex<[U32]>>?, group_pid: U32?) -> () {
    if Val(groups) :: groups { jet_process_pipeline_stop_groups(groups) }
    else if Val(pid) :: group_pid { jet_process_pipeline_stop_group(pid) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1923
// GATE #4565: kernel primitive
#Unsafe("bounded pipe relay publishes prefix before release-signaling limit and stopping the process tree")
fn jet_process_forward_pipeline_output(reader: ChildStdout, writer: ChildStdin, limit: USize, budget: Arc<AtomicUsize>, limit_hit: Arc<AtomicBool>, cancel: Arc<AtomicBool>, groups: Arc<Mutex<[U32]>>) -> () io.Error! {
    reader := ^reader
    writer := ^writer
    result :: fn() {
        chunk := [0u8; JET_PROCESS_IO_CHUNK_BYTES]
        loop {
            count :: reader.read(&chunk)?
            if count == 0 { return Ok(()) }
            kept :: jet_process_output_reserve(limit, &budget, count)
            if kept != 0 {
                match writer.write_all(&chunk[..kept]) {
                    Ok(()) -> {}
                    Err(error) if error.kind() == io.ErrorKind.BrokenPipe -> return Err(^error)
                    Err(error) -> return Err(^error)
                }
            }
            if kept < count {
                limit_hit.store(true, Ordering.Release)
                jet_process_pipeline_stop_groups(&groups)
                return Ok(())
            }
        }
    }()
    if result.is_err() {
        cancel.store(true, Ordering.Release)
        jet_process_pipeline_stop_groups(&groups)
    }
    ^result
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1966
// GATE #4565: kernel primitive
#Unsafe("join every pipe relay even when one fails, returning the first observed typed IO error")
fn jet_process_join_pipeline_forwarders(forwarders: &[JoinHandle<() io.Error!>]) -> () IOError! {
    first_error := None
    loop while Val(forwarder) :: forwarders.pop() {
        result :: forwarder.join().map_err(fn(_) {
            IOError.other(IOOperation.Read, Val("pipeline stdout"), "pipeline output forwarder panicked")
        })
        match result {
            Ok(Ok(())) -> {}
            Ok(Err(error)) -> {
                if first_error.is_none() { first_error = Val(IOError.other(IOOperation.Read, Val("pipeline stdout"), ^error)) }
            }
            Err(error) -> { if first_error.is_none() { first_error = Val(^error) } }
        }
    }
    first_error.map_or(Ok(()), Err)
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1999
// GATE #4565: kernel primitive
#Unsafe("pipeline transaction owns native children, bounded relays, cancellation guard and all joined drains until receipt publication")
fn jet_process_spec_pipeline(specs: &[ProcessSpec]) -> ProcessReceipt IOError! {
    if specs.is_empty() {
        return Err(IOError.InvalidInput(IOContext.new(IOOperation.Resolve, None, None, Val("process.pipeline needs at least one command"))))
    }
    for spec in specs { jet_process_pipeline_resource_limits_check(spec)? }
    if specs.iter().any(fn(spec) { spec.policy_wire.is_some() }) {
        return Err(IOError.other(IOOperation.Resolve, Val("process.pipeline"),
            "authority-bound pipelines need one auditable launch transaction; refusing before spawn"))
    }
    direct_wait :: target.selected_family() == "unix" && specs.iter().all(fn(spec) {
        spec.timeout_ms.is_none() && spec.memory_limit_bytes.is_none() && spec.open_file_limit.is_none()
    })
    children := [JetProcessPipelineChild].with_capacity(specs.len())
    stage_started := if direct_wait { [Instant]{} } else { [Instant].with_capacity(specs.len()) }
    prev_stdout: ChildStdout? := None
    stage_budgets :: specs.iter().map(fn(spec) { spec.output_limit.map(fn(_) { Arc.new(AtomicUsize.new(0)) }) }).collect::<[Arc<AtomicUsize>?]>()
    pipeline_limit_hit :: Arc.new(AtomicBool.new(false))
    pipeline_cancel :: Arc.new(AtomicBool.new(false))
    pipeline_groups :: Arc.new(Mutex.new([U32].with_capacity(specs.len())))
    cancel_control :: jet_scheduler_current_task_control()
    cancel_groups :: pipeline_groups.clone()
    cancel_state :: pipeline_cancel.clone()
    cancel_guard :: cancel_control.as_ref().map(fn(control) {
        control.register_cancel_callback(Arc.new(fn() {
            cancel_state.store(true, Ordering.Release)
            jet_process_pipeline_stop_groups(&cancel_groups)
        }))
    })
    forwarders := [JoinHandle<() io.Error!>].with_capacity(specs.len().saturating_sub(1))
    for (index, spec) in specs.iter().enumerate() {
        is_last :: index + 1 == specs.len()
        input :: prev_stdout.take()
        limited_input :: index.checked_sub(1).is_some_and(fn(previous) { jet_process_pipeline_needs_relay(&specs[previous]) })
        (input, forward_input) :: if limited_input { (None, ^input) } else { (^input, None) }
        child :: (fn() -> Child IOError! {
            os :: target.selected_os()
            if (os == .Linux || os == .MacOS) && spec.policy_wire.is_some() {
                plan :: jet_process_spec_plan(spec)?
                return jet_process_sandbox_pipeline_spawn(spec, &plan, ^input)
            }
            if spec.terminal.is_some() {
                return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(),
                    "terminal sessions cannot be used as pipeline stages; spawn the session directly"))
            }
            command := jet_process_command_builder_with_identity(spec, None)?
            if Val(stdout) :: input { command.stdin(Stdio.from(^stdout)) }
            else if forward_input.is_some() { command.stdin(Stdio.piped()) }
            else {
                command.stdin(match &spec.stdin { Val(mode) -> jet_process_stdio(mode), None -> Stdio.null() })
            }
            if is_last { command.stdout(jet_process_stdio(&spec.stdout)) } else { command.stdout(Stdio.piped()) }
            command.stderr(jet_process_stdio(&spec.stderr))
            if target.selected_family() == "unix" {
                jet_process_attach_process_group(&command, spec)
                    .map_err(fn(error) { IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(), ^error) })?
            }
            command.spawn().map_err(fn(error) { IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(), ^error) })
        })()
        child := match child {
            Ok(child) -> match jet_process_pipeline_child(^child, spec) {
                Ok(child) -> ^child
                Err(error) -> {
                    jet_process_pipeline_cleanup(&children)
                    _ :: jet_process_join_pipeline_forwarders(&forwarders)
                    return Err(^error)
                }
            }
            Err(error) -> {
                jet_process_pipeline_cleanup(&children)
                _ :: jet_process_join_pipeline_forwarders(&forwarders)
                return Err(^error)
            }
        }
        child_pid :: child.child.id()
        pipeline_groups.lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() }).push(child_pid)
        if pipeline_cancel.load(Ordering.Acquire) { jet_process_pipeline_stop_groups(&pipeline_groups) }
        if Val(stdout) :: forward_input {
            previous :: match index.checked_sub(1) {
                Val(previous) -> previous
                None -> {
                    jet_process_pipeline_cleanup(std.slice.from_mut(&child))
                    jet_process_pipeline_cleanup(&children)
                    _ :: jet_process_join_pipeline_forwarders(&forwarders)
                    return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(), "limited pipeline input has no preceding stage"))
                }
            }
            stdin :: match child.child.stdin.take() {
                Val(stdin) -> ^stdin
                None -> {
                    jet_process_pipeline_cleanup(std.slice.from_mut(&child))
                    jet_process_pipeline_cleanup(&children)
                    _ :: jet_process_join_pipeline_forwarders(&forwarders)
                    return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(), "limited pipeline stage did not provide stdin"))
                }
            }
            limit :: match specs[previous].output_limit.map(fn(value) { value.max(0) as USize }) {
                Val(limit) -> limit
                None -> {
                    jet_process_pipeline_cleanup(std.slice.from_mut(&child))
                    jet_process_pipeline_cleanup(&children)
                    _ :: jet_process_join_pipeline_forwarders(&forwarders)
                    return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(), "limited pipeline input has no output limit"))
                }
            }
            budget :: match stage_budgets[previous].clone() {
                Val(budget) -> ^budget
                None -> {
                    jet_process_pipeline_cleanup(std.slice.from_mut(&child))
                    jet_process_pipeline_cleanup(&children)
                    _ :: jet_process_join_pipeline_forwarders(&forwarders)
                    return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(), "limited pipeline input has no shared budget"))
                }
            }
            groups :: pipeline_groups.clone()
            limit_hit :: pipeline_limit_hit.clone()
            cancel :: pipeline_cancel.clone()
            forwarders.push(std.thread.spawn(fn() {
                result :: std.panic.catch_unwind(std.panic.AssertUnwindSafe(fn() {
                    jet_process_forward_pipeline_output(^stdout, ^stdin, limit, ^budget, ^limit_hit, cancel.clone(), groups.clone())
                }))
                match result {
                    Ok(result) -> ^result
                    Err(payload) -> {
                        cancel.store(true, Ordering.Release)
                        jet_process_pipeline_stop_groups(&groups)
                        std.panic.resume_unwind(^payload)
                    }
                }
            }))
        }
        prev_stdout = child.child.stdout.take()
        children.push(^child)
        if !direct_wait { stage_started.push(Instant.now()) }
    }
    final_limit :: specs.last().and_then(fn(spec) { spec.output_limit }).map(fn(limit) { limit.max(0) as USize })
    output_drain :: prev_stdout.take().and_then(fn(stdout) {
        jet_process_drain_reader(Val(^stdout), final_limit, stage_budgets.last().cloned().flatten(),
            pipeline_limit_hit.clone(), Val(pipeline_cancel.clone()), Val(pipeline_groups.clone()), None)
    })
    stderr_drains :: children.iter_mut().enumerate().map(fn((index, child)) {
        jet_process_drain_reader(child.child.stderr.take(), specs[index].output_limit.map(fn(limit) { limit.max(0) as USize }),
            stage_budgets[index].clone(), pipeline_limit_hit.clone(), Val(pipeline_cancel.clone()), Val(pipeline_groups.clone()), None)
    }).collect()
    code := 0i64
    success := true
    timed_out := false
    output_limit_exceeded := false
    resource_limit := None
    wait_error := None
    stage_finished := [Bool].repeat(false, children.len())
    if direct_wait {
        for index in 0..children.len() {
            status :: match children[index].child.wait() {
                Ok(status) -> ^status
                Err(error) -> {
                    jet_process_pipeline_cleanup(&children)
                    wait_error = Val(IOError.other(IOOperation.Close, Val("pipeline process"), ^error))
                    break
                }
            }
            stage_finished[index] = true
            if Val(limit) :: jet_process_status_resource_limit(&status, &specs[index]) {
                jet_process_pipeline_cleanup(&children)
                resource_limit = Val(limit)
                break
            }
            jet_process_pipeline_child_stop_after_wait(&children[index])
            if !status.success() { success = false; code = status.code().unwrap_or(-1) as I64 }
        }
    } else {
        for index in 0..children.len() {
            if stage_finished[index] { continue }
            status :: loop {
                if pipeline_limit_hit.load(Ordering.Acquire) {
                    jet_process_pipeline_cleanup(&children)
                    output_limit_exceeded = true
                    break None
                }
                if pipeline_cancel.load(Ordering.Acquire) {
                    jet_process_pipeline_cleanup(&children)
                    break None
                }
                current_status := None
                for stage in 0..children.len() {
                    if stage_finished[stage] { continue }
                    if Val(limit) :: jet_process_live_resource_limit(children[stage].child.id(), &specs[stage]) {
                        jet_process_pipeline_cleanup(&children)
                        resource_limit = Val(limit)
                        break
                    }
                    status :: match children[stage].child.try_wait() {
                        Ok(status) -> ^status
                        Err(error) -> {
                            jet_process_pipeline_cleanup(&children)
                            wait_error = Val(IOError.other(IOOperation.Close, Val("pipeline process"), ^error))
                            break
                        }
                    }
                    if Val(status) :: status {
                        if Val(limit) :: jet_process_status_resource_limit(&status, &specs[stage]) {
                            jet_process_pipeline_cleanup(&children)
                            resource_limit = Val(limit)
                            break
                        }
                        stage_finished[stage] = true
                        jet_process_pipeline_child_stop_after_wait(&children[stage])
                        if !status.success() { success = false; code = status.code().unwrap_or(-1) as I64 }
                        if stage == index { current_status = Val(^status) }
                    }
                }
                // Equivalent to Rust's labeled break from the inner stage scan.
                if resource_limit.is_some() || wait_error.is_some() { break None }
                if current_status.is_some() { break ^current_status }
                if specs.iter().enumerate().any(fn((stage, spec)) {
                    !stage_finished[stage] && spec.timeout_ms.is_some_and(fn(timeout) {
                        stage_started[stage].elapsed() >= Duration.from_millis(timeout.max(0) as U64)
                    })
                }) {
                    jet_process_pipeline_cleanup(&children)
                    timed_out = true
                    success = false
                    break None
                }
                jet_scheduler_park_ms("process wait", 10)
            }
            if status.is_none() { break }
        }
    }
    if pipeline_cancel.load(Ordering.Acquire) { jet_process_pipeline_cleanup(&children) }
    forwarder_result :: jet_process_join_pipeline_forwarders(&forwarders)
    pipeline_output_exceeded :: pipeline_limit_hit.load(Ordering.Acquire)
    drains :: jet_process_collect_pipeline_drains(^output_drain, ^stderr_drains)
    drop(^cancel_guard)
    cancellation_pending :: cancel_control.as_ref().is_some_and(fn(control) { control.cancelled.load(Ordering.Acquire) })
    if cancellation_pending && !jet_scheduler_shielded() { jet_task_deliver_cancel() }
    forwarder_result?
    (output, errors) :: drains?
    output_exceeded :: output.exceeded
    if Val(error) :: wait_error { return Err(^error) }
    if Val(limit) :: resource_limit { return Err(IOError.ResourceLimit(limit)) }
    output_limit_exceeded = output_limit_exceeded || pipeline_output_exceeded
    if output_exceeded || output_limit_exceeded { return Err(IOError.ResourceLimit(ProcessResourceLimit.Output)) }
    output_text :: ^output.text
    secret_values := specs.iter().flat_map(jet_process_policy_secret_values).collect::<[String]>()
    secret_values.sort_by_key(fn(value) { std.cmp.Reverse(value.len()) })
    secret_values.dedup()
    Ok(jet_process_receipt(specs.last().expect("nonempty pipeline"), None, true, 0, code, success,
        Err(JetAbsent{}), timed_out, ^output_text, ^errors, Val(&secret_values)))
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2403
// GATE #4565: kernel primitive
#Unsafe("read PID from the retained selected child handle")
fn jet_process_inner_id(inner: &ProcessHandle) -> U32 {
    match inner {
        ProcessHandle.Std{child, ..} -> child.id()
        ProcessHandle.Native{pid, ..} -> *pid
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2411
// GATE #4565: kernel primitive
#Unsafe("poll retained child handle and convert exact Windows raw exit code")
fn jet_process_inner_try_wait(inner: &ProcessHandle) -> ExitStatus? io.Error! {
    match inner {
        ProcessHandle.Std{child, ..} -> child.try_wait()
        ProcessHandle.Native{process, ..} -> jet_process_pty.try_wait(process).map(fn(code) { code.map(ExitStatus.from_raw) })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2425
// GATE #4565: kernel primitive
#Unsafe("wait on owned native child handle and preserve its raw Windows exit code")
fn jet_process_inner_wait(inner: &ProcessHandle) -> ExitStatus io.Error! {
    match inner {
        ProcessHandle.Std{child, ..} -> child.wait()
        ProcessHandle.Native{process, ..} -> jet_process_pty.wait(process).map(ExitStatus.from_raw)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2438
// GATE #4565: kernel primitive
#Unsafe("kill the retained child or complete Windows job, never a detached lookup by name")
fn jet_process_inner_kill(inner: &ProcessHandle) -> () io.Error! {
    match inner {
        ProcessHandle.Std{child, job} -> {
            if target.selected_os() == .Windows {
                if Val(job) :: job { return jet_process_pty.terminate(job) }
            }
            child.kill()
        }
        ProcessHandle.Native{job, ..} -> jet_process_pty.terminate(job)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2455
// GATE #4565: kernel primitive
#Unsafe("read Linux proc status without inventing a resource classification on a raced read")
fn jet_process_linux_vm_size(pid: U32) -> U64? {
    path :: OSPath.new("/proc/{pid}/status")
    status :: std.fs.read_to_string(path).ok()?
    status.lines().find_map(fn(line) {
        value := line.strip_prefix("VmSize:")?.trim() // #4303
        kilobytes :: value.strip_suffix("kB")?.trim().parse::<U64>().ok()?
        Val(kilobytes.saturating_mul(1024))
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2466
// GATE #4565: kernel primitive
#Unsafe("count entries in the actual Linux process descriptor directory")
fn jet_process_linux_open_files(pid: U32) -> U64? {
    path :: OSPath.new("/proc/{pid}/fd")
    Val(std.fs.read_dir(path).ok()?.count() as U64)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2476
// Linux rlimits enforce ceilings; observation classifies ENOMEM/EMFILE before
// untyped child failure. A raced proc read leaves classification to the kernel.
fn jet_process_live_resource_limit(pid: U32, spec: &ProcessSpec) -> ProcessResourceLimit? {
    if target.selected_os() == .Linux {
        if Val(limit) :: spec.memory_limit_bytes {
            // RLIMIT_AS may reject the next allocation just below its ceiling.
            const MEMORY_OBSERVATION_WINDOW: U64 = 1024 * 1024
            threshold :: (limit.max(0) as U64).saturating_sub(MEMORY_OBSERVATION_WINDOW)
            if jet_process_linux_vm_size(pid).is_some_and(fn(used) { used >= threshold }) { return Val(ProcessResourceLimit.Memory) }
        }
        if Val(limit) :: spec.open_file_limit {
            if jet_process_linux_open_files(pid).is_some_and(fn(used) { used >= limit.max(0) as U64 }) {
                return Val(ProcessResourceLimit.OpenFiles)
            }
        }
    }
    None
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2506
// GATE #4565: kernel primitive
#Unsafe("query retained Windows job accounting for the checked process limits")
fn jet_process_inner_resource_limit(inner: &ProcessHandle, spec: &ProcessSpec) -> ProcessResourceLimit? io.Error! {
    job := match inner {
        ProcessHandle.Std{job, ..} -> job.as_ref()
        ProcessHandle.Native{job, ..} -> Val(job.as_ref())
    }
    job := job ?? return Ok(None)
    jet_process_pty.resource_limit_hit(job, jet_process_native_limits(spec)).map(fn(hit) {
        hit.map(fn(hit) { match hit {
            jet_process_pty.ResourceLimitKind.CpuTime -> ProcessResourceLimit.CpuTime
            jet_process_pty.ResourceLimitKind.Memory -> ProcessResourceLimit.Memory
        } })
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2527
