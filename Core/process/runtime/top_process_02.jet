// GATE #4565: kernel primitive
#Unsafe("selected Unix exit-status signal reports POSIX SIGXCPU without host target assumptions")
fn jet_process_status_resource_limit(status: &ExitStatus, spec: &ProcessSpec) -> ProcessResourceLimit? {
    if target.selected_family() == "unix" && spec.cpu_time_limit_ms.is_some() && status.signal() == Val(24) {
        return Val(ProcessResourceLimit.CpuTime)
    }
    None
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2542
// GATE #4565: kernel primitive
#Unsafe("signal retained Unix group, treating an already vanished group as cleaned, otherwise kill the native child")
fn jet_process_tree_signal(inner: &ProcessHandle, process_group: Bool, signal: I32) -> () io.Error! {
    if target.selected_family() == "unix" && process_group {
        return match jet_process_pty.signal_group(jet_process_inner_id(inner), signal) {
            Ok(()) -> Ok(())
            Err(error) if error.kind() == io.ErrorKind.NotFound -> Ok(())
            Err(error) -> Err(^error)
        }
    }
    jet_process_inner_kill(inner)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2559
fn jet_process_cleanup_io_error(error: io.Error) -> IOError { IOError.other(IOOperation.Close, Val("process"), ^error) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2567
// GATE #4565: kernel primitive
#Unsafe("record only the first cleanup error through the retained child's borrow-checked slot")
fn jet_process_record_cleanup_error(child: &ProcessChild, error: IOError) -> () {
    if Ok(slot) :: child.cleanup_error.try_borrow_mut() {
        if slot.is_none() { *slot = Val(^error) }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2575
// GATE #4565: kernel primitive
#Unsafe("borrow the retained child handle for PID projection without extending its lifetime")
fn jet_process_child_id(child: &ProcessChild) -> I64 {
    child.inner.borrow().as_ref().map(fn(inner) { jet_process_inner_id(inner) as I64 }).unwrap_or(0)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2583
// GATE #4565: kernel primitive
#Unsafe("wait owns retained child borrows, cancellation callback and native handles until pipe workers drain and cached receipt publishes")
fn jet_process_child_wait(child: &ProcessChild) -> ProcessReceipt IOError! {
    if Val(error) :: child.cleanup_error.borrow().clone() { return Err(^error) }
    if Val(result) :: child.wait_result.borrow().clone() { return Ok(^result) }
    topology_pid :: jet_process_child_id(child)
    _cleanup :: JetProcessWaitCleanup{child:child}
    // Independent stdout/stderr workers keep full pipes from deadlocking wait.
    output_limit_hit :: child.output_limit_hit.clone()
    output_read_error :: child.output_read_error.clone()
    timed_out := false
    resource_limit := None
    direct_wait :: target.selected_family() == "unix" && child.timeout_ms.is_none()
        && child.audit_spec.memory_limit_bytes.is_none() && child.audit_spec.open_file_limit.is_none()
        && (child.process_group || child.output_limit.is_none())
    cancel_control :: if direct_wait && child.process_group { jet_scheduler_current_task_control() } else { None }
    cancel_guard :: cancel_control.as_ref().map(fn(control) {
        pid :: topology_pid as U32
        control.register_cancel_callback(Arc.new(fn() { jet_process_pipeline_stop_group(pid) }))
    })
    status :: if direct_wait {
        slot := child.inner.borrow_mut()
        inner := slot.as_mut() ?? return Err(IOError.Closed(IOContext.new(
            IOOperation.Close, Val("process"), None, Val("process child wait result is unavailable"))))
        jet_process_inner_wait(inner).map_err(jet_process_cleanup_io_error)?
    } else {
        loop {
            slot := child.inner.borrow_mut()
            inner := slot.as_mut() ?? return Err(IOError.Closed(IOContext.new(
                IOOperation.Close, Val("process"), None, Val("process child wait result is unavailable"))))
            if target.selected_os() == .Windows {
                if Val(limit) :: jet_process_inner_resource_limit(inner, &child.audit_spec).map_err(jet_process_cleanup_io_error)? {
                    jet_process_tree_signal(inner, child.process_group, jet_process_signal_kill()).map_err(jet_process_cleanup_io_error)?
                    resource_limit = Val(limit)
                    break jet_process_inner_wait(inner).map_err(jet_process_cleanup_io_error)?
                }
            }
            if Val(limit) :: jet_process_live_resource_limit(jet_process_inner_id(inner), &child.audit_spec) {
                jet_process_tree_signal(inner, child.process_group, jet_process_signal_kill()).map_err(jet_process_cleanup_io_error)?
                resource_limit = Val(limit)
                break jet_process_inner_wait(inner).map_err(jet_process_cleanup_io_error)?
            }
            if Val(status) :: jet_process_inner_try_wait(inner).map_err(jet_process_cleanup_io_error)? { break ^status }
            if output_limit_hit.load(Ordering.Acquire) || output_read_error.load(Ordering.Acquire) {
                jet_process_tree_signal(inner, child.process_group, jet_process_signal_kill()).map_err(jet_process_cleanup_io_error)?
                break jet_process_inner_wait(inner).map_err(jet_process_cleanup_io_error)?
            }
            if Val(timeout) :: child.timeout_ms {
                if child.started.elapsed() >= Duration.from_millis(timeout as U64) {
                    jet_process_tree_signal(inner, child.process_group, jet_process_signal_kill()).map_err(jet_process_cleanup_io_error)?
                    timed_out = true
                    break jet_process_inner_wait(inner).map_err(jet_process_cleanup_io_error)?
                }
            }
            drop(^slot)
            // D-TASKRUNTIME1=A: release child borrow before inherited wait points.
            jet_scheduler_park_ms("process wait", 10)
        }
    }
    drop(^cancel_guard)
    cancellation_pending :: cancel_control.as_ref().is_some_and(fn(control) { control.cancelled.load(Ordering.Acquire) })
    // Unix groups need a final sweep. Windows jobs kill on close: another
    // TerminateJobObject after leader exit races a signaled/empty job.
    cleanup_error :: if target.selected_family() == "unix" && child.process_group {
        slot := child.inner.borrow_mut()
        if Val(inner) :: slot.as_mut() {
            jet_process_tree_signal(inner, true, jet_process_signal_kill()).err().map(jet_process_cleanup_io_error)
        } else { None }
    } else { None }
    if Val(error) :: cleanup_error.as_ref() { jet_process_record_cleanup_error(child, error.clone()) }
    pid :: child.inner.borrow().as_ref().map(fn(inner) { jet_process_inner_id(inner) as I64 }).unwrap_or(0)
    child.inner.borrow_mut().take()
    *child.stdin.borrow_mut() = None
    // Release ConPTY before joining its output worker; otherwise pipe stays live.
    if target.selected_os() == .Windows {
        if Val(session) :: child.terminal.as_ref().ok() { session.control.close() }
    }
    (output, errors) :: jet_process_collect_child_output(child)?
    if cancellation_pending && !jet_scheduler_shielded() {
        jet_process_publish_topology_id(topology_pid, JetDevtoolsTopologyProcessState.Failed)
        jet_task_deliver_cancel()
    }
    if Val(error) :: cleanup_error {
        jet_process_publish_topology_id(topology_pid, JetDevtoolsTopologyProcessState.Failed)
        return Err(^error)
    }
    if output_limit_hit.load(Ordering.Acquire) {
        jet_process_publish_topology_id(topology_pid, JetDevtoolsTopologyProcessState.Failed)
        return Err(IOError.ResourceLimit(ProcessResourceLimit.Output))
    }
    if Val(limit) :: resource_limit {
        jet_process_publish_topology_id(topology_pid, JetDevtoolsTopologyProcessState.Failed)
        return Err(IOError.ResourceLimit(limit))
    }
    if Val(limit) :: jet_process_status_resource_limit(&status, &child.audit_spec) {
        jet_process_publish_topology_id(topology_pid, JetDevtoolsTopologyProcessState.Failed)
        return Err(IOError.ResourceLimit(limit))
    }
    code :: status.code().unwrap_or(-1) as I64
    signal :: if target.selected_family() == "unix" {
        jet_outcome_of(status.signal().map(fn(signal) { JetInt.from_i64(signal as I64) }))
    } else { Err(JetAbsent{}) }
    result :: jet_process_receipt(&child.audit_spec, child.audit_plan.as_ref(), child.process_group,
        pid, code, status.success(), ^signal, timed_out, ^output, ^errors, None)
    jet_process_publish_topology_id(topology_pid,
        if timed_out || !status.success() { JetDevtoolsTopologyProcessState.Failed } else { JetDevtoolsTopologyProcessState.Exited })
    *child.wait_result.borrow_mut() = Val(result.clone())
    Ok(^result)
}
