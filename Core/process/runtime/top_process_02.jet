// GATE #4565: kernel primitive
#Unsafe("read PID from the retained selected child handle")
fn jet_process_inner_id(inner: &ProcessHandle) -> U32 {
    match inner {
        ProcessHandle.Std{child, ..} -> child.id()
        ProcessHandle.Native{pid, ..} -> *pid
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2411
// GATE #4565: kernel primitive
#Unsafe("poll retained child handle and convert exact Windows raw exit code")
fn jet_process_inner_try_wait(inner: &ProcessHandle) -> ExitStatus? io.Error! {
    match inner {
        ProcessHandle.Std{child, ..} -> child.try_wait()
        ProcessHandle.Native{process, ..} -> jet_process_pty.try_wait(process).map(fn(code) { code.map(ExitStatus.from_raw) })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:2425
// GATE #4565: kernel primitive
#Unsafe("wait on owned native child handle and preserve its raw Windows exit code")
fn jet_process_inner_wait(inner: &ProcessHandle) -> ExitStatus io.Error! {
    match inner {
        ProcessHandle.Std{child, ..} -> child.wait()
        ProcessHandle.Native{process, ..} -> jet_process_pty.wait(process).map(ExitStatus.from_raw)
