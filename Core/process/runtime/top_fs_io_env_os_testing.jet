            }
            if pairs.iter_mut().find(fn(pair) { pair.0.eq_ignore_ascii_case(segment) && pair.1 is .Object(_) }) == Val((_, child)) {
                jet_env_insert_tree(child, segments[1..], ^value)
            } else {
                child := DataTree.Object([])
                jet_env_insert_tree(&child, segments[1..], ^value)
                &pairs.push((segment.clone(), ^child))
            }
        }
    }
}
