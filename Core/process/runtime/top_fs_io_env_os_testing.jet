struct JetProgressIter<T> { inner: Box<Iterator<Item=T>>, state: JetOutputProgressIterState }
impl<T> Iterator for JetProgressIter<T> {
    type Item = T
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:415
    fn next(self: &Self) -> T? {
        item :: match self.inner.next() {
            Val(item) -> ^item
            None -> { self.finish(); return None }
        }
        match self.state.advance(jet_style_enabled(), jet_std_io_progress_emit, jet_std_io_progress_finish) {
            Err(error) -> jet_panic("<progress>", 0, "{error:?}")
            Ok(_) -> {}
        }
        Val(^item)
    }
}
impl<T> JetProgressIter<T> {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:435
    fn finish(self: &Self) -> {
        match self.state.finish(jet_std_io_progress_finish) {
            Err(error) -> jet_panic("<progress>", 0, "{error:?}")
            Ok(_) -> {}
        }
    }
}
impl<T> Drop for JetProgressIter<T> {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:443
    fn drop(self: &Self) -> { self.finish() }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:448
fn jet_std_io_progress_iter<T>(it: JetIter<T>, description: &String, format: &String) -> JetIter<T> {
    (lower, upper) :: it.source.size_hint()
    total :: upper.filter(fn(upper) { upper == lower })
    jet_std_io_progress_iter_with_total(^it, description, format, total)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:458
fn jet_std_io_progress_iter_with_total<T>(it: JetIter<T>, description: &String, format: &String, total: USize?) -> JetIter<T> {
    JetIter{source: Box.new(JetProgressIter{inner: ^it.source, state: JetOutputProgressIterState.new(description, format, total)})}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:470
fn jet_std_io_progress_emit(text: &String) -> () IOError! {
    if !jet_term_progress_enabled() -> return Ok(())
    frame :: jet_term_progress_frame(true, text)
    if jet_fault_should_fail("IO.Write") -> return Err(IOError.other(IOOperation.Write, Val("stderr"), "fault injected: IO.Write"))
    if jet_fault_should_fail("IO.Flush") -> return Err(IOError.other(IOOperation.Flush, Val("stderr"), "fault injected: IO.Flush"))
    jet_term_write_stderr(&frame, true).map_err(fn(e) { jet_stdio_error(IOOperation.Flush, "stderr", e) })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:493
fn jet_std_io_progress_finish() -> () IOError! {
    if !jet_term_progress_enabled() -> return Ok(())
    frame :: jet_term_progress_finish(true)
    if !frame.is_empty() {
        if jet_fault_should_fail("IO.Write") -> return Err(IOError.other(IOOperation.Write, Val("stderr"), "fault injected: IO.Write"))
        if jet_fault_should_fail("IO.Flush") -> return Err(IOError.other(IOOperation.Flush, Val("stderr"), "fault injected: IO.Flush"))
        jet_term_write_stderr(frame, true).map_err(fn(e) { jet_stdio_error(IOOperation.Flush, "stderr", e) })?
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:519
fn jet_std_io_progress(text: &String) -> () IOError! {
    // The one-string helper never adds the iterable lifecycle's terminating newline.
    jet_std_io_progress_emit(text)
}
use core.sys.runtime.env_init.[JetEnvEntry, jet_env_read, jet_env_write, jet_env_key_eq, jet_env_key_cmp]
use core.sys.runtime.kernel_env_config_04.*
use core.sys.runtime.kernel_env_config.*
use core.encoding.runtime.std_data_tree.[DataTree, FieldError, io_error_at]
use core.encoding.runtime.top_encoding_traits.__jet_Decode
use std.ffi.[OsStr, OsString]

// D-ENV-MUTATE1=A: one raw-byte logical environment, never native setenv.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:529
fn jet_env_validate_name(name: &String) -> () EnvError! {
    if name.is_empty() || name.contains(TEXT_NUL) || name.contains("=") -> Err(EnvError.InvalidName)
    else -> Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:537
fn jet_env_validate_value(value: &String) -> () EnvError! {
    if value.contains(TEXT_NUL) -> Err(EnvError.InvalidValue) else -> Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:561
// Presence remains raw; a non-Unicode NO_COLOR value still counts as present.
fn jet_env_value_raw(name: &String) -> [U8]? {
    // GATE #4565: kernel primitive
    #Unsafe("selected OS name encoding and canonical environment read lock") {
        name :: OsStr.new(name).as_encoded_bytes()
        jet_env_read().iter().find(fn(entry) { jet_env_key_eq(entry.name, name) }).map(fn(entry) { entry.value.clone() })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:569
fn jet_std_env_get(name: &String) -> String? {
    jet_env_value_raw(name).and_then(fn(value) {
        // GATE #4565: kernel primitive
        #Unsafe("bytes are a complete native OS value from this selected target's environment table") {
            OsString.from_encoded_bytes_unchecked(^value).into_string().ok()
        }
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:580
fn jet_std_env_decode<T: __jet_Decode>(prefix: &String, file: &String, allow: &[String], names: &[(&String, &String)]) -> T [FieldError]! {
    path :: OSPath.new(file)
    if !jet_env_config_file_is_project_relative(file) -> return Err(FieldError.one("E2416: Dotenv.file must be project-relative"))
    dotenv :: if file.is_empty() { None } else {
        // GATE #4565: kernel primitive
        match #Unsafe("read only validated project-relative Dotenv file with native NotFound/error fidelity") { std.fs.read_to_string(path) } {
            Ok(text) -> Val(^text)
            Err(error) -> {
                if error.kind() == std.io.ErrorKind.NotFound -> None
                else -> return Err(FieldError.one("E2416: cannot read Dotenv.file `{file}`: {error}"))
            }
        }
    }
    process :: jet_std_env_snapshot_raw().into_iter().filter_map(fn(entry) {
        // GATE #4565: kernel primitive
        #Unsafe("borrow complete selected-native encodings from snapshot; skip non-Unicode pairs") {
            name :: OsStr.from_encoded_bytes_unchecked(entry.name).to_str()?
            value :: OsStr.from_encoded_bytes_unchecked(entry.value).to_str()?
            Val((name.to_string(), value.to_string()))
        }
    })
    entries :: jet_env_config_entries(prefix, dotenv.as_ref(), allow, ^process).map_err(fn(reason) { FieldError.one("E2416: {reason}") })?
    tree := DataTree.Object([])
    origins := [(String, String)]{}
    loop entry in ^entries {
        renamed :: names.iter().find(fn(pair) {
            (env_name, _) :: pair
            entry.name.eq_ignore_ascii_case(env_name)
                || entry.name.get(prefix.len()..).is_some_and(fn(suffix) { suffix.eq_ignore_ascii_case(env_name) })
        })
        if renamed == Val((_, key)) -> entry.segments = [key.to_string()]
        &origins.push((^entry.name, entry.segments.join(".")))
        jet_env_insert_tree(&tree, entry.segments, ^entry.value)
    }
    T.jet_decode(&tree).map_err(fn(errors) {
        errors.into_iter().map(fn(error) {
            path :: error.path.clone()
            reason :: std.mem.take(&error.reason)
            error.reason = jet_env_config_error_reason(&path, &reason, &origins)
            ^error
        }).collect()
    })
}
