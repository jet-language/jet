fn sanitize_test_name(name: &String) -> String {
    out := String.new()
    loop ch in name.chars() {
        if ch.is_ascii_alphanumeric() || ch == '-' || ch == '_' -> &out.push(ch)
        else -> &out.push('_')
    }
    if out.is_empty() -> "case" else -> ^out
}
