// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:213
fn jet_std_io_secret_error(error: JetTermSecretError) -> IOError {
    projection :: jet_term_secret_error_projection(&error)
    message :: error.message()
    operation :: match projection.operation { .Read -> IOOperation.Read; .Flush -> IOOperation.Flush }
    resource :: Val(projection.resource.to_string())
    match projection.kind {
        .InvalidInput -> IOError.InvalidInput(IOContext.new(operation, ^resource, None, Val(^message)))
        .Other -> IOError.other(operation, ^resource, ^message)
    }
}
