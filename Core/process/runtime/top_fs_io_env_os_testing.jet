            &names.push((entry.name.clone(), decoded_name.to_string()))
        }
        &names.sort_by(fn(left, right) {
            folded :: jet_env_key_cmp(left.0, right.0)
            if folded != Ordering.Equal -> return folded
            if core.sys.target.selected_family() == .Windows {
                OsStr.from_encoded_bytes_unchecked(left.0).encode_wide().cmp(OsStr.from_encoded_bytes_unchecked(right.0).encode_wide())
