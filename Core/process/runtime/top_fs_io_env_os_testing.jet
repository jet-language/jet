// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:906
fn jet_testing_corpus(path: &String) -> [String] {
    entries := [String]{}
    // GATE #4565: kernel primitive
    #Unsafe("real directory enumeration; lexically sorted native paths, skip unreadable and non-file entries") {
        if std.fs.read_dir(OSPath.new(path)) == Ok(read) {
            paths := read.filter_map(fn(e) { e.ok().map(fn(e) { e.path() }) }).collect<[OSPath]>()
