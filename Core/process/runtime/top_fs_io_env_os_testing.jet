fn jet_std_fs_walk_with_ignore(path: &String, ignore_name: String?) -> [WalkEntry] IOError! {
    if jet_fault_should_fail("FS.Read") -> return Err(IOError.other(IOOperation.Read, Val(path.clone()), "fault injected: FS.Read"))
    out := jet_fs_walk_parallel_with_ignore(path, path, ignore_name,
        fn(path, relative, is_dir, depth) { WalkEntry{path: ^path, relative: ^relative, is_dir: is_dir, depth: depth} },
        fn(shown, error) { io_error_at(IOOperation.Read, shown, error) })?
    &out.sort_by(fn(left, right) { left.path.cmp(right.path) })
    Ok(^out)
}
