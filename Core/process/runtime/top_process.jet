    if Some(error) :: first_error -> return Err(^error)
    output.exceeded = output_exceeded
    Ok((^output, ^errors))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1383
fn jet_process_collect_output(drains: (JoinHandle<JetProcessOutput io.Error!>?, JoinHandle<JetProcessOutput io.Error!>?))
    -> (String, String, Bool) IOError! {
    // Both workers are joined even when stdout fails; retain stdout error precedence.
    output :: jet_process_finish_output_drain(^drains.0, "process stdout")
    errors :: jet_process_finish_output_drain(^drains.1, "process stderr")
