fn jet_process_drain_reader<R: io.Read + Send>(reader: R?, limit: Usize?, budget: Arc<AtomicUsize>?,
    limit_hit: Arc<AtomicBool>, cancel: Arc<AtomicBool>?, groups: Arc<Mutex<[U32]>>?, group_pid: U32?)
    -> JoinHandle<JetProcessOutput io.Error!>? {
