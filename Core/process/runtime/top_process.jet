fn jet_process_output_worker<R: io.Read + Send>(reader: R, state: Arc<ProcessOutputState>, terminal_eof: Bool,
    limit: Usize?, budget: Arc<AtomicUsize>?, limit_hit: Arc<AtomicBool>, read_error: Arc<AtomicBool>, group_pid: U32?) -> () io.Error! {
