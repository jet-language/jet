const JET_PROCESS_IO_CHUNK_BYTES: Usize = 16 * 1024
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:217
fn jet_process_output_buffer_capacity(limit: Usize?) -> Usize {
