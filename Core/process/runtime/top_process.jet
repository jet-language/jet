    #Unsafe("hold native output mutex and condition-wait until bytes, first read error, or EOF is observable") {
        buffer := state.bytes.lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() })
        loop {
            if buffer.cursor < buffer.bytes.len() {
                available :: &buffer.bytes[buffer.cursor..]
                count :: available.len().min(bytes.len())
                bytes[..count].copy_from_slice(&available[..count])
                buffer.cursor += count
                return Ok(count)
            }
            if Some((kind, message)) :: &buffer.error -> return Err(io.Error.new(kind, message.clone()))
            if buffer.closed -> return Ok(0)
            buffer = state.ready.wait(^buffer).unwrap_or_else(fn(poisoned) { poisoned.into_inner() })
        }
    }
}
