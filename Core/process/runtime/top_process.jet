// No pipe fallback: interactive terminal behavior requires a real PTY/ConPTY.
fn jet_process_terminal_backend_check(spec: &ProcessSpec) -> () IOError! {
    if spec.terminal.is_none() || jet_process_pty.supported() -> return Ok(())
    Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(),
        "terminal sessions need a native PTY or ConPTY backend, and this build has none"))
}
