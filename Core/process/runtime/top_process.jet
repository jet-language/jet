// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:112
// Reject unenforceable resource requests before any native child is spawned.
fn jet_process_resource_limits_check(spec: &ProcessSpec) -> () IOError! {
    os :: target.selected_os()
    if os == .MacOS && (spec.memory_limit_bytes.is_some() || spec.open_file_limit.is_some()) {
        return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(),
            "macOS can enforce CPU limits here, but cannot report typed memory or open-file exhaustion; refusing those requests before spawn"))
    }
    if os == .Windows {
        if spec.open_file_limit.is_some() {
            return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(),
                "open_file_limit cannot be enforced by Windows Job Objects; refusing before spawn"))
        }
        if spec.policy_wire.is_some() && (spec.cpu_time_limit_ms.is_some() || spec.memory_limit_bytes.is_some()) {
            return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(),
                "authority-bound Windows CPU and memory limits are unsupported by the captured runner; refusing before spawn"))
        }
        if spec.detached && (spec.cpu_time_limit_ms.is_some() || spec.memory_limit_bytes.is_some()) {
            return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(),
                "detached Windows children cannot carry CPU or memory Job Object limits; refusing before spawn"))
        }
    }
    if os != .Linux && os != .MacOS && os != .Windows
        && (spec.cpu_time_limit_ms.is_some() || spec.memory_limit_bytes.is_some() || spec.open_file_limit.is_some()) {
        return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(),
            "process CPU, memory, and open-file limits are unsupported on this target; refusing before spawn"))
    }
    Ok(())
}
