const JET_PROCESS_TOPOLOGY_SOURCE: String = "process-runtime"
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:3
fn jet_process_topology_now() -> U64 {
    // GATE #4565: kernel primitive
    #Unsafe("sample real system wall time and checked milliseconds without substituting a process-relative clock") {
        SystemTime.now().duration_since(UNIX_EPOCH).ok().and_then(fn(duration) { U64.try_from(duration.as_millis()).ok() }).unwrap_or(0)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:11
fn jet_process_publish_topology(pid: U32, state: JetDevtoolsTopologyProcessState) -> {
    fact :: JetDevtoolsTopologyProcessFact.new("process:{pid}", JET_PROCESS_TOPOLOGY_SOURCE, None, state,
        Some(pid as U64), [], JetDevtoolsTopologyFreshness.fresh(jet_process_topology_now()))
    if Ok(fact) :: fact {
        if Ok(event) :: fact.to_protocol_event(JET_PROCESS_TOPOLOGY_SOURCE) -> jet_devtools_publish_event(^event)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:30
fn jet_process_publish_topology_id(pid: I64, state: JetDevtoolsTopologyProcessState) -> {
    if Ok(pid) :: U32.try_from(pid) {
        if pid != 0 -> jet_process_publish_topology(pid, state)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:42
// Signal subscription is infallible; native arming failure takes the shared panic path.
fn jet_process_on_signal(signal: &ProcessSignal) -> {
    _ :: jet_scheduler_root_task_control()
    // GATE #4565: kernel primitive
    callback :: #Unsafe("retain Send+Sync static cancellation callback for the registered process signal") {
        Arc.new(fn() { jet_scheduler_root_task_control().cancel() })
    }
    if Err(message) :: jet_process_signal_register(signal.mask(), ^callback) {
        jet_panic(&"", 0, &jet_process_signal_error(message))
    }
}
