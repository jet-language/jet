// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1324
fn jet_process_finish_output_drain(drain: JoinHandle<JetProcessOutput io.Error!>?, stream: String) -> JetProcessOutput IOError! {
    if drain.is_none() -> return Ok(JetProcessOutput{text: "", exceeded: false})
