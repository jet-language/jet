// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:223
fn jet_process_stdio(mode: &ProcessStreamMode) -> Stdio {
    // GATE #4565: kernel primitive
    #Unsafe("create native stdio configuration; Capture and Stream both pipe but differ in the consuming API") {
        match mode {
            ProcessStreamMode.Stream | ProcessStreamMode.Capture -> Stdio.piped()
            ProcessStreamMode.Inherit -> Stdio.inherit()
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:234
// One logical environment composition for ordinary and native Windows launches.
fn jet_process_environment(spec: &ProcessSpec) -> [JetEnvEntry] IOError! {
    child_env := if spec.env_clear { [] } else { jet_std_env_snapshot_raw() }
    loop (name, value) in &spec.env_set {
        jet_env_validate_name(name).map_err(fn(error) {
            IOError.InvalidInput(IOContext.new(IOOperation.Resolve, Some(name.clone()), None, Some(error.jet_show())))
        })?
        jet_env_validate_value(value).map_err(fn(error) {
            IOError.InvalidInput(IOContext.new(IOOperation.Resolve, Some(name.clone()), None, Some(error.jet_show())))
        })?
        // GATE #4565: kernel primitive
        #Unsafe("encode selected native OS strings without losing non-Unicode inherited entries") {
            os_name :: OsString.from(name).into_encoded_bytes()
            child_env.retain(fn(entry) { !jet_env_key_eq(entry.name, os_name) })
            child_env.push(JetEnvEntry{name: ^os_name, value: OsString.from(value).into_encoded_bytes()})
        }
    }
    loop name in &spec.env_remove {
        jet_env_validate_name(name).map_err(fn(error) {
            IOError.InvalidInput(IOContext.new(IOOperation.Resolve, Some(name.clone()), None, Some(error.jet_show())))
        })?
        // GATE #4565: kernel primitive
        #Unsafe("compare validated name against selected-native raw logical environment keys") {
            os_name :: OsStr.new(name).as_encoded_bytes()
            child_env.retain(fn(entry) { !jet_env_key_eq(entry.name, os_name) })
        }
    }
    Ok(^child_env)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:280
fn jet_process_command_builder_with_identity(spec: &ProcessSpec, executable_identity: String?) -> Command IOError! {
    if spec.cmd.is_empty() {
        return Err(IOError.InvalidInput(IOContext.new(IOOperation.Resolve, None, None, Some("process command needs at least one word"))))
    }
    // GATE #4565: kernel primitive
    #Unsafe("configure one real native child command with a synchronous atomic logical-environment snapshot") {
        command := Command.new(executable_identity.unwrap_or(spec.cmd[0]))
        command.args(&spec.cmd[1..])
        if Some(cwd) :: &spec.cwd -> command.current_dir(cwd)
        if spec.env_clear || !spec.env_set.is_empty() || !spec.env_remove.is_empty() {
            child_env :: jet_process_environment(spec)?
            command.env_clear()
            command.envs(child_env.iter().map(fn(entry) {
                (OsStr.from_encoded_bytes_unchecked(entry.name), OsStr.from_encoded_bytes_unchecked(entry.value))
            }))
        } else {
            // The guard lives through envs: no whole-table clone for ordinary children.
            child_env :: jet_env_read()
            command.env_clear()
            command.envs(child_env.iter().map(fn(entry) {
                (OsStr.from_encoded_bytes_unchecked(entry.name), OsStr.from_encoded_bytes_unchecked(entry.value))
            }))
        }
        Ok(^command)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:312
fn jet_process_command_base_with_identity(spec: &ProcessSpec, executable_identity: String?) -> Command IOError! {
    command := jet_process_command_builder_with_identity(spec, executable_identity)?
    // GATE #4565: kernel primitive
    #Unsafe("configure closed stdin by default, never inherit parent stdin accidentally") {
        command.stdin(match &spec.stdin { Some(mode) -> jet_process_stdio(mode), None -> Stdio.null() })
        command.stdout(jet_process_stdio(&spec.stdout))
        command.stderr(jet_process_stdio(&spec.stderr))
    }
    Ok(^command)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:328
// Selected Unix caller only; process_group(0) keeps ordinary children eligible for posix_spawn.
fn jet_process_attach_process_group(command: &Command, spec: &ProcessSpec) -> () io.Error! {
    limits :: jet_process_native_limits(spec)
    if limits.cpu_time_ms.is_none() && limits.memory_bytes.is_none() && limits.open_files.is_none() {
        // GATE #4565: kernel primitive
        #Unsafe("assign the native child its own descendant process group through the Unix spawn backend") { command.process_group(0) }
        Ok(())
    } else { jet_process_pty.attach_process_group(command, limits) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:350
fn jet_process_sandbox_error(spec: &ProcessSpec, error: jet_process_sandbox.Error) -> IOError {
    detail :: match error { jet_process_sandbox.Error.Unsupported(detail) | jet_process_sandbox.Error.Io(detail) -> detail }
    IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(), detail)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:366
fn jet_process_sandbox_env(spec: &ProcessSpec) -> [String:String] IOError! {
    environment := [:]
    loop (name, value) in &spec.env_set {
        jet_env_validate_name(name).map_err(fn(error) {
            IOError.InvalidInput(IOContext.new(IOOperation.Resolve, Some(name.clone()), None, Some(error.jet_show())))
        })?
        jet_env_validate_value(value).map_err(fn(error) {
            IOError.InvalidInput(IOContext.new(IOOperation.Resolve, Some(name.clone()), None, Some(error.jet_show())))
        })?
        environment.insert(name.clone(), value.clone())
    }
    loop name in &spec.env_remove {
        jet_env_validate_name(name).map_err(fn(error) {
            IOError.InvalidInput(IOContext.new(IOOperation.Resolve, Some(name.clone()), None, Some(error.jet_show())))
        })?
        environment.remove(name)
    }
    Ok(^environment)
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:404
fn jet_process_receipt(spec: &ProcessSpec, plan: &ProcessPlan?, process_group: Bool, pid: I64, code: I64, success: Bool, signal: Int?, timed_out: Bool, output: String, errors: String, extra_secret_values: View<String>?) -> ProcessReceipt {
    owned_secret_values :: if extra_secret_values.is_none() { jet_process_policy_secret_values(spec) } else { [] }
    secret_values :: extra_secret_values.unwrap_or(owned_secret_values.as_slice())
    executable_identity :: plan.map(fn(plan) { plan.executable_identity.clone() })
        .or_else(fn() { jet_process_resolve_executable(spec).ok() }).or_else(fn() { spec.cmd.first().cloned() }).unwrap_or_default()
    argv :: plan.map(fn(plan) { plan.argv.clone() }).unwrap_or_else(fn() {
        spec.cmd.iter().map(fn(word) { jet_process_policy_redact(spec, word) }).collect<[String]>()
    })
    policy_digest :: plan.map(fn(plan) { plan.policy_digest.clone() }).unwrap_or_else(fn() {
        jet_process_policy_digest(spec, jet_process_backend_limits(target.selected_os()))
    })
    input_digest :: plan.map(fn(plan) { plan.input_digest.clone() }).unwrap_or_else(fn() { jet_process_input_digest(spec) })
    backend :: plan.map(fn(plan) { plan.backend.clone() }).unwrap_or_else(fn() { "ambient" })
    authority :: plan.map(fn(plan) { plan.authority.clone() }).unwrap_or_else(fn() { jet_process_policy_receipt_rights(spec) })
    descendants :: if spec.detached { "detached" } else if process_group { "contained" } else {
        plan.map(fn(plan) { plan.descendants.clone() }).unwrap_or_else(fn() { "direct" })
    }
    limits :: plan.map(fn(plan) { plan.limits.clone() }).unwrap_or_else(fn() {
        jet_process_policy_limits(spec, jet_process_backend_limits(target.selected_os()))
    })
    outputs := plan.map(fn(plan) { plan.outputs.clone() }).unwrap_or_else(fn() { jet_process_policy_outputs(spec) })
    captured_bytes :: output.len() + errors.len()
    outputs.push("captured-bytes={captured_bytes}")
    redacted :: spec.policy_wire.is_some() || !secret_values.is_empty()
    ProcessReceipt{
        code: code as Int, output: jet_process_redact_text(output, secret_values),
        errors: jet_process_redact_text(errors, secret_values), success: success, signal: signal, timed_out: timed_out,
        executable_identity: ^executable_identity, argv: ^argv, input_digest: ^input_digest,
        policy_digest: ^policy_digest, backend: ^backend, authority: ^authority,
        descendants: ^descendants, limits: ^limits, outputs: ^outputs, redacted: redacted,
        pid: pid as Int, limit_hit: timed_out.then_some(ProcessResourceLimit.WallTime)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:487
fn jet_process_child_from_inner(child: Child, spec: &ProcessSpec, process_group: Bool, plan: ProcessPlan?) -> ProcessChild IOError! {
    // GATE #4565: kernel primitive
    #Unsafe("own the real child, native Job boundary, pipe-drain workers and shared lifecycle state; reap failed Job attachments") {
        child := ^child
        job :: if target.selected_os() == .Windows && !spec.detached {
            match jet_process_pty.attach_job(child.as_raw_handle(), jet_process_native_limits(spec)) {
                Ok(job) -> Some(Rc.new(^job))
                Err(error) -> {
                    _ :: child.kill()
                    _ :: child.wait()
                    return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(), error))
                }
            }
        } else { None }
        process_group :: process_group || job.is_some()
        pid :: child.id()
        output_limit :: spec.output_limit.map(fn(limit) { limit.max(0) as Usize })
        output_budget :: output_limit.map(fn(_) { Arc.new(AtomicUsize.new(0)) })
        output_limit_hit :: Arc.new(AtomicBool.new(false))
        output_read_error :: Arc.new(AtomicBool.new(false))
        (stdout, stdout_state, stdout_worker) :: jet_process_spawn_output_reader(child.stdout.take(), false, output_limit,
            output_budget.clone(), output_limit_hit.clone(), output_read_error.clone(), process_group.then_some(pid))
        (stderr, stderr_state, stderr_worker) :: jet_process_spawn_output_reader(child.stderr.take(), false, output_limit,
            ^output_budget, output_limit_hit.clone(), output_read_error.clone(), process_group.then_some(pid))
        jet_process_publish_topology(pid, JetDevtoolsTopologyProcessState.Starting)
        jet_process_publish_topology(pid, JetDevtoolsTopologyProcessState.Running)
        Ok(ProcessChild{
            wait_result: Rc.new(RefCell.new(None)), cleanup_error: Rc.new(RefCell.new(None)),
            stdin: Rc.new(RefCell.new(child.stdin.take().map(ProcessStdin.Pipe))),
            stdout: Rc.new(RefCell.new(^stdout)), stderr: Rc.new(RefCell.new(^stderr)),
            stdout_state: ^stdout_state, stderr_state: ^stderr_state,
            stdout_worker: Rc.new(RefCell.new(^stdout_worker)), stderr_worker: Rc.new(RefCell.new(^stderr_worker)),
            output_limit_hit: ^output_limit_hit, output_read_error: ^output_read_error,
            terminal: None, process_group: process_group, detached: spec.detached,
            inner: Rc.new(RefCell.new(Some(ProcessHandle.Std{child: ^child, job: ^job}))),
            timeout_ms: spec.timeout_ms, output_limit: spec.output_limit,
            audit_spec: Rc.new(spec.clone()), audit_plan: plan.map(fn(plan) { Rc.new(^plan) }), started: Instant.now()
        })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:572
fn jet_process_verify_launch_plan(spec: &ProcessSpec, plan: &ProcessPlan) -> () IOError! {
    status :: jet_process_sandbox.status()
    backend :: jet_process_isolation_backend(status.available, ^status.mechanism) ?? return Err(IOError.other(
        IOOperation.Resolve, spec.cmd.first().cloned(), "authority-bound process launch rejected because its isolation backend is unavailable"))
    if plan.backend != backend -> return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(),
        "authority-bound process launch rejected because its isolation backend changed after planning"))
    if plan.policy_digest != jet_process_policy_digest(spec, jet_process_backend_limits(target.selected_os())) {
        return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(),
            "authority-bound process launch rejected a policy digest change after planning"))
    }
    if plan.input_digest != jet_process_input_digest(spec) {
        return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(),
            "authority-bound process launch rejected because its argv inputs changed after planning"))
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:607
fn jet_process_pipeline_resource_limits_check(spec: &ProcessSpec) -> () IOError! {
    jet_process_resource_limits_check(spec)?
    if target.selected_os() == .Windows && (spec.cpu_time_limit_ms.is_some() || spec.memory_limit_bytes.is_some()) {
        return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(),
            "Windows process pipelines cannot attach declared CPU or memory Job Object limits; refusing before spawn"))
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:621
// The implicit receipt ceiling needs no relay on a bounded kernel pipe; explicit different limits do.
fn jet_process_pipeline_needs_relay(spec: &ProcessSpec) -> Bool {
    spec.output_limit.is_some_and(fn(limit) { limit != JET_PROCESS_DEFAULT_OUTPUT_LIMIT_BYTES })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:630
fn jet_process_policy_sandbox_cwd(spec: &ProcessSpec) -> OSPath IOError! {
    // GATE #4565: kernel primitive
    absolute :: #Unsafe("query actual selected-native cwd absoluteness for authority policy validation") {
        spec.cwd.as_ref().is_some_and(fn(cwd) { OSPath.new(cwd).is_absolute() })
    }
    Ok(OSPath.new(jet_process_policy_authority_cwd(spec, absolute)?.unwrap_or("/")))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:638
fn jet_process_spec_spawn(spec: &ProcessSpec) -> ProcessChild IOError! {
    jet_process_resource_limits_check(spec)?
    launch_plan :: if spec.policy_wire.is_some() { Some(jet_process_spec_plan(spec)?) } else { None }
    jet_process_spec_backend_check(spec, jet_process_sandbox.status().available)?
    if Some(plan) :: launch_plan.as_ref() -> jet_process_verify_launch_plan(spec, plan)?
    jet_process_terminal_backend_check(spec)?
    if spec.terminal.is_some() {
        return jet_process_terminal_spawn(spec, launch_plan.as_ref().map(fn(plan) { plan.executable_identity.as_str() }), launch_plan.as_ref())
    }
    os :: target.selected_os()
    if (os == .Linux || os == .MacOS) && spec.policy_wire.is_some() {
        plan :: launch_plan.as_ref().expect("authority launch must have a plan")
        cwd :: jet_process_policy_sandbox_cwd(spec)?
        sandbox_scope :: jet_process_policy_sandbox_scope(spec, plan.executable_identity)?
        output_dir :: if sandbox_scope.output_writable {
            Some(jet_process_sandbox.agent_output_dir(cwd).map_err(fn(error) { jet_process_sandbox_error(spec, error) })?)
        } else { None }
        environment :: jet_process_sandbox_env(spec)?
        // GATE #4565: kernel primitive
        child :: #Unsafe("spawn actual authority-confined child with sorted BTree-equivalent environment and descendant group enforcement") {
            jet_process_sandbox.spawn(OSPath.new(plan.executable_identity), &spec.cmd[1..], cwd, output_dir.as_ref(),
                &environment, sandbox_scope.share_network, sandbox_scope.source_readable, false,
                spec.cmd.first().map(fn(word) { OsStr.new(word.as_str()) }), fn(command) {
                    if spec.detached {
                        command.stdin(Stdio.null())
                        command.stdout(Stdio.null())
                        command.stderr(Stdio.null())
                    } else {
                        command.stdin(match &spec.stdin { Some(mode) -> jet_process_stdio(mode), None -> Stdio.null() })
                        command.stdout(jet_process_stdio(&spec.stdout))
                        command.stderr(jet_process_stdio(&spec.stderr))
                    }
                    jet_process_pty.attach_process_group(command, jet_process_native_limits(spec))
                        .map_err(fn(error) { jet_process_sandbox.Error.Io(error.to_string()) })?
                    Ok(())
                }).map_err(fn(error) { jet_process_sandbox_error(spec, error) })?
        }
        return jet_process_child_from_inner(^child, spec, true, launch_plan.clone())
    }
    if os == .Windows && spec.policy_wire.is_some() {
        return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(),
            "authority-bound Windows process children require capture via run(); refusing an unsandboxed spawn"))
    }
    command := jet_process_command_base_with_identity(spec, launch_plan.as_ref().map(fn(plan) { plan.executable_identity.as_str() }))?
    // GATE #4565: kernel primitive
    #Unsafe("spawn a real ordinary child, closed detached streams, and selected-Unix descendant boundary") {
        if spec.detached {
            command.stdin(Stdio.null())
            command.stdout(Stdio.null())
            command.stderr(Stdio.null())
        }
        if target.selected_family() == .Unix {
            jet_process_attach_process_group(&command, spec)
                .map_err(fn(error) { IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(), error) })?
        }
        child :: command.spawn().map_err(fn(error) { IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(), error) })?
        jet_process_child_from_inner(^child, spec, target.selected_family() == .Unix, ^launch_plan)
    }
}

