fn jet_process_spawn_output_reader<R: io.Read + Send>(reader: R?, terminal_eof: Bool, limit: Usize?,
    budget: Arc<AtomicUsize>?, limit_hit: Arc<AtomicBool>, read_error: Arc<AtomicBool>, group_pid: U32?)
