// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1348
fn jet_process_collect_pipeline_drains(output_drain: JoinHandle<JetProcessOutput io.Error!>?,
    stderr_drains: [JoinHandle<JetProcessOutput io.Error!>?]) -> (JetProcessOutput, String) IOError! {
    first_error := None
    output := JetProcessOutput{text: "", exceeded: false}
    match jet_process_finish_output_drain(^output_drain, "pipeline stdout") {
        Ok(result) -> output = ^result
        Err(error) -> first_error = Some(^error)
    }
    output_exceeded := output.exceeded
    errors := ""
    loop drain in ^stderr_drains {
        match jet_process_finish_output_drain(^drain, "pipeline stderr") {
            Ok(result) -> {
                output_exceeded |= result.exceeded
                errors.push_str(&result.text)
            }
            Err(error) -> if first_error.is_none() -> first_error = Some(^error)
        }
