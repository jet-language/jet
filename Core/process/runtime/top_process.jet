}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1454
fn jet_process_spec_run_windows(spec: &ProcessSpec) -> ProcessReceipt IOError! {
    if spec.detached || spec.terminal.is_some() || spec.stdin.is_some()
        || spec.stdout != ProcessStreamMode.Capture || spec.stderr != ProcessStreamMode.Capture {
        return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(),
            "authority-bound Windows execution requires non-detached capture streams and closed stdin"))
    }
    plan :: jet_process_spec_plan(spec)?
    jet_process_verify_launch_plan(spec, &plan)?
    cwd :: jet_process_policy_sandbox_cwd(spec)?
    sandbox_scope :: jet_process_policy_sandbox_scope(spec, &plan.executable_identity)?
    output_dir :: if sandbox_scope.output_writable {
        Some(jet_process_sandbox.agent_output_dir(cwd).map_err(fn(error) { jet_process_sandbox_error_windows(spec, error) })?)
    } else { None }
    environment :: jet_process_sandbox_env(spec)?
    // GATE #4565: kernel primitive
    #Unsafe("execute captured authority-bound native Windows runner with timeout, byte limits and backend identity verification") {
        result :: jet_process_sandbox.windows_output(OSPath.new(&plan.executable_identity), &spec.cmd[1..], cwd,
            output_dir.as_ref(), &environment, sandbox_scope.share_network, sandbox_scope.source_readable, false,
            spec.timeout_ms, spec.output_limit).map_err(fn(error) { jet_process_sandbox_error_windows(spec, error) })?
        if result.mechanism != plan.backend {
            return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(),
                "authority-bound Windows launch returned a different isolation backend"))
        }
        output :: String.from_utf8(^result.output.stdout)
            .map_err(fn(error) { IOError.other(IOOperation.Read, Some("process stdout"), error) })?
        errors :: String.from_utf8(^result.output.stderr)
            .map_err(fn(error) { IOError.other(IOOperation.Read, Some("process stderr"), error) })?
        Ok(jet_process_receipt(spec, Some(&plan), true, result.pid, result.output.status.code().unwrap_or(-1) as I64,
            result.output.status.success(), Err(JetAbsent{}), result.timed_out, ^output, ^errors, None))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1533
fn jet_process_sandbox_error_windows(spec: &ProcessSpec, error: jet_process_sandbox.WindowsSandboxError) -> IOError {
    detail :: match error {
        jet_process_sandbox.WindowsSandboxError.Unsupported(detail) | jet_process_sandbox.WindowsSandboxError.Io(detail) -> ^detail
    }
    IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(), ^detail)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1549
fn jet_process_direct_group_cleanup(pid: U32) -> IOError? {
    // GATE #4565: kernel primitive
    #Unsafe("kill remaining real Unix descendants after leader wait; already absent group is successful cleanup") {
        match jet_process_pty.signal_group(pid, jet_process_signal_kill()) {
            Ok(()) -> None
            Err(error) -> if error.kind() == io.ErrorKind.NotFound { None } else { Some(jet_process_cleanup_io_error(^error)) }
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1558
fn jet_process_spec_run_direct(spec: &ProcessSpec) -> ProcessReceipt IOError! {
    command := jet_process_command_base_with_identity(spec, None)?
    // GATE #4565: kernel primitive
    #Unsafe("ordinary Unix blocking wait owns process group and two bounded drains; cancellation and all failure paths reap child and readers") {
        jet_process_attach_process_group(&command, spec)
            .map_err(fn(error) { IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(), error) })?
        child := command.spawn().map_err(fn(error) { IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(), error) })?
        child_pid :: child.id()
        pid :: child_pid as I64
        // Pipe-owning drain workers stop the group; no supervisor polling needed.
        output_limit :: spec.output_limit.map(fn(limit) { limit.max(0) as Usize })
        output_budget :: output_limit.map(fn(_) { Arc.new(AtomicUsize.new(0)) })
        output_limit_hit :: Arc.new(AtomicBool.new(false))
        output_drain :: jet_process_drain_reader(child.stdout.take(), output_limit, output_budget.clone(),
            output_limit_hit.clone(), None, None, Some(child_pid))
        stderr_drain :: jet_process_drain_reader(child.stderr.take(), output_limit, ^output_budget,
            output_limit_hit.clone(), None, None, Some(child_pid))
        cancel_control :: jet_scheduler_current_task_control()
        cancel_guard :: cancel_control.as_ref().map(fn(control) {
            control.register_cancel_callback(Arc.new(fn() { jet_process_pipeline_stop_group(child_pid) }))
        })
        jet_process_publish_topology_id(pid, JetDevtoolsTopologyProcessState.Starting)
        jet_process_publish_topology_id(pid, JetDevtoolsTopologyProcessState.Running)
        wait :: match child.wait() {
            Ok(status) -> Ok(^status)
            Err(error) -> {
                jet_process_pipeline_stop_group(child_pid)
                _ :: child.kill()
                _ :: child.wait()
                Err(^error)
            }
        }
        drop(^cancel_guard)
        cleanup_error :: wait.as_ref().ok().and_then(fn(_) { jet_process_direct_group_cleanup(child_pid) })
        drained :: jet_process_collect_output((^output_drain, ^stderr_drain))
        cancellation_pending :: cancel_control.as_ref().is_some_and(fn(control) { control.cancelled.load(Ordering.Acquire) })
        (output, errors, output_exceeded) :: match drained {
            Ok(drained) -> ^drained
            Err(error) -> {
                jet_process_publish_topology_id(pid, JetDevtoolsTopologyProcessState.Failed)
                if cancellation_pending && !jet_scheduler_shielded() -> jet_task_deliver_cancel()
                return Err(^error)
            }
        }
        if cancellation_pending && !jet_scheduler_shielded() {
            jet_process_publish_topology_id(pid, JetDevtoolsTopologyProcessState.Failed)
            jet_task_deliver_cancel()
        }
        status :: match wait {
            Ok(status) -> ^status
            Err(error) -> {
                jet_process_publish_topology_id(pid, JetDevtoolsTopologyProcessState.Failed)
                return Err(IOError.other(IOOperation.Close, Some("process"), ^error))
            }
        }
        if Some(error) :: cleanup_error {
            jet_process_publish_topology_id(pid, JetDevtoolsTopologyProcessState.Failed)
            return Err(^error)
        }
        if output_exceeded || output_limit_hit.load(Ordering.Acquire) {
            jet_process_publish_topology_id(pid, JetDevtoolsTopologyProcessState.Failed)
            return Err(IOError.ResourceLimit(ProcessResourceLimit.Output))
        }
        signal :: jet_outcome_of(ExitStatusExt.signal(&status).map(fn(value) { value as I64 }).map(JetInt.from_i64))
        result :: jet_process_receipt(spec, None, true, pid, status.code().unwrap_or(-1) as I64,
            status.success(), ^signal, false, ^output, ^errors, None)
        jet_process_publish_topology_id(pid, if status.success() { JetDevtoolsTopologyProcessState.Exited } else { JetDevtoolsTopologyProcessState.Failed })
        Ok(^result)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1698
fn jet_process_spec_can_run_direct(spec: &ProcessSpec) -> Bool {
    spec.policy_wire.is_none() && spec.terminal.is_none() && !spec.detached && spec.stdin.is_none()
        && spec.stdout == ProcessStreamMode.Capture && spec.stderr == ProcessStreamMode.Capture
        && spec.timeout_ms.is_none() && spec.cpu_time_limit_ms.is_none()
        && spec.memory_limit_bytes.is_none() && spec.open_file_limit.is_none()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1711
fn jet_process_spec_run_inner(spec: &ProcessSpec) -> ProcessReceipt IOError! {
    if target.selected_os() == .Windows && spec.policy_wire.is_some() -> return jet_process_spec_run_windows(spec)
    if target.selected_family() == .Unix && jet_process_spec_can_run_direct(spec) -> return jet_process_spec_run_direct(spec)
    child :: jet_process_spec_spawn(spec)?
    jet_process_child_wait(&child)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1725
fn jet_process_spec_run(spec: &ProcessSpec) -> ProcessReceipt IOError! { jet_process_spec_run_inner(spec) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1730
fn jet_process_checked_stderr(errors: String) -> String {
    const LIMIT: Usize = 4096
    if errors.len() <= LIMIT -> return errors.to_string()
    end := LIMIT
    loop !errors.is_char_boundary(end) -> end -= 1
    errors[..end].to_string()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1741
fn jet_process_spec_run_checked(spec: &ProcessSpec) -> ProcessReceipt IOError! {
    result :: jet_process_spec_run(spec)?
    if result.success -> return Ok(^result)
    cause := "process exited unsuccessfully: code={result.code}"
    if Ok(signal) :: result.signal -> cause.push_str(", signal={signal}")
    cause.push_str(", stderr={jet_process_checked_stderr(&result.errors)}")
    Err(IOError.other(IOOperation.Close, spec.cmd.first().cloned(), ^cause))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Process.rs:1764
fn jet_process_sandbox_pipeline_spawn(spec: &ProcessSpec, launch_plan: &ProcessPlan, input: ChildStdout?) -> Child IOError! {
    if spec.terminal.is_some() {
        return Err(IOError.other(IOOperation.Resolve, spec.cmd.first().cloned(),
            "terminal sessions cannot be used as pipeline stages; spawn the session directly"))
    }
    cwd :: jet_process_policy_sandbox_cwd(spec)?
    sandbox_scope :: jet_process_policy_sandbox_scope(spec, &launch_plan.executable_identity)?
    output_dir :: if sandbox_scope.output_writable {
        Some(jet_process_sandbox.agent_output_dir(cwd).map_err(fn(error) { jet_process_sandbox_error(spec, error) })?)
    } else { None }
    environment :: jet_process_sandbox_env(spec)?
    // GATE #4565: kernel primitive
    #Unsafe("spawn real confined pipeline stage with inherited upstream pipe and enforced descendant group limits") {
        jet_process_sandbox.spawn(OSPath.new(&launch_plan.executable_identity), &spec.cmd[1..], cwd,
            output_dir.as_ref(), &environment, sandbox_scope.share_network, sandbox_scope.source_readable, false,
            spec.cmd.first().map(fn(word) { OsStr.new(word.as_str()) }), fn(command) {
                if Some(stdout) :: input {
                    command.stdin(Stdio.from(^stdout))
                } else {
                    command.stdin(match &spec.stdin { Some(mode) -> jet_process_stdio(mode), None -> Stdio.null() })
                }
                command.stdout(Stdio.piped())
                command.stderr(Stdio.piped())
                jet_process_pty.attach_process_group(command, jet_process_native_limits(spec))
                    .map_err(fn(error) { jet_process_sandbox.Error.Io(error.to_string()) })?
                Ok(())
            }).map_err(fn(error) { jet_process_sandbox_error(spec, error) })
    }
}

