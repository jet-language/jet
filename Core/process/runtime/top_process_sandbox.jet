pub fn read_output_limited<R: Read>(reader: ^R) -> ([U8], Bool) NativeIOError! {
    reader := ^reader
    output := [U8]{}.with_capacity(64 * 1024)
    // GATE #4565: kernel primitive — native inline array, not a growable allocation.
    buffer := #Unsafe("zero-initialize all65536 inline byte slots") { std.mem.zeroed<[U8#65536]>() }
    loop {
        // GATE #4565: kernel primitive
        count :: #Unsafe("read actual pipe into inline initialized64KiB buffer") { &reader.read(&buffer) } ?? return Err(err)
        if count == 0 -> return Ok((^output, false))
        remaining :: MAX_CAPTURED_OUTPUT_BYTES.saturating_sub(output.len())
        keep :: count.min(remaining)
        &output.extend_from_slice(buffer[0..<keep])
        if keep < count -> return Ok((^output, true))
    }
}
