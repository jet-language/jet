        exceeded :: Arc.new(AtomicBool.new(false))
        child_pid :: child.id()
        reader_failed :: Arc.new(AtomicBool.new(false))
        stdout_exceeded :: exceeded.clone()
        stdout_reader_failed :: reader_failed.clone()
        stderr_exceeded :: exceeded.clone()
        stderr_reader_failed :: reader_failed.clone()
        stdout_thread :: thread.spawn(() -> {
            result :: read_output_limited(^stdout)
            if result.as_ref().is_ok_and(pair -> pair.1) { stdout_exceeded.store(true, Ordering.Release) }
            if result.is_err() { stdout_reader_failed.store(true, Ordering.Release) }
            if target.selected_family() == .Unix && (result.as_ref().is_ok_and(pair -> pair.1) || result.is_err()) { _ :: terminate_process_group(child_pid) }
            ^result
        })
        stderr_thread :: thread.spawn(() -> {
            result :: read_output_limited(^stderr)
            if result.as_ref().is_ok_and(pair -> pair.1) { stderr_exceeded.store(true, Ordering.Release) }
            if result.is_err() { stderr_reader_failed.store(true, Ordering.Release) }
            if target.selected_family() == .Unix && (result.as_ref().is_ok_and(pair -> pair.1) || result.is_err()) { _ :: terminate_process_group(child_pid) }
            ^result
        })
        // With no Unix timeout, reader workers kill the group on cap/read failure.
        direct_wait :: target.selected_family() == .Unix && timeout.is_none()
        deadline :: timeout.map(limit -> Instant.now() + limit)
        timed_out := false
        child_reaped := false
        wait_error := None as NativeIOError?
        status := None as std.process.ExitStatus?
        known_descendants := [U32]{}
        if direct_wait {
            match &child.wait() {
                Ok(child_status) -> { child_reaped = true; status = Val(child_status) },
                Err(error) -> wait_error = Val(^error),
            }
        } else {
            loop {
                if target.selected_os() == .Linux { &known_descendants.extend(collect_descendant_pids(child.id())) }
                match &child.try_wait() {
                    Ok(Val(child_status)) -> { child_reaped = true; status = Val(child_status); break },
                    Ok(None) -> {
                        if exceeded.load(Ordering.Acquire) || reader_failed.load(Ordering.Acquire) -> break
                        if deadline.is_some_and(deadline -> Instant.now() >= deadline) { timed_out = true; break }
                        thread.sleep(Duration.from_millis(5))
                    },
                    Err(error) -> { wait_error = Val(^error); break },
                }
            }
        }
        cleanup_error :: terminate_process_tree(&child, child_reaped, known_descendants).err()
        stdout :: stdout_thread.join().map_err(_ -> Error.Io("sandbox stdout reader panicked")) ?? return Err(err)
        stdout :: stdout.map_err(error -> Error.Io(error.to_string())) ?? return Err(err)
        stderr :: stderr_thread.join().map_err(_ -> Error.Io("sandbox stderr reader panicked")) ?? return Err(err)
        stderr :: stderr.map_err(error -> Error.Io(error.to_string())) ?? return Err(err)
        if wait_error is Val(error) -> return Err(.Io(error.to_string()))
        if exceeded.load(Ordering.Acquire) -> return Err(.Io("sandbox process output exceeded {MAX_CAPTURED_OUTPUT_BYTES} bytes"))
        if timed_out {
            timeout :: timeout.expect("timeout flag requires a timeout")
            return Err(.Io("sandbox process timed out after {timeout.as_millis()}ms"))
        }
        if cleanup_error is Val(error) -> return Err(.Io(error.to_string()))
        status :: status.expect("sandbox child must exit or have a cleanup reason")
