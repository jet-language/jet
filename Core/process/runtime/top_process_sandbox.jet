// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ProcessSandbox.rs:269
pub fn spawn_with_read_only_mounts(executable: OSPath, args: [String], source_dir: OSPath, output_dir: OSPath?, env: [String:String], share_network: Bool, source_readable: Bool, source_writable: Bool, mounts: [ReadOnlyMount], argv0: OSPath?, configure: fn(&Command) -> () Error!) -> Child Error! {
    if target.selected_os() != .Linux && target.selected_os() != .MacOS {
        return Err(.Unsupported("native Windows AppContainer backend does not expose streaming spawn; use captured run()"))
    }
    // GATE #4565: kernel primitive — configure is the original once-only synchronous mutable Command callback.
    #Unsafe("validate authority paths and configure actual native sandbox command before spawn") {
        if native_env.var_os("JETPACK_FAKE_SANDBOX").is_some() -> return Err(.Unsupported("test sandbox override prevents child execution"))
        status :: status()
        if !status.available -> return Err(.Unsupported(^status.reason))
        executable :: executable.canonicalize().map_err(error -> Error.Unsupported("sandbox executable is unavailable: {error}")) ?? return Err(err)
        if !executable.is_file() -> return Err(.Unsupported("sandbox executable `{executable.display()}` is not a file"))
        source_dir :: real_directory(source_dir) ?? return Err(err)
        output_dir :: output_dir.map(real_directory).transpose() ?? return Err(err)
        mounts :: validate_read_only_mounts(mounts) ?? return Err(err)
        command_executable :: mounted_executable_path(executable, mounts)
        if target.selected_os() == .MacOS {
            profile :: build_profile(command_executable, source_dir, output_dir.as_ref(), share_network, source_readable, source_writable, mounts) ?? return Err(err)
            command := Command.new(MACOS_SANDBOX_EXEC)
            // Inline profile avoids replacement between spawn and Seatbelt read.
            &command.arg("-p").arg(profile).arg(command_executable).args(args).env_clear().current_dir(source_dir)
            if output_dir is Val(output_dir) { &command.env("JET_BUILD_OUTPUT", output_dir) }
            keys := env.keys().to_list()
            &keys.sort()
            loop key in keys { &command.env(key, env[key]) }
            configure(&command) ?? return Err(err)
            return command.spawn().map_err(error -> Error.Io(error.to_string()))
        }
        bwrap :: find_program_path("bwrap").ok_or_else(() -> Error.Unsupported("bubblewrap (`bwrap`) is not available on PATH")) ?? return Err(err)
        command := linux_sandbox_command(bwrap, Val(source_dir), output_dir.as_ref(), env, share_network, source_readable, source_writable, mounts, argv0)
        &command.arg(command_executable).args(args)
        configure(&command) ?? return Err(err)
        command.spawn().map_err(error -> Error.Io(error.to_string()))
    }
}
