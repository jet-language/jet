pub fn mounted_executable_path(executable: OSPath, mounts: [ReadOnlyMount]) -> OSPath {
    if target.selected_os() != .Linux -> return ~executable
    best := None as (USize, USize, @OSPath)? // #4303: relative path loan retains executable owner.
    loop i in 0..<mounts.len() {
        if executable.strip_prefix(mounts[i].source) is Ok(relative) {
            depth :: relative.components().count()
            // Rust max_by_key selects the last equal key, not the most-specific source.
            if best.is_none() || depth >= best.unwrap().0 { best = Val((depth, i, relative)) }
        }
    }
    match best { Val((_, i, relative)) -> mounts[i].destination.join(relative), None -> ~executable }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ProcessSandbox.rs:800
fn find_program_path(program: String) -> OSPath? {
    // GATE #4565: kernel primitive
    #Unsafe("search actual native PATH entries preserving OS bytes and canonicalize first existing file") {
        direct :: OSPath.new(program)
        if direct.components().count() > 1 && direct.is_file() -> return fs.canonicalize(direct).ok()
        native_env.var_os("PATH").and_then(paths -> native_env.split_paths(paths).find_map(directory -> {
            candidate :: directory.join(program)
            if candidate.is_file() -> fs.canonicalize(candidate).ok() else -> None
        }))
    }
}
