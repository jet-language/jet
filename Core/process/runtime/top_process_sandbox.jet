pub fn wait_with_limited_output(child: ^Child, timeout: Duration?) -> Output Error! {
    child := ^child
    // GATE #4565: kernel primitive — reader workers retain native Send+static pipe and Arc ownership.
    #Unsafe("drain both real child pipes concurrently with bounded capture, release/acquire failure signals and process-tree cleanup") {
