            },
            (Val(source), None) -> {
                if source_writable { &command.arg("--bind").arg(source).arg("/work") }
                else if source_readable { &command.arg("--ro-bind").arg(source).arg("/work") }
                else { &command.arg("--dir").arg("/work") }
                &command.arg("--chdir").arg("/work")
            },
            (None, None) -> { &command.arg("--dir").arg("/work").arg("--chdir").arg("/work") },
            (None, Val(output)) -> { &command.arg("--bind").arg(output).arg("/work").arg("--chdir").arg("/work") },
        }
        loop mount in mounts {
            destination := OSPath.new("/")
            loop component in mount.destination.components() {
                if component is .Normal(part) { &destination.push(part); &command.arg("--dir").arg(destination) }
            }
            &command.arg("--ro-bind").arg(mount.source).arg(mount.destination)
        }
        if share_network { &command.arg("--share-net") }
        keys := env.keys().to_list()
        &keys.sort()
        loop key in keys { &command.arg("--setenv").arg(key).arg(env[key]) }
        if argv0 is Val(argv0) { &command.arg("--argv0").arg(argv0) }
        // User executable/argv cannot be parsed as wrapper options.
        &command.arg("--")
        ^command
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ProcessSandbox.rs:933
fn secure_child_directory(parent: OSPath, name: String) -> OSPath Error! {
    // GATE #4565: kernel primitive
    #Unsafe("inspect child without following symlinks, create absent directory, then canonicalize") {
        path :: parent.join(name)
        match fs.symlink_metadata(path) {
            Ok(metadata) if metadata.file_type().is_symlink() -> return Err(.Unsupported("sandbox directory `{path.display()}` is a symlink")),
            Ok(metadata) if !metadata.is_dir() -> return Err(.Unsupported("sandbox directory `{path.display()}` is not a directory")),
            Ok(_) -> {},
            Err(error) if error.kind() == ErrorKind.NotFound -> { fs.create_dir(path).map_err(error -> Error.Io(error.to_string())) ?? return Err(err) },
            Err(error) -> return Err(.Io(error.to_string())),
        }
        real_directory(path)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ProcessSandbox.rs:958
pub fn probe_profile() -> String {
    "(version 1)\n(deny default)\n(import \"system.sb\")\n(allow process-exec (literal \"/usr/bin/true\"))\n(allow file-read* (subpath \"/System\") (subpath \"/usr\") (subpath \"/bin\") (subpath \"/nix/store\"))\n"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ProcessSandbox.rs:969
pub fn build_profile(executable: OSPath, source_dir: OSPath, output_dir: OSPath?, share_network: Bool, source_readable: Bool, source_writable: Bool, mounts: [ReadOnlyMount]) -> String Error! {
    executable :: sbpl_path(executable) ?? return Err(err)
    source_dir :: sbpl_path(source_dir) ?? return Err(err)
    output_dir :: output_dir.map(sbpl_path).transpose() ?? return Err(err)
    profile := "(version 1)\n(deny default)\n(import \"system.sb\")\n(allow process-fork)\n(allow process-exec\n"
    &profile.push_str("  (literal \"{executable}\")\n")
    loop mount in mounts {
        path :: sbpl_path(mount.source) ?? return Err(err)
        &profile.push_str("  (subpath \"{path}\")\n")
    }
    &profile.push_str(")\n(allow file-read*\n")
    if source_readable { &profile.push_str("  (subpath \"{source_dir}\")\n") }
    if output_dir is Val(output_dir) { &profile.push_str("  (subpath \"{output_dir}\")\n") }
    &profile.push_str("  (literal \"{executable}\")\n  (subpath \"/System\")\n  (subpath \"/usr/lib\")\n  (subpath \"/usr/bin\")\n  (subpath \"/bin\")\n  (subpath \"/sbin\")\n  (subpath \"/nix/store\")\n")
    loop mount in mounts {
        source :: sbpl_path(mount.source) ?? return Err(err)
        &profile.push_str("  (subpath \"{source}\")\n")
        if mount.destination != mount.source {
            destination :: sbpl_path(mount.destination) ?? return Err(err)
            &profile.push_str("  (subpath \"{destination}\")\n")
        }
    }
    &profile.push(')')
    if output_dir is Val(output_dir) { &profile.push_str("(allow file-write* (subpath \"{output_dir}\"))\n") }
    else if source_writable { &profile.push_str("(allow file-write* (subpath \"{source_dir}\"))\n") }
    if share_network { &profile.push_str("(allow network*)\n") } else { &profile.push_str("(deny network*)\n") }
    &profile.push_str("(deny device*)\n")
    Ok(^profile)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ProcessSandbox.rs:1034
pub fn sbpl_path(path: OSPath) -> String Error! {
    value :: path.to_str().ok_or_else(() -> Error.Unsupported("sandbox path is not valid UTF-8: {path.display()}")) ?? return Err(err)
    escaped := String.with_capacity(value.len())
    loop character in value.chars() {
        match character {
            '\\' -> &escaped.push_str("\\\\"), '"' -> &escaped.push_str("\\\""),
            character if character.is_control() -> return Err(.Unsupported("sandbox path contains a control character")),
            character -> &escaped.push(character),
        }
    }
    Ok(^escaped)
}
