// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ProcessSandbox.rs:58
pub fn policy(output_is_separate: Bool, share_network: Bool) -> String {
    if target.selected_os() == .Linux {
        filesystem :: if output_is_separate -> "source-readonly,output-private-copy" else -> "private-workspace-readwrite"
        network :: if share_network -> "declared-shared" else -> "isolated"
        return "filesystem={filesystem};process=private-pid,parent-death;network={network};environment=clear;devices=private-dev;privilege=no-new-privs+cap-drop-all;resources=tmpfs-64MiB"
    }
    filesystem :: if output_is_separate -> "source-readonly,output-readwrite" else -> "private-workspace-readwrite"
    network :: if share_network -> "declared-shared" else -> "denied"
    "filesystem={filesystem};process=declared-tool-and-fork;network={network};environment=clear;devices=denied;resources=none-declared"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ProcessSandbox.rs:92
pub fn status() -> Status {
    // GATE #4565: kernel primitive
    #Unsafe("probe actual sandbox provider without claiming unsupported targets are enforced") {
        if target.selected_os() == .Linux {
            if native_env.var_os("JETPACK_FAKE_SANDBOX").is_some() {
                return Status{available: false, mechanism: "linux-bwrap-unavailable", policy: "not-enforced", reason: "test sandbox override prevents the native Linux backend probe"}
            }
            bwrap :: match find_program_path("bwrap") {
                Val(path) -> path, None -> return Status{available: false, mechanism: "linux-bwrap-unavailable", policy: "not-enforced", reason: "bubblewrap (`bwrap`) is not available on PATH"},
            }
            probe :: match find_program_path("sh") {
                Val(path) -> path, None -> return Status{available: false, mechanism: "linux-bwrap-unavailable", policy: "not-enforced", reason: "bubblewrap is present but no immutable shell probe is available"},
            }
            policy :: policy(false, false)
            command := linux_sandbox_command(bwrap, None, None, [String:String]{}, false, false, false, [ReadOnlyMount]{}, None)
            &command.arg(probe).arg("-c").arg("exit 0")
            return match &command.status() {
                Ok(status) if status.success() -> Status{available: true, mechanism: "linux-bwrap", policy: ^policy, reason: "bubblewrap completed the isolated backend probe"},
                Ok(status) -> Status{available: false, mechanism: "linux-bwrap-unavailable", policy: "not-enforced", reason: "bubblewrap backend probe exited with {status}"},
                Err(error) -> Status{available: false, mechanism: "linux-bwrap-unavailable", policy: "not-enforced", reason: "bubblewrap backend probe failed: {error}"},
            }
        }
        if target.selected_os() == .MacOS {
            if native_env.var_os("JETPACK_FAKE_SANDBOX").is_some() {
                return Status{available: false, mechanism: "macos-seatbelt-unavailable", policy: "not-enforced", reason: "test sandbox override prevents the native macOS backend probe"}
            }
            if !OSPath.new(MACOS_SANDBOX_EXEC).is_file() {
                return Status{available: false, mechanism: "macos-seatbelt-unavailable", policy: "not-enforced", reason: "native macOS backend `{MACOS_SANDBOX_EXEC}` is unavailable"}
            }
            result :: Command.new(MACOS_SANDBOX_EXEC).arg("-p").arg(probe_profile()).arg("/usr/bin/true")
                .env_clear().stdin(Stdio.null()).stdout(Stdio.null()).stderr(Stdio.null()).status()
            return match result {
                Ok(status) if status.success() -> Status{available: true, mechanism: "macos-seatbelt", policy: policy(true, false), reason: "native macOS Seatbelt completed the isolated backend probe"},
                Ok(status) -> Status{available: false, mechanism: "macos-seatbelt-unavailable", policy: "not-enforced", reason: "native macOS Seatbelt backend probe exited with {status}"},
                Err(error) -> Status{available: false, mechanism: "macos-seatbelt-unavailable", policy: "not-enforced", reason: "native macOS Seatbelt backend probe failed: {error}"},
            }
        }
        if target.selected_os() == .Windows {
            native :: windows_status()
            return Status{available: native.available, mechanism: ^native.mechanism, policy: ^native.policy, reason: ^native.reason}
        }
        Status{available: false, mechanism: "unsupported", policy: "not-enforced", reason: "native child sandbox backend is unavailable on this target"}
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/ProcessSandbox.rs:227
pub fn agent_output_dir(cwd: OSPath) -> OSPath Error! {
    cwd :: real_directory(cwd) ?? return Err(err)
    jet_dir :: secure_child_directory(cwd, ".jet") ?? return Err(err)
    output :: secure_child_directory(jet_dir, "build") ?? return Err(err)
    if !output.starts_with(cwd) -> return Err(.Unsupported("authority-bound process output escaped its workspace"))
    Ok(^output)
}
