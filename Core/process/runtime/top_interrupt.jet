// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Interrupt.rs:225,230,235
fn jet_interrupt_arm_mask(mask: USize) -> () Err! {
    if target.selected_family() == .Unix -> return jet_os_interrupt_ffi.arm_mask_unix(mask)
    if target.selected_os() == "windows" -> return jet_os_interrupt_ffi.arm_mask_windows(mask)
    Err(jet_interrupt_unavailable_error())
}
