// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Interrupt.rs:89
fn jet_process_signal_index(mask: USize) -> USize? {
    match mask { JET_SIGNAL_INT -> Val(0), JET_SIGNAL_HUP -> Val(1), JET_SIGNAL_TERM -> Val(2), _ -> None }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Interrupt.rs:99
fn jet_interrupt_signal_bit(signal: I32) -> USize {
    match signal { 2 -> JET_SIGNAL_INT, 1 -> JET_SIGNAL_HUP, 15 -> JET_SIGNAL_TERM, _ -> 0 }
}
