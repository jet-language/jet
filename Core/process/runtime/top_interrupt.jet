// Count first, then registration order. Empty handlers must not steal events.
pub fn jet_interrupt_dispatch<T>(handlers: [T], invoke: fn(&T) ->) -> {
    if handlers.is_empty() -> return
    // GATE #4565: kernel primitive
    count :: #Unsafe("consume the entire one process-wide counted Ctrl-C queue only when handlers exist") {
        JET_INTERRUPT_STATE.pending_interrupts.swap(0, Ordering.Acquire)
    }
    loop _ in 0..<count -> loop handler in handlers -> invoke(handler)
}
