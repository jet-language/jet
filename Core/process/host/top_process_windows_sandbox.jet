//RS mod jet_process_windows_sandbox {
//RS     //! Native Windows AppContainer backend for build actions.
//RS     //!
//RS     //! The child is created with a default-deny AppContainer token, only the
//RS     //! declared capability set, a per-run ACL projection, and a Job Object. It is
//RS     //! created suspended, joined to the Job Object, and resumed only after every
//RS     //! boundary is ready. Any preparation failure is returned before the build
//RS     //! tool can execute.
//RS 
