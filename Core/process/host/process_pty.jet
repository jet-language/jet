pub fn signal_group(pid: U32, signal: I32) -> io.Error! {
    match target.selected_family() {
        .Unix -> unix.signal_group(pid, signal)
        .Windows -> Err(io.Error.new(io.ErrorKind.Unsupported, "POSIX process groups are unavailable on Windows"))
        _ -> Err(io.Error.new(io.ErrorKind.Unsupported, "process groups are unavailable on this target"))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/ProcessPty.rs:1400
pub fn is_terminal_eof(error: &io.Error) -> Bool {
    match target.selected_family() { .Unix -> unix.is_terminal_eof(error), .Windows -> windows.is_terminal_eof(error), _ -> false }
}
