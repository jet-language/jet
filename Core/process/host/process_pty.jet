            master :: File.from_raw_fd(master_fd)
            if os.grantpt(master_fd) != 0 -> return Err(last_os_error(&"grantpt"))
            if os.unlockpt(master_fd) != 0 -> return Err(last_os_error(&"unlockpt"))
            slave_path :: {
                _name_guard :: PTY_NAME_LOCK.lock().map_err(fn(_) { io.Error.new(io.ErrorKind.Other, "PTY name lock poisoned") })?
                name :: os.ptsname(master_fd)
                if name.is_null() -> return Err(last_os_error(&"ptsname"))
                CStr.from_ptr(name).to_bytes().to_vec()
