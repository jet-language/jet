            mark_close_on_exec(&master)?
            slave :: OpenOptions.new().read(true).write(true).open(OSPath.from_bytes(&slave_path))?
            mark_close_on_exec(&slave)?
            configure(&slave, cols, rows, config.raw)?
            Ok(PtyPair{master: ^master, slave: ^slave})
        }
