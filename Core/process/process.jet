
package {
    name: "core.process"
    version: "0.1.0"
    edition: "2026"
    description: "Process builders and receipt helpers."
    license: "MIT"
    outputs: {
        process: .Library{ entry: process }
    }
}
use core as core
use core.files as files


pub fn args() -[Exec.Args]> [String] Never! { core.process.args() }

pub fn argv() -[Exec.Args]> [String] Never! { core.process.argv() }

pub fn check(receipt: ProcessReceipt) IOError! {
    if receipt.success -> return Ok()
    limit_hit :: receipt.limit_hit
    if limit_hit == {
        .None -> { _ := 0 }
        .Val(limit) -> return Err(IOError.ResourceLimit(limit))
        else -> { _ := 0 }
    }
    if receipt.timed_out {
        return Err(IOError.TimedOut(IOContext{
            operation: .Resolve,
            resource: Val(receipt.executable_identity),
            os_code: None,
            cause: Val("process timed out"),
        }))
    }
    cause := "process exited unsuccessfully: code={receipt.code}"
    signal :: ~receipt.signal
    if signal == {
        .None -> { _ := 0 }
        .Val(number) -> cause = "{cause}; signal={number}"
    }
    return Err(IOError.Other(IOContext{
        operation: .Resolve,
        resource: Val(receipt.executable_identity),
        os_code: None,
        cause: Val(cause),
    }))
}


pub fn stdin_text(spec: ProcessSpec, text: String) IOError! -[Exec, Time.Wait]> {
    child :: spec.stdin(.Stream).spawn()
    child.stdin.write(text)
    child.stdin.close()
    receipt :: child.wait()
    check(receipt)
}

pub fn getoutput(spec: ProcessSpec) -[Exec, Time.Wait]> String IOError! {
    receipt :: spec.run()
    receipt.output
}

pub fn getstatusoutput(spec: ProcessSpec) -[Exec, Time.Wait]> (status: Int, output: String) IOError! {
    receipt :: spec.run()
    (status: receipt.code, output: combined_output(receipt))
}

pub fn shell(line: String) -[Exec, Env]> ProcessSpec Never! {
    if core.sys.family() == "windows" -> return cmd([String]{"cmd", "/C", line})
    cmd([String]{"sh", "-c", line})
}

pub fn arg(spec: ProcessSpec, extra: String) -> ProcessSpec Never! {
    spec.arg(extra)
}

pub fn args_extend(spec: ProcessSpec, extra: [String]) -> ProcessSpec Never! {
    spec.args_extend(extra)
}


pub fn cmd(argv: [String]) -[Exec]> ProcessSpec Never! { core.process.cmd(argv) }

pub fn current_pid() -[Env]> Int Never! { core.sys.getpid() }

pub fn cwd(spec: ProcessSpec, path: String) -> ProcessSpec Never! { spec.cwd(path) }

pub fn env(spec: ProcessSpec, key: String, value: String) -> ProcessSpec Never! {
    spec.env(key, value)
}

pub fn env_get(name: String) -[Env]> String? Never! { core.sys.get(name) }

pub fn exit(code: Int) -[Exec]> Never Never! {
    core.process.exit(code)
    loop {}
}

pub fn on_signal(signal: ProcessSignal) Never! -[Exec]> { core.process.on_signal(signal) }

pub fn pipeline(steps: [ProcessSpec]) -[Exec, Time.Wait]> ProcessReceipt IOError! {
    core.process.pipeline(steps)
}

pub fn run_spec(spec: ProcessSpec) -[Exec, Time.Wait]> ProcessReceipt IOError! {
    spec.run()
}

pub fn status_ok(receipt: ProcessReceipt) -> Bool Never! {
    receipt.success
}


pub fn which(name: String) -[FS, Env]> String? Never! {
    if name.len() == 0 -> return None
    if contains_path_separator(name) || path_is_absolute(name) {
        if path_is_file(name) -> return Val(name)
        return None
    }
    path :: core.sys.get("PATH") ?? return None
    family :: core.sys.family() ?? return None
    separator :: path_separator_for_platform(family)
    loop directory in path_parts(path, separator) {
        candidate :: path_join(directory, name)
        if path_is_file(candidate) -> return Val(candidate)
    }
    None
}
fn path_is_absolute(path: String) -> Bool Never! {
    raw :: path.bytes()
    if raw.len() == 0 -> return false
    if raw[0] == (U8{47}) || raw[0] == (U8{92}) -> return true
    raw.len() >= 3 &&
        ((raw[0] >= (U8{65}) && raw[0] <= (U8{90})) ||
            (raw[0] >= (U8{97}) && raw[0] <= (U8{122}))) &&
        raw[1] == (U8{58}) &&
        (raw[2] == (U8{47}) || raw[2] == (U8{92}))
}

fn path_is_file(path: String) -[FS]> Bool Never! {
    stat :: core.files.stat(path) ?? return false
    stat.is_file
}

fn path_join(base: String, name: String) -> String Never! {
    if name.len() == 0 -> return ~base
    if path_is_absolute(name) || base.len() == 0 -> return ~name
    last :: base.bytes()[base.bytes().len() - 1]
    if last == (U8{47}) || last == (U8{92}) -> return "{base}{name}"
    "{base}/{name}"
}

fn path_separator_for_platform(family: String) -> U8 Never! {
    if family == "windows" -> return U8{59}
    U8{58}
}




pub fn call(spec: ProcessSpec) -[Exec, Time.Wait]> Int IOError! {
    receipt :: spec.run()
    receipt.code
}

pub fn capture(spec: ProcessSpec) -[Exec, Time.Wait]> ProcessReceipt IOError! {
    spec.run()
}

pub fn check_call(spec: ProcessSpec) -[Exec, Time.Wait]> ProcessReceipt IOError! {
    spec.run_checked()
}

pub fn check_output(spec: ProcessSpec) -[Exec, Time.Wait]> String IOError! {
    receipt :: check_call(spec)
    receipt.output
}


pub fn combined_output(receipt: ProcessReceipt) -> String Never! {
    if receipt.output.len() == 0 -> return receipt.errors
    if receipt.errors.len() == 0 -> return receipt.output
    "{receipt.output}\n{receipt.errors}"
}

pub fn env_get_or(name: String, fallback: String) -[Env]> String Never! {
    core.sys.get(name) ?? return fallback
}

pub fn env_keys() -[Env]> [String] EnvError! { core.sys.vars() }

pub fn env_set(spec: ProcessSpec, key: String, value: String) -> ProcessSpec Never! {
    spec.env(key, value)
}

pub fn env_truthy(name: String) -[Env]> Bool Never! {
    value :: core.sys.get(name) ?? return false
    lowered :: core.text.lower(value)
    lowered == "1" || lowered == "true" || lowered == "yes" || lowered == "on"
}

pub fn failed(receipt: ProcessReceipt) -> Bool Never! { !receipt.success }


pub fn list2cmdline(argv: [String]) -> String Never! {
    out := ""
    first := true
    loop item in argv {
        if !first -> out = "{out} "
        out = "{out}{quote_arg(item)}"
        first = false
    }
    out
}

pub fn signal_number(signal: ProcessSignal) -> Int Never! {
    if signal == {
        .Interrupt -> 2
        .Terminate -> 15
        .Hangup -> 1
        .Child -> 17
        .User1 -> 10
        .User2 -> 12
        else -> 0
    }
}

pub fn stderr_lines(receipt: ProcessReceipt) -> [String] Never! {
    split_lines(receipt.errors)
}

pub fn stdout_lines(receipt: ProcessReceipt) -> [String] Never! {
    split_lines(receipt.output)
}

pub fn exited(receipt: ProcessReceipt) -> Bool Never! {
    receipt.signal == None && !receipt.timed_out
}
fn contains_path_separator(value: String) -> Bool Never! {
    loop byte in value.bytes() {
        if byte == (U8{47}) || byte == (U8{92}) -> return true
    }
    false
}

fn path_separator(value: String) -> U8 {
    raw :: value.bytes()
    if raw.len() > 0 -> return raw[0]
    U8{58}
}

fn path_parts(value: String, separator: U8) -> [String] Never! {
    raw :: value.bytes()
    out := [String]{}
    start := 0
    i := 0
    loop i <= raw.len() {
        if i == raw.len() || raw[i] == separator {
            if i == start -> &out.push(".") else {
                &out.push(String.from_bytes(slice_u8(raw, start, i)) ?? "")
            }
            start = i + 1
        }
        i = i + 1
    }
    out
}

fn split_lines(value: String) -> [String] {
    raw :: value.bytes()
    out := [String]{}
    start := 0
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{10}) || raw[i] == (U8{13}) {
            &out.push(String.from_bytes(slice_u8(raw, start, i)) ?? "")
            if raw[i] == (U8{13}) && i + 1 < raw.len() && raw[i + 1] == (U8{10}) {
                i = i + 2
            } else {
                i = i + 1
            }
            start = i
        } else {
            i = i + 1
        }
    }
    if start < raw.len() -> &out.push(String.from_bytes(slice_u8(raw, start, raw.len())) ?? "")
    out
}

fn quote_arg(value: String) -> String {
    raw :: value.bytes()
    needs_quote := raw.len() == 0
    loop byte in raw {
        if byte == (U8{9}) || byte == (U8{10}) || byte == (U8{13}) || byte == (U8{32}) {
            needs_quote = true
        }
    }
    out := [U8]{}
    if needs_quote -> &out.push(U8{34})
    backslashes := 0
    loop byte in raw {
        if byte == (U8{92}) {
            backslashes = backslashes + 1
            next
        }
        if byte == (U8{34}) {
            count := backslashes * 2 + 1
            loop count > 0 {
                &out.push(U8{92})
                count = count - 1
            }
            &out.push(U8{34})
        } else {
            loop backslashes > 0 {
                &out.push(U8{92})
                backslashes = backslashes - 1
            }
            &out.push(byte)
        }
        backslashes = 0
    }
    if needs_quote {
        loop backslashes > 0 {
            &out.push(U8{92})
            &out.push(U8{92})
            backslashes = backslashes - 1
        }
        &out.push(U8{34})
    } else {
        loop backslashes > 0 {
            &out.push(U8{92})
            backslashes = backslashes - 1
        }
    }
    String.from_bytes(out) ?? ~value
}

fn slice_u8(raw: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    i := start
    loop i < end {
        &out.push(raw[i])
        i = i + 1
    }
    out
}

