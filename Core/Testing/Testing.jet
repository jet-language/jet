package {
    name: "core.testing"
    version: "0.0.1"
    edition: "2026"
    description: "Assertions, fixtures, goldens, and fake clocks."
    license: "MIT"
    outputs: {
        testing: .Library{ entry: testing }
    }
}
use {
    core :: core
    files :: core.files
    sys :: core.sys
    random :: core.math.random
    core.time.[Clock]
    core.testing.[__evidence_read, __record_failure, __clear_failure, __temp_facts, __temp_join, __temp_remove, __temp_create, __text_window, __suite_snapshot]
    crypto :: core.crypto
    json :: core.encoding.json
}

// A second spelling, never a second owner.
pub use core.math.random.[RNG]

// core.testing — deterministic tests and comparison records.
//
// World lifecycle and suite harness state remain host-owned;
// callback comparison and bounded history generation stay portable Jet code.

fn assert_equal(comparison: TestComparison) -> Bool Never! {
    // The typed provider also requires recorded samples; the source twin can
    // validate only the scalar proof fields exposed by the declaration.
    comparison.status == "matched" && !comparison.universal_proof && comparison.first_difference < 0
}

/// Both callbacks share one failure type `E`, which the
/// comparison passes up; two callbacks that cannot fail make it `Never`.
fn compare<E>(cases: [Dyn], reference: fn(Dyn) -> Dyn E!, candidate: fn(Dyn) -> Dyn E!, relation: String) -> TestComparison E! {
    normalized := relation
    if normalized.len() == 0 -> normalized = "typed_equality"
    if normalized == "ordered_effects" || normalized == "typed_failure" {
        return terminal_comparison(normalized, "relation requires recorded observations")
    }
    if cases.len() == 0 -> return terminal_comparison(normalized, "comparison needs at least one case")
    inputs := [Dyn]{}
    reference_values := [Dyn]{}
    candidate_values := [Dyn]{}
    case_ids := [String]{}
    first_difference := -1
    loop i in 0..<cases.len() {
        input :: cases[i]
        expected :: reference(input)
        actual :: candidate(input)
        &inputs.push(input)
        &reference_values.push(expected)
        &candidate_values.push(actual)
        &case_ids.push("case-{i}")
        if first_difference < 0 && !expected.equal_unordered(actual) -> first_difference = i
    }
    status := "matched"
    reason := "comparison matched all cases"
    if first_difference >= 0 {
        status = "mismatch"
        reason = "reference and candidate differ at case-{first_difference}"
    }
    TestComparison{
        status: status,
        relation: normalized,
        source: "core.testing",
        tool: "jet",
        target: "embedded-prelude",
        seed: None,
        case_ids: case_ids,
        inputs: inputs,
        reference: reference_values,
        candidate: candidate_values,
        first_difference: first_difference,
        reason: reason,
        universal_proof: false,
    }
}

fn terminal_comparison(relation: String, reason: String) -> TestComparison {
    TestComparison{
        status: "unavailable",
        relation: relation,
        source: "core.testing",
        tool: "jet",
        target: "embedded-prelude",
        seed: None,
        case_ids: [String]{},
        inputs: [Dyn]{},
        reference: [Dyn]{},
        candidate: [Dyn]{},
        first_difference: -1,
        reason: reason,
        universal_proof: false,
    }
}

/// Compare or create a snapshot. Updating observes JET_UPDATE_SNAPSHOTS,
/// so the environment read is part of the declared effect row. A mismatch
/// records `snapshot differs` with the same bounded unified diff as `golden`.
fn snap(name: String, value: String) -[FS, Env]> Bool Never! {
    path :: "__snapshots__/{snapshot_name(name)}.snap"
    update :: (sys.get("JET_UPDATE_SNAPSHOTS") ?? "") == "1"
    if update || !files.is_file(path) {
        if files.mkdir("__snapshots__", true) == {
            .Ok(_) -> {}
            .Err(_) -> {}
        }
        if files.write(path, value) == {
            .Ok(_) -> {}
            .Err(_) -> {
                __record_failure("snapshot cannot be written: {name}", "path: {path}")
                return false
            }
        }
        __clear_failure()
        return true
    }
    read :: __evidence_read(path)
    if !read.ok {
        __record_failure("snapshot cannot be read: {name}", "path: {path}")
        return false
    }
    if read.text == value {
        __clear_failure()
        return true
    }
    __record_failure("snapshot differs: {name}", "path: {path}\n{testing_unified_diff(path, read.text, value)}")
    false
}

/// Compare `value` with the golden file `name`. Under `-u`
/// (JET_UPDATE_SNAPSHOTS=1, the same switch as `snap`) a missing or differing
/// golden file is written, parent directories included, and the check passes.
fn golden(name: String, value: String) -[FS, Env]> Bool Never! {
    read :: __evidence_read(name)
    if read.ok && read.text == value {
        __clear_failure()
        return true
    }
    if (sys.get("JET_UPDATE_SNAPSHOTS") ?? "") == "1" {
        parent :: files.dirname(name)
        if parent != "" {
            if files.create_dir_all(parent) == {
                .Ok(_) -> {}
                .Err(_) -> {}
            }
        }
        if files.write(name, value) == {
            .Ok(_) -> {}
            .Err(_) -> {
                __record_failure("golden file cannot be written: {name}", "path: {name}")
                return false
            }
        }
        __clear_failure()
        return true
    }
    if !read.ok {
        reason :: if read.missing -> "golden file is missing: {name}" else -> "golden file cannot be read: {name}"
        __record_failure(reason, "path: {name}")
        return false
    }
    diff :: testing_unified_diff(name, read.text, value)
    __record_failure("golden file differs: {name}", "path: {name}\n{diff}")
    false
}

fn fixture(name: String) -[FS]> String Never! {
    read :: __evidence_read(name)
    if read.ok {
        __clear_failure()
        return read.text
    }
    reason :: if read.missing -> "fixture is missing: {name}" else -> "fixture cannot be read: {name}"
    __record_failure(reason, "path: {name}")
    ""
}

fn temp_dir(prefix: String) -[FS]> String Never! {
    facts :: __temp_facts()
    safe :: testing_ascii_name(prefix, false)
    thread :: testing_ascii_name(facts.thread, true)
    // __TempPath.path is opaque platform encoding produced by the host.
    // Never construct, slice, decode, or edit it; only pass it back unchanged.
    location :: __temp_join("jet_test_{safe}_{facts.pid}_{thread}")
    path :: location.text
    removed :: __temp_remove(location.path)
    if !removed.ok && !removed.missing {
        panic(testing_temp_error("remove_temp_dir", path, removed.cause))
    }
    created :: __temp_create(location.path)
    if !created.ok -> panic(testing_temp_error("create_temp_dir", path, created.cause))
    path
}

/// Read each readable regular file in a directory, ordered by its full path.
/// The parameter retains the historical spelling `glob`; it names a directory.
fn corpus(glob: String) -[FS]> [String] Never! {
    entries :: files.list_dir(glob) ?? return [String]{}
    paths := [String]{}
    loop entry in entries -> &paths.push(entry.path)
    &paths.sort()
    values := [String]{}
    loop path in paths {
        if !files.is_file(path) -> next
        value :: files.read(path) ?? next
        &values.push(value)
    }
    values
}

/// One corpus entry: `id` is the entry's path below the corpus root without
/// the corpus suffix (`basics/hello` for `<root>/basics/hello.jet`), the row
/// name a test reports; `path` is the file to read.
struct CorpusEntry {
    id: String
    path: String
}

/// The regular files below `root`, at any depth, whose names end in `suffix`,
/// ordered by id. Names starting with `.` are skipped, folders included; an
/// absent or unreadable root or folder has no entries.
fn corpus_entries(root: String, suffix: String) -[FS]> [CorpusEntry] Never! {
    entries := [CorpusEntry]{}
    testing_corpus_walk(root, "", suffix, &entries)
    &entries.sort_by((left: CorpusEntry, right: CorpusEntry) -> left.id <=> right.id)
    entries
}

fn testing_corpus_walk(directory: String, prefix: String, suffix: String, entries: &[CorpusEntry]) -[FS]> {
    children :: files.list_dir(directory) ?? return
    loop child in children {
        if child.name.starts_with(".") -> next
        relative :: if prefix == "" -> child.name.copy() else -> "{prefix}/{child.name}"
        if child.is_dir {
            testing_corpus_walk(child.path, relative, suffix, &entries)
            next
        }
        if !relative.ends_with(suffix) || !files.is_file(child.path) -> next
        bytes :: relative.bytes()
        id :: String.from_bytes(bytes[0..<(bytes.len() - suffix.count_bytes())]) ?? relative.copy()
        &entries.push(CorpusEntry{id: id, path: child.path.copy()})
    }
}

/// The test-facing spelling of the deterministic Prelude `Clock` built by `Clock.new`.
fn fake_clock(unix_ms: Int) -> Clock Never! { Clock.new(unix_ms) }

/// A caller-owned deterministic RNG seeded by the ordinary source constructor.
fn fake_rng(seed: Int) -> random.RNG Never! { random.rng(seed) }

/// Deterministic fake data uses the same source SplitMix64 stream as RNG.
fn fake_data(seed: Int) -> Fake Never! {
    Fake{state: U64{Int{I64{seed}}.bit_and(18446744073709551615)}, locale_code: 0}
}

struct Fake {
    state: U64
    locale_code: Int

    impl Display {
        fn display(self) -> String {
            language :: if self.locale_code == 1 -> "de" else -> "en"
            "Fake {{ locale: {language} }}"
        }
    }

    impl Debug {
        fn debug(^self) -> String {
            "Fake {{ state: {self.state}, locale: {self.locale_code} }}"
        }
    }

    fn locale(self, locale: String) -> Fake Never! {
        code :: if locale == "en" -> 0 else if locale == "de" -> 1 else -> panic("unsupported fake-data locale `{locale}`; supported locales: en, de")
        Fake{state: self.state.bit_xor(U64{code}.wrapping_mul(U64{15111065706836454659})), locale_code: code}
    }

    fn name(&self) -> String Never! {
        first :: fake_first(&self.state, self.locale_code)
        last :: fake_last(&self.state, self.locale_code)
        "{first} {last}"
    }

    fn email(&self) -> String Never! {
        first :: core.text.parse.lower(fake_first(&self.state, self.locale_code))
        last :: core.text.parse.lower(fake_last(&self.state, self.locale_code))
        host :: fake_host(&self.state, self.locale_code)
        "{first}.{last}@{host}"
    }

    fn host(&self) -> String Never! {
        name :: fake_host(&self.state, self.locale_code)
        "www.{name}"
    }

    fn address(&self) -> String Never! {
        number :: core.math.random.__seeded_int(&self.state, 1, 999) ?? panic("fake address has a valid range")
        street :: fake_street(&self.state, self.locale_code)
        city :: fake_city(&self.state, self.locale_code)
        "{number} {street}, {city}"
    }
}

FAKE_EN_FIRST :: [String]{"Alice", "Bob", "Clara", "Diego"}
FAKE_EN_LAST :: [String]{"Smith", "Jones", "Taylor", "Brown"}
FAKE_EN_HOSTS :: [String]{"example.test", "mail.test", "demo.test"}
FAKE_EN_STREETS :: [String]{"Oak Street", "Pine Street", "Maple Street", "Cedar Street"}
FAKE_EN_CITIES :: [String]{"Austin", "Boston", "Denver", "Portland"}
FAKE_DE_FIRST :: [String]{"Anna", "Bruno", "Clara", "Dieter"}
FAKE_DE_LAST :: [String]{"Schmidt", "Fischer", "Weber", "Wagner"}
FAKE_DE_HOSTS :: [String]{"beispiel.test", "mail.test", "demo.test"}
FAKE_DE_STREETS :: [String]{"Bahnhofstraße", "Hauptstraße", "Lindenweg", "Gartenweg"}
FAKE_DE_CITIES :: [String]{"Berlin", "Bremen", "Dresden", "Hamburg"}

fn fake_index(state: &U64, count: Int) -> Int Never! {
    core.math.random.__seeded_int(&state, 0, count - 1) ?? panic("fake tables are nonempty")
}

fn fake_first(state: &U64, locale: Int) -> String Never! {
    index :: fake_index(&state, 4)
    if locale == 1 -> FAKE_DE_FIRST[index] else -> FAKE_EN_FIRST[index]
}

fn fake_last(state: &U64, locale: Int) -> String Never! {
    index :: fake_index(&state, 4)
    if locale == 1 -> FAKE_DE_LAST[index] else -> FAKE_EN_LAST[index]
}

fn fake_host(state: &U64, locale: Int) -> String Never! {
    index :: fake_index(&state, 3)
    if locale == 1 -> FAKE_DE_HOSTS[index] else -> FAKE_EN_HOSTS[index]
}

fn fake_street(state: &U64, locale: Int) -> String Never! {
    index :: fake_index(&state, 4)
    if locale == 1 -> FAKE_DE_STREETS[index] else -> FAKE_EN_STREETS[index]
}

fn fake_city(state: &U64, locale: Int) -> String Never! {
    index :: fake_index(&state, 4)
    if locale == 1 -> FAKE_DE_CITIES[index] else -> FAKE_EN_CITIES[index]
}

#Test("Fake English draw order matches the shipped seed 42 corpus") {
    fake := fake_data(42)
    assert_eq(&fake.name(), "Clara Smith")
    assert_eq(&fake.email(), "bob.jones@example.test")
    assert_eq(&fake.host(), "www.demo.test")
    assert_eq(&fake.address(), "219 Cedar Street, Boston")
}

#Test("Fake German locale salt and draw order match the shipped seed 42 corpus") {
    fake := fake_data(42).locale("de")
    assert_eq(&fake.name(), "Dieter Schmidt")
    assert_eq(&fake.email(), "bruno.schmidt@mail.test")
    assert_eq(&fake.host(), "www.beispiel.test")
    assert_eq(&fake.address(), "406 Hauptstraße, Berlin")
}

#Test("Fake copies keep independent streams and locale selection does not draw") {
    original := fake_data(-1)
    duplicate := original.copy()
    english := original.locale("en")
    assert_eq(&original.name(), &duplicate.name())
    fresh := fake_data(-1)
    assert_eq(&english.name(), &fresh.name())
}

#Test("Fake debug keeps the native state and locale field rendering") {
    assert_eq(fake_data(42).debug(), "Fake {{ state: 42, locale: 0 }}")
}

/// The Prelude `Test` carrying the current harness iteration and result.
fn test_suite() -> Test Never! { __suite_snapshot() }

/// A code suite's row sink (D-TEST-SUITE2=A). `t.suite("perf", perf_rows)` in
/// `fn test(t: Test)` hands one to `perf_rows` when a `jet test --profile` run
/// selects the `perf` suite. Each call appends one row line to the file the
/// profile runner named, so the rows written before a panic survive it.
struct TestRows {
    suite: String
    path: String

    /// Record the row `id` as passing.
    fn pass(self, id: String) -[FS.Write]> { suite_row_write(self, id, "passed", "") }
    /// Record the row `id` as failing, with what went wrong.
    fn fail(self, id: String, detail: String) -[FS.Write]> { suite_row_write(self, id, "failed", detail) }
    /// Record the row `id` as skipped, with why.
    fn skip(self, id: String, reason: String) -[FS.Write]> { suite_row_write(self, id, "skipped", reason) }
}

// One row line: `id<TAB>state<TAB>detail`, each field kept to one column.
fn suite_row_write(rows: TestRows, id: String, state: String, detail: String) -[FS.Write]> {
    line :: "{suite_row_field(id)}\t{state}\t{suite_row_field(detail)}\n"
    files.append_all(rows.path, line) ?? panic("the `{rows.suite}` suite can't record its row `{id}` in {rows.path}: {err}")
}

fn suite_row_field(text: String) -> String Never! { text.replace("\r", " ").replace("\n", " ").replace("\t", " ") }

/// `t.suite(name, body)`: run `body` when this run is the profile child of
/// the code suite `name` (JET_TEST_SUITE), recording its rows in
/// JET_TEST_SUITE_ROWS; any other run skips it.
fn __suite_run(name: String, body: fn(TestRows)) -[FS, Env]> {
    if (sys.get("JET_TEST_SUITE") ?? "") != name -> return
    path :: sys.get("JET_TEST_SUITE_ROWS") ?? panic("the `{name}` suite runs without JET_TEST_SUITE_ROWS")
    body(TestRows{suite: name, path: path})
}

// The public history records project the Foundation history data, not
// another wire format. Identities are logical numbers, never host
// pointers.
struct HandleID {
    value: Int
}

struct TaskID {
    value: Int
}

struct EventID {
    value: Int
}

// #6410: the deterministic history generator: SplitMix64 over one 64-bit
// state word. Every copy shares that word, so a draw a strategy makes
// advances the campaign's sequence. `next_u64` gives the next draw in
// 0..<2^64; `below(bound)` gives the next draw modulo `bound`, and 0 without
// drawing when `bound` is not positive.
struct HistoryRNG {
    __state: Shared<__HistoryRngState>
}

struct __HistoryRngState {
    word: U64
}

impl HistoryRNG {
    fn next_u64(self) -> Int Never! { __history_rng_next(self) }
    fn below(self, bound: Int) -> Int Never! { __history_rng_below(self, bound) }
}

// A generator seeded by the low 64 bits of a non-negative seed.
fn __history_rng_new(seed: Int) -> HistoryRNG Never! {
    HistoryRNG{__state: shared __HistoryRngState{word: U64.from_int(seed % 18446744073709551616) ?? U64{0}}}
}

fn __history_rng_draw(rng: HistoryRNG) -> U64 Never! {
    guard := rng.__state.guard_edit()
    guard.value.word = guard.value.word.wrapping_add(U64{11400714819323198485})
    value := guard.value.word
    value = (value.bit_xor(value >> U64{30})).wrapping_mul(U64{13787848793156543929})
    value = (value.bit_xor(value >> U64{27})).wrapping_mul(U64{10723151780598845931})
    value.bit_xor(value >> U64{31})
}

fn __history_rng_next(rng: HistoryRNG) -> Int Never! { Int.from_u64(__history_rng_draw(rng)) }

fn __history_rng_below(rng: HistoryRNG, bound: Int) -> Int Never! {
    if bound <= 0 -> return 0
    limit :: U64.from_int(bound) ?? return __history_rng_next(rng)
    Int.from_u64(__history_rng_draw(rng) % limit)
}

// Expected draws: an independent SplitMix64 model (BigInt, Node) from seed 41.
#Test("HistoryRNG draws SplitMix64 from its seed and every copy shares the stream") {
    rng :: __history_rng_new(41)
    shared_copy :: rng.copy()
    assert_eq(__history_rng_next(rng), 1265094156158224713)
    assert_eq(__history_rng_next(shared_copy), 11038316942610582860)
    assert_eq(__history_rng_below(rng, 0), 0)
    assert_eq(__history_rng_next(rng), 1990246801145950849)
    assert_eq(__history_rng_below(shared_copy, 17), 6)
}

/// A value carried by one history operation. A secret enters only as
/// `Redacted`; `Text` is text declared safe for a replay artifact.
enum HistoryValue {
    Integer(Int)
    Boolean(Bool)
    Text(String)
    Handle(HandleID)
    Redacted(String)
}

// The four retained precondition kinds an operation can wait on: a live
// handle, a handle in a named state, a completed task, an available event.
enum HistoryPrecondition {
    HandleLive(HandleID)
    HandleState(handle: HandleID, state: String)
    TaskCompleted(TaskID)
    EventAvailable(EventID)
}

// One operation of a history case, with the handles it creates and consumes.
struct HistoryOperation {
    index: Int
    name: String
    arguments: [HistoryValue]
    creates: [HandleID]
    consumes: [HandleID]
    preconditions: [HistoryPrecondition]
    depends_on: [Int]
    task: TaskID?
    event: EventID?
}

/// One scheduler choice attached to an operation.
struct HistoryScheduleChoice {
    operation: Int
    task: TaskID?
    event: EventID?
    choice: String
}

// One history case: its id, its seed, its operations and its schedule.
struct HistoryCase {
    case_id: String
    seed: Int
    operations: [HistoryOperation]
    schedule: [HistoryScheduleChoice]
}

// A history case together with the commands it decodes to.
struct TypedHistoryCase<Command> {
    case: HistoryCase
    commands: [Command]
}

// The campaign bounds a strategy works within. The `cases` argument of
// `histories` stays the case bound.
struct HistoryBounds {
    max_steps: Int
    max_resources: Int
    max_shrink_attempts: Int
    max_discarded_cases: Int
}

// The generation weight of one named operation.
struct HistoryDistribution {
    operation: String
    weight: Int
}

// An explicit strategy: one immutable value with all five fields. `generate`
// receives the HistoryRNG, `case_index` and `max_steps`; `rebuild` and
// `valid` see the canonical case.
struct HistoryStrategy<Command> {
    generate: fn(HistoryRNG, Int, Int) -> TypedHistoryCase<Command>?
    rebuild: fn(HistoryCase) -> TypedHistoryCase<Command>?
    valid: fn(TypedHistoryCase<Command>) -> Bool
    bounds: HistoryBounds
    distributions: [HistoryDistribution]
}

// #6410: one campaign. A single HistoryRNG seeded by `seed` feeds every
// `generate`; a case that fails to generate, validate, stay inside the
// bounds, rebuild or pass `valid` is discarded, and more discards than
// `max_discarded_cases` stop the campaign. A mismatch shrinks to a reduced
// replayable case and returns an Err whose cause carries the history
// artifact. The compiler supplies the `__` arguments: the command type, the
// artifact provenance and, without `strategy`, the derived enum strategy.
fn histories<T>(
    seed: Int,
    cases: Int,
    strategy: HistoryStrategy<T>?{None},
    model: ^fn([T]) -> Dyn,
    actual: ^fn([T]) -> Dyn,
    observe: ^fn(Dyn) -> Dyn,
    __command_type: String{""},
    __source: String{""},
    __tool: String{""},
    __target: String{""},
    __unsupported: String{""},
    __variants: [String],
    __make: [fn(Int, [Int], [Bool], [String]) -> T Never!],
) -> TestComparison Err! {
    if seed < 0 -> return Err(testing_history_err("history seed is invalid"))
    if cases < 0 -> return Err(testing_history_err("history case bound is invalid"))
    if __source == "" || __tool == "" || __target == "" {
        return Ok(testing_history_terminal(seed, "", "", "", "unavailable", "history provenance is unavailable"))
    }
    if strategy == .Val(explicit) {
        return testing_history_campaign<T>(seed, cases, explicit, model, actual, observe, __command_type, __source, __tool, __target)
    }
    if __unsupported != "" || __make.len() != 1 || __variants.len() == 0 {
        reason :: if __unsupported != "" -> __unsupported else -> "core.testing.histories command type `{__command_type}` has no checked enum schema"
        return Ok(testing_history_terminal(seed, __source, __tool, __target, "unsupported", reason))
    }
    derived :: testing_history_derived<T>(__command_type.copy(), __variants, __make[0])
    testing_history_campaign<T>(seed, cases, derived, model, actual, observe, __command_type, __source, __tool, __target)
}

fn testing_history_err(message: String) -> Err Never! { Err{message: message, code: None, cause: None} }

fn testing_history_terminal(seed: Int, source: String, tool: String, target: String, status: String, reason: String) -> TestComparison Never! {
    TestComparison{
        status: status,
        relation: "typed_equality",
        source: source,
        tool: tool,
        target: target,
        seed: Val(seed),
        case_ids: [String]{},
        inputs: [Dyn]{},
        reference: [Dyn]{},
        candidate: [Dyn]{},
        first_difference: -1,
        reason: reason,
        universal_proof: false,
    }
}

// The observation of one case: the raw JSON of the four observed values
// and the status of their typed-equality comparison.
struct TestingHistorySample {
    case_id: String
    input_id: String
    seed: Int
    reference: String
    candidate: String
    reference_replay: String
    candidate_replay: String
}

struct TestingHistoryObservation {
    status: String
    reason: String
    sample: TestingHistorySample?
    input: Dyn
    reference: Dyn
    candidate: Dyn
}

fn testing_history_config_error(cases: Int, bounds: HistoryBounds, distributions: [HistoryDistribution], command_type: String) -> String Never! {
    if cases < 1 || cases > 100000 -> return "cases must be between 1 and the history limit"
    if bounds.max_steps < 1 || bounds.max_steps > 4096 -> return "max_steps must be between 1 and the history limit"
    if bounds.max_resources < 1 || bounds.max_resources > 4096 -> return "max_resources must be between 1 and the history limit"
    if bounds.max_shrink_attempts < 1 || bounds.max_shrink_attempts > 1000000 -> return "max_shrink_attempts must be between 1 and the history limit"
    if bounds.max_discarded_cases < 0 -> return "max_discarded_cases must not be negative"
    if bounds.max_discarded_cases > 100000 -> return "max_discarded_cases exceeds the history limit"
    if command_type == "" || command_type.len() > 4096 -> return "command type must be non-empty and bounded"
    if distributions.len() > 256 -> return "distribution count exceeds the history limit"
    loop index in 0..<distributions.len() {
        operation :: distributions[index].operation
        if operation == "" || operation.len() > 4096 || distributions[index].weight <= 0 -> return "distribution {index} has an invalid operation or weight"
    }
    ""
}

fn testing_history_campaign<T>(
    seed: Int,
    cases: Int,
    strategy: HistoryStrategy<T>,
    model: fn([T]) -> Dyn,
    actual: fn([T]) -> Dyn,
    observe: fn(Dyn) -> Dyn,
    command_type: String,
    source: String,
    tool: String,
    target: String,
) -> TestComparison Err! {
    bounds :: strategy.bounds
    config :: testing_history_config_error(cases, bounds, strategy.distributions, command_type)
    if config != "" -> return Err(testing_history_err("invalid history config: {config}"))
    generate :: strategy.generate
    rng :: __history_rng_new(seed)
    discarded := 0
    explored := 0
    samples := [TestingHistorySample]{}
    inputs := [Dyn]{}
    reference_values := [Dyn]{}
    candidate_values := [Dyn]{}
    loop case_index in 0..<cases {
        admitted := false
        case := HistoryCase{case_id: "", seed: 0, operations: [HistoryOperation]{}, schedule: [HistoryScheduleChoice]{}}
        generated :: generate(rng, case_index, bounds.max_steps)
        if generated == .Val(typed) {
            case = typed.case.copy()
            admitted = testing_history_admits<T>(case, bounds, strategy)
        }
        if !admitted {
            discarded += 1
            if discarded > bounds.max_discarded_cases -> return Err(testing_history_err("invalid history config: discarded cases exceeded the configured bound"))
            next
        }
        explored += 1
        observation :: testing_history_observe<T>(case, strategy, model, actual, observe)
        if observation.status == "contaminated" -> return Err(testing_history_err("invalid history oracle: {observation.reason}"))
        if observation.status == "mismatch" {
            shrunk :: testing_history_shrink<T>(case, observation, bounds, strategy, model, actual, observe)
            return Err(testing_history_failure(shrunk, discarded, cases, bounds, strategy.distributions, command_type, source, tool, target))
        }
        if observation.status != "matched" {
            discarded += 1
            if discarded > bounds.max_discarded_cases -> return Err(testing_history_err("invalid history config: discarded cases exceeded the configured bound"))
            next
        }
        if observation.sample == .Val(sample) -> &samples.push(sample.copy())
        &inputs.push(observation.input.copy())
        &reference_values.push(observation.reference.copy())
        &candidate_values.push(observation.candidate.copy())
    }
    status := "matched"
    reason := "{samples.len()} observed case(s) matched under typed_equality"
    if samples.len() == 0 {
        status = "empty"
        reason = if discarded > 0 -> "all comparison cases were discarded" else -> "comparison corpus is empty"
    } else if discarded > 0 {
        status = "invalid_oracle"
        reason = "comparison discarded cases and cannot claim equality"
    }
    if explored == 0 {
        status = "unavailable"
        reason = "no history case produced an observation"
    }
    case_ids := [String]{}
    loop sample in samples -> &case_ids.push(sample.case_id.copy())
    Ok(TestComparison{
        status: status,
        relation: "typed_equality",
        source: source,
        tool: tool,
        target: target,
        seed: Val(seed),
        case_ids: case_ids,
        inputs: inputs,
        reference: reference_values,
        candidate: candidate_values,
        first_difference: -1,
        reason: reason,
        universal_proof: false,
    })
}

// A case the campaign may observe: structurally valid, inside the bounds,
// rebuildable, and accepted by the strategy's `valid`.
fn testing_history_admits<T>(case: HistoryCase, bounds: HistoryBounds, strategy: HistoryStrategy<T>) -> Bool {
    if testing_history_case_error(case) != "" -> return false
    if !testing_history_within_bounds(case, bounds) -> return false
    rebuild :: strategy.rebuild
    valid :: strategy.valid
    typed :: rebuild(case.copy()) ?? return false
    valid(typed)
}

fn testing_history_within_bounds(case: HistoryCase, bounds: HistoryBounds) -> Bool Never! {
    if case.operations.len() > bounds.max_steps -> return false
    created := [Int:Bool]{}
    loop operation in case.operations {
        loop handle in operation.creates -> created[handle.value] = true
    }
    created.len() <= bounds.max_resources
}

// Observe one case: the model and the candidate each run, are observed, and
// run again so that an observation changing on replay is contamination.
fn testing_history_observe<T>(case: HistoryCase, strategy: HistoryStrategy<T>, model: fn([T]) -> Dyn, actual: fn([T]) -> Dyn, observe: fn(Dyn) -> Dyn) -> TestingHistoryObservation {
    rebuild :: strategy.rebuild
    input :: json.parse(testing_history_case_json(case)) ?? Dyn.Null
    typed :: rebuild(case.copy()) ?? return TestingHistoryObservation{status: "unavailable", reason: "history strategy could not rebuild a typed operation", sample: None, input: input, reference: Dyn.Null, candidate: Dyn.Null}
    reference_value :: model(typed.commands.copy())
    candidate_value :: actual(typed.commands.copy())
    reference_observed :: observe(reference_value.copy())
    candidate_observed :: observe(candidate_value.copy())
    reference_replay :: observe(model(typed.commands.copy()))
    candidate_replay :: observe(actual(typed.commands.copy()))
    sample :: TestingHistorySample{
        case_id: case.case_id.copy(),
        input_id: crypto.sha256(testing_history_case_json(case)).hex(),
        seed: case.seed,
        reference: json.dumps(reference_observed) ?? "null",
        candidate: json.dumps(candidate_observed) ?? "null",
        reference_replay: json.dumps(reference_replay) ?? "null",
        candidate_replay: json.dumps(candidate_replay) ?? "null",
    }
    status := "matched"
    reason := "1 observed case(s) matched under typed_equality"
    if sample.reference != sample.reference_replay {
        status = "contaminated"
        reason = "reference observation changed on replay for case `{case.case_id}`"
    } else if sample.candidate != sample.candidate_replay {
        status = "contaminated"
        reason = "candidate observation changed on replay for case `{case.case_id}`"
    } else if !reference_observed.equal_unordered(candidate_observed) {
        status = "mismatch"
        reason = "first differing observation is case `{case.case_id}`"
    }
    TestingHistoryObservation{status: status, reason: reason, sample: Val(sample), input: input, reference: reference_value, candidate: candidate_value}
}

struct TestingHistoryShrunk {
    case: HistoryCase
    observation: TestingHistoryObservation
}

// Shrink a failing case: first drop one operation (with everything that
// depends on it), then shrink one argument; a candidate is kept while it
// still mismatches. `max_shrink_attempts` bounds the candidates tried.
fn testing_history_shrink<T>(
    original: HistoryCase,
    first: TestingHistoryObservation,
    bounds: HistoryBounds,
    strategy: HistoryStrategy<T>,
    model: fn([T]) -> Dyn,
    actual: fn([T]) -> Dyn,
    observe: fn(Dyn) -> Dyn,
) -> TestingHistoryShrunk {
    current := original.copy()
    current_observation := first.copy()
    attempts := 0
    loop {
        changed := false
        loop index in 0..<current.operations.len() {
            if attempts >= bounds.max_shrink_attempts -> break
            candidate :: testing_history_without(current, index) ?? next
            attempts += 1
            if !testing_history_admits<T>(candidate, bounds, strategy) -> next
            observation :: testing_history_observe<T>(candidate, strategy, model, actual, observe)
            if observation.status == "mismatch" {
                current = candidate.copy()
                current_observation = observation.copy()
                changed = true
                break
            }
        }
        if changed -> next
        exhausted := false
        loop operation_index in 0..<current.operations.len() {
            if changed || exhausted -> break
            loop argument_index in 0..<current.operations[operation_index].arguments.len() {
                if changed || exhausted -> break
                loop value in testing_history_value_shrinks(current.operations[operation_index].arguments[argument_index]) {
                    if attempts >= bounds.max_shrink_attempts {
                        exhausted = true
                        break
                    }
                    candidate :: testing_history_with_argument(current, operation_index, argument_index, value)
                    attempts += 1
                    if !testing_history_admits<T>(candidate, bounds, strategy) -> next
                    observation :: testing_history_observe<T>(candidate, strategy, model, actual, observe)
                    if observation.status == "mismatch" {
                        current = candidate.copy()
                        current_observation = observation.copy()
                        changed = true
                        break
                    }
                }
            }
        }
        if !changed -> break
    }
    TestingHistoryShrunk{case: current, observation: current_observation}
}

fn testing_history_value_shrinks(value: HistoryValue) -> [HistoryValue] Never! {
    values := [HistoryValue]{}
    if value == {
        .Integer(number) -> {
            &values.push(HistoryValue.Integer(0))
            half :: if number < 0 -> 0 - ((0 - number) /% 2) else -> number /% 2
            if number != 0 && half != 0 -> &values.push(HistoryValue.Integer(half))
        }
        .Boolean(flag) -> {
            if flag -> &values.push(HistoryValue.Boolean(false))
        }
        .Text(text) -> {
            if text != "" {
                &values.push(HistoryValue.Text(""))
                characters :: text.chars()
                half := ""
                loop index in 0..<(characters.len() /% 2) -> half = "{half}{characters[index]}"
                &values.push(HistoryValue.Text(half))
            }
        }
        else -> {}
    }
    values
}

fn testing_history_with_argument(case: HistoryCase, operation_index: Int, argument_index: Int, value: HistoryValue) -> HistoryCase Never! {
    operations := [HistoryOperation]{}
    loop index in 0..<case.operations.len() {
        operation := case.operations[index].copy()
        if index == operation_index {
            arguments := [HistoryValue]{}
            loop position in 0..<operation.arguments.len() {
                &arguments.push(if position == argument_index -> value.copy() else -> operation.arguments[position].copy())
            }
            operation.arguments = arguments
        }
        &operations.push(operation)
    }
    HistoryCase{case_id: case.case_id.copy(), seed: case.seed, operations: operations, schedule: case.schedule.copy()}
}

// Remove operation `index` and, transitively, every operation that depends on
// a removed one or touches a handle a removed one created; the survivors are
// renumbered and their dependencies and schedule entries remapped.
fn testing_history_without(case: HistoryCase, index: Int) -> HistoryCase? Never! {
    count :: case.operations.len()
    if count <= 1 || index < 0 || index >= count -> return None
    removed := [Int:Bool]{}
    removed[index] = true
    changed := true
    loop changed {
        changed = false
        handles := [Int:Bool]{}
        loop position in 0..<count {
            if removed.get(position) == None -> next
            loop handle in case.operations[position].creates -> handles[handle.value] = true
        }
        loop position in 0..<count {
            if removed.get(position) != None -> next
            if testing_history_cascades(case.operations[position], removed, handles) {
                removed[position] = true
                changed = true
            }
        }
    }
    if removed.len() >= count -> return None
    remap := [Int:Int]{}
    kept := 0
    loop position in 0..<count {
        if removed.get(position) != None -> next
        remap[case.operations[position].index] = kept
        kept += 1
    }
    operations := [HistoryOperation]{}
    loop position in 0..<count {
        if removed.get(position) != None -> next
        operation := case.operations[position].copy()
        depends := [Int]{}
        loop dependency in operation.depends_on {
            found :: remap.get(dependency)
            if found == .Val(mapped) -> &depends.push(mapped)
        }
        operation.index = remap.get(operation.index) ?? 0
        operation.depends_on = depends
        &operations.push(operation)
    }
    schedule := [HistoryScheduleChoice]{}
    loop choice in case.schedule {
        mapped :: remap.get(choice.operation) ?? next
        entry := choice.copy()
        entry.operation = mapped
        &schedule.push(entry)
    }
    Val(HistoryCase{case_id: case.case_id.copy(), seed: case.seed, operations: operations, schedule: schedule})
}

fn testing_history_cascades(operation: HistoryOperation, removed: [Int:Bool], handles: [Int:Bool]) -> Bool Never! {
    loop dependency in operation.depends_on {
        if removed.get(dependency) != None -> return true
    }
    loop handle in operation.creates {
        if handles.get(handle.value) != None -> return true
    }
    loop handle in operation.consumes {
        if handles.get(handle.value) != None -> return true
    }
    loop argument in operation.arguments {
        if argument == .Handle(handle) && handles.get(handle.value) != None -> return true
    }
    loop precondition in operation.preconditions {
        handle :: testing_history_precondition_handle(precondition) ?? next
        if handles.get(handle) != None -> return true
    }
    false
}

fn testing_history_precondition_handle(precondition: HistoryPrecondition) -> Int? Never! {
    if precondition == {
        .HandleLive(handle) -> Val(handle.value)
        .HandleState(handle, _) -> Val(handle.value)
        else -> None
    }
}

// The structural rules of a replayable case: dense operation indexes,
// bounded metadata, argument handles live, dependencies on distinct earlier
// operations, satisfied preconditions, handles created once and consumed
// while live, and schedule choices that match their operation. Returns "" for
// a valid case.
fn testing_history_case_error(case: HistoryCase) -> String Never! {
    if case.case_id == "" || case.case_id.len() > 4096 -> return "case identity must be non-empty and bounded"
    if case.operations.len() == 0 -> return "case must contain at least one operation"
    if case.operations.len() > 4096 -> return "operation count exceeds the history bound"
    live := [Int:Bool]{}
    known := [Int:Bool]{}
    completed := [Int:Bool]{}
    events := [Int:Bool]{}
    loop position in 0..<case.operations.len() {
        operation :: case.operations[position]
        if operation.index != position -> return "operation {position} has index {operation.index}, expected {position}"
        if operation.name == "" || operation.name.len() > 4096 -> return "operation {position} has an invalid name"
        if operation.arguments.len() > 64 || operation.creates.len() > 4096 || operation.consumes.len() > 4096 || operation.preconditions.len() > 64 || operation.depends_on.len() > 64 {
            return "operation {position} exceeds its metadata bound"
        }
        loop argument in operation.arguments {
            failure :: testing_history_argument_error(position, argument, live)
            if failure != "" -> return failure
        }
        dependencies := [Int:Bool]{}
        loop dependency in operation.depends_on {
            if dependency < 0 || dependency >= position || dependencies.get(dependency) != None -> return "operation {position} has a duplicate or forward dependency"
            dependencies[dependency] = true
        }
        loop precondition in operation.preconditions {
            failure :: testing_history_precondition_error(position, precondition, live, completed, events)
            if failure != "" -> return failure
        }
        creates := [Int:Bool]{}
        loop handle in operation.creates {
            if creates.get(handle.value) != None -> return "operation {position} creates a handle more than once"
            creates[handle.value] = true
        }
        consumes := [Int:Bool]{}
        loop handle in operation.consumes {
            if consumes.get(handle.value) != None -> return "operation {position} consumes a handle more than once"
            if creates.get(handle.value) != None -> return "operation {position} creates and consumes one handle"
            consumes[handle.value] = true
        }
        loop handle in operation.consumes {
            if live.get(handle.value) == None -> return "operation {position} consumes non-live handle {handle.value}"
            &live.remove(handle.value).drop("a consumed handle leaves the live set")
        }
        loop handle in operation.creates {
            if known.get(handle.value) != None -> return "operation {position} recreates handle {handle.value}"
            known[handle.value] = true
            live[handle.value] = true
        }
        if operation.task == .Val(task_id) -> completed[task_id.value] = true
        if operation.event == .Val(event) -> events[event.value] = true
    }
    if known.len() > 4096 -> return "resource count exceeds the history bound"
    loop choice in case.schedule {
        if choice.operation < 0 || choice.operation >= case.operations.len() -> return "schedule references missing operation {choice.operation}"
        operation :: case.operations[choice.operation]
        if choice.task == .Val(task_id) && operation.task != Val(task_id) -> return "schedule task does not match operation {choice.operation}"
        if choice.event == .Val(event) && operation.event != Val(event) -> return "schedule event does not match operation {choice.operation}"
        if choice.choice == "" || choice.choice.len() > 4096 -> return "schedule choice must be non-empty and bounded"
    }
    ""
}

fn testing_history_argument_error(position: Int, argument: HistoryValue, live: [Int:Bool]) -> String Never! {
    if argument == {
        .Text(text) -> {
            if text.len() > 4096 -> return "operation {position} has an oversized argument"
        }
        .Redacted(label) -> {
            if label == "" || label.len() > 4096 -> return "operation {position} has an invalid redacted argument"
        }
        .Handle(handle) -> {
            if live.get(handle.value) == None -> return "operation {position} requires non-live argument handle {handle.value}"
        }
        else -> {}
    }
    ""
}

fn testing_history_precondition_error(position: Int, precondition: HistoryPrecondition, live: [Int:Bool], completed: [Int:Bool], events: [Int:Bool]) -> String Never! {
    if precondition == {
        .HandleLive(handle) -> if live.get(handle.value) == None -> return "operation {position} requires non-live handle {handle.value}"
        .HandleState(handle, state) -> {
            if state == "" || state.len() > 4096 -> return "operation {position} has an invalid handle state"
            if live.get(handle.value) == None -> return "operation {position} requires non-live handle {handle.value}"
        }
        .TaskCompleted(task_id) -> if completed.get(task_id.value) == None -> return "operation {position} requires incomplete task {task_id.value}"
        .EventAvailable(event) -> if events.get(event.value) == None -> return "operation {position} requires unavailable event {event.value}"
    }
    ""
}

fn testing_history_quote(text: String) -> String Never! { json.dumps(Dyn.Text(text.copy())) ?? "\"\"" }

fn testing_history_value_json(value: HistoryValue) -> String Never! {
    if value == {
        .Integer(number) -> "{number}"
        .Boolean(flag) -> if flag -> "true" else -> "false"
        .Text(text) -> testing_history_quote(text)
        .Handle(handle) -> "{handle.value}"
        .Redacted(label) -> "{{\"redacted\":{testing_history_quote(label)}}}"
    }
}

fn testing_history_precondition_json(precondition: HistoryPrecondition) -> String Never! {
    if precondition == {
        .HandleLive(handle) -> "{{\"kind\":\"handle_live\",\"handle\":{handle.value}}}"
        .HandleState(handle, state) -> "{{\"handle\":{handle.value},\"kind\":\"handle_state\",\"state\":{testing_history_quote(state)}}}"
        .TaskCompleted(task_id) -> "{{\"kind\":\"task_completed\",\"task\":{task_id.value}}}"
        .EventAvailable(event) -> "{{\"event\":{event.value},\"kind\":\"event_available\"}}"
    }
}

fn testing_history_operation_json(operation: HistoryOperation) -> String Never! {
    arguments := [String]{}
    loop value in operation.arguments -> &arguments.push(testing_history_value_json(value))
    creates := [String]{}
    loop handle in operation.creates -> &creates.push("{handle.value}")
    consumes := [String]{}
    loop handle in operation.consumes -> &consumes.push("{handle.value}")
    preconditions := [String]{}
    loop precondition in operation.preconditions -> &preconditions.push(testing_history_precondition_json(precondition))
    dependencies := [String]{}
    loop dependency in operation.depends_on -> &dependencies.push("{dependency}")
    event_json :: if operation.event == .Val(event_id) -> "{event_id.value}" else -> "null"
    task_json :: if operation.task == .Val(task_id) -> "{task_id.value}" else -> "null"
    "{{\"arguments\":[{arguments.join(",")}],\"consumes\":[{consumes.join(",")}],\"creates\":[{creates.join(",")}],\"dependsOn\":[{dependencies.join(",")}],\"event\":{event_json},\"index\":{operation.index},\"name\":{testing_history_quote(operation.name)},\"preconditions\":[{preconditions.join(",")}],\"task\":{task_json}}}"
}

fn testing_history_schedule_json(choice: HistoryScheduleChoice) -> String Never! {
    event_json :: if choice.event == .Val(event_id) -> "{event_id.value}" else -> "null"
    task_json :: if choice.task == .Val(task_id) -> "{task_id.value}" else -> "null"
    "{{\"choice\":{testing_history_quote(choice.choice)},\"event\":{event_json},\"operation\":{choice.operation},\"task\":{task_json}}}"
}

fn testing_history_operations_json(case: HistoryCase) -> String Never! {
    rows := [String]{}
    loop operation in case.operations -> &rows.push(testing_history_operation_json(operation))
    rows.join(",")
}

fn testing_history_schedules_json(case: HistoryCase) -> String Never! {
    rows := [String]{}
    loop choice in case.schedule -> &rows.push(testing_history_schedule_json(choice))
    rows.join(",")
}

// The canonical case JSON: the callback input and, hashed, the input identity.
fn testing_history_case_json(case: HistoryCase) -> String Never! {
    "{{\"caseId\":{testing_history_quote(case.case_id)},\"operations\":[{testing_history_operations_json(case)}],\"schedule\":[{testing_history_schedules_json(case)}],\"seed\":{case.seed}}}"
}

fn testing_history_identity_json(sample: TestingHistorySample, source: String, tool: String, target: String) -> String Never! {
    "{{\"caseId\":{testing_history_quote(sample.case_id)},\"inputId\":{testing_history_quote(sample.input_id)},\"seed\":{sample.seed},\"source\":{testing_history_quote(source)},\"target\":{testing_history_quote(target)},\"tool\":{testing_history_quote(tool)}}}"
}

fn testing_history_observation_json(raw: String) -> String Never! {
    "{{\"cleanup\":[],\"mutation\":null,\"orderedEffects\":[],\"raw\":{testing_history_quote(raw)},\"typedFailure\":null}}"
}

fn testing_history_sample_json(sample: TestingHistorySample, source: String, tool: String, target: String) -> String Never! {
    "{{\"candidate\":{testing_history_observation_json(sample.candidate)},\"candidateReplay\":{testing_history_observation_json(sample.candidate_replay)},\"identity\":{testing_history_identity_json(sample, source, tool, target)},\"reference\":{testing_history_observation_json(sample.reference)},\"referenceReplay\":{testing_history_observation_json(sample.reference_replay)}}}"
}

// Operations after the first that carry neither a dependency nor a
// precondition: legal, but reported so a case count cannot hide them.
fn testing_history_vacuous(case: HistoryCase) -> Int Never! {
    count := 0
    loop position in 1..<case.operations.len() {
        if case.operations[position].preconditions.len() == 0 && case.operations[position].depends_on.len() == 0 -> count += 1
    }
    count
}

// The failure of a campaign: a one-line summary naming the reduced case and
// its operations, caused by an Err that carries the replayable artifact JSON.
// The artifact id is the SHA-256 of the artifact payload.
fn testing_history_failure(shrunk: TestingHistoryShrunk, discarded: Int, cases: Int, bounds: HistoryBounds, distributions: [HistoryDistribution], command_type: String, source: String, tool: String, target: String) -> Err Never! {
    case :: shrunk.case
    sample :: shrunk.observation.sample ?? return testing_history_err("history mismatch in case `{case.case_id}`")
    samples :: testing_history_sample_json(sample, source, tool, target)
    comparison :: "{{\"contamination\":null,\"discardedCases\":0,\"firstDifference\":0,\"reason\":{testing_history_quote(shrunk.observation.reason)},\"relation\":\"typed_equality\",\"samples\":[{samples}],\"status\":\"mismatch\",\"universalProof\":false}}"
    rows := [String]{}
    loop distribution in distributions -> &rows.push("{{\"operation\":{testing_history_quote(distribution.operation)},\"weight\":{distribution.weight}}}")
    identity :: testing_history_identity_json(sample, source, tool, target)
    oracle :: "{{\"dependencies\":[],\"root\":\"testing.histories.model\"}}"
    body :: "\"bounds\":{{\"maxDiscardedCases\":{bounds.max_discarded_cases},\"maxResources\":{bounds.max_resources},\"maxSteps\":{bounds.max_steps},\"maxShrinkAttempts\":{bounds.max_shrink_attempts}}},\"case\":{testing_history_quote(case.case_id)},\"cases\":{cases},\"commandType\":{testing_history_quote(command_type)},\"comparison\":{comparison},\"discardedCases\":{discarded},\"distributions\":[{rows.join(",")}],\"identity\":{identity},\"operations\":[{testing_history_operations_json(case)}],\"oracle\":{oracle},\"schedule\":[{testing_history_schedules_json(case)}],\"schema\":\"jet.testing.history\",\"seed\":{case.seed},\"vacuousPreconditions\":{testing_history_vacuous(case)},\"version\":1}}"
    artifact_id :: crypto.sha256("{{{body}").hex()
    names := [String]{}
    loop operation in case.operations -> &names.push(operation.name.copy())
    artifact :: Err{message: "history-artifact {{\"artifactId\":{testing_history_quote(artifact_id)},{body}", code: None, cause: None}
    Err{message: "history mismatch in case `{case.case_id}`: {names.join(" -> ")}", code: None, cause: Val(artifact)}
}

// The `artifactId` of a campaign failure: the 64 hex digits that open its
// cause, `history-artifact {"artifactId":"<id>",...`.
fn testing_history_artifact_id(failure: Err) -> String Never! {
    if failure.cause == .Val(cause) -> return cause.message.slice(32, 96)
    ""
}

#Test("a history artifact id changes with its source provenance") {
    case :: HistoryCase{case_id: "C-0", seed: 3, operations: [HistoryOperation]{}, schedule: [HistoryScheduleChoice]{}}
    sample :: TestingHistorySample{case_id: "C-0", input_id: "C-0", seed: 3, reference: "1", candidate: "2", reference_replay: "1", candidate_replay: "2"}
    observation :: TestingHistoryObservation{status: "mismatch", reason: "first differing observation is case `C-0`", sample: Val(sample), input: Dyn.Int(0), reference: Dyn.Int(1), candidate: Dyn.Int(2)}
    bounds :: HistoryBounds{max_steps: 8, max_resources: 8, max_shrink_attempts: 8, max_discarded_cases: 0}
    shrunk :: TestingHistoryShrunk{case: case, observation: observation}
    first :: testing_history_failure(shrunk, 0, 1, bounds, [HistoryDistribution]{}, "C", "source-a", "tool", "target")
    again :: testing_history_failure(shrunk, 0, 1, bounds, [HistoryDistribution]{}, "C", "source-a", "tool", "target")
    edited :: testing_history_failure(shrunk, 0, 1, bounds, [HistoryDistribution]{}, "C", "source-b", "tool", "target")
    assert_eq(first.message, edited.message)
    assert_eq(testing_history_artifact_id(first).len(), 64)
    assert_eq(testing_history_artifact_id(first), testing_history_artifact_id(again))
    assert_eq(testing_history_artifact_id(first) == testing_history_artifact_id(edited), false)
}

// A strategy derived from a command enum whose variant payloads are Int,
// Bool or String values. Each `variants` row is the variant's operation name
// followed by one `:i`, `:b` or `:s` per payload field; `make` builds the
// command from the row position and the payload values grouped by kind.
// Every variant has weight 1.
fn testing_history_derived<T>(^command_type: String, variants: [String], ^make: fn(Int, [Int], [Bool], [String]) -> T Never!) -> HistoryStrategy<T> {
    names := [String]{}
    kinds := [[String]]{}
    distributions := [HistoryDistribution]{}
    loop row in variants {
        parts :: row.split(":").to_list()
        fields := [String]{}
        loop position in 1..<parts.len() -> &fields.push(parts[position].copy())
        &names.push(parts[0].copy())
        &kinds.push(fields)
        &distributions.push(HistoryDistribution{operation: parts[0].copy(), weight: 1})
    }
    HistoryStrategy<T>{
        generate: (rng: HistoryRNG, case_index: Int, max_steps: Int) -> { testing_history_derived_generate<T>(rng, case_index, max_steps, command_type, names, kinds, make) },
        rebuild: (case: HistoryCase) -> { testing_history_derived_rebuild<T>(case, names, kinds, make) },
        valid: (typed: TypedHistoryCase<T>) -> { testing_history_case_error(typed.case) == "" },
        bounds: HistoryBounds{max_steps: 64, max_resources: 64, max_shrink_attempts: 10000, max_discarded_cases: 100},
        distributions: distributions,
    }
}

// One derived case: the case seed is the next campaign draw, and a local
// generator seeded by it picks 1 + below(min(max_steps, 8)) operations, each
// a uniformly chosen variant whose payload draws Int as -8 + below(17), Bool
// as below(2) != 0 and String as "history-{below(17)}". Every operation after
// the first depends on its predecessor.
fn testing_history_derived_generate<T>(rng: HistoryRNG, case_index: Int, max_steps: Int, command_type: String, names: [String], kinds: [[String]], make: fn(Int, [Int], [Bool], [String]) -> T Never!) -> TypedHistoryCase<T>? {
    if max_steps <= 0 || names.len() == 0 -> return None
    case_seed :: __history_rng_next(rng)
    local :: __history_rng_new(case_seed)
    step_count :: 1 + __history_rng_below(local, if max_steps < 8 -> max_steps else -> 8)
    operations := [HistoryOperation]{}
    loop index in 0..<step_count {
        choice :: __history_rng_below(local, names.len())
        arguments := [HistoryValue]{}
        loop kind in kinds[choice] {
            if kind == "i" {
                &arguments.push(HistoryValue.Integer(__history_rng_below(local, 17) - 8))
            } else if kind == "b" {
                &arguments.push(HistoryValue.Boolean(__history_rng_below(local, 2) != 0))
            } else {
                &arguments.push(HistoryValue.Text("history-{__history_rng_below(local, 17)}"))
            }
        }
        preconditions := [HistoryPrecondition]{}
        depends_on := [Int]{}
        if index > 0 {
            &depends_on.push(index - 1)
            &preconditions.push(HistoryPrecondition.TaskCompleted(TaskID{value: (index - 1) % 2}))
            &preconditions.push(HistoryPrecondition.EventAvailable(EventID{value: index}))
        }
        &operations.push(HistoryOperation{
            index: index,
            name: names[choice].copy(),
            arguments: arguments,
            creates: [HandleID]{},
            consumes: [HandleID]{},
            preconditions: preconditions,
            depends_on: depends_on,
            task: Val(TaskID{value: index % 2}),
            event: Val(EventID{value: index + 1}),
        })
    }
    case :: HistoryCase{case_id: "{command_type}-{case_index}", seed: case_seed, operations: operations, schedule: [HistoryScheduleChoice]{}}
    testing_history_derived_rebuild<T>(case, names, kinds, make)
}

fn testing_history_derived_rebuild<T>(case: HistoryCase, names: [String], kinds: [[String]], make: fn(Int, [Int], [Bool], [String]) -> T Never!) -> TypedHistoryCase<T>? {
    commands := [T]{}
    loop operation in case.operations {
        choice := -1
        loop position in 0..<names.len() {
            if names[position] == operation.name {
                choice = position
                break
            }
        }
        if choice < 0 || operation.creates.len() != 0 || operation.consumes.len() != 0 || operation.arguments.len() != kinds[choice].len() -> return None
        ints := [Int]{}
        bools := [Bool]{}
        texts := [String]{}
        loop position in 0..<operation.arguments.len() {
            kind :: kinds[choice][position]
            if operation.arguments[position] == {
                .Integer(number) -> if kind == "i" -> &ints.push(number) else -> return None
                .Boolean(flag) -> if kind == "b" -> &bools.push(flag) else -> return None
                .Text(text) -> if kind == "s" -> &texts.push(text.copy()) else -> return None
                else -> return None
            }
        }
        &commands.push(make(choice, ints, bools, texts))
    }
    Val(TypedHistoryCase<T>{case: case.copy(), commands: commands})
}

// I9: exact interpreter DiagnosticErr cleanup needs an error-capture rail.
// Preserve the existing native lifecycle rather than changing Err-path order.
fn world(body: fn(DeterministicWorld)) Never! { core.testing.world(body) }

fn status(comparison: TestComparison) -> String Never! { comparison.status }


#Test("corpus reports an absent directory as an empty collection") {
    assert_eq(corpus("__jet_absent_corpus__/missing").len(), 0)
}

#Test("corpus entries walk every depth in id order and skip hidden names") {
    root :: temp_dir("corpus-entries")
    loop folder in ["b", "a/deep", ".hidden"] {
        files.create_dir_all("{root}/{folder}") ?? panic("corpus folder: {err}")
    }
    loop file in ["b/two.jet", "a/deep/one.jet", "a/zero.jet", "top.jet", "a/notes.txt", ".skip.jet", ".hidden/three.jet"] {
        files.write("{root}/{file}", file) ?? panic("corpus file: {err}")
    }
    entries :: corpus_entries(root, ".jet")
    ids := [String]{}
    loop entry in entries -> &ids.push(entry.id.copy())
    assert_eq(ids, ["a/deep/one", "a/zero", "b/two", "top"])
    assert_eq(files.read(entries[0].path) ?? "", "a/deep/one.jet")
    assert_eq(corpus_entries("{root}/absent", ".jet").len(), 0)
}

fn snapshot_name(name: String) -> String Never! {
    out := [U8]{}
    loop byte in name.bytes() {
        c :: Int.from_u8(byte)
        if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 95 {
            &out.push(byte)
        } else if c < 128 || c >= 192 {
            // String is valid UTF-8; only a leading byte starts a scalar.
            &out.push(U8{95})
        }
    }
    if out.len() == 0 -> return "case"
    String.from_bytes(out) ?? panic("snapshot names contain only ASCII")
}

#Test("Snapshot names replace each non-ASCII scalar exactly once") {
    assert_eq(snapshot_name(""), "case")
    assert_eq(snapshot_name("a/B.c é界"), "a_B_c___")
    assert_eq(snapshot_name("safe-Name_42"), "safe-Name_42")
}

// String storage primitives are shared with the encoding kernel. Bounds and
// UTF-8 boundary choices are made here, not in a host-side diff algorithm.
fn testing_byte(text: String, index: Int) -> Int Never! {
    #Unsafe("the caller bounded this byte position by the String storage length") {
        return Int.from_u8(core.encoding.__string_byte(text, U64{index}))
    }
}

fn testing_boundary(text: String, end: Int) -> Int Never! {
    position := end
    length :: text.count_bytes()
    loop position > 0 && position < length {
        byte :: testing_byte(text, position)
        if byte < 128 || byte >= 192 -> break
        position = position - 1
    }
    position
}

fn testing_window(text: String, start: Int, end: Int) -> String Never! {
    __text_window(text, U64{start}, U64{end})
}

fn testing_owned_text(bytes: ^[U8]) -> String Never! {
    #Unsafe("all appended bytes came from complete UTF-8 strings or ASCII") {
        return core.encoding.__bytes_into_text(^bytes)
    }
}

struct TestingDiffLines {
    lines: [String]
    truncated: Bool
}

fn testing_diff_lines(text: String) -> TestingDiffLines Never! {
    length :: text.count_bytes()
    end :: testing_boundary(text, if length > 65536 -> 65536 else -> length)
    lines := [String]{}
    start := 0
    cursor := 0
    loop cursor < end && lines.len() < 256 {
        byte :: testing_byte(text, cursor)
        cursor = cursor + 1
        if byte == 10 {
            &lines.push(testing_window(text, start, cursor))
            start = cursor
        }
    }
    if start < cursor && lines.len() < 256 -> &lines.push(testing_window(text, start, cursor))
    TestingDiffLines{lines: ^lines, truncated: end < length || cursor < end}
}

struct TestingDiffOutput {
    bytes: [U8]
    truncated: Bool
}

fn testing_append_bytes(output: &[U8], text: String, end: Int) Never! {
    loop index in 0..<end -> &output.push(U8{testing_byte(text, index)})
}

fn testing_diff_push(output: &TestingDiffOutput, text: String) Never! {
    if output.truncated -> return
    length :: text.count_bytes()
    available :: 32768 - output.bytes.len()
    if length <= available {
        testing_append_bytes(&output.bytes, text, length)
        return
    }
    marker :: "\n... diff output truncated ...\n"
    marker_length :: marker.count_bytes()
    if available >= marker_length {
        end :: testing_boundary(text, available - marker_length)
        testing_append_bytes(&output.bytes, text, end)
        testing_append_bytes(&output.bytes, marker, marker_length)
    } else if available > 0 {
        testing_append_bytes(&output.bytes, marker, available)
    }
    output.truncated = true
}

fn testing_diff_line(output: &TestingDiffOutput, marker: String, line: String) Never! {
    if output.truncated -> return
    line_length :: line.count_bytes()
    newline :: !line.ends_with("\n")
    length :: 1 + line_length + if newline -> 1 else -> 0
    available :: 32768 - output.bytes.len()
    if length <= available {
        testing_append_bytes(&output.bytes, marker, 1)
        testing_append_bytes(&output.bytes, line, line_length)
        if newline -> testing_append_bytes(&output.bytes, "\n", 1)
        return
    }
    truncated_marker :: "\n... diff output truncated ...\n"
    marker_length :: truncated_marker.count_bytes()
    if available >= marker_length {
        budget :: available - marker_length
        if budget > 0 {
            testing_append_bytes(&output.bytes, marker, 1)
            end :: testing_boundary(line, budget - 1)
            testing_append_bytes(&output.bytes, line, end)
        }
        testing_append_bytes(&output.bytes, truncated_marker, marker_length)
    } else if available > 0 {
        testing_append_bytes(&output.bytes, truncated_marker, available)
    }
    output.truncated = true
}

fn testing_unified_diff(path: String, expected: String, actual: String) -> String Never! {
    before :: testing_diff_lines(expected)
    after :: testing_diff_lines(actual)
    rows :: before.lines.len() + 1
    cols :: after.lines.len() + 1
    lcs := [Int]{}
    loop _ in 0..<(rows * cols) -> &lcs.push(0)
    row := before.lines.len() - 1
    loop row >= 0 {
        col := after.lines.len() - 1
        loop col >= 0 {
            index :: row * cols + col
            if before.lines[row] == after.lines[col] {
                lcs[index] = 1 + lcs[(row + 1) * cols + col + 1]
            } else {
                down :: lcs[(row + 1) * cols + col]
                right :: lcs[row * cols + col + 1]
                lcs[index] = if down > right -> down else -> right
            }
            col = col - 1
        }
        row = row - 1
    }
    output := TestingDiffOutput{bytes: [U8]{}, truncated: false}
    testing_diff_push(&output, "--- expected {path}\n+++ actual {path}\n")
    if before.truncated -> testing_diff_push(&output, "# expected input truncated\n")
    if after.truncated -> testing_diff_push(&output, "# actual input truncated\n")
    testing_diff_push(&output, "@@ -1,{before.lines.len()} +1,{after.lines.len()} @@\n")
    row = 0
    col := 0
    loop row < before.lines.len() || col < after.lines.len() {
        if row < before.lines.len() && col < after.lines.len() && before.lines[row] == after.lines[col] {
            testing_diff_line(&output, " ", before.lines[row])
            row = row + 1
            col = col + 1
        } else if col < after.lines.len() && (row == before.lines.len() || lcs[row * cols + col + 1] > lcs[(row + 1) * cols + col]) {
            testing_diff_line(&output, "+", after.lines[col])
            col = col + 1
        } else if row < before.lines.len() {
            testing_diff_line(&output, "-", before.lines[row])
            row = row + 1
        }
    }
    testing_owned_text(^output.bytes)
}

fn testing_ascii_name(text: String, thread: Bool) -> String Never! {
    bytes := [U8]{}
    loop index in 0..<text.count_bytes() {
        byte :: testing_byte(text, index)
        alnum :: (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57)
        if alnum || (!thread && (byte == 95 || byte == 45)) {
            &bytes.push(U8{byte})
        } else if !thread && (byte < 128 || byte >= 192) {
            &bytes.push(U8{95})
        }
    }
    testing_owned_text(^bytes)
}

fn testing_temp_error(operation: String, path: String, cause: String) -> String Never! {
    "test evidence {operation} failed for {path}: {cause}"
}

#Test("golden diff uses delete-before-insert ties and final newline normalization") {
    assert_eq(testing_unified_diff("golden", "one\ntwo", "one\nthree"),
        "--- expected golden\n+++ actual golden\n@@ -1,2 +1,2 @@\n one\n-two\n+three\n")
    assert_eq(testing_unified_diff("empty", "", ""),
        "--- expected empty\n+++ actual empty\n@@ -1,0 +1,0 @@\n")
}

#Test("temporary names sanitize each Unicode scalar, not each UTF-8 byte") {
    assert_eq(testing_ascii_name("a/é--中_z", false), "a__--__z")
    assert_eq(testing_ascii_name("ThreadId(42)", true), "ThreadId42")
}

// Private plain-record physical facts, not raw-codec tuples.
struct __EvidenceRead { ok: Bool, text: String, missing: Bool }
struct __TempFacts { pid: U64, thread: String }
struct __TempPath { path: [U8], text: String }
struct __TempRemove { ok: Bool, missing: Bool, cause: String }
struct __TempCreate { ok: Bool, cause: String }
