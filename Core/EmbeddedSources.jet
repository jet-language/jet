// The embedded bytes of the Core asset at repository path `path`, or None
// when no Core source embeds that path.
asset_bytes: fn(path: String) -> [U8]? Never! {
    if path == "Core/Ui/XkbTables/keysym_names.txt" -> return Val(CORE_ASSET_0)
    if path == "Core/Ui/XkbTables/keysym_values.bin" -> return Val(CORE_ASSET_1)
    if path == "Core/Ui/XkbTables/keysym_scalars.bin" -> return Val(CORE_ASSET_2)
    if path == "Core/Ui/XkbTables/compose_nodes.bin" -> return Val(CORE_ASSET_3)
    if path == "Core/Ui/XkbTables/compose_text.bin" -> return Val(CORE_ASSET_4)
    if path == "Core/Ui/FontData/AtkinsonHyperlegibleNext-Regular.ttf" -> return Val(CORE_ASSET_5)
    if path == "Core/Ui/FontData/AtkinsonHyperlegibleNext-Bold.ttf" -> return Val(CORE_ASSET_6)
    if path == "Core/Ui/FontData/OFL.txt" -> return Val(CORE_ASSET_7)
    None
}
