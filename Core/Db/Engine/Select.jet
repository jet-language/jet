// SELECT: a port of SQLite 3.45.0 select.c, the code generator for SELECT
// statements (sqlite3Select and sqlite3SelectPrep with the routines they
// use). The parse-time half of select.c (clearSelect, sqlite3SelectNew,
// sqlite3JoinType, sqlite3SelectOpName, sqlite3WithPush) is Ast's;
// sqlite3ColumnIndex and sqlite3KeyInfoAlloc are Catalog's,
// sqlite3SrcItemColumnUsed and sqlite3SelectWrongNumTermsError Resolve's,
// sqlite3SetJoinExpr WhereExpr's, sqlite3GetVdbe Codegen's,
// sqlite3SelectDestInit Expr's and sqlite3KeyInfoFromExprList Window's.
//
// A SrcItem's Table is a p.db.tables slot. A Table this file makes for a
// subquery, a view or a CTE in the FROM clause (sqlite3ExpandSubquery and
// the CTE half of selectExpander) is TF_EPHEMERAL with its own reference
// (nTabRef 1); a FROM item that names a schema table takes an AST
// reference on it (ast.tab_ref, where C does nTabRef++). C frees the
// ephemeral tables as sqlite3SrcListDelete deletes their items; here the
// statement's end (sqlite3ParseObjectReset, above this part) frees the
// live TF_EPHEMERAL tables the AST's items name, and every Select the
// arena holds dies with it, so the sqlite3ParserAddCleanup calls that free
// detached Selects and ExprLists have nothing to do.
//
// SortCtx.pDeferredRowLoad is SortCtx.deferred with the RowLoadInfo it
// points at (deferred_reg, deferred_flags); a NULL pSort or pDistinct is a
// SortCtx with no ORDER BY (order_by -1) or a DistinctCtx of
// WHERE_DISTINCT_NOOP. NameContext chains that only carry pSrcList (the
// column-type walk) are lists of SrcLists, innermost first.
//
// The build has SQLITE_ENABLE_COLUMN_METADATA and none of
// SQLITE_ENABLE_SORTER_REFERENCES, SQLITE_ENABLE_STMT_SCANSTATUS,
// SQLITE_DEBUG or SQLITE_ENABLE_HIDDEN_COLUMNS; VdbeComment,
// VdbeCoverage, TREETRACE and sqlite3ProgressCheck (no progress handler
// runs during code generation) code nothing.
use {
    base: __core_db_base
    ast: __core_db_ast
    __core_db_ast.[SQLWalker]
    tk: __core_db_tokenize
    util: __core_db_util
    os: __core_db_os
    conn: __core_db_conn
    btree: __core_db_btree
    opc: __core_db_opcodes
    record: __core_db_record
    cg: __core_db_codegen
    __core_db_codegen.[WalkCb]
    cat: __core_db_catalog
    rs: __core_db_resolve
    ex: __core_db_expr
    we: __core_db_whereexpr
    wh: __core_db_where
    wn: __core_db_window
}

// ---------------------------------------------------------------------------
// The DISTINCT and ORDER BY state of a query being coded.

// SORTFLAG_UseSorter: SorterOpen rather than OpenEphemeral.
SORTFLAG_USE_SORTER: 1

// struct DistinctCtx.
DistinctCtx: struct {
    is_tnct: Int
    e_tnct_type: Int
    tab_tnct: Int
    addr_tnct: Int
}

// A NULL pDistinct.
no_distinct: fn() -> DistinctCtx Never! { DistinctCtx{is_tnct: 0, e_tnct_type: cg.WHERE_DISTINCT_NOOP, tab_tnct: 0, addr_tnct: 0} }

// struct SortCtx (see the file header).
SortCtx: struct {
    order_by: Int
    n_ob_sat: Int
    i_ecursor: Int
    reg_return: Int
    label_bk_out: Int
    addr_sort_index: Int
    label_done: Int
    label_ob_lopt: Int
    sort_flags: Int
    deferred: Bool
    deferred_reg: Int
    deferred_flags: Int
}

// A NULL pSort, and the zeroed SortCtx sqlite3Select starts from.
no_sort: fn() -> SortCtx Never! {
    SortCtx{order_by: -1, n_ob_sat: 0, i_ecursor: 0, reg_return: 0, label_bk_out: 0, addr_sort_index: 0, label_done: 0, label_ob_lopt: 0, sort_flags: 0, deferred: false, deferred_reg: 0, deferred_flags: 0}
}

// IsHiddenColumn.
is_hidden_column: fn(col: conn.Column) -> Bool Never! { col.col_flags.bit_and(conn.COLFLAG_HIDDEN) != 0 }

// findRightmost: the right-most SELECT of the compound s belongs to.
find_rightmost: fn(a: ast.AST, s0: Int) -> Int Never! {
    s := s0
    loop a.selects[s].next_sel >= 0 -> s = a.selects[s].next_sel
    s
}

// ---------------------------------------------------------------------------
// Joins.

// tableAndColumnIndex: the first of FROM items i_start..i_end of `src`
// whose table has a column z_col (not a hidden one with ignore_hidden), as
// the item and the column, -1 for none. With mark_used the column's use is
// recorded (C's non-NULL piTab).
table_and_column_index: fn(db: conn.Conn, a: &ast.AST, src: Int, i_start: Int, i_end: Int, z_col: [U8], ignore_hidden: Bool, mark_used: Bool) -> (tab: Int, col: Int) Never! {
    loop i in i_start..<(i_end + 1) {
        si: ast.src_item(a, src, i)
        t: a.items[si].tab
        i_col: cat.column_index(db, t, z_col)
        if i_col >= 0 && (!ignore_hidden || !is_hidden_column(db.tables[t].cols[i_col])) {
            if mark_used -> rs.src_item_column_used(a, si, i_col)
            return (tab: i, col: i_col)
        }
    }
    (tab: -1, col: -1)
}

// unsetJoinExpr: undo sqlite3SetJoinExpr for join i_table (every join when
// negative); with `nullable` a column of i_table keeps EP_CAN_BE_NULL.
unset_join_expr: fn(a: &ast.AST, e0: Int, i_table: Int, nullable: Bool) Never! {
    e := e0
    loop e >= 0 {
        if i_table < 0 || (ast.has(a, e, ast.EP_OUTER_ON) && a.exprs[e].w == i_table) {
            ast.clear_flags(a, e, ast.EP_OUTER_ON.bit_or(ast.EP_INNER_ON))
            if i_table >= 0 -> ast.set_flags(a, e, ast.EP_INNER_ON)
        }
        if a.exprs[e].op == tk.TK_COLUMN && a.exprs[e].itable == i_table && !nullable -> ast.clear_flags(a, e, ast.EP_CAN_BE_NULL)
        if a.exprs[e].op == tk.TK_FUNCTION {
            l: a.exprs[e].x
            loop i in 0..<ast.list_len(a, l) {
                x: ast.list_expr(a, l, i)
                unset_join_expr(a, x, i_table, nullable)
            }
        }
        left: a.exprs[e].left
        unset_join_expr(a, left, i_table, nullable)
        e = a.exprs[e].right
    }
}

// The coalesce() call sqlite3ProcessJoin builds over `args` (C's static
// tkCoalesce token, which no statement text holds).
coalesce_function: fn(a: &ast.AST, args: Int) -> Int Never! {
    e: ast.expr_alloc(a, tk.TK_FUNCTION, Val("coalesce".bytes()), true)
    a.exprs[e].w = -1
    a.exprs[e].x = args
    ast.set_flags(a, e, ast.EP_HAS_FUNC)
    ast.set_height_and_flags(a, e)
    e
}

// sqlite3ProcessJoin: NATURAL joins become USING joins, and the USING and
// ON constraints join the WHERE clause marked EP_OUTER_ON or EP_INNER_ON.
// The number of errors.
process_join: fn(p: &cg.Parse, a: &ast.AST, s: Int) -> Int Never! {
    src: a.selects[s].src
    n: ast.src_len(a, src)
    loop i in 0..<(n - 1) {
        sl: ast.src_item(a, src, i)
        sr: ast.src_item(a, src, i + 1)
        right_tab: a.items[sr].tab
        if a.items[sl].tab < 0 || right_tab < 0 -> next
        join_type: if a.items[sr].jointype.bit_and(ast.JT_OUTER) != 0 -> ast.EP_OUTER_ON else -> ast.EP_INNER_ON
        if a.items[sr].jointype.bit_and(ast.JT_NATURAL) != 0 {
            if a.items[sr].is_using || a.items[sr].u3 >= 0 {
                ast.error(a, "a NATURAL join may not have an ON or USING clause")
                return 1
            }
            using := -1
            loop j in 0..<p.db.tables[right_tab].cols.len() {
                col: p.db.tables[right_tab].cols[j]
                if is_hidden_column(col) -> next
                if table_and_column_index(p.db, a, src, 0, i, col.name, true, false).tab >= 0 {
                    using = ast.id_list_append(a, using, None)
                    k: a.idlists[using].items.len() - 1
                    a.idlists[using].items[k].name = Val(col.name.copy())
                }
            }
            if using >= 0 {
                a.items[sr].is_using = true
                a.items[sr].is_synth_using = true
                a.items[sr].u3 = using
            }
            if cg.n_err(a) > 0 -> return 1
        }
        if a.items[sr].is_using {
            list: a.items[sr].u3
            synth: a.items[sr].is_synth_using
            loop j in 0..<a.idlists[list].items.len() {
                z: a.idlists[list].items[j].name ?? [U8]{}
                i_right_col: cat.column_index(p.db, right_tab, z)
                found := (tab: -1, col: -1)
                if i_right_col >= 0 -> found = table_and_column_index(p.db, a, src, 0, i, z, synth, true)
                if found.tab < 0 {
                    ast.error(a, "cannot join using column {ast.text(z)} - column not present in both tables")
                    return 1
                }
                i_left := found.tab
                i_left_col := found.col
                e1 := rs.create_column_expr(p.db, a, src, i_left, i_left_col)
                si_left: ast.src_item(a, src, i_left)
                rs.src_item_column_used(a, si_left, i_left_col)
                si0: ast.src_item(a, src, 0)
                if a.items[si0].jointype.bit_and(ast.JT_LTORJ) != 0 {
                    func_args := -1
                    loop {
                        more: table_and_column_index(p.db, a, src, i_left + 1, i, z, synth, true)
                        if more.tab < 0 -> break
                        i_left = more.tab
                        i_left_col = more.col
                        sli: ast.src_item(a, src, i_left)
                        if !a.items[sli].is_using || ast.id_list_index(a, a.items[sli].u3, z) < 0 {
                            ast.error(a, "ambiguous reference to {ast.text(z)} in USING()")
                            break
                        }
                        func_args = ast.expr_list_append(a, func_args, e1)
                        e1 = rs.create_column_expr(p.db, a, src, i_left, i_left_col)
                        rs.src_item_column_used(a, sli, i_left_col)
                    }
                    if func_args >= 0 {
                        func_args = ast.expr_list_append(a, func_args, e1)
                        e1 = coalesce_function(a, func_args)
                    }
                }
                e2: rs.create_column_expr(p.db, a, src, i + 1, i_right_col)
                rs.src_item_column_used(a, sr, i_right_col)
                eq: ast.pexpr(a, tk.TK_EQ, e1, e2)
                if eq >= 0 {
                    ast.set_flags(a, eq, join_type)
                    a.exprs[eq].w = a.exprs[e2].itable
                }
                w: a.selects[s].where_expr
                a.selects[s].where_expr = ast.expr_and(a, w, eq)
            }
        } else if a.items[sr].u3 >= 0 {
            on: a.items[sr].u3
            cursor: a.items[sr].cursor
            we.set_join_expr(a, on, cursor, join_type)
            w: a.selects[s].where_expr
            a.selects[s].where_expr = ast.expr_and(a, w, on)
            a.items[sr].u3 = -1
            a.items[sr].is_on = true
        }
    }
    0
}

// ---------------------------------------------------------------------------
// The inner loop: one result row to its destination.

// innerLoopLoadRow: the result columns of s into the registers from
// reg_result.
inner_loop_load_row: fn(p: &cg.Parse, a: &ast.AST, s: Int, reg_result: Int, ecel_flags: Int) Never! -[DB]> {
    elist: a.selects[s].elist
    _: ex.expr_code_expr_list(p, a, elist, reg_result, 0, ecel_flags)
}

// makeSorterRecord: the OP_MakeRecord of the sorter entry; its register.
make_sorter_record: fn(p: &cg.Parse, a: &ast.AST, sort: SortCtx, s: Int, reg_base: Int, n_base: Int) -[DB]> Int Never! {
    n_ob_sat: sort.n_ob_sat
    p.f.n_mem += 1
    reg_out: p.f.n_mem
    if sort.deferred -> inner_loop_load_row(p, a, s, sort.deferred_reg, sort.deferred_flags)
    _: cg.op3(p, opc.OP_MAKE_RECORD, reg_base + n_ob_sat, n_base - n_ob_sat, reg_out)
    reg_out
}

// pushOntoSorter: the record of registers reg_data.. (n_data of them) onto
// the sorter. reg_orig_data is the unpacked row when the record holds all
// of it, else 0; n_prefix_reg the registers before reg_data free for the
// sort key.
push_onto_sorter: fn(p: &cg.Parse, a: &ast.AST, sort: &SortCtx, s: Int, reg_data: Int, reg_orig_data: Int, n_data: Int, n_prefix_reg: Int) Never! -[DB]> {
    b_seq: if sort.sort_flags.bit_and(SORTFLAG_USE_SORTER) == 0 -> 1 else -> 0
    ob: sort.order_by
    n_expr: ast.list_len(a, ob)
    n_base: n_expr + b_seq + n_data
    reg_record := 0
    n_ob_sat: sort.n_ob_sat
    i_skip := 0
    reg_base := 0
    if n_prefix_reg != 0 {
        reg_base = reg_data - n_prefix_reg
    } else {
        reg_base = p.f.n_mem + 1
        p.f.n_mem += n_base
    }
    i_limit: if a.selects[s].ioffset != 0 -> a.selects[s].ioffset + 1 else -> a.selects[s].ilimit
    sort.label_done = cg.v_make_label(p)
    ref: if reg_orig_data != 0 -> cg.ECEL_REF else -> 0
    _: ex.expr_code_expr_list(p, a, ob, reg_base, reg_orig_data, cg.ECEL_DUP.bit_or(ref))
    if b_seq != 0 -> _: cg.op2(p, opc.OP_SEQUENCE, sort.i_ecursor, reg_base + n_expr)
    if n_prefix_reg == 0 && n_data > 0 -> ex.expr_code_move(p, reg_data, reg_base + n_expr + b_seq, n_data)
    if n_ob_sat > 0 {
        reg_record = make_sorter_record(p, a, sort, s, reg_base, n_base)
        reg_prev_key: p.f.n_mem + 1
        p.f.n_mem += n_ob_sat
        n_key: n_expr - n_ob_sat + b_seq
        addr_first := 0
        if b_seq != 0 {
            addr_first = cg.op1(p, opc.OP_IF_NOT, reg_base + n_expr)
        } else {
            addr_first = cg.op1(p, opc.OP_SEQUENCE_TEST, sort.i_ecursor)
        }
        _: cg.op3(p, opc.OP_COMPARE, reg_prev_key, reg_base, n_ob_sat)
        o: cg.v_op_at(p, sort.addr_sort_index)
        if p.db.malloc_failed -> return
        cg.v_change_p2(p, sort.addr_sort_index, n_key + n_data)
        if o.p4 == .KeyInfo(ki0) {
            // The OP_Compare takes the sorter's KeyInfo with its key sort
            // flags zeroed; the sorter a new one of the unsatisfied terms.
            ki := ki0.copy()
            loop j in 0..<ki.n_key_field -> ki.sort_flags[j] = 0
            cg.v_append_p4(p, conn.P4.KeyInfo(ki))
            nki: wn.key_info_from_expr_list(p, a, ob, n_ob_sat, ki0.n_all_field - ki0.n_key_field - 1)
            cg.v_change_p4(p, sort.addr_sort_index, conn.P4.KeyInfo(nki))
        }
        addr_jmp: cg.v_current_addr(p)
        _: cg.op3(p, opc.OP_JUMP, addr_jmp + 1, 0, addr_jmp + 1)
        sort.label_bk_out = cg.v_make_label(p)
        p.f.n_mem += 1
        sort.reg_return = p.f.n_mem
        _: cg.op2(p, opc.OP_GOSUB, sort.reg_return, sort.label_bk_out)
        _: cg.op1(p, opc.OP_RESET_SORTER, sort.i_ecursor)
        if i_limit != 0 -> _: cg.op2(p, opc.OP_IF_NOT, i_limit, sort.label_done)
        cg.v_jump_here(p, addr_first)
        ex.expr_code_move(p, reg_base, reg_prev_key, n_ob_sat)
        cg.v_jump_here(p, addr_jmp)
    }
    if i_limit != 0 {
        // Insert only while the sorter holds fewer than LIMIT+OFFSET rows
        // or the row sorts before its largest, which then goes.
        i_csr: sort.i_ecursor
        here: cg.v_current_addr(p)
        _: cg.op2(p, opc.OP_IF_NOT_ZERO, i_limit, here + 4)
        _: cg.op2(p, opc.OP_LAST, i_csr, 0)
        i_skip = cg.op4_int(p, opc.OP_IDX_LE, i_csr, 0, reg_base + n_ob_sat, n_expr - n_ob_sat)
        _: cg.op1(p, opc.OP_DELETE, i_csr)
    }
    if reg_record == 0 -> reg_record = make_sorter_record(p, a, sort, s, reg_base, n_base)
    op: if sort.sort_flags.bit_and(SORTFLAG_USE_SORTER) != 0 -> opc.OP_SORTER_INSERT else -> opc.OP_IDX_INSERT
    _: cg.op4_int(p, op, sort.i_ecursor, reg_record, reg_base + n_ob_sat, n_base - n_ob_sat)
    if i_skip != 0 {
        tgt: if sort.label_ob_lopt != 0 -> sort.label_ob_lopt else -> cg.v_current_addr(p)
        cg.v_change_p2(p, i_skip, tgt)
    }
}

// codeOffset: skip to i_continue while the OFFSET counter is positive.
code_offset: fn(p: &cg.Parse, i_offset: Int, i_continue: Int) Never! {
    if i_offset > 0 -> _: cg.op3(p, opc.OP_IF_POS, i_offset, i_continue, 1)
}

// codeDistinct: jump to addr_repeat unless the row in the registers from
// reg_elem (one per term of elist) is new, by the e_tnct_type strategy:
// the table i_tab (returned), a comparison with the previous row (its
// first register returned) or nothing (0).
code_distinct: fn(p: &cg.Parse, a: &ast.AST, e_tnct_type: Int, i_tab: Int, addr_repeat: Int, elist: Int, reg_elem: Int) -[DB]> Int Never! {
    n_result_col: ast.list_len(a, elist)
    if e_tnct_type == cg.WHERE_DISTINCT_ORDERED {
        reg_prev: p.f.n_mem + 1
        p.f.n_mem += n_result_col
        i_jump: cg.v_current_addr(p) + n_result_col
        loop i in 0..<n_result_col {
            e: ast.list_expr(a, elist, i)
            coll: ex.expr_coll_seq(p, a, e)
            if i < n_result_col - 1 {
                _: cg.op3(p, opc.OP_NE, reg_elem + i, i_jump, reg_prev + i)
            } else {
                _: cg.op3(p, opc.OP_EQ, reg_elem + i, addr_repeat, reg_prev + i)
            }
            cg.v_append_p4(p, ex.coll_p4(coll))
            cg.v_change_p5(p, conn.CMP_NULLEQ)
        }
        _: cg.op3(p, opc.OP_COPY, reg_elem, reg_prev, n_result_col - 1)
        return reg_prev
    }
    if e_tnct_type == cg.WHERE_DISTINCT_UNIQUE -> return 0
    r1: cg.get_temp_reg(p)
    _: cg.op4_int(p, opc.OP_FOUND, i_tab, addr_repeat, reg_elem, n_result_col)
    _: cg.op3(p, opc.OP_MAKE_RECORD, reg_elem, n_result_col, r1)
    _: cg.op4_int(p, opc.OP_IDX_INSERT, i_tab, r1, reg_elem, n_result_col)
    cg.v_change_p5(p, conn.OPFLAG_USESEEKRESULT)
    cg.release_temp_reg(p, r1)
    i_tab
}

// fixDistinctOpenEph: after codeDistinct, the OP_OpenEphemeral at
// i_open_eph_addr goes when the strategy needs no table, becoming the
// OP_Null that clears the previous row (i_val) for the ordered one.
fix_distinct_open_eph: fn(p: &cg.Parse, a: ast.AST, e_tnct_type: Int, i_val: Int, i_open_eph_addr: Int) Never! {
    if cg.n_err(a) != 0 || (e_tnct_type != cg.WHERE_DISTINCT_UNIQUE && e_tnct_type != cg.WHERE_DISTINCT_ORDERED) -> return
    _: cg.v_change_to_noop(p, i_open_eph_addr)
    if i_open_eph_addr + 1 < cg.v_current_addr(p) && cg.v_op_at(p, i_open_eph_addr + 1).opcode == opc.OP_EXPLAIN -> _: cg.v_change_to_noop(p, i_open_eph_addr + 1)
    if e_tnct_type == cg.WHERE_DISTINCT_ORDERED {
        cg.v_change_opcode(p, i_open_eph_addr, opc.OP_NULL)
        cg.v_change_p1(p, i_open_eph_addr, 1)
        cg.v_change_p2(p, i_open_eph_addr, i_val)
    }
}

// selectInnerLoop: the body of the loop over the rows of SELECT s: its
// result row, from the table src_tab when that is not negative, through
// `sort` (when it has an ORDER BY) and `distinct` to `dest`.
select_inner_loop: fn(p: &cg.Parse, a: &ast.AST, s: Int, src_tab: Int, sort: &SortCtx, distinct: DistinctCtx, dest: &cg.SelectDest, i_continue: Int, i_break: Int) Never! -[DB]> {
    has_distinct: distinct.e_tnct_type
    has_sort: sort.order_by >= 0
    e_dest: dest.e_dest
    i_parm: dest.i_sd_parm
    n_prefix_reg := 0
    if !has_sort && has_distinct == 0 -> code_offset(p, a.selects[s].ioffset, i_continue)
    elist: a.selects[s].elist
    n_result_col := ast.list_len(a, elist)
    if dest.i_sdst == 0 {
        if has_sort {
            n_prefix_reg = ast.list_len(a, sort.order_by)
            if sort.sort_flags.bit_and(SORTFLAG_USE_SORTER) == 0 -> n_prefix_reg += 1
            p.f.n_mem += n_prefix_reg
        }
        dest.i_sdst = p.f.n_mem + 1
        p.f.n_mem += n_result_col
    } else if dest.i_sdst + n_result_col > p.f.n_mem {
        // An INSERT whose SELECT has too many columns: the error comes
        // later, and the registers keep other errors away meanwhile.
        p.f.n_mem += n_result_col
    }
    dest.n_sdst = n_result_col
    reg_result: dest.i_sdst
    reg_orig := reg_result
    if src_tab >= 0 {
        loop i in 0..<n_result_col -> _: cg.op3(p, opc.OP_COLUMN, src_tab, i, reg_result + i)
    } else if e_dest != cg.SRT_EXISTS {
        ecel_flags := if e_dest == cg.SRT_MEM || e_dest == cg.SRT_OUTPUT || e_dest == cg.SRT_COROUTINE -> cg.ECEL_DUP else -> 0
        if has_sort && has_distinct == 0 && e_dest != cg.SRT_EPHEM_TAB && e_dest != cg.SRT_TABLE {
            // A result column that is also an ORDER BY term is read back
            // from the sort key rather than stored twice.
            ecel_flags = ecel_flags.bit_or(cg.ECEL_OMITREF.bit_or(cg.ECEL_REF))
            ob: sort.order_by
            loop i in sort.n_ob_sat..<ast.list_len(a, ob) {
                j: a.lists[ob].items[i].order_by_col
                if j > 0 -> a.lists[elist].items[j - 1].order_by_col = i + 1 - sort.n_ob_sat
            }
            loop i in 0..<ast.list_len(a, elist) {
                if a.lists[elist].items[i].order_by_col > 0 {
                    n_result_col -= 1
                    reg_orig = 0
                }
            }
        }
        if a.selects[s].ilimit != 0 && ecel_flags.bit_and(cg.ECEL_OMITREF) != 0 && n_prefix_reg > 0 {
            sort.deferred = true
            sort.deferred_reg = reg_result
            sort.deferred_flags = ecel_flags
            reg_orig = 0
        } else {
            inner_loop_load_row(p, a, s, reg_result, ecel_flags)
        }
    }
    if has_distinct != 0 {
        i_tab: code_distinct(p, a, distinct.e_tnct_type, distinct.tab_tnct, i_continue, elist, reg_result)
        fix_distinct_open_eph(p, a, distinct.e_tnct_type, i_tab, distinct.addr_tnct)
        if !has_sort -> code_offset(p, a.selects[s].ioffset, i_continue)
    }
    if e_dest == cg.SRT_UNION {
        r1: cg.get_temp_reg(p)
        _: cg.op3(p, opc.OP_MAKE_RECORD, reg_result, n_result_col, r1)
        _: cg.op4_int(p, opc.OP_IDX_INSERT, i_parm, r1, reg_result, n_result_col)
        cg.release_temp_reg(p, r1)
    } else if e_dest == cg.SRT_EXCEPT {
        _: cg.op3(p, opc.OP_IDX_DELETE, i_parm, reg_result, n_result_col)
    } else if e_dest == cg.SRT_FIFO || e_dest == cg.SRT_DIST_FIFO || e_dest == cg.SRT_TABLE || e_dest == cg.SRT_EPHEM_TAB {
        r1: cg.get_temp_range(p, n_prefix_reg + 1)
        _: cg.op3(p, opc.OP_MAKE_RECORD, reg_result, n_result_col, r1 + n_prefix_reg)
        if e_dest == cg.SRT_DIST_FIFO {
            // Cursor i_parm+1 indexes every row written so far.
            addr: cg.v_current_addr(p) + 4
            _: cg.op4_int(p, opc.OP_FOUND, i_parm + 1, addr, r1, 0)
            _: cg.op4_int(p, opc.OP_IDX_INSERT, i_parm + 1, r1, reg_result, n_result_col)
        }
        if has_sort {
            push_onto_sorter(p, a, sort, s, r1 + n_prefix_reg, reg_orig, 1, n_prefix_reg)
        } else {
            r2: cg.get_temp_reg(p)
            _: cg.op2(p, opc.OP_NEW_ROWID, i_parm, r2)
            _: cg.op3(p, opc.OP_INSERT, i_parm, r1, r2)
            cg.v_change_p5(p, conn.OPFLAG_APPEND)
            cg.release_temp_reg(p, r2)
        }
        cg.release_temp_range(p, r1, n_prefix_reg + 1)
    } else if e_dest == cg.SRT_UPFROM {
        if has_sort {
            push_onto_sorter(p, a, sort, s, reg_result, reg_orig, n_result_col, n_prefix_reg)
        } else {
            i2: dest.i_sd_parm2
            r1: cg.get_temp_reg(p)
            // An aggregate UPDATE FROM join that matched no rows still
            // returns its one row, which is not recorded.
            _: cg.op2(p, opc.OP_IS_NULL, reg_result, i_break)
            k: if i2 < 0 -> 1 else -> 0
            _: cg.op3(p, opc.OP_MAKE_RECORD, reg_result + k, n_result_col - k, r1)
            if i2 < 0 {
                _: cg.op3(p, opc.OP_INSERT, i_parm, r1, reg_result)
            } else {
                _: cg.op4_int(p, opc.OP_IDX_INSERT, i_parm, r1, reg_result, i2)
            }
        }
    } else if e_dest == cg.SRT_SET {
        if has_sort {
            // The order matters to a LIMIT.
            push_onto_sorter(p, a, sort, s, reg_result, reg_orig, n_result_col, n_prefix_reg)
        } else {
            r1: cg.get_temp_reg(p)
            aff: dest.aff_sdst ?? [U8]{}
            _: cg.op4_text(p, opc.OP_MAKE_RECORD, reg_result, n_result_col, r1, aff)
            _: cg.op4_int(p, opc.OP_IDX_INSERT, i_parm, r1, reg_result, n_result_col)
            cg.release_temp_reg(p, r1)
        }
    } else if e_dest == cg.SRT_EXISTS {
        _: cg.op2(p, opc.OP_INTEGER, 1, i_parm)
    } else if e_dest == cg.SRT_MEM {
        if has_sort -> push_onto_sorter(p, a, sort, s, reg_result, reg_orig, n_result_col, n_prefix_reg)
    } else if e_dest == cg.SRT_COROUTINE || e_dest == cg.SRT_OUTPUT {
        if has_sort {
            push_onto_sorter(p, a, sort, s, reg_result, reg_orig, n_result_col, n_prefix_reg)
        } else if e_dest == cg.SRT_COROUTINE {
            _: cg.op1(p, opc.OP_YIELD, dest.i_sd_parm)
        } else {
            _: cg.op2(p, opc.OP_RESULT_ROW, reg_result, n_result_col)
        }
    } else if e_dest == cg.SRT_DIST_QUEUE || e_dest == cg.SRT_QUEUE {
        // A priority queue in dest.order_by order: the key terms, an
        // OP_Sequence for uniqueness, then the row as a blob.
        so: dest.order_by
        n_key: ast.list_len(a, so)
        r1: cg.get_temp_reg(p)
        r2: cg.get_temp_range(p, n_key + 2)
        r3: r2 + n_key + 1
        addr_test := 0
        if e_dest == cg.SRT_DIST_QUEUE -> addr_test = cg.op4_int(p, opc.OP_FOUND, i_parm + 1, 0, reg_result, n_result_col)
        _: cg.op3(p, opc.OP_MAKE_RECORD, reg_result, n_result_col, r3)
        if e_dest == cg.SRT_DIST_QUEUE {
            _: cg.op2(p, opc.OP_IDX_INSERT, i_parm + 1, r3)
            cg.v_change_p5(p, conn.OPFLAG_USESEEKRESULT)
        }
        loop i in 0..<n_key -> _: cg.op2(p, opc.OP_SCOPY, reg_result + a.lists[so].items[i].order_by_col - 1, r2 + i)
        _: cg.op2(p, opc.OP_SEQUENCE, i_parm, r2 + n_key)
        _: cg.op3(p, opc.OP_MAKE_RECORD, r2, n_key + 2, r1)
        _: cg.op4_int(p, opc.OP_IDX_INSERT, i_parm, r1, r2, n_key + 2)
        if addr_test != 0 -> cg.v_jump_here(p, addr_test)
        cg.release_temp_reg(p, r1)
        cg.release_temp_range(p, r2, n_key + 2)
    }
    // SRT_Discard (a SELECT in a trigger body) keeps nothing.
    if !has_sort && a.selects[s].ilimit != 0 -> _: cg.op2(p, opc.OP_DECR_JUMP_ZERO, a.selects[s].ilimit, i_break)
}

// generateSortTail: the loop that reads the sorter `sort` filled and sends
// its rows (n_column columns) to dest.
generate_sort_tail: fn(p: &cg.Parse, a: &ast.AST, s: Int, sort: &SortCtx, n_column0: Int, dest: &cg.SelectDest) Never! {
    addr_break: sort.label_done
    addr_continue: cg.v_make_label(p)
    addr_once := 0
    ob: sort.order_by
    e_dest: dest.e_dest
    i_parm: dest.i_sd_parm
    elist: a.selects[s].elist
    rp: if sort.n_ob_sat > 0 -> "RIGHT PART OF " else -> ""
    _: cg.explain(p, a, false, "USE TEMP B-TREE FOR {rp}ORDER BY")
    if sort.label_bk_out != 0 {
        _: cg.op2(p, opc.OP_GOSUB, sort.reg_return, sort.label_bk_out)
        _: cg.goto(p, addr_break)
        cg.v_resolve_label(p, sort.label_bk_out)
    }
    i_tab: sort.i_ecursor
    n_column := n_column0
    reg_row := 0
    reg_rowid := 0
    if e_dest == cg.SRT_OUTPUT || e_dest == cg.SRT_COROUTINE || e_dest == cg.SRT_MEM {
        if e_dest == cg.SRT_MEM && a.selects[s].ioffset != 0 -> _: cg.op2(p, opc.OP_NULL, 0, dest.i_sdst)
        reg_row = dest.i_sdst
    } else {
        reg_rowid = cg.get_temp_reg(p)
        if e_dest == cg.SRT_EPHEM_TAB || e_dest == cg.SRT_TABLE {
            reg_row = cg.get_temp_reg(p)
            n_column = 0
        } else {
            reg_row = cg.get_temp_range(p, n_column)
        }
    }
    n_key: ast.list_len(a, ob) - sort.n_ob_sat
    use_sorter: sort.sort_flags.bit_and(SORTFLAG_USE_SORTER) != 0
    addr := 0
    i_sort_tab := 0
    b_seq := 0
    if use_sorter {
        p.f.n_mem += 1
        reg_sort_out: p.f.n_mem
        i_sort_tab = p.f.n_tab
        p.f.n_tab += 1
        if sort.label_bk_out != 0 -> addr_once = cg.op0(p, opc.OP_ONCE)
        _: cg.op3(p, opc.OP_OPEN_PSEUDO, i_sort_tab, reg_sort_out, n_key + 1 + n_column)
        if addr_once != 0 -> cg.v_jump_here(p, addr_once)
        addr = 1 + cg.op2(p, opc.OP_SORTER_SORT, i_tab, addr_break)
        _: cg.op3(p, opc.OP_SORTER_DATA, i_tab, reg_sort_out, i_sort_tab)
    } else {
        addr = 1 + cg.op2(p, opc.OP_SORT, i_tab, addr_break)
        code_offset(p, a.selects[s].ioffset, addr_continue)
        i_sort_tab = i_tab
        b_seq = 1
        if a.selects[s].ioffset > 0 -> _: cg.op2(p, opc.OP_ADD_IMM, a.selects[s].ilimit, 0 - 1)
    }
    i_col := n_key + b_seq - 1
    loop i in 0..<n_column {
        if a.lists[elist].items[i].order_by_col == 0 -> i_col += 1
    }
    i := n_column - 1
    loop i >= 0 {
        obc: a.lists[elist].items[i].order_by_col
        i_read := 0
        if obc != 0 {
            i_read = obc - 1
        } else {
            i_read = i_col
            i_col -= 1
        }
        _: cg.op3(p, opc.OP_COLUMN, i_sort_tab, i_read, reg_row + i)
        i -= 1
    }
    if e_dest == cg.SRT_TABLE || e_dest == cg.SRT_EPHEM_TAB {
        _: cg.op3(p, opc.OP_COLUMN, i_sort_tab, n_key + b_seq, reg_row)
        _: cg.op2(p, opc.OP_NEW_ROWID, i_parm, reg_rowid)
        _: cg.op3(p, opc.OP_INSERT, i_parm, reg_row, reg_rowid)
        cg.v_change_p5(p, conn.OPFLAG_APPEND)
    } else if e_dest == cg.SRT_SET {
        aff: dest.aff_sdst ?? [U8]{}
        _: cg.op4_text(p, opc.OP_MAKE_RECORD, reg_row, n_column, reg_rowid, aff)
        _: cg.op4_int(p, opc.OP_IDX_INSERT, i_parm, reg_rowid, reg_row, n_column)
    } else if e_dest == cg.SRT_MEM {
        // The LIMIT ends the loop.
    } else if e_dest == cg.SRT_UPFROM {
        i2: dest.i_sd_parm2
        r1: cg.get_temp_reg(p)
        k: if i2 < 0 -> 1 else -> 0
        _: cg.op3(p, opc.OP_MAKE_RECORD, reg_row + k, n_column - k, r1)
        if i2 < 0 {
            _: cg.op3(p, opc.OP_INSERT, i_parm, r1, reg_row)
        } else {
            _: cg.op4_int(p, opc.OP_IDX_INSERT, i_parm, r1, reg_row, i2)
        }
    } else if e_dest == cg.SRT_OUTPUT {
        _: cg.op2(p, opc.OP_RESULT_ROW, dest.i_sdst, n_column)
    } else {
        _: cg.op1(p, opc.OP_YIELD, dest.i_sd_parm)
    }
    if reg_rowid != 0 {
        if e_dest == cg.SRT_SET {
            cg.release_temp_range(p, reg_row, n_column)
        } else {
            cg.release_temp_reg(p, reg_row)
        }
        cg.release_temp_reg(p, reg_rowid)
    }
    cg.v_resolve_label(p, addr_continue)
    if use_sorter {
        _: cg.op2(p, opc.OP_SORTER_NEXT, i_tab, addr)
    } else {
        _: cg.op2(p, opc.OP_NEXT, i_tab, addr)
    }
    if sort.reg_return != 0 -> _: cg.op1(p, opc.OP_RETURN, sort.reg_return)
    cg.v_resolve_label(p, addr_break)
}

// ---------------------------------------------------------------------------
// Result column names and types.

// columnTypeImpl's results: the declared type and, with
// SQLITE_ENABLE_COLUMN_METADATA, the origin database, table and column.
ColumnOrigin: struct {
    typ: [U8]?
    db: [U8]?
    tab: [U8]?
    col: [U8]?
}

// columnTypeImpl: the declaration type of expression e (a column, or a
// subquery of one) with its origin; srcs are the FROM lists in scope,
// innermost first.
column_type_impl: fn(p: cg.Parse, a: ast.AST, srcs: [Int], e: Int) -> ColumnOrigin Never! {
    out := ColumnOrigin{typ: None, db: None, tab: None, col: None}
    op: a.exprs[e].op
    if op == tk.TK_COLUMN {
        t := -1
        sub := -1
        i_col: a.exprs[e].icolumn
        k := 0
        loop k < srcs.len() && t < 0 {
            src: srcs[k]
            n: ast.src_len(a, src)
            j := 0
            loop j < n && a.items[ast.src_item(a, src, j)].cursor != a.exprs[e].itable -> j += 1
            if j < n {
                si: ast.src_item(a, src, j)
                t = a.items[si].tab
                sub = a.items[si].select
            } else {
                k += 1
            }
        }
        // "SELECT (SELECT t1.col) FROM t1" asks of t1.col in the inner
        // query, whose type is never used.
        if t < 0 -> return out
        if sub >= 0 {
            sel_el: a.selects[sub].elist
            if i_col < ast.list_len(a, sel_el) && i_col >= 0 {
                inner := [Int]{a.selects[sub].src}
                loop q in k..<srcs.len() -> inner.push(srcs[q])
                return column_type_impl(p, a, inner, ast.list_expr(a, sel_el, i_col))
            }
            return out
        }
        ic := i_col
        if ic < 0 -> ic = p.db.tables[t].ipkey
        if ic < 0 {
            out.typ = Val("INTEGER".bytes())
            out.col = Val("rowid".bytes())
        } else {
            col: p.db.tables[t].cols[ic]
            out.col = Val(col.name.copy())
            if col.col_flags.bit_and(conn.COLFLAG_HASTYPE) != 0 -> out.typ = Val(col.typ.copy())
        }
        out.tab = Val(p.db.tables[t].name.copy())
        schema: p.db.tables[t].schema
        if schema >= 0 {
            i_db: conn.schema_to_index(p.db, schema)
            if i_db >= 0 -> out.db = Val(p.db.dbs[i_db].name.copy())
        }
        return out
    }
    if op == tk.TK_SELECT {
        sub: a.exprs[e].x
        inner := [Int]{a.selects[sub].src}
        loop q in srcs -> inner.push(q)
        return column_type_impl(p, a, inner, ast.list_expr(a, a.selects[sub].elist, 0))
    }
    out
}

// generateColumnTypes: the declared types and origins of the result
// columns elist over FROM list src.
generate_column_types: fn(p: &cg.Parse, a: &ast.AST, src: Int, elist: Int) Never! {
    srcs: [Int]{src}
    loop i in 0..<ast.list_len(a, elist) {
        e: ast.list_expr(a, elist, i)
        o: column_type_impl(p, a, srcs, e)
        if o.db == .Val(z) -> cg.v_set_col_name(p, i, conn.COLNAME_DATABASE, z)
        if o.tab == .Val(z) -> cg.v_set_col_name(p, i, conn.COLNAME_TABLE, z)
        if o.col == .Val(z) -> cg.v_set_col_name(p, i, conn.COLNAME_COLUMN, z)
        if o.typ == .Val(z) -> cg.v_set_col_name(p, i, conn.COLNAME_DECLTYPE, z)
    }
}

// sqlite3GenerateColumnNames: the names of the result columns of SELECT
// s0 (its compound's left-most SELECT), once per statement.
generate_column_names: fn(p: &cg.Parse, a: &ast.AST, s0: Int) Never! {
    if p.f.col_names_set -> return
    s := s0
    loop a.selects[s].prior >= 0 -> s = a.selects[s].prior
    src: a.selects[s].src
    elist: a.selects[s].elist
    p.f.col_names_set = true
    full_name: p.db.flags.bit_and(conn.SQLITE_FULL_COL_NAMES) != 0
    src_name: p.db.flags.bit_and(conn.SQLITE_SHORT_COL_NAMES) != 0 || full_name
    n: ast.list_len(a, elist)
    cg.v_set_num_cols(p, n)
    loop i in 0..<n {
        item: a.lists[elist].items[i]
        e: item.expr
        if item.ename != None && item.eename == ast.ENAME_NAME {
            // An AS clause always wins.
            cg.v_set_col_name(p, i, conn.COLNAME_NAME, item.ename ?? [U8]{})
        } else if src_name && a.exprs[e].op == tk.TK_COLUMN {
            t: a.exprs[e].y
            ic := a.exprs[e].icolumn
            if ic < 0 -> ic = p.db.tables[t].ipkey
            z_col: if ic < 0 -> "rowid".bytes() else -> p.db.tables[t].cols[ic].name.copy()
            if full_name {
                z := p.db.tables[t].name.copy()
                z.push(U8{46})
                loop b in z_col -> z.push(b)
                cg.v_set_col_name(p, i, conn.COLNAME_NAME, z)
            } else {
                cg.v_set_col_name(p, i, conn.COLNAME_NAME, z_col)
            }
        } else {
            z: item.ename ?? "column{i + 1}".bytes()
            cg.v_set_col_name(p, i, conn.COLNAME_NAME, z)
        }
    }
    generate_column_types(p, a, src, elist)
}

// The first n bytes of z, then ":cnt".
name_with_counter: fn(z: [U8], n: Int, cnt: Int) -> [U8] Never! {
    out := [U8]{}
    loop k in 0..<n -> out.push(z[k])
    loop b in ":{cnt}".bytes() -> out.push(b)
    out
}

// sqlite3ColumnsFromExprList: the columns, uniquely named, of a table to
// hold the rows of result list elist (their types and collations unset);
// none on error.
columns_from_expr_list: fn(p: &cg.Parse, a: &ast.AST, elist: Int) -[DB]> [conn.Column] Never! {
    n_col := ast.list_len(a, elist)
    if n_col > 32767 -> n_col = 32767
    cols := [conn.Column]{}
    ht := conn.hash_new()
    i := 0
    loop i < n_col && cg.n_err(a) == 0 {
        x: a.lists[elist].items[i]
        z_name := x.ename
        if x.ename == None || x.eename != ast.ENAME_NAME {
            ce := ast.skip_collate_and_likely(a, x.expr)
            loop ce >= 0 && a.exprs[ce].op == tk.TK_DOT -> ce = a.exprs[ce].right
            if a.exprs[ce].op == tk.TK_COLUMN && a.exprs[ce].y >= 0 {
                t: a.exprs[ce].y
                ic := a.exprs[ce].icolumn
                if ic < 0 -> ic = p.db.tables[t].ipkey
                z_name = if ic >= 0 -> Val(p.db.tables[t].cols[ic].name.copy()) else -> Val("rowid".bytes())
            } else if a.exprs[ce].op == tk.TK_ID {
                z_name = a.exprs[ce].token
            }
            // Otherwise the span of the expression names it.
        }
        name := "column{i + 1}".bytes()
        if z_name == .Val(zn) {
            if ast.is_true_or_false(zn) == 0 -> name = zn.copy()
        }
        col_flags := 0
        cnt := 0
        loop {
            hit: conn.hash_find(ht, name)
            if hit < 0 -> break
            if a.lists[elist].items[hit].using_term -> col_flags = col_flags.bit_or(conn.COLFLAG_NOEXPAND)
            n_name := name.len()
            if n_name > 0 {
                j := n_name - 1
                loop j > 0 && util.is_digit(Int{name[j]}) -> j -= 1
                if (Int{name[j]}) == 58 -> n_name = j
            }
            cnt += 1
            name = name_with_counter(name, n_name, cnt)
            if cnt > 3 {
                r: os.os_random_bytes(4)
                cnt = Int{r[0]} + (Int{r[1]} << 8) + (Int{r[2]} << 16) + (Int{r[3]} << 24)
            }
        }
        if x.no_expand -> col_flags = col_flags.bit_or(conn.COLFLAG_NOEXPAND)
        h: util.str_ihash(name)
        _: conn.hash_insert(ht, name, i)
        cols.push(conn.Column{name: name, typ: [U8]{}, coll: [U8]{}, not_null: 0, ctype: 0, affinity: 0, sz_est: 0, h_name: h, i_dflt: 0, col_flags: col_flags})
        i += 1
    }
    if cg.n_err(a) > 0 -> return [conn.Column]{}
    cols
}

// The first sqlite3StdType whose sqlite3StdTypeAffinity is aff, or None.
std_type_for_affinity: fn(aff: Int) -> [U8]? Never! {
    if aff == base.AFF_BLOB -> return Val("BLOB".bytes())
    if aff == base.AFF_INTEGER -> return Val("INT".bytes())
    if aff == base.AFF_REAL -> return Val("REAL".bytes())
    if aff == base.AFF_TEXT -> return Val("TEXT".bytes())
    None
}

// sqlite3SubqueryColumnTypes: the types, collations and affinities (aff
// by default) of the columns of table t, a subquery, view or CTE, from
// the SELECT s0 that computes it.
subquery_column_types: fn(p: &cg.Parse, a: &ast.AST, t: Int, s0: Int, aff: Int) Never! {
    if p.db.malloc_failed || ast.in_rename(a) -> return
    s := s0
    loop a.selects[s].prior >= 0 -> s = a.selects[s].prior
    elist: a.selects[s].elist
    srcs: [Int]{a.selects[s].src}
    loop i in 0..<p.db.tables[t].cols.len() {
        p.db.tables[t].tab_flags = p.db.tables[t].tab_flags.bit_or(p.db.tables[t].cols[i].col_flags.bit_and(conn.COLFLAG_NOINSERT))
        e: ast.list_expr(a, elist, i)
        caff := ex.expr_affinity(p.db, a, e)
        if caff <= base.AFF_NONE -> caff = aff
        if caff >= base.AFF_TEXT && a.selects[s].next_sel >= 0 {
            m := 0
            s2 := a.selects[s].next_sel
            loop s2 >= 0 {
                e2: ast.list_expr(a, a.selects[s2].elist, i)
                m = m.bit_or(ex.expr_data_type(p.db, a, e2))
                s2 = a.selects[s2].next_sel
            }
            if caff == base.AFF_TEXT && m.bit_and(1) != 0 {
                caff = base.AFF_BLOB
            } else if caff >= base.AFF_NUMERIC && m.bit_and(2) != 0 {
                caff = base.AFF_BLOB
            }
            if caff >= base.AFF_NUMERIC && a.exprs[e].op == tk.TK_CAST -> caff = base.AFF_FLEXNUM
        }
        p.db.tables[t].cols[i].affinity = caff
        z_type := column_type_impl(p, a, srcs, e).typ
        if z_type == None || caff != cat.affinity_type(z_type ?? [U8]{}).aff {
            if caff == base.AFF_NUMERIC || caff == base.AFF_FLEXNUM {
                z_type = Val("NUM".bytes())
            } else {
                z_type = std_type_for_affinity(caff)
            }
        }
        if z_type == .Val(zt) {
            f: util.clear_bits(p.db.tables[t].cols[i].col_flags, conn.COLFLAG_HASTYPE.bit_or(conn.COLFLAG_HASCOLL))
            p.db.tables[t].cols[i].typ = zt
            p.db.tables[t].cols[i].col_flags = f.bit_or(conn.COLFLAG_HASTYPE)
        }
        coll: ex.expr_coll_seq(p, a, e)
        if coll >= 0 {
            nm: conn.coll_name(p.db, coll)
            cat.column_set_coll(p.db, t, i, nm)
        }
    }
    p.db.tables[t].sz_tab_row = 1
}

// sqlite3ResultSetOfSelect: a Table, in p.db.tables, of the result columns
// of SELECT s0 with default affinity aff; -1 on error.
result_set_of_select: fn(p: &cg.Parse, a: &ast.AST, s0: Int, aff: Int) -[DB]> Int Never! {
    saved: p.db.flags
    p.db.flags = util.clear_bits(p.db.flags, conn.SQLITE_FULL_COL_NAMES).bit_or(conn.SQLITE_SHORT_COL_NAMES)
    select_prep(p, a, s0, -1)
    p.db.flags = saved
    if cg.n_err(a) > 0 -> return -1
    s := s0
    loop a.selects[s].prior >= 0 -> s = a.selects[s].prior
    t: conn.table_alloc(p.db)
    p.db.tables[t].n_tab_ref = 1
    p.db.tables[t].n_row_log_est = 200
    elist: a.selects[s].elist
    cols: columns_from_expr_list(p, a, elist)
    p.db.tables[t].cols = cols
    subquery_column_types(p, a, t, s, aff)
    p.db.tables[t].ipkey = -1
    if p.db.malloc_failed {
        conn.delete_table(p.db, t)
        return -1
    }
    t
}

// ---------------------------------------------------------------------------
// LIMIT and compound SELECTs.

// computeLimitRegisters: the LIMIT counter (iLimit), and the OFFSET
// counter (iOffset) with LIMIT+OFFSET after it, of SELECT s, once; a LIMIT
// of 0 jumps to i_break.
compute_limit_registers: fn(p: &cg.Parse, a: &ast.AST, s: Int, i_break: Int) Never! -[DB]> {
    if a.selects[s].ilimit != 0 -> return
    lim: a.selects[s].limit
    if lim < 0 -> return
    p.f.n_mem += 1
    i_limit: p.f.n_mem
    a.selects[s].ilimit = i_limit
    cg.get_vdbe(p)
    left: a.exprs[lim].left
    if ast.expr_is_integer(a, left) == .Val(n) {
        _: cg.op2(p, opc.OP_INTEGER, n, i_limit)
        if n == 0 {
            _: cg.goto(p, i_break)
        } else if n >= 0 && a.selects[s].nselect_row > util.log_est(n) {
            a.selects[s].nselect_row = util.log_est(n)
            a.selects[s].sel_flags = a.selects[s].sel_flags.bit_or(ast.SF_FIXED_LIMIT)
        }
    } else {
        ex.expr_code(p, a, left, i_limit)
        _: cg.op1(p, opc.OP_MUST_BE_INT, i_limit)
        _: cg.op2(p, opc.OP_IF_NOT, i_limit, i_break)
    }
    right: a.exprs[lim].right
    if right >= 0 {
        p.f.n_mem += 1
        i_offset: p.f.n_mem
        a.selects[s].ioffset = i_offset
        p.f.n_mem += 1
        ex.expr_code(p, a, right, i_offset)
        _: cg.op1(p, opc.OP_MUST_BE_INT, i_offset)
        _: cg.op3(p, opc.OP_OFFSET_LIMIT, i_limit, i_offset + 1, i_offset)
    }
}

// multiSelectCollSeq: the collation of result column i_col of compound s,
// from its left-most term that has one; -1 for none.
multi_select_coll_seq: fn(p: &cg.Parse, a: &ast.AST, s: Int, i_col: Int) -> Int Never! {
    ret := -1
    prior: a.selects[s].prior
    if prior >= 0 -> ret = multi_select_coll_seq(p, a, prior, i_col)
    elist: a.selects[s].elist
    if ret < 0 && i_col < ast.list_len(a, elist) {
        e: ast.list_expr(a, elist, i_col)
        ret = ex.expr_coll_seq(p, a, e)
    }
    ret
}

// multiSelectOrderByKeyInfo: the KeyInfo of compound s's ORDER BY and
// n_extra more columns; a term without COLLATE takes its column's
// collation as an explicit one.
multi_select_order_by_key_info: fn(p: &cg.Parse, a: &ast.AST, s: Int, n_extra: Int) -> record.KeyInfo Never! {
    ob: a.selects[s].order_by
    n_ob: ast.list_len(a, ob)
    ki := cat.key_info_alloc(p.db, n_ob + n_extra, 1)
    loop i in 0..<n_ob {
        term: a.lists[ob].items[i].expr
        coll := -1
        if ast.has(a, term, ast.EP_COLLATE) {
            coll = ex.expr_coll_seq(p, a, term)
        } else {
            coll = multi_select_coll_seq(p, a, s, a.lists[ob].items[i].order_by_col - 1)
            if coll < 0 -> coll = record.COLL_BINARY
            nm: conn.coll_name(p.db, coll)
            a.lists[ob].items[i].expr = ast.expr_add_collate_string(a, term, nm)
        }
        ki.colls[i] = if coll < 0 -> record.COLL_NONE else -> coll
        ki.sort_flags[i] = a.lists[ob].items[i].sort_flags
    }
    ki
}

// generateWithRecursiveQuery: a WITH RECURSIVE query, s being the
// recursive terms and its priors the setup query, through a Queue table
// of rows still to output and, for UNION, a Distinct table of every row.
generate_with_recursive_query: fn(p: &cg.Parse, a: &ast.AST, s: Int, dest: &cg.SelectDest) Never! -[DB]> {
    src: a.selects[s].src
    n_col: ast.list_len(a, a.selects[s].elist)
    if a.selects[s].win >= 0 {
        ast.error(a, "cannot use window functions in recursive queries")
        return
    }
    if cg.auth_check(p, a, conn.AUTH_RECURSIVE, None, None, None) != 0 -> return
    addr_break: cg.v_make_label(p)
    a.selects[s].nselect_row = 320
    compute_limit_registers(p, a, s, addr_break)
    limit: a.selects[s].limit
    reg_limit: a.selects[s].ilimit
    reg_offset: a.selects[s].ioffset
    a.selects[s].limit = -1
    a.selects[s].ilimit = 0
    a.selects[s].ioffset = 0
    ob: a.selects[s].order_by
    i_current := 0
    loop i in 0..<ast.src_len(a, src) {
        si: ast.src_item(a, src, i)
        if a.items[si].is_recursive {
            i_current = a.items[si].cursor
            break
        }
    }
    // The Distinct cursor must be one past the Queue's for SRT_DistFifo
    // and SRT_DistQueue.
    i_queue: p.f.n_tab
    p.f.n_tab += 1
    i_distinct := 0
    e_dest := 0
    if a.selects[s].op == tk.TK_UNION {
        e_dest = if ob >= 0 -> cg.SRT_DIST_QUEUE else -> cg.SRT_DIST_FIFO
        i_distinct = p.f.n_tab
        p.f.n_tab += 1
    } else {
        e_dest = if ob >= 0 -> cg.SRT_QUEUE else -> cg.SRT_FIFO
    }
    dest_queue := ex.select_dest_init(e_dest, i_queue)
    p.f.n_mem += 1
    reg_current: p.f.n_mem
    _: cg.op3(p, opc.OP_OPEN_PSEUDO, i_current, reg_current, n_col)
    if ob >= 0 {
        ki: multi_select_order_by_key_info(p, a, s, 1)
        _: cg.op4(p, opc.OP_OPEN_EPHEMERAL, i_queue, ast.list_len(a, ob) + 2, 0, conn.P4.KeyInfo(ki))
        dest_queue.order_by = ob
    } else {
        _: cg.op2(p, opc.OP_OPEN_EPHEMERAL, i_queue, n_col)
    }
    if i_distinct != 0 {
        a.selects[s].addr_open_ephm0 = cg.op2(p, opc.OP_OPEN_EPHEMERAL, i_distinct, 0)
        a.selects[s].sel_flags = a.selects[s].sel_flags.bit_or(ast.SF_USES_EPHEMERAL)
    }
    a.selects[s].order_by = -1
    // The recursive terms, made UNION ALL (the Distinct table does the
    // UNION's work); first_rec is the left-most.
    first_rec := s
    ok := true
    loop {
        if a.selects[first_rec].sel_flags.bit_and(ast.SF_AGGREGATE) != 0 {
            ast.error(a, "recursive aggregate queries not supported")
            ok = false
            break
        }
        a.selects[first_rec].op = tk.TK_ALL
        prior: a.selects[first_rec].prior
        if a.selects[prior].sel_flags.bit_and(ast.SF_RECURSIVE) == 0 -> break
        first_rec = prior
    }
    if ok {
        setup: a.selects[first_rec].prior
        a.selects[setup].next_sel = -1
        _: cg.explain(p, a, true, "SETUP")
        rc: select(p, a, setup, dest_queue)
        a.selects[setup].next_sel = s
        if rc == 0 {
            addr_top: cg.op2(p, opc.OP_REWIND, i_queue, addr_break)
            _: cg.op1(p, opc.OP_NULL_ROW, i_current)
            if ob >= 0 {
                _: cg.op3(p, opc.OP_COLUMN, i_queue, ast.list_len(a, ob) + 1, reg_current)
            } else {
                _: cg.op2(p, opc.OP_ROW_DATA, i_queue, reg_current)
            }
            _: cg.op1(p, opc.OP_DELETE, i_queue)
            addr_cont: cg.v_make_label(p)
            code_offset(p, reg_offset, addr_cont)
            ns := no_sort()
            select_inner_loop(p, a, s, i_current, ns, no_distinct(), dest, addr_cont, addr_break)
            if reg_limit != 0 -> _: cg.op2(p, opc.OP_DECR_JUMP_ZERO, reg_limit, addr_break)
            cg.v_resolve_label(p, addr_cont)
            a.selects[first_rec].prior = -1
            _: cg.explain(p, a, true, "RECURSIVE STEP")
            _: select(p, a, s, dest_queue)
            a.selects[first_rec].prior = setup
            _: cg.goto(p, addr_top)
            cg.v_resolve_label(p, addr_break)
        }
    }
    ast.expr_list_delete(a, a.selects[s].order_by)
    a.selects[s].order_by = ob
    a.selects[s].limit = limit
}

// multiSelectValues: a compound of VALUES rows (all UNION ALL, no ORDER
// BY, no LIMIT but 1) coded row by row without recursion; -1 when a
// window function makes it the general case's.
multi_select_values: fn(p: &cg.Parse, a: &ast.AST, s0: Int, dest: &cg.SelectDest) -[DB]> Int Never! {
    n_row := 1
    s := s0
    b_show_all: a.selects[s].limit < 0
    loop {
        if a.selects[s].win >= 0 -> return 0 - 1
        if a.selects[s].prior < 0 -> break
        s = a.selects[s].prior
        if b_show_all -> n_row += 1
    }
    rows: if n_row == 1 -> "" else -> "S"
    _: cg.explain(p, a, false, "SCAN {n_row} CONSTANT ROW{rows}")
    loop s >= 0 {
        ns := no_sort()
        select_inner_loop(p, a, s, -1, ns, no_distinct(), dest, 1, 1)
        if !b_show_all -> break
        a.selects[s].nselect_row = n_row
        s = a.selects[s].next_sel
    }
    0
}

// hasAnchor: whether recursive SELECT s still has its anchor terms.
has_anchor: fn(a: ast.AST, s0: Int) -> Bool Never! {
    s := s0
    loop s >= 0 && a.selects[s].sel_flags.bit_and(ast.SF_RECURSIVE) != 0 -> s = a.selects[s].prior
    s >= 0
}

// The UNION ALL case of multiSelect; `end` for its goto multi_select_end.
multi_select_all: fn(p: &cg.Parse, a: &ast.AST, s: Int, d: &cg.SelectDest, end: &Bool) -[DB]> Int Never! {
    prior: a.selects[s].prior
    a.selects[prior].ilimit = a.selects[s].ilimit
    a.selects[prior].ioffset = a.selects[s].ioffset
    a.selects[prior].limit = a.selects[s].limit
    rc := select(p, a, prior, d)
    a.selects[prior].limit = -1
    if rc != 0 {
        end = true
        return rc
    }
    a.selects[s].prior = -1
    a.selects[s].ilimit = a.selects[prior].ilimit
    a.selects[s].ioffset = a.selects[prior].ioffset
    addr := 0
    if a.selects[s].ilimit != 0 {
        addr = cg.op1(p, opc.OP_IF_NOT, a.selects[s].ilimit)
        if a.selects[s].ioffset != 0 -> _: cg.op3(p, opc.OP_OFFSET_LIMIT, a.selects[s].ilimit, a.selects[s].ioffset + 1, a.selects[s].ioffset)
    }
    _: cg.explain(p, a, true, "UNION ALL")
    rc = select(p, a, s, d)
    a.selects[s].prior = prior
    a.selects[s].nselect_row = util.log_est_add(a.selects[s].nselect_row, a.selects[prior].nselect_row)
    lim: a.selects[s].limit
    if lim >= 0 {
        if ast.expr_is_integer(a, a.exprs[lim].left) == .Val(n_limit) {
            if n_limit > 0 && a.selects[s].nselect_row > util.log_est(n_limit) -> a.selects[s].nselect_row = util.log_est(n_limit)
        }
    }
    if addr != 0 -> cg.v_jump_here(p, addr)
    rc
}

// The UNION and EXCEPT case of multiSelect: both sides into one temporary
// table (a SELECT to the right's when dest is one), then that table out.
multi_select_union: fn(p: &cg.Parse, a: &ast.AST, s: Int, d: &cg.SelectDest, end: &Bool) -[DB]> Int Never! {
    prior: a.selects[s].prior
    prior_op: cg.SRT_UNION
    union_tab := 0
    if d.e_dest == prior_op {
        union_tab = d.i_sd_parm
    } else {
        union_tab = p.f.n_tab
        p.f.n_tab += 1
        a.selects[s].addr_open_ephm0 = cg.op2(p, opc.OP_OPEN_EPHEMERAL, union_tab, 0)
        rm: find_rightmost(a, s)
        a.selects[rm].sel_flags = a.selects[rm].sel_flags.bit_or(ast.SF_USES_EPHEMERAL)
    }
    uniondest := ex.select_dest_init(prior_op, union_tab)
    rc := select(p, a, prior, uniondest)
    if rc != 0 {
        end = true
        return rc
    }
    op: if a.selects[s].op == tk.TK_EXCEPT -> cg.SRT_EXCEPT else -> cg.SRT_UNION
    a.selects[s].prior = -1
    limit: a.selects[s].limit
    a.selects[s].limit = -1
    uniondest.e_dest = op
    _: cg.explain(p, a, true, "{ast.select_op_name(a.selects[s].op)} USING TEMP B-TREE")
    rc = select(p, a, s, uniondest)
    a.selects[s].prior = prior
    a.selects[s].order_by = -1
    if a.selects[s].op == tk.TK_UNION -> a.selects[s].nselect_row = util.log_est_add(a.selects[s].nselect_row, a.selects[prior].nselect_row)
    ast.expr_delete(a, a.selects[s].limit)
    a.selects[s].limit = limit
    a.selects[s].ilimit = 0
    a.selects[s].ioffset = 0
    if d.e_dest != prior_op && !p.db.malloc_failed {
        i_break: cg.v_make_label(p)
        i_cont: cg.v_make_label(p)
        compute_limit_registers(p, a, s, i_break)
        _: cg.op2(p, opc.OP_REWIND, union_tab, i_break)
        i_start: cg.v_current_addr(p)
        ns := no_sort()
        select_inner_loop(p, a, s, union_tab, ns, no_distinct(), d, i_cont, i_break)
        cg.v_resolve_label(p, i_cont)
        _: cg.op2(p, opc.OP_NEXT, union_tab, i_start)
        cg.v_resolve_label(p, i_break)
        _: cg.op2(p, opc.OP_CLOSE, union_tab, 0)
    }
    rc
}

// The INTERSECT case of multiSelect: the left side into tab1, the right
// into tab2, then the rows of tab1 that tab2 has.
multi_select_intersect: fn(p: &cg.Parse, a: &ast.AST, s: Int, d: &cg.SelectDest, end: &Bool) -[DB]> Int Never! {
    prior: a.selects[s].prior
    tab1: p.f.n_tab
    tab2: p.f.n_tab + 1
    p.f.n_tab += 2
    a.selects[s].addr_open_ephm0 = cg.op2(p, opc.OP_OPEN_EPHEMERAL, tab1, 0)
    rm: find_rightmost(a, s)
    a.selects[rm].sel_flags = a.selects[rm].sel_flags.bit_or(ast.SF_USES_EPHEMERAL)
    intersectdest := ex.select_dest_init(cg.SRT_UNION, tab1)
    rc := select(p, a, prior, intersectdest)
    if rc != 0 {
        end = true
        return rc
    }
    a.selects[s].addr_open_ephm1 = cg.op2(p, opc.OP_OPEN_EPHEMERAL, tab2, 0)
    a.selects[s].prior = -1
    limit: a.selects[s].limit
    a.selects[s].limit = -1
    intersectdest.i_sd_parm = tab2
    _: cg.explain(p, a, true, "{ast.select_op_name(a.selects[s].op)} USING TEMP B-TREE")
    rc = select(p, a, s, intersectdest)
    a.selects[s].prior = prior
    if a.selects[s].nselect_row > a.selects[prior].nselect_row -> a.selects[s].nselect_row = a.selects[prior].nselect_row
    ast.expr_delete(a, a.selects[s].limit)
    a.selects[s].limit = limit
    if rc != 0 -> return rc
    i_break: cg.v_make_label(p)
    i_cont: cg.v_make_label(p)
    compute_limit_registers(p, a, s, i_break)
    _: cg.op2(p, opc.OP_REWIND, tab1, i_break)
    r1: cg.get_temp_reg(p)
    i_start: cg.op2(p, opc.OP_ROW_DATA, tab1, r1)
    _: cg.op4_int(p, opc.OP_NOT_FOUND, tab2, i_cont, r1, 0)
    cg.release_temp_reg(p, r1)
    ns := no_sort()
    select_inner_loop(p, a, s, tab1, ns, no_distinct(), d, i_cont, i_break)
    cg.v_resolve_label(p, i_cont)
    _: cg.op2(p, opc.OP_NEXT, tab1, i_start)
    cg.v_resolve_label(p, i_break)
    _: cg.op2(p, opc.OP_CLOSE, tab2, 0)
    _: cg.op2(p, opc.OP_CLOSE, tab1, 0)
    rc
}

// multiSelect: compound SELECT s (the right-most term; its prior the
// terms to the left) to dest.
multi_select: fn(p: &cg.Parse, a: &ast.AST, s: Int, dest: &cg.SelectDest) -[DB]> Int Never! {
    rc := base.OK
    prior: a.selects[s].prior
    d := dest.copy()
    cg.get_vdbe(p)
    if d.e_dest == cg.SRT_EPHEM_TAB {
        _: cg.op2(p, opc.OP_OPEN_EPHEMERAL, d.i_sd_parm, ast.list_len(a, a.selects[s].elist))
        d.e_dest = cg.SRT_TABLE
    }
    end := false
    if a.selects[s].sel_flags.bit_and(ast.SF_MULTI_VALUE) != 0 {
        rc = multi_select_values(p, a, s, d)
        if rc >= 0 {
            end = true
        } else {
            rc = base.OK
        }
    }
    if !end {
        if a.selects[s].sel_flags.bit_and(ast.SF_RECURSIVE) != 0 && has_anchor(a, s) {
            generate_with_recursive_query(p, a, s, d)
        } else if a.selects[s].order_by >= 0 {
            return multi_select_order_by(p, a, s, dest)
        } else {
            if a.selects[prior].prior < 0 {
                _: cg.explain(p, a, true, "COMPOUND QUERY")
                _: cg.explain(p, a, true, "LEFT-MOST SUBQUERY")
            }
            op: a.selects[s].op
            if op == tk.TK_ALL {
                rc = multi_select_all(p, a, s, d, end)
            } else if op == tk.TK_EXCEPT || op == tk.TK_UNION {
                rc = multi_select_union(p, a, s, d, end)
            } else {
                rc = multi_select_intersect(p, a, s, d, end)
            }
            if !end && a.selects[s].next_sel < 0 -> cg.explain_pop(p)
        }
    }
    if !end && cg.n_err(a) == 0 && a.selects[s].sel_flags.bit_and(ast.SF_USES_EPHEMERAL) != 0 {
        // The right-most SELECT gives every temporary table of the
        // compound its KeyInfo.
        n_col: ast.list_len(a, a.selects[s].elist)
        ki := cat.key_info_alloc(p.db, n_col, 1)
        loop i in 0..<n_col {
            c := multi_select_coll_seq(p, a, s, i)
            if c < 0 -> c = record.COLL_BINARY
            ki.colls[i] = c
        }
        lp := s
        loop lp >= 0 {
            addr0: a.selects[lp].addr_open_ephm0
            if addr0 >= 0 {
                cg.v_change_p2(p, addr0, n_col)
                cg.v_change_p4(p, addr0, conn.P4.KeyInfo(ki.copy()))
                a.selects[lp].addr_open_ephm0 = -1
                addr1: a.selects[lp].addr_open_ephm1
                if addr1 >= 0 {
                    cg.v_change_p2(p, addr1, n_col)
                    cg.v_change_p4(p, addr1, conn.P4.KeyInfo(ki.copy()))
                    a.selects[lp].addr_open_ephm1 = -1
                }
            }
            lp = a.selects[lp].prior
        }
    }
    dest.i_sdst = d.i_sdst
    dest.n_sdst = d.n_sdst
    rc
}

// generateOutputSubroutine: the subroutine (its address returned) that
// sends the current row of coroutine `inp` to dest, skipping a repeat of
// the previous row (in the registers after reg_prev, with reg_prev set
// once there is one) unless reg_prev is 0, and returning through
// reg_return; the LIMIT jumps to i_break.
generate_output_subroutine: fn(p: &cg.Parse, a: &ast.AST, s: Int, inp: cg.SelectDest, dest: &cg.SelectDest, reg_return: Int, reg_prev: Int, key_dup: record.KeyInfo, i_break: Int) -[DB]> Int Never! {
    addr: cg.v_current_addr(p)
    i_continue: cg.v_make_label(p)
    if reg_prev != 0 {
        addr1: cg.op1(p, opc.OP_IF_NOT, reg_prev)
        addr2: cg.op4(p, opc.OP_COMPARE, inp.i_sdst, reg_prev + 1, inp.n_sdst, conn.P4.KeyInfo(key_dup))
        _: cg.op3(p, opc.OP_JUMP, addr2 + 2, i_continue, addr2 + 2)
        cg.v_jump_here(p, addr1)
        _: cg.op3(p, opc.OP_COPY, inp.i_sdst, reg_prev + 1, inp.n_sdst - 1)
        _: cg.op2(p, opc.OP_INTEGER, 1, reg_prev)
    }
    if p.db.malloc_failed -> return 0
    code_offset(p, a.selects[s].ioffset, i_continue)
    e_dest: dest.e_dest
    if e_dest == cg.SRT_EPHEM_TAB {
        r1: cg.get_temp_reg(p)
        r2: cg.get_temp_reg(p)
        _: cg.op3(p, opc.OP_MAKE_RECORD, inp.i_sdst, inp.n_sdst, r1)
        _: cg.op2(p, opc.OP_NEW_ROWID, dest.i_sd_parm, r2)
        _: cg.op3(p, opc.OP_INSERT, dest.i_sd_parm, r1, r2)
        cg.v_change_p5(p, conn.OPFLAG_APPEND)
        cg.release_temp_reg(p, r2)
        cg.release_temp_reg(p, r1)
    } else if e_dest == cg.SRT_SET {
        r1: cg.get_temp_reg(p)
        aff: dest.aff_sdst ?? [U8]{}
        _: cg.op4_text(p, opc.OP_MAKE_RECORD, inp.i_sdst, inp.n_sdst, r1, aff)
        _: cg.op4_int(p, opc.OP_IDX_INSERT, dest.i_sd_parm, r1, inp.i_sdst, inp.n_sdst)
        cg.release_temp_reg(p, r1)
    } else if e_dest == cg.SRT_MEM {
        // The LIMIT ends the loop.
        ex.expr_code_move(p, inp.i_sdst, dest.i_sd_parm, inp.n_sdst)
    } else if e_dest == cg.SRT_COROUTINE {
        if dest.i_sdst == 0 {
            dest.i_sdst = cg.get_temp_range(p, inp.n_sdst)
            dest.n_sdst = inp.n_sdst
        }
        ex.expr_code_move(p, inp.i_sdst, dest.i_sdst, inp.n_sdst)
        _: cg.op1(p, opc.OP_YIELD, dest.i_sd_parm)
    } else {
        _: cg.op2(p, opc.OP_RESULT_ROW, inp.i_sdst, inp.n_sdst)
    }
    if a.selects[s].ilimit != 0 -> _: cg.op2(p, opc.OP_DECR_JUMP_ZERO, a.selects[s].ilimit, i_break)
    cg.v_resolve_label(p, i_continue)
    _: cg.op1(p, opc.OP_RETURN, reg_return)
    addr
}

// multiSelectOrderBy: a compound with an ORDER BY (s the right-most term)
// as a merge of two coroutines, the terms left of the split and those
// from it, each in ORDER BY order; UNION, EXCEPT and INTERSECT drop
// repeats in the output subroutines. Nonzero on error.
multi_select_order_by: fn(p: &cg.Parse, a: &ast.AST, s: Int, dest: &cg.SelectDest) -[DB]> Int Never! {
    label_end: cg.v_make_label(p)
    label_cmpr: cg.v_make_label(p)
    op: a.selects[s].op
    ob := a.selects[s].order_by
    n_order_by := ast.list_len(a, ob)
    n_expr: ast.list_len(a, a.selects[s].elist)
    // Every result column but for UNION ALL is a sort key, added as an
    // integer term where the ORDER BY lacks it.
    if op != tk.TK_ALL {
        i := 1
        loop !p.db.malloc_failed && i <= n_expr {
            j := 0
            loop j < n_order_by && a.lists[ob].items[j].order_by_col != i -> j += 1
            if j == n_order_by {
                e: ast.expr_alloc(a, tk.TK_INTEGER, None, false)
                ast.set_flags(a, e, ast.EP_INT_VALUE)
                a.exprs[e].ivalue = i
                ob = ast.expr_list_append(a, ob, e)
                a.selects[s].order_by = ob
                a.lists[ob].items[n_order_by].order_by_col = i
                n_order_by += 1
            }
            i += 1
        }
    }
    permute := [Int]{n_order_by}
    loop i in 0..<n_order_by -> permute.push(a.lists[ob].items[i].order_by_col - 1)
    key_merge: multi_select_order_by_key_info(p, a, s, 1)
    reg_prev := 0
    key_dup := cat.key_info_alloc(p.db, 0, 0)
    if op != tk.TK_ALL {
        reg_prev = p.f.n_mem + 1
        p.f.n_mem += n_expr + 1
        _: cg.op2(p, opc.OP_INTEGER, 0, reg_prev)
        key_dup = cat.key_info_alloc(p.db, n_expr, 1)
        loop i in 0..<n_expr {
            c: multi_select_coll_seq(p, a, s, i)
            key_dup.colls[i] = if c < 0 -> record.COLL_NONE else -> c
            key_dup.sort_flags[i] = 0
        }
    }
    // The split: balanced for long UNION ALL and UNION chains.
    n_select := 1
    if (op == tk.TK_ALL || op == tk.TK_UNION) && cg.opt_enabled(p, cg.OPT_BALANCED_MERGE) {
        sp := s
        loop a.selects[sp].prior >= 0 && a.selects[sp].op == op {
            n_select += 1
            sp = a.selects[sp].prior
        }
    }
    split := s
    if n_select > 3 {
        i := 2
        loop i < n_select {
            split = a.selects[split].prior
            i += 2
        }
    }
    prior: a.selects[split].prior
    a.selects[split].prior = -1
    a.selects[prior].next_sel = -1
    pob: ast.expr_list_dup(a, ob, 0)
    a.selects[prior].order_by = pob
    _: rs.resolve_order_group_by(p, a, s, ob, "ORDER")
    _: rs.resolve_order_group_by(p, a, prior, pob, "ORDER")
    compute_limit_registers(p, a, s, label_end)
    reg_limit_a := 0
    reg_limit_b := 0
    if a.selects[s].ilimit != 0 && op == tk.TK_ALL {
        p.f.n_mem += 1
        reg_limit_a = p.f.n_mem
        p.f.n_mem += 1
        reg_limit_b = p.f.n_mem
        from: if a.selects[s].ioffset != 0 -> a.selects[s].ioffset + 1 else -> a.selects[s].ilimit
        _: cg.op2(p, opc.OP_COPY, from, reg_limit_a)
        _: cg.op2(p, opc.OP_COPY, reg_limit_a, reg_limit_b)
    }
    ast.expr_delete(a, a.selects[s].limit)
    a.selects[s].limit = -1
    reg_addr_a: p.f.n_mem + 1
    reg_addr_b: p.f.n_mem + 2
    reg_out_a: p.f.n_mem + 3
    reg_out_b: p.f.n_mem + 4
    p.f.n_mem += 4
    dest_a := ex.select_dest_init(cg.SRT_COROUTINE, reg_addr_a)
    dest_b := ex.select_dest_init(cg.SRT_COROUTINE, reg_addr_b)
    _: cg.explain(p, a, true, "MERGE ({ast.select_op_name(op)})")
    // Coroutine A, the left terms.
    addr_select_a: cg.v_current_addr(p) + 1
    addr1 := cg.op3(p, opc.OP_INIT_COROUTINE, reg_addr_a, 0, addr_select_a)
    a.selects[prior].ilimit = reg_limit_a
    _: cg.explain(p, a, true, "LEFT")
    _: select(p, a, prior, dest_a)
    cg.v_end_coroutine(p, reg_addr_a)
    cg.v_jump_here(p, addr1)
    // Coroutine B, the right terms.
    addr_select_b: cg.v_current_addr(p) + 1
    addr1 = cg.op3(p, opc.OP_INIT_COROUTINE, reg_addr_b, 0, addr_select_b)
    saved_limit: a.selects[s].ilimit
    saved_offset: a.selects[s].ioffset
    a.selects[s].ilimit = reg_limit_b
    a.selects[s].ioffset = 0
    _: cg.explain(p, a, true, "RIGHT")
    _: select(p, a, s, dest_b)
    a.selects[s].ilimit = saved_limit
    a.selects[s].ioffset = saved_offset
    cg.v_end_coroutine(p, reg_addr_b)
    addr_out_a: generate_output_subroutine(p, a, s, dest_a, dest, reg_out_a, reg_prev, key_dup, label_end)
    addr_out_b := 0
    if op == tk.TK_ALL || op == tk.TK_UNION -> addr_out_b = generate_output_subroutine(p, a, s, dest_b, dest, reg_out_b, reg_prev, key_dup, label_end)
    // EofA: only B's rows remain.
    addr_eof_a := 0
    addr_eof_a_no_b := 0
    if op == tk.TK_EXCEPT || op == tk.TK_INTERSECT {
        addr_eof_a = label_end
        addr_eof_a_no_b = label_end
    } else {
        addr_eof_a = cg.op2(p, opc.OP_GOSUB, reg_out_b, addr_out_b)
        addr_eof_a_no_b = cg.op2(p, opc.OP_YIELD, reg_addr_b, label_end)
        _: cg.goto(p, addr_eof_a)
        a.selects[s].nselect_row = util.log_est_add(a.selects[s].nselect_row, a.selects[prior].nselect_row)
    }
    // EofB: only A's rows remain.
    addr_eof_b := 0
    if op == tk.TK_INTERSECT {
        addr_eof_b = addr_eof_a
        if a.selects[s].nselect_row > a.selects[prior].nselect_row -> a.selects[s].nselect_row = a.selects[prior].nselect_row
    } else {
        addr_eof_b = cg.op2(p, opc.OP_GOSUB, reg_out_a, addr_out_a)
        _: cg.op2(p, opc.OP_YIELD, reg_addr_a, label_end)
        _: cg.goto(p, addr_eof_b)
    }
    // A < B.
    addr_alt_b := cg.op2(p, opc.OP_GOSUB, reg_out_a, addr_out_a)
    _: cg.op2(p, opc.OP_YIELD, reg_addr_a, addr_eof_a)
    _: cg.goto(p, label_cmpr)
    // A == B.
    addr_aeq_b := 0
    if op == tk.TK_ALL {
        addr_aeq_b = addr_alt_b
    } else if op == tk.TK_INTERSECT {
        addr_aeq_b = addr_alt_b
        addr_alt_b += 1
    } else {
        addr_aeq_b = cg.op2(p, opc.OP_YIELD, reg_addr_a, addr_eof_a)
        _: cg.goto(p, label_cmpr)
    }
    // A > B.
    addr_agt_b: cg.v_current_addr(p)
    if op == tk.TK_ALL || op == tk.TK_UNION -> _: cg.op2(p, opc.OP_GOSUB, reg_out_b, addr_out_b)
    _: cg.op2(p, opc.OP_YIELD, reg_addr_b, addr_eof_b)
    _: cg.goto(p, label_cmpr)
    // The start, then the merge loop.
    cg.v_jump_here(p, addr1)
    _: cg.op2(p, opc.OP_YIELD, reg_addr_a, addr_eof_a_no_b)
    _: cg.op2(p, opc.OP_YIELD, reg_addr_b, addr_eof_b)
    cg.v_resolve_label(p, label_cmpr)
    _: cg.op4(p, opc.OP_PERMUTATION, 0, 0, 0, conn.P4.IntArray(permute))
    _: cg.op4(p, opc.OP_COMPARE, dest_a.i_sdst, dest_b.i_sdst, n_order_by, conn.P4.KeyInfo(key_merge))
    cg.v_change_p5(p, conn.OPFLAG_PERMUTE)
    _: cg.op3(p, opc.OP_JUMP, addr_alt_b, addr_aeq_b, addr_agt_b)
    cg.v_resolve_label(p, label_end)
    a.selects[split].prior = prior
    a.selects[prior].next_sel = split
    ast.expr_list_delete(a, a.selects[prior].order_by)
    a.selects[prior].order_by = -1
    cg.explain_pop(p)
    if cg.n_err(a) != 0 -> 1 else -> 0
}

// ---------------------------------------------------------------------------
// Query flattening.

// struct SubstContext: references to table i_table become copies of the
// terms of elist (collations from clist), under OP_IfNullRow of
// i_new_table when is_outer_join.
SubstContext: struct {
    i_table: Int
    i_new_table: Int
    is_outer_join: Bool
    elist: Int
    clist: Int
}

// substExpr: e with the substitution made; the expression to keep.
subst_expr: fn(p: &cg.Parse, a: &ast.AST, sc: SubstContext, e: Int) -> Int Never! {
    if e < 0 -> return -1
    both_on: ast.EP_OUTER_ON.bit_or(ast.EP_INNER_ON)
    if ast.has(a, e, both_on) && a.exprs[e].w == sc.i_table -> a.exprs[e].w = sc.i_new_table
    if a.exprs[e].op == tk.TK_COLUMN && a.exprs[e].itable == sc.i_table && !ast.has(a, e, ast.EP_FIXED_COL) {
        i_column: a.exprs[e].icolumn
        copy0: ast.list_expr(a, sc.elist, i_column)
        if ast.is_vector(a, copy0) {
            ex.vector_error_msg(a, copy0)
            return e
        }
        from := copy0
        if sc.is_outer_join && (a.exprs[copy0].op != tk.TK_COLUMN || a.exprs[copy0].itable != sc.i_new_table) {
            // C's stack ifNullRow node, which ExprDup copies.
            n := ast.zero_expr(tk.TK_IF_NULL_ROW)
            n.left = copy0
            n.itable = sc.i_new_table
            n.icolumn = 0 - 99
            n.flags = ast.EP_IF_NULL_ROW
            from = ast.push_expr(a, n)
        }
        nw: ast.expr_dup(a, from, 0)
        if p.db.malloc_failed -> return e
        if sc.is_outer_join -> ast.set_flags(a, nw, ast.EP_CAN_BE_NULL)
        if ast.has(a, e, both_on) -> we.set_join_expr(a, nw, a.exprs[e].w, a.exprs[e].flags.bit_and(both_on))
        ast.expr_delete(a, e)
        if a.exprs[nw].op == tk.TK_TRUEFALSE {
            a.exprs[nw].ivalue = if ast.expr_truth_value(a, nw) -> 1 else -> 0
            a.exprs[nw].op = tk.TK_INTEGER
            ast.set_flags(a, nw, ast.EP_INT_VALUE)
        }
        // The copy keeps the collation it had as a column of the subquery.
        nat: ex.expr_coll_seq(p, a, nw)
        ce: ast.list_expr(a, sc.clist, i_column)
        coll: ex.expr_coll_seq(p, a, ce)
        out := nw
        if nat != coll || (a.exprs[nw].op != tk.TK_COLUMN && a.exprs[nw].op != tk.TK_COLLATE) {
            nm: if coll >= 0 -> conn.coll_name(p.db, coll) else -> "BINARY".bytes()
            out = ast.expr_add_collate_string(a, nw, nm)
        }
        ast.clear_flags(a, out, ast.EP_COLLATE)
        return out
    }
    if a.exprs[e].op == tk.TK_IF_NULL_ROW && a.exprs[e].itable == sc.i_table -> a.exprs[e].itable = sc.i_new_table
    l: subst_expr(p, a, sc, a.exprs[e].left)
    a.exprs[e].left = l
    r: subst_expr(p, a, sc, a.exprs[e].right)
    a.exprs[e].right = r
    x: a.exprs[e].x
    if ast.has(a, e, ast.EP_X_IS_SELECT) {
        subst_select(p, a, sc, x, true)
    } else {
        subst_expr_list(p, a, sc, x)
    }
    if ast.has(a, e, ast.EP_WIN_FUNC) {
        w: a.exprs[e].y
        f: subst_expr(p, a, sc, a.windows[w].filter)
        a.windows[w].filter = f
        subst_expr_list(p, a, sc, a.windows[w].partition)
        subst_expr_list(p, a, sc, a.windows[w].order_by)
    }
    e
}

// substExprList.
subst_expr_list: fn(p: &cg.Parse, a: &ast.AST, sc: SubstContext, list: Int) Never! {
    loop i in 0..<ast.list_len(a, list) {
        x: ast.list_expr(a, list, i)
        n: subst_expr(p, a, sc, x)
        a.lists[list].items[i].expr = n
    }
}

// substSelect: the substitution throughout SELECT s0, and its priors with
// do_prior.
subst_select: fn(p: &cg.Parse, a: &ast.AST, sc: SubstContext, s0: Int, do_prior: Bool) Never! {
    s := s0
    loop s >= 0 {
        subst_expr_list(p, a, sc, a.selects[s].elist)
        subst_expr_list(p, a, sc, a.selects[s].group_by)
        subst_expr_list(p, a, sc, a.selects[s].order_by)
        h: subst_expr(p, a, sc, a.selects[s].having)
        a.selects[s].having = h
        w: subst_expr(p, a, sc, a.selects[s].where_expr)
        a.selects[s].where_expr = w
        src: a.selects[s].src
        loop i in 0..<ast.src_len(a, src) {
            si: ast.src_item(a, src, i)
            subst_select(p, a, sc, a.items[si].select, true)
            if a.items[si].is_tab_func -> subst_expr_list(p, a, sc, a.items[si].func_arg)
        }
        if !do_prior -> break
        s = a.selects[s].prior
    }
}

// recomputeColumnsUsedExpr: the walk collects the columns of `cursor`
// (other than the rowid) for the caller to read their colUsed bits.
ColUsedWalker: struct {
    cursor: Int
    hits: [Int]

    impl SQLWalker {
        walk_expr_cb: fn(&self, a: &ast.AST, e: Int) -> Int Never! {
            if a.exprs[e].op == tk.TK_COLUMN && a.exprs[e].itable == self.cursor && a.exprs[e].icolumn >= 0 -> self.hits.push(e)
            ast.WRC_CONTINUE
        }
        walk_has_select_cb: fn(&self) -> Bool Never! { true }
        walk_select_cb: fn(&self, a: &ast.AST, s: Int) -> Int Never! { ast.WRC_CONTINUE }
        walk_has_select_cb2: fn(&self) -> Bool Never! { false }
        walk_select_cb2: fn(&self, a: &ast.AST, s: Int) Never! {}
        walk_win_defn: fn(&self, a: &ast.AST) -> Bool Never! { false }
    }
}

// recomputeColumnsUsed: FROM item si's colUsed from what SELECT s uses.
recompute_columns_used: fn(p: &cg.Parse, a: &ast.AST, s: Int, si: Int) Never! {
    if a.items[si].tab < 0 -> return
    w := ColUsedWalker{cursor: a.items[si].cursor, hits: [Int]{}}
    _: ast.walk_select<ColUsedWalker>(w, a, s)
    m := 0
    loop e in w.hits -> m = m.bit_or(rs.expr_col_used(p.db, a, e))
    a.items[si].col_used = m
}

// srclistRenumberCursors: new cursors for the items of src but i_except
// and of its subqueries, old+1 mapping to new in csr_map (csr_map[0] its
// size).
srclist_renumber_cursors: fn(p: &cg.Parse, a: &ast.AST, csr_map: &[Int], src: Int, i_except: Int) Never! {
    loop i in 0..<ast.src_len(a, src) {
        if i == i_except -> next
        si: ast.src_item(a, src, i)
        c: a.items[si].cursor
        if !a.items[si].is_recursive || csr_map[c + 1] == 0 {
            csr_map[c + 1] = p.f.n_tab
            p.f.n_tab += 1
        }
        a.items[si].cursor = csr_map[c + 1]
        sub := a.items[si].select
        loop sub >= 0 {
            ssrc: a.selects[sub].src
            srclist_renumber_cursors(p, a, csr_map, ssrc, -1)
            sub = a.selects[sub].prior
        }
    }
}

// renumberCursorsCb: the references to renumbered cursors follow them.
RenumberWalker: struct {
    csr_map: [Int]

    impl SQLWalker {
        walk_expr_cb: fn(&self, a: &ast.AST, e: Int) -> Int Never! {
            op: a.exprs[e].op
            if op == tk.TK_COLUMN || op == tk.TK_IF_NULL_ROW -> a.exprs[e].itable = renumber_mapping(self.csr_map, a.exprs[e].itable)
            if ast.has(a, e, ast.EP_OUTER_ON) -> a.exprs[e].w = renumber_mapping(self.csr_map, a.exprs[e].w)
            ast.WRC_CONTINUE
        }
        walk_has_select_cb: fn(&self) -> Bool Never! { true }
        walk_select_cb: fn(&self, a: &ast.AST, s: Int) -> Int Never! { ast.WRC_CONTINUE }
        walk_has_select_cb2: fn(&self) -> Bool Never! { false }
        walk_select_cb2: fn(&self, a: &ast.AST, s: Int) Never! {}
        walk_win_defn: fn(&self, a: &ast.AST) -> Bool Never! { false }
    }
}

// renumberCursorDoMapping.
renumber_mapping: fn(m: [Int], c: Int) -> Int Never! {
    if c >= 0 && c < m[0] && m[c + 1] > 0 -> return m[c + 1]
    c
}

// renumberCursors: new cursors for the FROM items of SELECT s (but
// i_except) and their subqueries, with every reference following.
renumber_cursors: fn(p: &cg.Parse, a: &ast.AST, s: Int, i_except: Int, csr_map: &[Int]) Never! {
    src: a.selects[s].src
    srclist_renumber_cursors(p, a, csr_map, src, i_except)
    w := RenumberWalker{csr_map: csr_map.copy()}
    _: ast.walk_select<RenumberWalker>(w, a, s)
}

// findLeftmostExprlist.
find_leftmost_exprlist: fn(a: ast.AST, s0: Int) -> Int Never! {
    s := s0
    loop a.selects[s].prior >= 0 -> s = a.selects[s].prior
    a.selects[s].elist
}

// compoundHasDifferentAffinities: whether a result column's affinity
// differs between the terms of compound s.
compound_has_different_affinities: fn(p: &cg.Parse, a: &ast.AST, s: Int) -> Bool Never! {
    list: a.selects[s].elist
    loop ii in 0..<ast.list_len(a, list) {
        e: ast.list_expr(a, list, ii)
        aff: ex.expr_affinity(p.db, a, e)
        s1 := a.selects[s].prior
        loop s1 >= 0 {
            e1: ast.list_expr(a, a.selects[s1].elist, ii)
            if ex.expr_affinity(p.db, a, e1) != aff -> return true
            s1 = a.selects[s1].prior
        }
    }
    false
}

// flattenSubquery: merge the subquery of FROM item i_from of SELECT s
// into s (is_agg: s is an aggregate) when the restrictions select.c lists
// allow it; whether it did.
flatten_subquery: fn(p: &cg.Parse, a: &ast.AST, s: Int, i_from: Int, is_agg: Bool) -[DB]> Bool Never! {
    saved_auth: p.f.auth_context
    if cg.opt_disabled(p, cg.OPT_QUERY_FLATTENER) -> return false
    src := a.selects[s].src
    sub_item: ast.src_item(a, src, i_from)
    i_parent: a.items[sub_item].cursor
    sub: a.items[sub_item].select
    if a.selects[s].win >= 0 || a.selects[sub].win >= 0 -> return false
    sub_src: a.selects[sub].src
    sub_lim: a.selects[sub].limit
    s_flags: a.selects[s].sel_flags
    s_distinct: s_flags.bit_and(ast.SF_DISTINCT) != 0
    if sub_lim >= 0 && a.selects[s].limit >= 0 -> return false
    if sub_lim >= 0 && a.exprs[sub_lim].right >= 0 -> return false
    if s_flags.bit_and(ast.SF_COMPOUND) != 0 && sub_lim >= 0 -> return false
    if ast.src_len(a, sub_src) == 0 -> return false
    if a.selects[sub].sel_flags.bit_and(ast.SF_DISTINCT) != 0 -> return false
    if sub_lim >= 0 && (ast.src_len(a, src) > 1 || is_agg) -> return false
    if a.selects[s].order_by >= 0 && a.selects[sub].order_by >= 0 -> return false
    if is_agg && a.selects[sub].order_by >= 0 -> return false
    if sub_lim >= 0 && a.selects[s].where_expr >= 0 -> return false
    if sub_lim >= 0 && s_distinct -> return false
    if a.selects[sub].sel_flags.bit_and(ast.SF_RECURSIVE) != 0 -> return false
    is_outer_join := false
    jt: a.items[sub_item].jointype
    sub_first: ast.src_item(a, sub_src, 0)
    if jt.bit_and(ast.JT_OUTER.bit_or(ast.JT_LTORJ)) != 0 {
        if ast.src_len(a, sub_src) > 1 || ex.is_virtual(p.db, a.items[sub_first].tab) || s_distinct || jt.bit_and(ast.JT_RIGHT) != 0 -> return false
        is_outer_join = true
    }
    if i_from > 0 && a.items[sub_first].jointype.bit_and(ast.JT_LTORJ) != 0 -> return false
    csr_map := [Int]{}
    if a.selects[sub].prior >= 0 {
        if a.selects[sub].order_by >= 0 -> return false
        if is_agg || s_distinct || is_outer_join -> return false
        s1 := sub
        loop s1 >= 0 {
            f1: a.selects[s1].sel_flags
            if f1.bit_and(ast.SF_DISTINCT.bit_or(ast.SF_AGGREGATE)) != 0 || (a.selects[s1].prior >= 0 && a.selects[s1].op != tk.TK_ALL) || ast.src_len(a, a.selects[s1].src) < 1 || a.selects[s1].win >= 0 -> return false
            if i_from > 0 && a.items[ast.src_item(a, a.selects[s1].src, 0)].jointype.bit_and(ast.JT_LTORJ) != 0 -> return false
            s1 = a.selects[s1].prior
        }
        ob: a.selects[s].order_by
        loop ii in 0..<ast.list_len(a, ob) {
            if a.lists[ob].items[ii].order_by_col == 0 -> return false
        }
        if s_flags.bit_and(ast.SF_RECURSIVE) != 0 -> return false
        if compound_has_different_affinities(p, a, sub) -> return false
        if ast.src_len(a, src) > 1 {
            if a.ctx.nselect > 500 -> return false
            if cg.opt_disabled(p, cg.OPT_FLTTN_UNION_ALL) -> return false
            csr_map = [Int]{p.f.n_tab}
            loop k in 0..<p.f.n_tab -> csr_map.push(0)
        }
    }
    // Flattening is permitted.
    p.f.auth_context = a.items[sub_item].name
    _: cg.auth_check(p, a, conn.AUTH_SELECT, None, None, None)
    p.f.auth_context = saved_auth
    sub1: a.items[sub_item].select
    a.items[sub_item].database = None
    a.items[sub_item].name = None
    a.items[sub_item].alias = None
    a.items[sub_item].select = -1
    // A UNION ALL subquery: N-1 copies of the outer query (with no ORDER
    // BY or LIMIT) go before it, joined by UNION ALL, one for each term.
    sc := a.selects[sub].prior
    loop sc >= 0 {
        ob: a.selects[s].order_by
        lim: a.selects[s].limit
        prior: a.selects[s].prior
        item_tab: a.items[sub_item].tab
        a.items[sub_item].tab = -1
        a.selects[s].order_by = -1
        a.selects[s].prior = -1
        a.selects[s].limit = -1
        nw: ast.select_dup(a, s, 0)
        a.selects[s].limit = lim
        a.selects[s].order_by = ob
        a.selects[s].op = tk.TK_ALL
        a.items[sub_item].tab = item_tab
        a.ctx.nselect += 1
        a.selects[nw].sel_id = a.ctx.nselect
        if csr_map.len() > 0 && !p.db.malloc_failed -> renumber_cursors(p, a, nw, i_from, csr_map)
        a.selects[nw].prior = prior
        if prior >= 0 -> a.selects[prior].next_sel = nw
        a.selects[nw].next_sel = s
        a.selects[s].prior = nw
        sc = a.selects[sc].prior
    }
    if p.db.malloc_failed {
        a.items[sub_item].select = sub1
        return true
    }
    // The subquery's Table goes with the statement (Expr.y may still
    // name it): the item's reference drops (see the file header).
    t_del: a.items[sub_item].tab
    if t_del >= 0 {
        ast.tab_unref(a, t_del)
        a.items[sub_item].tab = -1
    }
    // Each (outer, subquery term) pair: the term's FROM items replace the
    // subquery's item, its WHERE joins the outer's, and the references to
    // the subquery's columns become its result expressions.
    sc = sub1
    parent := s
    loop parent >= 0 {
        ltorj: a.items[ast.src_item(a, src, i_from)].jointype.bit_and(ast.JT_LTORJ)
        sub_src_c: a.selects[sc].src
        n_sub_src: ast.src_len(a, sub_src_c)
        src = a.selects[parent].src
        jointype := 0
        if parent == s -> jointype = a.items[sub_item].jointype
        if n_sub_src > 1 {
            if !ast.src_list_enlarge(a, src, n_sub_src - 1, i_from + 1) -> break
        }
        i_new_parent := -1
        loop i in 0..<n_sub_src {
            dst: ast.src_item(a, src, i + i_from)
            from: ast.src_item(a, sub_src_c, i)
            a.items[dst] = a.items[from].copy()
            a.items[dst].jointype = a.items[dst].jointype.bit_or(ltorj)
            i_new_parent = a.items[from].cursor
            a.items[from] = ast.new_src_item()
        }
        first: ast.src_item(a, src, i_from)
        a.items[first].jointype = a.items[first].jointype.bit_and(ast.JT_LTORJ).bit_or(jointype).bit_or(ltorj)
        sob: a.selects[sc].order_by
        if sob >= 0 && a.selects[parent].sel_flags.bit_and(ast.SF_NOOP_ORDER_BY) == 0 {
            // Its ORDER BY column numbers are the subquery's, not the
            // outer query's.
            loop i in 0..<ast.list_len(a, sob) -> a.lists[sob].items[i].order_by_col = 0
            a.selects[parent].order_by = sob
            a.selects[sc].order_by = -1
        }
        wh_sub: a.selects[sc].where_expr
        a.selects[sc].where_expr = -1
        if is_outer_join && wh_sub >= 0 -> we.set_join_expr(a, wh_sub, i_new_parent, ast.EP_OUTER_ON)
        if wh_sub >= 0 {
            pw: a.selects[parent].where_expr
            nw := wh_sub
            if pw >= 0 -> nw = ast.pexpr(a, tk.TK_AND, wh_sub, pw)
            a.selects[parent].where_expr = nw
        }
        if !p.db.malloc_failed {
            cl: find_leftmost_exprlist(a, sc)
            x: SubstContext{i_table: i_parent, i_new_table: i_new_parent, is_outer_join: is_outer_join, elist: a.selects[sc].elist, clist: cl}
            subst_select(p, a, x, parent, false)
        }
        a.selects[parent].sel_flags = a.selects[parent].sel_flags.bit_or(a.selects[sc].sel_flags.bit_and(ast.SF_COMPOUND))
        if a.selects[sc].limit >= 0 {
            a.selects[parent].limit = a.selects[sc].limit
            a.selects[sc].limit = -1
        }
        loop i in 0..<n_sub_src {
            si: ast.src_item(a, src, i + i_from)
            recompute_columns_used(p, a, parent, si)
        }
        parent = a.selects[parent].prior
        sc = a.selects[sc].prior
    }
    ex.agg_info_persist_select(p, a, sub1)
    ast.select_delete(a, sub1)
    true
}

// ---------------------------------------------------------------------------
// WHERE-clause constant propagation.

// struct WhereConst, in the walk's state: ints the (COLUMN, VALUE) pairs,
// e_code bHasAffBlob, u mExcludeOn, u2 nChng.

// constInsert: COLUMN=VALUE expression e (column col, constant val) joins
// the pairs unless the column is fixed or present, the value has an
// affinity, or the comparison is not BINARY.
const_insert: fn(p: &cg.Parse, a: &ast.AST, t: Int, col: Int, val: Int, e: Int) Never! {
    if ast.has(a, col, ast.EP_FIXED_COL) -> return
    if ex.expr_affinity(p.db, a, val) != 0 -> return
    if !ex.is_binary(ex.expr_compare_coll_seq(p, a, e)) -> return
    n: p.walks[t].ints.len()
    i := 0
    loop i < n {
        e2: p.walks[t].ints[i]
        if a.exprs[e2].itable == a.exprs[col].itable && a.exprs[e2].icolumn == a.exprs[col].icolumn -> return
        i += 2
    }
    if ex.expr_affinity(p.db, a, col) == base.AFF_BLOB -> p.walks[t].e_code = 1
    p.walks[t].ints.push(col)
    p.walks[t].ints.push(val)
}

// findConstInWhere: the AND-connected COLUMN=CONSTANT terms of e.
find_const_in_where: fn(p: &cg.Parse, a: &ast.AST, t: Int, e: Int) Never! {
    if e < 0 -> return
    if ast.has(a, e, p.walks[t].u) -> return
    op: a.exprs[e].op
    if op == tk.TK_AND {
        find_const_in_where(p, a, t, a.exprs[e].right)
        find_const_in_where(p, a, t, a.exprs[e].left)
        return
    }
    if op != tk.TK_EQ -> return
    r: a.exprs[e].right
    l: a.exprs[e].left
    if a.exprs[r].op == tk.TK_COLUMN && ast.expr_is_constant(a, l) -> const_insert(p, a, t, r, l, e)
    if a.exprs[l].op == tk.TK_COLUMN && ast.expr_is_constant(a, r) -> const_insert(p, a, t, l, r, e)
}

// propagateConstantExprRewriteOne: a column of the pairs (unless blob
// affinity with ignore_aff_blob) is marked EP_FIXED_COL with a copy of
// its value on the left.
propagate_constant_rewrite_one: fn(p: &cg.Parse, a: &ast.AST, t: Int, e: Int, ignore_aff_blob: Bool) -> Int Never! {
    if p.db.malloc_failed -> return ast.WRC_PRUNE
    if a.exprs[e].op != tk.TK_COLUMN -> return ast.WRC_CONTINUE
    if ast.has(a, e, ast.EP_FIXED_COL.bit_or(p.walks[t].u)) -> return ast.WRC_CONTINUE
    n: p.walks[t].ints.len()
    i := 0
    loop i < n {
        col: p.walks[t].ints[i]
        if col != e && a.exprs[col].itable == a.exprs[e].itable && a.exprs[col].icolumn == a.exprs[e].icolumn {
            if ignore_aff_blob && ex.expr_affinity(p.db, a, col) == base.AFF_BLOB -> break
            p.walks[t].u2 += 1
            ast.clear_flags(a, e, ast.EP_LEAF)
            ast.set_flags(a, e, ast.EP_FIXED_COL)
            v: ast.expr_dup(a, p.walks[t].ints[i + 1], 0)
            a.exprs[e].left = v
            break
        }
        i += 2
    }
    ast.WRC_PRUNE
}

// propagateConstantExprRewrite.
PropagateConstWalker: struct {
    unused: Int

    impl WalkCb {
        on_expr: fn(self, p: &cg.Parse, a: &ast.AST, e: Int) -[DB]> Int Never! {
            t: cg.walk_top(p)
            if p.walks[t].e_code != 0 {
                op: a.exprs[e].op
                if (op >= tk.TK_EQ && op <= tk.TK_GE) || op == tk.TK_IS {
                    l: a.exprs[e].left
                    _: propagate_constant_rewrite_one(p, a, t, l, false)
                    if p.db.malloc_failed -> return ast.WRC_PRUNE
                    if ex.expr_affinity(p.db, a, l) != base.AFF_TEXT {
                        r: a.exprs[e].right
                        _: propagate_constant_rewrite_one(p, a, t, r, false)
                    }
                }
            }
            propagate_constant_rewrite_one(p, a, t, e, p.walks[t].e_code != 0)
        }
        has_select: fn(self) -[]> Bool Never! { true }
        on_select: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) -[DB]> Int Never! { ast.WRC_CONTINUE }
        has_select2: fn(self) -[]> Bool Never! { false }
        on_select2: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) Never! -[DB]> {}
        win_defn: fn(self) -[]> Bool Never! { false }
    }
}

// propagateConstants: the WHERE-clause constant propagation of SELECT s
// (see select.c); the number of changes.
propagate_constants: fn(p: &cg.Parse, a: &ast.AST, s: Int) -[DB]> Int Never! {
    n_chng := 0
    loop {
        w := PropagateConstWalker{unused: 0}
        cg.walk_push(p, w, 0)
        t: cg.walk_top(p)
        src: a.selects[s].src
        exclude := ast.EP_OUTER_ON
        if ast.src_len(a, src) > 0 && a.items[ast.src_item(a, src, 0)].jointype.bit_and(ast.JT_LTORJ) != 0 -> exclude = ast.EP_INNER_ON.bit_or(ast.EP_OUTER_ON)
        p.walks[t].u = exclude
        p.walks[t].u2 = 0
        wh: a.selects[s].where_expr
        find_const_in_where(p, a, t, wh)
        if p.walks[t].ints.len() > 0 -> _: cg.pwalk_expr(p, a, wh)
        st: cg.walk_pop(p)
        n_chng += st.u2
        if st.u2 == 0 -> break
    }
    n_chng
}

// ---------------------------------------------------------------------------
// WHERE-term push-down and unused subquery columns.

// pushDownWhereTerms: copies of the terms of the outer WHERE `wh` that
// constrain FROM item i_src of src_list alone go to the WHERE (HAVING for
// an aggregate) of each term of its subquery sub; the number pushed.
push_down_where_terms: fn(p: &cg.Parse, a: &ast.AST, sub: Int, wh0: Int, src_list: Int, i_src: Int) -[DB]> Int Never! {
    if wh0 < 0 -> return 0
    si: ast.src_item(a, src_list, i_src)
    if a.selects[sub].sel_flags.bit_and(ast.SF_RECURSIVE.bit_or(ast.SF_MULTI_PART)) != 0 -> return 0
    if a.items[si].jointype.bit_and(ast.JT_LTORJ.bit_or(ast.JT_RIGHT)) != 0 -> return 0
    if a.selects[sub].prior >= 0 {
        not_union_all := false
        sel := sub
        loop sel >= 0 {
            op: a.selects[sel].op
            if op != tk.TK_ALL && op != tk.TK_SELECT -> not_union_all = true
            if a.selects[sel].win >= 0 -> return 0
            sel = a.selects[sel].prior
        }
        if not_union_all {
            sel = sub
            loop sel >= 0 {
                list: a.selects[sel].elist
                loop ii in 0..<ast.list_len(a, list) {
                    li: ast.list_expr(a, list, ii)
                    if !ex.is_binary(ex.expr_coll_seq(p, a, li)) -> return 0
                }
                sel = a.selects[sel].prior
            }
        }
    } else {
        w: a.selects[sub].win
        if w >= 0 && a.windows[w].partition < 0 -> return 0
    }
    if a.selects[sub].limit >= 0 -> return 0
    n_chng := 0
    wh := wh0
    loop a.exprs[wh].op == tk.TK_AND {
        n_chng += push_down_where_terms(p, a, sub, a.exprs[wh].right, src_list, i_src)
        wh = a.exprs[wh].left
    }
    if ex.expr_is_single_table_constraint(a, wh, src_list, i_src) {
        n_chng += 1
        a.selects[sub].sel_flags = a.selects[sub].sel_flags.bit_or(ast.SF_PUSH_DOWN)
        sq := sub
        cur: a.items[si].cursor
        loop sq >= 0 {
            nw0: ast.expr_dup(a, wh, 0)
            unset_join_expr(a, nw0, -1, true)
            cl: find_leftmost_exprlist(a, sq)
            x: SubstContext{i_table: cur, i_new_table: cur, is_outer_join: false, elist: a.selects[sq].elist, clist: cl}
            nw: subst_expr(p, a, x, nw0)
            w: a.selects[sq].win
            if w >= 0 && !ex.expr_is_constant_or_group_by(p, a, nw, a.windows[w].partition) {
                // Restriction 6c.
                ast.expr_delete(a, nw)
                n_chng -= 1
                break
            }
            if a.selects[sq].sel_flags.bit_and(ast.SF_AGGREGATE) != 0 {
                h: ast.expr_and(a, a.selects[sq].having, nw)
                a.selects[sq].having = h
            } else {
                h: ast.expr_and(a, a.selects[sq].where_expr, nw)
                a.selects[sq].where_expr = h
            }
            sq = a.selects[sq].prior
        }
    }
    n_chng
}

// disableUnusedSubqueryResultColumns: the result columns of FROM item
// si's subquery that nothing reads become NULL; how many.
disable_unused_subquery_result_columns: fn(p: &cg.Parse, a: &ast.AST, si: Int) -> Int Never! {
    if a.items[si].is_correlated || a.items[si].is_cte -> return 0
    t: a.items[si].tab
    sub: a.items[si].select
    x := sub
    loop x >= 0 {
        if a.selects[x].sel_flags.bit_and(ast.SF_DISTINCT.bit_or(ast.SF_AGGREGATE)) != 0 -> return 0
        if a.selects[x].prior >= 0 && a.selects[x].op != tk.TK_ALL -> return 0
        if a.selects[x].win >= 0 -> return 0
        x = a.selects[x].prior
    }
    col_used := a.items[si].col_used
    ob: a.selects[sub].order_by
    loop j in 0..<ast.list_len(a, ob) {
        i_col := a.lists[ob].items[j].order_by_col
        if i_col > 0 {
            i_col -= 1
            if i_col >= rs.BMS -> i_col = rs.BMS - 1
            col_used = col_used.bit_or(1 << i_col)
        }
    }
    n_chng := 0
    n_col: p.db.tables[t].cols.len()
    loop j in 0..<n_col {
        m: if j < rs.BMS - 1 -> 1 << j else -> 1 << (rs.BMS - 1)
        if m.bit_and(col_used) != 0 -> next
        x = sub
        loop x >= 0 {
            y: ast.list_expr(a, a.selects[x].elist, j)
            if a.exprs[y].op != tk.TK_NULL {
                a.exprs[y].op = tk.TK_NULL
                ast.clear_flags(a, y, ast.EP_SKIP.bit_or(ast.EP_UNLIKELY))
                a.selects[x].sel_flags = a.selects[x].sel_flags.bit_or(ast.SF_PUSH_DOWN)
                n_chng += 1
            }
            x = a.selects[x].prior
        }
    }
    n_chng
}

// ---------------------------------------------------------------------------
// Aggregate shortcuts.

// minMaxQuery: for the one aggregate e, WHERE_ORDERBY_MIN or _MAX with
// the ORDER BY (its argument) that finds the answer first, when e is
// min() or max() of one argument.
min_max_query: fn(p: &cg.Parse, a: &ast.AST, e: Int) -> (ret: Int, ob: Int) Never! {
    elist: a.exprs[e].x
    if elist < 0 || ast.list_len(a, elist) != 1 || ast.has(a, e, ast.EP_WIN_FUNC) || cg.opt_disabled(p, cg.OPT_MIN_MAX_OPT) -> return (ret: cg.WHERE_ORDERBY_NORMAL, ob: -1)
    z: a.exprs[e].token ?? [U8]{}
    ret := cg.WHERE_ORDERBY_NORMAL
    sort_flags := 0
    if util.str_icmp(z, "min".bytes()) == 0 {
        ret = cg.WHERE_ORDERBY_MIN
        if rs.expr_can_be_null(p.db, a, ast.list_expr(a, elist, 0)) -> sort_flags = base.KEYINFO_ORDER_BIGNULL
    } else if util.str_icmp(z, "max".bytes()) == 0 {
        ret = cg.WHERE_ORDERBY_MAX
        sort_flags = base.KEYINFO_ORDER_DESC
    } else {
        return (ret: ret, ob: -1)
    }
    ob: ast.expr_list_dup(a, elist, 0)
    if ob >= 0 -> a.lists[ob].items[0].sort_flags = sort_flags
    (ret: ret, ob: ob)
}

// isSimpleCount: the table of "SELECT count(*) FROM <tbl>" (aggregate s,
// AggInfo ai), or -1.
is_simple_count: fn(p: cg.Parse, a: ast.AST, s: Int, ai: Int) -> Int Never! {
    src: a.selects[s].src
    if a.selects[s].where_expr >= 0 || ast.list_len(a, a.selects[s].elist) != 1 || ast.src_len(a, src) != 1 || a.items[ast.src_item(a, src, 0)].select >= 0 || p.aggs[ai].funcs.len() != 1 || a.selects[s].having >= 0 -> return -1
    t: a.items[ast.src_item(a, src, 0)].tab
    if p.db.tables[t].tab_type != conn.TABTYP_NORM -> return -1
    e: ast.list_expr(a, a.selects[s].elist, 0)
    if a.exprs[e].op != tk.TK_AGG_FUNCTION -> return -1
    if a.exprs[e].agg_info != ai -> return -1
    if p.aggs[ai].funcs[0].func.flags.bit_and(conn.FUNC_COUNT) == 0 -> return -1
    if ast.has(a, e, ast.EP_DISTINCT.bit_or(ast.EP_WIN_FUNC)) -> return -1
    t
}

// sqlite3IndexedByLookup: the index FROM item si's INDEXED BY names, in
// its u2; an error when its table has none.
indexed_by_lookup: fn(p: &cg.Parse, a: &ast.AST, si: Int) -> Int Never! {
    t: a.items[si].tab
    z: a.items[si].indexed_by ?? [U8]{}
    ix := p.db.tables[t].index
    loop ix >= 0 && util.str_icmp(p.db.indexes[ix].name, z) != 0 -> ix = p.db.indexes[ix].next
    if ix < 0 {
        ast.error(a, "no such index: {ast.text(z)}")
        p.f.check_schema = true
        return base.ERROR
    }
    a.items[si].u2 = ix
    base.OK
}

// ---------------------------------------------------------------------------
// Expansion (selectExpander and its kin).

// convertCompoundSelectToSubquery: a UNION, EXCEPT or INTERSECT with an
// ORDER BY COLLATE term becomes "SELECT * FROM (compound) ORDER BY ..",
// which multiSelectOrderBy's merge needs.
ConvertCompoundWalker: struct {
    unused: Int

    impl SQLWalker {
        walk_expr_cb: fn(&self, a: &ast.AST, e: Int) -> Int Never! { ast.WRC_CONTINUE }
        walk_has_select_cb: fn(&self) -> Bool Never! { true }
        walk_select_cb: fn(&self, a: &ast.AST, s: Int) -> Int Never! { convert_compound_select_to_subquery(a, s) }
        walk_has_select_cb2: fn(&self) -> Bool Never! { false }
        walk_select_cb2: fn(&self, a: &ast.AST, s: Int) Never! {}
        walk_win_defn: fn(&self, a: &ast.AST) -> Bool Never! { false }
    }
}

convert_compound_select_to_subquery: fn(a: &ast.AST, s: Int) -> Int Never! {
    if a.selects[s].prior < 0 -> return ast.WRC_CONTINUE
    ob: a.selects[s].order_by
    if ob < 0 -> return ast.WRC_CONTINUE
    x := s
    loop x >= 0 && (a.selects[x].op == tk.TK_ALL || a.selects[x].op == tk.TK_SELECT) -> x = a.selects[x].prior
    if x < 0 -> return ast.WRC_CONTINUE
    // Already matched to the result columns: the window rewrite's second
    // pass needs no conversion.
    if a.lists[ob].items[0].order_by_col != 0 -> return ast.WRC_CONTINUE
    i := ast.list_len(a, ob) - 1
    loop i >= 0 && !ast.has(a, ast.list_expr(a, ob, i), ast.EP_COLLATE) -> i -= 1
    if i < 0 -> return ast.WRC_CONTINUE
    nw: ast.new_select(a)
    new_src: ast.src_list_append_from_term(a, -1, None, None, [U8]{}, nw, -1, -1)
    if new_src < 0 -> return ast.WRC_ABORT
    a.selects[nw] = a.selects[s].copy()
    a.selects[s].src = new_src
    star: ast.expr_alloc(a, tk.TK_ASTERISK, None, false)
    el: ast.expr_list_append(a, -1, star)
    a.selects[s].elist = el
    a.selects[s].op = tk.TK_SELECT
    a.selects[s].where_expr = -1
    a.selects[nw].group_by = -1
    a.selects[nw].having = -1
    a.selects[nw].order_by = -1
    a.selects[s].prior = -1
    a.selects[s].next_sel = -1
    a.selects[s].with_clause = -1
    a.selects[s].win_defn = -1
    a.selects[s].sel_flags = util.clear_bits(a.selects[s].sel_flags, ast.SF_COMPOUND).bit_or(ast.SF_CONVERTED)
    a.selects[a.selects[nw].prior].next_sel = nw
    a.selects[nw].limit = -1
    ast.WRC_CONTINUE
}

// cannotBeFunction: an error when FROM item si has table-valued function
// arguments.
cannot_be_function: fn(a: &ast.AST, si: Int) -> Bool Never! {
    if a.items[si].is_tab_func {
        ast.error(a, "'{ast.text(a.items[si].name ?? [U8]{})}' is not a function")
        return true
    }
    false
}

// searchWith: the CTE named z in the WITH clauses from w0 outwards (up to
// a view's), with the WITH that holds it; cte -1 for none.
search_with: fn(a: ast.AST, w0: Int, z: [U8]) -> (cte: Int, with: Int) Never! {
    w := w0
    loop w >= 0 {
        loop c in a.withs[w].ctes {
            if util.str_icmp(z, a.ctes[c].name ?? [U8]{}) == 0 -> return (cte: c, with: w)
        }
        if a.withs[w].bview -> break
        w = a.withs[w].outer
    }
    (cte: -1, with: -1)
}

// resolveFromTermToCte: FROM item si as a reference to a CTE in scope
// (Cte.zCteErr, here cte_err, holds the message prefix for an illegal
// recursive reference): 0 no match, 1 matched, 2 error.
resolve_from_term_to_cte: fn(p: &cg.Parse, a: &ast.AST, si: Int) -[DB]> Int Never! {
    if a.ctx.cur_with < 0 -> return 0
    if cg.n_err(a) != 0 -> return 0
    if a.items[si].database != None -> return 0
    if a.items[si].not_cte -> return 0
    found: search_with(a, a.ctx.cur_with, a.items[si].name ?? [U8]{})
    cte: found.cte
    if cte < 0 -> return 0
    with: found.with
    name: a.ctes[cte].name ?? [U8]{}
    if a.ctes[cte].cte_err == .Val(msg0) {
        msg: msg0.copy()
        ast.error(a, "{msg}{ast.text(name)}")
        return 2
    }
    if cannot_be_function(a, si) -> return 2
    tb: conn.table_alloc(p.db)
    cu := a.ctes[cte].cte_use
    if cu < 0 {
        a.cte_uses.push(ast.SQLCteUse{nuse: 0, addr_m9e: 0, reg_rtn: 0, icur: 0, nrow_est: 0, m10d: a.ctes[cte].m10d})
        cu = a.cte_uses.len() - 1
        a.ctes[cte].cte_use = cu
    }
    a.items[si].tab = tb
    p.db.tables[tb].name = name.copy()
    p.db.tables[tb].tab_flags = p.db.tables[tb].tab_flags.bit_or(ast.TF_EPHEMERAL.bit_or(ast.TF_NO_VISIBLE_ROWID))
    sel: ast.select_dup(a, a.ctes[cte].select, 0)
    a.items[si].select = sel
    if p.db.malloc_failed -> return 2
    a.selects[sel].sel_flags = a.selects[sel].sel_flags.bit_or(ast.SF_COPY_CTE)
    if a.items[si].is_indexed_by {
        ast.error(a, "no such index: \"{ast.text(a.items[si].indexed_by ?? [U8]{})}\"")
        return 2
    }
    a.items[si].is_cte = true
    a.items[si].u2 = cu
    a.cte_uses[cu].nuse += 1
    // A recursive CTE: the references to it in its recursive terms.
    rec_term := sel
    may_recursive: a.selects[sel].op == tk.TK_ALL || a.selects[sel].op == tk.TK_UNION
    i_rec_tab := -1
    loop may_recursive && a.selects[rec_term].op == a.selects[sel].op {
        src: a.selects[rec_term].src
        loop i in 0..<ast.src_len(a, src) {
            ri: ast.src_item(a, src, i)
            if a.items[ri].database == None && a.items[ri].name != None && util.str_icmp(a.items[ri].name ?? [U8]{}, name) == 0 {
                a.items[ri].tab = tb
                ast.tab_ref(a, tb)
                a.items[ri].is_recursive = true
                if a.selects[rec_term].sel_flags.bit_and(ast.SF_RECURSIVE) != 0 {
                    ast.error(a, "multiple references to recursive table: {ast.text(name)}")
                    return 2
                }
                a.selects[rec_term].sel_flags = a.selects[rec_term].sel_flags.bit_or(ast.SF_RECURSIVE)
                if i_rec_tab < 0 {
                    i_rec_tab = p.f.n_tab
                    p.f.n_tab += 1
                }
                a.items[ri].cursor = i_rec_tab
            }
        }
        if a.selects[rec_term].sel_flags.bit_and(ast.SF_RECURSIVE) == 0 -> break
        rec_term = a.selects[rec_term].prior
    }
    a.ctes[cte].cte_err = Val("circular reference: ")
    saved_with: a.ctx.cur_with
    a.ctx.cur_with = with
    if a.selects[sel].sel_flags.bit_and(ast.SF_RECURSIVE) != 0 {
        a.selects[rec_term].with_clause = a.selects[sel].with_clause
        rc: cg.pwalk_select(p, a, rec_term)
        a.selects[rec_term].with_clause = -1
        if rc != 0 {
            a.ctx.cur_with = saved_with
            return 2
        }
    } else if cg.pwalk_select(p, a, sel) != 0 {
        a.ctx.cur_with = saved_with
        return 2
    }
    a.ctx.cur_with = with
    left := sel
    loop a.selects[left].prior >= 0 -> left = a.selects[left].prior
    elist := a.selects[left].elist
    cols: a.ctes[cte].cols
    if cols >= 0 {
        if elist >= 0 && ast.list_len(a, elist) != ast.list_len(a, cols) {
            n_e: ast.list_len(a, elist)
            n_c: ast.list_len(a, cols)
            ast.error(a, "table {ast.text(name)} has {n_e} values for {n_c} columns")
            a.ctx.cur_with = saved_with
            return 2
        }
        elist = cols
    }
    tcols: columns_from_expr_list(p, a, elist)
    p.db.tables[tb].cols = tcols
    if may_recursive {
        if a.selects[sel].sel_flags.bit_and(ast.SF_RECURSIVE) != 0 {
            a.ctes[cte].cte_err = Val("multiple recursive references: ")
        } else {
            a.ctes[cte].cte_err = Val("recursive reference in a subquery: ")
        }
        _: cg.pwalk_select(p, a, sel)
    }
    a.ctes[cte].cte_err = None
    a.ctx.cur_with = saved_with
    1
}

// sqlite3SelectPopWith: the WITH of compound s (its right-most term's)
// leaves scope.
select_pop_with: fn(a: &ast.AST, s: Int) Never! {
    if a.ctx.cur_with >= 0 && a.selects[s].prior < 0 {
        w: a.selects[find_rightmost(a, s)].with_clause
        if w >= 0 -> a.ctx.cur_with = a.withs[w].outer
    }
}

// sqlite3ExpandSubquery: the ephemeral Table of FROM subquery si's
// result columns.
expand_subquery: fn(p: &cg.Parse, a: &ast.AST, si: Int) -[DB]> Int Never! {
    sel := a.items[si].select
    tb: conn.table_alloc(p.db)
    a.items[si].tab = tb
    nm: if a.items[si].alias == .Val(z) -> z.copy() else -> wh.src_item_text(a, si).bytes()
    p.db.tables[tb].name = nm
    loop a.selects[sel].prior >= 0 -> sel = a.selects[sel].prior
    cols: columns_from_expr_list(p, a, a.selects[sel].elist)
    p.db.tables[tb].cols = cols
    p.db.tables[tb].tab_flags = p.db.tables[tb].tab_flags.bit_or(ast.TF_EPHEMERAL.bit_or(ast.TF_NO_VISIBLE_ROWID))
    if cg.n_err(a) != 0 -> base.ERROR else -> base.OK
}

// inAnyUsingClause: whether a USING clause of the n FROM items after item
// i of src names z.
in_any_using_clause: fn(a: ast.AST, z: [U8], src: Int, i: Int, n: Int) -> Bool Never! {
    loop k in (i + 1)..<(i + 1 + n) {
        si: ast.src_item(a, src, k)
        if !a.items[si].is_using || a.items[si].u3 < 0 -> next
        if ast.id_list_index(a, a.items[si].u3, z) >= 0 -> return true
    }
    false
}

// The bytes of parts joined by `sep`.
join_bytes: fn(parts: [[U8]], sep: U8) -> [U8] Never! {
    out := [U8]{}
    loop k in 0..<parts.len() {
        if k > 0 -> out.push(sep)
        loop b in parts[k] -> out.push(b)
    }
    out
}

// selectExpander: cursors for the FROM items of s, their tables (a copy
// of the SELECT of a view or CTE, a Table for a subquery), the joins'
// ON and USING terms, and the "*" and "TABLE.*" result columns expanded.
// The walk's e_code renumbers selId (a view's copy).
select_expander: fn(p: &cg.Parse, a: &ast.AST, s: Int) -[DB]> Int Never! {
    sel_flags: a.selects[s].sel_flags
    a.selects[s].sel_flags = sel_flags.bit_or(ast.SF_EXPANDED)
    if p.db.malloc_failed -> return ast.WRC_ABORT
    if sel_flags.bit_and(ast.SF_EXPANDED) != 0 -> return ast.WRC_PRUNE
    t: cg.walk_top(p)
    if p.walks[t].e_code != 0 {
        a.ctx.nselect += 1
        a.selects[s].sel_id = a.ctx.nselect
    }
    tab_list: a.selects[s].src
    if a.ctx.cur_with >= 0 && sel_flags.bit_and(ast.SF_VIEW) != 0 {
        if a.selects[s].with_clause < 0 {
            a.withs.push(ast.SQLWith{ctes: [Int]{}, bview: false, outer: -1})
            a.selects[s].with_clause = a.withs.len() - 1
        }
        a.withs[a.selects[s].with_clause].bview = true
    }
    ast.with_push(a, a.selects[s].with_clause)
    n_tab: ast.src_list_assign_cursors(a, tab_list, p.f.n_tab)
    p.f.n_tab = n_tab
    n_src: ast.src_len(a, tab_list)
    loop i in 0..<n_src {
        si: ast.src_item(a, tab_list, i)
        if a.items[si].tab >= 0 -> next
        if a.items[si].name == None {
            // A subquery in the FROM clause.
            if cg.pwalk_select(p, a, a.items[si].select) != 0 -> return ast.WRC_ABORT
            if expand_subquery(p, a, si) != base.OK -> return ast.WRC_ABORT
        } else {
            rc: resolve_from_term_to_cte(p, a, si)
            if rc > 1 -> return ast.WRC_ABORT
            if rc == 0 {
                // An ordinary table or view.
                tb: cat.locate_table_item(p, a, 0, si)
                a.items[si].tab = tb
                if tb < 0 -> return ast.WRC_ABORT
                if p.db.tables[tb].n_tab_ref + (a.tab_refs.get(tb) ?? 0) >= 65535 {
                    ast.error(a, "too many references to \"{ast.text(p.db.tables[tb].name)}\": max 65535")
                    a.items[si].tab = -1
                    return ast.WRC_ABORT
                }
                ast.tab_ref(a, tb)
                if !ex.is_virtual(p.db, tb) && cannot_be_function(a, si) -> return ast.WRC_ABORT
                if p.db.tables[tb].tab_type != conn.TABTYP_NORM {
                    e_code_orig: p.walks[t].e_code
                    g := p.up
                    if g.view_get_column_names(p, a, tb) != 0 -> return ast.WRC_ABORT
                    if p.db.tables[tb].tab_type == conn.TABTYP_VIEW {
                        if p.db.flags.bit_and(conn.SQLITE_ENABLE_VIEW) == 0 && p.db.tables[tb].schema != p.db.dbs[1].schema -> ast.error(a, "access to view \"{ast.text(p.db.tables[tb].name)}\" prohibited")
                        vs: ast.select_dup(a, p.db.tables[tb].select, 0)
                        a.items[si].select = vs
                    } else if a.items[si].from_ddl && p.db.tables[tb].vtab >= 0 {
                        trusted: if p.db.flags.bit_and(conn.SQLITE_TRUSTED_SCHEMA) != 0 -> 1 else -> 0
                        if p.db.vtables[p.db.tables[tb].vtab].e_vtab_risk > trusted -> ast.error(a, "unsafe use of virtual table \"{ast.text(p.db.tables[tb].name)}\"")
                    }
                    // C's nCol of -1 while the view's SELECT is walked.
                    p.db.tables[tb].cols_pending = true
                    p.walks[t].e_code = 1
                    _: cg.pwalk_select(p, a, a.items[si].select)
                    p.walks[t].e_code = e_code_orig
                    p.db.tables[tb].cols_pending = false
                }
            }
        }
        if a.items[si].is_indexed_by && indexed_by_lookup(p, a, si) != 0 -> return ast.WRC_ABORT
    }
    if cg.n_err(a) != 0 || process_join(p, a, s) != 0 -> return ast.WRC_ABORT
    // The "*" and "TABLE.*" terms of the result list.
    elist: a.selects[s].elist
    n_el: ast.list_len(a, elist)
    elist_flags := 0
    k := 0
    loop k < n_el {
        e: ast.list_expr(a, elist, k)
        if a.exprs[e].op == tk.TK_ASTERISK -> break
        if a.exprs[e].op == tk.TK_DOT && a.exprs[a.exprs[e].right].op == tk.TK_ASTERISK -> break
        elist_flags = elist_flags.bit_or(a.exprs[e].flags)
        k += 1
    }
    if k < n_el {
        nw := -1
        flags: p.db.flags
        long_names: flags.bit_and(conn.SQLITE_FULL_COL_NAMES) != 0 && flags.bit_and(conn.SQLITE_SHORT_COL_NAMES) == 0
        nested: sel_flags.bit_and(ast.SF_NESTED_FROM) != 0
        loop kk in 0..<n_el {
            item: a.lists[elist].items[kk].copy()
            e: item.expr
            elist_flags = elist_flags.bit_or(a.exprs[e].flags)
            right: a.exprs[e].right
            if a.exprs[e].op != tk.TK_ASTERISK && (a.exprs[e].op != tk.TK_DOT || a.exprs[right].op != tk.TK_ASTERISK) {
                // Not to expand: it moves to the new list.
                nw = ast.expr_list_append(a, nw, e)
                last: a.lists[nw].items.len() - 1
                a.lists[nw].items[last].ename = item.ename
                a.lists[nw].items[last].eename = item.eename
                a.lists[elist].items[kk].ename = None
                a.lists[elist].items[kk].expr = -1
                next
            }
            table_seen := false
            z_tname := [U8]?{None}
            err_ofst := 0
            if a.exprs[e].op == tk.TK_DOT {
                z_tname = a.exprs[a.exprs[e].left].token.copy()
                err_ofst = a.exprs[right].w
            } else {
                err_ofst = a.exprs[e].w
            }
            loop i in 0..<n_src {
                si: ast.src_item(a, tab_list, i)
                tb: a.items[si].tab
                z_tab_name: a.items[si].alias ?? p.db.tables[tb].name.copy()
                if p.db.malloc_failed -> break
                nested_from := -1
                z_schema_name := [U8]?{None}
                if a.items[si].is_nested_from {
                    nested_from = a.selects[a.items[si].select].elist
                } else {
                    if z_tname != None && util.str_icmp(z_tname ?? [U8]{}, z_tab_name) != 0 -> next
                    i_db: conn.schema_to_index(p.db, p.db.tables[tb].schema)
                    z_schema_name = Val(if i_db >= 0 -> p.db.dbs[i_db].name.copy() else -> "*".bytes())
                }
                using := -1
                if i + 1 < n_src && nested {
                    nx: ast.src_item(a, tab_list, i + 1)
                    if a.items[nx].is_using {
                        using = a.items[nx].u3
                        loop ii in 0..<a.idlists[using].items.len() {
                            zu: a.idlists[using].items[ii].name ?? [U8]{}
                            r: ast.expr_alloc(a, tk.TK_ID, Val(zu), false)
                            ast.expr_set_error_offset(a, r, err_ofst)
                            nw = ast.expr_list_append(a, nw, r)
                            last: a.lists[nw].items.len() - 1
                            a.lists[nw].items[last].ename = Val(join_bytes([[U8]]{[U8]{}, [U8]{}, zu}, U8{46}))
                            a.lists[nw].items[last].eename = ast.ENAME_TAB
                            a.lists[nw].items[last].using_term = true
                        }
                    }
                }
                n_col: p.db.tables[tb].cols.len()
                n_add: if cat.visible_rowid(p.db, tb) && nested -> n_col + 1 else -> n_col
                loop j in 0..<n_add {
                    z_name := [U8]{}
                    if j == n_col {
                        ra: ex.rowid_alias(p.db, tb)
                        if ra == .Val(r) {
                            z_name = r.copy()
                        } else {
                            next
                        }
                    } else {
                        col: p.db.tables[tb].cols[j]
                        z_name = col.name.copy()
                        if nested_from >= 0 && a.lists[nested_from].items[j].eename == ast.ENAME_ROWID -> next
                        if z_tname != None && nested_from >= 0 && rs.match_ename(a.lists[nested_from].items[j], None, z_tname, None, false) == 0 -> next
                        if a.selects[s].sel_flags.bit_and(ast.SF_INCLUDE_HIDDEN) == 0 && is_hidden_column(col) -> next
                        if col.col_flags.bit_and(conn.COLFLAG_NOEXPAND) != 0 && z_tname == None && !nested -> next
                    }
                    table_seen = true
                    if i > 0 && z_tname == None && !nested && a.items[si].is_using && ast.id_list_index(a, a.items[si].u3, z_name) >= 0 {
                        // A USING column of the right-hand table is left out.
                        next
                    }
                    r: ast.expr_alloc(a, tk.TK_ID, Val(z_name), false)
                    pe := r
                    if (n_src > 1 && (a.items[si].jointype.bit_and(ast.JT_LTORJ) == 0 || nested || !in_any_using_clause(a, z_name, tab_list, i, n_src - i - 1))) || ast.in_rename(a) {
                        l: ast.expr_alloc(a, tk.TK_ID, Val(z_tab_name), false)
                        pe = ast.pexpr(a, tk.TK_DOT, l, r)
                        if ast.in_rename(a) && a.exprs[e].left >= 0 -> cg.rename_token_remap(p, cg.RENAME_EXPR, l, cg.RENAME_EXPR, a.exprs[e].left)
                        if z_schema_name == .Val(zs) {
                            l2: ast.expr_alloc(a, tk.TK_ID, Val(zs), false)
                            pe = ast.pexpr(a, tk.TK_DOT, l2, pe)
                        }
                    }
                    ast.expr_set_error_offset(a, pe, err_ofst)
                    nw = ast.expr_list_append(a, nw, pe)
                    last: a.lists[nw].items.len() - 1
                    if nested && !ast.in_rename(a) {
                        if nested_from >= 0 {
                            a.lists[nw].items[last].ename = a.lists[nested_from].items[j].ename.copy()
                        } else {
                            a.lists[nw].items[last].ename = Val(join_bytes([[U8]]{z_schema_name ?? [U8]{}, z_tab_name, z_name}, U8{46}))
                        }
                        a.lists[nw].items[last].eename = if j == n_col -> ast.ENAME_ROWID else -> ast.ENAME_TAB
                        in_using: a.items[si].is_using && ast.id_list_index(a, a.items[si].u3, z_name) >= 0
                        in_next_using: using >= 0 && ast.id_list_index(a, using, z_name) >= 0
                        no_expand_col: j < n_col && p.db.tables[tb].cols[j].col_flags.bit_and(conn.COLFLAG_NOEXPAND) != 0
                        if in_using || in_next_using || no_expand_col -> a.lists[nw].items[last].no_expand = true
                    } else if long_names {
                        a.lists[nw].items[last].ename = Val(join_bytes([[U8]]{z_tab_name, z_name}, U8{46}))
                        a.lists[nw].items[last].eename = ast.ENAME_NAME
                    } else {
                        a.lists[nw].items[last].ename = Val(z_name)
                        a.lists[nw].items[last].eename = ast.ENAME_NAME
                    }
                }
            }
            if !table_seen {
                if z_tname == .Val(zt) {
                    ast.error(a, "no such table: {ast.text(zt)}")
                } else {
                    ast.error(a, "no tables specified")
                }
            }
        }
        ast.expr_list_delete(a, elist)
        a.selects[s].elist = nw
    }
    el: a.selects[s].elist
    if el >= 0 {
        if ast.list_len(a, el) > a.limits[ast.LIMIT_COLUMN] {
            ast.error(a, "too many columns in result set")
            return ast.WRC_ABORT
        }
        if elist_flags.bit_and(ast.EP_HAS_FUNC.bit_or(ast.EP_SUBQUERY)) != 0 -> a.selects[s].sel_flags = a.selects[s].sel_flags.bit_or(ast.SF_COMPLEX_RESULT)
    }
    ast.WRC_CONTINUE
}

// The sqlite3SelectExpand walker: selectExpander, then sqlite3SelectPopWith.
ExpanderWalker: struct {
    unused: Int

    impl WalkCb {
        on_expr: fn(self, p: &cg.Parse, a: &ast.AST, e: Int) -[DB]> Int Never! { ast.WRC_CONTINUE }
        has_select: fn(self) -[]> Bool Never! { true }
        on_select: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) -[DB]> Int Never! { select_expander(p, a, s) }
        has_select2: fn(self) -[]> Bool Never! { true }
        on_select2: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) Never! -[DB]> { select_pop_with(a, s) }
        win_defn: fn(self) -[]> Bool Never! { true }
    }
}

// sqlite3SelectExpand: SELECT s and its subqueries expanded.
select_expand: fn(p: &cg.Parse, a: &ast.AST, s: Int) Never! -[DB]> {
    if a.ctx.has_compound {
        cw := ConvertCompoundWalker{unused: 0}
        _: ast.walk_select<ConvertCompoundWalker>(cw, a, s)
    }
    w := ExpanderWalker{unused: 0}
    cg.walk_push(p, w, 0)
    _: cg.pwalk_select(p, a, s)
    _: cg.walk_pop(p)
}

// The sqlite3SelectAddTypeInfo walker: selectAddSubqueryTypeInfo after
// each SELECT's subtrees.
TypeInfoWalker: struct {
    unused: Int

    impl WalkCb {
        on_expr: fn(self, p: &cg.Parse, a: &ast.AST, e: Int) -[DB]> Int Never! { ast.WRC_CONTINUE }
        has_select: fn(self) -[]> Bool Never! { true }
        on_select: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) -[DB]> Int Never! { ast.WRC_CONTINUE }
        has_select2: fn(self) -[]> Bool Never! { true }
        on_select2: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) Never! -[DB]> { select_add_subquery_type_info(p, a, s) }
        win_defn: fn(self) -[]> Bool Never! { false }
    }
}

// selectAddSubqueryTypeInfo: the column types of the FROM subqueries'
// tables of s, once name resolution is done.
select_add_subquery_type_info: fn(p: &cg.Parse, a: &ast.AST, s: Int) Never! {
    if a.selects[s].sel_flags.bit_and(ast.SF_HAS_TYPE_INFO) != 0 -> return
    a.selects[s].sel_flags = a.selects[s].sel_flags.bit_or(ast.SF_HAS_TYPE_INFO)
    src: a.selects[s].src
    loop i in 0..<ast.src_len(a, src) {
        si: ast.src_item(a, src, i)
        tb: a.items[si].tab
        if p.db.tables[tb].tab_flags.bit_and(ast.TF_EPHEMERAL) != 0 {
            sel: a.items[si].select
            if sel >= 0 -> subquery_column_types(p, a, tb, sel, base.AFF_NONE)
        }
    }
}

// sqlite3SelectPrep: SELECT s expanded, its names resolved (in outer_nc,
// -1 for none) and its subqueries' column types set.
select_prep: fn(p: &cg.Parse, a: &ast.AST, s: Int, outer_nc: Int) Never! -[DB]> {
    if p.db.malloc_failed -> return
    if a.selects[s].sel_flags.bit_and(ast.SF_HAS_TYPE_INFO) != 0 -> return
    select_expand(p, a, s)
    if cg.n_err(a) != 0 -> return
    rs.resolve_select_names(p, a, s, outer_nc)
    if cg.n_err(a) != 0 -> return
    w := TypeInfoWalker{unused: 0}
    cg.walk_push(p, w, 0)
    _: cg.pwalk_select(p, a, s)
    _: cg.walk_pop(p)
}

// ---------------------------------------------------------------------------
// Aggregate code.

// analyzeAggFuncArgs: the columns the arguments (and ORDER BY and FILTER)
// of the aggregate functions of AggInfo ai use, under NameContext nc.
analyze_agg_func_args: fn(p: &cg.Parse, a: &ast.AST, ai: Int, nc: Int) Never! -[DB]> {
    p.ncs[nc].nc_flags = p.ncs[nc].nc_flags.bit_or(ast.NC_IN_AGG_FUNC)
    loop i in 0..<p.aggs[ai].funcs.len() {
        e: p.aggs[ai].funcs[i].f_expr
        ex.expr_analyze_agg_list(p, a, nc, a.exprs[e].x)
        l: a.exprs[e].left
        if l >= 0 -> ex.expr_analyze_agg_list(p, a, nc, a.exprs[l].x)
        if ast.has(a, e, ast.EP_WIN_FUNC) -> ex.expr_analyze_aggregates(p, a, nc, a.windows[a.exprs[e].y].filter)
    }
    p.ncs[nc].nc_flags = util.clear_bits(p.ncs[nc].nc_flags, ast.NC_IN_AGG_FUNC)
}

// optimizeAggregateUseOfIndexedExpr: the AggInfo columns past the
// accumulator ones recomputed, the sorter wide enough for the indexed
// expressions.
optimize_aggregate_use_of_indexed_expr: fn(p: &cg.Parse, a: &ast.AST, s: Int, ai: Int, nc: Int) Never! -[DB]> {
    n_acc: p.aggs[ai].n_accumulator
    loop p.aggs[ai].cols.len() > n_acc -> _: p.aggs[ai].cols.pop()
    if p.aggs[ai].n_sorting_column > 0 {
        mx := ast.list_len(a, a.selects[s].group_by) - 1
        loop j in 0..<p.aggs[ai].cols.len() {
            k: p.aggs[ai].cols[j].i_sorter_column
            if k > mx -> mx = k
        }
        p.aggs[ai].n_sorting_column = mx + 1
    }
    analyze_agg_func_args(p, a, ai, nc)
}

// aggregateIdxEprRefToColCallback: a node of an aggregate's argument that
// an indexed expression computes reads its AggInfo column.
IdxEprRefWalker: struct {
    unused: Int

    impl WalkCb {
        on_expr: fn(self, p: &cg.Parse, a: &ast.AST, e: Int) -[DB]> Int Never! {
            ai: a.exprs[e].agg_info
            if ai < 0 -> return ast.WRC_CONTINUE
            op: a.exprs[e].op
            if op == tk.TK_AGG_COLUMN || op == tk.TK_AGG_FUNCTION || op == tk.TK_IF_NULL_ROW -> return ast.WRC_CONTINUE
            iagg: a.exprs[e].iagg
            if iagg >= p.aggs[ai].cols.len() -> return ast.WRC_CONTINUE
            col: p.aggs[ai].cols[iagg]
            a.exprs[e].op = tk.TK_AGG_COLUMN
            a.exprs[e].itable = col.itable
            a.exprs[e].icolumn = col.icolumn
            ast.clear_flags(a, e, ast.EP_SKIP.bit_or(ast.EP_COLLATE).bit_or(ast.EP_UNLIKELY))
            ast.WRC_PRUNE
        }
        has_select: fn(self) -[]> Bool Never! { false }
        on_select: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) -[DB]> Int Never! { ast.WRC_CONTINUE }
        has_select2: fn(self) -[]> Bool Never! { false }
        on_select2: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) Never! -[DB]> {}
        win_defn: fn(self) -[]> Bool Never! { false }
    }
}

// aggregateConvertIndexedExprRefToColumn.
aggregate_convert_indexed_expr_ref_to_column: fn(p: &cg.Parse, a: &ast.AST, ai: Int) Never! -[DB]> {
    w := IdxEprRefWalker{unused: 0}
    cg.walk_push(p, w, 0)
    loop i in 0..<p.aggs[ai].funcs.len() {
        fe: p.aggs[ai].funcs[i].f_expr
        _: cg.pwalk_expr(p, a, fe)
    }
    _: cg.walk_pop(p)
}

// assignAggregateRegisters: one register per AggInfo column and function,
// from iFirstReg.
assign_aggregate_registers: fn(p: &cg.Parse, ai: Int) Never! {
    p.aggs[ai].i_first_reg = p.f.n_mem + 1
    p.f.n_mem += p.aggs[ai].cols.len() + p.aggs[ai].funcs.len()
}

// resetAccumulator: the accumulator registers set to NULL, with the
// DISTINCT and ORDER BY tables of the aggregates opened.
reset_accumulator: fn(p: &cg.Parse, a: &ast.AST, ai: Int) Never! -[DB]> {
    n_reg: p.aggs[ai].funcs.len() + p.aggs[ai].cols.len()
    if n_reg == 0 -> return
    if cg.n_err(a) != 0 -> return
    first: p.aggs[ai].i_first_reg
    _: cg.op3(p, opc.OP_NULL, 0, first, first + n_reg - 1)
    loop i in 0..<p.aggs[ai].funcs.len() {
        fe: p.aggs[ai].funcs[i].f_expr
        args: a.exprs[fe].x
        if p.aggs[ai].funcs[i].i_distinct >= 0 {
            if args < 0 || ast.list_len(a, args) != 1 {
                ast.error(a, "DISTINCT aggregates must have exactly one argument")
                p.aggs[ai].funcs[i].i_distinct = -1
            } else {
                ki: wn.key_info_from_expr_list(p, a, args, 0, 0)
                addr: cg.op4(p, opc.OP_OPEN_EPHEMERAL, p.aggs[ai].funcs[i].i_distinct, 0, 0, conn.P4.KeyInfo(ki))
                p.aggs[ai].funcs[i].i_dist_addr = addr
                if a.ctx.explain == 2 {
                    fname: ast.text(p.aggs[ai].funcs[i].func.name)
                    _: cg.explain(p, a, false, "USE TEMP B-TREE FOR {fname}(DISTINCT)")
                }
            }
        }
        if p.aggs[ai].funcs[i].i_ob_tab >= 0 {
            f: p.aggs[ai].funcs[i].copy()
            ob_list: a.exprs[a.exprs[fe].left].x
            n_extra := 0
            if !f.b_ob_unique -> n_extra += 1
            if f.b_ob_payload -> n_extra += ast.list_len(a, args)
            if f.b_use_subtype -> n_extra += ast.list_len(a, args)
            ki := wn.key_info_from_expr_list(p, a, ob_list, 0, n_extra)
            if !f.b_ob_unique && cg.n_err(a) == 0 -> ki.n_key_field += 1
            _: cg.op4(p, opc.OP_OPEN_EPHEMERAL, f.i_ob_tab, ast.list_len(a, ob_list) + n_extra, 0, conn.P4.KeyInfo(ki))
            if a.ctx.explain == 2 -> _: cg.explain(p, a, false, "USE TEMP B-TREE FOR {ast.text(f.func.name)}(ORDER BY)")
        }
    }
}

// finalizeAggFunctions: OP_AggFinal for each aggregate, after the deferred
// OP_AggStep calls, in ORDER BY order, of an ORDER BY aggregate.
finalize_agg_functions: fn(p: &cg.Parse, a: &ast.AST, ai: Int) Never! -[DB]> {
    loop i in 0..<p.aggs[ai].funcs.len() {
        f: p.aggs[ai].funcs[i].copy()
        list: a.exprs[f.f_expr].x
        func_reg: p.aggs[ai].i_first_reg + p.aggs[ai].cols.len() + i
        if f.i_ob_tab >= 0 {
            n_arg: ast.list_len(a, list)
            reg_agg: cg.get_temp_range(p, n_arg)
            n_key := 0
            if f.b_ob_payload {
                n_key = ast.list_len(a, a.exprs[a.exprs[f.f_expr].left].x)
                if !f.b_ob_unique -> n_key += 1
            }
            i_top: cg.op1(p, opc.OP_REWIND, f.i_ob_tab)
            j := n_arg - 1
            loop j >= 0 {
                _: cg.op3(p, opc.OP_COLUMN, f.i_ob_tab, n_key + j, reg_agg + j)
                j -= 1
            }
            if f.b_use_subtype {
                reg_subtype: cg.get_temp_reg(p)
                i_base_col: n_key + n_arg + (if !f.b_ob_payload && !f.b_ob_unique -> 1 else -> 0)
                j = n_arg - 1
                loop j >= 0 {
                    _: cg.op3(p, opc.OP_COLUMN, f.i_ob_tab, i_base_col + j, reg_subtype)
                    _: cg.op2(p, opc.OP_SET_SUBTYPE, reg_subtype, reg_agg + j)
                    j -= 1
                }
                cg.release_temp_reg(p, reg_subtype)
            }
            _: cg.op3(p, opc.OP_AGG_STEP, 0, reg_agg, func_reg)
            cg.v_append_p4(p, conn.P4.FuncDef(f.func))
            cg.v_change_p5(p, n_arg.bit_and(255))
            _: cg.op2(p, opc.OP_NEXT, f.i_ob_tab, i_top + 1)
            cg.v_jump_here(p, i_top)
            cg.release_temp_range(p, reg_agg, n_arg)
        }
        _: cg.op2(p, opc.OP_AGG_FINAL, func_reg, ast.list_len(a, list))
        cg.v_append_p4(p, conn.P4.FuncDef(f.func))
    }
}

// updateAccumulator: the accumulators of AggInfo ai updated from the
// current row; with reg_acc (and no min() or max()) the accumulator
// columns load only while reg_acc holds 0.
update_accumulator: fn(p: &cg.Parse, a: &ast.AST, reg_acc: Int, ai: Int, e_distinct_type: Int) Never! -[DB]> {
    if cg.n_err(a) != 0 -> return
    reg_hit := 0
    addr_hit_test := 0
    p.aggs[ai].direct_mode = true
    n_acc: p.aggs[ai].n_accumulator
    loop i in 0..<p.aggs[ai].funcs.len() {
        f: p.aggs[ai].funcs[i].copy()
        fe: f.f_expr
        list: a.exprs[fe].x
        addr_next := 0
        n_arg := 0
        reg_agg := 0
        reg_agg_sz := 0
        reg_distinct := 0
        if ast.has(a, fe, ast.EP_WIN_FUNC) {
            filter: a.windows[a.exprs[fe].y].filter
            if n_acc != 0 && f.func.flags.bit_and(conn.FUNC_NEEDCOLL) != 0 && reg_acc != 0 {
                if reg_hit == 0 {
                    p.f.n_mem += 1
                    reg_hit = p.f.n_mem
                }
                _: cg.op2(p, opc.OP_COPY, reg_acc, reg_hit)
            }
            addr_next = cg.v_make_label(p)
            ex.expr_if_false(p, a, filter, addr_next, cg.JUMPIFNULL)
        }
        if f.i_ob_tab >= 0 {
            // The arguments go to the ORDER BY table instead.
            n_arg = ast.list_len(a, list)
            ob_list: a.exprs[a.exprs[fe].left].x
            reg_agg_sz = ast.list_len(a, ob_list)
            if !f.b_ob_unique -> reg_agg_sz += 1
            if f.b_ob_payload -> reg_agg_sz += n_arg
            if f.b_use_subtype -> reg_agg_sz += n_arg
            reg_agg_sz += 1
            reg_agg = cg.get_temp_range(p, reg_agg_sz)
            reg_distinct = reg_agg
            _: ex.expr_code_expr_list(p, a, ob_list, reg_agg, 0, cg.ECEL_DUP)
            jj := ast.list_len(a, ob_list)
            if !f.b_ob_unique {
                _: cg.op2(p, opc.OP_SEQUENCE, f.i_ob_tab, reg_agg + jj)
                jj += 1
            }
            if f.b_ob_payload {
                reg_distinct = reg_agg + jj
                _: ex.expr_code_expr_list(p, a, list, reg_distinct, 0, cg.ECEL_DUP)
                jj += n_arg
            }
            if f.b_use_subtype {
                reg_base: if f.b_ob_payload -> reg_distinct else -> reg_agg
                loop kk in 0..<n_arg {
                    _: cg.op2(p, opc.OP_GET_SUBTYPE, reg_base + kk, reg_agg + jj)
                    jj += 1
                }
            }
        } else if list >= 0 {
            n_arg = ast.list_len(a, list)
            reg_agg = cg.get_temp_range(p, n_arg)
            reg_distinct = reg_agg
            _: ex.expr_code_expr_list(p, a, list, reg_agg, 0, cg.ECEL_DUP)
        }
        if f.i_distinct >= 0 && list >= 0 {
            if addr_next == 0 -> addr_next = cg.v_make_label(p)
            d: code_distinct(p, a, e_distinct_type, f.i_distinct, addr_next, list, reg_distinct)
            p.aggs[ai].funcs[i].i_distinct = d
        }
        if f.i_ob_tab >= 0 {
            _: cg.op3(p, opc.OP_MAKE_RECORD, reg_agg, reg_agg_sz - 1, reg_agg + reg_agg_sz - 1)
            _: cg.op4_int(p, opc.OP_IDX_INSERT, f.i_ob_tab, reg_agg + reg_agg_sz - 1, reg_agg, reg_agg_sz - 1)
            cg.release_temp_range(p, reg_agg, reg_agg_sz)
        } else {
            if f.func.flags.bit_and(conn.FUNC_NEEDCOLL) != 0 {
                coll := -1
                j := 0
                loop coll < 0 && j < n_arg {
                    lj: ast.list_expr(a, list, j)
                    coll = ex.expr_coll_seq(p, a, lj)
                    j += 1
                }
                if coll < 0 -> coll = record.COLL_BINARY
                if reg_hit == 0 && n_acc != 0 {
                    p.f.n_mem += 1
                    reg_hit = p.f.n_mem
                }
                _: cg.op4(p, opc.OP_COLL_SEQ, reg_hit, 0, 0, conn.P4.Coll(coll))
            }
            _: cg.op3(p, opc.OP_AGG_STEP, 0, reg_agg, p.aggs[ai].i_first_reg + p.aggs[ai].cols.len() + i)
            cg.v_append_p4(p, conn.P4.FuncDef(f.func))
            cg.v_change_p5(p, n_arg.bit_and(255))
            cg.release_temp_range(p, reg_agg, n_arg)
        }
        if addr_next != 0 -> cg.v_resolve_label(p, addr_next)
    }
    if reg_hit == 0 && n_acc != 0 -> reg_hit = reg_acc
    if reg_hit != 0 -> addr_hit_test = cg.op1(p, opc.OP_IF, reg_hit)
    loop i in 0..<n_acc {
        ce: p.aggs[ai].cols[i].c_expr
        _: ex.expr_code(p, a, ce, p.aggs[ai].i_first_reg + i)
    }
    p.aggs[ai].direct_mode = false
    if addr_hit_test != 0 -> cg.v_jump_here_or_pop_inst(p, addr_hit_test)
}

// explainSimpleCount: the plan line of "SELECT count(*) FROM t" (through
// index ix, or -1).
explain_simple_count: fn(p: &cg.Parse, a: ast.AST, t: Int, ix: Int) Never! {
    if a.ctx.explain != 2 -> return
    cover: ix >= 0 && (ex.has_rowid(p.db, t) || p.db.indexes[ix].idx_type != ast.IDXTYPE_PRIMARYKEY)
    tail: if cover -> " USING COVERING INDEX {ast.text(p.db.indexes[ix].name)}" else -> ""
    tname: ast.text(p.db.tables[t].name)
    _: cg.explain(p, a, false, "SCAN {tname}{tail}")
}

// havingToWhereExprCb: a HAVING term of constants and GROUP BY terms
// moves to the WHERE of SELECT u, a "1" taking its place; e_code says one
// moved.
HavingToWhereWalker: struct {
    unused: Int

    impl WalkCb {
        on_expr: fn(self, p: &cg.Parse, a: &ast.AST, e: Int) -[DB]> Int Never! {
            if a.exprs[e].op == tk.TK_AND -> return ast.WRC_CONTINUE
            t: cg.walk_top(p)
            s: p.walks[t].u
            gb: a.selects[s].group_by
            if ex.expr_is_constant_or_group_by(p, a, e, gb) && !ast.always_false(a, e) && a.exprs[e].agg_info < 0 {
                nw: ast.expr_alloc(a, tk.TK_INTEGER, Val("1".bytes()), false)
                // SWAP(Expr, *pNew, *pExpr): the term moves to nw's slot.
                tmp: a.exprs[nw].copy()
                a.exprs[nw] = a.exprs[e].copy()
                a.exprs[e] = tmp
                w: ast.expr_and(a, a.selects[s].where_expr, nw)
                a.selects[s].where_expr = w
                p.walks[t].e_code = 1
            }
            ast.WRC_PRUNE
        }
        has_select: fn(self) -[]> Bool Never! { false }
        on_select: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) -[DB]> Int Never! { ast.WRC_CONTINUE }
        has_select2: fn(self) -[]> Bool Never! { false }
        on_select2: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) Never! -[DB]> {}
        win_defn: fn(self) -[]> Bool Never! { false }
    }
}

// havingToWhere.
having_to_where: fn(p: &cg.Parse, a: &ast.AST, s: Int) Never! -[DB]> {
    w := HavingToWhereWalker{unused: 0}
    cg.walk_push(p, w, s)
    _: cg.pwalk_expr(p, a, a.selects[s].having)
    _: cg.walk_pop(p)
}

// isSelfJoinView: an earlier-coded FROM item (among i_first..<i_end of
// tab_list) that is the same view as item this_si, or -1.
is_self_join_view: fn(db: conn.Conn, a: ast.AST, tab_list: Int, this_si: Int, i_first: Int, i_end: Int) -> Int Never! {
    this_sel: a.items[this_si].select
    if a.selects[this_sel].sel_flags.bit_and(ast.SF_PUSH_DOWN) != 0 -> return -1
    this_schema: db.tables[a.items[this_si].tab].schema
    loop k in i_first..<i_end {
        ki: ast.src_item(a, tab_list, k)
        s1: a.items[ki].select
        if s1 < 0 || a.items[ki].via_coroutine || a.items[ki].name == None -> next
        schema: db.tables[a.items[ki].tab].schema
        if schema != this_schema -> next
        if util.str_icmp_opt(a.items[ki].name, a.items[this_si].name) != 0 -> next
        // The flattener left two CTE tables of the one name.
        if schema < 0 && a.selects[this_sel].sel_id != a.selects[s1].sel_id -> next
        if a.selects[s1].sel_flags.bit_and(ast.SF_PUSH_DOWN) != 0 -> next
        return ki
    }
    -1
}

// countOfViewOptimization: "SELECT count(*) FROM (a UNION ALL b ..)"
// becomes "SELECT (SELECT count(*) FROM a) + (SELECT count(*) FROM b) ..";
// whether it did.
count_of_view_optimization: fn(p: &cg.Parse, a: &ast.AST, s: Int) -> Bool Never! {
    if a.selects[s].sel_flags.bit_and(ast.SF_AGGREGATE) == 0 -> return false
    elist: a.selects[s].elist
    if ast.list_len(a, elist) != 1 -> return false
    if a.selects[s].where_expr >= 0 || a.selects[s].having >= 0 || a.selects[s].group_by >= 0 || a.selects[s].order_by >= 0 -> return false
    count: ast.list_expr(a, elist, 0)
    if a.exprs[count].op != tk.TK_AGG_FUNCTION -> return false
    if util.str_icmp_opt(a.exprs[count].token, Val("count".bytes())) != 0 -> return false
    if a.exprs[count].x >= 0 -> return false
    src: a.selects[s].src
    if ast.src_len(a, src) != 1 -> return false
    if ast.has(a, count, ast.EP_WIN_FUNC) -> return false
    si: ast.src_item(a, src, 0)
    sub0: a.items[si].select
    if sub0 < 0 -> return false
    if a.selects[sub0].prior < 0 -> return false
    if a.selects[sub0].sel_flags.bit_and(ast.SF_COPY_CTE) != 0 -> return false
    sub := sub0
    loop sub >= 0 {
        if a.selects[sub].op != tk.TK_ALL && a.selects[sub].prior >= 0 -> return false
        if a.selects[sub].where_expr >= 0 || a.selects[sub].limit >= 0 -> return false
        if a.selects[sub].sel_flags.bit_and(ast.SF_AGGREGATE) != 0 -> return false
        sub = a.selects[sub].prior
    }
    a.items[si].select = -1
    ast.src_list_delete(a, src)
    a.selects[s].src = ast.new_src_list(a)
    e := -1
    sub = sub0
    loop sub >= 0 {
        prior: a.selects[sub].prior
        a.selects[sub].prior = -1
        a.selects[sub].next_sel = -1
        a.selects[sub].sel_flags = util.clear_bits(a.selects[sub].sel_flags.bit_or(ast.SF_AGGREGATE), ast.SF_COMPOUND)
        a.selects[sub].nselect_row = 0
        term0: if prior >= 0 -> ast.expr_dup(a, count, 0) else -> count
        el: ast.expr_list_append(a, -1, term0)
        a.selects[sub].elist = el
        term: ast.pexpr(a, tk.TK_SELECT, -1, -1)
        ast.pexpr_add_select(a, term, sub)
        if e < 0 {
            e = term
        } else {
            e = ast.pexpr(a, tk.TK_PLUS, term, e)
        }
        sub = prior
    }
    a.lists[elist].items[0].expr = e
    a.selects[s].sel_flags = util.clear_bits(a.selects[s].sel_flags, ast.SF_AGGREGATE)
    true
}

// sameSrcAlias: whether an item of src (or of an SF_NESTED_FROM subquery)
// other than si0 has its table and alias.
same_src_alias: fn(a: ast.AST, si0: Int, src: Int) -> Bool Never! {
    loop i in 0..<ast.src_len(a, src) {
        si1: ast.src_item(a, src, i)
        if si1 == si0 -> next
        if a.items[si0].tab == a.items[si1].tab && util.str_icmp_opt(a.items[si0].alias, a.items[si1].alias) == 0 -> return true
        s1: a.items[si1].select
        if s1 >= 0 && a.selects[s1].sel_flags.bit_and(ast.SF_NESTED_FROM) != 0 && same_src_alias(a, si0, a.selects[s1].src) -> return true
    }
    false
}

// fromClauseTermCanBeCoroutine: whether subquery FROM item i of tab_list
// can be a co-routine (the conditions select.c lists).
from_clause_term_can_be_coroutine: fn(p: cg.Parse, a: ast.AST, tab_list: Int, i0: Int, sel_flags: Int) -> Bool Never! {
    si: ast.src_item(a, tab_list, i0)
    if a.items[si].is_cte {
        cu: a.cte_uses[a.items[si].u2]
        if cu.m10d == ast.M10D_YES -> return false
        if cu.nuse >= 2 && cu.m10d != ast.M10D_NO -> return false
    }
    if a.items[ast.src_item(a, tab_list, 0)].jointype.bit_and(ast.JT_LTORJ) != 0 -> return false
    if cg.opt_disabled(p, cg.OPT_COROUTINES) -> return false
    n_src: ast.src_len(a, tab_list)
    if is_self_join_view(p.db, a, tab_list, si, i0 + 1, n_src) >= 0 -> return false
    if i0 == 0 {
        if n_src == 1 -> return true
        if a.items[ast.src_item(a, tab_list, 1)].jointype.bit_and(ast.JT_CROSS) != 0 -> return true
        if sel_flags.bit_and(ast.SF_UPDATE_FROM) != 0 -> return false
        return true
    }
    if sel_flags.bit_and(ast.SF_UPDATE_FROM) != 0 -> return false
    i := i0
    loop {
        ti: ast.src_item(a, tab_list, i)
        if a.items[ti].jointype.bit_and(ast.JT_OUTER.bit_or(ast.JT_CROSS)) != 0 -> return false
        if i == 0 -> break
        i -= 1
        if a.items[ast.src_item(a, tab_list, i)].select >= 0 -> return false
    }
    true
}

// ---------------------------------------------------------------------------
// sqlite3Select. Its `goto select_end` is a return from select_body, after
// which select pops the EXPLAIN QUERY PLAN level (the compound case pops
// only for its right-most SELECT, as C returns early there) and drops the
// aggregate NameContext the body pushed. pMinMaxOrderBy and the AggInfo
// live in the arena and p.aggs until the statement ends.

// The join strength reduction of FROM term i of SELECT s, once its WHERE
// shows the term cannot be the NULL row of its join.
simplify_join: fn(a: &ast.AST, s: Int, i: Int) Never! {
    tab_list: a.selects[s].src
    w: a.selects[s].where_expr
    si: ast.src_item(a, tab_list, i)
    jt: a.items[si].jointype
    if jt.bit_and(ast.JT_LEFT) != 0 {
        if jt.bit_and(ast.JT_RIGHT) != 0 {
            a.items[si].jointype = util.clear_bits(jt, ast.JT_LEFT)
        } else {
            a.items[si].jointype = util.clear_bits(jt, ast.JT_LEFT.bit_or(ast.JT_OUTER))
            unset_join_expr(a, w, a.items[si].cursor, false)
        }
    }
    if jt.bit_and(ast.JT_LTORJ) == 0 -> return
    n: ast.src_len(a, tab_list)
    loop j in (i + 1)..<n {
        sj: ast.src_item(a, tab_list, j)
        jj: a.items[sj].jointype
        if jj.bit_and(ast.JT_RIGHT) == 0 -> next
        if jj.bit_and(ast.JT_LEFT) != 0 {
            a.items[sj].jointype = util.clear_bits(jj, ast.JT_RIGHT)
        } else {
            a.items[sj].jointype = util.clear_bits(jj, ast.JT_RIGHT.bit_or(ast.JT_OUTER))
            unset_join_expr(a, w, a.items[sj].cursor, true)
        }
    }
    j := n - 1
    loop j >= 0 {
        sj: ast.src_item(a, tab_list, j)
        a.items[sj].jointype = util.clear_bits(a.items[sj].jointype, ast.JT_LTORJ)
        if a.items[sj].jointype.bit_and(ast.JT_RIGHT) != 0 -> break
        j -= 1
    }
}

// One pass of sqlite3Select's first FROM loop over term i of SELECT s: the
// join simplification, then the ORDER BY removal and flattening of a
// subquery term. The next term to look at (0 after a flattening, which
// restarts the loop), or -1 on error.
simplify_from_term: fn(p: &cg.Parse, a: &ast.AST, s: Int, i: Int, is_agg: Bool, e_dest: Int, sort: &SortCtx) -[DB]> Int Never! {
    tab_list: a.selects[s].src
    si: ast.src_item(a, tab_list, i)
    jt: a.items[si].jointype
    if jt.bit_and(ast.JT_LEFT.bit_or(ast.JT_LTORJ)) != 0 {
        cursor: a.items[si].cursor
        w: a.selects[s].where_expr
        non_null: ex.expr_implies_non_null_row(p, a, w, cursor, jt.bit_and(ast.JT_LTORJ) != 0)
        if non_null && cg.opt_enabled(p, cg.OPT_SIMPLIFY_JOIN) -> simplify_join(a, s, i)
    }
    sub: a.items[si].select
    if sub < 0 -> return i + 1
    t: a.items[si].tab
    n_col: p.db.tables[t].cols.len()
    n_sub: ast.list_len(a, a.selects[sub].elist)
    if n_col != n_sub {
        ast.error(a, "expected {n_col} columns for '{ast.text(p.db.tables[t].name)}' but got {n_sub}")
        return 0 - 1
    }
    if a.items[si].is_cte && a.cte_uses[a.items[si].u2].m10d == ast.M10D_YES -> return i + 1
    if a.selects[sub].sel_flags.bit_and(ast.SF_AGGREGATE) != 0 -> return i + 1
    sel_flags: a.selects[s].sel_flags
    n_src: ast.src_len(a, tab_list)
    if a.selects[sub].order_by >= 0 && (a.selects[s].order_by >= 0 || n_src > 1) && a.selects[sub].limit < 0 && a.selects[sub].sel_flags.bit_and(ast.SF_ORDER_BY_REQD) == 0 && sel_flags.bit_and(ast.SF_ORDER_BY_REQD) == 0 && cg.opt_enabled(p, cg.OPT_OMIT_ORDER_BY) {
        a.selects[sub].order_by = -1
    }
    if a.selects[sub].order_by >= 0 && i == 0 && sel_flags.bit_and(ast.SF_COMPLEX_RESULT) != 0 {
        if n_src == 1 || a.items[ast.src_item(a, tab_list, 1)].jointype.bit_and(ast.JT_OUTER.bit_or(ast.JT_CROSS)) != 0 -> return i + 1
    }
    nxt := i + 1
    if flatten_subquery(p, a, s, i, is_agg) {
        if cg.n_err(a) != 0 -> return 0 - 1
        nxt = 0
    }
    if p.db.malloc_failed -> return 0 - 1
    if e_dest > cg.SRT_FIFO -> sort.order_by = a.selects[s].order_by
    nxt
}

// The code of subquery FROM term i (item si, SELECT sub) of SELECT s: a
// co-routine, a reuse of a CTE's or an earlier term's materialization, or
// a materialization into the term's ephemeral table.
code_from_subquery: fn(p: &cg.Parse, a: &ast.AST, s: Int, i: Int, si: Int, sub: Int) Never! -[DB]> {
    tab_list: a.selects[s].src
    t: a.items[si].tab
    if from_clause_term_can_be_coroutine(p, a, tab_list, i, a.selects[s].sel_flags) {
        addr_top: cg.v_current_addr(p) + 1
        p.f.n_mem += 1
        reg: p.f.n_mem
        a.items[si].reg_return = reg
        _: cg.op3(p, opc.OP_INIT_COROUTINE, reg, 0, addr_top)
        a.items[si].addr_fill_sub = addr_top
        d := ex.select_dest_init(cg.SRT_COROUTINE, reg)
        if a.ctx.explain == 2 -> _: cg.explain(p, a, true, "CO-ROUTINE {wh.src_item_text(a, si)}")
        _: select(p, a, sub, d)
        p.db.tables[t].n_row_log_est = a.selects[sub].nselect_row
        a.items[si].via_coroutine = true
        a.items[si].reg_result = d.i_sdst
        cg.v_end_coroutine(p, reg)
        cg.v_jump_here(p, addr_top - 1)
        cg.clear_temp_reg_cache(p)
        return
    }
    if a.items[si].is_cte && a.cte_uses[a.items[si].u2].addr_m9e > 0 {
        cu: a.cte_uses[a.items[si].u2].copy()
        _: cg.op2(p, opc.OP_GOSUB, cu.reg_rtn, cu.addr_m9e)
        if a.items[si].cursor != cu.icur -> _: cg.op2(p, opc.OP_OPEN_DUP, a.items[si].cursor, cu.icur)
        a.selects[sub].nselect_row = cu.nrow_est
        return
    }
    prior: is_self_join_view(p.db, a, tab_list, si, 0, i)
    if prior >= 0 {
        if a.items[prior].addr_fill_sub != 0 -> _: cg.op2(p, opc.OP_GOSUB, a.items[prior].reg_return, a.items[prior].addr_fill_sub)
        _: cg.op2(p, opc.OP_OPEN_DUP, a.items[si].cursor, a.items[prior].cursor)
        a.selects[sub].nselect_row = a.selects[a.items[prior].select].nselect_row
        return
    }
    p.f.n_mem += 1
    reg: p.f.n_mem
    a.items[si].reg_return = reg
    top_addr: cg.op0(p, opc.OP_GOTO)
    a.items[si].addr_fill_sub = top_addr + 1
    a.items[si].is_materialized = true
    once_addr := 0
    if !a.items[si].is_correlated -> once_addr = cg.op0(p, opc.OP_ONCE)
    d := ex.select_dest_init(cg.SRT_EPHEM_TAB, a.items[si].cursor)
    if a.ctx.explain == 2 -> _: cg.explain(p, a, true, "MATERIALIZE {wh.src_item_text(a, si)}")
    _: select(p, a, sub, d)
    p.db.tables[t].n_row_log_est = a.selects[sub].nselect_row
    if once_addr != 0 -> cg.v_jump_here(p, once_addr)
    _: cg.op2(p, opc.OP_RETURN, reg, top_addr + 1)
    cg.v_jump_here(p, top_addr)
    cg.clear_temp_reg_cache(p)
    if a.items[si].is_cte && !a.items[si].is_correlated {
        cu: a.items[si].u2
        a.cte_uses[cu].addr_m9e = a.items[si].addr_fill_sub
        a.cte_uses[cu].reg_rtn = reg
        a.cte_uses[cu].icur = a.items[si].cursor
        a.cte_uses[cu].nrow_est = a.selects[sub].nselect_row
    }
}

// sqlite3Select's second FROM loop: the null READ authorizations of
// tables nothing reads, then the code of every subquery term, after the
// push-down and unused-column optimizations. Whether it failed.
code_from_subqueries: fn(p: &cg.Parse, a: &ast.AST, s: Int) -[DB]> Bool Never! {
    tab_list: a.selects[s].src
    loop i in 0..<ast.src_len(a, tab_list) {
        si: ast.src_item(a, tab_list, i)
        if a.items[si].col_used == 0 && a.items[si].name != None {
            name: a.items[si].name
            database: a.items[si].database
            _: cg.auth_check(p, a, conn.AUTH_READ, name, Val([U8]{}), database)
        }
        sub: a.items[si].select
        if sub < 0 -> next
        p.f.n_height += ast.height_of_select(a, s, 0)
        push_ok := true
        if a.items[si].is_cte {
            cu: a.cte_uses[a.items[si].u2]
            push_ok = cu.m10d != ast.M10D_YES && cu.nuse < 2
        }
        if cg.opt_enabled(p, cg.OPT_PUSH_DOWN) && push_ok -> _: push_down_where_terms(p, a, sub, a.selects[s].where_expr, tab_list, i)
        if cg.opt_enabled(p, cg.OPT_NULL_UNUSED_COLS) -> _: disable_unused_subquery_result_columns(p, a, si)
        saved_auth: p.f.auth_context
        p.f.auth_context = a.items[si].name
        code_from_subquery(p, a, s, i, si, sub)
        if p.db.malloc_failed -> return true
        p.f.n_height -= ast.height_of_select(a, s, 0)
        p.f.auth_context = saved_auth
    }
    false
}

// The GROUP BY aggregate loop of SELECT s (AggInfo ai, NameContext nc):
// the rows in GROUP BY order, from the planner or through a sorter, with
// the output and accumulator-reset subroutines. Whether it failed.
select_group_by: fn(p: &cg.Parse, a: &ast.AST, s: Int, dest: &cg.SelectDest, sort: &SortCtx, distinct: DistinctCtx, ai: Int, nc: Int, order_by_grp: Bool, addr_end: Int, where_e: Int) -[DB]> Bool Never! {
    tab_list: a.selects[s].src
    group_by: a.selects[s].group_by
    having: a.selects[s].having
    n_gb: ast.list_len(a, group_by)
    p_distinct := -1
    dist_flag := 0
    if p.aggs[ai].funcs.len() == 1 && p.aggs[ai].funcs[0].i_distinct >= 0 {
        fe: p.aggs[ai].funcs[0].f_expr
        if fe >= 0 && !ast.has(a, fe, ast.EP_X_IS_SELECT) && a.exprs[fe].x >= 0 {
            arg0: ast.list_expr(a, a.exprs[fe].x, 0)
            e0: ast.expr_dup(a, arg0, 0)
            d0: ast.expr_list_dup(a, group_by, 0)
            p_distinct = ast.expr_list_append(a, d0, e0)
            if p_distinct >= 0 -> dist_flag = cg.WHERE_WANT_DISTINCT.bit_or(cg.WHERE_AGG_DISTINCT)
        }
    }
    p.aggs[ai].sorting_idx = p.f.n_tab
    p.f.n_tab += 1
    ki: wn.key_info_from_expr_list(p, a, group_by, 0, p.aggs[ai].cols.len())
    addr_sorting_idx: cg.op4(p, opc.OP_SORTER_OPEN, p.aggs[ai].sorting_idx, p.aggs[ai].n_sorting_column, 0, conn.P4.KeyInfo(ki.copy()))
    i_use_flag: p.f.n_mem + 1
    i_abort_flag: p.f.n_mem + 2
    reg_output_row: p.f.n_mem + 3
    reg_reset: p.f.n_mem + 4
    p.f.n_mem += 4
    addr_output_row: cg.v_make_label(p)
    addr_reset: cg.v_make_label(p)
    i_amem: p.f.n_mem + 1
    p.f.n_mem += n_gb
    i_bmem: p.f.n_mem + 1
    p.f.n_mem += n_gb
    _: cg.op2(p, opc.OP_INTEGER, 0, i_abort_flag)
    _: cg.op3(p, opc.OP_NULL, 0, i_amem, i_amem + n_gb - 1)
    _: cg.op2(p, opc.OP_GOSUB, reg_reset, addr_reset)
    by: if distinct.is_tnct == 2 -> cg.WHERE_DISTINCTBY else -> cg.WHERE_GROUPBY
    grp: if order_by_grp -> cg.WHERE_SORTBYGROUP else -> 0
    wr := wh.where_begin(p, a, tab_list, where_e, group_by, p_distinct, s, by.bit_or(grp).bit_or(dist_flag), 0)
    if wr == .Val(wi0) {
        wi := wi0
        if p.f.idx_epr >= 0 -> optimize_aggregate_use_of_indexed_expr(p, a, s, ai, nc)
        assign_aggregate_registers(p, ai)
        e_dist: wh.where_is_distinct(wi)
        group_by_sort := false
        sort_ptab := 0
        sort_out := 0
        if wh.where_is_ordered(wi) != n_gb {
            if a.ctx.explain == 2 {
                what: if distinct.is_tnct != 0 && a.selects[s].sel_flags.bit_and(ast.SF_DISTINCT) == 0 -> "DISTINCT" else -> "GROUP BY"
                _: cg.explain(p, a, false, "USE TEMP B-TREE FOR {what}")
            }
            group_by_sort = true
            n_col := n_gb
            j := n_gb
            loop i in 0..<p.aggs[ai].cols.len() {
                if p.aggs[ai].cols[i].i_sorter_column >= j {
                    n_col += 1
                    j += 1
                }
            }
            reg_base: cg.get_temp_range(p, n_col)
            _: ex.expr_code_expr_list(p, a, group_by, reg_base, 0, 0)
            j = n_gb
            p.aggs[ai].direct_mode = true
            loop i in 0..<p.aggs[ai].cols.len() {
                if p.aggs[ai].cols[i].i_sorter_column >= j {
                    ce: p.aggs[ai].cols[i].c_expr
                    ex.expr_code(p, a, ce, j + reg_base)
                    j += 1
                }
            }
            p.aggs[ai].direct_mode = false
            reg_record: cg.get_temp_reg(p)
            _: cg.op3(p, opc.OP_MAKE_RECORD, reg_base, n_col, reg_record)
            _: cg.op2(p, opc.OP_SORTER_INSERT, p.aggs[ai].sorting_idx, reg_record)
            cg.release_temp_reg(p, reg_record)
            cg.release_temp_range(p, reg_base, n_col)
            wh.where_end(p, a, wi)
            sort_ptab = p.f.n_tab
            p.f.n_tab += 1
            p.aggs[ai].sorting_idx_ptab = sort_ptab
            sort_out = cg.get_temp_reg(p)
            _: cg.op3(p, opc.OP_OPEN_PSEUDO, sort_ptab, sort_out, n_col)
            _: cg.op2(p, opc.OP_SORTER_SORT, p.aggs[ai].sorting_idx, addr_end)
            p.aggs[ai].use_sorting_idx = true
        }
        if p.f.idx_epr >= 0 -> aggregate_convert_indexed_expr_ref_to_column(p, a, ai)
        if order_by_grp && cg.opt_enabled(p, cg.OPT_GROUP_BY_ORDER) && (group_by_sort || wh.where_is_sorted(wi)) {
            sort.order_by = -1
            _: cg.v_change_to_noop(p, sort.addr_sort_index)
        }
        addr_top_of_loop: cg.v_current_addr(p)
        if group_by_sort -> _: cg.op3(p, opc.OP_SORTER_DATA, p.aggs[ai].sorting_idx, sort_out, sort_ptab)
        loop j in 0..<n_gb {
            if group_by_sort {
                _: cg.op3(p, opc.OP_COLUMN, sort_ptab, j, i_bmem + j)
            } else {
                p.aggs[ai].direct_mode = true
                ge: ast.list_expr(a, group_by, j)
                ex.expr_code(p, a, ge, i_bmem + j)
            }
        }
        _: cg.op4(p, opc.OP_COMPARE, i_amem, i_bmem, n_gb, conn.P4.KeyInfo(ki))
        addr1: cg.v_current_addr(p)
        _: cg.op3(p, opc.OP_JUMP, addr1 + 1, 0, addr1 + 1)
        ex.expr_code_move(p, i_bmem, i_amem, n_gb)
        _: cg.op2(p, opc.OP_GOSUB, reg_output_row, addr_output_row)
        _: cg.op2(p, opc.OP_IF_POS, i_abort_flag, addr_end)
        _: cg.op2(p, opc.OP_GOSUB, reg_reset, addr_reset)
        cg.v_jump_here(p, addr1)
        update_accumulator(p, a, i_use_flag, ai, e_dist)
        _: cg.op2(p, opc.OP_INTEGER, 1, i_use_flag)
        if group_by_sort {
            _: cg.op2(p, opc.OP_SORTER_NEXT, p.aggs[ai].sorting_idx, addr_top_of_loop)
        } else {
            wh.where_end(p, a, wi)
            _: cg.v_change_to_noop(p, addr_sorting_idx)
        }
        _: cg.op2(p, opc.OP_GOSUB, reg_output_row, addr_output_row)
        _: cg.goto(p, addr_end)
        addr_set_abort: cg.v_current_addr(p)
        _: cg.op2(p, opc.OP_INTEGER, 1, i_abort_flag)
        _: cg.op1(p, opc.OP_RETURN, reg_output_row)
        cg.v_resolve_label(p, addr_output_row)
        addr_out: cg.v_current_addr(p)
        _: cg.op2(p, opc.OP_IF_POS, i_use_flag, addr_out + 2)
        _: cg.op1(p, opc.OP_RETURN, reg_output_row)
        finalize_agg_functions(p, a, ai)
        ex.expr_if_false(p, a, having, addr_out + 1, cg.JUMPIFNULL)
        select_inner_loop(p, a, s, -1, sort, distinct, dest, addr_out + 1, addr_set_abort)
        _: cg.op1(p, opc.OP_RETURN, reg_output_row)
        cg.v_resolve_label(p, addr_reset)
        reset_accumulator(p, a, ai)
        _: cg.op2(p, opc.OP_INTEGER, 0, i_use_flag)
        _: cg.op1(p, opc.OP_RETURN, reg_reset)
        if dist_flag != 0 && e_dist != cg.WHERE_DISTINCT_NOOP {
            f: p.aggs[ai].funcs[0].copy()
            fix_distinct_open_eph(p, a, e_dist, f.i_distinct, f.i_dist_addr)
        }
        return false
    }
    true
}

// The aggregate of SELECT s without GROUP BY (AggInfo ai): OP_Count for a
// simple count(*), else one pass that accumulates, finalizes and outputs
// the single row. Whether it failed.
select_agg_no_group_by: fn(p: &cg.Parse, a: &ast.AST, s: Int, dest: &cg.SelectDest, sort: &SortCtx, ai: Int, min_max_flag: Int, min_max_ob: Int, where_e: Int, addr_end: Int) -[DB]> Bool Never! {
    tab_list: a.selects[s].src
    t: is_simple_count(p, a, s, ai)
    if t >= 0 {
        i_db: conn.schema_to_index(p.db, p.db.tables[t].schema)
        i_csr: p.f.n_tab
        p.f.n_tab += 1
        cg.code_verify_schema(p, a, i_db)
        best := -1
        if !ex.has_rowid(p.db, t) -> best = cat.primary_key_index(p.db, t)
        if !a.items[ast.src_item(a, tab_list, 0)].not_indexed {
            sz_tab_row: p.db.tables[t].sz_tab_row
            ix := p.db.tables[t].index
            loop ix >= 0 {
                sz: p.db.indexes[ix].sz_idx_row
                if !p.db.indexes[ix].b_unordered && sz < sz_tab_row && p.db.indexes[ix].part_idx_where < 0 && (best < 0 || sz < p.db.indexes[best].sz_idx_row) -> best = ix
                ix = p.db.indexes[ix].next
            }
        }
        if best >= 0 {
            kio: cat.key_info_of_index(p, a, best)
            _: cg.op4_int(p, opc.OP_OPEN_READ, i_csr, p.db.indexes[best].tnum, i_db, 1)
            if kio == .Val(k) -> cg.v_change_p4(p, -1, conn.P4.KeyInfo(k))
        } else {
            _: cg.op4_int(p, opc.OP_OPEN_READ, i_csr, p.db.tables[t].tnum, i_db, 1)
        }
        assign_aggregate_registers(p, ai)
        _: cg.op2(p, opc.OP_COUNT, i_csr, p.aggs[ai].i_first_reg + p.aggs[ai].cols.len())
        _: cg.op1(p, opc.OP_CLOSE, i_csr)
        explain_simple_count(p, a, t, best)
    } else {
        reg_acc := 0
        p_distinct := -1
        dist_flag := 0
        n_func: p.aggs[ai].funcs.len()
        if p.aggs[ai].n_accumulator != 0 {
            i := 0
            loop i < n_func {
                fe: p.aggs[ai].funcs[i].f_expr
                if !ast.has(a, fe, ast.EP_WIN_FUNC) && p.aggs[ai].funcs[i].func.flags.bit_and(conn.FUNC_NEEDCOLL) != 0 -> break
                i += 1
            }
            if i == n_func {
                p.f.n_mem += 1
                reg_acc = p.f.n_mem
                _: cg.op2(p, opc.OP_INTEGER, 0, reg_acc)
            }
        } else if n_func == 1 && p.aggs[ai].funcs[0].i_distinct >= 0 {
            p_distinct = a.exprs[p.aggs[ai].funcs[0].f_expr].x
            if p_distinct >= 0 -> dist_flag = cg.WHERE_WANT_DISTINCT.bit_or(cg.WHERE_AGG_DISTINCT)
        }
        assign_aggregate_registers(p, ai)
        reset_accumulator(p, a, ai)
        wr := wh.where_begin(p, a, tab_list, where_e, min_max_ob, p_distinct, s, min_max_flag.bit_or(dist_flag), 0)
        if wr == .Val(wi0) {
            wi := wi0
            e_dist: wh.where_is_distinct(wi)
            update_accumulator(p, a, reg_acc, ai, e_dist)
            if e_dist != cg.WHERE_DISTINCT_NOOP && n_func > 0 {
                f: p.aggs[ai].funcs[0].copy()
                fix_distinct_open_eph(p, a, e_dist, f.i_distinct, f.i_dist_addr)
            }
            if reg_acc != 0 -> _: cg.op2(p, opc.OP_INTEGER, 1, reg_acc)
            if min_max_flag != 0 -> wh.where_min_max_opt_early_out(p, wi)
            wh.where_end(p, a, wi)
            finalize_agg_functions(p, a, ai)
        } else {
            return true
        }
    }
    sort.order_by = -1
    ex.expr_if_false(p, a, a.selects[s].having, addr_end, cg.JUMPIFNULL)
    ns := no_sort()
    select_inner_loop(p, a, s, -1, ns, no_distinct(), dest, addr_end, addr_end)
    false
}

// The aggregate half of sqlite3Select (an aggregate or GROUP BY query):
// the AggInfo and its analysis, then the GROUP BY loop or the single-row
// aggregate. Whether it failed.
select_aggregate: fn(p: &cg.Parse, a: &ast.AST, s: Int, dest: &cg.SelectDest, sort: &SortCtx, distinct: DistinctCtx) -[DB]> Bool Never! {
    tab_list: a.selects[s].src
    elist: a.selects[s].elist
    group_by: a.selects[s].group_by
    order_by_grp := false
    if group_by >= 0 {
        loop k in 0..<ast.list_len(a, elist) -> a.lists[elist].items[k].alias = 0
        n_gb: ast.list_len(a, group_by)
        loop k in 0..<n_gb -> a.lists[group_by].items[k].alias = 0
        if a.selects[s].nselect_row > 66 -> a.selects[s].nselect_row = 66
        ob: sort.order_by
        if ob >= 0 && n_gb == ast.list_len(a, ob) {
            loop ii in 0..<n_gb -> a.lists[group_by].items[ii].sort_flags = a.lists[ob].items[ii].sort_flags.bit_and(base.KEYINFO_ORDER_DESC)
            if ast.expr_list_compare(a, group_by, ob, -1) == 0 -> order_by_grp = true
        }
    } else {
        a.selects[s].nselect_row = 0
    }
    addr_end: cg.v_make_label(p)
    p.aggs.push(cg.AggInfo{direct_mode: false, use_sorting_idx: false, n_sorting_column: ast.list_len(a, group_by), sorting_idx: 0, sorting_idx_ptab: 0, i_first_reg: 0, group_by: group_by, cols: [cg.AggCol]{}, n_accumulator: 0, funcs: [cg.AggFunc]{}, sel_id: a.selects[s].sel_id})
    ai: p.aggs.len() - 1
    nc0 := rs.nc_new(tab_list, ast.NC_UAGG_INFO)
    nc0.u = ai
    nc: rs.nc_push(p, nc0)
    ex.expr_analyze_agg_list(p, a, nc, elist)
    ex.expr_analyze_agg_list(p, a, nc, sort.order_by)
    where_e := a.selects[s].where_expr
    having: a.selects[s].having
    if having >= 0 {
        if group_by >= 0 {
            having_to_where(p, a, s)
            where_e = a.selects[s].where_expr
        }
        ex.expr_analyze_aggregates(p, a, nc, having)
    }
    p.aggs[ai].n_accumulator = p.aggs[ai].cols.len()
    min_max_flag := cg.WHERE_ORDERBY_NORMAL
    min_max_ob := -1
    if a.selects[s].group_by < 0 && a.selects[s].having < 0 && p.aggs[ai].funcs.len() == 1 {
        mm: min_max_query(p, a, p.aggs[ai].funcs[0].f_expr)
        min_max_flag = mm.ret
        min_max_ob = mm.ob
    }
    analyze_agg_func_args(p, a, ai, nc)
    if p.db.malloc_failed -> return true
    if group_by >= 0 {
        if select_group_by(p, a, s, dest, sort, distinct, ai, nc, order_by_grp, addr_end, where_e) -> return true
    } else {
        if select_agg_no_group_by(p, a, s, dest, sort, ai, min_max_flag, min_max_ob, where_e, addr_end) -> return true
    }
    cg.v_resolve_label(p, addr_end)
    false
}

// The body of sqlite3Select after sqlite3SelectPrep: its result code, and
// whether the caller pops the EXPLAIN QUERY PLAN level (see above).
select_body: fn(p: &cg.Parse, a: &ast.AST, s: Int, dest: &cg.SelectDest) -[DB]> (rc: Int, pop: Bool) Never! {
    if a.selects[s].sel_flags.bit_and(ast.SF_UF_SRC_CHECK) != 0 {
        src: a.selects[s].src
        p0: ast.src_item(a, src, 0)
        if same_src_alias(a, p0, src) {
            name: a.items[p0].alias ?? p.db.tables[a.items[p0].tab].name
            ast.error(a, "target object/alias may not appear in FROM clause: {ast.text(name)}")
            return (rc: 1, pop: true)
        }
        a.selects[s].sel_flags = util.clear_bits(a.selects[s].sel_flags, ast.SF_UF_SRC_CHECK)
    }
    if dest.e_dest == cg.SRT_OUTPUT -> generate_column_names(p, a, s)
    if wn.window_rewrite(p, a, s) != 0 -> return (rc: 1, pop: true)
    is_agg: a.selects[s].sel_flags.bit_and(ast.SF_AGGREGATE) != 0
    sort := no_sort()
    sort.order_by = a.selects[s].order_by
    if a.selects[s].prior < 0 {
        i := 0
        loop i >= 0 && i < ast.src_len(a, a.selects[s].src) -> i = simplify_from_term(p, a, s, i, is_agg, dest.e_dest, sort)
        if i < 0 -> return (rc: 1, pop: true)
    }
    if a.selects[s].prior >= 0 {
        rc: multi_select(p, a, s, dest)
        return (rc: rc, pop: a.selects[s].next_sel < 0)
    }
    w0: a.selects[s].where_expr
    if w0 >= 0 && a.exprs[w0].op == tk.TK_AND && cg.opt_enabled(p, cg.OPT_PROPAGATE_CONST) -> _: propagate_constants(p, a, s)
    if cg.opt_enabled(p, cg.OPT_QUERY_FLATTENER.bit_or(cg.OPT_COUNT_OF_VIEW)) && count_of_view_optimization(p, a, s) {
        if p.db.malloc_failed -> return (rc: 1, pop: true)
    }
    if code_from_subqueries(p, a, s) -> return (rc: 1, pop: true)
    tab_list: a.selects[s].src
    elist: a.selects[s].elist
    distinct := no_distinct()
    if a.selects[s].sel_flags.bit_and(ast.SF_DISTINCT) != 0 -> distinct.is_tnct = 1
    sf: a.selects[s].sel_flags
    if sf.bit_and(ast.SF_DISTINCT.bit_or(ast.SF_AGGREGATE)) == ast.SF_DISTINCT && ast.expr_list_compare(a, sort.order_by, elist, -1) == 0 && a.selects[s].win < 0 {
        a.selects[s].sel_flags = util.clear_bits(sf, ast.SF_DISTINCT).bit_or(ast.SF_AGGREGATE)
        a.selects[s].group_by = ast.expr_list_dup(a, elist, 0)
        distinct.is_tnct = 2
    }
    n_elist: ast.list_len(a, elist)
    if sort.order_by >= 0 {
        ki: wn.key_info_from_expr_list(p, a, sort.order_by, 0, n_elist)
        sort.i_ecursor = p.f.n_tab
        p.f.n_tab += 1
        sort.addr_sort_index = cg.op4(p, opc.OP_OPEN_EPHEMERAL, sort.i_ecursor, ast.list_len(a, sort.order_by) + 1 + n_elist, 0, conn.P4.KeyInfo(ki))
    } else {
        sort.addr_sort_index = -1
    }
    if dest.e_dest == cg.SRT_EPHEM_TAB {
        _: cg.op2(p, opc.OP_OPEN_EPHEMERAL, dest.i_sd_parm, n_elist)
        if a.selects[s].sel_flags.bit_and(ast.SF_NESTED_FROM) != 0 {
            ii := n_elist - 1
            loop ii > 0 && !a.lists[elist].items[ii].used {
                ast.expr_delete(a, a.lists[elist].items[ii].expr)
                _: a.lists[elist].items.pop()
                ii -= 1
            }
            loop k in 0..<ast.list_len(a, elist) {
                if !a.lists[elist].items[k].used -> a.exprs[a.lists[elist].items[k].expr].op = tk.TK_NULL
            }
        }
    }
    i_end: cg.v_make_label(p)
    if a.selects[s].sel_flags.bit_and(ast.SF_FIXED_LIMIT) == 0 -> a.selects[s].nselect_row = 320
    if a.selects[s].limit >= 0 -> compute_limit_registers(p, a, s, i_end)
    if a.selects[s].ilimit == 0 && sort.addr_sort_index >= 0 {
        cg.v_change_opcode(p, sort.addr_sort_index, opc.OP_SORTER_OPEN)
        sort.sort_flags = sort.sort_flags.bit_or(SORTFLAG_USE_SORTER)
    }
    if a.selects[s].sel_flags.bit_and(ast.SF_DISTINCT) != 0 {
        distinct.tab_tnct = p.f.n_tab
        p.f.n_tab += 1
        ki: wn.key_info_from_expr_list(p, a, a.selects[s].elist, 0, 0)
        distinct.addr_tnct = cg.op4(p, opc.OP_OPEN_EPHEMERAL, distinct.tab_tnct, 0, 0, conn.P4.KeyInfo(ki))
        cg.v_change_p5(p, btree.BTREE_UNORDERED)
        distinct.e_tnct_type = cg.WHERE_DISTINCT_UNORDERED
    } else {
        distinct.e_tnct_type = cg.WHERE_DISTINCT_NOOP
    }
    if !is_agg && a.selects[s].group_by < 0 {
        wctrl: (if distinct.is_tnct != 0 -> cg.WHERE_WANT_DISTINCT else -> 0).bit_or(a.selects[s].sel_flags.bit_and(ast.SF_FIXED_LIMIT))
        win: a.selects[s].win
        if win >= 0 -> wn.window_code_init(p, a, s)
        wr := wh.where_begin(p, a, tab_list, a.selects[s].where_expr, sort.order_by, a.selects[s].elist, s, wctrl, a.selects[s].nselect_row)
        if wr == .Val(wi0) {
            wi := wi0
            n_row: wh.where_output_row_count(wi)
            if n_row < a.selects[s].nselect_row -> a.selects[s].nselect_row = n_row
            wd: wh.where_is_distinct(wi)
            if distinct.is_tnct != 0 && wd != 0 -> distinct.e_tnct_type = wd
            if sort.order_by >= 0 {
                sort.n_ob_sat = wh.where_is_ordered(wi)
                sort.label_ob_lopt = wh.where_order_by_limit_opt_label(wi)
                if sort.n_ob_sat == ast.list_len(a, sort.order_by) -> sort.order_by = -1
            }
            if sort.addr_sort_index >= 0 && sort.order_by < 0 -> _: cg.v_change_to_noop(p, sort.addr_sort_index)
            if win >= 0 {
                addr_gosub: cg.v_make_label(p)
                i_cont: cg.v_make_label(p)
                i_break: cg.v_make_label(p)
                p.f.n_mem += 1
                reg_gosub: p.f.n_mem
                wn.window_code_step(p, a, s, wi, reg_gosub, addr_gosub)
                _: cg.op2(p, opc.OP_GOTO, 0, i_break)
                cg.v_resolve_label(p, addr_gosub)
                sort.label_ob_lopt = 0
                select_inner_loop(p, a, s, -1, sort, distinct, dest, i_cont, i_break)
                cg.v_resolve_label(p, i_cont)
                _: cg.op1(p, opc.OP_RETURN, reg_gosub)
                cg.v_resolve_label(p, i_break)
            } else {
                i_cont: wh.where_continue_label(wi)
                i_break: wh.where_break_label(wi)
                select_inner_loop(p, a, s, -1, sort, distinct, dest, i_cont, i_break)
                wh.where_end(p, a, wi)
            }
        } else {
            return (rc: 1, pop: true)
        }
    } else {
        if select_aggregate(p, a, s, dest, sort, distinct) -> return (rc: 1, pop: true)
    }
    if distinct.e_tnct_type == cg.WHERE_DISTINCT_UNORDERED -> _: cg.explain(p, a, false, "USE TEMP B-TREE FOR DISTINCT")
    if sort.order_by >= 0 {
        n_col: ast.list_len(a, a.selects[s].elist)
        generate_sort_tail(p, a, s, sort, n_col, dest)
    }
    cg.v_resolve_label(p, i_end)
    (rc: if cg.n_err(a) > 0 -> 1 else -> 0, pop: true)
}

// sqlite3Select: the code of SELECT s, its rows going to dest; 1 when
// there was an error, else 0.
select: fn(p: &cg.Parse, a: &ast.AST, s: Int, dest: &cg.SelectDest) -[DB]> Int Never! {
    cg.get_vdbe(p)
    if s < 0 || cg.n_err(a) != 0 -> return 1
    if cg.auth_check(p, a, conn.AUTH_SELECT, None, None, None) != 0 -> return 1
    if dest.e_dest <= cg.SRT_DIST_QUEUE {
        a.selects[s].order_by = -1
        a.selects[s].sel_flags = util.clear_bits(a.selects[s].sel_flags, ast.SF_DISTINCT).bit_or(ast.SF_NOOP_ORDER_BY)
    }
    select_prep(p, a, s, -1)
    if cg.n_err(a) != 0 {
        cg.explain_pop(p)
        return 1
    }
    mark: p.ncs.len()
    r: select_body(p, a, s, dest)
    rs.nc_release(p, mark)
    if r.pop -> cg.explain_pop(p)
    r.rc
}

// ---------------------------------------------------------------------------
// Tests.

// Whether the program holds an op `opcode`.
select_test_has_op: fn(p: cg.Parse, opcode: Int) -> Bool Never! {
    loop o in p.f.v.ops {
        if o.opcode == opcode -> return true
    }
    false
}

// "SELECT 1" with the extra clauses the caller sets.
select_test_one: fn(a: &ast.AST) -> Int Never! {
    one: ast.expr(a, tk.TK_INTEGER, "1".bytes())
    elist: ast.expr_list_append(a, -1, one)
    ast.select_new(a, elist, -1, -1, -1, -1, -1, 0, -1)
}

#Test("column names count up and byte parts join") {
    assert(name_with_counter("column".bytes(), 3, 7) == "col:7".bytes())
    assert(join_bytes([[U8]]{"a".bytes(), "b".bytes(), "c".bytes()}, U8{46}) == "a.b.c".bytes())
    assert(std_type_for_affinity(base.AFF_INTEGER) == Val("INT".bytes()))
    m: [Int]{3, 0, 9, 0}
    assert(renumber_mapping(m, 1) == 9 && renumber_mapping(m, 2) == 2 && renumber_mapping(m, 5) == 5)
}

#Test("a compound's right-most term and its recursive anchor") {
    a := ast.stmt_ast("")
    s1: select_test_one(a)
    s2: select_test_one(a)
    a.selects[s1].next_sel = s2
    a.selects[s2].prior = s1
    assert(find_rightmost(a, s1) == s2)
    a.selects[s2].sel_flags = ast.SF_RECURSIVE
    assert(has_anchor(a, s2))
    a.selects[s1].sel_flags = ast.SF_RECURSIVE
    assert(!has_anchor(a, s2))
}

#Test("a WHERE that rejects the NULL row makes a LEFT JOIN inner") {
    a := ast.stmt_ast("")
    src := ast.src_list_append(a, -1, Val("t".bytes()), None)
    src = ast.src_list_append(a, src, Val("u".bytes()), None)
    s: ast.select_new(a, -1, src, -1, -1, -1, -1, 0, -1)
    si: ast.src_item(a, src, 1)
    a.items[si].cursor = 1
    a.items[si].jointype = ast.JT_LEFT.bit_or(ast.JT_OUTER)
    col: ast.expr(a, tk.TK_COLUMN, [U8]{})
    a.exprs[col].itable = 1
    ast.set_flags(a, col, ast.EP_OUTER_ON)
    a.exprs[col].w = 1
    a.selects[s].where_expr = col
    simplify_join(a, s, 1)
    assert(a.items[si].jointype == 0)
    assert(!ast.has(a, col, ast.EP_OUTER_ON) && ast.has(a, col, ast.EP_INNER_ON))
    a.items[si].jointype = ast.JT_LEFT.bit_or(ast.JT_RIGHT).bit_or(ast.JT_OUTER)
    simplify_join(a, s, 1)
    assert(a.items[si].jointype == ast.JT_RIGHT.bit_or(ast.JT_OUTER))
}

#Test("SELECT 1 codes one result row") {
    a := ast.stmt_ast("")
    p := rs.resolve_test_parse()
    s: select_test_one(a)
    d := ex.select_dest_init(cg.SRT_OUTPUT, 0)
    assert(select(p, a, s, d) == 0)
    assert(cg.n_err(a) == 0)
    assert(select_test_has_op(p, opc.OP_RESULT_ROW))
    assert(p.f.addr_explain == 0)
}

#Test("a destination that ignores order drops ORDER BY and DISTINCT") {
    a := ast.stmt_ast("")
    p := rs.resolve_test_parse()
    s: select_test_one(a)
    two: ast.expr(a, tk.TK_INTEGER, "2".bytes())
    a.selects[s].order_by = ast.expr_list_append(a, -1, two)
    a.selects[s].sel_flags = a.selects[s].sel_flags.bit_or(ast.SF_DISTINCT)
    d := ex.select_dest_init(cg.SRT_DISCARD, 0)
    assert(select(p, a, s, d) == 0)
    assert(a.selects[s].order_by < 0)
    assert(a.selects[s].sel_flags.bit_and(ast.SF_DISTINCT) == 0 && a.selects[s].sel_flags.bit_and(ast.SF_NOOP_ORDER_BY) != 0)
    assert(!select_test_has_op(p, opc.OP_OPEN_EPHEMERAL) && !select_test_has_op(p, opc.OP_RESULT_ROW))
}
