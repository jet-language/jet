// Window functions: a port of SQLite 3.45.0 window.c's built-in window
// functions, the SELECT rewrite (sqlite3WindowRewrite) and the code that
// computes them (sqlite3WindowCodeInit, sqlite3WindowCodeStep), with
// sqlite3KeyInfoFromExprList (select.c), which they and select.c share.
// The parse-time half of window.c (sqlite3WindowAlloc, Dup, Delete, Attach,
// Link, Chain, Compare) is Ast's; sqlite3WindowUpdate is Resolve's and
// sqlite3WindowFunctions' table is Catalog's.
//
// A built-in window function is matched by its FuncDef's impl_id (a
// cat.FI_* with FUNC_BUILTIN), where C compares zName with nth_valueName
// and the others, or xSFunc with noopStepFunc (lead() and lag()). Its
// aggregate context is a Vdbe.aggs slot: row_number()'s count is
// AggState.i; struct CallCount and struct NtileCtx are AggState.ints
// (WIN_CC_* and WIN_NT_*); NthValueCtx and LastValueCtx keep nStep and
// nVal in AggState.n and pValue as AggState.vals, empty for NULL.
//
// sqlite3WindowRewrite's WindowRewrite walk keeps pSub in the walk's u and
// pSubSelect in u2 (-1 for none). The Table it makes for the subquery is
// a p.db.tables slot; the result-set Table it copies from is freed once
// copied, as the deferred sqlite3DbFree frees it.
//
// The build has no SQLITE_DEBUG; VdbeComment, VdbeModuleComment and
// VdbeCoverage code nothing.
use {
    base: __core_db_base
    ast: __core_db_ast
    tk: __core_db_tokenize
    util: __core_db_util
    conn: __core_db_conn
    opc: __core_db_opcodes
    aux: __core_db_vdbeaux
    mem: __core_db_mem
    record: __core_db_record
    api: __core_db_vdbeapi
    cg: __core_db_codegen
    __core_db_codegen.[WalkCb]
    cat: __core_db_catalog
    ex: __core_db_expr
    we: __core_db_whereexpr
    wh: __core_db_where
}

// ---------------------------------------------------------------------------
// The built-in window functions.

// The i64 fields of struct CallCount and struct NtileCtx in AggState.ints.
WIN_CC_VALUE: 0
WIN_CC_STEP: 1
WIN_CC_TOTAL: 2
WIN_NT_TOTAL: 0
WIN_NT_PARAM: 1
WIN_NT_ROW: 2

// sqlite3_aggregate_context for a context of three i64 fields, zeroed
// when it is made: its Vdbe.aggs slot, -1 for none.
window_ctx_ints: fn(v: &conn.Vdbe, n_byte: Int) -> Int Never! {
    k: api.aggregate_context(v, n_byte)
    if k >= 0 && v.aggs[k].ints.len() == 0 -> v.aggs[k].ints = [Int]{0, 0, 0}
    k
}

// One more in i64 field f of context k.
window_ctx_bump: fn(v: &conn.Vdbe, k: Int, f: Int) Never! { v.aggs[k].ints[f] = v.aggs[k].ints[f] + 1 }

// row_numberStepFunc.
row_number_step: fn(v: &conn.Vdbe) Never! {
    k: api.aggregate_context(v, 8)
    if k >= 0 -> v.aggs[k].i += 1
}

// row_numberValueFunc.
row_number_value: fn(v: &conn.Vdbe) Never! {
    k: api.aggregate_context(v, 8)
    x: if k >= 0 -> v.aggs[k].i else -> 0
    api.result_int64(v, x)
}

// dense_rankStepFunc.
dense_rank_step: fn(v: &conn.Vdbe) Never! {
    k: window_ctx_ints(v, 24)
    if k >= 0 -> v.aggs[k].ints[WIN_CC_STEP] = 1
}

// dense_rankValueFunc.
dense_rank_value: fn(v: &conn.Vdbe) Never! {
    k: window_ctx_ints(v, 24)
    if k < 0 -> return
    if v.aggs[k].ints[WIN_CC_STEP] != 0 {
        window_ctx_bump(v, k, WIN_CC_VALUE)
        v.aggs[k].ints[WIN_CC_STEP] = 0
    }
    x: v.aggs[k].ints[WIN_CC_VALUE]
    api.result_int64(v, x)
}

// nth_valueStepFunc: the value of the row whose position in the frame is
// the second argument, a positive integer.
nth_value_step: fn(db: conn.Conn, v: &conn.Vdbe) Never! {
    k: api.aggregate_context(v, 24)
    if k < 0 -> return
    r1: v.fctx.arg + 1
    t: mem.value_numeric_type(v.mem[r1])
    ival := 0
    ok := false
    if t == base.SQL_INTEGER {
        ival = mem.int_value(v.mem[r1])
        ok = true
    } else if t == base.SQL_FLOAT {
        f: mem.real_value(v.mem[r1])
        ival = mem.real_to_i64(f)
        ok = util.int_to_double(ival) == f
    }
    if !ok || ival <= 0 {
        api.result_error(db, v, "second argument to nth_value must be a positive integer".bytes(), -1)
        return
    }
    v.aggs[k].n += 1
    if ival == v.aggs[k].n {
        x: mem.mem_copy(v.mem[v.fctx.arg])
        v.aggs[k].vals = [base.Mem]{x}
    }
}

// nth_valueFinalizeFunc and first_valueFinalizeFunc.
nth_value_finalize: fn(db: conn.Conn, v: &conn.Vdbe, n_byte: Int) Never! {
    k: api.aggregate_context(v, n_byte)
    if k < 0 || v.aggs[k].vals.len() == 0 -> return
    x: v.aggs[k].vals[0]
    api.result_value(db, v, x)
    v.aggs[k].vals = [base.Mem]{}
}

// first_valueStepFunc.
first_value_step: fn(v: &conn.Vdbe) Never! {
    k: api.aggregate_context(v, 24)
    if k < 0 || v.aggs[k].vals.len() > 0 -> return
    x: mem.mem_copy(v.mem[v.fctx.arg])
    v.aggs[k].vals = [base.Mem]{x}
}

// rankStepFunc.
rank_step: fn(v: &conn.Vdbe) Never! {
    k: window_ctx_ints(v, 24)
    if k < 0 -> return
    window_ctx_bump(v, k, WIN_CC_STEP)
    if v.aggs[k].ints[WIN_CC_VALUE] == 0 -> v.aggs[k].ints[WIN_CC_VALUE] = v.aggs[k].ints[WIN_CC_STEP]
}

// rankValueFunc.
rank_value: fn(v: &conn.Vdbe) Never! {
    k: window_ctx_ints(v, 24)
    if k < 0 -> return
    x: v.aggs[k].ints[WIN_CC_VALUE]
    api.result_int64(v, x)
    v.aggs[k].ints[WIN_CC_VALUE] = 0
}

// percent_rankStepFunc and cume_distStepFunc.
call_count_total_step: fn(v: &conn.Vdbe) Never! {
    k: window_ctx_ints(v, 24)
    if k >= 0 -> window_ctx_bump(v, k, WIN_CC_TOTAL)
}

// percent_rankInvFunc and cume_distInvFunc.
call_count_step_inverse: fn(v: &conn.Vdbe) Never! {
    k: window_ctx_ints(v, 24)
    if k >= 0 -> window_ctx_bump(v, k, WIN_CC_STEP)
}

// percent_rankValueFunc.
percent_rank_value: fn(v: &conn.Vdbe) Never! {
    k: window_ctx_ints(v, 24)
    if k < 0 -> return
    v.aggs[k].ints[WIN_CC_VALUE] = v.aggs[k].ints[WIN_CC_STEP]
    total: v.aggs[k].ints[WIN_CC_TOTAL]
    r: if total > 1 -> util.int_to_double(v.aggs[k].ints[WIN_CC_VALUE]) / util.int_to_double(total - 1) else -> Float{0.0}
    api.result_double(v, r)
}

// cume_distValueFunc.
cume_dist_value: fn(v: &conn.Vdbe) Never! {
    k: window_ctx_ints(v, 0)
    if k < 0 -> return
    r: util.int_to_double(v.aggs[k].ints[WIN_CC_STEP]) / util.int_to_double(v.aggs[k].ints[WIN_CC_TOTAL])
    api.result_double(v, r)
}

// ntileStepFunc.
ntile_step: fn(db: conn.Conn, v: &conn.Vdbe) Never! {
    k: window_ctx_ints(v, 24)
    if k < 0 -> return
    if v.aggs[k].ints[WIN_NT_TOTAL] == 0 {
        n: mem.int_value(v.mem[v.fctx.arg])
        v.aggs[k].ints[WIN_NT_PARAM] = n
        if n <= 0 -> api.result_error(db, v, "argument of ntile must be a positive integer".bytes(), -1)
    }
    window_ctx_bump(v, k, WIN_NT_TOTAL)
}

// ntileInvFunc.
ntile_inverse: fn(v: &conn.Vdbe) Never! {
    k: window_ctx_ints(v, 24)
    if k >= 0 -> window_ctx_bump(v, k, WIN_NT_ROW)
}

// ntileValueFunc.
ntile_value: fn(v: &conn.Vdbe) Never! {
    k: window_ctx_ints(v, 24)
    if k < 0 || v.aggs[k].ints[WIN_NT_PARAM] <= 0 -> return
    total: v.aggs[k].ints[WIN_NT_TOTAL]
    param: v.aggs[k].ints[WIN_NT_PARAM]
    row: v.aggs[k].ints[WIN_NT_ROW]
    n_size: total /% param
    if n_size == 0 {
        api.result_int64(v, row + 1)
        return
    }
    n_large: total - param * n_size
    i_small: n_large * (n_size + 1)
    if row < i_small {
        api.result_int64(v, 1 + row /% (n_size + 1))
    } else {
        api.result_int64(v, 1 + n_large + (row - i_small) /% n_size)
    }
}

// last_valueStepFunc.
last_value_step: fn(v: &conn.Vdbe) Never! {
    k: api.aggregate_context(v, 16)
    if k < 0 -> return
    x: mem.mem_copy(v.mem[v.fctx.arg])
    v.aggs[k].vals = [base.Mem]{x}
    v.aggs[k].n += 1
}

// last_valueInvFunc.
last_value_inverse: fn(v: &conn.Vdbe) Never! {
    k: api.aggregate_context(v, 16)
    if k < 0 -> return
    v.aggs[k].n -= 1
    if v.aggs[k].n == 0 -> v.aggs[k].vals = [base.Mem]{}
}

// last_valueValueFunc.
last_value_value: fn(db: conn.Conn, v: &conn.Vdbe) Never! {
    k: api.aggregate_context(v, 0)
    if k < 0 || v.aggs[k].vals.len() == 0 -> return
    x: v.aggs[k].vals[0]
    api.result_value(db, v, x)
}

// last_valueFinalizeFunc.
last_value_finalize: fn(db: conn.Conn, v: &conn.Vdbe) Never! {
    k: api.aggregate_context(v, 16)
    if k < 0 || v.aggs[k].vals.len() == 0 -> return
    x: v.aggs[k].vals[0]
    api.result_value(db, v, x)
    v.aggs[k].vals = [base.Mem]{}
}

// The Host's call of method `method` (aux.FN_*) of the built-in window
// function the call runs (impl_id cat.FI_ROW_NUMBER .. cat.FI_LAG), as
// sqlite3WindowFunctions' WINDOWFUNCX, WINDOWFUNCALL and WINDOWFUNCNOOP
// entries bind them: a WINDOWFUNCX function's xValue is its xFinalize too.
// noopStepFunc (which the VM never calls) and noopValueFunc do nothing.
window_func_call: fn(db: conn.Conn, v: &conn.Vdbe, method: Int) Never! {
    id: v.fctx.impl_id
    step: method == aux.FN_STEP || method == aux.FN_SFUNC
    inverse: method == aux.FN_INVERSE
    fin: method == aux.FN_FINAL
    if id == cat.FI_ROW_NUMBER {
        if step {
            row_number_step(v)
        } else if !inverse {
            row_number_value(v)
        }
    } else if id == cat.FI_DENSE_RANK {
        if step {
            dense_rank_step(v)
        } else if !inverse {
            dense_rank_value(v)
        }
    } else if id == cat.FI_RANK {
        if step {
            rank_step(v)
        } else if !inverse {
            rank_value(v)
        }
    } else if id == cat.FI_PERCENT_RANK {
        if step {
            call_count_total_step(v)
        } else if inverse {
            call_count_step_inverse(v)
        } else {
            percent_rank_value(v)
        }
    } else if id == cat.FI_CUME_DIST {
        if step {
            call_count_total_step(v)
        } else if inverse {
            call_count_step_inverse(v)
        } else {
            cume_dist_value(v)
        }
    } else if id == cat.FI_NTILE {
        if step {
            ntile_step(db, v)
        } else if inverse {
            ntile_inverse(v)
        } else {
            ntile_value(v)
        }
    } else if id == cat.FI_LAST_VALUE {
        if step {
            last_value_step(v)
        } else if inverse {
            last_value_inverse(v)
        } else if fin {
            last_value_finalize(db, v)
        } else {
            last_value_value(db, v)
        }
    } else if id == cat.FI_NTH_VALUE {
        if step {
            nth_value_step(db, v)
        } else if fin {
            nth_value_finalize(db, v, 0)
        }
    } else if id == cat.FI_FIRST_VALUE {
        if step {
            first_value_step(v)
        } else if fin {
            nth_value_finalize(db, v, 24)
        }
    }
}

// ---------------------------------------------------------------------------
// The SELECT rewrite.

// sqlite3KeyInfoFromExprList (select.c): the KeyInfo of the terms of
// `list` from i_start on, with n_extra more fields, their collations and
// sort orders the terms'.
key_info_from_expr_list: fn(p: &cg.Parse, a: &ast.AST, list: Int, i_start: Int, n_extra: Int) -> record.KeyInfo Never! {
    n_expr: ast.list_len(a, list)
    info := cat.key_info_alloc(p.db, n_expr - i_start, n_extra + 1)
    loop i in i_start..<n_expr {
        e: ast.list_expr(a, list, i)
        coll: ex.expr_nn_coll_seq(p, a, e)
        info.colls[i - i_start] = coll
        info.sort_flags[i - i_start] = a.lists[list].items[i].sort_flags
    }
    info
}

// Whether built-in window function `id` (cat.FI_*) is window w's.
wfunc_is: fn(p: cg.Parse, a: ast.AST, w: Int, id: Int) -> Bool Never! {
    d: p.wfuncs[a.windows[w].wfunc]
    d.flags.bit_and(conn.FUNC_BUILTIN) != 0 && d.impl_id == id
}

// selectWindowRewriteExprCb with selectWindowRewriteSelectCb: a column,
// aggregate or window function outside the window list mwin moves to the
// subquery's result list (the walk's u), and becomes a column of the
// ephemeral table of mwin.iEphCsr. Within a scalar subquery (u2) only the
// columns of the outer SELECT's FROM list src move.
WindowRewriteWalker: struct {
    mwin: Int
    src: Int
    tab: Int

    impl WalkCb {
        on_expr: fn(self, p: &cg.Parse, a: &ast.AST, e: Int) -[DB]> Int Never! {
            t: cg.walk_top(p)
            op: a.exprs[e].op
            if p.walks[t].u2 >= 0 {
                if op != tk.TK_COLUMN -> return ast.WRC_CONTINUE
                found := false
                loop i in 0..<ast.src_len(a, self.src) {
                    si: ast.src_item(a, self.src, i)
                    if a.exprs[e].itable == a.items[si].cursor {
                        found = true
                        break
                    }
                }
                if !found -> return ast.WRC_CONTINUE
            }
            if op == tk.TK_FUNCTION {
                if !ast.has(a, e, ast.EP_WIN_FUNC) -> return ast.WRC_CONTINUE
                win := self.mwin
                loop win >= 0 {
                    if a.exprs[e].y == win -> return ast.WRC_PRUNE
                    win = a.windows[win].next_win
                }
            } else if op != tk.TK_IF_NULL_ROW && op != tk.TK_AGG_FUNCTION && op != tk.TK_COLUMN {
                return ast.WRC_CONTINUE
            }
            if p.db.malloc_failed -> return ast.WRC_ABORT
            sub := p.walks[t].u
            icol := -1
            loop i in 0..<ast.list_len(a, sub) {
                x: ast.list_expr(a, sub, i)
                if ast.expr_compare(a, x, e, -1) == 0 {
                    icol = i
                    break
                }
            }
            if icol < 0 {
                dup: ast.expr_dup(a, e, 0)
                if a.exprs[dup].op == tk.TK_AGG_FUNCTION -> a.exprs[dup].op = tk.TK_FUNCTION
                sub = ast.expr_list_append(a, sub, dup)
                p.walks[t].u = sub
            }
            f: a.exprs[e].flags.bit_and(ast.EP_COLLATE)
            ast.expr_delete(a, e)
            n := ast.zero_expr(tk.TK_COLUMN)
            n.icolumn = if icol < 0 -> ast.list_len(a, sub) - 1 else -> icol
            n.itable = a.windows[self.mwin].eph_csr
            n.y = self.tab
            n.flags = f
            a.exprs[e] = n
            if p.db.malloc_failed -> return ast.WRC_ABORT
            ast.WRC_CONTINUE
        }
        has_select: fn(self) -[]> Bool Never! { true }
        on_select: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) -[DB]> Int Never! {
            t: cg.walk_top(p)
            save: p.walks[t].u2
            if save == s -> return ast.WRC_CONTINUE
            p.walks[t].u2 = s
            _: cg.pwalk_select(p, a, s)
            p.walks[t].u2 = save
            ast.WRC_PRUNE
        }
        has_select2: fn(self) -[]> Bool Never! { false }
        on_select2: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) Never! -[DB]> {}
        win_defn: fn(self) -[]> Bool Never! { false }
    }
}

// selectWindowRewriteEList: rewrite the terms of `elist`, appending what
// moves to the subquery's result list `sub`; the list, made at the first
// append when sub is -1.
select_window_rewrite_elist: fn(p: &cg.Parse, a: &ast.AST, mwin: Int, src: Int, elist: Int, tab: Int, sub: Int) -[DB]> Int Never! {
    w := WindowRewriteWalker{mwin: mwin, src: src, tab: tab}
    cg.walk_push(p, w, sub)
    t: cg.walk_top(p)
    p.walks[t].u2 = -1
    _: cg.pwalk_expr_list(p, a, elist)
    st: cg.walk_pop(p)
    st.u
}

// exprListAppendList: `list` with a copy of each term of `append`, its
// sort flags kept; with int_to_null an integer literal copies as NULL.
expr_list_append_list: fn(a: &ast.AST, list0: Int, append: Int, int_to_null: Bool) -> Int Never! {
    if append < 0 -> return list0
    list := list0
    n_init: ast.list_len(a, list)
    loop i in 0..<ast.list_len(a, append) {
        src: ast.list_expr(a, append, i)
        dup: ast.expr_dup(a, src, 0)
        if int_to_null {
            sub: ast.skip_collate_and_likely(a, dup)
            if ast.expr_is_integer(a, sub) != None {
                a.exprs[sub].op = tk.TK_NULL
                a.exprs[sub].flags = util.clear_bits(a.exprs[sub].flags, ast.EP_INT_VALUE.bit_or(ast.EP_IS_TRUE).bit_or(ast.EP_IS_FALSE))
                a.exprs[sub].token = None
            }
        }
        list = ast.expr_list_append(a, list, dup)
        a.lists[list].items[n_init + i].sort_flags = a.lists[append].items[i].sort_flags
    }
    list
}

// sqlite3WindowExtraAggFuncDepth with sqlite3WalkerDepthIncrease and
// sqlite3WalkerDepthDecrease: an aggregate of an outer query, under the
// new subquery, is a level further out.
WindowAggDepthWalker: struct {
    unused: Int

    impl WalkCb {
        on_expr: fn(self, p: &cg.Parse, a: &ast.AST, e: Int) -[DB]> Int Never! {
            t: cg.walk_top(p)
            if a.exprs[e].op == tk.TK_AGG_FUNCTION && a.exprs[e].op2 >= p.walks[t].depth -> a.exprs[e].op2 += 1
            ast.WRC_CONTINUE
        }
        has_select: fn(self) -[]> Bool Never! { true }
        on_select: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) -[DB]> Int Never! { cg.walker_depth_increase(p) }
        has_select2: fn(self) -[]> Bool Never! { true }
        on_select2: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) Never! -[DB]> { cg.walker_depth_decrease(p) }
        win_defn: fn(self) -[]> Bool Never! { false }
    }
}

// disallowAggregatesInOrderByCb: an aggregate in the ORDER BY of a SELECT
// that is no aggregate query is an error.
DisallowAggOrderByWalker: struct {
    unused: Int

    impl WalkCb {
        on_expr: fn(self, p: &cg.Parse, a: &ast.AST, e: Int) -[DB]> Int Never! {
            if a.exprs[e].op == tk.TK_AGG_FUNCTION && a.exprs[e].agg_info < 0 {
                name: ast.text(a.exprs[e].token ?? [U8]{})
                ast.error(a, "misuse of aggregate: {name}()")
            }
            ast.WRC_CONTINUE
        }
        has_select: fn(self) -[]> Bool Never! { false }
        on_select: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) -[DB]> Int Never! { ast.WRC_CONTINUE }
        has_select2: fn(self) -[]> Bool Never! { false }
        on_select2: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) Never! -[DB]> {}
        win_defn: fn(self) -[]> Bool Never! { false }
    }
}

// Whether the first terms of `sort` match `ob`, term for term
// (sqlite3ExprListCompare over pSort cut to pOrderBy's length).
expr_list_prefix_same: fn(a: &ast.AST, sort: Int, ob: Int) -> Bool Never! {
    loop i in 0..<ast.list_len(a, ob) {
        if a.lists[sort].items[i].sort_flags != a.lists[ob].items[i].sort_flags -> return false
        x: ast.list_expr(a, sort, i)
        y: ast.list_expr(a, ob, i)
        if ast.expr_compare(a, x, y, -1) != 0 -> return false
    }
    true
}

// sqlite3WindowRewrite: a SELECT with window functions reads, in the
// order the windows need, a subquery of its FROM, WHERE, GROUP BY and
// HAVING that yields the columns, aggregates and arguments it uses. A
// no-op for a SELECT without them; an error code, with the error left,
// on failure.
window_rewrite: fn(p: &cg.Parse, a: &ast.AST, s: Int) -[DB]> Int Never! {
    rc := base.OK
    if a.selects[s].win < 0 || a.selects[s].prior >= 0 || a.selects[s].sel_flags.bit_and(ast.SF_WIN_REWRITE) != 0 || ast.in_rename(a) -> return rc
    cg.get_vdbe(p)
    src: a.selects[s].src
    where_e: a.selects[s].where_expr
    group_by: a.selects[s].group_by
    having: a.selects[s].having
    mwin: a.selects[s].win
    sel_flags: a.selects[s].sel_flags
    tab: conn.table_alloc(p.db)
    ex.agg_info_persist_select(p, a, s)
    if sel_flags.bit_and(ast.SF_AGGREGATE) == 0 {
        w := DisallowAggOrderByWalker{unused: 0}
        cg.walk_push(p, w, 0)
        ob: a.selects[s].order_by
        _: cg.pwalk_expr_list(p, a, ob)
        _: cg.walk_pop(p)
    }
    a.selects[s].src = -1
    a.selects[s].where_expr = -1
    a.selects[s].group_by = -1
    a.selects[s].having = -1
    a.selects[s].sel_flags = util.clear_bits(a.selects[s].sel_flags, ast.SF_AGGREGATE).bit_or(ast.SF_WIN_REWRITE)

    // The subquery's ORDER BY is the window's PARTITION BY and ORDER BY;
    // the SELECT's own ORDER BY goes when that makes it redundant.
    part: a.windows[mwin].partition
    wob: a.windows[mwin].order_by
    sort := expr_list_append_list(a, -1, part, true)
    sort = expr_list_append_list(a, sort, wob, true)
    ob: a.selects[s].order_by
    if sort >= 0 && ob >= 0 && ast.list_len(a, ob) <= ast.list_len(a, sort) && expr_list_prefix_same(a, sort, ob) {
        ast.expr_list_delete(a, ob)
        a.selects[s].order_by = -1
    }

    // The cursor of the ephemeral table that buffers rows, and its three
    // duplicates; opened once its width is known.
    a.windows[mwin].eph_csr = p.f.n_tab
    p.f.n_tab += 4

    elist: a.selects[s].elist
    sublist := select_window_rewrite_elist(p, a, mwin, src, elist, tab, -1)
    ob2: a.selects[s].order_by
    sublist = select_window_rewrite_elist(p, a, mwin, src, ob2, tab, sublist)
    a.windows[mwin].nbuffer_col = ast.list_len(a, sublist)

    // The PARTITION BY and ORDER BY values mark the partition and peer
    // boundaries; each function's arguments follow, and two registers each
    // for its accumulator and result.
    sublist = expr_list_append_list(a, sublist, part, false)
    sublist = expr_list_append_list(a, sublist, wob, false)
    win := mwin
    loop win >= 0 {
        owner: a.windows[win].owner
        args: a.exprs[owner].x
        d: p.wfuncs[a.windows[win].wfunc]
        if d.flags.bit_and(conn.FUNC_SUBTYPE) != 0 {
            sublist = select_window_rewrite_elist(p, a, mwin, src, args, tab, sublist)
            a.windows[win].iarg_col = ast.list_len(a, sublist)
            a.windows[win].expr_args = true
        } else {
            a.windows[win].iarg_col = ast.list_len(a, sublist)
            sublist = expr_list_append_list(a, sublist, args, false)
        }
        filter: a.windows[win].filter
        if filter >= 0 {
            fd: ast.expr_dup(a, filter, 0)
            sublist = ast.expr_list_append(a, sublist, fd)
        }
        p.f.n_mem += 1
        a.windows[win].reg_accum = p.f.n_mem
        p.f.n_mem += 1
        a.windows[win].reg_result = p.f.n_mem
        _: cg.op2(p, opc.OP_NULL, 0, a.windows[win].reg_accum)
        win = a.windows[win].next_win
    }

    // A constant keeps the subquery legal when it would select nothing
    // ("SELECT row_number() OVER () FROM t1").
    if sublist < 0 {
        zero: ast.expr(a, tk.TK_INTEGER, "0".bytes())
        sublist = ast.expr_list_append(a, -1, zero)
    }

    sub: ast.select_new(a, sublist, src, where_e, group_by, having, sort, 0, -1)
    new_src: ast.src_list_append(a, -1, None, None)
    a.selects[s].src = new_src
    si: ast.src_item(a, new_src, 0)
    a.items[si].select = sub
    a.items[si].is_correlated = true
    p.f.n_tab = ast.src_list_assign_cursors(a, new_src, p.f.n_tab)
    a.selects[sub].sel_flags = a.selects[sub].sel_flags.bit_or(ast.SF_EXPANDED).bit_or(ast.SF_ORDER_BY_REQD)
    g := p.up
    tab2: g.result_set_of_select(p, a, sub, base.AFF_NONE)
    a.selects[sub].sel_flags = a.selects[sub].sel_flags.bit_or(sel_flags.bit_and(ast.SF_AGGREGATE))
    if tab2 < 0 {
        // Perhaps some other error, which then is the Parse's.
        rc = base.NOMEM
        conn.delete_table_now(p.db, tab)
    } else {
        eph_tab := p.db.tables[tab2].copy()
        eph_tab.tab_flags = eph_tab.tab_flags.bit_or(ast.TF_EPHEMERAL)
        p.db.tables[tab] = eph_tab
        a.items[si].tab = tab
        conn.delete_table_now(p.db, tab2)
        w := WindowAggDepthWalker{unused: 0}
        cg.walk_push(p, w, 0)
        _: cg.pwalk_select(p, a, sub)
        _: cg.walk_pop(p)
    }
    if p.db.malloc_failed -> rc = base.NOMEM
    rc
}

// ---------------------------------------------------------------------------
// Code generation.

// sqlite3WindowCodeInit: before sqlite3WhereBegin over the rewritten
// SELECT s, the cursors and registers sqlite3WindowCodeStep uses.
window_code_init: fn(p: &cg.Parse, a: &ast.AST, s: Int) Never! {
    si0: ast.src_item(a, a.selects[s].src, 0)
    sub: a.items[si0].select
    n_eph_expr: ast.list_len(a, a.selects[sub].elist)
    mwin: a.selects[s].win
    cg.get_vdbe(p)
    eph: a.windows[mwin].eph_csr
    _: cg.op2(p, opc.OP_OPEN_EPHEMERAL, eph, n_eph_expr)
    _: cg.op2(p, opc.OP_OPEN_DUP, eph + 1, eph)
    _: cg.op2(p, opc.OP_OPEN_DUP, eph + 2, eph)
    _: cg.op2(p, opc.OP_OPEN_DUP, eph + 3, eph)

    // The PARTITION BY values' registers, NULL to begin with.
    part: a.windows[mwin].partition
    if part >= 0 {
        n_expr: ast.list_len(a, part)
        reg_part: p.f.n_mem + 1
        a.windows[mwin].reg_part = reg_part
        p.f.n_mem += n_expr
        _: cg.op3(p, opc.OP_NULL, 0, reg_part, reg_part + n_expr - 1)
    }

    p.f.n_mem += 1
    a.windows[mwin].reg_one = p.f.n_mem
    _: cg.op2(p, opc.OP_INTEGER, 1, p.f.n_mem)

    if a.windows[mwin].exclude != 0 {
        p.f.n_mem += 1
        a.windows[mwin].reg_start_rowid = p.f.n_mem
        p.f.n_mem += 1
        a.windows[mwin].reg_end_rowid = p.f.n_mem
        csr_app: p.f.n_tab
        p.f.n_tab += 1
        a.windows[mwin].csr_app = csr_app
        _: cg.op2(p, opc.OP_INTEGER, 1, a.windows[mwin].reg_start_rowid)
        _: cg.op2(p, opc.OP_INTEGER, 0, a.windows[mwin].reg_end_rowid)
        _: cg.op2(p, opc.OP_OPEN_DUP, csr_app, eph)
        return
    }

    win := mwin
    loop win >= 0 {
        d: p.wfuncs[a.windows[win].wfunc].copy()
        if d.flags.bit_and(conn.FUNC_MINMAX) != 0 && a.windows[win].start_type != tk.TK_UNBOUNDED {
            // The inline min() and max(): an ephemeral index and three
            // registers, for the argument copied for OP_MakeRecord, an
            // integer that keeps keys unique, and the record.
            owner: a.windows[win].owner
            list: a.exprs[owner].x
            key := key_info_from_expr_list(p, a, list, 0, 0)
            csr_app: p.f.n_tab
            p.f.n_tab += 1
            a.windows[win].csr_app = csr_app
            reg_app: p.f.n_mem + 1
            a.windows[win].reg_app = reg_app
            p.f.n_mem += 3
            // max() orders its index descending: "min" has an 'i' second.
            if Int.from_u8(d.name[1]) == 105 -> key.sort_flags[0] = base.KEYINFO_ORDER_DESC
            _: cg.op2(p, opc.OP_OPEN_EPHEMERAL, csr_app, 2)
            cg.v_append_p4(p, conn.P4.KeyInfo(key))
            _: cg.op2(p, opc.OP_INTEGER, 0, reg_app + 1)
        } else if wfunc_is(p, a, win, cat.FI_NTH_VALUE) || wfunc_is(p, a, win, cat.FI_FIRST_VALUE) {
            // Two registers, the current frame's first and last index.
            a.windows[win].reg_app = p.f.n_mem + 1
            csr_app: p.f.n_tab
            p.f.n_tab += 1
            a.windows[win].csr_app = csr_app
            p.f.n_mem += 2
            _: cg.op2(p, opc.OP_OPEN_DUP, csr_app, eph)
        } else if wfunc_is(p, a, win, cat.FI_LEAD) || wfunc_is(p, a, win, cat.FI_LAG) {
            csr_app: p.f.n_tab
            p.f.n_tab += 1
            a.windows[win].csr_app = csr_app
            _: cg.op2(p, opc.OP_OPEN_DUP, csr_app, eph)
        }
        win = a.windows[win].next_win
    }
}

// windowCheckValue's eCond: a PRECEDING or FOLLOWING value, or
// nth_value()'s second argument.
WINDOW_STARTING_INT: 0
WINDOW_ENDING_INT: 1
WINDOW_NTH_VALUE_INT: 2
WINDOW_STARTING_NUM: 3
WINDOW_ENDING_NUM: 4

// windowCheckValue: code that halts with an error unless register reg,
// just evaluated for eCond `e_cond`, is a non-negative integer (a
// positive one for nth_value(), a non-negative number for RANGE).
window_check_value: fn(p: &cg.Parse, reg: Int, e_cond: Int) Never! {
    errs: [String]{"frame starting offset must be a non-negative integer", "frame ending offset must be a non-negative integer", "second argument to nth_value must be a positive integer", "frame starting offset must be a non-negative number", "frame ending offset must be a non-negative number"}
    ops: [Int]{opc.OP_GE, opc.OP_GE, opc.OP_GT, opc.OP_GE, opc.OP_GE}
    cg.get_vdbe(p)
    reg_zero: cg.get_temp_reg(p)
    _: cg.op2(p, opc.OP_INTEGER, 0, reg_zero)
    if e_cond >= WINDOW_STARTING_NUM {
        reg_string: cg.get_temp_reg(p)
        _: cg.op4_text(p, opc.OP_STRING8, 0, reg_string, 0, [U8]{})
        here: cg.v_current_addr(p)
        _: cg.op3(p, opc.OP_GE, reg_string, here + 2, reg)
        cg.v_change_p5(p, base.AFF_NUMERIC.bit_or(conn.CMP_JUMPIFNULL))
    } else {
        here: cg.v_current_addr(p)
        _: cg.op2(p, opc.OP_MUST_BE_INT, reg, here + 2)
    }
    here: cg.v_current_addr(p)
    _: cg.op3(p, ops[e_cond], reg_zero, here + 2, reg)
    cg.v_change_p5(p, base.AFF_NUMERIC)
    cg.may_abort(p)
    _: cg.op2(p, opc.OP_HALT, base.ERROR, ast.OE_ABORT)
    cg.v_append_p4(p, conn.P4.Text(errs[e_cond].bytes()))
    cg.release_temp_reg(p, reg_zero)
}

// windowArgCount: the number of arguments of window w's function.
window_arg_count: fn(a: ast.AST, w: Int) -> Int Never! {
    owner: a.windows[w].owner
    ast.list_len(a, a.exprs[owner].x)
}

// struct WindowCodeArg with its WindowCsrAndReg members flattened: the
// state sqlite3WindowCodeStep's helpers share. e_delete is the step after
// which a buffered row may go (WINDOW_RETURN_ROW .. WINDOW_AGGSTEP, or 0
// for never); the start, current and end cursors each have the registers
// that hold the peer values of their row (0 for none).
WindowCodeArg: struct {
    mwin: Int
    addr_gosub: Int
    reg_gosub: Int
    reg_arg: Int
    e_delete: Int
    reg_rowid: Int
    start_csr: Int
    start_reg: Int
    current_csr: Int
    current_reg: Int
    end_csr: Int
    end_reg: Int
}

// windowCodeOp's op, and WindowCodeArg.e_delete.
WINDOW_RETURN_ROW: 1
WINDOW_AGGINVERSE: 2
WINDOW_AGGSTEP: 3

// windowReadPeerValues: code that reads the window's ORDER BY (peer)
// values of the row of cursor csr into the registers from reg.
window_read_peer_values: fn(p: &cg.Parse, a: &ast.AST, s: WindowCodeArg, csr: Int, reg: Int) Never! {
    ob: a.windows[s.mwin].order_by
    if ob < 0 -> return
    part: a.windows[s.mwin].partition
    i_col_off: a.windows[s.mwin].nbuffer_col + ast.list_len(a, part)
    loop i in 0..<ast.list_len(a, ob) -> _: cg.op3(p, opc.OP_COLUMN, csr, i_col_off + i, reg + i)
}

// windowAggStep: code that calls xStep (xInverse with inverse) of each
// function of the window list mwin on the row of cursor csr, its
// arguments read into the registers from reg; or the inline code of the
// built-in functions that take none of the function API.
window_agg_step: fn(p: &cg.Parse, a: &ast.AST, mwin: Int, csr: Int, inverse: Bool, reg: Int) Never! -[DB]> {
    eph: a.windows[mwin].eph_csr
    b_inverse: if inverse -> 1 else -> 0
    win := mwin
    loop win >= 0 {
        w: a.windows[win].copy()
        d: p.wfuncs[w.wfunc].copy()
        n_arg := if w.expr_args -> 0 else -> window_arg_count(a, win)
        is_nth: wfunc_is(p, a, win, cat.FI_NTH_VALUE)
        loop i in 0..<n_arg {
            c: if i != 1 || !is_nth -> csr else -> eph
            _: cg.op3(p, opc.OP_COLUMN, c, w.iarg_col + i, reg + i)
        }
        reg_arg := reg
        is_noop: wfunc_is(p, a, win, cat.FI_LEAD) || wfunc_is(p, a, win, cat.FI_LAG)
        if a.windows[mwin].reg_start_rowid == 0 && d.flags.bit_and(conn.FUNC_MINMAX) != 0 && w.start_type != tk.TK_UNBOUNDED {
            addr_is_null: cg.op1(p, opc.OP_IS_NULL, reg_arg)
            if !inverse {
                _: cg.op2(p, opc.OP_ADD_IMM, w.reg_app + 1, 1)
                _: cg.op2(p, opc.OP_SCOPY, reg_arg, w.reg_app)
                _: cg.op3(p, opc.OP_MAKE_RECORD, w.reg_app, 2, w.reg_app + 2)
                _: cg.op2(p, opc.OP_IDX_INSERT, w.csr_app, w.reg_app + 2)
            } else {
                _: cg.op4_int(p, opc.OP_SEEK_GE, w.csr_app, 0, reg_arg, 1)
                _: cg.op1(p, opc.OP_DELETE, w.csr_app)
                here: cg.v_current_addr(p)
                cg.v_jump_here(p, here - 2)
            }
            cg.v_jump_here(p, addr_is_null)
        } else if w.reg_app != 0 {
            _: cg.op2(p, opc.OP_ADD_IMM, w.reg_app + 1 - b_inverse, 1)
        } else if !is_noop {
            addr_if := 0
            if w.filter >= 0 {
                reg_tmp: cg.get_temp_reg(p)
                _: cg.op3(p, opc.OP_COLUMN, csr, w.iarg_col + n_arg, reg_tmp)
                addr_if = cg.op3(p, opc.OP_IF_NOT, reg_tmp, 0, 1)
                cg.release_temp_reg(p, reg_tmp)
            }
            owner_args: a.exprs[w.owner].x
            if w.expr_args {
                // The arguments coded in place, their reads of the
                // ephemeral table's row made reads of csr's.
                i_op := cg.v_current_addr(p)
                n_arg = ast.list_len(a, owner_args)
                reg_arg = cg.get_temp_range(p, n_arg)
                _: ex.expr_code_expr_list(p, a, owner_args, reg_arg, 0, 0)
                i_end: cg.v_current_addr(p)
                loop i_op < i_end {
                    o: cg.v_op_at(p, i_op)
                    if o.opcode == opc.OP_COLUMN && o.p1 == eph -> cg.v_change_p1(p, i_op, csr)
                    i_op += 1
                }
            }
            if d.flags.bit_and(conn.FUNC_NEEDCOLL) != 0 {
                e0: ast.list_expr(a, owner_args, 0)
                coll: ex.expr_nn_coll_seq(p, a, e0)
                _: cg.op4(p, opc.OP_COLL_SEQ, 0, 0, 0, conn.P4.Coll(coll))
            }
            opcode: if inverse -> opc.OP_AGG_INVERSE else -> opc.OP_AGG_STEP
            _: cg.op3(p, opcode, b_inverse, reg_arg, w.reg_accum)
            cg.v_append_p4(p, conn.P4.FuncDef(d))
            cg.v_change_p5(p, n_arg.bit_and(255))
            if w.expr_args -> cg.release_temp_range(p, reg_arg, n_arg)
            if addr_if != 0 -> cg.v_jump_here(p, addr_if)
        }
        win = w.next_win
    }
}

// windowAggFinal: code that calls xValue (xFinalize with fin) of each
// function of the window list, or computes the inline min() and max(),
// into their result registers.
window_agg_final: fn(p: &cg.Parse, a: &ast.AST, s: WindowCodeArg, fin: Bool) Never! {
    mwin: s.mwin
    win := mwin
    loop win >= 0 {
        w: a.windows[win].copy()
        d: p.wfuncs[w.wfunc].copy()
        if a.windows[mwin].reg_start_rowid == 0 && d.flags.bit_and(conn.FUNC_MINMAX) != 0 && w.start_type != tk.TK_UNBOUNDED {
            _: cg.op2(p, opc.OP_NULL, 0, w.reg_result)
            _: cg.op1(p, opc.OP_LAST, w.csr_app)
            _: cg.op3(p, opc.OP_COLUMN, w.csr_app, 0, w.reg_result)
            here: cg.v_current_addr(p)
            cg.v_jump_here(p, here - 2)
        } else if w.reg_app == 0 {
            n_arg: window_arg_count(a, win)
            if fin {
                _: cg.op2(p, opc.OP_AGG_FINAL, w.reg_accum, n_arg)
                cg.v_append_p4(p, conn.P4.FuncDef(d))
                _: cg.op2(p, opc.OP_COPY, w.reg_accum, w.reg_result)
                _: cg.op2(p, opc.OP_NULL, 0, w.reg_accum)
            } else {
                _: cg.op3(p, opc.OP_AGG_VALUE, w.reg_accum, n_arg, w.reg_result)
                cg.v_append_p4(p, conn.P4.FuncDef(d))
            }
        }
        win = w.next_win
    }
}

// windowFullScan: code that computes each function of the window list
// over a scan of the whole current frame (an EXCLUDE frame's way), into
// the result registers.
window_full_scan: fn(p: &cg.Parse, a: &ast.AST, s: WindowCodeArg) Never! -[DB]> {
    mwin: s.mwin
    mw: a.windows[mwin].copy()
    csr: mw.csr_app
    n_peer: ast.list_len(a, mw.order_by)
    lbl_next: cg.v_make_label(p)
    lbl_brk: cg.v_make_label(p)
    reg_c_rowid: cg.get_temp_reg(p)
    reg_rowid: cg.get_temp_reg(p)
    reg_c_peer := 0
    reg_peer := 0
    if n_peer != 0 {
        reg_c_peer = cg.get_temp_range(p, n_peer)
        reg_peer = cg.get_temp_range(p, n_peer)
    }
    _: cg.op2(p, opc.OP_ROWID, mw.eph_csr, reg_c_rowid)
    window_read_peer_values(p, a, s, mw.eph_csr, reg_c_peer)
    win := mwin
    loop win >= 0 {
        _: cg.op2(p, opc.OP_NULL, 0, a.windows[win].reg_accum)
        win = a.windows[win].next_win
    }
    _: cg.op3(p, opc.OP_SEEK_GE, csr, lbl_brk, mw.reg_start_rowid)
    addr_next: cg.v_current_addr(p)
    _: cg.op2(p, opc.OP_ROWID, csr, reg_rowid)
    _: cg.op3(p, opc.OP_GT, mw.reg_end_rowid, lbl_brk, reg_rowid)
    if mw.exclude == tk.TK_CURRENT {
        _: cg.op3(p, opc.OP_EQ, reg_c_rowid, lbl_next, reg_rowid)
    } else if mw.exclude != tk.TK_NO {
        addr_eq := 0
        if mw.exclude == tk.TK_TIES -> addr_eq = cg.op3(p, opc.OP_EQ, reg_c_rowid, 0, reg_rowid)
        if mw.order_by >= 0 {
            key: key_info_from_expr_list(p, a, mw.order_by, 0, 0)
            window_read_peer_values(p, a, s, csr, reg_peer)
            _: cg.op3(p, opc.OP_COMPARE, reg_peer, reg_c_peer, n_peer)
            cg.v_append_p4(p, conn.P4.KeyInfo(key))
            addr: cg.v_current_addr(p) + 1
            _: cg.op3(p, opc.OP_JUMP, addr, lbl_next, addr)
        } else {
            _: cg.op2(p, opc.OP_GOTO, 0, lbl_next)
        }
        if addr_eq != 0 -> cg.v_jump_here(p, addr_eq)
    }
    window_agg_step(p, a, mwin, csr, false, s.reg_arg)
    cg.v_resolve_label(p, lbl_next)
    _: cg.op2(p, opc.OP_NEXT, csr, addr_next)
    cg.v_jump_here(p, addr_next - 1)
    cg.v_jump_here(p, addr_next + 1)
    cg.release_temp_reg(p, reg_rowid)
    cg.release_temp_reg(p, reg_c_rowid)
    if n_peer != 0 {
        cg.release_temp_range(p, reg_peer, n_peer)
        cg.release_temp_range(p, reg_c_peer, n_peer)
    }
    window_agg_final(p, a, s, true)
}

// windowReturnOneRow: code that returns the current row of the ephemeral
// table through the subroutine at s.addr_gosub, computing first the
// built-in functions that read rows themselves (nth_value(),
// first_value(), lead(), lag()).
window_return_one_row: fn(p: &cg.Parse, a: &ast.AST, s: WindowCodeArg) Never! -[DB]> {
    mwin: s.mwin
    if a.windows[mwin].reg_start_rowid != 0 {
        window_full_scan(p, a, s)
    } else {
        eph: a.windows[mwin].eph_csr
        win := mwin
        loop win >= 0 {
            w: a.windows[win].copy()
            is_nth: wfunc_is(p, a, win, cat.FI_NTH_VALUE)
            is_lead: wfunc_is(p, a, win, cat.FI_LEAD)
            if is_nth || wfunc_is(p, a, win, cat.FI_FIRST_VALUE) {
                csr: w.csr_app
                lbl: cg.v_make_label(p)
                tmp_reg: cg.get_temp_reg(p)
                _: cg.op2(p, opc.OP_NULL, 0, w.reg_result)
                if is_nth {
                    _: cg.op3(p, opc.OP_COLUMN, eph, w.iarg_col + 1, tmp_reg)
                    window_check_value(p, tmp_reg, WINDOW_NTH_VALUE_INT)
                } else {
                    _: cg.op2(p, opc.OP_INTEGER, 1, tmp_reg)
                }
                _: cg.op3(p, opc.OP_ADD, tmp_reg, w.reg_app, tmp_reg)
                _: cg.op3(p, opc.OP_GT, w.reg_app + 1, lbl, tmp_reg)
                _: cg.op3(p, opc.OP_SEEK_ROWID, csr, 0, tmp_reg)
                _: cg.op3(p, opc.OP_COLUMN, csr, w.iarg_col, w.reg_result)
                cg.v_resolve_label(p, lbl)
                cg.release_temp_reg(p, tmp_reg)
            } else if is_lead || wfunc_is(p, a, win, cat.FI_LAG) {
                n_arg: window_arg_count(a, win)
                csr: w.csr_app
                lbl: cg.v_make_label(p)
                tmp_reg: cg.get_temp_reg(p)
                if n_arg < 3 {
                    _: cg.op2(p, opc.OP_NULL, 0, w.reg_result)
                } else {
                    _: cg.op3(p, opc.OP_COLUMN, eph, w.iarg_col + 2, w.reg_result)
                }
                _: cg.op2(p, opc.OP_ROWID, eph, tmp_reg)
                if n_arg < 2 {
                    val: if is_lead -> 1 else -> 0 - 1
                    _: cg.op2(p, opc.OP_ADD_IMM, tmp_reg, val)
                } else {
                    op: if is_lead -> opc.OP_ADD else -> opc.OP_SUBTRACT
                    tmp_reg2: cg.get_temp_reg(p)
                    _: cg.op3(p, opc.OP_COLUMN, eph, w.iarg_col + 1, tmp_reg2)
                    _: cg.op3(p, op, tmp_reg2, tmp_reg, tmp_reg)
                    cg.release_temp_reg(p, tmp_reg2)
                }
                _: cg.op3(p, opc.OP_SEEK_ROWID, csr, lbl, tmp_reg)
                _: cg.op3(p, opc.OP_COLUMN, csr, w.iarg_col, w.reg_result)
                cg.v_resolve_label(p, lbl)
                cg.release_temp_reg(p, tmp_reg)
            }
            win = w.next_win
        }
    }
    _: cg.op2(p, opc.OP_GOSUB, s.reg_gosub, s.addr_gosub)
}

// windowInitAccum: code that clears each accumulator of the window list
// and the state of the built-in functions that keep their own; the first
// of the registers for the largest argument list.
window_init_accum: fn(p: &cg.Parse, a: &ast.AST, mwin: Int) -> Int Never! {
    cg.get_vdbe(p)
    n_arg := 0
    win := mwin
    loop win >= 0 {
        w: a.windows[win].copy()
        d: p.wfuncs[w.wfunc]
        _: cg.op2(p, opc.OP_NULL, 0, w.reg_accum)
        n: window_arg_count(a, win)
        if n > n_arg -> n_arg = n
        if a.windows[mwin].reg_start_rowid == 0 {
            if wfunc_is(p, a, win, cat.FI_NTH_VALUE) || wfunc_is(p, a, win, cat.FI_FIRST_VALUE) {
                _: cg.op2(p, opc.OP_INTEGER, 0, w.reg_app)
                _: cg.op2(p, opc.OP_INTEGER, 0, w.reg_app + 1)
            }
            if d.flags.bit_and(conn.FUNC_MINMAX) != 0 && w.csr_app != 0 {
                _: cg.op1(p, opc.OP_RESET_SORTER, w.csr_app)
                _: cg.op2(p, opc.OP_INTEGER, 0, w.reg_app + 1)
            }
        }
        win = w.next_win
    }
    reg_arg: p.f.n_mem + 1
    p.f.n_mem += n_arg
    reg_arg
}

// windowCacheFrame: whether the frame must be kept in the ephemeral table
// though no xInverse needs it.
window_cache_frame: fn(p: cg.Parse, a: ast.AST, mwin: Int) -> Bool Never! {
    if a.windows[mwin].reg_start_rowid != 0 -> return true
    win := mwin
    loop win >= 0 {
        if wfunc_is(p, a, win, cat.FI_NTH_VALUE) || wfunc_is(p, a, win, cat.FI_FIRST_VALUE) || wfunc_is(p, a, win, cat.FI_LEAD) || wfunc_is(p, a, win, cat.FI_LAG) -> return true
        win = a.windows[win].next_win
    }
    false
}

// windowIfNewPeer: code that, when the ORDER BY values from reg_new differ
// from those from reg_old, copies them over and falls through; else jumps
// to addr.
window_if_new_peer: fn(p: &cg.Parse, a: &ast.AST, ob: Int, reg_new: Int, reg_old: Int, addr: Int) Never! {
    cg.get_vdbe(p)
    if ob >= 0 {
        n_val: ast.list_len(a, ob)
        key: key_info_from_expr_list(p, a, ob, 0, 0)
        _: cg.op3(p, opc.OP_COMPARE, reg_old, reg_new, n_val)
        cg.v_append_p4(p, conn.P4.KeyInfo(key))
        here: cg.v_current_addr(p) + 1
        _: cg.op3(p, opc.OP_JUMP, here, addr, here)
        _: cg.op3(p, opc.OP_COPY, reg_new, reg_old, n_val - 1)
    } else {
        _: cg.op2(p, opc.OP_GOTO, 0, addr)
    }
}

// windowCodeRangeTest: for a RANGE offset frame, code that jumps to lbl
// when csr1's peer value plus reg_val compares to csr2's by op0 (OP_Ge,
// OP_Gt or OP_Le); for a DESC term, the value less reg_val compared the
// other way. A value that is no number takes no arithmetic, and for
// NULLS LAST (BIGNULL) NULL is above everything.
window_code_range_test: fn(p: &cg.Parse, a: &ast.AST, s: WindowCodeArg, op0: Int, csr1: Int, reg_val: Int, csr2: Int, lbl: Int) Never! {
    ob: a.windows[s.mwin].order_by
    reg1: cg.get_temp_reg(p)
    reg2: cg.get_temp_reg(p)
    p.f.n_mem += 1
    reg_string: p.f.n_mem
    arith := opc.OP_ADD
    addr_done: cg.v_make_label(p)
    window_read_peer_values(p, a, s, csr1, reg1)
    window_read_peer_values(p, a, s, csr2, reg2)
    op := op0
    sf: a.lists[ob].items[0].sort_flags
    if sf.bit_and(base.KEYINFO_ORDER_DESC) != 0 {
        if op == opc.OP_GE {
            op = opc.OP_LE
        } else if op == opc.OP_GT {
            op = opc.OP_LT
        } else {
            op = opc.OP_GE
        }
        arith = opc.OP_SUBTRACT
    }
    if sf.bit_and(base.KEYINFO_ORDER_BIGNULL) != 0 {
        // reg1 is NULL.
        addr: cg.op1(p, opc.OP_NOT_NULL, reg1)
        if op == opc.OP_GE {
            _: cg.op2(p, opc.OP_GOTO, 0, lbl)
        } else if op == opc.OP_GT {
            _: cg.op2(p, opc.OP_NOT_NULL, reg2, lbl)
        } else if op == opc.OP_LE {
            _: cg.op2(p, opc.OP_IS_NULL, reg2, lbl)
        }
        _: cg.op2(p, opc.OP_GOTO, 0, addr_done)
        // reg1 is not NULL, but reg2 is.
        cg.v_jump_here(p, addr)
        dest: if op == opc.OP_GT || op == opc.OP_GE -> addr_done else -> lbl
        _: cg.op2(p, opc.OP_IS_NULL, reg2, dest)
    }
    // reg1 takes reg_val unless it is no number: every string and blob is
    // at least ''.
    _: cg.op4_text(p, opc.OP_STRING8, 0, reg_string, 0, [U8]{})
    addr_ge: cg.op3(p, opc.OP_GE, reg_string, 0, reg1)
    if (op == opc.OP_GE && arith == opc.OP_ADD) || (op == opc.OP_LE && arith == opc.OP_SUBTRACT) -> _: cg.op3(p, op, reg2, lbl, reg1)
    _: cg.op3(p, arith, reg_val, reg1, reg1)
    cg.v_jump_here(p, addr_ge)
    _: cg.op3(p, op, reg2, lbl, reg1)
    e0: ast.list_expr(a, ob, 0)
    coll: ex.expr_nn_coll_seq(p, a, e0)
    cg.v_append_p4(p, conn.P4.Coll(coll))
    cg.v_change_p5(p, conn.CMP_NULLEQ)
    cg.v_resolve_label(p, addr_done)
    cg.release_temp_reg(p, reg1)
    cg.release_temp_reg(p, reg2)
}

// windowCodeOp: code for one RETURN_ROW, AGGSTEP or AGGINVERSE step (`op`)
// of sqlite3WindowCodeStep, run when the countdown register (if any)
// allows; with jump_on_eof, the address of the OP_Goto taken at the end
// of the stepped cursor, else 0.
window_code_op: fn(p: &cg.Parse, a: &ast.AST, s: WindowCodeArg, op: Int, reg_countdown: Int, jump_on_eof: Bool) -[DB]> Int Never! {
    mw: a.windows[s.mwin].copy()
    ret := 0
    b_peer: mw.frm_type != tk.TK_ROWS
    lbl_done: cg.v_make_label(p)
    addr_next_range := 0

    // AGGINVERSE does nothing for a frame from UNBOUNDED PRECEDING.
    if op == WINDOW_AGGINVERSE && mw.start_type == tk.TK_UNBOUNDED -> return 0

    if reg_countdown > 0 {
        if mw.frm_type == tk.TK_RANGE {
            addr_next_range = cg.v_current_addr(p)
            if op == WINDOW_AGGINVERSE {
                if mw.start_type == tk.TK_FOLLOWING {
                    window_code_range_test(p, a, s, opc.OP_LE, s.current_csr, reg_countdown, s.start_csr, lbl_done)
                } else {
                    window_code_range_test(p, a, s, opc.OP_GE, s.start_csr, reg_countdown, s.current_csr, lbl_done)
                }
            } else {
                window_code_range_test(p, a, s, opc.OP_GT, s.end_csr, reg_countdown, s.current_csr, lbl_done)
            }
        } else {
            _: cg.op3(p, opc.OP_IF_POS, reg_countdown, lbl_done, 1)
        }
    }

    if op == WINDOW_RETURN_ROW && mw.reg_start_rowid == 0 -> window_agg_final(p, a, s, false)
    addr_continue: cg.v_current_addr(p)

    // For RANGE BETWEEN a FOLLOWING AND b FOLLOWING (or b PRECEDING AND a
    // PRECEDING), the start cursor stays behind the end cursor, and the
    // end cursor short of EOF while rows come in.
    if mw.start_type == mw.end_type && reg_countdown != 0 && mw.frm_type == tk.TK_RANGE {
        reg_rowid1: cg.get_temp_reg(p)
        reg_rowid2: cg.get_temp_reg(p)
        if op == WINDOW_AGGINVERSE {
            _: cg.op2(p, opc.OP_ROWID, s.start_csr, reg_rowid1)
            _: cg.op2(p, opc.OP_ROWID, s.end_csr, reg_rowid2)
            _: cg.op3(p, opc.OP_GE, reg_rowid2, lbl_done, reg_rowid1)
        } else if s.reg_rowid != 0 {
            _: cg.op2(p, opc.OP_ROWID, s.end_csr, reg_rowid1)
            _: cg.op3(p, opc.OP_GE, s.reg_rowid, lbl_done, reg_rowid1)
        }
        cg.release_temp_reg(p, reg_rowid1)
        cg.release_temp_reg(p, reg_rowid2)
    }

    csr := 0
    reg := 0
    if op == WINDOW_RETURN_ROW {
        csr = s.current_csr
        reg = s.current_reg
        window_return_one_row(p, a, s)
    } else if op == WINDOW_AGGINVERSE {
        csr = s.start_csr
        reg = s.start_reg
        if mw.reg_start_rowid != 0 {
            _: cg.op2(p, opc.OP_ADD_IMM, mw.reg_start_rowid, 1)
        } else {
            window_agg_step(p, a, s.mwin, csr, true, s.reg_arg)
        }
    } else {
        csr = s.end_csr
        reg = s.end_reg
        if mw.reg_start_rowid != 0 {
            _: cg.op2(p, opc.OP_ADD_IMM, mw.reg_end_rowid, 1)
        } else {
            window_agg_step(p, a, s.mwin, csr, false, s.reg_arg)
        }
    }

    if op == s.e_delete {
        _: cg.op1(p, opc.OP_DELETE, csr)
        cg.v_change_p5(p, conn.OPFLAG_SAVEPOSITION)
    }

    if jump_on_eof {
        here: cg.v_current_addr(p)
        _: cg.op2(p, opc.OP_NEXT, csr, here + 2)
        ret = cg.op0(p, opc.OP_GOTO)
    } else {
        here: cg.v_current_addr(p)
        skip: if b_peer -> 2 else -> 1
        _: cg.op2(p, opc.OP_NEXT, csr, here + skip)
        if b_peer -> _: cg.op2(p, opc.OP_GOTO, 0, lbl_done)
    }

    if b_peer {
        n_reg: ast.list_len(a, mw.order_by)
        reg_tmp: if n_reg != 0 -> cg.get_temp_range(p, n_reg) else -> 0
        window_read_peer_values(p, a, s, csr, reg_tmp)
        window_if_new_peer(p, a, mw.order_by, reg_tmp, reg, addr_continue)
        cg.release_temp_range(p, reg_tmp, n_reg)
    }

    if addr_next_range != 0 -> _: cg.op2(p, opc.OP_GOTO, 0, addr_next_range)
    cg.v_resolve_label(p, lbl_done)
    ret
}

// windowExprGtZero: whether `e` is known at compile time to be above zero
// as an integer.
window_expr_gt_zero: fn(p: cg.Parse, a: ast.AST, e: Int) -> Bool Never! {
    v: ex.value_from_expr(a, e, p.db.enc, base.AFF_NUMERIC)
    if v == .Val(m) -> return mem.value_int(m) > 0
    false
}

// sqlite3WindowCodeStep: within the loop sqlite3WhereBegin (wi) began over
// the rewritten SELECT sel's subquery, code that buffers each row, computes
// the window functions over their frames, and returns each row through the
// subroutine at addr_gosub (register reg_gosub); ends the loop with
// sqlite3WhereEnd. The frame shapes and the code each takes are
// window.c's header comment on this routine.
window_code_step: fn(p: &cg.Parse, a: &ast.AST, sel: Int, wi: &we.WhereInfo, reg_gosub: Int, addr_gosub: Int) Never! -[DB]> {
    mwin: a.selects[sel].win
    mw: a.windows[mwin].copy()
    ob: mw.order_by
    cg.get_vdbe(p)
    si0: ast.src_item(a, a.selects[sel].src, 0)
    csr_input: a.items[si0].cursor
    t_in: a.items[si0].tab
    n_input: p.db.tables[t_in].cols.len()
    lbl_where_end: cg.v_make_label(p)

    s := WindowCodeArg{mwin: mwin, addr_gosub: addr_gosub, reg_gosub: reg_gosub, reg_arg: 0, e_delete: 0, reg_rowid: 0, start_csr: mw.eph_csr + 2, start_reg: 0, current_csr: mw.eph_csr, current_reg: 0, end_csr: mw.eph_csr + 3, end_reg: 0}
    csr_write: mw.eph_csr + 1

    // When a buffered row may go: never (0), once out of the frame
    // (AGGINVERSE), once returned (RETURN_ROW), or once in it (AGGSTEP).
    if mw.start_type == tk.TK_FOLLOWING {
        if mw.frm_type != tk.TK_RANGE && window_expr_gt_zero(p, a, mw.start_expr) -> s.e_delete = WINDOW_RETURN_ROW
    } else if mw.start_type == tk.TK_UNBOUNDED {
        if !window_cache_frame(p, a, mwin) {
            if mw.end_type == tk.TK_PRECEDING {
                if mw.frm_type != tk.TK_RANGE && window_expr_gt_zero(p, a, mw.end_expr) -> s.e_delete = WINDOW_AGGSTEP
            } else {
                s.e_delete = WINDOW_RETURN_ROW
            }
        }
    } else {
        s.e_delete = WINDOW_AGGINVERSE
    }

    // The subquery row's values, as a record, and the rowid it goes in at.
    reg_new: p.f.n_mem + 1
    p.f.n_mem += n_input
    p.f.n_mem += 1
    reg_record: p.f.n_mem
    p.f.n_mem += 1
    s.reg_rowid = p.f.n_mem

    // The values of an <expr> PRECEDING or FOLLOWING.
    reg_start := 0
    reg_end := 0
    if mw.start_type == tk.TK_PRECEDING || mw.start_type == tk.TK_FOLLOWING {
        p.f.n_mem += 1
        reg_start = p.f.n_mem
    }
    if mw.end_type == tk.TK_PRECEDING || mw.end_type == tk.TK_FOLLOWING {
        p.f.n_mem += 1
        reg_end = p.f.n_mem
    }

    // Other than for ROWS, the peer values of the main loop and of each
    // cursor.
    reg_new_peer := 0
    reg_peer := 0
    if mw.frm_type != tk.TK_ROWS {
        n_peer: ast.list_len(a, ob)
        reg_new_peer = reg_new + mw.nbuffer_col + ast.list_len(a, mw.partition)
        reg_peer = p.f.n_mem + 1
        p.f.n_mem += n_peer
        s.start_reg = p.f.n_mem + 1
        p.f.n_mem += n_peer
        s.current_reg = p.f.n_mem + 1
        p.f.n_mem += n_peer
        s.end_reg = p.f.n_mem + 1
        p.f.n_mem += n_peer
    }

    loop i_input in 0..<n_input -> _: cg.op3(p, opc.OP_COLUMN, csr_input, i_input, reg_new + i_input)
    _: cg.op3(p, opc.OP_MAKE_RECORD, reg_new, n_input, reg_record)

    // A new partition flushes the one before, through a Gosub whose
    // target is filled in below.
    addr_gosub_flush := 0
    reg_flush_part := 0
    if mw.partition >= 0 {
        n_part: ast.list_len(a, mw.partition)
        reg_new_part: reg_new + mw.nbuffer_col
        key: key_info_from_expr_list(p, a, mw.partition, 0, 0)
        p.f.n_mem += 1
        reg_flush_part = p.f.n_mem
        addr: cg.op3(p, opc.OP_COMPARE, reg_new_part, mw.reg_part, n_part)
        cg.v_append_p4(p, conn.P4.KeyInfo(key))
        _: cg.op3(p, opc.OP_JUMP, addr + 2, addr + 4, addr + 2)
        addr_gosub_flush = cg.op1(p, opc.OP_GOSUB, reg_flush_part)
        _: cg.op3(p, opc.OP_COPY, reg_new_part, mw.reg_part, n_part - 1)
    }

    // The new row goes in the ephemeral table.
    _: cg.op2(p, opc.OP_NEW_ROWID, csr_write, s.reg_rowid)
    _: cg.op3(p, opc.OP_INSERT, csr_write, reg_record, s.reg_rowid)
    addr_ne: cg.op3(p, opc.OP_NE, mw.reg_one, 0, s.reg_rowid)

    // The first row of each partition.
    s.reg_arg = window_init_accum(p, a, mwin)
    range_off: if mw.frm_type == tk.TK_RANGE -> 3 else -> 0
    if reg_start != 0 {
        ex.expr_code(p, a, mw.start_expr, reg_start)
        window_check_value(p, reg_start, WINDOW_STARTING_INT + range_off)
    }
    if reg_end != 0 {
        ex.expr_code(p, a, mw.end_expr, reg_end)
        window_check_value(p, reg_end, WINDOW_ENDING_INT + range_off)
    }
    if mw.frm_type != tk.TK_RANGE && mw.start_type == mw.end_type && reg_start != 0 {
        op: if mw.start_type == tk.TK_FOLLOWING -> opc.OP_GE else -> opc.OP_LE
        addr_ge: cg.op3(p, op, reg_start, 0, reg_end)
        window_agg_final(p, a, s, false)
        _: cg.op1(p, opc.OP_REWIND, s.current_csr)
        window_return_one_row(p, a, s)
        _: cg.op1(p, opc.OP_RESET_SORTER, s.current_csr)
        _: cg.op2(p, opc.OP_GOTO, 0, lbl_where_end)
        cg.v_jump_here(p, addr_ge)
    }
    if mw.start_type == tk.TK_FOLLOWING && mw.frm_type != tk.TK_RANGE && reg_end != 0 -> _: cg.op3(p, opc.OP_SUBTRACT, reg_start, reg_end, reg_start)

    if mw.start_type != tk.TK_UNBOUNDED -> _: cg.op1(p, opc.OP_REWIND, s.start_csr)
    _: cg.op1(p, opc.OP_REWIND, s.current_csr)
    _: cg.op1(p, opc.OP_REWIND, s.end_csr)
    if reg_peer != 0 && ob >= 0 {
        n1: ast.list_len(a, ob) - 1
        _: cg.op3(p, opc.OP_COPY, reg_new_peer, reg_peer, n1)
        _: cg.op3(p, opc.OP_COPY, reg_peer, s.start_reg, n1)
        _: cg.op3(p, opc.OP_COPY, reg_peer, s.current_reg, n1)
        _: cg.op3(p, opc.OP_COPY, reg_peer, s.end_reg, n1)
    }
    _: cg.op2(p, opc.OP_GOTO, 0, lbl_where_end)
    cg.v_jump_here(p, addr_ne)

    // The second and later rows.
    if reg_peer != 0 -> window_if_new_peer(p, a, ob, reg_new_peer, reg_peer, lbl_where_end)
    if mw.start_type == tk.TK_FOLLOWING {
        _: window_code_op(p, a, s, WINDOW_AGGSTEP, 0, false)
        if mw.end_type != tk.TK_UNBOUNDED {
            if mw.frm_type == tk.TK_RANGE {
                lbl: cg.v_make_label(p)
                addr_next: cg.v_current_addr(p)
                window_code_range_test(p, a, s, opc.OP_GE, s.current_csr, reg_end, s.end_csr, lbl)
                _: window_code_op(p, a, s, WINDOW_AGGINVERSE, reg_start, false)
                _: window_code_op(p, a, s, WINDOW_RETURN_ROW, 0, false)
                _: cg.op2(p, opc.OP_GOTO, 0, addr_next)
                cg.v_resolve_label(p, lbl)
            } else {
                _: window_code_op(p, a, s, WINDOW_RETURN_ROW, reg_end, false)
                _: window_code_op(p, a, s, WINDOW_AGGINVERSE, reg_start, false)
            }
        }
    } else if mw.end_type == tk.TK_PRECEDING {
        b_rps: mw.start_type == tk.TK_PRECEDING && mw.frm_type == tk.TK_RANGE
        _: window_code_op(p, a, s, WINDOW_AGGSTEP, reg_end, false)
        if b_rps -> _: window_code_op(p, a, s, WINDOW_AGGINVERSE, reg_start, false)
        _: window_code_op(p, a, s, WINDOW_RETURN_ROW, 0, false)
        if !b_rps -> _: window_code_op(p, a, s, WINDOW_AGGINVERSE, reg_start, false)
    } else {
        addr := 0
        _: window_code_op(p, a, s, WINDOW_AGGSTEP, 0, false)
        if mw.end_type != tk.TK_UNBOUNDED {
            if mw.frm_type == tk.TK_RANGE {
                lbl := 0
                addr = cg.v_current_addr(p)
                if reg_end != 0 {
                    lbl = cg.v_make_label(p)
                    window_code_range_test(p, a, s, opc.OP_GE, s.current_csr, reg_end, s.end_csr, lbl)
                }
                _: window_code_op(p, a, s, WINDOW_RETURN_ROW, 0, false)
                _: window_code_op(p, a, s, WINDOW_AGGINVERSE, reg_start, false)
                if reg_end != 0 {
                    _: cg.op2(p, opc.OP_GOTO, 0, addr)
                    cg.v_resolve_label(p, lbl)
                }
            } else {
                if reg_end != 0 -> addr = cg.op3(p, opc.OP_IF_POS, reg_end, 0, 1)
                _: window_code_op(p, a, s, WINDOW_RETURN_ROW, 0, false)
                _: window_code_op(p, a, s, WINDOW_AGGINVERSE, reg_start, false)
                if reg_end != 0 -> cg.v_jump_here(p, addr)
            }
        }
    }

    // The end of the main loop.
    cg.v_resolve_label(p, lbl_where_end)
    wh.where_end(p, a, wi)

    // The flush, fallen into at the end of the input and called at each
    // new partition.
    addr_integer := 0
    if mw.partition >= 0 {
        addr_integer = cg.op2(p, opc.OP_INTEGER, 0, reg_flush_part)
        cg.v_jump_here(p, addr_gosub_flush)
    }
    s.reg_rowid = 0
    addr_empty: cg.op1(p, opc.OP_REWIND, csr_write)
    if mw.end_type == tk.TK_PRECEDING {
        b_rps: mw.start_type == tk.TK_PRECEDING && mw.frm_type == tk.TK_RANGE
        _: window_code_op(p, a, s, WINDOW_AGGSTEP, reg_end, false)
        if b_rps -> _: window_code_op(p, a, s, WINDOW_AGGINVERSE, reg_start, false)
        _: window_code_op(p, a, s, WINDOW_RETURN_ROW, 0, false)
    } else if mw.start_type == tk.TK_FOLLOWING {
        addr_start := 0
        addr_break1 := 0
        addr_break2 := 0
        _: window_code_op(p, a, s, WINDOW_AGGSTEP, 0, false)
        if mw.frm_type == tk.TK_RANGE {
            addr_start = cg.v_current_addr(p)
            addr_break2 = window_code_op(p, a, s, WINDOW_AGGINVERSE, reg_start, true)
            addr_break1 = window_code_op(p, a, s, WINDOW_RETURN_ROW, 0, true)
        } else if mw.end_type == tk.TK_UNBOUNDED {
            addr_start = cg.v_current_addr(p)
            addr_break1 = window_code_op(p, a, s, WINDOW_RETURN_ROW, reg_start, true)
            addr_break2 = window_code_op(p, a, s, WINDOW_AGGINVERSE, 0, true)
        } else {
            addr_start = cg.v_current_addr(p)
            addr_break1 = window_code_op(p, a, s, WINDOW_RETURN_ROW, reg_end, true)
            addr_break2 = window_code_op(p, a, s, WINDOW_AGGINVERSE, reg_start, true)
        }
        _: cg.op2(p, opc.OP_GOTO, 0, addr_start)
        cg.v_jump_here(p, addr_break2)
        addr_start = cg.v_current_addr(p)
        addr_break3: window_code_op(p, a, s, WINDOW_RETURN_ROW, 0, true)
        _: cg.op2(p, opc.OP_GOTO, 0, addr_start)
        cg.v_jump_here(p, addr_break1)
        cg.v_jump_here(p, addr_break3)
    } else {
        _: window_code_op(p, a, s, WINDOW_AGGSTEP, 0, false)
        addr_start: cg.v_current_addr(p)
        addr_break: window_code_op(p, a, s, WINDOW_RETURN_ROW, 0, true)
        _: window_code_op(p, a, s, WINDOW_AGGINVERSE, reg_start, false)
        _: cg.op2(p, opc.OP_GOTO, 0, addr_start)
        cg.v_jump_here(p, addr_break)
    }
    cg.v_jump_here(p, addr_empty)

    _: cg.op1(p, opc.OP_RESET_SORTER, s.current_csr)
    if mw.partition >= 0 {
        if mw.reg_start_rowid != 0 {
            _: cg.op2(p, opc.OP_INTEGER, 1, mw.reg_start_rowid)
            _: cg.op2(p, opc.OP_INTEGER, 0, mw.reg_end_rowid)
        }
        here: cg.v_current_addr(p)
        cg.v_change_p1(p, addr_integer, here)
        _: cg.op1(p, opc.OP_RETURN, reg_flush_part)
    }
}

// ---------------------------------------------------------------------------
// Tests.

window_test_vdbe: fn(id: Int, args: [base.Mem]) -> conn.Vdbe Never! {
    v := conn.vdbe_new()
    v.mem.push(base.mem_null())
    v.mem.push(base.mem_null())
    loop m in args -> v.mem.push(m.copy())
    v.fctx.out = 0
    v.fctx.agg = 1
    v.fctx.arg = 2
    v.fctx.impl_id = id
    v
}

#Test("row_number, rank and dense_rank count rows and peer groups") {
    db := conn.conn_new()
    v := window_test_vdbe(cat.FI_ROW_NUMBER, [base.Mem]{})
    window_func_call(db, v, aux.FN_STEP)
    window_func_call(db, v, aux.FN_STEP)
    window_func_call(db, v, aux.FN_VALUE)
    assert_eq(v.mem[0].i, 2)
    r := window_test_vdbe(cat.FI_RANK, [base.Mem]{})
    // Two peers, then a new group: rank() is 1, then 3.
    window_func_call(db, r, aux.FN_STEP)
    window_func_call(db, r, aux.FN_STEP)
    window_func_call(db, r, aux.FN_VALUE)
    assert_eq(r.mem[0].i, 1)
    window_func_call(db, r, aux.FN_STEP)
    window_func_call(db, r, aux.FN_VALUE)
    assert_eq(r.mem[0].i, 3)
    d := window_test_vdbe(cat.FI_DENSE_RANK, [base.Mem]{})
    window_func_call(db, d, aux.FN_STEP)
    window_func_call(db, d, aux.FN_VALUE)
    window_func_call(db, d, aux.FN_STEP)
    window_func_call(db, d, aux.FN_FINAL)
    assert_eq(d.mem[0].i, 2)
}

#Test("ntile splits the partition and nth_value checks its argument") {
    db := conn.conn_new()
    v := window_test_vdbe(cat.FI_NTILE, [base.Mem]{base.mem_int(3)})
    loop _ in 0..<7 -> window_func_call(db, v, aux.FN_STEP)
    window_func_call(db, v, aux.FN_VALUE)
    assert_eq(v.mem[0].i, 1)
    loop _ in 0..<3 -> window_func_call(db, v, aux.FN_INVERSE)
    window_func_call(db, v, aux.FN_VALUE)
    assert_eq(v.mem[0].i, 2)
    loop _ in 0..<3 -> window_func_call(db, v, aux.FN_INVERSE)
    window_func_call(db, v, aux.FN_VALUE)
    assert_eq(v.mem[0].i, 3)
    n := window_test_vdbe(cat.FI_NTH_VALUE, [base.Mem]{base.mem_int(7), base.mem_real(2.5)})
    window_func_call(db, n, aux.FN_STEP)
    assert_eq(n.fctx.is_error, base.ERROR)
    assert_eq(String.from_bytes(n.mem[0].z) ?? "", "second argument to nth_value must be a positive integer")
    m := window_test_vdbe(cat.FI_NTH_VALUE, [base.Mem]{base.mem_int(7), base.mem_real(2.0)})
    window_func_call(db, m, aux.FN_STEP)
    m.mem[2] = base.mem_int(8)
    window_func_call(db, m, aux.FN_STEP)
    window_func_call(db, m, aux.FN_FINAL)
    assert_eq(m.fctx.is_error, 0)
    assert_eq(m.mem[0].i, 8)
}

#Test("last_value follows the frame and empties with it") {
    db := conn.conn_new()
    v := window_test_vdbe(cat.FI_LAST_VALUE, [base.Mem]{base.mem_int(4)})
    window_func_call(db, v, aux.FN_STEP)
    v.mem[2] = base.mem_int(5)
    window_func_call(db, v, aux.FN_STEP)
    window_func_call(db, v, aux.FN_VALUE)
    assert_eq(v.mem[0].i, 5)
    window_func_call(db, v, aux.FN_INVERSE)
    window_func_call(db, v, aux.FN_INVERSE)
    v.mem[0] = base.mem_null()
    window_func_call(db, v, aux.FN_VALUE)
    assert_eq(base.value_type(v.mem[0]), base.SQL_NULL)
}

#Test("an appended list keeps sort flags and can make integers NULL") {
    a := ast.stmt_ast("")
    e3: ast.expr(a, tk.TK_INTEGER, "3".bytes())
    l := ast.expr_list_append(a, -1, e3)
    es: ast.expr(a, tk.TK_STRING, "x".bytes())
    l = ast.expr_list_append(a, l, es)
    a.lists[l].items[0].sort_flags = base.KEYINFO_ORDER_DESC
    out: expr_list_append_list(a, -1, l, true)
    assert_eq(ast.list_len(a, out), 2)
    assert_eq(a.lists[out].items[0].sort_flags, base.KEYINFO_ORDER_DESC)
    assert_eq(a.exprs[ast.list_expr(a, out, 0)].op, tk.TK_NULL)
    assert_eq(a.exprs[ast.list_expr(a, out, 1)].op, tk.TK_STRING)
    kept: expr_list_append_list(a, out, l, false)
    assert_eq(a.exprs[ast.list_expr(a, kept, 2)].op, tk.TK_INTEGER)
    assert(expr_list_prefix_same(a, kept, out))
}

#Test("a frame offset check halts unless the value is in range") {
    p := cg.parse_new(conn.conn_new(), cg.CodegenTestGen{calls: 0})
    cg.get_vdbe(p)
    start: cg.v_current_addr(p)
    window_check_value(p, 9, WINDOW_ENDING_NUM)
    assert_eq(cg.v_op_at(p, start + 2).opcode, opc.OP_GE)
    assert_eq(cg.v_op_at(p, start + 2).p2, start + 4)
    assert_eq(cg.v_op_at(p, start + 3).opcode, opc.OP_GE)
    halt: cg.v_op_at(p, start + 4)
    assert_eq(halt.opcode, opc.OP_HALT)
    assert_eq(halt.p1, base.ERROR)
    n: cg.v_current_addr(p)
    window_check_value(p, 9, WINDOW_NTH_VALUE_INT)
    assert_eq(cg.v_op_at(p, n + 1).opcode, opc.OP_MUST_BE_INT)
    assert_eq(cg.v_op_at(p, n + 2).opcode, opc.OP_GT)
    g: cg.v_current_addr(p)
    window_if_new_peer(p, ast.stmt_ast(""), -1, 1, 2, 40)
    assert_eq(cg.v_op_at(p, g).opcode, opc.OP_GOTO)
    assert_eq(cg.v_op_at(p, g).p2, 40)
}
