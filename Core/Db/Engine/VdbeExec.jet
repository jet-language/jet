// The virtual machine's loop, a port of SQLite 3.45.0 sqlite3VdbeExec in
// vdbe.c: run the statement's program from Vdbe.pc, one op at a time,
// until it yields a row, halts or fails.
//
// Each op runs in its handler (VdbeData, VdbeCursor, VdbeSchema), which
// answers with a GO_* code (VdbeRun): the next op, the op its P2 names,
// either through check_for_interrupt, or one of sqlite3VdbeExec's tails.
// The tails are here: abort_due_to_error, vdbe_return, too_big, no_mem and
// abort_due_to_interrupt. Without shared cache, sqlite3VdbeEnter and
// sqlite3VdbeLeave do nothing; without SQLITE_DEBUG and VDBE_PROFILE there is
// no tracing or cycle counting.

use {
    base: __core_db_base
    conn: __core_db_conn
    opc: __core_db_opcodes
    aux: __core_db_vdbeaux
    __core_db_vdbeaux.[Host]
    run: __core_db_vdberun
    __core_db_vdberun.[Run, GO_NEXT, GO_JUMP, GO_NEXT_CHECK, GO_JUMP_CHECK, GO_ERROR, GO_NO_MEM, GO_TOO_BIG, GO_INTERRUPT, GO_RETURN, TestHost]
    vd: __core_db_vdbedata
    vc: __core_db_vdbecursor
    vs: __core_db_vdbeschema
}

// sqlite3VdbeExec: run v from Vdbe.pc. SQLITE_ROW with a row in the
// registers from Vdbe.result_row, SQLITE_DONE when it halts, SQLITE_BUSY
// when a lock it needs is held elsewhere, SQLITE_ERROR (or another code)
// when it fails, with Vdbe.rc and Vdbe.err_msg saying how.
exec: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe) -[DB]> Int Never! {
    r := run.run_new(db.enc)
    if db.n_progress_ops > 0 {
        prior: v.counters[conn.STMTSTATUS_VM_STEP]
        r.n_progress_limit = db.n_progress_ops - prior % db.n_progress_ops
    }
    if v.rc == base.NOMEM -> return exec_return<H>(h, db, v, r, GO_NO_MEM)
    v.rc = base.OK
    v.i_current_time = 0
    // db->busyHandler.nBusy = 0: each pager's busy handler counts afresh.
    loop i in 0..<db.btrees.len() -> db.btrees[i].pager.busy.n_busy = 0
    if db.is_interrupted -> return exec_return<H>(h, db, v, r, GO_INTERRUPT)
    r.pc = v.pc
    loop {
        r.n_vm_step += 1
        r.op = v.ops[r.pc].opcode
        r.p1 = v.ops[r.pc].p1
        r.p2 = v.ops[r.pc].p2
        r.p3 = v.ops[r.pc].p3
        r.p5 = v.ops[r.pc].p5
        answer: exec_op<H>(h, db, v, r)
        if answer == GO_NEXT {
            r.pc += 1
        } else if answer == GO_JUMP {
            r.pc = r.p2
        } else if answer == GO_NEXT_CHECK || answer == GO_JUMP_CHECK {
            // check_for_interrupt.
            r.pc = if answer == GO_JUMP_CHECK -> r.p2 else -> r.pc + 1
            if db.is_interrupted -> return exec_return<H>(h, db, v, r, GO_INTERRUPT)
            if progress_interrupts<H>(h, db, r) {
                r.rc = base.INTERRUPT
                return exec_return<H>(h, db, v, r, GO_ERROR)
            }
        } else {
            return exec_return<H>(h, db, v, r, answer)
        }
    }
}

// The progress handler's turns that are due (the loop of check_for_interrupt
// and vdbe_return), one every Conn.n_progress_ops ops: true when one asks to
// interrupt, after which it is not called again in this run.
progress_interrupts: fn<H: Host>(h: &H, db: &conn.Conn, r: &Run) -[DB]> Bool Never! {
    loop r.n_vm_step >= r.n_progress_limit && db.n_progress_ops > 0 {
        r.n_progress_limit += db.n_progress_ops
        if h.progress(db) {
            r.n_progress_limit = base.I64_MAX
            return true
        }
    }
    false
}

// The tails of sqlite3VdbeExec for the handler's answer: no_mem, too_big
// and abort_due_to_interrupt into abort_due_to_error (GO_ERROR, with Run.rc
// the code), then vdbe_return (GO_RETURN, with Run.rc the result).
exec_return: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run, answer: Int) -[DB]> Int Never! {
    rc := r.rc
    abort := answer != GO_RETURN
    if answer == GO_NO_MEM {
        aux.oom_fault(db)
        aux.vdbe_error(v, "out of memory".bytes())
        rc = base.NOMEM
    } else if answer == GO_TOO_BIG {
        aux.vdbe_error(v, "string or blob too big".bytes())
        rc = base.TOOBIG
    } else if answer == GO_INTERRUPT {
        rc = base.INTERRUPT
    }
    loop {
        if abort -> rc = abort_due_to_error<H>(h, db, v, r, rc)
        // vdbe_return; a progress handler that interrupts here aborts.
        abort = progress_interrupts<H>(h, db, r)
        if !abort -> break
        rc = base.INTERRUPT
    }
    k: conn.STMTSTATUS_VM_STEP
    v.counters[k] = (v.counters[k] + r.n_vm_step).bit_and(4294967295)
    rc
}

// abort_due_to_error: the statement fails with code rc. It records the
// code and its message, halts (rolling back as the code demands) and
// answers SQLITE_ERROR.
abort_due_to_error: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: Run, code: Int) -[DB]> Int Never! {
    rc := code
    if db.malloc_failed {
        rc = base.NOMEM
    } else if rc == base.IOERR_CORRUPTFS {
        rc = base.CORRUPT
    }
    if v.err_msg == None && rc != base.IOERR_NOMEM -> aux.vdbe_error(v, base.error_string(rc).bytes())
    v.rc = rc
    aux.system_error(db, rc)
    if v.state == conn.VDBE_RUN_STATE {
        _: aux.halt<H>(h, db, v)
    }
    if rc == base.IOERR_NOMEM -> aux.oom_fault(db)
    if rc == base.CORRUPT && !db.auto_commit {
        db.flags = db.flags.bit_or(conn.SQLITE_CORRUPT_RD_ONLY)
        conn.sync_btrees(db)
    }
    if r.reset_schema_on_fault > 0 -> conn.reset_one_schema(db, r.reset_schema_on_fault - 1)
    base.ERROR
}

// Run op Run.pc (its operands in r) in its handler. The ops without a
// case run as C's default, doing nothing: OP_Noop, OP_Explain,
// OP_Abortable, OP_ColumnsUsed, OP_TableLock (a no-op without shared
// cache), OP_CursorHint, OP_ReleaseReg, OP_Permutation (read by the
// OP_Compare after it) and OP_Offset (without SQLITE_ENABLE_OFFSET_SQL_FUNC).
exec_op: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    if r.op == {
        opc.OP_GOTO -> GO_JUMP_CHECK
        opc.OP_GOSUB -> vd.op_gosub(v, r)
        opc.OP_RETURN -> vd.op_return(v, r)
        opc.OP_INIT_COROUTINE -> vd.op_init_coroutine(v, r)
        opc.OP_END_COROUTINE -> vd.op_end_coroutine(v, r)
        opc.OP_YIELD -> vd.op_yield(v, r)
        opc.OP_HALT_IF_NULL -> vd.op_halt_if_null<H>(h, db, v, r)
        opc.OP_HALT -> vd.op_halt<H>(h, db, v, r)
        opc.OP_INTEGER -> vd.op_integer(v, r)
        opc.OP_INT64 -> vd.op_int64(v, r)
        opc.OP_REAL -> vd.op_real(v, r)
        opc.OP_STRING8 -> vd.op_string8(db, v, r)
        opc.OP_STRING -> vd.op_string(v, r)
        opc.OP_BEGIN_SUBRTN | opc.OP_NULL -> vd.op_null(v, r)
        opc.OP_SOFT_NULL -> vd.op_soft_null(v, r)
        opc.OP_BLOB -> vd.op_blob(v, r)
        opc.OP_VARIABLE -> vd.op_variable(db, v, r)
        opc.OP_MOVE -> vd.op_move(v, r)
        opc.OP_COPY -> vd.op_copy(v, r)
        opc.OP_SCOPY -> vd.op_scopy(v, r)
        opc.OP_INT_COPY -> vd.op_int_copy(v, r)
        opc.OP_FK_CHECK -> vd.op_fk_check(db, v, r)
        opc.OP_RESULT_ROW -> vd.op_result_row<H>(h, db, v, r)
        opc.OP_CONCAT -> vd.op_concat(db, v, r)
        opc.OP_ADD | opc.OP_SUBTRACT | opc.OP_MULTIPLY | opc.OP_DIVIDE | opc.OP_REMAINDER -> vd.op_arith(v, r)
        opc.OP_COLL_SEQ -> vd.op_coll_seq(v, r)
        opc.OP_BIT_AND | opc.OP_BIT_OR | opc.OP_SHIFT_LEFT | opc.OP_SHIFT_RIGHT -> vd.op_bits(v, r)
        opc.OP_ADD_IMM -> vd.op_add_imm(v, r)
        opc.OP_MUST_BE_INT -> vd.op_must_be_int(v, r)
        opc.OP_REAL_AFFINITY -> vd.op_real_affinity(v, r)
        opc.OP_CAST -> vd.op_cast(v, r)
        opc.OP_EQ | opc.OP_NE | opc.OP_LT | opc.OP_LE | opc.OP_GT | opc.OP_GE -> vd.op_compare_jump(v, r)
        opc.OP_ELSE_EQ -> vd.op_else_eq(r)
        opc.OP_COMPARE -> vd.op_compare(v, r)
        opc.OP_JUMP -> vd.op_jump(r)
        opc.OP_AND | opc.OP_OR -> vd.op_and_or(v, r)
        opc.OP_IS_TRUE -> vd.op_is_true(v, r)
        opc.OP_NOT -> vd.op_not(v, r)
        opc.OP_BIT_NOT -> vd.op_bit_not(v, r)
        opc.OP_ONCE -> vd.op_once(v, r)
        opc.OP_IF -> vd.op_if(v, r)
        opc.OP_IF_NOT -> vd.op_if_not(v, r)
        opc.OP_IS_NULL -> vd.op_is_null(v, r)
        opc.OP_IS_TYPE -> vd.op_is_type(v, r)
        opc.OP_NOT_NULL -> vd.op_not_null(v, r)
        opc.OP_ZERO_OR_NULL -> vd.op_zero_or_null(v, r)
        opc.OP_IF_NULL_ROW -> vc.op_if_null_row(v, r)
        opc.OP_COLUMN -> vc.op_column(db, v, r)
        opc.OP_TYPE_CHECK -> vc.op_type_check(db, v, r)
        opc.OP_AFFINITY -> vc.op_affinity(v, r)
        opc.OP_MAKE_RECORD -> vc.op_make_record(db, v, r)
        opc.OP_COUNT -> vc.op_count(db, v, r)
        opc.OP_SAVEPOINT -> vc.op_savepoint<H>(h, db, v, r)
        opc.OP_AUTO_COMMIT -> vc.op_auto_commit<H>(h, db, v, r)
        opc.OP_TRANSACTION -> vc.op_transaction<H>(h, db, v, r)
        opc.OP_READ_COOKIE -> vc.op_read_cookie(db, v, r)
        opc.OP_SET_COOKIE -> vc.op_set_cookie(db, v, r)
        opc.OP_REOPEN_IDX | opc.OP_OPEN_READ | opc.OP_OPEN_WRITE -> vc.op_open_read<H>(h, db, v, r)
        opc.OP_OPEN_DUP -> vc.op_open_dup<H>(h, db, v, r)
        opc.OP_OPEN_EPHEMERAL | opc.OP_OPEN_AUTOINDEX -> vc.op_open_ephemeral<H>(h, db, v, r)
        opc.OP_SORTER_OPEN -> vc.op_sorter_open<H>(h, db, v, r)
        opc.OP_SEQUENCE_TEST -> vc.op_sequence_test(v, r)
        opc.OP_OPEN_PSEUDO -> vc.op_open_pseudo<H>(h, db, v, r)
        opc.OP_CLOSE -> vc.op_close<H>(h, db, v, r)
        opc.OP_SEEK_LT | opc.OP_SEEK_LE | opc.OP_SEEK_GE | opc.OP_SEEK_GT -> vc.op_seek(db, v, r)
        opc.OP_SEEK_SCAN -> vc.op_seek_scan(db, v, r)
        opc.OP_SEEK_HIT -> vc.op_seek_hit(v, r)
        opc.OP_IF_NOT_OPEN -> vc.op_if_not_open(v, r)
        opc.OP_IF_NO_HOPE | opc.OP_NO_CONFLICT | opc.OP_NOT_FOUND | opc.OP_FOUND -> vc.op_found(db, v, r)
        opc.OP_SEEK_ROWID | opc.OP_NOT_EXISTS -> vc.op_seek_rowid(db, v, r)
        opc.OP_SEQUENCE -> vc.op_sequence(v, r)
        opc.OP_NEW_ROWID -> vc.op_new_rowid(db, v, r)
        opc.OP_INSERT -> vc.op_insert<H>(h, db, v, r)
        opc.OP_ROW_CELL -> vc.op_row_cell(db, v, r)
        opc.OP_DELETE -> vc.op_delete<H>(h, db, v, r)
        opc.OP_RESET_COUNT -> vc.op_reset_count(db, v)
        opc.OP_SORTER_COMPARE -> vc.op_sorter_compare(v, r)
        opc.OP_SORTER_DATA -> vc.op_sorter_data(v, r)
        opc.OP_ROW_DATA -> vc.op_row_data(db, v, r)
        opc.OP_ROWID -> vc.op_rowid<H>(h, db, v, r)
        opc.OP_NULL_ROW -> vc.op_null_row<H>(h, db, v, r)
        opc.OP_SEEK_END | opc.OP_LAST -> vc.op_last(db, v, r)
        opc.OP_IF_SMALLER -> vc.op_if_smaller(db, v, r)
        opc.OP_SORTER_SORT | opc.OP_SORT | opc.OP_REWIND -> vc.op_rewind(db, v, r)
        opc.OP_SORTER_NEXT | opc.OP_PREV | opc.OP_NEXT -> vc.op_next(db, v, r)
        opc.OP_IDX_INSERT -> vc.op_idx_insert(db, v, r)
        opc.OP_SORTER_INSERT -> vc.op_sorter_insert(v, r)
        opc.OP_IDX_DELETE -> vc.op_idx_delete(db, v, r)
        opc.OP_DEFERRED_SEEK | opc.OP_IDX_ROWID -> vc.op_idx_rowid(db, v, r)
        opc.OP_FINISH_SEEK -> vc.op_finish_seek(db, v, r)
        opc.OP_IDX_LE | opc.OP_IDX_GT | opc.OP_IDX_LT | opc.OP_IDX_GE -> vc.op_idx_compare(db, v, r)
        opc.OP_DESTROY -> vs.op_destroy(db, v, r)
        opc.OP_CLEAR -> vs.op_clear(db, v, r)
        opc.OP_RESET_SORTER -> vs.op_reset_sorter(db, v, r)
        opc.OP_CREATE_BTREE -> vs.op_create_btree(db, v, r)
        opc.OP_SQL_EXEC -> vs.op_sql_exec<H>(h, db, v, r)
        opc.OP_PARSE_SCHEMA -> vs.op_parse_schema<H>(h, db, v, r)
        opc.OP_LOAD_ANALYSIS -> vs.op_load_analysis<H>(h, db, r)
        opc.OP_DROP_TABLE | opc.OP_DROP_INDEX | opc.OP_DROP_TRIGGER -> vs.op_drop_object(db, v, r)
        opc.OP_INTEGRITY_CK -> vs.op_integrity_ck(db, v, r)
        opc.OP_ROW_SET_ADD -> vs.op_row_set_add(v, r)
        opc.OP_ROW_SET_READ -> vs.op_row_set_read(v, r)
        opc.OP_ROW_SET_TEST -> vs.op_row_set_test(v, r)
        opc.OP_PROGRAM -> vs.op_program(db, v, r)
        opc.OP_PARAM -> vs.op_param(v, r)
        opc.OP_FK_COUNTER -> vs.op_fk_counter(db, v, r)
        opc.OP_FK_IF_ZERO -> vs.op_fk_if_zero(db, v, r)
        opc.OP_MEM_MAX -> vs.op_mem_max(v, r)
        opc.OP_IF_POS -> vs.op_if_pos(v, r)
        opc.OP_OFFSET_LIMIT -> vs.op_offset_limit(v, r)
        opc.OP_IF_NOT_ZERO -> vs.op_if_not_zero(v, r)
        opc.OP_DECR_JUMP_ZERO -> vs.op_decr_jump_zero(v, r)
        opc.OP_PURE_FUNC | opc.OP_FUNCTION -> vs.op_function<H>(h, db, v, r)
        opc.OP_AGG_INVERSE | opc.OP_AGG_STEP -> vs.op_agg_step<H>(h, db, v, r)
        opc.OP_AGG_STEP1 -> vs.op_agg_step1<H>(h, db, v, r)
        opc.OP_AGG_VALUE | opc.OP_AGG_FINAL -> vs.op_agg_final<H>(h, db, v, r)
        opc.OP_CHECKPOINT -> vs.op_checkpoint(db, v, r)
        opc.OP_JOURNAL_MODE -> vs.op_journal_mode(db, v, r)
        opc.OP_VACUUM -> vs.op_vacuum<H>(h, db, v, r)
        opc.OP_INCR_VACUUM -> vs.op_incr_vacuum(db, r)
        opc.OP_EXPIRE -> vs.op_expire(db, v, r)
        opc.OP_CURSOR_LOCK | opc.OP_CURSOR_UNLOCK -> vs.op_cursor_lock(db, v, r)
        opc.OP_VBEGIN -> vs.op_vbegin<H>(h, db, v, r)
        opc.OP_VCREATE -> vs.op_vcreate<H>(h, db, v, r)
        opc.OP_VDESTROY -> vs.op_vdestroy<H>(h, db, v, r)
        opc.OP_VOPEN -> vs.op_vopen<H>(h, db, v, r)
        opc.OP_VCHECK -> vs.op_vcheck<H>(h, db, v, r)
        opc.OP_VINIT_IN -> vs.op_vinit_in(v, r)
        opc.OP_VFILTER -> vs.op_vfilter<H>(h, db, v, r)
        opc.OP_VCOLUMN -> vs.op_vcolumn<H>(h, db, v, r)
        opc.OP_VNEXT -> vs.op_vnext<H>(h, db, v, r)
        opc.OP_VRENAME -> vs.op_vrename<H>(h, db, v, r)
        opc.OP_VUPDATE -> vs.op_vupdate<H>(h, db, v, r)
        opc.OP_PAGECOUNT -> vs.op_pagecount(db, v, r)
        opc.OP_MAX_PGCNT -> vs.op_max_pgcnt(db, v, r)
        opc.OP_CLR_SUBTYPE | opc.OP_GET_SUBTYPE | opc.OP_SET_SUBTYPE -> vs.op_subtype(v, r)
        opc.OP_FILTER_ADD -> vs.op_filter_add(v, r)
        opc.OP_FILTER -> vs.op_filter(v, r)
        opc.OP_INIT | opc.OP_TRACE -> vs.op_init<H>(h, db, v, r)
        else -> GO_NEXT
    }
}

// A ready statement of the ops `ops` (no P4) after the OP_Init that
// vdbe_create starts it with, over n_mem registers, running.
exec_test_stmt: fn(db: &conn.Conn, ops: [(op: Int, p1: Int, p2: Int, p3: Int)], n_mem: Int) -> conn.Vdbe Never! {
    v := aux.vdbe_create(db)
    loop o in ops {
        _: aux.add_op3(db, v, o.op, o.p1, o.p2, o.p3)
    }
    aux.make_ready(db, v, 0, n_mem, 0, 0, false)
    v.state = conn.VDBE_RUN_STATE
    v.pc = 0
    v
}

#Test("a program yields its row, then halts, counting its steps") {
    db := conn.conn_new()
    h := TestHost{interrupt_at: 0, progress_calls: 0}
    v := exec_test_stmt(db, [(op: Int, p1: Int, p2: Int, p3: Int)]{(op: opc.OP_INTEGER, p1: 7, p2: 1, p3: 0), (op: opc.OP_RESULT_ROW, p1: 1, p2: 1, p3: 0), (op: opc.OP_HALT, p1: 0, p2: 0, p3: 0)}, 2)
    assert_eq(exec<TestHost>(h, db, v), base.ROW)
    assert_eq(v.result_row, 1)
    assert_eq(v.mem[1].i, 7)
    assert_eq(v.pc, 3)
    assert_eq(exec<TestHost>(h, db, v), base.DONE)
    assert_eq(v.rc, base.OK)
    assert_eq(v.counters[conn.STMTSTATUS_VM_STEP], 4)
    assert_eq(h.progress_calls, 0)
}

#Test("a failing op aborts the statement with the message of its code") {
    db := conn.conn_new()
    h := TestHost{interrupt_at: 0, progress_calls: 0}
    v := exec_test_stmt(db, [(op: Int, p1: Int, p2: Int, p3: Int)]{(op: opc.OP_NULL, p1: 0, p2: 1, p3: 0), (op: opc.OP_MUST_BE_INT, p1: 1, p2: 0, p3: 0), (op: opc.OP_HALT, p1: 0, p2: 0, p3: 0)}, 2)
    assert_eq(exec<TestHost>(h, db, v), base.ERROR)
    assert_eq(v.rc, base.MISMATCH)
    assert_eq(String.from_bytes(v.err_msg ?? [U8]{}) ?? "", "datatype mismatch")
    assert_eq(v.counters[conn.STMTSTATUS_VM_STEP], 3)
}

#Test("the progress handler runs every N ops and can interrupt a loop") {
    db := conn.conn_new()
    db.n_progress_ops = 2
    h := TestHost{interrupt_at: 3, progress_calls: 0}
    v := exec_test_stmt(db, [(op: Int, p1: Int, p2: Int, p3: Int)]{(op: opc.OP_INTEGER, p1: 100, p2: 1, p3: 0), (op: opc.OP_DECR_JUMP_ZERO, p1: 1, p2: 4, p3: 0), (op: opc.OP_GOTO, p1: 0, p2: 2, p3: 0), (op: opc.OP_HALT, p1: 0, p2: 0, p3: 0)}, 2)
    assert_eq(exec<TestHost>(h, db, v), base.ERROR)
    assert_eq(v.rc, base.INTERRUPT)
    assert_eq(h.progress_calls, 3)
    assert_eq(String.from_bytes(v.err_msg ?? [U8]{}) ?? "", "interrupted")
    assert_eq(v.counters[conn.STMTSTATUS_VM_STEP], 6)
    assert_eq(v.mem[1].i, 98)
}

#Test("an interrupted connection or a failed allocation stops before the first op") {
    db := conn.conn_new()
    h := TestHost{interrupt_at: 0, progress_calls: 0}
    ops: [(op: Int, p1: Int, p2: Int, p3: Int)]{(op: opc.OP_HALT, p1: 0, p2: 0, p3: 0)}
    v := exec_test_stmt(db, ops, 1)
    db.is_interrupted = true
    assert_eq(exec<TestHost>(h, db, v), base.ERROR)
    assert_eq(v.rc, base.INTERRUPT)
    assert_eq(v.counters[conn.STMTSTATUS_VM_STEP], 0)
    db.is_interrupted = false
    w := exec_test_stmt(db, ops, 1)
    w.rc = base.NOMEM
    assert_eq(exec<TestHost>(h, db, w), base.ERROR)
    assert_eq(w.rc, base.NOMEM)
    assert(db.malloc_failed)
    assert_eq(String.from_bytes(w.err_msg ?? [U8]{}) ?? "", "out of memory")
}
