// The statement and function-context API, a port of SQLite 3.45.0
// vdbeapi.c: stepping, resetting and finalizing a statement, its result
// columns and column names, binding its parameters, and the sqlite3_result_*
// and sqlite3_context routines a function implementation calls. With them
// are the pieces of main.c that a step reaches: the commit callback of the
// logs (sqlite3WalDefaultHook) and sqlite3_wal_checkpoint_v2.
//
// A statement is named by its Conn.vdbes slot. Stepping moves it out of the
// slot (conn.vdbe_take) for the run and back after; the accessors read it
// in place. A function's context is the running statement's Vdbe.fctx, so
// the sqlite3_result_* routines take that statement.
//
// The build options are those of the C build it replaces: SQLITE_ENABLE_API_ARMOR,
// SQLITE_ENABLE_COLUMN_METADATA and SQLITE_ENABLE_STAT4, no
// SQLITE_OMIT_DEPRECATED, SQLITE_OMIT_AUTORESET, SQLITE_ENABLE_PREUPDATE_HOOK,
// SQLITE_ENABLE_STMT_SCANSTATUS or SQLITE_ENABLE_NORMALIZE. Without a
// mutex or an allocator to watch, the mutex calls and the
// SQLITE_STMTSTATUS_MEMUSED census have no counterpart; a value is a Jet
// value, so sqlite3_value_dup and sqlite3_value_free are mem.mem_copy and
// dropping it, and the destructor arguments of the bind and result calls
// have nothing to free. sqlite3_aggregate_count reads Mem.n, the step count
// OP_AggStep keeps in the accumulator, which a Jet Mem (whose n is its byte
// length) does not have; nothing in the library calls it.

use {
    base: __core_db_base
    ast: __core_db_ast
    util: __core_db_util
    record: __core_db_record
    btree: __core_db_btree
    pager: __core_db_pager
    wal: __core_db_wal
    os: __core_db_os
    mem: __core_db_mem
    conn: __core_db_conn
    opc: __core_db_opcodes
    aux: __core_db_vdbeaux
    __core_db_vdbeaux.[Host]
    run: __core_db_vdberun
    __core_db_vdberun.[TestHost]
    exe: __core_db_vdbeexec
}

// SQLITE_MAX_SCHEMA_RETRY: the reprepares one sqlite3_step allows.
MAX_SCHEMA_RETRY: 50

// The column names of an EXPLAIN (the first eight) and of an EXPLAIN QUERY
// PLAN listing (the last four).
EXPLAIN_COL_NAMES: [String]{"addr", "opcode", "p1", "p2", "p3", "p4", "p5", "comment", "id", "parent", "notused", "detail"}

// ---------------------------------------------------------------------------
// Stepping, resetting and finalizing.

// invokeProfileCallback (checkProfileCallback): report the run that began
// at Vdbe.start_time to the profile callbacks.
check_profile: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe) Never! -[DB]> {
    if v.start_time <= 0 -> return
    now: os.os_current_time()
    h.profile(db, v, (now - v.start_time) * 1000000)
    v.start_time = 0
}

// sqlite3_reset on a statement out of its slot: halt it, hand its error to
// the connection and rewind it.
reset_vdbe: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe) -[DB]> Int Never! {
    check_profile<H>(h, db, v)
    rc: aux.reset<H>(h, db, v)
    aux.rewind(v)
    aux.api_exit(db, rc)
}

// sqlite3_reset.
stmt_reset: fn<H: Host>(h: &H, db: &conn.Conn, s: Int) -[DB]> Int Never! {
    v := conn.vdbe_take(db, s)
    rc: reset_vdbe<H>(h, db, v)
    conn.vdbe_put(db, v)
    rc
}

// sqlite3_finalize: reset statement s if it ran and free it. The caller
// then closes a connection sqlite3_close_v2 left a zombie
// (sqlite3LeaveMutexAndCloseZombie).
stmt_finalize: fn<H: Host>(h: &H, db: &conn.Conn, s: Int) -[DB]> Int Never! {
    v := conn.vdbe_take(db, s)
    check_profile<H>(h, db, v)
    rc: aux.finalize<H>(h, db, v)
    aux.api_exit(db, rc)
}

// sqlite3_clear_bindings: every parameter becomes NULL; a statement whose
// plan used a bound value expires.
clear_bindings: fn(db: &conn.Conn, s: Int) Never! {
    loop i in 0..<db.vdbes[s].n_var -> db.vdbes[s].vars[i] = base.mem_null()
    if db.vdbes[s].expmask != 0 -> db.vdbe_links[s].expired = conn.EXPIRED_NOW
}

// sqlite3_expired.
stmt_expired: fn(db: conn.Conn, s: Int) -> Bool Never! { db.vdbe_links[s].expired != 0 }

// doWalCallbacks: after a commit, give each log that grew to the
// connection's commit callback; the first failure.
wal_callbacks: fn<H: Host>(h: &H, db: &conn.Conn) -[DB]> Int Never! {
    rc := base.OK
    loop i in 0..<db.dbs.len() {
        bt: db.dbs[i].bt
        if bt < 0 -> next
        n_entry: pager.pager_wal_callback(db.btrees[bt].pager)
        if n_entry > 0 && db.wal_hook != conn.WAL_HOOK_NONE && rc == base.OK {
            name: db.dbs[i].name
            if db.wal_hook == conn.WAL_HOOK_USER {
                rc = h.wal_hook(db, name, n_entry)
            } else {
                wal_default_hook(db, name, n_entry)
            }
        }
    }
    rc
}

// sqlite3WalDefaultHook: checkpoint a log that reached Conn.wal_arg
// frames, its result ignored.
wal_default_hook: fn(db: &conn.Conn, name: [U8], n_frame: Int) Never! -[DB]> {
    if n_frame < db.wal_arg -> return
    n_log := -1
    n_ckpt := -1
    _: wal_checkpoint_v2(db, name, wal.CHECKPOINT_PASSIVE, n_log, n_ckpt)
}

// sqlite3_wal_checkpoint_v2: checkpoint the database named `name`, or each
// one for an empty name, in mode e_mode; n_log and n_ckpt get the log's
// frame count and the frames checkpointed (-1 on error).
wal_checkpoint_v2: fn(db: &conn.Conn, name: [U8], e_mode: Int, n_log: &Int, n_ckpt: &Int) -[DB]> Int Never! {
    n_log = -1
    n_ckpt = -1
    if e_mode < wal.CHECKPOINT_PASSIVE || e_mode > wal.CHECKPOINT_TRUNCATE -> return base.MISUSE
    i_db := conn.MAX_DB
    if name.len() > 0 -> i_db = conn.find_db_name(db, name)
    rc := base.OK
    if i_db < 0 {
        rc = base.ERROR
        z: String.from_bytes(name) ?? ""
        aux.error_with_msg(db, base.ERROR, "unknown database: {z}".bytes())
    } else {
        loop b in 0..<db.btrees.len() -> db.btrees[b].pager.busy.n_busy = 0
        rc = conn.checkpoint(db, i_db, e_mode, n_log, n_ckpt)
        aux.sql_error(db, rc)
    }
    rc = aux.api_exit(db, rc)
    if db.n_vdbe_active == 0 && db.is_interrupted {
        db.is_interrupted = false
        conn.sync_btrees(db)
    }
    rc
}

// sqlite3Step: run statement v (out of its slot) to its next row, readying
// it first or resetting it when it halted. SQLITE_ROW, SQLITE_DONE,
// SQLITE_ERROR, SQLITE_BUSY or SQLITE_MISUSE (SQLITE_PREPARE_SAVESQL
// statements give the extended error code), masked by errMask; Vdbe.rc
// SQLITE_SCHEMA with SQLITE_ERROR asks for a reprepare.
vdbe_step: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe) -[DB]> Int Never! {
    savesql: v.prep_flags.bit_and(conn.PREPARE_SAVESQL) != 0
    if v.state == conn.VDBE_HALT_STATE -> _: reset_vdbe<H>(h, db, v)
    if v.state == conn.VDBE_READY_STATE {
        if db.vdbe_links[v.slot].expired != 0 {
            v.rc = base.SCHEMA
            rc := base.ERROR
            if savesql -> rc = aux.transfer_error(db, v)
            return rc.bit_and(db.err_mask)
        }
        if db.n_vdbe_active == 0 -> db.is_interrupted = false
        profiled: db.m_trace.bit_and(conn.TRACE_PROFILE.bit_or(conn.TRACE_XPROFILE)) != 0
        if profiled && !db.init.busy && v.sql.len() > 0 {
            v.start_time = os.os_current_time()
        }
        db.n_vdbe_active += 1
        if !v.read_only -> db.n_vdbe_write += 1
        if v.is_reader -> db.n_vdbe_read += 1
        conn.sync_btrees(db)
        v.pc = 0
        v.state = conn.VDBE_RUN_STATE
    }
    rc := base.OK
    if v.explain != 0 {
        rc = aux.list(db, v)
    } else {
        db.n_vdbe_exec += 1
        rc = exe.exec<H>(h, db, v)
        db.n_vdbe_exec -= 1
    }
    if rc == base.ROW {
        db.err_code = base.ROW
        return base.ROW
    }
    check_profile<H>(h, db, v)
    v.result_row = -1
    if rc == base.DONE && db.auto_commit {
        v.rc = wal_callbacks<H>(h, db)
        if v.rc != base.OK -> rc = base.ERROR
    } else if rc != base.DONE && savesql {
        rc = aux.transfer_error(db, v)
    }
    db.err_code = rc
    if aux.api_exit(db, v.rc) == base.NOMEM {
        v.rc = base.NOMEM
        if savesql -> rc = v.rc
    }
    rc.bit_and(db.err_mask)
}

// sqlite3_step: step statement s, recompiling it (at most
// MAX_SCHEMA_RETRY times) while the schema it was compiled against has
// changed.
stmt_step: fn<H: Host>(h: &H, db: &conn.Conn, s: Int) -[DB]> Int Never! {
    v := conn.vdbe_take(db, s)
    rc := base.OK
    cnt := 0
    loop {
        rc = vdbe_step<H>(h, db, v)
        if rc != base.SCHEMA || cnt >= MAX_SCHEMA_RETRY -> break
        cnt += 1
        saved_pc: v.pc
        rc = h.reprepare(db, v)
        if rc != base.OK {
            // Recompiling failed: the connection's error becomes the
            // statement's.
            if !db.malloc_failed {
                v.err_msg = db.err_msg
                rc = aux.api_exit(db, rc)
            } else {
                v.err_msg = None
                rc = base.NOMEM
            }
            v.rc = rc
            break
        }
        _: reset_vdbe<H>(h, db, v)
        // OP_Init and OP_Transaction skip the file format check again.
        if saved_pc >= 0 -> v.min_write_file_format = 254
    }
    conn.vdbe_put(db, v)
    rc
}

// sqlite3_stmt_explain: switch statement s between a normal run (0),
// EXPLAIN (1) and EXPLAIN QUERY PLAN (2), recompiling it when its program
// lacks what the mode lists.
stmt_explain: fn<H: Host>(h: &H, db: &conn.Conn, s: Int, e_mode: Int) -[DB]> Int Never! {
    v := conn.vdbe_take(db, s)
    rc := base.OK
    if v.explain == e_mode {
        rc = base.OK
    } else if e_mode < 0 || e_mode > 2 {
        rc = base.ERROR
    } else if v.prep_flags.bit_and(conn.PREPARE_SAVESQL) == 0 {
        rc = base.ERROR
    } else if v.state != conn.VDBE_READY_STATE {
        rc = base.BUSY
    } else if v.n_mem >= 10 && (e_mode != 2 || v.have_eqp_ops) {
        // The registers an EXPLAIN listing uses exist already.
        v.explain = e_mode
    } else {
        v.explain = e_mode
        rc = h.reprepare(db, v)
        v.have_eqp_ops = e_mode == 2
    }
    v.n_res_column = if v.explain != 0 -> 12 - 4 * v.explain else -> v.n_res_alloc
    conn.vdbe_put(db, v)
    rc
}

// sqlite3_stmt_busy: statement s has started and not yet halted.
stmt_busy: fn(db: conn.Conn, s: Int) -> Bool Never! { db.vdbes[s].state == conn.VDBE_RUN_STATE }

// sqlite3_stmt_readonly.
stmt_readonly: fn(db: conn.Conn, s: Int) -> Bool Never! { db.vdbes[s].read_only }

// sqlite3_stmt_isexplain.
stmt_isexplain: fn(db: conn.Conn, s: Int) -> Int Never! { db.vdbes[s].explain }

// sqlite3_next_stmt: the statement after s (the first for s < 0), -1 at
// the end.
next_stmt: fn(db: conn.Conn, s: Int) -> Int Never! {
    if s < 0 -> return db.vdbe_head
    db.vdbe_links[s].next
}

// sqlite3_stmt_status: counter op (SQLITE_STMTSTATUS_*) of statement s,
// zeroed after when `reset`. SQLITE_STMTSTATUS_MEMUSED, which measures C's
// allocations, has none to measure.
stmt_status: fn(db: &conn.Conn, s: Int, op: Int, reset: Bool) -> Int Never! {
    if op == conn.STMTSTATUS_MEMUSED -> return 0
    if op < 0 || op >= db.vdbes[s].counters.len() -> return 0
    n: db.vdbes[s].counters[op]
    if reset -> db.vdbes[s].counters[op] = 0
    n
}

// sqlite3_sql.
stmt_sql: fn(db: conn.Conn, s: Int) -> [U8] Never! { db.vdbes[s].sql }

// ---------------------------------------------------------------------------
// Result columns.

// sqlite3_column_count.
column_count: fn(db: conn.Conn, s: Int) -> Int Never! { db.vdbes[s].n_res_column }

// sqlite3_data_count: the columns of the current row, 0 without one.
data_count: fn(db: conn.Conn, s: Int) -> Int Never! {
    if db.vdbes[s].result_row < 0 -> return 0
    db.vdbes[s].n_res_column
}

// columnMem: the register of column i of the current row, or -1 (a NULL)
// with SQLITE_RANGE when there is no such column.
column_mem: fn(db: &conn.Conn, s: Int, i: Int) -> Int Never! {
    row: db.vdbes[s].result_row
    if row >= 0 && i >= 0 && i < db.vdbes[s].n_res_column -> return row + i
    aux.sql_error(db, base.RANGE)
    return -1
}

// columnMallocFailure: a memory fault in a conversion becomes the
// statement's SQLITE_NOMEM.
column_malloc_failure: fn(db: &conn.Conn, s: Int) Never! {
    rc: db.vdbes[s].rc
    db.vdbes[s].rc = aux.api_exit(db, rc)
}

// sqlite3_column_blob: the bytes of column i (empty for an empty value or
// a NULL).
column_blob: fn(db: &conn.Conn, s: Int, i: Int) -> [U8] Never! {
    k: column_mem(db, s, i)
    out := [U8]{}
    if k >= 0 && mem.value_blob(db.vdbes[s].mem[k]) -> out = db.vdbes[s].mem[k].z
    column_malloc_failure(db, s)
    out
}

// sqlite3_column_bytes.
column_bytes: fn(db: &conn.Conn, s: Int, i: Int) -> Int Never! {
    k: column_mem(db, s, i)
    n := 0
    if k >= 0 -> n = mem.value_bytes(db.vdbes[s].mem[k], base.UTF8)
    column_malloc_failure(db, s)
    n
}

// sqlite3_column_bytes16.
column_bytes16: fn(db: &conn.Conn, s: Int, i: Int) -> Int Never! {
    k: column_mem(db, s, i)
    n := 0
    if k >= 0 -> n = mem.value_bytes(db.vdbes[s].mem[k], base.UTF16NATIVE)
    column_malloc_failure(db, s)
    n
}

// sqlite3_column_double.
column_double: fn(db: &conn.Conn, s: Int, i: Int) -> Float Never! {
    k: column_mem(db, s, i)
    r := Float{0.0}
    if k >= 0 -> r = mem.real_value(db.vdbes[s].mem[k])
    column_malloc_failure(db, s)
    r
}

// sqlite3_column_int.
column_int: fn(db: &conn.Conn, s: Int, i: Int) -> Int Never! {
    k: column_mem(db, s, i)
    n := 0
    if k >= 0 -> n = mem.value_int(db.vdbes[s].mem[k])
    column_malloc_failure(db, s)
    n
}

// sqlite3_column_int64.
column_int64: fn(db: &conn.Conn, s: Int, i: Int) -> Int Never! {
    k: column_mem(db, s, i)
    n := 0
    if k >= 0 -> n = mem.int_value(db.vdbes[s].mem[k])
    column_malloc_failure(db, s)
    n
}

// The text of column i in encoding enc (sqlite3_column_text,
// sqlite3_column_text16); None for a NULL.
column_text_enc: fn(db: &conn.Conn, s: Int, i: Int, enc: Int) -> [U8]? Never! {
    k: column_mem(db, s, i)
    out := [U8]?{None}
    if k >= 0 && mem.value_text(db.vdbes[s].mem[k], enc) -> out = Val(db.vdbes[s].mem[k].z)
    column_malloc_failure(db, s)
    out
}

// sqlite3_column_text.
column_text: fn(db: &conn.Conn, s: Int, i: Int) -> [U8]? Never! { column_text_enc(db, s, i, base.UTF8) }

// sqlite3_column_text16.
column_text16: fn(db: &conn.Conn, s: Int, i: Int) -> [U8]? Never! { column_text_enc(db, s, i, base.UTF16NATIVE) }

// sqlite3_column_value: a copy of column i's value.
column_value: fn(db: &conn.Conn, s: Int, i: Int) -> base.Mem Never! {
    k: column_mem(db, s, i)
    out := base.mem_null()
    if k >= 0 -> out = mem.mem_copy(db.vdbes[s].mem[k])
    column_malloc_failure(db, s)
    out
}

// sqlite3_column_type (SQLITE_INTEGER, SQLITE_FLOAT, SQLITE_TEXT,
// SQLITE_BLOB or SQLITE_NULL).
column_type: fn(db: &conn.Conn, s: Int, i: Int) -> Int Never! {
    k: column_mem(db, s, i)
    t := base.SQL_NULL
    if k >= 0 -> t = base.value_type(db.vdbes[s].mem[k])
    column_malloc_failure(db, s)
    t
}

// columnName: name kind use_type (conn.COLNAME_*) of result column n in
// encoding enc; None when there is none.
column_name_of: fn(db: &conn.Conn, s: Int, n: Int, enc: Int, use_type: Int) -> [U8]? Never! {
    if n < 0 -> return None
    explain: db.vdbes[s].explain
    if explain != 0 {
        if use_type > 0 -> return None
        cols: if explain == 1 -> 8 else -> 4
        if n >= cols -> return None
        name := base.mem_text(EXPLAIN_COL_NAMES[n + 8 * explain - 8].bytes(), base.UTF8)
        if !mem.value_text(name, enc) -> return None
        return Val(name.z)
    }
    count: db.vdbes[s].n_res_column
    if n >= count -> return None
    k: n + use_type * count
    if !mem.value_text(db.vdbes[s].col_names[k], enc) -> return None
    Val(db.vdbes[s].col_names[k].z)
}

// sqlite3_column_name.
column_name: fn(db: &conn.Conn, s: Int, n: Int) -> [U8]? Never! { column_name_of(db, s, n, base.UTF8, conn.COLNAME_NAME) }

// sqlite3_column_name16.
column_name16: fn(db: &conn.Conn, s: Int, n: Int) -> [U8]? Never! { column_name_of(db, s, n, base.UTF16NATIVE, conn.COLNAME_NAME) }

// sqlite3_column_decltype.
column_decltype: fn(db: &conn.Conn, s: Int, n: Int) -> [U8]? Never! { column_name_of(db, s, n, base.UTF8, conn.COLNAME_DECLTYPE) }

// sqlite3_column_decltype16.
column_decltype16: fn(db: &conn.Conn, s: Int, n: Int) -> [U8]? Never! { column_name_of(db, s, n, base.UTF16NATIVE, conn.COLNAME_DECLTYPE) }

// sqlite3_column_database_name.
column_database_name: fn(db: &conn.Conn, s: Int, n: Int) -> [U8]? Never! { column_name_of(db, s, n, base.UTF8, conn.COLNAME_DATABASE) }

// sqlite3_column_database_name16.
column_database_name16: fn(db: &conn.Conn, s: Int, n: Int) -> [U8]? Never! { column_name_of(db, s, n, base.UTF16NATIVE, conn.COLNAME_DATABASE) }

// sqlite3_column_table_name.
column_table_name: fn(db: &conn.Conn, s: Int, n: Int) -> [U8]? Never! { column_name_of(db, s, n, base.UTF8, conn.COLNAME_TABLE) }

// sqlite3_column_table_name16.
column_table_name16: fn(db: &conn.Conn, s: Int, n: Int) -> [U8]? Never! { column_name_of(db, s, n, base.UTF16NATIVE, conn.COLNAME_TABLE) }

// sqlite3_column_origin_name.
column_origin_name: fn(db: &conn.Conn, s: Int, n: Int) -> [U8]? Never! { column_name_of(db, s, n, base.UTF8, conn.COLNAME_COLUMN) }

// sqlite3_column_origin_name16.
column_origin_name16: fn(db: &conn.Conn, s: Int, n: Int) -> [U8]? Never! { column_name_of(db, s, n, base.UTF16NATIVE, conn.COLNAME_COLUMN) }

// ---------------------------------------------------------------------------
// Parameters.

// vdbeUnbind: parameter i (from 0) of statement s becomes NULL, ready for
// a new value; SQLITE_MISUSE while the statement runs, SQLITE_RANGE past
// its parameters. A statement whose plan used the old value expires.
unbind: fn(db: &conn.Conn, s: Int, i: Int) -> Int Never! {
    if db.vdbes[s].state != conn.VDBE_READY_STATE {
        aux.sql_error(db, base.MISUSE)
        return base.MISUSE
    }
    if i < 0 || i >= db.vdbes[s].n_var {
        aux.sql_error(db, base.RANGE)
        return base.RANGE
    }
    db.vdbes[s].vars[i] = base.mem_null()
    db.err_code = base.OK
    mask: db.vdbes[s].expmask
    bit: if i >= 31 -> 2147483648 else -> 1 << i
    if mask != 0 && mask.bit_and(bit) != 0 -> db.vdbe_links[s].expired = conn.EXPIRED_NOW
    base.OK
}

// bindText: parameter i (from 1) becomes the text z of encoding enc, or a
// blob for enc 0; n bytes of it, or to its terminator for n < 0. None
// binds NULL.
bind_text_enc: fn(db: &conn.Conn, s: Int, i: Int, z: [U8]?, n: Int, enc: Int) -> Int Never! {
    rc := unbind(db, s, i - 1)
    if rc != base.OK -> return rc
    if z == .Val(data) {
        rc = mem.set_str(db.vdbes[s].vars[i - 1], data, n, enc, db.limits[ast.LIMIT_LENGTH])
        if rc == base.OK && enc != 0 -> mem.change_encoding(db.vdbes[s].vars[i - 1], db.enc)
        if rc != base.OK {
            aux.sql_error(db, rc)
            rc = aux.api_exit(db, rc)
        }
    }
    rc
}

// sqlite3_bind_blob: n bytes of z; SQLITE_MISUSE for n < 0.
bind_blob: fn(db: &conn.Conn, s: Int, i: Int, z: [U8]?, n: Int) -> Int Never! {
    if n < 0 -> return base.MISUSE
    bind_text_enc(db, s, i, z, n, 0)
}

// sqlite3_bind_blob64.
bind_blob64: fn(db: &conn.Conn, s: Int, i: Int, z: [U8]?, n: Int) -> Int Never! { bind_text_enc(db, s, i, z, n, 0) }

// sqlite3_bind_double.
bind_double: fn(db: &conn.Conn, s: Int, i: Int, r: Float) -> Int Never! {
    rc: unbind(db, s, i - 1)
    if rc == base.OK -> mem.set_double(db.vdbes[s].vars[i - 1], r)
    rc
}

// sqlite3_bind_int.
bind_int: fn(db: &conn.Conn, s: Int, i: Int, value: Int) -> Int Never! { bind_int64(db, s, i, value) }

// sqlite3_bind_int64.
bind_int64: fn(db: &conn.Conn, s: Int, i: Int, value: Int) -> Int Never! {
    rc: unbind(db, s, i - 1)
    if rc == base.OK -> mem.set_int64(db.vdbes[s].vars[i - 1], value)
    rc
}

// sqlite3_bind_null.
bind_null: fn(db: &conn.Conn, s: Int, i: Int) -> Int Never! { unbind(db, s, i - 1) }

// sqlite3_bind_text.
bind_text: fn(db: &conn.Conn, s: Int, i: Int, z: [U8]?, n: Int) -> Int Never! { bind_text_enc(db, s, i, z, n, base.UTF8) }

// sqlite3_bind_text64: text of encoding enc (SQLITE_UTF16 is the native
// order); UTF-16 drops an odd last byte.
bind_text64: fn(db: &conn.Conn, s: Int, i: Int, z: [U8]?, n: Int, enc_in: Int) -> Int Never! {
    enc := enc_in
    len := n
    if enc != base.UTF8 {
        if enc == base.UTF16 -> enc = base.UTF16NATIVE
        len = util.clear_bits(len, 1)
    }
    bind_text_enc(db, s, i, z, len, enc)
}

// sqlite3_bind_text16.
bind_text16: fn(db: &conn.Conn, s: Int, i: Int, z: [U8]?, n: Int) -> Int Never! { bind_text_enc(db, s, i, z, util.clear_bits(n, 1), base.UTF16NATIVE) }

// sqlite3_bind_value: a copy of value p, by its datatype.
bind_value: fn(db: &conn.Conn, s: Int, i: Int, p: base.Mem) -> Int Never! {
    t: base.value_type(p)
    if t == base.SQL_INTEGER -> return bind_int64(db, s, i, p.i)
    if t == base.SQL_FLOAT {
        r: if p.flags.bit_and(base.MEM_REAL) != 0 -> p.r else -> util.int_to_double(p.i)
        return bind_double(db, s, i, r)
    }
    if t == base.SQL_BLOB {
        if p.flags.bit_and(base.MEM_ZERO) != 0 -> return bind_zeroblob(db, s, i, p.i)
        return bind_blob(db, s, i, Val(p.z), p.z.len())
    }
    if t == base.SQL_TEXT -> return bind_text_enc(db, s, i, Val(p.z), p.z.len(), p.enc)
    bind_null(db, s, i)
}

// sqlite3_bind_zeroblob: a blob of n zero bytes.
bind_zeroblob: fn(db: &conn.Conn, s: Int, i: Int, n: Int) -> Int Never! {
    rc: unbind(db, s, i - 1)
    if rc == base.OK -> mem.set_zero_blob(db.vdbes[s].vars[i - 1], n)
    rc
}

// sqlite3_bind_zeroblob64: SQLITE_TOOBIG past SQLITE_LIMIT_LENGTH.
bind_zeroblob64: fn(db: &conn.Conn, s: Int, i: Int, n: Int) -> Int Never! {
    rc := base.OK
    if n < 0 || n > db.limits[ast.LIMIT_LENGTH] {
        rc = base.TOOBIG
    } else {
        rc = bind_zeroblob(db, s, i, n)
    }
    aux.api_exit(db, rc)
}

// sqlite3_bind_parameter_count.
bind_parameter_count: fn(db: conn.Conn, s: Int) -> Int Never! { db.vdbes[s].n_var }

// sqlite3_bind_parameter_name: the name of parameter i (from 1), None for
// a nameless "?" or an index out of range.
bind_parameter_name: fn(db: conn.Conn, s: Int, i: Int) -> [U8]? Never! {
    if i < 1 || i > db.vdbes[s].var_names.len() -> return None
    db.vdbes[s].var_names[i - 1]
}

// sqlite3_bind_parameter_index (sqlite3VdbeParameterIndex): the index of
// the parameter named `name`, 0 when none has that name.
bind_parameter_index: fn(db: conn.Conn, s: Int, name: [U8]) -> Int Never! {
    loop k in 0..<db.vdbes[s].var_names.len() {
        if db.vdbes[s].var_names[k] == .Val(z) && z == name -> return k + 1
    }
    0
}

// sqlite3_transfer_bindings (sqlite3TransferBindings): move the values of
// statement from's parameters to statement to's, which has as many;
// SQLITE_ERROR when the counts differ. Plans that used them expire.
transfer_bindings: fn(db: &conn.Conn, from: Int, to: Int) -> Int Never! {
    n: db.vdbes[from].n_var
    if n != db.vdbes[to].n_var -> return base.ERROR
    if db.vdbes[to].expmask != 0 -> db.vdbe_links[to].expired = conn.EXPIRED_NOW
    if db.vdbes[from].expmask != 0 -> db.vdbe_links[from].expired = conn.EXPIRED_NOW
    loop i in 0..<n {
        m: db.vdbes[from].vars[i].copy()
        db.vdbes[to].vars[i] = m
        db.vdbes[from].vars[i] = base.mem_null()
    }
    base.OK
}

// ---------------------------------------------------------------------------
// The function context: the call in progress of statement v (Vdbe.fctx),
// whose result goes to register fctx.out.

// setResultStrOrError: the result becomes z (n bytes of it, or to its
// terminator for n < 0) of encoding enc, or a blob for enc 0, converted to
// the connection's encoding; SQLITE_TOOBIG past SQLITE_LIMIT_LENGTH.
result_str: fn(db: &conn.Conn, v: &conn.Vdbe, z: [U8], n: Int, enc: Int) Never! {
    o: v.fctx.out
    limit: db.limits[ast.LIMIT_LENGTH]
    rc: mem.set_str(v.mem[o], z, n, enc, limit)
    if rc != base.OK {
        result_error_toobig(v)
        return
    }
    mem.change_encoding(v.mem[o], db.enc)
    if mem.too_big(v.mem[o], limit) -> result_error_toobig(v)
}

// sqlite3_result_blob: n bytes of z; a negative n is SQLITE_TOOBIG.
result_blob: fn(db: &conn.Conn, v: &conn.Vdbe, z: [U8], n: Int) Never! {
    if n < 0 {
        result_error_toobig(v)
        return
    }
    result_str(db, v, z, n, 0)
}

// sqlite3_result_blob64: past 0x7fffffff bytes, SQLITE_TOOBIG.
result_blob64: fn(db: &conn.Conn, v: &conn.Vdbe, z: [U8], n: Int) Never! {
    if n < 0 || n > 2147483647 {
        result_error_toobig(v)
        return
    }
    result_str(db, v, z, n, 0)
}

// sqlite3_result_double.
result_double: fn(v: &conn.Vdbe, r: Float) Never! { mem.set_double(v.mem[v.fctx.out], r) }

// sqlite3_result_error: the call fails with message z (n bytes, or to its
// terminator for n < 0) and SQLITE_ERROR.
result_error: fn(db: conn.Conn, v: &conn.Vdbe, z: [U8], n: Int) Never! {
    v.fctx.is_error = base.ERROR
    _: mem.set_str(v.mem[v.fctx.out], z, n, base.UTF8, db.limits[ast.LIMIT_LENGTH])
}

// sqlite3_result_error16.
result_error16: fn(db: conn.Conn, v: &conn.Vdbe, z: [U8], n: Int) Never! {
    v.fctx.is_error = base.ERROR
    _: mem.set_str(v.mem[v.fctx.out], z, n, base.UTF16NATIVE, db.limits[ast.LIMIT_LENGTH])
}

// sqlite3_result_int.
result_int: fn(v: &conn.Vdbe, value: Int) Never! { mem.set_int64(v.mem[v.fctx.out], value) }

// sqlite3_result_int64.
result_int64: fn(v: &conn.Vdbe, value: Int) Never! { mem.set_int64(v.mem[v.fctx.out], value) }

// sqlite3_result_null.
result_null: fn(v: &conn.Vdbe) Never! { mem.set_null(v.mem[v.fctx.out]) }

// sqlite3_result_pointer (sqlite3VdbeMemSetPointer): a NULL that carries
// the Host's pointer handle `handle` of type ptype.
result_pointer: fn(v: &conn.Vdbe, handle: Int, ptype: [U8]) Never! {
    o: v.fctx.out
    run.release_dyn(v, o)
    m := base.mem_init(base.MEM_NULL.bit_or(conn.MEM_DYN).bit_or(base.MEM_SUBTYPE))
    m.subtype = conn.DYN_POINTER
    m.z = ptype
    m.i = handle
    v.mem[o] = m
}

// sqlite3_value_pointer: the handle of a pointer value of type ptype.
value_pointer: fn(m: base.Mem, ptype: [U8]) -> Int? Never! {
    want: base.MEM_NULL.bit_or(conn.MEM_DYN).bit_or(base.MEM_SUBTYPE)
    if m.flags.bit_and(base.MEM_TYPE_MASK.bit_or(conn.MEM_DYN)) == want && m.subtype == conn.DYN_POINTER && m.z == ptype -> return Val(m.i)
    None
}

// sqlite3_result_subtype: the low 8 bits of e_subtype tag the result.
result_subtype: fn(v: &conn.Vdbe, e_subtype: Int) Never! {
    o: v.fctx.out
    v.mem[o].subtype = e_subtype.bit_and(255)
    v.mem[o].flags = v.mem[o].flags.bit_or(base.MEM_SUBTYPE)
}

// sqlite3_result_text.
result_text: fn(db: &conn.Conn, v: &conn.Vdbe, z: [U8], n: Int) Never! { result_str(db, v, z, n, base.UTF8) }

// sqlite3_result_text64: text of encoding enc (SQLITE_UTF16 is the native
// order); UTF-16 drops an odd last byte; past 0x7fffffff bytes,
// SQLITE_TOOBIG.
result_text64: fn(db: &conn.Conn, v: &conn.Vdbe, z: [U8], n: Int, enc_in: Int) Never! {
    enc := enc_in
    len := n
    if enc != base.UTF8 {
        if enc == base.UTF16 -> enc = base.UTF16NATIVE
        len = util.clear_bits(len, 1)
    }
    if len < 0 || len > 2147483647 {
        result_error_toobig(v)
        return
    }
    result_str(db, v, z, len, enc)
}

// sqlite3_result_text16.
result_text16: fn(db: &conn.Conn, v: &conn.Vdbe, z: [U8], n: Int) Never! { result_str(db, v, z, util.clear_bits(n, 1), base.UTF16NATIVE) }

// sqlite3_result_text16be.
result_text16be: fn(db: &conn.Conn, v: &conn.Vdbe, z: [U8], n: Int) Never! { result_str(db, v, z, util.clear_bits(n, 1), base.UTF16BE) }

// sqlite3_result_text16le.
result_text16le: fn(db: &conn.Conn, v: &conn.Vdbe, z: [U8], n: Int) Never! { result_str(db, v, z, util.clear_bits(n, 1), base.UTF16LE) }

// sqlite3_result_value: a copy of value p, in the connection's encoding.
result_value: fn(db: conn.Conn, v: &conn.Vdbe, p: base.Mem) Never! {
    o: v.fctx.out
    run.release_dyn(v, o)
    v.mem[o] = mem.mem_copy(p)
    mem.change_encoding(v.mem[o], db.enc)
    if mem.too_big(v.mem[o], db.limits[ast.LIMIT_LENGTH]) -> result_error_toobig(v)
}

// sqlite3_result_zeroblob.
result_zeroblob: fn(db: conn.Conn, v: &conn.Vdbe, n: Int) Never! {
    _: result_zeroblob64(db, v, if n > 0 -> n else -> 0)
}

// sqlite3_result_zeroblob64: SQLITE_TOOBIG past SQLITE_LIMIT_LENGTH.
result_zeroblob64: fn(db: conn.Conn, v: &conn.Vdbe, n: Int) -> Int Never! {
    if n < 0 || n > db.limits[ast.LIMIT_LENGTH] {
        result_error_toobig(v)
        return base.TOOBIG
    }
    mem.set_zero_blob(v.mem[v.fctx.out], n)
    base.OK
}

// sqlite3_result_error_code: the call fails with code err_code, its
// message that code's text unless one is set.
result_error_code: fn(db: &conn.Conn, v: &conn.Vdbe, err_code: Int) Never! {
    v.fctx.is_error = if err_code != 0 -> err_code else -> -1
    if v.mem[v.fctx.out].flags.bit_and(base.MEM_NULL) != 0 {
        result_str(db, v, base.error_string(err_code).bytes(), -1, base.UTF8)
    }
}

// sqlite3_result_error_toobig.
result_error_toobig: fn(v: &conn.Vdbe) Never! {
    v.fctx.is_error = base.TOOBIG
    o: v.fctx.out
    v.mem[o] = base.mem_text("string or blob too big".bytes(), base.UTF8)
}

// sqlite3_result_error_nomem.
result_error_nomem: fn(db: &conn.Conn, v: &conn.Vdbe) Never! {
    mem.set_null(v.mem[v.fctx.out])
    v.fctx.is_error = base.NOMEM
    aux.oom_fault(db)
}

// sqlite3ResultIntReal: an integer result becomes an integer-valued REAL.
result_int_real: fn(v: &conn.Vdbe) Never! {
    o: v.fctx.out
    f: v.mem[o].flags
    if f.bit_and(base.MEM_INT) != 0 -> v.mem[o].flags = util.clear_bits(f, base.MEM_INT).bit_or(base.MEM_INT_REAL)
}

// sqlite3_user_data: pUserData of the function the call runs.
user_data: fn(v: conn.Vdbe) -> Int Never! { v.fctx.user_data }

// sqlite3_vtab_nochange: whether xColumn runs for an UPDATE that leaves
// the column as it is.
vtab_nochange: fn(v: conn.Vdbe) -> Bool Never! { mem.value_nochange(v.mem[v.fctx.out]) }

// valueFromValueList (sqlite3_vtab_in_first, sqlite3_vtab_in_next): the
// first (or next) value of the IN list of value `list` (OP_VInitIn's
// ValueList) into `out`; SQLITE_DONE past the last, SQLITE_ERROR for a
// value that is no ValueList.
value_list_value: fn(db: &conn.Conn, v: &conn.Vdbe, list: base.Mem, out: &base.Mem, b_next: Bool) -[DB]> Int Never! {
    is_list: list.flags.bit_and(conn.MEM_DYN) != 0 && list.subtype == conn.DYN_POINTER && list.z == "ValueList".bytes()
    if !is_list -> return base.ERROR
    o: v.ops[list.i]
    ci: run.csr(v, o.p1)
    bt: v.csr[ci].bt
    btc: v.csr[ci].btc
    rc := base.OK
    if b_next {
        rc = btree.btree_next(db.btrees[bt], btc, 0)
    } else {
        dummy := 0
        rc = btree.btree_first(db.btrees[bt], btc, dummy)
        if btree.btree_eof(db.btrees[bt], btc) -> rc = base.DONE
    }
    if rc != base.OK -> return rc
    sz: btree.btree_payload_size(db.btrees[bt], btc)
    buf := [U8]{}
    at := 0
    rc = aux.cursor_payload(db, bt, btc, sz, buf, at)
    if rc != base.OK -> return rc
    serial: util.get_varint32(buf, at + 1)
    m := record.serial_get(buf, at + 1 + serial.len, serial.value, db.enc)
    m.enc = db.enc
    k: v.mem_base + o.p3
    v.mem[k] = m.copy()
    out = m
    base.OK
}

// sqlite3_vtab_in_first.
vtab_in_first: fn(db: &conn.Conn, v: &conn.Vdbe, list: base.Mem, out: &base.Mem) -[DB]> Int Never! { value_list_value(db, v, list, out, false) }

// sqlite3_vtab_in_next.
vtab_in_next: fn(db: &conn.Conn, v: &conn.Vdbe, list: base.Mem, out: &base.Mem) -[DB]> Int Never! { value_list_value(db, v, list, out, true) }

// sqlite3StmtCurrentTime: the time of the statement's step in milliseconds
// of the Julian day, the same for every call within the step.
stmt_current_time: fn(v: &conn.Vdbe) -[DB]> Int Never! {
    if v.i_current_time == 0 -> v.i_current_time = os.os_current_time()
    v.i_current_time
}

// sqlite3_aggregate_context: the Vdbe.aggs slot of the call's aggregate
// context, made at the first request with n_byte > 0; -1 (and a NULL
// accumulator) for n_byte <= 0 before then.
aggregate_context: fn(v: &conn.Vdbe, n_byte: Int) -> Int Never! {
    a: v.fctx.agg
    if v.mem[a].flags.bit_and(base.MEM_AGG) != 0 -> return v.mem[a].i
    if n_byte <= 0 {
        run.release_dyn(v, a)
        v.mem[a] = base.mem_null()
        return -1
    }
    k := v.aggs.len()
    if v.agg_free.pop() == .Val(free) {
        k = free
        v.aggs[k] = conn.agg_state_new()
    } else {
        v.aggs.push(conn.agg_state_new())
    }
    v.aggs[k].allocated = true
    run.release_dyn(v, a)
    m := base.mem_init(base.MEM_AGG)
    m.i = k
    v.mem[a] = m
    k
}

// sqlite3_get_auxdata: the auxiliary data argument i_arg of this call's op
// keeps (for i_arg < 0, the function's of any op), None when unset.
get_auxdata: fn(v: conn.Vdbe, i_arg: Int) -> base.Mem? Never! {
    depth: v.frames.len()
    loop a in v.aux {
        if a.depth == depth && a.i_aux_arg == i_arg && (a.i_aux_op == v.fctx.i_op || i_arg < 0) -> return Val(a.value)
    }
    None
}

// sqlite3_set_auxdata: keep `value` as argument i_arg's auxiliary data
// for later calls of this op.
set_auxdata: fn(v: &conn.Vdbe, i_arg: Int, value: base.Mem) Never! {
    depth: v.frames.len()
    loop k in 0..<v.aux.len() {
        a: v.aux[k]
        if a.depth == depth && a.i_aux_arg == i_arg && (a.i_aux_op == v.fctx.i_op || i_arg < 0) {
            v.aux[k].value = value
            return
        }
    }
    v.aux.push(conn.AuxData{depth: depth, i_aux_op: v.fctx.i_op, i_aux_arg: i_arg, value: value})
    if v.fctx.is_error == 0 -> v.fctx.is_error = -1
}

// ---------------------------------------------------------------------------
// Tests.

// A ready statement of the ops `ops` (no P4) after the OP_Init that
// vdbe_create starts it with, over n_mem registers and n_var parameters, in
// its slot with result columns named `names`.
api_test_stmt: fn(db: &conn.Conn, ops: [(op: Int, p1: Int, p2: Int, p3: Int)], n_mem: Int, n_var: Int, names: [String]) -> Int Never! {
    v := aux.vdbe_create(db)
    loop o in ops {
        _: aux.add_op3(db, v, o.op, o.p1, o.p2, o.p3)
    }
    aux.set_num_cols(v, names.len())
    loop k in 0..<names.len() {
        _: aux.set_col_name(db, v, k, conn.COLNAME_NAME, names[k].bytes())
    }
    aux.make_ready(db, v, n_var, n_mem, 0, 0, false)
    s: v.slot
    conn.vdbe_put(db, v)
    s
}

text_of: fn(z: [U8]?) -> String Never! { String.from_bytes(z ?? [U8]{}) ?? "" }

#Test("a statement steps to its row, reads its columns and halts") {
    db := conn.conn_new()
    h := TestHost{interrupt_at: 0, progress_calls: 0}
    s: api_test_stmt(db, [(op: Int, p1: Int, p2: Int, p3: Int)]{(op: opc.OP_INTEGER, p1: 42, p2: 1, p3: 0), (op: opc.OP_NULL, p1: 0, p2: 2, p3: 0), (op: opc.OP_RESULT_ROW, p1: 1, p2: 2, p3: 0), (op: opc.OP_HALT, p1: 0, p2: 0, p3: 0)}, 3, 0, [String]{"a", "b"})
    assert_eq(column_count(db, s), 2)
    assert_eq(data_count(db, s), 0)
    assert_eq(text_of(column_name(db, s, 1)), "b")
    assert(column_name(db, s, 2) == None)
    assert_eq(stmt_step<TestHost>(h, db, s), base.ROW)
    assert(stmt_busy(db, s))
    assert_eq(db.n_vdbe_active, 1)
    assert_eq(data_count(db, s), 2)
    assert_eq(column_int64(db, s, 0), 42)
    assert_eq(column_type(db, s, 0), base.SQL_INTEGER)
    assert_eq(text_of(column_text(db, s, 0)), "42")
    assert_eq(column_bytes(db, s, 0), 2)
    assert_eq(column_type(db, s, 1), base.SQL_NULL)
    assert(column_text(db, s, 1) == None)
    assert_eq(column_type(db, s, 5), base.SQL_NULL)
    assert_eq(db.err_code, base.RANGE)
    assert_eq(stmt_step<TestHost>(h, db, s), base.DONE)
    assert(!stmt_busy(db, s))
    assert_eq(db.n_vdbe_active, 0)
    assert_eq(data_count(db, s), 0)
    // A halted statement resets itself at the next step.
    assert_eq(stmt_step<TestHost>(h, db, s), base.ROW)
    assert_eq(stmt_reset<TestHost>(h, db, s), base.OK)
    assert_eq(db.n_vdbe_active, 0)
    assert_eq(stmt_finalize<TestHost>(h, db, s), base.OK)
    assert_eq(next_stmt(db, -1), -1)
}

#Test("parameters bind by index, reject a running statement and expire plans that used them") {
    db := conn.conn_new()
    h := TestHost{interrupt_at: 0, progress_calls: 0}
    s: api_test_stmt(db, [(op: Int, p1: Int, p2: Int, p3: Int)]{(op: opc.OP_VARIABLE, p1: 1, p2: 1, p3: 0), (op: opc.OP_VARIABLE, p1: 2, p2: 2, p3: 0), (op: opc.OP_RESULT_ROW, p1: 1, p2: 2, p3: 0), (op: opc.OP_HALT, p1: 0, p2: 0, p3: 0)}, 3, 2, [String]{"x", "y"})
    assert_eq(bind_parameter_count(db, s), 2)
    assert_eq(bind_text(db, s, 1, Val("hi".bytes()), -1), base.OK)
    assert_eq(bind_double(db, s, 2, Float{1.5}), base.OK)
    assert_eq(bind_int64(db, s, 3, 1), base.RANGE)
    assert_eq(bind_int64(db, s, 0, 1), base.RANGE)
    assert_eq(stmt_step<TestHost>(h, db, s), base.ROW)
    assert_eq(text_of(column_text(db, s, 0)), "hi")
    assert_eq(column_double(db, s, 1), Float{1.5})
    assert_eq(bind_null(db, s, 1), base.MISUSE)
    assert_eq(stmt_reset<TestHost>(h, db, s), base.OK)
    db.vdbes[s].expmask = 1
    assert_eq(bind_blob(db, s, 1, Val([U8]{1, 2, 3}), 2), base.OK)
    assert(stmt_expired(db, s))
    assert_eq(db.vdbes[s].vars[0].z.len(), 2)
    assert_eq(base.value_type(db.vdbes[s].vars[0]), base.SQL_BLOB)
    // An expired statement fails with SQLITE_SCHEMA; only a statement that
    // keeps its SQL is recompiled.
    assert_eq(stmt_step<TestHost>(h, db, s), base.ERROR)
    assert_eq(db.vdbes[s].rc, base.SCHEMA)
    clear_bindings(db, s)
    assert_eq(base.value_type(db.vdbes[s].vars[0]), base.SQL_NULL)
}

#Test("an EXPLAIN statement lists its program under the EXPLAIN column names") {
    db := conn.conn_new()
    h := TestHost{interrupt_at: 0, progress_calls: 0}
    v := aux.vdbe_create(db)
    _: aux.add_op3(db, v, opc.OP_HALT, 0, 0, 0)
    aux.make_ready(db, v, 0, 1, 0, 1, false)
    s: v.slot
    conn.vdbe_put(db, v)
    assert_eq(column_count(db, s), 8)
    assert_eq(text_of(column_name(db, s, 1)), "opcode")
    assert(column_decltype(db, s, 1) == None)
    assert_eq(stmt_step<TestHost>(h, db, s), base.ROW)
    assert_eq(text_of(column_text(db, s, 1)), "Init")
    assert_eq(stmt_step<TestHost>(h, db, s), base.ROW)
    assert_eq(text_of(column_text(db, s, 1)), "Halt")
    assert_eq(stmt_step<TestHost>(h, db, s), base.DONE)
    assert_eq(stmt_explain<TestHost>(h, db, s, 1), base.OK)
    assert_eq(stmt_explain<TestHost>(h, db, s, 3), base.ERROR)
}

#Test("function results land in the call's output register") {
    db := conn.conn_new()
    v := conn.vdbe_new()
    v.mem.push(base.mem_null())
    v.mem.push(base.mem_null())
    v.fctx.out = 0
    v.fctx.agg = 1
    result_text(db, v, "abc".bytes(), 2)
    assert_eq(String.from_bytes(v.mem[0].z) ?? "", "ab")
    result_int(v, 7)
    result_int_real(v)
    assert_eq(base.value_type(v.mem[0]), base.SQL_FLOAT)
    result_subtype(v, 300)
    assert_eq(mem.value_subtype(v.mem[0]), 44)
    v.mem[0] = base.mem_null()
    result_error_code(db, v, base.CONSTRAINT)
    assert_eq(v.fctx.is_error, base.CONSTRAINT)
    assert_eq(String.from_bytes(v.mem[0].z) ?? "", "constraint failed")
    db.limits[ast.LIMIT_LENGTH] = 4
    v.fctx.is_error = 0
    result_blob(db, v, [U8]{1, 2, 3, 4, 5}, 5)
    assert_eq(v.fctx.is_error, base.TOOBIG)
    assert_eq(result_zeroblob64(db, v, 5), base.TOOBIG)
    result_pointer(v, 9, "carray".bytes())
    assert_eq(value_pointer(v.mem[0], "carray".bytes()) ?? -1, 9)
    assert(value_pointer(v.mem[0], "other".bytes()) == None)
    assert_eq(aggregate_context(v, 0), -1)
    k: aggregate_context(v, 16)
    assert(k >= 0)
    assert_eq(aggregate_context(v, 16), k)
    v.fctx.is_error = 0
    v.fctx.i_op = 3
    assert(get_auxdata(v, 0) == None)
    set_auxdata(v, 0, base.mem_int(5))
    assert_eq(v.fctx.is_error, -1)
    assert((get_auxdata(v, 0) ?? base.mem_null()).i == 5)
    v.fctx.i_op = 4
    assert(get_auxdata(v, 0) == None)
}
