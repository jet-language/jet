// The control-flow, constant, register, arithmetic, comparison and logic
// opcodes of the Jet SQLite engine: the cases of SQLite 3.45.0
// sqlite3VdbeExec (vdbe.c) from OP_Goto to OP_ZeroOrNull. Each handler runs
// the op at Run.pc and answers a vdberun.GO_* code.

use {
    math: core.math
    base: __core_db_base
    __core_db_base.[MEM_NULL, MEM_STR, MEM_INT, MEM_REAL, MEM_BLOB, MEM_INT_REAL, MEM_ZERO, MEM_CLEARED, MEM_SUBTYPE, MEM_TYPE_MASK, MEM_FROM_BIND]
    util: __core_db_util
    __core_db_util.[clear_bits]
    mem: __core_db_mem
    record: __core_db_record
    ast: __core_db_ast
    conn: __core_db_conn
    opc: __core_db_opcodes
    aux: __core_db_vdbeaux
    __core_db_vdbeaux.[Host]
    run: __core_db_vdberun
    __core_db_vdberun.[Run, GO_NEXT, GO_JUMP, GO_JUMP_CHECK, GO_ERROR, GO_NO_MEM, GO_TOO_BIG, GO_RETURN, test_run, test_op]
}

// ---------------------------------------------------------------------------
// Control flow.

// OP_Gosub: P1 = the return address, then jump.
op_gosub: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    v.mem[i].flags = MEM_INT
    v.mem[i].i = r.pc
    GO_JUMP_CHECK
}

// OP_Return: back past the OP_Gosub whose address P1 holds.
op_return: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    if v.mem[i].flags.bit_and(MEM_INT) != 0 -> r.pc = v.mem[i].i
    GO_NEXT
}

// OP_InitCoroutine.
op_init_coroutine: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    v.mem[i].i = r.p3 - 1
    v.mem[i].flags = MEM_INT
    if r.p2 == 0 -> return GO_NEXT
    GO_JUMP
}

// OP_EndCoroutine: to the P2 of the OP_Yield that called.
op_end_coroutine: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    caller: v.mem[i].i
    r.pc = v.ops[caller].p2 - 1
    v.mem[i].flags = conn.MEM_UNDEFINED
    GO_NEXT
}

// OP_Yield: swap the program counter with the address P1 holds.
op_yield: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    v.mem[i].flags = MEM_INT
    dest: v.mem[i].i
    v.mem[i].i = r.pc
    r.pc = dest
    GO_NEXT
}

// The constraint kinds of OP_Halt's P5.
HALT_TYPES: ["NOT NULL", "UNIQUE", "CHECK", "FOREIGN KEY"]

// OP_Halt (and OP_HaltIfNull once P3 is NULL). In a trigger program with
// P1 OK, back to the parent (past its OP_Program, or to its P2 for
// OE_Ignore); otherwise end the statement with P1, P2 its errorAction.
op_halt: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    if v.frames.len() > 0 && r.p1 == base.OK {
        aux.set_changes(db, v.n_change)
        pcx := aux.frame_restore<H>(h, db, v)
        if r.p2 == ast.OE_IGNORE -> pcx = v.ops[pcx].p2 - 1
        r.pc = pcx
        return GO_NEXT
    }
    v.rc = r.p1
    v.error_action = r.p2
    if v.rc != base.OK {
        if r.p5 != 0 {
            msg := "{HALT_TYPES[r.p5 - 1]} constraint failed".bytes()
            if run.p4_text(v, r.pc) == .Val(z) {
                aux.append_bytes(msg, ": ".bytes())
                aux.append_bytes(msg, z)
            }
            aux.vdbe_error(v, msg)
        } else {
            msg: run.p4_text(v, r.pc) ?? [U8]{}
            aux.vdbe_error(v, msg)
        }
    }
    rc: aux.halt<H>(h, db, v)
    if rc == base.BUSY {
        v.rc = base.BUSY
        r.rc = base.BUSY
    } else {
        r.rc = if v.rc != base.OK -> base.ERROR else -> base.DONE
    }
    GO_RETURN
}

// OP_HaltIfNull.
op_halt_if_null: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    if v.mem[v.mem_base + r.p3].flags.bit_and(MEM_NULL) == 0 -> return GO_NEXT
    op_halt<H>(h, db, v, r)
}

// ---------------------------------------------------------------------------
// Constants and registers.

// OP_Integer.
op_integer: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p2
    run.out2(v, i)
    v.mem[i].i = r.p1
    GO_NEXT
}

// OP_Int64.
op_int64: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p2
    run.out2(v, i)
    v.mem[i].i = run.p4_int(v, r.pc)
    GO_NEXT
}

// OP_Real.
op_real: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p2
    run.out2(v, i)
    v.mem[i].flags = MEM_REAL
    if v.ops[r.pc].p4 == .Real(x) -> v.mem[i].r = x
    GO_NEXT
}

// OP_String8: the UTF-8 text P4, converted to the database encoding once
// and the op turned into OP_String.
op_string8: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p2
    run.out2(v, i)
    z := run.p4_text(v, r.pc) ?? [U8]{}
    n := mem.c_text_len(z, base.UTF8, db.limits[ast.LIMIT_LENGTH])
    if r.enc != base.UTF8 {
        if mem.set_str(v.mem[i], z, -1, base.UTF8, db.limits[ast.LIMIT_LENGTH]) != base.OK -> return GO_TOO_BIG
        mem.change_encoding(v.mem[i], r.enc)
        z = v.mem[i].z.copy()
        n = z.len()
        run.set_p4(v, r.pc, .Text(z))
    }
    run.set_p1(v, r.pc, n)
    if n > db.limits[ast.LIMIT_LENGTH] -> return GO_TOO_BIG
    run.set_opcode(v, r.pc, opc.OP_STRING)
    r.p1 = n
    op_string(v, r)
}

// OP_String: the P1 bytes of P4 in the database encoding; a blob when
// register P3 holds P5 (the LIKE operator's blob test).
op_string: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p2
    run.out2(v, i)
    v.mem[i].flags = MEM_STR
    if v.ops[r.pc].p4 == .Text(z) {
        v.mem[i].z = if r.p1 < z.len() -> z[0..<r.p1].copy() else -> z.copy()
    } else {
        v.mem[i].z = [U8]{}
    }
    v.mem[i].enc = r.enc
    if r.p3 > 0 && v.mem[v.mem_base + r.p3].i == r.p5 -> v.mem[i].flags = MEM_BLOB
    GO_NEXT
}

// OP_BeginSubrtn / OP_Null: registers P2..P3 NULL, MEM_Cleared too with
// P1 (so that OP_Ne with SQLITE_NULLEQ tells them apart).
op_null: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p2
    run.out2(v, i)
    null_flag: if r.p1 != 0 -> MEM_NULL.bit_or(MEM_CLEARED) else -> MEM_NULL
    v.mem[i].flags = null_flag
    v.mem[i].z = [U8]{}
    loop k in i + 1..<v.mem_base + r.p3 + 1 {
        run.reg_null(v, k)
        v.mem[k].flags = null_flag
    }
    GO_NEXT
}

// OP_SoftNull.
op_soft_null: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    v.mem[i].flags = clear_bits(v.mem[i].flags, base.MEM_AFF_MASK).bit_or(MEM_NULL)
    GO_NEXT
}

// OP_Blob: the P1 bytes of P4, or P1 zero bytes without a P4.
op_blob: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p2
    run.out2(v, i)
    if run.p4_text(v, r.pc) == .Val(z) {
        _: mem.set_str(v.mem[i], z, r.p1, 0, base.I64_MAX)
    } else {
        mem.set_zero_blob(v.mem[i], r.p1)
        mem.expand_blob(v.mem[i])
    }
    v.mem[i].enc = r.enc
    GO_NEXT
}

// OP_Variable: the value bound to parameter P1.
op_variable: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -> Int Never! {
    if mem.too_big(v.vars[r.p1 - 1], db.limits[ast.LIMIT_LENGTH]) -> return GO_TOO_BIG
    i: v.mem_base + r.p2
    m := v.vars[r.p1 - 1].copy()
    m.flags = m.flags.bit_or(MEM_FROM_BIND)
    run.reg_set(v, i, m)
    GO_NEXT
}

// OP_Move: registers P1..P1+P3-1 move to P2..P2+P3-1, leaving the sources
// undefined.
op_move: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    from: v.mem_base + r.p1
    to: v.mem_base + r.p2
    loop k in 0..<r.p3 {
        run.release_dyn(v, to + k)
        m := v.mem[from + k].copy()
        v.mem[to + k] = m
        v.mem[from + k].flags = conn.MEM_UNDEFINED
        v.mem[from + k].z = [U8]{}
    }
    GO_NEXT
}

// OP_Copy: registers P1..P1+P3 copy to P2..P2+P3; P5 bit 2 drops the
// subtype.
op_copy: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    from: v.mem_base + r.p1
    to: v.mem_base + r.p2
    loop k in 0..<r.p3 + 1 {
        run.reg_copy(v, to + k, from + k)
        if v.mem[to + k].flags.bit_and(MEM_SUBTYPE) != 0 && r.p5.bit_and(2) != 0 -> v.mem[to + k].flags = clear_bits(v.mem[to + k].flags, MEM_SUBTYPE)
    }
    GO_NEXT
}

// OP_SCopy.
op_scopy: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    run.reg_copy(v, v.mem_base + r.p2, v.mem_base + r.p1)
    GO_NEXT
}

// OP_IntCopy.
op_int_copy: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    run.reg_int(v, v.mem_base + r.p2, v.mem[v.mem_base + r.p1].i)
    GO_NEXT
}

// OP_FkCheck: the immediate foreign key constraints hold.
op_fk_check: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -> Int Never! {
    r.rc = aux.check_fk(db, v, false)
    if r.rc != base.OK -> return GO_ERROR
    GO_NEXT
}

// OP_ResultRow: registers P1..P1+P2-1 are a row of the result.
op_result_row: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    v.cache_ctr = (v.cache_ctr + 2).bit_or(1)
    v.result_row = v.mem_base + r.p1
    if db.malloc_failed -> return GO_NO_MEM
    if db.m_trace.bit_and(conn.TRACE_ROW) != 0 -> h.trace(db, v, conn.TRACE_ROW, [U8]{})
    v.pc = r.pc + 1
    r.rc = base.ROW
    GO_RETURN
}

// OP_Concat: P3 = P2 || P1. A number is rendered as text for the
// operation only.
op_concat: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -> Int Never! {
    i1: v.mem_base + r.p1
    i2: v.mem_base + r.p2
    out: v.mem_base + r.p3
    flags1 := v.mem[i1].flags
    if flags1.bit_or(v.mem[i2].flags).bit_and(MEM_NULL) != 0 {
        run.reg_null(v, out)
        return GO_NEXT
    }
    if flags1.bit_and(MEM_STR.bit_or(MEM_BLOB)) == 0 {
        mem.stringify(v.mem[i1], r.enc, false)
        flags1 = clear_bits(v.mem[i1].flags, MEM_STR)
    } else if flags1.bit_and(MEM_ZERO) != 0 {
        mem.expand_blob(v.mem[i1])
        flags1 = clear_bits(v.mem[i1].flags, MEM_STR)
    }
    flags2 := v.mem[i2].flags
    if flags2.bit_and(MEM_STR.bit_or(MEM_BLOB)) == 0 {
        mem.stringify(v.mem[i2], r.enc, false)
        flags2 = clear_bits(v.mem[i2].flags, MEM_STR)
    } else if flags2.bit_and(MEM_ZERO) != 0 {
        mem.expand_blob(v.mem[i2])
        flags2 = clear_bits(v.mem[i2].flags, MEM_STR)
    }
    n_byte := v.mem[i1].z.len() + v.mem[i2].z.len()
    if n_byte > db.limits[ast.LIMIT_LENGTH] -> return GO_TOO_BIG
    z := v.mem[i2].z.copy()
    loop b in v.mem[i1].z -> z.push(b)
    if r.enc > base.UTF8 && n_byte.bit_and(1) == 1 -> _: z.pop()
    if out != i2 -> v.mem[i2].flags = flags2
    v.mem[i1].flags = flags1
    run.release_dyn(v, out)
    mem.set_type_flag(v.mem[out], MEM_STR)
    v.mem[out].z = z
    v.mem[out].enc = r.enc
    GO_NEXT
}

// ---------------------------------------------------------------------------
// Arithmetic.

// OP_Add, OP_Subtract, OP_Multiply, OP_Divide, OP_Remainder: P3 = P2 op
// P1, in integers while they hold and do not overflow, else in REALs. A
// NULL operand, division by zero or a NaN gives NULL.
op_arith: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i1: v.mem_base + r.p1
    i2: v.mem_base + r.p2
    out: v.mem_base + r.p3
    type1 := v.mem[i1].flags
    type2 := v.mem[i2].flags
    int_math := false
    if type1.bit_and(type2).bit_and(MEM_INT) != 0 {
        int_math = true
    } else if type1.bit_or(type2).bit_and(MEM_NULL) != 0 {
        run.reg_null(v, out)
        return GO_NEXT
    } else {
        type1 = mem.numeric_type(v.mem[i1])
        type2 = mem.numeric_type(v.mem[i2])
        int_math = type1.bit_and(type2).bit_and(MEM_INT) != 0
    }
    if int_math {
        a := v.mem[i1].i
        b: v.mem[i2].i
        res := Int?{None}
        if r.op == opc.OP_ADD {
            res = util.add_int64(b, a)
        } else if r.op == opc.OP_SUBTRACT {
            res = util.sub_int64(b, a)
        } else if r.op == opc.OP_MULTIPLY {
            res = util.mul_int64(b, a)
        } else {
            if a == 0 {
                run.reg_null(v, out)
                return GO_NEXT
            }
            if r.op == opc.OP_DIVIDE {
                if a != -1 || b != base.I64_MIN -> res = Val(util.c_div(b, a))
            } else {
                if a == -1 -> a = 1
                res = Val(util.c_rem(b, a))
            }
        }
        if res == .Val(x) {
            run.release_dyn(v, out)
            v.mem[out].i = x
            mem.set_type_flag(v.mem[out], MEM_INT)
            return GO_NEXT
        }
    }
    ra: mem.real_value(v.mem[i1])
    rb := mem.real_value(v.mem[i2])
    if r.op == opc.OP_ADD {
        rb += ra
    } else if r.op == opc.OP_SUBTRACT {
        rb -= ra
    } else if r.op == opc.OP_MULTIPLY {
        rb *= ra
    } else if r.op == opc.OP_DIVIDE {
        if ra == 0.0 {
            run.reg_null(v, out)
            return GO_NEXT
        }
        rb /= ra
    } else {
        a := mem.int_value(v.mem[i1])
        b: mem.int_value(v.mem[i2])
        if a == 0 {
            run.reg_null(v, out)
            return GO_NEXT
        }
        if a == -1 -> a = 1
        rb = util.int_to_double(util.c_rem(b, a))
    }
    if math.is_nan(rb) {
        run.reg_null(v, out)
        return GO_NEXT
    }
    run.release_dyn(v, out)
    v.mem[out].r = rb
    mem.set_type_flag(v.mem[out], MEM_REAL)
    GO_NEXT
}

// OP_CollSeq: P1, when set, starts at 0 for the function after it to flag
// a collation change through.
op_coll_seq: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    if r.p1 != 0 -> run.reg_int(v, v.mem_base + r.p1, 0)
    GO_NEXT
}

U64_MASK: 18446744073709551615

// OP_BitAnd, OP_BitOr, OP_ShiftLeft, OP_ShiftRight: P3 = P2 op P1 on
// 64-bit integers; a negative shift shifts the other way and one of 64 or
// more bits leaves 0 (or -1, shifting a negative number right).
op_bits: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i1: v.mem_base + r.p1
    i2: v.mem_base + r.p2
    out: v.mem_base + r.p3
    if v.mem[i1].flags.bit_or(v.mem[i2].flags).bit_and(MEM_NULL) != 0 {
        run.reg_null(v, out)
        return GO_NEXT
    }
    a := mem.int_value(v.mem[i2])
    b := mem.int_value(v.mem[i1])
    op := r.op
    if op == opc.OP_BIT_AND {
        a = a.bit_and(b)
    } else if op == opc.OP_BIT_OR {
        a = a.bit_or(b)
    } else if b != 0 {
        if b < 0 {
            op = 2 * opc.OP_SHIFT_LEFT + 1 - op
            b = if b > -64 -> -b else -> 64
        }
        if b >= 64 {
            a = if a >= 0 || op == opc.OP_SHIFT_LEFT -> 0 else -> -1
        } else {
            ua := util.as_u64(a)
            if op == opc.OP_SHIFT_LEFT {
                ua = (ua << b).bit_and(U64_MASK)
            } else {
                ua >>= b
                if a < 0 -> ua = ua.bit_or((U64_MASK << (64 - b)).bit_and(U64_MASK))
            }
            a = util.wrap_i64(ua)
        }
    }
    run.release_dyn(v, out)
    v.mem[out].i = a
    mem.set_type_flag(v.mem[out], MEM_INT)
    GO_NEXT
}

// OP_AddImm: P1 = integer(P1) + P2, wrapping at 64 bits.
op_add_imm: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    run.release_dyn(v, i)
    mem.integerify(v.mem[i])
    v.mem[i].i = util.wrap_i64(v.mem[i].i + r.p2)
    GO_NEXT
}

// OP_MustBeInt: P1 becomes an integer, or the op jumps to P2 (fails with
// SQLITE_MISMATCH when P2 is 0).
op_must_be_int: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    if v.mem[i].flags.bit_and(MEM_INT) == 0 {
        mem.apply_affinity(v.mem[i], base.AFF_NUMERIC, r.enc)
        if v.mem[i].flags.bit_and(MEM_INT) == 0 {
            if r.p2 == 0 {
                r.rc = base.MISMATCH
                return GO_ERROR
            }
            return GO_JUMP
        }
    }
    mem.set_type_flag(v.mem[i], MEM_INT)
    GO_NEXT
}

// OP_RealAffinity.
op_real_affinity: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    if v.mem[i].flags.bit_and(MEM_INT.bit_or(MEM_INT_REAL)) != 0 -> mem.realify(v.mem[i])
    GO_NEXT
}

// OP_Cast: CAST(P1 AS affinity P2).
op_cast: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    mem.expand_blob(v.mem[i])
    mem.cast(v.mem[i], r.p2, r.enc)
    GO_NEXT
}

// ---------------------------------------------------------------------------
// Comparisons.

// sqlite3aLTb, sqlite3aEQb and sqlite3aGTb: bit k says whether opcode
// OP_Ne + k jumps on less, equal and greater (OP_Ne, OP_Eq, OP_Gt, OP_Le,
// OP_Lt, OP_Ge).
CMP_LT_JUMPS: 25
CMP_EQ_JUMPS: 42
CMP_GT_JUMPS: 37

cmp_jumps: fn(op: Int, res: Int) -> Bool Never! {
    mask: if res < 0 -> CMP_LT_JUMPS else if res == 0 -> CMP_EQ_JUMPS else -> CMP_GT_JUMPS
    (mask >> (op - opc.OP_NE)).bit_and(1) == 1
}

// OP_Eq, OP_Ne, OP_Lt, OP_Le, OP_Gt, OP_Ge: compare P3 with P1 under the
// affinity and NULL handling of P5 and the collation P4; jump to P2 when
// the comparison holds. The affinity's conversions of the operands are
// undone after (their flags restored). iCompare keeps the result for
// OP_ElseEq.
op_compare_jump: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i1: v.mem_base + r.p1
    i3: v.mem_base + r.p3
    flags1 := v.mem[i1].flags
    flags3 := v.mem[i3].flags
    if flags1.bit_and(flags3).bit_and(MEM_INT) != 0 {
        x: v.mem[i3].i
        y: v.mem[i1].i
        res: if x > y -> 1 else if x < y -> -1 else -> 0
        if cmp_jumps(r.op, res) -> return GO_JUMP
        r.i_compare = res
        return GO_NEXT
    }
    res := 0
    if flags1.bit_or(flags3).bit_and(MEM_NULL) != 0 {
        if r.p5.bit_and(conn.CMP_NULLEQ) != 0 {
            if flags1.bit_and(flags3).bit_and(MEM_NULL) != 0 && flags3.bit_and(MEM_CLEARED) == 0 {
                res = 0
            } else {
                res = if flags3.bit_and(MEM_NULL) != 0 -> -1 else -> 1
            }
        } else {
            if r.p5.bit_and(conn.CMP_JUMPIFNULL) != 0 -> return GO_JUMP
            r.i_compare = 1
            return GO_NEXT
        }
    } else {
        affinity: r.p5.bit_and(conn.CMP_AFF_MASK)
        nums: MEM_INT.bit_or(MEM_INT_REAL).bit_or(MEM_REAL)
        if affinity >= base.AFF_NUMERIC {
            if flags1.bit_or(flags3).bit_and(MEM_STR) != 0 {
                if flags1.bit_and(nums.bit_or(MEM_STR)) == MEM_STR {
                    mem.apply_numeric_affinity(v.mem[i1], false)
                    flags3 = v.mem[i3].flags
                }
                if flags3.bit_and(nums.bit_or(MEM_STR)) == MEM_STR -> mem.apply_numeric_affinity(v.mem[i3], false)
            }
        } else if affinity == base.AFF_TEXT && flags1.bit_or(flags3).bit_and(MEM_STR) != 0 {
            if flags1.bit_and(MEM_STR) == 0 && flags1.bit_and(nums) != 0 {
                mem.stringify(v.mem[i1], r.enc, true)
                flags1 = clear_bits(v.mem[i1].flags, MEM_TYPE_MASK).bit_or(flags1.bit_and(MEM_TYPE_MASK))
                if i1 == i3 -> flags3 = flags1.bit_or(MEM_STR)
            }
            if flags3.bit_and(MEM_STR) == 0 && flags3.bit_and(nums) != 0 {
                mem.stringify(v.mem[i3], r.enc, true)
                flags3 = clear_bits(v.mem[i3].flags, MEM_TYPE_MASK).bit_or(flags3.bit_and(MEM_TYPE_MASK))
            }
        }
        res = record.mem_compare(v.mem[i3], v.mem[i1], run.p4_coll(v, r.pc))
    }
    jump: cmp_jumps(r.op, res)
    r.i_compare = res
    v.mem[i3].flags = flags3
    v.mem[i1].flags = flags1
    if jump -> return GO_JUMP
    GO_NEXT
}

// OP_ElseEq: jump when the OP_Lt or OP_Gt before found its operands
// equal.
op_else_eq: fn(r: &Run) -> Int Never! {
    if r.i_compare == 0 -> return GO_JUMP
    GO_NEXT
}

// OP_Compare: iCompare = the comparison of registers P1.. with P2.. over
// P3 columns under the KeyInfo P4, in the order of the OP_Permutation
// before when P5 has OPFLAG_PERMUTE.
op_compare: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    permute := [Int]{}
    use_permute: r.p5.bit_and(conn.OPFLAG_PERMUTE) != 0
    if use_permute {
        if v.ops[r.pc - 1].p4 == .IntArray(ai) {
            loop k in 1..<ai.len() -> permute.push(ai[k])
        }
    }
    p1: v.mem_base + r.p1
    p2: v.mem_base + r.p2
    if v.ops[r.pc].p4 == .KeyInfo(info) {
        loop i in 0..<r.p3 {
            idx: if use_permute -> permute[i] else -> i
            c := record.mem_compare(v.mem[p1 + idx], v.mem[p2 + idx], record.coll_of(info, i))
            r.i_compare = c
            if c != 0 {
                sf: record.sort_flags_of(info, i)
                if sf.bit_and(base.KEYINFO_ORDER_BIGNULL) != 0 && (v.mem[p1 + idx].flags.bit_and(MEM_NULL) != 0 || v.mem[p2 + idx].flags.bit_and(MEM_NULL) != 0) -> c = -c
                if sf.bit_and(base.KEYINFO_ORDER_DESC) != 0 -> c = -c
                r.i_compare = c
                break
            }
        }
    }
    GO_NEXT
}

// OP_Jump: to P1, P2 or P3 as iCompare is less than, equal to or greater
// than zero.
op_jump: fn(r: &Run) -> Int Never! {
    if r.i_compare < 0 {
        r.pc = r.p1 - 1
    } else if r.i_compare == 0 {
        r.pc = r.p2 - 1
    } else {
        r.pc = r.p3 - 1
    }
    GO_NEXT
}

// The three-valued AND and OR, indexed by v1 * 3 + v2 with 0 false, 1
// true and 2 NULL.
AND_LOGIC: [0, 0, 0, 0, 1, 2, 0, 2, 2]
OR_LOGIC: [0, 1, 2, 1, 1, 1, 2, 1, 2]

// The truth value of register i: 0, 1, or 2 for NULL.
truth: fn(v: conn.Vdbe, i: Int) -> Int Never! {
    if v.mem[i].flags.bit_and(MEM_NULL) != 0 && v.mem[i].flags.bit_and(MEM_INT.bit_or(MEM_INT_REAL)) == 0 -> return 2
    if mem.boolean_value(v.mem[i], false) -> 1 else -> 0
}

// OP_And, OP_Or.
op_and_or: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    v1: truth(v, v.mem_base + r.p1)
    v2: truth(v, v.mem_base + r.p2)
    x: if r.op == opc.OP_AND -> AND_LOGIC[v1 * 3 + v2] else -> OR_LOGIC[v1 * 3 + v2]
    out: v.mem_base + r.p3
    run.release_dyn(v, out)
    if x == 2 {
        mem.set_type_flag(v.mem[out], MEM_NULL)
    } else {
        v.mem[out].i = x
        mem.set_type_flag(v.mem[out], MEM_INT)
    }
    GO_NEXT
}

// OP_IsTrue: P2 = the truth of P1 (P3 for NULL) xor P4.
op_is_true: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    b: mem.boolean_value(v.mem[v.mem_base + r.p1], r.p3 != 0)
    x: if b -> 1 else -> 0
    mask: run.p4_int(v, r.pc)
    run.reg_int(v, v.mem_base + r.p2, x.bit_xor(mask))
    GO_NEXT
}

// OP_Not.
op_not: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i1: v.mem_base + r.p1
    out: v.mem_base + r.p2
    if v.mem[i1].flags.bit_and(MEM_NULL) == 0 {
        x: if mem.boolean_value(v.mem[i1], false) -> 0 else -> 1
        run.reg_int(v, out, x)
    } else {
        run.reg_null(v, out)
    }
    GO_NEXT
}

// OP_BitNot.
op_bit_not: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i1: v.mem_base + r.p1
    out: v.mem_base + r.p2
    null: v.mem[i1].flags.bit_and(MEM_NULL) != 0
    x: if null -> 0 else -> -mem.int_value(v.mem[i1]) - 1
    run.reg_null(v, out)
    if !null {
        v.mem[out].flags = MEM_INT
        v.mem[out].i = x
    }
    GO_NEXT
}

// OP_Once: fall through the first time, jump to P2 after. The statement's
// own program counts runs in its P1 against OP_Init's; a trigger program
// keeps a flag per op.
op_once: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    if v.frames.len() > 0 {
        k: v.once_base + r.pc
        if v.once[k] -> return GO_JUMP
        v.once[k] = true
        return GO_NEXT
    }
    if v.ops[0].p1 == r.p1 -> return GO_JUMP
    run.set_p1(v, r.pc, v.ops[0].p1)
    GO_NEXT
}

// OP_If: jump when P1 is true (P3 for NULL).
op_if: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    if mem.boolean_value(v.mem[v.mem_base + r.p1], r.p3 != 0) -> return GO_JUMP
    GO_NEXT
}

// OP_IfNot: jump when P1 is false (NULL when P3).
op_if_not: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    if !mem.boolean_value(v.mem[v.mem_base + r.p1], r.p3 == 0) -> return GO_JUMP
    GO_NEXT
}

// OP_IsNull.
op_is_null: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    if v.mem[v.mem_base + r.p1].flags.bit_and(MEM_NULL) != 0 -> return GO_JUMP
    GO_NEXT
}

// The datatype bits OP_IsType tests per serial type below 12.
IS_TYPE_MASKS: [16, 1, 1, 1, 1, 1, 1, 2, 1, 1, 16, 16]

// OP_IsType: jump when the datatype of column P3 of cursor P1 (of register
// P3 when P1 < 0) is one of the P5 bits (1 << (SQLITE_type - 1)); a column
// past the parsed header has the type P4.
op_is_type: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    mask := 0
    if r.p1 >= 0 {
        ci: v.csr_base + r.p1
        if r.p3 < v.csr[ci].n_hdr_parsed {
            t: v.csr[ci].types[r.p3]
            if t >= 12 {
                mask = if t.bit_and(1) == 1 -> 4 else -> 8
            } else {
                mask = IS_TYPE_MASKS[t]
            }
        } else {
            mask = 1 << (run.p4_int(v, r.pc) - 1)
        }
    } else {
        mask = 1 << (base.value_type(v.mem[v.mem_base + r.p3]) - 1)
    }
    if mask.bit_and(r.p5) != 0 -> return GO_JUMP
    GO_NEXT
}

// OP_NotNull.
op_not_null: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    if v.mem[v.mem_base + r.p1].flags.bit_and(MEM_NULL) == 0 -> return GO_JUMP
    GO_NEXT
}

// OP_ZeroOrNull: P2 = NULL when P1 or P3 is NULL, 0 otherwise.
op_zero_or_null: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    out: v.mem_base + r.p2
    if v.mem[v.mem_base + r.p1].flags.bit_and(MEM_NULL) != 0 || v.mem[v.mem_base + r.p3].flags.bit_and(MEM_NULL) != 0 {
        run.reg_null(v, out)
    } else {
        run.reg_int(v, out, 0)
    }
    GO_NEXT
}

#Test("arithmetic stays in integers until it overflows or divides by zero") {
    v := conn.vdbe_new()
    v.mem.push(base.mem_int(3))
    v.mem.push(base.mem_int(base.I64_MAX))
    v.mem.push(base.mem_null())
    v.ops.push(test_op(opc.OP_ADD, conn.P4.NotUsed))
    v.ops.push(test_op(opc.OP_DIVIDE, conn.P4.NotUsed))
    v.ops.push(test_op(opc.OP_REMAINDER, conn.P4.NotUsed))
    add := test_run(v, 0, 0, 0, 2)
    assert_eq(op_arith(v, add), GO_NEXT)
    assert(v.mem[2].flags.bit_and(MEM_INT) != 0 && v.mem[2].i == 6)
    big := test_run(v, 0, 0, 1, 2)
    _: op_arith(v, big)
    assert(v.mem[2].flags.bit_and(MEM_REAL) != 0)
    v.mem[0] = base.mem_int(0)
    div := test_run(v, 1, 0, 1, 2)
    _: op_arith(v, div)
    assert(v.mem[2].flags.bit_and(MEM_NULL) != 0)
    v.mem[0] = base.mem_int(-5)
    v.mem[1] = base.mem_int(17)
    rem := test_run(v, 2, 0, 1, 2)
    _: op_arith(v, rem)
    assert(v.mem[2].flags.bit_and(MEM_INT) != 0 && v.mem[2].i == 2)
}

#Test("comparisons jump as vdbe.c's tables say and NULLs compare by P5") {
    v := conn.vdbe_new()
    v.mem.push(base.mem_int(1))
    v.mem.push(base.mem_int(2))
    v.mem.push(base.mem_null())
    v.ops.push(test_op(opc.OP_LT, conn.P4.NotUsed))
    v.ops.push(test_op(opc.OP_EQ, conn.P4.NotUsed))
    lt := test_run(v, 0, 1, 0, 0)
    assert_eq(op_compare_jump(v, lt), GO_JUMP)
    ge := test_run(v, 0, 0, 0, 1)
    assert_eq(op_compare_jump(v, ge), GO_NEXT)
    assert_eq(ge.i_compare, 1)
    eq := test_run(v, 1, 2, 0, 2)
    assert_eq(op_compare_jump(v, eq), GO_NEXT)
    eq.p5 = conn.CMP_NULLEQ
    assert_eq(op_compare_jump(v, eq), GO_JUMP)
    eq.p5 = conn.CMP_JUMPIFNULL
    assert_eq(op_compare_jump(v, eq), GO_JUMP)
}

#Test("AND and OR are three-valued and Gosub returns past itself") {
    v := conn.vdbe_new()
    v.mem.push(base.mem_int(0))
    v.mem.push(base.mem_null())
    v.mem.push(base.mem_null())
    v.ops.push(test_op(opc.OP_AND, conn.P4.NotUsed))
    v.ops.push(test_op(opc.OP_OR, conn.P4.NotUsed))
    v.ops.push(test_op(opc.OP_GOSUB, conn.P4.NotUsed))
    v.ops.push(test_op(opc.OP_RETURN, conn.P4.NotUsed))
    both := test_run(v, 0, 0, 1, 2)
    _: op_and_or(v, both)
    assert(v.mem[2].flags.bit_and(MEM_INT) != 0 && v.mem[2].i == 0)
    either := test_run(v, 1, 0, 1, 2)
    _: op_and_or(v, either)
    assert(v.mem[2].flags.bit_and(MEM_NULL) != 0)
    call := test_run(v, 2, 2, 0, 0)
    assert_eq(op_gosub(v, call), GO_JUMP_CHECK)
    back := test_run(v, 3, 2, 0, 0)
    assert_eq(op_return(v, back), GO_NEXT)
    assert_eq(back.pc, 2)
}

#Test("concatenation renders numbers as text") {
    db := conn.conn_new()
    v := conn.vdbe_new()
    v.mem.push(base.mem_int(42))
    v.mem.push(base.mem_text("x".bytes(), base.UTF8))
    v.mem.push(base.mem_null())
    v.ops.push(test_op(opc.OP_CONCAT, conn.P4.NotUsed))
    cat := test_run(v, 0, 0, 1, 2)
    assert_eq(op_concat(db, v, cat), GO_NEXT)
    assert(v.mem[2].flags.bit_and(MEM_STR) != 0 && v.mem[2].z == "x42".bytes())
    assert(v.mem[0].flags.bit_and(MEM_STR) == 0)
}
