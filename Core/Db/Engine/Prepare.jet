// PREPARE: the top of the engine, a port of SQLite 3.45.0's prepare.c
// (schema loading and statement compilation), legacy.c (sqlite3_exec),
// build.c's sqlite3FinishCoding and sqlite3NestedParse, and the entry points
// of main.c that core.db calls: openDatabase, sqlite3Close,
// sqlite3_errmsg, sqlite3_error_offset, sqlite3_busy_timeout,
// sqlite3_extended_result_codes, sqlite3_changes, sqlite3_get_autocommit
// and sqlite3_prepare_v3. Statements are Conn.vdbes slots; -1 is NULL.
//
// Three types join the parts below to the parser and the VDBE:
// - EngineBuilder holds the Parse of the statement being compiled and
//   implements the grammar's SQLBuilder by calling build.c, select.c,
//   insert.c, update.c, delete.c and pragma.c (Build, Select, Insert,
//   Update, Delete and Func). The statements this build does not have fail
//   with "... is not supported in this build": triggers, views, virtual
//   tables, ALTER TABLE, ATTACH and DETACH, VACUUM, REINDEX, ANALYZE,
//   SAVEPOINT, foreign keys, RETURNING and DELETE with ORDER BY or LIMIT.
// - EngineGen is the Parse's Gen: the calls the code generators make up
//   the part order (sqlite3ReadSchema, sqlite3NestedParse, sqlite3Select).
// - EngineHost is the VDBE's Host: SQL functions, OP_SqlExec,
//   OP_ParseSchema and sqlite3Reprepare. No hook, trace, authorizer or
//   virtual table module can be registered in this build, so the callbacks
//   C tests for NULL first do nothing here.
//
// The AST arena is the connection's (Conn.ast): the schema's expressions
// (CHECK constraints, column defaults) live in it. An API call moves it
// out of the Conn for the statement and puts it back after; a statement
// compiled while another is (a CREATE statement of the schema, a nested
// parse) shares the arena and saves the outer statement's context around
// its own. A Parse holds the connection while it builds (cg.parse_new),
// so the calls below move the Conn into the Parse and back.
use {
    base: __core_db_base
    ast: __core_db_ast
    util: __core_db_util
    conn: __core_db_conn
    btree: __core_db_btree
    wal: __core_db_wal
    os: __core_db_os
    pgr: __core_db_pager
    opc: __core_db_opcodes
    aux: __core_db_vdbeaux
    api: __core_db_vdbeapi
    cg: __core_db_codegen
    cat: __core_db_catalog
    ex: __core_db_expr
    parse: __core_db_parse
    sel: __core_db_select
    del: __core_db_delete
    ins: __core_db_insert
    upd: __core_db_update
    bld: __core_db_build
    func: __core_db_func
}

// SQLITE_MAX_PREPARE_RETRY (sqliteInt.h).
MAX_PREPARE_RETRY: 25

// INITFLAG_AlterMask (sqliteInt.h): the ALTER TABLE kind of an
// OP_ParseSchema reparse, 1 rename, 2 drop column, 3 add column.
INITFLAG_ALTER_MASK: 3

// The text of the schema table's CREATE statement (sqlite3InitOne's
// azArg[4]).
SCHEMA_TABLE_SQL: "CREATE TABLE x(type text,name text,tbl_name text,rootpage int,sql text)"

// struct InitData (sqliteInt.h): the state sqlite3InitCallback shares with
// sqlite3InitOne and OP_ParseSchema. err is *pzErrMsg.
InitData: struct {
    i_db: Int
    rc: Int
    err: [U8]?
    init_flags: Int
    n_init_row: Int
    mx_page: Int
}

init_data_new: fn(i_db: Int, init_flags: Int) -> InitData Never! {
    InitData{i_db: i_db, rc: base.OK, err: None, init_flags: init_flags, n_init_row: 0, mx_page: 0}
}

// The Vdbe sqlite3Reprepare recompiles, as sqlite3Prepare's pReprepare
// reads it: whether it is an EXPLAIN, and its bound values.
PrepareFrom: struct {
    explain: Int
    vars: [base.Mem]
}

// sqlite3Prepare's results: the result code, the statement slot (-1 for
// none) and the byte offset of the unparsed rest of the SQL (*pzTail).
Prepared: struct {
    rc: Int
    stmt: Int
    tail: Int
}

// ---------------------------------------------------------------------------
// Small helpers.

// sqlite3SafetyCheckOk (util.c).
safety_check_ok: fn(db: conn.Conn) -> Bool Never! { db.open_state == conn.STATE_OPEN }

// sqlite3SafetyCheckSickOrOk (util.c).
safety_check_sick_or_ok: fn(db: conn.Conn) -> Bool Never! {
    db.open_state == conn.STATE_OPEN || db.open_state == conn.STATE_SICK || db.open_state == conn.STATE_BUSY
}

// sqlite3ErrorClear (util.c).
error_clear: fn(db: &conn.Conn) Never! {
    db.err_code = base.OK
    db.err_byte_offset = -1
    if db.has_err_msg -> db.err_msg = None
}

// sqlite3UpperToLower for one byte.
init_lower: fn(c: Int) -> Int Never! { if c >= 65 && c <= 90 -> c + 32 else -> c }

// The text up to its first NUL, as C sees a NUL-terminated string.
c_text: fn(z: [U8]) -> [U8] Never! {
    n := 0
    loop n < z.len() && z[n] != (U8{0}) -> n += 1
    if n == z.len() -> return z.copy()
    z[0..<n].copy()
}

// sqlite3MPrintf's %w: the text with each double quote doubled.
quote_w: fn(z: [U8]) -> [U8] Never! {
    out := [U8]{}
    loop c in z {
        out.push(c)
        if c == (U8{34}) -> out.push(c)
    }
    out
}

// The bytes of a, then b.
concat: fn(a: [U8], b: [U8]) -> [U8] Never! {
    out := a.copy()
    loop c in b -> out.push(c)
    out
}

// Whether database i_db's schema has property DB_* `prop` (DbHasProperty).
db_has_property: fn(db: conn.Conn, i_db: Int, prop: Int) -> Bool Never! {
    s: db.dbs[i_db].schema
    s >= 0 && db.schemas[s].schema_flags.bit_and(prop) == prop
}

// DbSetProperty.
db_set_property: fn(db: &conn.Conn, i_db: Int, prop: Int) Never! {
    s: db.dbs[i_db].schema
    if s >= 0 -> db.schemas[s].schema_flags = db.schemas[s].schema_flags.bit_or(prop)
}

// Move the Parse out of `p`, leaving an empty one, for a builder to own.
take_parse: fn(p: &cg.Parse) -> cg.Parse Never! {
    out := p
    p = cg.parse_new(conn.conn_new(), EngineGen{unused: 0})
    out
}

// The end of sqlite3RunParser (tokenize.c): the table a failed CREATE TABLE
// left in pNewTable is freed, and the statement's parameter list. Triggers
// are not in this build, so pNewTrigger is never set.
run_parser_cleanup: fn(p: &cg.Parse, a: &ast.AST) Never! {
    if p.f.new_table >= 0 && !cg.in_special_parse(a) -> conn.delete_table(p.db, p.f.new_table)
    p.f.new_table = -1
    a.ctx.vlist = [ast.SQLVar]{}
}

// ---------------------------------------------------------------------------
// sqlite3FinishCoding (build.c): end the program of a completed statement
// and make it ready to run.
finish_coding: fn(p: &cg.Parse, a: &ast.AST) Never! -[DB]> {
    if a.ctx.nested != 0 -> return
    if a.ctx.nerr != 0 {
        if p.db.malloc_failed -> a.ctx.rc = base.NOMEM
        return
    }
    if !p.f.has_vdbe {
        if p.db.init.busy {
            a.ctx.rc = base.DONE
            return
        }
        cg.get_vdbe(p)
    }
    // RETURNING is not in this build (add_returning fails), so bReturning
    // is never set and its cursor loop is not coded.
    _: cg.op0(p, opc.OP_HALT)
    // The cookie mask has a bit for each database the statement uses:
    // start a transaction on each and verify its schema cookie.
    cg.v_jump_here(p, 0)
    loop i_db in 0..<p.db.dbs.len() {
        bit: 1 << i_db
        if p.f.cookie_mask.bit_and(bit) == 0 -> next
        cg.v_uses_btree(p, i_db)
        s: p.db.dbs[i_db].schema
        write: if p.f.write_mask.bit_and(bit) != 0 -> 1 else -> 0
        _: cg.op4_int(p, opc.OP_TRANSACTION, i_db, write, p.db.schemas[s].schema_cookie, p.db.schemas[s].generation)
        if !p.db.init.busy -> cg.v_change_p5(p, 1)
    }
    // apVtabLock is empty: no virtual table exists in this build, so no
    // OP_VBegin is coded. Table locks are shared-cache only (not built).
    p.f.vtab_lock = [Int]{}
    if p.f.ainc >= 0 -> ins.autoincrement_begin(p, a)
    l: p.f.const_expr
    if l >= 0 {
        p.f.ok_const_factor = false
        loop i in 0..<ast.list_len(a, l) -> ex.expr_code(p, a, a.lists[l].items[i].expr, a.lists[l].items[i].const_reg)
    }
    _: cg.goto(p, 1)
    if a.ctx.nerr == 0 {
        aux.make_ready(p.db, p.f.v, a.ctx.nvar, p.f.n_mem, p.f.n_tab, a.ctx.explain, p.f.is_multi_write && p.f.may_abort)
        // p->pVList = pParse->pVList: the names of the parameters.
        names := [[U8]?]{}
        loop _ in 0..<a.ctx.nvar -> names.push(None)
        loop x in a.ctx.vlist {
            if x.num >= 1 && x.num <= names.len() -> names[x.num - 1] = Val(x.name)
        }
        p.f.v.var_names = names
        a.ctx.rc = base.DONE
    } else {
        a.ctx.rc = base.ERROR
    }
}

// ---------------------------------------------------------------------------
// The grammar's builder.

EngineBuilder: struct {
    p: cg.Parse

    impl parse.SQLBuilder {
        finish_coding: fn(&self, a: &ast.AST) Never! -[DB]> { finish_coding(self.p, a) }
        begin_transaction: fn(&self, a: &ast.AST, kind: Int) Never! -[DB]> { bld.begin_transaction(self.p, a, kind) }
        end_transaction: fn(&self, a: &ast.AST, op: Int) Never! -[DB]> { bld.end_transaction(self.p, a, op) }
        savepoint: fn(&self, a: &ast.AST, op: Int, name: ast.SQLTok) Never! -[DB]> { unsupported(a, "SAVEPOINT") }
        start_table: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok, is_temp: Int, is_view: Int, is_virtual: Int, no_err: Int) Never! -[DB]> {
            bld.start_table(self.p, a, name1, name2, is_temp != 0, is_view != 0, is_virtual != 0, no_err != 0)
        }
        end_table: fn(&self, a: &ast.AST, cons: ast.SQLTok, end: ast.SQLTok, tab_opts: Int, select: Int) Never! -[DB]> { bld.end_table(self.p, a, cons, end, tab_opts, select) }
        add_column: fn(&self, a: &ast.AST, name: ast.SQLTok, typ: ast.SQLTok) Never! -[DB]> { bld.add_column(self.p, a, name, typ) }
        add_default_value: fn(&self, a: &ast.AST, e: Int, start: Int, end: Int) Never! -[DB]> { bld.add_default_value(self.p, a, e, start, end) }
        add_not_null: fn(&self, a: &ast.AST, on_error: Int) Never! -[DB]> { bld.add_not_null(self.p, a, on_error) }
        add_primary_key: fn(&self, a: &ast.AST, list: Int, on_error: Int, autoinc: Int, sort_order: Int) Never! -[DB]> { bld.add_primary_key(self.p, a, list, on_error, autoinc != 0, sort_order) }
        create_index: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok, tbl: Int, list: Int, on_error: Int, start: ast.SQLTok, where_expr: Int, sort_order: Int, if_not_exist: Int, idx_type: Int) Never! -[DB]> {
            bld.create_index(self.p, a, name1, name2, tbl, list, on_error, start, where_expr, sort_order, if_not_exist != 0, idx_type)
        }
        add_check_constraint: fn(&self, a: &ast.AST, e: Int, start: Int, end: Int) Never! -[DB]> { bld.add_check_constraint(self.p, a, e, start, end) }
        create_foreign_key: fn(&self, a: &ast.AST, from_cols: Int, to: ast.SQLTok, to_cols: Int, flags: Int) Never! -[DB]> { unsupported(a, "FOREIGN KEY") }
        // sqlite3DeferForeignKey returns when the table has no foreign key,
        // which is always here (create_foreign_key fails).
        defer_foreign_key: fn(&self, a: &ast.AST, deferred: Int) Never! -[DB]> {}
        add_collate_type: fn(&self, a: &ast.AST, name: ast.SQLTok) Never! -[DB]> { bld.add_collate_type(self.p, a, name) }
        add_generated: fn(&self, a: &ast.AST, e: Int, typ: ast.SQLTok) Never! -[DB]> { bld.add_generated(self.p, a, e, typ) }
        drop_table: fn(&self, a: &ast.AST, name: Int, is_view: Int, no_err: Int) Never! -[DB]> { bld.drop_table(self.p, a, name, is_view != 0, no_err != 0) }
        create_view: fn(&self, a: &ast.AST, begin: ast.SQLTok, name1: ast.SQLTok, name2: ast.SQLTok, cols: Int, select: Int, is_temp: Int, no_err: Int) Never! -[DB]> { unsupported(a, "CREATE VIEW") }
        // cmd ::= select: sqlite3Select with an SRT_Output destination.
        select_output: fn(&self, a: &ast.AST, select: Int) Never! -[DB]> {
            dest := ex.select_dest_init(cg.SRT_OUTPUT, 0)
            _: sel.select(self.p, a, select, dest)
        }
        // The grammar passes ORDER BY and LIMIT on DELETE only when built with
        // SQLITE_ENABLE_UPDATE_DELETE_LIMIT, which this build is not.
        delete_from: fn(&self, a: &ast.AST, src: Int, where_expr: Int, order_by: Int, limit: Int) Never! -[DB]> {
            if order_by >= 0 || limit >= 0 {
                unsupported(a, "ORDER BY or LIMIT on DELETE")
                ast.src_list_delete(a, src)
                ast.expr_delete(a, where_expr)
                return
            }
            del.delete_from(self.p, a, src, where_expr)
        }
        add_returning: fn(&self, a: &ast.AST, list: Int) Never! -[DB]> { unsupported(a, "RETURNING") }
        update: fn(&self, a: &ast.AST, src: Int, changes: Int, where_expr: Int, on_error: Int, order_by: Int, limit: Int, upsert: Int) Never! -[DB]> {
            upd.update(self.p, a, src, changes, where_expr, on_error, order_by, limit, upsert)
        }
        insert: fn(&self, a: &ast.AST, src: Int, select: Int, cols: Int, on_error: Int, upsert: Int) Never! -[DB]> { ins.insert(self.p, a, src, select, cols, on_error, upsert) }
        drop_index: fn(&self, a: &ast.AST, name: Int, if_exists: Int) Never! -[DB]> { unsupported(a, "DROP INDEX") }
        vacuum: fn(&self, a: &ast.AST, name: ast.SQLTok, into: Int) Never! -[DB]> { unsupported(a, "VACUUM") }
        pragma: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok, value: ast.SQLTok, minus: Int) Never! -[DB]> { func.pragma(self.p, a, name1, name2, value, minus) }
        begin_trigger: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok, tr_tm: Int, op: Int, columns: Int, table: Int, when: Int, is_temp: Int, no_err: Int) Never! -[DB]> { unsupported(a, "CREATE TRIGGER") }
        finish_trigger: fn(&self, a: &ast.AST, steps: Int, all: ast.SQLTok) Never! -[DB]> { unsupported(a, "CREATE TRIGGER") }
        drop_trigger: fn(&self, a: &ast.AST, name: Int, no_err: Int) Never! -[DB]> { unsupported(a, "DROP TRIGGER") }
        attach: fn(&self, a: &ast.AST, filename: Int, dbname: Int, key: Int) Never! -[DB]> { unsupported(a, "ATTACH") }
        detach: fn(&self, a: &ast.AST, dbname: Int) Never! -[DB]> { unsupported(a, "DETACH") }
        reindex: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok) Never! -[DB]> { unsupported(a, "REINDEX") }
        analyze: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok) Never! -[DB]> { unsupported(a, "ANALYZE") }
        alter_rename_table: fn(&self, a: &ast.AST, src: Int, name: ast.SQLTok) Never! -[DB]> { alter_table(self.p, a, src) }
        alter_begin_add_column: fn(&self, a: &ast.AST, src: Int) Never! -[DB]> { alter_table(self.p, a, src) }
        alter_finish_add_column: fn(&self, a: &ast.AST, col_def: ast.SQLTok) Never! -[DB]> { unsupported(a, "ALTER TABLE") }
        alter_drop_column: fn(&self, a: &ast.AST, src: Int, name: ast.SQLTok) Never! -[DB]> { alter_table(self.p, a, src) }
        alter_rename_column: fn(&self, a: &ast.AST, src: Int, old_name: ast.SQLTok, new_name: ast.SQLTok) Never! -[DB]> { alter_table(self.p, a, src) }
        vtab_begin_parse: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok, module_name: ast.SQLTok, if_not_exists: Int) Never! -[DB]> { unsupported(a, "CREATE VIRTUAL TABLE") }
        vtab_finish_parse: fn(&self, a: &ast.AST, end: ast.SQLTok) Never! -[DB]> { unsupported(a, "CREATE VIRTUAL TABLE") }
        vtab_arg_init: fn(&self, a: &ast.AST) Never! -[DB]> { unsupported(a, "CREATE VIRTUAL TABLE") }
        vtab_arg_extend: fn(&self, a: &ast.AST, t: ast.SQLTok) Never! -[DB]> { unsupported(a, "CREATE VIRTUAL TABLE") }
    }
}

// The error of a statement this build does not have.
unsupported: fn(a: &ast.AST, what: String) Never! {
    if a.ctx.nerr == 0 -> ast.error(a, "{what} is not supported in this build")
}

// The start of sqlite3AlterRenameTable, sqlite3AlterBeginAddColumn,
// sqlite3AlterDropColumn and sqlite3AlterRenameColumn (alter.c): the table
// must exist. The schema rewrite that follows is not in this build.
alter_table: fn(p: &cg.Parse, a: &ast.AST, src: Int) Never! -[DB]> {
    if !p.db.malloc_failed {
        si: ast.src_item(a, src, 0)
        t: cat.locate_table_item(p, a, 0, si)
        if t >= 0 -> unsupported(a, "ALTER TABLE")
    }
    ast.src_list_delete(a, src)
}

// ---------------------------------------------------------------------------
// The Parse's Gen.

EngineGen: struct {
    unused: Int

    impl cg.Gen {
        // sqlite3ReadSchema (prepare.c).
        read_schema: fn(self, p: &cg.Parse, a: &ast.AST) -[DB]> Int Never! {
            if p.db.init.busy -> return base.OK
            db := cg.take_conn(p.db)
            h := EngineHost{unused: 0}
            err := [U8]?{None}
            rc: init<EngineHost>(h, db, a, err)
            if rc != base.OK {
                a.ctx.rc = rc
                a.ctx.nerr += 1
                if err == .Val(m) -> a.ctx.errmsg = Val(ast.text(m))
            } else {
                // db->noSharedCache: no Btree is shared in this build.
                db.m_db_flags = db.m_db_flags.bit_or(conn.DBFLAG_SCHEMA_KNOWN_OK)
            }
            p.db = db
            rc
        }
        // No authorizer can be registered in this build (db->xAuth is NULL).
        authorize: fn(self, p: &cg.Parse, code: Int, arg1: [U8]?, arg2: [U8]?, arg3: [U8]?) -[DB]> Int Never! { base.OK }
        // sqlite3NestedParse (build.c), after Build's nested_parse formatted
        // the SQL: run the parser over it on the same Parse, with the
        // PARSE_TAIL fields of the outer statement saved and cleared.
        nested_parse: fn(self, p: &cg.Parse, a: &ast.AST, sql: [U8]) Never! -[DB]> {
            a.ctx.nested += 1
            s_sql: a.ctx.sql
            s_tail: a.ctx.tail
            s_last: a.ctx.last_token
            s_nvar: a.ctx.nvar
            s_vlist: a.ctx.vlist
            s_explain: a.ctx.explain
            s_mode: a.ctx.parse_mode
            s_reprepare: a.ctx.reprepare
            s_with: a.ctx.cur_with
            s_vars: p.reprepare_vars
            s_pk_sort: p.f.i_pk_sort_order
            s_vtab_lock: p.f.vtab_lock
            s_height: p.f.n_height
            s_explain_addr: p.f.addr_explain
            s_table: p.f.new_table
            s_index: p.f.new_index
            s_trigger: p.f.new_trigger
            s_auth: p.f.auth_context
            s_arg: p.f.s_arg
            s_rename: p.f.rename
            a.ctx.sql = c_text(sql)
            a.ctx.tail = 0
            a.ctx.last_token = ast.SQLTok{z: -1, n: 0}
            a.ctx.nvar = 0
            a.ctx.vlist = [ast.SQLVar]{}
            a.ctx.explain = 0
            a.ctx.parse_mode = ast.PARSE_MODE_NORMAL
            a.ctx.reprepare = false
            a.ctx.cur_with = -1
            p.reprepare_vars = [base.Mem]{}
            p.f.i_pk_sort_order = 0
            p.f.vtab_lock = [Int]{}
            p.f.n_height = 0
            p.f.addr_explain = 0
            p.f.new_table = -1
            p.f.new_index = -1
            p.f.new_trigger = -1
            p.f.auth_context = None
            p.f.s_arg = ast.SQLTok{z: -1, n: 0}
            p.f.rename = -1
            saved_flags: p.db.m_db_flags
            p.db.m_db_flags = p.db.m_db_flags.bit_or(conn.DBFLAG_PREFER_BUILTIN)
            b := EngineBuilder{p: take_parse(p)}
            _: parse.run_parser<EngineBuilder>(b, a)
            p = b.p
            run_parser_cleanup(p, a)
            p.db.m_db_flags = saved_flags
            a.ctx.sql = s_sql
            a.ctx.tail = s_tail
            a.ctx.last_token = s_last
            a.ctx.nvar = s_nvar
            a.ctx.vlist = s_vlist
            a.ctx.explain = s_explain
            a.ctx.parse_mode = s_mode
            a.ctx.reprepare = s_reprepare
            a.ctx.cur_with = s_with
            p.reprepare_vars = s_vars
            p.f.i_pk_sort_order = s_pk_sort
            p.f.vtab_lock = s_vtab_lock
            p.f.n_height = s_height
            p.f.addr_explain = s_explain_addr
            p.f.new_table = s_table
            p.f.new_index = s_index
            p.f.new_trigger = s_trigger
            p.f.auth_context = s_auth
            p.f.s_arg = s_arg
            p.f.rename = s_rename
            a.ctx.nested -= 1
        }
        select: fn(self, p: &cg.Parse, a: &ast.AST, s: Int, dest: &cg.SelectDest) -[DB]> Int Never! { sel.select(p, a, s, dest) }
        select_prep: fn(self, p: &cg.Parse, a: &ast.AST, s: Int, outer_nc: Int) Never! -[DB]> { sel.select_prep(p, a, s, outer_nc) }
        select_expand: fn(self, p: &cg.Parse, a: &ast.AST, s: Int) Never! -[DB]> { sel.select_expand(p, a, s) }
        result_set_of_select: fn(self, p: &cg.Parse, a: &ast.AST, s: Int, aff: Int) -[DB]> Int Never! { sel.result_set_of_select(p, a, s, aff) }
        // sqlite3ViewGetColumnNames: an ordinary table has its columns. Views
        // and virtual tables are not in this build.
        view_get_column_names: fn(self, p: &cg.Parse, a: &ast.AST, t: Int) -[DB]> Int Never! {
            if p.db.tables[t].tab_type == conn.TABTYP_NORM -> return 0
            ast.error(a, "Views are not supported in this build")
            1
        }
        // No module is registered in this build: no eponymous virtual table.
        eponymous_table: fn(self, p: &cg.Parse, a: &ast.AST, name: [U8]) -[DB]> Int Never! { -1 }
        // A virtual table column never exists here: def is not overloaded.
        vtab_overload_function: fn(self, p: &cg.Parse, a: &ast.AST, def: conn.FuncDef, n_arg: Int, e: Int) -[DB]> conn.FuncDef Never! { def.copy() }
        vtab_best_index: fn(self, p: &cg.Parse, a: &ast.AST, t: Int, info: &conn.IndexInfo) -[DB]> (rc: Int, err: [U8]?) Never! { (rc: base.ERROR, err: Val("Virtual tables are not supported in this build".bytes())) }
        vtab_find_function: fn(self, p: &cg.Parse, a: &ast.AST, t: Int, n_arg: Int, name: [U8]) -[DB]> Int Never! { 0 }
    }
}

// ---------------------------------------------------------------------------
// The VDBE's Host.

EngineHost: struct {
    unused: Int

    impl aux.Host {
        // No virtual table module can be registered in this build, so no
        // statement reaches a VTable.
        vtab_has: fn(&self, _db: conn.Conn, _vt: Int, _method: Int) -[]> Bool Never! { false }
        vtab_version: fn(&self, _db: conn.Conn, _vt: Int) -[]> Int Never! { 0 }
        vtab_call: fn(&self, _db: &conn.Conn, _vt: Int, _method: Int, _arg: Int) -[DB]> Int Never! { base.ERROR }
        vtab_close: fn(&self, _db: &conn.Conn, _vt: Int, _cursor: Int) Never! -[DB]> {}
        vtab_take_errmsg: fn(&self, _db: conn.Conn, _vt: Int) -[]> [U8]? { None }
        vtab_open: fn(&self, _db: &conn.Conn, _vt: Int, _cursor: &Int) -[DB]> Int Never! { base.ERROR }
        vtab_filter: fn(&self, _db: &conn.Conn, _v: &conn.Vdbe, _cursor: Int, _idx_num: Int, _idx_str: [U8]?, _arg: Int, _argc: Int) -[DB]> Int Never! { base.ERROR }
        vtab_eof: fn(&self, _db: &conn.Conn, _cursor: Int) -[DB]> Bool Never! { true }
        vtab_next: fn(&self, _db: &conn.Conn, _cursor: Int) -[DB]> Int Never! { base.ERROR }
        vtab_column: fn(&self, _db: &conn.Conn, _v: &conn.Vdbe, _cursor: Int, _col: Int) -[DB]> Int Never! { base.ERROR }
        vtab_rowid: fn(&self, _db: &conn.Conn, _cursor: Int, _rowid: &Int) -[DB]> Int Never! { base.ERROR }
        vtab_update: fn(&self, _db: &conn.Conn, _v: &conn.Vdbe, _vt: Int, _arg: Int, _argc: Int, _rowid: &Int) -[DB]> Int Never! { base.ERROR }
        vtab_rename: fn(&self, _db: &conn.Conn, _vt: Int, _name: [U8]) -[DB]> Int Never! { base.ERROR }
        vtab_integrity: fn(&self, _db: &conn.Conn, _vt: Int, _schema: [U8], _table: [U8], _flags: Int, _msg: &[U8]?) -[DB]> Int Never! { base.OK }
        vtab_call_create: fn(&self, _db: &conn.Conn, _i_db: Int, _name: [U8], _msg: &[U8]?) -[DB]> Int Never! { base.ERROR }
        vtab_call_destroy: fn(&self, _db: &conn.Conn, _i_db: Int, _name: [U8]) -[DB]> Int Never! { base.ERROR }
        // The builtin SQL functions (func.c, json.c, window.c).
        func_call: fn(&self, db: &conn.Conn, v: &conn.Vdbe, method: Int) Never! -[DB]> { func.builtin_call(db, v, method) }
        // No commit, rollback or update hook can be set in this build.
        commit_hook: fn(&self, _db: &conn.Conn) -[DB]> Int Never! { 0 }
        rollback_hook: fn(&self, _db: &conn.Conn) Never! -[DB]> {}
        has_update_hook: fn(&self, _db: conn.Conn) -[]> Bool Never! { false }
        update_hook: fn(&self, _db: &conn.Conn, _op: Int, _db_name: [U8], _table: [U8], _rowid: Int) Never! -[DB]> {}
        // No progress handler, trace or profile callback can be set either.
        progress: fn(&self, _db: &conn.Conn) -[DB]> Bool Never! { false }
        trace: fn(&self, _db: &conn.Conn, _v: conn.Vdbe, _event: Int, _text: [U8]) Never! -[DB]> {}
        profile: fn(&self, _db: &conn.Conn, _v: conn.Vdbe, _elapsed_ns: Int) Never! -[DB]> {}
        // A user WAL hook (sqlite3_wal_hook) cannot be set in this build; the
        // default autocheckpoint hook runs in VdbeApi's wal_callbacks.
        wal_hook: fn(&self, _db: &conn.Conn, _db_name: [U8], _n_frame: Int) -[DB]> Int Never! { base.OK }
        // OP_SqlExec: sqlite3_exec of sql without a callback; `quiet` turns
        // the authorizer and tracing off for it.
        sql_exec: fn(&self, db: &conn.Conn, sql: [U8], quiet: Bool, err: &[U8]?) -[DB]> Int Never! {
            saved_auth: db.has_auth
            saved_trace: db.m_trace
            if quiet {
                db.has_auth = false
                db.m_trace = 0
            }
            h := EngineHost{unused: 0}
            a := cg.take_ast(db)
            data := init_data_new(0, 0)
            rc: exec_in<EngineHost>(h, db, a, sql, false, data, err)
            db.ast = a
            db.has_auth = saved_auth
            db.m_trace = saved_trace
            rc
        }
        // OP_ParseSchema without a WHERE clause: sqlite3InitOne.
        init_one: fn(&self, db: &conn.Conn, i_db: Int, flags: Int, err: &[U8]?) -[DB]> Int Never! {
            h := EngineHost{unused: 0}
            a := cg.take_ast(db)
            rc: init_one<EngineHost>(h, db, a, i_db, err, flags)
            db.ast = a
            rc
        }
        // OP_ParseSchema with a WHERE clause (vdbe.c): the matching schema
        // rows, through sqlite3InitCallback with db->init.busy set.
        parse_schema: fn(&self, db: &conn.Conn, i_db: Int, where: [U8], err: &[U8]?) -[DB]> Int Never! {
            h := EngineHost{unused: 0}
            a := cg.take_ast(db)
            data := init_data_new(i_db, 0)
            data.mx_page = btree.btree_last_page(db.btrees[db.dbs[i_db].bt])
            sql := concat("SELECT*FROM\"".bytes(), quote_w(db.dbs[i_db].name))
            sql = concat(sql, "\".{bld.LEGACY_SCHEMA_TABLE} WHERE ".bytes())
            sql = concat(sql, where)
            sql = concat(sql, " ORDER BY rowid".bytes())
            db.init.busy = true
            ignored := [U8]?{None}
            rc := exec_in<EngineHost>(h, db, a, sql, true, data, ignored)
            if rc == base.OK -> rc = data.rc
            // The reparse must find at least one row, or the schema table is
            // corrupt.
            if rc == base.OK && data.n_init_row == 0 -> rc = base.CORRUPT
            db.init.busy = false
            if data.err != None -> err = data.err
            db.ast = a
            rc
        }
        // sqlite3AnalysisLoad: ANALYZE is not in this build, so no
        // sqlite_stat1 rows are read; every index keeps the
        // sqlite3DefaultRowEst estimates sqlite3CreateIndex gave it.
        load_analysis: fn(&self, _db: &conn.Conn, _i_db: Int) -[DB]> Int Never! { base.OK }
        // VACUUM fails to compile in this build, so OP_Vacuum never runs.
        run_vacuum: fn(&self, _db: &conn.Conn, _i_db: Int, _into: base.Mem?, msg: &[U8]?) -[DB]> Int Never! {
            msg = Val("VACUUM is not supported in this build".bytes())
            base.ERROR
        }
        reprepare: fn(&self, db: &conn.Conn, v: &conn.Vdbe) -[DB]> Int Never! {
            h := EngineHost{unused: 0}
            reprepare<EngineHost>(h, db, v)
        }
    }
}

// ---------------------------------------------------------------------------
// prepare.c: loading the schema.

// corruptSchema.
corrupt_schema: fn(db: conn.Conn, data: &InitData, obj_type: [U8]?, obj_name: [U8]?, extra: [U8]?) Never! {
    if db.malloc_failed {
        data.rc = base.NOMEM
    } else if data.err != None {
        // An error message has already been generated.
    } else if data.init_flags.bit_and(INITFLAG_ALTER_MASK) != 0 {
        kind: data.init_flags.bit_and(INITFLAG_ALTER_MASK)
        alter: if kind == 1 -> "rename" else if kind == 2 -> "drop column" else -> "add column"
        data.err = Val("error in {ast.text(obj_type ?? [U8]{})} {ast.text(obj_name ?? [U8]{})} after {alter}: {ast.text(extra ?? [U8]{})}".bytes())
        data.rc = base.ERROR
    } else if db.flags.bit_and(btree.SQLITE_WRITE_SCHEMA) != 0 {
        data.rc = base.CORRUPT
    } else {
        obj: obj_name ?? "?".bytes()
        z := "malformed database schema ({ast.text(obj)})"
        if extra == .Val(x) && x.len() > 0 -> z = "{z} - {ast.text(x)}"
        data.err = Val(z.bytes())
        data.rc = base.CORRUPT
    }
}

// sqlite3InitCallback: one row of the schema table, argv being its type,
// name, tbl_name, rootpage and sql (None for a NULL); argv None for the
// empty-result call SQLITE_NullCallback makes. Nonzero to abort.
init_callback: fn<H: aux.Host>(h: &H, db: &conn.Conn, a: &ast.AST, data: &InitData, argv0: [[U8]?]?) -[DB]> Int Never! {
    i_db: data.i_db
    db.m_db_flags = db.m_db_flags.bit_or(conn.DBFLAG_ENCODING_FIXED)
    if argv0 == None -> return 0
    argv: argv0
    data.n_init_row += 1
    if db.malloc_failed {
        corrupt_schema(db, data, argv[0], argv[1], None)
        return 1
    }
    sql: argv[4] ?? [U8]{}
    if argv[3] == None {
        corrupt_schema(db, data, argv[0], argv[1], None)
    } else if argv[4] != None && sql.len() >= 2 && init_lower(Int.from_u8(sql[0])) == 99 && init_lower(Int.from_u8(sql[1])) == 114 {
        // A CREATE TABLE, INDEX or VIEW: with db->init.busy set, the parser
        // builds the schema object and generates no code.
        saved_i_db: db.init.i_db
        db.init.i_db = i_db
        tnum: util.get_uint32(argv[3] ?? [U8]{})
        db.init.new_tnum = tnum ?? 0
        // sqlite3Config.bExtraSchemaChecks is on by default.
        if tnum == None || (db.init.new_tnum > data.mx_page && data.mx_page > 0) -> corrupt_schema(db, data, argv[0], argv[1], Val("invalid rootpage".bytes()))
        db.init.orphan_trigger = false
        az := [[U8]]{}
        loop x in argv -> az.push(x ?? [U8]{})
        db.init.az_init = az
        r: prepare_in<H>(h, db, a, sql, -1, 0, None)
        rc: db.err_code
        db.init.i_db = saved_i_db
        if rc != base.OK {
            if !db.init.orphan_trigger {
                if rc > data.rc -> data.rc = rc
                if rc == base.NOMEM {
                    aux.oom_fault(db)
                } else if rc != base.INTERRUPT && rc.bit_and(255) != base.LOCKED {
                    corrupt_schema(db, data, argv[0], argv[1], Val(errmsg(db).bytes()))
                }
            }
        }
        db.init.az_init = [[U8]]{}
        _: finalize_stmt_in<H>(h, db, r.stmt)
    } else if argv[1] == None || (argv[4] != None && sql.len() > 0 && sql[0] != (U8{0})) {
        corrupt_schema(db, data, argv[0], argv[1], None)
    } else {
        // An empty sql column is an index a CREATE TABLE's PRIMARY KEY or
        // UNIQUE made, which it already built: record its root page.
        ix: conn.find_index(db, argv[1] ?? [U8]{}, Val(db.dbs[i_db].name))
        if ix < 0 {
            corrupt_schema(db, data, argv[0], argv[1], Val("orphan index".bytes()))
        } else {
            tnum: util.get_uint32(argv[3] ?? [U8]{})
            db.indexes[ix].tnum = tnum ?? 0
            if tnum == None || db.indexes[ix].tnum < 2 || db.indexes[ix].tnum > data.mx_page || bld.index_has_duplicate_root_page(db, ix) {
                corrupt_schema(db, data, argv[0], argv[1], Val("invalid rootpage".bytes()))
            }
        }
    }
    0
}

// sqlite3InitOne: read the schema of database i_db.
init_one: fn<H: aux.Host>(h: &H, db: &conn.Conn, a: &ast.AST, i_db: Int, err: &[U8]?, flags: Int) -[DB]> Int Never! {
    mask: db.m_db_flags.bit_and(conn.DBFLAG_ENCODING_FIXED).bit_or(util.clear_bits(-1, conn.DBFLAG_ENCODING_FIXED))
    db.init.busy = true
    // The schema table itself, by the parser, as row 1 of a schema.
    schema_name: bld.schema_table(i_db).bytes()
    data := init_data_new(i_db, flags)
    args := [[U8]?]{Val("table".bytes()), Val(schema_name), Val(schema_name), Val("1".bytes()), Val(SCHEMA_TABLE_SQL.bytes())}
    _: init_callback<H>(h, db, a, data, Val(args))
    db.m_db_flags = db.m_db_flags.bit_and(mask)
    if data.err != None -> err = data.err
    rc := data.rc
    opened := false
    if rc == base.OK {
        bt: db.dbs[i_db].bt
        if bt < 0 {
            db_set_property(db, 1, conn.DB_SCHEMA_LOADED)
        } else {
            rc = init_one_read(h, db, a, i_db, err, data, opened)
            if opened -> _: btree.btree_commit(db.btrees[db.dbs[i_db].bt])
        }
    }
    if rc != base.OK {
        if rc == base.NOMEM || rc == base.IOERR_NOMEM -> aux.oom_fault(db)
        conn.reset_one_schema(db, i_db)
    }
    db.init.busy = false
    rc
}

// The part of sqlite3InitOne between opening the read transaction (opened
// says whether it did) and initone_error_out.
init_one_read: fn<H: aux.Host>(h: &H, db: &conn.Conn, a: &ast.AST, i_db: Int, err: &[U8]?, data: &InitData, opened: &Bool) -[DB]> Int Never! {
    bt: db.dbs[i_db].bt
    s: db.dbs[i_db].schema
    if btree.btree_txn_state(db.btrees[bt]) == btree.TRANS_NONE {
        ignored := 0
        rc: btree.btree_begin_trans(db.btrees[bt], 0, ignored)
        if rc != base.OK {
            err = Val(base.error_string(rc).bytes())
            return rc
        }
        opened = true
    }
    // meta[0..4]: schema cookie, file format, default cache size, largest
    // root page and text encoding.
    meta := [Int]{}
    loop i in 0..<5 -> meta.push(btree.btree_get_meta(db.btrees[bt], i + 1))
    if db.flags.bit_and(btree.SQLITE_RESET_DATABASE) != 0 {
        loop i in 0..<5 -> meta[i] = 0
    }
    db.schemas[s].schema_cookie = meta[btree.BTREE_SCHEMA_VERSION - 1]
    if meta[btree.BTREE_TEXT_ENCODING - 1] != 0 {
        if i_db == 0 && db.m_db_flags.bit_and(conn.DBFLAG_ENCODING_FIXED) == 0 {
            encoding := meta[btree.BTREE_TEXT_ENCODING - 1].bit_and(3)
            if encoding == 0 -> encoding = base.UTF8
            if db.n_vdbe_active > 0 && encoding != db.enc && db.m_db_flags.bit_and(conn.DBFLAG_VACUUM) == 0 -> return base.LOCKED
            cat.set_text_encoding(db, encoding)
        } else if meta[btree.BTREE_TEXT_ENCODING - 1].bit_and(3) != db.enc {
            err = Val("attached databases must use the same text encoding as main database".bytes())
            return base.ERROR
        }
    }
    db.schemas[s].enc = db.enc
    if db.schemas[s].cache_size == 0 {
        size := meta[btree.BTREE_DEFAULT_CACHE_SIZE - 1]
        if size < 0 -> size = 0 - size
        if size == 0 -> size = btree.DEFAULT_CACHE_SIZE
        db.schemas[s].cache_size = size
        btree.btree_set_cache_size(db.btrees[bt], size)
    }
    db.schemas[s].file_format = meta[btree.BTREE_FILE_FORMAT - 1].bit_and(255)
    if db.schemas[s].file_format == 0 -> db.schemas[s].file_format = 1
    if db.schemas[s].file_format > bld.MAX_FILE_FORMAT {
        err = Val("unsupported file format".bytes())
        return base.ERROR
    }
    // Ticket #2804: a database in the newer file format clears
    // legacy_file_format, so that VACUUM keeps its descending indexes.
    if i_db == 0 && meta[btree.BTREE_FILE_FORMAT - 1] >= 4 -> db.flags = util.clear_bits(db.flags, conn.SQLITE_LEGACY_FILE_FMT)
    data.mx_page = btree.btree_last_page(db.btrees[bt])
    sql := concat("SELECT*FROM\"".bytes(), quote_w(db.dbs[i_db].name))
    sql = concat(sql, "\".{bld.schema_table(i_db)} ORDER BY rowid".bytes())
    saved_auth: db.has_auth
    db.has_auth = false
    ignored := [U8]?{None}
    rc := exec_in<H>(h, db, a, sql, true, data, ignored)
    db.has_auth = saved_auth
    if data.err != None -> err = data.err
    if rc == base.OK -> rc = data.rc
    if rc == base.OK -> _: h.load_analysis(db, i_db)
    if db.malloc_failed {
        rc = base.NOMEM
        conn.reset_all_schemas(db)
    } else if rc == base.OK || (db.flags.bit_and(conn.SQLITE_NO_SCHEMA_ERROR) != 0 && rc != base.NOMEM) {
        // With SQLITE_NoSchemaError the schema counts as loaded even after
        // an error other than OOM.
        db_set_property(db, i_db, conn.DB_SCHEMA_LOADED)
        rc = base.OK
    }
    rc
}

// sqlite3Init: load the schema of every database, main first and temp
// last.
init: fn<H: aux.Host>(h: &H, db: &conn.Conn, a: &ast.AST, err: &[U8]?) -[DB]> Int Never! {
    commit_internal: db.m_db_flags.bit_and(conn.DBFLAG_SCHEMA_CHANGE) == 0
    db.enc = db.schemas[db.dbs[0].schema].enc
    if !db_has_property(db, 0, conn.DB_SCHEMA_LOADED) {
        rc: init_one<H>(h, db, a, 0, err, 0)
        if rc != base.OK -> return rc
    }
    i := db.dbs.len() - 1
    loop i > 0 {
        if !db_has_property(db, i, conn.DB_SCHEMA_LOADED) {
            rc: init_one<H>(h, db, a, i, err, 0)
            if rc != base.OK -> return rc
        }
        i -= 1
    }
    if commit_internal -> aux.commit_internal_changes(db)
    base.OK
}

// schemaIsValid: compare each database's schema cookie with the loaded
// schema's; SQLITE_SCHEMA in the Parse when one is out of date.
schema_is_valid: fn(p: &cg.Parse, a: &ast.AST) Never! -[DB]> {
    loop i_db in 0..<p.db.dbs.len() {
        bt: p.db.dbs[i_db].bt
        if bt < 0 -> next
        opened := false
        if btree.btree_txn_state(p.db.btrees[bt]) == btree.TRANS_NONE {
            ignored := 0
            rc: btree.btree_begin_trans(p.db.btrees[bt], 0, ignored)
            if rc == base.NOMEM || rc == base.IOERR_NOMEM {
                aux.oom_fault(p.db)
                a.ctx.rc = base.NOMEM
            }
            if rc != base.OK -> return
            opened = true
        }
        cookie: btree.btree_get_meta(p.db.btrees[bt], btree.BTREE_SCHEMA_VERSION)
        if cookie != p.db.schemas[p.db.dbs[i_db].schema].schema_cookie {
            if db_has_property(p.db, i_db, conn.DB_SCHEMA_LOADED) -> a.ctx.rc = base.SCHEMA
            conn.reset_one_schema(p.db, i_db)
        }
        if opened -> _: btree.btree_commit(p.db.btrees[bt])
    }
}

// ---------------------------------------------------------------------------
// prepare.c: compiling a statement.

// sqlite3Prepare: compile the first statement of sql. n_bytes is the
// caller's length (-1 for a NUL-terminated string); rep the statement
// sqlite3Reprepare recompiles.
prepare_in: fn<H: aux.Host>(h: &H, db: &conn.Conn, a: &ast.AST, sql0: [U8], n_bytes: Int, prep_flags: Int, rep: PrepareFrom?) -[DB]> Prepared Never! {
    out := Prepared{rc: base.OK, stmt: -1, tail: 0}
    // The statement compiled while another is (a schema row's CREATE)
    // shares the arena: keep the outer statement's context.
    saved_ctx: a.ctx
    saved_busy: a.init_busy
    saved_suppress: a.suppress_err
    saved_offset: a.err_offset
    saved_limits: a.limits
    saved_opt: a.opt_flags
    p := cg.parse_new(cg.take_conn(db), EngineGen{unused: 0})
    if rep == .Val(r) -> p.reprepare_vars = r.vars
    if p.db.malloc_failed {
        p.db.err_code = base.NOMEM
        out.rc = base.NOMEM
        db = cg.take_conn(p.db)
        return out
    }
    p.f.prep_flags = prep_flags.bit_and(255)
    // The schema lock check is shared-cache only (sqlite3BtreeSchemaLocked
    // is 0 without it).
    if p.db.disconnect >= 0 -> conn.vtab_unlock_list(p.db)
    sql := sql0
    if n_bytes >= 0 {
        if n_bytes > p.db.limits[ast.LIMIT_SQL_LENGTH] {
            aux.error_with_msg(p.db, base.TOOBIG, "statement too long".bytes())
            out.rc = aux.api_exit(p.db, base.TOOBIG)
            db = cg.take_conn(p.db)
            return out
        }
        if n_bytes < sql0.len() -> sql = sql0[0..<n_bytes].copy()
    }
    ast.begin_statement(a, sql)
    a.init_busy = p.db.init.busy
    a.limits = p.db.limits
    a.opt_flags = p.db.db_opt_flags
    a.suppress_err = p.db.suppress_err != 0
    a.err_offset = -1
    if rep == .Val(r) {
        a.ctx.reprepare = true
        a.ctx.explain = r.explain
    }
    b := EngineBuilder{p: p}
    _: parse.run_parser<EngineBuilder>(b, a)
    p = b.p
    run_parser_cleanup(p, a)
    out.tail = a.ctx.tail
    if !p.db.init.busy && p.f.has_vdbe -> aux.set_sql(p.f.v, a.ctx.sql[0..<out.tail].copy(), prep_flags)
    if p.db.malloc_failed {
        a.ctx.rc = base.NOMEM
        p.f.check_schema = false
    }
    if a.ctx.rc != base.OK && a.ctx.rc != base.DONE {
        if p.f.check_schema && !p.db.init.busy -> schema_is_valid(p, a)
        if p.f.has_vdbe {
            v := p.f.v
            p.f.v = conn.vdbe_new()
            p.f.has_vdbe = false
            _: aux.finalize<H>(h, p.db, v)
        }
        out.rc = a.ctx.rc
        if a.ctx.errmsg == .Val(msg) {
            aux.error_with_msg(p.db, out.rc, msg.bytes())
            p.db.err_byte_offset = a.err_offset
        } else {
            aux.sql_error(p.db, out.rc)
        }
    } else {
        if p.f.has_vdbe {
            v := p.f.v
            p.f.v = conn.vdbe_new()
            p.f.has_vdbe = false
            out.stmt = v.slot
            conn.vdbe_put(p.db, v)
        }
        out.rc = base.OK
        error_clear(p.db)
    }
    db = cg.take_conn(p.db)
    a.ctx = saved_ctx
    a.init_busy = saved_busy
    a.suppress_err = saved_suppress
    a.err_offset = saved_offset
    a.limits = saved_limits
    a.opt_flags = saved_opt
    out
}

// sqlite3LockAndPrepare: sqlite3Prepare, again after SQLITE_ERROR_RETRY
// (up to SQLITE_MAX_PREPARE_RETRY times) or once after SQLITE_SCHEMA with
// the schemas reset.
lock_and_prepare: fn<H: aux.Host>(h: &H, db: &conn.Conn, a: &ast.AST, sql: [U8], n_bytes: Int, prep_flags: Int, rep: PrepareFrom?) -[DB]> Prepared Never! {
    if !safety_check_ok(db) -> return Prepared{rc: base.MISUSE, stmt: -1, tail: 0}
    cnt := 0
    out := Prepared{rc: base.OK, stmt: -1, tail: 0}
    loop {
        out = prepare_in<H>(h, db, a, sql, n_bytes, prep_flags, rep)
        if out.rc == base.OK || db.malloc_failed -> break
        if out.rc == base.ERROR_RETRY && cnt < MAX_PREPARE_RETRY {
            cnt += 1
            next
        }
        if out.rc == base.SCHEMA && cnt == 0 {
            conn.reset_one_schema(db, -1)
            cnt += 1
            next
        }
        break
    }
    out.rc = aux.api_exit(db, out.rc)
    // db->busyHandler.nBusy = 0, in the copy each pager holds.
    loop i in 0..<db.dbs.len() {
        b: db.dbs[i].bt
        if b >= 0 -> db.btrees[b].pager.busy.n_busy = 0
    }
    out
}

// sqlite3Reprepare: recompile statement v after a schema change. The new
// program takes v's place (sqlite3VdbeSwap), v keeping its slot, SQL,
// expiry mask, flags and counters, and v's bound values move to it.
reprepare: fn<H: aux.Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe) -[DB]> Int Never! {
    a := cg.take_ast(db)
    r: lock_and_prepare<H>(h, db, a, v.sql, -1, v.prep_flags, Val(PrepareFrom{explain: v.explain, vars: v.vars}))
    db.ast = a
    if r.rc != base.OK {
        if r.rc == base.NOMEM -> aux.oom_fault(db)
        return r.rc
    }
    // sqlite3VdbeSwap: the contents trade places; each keeps its list
    // place (the slot) and its SQL.
    old := v
    v = conn.vdbe_take(db, r.stmt)
    v.slot = old.slot
    v.sql = old.sql
    v.expmask = old.expmask
    v.prep_flags = old.prep_flags
    v.counters = old.counters
    v.counters[conn.STMTSTATUS_REPREPARE] = v.counters[conn.STMTSTATUS_REPREPARE] + 1
    old.slot = r.stmt
    // Vdbe.expired is part of the swapped contents: it lives in the slot's
    // link here, so the two links trade it too.
    expired: db.vdbe_links[v.slot].expired
    db.vdbe_links[v.slot].expired = db.vdbe_links[r.stmt].expired
    db.vdbe_links[r.stmt].expired = expired
    // sqlite3TransferBindings(pNew, p).
    n: if old.n_var < v.n_var -> old.n_var else -> v.n_var
    loop i in 0..<n {
        v.vars[i] = old.vars[i]
        old.vars[i] = base.mem_null()
    }
    aux.reset_step_result(old)
    _: aux.finalize<H>(h, db, old)
    base.OK
}

// ---------------------------------------------------------------------------
// legacy.c: sqlite3_exec.

// sqlite3_exec of each statement of sql in turn; with cb, each result row
// (and the empty result of SQLITE_NullCallback) goes to
// sqlite3InitCallback with data, the only callback the engine passes.
// err gets the error message, None on success.
exec_in: fn<H: aux.Host>(h: &H, db: &conn.Conn, a: &ast.AST, sql0: [U8], cb: Bool, data: &InitData, err: &[U8]?) -[DB]> Int Never! {
    if !safety_check_ok(db) -> return base.MISUSE
    sql: c_text(sql0)
    rc := base.OK
    pos := 0
    s := -1
    aux.sql_error(db, base.OK)
    loop rc == base.OK && pos < sql.len() {
        n_col := 0
        s = -1
        r: lock_and_prepare<H>(h, db, a, sql[pos..<sql.len()].copy(), -1, conn.PREPARE_SAVESQL, None)
        rc = r.rc
        if rc != base.OK -> next
        if r.stmt < 0 {
            // A comment or white space.
            pos += r.tail
            next
        }
        s = r.stmt
        callback_is_init := false
        failed := false
        loop {
            rc = api.stmt_step<H>(h, db, s)
            if cb && (rc == base.ROW || (rc == base.DONE && !callback_is_init && db.flags.bit_and(conn.SQLITE_NULL_CALLBACK) != 0)) {
                // The column names, azCols, go only to the callback, which
                // sqlite3InitCallback ignores.
                if !callback_is_init {
                    n_col = api.column_count(db, s)
                    callback_is_init = true
                }
                vals := [[U8]?]?{None}
                if rc == base.ROW {
                    row := [[U8]?]{}
                    loop i in 0..<n_col {
                        z: api.column_text(db, s, i)
                        if z == None && api.column_type(db, s, i) != base.SQL_NULL {
                            aux.oom_fault(db)
                            failed = true
                            break
                        }
                        row.push(z)
                    }
                    if failed -> break
                    vals = Val(row)
                }
                if init_callback<H>(h, db, a, data, vals) != 0 {
                    rc = base.ABORT
                    _: finalize_stmt_in<H>(h, db, s)
                    s = -1
                    aux.sql_error(db, base.ABORT)
                    failed = true
                    break
                }
            }
            if rc != base.ROW {
                rc = finalize_stmt_in<H>(h, db, s)
                s = -1
                pos += r.tail
                loop pos < sql.len() && util.is_space(Int.from_u8(sql[pos])) -> pos += 1
                break
            }
        }
        if failed -> break
    }
    if s >= 0 -> _: finalize_stmt_in<H>(h, db, s)
    rc = aux.api_exit(db, rc)
    if rc != base.OK {
        err = Val(errmsg(db).bytes())
    } else {
        err = None
    }
    rc
}

// sqlite3VdbeFinalize of statement s (none for -1).
finalize_stmt_in: fn<H: aux.Host>(h: &H, db: &conn.Conn, s: Int) -[DB]> Int Never! {
    if s < 0 -> return base.OK
    v := conn.vdbe_take(db, s)
    aux.finalize<H>(h, db, v)
}

// ---------------------------------------------------------------------------
// main.c: the connection.

// openDatabase with sqlite3_open_v2's flags: the connection to the
// database file at path (":memory:" for an in-memory database). On failure
// the connection holds the error; close it with close_v2.
open_v2: fn(path: String, flags_in: Int) -[DB]> (rc: Int, db: conn.Conn) Never! {
    db := conn.conn_new()
    flags := flags_in
    // SQLITE_OPEN_PRIVATECACHE drops SHAREDCACHE; shared cache is not
    // enabled globally. Then the bits sqlite3_open_v2 does not take go.
    if flags.bit_and(os.OPEN_PRIVATECACHE) != 0 -> flags = util.clear_bits(flags, os.OPEN_SHAREDCACHE)
    harmful: os.OPEN_DELETEONCLOSE.bit_or(os.OPEN_EXCLUSIVE).bit_or(os.OPEN_MAIN_DB).bit_or(os.OPEN_TEMP_DB).bit_or(os.OPEN_TRANSIENT_DB).bit_or(os.OPEN_MAIN_JOURNAL).bit_or(os.OPEN_TEMP_JOURNAL).bit_or(os.OPEN_SUBJOURNAL).bit_or(os.OPEN_SUPER_JOURNAL).bit_or(os.OPEN_NOMUTEX).bit_or(os.OPEN_FULLMUTEX).bit_or(os.OPEN_WAL)
    flags = util.clear_bits(flags, harmful)
    db.err_mask = if flags.bit_and(os.OPEN_EXRESCODE) != 0 -> 4294967295 else -> 255
    db.open_state = conn.STATE_BUSY
    db.auto_commit = true
    db.next_autovac = -1
    db.next_pagesize = 0
    // The default flags of a 3.45.0 build with no SQLITE_* options.
    db.flags = db.flags.bit_or(conn.SQLITE_SHORT_COL_NAMES).bit_or(conn.SQLITE_ENABLE_TRIGGER).bit_or(conn.SQLITE_ENABLE_VIEW).bit_or(conn.SQLITE_CACHE_SPILL).bit_or(conn.SQLITE_TRUSTED_SCHEMA).bit_or(conn.SQLITE_DQS_DML).bit_or(conn.SQLITE_DQS_DDL).bit_or(conn.SQLITE_AUTO_INDEX)
    db.open_flags = flags
    // Only READONLY, READWRITE and READWRITE|CREATE make sense.
    rc := base.OK
    if (1 << flags.bit_and(7)).bit_and(70) == 0 {
        rc = base.MISUSE
        aux.sql_error(db, rc)
    } else if flags.bit_and(os.OPEN_URI) != 0 && path.starts_with("file:") {
        // sqlite3ParseUri's URI branch.
        rc = base.ERROR
        aux.error_with_msg(db, rc, "URI filenames are not supported in this build".bytes())
    } else {
        // sqlite3ParseUri of a plain filename: the URI bit goes.
        flags = util.clear_bits(flags, os.OPEN_URI)
        rc = open_main(db, path, flags)
    }
    rc = db.err_code
    if rc != base.OK -> db.open_state = conn.STATE_SICK
    (rc: rc, db: db)
}

// openDatabase from sqlite3BtreeOpen of the main database to the end.
open_main: fn(db: &conn.Conn, path: String, flags: Int) -[DB]> Int Never! {
    db.dbs = [conn.DBSlot]{
        conn.DBSlot{name: "main".bytes(), bt: -1, safety_level: pgr.DEFAULT_SYNCHRONOUS + 1, b_sync_set: false, schema: -1},
        conn.DBSlot{name: "temp".bytes(), bt: -1, safety_level: pgr.PAGER_SYNCHRONOUS_OFF, b_sync_set: false, schema: -1}
    }
    bt: conn.btree_slot_new(db)
    bd: conn.bt_db_of(db)
    rc := btree.btree_open(db.btrees[bt], Val(path), bd, 0, flags.bit_or(os.OPEN_MAIN_DB), true, false, false, false)
    if rc != base.OK {
        conn.btree_slot_free(db, bt)
        if rc == base.IOERR_NOMEM -> rc = base.NOMEM
        aux.sql_error(db, rc)
        return rc
    }
    db.dbs[0].bt = bt
    db.dbs[0].schema = conn.schema_alloc(db)
    cat.set_text_encoding(db, db.schemas[db.dbs[0].schema].enc)
    db.dbs[1].schema = conn.schema_alloc(db)
    db.open_state = conn.STATE_OPEN
    aux.sql_error(db, base.OK)
    // The builtin functions are a process-wide table (Catalog's
    // init_builtin_funcs) the function lookup reads, so there is nothing
    // to register per connection. sqlite3_wal_autocheckpoint's default is
    // conn_new's.
    db.busy_timeout = 0
    base.OK
}

// sqlite3_close_v2 (sqlite3Close with forceZombie): the connection becomes
// a zombie and closes once its last statement is finalized.
close_v2: fn(db: &conn.Conn) -[DB]> Int Never! {
    if !safety_check_sick_or_ok(db) -> return base.MISUSE
    h := EngineHost{unused: 0}
    // disconnectAllVtab and sqlite3VtabRollback: no virtual tables here.
    aux.vtab_rollback<EngineHost>(h, db)
    db.open_state = conn.STATE_ZOMBIE
    close_zombie<EngineHost>(h, db)
    base.OK
}

// sqlite3LeaveMutexAndCloseZombie: free the connection once it is a zombie
// with no statement left.
close_zombie: fn<H: aux.Host>(h: &H, db: &conn.Conn) Never! -[DB]> {
    if db.open_state != conn.STATE_ZOMBIE || db.vdbe_head >= 0 -> return
    aux.rollback_all<H>(h, db, base.OK)
    aux.close_savepoints(db)
    loop j in 0..<db.dbs.len() {
        bt: db.dbs[j].bt
        if bt >= 0 {
            _: btree.btree_close(db.btrees[bt])
            conn.btree_slot_free(db, bt)
            db.dbs[j].bt = -1
            if j != 1 -> db.dbs[j].schema = -1
        }
    }
    if db.dbs.len() > 1 && db.dbs[1].schema >= 0 -> conn.schema_clear(db, db.dbs[1].schema)
    conn.vtab_unlock_list(db)
    aux.vtab_reap<H>(h, db)
    db.err_code = base.OK
    db.err_msg = None
    db.open_state = conn.STATE_CLOSED
}

// sqlite3_errmsg.
errmsg: fn(db: conn.Conn) -> String Never! {
    if !safety_check_sick_or_ok(db) -> return base.error_string(base.MISUSE)
    if db.malloc_failed -> return base.error_string(base.NOMEM)
    if db.err_code != 0 && db.err_msg == .Val(z) -> return ast.text(z)
    base.error_string(db.err_code)
}

// sqlite3_error_offset.
error_offset: fn(db: conn.Conn) -> Int Never! {
    if safety_check_sick_or_ok(db) && db.err_code != 0 -> db.err_byte_offset else -> -1
}

// sqlite3_extended_result_codes.
extended_result_codes: fn(db: &conn.Conn, on: Bool) -> Int Never! {
    if !safety_check_ok(db) -> return base.MISUSE
    db.err_mask = if on -> 4294967295 else -> 255
    base.OK
}

// sqlite3_busy_timeout: sqliteDefaultBusyCallback sleeps up to ms
// milliseconds on a lock; 0 or less clears the handler. Each pager holds a
// copy of the handler state.
busy_timeout: fn(db: &conn.Conn, ms: Int) -> Int Never! {
    if !safety_check_ok(db) -> return base.MISUSE
    db.busy_timeout = if ms > 0 -> ms else -> 0
    loop i in 0..<db.dbs.len() {
        b: db.dbs[i].bt
        if b >= 0 -> db.btrees[b].pager.busy = wal.BusyHandler{timeout: db.busy_timeout, n_busy: 0}
    }
    base.OK
}

// sqlite3_get_autocommit.
get_autocommit: fn(db: conn.Conn) -> Bool Never! { db.auto_commit }

// sqlite3_changes64.
changes: fn(db: conn.Conn) -> Int Never! { db.n_change }

// sqlite3_prepare_v3: compile the first statement of sql; stmt is -1 when
// it holds none (white space or a comment), tail the byte offset of the
// rest.
prepare_v3: fn(db: &conn.Conn, sql: [U8], flags: Int) -[DB]> (rc: Int, stmt: Int, tail: Int) Never! {
    h := EngineHost{unused: 0}
    a := cg.take_ast(db)
    r: lock_and_prepare<EngineHost>(h, db, a, sql, sql.len(), conn.PREPARE_SAVESQL.bit_or(flags.bit_and(conn.PREPARE_MASK)), None)
    db.ast = a
    (rc: r.rc, stmt: r.stmt, tail: r.tail)
}

// sqlite3_step.
step: fn(db: &conn.Conn, s: Int) -[DB]> Int Never! {
    h := EngineHost{unused: 0}
    api.stmt_step<EngineHost>(h, db, s)
}

// sqlite3_reset.
reset_stmt: fn(db: &conn.Conn, s: Int) -[DB]> Int Never! {
    h := EngineHost{unused: 0}
    api.stmt_reset<EngineHost>(h, db, s)
}

// sqlite3_finalize: a zombie connection closes with its last statement.
finalize_stmt: fn(db: &conn.Conn, s: Int) -[DB]> Int Never! {
    if s < 0 -> return base.OK
    h := EngineHost{unused: 0}
    rc: api.stmt_finalize<EngineHost>(h, db, s)
    close_zombie<EngineHost>(h, db)
    rc
}

// sqlite3_exec without a callback.
exec_sql: fn(db: &conn.Conn, sql: [U8]) -[DB]> Int Never! {
    h := EngineHost{unused: 0}
    a := cg.take_ast(db)
    data := init_data_new(0, 0)
    ignored := [U8]?{None}
    rc: exec_in<EngineHost>(h, db, a, sql, false, data, ignored)
    db.ast = a
    rc
}
