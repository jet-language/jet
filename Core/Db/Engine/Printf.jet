// The printf engine of the Jet SQLite engine, a port of SQLite 3.45.0
// printf.c: the StrAccum string accumulator and sqlite3_str_vappendf with
// every conversion SQL's printf()/format() reaches (%d %i %u %x %X %o %r
// %c %s %z %q %Q %w %f %e %E %g %G %n %% and the flags - + space # ! 0 ,
// l ll, width and precision with *). Floating-point conversions decode
// through util.fp_decode, the extended-precision sqlite3FpDecode.
//
// Arguments come through `PrintfArgs`: `MemList` holds the typed
// arguments of an engine-internal format (the va_list of sqlite3MPrintf
// and sqlite3_snprintf) as base.Mem cells, and the SQL function layer
// implements the trait over sqlite3_value arguments (SQLITE_PRINTF_SQLFUNC,
// whose reads convert as sqlite3_value_int64 and friends do). Engine error
// messages are built by the AST layer with their byte offsets, so the
// internal-only %T and %S conversions end the format as they do when
// SQLITE_PRINTF_INTERNAL is clear.
use {
    math: core.math
    base: __core_db_base
    __core_db_base.[Mem, MEM_INT, MEM_REAL, MEM_STR]
    util: __core_db_util
    __core_db_util.[sql_byte, fp_decode]
}

// StrAccum.printfFlags (sqliteInt.h).
PRINTF_INTERNAL: 1
PRINTF_SQLFUNC: 2
PRINTF_MALLOCED: 4

// SQLITE_PRINT_BUF_SIZE, SQLITE_FP_PRECISION_LIMIT and SQLITE_MAX_LENGTH.
PRINT_BUF_SIZE: 70
FP_PRECISION_LIMIT: 100000000
MAX_LENGTH: 1000000000

// The conversion paradigms (etRADIX ... etINVALID).
ET_RADIX: 0
ET_FLOAT: 1
ET_EXP: 2
ET_GENERIC: 3
ET_SIZE: 4
ET_STRING: 5
ET_DYNSTRING: 6
ET_PERCENT: 7
ET_CHARX: 8
ET_SQLESCAPE: 9
ET_SQLESCAPE2: 10
ET_TOKEN: 11
ET_SRCITEM: 12
ET_POINTER: 13
ET_SQLESCAPE3: 14
ET_ORDINAL: 15
ET_DECIMAL: 16
ET_INVALID: 17

// et_info.flags.
FLAG_SIGNED: 1
FLAG_STRING: 4

// aDigits and aPrefix.
DIGITS: "0123456789ABCDEF0123456789abcdef"
PREFIX: [Int]{45, 120, 48, 0, 88, 48, 0}

// One fmtinfo[] entry.
PrintfInfo: struct {
    fmttype: Int
    radix: Int
    flags: Int
    kind: Int
    charset: Int
    prefix: Int
}

// fmtinfo[], searched in this order.
FMT_INFO: [PrintfInfo]{
    PrintfInfo{fmttype: 100, radix: 10, flags: 1, kind: ET_DECIMAL, charset: 0, prefix: 0},
    PrintfInfo{fmttype: 115, radix: 0, flags: 4, kind: ET_STRING, charset: 0, prefix: 0},
    PrintfInfo{fmttype: 103, radix: 0, flags: 1, kind: ET_GENERIC, charset: 30, prefix: 0},
    PrintfInfo{fmttype: 122, radix: 0, flags: 4, kind: ET_DYNSTRING, charset: 0, prefix: 0},
    PrintfInfo{fmttype: 113, radix: 0, flags: 4, kind: ET_SQLESCAPE, charset: 0, prefix: 0},
    PrintfInfo{fmttype: 81, radix: 0, flags: 4, kind: ET_SQLESCAPE2, charset: 0, prefix: 0},
    PrintfInfo{fmttype: 119, radix: 0, flags: 4, kind: ET_SQLESCAPE3, charset: 0, prefix: 0},
    PrintfInfo{fmttype: 99, radix: 0, flags: 0, kind: ET_CHARX, charset: 0, prefix: 0},
    PrintfInfo{fmttype: 111, radix: 8, flags: 0, kind: ET_RADIX, charset: 0, prefix: 2},
    PrintfInfo{fmttype: 117, radix: 10, flags: 0, kind: ET_DECIMAL, charset: 0, prefix: 0},
    PrintfInfo{fmttype: 120, radix: 16, flags: 0, kind: ET_RADIX, charset: 16, prefix: 1},
    PrintfInfo{fmttype: 88, radix: 16, flags: 0, kind: ET_RADIX, charset: 0, prefix: 4},
    PrintfInfo{fmttype: 102, radix: 0, flags: 1, kind: ET_FLOAT, charset: 0, prefix: 0},
    PrintfInfo{fmttype: 101, radix: 0, flags: 1, kind: ET_EXP, charset: 30, prefix: 0},
    PrintfInfo{fmttype: 69, radix: 0, flags: 1, kind: ET_EXP, charset: 14, prefix: 0},
    PrintfInfo{fmttype: 71, radix: 0, flags: 1, kind: ET_GENERIC, charset: 14, prefix: 0},
    PrintfInfo{fmttype: 105, radix: 10, flags: 1, kind: ET_DECIMAL, charset: 0, prefix: 0},
    PrintfInfo{fmttype: 110, radix: 0, flags: 0, kind: ET_SIZE, charset: 0, prefix: 0},
    PrintfInfo{fmttype: 37, radix: 0, flags: 0, kind: ET_PERCENT, charset: 0, prefix: 0},
    PrintfInfo{fmttype: 112, radix: 16, flags: 0, kind: ET_POINTER, charset: 0, prefix: 1},
    PrintfInfo{fmttype: 84, radix: 0, flags: 0, kind: ET_TOKEN, charset: 0, prefix: 0},
    PrintfInfo{fmttype: 83, radix: 0, flags: 0, kind: ET_SRCITEM, charset: 0, prefix: 0},
    PrintfInfo{fmttype: 114, radix: 10, flags: 1, kind: ET_ORDINAL, charset: 0, prefix: 0}
}

// ---------------------------------------------------------------------------
// Arguments.

// The argument source of one format (getIntArg, getDoubleArg, getTextArg
// and the va_arg reads). next_text sets out to the bytes of a text
// argument, which as a C string end at their first 0x00 byte, and returns
// false for a NULL char*.
PrintfArgs: trait {
    int_arg: fn(&self) -> Int Never!
    double_arg: fn(&self) -> Float Never!
    next_text: fn(&self, out: &[U8]) -> Bool Never!
}

// The va_list of an engine-internal format: MEM_INT cells are integer
// arguments, MEM_REAL cells doubles, MEM_STR cells char* and MEM_NULL a
// NULL char*. Reads past the end give 0, 0.0 and NULL as getIntArg and
// friends do.
MemList: struct {
    args: [Mem]
    used: Int
}

new_mem_list: fn(args: [Mem]) -> MemList Never! {
    MemList{args: args, used: 0}
}

impl MemList.PrintfArgs {
    int_arg: fn(&self) -> Int Never! {
        if self.used >= self.args.len() -> return 0
        self.used += 1
        m: self.args[self.used - 1]
        if m.flags.bit_and(MEM_INT) != 0 -> return m.i
        0
    }
    double_arg: fn(&self) -> Float Never! {
        if self.used >= self.args.len() -> return Float{0}
        self.used += 1
        m: self.args[self.used - 1]
        if m.flags.bit_and(MEM_REAL) != 0 -> return m.r
        if m.flags.bit_and(MEM_INT) != 0 -> return util.int_to_double(m.i)
        Float{0}
    }
    next_text: fn(&self, out: &[U8]) -> Bool Never! {
        if self.used >= self.args.len() -> return false
        self.used += 1
        m: self.args[self.used - 1]
        if m.flags.bit_and(MEM_STR) == 0 -> return false
        out.clear()
        loop b in m.z -> out.push(b)
        true
    }
}

// ---------------------------------------------------------------------------
// The accumulator (sqlite3_str).

// A string under construction: text is zText[0..nChar), n_alloc the
// space the C buffer would hold, mx_alloc the most it may grow to (0 for
// a fixed buffer, which truncates). C rounds a heap buffer up to its
// allocator's size; n_alloc keeps the requested size, so with a limit
// below that rounding SQLITE_TOOBIG comes at the limit itself.
//
// An accumulator whose C counterpart has a database connection sets
// has_db; its owner passes an SQLITE_TOOBIG acc_error on to the parser
// as sqlite3StrAccumSetError does through sqlite3ErrorToParser.
StrAccum: struct {
    text: [U8]
    n_alloc: Int
    mx_alloc: Int
    acc_error: Int
    printf_flags: Int
    has_db: Bool
}

// sqlite3StrAccumInit with a base buffer of n bytes.
str_accum_init: fn(n: Int, mx: Int) -> StrAccum Never! {
    StrAccum{text: [U8]{}, n_alloc: n, mx_alloc: mx, acc_error: 0, printf_flags: 0, has_db: false}
}

// sqlite3_str_new: a heap accumulator limited to mx bytes.
str_new: fn(mx: Int) -> StrAccum Never! {
    str_accum_init(0, mx)
}

// sqlite3StrAccumSetError.
str_accum_set_error: fn(p: &StrAccum, e: Int) Never! {
    p.acc_error = e
    if p.mx_alloc != 0 -> str_reset(p)
}

// sqlite3_str_reset.
str_reset: fn(p: &StrAccum) Never! {
    p.printf_flags = p.printf_flags.bit_and(PRINTF_MALLOCED.bit_xor(255))
    p.n_alloc = 0
    p.text = [U8]{}
}

// sqlite3StrAccumEnlarge: room for n more bytes; the bytes that may be
// appended now, which can be fewer than n or zero.
str_accum_enlarge: fn(p: &StrAccum, n: Int) -> Int Never! {
    if p.acc_error != 0 -> return 0
    if p.mx_alloc == 0 {
        str_accum_set_error(p, base.TOOBIG)
        return p.n_alloc - p.text.len() - 1
    }
    sz := p.text.len() + n + 1
    if sz + p.text.len() <= p.mx_alloc -> sz += p.text.len()
    if sz > p.mx_alloc {
        str_reset(p)
        str_accum_set_error(p, base.TOOBIG)
        return 0
    }
    p.n_alloc = sz
    p.printf_flags = p.printf_flags.bit_or(PRINTF_MALLOCED)
    n
}

// sqlite3_str_appendchar: n copies of byte c.
str_append_char: fn(p: &StrAccum, n_in: Int, c: Int) Never! {
    n := n_in
    if p.text.len() + n >= p.n_alloc {
        n = str_accum_enlarge(p, n)
        if n <= 0 -> return
    }
    loop _k in 0..<n -> p.text.push(U8{c})
}

// sqlite3_str_append: the n bytes of z from z[at].
str_append: fn(p: &StrAccum, z: [U8], at: Int, n_in: Int) Never! {
    n := n_in
    if p.text.len() + n >= p.n_alloc {
        n = str_accum_enlarge(p, n)
        if n <= 0 -> return
    }
    loop k in 0..<n -> p.text.push(z[at + k])
}

// sqlite3_str_appendall.
str_append_all: fn(p: &StrAccum, z: [U8]) Never! {
    str_append(p, z, 0, c_len(z))
}

// strlen of a C string: the bytes before the first 0x00.
c_len: fn(z: [U8]) -> Int Never! {
    n := 0
    loop n < z.len() && z[n] != (U8{0}) -> n += 1
    n
}

// printfTempBuf: whether a conversion may use a temporary buffer of n
// bytes; a size past both the buffer and the limit is SQLITE_TOOBIG.
temp_buf_ok: fn(p: &StrAccum, n: Int) -> Bool Never! {
    if p.acc_error != 0 -> return false
    if n > p.n_alloc && n > p.mx_alloc {
        str_accum_set_error(p, base.TOOBIG)
        return false
    }
    true
}

// ---------------------------------------------------------------------------
// sqlite3_str_vappendf.

// A C `int` from a wider value, as va_arg(ap,int) and (int) casts read it.
to_c_int: fn(v: Int) -> Int Never! {
    u: util.as_u64(v).bit_and(4294967295)
    if u >= 2147483648 -> return u - 4294967296
    u
}

// sqlite3_str_vappendf: the format fmt rendered into p.
str_vappendf: fn<A: PrintfArgs>(p: &StrAccum, fmt: [U8], args: &A) Never! {
    arg_list: p.printf_flags.bit_and(PRINTF_SQLFUNC) != 0
    at := 0
    loop at < fmt.len() && fmt[at] != (U8{0}) {
        c := sql_byte(fmt, at)
        if c != 37 {
            start: at
            loop at < fmt.len() && fmt[at] != (U8{0}) && fmt[at] != (U8{37}) -> at += 1
            str_append(p, fmt, start, at - start)
            if sql_byte(fmt, at) == 0 -> break
        }
        at += 1
        c = sql_byte(fmt, at)
        if c == 0 {
            str_append_char(p, 1, 37)
            break
        }
        // The flags, width and precision.
        flag_leftjustify := false
        flag_prefix := 0
        thousand := 0
        flag_alternateform := false
        flag_altform2 := false
        flag_zeropad := false
        flag_long := 0
        width := 0
        precision := -1
        done := false
        loop {
            if c == 45 {
                flag_leftjustify = true
            } else if c == 43 {
                flag_prefix = 43
            } else if c == 32 {
                flag_prefix = 32
            } else if c == 35 {
                flag_alternateform = true
            } else if c == 33 {
                flag_altform2 = true
            } else if c == 48 {
                flag_zeropad = true
            } else if c == 44 {
                thousand = 44
            } else if c == 108 {
                flag_long = 1
                at += 1
                c = sql_byte(fmt, at)
                if c == 108 {
                    at += 1
                    c = sql_byte(fmt, at)
                    flag_long = 2
                }
                done = true
            } else if c >= 49 && c <= 57 {
                wx := c - 48
                at += 1
                c = sql_byte(fmt, at)
                loop c >= 48 && c <= 57 {
                    wx = (wx * 10 + c - 48).bit_and(4294967295)
                    at += 1
                    c = sql_byte(fmt, at)
                }
                width = wx.bit_and(2147483647)
                if c != 46 && c != 108 {
                    done = true
                } else {
                    at -= 1
                }
            } else if c == 42 {
                width = to_c_int(args.int_arg())
                if width < 0 {
                    flag_leftjustify = true
                    width = if width >= -2147483647 -> 0 - width else -> 0
                }
                c = sql_byte(fmt, at + 1)
                if c != 46 && c != 108 {
                    at += 1
                    c = sql_byte(fmt, at)
                    done = true
                }
            } else if c == 46 {
                at += 1
                c = sql_byte(fmt, at)
                if c == 42 {
                    precision = to_c_int(args.int_arg())
                    if precision < 0 {
                        precision = if precision >= -2147483647 -> 0 - precision else -> -1
                    }
                    at += 1
                    c = sql_byte(fmt, at)
                } else {
                    px := 0
                    loop c >= 48 && c <= 57 {
                        px = (px * 10 + c - 48).bit_and(4294967295)
                        at += 1
                        c = sql_byte(fmt, at)
                    }
                    precision = px.bit_and(2147483647)
                }
                if c == 108 {
                    at -= 1
                } else {
                    done = true
                }
            } else {
                done = true
            }
            if done -> break
            at += 1
            c = sql_byte(fmt, at)
            if c == 0 -> break
        }
        // The fmtinfo entry of the conversion.
        info := FMT_INFO[0]
        xtype := ET_INVALID
        loop idx in 0..<FMT_INFO.len() {
            if c == FMT_INFO[idx].fmttype {
                info = FMT_INFO[idx]
                xtype = info.kind
                break
            }
        }
        if xtype == ET_INVALID || xtype == ET_TOKEN || xtype == ET_SRCITEM -> return
        // The conversion text and its length; for %c the leading copies are
        // already appended.
        out := [U8]{}
        if xtype == ET_POINTER || xtype == ET_ORDINAL || xtype == ET_RADIX || xtype == ET_DECIMAL {
            if xtype == ET_POINTER -> flag_long = 2
            if xtype != ET_DECIMAL -> thousand = 0
            if !render_int(p, args, arg_list, info, xtype, flag_long, flag_prefix, flag_alternateform, flag_zeropad, thousand, width, precision, out) -> return
        } else if xtype == ET_FLOAT || xtype == ET_EXP || xtype == ET_GENERIC {
            realvalue: args.double_arg()
            if !render_float(p, realvalue, info, xtype, flag_prefix, flag_alternateform, flag_altform2, flag_zeropad, flag_leftjustify, thousand, width, precision, out) -> return
        } else if xtype == ET_SIZE {
            if !arg_list -> _: args.int_arg()
            width = 0
        } else if xtype == ET_PERCENT {
            out.push(U8{37})
        } else if xtype == ET_CHARX {
            if arg_list {
                z := [U8]{}
                if args.next_text(z) {
                    first: sql_byte(z, 0)
                    out.push(U8{first})
                    if first.bit_and(192) == 192 {
                        k := 1
                        loop out.len() < 4 && sql_byte(z, k).bit_and(192) == 128 {
                            out.push(z[k])
                            k += 1
                        }
                    }
                } else {
                    out.push(U8{0})
                }
            } else {
                util.write_utf8(out, util.as_u64(args.int_arg()).bit_and(4294967295))
            }
            if precision > 1 {
                width -= precision - 1
                if width > 1 && !flag_leftjustify {
                    str_append_char(p, width - 1, 32)
                    width = 0
                }
                loop _k in 0..<(precision - 1) -> str_append(p, out, 0, out.len())
            }
            flag_altform2 = true
        } else if xtype == ET_STRING || xtype == ET_DYNSTRING {
            z := [U8]{}
            _: args.next_text(z)
            length := 0
            if precision >= 0 {
                if flag_altform2 {
                    // The bytes of the first `precision` characters.
                    k := precision
                    loop k > 0 && sql_byte(z, length) != 0 {
                        k -= 1
                        lead: sql_byte(z, length)
                        length += 1
                        if lead >= 192 {
                            loop sql_byte(z, length).bit_and(192) == 128 -> length += 1
                        }
                    }
                } else {
                    loop length < precision && sql_byte(z, length) != 0 -> length += 1
                }
            } else {
                length = c_len(z)
            }
            loop k in 0..<length -> out.push(z[k])
        } else {
            // %q, %Q and %w.
            q: if xtype == ET_SQLESCAPE3 -> 34 else -> 39
            esc := [U8]{}
            isnull: !args.next_text(esc)
            if isnull -> esc = if xtype == ET_SQLESCAPE2 -> "NULL".bytes() else -> "(NULL)".bytes()
            k := precision
            i := 0
            nq := 0
            loop k != 0 && sql_byte(esc, i) != 0 {
                ch: sql_byte(esc, i)
                if ch == q -> nq += 1
                if flag_altform2 && ch.bit_and(192) == 192 {
                    loop sql_byte(esc, i + 1).bit_and(192) == 128 -> i += 1
                }
                i += 1
                k -= 1
            }
            need_quote: !isnull && xtype == ET_SQLESCAPE2
            if nq + i + 3 > PRINT_BUF_SIZE && !temp_buf_ok(p, nq + i + 3) -> return
            if need_quote -> out.push(U8{q})
            loop j in 0..<i {
                out.push(esc[j])
                if Int.from_u8(esc[j]) == q -> out.push(esc[j])
            }
            if need_quote -> out.push(U8{q})
        }
        // adjust_width_for_utf8: width counts characters under "!".
        if flag_altform2 && width > 0 && (xtype == ET_CHARX || xtype == ET_STRING || xtype == ET_DYNSTRING || xtype == ET_SQLESCAPE || xtype == ET_SQLESCAPE2 || xtype == ET_SQLESCAPE3) {
            loop k in 0..<out.len() {
                if Int.from_u8(out[k]).bit_and(192) == 128 -> width += 1
            }
        }
        width -= out.len()
        if width > 0 {
            if !flag_leftjustify -> str_append_char(p, width, 32)
            str_append(p, out, 0, out.len())
            if flag_leftjustify -> str_append_char(p, width, 32)
        } else {
            str_append(p, out, 0, out.len())
        }
        at += 1
    }
}

// The etDECIMAL/etRADIX/etORDINAL/etPOINTER conversion into out; false
// when the temporary buffer it needs is refused.
render_int: fn<A: PrintfArgs>(p: &StrAccum, args: &A, arg_list: Bool, info: PrintfInfo, xtype: Int, flag_long: Int, flag_prefix: Int, alt_in: Bool, flag_zeropad: Bool, thousand: Int, width: Int, precision_in: Int, out: &[U8]) -> Bool Never! {
    longvalue := 0
    prefix := 0
    if info.flags.bit_and(FLAG_SIGNED) != 0 {
        v := args.int_arg()
        if !arg_list && flag_long == 0 -> v = to_c_int(v)
        if v < 0 {
            longvalue = 0 - v
            prefix = 45
        } else {
            longvalue = v
            prefix = flag_prefix
        }
    } else {
        v: args.int_arg()
        longvalue = if !arg_list && flag_long == 0 -> util.as_u64(v).bit_and(4294967295) else -> util.as_u64(v)
    }
    flag_alternateform := alt_in
    if longvalue == 0 -> flag_alternateform = false
    has_prefix: if prefix != 0 -> 1 else -> 0
    precision := precision_in
    if flag_zeropad && precision < width - has_prefix -> precision = width - has_prefix
    if precision >= PRINT_BUF_SIZE - 10 - PRINT_BUF_SIZE /% 3 {
        n := precision + 10
        if thousand != 0 -> n += precision /% 3
        if !temp_buf_ok(p, n) -> return false
    }
    // The digits, least significant first.
    rev := [U8]{}
    if xtype == ET_ORDINAL {
        ord: "thstndrd".bytes()
        x := longvalue % 10
        if x >= 4 || (longvalue /% 10) % 10 == 1 -> x = 0
        rev.push(ord[x * 2 + 1])
        rev.push(ord[x * 2])
    }
    suffix: rev.len()
    cset: DIGITS.bytes()
    lv := longvalue
    loop {
        rev.push(cset[info.charset + lv % info.radix])
        lv = lv /% info.radix
        if lv <= 0 -> break
    }
    length := rev.len() - suffix
    loop precision > length {
        rev.push(U8{48})
        length += 1
    }
    // aPrefix ("0", "0x", "0X") goes in front of the sign.
    if flag_alternateform && info.prefix != 0 {
        k := info.prefix
        loop PREFIX[k] != 0 -> k += 1
        loop k > info.prefix {
            k -= 1
            out.push(U8{PREFIX[k]})
        }
    }
    if prefix != 0 -> out.push(U8{prefix})
    // The digits most significant first, grouped by three under ",".
    ix := (length - 1) % 3 + 1
    k := rev.len()
    loop k > suffix {
        k -= 1
        out.push(rev[k])
        ix -= 1
        if ix == 0 {
            if thousand != 0 && k > suffix -> out.push(U8{thousand})
            ix = 3
        }
    }
    loop j in 0..<suffix -> out.push(rev[suffix - 1 - j])
    true
}

// The etFLOAT/etEXP/etGENERIC conversion of realvalue into out; false
// when the temporary buffer it needs is refused.
render_float: fn(p: &StrAccum, realvalue: Float, info: PrintfInfo, xtype_in: Int, flag_prefix: Int, flag_alternateform: Bool, flag_altform2: Bool, flag_zeropad: Bool, flag_leftjustify: Bool, thousand: Int, width: Int, precision_in: Int, out: &[U8]) -> Bool Never! {
    precision := precision_in
    if precision < 0 -> precision = 6
    if precision > FP_PRECISION_LIMIT -> precision = FP_PRECISION_LIMIT
    xtype := xtype_in
    iround := precision + 1
    if xtype == ET_FLOAT {
        iround = 0 - precision
    } else if xtype == ET_GENERIC {
        iround = precision
    }
    s := fp_decode(realvalue, iround, if flag_altform2 -> 26 else -> 16)
    if s.is_special != 0 {
        if s.is_special == 2 {
            nan: if flag_zeropad -> "null".bytes() else -> "NaN".bytes()
            loop b in nan -> out.push(b)
            return true
        }
        if flag_zeropad {
            s.z = [U8]{U8{57}}
            s.i_dp = 1000
            s.n = 1
        } else {
            if s.sign == 45 {
                out.push(U8{45})
            } else if flag_prefix != 0 {
                out.push(U8{flag_prefix})
            }
            loop b in "Inf".bytes() -> out.push(b)
            return true
        }
    }
    prefix: if s.sign == 45 -> 45 else -> flag_prefix
    exp := s.i_dp - 1
    if xtype == ET_GENERIC && precision > 0 -> precision -= 1
    flag_rtz := flag_altform2
    if xtype == ET_GENERIC {
        flag_rtz = !flag_alternateform
        if exp < -4 || exp > precision {
            xtype = ET_EXP
        } else {
            precision = precision - exp
            xtype = ET_FLOAT
        }
    }
    e2 := if xtype == ET_EXP -> 0 else -> s.i_dp - 1
    need := (if e2 > 0 -> e2 else -> 0) + precision + width + 15
    if thousand != 0 && e2 > 0 -> need += (e2 + 2) /% 3
    if need > PRINT_BUF_SIZE && !temp_buf_ok(p, need) -> return false
    flag_dp: precision > 0 || flag_alternateform || flag_altform2
    if prefix != 0 -> out.push(U8{prefix})
    // Digits before the decimal point.
    j := 0
    if e2 < 0 {
        out.push(U8{48})
    } else {
        loop e2 >= 0 {
            if j < s.n {
                out.push(s.z[j])
                j += 1
            } else {
                out.push(U8{48})
            }
            if thousand != 0 && e2 % 3 == 0 && e2 > 1 -> out.push(U8{thousand})
            e2 -= 1
        }
    }
    if flag_dp -> out.push(U8{46})
    // Zeros after the point before the first significant digit.
    e2 += 1
    loop e2 < 0 && precision > 0 {
        out.push(U8{48})
        precision -= 1
        e2 += 1
    }
    // Significant digits after the point.
    loop precision > 0 {
        precision -= 1
        if j < s.n {
            out.push(s.z[j])
            j += 1
        } else {
            out.push(U8{48})
        }
    }
    // Trailing zeros, and a "." no digit follows.
    if flag_rtz && flag_dp {
        loop out[out.len() - 1] == (U8{48}) -> _: out.pop()
        if out[out.len() - 1] == (U8{46}) {
            if flag_altform2 {
                out.push(U8{48})
            } else {
                _: out.pop()
            }
        }
    }
    // The "eNNN" suffix.
    if xtype == ET_EXP {
        ex := s.i_dp - 1
        out.push(DIGITS.bytes()[info.charset])
        if ex < 0 {
            out.push(U8{45})
            ex = 0 - ex
        } else {
            out.push(U8{43})
        }
        if ex >= 100 {
            out.push(U8{ex /% 100 + 48})
            ex = ex % 100
        }
        out.push(U8{ex /% 10 + 48})
        out.push(U8{ex % 10 + 48})
    }
    // Zero padding after the sign.
    if flag_zeropad && !flag_leftjustify && out.len() < width {
        pad: width - out.len()
        at: if prefix != 0 -> 1 else -> 0
        loop _k in 0..<pad -> out.push(U8{48})
        k := out.len() - 1
        loop k >= at + pad {
            out[k] = out[k - pad]
            k -= 1
        }
        loop z in at..<(at + pad) -> out[z] = U8{48}
    }
    true
}

// ---------------------------------------------------------------------------
// Entry points.

// sqlite3MPrintf / sqlite3_mprintf: fmt rendered with the given arguments
// under the length limit mx; None on SQLITE_TOOBIG.
mprintf: fn(fmt: [U8], args: [Mem], mx: Int) -> [U8]? Never! {
    acc := str_accum_init(PRINT_BUF_SIZE, mx)
    list := new_mem_list(args)
    str_vappendf(acc, fmt, list)
    if acc.acc_error != 0 -> return None
    acc.text.copy()
}

// sqlite3_snprintf: fmt rendered into an n-byte buffer, so at most n-1
// bytes of it.
snprintf: fn(n: Int, fmt: [U8], args: [Mem]) -> [U8] Never! {
    if n <= 0 -> return [U8]{}
    acc := str_accum_init(n, 0)
    list := new_mem_list(args)
    str_vappendf(acc, fmt, list)
    acc.text.copy()
}

// A UTF-8 text argument.
txt: fn(z: [U8]) -> Mem Never! { base.mem_text(z, base.UTF8) }

// The SQL printf() rendering of fmt over args.
sql_printf_test: fn(fmt: String, args: [Mem]) -> String Never! {
    acc := str_new(MAX_LENGTH)
    acc.printf_flags = PRINTF_SQLFUNC
    list := new_mem_list(args)
    str_vappendf(acc, fmt.bytes(), list)
    String.from_bytes(acc.text) ?? "<bad utf8>"
}

#Test("printf integer conversions match SQLite") {
    i42: base.mem_int(42)
    assert(sql_printf_test("%d|%5d|%-5d|%05d|%+d|% d", [Mem]{i42, i42, i42, i42, i42, i42}) == "42|   42|42   |00042|+42| 42")
    assert(sql_printf_test("%,d|%,d|%,d", [Mem]{base.mem_int(1234567), base.mem_int(-1234567), base.mem_int(999)}) == "1,234,567|-1,234,567|999")
    assert(sql_printf_test("%x|%X|%#x|%#o|%o|%#X", [Mem]{base.mem_int(255), base.mem_int(255), base.mem_int(255), base.mem_int(8), base.mem_int(8), base.mem_int(0)}) == "ff|FF|0xff|010|10|0")
    assert(sql_printf_test("%r %r %r %r %r %r %r", [Mem]{base.mem_int(1), base.mem_int(2), base.mem_int(3), base.mem_int(4), base.mem_int(11), base.mem_int(22), base.mem_int(113)}) == "1st 2nd 3rd 4th 11th 22nd 113th")
    assert(sql_printf_test("%lld|%i|%u", [Mem]{base.mem_int(9223372036854775807), base.mem_int(-9223372036854775808), base.mem_int(-1)}) == "9223372036854775807|-9223372036854775808|18446744073709551615")
    assert(sql_printf_test("%*d|%-*d", [Mem]{base.mem_int(6), base.mem_int(7), base.mem_int(6), base.mem_int(7)}) == "     7|7     ")
    assert(sql_printf_test("%08d|%+05d|%-+6d|%.3d|", [Mem]{base.mem_int(-42), base.mem_int(7), base.mem_int(7), base.mem_int(5)}) == "-0000042|+0007|+7    |005|")
}

#Test("printf floating conversions match SQLite") {
    assert(sql_printf_test("%.3f|%10.2f|%-10.2f|%010.2f", [Mem]{base.mem_real(3.14159), base.mem_real(2.5), base.mem_real(2.5), base.mem_real(-2.5)}) == "3.142|      2.50|2.50      |-000002.50")
    assert(sql_printf_test("%e|%E|%.2e", [Mem]{base.mem_real(12345.678), base.mem_real(0.000123), base.mem_real(1.0e100)}) == "1.234568e+04|1.230000E-04|1.00e+100")
    assert(sql_printf_test("%g|%g|%g|%g|%#g", [Mem]{base.mem_real(100000.0), base.mem_real(1000000.0), base.mem_real(0.0001), base.mem_real(0.00001), base.mem_real(1.5)}) == "100000|1e+06|0.0001|1e-05|1.50000")
    assert(sql_printf_test("%!.15g|%!.20g|%.15g", [Mem]{base.mem_real(0.1), base.mem_real(0.1), base.mem_real(1.0e300)}) == "0.1|0.100000000000000005|1e+300")
    inf: math.INFINITY
    assert(sql_printf_test("%f|%f|%+f|% e", [Mem]{base.mem_real(inf), base.mem_real(0.0 - inf), base.mem_real(inf), base.mem_real(inf)}) == "Inf|-Inf|+Inf| Inf")
    z: sql_printf_test("%05f", [Mem]{base.mem_real(inf)})
    assert(z.len() == 1007 && z.starts_with("90000") && z.ends_with("0.000000"))
    assert(sql_printf_test("%.0g|%.0f|%.0e|%.0f", [Mem]{base.mem_real(2.5), base.mem_real(2.5), base.mem_real(2.5), base.mem_real(0.5)}) == "2|2|3e+00|0")
    assert(sql_printf_test("%,.2f|%,f", [Mem]{base.mem_real(1234567.891), base.mem_real(999.5)}) == "1,234,567.89|999.500000")
    third: Float{1} / Float{3}
    assert(sql_printf_test("%.20f|%.30e|%!.30e", [Mem]{base.mem_real(0.1), base.mem_real(third), base.mem_real(third)}) == "0.10000000000000000000|3.333333333333333000000000000000e-01|3.33333333333333314e-01")
    assert(sql_printf_test("%.*f|%*.*f", [Mem]{base.mem_int(2), base.mem_real(3.14159), base.mem_int(8), base.mem_int(3), base.mem_real(2.71828)}) == "3.14|   2.718")
    assert(sql_printf_test("%#.0f|%#.3g|%!.3g|%!g", [Mem]{base.mem_real(3.0), base.mem_real(1.0), base.mem_real(100.0), base.mem_real(1.0e20)}) == "3.|1.00|100.0|1.0e+20")
    assert(sql_printf_test("%g|%g|%g|%G", [Mem]{base.mem_real(123456789.0), base.mem_real(0.00001), base.mem_real(0.0), base.mem_real(1.5e-10)}) == "1.23457e+08|1e-05|0|1.5E-10")
}

#Test("printf text conversions match SQLite") {
    assert(sql_printf_test("%s|%.2s|%5s|%-5s|", [Mem]{txt("hello".bytes()), txt("hello".bytes()), txt("ab".bytes()), txt("ab".bytes())}) == "hello|he|   ab|ab   |")
    assert(sql_printf_test("%q|%Q|%Q|%w", [Mem]{txt("it's".bytes()), txt("it's".bytes()), base.mem_null(), txt("a\"b".bytes())}) == "it''s|'it''s'|NULL|a\"\"b")
    assert(sql_printf_test("%c|%.3c|%5c|%-3c|", [Mem]{txt("xyz".bytes()), txt("ab".bytes()), txt("q".bytes()), txt("r".bytes())}) == "x|aaa|    q|r  |")
    assert(sql_printf_test("%z|%%|%n|%", [Mem]{txt("dyn".bytes())}) == "dyn|%||%")
    assert(sql_printf_test("%!s|%!.2s|%!5s|%!.1q", [Mem]{txt("é€x".bytes()), txt("é€x".bytes()), txt("é".bytes()), txt("é'".bytes())}) == "é€x|é€|    é|é")
    assert(sql_printf_test("a%Tb", [Mem]{base.mem_int(1)}) == "a")
    assert(sql_printf_test("a%yb", [Mem]{base.mem_int(1)}) == "a")
    assert(sql_printf_test("%5.2s|%-8.3q|", [Mem]{txt("abcdef".bytes()), txt("x'y'z".bytes())}) == "   ab|x''y    |")
    assert(sql_printf_test("%.5c", [Mem]{txt("é".bytes())}) == "ééééé")
}

#Test("a fixed buffer truncates and the limit is SQLITE_TOOBIG") {
    assert(snprintf(6, "%s".bytes(), [Mem]{txt("abcdefgh".bytes())}) == "abcde".bytes())
    acc := str_new(10)
    str_append_all(acc, "0123456789".bytes())
    assert(acc.acc_error == base.TOOBIG && acc.text.len() == 0)
    assert(mprintf("%.2000000000d".bytes(), [Mem]{base.mem_int(1)}, MAX_LENGTH) == None)
}
