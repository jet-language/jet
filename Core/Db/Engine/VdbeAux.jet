// The virtual machine's support routines, a port of SQLite 3.45.0
// vdbeaux.c: building a program (sqlite3VdbeAddOp* and the operand
// setters), the EXPLAIN listing, readying, halting, resetting and deleting
// a statement, and the transaction ends a halt drives. With them are the
// pieces of main.c (sqlite3RollbackAll, sqlite3CloseSavepoints), util.c
// (sqlite3Error, sqlite3ErrorWithMsg, sqlite3SystemError), build.c
// (sqlite3CommitInternalChanges), malloc.c (sqlite3OomFault,
// sqlite3OomClear, sqlite3ApiExit) and vtab.c
// (the xSync, xCommit, xRollback, xBegin and xSavepoint fan-out) that they
// call.
//
// The build options are those of VendoredC.jet: no SQLITE_DEBUG, no
// SQLITE_ENABLE_STMT_SCANSTATUS, no SQLITE_ENABLE_EXPLAIN_COMMENTS (the
// EXPLAIN comment column is NULL), no SQLITE_ENABLE_CURSOR_HINTS, no shared
// cache (sqlite3VdbeEnter and sqlite3VdbeLeave do nothing) and no
// unlock-notify.
//
// What C reaches through function pointers (virtual table modules and the
// commit and rollback hooks) the VM reaches through a Host. A statement is
// built and run beside the connection (conn.vdbe_take), so the functions
// here take the connection and the statement apart.

use {
    base: __core_db_base
    util: __core_db_util
    record: __core_db_record
    btree: __core_db_btree
    pager: __core_db_pager
    file: __core_db_file
    os: __core_db_os
    ast: __core_db_ast
    conn: __core_db_conn
    opc: __core_db_opcodes
    mem: __core_db_mem
    printf: __core_db_printf
    rowset: __core_db_rowset
}

// ---------------------------------------------------------------------------
// The Host.

// The sqlite3_module methods the VM calls by name.
VT_SYNC: 0
VT_COMMIT: 1
VT_ROLLBACK: 2
VT_BEGIN: 3
VT_SAVEPOINT: 4
VT_RELEASE: 5
VT_ROLLBACK_TO: 6
VT_DISCONNECT: 7

// The callbacks of the connection: its functions, virtual table modules,
// hooks and the parts of the library above the VM (sqlite3_exec, the
// schema loader, ANALYZE, VACUUM). A VTable is named by its Conn.vtables
// slot, whose vtab is the Host's handle for the sqlite3_vtab instance; a
// virtual table cursor is the Host's handle for its sqlite3_vtab_cursor.
// Error messages come back through `err` (None for none).
Host: trait {
    // Whether the module of VTable vt has method `method` (VT_*): its
    // pointer is not NULL.
    vtab_has: fn(&self, db: conn.Conn, vt: Int, method: Int) -[]> Bool Never!
    // sqlite3_module.iVersion of VTable vt's module.
    vtab_version: fn(&self, db: conn.Conn, vt: Int) -[]> Int Never!
    // Call method `method` of VTable vt's instance; arg is the savepoint
    // of VT_SAVEPOINT, VT_RELEASE and VT_ROLLBACK_TO. Its result code.
    vtab_call: fn(&self, db: &conn.Conn, vt: Int, method: Int, arg: Int) -[DB]> Int Never!
    // xClose of the Host's virtual table cursor `cursor` on VTable vt.
    vtab_close: fn(&self, db: &conn.Conn, vt: Int, cursor: Int) Never! -[DB]>
    // Take sqlite3_vtab.zErrMsg of VTable vt's instance; None when unset.
    // (No `Never!`: a generic call of a trait method returning `T? Never!`
    // loses the optional in the backend.)
    vtab_take_errmsg: fn(&self, db: conn.Conn, vt: Int) -[]> [U8]?
    // xOpen on VTable vt: cursor gets the new cursor's handle.
    vtab_open: fn(&self, db: &conn.Conn, vt: Int, cursor: &Int) -[DB]> Int Never!
    // xFilter of `cursor` with idxNum, idxStr and the argc values in the
    // registers from Vdbe.mem index arg.
    vtab_filter: fn(&self, db: &conn.Conn, v: &conn.Vdbe, cursor: Int, idx_num: Int, idx_str: [U8]?, arg: Int, argc: Int) -[DB]> Int Never!
    // xEof of `cursor`.
    vtab_eof: fn(&self, db: &conn.Conn, cursor: Int) -[DB]> Bool Never!
    // xNext of `cursor`.
    vtab_next: fn(&self, db: &conn.Conn, cursor: Int) -[DB]> Int Never!
    // xColumn of `cursor` for column col, the result going to the context
    // Vdbe.fctx (its out register).
    vtab_column: fn(&self, db: &conn.Conn, v: &conn.Vdbe, cursor: Int, col: Int) -[DB]> Int Never!
    // xRowid of `cursor`.
    vtab_rowid: fn(&self, db: &conn.Conn, cursor: Int, rowid: &Int) -[DB]> Int Never!
    // xUpdate of VTable vt with the argc values in the registers from
    // Vdbe.mem index arg; rowid gets an inserted row's rowid.
    vtab_update: fn(&self, db: &conn.Conn, v: &conn.Vdbe, vt: Int, arg: Int, argc: Int, rowid: &Int) -[DB]> Int Never!
    // xRename of VTable vt.
    vtab_rename: fn(&self, db: &conn.Conn, vt: Int, name: [U8]) -[DB]> Int Never!
    // xIntegrity of VTable vt, for table `table` of schema `schema`.
    vtab_integrity: fn(&self, db: &conn.Conn, vt: Int, schema: [U8], table: [U8], flags: Int, err: &[U8]?) -[DB]> Int Never!
    // sqlite3VtabCallCreate: create the virtual table `name` of database
    // i_db.
    vtab_call_create: fn(&self, db: &conn.Conn, i_db: Int, name: [U8], err: &[U8]?) -[DB]> Int Never!
    // sqlite3VtabCallDestroy: destroy the virtual table `name` of database
    // i_db.
    vtab_call_destroy: fn(&self, db: &conn.Conn, i_db: Int, name: [U8]) -[DB]> Int Never!
    // Call method `method` (FN_*) of the function of the context Vdbe.fctx.
    func_call: fn(&self, db: &conn.Conn, v: &conn.Vdbe, method: Int) Never! -[DB]>
    // The commit hook's answer, nonzero to turn the commit into a
    // rollback; 0 when no hook is set.
    commit_hook: fn(&self, db: &conn.Conn) -[DB]> Int Never!
    // Call the rollback hook, if one is set.
    rollback_hook: fn(&self, db: &conn.Conn) Never! -[DB]>
    // Whether an update hook is set (db->xUpdateCallback).
    has_update_hook: fn(&self, db: conn.Conn) -[]> Bool Never!
    // The update hook for operation op (SQLITE_INSERT, SQLITE_DELETE,
    // SQLITE_UPDATE) on row rowid of table `table` in database db_name.
    update_hook: fn(&self, db: &conn.Conn, op: Int, db_name: [U8], table: [U8], rowid: Int) Never! -[DB]>
    // The progress handler: true to interrupt (only called while
    // Conn.n_progress_ops is set).
    progress: fn(&self, db: &conn.Conn) -[DB]> Bool Never!
    // The trace callback for `event` (conn.TRACE_STMT with the statement's
    // text, conn.TRACE_ROW), called while Conn.m_trace has the event.
    trace: fn(&self, db: &conn.Conn, v: conn.Vdbe, event: Int, text: [U8]) Never! -[DB]>
    // The profile callbacks (sqlite3_profile's xProfile with
    // conn.TRACE_XPROFILE, the trace callback's conn.TRACE_PROFILE) for a
    // statement that ran elapsed_ns nanoseconds.
    profile: fn(&self, db: &conn.Conn, v: conn.Vdbe, elapsed_ns: Int) Never! -[DB]>
    // The sqlite3_wal_hook callback (Conn.wal_hook is conn.WAL_HOOK_USER)
    // after a commit left n_frame frames in database db_name's log.
    wal_hook: fn(&self, db: &conn.Conn, db_name: [U8], n_frame: Int) -[DB]> Int Never!
    // sqlite3_exec of sql (OP_SqlExec), with the authorizer and the trace
    // callback off when `quiet`.
    sql_exec: fn(&self, db: &conn.Conn, sql: [U8], quiet: Bool, err: &[U8]?) -[DB]> Int Never!
    // sqlite3InitOne: read the schema of database i_db.
    init_one: fn(&self, db: &conn.Conn, i_db: Int, flags: Int, err: &[U8]?) -[DB]> Int Never!
    // OP_ParseSchema's reparse: the schema rows of database i_db that
    // match `where`, through sqlite3InitCallback, with db->init.busy set;
    // SQLITE_CORRUPT when no row matches.
    parse_schema: fn(&self, db: &conn.Conn, i_db: Int, where: [U8], err: &[U8]?) -[DB]> Int Never!
    // sqlite3AnalysisLoad of database i_db.
    load_analysis: fn(&self, db: &conn.Conn, i_db: Int) -[DB]> Int Never!
    // sqlite3RunVacuum of database i_db, into the file named by `into`
    // when set.
    run_vacuum: fn(&self, db: &conn.Conn, i_db: Int, into: base.Mem?, err: &[U8]?) -[DB]> Int Never!
    // sqlite3Reprepare: compile v's SQL again (after SQLITE_SCHEMA or an
    // EXPLAIN mode change) and move the new program, with v's bindings,
    // into v; the connection's error on failure.
    reprepare: fn(&self, db: &conn.Conn, v: &conn.Vdbe) -[DB]> Int Never!
}

// The methods of a function call (Host.func_call): xSFunc, xStep,
// xInverse, xFinal and xValue.
FN_SFUNC: 0
FN_STEP: 1
FN_INVERSE: 2
FN_FINAL: 3
FN_VALUE: 4

// ---------------------------------------------------------------------------
// Connection errors (util.c, malloc.c).

// sqlite3OomFault: the connection ran out of memory (here: a program grew
// past SQLITE_LIMIT_VDBE_OP). A running statement is interrupted; the
// prepare in progress reports SQLITE_NOMEM.
oom_fault: fn(db: &conn.Conn) Never! {
    if db.malloc_failed -> return
    db.malloc_failed = true
    if db.n_vdbe_exec > 0 {
        db.is_interrupted = true
        conn.sync_btrees(db)
    }
}

// sqlite3OomClear: the fault ends once no statement is running.
oom_clear: fn(db: &conn.Conn) Never! {
    if db.malloc_failed && db.n_vdbe_exec == 0 {
        db.malloc_failed = false
        db.is_interrupted = false
        conn.sync_btrees(db)
    }
}

// sqlite3ApiExit: the code an API routine returns for rc, masked by the
// connection's errMask; after a memory fault, SQLITE_NOMEM.
api_exit: fn(db: &conn.Conn, rc: Int) -> Int Never! {
    if !db.malloc_failed && rc == base.OK -> return base.OK
    if db.malloc_failed || rc == base.IOERR_NOMEM {
        oom_clear(db)
        sql_error(db, base.NOMEM)
        return base.NOMEM
    }
    rc.bit_and(db.err_mask)
}

// sqlite3SystemError: record the OS error behind an I/O or open failure
// (sqlite3OsGetLastError), here the last failed system call on a database
// or journal file of the connection.
system_error: fn(db: &conn.Conn, rc: Int) Never! {
    if rc == base.IOERR_NOMEM -> return
    primary: rc.bit_and(255)
    if primary != base.CANTOPEN && primary != base.IOERR -> return
    loop b in 0..<db.btrees.len() {
        e: os.os_last_errno(db.btrees[b].pager.fd.os)
        if e != 0 {
            db.i_sys_errno = e
            return
        }
        ej: os.os_last_errno(db.btrees[b].pager.jfd.os)
        if ej != 0 {
            db.i_sys_errno = ej
            return
        }
    }
}

// sqlite3Error: set the connection's error code; the message becomes NULL.
sql_error: fn(db: &conn.Conn, code: Int) Never! {
    db.err_code = code
    if code != base.OK || db.has_err_msg {
        if db.has_err_msg -> db.err_msg = None
        system_error(db, code)
    }
    db.err_byte_offset = -1
}

// sqlite3ErrorWithMsg: set the connection's error code and message.
error_with_msg: fn(db: &conn.Conn, code: Int, msg: [U8]) Never! {
    db.err_code = code
    system_error(db, code)
    db.err_msg = Val(msg)
    db.has_err_msg = true
}

// sqlite3VdbeError: the statement's error message.
vdbe_error: fn(v: &conn.Vdbe, msg: [U8]) Never! { v.err_msg = Val(msg) }

// ---------------------------------------------------------------------------
// Transactions (main.c, build.c, vtab.c).

// sqlite3CloseSavepoints.
close_savepoints: fn(db: &conn.Conn) Never! {
    db.savepoints = [conn.Savepoint]{}
    db.n_savepoint = 0
    db.n_statement = 0
    db.is_transaction_savepoint = 0
    conn.sync_btrees(db)
}

// sqlite3CommitInternalChanges.
commit_internal_changes: fn(db: &conn.Conn) Never! {
    db.m_db_flags = util.clear_bits(db.m_db_flags, conn.DBFLAG_SCHEMA_CHANGE)
}

// sqlite3RollbackAll: roll back every database's transaction, tripping
// open cursors with trip_code.
rollback_all: fn<H: Host>(h: &H, db: &conn.Conn, trip_code: Int) Never! -[DB]> {
    conn.sync_btrees(db)
    schema_change: db.m_db_flags.bit_and(conn.DBFLAG_SCHEMA_CHANGE) != 0 && !db.init.busy
    in_trans := false
    loop i in 0..<db.dbs.len() {
        b: db.dbs[i].bt
        if b < 0 -> next
        if btree.btree_txn_state(db.btrees[b]) == btree.TRANS_WRITE -> in_trans = true
        _: btree.btree_rollback(db.btrees[b], trip_code, !schema_change)
    }
    vtab_rollback<H>(h, db)
    if schema_change {
        conn.expire_prepared_statements(db, 0)
        conn.reset_all_schemas(db)
    }
    db.n_deferred_cons = 0
    db.n_deferred_imm_cons = 0
    db.flags = util.clear_bits(db.flags, conn.SQLITE_DEFER_FKS.bit_or(conn.SQLITE_CORRUPT_RD_ONLY))
    conn.sync_btrees(db)
    if in_trans || !db.auto_commit -> h.rollback_hook(db)
}

// sqlite3VtabImportErrmsg: move VTable vt's error message to the statement.
vtab_import_errmsg: fn<H: Host>(h: &H, db: conn.Conn, v: &conn.Vdbe, vt: Int) Never! {
    if h.vtab_take_errmsg(db, vt) == .Val(msg) -> v.err_msg = Val(msg)
}

// Disconnect the VTables whose last reference went (C's sqlite3VtabUnlock
// does at once) and free their slots.
vtab_reap: fn<H: Host>(h: &H, db: &conn.Conn) Never! -[DB]> {
    i := 0
    loop i < db.vtab_dead.len() {
        vt: db.vtab_dead[i]
        if db.vtables[vt].vtab >= 0 -> _: h.vtab_call(db, vt, VT_DISCONNECT, 0)
        conn.vtable_release(db, vt)
        i += 1
    }
    db.vtab_dead = [Int]{}
}

// callFinaliser: call xCommit or xRollback on every VTable of the
// transaction and empty it.
vtab_finish: fn<H: Host>(h: &H, db: &conn.Conn, method: Int) Never! -[DB]> {
    trans: db.v_trans.copy()
    db.v_trans = [Int]{}
    loop vt in trans {
        if db.vtables[vt].vtab >= 0 && h.vtab_has(db, vt, method) -> _: h.vtab_call(db, vt, method, 0)
        db.vtables[vt].i_savepoint = 0
        conn.vtab_unlock(db, vt)
    }
    vtab_reap<H>(h, db)
}

// sqlite3VtabRollback.
vtab_rollback: fn<H: Host>(h: &H, db: &conn.Conn) Never! -[DB]> { vtab_finish<H>(h, db, VT_ROLLBACK) }

// sqlite3VtabCommit.
vtab_commit: fn<H: Host>(h: &H, db: &conn.Conn) Never! -[DB]> { vtab_finish<H>(h, db, VT_COMMIT) }

// sqlite3VtabSync: xSync every VTable of the transaction until one fails.
// While the calls run the transaction is in sync (sqlite3VtabInSync).
vtab_sync: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe) -[DB]> Int Never! {
    rc := base.OK
    trans: db.v_trans.copy()
    db.vtab_in_sync = trans.len() > 0
    loop vt in trans {
        if rc != base.OK -> break
        if db.vtables[vt].vtab >= 0 && h.vtab_has(db, vt, VT_SYNC) {
            rc = h.vtab_call(db, vt, VT_SYNC, 0)
            vtab_import_errmsg<H>(h, db, v, vt)
        }
    }
    db.vtab_in_sync = false
    rc
}

// sqlite3VtabBegin: add VTable vt (-1 for none) to the transaction with
// xBegin, opening the savepoints already open on it.
vtab_begin: fn<H: Host>(h: &H, db: &conn.Conn, vt: Int) -[DB]> Int Never! {
    if db.vtab_in_sync -> return base.LOCKED
    if vt < 0 || !h.vtab_has(db, vt, VT_BEGIN) -> return base.OK
    loop t in db.v_trans {
        if t == vt -> return base.OK
    }
    rc := h.vtab_call(db, vt, VT_BEGIN, 0)
    if rc != base.OK -> return rc
    i_svpt: db.n_statement + db.n_savepoint
    db.v_trans.push(vt)
    conn.vtab_lock(db, vt)
    if i_svpt != 0 && h.vtab_has(db, vt, VT_SAVEPOINT) {
        db.vtables[vt].i_savepoint = i_svpt
        rc = h.vtab_call(db, vt, VT_SAVEPOINT, i_svpt - 1)
    }
    rc
}

// sqlite3VtabSavepoint: open (SAVEPOINT_BEGIN), roll back to or release
// savepoint i_savepoint on every VTable of the transaction.
vtab_savepoint: fn<H: Host>(h: &H, db: &conn.Conn, op: Int, i_savepoint: Int) -[DB]> Int Never! {
    rc := base.OK
    if db.vtab_in_sync -> return rc
    trans: db.v_trans.copy()
    loop vt in trans {
        if rc != base.OK -> break
        if db.vtables[vt].vtab < 0 || h.vtab_version(db, vt) < 2 -> next
        conn.vtab_lock(db, vt)
        method := VT_RELEASE
        if op == base.SAVEPOINT_BEGIN {
            method = VT_SAVEPOINT
            db.vtables[vt].i_savepoint = i_savepoint + 1
        } else if op == base.SAVEPOINT_ROLLBACK {
            method = VT_ROLLBACK_TO
        }
        if h.vtab_has(db, vt, method) && db.vtables[vt].i_savepoint > i_savepoint {
            saved: db.flags.bit_and(btree.SQLITE_DEFENSIVE)
            db.flags = util.clear_bits(db.flags, btree.SQLITE_DEFENSIVE)
            conn.sync_btrees(db)
            rc = h.vtab_call(db, vt, method, i_savepoint)
            db.flags = db.flags.bit_or(saved)
            conn.sync_btrees(db)
        }
        conn.vtab_unlock(db, vt)
    }
    vtab_reap<H>(h, db)
    rc
}

// ---------------------------------------------------------------------------
// Building a program.

// sqlite3VdbeCreate: a new statement holding OP_Init, out of its slot for
// the build (conn.vdbe_put returns it).
vdbe_create: fn(db: &conn.Conn) -> conn.Vdbe Never! {
    s: conn.vdbe_alloc(db)
    v := conn.vdbe_take(db, s)
    v.state = conn.VDBE_INIT_STATE
    _: add_op2(db, v, opc.OP_INIT, 0, 1)
    v
}

// sqlite3VdbeSetSql.
set_sql: fn(v: &conn.Vdbe, z: [U8], prep_flags: Int) Never! {
    v.prep_flags = prep_flags
    if prep_flags.bit_and(conn.PREPARE_SAVESQL) == 0 -> v.expmask = 0
    v.sql = z
}

// growOpArray: double the op capacity (1024 bytes' worth to start), within
// SQLITE_LIMIT_VDBE_OP. false when the limit stops it.
grow_op_array: fn(db: &conn.Conn, v: &conn.Vdbe) -> Bool Never! {
    n_new: if v.n_op_alloc > 0 -> 2 * v.n_op_alloc else -> 42
    if n_new > db.limits[ast.LIMIT_VDBE_OP] {
        oom_fault(db)
        return false
    }
    v.n_op_alloc = n_new
    true
}

// sqlite3VdbeAddOp3: the new op's address (1 when the program cannot grow).
add_op3: fn(db: &conn.Conn, v: &conn.Vdbe, opcode: Int, p1: Int, p2: Int, p3: Int) -> Int Never! {
    i: v.ops.len()
    if v.n_op_alloc <= i && !grow_op_array(db, v) -> return 1
    v.ops.push(conn.VdbeOp{opcode: opcode, p1: p1, p2: p2, p3: p3, p4: conn.P4.NotUsed, p5: 0})
    i
}

// sqlite3VdbeAddOp0.
add_op0: fn(db: &conn.Conn, v: &conn.Vdbe, opcode: Int) -> Int Never! { add_op3(db, v, opcode, 0, 0, 0) }

// sqlite3VdbeAddOp1.
add_op1: fn(db: &conn.Conn, v: &conn.Vdbe, opcode: Int, p1: Int) -> Int Never! { add_op3(db, v, opcode, p1, 0, 0) }

// sqlite3VdbeAddOp2.
add_op2: fn(db: &conn.Conn, v: &conn.Vdbe, opcode: Int, p1: Int, p2: Int) -> Int Never! { add_op3(db, v, opcode, p1, p2, 0) }

// sqlite3VdbeGoto.
add_goto: fn(db: &conn.Conn, v: &conn.Vdbe, dest: Int) -> Int Never! { add_op3(db, v, opc.OP_GOTO, 0, dest, 0) }

// sqlite3VdbeAddOp4 (and sqlite3VdbeAddOp4Dup8 with an Int64 or Real P4).
add_op4: fn(db: &conn.Conn, v: &conn.Vdbe, opcode: Int, p1: Int, p2: Int, p3: Int, p4: conn.P4) -> Int Never! {
    addr: add_op3(db, v, opcode, p1, p2, p3)
    change_p4(db, v, addr, p4)
    addr
}

// sqlite3VdbeAddOp4Int.
add_op4_int: fn(db: &conn.Conn, v: &conn.Vdbe, opcode: Int, p1: Int, p2: Int, p3: Int, p4: Int) -> Int Never! {
    addr: add_op3(db, v, opcode, p1, p2, p3)
    if !db.malloc_failed -> v.ops[addr].p4 = conn.P4.Int32(p4)
    addr
}

// sqlite3VdbeLoadString: OP_String8 of z into register dest.
load_string: fn(db: &conn.Conn, v: &conn.Vdbe, dest: Int, z: [U8]) -> Int Never! {
    add_op4(db, v, opc.OP_STRING8, 0, dest, 0, conn.P4.Text(z))
}

// sqlite3VdbeMultiLoad: load vals (texts, integers and NULLs) into
// registers dest.., then with result_row emit them as a row.
multi_load: fn(db: &conn.Conn, v: &conn.Vdbe, dest: Int, vals: [base.Mem], result_row: Bool) Never! {
    loop i in 0..<vals.len() {
        m: vals[i]
        if m.flags.bit_and(base.MEM_INT) != 0 {
            _: add_op2(db, v, opc.OP_INTEGER, m.i, dest + i)
        } else if m.flags.bit_and(base.MEM_STR) != 0 {
            _: load_string(db, v, dest + i, m.z)
        } else {
            _: add_op3(db, v, opc.OP_NULL, 0, dest + i, 0)
        }
    }
    if result_row -> _: add_op2(db, v, opc.OP_RESULT_ROW, dest, vals.len())
}

// One op of an op list (struct VdbeOpList).
VdbeOpList: struct {
    opcode: Int
    p1: Int
    p2: Int
    p3: Int
}

// sqlite3VdbeAddOpList: append the ops of list, a jump's positive P2
// counting from the first; the first one's address, -1 when the program
// cannot grow.
add_op_list: fn(db: &conn.Conn, v: &conn.Vdbe, list: [VdbeOpList]) -> Int Never! {
    if v.ops.len() + list.len() > v.n_op_alloc && !grow_op_array(db, v) -> return -1
    first: v.ops.len()
    loop o in list {
        p2 := o.p2
        if o.p2 > 0 && opc.OP_PROPERTIES[o.opcode].bit_and(opc.OPFLG_JUMP) != 0 -> p2 += first
        v.ops.push(conn.VdbeOp{opcode: o.opcode, p1: o.p1, p2: p2, p3: o.p3, p4: conn.P4.NotUsed, p5: 0})
    }
    first
}

// sqlite3VdbeMakeLabel: a new unresolved label (negative).
make_label: fn(v: &conn.Vdbe) -> Int Never! {
    v.n_label -= 1
    v.n_label
}

// sqlite3VdbeResolveLabel: label x is the address of the next op. true
// when the label table grew past another hundred entries, the point where
// C calls sqlite3ProgressCheck.
resolve_label: fn(v: &conn.Vdbe, x: Int) -> Bool Never! {
    j: -1 - x
    if v.n_label_alloc + v.n_label >= 0 {
        v.labels[j] = v.ops.len()
        return false
    }
    n_new: 10 - v.n_label
    loop v.labels.len() < n_new -> v.labels.push(-1)
    due: n_new >= 100 && n_new / 100 > v.n_label_alloc / 100
    v.n_label_alloc = n_new
    v.labels[j] = v.ops.len()
    due
}

// sqlite3VdbeRunOnlyOnce.
run_only_once: fn(db: &conn.Conn, v: &conn.Vdbe) Never! { _: add_op2(db, v, opc.OP_EXPIRE, 1, 1) }

// sqlite3VdbeReusable: undo run_only_once.
reusable: fn(v: &conn.Vdbe) Never! {
    loop i in 1..<v.ops.len() {
        if v.ops[i].opcode == opc.OP_EXPIRE {
            v.ops[1].opcode = opc.OP_NOOP
            break
        }
    }
}

// resolveP2Values: resolve the labels in jump P2s, settle readOnly and
// bIsReader, and raise max_args to the most arguments an OP_VUpdate or
// OP_VFilter passes. Frees the label table.
resolve_p2_values: fn(v: &conn.Vdbe, max_args: &Int) Never! {
    v.read_only = true
    v.is_reader = false
    i := v.ops.len() - 1
    loop i >= 0 {
        o: v.ops[i].opcode
        if o <= opc.MX_JUMP_OPCODE {
            if o == {
                opc.OP_TRANSACTION -> {
                    if v.ops[i].p2 != 0 -> v.read_only = false
                    v.is_reader = true
                }
                opc.OP_AUTO_COMMIT | opc.OP_SAVEPOINT -> v.is_reader = true
                opc.OP_CHECKPOINT | opc.OP_VACUUM | opc.OP_JOURNAL_MODE -> {
                    v.read_only = false
                    v.is_reader = true
                }
                opc.OP_VUPDATE -> {
                    if v.ops[i].p2 > max_args -> max_args = v.ops[i].p2
                }
                else -> {
                    if o == opc.OP_VFILTER && v.ops[i - 1].p1 > max_args -> max_args = v.ops[i - 1].p1
                    if v.ops[i].p2 < 0 -> v.ops[i].p2 = v.labels[-1 - v.ops[i].p2]
                }
            }
        }
        if o == opc.OP_INIT -> break
        i -= 1
    }
    v.labels = [Int]{}
    v.n_label = 0
    v.n_label_alloc = 0
}

// sqlite3VdbeCurrentAddr.
current_addr: fn(v: conn.Vdbe) -> Int Never! { v.ops.len() }

// sqlite3VdbeTakeOpArray: the finished ops of a trigger program's
// statement, which is then freed (C deletes the sub-parse's Vdbe).
take_op_array: fn(db: &conn.Conn, v: &&conn.Vdbe, max_args: &Int) -> [conn.VdbeOp] Never! {
    w := v
    resolve_p2_values(w, max_args)
    conn.vdbe_release(db, w.slot)
    w.ops.move()
}

// sqlite3VdbeLinkSubProgram: add a trigger program; its Vdbe.programs
// index, the P4 of the OP_Program that runs it.
link_sub_program: fn(v: &conn.Vdbe, p: &&conn.SubProgram) -> Int Never! {
    v.programs.push(p)
    v.programs.len() - 1
}

// sqlite3VdbeHasSubProgram.
has_sub_program: fn(v: conn.Vdbe) -> Bool Never! { v.programs.len() > 0 }

// sqlite3VdbeGetOp / sqlite3VdbeGetLastOp: a copy of op addr (-1 for the
// last), a zeroed op after a malloc failure.
op_at: fn(db: conn.Conn, v: conn.Vdbe, addr: Int) -> conn.VdbeOp Never! {
    a: if addr < 0 -> v.ops.len() - 1 else -> addr
    if db.malloc_failed || a < 0 -> return conn.VdbeOp{opcode: 0, p1: 0, p2: 0, p3: 0, p4: conn.P4.NotUsed, p5: 0}
    v.ops[a]
}

// sqlite3VdbeChangeOpcode.
change_opcode: fn(db: conn.Conn, v: &conn.Vdbe, addr: Int, opcode: Int) Never! {
    if !db.malloc_failed -> v.ops[addr].opcode = opcode
}

// sqlite3VdbeChangeP1.
change_p1: fn(db: conn.Conn, v: &conn.Vdbe, addr: Int, val: Int) Never! {
    if !db.malloc_failed -> v.ops[addr].p1 = val
}

// sqlite3VdbeChangeP2.
change_p2: fn(db: conn.Conn, v: &conn.Vdbe, addr: Int, val: Int) Never! {
    if !db.malloc_failed -> v.ops[addr].p2 = val
}

// sqlite3VdbeChangeP3.
change_p3: fn(db: conn.Conn, v: &conn.Vdbe, addr: Int, val: Int) Never! {
    if !db.malloc_failed -> v.ops[addr].p3 = val
}

// sqlite3VdbeChangeP5: of the last op.
change_p5: fn(v: &conn.Vdbe, p5: Int) Never! {
    n: v.ops.len()
    if n > 0 -> v.ops[n - 1].p5 = p5
}

// sqlite3VdbeTypeofColumn: the OP_Column just added into dest feeds
// typeof() (OPFLAG_TYPEOFARG).
typeof_column: fn(db: conn.Conn, v: &conn.Vdbe, dest: Int) Never! {
    n: v.ops.len()
    if db.malloc_failed || n == 0 -> return
    if v.ops[n - 1].p3 == dest && v.ops[n - 1].opcode == opc.OP_COLUMN {
        v.ops[n - 1].p5 = v.ops[n - 1].p5.bit_or(conn.OPFLAG_TYPEOFARG)
    }
}

// sqlite3VdbeJumpHere: the jump at addr goes to the next op.
jump_here: fn(db: conn.Conn, v: &conn.Vdbe, addr: Int) Never! { change_p2(db, v, addr, v.ops.len()) }

// sqlite3VdbeJumpHereOrPopInst: as jump_here, but a jump that is the last
// op is dropped instead.
jump_here_or_pop_inst: fn(db: conn.Conn, v: &conn.Vdbe, addr: Int) Never! {
    if addr == v.ops.len() - 1 {
        _: v.ops.pop()
    } else {
        change_p2(db, v, addr, v.ops.len())
    }
}

// freeP4: drop the reference a P4 holds.
free_p4: fn(db: &conn.Conn, p4: conn.P4) Never! {
    if p4 == .Vtab(vt) {
        conn.vtab_unlock(db, vt)
    } else if p4 == .TableRef(t) {
        conn.delete_table(db, t)
    }
}

// sqlite3VdbeChangeP4: the P4 of op addr (-1 for the last). A VTable
// gains a reference; after a malloc failure the value is dropped. A P4
// already set is replaced without being freed, as in C.
change_p4: fn(db: &conn.Conn, v: &conn.Vdbe, addr: Int, p4: conn.P4) Never! {
    if db.malloc_failed {
        if p4 == .TableRef(t) -> conn.delete_table(db, t)
        return
    }
    a: if addr < 0 -> v.ops.len() - 1 else -> addr
    if p4 == .Vtab(vt) -> conn.vtab_lock(db, vt)
    v.ops[a].p4 = p4
}

// sqlite3VdbeAppendP4: the P4 of the last op, taking the caller's
// reference.
append_p4: fn(db: &conn.Conn, v: &conn.Vdbe, p4: conn.P4) Never! {
    if db.malloc_failed {
        free_p4(db, p4)
        return
    }
    v.ops[v.ops.len() - 1].p4 = p4
}

// sqlite3VdbeChangeToNoop.
change_to_noop: fn(db: &conn.Conn, v: &conn.Vdbe, addr: Int) -> Bool Never! {
    if db.malloc_failed -> return false
    free_p4(db, v.ops[addr].p4)
    v.ops[addr].p4 = conn.P4.NotUsed
    v.ops[addr].opcode = opc.OP_NOOP
    true
}

// sqlite3VdbeDeletePriorOpcode: turn the last op into a no-op if it is an
// `opcode`.
delete_prior_opcode: fn(db: &conn.Conn, v: &conn.Vdbe, opcode: Int) -> Bool Never! {
    n: v.ops.len()
    if n > 0 && v.ops[n - 1].opcode == opcode -> return change_to_noop(db, v, n - 1)
    false
}

// sqlite3VdbeUsesBtree.
uses_btree: fn(v: &conn.Vdbe, i: Int) Never! { v.btree_mask = v.btree_mask.bit_or(1 << i) }

// sqlite3VdbeCountChanges.
count_changes: fn(v: &conn.Vdbe) Never! { v.change_cnt_on = true }

// sqlite3VdbeSetVarmask: a change to parameter i_var re-prepares the
// statement.
set_varmask: fn(v: &conn.Vdbe, i_var: Int) Never! {
    bit: if i_var >= 32 -> 2147483648 else -> 1 << (i_var - 1)
    v.expmask = v.expmask.bit_or(bit)
}

// sqlite3VdbeGetBoundValue: a copy of parameter i_var with affinity aff,
// None while it is NULL.
get_bound_value: fn(v: conn.Vdbe, i_var: Int, aff: Int) -> base.Mem? Never! {
    m: v.vars[i_var - 1]
    if m.flags.bit_and(base.MEM_NULL) != 0 -> return None
    out := mem.mem_copy(m)
    mem.apply_affinity(out, aff, base.UTF8)
    Val(out)
}

// sqlite3VdbeSetNumCols.
set_num_cols: fn(v: &conn.Vdbe, n: Int) Never! {
    v.col_names = [base.Mem]{}
    loop _ in 0..<n * conn.COLNAME_N -> v.col_names.push(base.mem_null())
    v.n_res_column = n
    v.n_res_alloc = n
}

// sqlite3VdbeSetColName: name kind var (COLNAME_*) of result column idx.
set_col_name: fn(db: conn.Conn, v: &conn.Vdbe, idx: Int, var: Int, name: [U8]) -> Int Never! {
    if db.malloc_failed -> return base.NOMEM
    k: idx + var * v.n_res_alloc
    mem.set_str(v.col_names[k], name, name.len(), base.UTF8, db.limits[ast.LIMIT_LENGTH])
}

// ---------------------------------------------------------------------------
// The EXPLAIN listing.

append_bytes: fn(out: &[U8], z: [U8]) Never! {
    loop b in z -> out.push(b)
}

// sqlite3_str_appendall of a C string: z up to its first NUL.
append_c_string: fn(out: &[U8], z: [U8]) Never! {
    n: printf.c_len(z)
    loop i in 0..<n -> out.push(z[i])
}

// "%.16g".
real_text: fn(r: Float) -> [U8] Never! { printf.snprintf(64, "%.16g".bytes(), [base.Mem]{base.mem_real(r)}) }

// sqlite3VdbeDisplayP4: the P4 column of EXPLAIN; None for an empty one
// (sqlite3StrAccumFinish of nothing). A TableRef shows its table's name
// (C shows the Table object's bytes).
display_p4: fn(db: conn.Conn, p4: conn.P4) -> [U8]? Never! {
    out := [U8]{}
    if p4 == {
        .KeyInfo(k) -> {
            append_bytes(out, "k({k.n_key_field}".bytes())
            loop j in 0..<k.n_key_field {
                out.push(U8{44})
                f: k.sort_flags[j]
                if f.bit_and(base.KEYINFO_ORDER_DESC) != 0 -> out.push(U8{45})
                if f.bit_and(base.KEYINFO_ORDER_BIGNULL) != 0 -> append_bytes(out, "N.".bytes())
                c: k.colls[j]
                if c != record.COLL_NONE {
                    name: conn.coll_name(db, c)
                    if name == "BINARY".bytes() {
                        out.push(U8{66})
                    } else {
                        append_bytes(out, name)
                    }
                }
            }
            out.push(U8{41})
        }
        .Coll(c) -> {
            loop s in db.colls {
                if s.id == c {
                    n: if s.name.len() > 18 -> 18 else -> s.name.len()
                    loop i in 0..<n -> out.push(s.name[i])
                    out.push(U8{45})
                    encs: [String]{"?", "8", "16LE", "16BE"}
                    append_bytes(out, encs[s.enc].bytes())
                    break
                }
            }
        }
        .FuncDef(f) -> {
            append_bytes(out, f.name)
            append_bytes(out, "({f.n_arg})".bytes())
        }
        .FuncCtx(func, _) -> {
            append_bytes(out, func.name)
            append_bytes(out, "({func.n_arg})".bytes())
        }
        .Int64(i) -> append_bytes(out, "{i}".bytes())
        .Int32(i) -> append_bytes(out, "{i}".bytes())
        .Real(r) -> append_bytes(out, real_text(r))
        .Mem(m) -> {
            if m.flags.bit_and(base.MEM_STR) != 0 {
                append_c_string(out, m.z)
            } else if m.flags.bit_and(base.MEM_INT.bit_or(base.MEM_INT_REAL)) != 0 {
                append_bytes(out, "{m.i}".bytes())
            } else if m.flags.bit_and(base.MEM_REAL) != 0 {
                append_bytes(out, real_text(m.r))
            } else if m.flags.bit_and(base.MEM_NULL) != 0 {
                append_bytes(out, "NULL".bytes())
            } else {
                append_bytes(out, "(blob)".bytes())
            }
        }
        .Vtab(vt) -> {
            append_bytes(out, "vtab:".bytes())
            append_bytes(out, printf.snprintf(32, "%llx".bytes(), [base.Mem]{base.mem_int(db.vtables[vt].vtab)}))
        }
        .IntArray(ai) -> {
            loop i in 0..<ai.len() {
                out.push(if i == 0 -> U8{91} else -> U8{44})
                append_bytes(out, "{ai[i]}".bytes())
            }
            out.push(U8{93})
        }
        .Program(_) -> append_bytes(out, "program".bytes())
        .Table(t) -> append_c_string(out, db.tables[t].name)
        .TableRef(t) -> append_c_string(out, db.tables[t].name)
        .Text(z) -> append_c_string(out, z)
        else -> {}
    }
    if out.len() == 0 -> return None
    Val(out)
}

// The ops of program prog (-1 for the statement's own).
op_of: fn(v: conn.Vdbe, prog: Int, i: Int) -> conn.VdbeOp Never! {
    if prog < 0 -> return v.ops[i]
    v.programs[prog].ops[i]
}

// sqlite3VdbeList: the next row of EXPLAIN (explain 1: every op of the
// program and of the trigger programs it reaches) or EXPLAIN QUERY PLAN
// (explain 2: the OP_Explain ops) into registers 1..8. SQLITE_ROW,
// SQLITE_DONE or SQLITE_ERROR.
list: fn(db: &conn.Conn, v: &conn.Vdbe) -> Int Never! {
    release_mem_array(v, 1, 9)
    if v.rc == base.NOMEM {
        oom_fault(db)
        return base.ERROR
    }
    list_subs: v.explain == 1 || db.flags.bit_and(conn.SQLITE_TRIGGER_EQP) != 0
    // sqlite3VdbeNextOpcode.
    n_row := v.ops.len()
    if list_subs {
        loop p in v.list_subs -> n_row += v.programs[p].ops.len()
    }
    pc := v.pc
    i := 0
    prog := -1
    rc := base.OK
    loop {
        i = pc
        pc += 1
        if i >= n_row {
            v.rc = base.OK
            rc = base.DONE
            break
        }
        prog = -1
        if i >= v.ops.len() {
            i -= v.ops.len()
            j := 0
            loop i >= v.programs[v.list_subs[j]].ops.len() {
                i -= v.programs[v.list_subs[j]].ops.len()
                j += 1
            }
            prog = v.list_subs[j]
        }
        o: op_of(v, prog, i)
        if list_subs && o.p4 == .Program(sp) {
            seen := false
            loop p in v.list_subs {
                if p == sp -> seen = true
            }
            if !seen {
                v.list_subs.push(sp)
                n_row += v.programs[sp].ops.len()
            }
        }
        if v.explain != 2 -> break
        if o.opcode == opc.OP_EXPLAIN -> break
        if o.opcode == opc.OP_INIT && pc > 1 -> break
    }
    v.pc = pc
    if rc != base.OK -> return rc
    if db.is_interrupted {
        v.rc = base.INTERRUPT
        vdbe_error(v, base.error_string(base.INTERRUPT).bytes())
        return base.ERROR
    }
    o: op_of(v, prog, i)
    p4: display_p4(db, o.p4)
    p4_mem: if p4 == .Val(z) -> base.mem_text(z, base.UTF8) else -> base.mem_null()
    if v.explain == 2 {
        v.mem[1] = base.mem_int(o.p1)
        v.mem[2] = base.mem_int(o.p2)
        v.mem[3] = base.mem_int(o.p3)
        v.mem[4] = p4_mem
    } else {
        v.mem[1] = base.mem_int(i)
        v.mem[2] = base.mem_text(opc.OP_NAMES[o.opcode].bytes(), base.UTF8)
        v.mem[3] = base.mem_int(o.p1)
        v.mem[4] = base.mem_int(o.p2)
        v.mem[5] = base.mem_int(o.p3)
        v.mem[7] = base.mem_int(o.p5)
        v.mem[8] = base.mem_null()
        v.mem[6] = p4_mem
    }
    v.result_row = 1
    if db.malloc_failed {
        v.rc = base.NOMEM
        return base.ERROR
    }
    v.rc = base.OK
    base.ROW
}

// ---------------------------------------------------------------------------
// Readying a statement.

// sqlite3VdbeRewind: back to the start of the program.
rewind: fn(v: &conn.Vdbe) Never! {
    v.state = conn.VDBE_READY_STATE
    v.pc = -1
    v.rc = base.OK
    v.error_action = ast.OE_ABORT
    v.n_change = 0
    v.cache_ctr = 1
    v.min_write_file_format = 255
    v.i_statement = 0
    v.n_fk_constraint = 0
}

// sqlite3VdbeMakeReady: the built program becomes a statement ready to
// run, with n_var parameters, n_mem registers and n_cursor cursors
// (pParse->nVar, nMem and nTab); explain is pParse->explain and
// uses_stmt_journal is pParse->isMultiWrite && pParse->mayAbort.
make_ready: fn(db: &conn.Conn, v: &conn.Vdbe, n_var: Int, n_mem_in: Int, n_cursor: Int, explain: Int, uses_stmt_journal: Bool) Never! {
    // Each cursor has a register; register 0 exists even when unused.
    n_mem := n_mem_in + n_cursor
    if n_cursor == 0 && n_mem > 0 -> n_mem += 1
    n_arg := 0
    resolve_p2_values(v, n_arg)
    v.uses_stmt_journal = uses_stmt_journal
    if explain != 0 {
        if n_mem < 10 -> n_mem = 10
        v.explain = explain
        v.n_res_column = 12 - 4 * explain
    }
    db.vdbe_links[v.slot].expired = 0
    v.n_cursor = n_cursor
    v.n_var = n_var
    v.vars = [base.Mem]{}
    loop _ in 0..<n_var -> v.vars.push(base.mem_null())
    v.n_mem = n_mem
    v.mem = [base.Mem]{}
    loop _ in 0..<n_mem -> v.mem.push(base.mem_init(conn.MEM_UNDEFINED))
    v.csr = [conn.VdbeCursor]{}
    loop _ in 0..<n_cursor -> v.csr.push(conn.vdbe_cursor_closed())
    v.mem_base = 0
    v.csr_base = 0
    v.once_base = 0
    v.program = -1
    v.frames = [conn.VdbeFrame]{}
    v.once = [Bool]{}
    v.aux = [conn.AuxData]{}
    v.list_subs = [Int]{}
    rewind(v)
}

// ---------------------------------------------------------------------------
// Registers, cursors and frames.

// Free the engine object register i holds: an aggregate's context or a
// RowSet (sqlite3VdbeMemRelease of MEM_Agg or MEM_Dyn). C also runs a
// pending aggregate's xFinalize here, which only frees its context.
release_object: fn(v: &conn.Vdbe, i: Int) Never! {
    f: v.mem[i].flags
    if f.bit_and(base.MEM_AGG) != 0 {
        k: v.mem[i].i
        v.aggs[k] = conn.agg_state_new()
        v.agg_free.push(k)
    } else if f.bit_and(conn.MEM_DYN) != 0 && v.mem[i].subtype == conn.DYN_ROWSET {
        k: v.mem[i].i
        v.rowsets[k] = rowset.rowset_new()
        v.rowset_free.push(k)
    }
}

// releaseMemArray: registers from..<to become undefined.
release_mem_array: fn(v: &conn.Vdbe, from: Int, to: Int) Never! {
    loop i in from..<to {
        release_object(v, i)
        v.mem[i].flags = conn.MEM_UNDEFINED
        v.mem[i].z = [U8]{}
    }
}

// sqlite3VdbeFreeCursorNN: close cursor slot ci of v.csr. An ephemeral
// table's btree closes with its last cursor and frees its slot.
free_cursor: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, ci: Int) Never! -[DB]> {
    t: v.csr[ci].cur_type
    if t == conn.CURTYPE_BTREE {
        bt: v.csr[ci].bt
        if bt >= 0 {
            _: btree.btree_close_cursor(db.btrees[bt], v.csr[ci].btc)
            if v.csr[ci].is_ephemeral && db.btrees[bt].open_flags == 0 -> conn.btree_slot_free(db, bt)
        }
    } else if t == conn.CURTYPE_VTAB {
        vt: v.csr[ci].vtab
        db.vtables[vt].n_cursor -= 1
        h.vtab_close(db, vt, v.csr[ci].vtab_cursor)
    }
    v.csr[ci] = conn.vdbe_cursor_closed()
}

// closeCursorsInFrame: close the running program's cursors.
close_cursors_in_frame: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe) Never! -[DB]> {
    loop ci in v.csr_base..<v.csr.len() {
        if v.csr[ci].live -> free_cursor<H>(h, db, v, ci)
    }
}

// sqlite3VdbeFrameRestore with the frame's deletion: end the running
// trigger program, back to its parent. The parent's pc.
frame_restore: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe) -[DB]> Int Never! {
    depth: v.frames.len()
    close_cursors_in_frame<H>(h, db, v)
    release_mem_array(v, v.mem_base, v.mem.len())
    loop v.mem.len() > v.mem_base -> _: v.mem.pop()
    loop v.csr.len() > v.csr_base -> _: v.csr.pop()
    loop v.once.len() > v.once_base -> _: v.once.pop()
    if v.aux.len() > 0 {
        kept := [conn.AuxData]{}
        loop a in v.aux {
            if a.depth != depth -> kept.push(a.copy())
        }
        v.aux = kept
    }
    if v.frames.pop() == .Val(f) {
        v.ops = f.ops
        v.program = f.program
        v.mem_base = f.mem_base
        v.n_mem = f.n_mem
        v.csr_base = f.csr_base
        v.n_cursor = f.n_cursor
        v.once_base = f.once_base
        db.last_rowid = f.last_rowid
        v.n_change = f.n_change
        db.n_change = f.n_db_change
        return f.pc
    }
    0
}

// closeAllCursors: end every trigger program, close the cursors, release
// the registers and free the auxiliary data.
close_all_cursors: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe) Never! -[DB]> {
    loop v.frames.len() > 0 -> _: frame_restore<H>(h, db, v)
    close_cursors_in_frame<H>(h, db, v)
    release_mem_array(v, 0, v.mem.len())
    v.list_subs = [Int]{}
    v.aux = [conn.AuxData]{}
}

// sqlite3VdbeDeleteAuxData of the running program's list: drop its
// auxiliary data of op i_op whose argument is not in mask (bits 0..31), or
// all of it for i_op < 0.
delete_aux_data: fn(v: &conn.Vdbe, i_op: Int, mask: Int) Never! {
    depth: v.frames.len()
    kept := [conn.AuxData]{}
    loop a in v.aux {
        gone: a.depth == depth && (i_op < 0 || (a.i_aux_op == i_op && a.i_aux_arg >= 0 && (a.i_aux_arg > 31 || mask.bit_and(1 << a.i_aux_arg) == 0)))
        if !gone -> kept.push(a.copy())
    }
    v.aux = kept
}

// sqlite3VdbeFinishMoveto: do cursor ci's deferred seek to moveto_target.
finish_moveto: fn(db: &conn.Conn, v: &conn.Vdbe, ci: Int) -[DB]> Int Never! {
    res := 0
    rc: btree.btree_table_moveto(db.btrees[v.csr[ci].bt], v.csr[ci].btc, v.csr[ci].moveto_target, false, res)
    if rc != base.OK -> return rc
    if res != 0 -> return base.CORRUPT
    v.csr[ci].deferred_moveto = false
    v.csr[ci].cache_status = conn.CACHE_STALE
    base.OK
}

// sqlite3VdbeHandleMovedCursor: restore cursor ci after its btree moved
// it; a row that went leaves the cursor on a NULL row.
handle_moved_cursor: fn(db: &conn.Conn, v: &conn.Vdbe, ci: Int) -[DB]> Int Never! {
    different := false
    rc: btree.btree_cursor_restore(db.btrees[v.csr[ci].bt], v.csr[ci].btc, different)
    v.csr[ci].cache_status = conn.CACHE_STALE
    if different -> v.csr[ci].null_row = true
    rc
}

// sqlite3VdbeCursorRestore.
cursor_restore: fn(db: &conn.Conn, v: &conn.Vdbe, ci: Int) -[DB]> Int Never! {
    if btree.btree_cursor_has_moved(db.btrees[v.csr[ci].bt], v.csr[ci].btc) -> return handle_moved_cursor(db, v, ci)
    base.OK
}

// The payload of btree cursor btc, whole, with nine zero bytes after it
// so that a varint read at its end stays in bounds.
cursor_record: fn(db: &conn.Conn, bt: Int, btc: Int, n: Int, buf: &[U8]) -[DB]> Int Never! {
    buf = pager.zeros(n + 9)
    btree.btree_payload(db.btrees[bt], btc, 0, n, buf)
}

// sqlite3VdbeMemFromBtreeZeroOffset: the n-byte payload of btree cursor
// btc read where it lies when all of it is on the cursor's page (buf the
// page image, at its offset there), else a cursor_record copy at 0.
cursor_payload: fn(db: &conn.Conn, bt: Int, btc: Int, n: Int, buf: &[U8], at: &Int) -[DB]> Int Never! {
    amt := 0
    off: btree.btree_payload_fetch(db.btrees[bt], btc, amt)
    if n <= amt {
        buf = db.btrees[bt].pager.pcache.pages[db.btrees[bt].cursors[btc].page].data
        at = off
        return base.OK
    }
    at = 0
    cursor_record(db, bt, btc, n, buf)
}

// sqlite3VdbeIdxRowid: the rowid that ends the index record at btree
// cursor btc.
idx_rowid: fn(db: &conn.Conn, bt: Int, btc: Int, rowid: &Int) -[DB]> Int Never! {
    n: btree.btree_payload_size(db.btrees[bt], btc)
    buf := [U8]{}
    at := 0
    rc: cursor_payload(db, bt, btc, n, buf, at)
    if rc != base.OK -> return rc
    sz_hdr: record.key_varint(buf, at).value
    if sz_hdr < 3 || sz_hdr > n -> return base.CORRUPT
    type_rowid: record.key_varint(buf, at + sz_hdr - 1).value
    if type_rowid < 1 || type_rowid > 9 || type_rowid == 7 -> return base.CORRUPT
    sizes: [Int]{0, 1, 2, 3, 4, 6, 8, 8, 0, 0}
    len_rowid: sizes[type_rowid]
    if n < sz_hdr + len_rowid -> return base.CORRUPT
    rowid = record.serial_get(buf, at + n - len_rowid, type_rowid, base.UTF8).i
    base.OK
}

// sqlite3VdbeIdxKeyCompare: res is the comparison of the index record at
// btree cursor btc with key.
idx_key_compare: fn(db: &conn.Conn, bt: Int, btc: Int, key: &record.UnpackedRecord, res: &Int) -[DB]> Int Never! {
    n: btree.btree_payload_size(db.btrees[bt], btc)
    if n <= 0 || n > 2147483647 {
        res = 0
        return base.CORRUPT
    }
    buf := [U8]{}
    at := 0
    rc: cursor_payload(db, bt, btc, n, buf, at)
    if rc != base.OK -> return rc
    res = record.record_compare_with_skip(n, buf, at, key, false)
    base.OK
}

// sqlite3VdbeSetChanges.
set_changes: fn(db: &conn.Conn, n: Int) Never! {
    db.n_change = n
    db.n_total_change += n
}

// ---------------------------------------------------------------------------
// Ending a statement.

// vdbeCommit: commit the transaction of every database, through a super
// journal when more than one file with a rollback journal is written.
commit: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe) -[DB]> Int Never! {
    conn.sync_btrees(db)
    rc := vtab_sync<H>(h, db, v)
    n_trans := 0
    need_xcommit := false
    i := 0
    loop rc == base.OK && i < db.dbs.len() {
        b: db.dbs[i].bt
        if b >= 0 && btree.btree_txn_state(db.btrees[b]) == btree.TRANS_WRITE {
            need_xcommit = true
            mode: pager.pager_get_journal_mode(db.btrees[b].pager)
            super_needed: mode == pager.JOURNALMODE_DELETE || mode == pager.JOURNALMODE_PERSIST || mode == pager.JOURNALMODE_TRUNCATE
            if db.dbs[i].safety_level != pager.PAGER_SYNCHRONOUS_OFF && super_needed && !pager.pager_is_memdb(db.btrees[b].pager) -> n_trans += 1
            rc = pager.pager_exclusive_lock(db.btrees[b].pager)
        }
        i += 1
    }
    if rc != base.OK -> return rc
    if need_xcommit && h.commit_hook(db) != 0 -> return base.CONSTRAINT_COMMITHOOK
    main_file: if db.dbs.len() > 0 && db.dbs[0].bt >= 0 -> btree.btree_get_filename(db.btrees[db.dbs[0].bt]) else -> ""
    if main_file.count_bytes() == 0 || n_trans <= 1 {
        i = 0
        loop rc == base.OK && i < db.dbs.len() {
            b: db.dbs[i].bt
            if b >= 0 -> rc = btree.btree_commit_phase_one(db.btrees[b], None)
            i += 1
        }
        i = 0
        loop rc == base.OK && i < db.dbs.len() {
            b: db.dbs[i].bt
            if b >= 0 -> rc = btree.btree_commit_phase_two(db.btrees[b], false)
            i += 1
        }
        if rc == base.OK -> vtab_commit<H>(h, db)
        return rc
    }
    // A multi-file transaction: name a new super-journal.
    super := ""
    retry := 0
    loop {
        if retry > 100 {
            _: file.file_delete(super, false)
            break
        }
        retry += 1
        r: os.os_random_bytes(4)
        random: Int.from_u8(r[0]) + (Int.from_u8(r[1]) << 8) + (Int.from_u8(r[2]) << 16) + (Int.from_u8(r[3]) << 24)
        tail: printf.snprintf(13, "-mj%06X9%02X".bytes(), [base.Mem]{base.mem_int((random >> 8).bit_and(16777215)), base.mem_int(random.bit_and(255))})
        super = "{main_file}{String.from_bytes(tail) ?? ""}"
        if !file.file_exists(super) -> break
    }
    sj := file.file_closed()
    rc = file.file_open(sj, super, os.OPEN_READWRITE.bit_or(os.OPEN_CREATE).bit_or(os.OPEN_EXCLUSIVE).bit_or(os.OPEN_SUPER_JOURNAL))
    if rc != base.OK -> return rc
    // Write the name of each journal into it.
    offset := 0
    loop k in 0..<db.dbs.len() {
        b: db.dbs[k].bt
        if b < 0 || btree.btree_txn_state(db.btrees[b]) != btree.TRANS_WRITE -> next
        if btree.btree_get_journalname(db.btrees[b]) == .Val(jname) {
            z := jname.bytes().copy()
            z.push(U8{0})
            rc = file.file_write(sj, z, z.len(), offset)
            offset += z.len()
            if rc != base.OK {
                file.file_close(sj)
                _: file.file_delete(super, false)
                return rc
            }
        }
    }
    // Sync it, unless the device writes in order.
    if file.file_device_characteristics(sj).bit_and(os.IOCAP_SEQUENTIAL) == 0 {
        rc = file.file_sync(sj, os.SYNC_NORMAL)
        if rc != base.OK {
            file.file_close(sj)
            _: file.file_delete(super, false)
            return rc
        }
    }
    // Sync every database file of the transaction.
    i = 0
    loop rc == base.OK && i < db.dbs.len() {
        b: db.dbs[i].bt
        if b >= 0 -> rc = btree.btree_commit_phase_one(db.btrees[b], super)
        i += 1
    }
    file.file_close(sj)
    if rc != base.OK -> return rc
    // Deleting the super-journal commits the transaction.
    rc = file.file_delete(super, true)
    if rc != base.OK -> return rc
    loop k in 0..<db.dbs.len() {
        b: db.dbs[k].bt
        if b >= 0 -> _: btree.btree_commit_phase_two(db.btrees[b], true)
    }
    vtab_commit<H>(h, db)
    rc
}

// sqlite3VdbeCloseStatement: release (SAVEPOINT_RELEASE) or roll back
// (SAVEPOINT_ROLLBACK) the statement's subtransaction, if it opened one.
close_statement: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, op: Int) -[DB]> Int Never! {
    if db.n_statement == 0 || v.i_statement == 0 -> return base.OK
    conn.sync_btrees(db)
    rc := base.OK
    i_savepoint: v.i_statement - 1
    loop i in 0..<db.dbs.len() {
        b: db.dbs[i].bt
        if b < 0 -> next
        rc2 := base.OK
        if op == base.SAVEPOINT_ROLLBACK -> rc2 = btree.btree_savepoint(db.btrees[b], base.SAVEPOINT_ROLLBACK, i_savepoint)
        if rc2 == base.OK -> rc2 = btree.btree_savepoint(db.btrees[b], base.SAVEPOINT_RELEASE, i_savepoint)
        if rc == base.OK -> rc = rc2
    }
    db.n_statement -= 1
    v.i_statement = 0
    if rc == base.OK {
        if op == base.SAVEPOINT_ROLLBACK -> rc = vtab_savepoint<H>(h, db, base.SAVEPOINT_ROLLBACK, i_savepoint)
        if rc == base.OK -> rc = vtab_savepoint<H>(h, db, base.SAVEPOINT_RELEASE, i_savepoint)
    }
    if op == base.SAVEPOINT_ROLLBACK {
        db.n_deferred_cons = v.n_stmt_def_cons
        db.n_deferred_imm_cons = v.n_stmt_def_imm_cons
    }
    rc
}

// sqlite3VdbeCheckFk: fail the statement while it (deferred: the
// transaction) leaves foreign key constraints violated.
check_fk: fn(db: conn.Conn, v: &conn.Vdbe, deferred: Bool) -> Int Never! {
    violated: if deferred -> db.n_deferred_cons + db.n_deferred_imm_cons > 0 else -> v.n_fk_constraint > 0
    if !violated -> return base.OK
    v.rc = base.CONSTRAINT_FOREIGNKEY
    v.error_action = ast.OE_ABORT
    vdbe_error(v, "FOREIGN KEY constraint failed".bytes())
    if v.prep_flags.bit_and(conn.PREPARE_SAVESQL) == 0 -> return base.ERROR
    base.CONSTRAINT_FOREIGNKEY
}

// Roll back the whole transaction after an error that leaves it unusable
// and return to autocommit.
abort_transaction: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe) Never! -[DB]> {
    rollback_all<H>(h, db, base.ABORT_ROLLBACK)
    close_savepoints(db)
    db.auto_commit = true
    v.n_change = 0
}

// sqlite3VdbeHalt: the program stopped (or is abandoned). Close its
// cursors, then commit or roll back its statement and, in autocommit, its
// transaction. SQLITE_BUSY when a commit has to be retried, else
// SQLITE_OK; the outcome is v.rc.
halt: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe) -[DB]> Int Never! {
    if db.malloc_failed -> v.rc = base.NOMEM
    close_all_cursors<H>(h, db, v)
    if v.is_reader {
        stmt_op := 0
        mrc: if v.rc != base.OK -> v.rc.bit_and(255) else -> 0
        special: mrc == base.NOMEM || mrc == base.IOERR || mrc == base.INTERRUPT || mrc == base.FULL
        if special && (!v.read_only || mrc != base.INTERRUPT) {
            if (mrc == base.NOMEM || mrc == base.FULL) && v.uses_stmt_journal {
                stmt_op = base.SAVEPOINT_ROLLBACK
            } else {
                abort_transaction<H>(h, db, v)
            }
        }
        if v.rc == base.OK || (v.error_action == ast.OE_FAIL && !special) -> _: check_fk(db, v, false)
        writers: if v.read_only -> 0 else -> 1
        if !db.vtab_in_sync && db.auto_commit && db.n_vdbe_write == writers {
            if v.rc == base.OK || (v.error_action == ast.OE_FAIL && !special) {
                rc := check_fk(db, v, true)
                if rc != base.OK {
                    if v.read_only -> return base.ERROR
                    rc = base.CONSTRAINT_FOREIGNKEY
                } else if db.flags.bit_and(conn.SQLITE_CORRUPT_RD_ONLY) != 0 {
                    rc = base.CORRUPT
                    db.flags = util.clear_bits(db.flags, conn.SQLITE_CORRUPT_RD_ONLY)
                    conn.sync_btrees(db)
                } else {
                    rc = commit<H>(h, db, v)
                }
                if rc == base.BUSY && v.read_only -> return base.BUSY
                if rc != base.OK {
                    system_error(db, rc)
                    v.rc = rc
                    rollback_all<H>(h, db, base.OK)
                    v.n_change = 0
                } else {
                    db.n_deferred_cons = 0
                    db.n_deferred_imm_cons = 0
                    db.flags = util.clear_bits(db.flags, conn.SQLITE_DEFER_FKS)
                    conn.sync_btrees(db)
                    commit_internal_changes(db)
                }
            } else if v.rc == base.SCHEMA && db.n_vdbe_active > 1 {
                v.n_change = 0
            } else {
                rollback_all<H>(h, db, base.OK)
                v.n_change = 0
            }
            db.n_statement = 0
        } else if stmt_op == 0 {
            if v.rc == base.OK || v.error_action == ast.OE_FAIL {
                stmt_op = base.SAVEPOINT_RELEASE
            } else if v.error_action == ast.OE_ABORT {
                stmt_op = base.SAVEPOINT_ROLLBACK
            } else {
                abort_transaction<H>(h, db, v)
            }
        }
        if stmt_op != 0 {
            rc: close_statement<H>(h, db, v, stmt_op)
            if rc != base.OK {
                if v.rc == base.OK || v.rc.bit_and(255) == base.CONSTRAINT {
                    v.rc = rc
                    v.err_msg = None
                }
                abort_transaction<H>(h, db, v)
            }
        }
        if v.change_cnt_on {
            set_changes(db, if stmt_op != base.SAVEPOINT_ROLLBACK -> v.n_change else -> 0)
            v.n_change = 0
        }
    }
    db.n_vdbe_active -= 1
    if !v.read_only -> db.n_vdbe_write -= 1
    if v.is_reader -> db.n_vdbe_read -= 1
    conn.sync_btrees(db)
    v.state = conn.VDBE_HALT_STATE
    if db.malloc_failed -> v.rc = base.NOMEM
    if v.rc == base.BUSY -> return base.BUSY
    base.OK
}

// sqlite3VdbeResetStepResult.
reset_step_result: fn(v: &conn.Vdbe) Never! { v.rc = base.OK }

// sqlite3VdbeTransferError: the statement's error becomes the
// connection's.
transfer_error: fn(db: &conn.Conn, v: conn.Vdbe) -> Int Never! {
    if v.err_msg == .Val(msg) {
        db.err_msg = Val(msg)
        db.has_err_msg = true
    } else if db.has_err_msg {
        db.err_msg = None
    }
    db.err_code = v.rc
    db.err_byte_offset = -1
    v.rc
}

// sqlite3VdbeReset: halt a running statement and hand its error to the
// connection. The result code, masked by the connection's errMask.
reset: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe) -[DB]> Int Never! {
    if v.state == conn.VDBE_RUN_STATE -> _: halt<H>(h, db, v)
    if v.pc >= 0 {
        if db.has_err_msg || v.err_msg != None {
            _: transfer_error(db, v)
        } else {
            db.err_code = v.rc
        }
    }
    v.err_msg = None
    v.result_row = -1
    v.rc.bit_and(db.err_mask)
}

// sqlite3VdbeDelete: free a statement, dropping the references its ops
// hold, and its slot.
delete: fn<H: Host>(h: &H, db: &conn.Conn, v: &&conn.Vdbe) Never! -[DB]> {
    loop p in v.programs {
        loop o in p.ops -> free_p4(db, o.p4)
    }
    loop o in v.ops -> free_p4(db, o.p4)
    conn.vdbe_release(db, v.slot)
    vtab_reap<H>(h, db)
}

// sqlite3VdbeFinalize: reset (if it ran) and delete; reset's result.
finalize: fn<H: Host>(h: &H, db: &conn.Conn, v: &&conn.Vdbe) -[DB]> Int Never! {
    w := v
    rc := base.OK
    if w.state >= conn.VDBE_READY_STATE -> rc = reset<H>(h, db, w)
    delete<H>(h, db, w)
    rc
}

#Test("labels resolve into jump operands and the flags settle") {
    db := conn.conn_new()
    v := vdbe_create(db)
    done: make_label(v)
    _: add_op2(db, v, opc.OP_TRANSACTION, 0, 1)
    _: add_goto(db, v, done)
    _: add_op2(db, v, opc.OP_INTEGER, 7, 1)
    _: resolve_label(v, done)
    _: add_op2(db, v, opc.OP_RESULT_ROW, 1, 1)
    _: add_op0(db, v, opc.OP_HALT)
    n_arg := 0
    resolve_p2_values(v, n_arg)
    assert_eq(v.ops[2].p2, 4)
    assert_eq(v.read_only, false)
    assert_eq(v.is_reader, true)
    assert_eq(v.labels.len(), 0)
}

#Test("an op list offsets its jumps") {
    db := conn.conn_new()
    v := vdbe_create(db)
    list: [VdbeOpList]{VdbeOpList{opcode: opc.OP_INTEGER, p1: 1, p2: 2, p3: 0}, VdbeOpList{opcode: opc.OP_GOTO, p1: 0, p2: 1, p3: 0}}
    first: add_op_list(db, v, list)
    assert_eq(first, 1)
    assert_eq(v.ops[1].p2, 2)
    assert_eq(v.ops[2].p2, 2)
}

#Test("P4 renders as EXPLAIN shows it") {
    db := conn.conn_new()
    key: record.KeyInfo{enc: base.UTF8, n_key_field: 2, n_all_field: 3, sort_flags: [Int]{0, 1}, colls: [Int]{record.COLL_BINARY, record.COLL_NOCASE}}
    assert_eq(String.from_bytes(display_p4(db, conn.P4.KeyInfo(key)) ?? [U8]{}) ?? "", "k(2,B,-NOCASE)")
    assert_eq(String.from_bytes(display_p4(db, conn.P4.Coll(record.COLL_NOCASE)) ?? [U8]{}) ?? "", "NOCASE-8")
    assert_eq(String.from_bytes(display_p4(db, conn.P4.Real(0.1)) ?? [U8]{}) ?? "", "0.1")
    assert_eq(String.from_bytes(display_p4(db, conn.P4.IntArray([Int]{3, 4})) ?? [U8]{}) ?? "", "[3,4]")
    assert_eq(display_p4(db, conn.P4.Text([U8]{})) == None, true)
}

#Test("EXPLAIN lists the program") {
    db := conn.conn_new()
    v := vdbe_create(db)
    _: add_op2(db, v, opc.OP_INTEGER, 7, 1)
    _: add_op4(db, v, opc.OP_STRING8, 0, 2, 0, conn.P4.Text("hi".bytes()))
    _: add_op0(db, v, opc.OP_HALT)
    make_ready(db, v, 0, 2, 0, 1, false)
    v.pc = 0
    rows := 0
    loop list(db, v) == base.ROW {
        if rows == 2 -> assert_eq(String.from_bytes(v.mem[6].z) ?? "", "hi")
        if rows == 3 -> assert_eq(String.from_bytes(v.mem[2].z) ?? "", "Halt")
        rows += 1
    }
    assert_eq(rows, 4)
}
