// The op handlers of SQLite 3.45.0 vdbe.c that VdbeData and VdbeCursor
// leave: the schema and btree-file ops (OP_Destroy .. OP_IntegrityCk),
// RowSets, trigger programs and their counters, function calls and
// aggregates, the pager ops (checkpoint, journal mode, vacuum), virtual
// tables, subtypes, Bloom filters and OP_Init.
//
// Each handler runs the op at Run.pc and answers a GO_* code (VdbeRun).
// Registers and cursors are relative to the running program: register p
// is Vdbe.mem index v.mem_base + p, cursor p is Vdbe.csr index
// v.csr_base + p.

use {
    base: __core_db_base
    __core_db_base.[MEM_NULL, MEM_INT, MEM_BLOB, MEM_ZERO, MEM_SUBTYPE]
    util: __core_db_util
    __core_db_util.[clear_bits]
    mem: __core_db_mem
    btree: __core_db_btree
    pager: __core_db_pager
    ast: __core_db_ast
    conn: __core_db_conn
    opc: __core_db_opcodes
    sorter: __core_db_sorter
    rowset: __core_db_rowset
    aux: __core_db_vdbeaux
    __core_db_vdbeaux.[Host]
    run: __core_db_vdberun
    __core_db_vdberun.[Run, GO_NEXT, GO_JUMP, GO_NEXT_CHECK, GO_JUMP_CHECK, GO_NO_MEM, test_run, test_op]
    vc: __core_db_vdbecursor
}

// ---------------------------------------------------------------------------
// Operand readers and shared pieces.

// p4.pVtab: the Conn.vtables slot of a P4_VTAB operand, -1 otherwise.
p4_vtab: fn(v: conn.Vdbe, pc: Int) -> Int Never! {
    if v.ops[pc].p4 == {
        .Vtab(vt) -> vt
        .NotUsed | .Text(_) | .Coll(_) | .Int32(_) | .Int64(_) | .Real(_) | .Program(_) | .Table(_) | .TableRef(_) | .FuncDef(_) | .FuncCtx(_, _) | .KeyInfo(_) | .Mem(_) | .IntArray(_) | .Expr(_) -> -1
    }
}

// p4.pTab: the Conn.tables slot of a P4_TABLE or P4_TABLEREF operand, -1
// otherwise.
p4_table: fn(v: conn.Vdbe, pc: Int) -> Int Never! {
    if v.ops[pc].p4 == {
        .Table(t) -> t
        .TableRef(t) -> t
        .NotUsed | .Text(_) | .Coll(_) | .Int32(_) | .Int64(_) | .Real(_) | .Program(_) | .FuncDef(_) | .FuncCtx(_, _) | .KeyInfo(_) | .Mem(_) | .Vtab(_) | .IntArray(_) | .Expr(_) -> -1
    }
}

// p4.pProgram: the Vdbe.programs index of a P4_SUBPROGRAM operand, -1
// otherwise.
p4_program: fn(v: conn.Vdbe, pc: Int) -> Int Never! {
    if v.ops[pc].p4 == {
        .Program(p) -> p
        .NotUsed | .Text(_) | .Coll(_) | .Int32(_) | .Int64(_) | .Real(_) | .Table(_) | .TableRef(_) | .FuncDef(_) | .FuncCtx(_, _) | .KeyInfo(_) | .Mem(_) | .Vtab(_) | .IntArray(_) | .Expr(_) -> -1
    }
}

// p4.pFunc: the FuncDef of a P4_FUNCDEF operand or of a P4_FUNCCTX
// context.
p4_func: fn(v: conn.Vdbe, pc: Int) -> conn.FuncDef? Never! {
    if v.ops[pc].p4 == {
        .FuncDef(f) -> Val(f.copy())
        .FuncCtx(f, _) -> Val(f.copy())
        .NotUsed | .Text(_) | .Coll(_) | .Int32(_) | .Int64(_) | .Real(_) | .Program(_) | .Table(_) | .TableRef(_) | .KeyInfo(_) | .Mem(_) | .Vtab(_) | .IntArray(_) | .Expr(_) -> None
    }
}

// The argument count of a function op: its P4_FUNCCTX's, else P5 (an
// OP_AggStep's before it becomes OP_AggStep1).
p4_argc: fn(v: conn.Vdbe, pc: Int) -> Int Never! {
    if v.ops[pc].p4 == .FuncCtx(_, n) -> return n
    v.ops[pc].p5
}

// Vdbe.expired of the statement (its Conn.vdbe_links entry).
set_expired: fn(db: &conn.Conn, v: conn.Vdbe, x: Int) Never! {
    if v.slot >= 0 -> db.vdbe_links[v.slot].expired = x
}

// sqlite3_value_text of register i as an error message: its UTF-8 text,
// empty for NULL.
err_text: fn(v: &conn.Vdbe, i: Int) -> [U8] Never! {
    if mem.value_text(v.mem[i], base.UTF8) -> return v.mem[i].z.copy()
    [U8]{}
}

// The sqlite3_context of a call of f by op pc (Vdbe.fctx): the result
// into register out, the argc arguments from register arg, agg the
// accumulator register (-1 for a scalar function). The collating sequence
// is that of the OP_CollSeq before the op (sqlite3GetFuncCollSeq).
func_begin: fn(v: &conn.Vdbe, f: conn.FuncDef, pc: Int, out: Int, arg: Int, argc: Int, agg: Int) Never! {
    c := conn.func_context_new()
    c.out = out
    c.impl_id = f.impl_id
    c.user_data = f.user_data
    c.func_flags = f.flags
    c.agg = agg
    c.arg = arg
    c.argc = argc
    c.i_op = pc
    if pc > 0 && v.ops[pc - 1].opcode == opc.OP_COLL_SEQ -> c.coll = run.p4_coll(v, pc - 1)
    v.fctx = c
}

// ---------------------------------------------------------------------------
// Btree files and the schema.

// OP_Destroy: drop the btree rooted at page P1 of database P3; P2 gets the
// root page auto-vacuum moved into P1's place (0 for none).
op_destroy: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    o: v.mem_base + r.p2
    run.out2(v, o)
    v.mem[o].flags = MEM_NULL
    if db.n_vdbe_read > db.n_vdestroy + 1 {
        v.error_action = ast.OE_ABORT
        return vc.fail(r, base.LOCKED)
    }
    moved := 0
    rc: btree.btree_drop_table(db.btrees[db.dbs[r.p3].bt], r.p1, moved)
    v.mem[o].flags = MEM_INT
    v.mem[o].i = moved
    if rc != base.OK -> return vc.fail(r, rc)
    if moved != 0 {
        conn.root_page_moved(db, r.p3, moved, r.p1)
        r.reset_schema_on_fault = r.p3 + 1
    }
    GO_NEXT
}

// OP_Clear: delete every row of the btree rooted at page P1 of database
// P2, counting them as changes when P3 is set (and into register P3 when
// it is positive).
op_clear: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    n := 0
    rc: btree.btree_clear_table(db.btrees[db.dbs[r.p2].bt], r.p1, n)
    if r.p3 != 0 {
        v.n_change += n
        if r.p3 > 0 -> v.mem[v.mem_base + r.p3].i += n
    }
    if rc != base.OK -> return vc.fail(r, rc)
    GO_NEXT
}

// OP_ResetSorter: empty the sorter or ephemeral table of cursor P1.
op_reset_sorter: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    if v.csr[ci].cur_type == conn.CURTYPE_SORTER {
        s := vc.sorter_take(v, ci)
        sorter.sorter_reset(s)
        vc.sorter_put(v, ci, s)
        return GO_NEXT
    }
    rc: btree.btree_clear_table_of_cursor(db.btrees[v.csr[ci].bt], v.csr[ci].btc)
    if rc != base.OK -> return vc.fail(r, rc)
    GO_NEXT
}

// OP_CreateBtree: a new btree of kind P3 in database P1; its root page
// into P2.
op_create_btree: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    o: v.mem_base + r.p2
    run.out2(v, o)
    pgno := 0
    rc: btree.btree_create_table(db.btrees[db.dbs[r.p1].bt], pgno, r.p3)
    if rc != base.OK -> return vc.fail(r, rc)
    v.mem[o].i = pgno
    GO_NEXT
}

// OP_SqlExec: run the SQL of P4, without the authorizer and the trace
// callback when P1 is set.
op_sql_exec: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    sql: run.p4_text(v, r.pc) ?? [U8]{}
    db.n_sql_exec += 1
    msg := [U8]?{None}
    rc: h.sql_exec(db, sql, r.p1 != 0, msg)
    db.n_sql_exec -= 1
    if msg != None || rc != base.OK {
        aux.vdbe_error(v, msg ?? [U8]{})
        if rc == base.NOMEM -> return GO_NO_MEM
        return vc.fail(r, rc)
    }
    GO_NEXT
}

// OP_ParseSchema: read into the schema of database P1 the schema rows
// that match the WHERE clause P4; with no P4, reread the whole schema
// (sqlite3InitOne with flags P5).
op_parse_schema: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    msg := [U8]?{None}
    rc := base.OK
    if run.p4_text(v, r.pc) == .Val(where) {
        rc = h.parse_schema(db, r.p1, where, msg)
    } else {
        conn.schema_clear(db, db.dbs[r.p1].schema)
        db.m_db_flags = clear_bits(db.m_db_flags, conn.DBFLAG_SCHEMA_KNOWN_OK)
        rc = h.init_one(db, r.p1, r.p5, msg)
        db.m_db_flags = db.m_db_flags.bit_or(conn.DBFLAG_SCHEMA_CHANGE)
        set_expired(db, v, 0)
    }
    if msg == .Val(e) -> v.err_msg = Val(e)
    if rc != base.OK {
        conn.reset_all_schemas(db)
        if rc == base.NOMEM -> return GO_NO_MEM
        return vc.fail(r, rc)
    }
    GO_NEXT
}

// OP_LoadAnalysis: read the sqlite_stat tables of database P1.
op_load_analysis: fn<H: Host>(h: &H, db: &conn.Conn, r: &Run) -[DB]> Int Never! {
    rc: h.load_analysis(db, r.p1)
    if rc != base.OK -> return vc.fail(r, rc)
    GO_NEXT
}

// OP_DropTable, OP_DropIndex, OP_DropTrigger: remove the object named P4
// from the schema of database P1.
op_drop_object: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -> Int Never! {
    name: run.p4_text(v, r.pc) ?? [U8]{}
    if r.op == opc.OP_DROP_TABLE {
        conn.unlink_and_delete_table(db, r.p1, name)
    } else if r.op == opc.OP_DROP_INDEX {
        conn.unlink_and_delete_index(db, r.p1, name)
    } else {
        conn.unlink_and_delete_trigger(db, r.p1, name)
    }
    GO_NEXT
}

// OP_IntegrityCk: check the P2 btrees whose root pages P4 lists (from its
// second entry) in database P5, finding at most the count in register P3
// of errors; register P1 gets the report (NULL when all is well) and P3
// what is left of the count.
op_integrity_ck: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    roots := [Int]{}
    if v.ops[r.pc].p4 == .IntArray(ai) {
        loop j in 1..<1 + r.p2 -> roots.push(ai[j])
    }
    e: v.mem_base + r.p3
    o: v.mem_base + r.p1
    n_err := 0
    z := String?{None}
    rc: btree.btree_integrity_check(db.btrees[db.dbs[r.p5].bt], roots, v.mem[e].i + 1, n_err, z)
    run.reg_null(v, o)
    if n_err != 0 {
        if rc != base.OK -> return vc.fail(r, rc)
        v.mem[e].i -= n_err - 1
        run.reg_set(v, o, base.mem_text((z ?? "").bytes(), base.UTF8))
    }
    mem.change_encoding(v.mem[o], r.enc)
    GO_NEXT_CHECK
}

// ---------------------------------------------------------------------------
// RowSets. A register holding a RowSet is MEM_Blob|MEM_Dyn of subtype
// DYN_ROWSET, its i the Vdbe.rowsets slot.

is_rowset: fn(v: conn.Vdbe, i: Int) -> Bool Never! {
    v.mem[i].flags.bit_and(conn.MEM_DYN) != 0 && v.mem[i].subtype == conn.DYN_ROWSET
}

// The Vdbe.rowsets slot of register i's RowSet, giving it an empty one
// first when it holds none (sqlite3VdbeMemSetRowSet).
rowset_of: fn(v: &conn.Vdbe, i: Int) -> Int Never! {
    if is_rowset(v, i) -> return v.mem[i].i
    run.release_dyn(v, i)
    k := 0
    if v.rowset_free.pop() == .Val(s) {
        k = s
    } else {
        v.rowsets.push(rowset.rowset_new())
        k = v.rowsets.len() - 1
    }
    m := base.mem_init(MEM_BLOB.bit_or(conn.MEM_DYN))
    m.subtype = conn.DYN_ROWSET
    m.i = k
    v.mem[i] = m
    k
}

// OP_RowSetAdd: the integer in P2 into the RowSet of P1.
op_row_set_add: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    k: rowset_of(v, v.mem_base + r.p1)
    x: v.mem[v.mem_base + r.p2].i
    rowset.rowset_insert(v.rowsets[k], x)
    GO_NEXT
}

// OP_RowSetRead: the smallest value of the RowSet of P1 out of it into P3;
// when it is empty P1 becomes NULL and the op jumps to P2.
op_row_set_read: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    if is_rowset(v, i) {
        k: v.mem[i].i
        if rowset.rowset_next(v.rowsets[k]) == .Val(x) {
            run.reg_int(v, v.mem_base + r.p3, x)
            return GO_NEXT_CHECK
        }
    }
    run.reg_null(v, i)
    GO_JUMP_CHECK
}

// OP_RowSetTest: jump to P2 when the integer in P3 is in the RowSet of P1
// from a batch before P4; unless P4 is negative, then insert it.
op_row_set_test: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i_set: run.p4_int(v, r.pc)
    k: rowset_of(v, v.mem_base + r.p1)
    x: v.mem[v.mem_base + r.p3].i
    if i_set != 0 && rowset.rowset_test(v.rowsets[k], i_set, x) -> return GO_JUMP
    if i_set >= 0 -> rowset.rowset_insert(v.rowsets[k], x)
    GO_NEXT
}

// ---------------------------------------------------------------------------
// Trigger programs and their counters.

// OP_Program: run the trigger program P4 (OP_Halt in it returns to the op
// after this one). With P5 set, a program already running is not entered
// again (no recursive triggers). The program's registers, cursors and once
// flags follow the caller's; its registers start undefined.
op_program: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -> Int Never! {
    prog: p4_program(v, r.pc)
    if prog < 0 -> return vc.fail(r, base.INTERNAL)
    token: v.programs[prog].token
    if r.p5 != 0 {
        loop f in v.frames {
            if f.token == token -> return GO_NEXT
        }
    }
    if v.frames.len() >= db.limits[ast.LIMIT_TRIGGER_DEPTH] {
        aux.vdbe_error(v, "too many levels of trigger recursion".bytes())
        return vc.fail(r, base.ERROR)
    }
    n_csr: v.programs[prog].n_csr
    n_mem: v.programs[prog].n_mem + n_csr + (if n_csr == 0 -> 1 else -> 0)
    v.frames.push(conn.VdbeFrame{pc: r.pc, token: token, last_rowid: db.last_rowid, n_change: v.n_change, n_db_change: db.n_change, program: v.program, ops: v.ops, mem_base: v.mem_base, n_mem: v.n_mem, csr_base: v.csr_base, n_cursor: v.n_cursor, once_base: v.once_base})
    v.n_change = 0
    v.program = prog
    v.mem_base = v.mem.len()
    v.n_mem = n_mem
    v.csr_base = v.csr.len()
    v.n_cursor = n_csr
    v.once_base = v.once.len()
    loop _ in 0..<n_mem -> v.mem.push(base.mem_init(conn.MEM_UNDEFINED))
    loop _ in 0..<n_csr -> v.csr.push(conn.vdbe_cursor_closed())
    v.ops = v.programs[prog].ops
    loop _ in 0..<v.ops.len() -> v.once.push(false)
    r.pc = -1
    GO_NEXT_CHECK
}

// OP_Param: into P2 a copy of the caller's register that the OP_Program
// running this program names by its P1 plus this op's P1.
op_param: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    k: v.frames.len() - 1
    from: v.frames[k].mem_base + r.p1 + v.frames[k].ops[v.frames[k].pc].p1
    run.reg_copy(v, v.mem_base + r.p2, from)
    GO_NEXT
}

// OP_FkCounter: count P2 foreign key violations: deferred ones (P1) on the
// connection, immediate ones on the statement; with SQLITE_DeferFKs all of
// them are deferred to the commit.
op_fk_counter: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -> Int Never! {
    if db.flags.bit_and(conn.SQLITE_DEFER_FKS) != 0 {
        db.n_deferred_imm_cons += r.p2
    } else if r.p1 != 0 {
        db.n_deferred_cons += r.p2
    } else {
        v.n_fk_constraint += r.p2
    }
    GO_NEXT
}

// OP_FkIfZero: jump to P2 when there are no deferred (P1) or immediate
// foreign key violations.
op_fk_if_zero: fn(db: conn.Conn, v: conn.Vdbe, r: Run) -> Int Never! {
    if r.p1 != 0 {
        if db.n_deferred_cons == 0 && db.n_deferred_imm_cons == 0 -> return GO_JUMP
    } else {
        if v.n_fk_constraint == 0 && db.n_deferred_imm_cons == 0 -> return GO_JUMP
    }
    GO_NEXT
}

// OP_MemMax: register P1 (of the statement's own program while a trigger
// runs) becomes the larger of its integer and P2's.
op_mem_max: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i1: if v.frames.len() > 0 -> v.frames[0].mem_base + r.p1 else -> v.mem_base + r.p1
    i2: v.mem_base + r.p2
    mem.integerify(v.mem[i1])
    mem.integerify(v.mem[i2])
    if v.mem[i1].i < v.mem[i2].i -> v.mem[i1].i = v.mem[i2].i
    GO_NEXT
}

// OP_IfPos: when register P1 is positive, take P3 from it and jump to P2.
op_if_pos: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    if v.mem[i].i > 0 {
        v.mem[i].i -= r.p3
        return GO_JUMP
    }
    GO_NEXT
}

// OP_OffsetLimit: P2 becomes LIMIT P1 plus OFFSET P3 (a negative OFFSET as
// 0), or -1 when there is no limit (P1 not positive or the sum overflows).
op_offset_limit: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    x: v.mem[v.mem_base + r.p1].i
    off: v.mem[v.mem_base + r.p3].i
    o: v.mem_base + r.p2
    run.out2(v, o)
    v.mem[o].i = -1
    if x > 0 {
        if util.add_int64(x, if off > 0 -> off else -> 0) == .Val(s) -> v.mem[o].i = s
    }
    GO_NEXT
}

// OP_IfNotZero: when register P1 is not zero, count it down (if positive)
// and jump to P2.
op_if_not_zero: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    if v.mem[i].i != 0 {
        if v.mem[i].i > 0 -> v.mem[i].i -= 1
        return GO_JUMP
    }
    GO_NEXT
}

// OP_DecrJumpZero: count register P1 down (not past the smallest integer)
// and jump to P2 when it reaches zero.
op_decr_jump_zero: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    if v.mem[i].i > base.I64_MIN -> v.mem[i].i -= 1
    if v.mem[i].i == 0 -> return GO_JUMP
    GO_NEXT
}

// ---------------------------------------------------------------------------
// Functions and aggregates.

// OP_Function, OP_PureFunc: the function of P4's context on the registers
// from P2 into P3. P1 is the mask of the constant arguments whose
// auxiliary data outlives an error.
op_function: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    f: p4_func(v, r.pc) ?? return vc.fail(r, base.INTERNAL)
    o: v.mem_base + r.p3
    argc: p4_argc(v, r.pc)
    func_begin(v, f, r.pc, o, v.mem_base + r.p2, argc, -1)
    run.release_dyn(v, o)
    mem.set_type_flag(v.mem[o], MEM_NULL)
    h.func_call(db, v, aux.FN_SFUNC)
    rc := base.OK
    if v.fctx.is_error != 0 {
        if v.fctx.is_error > 0 {
            e: err_text(v, o)
            aux.vdbe_error(v, e)
            rc = v.fctx.is_error
        }
        aux.delete_aux_data(v, r.pc, r.p1)
        v.fctx.is_error = 0
        if rc != base.OK -> return vc.fail(r, rc)
    }
    GO_NEXT
}

// OP_AggStep, OP_AggInverse: the op becomes OP_AggStep1 with a context of
// the P5 arguments, then runs as one.
op_agg_step: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    f: p4_func(v, r.pc) ?? return vc.fail(r, base.INTERNAL)
    run.set_p4(v, r.pc, conn.P4.FuncCtx{func: f, argc: r.p5})
    run.set_opcode(v, r.pc, opc.OP_AGG_STEP1)
    op_agg_step1<H>(h, db, v, r)
}

// OP_AggStep1: the step (xInverse when P1 is set) of the aggregate of P4's
// context on the registers from P2, accumulating in register P3. A step
// that skips (min() and max() on a NULL) sets the register of the
// OP_CollSeq before the op.
op_agg_step1: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    f: p4_func(v, r.pc) ?? return vc.fail(r, base.INTERNAL)
    o: v.mem.len()
    v.mem.push(base.mem_null())
    argc: p4_argc(v, r.pc)
    func_begin(v, f, r.pc, o, v.mem_base + r.p2, argc, v.mem_base + r.p3)
    h.func_call(db, v, if r.p1 != 0 -> aux.FN_INVERSE else -> aux.FN_STEP)
    rc := base.OK
    if v.fctx.is_error != 0 {
        if v.fctx.is_error > 0 {
            e: err_text(v, o)
            aux.vdbe_error(v, e)
            rc = v.fctx.is_error
        }
        if v.fctx.skip_flag {
            i: v.ops[r.pc - 1].p1
            if i != 0 -> run.reg_int(v, v.mem_base + i, 1)
            v.fctx.skip_flag = false
        }
        v.fctx.is_error = 0
    }
    run.release_dyn(v, o)
    _: v.mem.pop()
    if rc != base.OK -> return vc.fail(r, rc)
    GO_NEXT
}

// OP_AggFinal: the result of the aggregate P4 accumulated in register P1
// replaces the accumulator (sqlite3VdbeMemFinalize). OP_AggValue: its
// current value (xValue) into P3, the accumulator staying.
op_agg_final: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    f: p4_func(v, r.pc) ?? return vc.fail(r, base.INTERNAL)
    acc: v.mem_base + r.p1
    res := acc
    if r.p3 != 0 {
        res = v.mem_base + r.p3
        run.reg_null(v, res)
        func_begin(v, f, r.pc, res, 0, 0, acc)
        h.func_call(db, v, aux.FN_VALUE)
    } else {
        o: v.mem.len()
        t := base.mem_null()
        t.enc = db.enc
        v.mem.push(t)
        func_begin(v, f, r.pc, o, 0, 0, acc)
        h.func_call(db, v, aux.FN_FINAL)
        out: v.mem.pop() ?? base.mem_null()
        run.reg_set(v, acc, out)
    }
    if v.fctx.is_error != 0 {
        rc: v.fctx.is_error
        v.fctx.is_error = 0
        e: err_text(v, res)
        aux.vdbe_error(v, e)
        return vc.fail(r, rc)
    }
    mem.change_encoding(v.mem[res], r.enc)
    GO_NEXT
}

// ---------------------------------------------------------------------------
// The pager.

// OP_Checkpoint: checkpoint database P1 (all of them for SQLITE_MAX_DB)
// in mode P2; registers P3.. get busy (0 or 1), the frames in the log and
// the frames checkpointed (-1 when unknown).
op_checkpoint: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    busy := 0
    n_log := -1
    n_ckpt := -1
    rc: conn.checkpoint(db, r.p1, r.p2, n_log, n_ckpt)
    if rc != base.OK {
        if rc != base.BUSY -> return vc.fail(r, rc)
        busy = 1
    }
    o: v.mem_base + r.p3
    run.reg_int(v, o, busy)
    run.reg_int(v, o + 1, n_log)
    run.reg_int(v, o + 2, n_ckpt)
    GO_NEXT
}

// sqlite3JournalModename, by PAGER_JOURNALMODE_*.
JOURNAL_MODE_NAMES: ["delete", "persist", "off", "truncate", "memory", "wal"]

// OP_JournalMode: the journal mode of database P1 becomes P3 (QUERY keeps
// it) where the pager allows; its name into P2. Into or out of WAL takes
// a transaction of its own (no other statement reading).
op_journal_mode: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    o: v.mem_base + r.p2
    run.out2(v, o)
    bt: db.dbs[r.p1].bt
    e_old: pager.pager_get_journal_mode(db.btrees[bt].pager)
    e_new := r.p3
    if e_new == pager.JOURNALMODE_QUERY -> e_new = e_old
    if !pager.pager_ok_to_change_journal_mode(db.btrees[bt].pager) -> e_new = e_old
    if e_new == pager.JOURNALMODE_WAL && (pager.pager_filename(db.btrees[bt].pager) == "" || !pager.pager_wal_supported(db.btrees[bt].pager)) -> e_new = e_old
    rc := base.OK
    if e_new != e_old && (e_old == pager.JOURNALMODE_WAL || e_new == pager.JOURNALMODE_WAL) {
        if !db.auto_commit || db.n_vdbe_read > 1 {
            way: if e_new == pager.JOURNALMODE_WAL -> "into" else -> "out of"
            aux.vdbe_error(v, "cannot change {way} wal mode from within a transaction".bytes())
            return vc.fail(r, base.ERROR)
        }
        if e_old == pager.JOURNALMODE_WAL {
            rc = pager.pager_close_wal(db.btrees[bt].pager)
            if rc == base.OK -> _: pager.pager_set_journal_mode(db.btrees[bt].pager, e_new)
        } else if e_old == pager.JOURNALMODE_MEMORY {
            _: pager.pager_set_journal_mode(db.btrees[bt].pager, pager.JOURNALMODE_OFF)
        }
        if rc == base.OK -> rc = btree.btree_set_version(db.btrees[bt], if e_new == pager.JOURNALMODE_WAL -> 2 else -> 1)
    }
    if rc != base.OK -> e_new = e_old
    e_new = pager.pager_set_journal_mode(db.btrees[bt].pager, e_new)
    run.reg_set(v, o, base.mem_text(JOURNAL_MODE_NAMES[e_new].bytes(), base.UTF8))
    mem.change_encoding(v.mem[o], r.enc)
    if rc != base.OK -> return vc.fail(r, rc)
    GO_NEXT
}

// OP_Vacuum: vacuum database P1, into the file named by register P2 when
// P2 is set.
op_vacuum: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    into := base.Mem?{None}
    if r.p2 != 0 -> into = Val(v.mem[v.mem_base + r.p2].copy())
    msg := [U8]?{None}
    rc: h.run_vacuum(db, r.p1, into, msg)
    if msg == .Val(e) -> v.err_msg = Val(e)
    if rc != base.OK -> return vc.fail(r, rc)
    GO_NEXT
}

// OP_IncrVacuum: one step of incremental vacuum of database P1; jump to P2
// when there is nothing left to do.
op_incr_vacuum: fn(db: &conn.Conn, r: &Run) -[DB]> Int Never! {
    rc: btree.btree_incr_vacuum(db.btrees[db.dbs[r.p1].bt])
    if rc != base.OK {
        if rc != base.DONE -> return vc.fail(r, rc)
        return GO_JUMP
    }
    GO_NEXT
}

// OP_Expire: expire every statement (P1 = 0) or this one, at once (P2 = 0)
// or once it stops running (P2 = 1).
op_expire: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -> Int Never! {
    if r.p1 == 0 {
        conn.expire_prepared_statements(db, r.p2)
    } else {
        set_expired(db, v, r.p2 + 1)
    }
    GO_NEXT
}

// OP_CursorLock, OP_CursorUnlock: pin cursor P1's btree cursor (a write
// through another cursor must not move it) or unpin it.
op_cursor_lock: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -> Int Never! {
    ci: v.csr_base + r.p1
    if r.op == opc.OP_CURSOR_LOCK {
        btree.btree_cursor_pin(db.btrees[v.csr[ci].bt], v.csr[ci].btc)
    } else {
        btree.btree_cursor_unpin(db.btrees[v.csr[ci].bt], v.csr[ci].btc)
    }
    GO_NEXT
}

// ---------------------------------------------------------------------------
// Virtual tables. A virtual table cursor's vtab_cursor is the Host's
// handle, its vtab the Conn.vtables slot.

// OP_VBegin: the VTable of P4 joins the transaction (xBegin).
op_vbegin: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    vt: p4_vtab(v, r.pc)
    rc: aux.vtab_begin<H>(h, db, vt)
    if vt >= 0 -> aux.vtab_import_errmsg<H>(h, db, v, vt)
    if rc != base.OK -> return vc.fail(r, rc)
    GO_NEXT
}

// OP_VCreate: create the virtual table named by register P2 in database
// P1 (xCreate).
op_vcreate: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    m := v.mem[v.mem_base + r.p2].copy()
    rc := base.OK
    msg := [U8]?{None}
    if mem.value_text(m, base.UTF8) -> rc = h.vtab_call_create(db, r.p1, m.z, msg)
    if msg == .Val(e) -> v.err_msg = Val(e)
    if rc != base.OK -> return vc.fail(r, rc)
    GO_NEXT
}

// OP_VDestroy: destroy the virtual table P4 of database P1 (xDestroy).
op_vdestroy: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    db.n_vdestroy += 1
    rc: h.vtab_call_destroy(db, r.p1, run.p4_text(v, r.pc) ?? [U8]{})
    db.n_vdestroy -= 1
    if rc != base.OK -> return vc.fail(r, rc)
    GO_NEXT
}

// OP_VOpen: cursor P1 on the VTable of P4 (xOpen).
op_vopen: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    vt: p4_vtab(v, r.pc)
    if vt < 0 || db.vtables[vt].vtab < 0 -> return vc.fail(r, base.LOCKED)
    cursor := -1
    rc: h.vtab_open(db, vt, cursor)
    aux.vtab_import_errmsg<H>(h, db, v, vt)
    if rc != base.OK -> return vc.fail(r, rc)
    ci: run.alloc_cursor<H>(h, db, v, r.p1, 0, conn.CURTYPE_VTAB)
    v.csr[ci].vtab_cursor = cursor
    v.csr[ci].vtab = vt
    db.vtables[vt].n_cursor += 1
    GO_NEXT
}

// OP_VCheck: register P2 gets the xIntegrity report on the virtual table
// P4 of database P1 with flags P3, NULL when it finds nothing.
op_vcheck: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    o: v.mem_base + r.p2
    run.reg_null(v, o)
    tab: p4_table(v, r.pc)
    if tab < 0 -> return GO_NEXT
    vt: db.tables[tab].vtab
    if vt < 0 -> return GO_NEXT
    conn.vtab_lock(db, vt)
    msg := [U8]?{None}
    schema: db.dbs[r.p1].name.copy()
    name: db.tables[tab].name.copy()
    rc: h.vtab_integrity(db, vt, schema, name, r.p3, msg)
    conn.vtab_unlock(db, vt)
    aux.vtab_reap<H>(h, db)
    if rc != base.OK -> return vc.fail(r, rc)
    if msg == .Val(e) -> run.reg_set(v, o, base.mem_text(e, base.UTF8))
    GO_NEXT
}

// OP_VInitIn: register P2 becomes the "ValueList" pointer that
// sqlite3_vtab_in_first and _next read the IN list through: the values
// of ephemeral cursor P1, each into register P3. Its i is this op, whose
// operands name the cursor and register while the program runs.
op_vinit_in: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    o: v.mem_base + r.p2
    run.out2(v, o)
    m := base.mem_init(MEM_NULL.bit_or(conn.MEM_DYN).bit_or(MEM_SUBTYPE))
    m.subtype = conn.DYN_POINTER
    m.z = "ValueList".bytes()
    m.i = r.pc
    v.mem[o] = m
    GO_NEXT
}

// OP_VFilter: start cursor P1 with xFilter: idxNum in register P3, the
// argument count in P3+1 and the arguments from P3+2, idxStr P4; jump to
// P2 when it has no rows.
op_vfilter: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    q: v.mem_base + r.p3
    argc: v.mem[q + 1].i
    i_query: v.mem[q].i
    cur: v.csr[ci].vtab_cursor
    vt: v.csr[ci].vtab
    idx_str: run.p4_text(v, r.pc)
    rc: h.vtab_filter(db, v, cur, i_query, idx_str, q + 2, argc)
    aux.vtab_import_errmsg<H>(h, db, v, vt)
    if rc != base.OK -> return vc.fail(r, rc)
    eof: h.vtab_eof(db, cur)
    v.csr[ci].null_row = false
    if eof -> return GO_JUMP
    GO_NEXT
}

// OP_VColumn: column P2 of cursor P1's row into P3 (xColumn). With
// OPFLAG_NOCHNG the register starts as the "unchanged" NULL that
// sqlite3_vtab_nochange tests.
op_vcolumn: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    dest: v.mem_base + r.p3
    if v.csr[ci].null_row {
        run.reg_null(v, dest)
        return GO_NEXT
    }
    c := conn.func_context_new()
    c.out = dest
    c.func_flags = conn.FUNC_RESULT_SUBTYPE
    c.i_op = r.pc
    v.fctx = c
    run.release_dyn(v, dest)
    if r.p5.bit_and(conn.OPFLAG_NOCHNG) != 0 {
        mem.set_null(v.mem[dest])
        v.mem[dest].flags = MEM_NULL.bit_or(MEM_ZERO)
        v.mem[dest].i = 0
    } else {
        mem.set_type_flag(v.mem[dest], MEM_NULL)
    }
    vt: v.csr[ci].vtab
    rc := h.vtab_column(db, v, v.csr[ci].vtab_cursor, r.p2)
    aux.vtab_import_errmsg<H>(h, db, v, vt)
    if v.fctx.is_error > 0 {
        e: err_text(v, dest)
        aux.vdbe_error(v, e)
        rc = v.fctx.is_error
    }
    v.fctx.is_error = 0
    mem.change_encoding(v.mem[dest], r.enc)
    if rc != base.OK -> return vc.fail(r, rc)
    GO_NEXT
}

// OP_VNext: step cursor P1 (xNext) and jump to P2 while it has a row.
op_vnext: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    if v.csr[ci].null_row -> return GO_NEXT
    cur: v.csr[ci].vtab_cursor
    rc: h.vtab_next(db, cur)
    aux.vtab_import_errmsg<H>(h, db, v, v.csr[ci].vtab)
    if rc != base.OK -> return vc.fail(r, rc)
    if !h.vtab_eof(db, cur) -> return GO_JUMP_CHECK
    GO_NEXT_CHECK
}

// OP_VRename: rename the VTable of P4 to the name in register P1
// (xRename), under SQLITE_LegacyAlter.
op_vrename: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    vt: p4_vtab(v, r.pc)
    i: v.mem_base + r.p1
    legacy: db.flags.bit_and(conn.SQLITE_LEGACY_ALTER) != 0
    db.flags = db.flags.bit_or(conn.SQLITE_LEGACY_ALTER)
    mem.change_encoding(v.mem[i], base.UTF8)
    rc: h.vtab_rename(db, vt, v.mem[i].z.copy())
    if !legacy -> db.flags = clear_bits(db.flags, conn.SQLITE_LEGACY_ALTER)
    aux.vtab_import_errmsg<H>(h, db, v, vt)
    set_expired(db, v, 0)
    if rc != base.OK -> return vc.fail(r, rc)
    GO_NEXT
}

// OP_VUpdate: xUpdate of the VTable of P4 with the P2 values from register
// P3 (a delete, an insert or an update), under the conflict mode P5; with
// P1 set an inserted row's rowid becomes the last rowid.
op_vupdate: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    if db.malloc_failed -> return GO_NO_MEM
    vt: p4_vtab(v, r.pc)
    if vt < 0 || db.vtables[vt].vtab < 0 -> return vc.fail(r, base.LOCKED)
    on_conflict: db.vtab_on_conflict
    db.vtab_on_conflict = r.p5
    rowid := 0
    rc := h.vtab_update(db, v, vt, v.mem_base + r.p3, r.p2, rowid)
    db.vtab_on_conflict = on_conflict
    aux.vtab_import_errmsg<H>(h, db, v, vt)
    if rc == base.OK && r.p1 != 0 -> db.last_rowid = rowid
    if rc.bit_and(255) == base.CONSTRAINT && db.vtables[vt].b_constraint {
        if r.p5 == ast.OE_IGNORE {
            rc = base.OK
        } else {
            v.error_action = if r.p5 == ast.OE_REPLACE -> ast.OE_ABORT else -> r.p5
        }
    } else {
        v.n_change += 1
    }
    if rc != base.OK -> return vc.fail(r, rc)
    GO_NEXT
}

// ---------------------------------------------------------------------------
// Page counts, subtypes, Bloom filters and the program start.

// OP_Pagecount: the pages of database P1 into P2.
op_pagecount: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -> Int Never! {
    o: v.mem_base + r.p2
    run.out2(v, o)
    v.mem[o].i = btree.btree_last_page(db.btrees[db.dbs[r.p1].bt])
    GO_NEXT
}

// OP_MaxPgcnt: the page limit of database P1 becomes P3 (not below its
// size) unless P3 is 0; the limit into P2.
op_max_pgcnt: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -> Int Never! {
    o: v.mem_base + r.p2
    run.out2(v, o)
    bt: db.dbs[r.p1].bt
    new_max := 0
    if r.p3 != 0 {
        new_max = btree.btree_last_page(db.btrees[bt])
        if new_max < r.p3 -> new_max = r.p3
    }
    v.mem[o].i = btree.btree_max_page_count(db.btrees[bt], new_max)
    GO_NEXT
}

// OP_ClrSubtype, OP_GetSubtype, OP_SetSubtype: drop register P1's subtype;
// copy it into P2 as an integer (NULL when it has none); or give P2 the
// subtype in P1 (none when P1 is NULL).
op_subtype: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    if r.op == opc.OP_CLR_SUBTYPE {
        v.mem[i].flags = clear_bits(v.mem[i].flags, MEM_SUBTYPE)
        return GO_NEXT
    }
    o: v.mem_base + r.p2
    if r.op == opc.OP_GET_SUBTYPE {
        if v.mem[i].flags.bit_and(MEM_SUBTYPE) != 0 {
            run.reg_int(v, o, v.mem[i].subtype)
        } else {
            run.reg_null(v, o)
        }
        return GO_NEXT
    }
    if v.mem[i].flags.bit_and(MEM_NULL) != 0 {
        v.mem[o].flags = clear_bits(v.mem[o].flags, MEM_SUBTYPE)
    } else {
        v.mem[o].flags = v.mem[o].flags.bit_or(MEM_SUBTYPE)
        v.mem[o].subtype = v.mem[i].i.bit_and(255)
    }
    GO_NEXT
}

// The bit of the Bloom filter blob in register i for the P4 registers
// from P3 of op r.
filter_bit: fn(v: conn.Vdbe, r: Run, i: Int) -> Int Never! {
    run.filter_hash(v, v.mem_base + r.p3, run.p4_int(v, r.pc)) % (v.mem[i].z.len() * 8)
}

// OP_FilterAdd: add the P4 registers from P3 to the Bloom filter in P1.
op_filter_add: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    b: filter_bit(v, r, i)
    at: b >> 3
    v.mem[i].z[at] = U8{Int.from_u8(v.mem[i].z[at]).bit_or(1 << b.bit_and(7))}
    GO_NEXT
}

// OP_Filter: jump to P2 when the P4 registers from P3 are surely not in
// the Bloom filter in P1.
op_filter: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    i: v.mem_base + r.p1
    b: filter_bit(v, r, i)
    if Int.from_u8(v.mem[i].z[b >> 3]).bit_and(1 << b.bit_and(7)) == 0 {
        v.counters[conn.STMTSTATUS_FILTER_HIT] = v.counters[conn.STMTSTATUS_FILTER_HIT] + 1
        return GO_JUMP
    }
    v.counters[conn.STMTSTATUS_FILTER_MISS] = v.counters[conn.STMTSTATUS_FILTER_MISS] + 1
    GO_NEXT
}

// sqlite3GlobalConfig.iOnceResetThreshold: OP_Init's run count at which
// it resets the OP_Once flags (and its count).
ONCE_RESET_THRESHOLD: 2147483646

// OP_Init, OP_Trace: report the statement's SQL (P4, else its text) to the
// trace callback, count the run and jump to P2. OP_Init's P1 counts the
// runs, the value OP_Once compares its P1 with.
op_init: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    if db.m_trace.bit_and(conn.TRACE_STMT) != 0 && v.min_write_file_format != 254 {
        z: run.p4_text(v, r.pc) ?? v.sql.copy()
        if z.len() > 0 {
            text := if db.n_vdbe_exec > 1 -> "-- ".bytes() else -> [U8]{}
            aux.append_bytes(text, z)
            h.trace(db, v, conn.TRACE_STMT, text)
        }
    }
    if r.p1 >= ONCE_RESET_THRESHOLD {
        if r.op == opc.OP_TRACE -> return GO_NEXT
        loop i in 1..<v.ops.len() {
            if v.ops[i].opcode == opc.OP_ONCE -> run.set_p1(v, i, 0)
        }
        run.set_p1(v, r.pc, 0)
    }
    run.set_p1(v, r.pc, v.ops[r.pc].p1 + 1)
    v.counters[conn.STMTSTATUS_RUN] = v.counters[conn.STMTSTATUS_RUN] + 1
    GO_JUMP
}

#Test("RowSets drain in order and probes see earlier batches") {
    v := conn.vdbe_new()
    loop _ in 0..<4 -> v.mem.push(base.mem_null())
    v.ops.push(test_op(opc.OP_ROW_SET_TEST, conn.P4.Int32(1)))
    v.ops.push(test_op(opc.OP_ROW_SET_TEST, conn.P4.Int32(2)))
    v.mem[2] = base.mem_int(7)
    r := test_run(v, 0, 1, 0, 2)
    assert_eq(op_row_set_test(v, r), GO_NEXT)
    assert(is_rowset(v, 1))
    r2 := test_run(v, 1, 1, 0, 2)
    assert_eq(op_row_set_test(v, r2), GO_JUMP)
    add := test_run(v, 0, 0, 2, 0)
    assert_eq(op_row_set_add(v, add), GO_NEXT)
    v.mem[2] = base.mem_int(3)
    assert_eq(op_row_set_add(v, add), GO_NEXT)
    rd := test_run(v, 0, 0, 0, 3)
    assert_eq(op_row_set_read(v, rd), GO_NEXT_CHECK)
    assert_eq(v.mem[3].i, 3)
    assert_eq(op_row_set_read(v, rd), GO_NEXT_CHECK)
    assert_eq(v.mem[3].i, 7)
    assert_eq(op_row_set_read(v, rd), GO_JUMP_CHECK)
    assert(v.mem[0].flags == MEM_NULL && v.rowset_free.len() == 1 && is_rowset(v, 1))
}

#Test("limits and counters count as vdbe.c counts them") {
    v := conn.vdbe_new()
    loop _ in 0..<4 -> v.mem.push(base.mem_int(0))
    v.ops.push(test_op(opc.OP_OFFSET_LIMIT, conn.P4.NotUsed))
    v.mem[1] = base.mem_int(10)
    v.mem[3] = base.mem_int(5)
    r := test_run(v, 0, 1, 2, 3)
    assert_eq(op_offset_limit(v, r), GO_NEXT)
    assert_eq(v.mem[2].i, 15)
    v.mem[1] = base.mem_int(base.I64_MAX)
    _: op_offset_limit(v, r)
    assert_eq(v.mem[2].i, -1)
    v.mem[1] = base.mem_int(2)
    pos := test_run(v, 0, 1, 0, 1)
    assert_eq(op_if_pos(v, pos), GO_JUMP)
    assert_eq(v.mem[1].i, 1)
    dz := test_run(v, 0, 1, 0, 0)
    assert_eq(op_decr_jump_zero(v, dz), GO_JUMP)
    assert_eq(op_if_not_zero(v, dz), GO_NEXT)
    v.mem[2] = base.mem_text("9".bytes(), base.UTF8)
    mx := test_run(v, 0, 1, 2, 0)
    assert_eq(op_mem_max(v, mx), GO_NEXT)
    assert_eq(v.mem[1].i, 9)
}

#Test("a Bloom filter finds what was added") {
    v := conn.vdbe_new()
    v.mem.push(base.mem_null())
    v.mem.push(base.mem_blob([U8]{0, 0, 0, 0, 0, 0, 0, 0}))
    v.mem.push(base.mem_int(42))
    v.ops.push(test_op(opc.OP_FILTER_ADD, conn.P4.Int32(1)))
    r := test_run(v, 0, 1, 0, 2)
    assert_eq(op_filter(v, r), GO_JUMP)
    assert_eq(op_filter_add(v, r), GO_NEXT)
    assert_eq(op_filter(v, r), GO_NEXT)
    assert(v.counters[conn.STMTSTATUS_FILTER_HIT] == 1 && v.counters[conn.STMTSTATUS_FILTER_MISS] == 1)
}

#Test("subtypes travel between registers") {
    v := conn.vdbe_new()
    v.mem.push(base.mem_int(74))
    v.mem.push(base.mem_text("x".bytes(), base.UTF8))
    v.ops.push(test_op(opc.OP_SET_SUBTYPE, conn.P4.NotUsed))
    v.ops.push(test_op(opc.OP_GET_SUBTYPE, conn.P4.NotUsed))
    v.ops.push(test_op(opc.OP_CLR_SUBTYPE, conn.P4.NotUsed))
    set := test_run(v, 0, 0, 1, 0)
    _: op_subtype(v, set)
    assert(v.mem[1].flags.bit_and(MEM_SUBTYPE) != 0 && v.mem[1].subtype == 74)
    get := test_run(v, 1, 1, 0, 0)
    _: op_subtype(v, get)
    assert_eq(v.mem[0].i, 74)
    clr := test_run(v, 2, 1, 0, 0)
    _: op_subtype(v, clr)
    assert(v.mem[1].flags.bit_and(MEM_SUBTYPE) == 0)
}

#Test("a trigger program runs on registers of its own and reads its caller's") {
    db := conn.conn_new()
    v := conn.vdbe_new()
    v.n_mem = 3
    loop _ in 0..<3 -> v.mem.push(base.mem_null())
    v.mem[2] = base.mem_int(11)
    sub: conn.SubProgram{ops: [conn.VdbeOp]{test_op(opc.OP_PARAM, conn.P4.NotUsed), test_op(opc.OP_HALT, conn.P4.NotUsed)}, n_mem: 2, n_csr: 0, token: 5}
    v.programs.push(sub)
    prog := test_op(opc.OP_PROGRAM, conn.P4.Program(0))
    prog.p1 = 1
    v.ops.push(prog.copy())
    r := test_run(v, 0, 1, 0, 0)
    assert_eq(op_program(db, v, r), GO_NEXT_CHECK)
    assert(r.pc == -1 && v.frames.len() == 1 && v.mem_base == 3 && v.mem.len() == 6 && v.ops.len() == 2)
    pr := test_run(v, 0, 1, 1, 0)
    assert_eq(op_param(v, pr), GO_NEXT)
    assert_eq(v.mem[4].i, 11)
    v.ops[0] = prog
    r.p5 = 1
    r.pc = 0
    assert_eq(op_program(db, v, r), GO_NEXT)
}
