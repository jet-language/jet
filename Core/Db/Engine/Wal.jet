// The write-ahead log of the Jet SQLite engine: a port of SQLite 3.45.0
// wal.c. A transaction appends the pages it changed to the -wal file as
// frames; readers find the newest frame of a page through the wal-index,
// the hash tables in the -shm file the connections share; a checkpoint
// copies the frames back into the database file.
//
// The wal-index is not memory-mapped here. Its 32 KiB regions are read
// into this connection's copies (C's apWiData pages), and the parts other
// connections change while this one reads are read and written in place
// through the shared-memory file:
//
//  * The two copies of the index header (bytes 0..<96) and the checkpoint
//    information (bytes 96..<136) are always read and written in the file.
//  * A region copy is reloaded after walIndexTryHdr finds a changed header
//    (every frame of the new snapshot is then in the file), and the region
//    of the next frame is reloaded when a write transaction begins (so the
//    writer sees what other writers' rollbacks left there, as C does).
//  * The writer changes only its copies. The bytes it changed are written
//    to the file before each index header (walIndexWriteHdr) and dropped
//    when the write transaction ends without a commit.
//
// In heap-memory mode (exclusive locking without shared memory) and over an
// unreliable read-only -shm file the copies are the wal-index itself, as
// C's heap pages are. An I/O error of the shared-memory file, which C sees
// as a fault in the mapping (the SEH build's SQLITE_IOERR_IN_PAGE), is
// kept in shm_rc and returned by the call that hit it.
//
// The build has no SQLITE_ENABLE_SNAPSHOT, SQLITE_ENABLE_SETLK_TIMEOUT or
// memory-mapped I/O, and no sqlite3_log consumer, so the recovery notice
// and the walLimitSize warning are not logged. The checkpoint loop's
// interrupt check (db->u1.isInterrupted) belongs to the connection, which
// has no interrupt flag yet; the loop runs to the end. walIteratorInit's
// merge sort is a sort of (page, frame) keys: the iterator visits the same
// pages, each with its last frame, in the same order. SQLITE_BIGENDIAN is
// 0 (the hosts are little-endian), so the index header is little-endian
// and native checksums read little-endian words.

use {
    base: __core_db_base
    util: __core_db_util
    os: __core_db_os
    file: __core_db_file
    cache: __core_db_pcache
}

// wal.c constants.
WAL_MAX_VERSION: 3007000
WALINDEX_MAX_VERSION: 3007000
WAL_WRITE_LOCK: 0
WAL_ALL_BUT_WRITE: 1
WAL_CKPT_LOCK: 1
WAL_RECOVER_LOCK: 2
WAL_NREADER: 5
READMARK_NOT_USED: 4294967295
WAL_FRAME_HDRSIZE: 24
WAL_HDRSIZE: 32
// 0x377f0682.
WAL_MAGIC: 931071618
HASHTABLE_NPAGE: 4096
HASHTABLE_HASH_1: 383
HASHTABLE_NSLOT: 8192
HASHTABLE_NPAGE_ONE: 4062
WALINDEX_PGSZ: 32768
// sizeof(WalIndexHdr) * 2 + sizeof(WalCkptInfo).
WALINDEX_HDR_SIZE: 136
// The byte offset of aHash in a region (aPgno[HASHTABLE_NPAGE]).
HASH_AT: 16384
// SQLITE_MAX_PAGE_SIZE.
WAL_MAX_PAGE_SIZE: 65536

// Wal.exclusiveMode.
WAL_NORMAL_MODE: 0
WAL_EXCLUSIVE_MODE: 1
WAL_HEAPMEMORY_MODE: 2

// Wal.readOnly.
WAL_RDWR: 0
WAL_RDONLY: 1
WAL_SHM_RDONLY: 2

// walIndexReadHdr and walTryBeginRead: retry the read transaction.
WAL_RETRY: -1
WAL_RETRY_PROTOCOL_LIMIT: 100

// sqlite3_wal_checkpoint_v2 modes (sqlite3.h SQLITE_CHECKPOINT_*).
CHECKPOINT_PASSIVE: 0
CHECKPOINT_FULL: 1
CHECKPOINT_RESTART: 2
CHECKPOINT_TRUNCATE: 3

// WalIndexHdr field offsets (native byte order).
HDR_VERSION: 0
HDR_CHANGE: 8
HDR_ISINIT: 12
HDR_BIGEND: 13
HDR_SZPAGE: 14
HDR_MXFRAME: 16
HDR_NPAGE: 20
HDR_FRAME_CKSUM: 24
HDR_SALT: 32
HDR_CKSUM: 40
HDR_SIZE: 48

// WalCkptInfo field offsets in region 0.
CKPT_NBACKFILL: 96
CKPT_READMARK: 100
CKPT_ATTEMPTED: 128

// sqliteDefaultBusyCallback's delay schedule in milliseconds and the
// running totals of it (main.c).
BUSY_DELAYS: [Int]{1, 2, 5, 10, 15, 20, 25, 25, 25, 50, 50, 100}
BUSY_TOTALS: [Int]{0, 1, 3, 8, 18, 33, 53, 78, 103, 128, 178, 228}

// sqlite3.busyHandler with the default handler of sqlite3_busy_timeout:
// timeout is db->busyTimeout (0 means no handler), n_busy is nBusy. The
// pager's lock loop and the checkpoint's walBusyLock both invoke it.
BusyHandler: struct {
    timeout: Int
    n_busy: Int
}

// sqlite3InvokeBusyHandler with sqliteDefaultBusyCallback (the HAVE_USLEEP
// schedule): true to retry the lock.
busy_invoke: fn(b: &BusyHandler) -[DB]> Bool Never! {
    if b.timeout <= 0 || b.n_busy < 0 -> return false
    count: b.n_busy
    n: BUSY_DELAYS.len()
    delay := 0
    prior := 0
    if count < n {
        delay = BUSY_DELAYS[count]
        prior = BUSY_TOTALS[count]
    } else {
        delay = BUSY_DELAYS[n - 1]
        prior = BUSY_TOTALS[n - 1] + delay * (count - (n - 1))
    }
    if prior + delay > b.timeout {
        delay = b.timeout - prior
        if delay <= 0 {
            b.n_busy = -1
            return false
        }
    }
    _: os.os_sleep(delay * 1000)
    b.n_busy += 1
    true
}

// An open write-ahead log (wal.c struct Wal). `open` false is the null
// Wal pointer. The database file (pDbFd), whose shared memory holds the
// wal-index, is passed to each call.
Wal: struct {
    open: Bool
    // pWalFd and zWalName.
    fd: file.SQLFile
    name: String
    // iCallback and mxWalSize.
    callback: Int
    mx_wal_size: Int
    // apWiData: the region copies ([U8]{} is a null page), whether each is
    // current, and the byte range of each the writer changed.
    wi: [[U8]]
    wi_fresh: [Bool]
    wi_lo: [Int]
    wi_hi: [Int]
    sz_page: Int
    read_lock: Int
    exclusive_mode: Int
    write_lock: Bool
    ckpt_lock: Bool
    read_only: Int
    truncate_on_commit: Bool
    sync_header: Bool
    pad_to_sector_boundary: Bool
    shm_unreliable: Bool
    // hdr: the WalIndexHdr of the snapshot, 48 bytes in native order.
    hdr: [U8]
    min_frame: Int
    re_cksum: Int
    n_ckpt: Int
    // The first shared-memory I/O error not yet returned.
    shm_rc: Int
}

// The null Wal.
wal_closed: fn() -> Wal Never! {
    Wal{open: false, fd: file.file_closed(), name: "", callback: 0, mx_wal_size: 0, wi: [[U8]]{}, wi_fresh: [Bool]{}, wi_lo: [Int]{}, wi_hi: [Int]{}, sz_page: 0, read_lock: -1, exclusive_mode: WAL_NORMAL_MODE, write_lock: false, ckpt_lock: false, read_only: WAL_RDWR, truncate_on_commit: false, sync_header: true, pad_to_sector_boundary: true, shm_unreliable: false, hdr: wal_zeros(HDR_SIZE), min_frame: 0, re_cksum: 0, n_ckpt: 0, shm_rc: base.OK}
}

// n zero bytes.
wal_zeros: fn(n: Int) -> [U8] Never! {
    out := [U8]{}
    loop _ in 0..<n -> out.push(U8{0})
    out
}

// A little-endian (native) 32-bit word.
le_get4: fn(b: [U8], at: Int) -> Int Never! {
    Int.from_u8(b[at]).bit_or(Int.from_u8(b[at + 1]) << 8).bit_or(Int.from_u8(b[at + 2]) << 16).bit_or(Int.from_u8(b[at + 3]) << 24)
}

le_put4: fn(b: &[U8], at: Int, v: Int) Never! {
    b[at] = U8{v.bit_and(255)}
    b[at + 1] = U8{(v >> 8).bit_and(255)}
    b[at + 2] = U8{(v >> 16).bit_and(255)}
    b[at + 3] = U8{(v >> 24).bit_and(255)}
}

// A little-endian (native) 16-bit word.
le_get2: fn(b: [U8], at: Int) -> Int Never! { Int.from_u8(b[at]).bit_or(Int.from_u8(b[at + 1]) << 8) }

le_put2: fn(b: &[U8], at: Int, v: Int) Never! {
    b[at] = U8{v.bit_and(255)}
    b[at + 1] = U8{(v >> 8).bit_and(255)}
}

// A field of the snapshot header.
hdr_get: fn(w: Wal, off: Int) -> Int Never! { le_get4(w.hdr, off) }

hdr_set: fn(w: &Wal, off: Int, v: Int) Never! { le_put4(w.hdr, off, v.bit_and(os.U32_MASK)) }

// pWal->hdr.mxFrame.
wal_mx_frame: fn(w: Wal) -> Int Never! { le_get4(w.hdr, HDR_MXFRAME) }

// WAL_READ_LOCK(i).
read_lock: fn(i: Int) -> Int Never! { 3 + i }

// WAL_SYNC_FLAGS and CKPT_SYNC_FLAGS.
wal_sync_flags: fn(f: Int) -> Int Never! { f.bit_and(3) }

ckpt_sync_flags: fn(f: Int) -> Int Never! { (f >> 2).bit_and(3) }

// walFrameOffset.
wal_frame_offset: fn(frame: Int, sz_page: Int) -> Int Never! { WAL_HDRSIZE + (frame - 1) * (sz_page + WAL_FRAME_HDRSIZE) }

// The wal-index lives only in this connection's copies.
wal_local: fn(w: Wal) -> Bool Never! { w.exclusive_mode == WAL_HEAPMEMORY_MODE || w.shm_unreliable }

// Keep the first shared-memory error.
shm_fail: fn(w: &Wal, rc: Int) Never! {
    if rc != base.OK && w.shm_rc == base.OK -> w.shm_rc = rc
}

// The result of a call that read or wrote the wal-index: rc, or the
// shared-memory error it hit (C's SEH_EXCEPT).
wal_shm_result: fn(w: &Wal, rc: Int) -> Int Never! {
    e: w.shm_rc
    w.shm_rc = base.OK
    if e != base.OK && rc == base.OK -> return e
    rc
}

// Read n bytes of region 0 at `offset` into buf[at..]: the shared header
// (walIndexHdr) and checkpoint information (walCkptInfo).
wi_read: fn(w: &Wal, db: &file.SQLFile, offset: Int, buf: &[U8], at: Int, n: Int) Never! -[DB]> {
    if wal_local(w) {
        if w.wi.len() == 0 || w.wi[0].len() == 0 {
            loop i in 0..<n -> buf[at + i] = U8{0}
            return
        }
        loop i in 0..<n -> buf[at + i] = w.wi[0][offset + i]
        return
    }
    rc: file.file_shm_read(db, offset, buf, at, n)
    if rc != base.OK {
        loop i in 0..<n -> buf[at + i] = U8{0}
        shm_fail(w, rc)
    }
}

// Write data[at..<at+n] to region 0 at `offset`.
wi_write: fn(w: &Wal, db: &file.SQLFile, offset: Int, data: [U8], at: Int, n: Int) Never! -[DB]> {
    if wal_local(w) {
        if w.wi.len() == 0 || w.wi[0].len() == 0 -> return
        loop i in 0..<n -> w.wi[0][offset + i] = data[at + i]
        return
    }
    shm_fail(w, file.file_shm_write(db, offset, data, at, n))
}

// A 32-bit word of the shared header or checkpoint information.
wi_get4: fn(w: &Wal, db: &file.SQLFile, offset: Int) -[DB]> Int Never! {
    b := wal_zeros(4)
    wi_read(w, db, offset, b, 0, 4)
    le_get4(b, 0)
}

wi_set4: fn(w: &Wal, db: &file.SQLFile, offset: Int, v: Int) Never! -[DB]> {
    b := wal_zeros(4)
    le_put4(b, 0, v.bit_and(os.U32_MASK))
    wi_write(w, db, offset, b, 0, 4)
}

// The shared header aHdr[0], 48 bytes.
wi_live_hdr: fn(w: &Wal, db: &file.SQLFile) -[DB]> [U8] Never! {
    h := wal_zeros(HDR_SIZE)
    wi_read(w, db, 0, h, 0, HDR_SIZE)
    h
}

// Widen the changed range of region i to cover lo..<hi.
wi_dirty: fn(w: &Wal, i: Int, lo: Int, hi: Int) Never! {
    if w.wi_hi[i] <= w.wi_lo[i] {
        w.wi_lo[i] = lo
        w.wi_hi[i] = hi
        return
    }
    if lo < w.wi_lo[i] -> w.wi_lo[i] = lo
    if hi > w.wi_hi[i] -> w.wi_hi[i] = hi
}

// Store words in region i's copy.
wi_put4: fn(w: &Wal, i: Int, at: Int, v: Int) Never! {
    le_put4(w.wi[i], at, v)
    wi_dirty(w, i, at, at + 4)
}

wi_put2: fn(w: &Wal, i: Int, at: Int, v: Int) Never! {
    le_put2(w.wi[i], at, v)
    wi_dirty(w, i, at, at + 2)
}

// memset of region i's copy over lo..<hi.
wi_zero: fn(w: &Wal, i: Int, lo: Int, hi: Int) Never! {
    if hi <= lo -> return
    loop k in lo..<hi -> w.wi[i][k] = U8{0}
    wi_dirty(w, i, lo, hi)
}

// Write the changed ranges of the region copies to the shared memory,
// never the header bytes of region 0, which are written in place.
wal_flush: fn(w: &Wal, db: &file.SQLFile) Never! -[DB]> {
    local: wal_local(w)
    loop i in 0..<w.wi.len() {
        lo := w.wi_lo[i]
        hi: w.wi_hi[i]
        w.wi_lo[i] = 0
        w.wi_hi[i] = 0
        if local || hi <= lo -> next
        if i == 0 && lo < WALINDEX_HDR_SIZE -> lo = WALINDEX_HDR_SIZE
        if hi <= lo -> next
        rc: file.file_shm_write(db, i * WALINDEX_PGSZ + lo, w.wi[i], lo, hi - lo)
        shm_fail(w, rc)
    }
}

// The region copies no longer show the shared memory (a new snapshot).
wal_stale_all: fn(w: &Wal) Never! {
    if wal_local(w) -> return
    loop i in 0..<w.wi.len() {
        w.wi_fresh[i] = false
        w.wi_lo[i] = 0
        w.wi_hi[i] = 0
    }
}

// Drop what the writer changed without committing: the regions it changed
// are read again.
wal_drop_dirty: fn(w: &Wal) Never! {
    local: wal_local(w)
    loop i in 0..<w.wi.len() {
        if w.wi_hi[i] > w.wi_lo[i] && !local -> w.wi_fresh[i] = false
        w.wi_lo[i] = 0
        w.wi_hi[i] = 0
    }
}

// Forget every region copy (sqlite3_free of the apWiData pages).
wal_free_pages: fn(w: &Wal) Never! {
    loop i in 0..<w.wi.len() {
        w.wi[i] = [U8]{}
        w.wi_fresh[i] = false
        w.wi_lo[i] = 0
        w.wi_hi[i] = 0
    }
}

// walIndexPage with walIndexPageRealloc: region i into w.wi[i]; present is
// false for C's null page.
wal_index_page: fn(w: &Wal, db: &file.SQLFile, i: Int, present: &Bool) -[DB]> Int Never! {
    present = false
    loop w.wi.len() <= i {
        w.wi.push([U8]{})
        w.wi_fresh.push(false)
        w.wi_lo.push(0)
        w.wi_hi.push(0)
    }
    if w.wi[i].len() > 0 && (w.wi_fresh[i] || wal_local(w)) {
        present = true
        return base.OK
    }
    if w.exclusive_mode == WAL_HEAPMEMORY_MODE {
        w.wi[i] = wal_zeros(WALINDEX_PGSZ)
        w.wi_fresh[i] = true
        present = true
        return base.OK
    }
    mapped := false
    rc := file.file_shm_map(db, i, WALINDEX_PGSZ, w.write_lock, mapped)
    if rc != base.OK && rc.bit_and(255) == base.READONLY {
        w.read_only = w.read_only.bit_or(WAL_SHM_RDONLY)
        if rc == base.READONLY -> rc = base.OK
    }
    if !mapped {
        w.wi[i] = [U8]{}
        w.wi_fresh[i] = false
        return rc
    }
    if w.wi[i].len() != WALINDEX_PGSZ -> w.wi[i] = wal_zeros(WALINDEX_PGSZ)
    got: file.file_shm_read(db, i * WALINDEX_PGSZ, w.wi[i], 0, WALINDEX_PGSZ)
    if got != base.OK {
        w.wi[i] = [U8]{}
        w.wi_fresh[i] = false
        return got
    }
    w.wi_fresh[i] = true
    w.wi_lo[i] = 0
    w.wi_hi[i] = 0
    present = true
    rc
}

// walChecksumBytes: two running sums over a[at..<at+n] (n a multiple of
// 8), as 32-bit words in native (little-endian) or swapped order.
WalCksum: struct {
    s1: Int
    s2: Int
}

wal_checksum: fn(native: Bool, a: [U8], at: Int, n: Int, s1_in: Int, s2_in: Int) -> WalCksum Never! {
    m: os.U32_MASK
    s1 := s1_in
    s2 := s2_in
    i := at
    end: at + n
    if native {
        loop i < end {
            s1 = (s1 + le_get4(a, i) + s2).bit_and(m)
            s2 = (s2 + le_get4(a, i + 4) + s1).bit_and(m)
            i += 8
        }
    } else {
        loop i < end {
            s1 = (s1 + util.get4(a, i) + s2).bit_and(m)
            s2 = (s2 + util.get4(a, i + 4) + s1).bit_and(m)
            i += 8
        }
    }
    WalCksum{s1: s1, s2: s2}
}

// walIndexWriteHdr: publish w.hdr as the shared header, after the region
// bytes the writer changed.
wal_index_write_hdr: fn(w: &Wal, db: &file.SQLFile) Never! -[DB]> {
    wal_flush(w, db)
    w.hdr[HDR_ISINIT] = U8{1}
    hdr_set(w, HDR_VERSION, WALINDEX_MAX_VERSION)
    ck: wal_checksum(true, w.hdr, 0, HDR_CKSUM, 0, 0)
    hdr_set(w, HDR_CKSUM, ck.s1)
    hdr_set(w, HDR_CKSUM + 4, ck.s2)
    h: w.hdr.copy()
    wi_write(w, db, HDR_SIZE, h, 0, HDR_SIZE)
    wi_write(w, db, 0, h, 0, HDR_SIZE)
}

// walEncodeFrame: the 24-byte header of the frame of page pgno whose data
// is data[at..<at+sz_page], into frame; it advances the running checksum.
wal_encode_frame: fn(w: &Wal, pgno: Int, n_truncate: Int, data: [U8], at: Int, frame: &[U8]) Never! {
    util.put4(frame, 0, pgno)
    util.put4(frame, 4, n_truncate)
    if w.re_cksum == 0 {
        loop k in 0..<8 -> frame[8 + k] = w.hdr[HDR_SALT + k]
        native: Int.from_u8(w.hdr[HDR_BIGEND]) == 0
        c0: wal_checksum(native, frame, 0, 8, hdr_get(w, HDR_FRAME_CKSUM), hdr_get(w, HDR_FRAME_CKSUM + 4))
        c1: wal_checksum(native, data, at, w.sz_page, c0.s1, c0.s2)
        hdr_set(w, HDR_FRAME_CKSUM, c1.s1)
        hdr_set(w, HDR_FRAME_CKSUM + 4, c1.s2)
        util.put4(frame, 16, c1.s1)
        util.put4(frame, 20, c1.s2)
    } else {
        loop k in 8..<24 -> frame[k] = U8{0}
    }
}

// walDecodeFrame: whether frame (header then page data) is a valid frame
// of this log; it advances the running checksum.
wal_decode_frame: fn(w: &Wal, frame: [U8], pgno: &Int, n_truncate: &Int) -> Bool Never! {
    loop k in 0..<8 {
        if frame[8 + k] != w.hdr[HDR_SALT + k] -> return false
    }
    pg: util.get4(frame, 0)
    if pg == 0 -> return false
    native: Int.from_u8(w.hdr[HDR_BIGEND]) == 0
    c0: wal_checksum(native, frame, 0, 8, hdr_get(w, HDR_FRAME_CKSUM), hdr_get(w, HDR_FRAME_CKSUM + 4))
    c1: wal_checksum(native, frame, WAL_FRAME_HDRSIZE, w.sz_page, c0.s1, c0.s2)
    hdr_set(w, HDR_FRAME_CKSUM, c1.s1)
    hdr_set(w, HDR_FRAME_CKSUM + 4, c1.s2)
    if c1.s1 != util.get4(frame, 16) || c1.s2 != util.get4(frame, 20) -> return false
    pgno = pg
    n_truncate = util.get4(frame, 4)
    true
}

// walLockShared, walUnlockShared, walLockExclusive and walUnlockExclusive:
// no-ops in exclusive mode.
wal_lock_shared: fn(w: &Wal, db: &file.SQLFile, idx: Int) -[DB]> Int Never! {
    if w.exclusive_mode != WAL_NORMAL_MODE -> return base.OK
    file.file_shm_lock(db, idx, 1, os.SHM_LOCK.bit_or(os.SHM_SHARED))
}

wal_unlock_shared: fn(w: &Wal, db: &file.SQLFile, idx: Int) Never! -[DB]> {
    if w.exclusive_mode != WAL_NORMAL_MODE -> return
    _: file.file_shm_lock(db, idx, 1, os.SHM_UNLOCK.bit_or(os.SHM_SHARED))
}

wal_lock_exclusive: fn(w: &Wal, db: &file.SQLFile, idx: Int, n: Int) -[DB]> Int Never! {
    if w.exclusive_mode != WAL_NORMAL_MODE -> return base.OK
    file.file_shm_lock(db, idx, n, os.SHM_LOCK.bit_or(os.SHM_EXCLUSIVE))
}

wal_unlock_exclusive: fn(w: &Wal, db: &file.SQLFile, idx: Int, n: Int) Never! -[DB]> {
    if w.exclusive_mode != WAL_NORMAL_MODE -> return
    _: file.file_shm_lock(db, idx, n, os.SHM_UNLOCK.bit_or(os.SHM_EXCLUSIVE))
}

// walHash and walNextHash.
wal_hash: fn(pgno: Int) -> Int Never! { (pgno * HASHTABLE_HASH_1).bit_and(HASHTABLE_NSLOT - 1) }

wal_next_hash: fn(k: Int) -> Int Never! { (k + 1).bit_and(HASHTABLE_NSLOT - 1) }

// walFramePage: the hash table (region) of a frame.
wal_frame_page: fn(frame: Int) -> Int Never! { (frame + HASHTABLE_NPAGE - HASHTABLE_NPAGE_ONE - 1) /% HASHTABLE_NPAGE }

// WalHashLoc: region `page`, whose aPgno starts at byte pgno_at; zero is
// one less than the first frame it indexes.
WalHashLoc: struct {
    page: Int
    pgno_at: Int
    zero: Int
}

wal_hash_loc: fn() -> WalHashLoc Never! { WalHashLoc{page: 0, pgno_at: 0, zero: 0} }

// walHashGet.
wal_hash_get: fn(w: &Wal, db: &file.SQLFile, i: Int, loc: &WalHashLoc) -[DB]> Int Never! {
    present := false
    rc := wal_index_page(w, db, i, present)
    if present {
        loc.page = i
        if i == 0 {
            loc.pgno_at = WALINDEX_HDR_SIZE
            loc.zero = 0
        } else {
            loc.pgno_at = 0
            loc.zero = HASHTABLE_NPAGE_ONE + (i - 1) * HASHTABLE_NPAGE
        }
    } else if rc == base.OK {
        rc = base.ERROR
    }
    rc
}

// aPgno[k] and aHash[k] of a located hash table.
loc_pgno: fn(w: Wal, loc: WalHashLoc, k: Int) -> Int Never! { le_get4(w.wi[loc.page], loc.pgno_at + 4 * k) }

loc_hash: fn(w: Wal, loc: WalHashLoc, k: Int) -> Int Never! { le_get2(w.wi[loc.page], HASH_AT + 2 * k) }

// walFramePgno: the page of a frame whose region is loaded.
wal_frame_pgno: fn(w: Wal, frame: Int) -> Int Never! {
    i: wal_frame_page(frame)
    if i == 0 -> return le_get4(w.wi[0], WALINDEX_HDR_SIZE + 4 * (frame - 1))
    le_get4(w.wi[i], 4 * ((frame - 1 - HASHTABLE_NPAGE_ONE) % HASHTABLE_NPAGE))
}

// walCleanupHash: remove the entries for frames past mxFrame from the last
// hash table.
wal_cleanup_hash: fn(w: &Wal, db: &file.SQLFile) Never! -[DB]> {
    mx: wal_mx_frame(w)
    if mx == 0 -> return
    loc := wal_hash_loc()
    if wal_hash_get(w, db, wal_frame_page(mx), loc) != base.OK -> return
    limit: mx - loc.zero
    pg: loc.page
    loop k in 0..<HASHTABLE_NSLOT {
        at: HASH_AT + 2 * k
        if le_get2(w.wi[pg], at) > limit -> wi_put2(w, pg, at, 0)
    }
    wi_zero(w, pg, loc.pgno_at + 4 * limit, HASH_AT)
}

// walIndexAppend: index frame `frame` as holding page pgno.
wal_index_append: fn(w: &Wal, db: &file.SQLFile, frame: Int, pgno: Int) -[DB]> Int Never! {
    loc := wal_hash_loc()
    rc: wal_hash_get(w, db, wal_frame_page(frame), loc)
    if rc != base.OK -> return rc
    pg: loc.page
    idx: frame - loc.zero
    if idx == 1 -> wi_zero(w, pg, loc.pgno_at, WALINDEX_PGSZ)
    if loc_pgno(w, loc, idx - 1) != 0 -> wal_cleanup_hash(w, db)
    n_collide := idx
    key := wal_hash(pgno)
    loop loc_hash(w, loc, key) != 0 {
        if n_collide == 0 -> return base.CORRUPT
        n_collide -= 1
        key = wal_next_hash(key)
    }
    wi_put4(w, pg, loc.pgno_at + 4 * (idx - 1), pgno)
    wi_put2(w, pg, HASH_AT + 2 * key, idx)
    base.OK
}

// The frames of one wal-index region during recovery (the loop body of
// walIndexRecover over iPg): true when every frame up to `last` was valid.
recover_region: fn(w: &Wal, db: &file.SQLFile, first: Int, last: Int, sz_page: Int, frame: &[U8], saved: &WalCksum, rc: &Int) -[DB]> Bool Never! {
    sz_frame: sz_page + WAL_FRAME_HDRSIZE
    f := first
    loop f <= last {
        rc = file.file_read(w.fd, frame, sz_frame, wal_frame_offset(f, sz_page))
        if rc != base.OK -> return false
        pgno := 0
        n_truncate := 0
        if !wal_decode_frame(w, frame, pgno, n_truncate) -> return false
        rc = wal_index_append(w, db, f, pgno)
        if rc != base.OK -> return false
        if n_truncate != 0 {
            hdr_set(w, HDR_MXFRAME, f)
            hdr_set(w, HDR_NPAGE, n_truncate)
            le_put2(w.hdr, HDR_SZPAGE, sz_page.bit_and(65280).bit_or(sz_page >> 16))
            saved.s1 = hdr_get(w, HDR_FRAME_CKSUM)
            saved.s2 = hdr_get(w, HDR_FRAME_CKSUM + 4)
        }
        f += 1
    }
    true
}

// The body of walIndexRecover from reading the log to its finished label.
recover_log: fn(w: &Wal, db: &file.SQLFile, saved: &WalCksum) -[DB]> Int Never! {
    n_size := 0
    rc := file.file_size(w.fd, n_size)
    if rc != base.OK || n_size <= WAL_HDRSIZE -> return rc
    buf := wal_zeros(WAL_HDRSIZE)
    rc = file.file_read(w.fd, buf, WAL_HDRSIZE, 0)
    if rc != base.OK -> return rc
    magic: util.get4(buf, 0)
    sz_page: util.get4(buf, 8)
    if util.clear_bits(magic, 1) != WAL_MAGIC || sz_page.bit_and(sz_page - 1) != 0 || sz_page > WAL_MAX_PAGE_SIZE || sz_page < 512 -> return base.OK
    w.hdr[HDR_BIGEND] = U8{magic.bit_and(1)}
    w.sz_page = sz_page
    w.n_ckpt = util.get4(buf, 12)
    loop k in 0..<8 -> w.hdr[HDR_SALT + k] = buf[16 + k]
    ck: wal_checksum(magic.bit_and(1) == 0, buf, 0, WAL_HDRSIZE - 8, 0, 0)
    hdr_set(w, HDR_FRAME_CKSUM, ck.s1)
    hdr_set(w, HDR_FRAME_CKSUM + 4, ck.s2)
    if ck.s1 != util.get4(buf, 24) || ck.s2 != util.get4(buf, 28) -> return base.OK
    if util.get4(buf, 4) != WAL_MAX_VERSION -> return base.CANTOPEN
    sz_frame: sz_page + WAL_FRAME_HDRSIZE
    frame := wal_zeros(sz_frame)
    last_frame: (n_size - WAL_HDRSIZE) /% sz_frame
    n_pg: wal_frame_page(last_frame)
    loop pg in 0..<(n_pg + 1) {
        last := HASHTABLE_NPAGE_ONE + pg * HASHTABLE_NPAGE
        if last_frame < last -> last = last_frame
        first: if pg == 0 -> 1 else -> 1 + HASHTABLE_NPAGE_ONE + (pg - 1) * HASHTABLE_NPAGE
        present := false
        rc = wal_index_page(w, db, pg, present)
        if !present -> break
        // The region is built in a private copy (aPrivate) and then copied
        // over the shared one past its header.
        share: w.wi[pg].copy()
        w.wi[pg] = wal_zeros(WALINDEX_PGSZ)
        complete: recover_region(w, db, first, last, sz_page, frame, saved, rc)
        n_hdr: if pg == 0 -> WALINDEX_HDR_SIZE else -> 0
        loop k in 0..<n_hdr -> w.wi[pg][k] = share[k]
        w.wi_fresh[pg] = true
        w.wi_lo[pg] = n_hdr
        w.wi_hi[pg] = WALINDEX_PGSZ
        if !complete -> break
    }
    rc
}

// walIndexRecover: rebuild the wal-index from the log file.
wal_index_recover: fn(w: &Wal, db: &file.SQLFile) -[DB]> Int Never! {
    i_lock: WAL_ALL_BUT_WRITE + (if w.ckpt_lock -> 1 else -> 0)
    rc := wal_lock_exclusive(w, db, i_lock, read_lock(0) - i_lock)
    if rc != base.OK -> return rc
    w.hdr = wal_zeros(HDR_SIZE)
    saved := WalCksum{s1: 0, s2: 0}
    rc = recover_log(w, db, saved)
    if rc == base.OK {
        hdr_set(w, HDR_FRAME_CKSUM, saved.s1)
        hdr_set(w, HDR_FRAME_CKSUM + 4, saved.s2)
        wal_index_write_hdr(w, db)
        mx: wal_mx_frame(w)
        wi_set4(w, db, CKPT_NBACKFILL, 0)
        wi_set4(w, db, CKPT_ATTEMPTED, mx)
        wi_set4(w, db, CKPT_READMARK, 0)
        loop i in 1..<WAL_NREADER {
            rc = wal_lock_exclusive(w, db, read_lock(i), 1)
            if rc == base.OK {
                mark: if i == 1 && mx != 0 -> mx else -> READMARK_NOT_USED
                wi_set4(w, db, CKPT_READMARK + 4 * i, mark)
                wal_unlock_exclusive(w, db, read_lock(i), 1)
            } else if rc != base.BUSY {
                break
            }
        }
    }
    wal_unlock_exclusive(w, db, i_lock, read_lock(0) - i_lock)
    rc
}

// walIndexClose.
wal_index_close: fn(w: &Wal, db: &file.SQLFile, delete: Bool) Never! -[DB]> {
    wal_free_pages(w)
    if w.exclusive_mode != WAL_HEAPMEMORY_MODE -> file.file_shm_unmap(db, delete)
}

// sqlite3WalOpen: open the log `name` of database file db into w;
// no_shm is heap-memory mode.
wal_open: fn(w: &Wal, db: &file.SQLFile, name: String, no_shm: Bool, mx_wal_size: Int) -[DB]> Int Never! {
    w = wal_closed()
    w.read_lock = -1
    w.mx_wal_size = mx_wal_size
    w.name = name
    w.sync_header = true
    w.pad_to_sector_boundary = true
    w.exclusive_mode = if no_shm -> WAL_HEAPMEMORY_MODE else -> WAL_NORMAL_MODE
    flags: os.OPEN_READWRITE.bit_or(os.OPEN_CREATE).bit_or(os.OPEN_WAL)
    rc: file.file_open(w.fd, name, flags)
    if rc != base.OK {
        wal_index_close(w, db, false)
        file.file_close(w.fd)
        w = wal_closed()
        return rc
    }
    if w.fd.os.flags.bit_and(os.OPEN_READONLY) != 0 -> w.read_only = WAL_RDONLY
    dc: file.file_device_characteristics(db)
    if dc.bit_and(os.IOCAP_SEQUENTIAL) != 0 -> w.sync_header = false
    if dc.bit_and(os.IOCAP_POWERSAFE_OVERWRITE) != 0 -> w.pad_to_sector_boundary = false
    w.open = true
    base.OK
}

// sqlite3WalLimit.
wal_limit: fn(w: &Wal, limit: Int) Never! {
    if w.open -> w.mx_wal_size = limit
}

// walIteratorInit and walIteratorNext: the pages of the frames after
// n_backfill's region start up to mxFrame, ascending, each with its last
// frame.
WalIterator: struct {
    pages: [Int]
    frames: [Int]
}

wal_iterator_init: fn(w: &Wal, db: &file.SQLFile, n_backfill: Int, iter: &WalIterator) -[DB]> Int Never! {
    last: wal_mx_frame(w)
    n_segment: wal_frame_page(last) + 1
    keys := [Int]{}
    rc := base.OK
    i := wal_frame_page(n_backfill + 1)
    loop rc == base.OK && i < n_segment {
        loc := wal_hash_loc()
        rc = wal_hash_get(w, db, i, loc)
        if rc == base.OK {
            n_entry: if i + 1 == n_segment -> last - loc.zero else -> (HASH_AT - loc.pgno_at) /% 4
            loop j in 0..<n_entry -> keys.push(loc_pgno(w, loc, j) * 4294967296 + loc.zero + 1 + j)
        }
        i += 1
    }
    if rc != base.OK -> return rc
    keys.sort()
    n: keys.len()
    loop k in 0..<n {
        pg: keys[k] >> 32
        if k + 1 < n && (keys[k + 1] >> 32) == pg -> next
        iter.pages.push(pg)
        iter.frames.push(keys[k].bit_and(os.U32_MASK))
    }
    base.OK
}

// walBusyLock.
wal_busy_lock: fn(w: &Wal, db: &file.SQLFile, busy: &BusyHandler, use_busy: Bool, idx: Int, n: Int) -[DB]> Int Never! {
    rc := wal_lock_exclusive(w, db, idx, n)
    loop use_busy && rc == base.BUSY && busy_invoke(busy) -> rc = wal_lock_exclusive(w, db, idx, n)
    rc
}

// walPagesize.
wal_pagesize: fn(w: Wal) -> Int Never! {
    v: le_get2(w.hdr, HDR_SZPAGE)
    v.bit_and(65024) + (v.bit_and(1) << 16)
}

// walRestartHdr: start the log over with salt1 as the second salt.
wal_restart_hdr: fn(w: &Wal, db: &file.SQLFile, salt1: [U8]) Never! -[DB]> {
    w.n_ckpt += 1
    hdr_set(w, HDR_MXFRAME, 0)
    // C reads aSalt[0] big-endian and stores the sum as a native word.
    salt: util.get4(w.hdr, HDR_SALT) + 1
    le_put4(w.hdr, HDR_SALT, salt.bit_and(os.U32_MASK))
    loop k in 0..<4 -> w.hdr[HDR_SALT + 4 + k] = salt1[k]
    wal_index_write_hdr(w, db)
    wi_set4(w, db, CKPT_NBACKFILL, 0)
    wi_set4(w, db, CKPT_ATTEMPTED, 0)
    wi_set4(w, db, CKPT_READMARK + 4, 0)
    loop i in 2..<WAL_NREADER -> wi_set4(w, db, CKPT_READMARK + 4 * i, READMARK_NOT_USED)
}

// The backfill of walCheckpoint while it holds READ_LOCK(0): copy the
// iterator's frames in n_backfill+1..mx_safe to the database file.
ckpt_backfill: fn(w: &Wal, db: &file.SQLFile, iter: WalIterator, mx_safe: Int, mx_page: Int, sz_page: Int, sync_flags: Int, buf: &[U8]) -[DB]> Int Never! {
    n_backfill: wi_get4(w, db, CKPT_NBACKFILL)
    wi_set4(w, db, CKPT_ATTEMPTED, mx_safe)
    rc := file.file_sync(w.fd, ckpt_sync_flags(sync_flags))
    if rc == base.OK {
        n_req: mx_page * sz_page
        n_size := 0
        rc = file.file_size(db, n_size)
        if rc == base.OK && n_size < n_req {
            if n_size + 65536 + wal_mx_frame(w) * sz_page < n_req {
                rc = base.CORRUPT
            } else {
                file.file_size_hint(db, n_req)
            }
        }
    }
    k := 0
    loop rc == base.OK && k < iter.pages.len() {
        db_page: iter.pages[k]
        frame: iter.frames[k]
        k += 1
        if frame <= n_backfill || frame > mx_safe || db_page > mx_page -> next
        rc = file.file_read(w.fd, buf, sz_page, wal_frame_offset(frame, sz_page) + WAL_FRAME_HDRSIZE)
        if rc != base.OK -> break
        rc = file.file_write(db, buf, sz_page, (db_page - 1) * sz_page)
    }
    if rc == base.OK {
        if mx_safe == wi_get4(w, db, HDR_MXFRAME) {
            rc = file.file_truncate(db, hdr_get(w, HDR_NPAGE) * sz_page)
            if rc == base.OK -> rc = file.file_sync(db, ckpt_sync_flags(sync_flags))
        }
        if rc == base.OK -> wi_set4(w, db, CKPT_NBACKFILL, mx_safe)
    }
    rc
}

// walCheckpoint: copy as much of the log as the readers allow into the
// database file; FULL, RESTART and TRUNCATE then wait for the readers.
wal_checkpoint_run: fn(w: &Wal, db: &file.SQLFile, mode: Int, busy: &BusyHandler, use_busy: Bool, sync_flags: Int, buf: &[U8]) -[DB]> Int Never! {
    rc := base.OK
    x_busy := use_busy
    sz_page: wal_pagesize(w)
    mx: wal_mx_frame(w)
    if wi_get4(w, db, CKPT_NBACKFILL) < mx {
        mx_safe := mx
        mx_page: hdr_get(w, HDR_NPAGE)
        loop i in 1..<WAL_NREADER {
            y: wi_get4(w, db, CKPT_READMARK + 4 * i)
            if mx_safe > y {
                rc = wal_busy_lock(w, db, busy, x_busy, read_lock(i), 1)
                if rc == base.OK {
                    mark: if i == 1 -> mx_safe else -> READMARK_NOT_USED
                    wi_set4(w, db, CKPT_READMARK + 4 * i, mark)
                    wal_unlock_exclusive(w, db, read_lock(i), 1)
                } else if rc == base.BUSY {
                    mx_safe = y
                    x_busy = false
                } else {
                    return rc
                }
            }
        }
        iter := WalIterator{pages: [Int]{}, frames: [Int]{}}
        has_iter := false
        if wi_get4(w, db, CKPT_NBACKFILL) < mx_safe {
            n_backfill: wi_get4(w, db, CKPT_NBACKFILL)
            rc = wal_iterator_init(w, db, n_backfill, iter)
            has_iter = rc == base.OK
        }
        if has_iter {
            rc = wal_busy_lock(w, db, busy, x_busy, read_lock(0), 1)
            if rc == base.OK {
                rc = ckpt_backfill(w, db, iter, mx_safe, mx_page, sz_page, sync_flags, buf)
                wal_unlock_exclusive(w, db, read_lock(0), 1)
            }
        }
        if rc == base.BUSY -> rc = base.OK
    }
    if rc == base.OK && mode != CHECKPOINT_PASSIVE {
        if wi_get4(w, db, CKPT_NBACKFILL) < wal_mx_frame(w) {
            rc = base.BUSY
        } else if mode >= CHECKPOINT_RESTART {
            salt1: os.os_random_bytes(4)
            rc = wal_busy_lock(w, db, busy, x_busy, read_lock(1), WAL_NREADER - 1)
            if rc == base.OK {
                if mode == CHECKPOINT_TRUNCATE {
                    wal_restart_hdr(w, db, salt1)
                    rc = file.file_truncate(w.fd, 0)
                }
                wal_unlock_exclusive(w, db, read_lock(1), WAL_NREADER - 1)
            }
        }
    }
    rc
}

// walLimitSize: truncate the log to at most n_max bytes.
wal_limit_size: fn(w: &Wal, n_max: Int) Never! -[DB]> {
    sz := 0
    rx: file.file_size(w.fd, sz)
    if rx == base.OK && sz > n_max -> _: file.file_truncate(w.fd, n_max)
}

// sqlite3WalClose. checkpoint is C's zBuf != 0: checkpoint and delete the
// log when this is the last connection; buf has page_size bytes.
wal_close: fn(w: &Wal, db: &file.SQLFile, sync_flags: Int, page_size: Int, checkpoint: Bool, buf: &[U8]) -[DB]> Int Never! {
    rc := base.OK
    if !w.open -> return rc
    is_delete := false
    if checkpoint {
        rc = file.file_lock(db, os.LOCK_EXCLUSIVE)
        if rc == base.OK {
            if w.exclusive_mode == WAL_NORMAL_MODE -> w.exclusive_mode = WAL_EXCLUSIVE_MODE
            no_busy := BusyHandler{timeout: 0, n_busy: 0}
            n_log := 0
            n_ckpt := 0
            rc = wal_checkpoint(w, db, CHECKPOINT_PASSIVE, no_busy, false, sync_flags, page_size, buf, n_log, n_ckpt)
            if rc == base.OK {
                if !file.file_persist_wal(db) {
                    is_delete = true
                } else if w.mx_wal_size >= 0 {
                    wal_limit_size(w, 0)
                }
            }
        }
    }
    wal_index_close(w, db, is_delete)
    file.file_close(w.fd)
    if is_delete -> _: file.file_delete(w.name, false)
    w = wal_closed()
    rc
}

// walIndexTryHdr: load the shared header into w.hdr; true when it is
// being written or damaged.
wal_index_try_hdr: fn(w: &Wal, db: &file.SQLFile, changed: &Bool) -[DB]> Bool Never! {
    h1 := wal_zeros(HDR_SIZE)
    h2 := wal_zeros(HDR_SIZE)
    wi_read(w, db, 0, h1, 0, HDR_SIZE)
    wi_read(w, db, HDR_SIZE, h2, 0, HDR_SIZE)
    if h1 != h2 -> return true
    if Int.from_u8(h1[HDR_ISINIT]) == 0 -> return true
    ck: wal_checksum(true, h1, 0, HDR_CKSUM, 0, 0)
    if ck.s1 != le_get4(h1, HDR_CKSUM) || ck.s2 != le_get4(h1, HDR_CKSUM + 4) -> return true
    if w.hdr != h1 {
        changed = true
        w.hdr = h1
        w.sz_page = wal_pagesize(w)
        wal_stale_all(w)
    }
    false
}

// walIndexReadHdr: read the shared header, running recovery when it is
// damaged.
wal_index_read_hdr: fn(w: &Wal, db: &file.SQLFile, changed: &Bool) -[DB]> Int Never! {
    present := false
    rc := wal_index_page(w, db, 0, present)
    if rc != base.OK {
        if rc != base.READONLY_CANTINIT -> return rc
        // The -shm file is read-only and no connection keeps it current:
        // read the log into heap memory (bShmUnreliable).
        w.shm_unreliable = true
        w.exclusive_mode = WAL_HEAPMEMORY_MODE
        changed = true
    }
    bad := true
    if present -> bad = wal_index_try_hdr(w, db, changed)
    if bad {
        if !w.shm_unreliable && w.read_only.bit_and(WAL_SHM_RDONLY) != 0 {
            rc = wal_lock_shared(w, db, WAL_WRITE_LOCK)
            if rc == base.OK {
                wal_unlock_shared(w, db, WAL_WRITE_LOCK)
                rc = base.READONLY_RECOVERY
            }
        } else {
            had_lock: w.write_lock
            locked := had_lock
            if !had_lock {
                rc = wal_lock_exclusive(w, db, WAL_WRITE_LOCK, 1)
                locked = rc == base.OK
            }
            if locked {
                w.write_lock = true
                rc = wal_index_page(w, db, 0, present)
                if rc == base.OK {
                    bad = wal_index_try_hdr(w, db, changed)
                    if bad {
                        rc = wal_index_recover(w, db)
                        changed = true
                    }
                }
                if !had_lock {
                    w.write_lock = false
                    wal_unlock_exclusive(w, db, WAL_WRITE_LOCK, 1)
                }
            }
        }
    }
    if !bad && hdr_get(w, HDR_VERSION) != WALINDEX_MAX_VERSION -> rc = base.CANTOPEN
    if w.shm_unreliable {
        if rc != base.OK {
            wal_index_close(w, db, false)
            w.shm_unreliable = false
            if rc == base.IOERR_SHORT_READ -> rc = WAL_RETRY
        }
        w.exclusive_mode = WAL_NORMAL_MODE
    }
    rc
}

// The body of walBeginShmUnreliable after READ_LOCK(0) is held and the
// shared memory is confirmed unreliable: check that the log has no commit
// past the header recovered into heap memory.
shm_unreliable_check: fn(w: &Wal, db: &file.SQLFile, changed: &Bool) -[DB]> Int Never! {
    w.hdr = wi_live_hdr(w, db)
    sz_wal := 0
    rc := file.file_size(w.fd, sz_wal)
    if rc != base.OK -> return rc
    if sz_wal < WAL_HDRSIZE {
        changed = true
        return if wal_mx_frame(w) == 0 -> base.OK else -> WAL_RETRY
    }
    buf := wal_zeros(WAL_HDRSIZE)
    rc = file.file_read(w.fd, buf, WAL_HDRSIZE, 0)
    if rc != base.OK -> return rc
    loop k in 0..<8 {
        if w.hdr[HDR_SALT + k] != buf[16 + k] -> return WAL_RETRY
    }
    sz_frame: w.sz_page + WAL_FRAME_HDRSIZE
    frame := wal_zeros(sz_frame)
    save0: hdr_get(w, HDR_FRAME_CKSUM)
    save1: hdr_get(w, HDR_FRAME_CKSUM + 4)
    off := wal_frame_offset(wal_mx_frame(w) + 1, w.sz_page)
    loop off + sz_frame <= sz_wal {
        rc = file.file_read(w.fd, frame, sz_frame, off)
        if rc != base.OK -> break
        pgno := 0
        n_truncate := 0
        if !wal_decode_frame(w, frame, pgno, n_truncate) -> break
        if n_truncate != 0 {
            rc = WAL_RETRY
            break
        }
        off += sz_frame
    }
    hdr_set(w, HDR_FRAME_CKSUM, save0)
    hdr_set(w, HDR_FRAME_CKSUM + 4, save1)
    rc
}

// walBeginShmUnreliable: a read transaction over the heap-memory index of
// an unreliable read-only -shm file.
wal_begin_shm_unreliable: fn(w: &Wal, db: &file.SQLFile, changed: &Bool) -[DB]> Int Never! {
    rc := wal_lock_shared(w, db, read_lock(0))
    if rc != base.OK {
        if rc == base.BUSY -> rc = WAL_RETRY
    } else {
        w.read_lock = 0
        dummy := false
        rc = file.file_shm_map(db, 0, WALINDEX_PGSZ, false, dummy)
        if rc != base.READONLY_CANTINIT {
            if rc == base.READONLY -> rc = WAL_RETRY
        } else {
            rc = shm_unreliable_check(w, db, changed)
        }
    }
    if rc != base.OK {
        wal_free_pages(w)
        w.shm_unreliable = false
        wal_end_read_transaction(w, db)
        changed = true
    }
    rc
}

// walTryBeginRead: one attempt at a read lock on a consistent snapshot.
wal_try_begin_read: fn(w: &Wal, db: &file.SQLFile, changed: &Bool, use_wal: Bool, cnt: &Int) -[DB]> Int Never! {
    cnt += 1
    if cnt > 5 {
        delay := 1
        if cnt > WAL_RETRY_PROTOCOL_LIMIT -> return base.PROTOCOL
        if cnt >= 10 -> delay = (cnt - 9) * (cnt - 9) * 39
        _: os.os_sleep(delay)
    }
    rc := base.OK
    if !use_wal {
        if !w.shm_unreliable -> rc = wal_index_read_hdr(w, db, changed)
        if rc == base.BUSY {
            if w.wi.len() == 0 || w.wi[0].len() == 0 {
                rc = WAL_RETRY
            } else {
                rc = wal_lock_shared(w, db, WAL_RECOVER_LOCK)
                if rc == base.OK {
                    wal_unlock_shared(w, db, WAL_RECOVER_LOCK)
                    rc = WAL_RETRY
                } else if rc == base.BUSY {
                    rc = base.BUSY_RECOVERY
                }
            }
        }
        if rc != base.OK -> return rc
        if w.shm_unreliable -> return wal_begin_shm_unreliable(w, db, changed)
    }
    mx: wal_mx_frame(w)
    if !use_wal && wi_get4(w, db, CKPT_NBACKFILL) == mx {
        rc = wal_lock_shared(w, db, read_lock(0))
        if rc == base.OK {
            if wi_live_hdr(w, db) != w.hdr {
                wal_unlock_shared(w, db, read_lock(0))
                return WAL_RETRY
            }
            w.read_lock = 0
            return base.OK
        } else if rc != base.BUSY {
            return rc
        }
    }
    mx_read_mark := 0
    mx_i := 0
    loop i in 1..<WAL_NREADER {
        this: wi_get4(w, db, CKPT_READMARK + 4 * i)
        if mx_read_mark <= this && this <= mx {
            mx_read_mark = this
            mx_i = i
        }
    }
    if w.read_only.bit_and(WAL_SHM_RDONLY) == 0 && (mx_read_mark < mx || mx_i == 0) {
        loop i in 1..<WAL_NREADER {
            rc = wal_lock_exclusive(w, db, read_lock(i), 1)
            if rc == base.OK {
                wi_set4(w, db, CKPT_READMARK + 4 * i, mx)
                mx_read_mark = mx
                mx_i = i
                wal_unlock_exclusive(w, db, read_lock(i), 1)
                break
            } else if rc != base.BUSY {
                return rc
            }
        }
    }
    if mx_i == 0 -> return if rc == base.BUSY -> WAL_RETRY else -> base.READONLY_CANTINIT
    rc = wal_lock_shared(w, db, read_lock(mx_i))
    if rc != base.OK -> return if rc.bit_and(255) == base.BUSY -> WAL_RETRY else -> rc
    w.min_frame = wi_get4(w, db, CKPT_NBACKFILL) + 1
    if wi_get4(w, db, CKPT_READMARK + 4 * mx_i) != mx_read_mark || wi_live_hdr(w, db) != w.hdr {
        wal_unlock_shared(w, db, read_lock(mx_i))
        return WAL_RETRY
    }
    w.read_lock = mx_i
    rc
}

// sqlite3WalBeginReadTransaction: changed is set when the snapshot differs
// from the previous one (the pager's cache is then stale).
wal_begin_read_transaction: fn(w: &Wal, db: &file.SQLFile, changed: &Bool) -[DB]> Int Never! {
    cnt := 0
    rc := WAL_RETRY
    loop rc == WAL_RETRY -> rc = wal_try_begin_read(w, db, changed, false, cnt)
    wal_shm_result(w, rc)
}

// sqlite3WalEndReadTransaction.
wal_end_read_transaction: fn(w: &Wal, db: &file.SQLFile) Never! -[DB]> {
    _: wal_end_write_transaction(w, db)
    if w.read_lock >= 0 {
        slot: read_lock(w.read_lock)
        wal_unlock_shared(w, db, slot)
        w.read_lock = -1
    }
}

// walFindFrame.
wal_find_frame_in: fn(w: &Wal, db: &file.SQLFile, pgno: Int, frame: &Int) -[DB]> Int Never! {
    frame = 0
    last: wal_mx_frame(w)
    if last == 0 || (w.read_lock == 0 && !w.shm_unreliable) -> return base.OK
    min_hash: wal_frame_page(w.min_frame)
    found := 0
    h := wal_frame_page(last)
    loop h >= min_hash {
        loc := wal_hash_loc()
        rc: wal_hash_get(w, db, h, loc)
        if rc != base.OK -> return rc
        n_collide := HASHTABLE_NSLOT
        key := wal_hash(pgno)
        loop {
            ih: loc_hash(w, loc, key)
            if ih == 0 -> break
            f: ih + loc.zero
            if f <= last && f >= w.min_frame && loc_pgno(w, loc, ih - 1) == pgno -> found = f
            if n_collide == 0 -> return base.CORRUPT
            n_collide -= 1
            key = wal_next_hash(key)
        }
        if found != 0 -> break
        h -= 1
    }
    frame = found
    base.OK
}

// sqlite3WalFindFrame: the last frame of page pgno in the snapshot, or 0
// when the page is read from the database file.
wal_find_frame: fn(w: &Wal, db: &file.SQLFile, pgno: Int, frame: &Int) -[DB]> Int Never! {
    rc: wal_find_frame_in(w, db, pgno, frame)
    wal_shm_result(w, rc)
}

// sqlite3WalReadFrame: the page data of a frame into out[0..<min(n_out,
// page size)].
wal_read_frame: fn(w: &Wal, frame: Int, n_out: Int, out: &[U8]) -[DB]> Int Never! {
    sz: wal_pagesize(w)
    n: if n_out > sz -> sz else -> n_out
    file.file_read(w.fd, out, n, wal_frame_offset(frame, sz) + WAL_FRAME_HDRSIZE)
}

// sqlite3WalDbsize: the database size in pages of the snapshot.
wal_dbsize: fn(w: Wal) -> Int Never! {
    if w.open && w.read_lock >= 0 -> return hdr_get(w, HDR_NPAGE)
    0
}

// sqlite3WalBeginWriteTransaction: the write lock on the newest snapshot,
// else BUSY or BUSY_SNAPSHOT.
wal_begin_write_transaction: fn(w: &Wal, db: &file.SQLFile) -[DB]> Int Never! {
    if w.read_only != WAL_RDWR -> return base.READONLY
    rc := wal_lock_exclusive(w, db, WAL_WRITE_LOCK, 1)
    if rc != base.OK -> return rc
    w.write_lock = true
    if wi_live_hdr(w, db) != w.hdr -> rc = base.BUSY_SNAPSHOT
    rc = wal_shm_result(w, rc)
    if rc != base.OK {
        wal_unlock_exclusive(w, db, WAL_WRITE_LOCK, 1)
        w.write_lock = false
        return rc
    }
    // The region of the next frame may hold what a rollback left.
    next_page: wal_frame_page(wal_mx_frame(w) + 1)
    if !wal_local(w) && next_page < w.wi.len() -> w.wi_fresh[next_page] = false
    base.OK
}

// sqlite3WalEndWriteTransaction.
wal_end_write_transaction: fn(w: &Wal, db: &file.SQLFile) -[DB]> Int Never! {
    if w.write_lock {
        wal_unlock_exclusive(w, db, WAL_WRITE_LOCK, 1)
        w.write_lock = false
        w.re_cksum = 0
        w.truncate_on_commit = false
        wal_drop_dirty(w)
    }
    base.OK
}

// sqlite3WalUndo: drop the uncommitted frames. pgnos gets the page of each,
// in frame order, for the pager's xUndo (pagerUndoCallback), which runs
// against the restored snapshot.
wal_undo: fn(w: &Wal, db: &file.SQLFile, pgnos: &[Int]) -[DB]> Int Never! {
    if !w.write_lock -> return base.OK
    mx_old: wal_mx_frame(w)
    w.hdr = wi_live_hdr(w, db)
    mx: wal_mx_frame(w)
    lo: mx + 1
    hi: mx_old + 1
    loop f in lo..<hi -> pgnos.push(wal_frame_pgno(w, f))
    if mx_old != mx -> wal_cleanup_hash(w, db)
    wal_shm_result(w, base.OK)
}

// sqlite3WalSavepoint: aWalData.
wal_savepoint: fn(w: Wal) -> [Int] Never! {
    [Int]{wal_mx_frame(w), hdr_get(w, HDR_FRAME_CKSUM), hdr_get(w, HDR_FRAME_CKSUM + 4), w.n_ckpt}
}

// sqlite3WalSavepointUndo.
wal_savepoint_undo: fn(w: &Wal, db: &file.SQLFile, data: &[Int]) -[DB]> Int Never! {
    if data[3] != w.n_ckpt {
        // The log was restarted since the savepoint: undo all of it.
        data[0] = 0
        data[3] = w.n_ckpt
    }
    if data[0] < wal_mx_frame(w) {
        hdr_set(w, HDR_MXFRAME, data[0])
        hdr_set(w, HDR_FRAME_CKSUM, data[1])
        hdr_set(w, HDR_FRAME_CKSUM + 4, data[2])
        wal_cleanup_hash(w, db)
    }
    wal_shm_result(w, base.OK)
}

// walRestartLog: a writer whose readers are all past the log starts it
// over.
wal_restart_log: fn(w: &Wal, db: &file.SQLFile) -[DB]> Int Never! {
    rc := base.OK
    if w.read_lock != 0 -> return rc
    if wi_get4(w, db, CKPT_NBACKFILL) > 0 {
        salt1: os.os_random_bytes(4)
        rc = wal_lock_exclusive(w, db, read_lock(1), WAL_NREADER - 1)
        if rc == base.OK {
            wal_restart_hdr(w, db, salt1)
            wal_unlock_exclusive(w, db, read_lock(1), WAL_NREADER - 1)
        } else if rc != base.BUSY {
            return rc
        }
    }
    wal_unlock_shared(w, db, read_lock(0))
    w.read_lock = -1
    cnt := 0
    rc = WAL_RETRY
    loop rc == WAL_RETRY {
        not_used := false
        rc = wal_try_begin_read(w, db, not_used, true, cnt)
    }
    rc
}

// WalWriter.
WalWriter: struct {
    sync_point: Int
    sync_flags: Int
    sz_page: Int
}

// walWriteToLog: data[0..<amt] at offset, syncing when the write crosses
// the sync point.
wal_write_to_log: fn(w: &Wal, wr: WalWriter, data: [U8], amt: Int, offset: Int) -[DB]> Int Never! {
    if offset < wr.sync_point && offset + amt >= wr.sync_point {
        first: wr.sync_point - offset
        rc := file.file_write(w.fd, data, first, offset)
        if rc != base.OK -> return rc
        rc = file.file_sync(w.fd, wal_sync_flags(wr.sync_flags))
        if amt == first || rc != base.OK -> return rc
        rest: data.slice(first, amt)
        return file.file_write(w.fd, rest, amt - first, offset + first)
    }
    file.file_write(w.fd, data, amt, offset)
}

// walWriteOneFrame.
wal_write_one_frame: fn(w: &Wal, wr: WalWriter, pgno: Int, data: [U8], n_truncate: Int, offset: Int) -[DB]> Int Never! {
    frame := wal_zeros(WAL_FRAME_HDRSIZE)
    wal_encode_frame(w, pgno, n_truncate, data, 0, frame)
    rc: wal_write_to_log(w, wr, frame, WAL_FRAME_HDRSIZE, offset)
    if rc != base.OK -> return rc
    wal_write_to_log(w, wr, data, wr.sz_page, offset + WAL_FRAME_HDRSIZE)
}

// walRewriteChecksums: recompute the checksums of frames re_cksum..last
// after frames of this transaction were overwritten in place.
wal_rewrite_checksums: fn(w: &Wal, last: Int) -[DB]> Int Never! {
    sz_page: w.sz_page
    buf := wal_zeros(sz_page + WAL_FRAME_HDRSIZE)
    frame := wal_zeros(WAL_FRAME_HDRSIZE)
    cksum_off: if w.re_cksum == 1 -> 24 else -> wal_frame_offset(w.re_cksum - 1, sz_page) + 16
    rc := file.file_read(w.fd, buf, 8, cksum_off)
    hdr_set(w, HDR_FRAME_CKSUM, util.get4(buf, 0))
    hdr_set(w, HDR_FRAME_CKSUM + 4, util.get4(buf, 4))
    f := w.re_cksum
    w.re_cksum = 0
    loop rc == base.OK && f <= last {
        off: wal_frame_offset(f, sz_page)
        rc = file.file_read(w.fd, buf, sz_page + WAL_FRAME_HDRSIZE, off)
        if rc == base.OK {
            wal_encode_frame(w, util.get4(buf, 0), util.get4(buf, 4), buf, WAL_FRAME_HDRSIZE, frame)
            rc = file.file_write(w.fd, frame, WAL_FRAME_HDRSIZE, off)
        }
        f += 1
    }
    rc
}

// The WAL file header of walFrames when the log starts over.
wal_write_header: fn(w: &Wal, sz_page: Int, sync_flags: Int) -[DB]> Int Never! {
    hdr := wal_zeros(WAL_HDRSIZE)
    util.put4(hdr, 0, WAL_MAGIC)
    util.put4(hdr, 4, WAL_MAX_VERSION)
    util.put4(hdr, 8, sz_page)
    util.put4(hdr, 12, w.n_ckpt)
    if w.n_ckpt == 0 {
        salt: os.os_random_bytes(8)
        loop k in 0..<8 -> w.hdr[HDR_SALT + k] = salt[k]
    }
    loop k in 0..<8 -> hdr[16 + k] = w.hdr[HDR_SALT + k]
    ck: wal_checksum(true, hdr, 0, WAL_HDRSIZE - 8, 0, 0)
    util.put4(hdr, 24, ck.s1)
    util.put4(hdr, 28, ck.s2)
    w.sz_page = sz_page
    w.hdr[HDR_BIGEND] = U8{0}
    hdr_set(w, HDR_FRAME_CKSUM, ck.s1)
    hdr_set(w, HDR_FRAME_CKSUM + 4, ck.s2)
    w.truncate_on_commit = true
    rc := file.file_write(w.fd, hdr, WAL_HDRSIZE, 0)
    if rc != base.OK -> return rc
    if w.sync_header -> rc = file.file_sync(w.fd, ckpt_sync_flags(sync_flags))
    rc
}

// walFrames: append the pages of `list` (slots of pc, sorted by page
// number) to the log; a commit then publishes the new snapshot.
wal_frames_in: fn(w: &Wal, db: &file.SQLFile, pc: &cache.PCache, sz_page: Int, list: [Int], n_truncate: Int, is_commit: Bool, sync_flags: Int) -[DB]> Int Never! {
    i_first := 0
    live: wi_live_hdr(w, db)
    if live != w.hdr -> i_first = le_get4(live, HDR_MXFRAME) + 1
    rc := wal_restart_log(w, db)
    if rc != base.OK -> return rc
    frame := wal_mx_frame(w)
    if frame == 0 {
        rc = wal_write_header(w, sz_page, sync_flags)
        if rc != base.OK -> return rc
    }
    if w.sz_page != sz_page -> return base.CORRUPT
    wr := WalWriter{sync_point: 0, sync_flags: sync_flags, sz_page: sz_page}
    offset := wal_frame_offset(frame + 1, sz_page)
    sz_frame: sz_page + WAL_FRAME_HDRSIZE
    n: list.len()
    last := cache.NO_PAGE
    loop k in 0..<n {
        s: list[k]
        has_next: k + 1 < n
        if i_first != 0 && (has_next || !is_commit) {
            i_write := 0
            _: wal_find_frame_in(w, db, pc.pages[s].pgno, i_write)
            if i_write >= i_first {
                // The page is already in this transaction's frames:
                // overwrite it in place.
                if w.re_cksum == 0 || i_write < w.re_cksum -> w.re_cksum = i_write
                rc = file.file_write(w.fd, pc.pages[s].data, sz_page, wal_frame_offset(i_write, sz_page) + WAL_FRAME_HDRSIZE)
                if rc != base.OK -> return rc
                pc.pages[s].flags = util.clear_bits(pc.pages[s].flags, cache.PGHDR_WAL_APPEND)
                next
            }
        }
        frame += 1
        n_db_size: if is_commit && !has_next -> n_truncate else -> 0
        rc = wal_write_one_frame(w, wr, pc.pages[s].pgno, pc.pages[s].data, n_db_size, offset)
        if rc != base.OK -> return rc
        last = s
        offset += sz_frame
        pc.pages[s].flags = pc.pages[s].flags.bit_or(cache.PGHDR_WAL_APPEND)
    }
    if is_commit && w.re_cksum != 0 {
        rc = wal_rewrite_checksums(w, frame)
        if rc != base.OK -> return rc
    }
    n_extra := 0
    if is_commit && wal_sync_flags(sync_flags) != 0 {
        b_sync := true
        if w.pad_to_sector_boundary {
            sector: file.sector_size_of(w.fd)
            wr.sync_point = ((offset + sector - 1) /% sector) * sector
            b_sync = wr.sync_point == offset
            loop offset < wr.sync_point {
                rc = wal_write_one_frame(w, wr, pc.pages[last].pgno, pc.pages[last].data, n_truncate, offset)
                if rc != base.OK -> return rc
                offset += sz_frame
                n_extra += 1
            }
        }
        if b_sync -> rc = file.file_sync(w.fd, wal_sync_flags(sync_flags))
    }
    if is_commit && w.truncate_on_commit && w.mx_wal_size >= 0 {
        sz := w.mx_wal_size
        end: wal_frame_offset(frame + n_extra + 1, sz_page)
        if end > w.mx_wal_size -> sz = end
        wal_limit_size(w, sz)
        w.truncate_on_commit = false
    }
    frame = wal_mx_frame(w)
    loop k in 0..<n {
        if rc != base.OK -> break
        s: list[k]
        if pc.pages[s].flags.bit_and(cache.PGHDR_WAL_APPEND) == 0 -> next
        frame += 1
        rc = wal_index_append(w, db, frame, pc.pages[s].pgno)
    }
    loop rc == base.OK && n_extra > 0 {
        frame += 1
        n_extra -= 1
        rc = wal_index_append(w, db, frame, pc.pages[last].pgno)
    }
    if rc == base.OK {
        le_put2(w.hdr, HDR_SZPAGE, sz_page.bit_and(65280).bit_or(sz_page >> 16))
        hdr_set(w, HDR_MXFRAME, frame)
        if is_commit {
            change: hdr_get(w, HDR_CHANGE) + 1
            hdr_set(w, HDR_CHANGE, change)
            hdr_set(w, HDR_NPAGE, n_truncate)
            wal_index_write_hdr(w, db)
            w.callback = frame
        }
    }
    rc
}

// sqlite3WalFrames.
wal_frames: fn(w: &Wal, db: &file.SQLFile, pc: &cache.PCache, sz_page: Int, list: [Int], n_truncate: Int, is_commit: Bool, sync_flags: Int) -[DB]> Int Never! {
    rc: wal_frames_in(w, db, pc, sz_page, list, n_truncate, is_commit, sync_flags)
    wal_shm_result(w, rc)
}

// sqlite3WalCheckpoint: n_log and n_ckpt get the log's frame count and the
// frames checkpointed. A checkpoint that could not run in `mode` answers
// BUSY. buf has n_buf (the page size) bytes.
wal_checkpoint: fn(w: &Wal, db: &file.SQLFile, mode: Int, busy: &BusyHandler, use_busy: Bool, sync_flags: Int, n_buf: Int, buf: &[U8], n_log: &Int, n_ckpt: &Int) -[DB]> Int Never! {
    if w.read_only != WAL_RDWR -> return base.READONLY
    changed := false
    mode2 := mode
    busy2 := use_busy
    rc := wal_lock_exclusive(w, db, WAL_CKPT_LOCK, 1)
    if rc == base.OK {
        w.ckpt_lock = true
        if mode != CHECKPOINT_PASSIVE {
            rc = wal_busy_lock(w, db, busy, busy2, WAL_WRITE_LOCK, 1)
            if rc == base.OK {
                w.write_lock = true
            } else if rc == base.BUSY {
                mode2 = CHECKPOINT_PASSIVE
                busy2 = false
                rc = base.OK
            }
        }
    }
    if rc == base.OK -> rc = wal_index_read_hdr(w, db, changed)
    if rc == base.OK {
        if wal_mx_frame(w) != 0 && wal_pagesize(w) != n_buf {
            rc = base.CORRUPT
        } else {
            rc = wal_checkpoint_run(w, db, mode2, busy, busy2, sync_flags, buf)
        }
        if rc == base.OK || rc == base.BUSY {
            n_log = wal_mx_frame(w)
            n_ckpt = wi_get4(w, db, CKPT_NBACKFILL)
        }
    }
    rc = wal_shm_result(w, rc)
    // A new header was read: the next read transaction reloads it.
    if changed -> w.hdr = wal_zeros(HDR_SIZE)
    _: wal_end_write_transaction(w, db)
    if w.ckpt_lock {
        wal_unlock_exclusive(w, db, WAL_CKPT_LOCK, 1)
        w.ckpt_lock = false
    }
    if rc == base.OK && mode != mode2 -> return base.BUSY
    rc
}

// sqlite3WalCallback: the frame count of the last commit, once.
wal_callback: fn(w: &Wal) -> Int Never! {
    if !w.open -> return 0
    ret: w.callback
    w.callback = 0
    ret
}

// sqlite3WalExclusiveMode: op 1 enters exclusive mode, 0 leaves it, -1
// asks; the result is whether the connection is (op 0: now) in normal mode
// (op 1: 1).
wal_exclusive_mode: fn(w: &Wal, db: &file.SQLFile, op: Int) -[DB]> Int Never! {
    if op == 0 {
        if w.exclusive_mode == WAL_NORMAL_MODE -> return 0
        w.exclusive_mode = WAL_NORMAL_MODE
        slot: read_lock(w.read_lock)
        if wal_lock_shared(w, db, slot) != base.OK -> w.exclusive_mode = WAL_EXCLUSIVE_MODE
        return if w.exclusive_mode == WAL_NORMAL_MODE -> 1 else -> 0
    }
    if op > 0 {
        slot: read_lock(w.read_lock)
        wal_unlock_shared(w, db, slot)
        w.exclusive_mode = WAL_EXCLUSIVE_MODE
        return 1
    }
    if w.exclusive_mode == WAL_NORMAL_MODE -> 1 else -> 0
}

// sqlite3WalHeapMemory.
wal_heap_memory: fn(w: Wal) -> Bool Never! { w.open && w.exclusive_mode == WAL_HEAPMEMORY_MODE }

#Test("the WAL checksum matches a header written by SQLite 3.45.0") {
    // The first 32 bytes of a -wal file the reference sqlite3 shell wrote.
    hdr: [U8]{55, 127, 6, 130, 0, 45, 226, 24, 0, 0, 2, 0, 0, 0, 0, 0, 206, 222, 32, 54, 174, 141, 33, 32, 10, 235, 225, 225, 226, 231, 71, 52}
    ck: wal_checksum(true, hdr, 0, 24, 0, 0)
    assert(ck.s1 == util.get4(hdr, 24) && ck.s2 == util.get4(hdr, 28))
    assert(util.clear_bits(util.get4(hdr, 0), 1) == WAL_MAGIC && util.get4(hdr, 4) == WAL_MAX_VERSION)
}

#Test("frames encode and decode with the running checksum") {
    w := wal_closed()
    w.sz_page = 512
    salt: [U8]{1, 2, 3, 4, 5, 6, 7, 8}
    loop k in 0..<8 -> w.hdr[HDR_SALT + k] = salt[k]
    data := wal_zeros(512)
    loop k in 0..<512 -> data[k] = U8{(k * 7).bit_and(255)}
    frame := wal_zeros(WAL_FRAME_HDRSIZE)
    wal_encode_frame(w, 5, 9, data, 0, frame)
    after: [Int]{hdr_get(w, HDR_FRAME_CKSUM), hdr_get(w, HDR_FRAME_CKSUM + 4)}
    whole := frame.copy()
    loop b in data -> whole.push(b)
    r := wal_closed()
    r.sz_page = 512
    loop k in 0..<8 -> r.hdr[HDR_SALT + k] = salt[k]
    pgno := 0
    n_truncate := 0
    assert(wal_decode_frame(r, whole, pgno, n_truncate))
    assert(pgno == 5 && n_truncate == 9)
    assert(hdr_get(r, HDR_FRAME_CKSUM) == after[0] && hdr_get(r, HDR_FRAME_CKSUM + 4) == after[1])
    // A changed byte or another salt is not a frame of this log.
    whole[100] = U8{Int.from_u8(whole[100]).bit_xor(1)}
    r2 := wal_closed()
    r2.sz_page = 512
    loop k in 0..<8 -> r2.hdr[HDR_SALT + k] = salt[k]
    assert(!wal_decode_frame(r2, whole, pgno, n_truncate))
}

#Test("frames map to hash tables as walFramePage does") {
    assert(wal_frame_page(1) == 0 && wal_frame_page(HASHTABLE_NPAGE_ONE) == 0)
    assert(wal_frame_page(HASHTABLE_NPAGE_ONE + 1) == 1)
    assert(wal_frame_page(HASHTABLE_NPAGE_ONE + HASHTABLE_NPAGE) == 1)
    assert(wal_frame_page(HASHTABLE_NPAGE_ONE + HASHTABLE_NPAGE + 1) == 2)
    assert(wal_hash(1) == 383 && wal_next_hash(HASHTABLE_NSLOT - 1) == 0)
    assert(wal_frame_offset(1, 4096) == 32 && wal_frame_offset(3, 4096) == 32 + 2 * 4120)
    w := wal_closed()
    le_put2(w.hdr, HDR_SZPAGE, 65536.bit_and(65280).bit_or(65536 >> 16))
    assert(wal_pagesize(w) == 65536)
    le_put2(w.hdr, HDR_SZPAGE, 4096.bit_and(65280).bit_or(4096 >> 16))
    assert(wal_pagesize(w) == 4096)
}
