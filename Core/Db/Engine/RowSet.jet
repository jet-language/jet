// The RowSet of the Jet SQLite engine: a port of SQLite 3.45.0 rowset.c,
// the set of rowids OP_RowSetAdd, OP_RowSetRead and OP_RowSetTest work on.
//
// A RowSet is used one of two ways, as in C: either filled by inserts and
// then drained smallest first, each value once (sqlite3RowSetNext), or
// probed with batches (sqlite3RowSetTest), where a probe finds only the
// values inserted before the current batch began. C keeps the entries as a
// list and, on the first probe of each new batch, sorts the pending list
// into a forest of balanced trees; here the pending entries are a list and
// the earlier batches' entries a hash set, which answers the same probes.
//
// ROWSET_SORTED is kept: C clears it when an insert is not above the last
// value, and sorts (dropping duplicates) only then.

RowSet: struct {
    // The pending entries in insertion order (C's pEntry list), drained
    // from `at` once reading starts.
    entries: [Int]
    at: Int
    // The values inserted before the current batch (C's pForest).
    forest: [Int: Bool]
    // ROWSET_SORTED: `entries` is strictly increasing.
    sorted: Bool
    // ROWSET_NEXT: draining has begun.
    reading: Bool
    // The current batch (RowSet.iBatch).
    batch: Int
}

// sqlite3RowSetInit.
rowset_new: fn() -> RowSet Never! {
    RowSet{entries: [Int]{}, at: 0, forest: [Int: Bool]{}, sorted: true, reading: false, batch: 0}
}

// sqlite3RowSetClear: empty the set; it may be filled again.
rowset_clear: fn(p: &RowSet) Never! {
    p.entries = [Int]{}
    p.at = 0
    p.forest = [Int: Bool]{}
    p.sorted = true
    p.reading = false
}

// sqlite3RowSetInsert. Not called once reading has begun.
rowset_insert: fn(p: &RowSet, rowid: Int) Never! {
    n: p.entries.len()
    if p.sorted && n > 0 && rowid <= p.entries[n - 1] -> p.sorted = false
    p.entries.push(rowid)
}

// rowSetEntrySort: sort the pending entries ascending and drop duplicates.
rowset_sort: fn(p: &RowSet) Never! {
    p.entries.sort()
    out := [Int]{}
    loop v in p.entries {
        n: out.len()
        if n == 0 || out[n - 1] != v -> out.push(v)
    }
    p.entries = out
    p.sorted = true
}

// sqlite3RowSetNext: the smallest remaining value, or None when the set is
// empty (which clears it). Not called after rowset_test.
rowset_next: fn(p: &RowSet) -> Int? Never! {
    if !p.reading {
        if !p.sorted -> rowset_sort(p)
        p.reading = true
    }
    if p.at >= p.entries.len() -> return None
    v: p.entries[p.at]
    p.at += 1
    if p.at == p.entries.len() -> rowset_clear(p)
    Val(v)
}

// sqlite3RowSetTest: whether `rowid` was inserted in a batch before
// `batch`. The first probe of a new batch moves the pending entries into
// the forest.
rowset_test: fn(p: &RowSet, batch: Int, rowid: Int) -> Bool Never! {
    if batch != p.batch {
        if p.entries.len() > 0 {
            loop v in p.entries -> p.forest[v] = true
            p.entries = [Int]{}
            p.sorted = true
        }
        p.batch = batch
    }
    p.forest.get(rowid) != None
}

#Test("a rowset drains sorted and unique, and probes see only earlier batches") {
    r := rowset_new()
    values: [Int]{5, 3, 9, 3, 1, 9}
    loop v in values -> rowset_insert(r, v)
    got := [Int]{}
    loop {
        v: rowset_next(r) ?? break
        got.push(v)
    }
    assert_eq(got, [Int]{1, 3, 5, 9})
    assert(rowset_next(r) == None)

    t := rowset_new()
    rowset_insert(t, 7)
    assert(!rowset_test(t, 0, 7))
    assert(rowset_test(t, 1, 7))
    rowset_insert(t, 8)
    assert(!rowset_test(t, 1, 8))
    assert(rowset_test(t, 2, 8))
    assert(!rowset_test(t, 2, 9))
}
