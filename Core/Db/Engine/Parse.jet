// The SQL parser of the Jet SQLite engine, a port of SQLite 3.45.0: the
// LALR(1) engine lemon generates (lempar.c as emitted in sqlite3.c's
// parse.c section), the grammar actions of parse.y, and sqlite3RunParser of
// tokenize.c. The parse tables are ParseTables.jet.
//
// lemon gives every grammar symbol a slot of one union, YYMINORTYPE. Here a
// slot is one SQLTok, whose two Ints carry every union member:
//
//   Token (yy0)                          z, n
//   int, Expr*, ExprList*, SrcList*, Select*, IdList*, With*, Cte*,
//   Window*, Upsert*, TriggerStep*, u32, const char* (an SQL offset)
//                                        z (an arena index, -1 for NULL)
//   struct {int value; int mask;} (yy231) z = value, n = mask
//   struct TrigEvent {a, b} (yy180)      z = a, n = b (an IdList index)
//   struct FrameBound {eType, pExpr}     z = eType, n = pExpr
//   OnOrUsing {pOn, pUsing} (yy561)      z = pOn, n = pUsing
//
// A rule's action reads the right-hand side slots and yields the value of
// the left-hand side slot; a rule without an action (or whose action leaves
// the left-hand side alone) keeps the slot's old value, as C does.
//
// Not ported, each for a stated reason:
// - yy_destructor: C frees the values on the stack when a syntax error
//   discards them. Deleting frees nothing in the arena (Ast.jet), and the
//   side effects deletes keep matter only to a statement that survives; a
//   statement with a syntax error is discarded whole.
// - disableLookaside (createkw, add_column_fullname): it switches off
//   SQLite's lookaside allocator, which this engine does not have.
// - the rename-mode token maps of sqlite3RenameTokenMap/Remap: ported with
//   ALTER TABLE RENAME (alter.c).
// - db->u1.isInterrupted: sqlite3_interrupt has no counterpart in core.db.
use {
    base: __core_db_base
    tables: __core_db_parsetables
    tk: __core_db_tokenize
    ast: __core_db_ast
    util: __core_db_util
    __core_db_util.[sql_byte, is_digit, is_quote, dequote, get_int32]
}

// Table.tabFlags values the table options give (sqliteInt.h).
TF_WITHOUT_ROWID: 128
TF_NO_VISIBLE_ROWID: 512
TF_STRICT: 65536

// Index.idxType (sqliteInt.h SQLITE_IDXTYPE_*).
IDXTYPE_APPDEF: 0
IDXTYPE_UNIQUE: 1

// The bit likeop sets on its token's length for NOT LIKE (parse.y).
LIKE_NOT_BIT: 2147483648

// The routines of build.c, select.c, delete.c, update.c, insert.c,
// trigger.c, pragma.c, attach.c, analyze.c, alter.c, vtab.c and vacuum.c
// the grammar actions call, one method each. A token argument the C code
// passes as a NULL pointer arrives as {z: -1, n: 0}, as does a token whose
// z is NULL; object arguments are arena indexes, -1 for NULL.
SQLBuilder: trait {
    // sqlite3FinishCoding.
    finish_coding: fn(&self, a: &ast.AST) Never!
    // sqlite3BeginTransaction / sqlite3EndTransaction / sqlite3Savepoint.
    begin_transaction: fn(&self, a: &ast.AST, kind: Int) Never!
    end_transaction: fn(&self, a: &ast.AST, op: Int) Never!
    savepoint: fn(&self, a: &ast.AST, op: Int, name: ast.SQLTok) Never!
    // sqlite3StartTable.
    start_table: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok, is_temp: Int, is_view: Int, is_virtual: Int, no_err: Int) Never!
    // sqlite3EndTable: `cons` and `end` are the tokens ending the column
    // list and the statement, `select` the CREATE TABLE AS query.
    end_table: fn(&self, a: &ast.AST, cons: ast.SQLTok, end: ast.SQLTok, tab_opts: Int, select: Int) Never!
    // sqlite3AddColumn.
    add_column: fn(&self, a: &ast.AST, name: ast.SQLTok, typ: ast.SQLTok) Never!
    // sqlite3AddDefaultValue: the expression and its text, sql[start, end).
    add_default_value: fn(&self, a: &ast.AST, e: Int, start: Int, end: Int) Never!
    // sqlite3AddNotNull.
    add_not_null: fn(&self, a: &ast.AST, on_error: Int) Never!
    // sqlite3AddPrimaryKey.
    add_primary_key: fn(&self, a: &ast.AST, list: Int, on_error: Int, autoinc: Int, sort_order: Int) Never!
    // sqlite3CreateIndex.
    create_index: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok, tbl: Int, list: Int, on_error: Int, start: ast.SQLTok, where_expr: Int, sort_order: Int, if_not_exist: Int, idx_type: Int) Never!
    // sqlite3AddCheckConstraint: the expression and its text, sql[start, end).
    add_check_constraint: fn(&self, a: &ast.AST, e: Int, start: Int, end: Int) Never!
    // sqlite3CreateForeignKey / sqlite3DeferForeignKey.
    create_foreign_key: fn(&self, a: &ast.AST, from_cols: Int, to: ast.SQLTok, to_cols: Int, flags: Int) Never!
    defer_foreign_key: fn(&self, a: &ast.AST, deferred: Int) Never!
    // sqlite3AddCollateType.
    add_collate_type: fn(&self, a: &ast.AST, name: ast.SQLTok) Never!
    // sqlite3AddGenerated.
    add_generated: fn(&self, a: &ast.AST, e: Int, typ: ast.SQLTok) Never!
    // sqlite3DropTable.
    drop_table: fn(&self, a: &ast.AST, name: Int, is_view: Int, no_err: Int) Never!
    // sqlite3CreateView.
    create_view: fn(&self, a: &ast.AST, begin: ast.SQLTok, name1: ast.SQLTok, name2: ast.SQLTok, cols: Int, select: Int, is_temp: Int, no_err: Int) Never!
    // sqlite3Select with the SRT_Output destination (cmd ::= select).
    select_output: fn(&self, a: &ast.AST, select: Int) Never!
    // sqlite3DeleteFrom.
    delete_from: fn(&self, a: &ast.AST, src: Int, where_expr: Int, order_by: Int, limit: Int) Never!
    // sqlite3AddReturning.
    add_returning: fn(&self, a: &ast.AST, list: Int) Never!
    // sqlite3Update.
    update: fn(&self, a: &ast.AST, src: Int, changes: Int, where_expr: Int, on_error: Int, order_by: Int, limit: Int, upsert: Int) Never!
    // sqlite3Insert.
    insert: fn(&self, a: &ast.AST, src: Int, select: Int, cols: Int, on_error: Int, upsert: Int) Never!
    // sqlite3DropIndex.
    drop_index: fn(&self, a: &ast.AST, name: Int, if_exists: Int) Never!
    // sqlite3Vacuum.
    vacuum: fn(&self, a: &ast.AST, name: ast.SQLTok, into: Int) Never!
    // sqlite3Pragma.
    pragma: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok, value: ast.SQLTok, minus: Int) Never!
    // sqlite3BeginTrigger / sqlite3FinishTrigger / sqlite3DropTrigger.
    begin_trigger: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok, tr_tm: Int, op: Int, columns: Int, table: Int, when: Int, is_temp: Int, no_err: Int) Never!
    finish_trigger: fn(&self, a: &ast.AST, steps: Int, all: ast.SQLTok) Never!
    drop_trigger: fn(&self, a: &ast.AST, name: Int, no_err: Int) Never!
    // sqlite3Attach / sqlite3Detach.
    attach: fn(&self, a: &ast.AST, filename: Int, dbname: Int, key: Int) Never!
    detach: fn(&self, a: &ast.AST, dbname: Int) Never!
    // sqlite3Reindex / sqlite3Analyze.
    reindex: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok) Never!
    analyze: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok) Never!
    // sqlite3AlterRenameTable, sqlite3AlterBeginAddColumn,
    // sqlite3AlterFinishAddColumn, sqlite3AlterDropColumn,
    // sqlite3AlterRenameColumn.
    alter_rename_table: fn(&self, a: &ast.AST, src: Int, name: ast.SQLTok) Never!
    alter_begin_add_column: fn(&self, a: &ast.AST, src: Int) Never!
    alter_finish_add_column: fn(&self, a: &ast.AST, col_def: ast.SQLTok) Never!
    alter_drop_column: fn(&self, a: &ast.AST, src: Int, name: ast.SQLTok) Never!
    alter_rename_column: fn(&self, a: &ast.AST, src: Int, old_name: ast.SQLTok, new_name: ast.SQLTok) Never!
    // sqlite3VtabBeginParse, sqlite3VtabFinishParse, sqlite3VtabArgInit,
    // sqlite3VtabArgExtend.
    vtab_begin_parse: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok, module_name: ast.SQLTok, if_not_exists: Int) Never!
    vtab_finish_parse: fn(&self, a: &ast.AST, end: ast.SQLTok) Never!
    vtab_arg_init: fn(&self, a: &ast.AST) Never!
    vtab_arg_extend: fn(&self, a: &ast.AST, t: ast.SQLTok) Never!
}

// yyStackEntry.
SQLStackEntry: struct {
    stateno: Int
    major: Int
    minor: ast.SQLTok
}

// yyParser with a fixed stack of YYSTACKDEPTH entries.
SQLParser: struct {
    tos: Int
    errcnt: Int
    stack: [SQLStackEntry]
}

no_tok: fn() -> ast.SQLTok Never! { ast.SQLTok{z: -1, n: 0} }

// A slot holding a single Int.
tv: fn(v: Int) -> ast.SQLTok Never! { ast.SQLTok{z: v, n: 0} }

// The Int, the token and the major code of stack entry `i`.
sv: fn(s: [SQLStackEntry], i: Int) -> Int Never! { s[i].minor.z }

st: fn(s: [SQLStackEntry], i: Int) -> ast.SQLTok Never! { s[i].minor }

sm: fn(s: [SQLStackEntry], i: Int) -> Int Never! { s[i].major }

// sqlite3ParserInit.
new_parser: fn() -> SQLParser Never! {
    stack := [SQLStackEntry]{}
    loop _i in 0..<tables.YYSTACKDEPTH -> stack.push(SQLStackEntry{stateno: 0, major: 0, minor: no_tok()})
    SQLParser{tos: 0, errcnt: -1, stack: stack}
}

// yy_find_shift_action: the action for terminal `look0` in `stateno`,
// following YYFALLBACK and YYWILDCARD.
find_shift_action: fn(look0: Int, stateno: Int) -> Int Never! {
    if stateno > tables.YY_MAX_SHIFT -> return stateno
    look := look0
    loop {
        i: tables.YY_SHIFT_OFST[stateno] + look
        if tables.YY_LOOKAHEAD[i] == look -> return tables.YY_ACTION[i]
        fallback: tables.YY_FALLBACK[look]
        if fallback != 0 {
            look = fallback
            next
        }
        j: i - look + tables.YYWILDCARD
        if tables.YY_LOOKAHEAD[j] == tables.YYWILDCARD && look > 0 -> return tables.YY_ACTION[j]
        return tables.YY_DEFAULT[stateno]
    }
}

// yy_find_reduce_action: the action for nonterminal `look` in `stateno`.
find_reduce_action: fn(stateno: Int, look: Int) -> Int Never! {
    tables.YY_ACTION[tables.YY_REDUCE_OFST[stateno] + look]
}

// yyStackOverflow: pop everything and report the %stack_overflow error.
stack_overflow: fn(p: &SQLParser, a: &ast.AST) Never! {
    p.tos = 0
    ast.error(a, "parser stack overflow")
}

// yy_shift.
shift: fn(p: &SQLParser, a: &ast.AST, new_state: Int, major: Int, minor: ast.SQLTok) Never! {
    p.tos += 1
    if p.tos > tables.YYSTACKDEPTH - 1 {
        p.tos -= 1
        stack_overflow(p, a)
        return
    }
    state: if new_state > tables.YY_MAX_SHIFT -> new_state + tables.YY_MIN_REDUCE - tables.YY_MIN_SHIFTREDUCE else -> new_state
    p.stack[p.tos] = SQLStackEntry{stateno: state, major: major, minor: minor}
}

// The %syntax_error code of parse.y.
syntax_error: fn(a: &ast.AST, t: ast.SQLTok) Never! {
    if sql_byte(a.ctx.sql, t.z) != 0 {
        txt: ast.tok_text(a, t)
        off: ast.tok_offset(a, t)
        ast.error_at(a, "near \"{txt}\": syntax error", off)
    } else {
        ast.error(a, "incomplete input")
    }
}

// sqlite3Parser: feed one token (major 0 ends the input). The grammar has
// no error symbol: a token that cannot shift is reported, unless one of
// the last three tokens already was, and dropped; at the end of the input
// the parse fails.
parse_token: fn<B: SQLBuilder>(p: &SQLParser, b: &B, a: &ast.AST, major: Int, minor: ast.SQLTok) Never! {
    end_of_input: major == 0
    act := p.stack[p.tos].stateno
    loop {
        act = find_shift_action(major, act)
        if act >= tables.YY_MIN_REDUCE {
            rule: act - tables.YY_MIN_REDUCE
            if tables.YY_RULE_NRHS[rule] == 0 && p.tos >= tables.YYSTACKDEPTH - 1 {
                stack_overflow(p, a)
                break
            }
            act = reduce<B>(p, b, a, rule, minor)
        } else if act <= tables.YY_MAX_SHIFTREDUCE {
            shift(p, a, act, major, minor)
            p.errcnt -= 1
            break
        } else if act == tables.YY_ACCEPT_ACTION {
            p.tos -= 1
            p.errcnt = -1
            return
        } else {
            if p.errcnt <= 0 -> syntax_error(a, minor)
            p.errcnt = 3
            if end_of_input {
                p.tos = 0
                p.errcnt = -1
            }
            break
        }
    }
}

// yy_reduce: run rule `rule` (its action, then the goto) with lookahead
// token `look`; the action now current.
reduce: fn<B: SQLBuilder>(p: &SQLParser, b: &B, a: &ast.AST, rule: Int, look: ast.SQLTok) -> Int Never! {
    m: p.tos
    nrhs: tables.YY_RULE_NRHS[rule]
    lhs: m + nrhs + 1
    keep: p.stack[lhs].minor
    value := keep
    if rule < 100 {
        value = actions_ddl<B>(b, a, p.stack, m, rule, look, keep)
    } else if rule < 178 {
        value = actions_query<B>(b, a, p.stack, m, rule, keep)
    } else if rule < 258 {
        value = actions_expr<B>(b, a, p.stack, m, rule, keep)
    } else if rule < tables.YYNRULE_WITH_ACTION {
        value = actions_trigger<B>(b, a, p.stack, m, rule, keep)
    }
    goto: tables.YY_RULE_LHS[rule]
    act: find_reduce_action(p.stack[m + nrhs].stateno, goto)
    p.tos = lhs
    p.stack[lhs] = SQLStackEntry{stateno: act, major: goto, minor: value}
    act
}

// ---------------------------------------------------------------------------
// Helpers of parse.y's %include blocks.

// tokenExpr: a leaf node for one token, dequoted when quoted.
token_expr: fn(a: &ast.AST, op: Int, t: ast.SQLTok) -> Int Never! {
    z: ast.tok_bytes(a, t)
    e := ast.zero_expr(op)
    e.flags = ast.EP_LEAF
    e.w = t.z
    if z.len() > 0 && is_quote(Int.from_u8(z[0])) {
        e.flags = e.flags.bit_or(if z[0] == (U8{34}) -> ast.EP_QUOTED.bit_or(ast.EP_DBL_QUOTED) else -> ast.EP_QUOTED)
        e.token = Val(dequote(z))
    } else {
        e.token = Val(z)
    }
    e.height = 1
    ast.push_expr(a, e)
}

// parserDoubleLinkSelect: point each SELECT of a compound at the next and
// check the compound's length.
double_link_select: fn(a: &ast.AST, p: Int) Never! {
    if a.selects[p].prior < 0 -> return
    nxt := -1
    lp := p
    cnt := 1
    loop {
        a.selects[lp].next_sel = nxt
        a.selects[lp].sel_flags = a.selects[lp].sel_flags.bit_or(ast.SF_COMPOUND)
        nxt = lp
        lp = a.selects[lp].prior
        if lp < 0 -> break
        cnt += 1
        if a.selects[lp].order_by >= 0 || a.selects[lp].limit >= 0 {
            what: if a.selects[lp].order_by >= 0 -> "ORDER BY" else -> "LIMIT"
            op: ast.select_op_name(a.selects[nxt].op)
            ast.error(a, "{what} clause should come after {op} not before")
            break
        }
    }
    mx: a.limits[ast.LIMIT_COMPOUND_SELECT]
    if a.selects[p].sel_flags.bit_and(ast.SF_MULTI_VALUE) == 0 && mx > 0 && cnt > mx -> ast.error(a, "too many terms in compound SELECT")
}

// attachWithToSelect.
attach_with_to_select: fn(a: &ast.AST, sel: Int, w: Int) -> Int Never! {
    if sel >= 0 {
        a.selects[sel].with_clause = w
        double_link_select(a, sel)
    } else {
        ast.with_delete(a, w)
    }
    sel
}

// binaryToUnaryIfNull: "x IS NULL" and "x IS NOT NULL" become TK_ISNULL
// and TK_NOTNULL.
binary_to_unary_if_null: fn(a: &ast.AST, y: Int, e: Int, op: Int) Never! {
    if e >= 0 && y >= 0 && a.exprs[y].op == tk.TK_NULL && !ast.in_rename(a) {
        a.exprs[e].op = op
        ast.expr_delete(a, a.exprs[e].right)
        a.exprs[e].right = -1
    }
}

// parserAddExprIdListTerm: one name of an index-column-style list; COLLATE
// or a sort order is an error outside a legacy schema.
add_expr_id_list_term: fn(a: &ast.AST, prior: Int, name: ast.SQLTok, has_collate: Int, sort_order: Int) -> Int Never! {
    p: ast.expr_list_append(a, prior, -1)
    if (has_collate != 0 || sort_order != ast.SO_UNDEFINED) && !a.init_busy {
        txt: ast.tok_text(a, name)
        ast.error(a, "syntax error after column name \"{txt}\"")
    }
    nb: ast.tok_bytes(a, name)
    ast.expr_list_set_name(a, p, nb, true)
    p
}

// The bytes of a token as the C token pointer NameFromToken reads.
opt: fn(a: ast.AST, t: ast.SQLTok) -> [U8]? Never! { ast.tok_opt(a, t) }

// The text of sql[t.z, t.z + t.n) for a "%.*s" argument.
span_text: fn(a: ast.AST, t: ast.SQLTok) -> String Never! { ast.tok_text(a, t) }

// ---------------------------------------------------------------------------
// Grammar actions (sqlite3.c yy_reduce, parse.y rules 0-339). `s` is the
// stack and `m` the index of the last right-hand side symbol (yymsp), so
// the k-th symbol from the end is s[m - k]; `keep` is the left-hand side
// slot's current value.

// Rules 0-99: commands, CREATE TABLE, DROP, CREATE VIEW, SELECT heads.
actions_ddl: fn<B: SQLBuilder>(b: &B, a: &ast.AST, s: [SQLStackEntry], m: Int, rule: Int, look: ast.SQLTok, keep: ast.SQLTok) -> ast.SQLTok Never! {
    if rule == {
        // explain ::= EXPLAIN
        0 -> {
            if !a.ctx.reprepare -> a.ctx.explain = 1
            keep
        }
        // explain ::= EXPLAIN QUERY PLAN
        1 -> {
            if !a.ctx.reprepare -> a.ctx.explain = 2
            keep
        }
        // cmdx ::= cmd
        2 -> {
            b.finish_coding(a)
            keep
        }
        // cmd ::= BEGIN transtype trans_opt
        3 -> {
            b.begin_transaction(a, sv(s, m - 1))
            keep
        }
        // transtype ::=
        4 -> tv(tk.TK_DEFERRED)
        // transtype ::= DEFERRED|IMMEDIATE|EXCLUSIVE
        5 | 6 | 7 -> tv(sm(s, m))
        // cmd ::= COMMIT|END trans_opt, cmd ::= ROLLBACK trans_opt
        8 | 9 -> {
            b.end_transaction(a, sm(s, m - 1))
            keep
        }
        // cmd ::= SAVEPOINT nm
        10 -> {
            b.savepoint(a, base.SAVEPOINT_BEGIN, st(s, m))
            keep
        }
        // cmd ::= RELEASE savepoint_opt nm
        11 -> {
            b.savepoint(a, base.SAVEPOINT_RELEASE, st(s, m))
            keep
        }
        // cmd ::= ROLLBACK trans_opt TO savepoint_opt nm
        12 -> {
            b.savepoint(a, base.SAVEPOINT_ROLLBACK, st(s, m))
            keep
        }
        // create_table ::= createkw temp TABLE ifnotexists nm dbnm
        13 -> {
            b.start_table(a, st(s, m - 1), st(s, m), sv(s, m - 4), 0, 0, sv(s, m - 2))
            keep
        }
        // createkw ::= CREATE (disableLookaside; the slot keeps the token)
        14 -> keep
        // ifnotexists ::=, temp ::=, autoinc ::=, init_deferred_pred_opt ::=,
        // defer_subclause_opt ::=, ifexists ::=, distinct ::=
        15 | 18 | 47 | 62 | 72 | 81 | 98 -> tv(0)
        // ifnotexists ::= IF NOT EXISTS
        16 -> tv(1)
        // temp ::= TEMP
        17 -> tv(if a.init_busy -> 0 else -> 1)
        // create_table_args ::= LP columnlist conslist_opt RP table_option_set
        19 -> {
            b.end_table(a, st(s, m - 2), st(s, m - 1), sv(s, m), -1)
            keep
        }
        // create_table_args ::= AS select
        20 -> {
            b.end_table(a, no_tok(), no_tok(), 0, sv(s, m))
            ast.select_delete(a, sv(s, m))
            keep
        }
        // table_option_set ::=
        21 -> tv(0)
        // table_option_set ::= table_option_set COMMA table_option
        22 -> tv(sv(s, m - 2).bit_or(sv(s, m)))
        // table_option ::= WITHOUT nm
        23 -> {
            t: st(s, m)
            if ast.tok_is(a, t, "rowid".bytes()) -> return tv(TF_WITHOUT_ROWID.bit_or(TF_NO_VISIBLE_ROWID))
            txt: span_text(a, t)
            ast.error(a, "unknown table option: {txt}")
            tv(0)
        }
        // table_option ::= nm
        24 -> {
            t: st(s, m)
            if ast.tok_is(a, t, "strict".bytes()) -> return tv(TF_STRICT)
            txt: span_text(a, t)
            ast.error(a, "unknown table option: {txt}")
            tv(0)
        }
        // columnname ::= nm typetoken
        25 -> {
            b.add_column(a, st(s, m - 1), st(s, m))
            keep
        }
        // typetoken ::=, conslist_opt ::=, as ::=
        26 | 65 -> no_tok()
        // typetoken ::= typename LP signed RP
        27 -> {
            t: st(s, m - 3)
            e: st(s, m)
            ast.SQLTok{z: t.z, n: e.z + e.n - t.z}
        }
        // typetoken ::= typename LP signed COMMA signed RP
        28 -> {
            t: st(s, m - 5)
            e: st(s, m)
            ast.SQLTok{z: t.z, n: e.z + e.n - t.z}
        }
        // typename ::= typename ID|STRING
        29 -> {
            t: st(s, m - 1)
            e: st(s, m)
            ast.SQLTok{z: t.z, n: e.n + e.z - t.z}
        }
        // scanpt ::=
        30 -> tv(look.z)
        // scantok ::=
        31 -> look
        // ccons ::= CONSTRAINT nm, tcons ::= CONSTRAINT nm
        32 | 67 -> {
            a.ctx.constraint_name = st(s, m)
            keep
        }
        // ccons ::= DEFAULT scantok term
        33 -> {
            t: st(s, m - 1)
            b.add_default_value(a, sv(s, m), t.z, t.z + t.n)
            keep
        }
        // ccons ::= DEFAULT LP expr RP
        34 -> {
            b.add_default_value(a, sv(s, m - 1), st(s, m - 2).z + 1, st(s, m).z)
            keep
        }
        // ccons ::= DEFAULT PLUS scantok term
        35 -> {
            t: st(s, m - 1)
            b.add_default_value(a, sv(s, m), st(s, m - 2).z, t.z + t.n)
            keep
        }
        // ccons ::= DEFAULT MINUS scantok term
        36 -> {
            e: ast.pexpr(a, tk.TK_UMINUS, sv(s, m), -1)
            t: st(s, m - 1)
            b.add_default_value(a, e, st(s, m - 2).z, t.z + t.n)
            keep
        }
        // ccons ::= DEFAULT scantok ID|INDEXED
        37 -> {
            t: st(s, m)
            e: token_expr(a, tk.TK_STRING, t)
            _ := ast.expr_id_to_true_false(a, e)
            b.add_default_value(a, e, t.z, t.z + t.n)
            keep
        }
        // ccons ::= NOT NULL onconf
        38 -> {
            b.add_not_null(a, sv(s, m))
            keep
        }
        // ccons ::= PRIMARY KEY sortorder onconf autoinc
        39 -> {
            b.add_primary_key(a, -1, sv(s, m - 1), sv(s, m), sv(s, m - 2))
            keep
        }
        // ccons ::= UNIQUE onconf
        40 -> {
            b.create_index(a, no_tok(), no_tok(), -1, -1, sv(s, m), no_tok(), -1, 0, 0, IDXTYPE_UNIQUE)
            keep
        }
        // ccons ::= CHECK LP expr RP
        41 -> {
            b.add_check_constraint(a, sv(s, m - 1), st(s, m - 2).z, st(s, m).z)
            keep
        }
        // ccons ::= REFERENCES nm eidlist_opt refargs
        42 -> {
            b.create_foreign_key(a, -1, st(s, m - 2), sv(s, m - 1), sv(s, m))
            keep
        }
        // ccons ::= defer_subclause
        43 -> {
            b.defer_foreign_key(a, sv(s, m))
            keep
        }
        // ccons ::= COLLATE ID|STRING
        44 -> {
            b.add_collate_type(a, st(s, m))
            keep
        }
        // generated ::= LP expr RP
        45 -> {
            b.add_generated(a, sv(s, m - 1), no_tok())
            keep
        }
        // generated ::= LP expr RP ID
        46 -> {
            b.add_generated(a, sv(s, m - 2), st(s, m))
            keep
        }
        // autoinc ::= AUTOINCR
        48 -> tv(1)
        // refargs ::=
        49 -> tv(ast.OE_NONE * 257)
        // refargs ::= refargs refarg
        50 -> tv(util.clear_bits(sv(s, m - 1), st(s, m).n).bit_or(sv(s, m)))
        // refarg ::= MATCH nm, refarg ::= ON INSERT refact
        51 | 52 -> ast.SQLTok{z: 0, n: 0}
        // refarg ::= ON DELETE refact
        53 -> ast.SQLTok{z: sv(s, m), n: 255}
        // refarg ::= ON UPDATE refact
        54 -> ast.SQLTok{z: sv(s, m) * 256, n: 65280}
        // refact ::= SET NULL
        55 -> tv(ast.OE_SET_NULL)
        // refact ::= SET DEFAULT
        56 -> tv(ast.OE_SET_DFLT)
        // refact ::= CASCADE
        57 -> tv(ast.OE_CASCADE)
        // refact ::= RESTRICT
        58 -> tv(ast.OE_RESTRICT)
        // refact ::= NO ACTION
        59 -> tv(ast.OE_NONE)
        // defer_subclause ::= NOT DEFERRABLE init_deferred_pred_opt
        60 -> tv(0)
        // defer_subclause ::= DEFERRABLE init_deferred_pred_opt,
        // orconf ::= OR resolvetype
        61 | 76 -> tv(sv(s, m))
        // init_deferred_pred_opt ::= INITIALLY DEFERRED, ifexists ::= IF EXISTS
        63 | 80 -> tv(1)
        // init_deferred_pred_opt ::= INITIALLY IMMEDIATE
        64 -> tv(0)
        // tconscomma ::= COMMA
        66 -> {
            a.ctx.constraint_name.n = 0
            keep
        }
        // tcons ::= PRIMARY KEY LP sortlist autoinc RP onconf
        68 -> {
            b.add_primary_key(a, sv(s, m - 3), sv(s, m), sv(s, m - 2), 0)
            keep
        }
        // tcons ::= UNIQUE LP sortlist RP onconf
        69 -> {
            b.create_index(a, no_tok(), no_tok(), -1, sv(s, m - 2), sv(s, m), no_tok(), -1, 0, 0, IDXTYPE_UNIQUE)
            keep
        }
        // tcons ::= CHECK LP expr RP onconf
        70 -> {
            b.add_check_constraint(a, sv(s, m - 2), st(s, m - 3).z, st(s, m - 1).z)
            keep
        }
        // tcons ::= FOREIGN KEY LP eidlist RP REFERENCES nm eidlist_opt
        //           refargs defer_subclause_opt
        71 -> {
            b.create_foreign_key(a, sv(s, m - 6), st(s, m - 3), sv(s, m - 2), sv(s, m - 1))
            b.defer_foreign_key(a, sv(s, m))
            keep
        }
        // onconf ::=, orconf ::=
        73 | 75 -> tv(ast.OE_DEFAULT)
        // onconf ::= ON CONFLICT resolvetype
        74 -> tv(sv(s, m))
        // resolvetype ::= IGNORE
        77 -> tv(ast.OE_IGNORE)
        // resolvetype ::= REPLACE
        78 -> tv(ast.OE_REPLACE)
        // cmd ::= DROP TABLE ifexists fullname
        79 -> {
            b.drop_table(a, sv(s, m), 0, sv(s, m - 1))
            keep
        }
        // cmd ::= createkw temp VIEW ifnotexists nm dbnm eidlist_opt AS select
        82 -> {
            b.create_view(a, st(s, m - 8), st(s, m - 4), st(s, m - 3), sv(s, m - 2), sv(s, m), sv(s, m - 7), sv(s, m - 5))
            keep
        }
        // cmd ::= DROP VIEW ifexists fullname
        83 -> {
            b.drop_table(a, sv(s, m), 1, sv(s, m - 1))
            keep
        }
        // cmd ::= select
        84 -> {
            b.select_output(a, sv(s, m))
            ast.select_delete(a, sv(s, m))
            keep
        }
        // select ::= WITH wqlist selectnowith,
        // select ::= WITH RECURSIVE wqlist selectnowith
        85 | 86 -> tv(attach_with_to_select(a, sv(s, m), sv(s, m - 1)))
        // select ::= selectnowith
        87 -> {
            if sv(s, m) >= 0 -> double_link_select(a, sv(s, m))
            keep
        }
        // selectnowith ::= selectnowith multiselect_op oneselect
        88 -> {
            rhs := sv(s, m)
            lhs: sv(s, m - 2)
            op: sv(s, m - 1)
            if rhs >= 0 && a.selects[rhs].prior >= 0 {
                double_link_select(a, rhs)
                from: ast.src_list_append_from_term(a, -1, None, None, [U8]{}, rhs, -1, -1)
                rhs = ast.select_new(a, -1, from, -1, -1, -1, -1, 0, -1)
            }
            if rhs >= 0 {
                a.selects[rhs].op = op
                a.selects[rhs].prior = lhs
                if lhs >= 0 -> a.selects[lhs].sel_flags = util.clear_bits(a.selects[lhs].sel_flags, ast.SF_MULTI_VALUE)
                a.selects[rhs].sel_flags = util.clear_bits(a.selects[rhs].sel_flags, ast.SF_MULTI_VALUE)
                if op != tk.TK_ALL -> a.ctx.has_compound = true
            } else {
                ast.select_delete(a, lhs)
            }
            tv(rhs)
        }
        // multiselect_op ::= UNION, multiselect_op ::= EXCEPT|INTERSECT
        89 | 91 -> tv(sm(s, m))
        // multiselect_op ::= UNION ALL
        90 -> tv(tk.TK_ALL)
        // oneselect ::= SELECT distinct selcollist from where_opt groupby_opt
        //               having_opt orderby_opt limit_opt
        92 -> tv(ast.select_new(a, sv(s, m - 6), sv(s, m - 5), sv(s, m - 4), sv(s, m - 3), sv(s, m - 2), sv(s, m - 1), sv(s, m - 7), sv(s, m)))
        // oneselect ::= SELECT distinct selcollist from where_opt groupby_opt
        //               having_opt window_clause orderby_opt limit_opt
        93 -> {
            sel: ast.select_new(a, sv(s, m - 7), sv(s, m - 6), sv(s, m - 5), sv(s, m - 4), sv(s, m - 3), sv(s, m - 1), sv(s, m - 8), sv(s, m))
            if sel >= 0 {
                a.selects[sel].win_defn = sv(s, m - 2)
            } else {
                ast.window_list_delete(a, sv(s, m - 2))
            }
            tv(sel)
        }
        // values ::= VALUES LP nexprlist RP
        94 -> tv(ast.select_new(a, sv(s, m - 1), -1, -1, -1, -1, -1, ast.SF_VALUES, -1))
        // values ::= values COMMA LP nexprlist RP
        95 -> {
            left: sv(s, m - 4)
            right: ast.select_new(a, sv(s, m - 1), -1, -1, -1, -1, -1, ast.SF_VALUES.bit_or(ast.SF_MULTI_VALUE), -1)
            if left >= 0 -> a.selects[left].sel_flags = util.clear_bits(a.selects[left].sel_flags, ast.SF_MULTI_VALUE)
            if right < 0 -> return tv(left)
            a.selects[right].op = tk.TK_ALL
            a.selects[right].prior = left
            tv(right)
        }
        // distinct ::= DISTINCT
        96 -> tv(ast.SF_DISTINCT)
        // distinct ::= ALL
        97 -> tv(ast.SF_ALL)
        // sclp ::=
        99 -> tv(-1)
        else -> keep
    }
}

// Rules 100-177: result columns, FROM, ORDER BY, LIMIT, DELETE, UPDATE,
// INSERT, upserts, id lists.
actions_query: fn<B: SQLBuilder>(b: &B, a: &ast.AST, s: [SQLStackEntry], m: Int, rule: Int, keep: ast.SQLTok) -> ast.SQLTok Never! {
    if rule == {
        // selcollist ::= sclp scanpt expr scanpt as
        100 -> {
            l: ast.expr_list_append(a, sv(s, m - 4), sv(s, m - 2))
            alias: st(s, m)
            if alias.n > 0 {
                nb: ast.tok_bytes(a, alias)
                ast.expr_list_set_name(a, l, nb, true)
            }
            ast.expr_list_set_span(a, l, sv(s, m - 3), sv(s, m - 1))
            tv(l)
        }
        // selcollist ::= sclp scanpt STAR
        101 -> {
            e: ast.expr(a, tk.TK_ASTERISK, [U8]{})
            ast.expr_set_error_offset(a, e, st(s, m).z)
            tv(ast.expr_list_append(a, sv(s, m - 2), e))
        }
        // selcollist ::= sclp scanpt nm DOT STAR
        102 -> {
            right: ast.pexpr(a, tk.TK_ASTERISK, -1, -1)
            ast.expr_set_error_offset(a, right, st(s, m).z)
            left: token_expr(a, tk.TK_ID, st(s, m - 2))
            dot: ast.pexpr(a, tk.TK_DOT, left, right)
            tv(ast.expr_list_append(a, sv(s, m - 4), dot))
        }
        // as ::= AS nm, dbnm ::= DOT nm
        103 | 115 -> st(s, m)
        // as ::=, dbnm ::=, indexed_opt ::=
        104 | 114 | 129 -> no_tok()
        // from ::=, stl_prefix ::=
        105 | 108 -> tv(-1)
        // from ::= FROM seltablist
        106 -> {
            ast.src_list_shift_join_type(a, sv(s, m))
            tv(sv(s, m))
        }
        // stl_prefix ::= seltablist joinop
        107 -> {
            l: sv(s, m - 1)
            n: ast.src_len(a, l)
            if n > 0 {
                si: ast.src_item(a, l, n - 1)
                a.items[si].jointype = sv(s, m)
            }
            keep
        }
        // seltablist ::= stl_prefix nm dbnm as on_using
        109 -> {
            ou: st(s, m)
            tb: opt(a, st(s, m - 3))
            db: opt(a, st(s, m - 2))
            alias: ast.tok_bytes(a, st(s, m - 1))
            tv(ast.src_list_append_from_term(a, sv(s, m - 4), tb, db, alias, -1, ou.z, ou.n))
        }
        // seltablist ::= stl_prefix nm dbnm as indexed_by on_using
        110 -> {
            ou: st(s, m)
            tb: opt(a, st(s, m - 4))
            db: opt(a, st(s, m - 3))
            alias: ast.tok_bytes(a, st(s, m - 2))
            l: ast.src_list_append_from_term(a, sv(s, m - 5), tb, db, alias, -1, ou.z, ou.n)
            ast.src_list_indexed_by(a, l, st(s, m - 1))
            tv(l)
        }
        // seltablist ::= stl_prefix nm dbnm LP exprlist RP as on_using
        111 -> {
            ou: st(s, m)
            tb: opt(a, st(s, m - 6))
            db: opt(a, st(s, m - 5))
            alias: ast.tok_bytes(a, st(s, m - 1))
            l: ast.src_list_append_from_term(a, sv(s, m - 7), tb, db, alias, -1, ou.z, ou.n)
            ast.src_list_func_args(a, l, sv(s, m - 3))
            tv(l)
        }
        // seltablist ::= stl_prefix LP select RP as on_using
        112 -> {
            ou: st(s, m)
            alias: ast.tok_bytes(a, st(s, m - 1))
            tv(ast.src_list_append_from_term(a, sv(s, m - 5), None, None, alias, sv(s, m - 3), ou.z, ou.n))
        }
        // seltablist ::= stl_prefix LP seltablist RP as on_using
        113 -> nested_from_term(a, s, m)
        // fullname ::= nm, xfullname ::= nm
        116 | 118 -> {
            tb: opt(a, st(s, m))
            tv(ast.src_list_append(a, -1, tb, None))
        }
        // fullname ::= nm DOT nm, xfullname ::= nm DOT nm
        117 | 119 -> {
            tb: opt(a, st(s, m - 2))
            db: opt(a, st(s, m))
            tv(ast.src_list_append(a, -1, tb, db))
        }
        // xfullname ::= nm DOT nm AS nm
        120 -> {
            tb: opt(a, st(s, m - 4))
            db: opt(a, st(s, m - 2))
            l: ast.src_list_append(a, -1, tb, db)
            if l >= 0 {
                alias: opt(a, st(s, m))
                si: ast.src_item(a, l, 0)
                a.items[si].alias = ast.name_from(alias)
            }
            tv(l)
        }
        // xfullname ::= nm AS nm
        121 -> {
            tb: opt(a, st(s, m - 2))
            l: ast.src_list_append(a, -1, tb, None)
            if l >= 0 {
                alias: opt(a, st(s, m))
                si: ast.src_item(a, l, 0)
                a.items[si].alias = ast.name_from(alias)
            }
            tv(l)
        }
        // joinop ::= COMMA|JOIN
        122 -> tv(ast.JT_INNER)
        // joinop ::= JOIN_KW JOIN
        123 -> tv(ast.join_type(a, st(s, m - 1), no_tok(), no_tok()))
        // joinop ::= JOIN_KW nm JOIN
        124 -> tv(ast.join_type(a, st(s, m - 2), st(s, m - 1), no_tok()))
        // joinop ::= JOIN_KW nm nm JOIN
        125 -> tv(ast.join_type(a, st(s, m - 3), st(s, m - 2), st(s, m - 1)))
        // on_using ::= ON expr
        126 -> ast.SQLTok{z: sv(s, m), n: -1}
        // on_using ::= USING LP idlist RP
        127 -> ast.SQLTok{z: -1, n: sv(s, m - 1)}
        // on_using ::=
        128 -> ast.SQLTok{z: -1, n: -1}
        // indexed_by ::= INDEXED BY nm
        130 -> st(s, m)
        // indexed_by ::= NOT INDEXED
        131 -> ast.SQLTok{z: -1, n: 1}
        // orderby_opt ::=, groupby_opt ::=
        132 | 142 -> tv(-1)
        // orderby_opt ::= ORDER BY sortlist, groupby_opt ::= GROUP BY nexprlist
        133 | 143 -> tv(sv(s, m))
        // sortlist ::= sortlist COMMA expr sortorder nulls
        134 -> {
            l: ast.expr_list_append(a, sv(s, m - 4), sv(s, m - 2))
            ast.expr_list_set_sort_order(a, l, sv(s, m - 1), sv(s, m))
            tv(l)
        }
        // sortlist ::= expr sortorder nulls
        135 -> {
            l: ast.expr_list_append(a, -1, sv(s, m - 2))
            ast.expr_list_set_sort_order(a, l, sv(s, m - 1), sv(s, m))
            tv(l)
        }
        // sortorder ::= ASC
        136 -> tv(ast.SO_ASC)
        // sortorder ::= DESC
        137 -> tv(ast.SO_DESC)
        // sortorder ::=, nulls ::=
        138 | 141 -> tv(ast.SO_UNDEFINED)
        // nulls ::= NULLS FIRST
        139 -> tv(ast.SO_ASC)
        // nulls ::= NULLS LAST
        140 -> tv(ast.SO_DESC)
        // having_opt ::=, limit_opt ::=, where_opt ::=, where_opt_ret ::=
        144 | 146 | 151 | 153 -> tv(-1)
        // having_opt ::= HAVING expr, where_opt ::= WHERE expr,
        // where_opt_ret ::= WHERE expr
        145 | 152 | 154 -> tv(sv(s, m))
        // limit_opt ::= LIMIT expr
        147 -> tv(ast.pexpr(a, tk.TK_LIMIT, sv(s, m), -1))
        // limit_opt ::= LIMIT expr OFFSET expr
        148 -> tv(ast.pexpr(a, tk.TK_LIMIT, sv(s, m - 2), sv(s, m)))
        // limit_opt ::= LIMIT expr COMMA expr
        149 -> tv(ast.pexpr(a, tk.TK_LIMIT, sv(s, m), sv(s, m - 2)))
        // cmd ::= with DELETE FROM xfullname indexed_opt where_opt_ret
        150 -> {
            ast.src_list_indexed_by(a, sv(s, m - 2), st(s, m - 1))
            b.delete_from(a, sv(s, m - 2), sv(s, m), -1, -1)
            keep
        }
        // where_opt_ret ::= RETURNING selcollist
        155 -> {
            b.add_returning(a, sv(s, m))
            tv(-1)
        }
        // where_opt_ret ::= WHERE expr RETURNING selcollist
        156 -> {
            b.add_returning(a, sv(s, m))
            tv(sv(s, m - 2))
        }
        // cmd ::= with UPDATE orconf xfullname indexed_opt SET setlist from
        //         where_opt_ret
        157 -> {
            src := sv(s, m - 5)
            ast.src_list_indexed_by(a, src, st(s, m - 4))
            ast.expr_list_check_length(a, sv(s, m - 2), "set list")
            from := sv(s, m - 1)
            if from >= 0 {
                if ast.src_len(a, from) > 1 {
                    sub: ast.select_new(a, -1, from, -1, -1, -1, -1, ast.SF_NESTED_FROM, -1)
                    from = ast.src_list_append_from_term(a, -1, None, None, [U8]{}, sub, -1, -1)
                }
                src = ast.src_list_append_list(a, src, from)
            }
            b.update(a, src, sv(s, m - 2), sv(s, m), sv(s, m - 6), -1, -1, -1)
            keep
        }
        // setlist ::= setlist COMMA nm EQ expr
        158 -> {
            l: ast.expr_list_append(a, sv(s, m - 4), sv(s, m))
            nb: ast.tok_bytes(a, st(s, m - 2))
            ast.expr_list_set_name(a, l, nb, true)
            tv(l)
        }
        // setlist ::= setlist COMMA LP idlist RP EQ expr
        159 -> tv(ast.expr_list_append_vector(a, sv(s, m - 6), sv(s, m - 3), sv(s, m)))
        // setlist ::= nm EQ expr
        160 -> {
            l: ast.expr_list_append(a, -1, sv(s, m))
            nb: ast.tok_bytes(a, st(s, m - 2))
            ast.expr_list_set_name(a, l, nb, true)
            tv(l)
        }
        // setlist ::= LP idlist RP EQ expr
        161 -> tv(ast.expr_list_append_vector(a, -1, sv(s, m - 3), sv(s, m)))
        // cmd ::= with insert_cmd INTO xfullname idlist_opt select upsert
        162 -> {
            b.insert(a, sv(s, m - 3), sv(s, m - 1), sv(s, m - 2), sv(s, m - 5), sv(s, m))
            keep
        }
        // cmd ::= with insert_cmd INTO xfullname idlist_opt DEFAULT VALUES
        //         returning
        163 -> {
            b.insert(a, sv(s, m - 4), -1, sv(s, m - 3), sv(s, m - 6), -1)
            keep
        }
        // upsert ::=
        164 -> tv(-1)
        // upsert ::= RETURNING selcollist
        165 -> {
            b.add_returning(a, sv(s, m))
            tv(-1)
        }
        // upsert ::= ON CONFLICT LP sortlist RP where_opt DO UPDATE SET
        //            setlist where_opt upsert
        166 -> tv(ast.upsert_new(a, sv(s, m - 8), sv(s, m - 6), sv(s, m - 2), sv(s, m - 1), sv(s, m)))
        // upsert ::= ON CONFLICT LP sortlist RP where_opt DO NOTHING upsert
        167 -> tv(ast.upsert_new(a, sv(s, m - 5), sv(s, m - 3), -1, -1, sv(s, m)))
        // upsert ::= ON CONFLICT DO NOTHING returning
        168 -> tv(ast.upsert_new(a, -1, -1, -1, -1, -1))
        // upsert ::= ON CONFLICT DO UPDATE SET setlist where_opt returning
        169 -> tv(ast.upsert_new(a, -1, -1, sv(s, m - 2), sv(s, m - 1), -1))
        // returning ::= RETURNING selcollist
        170 -> {
            b.add_returning(a, sv(s, m))
            keep
        }
        // insert_cmd ::= INSERT orconf
        171 -> tv(sv(s, m))
        // insert_cmd ::= REPLACE
        172 -> tv(ast.OE_REPLACE)
        // idlist_opt ::=
        173 -> tv(-1)
        // idlist_opt ::= LP idlist RP
        174 -> tv(sv(s, m - 1))
        // idlist ::= idlist COMMA nm
        175 -> {
            nm: opt(a, st(s, m))
            tv(ast.id_list_append(a, sv(s, m - 2), nm))
        }
        // idlist ::= nm
        176 -> {
            nm: opt(a, st(s, m))
            tv(ast.id_list_append(a, -1, nm))
        }
        // expr ::= LP expr RP
        177 -> tv(sv(s, m - 1))
        else -> keep
    }
}

// seltablist ::= stl_prefix LP seltablist RP as on_using (rule 113): a
// parenthesized FROM list. One table moves up into the outer list; more
// become a nested-FROM subquery.
nested_from_term: fn(a: &ast.AST, s: [SQLStackEntry], m: Int) -> ast.SQLTok Never! {
    prefix: sv(s, m - 5)
    inner: sv(s, m - 3)
    alias_tok: st(s, m - 1)
    ou: st(s, m)
    if prefix < 0 && alias_tok.n == 0 && ou.z < 0 && ou.n < 0 -> return tv(inner)
    alias: ast.tok_bytes(a, alias_tok)
    if inner >= 0 && ast.src_len(a, inner) == 1 {
        l: ast.src_list_append_from_term(a, prefix, None, None, alias, -1, ou.z, ou.n)
        if l >= 0 {
            nw: ast.src_item(a, l, ast.src_len(a, l) - 1)
            old: ast.src_item(a, inner, 0)
            a.items[nw].name = a.items[old].name
            a.items[nw].database = a.items[old].database
            a.items[nw].select = a.items[old].select
            sub: a.items[nw].select
            if sub >= 0 && a.selects[sub].sel_flags.bit_and(ast.SF_NESTED_FROM) != 0 -> a.items[nw].is_nested_from = true
            if a.items[old].is_tab_func {
                a.items[nw].func_arg = a.items[old].func_arg
                a.items[old].func_arg = -1
                a.items[old].is_tab_func = false
                a.items[nw].is_tab_func = true
            }
            a.items[old].name = None
            a.items[old].database = None
            a.items[old].select = -1
        }
        ast.src_list_delete(a, inner)
        return tv(l)
    }
    ast.src_list_shift_join_type(a, inner)
    sub: ast.select_new(a, -1, inner, -1, -1, -1, -1, ast.SF_NESTED_FROM, -1)
    tv(ast.src_list_append_from_term(a, prefix, None, None, alias, sub, ou.z, ou.n))
}

// Rules 178-257: expressions, CREATE INDEX, DROP INDEX, VACUUM, PRAGMA.
actions_expr: fn<B: SQLBuilder>(b: &B, a: &ast.AST, s: [SQLStackEntry], m: Int, rule: Int, keep: ast.SQLTok) -> ast.SQLTok Never! {
    if rule == {
        // expr ::= ID|INDEXED|JOIN_KW
        178 -> tv(token_expr(a, tk.TK_ID, st(s, m)))
        // expr ::= nm DOT nm
        179 -> {
            t1: token_expr(a, tk.TK_ID, st(s, m - 2))
            t2: token_expr(a, tk.TK_ID, st(s, m))
            tv(ast.pexpr(a, tk.TK_DOT, t1, t2))
        }
        // expr ::= nm DOT nm DOT nm
        180 -> {
            t1: token_expr(a, tk.TK_ID, st(s, m - 4))
            t2: token_expr(a, tk.TK_ID, st(s, m - 2))
            t3: token_expr(a, tk.TK_ID, st(s, m))
            t4: ast.pexpr(a, tk.TK_DOT, t2, t3)
            tv(ast.pexpr(a, tk.TK_DOT, t1, t4))
        }
        // term ::= NULL|FLOAT|BLOB, term ::= STRING
        181 | 182 -> tv(token_expr(a, sm(s, m), st(s, m)))
        // term ::= INTEGER
        183 -> {
            t: st(s, m)
            z: ast.tok_bytes(a, t)
            e: ast.expr_alloc(a, tk.TK_INTEGER, Val(z), true)
            if e >= 0 -> a.exprs[e].w = t.z
            tv(e)
        }
        // expr ::= VARIABLE
        184 -> {
            t: st(s, m)
            if !(sql_byte(a.ctx.sql, t.z) == 35 && is_digit(sql_byte(a.ctx.sql, t.z + 1))) {
                e: token_expr(a, tk.TK_VARIABLE, t)
                ast.expr_assign_var_number(a, e, t.n)
                return tv(e)
            }
            if a.ctx.nested == 0 {
                txt: ast.tok_text(a, t)
                off: ast.tok_offset(a, t)
                ast.error_at(a, "near \"{txt}\": syntax error", off)
                return tv(-1)
            }
            e: ast.pexpr(a, tk.TK_REGISTER, -1, -1)
            z: ast.tok_bytes(a, t)
            if e >= 0 && get_int32(z[1..<z.len()].copy()) == .Val(v) -> a.exprs[e].itable = v
            tv(e)
        }
        // expr ::= expr COLLATE ID|STRING
        185 -> {
            nb: ast.tok_bytes(a, st(s, m))
            tv(ast.expr_add_collate_token(a, sv(s, m - 2), nb, true))
        }
        // expr ::= CAST LP expr AS typetoken RP
        186 -> {
            z: ast.tok_bytes(a, st(s, m - 1))
            e: ast.expr_alloc(a, tk.TK_CAST, Val(z), true)
            ast.attach_subtrees(a, e, sv(s, m - 3), -1)
            tv(e)
        }
        // expr ::= ID|INDEXED|JOIN_KW LP distinct exprlist RP
        187 -> tv(ast.expr_function(a, sv(s, m - 1), st(s, m - 4), sv(s, m - 2)))
        // expr ::= ID|INDEXED|JOIN_KW LP distinct exprlist ORDER BY sortlist RP
        188 -> {
            f: ast.expr_function(a, sv(s, m - 4), st(s, m - 7), sv(s, m - 5))
            ast.expr_add_function_order_by(a, f, sv(s, m - 1))
            tv(f)
        }
        // expr ::= ID|INDEXED|JOIN_KW LP STAR RP
        189 -> tv(ast.expr_function(a, -1, st(s, m - 3), 0))
        // expr ::= ID|INDEXED|JOIN_KW LP distinct exprlist RP filter_over
        190 -> {
            f: ast.expr_function(a, sv(s, m - 2), st(s, m - 5), sv(s, m - 3))
            ast.window_attach(a, f, sv(s, m))
            tv(f)
        }
        // expr ::= ID|INDEXED|JOIN_KW LP distinct exprlist ORDER BY sortlist RP
        //          filter_over
        191 -> {
            f: ast.expr_function(a, sv(s, m - 5), st(s, m - 8), sv(s, m - 6))
            ast.window_attach(a, f, sv(s, m))
            ast.expr_add_function_order_by(a, f, sv(s, m - 2))
            tv(f)
        }
        // expr ::= ID|INDEXED|JOIN_KW LP STAR RP filter_over
        192 -> {
            f: ast.expr_function(a, -1, st(s, m - 4), 0)
            ast.window_attach(a, f, sv(s, m))
            tv(f)
        }
        // term ::= CTIME_KW
        193 -> tv(ast.expr_function(a, -1, st(s, m), 0))
        // expr ::= LP nexprlist COMMA expr RP
        194 -> {
            l: ast.expr_list_append(a, sv(s, m - 3), sv(s, m - 1))
            e: ast.pexpr(a, tk.TK_VECTOR, -1, -1)
            if e < 0 {
                ast.expr_list_delete(a, l)
                return tv(e)
            }
            a.exprs[e].x = l
            if ast.list_len(a, l) > 0 {
                first: ast.list_expr(a, l, 0)
                ff: a.exprs[first].flags
                ast.set_flags(a, e, ff.bit_and(ast.EP_PROPAGATE))
            }
            tv(e)
        }
        // expr ::= expr AND expr
        195 -> tv(ast.expr_and(a, sv(s, m - 2), sv(s, m)))
        // expr ::= expr OR|LT|GT|GE|LE|EQ|NE|BITAND|BITOR|LSHIFT|RSHIFT|PLUS|
        //          MINUS|STAR|SLASH|REM|CONCAT expr
        196 | 197 | 198 | 199 | 200 | 201 | 202 -> tv(ast.pexpr(a, sm(s, m - 1), sv(s, m - 2), sv(s, m)))
        // likeop ::= NOT LIKE_KW|MATCH
        203 -> {
            t: st(s, m)
            ast.SQLTok{z: t.z, n: t.n.bit_or(LIKE_NOT_BIT)}
        }
        // expr ::= expr likeop expr
        204 -> {
            op: st(s, m - 1)
            not: op.n.bit_and(LIKE_NOT_BIT) != 0
            name: ast.SQLTok{z: op.z, n: util.clear_bits(op.n, LIKE_NOT_BIT)}
            l1: ast.expr_list_append(a, -1, sv(s, m))
            l: ast.expr_list_append(a, l1, sv(s, m - 2))
            e := ast.expr_function(a, l, name, 0)
            if not -> e = ast.pexpr(a, tk.TK_NOT, e, -1)
            if e >= 0 -> ast.set_flags(a, e, ast.EP_INFIX_FUNC)
            tv(e)
        }
        // expr ::= expr likeop expr ESCAPE expr
        205 -> {
            op: st(s, m - 3)
            not: op.n.bit_and(LIKE_NOT_BIT) != 0
            name: ast.SQLTok{z: op.z, n: util.clear_bits(op.n, LIKE_NOT_BIT)}
            l1: ast.expr_list_append(a, -1, sv(s, m - 2))
            l2: ast.expr_list_append(a, l1, sv(s, m - 4))
            l: ast.expr_list_append(a, l2, sv(s, m))
            e := ast.expr_function(a, l, name, 0)
            if not -> e = ast.pexpr(a, tk.TK_NOT, e, -1)
            if e >= 0 -> ast.set_flags(a, e, ast.EP_INFIX_FUNC)
            tv(e)
        }
        // expr ::= expr ISNULL|NOTNULL
        206 -> tv(ast.pexpr(a, sm(s, m), sv(s, m - 1), -1))
        // expr ::= expr NOT NULL
        207 -> tv(ast.pexpr(a, tk.TK_NOTNULL, sv(s, m - 2), -1))
        // expr ::= expr IS expr
        208 -> {
            e: ast.pexpr(a, tk.TK_IS, sv(s, m - 2), sv(s, m))
            binary_to_unary_if_null(a, sv(s, m), e, tk.TK_ISNULL)
            tv(e)
        }
        // expr ::= expr IS NOT expr
        209 -> {
            e: ast.pexpr(a, tk.TK_ISNOT, sv(s, m - 3), sv(s, m))
            binary_to_unary_if_null(a, sv(s, m), e, tk.TK_NOTNULL)
            tv(e)
        }
        // expr ::= expr IS NOT DISTINCT FROM expr
        210 -> {
            e: ast.pexpr(a, tk.TK_IS, sv(s, m - 5), sv(s, m))
            binary_to_unary_if_null(a, sv(s, m), e, tk.TK_ISNULL)
            tv(e)
        }
        // expr ::= expr IS DISTINCT FROM expr
        211 -> {
            e: ast.pexpr(a, tk.TK_ISNOT, sv(s, m - 4), sv(s, m))
            binary_to_unary_if_null(a, sv(s, m), e, tk.TK_NOTNULL)
            tv(e)
        }
        // expr ::= NOT expr, expr ::= BITNOT expr
        212 | 213 -> tv(ast.pexpr(a, sm(s, m - 1), sv(s, m), -1))
        // expr ::= PLUS|MINUS expr
        214 -> tv(ast.pexpr(a, if sm(s, m - 1) == tk.TK_PLUS -> tk.TK_UPLUS else -> tk.TK_UMINUS, sv(s, m), -1))
        // expr ::= expr PTR expr
        215 -> {
            l1: ast.expr_list_append(a, -1, sv(s, m - 2))
            l: ast.expr_list_append(a, l1, sv(s, m))
            tv(ast.expr_function(a, l, st(s, m - 1), 0))
        }
        // between_op ::= BETWEEN, in_op ::= IN
        216 | 219 -> tv(0)
        // between_op ::= NOT BETWEEN, in_op ::= NOT IN, collate ::= COLLATE ID|STRING
        217 | 220 | 245 -> tv(1)
        // expr ::= expr between_op expr AND expr
        218 -> {
            l1: ast.expr_list_append(a, -1, sv(s, m - 2))
            l: ast.expr_list_append(a, l1, sv(s, m))
            e := ast.pexpr(a, tk.TK_BETWEEN, sv(s, m - 4), -1)
            if e >= 0 {
                a.exprs[e].x = l
            } else {
                ast.expr_list_delete(a, l)
            }
            if sv(s, m - 3) != 0 -> e = ast.pexpr(a, tk.TK_NOT, e, -1)
            tv(e)
        }
        // expr ::= expr in_op LP exprlist RP
        221 -> in_list(a, sv(s, m - 4), sv(s, m - 3), sv(s, m - 1))
        // expr ::= LP select RP
        222 -> {
            e: ast.pexpr(a, tk.TK_SELECT, -1, -1)
            ast.pexpr_add_select(a, e, sv(s, m - 1))
            tv(e)
        }
        // expr ::= expr in_op LP select RP
        223 -> {
            e := ast.pexpr(a, tk.TK_IN, sv(s, m - 4), -1)
            ast.pexpr_add_select(a, e, sv(s, m - 1))
            if sv(s, m - 3) != 0 -> e = ast.pexpr(a, tk.TK_NOT, e, -1)
            tv(e)
        }
        // expr ::= expr in_op nm dbnm paren_exprlist
        224 -> {
            tb: opt(a, st(s, m - 2))
            db: opt(a, st(s, m - 1))
            src: ast.src_list_append(a, -1, tb, db)
            sel: ast.select_new(a, -1, src, -1, -1, -1, -1, 0, -1)
            if sv(s, m) >= 0 -> ast.src_list_func_args(a, if sel >= 0 -> src else -> -1, sv(s, m))
            e := ast.pexpr(a, tk.TK_IN, sv(s, m - 4), -1)
            ast.pexpr_add_select(a, e, sel)
            if sv(s, m - 3) != 0 -> e = ast.pexpr(a, tk.TK_NOT, e, -1)
            tv(e)
        }
        // expr ::= EXISTS LP select RP
        225 -> {
            e: ast.pexpr(a, tk.TK_EXISTS, -1, -1)
            ast.pexpr_add_select(a, e, sv(s, m - 1))
            tv(e)
        }
        // expr ::= CASE case_operand case_exprlist case_else END
        226 -> {
            e: ast.pexpr(a, tk.TK_CASE, sv(s, m - 3), -1)
            if e < 0 {
                ast.expr_list_delete(a, sv(s, m - 2))
                ast.expr_delete(a, sv(s, m - 1))
                return tv(e)
            }
            x: if sv(s, m - 1) >= 0 -> ast.expr_list_append(a, sv(s, m - 2), sv(s, m - 1)) else -> sv(s, m - 2)
            a.exprs[e].x = x
            ast.set_height_and_flags(a, e)
            tv(e)
        }
        // case_exprlist ::= case_exprlist WHEN expr THEN expr
        227 -> {
            l: ast.expr_list_append(a, sv(s, m - 4), sv(s, m - 2))
            tv(ast.expr_list_append(a, l, sv(s, m)))
        }
        // case_exprlist ::= WHEN expr THEN expr
        228 -> {
            l: ast.expr_list_append(a, -1, sv(s, m - 2))
            tv(ast.expr_list_append(a, l, sv(s, m)))
        }
        // case_else ::= ELSE expr
        229 -> tv(sv(s, m))
        // case_else ::=, case_operand ::=
        230 | 231 -> tv(-1)
        // exprlist ::=, paren_exprlist ::=
        232 | 235 -> tv(-1)
        // nexprlist ::= nexprlist COMMA expr
        233 -> tv(ast.expr_list_append(a, sv(s, m - 2), sv(s, m)))
        // nexprlist ::= expr
        234 -> tv(ast.expr_list_append(a, -1, sv(s, m)))
        // paren_exprlist ::= LP exprlist RP
        236 -> tv(sv(s, m - 1))
        // cmd ::= createkw uniqueflag INDEX ifnotexists nm dbnm ON nm LP
        //         sortlist RP where_opt
        237 -> {
            tb: opt(a, st(s, m - 4))
            src: ast.src_list_append(a, -1, tb, None)
            b.create_index(a, st(s, m - 7), st(s, m - 6), src, sv(s, m - 2), sv(s, m - 10), st(s, m - 11), sv(s, m), ast.SO_ASC, sv(s, m - 8), IDXTYPE_APPDEF)
            keep
        }
        // uniqueflag ::= UNIQUE
        238 -> tv(ast.OE_ABORT)
        // uniqueflag ::=
        239 -> tv(ast.OE_NONE)
        // eidlist_opt ::=
        240 -> tv(-1)
        // eidlist_opt ::= LP eidlist RP
        241 -> tv(sv(s, m - 1))
        // eidlist ::= eidlist COMMA nm collate sortorder
        242 -> tv(add_expr_id_list_term(a, sv(s, m - 4), st(s, m - 2), sv(s, m - 1), sv(s, m)))
        // eidlist ::= nm collate sortorder
        243 -> tv(add_expr_id_list_term(a, -1, st(s, m - 2), sv(s, m - 1), sv(s, m)))
        // collate ::=
        244 -> tv(0)
        // cmd ::= DROP INDEX ifexists fullname
        246 -> {
            b.drop_index(a, sv(s, m), sv(s, m - 1))
            keep
        }
        // cmd ::= VACUUM vinto
        247 -> {
            b.vacuum(a, no_tok(), sv(s, m))
            keep
        }
        // cmd ::= VACUUM nm vinto
        248 -> {
            b.vacuum(a, st(s, m - 1), sv(s, m))
            keep
        }
        // vinto ::= INTO expr
        249 -> tv(sv(s, m))
        // vinto ::=
        250 -> tv(-1)
        // cmd ::= PRAGMA nm dbnm
        251 -> {
            b.pragma(a, st(s, m - 1), st(s, m), no_tok(), 0)
            keep
        }
        // cmd ::= PRAGMA nm dbnm EQ nmnum
        252 -> {
            b.pragma(a, st(s, m - 3), st(s, m - 2), st(s, m), 0)
            keep
        }
        // cmd ::= PRAGMA nm dbnm LP nmnum RP
        253 -> {
            b.pragma(a, st(s, m - 4), st(s, m - 3), st(s, m - 1), 0)
            keep
        }
        // cmd ::= PRAGMA nm dbnm EQ minus_num
        254 -> {
            b.pragma(a, st(s, m - 3), st(s, m - 2), st(s, m), 1)
            keep
        }
        // cmd ::= PRAGMA nm dbnm LP minus_num RP
        255 -> {
            b.pragma(a, st(s, m - 4), st(s, m - 3), st(s, m - 1), 1)
            keep
        }
        // plus_num ::= PLUS INTEGER|FLOAT, minus_num ::= MINUS INTEGER|FLOAT
        256 | 257 -> st(s, m)
        else -> keep
    }
}

// expr ::= expr in_op LP exprlist RP (rule 221). An empty list is a
// constant; one constant non-vector term becomes "=" (the unary plus keeps
// the term's affinity from being used); one subquery becomes IN (SELECT);
// a vector left side compares against a VALUES list.
in_list: fn(a: &ast.AST, lhs: Int, not: Int, list: Int) -> ast.SQLTok Never! {
    e := lhs
    if list < 0 {
        ast.expr_unmap_and_delete(a, e)
        e = ast.expr(a, tk.TK_STRING, (if not != 0 -> "true" else -> "false").bytes())
        if e >= 0 -> _ := ast.expr_id_to_true_false(a, e)
        return tv(e)
    }
    rhs := ast.list_expr(a, list, 0)
    n: ast.list_len(a, list)
    if n == 1 && ast.expr_is_constant(a, rhs) && a.exprs[e].op != tk.TK_VECTOR {
        a.lists[list].items[0].expr = -1
        ast.expr_list_delete(a, list)
        rhs = ast.pexpr(a, tk.TK_UPLUS, rhs, -1)
        e = ast.pexpr(a, tk.TK_EQ, e, rhs)
    } else if n == 1 && a.exprs[rhs].op == tk.TK_SELECT {
        e = ast.pexpr(a, tk.TK_IN, e, -1)
        ast.pexpr_add_select(a, e, a.exprs[rhs].x)
        a.exprs[rhs].x = -1
        ast.expr_list_delete(a, list)
    } else {
        e = ast.pexpr(a, tk.TK_IN, e, -1)
        if e < 0 {
            ast.expr_list_delete(a, list)
        } else if a.exprs[a.exprs[e].left].op == tk.TK_VECTOR {
            nexpr: ast.list_len(a, a.exprs[a.exprs[e].left].x)
            sel: ast.expr_list_to_values(a, nexpr, list)
            if sel >= 0 {
                double_link_select(a, sel)
                ast.pexpr_add_select(a, e, sel)
            }
        } else {
            a.exprs[e].x = list
            ast.set_height_and_flags(a, e)
        }
    }
    if not != 0 -> e = ast.pexpr(a, tk.TK_NOT, e, -1)
    tv(e)
}

// Rules 258-339: triggers, RAISE, ATTACH, REINDEX, ANALYZE, ALTER, virtual
// tables, WITH, windows.
actions_trigger: fn<B: SQLBuilder>(b: &B, a: &ast.AST, s: [SQLStackEntry], m: Int, rule: Int, keep: ast.SQLTok) -> ast.SQLTok Never! {
    if rule == {
        // cmd ::= createkw trigger_decl BEGIN trigger_cmd_list END
        258 -> {
            d: st(s, m - 3)
            e: st(s, m)
            b.finish_trigger(a, sv(s, m - 1), ast.SQLTok{z: d.z, n: e.z - d.z + e.n})
            keep
        }
        // trigger_decl ::= temp TRIGGER ifnotexists nm dbnm trigger_time
        //                  trigger_event ON fullname foreach_clause when_clause
        259 -> {
            ev: st(s, m - 4)
            b.begin_trigger(a, st(s, m - 7), st(s, m - 6), sv(s, m - 5), ev.z, ev.n, sv(s, m - 2), sv(s, m), sv(s, m - 10), sv(s, m - 8))
            if st(s, m - 6).n == 0 -> return st(s, m - 7)
            st(s, m - 6)
        }
        // trigger_time ::= BEFORE|AFTER
        260 -> tv(sm(s, m))
        // trigger_time ::= INSTEAD OF
        261 -> tv(tk.TK_INSTEAD)
        // trigger_time ::=
        262 -> tv(tk.TK_BEFORE)
        // trigger_event ::= DELETE|INSERT, trigger_event ::= UPDATE
        263 | 264 -> ast.SQLTok{z: sm(s, m), n: -1}
        // trigger_event ::= UPDATE OF idlist
        265 -> ast.SQLTok{z: tk.TK_UPDATE, n: sv(s, m)}
        // when_clause ::=, key_opt ::=
        266 | 285 -> tv(-1)
        // when_clause ::= WHEN expr, key_opt ::= KEY expr
        267 | 286 -> tv(sv(s, m))
        // trigger_cmd_list ::= trigger_cmd_list trigger_cmd SEMI
        268 -> {
            head: sv(s, m - 2)
            step: sv(s, m - 1)
            if head >= 0 {
                last: a.steps[head].last_step
                if last >= 0 -> a.steps[last].next_step = step
                a.steps[head].last_step = step
            }
            keep
        }
        // trigger_cmd_list ::= trigger_cmd SEMI
        269 -> {
            step: sv(s, m - 1)
            if step >= 0 -> a.steps[step].last_step = step
            keep
        }
        // trnm ::= nm DOT nm
        270 -> {
            ast.error(a, "qualified table names are not allowed on INSERT, UPDATE, and DELETE statements within triggers")
            st(s, m)
        }
        // tridxby ::= INDEXED BY nm
        271 -> {
            ast.error(a, "the INDEXED BY clause is not allowed on UPDATE or DELETE statements within triggers")
            keep
        }
        // tridxby ::= NOT INDEXED
        272 -> {
            ast.error(a, "the NOT INDEXED clause is not allowed on UPDATE or DELETE statements within triggers")
            keep
        }
        // trigger_cmd ::= UPDATE orconf trnm tridxby SET setlist from
        //                 where_opt scanpt
        273 -> {
            nb: ast.tok_bytes(a, st(s, m - 6))
            tv(ast.trigger_update_step(a, nb, sv(s, m - 2), sv(s, m - 3), sv(s, m - 1), sv(s, m - 7), st(s, m - 8).z, sv(s, m)))
        }
        // trigger_cmd ::= scanpt insert_cmd INTO trnm idlist_opt select upsert
        //                 scanpt
        274 -> {
            nb: ast.tok_bytes(a, st(s, m - 4))
            tv(ast.trigger_insert_step(a, nb, sv(s, m - 3), sv(s, m - 2), sv(s, m - 6), sv(s, m - 1), sv(s, m - 7), sv(s, m)))
        }
        // trigger_cmd ::= DELETE FROM trnm tridxby where_opt scanpt
        275 -> {
            nb: ast.tok_bytes(a, st(s, m - 3))
            tv(ast.trigger_delete_step(a, nb, sv(s, m - 1), st(s, m - 5).z, sv(s, m)))
        }
        // trigger_cmd ::= scanpt select scanpt
        276 -> tv(ast.trigger_select_step(a, sv(s, m - 1), sv(s, m - 2), sv(s, m)))
        // expr ::= RAISE LP IGNORE RP
        277 -> {
            e: ast.pexpr(a, tk.TK_RAISE, -1, -1)
            if e >= 0 -> a.exprs[e].aff = ast.OE_IGNORE
            tv(e)
        }
        // expr ::= RAISE LP raisetype COMMA nm RP
        278 -> {
            z: ast.tok_bytes(a, st(s, m - 1))
            e: ast.expr_alloc(a, tk.TK_RAISE, Val(z), true)
            if e >= 0 -> a.exprs[e].aff = sv(s, m - 3)
            tv(e)
        }
        // raisetype ::= ROLLBACK
        279 -> tv(ast.OE_ROLLBACK)
        // raisetype ::= ABORT
        280 -> tv(ast.OE_ABORT)
        // raisetype ::= FAIL
        281 -> tv(ast.OE_FAIL)
        // cmd ::= DROP TRIGGER ifexists fullname
        282 -> {
            b.drop_trigger(a, sv(s, m), sv(s, m - 1))
            keep
        }
        // cmd ::= ATTACH database_kw_opt expr AS expr key_opt
        283 -> {
            b.attach(a, sv(s, m - 3), sv(s, m - 1), sv(s, m))
            keep
        }
        // cmd ::= DETACH database_kw_opt expr
        284 -> {
            b.detach(a, sv(s, m))
            keep
        }
        // cmd ::= REINDEX
        287 -> {
            b.reindex(a, no_tok(), no_tok())
            keep
        }
        // cmd ::= REINDEX nm dbnm
        288 -> {
            b.reindex(a, st(s, m - 1), st(s, m))
            keep
        }
        // cmd ::= ANALYZE
        289 -> {
            b.analyze(a, no_tok(), no_tok())
            keep
        }
        // cmd ::= ANALYZE nm dbnm
        290 -> {
            b.analyze(a, st(s, m - 1), st(s, m))
            keep
        }
        // cmd ::= ALTER TABLE fullname RENAME TO nm
        291 -> {
            b.alter_rename_table(a, sv(s, m - 3), st(s, m))
            keep
        }
        // cmd ::= ALTER TABLE add_column_fullname ADD kwcolumn_opt columnname
        //         carglist
        292 -> {
            t: st(s, m - 1)
            last: a.ctx.last_token
            b.alter_finish_add_column(a, ast.SQLTok{z: t.z, n: last.z - t.z + last.n})
            keep
        }
        // cmd ::= ALTER TABLE fullname DROP kwcolumn_opt nm
        293 -> {
            b.alter_drop_column(a, sv(s, m - 3), st(s, m))
            keep
        }
        // add_column_fullname ::= fullname
        294 -> {
            b.alter_begin_add_column(a, sv(s, m))
            keep
        }
        // cmd ::= ALTER TABLE fullname RENAME kwcolumn_opt nm TO nm
        295 -> {
            b.alter_rename_column(a, sv(s, m - 5), st(s, m - 2), st(s, m))
            keep
        }
        // cmd ::= create_vtab
        296 -> {
            b.vtab_finish_parse(a, no_tok())
            keep
        }
        // cmd ::= create_vtab LP vtabarglist RP
        297 -> {
            b.vtab_finish_parse(a, st(s, m))
            keep
        }
        // create_vtab ::= createkw VIRTUAL TABLE ifnotexists nm dbnm USING nm
        298 -> {
            b.vtab_begin_parse(a, st(s, m - 3), st(s, m - 2), st(s, m), sv(s, m - 4))
            keep
        }
        // vtabarg ::=
        299 -> {
            b.vtab_arg_init(a)
            keep
        }
        // vtabargtoken ::= ANY, vtabargtoken ::= lp anylist RP, lp ::= LP
        300 | 301 | 302 -> {
            b.vtab_arg_extend(a, st(s, m))
            keep
        }
        // with ::= WITH wqlist, with ::= WITH RECURSIVE wqlist
        303 | 304 -> {
            ast.with_push(a, sv(s, m))
            keep
        }
        // wqas ::= AS
        305 -> tv(ast.M10D_ANY)
        // wqas ::= AS MATERIALIZED
        306 -> tv(ast.M10D_YES)
        // wqas ::= AS NOT MATERIALIZED
        307 -> tv(ast.M10D_NO)
        // wqitem ::= nm eidlist_opt wqas LP select RP
        308 -> {
            nm: opt(a, st(s, m - 5))
            tv(ast.cte_new(a, nm, sv(s, m - 4), sv(s, m - 1), sv(s, m - 3)))
        }
        // wqlist ::= wqitem
        309 -> tv(ast.with_add(a, -1, sv(s, m)))
        // wqlist ::= wqlist COMMA wqitem
        310 -> tv(ast.with_add(a, sv(s, m - 2), sv(s, m)))
        // windowdefn_list ::= windowdefn_list COMMA windowdefn
        311 -> {
            w: sv(s, m)
            ast.window_chain(a, w, sv(s, m - 2))
            a.windows[w].next_win = sv(s, m - 2)
            tv(w)
        }
        // windowdefn ::= nm AS LP window RP
        312 -> {
            w: sv(s, m - 1)
            if w >= 0 {
                nb: ast.tok_bytes(a, st(s, m - 4))
                a.windows[w].name = Val(nb)
            }
            tv(w)
        }
        // window ::= PARTITION BY nexprlist orderby_opt frame_opt
        313 -> tv(ast.window_assemble(a, sv(s, m), sv(s, m - 2), sv(s, m - 1), None))
        // window ::= nm PARTITION BY nexprlist orderby_opt frame_opt
        314 -> {
            base_name: ast.tok_bytes(a, st(s, m - 5))
            tv(ast.window_assemble(a, sv(s, m), sv(s, m - 2), sv(s, m - 1), Val(base_name)))
        }
        // window ::= ORDER BY sortlist frame_opt
        315 -> tv(ast.window_assemble(a, sv(s, m), -1, sv(s, m - 1), None))
        // window ::= nm ORDER BY sortlist frame_opt
        316 -> {
            base_name: ast.tok_bytes(a, st(s, m - 4))
            tv(ast.window_assemble(a, sv(s, m), -1, sv(s, m - 1), Val(base_name)))
        }
        // window ::= nm frame_opt
        317 -> {
            base_name: ast.tok_bytes(a, st(s, m - 1))
            tv(ast.window_assemble(a, sv(s, m), -1, -1, Val(base_name)))
        }
        // frame_opt ::=
        318 -> tv(ast.window_alloc(a, 0, tk.TK_UNBOUNDED, -1, tk.TK_CURRENT, -1, 0))
        // frame_opt ::= range_or_rows frame_bound_s frame_exclude_opt
        319 -> {
            fb: st(s, m - 1)
            tv(ast.window_alloc(a, sv(s, m - 2), fb.z, fb.n, tk.TK_CURRENT, -1, sv(s, m)))
        }
        // frame_opt ::= range_or_rows BETWEEN frame_bound_s AND frame_bound_e
        //               frame_exclude_opt
        320 -> {
            fs: st(s, m - 3)
            fe: st(s, m - 1)
            tv(ast.window_alloc(a, sv(s, m - 5), fs.z, fs.n, fe.z, fe.n, sv(s, m)))
        }
        // range_or_rows ::= RANGE|ROWS|GROUPS
        321 -> tv(sm(s, m))
        // frame_bound_s ::= frame_bound, frame_bound_e ::= frame_bound
        322 | 324 -> keep
        // frame_bound_s ::= UNBOUNDED PRECEDING, frame_bound_e ::= UNBOUNDED
        // FOLLOWING, frame_bound ::= CURRENT ROW
        323 | 325 | 327 -> ast.SQLTok{z: sm(s, m - 1), n: -1}
        // frame_bound ::= expr PRECEDING|FOLLOWING
        326 -> ast.SQLTok{z: sm(s, m), n: sv(s, m - 1)}
        // frame_exclude_opt ::=
        328 -> tv(0)
        // frame_exclude_opt ::= EXCLUDE frame_exclude
        329 -> tv(sv(s, m))
        // frame_exclude ::= NO OTHERS, frame_exclude ::= CURRENT ROW
        330 | 331 -> tv(sm(s, m - 1))
        // frame_exclude ::= GROUP|TIES
        332 -> tv(sm(s, m))
        // window_clause ::= WINDOW windowdefn_list
        333 -> tv(sv(s, m))
        // filter_over ::= filter_clause over_clause
        334 -> {
            w: sv(s, m)
            if w >= 0 {
                a.windows[w].filter = sv(s, m - 1)
            } else {
                ast.expr_delete(a, sv(s, m - 1))
            }
            tv(w)
        }
        // filter_over ::= over_clause
        335 -> keep
        // filter_over ::= filter_clause
        336 -> {
            w := ast.new_window()
            w.frm_type = tk.TK_FILTER
            w.filter = sv(s, m)
            a.windows.push(w)
            tv(a.windows.len() - 1)
        }
        // over_clause ::= OVER LP window RP
        337 -> tv(sv(s, m - 1))
        // over_clause ::= OVER nm
        338 -> {
            w := ast.new_window()
            w.name = Val(ast.tok_bytes(a, st(s, m)))
            a.windows.push(w)
            tv(a.windows.len() - 1)
        }
        // filter_clause ::= FILTER LP WHERE expr RP
        339 -> tv(sv(s, m - 1))
        else -> keep
    }
}

// ---------------------------------------------------------------------------
// sqlite3RunParser (tokenize.c): parse the statement text of `a.ctx`,
// calling `b` for each command. Returns the number of errors (0 or 1),
// with the message in a.ctx.errmsg and where parsing stopped in a.ctx.tail.
// Freeing Parse.pNewTable and Parse.pNewTrigger after a failed parse is the
// builder's, which owns them.
run_parser: fn<B: SQLBuilder>(b: &B, a: &ast.AST) -> Int Never! {
    mx := a.limits[ast.LIMIT_SQL_LENGTH]
    a.ctx.rc = base.OK
    p := new_parser()
    pos := 0
    last := -1
    loop {
        t: tk.get_token(a.ctx.sql, pos)
        n := t.len
        kind := t.kind
        mx -= n
        if mx < 0 {
            a.ctx.rc = base.TOOBIG
            a.ctx.nerr += 1
            break
        }
        if kind >= tk.TK_WINDOW {
            if kind == tk.TK_SPACE {
                pos += n
                next
            }
            if sql_byte(a.ctx.sql, pos) == 0 {
                if last == tk.TK_SEMI {
                    kind = 0
                } else if last == 0 {
                    break
                } else {
                    kind = tk.TK_SEMI
                }
                n = 0
            } else if kind == tk.TK_WINDOW || kind == tk.TK_OVER || kind == tk.TK_FILTER {
                kind = tk.window_keyword(a.ctx.sql, kind, pos + n, last)
            } else {
                x: ast.SQLTok{z: pos, n: n}
                txt: ast.tok_text(a, x)
                off: ast.tok_offset(a, x)
                ast.error_at(a, "unrecognized token: \"{txt}\"", off)
                break
            }
        }
        a.ctx.last_token = ast.SQLTok{z: pos, n: n}
        parse_token<B>(p, b, a, kind, ast.SQLTok{z: pos, n: n})
        last = kind
        pos += n
        if a.ctx.rc != base.OK -> break
    }
    errs := 0
    if a.ctx.errmsg != None || (a.ctx.rc != base.OK && a.ctx.rc != base.DONE) {
        if a.ctx.errmsg == None -> a.ctx.errmsg = Val(base.error_string(a.ctx.rc))
        errs = 1
    }
    a.ctx.tail = pos
    errs
}

// ---------------------------------------------------------------------------
// Tests: a builder that records the calls the grammar makes.

SQLRecorder: struct {
    log: [String]
    sel: Int
}

impl SQLRecorder.SQLBuilder {
    finish_coding: fn(&self, a: &ast.AST) Never! { self.log.push("finish") }
    begin_transaction: fn(&self, a: &ast.AST, kind: Int) Never! { self.log.push("begin {kind}") }
    end_transaction: fn(&self, a: &ast.AST, op: Int) Never! { self.log.push("end {op}") }
    savepoint: fn(&self, a: &ast.AST, op: Int, name: ast.SQLTok) Never! {
        t: ast.tok_text(a, name)
        self.log.push("savepoint {op} {t}")
    }
    start_table: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok, is_temp: Int, is_view: Int, is_virtual: Int, no_err: Int) Never! {
        t1: ast.tok_text(a, name1)
        t2: ast.tok_text(a, name2)
        self.log.push("start_table {t1}|{t2} temp={is_temp} view={is_view} virtual={is_virtual} noerr={no_err}")
    }
    end_table: fn(&self, a: &ast.AST, cons: ast.SQLTok, end: ast.SQLTok, tab_opts: Int, select: Int) Never! {
        t: ast.tok_text(a, end)
        self.log.push("end_table {t} opts={tab_opts} select={select}")
    }
    add_column: fn(&self, a: &ast.AST, name: ast.SQLTok, typ: ast.SQLTok) Never! {
        t1: ast.tok_text(a, name)
        t2: ast.tok_text(a, typ)
        self.log.push("column {t1} {t2}")
    }
    add_default_value: fn(&self, a: &ast.AST, e: Int, start: Int, end: Int) Never! {
        t: ast.text(a.ctx.sql[start..<end].copy())
        self.log.push("default {t}")
    }
    add_not_null: fn(&self, a: &ast.AST, on_error: Int) Never! { self.log.push("not_null {on_error}") }
    add_primary_key: fn(&self, a: &ast.AST, list: Int, on_error: Int, autoinc: Int, sort_order: Int) Never! {
        self.log.push("primary_key list={list} onerr={on_error} autoinc={autoinc} order={sort_order}")
    }
    create_index: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok, tbl: Int, list: Int, on_error: Int, start: ast.SQLTok, where_expr: Int, sort_order: Int, if_not_exist: Int, idx_type: Int) Never! {
        t: ast.tok_text(a, name1)
        n: ast.list_len(a, list)
        self.log.push("create_index {t} cols={n} onerr={on_error} type={idx_type}")
    }
    add_check_constraint: fn(&self, a: &ast.AST, e: Int, start: Int, end: Int) Never! {
        t: ast.text(a.ctx.sql[start..<end].copy())
        self.log.push("check {t}")
    }
    create_foreign_key: fn(&self, a: &ast.AST, from_cols: Int, to: ast.SQLTok, to_cols: Int, flags: Int) Never! {
        t: ast.tok_text(a, to)
        self.log.push("foreign_key {t} flags={flags}")
    }
    defer_foreign_key: fn(&self, a: &ast.AST, deferred: Int) Never! { self.log.push("defer {deferred}") }
    add_collate_type: fn(&self, a: &ast.AST, name: ast.SQLTok) Never! {
        t: ast.tok_text(a, name)
        self.log.push("collate {t}")
    }
    add_generated: fn(&self, a: &ast.AST, e: Int, typ: ast.SQLTok) Never! {
        t: ast.tok_text(a, typ)
        self.log.push("generated {t}")
    }
    drop_table: fn(&self, a: &ast.AST, name: Int, is_view: Int, no_err: Int) Never! { self.log.push("drop_table view={is_view} noerr={no_err}") }
    create_view: fn(&self, a: &ast.AST, begin: ast.SQLTok, name1: ast.SQLTok, name2: ast.SQLTok, cols: Int, select: Int, is_temp: Int, no_err: Int) Never! {
        t: ast.tok_text(a, name1)
        self.log.push("create_view {t}")
    }
    select_output: fn(&self, a: &ast.AST, select: Int) Never! {
        self.sel = select
        self.log.push("select")
    }
    delete_from: fn(&self, a: &ast.AST, src: Int, where_expr: Int, order_by: Int, limit: Int) Never! { self.log.push("delete") }
    add_returning: fn(&self, a: &ast.AST, list: Int) Never! {
        n: ast.list_len(a, list)
        self.log.push("returning {n}")
    }
    update: fn(&self, a: &ast.AST, src: Int, changes: Int, where_expr: Int, on_error: Int, order_by: Int, limit: Int, upsert: Int) Never! {
        n: ast.src_len(a, src)
        self.log.push("update src={n} onerr={on_error}")
    }
    insert: fn(&self, a: &ast.AST, src: Int, select: Int, cols: Int, on_error: Int, upsert: Int) Never! {
        up: upsert >= 0
        self.log.push("insert onerr={on_error} upsert={up}")
    }
    drop_index: fn(&self, a: &ast.AST, name: Int, if_exists: Int) Never! { self.log.push("drop_index {if_exists}") }
    vacuum: fn(&self, a: &ast.AST, name: ast.SQLTok, into: Int) Never! { self.log.push("vacuum") }
    pragma: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok, value: ast.SQLTok, minus: Int) Never! {
        t1: ast.tok_text(a, name1)
        t2: ast.tok_text(a, name2)
        v: ast.tok_text(a, value)
        self.log.push("pragma {t1}|{t2}={v} minus={minus}")
    }
    begin_trigger: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok, tr_tm: Int, op: Int, columns: Int, table: Int, when: Int, is_temp: Int, no_err: Int) Never! {
        t: ast.tok_text(a, name1)
        self.log.push("begin_trigger {t} time={tr_tm} op={op}")
    }
    finish_trigger: fn(&self, a: &ast.AST, steps: Int, all: ast.SQLTok) Never! {
        t: ast.tok_text(a, all)
        n := 0
        st := steps
        loop st >= 0 {
            n += 1
            st = a.steps[st].next_step
        }
        self.log.push("finish_trigger steps={n} {t}")
    }
    drop_trigger: fn(&self, a: &ast.AST, name: Int, no_err: Int) Never! { self.log.push("drop_trigger") }
    attach: fn(&self, a: &ast.AST, filename: Int, dbname: Int, key: Int) Never! { self.log.push("attach") }
    detach: fn(&self, a: &ast.AST, dbname: Int) Never! { self.log.push("detach") }
    reindex: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok) Never! { self.log.push("reindex") }
    analyze: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok) Never! { self.log.push("analyze") }
    alter_rename_table: fn(&self, a: &ast.AST, src: Int, name: ast.SQLTok) Never! { self.log.push("rename_table") }
    alter_begin_add_column: fn(&self, a: &ast.AST, src: Int) Never! { self.log.push("begin_add_column") }
    alter_finish_add_column: fn(&self, a: &ast.AST, col_def: ast.SQLTok) Never! {
        t: ast.tok_text(a, col_def)
        self.log.push("finish_add_column {t}")
    }
    alter_drop_column: fn(&self, a: &ast.AST, src: Int, name: ast.SQLTok) Never! { self.log.push("drop_column") }
    alter_rename_column: fn(&self, a: &ast.AST, src: Int, old_name: ast.SQLTok, new_name: ast.SQLTok) Never! { self.log.push("rename_column") }
    vtab_begin_parse: fn(&self, a: &ast.AST, name1: ast.SQLTok, name2: ast.SQLTok, module_name: ast.SQLTok, if_not_exists: Int) Never! {
        t: ast.tok_text(a, module_name)
        self.log.push("vtab_begin {t}")
    }
    vtab_finish_parse: fn(&self, a: &ast.AST, end: ast.SQLTok) Never! { self.log.push("vtab_finish") }
    vtab_arg_init: fn(&self, a: &ast.AST) Never! { self.log.push("vtab_arg") }
    vtab_arg_extend: fn(&self, a: &ast.AST, t: ast.SQLTok) Never! {
        x: ast.tok_text(a, t)
        self.log.push("vtab_extend {x}")
    }
}

new_recorder: fn() -> SQLRecorder Never! { SQLRecorder{log: [String]{}, sel: -1} }

// Parse `sql` into a fresh arena with the recorder.
parse_with: fn(a: &ast.AST, r: &SQLRecorder, sql: String) -> Int Never! {
    ast.begin_statement(a, sql.bytes())
    run_parser<SQLRecorder>(r, a)
}

#Test("a SELECT parses into one statement") {
    a := ast.new_ast()
    r := new_recorder()
    assert(parse_with(a, r, "SELECT a, b + 1 AS c FROM t WHERE x > 2 ORDER BY a DESC LIMIT 3") == 0)
    assert(r.log == [String]{"select", "finish"})
    sel: r.sel
    assert(ast.list_len(a, a.selects[sel].elist) == 2)
    assert(a.lists[a.selects[sel].elist].items[1].ename == Val("c".bytes()))
    assert(a.exprs[a.selects[sel].where_expr].op == tk.TK_GT)
    assert(a.lists[a.selects[sel].order_by].items[0].sort_flags == ast.SO_DESC)
    assert(a.exprs[a.selects[sel].limit].op == tk.TK_LIMIT)
    assert(a.ctx.tail == a.ctx.sql.len())
}

#Test("syntax errors report the token") {
    a := ast.new_ast()
    r := new_recorder()
    assert(parse_with(a, r, "SELEC 1") == 1)
    assert(a.ctx.errmsg == Val("near \"SELEC\": syntax error"))
    assert(a.err_offset == 0)
    assert(parse_with(a, r, "SELECT 1 +") == 1)
    assert(a.ctx.errmsg == Val("incomplete input"))
    assert(parse_with(a, r, "SELECT 'abc") == 1)
    assert(a.ctx.errmsg == Val("unrecognized token: \"'abc\""))
    assert(a.err_offset == 7)
}

#Test("CREATE TABLE drives the table builder") {
    a := ast.new_ast()
    r := new_recorder()
    assert(parse_with(a, r, "CREATE TABLE IF NOT EXISTS t(a INTEGER PRIMARY KEY DESC, b VARCHAR(10) NOT NULL DEFAULT 'x', c CHECK(c > 0), UNIQUE(b)) WITHOUT ROWID, STRICT") == 0)
    opts: TF_WITHOUT_ROWID.bit_or(TF_NO_VISIBLE_ROWID).bit_or(TF_STRICT)
    dflt: ast.OE_DEFAULT
    assert(r.log == [String]{"start_table t| temp=0 view=0 virtual=0 noerr=1", "column a INTEGER", "primary_key list=-1 onerr={dflt} autoinc=0 order=1", "column b VARCHAR(10)", "not_null {dflt}", "default 'x'", "column c ", "check (c > 0", "create_index  cols=1 onerr={dflt} type=1", "end_table ) opts={opts} select=-1", "finish"})
    assert(parse_with(a, r, "CREATE TABLE t(a) WITHOUT oid") == 1)
    assert(a.ctx.errmsg == Val("unknown table option: oid"))
}

#Test("compound selects link and VALUES rows stay one compound") {
    a := ast.new_ast()
    r := new_recorder()
    assert(parse_with(a, r, "SELECT 1 UNION SELECT 2 ORDER BY 1") == 0)
    s2: r.sel
    s1: a.selects[s2].prior
    assert(a.selects[s2].op == tk.TK_UNION)
    assert(a.selects[s1].next_sel == s2)
    assert(a.ctx.has_compound)
    assert(parse_with(a, r, "SELECT 1 ORDER BY 1 UNION SELECT 2") == 1)
    assert(a.ctx.errmsg == Val("ORDER BY clause should come after UNION not before"))
    assert(parse_with(a, r, "VALUES (1), (2), (3)") == 0)
    v: r.sel
    assert(a.selects[v].op == tk.TK_ALL)
    assert(a.selects[v].sel_flags.bit_and(ast.SF_MULTI_VALUE) != 0)
    assert(a.selects[a.selects[v].prior].sel_flags.bit_and(ast.SF_MULTI_VALUE) == 0)
}

#Test("IN lists simplify as parse.y does") {
    a := ast.new_ast()
    r := new_recorder()
    assert(parse_with(a, r, "SELECT x IN (1), x NOT IN (), x IN (1, 2), x IN (SELECT 1)") == 0)
    l: a.selects[r.sel].elist
    e0: ast.list_expr(a, l, 0)
    assert(a.exprs[e0].op == tk.TK_EQ)
    assert(a.exprs[a.exprs[e0].right].op == tk.TK_UPLUS)
    e1: ast.list_expr(a, l, 1)
    assert(a.exprs[e1].op == tk.TK_TRUEFALSE)
    assert(ast.expr_truth_value(a, e1))
    e2: ast.list_expr(a, l, 2)
    assert(a.exprs[e2].op == tk.TK_IN)
    assert(ast.list_len(a, a.exprs[e2].x) == 2)
    e3: ast.list_expr(a, l, 3)
    assert(a.exprs[e3].op == tk.TK_IN)
    assert(ast.has(a, e3, ast.EP_X_IS_SELECT))
}

#Test("operators, LIKE and IS NULL build the right nodes") {
    a := ast.new_ast()
    r := new_recorder()
    assert(parse_with(a, r, "SELECT a NOT LIKE 'x%' ESCAPE '!', b IS NULL, c IS NOT d, -e, f BETWEEN 1 AND 2, CAST(g AS TEXT), h COLLATE nocase") == 0)
    l: a.selects[r.sel].elist
    e0: ast.list_expr(a, l, 0)
    assert(a.exprs[e0].op == tk.TK_NOT)
    assert(ast.has(a, e0, ast.EP_INFIX_FUNC))
    like: a.exprs[e0].left
    assert(a.exprs[like].token == Val("LIKE".bytes()))
    assert(ast.list_len(a, a.exprs[like].x) == 3)
    assert(a.exprs[ast.list_expr(a, l, 1)].op == tk.TK_ISNULL)
    assert(a.exprs[ast.list_expr(a, l, 2)].op == tk.TK_ISNOT)
    assert(a.exprs[ast.list_expr(a, l, 3)].op == tk.TK_UMINUS)
    assert(a.exprs[ast.list_expr(a, l, 4)].op == tk.TK_BETWEEN)
    cast: ast.list_expr(a, l, 5)
    assert(a.exprs[cast].op == tk.TK_CAST)
    assert(a.exprs[cast].token == Val("TEXT".bytes()))
    assert(a.exprs[ast.list_expr(a, l, 6)].op == tk.TK_COLLATE)
}

#Test("window functions take their frame") {
    a := ast.new_ast()
    r := new_recorder()
    assert(parse_with(a, r, "SELECT sum(a) OVER (PARTITION BY b ORDER BY c ROWS BETWEEN 1 PRECEDING AND CURRENT ROW), count(*) FILTER (WHERE a > 0) OVER w FROM t WINDOW w AS (ORDER BY a)") == 0)
    l: a.selects[r.sel].elist
    f: ast.list_expr(a, l, 0)
    assert(ast.has(a, f, ast.EP_WIN_FUNC))
    w: a.exprs[f].y
    assert(a.windows[w].frm_type == tk.TK_ROWS)
    assert(a.windows[w].start_type == tk.TK_PRECEDING)
    assert(a.windows[w].end_type == tk.TK_CURRENT)
    g: ast.list_expr(a, l, 1)
    gw: a.exprs[g].y
    assert(a.windows[gw].name == Val("w".bytes()))
    assert(a.windows[gw].filter >= 0)
    assert(a.windows[a.selects[r.sel].win_defn].name == Val("w".bytes()))
}

#Test("triggers collect their steps") {
    a := ast.new_ast()
    r := new_recorder()
    assert(parse_with(a, r, "CREATE TRIGGER tr AFTER INSERT ON t BEGIN UPDATE t SET a = 1; DELETE FROM t WHERE a = 2; END") == 0)
    after: tk.TK_AFTER
    ins: tk.TK_INSERT
    assert(r.log == [String]{"begin_trigger tr time={after} op={ins}", "finish_trigger steps=2 tr AFTER INSERT ON t BEGIN UPDATE t SET a = 1; DELETE FROM t WHERE a = 2; END", "finish"})
    assert(parse_with(a, r, "CREATE TRIGGER tr AFTER INSERT ON t BEGIN DELETE FROM main.t; END") == 1)
    assert(a.ctx.errmsg == Val("qualified table names are not allowed on INSERT, UPDATE, and DELETE statements within triggers"))
}

#Test("statements of every kind reach the builder") {
    a := ast.new_ast()
    r := new_recorder()
    assert(parse_with(a, r, "BEGIN IMMEDIATE; INSERT OR REPLACE INTO t(a) VALUES (1) ON CONFLICT DO NOTHING; PRAGMA main.cache_size = -100; ALTER TABLE t ADD COLUMN d INT DEFAULT 0; COMMIT") == 0)
    imm: tk.TK_IMMEDIATE
    rep: ast.OE_REPLACE
    com: tk.TK_COMMIT
    assert(r.log == [String]{"begin {imm}", "finish", "insert onerr={rep} upsert=true", "finish", "pragma main|cache_size=100 minus=1", "finish", "begin_add_column", "column d INT", "default 0", "finish_add_column d INT DEFAULT 0;", "finish", "end {com}", "finish"})
}

#Test("variables number as sqlite3ExprAssignVarNumber does") {
    a := ast.new_ast()
    r := new_recorder()
    assert(parse_with(a, r, "SELECT ?, ?5, :x, :x, ?") == 0)
    l: a.selects[r.sel].elist
    assert(a.exprs[ast.list_expr(a, l, 0)].icolumn == 1)
    assert(a.exprs[ast.list_expr(a, l, 1)].icolumn == 5)
    assert(a.exprs[ast.list_expr(a, l, 2)].icolumn == 6)
    assert(a.exprs[ast.list_expr(a, l, 3)].icolumn == 6)
    assert(a.exprs[ast.list_expr(a, l, 4)].icolumn == 7)
    assert(a.ctx.nvar == 7)
    assert(parse_with(a, r, "SELECT #1") == 1)
    assert(a.ctx.errmsg == Val("near \"#1\": syntax error"))
}

#Test("deep nesting overflows the parser stack") {
    a := ast.new_ast()
    r := new_recorder()
    sql := "SELECT "
    loop _i in 0..<120 -> sql = "{sql}("
    sql = "{sql}1"
    loop _i in 0..<120 -> sql = "{sql})"
    assert(parse_with(a, r, sql) == 1)
    assert(a.ctx.errmsg == Val("parser stack overflow"))
}

#Test("the SQL length limit stops the tokenizer") {
    a := ast.new_ast()
    r := new_recorder()
    a.limits[ast.LIMIT_SQL_LENGTH] = 10
    assert(parse_with(a, r, "SELECT 1, 2, 3") == 1)
    assert(a.ctx.rc == base.TOOBIG)
    assert(a.ctx.errmsg == Val("string or blob too big"))
}
