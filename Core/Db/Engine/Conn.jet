// A Mem that holds an engine object rather than a value: MEM_Dyn with the
// object's kind in subtype and its handle in i (C's xDel names the kind).
// A RowSet's handle is its Vdbe.rowsets slot. A pointer value
// (sqlite3VdbeMemSetPointer) is a NULL with MEM_Subtype and C's subtype
// 'p', z its pointer type; OP_VInitIn's ValueList has the type "ValueList"
// and, as its handle, the pc of that op, whose P1 and P3 name its cursor and
// value register in the program running it.
MEM_DYN: 4096
DYN_ROWSET: 1
DYN_POINTER: 112

// MEM_Undefined: a register not yet written.
MEM_UNDEFINED: 0

