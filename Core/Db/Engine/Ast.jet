// The parse-tree layer of the Jet SQLite engine, a port of SQLite 3.45.0:
// the Expr, ExprList, IdList, SrcList, Select, Window, With/Cte, Upsert and
// TriggerStep objects of sqliteInt.h and the routines that build, copy,
// compare, delete and walk them (expr.c, build.c, select.c, window.c,
// trigger.c, upsert.c, walker.c, util.c, malloc.c, printf.c).
//
// SQLite links these objects by pointer. Here they live in one arena per
// connection, `AST`, and refer to one another by index, -1 standing for a
// NULL pointer. Objects of the code generator (Table, Index, AggInfo,
// FuncDef, Schema) appear as opaque Int handles. Deleting an object frees
// nothing; the delete routines keep only the side effects C's have (a
// deleted window function leaves its SELECT's window list, a deleted FROM
// item drops its table reference).
//
// The per-statement fields of SQLite's Parse object that these routines
// read or write (the error state, the bound-parameter list, the SELECT
// counter, the SQL text) are `AST.ctx`; the sqlite3 fields they read
// (aLimit, dbOptFlags, init.busy, suppressErr, errByteOffset) are fields of
// `AST` itself.
use {
    base: __core_db_base
    tk: __core_db_tokenize
    util: __core_db_util
    __core_db_util.[sql_byte, is_space, is_quote, lower_byte, dequote, str_icmp, str_icmp_opt, str_cmp, get_int32, clear_bits]
}

// Expr.flags (sqliteInt.h, "The following are the meanings of bits in the
// Expr.flags field").
EP_OUTER_ON: 1
EP_INNER_ON: 2
EP_DISTINCT: 4
EP_HAS_FUNC: 8
EP_AGG: 16
EP_FIXED_COL: 32
EP_VAR_SELECT: 64
EP_DBL_QUOTED: 128
EP_INFIX_FUNC: 256
EP_COLLATE: 512
EP_COMMUTED: 1024
EP_INT_VALUE: 2048
EP_X_IS_SELECT: 4096
EP_SKIP: 8192
EP_REDUCED: 16384
EP_WIN: 32768
EP_TOKEN_ONLY: 65536
EP_FULL_SIZE: 131072
EP_IF_NULL_ROW: 262144
EP_UNLIKELY: 524288
EP_CONST_FUNC: 1048576
EP_CAN_BE_NULL: 2097152
EP_SUBQUERY: 4194304
EP_LEAF: 8388608
EP_WIN_FUNC: 16777216
EP_SUBRTN: 33554432
EP_QUOTED: 67108864
EP_STATIC: 134217728
EP_IS_TRUE: 268435456
EP_IS_FALSE: 536870912
EP_FROM_DDL: 1073741824
// EP_Propagate: the properties a parent node inherits from its children.
EP_PROPAGATE: 4194824

// Select.selFlags (sqliteInt.h "Allowed values for Select.selFlags").
SF_DISTINCT: 1
SF_ALL: 2
SF_RESOLVED: 4
SF_AGGREGATE: 8
SF_HAS_AGG: 16
SF_USES_EPHEMERAL: 32
SF_EXPANDED: 64
SF_HAS_TYPE_INFO: 128
SF_COMPOUND: 256
SF_VALUES: 512
SF_MULTI_VALUE: 1024
SF_NESTED_FROM: 2048
SF_MIN_MAX_AGG: 4096
SF_RECURSIVE: 8192
SF_FIXED_LIMIT: 16384
SF_MAYBE_CONVERT: 32768
SF_CONVERTED: 65536
SF_INCLUDE_HIDDEN: 131072
SF_COMPLEX_RESULT: 262144
SF_WHERE_BEGIN: 524288
SF_WIN_REWRITE: 1048576
SF_VIEW: 2097152
SF_NOOP_ORDER_BY: 4194304
SF_UF_SRC_CHECK: 8388608
SF_PUSH_DOWN: 16777216
SF_MULTI_PART: 33554432
SF_COPY_CTE: 67108864
SF_ORDER_BY_REQD: 134217728
SF_UPDATE_FROM: 268435456

// SrcItem.fg.jointype (sqliteInt.h "Permitted values of the SrcList.a.jointype
// field").
JT_INNER: 1
JT_CROSS: 2
JT_NATURAL: 4
JT_LEFT: 8
JT_RIGHT: 16
JT_OUTER: 32
JT_LTORJ: 64
JT_ERROR: 128

// Conflict resolution and foreign-key actions (sqliteInt.h OE_*).
OE_NONE: 0
OE_ROLLBACK: 1
OE_ABORT: 2
OE_FAIL: 3
OE_IGNORE: 4
OE_REPLACE: 5
OE_UPDATE: 6
OE_RESTRICT: 7
OE_SET_NULL: 8
OE_SET_DFLT: 9
OE_CASCADE: 10
OE_DEFAULT: 11

// Sort orders (sqliteInt.h SQLITE_SO_*).
SO_ASC: 0
SO_DESC: 1
SO_UNDEFINED: -1

// ExprList_item.fg.eEName (sqliteInt.h ENAME_*).
ENAME_NAME: 0
ENAME_SPAN: 1
ENAME_TAB: 2
ENAME_ROWID: 3

// IdList.eU4 (sqliteInt.h EU4_*).
EU4_NONE: 0
EU4_IDX: 1
EU4_EXPR: 2

// Cte.eM10d (sqliteInt.h M10d_*).
M10D_YES: 0
M10D_ANY: 1
M10D_NO: 2

// Walker callback results (sqliteInt.h WRC_*).
WRC_CONTINUE: 0
WRC_PRUNE: 1
WRC_ABORT: 2

// sqlite3ExprDup flags (sqliteInt.h EXPRDUP_REDUCE).
EXPRDUP_REDUCE: 1

// Trigger timing (sqliteInt.h TRIGGER_*).
TRIGGER_BEFORE: 1
TRIGGER_AFTER: 2

// Table.tabFlags (sqliteInt.h TF_*).
TF_READONLY: 1
TF_HAS_HIDDEN: 2
TF_HAS_PRIMARY_KEY: 4
TF_AUTOINCREMENT: 8
TF_HAS_STAT1: 16
TF_HAS_VIRTUAL: 32
TF_HAS_STORED: 64
TF_HAS_GENERATED: 96
TF_WITHOUT_ROWID: 128
TF_STATS_USED: 256
TF_NO_VISIBLE_ROWID: 512
TF_OOO_HIDDEN: 1024
TF_HAS_NOT_NULL: 2048
TF_SHADOW: 4096
TF_HAS_STAT4: 8192
TF_EPHEMERAL: 16384
TF_EPONYMOUS: 32768
TF_STRICT: 65536

// Index.idxType (sqliteInt.h SQLITE_IDXTYPE_*).
IDXTYPE_APPDEF: 0
IDXTYPE_UNIQUE: 1
IDXTYPE_PRIMARYKEY: 2
IDXTYPE_IPK: 3

// Parse.eParseMode (sqliteInt.h PARSE_MODE_*).
PARSE_MODE_NORMAL: 0
PARSE_MODE_DECLARE_VTAB: 1
PARSE_MODE_RENAME: 2
PARSE_MODE_UNMAP: 3

// NameContext.ncFlags (sqliteInt.h NC_*); OP_Function and OP_PureFunc
// carry the NC_SELF_REF bits of their context in P5.
NC_ALLOW_AGG: 1
NC_PART_IDX: 2
NC_IS_CHECK: 4
NC_GEN_COL: 8
NC_HAS_AGG: 16
NC_IDX_EXPR: 32
NC_SELF_REF: 46
NC_SUBQUERY: 64
NC_UELIST: 128
NC_UAGG_INFO: 256
NC_UUPSERT: 512
NC_UBASE_REG: 1024
NC_MIN_MAX_AGG: 4096
NC_COMPLEX: 8192
NC_ALLOW_WIN: 16384
NC_HAS_WIN: 32768
NC_IS_DDL: 65536
NC_IN_AGG_FUNC: 131072
NC_FROM_DDL: 262144
NC_NO_SELECT: 524288
NC_ORDER_AGG: 134217728

// Indexes of sqlite3.aLimit (sqlite3.h SQLITE_LIMIT_*).
LIMIT_LENGTH: 0
LIMIT_SQL_LENGTH: 1
LIMIT_COLUMN: 2
LIMIT_EXPR_DEPTH: 3
LIMIT_COMPOUND_SELECT: 4
LIMIT_VDBE_OP: 5
LIMIT_FUNCTION_ARG: 6
LIMIT_ATTACHED: 7
LIMIT_LIKE_PATTERN_LENGTH: 8
LIMIT_VARIABLE_NUMBER: 9
LIMIT_TRIGGER_DEPTH: 10
LIMIT_WORKER_THREADS: 11

// The compile-time maxima the limits start at (sqliteLimit.h, and
// SQLITE_DEFAULT_WORKER_THREADS 0).
DEFAULT_LIMITS: [Int]{1000000000, 1000000000, 2000, 1000, 500, 250000000, 127, 10, 50000, 32766, 1000, 0}

// sqlite3.dbOptFlags bit SQLITE_WindowFunc (sqliteInt.h).
OPT_WINDOW_FUNC: 2

// SQLITE_MAX_SRCLIST (build.c).
MAX_SRCLIST: 200

// The three allocation sizes of an Expr (sqliteInt.h EXPR_FULLSIZE,
// EXPR_REDUCEDSIZE, EXPR_TOKENONLYSIZE): a token-only node ends after the
// token, a reduced node after nHeight.
SIZE_TOKEN_ONLY: 0
SIZE_REDUCED: 1
SIZE_FULL: 2

// A Token: `n` bytes of the statement text from offset `z`; z is -1 for a
// NULL Token.z. "NOT INDEXED" is {z: -1, n: 1} (parse.y indexed_opt).
SQLTok: struct {
    z: Int
    n: Int
}

// struct Expr (sqliteInt.h).
SQLExpr: struct {
    op: Int
    aff: Int
    op2: Int
    flags: Int
    // u.zToken; None is a NULL zToken. Unused when EP_INT_VALUE is set.
    token: [U8]?
    // u.iValue, when EP_INT_VALUE is set.
    ivalue: Int
    left: Int
    right: Int
    // x.pList or x.pSelect; EP_X_IS_SELECT tells which.
    x: Int
    height: Int
    itable: Int
    icolumn: Int
    iagg: Int
    // w.iJoin or w.iOfst.
    w: Int
    agg_info: Int
    // y.pTab, y.pWin or y.sub.iAddr.
    y: Int
    // y.sub.regReturn.
    y_reg: Int
}

// struct ExprList_item (sqliteInt.h).
SQLExprItem: struct {
    expr: Int
    ename: [U8]?
    sort_flags: Int
    eename: Int
    done: Bool
    reusable: Bool
    sorter_ref: Bool
    nulls: Bool
    used: Bool
    using_term: Bool
    no_expand: Bool
    order_by_col: Int
    alias: Int
    const_reg: Int
}

SQLExprList: struct {
    items: [SQLExprItem]
}

// struct IdList_item and IdList (sqliteInt.h).
SQLIDItem: struct {
    name: [U8]?
    // u4.idx or u4.pExpr, as IdList.eU4 says.
    u4: Int
}

SQLIDList: struct {
    items: [SQLIDItem]
    eu4: Int
}

// struct SrcItem (sqliteInt.h).
SQLSrcItem: struct {
    schema: Int
    database: [U8]?
    name: [U8]?
    alias: [U8]?
    tab: Int
    select: Int
    addr_fill_sub: Int
    reg_return: Int
    reg_result: Int
    jointype: Int
    not_indexed: Bool
    is_indexed_by: Bool
    is_tab_func: Bool
    is_correlated: Bool
    is_materialized: Bool
    via_coroutine: Bool
    is_recursive: Bool
    from_ddl: Bool
    is_cte: Bool
    not_cte: Bool
    is_using: Bool
    is_on: Bool
    is_synth_using: Bool
    is_nested_from: Bool
    cursor: Int
    // u3.pOn or u3.pUsing; fg.isUsing tells which.
    u3: Int
    col_used: Int
    // u1.zIndexedBy (fg.isIndexedBy) and u1.pFuncArg (fg.isTabFunc).
    indexed_by: [U8]?
    func_arg: Int
    // u2.pIBIndex or u2.pCteUse (fg.isCte).
    u2: Int
}

// struct SrcList (sqliteInt.h): the items, by index into AST.items, and
// nAlloc, which bounds growth exactly as sqlite3SrcListEnlarge does.
SQLSrcList: struct {
    items: [Int]
    nalloc: Int
}

// struct Select (sqliteInt.h).
SQLSelect: struct {
    op: Int
    nselect_row: Int
    sel_flags: Int
    ilimit: Int
    ioffset: Int
    sel_id: Int
    addr_open_ephm0: Int
    addr_open_ephm1: Int
    elist: Int
    src: Int
    where_expr: Int
    group_by: Int
    having: Int
    order_by: Int
    prior: Int
    next_sel: Int
    limit: Int
    with_clause: Int
    win: Int
    win_defn: Int
}

// Window.ppThis: the link that points at a window in its SELECT's list.
THIS_NONE: 0
// &Select.pWin of select `this_ref`.
THIS_SELECT: 1
// &Window.pNextWin of window `this_ref`.
THIS_WINDOW: 2

// struct Window (sqliteInt.h).
SQLWindow: struct {
    name: [U8]?
    base: [U8]?
    partition: Int
    order_by: Int
    frm_type: Int
    start_type: Int
    end_type: Int
    implicit_frame: Bool
    exclude: Int
    start_expr: Int
    end_expr: Int
    this_kind: Int
    this_ref: Int
    next_win: Int
    filter: Int
    wfunc: Int
    eph_csr: Int
    reg_accum: Int
    reg_result: Int
    csr_app: Int
    reg_app: Int
    reg_part: Int
    owner: Int
    nbuffer_col: Int
    iarg_col: Int
    reg_one: Int
    reg_start_rowid: Int
    reg_end_rowid: Int
    expr_args: Bool
}

// struct Cte, With and CteUse (sqliteInt.h).
SQLCte: struct {
    name: [U8]?
    cols: Int
    select: Int
    cte_err: String?
    cte_use: Int
    m10d: Int
}

SQLWith: struct {
    ctes: [Int]
    bview: Bool
    outer: Int
}

SQLCteUse: struct {
    nuse: Int
    addr_m9e: Int
    reg_rtn: Int
    icur: Int
    nrow_est: Int
    m10d: Int
}

// struct Upsert (sqliteInt.h).
SQLUpsert: struct {
    target: Int
    target_where: Int
    set: Int
    where_expr: Int
    next_upsert: Int
    do_update: Bool
    is_dup: Bool
    idx: Int
    src: Int
    reg_data: Int
    data_cur: Int
    idx_cur: Int
}

// struct TriggerStep (sqliteInt.h).
SQLTriggerStep: struct {
    op: Int
    orconf: Int
    trig: Int
    select: Int
    target: [U8]?
    from: Int
    where_expr: Int
    elist: Int
    idlist: Int
    upsert: Int
    span: [U8]?
    next_step: Int
    last_step: Int
}

// One Parse.pVList entry (util.c VList): a parameter name and its number.
SQLVar: struct {
    num: Int
    name: [U8]
}

// The per-statement fields of Parse these routines use.
SQLStmtCtx: struct {
    // The statement text (Parse.zTail at the start of sqlite3RunParser),
    // cut at its first NUL as the C string is.
    sql: [U8]
    nested: Int
    parse_mode: Int
    nerr: Int
    rc: Int
    errmsg: String?
    nvar: Int
    vlist: [SQLVar]
    nselect: Int
    // Parse.pWith: the WITH clauses in scope.
    cur_with: Int
    // Parse.explain, the EXPLAIN mode (1 EXPLAIN, 2 EXPLAIN QUERY PLAN), and
    // whether Parse.pReprepare is set (a re-prepare ignores EXPLAIN).
    explain: Int
    reprepare: Bool
    // Parse.constraintName, Parse.hasCompound, Parse.sLastToken.
    constraint_name: SQLTok
    has_compound: Bool
    last_token: SQLTok
    // Parse.zTail after sqlite3RunParser: the offset where parsing stopped.
    tail: Int
}

AST: struct {
    exprs: [SQLExpr]
    lists: [SQLExprList]
    idlists: [SQLIDList]
    srclists: [SQLSrcList]
    items: [SQLSrcItem]
    selects: [SQLSelect]
    windows: [SQLWindow]
    ctes: [SQLCte]
    withs: [SQLWith]
    cte_uses: [SQLCteUse]
    upserts: [SQLUpsert]
    steps: [SQLTriggerStep]
    // sqlite3.aLimit, dbOptFlags, init.busy, suppressErr, errByteOffset.
    limits: [Int]
    opt_flags: Int
    init_busy: Bool
    suppress_err: Bool
    err_offset: Int
    // The references (Table.nTabRef beyond its own) FROM items of the
    // statement hold on each table handle.
    tab_refs: [Int: Int]
    ctx: SQLStmtCtx
}

new_ctx: fn(sql: [U8]) -> SQLStmtCtx Never! {
    n := 0
    loop n < sql.len() && sql[n] != (U8{0}) -> n += 1
    SQLStmtCtx{sql: sql[0..<n].copy(), nested: 0, parse_mode: PARSE_MODE_NORMAL, nerr: 0, rc: base.OK, errmsg: None, nvar: 0, vlist: [SQLVar]{}, nselect: 0, cur_with: -1, explain: 0, reprepare: false, constraint_name: SQLTok{z: -1, n: 0}, has_compound: false, last_token: SQLTok{z: -1, n: 0}, tail: 0}
}

new_ast: fn() -> AST Never! {
    AST{
        exprs: [SQLExpr]{}
        lists: [SQLExprList]{}
        idlists: [SQLIDList]{}
        srclists: [SQLSrcList]{}
        items: [SQLSrcItem]{}
        selects: [SQLSelect]{}
        windows: [SQLWindow]{}
        ctes: [SQLCte]{}
        withs: [SQLWith]{}
        cte_uses: [SQLCteUse]{}
        upserts: [SQLUpsert]{}
        steps: [SQLTriggerStep]{}
        limits: DEFAULT_LIMITS.copy()
        opt_flags: 0
        init_busy: false
        suppress_err: false
        err_offset: -1
        tab_refs: [Int: Int]{}
        ctx: new_ctx([U8]{})
    }
}

// Begin a statement over `sql`: a fresh Parse.
begin_statement: fn(a: &AST, sql: [U8]) Never! { a.ctx = new_ctx(sql) }

// IN_RENAME_OBJECT (sqliteInt.h).
in_rename: fn(a: AST) -> Bool Never! { a.ctx.parse_mode >= PARSE_MODE_RENAME }

// ---------------------------------------------------------------------------
// Text helpers (malloc.c, printf.c, build.c).

// The bytes of a token.
tok_bytes: fn(a: AST, t: SQLTok) -> [U8] Never! {
    if t.z < 0 -> return [U8]{}
    a.ctx.sql[t.z..<t.z + t.n].copy()
}

// A token as a C token pointer: None for a NULL Token.z.
tok_opt: fn(a: AST, t: SQLTok) -> [U8]? Never! {
    if t.z < 0 -> return None
    Val(tok_bytes(a, t))
}

// The text printf's %T writes for a token (printf.c etTOKEN).
tok_text: fn(a: AST, t: SQLTok) -> String Never! {
    if t.n <= 0 || t.z < 0 -> return ""
    text(tok_bytes(a, t))
}

// The error offset printf's %T records for a token, -1 when it records none
// (printf.c sqlite3RecordErrorByteOffset: tokens inside Parse.zTail only).
tok_offset: fn(a: AST, t: SQLTok) -> Int Never! {
    if t.n <= 0 || t.z < 0 || t.z >= a.ctx.sql.len() -> return -1
    t.z
}

text: fn(b: [U8]) -> String Never! { String.from_bytes(b) ?? "" }

// sqlite3NameFromToken (build.c): the dequoted token, None for NULL.
name_from: fn(raw: [U8]?) -> [U8]? Never! {
    if raw == .Val(b) -> return Val(dequote(b))
    None
}

// The bytes from `start` to `end` of the statement text with surrounding
// whitespace trimmed (malloc.c sqlite3DbSpanDup).
span_dup: fn(a: AST, start: Int, end: Int) -> [U8] Never! {
    s := start
    loop s < end && is_space(sql_byte(a.ctx.sql, s)) -> s += 1
    e := end
    loop e > s && is_space(sql_byte(a.ctx.sql, e - 1)) -> e -= 1
    a.ctx.sql[s..<e].copy()
}

// ---------------------------------------------------------------------------
// Errors (util.c sqlite3ErrorMsg, printf.c error offsets).

// sqlite3ErrorMsg: record an error against the statement. `offset` is the
// byte offset the message's %T or %#T argument records, else -1.
error_at: fn(a: &AST, msg: String, offset: Int) Never! {
    a.err_offset = offset
    if a.suppress_err -> return
    a.ctx.nerr += 1
    a.ctx.errmsg = Val(msg)
    a.ctx.rc = base.ERROR
    a.ctx.cur_with = -1
}

error: fn(a: &AST, msg: String) Never! { error_at(a, msg, -1) }

// The offset sqlite3RecordErrorOffsetOfExpr (printf.c) records for an
// expression, -1 when none: the first of it and its left descendants that
// is not part of an ON clause and has a positive offset.
expr_offset: fn(a: AST, e0: Int) -> Int Never! {
    e := e0
    loop e >= 0 && (has(a, e, EP_OUTER_ON.bit_or(EP_INNER_ON)) || a.exprs[e].w <= 0) -> e = a.exprs[e].left
    if e < 0 -> return -1
    a.exprs[e].w
}

// The text printf's %#T writes for an expression: its token.
expr_text: fn(a: AST, e: Int) -> String Never! {
    if e < 0 || has(a, e, EP_INT_VALUE) -> return ""
    text(a.exprs[e].token ?? [U8]{})
}

// sqlite3ExprSetErrorOffset (expr.c).
expr_set_error_offset: fn(a: &AST, e: Int, offset: Int) Never! {
    if e < 0 -> return
    if has(a, e, EP_OUTER_ON.bit_or(EP_INNER_ON)) -> return
    a.exprs[e].w = offset
}

// ---------------------------------------------------------------------------
// Expressions (expr.c).

has: fn(a: AST, e: Int, f: Int) -> Bool Never! { a.exprs[e].flags.bit_and(f) != 0 }

set_flags: fn(a: &AST, e: Int, f: Int) Never! { a.exprs[e].flags = a.exprs[e].flags.bit_or(f) }

clear_flags: fn(a: &AST, e: Int, f: Int) Never! { a.exprs[e].flags = clear_bits(a.exprs[e].flags, f) }

zero_expr: fn(op: Int) -> SQLExpr Never! {
    SQLExpr{op: op, aff: 0, op2: 0, flags: 0, token: None, ivalue: 0, left: -1, right: -1, x: -1, height: 0, itable: 0, icolumn: 0, iagg: -1, w: 0, agg_info: -1, y: -1, y_reg: 0}
}

push_expr: fn(a: &AST, e: SQLExpr) -> Int Never! {
    a.exprs.push(e.copy())
    a.exprs.len() - 1
}

list_len: fn(a: AST, l: Int) -> Int Never! {
    if l < 0 -> return 0
    a.lists[l].items.len()
}

list_expr: fn(a: AST, l: Int, i: Int) -> Int Never! { a.lists[l].items[i].expr }

// sqlite3ExprAlloc: a leaf node. `tok` is the token (None for a NULL
// Token); a TK_INTEGER token that sqlite3GetInt32 reads becomes an
// EP_INT_VALUE node, any other token is copied and, when `dequote`, a quoted
// one is dequoted (sqlite3DequoteExpr).
expr_alloc: fn(a: &AST, op: Int, tok: [U8]?, dequote_it: Bool) -> Int Never! {
    e := zero_expr(op)
    if tok == .Val(t) {
        iv: if op == tk.TK_INTEGER -> get_int32(t) else -> None
        if iv == .Val(v) {
            e.flags = EP_INT_VALUE.bit_or(EP_LEAF).bit_or(if v != 0 -> EP_IS_TRUE else -> EP_IS_FALSE)
            e.ivalue = v
        } else if dequote_it && t.len() > 0 && is_quote(Int{t[0]}) {
            e.flags = if t[0] == (U8{34}) -> EP_QUOTED.bit_or(EP_DBL_QUOTED) else -> EP_QUOTED
            e.token = Val(dequote(t))
        } else {
            e.token = Val(t)
        }
    }
    e.height = 1
    push_expr(a, e)
}

// sqlite3Expr: a leaf node with the token text `z`.
expr: fn(a: &AST, op: Int, z: [U8]) -> Int Never! { expr_alloc(a, op, Val(z), false) }

// sqlite3ExprAttachSubtrees.
attach_subtrees: fn(a: &AST, root: Int, left: Int, right: Int) Never! {
    if root < 0 {
        expr_delete(a, left)
        expr_delete(a, right)
        return
    }
    if right >= 0 {
        a.exprs[root].right = right
        rf: a.exprs[right].flags
        set_flags(a, root, EP_PROPAGATE.bit_and(rf))
        a.exprs[root].height = a.exprs[right].height + 1
    } else {
        a.exprs[root].height = 1
    }
    if left >= 0 {
        a.exprs[root].left = left
        lf: a.exprs[left].flags
        set_flags(a, root, EP_PROPAGATE.bit_and(lf))
        if a.exprs[left].height >= a.exprs[root].height -> a.exprs[root].height = a.exprs[left].height + 1
    }
}

// sqlite3ExprCheckHeight.
check_height: fn(a: &AST, height: Int) -> Int Never! {
    mx: a.limits[LIMIT_EXPR_DEPTH]
    if height > mx {
        error(a, "Expression tree is too large (maximum depth {mx})")
        return base.ERROR
    }
    base.OK
}

height_of_expr: fn(a: AST, e: Int, h: Int) -> Int Never! {
    if e >= 0 && a.exprs[e].height > h -> return a.exprs[e].height
    h
}

height_of_list: fn(a: AST, l: Int, h0: Int) -> Int Never! {
    h := h0
    loop i in 0..<list_len(a, l) -> h = height_of_expr(a, list_expr(a, l, i), h)
    h
}

height_of_select: fn(a: AST, s0: Int, h0: Int) -> Int Never! {
    h := h0
    s := s0
    loop s >= 0 {
        h = height_of_expr(a, a.selects[s].where_expr, h)
        h = height_of_expr(a, a.selects[s].having, h)
        h = height_of_expr(a, a.selects[s].limit, h)
        h = height_of_list(a, a.selects[s].elist, h)
        h = height_of_list(a, a.selects[s].group_by, h)
        h = height_of_list(a, a.selects[s].order_by, h)
        s = a.selects[s].prior
    }
    h
}

// exprSetHeight.
expr_set_height: fn(a: &AST, e: Int) Never! {
    h := if a.exprs[e].left >= 0 -> a.exprs[a.exprs[e].left].height else -> 0
    r: a.exprs[e].right
    if r >= 0 && a.exprs[r].height > h -> h = a.exprs[r].height
    if has(a, e, EP_X_IS_SELECT) {
        h = height_of_select(a, a.exprs[e].x, h)
    } else if a.exprs[e].x >= 0 {
        h = height_of_list(a, a.exprs[e].x, h)
        lflags: expr_list_flags(a, a.exprs[e].x)
        set_flags(a, e, EP_PROPAGATE.bit_and(lflags))
    }
    a.exprs[e].height = h + 1
}

// sqlite3ExprSetHeightAndFlags.
set_height_and_flags: fn(a: &AST, e: Int) Never! {
    if a.ctx.nerr > 0 -> return
    expr_set_height(a, e)
    _ := check_height(a, a.exprs[e].height)
}

// sqlite3PExpr: an interior node over two subtrees.
pexpr: fn(a: &AST, op: Int, left: Int, right: Int) -> Int Never! {
    e: push_expr(a, zero_expr(op.bit_and(255)))
    attach_subtrees(a, e, left, right)
    _ := check_height(a, a.exprs[e].height)
    e
}

// sqlite3PExprAddSelect.
pexpr_add_select: fn(a: &AST, e: Int, sel: Int) Never! {
    if e < 0 {
        select_delete(a, sel)
        return
    }
    a.exprs[e].x = sel
    set_flags(a, e, EP_X_IS_SELECT.bit_or(EP_SUBQUERY))
    set_height_and_flags(a, e)
}

// sqlite3ExprListToValues: the VALUES compound a list of vectors stands for
// on the right of IN.
expr_list_to_values: fn(a: &AST, nelem: Int, list: Int) -> Int Never! {
    ret := -1
    loop ii in 0..<list_len(a, list) {
        e: list_expr(a, list, ii)
        n: if a.exprs[e].op == tk.TK_VECTOR -> list_len(a, a.exprs[e].x) else -> 1
        if n != nelem {
            plural: if n > 1 -> "s" else -> ""
            error(a, "IN(...) element has {n} term{plural} - expected {nelem}")
            break
        }
        sel: select_new(a, a.exprs[e].x, -1, -1, -1, -1, -1, SF_VALUES, -1)
        a.exprs[e].x = -1
        if ret >= 0 {
            a.selects[sel].op = tk.TK_ALL
            a.selects[sel].prior = ret
        }
        ret = sel
    }
    if ret >= 0 && a.selects[ret].prior >= 0 -> a.selects[ret].sel_flags = a.selects[ret].sel_flags.bit_or(SF_MULTI_VALUE)
    expr_list_delete(a, list)
    ret
}

// sqlite3ExprAnd: AND two expressions; a side known false (outside an ON
// clause) makes the whole the constant 0.
expr_and: fn(a: &AST, left: Int, right: Int) -> Int Never! {
    if left < 0 -> return right
    if right < 0 -> return left
    f: a.exprs[left].flags.bit_or(a.exprs[right].flags)
    if f.bit_and(EP_OUTER_ON.bit_or(EP_INNER_ON).bit_or(EP_IS_FALSE)) == EP_IS_FALSE && !in_rename(a) {
        // sqlite3ExprDeferredDelete: both sides are deleted with the parse.
        return expr(a, tk.TK_INTEGER, "0".bytes())
    }
    pexpr(a, tk.TK_AND, left, right)
}

// sqlite3ExprFunction: a function call node named by `name`.
expr_function: fn(a: &AST, list: Int, name: SQLTok, distinct: Int) -> Int Never! {
    name_bytes: tok_bytes(a, name)
    e: expr_alloc(a, tk.TK_FUNCTION, Val(name_bytes), true)
    a.exprs[e].w = name.z
    if list >= 0 && list_len(a, list) > a.limits[LIMIT_FUNCTION_ARG] && a.ctx.nested == 0 {
        t: tok_text(a, name)
        off: tok_offset(a, name)
        error_at(a, "too many arguments on function {t}", off)
    }
    a.exprs[e].x = list
    set_flags(a, e, EP_HAS_FUNC)
    set_height_and_flags(a, e)
    if distinct == SF_DISTINCT -> set_flags(a, e, EP_DISTINCT)
    e
}

// IsWindowFunc (sqliteInt.h).
is_window_func: fn(a: AST, e: Int) -> Bool Never! {
    has(a, e, EP_WIN_FUNC) && a.windows[a.exprs[e].y].frm_type != tk.TK_FILTER
}

// sqlite3ExprOrderByAggregateError.
order_by_aggregate_error: fn(a: &AST, e: Int) Never! {
    t: expr_text(a, e)
    off: expr_offset(a, e)
    error_at(a, "ORDER BY may not be used with non-aggregate {t}()", off)
}

// sqlite3ExprAddFunctionOrderBy: attach an aggregate's ORDER BY clause as a
// TK_ORDER node on the function's left.
expr_add_function_order_by: fn(a: &AST, e: Int, order_by: Int) Never! {
    if order_by < 0 -> return
    if e < 0 {
        expr_list_delete(a, order_by)
        return
    }
    if a.exprs[e].x < 0 || list_len(a, a.exprs[e].x) == 0 {
        // ORDER BY on a zero-argument aggregate is ignored.
        return
    }
    if is_window_func(a, e) {
        order_by_aggregate_error(a, e)
        expr_list_delete(a, order_by)
        return
    }
    ob: expr_alloc(a, tk.TK_ORDER, None, false)
    a.exprs[ob].x = order_by
    a.exprs[e].left = ob
    set_flags(a, ob, EP_FULL_SIZE)
}

// The value of a ynVar (an i16 when SQLITE_MAX_VARIABLE_NUMBER <= 32767).
to_i16: fn(v: Int) -> Int Never! { (v + 32768).bit_and(65535) - 32768 }

vlist_num_to_name: fn(a: AST, num: Int) -> [U8]? Never! {
    loop v in a.ctx.vlist {
        if v.num == num -> return Val(v.name)
    }
    None
}

vlist_name_to_num: fn(a: AST, name: [U8]) -> Int Never! {
    loop v in a.ctx.vlist {
        if v.name == name -> return v.num
    }
    0
}

// sqlite3ExprAssignVarNumber: number a bound parameter "?", "?NNN",
// ":AAA", "@AAA" or "$AAA".
expr_assign_var_number: fn(a: &AST, e: Int, n: Int) Never! {
    if e < 0 -> return
    z: a.exprs[e].token ?? [U8]{}
    x := 0
    if z.len() == 1 {
        a.ctx.nvar += 1
        x = to_i16(a.ctx.nvar)
    } else {
        add := false
        if z[0] == (U8{63}) {
            iv: if n == 2 -> Val(Int{z[1]} - 48) else -> util.atoi64_ok(z[1..<n].copy(), base.UTF8)
            mx: a.limits[LIMIT_VARIABLE_NUMBER]
            i: iv ?? 0
            if iv == None || i < 1 || i > mx {
                off: expr_offset(a, e)
                error_at(a, "variable number must be between ?1 and ?{mx}", off)
                return
            }
            x = i
            if x > a.ctx.nvar {
                a.ctx.nvar = x
                add = true
            } else if vlist_num_to_name(a, x) == None {
                add = true
            }
        } else {
            x = vlist_name_to_num(a, z)
            if x == 0 {
                a.ctx.nvar += 1
                x = to_i16(a.ctx.nvar)
                add = true
            }
        }
        if add -> a.ctx.vlist.push(SQLVar{num: x, name: z})
    }
    a.exprs[e].icolumn = x
    if x > a.limits[LIMIT_VARIABLE_NUMBER] {
        off: expr_offset(a, e)
        error_at(a, "too many SQL variables", off)
    }
}

// sqlite3ExprDelete: the side effects of deleting a tree.
expr_delete: fn(a: &AST, e: Int) Never! {
    if e < 0 -> return
    if has(a, e, EP_TOKEN_ONLY.bit_or(EP_LEAF)) -> return
    if a.exprs[e].left >= 0 && a.exprs[e].op != tk.TK_SELECT_COLUMN -> expr_delete(a, a.exprs[e].left)
    if a.exprs[e].right >= 0 {
        expr_delete(a, a.exprs[e].right)
    } else if has(a, e, EP_X_IS_SELECT) {
        select_delete(a, a.exprs[e].x)
    } else {
        expr_list_delete(a, a.exprs[e].x)
        if has(a, e, EP_WIN_FUNC) -> window_delete(a, a.exprs[e].y)
    }
}

// sqlite3ExprUnmapAndDelete.
expr_unmap_and_delete: fn(a: &AST, e: Int) Never! { expr_delete(a, e) }

// sqlite3ClearOnOrUsing.
clear_on_or_using: fn(a: &AST, on: Int, using: Int) Never! {
    if on >= 0 -> expr_delete(a, on)
}

// ---------------------------------------------------------------------------
// Expression lists (expr.c).

zero_item: fn(e: Int) -> SQLExprItem Never! {
    SQLExprItem{expr: e, ename: None, sort_flags: 0, eename: ENAME_NAME, done: false, reusable: false, sorter_ref: false, nulls: false, used: false, using_term: false, no_expand: false, order_by_col: 0, alias: 0, const_reg: 0}
}

// sqlite3ExprListAppend.
expr_list_append: fn(a: &AST, list: Int, e: Int) -> Int Never! {
    if list < 0 {
        a.lists.push(SQLExprList{items: [SQLExprItem]{zero_item(e)}})
        return a.lists.len() - 1
    }
    a.lists[list].items.push(zero_item(e))
    list
}

// sqlite3ExprVectorSize.
vector_size: fn(a: AST, e: Int) -> Int Never! {
    op := a.exprs[e].op
    if op == tk.TK_REGISTER -> op = a.exprs[e].op2
    if op == tk.TK_VECTOR -> return list_len(a, a.exprs[e].x)
    if op == tk.TK_SELECT -> return list_len(a, a.selects[a.exprs[e].x].elist)
    1
}

// sqlite3ExprIsVector.
is_vector: fn(a: AST, e: Int) -> Bool Never! { vector_size(a, e) > 1 }

// sqlite3VectorFieldSubexpr.
vector_field_subexpr: fn(a: AST, v: Int, i: Int) -> Int Never! {
    if is_vector(a, v) {
        if a.exprs[v].op == tk.TK_SELECT || a.exprs[v].op2 == tk.TK_SELECT -> return list_expr(a, a.selects[a.exprs[v].x].elist, i)
        return list_expr(a, a.exprs[v].x, i)
    }
    v
}

// sqlite3ExprForVectorField: a new expression for field `i` of a vector.
expr_for_vector_field: fn(a: &AST, v: Int, i: Int, n: Int) -> Int Never! {
    if a.exprs[v].op == tk.TK_SELECT {
        r: pexpr(a, tk.TK_SELECT_COLUMN, -1, -1)
        set_flags(a, r, EP_FULL_SIZE)
        a.exprs[r].itable = n
        a.exprs[r].icolumn = i
        a.exprs[r].left = v
        return r
    }
    src := v
    if a.exprs[v].op == tk.TK_VECTOR {
        l: a.exprs[v].x
        src = a.lists[l].items[i].expr
        if in_rename(a) {
            a.lists[l].items[i].expr = -1
            return src
        }
    }
    expr_dup(a, src, 0)
}

// sqlite3ExprListAppendVector: the terms of "(a,b,c) = vector" in an UPDATE
// SET clause.
expr_list_append_vector: fn(a: &AST, list0: Int, cols: Int, e0: Int) -> Int Never! {
    list := list0
    e := e0
    first: if list >= 0 -> list_len(a, list) else -> 0
    ok := cols >= 0 && e >= 0
    if ok && a.exprs[e].op != tk.TK_SELECT {
        ncols: a.idlists[cols].items.len()
        n: vector_size(a, e)
        if ncols != n {
            error(a, "{ncols} columns assigned {n} values")
            ok = false
        }
    }
    if ok {
        ncols: a.idlists[cols].items.len()
        loop i in 0..<ncols {
            sub: expr_for_vector_field(a, e, i, ncols)
            if sub < 0 -> next
            list = expr_list_append(a, list, sub)
            last: a.lists[list].items.len() - 1
            a.lists[list].items[last].ename = a.idlists[cols].items[i].name
            a.idlists[cols].items[i].name = None
        }
        if a.exprs[e].op == tk.TK_SELECT && list >= 0 {
            f: a.lists[list].items[first].expr
            a.exprs[f].right = e
            e = -1
            a.exprs[f].itable = ncols
        }
    }
    expr_unmap_and_delete(a, e)
    list
}

// sqlite3ExprListSetSortOrder: the ASC/DESC and NULLS FIRST/LAST of the
// last item.
expr_list_set_sort_order: fn(a: &AST, list: Int, order0: Int, nulls: Int) Never! {
    if list < 0 -> return
    i: a.lists[list].items.len() - 1
    order: if order0 == SO_UNDEFINED -> SO_ASC else -> order0
    a.lists[list].items[i].sort_flags = order
    if nulls != SO_UNDEFINED {
        a.lists[list].items[i].nulls = true
        if order != nulls -> a.lists[list].items[i].sort_flags = order.bit_or(base.KEYINFO_ORDER_BIGNULL)
    }
}

// sqlite3ExprListSetName: name the last item `name`, dequoted when
// `dequote_it`.
expr_list_set_name: fn(a: &AST, list: Int, name: [U8], dequote_it: Bool) Never! {
    if list < 0 -> return
    i: a.lists[list].items.len() - 1
    a.lists[list].items[i].ename = Val(if dequote_it -> dequote(name) else -> name)
}

// sqlite3ExprListSetSpan: give the last item, unless named, the text from
// `start` to `end` as its span.
expr_list_set_span: fn(a: &AST, list: Int, start: Int, end: Int) Never! {
    if list < 0 -> return
    i: a.lists[list].items.len() - 1
    if a.lists[list].items[i].ename == None {
        a.lists[list].items[i].ename = Val(span_dup(a, start, end))
        a.lists[list].items[i].eename = ENAME_SPAN
    }
}

// sqlite3ExprListCheckLength.
expr_list_check_length: fn(a: &AST, list: Int, what: String) Never! {
    if list >= 0 && list_len(a, list) > a.limits[LIMIT_COLUMN] -> error(a, "too many columns in {what}")
}

// sqlite3ExprListDelete.
expr_list_delete: fn(a: &AST, list: Int) Never! {
    loop i in 0..<list_len(a, list) {
        e: list_expr(a, list, i)
        expr_delete(a, e)
    }
}

// sqlite3ExprListFlags.
expr_list_flags: fn(a: AST, list: Int) -> Int Never! {
    m := 0
    loop i in 0..<list_len(a, list) -> m = m.bit_or(a.exprs[list_expr(a, list, i)].flags)
    m
}

// sqlite3ExprAddCollateToken: wrap an expression in COLLATE `name` unless
// the name is empty.
expr_add_collate_token: fn(a: &AST, e: Int, name: [U8], dequote_it: Bool) -> Int Never! {
    if name.len() == 0 -> return e
    c: expr_alloc(a, tk.TK_COLLATE, Val(name), dequote_it)
    a.exprs[c].left = e
    set_flags(a, c, EP_COLLATE.bit_or(EP_SKIP))
    c
}

// sqlite3ExprAddCollateString.
expr_add_collate_string: fn(a: &AST, e: Int, name: [U8]) -> Int Never! { expr_add_collate_token(a, e, name, false) }

// sqlite3ExprSkipCollate.
skip_collate: fn(a: AST, e0: Int) -> Int Never! {
    e := e0
    loop e >= 0 && has(a, e, EP_SKIP) -> e = a.exprs[e].left
    e
}

// sqlite3ExprSkipCollateAndLikely.
skip_collate_and_likely: fn(a: AST, e0: Int) -> Int Never! {
    e := e0
    loop e >= 0 && has(a, e, EP_SKIP.bit_or(EP_UNLIKELY)) {
        if has(a, e, EP_UNLIKELY) {
            e = list_expr(a, a.exprs[e].x, 0)
        } else {
            e = a.exprs[e].left
        }
    }
    e
}

// sqlite3IsTrueOrFalse.
is_true_or_false: fn(z: [U8]) -> Int Never! {
    if str_icmp(z, "true".bytes()) == 0 -> return EP_IS_TRUE
    if str_icmp(z, "false".bytes()) == 0 -> return EP_IS_FALSE
    0
}

// sqlite3ExprIdToTrueFalse: turn an unquoted TRUE or FALSE identifier into
// a TK_TRUEFALSE node.
expr_id_to_true_false: fn(a: &AST, e: Int) -> Bool Never! {
    if has(a, e, EP_QUOTED.bit_or(EP_INT_VALUE)) -> return false
    v: is_true_or_false(a.exprs[e].token ?? [U8]{})
    if v == 0 -> return false
    a.exprs[e].op = tk.TK_TRUEFALSE
    set_flags(a, e, v)
    true
}

// sqlite3ExprTruthValue: whether a TK_TRUEFALSE node is TRUE.
expr_truth_value: fn(a: AST, e0: Int) -> Bool Never! {
    e: skip_collate_and_likely(a, e0)
    (a.exprs[e].token ?? [U8]{}).len() == 4
}

// ExprAlwaysTrue / ExprAlwaysFalse (sqliteInt.h).
always_true: fn(a: AST, e: Int) -> Bool Never! { a.exprs[e].flags.bit_and(EP_OUTER_ON.bit_or(EP_IS_TRUE)) == EP_IS_TRUE }

always_false: fn(a: AST, e: Int) -> Bool Never! { a.exprs[e].flags.bit_and(EP_OUTER_ON.bit_or(EP_IS_FALSE)) == EP_IS_FALSE }

// sqlite3ExprSimplifiedAndOr.
expr_simplified_and_or: fn(a: AST, e: Int) -> Int Never! {
    op: a.exprs[e].op
    if op != tk.TK_AND && op != tk.TK_OR -> return e
    r: expr_simplified_and_or(a, a.exprs[e].right)
    l: expr_simplified_and_or(a, a.exprs[e].left)
    if always_true(a, l) || always_false(a, r) -> return if op == tk.TK_AND -> r else -> l
    if always_true(a, r) || always_false(a, l) -> return if op == tk.TK_AND -> l else -> r
    e
}

// sqlite3ExprIsInteger: the value of an integer literal that fits 32 bits,
// possibly under unary plus or minus.
expr_is_integer: fn(a: AST, e: Int) -> Int? Never! {
    if e < 0 -> return None
    if has(a, e, EP_INT_VALUE) -> return Val(a.exprs[e].ivalue)
    op: a.exprs[e].op
    if op == tk.TK_UPLUS -> return expr_is_integer(a, a.exprs[e].left)
    if op == tk.TK_UMINUS {
        v: expr_is_integer(a, a.exprs[e].left) ?? return None
        return Val(-v)
    }
    None
}

// ---------------------------------------------------------------------------
// Copies (expr.c sqlite3ExprDup and friends, window.c, upsert.c).

// exprStructSize.
expr_struct_size: fn(a: AST, e: Int) -> Int Never! {
    if has(a, e, EP_TOKEN_ONLY) -> return SIZE_TOKEN_ONLY
    if has(a, e, EP_REDUCED) -> return SIZE_REDUCED
    SIZE_FULL
}

// dupedExprStructSize: the size a copy takes.
duped_struct_size: fn(a: AST, e: Int, flags: Int) -> Int Never! {
    if flags == 0 || has(a, e, EP_FULL_SIZE) -> return SIZE_FULL
    if a.exprs[e].left >= 0 || a.exprs[e].x >= 0 -> return SIZE_REDUCED
    SIZE_TOKEN_ONLY
}

// The fields a node of `size` lacks hold their zero values.
cut_to_size: fn(n: &SQLExpr, size: Int) Never! {
    if size == SIZE_TOKEN_ONLY {
        n.left = -1
        n.right = -1
        n.x = -1
        n.height = 0
    }
    if size != SIZE_FULL {
        n.itable = 0
        n.icolumn = 0
        n.iagg = 0
        n.w = 0
        n.agg_info = -1
        n.y = -1
        n.y_reg = 0
    }
}

// exprDup: copy node `p` and its subtrees. `in_buf` is true for the
// descendants of a reduced copy, which C places in their root's allocation
// (EP_Static).
expr_dup_node: fn(a: &AST, p: Int, flags: Int, in_buf: Bool) -> Int Never! {
    src: a.exprs[p].copy()
    size: duped_struct_size(a, p, flags)
    n := src.copy()
    cut_to_size(n, if flags != 0 -> size else -> expr_struct_size(a, p))
    fl := clear_bits(n.flags, EP_REDUCED.bit_or(EP_TOKEN_ONLY).bit_or(EP_STATIC))
    if size == SIZE_REDUCED -> fl = fl.bit_or(EP_REDUCED)
    if size == SIZE_TOKEN_ONLY -> fl = fl.bit_or(EP_TOKEN_ONLY)
    if in_buf -> fl = fl.bit_or(EP_STATIC)
    n.flags = fl
    id: push_expr(a, n)
    if src.flags.bit_or(fl).bit_and(EP_TOKEN_ONLY.bit_or(EP_LEAF)) != 0 -> return id
    if src.flags.bit_and(EP_X_IS_SELECT) != 0 {
        a.exprs[id].x = select_dup(a, src.x, flags)
    } else {
        a.exprs[id].x = expr_list_dup(a, src.x, if src.op != tk.TK_ORDER -> flags else -> 0)
    }
    if src.flags.bit_and(EP_WIN_FUNC) != 0 -> a.exprs[id].y = window_dup(a, id, src.y)
    if flags != 0 {
        if src.op == tk.TK_SELECT_COLUMN {
            a.exprs[id].left = src.left
        } else {
            a.exprs[id].left = if src.left >= 0 -> expr_dup_node(a, src.left, EXPRDUP_REDUCE, true) else -> -1
        }
        a.exprs[id].right = if src.right >= 0 -> expr_dup_node(a, src.right, EXPRDUP_REDUCE, true) else -> -1
    } else {
        if src.op == tk.TK_SELECT_COLUMN {
            a.exprs[id].left = src.left
        } else {
            a.exprs[id].left = expr_dup(a, src.left, 0)
        }
        a.exprs[id].right = expr_dup(a, src.right, 0)
    }
    id
}

// sqlite3ExprDup: a deep copy; EXPRDUP_REDUCE gives the reduced copy the
// schema keeps.
expr_dup: fn(a: &AST, p: Int, flags: Int) -> Int Never! {
    if p < 0 -> return -1
    expr_dup_node(a, p, flags, false)
}

// sqlite3WithDup.
with_dup: fn(a: &AST, w: Int) -> Int Never! {
    if w < 0 -> return -1
    ids := [Int]{}
    loop c in a.withs[w].ctes.copy() {
        sel: select_dup(a, a.ctes[c].select, 0)
        cols: expr_list_dup(a, a.ctes[c].cols, 0)
        a.ctes.push(SQLCte{name: a.ctes[c].name, cols: cols, select: sel, cte_err: None, cte_use: -1, m10d: a.ctes[c].m10d})
        ids.push(a.ctes.len() - 1)
    }
    a.withs.push(SQLWith{ctes: ids, bview: false, outer: -1})
    a.withs.len() - 1
}

// gatherSelectWindows: link every window function of a copied SELECT into
// its window list.
SQLWindowGatherer: struct {
    sel: Int

    impl SQLWalker {
        walk_expr_cb: fn(&self, a: &AST, e: Int) -> Int Never! {
            if a.exprs[e].op == tk.TK_FUNCTION && has(a, e, EP_WIN_FUNC) -> window_link(a, self.sel, a.exprs[e].y)
            WRC_CONTINUE
        }
        walk_has_select_cb: fn(&self) -> Bool Never! { true }
        walk_select_cb: fn(&self, a: &AST, s: Int) -> Int Never! { if s == self.sel -> WRC_CONTINUE else -> WRC_PRUNE }
        walk_has_select_cb2: fn(&self) -> Bool Never! { false }
        walk_select_cb2: fn(&self, a: &AST, s: Int) Never! {}
        walk_win_defn: fn(&self, a: &AST) -> Bool Never! { false }
    }
}

gather_select_windows: fn(a: &AST, s: Int) Never! {
    g := SQLWindowGatherer{sel: s}
    _ := walk_select<SQLWindowGatherer>(g, a, s)
}

// sqlite3ExprListDup. A run of TK_SELECT_COLUMN items over one vector keeps
// sharing one copy of it.
expr_list_dup: fn(a: &AST, p: Int, flags: Int) -> Int Never! {
    if p < 0 -> return -1
    old: a.lists[p].items.copy()
    items := [SQLExprItem]{}
    prior_old := -1
    prior_new := -1
    loop old_item in old {
        oe: old_item.expr
        ne: expr_dup(a, oe, flags)
        if oe >= 0 && a.exprs[oe].op == tk.TK_SELECT_COLUMN && ne >= 0 {
            if a.exprs[ne].right >= 0 {
                prior_old = a.exprs[oe].right
                prior_new = a.exprs[ne].right
                a.exprs[ne].left = a.exprs[ne].right
            } else {
                if a.exprs[oe].left != prior_old {
                    prior_old = a.exprs[oe].left
                    prior_new = expr_dup(a, prior_old, flags)
                    a.exprs[ne].right = prior_new
                }
                a.exprs[ne].left = prior_new
            }
        }
        item := old_item.copy()
        item.expr = ne
        item.done = false
        items.push(item)
    }
    a.lists.push(SQLExprList{items: items})
    a.lists.len() - 1
}

// sqlite3SrcListDup.
src_list_dup: fn(a: &AST, p: Int, flags: Int) -> Int Never! {
    if p < 0 -> return -1
    ids := [Int]{}
    loop old in a.srclists[p].items.copy() {
        o: a.items[old].copy()
        n := o.copy()
        n.reg_result = 0
        if !o.is_indexed_by -> n.indexed_by = None
        if o.is_cte -> a.cte_uses[o.u2].nuse += 1
        n.func_arg = -1
        if o.tab >= 0 -> tab_ref(a, o.tab)
        a.items.push(n)
        id: a.items.len() - 1
        if o.is_tab_func -> a.items[id].func_arg = expr_list_dup(a, o.func_arg, flags)
        a.items[id].select = select_dup(a, o.select, flags)
        a.items[id].u3 = if o.is_using -> id_list_dup(a, o.u3) else -> expr_dup(a, o.u3, flags)
        ids.push(id)
    }
    n: ids.len()
    a.srclists.push(SQLSrcList{items: ids, nalloc: n})
    a.srclists.len() - 1
}

// sqlite3IdListDup.
id_list_dup: fn(a: &AST, p: Int) -> Int Never! {
    if p < 0 -> return -1
    a.idlists.push(a.idlists[p].copy())
    a.idlists.len() - 1
}

// sqlite3SelectDup: a copy of a SELECT and the compound chain before it.
select_dup: fn(a: &AST, p: Int, flags: Int) -> Int Never! {
    ret := -1
    last := -1
    cur := p
    loop cur >= 0 {
        s: a.selects[cur].copy()
        ns: new_select(a)
        a.selects[ns].elist = expr_list_dup(a, s.elist, flags)
        a.selects[ns].src = src_list_dup(a, s.src, flags)
        a.selects[ns].where_expr = expr_dup(a, s.where_expr, flags)
        a.selects[ns].group_by = expr_list_dup(a, s.group_by, flags)
        a.selects[ns].having = expr_dup(a, s.having, flags)
        a.selects[ns].order_by = expr_list_dup(a, s.order_by, flags)
        a.selects[ns].op = s.op
        a.selects[ns].next_sel = last
        a.selects[ns].prior = -1
        a.selects[ns].limit = expr_dup(a, s.limit, flags)
        a.selects[ns].sel_flags = clear_bits(s.sel_flags, SF_USES_EPHEMERAL)
        a.selects[ns].nselect_row = s.nselect_row
        a.selects[ns].with_clause = with_dup(a, s.with_clause)
        a.selects[ns].win = -1
        a.selects[ns].win_defn = window_list_dup(a, s.win_defn)
        if s.win >= 0 -> gather_select_windows(a, ns)
        a.selects[ns].sel_id = s.sel_id
        if ret < 0 {
            ret = ns
        } else {
            a.selects[last].prior = ns
        }
        last = ns
        cur = s.prior
    }
    ret
}

// sqlite3WindowDup.
window_dup: fn(a: &AST, owner: Int, p: Int) -> Int Never! {
    if p < 0 -> return -1
    w: a.windows[p].copy()
    n := new_window()
    n.name = w.name
    n.base = w.base
    n.wfunc = w.wfunc
    n.frm_type = w.frm_type
    n.end_type = w.end_type
    n.start_type = w.start_type
    n.exclude = w.exclude
    n.reg_result = w.reg_result
    n.reg_accum = w.reg_accum
    n.iarg_col = w.iarg_col
    n.eph_csr = w.eph_csr
    n.expr_args = w.expr_args
    n.owner = owner
    n.implicit_frame = w.implicit_frame
    a.windows.push(n)
    id: a.windows.len() - 1
    a.windows[id].filter = expr_dup(a, w.filter, 0)
    a.windows[id].partition = expr_list_dup(a, w.partition, 0)
    a.windows[id].order_by = expr_list_dup(a, w.order_by, 0)
    a.windows[id].start_expr = expr_dup(a, w.start_expr, 0)
    a.windows[id].end_expr = expr_dup(a, w.end_expr, 0)
    id
}

// sqlite3WindowListDup.
window_list_dup: fn(a: &AST, p: Int) -> Int Never! {
    ret := -1
    last := -1
    w := p
    loop w >= 0 {
        n: window_dup(a, -1, w)
        if ret < 0 {
            ret = n
        } else {
            a.windows[last].next_win = n
        }
        last = n
        w = a.windows[w].next_win
    }
    ret
}

// sqlite3UpsertDup.
upsert_dup: fn(a: &AST, p: Int) -> Int Never! {
    if p < 0 -> return -1
    u: a.upserts[p].copy()
    target: expr_list_dup(a, u.target, 0)
    target_where: expr_dup(a, u.target_where, 0)
    set: expr_list_dup(a, u.set, 0)
    where_expr: expr_dup(a, u.where_expr, 0)
    next_upsert: upsert_dup(a, u.next_upsert)
    upsert_new(a, target, target_where, set, where_expr, next_upsert)
}

// A FROM item takes a reference on its table (Table.nTabRef++).
tab_ref: fn(a: &AST, tab: Int) Never! { a.tab_refs[tab] = (a.tab_refs.get(tab) ?? 0) + 1 }

// sqlite3DeleteTable drops a FROM item's table reference.
tab_unref: fn(a: &AST, tab: Int) Never! { a.tab_refs[tab] = (a.tab_refs.get(tab) ?? 0) - 1 }

// ---------------------------------------------------------------------------
// Comparison (expr.c sqlite3ExprCompare, window.c sqlite3WindowCompare).

// What sqlite3ExprCompare needs of a non-NULL Parse: whether bound
// parameter `var` matches literal `e` under the bindings of the statement
// being reprepared (expr.c exprCompareVariable).
SQLVarMatch: trait {
    var_match: fn(&self, a: &AST, var: Int, e: Int) -> Bool Never!
}

// A NULL Parse: no parameter matches a literal.
SQLNoParse: struct {
    impl SQLVarMatch {
        var_match: fn(&self, a: &AST, var: Int, e: Int) -> Bool Never! { false }
    }
}

// sqlite3ExprCompare: 0 when two trees are the same, 1 when they differ only
// by a top-level COLLATE, 2 otherwise (or when it cannot tell).
expr_compare_with: fn<M: SQLVarMatch>(m: &M, a: &AST, pa: Int, pb: Int, itab: Int) -> Int Never! {
    if pa < 0 || pb < 0 -> return if pa == pb -> 0 else -> 2
    if a.exprs[pa].op == tk.TK_VARIABLE && m.var_match(a, pa, pb) -> return 0
    fa: a.exprs[pa].flags
    fb: a.exprs[pb].flags
    combined: fa.bit_or(fb)
    if combined.bit_and(EP_INT_VALUE) != 0 {
        if fa.bit_and(fb).bit_and(EP_INT_VALUE) != 0 && a.exprs[pa].ivalue == a.exprs[pb].ivalue -> return 0
        return 2
    }
    opa: a.exprs[pa].op
    opb: a.exprs[pb].op
    if opa != opb || opa == tk.TK_RAISE {
        if opa == tk.TK_COLLATE && expr_compare_with<M>(m, a, a.exprs[pa].left, pb, itab) < 2 -> return 1
        if opb == tk.TK_COLLATE && expr_compare_with<M>(m, a, pa, a.exprs[pb].left, itab) < 2 -> return 1
        if !(opa == tk.TK_AGG_COLUMN && opb == tk.TK_COLUMN && a.exprs[pb].itable < 0 && a.exprs[pa].itable == itab) -> return 2
    }
    if a.exprs[pa].token == .Val(ta) {
        tb: a.exprs[pb].token ?? [U8]{}
        if opa == tk.TK_FUNCTION || opa == tk.TK_AGG_FUNCTION {
            if str_icmp(ta, tb) != 0 -> return 2
            if has(a, pa, EP_WIN_FUNC) != has(a, pb, EP_WIN_FUNC) -> return 2
            if has(a, pa, EP_WIN_FUNC) && window_compare_with<M>(m, a, a.exprs[pa].y, a.exprs[pb].y, true) != 0 -> return 2
        } else if opa == tk.TK_NULL {
            return 0
        } else if opa == tk.TK_COLLATE {
            if str_icmp_opt(a.exprs[pa].token, a.exprs[pb].token) != 0 -> return 2
        } else if a.exprs[pb].token != None && opa != tk.TK_COLUMN && opa != tk.TK_AGG_COLUMN && str_cmp(ta, tb) != 0 {
            return 2
        }
    }
    dc: EP_DISTINCT.bit_or(EP_COMMUTED)
    if fa.bit_and(dc) != fb.bit_and(dc) -> return 2
    if combined.bit_and(EP_TOKEN_ONLY) == 0 {
        if combined.bit_and(EP_X_IS_SELECT) != 0 -> return 2
        if combined.bit_and(EP_FIXED_COL) == 0 && expr_compare_with<M>(m, a, a.exprs[pa].left, a.exprs[pb].left, itab) != 0 -> return 2
        if expr_compare_with<M>(m, a, a.exprs[pa].right, a.exprs[pb].right, itab) != 0 -> return 2
        if expr_list_compare(a, a.exprs[pa].x, a.exprs[pb].x, itab) != 0 -> return 2
        if opa != tk.TK_STRING && opa != tk.TK_TRUEFALSE && combined.bit_and(EP_REDUCED) == 0 {
            if a.exprs[pa].icolumn != a.exprs[pb].icolumn -> return 2
            if a.exprs[pa].op2 != a.exprs[pb].op2 && opa == tk.TK_TRUTH -> return 2
            if opa != tk.TK_IN && a.exprs[pa].itable != a.exprs[pb].itable && a.exprs[pa].itable != itab -> return 2
        }
    }
    0
}

// sqlite3ExprCompare with a NULL Parse.
expr_compare: fn(a: &AST, pa: Int, pb: Int, itab: Int) -> Int Never! {
    np := SQLNoParse{}
    expr_compare_with<SQLNoParse>(np, a, pa, pb, itab)
}

// sqlite3ExprListCompare: 0 identical, 1 different, 2 undetermined.
expr_list_compare: fn(a: &AST, la: Int, lb: Int, itab: Int) -> Int Never! {
    if la < 0 && lb < 0 -> return 0
    if la < 0 || lb < 0 -> return 1
    n: list_len(a, la)
    if n != list_len(a, lb) -> return 1
    loop i in 0..<n {
        if a.lists[la].items[i].sort_flags != a.lists[lb].items[i].sort_flags -> return 1
        ea: list_expr(a, la, i)
        eb: list_expr(a, lb, i)
        res: expr_compare(a, ea, eb, itab)
        if res != 0 -> return res
    }
    0
}

// sqlite3ExprCompareSkip.
expr_compare_skip: fn(a: &AST, pa: Int, pb: Int, itab: Int) -> Int Never! {
    sa: skip_collate(a, pa)
    sb: skip_collate(a, pb)
    expr_compare(a, sa, sb, itab)
}

// sqlite3WindowCompare: 0 when two windows can share one scan.
window_compare_with: fn<M: SQLVarMatch>(m: &M, a: &AST, w1: Int, w2: Int, filter: Bool) -> Int Never! {
    if w1 < 0 || w2 < 0 -> return 1
    if a.windows[w1].frm_type != a.windows[w2].frm_type -> return 1
    if a.windows[w1].start_type != a.windows[w2].start_type -> return 1
    if a.windows[w1].end_type != a.windows[w2].end_type -> return 1
    if a.windows[w1].exclude != a.windows[w2].exclude -> return 1
    if expr_compare_with<M>(m, a, a.windows[w1].start_expr, a.windows[w2].start_expr, -1) != 0 -> return 1
    if expr_compare_with<M>(m, a, a.windows[w1].end_expr, a.windows[w2].end_expr, -1) != 0 -> return 1
    r1: expr_list_compare(a, a.windows[w1].partition, a.windows[w2].partition, -1)
    if r1 != 0 -> return r1
    r2: expr_list_compare(a, a.windows[w1].order_by, a.windows[w2].order_by, -1)
    if r2 != 0 -> return r2
    if filter {
        r3: expr_compare_with<M>(m, a, a.windows[w1].filter, a.windows[w2].filter, -1)
        if r3 != 0 -> return r3
    }
    0
}

window_compare: fn(a: &AST, w1: Int, w2: Int, filter: Bool) -> Int Never! {
    np := SQLNoParse{}
    window_compare_with<SQLNoParse>(np, a, w1, w2, filter)
}

// ---------------------------------------------------------------------------
// Walking (walker.c).

// A Walker: its expression callback, its optional SELECT callbacks, and
// whether sqlite3WalkSelectExpr also walks the WINDOW definitions (when
// xSelectCallback2 is sqlite3WalkWinDefnDummyCallback or
// sqlite3SelectPopWith, or the walker's Parse is renaming).
SQLWalker: trait {
    walk_expr_cb: fn(&self, a: &AST, e: Int) -> Int Never!
    walk_has_select_cb: fn(&self) -> Bool Never!
    walk_select_cb: fn(&self, a: &AST, s: Int) -> Int Never!
    walk_has_select_cb2: fn(&self) -> Bool Never!
    walk_select_cb2: fn(&self, a: &AST, s: Int) Never!
    walk_win_defn: fn(&self, a: &AST) -> Bool Never!
}

// walkWindowList.
walk_window_list: fn<W: SQLWalker>(w: &W, a: &AST, list: Int, one_only: Bool) -> Int Never! {
    win := list
    loop win >= 0 {
        if walk_expr_list<W>(w, a, a.windows[win].order_by) != 0 -> return WRC_ABORT
        if walk_expr_list<W>(w, a, a.windows[win].partition) != 0 -> return WRC_ABORT
        if walk_expr<W>(w, a, a.windows[win].filter) != 0 -> return WRC_ABORT
        if walk_expr<W>(w, a, a.windows[win].start_expr) != 0 -> return WRC_ABORT
        if walk_expr<W>(w, a, a.windows[win].end_expr) != 0 -> return WRC_ABORT
        if one_only -> break
        win = a.windows[win].next_win
    }
    WRC_CONTINUE
}

// sqlite3WalkExpr: call the expression callback on each node, parents
// before children.
walk_expr: fn<W: SQLWalker>(w: &W, a: &AST, e0: Int) -> Int Never! {
    if e0 < 0 -> return WRC_CONTINUE
    e := e0
    loop {
        rc: w.walk_expr_cb(a, e)
        if rc != 0 -> return rc.bit_and(WRC_ABORT)
        if !has(a, e, EP_TOKEN_ONLY.bit_or(EP_LEAF)) {
            if a.exprs[e].left >= 0 && walk_expr<W>(w, a, a.exprs[e].left) != 0 -> return WRC_ABORT
            if a.exprs[e].right >= 0 {
                e = a.exprs[e].right
                next
            } else if has(a, e, EP_X_IS_SELECT) {
                if walk_select<W>(w, a, a.exprs[e].x) != 0 -> return WRC_ABORT
            } else {
                if a.exprs[e].x >= 0 && walk_expr_list<W>(w, a, a.exprs[e].x) != 0 -> return WRC_ABORT
                if has(a, e, EP_WIN_FUNC) && walk_window_list<W>(w, a, a.exprs[e].y, true) != 0 -> return WRC_ABORT
            }
        }
        break
    }
    WRC_CONTINUE
}

// sqlite3WalkExprList.
walk_expr_list: fn<W: SQLWalker>(w: &W, a: &AST, list: Int) -> Int Never! {
    loop i in 0..<list_len(a, list) {
        e: list_expr(a, list, i)
        if walk_expr<W>(w, a, e) != 0 -> return WRC_ABORT
    }
    WRC_CONTINUE
}

// sqlite3WalkSelectExpr: the expressions of one SELECT.
walk_select_expr: fn<W: SQLWalker>(w: &W, a: &AST, s: Int) -> Int Never! {
    if walk_expr_list<W>(w, a, a.selects[s].elist) != 0 -> return WRC_ABORT
    if walk_expr<W>(w, a, a.selects[s].where_expr) != 0 -> return WRC_ABORT
    if walk_expr_list<W>(w, a, a.selects[s].group_by) != 0 -> return WRC_ABORT
    if walk_expr<W>(w, a, a.selects[s].having) != 0 -> return WRC_ABORT
    if walk_expr_list<W>(w, a, a.selects[s].order_by) != 0 -> return WRC_ABORT
    if walk_expr<W>(w, a, a.selects[s].limit) != 0 -> return WRC_ABORT
    if a.selects[s].win_defn >= 0 && w.walk_win_defn(a) -> return walk_window_list<W>(w, a, a.selects[s].win_defn, false)
    WRC_CONTINUE
}

// sqlite3WalkSelectFrom: the subqueries and table-function arguments of a
// FROM clause.
walk_select_from: fn<W: SQLWalker>(w: &W, a: &AST, s: Int) -> Int Never! {
    src: a.selects[s].src
    if src < 0 -> return WRC_CONTINUE
    loop i in 0..<a.srclists[src].items.len() {
        si: a.srclists[src].items[i]
        if a.items[si].select >= 0 && walk_select<W>(w, a, a.items[si].select) != 0 -> return WRC_ABORT
        if a.items[si].is_tab_func && walk_expr_list<W>(w, a, a.items[si].func_arg) != 0 -> return WRC_ABORT
    }
    WRC_CONTINUE
}

// sqlite3WalkSelect: a SELECT and the compound chain before it; a no-op
// for a walker without a SELECT callback.
walk_select: fn<W: SQLWalker>(w: &W, a: &AST, s0: Int) -> Int Never! {
    if s0 < 0 -> return WRC_CONTINUE
    if !w.walk_has_select_cb() -> return WRC_CONTINUE
    s := s0
    loop s >= 0 {
        rc: w.walk_select_cb(a, s)
        if rc != 0 -> return rc.bit_and(WRC_ABORT)
        if walk_select_expr<W>(w, a, s) != 0 || walk_select_from<W>(w, a, s) != 0 -> return WRC_ABORT
        if w.walk_has_select_cb2() -> w.walk_select_cb2(a, s)
        s = a.selects[s].prior
    }
    WRC_CONTINUE
}

// ---------------------------------------------------------------------------
// Constant expressions (expr.c exprNodeIsConstant and exprIsConst): `code`
// is Walker.eCode, 1 constant, 2 constant outside ON clauses, 3 constant
// for table cursor `cur`, 4 or 5 constant or function (5 while reading the
// schema).
SQLConstWalker: struct {
    code: Int
    cur: Int

    impl SQLWalker {
        walk_expr_cb: fn(&self, a: &AST, e: Int) -> Int Never! {
            if self.code == 2 && has(a, e, EP_OUTER_ON) {
                self.code = 0
                return WRC_ABORT
            }
            op: a.exprs[e].op
            if op == tk.TK_FUNCTION {
                if (self.code >= 4 || has(a, e, EP_CONST_FUNC)) && !has(a, e, EP_WIN_FUNC) {
                    if self.code == 5 -> set_flags(a, e, EP_FROM_DDL)
                    return WRC_CONTINUE
                }
                self.code = 0
                return WRC_ABORT
            }
            if op == tk.TK_ID && expr_id_to_true_false(a, e) -> return WRC_PRUNE
            if op == tk.TK_ID || op == tk.TK_COLUMN || op == tk.TK_AGG_FUNCTION || op == tk.TK_AGG_COLUMN {
                if has(a, e, EP_FIXED_COL) && self.code != 2 -> return WRC_CONTINUE
                if self.code == 3 && a.exprs[e].itable == self.cur -> return WRC_CONTINUE
                self.code = 0
                return WRC_ABORT
            }
            if op == tk.TK_IF_NULL_ROW || op == tk.TK_REGISTER || op == tk.TK_DOT {
                self.code = 0
                return WRC_ABORT
            }
            if op == tk.TK_VARIABLE {
                if self.code == 5 {
                    a.exprs[e].op = tk.TK_NULL
                } else if self.code == 4 {
                    self.code = 0
                    return WRC_ABORT
                }
            }
            WRC_CONTINUE
        }
        // sqlite3SelectWalkFail.
        walk_has_select_cb: fn(&self) -> Bool Never! { true }
        walk_select_cb: fn(&self, a: &AST, s: Int) -> Int Never! {
            self.code = 0
            WRC_ABORT
        }
        walk_has_select_cb2: fn(&self) -> Bool Never! { false }
        walk_select_cb2: fn(&self, a: &AST, s: Int) Never! {}
        walk_win_defn: fn(&self, a: &AST) -> Bool Never! { false }
    }
}

expr_is_const: fn(a: &AST, e: Int, init: Int, cur: Int) -> Int Never! {
    w := SQLConstWalker{code: init, cur: cur}
    _ := walk_expr<SQLConstWalker>(w, a, e)
    w.code
}

// sqlite3ExprIsConstant.
expr_is_constant: fn(a: &AST, e: Int) -> Bool Never! { expr_is_const(a, e, 1, 0) != 0 }

// sqlite3ExprIsConstantNotJoin.
expr_is_constant_not_join: fn(a: &AST, e: Int) -> Bool Never! { expr_is_const(a, e, 2, 0) != 0 }

// sqlite3ExprIsTableConstant.
expr_is_table_constant: fn(a: &AST, e: Int, cur: Int) -> Bool Never! { expr_is_const(a, e, 3, cur) != 0 }

// sqlite3ExprIsConstantOrFunction.
expr_is_constant_or_function: fn(a: &AST, e: Int, is_init: Bool) -> Bool Never! {
    expr_is_const(a, e, if is_init -> 5 else -> 4, 0) != 0
}

// ---------------------------------------------------------------------------
// SELECT (select.c).

new_select: fn(a: &AST) -> Int Never! {
    a.selects.push(SQLSelect{op: tk.TK_SELECT, nselect_row: 0, sel_flags: 0, ilimit: 0, ioffset: 0, sel_id: 0, addr_open_ephm0: -1, addr_open_ephm1: -1, elist: -1, src: -1, where_expr: -1, group_by: -1, having: -1, order_by: -1, prior: -1, next_sel: -1, limit: -1, with_clause: -1, win: -1, win_defn: -1})
    a.selects.len() - 1
}

// sqlite3SelectNew: a SELECT; no result list means "*", no FROM clause an
// empty one.
select_new: fn(a: &AST, elist0: Int, src0: Int, where_expr: Int, group_by: Int, having: Int, order_by: Int, flags: Int, limit: Int) -> Int Never! {
    elist := elist0
    if elist < 0 {
        star: expr(a, tk.TK_ASTERISK, [U8]{})
        elist = expr_list_append(a, -1, star)
    }
    src := src0
    if src < 0 -> src = new_src_list(a)
    s: new_select(a)
    a.ctx.nselect += 1
    a.selects[s].elist = elist
    a.selects[s].sel_flags = flags
    a.selects[s].sel_id = a.ctx.nselect
    a.selects[s].src = src
    a.selects[s].where_expr = where_expr
    a.selects[s].group_by = group_by
    a.selects[s].having = having
    a.selects[s].order_by = order_by
    a.selects[s].limit = limit
    s
}

// clearSelect: the side effects of deleting a SELECT and its compound chain.
select_delete: fn(a: &AST, s0: Int) Never! {
    s := s0
    loop s >= 0 {
        expr_list_delete(a, a.selects[s].elist)
        src_list_delete(a, a.selects[s].src)
        expr_delete(a, a.selects[s].where_expr)
        expr_list_delete(a, a.selects[s].group_by)
        expr_delete(a, a.selects[s].having)
        expr_list_delete(a, a.selects[s].order_by)
        expr_delete(a, a.selects[s].limit)
        with_delete(a, a.selects[s].with_clause)
        window_list_delete(a, a.selects[s].win_defn)
        loop a.selects[s].win >= 0 -> window_unlink_from_select(a, a.selects[s].win)
        s = a.selects[s].prior
    }
}

// sqlite3SelectOpName.
select_op_name: fn(op: Int) -> String Never! {
    if op == tk.TK_ALL -> return "UNION ALL"
    if op == tk.TK_INTERSECT -> return "INTERSECT"
    if op == tk.TK_EXCEPT -> return "EXCEPT"
    "UNION"
}

// Whether a token spells keyword `kw` in any letter case.
tok_is: fn(a: AST, t: SQLTok, kw: [U8]) -> Bool Never! {
    if t.n != kw.len() -> return false
    loop i in 0..<t.n {
        if lower_byte(sql_byte(a.ctx.sql, t.z + i)) != (Int{kw[i]}) -> return false
    }
    true
}

// sqlite3JoinType: the JT_* mask of the one to three words before JOIN;
// `pb` and `pc` have z -1 when absent.
join_type: fn(a: &AST, pa: SQLTok, pb: SQLTok, pc: SQLTok) -> Int Never! {
    words: [String]{"natural", "left", "outer", "right", "full", "inner", "cross"}
    codes: [Int]{JT_NATURAL, JT_LEFT.bit_or(JT_OUTER), JT_OUTER, JT_RIGHT.bit_or(JT_OUTER), JT_LEFT.bit_or(JT_RIGHT).bit_or(JT_OUTER), JT_INNER, JT_INNER.bit_or(JT_CROSS)}
    all: [SQLTok]{pa, pb, pc}
    jt := 0
    loop i in 0..<3 {
        if all[i].z < 0 -> break
        j := 0
        loop j < 7 {
            if tok_is(a, all[i], words[j].bytes()) {
                jt = jt.bit_or(codes[j])
                break
            }
            j += 1
        }
        if j >= 7 {
            jt = jt.bit_or(JT_ERROR)
            break
        }
    }
    if jt.bit_and(JT_INNER.bit_or(JT_OUTER)) == JT_INNER.bit_or(JT_OUTER) || jt.bit_and(JT_ERROR) != 0 || jt.bit_and(JT_OUTER.bit_or(JT_LEFT).bit_or(JT_RIGHT)) == JT_OUTER {
        sp1: if pb.z < 0 -> "" else -> " "
        sp2: if pc.z < 0 -> "" else -> " "
        ta: tok_text(a, pa)
        tb: tok_text(a, pb)
        tc: tok_text(a, pc)
        off := tok_offset(a, pa)
        if off < 0 -> off = tok_offset(a, pb)
        if off < 0 -> off = tok_offset(a, pc)
        error_at(a, "unknown join type: {ta}{sp1}{tb}{sp2}{tc}", off)
        jt = JT_INNER
    }
    jt
}

// ---------------------------------------------------------------------------
// FROM clauses and identifier lists (build.c).

new_src_item: fn() -> SQLSrcItem Never! {
    SQLSrcItem{schema: -1, database: None, name: None, alias: None, tab: -1, select: -1, addr_fill_sub: 0, reg_return: 0, reg_result: 0, jointype: 0, not_indexed: false, is_indexed_by: false, is_tab_func: false, is_correlated: false, is_materialized: false, via_coroutine: false, is_recursive: false, from_ddl: false, is_cte: false, not_cte: false, is_using: false, is_on: false, is_synth_using: false, is_nested_from: false, cursor: -1, u3: -1, col_used: 0, indexed_by: None, func_arg: -1, u2: -1}
}

new_src_list: fn(a: &AST) -> Int Never! {
    a.srclists.push(SQLSrcList{items: [Int]{}, nalloc: 0})
    a.srclists.len() - 1
}

src_len: fn(a: AST, s: Int) -> Int Never! {
    if s < 0 -> return 0
    a.srclists[s].items.len()
}

src_item: fn(a: AST, s: Int, i: Int) -> Int Never! { a.srclists[s].items[i] }

// sqlite3SrcListEnlarge: insert `nextra` empty items at `istart`; false,
// with the error, once the list would reach SQLITE_MAX_SRCLIST.
src_list_enlarge: fn(a: &AST, s: Int, nextra: Int, istart: Int) -> Bool Never! {
    n: a.srclists[s].items.len()
    if n + nextra > a.srclists[s].nalloc {
        if n + nextra >= MAX_SRCLIST {
            error(a, "too many FROM clause terms, max: {MAX_SRCLIST}")
            return false
        }
        nalloc := 2 * n + nextra
        if nalloc > MAX_SRCLIST -> nalloc = MAX_SRCLIST
        a.srclists[s].nalloc = nalloc
    }
    old: a.srclists[s].items.copy()
    items := [Int]{}
    loop i in 0..<istart -> items.push(old[i])
    loop _k in 0..<nextra {
        a.items.push(new_src_item())
        items.push(a.items.len() - 1)
    }
    loop i in istart..<n -> items.push(old[i])
    a.srclists[s].items = items
    true
}

// sqlite3SrcListAppend: append a table named by the tokens `table` and
// `database` (C token pointers; a database with a NULL z counts as none).
// -1 when the list cannot grow.
src_list_append: fn(a: &AST, list: Int, table: [U8]?, database: [U8]?) -> Int Never! {
    s := list
    if s < 0 {
        s = new_src_list(a)
        a.srclists[s].nalloc = 1
        a.items.push(new_src_item())
        a.srclists[s].items.push(a.items.len() - 1)
    } else if !src_list_enlarge(a, s, 1, a.srclists[s].items.len()) {
        src_list_delete(a, s)
        return -1
    }
    si: a.srclists[s].items[a.srclists[s].items.len() - 1]
    if database != None {
        a.items[si].name = name_from(database)
        a.items[si].database = name_from(table)
    } else {
        a.items[si].name = name_from(table)
        a.items[si].database = None
    }
    s
}

// sqlite3SrcListAssignCursors: number the cursors of a FROM clause and of
// its subqueries' (`ntab` is Parse.nTab; returns the new value).
src_list_assign_cursors: fn(a: &AST, s: Int, ntab0: Int) -> Int Never! {
    ntab := ntab0
    loop i in 0..<src_len(a, s) {
        si: src_item(a, s, i)
        if a.items[si].cursor >= 0 -> next
        a.items[si].cursor = ntab
        ntab += 1
        if a.items[si].select >= 0 -> ntab = src_list_assign_cursors(a, a.selects[a.items[si].select].src, ntab)
    }
    ntab
}

// sqlite3SrcListDelete.
src_list_delete: fn(a: &AST, s: Int) Never! {
    loop i in 0..<src_len(a, s) {
        si: src_item(a, s, i)
        if a.items[si].is_tab_func -> expr_list_delete(a, a.items[si].func_arg)
        if a.items[si].tab >= 0 -> tab_unref(a, a.items[si].tab)
        select_delete(a, a.items[si].select)
        if !a.items[si].is_using -> expr_delete(a, a.items[si].u3)
    }
}

// sqlite3SrcListAppendFromTerm: append a FROM term. `alias` is the AS
// token's bytes (empty for none); `on` and `using` are its ON expression or
// USING list, -1 when absent.
src_list_append_from_term: fn(a: &AST, p: Int, table: [U8]?, database: [U8]?, alias: [U8], sub: Int, on: Int, using: Int) -> Int Never! {
    if p < 0 && (on >= 0 || using >= 0) {
        what: if on >= 0 -> "ON" else -> "USING"
        error(a, "a JOIN clause is required before {what}")
        clear_on_or_using(a, on, using)
        select_delete(a, sub)
        return -1
    }
    s: src_list_append(a, p, table, database)
    if s < 0 {
        clear_on_or_using(a, on, using)
        select_delete(a, sub)
        return -1
    }
    si: a.srclists[s].items[a.srclists[s].items.len() - 1]
    if alias.len() > 0 -> a.items[si].alias = Val(dequote(alias))
    if sub >= 0 {
        a.items[si].select = sub
        if a.selects[sub].sel_flags.bit_and(SF_NESTED_FROM) != 0 -> a.items[si].is_nested_from = true
    }
    if using >= 0 {
        a.items[si].is_using = true
        a.items[si].u3 = using
    } else {
        a.items[si].u3 = on
    }
    s
}

// sqlite3SrcListIndexedBy: the INDEXED BY name or NOT INDEXED of the last
// item.
src_list_indexed_by: fn(a: &AST, s: Int, t: SQLTok) Never! {
    if s < 0 || t.n <= 0 -> return
    si: a.srclists[s].items[a.srclists[s].items.len() - 1]
    if t.n == 1 && t.z < 0 {
        a.items[si].not_indexed = true
    } else {
        a.items[si].indexed_by = name_from(tok_opt(a, t))
        a.items[si].is_indexed_by = true
    }
}

// sqlite3SrcListAppendList: append FROM list `p2` after the single item of
// `p1`.
src_list_append_list: fn(a: &AST, p1: Int, p2: Int) -> Int Never! {
    if p2 < 0 -> return p1
    n2: a.srclists[p2].items.len()
    if !src_list_enlarge(a, p1, n2, 1) {
        src_list_delete(a, p2)
        return p1
    }
    loop i in 0..<n2 -> a.srclists[p1].items[1 + i] = a.srclists[p2].items[i]
    first: a.srclists[p1].items[0]
    second: a.srclists[p1].items[1]
    a.items[first].jointype = a.items[first].jointype.bit_or(JT_LTORJ.bit_and(a.items[second].jointype))
    p1
}

// sqlite3SrcListFuncArgs: the arguments of a table-valued function.
src_list_func_args: fn(a: &AST, s: Int, list: Int) Never! {
    if s < 0 {
        expr_list_delete(a, list)
        return
    }
    si: a.srclists[s].items[a.srclists[s].items.len() - 1]
    a.items[si].func_arg = list
    a.items[si].is_tab_func = true
}

// sqlite3SrcListShiftJoinType: move each join operator from its left
// operand to its right one, and tag every table left of the last RIGHT JOIN
// with JT_LTORJ.
src_list_shift_join_type: fn(a: &AST, s: Int) Never! {
    n: src_len(a, s)
    if n <= 1 -> return
    all := 0
    i := n - 1
    loop i > 0 {
        jt: a.items[src_item(a, s, i - 1)].jointype
        a.items[src_item(a, s, i)].jointype = jt
        all = all.bit_or(jt)
        i -= 1
    }
    a.items[src_item(a, s, 0)].jointype = 0
    if all.bit_and(JT_RIGHT) != 0 {
        i = n - 1
        loop i > 0 && a.items[src_item(a, s, i)].jointype.bit_and(JT_RIGHT) == 0 -> i -= 1
        i -= 1
        loop i >= 0 {
            si: src_item(a, s, i)
            a.items[si].jointype = a.items[si].jointype.bit_or(JT_LTORJ)
            i -= 1
        }
    }
}

new_id_list: fn(a: &AST) -> Int Never! {
    a.idlists.push(SQLIDList{items: [SQLIDItem]{}, eu4: EU4_NONE})
    a.idlists.len() - 1
}

// sqlite3IdListAppend: append the name a token (a C token pointer) spells.
id_list_append: fn(a: &AST, list: Int, name: [U8]?) -> Int Never! {
    l := list
    if l < 0 -> l = new_id_list(a)
    a.idlists[l].items.push(SQLIDItem{name: name_from(name), u4: 0})
    l
}

// sqlite3IdListIndex: the position of `name` in the list, -1 if absent.
id_list_index: fn(a: AST, list: Int, name: [U8]) -> Int Never! {
    loop i in 0..<a.idlists[list].items.len() {
        if str_icmp(a.idlists[list].items[i].name ?? [U8]{}, name) == 0 -> return i
    }
    -1
}

// sqlite3HasExplicitNulls: an error, and true, when a list item has NULLS
// FIRST or LAST.
has_explicit_nulls: fn(a: &AST, list: Int) -> Bool Never! {
    loop i in 0..<list_len(a, list) {
        if a.lists[list].items[i].nulls {
            sf: a.lists[list].items[i].sort_flags
            which: if sf == 0 || sf == 3 -> "FIRST" else -> "LAST"
            error(a, "unsupported use of NULLS {which}")
            return true
        }
    }
    false
}

// ---------------------------------------------------------------------------
// Common table expressions (build.c).

// sqlite3CteNew.
cte_new: fn(a: &AST, name: [U8]?, cols: Int, sel: Int, m10d: Int) -> Int Never! {
    a.ctes.push(SQLCte{name: name_from(name), cols: cols, select: sel, cte_err: None, cte_use: -1, m10d: m10d})
    a.ctes.len() - 1
}

// sqlite3WithAdd: add a CTE to a WITH clause, which is created if `w` is -1;
// a name already in the clause is an error.
with_add: fn(a: &AST, w: Int, cte: Int) -> Int Never! {
    if cte < 0 -> return w
    if a.ctes[cte].name == .Val(name) && w >= 0 {
        loop c in a.withs[w].ctes.copy() {
            if str_icmp(name, a.ctes[c].name ?? [U8]{}) == 0 {
                t: text(name)
                error(a, "duplicate WITH table name: {t}")
            }
        }
    }
    if w >= 0 {
        a.withs[w].ctes.push(cte)
        return w
    }
    a.withs.push(SQLWith{ctes: [Int]{cte}, bview: false, outer: -1})
    a.withs.len() - 1
}

// sqlite3WithDelete.
with_delete: fn(a: &AST, w: Int) Never! {
    if w < 0 -> return
    loop c in a.withs[w].ctes.copy() {
        expr_list_delete(a, a.ctes[c].cols)
        select_delete(a, a.ctes[c].select)
    }
}

// sqlite3WithPush (select.c): make WITH clause `w` the innermost in scope,
// unless the statement already has an error. (bFree's cleanup registration
// has nothing to do here: the arena owns every object.)
with_push: fn(a: &AST, w: Int) Never! {
    if w < 0 || a.ctx.nerr > 0 -> return
    a.withs[w].outer = a.ctx.cur_with
    a.ctx.cur_with = w
}

// ---------------------------------------------------------------------------
// Windows (window.c).

new_window: fn() -> SQLWindow Never! {
    SQLWindow{name: None, base: None, partition: -1, order_by: -1, frm_type: 0, start_type: 0, end_type: 0, implicit_frame: false, exclude: 0, start_expr: -1, end_expr: -1, this_kind: THIS_NONE, this_ref: -1, next_win: -1, filter: -1, wfunc: -1, eph_csr: 0, reg_accum: 0, reg_result: 0, csr_app: 0, reg_app: 0, reg_part: 0, owner: -1, nbuffer_col: 0, iarg_col: 0, reg_one: 0, reg_start_rowid: 0, reg_end_rowid: 0, expr_args: false}
}

// sqlite3WindowUnlinkFromSelect.
window_unlink_from_select: fn(a: &AST, w: Int) Never! {
    kind: a.windows[w].this_kind
    if kind == THIS_NONE -> return
    nxt: a.windows[w].next_win
    if kind == THIS_SELECT {
        a.selects[a.windows[w].this_ref].win = nxt
    } else {
        a.windows[a.windows[w].this_ref].next_win = nxt
    }
    if nxt >= 0 {
        a.windows[nxt].this_kind = kind
        a.windows[nxt].this_ref = a.windows[w].this_ref
    }
    a.windows[w].this_kind = THIS_NONE
    a.windows[w].this_ref = -1
}

// sqlite3WindowDelete.
window_delete: fn(a: &AST, w: Int) Never! {
    if w < 0 -> return
    window_unlink_from_select(a, w)
    expr_delete(a, a.windows[w].filter)
    expr_list_delete(a, a.windows[w].partition)
    expr_list_delete(a, a.windows[w].order_by)
    expr_delete(a, a.windows[w].end_expr)
    expr_delete(a, a.windows[w].start_expr)
}

// sqlite3WindowListDelete.
window_list_delete: fn(a: &AST, w0: Int) Never! {
    w := w0
    loop w >= 0 {
        nxt: a.windows[w].next_win
        window_delete(a, w)
        w = nxt
    }
}

// sqlite3WindowOffsetExpr: a PRECEDING or FOLLOWING offset that is not
// constant becomes NULL.
window_offset_expr: fn(a: &AST, e: Int) -> Int Never! {
    if expr_is_constant(a, e) -> return e
    expr_delete(a, e)
    expr_alloc(a, tk.TK_NULL, None, false)
}

// sqlite3WindowAlloc: a window frame. `frm_type` 0 is the implicit RANGE
// frame; -1 on an unsupported frame.
window_alloc: fn(a: &AST, frm_type: Int, start_type: Int, start_expr: Int, end_type: Int, end_expr: Int, exclude0: Int) -> Int Never! {
    implicit: frm_type == 0
    ft: if implicit -> tk.TK_RANGE else -> frm_type
    if (start_type == tk.TK_CURRENT && end_type == tk.TK_PRECEDING) || (start_type == tk.TK_FOLLOWING && (end_type == tk.TK_PRECEDING || end_type == tk.TK_CURRENT)) {
        error(a, "unsupported frame specification")
        expr_delete(a, end_expr)
        expr_delete(a, start_expr)
        return -1
    }
    w := new_window()
    w.frm_type = ft
    w.start_type = start_type
    w.end_type = end_type
    exclude := exclude0
    if exclude == 0 && a.opt_flags.bit_and(OPT_WINDOW_FUNC) != 0 -> exclude = tk.TK_NO
    w.exclude = exclude
    w.implicit_frame = implicit
    a.windows.push(w)
    id: a.windows.len() - 1
    a.windows[id].end_expr = window_offset_expr(a, end_expr)
    a.windows[id].start_expr = window_offset_expr(a, start_expr)
    id
}

// sqlite3WindowAssemble: attach PARTITION BY and ORDER BY, and the name of
// the base window (copied as written).
window_assemble: fn(a: &AST, w: Int, partition: Int, order_by: Int, base_name: [U8]?) -> Int Never! {
    if w < 0 {
        expr_list_delete(a, partition)
        expr_list_delete(a, order_by)
        return -1
    }
    a.windows[w].partition = partition
    a.windows[w].order_by = order_by
    if base_name != None -> a.windows[w].base = base_name
    w
}

// windowFind: the window named `name` in a WINDOW list, else an error and -1.
window_find: fn(a: &AST, list: Int, name: [U8]) -> Int Never! {
    w := list
    loop w >= 0 {
        if str_icmp(a.windows[w].name ?? [U8]{}, name) == 0 -> return w
        w = a.windows[w].next_win
    }
    t: text(name)
    error(a, "no such window: {t}")
    return -1
}

// sqlite3WindowChain: complete a WINDOW-clause window from the earlier one
// it names as its base.
window_chain: fn(a: &AST, w: Int, list: Int) Never! {
    base_name: a.windows[w].base ?? return
    ex: window_find(a, list, base_name)
    if ex < 0 -> return
    err := ""
    if a.windows[w].partition >= 0 {
        err = "PARTITION clause"
    } else if a.windows[ex].order_by >= 0 && a.windows[w].order_by >= 0 {
        err = "ORDER BY clause"
    } else if !a.windows[ex].implicit_frame {
        err = "frame specification"
    }
    if err != "" {
        t: text(base_name)
        error(a, "cannot override {err} of window: {t}")
        return
    }
    a.windows[w].partition = expr_list_dup(a, a.windows[ex].partition, 0)
    if a.windows[ex].order_by >= 0 -> a.windows[w].order_by = expr_list_dup(a, a.windows[ex].order_by, 0)
    a.windows[w].base = None
}

// sqlite3WindowAttach: make window `w` the OVER clause of function `e`.
window_attach: fn(a: &AST, e: Int, w: Int) Never! {
    if e < 0 {
        window_delete(a, w)
        return
    }
    a.exprs[e].y = w
    set_flags(a, e, EP_WIN_FUNC.bit_or(EP_FULL_SIZE))
    a.windows[w].owner = e
    if has(a, e, EP_DISTINCT) && a.windows[w].frm_type != tk.TK_FILTER -> error(a, "DISTINCT is not supported for window functions")
}

// sqlite3WindowLink: add a window to the SELECT's list when the list is
// empty or its windows share this one's frame; otherwise note that the
// SELECT partitions more than one way.
window_link: fn(a: &AST, sel: Int, w: Int) Never! {
    if sel < 0 -> return
    head: a.selects[sel].win
    if head < 0 || window_compare(a, head, w, false) == 0 {
        a.windows[w].next_win = head
        if head >= 0 {
            a.windows[head].this_kind = THIS_WINDOW
            a.windows[head].this_ref = w
        }
        a.selects[sel].win = w
        a.windows[w].this_kind = THIS_SELECT
        a.windows[w].this_ref = sel
    } else if expr_list_compare(a, a.windows[w].partition, a.windows[head].partition, -1) != 0 {
        a.selects[sel].sel_flags = a.selects[sel].sel_flags.bit_or(SF_MULTI_PART)
    }
}

// ---------------------------------------------------------------------------
// Upserts (upsert.c) and trigger steps (trigger.c).

// sqlite3UpsertNew.
upsert_new: fn(a: &AST, target: Int, target_where: Int, set: Int, where_expr: Int, next_upsert: Int) -> Int Never! {
    a.upserts.push(SQLUpsert{target: target, target_where: target_where, set: set, where_expr: where_expr, next_upsert: next_upsert, do_update: set >= 0, is_dup: false, idx: -1, src: -1, reg_data: 0, data_cur: 0, idx_cur: 0})
    a.upserts.len() - 1
}

// sqlite3UpsertDelete.
upsert_delete: fn(a: &AST, u0: Int) Never! {
    u := u0
    loop u >= 0 {
        expr_list_delete(a, a.upserts[u].target)
        expr_delete(a, a.upserts[u].target_where)
        expr_list_delete(a, a.upserts[u].set)
        expr_delete(a, a.upserts[u].where_expr)
        u = a.upserts[u].next_upsert
    }
}

// triggerSpanDup: the step's text with every whitespace byte a space.
trigger_span_dup: fn(a: AST, start: Int, end: Int) -> [U8] Never! {
    z := span_dup(a, start, end)
    loop i in 0..<z.len() {
        if is_space(Int{z[i]}) -> z[i] = (U8{32})
    }
    z
}

new_step: fn(op: Int) -> SQLTriggerStep Never! {
    SQLTriggerStep{op: op, orconf: 0, trig: -1, select: -1, target: None, from: -1, where_expr: -1, elist: -1, idlist: -1, upsert: -1, span: None, next_step: -1, last_step: -1}
}

// sqlite3TriggerSelectStep.
trigger_select_step: fn(a: &AST, sel: Int, start: Int, end: Int) -> Int Never! {
    s := new_step(tk.TK_SELECT)
    s.select = sel
    s.orconf = OE_DEFAULT
    s.span = Val(trigger_span_dup(a, start, end))
    a.steps.push(s)
    a.steps.len() - 1
}

// triggerStepAllocate: -1 once the statement has an error.
trigger_step_allocate: fn(a: &AST, op: Int, name: [U8], start: Int, end: Int) -> Int Never! {
    if a.ctx.nerr > 0 -> return -1
    s := new_step(op)
    s.target = Val(dequote(name))
    s.span = Val(trigger_span_dup(a, start, end))
    a.steps.push(s)
    a.steps.len() - 1
}

// sqlite3TriggerInsertStep.
trigger_insert_step: fn(a: &AST, name: [U8], cols: Int, sel0: Int, orconf: Int, upsert: Int, start: Int, end: Int) -> Int Never! {
    sel := sel0
    s: trigger_step_allocate(a, tk.TK_INSERT, name, start, end)
    if s >= 0 {
        if in_rename(a) {
            a.steps[s].select = sel
            sel = -1
        } else {
            a.steps[s].select = select_dup(a, sel, EXPRDUP_REDUCE)
        }
        a.steps[s].idlist = cols
        a.steps[s].upsert = upsert
        a.steps[s].orconf = orconf
        if upsert >= 0 -> _ := has_explicit_nulls(a, a.upserts[upsert].target)
    } else {
        upsert_delete(a, upsert)
    }
    select_delete(a, sel)
    s
}

// sqlite3TriggerUpdateStep.
trigger_update_step: fn(a: &AST, name: [U8], from0: Int, elist0: Int, where0: Int, orconf: Int, start: Int, end: Int) -> Int Never! {
    from := from0
    elist := elist0
    where_expr := where0
    s: trigger_step_allocate(a, tk.TK_UPDATE, name, start, end)
    if s >= 0 {
        if in_rename(a) {
            a.steps[s].elist = elist
            a.steps[s].where_expr = where_expr
            a.steps[s].from = from
            elist = -1
            where_expr = -1
            from = -1
        } else {
            a.steps[s].elist = expr_list_dup(a, elist, EXPRDUP_REDUCE)
            a.steps[s].where_expr = expr_dup(a, where_expr, EXPRDUP_REDUCE)
            a.steps[s].from = src_list_dup(a, from, EXPRDUP_REDUCE)
        }
        a.steps[s].orconf = orconf
    }
    expr_list_delete(a, elist)
    expr_delete(a, where_expr)
    src_list_delete(a, from)
    s
}

// sqlite3TriggerDeleteStep.
trigger_delete_step: fn(a: &AST, name: [U8], where0: Int, start: Int, end: Int) -> Int Never! {
    where_expr := where0
    s: trigger_step_allocate(a, tk.TK_DELETE, name, start, end)
    if s >= 0 {
        if in_rename(a) {
            a.steps[s].where_expr = where_expr
            where_expr = -1
        } else {
            a.steps[s].where_expr = expr_dup(a, where_expr, EXPRDUP_REDUCE)
        }
        a.steps[s].orconf = OE_DEFAULT
    }
    expr_delete(a, where_expr)
    s
}

// ---------------------------------------------------------------------------

stmt_ast: fn(sql: String) -> AST Never! {
    a := new_ast()
    begin_statement(a, sql.bytes())
    a
}

tok_of: fn(a: AST, word: String) -> SQLTok Never! {
    w: word.bytes()
    loop i in 0..<a.ctx.sql.len() - w.len() + 1 {
        if a.ctx.sql[i..<i + w.len()].copy() == w -> return SQLTok{z: i, n: w.len()}
    }
    SQLTok{z: -1, n: 0}
}

#Test("integer tokens become int-value leaves") {
    a := stmt_ast("")
    one: expr(a, tk.TK_INTEGER, "1".bytes())
    assert(has(a, one, EP_INT_VALUE) && has(a, one, EP_IS_TRUE) && has(a, one, EP_LEAF))
    zero: expr(a, tk.TK_INTEGER, "0".bytes())
    assert(has(a, zero, EP_IS_FALSE))
    big: expr(a, tk.TK_INTEGER, "9999999999".bytes())
    assert(!has(a, big, EP_INT_VALUE))
    assert(a.exprs[big].token == Val("9999999999".bytes()))
    q: expr_alloc(a, tk.TK_ID, Val("\"x\"".bytes()), true)
    assert(has(a, q, EP_QUOTED) && has(a, q, EP_DBL_QUOTED))
    assert(a.exprs[q].token == Val("x".bytes()))
}

#Test("expression heights and the depth limit") {
    a := stmt_ast("")
    a.limits[LIMIT_EXPR_DEPTH] = 3
    e := expr(a, tk.TK_INTEGER, "1".bytes())
    loop _i in 0..<2 {
        one: expr(a, tk.TK_INTEGER, "1".bytes())
        e = pexpr(a, tk.TK_PLUS, e, one)
    }
    assert(a.exprs[e].height == 3)
    assert(a.ctx.nerr == 0)
    _ := pexpr(a, tk.TK_PLUS, e, -1)
    assert(a.ctx.nerr == 1)
    assert(a.ctx.errmsg == Val("Expression tree is too large (maximum depth 3)"))
}

#Test("a reduced copy keeps only what the schema needs") {
    a := stmt_ast("")
    l: expr(a, tk.TK_ID, "x".bytes())
    r: expr(a, tk.TK_INTEGER, "5".bytes())
    e: pexpr(a, tk.TK_LT, l, r)
    a.exprs[e].itable = 7
    d: expr_dup(a, e, EXPRDUP_REDUCE)
    assert(has(a, d, EP_REDUCED))
    assert(a.exprs[d].itable == 0)
    assert(has(a, a.exprs[d].left, EP_TOKEN_ONLY) && has(a, a.exprs[d].left, EP_STATIC))
    assert(expr_compare(a, e, d, -1) == 0)
    f: expr_dup(a, e, 0)
    assert(a.exprs[f].itable == 7)
    assert(!has(a, f, EP_REDUCED))
}

#Test("bound parameters are numbered as SQLite numbers them") {
    a := stmt_ast("")
    p1: expr(a, tk.TK_VARIABLE, "?".bytes())
    expr_assign_var_number(a, p1, 1)
    n: expr(a, tk.TK_VARIABLE, ":n".bytes())
    expr_assign_var_number(a, n, 2)
    p5: expr(a, tk.TK_VARIABLE, "?5".bytes())
    expr_assign_var_number(a, p5, 2)
    n2: expr(a, tk.TK_VARIABLE, ":n".bytes())
    expr_assign_var_number(a, n2, 2)
    p6: expr(a, tk.TK_VARIABLE, "?".bytes())
    expr_assign_var_number(a, p6, 1)
    assert(a.exprs[p1].icolumn == 1 && a.exprs[n].icolumn == 2 && a.exprs[p5].icolumn == 5)
    assert(a.exprs[n2].icolumn == 2 && a.exprs[p6].icolumn == 6)
    bad: expr(a, tk.TK_VARIABLE, "?0".bytes())
    expr_assign_var_number(a, bad, 2)
    assert(a.ctx.errmsg == Val("variable number must be between ?1 and ?32766"))
}

#Test("join types and their errors") {
    a := stmt_ast("natural left outer join inner outer bogus")
    none: SQLTok{z: -1, n: 0}
    t_natural: tok_of(a, "natural")
    t_left: tok_of(a, "left")
    t_outer: tok_of(a, "outer")
    t_inner: tok_of(a, "inner")
    t_bogus: tok_of(a, "bogus")
    assert(join_type(a, t_natural, t_left, t_outer) == JT_NATURAL.bit_or(JT_LEFT).bit_or(JT_OUTER))
    assert(a.ctx.nerr == 0)
    assert(join_type(a, t_inner, t_outer, none) == JT_INNER)
    assert(a.ctx.errmsg == Val("unknown join type: inner outer"))
    assert(a.err_offset == t_inner.z)
    assert(join_type(a, t_bogus, none, none) == JT_INNER)
    assert(a.ctx.errmsg == Val("unknown join type: bogus"))
}

#Test("a FROM clause stops at 200 terms") {
    a := stmt_ast("")
    s := -1
    loop _i in 0..<200 -> s = src_list_append(a, s, Val("t".bytes()), None)
    assert(src_len(a, s) == 200)
    assert(a.ctx.nerr == 0)
    assert(src_list_append(a, s, Val("t".bytes()), None) == -1)
    assert(a.ctx.errmsg == Val("too many FROM clause terms, max: 200"))
}

#Test("join operators move to their right operand") {
    a := stmt_ast("")
    s := src_list_append(a, -1, Val("a".bytes()), None)
    a.items[src_item(a, s, 0)].jointype = JT_LEFT.bit_or(JT_OUTER)
    s = src_list_append(a, s, Val("b".bytes()), None)
    a.items[src_item(a, s, 1)].jointype = JT_RIGHT.bit_or(JT_OUTER)
    s = src_list_append(a, s, Val("c".bytes()), None)
    src_list_shift_join_type(a, s)
    assert(a.items[src_item(a, s, 0)].jointype == JT_LTORJ)
    assert(a.items[src_item(a, s, 1)].jointype == JT_LEFT.bit_or(JT_OUTER).bit_or(JT_LTORJ))
    assert(a.items[src_item(a, s, 2)].jointype == JT_RIGHT.bit_or(JT_OUTER))
}

#Test("windows link into and out of their SELECT") {
    a := stmt_ast("")
    sel: select_new(a, -1, -1, -1, -1, -1, -1, 0, -1)
    w1: window_alloc(a, tk.TK_ROWS, tk.TK_UNBOUNDED, -1, tk.TK_CURRENT, -1, 0)
    w2: window_alloc(a, tk.TK_ROWS, tk.TK_UNBOUNDED, -1, tk.TK_CURRENT, -1, 0)
    f1: expr_function(a, -1, SQLTok{z: -1, n: 0}, 0)
    window_attach(a, f1, w1)
    window_link(a, sel, w1)
    window_link(a, sel, w2)
    assert(a.selects[sel].win == w2 && a.windows[w2].next_win == w1)
    expr_delete(a, f1)
    assert(a.selects[sel].win == w2 && a.windows[w2].next_win == -1)
    window_delete(a, w2)
    assert(a.selects[sel].win == -1)
    one: expr(a, tk.TK_INTEGER, "1".bytes())
    assert(window_alloc(a, tk.TK_ROWS, tk.TK_CURRENT, -1, tk.TK_PRECEDING, one, 0) == -1)
    assert(a.ctx.errmsg == Val("unsupported frame specification"))
}

#Test("constant expressions") {
    a := stmt_ast("")
    c1: expr(a, tk.TK_INTEGER, "1".bytes())
    cx: expr(a, tk.TK_STRING, "x".bytes())
    c: pexpr(a, tk.TK_PLUS, c1, cx)
    assert(expr_is_constant(a, c))
    v1: expr(a, tk.TK_INTEGER, "1".bytes())
    vc: expr(a, tk.TK_ID, "col".bytes())
    v: pexpr(a, tk.TK_PLUS, v1, vc)
    assert(!expr_is_constant(a, v))
    t: expr(a, tk.TK_ID, "TRUE".bytes())
    assert(expr_is_constant(a, t))
    assert(a.exprs[t].op == tk.TK_TRUEFALSE && expr_truth_value(a, t))
    p: expr(a, tk.TK_VARIABLE, "?".bytes())
    assert(expr_is_constant(a, p))
    assert(!expr_is_constant_or_function(a, p, false))
    assert(expr_is_constant_or_function(a, p, true))
    assert(a.exprs[p].op == tk.TK_NULL)
}

#Test("WITH rejects a repeated name") {
    a := stmt_ast("")
    c1: cte_new(a, Val("x".bytes()), -1, -1, M10D_ANY)
    w := with_add(a, -1, c1)
    c2: cte_new(a, Val("\"X\"".bytes()), -1, -1, M10D_ANY)
    w = with_add(a, w, c2)
    assert(a.withs[w].ctes.len() == 2)
    assert(a.ctx.errmsg == Val("duplicate WITH table name: X"))
}
