// The record, transaction and cursor opcodes of the Jet SQLite engine: the
// cases of SQLite 3.45.0 sqlite3VdbeExec (vdbe.c) from OP_IfNullRow to
// OP_IdxGE. Each handler runs the op at Run.pc and answers a vdberun.GO_*
// code.
//
// OP_Column reads the record where it lies (the cursor's page image, the
// pseudo cursor's register) and copies only what overflows the page.

use {
    math: core.math
    base: __core_db_base
    __core_db_base.[MEM_NULL, MEM_STR, MEM_INT, MEM_REAL, MEM_BLOB, MEM_INT_REAL, MEM_ZERO]
    util: __core_db_util
    __core_db_util.[clear_bits]
    mem: __core_db_mem
    record: __core_db_record
    btree: __core_db_btree
    pager: __core_db_pager
    os: __core_db_os
    ast: __core_db_ast
    conn: __core_db_conn
    opc: __core_db_opcodes
    sorter: __core_db_sorter
    aux: __core_db_vdbeaux
    __core_db_vdbeaux.[Host]
    run: __core_db_vdberun
    __core_db_vdberun.[Run, GO_NEXT, GO_JUMP, GO_NEXT_CHECK, GO_JUMP_CHECK, GO_ERROR, GO_TOO_BIG, GO_RETURN, test_run, test_op]
}

// ---------------------------------------------------------------------------
// Helpers.

// The handler's error tail: abort_due_to_error with rc.
fail: fn(r: &Run, rc: Int) -> Int Never! {
    r.rc = rc
    GO_ERROR
}

// The key of a cursor that was opened without one (never sought by key).
no_key_info: fn() -> record.KeyInfo Never! {
    record.KeyInfo{enc: base.UTF8, n_key_field: 0, n_all_field: 0, sort_flags: [Int]{}, colls: [Int]{}}
}

// An UnpackedRecord of the n registers from Vdbe.mem index first, compared
// under cursor ci's key (the r.aMem form of the seek ops).
regs_key: fn(v: conn.Vdbe, ci: Int, first: Int, n: Int) -> record.UnpackedRecord Never! {
    vals := [base.Mem]{}
    loop k in 0..<n -> vals.push(v.mem[first + k])
    record.UnpackedRecord{key_info: v.csr[ci].key_info ?? no_key_info(), mem: vals, u_i: 0, u_z: [U8]{}, n_field: n, default_rc: 0, err_code: 0, r1: 0, r2: 0, eq_seen: false}
}

// The n registers from Vdbe.mem index first (BtreePayload.aMem).
regs: fn(v: conn.Vdbe, first: Int, n: Int) -> [base.Mem] Never! {
    vals := [base.Mem]{}
    loop k in 0..<n -> vals.push(v.mem[first + k])
    vals
}

// Take sorter cursor ci's sorter out of its slot to work on it; sorter_put
// puts it back.
sorter_take: fn(v: &conn.Vdbe, ci: Int) -> sorter.VdbeSorter Never! {
    s: v.csr[ci].sorter ?? sorter.sorter_new(v.csr[ci].key_info ?? no_key_info(), 0)
    v.csr[ci].sorter = None
    s
}

sorter_put: fn(v: &conn.Vdbe, ci: Int, s: sorter.VdbeSorter) Never! { v.csr[ci].sorter = Val(s) }

// The bytes cursor ci's current record lies in (VdbeCursor.row_kind) and,
// in at, where the record starts there.
row_bytes: fn(db: conn.Conn, v: conn.Vdbe, ci: Int, at: &Int) -> [U8] Never! {
    k: v.csr[ci].row_kind
    if k == conn.ROW_PAGE {
        at = v.csr[ci].row_off
        return db.btrees[v.csr[ci].bt].pager.pcache.pages[v.csr[ci].row_page].data
    }
    at = 0
    if k == conn.ROW_REGISTER -> return v.mem[v.csr[ci].pseudo_reg].z
    v.csr[ci].row
}

// op_column_corrupt: to the corruption handler of an integrity check
// program (aOp[0].p3), else SQLITE_CORRUPT.
column_corrupt: fn(v: conn.Vdbe, r: &Run) -> Int Never! {
    if v.ops[0].p3 > 0 {
        r.pc = v.ops[0].p3 - 1
        return GO_NEXT
    }
    fail(r, base.CORRUPT)
}

// The value of serial type t that only its type and length matter for
// (typeof(), length() of a blob, octet_length()): its bytes are zeros and
// a blob's are a MEM_Zero count.
column_placeholder: fn(t: Int, enc: Int) -> base.Mem Never! {
    if t >= 12 {
        n: (t - 12) >> 1
        if t.bit_and(1) == 1 -> return base.mem_text(pager.zeros(n), enc)
        m := base.mem_blob([U8]{})
        m.flags = MEM_BLOB.bit_or(MEM_ZERO)
        m.i = n
        return m
    }
    record.serial_get(pager.zeros(8), 0, t, enc)
}

// REAL affinity of a register that stayed an integer: an IntReal when it
// fits the 6-byte form, else the REAL.
real_of_int: fn(m: &base.Mem, clear_str: Bool) Never! {
    if m.i <= 140737488355327 && m.i >= -140737488355328 {
        m.flags = clear_bits(m.flags.bit_or(MEM_INT_REAL), MEM_INT)
    } else {
        m.r = util.int_to_double(m.i)
        clr: if clear_str -> MEM_INT.bit_or(MEM_STR) else -> MEM_INT
        m.flags = clear_bits(m.flags.bit_or(MEM_REAL), clr)
    }
}

// ---------------------------------------------------------------------------
// Records.

// OP_IfNullRow: a cursor on its NULL row sets P3 to NULL and jumps.
op_if_null_row: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    ci: v.csr_base + r.p1
    if v.csr[ci].live && v.csr[ci].null_row {
        run.reg_null(v, v.mem_base + r.p3)
        return GO_JUMP
    }
    GO_NEXT
}

// OP_Column: column P2 of cursor P1's row into P3 (P4's value, else NULL,
// when the record has fewer columns).
op_column: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci := v.csr_base + r.p1
    p2 := r.p2
    dest: v.mem_base + r.p3
    loop {
        direct := false
        if v.csr[ci].cache_status != v.cache_ctr {
            if v.csr[ci].null_row {
                if v.csr[ci].cur_type == conn.CURTYPE_PSEUDO && v.csr[ci].pseudo_reg > 0 {
                    n: v.mem[v.csr[ci].pseudo_reg].z.len()
                    v.csr[ci].payload_size = n
                    v.csr[ci].sz_row = n
                    v.csr[ci].row_kind = conn.ROW_REGISTER
                } else {
                    run.reg_null(v, dest)
                    return GO_NEXT
                }
            } else {
                bt: v.csr[ci].bt
                btc: v.csr[ci].btc
                if v.csr[ci].deferred_moveto {
                    if v.csr[ci].alt_map.len() > 1 + p2 && v.csr[ci].alt_map[1 + p2] > 0 {
                        p2 = v.csr[ci].alt_map[1 + p2] - 1
                        ci = v.csr[ci].alt_cursor
                        next
                    }
                    rc: aux.finish_moveto(db, v, ci)
                    if rc != base.OK -> return fail(r, rc)
                } else if btree.btree_cursor_has_moved(db.btrees[bt], btc) {
                    rc: aux.handle_moved_cursor(db, v, ci)
                    if rc != base.OK -> return fail(r, rc)
                    next
                }
                v.csr[ci].payload_size = btree.btree_payload_size(db.btrees[bt], btc)
                amt := 0
                v.csr[ci].row_off = btree.btree_payload_fetch(db.btrees[bt], btc, amt)
                v.csr[ci].row_page = db.btrees[bt].cursors[btc].page
                v.csr[ci].sz_row = amt
                v.csr[ci].row_kind = conn.ROW_PAGE
            }
            v.csr[ci].cache_status = v.cache_ctr
            at := 0
            rec := row_bytes(db, v, ci, at)
            hv: record.key_varint(rec, at)
            v.csr[ci].offsets[0] = hv.value
            v.csr[ci].i_hdr_offset = hv.len
            v.csr[ci].n_hdr_parsed = 0
            if v.csr[ci].sz_row < hv.value {
                // The header runs past the local payload: read it apart.
                v.csr[ci].row_kind = conn.ROW_COPY
                v.csr[ci].row = [U8]{}
                v.csr[ci].sz_row = 0
                if hv.value > 98307 || hv.value > v.csr[ci].payload_size -> return column_corrupt(v, r)
            } else {
                direct = true
            }
        } else if v.csr[ci].cur_type == conn.CURTYPE_BTREE && btree.btree_cursor_has_moved(db.btrees[v.csr[ci].bt], v.csr[ci].btc) {
            rc: aux.handle_moved_cursor(db, v, ci)
            if rc != base.OK -> return fail(r, rc)
            next
        }
        // Parse the header through column p2.
        if v.csr[ci].n_hdr_parsed <= p2 {
            if direct || v.csr[ci].i_hdr_offset < v.csr[ci].offsets[0] {
                if v.csr[ci].row_kind == conn.ROW_COPY && v.csr[ci].row.len() == 0 {
                    buf := [U8]{}
                    rc: aux.cursor_record(db, v.csr[ci].bt, v.csr[ci].btc, v.csr[ci].offsets[0], buf)
                    if rc != base.OK -> return fail(r, rc)
                    v.csr[ci].row = buf
                }
                at := 0
                rec := row_bytes(db, v, ci, at)
                i := v.csr[ci].n_hdr_parsed
                off := v.csr[ci].offsets[i]
                zh := at + v.csr[ci].i_hdr_offset
                ze: at + v.csr[ci].offsets[0]
                loop {
                    t := record.key_byte(rec, zh)
                    if t < 128 {
                        zh += 1
                    } else {
                        tv: record.key_varint(rec, zh)
                        t = if tv.value > os.U32_MASK -> os.U32_MASK else -> tv.value
                        zh += tv.len
                    }
                    v.csr[ci].types[i] = t
                    off += record.serial_len(t)
                    i += 1
                    v.csr[ci].offsets[i] = off.bit_and(os.U32_MASK)
                    if i > p2 || zh >= ze -> break
                }
                ps: v.csr[ci].payload_size
                if (zh >= ze && (zh > ze || off != ps)) || off > ps {
                    if v.csr[ci].offsets[0] != 0 -> return column_corrupt(v, r)
                    i = 0
                    zh = ze
                }
                v.csr[ci].n_hdr_parsed = i
                v.csr[ci].i_hdr_offset = zh - at
            }
            if v.csr[ci].n_hdr_parsed <= p2 {
                run.release_dyn(v, dest)
                if v.ops[r.pc].p4 == .Mem(m) {
                    v.mem[dest] = m.copy()
                } else {
                    mem.set_null(v.mem[dest])
                }
                return GO_NEXT
            }
        }
        t: v.csr[ci].types[p2]
        run.release_dyn(v, dest)
        limit: db.limits[ast.LIMIT_LENGTH]
        if v.csr[ci].sz_row >= v.csr[ci].offsets[p2 + 1] {
            if t >= 12 && (t - 12) >> 1 > limit -> return GO_TOO_BIG
            at := 0
            rec := row_bytes(db, v, ci, at)
            v.mem[dest] = record.serial_get(rec, at + v.csr[ci].offsets[p2], t, r.enc)
            return GO_NEXT
        }
        len: record.serial_len(t)
        p5: r.p5.bit_and(conn.OPFLAG_BYTELENARG)
        if (p5 != 0 && (p5 == conn.OPFLAG_TYPEOFARG || (t >= 12 && (t.bit_and(1) == 0 || p5 == conn.OPFLAG_BYTELENARG)))) || len == 0 {
            v.mem[dest] = column_placeholder(t, r.enc)
            return GO_NEXT
        }
        if len > limit -> return GO_TOO_BIG
        buf := pager.zeros(len)
        rc: btree.btree_payload(db.btrees[v.csr[ci].bt], v.csr[ci].btc, v.csr[ci].offsets[p2], len, buf)
        if rc != base.OK -> return fail(r, rc)
        v.mem[dest] = record.serial_get(buf, 0, t, r.enc)
        return GO_NEXT
    }
    GO_NEXT
}

// sqlite3StdType: the names of the COLTYPE_* column types.
STD_TYPES: ["ANY", "BLOB", "INT", "INTEGER", "REAL", "TEXT"]

// OP_TypeCheck: the registers from P1 against the columns of STRICT table
// P4 (P3: the generated columns are absent).
op_type_check: fn(db: conn.Conn, v: &conn.Vdbe, r: &Run) -> Int Never! {
    tab := 0
    if v.ops[r.pc].p4 == .Table(t) -> tab = t
    i := v.mem_base + r.p1
    loop k in 0..<db.tables[tab].cols.len() {
        cf: db.tables[tab].cols[k].col_flags
        if cf.bit_and(conn.COLFLAG_GENERATED) != 0 {
            if cf.bit_and(conn.COLFLAG_VIRTUAL) != 0 -> next
            if r.p3 != 0 {
                i += 1
                next
            }
        }
        mem.apply_affinity(v.mem[i], db.tables[tab].cols[k].affinity, r.enc)
        f: v.mem[i].flags
        if f.bit_and(MEM_NULL) == 0 {
            ct: db.tables[tab].cols[k].ctype
            bad := false
            if ct == conn.COLTYPE_BLOB {
                bad = f.bit_and(MEM_BLOB) == 0
            } else if ct == conn.COLTYPE_INTEGER || ct == conn.COLTYPE_INT {
                bad = f.bit_and(MEM_INT) == 0
            } else if ct == conn.COLTYPE_TEXT {
                bad = f.bit_and(MEM_STR) == 0
            } else if ct == conn.COLTYPE_REAL {
                if f.bit_and(MEM_INT) != 0 {
                    real_of_int(v.mem[i], false)
                } else {
                    bad = f.bit_and(MEM_REAL.bit_or(MEM_INT_REAL)) == 0
                }
            }
            if bad {
                msg := "cannot store ".bytes()
                aux.append_bytes(msg, run.mem_type_name(v.mem[i]))
                aux.append_bytes(msg, " value in {STD_TYPES[ct - 1]} column ".bytes())
                aux.append_bytes(msg, db.tables[tab].name)
                msg.push(U8{46})
                aux.append_bytes(msg, db.tables[tab].cols[k].name)
                aux.vdbe_error(v, msg)
                return fail(r, base.CONSTRAINT_DATATYPE)
            }
        }
        i += 1
    }
    GO_NEXT
}

// OP_Affinity: the affinities of P4, one a register from P1.
op_affinity: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    aff: run.p4_text(v, r.pc) ?? [U8]{}
    i := v.mem_base + r.p1
    loop k in 0..<aff.len() {
        a: Int.from_u8(aff[k])
        if a == 0 -> break
        mem.apply_affinity(v.mem[i], a, r.enc)
        if a == base.AFF_REAL && v.mem[i].flags.bit_and(MEM_INT) != 0 -> real_of_int(v.mem[i], true)
        i += 1
    }
    GO_NEXT
}

// OP_MakeRecord: the record of the P2 registers from P1 into P3, with the
// affinities of P4 applied first. Zero-blob bytes at the end stay a
// MEM_Zero count.
op_make_record: fn(db: conn.Conn, v: &conn.Vdbe, r: &Run) -> Int Never! {
    first: v.mem_base + r.p1
    n_field: r.p2
    if v.ops[r.pc].p4 == .Text(aff) {
        loop k in 0..<aff.len() {
            a: Int.from_u8(aff[k])
            if a == 0 -> break
            i: first + k
            mem.apply_affinity(v.mem[i], a, r.enc)
            if a == base.AFF_REAL && v.mem[i].flags.bit_and(MEM_INT) != 0 {
                v.mem[i].flags = clear_bits(v.mem[i].flags.bit_or(MEM_INT_REAL), MEM_INT)
            }
        }
    }
    // The serial types, last to first: a zero blob is expanded unless
    // only empty values follow it.
    types := [Int]{}
    loop _ in 0..<n_field -> types.push(0)
    n_data := 0
    n_hdr := 0
    n_zero := 0
    k := n_field - 1
    loop k >= 0 {
        i: first + k
        t := record.serial_type(v.mem[i], v.min_write_file_format)
        if t == 7 && v.mem[i].flags.bit_and(MEM_INT_REAL) != 0 {
            // An IntReal that needs all 8 bytes is stored as the REAL.
            v.mem[i].r = util.int_to_double(v.mem[i].i)
            v.mem[i].flags = clear_bits(v.mem[i].flags, MEM_INT_REAL).bit_or(MEM_REAL)
        }
        f: v.mem[i].flags
        if t >= 12 && f.bit_and(MEM_ZERO) != 0 {
            if n_data > 0 {
                mem.expand_blob(v.mem[i])
                n_data += v.mem[i].z.len()
            } else {
                n_zero += v.mem[i].i
                n_data += v.mem[i].z.len()
            }
        } else {
            n_data += record.serial_len(t)
        }
        n_hdr += util.varint_len(t)
        types[k] = t
        k -= 1
    }
    if n_hdr <= 126 {
        n_hdr += 1
    } else {
        n_varint: util.varint_len(n_hdr)
        n_hdr += n_varint
        if n_varint < util.varint_len(n_hdr) -> n_hdr += 1
    }
    n_byte: n_hdr + n_data
    if n_byte + n_zero > db.limits[ast.LIMIT_LENGTH] -> return GO_TOO_BIG
    out := [U8]{}
    util.put_varint(out, n_hdr)
    loop k2 in 0..<n_field -> util.put_varint(out, types[k2])
    loop k3 in 0..<n_field {
        t: types[k3]
        i: first + k3
        if t >= 12 {
            aux.append_bytes(out, v.mem[i].z)
        } else if t == 7 {
            record.put_signed(out, math.to_bits(v.mem[i].r), 8)
        } else if t >= 1 && t <= 6 {
            record.put_signed(out, v.mem[i].i, record.serial_len(t))
        }
    }
    o: v.mem_base + r.p3
    run.release_dyn(v, o)
    m := base.mem_blob(out)
    if n_zero > 0 {
        m.flags = MEM_BLOB.bit_or(MEM_ZERO)
        m.i = n_zero
    }
    v.mem[o] = m
    GO_NEXT
}

// OP_Count: the rows of cursor P1's table or index into P2 (P3: an
// estimate will do).
op_count: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    bt: v.csr[ci].bt
    n := 0
    if r.p3 != 0 {
        n = btree.btree_row_count_est(db.btrees[bt], v.csr[ci].btc)
    } else {
        rc: btree.btree_count(db.btrees[bt], v.csr[ci].btc, n)
        if rc != base.OK -> return fail(r, rc)
    }
    o: v.mem_base + r.p2
    run.out2(v, o)
    v.mem[o].i = n
    GO_NEXT_CHECK
}

// ---------------------------------------------------------------------------
// Transactions.

// OP_Savepoint: P1 SAVEPOINT_BEGIN opens savepoint P4, RELEASE and
// ROLLBACK end the newest one of that name and those opened after it.
op_savepoint: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    p1: r.p1
    name: run.p4_text(v, r.pc) ?? [U8]{}
    rc := base.OK
    if p1 == base.SAVEPOINT_BEGIN {
        if db.n_vdbe_write > 0 {
            aux.vdbe_error(v, "cannot open savepoint - SQL statements in progress".bytes())
            rc = base.BUSY
        } else {
            rc = aux.vtab_savepoint<H>(h, db, base.SAVEPOINT_BEGIN, db.n_statement + db.n_savepoint)
            if rc != base.OK -> return fail(r, rc)
            if db.auto_commit {
                db.auto_commit = false
                db.is_transaction_savepoint = 1
            } else {
                db.n_savepoint += 1
            }
            db.savepoints.push(conn.Savepoint{name: name, n_deferred_cons: db.n_deferred_cons, n_deferred_imm_cons: db.n_deferred_imm_cons})
            conn.sync_btrees(db)
        }
    } else {
        // The newest savepoint of that name, i_savepoint newer ones above.
        i_savepoint := 0
        k := db.savepoints.len() - 1
        loop k >= 0 && util.str_icmp(db.savepoints[k].name, name) != 0 {
            i_savepoint += 1
            k -= 1
        }
        if k < 0 {
            aux.vdbe_error(v, "no such savepoint: {String.from_bytes(name) ?? ""}".bytes())
            rc = base.ERROR
        } else if db.n_vdbe_write > 0 && p1 == base.SAVEPOINT_RELEASE {
            aux.vdbe_error(v, "cannot release savepoint - SQL statements in progress".bytes())
            rc = base.BUSY
        } else {
            // RELEASE of the transaction's own savepoint commits it.
            is_transaction: k == 0 && db.is_transaction_savepoint != 0
            i_sp := i_savepoint
            if is_transaction && p1 == base.SAVEPOINT_RELEASE {
                rc = aux.check_fk(db, v, true)
                if rc != base.OK {
                    r.rc = rc
                    return GO_RETURN
                }
                db.auto_commit = true
                if aux.halt<H>(h, db, v) == base.BUSY {
                    v.pc = r.pc
                    db.auto_commit = false
                    v.rc = base.BUSY
                    r.rc = base.BUSY
                    return GO_RETURN
                }
                rc = v.rc
                if rc != base.OK {
                    db.auto_commit = false
                } else {
                    db.is_transaction_savepoint = 0
                }
            } else {
                i_sp = db.n_savepoint - i_savepoint - 1
                is_schema_change := false
                if p1 == base.SAVEPOINT_ROLLBACK {
                    is_schema_change = db.m_db_flags.bit_and(conn.DBFLAG_SCHEMA_CHANGE) != 0
                    loop ii in 0..<db.dbs.len() {
                        bt: db.dbs[ii].bt
                        if bt < 0 -> next
                        rc = btree.btree_trip_all_cursors(db.btrees[bt], base.ABORT_ROLLBACK, !is_schema_change)
                        if rc != base.OK -> return fail(r, rc)
                    }
                }
                loop ii in 0..<db.dbs.len() {
                    bt: db.dbs[ii].bt
                    if bt < 0 -> next
                    rc = btree.btree_savepoint(db.btrees[bt], p1, i_sp)
                    if rc != base.OK -> return fail(r, rc)
                }
                if is_schema_change {
                    conn.expire_prepared_statements(db, 0)
                    conn.reset_all_schemas(db)
                    db.m_db_flags = db.m_db_flags.bit_or(conn.DBFLAG_SCHEMA_CHANGE)
                }
            }
            if rc != base.OK -> return fail(r, rc)
            // Drop the savepoints opened after it; RELEASE drops it too and
            // ROLLBACK restores its deferred constraint counts.
            loop db.savepoints.len() > k + 1 {
                _: db.savepoints.pop()
                db.n_savepoint -= 1
            }
            if p1 == base.SAVEPOINT_RELEASE {
                _: db.savepoints.pop()
                if !is_transaction -> db.n_savepoint -= 1
            } else {
                db.n_deferred_cons = db.savepoints[k].n_deferred_cons
                db.n_deferred_imm_cons = db.savepoints[k].n_deferred_imm_cons
            }
            conn.sync_btrees(db)
            if !is_transaction || p1 == base.SAVEPOINT_ROLLBACK {
                rc = aux.vtab_savepoint<H>(h, db, p1, i_sp)
                if rc != base.OK -> return fail(r, rc)
            }
        }
    }
    if rc != base.OK -> return fail(r, rc)
    if v.state == conn.VDBE_HALT_STATE {
        r.rc = base.DONE
        return GO_RETURN
    }
    GO_NEXT
}

// OP_AutoCommit: autocommit becomes P1 (COMMIT, or ROLLBACK when P2), or
// BEGIN clears it; the statement then halts.
op_auto_commit: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    desired: r.p1
    i_rollback: r.p2
    cur: if db.auto_commit -> 1 else -> 0
    if desired != cur {
        if i_rollback != 0 {
            aux.rollback_all<H>(h, db, base.ABORT_ROLLBACK)
            db.auto_commit = true
        } else if desired != 0 && db.n_vdbe_write > 0 {
            aux.vdbe_error(v, "cannot commit transaction - SQL statements in progress".bytes())
            return fail(r, base.BUSY)
        } else {
            rc: aux.check_fk(db, v, true)
            if rc != base.OK {
                r.rc = rc
                return GO_RETURN
            }
            db.auto_commit = desired != 0
        }
        if aux.halt<H>(h, db, v) == base.BUSY {
            v.pc = r.pc
            db.auto_commit = desired == 0
            v.rc = base.BUSY
            r.rc = base.BUSY
            return GO_RETURN
        }
        aux.close_savepoints(db)
        conn.sync_btrees(db)
        r.rc = if v.rc == base.OK -> base.DONE else -> base.ERROR
        return GO_RETURN
    }
    msg: if desired == 0 -> "cannot start a transaction within a transaction" else if i_rollback != 0 -> "cannot rollback - no transaction is active" else -> "cannot commit - no transaction is active"
    aux.vdbe_error(v, msg.bytes())
    fail(r, base.ERROR)
}

// OP_Transaction: begin a read (P2 0) or write (P2 1) or exclusive (P2 2)
// transaction on database P1; with P5, a schema cookie other than P3 or a
// schema generation other than P4 expires the statement.
op_transaction: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    if r.p2 != 0 && db.flags.bit_and(conn.SQLITE_QUERY_ONLY.bit_or(conn.SQLITE_CORRUPT_RD_ONLY)) != 0 {
        if db.flags.bit_and(conn.SQLITE_QUERY_ONLY) != 0 -> return fail(r, base.READONLY)
        return fail(r, base.CORRUPT)
    }
    bt: db.dbs[r.p1].bt
    rc := base.OK
    i_meta := 0
    if bt >= 0 {
        conn.sync_btrees(db)
        rc = btree.btree_begin_trans(db.btrees[bt], r.p2, i_meta)
        if rc != base.OK {
            if rc.bit_and(255) == base.BUSY {
                v.pc = r.pc
                v.rc = rc
                r.rc = rc
                return GO_RETURN
            }
            return fail(r, rc)
        }
        if v.uses_stmt_journal && r.p2 != 0 && (!db.auto_commit || db.n_vdbe_read > 1) {
            if v.i_statement == 0 {
                db.n_statement += 1
                v.i_statement = db.n_savepoint + db.n_statement
            }
            rc = aux.vtab_savepoint<H>(h, db, base.SAVEPOINT_BEGIN, v.i_statement - 1)
            if rc == base.OK -> rc = btree.btree_begin_stmt(db.btrees[bt], v.i_statement)
            v.n_stmt_def_cons = db.n_deferred_cons
            v.n_stmt_def_imm_cons = db.n_deferred_imm_cons
        }
    }
    s: db.dbs[r.p1].schema
    if rc == base.OK && r.p5 != 0 && (i_meta != r.p3 || db.schemas[s].generation != run.p4_int(v, r.pc)) {
        aux.vdbe_error(v, "database schema has changed".bytes())
        // The schema is reread when its cookie moved on; either way the
        // statement is re-prepared.
        if db.schemas[s].schema_cookie != i_meta -> conn.reset_one_schema(db, r.p1)
        db.vdbe_links[v.slot].expired = conn.EXPIRED_NOW
        rc = base.SCHEMA
        v.change_cnt_on = false
    }
    if rc != base.OK -> return fail(r, rc)
    GO_NEXT
}

// OP_ReadCookie: meta value P3 of database P1 into P2.
op_read_cookie: fn(db: conn.Conn, v: &conn.Vdbe, r: &Run) -> Int Never! {
    i_meta: btree.btree_get_meta(db.btrees[db.dbs[r.p1].bt], r.p3)
    o: v.mem_base + r.p2
    run.out2(v, o)
    v.mem[o].i = i_meta
    GO_NEXT
}

// OP_SetCookie: meta value P2 of database P1 becomes P3 (the schema
// cookie P3 - P5 in memory).
op_set_cookie: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    rc: btree.btree_update_meta(db.btrees[db.dbs[r.p1].bt], r.p2, r.p3)
    s: db.dbs[r.p1].schema
    if r.p2 == btree.BTREE_SCHEMA_VERSION {
        db.schemas[s].schema_cookie = (r.p3 - r.p5).bit_and(os.U32_MASK)
        db.m_db_flags = db.m_db_flags.bit_or(conn.DBFLAG_SCHEMA_CHANGE)
        conn.fk_clear_trigger_cache(db, r.p1)
    } else if r.p2 == btree.BTREE_FILE_FORMAT {
        db.schemas[s].file_format = r.p3
    }
    if r.p1 == 1 {
        // A change to the TEMP schema expires every statement but this one.
        conn.expire_prepared_statements(db, 0)
        db.vdbe_links[v.slot].expired = 0
    }
    if rc != base.OK -> return fail(r, rc)
    GO_NEXT
}

// ---------------------------------------------------------------------------
// Opening and closing cursors.

// OP_ReopenIdx, OP_OpenRead, OP_OpenWrite: cursor P1 on the btree rooted
// at page P2 (a register with OPFLAG_P2ISREG) of database P3, an index
// when P4 is its KeyInfo, else a table of P4 columns.
op_open_read: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci0: v.csr_base + r.p1
    hints: r.p5.bit_and(conn.OPFLAG_BULKCSR.bit_or(conn.OPFLAG_SEEKEQ))
    if r.op == opc.OP_REOPEN_IDX && v.csr[ci0].live && v.csr[ci0].pgno_root == r.p2 {
        btree.btree_clear_cursor(db.btrees[v.csr[ci0].bt], v.csr[ci0].btc)
        btree.btree_cursor_hint_flags(db.btrees[v.csr[ci0].bt], v.csr[ci0].btc, hints)
        return GO_NEXT
    }
    if db.vdbe_links[v.slot].expired == conn.EXPIRED_NOW -> return fail(r, base.ABORT_ROLLBACK)
    p2 := r.p2
    i_db: r.p3
    bt: db.dbs[i_db].bt
    wr_flag := 0
    if r.op == opc.OP_OPEN_WRITE {
        wr_flag = btree.BTREE_WRCSR.bit_or(r.p5.bit_and(conn.OPFLAG_FORDELETE))
        ff: db.schemas[db.dbs[i_db].schema].file_format
        if ff < v.min_write_file_format -> v.min_write_file_format = ff
    }
    if r.p5.bit_and(conn.OPFLAG_P2ISREG) != 0 {
        i2: v.mem_base + p2
        mem.integerify(v.mem[i2])
        p2 = v.mem[i2].i
    }
    n_field := 0
    key_info := record.KeyInfo?{None}
    is_table := true
    if v.ops[r.pc].p4 == {
        .KeyInfo(k) -> {
            n_field = k.n_all_field
            key_info = Val(k.copy())
            is_table = false
        }
        .Int32(n) -> n_field = n
        else -> {}
    }
    ci: run.alloc_cursor<H>(h, db, v, r.p1, n_field, conn.CURTYPE_BTREE)
    v.csr[ci].i_db = i_db
    v.csr[ci].null_row = true
    v.csr[ci].is_ordered = true
    v.csr[ci].pgno_root = p2
    v.csr[ci].bt = bt
    v.csr[ci].is_table = is_table
    btc := -1
    rc: btree.btree_cursor(db.btrees[bt], p2, wr_flag, key_info, btc)
    v.csr[ci].btc = btc
    v.csr[ci].key_info = key_info
    if rc != base.OK -> return fail(r, rc)
    btree.btree_cursor_hint_flags(db.btrees[bt], btc, hints)
    GO_NEXT
}

// OP_OpenDup: cursor P1 on the ephemeral table of cursor P2.
op_open_dup: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    orig: v.csr_base + r.p2
    ci: run.alloc_cursor<H>(h, db, v, r.p1, v.csr[orig].n_field, conn.CURTYPE_BTREE)
    v.csr[ci].null_row = true
    v.csr[ci].is_ephemeral = true
    v.csr[ci].key_info = v.csr[orig].key_info
    v.csr[ci].is_table = v.csr[orig].is_table
    v.csr[ci].pgno_root = v.csr[orig].pgno_root
    v.csr[ci].is_ordered = v.csr[orig].is_ordered
    v.csr[ci].bt = v.csr[orig].bt
    v.csr[ci].no_reuse = true
    v.csr[orig].no_reuse = true
    btc := -1
    rc: btree.btree_cursor(db.btrees[v.csr[ci].bt], v.csr[ci].pgno_root, btree.BTREE_WRCSR, v.csr[ci].key_info, btc)
    v.csr[ci].btc = btc
    if rc != base.OK -> return fail(r, rc)
    GO_NEXT
}

// OP_OpenEphemeral, OP_OpenAutoindex: cursor P1 on a new temporary table
// of P2 columns (an index when P4 is its KeyInfo). A cursor already open
// on one is emptied instead. P3 names a register to clear.
op_open_ephemeral: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    if r.p3 > 0 -> v.mem[v.mem_base + r.p3].z = [U8]{}
    ci0: v.csr_base + r.p1
    rc := base.OK
    ci := ci0
    if v.csr[ci0].live && !v.csr[ci0].no_reuse && r.p2 <= v.csr[ci0].n_field {
        v.csr[ci0].seq_count = 0
        v.csr[ci0].cache_status = conn.CACHE_STALE
        unused := 0
        rc = btree.btree_clear_table(db.btrees[v.csr[ci0].bt], v.csr[ci0].pgno_root, unused)
    } else {
        ci = run.alloc_cursor<H>(h, db, v, r.p1, r.p2, conn.CURTYPE_BTREE)
        v.csr[ci].is_ephemeral = true
        slot: conn.btree_slot_new(db)
        v.csr[ci].bt = slot
        vfs_flags: os.OPEN_READWRITE.bit_or(os.OPEN_CREATE).bit_or(os.OPEN_EXCLUSIVE).bit_or(os.OPEN_DELETEONCLOSE).bit_or(os.OPEN_TRANSIENT_DB)
        flags: btree.BTREE_OMIT_JOURNAL.bit_or(btree.BTREE_SINGLE).bit_or(r.p5)
        owner: conn.bt_db_of(db, -1)
        rc = btree.btree_open(db.btrees[slot], None, owner, flags, vfs_flags, false, false, false, false)
        if rc == base.OK {
            unused := 0
            rc = btree.btree_begin_trans(db.btrees[slot], 1, unused)
            if rc == base.OK {
                btc := -1
                if v.ops[r.pc].p4 == .KeyInfo(k) {
                    v.csr[ci].key_info = Val(k.copy())
                    v.csr[ci].is_table = false
                    root := 0
                    rc = btree.btree_create_table(db.btrees[slot], root, btree.BTREE_BLOBKEY.bit_or(r.p5))
                    if rc == base.OK {
                        v.csr[ci].pgno_root = root
                        rc = btree.btree_cursor(db.btrees[slot], root, btree.BTREE_WRCSR, v.csr[ci].key_info, btc)
                    }
                } else {
                    v.csr[ci].pgno_root = btree.SCHEMA_ROOT
                    v.csr[ci].is_table = true
                    rc = btree.btree_cursor(db.btrees[slot], btree.SCHEMA_ROOT, btree.BTREE_WRCSR, None, btc)
                }
                v.csr[ci].btc = btc
            }
            v.csr[ci].is_ordered = r.p5 != btree.BTREE_UNORDERED
            if rc != base.OK -> _: btree.btree_close(db.btrees[slot])
        }
        if rc != base.OK {
            conn.btree_slot_free(db, slot)
            v.csr[ci].bt = -1
            v.csr[ci].btc = -1
        }
    }
    if rc != base.OK -> return fail(r, rc)
    v.csr[ci].null_row = true
    GO_NEXT
}

// OP_SorterOpen: cursor P1 on a new sorter of records under KeyInfo P4.
op_sorter_open: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: run.alloc_cursor<H>(h, db, v, r.p1, r.p2, conn.CURTYPE_SORTER)
    if v.ops[r.pc].p4 == .KeyInfo(k) {
        v.csr[ci].key_info = Val(k.copy())
        v.csr[ci].sorter = Val(sorter.sorter_new(k.copy(), r.p3))
    }
    GO_NEXT
}

// OP_SequenceTest: jump when cursor P1's sequence counter was 0, counting
// it up.
op_sequence_test: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    ci: v.csr_base + r.p1
    was: v.csr[ci].seq_count
    v.csr[ci].seq_count = was + 1
    if was == 0 -> return GO_JUMP
    GO_NEXT
}

// OP_OpenPseudo: cursor P1 on the record register P2 holds, of P3 columns.
op_open_pseudo: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: run.alloc_cursor<H>(h, db, v, r.p1, r.p3, conn.CURTYPE_PSEUDO)
    v.csr[ci].null_row = true
    v.csr[ci].pseudo_reg = v.mem_base + r.p2
    v.csr[ci].is_table = true
    GO_NEXT
}

// OP_Close.
op_close: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    if v.csr[ci].live -> aux.free_cursor<H>(h, db, v, ci)
    GO_NEXT
}

// ---------------------------------------------------------------------------
// Seeks.

// OP_SeekLT, OP_SeekLE, OP_SeekGE, OP_SeekGT: move cursor P1 to the first
// entry past the key (the rowid in P3, or the P4 registers from P3) in the
// op's direction; jump to P2 when there is none. A SEEKEQ index seek that
// lands on the key skips the OP_IdxLT/GT after it.
op_seek: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    oc := r.op
    eq_only := false
    bt: v.csr[ci].bt
    btc: v.csr[ci].btc
    v.csr[ci].null_row = false
    v.csr[ci].deferred_moveto = false
    v.csr[ci].cache_status = conn.CACHE_STALE
    res := 0
    rc := base.OK
    found := true
    if v.csr[ci].is_table {
        i3: v.mem_base + r.p3
        flags3: v.mem[i3].flags
        if flags3.bit_and(MEM_INT.bit_or(MEM_REAL).bit_or(MEM_INT_REAL).bit_or(MEM_STR)) == MEM_STR -> mem.apply_numeric_affinity(v.mem[i3], false)
        i_key: mem.int_value(v.mem[i3])
        new_type: v.mem[i3].flags
        v.mem[i3].flags = flags3
        if new_type.bit_and(MEM_INT.bit_or(MEM_INT_REAL)) == 0 {
            if new_type.bit_and(MEM_REAL) == 0 {
                // A NULL or non-numeric key matches nothing.
                if new_type.bit_and(MEM_NULL) != 0 || oc >= opc.OP_SEEK_GE -> return GO_JUMP
                rc = btree.btree_last(db.btrees[bt], btc, res)
                if rc != base.OK -> return fail(r, rc)
                found = false
            } else {
                c: record.int_float_compare(i_key, v.mem[i3].r)
                if c > 0 {
                    if oc.bit_and(1) == opc.OP_SEEK_GT.bit_and(1) -> oc -= 1
                } else if c < 0 {
                    if oc.bit_and(1) == opc.OP_SEEK_LT.bit_and(1) -> oc += 1
                }
            }
        }
        if found {
            rc = btree.btree_table_moveto(db.btrees[bt], btc, i_key, false, res)
            v.csr[ci].moveto_target = i_key
            if rc != base.OK -> return fail(r, rc)
        }
    } else {
        if btree.btree_cursor_has_hint(db.btrees[bt], btc, btree.BTREE_SEEK_EQ) -> eq_only = true
        key := regs_key(v, ci, v.mem_base + r.p3, run.p4_int(v, r.pc))
        key.default_rc = if (oc - opc.OP_SEEK_LT).bit_and(1) != 0 -> -1 else -> 1
        rc = btree.btree_index_moveto(db.btrees[bt], btc, key, res)
        if rc != base.OK -> return fail(r, rc)
        if eq_only && !key.eq_seen -> found = false
    }
    if found {
        if oc >= opc.OP_SEEK_GE {
            if res < 0 || (res == 0 && oc == opc.OP_SEEK_GT) {
                res = 0
                rc = btree.btree_next(db.btrees[bt], btc, 0)
                if rc != base.OK {
                    if rc != base.DONE -> return fail(r, rc)
                    res = 1
                }
            } else {
                res = 0
            }
        } else {
            if res > 0 || (res == 0 && oc == opc.OP_SEEK_LT) {
                res = 0
                rc = btree.btree_previous(db.btrees[bt], btc, 0)
                if rc != base.OK {
                    if rc != base.DONE -> return fail(r, rc)
                    res = 1
                }
            } else {
                res = if btree.btree_eof(db.btrees[bt], btc) -> 1 else -> 0
            }
        }
    }
    if res != 0 -> return GO_JUMP
    if eq_only -> r.pc += 1
    GO_NEXT
}

// OP_SeekScan: before the OP_SeekGE after it, step cursor forward up to P1
// times looking for its key; on the key, past the seek to P2; past the key
// (or at the end), to the seek's P2.
op_seek_scan: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    nxt: r.pc + 1
    ci: v.csr_base + v.ops[nxt].p1
    bt: v.csr[ci].bt
    btc: v.csr[ci].btc
    if !btree.btree_cursor_is_valid_nn(db.btrees[bt], btc) -> return GO_NEXT
    n_step := r.p1
    key := regs_key(v, ci, v.mem_base + v.ops[nxt].p3, run.p4_int(v, nxt))
    key.default_rc = 0
    loop {
        res := 0
        rc := aux.idx_key_compare(db, bt, btc, key, res)
        if rc != base.OK -> return fail(r, rc)
        if res > 0 && r.p5 == 0 {
            r.pc = v.ops[nxt].p2 - 1
            return GO_NEXT
        }
        if res >= 0 -> return GO_JUMP
        if n_step <= 0 -> return GO_NEXT
        n_step -= 1
        v.csr[ci].cache_status = conn.CACHE_STALE
        rc = btree.btree_next(db.btrees[bt], btc, 0)
        if rc != base.OK {
            if rc != base.DONE -> return fail(r, rc)
            r.pc = v.ops[nxt].p2 - 1
            return GO_NEXT
        }
    }
    GO_NEXT
}

// OP_SeekHit: cursor P1's seek_hit clamped into P2..P3.
op_seek_hit: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    ci: v.csr_base + r.p1
    if v.csr[ci].seek_hit < r.p2 {
        v.csr[ci].seek_hit = r.p2
    } else if v.csr[ci].seek_hit > r.p3 {
        v.csr[ci].seek_hit = r.p3
    }
    GO_NEXT
}

// OP_IfNotOpen: jump when cursor P1 is closed or on its NULL row.
op_if_not_open: fn(v: conn.Vdbe, r: &Run) -> Int Never! {
    ci: v.csr_base + r.p1
    if !v.csr[ci].live || v.csr[ci].null_row -> return GO_JUMP_CHECK
    GO_NEXT
}

// OP_IfNoHope, OP_NoConflict, OP_NotFound, OP_Found: seek index cursor P1
// to the key in the P4 registers from P3 (the record P3 holds when P4 is
// 0) and jump on whether it is there: Found when it is, the others when it
// is not (NoConflict also when the key has a NULL).
op_found: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    n_field: run.p4_int(v, r.pc)
    if r.op == opc.OP_IF_NO_HOPE && v.csr[ci].seek_hit >= n_field -> return GO_NEXT
    first: v.mem_base + r.p3
    bt: v.csr[ci].bt
    btc: v.csr[ci].btc
    seek_result := 0
    rc := base.OK
    if n_field > 0 {
        key := regs_key(v, ci, first, n_field)
        rc = btree.btree_index_moveto(db.btrees[bt], btc, key, seek_result)
    } else {
        mem.expand_blob(v.mem[first])
        info: v.csr[ci].key_info ?? no_key_info()
        key := record.unpacked_record_alloc(info)
        record.record_unpack(info, v.mem[first].z.len(), v.mem[first].z, key)
        key.default_rc = 0
        rc = btree.btree_index_moveto(db.btrees[bt], btc, key, seek_result)
    }
    v.csr[ci].seek_result = seek_result
    if rc != base.OK -> return fail(r, rc)
    exists: seek_result == 0
    v.csr[ci].null_row = !exists
    v.csr[ci].deferred_moveto = false
    v.csr[ci].cache_status = conn.CACHE_STALE
    if r.op == opc.OP_FOUND {
        if exists -> return GO_JUMP
        return GO_NEXT
    }
    if !exists -> return GO_JUMP
    if r.op == opc.OP_NO_CONFLICT {
        loop k in 0..<n_field {
            if v.mem[first + k].flags.bit_and(MEM_NULL) != 0 -> return GO_JUMP
        }
    }
    if r.op == opc.OP_IF_NO_HOPE -> v.csr[ci].seek_hit = n_field
    GO_NEXT
}

// OP_SeekRowid, OP_NotExists: move table cursor P1 to rowid P3, jumping
// to P2 when it is not there (SeekRowid also when P3 is no integer).
// NotExists with P2 0 finds a missing row corrupt.
op_seek_rowid: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    i3: v.mem_base + r.p3
    i_key := v.mem[i3].i
    if r.op == opc.OP_SEEK_ROWID && v.mem[i3].flags.bit_and(MEM_INT.bit_or(MEM_INT_REAL)) == 0 {
        x := v.mem[i3].copy()
        mem.apply_affinity(x, base.AFF_NUMERIC, r.enc)
        if x.flags.bit_and(MEM_INT) == 0 -> return GO_JUMP
        i_key = x.i
    }
    ci: v.csr_base + r.p1
    res := 0
    rc := btree.btree_table_moveto(db.btrees[v.csr[ci].bt], v.csr[ci].btc, i_key, false, res)
    v.csr[ci].moveto_target = i_key
    v.csr[ci].null_row = false
    v.csr[ci].cache_status = conn.CACHE_STALE
    v.csr[ci].deferred_moveto = false
    v.csr[ci].seek_result = res
    if res != 0 {
        if r.p2 != 0 -> return GO_JUMP
        rc = base.CORRUPT
    }
    if rc != base.OK -> return fail(r, rc)
    GO_NEXT
}

// OP_Sequence: cursor P1's sequence counter into P2, counting it up.
op_sequence: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    ci: v.csr_base + r.p1
    o: v.mem_base + r.p2
    run.out2(v, o)
    v.mem[o].i = v.csr[ci].seq_count
    v.csr[ci].seq_count += 1
    GO_NEXT
}

// ---------------------------------------------------------------------------
// Writes.

// OP_NewRowid: a rowid not in table cursor P1 into P2: one past the
// largest, at least one past the AUTOINCREMENT register P3 of the
// statement's own program; random once the largest is taken.
op_new_rowid: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    o: v.mem_base + r.p2
    run.out2(v, o)
    ci: v.csr_base + r.p1
    bt: v.csr[ci].bt
    btc: v.csr[ci].btc
    max_rowid: base.I64_MAX
    val := 0
    res := 0
    if !v.csr[ci].use_random_rowid {
        rc: btree.btree_last(db.btrees[bt], btc, res)
        if rc != base.OK -> return fail(r, rc)
        if res != 0 {
            val = 1
        } else {
            val = btree.btree_integer_key(db.btrees[bt], btc)
            if val >= max_rowid {
                v.csr[ci].use_random_rowid = true
            } else {
                val += 1
            }
        }
    }
    if r.p3 != 0 {
        pm: if v.frames.len() > 0 -> v.frames[0].mem_base + r.p3 else -> v.mem_base + r.p3
        mem.integerify(v.mem[pm])
        if v.mem[pm].i == max_rowid || v.csr[ci].use_random_rowid -> return fail(r, base.FULL)
        if val < v.mem[pm].i + 1 -> val = v.mem[pm].i + 1
        v.mem[pm].i = val
    }
    if v.csr[ci].use_random_rowid {
        cnt := 0
        rc := base.OK
        going := true
        loop going {
            bytes: os.os_random_bytes(8)
            x := 0
            loop k in 0..<8 -> x = x.bit_or(Int.from_u8(bytes[k]) << (8 * k))
            val = x.bit_and(max_rowid >> 1) + 1
            rc = btree.btree_table_moveto(db.btrees[bt], btc, val, false, res)
            cnt += 1
            going = rc == base.OK && res == 0 && cnt < 100
        }
        if rc != base.OK -> return fail(r, rc)
        if res == 0 -> return fail(r, base.FULL)
    }
    v.csr[ci].deferred_moveto = false
    v.csr[ci].cache_status = conn.CACHE_STALE
    v.mem[o].i = val
    GO_NEXT
}

// OP_Insert: the record P2 as row P3 of table cursor P1, reported to the
// update hook for table P4.
op_insert: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    di: v.mem_base + r.p2
    ki: v.mem_base + r.p3
    ci: v.csr_base + r.p1
    n_key: v.mem[ki].i
    tab := -1
    if v.ops[r.pc].p4 == .Table(t) {
        if h.has_update_hook(db) -> tab = t
    }
    if r.p5.bit_and(conn.OPFLAG_NCHANGE) != 0 {
        v.n_change += 1
        if r.p5.bit_and(conn.OPFLAG_LASTROWID) != 0 -> db.last_rowid = n_key
    }
    seek_result: if r.p5.bit_and(conn.OPFLAG_USESEEKRESULT) != 0 -> v.csr[ci].seek_result else -> 0
    n_zero: if v.mem[di].flags.bit_and(MEM_ZERO) != 0 -> v.mem[di].i else -> 0
    x: btree.BtreePayload{key: [U8]{}, n_key: n_key, data: v.mem[di].z, n_data: v.mem[di].z.len(), n_zero: n_zero, mem: [base.Mem]{}}
    flags: r.p5.bit_and(conn.OPFLAG_APPEND.bit_or(conn.OPFLAG_SAVEPOSITION).bit_or(conn.OPFLAG_PREFORMAT))
    rc: btree.btree_insert(db.btrees[v.csr[ci].bt], v.csr[ci].btc, x, flags, seek_result)
    v.csr[ci].deferred_moveto = false
    v.csr[ci].cache_status = conn.CACHE_STALE
    if rc != base.OK -> return fail(r, rc)
    if tab >= 0 {
        op: if r.p5.bit_and(conn.OPFLAG_ISUPDATE) != 0 -> conn.AUTH_UPDATE else -> conn.AUTH_INSERT
        schema: db.dbs[v.csr[ci].i_db].name.copy()
        name: db.tables[tab].name.copy()
        h.update_hook(db, op, schema, name, n_key)
    }
    GO_NEXT
}

// OP_RowCell: copy the row cursor P2 is on into cursor P1 as row P3
// (VACUUM and the xfer optimization).
op_row_cell: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    dest: v.csr_base + r.p1
    src: v.csr_base + r.p2
    i_key: if r.p3 != 0 -> v.mem[v.mem_base + r.p3].i else -> 0
    sbt: v.csr[src].bt
    out := [U8]{}
    rc := btree.btree_transfer_source(db.btrees[sbt], v.csr[src].btc, out)
    if rc == base.OK -> rc = btree.btree_transfer_row(db.btrees[v.csr[dest].bt], v.csr[dest].btc, out, i_key)
    if rc != base.OK -> return fail(r, rc)
    GO_NEXT
}

// OP_Delete: delete the row cursor P1 is on; with OPFLAG_NCHANGE it counts
// and goes to the update hook for table P4.
op_delete: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    bt: v.csr[ci].bt
    btc: v.csr[ci].btc
    tab := -1
    if v.ops[r.pc].p4 == .Table(t) {
        if h.has_update_hook(db) {
            tab = t
            if r.p5.bit_and(conn.OPFLAG_SAVEPOSITION) != 0 && v.csr[ci].is_table {
                v.csr[ci].moveto_target = btree.btree_integer_key(db.btrees[bt], btc)
            }
        }
    }
    rc: btree.btree_delete(db.btrees[bt], btc, r.p5)
    v.csr[ci].cache_status = conn.CACHE_STALE
    v.csr[ci].seek_result = 0
    if rc != base.OK -> return fail(r, rc)
    if r.p2.bit_and(conn.OPFLAG_NCHANGE) != 0 {
        v.n_change += 1
        if tab >= 0 && db.tables[tab].tab_flags.bit_and(ast.TF_WITHOUT_ROWID) == 0 {
            schema: db.dbs[v.csr[ci].i_db].name.copy()
            name: db.tables[tab].name.copy()
            h.update_hook(db, conn.AUTH_DELETE, schema, name, v.csr[ci].moveto_target)
        }
    }
    GO_NEXT
}

// OP_ResetCount: the statement's change count becomes the connection's.
op_reset_count: fn(db: &conn.Conn, v: &conn.Vdbe) -> Int Never! {
    aux.set_changes(db, v.n_change)
    v.n_change = 0
    GO_NEXT
}

// OP_SorterCompare: jump when the first P4 fields of sorter P1's record
// differ from record P3.
op_sorter_compare: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    ci: v.csr_base + r.p1
    s := sorter_take(v, ci)
    res: sorter.sorter_compare(s, v.csr[ci].key_info ?? no_key_info(), v.mem[v.mem_base + r.p3].z, run.p4_int(v, r.pc))
    sorter_put(v, ci, s)
    if res != 0 -> return GO_JUMP
    GO_NEXT
}

// OP_SorterData: sorter P1's record into P2; pseudo cursor P3 rereads it.
op_sorter_data: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    ci: v.csr_base + r.p1
    s := sorter_take(v, ci)
    key: sorter.sorter_key(s)
    sorter_put(v, ci, s)
    run.reg_set(v, v.mem_base + r.p2, base.mem_blob(key))
    v.csr[v.csr_base + r.p3].cache_status = conn.CACHE_STALE
    GO_NEXT
}

// OP_RowData: the record cursor P1 is on into P2.
op_row_data: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    o: v.mem_base + r.p2
    run.out2(v, o)
    ci: v.csr_base + r.p1
    bt: v.csr[ci].bt
    btc: v.csr[ci].btc
    n: btree.btree_payload_size(db.btrees[bt], btc)
    if n > db.limits[ast.LIMIT_LENGTH] -> return GO_TOO_BIG
    buf := [U8]{}
    at := 0
    rc: aux.cursor_payload(db, bt, btc, n, buf, at)
    if rc != base.OK -> return fail(r, rc)
    v.mem[o] = base.mem_blob(buf[at..<at + n].copy())
    GO_NEXT
}

// OP_Rowid: the rowid of the row cursor P1 is on into P2 (NULL on its
// NULL row).
op_rowid: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    o: v.mem_base + r.p2
    run.out2(v, o)
    ci: v.csr_base + r.p1
    val := 0
    if v.csr[ci].null_row {
        v.mem[o].flags = MEM_NULL
        return GO_NEXT
    } else if v.csr[ci].deferred_moveto {
        val = v.csr[ci].moveto_target
    } else if v.csr[ci].cur_type == conn.CURTYPE_VTAB {
        rc: h.vtab_rowid(db, v.csr[ci].vtab_cursor, val)
        aux.vtab_import_errmsg<H>(h, db, v, v.csr[ci].vtab)
        if rc != base.OK -> return fail(r, rc)
    } else {
        rc: aux.cursor_restore(db, v, ci)
        if rc != base.OK -> return fail(r, rc)
        if v.csr[ci].null_row {
            v.mem[o].flags = MEM_NULL
            return GO_NEXT
        }
        val = btree.btree_integer_key(db.btrees[v.csr[ci].bt], v.csr[ci].btc)
    }
    v.mem[o].i = val
    GO_NEXT
}

// OP_NullRow: cursor P1 (opened as an empty pseudo cursor when closed) is
// on its NULL row.
op_null_row: fn<H: Host>(h: &H, db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci := v.csr_base + r.p1
    if !v.csr[ci].live {
        ci = run.alloc_cursor<H>(h, db, v, r.p1, 1, conn.CURTYPE_PSEUDO)
        v.csr[ci].pseudo_reg = 0
        v.csr[ci].is_table = true
        v.csr[ci].no_reuse = true
    }
    v.csr[ci].null_row = true
    v.csr[ci].cache_status = conn.CACHE_STALE
    if v.csr[ci].cur_type == conn.CURTYPE_BTREE -> btree.btree_clear_cursor(db.btrees[v.csr[ci].bt], v.csr[ci].btc)
    GO_NEXT
}

// ---------------------------------------------------------------------------
// Scans.

// OP_SeekEnd, OP_Last: move cursor P1 to its last entry (Last jumps to P2,
// when set, on an empty table; SeekEnd keeps a cursor already on a row).
op_last: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    bt: v.csr[ci].bt
    btc: v.csr[ci].btc
    if r.op == opc.OP_SEEK_END {
        v.csr[ci].seek_result = -1
        if btree.btree_cursor_is_valid_nn(db.btrees[bt], btc) -> return GO_NEXT
    }
    res := 0
    rc: btree.btree_last(db.btrees[bt], btc, res)
    v.csr[ci].null_row = res != 0
    v.csr[ci].deferred_moveto = false
    v.csr[ci].cache_status = conn.CACHE_STALE
    if rc != base.OK -> return fail(r, rc)
    if r.p2 > 0 && res != 0 -> return GO_JUMP
    GO_NEXT
}

// OP_IfSmaller: jump when cursor P1's table is empty or has fewer than
// about 10^(P3/10) rows.
op_if_smaller: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    bt: v.csr[ci].bt
    btc: v.csr[ci].btc
    res := 0
    rc: btree.btree_first(db.btrees[bt], btc, res)
    if rc != base.OK -> return fail(r, rc)
    if res == 0 {
        sz: btree.btree_row_count_est(db.btrees[bt], btc)
        if sz >= 0 && util.log_est(sz) < r.p3 -> res = 1
    }
    if res != 0 -> return GO_JUMP
    GO_NEXT
}

// OP_SorterSort, OP_Sort, OP_Rewind: move cursor P1 to its first entry,
// jumping to P2 when there is none.
op_rewind: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    if r.op != opc.OP_REWIND -> v.counters[conn.STMTSTATUS_SORT] = v.counters[conn.STMTSTATUS_SORT] + 1
    ci: v.csr_base + r.p1
    res := 1
    rc := base.OK
    if v.csr[ci].cur_type == conn.CURTYPE_SORTER {
        s := sorter_take(v, ci)
        res = if sorter.sorter_rewind(s) -> 1 else -> 0
        sorter_put(v, ci, s)
    } else {
        rc = btree.btree_first(db.btrees[v.csr[ci].bt], v.csr[ci].btc, res)
        v.csr[ci].deferred_moveto = false
        v.csr[ci].cache_status = conn.CACHE_STALE
    }
    if rc != base.OK -> return fail(r, rc)
    v.csr[ci].null_row = res != 0
    if r.p2 > 0 && res != 0 -> return GO_JUMP
    GO_NEXT
}

// OP_SorterNext, OP_Prev, OP_Next: step cursor P1 and jump to P2 while it
// is on an entry, counting the step in counter P5.
op_next: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    rc := base.OK
    if r.op == opc.OP_SORTER_NEXT {
        s := sorter_take(v, ci)
        rc = sorter.sorter_next(s)
        sorter_put(v, ci, s)
    } else if r.op == opc.OP_PREV {
        rc = btree.btree_previous(db.btrees[v.csr[ci].bt], v.csr[ci].btc, r.p3)
    } else {
        rc = btree.btree_next(db.btrees[v.csr[ci].bt], v.csr[ci].btc, r.p3)
    }
    v.csr[ci].cache_status = conn.CACHE_STALE
    if rc == base.OK {
        v.csr[ci].null_row = false
        v.counters[r.p5] = v.counters[r.p5] + 1
        return GO_JUMP_CHECK
    }
    if rc != base.DONE -> return fail(r, rc)
    v.csr[ci].null_row = true
    GO_NEXT_CHECK
}

// ---------------------------------------------------------------------------
// Indexes.

// OP_IdxInsert: the index record P2 into cursor P1, its P4 fields
// unpacked in the registers from P3.
op_idx_insert: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    i2: v.mem_base + r.p2
    if r.p5.bit_and(conn.OPFLAG_NCHANGE) != 0 -> v.n_change += 1
    mem.expand_blob(v.mem[i2])
    x: btree.BtreePayload{key: v.mem[i2].z, n_key: v.mem[i2].z.len(), data: [U8]{}, n_data: 0, n_zero: 0, mem: regs(v, v.mem_base + r.p3, run.p4_int(v, r.pc))}
    seek_result: if r.p5.bit_and(conn.OPFLAG_USESEEKRESULT) != 0 -> v.csr[ci].seek_result else -> 0
    flags: r.p5.bit_and(conn.OPFLAG_APPEND.bit_or(conn.OPFLAG_SAVEPOSITION).bit_or(conn.OPFLAG_PREFORMAT))
    rc: btree.btree_insert(db.btrees[v.csr[ci].bt], v.csr[ci].btc, x, flags, seek_result)
    v.csr[ci].cache_status = conn.CACHE_STALE
    if rc != base.OK -> return fail(r, rc)
    GO_NEXT
}

// OP_SorterInsert: the record P2 into sorter P1.
op_sorter_insert: fn(v: &conn.Vdbe, r: &Run) -> Int Never! {
    ci: v.csr_base + r.p1
    i2: v.mem_base + r.p2
    mem.expand_blob(v.mem[i2])
    s := sorter_take(v, ci)
    sorter.sorter_write(s, v.mem[i2].z)
    sorter_put(v, ci, s)
    GO_NEXT
}

// OP_IdxDelete: delete the entry of index cursor P1 whose key is the P3
// registers from P2; with P5 a missing entry is a corrupt index.
op_idx_delete: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    bt: v.csr[ci].bt
    btc: v.csr[ci].btc
    key := regs_key(v, ci, v.mem_base + r.p2, r.p3)
    res := 0
    rc := btree.btree_index_moveto(db.btrees[bt], btc, key, res)
    if rc != base.OK -> return fail(r, rc)
    if res == 0 {
        rc = btree.btree_delete(db.btrees[bt], btc, btree.BTREE_AUXDELETE)
        if rc != base.OK -> return fail(r, rc)
    } else if r.p5 != 0 && db.flags.bit_and(btree.SQLITE_WRITE_SCHEMA) == 0 {
        return fail(r, base.CORRUPT_INDEX)
    }
    v.csr[ci].cache_status = conn.CACHE_STALE
    v.csr[ci].seek_result = 0
    GO_NEXT
}

// OP_DeferredSeek, OP_IdxRowid: the rowid at the end of index cursor P1's
// entry: DeferredSeek defers table cursor P3's seek to it (P4 maps table
// columns to index columns OP_Column reads instead), IdxRowid writes it
// to P2.
op_idx_rowid: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    rc := aux.cursor_restore(db, v, ci)
    if rc != base.OK -> return fail(r, rc)
    if v.csr[ci].null_row {
        if r.op == opc.OP_IDX_ROWID -> run.reg_null(v, v.mem_base + r.p2)
        return GO_NEXT
    }
    rowid := 0
    rc = aux.idx_rowid(db, v.csr[ci].bt, v.csr[ci].btc, rowid)
    if rc != base.OK -> return fail(r, rc)
    if r.op == opc.OP_DEFERRED_SEEK {
        tc: v.csr_base + r.p3
        v.csr[tc].null_row = false
        v.csr[tc].moveto_target = rowid
        v.csr[tc].deferred_moveto = true
        v.csr[tc].cache_status = conn.CACHE_STALE
        v.csr[tc].alt_map = if v.ops[r.pc].p4 == .IntArray(a) -> a.copy() else -> [Int]{}
        v.csr[tc].alt_cursor = ci
    } else {
        o: v.mem_base + r.p2
        run.out2(v, o)
        v.mem[o].i = rowid
    }
    GO_NEXT
}

// OP_FinishSeek: do cursor P1's deferred seek.
op_finish_seek: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    if v.csr[ci].deferred_moveto {
        rc: aux.finish_moveto(db, v, ci)
        if rc != base.OK -> return fail(r, rc)
    }
    GO_NEXT
}

// OP_IdxLE, OP_IdxGT, OP_IdxLT, OP_IdxGE: jump when index cursor P1's
// entry, without its rowid, compares so with the P4 registers from P3.
op_idx_compare: fn(db: &conn.Conn, v: &conn.Vdbe, r: &Run) -[DB]> Int Never! {
    ci: v.csr_base + r.p1
    key := regs_key(v, ci, v.mem_base + r.p3, run.p4_int(v, r.pc))
    key.default_rc = if r.op < opc.OP_IDX_LT -> -1 else -> 0
    res := 0
    rc: aux.idx_key_compare(db, v.csr[ci].bt, v.csr[ci].btc, key, res)
    if rc != base.OK -> return fail(r, rc)
    if r.op.bit_and(1) == opc.OP_IDX_LT.bit_and(1) {
        res = -res
    } else {
        res += 1
    }
    if res > 0 -> return GO_JUMP
    GO_NEXT
}

#Test("records are built from registers once the affinities apply") {
    db := conn.conn_new()
    v := conn.vdbe_new()
    v.mem.push(base.mem_text(" 12 ".bytes(), base.UTF8))
    v.mem.push(base.mem_text("ab".bytes(), base.UTF8))
    v.mem.push(base.mem_null())
    v.mem.push(base.mem_null())
    v.ops.push(test_op(opc.OP_AFFINITY, conn.P4.Text("D".bytes())))
    v.ops.push(test_op(opc.OP_MAKE_RECORD, conn.P4.NotUsed))
    aff := test_run(v, 0, 0, 0, 0)
    assert_eq(op_affinity(v, aff), GO_NEXT)
    assert(v.mem[0].flags.bit_and(MEM_INT) != 0 && v.mem[0].i == 12)
    mk := test_run(v, 1, 0, 3, 3)
    assert_eq(op_make_record(db, v, mk), GO_NEXT)
    back := record.decode_record(v.mem[3].z, base.UTF8) ?? panic("decode")
    assert(back.len() == 3 && back[0].i == 12 && back[1].z == "ab".bytes() && back[2].flags.bit_and(MEM_NULL) != 0)
}

#Test("a cursor's sequence counts up and its first test jumps") {
    v := conn.vdbe_new()
    v.mem.push(base.mem_null())
    v.csr.push(conn.vdbe_cursor_closed())
    v.ops.push(test_op(opc.OP_SEQUENCE_TEST, conn.P4.NotUsed))
    v.ops.push(test_op(opc.OP_SEQUENCE, conn.P4.NotUsed))
    st := test_run(v, 0, 0, 0, 0)
    assert_eq(op_sequence_test(v, st), GO_JUMP)
    assert_eq(op_sequence_test(v, st), GO_NEXT)
    sq := test_run(v, 1, 0, 0, 0)
    assert_eq(op_sequence(v, sq), GO_NEXT)
    assert(v.mem[0].flags == MEM_INT && v.mem[0].i == 2)
    assert_eq(op_if_not_open(v, sq), GO_JUMP_CHECK)
}
