// The page cache of the Jet SQLite engine: a port of SQLite 3.45.0
// pcache.c (the dirty list, reference counts and the spill choice of
// sqlite3PcacheFetchStress) over pcache1.c (the default page allocator:
// the page hash, the pinned count and the LRU of unpinned pages), with
// bitvec.c, the page-number sets the pager keeps.
//
// A page is a slot of PCache.pages, and a slot index stands for C's PgHdr
// pointer; -1 is the null pointer. In the vendored build (THREADSAFE=1, no
// SQLITE_CONFIG_PAGECACHE) pcache1.separateCache is true, so each cache is
// the only member of its PGroup and the group's counters live here.
// pcache1's bulk allocation and the soft heap limit (pcache1UnderMemory-
// Pressure, false without SQLITE_CONFIG_PAGECACHE or a heap limit) have no
// counterpart. The hash is a map from page number to slot, so
// pcache1ResizeHash has no counterpart either. pcache.c's pDirty chain,
// the list sqlite3PcacheDirtyList builds, is a list of slots sorted by
// page number.
//
// The pager's xStress callback cannot be called from here, since the pager
// sits above the cache. sqlite3PcacheFetchStress is split in two:
// pcache_stress_victim chooses the dirty page to spill, the pager spills
// it, and pcache_fetch_stress then fetches with create flag 2.

// PgHdr.flags (pcache.h).
PGHDR_CLEAN: 1
PGHDR_DIRTY: 2
PGHDR_WRITEABLE: 4
PGHDR_NEED_SYNC: 8
PGHDR_DONT_WRITE: 16
PGHDR_MMAP: 32
PGHDR_WAL_APPEND: 64

// The null slot.
NO_PAGE: -1

// pcache1Cachesize's ceiling on a group's page count.
PCACHE1_MAX_PAGES: 2147418112

// bitvec.c Bitvec: a set of page numbers in 1..size. C's three layouts
// (bitmap, hash, sub-bitmaps) only bound memory; the set they hold is the
// same. A Bitvec that is not live is the null Bitvec pointer.
Bitvec: struct {
    live: Bool
    size: Int
    members: [Int: Bool]
}

// The null Bitvec.
bitvec_none: fn() -> Bitvec Never! { Bitvec{live: false, size: 0, members: [Int: Bool]{}} }

// sqlite3BitvecCreate.
bitvec_create: fn(size: Int) -> Bitvec Never! { Bitvec{live: true, size: size, members: [Int: Bool]{}} }

// sqlite3BitvecTest: false for the null Bitvec and for i outside 1..size.
bitvec_test: fn(b: Bitvec, i: Int) -> Bool Never! {
    if !b.live -> return false
    bitvec_test_not_null(b, i)
}

// sqlite3BitvecTestNotNull.
bitvec_test_not_null: fn(b: Bitvec, i: Int) -> Bool Never! {
    if i < 1 || i > b.size -> return false
    b.members.has_key(i)
}

// sqlite3BitvecSet; i is in 1..size.
bitvec_set: fn(b: &Bitvec, i: Int) Never! {
    if !b.live -> return
    _: b.members.add(i, true)
}

// sqlite3BitvecClear.
bitvec_clear: fn(b: &Bitvec, i: Int) Never! {
    if !b.live -> return
    _: b.members.remove(i)
}

// sqlite3BitvecSize.
bitvec_size: fn(b: Bitvec) -> Int Never! { b.size }

// A cache page: pcache.c PgHdr with its pcache1.c PgHdr1.
PgHdr: struct {
    // pData: the page image.
    data: [U8]
    // pgno.
    pgno: Int
    // flags, PGHDR_*.
    flags: Int
    // nRef.
    nref: Int
    // pDirtyNext and pDirtyPrev; valid while the page is dirty.
    dirty_next: Int
    dirty_prev: Int
    // PgHdr.pPage != 0: the header was set up by pcacheFetchFinishWithInit.
    init: Bool
    // PgHdr.pPager != 0: the pager has filled the page (getPageNormal).
    loaded: Bool
    // The first 8 bytes of pExtra were zeroed and the owner of the extra
    // space has not looked since (it clears this when it does).
    extra_reset: Bool
    // PgHdr1.iKey.
    key: Int
    // The slot holds a page of the hash (it is not on the free list).
    live: Bool
    // PAGE_IS_UNPINNED: the page is on the LRU list.
    unpinned: Bool
    // PgHdr1.pLruNext and pLruPrev.
    lru_next: Int
    lru_prev: Int
}

// pcache.c PCache with its pcache1.c PCache1 and PGroup.
PCache: struct {
    pages: [PgHdr]
    // pDirty, pDirtyTail and pSynced.
    dirty: Int
    dirty_tail: Int
    synced: Int
    // nRefSum.
    nref_sum: Int
    // szCache, szSpill, szPage, szExtra, bPurgeable and eCreate.
    sz_cache: Int
    sz_spill: Int
    sz_page: Int
    sz_extra: Int
    purgeable: Bool
    create: Int
    // pCache != 0: the pcache1 cache exists.
    open: Bool
    // PCache1: apHash, the free slots, nPage, nRecyclable, iMaxKey, nMax,
    // nMin and n90pct.
    hash: [Int: Int]
    free: [Int]
    npage: Int
    nrecyclable: Int
    max_key: Int
    nmax: Int
    nmin: Int
    n90pct: Int
    // PGroup: nMaxPage, nMinPage, mxPinned, nPurgeable and the LRU list
    // (lru.pLruNext is the most recently unpinned page).
    group_max_page: Int
    group_min_page: Int
    mx_pinned: Int
    npurgeable: Int
    lru_head: Int
    lru_tail: Int
}

// A cache before sqlite3PcacheOpen (the zeroed PCache inside a new Pager).
pcache_unopened: fn() -> PCache Never! {
    PCache{pages: [PgHdr]{}, dirty: NO_PAGE, dirty_tail: NO_PAGE, synced: NO_PAGE, nref_sum: 0, sz_cache: 0, sz_spill: 0, sz_page: 0, sz_extra: 0, purgeable: false, create: 0, open: false, hash: [Int: Int]{}, free: [Int]{}, npage: 0, nrecyclable: 0, max_key: 0, nmax: 0, nmin: 0, n90pct: 0, group_max_page: 0, group_min_page: 0, mx_pinned: 10, npurgeable: 0, lru_head: NO_PAGE, lru_tail: NO_PAGE}
}

// ---- pcache1.c --------------------------------------------------------

// pcache1Create, into the cache's pcache1 fields (any old pcache1 cache
// was destroyed first).
p1_create: fn(c: &PCache, purgeable: Bool) Never! {
    c.pages = [PgHdr]{}
    c.hash = [Int: Int]{}
    c.free = [Int]{}
    c.npage = 0
    c.nrecyclable = 0
    c.max_key = 0
    c.nmax = 0
    c.nmin = 0
    c.n90pct = 0
    c.group_max_page = 0
    c.group_min_page = 0
    c.mx_pinned = 10
    c.npurgeable = 0
    c.lru_head = NO_PAGE
    c.lru_tail = NO_PAGE
    if purgeable {
        c.nmin = 10
        c.group_min_page += c.nmin
        c.mx_pinned = c.group_max_page + 10 - c.group_min_page
    }
}

// pcache1PinPage: take an unpinned page off the LRU list.
p1_pin: fn(c: &PCache, s: Int) Never! {
    prev: c.pages[s].lru_prev
    next: c.pages[s].lru_next
    if prev == NO_PAGE -> c.lru_head = next else -> c.pages[prev].lru_next = next
    if next == NO_PAGE -> c.lru_tail = prev else -> c.pages[next].lru_prev = prev
    c.pages[s].lru_prev = NO_PAGE
    c.pages[s].lru_next = NO_PAGE
    c.pages[s].unpinned = false
    c.nrecyclable -= 1
}

// pcache1FreePage.
p1_free_page: fn(c: &PCache, s: Int) Never! {
    c.pages[s].live = false
    c.pages[s].init = false
    c.free.push(s)
    if c.purgeable -> c.npurgeable -= 1
}

// pcache1RemoveFromHash.
p1_remove_from_hash: fn(c: &PCache, s: Int, free_flag: Bool) Never! {
    _: c.hash.remove(c.pages[s].key)
    c.npage -= 1
    if free_flag -> p1_free_page(c, s)
}

// pcache1EnforceMaxPage: free unpinned pages past the group's limit.
p1_enforce_max_page: fn(c: &PCache) Never! {
    loop c.npurgeable > c.group_max_page && c.lru_tail != NO_PAGE {
        s: c.lru_tail
        p1_pin(c, s)
        p1_remove_from_hash(c, s, true)
    }
}

// pcache1AllocPage: a fresh slot (its old bytes, like malloc's, unset).
p1_alloc_page: fn(c: &PCache) -> Int Never! {
    s := NO_PAGE
    if c.free.len() > 0 {
        s = c.free.pop() ?? NO_PAGE
        if c.pages[s].data.len() != c.sz_page {
            buf := [U8]{}
            loop _i in 0..<c.sz_page -> buf.push(U8{0})
            c.pages[s].data = buf
        }
    } else {
        buf := [U8]{}
        loop _i in 0..<c.sz_page -> buf.push(U8{0})
        c.pages.push(PgHdr{data: buf, pgno: 0, flags: 0, nref: 0, dirty_next: NO_PAGE, dirty_prev: NO_PAGE, init: false, loaded: false, extra_reset: false, key: 0, live: false, unpinned: false, lru_next: NO_PAGE, lru_prev: NO_PAGE})
        s = c.pages.len() - 1
    }
    if c.purgeable -> c.npurgeable += 1
    s
}

// pcache1Cachesize.
p1_cachesize: fn(c: &PCache, max: Int) Never! {
    if !c.purgeable -> return
    n := max.bit_and(4294967295)
    if n > PCACHE1_MAX_PAGES - c.group_max_page + c.nmax -> n = PCACHE1_MAX_PAGES - c.group_max_page + c.nmax
    c.group_max_page += n - c.nmax
    c.mx_pinned = c.group_max_page + 10 - c.group_min_page
    c.nmax = n
    c.n90pct = c.nmax * 9 /% 10
    p1_enforce_max_page(c)
}

// pcache1Shrink.
p1_shrink: fn(c: &PCache) Never! {
    if !c.purgeable -> return
    saved: c.group_max_page
    c.group_max_page = 0
    p1_enforce_max_page(c)
    c.group_max_page = saved
}

// pcache1FetchStage2: a new page for key, or -1.
p1_fetch_stage2: fn(c: &PCache, key: Int, create_flag: Int) -> Int Never! {
    pinned: c.npage - c.nrecyclable
    if create_flag == 1 && (pinned >= c.mx_pinned || pinned >= c.n90pct) -> return NO_PAGE
    s := NO_PAGE
    if c.purgeable && c.lru_tail != NO_PAGE && c.npage + 1 >= c.nmax {
        // Recycle the least recently used page; every page of this cache
        // has the same szAlloc.
        s = c.lru_tail
        p1_remove_from_hash(c, s, false)
        p1_pin(c, s)
    }
    if s == NO_PAGE -> s = p1_alloc_page(c)
    c.npage += 1
    c.pages[s].key = key
    c.pages[s].live = true
    c.pages[s].unpinned = false
    c.pages[s].lru_next = NO_PAGE
    c.pages[s].lru_prev = NO_PAGE
    // *(void **)pPage->page.pExtra = 0: the PgHdr is not set up.
    c.pages[s].init = false
    _: c.hash.add(key, s)
    if key > c.max_key -> c.max_key = key
    s
}

// pcache1Fetch.
p1_fetch: fn(c: &PCache, key: Int, create_flag: Int) -> Int Never! {
    if c.hash.get(key) == .Val(s) {
        if c.pages[s].unpinned -> p1_pin(c, s)
        return s
    }
    if create_flag != 0 -> return p1_fetch_stage2(c, key, create_flag)
    NO_PAGE
}

// pcache1Unpin.
p1_unpin: fn(c: &PCache, s: Int, reuse_unlikely: Bool) Never! {
    if reuse_unlikely || c.npurgeable > c.group_max_page {
        p1_remove_from_hash(c, s, true)
        return
    }
    c.pages[s].lru_prev = NO_PAGE
    c.pages[s].lru_next = c.lru_head
    if c.lru_head == NO_PAGE -> c.lru_tail = s else -> c.pages[c.lru_head].lru_prev = s
    c.lru_head = s
    c.pages[s].unpinned = true
    c.nrecyclable += 1
}

// pcache1Rekey.
p1_rekey: fn(c: &PCache, s: Int, new_key: Int) Never! {
    _: c.hash.remove(c.pages[s].key)
    c.pages[s].key = new_key
    _: c.hash.add(new_key, s)
    if new_key > c.max_key -> c.max_key = new_key
}

// pcache1TruncateUnsafe: drop every page whose key is limit or more.
p1_truncate_unsafe: fn(c: &PCache, limit: Int) Never! {
    doomed := [Int]{}
    loop key in c.hash.keys() {
        if key >= limit -> doomed.push(c.hash.get(key) ?? NO_PAGE)
    }
    loop s in doomed {
        _: c.hash.remove(c.pages[s].key)
        c.npage -= 1
        if c.pages[s].unpinned -> p1_pin(c, s)
        p1_free_page(c, s)
    }
}

// pcache1Truncate.
p1_truncate: fn(c: &PCache, limit: Int) Never! {
    if limit <= c.max_key {
        p1_truncate_unsafe(c, limit)
        c.max_key = limit - 1
    }
}

// pcache1Destroy.
p1_destroy: fn(c: &PCache) Never! {
    if c.npage > 0 -> p1_truncate_unsafe(c, 0)
    c.group_max_page -= c.nmax
    c.group_min_page -= c.nmin
    c.mx_pinned = c.group_max_page + 10 - c.group_min_page
    p1_enforce_max_page(c)
    c.pages = [PgHdr]{}
    c.hash = [Int: Int]{}
    c.free = [Int]{}
    c.npage = 0
    c.nrecyclable = 0
    c.lru_head = NO_PAGE
    c.lru_tail = NO_PAGE
}

// ---- pcache.c ---------------------------------------------------------

// pcacheManageDirtyList's addRemove bits.
DIRTYLIST_REMOVE: 1
DIRTYLIST_ADD: 2
DIRTYLIST_FRONT: 3

// pcacheManageDirtyList.
manage_dirty_list: fn(c: &PCache, s: Int, add_remove: Int) Never! {
    if add_remove.bit_and(DIRTYLIST_REMOVE) != 0 {
        if c.synced == s -> c.synced = c.pages[s].dirty_prev
        next: c.pages[s].dirty_next
        prev: c.pages[s].dirty_prev
        if next != NO_PAGE -> c.pages[next].dirty_prev = prev else -> c.dirty_tail = prev
        if prev != NO_PAGE {
            c.pages[prev].dirty_next = next
        } else {
            c.dirty = next
            if c.dirty == NO_PAGE -> c.create = 2
        }
    }
    if add_remove.bit_and(DIRTYLIST_ADD) != 0 {
        c.pages[s].dirty_prev = NO_PAGE
        c.pages[s].dirty_next = c.dirty
        if c.dirty != NO_PAGE {
            c.pages[c.dirty].dirty_prev = s
        } else {
            c.dirty_tail = s
            if c.purgeable -> c.create = 1
        }
        c.dirty = s
        if c.synced == NO_PAGE && c.pages[s].flags.bit_and(PGHDR_NEED_SYNC) == 0 -> c.synced = s
    }
}

// pcacheUnpin.
pcache_unpin: fn(c: &PCache, s: Int) Never! {
    if c.purgeable -> p1_unpin(c, s, false)
}

// numberOfCachePages: a negative cache size is a size in KiB.
pcache_pages_for: fn(c: PCache) -> Int Never! {
    if c.sz_cache >= 0 -> return c.sz_cache
    n := (-1024 * c.sz_cache) /% (c.sz_page + c.sz_extra)
    if n > 1000000000 -> n = 1000000000
    n
}

// sqlite3PcacheOpen. sz_extra is the pager's nExtra, the size the owner
// of each page's extra space has in C (it counts in the KiB cache size).
pcache_open: fn(c: &PCache, sz_page: Int, sz_extra: Int, purgeable: Bool) Never! {
    c.pages = [PgHdr]{}
    c.dirty = NO_PAGE
    c.dirty_tail = NO_PAGE
    c.synced = NO_PAGE
    c.nref_sum = 0
    c.sz_page = 1
    c.sz_extra = sz_extra
    c.purgeable = purgeable
    c.create = 2
    c.sz_cache = 100
    c.sz_spill = 1
    c.open = false
    pcache_set_page_size(c, sz_page)
}

// sqlite3PcacheSetPageSize: a new pcache1 cache for the new page size.
pcache_set_page_size: fn(c: &PCache, sz_page: Int) Never! {
    if c.sz_page == 0 -> return
    if c.open -> p1_destroy(c)
    c.sz_page = sz_page
    p1_create(c, c.purgeable)
    n: pcache_pages_for(c)
    p1_cachesize(c, n)
    c.open = true
}

// sqlite3PcacheFetch: the slot of page pgno, or -1. createFlag 3 creates
// as far as eCreate allows.
pcache_fetch: fn(c: &PCache, pgno: Int, create_flag: Int) -> Int Never! {
    create: create_flag.bit_and(c.create)
    p1_fetch(c, pgno, create)
}

// The first half of sqlite3PcacheFetchStress: the dirty page the pager
// should spill (xStress) before pcache_fetch_stress, or -1.
pcache_stress_victim: fn(c: &PCache) -> Int Never! {
    if c.create == 2 -> return NO_PAGE
    if c.npage <= c.sz_spill -> return NO_PAGE
    p := c.synced
    loop p != NO_PAGE && (c.pages[p].nref > 0 || c.pages[p].flags.bit_and(PGHDR_NEED_SYNC) != 0) -> p = c.pages[p].dirty_prev
    c.synced = p
    if p == NO_PAGE {
        p = c.dirty_tail
        loop p != NO_PAGE && c.pages[p].nref > 0 -> p = c.pages[p].dirty_prev
    }
    p
}

// The second half of sqlite3PcacheFetchStress: fetch with create flag 2,
// which always yields a page.
pcache_fetch_stress: fn(c: &PCache, pgno: Int) -> Int Never! {
    p1_fetch(c, pgno, 2)
}

// sqlite3PcacheFetchFinish (with pcacheFetchFinishWithInit).
pcache_fetch_finish: fn(c: &PCache, pgno: Int, s: Int) -> Int Never! {
    if !c.pages[s].init {
        c.pages[s].nref = 0
        c.pages[s].dirty_next = NO_PAGE
        c.pages[s].dirty_prev = NO_PAGE
        c.pages[s].loaded = false
        c.pages[s].extra_reset = true
        c.pages[s].init = true
        c.pages[s].pgno = pgno
        c.pages[s].flags = PGHDR_CLEAN
    }
    c.nref_sum += 1
    c.pages[s].nref += 1
    s
}

// sqlite3PcacheRelease.
pcache_release: fn(c: &PCache, s: Int) Never! {
    c.nref_sum -= 1
    c.pages[s].nref -= 1
    if c.pages[s].nref == 0 {
        if c.pages[s].flags.bit_and(PGHDR_CLEAN) != 0 -> pcache_unpin(c, s) else -> manage_dirty_list(c, s, DIRTYLIST_FRONT)
    }
}

// sqlite3PcacheRef.
pcache_ref: fn(c: &PCache, s: Int) Never! {
    c.pages[s].nref += 1
    c.nref_sum += 1
}

// sqlite3PcacheDrop: discard a page with one reference.
pcache_drop: fn(c: &PCache, s: Int) Never! {
    if c.pages[s].flags.bit_and(PGHDR_DIRTY) != 0 -> manage_dirty_list(c, s, DIRTYLIST_REMOVE)
    c.nref_sum -= 1
    p1_unpin(c, s, true)
}

// sqlite3PcacheMakeDirty.
pcache_make_dirty: fn(c: &PCache, s: Int) Never! {
    flags: c.pages[s].flags
    if flags.bit_and(PGHDR_CLEAN.bit_or(PGHDR_DONT_WRITE)) == 0 -> return
    f := flags.bit_and(PGHDR_DONT_WRITE.bit_not())
    if f.bit_and(PGHDR_CLEAN) != 0 {
        c.pages[s].flags = f.bit_xor(PGHDR_DIRTY.bit_or(PGHDR_CLEAN))
        manage_dirty_list(c, s, DIRTYLIST_ADD)
        return
    }
    c.pages[s].flags = f
}

// sqlite3PcacheMakeClean.
pcache_make_clean: fn(c: &PCache, s: Int) Never! {
    manage_dirty_list(c, s, DIRTYLIST_REMOVE)
    c.pages[s].flags = c.pages[s].flags.bit_and(PGHDR_DIRTY.bit_or(PGHDR_NEED_SYNC).bit_or(PGHDR_WRITEABLE).bit_not()).bit_or(PGHDR_CLEAN)
    if c.pages[s].nref == 0 -> pcache_unpin(c, s)
}

// sqlite3PcacheCleanAll.
pcache_clean_all: fn(c: &PCache) Never! {
    loop c.dirty != NO_PAGE -> pcache_make_clean(c, c.dirty)
}

// sqlite3PcacheClearWritable.
pcache_clear_writable: fn(c: &PCache) Never! {
    p := c.dirty
    loop p != NO_PAGE {
        c.pages[p].flags = c.pages[p].flags.bit_and(PGHDR_NEED_SYNC.bit_or(PGHDR_WRITEABLE).bit_not())
        p = c.pages[p].dirty_next
    }
    c.synced = c.dirty_tail
}

// sqlite3PcacheClearSyncFlags.
pcache_clear_sync_flags: fn(c: &PCache) Never! {
    p := c.dirty
    loop p != NO_PAGE {
        c.pages[p].flags = c.pages[p].flags.bit_and(PGHDR_NEED_SYNC.bit_not())
        p = c.pages[p].dirty_next
    }
    c.synced = c.dirty_tail
}

// sqlite3PcacheMove: give page s the number new_pgno, dropping any page
// that had it.
pcache_move: fn(c: &PCache, s: Int, new_pgno: Int) Never! {
    other: p1_fetch(c, new_pgno, 0)
    if other != NO_PAGE {
        c.pages[other].nref += 1
        c.nref_sum += 1
        pcache_drop(c, other)
    }
    p1_rekey(c, s, new_pgno)
    c.pages[s].pgno = new_pgno
    if c.pages[s].flags.bit_and(PGHDR_DIRTY) != 0 && c.pages[s].flags.bit_and(PGHDR_NEED_SYNC) != 0 -> manage_dirty_list(c, s, DIRTYLIST_FRONT)
}

// sqlite3PcacheTruncate: drop every page past pgno. With pgno 0 and pages
// still referenced, page 1 stays, zeroed.
pcache_truncate: fn(c: &PCache, pgno_in: Int) Never! {
    if !c.open -> return
    pgno := pgno_in
    p := c.dirty
    loop p != NO_PAGE {
        next: c.pages[p].dirty_next
        if c.pages[p].pgno > pgno -> pcache_make_clean(c, p)
        p = next
    }
    if pgno == 0 && c.nref_sum > 0 {
        one: p1_fetch(c, 1, 0)
        if one != NO_PAGE {
            loop i in 0..<c.sz_page -> c.pages[one].data[i] = U8{0}
            pgno = 1
        }
    }
    p1_truncate(c, pgno + 1)
}

// sqlite3PcacheClose.
pcache_close: fn(c: &PCache) Never! {
    if c.open -> p1_destroy(c)
    c.open = false
}

// sqlite3PcacheClear.
pcache_clear: fn(c: &PCache) Never! { pcache_truncate(c, 0) }

// sqlite3PcacheDirtyList: the dirty pages sorted by page number
// (pcacheSortDirtyList's merge sort gives the same order).
pcache_dirty_list: fn(c: PCache) -> [Int] Never! {
    pgnos := [Int]{}
    by_pgno := [Int: Int]{}
    p := c.dirty
    loop p != NO_PAGE {
        pgnos.push(c.pages[p].pgno)
        _: by_pgno.add(c.pages[p].pgno, p)
        p = c.pages[p].dirty_next
    }
    pgnos.sort()
    out := [Int]{}
    loop n in pgnos -> out.push(by_pgno.get(n) ?? NO_PAGE)
    out
}

// sqlite3PcacheRefCount.
pcache_ref_count: fn(c: PCache) -> Int Never! { c.nref_sum }

// sqlite3PcachePageRefcount.
pcache_page_refcount: fn(c: PCache, s: Int) -> Int Never! { c.pages[s].nref }

// sqlite3PcachePagecount.
pcache_pagecount: fn(c: PCache) -> Int Never! { c.npage }

// sqlite3PcacheGetCachesize.
pcache_get_cachesize: fn(c: PCache) -> Int Never! { pcache_pages_for(c) }

// sqlite3PcacheSetCachesize.
pcache_set_cachesize: fn(c: &PCache, max_page: Int) Never! {
    c.sz_cache = max_page
    n: pcache_pages_for(c)
    p1_cachesize(c, n)
}

// sqlite3PcacheSetSpillsize: set szSpill when max_page is not 0 and answer
// the spill size in effect.
pcache_set_spillsize: fn(c: &PCache, max_page: Int) -> Int Never! {
    if max_page != 0 {
        n := max_page
        if n < 0 -> n = (-1024 * n) /% (c.sz_page + c.sz_extra)
        c.sz_spill = n
    }
    res := pcache_pages_for(c)
    if res < c.sz_spill -> res = c.sz_spill
    res
}

// sqlite3PcacheShrink.
pcache_shrink: fn(c: &PCache) Never! { p1_shrink(c) }

// sqlite3PCachePercentDirty.
pcache_percent_dirty: fn(c: PCache) -> Int Never! {
    dirty := 0
    p := c.dirty
    loop p != NO_PAGE {
        dirty += 1
        p = c.pages[p].dirty_next
    }
    n: pcache_pages_for(c)
    if n == 0 -> return 0
    dirty * 100 /% n
}

// sqlite3PCacheIsDirty.
pcache_is_dirty: fn(c: PCache) -> Bool Never! { c.dirty != NO_PAGE }

#Test("a bitvec holds page numbers in 1..size") {
    b := bitvec_create(100)
    bitvec_set(b, 1)
    bitvec_set(b, 100)
    assert(bitvec_test(b, 1) && bitvec_test(b, 100))
    assert(!bitvec_test(b, 0) && !bitvec_test(b, 2) && !bitvec_test(b, 101))
    bitvec_clear(b, 1)
    assert(!bitvec_test(b, 1))
    assert(!bitvec_test(bitvec_none(), 1))
}

#Test("pages pin, dirty, sort and recycle as pcache.c and pcache1.c do") {
    c := pcache_unopened()
    pcache_open(c, 512, 0, true)
    pcache_set_cachesize(c, 10)
    // Fetch pages 3, 1, 2 and dirty them.
    order: [Int]{3, 1, 2}
    slots := [Int]{}
    loop pgno in order {
        s: pcache_fetch(c, pgno, 3)
        assert(s != NO_PAGE)
        slots.push(pcache_fetch_finish(c, pgno, s))
    }
    assert(pcache_ref_count(c) == 3)
    loop s in slots -> pcache_make_dirty(c, s)
    dirty: pcache_dirty_list(c)
    assert(dirty.len() == 3)
    assert(c.pages[dirty[0]].pgno == 1 && c.pages[dirty[1]].pgno == 2 && c.pages[dirty[2]].pgno == 3)
    // While pages are dirty eCreate is 1, so a fetch of a full cache fails
    // and the stress victim is the least recent unreferenced dirty page.
    loop s in slots -> pcache_release(c, s)
    assert(c.create == 1)
    victim: pcache_stress_victim(c)
    assert(victim != NO_PAGE && c.pages[victim].pgno == 3)
    pcache_clean_all(c)
    assert(c.create == 2 && c.dirty == NO_PAGE)
    // Clean unreferenced pages are recycled once the cache is full.
    loop pgno in 4..<20 {
        s: pcache_fetch(c, pgno, 3)
        assert(s != NO_PAGE)
        got: pcache_fetch_finish(c, pgno, s)
        pcache_release(c, got)
    }
    assert(pcache_pagecount(c) <= 10)
    assert(pcache_fetch(c, 1, 0) == NO_PAGE)
    // Truncate drops pages past the limit.
    pcache_truncate(c, 10)
    assert(pcache_fetch(c, 19, 0) == NO_PAGE)
    // A negative cache size is KiB: -1024 KiB of 512-byte pages.
    pcache_set_cachesize(c, -1024)
    assert(pcache_get_cachesize(c) == 2048)
    pcache_close(c)
}
