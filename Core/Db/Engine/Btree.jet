// The B-tree layer of the Jet SQLite engine: a port of SQLite 3.45.0
// btree.c. Tables are B+trees keyed by a 64-bit rowid and indexes are
// B-trees of records; both live in the pages of the pager. The file format
// is https://sqlite.org/fileformat2.html sections 1.3 to 1.6.
//
// There is no shared cache (a Btree's sharable is always 0, as in a build
// that never opens with SQLITE_OPEN_SHAREDCACHE), so one Btree value is
// both C's Btree and its BtShared, and every table lock check succeeds:
// querySharedCacheTableLock and setSharedCacheTableLock answer SQLITE_OK and
// the lock lists are empty. The shared-cache entry points (SchemaLocked,
// LockTable, Sharable, ConnectionCount) have no port; their callers take
// the unshared answers (SQLITE_OK, false, 1).
//
// C's MemPage lives in the pager page's extra space. Here it is mem[s] for
// the page cache slot s, which is C's DbPage pointer; a MemPage pointer is
// that slot. The cache marks a slot's extra space reset (extra_reset) where
// C zeroes its first eight bytes, and sync_extra applies that (isInit,
// intKey, intKeyLeaf and pgno become 0) before the btree looks. The pager
// cannot call pageReinit back; it queues the slots a playback changed under
// the btree's references (pager.reinit) and drain_reinit runs pageReinit on
// them after each pager call that can play a journal back.
//
// A cell pointer (u8*) is an offset into the buffer that holds it: the page
// image of a slot, or a cell held apart from any page (an overflow cell of
// apOvfl, a cell of a CellArray, the cell an insert builds), which is its
// own [U8]. xParseCell and xCellSize are the page's parse and size kinds.
// A cursor is an index of `cursors`; `cursor_list` is the pCursor list,
// newest first. The connection's state the btree reads (sqlite3.flags,
// nSavepoint, nVdbeRead, the temp_store choice, the interrupt flag and the
// autovacuum_pages callback) is the BtDB value the connection keeps there.
// The busy handler is the pager's (sqlite3PagerSetBusyHandler gives it the
// connection's), so btreeInvokeBusyHandler is wal.busy_invoke of it.
//
// The schema object sqlite3BtreeSchema allocates belongs to the connection
// here, which keeps it per database; sqlite3BtreeOpen's check of it always
// finds none and sets the default cache size. The SQLITE_FCNTL_PDB hint is
// not sent (the unix VFS ignores it).

use {
    base: __core_db_base
    util: __core_db_util
    os: __core_db_os
    cache: __core_db_pcache
    wal: __core_db_wal
    pager: __core_db_pager
    record: __core_db_record
}

// The 16 bytes every database file starts with (zMagicHeader,
// SQLITE_FILE_HEADER with its terminator).
MAGIC_HEADER: [U8]{83, 81, 76, 105, 116, 101, 32, 102, 111, 114, 109, 97, 116, 32, 51, 0}

// sizeof(MemPage) on a 64-bit host: the extra space the pager gives each page.
MEMPAGE_SIZE: 136

// allocateBtreePage modes (BTALLOC_*).
BTALLOC_ANY: 0
BTALLOC_EXACT: 1
BTALLOC_LE: 2

// Page type flags (PTF_*).
PTF_INTKEY: 1
PTF_ZERODATA: 2
PTF_LEAFDATA: 4
PTF_LEAF: 8
// The four valid flag bytes.
FLAGS_TABLE_LEAF: 13
FLAGS_TABLE_INTERIOR: 5
FLAGS_INDEX_LEAF: 10
FLAGS_INDEX_INTERIOR: 2

// sqlite3BtreeOpen flags (BTREE_*).
BTREE_OMIT_JOURNAL: 1
BTREE_MEMORY: 2
BTREE_SINGLE: 4
BTREE_UNORDERED: 8

// sqlite3BtreeCreateTable flags.
BTREE_INTKEY: 1
BTREE_BLOBKEY: 2

// Meta values (sqlite3BtreeGetMeta indices).
BTREE_FREE_PAGE_COUNT: 0
BTREE_SCHEMA_VERSION: 1
BTREE_FILE_FORMAT: 2
BTREE_DEFAULT_CACHE_SIZE: 3
BTREE_LARGEST_ROOT_PAGE: 4
BTREE_TEXT_ENCODING: 5
BTREE_USER_VERSION: 6
BTREE_INCR_VACUUM: 7
BTREE_APPLICATION_ID: 8
BTREE_DATA_VERSION: 15

// Auto-vacuum modes.
BTREE_AUTOVACUUM_NONE: 0
BTREE_AUTOVACUUM_FULL: 1
BTREE_AUTOVACUUM_INCR: 2

// Cursor hints and flags.
BTREE_BULKLOAD: 1
BTREE_SEEK_EQ: 2
BTREE_WRCSR: 4
BTREE_FORDELETE: 8

// sqlite3BtreeInsert and sqlite3BtreeDelete flags.
BTREE_SAVEPOSITION: 2
BTREE_AUXDELETE: 4
BTREE_APPEND: 8
BTREE_PREFORMAT: 128

// Btree.inTrans values (TRANS_*).
TRANS_NONE: 0
TRANS_READ: 1
TRANS_WRITE: 2

// BtShared.btsFlags (BTS_*).
BTS_READ_ONLY: 1
BTS_PAGESIZE_FIXED: 2
BTS_SECURE_DELETE: 4
BTS_OVERWRITE: 8
BTS_FAST_SECURE: 12
BTS_INITIALLY_EMPTY: 16
BTS_NO_WAL: 32
BTS_EXCLUSIVE: 64
BTS_PENDING: 128

// BtCursor.curFlags (BTCF_*).
BTCF_WRITE_FLAG: 1
BTCF_VALID_NKEY: 2
BTCF_VALID_OVFL: 4
BTCF_AT_LAST: 8
BTCF_INCRBLOB: 16
BTCF_MULTIPLE: 32
BTCF_PINNED: 64

// BtCursor.eState (CURSOR_*).
CURSOR_VALID: 0
CURSOR_INVALID: 1
CURSOR_SKIPNEXT: 2
CURSOR_REQUIRESEEK: 3
CURSOR_FAULT: 4

BTCURSOR_MAX_DEPTH: 20

// Pointer-map entry types (PTRMAP_*).
PTRMAP_ROOTPAGE: 1
PTRMAP_FREEPAGE: 2
PTRMAP_OVERFLOW1: 3
PTRMAP_OVERFLOW2: 4
PTRMAP_BTREE: 5

// The root page of the schema table (SCHEMA_ROOT).
SCHEMA_ROOT: 1

// sqlite3.flags bits the btree reads (sqliteInt.h SQLITE_*).
SQLITE_WRITE_SCHEMA: 1
SQLITE_NO_CKPT_ON_CLOSE: 2048
SQLITE_CELL_SIZE_CK: 2097152
SQLITE_RESET_DATABASE: 33554432
SQLITE_DEFENSIVE: 268435456

// SQLITE_DEFAULT_CACHE_SIZE.
DEFAULT_CACHE_SIZE: -2000
// SQLITE_DEFAULT_AUTOVACUUM.
DEFAULT_AUTOVACUUM: 0

// xParseCell kinds: btreeParseCellPtrNoPayload, btreeParseCellPtr and
// btreeParseCellPtrIndex.
PARSE_NO_PAYLOAD: 0
PARSE_TABLE: 1
PARSE_INDEX: 2
// xCellSize kinds: cellSizePtr, cellSizePtrIdxLeaf, cellSizePtrNoPayload
// and cellSizePtrTableLeaf.
SIZE_PTR: 0
SIZE_INDEX_LEAF: 1
SIZE_NO_PAYLOAD: 2
SIZE_TABLE_LEAF: 3

// The connection state the btree reads (parts of struct sqlite3).
BtDB: struct {
    // sqlite3.flags.
    flags: Int
    // nSavepoint.
    n_savepoint: Int
    // nVdbeRead.
    n_vdbe_read: Int
    // sqlite3TempInMemory(db).
    temp_in_memory: Bool
    // u1.isInterrupted.
    is_interrupted: Bool
    // The database's schema name (aDb[i].zDbSName) for xAutovacPages.
    db_name: String
    // xAutovacPages (with its pAutovacPagesArg bound in): the pages to
    // vacuum from the schema name, the page count, the free pages and the
    // page size.
    autovac_pages: (fn(String, Int, Int, Int) -[]> Int Never!)?
    // xProgress (with its pProgressArg bound in), true to interrupt, and
    // nProgressOps.
    progress: (fn() -[]> Bool Never!)?
    n_progress_ops: Int
}

// A connection state with every flag clear.
bt_db_default: fn() -> BtDB Never! {
    BtDB{flags: 0, n_savepoint: 0, n_vdbe_read: 0, temp_in_memory: false, is_interrupted: false, db_name: "main", autovac_pages: None, progress: None, n_progress_ops: 0}
}

// One page as the btree sees it (btreeInt.h MemPage). The page image is
// the pager slot's data; aData is offset 0, aDataEnd the page size,
// aCellIdx cell_offset and aDataOfst child_ptr_size.
MemPage: struct {
    is_init: Bool
    int_key: Bool
    int_key_leaf: Bool
    pgno: Int
    leaf: Bool
    hdr_offset: Int
    child_ptr_size: Int
    max1byte_payload: Int
    n_overflow: Int
    max_local: Int
    min_local: Int
    cell_offset: Int
    n_free: Int
    n_cell: Int
    mask_page: Int
    // aiOvfl and apOvfl: the overflow cells' places and bodies.
    ai_ovfl: [Int]
    ap_ovfl: [[U8]]
    // xParseCell and xCellSize.
    parse_kind: Int
    size_kind: Int
}

// A MemPage of zeroed extra space.
mem_page_zero: fn() -> MemPage Never! {
    MemPage{is_init: false, int_key: false, int_key_leaf: false, pgno: 0, leaf: false, hdr_offset: 0, child_ptr_size: 0, max1byte_payload: 0, n_overflow: 0, max_local: 0, min_local: 0, cell_offset: 0, n_free: 0, n_cell: 0, mask_page: 0, ai_ovfl: [Int]{0, 0, 0, 0}, ap_ovfl: [[U8]]{[U8]{}, [U8]{}, [U8]{}, [U8]{}}, parse_kind: PARSE_NO_PAYLOAD, size_kind: SIZE_PTR}
}

// The parse of one cell (CellInfo). payload is the offset of the payload
// in the buffer that was parsed.
CellInfo: struct {
    n_key: Int
    payload: Int
    n_payload: Int
    n_local: Int
    n_size: Int
}

cell_info_zero: fn() -> CellInfo Never! {
    CellInfo{n_key: 0, payload: 0, n_payload: 0, n_local: 0, n_size: 0}
}

// A cursor (btreeInt.h BtCursor). page and ap_page hold page slots with a
// reference each, as pPage and apPage hold MemPage pointers.
BtCursor: struct {
    // The slot is an open cursor.
    live: Bool
    state: Int
    cur_flags: Int
    cur_pager_flags: Int
    hints: Int
    skip_next: Int
    // aOverflow: the overflow page numbers once cached.
    overflow: [Int]
    // pKey: the saved key of an index cursor.
    key: [U8]?
    info: CellInfo
    n_key: Int
    pgno_root: Int
    i_page: Int
    cur_int_key: Bool
    ix: Int
    ai_idx: [Int]
    // pKeyInfo: set for an index cursor.
    key_info: record.KeyInfo?
    page: Int
    ap_page: [Int]
}

// A cursor slot that holds nothing.
cursor_closed: fn() -> BtCursor Never! {
    BtCursor{live: false, state: CURSOR_INVALID, cur_flags: 0, cur_pager_flags: 0, hints: 0, skip_next: 0, overflow: [Int]{}, key: None, info: cell_info_zero(), n_key: 0, pgno_root: 0, i_page: -1, cur_int_key: false, ix: 0, ai_idx: zero_ints(BTCURSOR_MAX_DEPTH - 1), key_info: None, page: cache.NO_PAGE, ap_page: no_pages(BTCURSOR_MAX_DEPTH - 1)}
}

// A database file's btree: btreeInt.h Btree and its BtShared.
Btree: struct {
    db: BtDB
    // Btree.inTrans.
    in_trans: Int
    has_incrblob_cur: Bool
    n_backup: Int
    // iBDataVersion.
    b_data_version: Int
    // BtShared.
    pager: pager.Pager
    cursors: [BtCursor]
    cursor_list: [Int]
    // pPage1: the slot of page 1 while it is held, else NO_PAGE.
    page1: Int
    open_flags: Int
    auto_vacuum: Bool
    incr_vacuum: Bool
    do_truncate: Bool
    in_transaction: Int
    max1byte_payload: Int
    n_reserve_wanted: Int
    bts_flags: Int
    max_local: Int
    min_local: Int
    max_leaf: Int
    min_leaf: Int
    page_size: Int
    usable_size: Int
    n_transaction: Int
    n_page: Int
    has_content: cache.Bitvec
    // pTmpSpace: a page of scratch space once a write cursor needs it.
    tmp_space: [U8]
    n_preformat_size: Int
    // The MemPage of each pager slot.
    mem: [MemPage]
}

// A Btree before sqlite3BtreeOpen.
btree_closed: fn() -> Btree Never! {
    Btree{db: bt_db_default(), in_trans: TRANS_NONE, has_incrblob_cur: false, n_backup: 0, b_data_version: 0, pager: pager.pager_closed(), cursors: [BtCursor]{}, cursor_list: [Int]{}, page1: cache.NO_PAGE, open_flags: 0, auto_vacuum: false, incr_vacuum: false, do_truncate: false, in_transaction: TRANS_NONE, max1byte_payload: 0, n_reserve_wanted: 0, bts_flags: 0, max_local: 0, min_local: 0, max_leaf: 0, min_leaf: 0, page_size: 0, usable_size: 0, n_transaction: 0, n_page: 0, has_content: cache.bitvec_none(), tmp_space: [U8]{}, n_preformat_size: 0, mem: [MemPage]{}}
}

zero_ints: fn(n: Int) -> [Int] Never! {
    out := [Int]{}
    loop _ in 0..<n -> out.push(0)
    out
}

no_pages: fn(n: Int) -> [Int] Never! {
    out := [Int]{}
    loop _ in 0..<n -> out.push(cache.NO_PAGE)
    out
}

// The byte at `at`, 0 past the end. A corrupt cell can make C read past
// its page into the bytes after it; here those read as zero.
bb: fn(buf: [U8], at: Int) -> Int Never! {
    if at < 0 || at >= buf.len() -> return 0
    Int.from_u8(buf[at])
}

// get2byte and get4byte over bb.
bget2: fn(buf: [U8], at: Int) -> Int Never! { (bb(buf, at) << 8).bit_or(bb(buf, at + 1)) }
bget4: fn(buf: [U8], at: Int) -> Int Never! {
    (bb(buf, at) << 24).bit_or(bb(buf, at + 1) << 16).bit_or(bb(buf, at + 2) << 8).bit_or(bb(buf, at + 3))
}

// getVarint over bb.
bvarint: fn(buf: [U8], at: Int) -> util.Varint Never! {
    first: bb(buf, at)
    if first < 128 -> return util.Varint{value: first, len: 1}
    value := first.bit_and(127)
    i := 1
    loop i < 8 {
        b: bb(buf, at + i)
        value = (value << 7).bit_or(b.bit_and(127))
        if b < 128 -> return util.Varint{value: value, len: i + 1}
        i += 1
    }
    if value >= 36028797018963968 -> value -= 72057594037927936
    util.Varint{value: (value << 8).bit_or(bb(buf, at + 8)), len: 9}
}

// memmove within one buffer.
mem_move: fn(buf: &[U8], to: Int, from: Int, n: Int) Never! {
    if n <= 0 || to == from -> return
    if to < from {
        loop i in 0..<n -> buf[to + i] = buf[from + i]
    } else {
        i := n - 1
        loop i >= 0 {
            buf[to + i] = buf[from + i]
            i -= 1
        }
    }
}

// src[from..<from + n] as a buffer of its own.
slice_of: fn(src: [U8], from: Int, n: Int) -> [U8] Never! {
    out := [U8]{}
    loop i in 0..<n -> out.push(U8{bb(src, from + i)})
    out
}

// The page image bytes of slot s.
pb: fn(bt: Btree, s: Int, at: Int) -> Int Never! { bb(bt.pager.pcache.pages[s].data, at) }
pg2: fn(bt: Btree, s: Int, at: Int) -> Int Never! { bget2(bt.pager.pcache.pages[s].data, at) }
pg4: fn(bt: Btree, s: Int, at: Int) -> Int Never! { bget4(bt.pager.pcache.pages[s].data, at) }
ps1: fn(bt: &Btree, s: Int, at: Int, v: Int) Never! { bt.pager.pcache.pages[s].data[at] = U8{v.bit_and(255)} }
ps2: fn(bt: &Btree, s: Int, at: Int, v: Int) Never! { util.put2(bt.pager.pcache.pages[s].data, at, v.bit_and(65535)) }
ps4: fn(bt: &Btree, s: Int, at: Int, v: Int) Never! { util.put4(bt.pager.pcache.pages[s].data, at, v.bit_and(os.U32_MASK)) }
pzero: fn(bt: &Btree, s: Int, at: Int, n: Int) Never! {
    loop i in 0..<n -> bt.pager.pcache.pages[s].data[at + i] = U8{0}
}

// get2byteNotZero.
get2_not_zero: fn(v: Int) -> Int Never! { ((v - 1).bit_and(65535)) + 1 }

// MX_CELL and MX_CELL_SIZE.
mx_cell: fn(bt: Btree) -> Int Never! { (bt.page_size - 8) /% 6 }
mx_cell_size: fn(bt: Btree) -> Int Never! { bt.page_size - 8 }

// PENDING_BYTE_PAGE.
pending_byte_page: fn(bt: Btree) -> Int Never! { os.PENDING_BYTE /% bt.page_size + 1 }

// sqlite3WritableSchema.
writable_schema: fn(db: BtDB) -> Bool Never! {
    db.flags.bit_and(SQLITE_WRITE_SCHEMA.bit_or(SQLITE_DEFENSIVE)) == SQLITE_WRITE_SCHEMA
}

// ---------------------------------------------------------------------------
// The MemPage of a pager slot.

// The slot's MemPage exists.
ensure_mem: fn(bt: &Btree, s: Int) Never! {
    loop bt.mem.len() <= s -> bt.mem.push(mem_page_zero())
}

// sqlite3PagerGetExtra: the slot's MemPage, its first eight bytes zeroed
// when the cache reset them.
sync_extra: fn(bt: &Btree, s: Int) Never! {
    ensure_mem(bt, s)
    if bt.pager.pcache.pages[s].extra_reset {
        bt.pager.pcache.pages[s].extra_reset = false
        bt.mem[s].is_init = false
        bt.mem[s].int_key = false
        bt.mem[s].int_key_leaf = false
        bt.mem[s].pgno = 0
    }
}

// pageReinit for every slot a playback changed while the btree held it.
drain_reinit: fn(bt: &Btree) Never! {
    if bt.pager.reinit.len() == 0 -> return
    slots: bt.pager.reinit.copy()
    bt.pager.reinit = [Int]{}
    loop s in slots {
        ensure_mem(bt, s)
        bt.pager.pcache.pages[s].extra_reset = false
        if bt.mem[s].is_init {
            bt.mem[s].is_init = false
            if pager.pager_page_refcount(bt.pager, s) > 0 -> _: btree_init_page(bt, s)
        }
    }
}

// invalidateOverflowCache.
invalidate_overflow_cache: fn(bt: &Btree, c: Int) Never! {
    bt.cursors[c].cur_flags = util.clear_bits(bt.cursors[c].cur_flags, BTCF_VALID_OVFL)
}

// invalidateAllOverflowCache.
invalidate_all_overflow_cache: fn(bt: &Btree) Never! {
    loop c in bt.cursor_list.copy() -> invalidate_overflow_cache(bt, c)
}

// invalidateIncrblobCursors.
invalidate_incrblob_cursors: fn(bt: &Btree, pgno_root: Int, i_row: Int, is_clear_table: Bool) Never! {
    bt.has_incrblob_cur = false
    loop c in bt.cursor_list.copy() {
        if bt.cursors[c].cur_flags.bit_and(BTCF_INCRBLOB) != 0 {
            bt.has_incrblob_cur = true
            if bt.cursors[c].pgno_root == pgno_root && (is_clear_table || bt.cursors[c].info.n_key == i_row) -> bt.cursors[c].state = CURSOR_INVALID
        }
    }
}

// btreeSetHasContent.
btree_set_has_content: fn(bt: &Btree, pgno: Int) -> Int Never! {
    if !bt.has_content.live -> bt.has_content = cache.bitvec_create(bt.n_page)
    if pgno <= cache.bitvec_size(bt.has_content) -> cache.bitvec_set(bt.has_content, pgno)
    base.OK
}

// btreeGetHasContent.
btree_get_has_content: fn(bt: Btree, pgno: Int) -> Bool Never! {
    p: bt.has_content
    p.live && (pgno > cache.bitvec_size(p) || cache.bitvec_test_not_null(p, pgno))
}

// btreeClearHasContent.
btree_clear_has_content: fn(bt: &Btree) Never! { bt.has_content = cache.bitvec_none() }

// btreeReleaseAllCursorPages.
btree_release_all_cursor_pages: fn(bt: &Btree, c: Int) Never! {
    if bt.cursors[c].i_page >= 0 {
        n: bt.cursors[c].i_page
        loop i in 0..<n {
            s: bt.cursors[c].ap_page[i]
            release_page_not_null(bt, s)
        }
        s: bt.cursors[c].page
        release_page_not_null(bt, s)
        bt.cursors[c].i_page = -1
    }
}

// saveCursorKey.
save_cursor_key: fn(bt: &Btree, c: Int) -[DB]> Int Never! {
    rc := base.OK
    if bt.cursors[c].cur_int_key {
        k: btree_integer_key(bt, c)
        bt.cursors[c].n_key = k
    } else {
        n: btree_payload_size(bt, c)
        bt.cursors[c].n_key = n
        key := pager.zeros(n + 9 + 8)
        rc = btree_payload(bt, c, 0, n, key)
        if rc == base.OK -> bt.cursors[c].key = Val(key)
    }
    rc
}

// saveCursorPosition.
save_cursor_position: fn(bt: &Btree, c: Int) -[DB]> Int Never! {
    if bt.cursors[c].cur_flags.bit_and(BTCF_PINNED) != 0 -> return base.CONSTRAINT_PINNED
    if bt.cursors[c].state == CURSOR_SKIPNEXT {
        bt.cursors[c].state = CURSOR_VALID
    } else {
        bt.cursors[c].skip_next = 0
    }
    rc: save_cursor_key(bt, c)
    if rc == base.OK {
        btree_release_all_cursor_pages(bt, c)
        bt.cursors[c].state = CURSOR_REQUIRESEEK
    }
    bt.cursors[c].cur_flags = util.clear_bits(bt.cursors[c].cur_flags, BTCF_VALID_NKEY.bit_or(BTCF_VALID_OVFL).bit_or(BTCF_AT_LAST))
    rc
}

// saveAllCursors: save every cursor on root i_root (every cursor when 0)
// but `except` (-1 for none).
save_all_cursors: fn(bt: &Btree, i_root: Int, except: Int) -[DB]> Int Never! {
    list: bt.cursor_list.copy()
    first := -1
    loop k in 0..<list.len() {
        c: list[k]
        if c != except && (i_root == 0 || bt.cursors[c].pgno_root == i_root) {
            first = k
            break
        }
    }
    if first >= 0 -> return save_cursors_on_list(bt, list, first, i_root, except)
    if except >= 0 -> bt.cursors[except].cur_flags = util.clear_bits(bt.cursors[except].cur_flags, BTCF_MULTIPLE)
    base.OK
}

// saveCursorsOnList from list[first] on.
save_cursors_on_list: fn(bt: &Btree, list: [Int], first: Int, i_root: Int, except: Int) -[DB]> Int Never! {
    loop k in first..<list.len() {
        c: list[k]
        if c != except && (i_root == 0 || bt.cursors[c].pgno_root == i_root) {
            st: bt.cursors[c].state
            if st == CURSOR_VALID || st == CURSOR_SKIPNEXT {
                rc: save_cursor_position(bt, c)
                if rc != base.OK -> return rc
            } else {
                btree_release_all_cursor_pages(bt, c)
            }
        }
    }
    base.OK
}

// sqlite3BtreeClearCursor.
btree_clear_cursor: fn(bt: &Btree, c: Int) Never! {
    bt.cursors[c].key = None
    bt.cursors[c].state = CURSOR_INVALID
}

// btreeMoveto: seek the saved key; key is the packed key of an index
// cursor, None for a table.
btree_moveto: fn(bt: &Btree, c: Int, key: [U8]?, n_key: Int, bias: Bool, res: &Int) -[DB]> Int Never! {
    if key == .Val(k) {
        info: bt.cursors[c].key_info ?? return base.CORRUPT
        idx := record.unpacked_record_alloc(info)
        record.record_unpack(info, n_key, k, idx)
        if idx.n_field == 0 || idx.n_field > info.n_all_field -> return base.CORRUPT
        return btree_index_moveto(bt, c, idx, res)
    }
    btree_table_moveto(bt, c, n_key, bias, res)
}

// btreeRestoreCursorPosition.
btree_restore_cursor_position: fn(bt: &Btree, c: Int) -[DB]> Int Never! {
    if bt.cursors[c].state == CURSOR_FAULT -> return bt.cursors[c].skip_next
    bt.cursors[c].state = CURSOR_INVALID
    skip_next := 0
    key: bt.cursors[c].key.copy()
    n_key: bt.cursors[c].n_key
    rc: btree_moveto(bt, c, key, n_key, false, skip_next)
    if rc == base.OK {
        bt.cursors[c].key = None
        if skip_next != 0 -> bt.cursors[c].skip_next = skip_next
        if bt.cursors[c].skip_next != 0 && bt.cursors[c].state == CURSOR_VALID -> bt.cursors[c].state = CURSOR_SKIPNEXT
    }
    rc
}

// restoreCursorPosition.
restore_cursor_position: fn(bt: &Btree, c: Int) -[DB]> Int Never! {
    if bt.cursors[c].state >= CURSOR_REQUIRESEEK -> return btree_restore_cursor_position(bt, c)
    base.OK
}

// sqlite3BtreeCursorHasMoved.
btree_cursor_has_moved: fn(bt: Btree, c: Int) -> Bool Never! { bt.cursors[c].state != CURSOR_VALID }

// sqlite3BtreeCursorRestore: different_row is set when the cursor no
// longer points at the row it did.
btree_cursor_restore: fn(bt: &Btree, c: Int, different_row: &Bool) -[DB]> Int Never! {
    rc: restore_cursor_position(bt, c)
    if rc != base.OK {
        different_row = true
        return rc
    }
    different_row = bt.cursors[c].state != CURSOR_VALID
    base.OK
}

// sqlite3BtreeCursorHintFlags.
btree_cursor_hint_flags: fn(bt: &Btree, c: Int, x: Int) Never! { bt.cursors[c].hints = x }

// ---------------------------------------------------------------------------
// The pointer map.

// ptrmapPageno.
ptrmap_pageno: fn(bt: Btree, pgno: Int) -> Int Never! {
    if pgno < 2 -> return 0
    per_map: bt.usable_size /% 5 + 1
    i_ptrmap: (pgno - 2) /% per_map
    ret := i_ptrmap * per_map + 2
    if ret == pending_byte_page(bt) -> ret += 1
    ret
}

// PTRMAP_ISPAGE.
ptrmap_is_page: fn(bt: Btree, pgno: Int) -> Bool Never! { ptrmap_pageno(bt, pgno) == pgno }

// ptrmapPut: the parent of page `key` is `parent`, as e_type. Nothing when
// rc already holds an error.
ptrmap_put: fn(bt: &Btree, key: Int, e_type: Int, parent: Int, rc: &Int) Never! -[DB]> {
    if rc != base.OK -> return
    if key == 0 {
        rc = base.CORRUPT
        return
    }
    i_ptrmap: ptrmap_pageno(bt, key)
    s := cache.NO_PAGE
    r: pager.pager_get(bt.pager, i_ptrmap, s, 0)
    if r != base.OK {
        rc = r
        return
    }
    sync_extra(bt, s)
    offset: 5 * (key - i_ptrmap - 1)
    if bt.mem[s].is_init {
        rc = base.CORRUPT
    } else if offset < 0 {
        rc = base.CORRUPT
    } else if e_type != pb(bt, s, offset) || pg4(bt, s, offset + 1) != parent {
        w: pager.pager_write(bt.pager, s)
        rc = w
        if w == base.OK {
            ps1(bt, s, offset, e_type)
            ps4(bt, s, offset + 1, parent)
        }
    }
    pager.pager_unref(bt.pager, s)
}

// ptrmapGet.
ptrmap_get: fn(bt: &Btree, key: Int, e_type: &Int, pgno: &Int) -[DB]> Int Never! {
    i_ptrmap: ptrmap_pageno(bt, key)
    s := cache.NO_PAGE
    rc: pager.pager_get(bt.pager, i_ptrmap, s, 0)
    if rc != base.OK -> return rc
    offset: 5 * (key - i_ptrmap - 1)
    if offset < 0 {
        pager.pager_unref(bt.pager, s)
        return base.CORRUPT
    }
    e_type = pb(bt, s, offset)
    pgno = pg4(bt, s, offset + 1)
    pager.pager_unref(bt.pager, s)
    if e_type < 1 || e_type > 5 -> return base.CORRUPT
    base.OK
}

// ---------------------------------------------------------------------------
// Cells.

// findCell: the offset of cell i in the page image.
find_cell: fn(bt: Btree, s: Int, i: Int) -> Int Never! {
    bt.mem[s].mask_page.bit_and(pg2(bt, s, bt.mem[s].cell_offset + 2 * i))
}

// findCellPastPtr.
find_cell_past_ptr: fn(bt: Btree, s: Int, i: Int) -> Int Never! {
    bt.mem[s].child_ptr_size + find_cell(bt, s, i)
}

// The payload size varint of btreeParseCellPtr and its kin: at most nine
// bytes, seven bits each, in 32 bits.
payload_varint: fn(buf: [U8], at: Int, value: &Int) -> Int Never! {
    iter := at
    n := bb(buf, iter)
    if n >= 128 {
        end: iter + 8
        n = n.bit_and(127)
        loop {
            iter += 1
            n = ((n << 7).bit_or(bb(buf, iter).bit_and(127))).bit_and(os.U32_MASK)
            if !(bb(buf, iter) >= 128 && iter < end) -> break
        }
    }
    value = n
    iter + 1
}

// btreeParseCellAdjustSizeForOverflow.
parse_cell_adjust_size_for_overflow: fn(m: MemPage, usable: Int, cell: Int, info: &CellInfo) Never! {
    min_local: m.min_local
    max_local: m.max_local
    surplus: min_local + (info.n_payload - min_local) % (usable - 4)
    info.n_local = if surplus <= max_local -> surplus else -> min_local
    info.n_size = (info.payload + info.n_local - cell + 4).bit_and(65535)
}

// btreePayloadToLocal.
btree_payload_to_local: fn(bt: Btree, m: MemPage, n_payload: Int) -> Int Never! {
    max_local: m.max_local
    if n_payload <= max_local -> return n_payload
    min_local: m.min_local
    surplus: min_local + (n_payload - min_local) % (bt.usable_size - 4)
    if surplus <= max_local -> surplus else -> min_local
}

// xParseCell: parse the cell at buf[cell] of a page like m.
parse_cell: fn(m: MemPage, usable: Int, buf: [U8], cell: Int, info: &CellInfo) Never! {
    if m.parse_kind == PARSE_NO_PAYLOAD {
        // btreeParseCellPtrNoPayload.
        v: bvarint(buf, cell + 4)
        info.n_size = 4 + v.len
        info.n_key = v.value
        info.n_payload = 0
        info.n_local = 0
        info.payload = 0
        return
    }
    n_payload := 0
    iter := 0
    if m.parse_kind == PARSE_TABLE {
        // btreeParseCellPtr.
        iter = payload_varint(buf, cell, n_payload)
        v: bvarint(buf, iter)
        iter += v.len
        info.n_key = v.value
    } else {
        // btreeParseCellPtrIndex.
        iter = payload_varint(buf, cell + m.child_ptr_size, n_payload)
        info.n_key = n_payload
    }
    info.n_payload = n_payload
    info.payload = iter
    if n_payload <= m.max_local {
        sz := n_payload + (iter - cell)
        if sz < 4 -> sz = 4
        info.n_size = sz.bit_and(65535)
        info.n_local = n_payload
    } else {
        parse_cell_adjust_size_for_overflow(m, usable, cell, info)
    }
}

// btreeParseCell: parse cell i of slot s.
btree_parse_cell: fn(bt: Btree, s: Int, i: Int, info: &CellInfo) Never! {
    parse_cell(bt.mem[s], bt.usable_size, bt.pager.pcache.pages[s].data, find_cell(bt, s, i), info)
}

// xCellSize: the bytes the cell at buf[cell] takes on a page like m.
cell_size: fn(m: MemPage, usable: Int, buf: [U8], cell: Int) -> Int Never! {
    kind: m.size_kind
    if kind == SIZE_NO_PAYLOAD {
        // cellSizePtrNoPayload.
        iter := cell + 4
        end: iter + 9
        loop {
            b: bb(buf, iter)
            iter += 1
            if !(b >= 128 && iter < end) -> break
        }
        return iter - cell
    }
    start: if kind == SIZE_PTR -> cell + 4 else -> cell
    n_size := 0
    iter := payload_varint(buf, start, n_size)
    if kind == SIZE_TABLE_LEAF {
        // The rowid varint: up to eight bytes with the high bit, then one.
        k := 0
        loop {
            b: bb(buf, iter)
            iter += 1
            k += 1
            if b < 128 -> break
            if k == 8 {
                iter += 1
                break
            }
        }
    }
    if n_size <= m.max_local {
        n_size += iter - cell
        if kind != SIZE_PTR && n_size < 4 -> n_size = 4
    } else {
        min_local: m.min_local
        n_size = min_local + (n_size - min_local) % (usable - 4)
        if n_size > m.max_local -> n_size = min_local
        n_size += 4 + (iter - cell).bit_and(65535)
    }
    n_size.bit_and(65535)
}

// cellSize of cell i of slot s.
cell_size_of: fn(bt: Btree, s: Int, i: Int) -> Int Never! {
    cell_size(bt.mem[s], bt.usable_size, bt.pager.pcache.pages[s].data, find_cell(bt, s, i))
}

// ptrmapPutOvflPtr: the pointer-map entry of the overflow chain of the cell
// at buf[cell], which page s holds. limit is the end of the source page
// image when buf is one (the SQLITE_OVERFLOW check), else -1.
ptrmap_put_ovfl_ptr: fn(bt: &Btree, s: Int, buf: [U8], cell: Int, limit: Int, rc: &Int) Never! -[DB]> {
    if rc != base.OK -> return
    info := cell_info_zero()
    parse_cell(bt.mem[s], bt.usable_size, buf, cell, info)
    if info.n_local < info.n_payload {
        if limit >= 0 && cell < limit && cell + info.n_local > limit {
            rc = base.CORRUPT
            return
        }
        ovfl: bget4(buf, cell + info.n_size - 4)
        pgno: bt.mem[s].pgno
        ptrmap_put(bt, ovfl, PTRMAP_OVERFLOW1, pgno, rc)
    }
}

// ---------------------------------------------------------------------------
// Space on a page.

// defragmentPage.
defragment_page: fn(bt: &Btree, s: Int, n_max_frag: Int) -> Int Never! {
    hdr: bt.mem[s].hdr_offset
    cell_offset: bt.mem[s].cell_offset
    n_cell: bt.mem[s].n_cell
    i_cell_first: cell_offset + 2 * n_cell
    usable: bt.usable_size
    cbrk := 0
    quick := false
    if pb(bt, s, hdr + 7) <= n_max_frag {
        i_free: pg2(bt, s, hdr + 1)
        if i_free > usable - 4 -> return base.CORRUPT
        if i_free != 0 {
            i_free2: pg2(bt, s, i_free)
            if i_free2 > usable - 4 -> return base.CORRUPT
            if i_free2 == 0 || (pb(bt, s, i_free2) == 0 && pb(bt, s, i_free2 + 1) == 0) {
                sz := pg2(bt, s, i_free + 2)
                sz2 := 0
                top: pg2(bt, s, hdr + 5)
                if top >= i_free -> return base.CORRUPT
                if i_free2 != 0 {
                    if i_free + sz > i_free2 -> return base.CORRUPT
                    sz2 = pg2(bt, s, i_free2 + 2)
                    if i_free2 + sz2 > usable -> return base.CORRUPT
                    mem_move(bt.pager.pcache.pages[s].data, i_free + sz + sz2, i_free + sz, i_free2 - (i_free + sz))
                    sz += sz2
                } else if i_free + sz > usable {
                    return base.CORRUPT
                }
                cbrk = top + sz
                mem_move(bt.pager.pcache.pages[s].data, cbrk, top, i_free - top)
                addr := cell_offset
                loop addr < i_cell_first {
                    pc: pg2(bt, s, addr)
                    if pc < i_free {
                        ps2(bt, s, addr, pc + sz)
                    } else if pc < i_free2 {
                        ps2(bt, s, addr, pc + sz2)
                    }
                    addr += 2
                }
                quick = true
            }
        }
    }
    if !quick {
        cbrk = usable
        i_cell_last: usable - 4
        i_cell_start: pg2(bt, s, hdr + 5)
        if n_cell > 0 {
            pager.copy_into(bt.pager.tmp, 0, bt.pager.pcache.pages[s].data, 0, usable)
            loop i in 0..<n_cell {
                addr: cell_offset + i * 2
                pc: pg2(bt, s, addr)
                if pc > i_cell_last -> return base.CORRUPT
                size: cell_size(bt.mem[s], usable, bt.pager.tmp, pc)
                cbrk -= size
                if cbrk < i_cell_start || pc + size > usable -> return base.CORRUPT
                ps2(bt, s, addr, cbrk)
                pager.copy_into(bt.pager.pcache.pages[s].data, cbrk, bt.pager.tmp, pc, size)
            }
        }
        ps1(bt, s, hdr + 7, 0)
    }
    // defragment_out.
    if pb(bt, s, hdr + 7) + cbrk - i_cell_first != bt.mem[s].n_free -> return base.CORRUPT
    ps2(bt, s, hdr + 5, cbrk)
    ps1(bt, s, hdr + 1, 0)
    ps1(bt, s, hdr + 2, 0)
    pzero(bt, s, i_cell_first, cbrk - i_cell_first)
    base.OK
}

// pageFindSlot: the offset of a free slot of n_byte bytes, or 0 (rc gets
// SQLITE_CORRUPT when the freelist is corrupt).
page_find_slot: fn(bt: &Btree, s: Int, n_byte: Int, rc: &Int) -> Int Never! {
    hdr: bt.mem[s].hdr_offset
    i_addr := hdr + 1
    pc := pg2(bt, s, i_addr)
    max_pc: bt.usable_size - n_byte
    loop pc <= max_pc {
        size: pg2(bt, s, pc + 2)
        x: size - n_byte
        if x >= 0 {
            if x < 4 {
                if pb(bt, s, hdr + 7) > 57 -> return 0
                b0: pb(bt, s, pc)
                b1: pb(bt, s, pc + 1)
                ps1(bt, s, i_addr, b0)
                ps1(bt, s, i_addr + 1, b1)
                frag: pb(bt, s, hdr + 7) + x
                ps1(bt, s, hdr + 7, frag)
                return pc
            } else if x + pc > max_pc {
                rc = base.CORRUPT
                return 0
            } else {
                ps2(bt, s, pc + 2, x)
            }
            return pc + x
        }
        i_addr = pc
        pc = pg2(bt, s, pc)
        if pc <= i_addr {
            if pc != 0 -> rc = base.CORRUPT
            return 0
        }
    }
    if pc > max_pc + n_byte - 4 -> rc = base.CORRUPT
    0
}

// allocateSpace: idx gets the offset of n_byte new bytes of cell content.
allocate_space: fn(bt: &Btree, s: Int, n_byte: Int, idx: &Int) -> Int Never! {
    hdr: bt.mem[s].hdr_offset
    gap: bt.mem[s].cell_offset + 2 * bt.mem[s].n_cell
    top := pg2(bt, s, hdr + 5)
    if gap > top {
        if top == 0 && bt.usable_size == 65536 {
            top = 65536
        } else {
            return base.CORRUPT
        }
    } else if top > bt.usable_size {
        return base.CORRUPT
    }
    if (pb(bt, s, hdr + 2) != 0 || pb(bt, s, hdr + 1) != 0) && gap + 2 <= top {
        rc := base.OK
        space: page_find_slot(bt, s, n_byte, rc)
        if space != 0 {
            idx = space
            if space <= gap -> return base.CORRUPT
            return base.OK
        } else if rc != base.OK {
            return rc
        }
    }
    if gap + 2 + n_byte > top {
        frag_limit := bt.mem[s].n_free - (2 + n_byte)
        if frag_limit > 4 -> frag_limit = 4
        rc: defragment_page(bt, s, frag_limit)
        if rc != base.OK -> return rc
        top = get2_not_zero(pg2(bt, s, hdr + 5))
    }
    top -= n_byte
    ps2(bt, s, hdr + 5, top)
    idx = top
    base.OK
}

// freeSpace: return i_size bytes at i_start to the freelist.
free_space: fn(bt: &Btree, s: Int, i_start_in: Int, i_size_in: Int) -> Int Never! {
    i_start := i_start_in.bit_and(65535)
    i_size := i_size_in.bit_and(65535)
    i_orig_size: i_size
    i_end := i_start + i_size
    hdr: bt.mem[s].hdr_offset
    i_ptr := hdr + 1
    i_free_blk := 0
    n_frag := 0
    usable: bt.usable_size
    if pb(bt, s, i_ptr + 1) == 0 && pb(bt, s, i_ptr) == 0 {
        i_free_blk = 0
    } else {
        loop {
            i_free_blk = pg2(bt, s, i_ptr)
            if i_free_blk >= i_start -> break
            if i_free_blk <= i_ptr {
                if i_free_blk == 0 -> break
                return base.CORRUPT
            }
            i_ptr = i_free_blk
        }
        if i_free_blk > usable - 4 -> return base.CORRUPT
        if i_free_blk != 0 && i_end + 3 >= i_free_blk {
            n_frag = (i_free_blk - i_end).bit_and(255)
            if i_end > i_free_blk -> return base.CORRUPT
            i_end = i_free_blk + pg2(bt, s, i_free_blk + 2)
            if i_end > usable -> return base.CORRUPT
            i_size = (i_end - i_start).bit_and(65535)
            i_free_blk = pg2(bt, s, i_free_blk)
        }
        if i_ptr > hdr + 1 {
            i_ptr_end: i_ptr + pg2(bt, s, i_ptr + 2)
            if i_ptr_end + 3 >= i_start {
                if i_ptr_end > i_start -> return base.CORRUPT
                n_frag = (n_frag + i_start - i_ptr_end).bit_and(255)
                i_size = (i_end - i_ptr).bit_and(65535)
                i_start = i_ptr
            }
        }
        frags: pb(bt, s, hdr + 7)
        if n_frag > frags -> return base.CORRUPT
        ps1(bt, s, hdr + 7, frags - n_frag)
    }
    x: pg2(bt, s, hdr + 5)
    if bt.bts_flags.bit_and(BTS_FAST_SECURE) != 0 -> pzero(bt, s, i_start, i_size)
    if i_start <= x {
        if i_start < x -> return base.CORRUPT
        if i_ptr != hdr + 1 -> return base.CORRUPT
        ps2(bt, s, hdr + 1, i_free_blk)
        ps2(bt, s, hdr + 5, i_end)
    } else {
        ps2(bt, s, i_ptr, i_start)
        ps2(bt, s, i_start, i_free_blk)
        ps2(bt, s, i_start + 2, i_size)
    }
    bt.mem[s].n_free += i_orig_size
    base.OK
}

// decodeFlags.
decode_flags: fn(bt: &Btree, s: Int, flag_byte: Int) -> Int Never! {
    bt.mem[s].max1byte_payload = bt.max1byte_payload
    if flag_byte >= PTF_ZERODATA.bit_or(PTF_LEAF) {
        bt.mem[s].child_ptr_size = 0
        bt.mem[s].leaf = true
        if flag_byte == FLAGS_TABLE_LEAF {
            bt.mem[s].int_key_leaf = true
            bt.mem[s].size_kind = SIZE_TABLE_LEAF
            bt.mem[s].parse_kind = PARSE_TABLE
            bt.mem[s].int_key = true
            bt.mem[s].max_local = bt.max_leaf
            bt.mem[s].min_local = bt.min_leaf
        } else if flag_byte == FLAGS_INDEX_LEAF {
            bt.mem[s].int_key = false
            bt.mem[s].int_key_leaf = false
            bt.mem[s].size_kind = SIZE_INDEX_LEAF
            bt.mem[s].parse_kind = PARSE_INDEX
            bt.mem[s].max_local = bt.max_local
            bt.mem[s].min_local = bt.min_local
        } else {
            bt.mem[s].int_key = false
            bt.mem[s].int_key_leaf = false
            bt.mem[s].size_kind = SIZE_INDEX_LEAF
            bt.mem[s].parse_kind = PARSE_INDEX
            return base.CORRUPT
        }
    } else {
        bt.mem[s].child_ptr_size = 4
        bt.mem[s].leaf = false
        if flag_byte == FLAGS_INDEX_INTERIOR {
            bt.mem[s].int_key = false
            bt.mem[s].int_key_leaf = false
            bt.mem[s].size_kind = SIZE_PTR
            bt.mem[s].parse_kind = PARSE_INDEX
            bt.mem[s].max_local = bt.max_local
            bt.mem[s].min_local = bt.min_local
        } else if flag_byte == FLAGS_TABLE_INTERIOR {
            bt.mem[s].int_key_leaf = false
            bt.mem[s].size_kind = SIZE_NO_PAYLOAD
            bt.mem[s].parse_kind = PARSE_NO_PAYLOAD
            bt.mem[s].int_key = true
            bt.mem[s].max_local = bt.max_leaf
            bt.mem[s].min_local = bt.min_leaf
        } else {
            bt.mem[s].int_key = false
            bt.mem[s].int_key_leaf = false
            bt.mem[s].size_kind = SIZE_PTR
            bt.mem[s].parse_kind = PARSE_INDEX
            return base.CORRUPT
        }
    }
    base.OK
}

// btreeComputeFreeSpace.
btree_compute_free_space: fn(bt: &Btree, s: Int) -> Int Never! {
    usable: bt.usable_size
    hdr: bt.mem[s].hdr_offset
    top: get2_not_zero(pg2(bt, s, hdr + 5))
    i_cell_first: hdr + 8 + bt.mem[s].child_ptr_size + 2 * bt.mem[s].n_cell
    i_cell_last: usable - 4
    pc := pg2(bt, s, hdr + 1)
    n_free := pb(bt, s, hdr + 7) + top
    if pc > 0 {
        if pc < top -> return base.CORRUPT
        next := 0
        size := 0
        loop {
            if pc > i_cell_last -> return base.CORRUPT
            next = pg2(bt, s, pc)
            size = pg2(bt, s, pc + 2)
            n_free = n_free + size
            if next <= pc + size + 3 -> break
            pc = next
        }
        if next > 0 -> return base.CORRUPT
        if pc + size > usable -> return base.CORRUPT
    }
    if n_free > usable || n_free < i_cell_first -> return base.CORRUPT
    bt.mem[s].n_free = (n_free - i_cell_first).bit_and(65535)
    base.OK
}

// btreeCellSizeCheck.
btree_cell_size_check: fn(bt: &Btree, s: Int) -> Int Never! {
    i_cell_first: bt.mem[s].cell_offset + 2 * bt.mem[s].n_cell
    usable: bt.usable_size
    i_cell_last := usable - 4
    cell_offset: bt.mem[s].cell_offset
    if !bt.mem[s].leaf -> i_cell_last -= 1
    loop i in 0..<bt.mem[s].n_cell {
        pc: pg2(bt, s, cell_offset + i * 2)
        if pc < i_cell_first || pc > i_cell_last -> return base.CORRUPT
        sz: cell_size(bt.mem[s], usable, bt.pager.pcache.pages[s].data, pc)
        if pc + sz > usable -> return base.CORRUPT
    }
    base.OK
}

// btreeInitPage.
btree_init_page: fn(bt: &Btree, s: Int) -> Int Never! {
    hdr: bt.mem[s].hdr_offset
    flag: pb(bt, s, hdr)
    if decode_flags(bt, s, flag) != base.OK -> return base.CORRUPT
    bt.mem[s].mask_page = (bt.page_size - 1).bit_and(65535)
    bt.mem[s].n_overflow = 0
    bt.mem[s].cell_offset = hdr + 8 + bt.mem[s].child_ptr_size
    n_cell: pg2(bt, s, hdr + 3)
    bt.mem[s].n_cell = n_cell
    if n_cell > mx_cell(bt) -> return base.CORRUPT
    bt.mem[s].n_free = -1
    bt.mem[s].is_init = true
    if bt.db.flags.bit_and(SQLITE_CELL_SIZE_CK) != 0 -> return btree_cell_size_check(bt, s)
    base.OK
}

// zeroPage.
zero_page: fn(bt: &Btree, s: Int, flags: Int) Never! {
    hdr: bt.mem[s].hdr_offset
    usable: bt.usable_size
    if bt.bts_flags.bit_and(BTS_FAST_SECURE) != 0 -> pzero(bt, s, hdr, usable - hdr)
    ps1(bt, s, hdr, flags)
    first: hdr + (if flags.bit_and(PTF_LEAF) == 0 -> 12 else -> 8)
    pzero(bt, s, hdr + 1, 4)
    ps1(bt, s, hdr + 7, 0)
    ps2(bt, s, hdr + 5, usable)
    bt.mem[s].n_free = (usable - first).bit_and(65535)
    _: decode_flags(bt, s, flags)
    bt.mem[s].cell_offset = first
    bt.mem[s].n_overflow = 0
    bt.mem[s].mask_page = (bt.page_size - 1).bit_and(65535)
    bt.mem[s].n_cell = 0
    bt.mem[s].is_init = true
}

// ---------------------------------------------------------------------------
// Getting and releasing pages.

// btreePageFromDbPage.
btree_page_from_db_page: fn(bt: &Btree, s: Int, pgno: Int) Never! {
    sync_extra(bt, s)
    if pgno != bt.mem[s].pgno {
        bt.mem[s].pgno = pgno
        bt.mem[s].hdr_offset = if pgno == 1 -> 100 else -> 0
    }
}

// btreeGetPage: page gets the slot of page pgno.
btree_get_page: fn(bt: &Btree, pgno: Int, page: &Int, flags: Int) -[DB]> Int Never! {
    s := cache.NO_PAGE
    rc: pager.pager_get(bt.pager, pgno, s, flags)
    if rc != base.OK -> return rc
    btree_page_from_db_page(bt, s, pgno)
    page = s
    base.OK
}

// btreePageLookup: the cached page pgno with a new reference, or NO_PAGE.
btree_page_lookup: fn(bt: &Btree, pgno: Int) -> Int Never! {
    s: pager.pager_lookup(bt.pager, pgno)
    if s != cache.NO_PAGE -> btree_page_from_db_page(bt, s, pgno)
    s
}

// btreePagecount and sqlite3BtreeLastPage.
btree_pagecount: fn(bt: Btree) -> Int Never! { bt.n_page }
btree_last_page: fn(bt: Btree) -> Int Never! { bt.n_page }

// getAndInitPage.
get_and_init_page: fn(bt: &Btree, pgno: Int, page: &Int, read_only: Int) -[DB]> Int Never! {
    if pgno > btree_pagecount(bt) {
        page = cache.NO_PAGE
        return base.CORRUPT
    }
    s := cache.NO_PAGE
    rc := pager.pager_get(bt.pager, pgno, s, read_only)
    if rc != base.OK {
        page = cache.NO_PAGE
        return rc
    }
    sync_extra(bt, s)
    if !bt.mem[s].is_init {
        btree_page_from_db_page(bt, s, pgno)
        rc = btree_init_page(bt, s)
        if rc != base.OK {
            release_page(bt, s)
            page = cache.NO_PAGE
            return rc
        }
    }
    page = s
    base.OK
}

// releasePageNotNull.
release_page_not_null: fn(bt: &Btree, s: Int) Never! { pager.pager_unref_not_null(bt.pager, s) }

// releasePage.
release_page: fn(bt: &Btree, s: Int) Never! {
    if s != cache.NO_PAGE -> release_page_not_null(bt, s)
}

// releasePageOne.
release_page_one: fn(bt: &Btree, s: Int) Never! -[DB]> {
    pager.pager_unref_page_one(bt.pager, s)
    drain_reinit(bt)
}

// btreeGetUnusedPage.
btree_get_unused_page: fn(bt: &Btree, pgno: Int, page: &Int, flags: Int) -[DB]> Int Never! {
    s := cache.NO_PAGE
    rc: btree_get_page(bt, pgno, s, flags)
    if rc == base.OK {
        if pager.pager_page_refcount(bt.pager, s) > 1 {
            release_page(bt, s)
            page = cache.NO_PAGE
            return base.CORRUPT
        }
        bt.mem[s].is_init = false
        page = s
    } else {
        page = cache.NO_PAGE
    }
    rc
}

// btreeInvokeBusyHandler.
btree_invoke_busy_handler: fn(bt: &Btree) -[DB]> Bool Never! { wal.busy_invoke(bt.pager.busy) }

// ---------------------------------------------------------------------------
// Opening and closing.

// sqlite3BtreeOpen. path None or "" opens a temporary database; psow,
// nolock, immutable and readonly_shm are the pager's URI options.
btree_open: fn(bt: &Btree, path: String?, db: BtDB, flags_in: Int, vfs_flags_in: Int, psow: Bool, nolock: Bool, immutable: Bool, readonly_shm: Bool) -[DB]> Int Never! {
    bt = btree_closed()
    name: path ?? ""
    is_temp_db: name == ""
    is_memdb: name == ":memory:" || (is_temp_db && db.temp_in_memory) || vfs_flags_in.bit_and(os.OPEN_MEMORY) != 0
    flags := flags_in
    if is_memdb -> flags = flags.bit_or(BTREE_MEMORY)
    vfs_flags := vfs_flags_in
    if vfs_flags.bit_and(os.OPEN_MAIN_DB) != 0 && (is_memdb || is_temp_db) -> vfs_flags = util.clear_bits(vfs_flags, os.OPEN_MAIN_DB).bit_or(os.OPEN_TEMP_DB)
    bt.in_trans = TRANS_NONE
    bt.db = db
    header := pager.zeros(100)
    rc := pager.pager_open(bt.pager, path, MEMPAGE_SIZE, flags, vfs_flags, psow, nolock, immutable, readonly_shm)
    if rc == base.OK -> rc = pager.pager_read_fileheader(bt.pager, 100, header)
    if rc != base.OK {
        if pager_opened(bt) -> pager.pager_close(bt.pager, false)
        bt = btree_closed()
        return rc
    }
    bt.open_flags = flags.bit_and(255)
    bt.cursor_list = [Int]{}
    bt.page1 = cache.NO_PAGE
    if pager.pager_is_readonly(bt.pager) -> bt.bts_flags = bt.bts_flags.bit_or(BTS_READ_ONLY)
    page_size := (Int.from_u8(header[16]) << 8).bit_or(Int.from_u8(header[17]) << 16)
    n_reserve := 0
    if page_size < 512 || page_size > pager.MAX_PAGE_SIZE || (page_size - 1).bit_and(page_size) != 0 {
        page_size = 0
        if path != None && !is_memdb {
            bt.auto_vacuum = DEFAULT_AUTOVACUUM != 0
            bt.incr_vacuum = DEFAULT_AUTOVACUUM == 2
        }
        n_reserve = 0
    } else {
        n_reserve = Int.from_u8(header[20])
        bt.bts_flags = bt.bts_flags.bit_or(BTS_PAGESIZE_FIXED)
        bt.auto_vacuum = util.get4(header, 36 + 4 * 4) != 0
        bt.incr_vacuum = util.get4(header, 36 + 7 * 4) != 0
    }
    rc = pager.pager_set_pagesize(bt.pager, page_size, n_reserve)
    bt.page_size = page_size
    if rc != base.OK {
        pager.pager_close(bt.pager, false)
        bt = btree_closed()
        return rc
    }
    bt.usable_size = bt.page_size - n_reserve
    btree_set_cache_size(bt, DEFAULT_CACHE_SIZE)
    base.OK
}

// The pager reached sqlite3PagerOpen's success (its file state is set).
pager_opened: fn(bt: Btree) -> Bool Never! { bt.pager.page_size > 0 }

// freeTempSpace.
free_temp_space: fn(bt: &Btree) Never! { bt.tmp_space = [U8]{} }

// allocateTempSpace.
allocate_temp_space: fn(bt: &Btree) Never! {
    if bt.tmp_space.len() == 0 -> bt.tmp_space = pager.zeros(bt.page_size)
}

// sqlite3BtreeClose.
btree_close: fn(bt: &Btree) -[DB]> Int Never! {
    _: btree_rollback(bt, base.OK, false)
    ckpt: bt.db.flags.bit_and(SQLITE_NO_CKPT_ON_CLOSE) == 0
    pager.pager_close(bt.pager, ckpt)
    free_temp_space(bt)
    bt = btree_closed()
    base.OK
}

// sqlite3BtreeSetCacheSize.
btree_set_cache_size: fn(bt: &Btree, mx_page: Int) Never! { pager.pager_set_cachesize(bt.pager, mx_page) }

// sqlite3BtreeSetSpillSize.
btree_set_spill_size: fn(bt: &Btree, mx_page: Int) -> Int Never! { pager.pager_set_spillsize(bt.pager, mx_page) }

// sqlite3BtreeSetPagerFlags.
btree_set_pager_flags: fn(bt: &Btree, pg_flags: Int) Never! { pager.pager_set_flags(bt.pager, pg_flags) }

// sqlite3BtreeSetPageSize.
btree_set_page_size: fn(bt: &Btree, page_size_in: Int, n_reserve_in: Int, fix: Bool) -[DB]> Int Never! {
    bt.n_reserve_wanted = n_reserve_in
    x: bt.page_size - bt.usable_size
    n_reserve := n_reserve_in
    if n_reserve < x -> n_reserve = x
    if bt.bts_flags.bit_and(BTS_PAGESIZE_FIXED) != 0 -> return base.READONLY
    page_size := page_size_in
    if page_size >= 512 && page_size <= pager.MAX_PAGE_SIZE && (page_size - 1).bit_and(page_size) == 0 {
        if n_reserve > 32 && page_size == 512 -> page_size = 1024
        bt.page_size = page_size
        free_temp_space(bt)
    }
    ps := bt.page_size
    rc: pager.pager_set_pagesize(bt.pager, ps, n_reserve)
    bt.page_size = ps
    bt.usable_size = bt.page_size - n_reserve.bit_and(65535)
    if fix -> bt.bts_flags = bt.bts_flags.bit_or(BTS_PAGESIZE_FIXED)
    rc
}

// sqlite3BtreeGetPageSize.
btree_get_page_size: fn(bt: Btree) -> Int Never! { bt.page_size }

// sqlite3BtreeGetReserveNoMutex.
btree_get_reserve_no_mutex: fn(bt: Btree) -> Int Never! { bt.page_size - bt.usable_size }

// sqlite3BtreeGetRequestedReserve.
btree_get_requested_reserve: fn(bt: Btree) -> Int Never! {
    n1: bt.n_reserve_wanted
    n2: btree_get_reserve_no_mutex(bt)
    if n1 > n2 -> n1 else -> n2
}

// sqlite3BtreeMaxPageCount.
btree_max_page_count: fn(bt: &Btree, mx_page: Int) -> Int Never! { pager.pager_max_page_count(bt.pager, mx_page) }

// sqlite3BtreeSecureDelete: set it (0, 1 or 2 for fast) when new_flag >= 0;
// the setting in effect.
btree_secure_delete: fn(bt: &Btree, new_flag: Int) -> Int Never! {
    if new_flag >= 0 {
        bt.bts_flags = util.clear_bits(bt.bts_flags, BTS_FAST_SECURE)
        bt.bts_flags = bt.bts_flags.bit_or(BTS_SECURE_DELETE * new_flag)
    }
    bt.bts_flags.bit_and(BTS_FAST_SECURE) /% BTS_SECURE_DELETE
}

// sqlite3BtreeSetAutoVacuum.
btree_set_auto_vacuum: fn(bt: &Btree, auto_vacuum: Int) -> Int Never! {
    av: auto_vacuum.bit_and(255)
    if bt.bts_flags.bit_and(BTS_PAGESIZE_FIXED) != 0 && (av != 0) != bt.auto_vacuum -> return base.READONLY
    bt.auto_vacuum = av != 0
    bt.incr_vacuum = av == 2
    base.OK
}

// sqlite3BtreeGetAutoVacuum.
btree_get_auto_vacuum: fn(bt: Btree) -> Int Never! {
    if !bt.auto_vacuum -> return BTREE_AUTOVACUUM_NONE
    if !bt.incr_vacuum -> return BTREE_AUTOVACUUM_FULL
    BTREE_AUTOVACUUM_INCR
}

// page1[at..<at + n] equals want.
page_bytes_eq: fn(bt: Btree, s: Int, at: Int, want: [U8]) -> Bool Never! {
    loop i in 0..<want.len() {
        if pb(bt, s, at + i) != Int.from_u8(want[i]) -> return false
    }
    true
}

// lockBtree's page1_init_failed.
page1_init_failed: fn(bt: &Btree, s: Int, rc: Int) -[DB]> Int Never! {
    release_page_one(bt, s)
    bt.page1 = cache.NO_PAGE
    rc
}

// lockBtree: read page 1 and take a shared lock on the file.
lock_btree: fn(bt: &Btree) -[DB]> Int Never! {
    rc := pager.pager_shared_lock(bt.pager)
    drain_reinit(bt)
    if rc != base.OK -> return rc
    s1 := cache.NO_PAGE
    rc = btree_get_page(bt, 1, s1, 0)
    if rc != base.OK -> return rc
    n_page := pg4(bt, s1, 28)
    // sqlite3PagerPagecount: the pager's dbSize.
    n_page_file: pager.pager_page_count(bt.pager)
    if n_page == 0 || pg4(bt, s1, 24) != pg4(bt, s1, 92) -> n_page = n_page_file
    if bt.db.flags.bit_and(SQLITE_RESET_DATABASE) != 0 -> n_page = 0
    if n_page > 0 {
        rc = base.NOTADB
        if !page_bytes_eq(bt, s1, 0, MAGIC_HEADER) -> return page1_init_failed(bt, s1, rc)
        if pb(bt, s1, 18) > 2 -> bt.bts_flags = bt.bts_flags.bit_or(BTS_READ_ONLY)
        if pb(bt, s1, 19) > 2 -> return page1_init_failed(bt, s1, rc)
        if pb(bt, s1, 19) == 2 && bt.bts_flags.bit_and(BTS_NO_WAL) == 0 {
            is_open := false
            rc = pager.pager_open_wal(bt.pager, is_open)
            if rc != base.OK -> return page1_init_failed(bt, s1, rc)
            if !is_open {
                release_page_one(bt, s1)
                return base.OK
            }
            rc = base.NOTADB
        }
        if pb(bt, s1, 21) != 64 || pb(bt, s1, 22) != 32 || pb(bt, s1, 23) != 32 -> return page1_init_failed(bt, s1, rc)
        page_size := (pb(bt, s1, 16) << 8).bit_or(pb(bt, s1, 17) << 16)
        if (page_size - 1).bit_and(page_size) != 0 || page_size > pager.MAX_PAGE_SIZE || page_size <= 256 -> return page1_init_failed(bt, s1, rc)
        usable: page_size - pb(bt, s1, 20)
        if page_size != bt.page_size {
            release_page_one(bt, s1)
            bt.usable_size = usable
            bt.page_size = page_size
            bt.bts_flags = bt.bts_flags.bit_or(BTS_PAGESIZE_FIXED)
            free_temp_space(bt)
            ps := page_size
            r: pager.pager_set_pagesize(bt.pager, ps, page_size - usable)
            bt.page_size = ps
            return r
        }
        if n_page > n_page_file {
            if !writable_schema(bt.db) -> return page1_init_failed(bt, s1, base.CORRUPT)
            n_page = n_page_file
        }
        if usable < 480 -> return page1_init_failed(bt, s1, rc)
        bt.bts_flags = bt.bts_flags.bit_or(BTS_PAGESIZE_FIXED)
        bt.page_size = page_size
        bt.usable_size = usable
        bt.auto_vacuum = pg4(bt, s1, 36 + 4 * 4) != 0
        bt.incr_vacuum = pg4(bt, s1, 36 + 7 * 4) != 0
    }
    bt.max_local = ((bt.usable_size - 12) * 64 /% 255 - 23).bit_and(65535)
    bt.min_local = ((bt.usable_size - 12) * 32 /% 255 - 23).bit_and(65535)
    bt.max_leaf = (bt.usable_size - 35).bit_and(65535)
    bt.min_leaf = ((bt.usable_size - 12) * 32 /% 255 - 23).bit_and(65535)
    bt.max1byte_payload = if bt.max_local > 127 -> 127 else -> bt.max_local
    bt.page1 = s1
    bt.n_page = n_page
    base.OK
}

// unlockBtreeIfUnused.
unlock_btree_if_unused: fn(bt: &Btree) Never! -[DB]> {
    if bt.in_transaction == TRANS_NONE && bt.page1 != cache.NO_PAGE {
        s1: bt.page1
        bt.page1 = cache.NO_PAGE
        release_page_one(bt, s1)
    }
}

// newDatabase: make page 1 of an empty file.
new_database: fn(bt: &Btree) -[DB]> Int Never! {
    if bt.n_page > 0 -> return base.OK
    s1: bt.page1
    rc: pager.pager_write(bt.pager, s1)
    if rc != base.OK -> return rc
    pager.copy_into(bt.pager.pcache.pages[s1].data, 0, MAGIC_HEADER, 0, 16)
    ps1(bt, s1, 16, (bt.page_size >> 8).bit_and(255))
    ps1(bt, s1, 17, (bt.page_size >> 16).bit_and(255))
    ps1(bt, s1, 18, 1)
    ps1(bt, s1, 19, 1)
    ps1(bt, s1, 20, bt.page_size - bt.usable_size)
    ps1(bt, s1, 21, 64)
    ps1(bt, s1, 22, 32)
    ps1(bt, s1, 23, 32)
    pzero(bt, s1, 24, 100 - 24)
    zero_page(bt, s1, PTF_INTKEY.bit_or(PTF_LEAF).bit_or(PTF_LEAFDATA))
    bt.bts_flags = bt.bts_flags.bit_or(BTS_PAGESIZE_FIXED)
    av: if bt.auto_vacuum -> 1 else -> 0
    iv: if bt.incr_vacuum -> 1 else -> 0
    ps4(bt, s1, 36 + 4 * 4, av)
    ps4(bt, s1, 36 + 7 * 4, iv)
    bt.n_page = 1
    ps1(bt, s1, 31, 1)
    base.OK
}

// sqlite3BtreeNewDb.
btree_new_db: fn(bt: &Btree) -[DB]> Int Never! {
    bt.n_page = 0
    new_database(bt)
}

// btreeBeginTrans. wrflag is 0 (read), 1 (write) or 2 (exclusive);
// schema_version gets the schema cookie.
btree_begin_trans_inner: fn(bt: &Btree, wrflag: Int, schema_version: &Int) -[DB]> Int Never! {
    rc := base.OK
    skip := false
    if bt.in_trans == TRANS_WRITE || (bt.in_trans == TRANS_READ && wrflag == 0) -> skip = true
    if !skip {
        if bt.db.flags.bit_and(SQLITE_RESET_DATABASE) != 0 && !pager.pager_is_readonly(bt.pager) -> bt.bts_flags = util.clear_bits(bt.bts_flags, BTS_READ_ONLY)
        if bt.bts_flags.bit_and(BTS_READ_ONLY) != 0 && wrflag != 0 {
            rc = base.READONLY
            skip = true
        }
    }
    if !skip {
        bt.bts_flags = util.clear_bits(bt.bts_flags, BTS_INITIALLY_EMPTY)
        if bt.n_page == 0 -> bt.bts_flags = bt.bts_flags.bit_or(BTS_INITIALLY_EMPTY)
        loop {
            loop bt.page1 == cache.NO_PAGE {
                rc = lock_btree(bt)
                if rc != base.OK -> break
            }
            if rc == base.OK && wrflag != 0 {
                if bt.bts_flags.bit_and(BTS_READ_ONLY) != 0 {
                    rc = base.READONLY
                } else {
                    tim: bt.db.temp_in_memory
                    rc = pager.pager_begin(bt.pager, wrflag > 1, tim)
                    if rc == base.OK {
                        rc = new_database(bt)
                    } else if rc == base.BUSY_SNAPSHOT && bt.in_transaction == TRANS_NONE {
                        rc = base.BUSY
                    }
                }
            }
            if rc != base.OK -> unlock_btree_if_unused(bt)
            if !(rc.bit_and(255) == base.BUSY && bt.in_transaction == TRANS_NONE && btree_invoke_busy_handler(bt)) -> break
        }
        if rc == base.OK {
            if bt.in_trans == TRANS_NONE -> bt.n_transaction += 1
            bt.in_trans = if wrflag != 0 -> TRANS_WRITE else -> TRANS_READ
            if bt.in_trans > bt.in_transaction -> bt.in_transaction = bt.in_trans
            if wrflag != 0 {
                s1: bt.page1
                n: bt.n_page
                if n != pg4(bt, s1, 28) {
                    rc = pager.pager_write(bt.pager, s1)
                    if rc == base.OK -> ps4(bt, s1, 28, n)
                }
            }
        }
    }
    // trans_begun.
    if rc == base.OK {
        schema_version = pg4(bt, bt.page1, 40)
        if wrflag != 0 {
            n_sp: bt.db.n_savepoint
            pager.pager_open_savepoint(bt.pager, n_sp)
        }
    }
    rc
}

// sqlite3BtreeBeginTrans.
btree_begin_trans: fn(bt: &Btree, wrflag: Int, schema_version: &Int) -[DB]> Int Never! {
    if bt.in_trans == TRANS_NONE || (bt.in_trans == TRANS_READ && wrflag != 0) -> return btree_begin_trans_inner(bt, wrflag, schema_version)
    schema_version = pg4(bt, bt.page1, 40)
    if wrflag != 0 {
        n_sp: bt.db.n_savepoint
        pager.pager_open_savepoint(bt.pager, n_sp)
    }
    base.OK
}

// ---------------------------------------------------------------------------
// Auto-vacuum.

// setChildPtrmaps.
set_child_ptrmaps: fn(bt: &Btree, s: Int) -[DB]> Int Never! {
    pgno: bt.mem[s].pgno
    rc := if bt.mem[s].is_init -> base.OK else -> btree_init_page(bt, s)
    if rc != base.OK -> return rc
    n_cell: bt.mem[s].n_cell
    limit: bt.page_size
    loop i in 0..<n_cell {
        cell: find_cell(bt, s, i)
        data: bt.pager.pcache.pages[s].data.copy()
        ptrmap_put_ovfl_ptr(bt, s, data, cell, limit, rc)
        if !bt.mem[s].leaf {
            child: pg4(bt, s, cell)
            ptrmap_put(bt, child, PTRMAP_BTREE, pgno, rc)
        }
    }
    if !bt.mem[s].leaf {
        child: pg4(bt, s, bt.mem[s].hdr_offset + 8)
        ptrmap_put(bt, child, PTRMAP_BTREE, pgno, rc)
    }
    rc
}

// modifyPagePointer.
modify_page_pointer: fn(bt: &Btree, s: Int, i_from: Int, i_to: Int, e_type: Int) -> Int Never! {
    if e_type == PTRMAP_OVERFLOW2 {
        if pg4(bt, s, 0) != i_from -> return base.CORRUPT
        ps4(bt, s, 0, i_to)
        return base.OK
    }
    rc: if bt.mem[s].is_init -> base.OK else -> btree_init_page(bt, s)
    if rc != base.OK -> return rc
    n_cell: bt.mem[s].n_cell
    usable: bt.usable_size
    i := 0
    loop i < n_cell {
        cell: find_cell(bt, s, i)
        if e_type == PTRMAP_OVERFLOW1 {
            info := cell_info_zero()
            parse_cell(bt.mem[s], usable, bt.pager.pcache.pages[s].data, cell, info)
            if info.n_local < info.n_payload {
                if cell + info.n_size > usable -> return base.CORRUPT
                if i_from == pg4(bt, s, cell + info.n_size - 4) {
                    ps4(bt, s, cell + info.n_size - 4, i_to)
                    break
                }
            }
        } else {
            if cell + 4 > usable -> return base.CORRUPT
            if pg4(bt, s, cell) == i_from {
                ps4(bt, s, cell, i_to)
                break
            }
        }
        i += 1
    }
    if i == n_cell {
        at: bt.mem[s].hdr_offset + 8
        if e_type != PTRMAP_BTREE || pg4(bt, s, at) != i_from -> return base.CORRUPT
        ps4(bt, s, at, i_to)
    }
    base.OK
}

// relocatePage: move page s (of type e_type, its pointer on page
// i_ptr_page) to page i_free_page.
relocate_page: fn(bt: &Btree, s: Int, e_type: Int, i_ptr_page: Int, i_free_page: Int, is_commit: Bool) -[DB]> Int Never! {
    i_db_page: bt.mem[s].pgno
    if i_db_page < 3 -> return base.CORRUPT
    rc := pager.pager_movepage(bt.pager, s, i_free_page, is_commit)
    if rc != base.OK -> return rc
    bt.mem[s].pgno = i_free_page
    if e_type == PTRMAP_BTREE || e_type == PTRMAP_ROOTPAGE {
        rc = set_child_ptrmaps(bt, s)
        if rc != base.OK -> return rc
    } else {
        next_ovfl: pg4(bt, s, 0)
        if next_ovfl != 0 {
            ptrmap_put(bt, next_ovfl, PTRMAP_OVERFLOW2, i_free_page, rc)
            if rc != base.OK -> return rc
        }
    }
    if e_type != PTRMAP_ROOTPAGE {
        sp := cache.NO_PAGE
        rc = btree_get_page(bt, i_ptr_page, sp, 0)
        if rc != base.OK -> return rc
        rc = pager.pager_write(bt.pager, sp)
        if rc != base.OK {
            release_page(bt, sp)
            return rc
        }
        rc = modify_page_pointer(bt, sp, i_db_page, i_free_page, e_type)
        release_page(bt, sp)
        if rc == base.OK -> ptrmap_put(bt, i_free_page, e_type, i_ptr_page, rc)
    }
    rc
}

// incrVacuumStep.
incr_vacuum_step: fn(bt: &Btree, n_fin: Int, i_last_pg_in: Int, commit: Bool) -[DB]> Int Never! {
    i_last_pg := i_last_pg_in
    if !ptrmap_is_page(bt, i_last_pg) && i_last_pg != pending_byte_page(bt) {
        n_free_list: pg4(bt, bt.page1, 36)
        if n_free_list == 0 -> return base.DONE
        e_type := 0
        i_ptr_page := 0
        rc := ptrmap_get(bt, i_last_pg, e_type, i_ptr_page)
        if rc != base.OK -> return rc
        if e_type == PTRMAP_ROOTPAGE -> return base.CORRUPT
        if e_type == PTRMAP_FREEPAGE {
            if !commit {
                i_free_pg := 0
                sf := cache.NO_PAGE
                rc = allocate_btree_page(bt, sf, i_free_pg, i_last_pg, BTALLOC_EXACT)
                if rc != base.OK -> return rc
                release_page(bt, sf)
            }
        } else {
            sl := cache.NO_PAGE
            rc = btree_get_page(bt, i_last_pg, sl, 0)
            if rc != base.OK -> return rc
            e_mode := BTALLOC_ANY
            i_near := 0
            if !commit {
                e_mode = BTALLOC_LE
                i_near = n_fin
            }
            i_free_pg := 0
            loop {
                db_size: btree_pagecount(bt)
                sf := cache.NO_PAGE
                rc = allocate_btree_page(bt, sf, i_free_pg, i_near, e_mode)
                if rc != base.OK {
                    release_page(bt, sl)
                    return rc
                }
                release_page(bt, sf)
                if i_free_pg > db_size {
                    release_page(bt, sl)
                    return base.CORRUPT
                }
                if !(commit && i_free_pg > n_fin) -> break
            }
            rc = relocate_page(bt, sl, e_type, i_ptr_page, i_free_pg, commit)
            release_page(bt, sl)
            if rc != base.OK -> return rc
        }
    }
    if !commit {
        loop {
            i_last_pg -= 1
            if !(i_last_pg == pending_byte_page(bt) || ptrmap_is_page(bt, i_last_pg)) -> break
        }
        bt.do_truncate = true
        bt.n_page = i_last_pg
    }
    base.OK
}

// finalDbSize.
final_db_size: fn(bt: Btree, n_orig: Int, n_free: Int) -> Int Never! {
    n_entry: bt.usable_size /% 5
    n_ptrmap: (n_free - n_orig + ptrmap_pageno(bt, n_orig) + n_entry) /% n_entry
    n_fin := n_orig - n_free - n_ptrmap
    pbp: pending_byte_page(bt)
    if n_orig > pbp && n_fin < pbp -> n_fin -= 1
    loop ptrmap_is_page(bt, n_fin) || n_fin == pbp -> n_fin -= 1
    n_fin
}

// sqlite3BtreeIncrVacuum.
btree_incr_vacuum: fn(bt: &Btree) -[DB]> Int Never! {
    if !bt.auto_vacuum -> return base.DONE
    n_orig: btree_pagecount(bt)
    n_free: pg4(bt, bt.page1, 36)
    n_fin: final_db_size(bt, n_orig, n_free)
    if n_orig < n_fin || n_free >= n_orig -> return base.CORRUPT
    if n_free == 0 -> return base.DONE
    rc := save_all_cursors(bt, 0, -1)
    if rc == base.OK {
        invalidate_all_overflow_cache(bt)
        rc = incr_vacuum_step(bt, n_fin, n_orig, false)
    }
    if rc == base.OK {
        s1: bt.page1
        rc = pager.pager_write(bt.pager, s1)
        n: bt.n_page
        ps4(bt, s1, 28, n)
    }
    rc
}

// autoVacuumCommit.
auto_vacuum_commit: fn(bt: &Btree) -[DB]> Int Never! {
    rc := base.OK
    invalidate_all_overflow_cache(bt)
    if bt.incr_vacuum -> return rc
    n_orig: btree_pagecount(bt)
    if ptrmap_is_page(bt, n_orig) || n_orig == pending_byte_page(bt) -> return base.CORRUPT
    n_free: pg4(bt, bt.page1, 36)
    n_vac := n_free
    if bt.db.autovac_pages == .Val(cb) {
        n_vac = cb(bt.db.db_name, n_orig, n_free, bt.page_size)
        if n_vac > n_free -> n_vac = n_free
        if n_vac == 0 -> return base.OK
    }
    n_fin: final_db_size(bt, n_orig, n_vac)
    if n_fin > n_orig -> return base.CORRUPT
    if n_fin < n_orig -> rc = save_all_cursors(bt, 0, -1)
    i_free := n_orig
    loop i_free > n_fin && rc == base.OK {
        rc = incr_vacuum_step(bt, n_fin, i_free, n_vac == n_free)
        i_free -= 1
    }
    if (rc == base.DONE || rc == base.OK) && n_free > 0 {
        s1: bt.page1
        rc = pager.pager_write(bt.pager, s1)
        if n_vac == n_free {
            ps4(bt, s1, 32, 0)
            ps4(bt, s1, 36, 0)
        }
        ps4(bt, s1, 28, n_fin)
        bt.do_truncate = true
        bt.n_page = n_fin
    }
    if rc != base.OK {
        _: pager.pager_rollback(bt.pager)
        drain_reinit(bt)
    }
    rc
}

// ---------------------------------------------------------------------------
// Committing and rolling back.

// sqlite3BtreeCommitPhaseOne.
btree_commit_phase_one: fn(bt: &Btree, super: String?) -[DB]> Int Never! {
    if bt.in_trans != TRANS_WRITE -> return base.OK
    if bt.auto_vacuum {
        rc: auto_vacuum_commit(bt)
        if rc != base.OK -> return rc
    }
    if bt.do_truncate {
        n: bt.n_page
        pager.pager_truncate_image(bt.pager, n)
    }
    pager.pager_commit_phase_one(bt.pager, super, false)
}

// btreeEndTransaction.
btree_end_transaction: fn(bt: &Btree) Never! -[DB]> {
    bt.do_truncate = false
    if bt.in_trans > TRANS_NONE && bt.db.n_vdbe_read > 1 {
        bt.in_trans = TRANS_READ
    } else {
        if bt.in_trans != TRANS_NONE {
            bt.n_transaction -= 1
            if bt.n_transaction == 0 -> bt.in_transaction = TRANS_NONE
        }
        bt.in_trans = TRANS_NONE
        unlock_btree_if_unused(bt)
    }
}

// sqlite3BtreeCommitPhaseTwo.
btree_commit_phase_two: fn(bt: &Btree, cleanup: Bool) -[DB]> Int Never! {
    if bt.in_trans == TRANS_NONE -> return base.OK
    if bt.in_trans == TRANS_WRITE {
        rc: pager.pager_commit_phase_two(bt.pager)
        if rc != base.OK && !cleanup -> return rc
        bt.b_data_version -= 1
        bt.in_transaction = TRANS_READ
        btree_clear_has_content(bt)
    }
    btree_end_transaction(bt)
    base.OK
}

// sqlite3BtreeCommit.
btree_commit: fn(bt: &Btree) -[DB]> Int Never! {
    rc := btree_commit_phase_one(bt, None)
    if rc == base.OK -> rc = btree_commit_phase_two(bt, false)
    rc
}

// sqlite3BtreeTripAllCursors.
btree_trip_all_cursors: fn(bt: &Btree, err_code: Int, write_only: Bool) -[DB]> Int Never! {
    rc := base.OK
    loop c in bt.cursor_list.copy() {
        if write_only && bt.cursors[c].cur_flags.bit_and(BTCF_WRITE_FLAG) == 0 {
            st: bt.cursors[c].state
            if st == CURSOR_VALID || st == CURSOR_SKIPNEXT {
                rc = save_cursor_position(bt, c)
                if rc != base.OK {
                    _: btree_trip_all_cursors(bt, rc, false)
                    break
                }
            }
        } else {
            btree_clear_cursor(bt, c)
            bt.cursors[c].state = CURSOR_FAULT
            bt.cursors[c].skip_next = err_code
        }
        btree_release_all_cursor_pages(bt, c)
    }
    rc
}

// btreeSetNPage.
btree_set_npage: fn(bt: &Btree, s1: Int) Never! {
    n_page := pg4(bt, s1, 28)
    if n_page == 0 -> n_page = pager.pager_page_count(bt.pager)
    bt.n_page = n_page
}

// sqlite3BtreeRollback.
btree_rollback: fn(bt: &Btree, trip_code_in: Int, write_only_in: Bool) -[DB]> Int Never! {
    rc := base.OK
    trip_code := trip_code_in
    write_only := write_only_in
    if trip_code == base.OK {
        trip_code = save_all_cursors(bt, 0, -1)
        rc = trip_code
        if rc != base.OK -> write_only = false
    }
    if trip_code != base.OK {
        rc2: btree_trip_all_cursors(bt, trip_code, write_only)
        if rc2 != base.OK -> rc = rc2
    }
    if bt.in_trans == TRANS_WRITE {
        rc2: pager.pager_rollback(bt.pager)
        drain_reinit(bt)
        if rc2 != base.OK -> rc = rc2
        s1 := cache.NO_PAGE
        if btree_get_page(bt, 1, s1, 0) == base.OK {
            btree_set_npage(bt, s1)
            release_page_one(bt, s1)
        }
        bt.in_transaction = TRANS_READ
        btree_clear_has_content(bt)
    }
    btree_end_transaction(bt)
    rc
}

// sqlite3BtreeBeginStmt.
btree_begin_stmt: fn(bt: &Btree, i_statement: Int) -> Int Never! {
    pager.pager_open_savepoint(bt.pager, i_statement)
    base.OK
}

// sqlite3BtreeSavepoint: release (SAVEPOINT_RELEASE) or roll back to
// savepoint i_savepoint (-1 for the whole transaction).
btree_savepoint: fn(bt: &Btree, op: Int, i_savepoint: Int) -[DB]> Int Never! {
    if bt.in_trans != TRANS_WRITE -> return base.OK
    rc := base.OK
    if op == base.SAVEPOINT_ROLLBACK -> rc = save_all_cursors(bt, 0, -1)
    if rc == base.OK {
        rc = pager.pager_savepoint(bt.pager, op, i_savepoint)
        drain_reinit(bt)
    }
    if rc == base.OK {
        if i_savepoint < 0 && bt.bts_flags.bit_and(BTS_INITIALLY_EMPTY) != 0 -> bt.n_page = 0
        rc = new_database(bt)
        s1: bt.page1
        btree_set_npage(bt, s1)
    }
    rc
}

// ---------------------------------------------------------------------------
// Cursors.

// btreeCursor: cur gets the new cursor on root page i_table. wr_flag is 0,
// BTREE_WRCSR or BTREE_WRCSR|BTREE_FORDELETE; key_info is set for an
// index.
btree_cursor: fn(bt: &Btree, i_table_in: Int, wr_flag: Int, key_info: record.KeyInfo?, cur: &Int) -> Int Never! {
    cur = -1
    i_table := i_table_in
    if i_table <= 1 {
        if i_table < 1 -> return base.CORRUPT
        if btree_pagecount(bt) == 0 -> i_table = 0
    }
    c := -1
    loop k in 0..<bt.cursors.len() {
        if !bt.cursors[k].live {
            c = k
            break
        }
    }
    if c < 0 {
        c = bt.cursors.len()
        bt.cursors.push(cursor_closed())
    }
    bt.cursors[c] = cursor_closed()
    bt.cursors[c].live = true
    bt.cursors[c].pgno_root = i_table
    bt.cursors[c].i_page = -1
    bt.cursors[c].key_info = key_info
    bt.cursors[c].cur_flags = 0
    loop x in bt.cursor_list.copy() {
        if bt.cursors[x].pgno_root == i_table {
            bt.cursors[x].cur_flags = bt.cursors[x].cur_flags.bit_or(BTCF_MULTIPLE)
            bt.cursors[c].cur_flags = BTCF_MULTIPLE
        }
    }
    bt.cursors[c].state = CURSOR_INVALID
    list := [Int]{c}
    loop x in bt.cursor_list.copy() -> list.push(x)
    bt.cursor_list = list
    cur = c
    if wr_flag != 0 {
        bt.cursors[c].cur_flags = bt.cursors[c].cur_flags.bit_or(BTCF_WRITE_FLAG)
        bt.cursors[c].cur_pager_flags = 0
        allocate_temp_space(bt)
    } else {
        bt.cursors[c].cur_pager_flags = pager.PAGER_GET_READONLY
    }
    base.OK
}

// sqlite3BtreeCloseCursor.
btree_close_cursor: fn(bt: &Btree, c: Int) -[DB]> Int Never! {
    if c < 0 || c >= bt.cursors.len() || !bt.cursors[c].live -> return base.OK
    list := [Int]{}
    loop x in bt.cursor_list.copy() {
        if x != c -> list.push(x)
    }
    bt.cursor_list = list
    btree_release_all_cursor_pages(bt, c)
    unlock_btree_if_unused(bt)
    bt.cursors[c] = cursor_closed()
    if bt.open_flags.bit_and(BTREE_SINGLE) != 0 && bt.cursor_list.len() == 0 -> _: btree_close(bt)
    base.OK
}

// getCellInfo.
get_cell_info: fn(bt: &Btree, c: Int) Never! {
    if bt.cursors[c].info.n_size == 0 {
        bt.cursors[c].cur_flags = bt.cursors[c].cur_flags.bit_or(BTCF_VALID_NKEY)
        info := cell_info_zero()
        btree_parse_cell(bt, bt.cursors[c].page, bt.cursors[c].ix, info)
        bt.cursors[c].info = info
    }
}

// sqlite3BtreeCursorIsValidNN.
btree_cursor_is_valid_nn: fn(bt: Btree, c: Int) -> Bool Never! { bt.cursors[c].state == CURSOR_VALID }

// sqlite3BtreeIntegerKey.
btree_integer_key: fn(bt: &Btree, c: Int) -> Int Never! {
    get_cell_info(bt, c)
    bt.cursors[c].info.n_key
}

// sqlite3BtreeCursorPin and sqlite3BtreeCursorUnpin.
btree_cursor_pin: fn(bt: &Btree, c: Int) Never! { bt.cursors[c].cur_flags = bt.cursors[c].cur_flags.bit_or(BTCF_PINNED) }
btree_cursor_unpin: fn(bt: &Btree, c: Int) Never! { bt.cursors[c].cur_flags = util.clear_bits(bt.cursors[c].cur_flags, BTCF_PINNED) }

// sqlite3BtreeOffset.
btree_offset: fn(bt: &Btree, c: Int) -> Int Never! {
    get_cell_info(bt, c)
    s: bt.cursors[c].page
    bt.page_size * (bt.mem[s].pgno - 1) + bt.cursors[c].info.payload
}

// sqlite3BtreePayloadSize.
btree_payload_size: fn(bt: &Btree, c: Int) -> Int Never! {
    get_cell_info(bt, c)
    bt.cursors[c].info.n_payload
}

// sqlite3BtreeMaxRecordSize.
btree_max_record_size: fn(bt: Btree) -> Int Never! { bt.page_size * bt.n_page }

// getOverflowPage: next gets the page after overflow page ovfl; page gets
// ovfl's slot when want_page (else it is released).
get_overflow_page: fn(bt: &Btree, ovfl: Int, want_page: Bool, page: &Int, next: &Int) -[DB]> Int Never! {
    nxt := 0
    s := cache.NO_PAGE
    rc := base.OK
    if bt.auto_vacuum {
        i_guess := ovfl + 1
        loop ptrmap_is_page(bt, i_guess) || i_guess == pending_byte_page(bt) -> i_guess += 1
        if i_guess <= btree_pagecount(bt) {
            e_type := 0
            pgno := 0
            rc = ptrmap_get(bt, i_guess, e_type, pgno)
            if rc == base.OK && e_type == PTRMAP_OVERFLOW2 && pgno == ovfl {
                nxt = i_guess
                rc = base.DONE
            }
        }
    }
    if rc == base.OK {
        flags: if want_page -> 0 else -> pager.PAGER_GET_READONLY
        rc = btree_get_page(bt, ovfl, s, flags)
        if rc == base.OK -> nxt = pg4(bt, s, 0)
    }
    next = nxt
    if want_page {
        page = s
    } else {
        release_page(bt, s)
    }
    if rc == base.DONE -> base.OK else -> rc
}

// copyPayload between page s at `at` and buf at pos.
copy_payload: fn(bt: &Btree, s: Int, at: Int, buf: &[U8], pos: Int, n: Int, write: Bool) -[DB]> Int Never! {
    if write {
        rc: pager.pager_write(bt.pager, s)
        if rc != base.OK -> return rc
        loop i in 0..<n -> bt.pager.pcache.pages[s].data[at + i] = buf[pos + i]
    } else {
        loop i in 0..<n -> buf[pos + i] = bt.pager.pcache.pages[s].data[at + i]
    }
    base.OK
}

// aOverflow[i], 0 past the cached entries.
ovfl_at: fn(bt: Btree, c: Int, i: Int) -> Int Never! {
    if i < 0 || i >= bt.cursors[c].overflow.len() -> return 0
    bt.cursors[c].overflow[i]
}

// accessPayload: read (or write, for write) amt bytes of the cursor's
// payload from offset into (from) buf.
access_payload: fn(bt: &Btree, c: Int, offset_in: Int, amt_in: Int, buf: &[U8], write: Bool) -[DB]> Int Never! {
    s: bt.cursors[c].page
    if bt.cursors[c].ix >= bt.mem[s].n_cell -> return base.CORRUPT
    get_cell_info(bt, c)
    payload: bt.cursors[c].info.payload
    n_local: bt.cursors[c].info.n_local
    n_payload: bt.cursors[c].info.n_payload
    if payload > bt.usable_size - n_local -> return base.CORRUPT
    rc := base.OK
    offset := offset_in
    amt := amt_in
    pos := 0
    if offset < n_local {
        a := amt
        if a + offset > n_local -> a = n_local - offset
        rc = copy_payload(bt, s, payload + offset, buf, pos, a, write)
        offset = 0
        pos += a
        amt -= a
    } else {
        offset -= n_local
    }
    if rc == base.OK && amt > 0 {
        ovfl_size: bt.usable_size - 4
        next_page := pg4(bt, s, payload + n_local)
        i_idx := 0
        if bt.cursors[c].cur_flags.bit_and(BTCF_VALID_OVFL) == 0 {
            n_ovfl: (n_payload - n_local + ovfl_size - 1) /% ovfl_size
            if bt.cursors[c].overflow.len() < n_ovfl {
                loop bt.cursors[c].overflow.len() < n_ovfl * 2 -> bt.cursors[c].overflow.push(0)
            }
            loop i in 0..<n_ovfl -> bt.cursors[c].overflow[i] = 0
            bt.cursors[c].cur_flags = bt.cursors[c].cur_flags.bit_or(BTCF_VALID_OVFL)
        } else {
            k: offset /% ovfl_size
            if ovfl_at(bt, c, k) != 0 {
                i_idx = k
                next_page = ovfl_at(bt, c, k)
                offset = offset % ovfl_size
            }
        }
        loop next_page != 0 {
            if next_page > bt.n_page -> return base.CORRUPT
            loop bt.cursors[c].overflow.len() <= i_idx + 1 -> bt.cursors[c].overflow.push(0)
            bt.cursors[c].overflow[i_idx] = next_page
            if offset >= ovfl_size {
                if ovfl_at(bt, c, i_idx + 1) != 0 {
                    next_page = ovfl_at(bt, c, i_idx + 1)
                } else {
                    cur_page: next_page
                    ignored := cache.NO_PAGE
                    rc = get_overflow_page(bt, cur_page, false, ignored, next_page)
                }
                offset -= ovfl_size
            } else {
                a := amt
                if a + offset > ovfl_size -> a = ovfl_size - offset
                if !write && offset == 0 && pos >= 4 && pager.pager_direct_read_ok(bt.pager, next_page) {
                    // The SQLITE_DIRECT_OVERFLOW_READ path: the page and the
                    // next page number straight from the file.
                    tmp := pager.zeros(a + 4)
                    at: bt.page_size * (next_page - 1)
                    rc = pager.pager_read_direct(bt.pager, tmp, a + 4, at)
                    next_page = bget4(tmp, 0)
                    pager.copy_into(buf, pos, tmp, 4, a)
                } else {
                    so := cache.NO_PAGE
                    flags: if write -> 0 else -> pager.PAGER_GET_READONLY
                    rc = pager.pager_get(bt.pager, next_page, so, flags)
                    if rc == base.OK {
                        next_page = pg4(bt, so, 0)
                        rc = copy_payload(bt, so, offset + 4, buf, pos, a, write)
                        pager.pager_unref(bt.pager, so)
                        offset = 0
                    }
                }
                amt -= a
                if amt == 0 -> return rc
                pos += a
            }
            if rc != base.OK -> break
            i_idx += 1
        }
    }
    if rc == base.OK && amt > 0 -> return base.CORRUPT
    rc
}

// sqlite3BtreePayload: amt bytes of the payload from offset into buf.
btree_payload: fn(bt: &Btree, c: Int, offset: Int, amt: Int, buf: &[U8]) -[DB]> Int Never! {
    access_payload(bt, c, offset, amt, buf, false)
}

// sqlite3BtreePayloadChecked (accessPayloadChecked).
btree_payload_checked: fn(bt: &Btree, c: Int, offset: Int, amt: Int, buf: &[U8]) -[DB]> Int Never! {
    if bt.cursors[c].state == CURSOR_VALID -> return access_payload(bt, c, offset, amt, buf, false)
    if bt.cursors[c].state == CURSOR_INVALID -> return base.ABORT
    rc: btree_restore_cursor_position(bt, c)
    if rc != base.OK -> return rc
    access_payload(bt, c, offset, amt, buf, false)
}

// sqlite3BtreePayloadFetch (fetchPayload): the offset of the local payload
// in the image of the cursor's page (bt.cursors[c].page); amt gets its
// size.
btree_payload_fetch: fn(bt: Btree, c: Int, amt: &Int) -> Int Never! {
    payload: bt.cursors[c].info.payload
    a := bt.cursors[c].info.n_local
    room: bt.page_size - payload
    if a > room -> a = if room > 0 -> room else -> 0
    amt = a
    payload
}

// moveToChild.
move_to_child: fn(bt: &Btree, c: Int, new_pgno: Int) -[DB]> Int Never! {
    ip: bt.cursors[c].i_page
    if ip >= BTCURSOR_MAX_DEPTH - 1 -> return base.CORRUPT
    bt.cursors[c].info.n_size = 0
    bt.cursors[c].cur_flags = util.clear_bits(bt.cursors[c].cur_flags, BTCF_VALID_NKEY.bit_or(BTCF_VALID_OVFL))
    bt.cursors[c].ai_idx[ip] = bt.cursors[c].ix
    bt.cursors[c].ap_page[ip] = bt.cursors[c].page
    bt.cursors[c].ix = 0
    bt.cursors[c].i_page = ip + 1
    s := cache.NO_PAGE
    flags: bt.cursors[c].cur_pager_flags
    rc := get_and_init_page(bt, new_pgno, s, flags)
    if rc == base.OK && (bt.mem[s].n_cell < 1 || bt.mem[s].int_key != bt.cursors[c].cur_int_key) {
        release_page(bt, s)
        rc = base.CORRUPT
    }
    if rc != base.OK {
        bt.cursors[c].i_page = ip
        bt.cursors[c].page = bt.cursors[c].ap_page[ip]
        return rc
    }
    bt.cursors[c].page = s
    base.OK
}

// moveToParent.
move_to_parent: fn(bt: &Btree, c: Int) Never! {
    ip: bt.cursors[c].i_page - 1
    bt.cursors[c].info.n_size = 0
    bt.cursors[c].cur_flags = util.clear_bits(bt.cursors[c].cur_flags, BTCF_VALID_NKEY.bit_or(BTCF_VALID_OVFL))
    bt.cursors[c].ix = bt.cursors[c].ai_idx[ip]
    leaf: bt.cursors[c].page
    bt.cursors[c].page = bt.cursors[c].ap_page[ip]
    bt.cursors[c].i_page = ip
    release_page_not_null(bt, leaf)
}

// The cursor is on a table (it has no KeyInfo).
cursor_is_table: fn(bt: Btree, c: Int) -> Bool Never! {
    if bt.cursors[c].key_info == .Val(_) -> return false
    true
}

// moveToRoot.
move_to_root: fn(bt: &Btree, c: Int) -[DB]> Int Never! {
    rc := base.OK
    skip_init := false
    if bt.cursors[c].i_page >= 0 {
        if bt.cursors[c].i_page > 0 {
            top: bt.cursors[c].page
            release_page_not_null(bt, top)
            ip := bt.cursors[c].i_page
            loop {
                ip -= 1
                bt.cursors[c].i_page = ip
                if ip == 0 -> break
                s: bt.cursors[c].ap_page[ip]
                release_page_not_null(bt, s)
            }
            bt.cursors[c].page = bt.cursors[c].ap_page[0]
            skip_init = true
        }
    } else if bt.cursors[c].pgno_root == 0 {
        bt.cursors[c].state = CURSOR_INVALID
        return base.EMPTY
    } else {
        if bt.cursors[c].state >= CURSOR_REQUIRESEEK {
            if bt.cursors[c].state == CURSOR_FAULT -> return bt.cursors[c].skip_next
            btree_clear_cursor(bt, c)
        }
        s := cache.NO_PAGE
        root: bt.cursors[c].pgno_root
        flags: bt.cursors[c].cur_pager_flags
        rc = get_and_init_page(bt, root, s, flags)
        if rc != base.OK {
            bt.cursors[c].state = CURSOR_INVALID
            return rc
        }
        bt.cursors[c].page = s
        bt.cursors[c].i_page = 0
        bt.cursors[c].cur_int_key = bt.mem[s].int_key
    }
    root: bt.cursors[c].page
    if !skip_init {
        if !bt.mem[root].is_init || cursor_is_table(bt, c) != bt.mem[root].int_key -> return base.CORRUPT
    }
    bt.cursors[c].ix = 0
    bt.cursors[c].info.n_size = 0
    bt.cursors[c].cur_flags = util.clear_bits(bt.cursors[c].cur_flags, BTCF_AT_LAST.bit_or(BTCF_VALID_NKEY).bit_or(BTCF_VALID_OVFL))
    if bt.mem[root].n_cell > 0 {
        bt.cursors[c].state = CURSOR_VALID
    } else if !bt.mem[root].leaf {
        if bt.mem[root].pgno != 1 -> return base.CORRUPT
        subpage: pg4(bt, root, bt.mem[root].hdr_offset + 8)
        bt.cursors[c].state = CURSOR_VALID
        rc = move_to_child(bt, c, subpage)
    } else {
        bt.cursors[c].state = CURSOR_INVALID
        rc = base.EMPTY
    }
    rc
}

// moveToLeftmost.
move_to_leftmost: fn(bt: &Btree, c: Int) -[DB]> Int Never! {
    rc := base.OK
    loop rc == base.OK && !bt.mem[bt.cursors[c].page].leaf {
        s: bt.cursors[c].page
        pgno: pg4(bt, s, find_cell(bt, s, bt.cursors[c].ix))
        rc = move_to_child(bt, c, pgno)
    }
    rc
}

// moveToRightmost.
move_to_rightmost: fn(bt: &Btree, c: Int) -[DB]> Int Never! {
    loop !bt.mem[bt.cursors[c].page].leaf {
        s: bt.cursors[c].page
        pgno: pg4(bt, s, bt.mem[s].hdr_offset + 8)
        bt.cursors[c].ix = bt.mem[s].n_cell
        rc: move_to_child(bt, c, pgno)
        if rc != base.OK -> return rc
    }
    s: bt.cursors[c].page
    bt.cursors[c].ix = bt.mem[s].n_cell - 1
    base.OK
}

// sqlite3BtreeFirst: res gets 1 for an empty table, else 0.
btree_first: fn(bt: &Btree, c: Int, res: &Int) -[DB]> Int Never! {
    rc := move_to_root(bt, c)
    if rc == base.OK {
        res = 0
        rc = move_to_leftmost(bt, c)
    } else if rc == base.EMPTY {
        res = 1
        rc = base.OK
    }
    rc
}

// btreeLast.
btree_last_inner: fn(bt: &Btree, c: Int, res: &Int) -[DB]> Int Never! {
    rc := move_to_root(bt, c)
    if rc == base.OK {
        res = 0
        rc = move_to_rightmost(bt, c)
        if rc == base.OK {
            bt.cursors[c].cur_flags = bt.cursors[c].cur_flags.bit_or(BTCF_AT_LAST)
        } else {
            bt.cursors[c].cur_flags = util.clear_bits(bt.cursors[c].cur_flags, BTCF_AT_LAST)
        }
    } else if rc == base.EMPTY {
        res = 1
        rc = base.OK
    }
    rc
}

// sqlite3BtreeLast.
btree_last: fn(bt: &Btree, c: Int, res: &Int) -[DB]> Int Never! {
    if bt.cursors[c].state == CURSOR_VALID && bt.cursors[c].cur_flags.bit_and(BTCF_AT_LAST) != 0 {
        res = 0
        return base.OK
    }
    btree_last_inner(bt, c, res)
}

// sqlite3BtreeTableMoveto: move to the row int_key, or next to where it
// would be; res gets <0, 0 or >0 as the row the cursor is on is smaller,
// equal or larger.
btree_table_moveto: fn(bt: &Btree, c: Int, int_key: Int, bias_right: Bool, res: &Int) -[DB]> Int Never! {
    if bt.cursors[c].state == CURSOR_VALID && bt.cursors[c].cur_flags.bit_and(BTCF_VALID_NKEY) != 0 {
        if bt.cursors[c].info.n_key == int_key {
            res = 0
            return base.OK
        }
        if bt.cursors[c].info.n_key < int_key {
            if bt.cursors[c].cur_flags.bit_and(BTCF_AT_LAST) != 0 {
                res = -1
                return base.OK
            }
            if bt.cursors[c].info.n_key + 1 == int_key {
                res = 0
                rc: btree_next(bt, c, 0)
                if rc == base.OK {
                    get_cell_info(bt, c)
                    if bt.cursors[c].info.n_key == int_key -> return base.OK
                } else if rc != base.DONE {
                    return rc
                }
            }
        }
    }
    rc := move_to_root(bt, c)
    if rc != base.OK {
        if rc == base.EMPTY {
            res = -1
            return base.OK
        }
        return rc
    }
    loop {
        s: bt.cursors[c].page
        lwr := 0
        upr := bt.mem[s].n_cell - 1
        idx := if bias_right -> upr else -> upr >> 1
        cmp := 0
        found_interior := false
        loop {
            cell := find_cell_past_ptr(bt, s, idx)
            if bt.mem[s].int_key_leaf {
                loop {
                    b: pb(bt, s, cell)
                    cell += 1
                    if b < 128 -> break
                    if cell >= bt.page_size -> return base.CORRUPT
                }
            }
            n_cell_key: bvarint(bt.pager.pcache.pages[s].data, cell).value
            if n_cell_key < int_key {
                lwr = idx + 1
                if lwr > upr {
                    cmp = -1
                    break
                }
            } else if n_cell_key > int_key {
                upr = idx - 1
                if lwr > upr {
                    cmp = 1
                    break
                }
            } else {
                bt.cursors[c].ix = idx.bit_and(65535)
                if !bt.mem[s].leaf {
                    lwr = idx
                    found_interior = true
                    break
                }
                bt.cursors[c].cur_flags = bt.cursors[c].cur_flags.bit_or(BTCF_VALID_NKEY)
                bt.cursors[c].info.n_key = n_cell_key
                bt.cursors[c].info.n_size = 0
                res = 0
                return base.OK
            }
            idx = (lwr + upr) >> 1
        }
        if !found_interior && bt.mem[s].leaf {
            bt.cursors[c].ix = idx.bit_and(65535)
            res = cmp
            rc = base.OK
            break
        }
        // moveto_table_next_layer.
        chld_pg: if lwr >= bt.mem[s].n_cell -> pg4(bt, s, bt.mem[s].hdr_offset + 8) else -> pg4(bt, s, find_cell(bt, s, lwr))
        bt.cursors[c].ix = lwr.bit_and(65535)
        rc = move_to_child(bt, c, chld_pg)
        if rc != base.OK -> break
    }
    bt.cursors[c].info.n_size = 0
    rc
}

// indexCellCompare's and sqlite3BtreeIndexMoveto's compare of a cell whose
// key is all on the page: 99 when it is not.
index_cell_compare_local: fn(bt: Btree, s: Int, cell: Int, kind: Int, idx: &record.UnpackedRecord) -> Int Never! {
    data: bt.pager.pcache.pages[s].data
    n_cell := bb(data, cell)
    if n_cell <= bt.mem[s].max1byte_payload -> return record.compare_by(kind, n_cell, data, cell + 1, idx)
    b1: bb(data, cell + 1)
    if b1.bit_and(128) == 0 {
        n_cell = (n_cell.bit_and(127) << 7) + b1
        if n_cell <= bt.mem[s].max_local -> return record.compare_by(kind, n_cell, data, cell + 2, idx)
    }
    99
}

// indexCellCompare.
index_cell_compare: fn(bt: Btree, c: Int, i: Int, kind: Int, idx: &record.UnpackedRecord) -> Int Never! {
    s: bt.cursors[c].page
    index_cell_compare_local(bt, s, find_cell_past_ptr(bt, s, i), kind, idx)
}

// cursorOnLastPage.
cursor_on_last_page: fn(bt: Btree, c: Int) -> Bool Never! {
    loop i in 0..<bt.cursors[c].i_page {
        s: bt.cursors[c].ap_page[i]
        if bt.cursors[c].ai_idx[i] < bt.mem[s].n_cell -> return false
    }
    true
}

// sqlite3BtreeIndexMoveto: move to the index entry idx, or next to where
// it would be; res as for btree_table_moveto.
btree_index_moveto: fn(bt: &Btree, c: Int, idx: &record.UnpackedRecord, res: &Int) -[DB]> Int Never! {
    kind: record.find_compare(idx)
    idx.err_code = 0
    bypass := false
    s0: bt.cursors[c].page
    if bt.cursors[c].state == CURSOR_VALID && bt.mem[s0].leaf && cursor_on_last_page(bt, c) {
        ix: bt.cursors[c].ix
        if ix == bt.mem[s0].n_cell - 1 {
            cmp: index_cell_compare(bt, c, ix, kind, idx)
            if cmp <= 0 && idx.err_code == base.OK {
                res = cmp
                return base.OK
            }
        }
        if !bypass && bt.cursors[c].i_page > 0 && index_cell_compare(bt, c, 0, kind, idx) <= 0 && idx.err_code == base.OK {
            bt.cursors[c].cur_flags = util.clear_bits(bt.cursors[c].cur_flags, BTCF_VALID_OVFL)
            if !bt.mem[s0].is_init -> return base.CORRUPT
            bypass = true
        }
        if !bypass -> idx.err_code = base.OK
    }
    rc := base.OK
    if !bypass {
        rc = move_to_root(bt, c)
        if rc != base.OK {
            if rc == base.EMPTY {
                res = -1
                return base.OK
            }
            return rc
        }
    }
    // bypass_moveto_root.
    loop {
        s: bt.cursors[c].page
        lwr := 0
        upr := bt.mem[s].n_cell - 1
        i := upr >> 1
        cmp := 0
        loop {
            cell: find_cell_past_ptr(bt, s, i)
            cmp = index_cell_compare_local(bt, s, cell, kind, idx)
            if cmp == 99 {
                body: cell - bt.mem[s].child_ptr_size
                info := cell_info_zero()
                parse_cell(bt.mem[s], bt.usable_size, bt.pager.pcache.pages[s].data, body, info)
                bt.cursors[c].info = info
                n_cell: info.n_key
                if n_cell < 2 || n_cell /% bt.usable_size > bt.n_page {
                    bt.cursors[c].info.n_size = 0
                    return base.CORRUPT
                }
                key := pager.zeros(n_cell + 18)
                bt.cursors[c].ix = i.bit_and(65535)
                rc = access_payload(bt, c, 0, n_cell, key, false)
                bt.cursors[c].cur_flags = util.clear_bits(bt.cursors[c].cur_flags, BTCF_VALID_OVFL)
                if rc != base.OK {
                    bt.cursors[c].info.n_size = 0
                    return rc
                }
                cmp = record.record_compare(n_cell, key, 0, idx)
            }
            if cmp < 0 {
                lwr = i + 1
            } else if cmp > 0 {
                upr = i - 1
            } else {
                res = 0
                rc = base.OK
                bt.cursors[c].ix = i.bit_and(65535)
                if idx.err_code != 0 -> rc = base.CORRUPT
                bt.cursors[c].info.n_size = 0
                return rc
            }
            if lwr > upr -> break
            i = (lwr + upr) >> 1
        }
        if bt.mem[s].leaf {
            bt.cursors[c].ix = i.bit_and(65535)
            res = cmp
            rc = base.OK
            break
        }
        chld_pg: if lwr >= bt.mem[s].n_cell -> pg4(bt, s, bt.mem[s].hdr_offset + 8) else -> pg4(bt, s, find_cell(bt, s, lwr))
        bt.cursors[c].info.n_size = 0
        bt.cursors[c].cur_flags = util.clear_bits(bt.cursors[c].cur_flags, BTCF_VALID_NKEY.bit_or(BTCF_VALID_OVFL))
        ip: bt.cursors[c].i_page
        if ip >= BTCURSOR_MAX_DEPTH - 1 -> return base.CORRUPT
        bt.cursors[c].ai_idx[ip] = lwr.bit_and(65535)
        bt.cursors[c].ap_page[ip] = s
        bt.cursors[c].ix = 0
        bt.cursors[c].i_page = ip + 1
        sc := cache.NO_PAGE
        flags: bt.cursors[c].cur_pager_flags
        rc = get_and_init_page(bt, chld_pg, sc, flags)
        if rc == base.OK && (bt.mem[sc].n_cell < 1 || bt.mem[sc].int_key != bt.cursors[c].cur_int_key) {
            release_page(bt, sc)
            rc = base.CORRUPT
        }
        if rc != base.OK {
            bt.cursors[c].i_page = ip
            bt.cursors[c].page = s
            break
        }
        bt.cursors[c].page = sc
    }
    // moveto_index_finish.
    bt.cursors[c].info.n_size = 0
    rc
}

// sqlite3BtreeEof.
btree_eof: fn(bt: Btree, c: Int) -> Bool Never! { bt.cursors[c].state != CURSOR_VALID }

// sqlite3BtreeRowCountEst.
btree_row_count_est: fn(bt: Btree, c: Int) -> Int Never! {
    if bt.cursors[c].state != CURSOR_VALID -> return -1
    s: bt.cursors[c].page
    if !bt.mem[s].leaf -> return -1
    n := bt.mem[s].n_cell
    loop i in 0..<bt.cursors[c].i_page {
        p: bt.cursors[c].ap_page[i]
        n *= bt.mem[p].n_cell
    }
    n
}

// btreeNext.
btree_next_slow: fn(bt: &Btree, c: Int) -[DB]> Int Never! {
    if bt.cursors[c].state != CURSOR_VALID {
        rc: restore_cursor_position(bt, c)
        if rc != base.OK -> return rc
        if bt.cursors[c].state == CURSOR_INVALID -> return base.DONE
        if bt.cursors[c].state == CURSOR_SKIPNEXT {
            bt.cursors[c].state = CURSOR_VALID
            if bt.cursors[c].skip_next > 0 -> return base.OK
        }
    }
    s := bt.cursors[c].page
    bt.cursors[c].ix += 1
    idx: bt.cursors[c].ix
    if !bt.mem[s].is_init -> return base.CORRUPT
    if idx >= bt.mem[s].n_cell {
        if !bt.mem[s].leaf {
            child: pg4(bt, s, bt.mem[s].hdr_offset + 8)
            rc: move_to_child(bt, c, child)
            if rc != base.OK -> return rc
            return move_to_leftmost(bt, c)
        }
        loop {
            if bt.cursors[c].i_page == 0 {
                bt.cursors[c].state = CURSOR_INVALID
                return base.DONE
            }
            move_to_parent(bt, c)
            s = bt.cursors[c].page
            if bt.cursors[c].ix < bt.mem[s].n_cell -> break
        }
        if bt.mem[s].int_key -> return btree_next(bt, c, 0)
        return base.OK
    }
    if bt.mem[s].leaf -> return base.OK
    move_to_leftmost(bt, c)
}

// sqlite3BtreeNext: SQLITE_DONE past the last entry.
btree_next: fn(bt: &Btree, c: Int, flags: Int) -[DB]> Int Never! {
    bt.cursors[c].info.n_size = 0
    bt.cursors[c].cur_flags = util.clear_bits(bt.cursors[c].cur_flags, BTCF_VALID_NKEY.bit_or(BTCF_VALID_OVFL))
    if bt.cursors[c].state != CURSOR_VALID -> return btree_next_slow(bt, c)
    s: bt.cursors[c].page
    bt.cursors[c].ix += 1
    if bt.cursors[c].ix >= bt.mem[s].n_cell {
        bt.cursors[c].ix -= 1
        return btree_next_slow(bt, c)
    }
    if bt.mem[s].leaf -> return base.OK
    move_to_leftmost(bt, c)
}

// btreePrevious.
btree_previous_slow: fn(bt: &Btree, c: Int) -[DB]> Int Never! {
    if bt.cursors[c].state != CURSOR_VALID {
        rc: restore_cursor_position(bt, c)
        if rc != base.OK -> return rc
        if bt.cursors[c].state == CURSOR_INVALID -> return base.DONE
        if bt.cursors[c].state == CURSOR_SKIPNEXT {
            bt.cursors[c].state = CURSOR_VALID
            if bt.cursors[c].skip_next < 0 -> return base.OK
        }
    }
    s: bt.cursors[c].page
    if !bt.mem[s].leaf {
        idx: bt.cursors[c].ix
        child: pg4(bt, s, find_cell(bt, s, idx))
        rc := move_to_child(bt, c, child)
        if rc != base.OK -> return rc
        return move_to_rightmost(bt, c)
    }
    loop bt.cursors[c].ix == 0 {
        if bt.cursors[c].i_page == 0 {
            bt.cursors[c].state = CURSOR_INVALID
            return base.DONE
        }
        move_to_parent(bt, c)
    }
    bt.cursors[c].ix -= 1
    p: bt.cursors[c].page
    if bt.mem[p].int_key && !bt.mem[p].leaf -> return btree_previous(bt, c, 0)
    base.OK
}

// sqlite3BtreePrevious: SQLITE_DONE before the first entry.
btree_previous: fn(bt: &Btree, c: Int, flags: Int) -[DB]> Int Never! {
    bt.cursors[c].cur_flags = util.clear_bits(bt.cursors[c].cur_flags, BTCF_AT_LAST.bit_or(BTCF_VALID_OVFL).bit_or(BTCF_VALID_NKEY))
    bt.cursors[c].info.n_size = 0
    if bt.cursors[c].state != CURSOR_VALID || bt.cursors[c].ix == 0 -> return btree_previous_slow(bt, c)
    s: bt.cursors[c].page
    if !bt.mem[s].leaf -> return btree_previous_slow(bt, c)
    bt.cursors[c].ix -= 1
    base.OK
}

// ---------------------------------------------------------------------------
// Allocating and freeing pages.

// sqlite3AbsInt32 of the u32 difference a - b taken as an int.
abs_diff32: fn(a: Int, b: Int) -> Int Never! {
    d := (a - b).bit_and(os.U32_MASK)
    if d >= 2147483648 -> d -= 4294967296
    if d >= 0 -> return d
    if d == -2147483648 -> return 2147483647
    0 - d
}

// allocateBtreePage's search of the freelist: the do-while loop. A return
// is its goto end_allocate_page; the caller releases trunk and prev_trunk.
allocate_from_freelist: fn(bt: &Btree, page: &Int, pgno: &Int, nearby: Int, e_mode: Int, n: Int, mx_page: Int, search_list_in: Bool, trunk: &Int, prev_trunk: &Int) -[DB]> Int Never! {
    s1: bt.page1
    search_list := search_list_in
    n_search := 0
    rc := base.OK
    loop {
        prev_trunk = trunk
        i_trunk := 0
        if prev_trunk != cache.NO_PAGE {
            i_trunk = pg4(bt, prev_trunk, 0)
        } else {
            i_trunk = pg4(bt, s1, 32)
        }
        tries: n_search
        n_search += 1
        if i_trunk > mx_page || tries > n {
            rc = base.CORRUPT
        } else {
            rc = btree_get_unused_page(bt, i_trunk, trunk, 0)
        }
        if rc != base.OK {
            trunk = cache.NO_PAGE
            return rc
        }
        t: trunk
        k: pg4(bt, t, 4)
        if k == 0 && !search_list {
            rc = pager.pager_write(bt.pager, t)
            if rc != base.OK -> return rc
            pgno = i_trunk
            copy_page_bytes(bt, s1, 32, t, 0, 4)
            page = t
            trunk = cache.NO_PAGE
        } else if k > bt.usable_size /% 4 - 2 {
            return base.CORRUPT
        } else if search_list && (nearby == i_trunk || (i_trunk < nearby && e_mode == BTALLOC_LE)) {
            pgno = i_trunk
            page = t
            search_list = false
            rc = pager.pager_write(bt.pager, t)
            if rc != base.OK -> return rc
            if k == 0 {
                if prev_trunk == cache.NO_PAGE {
                    copy_page_bytes(bt, s1, 32, t, 0, 4)
                } else {
                    pt: prev_trunk
                    rc = pager.pager_write(bt.pager, pt)
                    if rc != base.OK -> return rc
                    copy_page_bytes(bt, pt, 0, t, 0, 4)
                }
            } else {
                i_new_trunk: pg4(bt, t, 8)
                if i_new_trunk > mx_page -> return base.CORRUPT
                new_trunk := cache.NO_PAGE
                rc = btree_get_unused_page(bt, i_new_trunk, new_trunk, 0)
                if rc != base.OK -> return rc
                rc = pager.pager_write(bt.pager, new_trunk)
                if rc != base.OK {
                    release_page(bt, new_trunk)
                    return rc
                }
                copy_page_bytes(bt, new_trunk, 0, t, 0, 4)
                ps4(bt, new_trunk, 4, k - 1)
                copy_page_bytes(bt, new_trunk, 8, t, 12, (k - 1) * 4)
                release_page(bt, new_trunk)
                if prev_trunk == cache.NO_PAGE {
                    ps4(bt, s1, 32, i_new_trunk)
                } else {
                    pt: prev_trunk
                    rc = pager.pager_write(bt.pager, pt)
                    if rc != base.OK -> return rc
                    ps4(bt, pt, 0, i_new_trunk)
                }
            }
            trunk = cache.NO_PAGE
        } else if k > 0 {
            closest := 0
            if nearby > 0 {
                if e_mode == BTALLOC_LE {
                    loop i in 0..<k {
                        if pg4(bt, t, 8 + i * 4) <= nearby {
                            closest = i
                            break
                        }
                    }
                } else {
                    dist := abs_diff32(pg4(bt, t, 8), nearby)
                    loop i in 1..<k {
                        d2: abs_diff32(pg4(bt, t, 8 + i * 4), nearby)
                        if d2 < dist {
                            closest = i
                            dist = d2
                        }
                    }
                }
            }
            i_page: pg4(bt, t, 8 + closest * 4)
            if i_page > mx_page || i_page < 2 -> return base.CORRUPT
            if !search_list || (i_page == nearby || (i_page < nearby && e_mode == BTALLOC_LE)) {
                pgno = i_page
                rc = pager.pager_write(bt.pager, t)
                if rc != base.OK -> return rc
                if closest < k - 1 -> copy_page_bytes(bt, t, 8 + closest * 4, t, 4 + k * 4, 4)
                ps4(bt, t, 4, k - 1)
                no_content: if !btree_get_has_content(bt, i_page) -> pager.PAGER_GET_NOCONTENT else -> 0
                rc = btree_get_unused_page(bt, i_page, page, no_content)
                if rc == base.OK {
                    pg: page
                    rc = pager.pager_write(bt.pager, pg)
                    if rc != base.OK {
                        release_page(bt, pg)
                        page = cache.NO_PAGE
                    }
                }
                search_list = false
            }
        }
        release_page(bt, prev_trunk)
        prev_trunk = cache.NO_PAGE
        if !search_list -> break
    }
    rc
}

// allocateBtreePage: a new page, from the freelist or the end of the file.
// page gets its slot (written and with a reference) and pgno its number;
// e_mode is BTALLOC_ANY, BTALLOC_EXACT (only page nearby) or BTALLOC_LE.
allocate_btree_page: fn(bt: &Btree, page: &Int, pgno: &Int, nearby: Int, e_mode: Int) -[DB]> Int Never! {
    s1: bt.page1
    mx_page: btree_pagecount(bt)
    n: pg4(bt, s1, 36)
    if n >= mx_page -> return base.CORRUPT
    rc := base.OK
    if n > 0 {
        search_list := false
        if e_mode == BTALLOC_EXACT {
            if nearby <= mx_page {
                e_type := 0
                parent := 0
                rc = ptrmap_get(bt, nearby, e_type, parent)
                if rc != base.OK -> return rc
                if e_type == PTRMAP_FREEPAGE -> search_list = true
            }
        } else if e_mode == BTALLOC_LE {
            search_list = true
        }
        rc = pager.pager_write(bt.pager, s1)
        if rc != base.OK -> return rc
        ps4(bt, s1, 36, n - 1)
        trunk := cache.NO_PAGE
        prev_trunk := cache.NO_PAGE
        rc = allocate_from_freelist(bt, page, pgno, nearby, e_mode, n, mx_page, search_list, trunk, prev_trunk)
        // end_allocate_page.
        release_page(bt, trunk)
        release_page(bt, prev_trunk)
        return rc
    }
    b_no_content: if !bt.do_truncate -> pager.PAGER_GET_NOCONTENT else -> 0
    rc = pager.pager_write(bt.pager, s1)
    if rc != base.OK -> return rc
    bt.n_page += 1
    if bt.n_page == pending_byte_page(bt) -> bt.n_page += 1
    if bt.auto_vacuum && ptrmap_is_page(bt, bt.n_page) {
        pg := cache.NO_PAGE
        map_pgno: bt.n_page
        rc = btree_get_unused_page(bt, map_pgno, pg, b_no_content)
        if rc == base.OK {
            rc = pager.pager_write(bt.pager, pg)
            release_page(bt, pg)
        }
        if rc != base.OK -> return rc
        bt.n_page += 1
        if bt.n_page == pending_byte_page(bt) -> bt.n_page += 1
    }
    n_page: bt.n_page
    ps4(bt, s1, 28, n_page)
    pgno = n_page
    rc = btree_get_unused_page(bt, n_page, page, b_no_content)
    if rc != base.OK -> return rc
    pg: page
    rc = pager.pager_write(bt.pager, pg)
    if rc != base.OK {
        release_page(bt, pg)
        page = cache.NO_PAGE
    }
    rc
}

// freePage2 up to freepage_out; the caller releases page and trunk.
free_page2_body: fn(bt: &Btree, page: &Int, trunk: &Int, i_page: Int) -[DB]> Int Never! {
    s1: bt.page1
    rc := pager.pager_write(bt.pager, s1)
    if rc != base.OK -> return rc
    n_free: pg4(bt, s1, 36)
    ps4(bt, s1, 36, n_free + 1)
    if bt.bts_flags.bit_and(BTS_SECURE_DELETE) != 0 {
        if page == cache.NO_PAGE {
            rc = btree_get_page(bt, i_page, page, 0)
            if rc != base.OK -> return rc
        }
        pg: page
        rc = pager.pager_write(bt.pager, pg)
        if rc != base.OK -> return rc
        size: bt.page_size
        pzero(bt, pg, 0, size)
    }
    if bt.auto_vacuum {
        ptrmap_put(bt, i_page, PTRMAP_FREEPAGE, 0, rc)
        if rc != base.OK -> return rc
    }
    i_trunk := 0
    if n_free != 0 {
        i_trunk = pg4(bt, s1, 32)
        if i_trunk > btree_pagecount(bt) -> return base.CORRUPT
        rc = btree_get_page(bt, i_trunk, trunk, 0)
        if rc != base.OK -> return rc
        t: trunk
        n_leaf: pg4(bt, t, 4)
        if n_leaf > bt.usable_size /% 4 - 2 -> return base.CORRUPT
        if n_leaf < bt.usable_size /% 4 - 8 {
            rc = pager.pager_write(bt.pager, t)
            if rc == base.OK {
                ps4(bt, t, 4, n_leaf + 1)
                ps4(bt, t, 8 + n_leaf * 4, i_page)
                if page != cache.NO_PAGE && bt.bts_flags.bit_and(BTS_SECURE_DELETE) == 0 {
                    pg: page
                    pager.pager_dont_write(bt.pager, pg)
                }
                rc = btree_set_has_content(bt, i_page)
            }
            return rc
        }
    }
    if page == cache.NO_PAGE {
        rc = btree_get_page(bt, i_page, page, 0)
        if rc != base.OK -> return rc
    }
    pg: page
    rc = pager.pager_write(bt.pager, pg)
    if rc != base.OK -> return rc
    ps4(bt, pg, 0, i_trunk)
    ps4(bt, pg, 4, 0)
    ps4(bt, s1, 32, i_page)
    base.OK
}

// freePage2: put page i_page on the freelist. mem_page is its slot when
// the caller holds it, else NO_PAGE.
free_page2: fn(bt: &Btree, mem_page: Int, i_page: Int) -[DB]> Int Never! {
    if i_page < 2 || i_page > bt.n_page -> return base.CORRUPT
    page := cache.NO_PAGE
    if mem_page != cache.NO_PAGE {
        page = mem_page
        pager.pager_ref(bt.pager, mem_page)
    } else {
        page = btree_page_lookup(bt, i_page)
    }
    trunk := cache.NO_PAGE
    rc: free_page2_body(bt, page, trunk, i_page)
    // freepage_out.
    if page != cache.NO_PAGE -> bt.mem[page].is_init = false
    release_page(bt, page)
    release_page(bt, trunk)
    rc
}

// freePage.
free_page: fn(bt: &Btree, s: Int, rc: &Int) Never! -[DB]> {
    if rc == base.OK {
        pgno: bt.mem[s].pgno
        rc = free_page2(bt, s, pgno)
    }
}

// clearCellOverflow: free the overflow chain of the cell at `cell` of s.
clear_cell_overflow: fn(bt: &Btree, s: Int, cell: Int, info: CellInfo) -[DB]> Int Never! {
    if cell + info.n_size > bt.page_size -> return base.CORRUPT
    ovfl_pgno := pg4(bt, s, cell + info.n_size - 4)
    ovfl_page_size: bt.usable_size - 4
    n_ovfl := (info.n_payload - info.n_local + ovfl_page_size - 1).bit_and(os.U32_MASK) /% ovfl_page_size
    loop n_ovfl > 0 {
        n_ovfl -= 1
        i_next := 0
        ovfl := cache.NO_PAGE
        if ovfl_pgno < 2 || ovfl_pgno > btree_pagecount(bt) -> return base.CORRUPT
        if n_ovfl != 0 {
            rc: get_overflow_page(bt, ovfl_pgno, true, ovfl, i_next)
            if rc != base.OK -> return rc
        }
        if ovfl == cache.NO_PAGE -> ovfl = btree_page_lookup(bt, ovfl_pgno)
        rc := base.OK
        if ovfl != cache.NO_PAGE && pager.pager_page_refcount(bt.pager, ovfl) != 1 {
            rc = base.CORRUPT
        } else {
            rc = free_page2(bt, ovfl, ovfl_pgno)
        }
        if ovfl != cache.NO_PAGE -> pager.pager_unref(bt.pager, ovfl)
        if rc != base.OK -> return rc
        ovfl_pgno = i_next
    }
    base.OK
}

// BTREE_CLEAR_CELL: parse the cell at `cell` of s into info and free its
// overflow chain.
clear_cell: fn(bt: &Btree, s: Int, cell: Int, info: &CellInfo) -[DB]> Int Never! {
    parse_cell(bt.mem[s], bt.usable_size, bt.pager.pcache.pages[s].data, cell, info)
    if info.n_local != info.n_payload {
        return clear_cell_overflow(bt, s, cell, info.copy())
    }
    base.OK
}

// ---------------------------------------------------------------------------
// Cells in and out of pages.

// The content of a row or index entry to insert (BtreePayload): key and
// n_key for an index (n_key alone, the rowid, for a table), data, n_data
// and n_zero for a table, and mem, the unpacked index key when non-empty.
BtreePayload: struct {
    key: [U8]
    n_key: Int
    data: [U8]
    n_data: Int
    n_zero: Int
    mem: [base.Mem]
}

// memcpy(page s + at, src, n); bytes past the end of src read as zero.
put_bytes: fn(bt: &Btree, s: Int, at: Int, src: [U8], n: Int) Never! {
    loop i in 0..<n -> bt.pager.pcache.pages[s].data[at + i] = U8{bb(src, i)}
}

// memcpy from page `from` at src_at to page `to` at `at`.
copy_page_bytes: fn(bt: &Btree, to: Int, at: Int, from: Int, src_at: Int, n: Int) Never! {
    loop i in 0..<n {
        v: pb(bt, from, src_at + i)
        ps1(bt, to, at + i, v)
    }
}

// fillInCell's writes: into bt.tmp_space (slot -1, the new cell) or into
// an overflow page.
fill_bytes: fn(bt: &Btree, slot: Int, at: Int, src: [U8], from: Int, n: Int) Never! {
    if slot < 0 {
        loop i in 0..<n -> bt.tmp_space[at + i] = U8{bb(src, from + i)}
    } else {
        loop i in 0..<n -> bt.pager.pcache.pages[slot].data[at + i] = U8{bb(src, from + i)}
    }
}

fill_zero: fn(bt: &Btree, slot: Int, at: Int, n: Int) Never! {
    if slot < 0 {
        loop i in 0..<n -> bt.tmp_space[at + i] = U8{0}
    } else {
        pzero(bt, slot, at, n)
    }
}

// fillInCell: build the cell of x for page s in bt.tmp_space (the caller's
// newCell), spilling to new overflow pages; n_size gets its size.
fill_in_cell: fn(bt: &Btree, s: Int, x: BtreePayload, n_size: &Int) -[DB]> Int Never! {
    n_header := bt.mem[s].child_ptr_size
    head := [U8]{}
    n_payload := 0
    src := [U8]{}
    n_src := 0
    if bt.mem[s].int_key {
        n_payload = x.n_data + x.n_zero
        src = x.data
        n_src = x.n_data
        util.put_varint(head, n_payload)
        util.put_varint(head, x.n_key)
    } else {
        n_payload = x.n_key
        n_src = n_payload
        src = x.key
        util.put_varint(head, n_payload)
    }
    fill_bytes(bt, -1, n_header, head, 0, head.len())
    n_header += head.len()
    payload_slot := -1
    payload_at := n_header
    if n_payload <= bt.mem[s].max_local {
        n := n_header + n_payload
        if n < 4 -> n = 4
        n_size = n
        fill_bytes(bt, -1, payload_at, src, 0, n_src)
        fill_zero(bt, -1, payload_at + n_src, n_payload - n_src)
        return base.OK
    }
    mn: bt.mem[s].min_local
    n := mn + (n_payload - mn) % (bt.usable_size - 4)
    if n > bt.mem[s].max_local -> n = mn
    space_left := n
    n_size = n + n_header + 4
    prior_slot := -1
    prior_at := n_header + n
    to_release := cache.NO_PAGE
    pgno_ovfl := 0
    src_at := 0
    loop {
        n = n_payload
        if n > space_left -> n = space_left
        if n_src >= n {
            fill_bytes(bt, payload_slot, payload_at, src, src_at, n)
        } else if n_src > 0 {
            n = n_src
            fill_bytes(bt, payload_slot, payload_at, src, src_at, n)
        } else {
            fill_zero(bt, payload_slot, payload_at, n)
        }
        n_payload -= n
        if n_payload <= 0 -> break
        payload_at += n
        src_at += n
        n_src -= n
        space_left -= n
        if space_left == 0 {
            ovfl := cache.NO_PAGE
            pgno_ptrmap: pgno_ovfl
            if bt.auto_vacuum {
                loop {
                    pgno_ovfl += 1
                    if !(ptrmap_is_page(bt, pgno_ovfl) || pgno_ovfl == pending_byte_page(bt)) -> break
                }
            }
            nearby: pgno_ovfl
            rc := allocate_btree_page(bt, ovfl, pgno_ovfl, nearby, 0)
            if bt.auto_vacuum && rc == base.OK {
                e_type: if pgno_ptrmap != 0 -> PTRMAP_OVERFLOW2 else -> PTRMAP_OVERFLOW1
                ptrmap_put(bt, pgno_ovfl, e_type, pgno_ptrmap, rc)
                if rc != base.OK -> release_page(bt, ovfl)
            }
            if rc != base.OK {
                release_page(bt, to_release)
                return rc
            }
            if prior_slot < 0 {
                util.put4(bt.tmp_space, prior_at, pgno_ovfl)
            } else {
                ps4(bt, prior_slot, prior_at, pgno_ovfl)
            }
            release_page(bt, to_release)
            to_release = ovfl
            prior_slot = ovfl
            prior_at = 0
            ps4(bt, ovfl, 0, 0)
            payload_slot = ovfl
            payload_at = 4
            space_left = bt.usable_size - 4
        }
    }
    release_page(bt, to_release)
    base.OK
}

// dropCell: remove cell idx, sz bytes, from page s.
drop_cell: fn(bt: &Btree, s: Int, idx: Int, sz: Int, rc: &Int) Never! {
    if rc != base.OK -> return
    ptr: bt.mem[s].cell_offset + 2 * idx
    pc: pg2(bt, s, ptr)
    hdr: bt.mem[s].hdr_offset
    usable: bt.usable_size
    if pc + sz > usable {
        rc = base.CORRUPT
        return
    }
    r: free_space(bt, s, pc, sz)
    if r != base.OK {
        rc = r
        return
    }
    n: bt.mem[s].n_cell - 1
    bt.mem[s].n_cell = n
    if n == 0 {
        pzero(bt, s, hdr + 1, 4)
        ps1(bt, s, hdr + 7, 0)
        ps2(bt, s, hdr + 5, usable)
        bt.mem[s].n_free = usable - hdr - bt.mem[s].child_ptr_size - 8
    } else {
        mem_move(bt.pager.pcache.pages[s].data, ptr, ptr + 2, 2 * (n - idx))
        ps2(bt, s, hdr + 3, n)
        bt.mem[s].n_free += 2
    }
}

// Record overflow cell j of page s: the cell `cell` that would be cell i.
set_ovfl: fn(bt: &Btree, s: Int, j: Int, cell: [U8], i: Int) Never! {
    loop bt.mem[s].ap_ovfl.len() <= j {
        bt.mem[s].ap_ovfl.push([U8]{})
        bt.mem[s].ai_ovfl.push(0)
    }
    bt.mem[s].ap_ovfl[j] = cell
    bt.mem[s].ai_ovfl[j] = i.bit_and(65535)
}

// The bookkeeping insertCell and insertCellFast share once the cell's sz
// bytes are at idx: its pointer becomes cell i.
insert_cell_pointer: fn(bt: &Btree, s: Int, i: Int, idx: Int) Never! {
    ins: bt.mem[s].cell_offset + i * 2
    n: bt.mem[s].n_cell
    mem_move(bt.pager.pcache.pages[s].data, ins + 2, ins, 2 * (n - i))
    ps2(bt, s, ins, idx)
    bt.mem[s].n_cell = n + 1
    hdr: bt.mem[s].hdr_offset
    lo: (pb(bt, s, hdr + 4) + 1).bit_and(255)
    ps1(bt, s, hdr + 4, lo)
    if lo == 0 {
        hi: pb(bt, s, hdr + 3) + 1
        ps1(bt, s, hdr + 3, hi)
    }
}

// insertCell: make `cell` (sz bytes, whose first four become i_child) cell
// i of page s, or an overflow cell of s when it does not fit.
insert_cell: fn(bt: &Btree, s: Int, i: Int, cell: [U8], sz: Int, i_child: Int) -[DB]> Int Never! {
    if bt.mem[s].n_overflow != 0 || sz + 2 > bt.mem[s].n_free {
        c := slice_of(cell, 0, if sz < 4 -> 4 else -> sz)
        util.put4(c, 0, i_child.bit_and(os.U32_MASK))
        j: bt.mem[s].n_overflow
        bt.mem[s].n_overflow = j + 1
        set_ovfl(bt, s, j, c, i)
        return base.OK
    }
    rc := pager.pager_write(bt.pager, s)
    if rc != base.OK -> return rc
    idx := 0
    rc = allocate_space(bt, s, sz, idx)
    if rc != base.OK -> return rc
    bt.mem[s].n_free -= (2 + sz).bit_and(65535)
    loop k in 4..<sz -> bt.pager.pcache.pages[s].data[idx + k] = U8{bb(cell, k)}
    ps4(bt, s, idx, i_child)
    insert_cell_pointer(bt, s, i, idx)
    if bt.auto_vacuum {
        rc2 := base.OK
        ptrmap_put_ovfl_ptr(bt, s, cell, 0, -1, rc2)
        if rc2 != base.OK -> return rc2
    }
    base.OK
}

// insertCellFast: insertCell for a cell without a child pointer to set.
insert_cell_fast: fn(bt: &Btree, s: Int, i: Int, cell: [U8], sz: Int) -[DB]> Int Never! {
    if sz + 2 > bt.mem[s].n_free {
        j: bt.mem[s].n_overflow
        bt.mem[s].n_overflow = j + 1
        set_ovfl(bt, s, j, slice_of(cell, 0, sz), i)
        return base.OK
    }
    rc := pager.pager_write(bt.pager, s)
    if rc != base.OK -> return rc
    idx := 0
    rc = allocate_space(bt, s, sz, idx)
    if rc != base.OK -> return rc
    bt.mem[s].n_free -= (2 + sz).bit_and(65535)
    put_bytes(bt, s, idx, cell, sz)
    insert_cell_pointer(bt, s, i, idx)
    if bt.auto_vacuum {
        rc2 := base.OK
        ptrmap_put_ovfl_ptr(bt, s, cell, 0, -1, rc2)
        if rc2 != base.OK -> return rc2
    }
    base.OK
}

// ---------------------------------------------------------------------------
// Balancing.

// Pages on either side of the page being balanced, and the pages involved.
NN: 1
NB: 3

// editPage's goto editpage_fail.
EDIT_FAIL: -1

// The cells being balanced (CellArray). A cell is held as a copy of its
// bytes with where it lay (src, the slot, -1 for a buffer of its own such
// as a divider copy or an overflow cell; off, its offset there), which
// stands in for C's pointer comparisons: SQLITE_WITHIN and the checks
// against apEnd. C reads a page's cells in place; balance_nonroot orders
// its edits so that no cell is read after its page changed, so the copies
// read the same bytes. sz is szCell, 0 until computed; ap_end holds slots
// (-1 for none).
CellArray: struct {
    n_cell: Int
    ref: MemPage
    cells: [[U8]]
    src: [Int]
    off: [Int]
    sz: [Int]
    ap_end: [Int]
    ix_nx: [Int]
}

cell_array_new: fn(ref: MemPage) -> CellArray Never! {
    CellArray{n_cell: 0, ref: ref, cells: [[U8]]{}, src: [Int]{}, off: [Int]{}, sz: [Int]{}, ap_end: no_pages(NB * 2), ix_nx: zero_ints(NB * 2)}
}

cell_array_push: fn(b: &CellArray, cell: &&[U8], src: Int, off: Int, sz: Int) Never! {
    b.cells.push(cell)
    b.src.push(src)
    b.off.push(off)
    b.sz.push(sz)
    b.n_cell += 1
}

// populateCellCache.
populate_cell_cache: fn(b: &CellArray, idx: Int, n: Int, usable: Int) Never! {
    loop i in idx..<idx + n {
        if b.sz[i] == 0 {
            v: cell_size(b.ref, usable, b.cells[i], 0)
            b.sz[i] = v
        }
    }
}

// cachedCellSize.
cached_cell_size: fn(b: &CellArray, n: Int, usable: Int) -> Int Never! {
    if b.sz[n] != 0 -> return b.sz[n]
    v: cell_size(b.ref, usable, b.cells[n], 0)
    b.sz[n] = v
    v
}

// The first k with ix_nx[k] > i (at most NB*2).
cell_array_k: fn(b: CellArray, i: Int) -> Int Never! {
    k := 0
    loop k < NB * 2 && b.ix_nx[k] <= i -> k += 1
    k
}

// apEnd[k]: the slot whose page end it is, -1 past the array.
cell_array_end: fn(b: CellArray, k: Int) -> Int Never! {
    if k < NB * 2 -> b.ap_end[k] else -> -1
}

// A cell of sz bytes at off of slot src crosses the end of page end_slot.
straddles: fn(src: Int, off: Int, sz: Int, end_slot: Int, page_size: Int) -> Bool Never! {
    end_slot >= 0 && src == end_slot && off < page_size && off + sz > page_size
}

// rebuildPage: page s holds exactly cells i_first..<i_first + n_cell.
rebuild_page: fn(bt: &Btree, b: &CellArray, i_first: Int, n_cell: Int, s: Int) -> Int Never! {
    hdr: bt.mem[s].hdr_offset
    usable: bt.usable_size
    j := pg2(bt, s, hdr + 5)
    if j > usable -> j = 0
    i := i_first
    i_end: i + n_cell
    k := cell_array_k(b, i)
    src_end := cell_array_end(b, k)
    cellptr := bt.mem[s].cell_offset
    data := usable
    loop {
        sz: b.sz[i]
        if b.src[i] == s && b.off[i] >= j && b.off[i] < usable {
            if b.off[i] + sz > usable -> return base.CORRUPT
        } else if straddles(b.src[i], b.off[i], sz, src_end, bt.page_size) {
            return base.CORRUPT
        }
        data -= sz
        ps2(bt, s, cellptr, data)
        cellptr += 2
        if data < cellptr -> return base.CORRUPT
        put_bytes(bt, s, data, b.cells[i], sz)
        i += 1
        if i >= i_end -> break
        if b.ix_nx[k] <= i {
            k += 1
            src_end = cell_array_end(b, k)
        }
    }
    bt.mem[s].n_cell = n_cell
    bt.mem[s].n_overflow = 0
    ps2(bt, s, hdr + 1, 0)
    ps2(bt, s, hdr + 3, n_cell)
    ps2(bt, s, hdr + 5, data)
    ps1(bt, s, hdr + 7, 0)
    base.OK
}

// pageInsertArray: add cells i_first..<i_first + n_cell to page s, their
// pointers from cellptr on and their content below data (or in free
// slots); 1 when they do not fit.
page_insert_array: fn(bt: &Btree, s: Int, p_begin: Int, data: &Int, cellptr_in: Int, i_first: Int, n_cell: Int, b: CellArray) -> Int Never! {
    i := i_first
    i_end: i_first + n_cell
    if i_end <= i_first -> return 0
    k := cell_array_k(b, i)
    p_end := cell_array_end(b, k)
    cellptr := cellptr_in
    p_data := data
    loop {
        sz: b.sz[i]
        slot := 0
        if !(pb(bt, s, 1) == 0 && pb(bt, s, 2) == 0) {
            rc := base.OK
            slot = page_find_slot(bt, s, sz, rc)
        }
        if slot == 0 {
            if p_data - p_begin < sz -> return 1
            p_data -= sz
            slot = p_data
        }
        if straddles(b.src[i], b.off[i], sz, p_end, bt.page_size) -> return 1
        put_bytes(bt, s, slot, b.cells[i], sz)
        ps2(bt, s, cellptr, slot)
        cellptr += 2
        i += 1
        if i >= i_end -> break
        if b.ix_nx[k] <= i {
            k += 1
            p_end = cell_array_end(b, k)
        }
    }
    data = p_data
    0
}

// pageFreeArray: free the cells i_first..<i_first + n_cell that lie on
// page s; the count freed.
page_free_array: fn(bt: &Btree, s: Int, i_first: Int, n_cell: Int, b: CellArray) -> Int Never! {
    usable: bt.usable_size
    start: bt.mem[s].hdr_offset + 8 + bt.mem[s].child_ptr_size
    n_ret := 0
    n_free := 0
    a_ofst := zero_ints(10)
    a_after := zero_ints(10)
    loop i in i_first..<i_first + n_cell {
        if b.src[i] == s && b.off[i] >= start && b.off[i] < usable {
            sz: b.sz[i]
            i_ofst: b.off[i].bit_and(65535)
            i_after: i_ofst + sz
            j := 0
            loop j < n_free {
                if a_ofst[j] == i_after {
                    a_ofst[j] = i_ofst
                    break
                } else if a_after[j] == i_ofst {
                    a_after[j] = i_after
                    break
                }
                j += 1
            }
            if j >= n_free {
                if n_free >= 10 {
                    loop x in 0..<n_free -> _: free_space(bt, s, a_ofst[x], a_after[x] - a_ofst[x])
                    n_free = 0
                }
                a_ofst[n_free] = i_ofst
                a_after[n_free] = i_after
                if i_after > usable -> return 0
                n_free += 1
            }
            n_ret += 1
        }
    }
    loop x in 0..<n_free -> _: free_space(bt, s, a_ofst[x], a_after[x] - a_ofst[x])
    n_ret
}

// editPage up to editpage_fail, which EDIT_FAIL stands for.
edit_page_try: fn(bt: &Btree, s: Int, i_old: Int, i_new: Int, n_new: Int, b: &CellArray) -> Int Never! {
    hdr: bt.mem[s].hdr_offset
    cell_idx: bt.mem[s].cell_offset
    p_begin: cell_idx + n_new * 2
    n_cell := bt.mem[s].n_cell
    i_old_end: i_old + bt.mem[s].n_cell + bt.mem[s].n_overflow
    i_new_end: i_new + n_new
    if i_old < i_new {
        n_shift: page_free_array(bt, s, i_old, i_new - i_old, b)
        if n_shift > n_cell -> return base.CORRUPT
        mem_move(bt.pager.pcache.pages[s].data, cell_idx, cell_idx + n_shift * 2, n_cell * 2)
        n_cell -= n_shift
    }
    if i_new_end < i_old_end {
        n_tail: page_free_array(bt, s, i_new_end, i_old_end - i_new_end, b)
        n_cell -= n_tail
    }
    data := pg2(bt, s, hdr + 5)
    if data < p_begin -> return EDIT_FAIL
    if data > bt.page_size -> return EDIT_FAIL
    if i_new < i_old {
        n_add: if n_new < i_old - i_new -> n_new else -> i_old - i_new
        mem_move(bt.pager.pcache.pages[s].data, cell_idx + n_add * 2, cell_idx, n_cell * 2)
        if page_insert_array(bt, s, p_begin, data, cell_idx, i_new, n_add, b) != 0 -> return EDIT_FAIL
        n_cell += n_add
    }
    loop i in 0..<bt.mem[s].n_overflow {
        i_cell: (i_old + bt.mem[s].ai_ovfl[i]) - i_new
        if i_cell >= 0 && i_cell < n_new {
            cellptr: cell_idx + i_cell * 2
            if n_cell > i_cell -> mem_move(bt.pager.pcache.pages[s].data, cellptr + 2, cellptr, (n_cell - i_cell) * 2)
            n_cell += 1
            _: cached_cell_size(b, i_cell + i_new, bt.usable_size)
            if page_insert_array(bt, s, p_begin, data, cellptr, i_cell + i_new, 1, b) != 0 -> return EDIT_FAIL
        }
    }
    cellptr: cell_idx + n_cell * 2
    if page_insert_array(bt, s, p_begin, data, cellptr, i_new + n_cell, n_new - n_cell, b) != 0 -> return EDIT_FAIL
    bt.mem[s].n_cell = n_new
    bt.mem[s].n_overflow = 0
    ps2(bt, s, hdr + 3, n_new)
    ps2(bt, s, hdr + 5, data)
    base.OK
}

// editPage: page s, which holds cells i_old.., is to hold the n_new cells
// from i_new on.
edit_page: fn(bt: &Btree, s: Int, i_old: Int, i_new: Int, n_new: Int, b: &CellArray) -> Int Never! {
    rc: edit_page_try(bt, s, i_old, i_new, n_new, b)
    if rc != EDIT_FAIL -> return rc
    // editpage_fail.
    if n_new < 1 -> return base.CORRUPT
    populate_cell_cache(b, i_new, n_new, bt.usable_size)
    rebuild_page(bt, b, i_new, n_new, s)
}

// balance_quick: the page s, the rightmost child of parent, overflows by
// one cell at its end; that cell goes alone on a new right sibling.
balance_quick: fn(bt: &Btree, parent: Int, s: Int) -[DB]> Int Never! {
    if bt.mem[s].n_cell == 0 -> return base.CORRUPT
    new := cache.NO_PAGE
    pgno_new := 0
    rc := allocate_btree_page(bt, new, pgno_new, 0, 0)
    if rc != base.OK -> return rc
    b := cell_array_new(bt.mem[s])
    cell_array_push(b, bt.mem[s].ap_ovfl[0].copy(), -1, 0, 0)
    sz_cell: cell_size(bt.mem[s], bt.usable_size, b.cells[0], 0)
    b.sz[0] = sz_cell
    zero_page(bt, new, PTF_INTKEY.bit_or(PTF_LEAFDATA).bit_or(PTF_LEAF))
    b.ap_end[0] = s
    b.ix_nx[0] = 2
    rc = rebuild_page(bt, b, 0, 1, new)
    if rc != base.OK {
        release_page(bt, new)
        return rc
    }
    bt.mem[new].n_free = bt.usable_size - bt.mem[new].cell_offset - 2 - sz_cell
    if bt.auto_vacuum {
        parent_pgno: bt.mem[parent].pgno
        ptrmap_put(bt, pgno_new, PTRMAP_BTREE, parent_pgno, rc)
        if sz_cell > bt.mem[new].min_local -> ptrmap_put_ovfl_ptr(bt, new, b.cells[0], 0, -1, rc)
    }
    // The divider: a child pointer, then the rowid of the last cell of s.
    space := pager.zeros(4)
    at := find_cell(bt, s, bt.mem[s].n_cell - 1)
    stop := at + 9
    loop {
        v: pb(bt, s, at)
        at += 1
        if !(v.bit_and(128) != 0 && at < stop) -> break
    }
    stop = at + 9
    loop {
        v: pb(bt, s, at)
        space.push(U8{v})
        at += 1
        if !(v.bit_and(128) != 0 && at < stop) -> break
    }
    if rc == base.OK {
        n_parent: bt.mem[parent].n_cell
        child: bt.mem[s].pgno
        rc = insert_cell(bt, parent, n_parent, space, space.len(), child)
    }
    right: bt.mem[parent].hdr_offset + 8
    ps4(bt, parent, right, pgno_new)
    release_page(bt, new)
    rc
}

// copyNodeContent: page `to` gets the content of page `from`.
copy_node_content: fn(bt: &Btree, from: Int, to: Int, rc: &Int) Never! -[DB]> {
    if rc != base.OK -> return
    i_from_hdr: bt.mem[from].hdr_offset
    i_to_hdr: if bt.mem[to].pgno == 1 -> 100 else -> 0
    i_data: pg2(bt, from, i_from_hdr + 5)
    copy_page_bytes(bt, to, i_data, from, i_data, bt.usable_size - i_data)
    n_head: bt.mem[from].cell_offset + 2 * bt.mem[from].n_cell
    copy_page_bytes(bt, to, i_to_hdr, from, i_from_hdr, n_head)
    bt.mem[to].is_init = false
    r := btree_init_page(bt, to)
    if r == base.OK -> r = btree_compute_free_space(bt, to)
    if r != base.OK {
        rc = r
        return
    }
    if bt.auto_vacuum -> rc = set_child_ptrmaps(bt, to)
}

// A copy of n bytes of page s from `at`, as a cell of its own.
page_slice: fn(bt: Btree, s: Int, at: Int, n: Int) -> [U8] Never! {
    slice_of(bt.pager.pcache.pages[s].data, at, n)
}

// balance_nonroot up to balance_cleanup, which a return stands for; the
// caller releases ap_old[..<n_old] and ap_new[..<n_new].
balance_nonroot_body: fn(bt: &Btree, parent: Int, i_parent_idx: Int, is_root: Bool, b_bulk: Int, ap_old: &[Int], ap_new: &[Int], n_old_out: &Int, n_new_out: &Int) -[DB]> Int Never! {
    rc := base.OK
    usable: bt.usable_size
    page_size: bt.page_size
    n_max_cells := 0
    cnt_new := zero_ints(NB + 2)
    cnt_old := zero_ints(NB + 2)
    sz_new := zero_ints(NB + 2)
    a_pgno := zero_ints(NB + 2)
    ab_done := [Bool]{false, false, false, false, false}
    ap_div := [[U8]]{[U8]{}, [U8]{}}
    // Find the sibling pages to balance and the dividers between them.
    nx_div := 0
    i := bt.mem[parent].n_overflow + bt.mem[parent].n_cell
    if i < 2 {
        nx_div = 0
    } else {
        if i_parent_idx == 0 {
            nx_div = 0
        } else if i_parent_idx == i {
            nx_div = i - 2 + b_bulk
        } else {
            nx_div = i_parent_idx - 1
        }
        i = 2 - b_bulk
    }
    n_old: i + 1
    n_old_out = n_old
    p_right := 0
    if (i + nx_div - bt.mem[parent].n_overflow) == bt.mem[parent].n_cell {
        p_right = bt.mem[parent].hdr_offset + 8
    } else {
        p_right = find_cell(bt, parent, i + nx_div - bt.mem[parent].n_overflow)
    }
    pgno := pg4(bt, parent, p_right)
    loop {
        if rc == base.OK {
            got := cache.NO_PAGE
            rc = get_and_init_page(bt, pgno, got, 0)
            ap_old[i] = got
        }
        if rc != base.OK -> return rc
        o: ap_old[i]
        if bt.mem[o].n_free < 0 {
            rc = btree_compute_free_space(bt, o)
            if rc != base.OK -> return rc
        }
        n_max_cells += bt.mem[o].n_cell + 4
        if i == 0 -> break
        i -= 1
        if bt.mem[parent].n_overflow != 0 && i + nx_div == bt.mem[parent].ai_ovfl[0] {
            div: bt.mem[parent].ap_ovfl[0]
            pgno = bget4(div, 0)
            sz: cell_size(bt.mem[parent], usable, div, 0)
            sz_new[i] = sz
            ap_div[i] = slice_of(div, 0, sz)
            bt.mem[parent].n_overflow = 0
        } else {
            at: find_cell(bt, parent, i + nx_div - bt.mem[parent].n_overflow)
            pgno = pg4(bt, parent, at)
            sz: cell_size(bt.mem[parent], usable, bt.pager.pcache.pages[parent].data, at)
            sz_new[i] = sz
            // The bytes the divider copy reads: with secure delete, a
            // copy taken before dropCell zeroes them (C's aOvflSpace);
            // without it dropCell rewrites only the first four bytes,
            // which the divider copy below never uses.
            ap_div[i] = page_slice(bt, parent, at, sz)
            drop_cell(bt, parent, i + nx_div - bt.mem[parent].n_overflow, sz, rc)
        }
    }
    // Load the cells of the old pages, and the dividers, into b.
    b := cell_array_new(bt.mem[ap_old[0]])
    leaf_correction: if b.ref.leaf -> 4 else -> 0
    leaf_data: b.ref.int_key_leaf
    nld: if leaf_data -> 0 else -> 1
    flags0: pb(bt, ap_old[0], 0)
    loop io in 0..<n_old {
        o: ap_old[io]
        if pb(bt, o, 0) != flags0 -> return base.CORRUPT
        limit := bt.mem[o].n_cell
        piece := bt.mem[o].cell_offset
        if bt.mem[o].n_overflow > 0 {
            if limit < bt.mem[o].ai_ovfl[0] -> return base.CORRUPT
            limit = bt.mem[o].ai_ovfl[0]
            loop _ in 0..<limit {
                at: bt.mem[o].mask_page.bit_and(pg2(bt, o, piece))
                n: cell_size(b.ref, usable, bt.pager.pcache.pages[o].data, at)
                cell_array_push(b, page_slice(bt, o, at, n), o, at, 0)
                piece += 2
            }
            loop k in 0..<bt.mem[o].n_overflow -> cell_array_push(b, bt.mem[o].ap_ovfl[k].copy(), -1, 0, 0)
        }
        pi_end: bt.mem[o].cell_offset + 2 * bt.mem[o].n_cell
        loop piece < pi_end {
            at: bt.mem[o].mask_page.bit_and(pg2(bt, o, piece))
            n: cell_size(b.ref, usable, bt.pager.pcache.pages[o].data, at)
            cell_array_push(b, page_slice(bt, o, at, n), o, at, 0)
            piece += 2
        }
        cnt_old[io] = b.n_cell
        if io < n_old - 1 && !leaf_data {
            sz: sz_new[io].bit_and(65535)
            div: ap_div[io]
            if !bt.mem[o].leaf {
                cell := page_slice(bt, o, 8, 4)
                loop x in 4..<sz -> cell.push(U8{bb(div, x)})
                cell_array_push(b, cell, -1, 0, sz - leaf_correction)
            } else {
                cell := slice_of(div, leaf_correction, sz - leaf_correction)
                n := sz - leaf_correction
                loop n < 4 {
                    cell.push(U8{0})
                    n += 1
                }
                cell_array_push(b, cell, -1, 0, n)
            }
        }
    }
    // Work out how the cells divide among the new pages.
    usable_space: usable - 12 + leaf_correction
    k := 0
    loop io in 0..<n_old {
        p: ap_old[io]
        b.ap_end[k] = p
        b.ix_nx[k] = cnt_old[io]
        if k > 0 && b.ix_nx[k] == b.ix_nx[k - 1] -> k -= 1
        if !leaf_data {
            k += 1
            b.ap_end[k] = parent
            b.ix_nx[k] = cnt_old[io] + 1
        }
        sz_new[io] = usable_space - bt.mem[p].n_free
        loop j in 0..<bt.mem[p].n_overflow {
            sz_new[io] = sz_new[io] + 2 + cell_size(bt.mem[p], usable, bt.mem[p].ap_ovfl[j], 0)
        }
        cnt_new[io] = cnt_old[io]
        k += 1
    }
    k = n_old
    i = 0
    loop i < k {
        loop sz_new[i] > usable_space {
            if i + 1 >= k {
                k = i + 2
                if k > NB + 2 -> return base.CORRUPT
                sz_new[k - 1] = 0
                cnt_new[k - 1] = b.n_cell
            }
            if cnt_new[i] < 1 -> return base.CORRUPT
            sz := 2 + cached_cell_size(b, cnt_new[i] - 1, usable)
            sz_new[i] = sz_new[i] - sz
            if !leaf_data {
                if cnt_new[i] < b.n_cell {
                    sz = 2 + cached_cell_size(b, cnt_new[i], usable)
                } else {
                    sz = 0
                }
            }
            sz_new[i + 1] = sz_new[i + 1] + sz
            cnt_new[i] = cnt_new[i] - 1
        }
        loop cnt_new[i] < b.n_cell {
            sz := 2 + cached_cell_size(b, cnt_new[i], usable)
            if sz_new[i] + sz > usable_space -> break
            sz_new[i] = sz_new[i] + sz
            cnt_new[i] = cnt_new[i] + 1
            if !leaf_data {
                if cnt_new[i] < b.n_cell {
                    sz = 2 + cached_cell_size(b, cnt_new[i], usable)
                } else {
                    sz = 0
                }
            }
            sz_new[i + 1] = sz_new[i + 1] - sz
        }
        if cnt_new[i] >= b.n_cell {
            k = i + 1
        } else if cnt_new[i] <= (if i > 0 -> cnt_new[i - 1] else -> 0) {
            return base.CORRUPT
        }
        i += 1
    }
    // Even out the right-hand pages.
    i = k - 1
    loop i > 0 {
        sz_right := sz_new[i]
        sz_left := sz_new[i - 1]
        r := cnt_new[i - 1] - 1
        d := r + 1 - (if leaf_data -> 1 else -> 0)
        if r < 0 || d < 0 -> return base.CORRUPT
        _: cached_cell_size(b, d, usable)
        loop {
            sz_r: cached_cell_size(b, r, usable)
            sz_d: b.sz[d]
            if sz_right != 0 && (b_bulk != 0 || sz_right + sz_d + 2 > sz_left - (sz_r + (if i == k - 1 -> 0 else -> 2))) -> break
            sz_right += sz_d + 2
            sz_left -= sz_r + 2
            cnt_new[i - 1] = r
            r -= 1
            d -= 1
            if r < 0 -> break
        }
        sz_new[i] = sz_right
        sz_new[i - 1] = sz_left
        if cnt_new[i - 1] <= (if i > 1 -> cnt_new[i - 2] else -> 0) -> return base.CORRUPT
        i -= 1
    }
    // Get the new pages: the old ones first, then newly allocated.
    page_flags: pb(bt, ap_old[0], 0)
    n_new := 0
    loop io in 0..<k {
        if io < n_old {
            pn: ap_old[io]
            ap_new[io] = pn
            ap_old[io] = cache.NO_PAGE
            rc = pager.pager_write(bt.pager, pn)
            n_new += 1
            n_new_out = n_new
            want: 1 + (if io == i_parent_idx - nx_div -> 1 else -> 0)
            if pager.pager_page_refcount(bt.pager, pn) != want && rc == base.OK -> rc = base.CORRUPT
            if rc != base.OK -> return rc
        } else {
            pn := cache.NO_PAGE
            nearby: if b_bulk != 0 -> 1 else -> pgno
            rc = allocate_btree_page(bt, pn, pgno, nearby, 0)
            if rc != base.OK -> return rc
            zero_page(bt, pn, page_flags)
            ap_new[io] = pn
            n_new += 1
            n_new_out = n_new
            cnt_old[io] = b.n_cell
            if bt.auto_vacuum {
                new_pgno: bt.mem[pn].pgno
                parent_pgno: bt.mem[parent].pgno
                ptrmap_put(bt, new_pgno, PTRMAP_BTREE, parent_pgno, rc)
                if rc != base.OK -> return rc
            }
        }
    }
    // Sort the new pages by page number.
    loop io in 0..<n_new -> a_pgno[io] = bt.mem[ap_new[io]].pgno
    loop io in 0..<n_new - 1 {
        i_b := io
        loop j in io + 1..<n_new {
            if bt.mem[ap_new[j]].pgno < bt.mem[ap_new[i_b]].pgno -> i_b = j
        }
        if i_b != io {
            sa: ap_new[io]
            sb: ap_new[i_b]
            pgno_a: bt.mem[sa].pgno
            pgno_b: bt.mem[sb].pgno
            pgno_temp: os.PENDING_BYTE /% page_size + 1
            fg_a: bt.pager.pcache.pages[sa].flags
            fg_b: bt.pager.pcache.pages[sb].flags
            pager.pager_rekey(bt.pager, sa, pgno_temp, fg_b)
            pager.pager_rekey(bt.pager, sb, pgno_a, fg_a)
            pager.pager_rekey(bt.pager, sa, pgno_b, fg_b)
            bt.mem[sa].pgno = pgno_b
            bt.mem[sb].pgno = pgno_a
        }
    }
    last_pgno: bt.mem[ap_new[n_new - 1]].pgno
    ps4(bt, parent, p_right, last_pgno)
    if page_flags.bit_and(PTF_LEAF) == 0 && n_old != n_new {
        o: if n_new > n_old -> ap_new[n_old - 1] else -> ap_old[n_old - 1]
        copy_page_bytes(bt, ap_new[n_new - 1], 8, o, 8, 4)
    }
    // The pointer-map entries of cells that move to another page.
    if bt.auto_vacuum {
        p_old := ap_new[0]
        p_new := p_old
        cnt_old_next := bt.mem[p_new].n_cell + bt.mem[p_new].n_overflow
        i_new := 0
        i_old := 0
        loop ic in 0..<b.n_cell {
            loop ic == cnt_old_next {
                i_old += 1
                if i_old >= NB + 2 -> return base.CORRUPT
                p_old = if i_old < n_new -> ap_new[i_old] else -> ap_old[i_old]
                cnt_old_next += bt.mem[p_old].n_cell + bt.mem[p_old].n_overflow + nld
            }
            if ic == cnt_new[i_new] {
                i_new += 1
                p_new = ap_new[i_new]
                if !leaf_data -> next
            }
            within: b.src[ic] == p_old && b.off[ic] < page_size
            if i_old >= n_new || bt.mem[p_new].pgno != a_pgno[i_old] || !within {
                new_pgno: bt.mem[p_new].pgno
                if leaf_correction == 0 -> ptrmap_put(bt, bget4(b.cells[ic], 0), PTRMAP_BTREE, new_pgno, rc)
                if cached_cell_size(b, ic, usable) > bt.mem[p_new].min_local {
                    limit: if b.src[ic] == p_old -> page_size - b.off[ic] else -> -1
                    ptrmap_put_ovfl_ptr(bt, p_new, b.cells[ic], 0, limit, rc)
                }
                if rc != base.OK -> return rc
            }
        }
    }
    // Insert the new dividers into the parent.
    loop io in 0..<n_new - 1 {
        pn: ap_new[io]
        j := cnt_new[io]
        sz := b.sz[j] + leaf_correction
        div := [U8]{}
        div_src := -1
        div_off := 0
        if !bt.mem[pn].leaf {
            put_bytes(bt, pn, 8, b.cells[j], 4)
            div = b.cells[j]
            div_src = b.src[j]
            div_off = b.off[j]
        } else if leaf_data {
            j -= 1
            info := cell_info_zero()
            parse_cell(bt.mem[pn], usable, b.cells[j], 0, info)
            div = pager.zeros(4)
            util.put_varint(div, info.n_key)
            sz = div.len()
        } else {
            div = pager.zeros(4)
            loop x in 0..<b.cells[j].len() -> div.push(b.cells[j][x])
            div_src = b.src[j]
            div_off = b.off[j] - 4
            if b.sz[j] == 4 -> sz = cell_size(bt.mem[parent], usable, div, 0)
        }
        ke: cell_array_k(b, j)
        if straddles(div_src, div_off, sz, cell_array_end(b, ke), page_size) -> return base.CORRUPT
        child: bt.mem[pn].pgno
        rc = insert_cell(bt, parent, nx_div + io, div, sz, child)
        if rc != base.OK -> return rc
    }
    // Put the cells on the new pages, in an order that reads every cell
    // before its page is overwritten.
    loop t in 0..<2 * n_new - 1 {
        ii: t + 1 - n_new
        i_pg: if ii < 0 -> 0 - ii else -> ii
        if ab_done[i_pg] -> next
        if ii >= 0 || cnt_old[i_pg - 1] >= cnt_new[i_pg - 1] {
            i_new := 0
            i_old := 0
            n_new_cell := 0
            if i_pg == 0 {
                n_new_cell = cnt_new[0]
            } else {
                i_old = if i_pg < n_old -> cnt_old[i_pg - 1] + nld else -> b.n_cell
                i_new = cnt_new[i_pg - 1] + nld
                n_new_cell = cnt_new[i_pg] - i_new
            }
            rc = edit_page(bt, ap_new[i_pg], i_old, i_new, n_new_cell, b)
            if rc != base.OK -> return rc
            ab_done[i_pg] = true
            bt.mem[ap_new[i_pg]].n_free = usable_space - sz_new[i_pg]
        }
    }
    if is_root && bt.mem[parent].n_cell == 0 && bt.mem[parent].hdr_offset <= bt.mem[ap_new[0]].n_free {
        // The root is empty: its only child moves up into it.
        rc = defragment_page(bt, ap_new[0], -1)
        copy_node_content(bt, ap_new[0], parent, rc)
        free_page(bt, ap_new[0], rc)
    } else if bt.auto_vacuum && leaf_correction == 0 {
        loop io in 0..<n_new {
            key: pg4(bt, ap_new[io], 8)
            new_pgno: bt.mem[ap_new[io]].pgno
            ptrmap_put(bt, key, PTRMAP_BTREE, new_pgno, rc)
        }
    }
    loop io in n_new..<n_old -> free_page(bt, ap_old[io], rc)
    rc
}

// balance_nonroot: redistribute the cells of the child i_parent_idx of
// parent and its siblings (up to NB pages) over as many pages as they need.
balance_nonroot: fn(bt: &Btree, parent: Int, i_parent_idx: Int, is_root: Bool, b_bulk: Int) -[DB]> Int Never! {
    ap_old := no_pages(NB)
    ap_new := no_pages(NB + 2)
    n_old := 0
    n_new := 0
    rc: balance_nonroot_body(bt, parent, i_parent_idx, is_root, b_bulk, ap_old, ap_new, n_old, n_new)
    // balance_cleanup.
    loop i in 0..<n_old -> release_page(bt, ap_old[i])
    loop i in 0..<n_new -> release_page(bt, ap_new[i])
    rc
}

// balance_deeper: move the content of the overfull root into a new child,
// which child gets, leaving the root an interior page over it.
balance_deeper: fn(bt: &Btree, root: Int, child: &Int) -[DB]> Int Never! {
    ch := cache.NO_PAGE
    pgno_child := 0
    rc := pager.pager_write(bt.pager, root)
    if rc == base.OK {
        root_pgno: bt.mem[root].pgno
        rc = allocate_btree_page(bt, ch, pgno_child, root_pgno, 0)
        copy_node_content(bt, root, ch, rc)
        if bt.auto_vacuum -> ptrmap_put(bt, pgno_child, PTRMAP_BTREE, root_pgno, rc)
    }
    if rc != base.OK {
        child = cache.NO_PAGE
        release_page(bt, ch)
        return rc
    }
    n: bt.mem[root].n_overflow
    loop k in 0..<n {
        cell: bt.mem[root].ap_ovfl[k]
        at: bt.mem[root].ai_ovfl[k]
        set_ovfl(bt, ch, k, cell, at)
    }
    bt.mem[ch].n_overflow = n
    flags: util.clear_bits(pb(bt, ch, 0), PTF_LEAF)
    zero_page(bt, root, flags)
    right: bt.mem[root].hdr_offset + 8
    ps4(bt, root, right, pgno_child)
    child = ch
    base.OK
}

// anotherValidCursor.
another_valid_cursor: fn(bt: Btree, c: Int) -> Int Never! {
    loop o in bt.cursor_list {
        if o != c && bt.cursors[o].state == CURSOR_VALID && bt.cursors[o].page == bt.cursors[c].page -> return base.CORRUPT
    }
    base.OK
}

// balance: rebalance the pages on the cursor's path after an insert or a
// delete left its page overfull or underfull.
balance: fn(bt: &Btree, c: Int) -[DB]> Int Never! {
    rc := base.OK
    loop {
        s: bt.cursors[c].page
        if bt.mem[s].n_free < 0 && btree_compute_free_space(bt, s) != base.OK -> break
        if bt.mem[s].n_overflow == 0 && bt.mem[s].n_free * 3 <= bt.usable_size * 2 -> break
        i_page: bt.cursors[c].i_page
        if i_page == 0 {
            if bt.mem[s].n_overflow == 0 -> break
            rc = another_valid_cursor(bt, c)
            if rc != base.OK -> break
            child := cache.NO_PAGE
            rc = balance_deeper(bt, s, child)
            bt.cursors[c].ap_page[1] = child
            if rc == base.OK {
                bt.cursors[c].i_page = 1
                bt.cursors[c].ix = 0
                bt.cursors[c].ai_idx[0] = 0
                bt.cursors[c].ap_page[0] = s
                bt.cursors[c].page = child
            }
        } else if pager.pager_page_refcount(bt.pager, s) > 1 {
            rc = base.CORRUPT
        } else {
            parent: bt.cursors[c].ap_page[i_page - 1]
            i_idx: bt.cursors[c].ai_idx[i_page - 1]
            rc = pager.pager_write(bt.pager, parent)
            if rc == base.OK && bt.mem[parent].n_free < 0 -> rc = btree_compute_free_space(bt, parent)
            if rc == base.OK {
                if bt.mem[s].int_key_leaf && bt.mem[s].n_overflow == 1 && bt.mem[s].ai_ovfl[0] == bt.mem[s].n_cell && bt.mem[parent].pgno != 1 && bt.mem[parent].n_cell == i_idx {
                    rc = balance_quick(bt, parent, s)
                } else {
                    bulk: bt.cursors[c].hints.bit_and(BTREE_BULKLOAD)
                    rc = balance_nonroot(bt, parent, i_idx, i_page == 1, bulk)
                }
            }
            bt.mem[s].n_overflow = 0
            release_page(bt, s)
            bt.cursors[c].i_page = i_page - 1
            bt.cursors[c].page = bt.cursors[c].ap_page[i_page - 1]
        }
        if rc != base.OK -> break
    }
    rc
}

// ---------------------------------------------------------------------------
// Inserting and deleting.

// btreeOverwriteContent: write i_amt bytes of x's data from i_offset (zero
// past its end) at dest_at of page s, making the page writable only when a
// byte changes.
btree_overwrite_content: fn(bt: &Btree, s: Int, dest_at: Int, x: BtreePayload, i_offset: Int, i_amt_in: Int) -[DB]> Int Never! {
    i_amt := i_amt_in
    n_data: x.n_data - i_offset
    if n_data <= 0 {
        i := 0
        loop i < i_amt && pb(bt, s, dest_at + i) == 0 -> i += 1
        if i < i_amt {
            rc: pager.pager_write(bt.pager, s)
            if rc != base.OK -> return rc
            pzero(bt, s, dest_at + i, i_amt - i)
        }
        return base.OK
    }
    if n_data < i_amt {
        rc: btree_overwrite_content(bt, s, dest_at + n_data, x, i_offset + n_data, i_amt - n_data)
        if rc != base.OK -> return rc
        i_amt = n_data
    }
    differs := false
    loop i in 0..<i_amt {
        if pb(bt, s, dest_at + i) != bb(x.data, i_offset + i) {
            differs = true
            break
        }
    }
    if differs {
        rc: pager.pager_write(bt.pager, s)
        if rc != base.OK -> return rc
        loop i in 0..<i_amt -> ps1(bt, s, dest_at + i, bb(x.data, i_offset + i))
    }
    base.OK
}

// btreeOverwriteOverflowCell: overwrite the cursor's cell, whose payload
// spills to overflow pages, with x.
btree_overwrite_overflow_cell: fn(bt: &Btree, c: Int, x: BtreePayload) -[DB]> Int Never! {
    n_total: x.n_data + x.n_zero
    s: bt.cursors[c].page
    payload: bt.cursors[c].info.payload
    n_local: bt.cursors[c].info.n_local
    rc := btree_overwrite_content(bt, s, payload, x, 0, n_local)
    if rc != base.OK -> return rc
    i_offset := n_local
    ovfl_pgno := pg4(bt, s, payload + i_offset)
    ovfl_page_size := bt.usable_size - 4
    loop {
        o := cache.NO_PAGE
        rc = btree_get_page(bt, ovfl_pgno, o, 0)
        if rc != base.OK -> return rc
        if pager.pager_page_refcount(bt.pager, o) != 1 || bt.mem[o].is_init {
            rc = base.CORRUPT
        } else {
            if i_offset + ovfl_page_size < n_total {
                ovfl_pgno = pg4(bt, o, 0)
            } else {
                ovfl_page_size = n_total - i_offset
            }
            rc = btree_overwrite_content(bt, o, 4, x, i_offset, ovfl_page_size)
        }
        pager.pager_unref(bt.pager, o)
        if rc != base.OK -> return rc
        i_offset += ovfl_page_size
        if i_offset >= n_total -> break
    }
    base.OK
}

// btreeOverwriteCell: overwrite the cursor's cell in place with x, which
// has the same size.
btree_overwrite_cell: fn(bt: &Btree, c: Int, x: BtreePayload) -[DB]> Int Never! {
    n_total: x.n_data + x.n_zero
    s: bt.cursors[c].page
    payload: bt.cursors[c].info.payload
    n_local: bt.cursors[c].info.n_local
    if payload + n_local > bt.page_size || payload < bt.mem[s].cell_offset -> return base.CORRUPT
    if n_local == n_total -> return btree_overwrite_content(bt, s, payload, x, 0, n_local)
    btree_overwrite_overflow_cell(bt, c, x)
}

// sqlite3BtreeInsert: insert x into the cursor's table or index, or
// overwrite the entry with its key. seek_result is the result of a prior
// seek to x's key (0 when the cursor is not known to be there); flags are
// BTREE_SAVEPOSITION, BTREE_APPEND and BTREE_PREFORMAT (the cell is already
// in bt.tmp_space, n_preformat_size bytes, from btree_transfer_row).
btree_insert: fn(bt: &Btree, c: Int, x: BtreePayload, flags: Int, seek_result: Int) -[DB]> Int Never! {
    loc := seek_result
    sz_new := 0
    root: bt.cursors[c].pgno_root
    if bt.cursors[c].cur_flags.bit_and(BTCF_MULTIPLE) != 0 {
        rc: save_all_cursors(bt, root, c)
        if rc != base.OK -> return rc
        if loc != 0 && bt.cursors[c].i_page < 0 -> return base.CORRUPT
    }
    if bt.cursors[c].state >= CURSOR_REQUIRESEEK {
        rc: move_to_root(bt, c)
        if rc != base.OK && rc != base.EMPTY -> return rc
    }
    append: flags.bit_and(BTREE_APPEND) != 0
    // The cursor's KeyInfo, copied out so the moves below can change bt.
    cursor_key: bt.cursors[c].key_info.copy()
    if cursor_key == .Val(info) {
        if loc == 0 && flags.bit_and(BTREE_SAVEPOSITION) == 0 {
            rc := base.OK
            if x.mem.len() > 0 {
                r := record.UnpackedRecord{key_info: info, mem: x.mem, u_i: 0, u_z: [U8]{}, n_field: x.mem.len(), default_rc: 0, err_code: 0, r1: 0, r2: 0, eq_seen: false}
                rc = btree_index_moveto(bt, c, r, loc)
            } else {
                rc = btree_moveto(bt, c, Val(x.key), x.n_key, append, loc)
            }
            if rc != base.OK -> return rc
        }
        if loc == 0 {
            get_cell_info(bt, c)
            if bt.cursors[c].info.n_key == x.n_key {
                x2: BtreePayload{key: [U8]{}, n_key: 0, data: x.key, n_data: x.n_key, n_zero: 0, mem: [base.Mem]{}}
                return btree_overwrite_cell(bt, c, x2)
            }
        }
    } else {
        if bt.has_incrblob_cur -> invalidate_incrblob_cursors(bt, root, x.n_key, false)
        if bt.cursors[c].cur_flags.bit_and(BTCF_VALID_NKEY) != 0 && x.n_key == bt.cursors[c].info.n_key {
            if bt.cursors[c].info.n_size != 0 && bt.cursors[c].info.n_payload == x.n_data + x.n_zero -> return btree_overwrite_cell(bt, c, x)
        } else if loc == 0 {
            rc: btree_table_moveto(bt, c, x.n_key, append, loc)
            if rc != base.OK -> return rc
        }
    }
    s: bt.cursors[c].page
    if bt.mem[s].n_free < 0 {
        rc := base.OK
        if bt.cursors[c].state > CURSOR_INVALID {
            rc = base.CORRUPT
        } else {
            rc = btree_compute_free_space(bt, s)
        }
        if rc != base.OK -> return rc
    }
    rc := base.OK
    if flags.bit_and(BTREE_PREFORMAT) != 0 {
        sz_new = bt.n_preformat_size
        if sz_new < 4 -> sz_new = 4
        if bt.auto_vacuum && sz_new > bt.mem[s].max_local {
            info := cell_info_zero()
            parse_cell(bt.mem[s], bt.usable_size, bt.tmp_space, 0, info)
            if info.n_payload != info.n_local {
                ovfl: bget4(bt.tmp_space, sz_new - 4)
                pgno: bt.mem[s].pgno
                ptrmap_put(bt, ovfl, PTRMAP_OVERFLOW1, pgno, rc)
                if rc != base.OK -> return rc
            }
        }
    } else {
        rc = fill_in_cell(bt, s, x, sz_new)
        if rc != base.OK -> return rc
    }
    idx := bt.cursors[c].ix
    bt.cursors[c].info.n_size = 0
    if loc == 0 {
        if idx >= bt.mem[s].n_cell -> return base.CORRUPT
        rc = pager.pager_write(bt.pager, s)
        if rc != base.OK -> return rc
        old_cell: find_cell(bt, s, idx)
        if !bt.mem[s].leaf {
            loop k in 0..<4 {
                v: bt.pager.pcache.pages[s].data[old_cell + k]
                bt.tmp_space[k] = v
            }
        }
        info := cell_info_zero()
        rc = clear_cell(bt, s, old_cell, info)
        invalidate_overflow_cache(bt, c)
        if info.n_size == sz_new && info.n_local == info.n_payload && (!bt.auto_vacuum || sz_new < bt.mem[s].min_local) {
            if old_cell < bt.mem[s].hdr_offset + 10 -> return base.CORRUPT
            if old_cell + sz_new > bt.page_size -> return base.CORRUPT
            loop k in 0..<sz_new {
                v: bt.tmp_space[k]
                bt.pager.pcache.pages[s].data[old_cell + k] = v
            }
            return base.OK
        }
        drop_cell(bt, s, idx, info.n_size, rc)
        if rc != base.OK -> return rc
    } else if loc < 0 && bt.mem[s].n_cell > 0 {
        idx = bt.cursors[c].ix + 1
        bt.cursors[c].ix = idx
        bt.cursors[c].cur_flags = util.clear_bits(bt.cursors[c].cur_flags, BTCF_VALID_NKEY)
    }
    new_cell: slice_of(bt.tmp_space, 0, sz_new)
    rc = insert_cell_fast(bt, s, idx, new_cell, sz_new)
    if bt.mem[s].n_overflow != 0 {
        bt.cursors[c].cur_flags = util.clear_bits(bt.cursors[c].cur_flags, BTCF_VALID_NKEY)
        rc = balance(bt, c)
        now: bt.cursors[c].page
        bt.mem[now].n_overflow = 0
        bt.cursors[c].state = CURSOR_INVALID
        if flags.bit_and(BTREE_SAVEPOSITION) != 0 && rc == base.OK {
            btree_release_all_cursor_pages(bt, c)
            if bt.cursors[c].key_info != None -> bt.cursors[c].key = Val(slice_of(x.key, 0, x.n_key))
            bt.cursors[c].state = CURSOR_REQUIRESEEK
            bt.cursors[c].n_key = x.n_key
        }
    }
    rc
}

// The row sqlite3BtreeTransferRow copies: the source cursor's whole
// payload. C reads the source's overflow pages while it fills the
// destination's; here btree_transfer_source reads them first (the source
// may be another Btree, or this one), with the same checks in the same
// order, and btree_transfer_row builds the cell from the copy. The pages
// written are the same.
btree_transfer_source: fn(bt: &Btree, c: Int, out: &[U8]) -[DB]> Int Never! {
    get_cell_info(bt, c)
    s: bt.cursors[c].page
    n_in: bt.cursors[c].info.n_local
    at: bt.cursors[c].info.payload
    n_rem: bt.cursors[c].info.n_payload
    if at + n_in > bt.page_size -> return base.CORRUPT
    buf := pager.zeros(n_rem)
    loop k in 0..<n_in -> buf[k] = bt.pager.pcache.pages[s].data[at + k]
    pos := n_in
    if n_rem > n_in {
        if at + n_in + 4 > bt.page_size -> return base.CORRUPT
        ovfl_in := pg4(bt, s, at + n_in)
        loop pos < n_rem {
            page_in := cache.NO_PAGE
            rc: pager.pager_get(bt.pager, ovfl_in, page_in, pager.PAGER_GET_READONLY)
            if rc != base.OK -> return rc
            ovfl_in = bget4(bt.pager.pcache.pages[page_in].data, 0)
            n := bt.usable_size - 4
            if n > n_rem - pos -> n = n_rem - pos
            loop k in 0..<n -> buf[pos + k] = bt.pager.pcache.pages[page_in].data[4 + k]
            pos += n
            pager.pager_unref(bt.pager, page_in)
        }
    }
    out = buf
    base.OK
}

// sqlite3BtreeTransferRow: build in bt.tmp_space the cell for the payload
// src (from btree_transfer_source) under rowid i_key (a table's), spilling
// to new overflow pages, ready for btree_insert with BTREE_PREFORMAT.
// C's shortcut for a payload that fits locally builds the same cell.
btree_transfer_row: fn(bt: &Btree, dest: Int, src: [U8], i_key: Int) -[DB]> Int Never! {
    n_payload: src.len()
    head := [U8]{}
    util.put_varint(head, n_payload)
    if bt.cursors[dest].key_info == None -> util.put_varint(head, i_key)
    fill_bytes(bt, -1, 0, head, 0, head.len())
    d: bt.cursors[dest].page
    n_out := btree_payload_to_local(bt, bt.mem[d], n_payload)
    bt.n_preformat_size = n_out + head.len()
    // pPgnoOut: where the next overflow page number goes (slot -1 for
    // tmp_space, -2 for none yet).
    ptr_slot := -2
    ptr_at := 0
    if n_out < n_payload {
        ptr_slot = -1
        ptr_at = head.len() + n_out
        bt.n_preformat_size += 4
    }
    out_slot := -1
    out_at := head.len()
    page_out := cache.NO_PAGE
    pos := 0
    n_rem := n_payload
    rc := base.OK
    loop {
        n_rem -= n_out
        fill_bytes(bt, out_slot, out_at, src, pos, n_out)
        pos += n_out
        if n_rem > 0 && ptr_slot != -2 {
            new_page := cache.NO_PAGE
            pgno_new := 0
            rc = allocate_btree_page(bt, new_page, pgno_new, 0, 0)
            if ptr_slot < 0 {
                util.put4(bt.tmp_space, ptr_at, pgno_new.bit_and(os.U32_MASK))
            } else {
                ps4(bt, ptr_slot, ptr_at, pgno_new)
            }
            if bt.auto_vacuum && page_out != cache.NO_PAGE {
                parent: bt.mem[page_out].pgno
                ptrmap_put(bt, pgno_new, PTRMAP_OVERFLOW2, parent, rc)
            }
            release_page(bt, page_out)
            page_out = new_page
            if page_out != cache.NO_PAGE {
                ptr_slot = page_out
                ptr_at = 0
                ps4(bt, page_out, 0, 0)
                out_slot = page_out
                out_at = 4
                n_out = bt.usable_size - 4
                if n_out > n_rem -> n_out = n_rem
            }
        }
        if n_rem <= 0 || rc != base.OK -> break
    }
    release_page(bt, page_out)
    rc
}

// sqlite3BtreeDelete: delete the cursor's entry. With BTREE_SAVEPOSITION
// the cursor is left where a following btree_next or btree_previous finds
// the neighbouring entry; BTREE_AUXDELETE needs nothing here.
btree_delete: fn(bt: &Btree, c: Int, flags: Int) -[DB]> Int Never! {
    if bt.cursors[c].state != CURSOR_VALID {
        if bt.cursors[c].state < CURSOR_REQUIRESEEK -> return base.CORRUPT
        rc: btree_restore_cursor_position(bt, c)
        if rc != base.OK || bt.cursors[c].state != CURSOR_VALID -> return rc
    }
    i_cell_depth: bt.cursors[c].i_page
    i_cell_idx: bt.cursors[c].ix
    s: bt.cursors[c].page
    if bt.mem[s].n_cell <= i_cell_idx -> return base.CORRUPT
    cell: find_cell(bt, s, i_cell_idx)
    if bt.mem[s].n_free < 0 && btree_compute_free_space(bt, s) != base.OK -> return base.CORRUPT
    if cell < bt.mem[s].cell_offset + 2 * bt.mem[s].n_cell -> return base.CORRUPT
    b_preserve := if flags.bit_and(BTREE_SAVEPOSITION) != 0 -> 1 else -> 0
    if b_preserve != 0 {
        sz: cell_size(bt.mem[s], bt.usable_size, bt.pager.pcache.pages[s].data, cell)
        if !bt.mem[s].leaf || bt.mem[s].n_free + sz + 2 > bt.usable_size * 2 /% 3 || bt.mem[s].n_cell == 1 {
            rc: save_cursor_key(bt, c)
            if rc != base.OK -> return rc
        } else {
            b_preserve = 2
        }
    }
    if !bt.mem[s].leaf {
        rc: btree_previous(bt, c, 0)
        if rc != base.OK -> return rc
    }
    root: bt.cursors[c].pgno_root
    if bt.cursors[c].cur_flags.bit_and(BTCF_MULTIPLE) != 0 {
        rc: save_all_cursors(bt, root, c)
        if rc != base.OK -> return rc
    }
    if bt.cursors[c].key_info == None && bt.has_incrblob_cur {
        n_key: bt.cursors[c].info.n_key
        invalidate_incrblob_cursors(bt, root, n_key, false)
    }
    rc := pager.pager_write(bt.pager, s)
    if rc != base.OK -> return rc
    info := cell_info_zero()
    rc = clear_cell(bt, s, cell, info)
    drop_cell(bt, s, i_cell_idx, info.n_size, rc)
    if rc != base.OK -> return rc
    if !bt.mem[s].leaf {
        // Move the leaf's last cell, the entry before the deleted one, up
        // into the interior page.
        leaf: bt.cursors[c].page
        if bt.mem[leaf].n_free < 0 {
            rc = btree_compute_free_space(bt, leaf)
            if rc != base.OK -> return rc
        }
        n := bt.mem[leaf].pgno
        if i_cell_depth < bt.cursors[c].i_page - 1 {
            below: bt.cursors[c].ap_page[i_cell_depth + 1]
            n = bt.mem[below].pgno
        }
        last: bt.mem[leaf].n_cell - 1
        leaf_cell: find_cell(bt, leaf, last)
        if leaf_cell < 4 -> return base.CORRUPT
        n_cell: cell_size(bt.mem[leaf], bt.usable_size, bt.pager.pcache.pages[leaf].data, leaf_cell)
        rc = pager.pager_write(bt.pager, leaf)
        if rc == base.OK {
            moved: page_slice(bt, leaf, leaf_cell - 4, n_cell + 4)
            rc = insert_cell(bt, s, i_cell_idx, moved, n_cell + 4, n)
        }
        drop_cell(bt, leaf, last, n_cell, rc)
        if rc != base.OK -> return rc
    }
    cur: bt.cursors[c].page
    if bt.mem[cur].n_free * 3 <= bt.usable_size * 2 {
        rc = base.OK
    } else {
        rc = balance(bt, c)
    }
    if rc == base.OK && bt.cursors[c].i_page > i_cell_depth {
        top: bt.cursors[c].page
        release_page_not_null(bt, top)
        bt.cursors[c].i_page -= 1
        loop bt.cursors[c].i_page > i_cell_depth {
            ip: bt.cursors[c].i_page
            p: bt.cursors[c].ap_page[ip]
            release_page(bt, p)
            bt.cursors[c].i_page = ip - 1
        }
        bt.cursors[c].page = bt.cursors[c].ap_page[bt.cursors[c].i_page]
        rc = balance(bt, c)
    }
    if rc == base.OK {
        if b_preserve > 1 {
            bt.cursors[c].state = CURSOR_SKIPNEXT
            if i_cell_idx >= bt.mem[s].n_cell {
                bt.cursors[c].skip_next = -1
                bt.cursors[c].ix = bt.mem[s].n_cell - 1
            } else {
                bt.cursors[c].skip_next = 1
            }
        } else {
            rc = move_to_root(bt, c)
            if b_preserve != 0 {
                btree_release_all_cursor_pages(bt, c)
                bt.cursors[c].state = CURSOR_REQUIRESEEK
            }
            if rc == base.EMPTY -> rc = base.OK
        }
    }
    rc
}

// ---------------------------------------------------------------------------
// Creating, clearing and dropping tables.

// sqlite3BtreeCreateTable: a new empty table (BTREE_INTKEY) or index
// (BTREE_BLOBKEY) whose root page number pi_table gets. With auto-vacuum
// the root goes right after the largest root page, moving what was there.
btree_create_table: fn(bt: &Btree, pi_table: &Int, flags: Int) -[DB]> Int Never! {
    root := cache.NO_PAGE
    pgno_root := 0
    rc := base.OK
    if bt.auto_vacuum {
        invalidate_all_overflow_cache(bt)
        pgno_root = btree_get_meta(bt, BTREE_LARGEST_ROOT_PAGE)
        if pgno_root > btree_pagecount(bt) -> return base.CORRUPT
        pgno_root += 1
        loop pgno_root == ptrmap_pageno(bt, pgno_root) || pgno_root == pending_byte_page(bt) -> pgno_root += 1
        page_move := cache.NO_PAGE
        pgno_move := 0
        rc = allocate_btree_page(bt, page_move, pgno_move, pgno_root, BTALLOC_EXACT)
        if rc != base.OK -> return rc
        if pgno_move != pgno_root {
            e_type := 0
            i_ptr_page := 0
            rc = save_all_cursors(bt, 0, -1)
            release_page(bt, page_move)
            if rc != base.OK -> return rc
            rc = btree_get_page(bt, pgno_root, root, 0)
            if rc != base.OK -> return rc
            rc = ptrmap_get(bt, pgno_root, e_type, i_ptr_page)
            if e_type == PTRMAP_ROOTPAGE || e_type == PTRMAP_FREEPAGE -> rc = base.CORRUPT
            if rc != base.OK {
                release_page(bt, root)
                return rc
            }
            rc = relocate_page(bt, root, e_type, i_ptr_page, pgno_move, false)
            release_page(bt, root)
            if rc != base.OK -> return rc
            rc = btree_get_page(bt, pgno_root, root, 0)
            if rc != base.OK -> return rc
            rc = pager.pager_write(bt.pager, root)
            if rc != base.OK {
                release_page(bt, root)
                return rc
            }
        } else {
            root = page_move
        }
        ptrmap_put(bt, pgno_root, PTRMAP_ROOTPAGE, 0, rc)
        if rc != base.OK {
            release_page(bt, root)
            return rc
        }
        rc = btree_update_meta(bt, BTREE_LARGEST_ROOT_PAGE, pgno_root)
        if rc != base.OK {
            release_page(bt, root)
            return rc
        }
    } else {
        rc = allocate_btree_page(bt, root, pgno_root, 1, 0)
        if rc != base.OK -> return rc
    }
    ptf: if flags.bit_and(BTREE_INTKEY) != 0 -> PTF_INTKEY.bit_or(PTF_LEAFDATA).bit_or(PTF_LEAF) else -> PTF_ZERODATA.bit_or(PTF_LEAF)
    zero_page(bt, root, ptf)
    pager.pager_unref(bt.pager, root)
    pi_table = pgno_root
    base.OK
}

// clearDatabasePage: free every cell of page pgno and its subtree (the
// page too when free_page_flag), adding the cells freed to n_change when
// count (C's pnChange; the rows of a table, the entries of an index).
clear_database_page: fn(bt: &Btree, pgno: Int, free_page_flag: Bool, n_change: &Int, count: Bool) -[DB]> Int Never! {
    if pgno > btree_pagecount(bt) -> return base.CORRUPT
    s := cache.NO_PAGE
    rc := get_and_init_page(bt, pgno, s, 0)
    if rc != base.OK -> return rc
    rc = clear_database_page_body(bt, s, pgno, free_page_flag, n_change, count)
    // cleardatabasepage_out.
    release_page(bt, s)
    rc
}

clear_database_page_body: fn(bt: &Btree, s: Int, pgno: Int, free_page_flag: Bool, n_change: &Int, count_in: Bool) -[DB]> Int Never! {
    want_refs: if pgno == 1 -> 2 else -> 1
    if bt.open_flags.bit_and(BTREE_SINGLE) == 0 && pager.pager_page_refcount(bt.pager, s) != want_refs -> return base.CORRUPT
    hdr: bt.mem[s].hdr_offset
    rc := base.OK
    loop i in 0..<bt.mem[s].n_cell {
        cell: find_cell(bt, s, i)
        if !bt.mem[s].leaf {
            child: pg4(bt, s, cell)
            rc = clear_database_page(bt, child, true, n_change, count_in)
            if rc != base.OK -> return rc
        }
        info := cell_info_zero()
        rc = clear_cell(bt, s, cell, info)
        if rc != base.OK -> return rc
    }
    count := count_in
    if !bt.mem[s].leaf {
        right: pg4(bt, s, hdr + 8)
        rc = clear_database_page(bt, right, true, n_change, count_in)
        if rc != base.OK -> return rc
        if bt.mem[s].int_key -> count = false
    }
    if count -> n_change += bt.mem[s].n_cell
    if free_page_flag {
        free_page(bt, s, rc)
    } else {
        rc = pager.pager_write(bt.pager, s)
        if rc == base.OK {
            flags: pb(bt, s, hdr).bit_or(PTF_LEAF)
            zero_page(bt, s, flags)
        }
    }
    rc
}

// sqlite3BtreeClearTable: delete every entry of table or index i_table,
// keeping its root page; n_change gets the entries deleted added to it.
btree_clear_table: fn(bt: &Btree, i_table: Int, n_change: &Int) -[DB]> Int Never! {
    rc := save_all_cursors(bt, i_table, -1)
    if rc == base.OK {
        if bt.has_incrblob_cur -> invalidate_incrblob_cursors(bt, i_table, 0, true)
        rc = clear_database_page(bt, i_table, false, n_change, true)
    }
    rc
}

// sqlite3BtreeClearTableOfCursor.
btree_clear_table_of_cursor: fn(bt: &Btree, c: Int) -[DB]> Int Never! {
    root: bt.cursors[c].pgno_root
    unused := 0
    btree_clear_table(bt, root, unused)
}

// sqlite3BtreeDropTable: free table i_table and its root page. With
// auto-vacuum the largest root page moves into the freed root's place and
// pi_moved gets its old number (else 0).
btree_drop_table: fn(bt: &Btree, i_table: Int, pi_moved: &Int) -[DB]> Int Never! {
    if i_table > btree_pagecount(bt) -> return base.CORRUPT
    unused := 0
    rc := btree_clear_table(bt, i_table, unused)
    if rc != base.OK -> return rc
    s := cache.NO_PAGE
    rc = btree_get_page(bt, i_table, s, 0)
    if rc != base.OK {
        release_page(bt, s)
        return rc
    }
    pi_moved = 0
    if !bt.auto_vacuum {
        free_page(bt, s, rc)
        release_page(bt, s)
        return rc
    }
    max_root := btree_get_meta(bt, BTREE_LARGEST_ROOT_PAGE)
    if i_table == max_root {
        free_page(bt, s, rc)
        release_page(bt, s)
        if rc != base.OK -> return rc
    } else {
        release_page(bt, s)
        mv := cache.NO_PAGE
        rc = btree_get_page(bt, max_root, mv, 0)
        if rc != base.OK -> return rc
        rc = relocate_page(bt, mv, PTRMAP_ROOTPAGE, 0, i_table, false)
        release_page(bt, mv)
        if rc != base.OK -> return rc
        mv = cache.NO_PAGE
        rc = btree_get_page(bt, max_root, mv, 0)
        free_page(bt, mv, rc)
        release_page(bt, mv)
        if rc != base.OK -> return rc
        pi_moved = max_root
    }
    max_root -= 1
    loop max_root == pending_byte_page(bt) || ptrmap_is_page(bt, max_root) -> max_root -= 1
    btree_update_meta(bt, BTREE_LARGEST_ROOT_PAGE, max_root)
}

// ---------------------------------------------------------------------------
// Meta values and counting.

// sqlite3BtreeGetMeta: meta value idx of the database header (page 1 must
// be held), or for BTREE_DATA_VERSION the count of changes seen.
btree_get_meta: fn(bt: Btree, idx: Int) -> Int Never! {
    if idx == BTREE_DATA_VERSION -> return (pager.pager_data_version(bt.pager) + bt.b_data_version).bit_and(os.U32_MASK)
    pg4(bt, bt.page1, 36 + idx * 4)
}

// sqlite3BtreeUpdateMeta: set meta value idx (1 to 15) in a write
// transaction.
btree_update_meta: fn(bt: &Btree, idx: Int, i_meta: Int) -[DB]> Int Never! {
    p1: bt.page1
    rc: pager.pager_write(bt.pager, p1)
    if rc == base.OK {
        ps4(bt, p1, 36 + idx * 4, i_meta)
        if idx == BTREE_INCR_VACUUM -> bt.incr_vacuum = i_meta.bit_and(255) != 0
    }
    rc
}

// sqlite3BtreeCount: n_entry gets the number of entries in the cursor's
// table or index, counted from the cells of every leaf (and of every
// interior page of an index). It stops without setting n_entry when the
// connection is interrupted.
btree_count: fn(bt: &Btree, c: Int, n_entry: &Int) -[DB]> Int Never! {
    n := 0
    rc := move_to_root(bt, c)
    if rc == base.EMPTY {
        n_entry = 0
        return base.OK
    }
    loop rc == base.OK && !bt.db.is_interrupted {
        s := bt.cursors[c].page
        if bt.mem[s].leaf || !bt.mem[s].int_key -> n += bt.mem[s].n_cell
        if bt.mem[s].leaf {
            loop {
                if bt.cursors[c].i_page == 0 {
                    n_entry = n
                    return move_to_root(bt, c)
                }
                move_to_parent(bt, c)
                up: bt.cursors[c].page
                if bt.cursors[c].ix < bt.mem[up].n_cell -> break
            }
            bt.cursors[c].ix += 1
            s = bt.cursors[c].page
        }
        i_idx: bt.cursors[c].ix
        child := 0
        if i_idx == bt.mem[s].n_cell {
            child = pg4(bt, s, bt.mem[s].hdr_offset + 8)
        } else {
            cell: find_cell(bt, s, i_idx)
            child = pg4(bt, s, cell)
        }
        rc = move_to_child(bt, c, child)
    }
    rc
}

// ---------------------------------------------------------------------------
// Integrity checking (PRAGMA integrity_check).
//
// Memory cannot run out here, so checkOom and the SQLITE_NOMEM and
// SQLITE_IOERR_NOMEM cases never arise and are left out.

// LARGEST_INT64.
LARGEST_INT64: 9223372036854775807

// The prefixes of the messages (IntegrityCk.zPfx): none, "Freelist: ",
// "Tree %u page %u: ", "Tree %u page %u cell %u: " and
// "Tree %u page %u right child: ".
PFX_NONE: 0
PFX_FREELIST: 1
PFX_TREE_PAGE: 2
PFX_TREE_CELL: 3
PFX_RIGHT_CHILD: 4

// The state of an integrity check (IntegrityCk). pg_ref has an entry per
// page (aPgRef's bits); heap is the u32 min-heap of a page's cell and
// freeblock extents; msg is errMsg.
IntegrityCk: struct {
    n_ck_page: Int
    mx_err: Int
    n_err: Int
    rc: Int
    n_step: Int
    pg_ref: [Bool]
    heap: [Int]
    pfx: Int
    v0: Int
    v1: Int
    v2: Int
    msg: String
}

// checkProgress: stop the check once the connection is interrupted or its
// progress callback asks to.
check_progress: fn(db: BtDB, ck: &IntegrityCk) Never! {
    if db.is_interrupted {
        ck.rc = base.INTERRUPT
        ck.n_err += 1
        ck.mx_err = 0
    }
    if db.progress == .Val(cb) {
        ck.n_step += 1
        if ck.n_step % db.n_progress_ops == 0 && cb() {
            ck.rc = base.INTERRUPT
            ck.n_err += 1
            ck.mx_err = 0
        }
    }
}

// The message prefix of ck.pfx.
check_prefix: fn(ck: IntegrityCk) -> String Never! {
    if ck.pfx == PFX_FREELIST -> return "Freelist: "
    if ck.pfx == PFX_TREE_PAGE -> return "Tree {ck.v0} page {ck.v1}: "
    if ck.pfx == PFX_TREE_CELL -> return "Tree {ck.v0} page {ck.v1} cell {ck.v2}: "
    if ck.pfx == PFX_RIGHT_CHILD -> return "Tree {ck.v0} page {ck.v1} right child: "
    ""
}

// checkAppendMsg: add one error, under the current prefix.
check_append_msg: fn(db: BtDB, ck: &IntegrityCk, text: String) Never! {
    check_progress(db, ck)
    if ck.mx_err == 0 -> return
    ck.mx_err -= 1
    ck.n_err += 1
    pfx: check_prefix(ck)
    if ck.msg.len() > 0 {
        ck.msg = "{ck.msg}\n{pfx}{text}"
    } else {
        ck.msg = "{pfx}{text}"
    }
}

// checkRef: mark page i_page referenced; true (after reporting it) when it
// is out of range or was already referenced.
check_ref: fn(db: BtDB, ck: &IntegrityCk, i_page: Int) -> Bool Never! {
    if i_page > ck.n_ck_page || i_page == 0 {
        check_append_msg(db, ck, "invalid page number {i_page}")
        return true
    }
    if ck.pg_ref[i_page] {
        check_append_msg(db, ck, "2nd reference to page {i_page}")
        return true
    }
    ck.pg_ref[i_page] = true
    false
}

// checkPtrmap: report the pointer-map entry of i_child unless it is
// (e_type, i_parent).
check_ptrmap: fn(bt: &Btree, ck: &IntegrityCk, i_child: Int, e_type: Int, i_parent: Int) Never! -[DB]> {
    got_type := 0
    got_parent := 0
    rc: ptrmap_get(bt, i_child, got_type, got_parent)
    if rc != base.OK {
        check_append_msg(bt.db, ck, "Failed to read ptrmap key={i_child}")
        return
    }
    if got_type != e_type || got_parent != i_parent {
        check_append_msg(bt.db, ck, "Bad ptr map entry key={i_child} expected=({e_type},{i_parent}) got=({got_type},{got_parent})")
    }
}

// checkList: check the freelist (is_free_list) or an overflow chain that
// starts at i_page and should hold n_expected pages. The count is a u32.
check_list: fn(bt: &Btree, ck: &IntegrityCk, is_free_list: Bool, i_page_in: Int, n_expected: Int) Never! -[DB]> {
    i_page := i_page_in
    n := n_expected
    n_err_at_start: ck.n_err
    loop i_page != 0 && ck.mx_err != 0 {
        if check_ref(bt.db, ck, i_page) -> break
        n -= 1
        pg := cache.NO_PAGE
        if pager.pager_get(bt.pager, i_page, pg, 0) != base.OK {
            check_append_msg(bt.db, ck, "failed to get page {i_page}")
            break
        }
        if is_free_list {
            n_leaf: pg4(bt, pg, 4)
            if bt.auto_vacuum -> check_ptrmap(bt, ck, i_page, PTRMAP_FREEPAGE, 0)
            if n_leaf > bt.usable_size /% 4 - 2 {
                check_append_msg(bt.db, ck, "freelist leaf count too big on page {i_page}")
                n -= 1
            } else {
                loop i in 0..<n_leaf {
                    i_free_page: pg4(bt, pg, 8 + i * 4)
                    if bt.auto_vacuum -> check_ptrmap(bt, ck, i_free_page, PTRMAP_FREEPAGE, 0)
                    _: check_ref(bt.db, ck, i_free_page)
                }
                n -= n_leaf
            }
        } else if bt.auto_vacuum && n.bit_and(os.U32_MASK) != 0 {
            following: pg4(bt, pg, 0)
            check_ptrmap(bt, ck, following, PTRMAP_OVERFLOW2, i_page)
        }
        i_page = pg4(bt, pg, 0)
        pager.pager_unref(bt.pager, pg)
    }
    if n.bit_and(os.U32_MASK) != 0 && n_err_at_start == ck.n_err {
        what: if is_free_list -> "size" else -> "overflow list length"
        got: (n_expected - n).bit_and(os.U32_MASK)
        check_append_msg(bt.db, ck, "{what} is {got} but should be {n_expected}")
    }
}

// btreeHeapInsert: add x to the min-heap (heap[0] is its size).
heap_insert: fn(heap: &[Int], x: Int) Never! {
    i := heap[0] + 1
    heap[0] = i
    heap[i] = x
    loop {
        j: i /% 2
        if j == 0 || heap[j] <= heap[i] -> break
        hj: heap[j]
        hi: heap[i]
        heap[j] = hi
        heap[i] = hj
        i = j
    }
}

// btreeHeapPull: take the least entry into out; false when empty.
heap_pull: fn(heap: &[Int], out: &Int) -> Bool Never! {
    x: heap[0]
    if x == 0 -> return false
    out = heap[1]
    last: heap[x]
    heap[1] = last
    heap[x] = os.U32_MASK
    heap[0] = x - 1
    i := 1
    loop {
        j := i * 2
        if j > heap[0] -> break
        if heap[j] > heap[j + 1] -> j += 1
        if heap[i] < heap[j] -> break
        hj: heap[j]
        hi: heap[i]
        heap[i] = hj
        heap[j] = hi
        i = j
    }
    true
}

// checkTreePage: check page i_page and the tree below it, whose rowids
// must not pass max_key; pi_min_key gets the least rowid. The depth of
// the tree, 0 for a leaf (and for a page that cannot be checked).
check_tree_page: fn(bt: &Btree, ck: &IntegrityCk, i_page: Int, pi_min_key: &Int, max_key: Int) -[DB]> Int Never! {
    check_progress(bt.db, ck)
    if ck.mx_err == 0 -> return 0
    if i_page == 0 -> return 0
    if check_ref(bt.db, ck, i_page) -> return 0
    saved_pfx: ck.pfx
    saved_v1: ck.v1
    saved_v2: ck.v2
    ck.pfx = PFX_TREE_PAGE
    ck.v1 = i_page
    s := cache.NO_PAGE
    depth := -1
    do_coverage := true
    saved_is_init := false
    rc: btree_get_page(bt, i_page, s, 0)
    if rc != base.OK {
        check_append_msg(bt.db, ck, "unable to get the page. error code={rc}")
    } else {
        saved_is_init = bt.mem[s].is_init
        bt.mem[s].is_init = false
        check_tree_page_body(bt, ck, s, i_page, pi_min_key, max_key, depth, do_coverage)
    }
    // end_of_check.
    if !do_coverage -> bt.mem[s].is_init = saved_is_init
    release_page(bt, s)
    ck.pfx = saved_pfx
    ck.v1 = saved_v1
    ck.v2 = saved_v2
    depth + 1
}

check_tree_page_body: fn(bt: &Btree, ck: &IntegrityCk, s: Int, i_page: Int, pi_min_key: &Int, max_key_in: Int, depth: &Int, do_coverage: &Bool) Never! -[DB]> {
    rc := btree_init_page(bt, s)
    if rc != base.OK {
        check_append_msg(bt.db, ck, "btreeInitPage() returns error code {rc}")
        return
    }
    rc = btree_compute_free_space(bt, s)
    if rc != base.OK {
        check_append_msg(bt.db, ck, "free space corruption")
        return
    }
    usable: bt.usable_size
    hdr: bt.mem[s].hdr_offset
    leaf: bt.mem[s].leaf
    ck.pfx = PFX_TREE_CELL
    content_offset: get2_not_zero(pg2(bt, s, hdr + 5))
    n_cell: pg2(bt, s, hdr + 3)
    cell_start: hdr + 12 - (if leaf -> 4 else -> 0)
    cell_idx := cell_start + 2 * (n_cell - 1)
    max_key := max_key_in
    key_can_be_equal := true
    if !leaf {
        pgno: pg4(bt, s, hdr + 8)
        if bt.auto_vacuum {
            ck.pfx = PFX_RIGHT_CHILD
            check_ptrmap(bt, ck, pgno, PTRMAP_BTREE, i_page)
        }
        mk: max_key
        depth = check_tree_page(bt, ck, pgno, max_key, mk)
        key_can_be_equal = false
    } else {
        ck.heap[0] = 0
    }
    i := n_cell - 1
    loop i >= 0 && ck.mx_err != 0 {
        ck.v2 = i
        pc: pg2(bt, s, cell_idx)
        cell_idx -= 2
        i -= 1
        if pc < content_offset || pc > usable - 4 {
            check_append_msg(bt.db, ck, "Offset {pc} out of range {content_offset}..{usable - 4}")
            do_coverage = false
            next
        }
        info := cell_info_zero()
        parse_cell(bt.mem[s], usable, bt.pager.pcache.pages[s].data, pc, info)
        if pc + info.n_size > usable {
            check_append_msg(bt.db, ck, "Extends off end of page")
            do_coverage = false
            next
        }
        if bt.mem[s].int_key {
            out_of_order: if key_can_be_equal -> info.n_key > max_key else -> info.n_key >= max_key
            if out_of_order -> check_append_msg(bt.db, ck, "Rowid {info.n_key} out of order")
            max_key = info.n_key
            key_can_be_equal = false
        }
        if info.n_payload > info.n_local {
            n_page: (info.n_payload - info.n_local + usable - 5) /% (usable - 4)
            pgno_ovfl: pg4(bt, s, pc + info.n_size - 4)
            if bt.auto_vacuum -> check_ptrmap(bt, ck, pgno_ovfl, PTRMAP_OVERFLOW1, i_page)
            check_list(bt, ck, false, pgno_ovfl, n_page)
        }
        if !leaf {
            pgno: pg4(bt, s, pc)
            if bt.auto_vacuum -> check_ptrmap(bt, ck, pgno, PTRMAP_BTREE, i_page)
            mk: max_key
            d2: check_tree_page(bt, ck, pgno, max_key, mk)
            key_can_be_equal = false
            if d2 != depth {
                check_append_msg(bt.db, ck, "Child page depth differs")
                depth = d2
            }
        } else {
            heap_insert(ck.heap, (pc << 16).bit_or(pc + info.n_size - 1))
        }
    }
    pi_min_key = max_key
    ck.pfx = PFX_NONE
    if !do_coverage || ck.mx_err <= 0 -> return
    if !leaf {
        ck.heap[0] = 0
        j := n_cell - 1
        loop j >= 0 {
            pc: pg2(bt, s, cell_start + j * 2)
            size: cell_size(bt.mem[s], usable, bt.pager.pcache.pages[s].data, pc)
            heap_insert(ck.heap, (pc << 16).bit_or(pc + size - 1))
            j -= 1
        }
    }
    fb := pg2(bt, s, hdr + 1)
    loop fb > 0 {
        size: pg2(bt, s, fb + 2)
        heap_insert(ck.heap, (fb << 16).bit_or(fb + size - 1))
        fb = pg2(bt, s, fb)
    }
    n_frag := 0
    prev := content_offset - 1
    x := 0
    loop heap_pull(ck.heap, x) {
        if prev.bit_and(65535) >= (x >> 16) {
            check_append_msg(bt.db, ck, "Multiple uses for byte {x >> 16} of page {i_page}")
            break
        }
        n_frag += (x >> 16) - prev.bit_and(65535) - 1
        prev = x
    }
    n_frag += usable - prev.bit_and(65535) - 1
    reported: pb(bt, s, hdr + 7)
    if ck.heap[0] == 0 && n_frag != reported {
        check_append_msg(bt.db, ck, "Fragmentation of {n_frag} bytes reported as {reported} on page {i_page}")
    }
}

// sqlite3BtreeIntegrityCheck: check the trees whose root pages are roots
// (with roots[0] 0 only the trees in roots[1..] are checked, and the
// freelist only when roots[1] is 1), the freelist and the pages' use,
// reporting at most mx_err errors. n_err gets the errors seen and out their
// messages (None when there are none); the result is SQLITE_INTERRUPT when
// the check was interrupted, else OK.
btree_integrity_check: fn(bt: &Btree, roots: [Int], mx_err: Int, n_err: &Int, out: &String?) -[DB]> Int Never! {
    b_partial := false
    b_ck_freelist := true
    if roots[0] == 0 {
        b_partial = true
        if roots[1] != 1 -> b_ck_freelist = false
    }
    ck := IntegrityCk{n_ck_page: btree_pagecount(bt), mx_err: mx_err, n_err: 0, rc: base.OK, n_step: 0, pg_ref: [Bool]{}, heap: [Int]{}, pfx: PFX_NONE, v0: 0, v1: 0, v2: 0, msg: ""}
    if ck.n_ck_page != 0 -> integrity_check_body(bt, ck, roots, b_partial, b_ck_freelist)
    // integrity_ck_cleanup.
    n_err = ck.n_err
    out = if ck.n_err == 0 -> None else -> Val(ck.msg)
    ck.rc
}

integrity_check_body: fn(bt: &Btree, ck: &IntegrityCk, roots: [Int], b_partial: Bool, b_ck_freelist: Bool) Never! -[DB]> {
    n_ck: ck.n_ck_page
    loop _ in 0..<n_ck + 1 -> ck.pg_ref.push(false)
    ck.heap = zero_ints(bt.page_size /% 4)
    pending: pending_byte_page(bt)
    if pending <= n_ck -> ck.pg_ref[pending] = true
    if b_ck_freelist {
        ck.pfx = PFX_FREELIST
        first: pg4(bt, bt.page1, 32)
        n_free: pg4(bt, bt.page1, 36)
        check_list(bt, ck, true, first, n_free)
        ck.pfx = PFX_NONE
    }
    if !b_partial {
        if bt.auto_vacuum {
            mx := 0
            loop r in roots {
                if mx < r -> mx = r
            }
            mx_in_hdr: pg4(bt, bt.page1, 52)
            if mx != mx_in_hdr -> check_append_msg(bt.db, ck, "max rootpage ({mx}) disagrees with header ({mx_in_hdr})")
        } else if pg4(bt, bt.page1, 64) != 0 {
            check_append_msg(bt.db, ck, "incremental_vacuum enabled with a max rootpage of zero")
        }
    }
    saved_db_flags: bt.db.flags
    bt.db.flags = util.clear_bits(saved_db_flags, SQLITE_CELL_SIZE_CK)
    loop r in roots {
        if ck.mx_err == 0 -> break
        if r == 0 -> next
        if bt.auto_vacuum && r > 1 && !b_partial -> check_ptrmap(bt, ck, r, PTRMAP_ROOTPAGE, 0)
        ck.v0 = r
        not_used := 0
        _: check_tree_page(bt, ck, r, not_used, LARGEST_INT64)
    }
    bt.db.flags = saved_db_flags
    if b_partial -> return
    i := 1
    loop i <= n_ck && ck.mx_err != 0 {
        is_ptrmap: ptrmap_pageno(bt, i) == i && bt.auto_vacuum
        if !ck.pg_ref[i] && !is_ptrmap -> check_append_msg(bt.db, ck, "Page {i}: never used")
        if ck.pg_ref[i] && is_ptrmap -> check_append_msg(bt.db, ck, "Page {i}: pointer map referenced")
        i += 1
    }
}

// ---------------------------------------------------------------------------
// The rest of the interface.

// sqlite3BtreeGetFilename and sqlite3BtreeGetJournalname.
btree_get_filename: fn(bt: Btree) -> String Never! { pager.pager_filename(bt.pager) }
btree_get_journalname: fn(bt: Btree) -> String? Never! { pager.pager_journalname(bt.pager) }

// sqlite3BtreeTxnState: TRANS_NONE, TRANS_READ or TRANS_WRITE.
btree_txn_state: fn(bt: Btree) -> Int Never! { bt.in_trans }

// sqlite3BtreeCheckpoint: checkpoint the WAL (an eMode of
// SQLITE_CHECKPOINT_*), or SQLITE_LOCKED while a transaction is open.
btree_checkpoint: fn(bt: &Btree, e_mode: Int, n_log: &Int, n_ckpt: &Int) -[DB]> Int Never! {
    if bt.in_transaction != TRANS_NONE -> return base.LOCKED
    pager.pager_checkpoint(bt.pager, e_mode, n_log, n_ckpt)
}

// sqlite3BtreeIsInBackup.
btree_is_in_backup: fn(bt: Btree) -> Bool Never! { bt.n_backup != 0 }

// sqlite3BtreePutData: write amt bytes of z at offset of the payload of an
// incremental-blob write cursor.
btree_put_data: fn(bt: &Btree, c: Int, offset: Int, amt: Int, z: &[U8]) -[DB]> Int Never! {
    rc := restore_cursor_position(bt, c)
    if rc != base.OK -> return rc
    if bt.cursors[c].state != CURSOR_VALID -> return base.ABORT
    root: bt.cursors[c].pgno_root
    _: save_all_cursors(bt, root, c)
    if bt.cursors[c].cur_flags.bit_and(BTCF_WRITE_FLAG) == 0 -> return base.READONLY
    access_payload(bt, c, offset, amt, z, true)
}

// sqlite3BtreeIncrblobCursor.
btree_incrblob_cursor: fn(bt: &Btree, c: Int) Never! {
    bt.cursors[c].cur_flags = bt.cursors[c].cur_flags.bit_or(BTCF_INCRBLOB)
    bt.has_incrblob_cur = true
}

// sqlite3BtreeSetVersion: set the file format read and write versions
// (bytes 18 and 19), 1 for a rollback journal and 2 for WAL.
btree_set_version: fn(bt: &Btree, i_version: Int) -[DB]> Int Never! {
    bt.bts_flags = util.clear_bits(bt.bts_flags, BTS_NO_WAL)
    if i_version == 1 -> bt.bts_flags = bt.bts_flags.bit_or(BTS_NO_WAL)
    unused := 0
    rc := btree_begin_trans(bt, 0, unused)
    if rc == base.OK {
        v: i_version.bit_and(255)
        if pb(bt, bt.page1, 18) != v || pb(bt, bt.page1, 19) != v {
            rc = btree_begin_trans(bt, 2, unused)
            if rc == base.OK {
                p1: bt.page1
                rc = pager.pager_write(bt.pager, p1)
                if rc == base.OK {
                    ps1(bt, p1, 18, v)
                    ps1(bt, p1, 19, v)
                }
            }
        }
    }
    bt.bts_flags = util.clear_bits(bt.bts_flags, BTS_NO_WAL)
    rc
}

// sqlite3BtreeCursorHasHint.
btree_cursor_has_hint: fn(bt: Btree, c: Int, mask: Int) -> Bool Never! { bt.cursors[c].hints.bit_and(mask) != 0 }

// sqlite3BtreeIsReadonly.
btree_is_readonly: fn(bt: Btree) -> Bool Never! { bt.bts_flags.bit_and(BTS_READ_ONLY) != 0 }

// sqlite3BtreeClearCache: drop the cached pages outside a transaction.
btree_clear_cache: fn(bt: &Btree) Never! {
    if bt.in_transaction == TRANS_NONE -> pager.pager_clear_cache(bt.pager)
}

// ---------------------------------------------------------------------------
// Tests.

// The text of test row k: a few bytes to past a 512-byte page, so some
// rows and index entries spill to overflow pages.
test_text: fn(k: Int) -> [U8] Never! {
    out := "k{(k * 37) % 1009}-{k}-".bytes()
    n: if k % 11 == 0 -> 700 else -> (k * 13) % 90
    loop i in 0..<n -> out.push(U8{97 + (k + i) % 26})
    out
}

// Row k of t(a INTEGER PRIMARY KEY, b TEXT), and its entry in an index on b.
test_row: fn(k: Int) -> [U8] Never! {
    vals := [base.Mem]{base.mem_null(), base.mem_text(test_text(k), base.UTF8)}
    record.make_record(vals, 4)
}

test_index_key: fn(k: Int) -> [U8] Never! {
    vals := [base.Mem]{base.mem_text(test_text(k), base.UTF8), base.mem_int(k)}
    record.make_record(vals, 4)
}

test_key_info: fn() -> record.KeyInfo Never! {
    record.KeyInfo{enc: base.UTF8, n_key_field: 1, n_all_field: 2, sort_flags: [Int]{0, 0}, colls: [Int]{record.COLL_NONE, record.COLL_NONE}}
}

// A database in memory with 512-byte pages, so a thousand rows make a tree
// of several levels.
test_open: fn(bt: &Btree, auto_vacuum: Int) Never! -[DB]> {
    flags: os.OPEN_READWRITE.bit_or(os.OPEN_CREATE).bit_or(os.OPEN_MAIN_DB)
    assert_eq(btree_open(bt, Val(":memory:"), bt_db_default(), 0, flags, true, false, false, false), base.OK)
    assert_eq(btree_set_page_size(bt, 512, -1, false), base.OK)
    assert_eq(btree_set_auto_vacuum(bt, auto_vacuum), base.OK)
}

test_payload: fn(bt: &Btree, c: Int) -[DB]> [U8] Never! {
    n: btree_payload_size(bt, c)
    buf := pager.zeros(n)
    assert_eq(btree_payload(bt, c, 0, n, buf), base.OK)
    buf
}

// The integrity check of the trees at roots; the number of errors.
test_errors: fn(bt: &Btree, roots: [Int]) -[DB]> Int Never! {
    n_err := 0
    msg := String?{None}
    assert_eq(btree_integrity_check(bt, roots, 100, n_err, msg), base.OK)
    if n_err == 0 -> assert(msg == None)
    n_err
}

// Insert rows 1..n of t and their index entries in a scattered order.
test_fill: fn(bt: &Btree, ct: Int, ci: Int, n: Int) Never! -[DB]> {
    loop i in 0..<n {
        // 7919 is prime to n, so i visits every key once.
        k: (i * 7919) % n + 1
        row: test_row(k)
        n_row: row.len()
        x: BtreePayload{key: [U8]{}, n_key: k, data: row, n_data: n_row, n_zero: 0, mem: [base.Mem]{}}
        assert_eq(btree_insert(bt, ct, x, 0, 0), base.OK)
        key: test_index_key(k)
        n_key: key.len()
        y: BtreePayload{key: key, n_key: n_key, data: [U8]{}, n_data: 0, n_zero: 0, mem: [base.Mem]{}}
        assert_eq(btree_insert(bt, ci, y, 0, 0), base.OK)
    }
}

// Delete the rows whose key is a multiple of m but not of gone (those are
// deleted already), and their index entries.
test_delete: fn(bt: &Btree, ct: Int, ci: Int, n: Int, m: Int, gone: Int) Never! -[DB]> {
    info: test_key_info()
    res := 0
    loop k in 1..n {
        if k % m != 0 || k % gone == 0 -> next
        assert_eq(btree_table_moveto(bt, ct, k, false, res), base.OK)
        assert_eq(res, 0)
        assert_eq(btree_delete(bt, ct, 0), base.OK)
        key: test_index_key(k)
        r := record.unpacked_record_alloc(info)
        record.record_unpack(info, key.len(), key, r)
        assert_eq(btree_index_moveto(bt, ci, r, res), base.OK)
        assert_eq(res, 0)
        assert_eq(btree_delete(bt, ci, 0), base.OK)
    }
}

// The table holds exactly the rows 1..n that are not multiples of m, in
// rowid order, and the index one entry for each, in key order.
test_verify: fn(bt: &Btree, ct: Int, ci: Int, n: Int, m: Int) Never! -[DB]> {
    res := 0
    assert_eq(btree_first(bt, ct, res), base.OK)
    want := 1
    seen := 0
    loop res == 0 && !btree_eof(bt, ct) {
        loop want % m == 0 -> want += 1
        assert_eq(btree_integer_key(bt, ct), want)
        assert(test_payload(bt, ct) == test_row(want))
        want += 1
        seen += 1
        rc: btree_next(bt, ct, 0)
        if rc == base.DONE -> break
        assert_eq(rc, base.OK)
    }
    assert_eq(seen, n - n /% m)
    count := 0
    assert_eq(btree_count(bt, ct, count), base.OK)
    assert_eq(count, seen)
    info: test_key_info()
    prev := record.unpacked_record_alloc(info)
    entries := 0
    assert_eq(btree_first(bt, ci, res), base.OK)
    loop res == 0 && !btree_eof(bt, ci) {
        key: test_payload(bt, ci)
        if entries > 0 -> assert(record.record_compare(key.len(), key, 0, prev) > 0)
        prev.n_field = 2
        record.record_unpack(info, key.len(), key, prev)
        assert(prev.mem[1].i % m != 0)
        entries += 1
        rc: btree_next(bt, ci, 0)
        if rc == base.DONE -> break
        assert_eq(rc, base.OK)
    }
    assert_eq(entries, seen)
}

// Fill, check, delete and check again, committing in between; then drop the
// index and check what is left.
test_scenario: fn(auto_vacuum: Int) Never! -[DB]> {
    bt := btree_closed()
    test_open(bt, auto_vacuum)
    unused := 0
    assert_eq(btree_begin_trans(bt, 1, unused), base.OK)
    t := 0
    assert_eq(btree_create_table(bt, t, BTREE_INTKEY), base.OK)
    ix := 0
    assert_eq(btree_create_table(bt, ix, BTREE_BLOBKEY), base.OK)
    ct := -1
    assert_eq(btree_cursor(bt, t, BTREE_WRCSR, None, ct), base.OK)
    ci := -1
    assert_eq(btree_cursor(bt, ix, BTREE_WRCSR, Val(test_key_info()), ci), base.OK)
    n: 1000
    test_fill(bt, ct, ci, n)
    test_verify(bt, ct, ci, n, n + 1)
    assert_eq(test_errors(bt, [Int]{1, t, ix}), 0)
    assert_eq(btree_close_cursor(bt, ct), base.OK)
    assert_eq(btree_close_cursor(bt, ci), base.OK)
    assert_eq(btree_commit(bt), base.OK)
    // Deletes, committed.
    assert_eq(btree_begin_trans(bt, 1, unused), base.OK)
    assert_eq(btree_cursor(bt, t, BTREE_WRCSR, None, ct), base.OK)
    assert_eq(btree_cursor(bt, ix, BTREE_WRCSR, Val(test_key_info()), ci), base.OK)
    test_delete(bt, ct, ci, n, 3, n + 1)
    test_verify(bt, ct, ci, n, 3)
    assert_eq(btree_close_cursor(bt, ct), base.OK)
    assert_eq(btree_close_cursor(bt, ci), base.OK)
    assert_eq(btree_commit(bt), base.OK)
    assert_eq(btree_begin_trans(bt, 0, unused), base.OK)
    assert_eq(test_errors(bt, [Int]{1, t, ix}), 0)
    // Full auto-vacuum leaves no free page at a commit.
    if auto_vacuum == BTREE_AUTOVACUUM_FULL -> assert_eq(btree_get_meta(bt, BTREE_FREE_PAGE_COUNT), 0)
    assert_eq(btree_cursor(bt, t, 0, None, ct), base.OK)
    assert_eq(btree_cursor(bt, ix, 0, Val(test_key_info()), ci), base.OK)
    test_verify(bt, ct, ci, n, 3)
    assert_eq(btree_close_cursor(bt, ct), base.OK)
    assert_eq(btree_close_cursor(bt, ci), base.OK)
    assert_eq(btree_commit(bt), base.OK)
    // Deletes that roll back leave the committed rows.
    assert_eq(btree_begin_trans(bt, 1, unused), base.OK)
    assert_eq(btree_cursor(bt, t, BTREE_WRCSR, None, ct), base.OK)
    assert_eq(btree_cursor(bt, ix, BTREE_WRCSR, Val(test_key_info()), ci), base.OK)
    test_delete(bt, ct, ci, n, 2, 3)
    assert_eq(btree_close_cursor(bt, ct), base.OK)
    assert_eq(btree_close_cursor(bt, ci), base.OK)
    assert_eq(btree_rollback(bt, base.OK, false), base.OK)
    assert_eq(btree_begin_trans(bt, 0, unused), base.OK)
    assert_eq(btree_cursor(bt, t, 0, None, ct), base.OK)
    assert_eq(btree_cursor(bt, ix, 0, Val(test_key_info()), ci), base.OK)
    test_verify(bt, ct, ci, n, 3)
    assert_eq(btree_close_cursor(bt, ct), base.OK)
    assert_eq(btree_close_cursor(bt, ci), base.OK)
    assert_eq(btree_commit(bt), base.OK)
    // The check finds a wrong freelist count.
    assert_eq(btree_begin_trans(bt, 1, unused), base.OK)
    free: btree_get_meta(bt, BTREE_FREE_PAGE_COUNT)
    p1: bt.page1
    assert_eq(pager.pager_write(bt.pager, p1), base.OK)
    ps4(bt, p1, 36, free + 5)
    n_err := 0
    msg := String?{None}
    assert_eq(btree_integrity_check(bt, [Int]{1, t, ix}, 100, n_err, msg), base.OK)
    assert(n_err > 0)
    text: msg ?? ""
    assert(text.contains("size is {free} but should be {free + 5}"))
    assert_eq(btree_rollback(bt, base.OK, false), base.OK)
    // Dropping the index frees its pages.
    assert_eq(btree_begin_trans(bt, 1, unused), base.OK)
    moved := 0
    assert_eq(btree_drop_table(bt, ix, moved), base.OK)
    assert_eq(moved, 0)
    assert_eq(btree_commit(bt), base.OK)
    assert_eq(btree_begin_trans(bt, 0, unused), base.OK)
    assert_eq(test_errors(bt, [Int]{1, t}), 0)
    assert_eq(btree_commit(bt), base.OK)
    assert_eq(btree_close(bt), base.OK)
}

#Test("a table and its index take inserts, deletes and rollbacks and pass the integrity check") {
    test_scenario(BTREE_AUTOVACUUM_NONE)
}

#Test("with full auto-vacuum the trees move to keep the file free of free pages") {
    test_scenario(BTREE_AUTOVACUUM_FULL)
}
