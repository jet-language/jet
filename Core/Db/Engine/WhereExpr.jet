// WHERE clause analysis: a port of SQLite 3.45.0 whereexpr.c in full
// (splitting a WHERE clause into terms and analyzing each term), with the
// planner's objects (whereInt.h), the cursor bitmasks of where.c
// (sqlite3WhereGetMask, createMask), sqlite3IsLikeFunction (func.c) and
// sqlite3SetJoinExpr (select.c), which the analysis shares. The planner and
// the loop code generator (where.c, wherecode.c) are Where's.
//
// A WhereInfo keeps every term in one arena (terms) and every clause in
// another (wcs; clause 0 is sWC). A clause lists its terms by arena index
// and a term names its clause (wc). C's WhereOrInfo and WhereAndInfo are a
// term's sub_wc clause (TERM_ORINFO, TERM_ANDINFO) and the OR term's
// indexable mask. iParent is, as in C, an index into the term's own clause;
// whereClauseInsert zeroes it as C's memset does and exprAnalyze sets -1.
// A Bitmask is a nonnegative Int below 2^64, C's unsigned arithmetic: ~m is
// rs.ALLBITS.bit_xor(m).
//
// whereClauseInsert cannot fail. The build has no SQLITE_DEBUG (so no
// WHERETRACE), SQLITE_EBCDIC or SQLITE_ENABLE_STAT4.
use {
    base: __core_db_base
    ast: __core_db_ast
    tk: __core_db_tokenize
    util: __core_db_util
    conn: __core_db_conn
    aux: __core_db_vdbeaux
    mem: __core_db_mem
    pg: __core_db_pager
    cg: __core_db_codegen
    cat: __core_db_catalog
    rs: __core_db_resolve
    ex: __core_db_expr
}

// WhereTerm.eOperator (whereInt.h WO_*).
WO_IN: 1
WO_EQ: 2
WO_LT: 16
WO_LE: 8
WO_GT: 4
WO_GE: 32
WO_AUX: 64
WO_IS: 128
WO_ISNULL: 256
WO_OR: 512
WO_AND: 1024
WO_EQUIV: 2048
WO_NOOP: 4096
WO_ROWVAL: 8192
WO_ALL: 16383
WO_SINGLE: 511

// WhereTerm.wtFlags (whereInt.h TERM_*).
TERM_DYNAMIC: 1
TERM_VIRTUAL: 2
TERM_CODED: 4
TERM_COPIED: 8
TERM_ORINFO: 16
TERM_ANDINFO: 32
TERM_OK: 64
TERM_VNULL: 128
TERM_LIKEOPT: 256
TERM_LIKECOND: 512
TERM_LIKE: 1024
TERM_IS: 2048
TERM_VARSELECT: 4096
TERM_HEURTRUTH: 8192
TERM_HIGHTRUTH: 0
TERM_SLICE: 32768

// WhereLoop.wsFlags (whereInt.h WHERE_*).
WHERE_COLUMN_EQ: 1
WHERE_COLUMN_RANGE: 2
WHERE_COLUMN_IN: 4
WHERE_COLUMN_NULL: 8
WHERE_CONSTRAINT: 15
WHERE_TOP_LIMIT: 16
WHERE_BTM_LIMIT: 32
WHERE_BOTH_LIMIT: 48
WHERE_IDX_ONLY: 64
WHERE_IPK: 256
WHERE_INDEXED: 512
WHERE_VIRTUALTABLE: 1024
WHERE_IN_ABLE: 2048
WHERE_ONEROW: 4096
WHERE_MULTI_OR: 8192
WHERE_AUTO_INDEX: 16384
WHERE_SKIPSCAN: 32768
WHERE_UNQ_WANTED: 65536
WHERE_PARTIALIDX: 131072
WHERE_IN_EARLYOUT: 262144
WHERE_BIGNULL_SORT: 524288
WHERE_IN_SEEKSCAN: 1048576
WHERE_TRANSCONS: 2097152
WHERE_BLOOMFILTER: 4194304
WHERE_SELFCULL: 8388608
WHERE_OMIT_OFFSET: 16777216
WHERE_EXPRIDX: 67108864

// WhereLoopBuilder.bldFlags1 and bldFlags2 (whereInt.h SQLITE_BLDF*).
BLDF1_INDEXED: 1
BLDF1_UNIQUE: 2
BLDF2_2NDPASS: 4

// WhereOrSet capacity, the planner's budget (whereInt.h N_OR_COST,
// SQLITE_QUERY_PLANNER_LIMIT, SQLITE_QUERY_PLANNER_LIMIT_INCR).
N_OR_COST: 3
QUERY_PLANNER_LIMIT: 20000
QUERY_PLANNER_LIMIT_INCR: 1000

// WhereInfo.eOnePass (sqliteInt.h ONEPASS_*).
ONEPASS_OFF: 0
ONEPASS_SINGLE: 1
ONEPASS_MULTI: 2

// struct WhereTerm.
WhereTerm: struct {
    expr: Int
    wc: Int
    truth_prob: Int
    wt_flags: Int
    e_operator: Int
    n_child: Int
    e_match_op: Int
    i_parent: Int
    left_cursor: Int
    // u.x.leftColumn and u.x.iField.
    left_column: Int
    i_field: Int
    // u.pOrInfo->wc or u.pAndInfo->wc, -1 for none; u.pOrInfo->indexable.
    sub_wc: Int
    indexable: Int
    prereq_right: Int
    prereq_all: Int
}

// struct WhereClause: pOuter is a clause index (-1 for none), a the terms.
WhereClause: struct {
    outer: Int
    op: Int
    has_or: Bool
    n_base: Int
    a: [Int]
}

// struct WhereMaskSet: ix[i] is the cursor of bit i.
WhereMaskSet: struct {
    b_var_select: Bool
    ix: [Int]
}

// struct InLoop (WhereLevel.u.in.aInLoop).
InLoop: struct {
    i_cur: Int
    addr_in_top: Int
    i_base: Int
    n_prefix: Int
    e_end_loop_op: Int
}

// struct WhereRightJoin.
WhereRightJoin: struct {
    i_match: Int
    reg_bloom: Int
    reg_return: Int
    addr_subrtn: Int
    end_subrtn: Int
}

// struct WhereLevel: pRJ is rj while has_rj, u.in.aInLoop is in_loops,
// u.pCoveringIdx is covering_idx (-1 for none), pWLoop a WhereInfo.loops
// index.
WhereLevel: struct {
    i_left_join: Int
    i_tab_cur: Int
    i_idx_cur: Int
    addr_brk: Int
    addr_nxt: Int
    addr_skip: Int
    addr_cont: Int
    addr_first: Int
    addr_body: Int
    reg_bignull: Int
    addr_bignull: Int
    i_like_rep_cntr: Int
    addr_like_rep: Int
    reg_filter: Int
    has_rj: Bool
    rj: WhereRightJoin
    i_from: Int
    op: Int
    p3: Int
    p5: Int
    p1: Int
    p2: Int
    in_loops: [InLoop]
    covering_idx: Int
    w_loop: Int
    not_ready: Int
}

// struct WhereLoop. The u.btree and u.vtab fields are apart; index is a
// Conn.indexes slot (-1 for none), lterm holds nLSlot term slots (-1 for a
// NULL), the first n_lterm in use, and next is pNextLoop.
WhereLoop: struct {
    prereq: Int
    mask_self: Int
    i_tab: Int
    i_sort_idx: Int
    r_setup: Int
    r_run: Int
    n_out: Int
    n_eq: Int
    n_btm: Int
    n_top: Int
    n_distinct_col: Int
    index: Int
    idx_num: Int
    need_free: Bool
    b_omit_offset: Bool
    is_ordered: Int
    omit_mask: Int
    idx_str: [U8]?
    m_handle_in: Int
    ws_flags: Int
    n_lterm: Int
    n_skip: Int
    lterm: [Int]
    next: Int
}

// struct WherePath: aLoop is loops, by WhereInfo.loops index.
WherePath: struct {
    mask_loop: Int
    rev_loop: Int
    n_row: Int
    r_cost: Int
    r_unsorted: Int
    is_ordered: Int
    loops: [Int]
}

// struct WhereOrCost.
WhereOrCost: struct {
    prereq: Int
    r_run: Int
    n_out: Int
}

// struct WhereOrSet: at most N_OR_COST costs.
WhereOrSet: struct {
    a: [WhereOrCost]
}

// struct WhereInfo: pLoops is p_loops, the head of a list through
// WhereLoop.next over the loops arena (loop_free lists its free slots);
// a[] is levels. pTabList, pOrderBy, pResultSet and pSelect are AST ids.
WhereInfo: struct {
    tab_list: Int
    order_by: Int
    result_set: Int
    select: Int
    ai_cur_one_pass: [Int]
    i_continue: Int
    i_break: Int
    saved_n_query_loop: Int
    wctrl_flags: Int
    i_limit: Int
    n_level: Int
    n_ob_sat: Int
    e_one_pass: Int
    e_distinct: Int
    b_deferred_seek: Bool
    untested_terms: Bool
    b_ordered_inner_loop: Bool
    sorted: Bool
    n_row_out: Int
    i_top: Int
    i_end_where: Int
    p_loops: Int
    loops: [WhereLoop]
    loop_free: [Int]
    rev_mask: Int
    wcs: [WhereClause]
    terms: [WhereTerm]
    mask_set: WhereMaskSet
    levels: [WhereLevel]
}

// A WhereInfo with its sWC (clause 0) initialized and no levels.
where_info_new: fn() -> WhereInfo Never! {
    wi := WhereInfo{
        tab_list: -1
        order_by: -1
        result_set: -1
        select: -1
        ai_cur_one_pass: [Int]{-1, -1}
        i_continue: 0
        i_break: 0
        saved_n_query_loop: 0
        wctrl_flags: 0
        i_limit: 0
        n_level: 0
        n_ob_sat: 0
        e_one_pass: ONEPASS_OFF
        e_distinct: 0
        b_deferred_seek: false
        untested_terms: false
        b_ordered_inner_loop: false
        sorted: false
        n_row_out: 0
        i_top: 0
        i_end_where: 0
        p_loops: -1
        loops: [WhereLoop]{}
        loop_free: [Int]{}
        rev_mask: 0
        wcs: [WhereClause]{}
        terms: [WhereTerm]{}
        mask_set: WhereMaskSet{b_var_select: false, ix: [Int]{}}
        levels: [WhereLevel]{}
    }
    _: clause_init(wi)
    wi
}

// A zeroed WhereLevel.
level_new: fn() -> WhereLevel Never! {
    WhereLevel{i_left_join: 0, i_tab_cur: 0, i_idx_cur: 0, addr_brk: 0, addr_nxt: 0, addr_skip: 0, addr_cont: 0, addr_first: 0, addr_body: 0, reg_bignull: 0, addr_bignull: 0, i_like_rep_cntr: 0, addr_like_rep: 0, reg_filter: 0, has_rj: false, rj: WhereRightJoin{i_match: 0, reg_bloom: 0, reg_return: 0, addr_subrtn: 0, end_subrtn: 0}, i_from: 0, op: 0, p3: 0, p5: 0, p1: 0, p2: 0, in_loops: [InLoop]{}, covering_idx: -1, w_loop: -1, not_ready: 0}
}

// whereLoopInit: an empty loop with the three slots of aLTermSpace.
loop_new: fn() -> WhereLoop Never! {
    WhereLoop{prereq: 0, mask_self: 0, i_tab: 0, i_sort_idx: 0, r_setup: 0, r_run: 0, n_out: 0, n_eq: 0, n_btm: 0, n_top: 0, n_distinct_col: 0, index: -1, idx_num: 0, need_free: false, b_omit_offset: false, is_ordered: 0, omit_mask: 0, idx_str: None, m_handle_in: 0, ws_flags: 0, n_lterm: 0, n_skip: 0, lterm: [Int]{-1, -1, -1}, next: -1}
}

// ---------------------------------------------------------------------------
// Cursor bitmasks (where.c).

// sqlite3WhereGetMask: the bit of cursor i_cursor, 0 when it has none.
get_mask: fn(ms: WhereMaskSet, i_cursor: Int) -> Int Never! {
    n: ms.ix.len()
    if n == 0 -> return 0
    if ms.ix[0] == i_cursor -> return 1
    loop i in 1..<n {
        if ms.ix[i] == i_cursor -> return 1 << i
    }
    0
}

// createMask.
create_mask: fn(ms: &WhereMaskSet, i_cursor: Int) Never! { ms.ix.push(i_cursor) }

// sqlite3WhereExprUsageFull.
expr_usage_full: fn(ms: &WhereMaskSet, a: ast.AST, e: Int) -> Int Never! {
    x: a.exprs[e]
    mask := if x.op == tk.TK_IF_NULL_ROW -> get_mask(ms, x.itable) else -> 0
    if x.left >= 0 -> mask = mask.bit_or(expr_usage_nn(ms, a, x.left))
    if x.right >= 0 {
        mask = mask.bit_or(expr_usage_nn(ms, a, x.right))
    } else if x.flags.bit_and(ast.EP_X_IS_SELECT) != 0 {
        if x.flags.bit_and(ast.EP_VAR_SELECT) != 0 -> ms.b_var_select = true
        mask = mask.bit_or(expr_select_usage(ms, a, x.x))
    } else if x.x >= 0 {
        mask = mask.bit_or(expr_list_usage(ms, a, x.x))
    }
    if (x.op == tk.TK_FUNCTION || x.op == tk.TK_AGG_FUNCTION) && x.flags.bit_and(ast.EP_WIN_FUNC) != 0 {
        w: a.windows[x.y]
        mask = mask.bit_or(expr_list_usage(ms, a, w.partition))
        mask = mask.bit_or(expr_list_usage(ms, a, w.order_by))
        mask = mask.bit_or(expr_usage(ms, a, w.filter))
    }
    mask
}

// sqlite3WhereExprUsageNN: the tables expression `e` (not NULL) uses.
expr_usage_nn: fn(ms: &WhereMaskSet, a: ast.AST, e: Int) -> Int Never! {
    if a.exprs[e].op == tk.TK_COLUMN && !ast.has(a, e, ast.EP_FIXED_COL) -> return get_mask(ms, a.exprs[e].itable)
    if ast.has(a, e, ast.EP_TOKEN_ONLY.bit_or(ast.EP_LEAF)) -> return 0
    expr_usage_full(ms, a, e)
}

// sqlite3WhereExprUsage.
expr_usage: fn(ms: &WhereMaskSet, a: ast.AST, e: Int) -> Int Never! {
    if e < 0 -> return 0
    expr_usage_nn(ms, a, e)
}

// sqlite3WhereExprListUsage.
expr_list_usage: fn(ms: &WhereMaskSet, a: ast.AST, list: Int) -> Int Never! {
    mask := 0
    loop i in 0..<ast.list_len(a, list) -> mask = mask.bit_or(expr_usage(ms, a, ast.list_expr(a, list, i)))
    mask
}

// exprSelectUsage: the tables a SELECT and its compound chain use.
expr_select_usage: fn(ms: &WhereMaskSet, a: ast.AST, s0: Int) -> Int Never! {
    mask := 0
    s := s0
    loop s >= 0 {
        sel: a.selects[s]
        mask = mask.bit_or(expr_list_usage(ms, a, sel.elist))
        mask = mask.bit_or(expr_list_usage(ms, a, sel.group_by))
        mask = mask.bit_or(expr_list_usage(ms, a, sel.order_by))
        mask = mask.bit_or(expr_usage(ms, a, sel.where_expr))
        mask = mask.bit_or(expr_usage(ms, a, sel.having))
        loop i in 0..<ast.src_len(a, sel.src) {
            item: a.items[ast.src_item(a, sel.src, i)]
            mask = mask.bit_or(expr_select_usage(ms, a, item.select))
            if !item.is_using -> mask = mask.bit_or(expr_usage(ms, a, item.u3))
            if item.is_tab_func -> mask = mask.bit_or(expr_list_usage(ms, a, item.func_arg))
        }
        s = sel.prior
    }
    mask
}

// ---------------------------------------------------------------------------
// Clauses and terms.

// sqlite3WhereClauseInit: a new empty clause; its index.
clause_init: fn(wi: &WhereInfo) -> Int Never! {
    wi.wcs.push(WhereClause{outer: -1, op: 0, has_or: false, n_base: 0, a: [Int]{}})
    wi.wcs.len() - 1
}

// The number of terms of clause wc (WhereClause.nTerm).
n_term: fn(wi: WhereInfo, wc: Int) -> Int Never! { wi.wcs[wc].a.len() }

// &pWC->a[i]: the arena index of term i of clause wc.
term_at: fn(wi: WhereInfo, wc: Int, i: Int) -> Int Never! { wi.wcs[wc].a[i] }

// pTerm->wtFlags |= f.
add_wt_flags: fn(wi: &WhereInfo, t: Int, f: Int) Never! { wi.terms[t].wt_flags = wi.terms[t].wt_flags.bit_or(f) }

// whereClauseInsert: a new term of clause wc for expression `e`; its index
// in the clause.
clause_insert: fn(wi: &WhereInfo, a: ast.AST, wc: Int, e: Int, wt_flags: Int) -> Int Never! {
    idx: wi.wcs[wc].a.len()
    if wt_flags.bit_and(TERM_VIRTUAL) == 0 -> wi.wcs[wc].n_base = idx + 1
    truth_prob: if e >= 0 && ast.has(a, e, ast.EP_UNLIKELY) -> util.log_est(a.exprs[e].itable) - 270 else -> 1
    wi.terms.push(WhereTerm{expr: ast.skip_collate_and_likely(a, e), wc: wc, truth_prob: truth_prob, wt_flags: wt_flags, e_operator: 0, n_child: 0, e_match_op: 0, i_parent: 0, left_cursor: 0, left_column: 0, i_field: 0, sub_wc: -1, indexable: 0, prereq_right: 0, prereq_all: 0})
    wi.wcs[wc].a.push(wi.terms.len() - 1)
    idx
}

// allowedOp: =, <, >, <=, >=, IN, IS and IS NULL can drive an index.
allowed_op: fn(op: Int) -> Bool Never! {
    op == tk.TK_IN || (op >= tk.TK_EQ && op <= tk.TK_GE) || op == tk.TK_ISNULL || op == tk.TK_IS
}

// exprCommute: "X op Y" becomes "Y op X"; 0.
expr_commute: fn(p: &cg.Parse, a: &ast.AST, e: Int) -> Int Never! {
    l: a.exprs[e].left
    r: a.exprs[e].right
    if a.exprs[l].op == tk.TK_VECTOR || a.exprs[r].op == tk.TK_VECTOR || ex.binary_compare_coll_seq(p, a, l, r) != ex.binary_compare_coll_seq(p, a, r, l) {
        a.exprs[e].flags = a.exprs[e].flags.bit_xor(ast.EP_COMMUTED)
    }
    a.exprs[e].left = r
    a.exprs[e].right = l
    op: a.exprs[e].op
    if op >= tk.TK_GT -> a.exprs[e].op = (op - tk.TK_GT).bit_xor(2) + tk.TK_GT
    0
}

// operatorMask: the WO_* bit of an allowed operator.
operator_mask: fn(op: Int) -> Int Never! {
    if op == tk.TK_IN -> return WO_IN
    if op == tk.TK_ISNULL -> return WO_ISNULL
    if op == tk.TK_IS -> return WO_IS
    WO_EQ << (op - tk.TK_EQ)
}

// sqlite3IsLikeFunction (func.c): whether function call `e` is a LIKE or
// GLOB, its wildcards (matchAll, matchOne, matchSet, then the escape, 0 for
// none) and whether case is insignificant.
is_like_function: fn(db: conn.Conn, a: ast.AST, e: Int) -> (ok: Bool, no_case: Bool, wc: [Int]) Never! {
    list: a.exprs[e].x
    if list < 0 -> return (ok: false, no_case: false, wc: [Int]{})
    n_expr: ast.list_len(a, list)
    def := cat.find_function(db, a.exprs[e].token ?? [U8]{}, n_expr, base.UTF8) ?? return (ok: false, no_case: false, wc: [Int]{})
    if def.flags.bit_and(conn.FUNC_LIKE) == 0 -> return (ok: false, no_case: false, wc: [Int]{})
    wc := if def.user_data == cat.LIKE_INFO_GLOB -> [Int]{42, 63, 91, 0} else -> [Int]{37, 95, 0, 0}
    if n_expr >= 3 {
        esc: ast.list_expr(a, list, 2)
        if a.exprs[esc].op != tk.TK_STRING -> return (ok: false, no_case: false, wc: [Int]{})
        z: a.exprs[esc].token ?? [U8]{}
        c0: util.sql_byte(z, 0)
        if c0 == 0 || util.sql_byte(z, 1) != 0 -> return (ok: false, no_case: false, wc: [Int]{})
        if c0 == wc[0] || c0 == wc[1] -> return (ok: false, no_case: false, wc: [Int]{})
        wc[3] = c0
    }
    (ok: true, no_case: def.flags.bit_and(conn.FUNC_CASE) == 0, wc: wc)
}

// isLikeOrGlob: whether LIKE or GLOB call `e` can be optimized with
// inequality constraints: then the TK_STRING of its pattern prefix, whether
// the pattern ends with its only wildcard (complete) and whether case is
// insignificant.
is_like_or_glob: fn(p: &cg.Parse, a: &ast.AST, e: Int) -[DB]> (ok: Bool, prefix: Int, complete: Bool, no_case: Bool) Never! {
    lf: is_like_function(p.db, a, e)
    if !lf.ok -> return (ok: false, prefix: -1, complete: false, no_case: false)
    wc: lf.wc
    list: a.exprs[e].x
    left: ast.list_expr(a, list, 1)
    right: ast.skip_collate(a, ast.list_expr(a, list, 0))
    op: a.exprs[right].op
    z := [U8]{}
    has_z := false
    if op == tk.TK_VARIABLE && p.db.flags.bit_and(conn.SQLITE_ENABLE_QPSG) == 0 {
        i_col: a.exprs[right].icolumn
        if i_col >= 1 && i_col <= p.reprepare_vars.len() && p.reprepare_vars[i_col - 1].flags.bit_and(base.MEM_NULL) == 0 {
            pv := mem.mem_copy(p.reprepare_vars[i_col - 1])
            if base.value_type(pv) == base.SQL_TEXT {
                _: mem.value_text(pv, base.UTF8)
                z = pg.c_string(pv.z)
                has_z = true
            }
        }
        aux.set_varmask(p.f.v, i_col)
    } else if op == tk.TK_STRING {
        z = pg.c_string(a.exprs[right].token ?? [U8]{})
        has_z = true
    }
    if !has_z -> return (ok: false, prefix: -1, complete: false, no_case: false)
    // The prefix before the first wildcard.
    cnt := 0
    c := 0
    loop {
        c = util.sql_byte(z, cnt)
        if c == 0 || c == wc[0] || c == wc[1] || c == wc[2] -> break
        cnt += 1
        if c == wc[3] && util.sql_byte(z, cnt) != 0 -> cnt += 1
    }
    if !((cnt > 1 || (cnt > 0 && util.sql_byte(z, 0) != wc[3])) && util.sql_byte(z, cnt - 1) != 255) {
        return (ok: false, prefix: -1, complete: false, no_case: false)
    }
    complete: c == wc[0] && util.sql_byte(z, cnt + 1) == 0
    // The prefix with its escapes removed.
    znew := [U8]{}
    i := 0
    loop i < cnt {
        if util.sql_byte(z, i) == wc[3] -> i += 1
        znew.push(U8{util.sql_byte(z, i)})
        i += 1
    }
    i_to: znew.len()
    // Unless the LHS is an ordinary column of TEXT affinity, neither end
    // of the prefix range may look like a number.
    lt: a.exprs[left].y
    if a.exprs[left].op != tk.TK_COLUMN || ex.expr_affinity(p.db, a, left) != base.AFF_TEXT || (lt >= 0 && ex.is_virtual(p.db, lt)) {
        is_num := util.atof(znew, base.UTF8).kind
        if is_num <= 0 {
            if i_to == 1 && (Int{znew[0]}) == 45 {
                is_num = 1
            } else {
                bumped := znew.copy()
                bumped[i_to - 1] = U8{(Int{znew[i_to - 1]} + 1).bit_and(255)}
                is_num = util.atof(bumped, base.UTF8).kind
            }
        }
        if is_num > 0 -> return (ok: false, prefix: -1, complete: false, no_case: false)
    }
    prefix: ast.expr(a, tk.TK_STRING, pg.c_string(znew))
    // A bound pattern: reprepare when it is rebound.
    if op == tk.TK_VARIABLE {
        aux.set_varmask(p.f.v, a.exprs[right].icolumn)
        if complete && util.sql_byte(a.exprs[right].token ?? [U8]{}, 1) != 0 {
            // No OP_Variable would be coded for it, which
            // sqlite3_bind_parameter_name needs: code a dummy one.
            r1: cg.get_temp_reg(p)
            _: ex.expr_code_target(p, a, right, r1)
            addr: cg.v_current_addr(p)
            cg.v_change_p3(p, addr - 1, 0)
            cg.release_temp_reg(p, r1)
        }
    }
    (ok: true, prefix: prefix, complete: complete, no_case: lf.no_case)
}

// ExprIsVtab: a column of a virtual table.
expr_is_vtab: fn(db: conn.Conn, a: ast.AST, x: Int) -> Bool Never! {
    a.exprs[x].op == tk.TK_COLUMN && a.exprs[x].y >= 0 && ex.is_virtual(db, a.exprs[x].y)
}

// isAuxiliaryVtabOperator: whether `e` is "column OP expr" with OP one of
// the operators virtual tables see but the planner does not otherwise use:
// 1 or 2 (2 when both sides are virtual table columns), with the
// SQLITE_INDEX_CONSTRAINT_* op2, the column and the expression; 0 if not.
is_auxiliary_vtab_operator: fn(p: &cg.Parse, a: &ast.AST, e: Int) -[DB]> (n: Int, op2: Int, left: Int, right: Int) Never! {
    op: a.exprs[e].op
    if op == tk.TK_FUNCTION {
        list: a.exprs[e].x
        if list < 0 || ast.list_len(a, list) != 2 -> return (n: 0, op2: 0, left: -1, right: -1)
        tok: a.exprs[e].token ?? [U8]{}
        col: ast.list_expr(a, list, 1)
        if expr_is_vtab(p.db, a, col) {
            names: [String]{"match", "glob", "like", "regexp"}
            ops: [Int]{conn.INDEX_CONSTRAINT_MATCH, conn.INDEX_CONSTRAINT_GLOB, conn.INDEX_CONSTRAINT_LIKE, conn.INDEX_CONSTRAINT_REGEXP}
            loop i in 0..<4 {
                if util.str_icmp(tok, names[i].bytes()) == 0 -> return (n: 1, op2: ops[i], left: col, right: ast.list_expr(a, list, 0))
            }
        }
        col0: ast.list_expr(a, list, 0)
        if expr_is_vtab(p.db, a, col0) {
            g := p.up
            i: g.vtab_find_function(p, a, a.exprs[col0].y, 2, tok)
            if i >= conn.INDEX_CONSTRAINT_FUNCTION -> return (n: 1, op2: i.bit_and(255), left: col0, right: ast.list_expr(a, list, 1))
        }
    } else if op == tk.TK_NE || op == tk.TK_ISNOT || op == tk.TK_NOTNULL {
        res := 0
        l := a.exprs[e].left
        r := a.exprs[e].right
        if expr_is_vtab(p.db, a, l) -> res += 1
        if r >= 0 && expr_is_vtab(p.db, a, r) {
            res += 1
            sw: l
            l = r
            r = sw
        }
        op2 := conn.INDEX_CONSTRAINT_NE
        if op == tk.TK_ISNOT -> op2 = conn.INDEX_CONSTRAINT_ISNOT
        if op == tk.TK_NOTNULL -> op2 = conn.INDEX_CONSTRAINT_ISNOTNULL
        return (n: res, op2: op2, left: l, right: r)
    }
    (n: 0, op2: 0, left: -1, right: -1)
}

// transferJoinMarkings: `derived`, from the ON or USING clause `base_e`
// came from, carries its join markings.
transfer_join_markings: fn(a: &ast.AST, derived: Int, base_e: Int) Never! {
    jf: ast.EP_OUTER_ON.bit_or(ast.EP_INNER_ON)
    if derived >= 0 && ast.has(a, base_e, jf) {
        a.exprs[derived].flags = a.exprs[derived].flags.bit_or(a.exprs[base_e].flags.bit_and(jf))
        a.exprs[derived].w = a.exprs[base_e].w
    }
}

// markTermAsChild: term i_child of clause wc is a child of its term
// i_parent. nChild is a u8.
mark_term_as_child: fn(wi: &WhereInfo, wc: Int, i_child: Int, i_parent: Int) Never! {
    c: wi.wcs[wc].a[i_child]
    pa: wi.wcs[wc].a[i_parent]
    wi.terms[c].i_parent = i_parent
    wi.terms[c].truth_prob = wi.terms[pa].truth_prob
    wi.terms[pa].n_child = (wi.terms[pa].n_child + 1).bit_and(255)
}

// whereNthSubterm: the N-th AND-connected subterm of term t (t itself for
// N 0 when it is no conjunction), -1 past the end.
where_nth_subterm: fn(wi: WhereInfo, t: Int, n: Int) -> Int Never! {
    if wi.terms[t].e_operator != WO_AND {
        if n == 0 -> return t
        return -1
    }
    sw: wi.terms[t].sub_wc
    if n >= wi.wcs[sw].a.len() -> return -1
    wi.wcs[sw].a[n]
}

// whereCombineDisjuncts: "A op1 B OR A op2 B" with compatible operators
// adds the virtual term "A op B" combining them to clause wc.
where_combine_disjuncts: fn(p: &cg.Parse, a: &ast.AST, wi: &WhereInfo, src: Int, wc: Int, one: Int, two: Int) Never! -[DB]> {
    e_op := wi.terms[one].e_operator.bit_or(wi.terms[two].e_operator)
    if wi.terms[one].wt_flags.bit_or(wi.terms[two].wt_flags).bit_and(TERM_VNULL) != 0 -> return
    cmp: WO_EQ.bit_or(WO_LT).bit_or(WO_LE).bit_or(WO_GT).bit_or(WO_GE)
    if wi.terms[one].e_operator.bit_and(cmp) == 0 -> return
    if wi.terms[two].e_operator.bit_and(cmp) == 0 -> return
    lo: WO_EQ.bit_or(WO_LT).bit_or(WO_LE)
    hi: WO_EQ.bit_or(WO_GT).bit_or(WO_GE)
    if e_op.bit_and(lo) != e_op && e_op.bit_and(hi) != e_op -> return
    e1: wi.terms[one].expr
    e2: wi.terms[two].expr
    if ast.expr_compare(a, a.exprs[e1].left, a.exprs[e2].left, -1) != 0 -> return
    if ast.expr_compare(a, a.exprs[e1].right, a.exprs[e2].right, -1) != 0 -> return
    if e_op.bit_and(e_op - 1) != 0 {
        e_op = if e_op.bit_and(WO_LT.bit_or(WO_LE)) != 0 -> WO_LE else -> WO_GE
    }
    ne: ast.expr_dup(a, e1, 0)
    op := tk.TK_EQ
    loop e_op != (WO_EQ << (op - tk.TK_EQ)) -> op += 1
    a.exprs[ne].op = op
    idx_new: clause_insert(wi, a, wc, ne, TERM_VIRTUAL.bit_or(TERM_DYNAMIC))
    expr_analyze(p, a, wi, src, wc, idx_new)
}

// sqlite3ExprCompare with the Parse: a bound parameter can match a literal
// under the statement being reprepared.
expr_compare_p: fn(p: &cg.Parse, a: &ast.AST, x: Int, y: Int, i_tab: Int) -> Int Never! {
    m := ex.ParseVarMatch{vars: p.reprepare_vars, used: [Int]{}}
    r: ast.expr_compare_with<ex.ParseVarMatch>(m, a, x, y, i_tab)
    loop i in m.used -> aux.set_varmask(p.f.v, i)
    r
}

// exprAnalyzeOrTerm: analyze OR term idx_term of clause wc: its subterms go
// to a new clause, and the term may gain an equivalent IN term (case 1), a
// combined conjunct (case 2) or the tables it is indexable on (case 3).
expr_analyze_or_term: fn(p: &cg.Parse, a: &ast.AST, wi: &WhereInfo, src: Int, wc: Int, idx_term: Int) Never! -[DB]> {
    t: wi.wcs[wc].a[idx_term]
    e: wi.terms[t].expr
    or_wc: clause_init(wi)
    wi.terms[t].sub_wc = or_wc
    wi.terms[t].indexable = 0
    add_wt_flags(wi, t, TERM_ORINFO)
    where_split(wi, a, or_wc, e, tk.TK_OR)
    where_expr_analyze(p, a, wi, src, or_wc)
    if p.db.malloc_failed -> return
    // The tables that might satisfy cases 1 and 3.
    indexable := rs.ALLBITS
    chng_to_in := rs.ALLBITS
    n_or: wi.wcs[or_wc].a.len()
    k := 0
    loop k < n_or && indexable != 0 {
        ot: wi.wcs[or_wc].a[k]
        if wi.terms[ot].e_operator.bit_and(WO_SINGLE) == 0 {
            chng_to_in = 0
            and_wc: clause_init(wi)
            wi.terms[ot].sub_wc = and_wc
            add_wt_flags(wi, ot, TERM_ANDINFO)
            wi.terms[ot].e_operator = WO_AND
            wi.terms[ot].left_cursor = -1
            where_split(wi, a, and_wc, wi.terms[ot].expr, tk.TK_AND)
            where_expr_analyze(p, a, wi, src, and_wc)
            wi.wcs[and_wc].outer = wc
            b := 0
            if !p.db.malloc_failed {
                loop j in 0..<wi.wcs[and_wc].a.len() {
                    at: wi.wcs[and_wc].a[j]
                    if allowed_op(a.exprs[wi.terms[at].expr].op) || wi.terms[at].e_operator == WO_AUX {
                        b = b.bit_or(get_mask(wi.mask_set, wi.terms[at].left_cursor))
                    }
                }
            }
            indexable = indexable.bit_and(b)
        } else if wi.terms[ot].wt_flags.bit_and(TERM_COPIED) != 0 {
            // Revisited with the TERM_VIRTUAL term it was copied to.
        } else {
            b := get_mask(wi.mask_set, wi.terms[ot].left_cursor)
            if wi.terms[ot].wt_flags.bit_and(TERM_VIRTUAL) != 0 {
                other: wi.wcs[or_wc].a[wi.terms[ot].i_parent]
                b = b.bit_or(get_mask(wi.mask_set, wi.terms[other].left_cursor))
            }
            indexable = indexable.bit_and(b)
            if wi.terms[ot].e_operator.bit_and(WO_EQ) == 0 {
                chng_to_in = 0
            } else {
                chng_to_in = chng_to_in.bit_and(b)
            }
        }
        k += 1
    }
    // Case 3: the tables the term is indexable on (maybe none).
    wi.terms[t].indexable = indexable
    wi.terms[t].e_operator = WO_OR
    wi.terms[t].left_cursor = -1
    if indexable != 0 -> wi.wcs[wc].has_or = true
    // Case 2, for a two-way OR.
    if indexable != 0 && wi.wcs[or_wc].a.len() == 2 {
        i_one := 0
        loop {
            one: where_nth_subterm(wi, wi.wcs[or_wc].a[0], i_one)
            i_one += 1
            if one < 0 -> break
            i_two := 0
            loop {
                two: where_nth_subterm(wi, wi.wcs[or_wc].a[1], i_two)
                i_two += 1
                if two < 0 -> break
                where_combine_disjuncts(p, a, wi, src, wc, one, two)
            }
        }
    }
    // Case 1: chng_to_in holds the (0, 1 or 2) tables that might give
    // every subterm the form "table.column = expr" for one column.
    if chng_to_in == 0 -> return
    ok_to_chng := false
    i_column := -1
    i_cursor := -1
    n: wi.wcs[or_wc].a.len()
    j := 0
    loop j < 2 && !ok_to_chng {
        left := -1
        ki := 0
        i := n - 1
        // A table and column on one side of the == of a subterm.
        loop i >= 0 {
            ot: wi.wcs[or_wc].a[ki]
            wi.terms[ot].wt_flags = util.clear_bits(wi.terms[ot].wt_flags, TERM_OK)
            if wi.terms[ot].left_cursor == i_cursor || chng_to_in.bit_and(get_mask(wi.mask_set, wi.terms[ot].left_cursor)) == 0 {
                // The 2-bit case's term from the first pass, or a
                // "t1.a == t2.b" whose inverted copy serves instead.
                i -= 1
                ki += 1
                next
            }
            i_column = wi.terms[ot].left_column
            i_cursor = wi.terms[ot].left_cursor
            left = a.exprs[wi.terms[ot].expr].left
            break
        }
        if i < 0 -> break
        // Whether every subterm uses that table and column.
        ok_to_chng = true
        loop i >= 0 && ok_to_chng {
            ot: wi.wcs[or_wc].a[ki]
            ote: wi.terms[ot].expr
            if wi.terms[ot].left_cursor != i_cursor {
                wi.terms[ot].wt_flags = util.clear_bits(wi.terms[ot].wt_flags, TERM_OK)
            } else if wi.terms[ot].left_column != i_column || (i_column == conn.XN_EXPR && expr_compare_p(p, a, a.exprs[ote].left, left, -1) != 0) {
                ok_to_chng = false
            } else {
                // A column on the right too must need no conversion.
                aff_right: ex.expr_affinity(p.db, a, a.exprs[ote].right)
                aff_left: ex.expr_affinity(p.db, a, a.exprs[ote].left)
                if aff_right != 0 && aff_right != aff_left {
                    ok_to_chng = false
                } else {
                    add_wt_flags(wi, ot, TERM_OK)
                }
            }
            i -= 1
            ki += 1
        }
        j += 1
    }
    if !ok_to_chng -> return
    // The virtual term of the OR as an IN operator.
    list := -1
    lhs := -1
    loop ki in 0..<n {
        ot: wi.wcs[or_wc].a[ki]
        if wi.terms[ot].wt_flags.bit_and(TERM_OK) == 0 -> next
        ote: wi.terms[ot].expr
        dup: ast.expr_dup(a, a.exprs[ote].right, 0)
        list = ast.expr_list_append(a, list, dup)
        lhs = a.exprs[ote].left
    }
    dup_l: ast.expr_dup(a, lhs, 0)
    ne: ast.pexpr(a, tk.TK_IN, dup_l, -1)
    transfer_join_markings(a, ne, e)
    a.exprs[ne].x = list
    idx_new: clause_insert(wi, a, wc, ne, TERM_VIRTUAL.bit_or(TERM_DYNAMIC))
    expr_analyze(p, a, wi, src, wc, idx_new)
    mark_term_as_child(wi, wc, idx_new, idx_term)
}

// termIsEquivalence: whether "A == B" (both columns) lets B stand in for A
// anywhere else in the WHERE clause.
term_is_equivalence: fn(p: &cg.Parse, a: &ast.AST, e: Int) -> Bool Never! {
    if !cg.opt_enabled(p, cg.OPT_TRANSITIVE) -> return false
    op: a.exprs[e].op
    if op != tk.TK_EQ && op != tk.TK_IS -> return false
    if ast.has(a, e, ast.EP_OUTER_ON) -> return false
    aff1: ex.expr_affinity(p.db, a, a.exprs[e].left)
    aff2: ex.expr_affinity(p.db, a, a.exprs[e].right)
    if aff1 != aff2 && (aff1 < base.AFF_NUMERIC || aff2 < base.AFF_NUMERIC) -> return false
    coll: ex.expr_compare_coll_seq(p, a, e)
    if ex.is_binary(coll) -> return true
    ex.expr_coll_seq_match(p, a, a.exprs[e].left, a.exprs[e].right)
}

// exprMightBeIndexed2: whether `e` is a key expression of an index on a
// table of FROM list `src` from item j0 on: its cursor and XN_EXPR.
might_be_indexed2: fn(db: conn.Conn, a: &ast.AST, src: Int, e: Int, j0: Int) -> (ok: Bool, cur: Int, col: Int) Never! {
    j := j0
    loop {
        si: ast.src_item(a, src, j)
        i_cur: a.items[si].cursor
        ix := db.tables[a.items[si].tab].index
        loop ix >= 0 {
            ce_list: db.indexes[ix].col_expr
            if ce_list >= 0 {
                loop i in 0..<db.indexes[ix].n_key_col {
                    if db.indexes[ix].ai_column[i] != conn.XN_EXPR -> next
                    ce: ast.list_expr(a, ce_list, i)
                    if ast.expr_compare_skip(a, e, ce, i_cur) == 0 && a.exprs[e].op != tk.TK_STRING -> return (ok: true, cur: i_cur, col: conn.XN_EXPR)
                }
            }
            ix = db.indexes[ix].next
        }
        j += 1
        if j >= ast.src_len(a, src) -> break
    }
    (ok: false, cur: 0, col: 0)
}

// exprMightBeIndexed: whether comparison operand `e0` might be indexed: a
// column always is (an automatic index may come later); its cursor and
// column (XN_EXPR for an indexed expression).
might_be_indexed: fn(db: conn.Conn, a: &ast.AST, src: Int, e0: Int, op: Int) -> (ok: Bool, cur: Int, col: Int) Never! {
    e := e0
    if a.exprs[e].op == tk.TK_VECTOR && op >= tk.TK_GT && op <= tk.TK_GE -> e = ast.list_expr(a, a.exprs[e].x, 0)
    if a.exprs[e].op == tk.TK_COLUMN -> return (ok: true, cur: a.exprs[e].itable, col: a.exprs[e].icolumn)
    loop i in 0..<ast.src_len(a, src) {
        ix := db.tables[a.items[ast.src_item(a, src, i)].tab].index
        loop ix >= 0 {
            if db.indexes[ix].col_expr >= 0 -> return might_be_indexed2(db, a, src, e, i)
            ix = db.indexes[ix].next
        }
    }
    (ok: false, cur: 0, col: 0)
}

// exprAnalyze: fill in term idx_term of clause wc from its expression,
// commuting "<expr> op X" to "X op <expr>" and adding the virtual terms
// that BETWEEN, OR, IS NOT NULL, LIKE, vector comparisons and virtual table
// operators imply.
expr_analyze: fn(p: &cg.Parse, a: &ast.AST, wi: &WhereInfo, src: Int, wc: Int, idx_term: Int) Never! -[DB]> {
    if p.db.malloc_failed -> return
    t: wi.wcs[wc].a[idx_term]
    e: wi.terms[t].expr
    wi.mask_set.b_var_select = false
    prereq_left: expr_usage(wi.mask_set, a, a.exprs[e].left)
    op: a.exprs[e].op
    prereq_all := 0
    if op == tk.TK_IN {
        if ex.expr_check_in(p, a, e) -> return
        x: a.exprs[e].x
        wi.terms[t].prereq_right = if ast.has(a, e, ast.EP_X_IS_SELECT) -> expr_select_usage(wi.mask_set, a, x) else -> expr_list_usage(wi.mask_set, a, x)
        prereq_all = prereq_left.bit_or(wi.terms[t].prereq_right)
    } else {
        wi.terms[t].prereq_right = expr_usage(wi.mask_set, a, a.exprs[e].right)
        if a.exprs[e].left < 0 || ast.has(a, e, ast.EP_X_IS_SELECT.bit_or(ast.EP_IF_NULL_ROW)) || a.exprs[e].x >= 0 {
            prereq_all = expr_usage_nn(wi.mask_set, a, e)
        } else {
            prereq_all = prereq_left.bit_or(wi.terms[t].prereq_right)
        }
    }
    if wi.mask_set.b_var_select -> add_wt_flags(wi, t, TERM_VARSELECT)
    extra_right := 0
    if ast.has(a, e, ast.EP_OUTER_ON.bit_or(ast.EP_INNER_ON)) {
        x: get_mask(wi.mask_set, a.exprs[e].w)
        if ast.has(a, e, ast.EP_OUTER_ON) {
            prereq_all = prereq_all.bit_or(x)
            // ON clause terms may not use an index on the left table of a
            // LEFT JOIN (ticket #3015).
            extra_right = if x == 0 -> rs.ALLBITS else -> x - 1
            if (prereq_all >> 1) >= x {
                ast.error(a, "ON clause references tables to its right")
                return
            }
        } else if (prereq_all >> 1) >= x {
            // An INNER JOIN's ON clause referring to a table to its right
            // is an error only in a query with a RIGHT or FULL JOIN.
            if ast.src_len(a, src) > 0 && a.items[ast.src_item(a, src, 0)].jointype.bit_and(ast.JT_LTORJ) != 0 {
                ast.error(a, "ON clause references tables to its right")
                return
            }
            ast.clear_flags(a, e, ast.EP_INNER_ON)
        }
    }
    wi.terms[t].prereq_all = prereq_all
    wi.terms[t].left_cursor = -1
    wi.terms[t].i_parent = -1
    wi.terms[t].e_operator = 0
    if allowed_op(op) {
        left := ast.skip_collate(a, a.exprs[e].left)
        right: ast.skip_collate(a, a.exprs[e].right)
        op_mask: if wi.terms[t].prereq_right.bit_and(prereq_left) == 0 -> WO_ALL else -> WO_EQUIV
        if wi.terms[t].i_field > 0 -> left = ast.list_expr(a, a.exprs[left].x, wi.terms[t].i_field - 1)
        ml: might_be_indexed(p.db, a, src, left, op)
        if ml.ok {
            wi.terms[t].left_cursor = ml.cur
            wi.terms[t].left_column = ml.col
            wi.terms[t].e_operator = operator_mask(op).bit_and(op_mask)
        }
        if op == tk.TK_IS -> add_wt_flags(wi, t, TERM_IS)
        mr := (ok: false, cur: 0, col: 0)
        if right >= 0 -> mr = might_be_indexed(p.db, a, src, right, op)
        if right >= 0 && mr.ok && !ast.has(a, right, ast.EP_FIXED_COL) {
            e_extra_op := 0
            dup := e
            nt := t
            if wi.terms[t].left_cursor >= 0 {
                dup = ast.expr_dup(a, e, 0)
                if p.db.malloc_failed -> return
                idx_new: clause_insert(wi, a, wc, dup, TERM_VIRTUAL.bit_or(TERM_DYNAMIC))
                nt = wi.wcs[wc].a[idx_new]
                mark_term_as_child(wi, wc, idx_new, idx_term)
                if op == tk.TK_IS -> add_wt_flags(wi, nt, TERM_IS)
                add_wt_flags(wi, t, TERM_COPIED)
                if term_is_equivalence(p, a, dup) {
                    wi.terms[t].e_operator = wi.terms[t].e_operator.bit_or(WO_EQUIV)
                    e_extra_op = WO_EQUIV
                }
            }
            add_wt_flags(wi, nt, expr_commute(p, a, dup))
            wi.terms[nt].left_cursor = mr.cur
            wi.terms[nt].left_column = mr.col
            wi.terms[nt].prereq_right = prereq_left.bit_or(extra_right)
            wi.terms[nt].prereq_all = prereq_all
            wi.terms[nt].e_operator = (operator_mask(a.exprs[dup].op) + e_extra_op).bit_and(op_mask)
        } else if op == tk.TK_ISNULL && !ast.has(a, e, ast.EP_OUTER_ON) && !rs.expr_can_be_null(p.db, a, left) {
            // tag-20230504-1: "x IS NULL" of a NOT NULL x is false.
            a.exprs[e].op = tk.TK_TRUEFALSE
            a.exprs[e].token = Val("false".bytes())
            ast.set_flags(a, e, ast.EP_IS_FALSE)
            wi.terms[t].prereq_all = 0
            wi.terms[t].e_operator = 0
        }
    } else if op == tk.TK_BETWEEN && wi.wcs[wc].op == tk.TK_AND {
        // "a BETWEEN b AND c" adds the virtual children "a >= b" and
        // "a <= c".
        list: a.exprs[e].x
        ops: [Int]{tk.TK_GE, tk.TK_LE}
        loop i in 0..<2 {
            l: ast.expr_dup(a, a.exprs[e].left, 0)
            bound: ast.list_expr(a, list, i)
            r: ast.expr_dup(a, bound, 0)
            ne: ast.pexpr(a, ops[i], l, r)
            transfer_join_markings(a, ne, e)
            idx_new: clause_insert(wi, a, wc, ne, TERM_VIRTUAL.bit_or(TERM_DYNAMIC))
            expr_analyze(p, a, wi, src, wc, idx_new)
            mark_term_as_child(wi, wc, idx_new, idx_term)
        }
    } else if op == tk.TK_OR {
        expr_analyze_or_term(p, a, wi, src, wc, idx_term)
    } else if op == tk.TK_NOTNULL {
        // "x IS NOT NULL" of a column that is no INTEGER PRIMARY KEY adds
        // the virtual term "x > NULL".
        l: a.exprs[e].left
        if a.exprs[l].op == tk.TK_COLUMN && a.exprs[l].icolumn >= 0 && !ast.has(a, e, ast.EP_OUTER_ON) {
            dl: ast.expr_dup(a, l, 0)
            nul: ast.expr_alloc(a, tk.TK_NULL, None, false)
            ne: ast.pexpr(a, tk.TK_GT, dl, nul)
            idx_new: clause_insert(wi, a, wc, ne, TERM_VIRTUAL.bit_or(TERM_DYNAMIC).bit_or(TERM_VNULL))
            nt: wi.wcs[wc].a[idx_new]
            wi.terms[nt].prereq_right = 0
            wi.terms[nt].left_cursor = a.exprs[l].itable
            wi.terms[nt].left_column = a.exprs[l].icolumn
            wi.terms[nt].e_operator = WO_GT
            mark_term_as_child(wi, wc, idx_new, idx_term)
            add_wt_flags(wi, t, TERM_COPIED)
            wi.terms[nt].prereq_all = wi.terms[t].prereq_all
        }
    } else if op == tk.TK_FUNCTION && wi.wcs[wc].op == tk.TK_AND {
        lk: is_like_or_glob(p, a, e)
        if lk.ok {
            // "x LIKE 'aBc%'" adds "x >= 'ABC'" and "x < 'abd'": the lower
            // bound upper case and the upper bound lower case (upper case
            // sorts first in ASCII) so that they serve BLOBs too.
            wt_flags: TERM_LIKEOPT.bit_or(TERM_VIRTUAL).bit_or(TERM_DYNAMIC)
            left: ast.list_expr(a, a.exprs[e].x, 1)
            str1: lk.prefix
            str2: ast.expr_dup(a, str1, 0)
            complete := lk.complete
            if lk.no_case && !p.db.malloc_failed {
                add_wt_flags(wi, t, TERM_LIKE)
                z1: a.exprs[str1].token ?? [U8]{}
                up := [U8]{}
                low := [U8]{}
                loop c in z1 {
                    ci: Int{c}
                    if ci == 0 -> break
                    up.push(U8{util.upper_byte(ci)})
                    low.push(U8{util.lower_byte(ci)})
                }
                a.exprs[str1].token = Val(up)
                a.exprs[str2].token = Val(low)
            }
            if !p.db.malloc_failed {
                // Increment the last character before the first wildcard;
                // '@' would move into the letters, where case conversion
                // breaks the inequality, so then the LIKE runs on every
                // candidate too.
                z2 := pg.c_string(a.exprs[str2].token ?? [U8]{})
                n2: z2.len()
                c := Int{z2[n2 - 1]}
                if lk.no_case {
                    if c == 64 -> complete = false
                    c = util.lower_byte(c)
                }
                z2[n2 - 1] = U8{(c + 1).bit_and(255)}
                a.exprs[str2].token = Val(z2)
            }
            coll_name: if lk.no_case -> "NOCASE".bytes() else -> "BINARY".bytes()
            d1: ast.expr_dup(a, left, 0)
            c1: ast.expr_add_collate_string(a, d1, coll_name)
            ne1: ast.pexpr(a, tk.TK_GE, c1, str1)
            transfer_join_markings(a, ne1, e)
            idx_new1: clause_insert(wi, a, wc, ne1, wt_flags)
            d2: ast.expr_dup(a, left, 0)
            c2: ast.expr_add_collate_string(a, d2, coll_name)
            ne2: ast.pexpr(a, tk.TK_LT, c2, str2)
            transfer_join_markings(a, ne2, e)
            idx_new2: clause_insert(wi, a, wc, ne2, wt_flags)
            expr_analyze(p, a, wi, src, wc, idx_new1)
            expr_analyze(p, a, wi, src, wc, idx_new2)
            if complete {
                mark_term_as_child(wi, wc, idx_new1, idx_term)
                mark_term_as_child(wi, wc, idx_new2, idx_term)
            }
        }
    }
    // tag-20220128a: a vector == or IS with a side that is no sub-select
    // becomes one term per component, which replace it.
    eop: a.exprs[e].op
    el: a.exprs[e].left
    er: a.exprs[e].right
    n_left: if (eop == tk.TK_EQ || eop == tk.TK_IS) -> ast.vector_size(a, el) else -> 0
    if (eop == tk.TK_EQ || eop == tk.TK_IS) && n_left > 1 && ast.vector_size(a, er) == n_left && (!ast.has(a, el, ast.EP_X_IS_SELECT) || !ast.has(a, er, ast.EP_X_IS_SELECT)) && wi.wcs[wc].op == tk.TK_AND {
        loop i in 0..<n_left {
            l: ast.expr_for_vector_field(a, el, i, n_left)
            r: ast.expr_for_vector_field(a, er, i, n_left)
            ne: ast.pexpr(a, eop, l, r)
            transfer_join_markings(a, ne, e)
            idx_new: clause_insert(wi, a, wc, ne, TERM_DYNAMIC.bit_or(TERM_SLICE))
            expr_analyze(p, a, wi, src, wc, idx_new)
        }
        add_wt_flags(wi, t, TERM_CODED.bit_or(TERM_VIRTUAL))
        wi.terms[t].e_operator = WO_ROWVAL
    } else if eop == tk.TK_IN && wi.terms[t].i_field == 0 && a.exprs[el].op == tk.TK_VECTOR && ast.has(a, e, ast.EP_X_IS_SELECT) && (a.selects[a.exprs[e].x].prior < 0 || a.selects[a.exprs[e].x].sel_flags.bit_and(ast.SF_VALUES) != 0) && a.selects[a.exprs[e].x].win < 0 && wi.wcs[wc].op == tk.TK_AND {
        // A vector IN over a simple SELECT: a virtual term per component,
        // each over the whole IN with iField naming its component.
        loop i in 0..<ast.vector_size(a, el) {
            idx_new: clause_insert(wi, a, wc, e, TERM_VIRTUAL.bit_or(TERM_SLICE))
            wi.terms[wi.wcs[wc].a[idx_new]].i_field = i + 1
            expr_analyze(p, a, wi, src, wc, idx_new)
            mark_term_as_child(wi, wc, idx_new, idx_term)
        }
    } else if wi.wcs[wc].op == tk.TK_AND {
        // "column OP expr" with an operator only virtual tables use adds a
        // WO_AUX term for their xBestIndex.
        av: is_auxiliary_vtab_operator(p, a, e)
        res := av.n
        l := av.left
        r := av.right
        loop res > 0 {
            res -= 1
            prereq_expr: expr_usage(wi.mask_set, a, r)
            prereq_column: expr_usage(wi.mask_set, a, l)
            if prereq_expr.bit_and(prereq_column) == 0 {
                dr: ast.expr_dup(a, r, 0)
                ne: ast.pexpr(a, tk.TK_MATCH, -1, dr)
                if ast.has(a, e, ast.EP_OUTER_ON) {
                    ast.set_flags(a, ne, ast.EP_OUTER_ON)
                    a.exprs[ne].w = a.exprs[e].w
                }
                idx_new: clause_insert(wi, a, wc, ne, TERM_VIRTUAL.bit_or(TERM_DYNAMIC))
                nt: wi.wcs[wc].a[idx_new]
                wi.terms[nt].prereq_right = prereq_expr
                wi.terms[nt].left_cursor = a.exprs[l].itable
                wi.terms[nt].left_column = a.exprs[l].icolumn
                wi.terms[nt].e_operator = WO_AUX
                wi.terms[nt].e_match_op = av.op2
                mark_term_as_child(wi, wc, idx_new, idx_term)
                add_wt_flags(wi, t, TERM_COPIED)
                wi.terms[nt].prereq_all = wi.terms[t].prereq_all
            }
            sw: l
            l = r
            r = sw
        }
    }
    // ON clause terms of a LEFT JOIN may not drive an index on a table to
    // the left of the join.
    wi.terms[t].prereq_right = wi.terms[t].prereq_right.bit_or(extra_right)
}

// ---------------------------------------------------------------------------
// The interface to the rest of the planner.

// sqlite3WhereSplit: the subexpressions of `e` that operator op separates
// become the terms of clause wc.
where_split: fn(wi: &WhereInfo, a: ast.AST, wc: Int, e: Int, op: Int) Never! {
    e2: ast.skip_collate_and_likely(a, e)
    wi.wcs[wc].op = op
    if e2 < 0 -> return
    if a.exprs[e2].op != op {
        _: clause_insert(wi, a, wc, e, 0)
    } else {
        where_split(wi, a, wc, a.exprs[e2].left, op)
        where_split(wi, a, wc, a.exprs[e2].right, op)
    }
}

// whereAddLimitExpr: a WO_AUX LIMIT or OFFSET term (e_match_op) on cursor
// i_csr for its expression `e`, whose value register i_reg holds: an integer
// literal when it is one, for sqlite3_vtab_rhs_value, else a TK_REGISTER.
where_add_limit_expr: fn(wi: &WhereInfo, a: &ast.AST, wc: Int, i_reg: Int, e: Int, i_csr: Int, e_match_op: Int) Never! {
    iv: ast.expr_is_integer(a, e) ?? -1
    ne := -1
    if iv >= 0 {
        val: ast.expr_alloc(a, tk.TK_INTEGER, None, false)
        ast.set_flags(a, val, ast.EP_INT_VALUE)
        a.exprs[val].ivalue = iv
        ne = ast.pexpr(a, tk.TK_MATCH, -1, val)
    } else {
        val: ast.expr_alloc(a, tk.TK_REGISTER, None, false)
        a.exprs[val].itable = i_reg
        ne = ast.pexpr(a, tk.TK_MATCH, -1, val)
    }
    idx: clause_insert(wi, a, wc, ne, TERM_DYNAMIC.bit_or(TERM_VIRTUAL))
    t: wi.wcs[wc].a[idx]
    wi.terms[t].left_cursor = i_csr
    wi.terms[t].e_operator = WO_AUX
    wi.terms[t].e_match_op = e_match_op
}

// sqlite3WhereAddLimit: the LIMIT and OFFSET of SELECT `s` become terms for
// the xBestIndex of its only FROM item, a virtual table, when the query is
// no aggregate or DISTINCT, every WHERE term goes to that xBestIndex and so
// does the ORDER BY.
where_add_limit: fn(db: conn.Conn, wi: &WhereInfo, a: &ast.AST, wc: Int, s: Int) Never! {
    sel: a.selects[s]
    if sel.group_by >= 0 || sel.sel_flags.bit_and(ast.SF_DISTINCT.bit_or(ast.SF_AGGREGATE)) != 0 -> return
    if ast.src_len(a, sel.src) != 1 -> return
    item0: ast.src_item(a, sel.src, 0)
    if !ex.is_virtual(db, a.items[item0].tab) -> return
    i_csr: a.items[item0].cursor
    loop ii in 0..<wi.wcs[wc].a.len() {
        t: wi.wcs[wc].a[ii]
        // A decomposed vector comparison (tag-20220128a), or a term whose
        // children stand for it.
        if wi.terms[t].wt_flags.bit_and(TERM_CODED) != 0 -> next
        if wi.terms[t].n_child != 0 -> next
        if wi.terms[t].left_cursor != i_csr -> return
    }
    loop ii in 0..<ast.list_len(a, sel.order_by) {
        oe: ast.list_expr(a, sel.order_by, ii)
        if a.exprs[oe].op != tk.TK_COLUMN -> return
        if a.exprs[oe].itable != i_csr -> return
        if a.lists[sel.order_by].items[ii].sort_flags.bit_and(base.KEYINFO_ORDER_BIGNULL) != 0 -> return
    }
    where_add_limit_expr(wi, a, wc, sel.ilimit, a.exprs[sel.limit].left, i_csr, conn.INDEX_CONSTRAINT_LIMIT)
    if sel.ioffset > 0 -> where_add_limit_expr(wi, a, wc, sel.ioffset, a.exprs[sel.limit].right, i_csr, conn.INDEX_CONSTRAINT_OFFSET)
}

// sqlite3WhereClauseClear: the side effects of freeing clause wc, its
// dynamic expressions and its OR and AND sub-clauses.
where_clause_clear: fn(wi: WhereInfo, a: &ast.AST, wc: Int) Never! {
    loop t in wi.wcs[wc].a {
        f: wi.terms[t].wt_flags
        if f.bit_and(TERM_DYNAMIC) != 0 -> ast.expr_delete(a, wi.terms[t].expr)
        if f.bit_and(TERM_ORINFO.bit_or(TERM_ANDINFO)) != 0 -> where_clause_clear(wi, a, wi.terms[t].sub_wc)
    }
}

// sqlite3WhereExprAnalyze: analyze every term of clause wc, last first so
// that the virtual terms the analysis adds are not analyzed again.
where_expr_analyze: fn(p: &cg.Parse, a: &ast.AST, wi: &WhereInfo, src: Int, wc: Int) Never! -[DB]> {
    i := wi.wcs[wc].a.len() - 1
    loop i >= 0 {
        expr_analyze(p, a, wi, src, wc, i)
        i -= 1
    }
}

// sqlite3WhereTabFuncArgs: the arguments of table-valued function item si
// become equality terms on its HIDDEN columns.
where_tab_func_args: fn(p: &cg.Parse, a: &ast.AST, wi: &WhereInfo, si: Int, wc: Int) Never! {
    if !a.items[si].is_tab_func -> return
    t: a.items[si].tab
    args: a.items[si].func_arg
    if args < 0 -> return
    ncol: p.db.tables[t].cols.len()
    k := 0
    loop j in 0..<ast.list_len(a, args) {
        loop k < ncol && p.db.tables[t].cols[k].col_flags.bit_and(conn.COLFLAG_HIDDEN) == 0 -> k += 1
        if k >= ncol {
            name: ast.text(p.db.tables[t].name)
            ast.error(a, "too many arguments on {name}() - max {j}")
            return
        }
        col_ref: ast.expr_alloc(a, tk.TK_COLUMN, None, false)
        a.exprs[col_ref].itable = a.items[si].cursor
        a.exprs[col_ref].icolumn = k
        k += 1
        a.exprs[col_ref].y = t
        cu: rs.expr_col_used(p.db, a, col_ref)
        a.items[si].col_used = a.items[si].col_used.bit_or(cu)
        arg: ast.list_expr(a, args, j)
        d: ast.expr_dup(a, arg, 0)
        rhs: ast.pexpr(a, tk.TK_UPLUS, d, -1)
        term: ast.pexpr(a, tk.TK_EQ, col_ref, rhs)
        join_type: if a.items[si].jointype.bit_and(ast.JT_LEFT.bit_or(ast.JT_RIGHT)) != 0 -> ast.EP_OUTER_ON else -> ast.EP_INNER_ON
        set_join_expr(a, term, a.items[si].cursor, join_type)
        _: clause_insert(wi, a, wc, term, TERM_DYNAMIC)
    }
}

// sqlite3SetJoinExpr (select.c): mark `e0` and its subtrees as coming from
// the ON clause (join_flag EP_OUTER_ON or EP_INNER_ON) of join i_table.
set_join_expr: fn(a: &ast.AST, e0: Int, i_table: Int, join_flag: Int) Never! {
    e := e0
    loop e >= 0 {
        ast.set_flags(a, e, join_flag)
        a.exprs[e].w = i_table
        if a.exprs[e].op == tk.TK_FUNCTION {
            l: a.exprs[e].x
            loop i in 0..<ast.list_len(a, l) {
                x: ast.list_expr(a, l, i)
                set_join_expr(a, x, i_table, join_flag)
            }
        }
        set_join_expr(a, a.exprs[e].left, i_table, join_flag)
        e = a.exprs[e].right
    }
}

// ---------------------------------------------------------------------------
// Tests.

#Test("a WHERE clause splits on AND and its terms take their operators") {
    a := ast.stmt_ast("")
    p := rs.resolve_test_parse()
    cg.get_vdbe(p)
    src: rs.resolve_test_src(a)
    wi := where_info_new()
    create_mask(wi.mask_set, 0)
    create_mask(wi.mask_set, 1)
    ca: ex.expr_test_col(a, 0)
    five: ast.expr(a, tk.TK_INTEGER, "5".bytes())
    eq: ast.pexpr(a, tk.TK_EQ, five, ca)
    cb: ex.expr_test_col(a, 1)
    a.exprs[cb].itable = 1
    a.exprs[cb].y = 1
    nn: ast.pexpr(a, tk.TK_NOTNULL, cb, -1)
    both: ast.pexpr(a, tk.TK_AND, eq, nn)
    where_split(wi, a, 0, both, tk.TK_AND)
    assert(n_term(wi, 0) == 2)
    where_expr_analyze(p, a, wi, src, 0)
    t0: term_at(wi, 0, 0)
    assert(wi.terms[t0].e_operator == WO_EQ && wi.terms[t0].left_cursor == 0 && wi.terms[t0].left_column == 0)
    assert(a.exprs[a.exprs[wi.terms[t0].expr].left].op == tk.TK_COLUMN)
    assert(wi.terms[t0].prereq_right == 0 && wi.terms[t0].prereq_all == 1)
    // "u.b IS NOT NULL" adds the virtual child "u.b > NULL".
    assert(n_term(wi, 0) == 3)
    t2: term_at(wi, 0, 2)
    assert(wi.terms[t2].e_operator == WO_GT && wi.terms[t2].left_cursor == 1 && wi.terms[t2].i_parent == 1)
    assert(wi.terms[t2].wt_flags.bit_and(TERM_VNULL) != 0)
    assert(get_mask(wi.mask_set, 1) == 2 && get_mask(wi.mask_set, 7) == 0)
}

#Test("x = 1 OR x = 2 gains the virtual term x IN (1, 2)") {
    a := ast.stmt_ast("")
    p := rs.resolve_test_parse()
    cg.get_vdbe(p)
    src: rs.resolve_test_src(a)
    wi := where_info_new()
    create_mask(wi.mask_set, 0)
    create_mask(wi.mask_set, 1)
    c1: ex.expr_test_col(a, 0)
    one: ast.expr(a, tk.TK_INTEGER, "1".bytes())
    e1: ast.pexpr(a, tk.TK_EQ, c1, one)
    c2: ex.expr_test_col(a, 0)
    two: ast.expr(a, tk.TK_INTEGER, "2".bytes())
    e2: ast.pexpr(a, tk.TK_EQ, c2, two)
    either: ast.pexpr(a, tk.TK_OR, e1, e2)
    where_split(wi, a, 0, either, tk.TK_AND)
    where_expr_analyze(p, a, wi, src, 0)
    t0: term_at(wi, 0, 0)
    assert(wi.terms[t0].e_operator == WO_OR && wi.terms[t0].indexable == 1)
    assert(wi.wcs[0].has_or && n_term(wi, 0) == 2)
    t1: term_at(wi, 0, 1)
    assert(a.exprs[wi.terms[t1].expr].op == tk.TK_IN && wi.terms[t1].e_operator == WO_IN)
    assert(ast.list_len(a, a.exprs[wi.terms[t1].expr].x) == 2)
}
