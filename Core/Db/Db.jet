package: {
    name: "core.db"
    version: "0.0.1"
    edition: "2026"
    description: "SQL connections, pools, and migrations."
    license: "MIT"
    outputs: {
        db: .Library{ entry: db }
    }
}
use {
    core: core
    // core.db is plain Core source over the Jet SQLite engine: the private
    // driver below holds the only engine connection, and connections,
    // scopes, row policies, pools and migrations are ordinary Jet values.
    prep: __core_db_prepare
    api: __core_db_vdbeapi
    conn: __core_db_conn
    base: __core_db_base
    math: core.math
    time: core.time
    rt: jet.runtime.time
    encoding: core.encoding
    core.encoding.[Dyn]
    stream: __core_encoding_stream
    json: core.encoding.json
    // A typed table's `query` is a data query over its rows.
    data: core.data
    core.data.[Query]
    // DBScope.live bindings share app's process-wide live registry.
    app
    app.[Live]
}

// core.db owns its SQL values, typed row selection and conversion. The private
// SQLite driver alone holds the engine connection; fallible row reads use DBError.

#Equatable
DBValue: enum {
    Null
    Int(Int)
    Float(Float)
    Text(String)
    Bool(Bool)
    Blob([U8])

    impl Display { display: fn(self) -> String { render_value(self) } }

    is_null: fn(self) -> Bool Never! {
        if self == .Null -> return true
        false
    }
    int: fn(self) -> Int Err! {
        if self == .Int(number) -> return Ok(number)
        Err("expected an int, got {render_value(self)}")
    }
    float: fn(self) -> Float Err! {
        if self == {
            .Float(number) -> Ok(number)
            .Int(number) -> Ok(Float{number})
            .Null | .Text(_) | .Bool(_) | .Blob(_) -> Err("expected a float, got {render_value(self)}")
        }
    }
    text: fn(self) -> String Err! {
        if self == .Text(text) -> return Ok(text.copy())
        Err("expected text, got {render_value(self)}")
    }
    bool: fn(self) -> Bool Err! {
        if self == {
            .Bool(value) -> Ok(value)
            .Int(number) -> {
                if number == 0 -> return Ok(false)
                if number == 1 -> return Ok(true)
                Err("expected a bool, got {render_value(self)}")
            }
            .Null | .Float(_) | .Text(_) | .Blob(_) -> Err("expected a bool, got {render_value(self)}")
        }
    }
    blob: fn(self) -> [U8] Err! {
        if self == .Blob(bytes) -> return Ok(bytes.copy())
        Err("expected a blob, got {render_value(self)}")
    }
}

#Equatable
__PoolLifecycle: enum {
    Open
    Draining
    Drained
}

// Receipts have always been opaque public values: the pool produces them;
// source owns their exact counters, equality and textual projection.
#Equatable
DBPoolReceipt: struct {
    lifecycle: __PoolLifecycle
    max: Int
    available: Int
    leased: Int
    opening: Int
    ready: Bool
    acquires: Int
    releases: Int
    timeouts: Int
    open_failures: Int
    unhealthy: Int
    replacements: Int
    replacement_failures: Int

    impl Display { display: fn(self) -> String { pool_receipt_text(self) } }

    impl Debug { debug: fn(&&self) -> String { pool_receipt_text(self) } }
}
pool_receipt_text: fn(receipt: DBPoolReceipt) -> String Never! {
    lifecycle: if receipt.lifecycle == {
        .Open -> "open"
        .Draining -> "draining"
        .Drained -> "drained"
    }
    ready: if receipt.ready -> 1 else -> 0
    "db.pool lifecycle={lifecycle} max={receipt.max} available={receipt.available} leased={receipt.leased} opening={receipt.opening} ready={ready} acquires={receipt.acquires} releases={receipt.releases} timeouts={receipt.timeouts} open_failures={receipt.open_failures} unhealthy={receipt.unhealthy} replacements={receipt.replacements} replacement_failures={receipt.replacement_failures}"
}

#Test("pool receipt text keeps every counter and lifecycle spelling") {
    receipt := DBPoolReceipt{
        lifecycle: .Open, max: 2, available: 1, leased: 0, opening: 1,
        ready: true, acquires: 3, releases: 4, timeouts: 5, open_failures: 6,
        unhealthy: 7, replacements: 8, replacement_failures: 9,
    }
    assert_eq(pool_receipt_text(receipt), "db.pool lifecycle=open max=2 available=1 leased=0 opening=1 ready=1 acquires=3 releases=4 timeouts=5 open_failures=6 unhealthy=7 replacements=8 replacement_failures=9")
    receipt.lifecycle = .Draining
    receipt.ready = false
    assert_eq(pool_receipt_text(receipt), "db.pool lifecycle=draining max=2 available=1 leased=0 opening=1 ready=0 acquires=3 releases=4 timeouts=5 open_failures=6 unhealthy=7 replacements=8 replacement_failures=9")
    receipt.lifecycle = .Drained
    assert_eq(pool_receipt_text(receipt), "db.pool lifecycle=drained max=2 available=1 leased=0 opening=1 ready=0 acquires=3 releases=4 timeouts=5 open_failures=6 unhealthy=7 replacements=8 replacement_failures=9")
}

// A database operation's failure. `Failed` carries the engine's or the API's
// message; `Exists` is `Table.add` finding a row that holds the key already.
#[Error, Equatable]
DBError: enum {
    Failed(String)
    Exists

    // The failure in one line.
    message: fn(self) -> String {
        if self == {
            .Failed(text) -> text.copy()
            .Exists -> "a row with that key exists"
        }
    }

    impl Display { display: fn(self) -> String { self.message() } }

    impl Debug { debug: fn(&&self) -> String { self.message() } }
}

impl DBError -> Err { Err(self.message()) }
row_value: fn(row: [String: DBValue], column: String) -> DBValue DBError! {
    value: row.get(column) ?? return Err(db_error("missing column `{column}`"))
    Ok(value)
}

row_int: fn(row: [String: DBValue], column: String) -> Int DBError! {
    value: row_value(row, column)
    if value == {
        .Int(number) -> Ok(number)
        .Null | .Float(_) | .Text(_) | .Bool(_) | .Blob(_) -> Err(db_error("expected an int, got {render_value(value)}"))
    }
}

row_float: fn(row: [String: DBValue], column: String) -> Float DBError! {
    value: row_value(row, column)
    if value == {
        .Float(number) -> Ok(number)
        .Int(number) -> Ok(Float{number})
        .Null | .Text(_) | .Bool(_) | .Blob(_) -> Err(db_error("expected a float, got {render_value(value)}"))
    }
}

row_text: fn(row: [String: DBValue], column: String) -> String DBError! {
    value: row_value(row, column)
    if value == {
        .Text(text) -> Ok(text)
        .Null | .Int(_) | .Float(_) | .Bool(_) | .Blob(_) -> Err(db_error("expected text, got {render_value(value)}"))
    }
}

row_bool: fn(row: [String: DBValue], column: String) -> Bool DBError! {
    value: row_value(row, column)
    if value == {
        .Bool(boolean) -> Ok(boolean)
        .Int(number) -> {
            if number == 0 -> return Ok(false)
            if number == 1 -> return Ok(true)
            Err(db_error("expected a bool, got {number}"))
        }
        .Null | .Float(_) | .Text(_) | .Blob(_) -> Err(db_error("expected a bool, got {render_value(value)}"))
    }
}

render_value: fn(value: DBValue) -> String Never! {
    if value == {
        .Null -> "null"
        .Int(number) -> "{number}"
        .Float(number) -> __float_text(number)
        .Text(text) -> text
        .Bool(boolean) -> "{boolean}"
        .Blob(bytes) -> "{bytes}"
    }
}

// SQL values use the shortest decimal f64 display spelling, not Jet's debug
// spelling (which preserves ".0" and may use an exponent).
__float_text: fn(value: Float) -> String Never! {
    text: "{value}"
    raw: text.bytes()
    exponent_at := -1
    dot_at := -1
    loop i in 0..<raw.len() {
        if raw[i] == (U8{101}) -> exponent_at = i
        if raw[i] == (U8{46}) -> dot_at = i
    }
    if exponent_at < 0 {
        if raw.len() >= 2 && raw[raw.len() - 2] == (U8{46}) && raw[raw.len() - 1] == (U8{48}) {
            out := [U8]{}
            loop i in 0..<raw.len() - 2 -> out.push(raw[i])
            return String.from_bytes(out) ?? panic("decimal float text must be UTF-8")
        }
        return text
    }
    exponent := 0
    at := exponent_at + 1
    negative: raw[at] == (U8{45})
    if negative || raw[at] == (U8{43}) -> at += 1
    loop at < raw.len() {
        exponent = exponent * 10 + Int{raw[at]} - 48
        at += 1
    }
    if negative -> exponent = 0 - exponent
    start: if raw[0] == (U8{45}) -> 1 else -> 0
    point: if dot_at >= 0 -> dot_at - start else -> exponent_at - start
    count := exponent_at - start
    if dot_at >= 0 -> count -= 1
    end := exponent_at
    loop end > start && raw[end - 1] == (U8{48}) {
        end -= 1
        count -= 1
    }
    decimal: point + exponent
    out := [U8]{}
    if start == 1 -> out.push(U8{45})
    if decimal <= 0 {
        out.push(U8{48})
        out.push(U8{46})
        loop _ in 0..<0 - decimal -> out.push(U8{48})
    }
    loop digit in 0..<count {
        if decimal > 0 && digit == decimal -> out.push(U8{46})
        index := start + digit
        if dot_at >= 0 && index >= dot_at -> index += 1
        out.push(raw[index])
    }
    loop _ in count..<decimal -> out.push(U8{48})
    String.from_bytes(out) ?? panic("decimal float text must be UTF-8")
}

priv db_error: fn(message: String) -> DBError Never! { DBError.Failed(message.copy()) }
priv db_closed: fn() -> DBError Never! { db_error("database connection is closed") }

// Checked SQL: the template text with `?` placeholders plus its bound values.
// `SQL{"… {value} …"}` is a checked text literal whose holes stay values: each
// becomes one bound DBValue, never query text.
#Equatable
SQL: struct {
    text: String
    values: [DBValue]

    raw: fn(text: String) -> SQL Never! { SQL{text: text.copy(), values: [DBValue]{}} }
    template: fn(self) -> String Never! { self.text.copy() }
    params: fn(self) -> [DBValue] Never! { self.values.copy() }

    impl Display { display: fn(self) -> String { self.text.copy() } }

    impl CheckedText {
        Error: Never
        Hole: DBValue

        // Every SQL text is accepted; its holes are what keeps a query safe.
        check: fn(_text: String) Never! -[]> { return Ok() }

        // A DBValue binds as-is; Int, Float, Bool and byte lists bind as their own
        // variant; anything else binds its display text.
        encode_hole: fn<T: Printable>(value: T) -[]> DBValue {
            if T == {
                DBValue -> value.copy()
                Int -> DBValue.Int(value)
                Float -> DBValue.Float(value)
                Bool -> DBValue.Bool(value)
                [U8] -> DBValue.Blob(value.copy())
                else -> DBValue.Text("{value}")
            }
        }

        build: fn(parts: [String], holes: [DBValue]) -[]> SQL { __sql_literal(parts, holes) }
    }
}
__sql_literal: fn(literals: [String], values: [DBValue]) -> SQL Never! {
    if literals.len() != values.len() + 1 -> panic("typed SQL literal pieces do not match its holes")
    text := literals[0].copy()
    loop index in 0..<values.len() -> text = "{text}?{literals[index + 1]}"
    SQL{text: text, values: values.copy()}
}
priv sql_raw: fn(text: String) -> SQL Never! { SQL{text: text.copy(), values: [DBValue]{}} }

// Row policies: a table plus either `true` (allow all) or `owner == user`.
#Equatable
RowPolicy: struct {
    table: String
    owner: Bool
}

priv policy_expression: fn(policy: RowPolicy) -> String Never! { if policy.owner -> "owner == user" else -> "true" }
priv policy_predicate: fn(policy: RowPolicy) -> String Never! { if policy.owner -> "owner = ?" else -> "true" }

policy: fn(table: String, expression: String) -[DB]> RowPolicy DBError! {
    name: table.trim()
    expr: expression.trim()
    name_raw: name.bytes()
    expr_raw: expr.bytes()
    if name_raw.len() == 0 || expr_raw.len() == 0 || name_raw.len() > 1048576 || expr_raw.len() > 1048576 || sql_has_control(name_raw, false) || sql_has_control(expr_raw, false) {
        return Err(db_error("row policy needs a table and expression"))
    }
    if !sql_identifier(name_raw) -> return Err(db_error("row policy table must be a simple identifier"))
    if expr == "true" -> return Ok(RowPolicy{table: name.copy(), owner: false})
    if expr == "owner == user" -> return Ok(RowPolicy{table: name.copy(), owner: true})
    Err(db_error("unsupported row policy expression `{expr}`; supported forms are `true` and `owner == user`"))
}

policy_show: fn(policy: RowPolicy) -> String Never! { "RowPolicy(table={policy.table}, expr={policy_expression(policy)})" }

policy_allows: fn(policy: RowPolicy, *, user: String, owner: String) -> Bool Never! {
    if !policy.owner -> return true
    user == owner
}

policy_audit: fn(scope: DBScope) -[DB]> String Never! {
    "DBPolicy(table={scope.policy.table}, user={scope.user}, expr={policy_expression(scope.policy)}, predicate={policy_predicate(scope.policy)})"
}

priv sql_identifier: fn(raw: [U8]) -> Bool Never! {
    if raw.len() == 0 -> return false
    first: Int{raw[0]}
    if !((first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95) -> return false
    loop byte in raw { if !sql_word_byte(Int{byte}) -> return false }
    true
}

// ---- policy-scoped SQL ---------------------------------------------------
// Statements run through a scope are rewritten on bytes: one statement, no
// comments, one simple target table, and an owner predicate when required.

priv SQLToken: struct {
    start: Int
    end: Int
    word: String
}

priv sql_word_byte: fn(byte: Int) -> Bool Never! { (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 }
priv sql_space: fn(byte: Int) -> Bool Never! { byte == 32 || (byte >= 9 && byte <= 13) }
priv sql_lower: fn(byte: U8) -> U8 Never! {
    value: Int{byte}
    if value >= 65 && value <= 90 -> return U8{value + 32}
    byte
}
priv sql_lower_text: fn(text: String) -> String Never! {
    out := [U8]{}
    loop byte in text.bytes() -> out.push(sql_lower(byte))
    String.from_bytes(out) ?? ""
}
priv bytes_text: fn(raw: [U8], start: Int, end: Int) -> String Never! {
    out := [U8]{}
    loop at in start..<end -> out.push(raw[at])
    String.from_bytes(out) ?? ""
}
priv sql_trimmed: fn(raw: [U8], start: Int, end: Int) -> String Never! {
    first := start
    last := end
    loop first < last && sql_space(Int{raw[first]}) { first += 1 }
    loop last > first && sql_space(Int{raw[last - 1]}) { last -= 1 }
    bytes_text(raw, first, last)
}
priv sql_blank: fn(raw: [U8], start: Int, end: Int) -> Bool Never! {
    loop at in start..<end { if !sql_space(Int{raw[at]}) -> return false }
    true
}
priv sql_find: fn(raw: [U8], from: Int, byte: Int) -> Int Never! {
    loop at in from..<raw.len() { if (Int{raw[at]}) == byte -> return at }
    -1
}
// Control characters by Rust `char::is_control` on UTF-8 bytes: C0, DEL and
// C1 (C2 80-9F). `allow_whitespace` admits the whitespace controls.
priv sql_has_control: fn(raw: [U8], allow_whitespace: Bool) -> Bool Never! {
    loop at in 0..<raw.len() {
        byte: Int{raw[at]}
        whitespace: byte >= 9 && byte <= 13
        if byte < 32 && !(allow_whitespace && whitespace) -> return true
        if byte == 127 -> return true
        if byte == 194 && at + 1 < raw.len() {
            next: Int{raw[at + 1]}
            if next >= 128 && next <= 159 && !(allow_whitespace && next == 133) -> return true
        }
    }
    false
}
priv sql_skip_quoted: fn(raw: [U8], open: Int, quote: Int, limit: Int) -> Int Never! {
    at := open + 1
    loop at < limit {
        if {
            (Int{raw[at]}) == quote -> {
                if {
                    at + 1 < limit && (Int{raw[at + 1]}) == quote -> {
                        at += 2
                    }
                    else -> {
                        return at + 1
                    }
                }
            }
            else -> {
                at += 1
            }
        }
    }
    at
}
priv sql_tokens: fn(raw: [U8]) -> [SQLToken] Never! {
    tokens := [SQLToken]{}
    at := 0
    loop at < raw.len() {
        byte: Int{raw[at]}
        if {
            byte == 39 -> {
                at = sql_skip_quoted(raw, at, 39, raw.len())
            }
            sql_word_byte(byte) -> {
                start: at
                word := [U8]{}
                loop at < raw.len() && sql_word_byte(Int{raw[at]}) {
                    word.push(sql_lower(raw[at]))
                    at += 1
                }
                tokens.push(SQLToken{start: start, end: at, word: String.from_bytes(word) ?? ""})
            }
            else -> {
                at += 1
            }
        }
    }
    tokens
}
priv sql_has_comment: fn(raw: [U8]) -> Bool Never! {
    at := 0
    loop at < raw.len() {
        byte: Int{raw[at]}
        if {
            byte == 39 -> {
                at = sql_skip_quoted(raw, at, 39, raw.len())
            }
            else -> {
                if at + 1 < raw.len() {
                    next: Int{raw[at + 1]}
                    if (byte == 45 && next == 45) || (byte == 47 && next == 42) || (byte == 42 && next == 47) -> return true
                }
                at += 1
            }
        }
    }
    false
}
priv sql_word_index: fn(tokens: [SQLToken], word: String) -> Int Never! {
    loop index in 0..<tokens.len() { if tokens[index].word == word -> return index }
    -1
}
priv sql_count: fn(tokens: [SQLToken], word: String) -> Int Never! {
    count := 0
    loop token in tokens { if token.word == word -> count += 1 }
    count
}
priv sql_clause_word: fn(word: String, with_where: Bool) -> Bool Never! {
    (with_where && word == "where") || word == "order" || word == "group" || word == "limit" || word == "offset" || word == "returning"
}
// First ORDER/GROUP/LIMIT/OFFSET/RETURNING token starting after `after`.
priv sql_clause_start: fn(tokens: [SQLToken], after: Int) -> Int Never! {
    loop token in tokens { if token.start > after && sql_clause_word(token.word, false) -> return token.start }
    -1
}
priv sql_target_index: fn(tokens: [SQLToken], kind: String) -> Int Never! {
    keyword: if {
        kind == "select" || kind == "delete" -> "from"
        kind == "insert" -> "into"
        else -> kind.copy()
    }
    found: sql_word_index(tokens, keyword)
    if found < 0 || found + 1 >= tokens.len() -> return -1
    found + 1
}
priv sql_simple_target: fn(raw: [U8], tokens: [SQLToken], kind: String) -> Bool Never! {
    selects: if kind == "select" -> 1 else -> 0
    froms: if kind == "select" || kind == "delete" -> 1 else -> 0
    words: [String]{"join", "union", "with", "except", "intersect", "conflict", "upsert", "replace"}
    loop word in words {
        if sql_count(tokens, word) > 0 -> return false
    }
    if sql_count(tokens, "select") > selects || sql_count(tokens, "from") > froms -> return false
    target: sql_target_index(tokens, kind)
    if target < 0 -> return false
    target_end: tokens[target].end
    first: target + 1
    if kind == "select" || kind == "delete" {
        clause := raw.len()
        loop index in first..<tokens.len() {
            if sql_clause_word(tokens[index].word, true) {
                clause = tokens[index].start
                break
            }
        }
        return sql_blank(raw, target_end, clause)
    }
    if kind == "update" {
        loop index in first..<tokens.len() {
            if tokens[index].word == "set" -> return sql_blank(raw, target_end, tokens[index].start)
        }
        return false
    }
    if kind == "insert" -> return sql_count(tokens, "values") == 1 && sql_count(tokens, "select") == 0
    false
}
priv sql_split_trimmed: fn(raw: [U8], start: Int, end: Int) -> [String] Never! {
    parts := [String]{}
    from := start
    loop at in start..<end {
        if (Int{raw[at]}) == 44 {
            parts.push(sql_trimmed(raw, from, at))
            from = at + 1
        }
    }
    parts.push(sql_trimmed(raw, from, end))
    parts
}

priv SQLInsertShape: struct {
    columns: Int
    owner: Int
}

priv sql_insert_shape: fn(raw: [U8], tokens: [SQLToken]) -> SQLInsertShape? Never! {
    into: sql_word_index(tokens, "into")
    if into < 0 || into + 1 >= tokens.len() -> return None
    values: sql_word_index(tokens, "values")
    if values < 0 -> return None
    column_start: sql_find(raw, tokens[into + 1].end, 40)
    if column_start < 0 -> return None
    column_end: sql_find(raw, column_start, 41)
    if column_end < 0 -> return None
    value_start: sql_find(raw, tokens[values].end, 40)
    if value_start < 0 -> return None
    value_end: sql_find(raw, value_start, 41)
    if value_end < 0 -> return None
    columns: sql_split_trimmed(raw, column_start + 1, column_end)
    cells: sql_split_trimmed(raw, value_start + 1, value_end)
    if columns.len() != cells.len() -> return None
    owner := -1
    loop index in 0..<columns.len() {
        column: columns[index].bytes()
        if column.len() == 0 -> return None
        loop byte in column { if !sql_word_byte(Int{byte}) -> return None }
        if cells[index] != "?" -> return None
        if owner < 0 && sql_lower_text(columns[index]) == "owner" -> owner = index
    }
    if owner < 0 -> return None
    Val(SQLInsertShape{columns: columns.len(), owner: owner})
}
priv sql_update_mutates_owner: fn(tokens: [SQLToken]) -> Bool Never! {
    set: sql_word_index(tokens, "set")
    if set < 0 -> return false
    first: set + 1
    loop index in first..<tokens.len() {
        if sql_clause_word(tokens[index].word, true) -> return false
        if tokens[index].word == "owner" -> return true
    }
    false
}
// Bound placeholders before `end`, skipping quoted text and [bracketed] names.
priv sql_placeholders: fn(raw: [U8], end: Int) -> Int Never! {
    count := 0
    at := 0
    loop at < end {
        byte: Int{raw[at]}
        if {
            byte == 39 || byte == 34 || byte == 96 -> {
                at = sql_skip_quoted(raw, at, byte, end)
            }
            byte == 91 -> {
                at += 1
                loop at < end && (Int{raw[at]}) != 93 { at += 1 }
                if at < end -> at += 1
            }
            else -> {
                if byte == 63 -> count += 1
                at += 1
            }
        }
    }
    count
}
priv sql_is_migration_metadata: fn(raw: [U8]) -> Bool Never! {
    out := [U8]{}
    pending := false
    loop byte in raw {
        if {
            sql_space(Int{byte}) -> {
                pending = out.len() > 0
            }
            else -> {
                if pending {
                    out.push(U8{32})
                    pending = false
                }
                out.push(sql_lower(byte))
            }
        }
    }
    text: String.from_bytes(out) ?? ""
    if text.starts_with("create table if not exists __jet_migrations") || text.starts_with("create table __jet_migrations") -> return true
    if text.starts_with("pragma table_info(__jet_migrations") || text.starts_with("insert into __jet_migrations") -> return true
    text.starts_with("select ") && text.contains(" from __jet_migrations")
}

priv policy_apply: fn(sql: SQL, policy: RowPolicy, user: String, allow_schema: Bool) -> SQL DBError! {
    raw: sql.text.bytes()
    if raw.len() > 1048576 || sql_find(raw, 0, 59) >= 0 || sql_has_control(raw, true) {
        return Err(db_error("policy-scoped SQL must be one statement without control characters"))
    }
    if sql_has_comment(raw) -> return Err(db_error("policy-scoped SQL cannot contain comments"))
    user_raw: user.bytes()
    if sql_blank(user_raw, 0, user_raw.len()) || user_raw.len() > 1048576 || sql_has_control(user_raw, false) {
        return Err(db_error("policy user identity is empty, too long, or contains control characters"))
    }
    tokens: sql_tokens(raw)
    if tokens.len() == 0 -> return Err(db_error("policy-scoped SQL is empty"))
    if sql_is_migration_metadata(raw) {
        if !allow_schema -> return Err(db_error("migration metadata is managed only by db.migrate"))
        return Ok(sql.copy())
    }
    kind: tokens[0].word.copy()
    if kind != "select" && kind != "update" && kind != "delete" && kind != "insert" {
        if kind == "create" || kind == "alter" || kind == "drop" || kind == "pragma" || kind == "begin" || kind == "commit" || kind == "rollback" {
            if allow_schema -> return Ok(sql.copy())
            return Err(db_error("schema and transaction-control SQL is only allowed in db.migrate or through the scope transaction controls"))
        }
        return Err(db_error("row policy supports SELECT, INSERT, UPDATE, and DELETE only"))
    }
    target: sql_target_index(tokens, kind)
    table: sql_lower_text(policy.table)
    // A row policy constrains the rows of its own table (#6070). SQL that
    // targets no table (`SELECT 1`) or another table runs unchanged, unless it
    // names the policy's table anywhere (a join, a subquery, a column read),
    // which would read its rows past the policy.
    if target < 0 || tokens[target].word != table {
        if sql_word_index(tokens, table) >= 0 -> return Err(db_error("policy-scoped SQL that reads `{policy.table}` must target it as its one simple table"))
        // copy: the caller keeps its SQL value; the scope runs this one.
        return Ok(sql.copy())
    }
    if !sql_simple_target(raw, tokens, kind) -> return Err(db_error("policy-scoped SQL must name one simple target table without joins or subqueries"))
    if !policy.owner -> return Ok(sql.copy())
    if kind == "insert" {
        shape: sql_insert_shape(raw, tokens) ?? return Err(db_error("owner policy requires INSERT columns and `?` values with an owner column"))
        if shape.columns != sql.values.len() -> return Err(db_error("owner policy INSERT bind count does not match its columns"))
        values := sql.values.copy()
        values[shape.owner] = DBValue.Text(user.copy())
        return Ok(SQL{text: sql.text.copy(), values: values})
    }
    if kind == "update" && sql_update_mutates_owner(tokens) -> return Err(db_error("owner policy does not allow changing the owner column"))
    where_index: sql_word_index(tokens, "where")
    insertion := -1
    if where_index >= 0 -> insertion = sql_clause_start(tokens, tokens[where_index].end)
    if insertion < 0 -> insertion = sql_clause_start(tokens, 0)
    if insertion < 0 -> insertion = raw.len()
    user_index: sql_placeholders(raw, insertion)
    if user_index > sql.values.len() -> return Err(db_error("policy-scoped SQL bind count does not match its placeholders"))
    values := [DBValue]{}
    loop index in 0..<sql.values.len() {
        if index == user_index -> values.push(DBValue.Text(user.copy()))
        values.push(sql.values[index].copy())
    }
    if user_index == sql.values.len() -> values.push(DBValue.Text(user.copy()))
    tail_start := insertion
    loop tail_start < raw.len() && sql_space(Int{raw[tail_start]}) { tail_start += 1 }
    suffix: if tail_start >= raw.len() -> "" else -> " {bytes_text(raw, tail_start, raw.len())}"
    if where_index >= 0 {
        condition: sql_trimmed(raw, tokens[where_index].end, insertion)
        if condition.len() == 0 -> return Err(db_error("policy-scoped SQL has an empty WHERE clause"))
        return Ok(SQL{text: "{bytes_text(raw, 0, tokens[where_index].start)}WHERE ({condition}) AND owner = ?{suffix}", values: values})
    }
    head_end := insertion
    loop head_end > 0 && sql_space(Int{raw[head_end - 1]}) { head_end -= 1 }
    Ok(SQL{text: "{bytes_text(raw, 0, head_end)} WHERE owner = ?{suffix}", values: values})
}

// ---- connections and scopes ----------------------------------------------

// One SQLite connection shared by a Store and every scope derived from
// it. `close` shuts the driver down in place for all of them. `path` is the
// location it was opened at, for display. `written` names the tables written
// since the last begin or commit, so a rollback can re-run their live bindings.
// `open` numbers the transaction open on it (0: none), out of `began` so far.
priv DBState: struct {
    driver: __Driver
    path: String
    written: [String]
    open: Int{0}
    began: Int{0}
}

Store: struct {
    state: Shared<DBState>

    with_policy: fn(self, policy: RowPolicy, user: String) -[DB]> DBScope Never! {
        DBScope{state: self.state.copy(), policy: RowPolicy{table: policy.table.copy(), owner: policy.owner}, user: user.copy()}
    }
    // Opens a transaction; the `DBTransaction` it returns has to be committed
    // or rolled back.
    begin: fn(self) -[DB]> DBTransaction DBError! { db_begin(self.state, false) }
    close: fn(self) -[DB]> Bool Never! { db_shutdown(self.state) }
    // The typed table `name`: rows of type `T`, each found by the key that
    // the pure function `key` computes from it.
    table: fn<K: [Encode, Decode, Comparable], T: [Encode, Decode]>(self, name: String, key: &&fn(T) -[]> K) -> Table<K, T> Never! {
        Table<K, T>{state: self.state.copy(), name: name.copy(), key_of: key.move()}
    }

    // One line: where the database lives and whether it is still open.
    impl Display {
        display: fn(self) -> String {
            guard: self.state.guard_edit()
            status: if driver_closed(guard.value.driver) -> "closed" else -> "open"
            "Store({guard.value.path}, {status})"
        }
    }
}
DBScope: struct {
    state: Shared<DBState>
    policy: RowPolicy
    user: String

    // A live binding over one policy-checked SELECT. `app.state` reads
    // it; each re-run applies this scope's policy again, and a write to the
    // table it reads (or a rollback of one) re-runs it on the next read. The
    // user, the policy-applied SQL and its values identify the binding.
    live: fn(self, sql: SQL) -[DB.Read]> Live<[[String: DBValue]], DBError> DBError! {
        scoped: policy_apply(sql, self.policy, self.user, false) ?? return Err(err)
        tokens: sql_tokens(scoped.text.bytes())
        if tokens.len() == 0 || tokens[0].word != "select" -> return Err(db_error("a live query must be one SELECT"))
        key := [String]{app.__live_arg<String>(self.user), app.__live_arg<String>(scoped.text)}
        loop value in scoped.values -> key.push(app.__live_arg<DBValue>(value))
        scope: self.copy()
        query: sql.copy()
        Ok(app.__live_bind<[[String: DBValue]], DBError>(live_source(sql_table(scoped) ?? ""), key, fn() { scope_query(scope, query, false) }))
    }
    close: fn(self) -[DB]> Bool Never! { db_shutdown(self.state) }

    // A policy scope is the typed-SQL driver a generic `<T: Driver>` takes.
    impl Driver {
        query: fn(self, sql: SQL) -[DB.Read]> [[String: DBValue]] DBError! { scope_query(self, sql, false) }
        query_one: fn(self, sql: SQL) -[DB.Read]> [String: DBValue]? DBError! {
            rows := scope_query(self, sql, false) ?? return Err(err)
            if rows.len() == 0 -> return Ok(None)
            first: rows.remove(0, .Slot) ?? panic("database first row disappeared")
            Ok(Val(first))
        }
        execute: fn(self, sql: SQL) -[DB.Write]> Int DBError! { scope_execute(self, sql, false) }
        begin: fn(self) -[DB]> DBTransaction DBError! { db_begin(self.state, false) }
    }
}

// An open transaction on a connection. It is `#SingleUse`: whoever began it
// has to `commit` or `rollback` it, on every path, before a function returns
// with success. Either call ends the transaction, even when it fails: a commit
// that fails is rolled back, and its error says so; the caller can't ignore it.
// One dropped while still open, by a cancelled task or a stop unwinding past
// it, is rolled back: it writes nothing, and the connection can begin again.
#SingleUse
DBTransaction: struct {
    priv state: Shared<DBState>
    priv number: Int

    commit: fn(&&self) DBError! -[DB]> { db_commit(self.state) }
    rollback: fn(&&self) DBError! -[DB]> { db_rollback(self.state) }

    impl Close {
        close: fn(&&self) {
            if !db_open_is(self.state, self.number) -> return
            db_rollback(self.state).drop("an unwind ended the transaction; no caller is left to report a failed rollback to")
        }
    }
}

// ---- typed tables ----------------------------------------------------------

// The column a typed table keeps each encoded row in, and the one key column
// of a table whose key is not a record.
TABLE_ROW_COLUMN: "jet_row"
TABLE_KEY_COLUMN: "key"

// A typed table, from `store.table(name, key:)`. Each field of the key is a
// key column (a key that is not a record is the one column `key`) and those
// columns are the primary key; the column `jet_row` holds the encoded row.
// The first write creates the table, and until then it reads as empty. Reads
// carry DB.Read and writes DB.Write.
Table: struct<K: [Encode, Decode, Comparable], T: [Encode, Decode]> {
    priv state: Shared<DBState>
    priv name: String
    priv key_of: fn(T) -[]> K

    // The row whose key is `key`, or None.
    get: fn(self, key: K) -[DB.Read]> T? DBError! {
        cells: table_cells(self.name, key.encode()) ?? return Err(err)
        guard := self.state.guard_edit()
        if driver_closed(guard.value.driver) -> return Err(db_closed())
        rows: table_read(guard.value.driver, self.name, "SELECT {TABLE_ROW_COLUMN} FROM \"{self.name}\" WHERE {table_match(cells)}", table_values(cells)) ?? return Err(err)
        if rows.len() == 0 -> return Ok(None)
        row: table_decode<T>(rows[0]) ?? return Err(err)
        Ok(Val(row))
    }
    // Adds `row`, whose key no row may hold yet (else `Exists`).
    add: fn(self, row: T) -[DB.Write]> T DBError! { table_write<K, T>(self, row, false) }
    // Adds `row`, or replaces the row that holds its key.
    put: fn(self, row: T) -[DB.Write]> T DBError! { table_write<K, T>(self, row, true) }
    // Removes the row whose key is `key`, if there is one.
    delete: fn(self, key: K) DBError! -[DB.Write]> {
        cells: table_cells(self.name, key.encode()) ?? return Err(err)
        guard := self.state.guard_edit()
        if driver_closed(guard.value.driver) -> return Err(db_closed())
        if !table_exists(guard.value.driver, self.name) -> return Ok()
        _: __driver_execute(guard.value.driver, "DELETE FROM \"{self.name}\" WHERE {table_match(cells)}", table_values(cells)) ?? return Err(err)
        Ok()
    }
    // Every row, in key order, as a data query.
    query: fn(self) -[DB.Read]> Query<T> DBError! {
        if !sql_identifier(self.name.bytes()) -> return Err(table_name_error(self.name))
        guard := self.state.guard_edit()
        if driver_closed(guard.value.driver) -> return Err(db_closed())
        rows: table_read(guard.value.driver, self.name, "SELECT {TABLE_ROW_COLUMN} FROM \"{self.name}\"", [DBValue]{}) ?? return Err(err)
        keyed := [(key: K, row: T)]{}
        loop stored in rows {
            row: table_decode<T>(stored) ?? return Err(err)
            keyed.push((key: self.key_of(row.copy()), row: row))
        }
        keyed.sort_by(fn(left: (key: K, row: T), right: (key: K, row: T)) { left.key <=> right.key })
        out := [T]{}
        loop entry in keyed -> out.push(entry.row.copy())
        Ok(data.query(out))
    }
}

// `add` (replace false) and `put` (replace true): creates the table on its
// first write, then inserts the encoded row under its key columns.
priv table_write: fn<K: [Encode, Decode, Comparable], T: [Encode, Decode]>(table: Table<K, T>, row: T, replace: Bool) -[DB.Write]> T DBError! {
    key: table.key_of(row.copy())
    cells: table_cells(table.name, key.encode()) ?? return Err(err)
    encoded: json.to_string<T>(row) ?? return Err(db_error("the row for table `{table.name}` does not encode: {err}"))
    columns := [String]{}
    loop cell in cells -> columns.push("\"{cell.column}\"")
    names: columns.join(", ")
    guard := table.state.guard_edit()
    if driver_closed(guard.value.driver) -> return Err(db_closed())
    _: __driver_execute(guard.value.driver, "CREATE TABLE IF NOT EXISTS \"{table.name}\" ({names}, {TABLE_ROW_COLUMN} TEXT NOT NULL, PRIMARY KEY ({names}))", [DBValue]{}) ?? return Err(err)
    if !replace {
        held: __driver_query(guard.value.driver, "SELECT 1 AS held FROM \"{table.name}\" WHERE {table_match(cells)}", table_values(cells)) ?? return Err(err)
        if held.len() > 0 -> return Err(DBError.Exists)
    }
    values := table_values(cells)
    values.push(DBValue.Text(encoded))
    marks := [String]{}
    loop _ in 0..<values.len() -> marks.push("?")
    verb: if replace -> "INSERT OR REPLACE" else -> "INSERT"
    _: __driver_execute(guard.value.driver, "{verb} INTO \"{table.name}\" ({names}, {TABLE_ROW_COLUMN}) VALUES ({marks.join(", ")})", values) ?? return Err(err)
    Ok(row)
}

// The key columns and values of an encoded key: one per field of a record
// key, else the one column `key`.
priv table_cells: fn(name: String, key: Dyn) -> [(column: String, value: DBValue)] DBError! {
    if !sql_identifier(name.bytes()) -> return Err(table_name_error(name))
    cells := [(column: String, value: DBValue)]{}
    if !(key == .Object(_)) {
        cells.push((column: TABLE_KEY_COLUMN, value: table_value(key)))
        return Ok(cells)
    }
    loop entry in stream.object_entries(key) {
        if !sql_identifier(entry.key.bytes()) || entry.key == TABLE_ROW_COLUMN -> return Err(db_error("table `{name}` cannot have the key column `{entry.key}`"))
        cells.push((column: entry.key.copy(), value: table_value(entry.value)))
    }
    if cells.len() == 0 -> return Err(db_error("table `{name}` has a key with no fields"))
    Ok(cells)
}

// A key field's column value: a scalar as itself, anything else as its JSON
// text.
priv table_value: fn(value: Dyn) -> DBValue Never! {
    if value == {
        .Null -> DBValue.Null
        .Bool(flag) -> DBValue.Bool(flag)
        .Int(number) -> DBValue.Int(number)
        .Float(number) -> DBValue.Float(number)
        .Text(text) -> DBValue.Text(text)
        .Bytes(bytes) -> DBValue.Blob(bytes)
        .Number(_) | .DateTime(_) | .Array(_) | .Object(_) -> DBValue.Text(json.to_string(value) ?? panic("a decoded key field always encodes as JSON"))
    }
}

priv table_match: fn(cells: [(column: String, value: DBValue)]) -> String Never! {
    terms := [String]{}
    loop cell in cells -> terms.push("\"{cell.column}\" = ?")
    terms.join(" AND ")
}

priv table_values: fn(cells: [(column: String, value: DBValue)]) -> [DBValue] Never! {
    values := [DBValue]{}
    loop cell in cells -> values.push(cell.value.copy())
    values
}

priv table_name_error: fn(name: String) -> DBError Never! { db_error("`{name}` is not a table name: use letters, digits and `_`") }

priv table_exists: fn(driver: &__Driver, name: String) -> Bool Never! {
    found: __driver_query(driver, "SELECT name FROM sqlite_master WHERE type = 'table' AND name = ?", [DBValue]{.Text(name.copy())}) ?? return false
    found.len() > 0
}

// A read of a typed table: a table no write has created yet holds no rows.
priv table_read: fn(driver: &__Driver, name: String, sql: String, values: [DBValue]) -> [[String: DBValue]] DBError! {
    if !table_exists(driver, name) -> return Ok([[String: DBValue]]{})
    __driver_query(driver, sql, values)
}

priv table_decode: fn<T: Decode>(stored: [String: DBValue]) -> T DBError! {
    text: row_text(stored, TABLE_ROW_COLUMN) ?? return Err(err)
    tree: json.parse(text) ?? return Err(db_error("a stored row is not JSON: {err}"))
    if tree.decode<T>() == {
        .Ok(value) -> Ok(value)
        .Err(failures) -> Err(db_error("a stored row does not decode: {failures[0].reason}"))
    }
}

priv db_open: fn(path: String, failure: String) -> Store Never! {
    driver := __driver_open(path) ?? panic(failure)
    Store{state: Shared{DBState{driver: driver.move(), path: path.copy(), written: [String]{}}}}
}
open: fn(path: String) -[DB]> Store Never! { db_open(path, "database open failed") }
open_memory: fn() -[DB]> Store Never! { db_open(":memory:", "in-memory database open failed") }

priv db_begin: fn(state: Shared<DBState>, immediate: Bool) -> DBTransaction DBError! {
    guard := state.guard_edit()
    if driver_closed(guard.value.driver) -> return Err(db_error("could not begin a transaction: the database is closed"))
    began: if immediate -> __driver_begin_immediate(guard.value.driver) else -> __driver_begin(guard.value.driver)
    if !began -> return Err(db_error("could not begin a transaction: one is already open, or the database is busy"))
    guard.value.written = [String]{}
    guard.value.began = guard.value.began + 1
    guard.value.open = guard.value.began
    Ok(DBTransaction{state: state.copy(), number: guard.value.open})
}
// Whether transaction `number` is the one still open on `state`.
priv db_open_is: fn(state: Shared<DBState>, number: Int) -> Bool Never! {
    guard: state.guard_read()
    guard.value.open == number
}
// A commit that fails leaves the engine's transaction open, so it is rolled
// back before the failure is reported: the transaction ends either way.
// Either way every live binding over a table it wrote re-runs on its next
// read: after a commit it reads the committed rows, and after a failed one
// it drops anything read from the transaction's own uncommitted writes.
priv db_commit: fn(state: Shared<DBState>) DBError! {
    guard := state.guard_edit()
    guard.value.open = 0
    if driver_closed(guard.value.driver) -> return Err(db_error("could not commit: the database is closed"))
    committed: __driver_commit(guard.value.driver)
    if !committed {
        _: __driver_rollback(guard.value.driver)
    }
    loop table in guard.value.written -> app.__live_invalidate_all(live_source(table))
    guard.value.written = [String]{}
    if !committed -> return Err(db_error("could not commit, so the transaction was rolled back"))
    Ok()
}
// A rollback undoes the writes since the last begin, so every live binding
// over a table they touched re-runs on its next read.
priv db_rollback: fn(state: Shared<DBState>) DBError! {
    guard := state.guard_edit()
    guard.value.open = 0
    if driver_closed(guard.value.driver) -> return Err(db_error("could not roll back: the database is closed"))
    rolled: __driver_rollback(guard.value.driver)
    loop table in guard.value.written -> app.__live_invalidate_all(live_source(table))
    guard.value.written = [String]{}
    if !rolled -> return Err(db_error("could not roll back the transaction"))
    Ok()
}
priv db_shutdown: fn(state: Shared<DBState>) -> Bool Never! {
    guard := state.guard_edit()
    __driver_shutdown(guard.value.driver)
}

// A write marks every live binding over its table for a re-run once the
// write is committed: at once outside a transaction, and at the commit or
// rollback inside one. A binding re-run on another connection before the
// commit reads the old rows, so a mark made before the commit would leave
// that old result stored as current. A write that changed no row leaves its
// table's bindings current; a schema statement always marks them.
priv scope_execute: fn(scope: DBScope, sql: SQL, allow_schema: Bool) -> Int DBError! {
    scoped: policy_apply(sql, scope.policy, scope.user, allow_schema) ?? return Err(err)
    guard := scope.state.guard_edit()
    if driver_closed(guard.value.driver) -> return Err(db_closed())
    changed: __driver_execute(guard.value.driver, scoped.text, scoped.values) ?? return Err(err)
    if sql_table(scoped) == .Val(table) && (changed > 0 || sql_schema(scoped)) {
        if guard.value.open != 0 {
            if !guard.value.written.contains(table) -> guard.value.written.push(table.copy())
        } else {
            app.__live_invalidate_all(live_source(table))
        }
    }
    Ok(changed)
}

// A read made while a live binding's source runs joins that binding's read
// set first (app.live_reads), so a write to its table re-runs the binding.
priv scope_query: fn(scope: DBScope, sql: SQL, allow_schema: Bool) -> [[String: DBValue]] DBError! {
    scoped: policy_apply(sql, scope.policy, scope.user, allow_schema) ?? return Err(err)
    if app.live_reads.running() && sql_table(scoped) == .Val(table) -> app.live_reads.record(live_source(table))
    guard := scope.state.guard_edit()
    if driver_closed(guard.value.driver) -> return Err(db_closed())
    __driver_query(guard.value.driver, scoped.text, scoped.values)
}

// ---- live queries (#1158) ----------------------------------

// A DBScope.live binding's source in the shared live registry names the table
// its SELECT reads; a write to that table re-runs every binding over it, and
// every binding whose source read it (app.live_reads).
priv live_source: fn(table: String) -> String Never! { "core.db.live:{table}" }

// The table `sql` reads or writes: the target of SELECT, INSERT, UPDATE or
// DELETE, or of CREATE, ALTER or DROP TABLE. None when it names no table.
priv sql_table: fn(sql: SQL) -> String? Never! {
    tokens: sql_tokens(sql.text.bytes())
    if tokens.len() == 0 -> return None
    kind: tokens[0].word.copy()
    if kind == "create" || kind == "alter" || kind == "drop" {
        at := sql_word_index(tokens, "table")
        if at < 0 -> return None
        at += 1
        loop at < tokens.len() && (tokens[at].word == "if" || tokens[at].word == "not" || tokens[at].word == "exists") { at += 1 }
        if at >= tokens.len() -> return None
        return Val(tokens[at].word.copy())
    }
    if kind != "select" && kind != "insert" && kind != "update" && kind != "delete" -> return None
    target: sql_target_index(tokens, kind)
    if target < 0 -> return None
    Val(tokens[target].word.copy())
}

// Whether `sql` is a CREATE, ALTER or DROP statement, which changes its
// table's shape however many rows it reports.
priv sql_schema: fn(sql: SQL) -> Bool Never! {
    tokens: sql_tokens(sql.text.bytes())
    if tokens.len() == 0 -> return false
    kind: tokens[0].word
    kind == "create" || kind == "alter" || kind == "drop"
}

// ---- transactions and migrations -----------------------------------------

transaction: fn(scope: DBScope, name: String, steps: [SQL]) -[DB, Time.Wait]> Int DBError! {
    tx: db_begin(scope.state, false) ?? return Err(db_error("could not begin transaction: {name}"))
    done: transaction_steps(scope, steps) ?? {
        tx.rollback().drop("the failed step is the reported failure")
        return Err(err)
    }
    tx.commit() ?? return Err(db_error("could not commit transaction"))
    Ok(done)
}
priv transaction_steps: fn(scope: DBScope, steps: [SQL]) -> Int DBError! {
    done := 0
    loop sql in steps {
        _: scope_execute(scope, sql, false) ?? return Err(err)
        done += 1
    }
    Ok(done)
}

priv ledger_schema: fn() -> String Never! {
    "CREATE TABLE IF NOT EXISTS __jet_migrations (sequence INTEGER PRIMARY KEY AUTOINCREMENT, transition_key TEXT NOT NULL UNIQUE, migration_key TEXT NOT NULL, target TEXT NOT NULL, target_identity TEXT NOT NULL, database_identity TEXT NOT NULL, source_identity TEXT NOT NULL, schema_identity TEXT NOT NULL, tool_identity TEXT NOT NULL, operation TEXT NOT NULL, status TEXT NOT NULL, from_version INTEGER NOT NULL, to_version INTEGER NOT NULL, step_count INTEGER NOT NULL, step_ids TEXT NOT NULL, checksum TEXT NOT NULL, lock_mode TEXT NOT NULL, risk TEXT NOT NULL, started_unix_ms INTEGER NOT NULL, finished_unix_ms INTEGER NOT NULL, error TEXT)"
}
priv ledger_columns: fn() -> [String] Never! {
    [String]{"sequence", "transition_key", "migration_key", "target", "target_identity", "database_identity", "source_identity", "schema_identity", "tool_identity", "operation", "status", "from_version", "to_version", "step_count", "step_ids", "checksum", "lock_mode", "risk", "started_unix_ms", "finished_unix_ms", "error"}
}

priv LedgerRow: struct {
    transition_key: String
    migration_key: String
    target: String
    target_identity: String
    database_identity: String
    source_identity: String
    schema_identity: String
    operation: String
    status: String
    from_version: Int
    to_version: Int
    step_count: Int
    step_ids: Int
    checksum: String
}

priv ledger_value: fn(row: [String: DBValue], key: String) -> DBValue DBError! {
    value: row.get(key) ?? return Err(db_error("migration ledger row has no `{key}` field"))
    Ok(value)
}
priv ledger_text: fn(row: [String: DBValue], key: String) -> String DBError! {
    value: ledger_value(row, key) ?? return Err(err)
    if value == .Text(text) -> return Ok(text.copy())
    Err(db_error("expected text, got {render_value(value)}"))
}
priv ledger_count: fn(row: [String: DBValue], key: String) -> Int DBError! {
    value: ledger_value(row, key) ?? return Err(err)
    if value == .Int(number) {
        if number < 0 -> return Err(db_error("migration ledger `{key}` is negative"))
        return Ok(number)
    }
    Err(db_error("expected an int, got {render_value(value)}"))
}
priv ledger_row: fn(row: [String: DBValue]) -> LedgerRow DBError! {
    transition_key: ledger_text(row, "transition_key") ?? return Err(err)
    migration_key: ledger_text(row, "migration_key") ?? return Err(err)
    operation: ledger_text(row, "operation") ?? return Err(err)
    status: ledger_text(row, "status") ?? return Err(err)
    step_ids_text: ledger_text(row, "step_ids") ?? return Err(err)
    step_ids: if step_ids_text.len() == 0 -> 0 else -> step_ids_text.split("\n").len()
    step_count: ledger_count(row, "step_count") ?? return Err(err)
    _started: ledger_count(row, "started_unix_ms") ?? return Err(err)
    _finished: ledger_count(row, "finished_unix_ms") ?? return Err(err)
    lock: ledger_text(row, "lock_mode") ?? return Err(err)
    if lock != "shared" && lock != "exclusive" -> return Err(db_error("unknown migration lock mode `{lock}`"))
    target: ledger_text(row, "target") ?? return Err(err)
    target_identity: ledger_text(row, "target_identity") ?? return Err(err)
    source_identity: ledger_text(row, "source_identity") ?? return Err(err)
    schema_identity: ledger_text(row, "schema_identity") ?? return Err(err)
    database_identity: ledger_text(row, "database_identity") ?? return Err(err)
    _tool: ledger_text(row, "tool_identity") ?? return Err(err)
    from_version: ledger_count(row, "from_version") ?? return Err(err)
    to_version: ledger_count(row, "to_version") ?? return Err(err)
    checksum: ledger_text(row, "checksum") ?? return Err(err)
    _risk: ledger_text(row, "risk") ?? return Err(err)
    error_value: ledger_value(row, "error") ?? return Err(err)
    if error_value == {
        .Null -> {}
        .Text(_) -> {}
        .Int(_) | .Float(_) | .Bool(_) | .Blob(_) -> return Err(db_error("expected text, got {render_value(error_value)}"))
    }
    Ok(LedgerRow{
        transition_key: transition_key, migration_key: migration_key, target: target,
        target_identity: target_identity, database_identity: database_identity,
        source_identity: source_identity, schema_identity: schema_identity,
        operation: operation, status: status, from_version: from_version,
        to_version: to_version, step_count: step_count, step_ids: step_ids, checksum: checksum,
    })
}

// The first reason a `direct` ledger row disagrees with canonical state.
priv ledger_drift: fn(row: LedgerRow, current: Int) -> String? Never! {
    key: row.transition_key
    if row.target_identity != "direct" -> return Val("migration transition `{key}` has a foreign target identity")
    if row.database_identity != "runtime" -> return Val("migration transition `{key}` has a foreign database identity")
    if row.source_identity != "jet.db.runtime" -> return Val("migration transition `{key}` was created from a different migration catalog")
    if row.schema_identity != "jet.db.migration/v2" -> return Val("migration transition `{key}` has a mismatched schema identity")
    if row.step_count != row.step_ids -> return Val("migration transition `{key}` has an invalid step count")
    if row.status != "applied" -> return Val("migration transition `{key}` has unresolved status `{row.status}`")
    if row.operation == "apply" || row.operation == "rollback" {
        if row.from_version != current -> return Val("migration transition `{key}` starts at {row.from_version}, but canonical state is at {current}")
        return None
    }
    if row.operation != "direct" -> return Val("migration transition `{key}` has unknown operation `{row.operation}`")
    None
}

// Direct runtime migrations: target `direct`, one exclusive transaction.
priv migration_validate: fn(name: String, steps: [SQL]) -> DBError? Never! {
    key: name.bytes()
    if key.len() == 0 || sql_has_control(key, false) -> return Val(db_error("migration migration key is empty or contains control characters"))
    loop sql in steps {
        text: sql.text.bytes()
        if sql_blank(text, 0, text.len()) || sql_has_control(text, false) -> return Val(db_error("migration step contains empty or invalid SQL metadata"))
    }
    None
}

// Applies `steps` inside the caller's transaction. Returns -1 for an
// idempotent replay of the latest applied migration with the same checksum.
priv migration_apply: fn(scope: DBScope, name: String, steps: [SQL]) -> Int DBError! {
    _: scope_execute(scope, sql_raw(ledger_schema()), true) ?? return Err(err)
    columns: scope_query(scope, sql_raw("PRAGMA table_info(__jet_migrations)"), true) ?? return Err(err)
    canonical: ledger_columns()
    if columns.len() != canonical.len() -> return Err(db_error("migration ledger uses a non-canonical schema"))
    loop index in 0..<columns.len() {
        column: row_text(columns[index], "name") ?? ""
        if column != canonical[index] -> return Err(db_error("migration ledger uses a non-canonical schema"))
    }
    stored: scope_query(scope, sql_raw("SELECT transition_key, migration_key, target, target_identity, database_identity, source_identity, schema_identity, tool_identity, operation, status, from_version, to_version, step_count, step_ids, checksum, lock_mode, risk, started_unix_ms, finished_unix_ms, error FROM __jet_migrations ORDER BY sequence"), true) ?? return Err(err)
    rows := [LedgerRow]{}
    loop entry in stored {
        parsed: ledger_row(entry) ?? return Err(err)
        rows.push(parsed)
    }
    drift := [String]{}
    current := 0
    latest := -1
    loop index in 0..<rows.len() {
        row: rows[index]
        if row.target == "direct" {
            if row.migration_key == name -> latest = index
            if {
                ledger_drift(row, current) == .Val(message) -> {
                    drift.push(message.copy())
                }
                row.operation == "apply" || row.operation == "rollback" -> {
                    current = row.to_version
                }
            }
        }
    }
    if drift.len() > 0 -> return Err(db_error("migration target `direct` has unreconciled state: {drift.join("; ")}"))
    checksum: migration_checksum(name, steps)
    predecessor := ""
    if latest >= 0 {
        previous: rows[latest]
        if previous.status == "applied" && previous.operation == "direct" {
            if previous.checksum == checksum -> return Ok(-1)
            return Err(db_error("migration `{name}` checksum changed"))
        }
        predecessor = previous.transition_key.copy()
    }
    transition: migration_transition_key(name, checksum, predecessor)
    loop sql in steps {
        _: scope_execute(scope, sql, true) ?? return Err(err)
    }
    step_ids := [String]{}
    loop index in 0..<steps.len() -> step_ids.push(migration_step_id(index + 1, steps[index]))
    // Direct migrations run under the DB authority alone; without a granted
    // wall clock the ledger records 0 for both timestamps.
    values: [DBValue]{
        .Text(transition), .Text(name.copy()), .Text("direct"), .Text("direct"), .Text("runtime"),
        .Text("jet.db.runtime"), .Text("jet.db.migration/v2"), .Text("jet-runtime"), .Text("direct"),
        .Text("applied"), .Int(0), .Int(0), .Int(steps.len()), .Text(step_ids.join("\n")),
        .Text(checksum.copy()), .Text("exclusive"), .Text("runtime migration"), .Int(0), .Int(0), .Null,
    }
    insert: SQL{text: "INSERT INTO __jet_migrations (transition_key, migration_key, target, target_identity, database_identity, source_identity, schema_identity, tool_identity, operation, status, from_version, to_version, step_count, step_ids, checksum, lock_mode, risk, started_unix_ms, finished_unix_ms, error) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", values: values}
    _: scope_execute(scope, insert, true) ?? return Err(err)
    Ok(steps.len())
}

migrate: fn(scope: DBScope, name: String, steps: [SQL]) -[DB, Time.Wait]> Int DBError! {
    if migration_validate(name, steps) == .Val(failure) -> return Err(failure.copy())
    tx: db_begin(scope.state, true) ?? return Err(db_error("could not begin migration `{name}`"))
    applied: migration_apply(scope, name, steps) ?? {
        tx.rollback().drop("the failed migration step is the reported failure")
        return Err(err)
    }
    tx.commit() ?? return Err(db_error(if applied < 0 -> "could not commit idempotent migration read" else -> "could not commit migration `{name}`"))
    Ok(if applied < 0 -> 0 else -> applied)
}

// FNV-1a 64 identities, byte-compatible with the existing migration ledgers.
priv fnv_offset: fn() -> U64 Never! { U64{14695981039346656037} }
priv fnv_byte: fn(hash: U64, byte: Int) -> U64 Never! { wrapping((hash.bit_xor(U64{byte})) * U64{1099511628211}) }
priv hash_field: fn(hash: U64, value: String) -> U64 Never! {
    bytes: value.bytes()
    out := hash
    length := bytes.len()
    loop _ in 0..<8 {
        out = fnv_byte(out, length.bit_and(255))
        length = length >> 8
    }
    loop byte in bytes -> out = fnv_byte(out, Int{byte})
    fnv_byte(out, 255)
}
priv float_bits_text: fn(value: Float) -> String Never! {
    bits: math.to_bits(value)
    if bits >= 0 -> return "{bits}"
    unsigned: wrapping(U64{bits + 9223372036854775807 + 1} + U64{9223372036854775808})
    "{unsigned}"
}
priv hash_value: fn(hash: U64, value: DBValue) -> U64 Never! {
    if value == {
        .Null -> hash_field(hash, "N")
        .Int(number) -> hash_field(hash_field(hash, "I"), "{number}")
        .Float(number) -> hash_field(hash_field(hash, "F"), float_bits_text(number))
        .Text(text) -> hash_field(hash_field(hash, "T"), text)
        .Bool(flag) -> hash_field(hash, if flag -> "B1" else -> "B0")
        .Blob(bytes) -> {
            out := hash_field(hash, "X")
            loop byte in bytes -> out = fnv_byte(out, Int{byte})
            fnv_byte(out, 255)
        }
    }
}
priv hash_sql: fn(hash: U64, sql: SQL) -> U64 Never! {
    out := hash_field(hash, sql.text)
    out = hash_field(out, "{sql.values.len()}")
    loop value in sql.values -> out = hash_value(out, value)
    out
}
priv hex16: fn(hash: U64) -> String Never! {
    digits: "0123456789abcdef".bytes()
    out := [U8]{}
    loop index in 0..<16 {
        nibble: Int{(hash >> (60 - index * 4)).bit_and(U64{15})}
        out.push(digits[nibble])
    }
    String.from_bytes(out) ?? ""
}
priv migration_checksum: fn(name: String, steps: [SQL]) -> String Never! {
    hash := fnv_offset()
    fields: [String]{"jet.db.migration/v2", "direct", name.copy(), "direct", "direct", "runtime", "jet.db.runtime", "jet.db.migration/v2", "jet-runtime", "0", "0", "exclusive", "runtime migration", "{steps.len()}"}
    loop field in fields {
        hash = hash_field(hash, field)
    }
    loop index in 0..<steps.len() {
        hash = hash_field(hash, "{index + 1}")
        hash = hash_field(hash, "exclusive")
        hash = hash_field(hash, "runtime migration")
        hash = hash_sql(hash, steps[index])
        hash = hash_field(hash, "no-inverse")
    }
    "migration-v2:{hex16(hash)}"
}
priv migration_step_id: fn(ordinal: Int, sql: SQL) -> String Never! {
    hash := hash_field(fnv_offset(), "{ordinal}")
    hash = hash_field(hash, "exclusive")
    hash = hash_field(hash, "runtime migration")
    hash = hash_sql(hash, sql)
    "step:{hex16(hash)}"
}
priv migration_transition_key: fn(name: String, checksum: String, predecessor: String) -> String Never! {
    hash := fnv_offset()
    fields: [String]{"transition", "direct", name.copy(), "direct", checksum.copy(), predecessor.copy()}
    loop field in fields {
        hash = hash_field(hash, field)
    }
    "transition:{hex16(hash)}"
}

// ---- pools ---------------------------------------------------------------
// Admission is FIFO by ticket; waiting sleeps (`Time.Wait`) and deadlines use
// the pure monotonic clock, so no wall-clock authority is involved.

priv PoolState: struct {
    url: String
    lifecycle: __PoolLifecycle
    max: Int
    available: [__Driver]
    leased: Int
    opening: Int
    waiters: [Int]
    next_ticket: Int
    acquires: Int
    releases: Int
    timeouts: Int
    open_failures: Int
    unhealthy: Int
    replacements: Int
    replacement_failures: Int
}

DBPool: struct {
    state: Shared<PoolState>

    acquire: fn(self, *, deadline: Duration{30000ms}) -[DB, Time.Wait]> DBLease DBError! {
        deadline_ns: pool_deadline(deadline)
        waiter := PoolWaiter{pool: self.state.copy(), ticket: -1}
        defer close(waiter)
        loop {
            claim := pool_claim(self.state, waiter.ticket, deadline_ns)
            if claim.failure == .Val(failure) -> return Err(failure.copy())
            if claim.drivers.len() > 0 {
                driver: claim.drivers.remove(0, .Slot) ?? panic("database pool lost a claimed connection")
                return Ok(DBLease{state: Shared{LeaseState{pool: self.state.copy(), drivers: [__Driver]{driver.move()}}}})
            }
            waiter.ticket = claim.ticket
            if !claim.retry -> time.sleep(1ms)
        }
    }
    ready: fn(self) -[DB, Time.Wait]> Bool DBError! {
        state: pool_ready_state(self.state)
        if state == 0 -> return Ok(false)
        if state == 1 -> return Ok(true)
        lease: self.acquire() ?? return Err(err)
        lease.close() ?? return Err(err)
        Ok(true)
    }
    drain: fn(self, *, deadline: Duration{30000ms}) -[DB, Time.Wait]> DBPoolReceipt DBError! {
        deadline_ns: pool_deadline(deadline)
        loop {
            if pool_drain_step(self.state, deadline_ns) == {
                .Ok(step) -> { if step == .Val(receipt) -> return Ok(receipt) }
                .Err(failure) -> return Err(failure)
            }
            time.sleep(1ms)
        }
    }
    receipt: fn(self) -[DB]> DBPoolReceipt Never! {
        guard: self.state.guard_read()
        pool_receipt(guard.value)
    }
}

priv LeaseState: struct {
    pool: Shared<PoolState>
    drivers: [__Driver]

    impl Close {
        close: fn(&&self) {
            drivers := self.drivers.move()
            loop drivers.len() > 0 {
                driver: drivers.remove(0, .Slot) ?? panic("database lease lost its connection")
                pool_release(self.pool, driver)
            }
        }
    }
}
// A queued acquire's place in line. Closing it leaves the queue, so an acquire
// that ends early (its task cancelled at the wait) never blocks later waiters.
priv PoolWaiter: struct {
    pool: Shared<PoolState>
    ticket: Int

    impl Close {
        close: fn(&&self) {
            if self.ticket < 0 -> return
            guard := self.pool.guard_edit()
            pool_remove_waiter(guard.value, self.ticket)
        }
    }
}
DBLease: struct {
    state: Shared<LeaseState>

    close: fn(self) DBError! -[DB]> {
        guard := self.state.guard_edit()
        if guard.value.drivers.len() == 0 -> return Ok()
        driver: guard.value.drivers.remove(0, .Slot) ?? return Ok()
        pool_release(guard.value.pool, driver)
        Ok()
    }

    impl Display { display: fn(self) -> String { "db.lease" } }
}
priv pool_deadline: fn(deadline: Duration) -> Int Never! {
    now: rt.clock_mono_ns()
    if deadline.ns > 9223372036854775807 - now -> return 9223372036854775807
    now + deadline.ns
}
priv pool_expired: fn(deadline_ns: Int) -> Bool Never! { rt.clock_mono_ns() >= deadline_ns }
priv pool_state_error: fn(lifecycle: __PoolLifecycle) -> DBError Never! {
    if lifecycle == {
        .Open -> db_error("database pool is unavailable")
        .Draining -> db_error("database pool is draining")
        .Drained -> db_error("database pool is drained")
    }
}
priv pool_receipt: fn(state: PoolState) -> DBPoolReceipt Never! {
    DBPoolReceipt{
        lifecycle: state.lifecycle, max: state.max, available: state.available.len(), leased: state.leased,
        opening: state.opening, ready: state.lifecycle == .Open && state.available.len() + state.leased > 0,
        acquires: state.acquires, releases: state.releases, timeouts: state.timeouts,
        open_failures: state.open_failures, unhealthy: state.unhealthy, replacements: state.replacements,
        replacement_failures: state.replacement_failures,
    }
}
priv pool_mark_drained: fn(state: &PoolState) Never! {
    if state.lifecycle == .Draining && state.available.len() == 0 && state.leased == 0 && state.opening == 0 -> state.lifecycle = .Drained
}
priv pool_remove_waiter: fn(state: &PoolState, ticket: Int) Never! {
    loop index in 0..<state.waiters.len() {
        if state.waiters[index] == ticket {
            _: state.waiters.remove(index, .Slot)
            return
        }
    }
}
priv pool_replace_one: fn(state: &PoolState) Never! {
    if state.lifecycle != .Open || state.available.len() + state.leased + state.opening >= state.max -> return
    driver := __driver_open(state.url) ?? {
        state.replacement_failures += 1
        return
    }
    if !__driver_health(driver) {
        state.unhealthy += 1
        state.replacement_failures += 1
        close(driver)
        return
    }
    state.available.push(driver)
    state.replacements += 1
}
priv pool_release: fn(pool: Shared<PoolState>, driver: &&__Driver) Never! {
    held := driver.move()
    fit: __driver_reset(held)
    guard := pool.guard_edit()
    if guard.value.leased > 0 -> guard.value.leased -= 1
    guard.value.releases += 1
    if guard.value.lifecycle == .Open && fit {
        guard.value.available.push(held)
        return
    }
    if !fit -> guard.value.unhealthy += 1
    close(held)
    pool_mark_drained(guard.value)
    if !fit -> pool_replace_one(guard.value)
}

priv PoolClaim: struct {
    drivers: [__Driver]
    failure: DBError?
    ticket: Int
    retry: Bool
}

// One admission attempt under the pool lock: lease a healthy idle driver,
// open a new one within `max`, or queue the ticket to wait.
priv pool_claim: fn(pool: Shared<PoolState>, ticket: Int, deadline_ns: Int) -> PoolClaim Never! {
    claim := PoolClaim{drivers: [__Driver]{}, failure: None, ticket: ticket, retry: false}
    guard := pool.guard_edit()
    if guard.value.lifecycle != .Open {
        if ticket >= 0 -> pool_remove_waiter(guard.value, ticket)
        claim.ticket = -1
        claim.failure = Val(pool_state_error(guard.value.lifecycle))
        return claim
    }
    turn: if ticket >= 0 -> guard.value.waiters.len() > 0 && guard.value.waiters[0] == ticket else -> guard.value.waiters.len() == 0
    if turn && guard.value.available.len() > 0 {
        if ticket >= 0 -> pool_remove_waiter(guard.value, ticket)
        claim.ticket = -1
        driver := guard.value.available.pop() ?? panic("database pool lost an idle connection")
        healthy: __driver_health(driver)
        expired: pool_expired(deadline_ns)
        if healthy && !expired {
            guard.value.leased += 1
            guard.value.acquires += 1
            claim.drivers.push(driver)
            return claim
        }
        close(driver)
        if !healthy -> guard.value.unhealthy += 1
        if expired {
            guard.value.timeouts += 1
            claim.failure = Val(db_error("database pool acquisition deadline exceeded"))
        }
        claim.retry = true
        return claim
    }
    if turn && guard.value.available.len() + guard.value.leased + guard.value.opening < guard.value.max {
        if ticket >= 0 -> pool_remove_waiter(guard.value, ticket)
        claim.ticket = -1
        driver := __driver_open(guard.value.url) ?? {
            guard.value.open_failures += 1
            if {
                pool_expired(deadline_ns) -> {
                    guard.value.timeouts += 1
                    claim.failure = Val(db_error("database pool acquisition deadline exceeded"))
                }
                else -> {
                    claim.failure = Val(db_error("database pool backend open failed"))
                }
            }
            return claim
        }
        healthy: __driver_health(driver)
        expired: pool_expired(deadline_ns)
        if !healthy || expired {
            if !healthy -> guard.value.unhealthy += 1
            if expired -> guard.value.timeouts += 1
            close(driver)
            claim.failure = Val(db_error(if expired -> "database pool acquisition deadline exceeded" else -> "database pool opened an unhealthy connection"))
            return claim
        }
        guard.value.leased += 1
        guard.value.acquires += 1
        claim.drivers.push(driver)
        return claim
    }
    if claim.ticket < 0 {
        claim.ticket = guard.value.next_ticket
        guard.value.next_ticket += 1
        guard.value.waiters.push(claim.ticket)
    }
    if pool_expired(deadline_ns) {
        pool_remove_waiter(guard.value, claim.ticket)
        claim.ticket = -1
        guard.value.timeouts += 1
        claim.failure = Val(db_error("database pool acquisition deadline exceeded"))
    }
    claim
}

priv pool_drain_step: fn(pool: Shared<PoolState>, deadline_ns: Int) -> DBPoolReceipt? DBError! {
    guard := pool.guard_edit()
    if guard.value.lifecycle == .Open -> guard.value.lifecycle = .Draining
    loop guard.value.available.len() > 0 {
        driver: guard.value.available.pop() ?? panic("database pool lost an idle connection")
        close(driver)
    }
    pool_mark_drained(guard.value)
    if guard.value.lifecycle == .Drained -> return Ok(Val(pool_receipt(guard.value)))
    if pool_expired(deadline_ns) {
        guard.value.timeouts += 1
        return Err(db_error("database pool drain deadline exceeded"))
    }
    Ok(None)
}

// 0: not open, 1: already serving leases, 2: needs a probe lease.
priv pool_ready_state: fn(pool: Shared<PoolState>) -> Int Never! {
    guard: pool.guard_read()
    if guard.value.lifecycle != .Open -> return 0
    if guard.value.leased > 0 -> return 1
    2
}

pool: fn(url: String, *, max: Int) -[DB]> DBPool DBError! {
    if max <= 0 -> return Err(db_error("database pool max must be greater than zero"))
    Ok(DBPool{state: Shared{PoolState{
        url: url.copy(), lifecycle: .Open, max: max, available: [__Driver]{}, leased: 0, opening: 0,
        waiters: [Int]{}, next_ticket: 0, acquires: 0, releases: 0, timeouts: 0, open_failures: 0,
        unhealthy: 0, replacements: 0, replacement_failures: 0,
    }}})
}

// ---- typed rows ----------------------------------------------------------

priv dyn_value: fn(value: DBValue) -> Dyn Never! {
    if value == {
        .Null -> Dyn.Null
        .Int(number) -> Dyn.Int(number)
        .Float(number) -> Dyn.Float(number)
        .Text(text) -> Dyn.Text(text)
        .Bool(flag) -> Dyn.Bool(flag)
        .Blob(bytes) -> {
            items := [Dyn]{}
            loop byte in bytes -> items.push(Dyn.Int(Int{byte}))
            Dyn.Array(items)
        }
    }
}

// Typed `decode<T>(row)`: sema supplies `names`, the column name and decode
// key of each of T's fields whose column differs from its key; every other
// column decodes under its own name.
decode: fn<T: Decode>(row: [String: DBValue], names: [(db_name: String, key: String)]) -> T [FieldError]! {
    entries := [(key: String, value: Dyn)]{}
    loop (column, value) in row {
        key := column.copy()
        loop rename in names {
            if rename.db_name == column {
                key = rename.key.copy()
                break
            }
        }
        entries.push((key: key, value: dyn_value(value)))
    }
    tree: stream.object_from_entries(entries)
    if tree.decode<T>() == {
        .Ok(value) -> Ok(value)
        .Err(failures) -> Err(failures)
    }
}

// One cached prepared statement: its engine statement slot (-1 when SQLite
// prepared no statement, as for empty SQL) and the trimmed SQL it caches.
CachedStatement: struct { stmt: Int, sql: String }

// rusqlite 0.31.0: cache16,
// READWRITE|CREATE|URI|NOMUTEX, extended codes and a 5000ms busy timeout.
// The connection is the Jet engine's; `live` is false once it is shut down.
// The fields are `priv`: only core.db opens, drives and closes a connection.
__Driver: struct {
    priv database: conn.Conn
    priv cache: [CachedStatement]
    priv live: Bool

    impl Close {
        close: fn(&&self) {
            if !self.live -> return
            held := __Driver{database: self.database.move(), cache: self.cache.move(), live: true}
            _: __driver_shutdown(held)
        }
    }
}
priv driver_closed: fn(driver: __Driver) -> Bool Never! { !driver.live }

error: fn(driver: __Driver) -> DBError Never! { DBError.Failed(prep.errmsg(driver.database)) }

// Backend open reports None; public open preserves E3001, while the queue maps
// None to its existing Unavailable error. Failed opens close their connection.
priv nul_text: fn() -> String Never! { String.from_bytes([U8]{0}) ?? panic("NUL is one ASCII byte") }
__has_nul: fn(text: String) -> Bool Never! {
    loop byte in text.bytes() { if byte == (U8{0}) -> return true }
    false
}

__driver_open: fn(path: String) -> __Driver? Never! {
    // sqlite3_open_v2 takes a NUL-terminated filename, so a NUL never opens.
    if __has_nul(path) -> return None
    opened := prep.open_v2(path, 32838)
    database := opened.db.move()
    if opened.rc != base.OK {
        _: prep.close_v2(database)
        return None
    }
    _: prep.extended_result_codes(database, true)
    if prep.busy_timeout(database, 5000) != base.OK {
        _: prep.close_v2(database)
        return None
    }
    Val(__Driver{database: database.move(), cache: [CachedStatement]{}, live: true})
}
// Finalize every cached statement, oldest first.
priv driver_finalize_cache: fn(driver: &__Driver) Never! {
    loop driver.cache.len() > 0 {
        statement: driver.cache.remove(0, .Slot) ?? panic("SQLite cache lost a statement")
        _: prep.finalize_stmt(driver.database, statement.stmt)
    }
}
// Shut a shared connection down in place: later operations see it closed and
// the driver's own Close then does nothing.
__driver_shutdown: fn(driver: &__Driver) -> Bool Never! {
    if !driver.live -> return false
    driver_finalize_cache(driver)
    _: prep.close_v2(driver.database)
    driver.live = false
    true
}
control: fn(driver: &__Driver, sql: String) -> Bool Never! { prep.exec_sql(driver.database, sql.bytes()) == base.OK }
__driver_begin: fn(driver: &__Driver) -> Bool Never! { control(driver, "BEGIN") }
__driver_begin_immediate: fn(driver: &__Driver) -> Bool Never! { control(driver, "BEGIN IMMEDIATE") }
__driver_commit: fn(driver: &__Driver) -> Bool Never! { control(driver, "COMMIT") }
__driver_rollback: fn(driver: &__Driver) -> Bool Never! { control(driver, "ROLLBACK") }
__driver_reset: fn(driver: &__Driver) -> Bool Never! {
    if prep.get_autocommit(driver.database) -> return true
    __driver_rollback(driver)
}

prepare: fn(driver: &__Driver, sql: String) -> CachedStatement DBError! {
    // An unchanged template hits without allocating a trimmed String. Only a
    // different spelling needs the canonical trimmed-key comparison below.
    loop index in 0..<driver.cache.len() {
        if driver.cache[index].sql == sql {
            cached: driver.cache.remove(index, .Slot) ?? panic("SQLite cache index disappeared")
            return Ok(cached)
        }
    }
    key: sql.trim()
    loop index in 0..<driver.cache.len() {
        if driver.cache[index].sql == key {
            cached: driver.cache.remove(index, .Slot) ?? panic("SQLite cache index disappeared")
            return Ok(cached)
        }
    }
    text: key.bytes()
    if text.len() >= 2147483647 -> return Err(db_error("Error code 18: String or BLOB exceeds size limit"))
    prepared: prep.prepare_v3(driver.database, text, 1)
    if prepared.rc != base.OK {
        failure := error(driver)
        primary: prepared.rc.bit_and(255)
        // rusqlite: only Unknown primary errors (outside 2..26) acquire
        // modern_sqlite's SQL/offset diagnostic suffix.
        if primary < 2 || primary > 26 {
            offset: prep.error_offset(driver.database)
            if offset >= 0 -> failure = db_error("{failure.message()} in {key} at offset {offset}")
        }
        // SQLite hands back no statement on error; finalize(-1) does nothing.
        _: prep.finalize_stmt(driver.database, prepared.stmt)
        return Err(failure)
    }
    Ok(CachedStatement{stmt: prepared.stmt, sql: key})
}
release: fn(driver: &__Driver, statement: &&CachedStatement) Never! {
    if statement.stmt < 0 -> return
    // Reset this statement and clear its bindings before it returns to the cache.
    _: prep.reset_stmt(driver.database, statement.stmt)
    api.clear_bindings(driver.database, statement.stmt)
    if driver.cache.len() == 16 {
        oldest: driver.cache.remove(0, .Slot) ?? panic("SQLite cache lost its oldest statement")
        _: prep.finalize_stmt(driver.database, oldest.stmt)
    }
    driver.cache.push(statement)
}
// sqlite3_step(NULL) is SQLITE_MISUSE; empty SQL prepares no statement.
step_statement: fn(driver: &__Driver, statement: Int) -> Int Never! {
    if statement < 0 -> return base.MISUSE
    prep.step(driver.database, statement)
}
bind: fn(driver: &__Driver, statement: Int, params: [DBValue]) -> DBError? Never! {
    needed: if statement < 0 -> 0 else -> api.bind_parameter_count(driver.database, statement)
    if params.len() != needed -> return Val(db_error("Wrong number of parameters passed to query. Got {params.len()}, needed {needed}"))
    loop at in 0..<params.len() {
        index: at + 1
        status := base.OK
        if params[at] == {
            .Null -> status = api.bind_null(driver.database, statement, index)
            .Int(number) -> status = api.bind_int64(driver.database, statement, index, number)
            .Float(number) -> status = api.bind_double(driver.database, statement, index, number)
            .Bool(value) -> status = api.bind_int64(driver.database, statement, index, if value -> 1 else -> 0)
            .Text(text) -> {
                bytes: text.bytes()
                length: bytes.len()
                if length >= 2147483647 -> return Val(db_error("Error code 18: String or BLOB exceeds size limit"))
                // Empty TEXT binds empty text, never NULL.
                status = api.bind_text(driver.database, statement, index, Val(bytes), length)
            }
            .Blob(bytes) -> {
                length: bytes.len()
                if length >= 2147483647 -> return Val(db_error("Error code 18: String or BLOB exceeds size limit"))
                if length == 0 -> status = api.bind_zeroblob(driver.database, statement, index, 0)
                else -> status = api.bind_blob(driver.database, statement, index, Val(bytes), length)
            }
        }
        if status != base.OK -> return Val(error(driver))
    }
    None
}
__driver_execute: fn(driver: &__Driver, sql: String, params: [DBValue]) -> Int DBError! {
    statement: prepare(driver, sql) ?? return Err(err)
    if bind(driver, statement.stmt, params) == .Val(failure) {
        release(driver, statement)
        return Err(failure)
    }
    count := 0
    failure := DBError?{None}
    // Step, then reset, matching rusqlite execute_with_bound_parameters; copy
    // any SQLite error before another operation.
    status: step_statement(driver, statement.stmt)
    reset_status: if statement.stmt < 0 -> base.OK else -> prep.reset_stmt(driver.database, statement.stmt)
    if {
        status == base.DONE -> {
            if reset_status == base.OK -> count = prep.changes(driver.database)
            else -> failure = Val(error(driver))
        }
        status == base.ROW -> failure = Val(db_error("Execute returned results - did you mean to call query?"))
        else -> failure = Val(error(driver))
    }
    release(driver, statement)
    if failure == .Val(found_failure) -> return Err(found_failure)
    Ok(count)
}
// Preserve the old wire decoder's externally observable size/count limits
// without constructing a second serialized copy of the complete result.
decimal_width: fn(number: Int) -> Int Never! {
    rest := number
    width := if number < 0 -> 2 else -> 1
    loop rest >= 10 || rest <= -10 {
        // Truncating division: /% floors, which overcounts some negative widths.
        quotient := rest /% 10
        if rest < 0 && quotient * 10 != rest -> quotient += 1
        rest = quotient
        width += 1
    }
    width
}
tagged_width: fn(payload: Int) -> Int Never! { payload + decimal_width(payload) + 2 }
cell_wire_width: fn(value: DBValue) -> Int Never! {
    payload: if value == {
        .Null -> 0
        .Int(number) -> decimal_width(number)
        .Float(number) -> __float_text(number).len()
        .Text(text) -> text.count_bytes()
        .Bool(_) -> 1
        .Blob(bytes) -> bytes.len() * 2
    }
    tagged_width(payload)
}

__driver_query: fn(driver: &__Driver, sql: String, params: [DBValue]) -> [[String: DBValue]] DBError! {
    statement: prepare(driver, sql) ?? return Err(err)
    if bind(driver, statement.stmt, params) == .Val(failure) {
        release(driver, statement)
        return Err(failure)
    }
    rows := [[String: DBValue]]{}
    failure := DBError?{None}
    duplicate := false
    wire_rows := 0
    column_overflow := false
    // Copy every column into an owned value while its row is current.
    count: if statement.stmt < 0 -> 0 else -> api.column_count(driver.database, statement.stmt)
    names := [String]{}
    row_prefix := decimal_width(count) + 1
    loop index in 0..<count {
        name: api.column_name(driver.database, statement.stmt, index) ?? panic("Null pointer from sqlite3_column_name: Out of memory?")
        row_prefix += tagged_width(name.len())
        names.push(String.from_bytes(name) ?? "")
    }
    loop {
        status: step_statement(driver, statement.stmt)
        if status == base.DONE -> break
        if status != base.ROW {
            failure = Val(error(driver))
            break
        }
        row := [String: DBValue]{}
        loop at in 0..<count {
            value := DBValue.Null
            kind: api.column_type(driver.database, statement.stmt, at)
            if {
                kind == base.SQL_INTEGER -> value = DBValue.Int(api.column_int64(driver.database, statement.stmt, at))
                kind == base.SQL_FLOAT -> value = DBValue.Float(api.column_double(driver.database, statement.stmt, at))
                kind == base.SQL_TEXT -> {
                    text: api.column_text(driver.database, statement.stmt, at) ?? [U8]{}
                    // The Rust original maps invalid UTF-8 to "".
                    value = DBValue.Text(String.from_bytes(text) ?? "")
                }
                kind == base.SQL_BLOB -> value = DBValue.Blob(api.column_blob(driver.database, statement.stmt, at))
                else -> {}
            }
            wire_rows += cell_wire_width(value)
            if row.get(names[at]) == .Val(_) -> duplicate = true
            row[names[at].copy()] = value.move()
        }
        wire_rows += row_prefix
        if count > 100000 -> column_overflow = true
        rows.push(row)
    }
    release(driver, statement)
    if failure == .Val(found_failure) -> return Err(found_failure)
    if wire_rows + decimal_width(rows.len()) + 3 > 67108864 -> return Err(db_error("database result exceeds the wire-size limit"))
    if rows.len() > 1000000 -> return Err(db_error("database row count exceeds the wire limit"))
    if column_overflow -> return Err(db_error("database column count exceeds the wire limit"))
    if duplicate -> return Err(db_error("database row contains a duplicate column"))
    Ok(rows)
}
__driver_query_one: fn(driver: &__Driver, sql: String, params: [DBValue]) -> [String: DBValue]? DBError! {
    rows := __driver_query(driver, sql, params) ?? return Err(err)
    if rows.len() == 0 -> return Ok(None)
    first: rows.remove(0, .Slot) ?? panic("SQLite first row disappeared")
    Ok(Val(first))
}
__driver_health: fn(driver: &__Driver) -> Bool Never! {
    if __driver_query_one(driver, "SELECT 1", [DBValue]{}) == {
        .Ok(found) -> found != None
        .Err(_) -> false
    }
}


#Test("typed SQL rows preserve conversion and missing-column errors") {
    row: [String: DBValue]{"number": DBValue.Int(42), "text": DBValue.Text("jet"), "zero": DBValue.Int(0), "one": DBValue.Int(1)}
    assert_eq(row_int(row, "number") ?? -1, 42)
    assert_eq(row_float(row, "number") ?? -1.0, 42.0)
    assert_eq(row_text(row, "text") ?? "", "jet")
    assert_eq(row_bool(row, "zero") ?? true, false)
    assert_eq(row_bool(row, "one") ?? false, true)
    if row_value(row, "absent") == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert_eq(error.message(), "missing column `absent`")
    }
    if row_int(row, "text") == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert_eq(error.message(), "expected an int, got jet")
    }
    floating: [String: DBValue]{"value": DBValue.Float(1.0)}
    if row_int(floating, "value") == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert_eq(error.message(), "expected an int, got 1")
    }
    large: [String: DBValue]{"value": DBValue.Float(1e21)}
    if row_int(large, "value") == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert_eq(error.message(), "expected an int, got 1000000000000000000000")
    }
    blob: [String: DBValue]{"value": DBValue.Blob([U8]{1, 2})}
    if row_text(blob, "value") == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert_eq(error.message(), "expected text, got [1, 2]")
    }
}


#Test("SQLite driver preserves typed bindings, storage affinities and transaction behavior") {
    driver := __driver_open(":memory:") ?? panic("SQLite memory open failed")
    assert(__driver_begin(driver))
    _: __driver_execute(driver, "CREATE TABLE values_store (value INTEGER)", [DBValue]{}) ?? panic("SQLite create failed")
    assert_eq(__driver_execute(driver, "INSERT INTO values_store VALUES (?)", [DBValue]{.Int(17)}) ?? -1, 1)
    assert(__driver_rollback(driver))
    _: __driver_execute(driver, "CREATE TABLE values_store (value INTEGER)", [DBValue]{}) ?? panic("SQLite rollback did not undo schema")
    assert(__driver_begin(driver))
    _: __driver_execute(driver, "INSERT INTO values_store VALUES (?)", [DBValue]{.Int(42)}) ?? panic("SQLite insert failed")
    assert(__driver_commit(driver))
    selected: __driver_query(driver, "SELECT value FROM values_store", [DBValue]{}) ?? panic("SQLite select failed")
    assert_eq(row_int(selected[0], "value") ?? -1, 42)

    bindings: [DBValue]{.Null, .Int(9223372036854775807), .Int(-9223372036854775808), .Float(1.25), .Text(""), .Text("jet{nul_text()}λ"), .Bool(true), .Blob([U8]{}), .Blob([U8]{0, 1, 255})}
    rows: __driver_query(driver, "SELECT ? AS missing, ? AS largest, ? AS smallest, ? AS real, ? AS empty, ? AS text, ? AS flag, ? AS empty_blob, ? AS blob", bindings) ?? panic("SQLite bindings failed")
    row: rows[0]
    assert((row_value(row, "missing") ?? panic("missing null")).is_null())
    assert_eq(row_int(row, "largest") ?? 0, 9223372036854775807)
    assert_eq(row_int(row, "smallest") ?? 0, -9223372036854775808)
    assert_eq(row_float(row, "real") ?? 0.0, 1.25)
    assert_eq(row_text(row, "empty") ?? "not empty", "")
    assert_eq(row_text(row, "text") ?? "", "jet{nul_text()}λ")
    assert_eq(row_int(row, "flag") ?? 0, 1)
    assert_eq((row_value(row, "empty_blob") ?? panic("missing empty blob")).blob() ?? [U8]{1}, [U8]{})
    assert_eq((row_value(row, "blob") ?? panic("missing blob")).blob() ?? [U8]{}, [U8]{0, 1, 255})
    invalid_utf8: __driver_query(driver, "SELECT CAST(X'ff' AS TEXT) AS value", [DBValue]{}) ?? panic("SQLite text selection failed")
    assert_eq(row_text(invalid_utf8[0], "value") ?? "invalid", "")
    if __driver_query_one(driver, "SELECT value FROM values_store WHERE value = 0", [DBValue]{}) == {
        .Val(_) -> assert(false)
        .None -> {}
        .Err(_) -> assert(false)
    }
    assert(__driver_health(driver))
    assert(__driver_shutdown(driver))
}

#Test("SQLite driver builds an index over existing rows and keeps UNIQUE indexes unique") {
    driver := __driver_open(":memory:") ?? panic("SQLite memory open failed")
    _: __driver_execute(driver, "CREATE TABLE jobs (queue TEXT NOT NULL, state TEXT NOT NULL, due INTEGER NOT NULL, sequence INTEGER NOT NULL)", [DBValue]{}) ?? panic("SQLite create failed")
    loop n in 0..<40 {
        _: __driver_execute(driver, "INSERT INTO jobs VALUES (?, ?, ?, ?)", [DBValue]{.Text("q{n % 3}"), .Text(if n % 2 == 0 -> "ready" else -> "done"), .Int(100 - n), .Int(n)}) ?? panic("SQLite insert failed")
    }
    _: __driver_execute(driver, "CREATE INDEX IF NOT EXISTS jobs_due ON jobs (queue, state, due, sequence)", [DBValue]{}) ?? panic("SQLite create index failed")
    _: __driver_execute(driver, "CREATE INDEX IF NOT EXISTS jobs_due ON jobs (queue, state, due, sequence)", [DBValue]{}) ?? panic("SQLite repeated create index failed")
    _: __driver_execute(driver, "INSERT INTO jobs VALUES ('q1', 'ready', 1, 40)", [DBValue]{}) ?? panic("SQLite insert after index failed")
    // INDEXED BY reads the rows from the index alone: the refill wrote every
    // existing row and the later insert added its own.
    due: __driver_query(driver, "SELECT sequence FROM jobs INDEXED BY jobs_due WHERE queue = 'q1' AND state = 'ready' ORDER BY due", [DBValue]{}) ?? panic("SQLite indexed select failed")
    assert_eq(due.map(fn(row) { row_int(row, "sequence") ?? -1 }), [Int]{40, 34, 28, 22, 16, 10, 4})
    schema: __driver_query(driver, "SELECT sql FROM sqlite_master WHERE name = 'jobs_due'", [DBValue]{}) ?? panic("SQLite schema read failed")
    assert_eq(row_text(schema[0], "sql") ?? "", "CREATE INDEX jobs_due ON jobs (queue, state, due, sequence)")
    if __driver_execute(driver, "CREATE UNIQUE INDEX jobs_queue ON jobs (queue)", [DBValue]{}) == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert(error.message().contains("UNIQUE constraint failed: jobs.queue"))
    }
    _: __driver_execute(driver, "CREATE UNIQUE INDEX jobs_sequence ON jobs (sequence)", [DBValue]{}) ?? panic("SQLite unique index failed")
    if __driver_execute(driver, "INSERT INTO jobs VALUES ('q0', 'ready', 5, 3)", [DBValue]{}) == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert(error.message().contains("UNIQUE constraint failed: jobs.sequence"))
    }
    assert(__driver_shutdown(driver))
}

// Ordinary scope-end Close finalizes the driver's cached statements and then
// closes its connection when this probe returns; no explicit close here.
priv driver_cache_parity_probe: fn() Never! {
    driver := __driver_open(":memory:") ?? panic("SQLite open failed")
    loop number in 0..<20 {
        rows: __driver_query(driver, "SELECT {number} AS value", [DBValue]{}) ?? panic("SQLite cache prepare failed")
        assert_eq(row_int(rows[0], "value") ?? -1, number)
    }
    cached: __driver_query(driver, "  SELECT 19 AS value  ", [DBValue]{}) ?? panic("SQLite trimmed cache key failed")
    assert_eq(row_int(cached[0], "value") ?? -1, 19)
    assert(__driver_begin(driver))
    assert(__driver_reset(driver))
    assert(__driver_begin(driver))
    assert(__driver_rollback(driver))
    if __driver_execute(driver, "SELECT ? AS value", [DBValue]{.Int(1)}) == {
        .Ok(_) -> assert(false)
        .Err(failure) -> assert_eq(failure.message(), "Execute returned results - did you mean to call query?")
    }
    if __driver_query(driver, "SELECT ?", [DBValue]{}) == {
        .Ok(_) -> assert(false)
        .Err(failure) -> assert_eq(failure.message(), "Wrong number of parameters passed to query. Got 0, needed 1")
    }
    if __driver_query(driver, "SELECT 1 AS same, 2 AS same", [DBValue]{}) == {
        .Ok(_) -> assert(false)
        .Err(failure) -> assert_eq(failure.message(), "database row contains a duplicate column")
    }
    if __driver_query(driver, "SELEC invalid", [DBValue]{}) == {
        .Ok(_) -> assert(false)
        .Err(failure) -> assert(failure.message().contains(" in SELEC invalid at offset 0"))
    }
}

#Test("SQLite driver retains cache/error parity and releases every cached handle") {
    warm := __driver_open(":memory:") ?? panic("SQLite warmup failed")
    assert(__driver_shutdown(warm))
    assert(!__driver_shutdown(warm))
    assert(driver_closed(warm))
    driver_cache_parity_probe()
    // The cache keeps the 16 newest statements; finalizing them leaves the
    // connection with no statement.
    driver := __driver_open(":memory:") ?? panic("SQLite open failed")
    loop number in 0..<20 {
        _: __driver_query(driver, "SELECT {number} AS value", [DBValue]{}) ?? panic("SQLite cache prepare failed")
    }
    assert_eq(driver.cache.len(), 16)
    driver_finalize_cache(driver)
    assert_eq(driver.cache.len(), 0)
    assert_eq(driver.database.vdbe_head, -1)
    assert(__driver_shutdown(driver))
    if __driver_open("bad{nul_text()}filename") == .Val(_) -> assert(false)
    if __driver_open("/") == .Val(_) -> assert(false)
}

#Test("typed SQL literals join their pieces with placeholders") {
    sql: __sql_literal([String]{"SELECT ", " FROM t WHERE a = ", ""}, [DBValue]{.Int(1), .Text("x")})
    assert_eq(sql.text, "SELECT ? FROM t WHERE a = ?")
    assert_eq(sql.values, [DBValue]{.Int(1), .Text("x")})
    assert_eq(__sql_literal([String]{"SELECT 1"}, [DBValue]{}).text, "SELECT 1")
}

#Test("row policies scope SQL to one table and bind the owner") {
    owned: RowPolicy{table: "tasks", owner: true}
    select: policy_apply(SQL{text: "SELECT title FROM tasks WHERE done = ? ORDER BY title", values: [DBValue]{.Int(0)}}, owned, "alice", false) ?? panic("select")
    assert_eq(select.text, "SELECT title FROM tasks WHERE (done = ?) AND owner = ? ORDER BY title")
    assert_eq(select.values, [DBValue]{.Int(0), .Text("alice")})
    bare: policy_apply(sql_raw("SELECT title FROM tasks"), owned, "alice", false) ?? panic("bare")
    assert_eq(bare.text, "SELECT title FROM tasks WHERE owner = ?")
    assert_eq(bare.values, [DBValue]{.Text("alice")})
    insert: policy_apply(SQL{text: "INSERT INTO tasks (owner, title) VALUES (?, ?)", values: [DBValue]{.Text("bob"), .Text("one")}}, owned, "alice", false) ?? panic("insert")
    assert_eq(insert.values, [DBValue]{.Text("alice"), .Text("one")})
    open: RowPolicy{table: "tasks", owner: false}
    same: policy_apply(sql_raw("SELECT * FROM tasks LIMIT 1"), open, "alice", false) ?? panic("open")
    assert_eq(same.text, "SELECT * FROM tasks LIMIT 1")
    schema: policy_apply(sql_raw("CREATE TABLE tasks (owner TEXT)"), open, "alice", true) ?? panic("schema")
    assert_eq(schema.text, "CREATE TABLE tasks (owner TEXT)")
    // SQL that targets no table or another table runs unchanged (#6070).
    outside_sql: [String]{"SELECT 1", "SELECT title FROM other WHERE id = 1", "INSERT INTO other (title) VALUES ('x')"}
    loop text in outside_sql {
        outside: policy_apply(sql_raw(text), owned, "alice", false) ?? panic("outside `{text}`")
        assert_eq(outside.text, text)
        assert_eq(outside.values.len(), 0)
    }
    rejected: [(sql: String, message: String)]{
        (sql: "SELECT title FROM other JOIN tasks", message: "policy-scoped SQL that reads `tasks` must target it as its one simple table"),
        (sql: "SELECT title FROM other WHERE owner IN (SELECT owner FROM tasks)", message: "policy-scoped SQL that reads `tasks` must target it as its one simple table"),
        (sql: "SELECT 1 FROM main.tasks", message: "policy-scoped SQL that reads `tasks` must target it as its one simple table"),
        (sql: "SELECT 1 FROM tasks; DROP TABLE tasks", message: "policy-scoped SQL must be one statement without control characters"),
        (sql: "SELECT * FROM tasks -- note", message: "policy-scoped SQL cannot contain comments"),
        (sql: "CREATE TABLE tasks (x)", message: "schema and transaction-control SQL is only allowed in db.migrate or through the scope transaction controls"),
        (sql: "SELECT * FROM tasks JOIN other", message: "policy-scoped SQL must name one simple target table without joins or subqueries"),
        (sql: "UPDATE tasks SET owner = 'bob' WHERE id = 1", message: "owner policy does not allow changing the owner column"),
        (sql: "VACUUM", message: "row policy supports SELECT, INSERT, UPDATE, and DELETE only"),
        (sql: "SELECT * FROM __jet_migrations", message: "migration metadata is managed only by db.migrate"),
    }
    loop entry in rejected {
        if policy_apply(sql_raw(entry.sql), owned, "alice", false) == .Err(failure) -> assert_eq(failure.message(), entry.message) else -> panic("accepted `{entry.sql}`")
    }
    assert_eq(policy_show(owned), "RowPolicy(table=tasks, expr=owner == user)")
    assert(policy_allows(owned, user: "alice", owner: "alice"))
    assert(!policy_allows(owned, user: "alice", owner: "bob"))
    assert(policy_allows(open, user: "alice", owner: "bob"))
}

#Test("migration identities hash every field with its length") {
    assert_eq(hex16(fnv_offset()), "cbf29ce484222325")
    assert_eq(hex16(hash_field(fnv_offset(), "")).len(), 16)
    assert(migration_checksum("v1", [SQL]{sql_raw("CREATE TABLE a (x)")}).starts_with("migration-v2:"))
    assert(migration_checksum("v1", [SQL]{sql_raw("CREATE TABLE a (x)")}) != migration_checksum("v2", [SQL]{sql_raw("CREATE TABLE a (x)")}))
}
