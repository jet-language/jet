use core as core

#Error
pub struct HexError {
    pub reason: String
}

impl HexError {
    pub fn new(reason: String) -> HexError Never! { HexError{reason: reason} }
}

// core.encoding.hex — RFC 4648 §8 hexadecimal alphabet.
//
// `encode` always emits lowercase `0-9a-f` with no whitespace, no `0x` prefix
// and no separators. `decode` accepts mixed case and rejects every other byte
// including whitespace and an odd number of digits. There is no ignore-whitespace
// mode; strip input first if a wire format wrapped the hex.
//

// Both functions are pure. `encode` allocates `2 * data.len()` bytes of ASCII.
fn u8_int(b: U8) -> Int Never! { Int.from_u8(b) }


/// Encode `data` as lowercase hexadecimal text.
pub fn encode(data: [U8]) -> String Never! { core.encoding.hex.encode(data) }

/// Decode hexadecimal text into bytes. Fails when the length is odd or a digit
/// is outside `0-9A-Fa-f`.
pub fn decode(text: String) -> [U8] HexError! {
    if core.encoding.hex.decode(text) == {
        .Ok(value) -> return Ok(value)
        .Err(reason) -> return Err(HexError{reason: reason})
    }
}

fn digit(b: U8) -> Int? {
    n :: u8_int(b)
    if n >= 48 && n <= 57 -> return Val(n - 48)
    if n >= 97 && n <= 102 -> return Val(n - 87)
    if n >= 65 && n <= 70 -> return Val(n - 55)
    None
}

pub fn encode_upper(data: [U8]) -> String Never! { core.encoding.hex.encode_upper(data) }

pub fn encode_prefixed(data: [U8]) -> String Never! { "0x{encode(data)}" }

pub fn is_hex(text: String) -> Bool Never! { core.encoding.hex.is_hex(text) }

fn nibble_upper(n: Int) -> U8 {
    if n < 10 -> return (U8{48 + n})
    (U8{55 + n})
}

/// Python `binascii.hexlify`.
pub fn hexlify(data: [U8]) -> String Never! { encode(data) }

/// Python `binascii.unhexlify`.
pub fn unhexlify(text: String) -> [U8] HexError! { decode(text) }

pub fn b2a_hex(data: [U8]) -> String Never! { encode(data) }

pub fn a2b_hex(text: String) -> [U8] HexError! { decode(text) }

/// Python `binascii.b2a_base64`: one unwrapped standard Base64 line. The
/// `core.encoding.hex.b2a_base64` row is the bare encoder; the newline is added here.
pub fn b2a_base64(data: [U8]) -> String Never! { "{core.encoding.hex.b2a_base64(data)}\n" }

pub fn a2b_base64(text: String) -> [U8] HexError! {
    if core.encoding.hex.a2b_base64(text) == {
        .Ok(value) -> return Ok(value)
        .Err(reason) -> return Err(HexError{reason: reason})
    }
}

/// Python `binascii.crc_hqx` (CRC-CCITT).
pub fn crc_hqx(data: [U8], value: Int) -> Int Never! { core.encoding.hex.crc_hqx(data, value) }

/// Python `binascii.crc32` (ISO 3309, non-negative result).
pub fn crc32(data: [U8]) -> Int Never! { core.encoding.hex.crc32(data) }

/// Python `binascii.b2a_qp` basic text form.
pub fn b2a_qp(data: [U8]) -> String Never! {
    out := ""
    loop byte in data {
        n :: u8_int(byte)
        if {
            n == 10 -> { out = "{out}\n" }
            (n >= 33 && n <= 60) || (n >= 62 && n <= 126) || n == 32 || n == 9 -> {
                out = "{out}{String.from_bytes([U8]{byte}) ?? ""}"
            }
            else -> { out = "{out}={qp_hex(n /% 16)}{qp_hex(n %% 16)}" }
        }
    }
    out
}

pub fn a2b_qp(text: String) -> [U8] Never! {
    raw :: text.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{61}) && i + 2 < raw.len() {
            if raw[i + 1] == (U8{10}) {
                i = i + 2
                next
            }
            hi :: digit(raw[i + 1]) ?? {
                &out.push(raw[i])
                i = i + 1
                next
            }
            lo :: digit(raw[i + 2]) ?? {
                &out.push(raw[i])
                i = i + 1
                next
            }
            &out.push(U8{hi * 16 + lo})
            i = i + 3
            next
        }
        &out.push(raw[i])
        i = i + 1
    }
    ~out
}

pub fn b2a_uu(data: [U8]) -> String Never! {
    out := ""
    i := 0
    if data.len() == 0 -> return "{uu_char(0)}\n"
    loop i < data.len() {
        count := data.len() - i
        if count > 45 -> count = 45
        out = "{out}{uu_char(count)}"
        j := 0
        loop j < count {
            pos :: i + j
            a :: u8_int(data[pos])
            b :: if j + 1 < count -> u8_int(data[pos + 1]) else -> 0
            c :: if j + 2 < count -> u8_int(data[pos + 2]) else -> 0
            out = "{out}{uu_char(a >> 2)}{uu_char(((a << 4) ~| (b >> 4)) & 63)}{uu_char(((b << 2) ~| (c >> 6)) & 63)}{uu_char(c & 63)}"
            j += 3
        }
        out = "{out}\n"
        i += count
    }
    out
}

pub fn a2b_uu(text: String) -> [U8] Never! {
    raw :: text.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{10}) || raw[i] == (U8{13}) {
            i += 1
            next
        }
        count := uu_value(raw[i])
        i += 1
        if count < 0 || count > 45 -> break
        groups := (count + 2) /% 3
        needed := groups * 4
        if i + needed > raw.len() -> break
        produced := 0
        loop produced < count {
            a :: uu_value(raw[i])
            b :: uu_value(raw[i + 1])
            c :: uu_value(raw[i + 2])
            d :: uu_value(raw[i + 3])
            &out.push(to_u8((a << 2) ~| (b >> 4)))
            produced += 1
            if produced < count {
                &out.push(to_u8((b << 4) ~| (c >> 2)))
                produced += 1
            }
            if produced < count {
                &out.push(to_u8((c << 6) ~| d))
                produced += 1
            }
            i += 4
        }
        loop i < raw.len() && raw[i] != (U8{10}) && raw[i] != (U8{13}) -> i += 1
    }
    ~out
}
fn qp_hex(n: Int) -> U8 { nibble_upper(n) }

fn uu_char(n: Int) -> U8 {
    if n == 0 -> return (U8{96})
    U8{32 + (n & 63)}
}

fn uu_value(byte: U8) -> Int {
    n :: u8_int(byte)
    if n == 96 -> return 0
    (n - 32) & 63
}

pub fn encode_sep(data: [U8], sep: String) -> String Never! { core.encoding.hex.encode_sep(data, sep) }

/// 16-byte rows of offset, hex, and ASCII. Unprintable bytes become `.`.
pub fn dump(data: [U8]) -> String Never! { core.encoding.hex.dump(data) }

/// Low byte of `n`. The mask runs in `Int`, so a wide value never reaches the
/// checked `U8{}` conversion.
fn to_u8(n: Int) -> U8 Never! {
    v :: n & 255
    (U8{v})
}
