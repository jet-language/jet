use core as core
use core.encoding as hex_encoding
use core.encoding.runtime.kernel_base_encode as hex_base_encode
use core.text.runtime.kernel_unicode_string as hex_unicode

#Error
pub struct HexError {
    pub reason: String
}

impl HexError {
    pub fn new(reason: String) -> HexError Never! { HexError{reason: reason} }
}

// core.encoding.hex — RFC 4648 §8 hexadecimal alphabet.
//
// `encode` always emits lowercase `0-9a-f` with no whitespace, no `0x` prefix
// and no separators. `decode` accepts mixed case and rejects every other byte
// including whitespace and an odd number of digits. There is no ignore-whitespace
// mode; strip input first if a wire format wrapped the hex.
//
// EncodingBase.rs:6–116 policy is Jet-owned here: hex encode/decode/is_hex,
// separator and dump forms reuse the canonical core.encoding hex law
// (bytes_to_hex, hex_to_bytes, hex_nibble, hex_value); CRC registers are fixed
// U16/U32 words. Native/JIT/comptime host rows become marshalling adapters.

// Both functions are pure. `encode` allocates `2 * data.len()` bytes of ASCII.
fn u8_int(b: U8) -> Int Never! { Int.from_u8(b) }


/// Encode `data` as lowercase hexadecimal text.
// Rust jet_std_hex_encode (:42); the canonical law borrows the original list.
pub fn encode(data: [U8]) -> String Never! {
    view :: data[0..<data.len()]
    hex_encoding.bytes_to_hex(view)
}

/// Decode hexadecimal text into bytes. Fails when the length is odd or a digit
/// is outside `0-9A-Fa-f`.
// Rust jet_std_hex_decode (:8): byte length checked before the digit scan.
pub fn decode(text: String) -> [U8] HexError! {
    if hex_encoding.hex_to_bytes(text) == {
        .Ok(value) -> return Ok(value)
        .Err(error) -> return Err(HexError{reason: error.reason})
    }
}

// Rust jet_std_hex_encode_upper (:45) via hex_with_digits (:34).
pub fn encode_upper(data: [U8]) -> String Never! {
    out := [U8]{}
    loop byte in data {
        n :: u8_int(byte)
        &out.push(nibble_upper(n /% 16))
        &out.push(nibble_upper(n %% 16))
    }
    String.from_bytes(out) ?? panic("uppercase hex produced invalid UTF-8")
}

pub fn encode_prefixed(data: [U8]) -> String Never! { "0x{encode(data)}" }

// Rust jet_std_hex_is_hex (:55): non-empty, even UTF-8 byte length, all digits.
pub fn is_hex(text: String) -> Bool Never! {
    raw :: hex_unicode.utf8_bytes(text)
    if raw.len() == 0 || raw.len() %% 2 != 0 -> return false
    loop byte in raw {
        if hex_encoding.hex_value(byte) == None -> return false
    }
    true
}

fn nibble_upper(n: Int) -> U8 {
    if n < 10 -> return (U8{48 + n})
    (U8{55 + n})
}

/// Python `binascii.hexlify`.
pub fn hexlify(data: [U8]) -> String Never! { encode(data) }

/// Python `binascii.unhexlify`.
pub fn unhexlify(text: String) -> [U8] HexError! { decode(text) }

pub fn b2a_hex(data: [U8]) -> String Never! { encode(data) }

pub fn a2b_hex(text: String) -> [U8] HexError! { decode(text) }

/// Python `binascii.b2a_base64`: one unwrapped standard Base64 line. The
/// canonical standard encoder owns the text; the newline is added here.
pub fn b2a_base64(data: [U8]) -> String Never! {
    view :: data[0..<data.len()]
    "{hex_base_encode.encode64(view)}\n"
}

pub fn a2b_base64(text: String) -> [U8] HexError! {
    if core.encoding.hex.a2b_base64(text) == {
        .Ok(value) -> return Ok(value)
        .Err(reason) -> return Err(HexError{reason: reason})
    }
}

/// Python `binascii.crc_hqx` (CRC-CCITT).
// Rust jet_std_crc_hqx (:87): the seed is `value & 0xffff` as a U16 register.
pub fn crc_hqx(data: [U8], value: Int) -> Int Never! {
    seed :: U16.from_int(value & 65535) ?? panic("masked CRC-CCITT seed exceeds U16")
    Int.from_u16(crc_hqx_word(data, seed))
}

// Rust jet_std_crc_hqx (:87–100): MSB-first polynomial 0x1021, no final xor.
fn crc_hqx_word(data: [U8], seed: U16) -> U16 Never! {
    crc := seed
    loop byte in data {
        crc = crc ~| (U16.from_u8(byte) << 8)
        loop _ in 0..<8 {
            if (crc & U16{32768}) != (U16{0}) {
                crc = ((crc & U16{32767}) << 1) ~| U16{4129}
            } else {
                crc = crc << 1
            }
        }
    }
    crc
}

/// Python `binascii.crc32` (ISO 3309, non-negative result).
// Rust jet_std_crc32 (:102–115): reflected 0xEDB88320, init/final all-ones;
// the i32→i64 & 0xffffffff result is exactly the unsigned U32 word.
pub fn crc32(data: [U8]) -> Int Never! { Int.from_u32(crc32_word(data)) }

fn crc32_word(data: [U8]) -> U32 Never! {
    crc := U32{4294967295}
    loop byte in data {
        crc = crc ~| U32.from_u8(byte)
        loop _ in 0..<8 {
            if (crc & U32{1}) != (U32{0}) {
                crc = (crc >> 1) ~| U32{3988292384}
            } else {
                crc = crc >> 1
            }
        }
    }
    crc ~| U32{4294967295}
}

/// Python `binascii.b2a_qp` basic text form.
pub fn b2a_qp(data: [U8]) -> String Never! {
    out := ""
    loop byte in data {
        n :: u8_int(byte)
        if {
            n == 10 -> { out = "{out}\n" }
            (n >= 33 && n <= 60) || (n >= 62 && n <= 126) || n == 32 || n == 9 -> {
                out = "{out}{String.from_bytes([U8]{byte}) ?? ""}"
            }
            else -> { out = "{out}={qp_hex(n /% 16)}{qp_hex(n %% 16)}" }
        }
    }
    out
}

pub fn a2b_qp(text: String) -> [U8] Never! {
    raw :: text.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{61}) && i + 2 < raw.len() {
            if raw[i + 1] == (U8{10}) {
                i = i + 2
                next
            }
            hi :: hex_encoding.hex_value(raw[i + 1]) ?? {
                &out.push(raw[i])
                i = i + 1
                next
            }
            lo :: hex_encoding.hex_value(raw[i + 2]) ?? {
                &out.push(raw[i])
                i = i + 1
                next
            }
            &out.push(U8{hi * 16 + lo})
            i = i + 3
            next
        }
        &out.push(raw[i])
        i = i + 1
    }
    ~out
}

pub fn b2a_uu(data: [U8]) -> String Never! {
    out := ""
    i := 0
    if data.len() == 0 -> return "{uu_char(0)}\n"
    loop i < data.len() {
        count := data.len() - i
        if count > 45 -> count = 45
        out = "{out}{uu_char(count)}"
        j := 0
        loop j < count {
            pos :: i + j
            a :: u8_int(data[pos])
            b :: if j + 1 < count -> u8_int(data[pos + 1]) else -> 0
            c :: if j + 2 < count -> u8_int(data[pos + 2]) else -> 0
            out = "{out}{uu_char(a >> 2)}{uu_char(((a << 4) ~| (b >> 4)) & 63)}{uu_char(((b << 2) ~| (c >> 6)) & 63)}{uu_char(c & 63)}"
            j += 3
        }
        out = "{out}\n"
        i += count
    }
    out
}

pub fn a2b_uu(text: String) -> [U8] Never! {
    raw :: text.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{10}) || raw[i] == (U8{13}) {
            i += 1
            next
        }
        count := uu_value(raw[i])
        i += 1
        if count < 0 || count > 45 -> break
        groups := (count + 2) /% 3
        needed := groups * 4
        if i + needed > raw.len() -> break
        produced := 0
        loop produced < count {
            a :: uu_value(raw[i])
            b :: uu_value(raw[i + 1])
            c :: uu_value(raw[i + 2])
            d :: uu_value(raw[i + 3])
            &out.push(to_u8((a << 2) ~| (b >> 4)))
            produced += 1
            if produced < count {
                &out.push(to_u8((b << 4) ~| (c >> 2)))
                produced += 1
            }
            if produced < count {
                &out.push(to_u8((c << 6) ~| d))
                produced += 1
            }
            i += 4
        }
        loop i < raw.len() && raw[i] != (U8{10}) && raw[i] != (U8{13}) -> i += 1
    }
    ~out
}
fn qp_hex(n: Int) -> U8 { nibble_upper(n) }

fn uu_char(n: Int) -> U8 {
    if n == 0 -> return (U8{96})
    U8{32 + (n & 63)}
}

fn uu_value(byte: U8) -> Int {
    n :: u8_int(byte)
    if n == 96 -> return 0
    (n - 32) & 63
}

// Rust jet_std_hex_encode_sep (:48): lowercase byte pairs joined by `sep`.
pub fn encode_sep(data: [U8], sep: String) -> String Never! {
    separator :: hex_unicode.utf8_bytes(sep)
    out := [U8]{}
    loop index in 0..<data.len() {
        if index > 0 {
            loop byte in separator -> &out.push(byte)
        }
        n :: u8_int(data[index])
        &out.push(hex_encoding.hex_nibble(n /% 16))
        &out.push(hex_encoding.hex_nibble(n %% 16))
    }
    String.from_bytes(out) ?? panic("separated hex produced invalid UTF-8")
}

/// 16-byte rows of offset, hex, and ASCII. Unprintable bytes become `.`.
// Rust jet_std_hex_dump (:58–86): "{offset:08x}  {hex}  {ascii}\n" per row;
// absent cells are two spaces and bytes outside 32..=126 print as `.`.
pub fn dump(data: [U8]) -> String Never! {
    out := [U8]{}
    start := 0
    loop start < data.len() {
        dump_offset(&out, U64.from_int(start) ?? panic("hex dump offset exceeds U64"))
        &out.push(U8{32})
        &out.push(U8{32})
        loop index in 0..<16 {
            if index > 0 -> &out.push(U8{32})
            if start + index < data.len() {
                n :: u8_int(data[start + index])
                &out.push(hex_encoding.hex_nibble(n /% 16))
                &out.push(hex_encoding.hex_nibble(n %% 16))
            } else {
                &out.push(U8{32})
                &out.push(U8{32})
            }
        }
        &out.push(U8{32})
        &out.push(U8{32})
        end := start + 16
        if end > data.len() -> end = data.len()
        loop index in start..<end {
            byte :: data[index]
            if byte >= (U8{32}) && byte <= (U8{126}) {
                &out.push(byte)
            } else {
                &out.push(U8{46})
            }
        }
        &out.push(U8{10})
        start += 16
    }
    String.from_bytes(out) ?? panic("hex dump produced invalid UTF-8")
}

// Rust `{offset:08x}`: lowercase, at least eight digits, wider when needed.
fn dump_offset(out: &[U8], offset: U64) Never! {
    shift := 60
    loop shift >= 0 {
        if shift < 32 || (offset >> shift) != (U64{0}) {
            &out.push(hex_encoding.hex_nibble(Int.from_u64((offset >> shift) & U64{15})))
        }
        shift -= 4
    }
}

/// Low byte of `n`. The mask runs in `Int`, so a wide value never reaches the
/// checked `U8{}` conversion.
fn to_u8(n: Int) -> U8 Never! {
    v :: n & 255
    (U8{v})
}
