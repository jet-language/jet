#Error
pub struct HexError {
    pub reason: String
}

impl HexError {
    pub fn new(reason: String) -> HexError { HexError{reason: reason} }
}

// core.encoding.hex — RFC 4648 §8 hexadecimal alphabet.
//
// `encode` always emits lowercase `0-9a-f` with no whitespace, no `0x` prefix
// and no separators. `decode` accepts mixed case and rejects every other byte
// including whitespace and an odd number of digits. There is no ignore-whitespace
// mode; strip input first if a wire format wrapped the hex.
//

// Both functions are pure. `encode` allocates `2 * data.len()` bytes of ASCII.
fn u8_int(b: U8) -> Int { Int.from_u8(b) }


/// Encode `data` as lowercase hexadecimal text.
pub fn encode(data: [U8]) -> String {
    out := [U8]{}
    loop b in data {
        n :: u8_int(b)
        out.push(nibble(n /% 16))
        out.push(nibble(n %% 16))
    }
    String.from_bytes(out) ?? ""
}

/// Decode hexadecimal text into bytes. Fails when the length is odd or a digit
/// is outside `0-9A-Fa-f`.
pub fn decode(text: String) -> [U8] !HexError {
    raw :: text.bytes()
    if raw.len() %% 2 != 0 {
        return Err(HexError{reason: "odd-length hex string; hex text encodes whole bytes, so the length must be even"})
    }
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        hi :: digit(raw[i]) ?? return Err(HexError{reason: "invalid hex digit; expected 0-9, a-f, or A-F"})
        lo :: digit(raw[i + 1]) ?? return Err(HexError{reason: "invalid hex digit; expected 0-9, a-f, or A-F"})
        value :: hi * 16 + lo
        out.push(U8{value})
        i = i + 2
    }
    Ok(out)
}

fn nibble(n: Int) -> U8 {
    if n < 10 -> return (U8{48 + n})
    (U8{87 + n})
}

fn digit(b: U8) -> ?Int {
    n :: u8_int(b)
    if n >= 48 && n <= 57 -> return Val(n - 48)
    if n >= 97 && n <= 102 -> return Val(n - 87)
    if n >= 65 && n <= 70 -> return Val(n - 55)
    None
}

pub fn encode_upper(data: [U8]) -> String {
    out := [U8]{}
    loop b in data {
        n :: u8_int(b)
        out.push(nibble_upper(n /% 16))
        out.push(nibble_upper(n %% 16))
    }
    String.from_bytes(out) ?? ""
}

pub fn encode_prefixed(data: [U8]) -> String { "0x{encode(data)}" }

pub fn is_hex(text: String) -> Bool {
    raw :: text.bytes()
    if raw.len() == 0 || raw.len() %% 2 != 0 -> return false
    loop b in raw {
        if digit(b) == .None -> return false
    }
    true
}

fn nibble_upper(n: Int) -> U8 {
    if n < 10 -> return (U8{48 + n})
    (U8{55 + n})
}

/// Python `binascii.hexlify`.
pub fn hexlify(data: [U8]) -> String { encode(data) }

/// Python `binascii.unhexlify`.
pub fn unhexlify(text: String) -> [U8] !HexError { decode(text) }

pub fn b2a_hex(data: [U8]) -> String { encode(data) }

pub fn a2b_hex(text: String) -> [U8] !HexError { decode(text) }

pub fn b2a_base64(data: [U8]) -> String { "{base64_encode(data)}\n" }

pub fn a2b_base64(text: String) -> [U8] !HexError { base64_decodebytes(text) }

/// Python `binascii.crc_hqx` (CRC-CCITT).
pub fn crc_hqx(data: [U8], value: Int) -> Int {
    crc := value & 65535
    loop byte in data {
        crc = crc ~| (u8_int(byte) << 8)
        loop _ in 0..<8 {
            if {
                crc & 32768 != 0 -> { crc = ((crc << 1) ~| 4129) & 65535 }
                else -> { crc = (crc << 1) & 65535 }
            }
        }
    }
    crc
}

/// Python `binascii.crc32` (ISO 3309, non-negative result).
pub fn crc32(data: [U8]) -> Int {
    crc := 4294967295
    loop byte in data {
        crc = (crc ~| u8_int(byte)) & 4294967295
        loop _ in 0..<8 {
            if {
                crc & 1 != 0 -> { crc = ((crc >> 1) ~| 3988292384) & 4294967295 }
                else -> { crc = (crc >> 1) & 4294967295 }
            }
        }
    }
    (crc ~| 4294967295) & 4294967295
}

/// Python `binascii.b2a_qp` basic text form.
pub fn b2a_qp(data: [U8]) -> String {
    out := ""
    loop byte in data {
        n :: u8_int(byte)
        if {
            n == 10 -> { out = "{out}\n" }
            (n >= 33 && n <= 60) || (n >= 62 && n <= 126) || n == 32 || n == 9 -> {
                out = "{out}{String.from_bytes([U8]{byte}) ?? ""}"
            }
            else -> { out = "{out}={qp_hex(n /% 16)}{qp_hex(n %% 16)}" }
        }
    }
    out
}

pub fn a2b_qp(text: String) -> [U8] {
    raw :: text.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{61}) && i + 2 < raw.len() {
            if raw[i + 1] == (U8{10}) {
                i = i + 2
                next
            }
            hi :: digit(raw[i + 1]) ?? {
                out.push(raw[i])
                i = i + 1
                next
            }
            lo :: digit(raw[i + 2]) ?? {
                out.push(raw[i])
                i = i + 1
                next
            }
            out.push(U8{hi * 16 + lo})
            i = i + 3
            next
        }
        out.push(raw[i])
        i = i + 1
    }
    ~out
}

pub fn b2a_uu(data: [U8]) -> String {
    out := ""
    count :: data.len()
    out = "{uu_char(count)}"
    i := 0
    loop i < count {
        a :: u8_int(data[i])
        b :: if i + 1 < count -> u8_int(data[i + 1]) else -> 0
        c :: if i + 2 < count -> u8_int(data[i + 2]) else -> 0
        out = "{out}{uu_char(a >> 2)}{uu_char(((a << 4) ~| (b >> 4)) & 63)}{uu_char(((b << 2) ~| (c >> 6)) & 63)}{uu_char(c & 63)}"
        i = i + 3
    }
    "{out}\n"
}

pub fn a2b_uu(text: String) -> [U8] {
    raw :: text.bytes()
    if raw.len() == 0 -> return [U8]{}
    count :: uu_value(raw[0])
    out := [U8]{}
    i := 1
    loop i + 3 < raw.len() && out.len() < count {
        a :: uu_value(raw[i])
        b :: uu_value(raw[i + 1])
        c :: uu_value(raw[i + 2])
        d :: uu_value(raw[i + 3])
        out.push(U8{(a << 2) ~| (b >> 4)})
        if out.len() < count -> out.push(U8{(b << 4) ~| (c >> 2)})
        if out.len() < count -> out.push(U8{(c << 6) ~| d})
        i = i + 4
    }
    ~out
}
fn qp_hex(n: Int) -> U8 { nibble_upper(n) }

fn uu_char(n: Int) -> U8 {
    if n == 0 -> return (U8{96})
    U8{32 + (n & 63)}
}

fn uu_value(byte: U8) -> Int {
    n :: u8_int(byte)
    if n == 96 -> return 0
    (n - 32) & 63
}

pub fn encode_sep(data: [U8], sep: String) -> String {
    out := ""
    i := 0
    loop i < data.len() {
        if i > 0 -> out = "{out}{sep}"
        byte :: data[i]
        n :: u8_int(byte)
        hi :: nibble(n /% 16)
        lo :: nibble(n %% 16)
        out = "{out}{String.from_bytes([U8]{hi, lo}) ?? ""}"
        i = i + 1
    }
    out
}

/// 16-byte rows of offset, hex, and ASCII. Unprintable bytes become `.`.
pub fn dump(data: [U8]) -> String {
    out := ""
    i := 0
    loop i < data.len() {
        off := hex_pad(i, 8)
        hex := ""
        ascii := ""
        k := 0
        loop k < 16 {
            if {
                i + k < data.len() -> {
                    b :: data[i + k]
                    n :: u8_int(b)
                    if k > 0 -> hex = "{hex} "
                    hi :: nibble(n /% 16)
                    lo :: nibble(n %% 16)
                    hex = "{hex}{String.from_bytes([U8]{hi, lo}) ?? ""}"
                    if n >= 32 && n <= 126 -> ascii = "{ascii}{String.from_bytes([U8]{b}) ?? "."}" else {
                        ascii = "{ascii}."
                    }
                }
                else -> {
                    if k > 0 -> hex = "{hex} "
                    hex = "{hex}  "
                }
            }
            k = k + 1
        }
        out = "{out}{off}  {hex}  {ascii}\n"
        i = i + 16
    }
    out
}

fn hex_pad(n: Int, width: Int) -> String {
    digits := [U8]{}
    v := n
    if v == 0 -> digits.push(U8{48})
    loop v > 0 {
        digits.push(nibble(v %% 16))
        v = v /% 16
    }
    loop digits.len() < width -> digits.push(U8{48})
    out := [U8]{}

    i := digits.len()
    loop i > 0 {
        i = i - 1
        out.push(digits[i])
    }
    String.from_bytes(out) ?? "0"
}
@base64_alphabet :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fn base64_encode(data: [U8]) -> String {
    ab :: @base64_alphabet.bytes()
    out := [U8]{}
    i := 0
    loop i + 3 <= data.len() {
        n :: (u8_int(data[i]) << 16) | (u8_int(data[i + 1]) << 8) | u8_int(data[i + 2])
        out.push(ab[(n >> 18) & 63])
        out.push(ab[(n >> 12) & 63])
        out.push(ab[(n >> 6) & 63])
        out.push(ab[n & 63])
        i += 3
    }
    rest :: data.len() - i
    if rest == 1 {
        n :: u8_int(data[i]) << 16
        out.push(ab[(n >> 18) & 63])
        out.push(ab[(n >> 12) & 63])
        out.push(U8{61})
        out.push(U8{61})
    }
    if rest == 2 {
        n :: (u8_int(data[i]) << 16) | (u8_int(data[i + 1]) << 8)
        out.push(ab[(n >> 18) & 63])
        out.push(ab[(n >> 12) & 63])
        out.push(ab[(n >> 6) & 63])
        out.push(U8{61})
    }
    String.from_bytes(out) ?? ""
}

fn base64_decodebytes(text: String) -> [U8] !HexError {
    raw := [U8]{}
    loop b in text.bytes() {
        n :: u8_int(b)
        if n == 9 || n == 10 || n == 11 || n == 12 || n == 13 || n == 32 -> next
        raw.push(b)
    }
    base64_decode(String.from_bytes(raw) ?? "")
}

fn base64_decode(text: String) -> [U8] !HexError {
    raw :: text.bytes()
    if raw.len() == 0 -> return Ok([U8]{})
    table :: base64_decode_table()
    pad := 0
    end := raw.len()
    loop end > 0 && raw[end - 1] == (U8{61}) {
        pad += 1
        end -= 1
    }
    if pad > 2 -> return Err(HexError{reason: "invalid Base64 padding; at most two '=' characters may trail the alphabet"})
    loop i in 0..<end {
        if raw[i] == (U8{61}) -> return Err(HexError{reason: "invalid Base64 padding; '=' may appear only at the end"})
        if table[u8_int(raw[i])] < 0 -> return Err(HexError{reason: "invalid Base64 character; expected the standard RFC 4648 alphabet"})
    }
    rem :: end %% 4
    if rem == 1 -> return Err(HexError{reason: "invalid Base64 length; encoded length cannot represent whole bytes"})
    expected := 0
    if rem == 2 -> expected = 2
    if rem == 3 -> expected = 1
    if pad != expected -> return Err(HexError{reason: "invalid Base64 padding; expected the RFC 4648 padding for the final quantum"})
    if rem == 2 {
        last :: table[u8_int(raw[end - 1])]
        if (last & 15) != 0 -> return Err(HexError{reason: "invalid Base64 encoding; non-zero unused bits"})
    }
    if rem == 3 {
        last :: table[u8_int(raw[end - 1])]
        if (last & 3) != 0 -> return Err(HexError{reason: "invalid Base64 encoding; non-zero unused bits"})
    }
    out := [U8]{}
    i := 0
    loop i + 4 <= end {
        a :: table[u8_int(raw[i])]
        b :: table[u8_int(raw[i + 1])]
        c :: table[u8_int(raw[i + 2])]
        d :: table[u8_int(raw[i + 3])]
        n :: (a << 18) | (b << 12) | (c << 6) | d
        out.push(U8{(n >> 16) & 255})
        out.push(U8{(n >> 8) & 255})
        out.push(U8{n & 255})
        i += 4
    }
    if rem == 2 {
        a :: table[u8_int(raw[i])]
        b :: table[u8_int(raw[i + 1])]
        out.push(U8{((a << 2) | (b >> 4)) & 255})
    }
    if rem == 3 {
        a :: table[u8_int(raw[i])]
        b :: table[u8_int(raw[i + 1])]
        c :: table[u8_int(raw[i + 2])]
        out.push(U8{((a << 2) | (b >> 4)) & 255})
        out.push(U8{((b << 4) | (c >> 2)) & 255})
    }
    Ok(out)
}

fn base64_decode_table() -> [Int] {
    table := [Int]{}
    loop _ in 0..<256 -> table.push(-1)
    ab :: @base64_alphabet.bytes()
    loop i in 0..<ab.len() -> table[u8_int(ab[i])] = i
    table
}
