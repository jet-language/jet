// core.encoding.base32 — RFC 4648 §6 Base32 (A-Z2-7) with padding.
//
// The default decoder is deliberately canonical: uppercase symbols, complete
// RFC padding, zero unused bits, and no whitespace or aliases.  Keeping the
// alphabet checks here (rather than relying on a host decoder) makes malformed
// input behave identically on every execution tier.
#Error
pub struct Base32Error {
    pub reason: String
}

impl Base32Error {
    pub fn new(reason: String) -> Base32Error { Base32Error{reason: reason} }
}

fn u8_int(b: U8) -> Int Never! { Int.from_u8(b) }

C_ALPHABET :: "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
C_HEX_ALPHABET :: "0123456789ABCDEFGHIJKLMNOPQRSTUV"

pub fn encode(data: [U8]) -> String { encode_with_alphabet(data, C_ALPHABET) }

fn encode_with_alphabet(data: [U8], alphabet: String) -> String {
    ab :: alphabet.bytes()
    out := [U8]{}
    i := 0
    loop i + 5 <= data.len() {
        n :: (u8_int(data[i]) << 32) | (u8_int(data[i + 1]) << 24) | (u8_int(data[i + 2]) << 16) | (u8_int(data[i + 3]) << 8) | u8_int(data[i + 4])
        &out.push(ab[(n >> 35) & 31])
        &out.push(ab[(n >> 30) & 31])
        &out.push(ab[(n >> 25) & 31])
        &out.push(ab[(n >> 20) & 31])
        &out.push(ab[(n >> 15) & 31])
        &out.push(ab[(n >> 10) & 31])
        &out.push(ab[(n >> 5) & 31])
        &out.push(ab[n & 31])
        i += 5
    }
    rest :: data.len() - i
    if rest > 0 {
        n := 0
        loop k in 0..<rest -> n = n | (u8_int(data[i + k]) << ((4 - k) * 8))
        bits :: rest * 8
        chars :: (bits + 4) /% 5
        shift := 35
        loop _ in 0..<chars {
            &out.push(ab[(n >> shift) & 31])
            shift -= 5
        }
        loop _ in 0..<(8 - chars) -> &out.push(U8{61})
    }
    String.from_bytes(out) ?? ""
}

/// Decode the canonical padded RFC 4648 alphabet.
pub fn decode(text: String) -> [U8] Base32Error! { decode_with_alphabet(text, C_ALPHABET) }

fn decode_with_alphabet(text: String, alphabet: String) -> [U8] Base32Error! {
    ab :: alphabet.bytes()
    raw :: text.bytes()
    if raw.len() == 0 -> return Ok([U8]{})
    if raw.len() %% 8 != 0 -> return Err(Base32Error{reason: "invalid Base32 length; canonical Base32 is padded to a multiple of 8 characters"})
    table := [Int]{}
    loop _ in 0..<256 -> &table.push(-1)
    loop i in 0..<ab.len() -> table[u8_int(ab[i])] = i

    pad := 0
    end := raw.len()
    loop end > 0 && raw[end - 1] == (U8{61}) {
        pad += 1
        end -= 1
    }
    if pad > 6 -> return Err(Base32Error{reason: "invalid Base32 padding; at most six '=' characters may trail the alphabet"})
    loop i in 0..<end {
        if raw[i] == (U8{61}) -> return Err(Base32Error{reason: "invalid Base32 padding; '=' may appear only at the end"})
        if table[u8_int(raw[i])] < 0 -> return Err(Base32Error{reason: "invalid Base32 character; expected the selected RFC 4648 alphabet"})
    }
    symbols :: end
    rem :: symbols %% 8
    expected := 0
    if rem == 0 -> expected = 0
    if rem == 2 -> expected = 6
    if rem == 4 -> expected = 4
    if rem == 5 -> expected = 3
    if rem == 7 -> expected = 1
    if expected < 0 || (rem != 0 && rem != 2 && rem != 4 && rem != 5 && rem != 7) {
        return Err(Base32Error{reason: "invalid Base32 length; encoded length cannot represent whole bytes"})
    }
    if pad != expected -> return Err(Base32Error{reason: "invalid Base32 padding; expected the RFC 4648 padding for the final quantum"})
    if rem > 0 {
        last :: table[u8_int(raw[end - 1])]
        unused := 0
        if rem == 2 -> unused = 2
        if rem == 4 -> unused = 4
        if rem == 5 -> unused = 1
        if rem == 7 -> unused = 3
        if (last & ((1 << unused) - 1)) != 0 -> return Err(Base32Error{reason: "invalid Base32 encoding; non-zero unused bits"})
    }

    out := [U8]{}
    acc := 0
    bits := 0
    loop i in 0..<end {
        acc = (acc << 5) | table[u8_int(raw[i])]
        bits += 5
        if bits >= 8 {
            bits -= 8
            &out.push(to_u8(acc >> bits))
        }
    }
    Ok(out)
}

pub fn is_base32(text: String) -> Bool {
    decode(text) == .Ok(_)
}

pub fn b32encode(data: [U8]) -> String { encode(data) }
pub fn b32decode(text: String) -> [U8] Base32Error! { decode(text) }

pub fn b32hexencode(data: [U8]) -> String { encode_with_alphabet(data, C_HEX_ALPHABET) }
pub fn b32hexdecode(text: String) -> [U8] Base32Error! { decode_with_alphabet(text, C_HEX_ALPHABET) }

/// Low byte of `n`. The mask runs in `Int`, so a wide value never reaches the
/// checked `U8{}` conversion.
fn to_u8(n: Int) -> U8 Never! {
    v :: n & 255
    (U8{v})
}
