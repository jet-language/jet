// core.encoding.base32 — RFC 4648 §6 Base32 (A-Z2-7) with padding, and the
// §7 extended-hex alphabet (0-9A-V).
//
// Decoding follows D-ENCBASE-STRICT1: edition 2027+ decoders are strict
// RFC 4648 (uppercase symbols, complete padding, zero unused bits, no
// whitespace) and report `invalid base32 at byte <N>: <reason>`; edition 2026
// keeps the compatibility parser. Decoders retain the same host rows;
// encoders use the private borrowed-byte owner.
use core as core
use core.encoding.runtime.kernel_base_encode as base32_encode_kernel

#Error
pub struct Base32Error {
    pub reason: String
}

impl Base32Error {
    pub fn new(reason: String) -> Base32Error Never! { Base32Error{reason: reason} }
}

// Rust jet_std_base32_encode:231–233; no owning input or alphabet copy.
pub fn encode(data: [U8]) -> String Never! {
    view :: data[0..<data.len()]
    base32_encode_kernel.encode32(view)
}

/// Decode the canonical padded RFC 4648 alphabet.
pub fn decode(text: String) -> [U8] Base32Error! {
    if core.encoding.base32.b32decode(text) == {
        .Ok(value) -> return Ok(value)
        .Err(reason) -> return Err(Base32Error{reason: reason})
    }
}

pub fn is_base32(text: String) -> Bool Never! {
    decode(text) == .Ok(_)
}

pub fn b32encode(data: [U8]) -> String Never! { encode(data) }
pub fn b32decode(text: String) -> [U8] Base32Error! { decode(text) }

pub fn b32hexencode(data: [U8]) -> String Never! {
    view :: data[0..<data.len()]
    base32_encode_kernel.encode32_hex(view)
}

pub fn b32hexdecode(text: String) -> [U8] Base32Error! {
    if core.encoding.base32.b32hexdecode(text) == {
        .Ok(value) -> return Ok(value)
        .Err(reason) -> return Err(Base32Error{reason: reason})
    }
}
