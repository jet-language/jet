// core.encoding.jsonl — JSON Lines (one JSON value per LF-terminated record).
//
// A record is one line; `\r\n` endings lose their `\r`. Blank records (only
// spaces or tabs) are skipped. Each other record must hold exactly one complete
// JSON value, parsed by `core.encoding.json.parse`; two values on one line
// (`{} {}`) are a syntax error, not two records, and a value may not span
// lines. A record error keeps the JSON kind and reason and reports the stream
// position: `line` is the record's line in the whole text, `byte_offset` counts
// from the start of the text, and `path` starts with the record index among
// non-blank records (`/2/name`).
//
// `parse`, `first`, and `count_rows` operate on text the caller already holds.
// The bounded native reader consumes a `^files.FileReader` with EncodingLimits.
//
// `to_string` writes one compact JSON value per record and a trailing newline so
// concatenation of documents stays a valid JSONL stream. There is no pretty
// form; pretty JSON contains newlines and would break the line protocol.
use core.encoding.[DataTree, EncodingError, EncodingFormat]
use core.encoding.json as json

/// Parse every non-empty record as JSON. Allocates one `DataTree` per record.
pub fn parse(text: String) -> [DataTree] EncodingError! {
    rows := [DataTree]{}
    index := 0
    loop record in records_of(text) {
        if is_blank(record.text) -> next
        &rows.push(parse_record(record, index))
        index += 1
    }
    Ok(rows)
}

/// Compact JSONL text. Always ends with a newline when `rows` is non-empty.
pub fn to_string(rows: [DataTree]) -> String Never! {
    out := ""
    loop row in rows -> out = "{out}{json.to_string(row)}\n"
    out
}


pub fn loads(text: String) -> [DataTree] EncodingError! { parse(text) }

pub fn dumps(rows: [DataTree]) -> String Never! { to_string(rows) }

pub fn count_rows(text: String) -> Int Never! {
    n := 0
    loop record in records_of(text) {
        if !is_blank(record.text) -> n += 1
    }
    n
}

pub fn append_line(text: String, value: DataTree) -> String Never! {
    if text.bytes().len() == 0 -> return "{json.to_string(value)}\n"
    last :: text.bytes()[text.bytes().len() - 1]
    if last == (U8{10}) -> return "{text}{json.to_string(value)}\n"
    "{text}\n{json.to_string(value)}\n"
}

pub fn first(text: String) -> DataTree? EncodingError! {
    loop record in records_of(text) {
        if is_blank(record.text) -> next
        return Val(parse_record(record, 0))
    }
    Ok(None)
}

// One line of the stream: its text without the line ending, its 1-based line
// number, and the byte offset of its first byte in the whole text.
struct JSONLRecord {
    text: String
    line: Int
    offset: Int
}

fn parse_record(record: JSONLRecord, index: Int) -> DataTree EncodingError! {
    value :: json.parse(record.text) ?? return Err(record_error(err, record, index))
    Ok(value)
}

// Re-anchor a record-local JSON error to the stream.
fn record_error(error: EncodingError, record: JSONLRecord, index: Int) -> EncodingError Never! {
    inner := error.path
    if inner == "/" -> inner = ""
    {
        format: EncodingFormat.JSONL,
        kind: error.kind,
        byte_offset: record.offset + error.byte_offset,
        line: Val(record.line),
        column: error.column,
        path: "/{index}{inner}",
        reason: error.reason,
        cause: error.cause,
    }
}

fn is_blank(text: String) -> Bool Never! {
    if text.len() == 0 -> return true
    loop b in text.bytes() {
        n :: b
        if n != 32 && n != 9 -> return false
    }
    true
}

fn records_of(text: String) -> [JSONLRecord] Never! {
    records := [JSONLRecord]{}
    raw :: text.bytes()
    buf := [U8]{}
    line := 1
    start := 0
    loop i in 0..<raw.len() {
        b :: raw[i]
        if b != (U8{10}) {
            &buf.push(b)
            next
        }
        if buf.len() > 0 && buf[buf.len() - 1] == (U8{13}) -> _ :: &buf.pop()
        &records.push(JSONLRecord{text: String.from_bytes(buf) ?? "", line: line, offset: start})
        buf = [U8]{}
        line += 1
        start = i + 1
    }
    if start < raw.len() {
        if buf.len() > 0 && buf[buf.len() - 1] == (U8{13}) -> _ :: &buf.pop()
        &records.push(JSONLRecord{text: String.from_bytes(buf) ?? "", line: line, offset: start})
    }
    records
}
