// core.encoding.jsonl — JSON Lines (one JSON value per LF-terminated record).
//
// A record is one line; `\r\n` endings lose their `\r`. Blank records (only
// spaces or tabs) are skipped. Each other record must hold exactly one complete
// JSON value, parsed by `core.encoding.json.parse`; two values on one line
// (`{} {}`) are a syntax error, not two records, and a value may not span
// lines. A record error keeps the JSON kind and reason and reports the stream
// position: `line` is the record's line in the whole text, `byte_offset` counts
// from the start of the text, and `path` starts with the record index among
// non-blank records (`/2/name`).
//
// `parse`, `first`, `count_rows`, and `reader(text)` operate on text the caller
// already holds. The bounded file reader consumes a `^files.FileReader`.
//
// `to_string` writes one compact JSON value per record and a trailing newline so
// concatenation of documents stays a valid JSONL stream. There is no pretty
// form; pretty JSON contains newlines and would break the line protocol.
use core.encoding.[Dyn, EncodingError, EncodingFormat, EncodingLimits]
use core.encoding.json as json
use __core_encoding_stream as stream
use core.files.[FileWriter]

/// Bounded JSONL output uses the native-shipped delayed-LF policy in Jet.
struct JSONLWriter {
    output: stream.JSONLinesPush
    fn write(&self, value: ^Dyn) EncodingError! -[IO]> { &self.output.write(^value) }
    fn flush(&self) EncodingError! -[IO]> { &self.output.flush() }
    fn finish(&self) EncodingError! -[IO]> { &self.output.finish() }
}

fn writer(target: ^FileWriter, limits: EncodingLimits{EncodingLimits.safe()}) -[FS]> JSONLWriter EncodingError! {
    output :: stream.jsonl_writer(^target, limits) ?? return Err(err)
    Ok(JSONLWriter{output: ^output})
}

/// Parse every non-empty record as JSON. Allocates one `Dyn` per record.
fn parse(text: String) -> [Dyn] EncodingError! {
    rows := [Dyn]{}
    cursor := reader(text)
    loop {
        row :: &cursor.next()
        if row == None -> break
        &rows.push(row)
    }
    Ok(rows)
}

/// Compact JSONL text. Always ends with a newline when `rows` is non-empty.
fn to_string(rows: [Dyn]) -> String EncodingError! {
    out := [U8]{}
    record_index := 0
    loop row in rows {
        text :: json.to_string(row) ?? return Err(record_error(err, JSONLRecord{text: "", line: record_index + 1, offset: out.len()}, record_index))
        loop index in 0..<text.count_bytes() -> &out.push(stream.byte_at(text, index))
        &out.push(U8{10})
        record_index += 1
    }
    text :: stream.text_from_bytes(^out) ?? return Err(EncodingError.new(EncodingFormat.JSONL, .State, 0, None, None, "", "JSONL renderer produced invalid UTF-8"))
    Ok(text)
}

struct JSONLReader {
    text: String
    offset: Int
    line: Int
    records_read: Int

    fn next(&self) -> Dyn? EncodingError! {
        loop {
            record :: &self.next_record() ?? return Ok(None)
            if is_blank(record.text) -> next
            value :: parse_record(record, self.records_read)
            self.records_read += 1
            return Val(value)
        }
    }
}

impl JSONLReader {
    fn next_record(&self) -> JSONLRecord? Never! {
        if self.offset >= self.text.count_bytes() -> return None
        start :: self.offset
        line :: self.line
        bytes := [U8]{}
        terminated := false
        loop self.offset < self.text.count_bytes() {
            byte :: stream.byte_at(self.text, self.offset)
            self.offset += 1
            if byte == (U8{10}) {
                self.line += 1
                terminated = true
                break
            }
            &bytes.push(byte)
        }
        if terminated && bytes.len() > 0 && bytes[bytes.len() - 1] == (U8{13}) -> _ :: &bytes.pop()
        Val(JSONLRecord{text: stream.text_from_bytes(^bytes) ?? "", line: line, offset: start})
    }
}

fn reader(text: String) -> JSONLReader Never! {
    JSONLReader{text: text, offset: 0, line: 1, records_read: 0}
}


fn loads(text: String) -> [Dyn] EncodingError! { parse(text) }

fn dumps(rows: [Dyn]) -> String EncodingError! { to_string(rows) }

fn count_rows(text: String) -> Int Never! {
    n := 0
    nonblank := false
    loop index in 0..<text.count_bytes() {
        byte :: stream.byte_at(text, index)
        if byte == (U8{10}) {
            if nonblank -> n += 1
            nonblank = false
        } else if byte != (U8{32}) && byte != (U8{9}) {
            trailing_cr :: byte == (U8{13}) && index + 1 < text.count_bytes() && stream.byte_at(text, index + 1) == (U8{10})
            if !trailing_cr -> nonblank = true
        }
    }
    if nonblank -> n += 1
    n
}

fn append_line(text: String, value: Dyn) -> String EncodingError! {
    needs_lf :: text.count_bytes() > 0 && stream.byte_at(text, text.count_bytes() - 1) != (U8{10})
    encoded :: json.to_string(value) ?? {
        offset := text.count_bytes()
        line := 1
        loop index in 0..<text.count_bytes() {
            if stream.byte_at(text, index) == (U8{10}) -> line += 1
        }
        if needs_lf {
            offset += 1
            line += 1
        }
        return Err(record_error(err, JSONLRecord{text: "", line: line, offset: offset}, count_rows(text)))
    }
    if text.count_bytes() == 0 -> return Ok("{encoded}\n")
    if !needs_lf -> return Ok("{text}{encoded}\n")
    Ok("{text}\n{encoded}\n")
}

fn first(text: String) -> Dyn? EncodingError! {
    cursor := reader(text)
    &cursor.next()
}

// One line of the stream: its text without the line ending, its 1-based line
// number, and the byte offset of its first byte in the whole text.
struct JSONLRecord {
    text: String
    line: Int
    offset: Int
}

fn parse_record(record: JSONLRecord, index: Int) -> Dyn EncodingError! {
    value :: json.parse(record.text) ?? return Err(record_error(err, record, index))
    Ok(value)
}

// Re-anchor a record-local JSON error to the stream.
fn record_error(error: EncodingError, record: JSONLRecord, index: Int) -> EncodingError Never! {
    inner := error.path
    if inner == "/" || inner == "$" -> inner = ""
    {
        format: EncodingFormat.JSONL,
        kind: error.kind,
        byte_offset: record.offset + error.byte_offset,
        line: Val(record.line),
        column: error.column,
        path: "/{index}{inner}",
        reason: error.reason,
        cause: error.cause,
    }
}

fn is_blank(text: String) -> Bool Never! {
    if text.len() == 0 -> return true
    loop index in 0..<text.count_bytes() {
        b :: stream.byte_at(text, index)
        n :: b
        if n != 32 && n != 9 -> return false
    }
    true
}


#Test("JSONL text cursor skips blank records and retains record order") {
    cr :: String.from_bytes([U8]{13}) ?? panic("CR text")
    cursor := reader("\t{cr}\n{{\"z\":1,\"a\":2}}{cr}\n \n3")
    first :: &cursor.next() ?? panic("first record")
    if first == .Val(row) -> assert_eq(json.to_string(row) ?? panic("encode first record"), "{{\"z\":1,\"a\":2}}") else -> panic("missing row")
    second :: &cursor.next() ?? panic("second record")
    assert_eq(second, Val(Dyn.Int(3)))
    assert_eq(&cursor.next() ?? panic("EOF"), None)
    assert_eq(count_rows("\t{cr}\n{{\"z\":1}}{cr}\n \n3"), 2)
}

#Test("JSONL anchors a record-local parse error to the whole text") {
    if parse(" \n1\n[}}\n") == {
        .Ok(_) -> panic("invalid record accepted")
        .Err(error) -> {
            assert(error.format == .JSONL)
            assert_eq(error.line, Val(3))
            assert(error.path.starts_with("/1"))
        }
    }
}

#Test("JSONL only strips CR from LF-terminated records") {
    cr :: String.from_bytes([U8]{13}) ?? panic("CR text")
    assert_eq(count_rows("{cr}\n"), 0)
    assert_eq(count_rows(cr), 1)
    assert_eq(count_rows(" \t{cr}"), 1)
    assert_eq(count_rows("1\n{cr}"), 2)
    cursor := reader("1{cr}")
    assert_eq(&cursor.next() ?? panic("JSON value with trailing whitespace"), Val(Dyn.Int(1)))
    assert_eq(&cursor.next() ?? panic("EOF"), None)
    if parse(cr) == .Err(error) {
        assert_eq(error.byte_offset, 1)
        assert_eq(error.line, Val(1))
        assert_eq(error.path, "/0")
    } else { panic("bare CR was skipped as a blank record") }
}

#Test("JSONL text errors preserve record locations without a dollar suffix") {
    bad :: Dyn.Float(Float.NAN)
    if to_string([Dyn]{bad}) == {
        .Ok(_) -> panic("first non-finite row accepted")
        .Err(error) -> {
            assert(error.format == .JSONL)
            assert(error.kind == .Unsupported)
            assert_eq(error.reason, "JSON cannot encode a non-finite Float")
            assert_eq(error.path, "/0")
            assert_eq(error.byte_offset, 0)
            assert_eq(error.line, Val(1))
        }
    }
    if dumps([Dyn]{Dyn.Int(12), bad}) == {
        .Ok(_) -> panic("second non-finite row accepted")
        .Err(error) -> {
            assert_eq(error.path, "/1")
            assert_eq(error.byte_offset, 3)
            assert_eq(error.line, Val(2))
        }
    }
    if append_line("\n12", bad) == {
        .Ok(_) -> panic("non-finite appended row accepted")
        .Err(error) -> {
            assert_eq(error.path, "/1")
            assert_eq(error.byte_offset, 4)
            assert_eq(error.line, Val(3))
        }
    }
}
