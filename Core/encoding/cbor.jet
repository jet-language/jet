use core.encoding.[Dyn, EncodingError, EncodingErrorKind, EncodingFormat, EncodingLimits]
use core.math as math
use core.time as time

fn syntax_error(format: EncodingFormat, offset: Int, line: Int, column: Int, path: String, reason: String) -> EncodingError Never! {
    {
        format: format,
        kind: EncodingErrorKind.Syntax,
        byte_offset: offset,
        line: Val(line),
        column: Val(column),
        path: path,
        reason: reason,
        cause: None,
    }
}

fn safe_limits() -> EncodingLimits Never! {
    {
        buffer_bytes: 65536,
        max_depth: 256,
        max_item_bytes: 16777216,
        max_total_bytes: None,
        max_expansion_depth: 32,
        max_expansion_bytes: 8388608,
    }
}


// core.encoding.cbor — RFC 8949 definite-length CBOR as Dyn.
//
// Major types 0–5, byte strings, float64, and false/true/null are implemented
// in Jet. DateTime decodes tag 0 RFC 3339 text or tag 1 epoch seconds and
// encodes canonical tag 0 text. Other tags, indefinite-length items, and
// half/single-precision floats fail as Unsupported. Canonical encode uses
// shortest integer forms and sorts map keys by encoded byte order.
pub struct CBOROptions {
    pub max_depth: Int
    pub max_items: Int
    pub max_bytes: Int
    pub require_canonical: Bool
}

pub struct CBORReader {
    pub bytes: [U8]
    pub index: Int
}

pub struct CBORWriter {
    pub parts: [U8]
}

#Error
pub enum CBORErrorKind {
    Syntax
    Truncated
    Unsupported
    Limit
    TypeMismatch
    TrailingData
    NonCanonical
}

#Error
pub struct CBORError {
    pub kind: CBORErrorKind
    pub byte_offset: Int
    pub path: String
    pub reason: String
}

pub fn parse(data: [U8]) -> Dyn EncodingError! { decode(data) }

pub fn decode(data: [U8]) -> Dyn EncodingError! { decode_cbor(data) }

pub fn to_bytes(value: Dyn) -> [U8] Never! { encode_cbor(value, false) }

pub fn to_bytes_canonical(value: Dyn) -> [U8] Never! { encode_cbor(value, true) }

pub fn reader(data: [U8]) -> CBORReader Never! { {bytes: data, index: 0} }

pub fn writer() -> CBORWriter Never! { {parts: [U8]{}} }

impl CBORWriter {
    pub fn write(&self, value: Dyn) Never! {
        chunk :: encode_cbor(value, false)
        loop b in chunk -> &self.parts.push(b)
    }

    pub fn write_canonical(&self, value: Dyn) Never! {
        chunk :: encode_cbor(value, true)
        loop b in chunk -> &self.parts.push(b)
    }

    pub fn to_bytes(self) -> [U8] Never! { self.parts }
}

fn decode_cbor(data: [U8]) -> Dyn EncodingError! {
    p := CBORReader{bytes: data, index: 0}
    value :: &p.read_value(1)
    if p.index != data.len() {
        return Err(syntax_error(
            EncodingFormat.CBOR,
            p.index,
            1,
            p.index + 1,
            "",
            "unexpected trailing CBOR bytes",
        ))
    }
    Ok(value)
}

impl CBORReader {
    fn fail(self, kind: EncodingErrorKind, reason: String) -> EncodingError Never! {
        {
            format: EncodingFormat.CBOR,
            kind: kind,
            byte_offset: self.index,
            line: Val(1),
            column: Val(self.index + 1),
            path: "",
            reason: reason,
            cause: None,
        }
    }

    fn read_byte(&self) -> U8 EncodingError! {
        if self.index >= self.bytes.len() {
            return Err(self.fail(EncodingErrorKind.Truncated, "input ended inside a CBOR item"))
        }
        b :: self.bytes[self.index]
        self.index += 1
        Ok(b)
    }

    fn read_value(&self, depth: Int) -> Dyn EncodingError! {
        if depth > safe_limits().max_depth {
            return Err(self.fail(EncodingErrorKind.Limit, "CBOR nesting exceeds EncodingLimits.safe().max_depth"))
        }
        head :: &self.read_byte()
        head_int := Int.from_u8(head)
        major :: (head_int >> 5) & 7
        extra :: head_int & 31
        if extra == 31 {
            return Err(self.fail(EncodingErrorKind.Unsupported, "indefinite-length CBOR is not part of the Core Dyn adapter"))
        }
        if major == 7 {
            if extra == 20 -> return Ok(Dyn.Bool(false))
            if extra == 21 -> return Ok(Dyn.Bool(true))
            if extra == 22 -> return Ok(Dyn.Null)
            if extra == 27 {
                bits :: &self.read_length(extra)
                value :: math.from_bits(bits) ?? return Err(self.fail(EncodingErrorKind.Syntax, "CBOR float64 value could not be reconstructed"))
                return Ok(Dyn.Float(value))
            }
            return Err(self.fail(EncodingErrorKind.Unsupported, "unsupported CBOR simple value or floating-point width"))
        }
        if major == 6 {
            tag :: &self.read_length(extra)
            if tag != 0 && tag != 1 -> return Err(self.fail(EncodingErrorKind.Unsupported, "unsupported CBOR tag {tag}"))
            payload :: &self.read_value(depth + 1)
            if tag == 0 {
                text :: payload.text() ?? return Err(self.fail(EncodingErrorKind.Syntax, "CBOR tag 0 requires RFC 3339 text"))
                raw :: text.bytes()
                if raw.len() >= 28 && (raw[raw.len() - 9] == (U8{43}) || raw[raw.len() - 9] == (U8{45})) && raw[raw.len() - 6] == (U8{58}) && raw[raw.len() - 3] == (U8{58}) {
                    return Err(self.fail(EncodingErrorKind.Unsupported, "date-time offsets with seconds are unsupported"))
                }
                stamp :: Dyn.Text(text)
                z :: stamp.decode<ZonedDateTime>() ?? return Err(self.fail(EncodingErrorKind.Syntax, "invalid CBOR tag 0 date-time"))
                if z.offset_seconds() %% 60 != 0 -> return Err(self.fail(EncodingErrorKind.Unsupported, "date-time offset must be whole minutes"))
                return Ok(Dyn.DateTime(z))
            }
            if payload == {
                .Int(seconds) -> return Ok(Dyn.DateTime(time.zoned(time.from_unix_seconds(seconds), time.utc())))
                .Float(seconds) -> {
                    if !math.is_finite(seconds) || seconds < -9223372036854775808.0 || seconds >= 9223372036854775808.0 {
                        return Err(self.fail(EncodingErrorKind.Unsupported, "CBOR epoch seconds are outside the supported range"))
                    }
                    whole :: math.floor(seconds)
                    nanos :: Int{math.round((seconds - whole) * 1000000000.0)}
                    dt :: time.from_unix_seconds(Int{whole}).plus_duration(time.duration_ns(nanos))
                    return Ok(Dyn.DateTime(time.zoned(dt, time.utc())))
                }
                else -> return Err(self.fail(EncodingErrorKind.Syntax, "CBOR tag 1 requires Int or Float epoch seconds"))
            }
        }
        n :: &self.read_length(extra)
        if major == {
            0 -> return Ok(Dyn.Int(n))
            1 -> return Ok(Dyn.Int(-1 - n))
            else -> { _ := 0 }
        }
        if major == 2 {
            if n > safe_limits().max_item_bytes -> return Err(self.fail(EncodingErrorKind.Limit, "CBOR byte string exceeds EncodingLimits.safe().max_item_bytes"))
            raw := [U8]{}
            loop _ in 0..<n {
                b :: &self.read_byte()
                &raw.push(b)
            }
            return Ok(Dyn.Bytes(raw))
        }
        if major == 3 {
            if n > safe_limits().max_item_bytes {
                return Err(self.fail(EncodingErrorKind.Limit, "CBOR text string exceeds EncodingLimits.safe().max_item_bytes"))
            }
            raw := [U8]{}
            loop _ in 0..<n {
                b :: &self.read_byte()
                &raw.push(b)
            }
            text :: String.from_bytes(raw) ?? return Err(self.fail(EncodingErrorKind.Syntax, "CBOR text string is not valid UTF-8"))
            return Ok(Dyn.Text(text))
        }
        if major == 4 {
            if n > safe_limits().max_item_bytes {
                return Err(self.fail(EncodingErrorKind.Limit, "CBOR array exceeds EncodingLimits.safe().max_item_bytes"))
            }
            items := [Dyn]{}
            loop _ in 0..<n {
                item :: &self.read_value(depth + 1)
                &items.push(item)
            }
            return Ok(Dyn.Array(items))
        }
        if major == 5 {
            if n > safe_limits().max_item_bytes {
                return Err(self.fail(EncodingErrorKind.Limit, "CBOR map exceeds EncodingLimits.safe().max_item_bytes"))
            }
            entries := Dyn.object()
            loop _ in 0..<n {
                key_tree :: &self.read_value(depth + 1)
                key :: key_tree.text() ?? return Err(self.fail(EncodingErrorKind.Unsupported, "CBOR map keys must be text to land in Dyn.Object"))
                if entries.has(key) -> return Err(self.fail(EncodingErrorKind.Syntax, "duplicate CBOR map key `{key}`"))
                value :: &self.read_value(depth + 1)
                entries[key] = value
            }
            return Ok(entries)
        }
        Err(self.fail(EncodingErrorKind.Unsupported, "unsupported CBOR major type"))
    }

    fn read_length(&self, extra: Int) -> Int EncodingError! {
        if extra < 24 -> return Ok(extra)
        if extra == 24 {
            b :: &self.read_byte()
            return Ok(Int.from_u8(b))
        }
        if extra == 25 {
            hi :: &self.read_byte()
            lo :: &self.read_byte()
            return Ok((Int.from_u8(hi) << 8) | Int.from_u8(lo))
        }
        if extra == 26 {
            b0 :: &self.read_byte()
            b1 :: &self.read_byte()
            b2 :: &self.read_byte()
            b3 :: &self.read_byte()
            return Ok((Int.from_u8(b0) << 24) | (Int.from_u8(b1) << 16) | (Int.from_u8(b2) << 8) | Int.from_u8(b3))
        }
        if extra == 27 {
            n := 0
            loop _ in 0..<8 {
                b :: &self.read_byte()
                n = (n << 8) | Int.from_u8(b)
            }
            return Ok(n)
        }
        Err(self.fail(EncodingErrorKind.Syntax, "invalid CBOR additional info"))
    }
}

fn encode_cbor(value: Dyn, canonical: Bool) -> [U8] Never! {
    out := [U8]{}
    write_cbor(&out, value, canonical)
    out
}

fn cbor_push(out: &[U8], value: U8) {
    &out.push(value)
}

fn write_cbor(out: &[U8], value: Dyn, canonical: Bool) Never! {
    if value == {
        .Null -> { cbor_push(&out, U8{246}) }
        .Bool(v) -> {
            if v {
                cbor_push(&out, U8{245})
            } else {
                cbor_push(&out, U8{244})
            }
        }
        .Int(n) -> { write_cbor_int(&out, n) }
        .Float(n) -> { write_cbor_float(&out, n) }
        .Text(s) -> {
            raw :: s.bytes()
            write_cbor_head(&out, 3, raw.len())
            loop b in raw { cbor_push(&out, b) }
        }
        .Bytes(raw) -> {
            write_cbor_head(&out, 2, raw.len())
            loop b in raw -> cbor_push(&out, b)
        }
        .DateTime(_) -> {
            write_cbor_head(&out, 6, 0)
            write_cbor(&out, Dyn.Text(value.to_text() ?? ""), canonical)
        }
        .Array(items) -> { write_cbor_array(&out, items, canonical) }
        .Object(_) -> { write_cbor_object(&out, value, canonical) }
    }
}

fn write_cbor_array(out: &[U8], items: [Dyn], canonical: Bool) {
    write_cbor_head(&out, 4, items.len())
    loop item in items -> write_cbor(&out, item, canonical)
}

fn write_cbor_object(out: &[U8], entries: Dyn, canonical: Bool) {
    write_cbor_head(&out, 5, entries.len())
    if !canonical {
        loop key in entries.keys() {
            write_cbor(&out, Dyn.Text(key), canonical)
            write_cbor(&out, entries[key], canonical)
        }
        return
    }
    keys := entries.keys()
    loop i in 0..<keys.len() {
        loop j in (i + 1)..<keys.len() {
            if compare_cbor_text(keys[j], keys[i]) < 0 {
                tmp :: ~keys[i]
                keys[i] = keys[j]
                keys[j] = tmp
            }
        }
    }
    loop key in keys {
        write_cbor(&out, Dyn.Text(key), canonical)
        write_cbor(&out, entries[key], canonical)
    }
}

fn compare_cbor_text(a: String, b: String) -> Int {
    aa :: a.bytes()
    bb :: b.bytes()
    if aa.len() < bb.len() -> return -1
    if aa.len() > bb.len() -> return 1
    loop i in 0..<aa.len() {
        if aa[i] < bb[i] -> return -1
        if aa[i] > bb[i] -> return 1
    }
    0
}

fn write_cbor_float(out: &[U8], n: Float) Never! {
    bits :: math.to_bits(n)
    &out.push(U8{251})
    k := 7
    loop k >= 0 {
        &out.push(to_u8(bits >> (k * 8)))
        k -= 1
    }
}

fn write_cbor_int(out: &[U8], n: Int) {
    if n >= 0 {
        write_cbor_head(&out, 0, n)
        return
    }
    write_cbor_head(&out, 1, -1 - n)
}

fn write_cbor_head(out: &[U8], major: Int, n: Int) {
    if n < 24 {
        &out.push(to_u8((major << 5) | n))
        return
    }
    if n < 256 {
        &out.push(to_u8((major << 5) | 24))
        &out.push(U8{n})
        return
    }
    if n < 65536 {
        &out.push(to_u8((major << 5) | 25))
        &out.push(to_u8(n >> 8))
        &out.push(to_u8(n))
        return
    }
    if n < 4294967296 {
        &out.push(to_u8((major << 5) | 26))
        &out.push(to_u8(n >> 24))
        &out.push(to_u8(n >> 16))
        &out.push(to_u8(n >> 8))
        &out.push(to_u8(n))
        return
    }
    &out.push(to_u8((major << 5) | 27))
    k := 7
    loop k >= 0 {
        &out.push(to_u8(n >> (k * 8)))
        k -= 1
    }
}

/// Low byte of `n`. The mask runs in `Int`, so a wide value never reaches the
/// checked `U8{}` conversion.
fn to_u8(n: Int) -> U8 Never! {
    v :: n & 255
    (U8{v})
}
