        state.stats.flush_calls += U64{1}
        jet_encoding_hostile_io_apply_interrupt(state, plan, false)?
        // GATE #4565: kernel primitive — unbuffered descriptor flush.
        #Unsafe("flush only the writer-owned unbuffered descriptor") { writer.inner.get_mut().flush() }
    })
}
