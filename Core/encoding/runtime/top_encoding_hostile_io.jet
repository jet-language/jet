    bytes_read: U64 = U64{0}
    bytes_written: U64 = U64{0}
    interrupts: U64 = U64{0}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingHostileIo.rs:32
struct JetEncodingHostileIoState {
    plan: JetEncodingHostileIoPlan?
    stats: JetEncodingHostileIoStats
