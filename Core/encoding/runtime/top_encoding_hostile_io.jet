use core.cell.[RefCell, ThreadLocal]
use std.env
use std.io

// D-ENCSTREAM-SURFACE1 hostile streaming law seam (#711 / #715 C6).
// Active only when JET_ENC_HOSTILE_IO exists and is not "0".
// READ_PLAN/WRITE_PLAN are comma-separated caps; their final entry repeats.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingHostileIo.rs:11
JET_ENCODING_IO_CHUNK :: 64 * 1024
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingHostileIo.rs:13
struct JetEncodingHostileIoPlan {
    read_one_byte: Bool = false
    write_chunk: Int = 0
    interrupt_reads: U8 = U8{0}
    interrupt_writes: U8 = U8{0}
    fail_read_after: U64? = None
    fail_write_after: U64? = None
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingHostileIo.rs:23
struct JetEncodingHostileIoStats {
    read_calls: U64 = U64{0}
    write_calls: U64 = U64{0}
