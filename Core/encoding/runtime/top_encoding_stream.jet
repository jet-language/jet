        if finished -> return None
        match next() {
            Ok(Ok(item)) -> Val(Ok(^item)),
            Ok(Err(JetAbsent)) -> { finished = true; None },
            Err(error) -> { finished = true; Val(Err(^error)) },
        }
    })
}
