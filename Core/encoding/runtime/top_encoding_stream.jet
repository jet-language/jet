            out.extend(digits.iter().map(fn(byte) { byte as Char }))
            out.extend(std.iter.repeat_n('0', n as USize - digits.len()))
        } else {
            split :: n as USize
            out.extend(digits[..split].iter().map(fn(byte) { byte as Char }))
            out.push('.')
            out.extend(digits[split..].iter().map(fn(byte) { byte as Char }))
        }
    } else if n > -6 && n <= 0 {
        out.push_str("0.")
        out.extend(std.iter.repeat_n('0', (-n) as USize))
        out.extend(digits.iter().map(fn(byte) { byte as Char }))
    } else {
        out.push(digits[0] as Char)
        if digits.len() > 1 {
            out.push('.')
            out.extend(digits[1..].iter().map(fn(byte) { byte as Char }))
        }
