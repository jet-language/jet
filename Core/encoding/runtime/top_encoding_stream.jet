fn jet_json_jcs_number(value: F64) -> String {
    if value == 0.0 -> return "0"
    negative :: value.is_sign_negative()
    shortest :: jet_json_jcs_shortest(value.abs())
    (mantissa, exponent) :: shortest.split_once('e').map(fn(pair) {
        (pair.0, pair.1.parse<I32>().expect("Rust float exponent"))
    }).unwrap_or((&shortest, 0))
    decimal :: mantissa.find('.').unwrap_or(mantissa.len()) as I32
