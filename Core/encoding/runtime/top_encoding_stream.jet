        Val(format!("max_expansion_depth {} is outside 0..256", limits.max_expansion_depth))
    } else if limits.max_expansion_bytes < 0 || limits.max_expansion_bytes > 1073741824 {
        Val(format!("max_expansion_bytes {} is outside 0..1073741824", limits.max_expansion_bytes))
    } else { None }
