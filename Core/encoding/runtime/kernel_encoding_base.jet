pub fn jet_std_crc32(bytes: View<U8>) -> I64 Never! {
    crc := 4294967295
    loop byte in bytes {
        crc = crc ~| Int.from_u8(byte)
        loop _ in 0..<8 -> crc = if crc & 1 != 0 -> (crc >> 1) ~| 3988292384 else -> crc >> 1
    }
    I64.from_int(crc ~| 4294967295) ?? panic("CRC32 fits I64")
}
// Rust: crates/jet-codegen/src/Prelude/Core/EncodingBase.rs:117
pub fn jet_std_b64_encode(bytes: View<U8>) -> String Never! {
    alphabet :: unicode.utf8_bytes(JET_B64_CHARS)
    out := [U8].with_capacity((bytes.len() + 2) / 3 * 4)
    at := 0
    loop at < bytes.len() {
        count :: (bytes.len() - at).min(3)
        b0 :: Int.from_u8(bytes[at])
        b1 :: if count > 1 -> Int.from_u8(bytes[at + 1]) else -> 0
        b2 :: if count > 2 -> Int.from_u8(bytes[at + 2]) else -> 0
        n :: (b0 << 16) | (b1 << 8) | b2
        &out.push(alphabet[n >> 18])
        &out.push(alphabet[(n >> 12) & 63])
        &out.push(if count > 1 -> alphabet[(n >> 6) & 63] else -> U8{61})
        &out.push(if count > 2 -> alphabet[n & 63] else -> U8{61})
        at += 3
    }
    String.from_bytes(out) ?? panic("Base64 output is ASCII")
}
// Rust: crates/jet-codegen/src/Prelude/Core/EncodingBase.rs:141
pub fn jet_std_b64_encodebytes(bytes: View<U8>) -> String Never! {
    encoded :: unicode.utf8_bytes(jet_std_b64_encode(bytes))
    out := [U8].with_capacity(encoded.len() + encoded.len() / 76 + 1)
    at := 0
    loop at < encoded.len() {
        end :: (at + 76).min(encoded.len())
        loop index in at..<end -> &out.push(encoded[index])
        &out.push(U8{10})
        at = end
    }
    String.from_bytes(out) ?? panic("Base64 output is ASCII")
}
