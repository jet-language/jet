// Rust: crates/jet-codegen/src/Prelude/Core/EncodingBase.rs:8
pub fn jet_std_hex_decode(text: String) -> [U8] Err! {
    bytes :: unicode.utf8_bytes(text)
    if bytes.len() %% 2 != 0 -> return Err("odd-length hex string; hex text encodes whole bytes, so the length must be even")
    out := [U8].with_capacity(bytes.len() / 2)
    at := 0
    loop at < bytes.len() {
        high :: hex_nibble(bytes[at]) ?? return Err("invalid hex digit; expected 0-9, a-f, or A-F")
        low :: hex_nibble(bytes[at + 1]) ?? return Err("invalid hex digit; expected 0-9, a-f, or A-F")
        &out.push((high << 4) | low)
        at += 2
    }
    Ok(out)
}
// Rust: crates/jet-codegen/src/Prelude/Core/EncodingBase.rs:25
fn hex_nibble(byte: U8) -> U8? Never! {
    if byte >= (U8{48}) && byte <= (U8{57}) -> return Val(byte - U8{48})
    if byte >= (U8{97}) && byte <= (U8{102}) -> return Val(byte - U8{97} + U8{10})
    if byte >= (U8{65}) && byte <= (U8{70}) -> return Val(byte - U8{65} + U8{10})
    None
}
// Rust: crates/jet-codegen/src/Prelude/Core/EncodingBase.rs:34
fn hex_with_digits(bytes: View<U8>, digits: String) -> String Never! {
    alphabet :: unicode.utf8_bytes(digits)
    out := [U8].with_capacity(bytes.len() * 2)
    loop byte in bytes {
        &out.push(alphabet[Int.from_u8(byte >> 4)])
        &out.push(alphabet[Int.from_u8(byte & U8{15})])
    }
    String.from_bytes(out) ?? panic("hex output is ASCII")
}
