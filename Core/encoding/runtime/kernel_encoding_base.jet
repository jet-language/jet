// Rust: crates/jet-codegen/src/Prelude/Core/EncodingBase.rs:58
pub fn jet_std_hex_dump(bytes: View<U8>) -> String Never! {
    out := String.new()
    offset := 0
    loop offset < bytes.len() {
        hex := String.new()
        ascii := [U8]{}
        loop index in 0..<16 {
            if index > 0 -> &hex.push_str(" ")
            if offset + index < bytes.len() {
                byte :: bytes[offset + index]
                &hex.push_str(hex_with_digits([byte], "0123456789abcdef"))
                &ascii.push(if byte >= (U8{32}) && byte <= (U8{126}) -> byte else -> U8{46})
            } else -> &hex.push_str("  ")
        }
        // Eight is a minimum width, not an offset truncation.
        digits :: "0123456789abcdef"
        alphabet :: unicode.utf8_bytes(digits)
        address := [U8]{}
        value := offset
        loop {
            &address.push(alphabet[value & 15])
            value >>= 4
            if value == 0 -> break
        }
        loop address.len() < 8 -> &address.push(U8{48})
        &address.reverse()
        address_text :: String.from_bytes(address) ?? panic("hex offset is ASCII")
        ascii_text :: String.from_bytes(ascii) ?? panic("hex dump is ASCII")
        &out.push_str("{address_text}  {hex}  {ascii_text}\n")
        offset += 16
    }
    out
}
