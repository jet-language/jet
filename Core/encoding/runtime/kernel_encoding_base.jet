const JET_BASE32_CHARS: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
// Rust: crates/jet-codegen/src/Prelude/Core/EncodingBase.rs:206
const JET_BASE32HEX_CHARS: String = "0123456789ABCDEFGHIJKLMNOPQRSTUV"
// Rust: crates/jet-codegen/src/Prelude/Core/EncodingBase.rs:208
fn base32_encode_with_alphabet(bytes: View<U8>, alphabet_text: String) -> String Never! {
    alphabet :: unicode.utf8_bytes(alphabet_text)
    out := [U8]{}
    buffer := 0
    bits := 0
    loop byte in bytes {
        buffer = ((buffer << 8) | Int.from_u8(byte)) & 4294967295
        bits += 8
        loop bits >= 5 {
            index :: (buffer >> (bits - 5)) & 31
            &out.push(alphabet[index])
            bits -= 5
        }
    }
    if bits > 0 -> &out.push(alphabet[(buffer << (5 - bits)) & 31])
    loop out.len() %% 8 != 0 -> &out.push(U8{61})
    String.from_bytes(out) ?? panic("Base32 output is ASCII")
}
// Rust: crates/jet-codegen/src/Prelude/Core/EncodingBase.rs:231
pub fn jet_std_base32_encode(bytes: View<U8>) -> String Never! { base32_encode_with_alphabet(bytes, JET_BASE32_CHARS) }
