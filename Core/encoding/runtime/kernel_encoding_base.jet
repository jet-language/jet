pub fn jet_std_crc_hqx(bytes: View<U8>, value: I64) -> I64 Never! {
    crc := Int.from_i64(value) & 65535
    loop byte in bytes {
        crc = crc ~| (Int.from_u8(byte) << 8)
        loop _ in 0..<8 {
            crc = if crc & 32768 != 0 -> ((crc << 1) ~| 4129) & 65535 else -> (crc << 1) & 65535
        }
    }
    I64.from_int(crc) ?? panic("CRC16 fits I64")
}
