// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingStream.rs:1741
fn jet_json_fold_from_event(reader: &JSONReader, first: DataEvent, heap: &JetJsonlHeapBudget) -> DataTree EncodingError! {
    root: DataTree? := None
    frames: [JetJsonlFoldFrame] := []
    pending := Some(^first)
    loop {
        event :: if pending.take() == {
            Some(value) -> ^value
            None -> {
                value :: reader.next_event() ?? return Err(^err)
                if value == Some(event) -> ^event
                else -> return Err(jet_encoding_error(.Truncated, reader.offset, reader.line, reader.column, "JSON value ended before it was closed"))
            }
        }
        result :: if event == {
            .Null -> {
                if !heap.charge_decoded(1) -> Err(jet_json_fold_limit_error(reader, false))
                else -> jet_json_fold_push_value(reader, heap, &root, &frames, .Null)
            }
            .Bool(value) -> {
                if !heap.charge_decoded(1) -> Err(jet_json_fold_limit_error(reader, false))
                else -> jet_json_fold_push_value(reader, heap, &root, &frames, .Bool(value))
            }
            .Int(value) -> {
                if !heap.charge_decoded(8) -> Err(jet_json_fold_limit_error(reader, false))
                else -> jet_json_fold_push_value(reader, heap, &root, &frames, .Int(value))
            }
            .Float(value) -> {
                if !heap.charge_decoded(8) -> Err(jet_json_fold_limit_error(reader, false))
                else -> jet_json_fold_push_value(reader, heap, &root, &frames, .Float(value))
            }
            .Number(value) -> {
                if !heap.charge_decoded(value.len()) -> Err(jet_json_fold_limit_error(reader, false))
                else -> jet_json_fold_push_value(reader, heap, &root, &frames, .Number(^value))
            }
            .Text(value) -> {
                if !heap.charge_decoded(value.len()) -> Err(jet_json_fold_limit_error(reader, false))
                else -> jet_json_fold_push_value(reader, heap, &root, &frames, .TypedText(^value))
            }
            .Bytes(value) -> {
                if !heap.charge_decoded(value.len()) -> Err(jet_json_fold_limit_error(reader, false))
                else -> jet_json_fold_push_value(reader, heap, &root, &frames, .Bytes(^value))
            }
            .ArrayStart -> {
                if !heap.charge_decoded(1) -> Err(jet_json_fold_limit_error(reader, false))
                else if !jet_jsonl_reserve_push(heap, &frames) -> Err(jet_json_fold_limit_error(reader, true))
                else { frames.push(.Array([])); Ok(()) }
            }
            .ObjectStart -> {
                if !heap.charge_decoded(1) -> Err(jet_json_fold_limit_error(reader, false))
                else if !jet_jsonl_reserve_push(heap, &frames) -> Err(jet_json_fold_limit_error(reader, true))
                else { frames.push(.Object{entries: [], key: None}); Ok(()) }
            }
            .Key(value) -> {
                if frames.last_mut() == Some(.Object{key, ..}) && key.is_none() {
                    if !heap.charge_decoded(value.len()) -> Err(jet_json_fold_limit_error(reader, false))
                    else { key = Some(^value); Ok(()) }
                } else -> Err(jet_encoding_error(.State, reader.offset, reader.line, reader.column, "JSON event stream produced a key outside an object"))
            }
            .ArrayEnd -> {
                if frames.pop() == Some(.Array(items)) -> jet_json_fold_push_value(reader, heap, &root, &frames, .Array(^items))
                else -> Err(jet_encoding_error(.State, reader.offset, reader.line, reader.column, "JSON event stream closed the wrong container"))
            }
            .ObjectEnd -> {
                if frames.pop() == Some(.Object{entries, key: None}) -> jet_json_fold_push_value(reader, heap, &root, &frames, .Object(^entries))
                else -> Err(jet_encoding_error(.State, reader.offset, reader.line, reader.column, "JSON event stream closed an incomplete object"))
            }
        }
        _ :: result ?? return Err(^err)
        if frames.is_empty() {
            if root.take() == Some(value) -> return Ok(^value)
            return Err(jet_encoding_error(.State, reader.offset, reader.line, reader.column, "JSON event stream produced no root value"))
        }
    }
}

