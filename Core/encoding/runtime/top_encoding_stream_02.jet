// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingStream.rs:2395
fn jet_csv_io_error(error: std.io.Error, offset: I64, line: I64, column: I64, path: String) -> EncodingError {
    out := jet_csv_error(.IO, offset, line, column, ^path, "file IO failed")
    out.cause = Ok(EncodingCause{kind: error.kind().debug(), os_code: jet_outcome_of(error.raw_os_error().map((code) -> I64.from_i32(code))), message: error.to_string()})
    out
