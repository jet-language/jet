// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingStream.rs:2071
fn jet_jsonl_tree_size(value: DataTree, depth: I64, path: String, limits: EncodingLimits) -> USize EncodingError! {
    is_container :: if value == { .Array(_), .Object(_) -> true; else -> false }
    if is_container && depth >= limits.max_depth {
        error := jet_encoding_error(.Limit, 0, 1, 1, "max_depth {limits.max_depth} exceeded")
        error.path = path.to_string()
        return Err(^error)
    }
    size :: if value == {
        .Null, .Bool(_) -> USize{1}
        .Int(_) -> USize{8}
        .Float(number) -> {
            if number.is_finite() -> USize{8}
            else {
                error := jet_encoding_error(.Unsupported, 0, 1, 1, "JSON cannot encode a non-finite Float")
                error.path = path.to_string()
                return Err(^error)
            }
        }
        .Number(_), .TypedText(_) -> {
            error := jet_encoding_error(.State, 0, 1, 1, "internal JSON carrier escaped typed decode")
            error.path = path.to_string()
            return Err(^error)
        }
        .Text(text) -> text.len()
        .Bytes(_) -> {
            error := jet_encoding_error(.Unsupported, 0, 1, 1, "JSON cannot encode Bytes; encode bytes as Text explicitly")
            error.path = path.to_string()
            return Err(^error)
        }
        .Array(items) -> {
            size := USize{1}
            loop (index, item) in items.iter().enumerate() {
                child :: jet_jsonl_tree_size(item, depth + 1, "{path}[{index}]", limits) ?? return Err(^err)
                size = size.checked_add(child) ?? return Err(jet_encoding_error(.Limit, 0, 1, 1, "max_item_bytes {limits.max_item_bytes} exceeded"))
            }
            size
        }
        .Object(entries) -> {
            size := USize{1}
            loop (key, item) in entries {
                child :: jet_jsonl_tree_size(item, depth + 1, "{path}[{key.debug()}]", limits) ?? return Err(^err)
                with_key :: size.checked_add(key.len()) ?? return Err(jet_encoding_error(.Limit, 0, 1, 1, "max_item_bytes {limits.max_item_bytes} exceeded"))
                size = with_key.checked_add(child) ?? return Err(jet_encoding_error(.Limit, 0, 1, 1, "max_item_bytes {limits.max_item_bytes} exceeded"))
            }
            size
        }
    }
    if size > USize.from_i64(limits.max_item_bytes) {
        error := jet_encoding_error(.Limit, 0, 1, 1, "max_item_bytes {limits.max_item_bytes} exceeded")
        error.path = path.to_string()
        return Err(^error)
    }
    Ok(size)
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingStream.rs:2173
fn jet_jsonl_wire_size(writer: JSONWriter, value: DataTree) -> USize EncodingError! {
    checked_sum :: (parts: View<USize>) -> USize EncodingError! {
        sum := USize{0}
        loop part in parts {
            sum = sum.checked_add(part) ?? return Err(jet_encoding_error(.Limit, writer.total, 1, writer.total + 1, "JSONL record wire size overflow"))
        }
        Ok(sum)
    }
    if value == {
        .Null, .Bool(true) -> Ok(4)
        .Bool(false) -> Ok(5)
        .Int(number) -> Ok(number.to_string().len())
        .Float(number) -> Ok(number.to_string().len())
        .Text(text) -> {
            length :: writer.quoted_len(text) ?? return Err(^err)
            checked_sum([length, 2])
        }
        .Number(_), .TypedText(_) -> Err(jet_encoding_error(.State, writer.total, 1, writer.total + 1, "internal JSON carrier escaped typed decode"))
        .Bytes(_) -> Err(jet_encoding_error(.Unsupported, writer.total, 1, writer.total + 1, "JSON cannot encode Bytes; encode bytes as Text explicitly"))
        .Array(items) -> {
            size := USize{2}
            loop (index, item) in items.iter().enumerate() {
                child :: jet_jsonl_wire_size(writer, item) ?? return Err(^err)
                size = checked_sum([size, if index > 0 -> 1 else -> 0, child]) ?? return Err(^err)
            }
            Ok(size)
        }
        .Object(entries) -> {
            size := USize{2}
            loop (index, (key, item)) in entries.iter().enumerate() {
                quoted :: writer.quoted_len(key) ?? return Err(^err)
                child :: jet_jsonl_wire_size(writer, item) ?? return Err(^err)
                size = checked_sum([size, if index > 0 -> 1 else -> 0, quoted, 3, child]) ?? return Err(^err)
            }
            Ok(size)
        }
    }
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingStream.rs:2227
fn jet_jsonl_write_tree(writer: &JSONWriter, value: DataTree) -> () EncodingError! {
    if value == {
        .Null -> writer.write_event(.Null)
        .Bool(v) -> writer.write_event(.Bool(v))
        .Int(v) -> writer.write_event(.Int(v))
        .Float(v) -> writer.write_event(.Float(v))
        .Number(_), .TypedText(_) -> Err(jet_encoding_error(.State, writer.total, 1, writer.total + 1, "internal JSON carrier escaped typed decode"))
        .Text(v) -> writer.write_event(.Text(v.clone()))
        .Bytes(v) -> writer.write_event(.Bytes(v.clone()))
        .Array(items) -> {
            _ :: writer.write_event(.ArrayStart) ?? return Err(^err)
            loop item in items { _ :: jet_jsonl_write_tree(writer, item) ?? return Err(^err) }
            writer.write_event(.ArrayEnd)
        }
        .Object(entries) -> {
            _ :: writer.write_event(.ObjectStart) ?? return Err(^err)
            loop (key, item) in entries {
                _ :: writer.write_event(.Key(key.clone())) ?? return Err(^err)
                _ :: jet_jsonl_write_tree(writer, item) ?? return Err(^err)
            }
            writer.write_event(.ObjectEnd)
        }
    }
}

