    // Rust: crates/jet-codegen/src/Prelude/Core/Bytes.rs:258
    pub fn partition(self, separator: JetByteBuffer) -> [JetByteBuffer] Err! {
        if separator.bytes.is_empty() -> return Err("byte partition separator must not be empty")
        index := 0
        loop index + separator.bytes.len() <= self.bytes.len() {
            if self.bytes[index..<(index + separator.bytes.len())] == separator.bytes[0..<separator.bytes.len()] {
                return Ok([JetByteBuffer]{
                    from_owned(self.bytes[0..<index].to_vec()), separator.clone(),
                    from_owned(self.bytes[(index + separator.bytes.len())..<self.bytes.len()].to_vec())})
            }
            index = index + 1
        }
        Ok([JetByteBuffer]{self.clone(), new(), new()})
    }
