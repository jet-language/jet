    pub fn lines(self) -> [String] Never! {
        // Rust lines uses LF with an optional preceding CR; other separators stay text.
        text :: self.as_text()
        if text.is_empty() -> return [String]{}
        parts := text_parse.split(text, "\n")
        if text.ends_with("\n") -> _ :: parts.pop()
        loop i in 0..<parts.len() {
            if parts[i].ends_with("\r") && (i < parts.len() - 1 || text.ends_with("\n")) {
                parts[i] = parts[i].slice(0, parts[i].len() - 1)
            }
        }
        ^parts
    }
