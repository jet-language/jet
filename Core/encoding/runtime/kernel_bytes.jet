    pub fn compare(self, other: JetByteBuffer) -> Int Never! {
        loop i in 0..<self.bytes.len().min(other.bytes.len()) {
            if self.bytes[i] < other.bytes[i] -> return -1
            if self.bytes[i] > other.bytes[i] -> return 1
        }
