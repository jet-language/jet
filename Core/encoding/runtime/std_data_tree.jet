            n :: Int.from_i64(i)
            idx := n
            if n < 0 {
                if i == I64{-9223372036854775808} -> return Err(FieldError.at(path, "index {i} out of bounds (len {items.len()})"))
                idx = items.len() + n
            }
            if idx < 0 || idx >= items.len() -> return Err(FieldError.at(path, "index {i} out of bounds (len {items.len()})"))
            return Ok(~items[idx])
        }
        rendered :: render_datatree_json(self, false, 0)
        Err(FieldError.at(path, "expected array, got {rendered}"))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:268
    pub fn int(self) -> Int [FieldError]! {
