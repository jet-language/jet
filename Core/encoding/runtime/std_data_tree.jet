    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:220
    pub fn field(self, name: String) -> DataTree [FieldError]! {
        if self == .Object(pairs) {
            loop pair in pairs -> if pair.0 == name -> return Ok(~pair.1)
            return Err(FieldError.at(name, "field `{name}` not found"))
        }
        rendered :: render_datatree_json(self, false, 0)
        Err(FieldError.at(name, "expected object, got {rendered}"))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:236
    pub fn at(self, i: I64) -> DataTree [FieldError]! {
