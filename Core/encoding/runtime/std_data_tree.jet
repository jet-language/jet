    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:205
    fn int(self) -> Int [FieldError]!
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:206
    fn text(self) -> String [FieldError]!
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:207
