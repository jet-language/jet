            .Int(n) -> return Ok(n)
            .Number(text) -> {
                digits :: json_exact_integer_text(text) ?? return Err(FieldError.one("expected int, got {render_datatree_json(self, false, 0)}"))
                n :: Int.parse(digits) ?? return Err(FieldError.one("expected int, got {render_datatree_json(self, false, 0)}"))
                return Ok(n)
            }
            else -> return Err(FieldError.one("expected int, got {render_datatree_json(self, false, 0)}"))
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:290
    pub fn text(self) -> String [FieldError]! {
        if self == {
            .Text(s) -> return Ok(~s)
            .TypedText(s) -> return Ok(~s)
            else -> return Err(FieldError.one("expected text, got {render_datatree_json(self, false, 0)}"))
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:299
    pub fn bool(self) -> Bool [FieldError]! {
        if self == .Bool(b) -> return Ok(b)
        Err(FieldError.one("expected bool, got {render_datatree_json(self, false, 0)}"))
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:308
    pub fn float(self) -> Float [FieldError]! {
        if self == {
            .Float(f) -> return Ok(f)
            .Int(n) -> {
                value :: Float.from_int(n)
                if math.is_finite(value) -> return Ok(value)
                return Err(FieldError.one("expected float, got out-of-range Int"))
            }
            .Number(text) -> {
                trimmed := text.trim() // #4303
                value :: Float.parse(trimmed) ?? return Err(FieldError.one("expected float, got {render_datatree_json(self, false, 0)}"))
                if math.is_finite(value) -> return Ok(value)
                return Err(FieldError.one("expected float, got {render_datatree_json(self, false, 0)}"))
            }
            else -> return Err(FieldError.one("expected float, got {render_datatree_json(self, false, 0)}"))
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:337
    pub fn to_text(self) -> String? Never! {
        if self == {
            .Text(text) -> return Val(~text)
            .TypedText(text) -> return Val(~text)
            .Int(value) -> return Val(value.to_string())
            .Float(value) -> return Val(jet_debug_float(value))
            .Bool(value) -> return Val(value.to_string())
            .Number(text) -> return Val(~text)
            else -> return None
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:348
    pub fn equal_unordered(self, other: DataTree) -> Bool Never! {
        if (self, other) == {
            (.Null, .Null) -> return true
            (.Bool(a), .Bool(b)) -> return a == b
            (.Int(a), .Int(b)) -> return a == b
            (.Float(a), .Float(b)) -> return !math.is_nan(a) && !math.is_nan(b) && a == b
            (.Number(a), .Number(b)) -> return a == b
            (.TypedText(a), .TypedText(b)) -> return a == b
            (.Text(a), .Text(b)) -> return a == b
            (.Bytes(a), .Bytes(b)) -> return a == b
            (.Array(a), .Array(b)) -> {
                if a.len() != b.len() -> return false
                loop i in 0..<a.len() -> if !a[i].equal_unordered(b[i]) -> return false
                return true
            }
            (.Object(a), .Object(b)) -> {
                if a.len() != b.len() -> return false
                used := [Bool]{}
                loop _ in b -> &used.push(false)
                loop entry in a {
                    matched := Int?{None}
                    loop i in 0..<b.len() {
                        if !used[i] && entry.0 == b[i].0 && entry.1.equal_unordered(b[i].1) {
                            matched = Val(i)
                            break
                        }
                    }
                    i :: matched ?? return false
                    used[i] = true
                }
                return true
            }
            else -> return false
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:402
pub fn jet_datatree_decode_fixed_integer(t: DataTree, signed: Bool, bits: U8, type_name: String) -> I128 [FieldError]! {
    kind :: if (signed, bits) == {
        (true, U8{8}) -> 0
        (true, U8{16}) -> 1
        (true, U8{32}) -> 2
        (true, U8{64}) -> 3
        (false, U8{8}) -> 4
        (false, U8{16}) -> 5
        (false, U8{32}) -> 6
        (false, U8{64}) -> 7
        else -> return Err(FieldError.one("expected {type_name}, found out-of-range Int"))
    }
    value :: decode_int_with<I128>(t, (n: Int) -> I128 Err! {
        I128.from_int(n) ?? return Err("exact Int is outside i128")
    }, (text: String) -> I128 Err! {
        I128.parse(text) ?? return Err("exact Int is outside i128")
    }) ?? return Err(^err)
    if jet_numeric_fixed_from_i128(value, kind) != None -> return Ok(value)
    Err(FieldError.one("expected {type_name}, found out-of-range Int"))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:440
// The Rust include macro expands once here; callers use the functions below.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:451
pub fn decode_int_with<T>(t: DataTree, from_i64: fn(Int) -> T Err!, parse_exact: fn(String) -> T Err!) -> T [FieldError]! {
    if t == {
        .Int(n) -> {
            value :: from_i64(n) ?? return Err(FieldError.one(err))
            return Ok(^value)
        }
        .Float(f) -> {
            if math.is_finite(f) && math.trunc(f) == f && f >= -9223372036854775808.0 && f < 9223372036854775808.0 {
                value :: from_i64(Int.from_float(f)) ?? return Err(FieldError.one(err))
                return Ok(^value)
            }
            return Err(FieldError.one("expected Int, found {datatree_kind_for(t)}"))
        }
        .Number(text) -> {
            integer :: json_exact_integer_text(text) ?? return Err(FieldError.one(err))
            value :: parse_exact(integer) ?? return Err(FieldError.one("expected Int, found number {text}"))
            return Ok(^value)
        }
        .TypedText(text) -> return Err(FieldError.one("expected Int, found text {jet_debug_string(text)}"))
        .Text(text) -> {
            trimmed := text.trim() // #4303
            value :: parse_exact(trimmed) ?? return Err(FieldError.one("expected Int, found text {jet_debug_string(text)}"))
            return Ok(^value)
        }
        else -> return Err(FieldError.one("expected Int, found {datatree_kind_for(t)}"))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:487
pub fn decode_int(t: DataTree) -> Int [FieldError]! {
    decode_int_with<Int>(t, (n: Int) -> Int Err! { Ok(n) }, (text: String) -> Int Err! {
        n :: Int.parse(text) ?? return Err("invalid Int")
        Ok(n)
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:490
pub fn decode_float(t: DataTree) -> Float [FieldError]! {
    if t == {
        .Float(f) -> return Ok(f)
        .Int(n) -> {
            value :: Float.from_int(n)
            if math.is_finite(value) -> return Ok(value)
            return Err(FieldError.one("expected float, got out-of-range Int"))
        }
        .Number(text), .Text(text) -> {
            trimmed := text.trim() // #4303
            value :: Float.parse(trimmed) ?? return Err(FieldError.one("expected Float, found text {jet_debug_string(text)}"))
            if math.is_finite(value) -> return Ok(value)
            return Err(FieldError.one("expected Float, found out-of-range Float"))
        }
        .TypedText(text) -> return Err(FieldError.one("expected Float, found text {jet_debug_string(text)}"))
        else -> return Err(FieldError.one("expected Float, found {datatree_kind_for(t)}"))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:522
pub fn decode_bool(t: DataTree) -> Bool [FieldError]! {
    if t == {
        .Bool(value) -> return Ok(value)
        .TypedText(text) -> return Err(FieldError.one("expected Bool, found text {jet_debug_string(text)}"))
        .Text(text) -> {
            trimmed := text.trim() // #4303
            if trimmed == "true" -> return Ok(true)
            if trimmed == "false" -> return Ok(false)
            return Err(FieldError.one("expected Bool, found text {jet_debug_string(text)}"))
        }
        else -> return Err(FieldError.one("expected Bool, found {datatree_kind_for(t)}"))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:544
pub fn decode_string(t: DataTree) -> String [FieldError]! {
    if t == {
        .Text(text), .TypedText(text) -> return Ok(~text)
        .Number(text) -> return Err(FieldError.one("expected Text, found number {text}"))
        .Int(n) -> return Ok(n.to_string())
        .Float(f) -> return Ok(jet_debug_float(f))
        .Bool(value) -> return Ok(value.to_string())
        else -> return Err(FieldError.one("expected Text, found {datatree_kind_for(t)}"))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:560
pub fn decode_f32(t: DataTree) -> F32 [FieldError]! {
    value :: if t == {
        .Float(value) -> value
        .Int(value) -> Float.from_int(value)
        .Number(text), .Text(text) -> {
            trimmed := text.trim() // #4303
            Float.parse(trimmed) ?? return Err(FieldError.one("expected F32, found text {jet_debug_string(text)}"))
        }
        .TypedText(text) -> return Err(FieldError.one("expected F32, found text {jet_debug_string(text)}"))
        else -> return Err(FieldError.one("expected F32, found {datatree_kind_for(t)}"))
    }
    if math.is_finite(value) && value >= -340282346638528859811704183484516925440.0 && value <= 340282346638528859811704183484516925440.0 -> return Ok(F32.from_float(value))
    Err(FieldError.one("expected F32, found out-of-range Float"))
}
