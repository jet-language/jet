// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/EncodingTypes.rs:119
pub fn jet_enc_csv_decode_rows<T, V, E>(rows: [[String]], decode: fn(V) -> T [E]!,
    frame_errors: fn(String, ^[E]) -> [E] Never!, make_text: fn(String) -> V Never!,
    make_object: fn(^[(String, V)]) -> V Never!) -> [T] [E]! {
    if rows.len() == 0 -> return Ok([])
    header :: rows[0]
    values := [T]{}
    errors := [E]{}
    loop index in 1..<rows.len() {
        row :: rows[index]
        object := [(String, V)]{}
        loop col in 0..<header.len() {
            cell := ""
            if col < row.len() -> cell = ~row[col]
            &object.push((~header[col], make_text(^cell)))
        }
        value :: decode(make_object(^object)) ?? {
            framed :: frame_errors("row {index}", ^err)
            loop error in ^framed -> &errors.push(^error)
            next
        }
        &values.push(^value)
    }
    if errors.len() == 0 -> return Ok(^values)
    Err(^errors)
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/JSONDataTree.rs:2
pub fn io_error_at(operation: IOOperation, path: String, e: native_io.Error) -> IOError Never! {
    // GATE #4494 native OS error snapshot; #4409 preserves this source's
    // explicit InvalidData -> InvalidInput projection, not a generic collapse.
    context :: IOContext.new(operation, Val(~path), e.raw_os_error(), Val(e.to_string()))
    if e.kind() == {
        .InvalidInput, .InvalidData -> .InvalidInput(context)
        .NotFound -> .NotFound(context)
        .PermissionDenied -> .PermissionDenied(context)
        .TimedOut -> .TimedOut(context)
        .WouldBlock -> .Other(context)
        .NotConnected, .BrokenPipe -> .Closed(context)
        else -> .Other(context)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/JSONDataTree.rs:27
pub fn render_datatree_json(t: DataTree, pretty: Bool, depth: Int) -> String Never! {
    if t == {
        .Null -> return "null"
        .Bool(b) -> return b.to_string()
        .Int(n) -> return n.to_string()
        .Float(f) -> {
            assert(math.is_finite(f), "JSON cannot encode a non-finite Float")
            return jet_debug_float(f)
        }
        .Number(text) -> return ~text
        .TypedText(text), .Text(text) -> return shared_json.quote_json(text)
        .Bytes(bs) -> {
            parts := [String]{}
            loop b in bs -> &parts.push(b.to_string())
            return "[{parts.join(",")}]"
        }
        .Array(items) -> {
            if items.len() == 0 -> return "[]"
            parts := [String]{}
            if !pretty {
                loop item in items -> &parts.push(render_datatree_json(item, false, depth))
                return "[{parts.join(",")}]"
            }
            pad :: "  ".repeat(depth + 1)
            end :: "  ".repeat(depth)
            loop item in items -> &parts.push("{pad}{render_datatree_json(item, true, depth + 1)}")
            return "[\n{parts.join(",\n")}\n{end}]"
        }
        .Object(entries) -> {
            if entries.len() == 0 -> return "{{}}"
            pad :: "  ".repeat(depth + 1)
            end :: "  ".repeat(depth)
            parts := [String]{}
            if !pretty {
                loop entry in entries -> &parts.push("{shared_json.quote_json(entry.0)}:{render_datatree_json(entry.1, false, depth)}")
                return "{{{parts.join(",")}}}"
            }
            loop entry in entries -> &parts.push("{pad}{shared_json.quote_json(entry.0)}: {render_datatree_json(entry.1, true, depth + 1)}")
            return "{{\n{parts.join(",\n")}\n{end}}}"
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/JSONDataTree.rs:100
pub fn parse_json_datatree(text: String) -> DataTree EncodingError! {
    value :: shared_json.parse_json(text, true) ?? return Err(json_error_from_datatree(err))
    Ok(^value)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/JSONDataTree.rs:107
pub fn parse_json_typed_datatree(text: String) -> DataTree EncodingError! {
    value :: shared_json.parse_json_typed(text, true) ?? return Err(json_error_from_datatree(err))
    Ok(^value)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/JSONDataTree.rs:112
fn json_error_from_datatree(error: shared_json.Error) -> EncodingError Never! {
    EncodingError.new(.JSON, .Syntax, 0, Val(error.line), None, "", error.message)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/JSONDataTree.rs:125
pub fn datatree_get(t: DataTree, key: String) -> DataTree? Never! { t.get_opt(key) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/JSONDataTree.rs:140
pub fn jet_std_json_coerce_line(path: String, from: String, to: String) -> String Never! {
    field_label := path
    if path.is_empty() -> field_label = "<root>"
    msg :: "json coerce: field \"{field_label}\" {from} → {to}"
    // GATE #4494 real system clock; preserve pre-epoch default and i64 cast.
    elapsed :: SystemTime.now().duration_since(UNIX_EPOCH) ?? Default.default()
    ts :: I64.from_int_wrapping(elapsed.as_millis())
    "{{\"level\":\"info\",\"body\":\"{msg}\",\"ts\":{ts}}}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/JSONDataTree.rs:155
pub fn jet_std_json_coerce_walk(value: DataTree, path: String, emit: fn(String)) -> DataTree Never! {
    if value == {
        .Text(s), .TypedText(s) -> {
            if s == "true" {
                emit(jet_std_json_coerce_line(path, "string", "boolean"))
                return .Bool(true)
            }
            if s == "false" {
                emit(jet_std_json_coerce_line(path, "string", "boolean"))
                return .Bool(false)
            }
            if Float.parse(s) == .Val(n) {
                if math.is_finite(n) {
                    emit(jet_std_json_coerce_line(path, "string", "number"))
                    return .Float(n)
                }
            }
            return ~value
        }
        .Object(entries) -> {
            out := [(String, DataTree)]{}
            loop entry in entries {
                child_path := ~entry.0
                if !path.is_empty() -> child_path = "{path}.{entry.0}"
                &out.push((~entry.0, jet_std_json_coerce_walk(entry.1, child_path, emit)))
            }
            return .Object(^out)
        }
        .Array(items) -> {
            out := [DataTree]{}
            loop index in 0..<items.len() {
                child_path :: "{path}[{index}]"
                &out.push(jet_std_json_coerce_walk(items[index], child_path, emit))
            }
            return .Array(^out)
        }
        else -> return ~value
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/JSONDataTree.rs:213
pub fn jet_std_json_decode_lenient(text: String, emit: fn(String)) -> DataTree EncodingError! {
    parsed :: parse_json_datatree(text) ?? return Err(^err)
    Ok(jet_std_json_coerce_walk(parsed, "", emit))
}

// Rust: crates/jet-foundation/src/DataTree.rs:9
// Ordered entries deliberately retain duplicate keys; lookup selects the first.
#Equatable
pub enum DataTree {
    Null
    Bool(Bool)
    Int(Int)
    Float(Float)
    Number(String)
    TypedText(String)
    Text(String)
    Bytes([U8])
    Array([DataTree])
    Object([(String, DataTree)])
}
impl DataTree {
    // Rust: crates/jet-foundation/src/DataTree.rs:25
    pub fn as_array(self) -> View<DataTree> Err! {
        if self == .Array(values) -> return Ok(values[0..<values.len()])
        Err("expected a DataTree array")
    }
    // Rust: crates/jet-foundation/src/DataTree.rs:32
    pub fn as_object(self) -> View<(String, DataTree)> Err! {
        if self == .Object(values) -> return Ok(values[0..<values.len()])
        Err("expected a DataTree object")
    }
    // Rust: crates/jet-foundation/src/DataTree.rs:39
    pub fn as_str(self) -> String Err! {
        if self == {
            .Text(value), .TypedText(value) -> return Ok(value)
            else -> return Err("expected a DataTree string")
        }
    }
    // Rust: crates/jet-foundation/src/DataTree.rs:46
    pub fn get(self, key: String) -> DataTree Err! {
        value :: self.get_opt(key) ?? return Err("missing key `{key}`")
        Ok(value)
    }
    // Rust: crates/jet-foundation/src/DataTree.rs:51
    pub fn get_opt(self, key: String) -> DataTree? Never! {
        if self == .Object(values) -> loop pair in values -> if pair.0 == key -> return Val(pair.1)
        None
    }
    // Rust: crates/jet-foundation/src/DataTree.rs:60
    pub fn object_entries(self) -> View<(String, DataTree)>? Never! {
        if self == .Object(values) -> return Val(values[0..<values.len()])
        None
    }
}
