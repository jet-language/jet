// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:69
pub fn jet_datatree_encode_i64(value: I64) -> DataTree Never! {
    n :: Int.from_i64(value)
    if n >= -4611686018427387904 && n <= 4611686018427387903 -> return .Int(n)
    .Number(n.to_string())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:80
pub fn jet_datatree_encode_u64(value: U64) -> DataTree Never! {
