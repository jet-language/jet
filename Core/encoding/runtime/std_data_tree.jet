// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:142
pub fn jet_datatree_project(tree: DataTree, projection: ShapeProjection) -> DataTree [FieldError]! {
    project_object :: (value: DataTree) -> DataTree [FieldError]! {
        if value == .Object(entries) {
            projected := [(String, DataTree)]{}
            loop field in projection.fields {
                loop entry in entries {
                    if entry.0 == field.decode_name {
                        &projected.push((~field.name, ~entry.1))
                        break
                    }
                }
            }
            return Ok(.Object(^projected))
        }
        Err(FieldError.one("shape projection needs object values"))
    }
    if tree == {
        .Object(_) -> return project_object(tree)
        .Array(values) -> {
            out := [DataTree]{}
            loop value in values {
                projected :: project_object(value) ?? return Err(^err)
                &out.push(^projected)
            }
            return Ok(.Array(^out))
        }
        else -> return Err(FieldError.one("shape projection needs object values"))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:177
pub fn datatree_kind_for(t: DataTree) -> String Never! {
    tag :: if t == {
        .Null -> "Null"
        .Bool(_) -> "Bool"
        .Int(_) -> "Int"
        .Float(_) -> "Float"
        .Number(_) -> "Number"
        .TypedText(_) -> "Text"
        .Text(_) -> "Text"
        .Bytes(_) -> "Bytes"
        .Array(_) -> "Array"
        .Object(_) -> "Object"
    }
    datatree_kind(tag)
}
