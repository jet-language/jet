use core.encoding.runtime.std_data_tree.DataTree
use jet_encoding_errors as errors
use jet_encoding_json as shared_json

// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:1
// Ordered TOML syntax and assembly onto the shared rich DataTree. Datetimes
// remain text; parsing and rendering retain the reference's exact decisions.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:10
pub MAX_TOML_DEPTH :: 64
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:13
#Equatable
pub enum Value {
    String(String)
    Integer(I64)
    Float(F64)
    Boolean(Bool)
    Datetime(String)
    Array([Value])
    InlineTable([(String, Value)])
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:24
#Equatable
pub enum Item {
    Header(path: [String], array: Bool)
    KeyVal(path: [String], value: Value)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:29
#[Equatable, Error]
pub struct ParseError { pub line: USize, pub message: String }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:35
pub fn parse_to_tree(raw: String) -> DataTree ParseError! {
    p := Parser{chars: raw.chars().collect(), pos: 0, line: 1, current_path_len: 0}
    items := [Item]{}
    loop {
        p.skip_between_statements()
        if p.peek() == None -> break
        if p.statement()? is Val(item) {
            if item is .Header(path, _) -> p.current_path_len = path.len()
            items.push(^item)
        }
    }
    Ok(assemble(^items))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:59
fn assemble(items: ^[Item]) -> DataTree {
    root := DataTree.Object([])
    current := [String]{}
    loop item in items {
        match item {
            .Header(path, array) -> {
                if array { push_array_table(&root, path) }
                else { _ :: table_at(&root, path) }
                current = ^path
            }
            .KeyVal(path, value) -> set_key(&root, current, path, value_to_tree(^value))
        }
    }
    ^root
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:83
// Array-of-tables path segments select their last element.
fn table_at(node: &DataTree, path: View<String>) -> &DataTree from node {
    cursor := node
    loop seg in path -> cursor = child_table_mut(cursor, seg)
    cursor
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:90
fn child_table_mut(node: &DataTree, seg: String) -> &DataTree from node {
    entries := match node { .Object(entries) -> &entries, other -> return other }
    idx :: match entries.iter().position((k, _) -> k == seg) {
        Val(i) -> i
        None -> {
            entries.push((seg.to_string(), DataTree.Object([])))
            entries.len() - 1
        }
    }
    arr_last :: match entries[idx].1 {
        .Array(arr) if !arr.is_empty() -> Val(arr.len() - 1)
        _ -> None
    }
    match arr_last {
        Val(n) -> match &entries[idx].1 { .Array(arr) -> &arr[n], other -> other }
        None -> &entries[idx].1
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:118
fn push_array_table(root: &DataTree, path: View<String>) -> {
    (parent_path, last) :: path.split_at(path.len() - 1)
    parent := table_at(root, parent_path)
    if parent is .Object(entries) {
        idx :: match entries.iter().position((k, _) -> k == last[0]) {
            Val(i) -> i
            None -> {
                entries.push((last[0].clone(), DataTree.Array([])))
                entries.len() - 1
            }
        }
        if &entries[idx].1 is .Array(arr) -> arr.push(DataTree.Object([]))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:135
fn set_key(root: &DataTree, current: View<String>, key_path: View<String>, value: ^DataTree) -> {
    full := current.to_vec()
    full.extend_from_slice(key_path[0..<key_path.len() - 1])
    table := table_at(root, full)
    fk :: key_path[key_path.len() - 1]
    if table is .Object(entries) {
        if entries.iter_mut().find((k, _) -> k == fk) is Val(slot) { slot.1 = ^value }
        else { entries.push((fk.clone(), ^value)) }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:149
fn value_to_tree(v: ^Value) -> DataTree {
    match v {
        .String(s) -> DataTree.Text(^s)
        .Integer(n) -> DataTree.Int(Int.from_i64(n))
        .Float(f) -> DataTree.Float(f)
        .Boolean(b) -> DataTree.Bool(b)
        .Datetime(s) -> DataTree.Text(^s)
        .Array(xs) -> DataTree.Array(xs.into_iter().map(value_to_tree).collect())
        .InlineTable(es) -> DataTree.Object(es.into_iter().map((k, v) -> (^k, value_to_tree(^v))).collect())
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:164
pub fn render(t: DataTree) -> String {
    out := String.new()
    render_table(t, [], &out)
    trimmed := out.trim_end() // #4303 borrowed text view
    trimmed.to_string()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:170
fn is_table(v: DataTree) -> Bool { v is .Object(_) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:173
fn is_array_of_tables(v: DataTree) -> Bool {
    match v { .Array(arr) -> !arr.is_empty() && arr.iter().all(e -> e is .Object(_)), _ -> false }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:178
fn render_table(t: DataTree, path: View<String>, out: &String) -> {
    if t is .Object(entries) {
        loop (k, v) in entries {
            if !is_table(v) && !is_array_of_tables(v) -> out.push_str("{k} = {render_value(v)}\n")
        }
        loop (k, v) in entries {
            if is_table(v) {
                p := path.to_vec()
                p.push(k.clone())
                out.push_str("\n[{p.join(".")}]\n")
                render_table(v, p, out)
            } else if is_array_of_tables(v) {
                p := path.to_vec()
                p.push(k.clone())
                if v is .Array(arr) {
                    loop elem in arr {
                        out.push_str("\n[[{p.join(".")}]]\n")
                        render_table(elem, p, out)
                    }
                }
            }
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs:205
fn render_value(v: DataTree) -> String {
    match v {
        .Null -> "\"\""
        .Bool(b) -> b.to_string()
        .Int(n) -> n.to_string()
        .Float(f) -> format("{:?}", f)
        .Number(_) | .TypedText(_) -> panic("internal JSON carrier escaped typed decode")
        .Text(s) -> shared_json.quote_json(s)
        .Bytes(bs) -> {
            parts :: bs.iter().map(b -> b.to_string()).collect<[String]>()
            "[{parts.join(", ")}]"
        }
        .Array(items) -> {
            parts :: items.iter().map(render_value).collect<[String]>()
            "[{parts.join(", ")}]"
        }
        .Object(entries) -> {
            parts :: entries.iter().map((k, val) -> "{k} = {render_value(val)}").collect<[String]>()
            "{{ {parts.join(", ")} }}"
        }
    }
}
