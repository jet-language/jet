                Err(_) -> { errors.push(FieldError{path: key.clone(), reason: "E2410: missing required field `{key}`"}); None }
            }
        }
    }
    match T.jet_decode(field) {
        Ok(value) -> Val(^value)
        Err(failures) -> { errors.extend(FieldError.under_errors(key, ^failures)); None }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:645
fn jet_decode_enum_candidate(tree: DataTree, wire: String) -> DataTree Never! { tree.field(wire).unwrap_or(.Null) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:651
fn jet_decode_enum_payload<T: __jet_Decode>(tree: DataTree, wire: String) -> T? Never! { T.jet_decode(jet_decode_enum_candidate(tree, wire)).ok() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:660
fn jet_codec_encode<T: __jet_Encode>(_kind: I64, value: T) -> DataTree Never! { value.jet_encode() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:663
fn jet_codec_decode<T: __jet_Decode>(_kind: I64, tree: DataTree) -> T [FieldError]! { T.jet_decode(tree) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:669
fn jet_enc_json_to_string<T: __jet_Encode>(v: T) -> String Never! { render_datatree_json(v.jet_encode(), false, 0) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:672
fn jet_enc_json_to_string_pretty<T: __jet_Encode>(v: T) -> String Never! { render_datatree_json(v.jet_encode(), true, 0) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:676
fn jet_enc_json_to_string_shape<T: __jet_Encode>(value: T, projection: ShapeProjection) -> String [FieldError]! {
    if projection.kind != ShapeProjectionKind.Json -> return Err(FieldError.one("JSON needs a JSON shape projection"))
    projected :: jet_datatree_project(value.jet_encode(), projection)?
    Ok(render_datatree_json(projected, false, 0))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:687
fn jet_enc_json_to_string_shape_pretty<T: __jet_Encode>(value: T, projection: ShapeProjection) -> String [FieldError]! {
    if projection.kind != ShapeProjectionKind.Json -> return Err(FieldError.one("JSON needs a JSON shape projection"))
    projected :: jet_datatree_project(value.jet_encode(), projection)?
    Ok(render_datatree_json(projected, true, 0))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:697
fn jet_enc_json_decode<T: __jet_Decode>(text: String) -> T [FieldError]! {
    tree :: parse_json_typed_datatree(text).map_err(fn(e) -> {
        line :: e.line.unwrap_or(0)
        FieldError.one("invalid JSON (line {line}): {e.reason}")
    })?
    T.jet_decode(tree)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:705
fn jet_data_json_decode<T: __jet_Decode>(text: String) -> [T] [FieldError]! { jet_enc_json_decode<[T]>(text) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:713
fn jet_db_decode<T: __jet_Decode>(entries: View<(String,DataTree)>) -> T [FieldError]! { T.jet_decode(.Object(entries.to_vec())) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:722
fn jet_enc_csv_decode<T: __jet_Decode>(text: String) -> [T] [FieldError]! {
    rows :: jet_ring_csv_parse(text, ",", false, false).map_err(FieldError.one)?
    jet_enc_csv_decode_rows(^rows, fn(tree) -> T.jet_decode(tree),
        fn(row, error) -> FieldError.under_errors(row, ^error), DataTree.Text, DataTree.Object)
}
