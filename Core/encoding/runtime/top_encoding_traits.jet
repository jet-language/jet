// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:231
fn jet_decode_sequence<T>(length: Int, decode: fn(Int) -> T [FieldError]!) -> [T] [FieldError]! {
    out := [T].with_capacity(length)
    errors := [FieldError].new()
    loop index in 0..<length {
        match decode(index) {
            Ok(value) -> out.push(^value)
            Err(error) -> errors.extend(FieldError.under_errors("[{index}]", ^error))
        }
    }
    if errors.is_empty() -> Ok(^out) else -> Err(^errors)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:256
fn jet_decode_inline_range_list<T>(t: DataTree, decode: fn(DataTree) -> T [FieldError]!) -> [T] [FieldError]! {
    match t {
        .Array(items) -> jet_decode_sequence(items.len(), fn(index) -> decode(items[index]))
        _ -> Err(FieldError.one("expected a list, found {datatree_kind_for(t)}"))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:272
fn jet_decode_inline_range_fixed<T, const N: Int>(t: DataTree, decode: fn(DataTree) -> T [FieldError]!) -> [T#N] [FieldError]! {
    values :: jet_decode_inline_range_list(t, decode)?
