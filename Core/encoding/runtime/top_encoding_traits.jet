//RS // ── core.encoding.datatree: checked DataTree projections ─────────────────────
//RS // Keep the carrier access policy in `JetDataTreeAccess`; these thin ABI
//RS // functions only expose that one implementation to generated MIR calls.
//RS fn jet_datatree_field(
//RS     tree: &jet_std::DataTree,
