}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:301
fn jet_decode_inline_range_map<V>(t: DataTree, decode: fn(DataTree) -> V [FieldError]!) -> [String:V] [FieldError]! {
    match t {
        .Object(entries) -> {
            out := [(String,V)].with_capacity(entries.len())
            errors := [FieldError].new()
            loop (key, value) in entries {
                match decode(value) {
                    Ok(value) -> out.push((key.clone(), ^value))
                    Err(error) -> errors.extend(FieldError.under_errors(key, ^error))
                }
            }
            if errors.is_empty() -> Ok(out.into_iter().collect()) else -> Err(^errors)
        }
        _ -> Err(FieldError.one("expected an object, found {datatree_kind_for(t)}"))
    }
}
