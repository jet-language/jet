// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:506
impl<V: __jet_Decode> __jet_Decode for [String:V] {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingTraits.rs:507
    fn jet_decode(t: DataTree) -> Self [FieldError]! {
        match t {
            .Object(entries) -> {
                out := [String:V].new()
                errors := [FieldError].new()
                loop (k,v) in entries {
                    match V.jet_decode(v) {
                        Ok(value) -> { _ :: out.insert(k.clone(), ^value) }
                        Err(error) -> errors.extend(FieldError.under_errors(k, ^error))
                    }
                }
                if not errors.is_empty() -> return Err(^errors)
                Ok(^out)
            }
            other -> Err(FieldError.one("expected an object, found {datatree_kind_for(other)}"))
        }
    }
}
