}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:510
fn jet_enc_cbor_encode(value: &jet_std.DataTree) -> [U8] {
    jet_enc_cbor_to_bytes(value).unwrap_or_else(error -> {
