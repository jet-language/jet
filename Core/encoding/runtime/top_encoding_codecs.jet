// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:367
fn jet_cbor_value_error(path: &String, reason: String) -> jet_std.EncodingError {
    jet_std.EncodingError.new(jet_std.EncodingFormat.CBOR, jet_std.EncodingErrorKind.Unsupported,
        0, Err(JetAbsent), Err(JetAbsent), path, reason)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:382
fn jet_cbor_value_at(value: &jet_std.DataTree, path: &String) -> jet_cbor_kernel.Value jet_std.EncodingError! {
    match value {
        .Null -> jet_cbor_kernel.Value.Null
        .Bool(value) -> jet_cbor_kernel.Value.Bool(value)
        .Int(value) -> jet_cbor_kernel.Value.Int(value)
        .Float(value) -> jet_cbor_kernel.Value.Float(value)
        .Number(text) -> Err(jet_cbor_value_error(path, format("JSON number carrier {text:?} is not a CBOR value")))
        .TypedText(text) -> Err(jet_cbor_value_error(path, format("typed text carrier {text:?} is not a CBOR value")))
        .Text(value) -> jet_cbor_kernel.Value.Text(value.clone())
        .Bytes(value) -> jet_cbor_kernel.Value.Bytes(value.clone())
        .Array(values) -> {
            output := Array.with_capacity(values.len())
            for (index, value) in values.iter().enumerate() {
                child_path :: format("{path}[{index}]")
                output.push(jet_cbor_value_at(value, &child_path)?)
            }
            jet_cbor_kernel.Value.Array(^output)
        }
        .Object(entries) -> {
            output := Array.with_capacity(entries.len())
            for (key, value) in entries {
                child_path :: format("{path}[{key:?}]")
                output.push((key.clone(), jet_cbor_value_at(value, &child_path)?))
            }
            jet_cbor_kernel.Value.Object(^output)
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:420
fn jet_cbor_value(value: &jet_std.DataTree) -> jet_cbor_kernel.Value jet_std.EncodingError! { jet_cbor_value_at(value, "$") }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:426
fn jet_cbor_tree(value: jet_cbor_kernel.Value) -> jet_std.DataTree {
    match value {
        .Null -> jet_std.DataTree.Null
        .Bool(value) -> jet_std.DataTree.Bool(value)
        .Int(value) -> jet_std.DataTree.Int(value)
        .Float(value) -> jet_std.DataTree.Float(value)
        .Text(value) -> jet_std.DataTree.Text(^value)
        .Bytes(value) -> jet_std.DataTree.Bytes(^value)
        .Array(values) -> jet_std.DataTree.Array(values.into_iter().map(jet_cbor_tree).collect())
        .Object(entries) -> jet_std.DataTree.Object(entries.into_iter().map((key, value) -> (key, jet_cbor_tree(value))).collect())
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:446
fn jet_cbor_options(options: &jet_std.CBOROptions) -> jet_cbor_kernel.Options {
    jet_cbor_kernel.Options{max_depth: options.max_depth, max_items: options.max_items,
        max_bytes: options.max_bytes, require_canonical: options.require_canonical}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:455
fn jet_cbor_error(error: jet_cbor_kernel.Error) -> jet_std.EncodingError {
    kind :: match error.kind {
        .Syntax -> jet_std.EncodingErrorKind.Syntax
        .Truncated -> jet_std.EncodingErrorKind.Truncated
        .Unsupported | .TypeMismatch | .NonCanonical -> jet_std.EncodingErrorKind.Unsupported
        .Limit -> jet_std.EncodingErrorKind.Limit
        .TrailingData -> jet_std.EncodingErrorKind.Syntax
    }
    jet_std.EncodingError.new(jet_std.EncodingFormat.CBOR, kind, I64{error.byte_offset},
        Err(JetAbsent), Err(JetAbsent), error.path, error.reason)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:484
fn jet_cbor_field_error(error: jet_std.EncodingError) -> [jet_std.FieldError] {
    jet_std.FieldError.at(jet_decode_path(&error.path), format("CBOR {:?} at byte {}: {}", error.kind, error.byte_offset, error.reason))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:494
fn jet_enc_cbor_to_bytes<T: __jet_Encode>(value: &T) -> [U8] jet_std.EncodingError! {
    tree :: value.jet_encode()
