fn jet_enc_xml_decode<T: __jet_Decode>(text: &String, options: jet_std.XMLParseOptions) -> T [jet_std.FieldError]! {
    document :: jet_std_xml_parse_with(text, &options).map_err(jet_xml_decode_value_error)?
