}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:502
fn jet_enc_cbor_to_bytes_canonical<T: __jet_Encode>(value: &T) -> [U8] jet_std.EncodingError! {
    tree :: value.jet_encode()
