// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:551
fn jet_uuid_format(b: &[U8; 16]) -> String {
    format("{:02x}{:02x}{:02x}{:02x}-{:02x}{:02x}-{:02x}{:02x}-{:02x}{:02x}-{:02x}{:02x}{:02x}{:02x}{:02x}{:02x}",
        b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15])
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:576
fn jet_uuid_bytes(s: &String) -> [U8; 16] Err! {
    hex :: s.chars().filter(c -> c != '-').collect<String>()
    if hex.len() != 32 or not hex.chars().all(c -> c.is_ascii_hexdigit()) {
        return Err(format("`{s}` is not a UUID (want 8-4-4-4-12 hex digits)"))
    }
    groups :: s.match_indices('-').map((i, _) -> i).collect<[Int]>()
    if groups != [8, 13, 18, 23] {
        return Err(format("`{s}` is not a UUID (want 8-4-4-4-12 hex digits)"))
    }
    bytes := [U8{0}; 16]
    for i in 0..16 {
        bytes[i] = U8.from_str_radix(&hex[i * 2..i * 2 + 2], 16).map_err(_ ->
            format("`{s}` is not a UUID (want 8-4-4-4-12 hex digits)"))?
    }
    bytes
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:596
fn jet_std_uuid_parse(s: &String) -> String Err! { jet_uuid_bytes(s).map(bytes -> jet_uuid_format(&bytes)) }
// RFC 4122 local SHA-1, used only by UUID v5.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:604
fn jet_uuid_sha1(data: &[U8]) -> [U8; 20] {
    h := [U32{0x67452301}, U32{0xEFCDAB89}, U32{0x98BADCFE}, U32{0x10325476}, U32{0xC3D2E1F0}]
    bit_len :: U64{data.len()} * U64{8}
    msg := data.to_vec()
    msg.push(U8{0x80})
    while msg.len() % 64 != 56 { msg.push(U8{0}) }
    msg.extend_from_slice(&bit_len.to_be_bytes())
    for chunk in msg.chunks_exact(64) {
        w := [U32{0}; 80]
        for i in 0..16 {
            w[i] = U32.from_be_bytes([chunk[i * 4], chunk[i * 4 + 1], chunk[i * 4 + 2], chunk[i * 4 + 3]])
        }
        for i in 16..80 { w[i] = (w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16]).rotate_left(1) }
        a := h[0]
        b := h[1]
        c := h[2]
        d := h[3]
        e := h[4]
        for (i, word) in w.iter().enumerate() {
            (f, k) :: match i {
                0..=19 -> ((b & c) | ((!b) & d), U32{0x5A827999})
                20..=39 -> (b ^ c ^ d, U32{0x6ED9EBA1})
                40..=59 -> ((b & c) | (b & d) | (c & d), U32{0x8F1BBCDC})
                _ -> (b ^ c ^ d, U32{0xCA62C1D6})
            }
            temp :: a.rotate_left(5).wrapping_add(f).wrapping_add(e).wrapping_add(k).wrapping_add(word)
            e = d
            d = c
            c = b.rotate_left(30)
            b = a
            a = temp
        }
        h[0] = h[0].wrapping_add(a)
        h[1] = h[1].wrapping_add(b)
        h[2] = h[2].wrapping_add(c)
        h[3] = h[3].wrapping_add(d)
        h[4] = h[4].wrapping_add(e)
    }
    out := [U8{0}; 20]
    for (i, word) in h.iter().enumerate() { out[i * 4..i * 4 + 4].copy_from_slice(&word.to_be_bytes()) }
    out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:661
fn jet_std_uuid_v5(namespace: &String, name: &String) -> String Err! {
    ns :: jet_uuid_bytes(namespace)?
    input := ns.to_vec()
    input.extend_from_slice(name.as_bytes())
    digest :: jet_uuid_sha1(&input)
    bytes := [U8{0}; 16]
    bytes.copy_from_slice(&digest[..16])
    bytes[6] = (bytes[6] & U8{0x0f}) | U8{0x50}
    bytes[8] = (bytes[8] & U8{0x3f}) | U8{0x80}
    jet_uuid_format(&bytes)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:673
fn jet_std_uuid_v4() -> String { jet_crypto_uuid_v4() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:677
fn jet_std_uuid_v7(clock: &jet_std.Clock) -> String { jet_crypto_uuid_v7(clock.now()) }
