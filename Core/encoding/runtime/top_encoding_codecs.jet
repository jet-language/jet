// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:43
fn jet_std_base32hex_decode(text: &String) -> [U8] Err! {
    STANDARD :: b"ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
    canonical := String.with_capacity(text.len())
    for ch in text.chars() {
        mapped :: match ch {
            '0'..='9' -> STANDARD[Int{U8{ch} - U8{'0'}}]
            'A'..='V' -> STANDARD[Int{U8{ch} - U8{'A'} + U8{10}}]
            '=' -> U8{'='}
            _ -> return Err("invalid Base32hex character")
        }
        canonical.push(Char{mapped})
    }
    jet_std_base32_decode(&canonical)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:58
fn jet_std_base32_decode_opts(text: &String, allow_whitespace: Bool, allow_missing_padding: Bool, allow_lowercase: Bool) -> [U8] Err! {
    if __JET_PACKAGE_EDITION >= 2027 {
        jet_base_encoding_strict.decode_base32(text, allow_whitespace, allow_missing_padding, allow_lowercase)
    } else { jet_xml_pull.base_encoding_2026.decode_base32(text) }
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:76
fn jet_xml_to_data_tree(value: jet_xml_pull.Value) -> jet_std.DataTree {
    match value {
        .Null -> jet_std.DataTree.Null
        .Bool(value) -> jet_std.DataTree.Bool(value)
        .Int(value) -> jet_std.DataTree.Int(value)
        .Text(value) -> jet_std.DataTree.Text(^value)
        .Array(values) -> jet_std.DataTree.Array(values.into_iter().map(jet_xml_to_data_tree).collect())
        .Object(entries) -> jet_std.DataTree.Object(entries.into_iter().map((key, value) -> (key, jet_xml_to_data_tree(value))).collect())
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:94
fn jet_xml_from_data_tree(value: &jet_std.DataTree) -> jet_xml_pull.Value Err! {
    match value {
        .Null -> jet_xml_pull.Value.Null
        .Bool(value) -> jet_xml_pull.Value.Bool(value)
        .Int(value) -> jet_xml_pull.Value.Int(value)
        .Number(_) | .TypedText(_) -> Err("internal JSON carrier escaped typed decode")
        .Text(value) -> jet_xml_pull.Value.Text(value.clone())
        .Array(values) -> {
            output := []
            for value in values { output.push(jet_xml_from_data_tree(value)?) }
            jet_xml_pull.Value.Array(^output)
        }
        .Object(entries) -> {
            output := []
            for (key, value) in entries { output.push((key.clone(), jet_xml_from_data_tree(value)?)) }
            jet_xml_pull.Value.Object(^output)
        }
        .Float(_) | .Bytes(_) -> Err("XML tree cannot contain Float or Bytes values")
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:121
fn jet_xml_reason(reason: jet_xml_pull.Reason) -> jet_std.XMLReason {
    match reason {
        .InvalidEncoding -> jet_std.XMLReason.InvalidEncoding
        .Malformed -> jet_std.XMLReason.Malformed
        .MismatchedTag -> jet_std.XMLReason.MismatchedTag
        .InvalidName -> jet_std.XMLReason.InvalidName
        .Namespace -> jet_std.XMLReason.Namespace
        .DuplicateAttribute -> jet_std.XMLReason.DuplicateAttribute
        .Entity -> jet_std.XMLReason.Entity
        .EntityCycle -> jet_std.XMLReason.EntityCycle
        .Limit -> jet_std.XMLReason.Limit
        .Canonicalization -> jet_std.XMLReason.Canonicalization
        .Shape -> jet_std.XMLReason.Shape
        .Unsupported -> jet_std.XMLReason.Unsupported
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:139
fn jet_xml_error(error: jet_xml_pull.Error) -> jet_std.XMLError {
    jet_std.XMLError{kind: jet_xml_reason(error.kind), byte_offset: jet_outcome_of(Val(I64{error.offset})),
        line: jet_outcome_of(error.line.map(value -> I64{value})),
        column: jet_outcome_of(error.column.map(value -> I64{value})), path: error.path, reason: error.reason}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:150
fn jet_xml_shape_error(reason: String) -> jet_std.XMLError {
    jet_std.XMLError{kind: jet_std.XMLReason.Shape, byte_offset: jet_outcome_of(Val(0)),
        line: Err(JetAbsent), column: Err(JetAbsent), path: "", reason: reason}
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:161
fn jet_xml_options(options: &jet_std.XMLParseOptions) -> jet_xml_pull.ParseOptions {
    number :: (value: I64) -> U64.try_from(value).unwrap_or(usize_max())
    entities :: match options.entities {
        .Preserve -> jet_xml_pull.EntityPolicy.Preserve
        .Reject -> jet_xml_pull.EntityPolicy.Reject
        .Resolve(values) -> jet_xml_pull.EntityPolicy.Resolve(values.clone())
    }
    jet_xml_pull.ParseOptions{entities: entities, limits: jet_xml_pull.Limits{
        max_depth: number(options.limits.max_depth), max_nodes: number(options.limits.max_nodes),
        max_attributes_per_element: number(options.limits.max_attributes_per_element),
        max_name_bytes: number(options.limits.max_name_bytes), max_text_bytes: number(options.limits.max_text_bytes),
        max_entity_declarations: number(options.limits.max_entity_declarations),
        max_entity_depth: number(options.limits.max_entity_depth),
        max_entity_replacement_bytes: number(options.limits.max_entity_replacement_bytes)}}
}
