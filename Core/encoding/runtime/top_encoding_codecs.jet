fn jet_enc_xml_decode_bytes<T: __jet_Decode>(bytes: &[U8], options: jet_std.XMLParseOptions) -> T [jet_std.FieldError]! {
    document :: jet_std_xml_parse_bytes(bytes, options).map_err(jet_xml_decode_value_error)?
