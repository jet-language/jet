// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:538
fn jet_cbor_decode_source_error(error: jet_std.EncodingError) -> [jet_std.FieldError] { jet_cbor_field_error(error) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:542
fn jet_enc_cbor_decode<T: __jet_Decode>(bytes: &[U8], options: jet_std.CBOROptions) -> T [jet_std.FieldError]! {
