// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:297
fn jet_decode_path(path: &String) -> String {
    if path == "$" -> return ""
    if path.strip_prefix("$.") is Val(stripped) -> return stripped.to_string()
    path.strip_prefix('$').unwrap_or(path).to_string()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs:307
fn jet_xml_field_error(error: jet_std.XMLError) -> [jet_std.FieldError] {
    location := format(" at byte {}", error.byte_offset.as_ref().ok().copied().unwrap_or(0))
    match (error.line.as_ref().ok().copied(), error.column.as_ref().ok().copied()) {
        (Val(line), Val(column)) -> location.push_str(format(" (line {line}, column {column})"))
        (Val(line), None) -> location.push_str(format(" (line {line})"))
        (None, Val(column)) -> location.push_str(format(" (column {column})"))
        (None, None) -> {}
    }
    jet_std.FieldError.at(jet_decode_path(&error.path), format("XML {:?}{location}: {}", error.kind, error.reason))
}
