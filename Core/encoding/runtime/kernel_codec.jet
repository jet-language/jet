use jet_std.[JetDecimal]

// D-SERDE2 / R12: one canonical temporal and Decimal wire meaning.
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:6
fn jet_codec_is_leap(year: I64) -> Bool { (year % 4 == 0 && year % 100 != 0) || year % 400 == 0 }
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:10
fn jet_codec_days_in_month(year: I64, month: I64) -> I64 {
    match month {
        1 | 3 | 5 | 7 | 8 | 10 | 12 -> 31,
        4 | 6 | 9 | 11 -> 30,
        2 if jet_codec_is_leap(year) -> 29,
        2 -> 28,
        _ -> 30,
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:20
fn jet_codec_date_day_number(year: I64, month: I64, day: I64) -> I64 {
    prior_year :: year - 1
    365 * prior_year + prior_year / 4 - prior_year / 100 + prior_year / 400
        + [I64{0}, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334][(month - 1) as USize]
        + (if month > 2 && jet_codec_is_leap(year) { 1 } else { 0 }) + day - 1
}
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:32
fn jet_codec_date_from_day_number(day_number: I64) -> (I64, I64, I64) {
    year := day_number / 365 + 1
    loop {
        start :: jet_codec_date_day_number(year, 1, 1)
        next :: jet_codec_date_day_number(year + 1, 1, 1)
        if day_number >= start && day_number < next -> break
        if day_number < start { year -= 1 } else { year += 1 }
    }
    day_number -= jet_codec_date_day_number(year, 1, 1)
    month := I64{1}
    while month < 12 && day_number >= jet_codec_days_in_month(year, month) {
        day_number -= jet_codec_days_in_month(year, month)
        month += 1
    }
    (year, month, day_number + 1)
}
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:55
fn jet_codec_date_components(year: I64, month: I64, day: I64) -> (I64, I64, I64) {
    clamped_month :: month.clamp(1, 12)
    (year, clamped_month, day.clamp(1, jet_codec_days_in_month(year, clamped_month)))
}
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:60
pub fn jet_codec_date_encode(year: I64, month: I64, day: I64) -> String {
    (y, m, d) :: jet_codec_date_components(year, month, day)
    format!("{y:04}-{m:02}-{d:02}")
}
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:65
pub fn jet_codec_date_decode(value: String) -> (I64, I64, I64) Err! {
    parts :: value.splitn(3, '-').collect<[View<Char>]>()
    if parts.len() != 3 -> return Err(format!("invalid date: {value}"))
    year :: parts[0].parse<I64>().map_err(fn(_) { format!("bad year: {}", parts[0]) })?
    month :: parts[1].parse<I64>().map_err(fn(_) { format!("bad month: {}", parts[1]) })?
    day :: parts[2].parse<I64>().map_err(fn(_) { format!("bad day: {}", parts[2]) })?
    if month < 1 || month > 12 || day < 1 || day > jet_codec_days_in_month(year, month) {
        return Err(format!("date out of range: {value}"))
    }
    Ok((year, month, day))
}
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:85
pub fn jet_codec_local_time_encode(hour: I64, minute: I64, second: I64) -> String {
    h :: hour.clamp(0, 23); m :: minute.clamp(0, 59); s :: second.clamp(0, 59)
    format!("{h:02}:{m:02}:{s:02}")
}
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:91
fn jet_codec_datetime_time_encode(hour: I64, minute: I64, second: I64) -> String {
    h :: hour.clamp(0, 23); m :: minute.clamp(0, 59); s :: second.clamp(0, 60)
    format!("{h:02}:{m:02}:{s:02}")
}
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:99
fn jet_codec_local_time_decode_parts(value: String, allow_leap: Bool) -> (I64, I64, I64, Bool) Err! {
    parts :: value.splitn(3, ':').collect<[View<Char>]>()
    if parts.len() != 3 -> return Err(format!("invalid time: {value}"))
    hour :: parts[0].parse<I64>().map_err(fn(_) { format!("bad hour: {}", parts[0]) })?
    minute :: parts[1].parse<I64>().map_err(fn(_) { format!("bad minute: {}", parts[1]) })?
    second :: parts[2].parse<I64>().map_err(fn(_) { format!("bad second: {}", parts[2]) })?
    leap_second :: second == 60
    if hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0
        || second > (if allow_leap { 60 } else { 59 })
        || (leap_second && (hour != 23 || minute != 59)) {
        return Err(format!("time out of range: {value}"))
    }
    Ok((hour, minute, if leap_second { 59 } else { second }, leap_second))
}
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:130
pub fn jet_codec_local_time_decode(value: String) -> (I64, I64, I64) Err! {
    (hour, minute, second, _) :: jet_codec_local_time_decode_parts(value, false)?
    Ok((hour, minute, second))
}
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:135
pub fn jet_codec_datetime_encode(secs: I64, nanos: U32, leap_second: Bool) -> String {
    seconds :: secs.saturating_add((nanos / 1000000000) as I64)
    fraction :: nanos % 1000000000
    epoch :: jet_codec_date_day_number(1970, 1, 1)
    (year, month, day) :: jet_codec_date_from_day_number(epoch + seconds.div_euclid(86400))
    day_seconds :: seconds.rem_euclid(86400)
    date :: jet_codec_date_encode(year, month, day)
    time :: jet_codec_datetime_time_encode(day_seconds / 3600, (day_seconds / 60) % 60,
        day_seconds % 60 + if leap_second { I64{1} } else { I64{0} })
    if fraction == 0 { format!("{date}T{time}Z") } else { format!("{date}T{time}.{fraction:09}Z") }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:154
pub fn jet_codec_datetime_decode(value: String) -> (I64, U32, Bool) Err! {
    (date_part, rest) := value.split_once('T').ok_or_else(fn() { format!("invalid RFC3339 datetime: {value}") })?
    (year, month, day) :: jet_codec_date_decode(date_part)?
    zone_pos :: rest.find('Z').or_else(fn() { rest.rfind('+') })
        .or_else(fn() { rest.get(1..).and_then(fn(tail) { tail.rfind('-').map(fn(i) { i + 1 }) }) })
        .ok_or_else(fn() { format!("RFC3339 datetime needs Z or an offset: {value}") })?
    (time_part, zone_part) := rest.split_at(zone_pos)
    (clean_time, frac) := match time_part.split_once('.') {
        Val((time, fraction)) -> (time, Val(fraction)),
        None -> (time_part, None),
    }
    (hour, minute, second, leap_second) :: jet_codec_local_time_decode_parts(clean_time, true)?
    nanos := U32{0}
    if frac is Val(fraction) {
        digits :: fraction.chars().take(9).filter(fn(ch) { ch.is_ascii_digit() }).collect<String>()
        if !digits.is_empty() {
            padded :: format!("{digits:0<9}")
            nanos = padded.parse<U32>().unwrap_or(0)
        }
    }
    offset :: if zone_part == "Z" { I64{0} } else {
        sign :: if zone_part.starts_with('-') { I64{-1} } else { I64{1} }
        zone := zone_part[1..]
        (zone_hour, zone_minute) := zone.split_once(':').ok_or_else(fn() { format!("bad RFC3339 offset: {zone_part}") })?
        zh :: zone_hour.parse<I64>().map_err(fn(_) { format!("bad RFC3339 offset hour: {zone_hour}") })?
        zm :: zone_minute.parse<I64>().map_err(fn(_) { format!("bad RFC3339 offset minute: {zone_minute}") })?
        sign * (zh * 3600 + zm * 60)
    }
    if leap_second && offset != 0 -> return Err(format!("time out of range: {clean_time}"))
    epoch :: jet_codec_date_day_number(1970, 1, 1)
    secs :: (jet_codec_date_day_number(year, month, day) - epoch).saturating_mul(86400)
        .saturating_add(hour * 3600 + minute * 60 + second).saturating_sub(offset)
    Ok((secs, nanos, leap_second))
}
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:211
pub fn jet_codec_duration_encode(ns: I64) -> I64 { ns }
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:215
pub fn jet_codec_duration_decode(ns: I64) -> I64 { ns }
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:219
pub fn jet_codec_decimal_encode(value: &JetDecimal) -> String { value.to_string_rep() }
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:223
pub fn jet_codec_decimal_decode_text(value: String) -> JetDecimal Err! { JetDecimal.from_str(value) }
// Rust: crates/jet-codegen/src/Prelude/Core/Codec.rs:229
pub fn jet_codec_decimal_decode_int(value: I64) -> JetDecimal Err! {
    // One exact decimal text constructor for every tier.
    JetDecimal.from_str(&value.to_string())
}

