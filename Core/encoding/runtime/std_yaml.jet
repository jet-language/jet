struct YamlBudget { nodes: USize, bytes: USize }
impl YamlBudget {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:29
    fn node(self: &Self, payload: USize) -> () Err! {
        nodes :: self.nodes.checked_add(1) ?? return Err("YAML budget")
        cost :: YAML_NODE_OVERHEAD.checked_add(payload) ?? return Err("YAML budget")
        bytes :: self.bytes.checked_add(cost) ?? return Err("YAML budget")
