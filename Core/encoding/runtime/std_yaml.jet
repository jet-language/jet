}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:61
fn yaml_scalar(s: String, budget: &YamlBudget) -> DataTree Err! {
    value :: scalar_value(s)
    payload :: match value {
        .Number(text), .TypedText(text), .Text(text) -> text.len()
        .Bytes(bytes) -> bytes.len()
        _ -> 0
    }
    budget.node(payload)?
    Ok(^value)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:74
fn yaml_clone(value: &DataTree, budget: &YamlBudget) -> DataTree Err! {
    match value {
        .Null, .Bool(_), .Int(_), .Float(_) -> budget.node(0)?
        .Number(text), .TypedText(text), .Text(text) -> budget.node(text.len())?
        .Bytes(bytes) -> budget.node(bytes.len())?
        .Array(items) -> {
            budget.node(0)?
            loop item in items -> _ :: yaml_clone(&item, budget)?
        }
        .Object(entries) -> {
            budget.node(0)?
            loop (key, item) in entries {
                budget.bytes(key.len())?
                _ :: yaml_clone(&item, budget)?
            }
        }
    }
    Ok(value.clone())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:102
fn yaml_flow_message(error: FlowError) -> String {
    match error {
        .Depth -> "YAML value is nested too deeply"
        .Budget -> "YAML value exceeds its node or byte budget"
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:109
pub fn parse_to_tree(raw: String) -> DataTree ParseError! {
    line_count :: raw.as_bytes().iter().filter(byte -> byte == (U8{10})).count().checked_add(1)
    if raw.len() > MAX_YAML_BYTES || !line_count.is_some_and(count -> count <= MAX_YAML_NODES) {
        return Err(ParseError{line: 1, message: "YAML input exceeds its byte or line budget"})
    }
    p := Parser{
        lines: raw.split('\n').map(l -> l.trim_end_matches('\r').to_string()).collect(),
        pos: 0, anchors: [String:DataTree]{}, budget: YamlBudget{nodes: 0, bytes: 0},
    }
    p.skip_ignorable()
    loop p.at_doc_marker() {
        p.pos = p.pos.saturating_add(1)
        p.skip_ignorable()
    }
    if p.pos >= p.lines.len() || p.at_doc_end() -> return p.null()
    base :: p.indent(p.pos)
    value :: p.parse_node(base, 0)?
    p.skip_ignorable()
    if p.pos < p.lines.len() && !p.at_doc_marker() && !p.at_doc_end() {
        return Err(ParseError{line: p.pos.saturating_add(1), message: errors.YAML_EXPECTED_KEY_VALUE})
    }
    Ok(^value)
}
