fn parse_flow(s: String, depth: USize, budget: &YamlBudget) -> (DataTree, USize) FlowError! {
    chars :: s.chars().collect<[Char]>()
    parse_flow_at(chars, 0, depth, budget)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:445
fn parse_flow_at(chars: View<Char>, i: USize, depth: USize, budget: &YamlBudget) -> (DataTree, USize) FlowError! {
    i := i
    loop i < chars.len() && chars[i].is_whitespace() -> i = i.saturating_add(1)
    if i >= chars.len() -> return Ok((yaml_null(budget).map_err(_ -> FlowError.Budget)?, i))
    match chars[i] {
        '[' -> {
            if depth >= MAX_YAML_DEPTH -> return Err(FlowError.Depth)
            i = i.saturating_add(1)
            items := [DataTree]{}
            loop {
                loop i < chars.len() && (chars[i].is_whitespace() || chars[i] == ',') -> i = i.saturating_add(1)
                if i >= chars.len() || chars[i] == ']' {
                    i = i.saturating_add(1)
                    break
                }
                next_depth :: depth.checked_add(1) ?? return Err(FlowError.Depth)
                (v, ni) :: parse_flow_at(chars, i, next_depth, budget)?
                items.push(^v)
                i = ni
                loop i < chars.len() && chars[i].is_whitespace() -> i = i.saturating_add(1)
                if i < chars.len() && chars[i] == ',' { i = i.saturating_add(1) }
                else if i < chars.len() && chars[i] == ']' { i = i.saturating_add(1); break }
            }
            budget.node(0).map_err(_ -> FlowError.Budget)?
            Ok((DataTree.Array(^items), i))
        }
        '{' -> {
            if depth >= MAX_YAML_DEPTH -> return Err(FlowError.Depth)
            i = i.saturating_add(1)
            entries := [(String, DataTree)]{}
            loop {
                loop i < chars.len() && (chars[i].is_whitespace() || chars[i] == ',') -> i = i.saturating_add(1)
                if i >= chars.len() || chars[i] == '}' { i = i.saturating_add(1); break }
                (key, ni) :: scan_flow_scalar(chars, i, true)
                i = ni
                loop i < chars.len() && chars[i].is_whitespace() -> i = i.saturating_add(1)
                if i < chars.len() && chars[i] == ':' -> i = i.saturating_add(1)
                next_depth :: depth.checked_add(1) ?? return Err(FlowError.Depth)
                (v, nj) :: parse_flow_at(chars, i, next_depth, budget)?
                i = nj
                key := key.trim().to_string() // #4303
                budget.bytes(key.len()).map_err(_ -> FlowError.Budget)?
                entries.push((^key, ^v))
                loop i < chars.len() && chars[i].is_whitespace() -> i = i.saturating_add(1)
                if i < chars.len() && chars[i] == ',' { i = i.saturating_add(1) }
                else if i < chars.len() && chars[i] == '}' { i = i.saturating_add(1); break }
            }
            budget.node(0).map_err(_ -> FlowError.Budget)?
            Ok((DataTree.Object(^entries), i))
        }
        _ -> {
            (raw, ni) :: scan_flow_scalar(chars, i, false)
            trimmed := raw.trim() // #4303
            Ok((yaml_scalar(trimmed, budget).map_err(_ -> FlowError.Budget)?, ni))
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:540
fn scan_flow_scalar(chars: View<Char>, i: USize, as_key: Bool) -> (String, USize) {
    i := i
    loop i < chars.len() && chars[i].is_whitespace() -> i = i.saturating_add(1)
    if i < chars.len() && (chars[i] == '"' || chars[i] == '\'') {
        q :: chars[i]
        out := String.new()
        i = i.saturating_add(1)
        loop i < chars.len() {
            if chars[i] == q {
                if q == '\'' && i.checked_add(1).is_some_and(n -> n < chars.len() && chars[n] == '\'') {
                    out.push('\'')
                    i = i.saturating_add(2)
                    next
                }
                i = i.saturating_add(1)
                break
            }
            if chars[i] == '\\' && q == '"' {
                if i.checked_add(1).filter(n -> n < chars.len()) is Val(n) {
                    out.push(unescape(chars[n]))
                    i = i.saturating_add(2)
                    next
                }
            }
            out.push(chars[i])
            i = i.saturating_add(1)
        }
        return (^out, i)
    }
    out := String.new()
    loop i < chars.len() {
        c :: chars[i]
        if c == ',' || c == ']' || c == '}' || (as_key && c == ':') -> break
        out.push(c)
        i = i.saturating_add(1)
    }
    (^out, i)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:589
fn fold_lines(lines: View<String>) -> String {
    out := String.new()
    prev_blank := true
    loop l in lines {
        if l.trim().is_empty() {
            out.push('\n')
            prev_blank = true
        } else {
            if !prev_blank -> out.push(' ')
            out.push_str(l)
            prev_blank = false
        }
    }
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:609
fn unescape(c: Char) -> Char {
    match c {
        'n' -> '\n', 't' -> '\t', 'r' -> '\r', '0' -> TEXT_NUL.chars().next().unwrap(),
        '\\' -> '\\', '"' -> '"', _ -> c,
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:622
fn strip_comment(s: String) -> String {
    chars :: s.chars().collect<[Char]>()
    in_s := false
    in_d := false
    i := USize{0}
    loop i < chars.len() {
        c :: chars[i]
        match c {
            '\'' if !in_d -> in_s = !in_s
            '"' if !in_s -> in_d = !in_d
            '#' if !in_s && !in_d && (i == 0 || chars[i - 1] == ' ' || chars[i - 1] == '\t') -> {
                kept :: chars[..i].iter().collect<String>()
                return kept.trim_end().to_string()
            }
            _ -> {}
        }
        i = i.saturating_add(1)
    }
    s.trim_end().to_string()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:647
fn is_map_entry(s: String) -> Bool { top_level_colon(s).is_some() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:650
fn top_level_colon(s: String) -> USize? {
    chars :: s.chars().collect<[Char]>()
    in_s := false
    in_d := false
    depth := I32{0}
    i := USize{0}
    loop i < chars.len() {
        c :: chars[i]
        match c {
            '\'' if !in_d -> in_s = !in_s
            '"' if !in_s -> in_d = !in_d
            '[', '{' if !in_s && !in_d -> depth = depth.saturating_add(1)
            ']', '}' if !in_s && !in_d -> depth = depth.saturating_sub(1)
            ':' if !in_s && !in_d && depth == 0 -> {
                if i.checked_add(1).is_none_or(n -> n >= chars.len() || chars[n] == ' ') -> return Val(i)
            }
            _ -> {}
        }
        i = i.saturating_add(1)
    }
    None
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:678
fn split_key(s: String) -> (String, String)? {
    idx :: top_level_colon(s)?
    chars :: s.chars().collect<[Char]>()
    key_raw :: chars[..idx].iter().collect<String>()
    rest_start :: idx.checked_add(1)?
    rest :: chars[rest_start..].iter().collect<String>()
    trimmed := key_raw.trim() // #4303
    Val((unquote_key(trimmed), ^rest))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:686
fn unquote_key(k: String) -> String {
    if ((k.starts_with('"') && k.ends_with('"')) || (k.starts_with('\'') && k.ends_with('\''))) && k.len() >= 2 {
        k[1..<k.len() - 1].to_string()
    } else { k.to_string() }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:697
fn scalar_value(s: String) -> DataTree {
    s := s.trim() // #4303
    if s.is_empty() -> return DataTree.Null
    if s.starts_with('"') && s.ends_with('"') && s.len() >= 2 {
        inner := s[1..<s.len() - 1] // #4303
        out := String.new()
        chars := inner.chars()
        loop chars.next() is Val(c) {
            if c == '\\' {
                if chars.next() is Val(n) -> out.push(unescape(n))
            } else { out.push(c) }
        }
        return DataTree.Text(^out)
    }
    if s.starts_with('\'') && s.ends_with('\'') && s.len() >= 2 {
        return DataTree.Text(s[1..<s.len() - 1].replace("''", "'"))
    }
    match s {
        "null", "Null", "NULL", "~" -> return DataTree.Null
        "true", "True", "TRUE" -> return DataTree.Bool(true)
        "false", "False", "FALSE" -> return DataTree.Bool(false)
        ".inf", ".Inf", ".INF" -> return DataTree.Float(F64.INFINITY)
        "-.inf", "-.Inf" -> return DataTree.Float(F64.NEG_INFINITY)
        ".nan", ".NaN", ".NAN" -> return DataTree.Float(F64.NAN)
        _ -> {}
    }
    if s.parse<I64>() is Ok(n) -> return DataTree.Int(n)
    if (s.contains('.') || s.contains('e') || s.contains('E')) && s.chars().all(c -> c.is_ascii_digit() || c == '.' || c == 'e' || c == 'E' || c == '+' || c == '-') {
        if s.parse<F64>() is Ok(f) -> return DataTree.Float(f)
    }
    DataTree.Text(s.to_string())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:747
pub fn render(t: &DataTree) -> String {
    out := String.new()
    render_node(t, 0, &out)
    s :: out.trim_end().to_string()
    if s.is_empty() { "{}" } else { ^s }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:757
fn render_node(t: &DataTree, indent: USize, out: &String) -> {
    pad :: " ".repeat(indent)
    match t {
        .Object(entries) -> {
            if entries.is_empty() { out.push_str("{pad}{{}}\n"); return }
            loop (k, v) in entries {
                match v {
                    .Object(e) if !e.is_empty() -> {
                        out.push_str("{pad}{render_key(k)}:\n")
                        render_node(&v, indent + 2, out)
                    }
                    .Array(a) if !a.is_empty() -> {
                        out.push_str("{pad}{render_key(k)}:\n")
                        render_seq(a, indent, out)
                    }
                    _ -> out.push_str("{pad}{render_key(k)}: {render_scalar(&v)}\n")
                }
            }
        }
        .Array(items) -> render_seq(items, indent, out)
        _ -> out.push_str("{pad}{render_scalar(t)}\n")
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:790
fn render_seq(items: View<DataTree>, indent: USize, out: &String) -> {
    pad :: " ".repeat(indent)
    loop item in items {
        match item {
            .Object(e) if !e.is_empty() -> {
                out.push_str("{pad}-\n")
                render_node(&item, indent + 2, out)
            }
            .Array(a) if !a.is_empty() -> {
                out.push_str("{pad}-\n")
                render_seq(a, indent + 2, out)
            }
            _ -> out.push_str("{pad}- {render_scalar(&item)}\n")
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:806
fn render_key(k: String) -> String {
    if k.is_empty() || k.contains(':') || k.contains(' ') || k.contains('#') { escape_debug(k) }
    else { k.to_string() }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:813
fn render_scalar(v: &DataTree) -> String {
    match v {
        .Null -> "null"
        .Bool(b) -> b.to_string()
        .Int(n) -> n.to_string()
        .Float(f) -> "{f:?}"
        .Number(_), .TypedText(_) -> panic("internal JSON carrier escaped typed decode")
        .Text(s) -> if needs_quote(s) { escape_debug(s) } else { s.clone() }
        .Bytes(bs) -> "[{bs.iter().map(b -> b.to_string()).collect<[String]>().join(", ")}]"
        .Array(items) -> "[{items.iter().map(item -> render_scalar(&item)).collect<[String]>().join(", ")}]"
        .Object(entries) -> {
            parts :: entries.iter().map((k, val) -> "{render_key(k)}: {render_scalar(&val)}").collect<[String]>()
            "{{{parts.join(", ")}}}"
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs:847
fn needs_quote(s: String) -> Bool {
    if s.is_empty() -> return true
    match s {
        "null", "Null", "NULL", "~", "true", "True", "TRUE", "false", "False", "FALSE" -> return true
        _ -> {}
    }
    s.parse<I64>().is_ok() || s.parse<F64>().is_ok() || s.starts_with(' ') || s.ends_with(' ')
        || s.starts_with(['-', '?', ':', '[', ']', '{', '}', '#', '&', '*', '!', '|', '>', '\'', '"', '%', '@', '`'])
        || s.contains(": ") || s.contains(" #") || s.contains('\n')
}
