fn jet_cbor_half_to_f64(bits: U16) -> Float Never! {
    sign :: ((bits >> 15) as U64) << 63
    exp :: (bits >> 10) & 31
    frac :: bits & 1023
    if exp == 0 {
        if frac == 0 -> return Float.from_bits(sign)
        mant := frac as U64
        exponent := I32{-14}
        while mant & 1024 == 0 { mant <<= 1; exponent -= 1 }
        mant &= 1023
        Float.from_bits(sign | (((exponent + 1023) as U64) << 52) | (mant << 42))
    } else if exp == 31 -> Float.from_bits(sign | (U64{0x7ff} << 52) | ((frac as U64) << 42))
    else -> Float.from_bits(sign | (((exp as I32 - 15 + 1023) as U64) << 52) | ((frac as U64) << 42))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingStream.rs:3696
fn jet_cbor_f32_to_half_bits(value: F32) -> U16 Never! {
    bits :: value.to_bits()
    sign :: ((bits >> 16) & 0x8000) as U16
    exp :: ((bits >> 23) & 255) as I32
    frac :: bits & 0x7fffff
    if exp == 255 -> return sign | 0x7c00 | (if frac == 0 -> 0 else -> 0x0200)
    half_exp :: exp - 127 + 15
    if half_exp >= 31 -> return sign | 0x7c00
    if half_exp <= 0 {
        if half_exp < -10 -> return sign
        mant :: frac | 0x800000
        shift :: (14 - half_exp) as U32
        rounded := mant >> shift
        rem :: mant & ((U32{1} << shift) - 1)
        halfway :: U32{1} << (shift - 1)
        if rem > halfway or (rem == halfway and rounded & 1 != 0) -> rounded += 1
        return sign | rounded as U16
    }
    rounded := frac >> 13
    rem :: frac & 0x1fff
    if rem > 0x1000 or (rem == 0x1000 and rounded & 1 != 0) -> rounded += 1
    if rounded == 0x0400 -> return sign | (((half_exp + 1) as U16) << 10)
    sign | ((half_exp as U16) << 10) | rounded as U16
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingStream.rs:3697
fn jet_cbor_half_exact(value: Float) -> U16? Never! {
    if value.is_nan() -> return Val(0x7e00)
    narrowed :: value as F32
    if (narrowed as Float).to_bits() != value.to_bits() -> return None
    bits :: jet_cbor_f32_to_half_bits(narrowed)
