// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingStream.rs:4121
fn jet_enc_json_canonical_tree(value: DataTree, limits: EncodingLimits, depth: I64) -> [U8] EncodingError! {
    if depth > limits.max_depth -> return Err(jet_encoding_error(.Limit, 0, 1, 1, "max_depth {limits.max_depth} exceeded"))
    match value {
        .Null -> Ok("null".into_bytes())
        .Bool(true) -> Ok("true".into_bytes())
        .Bool(false) -> Ok("false".into_bytes())
        .Int(n) -> {
            if (n as Float) as I128 != n as I128 -> return Err(jet_encoding_error(.Unsupported, 0, 1, 1, "JCS requires Int exactly representable as IEEE 754 binary64; encode this integer as Text"))
            Ok(jet_json_jcs_number(n as Float).into_bytes())
        }
        .Float(f) -> {
            if not f.is_finite() -> return Err(jet_encoding_error(.Unsupported, 0, 1, 1, "JCS cannot encode a non-finite Float"))
            Ok(jet_json_jcs_number(f).into_bytes())
        }
        .Number(_) | .TypedText(_) -> Err(jet_encoding_error(.State, 0, 1, 1, "internal JSON carrier escaped typed decode"))
        .Text(s) -> Ok(jet_json_canonical_quote_text(s))
        .Bytes(_) -> Err(jet_encoding_error(.Unsupported, 0, 1, 1, "JSON cannot encode Bytes; encode bytes as Text explicitly"))
        .Array(items) -> {
            out := [U8]{91}
            loop (index,item) in items.iter().enumerate() {
                if index > 0 -> out.push(44)
                out.extend_from_slice(jet_enc_json_canonical_tree(item, limits, depth + 1)?)
            }
            out.push(93)
            Ok(^out)
        }
        .Object(entries) -> {
            sorted := entries.iter().collect()
            sorted.sort_by(fn(left,right) -> jet_json_jcs_key_cmp(left.0, right.0))
            if sorted.windows(2).any(fn(pair) -> pair[0].0 == pair[1].0) -> return Err(jet_encoding_error(.Syntax, 0, 1, 1, "JCS requires unique object keys"))
            out := [U8]{123}
            loop (index,(key,item)) in sorted.iter().enumerate() {
                if index > 0 -> out.push(44)
                out.extend_from_slice(jet_json_canonical_quote_text(key))
                out.push(58)
                out.extend_from_slice(jet_enc_json_canonical_tree(item, limits, depth + 1)?)
            }
            out.push(125)
            Ok(^out)
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingStream.rs:4218
fn jet_enc_json_canonical(value: DataTree, limits: EncodingLimits) -> String EncodingError! {
    jet_encoding_validate_limits(limits)?
    bytes :: jet_enc_json_canonical_tree(value, limits, 1)?
    if limits.max_total_bytes.is_some_and(fn(max) -> bytes.len() as I64 > max) -> return Err(jet_encoding_error(.Limit, 0, 1, 1, "max_total_bytes {limits.max_total_bytes.unwrap_or(0)} exceeded"))
    String.from_utf8(^bytes).map_err(fn(_) -> jet_encoding_error(.Unsupported, 0, 1, 1, "canonical JSON output is not UTF-8"))
}
