fn jet_enc_cbor_writer(output: JetFileWriter, limits: EncodingLimits) -> CBORWriter EncodingError! {
    jet_encoding_validate_limits(limits).map_err(fn(e) -> { e.format = .CBOR; e.line = None; e.column = None; e })?
    allocation :: JetEncodingAllocationBudget.new(jet_encoding_codec_heap_ceiling(limits))
    Ok(CBORWriter{output: ^output, limits: limits, terminal: None, total: 0, frames: [], root_written: false, finished: false, retained: 0, workspace: 0, allocation: ^allocation})
}
