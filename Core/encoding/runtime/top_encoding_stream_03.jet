fn jet_enc_cbor_writer_write(writer: &CBORWriter, event: DataEvent) -> EncodingError! { writer.write_event(^event) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingStream.rs:4084
