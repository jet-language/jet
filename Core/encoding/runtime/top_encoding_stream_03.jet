        if not self.allocation.charge(text.len()) -> return Err(jet_cbor_heap_error(start, path))
        if stored.try_reserve_exact(text.len()).is_err() {
            self.allocation.release(text.len())
            return Err(jet_cbor_stream_error(.Limit, start, path, "CBOR map key allocation failed"))
        }
        stored_capacity :: stored.capacity()
        if stored_capacity > text.len() {
