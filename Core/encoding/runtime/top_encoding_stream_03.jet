}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingStream.rs:3698
fn jet_cbor_push_preferred_float(out: &[U8], value: Float) -> Never! {
    if jet_cbor_half_exact(value) is Val(bits) { out.push(0xf9); out.extend_from_slice(bits.to_be_bytes()) }
    else if ((value as F32) as Float).to_bits() == value.to_bits() { out.push(0xfa); out.extend_from_slice((value as F32).to_bits().to_be_bytes()) }
    else { out.push(0xfb); out.extend_from_slice(value.to_bits().to_be_bytes()) }
}
