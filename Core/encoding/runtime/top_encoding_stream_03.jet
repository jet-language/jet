// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingStream.rs:3689
fn jet_enc_cbor_reader_next(reader: &CBORReader) -> DataEvent? EncodingError! { reader.next_event() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingStream.rs:3691
fn jet_cbor_stream_len(out: &[U8], major: U8, n: U64) -> Never! {
    if n < 24 -> out.push((major << 5) | n as U8)
    else if n <= 255 -> out.extend_from_slice([(major << 5) | 24, n as U8])
    else if n <= 65535 -> { out.push((major << 5) | 25); out.extend_from_slice((n as U16).to_be_bytes()) }
    else if n <= U32.MAX as U64 -> { out.push((major << 5) | 26); out.extend_from_slice((n as U32).to_be_bytes()) }
    else -> { out.push((major << 5) | 27); out.extend_from_slice(n.to_be_bytes()) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingStream.rs:3692
fn jet_cbor_stream_len_size(n: U64) -> Int Never! {
    if n < 24 -> 1 else if n <= U8.MAX as U64 -> 2 else if n <= U16.MAX as U64 -> 3 else if n <= U32.MAX as U64 -> 5 else -> 9
}
