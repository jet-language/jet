// D-ENCSTREAM-SURFACE1=A: the one EncodingError rendering for every tier.
// All adapters marshal these seven fields; byte/line/column/path precedence
// lives here rather than in an engine-specific formatter.
// Rust: crates/jet-codegen/src/Prelude/Core/EncodingError.rs:8
pub fn jet_encoding_error_kernel_show(format_name: String, kind_name: String, byte_offset: I64, line: I64?, column: I64?, path: String, reason: String) -> String Never! {
    out := "{format_name} {kind_name} at byte {byte_offset}"
    if line is Val(value) -> &out.push_str(", line {value}")
    if column is Val(value) -> &out.push_str(", column {value}")
    if not path.is_empty() -> &out.push_str(", path {path}")
    &out.push_str(": {reason}")
    out
}
