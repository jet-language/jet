use core as core
use core.encoding.[DataTree, EncodingError, EncodingErrorKind, EncodingFormat]

fn syntax_error(format: EncodingFormat, offset: Int, line: Int, column: Int, path: String, reason: String) -> EncodingError Never! {
    {
        format: format,
        kind: EncodingErrorKind.Syntax,
        byte_offset: offset,
        line: Val(line),
        column: Val(column),
        path: path,
        reason: reason,
        cause: None,
    }
}

fn unsupported_error(format: EncodingFormat, offset: Int, reason: String) -> EncodingError Never! {
    {
        format: format,
        kind: EncodingErrorKind.Unsupported,
        byte_offset: offset,
        line: None,
        column: None,
        path: "",
        reason: reason,
        cause: None,
    }
}

// core.encoding.csv — RFC 4180 tables as field rows.
//
// `rows` is the physical codec: it does not guess types. Every cell stays
// text. Quotes wrap a field; `""` is a literal quote. `parse` / `to_string`
// lift those rows into `DataTree` arrays so CSV participates in the shared
// tree without a second table type.
//
// Typed `decode<T>` remains a compiler lowering over header-named columns.
// The streaming `reader(^FileReader, limits)` / `writer(^FileWriter, limits)`
// handles are host-owned (D-ENCSTREAM-SURFACE1) and use the same row rules.
// `query` is a deliberately small SQL-shaped selector over caller-provided
// filesystem input; it does not add a second query engine.
pub struct CSVRow {
    pub line: Int
    pub fields: [String]
}

/// Physical rows (D-ROWS1). `delimiter` is one character other than a quote
/// or a line ending; `header: true` drops the first record (the header) and
/// returns only data records; `skip_blank` drops records with no field
/// content. Every `CSVRow.line` is the one-based physical line where that
/// record opens.
pub fn rows(text: String, delimiter: String{","}, header: Bool{false}, skip_blank: Bool{true}) -> [CSVRow] EncodingError! {
    parse_rows_with(text, delimiter, header, skip_blank, None)
}

/// Stop at the first completed record beyond `max_records`, before reading
/// later input. The bound counts returned records, not skipped blank/header rows.
pub fn rows_bounded(text: String, max_records: Int, delimiter: String{","}, header: Bool{false}, skip_blank: Bool{true}) -> [CSVRow] EncodingError! {
    parse_rows_with(text, delimiter, header, skip_blank, Val(max_records))
}

/// Rust CsvError::message (CsvKernel.rs:45-51), with record/field attribution
/// carried by EncodingError.path: `/records/R/fields/F` (both one-based).
pub fn error_message(error: EncodingError) -> String Never! {
    // #4377: two-capture string pattern emits field access on &() — byte extraction instead.
    if error.path.starts_with("/records/") {
        raw :: error.path.bytes()
        end := 9
        loop end < raw.len() && raw[end] != (U8{47}) -> end += 1
        record :: String.from_bytes(raw[9..<end]) ?? panic("CSV record index is ASCII")
        return "E2701: CSV row {record}, line {error.line ?? 0}, column {error.column ?? 0} — {error.reason}"
    }
    "E2701: {error.reason}"
}

pub fn decode(text: String) -> DataTree EncodingError! { parse(text) }

pub fn parse(text: String) -> DataTree EncodingError! {
    physical :: parse_rows(text, true)
    items := [DataTree]{}
    loop row in physical {
        fields := [DataTree]{}
        loop field in row.fields -> &fields.push(DataTree.Text(field))
        &items.push(DataTree.Array(fields))
    }
    Ok(DataTree.Array(items))
}

pub fn to_string(rows: [CSVRow]) -> String Never! {
    out := ""
    loop row in rows -> out = "{out}{encode_row(row.fields)}\n"
    out
}


/// Tiny SQL: `SELECT *` (all rows as arrays) or `SELECT COUNT(*)`.
pub fn query(path: String, sql: String) -[FS]> DataTree EncodingError! {
    text :: host_read_text(path) ?? return Err(syntax_error(EncodingFormat.CSV, 0, 1, 1, "", "missing csv"))
    physical :: parse_rows(text, true)
    q := trim_ascii(ascii_fold(sql))
    if q == "select count(*)" || q == "select count(*) from csv" -> return Ok(DataTree.Int(physical.len()))
    if q != "select *" && q != "select * from csv" {
        return Err(unsupported_error(EncodingFormat.CSV, 0, "CSV query supports only SELECT * and SELECT COUNT(*)"))
    }
    items := [DataTree]{}
    loop row in physical {
        fields := [DataTree]{}
        loop field in row.fields -> &fields.push(DataTree.Text(field))
        &items.push(DataTree.Array(fields))
    }
    Ok(DataTree.Array(items))
}

fn trim_ascii(text: String) -> String Never! {
    raw :: text.bytes()
    start := 0
    end := raw.len()
    loop start < end {
        n :: raw[start]
        if n == 32 || n == 9 || n == 10 || n == 13 {
            start += 1
            next
        }
        break
    }
    loop end > start {
        n :: raw[end - 1]
        if n == 32 || n == 9 || n == 10 || n == 13 {
            end -= 1
            next
        }
        break
    }
    if end <= start -> return ""
    String.from_bytes(raw[start..end - 1]) ?? ""
}

fn ascii_fold(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n :: b
        if n >= 65 && n <= 90 -> &out.push(U8{n + 32}) else -> &out.push(b)
    }
    String.from_bytes(out) ?? text
}


fn host_read_text(path: String) -[FS]> String? {
    Val(core.files.read(path) ?? return None)
}

fn parse_rows(text: String, skip_blank: Bool) -> [CSVRow] EncodingError! {
    parse_rows_with(text, ",", false, skip_blank, None)
}

// Rust CsvParser::new/push/finish/finish_record (CsvKernel.rs:95-362).
// One scalar-at-a-time engine serves rows, parse, dict_rows and bounded rows.
fn parse_rows_with(text: String, delimiter: String, header: Bool, skip_blank: Bool, max_records: Int?) -> [CSVRow] EncodingError! {
    delimiter_bytes :: delimiter.bytes()
    if delimiter.len() != 1 || delimiter_bytes[0] == (U8{34}) || delimiter_bytes[0] == (U8{13}) || delimiter_bytes[0] == (U8{10}) {
        return Err(unsupported_error(EncodingFormat.CSV, 0, "CSV delimiter must be exactly one character other than quote or line ending"))
    }
    raw :: text.bytes()
    rows := [CSVRow]{}
    fields := [String]{}
    field := [U8]{}
    line := 1
    row_line := 1
    column := 0
    record := 1
    i := 0
    quoted := false
    after_quote := false
    pending_cr := false
    cr_line := 1
    cr_column := 1
    cr_offset := 0
    has_content := false
    ended_record := false
    loop i < raw.len() {
        offset :: i
        b :: raw[i]
        width :: if b < (U8{128}) -> 1 else -> if b < (U8{224}) -> 2 else -> if b < (U8{240}) -> 3 else -> 4
        is_delimiter := width == delimiter_bytes.len()
        if is_delimiter {
            loop k in 0..<width { if raw[i + k] != delimiter_bytes[k] -> is_delimiter = false }
        }
        finish_record := false
        if pending_cr {
            if b != (U8{10}) -> return Err(csv_record_error(EncodingErrorKind.Syntax, cr_offset, cr_line, cr_column, record, fields.len(), "bare CR is not a record ending"))
            pending_cr = false
            line += 1
            column = 0
            finish_record = true
        } else {
            ended_record = false
            column += 1
            if quoted {
                if after_quote {
                    if {
                        b == (U8{34}) -> { &field.push(U8{34}); after_quote = false }
                        is_delimiter -> {
                            &fields.push(csv_field_string(field))
                            field = [U8]{}
                            quoted = false
                            after_quote = false
                        }
                        b == (U8{13}) -> {
                            quoted = false
                            after_quote = false
                            pending_cr = true
                            cr_line = line
                            cr_column = column
                            cr_offset = offset
                        }
                        b == (U8{10}) -> {
                            quoted = false
                            after_quote = false
                            line += 1
                            column = 0
                            finish_record = true
                        }
                        else -> {
                            delimiter_name :: if delimiter == "," -> "comma" else -> "delimiter"
                            return Err(csv_record_error(EncodingErrorKind.Syntax, offset, line, column, record, fields.len(), "only quote, {delimiter_name}, CRLF, LF, or EOF may follow a closing quote"))
                        }
                    }
                } else {
                    if b == (U8{34}) -> after_quote = true else {
                        loop k in 0..<width -> &field.push(raw[i + k])
                        if b == (U8{10}) { line += 1; column = 0 }
                    }
                }
            } else {
                if {
                    b == (U8{34}) -> {
                        if field.len() != 0 -> return Err(csv_record_error(EncodingErrorKind.Syntax, offset, line, column, record, fields.len(), "quote inside an unquoted field"))
                        quoted = true
                        has_content = true
                    }
                    is_delimiter -> { &fields.push(csv_field_string(field)); field = [U8]{} }
                    b == (U8{13}) -> {
                        pending_cr = true
                        cr_line = line
                        cr_column = column
                        cr_offset = offset
                    }
                    b == (U8{10}) -> { line += 1; column = 0; finish_record = true }
                    else -> {
                        loop k in 0..<width -> &field.push(raw[i + k])
                        has_content = true
                    }
                }
            }
        }
        i += width
        if finish_record {
            &fields.push(csv_field_string(field))
            field = [U8]{}
            if !(header && record == 1) && !(skip_blank && !has_content) {
                &rows.push(CSVRow{line: row_line, fields: fields})
                csv_check_record_bound(rows.len(), max_records, i, line, column)
            }
            fields = [String]{}
            record += 1
            row_line = line
            has_content = false
            ended_record = true
        }
    }
    if pending_cr -> return Err(csv_record_error(EncodingErrorKind.Syntax, cr_offset, cr_line, cr_column, record, fields.len(), "bare CR is not a record ending"))
    if quoted && !after_quote -> return Err(csv_record_error(EncodingErrorKind.Truncated, i, line, column + 1, record, fields.len(), "quoted field ended before its closing quote"))
    if !ended_record && raw.len() != 0 {
        &fields.push(csv_field_string(field))
        if !(header && record == 1) && !(skip_blank && !has_content) {
            &rows.push(CSVRow{line: row_line, fields: fields})
            csv_check_record_bound(rows.len(), max_records, i, line, column)
        }
    }
    Ok(rows)
}

fn csv_field_string(field: [U8]) -> String Never! {
    String.from_bytes(field) ?? panic("CSV field contains complete UTF-8 scalars")
}
fn csv_record_error(kind: EncodingErrorKind, offset: Int, line: Int, column: Int, record: Int, field: Int, reason: String) -> EncodingError Never! {
    EncodingError{format: EncodingFormat.CSV, kind: kind, byte_offset: offset,
        line: Val(line), column: Val(column), path: "/records/{record}/fields/{field + 1}", reason: reason, cause: None}
}
fn csv_check_record_bound(count: Int, max_records: Int?, offset: Int, line: Int, column: Int) EncodingError! {
    if max_records == {
        Val(bound) -> {
            if count > bound -> return Err(EncodingError{format: EncodingFormat.CSV, kind: EncodingErrorKind.Limit, byte_offset: offset, line: Val(line), column: Val(column), path: "", reason: "CSV input has more than the {bound}-record limit", cause: None})
        }
        None -> {}
    }
}

fn encode_row(fields: [String]) -> String {
    out := ""
    loop i in 0..<fields.len() {
        if i > 0 -> out = "{out},"
        out = "{out}{encode_field(fields[i])}"
    }
    out
}

fn encode_field(field: String) -> String {
    needs := false
    loop b in field.bytes() {
        n :: b
        if n == 44 || n == 34 || n == 10 || n == 13 -> needs = true
    }
    if !needs -> return ~field
    out := [U8]{34}
    loop b in field.bytes() {
        if b == (U8{34}) {
            &out.push(U8{34})
            &out.push(U8{34})
        } else { &out.push(b) }
    }
    &out.push(U8{34})
    String.from_bytes(out) ?? field
}

pub struct DictRow {
    pub fields: [String]
    pub values: [String]
}

pub fn dict_rows(text: String) -> [DictRow] EncodingError! {
    physical :: parse_rows(text, true)
    if physical.len() == 0 -> return Ok([DictRow]{})
    header :: physical[0].fields
    out := [DictRow]{}
    i := 1
    loop i < physical.len() {
        fields := [String]{}
        values := [String]{}
        k := 0
        loop k < header.len() {
            &fields.push(header[k])
            if k < physical[i].fields.len() -> &values.push(physical[i].fields[k]) else {
                &values.push("")
            }
            k = k + 1
        }
        &out.push(DictRow{fields: fields, values: values})
        i = i + 1
    }
    Ok(out)
}

pub fn dict_get(row: DictRow, key: String) -> String? Never! {
    i := 0
    loop i < row.fields.len() {
        if row.fields[i] == key -> return Val(row.values[i])
        i = i + 1
    }
    None
}

pub fn dict_get_or(row: DictRow, key: String, fallback: String) -> String Never! {
    dict_get(row, key) ?? fallback
}

pub fn write_dict(rows: [DictRow]) -> String Never! {
    if rows.len() == 0 -> return ""
    out := "{encode_row(rows[0].fields)}\n"
    loop row in rows -> out = "{out}{encode_row(row.values)}\n"
    out
}

pub fn fieldnames(rows: [DictRow]) -> [String] Never! {
    if rows.len() == 0 -> return [String]{}
    rows[0].fields
}
