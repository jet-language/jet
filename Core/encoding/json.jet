// core.encoding.json — RFC 8259 JSON as DataTree.
//
// `parse` is the strict codec: objects keep insertion order, whole numbers
// become `DataTree.Int` (exact `Int`, not binary64), fractions become
// `DataTree.Float`, and `NaN` / `Infinity` are syntax errors. `decode` is the
// same tree with the historical lenient name; typed `decode<T>` stays a
// compiler lowering over this tree and is not reimplemented here.
//
// `to_string` is compact. `to_string_pretty` uses two-space indent. Neither
// emits a trailing newline. Keys are not sorted — insertion order is the
// document order.
//
// Allocates one output tree plus the decoded strings. Depth is bounded by
// `EncodingLimits.safe().max_depth` (256) so hostile nesting cannot run the
// process out of stack.

/// Strict JSON → `DataTree`.
pub fn parse(text: String) -> DataTree !EncodingError { parse_json(text) }

/// Same as `parse`. Kept as the documented sibling verb for typed lowering.
pub fn decode(text: String) -> DataTree !EncodingError { parse_json(text) }
/// Python-compatible spelling for JSON parsing.
pub fn loads(text: String) -> DataTree !EncodingError { parse(text) }

/// Python-compatible file-shaped spelling for JSON parsing.
pub fn load(text: String) -> DataTree !EncodingError { parse(text) }
/// Compact JSON text. Object keys keep insertion order.
pub fn to_string(value: DataTree) -> String { render_json(value, false) }
/// Python-compatible spelling for compact JSON serialization.
pub fn dumps(value: DataTree) -> String { to_string(value) }
/// Python-compatible file-shaped spelling for JSON serialization.
pub fn dump(value: DataTree) -> String { to_string(value) }

/// Two-space indented JSON text.
pub fn to_string_pretty(value: DataTree) -> String { render_json(value, true) }

/// RFC 8785-style canonical JSON: compact, object keys sorted by UTF-8.
pub fn canonical(value: DataTree) -> String { render_canonical(value) }

/// Streaming pull parser over `text`. `next` yields one `DataEvent` until `End`.
pub fn reader(text: String) -> JSONReader { JSONReader{parser: Parser.new(text.bytes())} }

/// Event list for the whole document, including the terminal `End`.
pub fn events(text: String) -> [DataEvent] !EncodingError {
    r := reader(text)
    out := [DataEvent]{}
    loop {
        ev :: r.next()
        out.push(ev)
        if ev == {
            .End -> return Ok(out)
            else -> { _ := 0 }
        }
    }
}

pub fn writer() -> JSONWriter { JSONWriter{pretty: false, parts: [U8]{}} }

pub struct JSONReader {
    pub parser: Parser
}

impl JSONReader {
    pub fn next(&self) -> DataEvent !EncodingError { self.parser.next_event() }
}

pub struct JSONWriter {
    pub pretty: Bool
    pub parts: [U8]
}

impl JSONWriter {
    pub fn write(&self, value: DataTree) {
        chunk :: render_json(value, self.pretty).bytes()
        loop b in chunk -> self.parts.push(b)
    }

    pub fn to_string(self) -> String { String.from_bytes(self.parts) ?? "" }
}

struct Parser {
    bytes: [U8]
    index: Int
    line: Int
    column: Int
    depth: Int
    path: [String]
}

impl Parser {
    fn new(bytes: [U8]) -> Parser { Parser{bytes: bytes, index: 0, line: 1, column: 1, depth: 0, path: [String]{}} }

    fn peek(self) -> ?U8 {
        if self.eof() -> return None
        Val(self.bytes[self.index])
    }

    fn bump(&self) -> ?U8 {
        b :: self.peek() ?? return None
        self.index += 1
        if b == (U8{10}) {
            self.line += 1
            self.column = 1
        } else {
            self.column += 1
        }
        Val(b)
    }

    fn err(self, reason: String) -> EncodingError {
        return EncodingError.syntax(
            EncodingFormat.JSON,
            self.index,
            self.line,
            self.column,
            "/" + self.path.join("/"),
            reason,
        )
    }

    fn skip_ws(&self) {
        loop {
            b :: self.peek() ?? return
            n :: b
            if n == 32 || n == 9 || n == 10 || n == 13 {
                _ :: self.bump()
            } else {
                return
            }
        }
    }

    fn expect(&self, want: U8, what: String) !EncodingError {
        b :: self.bump() ?? return Err(self.err("input ended while reading {what}"))
        if b != want -> return Err(self.err("expected {what}"))
        Ok()
    }

    fn parse_value(&self) -> DataTree !EncodingError {
        self.skip_ws()
        b :: self.peek() ?? return Err(EncodingError.truncated(
            EncodingFormat.JSON,
            self.index,
            self.line,
            self.column,
            "/" + self.path.join("/"),
        ))
        n :: b
        if n == {
            110 -> return self.parse_literal("null", DataTree.Null)
            116 -> return self.parse_literal("true", DataTree.Bool(true))
            102 -> return self.parse_literal("false", DataTree.Bool(false))
            else -> { _ := 0 }
        }
        if n == 34 {
            s :: self.parse_string()
            return Ok(DataTree.Text(s))
        }
        if n == {
            91 -> return self.parse_array()
            123 -> return self.parse_object()
            else -> { _ := 0 }
        }
        if n == 45 || (n >= 48 && n <= 57) -> return self.parse_number()
        Err(self.err("expected a JSON value (object, array, string, number, true, false, or null)"))
    }

    fn parse_literal(&self, spelling: String, value: DataTree) -> DataTree !EncodingError {
        loop b in spelling.bytes() {
            got :: self.bump() ?? return Err(self.err("input ended inside `{spelling}`"))
            if got != b -> return Err(self.err("expected `{spelling}`"))
        }
        Ok(value)
    }

    fn parse_string(&self) -> String !EncodingError {
        self.expect(U8{34}, "a string opening quote")
        out := [U8]{}
        loop {
            b :: self.bump() ?? return Err(self.err("unterminated string"))
            n :: b
            if n == 34 -> return Ok(String.from_bytes(out) ?? "")
            if n < 32 -> return Err(self.err("unescaped control character in string; use a JSON escape"))
            if n != 92 {
                out.push(b)
                next
            }
            esc :: self.bump() ?? return Err(self.err("unterminated string escape"))
            e :: esc
            if e == 34 || e == 92 || e == 47 {
                out.push(esc)
                next
            }
            if e == 98 {
                out.push(U8{8})
                next
            }
            if e == 102 {
                out.push(U8{12})
                next
            }
            if e == 110 {
                out.push(U8{10})
                next
            }
            if e == 114 {
                out.push(U8{13})
                next
            }
            if e == 116 {
                out.push(U8{9})
                next
            }
            if e == 117 {
                cp :: self.parse_hex4()
                push_utf8(&out, cp)
                next
            }
            return Err(self.err("unknown string escape; JSON allows \\\", \\\\, \\/, \\b, \\f, \\n, \\r, \\t, \\uXXXX"))
        }
    }

    fn parse_hex4(&self) -> Int !EncodingError {
        n := 0
        loop _ in 0..<4 {
            b :: self.bump() ?? return Err(self.err("truncated \\u escape"))
            d :: hex_digit(b) ?? return Err(self.err("\\u escape needs four hexadecimal digits"))
            n = n * 16 + d
        }
        Ok(n)
    }

    fn parse_number(&self) -> DataTree !EncodingError {
        start :: self.index
        if self.peek() ?? (U8{0}) == (U8{45}) -> _ :: self.bump()
        first :: self.peek() ?? return Err(self.err("input ended inside a number"))
        first_digit :: first
        if first_digit < 48 || first_digit > 57 -> return Err(self.err("expected a digit"))
        if first_digit == 48 {
            _ :: self.bump()
            nextc :: self.peek() ?? (U8{0})
            nn :: nextc
            if nn >= 48 && nn <= 57 -> return Err(self.err("leading zeros are not allowed in JSON numbers"))
        } else {
            loop {
                n :: self.peek() ?? break
                d :: n
                if d >= 48 && d <= 57 {
                    _ :: self.bump()
                } else {
                    break
                }
            }
        }
        fractional := false
        if self.peek() ?? (U8{0}) == (U8{46}) {
            fractional = true
            _ :: self.bump()
            digit :: self.peek() ?? return Err(self.err("decimal point must be followed by a digit"))
            dn :: digit
            if dn < 48 || dn > 57 -> return Err(self.err("decimal point must be followed by a digit"))
            loop {
                n :: self.peek() ?? break
                d :: n
                if d >= 48 && d <= 57 {
                    _ :: self.bump()
                } else {
                    break
                }
            }
        }
        exp := false
        ebyte :: self.peek() ?? (U8{0})
        en :: ebyte
        if en == 101 || en == 69 {
            exp = true
            _ :: self.bump()
            sign :: self.peek() ?? (U8{0})
            sn :: sign
            if sn == 43 || sn == 45 -> _ :: self.bump()
            digit :: self.peek() ?? return Err(self.err("exponent must contain a digit"))
            dn :: digit
            if dn < 48 || dn > 57 -> return Err(self.err("exponent must contain a digit"))
            loop {
                n :: self.peek() ?? break
                d :: n
                if d >= 48 && d <= 57 {
                    _ :: self.bump()
                } else {
                    break
                }
            }
        }
        token :: String.from_bytes(self.bytes[start..self.index - 1]) ?? return Err(self.err("invalid number token"))
        if fractional || exp {
            f :: Float.parse(token) ?? return Err(self.err("number does not fit in Float"))
            if f != f -> return Err(self.err("NaN is not valid JSON"))
            return Ok(DataTree.Float(f))
        }
        n :: Int.parse(token) ?? return Err(self.err("number does not fit in Int"))
        Ok(DataTree.Int(n))
    }

    fn parse_array(&self) -> DataTree !EncodingError {
        self.expect(U8{91}, "'['")
        self.enter()
        items := [DataTree]{}
        self.skip_ws()
        if self.peek() ?? (U8{0}) == (U8{93}) {
            _ :: self.bump()
            self.leave()
            return Ok(DataTree.Array(items))
        }
        index := 0
        loop {
            self.path.push("{index}")
            value :: self.parse_value()
            _ :: self.path.pop()
            items.push(value)
            self.skip_ws()
            b :: self.peek() ?? return Err(self.err("unterminated array"))
            if b == (U8{93}) {
                _ :: self.bump()
                self.leave()
                return Ok(DataTree.Array(items))
            }
            if b != (U8{44}) -> return Err(self.err("expected ',' or ']' after an array element"))
            _ :: self.bump()
            self.skip_ws()
            if self.peek() ?? (U8{0}) == (U8{93}) -> return Err(self.err("trailing commas are not allowed in JSON"))
            index += 1
        }
    }

    fn parse_object(&self) -> DataTree !EncodingError {
        self.expect(U8{123}, "'{{'")
        self.enter()
        entries := [String: DataTree]{}
        self.skip_ws()
        if self.peek() ?? (U8{0}) == (U8{125}) {
            _ :: self.bump()
            self.leave()
            return Ok(DataTree.Object(entries))
        }
        loop {
            self.skip_ws()
            if self.peek() ?? (U8{0}) != (U8{34}) -> return Err(self.err("object keys must be strings"))
            key :: self.parse_string()
            self.skip_ws()
            self.expect(U8{58}, "':' after an object key")
            self.path.push(key)
            value :: self.parse_value()
            _ :: self.path.pop()
            if entries.has_key(key) {
                return Err(self.err("duplicate object key `{key}`"))
            }
            _ :: entries.add(key, value)
            self.skip_ws()
            b :: self.peek() ?? return Err(self.err("unterminated object"))
            if b == (U8{125}) {
                _ :: self.bump()
                self.leave()
                return Ok(DataTree.Object(entries))
            }
            if b != (U8{44}) -> return Err(self.err("expected ',' or '}}' after an object member"))
            _ :: self.bump()
            self.skip_ws()
            if self.peek() ?? (U8{0}) == (U8{125}) -> return Err(self.err("trailing commas are not allowed in JSON"))
        }
    }

    fn enter(&self) !EncodingError {
        self.depth += 1
        if self.depth > EncodingLimits.safe().max_depth {
            return Err(self.err("nesting exceeds EncodingLimits.safe().max_depth (256)"))
        }
        Ok()
    }

    fn leave(&self) {
        self.depth -= 1
    }

    fn next_event(&self) -> DataEvent !EncodingError {
        self.skip_ws()
        if self.eof() -> return Ok(DataEvent.End)
        value :: self.parse_value()
        self.skip_ws()
        if !self.eof() -> return Err(self.err("unexpected trailing data after the JSON value"))
        Ok(event_from_tree(value))
    }
}

fn parse_json(text: String) -> DataTree !EncodingError {
    p := Parser.new(text.bytes())
    value :: p.parse_value()
    p.skip_ws()
    if !p.eof() -> return Err(p.err("unexpected trailing data after the JSON value"))
    Ok(value)
}

fn event_from_tree(value: DataTree) -> DataEvent {
    if value == {
        .Null -> return DataEvent.Null
        .Bool(v) -> return DataEvent.Bool(v)
        .Int(n) -> return DataEvent.Int(n)
        .Float(n) -> return DataEvent.Float(n)
        .Text(s) -> return DataEvent.Text(s)
        .Array(_) -> return DataEvent.BeginArray
        .Object(_) -> return DataEvent.BeginObject
    }
}

fn hex_digit(b: U8) -> ?Int {
    n :: b
    if n >= 48 && n <= 57 -> return Val(n - 48)
    if n >= 97 && n <= 102 -> return Val(n - 87)
    if n >= 65 && n <= 70 -> return Val(n - 55)
    None
}

fn push_utf8(out: &[U8], cp: Int) {
    if cp < 128 {
        out.push(U8{cp})
        return
    }
    if cp < 2048 {
        out.push(U8{192 | (cp >> 6)})
        out.push(U8{128 | (cp & 63)})
        return
    }
    if cp < 65536 {
        out.push(U8{224 | (cp >> 12)})
        out.push(U8{128 | ((cp >> 6) & 63)})
        out.push(U8{128 | (cp & 63)})
        return
    }
    out.push(U8{240 | (cp >> 18)})
    out.push(U8{128 | ((cp >> 12) & 63)})
    out.push(U8{128 | ((cp >> 6) & 63)})
    out.push(U8{128 | (cp & 63)})
}

fn render_json(value: DataTree, pretty: Bool) -> String {
    out := [U8]{}
    write_json(&out, value, pretty, 0)
    String.from_bytes(out) ?? ""
}

fn render_canonical(value: DataTree) -> String {
    out := [U8]{}
    write_canonical(&out, value)
    String.from_bytes(out) ?? ""
}

fn write_canonical(out: &[U8], value: DataTree) {
    if value == {
        .Null -> write_ascii(out, "null")
        .Bool(v) -> {
            if v -> write_ascii(out, "true")
            else -> write_ascii(out, "false")
        }
        .Int(n) -> write_ascii(out, "{n}")
        .Float(n) -> write_ascii(out, "{n}")
        .Text(s) -> write_json_string(out, s)
        .Array(items) -> {
            out.push(U8{91})
            loop i in 0..<items.len() {
                if i > 0 -> out.push(U8{44})
                write_canonical(out, items[i])
            }
            out.push(U8{93})
        }
        .Object(entries) -> {
            keys := [String]{}
            loop pair in entries -> keys.push(pair.key)
            loop i in 0..<keys.len() {
                loop j in (i + 1)..<keys.len() {
                    if cmp_utf8(keys[j], keys[i]) < 0 {
                        tmp :: keys[i]
                        keys[i] = keys[j]
                        keys[j] = tmp
                    }
                }
            }
            out.push(U8{123})
            loop i in 0..<keys.len() {
                if i > 0 -> out.push(U8{44})
                write_json_string(out, keys[i])
                out.push(U8{58})
                write_canonical(out, entries.get(keys[i]) ?? DataTree.Null)
            }
            out.push(U8{125})
        }
    }
}

fn cmp_utf8(a: String, b: String) -> Int {
    xa :: a.bytes()
    xb :: b.bytes()
    n := xa.len()
    if xb.len() < n -> n = xb.len()
    loop i in 0..<n {
        da :: xa[i]
        db :: xb[i]
        if da < db -> return -1
        if da > db -> return 1
    }
    if xa.len() < xb.len() -> return -1
    if xa.len() > xb.len() -> return 1
    0
}

fn write_json(out: &[U8], value: DataTree, pretty: Bool, indent: Int) {
    if value == {
        .Null -> write_ascii(out, "null")
        .Bool(v) -> {
            if v -> write_ascii(out, "true")
            else -> write_ascii(out, "false")
        }
        .Int(n) -> write_ascii(out, "{n}")
        .Float(n) -> write_ascii(out, "{n}")
        .Text(s) -> write_json_string(out, s)
        .Array(items) -> {
            out.push(U8{91})
            if items.len() == 0 {
                out.push(U8{93})
                return
            }
            loop i in 0..<items.len() {
                if pretty {
                    out.push(U8{10})
                    write_indent(out, indent + 1)
                }
                write_json(out, items[i], pretty, indent + 1)
                if i + 1 < items.len() -> out.push(U8{44})
            }
            if pretty {
                out.push(U8{10})
                write_indent(out, indent)
            }
            out.push(U8{93})
        }
        .Object(entries) -> {
            out.push(U8{123})
            if entries.len() == 0 {
                out.push(U8{125})
                return
            }
            i := 0
            loop pair in entries {
                if pretty {
                    out.push(U8{10})
                    write_indent(out, indent + 1)
                }
                write_json_string(out, pair.key)
                out.push(U8{58})
                if pretty -> out.push(U8{32})
                write_json(out, pair.value, pretty, indent + 1)
                i += 1
                if i < entries.len() -> out.push(U8{44})
            }
            if pretty {
                out.push(U8{10})
                write_indent(out, indent)
            }
            out.push(U8{125})
        }
    }
}

fn write_ascii(out: &[U8], text: String) {
    loop b in text.bytes() -> out.push(b)
}

fn write_indent(out: &[U8], n: Int) {
    loop _ in 0..<n {
        out.push(U8{32})
        out.push(U8{32})
    }
}

fn write_json_string(out: &[U8], text: String) {
    out.push(U8{34})
    loop b in text.bytes() {
        n :: b
        if n == 34 {
            write_ascii(out, "\\\"")
            next
        }
        if n == 92 {
            write_ascii(out, "\\\\")
            next
        }
        if n == 8 {
            write_ascii(out, "\\b")
            next
        }
        if n == 12 {
            write_ascii(out, "\\f")
            next
        }
        if n == 10 {
            write_ascii(out, "\\n")
            next
        }
        if n == 13 {
            write_ascii(out, "\\r")
            next
        }
        if n == 9 {
            write_ascii(out, "\\t")
            next
        }
        if n < 32 {
            write_ascii(out, "\\u00")
            out.push(nibble(n / 16))
            out.push(nibble(n % 16))
            next
        }
        out.push(b)
    }
    out.push(U8{34})
}

fn nibble(n: Int) -> U8 {
    if n < 10 -> return (U8{48 + n})
    (U8{87 + n})
}
