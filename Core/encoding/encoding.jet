package {
    name: "core.encoding"
    version: "0.0.1"
    edition: "2026"
    description: "Codecs and the shared DataTree interchange model."
    license: "MIT"
    outputs: {
        encoding: .Library{ entry: encoding }
    }
}
use core.encoding.runtime.kernel_hex_decode as encoding_hex_decode

// core.encoding — interchange codecs and the one dynamic value tree.
//
// Every format in this package speaks the same two verbs: `parse` (text or
// bytes → `DataTree`) and `to_string` / `to_bytes` (value → wire). JSON, JSONL
// CSV, TOML, YAML, XML, and CBOR are nested modules so a program pays only for
// the format it imports. Hex, Base32, and Base64 are byte alphabets, not
// DataTree adapters; they live beside the formats because they are the usual
// way to carry those bytes through text.
//
// This is compiler-owned Core source and is loaded as the `core.encoding`
// package entry. Its nested modules share the carriers below; only narrow
// host capabilities (for example filesystem reads requested by a public
// query API) remain effectful.
// Portable codecs below are written in Jet.
//
// Invariants:
// - `DataTree` is the only user-facing dynamic tree. There is no `Data` alias.
// - Objects keep insertion order. Integers and floats stay distinct variants.
// - No codec fabricates a value for malformed input. Syntax problems are
//   `EncodingError`; alphabet helpers use their local typed errors.
// - Whole-value codecs are pure (`->`) and callers pass text or bytes directly.
module runtime

module hex

module base32

module base64

module json

module jsonl

module csv
module toml
module yaml

module xml

module cbor

module binary

module ini
/// Error returned by the root hexadecimal decoder.
#Error
pub struct HexError {
    pub reason: String
}
/// Convert one nibble to lowercase ASCII. Callers must pass `0..15`.
pub fn hex_nibble(n: Int) -> U8 Never! {
    if n < 10 -> return (U8{48 + n})
    (U8{87 + n})
}

/// Hex alphabet lookup. Accepts `0-9A-Fa-f`. Other bytes are absent.
pub fn hex_value(b: U8) -> Int? Never! {
    n :: Int.from_u8(b)
    if n >= 48 && n <= 57 -> return Val(n - 48)
    if n >= 97 && n <= 102 -> return Val(n - 87)
    if n >= 65 && n <= 70 -> return Val(n - 55)
    None
}

/// Lowercase hex of `bytes`. Allocates `2 * bytes.len()` ASCII bytes.
// One hexadecimal law for owning lists and borrowed fixed digests. The view
// retains the original owner/extent; callers do not widen fixed arrays to lists.
pub fn bytes_to_hex(bytes: View<U8>) -> String Never! {
    out := [U8]{}
    loop b in bytes {
        n :: Int.from_u8(b)
        &out.push(hex_nibble(n /% 16))
        &out.push(hex_nibble(n %% 16))
    }
    String.from_bytes(out) ?? ""
}

/// Decode a hex string into bytes. Whitespace is rejected; length must be even.
// String.bytes still materializes the canonical UTF-8 bytes (#4318/#4392).
// Borrow that one representation; the private decoder never copies encoded
// bytes or recovers an intermediate String.
pub fn hex_to_bytes(text: String) -> [U8] HexError! {
    raw :: text.bytes()
    view :: raw[0..<raw.len()]
    encoding_hex_decode.decode(view)
}

/// 32-bit wrap used by hashes and CBOR integer codecs. Jet `Int` is exact; mask
/// after arithmetic to get machine-word wrapping without a second integer type.
pub fn wrap32(n: Int) -> Int Never! { n & 4294967295 }


