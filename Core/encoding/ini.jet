package {
    name: "core.encoding.ini"
    version: "0.1.0"
    edition: "2026"
    description: "INI / ConfigParser documents as ordered sections."
    license: "MIT"
    outputs: {
        ini: .Library{ entry: ini }
    }
}

// core.encoding.ini — Python `configparser` without interpolation.
//
// Sections keep source order. Duplicate keys in a section keep the last
// value. Comments are `#` and `;` to end of line. Values may be quoted.
// `DEFAULT` is a section name, not a magic fallback, unless `get_or` is used
// with a caller-supplied default. This codec is pure.
#Error
pub struct INIError {
    pub line: Int
    pub reason: String
}

impl INIError {
    pub fn new(line: Int, reason: String) -> INIError {
        INIError{line: line, reason: reason}
    }
}


pub struct Pair {
    pub key: String
    pub value: String
}

pub struct Section {
    pub name: String
    pub pairs: [Pair]
}

pub struct Ini {
    pub sections: [Section]
}

pub fn empty() -> Ini !Never { Ini{sections: [Section]{}} }

pub fn parse(text: String) -> Ini !INIError {
    doc := empty()
    current := ""
    line := 0
    loop raw_line in split_lines(text) {
        line += 1
        trimmed :: trim(strip_comment(raw_line))
        if trimmed.bytes().len() == 0 -> next
        raw :: trimmed.bytes()
        if raw[0] == (U8{91}) {
            if raw[raw.len() - 1] != (U8{93}) -> return Err(INIError{line: line, reason: "ini section is missing a closing bracket"})
            current = trim(String.from_bytes(slice_b(raw, 1, raw.len() - 1)) ?? "")
            if current.bytes().len() == 0 -> return Err(INIError{line: line, reason: "ini section name is empty"})
            doc = ensure_section(doc, current)
            next
        }
        eq :: index_of(raw, 61)
        colon := index_of(raw, 58)
        sep := eq
        if sep < 0 || (colon >= 0 && colon < sep) -> sep = colon
        if sep <= 0 -> return Err(INIError{line: line, reason: "ini line is not a key=value pair"})
        key :: trim(String.from_bytes(slice_b(raw, 0, sep)) ?? "")
        value_text :: trim(String.from_bytes(slice_b(raw, sep + 1, raw.len())) ?? "")
        value_raw :: value_text.bytes()
        if value_raw.len() > 0 && (value_raw[0] == (U8{34}) || value_raw[0] == (U8{39})) {
            if value_raw.len() < 2 || value_raw[value_raw.len() - 1] != value_raw[0] {
                return Err(INIError{line: line, reason: "ini quoted value is missing its closing quote"})
            }
        }
        value :: unquote(value_text)
        if key.bytes().len() == 0 -> return Err(INIError{line: line, reason: "ini key is empty"})
        if current.bytes().len() == 0 -> current = "DEFAULT"
        doc = set(doc, current, key, value)
    }
    Ok(doc)
}

pub fn to_string(doc: Ini) -> String {
    out := ""
    loop section in doc.sections {
        out = "{out}[{section.name}]\n"
        loop p in section.pairs -> out = "{out}{p.key} = {ini_value(p.value)}\n"
        out = "{out}\n"
    }
    out
}

pub fn sections(doc: Ini) -> [String] {
    names := [String]{}
    loop s in doc.sections -> names.push(s.name)
    names
}

pub fn has_section(doc: Ini, name: String) -> Bool !Never {
    loop s in doc.sections {
        if s.name == name -> return true
    }
    false
}

pub fn has_option(doc: Ini, section: String, key: String) -> Bool { get(doc, section, key) != None }

pub fn get(doc: Ini, section: String, key: String) -> ?String {
    loop s in doc.sections {
        if s.name == section {
            loop p in s.pairs {
                if p.key == key -> return Val(p.value)
            }
        }
    }
    None
}

pub fn get_or(doc: Ini, section: String, key: String, fallback: String) -> String { get(doc, section, key) ?? fallback }

pub fn get_int(doc: Ini, section: String, key: String) -> ?Int {
    text :: get(doc, section, key) ?? return None
    parse_int(text)
}

pub fn get_bool(doc: Ini, section: String, key: String) -> ?Bool {
    text :: get(doc, section, key) ?? return None
    t :: ascii_lower(trim(text))
    if t == {
        "1" | "true" | "yes" | "on" -> return Val(true)
        "0" | "false" | "no" | "off" -> return Val(false)
        else -> return None
    }
}

pub fn get_float(doc: Ini, section: String, key: String) -> ?Float {
    text :: get(doc, section, key) ?? return None
    parse_float(text)
}

pub fn items(doc: Ini, section: String) -> [Pair] {
    loop s in doc.sections {
        if s.name == section -> return s.pairs
    }
    [Pair]{}
}

pub fn options(doc: Ini, section: String) -> [String] {
    keys := [String]{}
    loop p in items(doc, section) -> keys.push(p.key)
    keys
}

pub fn set(doc: Ini, section: String, key: String, value: String) -> Ini !Never {
    sections := [Section]{}
    found_section := false
    loop s in doc.sections {
        if s.name == section {
            found_section = true
            pairs := [Pair]{}
            found_key := false
            loop p in s.pairs {
                if p.key == key {
                    pairs.push(Pair{key: key, value: value})
                    found_key = true
                } else {
                    pairs.push(p)
                }
            }
            if !found_key -> pairs.push(Pair{key: key, value: value})
            sections.push(Section{name: s.name, pairs: pairs})
        } else {
            sections.push(s)
        }
    }
    if !found_section {
        sections.push(Section{name: section, pairs: [Pair]{Pair{key: key, value: value}}})
    }
    Ini{sections: sections}
}

pub fn remove_option(doc: Ini, section: String, key: String) -> Ini {
    sections := [Section]{}
    loop s in doc.sections {
        if s.name == section {
            pairs := [Pair]{}
            loop p in s.pairs {
                if p.key != key -> pairs.push(p)
            }
            sections.push(Section{name: s.name, pairs: pairs})
        } else {
            sections.push(s)
        }
    }
    Ini{sections: sections}
}

pub fn remove_section(doc: Ini, section: String) -> Ini {
    sections := [Section]{}
    loop s in doc.sections {
        if s.name != section -> sections.push(s)
    }
    Ini{sections: sections}
}

pub fn defaults(doc: Ini) -> [Pair] { items(doc, "DEFAULT") }

fn ensure_section(doc: Ini, name: String) -> Ini !Never {
    if has_section(doc, name) -> return ~doc
    sections := [Section]{}
    loop s in doc.sections -> sections.push(s)
    sections.push(Section{name: name, pairs: [Pair]{}})
    Ini{sections: sections}
}

fn strip_comment(line: String) -> String !Never {
    raw :: line.bytes()
    i := 0
    in_quote := false
    q := 0
    loop i < raw.len() {
        n :: raw[i]
        if in_quote {
            if n == q -> in_quote = false
        } else if n == 34 || n == 39 {
            in_quote = true
            q = n
        } else if n == 35 || n == 59 {
            return String.from_bytes(slice_b(raw, 0, i)) ?? ""
        }
        i = i + 1
    }
    ~line
}

fn unquote(text: String) -> String !Never {
    raw :: text.bytes()
    if raw.len() >= 2 {
        a :: raw[0]
        b :: raw[raw.len() - 1]
        if (a == 34 && b == 34) || (a == 39 && b == 39) {
            body := [U8]{}
            i := 1
            loop i < raw.len() - 1 {
                if raw[i] == (U8{92}) && i + 1 < raw.len() - 1 {
                    i += 1
                    if raw[i] == (U8{110}) -> body.push(U8{10})
                    else if raw[i] == (U8{114}) -> body.push(U8{13})
                    else if raw[i] == (U8{116}) -> body.push(U8{9})
                    else -> body.push(raw[i])
                } else {
                    body.push(raw[i])
                }
                i += 1
            }
            return String.from_bytes(body) ?? ~text
        }
    }
    ~text
}

fn ini_value(text: String) -> String {
    raw :: text.bytes()
    quote := raw.len() == 0
    i := 0
    loop i < raw.len() {
        n :: raw[i]
        if n == 32 || n == 9 || n == 35 || n == 59 || n == 34 || n == 39 || n == 10 || n == 13 || n == 92 -> quote = true
        i += 1
    }
    if !quote -> return ~text
    out := "\""
    loop b in raw {
        if b == (U8{92}) -> out = "{out}\\\\"
        else if b == (U8{10}) -> out = "{out}\\n"
        else if b == (U8{13}) -> out = "{out}\\r"
        else if b == (U8{9}) -> out = "{out}\\t"
        else if b == (U8{34}) -> out = "{out}\\\""
        else -> out = "{out}{String.from_bytes([U8]{b}) ?? ""}"
    }
    "{out}\""
}

fn split_lines(text: String) -> [String] !Never {
    raw :: text.bytes()
    out := [String]{}
    start := 0
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{10}) {
            end := i
            if end > start && raw[end - 1] == (U8{13}) -> end = end - 1
            out.push(String.from_bytes(slice_b(raw, start, end)) ?? "")
            start = i + 1
        }
        i = i + 1
    }
    if start <= raw.len() -> out.push(String.from_bytes(slice_b(raw, start, raw.len())) ?? "")
    out
}

fn trim(text: String) -> String !Never {
    raw :: text.bytes()
    a := 0
    b := raw.len()
    loop a < b {
        n :: raw[a]
        if n == 32 || n == 9 -> a = a + 1
        else -> break
    }
    loop b > a {
        n :: raw[b - 1]
        if n == 32 || n == 9 -> b = b - 1
        else -> break
    }
    String.from_bytes(slice_b(raw, a, b)) ?? ""
}

fn index_of(raw: [U8], code: Int) -> Int !Never {
    loop i in 0..<raw.len() {
        n :: raw[i]
        if n == code -> return i
    }
    -1
}

fn slice_b(raw: [U8], start: Int, end: Int) -> [U8] !Never {
    out := [U8]{}
    i := start
    loop i < end && i >= 0 && i < raw.len() {
        out.push(raw[i])
        i = i + 1
    }
    out
}

fn ascii_lower(text: String) -> String !Never {
    out := [U8]{}
    loop b in text.bytes() {
        n :: b
        if n >= 65 && n <= 90 {
            out.push(U8{n + 32})
        } else {
            out.push(b)
        }
    }
    String.from_bytes(out) ?? ~text
}

fn parse_int(text: String) -> ?Int {
    raw :: trim(text).bytes()
    if raw.len() == 0 -> return None
    i := 0
    sign := 1
    if raw[0] == (U8{45}) {
        sign = -1
        i = 1
    }
    if i >= raw.len() -> return None
    n := 0
    loop i < raw.len() {
        d :: raw[i]
        if d < 48 || d > 57 -> return None
        n = n * 10 + (d - 48)
        i = i + 1
    }
    Val(n * sign)
}

fn parse_float(text: String) -> ?Float {
    t :: trim(text)
    raw :: t.bytes()
    if raw.len() == 0 -> return None
    i := 0
    sign := Float{1}
    if raw[0] == (U8{45}) {
        sign = Float{-1}
        i = 1
    }
    whole := Float{0}
    seen := false
    loop i < raw.len() {
        d :: raw[i]
        if d == 46 -> break
        if d < 48 || d > 57 -> return None
        whole = whole * Float{10} + Float{d - 48}
        seen = true
        i = i + 1
    }
    frac := Float{0}
    place := Float{1} / Float{10}
    if i < raw.len() && raw[i] == (U8{46}) {
        i = i + 1
        loop i < raw.len() {
            d :: raw[i]
            if d < 48 || d > 57 -> return None
            frac = frac + Float{d - 48} * place
            place = place * (Float{1} / Float{10})
            seen = true
            i = i + 1
        }
    }
    if !seen || i != raw.len() -> return None
    Val(sign * (whole + frac))
}
