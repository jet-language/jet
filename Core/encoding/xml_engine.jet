        kind :: required_text(attribute, "$xml") ?? return Err(XMLFault.shape(err))
        if kind != "attribute" -> return Err(XMLFault.shape("attributes contains a non-attribute node"))
        attr :: parse_name(field(attribute, "name") ?? return Err(XMLFault.shape("attribute lacks name"))) ?? return Err(err)
        resolved :: if attr.prefix == .Val(prefix) -> context.get(Val(prefix)) else -> None
        if resolved != attr.namespace_uri -> return Err(XMLFault.at_kind(0, Reason.Namespace, "attribute expanded name disagrees with namespace bindings"))
        if &expanded.insert(attr.namespace_uri, attr.local) -> return Err(XMLFault.at_kind(0, Reason.DuplicateAttribute, "duplicate expanded attribute name"))
