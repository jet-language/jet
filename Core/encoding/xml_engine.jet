fn render_element_open(value: DataTree, output: &String) String! {
    name :: field(value, "name") ?? return Err("XML element lacks name")
    raw_name :: required_text(name, "raw") ?? return Err(err)
    output += "<{raw_name}"
    namespaces :: array_value(field(value, "namespaces")) ?? return Err("XML namespaces must be an array")
    loop namespace in namespaces {
        output += " xmlns"
        prefix :: optional_text_field(namespace, "prefix") ?? return Err(err)
        if prefix == .Val(name) -> output += ":{name}"
        style :: required_text(namespace, "quote") ?? return Err(err)
        quote :: if style == "single" -> Char{39} else -> '"'
        uri :: required_text(namespace, "namespace_uri") ?? return Err(err)
        escaped :: escape_attribute(uri, quote)
        output += "={quote}{escaped}{quote}"
    }
    attributes :: array_value(field(value, "attributes")) ?? return Err("XML attributes must be an array")
    loop attribute in attributes {
        attribute_name :: field(attribute, "name") ?? return Err("XML attribute lacks name")
        raw_name :: required_text(attribute_name, "raw") ?? return Err(err)
        style :: required_text(attribute, "quote") ?? return Err(err)
        quote :: if style == "single" -> Char{39} else -> '"'
        output += " {raw_name}={quote}"
        normalized :: optional_text_field(attribute, "normalized_value") ?? return Err(err)
        if normalized == .Val(body) -> output += escape_attribute(body, quote)
        else {
            parts :: array_value(field(attribute, "parts")) ?? return Err("XML attribute parts must be an array")
            loop part in parts {
                kind :: required_text(part, "$xml") ?? return Err(err)
                rendered :: deterministic_leaf(part, kind) ?? return Err(err)
                output += rendered
            }
        }
        output += "{quote}"
    }
    style :: required_text(value, "empty_style") ?? return Err(err)
    if style == "empty" -> output += "/>" else -> output += ">"
}
    // Rust: crates/jet-foundation/src/XmlPull.rs:1702
    fn render_node(value: DataTree, output: &String) String! {
        kind :: required_text(value, "$xml") ?? return Err(err)
        if kind == "document" {
            children :: array_value(field(value, "children")) ?? return Err("XML document children must be an array")
            loop child in children -> render_node(child, &output) ?? return Err(err)
            return
        }
        if kind == "element" {
            name :: field(value, "name") ?? return Err("XML element lacks name")
            namespaces :: field(value, "namespaces") ?? return Err("XML element lacks namespaces")
            attributes :: field(value, "attributes") ?? return Err("XML element lacks attributes")
            style :: field(value, "empty_style") ?? return Err("XML element lacks empty_style")
            open_semantic :: strip_lexical(object([(key: "name", value: ~name), (key: "namespaces", value: ~namespaces), (key: "attributes", value: ~attributes), (key: "empty_style", value: ~style)]))
            if lexical_raw(value, "open_lexical", open_semantic) == .Val(raw) -> output += raw
            else -> render_element_open(value, &output) ?? return Err(err)
            children :: array_value(field(value, "children")) ?? return Err("XML element children must be an array")
            loop child in children -> render_node(child, &output) ?? return Err(err)
            close_semantic :: object([(key: "name", value: ~name)])
            if lexical_raw(value, "close_lexical", close_semantic) == .Val(raw) -> output += raw
            else if style == (DataTree.Text("explicit")) {
                raw_name :: required_text(name, "raw") ?? return Err(err)
                output += "</{raw_name}>"
            }
            return
        }
        semantic :: strip_lexical(value)
        if lexical_raw(value, "lexical", semantic) == .Val(raw) -> output += raw
        else {
            rendered :: deterministic_leaf(value, kind) ?? return Err(err)
            output += rendered
        }
    }
