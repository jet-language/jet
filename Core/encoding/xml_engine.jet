fn normalize_lines(value: String) -> String Never! {
    cr :: "{Char{13}}"
    value.replace("{cr}\n", "\n").replace(cr, "\n")
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2697
fn canonical_text_escape(value: String) -> String Never! {
    normalize_lines(value).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
