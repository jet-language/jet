// Rust: crates/jet-foundation/src/XmlPull.rs:2351
fn source_encoding_matches(source: String?, bom: [U8], target: RenderEncoding) -> Bool Never! {
    if target == {
        .UTF8 -> (source ?? "") == "UTF-8" && bom.is_empty()
        .UTF8Bom -> (source ?? "") == "UTF-8" && bom == [U8]{U8{0xef}, U8{0xbb}, U8{0xbf}}
        .Utf16Le -> (source ?? "") == "UTF-16LE" && bom == [U8]{U8{0xff}, U8{0xfe}}
        .Utf16Be -> (source ?? "") == "UTF-16BE" && bom == [U8]{U8{0xfe}, U8{0xff}}
    }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2360
fn target_bom(target: RenderEncoding) -> [U8] Never! {
    if target == {
        .UTF8 -> [U8]{}
        .UTF8Bom -> [U8]{U8{0xef}, U8{0xbb}, U8{0xbf}}
        .Utf16Le -> [U8]{U8{0xff}, U8{0xfe}}
        .Utf16Be -> [U8]{U8{0xfe}, U8{0xff}}
    }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2368
fn encoding_declaration(target: RenderEncoding) -> String Never! {
    if target == {
        .UTF8 | .UTF8Bom -> "UTF-8"
        .Utf16Le | .Utf16Be -> "UTF-16"
    }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2374
fn validate_declared_encoding(name: String, target: RenderEncoding) XMLFault! {
    ok :: if target == {
        .UTF8 | .UTF8Bom -> ascii_equal(name, "UTF-8")
        .Utf16Le | .Utf16Be -> ascii_equal(name, "UTF-16") || ascii_equal(name, "UTF-16LE") || ascii_equal(name, "UTF-16BE")
    }
    if !ok -> return Err(XMLFault.at_kind(0, Reason.InvalidEncoding, "XML declaration conflicts with selected output encoding"))
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2393
fn encode_text(value: String, target: RenderEncoding) -> [U8] Never! {
    if target == RenderEncoding.UTF8 || target == RenderEncoding.UTF8Bom -> return value.bytes()
    output := [U8]{}
    loop scalar in value.chars() {
        code :: Int{scalar}
        if code < 0x10000 -> utf16_word(&output, code, target == RenderEncoding.Utf16Le)
        else {
            utf16_word(&output, 0xd800 + (code - 0x10000) / 1024, target == RenderEncoding.Utf16Le)
            utf16_word(&output, 0xdc00 + (code - 0x10000) % 1024, target == RenderEncoding.Utf16Le)
        }
    }
    ^output
}
fn utf16_word(output: &[U8], word: Int, little: Bool) Never! {
    if little {
        &output.push(U8{word % 256})
        &output.push(U8{word / 256})
    } else {
        &output.push(U8{word / 256})
        &output.push(U8{word % 256})
    }
}
fn ascii_equal(left: String, right: String) -> Bool Never! {
    if left.len() != right.len() -> return false
    a :: left.chars()
    b :: right.chars()
    loop index in 0..<a.len() {
        x := Int{a[index]}
        y := Int{b[index]}
        if x >= 65 && x <= 90 -> x += 32
        if y >= 65 && y <= 90 -> y += 32
        if x != y -> return false
    }
    true
}
