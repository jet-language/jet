    resolved :: context.get(name.prefix)
    if resolved != name.namespace_uri -> return Err(XMLFault.at_kind(0, Reason.Namespace, "element expanded name disagrees with namespace bindings"))
    attributes :: array_value(field(event, "attributes")) ?? return Err(XMLFault.shape("element attributes must be an Array"))
    expanded := ExpandedNames.new()
    loop attribute in attributes {
