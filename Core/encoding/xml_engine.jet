            (key: "namespaces", value: field(value, "namespaces") ?? return None),
            (key: "attributes", value: field(value, "attributes") ?? return None),
            (key: "empty_style", value: field(value, "empty_style") ?? return None)])))
    }
    if key == "close_lexical" && ((whole_kind ?? "") == "element" || (event_kind ?? "") == "element_end") {
        return Val(object([(key: "name", value: field(value, "name") ?? return None)]))
    }
    if key != "lexical" -> return None
    legal :: ["document_whitespace", "declaration", "doctype", "namespace", "attribute", "text", "cdata", "entity_ref", "comment", "processing_instruction"]
    if whole_kind == .Val(kind) {
        if !legal.contains(kind) -> return None
        semantic := strip_lexical(value)
