            fields := [(key: String, value: DataTree)]{}
            loop entry in stream.object_entries(semantic) {
                if entry.key != "$xml" -> &fields.push((key: ~entry.key, value: ~entry.value))
            }
            semantic = object(^fields)
        }
        return Val(^semantic)
    }
    kind :: event_kind ?? return None
    if kind == "namespace" || kind == "attribute" || !legal.contains(kind) -> return None
    out := [(key: String, value: DataTree)]{}
    loop entry in stream.object_entries(value) {
        if entry.key != "$xml_event" && entry.key != "lexical" && entry.key != "open_lexical" && entry.key != "close_lexical" -> &out.push((key: ~entry.key, value: strip_lexical(entry.value)))
    }
    Val(object(^out))
