fn document_root(document: DataTree) -> DataTree XMLFault! {
    if xml_tag_of(document) != Val("document") -> return Err(projection_err("$", "XML root expects a document node"))
    content :: field(document, "children") ?? return Err(projection_err("$", "XML document children missing"))
