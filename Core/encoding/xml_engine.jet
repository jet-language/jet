// Rust: crates/jet-foundation/src/XmlPull.rs:2408
 struct CanonicalOptions {  mode: CanonicalMode,  comments: Bool,  inclusive_prefixes: [String] }
// Rust: crates/jet-foundation/src/XmlPull.rs:2416
 fn canonical_document(value: DataTree, options: CanonicalOptions) -> String XMLFault! {
    if options.mode == CanonicalMode.Inclusive11 && !options.inclusive_prefixes.is_empty() -> return Err(XMLFault.shape("inclusive_prefixes is legal only for Exclusive10"))
    kind :: required_text(value, "$xml") ?? return Err(XMLFault.shape(err))
    if kind != "document" -> return Err(XMLFault.shape("XML canonical input must be a document"))
    children :: array_value(field(value, "children")) ?? return Err(XMLFault.shape("XML document children must be an array"))
    roots := 0
    loop child in children {
        child_tag :: required_text(child, "$xml") ?? next
        if child_tag == "element" -> roots += 1
    }
    if roots != 1 -> return Err(XMLFault.shape("XML canonical input must contain exactly one root element"))
    output := ""
    root_seen := false
    base :: base_namespaces()
    rendered :: NamespaceScope.new()
    loop child in children {
        kind :: required_text(child, "$xml") ?? return Err(XMLFault.shape(err))
        if kind == {
            "declaration" | "doctype" | "document_whitespace" -> {}
            "element" -> {
                root_seen = true
                canonical_node(child, options, base, rendered, &output)
            }
            "comment" | "processing_instruction" -> {
                if kind == "comment" && !options.comments -> next
                if root_seen -> output += "\n"
                canonical_leaf(child, kind, &output) ?? return Err(err)
                if !root_seen -> output += "\n"
            }
            else -> return Err(XMLFault.shape("illegal node outside XML root element"))
        }
    }
    output
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2475
fn canonical_node(value: DataTree, options: CanonicalOptions, parent_scope: NamespaceScope, parent_rendered: NamespaceScope, output: &String) XMLFault! {
    kind :: required_text(value, "$xml") ?? return Err(XMLFault.shape(err))
    if kind != "element" -> return canonical_leaf(value, kind, output)
    name :: parse_name(field(value, "name") ?? return Err(XMLFault.shape("element lacks name")))
    scope := ~parent_scope
    namespaces :: array_value(field(value, "namespaces")) ?? return Err(XMLFault.shape("element namespaces must be an array"))
    loop namespace in namespaces {
        prefix :: optional_text_field(namespace, "prefix") ?? return Err(XMLFault.shape(err))
        uri :: required_text(namespace, "namespace_uri") ?? return Err(XMLFault.shape(err))
        if !uri.is_empty() && !uri.contains(":") -> return Err(XMLFault.at_kind(0, Reason.Namespace, "relative namespace URI cannot be canonicalized"))
        &scope.insert(prefix, ^uri)
    }
    if scope.get(name.prefix) != name.namespace_uri -> return Err(XMLFault.at_kind(0, Reason.Namespace, "element expanded name disagrees with namespace bindings"))
    attributes :: array_value(field(value, "attributes")) ?? return Err(XMLFault.shape("element attributes must be an array"))
    attrs := [CanonicalAttribute]{}
    visible := NamespaceSet.new()
    if name.prefix == .Val(prefix) {
        _ :: &visible.insert(Val(prefix))
    } else if name.namespace_uri != None {
        _ :: &visible.insert(None)
    }
    loop attribute in attributes {
        attr_name :: parse_name(field(attribute, "name") ?? return Err(XMLFault.shape("attribute lacks name")))
        if attr_name.prefix == .Val(prefix) -> _ :: &visible.insert(Val(prefix))
        resolved :: if attr_name.prefix == .Val(prefix) -> scope.get(Val(prefix)) else -> None
        if resolved != attr_name.namespace_uri -> return Err(XMLFault.at_kind(0, Reason.Namespace, "attribute expanded name disagrees with namespace bindings"))
        content :: canonical_attribute_value(attribute)
        attrs.push(CanonicalAttribute{namespace_uri: attr_name.namespace_uri ?? "", local: attr_name.local, raw: attr_name.raw, value: content})
    }
    loop prefix in options.inclusive_prefixes -> _ :: &visible.insert(if prefix == "#default" -> None else -> Val(prefix))
    declarations := [NamespaceBinding]{}
    keys :: scope.keys()
    loop prefix in keys {
        uri :: scope.get(prefix) ?? panic("namespace key without value")
        if (prefix ?? "") == "xml" -> next
        selected :: options.mode == CanonicalMode.Inclusive11 || visible.contains(prefix)
        if selected && parent_rendered.get(prefix) != Val(uri) -> declarations.push(NamespaceBinding{prefix: prefix, uri: uri})
    }
    &attrs.sort_by((a: CanonicalAttribute, b: CanonicalAttribute) -> if a.namespace_uri == b.namespace_uri -> a.local <=> b.local else -> a.namespace_uri <=> b.namespace_uri)
    output += "<{name.raw}"
    rendered := ~parent_rendered
    loop declaration in declarations {
        output += " xmlns"
        if declaration.prefix == .Val(p) -> output += ":{p}"
        output += "=\"{canonical_attr_escape(declaration.uri)}\""
        &rendered.insert(declaration.prefix, ~declaration.uri)
    }
    loop attribute in attrs -> output += " {attribute.raw}=\"{canonical_attr_escape(attribute.value)}\""
    output += ">"
    children :: array_value(field(value, "children")) ?? return Err(XMLFault.shape("element children must be an array"))
    loop child in children {
        kind :: required_text(child, "$xml") ?? return Err(XMLFault.shape(err))
        if kind == "comment" && !options.comments -> next
        canonical_node(child, options, scope, rendered, output)
    }
    output += "</{name.raw}>"
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2624
fn canonical_attribute_value(attribute: DataTree) -> String XMLFault! {
    normalized :: optional_text_field(attribute, "normalized_value") ?? return Err(XMLFault.shape(err))
    if normalized == .Val(content) -> return content
    parts :: array_value(field(attribute, "parts")) ?? return Err(XMLFault.shape("attribute parts must be an array"))
    output := ""
    loop part in parts {
        kind :: required_text(part, "$xml") ?? return Err(XMLFault.shape(err))
        if kind == {
            "text" -> { output += (required_text(part, "value") ?? return Err(XMLFault.shape(err))) }
            "entity_ref" -> {
                resolved :: optional_text_field(part, "resolved_value") ?? return Err(XMLFault.shape(err))
                output += resolved ?? return Err(XMLFault.at_kind(0, Reason.Canonicalization, "unresolved entity cannot be canonicalized"))
            }
            else -> return Err(XMLFault.shape("illegal XML attribute part"))
        }
    }
    output
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2652
fn canonical_leaf(value: DataTree, kind: String, output: &String) XMLFault! {
    if kind == {
        "text" | "cdata" -> {
            content :: required_text(value, "value") ?? return Err(XMLFault.shape(err))
            output += canonical_text_escape(content)
        }
        "entity_ref" -> {
            resolved :: optional_text_field(value, "resolved_value") ?? return Err(XMLFault.shape(err))
            content :: resolved ?? return Err(XMLFault.at_kind(0, Reason.Canonicalization, "unresolved entity cannot be canonicalized"))
            output += canonical_text_escape(content)
        }
        "comment" -> {
            content :: required_text(value, "value") ?? return Err(XMLFault.shape(err))
            output += "<!--{normalize_lines(content)}-->"
        }
        "processing_instruction" -> {
            target :: required_text(value, "target") ?? return Err(XMLFault.shape(err))
            content :: required_text(value, "value") ?? return Err(XMLFault.shape(err))
            body :: normalize_lines(content)
            output += "<?{target}"
            if !body.is_empty() -> output += " {body}"
            output += "?>"
        }
        else -> return Err(XMLFault.shape("unsupported canonical XML node {kind}"))
    }
}
