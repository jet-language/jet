fn deterministic_event_node(event: DataTree, kind: String) -> String XMLFault! {
    if event == .Object(_) {} else { return Err(XMLFault.shape("XML event must be an Object")) }
    fields := [(key: String, value: DataTree)]{(key: "$xml", value: text(kind))}
    loop entry in stream.object_entries(event) {
        if entry.key != "$xml_event" && entry.key != "lexical" && entry.key != "open_lexical" && entry.key != "close_lexical" -> &fields.push((key: ~entry.key, value: ~entry.value))
