                loop n in namespaces -> &ns.push(namespace_value(n))
                attrs := [DataTree]{}
                loop a in attributes -> &attrs.push(attribute_value(a))
                frame :: ElementFrame{name: ^name, namespaces: ^ns, attributes: ^attrs, children: [], open_raw: ^raw}
