// Rust: crates/jet-foundation/src/XmlPull.rs:2336
fn valid_event_raw_bytes(event: DataTree, kind: String) -> [U8]? Never! {
    key :: if kind == {
        "element_start" -> "open_lexical"
        "element_end" -> "close_lexical"
        "document_start" | "document_end" -> { return None }
        else -> "lexical"
