                        .Val(expected) -> lexical_evidence_matches(entry.value, expected)
                        .None -> false
                    }
                } else -> true
                item := clean(entry.value)
                if !trusted && item == .Object(_) {
                    fields := [(key: String, value: DataTree)]{}
                    loop slot in stream.object_entries(item) {
                        body :: if slot.key == "raw_text" || slot.key == "raw_bytes" -> DataTree.Null else -> ~slot.value
                        &fields.push((key: ~slot.key, value: body))
                    }
                    item = object(^fields)
                }
                &out.push((key: ~entry.key, value: item))
            }
            object(^out)
        }
        else -> ~value
    }
}
