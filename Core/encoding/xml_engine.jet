                    self.check_name(namespace.namespace_uri, "namespace URI") ?? return Err(err)
                }
                loop attribute in attributes {
                    self.check_name(attribute.name.raw, "attribute name") ?? return Err(err)
                    self.check_name(attribute.name.local, "attribute local name") ?? return Err(err)
                    if attribute.name.prefix == .Val(prefix) -> self.check_name(prefix, "attribute prefix") ?? return Err(err)
                    if attribute.name.namespace_uri == .Val(uri) -> self.check_name(uri, "attribute namespace URI") ?? return Err(err)
                    loop part in attribute.parts {
                        if part == .Text(value, _) -> self.charge_text(value.count_bytes(), "attribute text") ?? return Err(err)
                    }
                }
                self.charge_nodes(1 + namespaces.len() + attributes.len()) ?? return Err(err)
            }
            .Declaration(version, encoding, _, _) -> {
                self.check_name(version, "XML version") ?? return Err(err)
                if encoding == .Val(name) -> self.check_name(name, "XML encoding") ?? return Err(err)
                self.charge_nodes(1) ?? return Err(err)
            }
            .Doctype(name, public_id, system_id, internal_subset, _) -> {
                self.check_name(name, "DOCTYPE name") ?? return Err(err)
                if public_id == .Val(value) -> self.check_name(value, "DOCTYPE identifier") ?? return Err(err)
                if system_id == .Val(value) -> self.check_name(value, "DOCTYPE identifier") ?? return Err(err)
                if internal_subset == .Val(value) -> self.charge_text(value.count_bytes(), "DOCTYPE internal subset") ?? return Err(err)
                self.charge_nodes(1) ?? return Err(err)
            }
            .ProcessingInstruction(target, value, _) -> {
                self.check_name(target, "processing instruction target") ?? return Err(err)
                self.charge_text(value.count_bytes(), "processing instruction text") ?? return Err(err)
                self.charge_nodes(1) ?? return Err(err)
            }
            .DocumentWhitespace(value, _) | .Text(value, _) | .Cdata(value, _) | .Comment(value, _) -> {
                self.charge_text(value.count_bytes(), "text") ?? return Err(err)
                self.charge_nodes(1) ?? return Err(err)
            }
            .EntityRef(name, _, _) -> {
                self.check_name(name, "entity name") ?? return Err(err)
                self.charge_nodes(1) ?? return Err(err)
            }
        }
    }
    // Rust: crates/jet-foundation/src/XmlPull.rs:6482
    fn next_inner(self: &Scanner) -> Event? XMLFault! {
        if self.ended { return None }
        if !self.started {
            self.started = true
            return Val(Event.DocumentStart)
        }
        if self.offset == self.source.len() {
            if !self.stack.is_empty() { return self.fail("XML document ended before closing element") }
            if !self.root_seen { return self.fail("empty XML document") }
            self.ended = true
            return Val(Event.DocumentEnd)
        }
        if self.starts("<!--") {
            taken :: self.take_until("-->", "unterminated XML comment") ?? return Err(err)
            raw :: ^taken.raw
            value :: taken.body.slice(4, taken.body.len())
            if value.contains("--") { return self.fail("XML comment contains --") }
            return Val(Event.Comment(value: ^value, raw: ^raw))
        }
        if self.starts("<![CDATA[") {
            if self.stack.is_empty() { return self.fail("CDATA outside root element") }
            taken :: self.take_until("]]>", "unterminated CDATA") ?? return Err(err)
            return Val(Event.Cdata(value: taken.body.slice(9, taken.body.len()), raw: ^taken.raw))
        }
        if self.starts("<?xml") {
            if self.declaration_seen || self.root_seen || self.offset != 0 { return self.fail("XML declaration is out of order") }
            taken :: self.take_until("?>", "unterminated XML declaration") ?? return Err(err)
            raw :: ^taken.raw
            data :: taken.body.slice(5, taken.body.len()).trim()
            declaration :: declaration_fields(data) ?? return Err(err)
            version :: ^declaration.version
            encoding :: ^declaration.encoding
            standalone :: declaration.standalone
            if encoding == .Val(name) {
                if !declaration_matches_input(name, self.wire_encoding) {
                    return Err(XMLFault.at_kind(0, Reason.InvalidEncoding, "XML declaration conflicts with detected input encoding"))
                }
            }
            self.declaration_seen = true
            return Val(Event.Declaration(version: ^version, encoding: ^encoding, standalone: standalone, raw: ^raw))
        }
        if self.starts("<?") {
            taken :: self.take_until("?>", "unterminated processing instruction") ?? return Err(err)
            raw :: ^taken.raw
            data :: taken.body.slice(2, taken.body.len())
            bytes :: data.bytes()
            split :: whitespace_offset(bytes[0..<bytes.len()], 0)
            target :: byte_text(bytes[0..<bytes.len()], 0, split)
            if !valid_name(target) || ascii_equal(target, "xml") -> return self.fail("invalid processing instruction target")
            value :: byte_text(bytes[0..<bytes.len()], split, bytes.len()).trim_start()
            return Val(Event.ProcessingInstruction(target: ^target, value: ^value, raw: ^raw))
        }
        if self.starts("<!DOCTYPE") {
            if self.doctype_seen || self.root_seen { return self.fail("DOCTYPE is out of order") }
            start :: self.offset
            i := start + 9
            quote := Char?{None}
            bracket := I32{0}
            loop i < self.source.len() {
                character :: Char{Int{self.source[i]}}
                if quote == .Val(q) {
                    if character == q -> quote = None
                } else if character == (Char{39}) || character == '"' {
                    quote = Val(character)
                } else if character == '[' { bracket += 1
                } else if character == ']' { bracket -= 1
                } else if character == '>' && bracket == 0 { break }
                i += 1
            }
            if i == self.source.len() { return self.fail("unterminated DOCTYPE") }
            self.validate_characters(start, i + 1) ?? return Err(err)
            self.offset = i + 1
            raw :: byte_text(self.source[0..<self.source.len()], start, self.offset)
            inside :: byte_text(self.source[0..<self.source.len()], start + 9, i).trim()
            doctype :: doctype_fields(inside) ?? {
                error :: ^err
                return Err(XMLFault.at(start + 9 + error.offset, error.reason))
            }
            name :: ^doctype.name
            public_id :: ^doctype.public_id
            system_id :: ^doctype.system_id
            internal_subset :: ^doctype.internal_subset
            table :: declared_entity_table(internal_subset) ?? {
                error :: ^err
                mapped := XMLFault.at_kind(start + 9 + error.offset, error.kind, ~error.reason)
                mapped.path = ^error.path
                return Err(^mapped)
            }
            declared_entities :: ^table.names
            declaration_count :: table.count
            if declaration_count > self.options.limits.max_entity_declarations {
                return self.limit("XML document exceeds max_entity_declarations ({self.options.limits.max_entity_declarations})")
            }
            ordered := declared_entities.keys()
            &ordered.sort()
            loop entity_name in ordered -> self.check_name(entity_name, "entity name") ?? return Err(err)
            self.declared_entities = ^declared_entities
            self.doctype_seen = true
            return Val(Event.Doctype(name: ^name, public_id: ^public_id, system_id: ^system_id, internal_subset: ^internal_subset, raw: ^raw))
        }
        if self.starts("</") {
            start :: self.offset
            rel :: byte_find(self.source[0..<self.source.len()], start, [U8]{62}[0..<1]) ?? return self.fail("unterminated closing tag")
            self.validate_characters(start, start + rel + 1) ?? return Err(err)
            raw_name :: byte_text(self.source[0..<self.source.len()], start + 2, start + rel).trim()
            frame :: self.stack.last() ?? return Err(XMLFault.at(start, "closing tag without opener"))
            local :: [NamespaceBinding]{}
            name :: self.resolved_name(raw_name, local[0..<0], false) ?? return Err(err)
            if name.namespace_uri != frame.name.namespace_uri || name.local != frame.name.local {
                return self.fail("mismatched XML closing tag")
            }
            self.offset = start + rel + 1
            _ :: self.stack.pop()
            if self.stack.is_empty() { self.root_closed = true }
            return Val(Event.ElementEnd(name: ^name, raw: byte_text(self.source[0..<self.source.len()], start, self.offset)))
        }
        if self.starts("<") {
            if self.root_closed { return self.fail("multiple XML root elements") }
            event :: self.open() ?? return Err(err)
            return Val(^event)
        }
        if self.starts("&") {
            if self.stack.is_empty() { return self.fail("entity reference outside root element") }
            reference :: self.reference() ?? return Err(err)
            return Val(Event.EntityRef(name: ^reference.name, resolved: ^reference.resolved, raw: ^reference.raw))
        }
        start :: self.offset
        rel := 0
        loop start + rel < self.source.len() && self.source[start + rel] != (U8{60}) && self.source[start + rel] != (U8{38}) -> rel += 1
        self.validate_characters(start, start + rel) ?? return Err(err)
        self.offset += rel
        raw :: byte_text(self.source[0..<self.source.len()], start, self.offset)
        if self.stack.is_empty() {
            if !raw.chars().all(character -> character == ' ' || character == '\t' || character == (Char{13}) || character == '\n') {
                return self.fail("character data outside root element")
            }
            Val(Event.DocumentWhitespace(value: ~raw, raw: ^raw))
        } else {
            if raw.contains("]]>") { return self.fail("character data contains forbidden ]]>") }
            Val(Event.Text(value: ~raw, raw: ^raw))
        }
    }
    // Rust: crates/jet-foundation/src/XmlPull.rs:6686
     fn next(self: &Scanner) -> Event? XMLFault! {
        event :: &self.next_inner() ?? {
            error :: ^err
            located := ^error
            Scanner.classify(&located)
            return Err(located.located(self.source[0..<self.source.len()], self.path()))
        }
        if event == .Val(value) {
            self.charge_event(value) ?? {
                error :: ^err
                located := ^error
                Scanner.classify(&located)
                return Err(located.located(self.source[0..<self.source.len()], self.path()))
            }
            return Val(^value)
        }
        None
    }
}

#Test("XML namespace scope preserves default empty and named prefix ordering") {
    scope := NamespaceScope.new()
    &scope.insert(Val("z"), "named")
    &scope.insert(Val(""), "empty")
    &scope.insert(None, "default")
    assert_eq(scope.get(None), Val("default"))
    assert_eq(scope.get(Val("")), Val("empty"))
    assert_eq(scope.get(Val("z")), Val("named"))
    assert_eq(scope.keys(), [String?]{None, Val(""), Val("z")})
}

#Test("XML namespace set distinguishes default empty and named prefixes") {
    prefixes := NamespaceSet.new()
    assert(!&prefixes.insert(Val("z")))
    assert(!&prefixes.insert(Val("")))
    assert(!&prefixes.insert(None))
    assert(&prefixes.insert(None))
    assert(&prefixes.insert(Val("")))
    assert(&prefixes.insert(Val("z")))
    ordered := [String?]{None, Val(""), Val("z")}
    loop prefix in ordered -> assert(prefixes.contains(prefix))
    names := prefixes.named.keys()
    &names.sort()
    assert_eq(names, [String]{"", "z"})
}

#Test("XML expanded names distinguish absent empty and named namespace URIs") {
    names := ExpandedNames.new()
    assert(!&names.insert(Val("z"), "a"))
    assert(!&names.insert(Val(""), "a"))
    assert(!&names.insert(None, "a"))
    assert(&names.insert(None, "a"))
    assert(&names.insert(Val(""), "a"))
    assert(&names.insert(Val("z"), "a"))
    assert(!&names.insert(None, "b"))
    assert(!&names.insert(Val(""), "b"))
    assert(!&names.insert(Val("z"), "b"))
    uris := names.namespaced.keys()
    &uris.sort()
    assert_eq(uris, [String]{"", "z"})
}
