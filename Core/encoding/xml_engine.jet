            .Text(value, raw) -> Val(leaf("text", [(key: "value", value: text(value))], raw))
            .Cdata(value, raw) -> Val(leaf("cdata", [(key: "value", value: text(value))], raw))
            .EntityRef(name, resolved, raw) -> Val(leaf("entity_ref", [(key: "name", value: text(name)), (key: "resolved_value", value: optional_text(resolved))], raw))
            .Comment(value, raw) -> Val(leaf("comment", [(key: "value", value: text(value))], raw))
            .ProcessingInstruction(target, value, raw) -> Val(leaf("processing_instruction", [(key: "target", value: text(target)), (key: "value", value: text(value))], raw))
