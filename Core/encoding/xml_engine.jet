 fn render_document_bytes(value: DataTree, encoding: RenderEncoding, lexical: LexicalPolicy) -> [U8] XMLFault! {
    events :: unfold_events(value)
    writer := StreamWriter.new(encoding, lexical)
    output := [U8]{}
    loop event in events {
        bytes :: &writer.write(event)
        loop byte in bytes -> &output.push(byte)
    }
    output
}
