// Rust: crates/jet-foundation/src/XmlPull.rs:2065
fn exact_keys(value: DataTree, expected: [String]) XMLFault! {
    if value == .Object(_) {} else { return Err(XMLFault.shape("XML event must be an Object")) }
    entries :: stream.object_entries(value)
    if entries.len() != expected.len() -> return Err(XMLFault.shape("XML event has missing, duplicate, or unknown keys"))
    loop key in expected {
        count := 0
        loop entry in entries { if entry.key == key -> count += 1 }
        if count != 1 -> return Err(XMLFault.shape("XML event has missing, duplicate, or unknown keys"))
    }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2085
fn exact_leaf_keys(value: DataTree, kind: String) XMLFault! {
    if kind == {
        "text" | "cdata" | "comment" -> exact_keys(value, ["$xml_event", "value", "lexical"])
        "entity_ref" -> exact_keys(value, ["$xml_event", "name", "resolved_value", "lexical"])
        "processing_instruction" -> exact_keys(value, ["$xml_event", "target", "value", "lexical"])
        else -> return Err(XMLFault.shape("unknown XML leaf event"))
    }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2096
fn byte_array(value: DataTree) -> [U8] XMLFault! {
    values :: if value == {
        .Array(items) -> items
        else -> { return Err(XMLFault.shape("XML byte value must be an Array<Int>")) }
    }
    bytes := [U8]{}
    loop item in values {
        byte :: if item == {
            .Int(number) -> number
            else -> { return Err(XMLFault.shape("XML byte value must contain only Int")) }
        }
        if byte < 0 || byte > 255 -> return Err(XMLFault.shape("XML byte is outside 0..255"))
        &bytes.push(U8{byte})
    }
    bytes
}
