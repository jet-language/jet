    }
}
fn compare_prefixes(a: String?, b: String?) -> Ordering Never! {
    if a == {
        .None -> if b == .None -> Ordering.Equal else -> Ordering.Less
        .Val(left) -> if b == {
            .None -> Ordering.Greater
            .Val(right) -> left <=> right
        }
    }
}

// XmlPull.rs uses &str byte coordinates, not Jet's scalar String coordinates.
struct UTF8Scalar { value: Char, width: Int }
fn utf8_scalar(bytes: View<U8>, offset: Int) -> UTF8Scalar Never! {
    first :: Int{bytes[offset]}
    if first < 128 -> return UTF8Scalar{value: Char{first}, width: 1}
    if first < 224 -> return UTF8Scalar{
        value: Char{(first % 32) * 64 + Int{bytes[offset + 1]} % 64}, width: 2}
    if first < 240 -> return UTF8Scalar{
        value: Char{(first % 16) * 4096 + (Int{bytes[offset + 1]} % 64) * 64 + Int{bytes[offset + 2]} % 64}, width: 3}
    UTF8Scalar{
        value: Char{(first % 8) * 262144 + (Int{bytes[offset + 1]} % 64) * 4096 +
            (Int{bytes[offset + 2]} % 64) * 64 + Int{bytes[offset + 3]} % 64}, width: 4}
}
fn utf8_width(value: Char) -> Int Never! {
    scalar :: Int{value}
    if scalar < 128 -> 1 else if scalar < 2048 -> 2 else if scalar < 65536 -> 3 else -> 4
}
fn byte_prefix(bytes: View<U8>, start: Int, needle: View<U8>) -> Bool Never! {
    if start < 0 || needle.len() > bytes.len() - start -> return false
    loop index in 0..<needle.len() {
        if bytes[start + index] != needle[index] -> return false
    }
    true
}
fn byte_find(bytes: View<U8>, start: Int, needle: View<U8>) -> Int? Never! {
    last :: bytes.len() - needle.len()
    index := start
    loop index <= last {
        if byte_prefix(bytes, index, needle) -> return Val(index - start)
        index += 1
    }
    None
}
fn byte_text(bytes: View<U8>, start: Int, end: Int) -> String Never! {
    if start == end -> return ""
    owned := [U8]{}
    &owned.reserve(end - start)
    loop index in start..<end -> &owned.push(bytes[index])
    #Unsafe("the caller selected a scalar-aligned window of validated UTF-8 bytes") {
        return encoding.__bytes_into_text(^owned)
    }
}
fn scalar_count(bytes: View<U8>, end: Int) -> Int Never! {
    offset := 0
    count := 0
    loop offset < end {
        offset += utf8_scalar(bytes, offset).width
        count += 1
    }
    count
}


