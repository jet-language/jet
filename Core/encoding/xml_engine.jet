// Rust: crates/jet-foundation/src/XmlPull.rs:617
fn lexical_evidence_matches(lexical: DataTree, expected: DataTree) -> Bool Never! {
    if lexical == .Object(_) {} else { return false }
    entries :: stream.object_entries(lexical)
    if entries.len() != 3 || entries[0].key != "raw_text" || entries[1].key != "raw_bytes" || entries[2].key != "semantic" || !has_canonical_xml_shape(expected) -> return false
    semantic :: field(lexical, "semantic") ?? return false
    if !has_canonical_xml_shape(semantic) || semantic != expected -> return false
    raw_text :: field(lexical, "raw_text")
    raw_bytes :: field(lexical, "raw_bytes")
    if field_kind(raw_text) == "text" && field_kind(raw_bytes) == "null" -> return true
    if field_kind(raw_text) != "null" -> return false
    if field_kind(raw_bytes) == "null" -> return true
    if array_value(raw_bytes) == {
        .Val(bytes) -> bytes.all(byte -> if byte == .Int(value) -> value >= 0 && value <= 255 else -> false)
        .None -> false
    }
}
