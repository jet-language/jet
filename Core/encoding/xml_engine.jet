fn project_element_value(element: DataTree, path: String) -> DataTree XMLFault! {
    if xml_tag_of(element) != Val("element") -> return Err(projection_err(path, "Codable projection requires an element node"))
    attr_value :: field(element, "attributes") ?? return Err(projection_err(path, "XML element attributes missing"))
    attributes :: if attr_value == {
        .Array(items) -> items
        else -> { return Err(projection_err(path, "XML element attributes must be an array")) }
    }
    child_value :: field(element, "children") ?? return Err(projection_err(path, "XML element children missing"))
    children :: if child_value == {
        .Array(items) -> items
        else -> { return Err(projection_err(path, "XML element children must be an array")) }
    }
    entries := [(key: String, value: DataTree)]{}
    loop attribute in attributes {
        if xml_tag_of(attribute) != Val("attribute") -> return Err(projection_err(path, "XML attributes array must contain attribute nodes"))
        attr_name :: field(attribute, "name") ?? return Err(projection_err(path, "XML attribute name missing"))
        parts :: read_name_parts(attr_name, path)
        key :: "@{clark_key(parts.local, parts.namespace_uri)}"
        child_path :: if path == "$" -> key else -> "{path}.{key}"
        normalized :: optional_text_field(attribute, "normalized_value") ?? return Err(projection_err(child_path, err))
        content :: normalized ?? return Err(entity_err(child_path, "attribute has an unresolved entity"))
        &entries.push((key: key, value: DataTree.Text(content)))
    }
    if is_simple_content(children) {
        content := ""
        loop child in children -> content += text_like_chars(child) ?? return Err(entity_err(path, "simple content has an unresolved entity"))
        if entries.is_empty() -> return DataTree.Text(content)
        &entries.push((key: "$text", value: DataTree.Text(content)))
        return object(^entries)
    }
    child_keys := [(key: String, value: DataTree)]{}
    key_index := [String:Int]{}
    content := [DataTree]{}
    loop child in children {
        &content.push(~child)
        if xml_tag_of(child) != Val("element") -> next
        name :: field(child, "name") ?? return Err(projection_err(path, "XML child element name missing"))
        parts :: read_name_parts(name, path)
        key :: clark_key(parts.local, parts.namespace_uri)
        child_path :: if path == "$" -> key else -> "{path}.{key}"
        projected :: project_element_value(child, child_path)
        if key_index.get(key) == .Val(index) {
            prior := ^child_keys[index].value
            if prior == {
                .Array(items) -> {
                    values := ^items
                    &values.push(projected)
                    child_keys[index].value = DataTree.Array(^values)
                }
