        if kind != "namespace" -> return Err(XMLFault.shape("namespaces contains a non-namespace node"))
        prefix :: optional_text_field(namespace, "prefix") ?? return Err(XMLFault.shape(err))
        uri :: required_text(namespace, "namespace_uri") ?? return Err(XMLFault.shape(err))
        quote :: required_text(namespace, "quote") ?? return Err(XMLFault.shape(err))
        if quote != "single" && quote != "double" -> return Err(XMLFault.shape("namespace quote must be single or double"))
        if &declared.insert(prefix) -> return Err(XMLFault.at_kind(0, Reason.Namespace, "duplicate namespace prefix declaration"))
        &context.insert(prefix, ~uri)
