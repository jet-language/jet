        (key: "name", value: field(event, "name") ?? return Err(XMLFault.shape("element lacks name"))),
        (key: "namespaces", value: field(event, "namespaces") ?? return Err(XMLFault.shape("element lacks namespaces"))),
        (key: "attributes", value: field(event, "attributes") ?? return Err(XMLFault.shape("element lacks attributes"))),
