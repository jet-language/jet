fn parse_name(value: DataTree) -> Name XMLFault! {
    exact_keys(value, ["raw", "prefix", "local", "namespace_uri"])
    raw :: required_text(value, "raw") ?? return Err(XMLFault.shape(err))
    prefix :: optional_text_field(value, "prefix") ?? return Err(XMLFault.shape(err))
    local :: required_text(value, "local") ?? return Err(XMLFault.shape(err))
    namespace_uri :: optional_text_field(value, "namespace_uri") ?? return Err(XMLFault.shape(err))
    if !valid_name(raw) || !valid_name(local) || (prefix.map(p -> !valid_name(p)) ?? false) -> return Err(XMLFault.at_kind(0, Reason.InvalidName, "invalid XML expanded name"))
    expected :: if prefix == .Val(p) -> "{p}:{local}" else -> local
