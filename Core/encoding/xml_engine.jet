struct NamespaceScope { default_uri: String?, named: [String:String] }
impl NamespaceScope {
    fn new() -> NamespaceScope Never! {
        NamespaceScope{default_uri: None, named: [String:String]{}}
    }
    fn get(self: NamespaceScope, prefix: String?) -> String? Never! {
        if prefix == {
            .None -> ~self.default_uri
            .Val(key) -> self.named.get(key)
        }
    }
    fn insert(self: &NamespaceScope, prefix: String?, uri: ^String) Never! {
        if prefix == {
            .None -> self.default_uri = Val(^uri)
            .Val(key) -> self.named[~key] = ^uri
        }
    }
    fn keys(self: NamespaceScope) -> [String?] Never! {
        prefixes := [String?]{}
        &prefixes.reserve(self.named.len() + if self.default_uri == .None -> 0 else -> 1)
        if self.default_uri != .None -> &prefixes.push(None)
        loop (key, _) in self.named -> &prefixes.push(Val(~key))
        &prefixes.sort_by((a: String?, b: String?) -> compare_prefixes(a, b))
        ^prefixes
    }
}
struct NamespaceSet { default_present: Bool, named: [String:Bool] }
impl NamespaceSet {
    fn new() -> NamespaceSet Never! {
        NamespaceSet{default_present: false, named: [String:Bool]{}}
    }
    fn contains(self: NamespaceSet, prefix: String?) -> Bool Never! {
        if prefix == {
            .None -> self.default_present
            .Val(key) -> self.named.get(key) != .None
        }
    }
    fn insert(self: &NamespaceSet, prefix: String?) -> Bool Never! {
        prior :: self.contains(prefix)
        if prefix == {
            .None -> self.default_present = true
            .Val(key) -> self.named[~key] = true
        }
        prior
    }
}
struct ExpandedNames { no_namespace: [String:Bool], namespaced: [String:[String:Bool]] }
impl ExpandedNames {
    fn new() -> ExpandedNames Never! {
        ExpandedNames{no_namespace: [String:Bool]{}, namespaced: [String:[String:Bool]]{}}
    }
    fn insert(self: &ExpandedNames, namespace_uri: String?, local: String) -> Bool Never! {
        if namespace_uri == {
            .None -> {
                prior :: self.no_namespace.get(local) != .None
                self.no_namespace[~local] = true
                prior
            }
            .Val(uri) -> {
                if self.namespaced.get(uri) == .None -> self.namespaced[~uri] = [String:Bool]{}
                prior :: self.namespaced[uri].get(local) != .None
