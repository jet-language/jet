fn leaf(kind: String, fields: ^[(key: String, value: DataTree)], raw: String) -> DataTree Never! {
    semantic_fields := [(key: String, value: DataTree)]{(key: "$xml", value: text(kind))}
    loop entry in fields -> &semantic_fields.push(~entry)
