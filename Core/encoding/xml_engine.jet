fn clean(value: DataTree) -> DataTree Never! {
    if value == {
        .Array(values) -> {
            out := [DataTree]{}
            loop item in values -> &out.push(clean(item))
            DataTree.Array(^out)
        }
        .Object(_) -> {
            out := [(key: String, value: DataTree)]{}
            loop entry in stream.object_entries(value) {
                lexical :: entry.key == "lexical" || entry.key == "open_lexical" || entry.key == "close_lexical"
