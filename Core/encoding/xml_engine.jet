            "declaration" -> if has("lexical") -> ["$xml", "version", "encoding", "standalone", "lexical"] else -> ["$xml", "version", "encoding", "standalone"]
            "doctype" -> if has("lexical") -> ["$xml", "name", "public_id", "system_id", "internal_subset", "lexical"] else -> ["$xml", "name", "public_id", "system_id", "internal_subset"]
            "element" -> if has("open_lexical") -> ["$xml", "name", "namespaces", "attributes", "children", "empty_style", "open_lexical", "close_lexical"] else -> ["$xml", "name", "namespaces", "attributes", "children", "empty_style"]
            "namespace" -> if has("lexical") -> ["$xml", "prefix", "namespace_uri", "quote", "lexical"] else -> ["$xml", "prefix", "namespace_uri", "quote"]
            "attribute" -> if has("lexical") -> ["$xml", "name", "parts", "normalized_value", "quote", "lexical"] else -> ["$xml", "name", "parts", "normalized_value", "quote"]
            "text" | "cdata" | "comment" -> if has("lexical") -> ["$xml", "value", "lexical"] else -> ["$xml", "value"]
            "entity_ref" -> if has("lexical") -> ["$xml", "name", "resolved_value", "lexical"] else -> ["$xml", "name", "resolved_value"]
            "processing_instruction" -> if has("lexical") -> ["$xml", "target", "value", "lexical"] else -> ["$xml", "target", "value"]
