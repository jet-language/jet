        } else {
            key_index[key] = child_keys.len()
            &child_keys.push((key: key, value: projected))
        }
    }
    loop entry in child_keys -> &entries.push(^entry)
    &entries.push((key: "$content", value: DataTree.Array(^content)))
    object(^entries)
}
