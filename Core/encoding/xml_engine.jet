fn has_canonical_xml_object(value: DataTree) -> Bool Never! {
    if value == .Object(_) {} else { return false }
    entries :: stream.object_entries(value)
    order :: xml_schema_order(entries) ?? return false
    loop index in 0..<entries.len() { if entries[index].key != order[index] -> return false }
    xml_schema_types_are_valid(entries)
}
