            .Doctype(name, public_id, system_id, internal_subset, raw) -> Val(leaf("doctype", [(key: "name", value: text(name)), (key: "public_id", value: optional_text(public_id)), (key: "system_id", value: optional_text(system_id)), (key: "internal_subset", value: optional_text(internal_subset))], raw))
            .ElementStart(name, namespaces, attributes, empty, raw) -> {
