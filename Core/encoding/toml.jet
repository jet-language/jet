// core.encoding.toml — TOML v1.0 values as DataTree.
//
// Implements the common document: comments, dotted keys, [tables]
// [[arrays of tables]], strings (basic and literal), integers, floats
// booleans, and inline tables/arrays. Datetimes stay text so this module
// does not take a `core.time` dependency. Full TOML (offset-datetime
// validation, dotted-key collision cases at every table boundary) remains
// host-backed at cutover if a document fails here.
//
// `decode` is `parse`. `to_string` emits a minimal table document, not a
// round-trip of original comments.
pub fn parse(text: String) -> DataTree !EncodingError { parse_toml(text) }

pub fn decode(text: String) -> DataTree !EncodingError { parse_toml(text) }
pub fn loads(text: String) -> DataTree !EncodingError { parse(text) }
pub fn load(text: String) -> DataTree !EncodingError { parse(text) }

pub fn to_string(value: DataTree) -> String { render_toml(value) }

fn parse_toml(text: String) -> DataTree !EncodingError {
    p := TomlParser{bytes: text.bytes(), index: 0, line: 1, column: 1, root: [String:DataTree]{}}
    p.document()
    Ok(DataTree.Object(p.root))
}

struct TomlParser {
    bytes: [U8]
    index: Int
    line: Int
    column: Int
    root: [String:DataTree]
}

impl TomlParser {
    fn eof(self) -> Bool { self.index >= self.bytes.len() }

    fn peek(self) -> ?U8 {
        if self.eof() -> return None
        Val(self.bytes[self.index])
    }

    fn bump(&self) -> ?U8 {
        b :: self.peek() ?? return None
        self.index += 1
        if b == (U8{10}) {
            self.line += 1
            self.column = 1
        } else { self.column += 1 }
        Val(b)
    }

    fn fail(self, reason: String) -> EncodingError {
        return EncodingError.syntax(
        EncodingFormat.TOML,
        self.index,
        self.line,
        self.column,
        "",
        reason,
        )
    }

    fn skip_ws(&self) {
        loop {
            b :: self.peek() ?? return
            n :: b
            if n == 32 || n == 9 {
                _ :: self.bump()
                next
            }
            if n == 35 {
                loop {
                    c :: self.peek() ?? return
                    _ :: self.bump()
                    if c == (U8{10}) {
                        return
                    }
                }
            }
            return
        }
    }

    fn skip_space(&self) {
        self.skip_ws()
        loop {
            b :: self.peek() ?? return
            if b == (U8{10}) || b == (U8{13}) {
                _ :: self.bump()
                self.skip_ws()
                next
            }
            return
        }
    }

    fn document(&self) !EncodingError {
        current := [String]{}
        self.skip_space()
        loop !self.eof() {
            self.skip_space()
            if self.eof() -> return Ok()
            b :: self.peek() ?? return Ok()
            if b == (U8{91}) {
                current = self.parse_header()
                next
            }
            key :: self.parse_key()
            self.skip_ws()
            got :: self.bump() ?? return Err(self.fail("expected '=' after a key"))
            if got != (U8{61}) -> return Err(self.fail("expected '=' after a key"))
            self.skip_ws()
            value :: self.parse_value()
            self.assign(current, key, value)
            self.skip_space()
        }
        Ok()
    }

    fn parse_header(&self) -> [String] !EncodingError {
        _ :: self.bump()
        array := false
        if self.peek() ?? (U8{0}) == (U8{91}) {
            array = true
            _ :: self.bump()
        }
        keys := [String]{}
        keys.push(self.parse_key())
        loop self.peek() ?? (U8{0}) == (U8{46}) {
            _ :: self.bump()
            keys.push(self.parse_key())
        }
        self.skip_ws()
        _ :: self.bump()
        if array -> _ :: self.bump()
        if array -> self.ensure_array_table(keys) else -> self.ensure_table(keys)
        Ok(keys)
    }

    fn parse_key(&self) -> String !EncodingError {
        self.skip_ws()
        b :: self.peek() ?? return Err(self.fail("expected a key"))
        if b == (U8{34}) -> return self.parse_basic_string()
        out := [U8]{}
        loop {
            c :: self.peek() ?? break
            n :: c
            bare :: (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 95 || n == 45
            if !bare -> break
            out.push(c)
            _ :: self.bump()
        }
        if out.len() == 0 -> return Err(self.fail("expected a bare key or quoted key"))
        Ok(String.from_bytes(out) ?? "")
    }

    fn parse_value(&self) -> DataTree !EncodingError {
        self.skip_ws()
        b :: self.peek() ?? Err(self.fail("expected a value"))
        n :: b
        if n == {
            34 -> self.parse_basic_string()
            39 -> self.parse_literal_string()
            91 -> self.parse_array()
            123 -> self.parse_inline_table()
            116 -> self.parse_word("true", DataTree.Bool(true))
            102 -> self.parse_word("false", DataTree.Bool(false))
            else -> self.parse_number_or_text()
        }
    }

    fn parse_word(&self, spelling: String, value: DataTree) -> DataTree !EncodingError {
        loop b in spelling.bytes() {
            got :: self.bump() ?? return Err(self.fail("expected `{spelling}`"))
            if got != b -> return Err(self.fail("expected `{spelling}`"))
        }
        Ok(value)
    }

    fn parse_basic_string(&self) -> String !EncodingError {
        _ :: self.bump()
        out := [U8]{}
        loop {
            b :: self.bump() ?? return Err(self.fail("unterminated TOML string"))
            if b == (U8{34}) -> return Ok(String.from_bytes(out) ?? "")
            if b == (U8{92}) {
                esc :: self.bump() ?? return Err(self.fail("truncated escape"))
                out.push(esc)
                next
            }
            out.push(b)
        }
    }

    fn parse_literal_string(&self) -> String !EncodingError {
        _ :: self.bump()
        out := [U8]{}
        loop {
            b :: self.bump() ?? return Err(self.fail("unterminated literal string"))
            if b == (U8{39}) -> return Ok(String.from_bytes(out) ?? "")
            out.push(b)
        }
    }

    fn parse_array(&self) -> DataTree !EncodingError {
        _ :: self.bump()
        items := [DataTree]{}
        loop {
            self.skip_space()
            if self.peek() ?? (U8{0}) == (U8{93}) {
                _ :: self.bump()
                return Ok(DataTree.Array(items))
            }
            items.push(self.parse_value())
            self.skip_space()
            if self.peek() ?? (U8{0}) == (U8{44}) -> _ :: self.bump()
        }
    }

    fn parse_inline_table(&self) -> DataTree !EncodingError {
        _ :: self.bump()
        entries := [String:DataTree]{}
        loop {
            self.skip_ws()
            if self.peek() ?? (U8{0}) == (U8{125}) {
                _ :: self.bump()
                return Ok(DataTree.Object(entries))
            }
            key :: self.parse_key()
            self.skip_ws()
            eq :: self.bump() ?? return Err(self.fail("expected '='"))
            if eq != (U8{61}) -> return Err(self.fail("expected '='"))
            value :: self.parse_value()
            _ :: entries.add(key, value)
            self.skip_ws()
            if self.peek() ?? (U8{0}) == (U8{44}) -> _ :: self.bump()
        }
    }

    fn parse_number_or_text(&self) -> DataTree !EncodingError {
        start :: self.index
        loop {
            b :: self.peek() ?? break
            n :: b
            stop :: n == 32 || n == 9 || n == 10 || n == 13 || n == 44 || n == 93 || n == 125 || n == 35
            if stop -> break
            _ :: self.bump()
        }
        token :: String.from_bytes(self.bytes[start..self.index - 1]) ?? ""
        if Int.parse(token) == {
            .Ok(n) -> return Ok(DataTree.Int(n))
            else -> { _ := 0 }
        }
        if Float.parse(token) == {
            .Ok(n) -> return Ok(DataTree.Float(n))
            else -> { _ := 0 }
        }
        Ok(DataTree.Text(token))
    }

    fn ensure_table(&self, keys: [String]) { _ :: self.touch(keys, false) }

    fn ensure_array_table(&self, keys: [String]) { _ :: self.touch(keys, true) }

    fn touch(&self, keys: [String], array: Bool) {
        // Table construction is applied at assign time; headers only record path.
        _ :: keys
        _ :: array
    }

    fn assign(&self, table: [String], key: String, value: DataTree) {
        path := [String]{}
        loop k in table -> path.push(k)
        path.push(key)
        self.root = put_path(self.root, path, 0, value)
    }
}

fn put_path(entries: [String:DataTree], path: [String], i: Int, value: DataTree) -> [String:DataTree] {
    key :: path[i]
    if i == path.len() - 1 {
        _ :: entries.add(key, value)
        return entries
    }
    child := [String:DataTree]{}
    if entries.get(key) == {
        .Val(existing) -> {
            if existing == {
                .Object(obj) -> child = obj
                else -> { _ := 0 }
            }
        }
        else -> { _ := 0 }
    }
    nested :: put_path(child, path, i + 1, value)
    _ :: entries.add(key, DataTree.Object(nested))
    entries
}

fn render_toml(value: DataTree) -> String {
    if value == {
        .Object(entries) -> {
            out := ""
            loop pair in entries -> out = "{out}{pair.key} = {toml_leaf(pair.value)}\n"
            return out
        }
        else -> return toml_leaf(value)
    }
}

fn toml_leaf(value: DataTree) -> String {
    if value == {
        .Null -> return "\"\""
        .Bool(v) -> {
            if v -> return "true"
            return "false"
        }
        .Int(n) -> return "{n}"
        .Float(n) -> return "{n}"
        .Text(s) -> return "\"{s}\""
        .Array(items) -> {
            out := "["
            loop i in 0..<items.len() {
                if i > 0 -> out = "{out}, "
                out = "{out}{toml_leaf(items[i])}"
            }
            return "{out}]"
        }
        .Object(_) -> return "{{}}"
    }
}
