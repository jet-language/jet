// core.encoding.toml — TOML v1.0 values as DataTree.
//
// Implements the common document: comments, dotted keys, [tables]
// [[arrays of tables]], strings (basic and literal), integers, floats
// booleans, and inline tables/arrays. Datetimes stay text so this module
// does not take a `core.time` dependency. Unsupported TOML constructs fail
// closed with `EncodingError` rather than being delegated implicitly.
//
// `to_string` emits a minimal table document; it does not preserve comments.

use core.encoding.[DataTree, EncodingError, EncodingErrorKind, EncodingFormat]

fn syntax_error(format: EncodingFormat, offset: Int, line: Int, column: Int, path: String, reason: String) -> EncodingError Never! {
    {
        format: format,
        kind: EncodingErrorKind.Syntax,
        byte_offset: offset,
        line: Val(line),
        column: Val(column),
        path: path,
        reason: reason,
        cause: None,
    }
}
pub fn parse(text: String) -> DataTree EncodingError! { parse_toml(text) }

pub fn decode(text: String) -> DataTree EncodingError! { parse_toml(text) }
pub fn loads(text: String) -> DataTree EncodingError! { parse(text) }
pub fn load(text: String) -> DataTree EncodingError! { parse(text) }

pub fn to_string(value: DataTree) -> String Never! { render_toml(value) }

fn parse_toml(text: String) -> DataTree EncodingError! {
    p := TOMLParser{bytes: text.bytes(), index: 0, line: 1, column: 1, root: [String:DataTree]{}}
    _ :: &p.document() ?? return Err(p.fail("TOML document could not be parsed"))
    Ok(DataTree.Object(p.root))
}

struct TOMLParser {
    bytes: [U8]
    index: Int
    line: Int
    column: Int
    root: [String:DataTree]
}

impl TOMLParser {
    fn eof(self) -> Bool Never! { self.index >= self.bytes.len() }

    fn peek(self) -> U8? {
        if self.eof() -> return None
        Val(self.bytes[self.index])
    }

    fn bump(&self) -> U8? {
        b :: self.peek() ?? return None
        self.index += 1
        if b == (U8{10}) {
            self.line += 1
            self.column = 1
        } else { self.column += 1 }
        Val(b)
    }

    fn fail(self, reason: String) -> EncodingError Never! {
        return syntax_error(
        EncodingFormat.TOML,
        self.index,
        self.line,
        self.column,
        "",
        reason,
        )
    }

    fn skip_ws(&self) -> Bool EncodingError! {
        if self.index < 0 -> return Err(self.fail("TOML parser index became negative"))
        loop {
            if self.peek() == {
                .None -> return true
                .Val(b) -> {
                    n :: Int.from_u8(b)
                    if n == 32 || n == 9 {
                        self.index += 1
                        self.column += 1
                        next
                    }
                    if n == 35 {
                        loop {
                            if self.peek() == {
                                .None -> return true
                                .Val(c) -> {
                                    cn :: Int.from_u8(c)
                                    self.index += 1
                                    if cn == 10 {
                                        self.line += 1
                                        self.column = 1
                                        return true
                                    }
                                    self.column += 1
                                }
                            }
                        }
                    }
                    return true
                }
            }
        }
        true
    }

    fn skip_space(&self) -> Bool EncodingError! {
        &self.skip_ws() ?? return Err(self.fail("TOML whitespace scan failed"))
        loop {
            if self.peek() == {
                .None -> return true
                .Val(b) -> {
                    n :: Int.from_u8(b)
                    if n == 10 || n == 13 {
                        self.index += 1
                        self.line += 1
                        self.column = 1
                        &self.skip_ws() ?? return Err(self.fail("TOML whitespace scan failed"))
                        next
                    }
                    return true
                }
            }
        }
        true
    }

    fn document(&self) -> Bool EncodingError! {
        current := [String]{}
        &self.skip_space() ?? return Err(self.fail("TOML whitespace scan failed"))
        loop self.eof() == false {
            &self.skip_space() ?? return Err(self.fail("TOML whitespace scan failed"))
            if self.eof() -> return true
            b :: self.peek() ?? return true
            if b == (U8{91}) {
                header :: &self.parse_header()
                current = header
                next
            }
            keys :: &self.parse_dotted_key()
            &self.skip_ws() ?? return Err(self.fail("TOML whitespace scan failed"))
            got :: &self.bump() ?? return Err(self.fail("expected '=' after a key"))
            if got != (U8{61}) -> return Err(self.fail("expected '=' after a key"))
            &self.skip_ws() ?? return Err(self.fail("TOML whitespace scan failed"))
            value :: &self.parse_value()
            _ :: &self.assign(current, keys, value) ?? return Err(self.fail("TOML assignment failed"))
            &self.skip_space() ?? return Err(self.fail("TOML whitespace scan failed"))
        }
        true
    }

    fn parse_header(&self) -> [String] EncodingError! {
        _ :: &self.bump()
        array := false
        b0 :: self.peek() ?? (U8{0})
        if b0 == (U8{91}) {
            array = true
            _ :: &self.bump()
        }
        keys := [String]{}
        key :: &self.parse_key()
        &keys.push(key)
        loop {
            b :: self.peek() ?? (U8{0})
            if b != (U8{46}) -> break
            _ :: &self.bump()
            key2 :: &self.parse_key()
            &keys.push(key2)
        }
        &self.skip_ws() ?? return Err(self.fail("TOML whitespace scan failed"))
        close :: &self.bump() ?? return Err(self.fail("unterminated TOML table header"))
        if close != (U8{93}) -> return Err(self.fail("expected ']' after a TOML table header"))
        if array {
            close2 :: &self.bump() ?? return Err(self.fail("unterminated TOML array-of-tables header"))
            if close2 != (U8{93}) -> return Err(self.fail("expected ']]' after a TOML array-of-tables header"))
        }
        if array {
            self.root = ensure_array_path(self.root, keys, 0)
        } else {
            self.root = ensure_table_path(self.root, keys, 0)
        }
        Ok(keys)
    }

    fn parse_key(&self) -> String EncodingError! {
        &self.skip_ws() ?? return Err(self.fail("TOML whitespace scan failed"))
        b :: self.peek() ?? return Err(self.fail("expected a key"))
        if b == (U8{34}) -> return &self.parse_basic_string()
        out := [U8]{}
        loop {
            c :: self.peek() ?? break
            n :: c
            bare :: (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 95 || n == 45
            if bare == false -> break
            &out.push(c)
            _ :: &self.bump()
        }
        if out.len() == 0 -> return Err(self.fail("expected a bare key or quoted key"))
        Ok(String.from_bytes(out) ?? "")
    }

    fn parse_dotted_key(&self) -> [String] EncodingError! {
        keys := [String]{}
        key :: &self.parse_key()
        &keys.push(key)
        loop {
            b :: self.peek() ?? (U8{0})
            if b != (U8{46}) -> break
            _ :: &self.bump()
            next_key :: &self.parse_key()
            &keys.push(next_key)
        }
        Ok(keys)
    }

    fn parse_value(&self) -> DataTree EncodingError! {
        &self.skip_ws() ?? return Err(self.fail("TOML whitespace scan failed"))
        b :: self.peek() ?? return Err(self.fail("expected a value"))
        n :: b
        if n == 10 || n == 13 -> return Err(self.fail("expected a value before the end of the TOML line"))
        if n == {
            34 -> {
                s :: &self.parse_basic_string()
                return Ok(DataTree.Text(s))
            }
            39 -> {
                s :: &self.parse_literal_string()
                return Ok(DataTree.Text(s))
            }
            91 -> return &self.parse_array()
            123 -> return &self.parse_inline_table()
            116 -> return &self.parse_word("true", DataTree.Bool(true))
            102 -> return &self.parse_word("false", DataTree.Bool(false))
            else -> &self.parse_number_or_text()
        }
    }

    fn parse_word(&self, spelling: String, value: DataTree) -> DataTree EncodingError! {
        loop b in spelling.bytes() {
            got :: &self.bump() ?? return Err(self.fail("expected `{spelling}`"))
            if got != b -> return Err(self.fail("expected `{spelling}`"))
        }
        next :: self.peek() ?? (U8{0})
        n :: next
        if (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 95 || n == 45 {
            return Err(self.fail("TOML bare values must be delimited"))
        }
        Ok(value)
    }

    fn parse_basic_string(&self) -> String EncodingError! {
        _ :: &self.bump()
        out := [U8]{}
        loop {
            b :: &self.bump() ?? return Err(self.fail("unterminated TOML string"))
            if b == (U8{34}) {
                s :: String.from_bytes(out) ?? return Err(self.fail("invalid UTF-8 in TOML string"))
                return Ok(s)
            }
            if b == (U8{10}) || b == (U8{13}) -> return Err(self.fail("newline is not allowed in a basic TOML string"))
            if b == (U8{92}) {
                esc :: &self.bump() ?? return Err(self.fail("truncated escape"))
                if esc == (U8{98}) -> &out.push(U8{8})
                else if esc == (U8{116}) -> &out.push(U8{9})
                else if esc == (U8{110}) -> &out.push(U8{10})
                else if esc == (U8{102}) -> &out.push(U8{12})
                else if esc == (U8{114}) -> &out.push(U8{13})
                else if esc == (U8{34}) || esc == (U8{92}) -> &out.push(esc)
                else -> return Err(self.fail("unknown TOML basic-string escape"))
                next
            }
            &out.push(b)
        }
    }

    fn parse_literal_string(&self) -> String EncodingError! {
        _ :: &self.bump()
        out := [U8]{}
        loop {
            b :: &self.bump() ?? return Err(self.fail("unterminated literal string"))
            if b == (U8{39}) {
                s :: String.from_bytes(out) ?? return Err(self.fail("invalid UTF-8 in TOML string"))
                return Ok(s)
            }
            &out.push(b)
        }
    }

    fn parse_array(&self) -> DataTree EncodingError! {
        _ :: &self.bump()
        items := [DataTree]{}
        loop {
            &self.skip_space() ?? return Err(self.fail("TOML whitespace scan failed"))
            b0 :: self.peek() ?? (U8{0})
            if b0 == (U8{93}) {
                _ :: &self.bump()
                return Ok(DataTree.Array(items))
            }
            value :: &self.parse_value()
            &items.push(value)
            &self.skip_space() ?? return Err(self.fail("TOML whitespace scan failed"))
            b :: self.peek() ?? return Err(self.fail("unterminated TOML array"))
            if b == (U8{93}) {
                _ :: &self.bump()
                return Ok(DataTree.Array(items))
            }
            if b != (U8{44}) -> return Err(self.fail("expected ',' or ']' after a TOML array value"))
            _ :: &self.bump()
        }
    }

    fn parse_inline_table(&self) -> DataTree EncodingError! {
        _ :: &self.bump()
        entries := [String:DataTree]{}
        loop {
            &self.skip_ws() ?? return Err(self.fail("TOML whitespace scan failed"))
            b0 :: self.peek() ?? (U8{0})
            if b0 == (U8{125}) {
                _ :: &self.bump()
                return Ok(DataTree.Object(entries))
            }
            key :: &self.parse_key()
            if entries.has_key(key) -> return Err(self.fail("duplicate key in TOML inline table"))
            eq :: &self.bump() ?? return Err(self.fail("expected '='"))
            if eq != (U8{61}) -> return Err(self.fail("expected '='"))
            value :: &self.parse_value()
            _ :: &entries.add(key, value)
            &self.skip_ws() ?? return Err(self.fail("TOML whitespace scan failed"))
            b :: self.peek() ?? return Err(self.fail("unterminated TOML inline table"))
            if b == (U8{125}) {
                _ :: &self.bump()
                return Ok(DataTree.Object(entries))
            }
            if b != (U8{44}) -> return Err(self.fail("expected ',' or '}}' after a TOML inline-table value"))
            _ :: &self.bump()
        }
    }

    fn parse_number_or_text(&self) -> DataTree EncodingError! {
        start :: self.index
        loop {
            b :: self.peek() ?? break
            n :: b
            stop :: n == 32 || n == 9 || n == 10 || n == 13 || n == 44 || n == 93 || n == 125 || n == 35
            if stop -> break
            _ :: &self.bump()
        }
        if self.index <= start -> return Err(self.fail("expected a TOML value"))
        token :: String.from_bytes(self.bytes[start..self.index - 1]) ?? ""
        clean :: remove_underscores(token)
        if parse_radix_int(clean) == {
            .Val(n) -> return Ok(DataTree.Int(n))
            else -> { _ := 0 }
        }
        if Int.parse(clean) == {
            .Ok(n) -> return Ok(DataTree.Int(n))
            else -> { _ := 0 }
        }
        if Float.parse(clean) == {
            .Ok(n) -> return Ok(DataTree.Float(n))
            else -> { _ := 0 }
        }
        if looks_toml_datetime(clean) -> return Ok(DataTree.Text(token))
        return Err(self.fail("unsupported TOML bare value; quote text or use a TOML number, boolean, or datetime"))
    }

    fn ensure_table(&self, keys: [String]) {
        self.root = ensure_table_path(self.root, keys, 0)
    }

    fn ensure_array_table(&self, keys: [String]) {
        self.root = ensure_array_path(self.root, keys, 0)
    }

    fn assign(&self, table: [String], key: [String], value: DataTree) -> Bool EncodingError! {
        path := [String]{}
        loop k in table -> &path.push(k)
        loop k in key -> &path.push(k)
        if has_path(self.root, path, 0) -> return Err(self.fail("duplicate TOML key"))
        self.root = put_path(self.root, path, 0, value)
        true
    }
}

fn remove_underscores(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        if b != (U8{95}) -> &out.push(b)
    }
    String.from_bytes(out) ?? text
}

fn looks_toml_datetime(text: String) -> Bool Never! {
    raw :: text.bytes()
    if valid_toml_date(raw, 0, raw.len()) -> return true
    if valid_toml_time(raw, 0, raw.len()) -> return true
    if raw.len() < 19 || !valid_toml_date(raw, 0, 10) -> return false
    if raw[10] != (U8{84}) && raw[10] != (U8{116}) -> return false

    time_end := 19
    if raw.len() > time_end && raw[time_end] == (U8{46}) {
        time_end += 1
        fraction_start := time_end
        loop time_end < raw.len() {
            n :: raw[time_end]
            if n < 48 || n > 57 -> break
            time_end += 1
        }
        if time_end == fraction_start -> return false
    }
    if !valid_toml_time(raw, 11, time_end) -> return false
    if time_end == raw.len() -> return true
    if time_end + 1 == raw.len() && raw[time_end] == (U8{90}) -> return true
    if time_end + 6 != raw.len() || (raw[time_end] != (U8{43}) && raw[time_end] != (U8{45})) || raw[time_end + 3] != (U8{58}) {
        return false
    }
    hour :: toml_two_digits(raw, time_end + 1, raw.len()) ?? return false
    minute :: toml_two_digits(raw, time_end + 4, raw.len()) ?? return false
    hour <= 23 && minute <= 59
}

fn valid_toml_date(raw: [U8], start: Int, end: Int) -> Bool Never! {
    if start < 0 || end > raw.len() || start + 10 != end -> return false
    if raw[start + 4] != (U8{45}) || raw[start + 7] != (U8{45}) -> return false
    year :: toml_four_digits(raw, start, end) ?? return false
    month :: toml_two_digits(raw, start + 5, end) ?? return false
    day :: toml_two_digits(raw, start + 8, end) ?? return false
    if month < 1 || month > 12 || day < 1 -> return false
    max_day := 31
    if month == 4 || month == 6 || month == 9 || month == 11 -> max_day = 30
    if month == 2 {
        max_day = 28
        if year %% 4 == 0 && (year %% 100 != 0 || year %% 400 == 0) -> max_day = 29
    }
    day <= max_day
}

fn valid_toml_time(raw: [U8], start: Int, end: Int) -> Bool Never! {
    if start < 0 || end > raw.len() || start + 8 > end -> return false
    if raw[start + 2] != (U8{58}) || raw[start + 5] != (U8{58}) -> return false
    hour :: toml_two_digits(raw, start, end) ?? return false
    minute :: toml_two_digits(raw, start + 3, end) ?? return false
    second :: toml_two_digits(raw, start + 6, end) ?? return false
    if hour > 23 || minute > 59 || second > 59 -> return false
    if start + 8 == end -> return true
    if raw[start + 8] != (U8{46}) || start + 9 >= end -> return false
    loop i in (start + 9)..<end {
        if raw[i] < 48 || raw[i] > 57 -> return false
    }
    true
}

fn toml_two_digits(raw: [U8], start: Int, end: Int) -> Int? {
    if start < 0 || end > raw.len() || start + 2 > end -> return None
    a :: Int.from_u8(raw[start])
    b :: Int.from_u8(raw[start + 1])
    if a < 48 || a > 57 || b < 48 || b > 57 -> return None
    Val((a - 48) * 10 + (b - 48))
}

fn toml_four_digits(raw: [U8], start: Int, end: Int) -> Int? {
    if start < 0 || end > raw.len() || start + 4 > end -> return None
    value := 0
    loop i in start..<(start + 4) {
        n :: raw[i]
        if n < 48 || n > 57 -> return None
        value = value * 10 + (n - 48)
    }
    Val(value)
}
fn parse_radix_int(text: String) -> Int? {
    raw :: text.bytes()
    if raw.len() < 3 -> return None
    sign := 1
    start := 0
    if raw[0] == (U8{43}) || raw[0] == (U8{45}) {
        if raw[0] == (U8{45}) -> sign = -1
        start = 1
    }
    if start + 2 > raw.len() || raw[start] != (U8{48}) -> return None
    base := 0
    if raw[start + 1] == (U8{120}) -> base = 16
    if raw[start + 1] == (U8{111}) -> base = 8
    if raw[start + 1] == (U8{98}) -> base = 2
    if base == 0 -> return None
    if start + 2 >= raw.len() -> return None
    n := 0
    i := start + 2
    loop i < raw.len() {
        d :: radix_digit(raw[i], base)
        if d < 0 -> return None
        n = n * base + d
        i += 1
    }
    Val(sign * n)
}

fn radix_digit(b: U8, base: Int) -> Int Never! {
    n :: Int.from_u8(b)
    d := -1
    if n >= 48 && n <= 57 -> d = n - 48
    if n >= 65 && n <= 70 -> d = n - 55
    if n >= 97 && n <= 102 -> d = n - 87
    if d >= base -> return -1
    d
}

fn ensure_table_path(entries: [String:DataTree], path: [String], i: Int) -> [String:DataTree] Never! {
    if i >= path.len() -> return ~entries
    out := ~entries
    key :: path[i]
    if i == path.len() - 1 {
        if out.get(key) == .None -> _ :: &out.add(key, DataTree.Object([String:DataTree]{}))
        return out
    }
    child := [String:DataTree]{}
    existing_array := false
    array_items := [DataTree]{}
    if out.get(key) == {
        .Val(existing) -> {
            if existing == {
                .Object(obj) -> child = obj
                .Array(items) -> {
                    existing_array = true
                    if items.len() > 0 {
                        last_item :: items[items.len() - 1]
                        if last_item == {
                            .Object(obj) -> child = obj
                            else -> { _ := 0 }
                        }
                    }
                    array_items = ~items
                }
                else -> { _ := 0 }
            }
        }
        else -> { _ := 0 }
    }
    nested :: ensure_table_path(child, path, i + 1)
    if existing_array {
        if array_items.len() == 0 {
            &array_items.push(DataTree.Object(nested))
        } else {
            array_items[array_items.len() - 1] = DataTree.Object(nested)
        }
        _ :: &out.add(key, DataTree.Array(array_items))
    } else {
        _ :: &out.add(key, DataTree.Object(nested))
    }
    out
}

fn ensure_array_path(entries: [String:DataTree], path: [String], i: Int) -> [String:DataTree] Never! {
    if i >= path.len() -> return ~entries
    out := ~entries
    key :: path[i]
    if i == path.len() - 1 {
        item := DataTree.Object([String:DataTree]{})
        if out.get(key) == {
            .Val(existing) -> {
                if existing == {
                    .Array(items) -> {
                        mutable := ~items
                        &mutable.push(item)
                        _ :: &out.add(key, DataTree.Array(mutable))
                    }
                    .Object(obj) -> {
                        _ :: &out.add(key, DataTree.Array([DataTree]{DataTree.Object(obj), item}))
                    }
                    else -> _ :: &out.add(key, DataTree.Array([DataTree]{item}))
                }
            }
            else -> _ :: &out.add(key, DataTree.Array([DataTree]{item}))
        }
        return out
    }
    child := [String:DataTree]{}
    existing_array := false
    array_items := [DataTree]{}
    if out.get(key) == {
        .Val(existing) -> {
            if existing == {
                .Object(obj) -> child = obj
                .Array(items) -> {
                    existing_array = true
                    if items.len() > 0 {
                        last_item :: items[items.len() - 1]
                        if last_item == {
                            .Object(obj) -> child = obj
                            else -> { _ := 0 }
                        }
                    }
                    array_items = ~items
                }
                else -> { _ := 0 }
            }
        }
        else -> { _ := 0 }
    }
    nested :: ensure_array_path(child, path, i + 1)
    if existing_array {
        if array_items.len() == 0 {
            &array_items.push(DataTree.Object(nested))
        } else {
            array_items[array_items.len() - 1] = DataTree.Object(nested)
        }
        _ :: &out.add(key, DataTree.Array(array_items))
    } else {
        _ :: &out.add(key, DataTree.Object(nested))
    }
    out
}

fn has_path(entries: [String:DataTree], path: [String], i: Int) -> Bool Never! {
    if i >= path.len() -> return false
    key :: path[i]
    if i == path.len() - 1 -> return entries.has_key(key)
    child :: entries.get(key) ?? return false
    if child == {
        .Object(obj) -> return has_path(obj, path, i + 1)
        .Array(items) -> {
            if items.len() == 0 -> return false
            last :: items[items.len() - 1]
            if last == {
                .Object(obj) -> return has_path(obj, path, i + 1)
                else -> return false
            }
        }
        else -> return false
    }
}

fn put_path(entries: [String:DataTree], path: [String], i: Int, value: DataTree) -> [String:DataTree] Never! {
    out := ~entries
    key :: path[i]
    if i == path.len() - 1 {
        _ :: &out.add(key, value)
        return out
    }
    child := [String:DataTree]{}
    if out.get(key) == {
        .Val(existing) -> {
            if existing == {
                .Object(obj) -> child = obj
                .Array(items) -> {
                    if items.len() > 0 {
                        mutable := ~items
                        last_index := mutable.len() - 1
                        if mutable[last_index] == {
                            .Object(obj) -> {
                                nested :: put_path(obj, path, i + 1, value)
                                mutable[last_index] = DataTree.Object(nested)
                                _ :: &out.add(key, DataTree.Array(mutable))
                                return out
                            }
                            else -> { _ := 0 }
                        }
                    }
                }
                else -> { _ := 0 }
            }
        }
        else -> { _ := 0 }
    }
    nested :: put_path(child, path, i + 1, value)
    _ :: &out.add(key, DataTree.Object(nested))
    out
}

fn render_toml(value: DataTree) -> String {
    if value == {
        .Object(entries) -> return render_toml_table(entries, "")
        else -> return toml_leaf(value)
    }
}

fn render_toml_table(entries: [String:DataTree], prefix: String) -> String {
    out := ""
    loop pair in entries {
        if pair.value == {
            .Object(_) -> next
            .Array(items) -> {
                if all_objects(items) -> next
            }
            else -> { _ := 0 }
        }
        out = "{out}{toml_key(pair.key)} = {toml_leaf(pair.value)}\n"
    }
    loop pair in entries {
        if pair.value == {
            .Object(obj) -> {
                path :: join_key(prefix, pair.key)
                out = "{out}\n[{path}]\n{render_toml_table(obj, path)}"
            }
            .Array(items) -> {
                if all_objects(items) {
                    path :: join_key(prefix, pair.key)
                    loop item in items {
                        if item == {
                            .Object(obj) -> out = "{out}\n[[{path}]]\n{render_toml_table(obj, path)}"
                            else -> { _ := 0 }
                        }
                    }
                }
            }
            else -> { _ := 0 }
        }
    }
    out
}

fn all_objects(items: [DataTree]) -> Bool {
    if items.len() == 0 -> return false
    loop item in items {
        if item == {
            .Object(_) -> next
            else -> return false
        }
    }
    true
}

fn join_key(prefix: String, key: String) -> String {
    if prefix.len() == 0 -> return toml_key(key)
    "{prefix}.{toml_key(key)}"
}

fn toml_key(key: String) -> String {
    raw :: key.bytes()
    if raw.len() > 0 {
        valid := true
        loop b in raw {
            n :: b
            if !((n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 95 || n == 45) {
                valid = false
            }
        }
        if valid -> return ~key
    }
    toml_quote(key)
}

fn toml_quote(text: String) -> String {
    out := "\""
    loop b in text.bytes() {
        if b == (U8{92}) -> out = "{out}\\\\"
        else if b == (U8{34}) -> out = "{out}\\\""
        else if b == (U8{10}) -> out = "{out}\\n"
        else if b == (U8{13}) -> out = "{out}\\r"
        else if b == (U8{9}) -> out = "{out}\\t"
        else -> out = "{out}{String.from_bytes([U8]{b}) ?? ""}"
    }
    "{out}\""
}

fn toml_leaf(value: DataTree) -> String {
    if value == {
        .Null -> return "\"\""
        .Bool(v) -> {
            if v -> return "true"
            return "false"
        }
        .Int(n) -> return "{n}"
        .Float(n) -> return "{n}"
        .Text(s) -> return toml_quote(s)
        .Array(items) -> {
            out := "["
            loop i in 0..<items.len() {
                if i > 0 -> out = "{out}, "
                out = "{out}{toml_leaf(items[i])}"
            }
            return "{out}]"
        }
        .Object(_) -> return "{{}}"
    }
}
