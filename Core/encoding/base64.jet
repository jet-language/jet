// core.encoding.base64 — RFC 4648 §4 standard and §5 URL alphabets.
//
// Standard encoding is padded; URL encoding is unpadded. Decoding follows
// D-ENCBASE-STRICT1: edition 2027+ decoders are strict RFC 4648 (no
// whitespace, canonical padding, zero unused bits) and report
// `invalid <codec> at byte <N>: <reason>`; edition 2026 keeps the compatibility
// parser. Encoding, decoding, and alphabet transformations are pure Jet.
use core as core
use core.encoding.hex as hex
use core.encoding.base32 as base32
#Error
struct Base64Error {
    reason: String
    impl Display {
        fn display(self) -> String { self.reason }
    }
    impl Debug {
        fn debug(^self) -> String { self.reason }
    }
}

impl Base64Error {
    fn new(reason: String) -> Base64Error Never! { Base64Error{reason: reason} }
}

fn rewrap(reason: String) -> Base64Error Never! { Base64Error{reason: reason} }


fn u8_int(b: U8) -> Int Never! { Int.from_u8(b) }

fn encode(data: [U8]) -> String Never! {
    encode_alphabet(data, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", true)
}

fn encode_url(data: [U8]) -> String Never! {
    encode_alphabet(data, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_", false)
}

fn decode(text: String) -> [U8] Base64Error! {
    decode_for_edition(text, core.encoding.__edition(), false, false, false)
}

fn decode_url(text: String) -> [U8] Base64Error! {
    decode_for_edition(text, core.encoding.__edition(), true, false, false)
}

fn b64encode(data: [U8]) -> String Never! { encode(data) }
fn standard_b64encode(data: [U8]) -> String Never! { encode(data) }
fn urlsafe_b64encode(data: [U8]) -> String Never! { encode_url(data) }
fn b64decode(text: String) -> [U8] Base64Error! { decode(text) }
fn standard_b64decode(text: String) -> [U8] Base64Error! { decode(text) }
fn urlsafe_b64decode(text: String) -> [U8] Base64Error! { decode_url(text) }

fn b16encode(data: [U8]) -> String Never! { hex.encode_upper(data) }
fn b16decode(text: String) -> [U8] Base64Error! { decode_hex(text) }
fn b32encode(data: [U8]) -> String Never! { base32.encode(data) }
fn b32decode(text: String) -> [U8] Base64Error! { decode_base32(text) }
fn b32hexencode(data: [U8]) -> String Never! { base32.b32hexencode(data) }
fn b32hexdecode(text: String) -> [U8] Base64Error! { decode_base32hex(text) }

/// Adobe Ascii85 without optional `<~` framing.
fn a85encode(data: [U8]) -> String Never! { ascii85_encode(data) }
fn a85decode(text: String) -> [U8] Base64Error! { ascii85_decode(text) }

/// RFC 1924 Base85.
fn b85encode(data: [U8]) -> String Base64Error! { base85_encode(data, C_B85_ALPHABET, false) }
fn b85decode(text: String) -> [U8] Base64Error! { base85_decode(text, C_B85_ALPHABET, false) }

/// ZeroMQ Z85. Z85 intentionally requires complete 4-byte/5-character
/// quanta; silently padding a key would change its value.
fn z85encode(data: [U8]) -> String Base64Error! { base85_encode(data, C_Z85_ALPHABET, true) }
fn z85decode(text: String) -> [U8] Base64Error! { base85_decode(text, C_Z85_ALPHABET, true) }

fn encodebytes(data: [U8]) -> String Never! {
    encoded :: encode(data).bytes()
    out := [U8]{}
    loop i in 0..<encoded.len() {
        &out.push(encoded[i])
        if (i + 1) %% 76 == 0 || i + 1 == encoded.len() -> &out.push(U8{10})
    }
    String.from_bytes(out) ?? ""
}

fn decodebytes(text: String) -> [U8] Base64Error! {
    decode_for_edition(text, core.encoding.__edition(), false, true, false)
}

fn b2a_base64(data: [U8]) -> String Never! { "{encode(data)}\n" }
fn a2b_base64(text: String) -> [U8] Base64Error! { decodebytes(text) }
fn decode_hex(text: String) -> [U8] Base64Error! {
    if hex.decode(text) == {
        .Ok(value) -> return Ok(value)
        .Err(_) -> return Err(rewrap("invalid Base16 input"))
    }
}

fn decode_base32(text: String) -> [U8] Base64Error! {
    if base32.decode(text) == {
        .Ok(value) -> return Ok(value)
        .Err(_) -> return Err(rewrap("invalid Base32 input"))
    }
}

fn decode_base32hex(text: String) -> [U8] Base64Error! {
    if base32.b32hexdecode(text) == {
        .Ok(value) -> return Ok(value)
        .Err(_) -> return Err(rewrap("invalid Base32hex input"))
    }
}

fn encode_url_padded(data: [U8]) -> String Never! {
    encode_alphabet(data, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_", true)
}

fn decode_padded(text: String) -> [U8] Base64Error! { decode(text) }

fn pad(text: String) -> String Never! {
    remainder :: text.bytes().len() %% 4
    if remainder == 0 -> return text.copy()
    out := text.copy()
    loop _ in 0..<(4 - remainder) -> out = "{out}="
    out
}

fn unpad(text: String) -> String Never! {
    raw :: text.bytes()
    end := raw.len()
    loop end > 0 && raw[end - 1] == (U8{61}) -> end -= 1
    String.from_bytes(raw[0..<end]) ?? ""
}

fn is_base64(text: String) -> Bool Never! {
    decode(text) == .Ok(_)
}

C_B85_ALPHABET :: "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz!#$%&()*+-;<=>?@^_`{{|}}~"
C_Z85_ALPHABET :: "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.-:+=^!/*?&<>()[]{{}}@%$#"

fn ascii85_encode(data: [U8]) -> String {
    out := [U8]{}
    i := 0
    loop i < data.len() {
        remain :: data.len() - i
        width := remain
        if width > 4 -> width = 4
        a :: u8_int(data[i])
        b :: if width > 1 -> u8_int(data[i + 1]) else -> 0
        c :: if width > 2 -> u8_int(data[i + 2]) else -> 0
        d :: if width > 3 -> u8_int(data[i + 3]) else -> 0
        n :: ((((a << 24)).bit_or((b << 16))).bit_or((c << 8))).bit_or(d)
        if width == 4 && n == 0 {
            &out.push(U8{122})
        } else {
            digits := [U8]{}
            v := n
            loop _ in 0..<5 {
                &digits.push(U8{33 + (v %% 85)})
                v = v /% 85
            }
            k := digits.len()
            loop k > 0 {
                k -= 1
                if width == 4 || k >= 5 - (width + 1) -> &out.push(digits[k])
            }
        }
        i += width
    }
    String.from_bytes(out) ?? ""
}

fn ascii85_decode(text: String) -> [U8] Base64Error! {
    raw :: text.bytes()
    out := [U8]{}
    group := [Int]{}
    loop b in raw {
        n :: u8_int(b)
        if n == 122 {
            if group.len() != 0 -> return Err(rewrap("invalid Ascii85 `z` shorthand inside a quantum"))
            &out.push(U8{0})
            &out.push(U8{0})
            &out.push(U8{0})
            &out.push(U8{0})
            next
        }
        if n < 33 || n > 117 -> return Err(rewrap("invalid Ascii85 character"))
        &group.push(n - 33)
        if group.len() == 5 {
            value := 0
            loop d in group -> value = value * 85 + d
            if value > 4294967295 -> return Err(rewrap("invalid Ascii85 quantum; encoded value exceeds four bytes"))
            &out.push(to_u8(value >> 24))
            &out.push(to_u8(value >> 16))
            &out.push(to_u8(value >> 8))
            &out.push(to_u8(value))
            group = [Int]{}
        }
    }
    if group.len() == 1 -> return Err(rewrap("invalid Ascii85 length; a final quantum needs at least two characters"))
    if group.len() > 1 {
        original :: group.len()
        loop group.len() < 5 -> &group.push(84)
        value := 0
        loop d in group -> value = value * 85 + d
        if value > 4294967295 -> return Err(rewrap("invalid Ascii85 quantum; encoded value exceeds four bytes"))
        loop j in 0..<(original - 1) -> &out.push(to_u8(value >> (24 - j * 8)))
    }
    Ok(out)
}

fn base85_encode(data: [U8], alphabet: String, require_full: Bool) -> String Base64Error! {
    if require_full && data.len() %% 4 != 0 -> return Err(rewrap("Z85 encoding requires a byte length divisible by four"))
    ab :: alphabet.bytes()
    out := [U8]{}
    i := 0
    loop i < data.len() {
        width := data.len() - i
        if width > 4 -> width = 4
        a :: u8_int(data[i])
        b :: if width > 1 -> u8_int(data[i + 1]) else -> 0
        c :: if width > 2 -> u8_int(data[i + 2]) else -> 0
        d :: if width > 3 -> u8_int(data[i + 3]) else -> 0
        value :: ((((a << 24)).bit_or((b << 16))).bit_or((c << 8))).bit_or(d)
        digits := [Int]{}
        v := value
        loop _ in 0..<5 {
            &digits.push(v %% 85)
            v = v /% 85
        }
        k := digits.len()
        loop k > 0 {
            k -= 1
            if width == 4 || k >= 5 - (width + 1) -> &out.push(ab[digits[k]])
        }
        i += width
    }
    String.from_bytes(out) ?? ""
}

fn base85_decode(text: String, alphabet: String, require_full: Bool) -> [U8] Base64Error! {
    raw :: text.bytes()
    if require_full && raw.len() %% 5 != 0 -> return Err(rewrap("Z85 decoding requires a character length divisible by five"))
    if !require_full && raw.len() %% 5 == 1 -> return Err(rewrap("invalid Base85 length; a final quantum needs at least two characters"))
    ab :: alphabet.bytes()
    table := [Int]{}
    loop _ in 0..<256 -> &table.push(-1)
    loop i in 0..<ab.len() -> table[u8_int(ab[i])] = i
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        remain :: raw.len() - i
        width := remain
        if width > 5 -> width = 5
        digits := [Int]{}
        loop j in 0..<width {
            v :: table[u8_int(raw[i + j])]
            if v < 0 -> return Err(rewrap("invalid Base85 character"))
            &digits.push(v)
        }
        original :: width
        loop digits.len() < 5 -> &digits.push(84)
        value := 0
        loop d in digits -> value = value * 85 + d
        if value > 4294967295 -> return Err(rewrap("invalid Base85 quantum; encoded value exceeds four bytes"))
        count := 4
        if original < 5 -> count = original - 1
        loop j in 0..<count -> &out.push(to_u8(value >> (24 - j * 8)))
        i += width
    }
    Ok(out)
}

/// Low byte of `n`. The mask runs in `Int`, so a wide value never reaches the
/// checked `U8{}` conversion.
fn to_u8(n: Int) -> U8 Never! {
    v :: (n).bit_and(255)
    (U8{v})
}

fn encode_alphabet(data: [U8], alphabet: String, padded: Bool) -> String Never! {
    chars :: alphabet.bytes()
    out := [U8]{}
    i := 0
    loop i < data.len() {
        remain :: data.len() - i
        a :: u8_int(data[i])
        b :: if remain > 1 -> u8_int(data[i + 1]) else -> 0
        c :: if remain > 2 -> u8_int(data[i + 2]) else -> 0
        &out.push(chars[a >> 2])
        &out.push(chars[((a.bit_and(3)) << 4).bit_or((b >> 4))])
        if remain > 1 -> &out.push(chars[((b.bit_and(15)) << 2).bit_or((c >> 6))]) else {
            if padded -> &out.push(U8{61})
        }
        if remain > 2 -> &out.push(chars[c.bit_and(63)]) else {
            if padded -> &out.push(U8{61})
        }
        i += 3
    }
    String.from_bytes(out) ?? ""
}

#Test("base64 encoder vectors") {
    assert(encode([U8]{}) == "")
    assert(encode("f".bytes()) == "Zg==")
    assert(encode("fo".bytes()) == "Zm8=")
    assert(encode("foo".bytes()) == "Zm9v")
    assert(encode_url([U8]{251, 255}) == "-_8")
    assert(encode_url_padded([U8]{251, 255}) == "-_8=")
    assert(encodebytes([U8]{}) == "")
    assert(encodebytes("foo".bytes()) == "Zm9v\n")
    assert(pad("Zg") == "Zg==")
    assert(unpad("Zg===") == "Zg")
}

fn alphabet_value(byte: U8, url: Bool) -> Int? Never! {
    n :: Int.from_u8(byte)
    if n >= 65 && n <= 90 -> return Val(n - 65)
    if n >= 97 && n <= 122 -> return Val(n - 97 + 26)
    if n >= 48 && n <= 57 -> return Val(n - 48 + 52)
    if n == (if url -> 45 else -> 43) -> return Val(62)
    if n == (if url -> 95 else -> 47) -> return Val(63)
    None
}

fn ascii_space(byte: U8) -> Bool Never! {
    n :: Int.from_u8(byte)
    n == 32 || (n >= 9 && n <= 13)
}

fn decode_error(url: Bool, offset: Int, reason: String) -> Base64Error Never! {
    kind :: if url -> "base64url" else -> "base64"
    rewrap("invalid {kind} at byte {offset}: {reason}")
}

fn invalid_byte(url: Bool, offset: Int, byte: U8) -> Base64Error Never! {
    alphabet :: if url -> "URL-safe base64" else -> "standard base64"
    digits :: "0123456789ABCDEF".bytes()
    n :: Int.from_u8(byte)
    pair :: String.from_bytes([U8]{digits[n >> 4], digits[n.bit_and(15)]}) ?? ""
    decode_error(url, offset, "byte 0x{pair} is not in the {alphabet} alphabet")
}

fn decode_for_edition(text: String, edition: Int, url: Bool, whitespace: Bool, relaxed: Bool) -> [U8] Base64Error! {
    if edition < 2027 -> return decode_compat(text, url)
    raw :: text.bytes()
    count := 0
    last := -1
    out := [U8]{}
    buffer := 0
    bits := 0
    padding := 0
    pad_start := -1
    loop i in 0..<raw.len() {
        b :: raw[i]
        if ascii_space(b) {
            if !whitespace -> return Err(decode_error(url, i, "ASCII whitespace is not allowed"))
            next
        }
        if b == (U8{61}) {
            if url && !relaxed -> return Err(decode_error(url, i, "padding is not allowed"))
            if pad_start < 0 -> pad_start = i
            padding += 1
            next
        }
        if pad_start >= 0 -> return Err(decode_error(url, i, "padding may appear only at the end"))
        value :: alphabet_value(b, url) ?? return Err(invalid_byte(url, i, b))
        count += 1
        last = i
        buffer = (buffer << 6).bit_or(value)
        bits += 6
        if bits >= 8 {
            bits -= 8
            &out.push(U8{(buffer >> bits).bit_and(255)})
        }
        buffer = buffer.bit_and(((1 << bits) - 1))
    }
    if count == 0 && padding == 0 -> return Ok(out)
    eof :: if pad_start >= 0 -> pad_start else -> last + 1
    missing_allowed :: if url -> !relaxed else -> relaxed
    remainder :: (count + padding) %% 4
    if remainder == 1 -> return Err(decode_error(url, eof, "encoded length cannot represent whole bytes"))
    if !missing_allowed && remainder != 0 -> return Err(decode_error(url, eof, "expected {4 - remainder} padding characters"))
    tail :: count %% 4
    if padding > 0 {
        if tail == 0 -> return Err(decode_error(url, pad_start, "unexpected padding"))
        expected :: if tail == 2 -> 2 else if tail == 3 -> 1 else -> 0
        if expected == 0 -> return Err(decode_error(url, pad_start, "expected 0 padding characters"))
        if padding > expected -> return Err(decode_error(url, pad_start, "unexpected padding"))
        if padding < expected -> return Err(decode_error(url, pad_start, "expected {expected} padding characters"))
    } else if !missing_allowed && tail != 0 {
        return Err(decode_error(url, eof, "expected {4 - tail} padding characters"))
    }
    if bits > 0 && buffer != 0 -> return Err(decode_error(url, last, "non-zero unused bits"))
    Ok(out)
}

// Edition 2026 is the union of the two historical engines, including their
// odd padding acceptance. Do not replace it with the stricter RFC policy.
fn compat_quanta(raw: [U8], padded: Bool) -> [U8]? Never! {
    if padded && raw.len() %% 4 != 0 -> return None
    if !padded && raw.len() %% 4 == 1 -> return None
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        width := raw.len() - i
        if width > 4 -> width = 4
        a :: alphabet_value(raw[i], false) ?? return None
        b := 0
        if width > 1 -> b = alphabet_value(raw[i + 1], false) ?? return None
        &out.push(U8{((a << 2).bit_or((b >> 4))).bit_and(255)})
        if width > 2 && (!padded || raw[i + 2] != (U8{61})) {
            c :: alphabet_value(raw[i + 2], false) ?? return None
            &out.push(U8{((b << 4).bit_or((c >> 2))).bit_and(255)})
            if width > 3 && (!padded || raw[i + 3] != (U8{61})) {
                d :: alphabet_value(raw[i + 3], false) ?? return None
                &out.push(U8{((c << 6).bit_or(d)).bit_and(255)})
            }
        }
        i += width
    }
    Val(out)
}

fn compat_space(byte: U8) -> Bool Never! {
    n :: Int.from_u8(byte)
    n == 32 || n == 9 || n == 10 || n == 12 || n == 13
}

fn decode_compat(text: String, url: Bool) -> [U8] Base64Error! {
    prepared := text
    if url {
        prepared = text.trim().replace("-", "+").replace("_", "/")
        loop prepared.bytes().len() %% 4 != 0 -> prepared = "{prepared}="
    }
    raw :: prepared.bytes()
    stripped := [U8]{}
    loop byte in raw {
        if !compat_space(byte) -> &stripped.push(byte)
    }
    aot :: compat_quanta(stripped, true)
    end := raw.len()
    loop end > 0 && raw[end - 1] == (U8{61}) -> end -= 1
    folded :: compat_quanta(raw[0..<end], false)
    if aot == .Val(a) && folded == .Val(b) {
        if a != b -> return Err(decode_error(url, text.bytes().len(), "historical decoders disagree"))
    }
    if aot == .Val(a) -> return Ok(a)
    if folded == .Val(b) -> return Ok(b)
    original :: text.bytes()
    loop i in 0..<original.len() {
        byte :: original[i]
        accepted :: alphabet_value(byte, false) != None || byte == (U8{61}) || compat_space(byte) || (url && (byte == (U8{45}) || byte == (U8{95})))
        if !accepted -> return Err(invalid_byte(url, i, byte))
    }
    loop i in 0..<original.len() {
        if original[i] != (U8{61}) -> next
        loop j in (i + 1)..<original.len() {
            if original[j] != (U8{61}) && !compat_space(original[j]) -> return Err(decode_error(url, i, "padding may appear only at the end"))
        }
        break
    }
    Err(decode_error(url, original.len(), "encoded length cannot represent whole bytes"))
}

#Test("base64 edition-selected decode policy") {
    assert_eq(decode_for_edition("Zg==", 2027, false, false, false), Ok("f".bytes()))
    assert_eq(decode_for_edition("Zg", 2026, false, false, false), Ok("f".bytes()))
    assert(decode_for_edition("Zg", 2027, false, false, false) == .Err(_))
    assert(decode_for_edition("Zh==", 2027, false, false, false) == .Err(_))
    assert(decode_for_edition("Zg==ignored", 2026, false, false, false) == .Err(_))
    assert_eq(decode_for_edition("Zg=*", 2026, false, false, false), Ok("f".bytes()))
    assert_eq(decode_for_edition("-_8", 2027, true, false, false), Ok([U8]{251, 255}))
    assert(decode_for_edition("-_8=", 2027, true, false, false) == .Err(_))
    assert_eq(decode_for_edition("Zg==\n", 2027, false, true, false), Ok("f".bytes()))
}
