// Rust: crates/jet-pkg-model/src/Prelude/HTTP.rs:1786
fn connect_plain(dns: Arc<Mutex<DNSCache>>, facts: Arc<ResponseFacts>, url: ParsedUrl, dns_timeout: Duration, timeout: Duration) -> TcpStream JetHTTPBridgeError! {
    last := JetHTTPBridgeError.Connect
    dns_started :: Instant.now()
    key :: (~url.host, url.port)
    cached :: dns.lock() ?? return Err(JetHTTPBridgeError.Internal)
    result_cached :: cached.get(key)
    drop(cached)
    cache_miss :: result_cached == None
    result := if result_cached == .Val(value) { value } else {
        (send, receive) :: mpsc.sync_channel(1) // GATE #4494
        target :: ~url
        _ :: thread.spawn(() -> {
            addresses := resolve(target)
            if addresses == .Ok(values) && values.is_empty() -> addresses = Err(JetHTTPBridgeError.Resolve)
            _ :: send.send(^addresses)
        })
        receive.recv_timeout(dns_timeout) ?? return Err(JetHTTPBridgeError.Timeout)
    }
    if cache_miss {
        guard :: dns.lock() ?? return Err(JetHTTPBridgeError.Internal)
        guard.put(^key, ~result)
    }
    set_timing(facts, 0, elapsed_ms(dns_started))
    addresses :: result ?? return Err(err)
    connect_started :: Instant.now()
    loop address in addresses {
        if TcpStream.connect_timeout(address, timeout) == {
            .Ok(stream) -> { set_timing(facts, 1, elapsed_ms(connect_started)); return stream }
            .Err(error) -> { last = if error.kind() == .TimedOut { JetHTTPBridgeError.Timeout } else { JetHTTPBridgeError.Connect } }
        }
    }
    set_timing(facts, 1, elapsed_ms(connect_started))
    Err(last)
}

// Rust: crates/jet-pkg-model/src/Prelude/HTTP.rs:1842
fn http_tls_pem_certificates(pem: [U8]) -> [[U8]] JetHTTPBridgeError! {
    BEGIN :: "-----BEGIN CERTIFICATE-----"
    END :: "-----END CERTIFICATE-----"
    text :: String.from_utf8(pem) ?? return Err(JetHTTPBridgeError.TLS)
    rest := text
    out := [[U8]]{}
    loop rest.find(BEGIN) == .Val(start) {
        prefix := rest[..<start].trim() // #4303
        if !prefix.is_empty() -> return Err(JetHTTPBridgeError.TLS)
        rest = rest[start + BEGIN.len()..]
        stop :: rest.find(END) ?? return Err(JetHTTPBridgeError.TLS)
        &out.push(http_tls_pem_base64(rest[..<stop]) ?? return Err(err))
        rest = rest[stop + END.len()..]
    }
    tail := rest.trim() // #4303
    if out.is_empty() || !tail.is_empty() -> return Err(JetHTTPBridgeError.TLS)
    out
}

// Rust: crates/jet-pkg-model/src/Prelude/HTTP.rs:1863
fn http_tls_private_key(pem: [U8]) -> tls_native.PrivateKeyDer JetHTTPBridgeError! {
    text :: String.from_utf8(pem) ?? return Err(JetHTTPBridgeError.TLS)
    parse :: (begin: String, end: String) -> [U8]? JetHTTPBridgeError! {
        start :: text.find(begin) ?? return None
        prefix := text[..<start].trim() // #4303
        if !prefix.is_empty() -> return Err(JetHTTPBridgeError.TLS)
        rest :: text[start + begin.len()..]
        stop :: rest.find(end) ?? return Err(JetHTTPBridgeError.TLS)
        tail := rest[stop + end.len()..].trim() // #4303
        if !tail.is_empty() -> return Err(JetHTTPBridgeError.TLS)
        Val(http_tls_pem_base64(rest[..<stop]) ?? return Err(err))
    }
    if (parse("-----BEGIN PRIVATE KEY-----", "-----END PRIVATE KEY-----") ?? return Err(err)) == .Val(der) -> return tls_native.PrivateKeyDer.Pkcs8(tls_native.PrivatePkcs8KeyDer.from(^der))
    if (parse("-----BEGIN RSA PRIVATE KEY-----", "-----END RSA PRIVATE KEY-----") ?? return Err(err)) == .Val(der) -> return tls_native.PrivateKeyDer.Pkcs1(tls_native.PrivatePkcs1KeyDer.from(^der))
    if (parse("-----BEGIN EC PRIVATE KEY-----", "-----END EC PRIVATE KEY-----") ?? return Err(err)) == .Val(der) -> return tls_native.PrivateKeyDer.Sec1(tls_native.PrivateSec1KeyDer.from(^der))
    Err(JetHTTPBridgeError.TLS)
}

// Rust: crates/jet-pkg-model/src/Prelude/HTTP.rs:1899
fn http_tls_pem_base64(text: String) -> [U8] JetHTTPBridgeError! {
    filtered :: text.bytes().filter((b) -> !b.is_ascii_whitespace()).collect()
    if filtered.len() % 4 != 0 -> return Err(JetHTTPBridgeError.TLS)
    out := [U8]{}
    i := 0
    loop i < filtered.len() {
        vals := [U8]{0, 0, 0, 0}
        pad := 0
        loop j in 0..<4 {
            byte :: filtered[i + j]
            if byte >= 65 && byte <= 90 { vals[j] = byte - 65 }
            else if byte >= 97 && byte <= 122 { vals[j] = byte - 97 + 26 }
            else if byte >= 48 && byte <= 57 { vals[j] = byte - 48 + 52 }
            else if byte == 43 { vals[j] = 62 }
            else if byte == 47 { vals[j] = 63 }
            else if byte == 61 { pad += 1; vals[j] = 0 }
            else { return Err(JetHTTPBridgeError.TLS) }
            if byte == 61 && j < 2 -> return Err(JetHTTPBridgeError.TLS)
        }
        if pad > 2 -> return Err(JetHTTPBridgeError.TLS)
        &out.push((vals[0] << 2) | (vals[1] >> 4))
        if pad < 2 -> &out.push(((vals[1] & 0x0f) << 4) | (vals[2] >> 2))
        if pad < 1 -> &out.push(((vals[2] & 0x03) << 6) | vals[3])
        i += 4
    }
    out
}

// Rust: crates/jet-pkg-model/src/Prelude/HTTP.rs:1942
fn tls_stream(tcp: TcpStream, host: String, timeout: Duration, http2: Bool, http11: Bool, tls: TLSSettings) -> HTTPStream JetHTTPBridgeError! {
    // GATE #4494: real native TLS roots, crypto and handshake provider, not Rust callbacks.
    static PROVIDER: Once = Once.new()
    PROVIDER.call_once(() -> { _ :: tls_native.crypto.ring.default_provider().install_default() })
    tcp.set_read_timeout(Val(timeout)) ?? return Err(JetHTTPBridgeError.TLS)
    tcp.set_write_timeout(Val(timeout)) ?? return Err(JetHTTPBridgeError.TLS)
    roots := tls_native.RootCertStore.empty()
    if tls.system_roots {
        native :: tls_native.load_native_certs() ?? return Err(JetHTTPBridgeError.TLS)
        loop cert in native -> roots.add(^cert) ?? return Err(JetHTTPBridgeError.TLS)
    }
    loop cert in tls.custom_roots -> roots.add(tls_native.CertificateDer.from(~cert)) ?? return Err(JetHTTPBridgeError.TLS)
    if roots.is_empty() -> return Err(JetHTTPBridgeError.TLS)
    if tls.min_version > tls.max_version || (tls.min_version != 12 && tls.min_version != 13) || (tls.max_version != 12 && tls.max_version != 13) -> return Err(JetHTTPBridgeError.TLS)
    versions :: if tls.min_version == 12 && tls.max_version == 12 { [tls_native.version.TLS12] }
        else if tls.min_version == 13 && tls.max_version == 13 { [tls_native.version.TLS13] }
        else { [tls_native.version.TLS13, tls_native.version.TLS12] }
    builder :: tls_native.ClientConfig.builder_with_protocol_versions(versions).with_root_certificates(^roots)
    config := if tls.identity_cert.is_empty() { builder.with_no_client_auth() } else {
        certs :: (http_tls_pem_certificates(tls.identity_cert) ?? return Err(err)).into_iter().map((cert) -> tls_native.CertificateDer.from(^cert)).collect()
        key :: http_tls_private_key(tls.identity_key) ?? return Err(err)
        builder.with_client_auth_cert(^certs, ^key) ?? return Err(JetHTTPBridgeError.TLS)
    }
    config.alpn_protocols = [[U8]]{}
    if http2 -> &config.alpn_protocols.push("h2".into_bytes())
    if http11 -> &config.alpn_protocols.push("http/1.1".into_bytes())
    name :: tls_native.ServerName.try_from(~host) ?? return Err(JetHTTPBridgeError.TLS)
    connection := tls_native.ClientConnection.new(Arc.new(^config), ^name) ?? return Err(JetHTTPBridgeError.TLS)
    loop connection.is_handshaking() -> connection.complete_io(&tcp) ?? return Err(JetHTTPBridgeError.TLS)
    selected :: connection.alpn_protocol().map((bytes) -> ~bytes)
    stream :: HTTPStream.TLS(Box.new(tls_native.StreamOwned.new(^connection, ^tcp)))
    if selected == .Val(protocol) {
        if protocol == "h2".as_bytes() && http2 -> return HTTPStream.H2(Arc.new(Mutex.new(H2Connection.new(^stream) ?? return Err(err))))
        if protocol == "http/1.1".as_bytes() && http11 -> return stream
    } else if http11 { return stream }
    Err(JetHTTPBridgeError.Protocol)
}

