pub fn jet_http_client_body_read_impl(handle: I64, max_chunk: USize) -> [U8]? JetHTTPBridgeError! {
    guard :: body_readers().lock() ?? return Err(JetHTTPBridgeError.Internal)
    reader :: guard.get(handle).cloned() ?? return Err(JetHTTPBridgeError.Internal)
    drop(guard)
    chunk := [U8].repeat(0, max_chunk.min(HTTP_RESPONSE_READ_CHUNK_LIMIT))
    locked :: reader.lock() ?? return Err(JetHTTPBridgeError.Internal)
    read :: locked.read(&chunk) ?? {
        // GATE #4409: preserve IO kind, not generic error collapse.
        return Err(if err.kind() == {
            .InvalidData -> JetHTTPBridgeError.InvalidFraming
            .TimedOut | .WouldBlock -> JetHTTPBridgeError.Timeout
            else -> JetHTTPBridgeError.IO
        })
    }
    drop(locked)
    if read == 0 {
        _ :: body_readers().lock().map((readers) -> readers.remove(handle))
        return None
    }
    &chunk.truncate(read)
    Val(^chunk)
}
