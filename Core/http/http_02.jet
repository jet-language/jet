// Rust: crates/jet-pkg-model/src/Prelude/HTTP.rs:2118
fn resolve_request_phase_timeouts(blanket_ms: I64?, connect_ms: I64?, read_ms: I64?, total_ms: I64?, dns_ms: I64?, tls_ms: I64?, write_ms: I64?, first_byte_ms: I64?, policy: ClientPolicy, oneshot_default: Bool) -> PhaseTimeouts JetHTTPBridgeError! {
    blanket := Duration?{None}
    if oneshot_default { blanket = Val(validated_timeout("timeout", blanket_ms ?? 30_000) ?? return Err(err)) }
    else if blanket_ms == .Val(value) { blanket = Val(validated_timeout("timeout", value) ?? return Err(err)) }
    total_timeout := Duration?{None}
    if total_ms == .Val(ms) { total_timeout = Val(validated_timeout("total timeout", ms) ?? return Err(err)) }
    else if !oneshot_default { total_timeout = policy.total_timeout }
    total :: compose_total_deadline(total_timeout) ?? return Err(err)
    PhaseTimeouts{
        dns: resolve_phase_timeout(dns_ms, "DNS timeout", blanket, policy.dns_timeout) ?? return Err(err),
        connect: resolve_phase_timeout(connect_ms, "connect timeout", blanket, policy.connect_timeout) ?? return Err(err),
        tls: resolve_phase_timeout(tls_ms, "TLS timeout", blanket, policy.tls_timeout) ?? return Err(err),
        write: resolve_phase_timeout(write_ms, "write timeout", blanket, policy.write_timeout) ?? return Err(err),
        first_byte: resolve_phase_timeout(first_byte_ms, "first byte timeout", blanket, policy.first_byte_timeout) ?? return Err(err),
        read: resolve_phase_timeout(read_ms, "read timeout", blanket, policy.read_timeout) ?? return Err(err), total: total,
    }
}
