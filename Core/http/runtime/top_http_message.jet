}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPMessage.rs:57
struct JetHTTPErrorSurfaceParts { variant: String, ordinal: I64, payload: JetHTTPErrorSurfacePayload }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPMessage.rs:65
fn jet_http_error_surface_parts(error: HTTPError) -> JetHTTPErrorSurfaceParts {
    unit :: fn(variant, ordinal) { JetHTTPErrorSurfaceParts{variant: variant, ordinal: ordinal, payload: .Unit} }
    int :: fn(variant, ordinal, field, value) { JetHTTPErrorSurfaceParts{variant: variant, ordinal: ordinal, payload: .Int{field: field, value: value}} }
    text :: fn(variant, ordinal, field, value) { JetHTTPErrorSurfaceParts{variant: variant, ordinal: ordinal, payload: .Text{field: field, value: ^value}} }
    match error {
        .InvalidMethod -> unit("InvalidMethod", 0)
        .InvalidURL -> unit("InvalidURL", 1)
        .InvalidHeader -> unit("InvalidHeader", 2)
        .InvalidStatus -> unit("InvalidStatus", 3)
        .BodyConsumed -> unit("BodyConsumed", 4)
        .InvalidFraming -> unit("InvalidFraming", 5)
        .UnsupportedEncoding -> unit("UnsupportedEncoding", 6)
        .Cancelled -> unit("Cancelled", 7)
        .BodyTooLarge(limit) -> int("BodyTooLarge", 8, "limit", limit)
        .Resolve(host) -> text("Resolve", 9, "host", ^host)
        .Connect(address) -> text("Connect", 10, "address", ^address)
        .TLS(stage) -> text("TLS", 11, "stage", ^stage)
        .Timeout(phase) -> text("Timeout", 12, "phase", ^phase)
        .Proxy(stage) -> text("Proxy", 13, "stage", ^stage)
        .Redirect(reason) -> text("Redirect", 14, "reason", ^reason)
        .Protocol(version) -> text("Protocol", 15, "version", ^version)
        .IO(operation) -> text("IO", 16, "operation", ^operation)
        .Policy(reason) -> text("Policy", 17, "reason", ^reason)
        .ResourceUnavailable(resource) -> text("ResourceUnavailable", 18, "resource", ^resource)
        .Internal(incident_id) -> text("Internal", 19, "incident_id", ^incident_id)
        .UnsupportedTarget(operation) -> {
            (variant, ordinal) :: match operation {
                .ClientConnect -> ("ClientConnect", 0)
                .ServerBind -> ("ServerBind", 1)
                .ServeListener -> ("ServeListener", 2)
            }
            JetHTTPErrorSurfaceParts{variant: "UnsupportedTarget", ordinal: 20,
                payload: .Operation{field: "operation", variant: variant, ordinal: ordinal}}
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPMessage.rs:124
fn jet_http_error_from_surface_parts(ordinal: I64, payload: I64, text: String?) -> HTTPError? {
    Val(match ordinal {
        0 -> HTTPError.InvalidMethod
        1 -> HTTPError.InvalidURL
        2 -> HTTPError.InvalidHeader
        3 -> HTTPError.InvalidStatus
        4 -> HTTPError.BodyConsumed
        5 -> HTTPError.InvalidFraming
        6 -> HTTPError.UnsupportedEncoding
        7 -> HTTPError.Cancelled
        8 -> HTTPError.BodyTooLarge(payload)
        9 -> HTTPError.Resolve(text?)
        10 -> HTTPError.Connect(text?)
        11 -> HTTPError.TLS(text?)
        12 -> HTTPError.Timeout(text?)
        13 -> HTTPError.Proxy(text?)
        14 -> HTTPError.Redirect(text?)
        15 -> HTTPError.Protocol(text?)
        16 -> HTTPError.IO(text?)
        17 -> HTTPError.Policy(text?)
        18 -> HTTPError.ResourceUnavailable(text?)
        19 -> HTTPError.Internal(text?)
        20 -> HTTPError.UnsupportedTarget(match payload {
            0 -> HTTPOperation.ClientConnect
            1 -> HTTPOperation.ServerBind
            2 -> HTTPOperation.ServeListener
            _ -> return None
        })
        _ -> return None
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPMessage.rs:161
fn jet_http_error_from_surface_name(variant: &String, payload: I64, text: String?) -> HTTPError? {
    ordinal :: match variant {
        "InvalidMethod" -> 0
        "InvalidURL" -> 1
        "InvalidHeader" -> 2
        "InvalidStatus" -> 3
        "BodyConsumed" -> 4
        "InvalidFraming" -> 5
        "UnsupportedEncoding" -> 6
        "Cancelled" -> 7
        "BodyTooLarge" -> 8
        "Resolve" -> 9
        "Connect" -> 10
        "TLS" -> 11
        "Timeout" -> 12
        "Proxy" -> 13
        "Redirect" -> 14
        "Protocol" -> 15
        "IO" -> 16
        "Policy" -> 17
        "ResourceUnavailable" -> 18
        "Internal" -> 19
        "UnsupportedTarget" -> 20
        _ -> return None
    }
    jet_http_error_from_surface_parts(ordinal, payload, ^text)
}
