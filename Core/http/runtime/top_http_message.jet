    fn fmt(self: &Self, formatter: &Formatter) -> () Err! {
        match self {
            .InvalidMethod -> formatter.write_str("invalid HTTP method")
            .InvalidURL -> formatter.write_str("invalid HTTP URL")
            .InvalidHeader -> formatter.write_str("invalid HTTP header")
            .InvalidStatus -> formatter.write_str("invalid HTTP status")
            .BodyConsumed -> formatter.write_str("HTTP body was already consumed")
            .BodyTooLarge(limit) -> formatter.write_fmt("HTTP body exceeds {limit}-byte limit")
            .InvalidFraming -> formatter.write_str("invalid HTTP framing")
            .UnsupportedEncoding -> formatter.write_str("unsupported HTTP body encoding")
            .Resolve(host) -> formatter.write_fmt("HTTP name resolution failed for {host}")
            .Connect(address) -> formatter.write_fmt("HTTP connection failed for {address}")
            .TLS(stage) -> formatter.write_fmt("HTTP TLS failed during {stage}")
            .Timeout(phase) -> formatter.write_fmt("HTTP timeout during {phase}")
            .Proxy(stage) -> formatter.write_fmt("HTTP proxy failed during {stage}")
            .Redirect(reason) -> formatter.write_fmt("HTTP redirect failed: {reason}")
            .Protocol(version) -> formatter.write_fmt("unsupported HTTP protocol {version}")
            .IO(operation) -> formatter.write_fmt("HTTP I/O failed during {operation}")
            .Policy(reason) -> formatter.write_fmt("{reason}")
            .Cancelled -> formatter.write_str("HTTP operation cancelled")
            .ResourceUnavailable(resource) -> formatter.write_fmt("HTTP resource unavailable: {resource}")
            .UnsupportedTarget(operation) -> {
                operation :: match operation { .ClientConnect -> "client connect", .ServerBind -> "server bind", .ServeListener -> "serve listener" }
                formatter.write_fmt("HTTP {operation} is unavailable on this build target")
            }
            .Internal(incident_id) -> formatter.write_fmt("internal HTTP failure; incident {incident_id}")
        }
    }
}
