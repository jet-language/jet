// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:6017
fn jet_http_static_range(value: &String, len: USize) -> (USize, USize)? {
    spec := value.strip_prefix("bytes=")?
    if len == 0 || spec.contains(',') { return None }
    (first, last) := spec.split_once('-')?
    match (first.is_empty(), last.is_empty()) {
        (true, true) -> None
        (true, false) -> {
            suffix :: last.parse::<USize>().ok()?
            (suffix > 0).then_some((len.saturating_sub(suffix), len - 1))
        }
        (false, true) -> {
            start :: first.parse::<USize>().ok()?
            (start < len).then_some((start, len - 1))
        }
        (false, false) -> {
            start :: first.parse::<USize>().ok()?
            end :: last.parse::<USize>().ok()?.min(len - 1)
            (start < len && start <= end).then_some((start, end))
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:6039
fn jet_http_static_mime(path: &OSPath) -> String {
    extension :: path.extension().and_then(fn(value) { value.to_str() }).unwrap_or("").to_ascii_lowercase()
    match extension {
        "css" -> "text/css; charset=utf-8"
        "gif" -> "image/gif"
        "html" | "htm" -> "text/html; charset=utf-8"
        "jpeg" | "jpg" -> "image/jpeg"
        "js" | "mjs" -> "text/javascript; charset=utf-8"
        "json" -> "application/json"
        "png" -> "image/png"
        "svg" -> "image/svg+xml"
        "txt" -> "text/plain; charset=utf-8"
        "wasm" -> "application/wasm"
        _ -> "application/octet-stream"
    }
}
