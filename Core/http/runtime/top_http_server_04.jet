#Unsafe("shared total handler catches user unwind and preserves typed HTTP errors as responses")
fn jet_http_mux_total_handler(handler: JetHTTPHandler) -> JetHTTPHandler {
    Arc.new(fn(req) {
        request_id :: jet_http_devtools_request_id(&req)
        match std.panic.catch_unwind(std.panic.AssertUnwindSafe(fn() { handler(^req) })) {
            Ok(Ok(response)) -> Ok(^response)
            Ok(Err(error)) -> {
                jet_http_devtools_publish_exception_code(&request_id, jet_http_devtools_error_code(&error))
                Ok(jet_http_srv_error_response(^error))
            }
            Err(_) -> {
                jet_http_devtools_publish_exception_code(&request_id, "panic")
                Ok(jet_http_srv_internal_response())
            }
        }
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5644
fn jet_http_srv_internal_response() -> JetHTTPResponse {
    jet_http_srv_response_owned(500, "500 Internal Server Error")
