        response := next.clone()(^req)?
        if !accepts_gzip || encoding != JetHTTPCompressEncoding.Gzip { return Ok(^response) }
        if response.suppress_body { return Ok(^response) }
        plain :: match response.body.bytes(JET_HTTP_MAX_BODY_BYTES) {
            Ok(bytes) -> ^bytes
            Err(_) -> return Ok(^response)
        }
        if plain.is_empty() { return Ok(^response) }
        compressed :: jet_http_gzip_stored(&plain)
        response.body = JetHTTPBody.from_bytes(^compressed)
        _ :: response.headers.set("content-encoding", "gzip")
        response.headers.remove("content-length")
        Ok(^response)
    })
}
