#Unsafe("blocking HTTP front door owns listener and transfers each accepted stream to one native worker")
fn jet_http_serve<F: Fn(JetHTTPRequest) -> JetHTTPResponse + Send + Sync>(addr: &String, handler: F) -> () {
    listener :: std.net.TcpListener.bind(addr).unwrap_or_else(fn(e) {
        eprintln("E2801: Bind on `{addr}` failed: {e}")
        std.process.exit(1)
    })
    handler :: Arc.new(^handler)
    loop {
        (stream, _peer) := match listener.accept() {
            Ok(x) -> ^x
            Err(e) -> { eprintln("E2801: Accept failed: {e}"); continue }
        }
        h :: handler.clone()
        std.thread.spawn(fn() {
            raw :: match jet_http_srv_read(&stream) {
                Ok(raw) -> ^raw
                Err(error) -> {
                    _ :: stream.write_all(jet_http_srv_read_error_response(&error).as_bytes())
                    return
                }
            }
            req :: match jet_http_srv_parse(&raw) {
                Ok(req) -> ^req
                Err(error) -> {
                    _ :: stream.write_all(jet_http_srv_read_error_response(&error).as_bytes())
                    return
                }
            }
            resp :: jet_scheduler_with_root_control(fn() { h(^req) })
            _ :: jet_http_srv_write_response(&stream, &resp, "HTTP/1.1", true)
        })
    }
}
