fn jet_http_date(seconds: I64) -> String {
    const WEEKDAYS: [String; 7] = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
    const MONTHS: [String; 12] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    days :: seconds.div_euclid(86_400)
    within :: seconds.rem_euclid(86_400)
    (year, month, day) :: jet_http_civil_from_days(days)
    weekday := WEEKDAYS[(days + 4).rem_euclid(7) as USize]
    month_name := MONTHS[(month - 1) as USize]
    hour :: within / 3600
    minute :: within / 60 % 60
    second :: within % 60
    "{weekday}, {day:02} {month_name} {year:04} {hour:02}:{minute:02}:{second:02} GMT"
}
