// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:6981
fn jet_http_router_parse_pattern(pattern: &String) -> [JetHTTPRouteSegment] Err! {
    jet_http_route_parse(pattern).map(fn(pattern) { ^pattern.segments })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:6985
fn jet_http_router_register(router: &JetHTTPRouter, method: String, pattern: String, handler: JetHTTPHandler, file: &String, line: U32, contract_json: String) -> () {
    jet_http_require_route_contract(&method, &pattern, &contract_json, file, line, false)
    segs :: match jet_http_router_parse_pattern(&pattern) {
        Ok(segs) -> ^segs
        Err(message) -> jet_panic(file, line, &message)
    }
    is_dup :: router.routes.iter().any(fn(r) {
        r.method == method && r.segments.len() == segs.len() && r.segments.iter().zip(segs.iter()).all(fn((a, b)) {
            match (a, b) {
                (JetHTTPRouteSegment.Static(x), JetHTTPRouteSegment.Static(y)) -> x == y
                (JetHTTPRouteSegment.Param(_), JetHTTPRouteSegment.Param(_)) -> true
                (JetHTTPRouteSegment.CatchAll(_), JetHTTPRouteSegment.CatchAll(_)) -> true
                _ -> false
            }
        })
    })
    if is_dup { jet_panic(file, line, &"E2804: duplicate route `{method} {pattern}`") }
    router.routes.push(JetHTTPRoute{method:^method, template:^pattern, segments:^segs, handler:^handler, contract_json:^contract_json})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:7030
fn jet_http_router_dispatch(router: &JetHTTPRouter, req: JetHTTPRequest) -> JetHTTPResponse HTTPError! {
    path_segs :: match jet_http_route_path(&req.path) {
        Ok(path) -> ^path
        Err(_) -> return Ok(jet_http_srv_response_owned(400, "400 bad request"))
    }
    candidates := [(USize, [String:String])]{}
    for (i, route) in router.routes.iter().enumerate() {
        pattern :: JetHTTPRoutePattern{segments:route.segments.clone()}
        if Val(params) :: jet_http_route_match(&pattern, &path_segs) { candidates.push((i, ^params)) }
    }
    if candidates.is_empty() { return Ok(jet_http_srv_response_owned(404, "404 not found")) }
    method_match := candidates.iter().filter(fn((i, _)) { router.routes[*i].method == req.method })
        .max_by(fn((left, _), (right, _)) {
            left_pattern :: JetHTTPRoutePattern{segments:router.routes[*left].segments.clone()}
            right_pattern :: JetHTTPRoutePattern{segments:router.routes[*right].segments.clone()}
            jet_http_route_selection_cmp(&left_pattern, *left, &right_pattern, *right)
        })
    (route_idx, params) := method_match ?? return Ok(jet_http_srv_response_owned(405, "405 method not allowed"))
    route := &router.routes[*route_idx]
    req2 := ^req
    req2.params = params.clone()
    req2.route_template = Val(route.template.clone())
    (route.handler)(^req2)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:7066
// GATE #4565: kernel primitive
#Unsafe("shared router is retained by the listener handler for its complete serving lifetime")
fn jet_http_serve_router(addr: &String, router: JetHTTPRouter) -> () {
    router :: Arc.new(^router)
    jet_http_serve(addr, fn(request) {
        jet_http_router_dispatch(&router, ^request).unwrap_or_else(fn(_) { jet_http_srv_response_owned(500, "500 Internal Server Error") })
    })
}
