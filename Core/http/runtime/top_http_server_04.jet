// GATE #4565: kernel primitive
#Unsafe("live reload observes real file metadata and bounded wall-clock sleep without synthetic events")
pub fn jet_app_http_reload(mux: &JetHTTPMux) -> () {
    jet_http_mux_add(mux, "GET", "/__jet/reload", fn(_) {
        watched :: std.env.var("JET_DEV_FILE").ok()
        fingerprint :: fn(path: &String) {
            std.fs.metadata(OSPath.new(path)).ok().and_then(fn(metadata) {
                metadata.modified().ok().map(fn(modified) { (metadata.len(), ^modified) })
            })
        }
        initial :: watched.as_ref().and_then(fingerprint)
        deadline :: Instant.now() + Duration.from_secs(30)
        changed :: loop {
            if watched.as_ref().is_some_and(fn(path) { fingerprint(path) != initial }) { break true }
            if Instant.now() >= deadline { break false }
            std.thread.sleep(Duration.from_millis(50))
        }
        status :: if changed { 200 } else { 204 }
        body :: if changed { "data: reload\n\n" } else { "" }
        response := jet_http_srv_response(status, &body)
        response.headers.append("content-type", "text/event-stream").expect("static content type is valid")
        ^response
    })
}
