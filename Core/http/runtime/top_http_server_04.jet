#Unsafe("request timing and shared handler allocation preserve immutable route snapshot ownership")
fn jet_http_mux_dispatch_cached(mux: &JetHTTPMux, req: JetHTTPRequest, route_cache: &JetHTTPMuxRouteCache) -> JetHTTPResponse HTTPError! {
    req := ^req
