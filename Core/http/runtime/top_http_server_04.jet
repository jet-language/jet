        allow :: jet_http_allowed_methods(route_cache.routes.iter().map(fn(route) { &route.route.method }))
        handler: JetHTTPHandler :: Arc.new(fn(_) {
            Ok(jet_http_srv_response_with_headers(204, "", ["Allow":allow.clone()]))
        })
        jet_http_devtools_publish_request(&req, &request_id, started_at_ms)
        response :: jet_http_mux_run_handler(mux, ^req, ^handler)
        jet_http_devtools_publish_response(&request_id, &response, &started)
        return Ok(^response)
    }
    // CONNECT retains authority in req.path and borrows ordinary paths.
    route_target :: if requested_method == "CONNECT" {
        std.borrow.Cow.Owned("/{req.path}")
    } else { std.borrow.Cow.Borrowed(&req.path) }
    if jet_http_route_validate_path(route_target.as_ref()).is_err() {
        handler: JetHTTPHandler :: Arc.new(fn(_) { Ok(jet_http_srv_response_owned(400, "400 Bad Request")) })
        jet_http_devtools_publish_request(&req, &request_id, started_at_ms)
        response :: jet_http_mux_run_handler(mux, ^req, ^handler)
        response :: jet_http_srv_head_response(^response, is_head)
        jet_http_devtools_publish_response(&request_id, &response, &started)
        return Ok(^response)
    }
    // Never retain registry locks during middleware composition or user code.
    route_path := route_target.as_ref()
    path_match_count := 0usize
    has_head := false
    selected := None
    selected_get := None
    for (order, route) in route_cache.routes.iter().enumerate() {
        pattern := route.pattern.as_ref() ?? continue
        if !jet_http_route_matches_path(pattern, route_path) { continue }
        path_match_count += 1
        has_head = has_head || route.route.method == "HEAD"
        if route.route.method == requested_method {
            replace :: match selected {
                None -> true
                Val((left_order, _, left_pattern)) ->
                    jet_http_route_selection_cmp(pattern, order, left_pattern, left_order) == std.cmp.Ordering.Greater
            }
            if replace { selected = Val((order, route, pattern)) }
        }
        if requested_method == "HEAD" && route.route.method == "GET" {
            replace :: match selected_get {
                None -> true
                Val((left_order, _, left_pattern)) ->
                    jet_http_route_selection_cmp(pattern, order, left_pattern, left_order) == std.cmp.Ordering.Greater
            }
            if replace { selected_get = Val((order, route, pattern)) }
        }
    }
    selected :: if requested_method == "HEAD" && !has_head { ^selected_get } else { ^selected }
    if Val((_, route, pattern)) :: selected {
        req.params = jet_http_route_params_path(pattern, route_path).expect("validated HTTP route path")
        req.route_template = Val(route.route.pattern.clone())
        jet_http_devtools_publish_request(&req, &request_id, started_at_ms)
        response :: jet_http_mux_run_handler_ref(mux, ^req, &route.route.handler)
        response :: jet_http_srv_head_response(^response, is_head)
        jet_http_devtools_publish_response(&request_id, &response, &started)
        return Ok(^response)
    }
    if path_match_count > 0 {
        allow :: jet_http_allowed_methods(route_cache.routes.iter().filter_map(fn(route) {
            pattern := route.pattern.as_ref()?
            jet_http_route_matches_path(pattern, route_path).then_some(&route.route.method)
        }))
        handler: JetHTTPHandler :: Arc.new(fn(_) {
            Ok(jet_http_srv_response_with_headers(405, "405 Method Not Allowed", ["Allow":allow.clone()]))
        })
        jet_http_devtools_publish_request(&req, &request_id, started_at_ms)
        response :: jet_http_mux_run_handler(mux, ^req, ^handler)
        response :: jet_http_srv_head_response(^response, is_head)
        jet_http_devtools_publish_response(&request_id, &response, &started)
        return Ok(^response)
    }
    handler: JetHTTPHandler :: Arc.new(fn(_) { Ok(jet_http_srv_response_owned(404, "404 Not Found")) })
    jet_http_devtools_publish_request(&req, &request_id, started_at_ms)
    response :: jet_http_mux_run_handler(mux, ^req, ^handler)
    response :: jet_http_srv_head_response(^response, is_head)
    jet_http_devtools_publish_response(&request_id, &response, &started)
    Ok(^response)
}
