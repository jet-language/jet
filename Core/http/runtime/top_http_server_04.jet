        message :: "web app server failed: {error}"
        jet_runtime_stop("E3001", "", 0, &message)
    })
    addr :: jet_http_server_local_addr(&server).unwrap_or_else(fn(error) {
        message :: "web app address failed: {error}"
        jet_runtime_stop("E3001", "", 0, &message)
    })
    suffix :: if dev { " (live reload)" } else { "" }
    println("serving http://{addr}{suffix}")
    _ :: std.io.stdout().flush()
    jet_http_server_serve(&server).unwrap_or_else(fn(error) {
        message :: "web app server failed: {error}"
        jet_runtime_stop("E3001", "", 0, &message)
    })
}
