fn jet_http_gzip_stored(input: &[U8]) -> [U8] {
    out := [U8].with_capacity(input.len() + 32)
    out.extend_from_slice(&[0x1f, 0x8b, 0x08, 0x00, 0, 0, 0, 0, 0x00, 0xff])
    pos := 0usize
    loop while pos < input.len() {
        chunk :: (input.len() - pos).min(65_535)
        final_block :: pos + chunk >= input.len()
        out.push(if final_block { 0x01 } else { 0x00 })
        len :: chunk as U16
        out.extend_from_slice(&len.to_le_bytes())
        out.extend_from_slice(&(!len).to_le_bytes())
        out.extend_from_slice(&input[pos..pos + chunk])
        pos += chunk
    }
    out.extend_from_slice(&jet_http_crc32(input).to_le_bytes())
    out.extend_from_slice(&(input.len() as U32).to_le_bytes())
    ^out
}
