// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5239
fn jet_http_devtools_request_id(req: &JetHTTPRequest) -> String {
    match req.headers.get("x-request-id") {
        Val(value) if jet_http_request_id_valid(value) -> value.clone()
        _ -> jet_http_new_request_id()
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5246
fn jet_http_devtools_publish_request(req: &JetHTTPRequest, request_id: &String, started_at_ms: U64) -> () {
    path := req.path.split('?').next().unwrap_or(&req.path)
    route := req.route_template.as_ref().unwrap_or(path)
    fact := JetDevtoolsRequestFact.new(request_id, req.method.clone(), route, started_at_ms)
    for (name, _) in req.params.iter().take(JET_DEVTOOLS_REQUEST_PANEL_MAX_ROUTE_INPUTS) {
        fact = fact.with_route_input(JetDevtoolsRouteInput.new(name.clone()))
    }
    jet_http_devtools_publish_fact(JetDevtoolsRequestPanelFact.Request(^fact))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5269
// GATE #4565: kernel primitive
#Unsafe("monotonic elapsed clock is read without changing request ownership")
fn jet_http_devtools_publish_response(request_id: &String, response: &JetHTTPResponse, started: &Instant) -> () {
    status :: U16.try_from(response.status).ok() ?? return
    size_bytes :: response.head_content_length.or_else(fn() { response.body.length() })
        .and_then(fn(length) { U64.try_from(length).ok() }).unwrap_or(0)
    duration_ms :: U64.try_from(started.elapsed().as_millis()).unwrap_or(U64.MAX)
    fact :: JetDevtoolsResponseFact.new(request_id, status, size_bytes, duration_ms)
    jet_http_devtools_publish_fact(JetDevtoolsRequestPanelFact.Response(^fact))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5287
fn jet_http_devtools_error_code(error: &HTTPError) -> String {
    match error {
        HTTPError.InvalidMethod -> "InvalidMethod"
        HTTPError.InvalidURL -> "InvalidURL"
        HTTPError.InvalidHeader -> "InvalidHeader"
        HTTPError.InvalidStatus -> "InvalidStatus"
        HTTPError.BodyConsumed -> "BodyConsumed"
        HTTPError.BodyTooLarge(_) -> "BodyTooLarge"
        HTTPError.InvalidFraming -> "InvalidFraming"
        HTTPError.UnsupportedEncoding -> "UnsupportedEncoding"
        HTTPError.Resolve(_) -> "Resolve"
        HTTPError.Connect(_) -> "Connect"
        HTTPError.TLS(_) -> "TLS"
        HTTPError.Timeout(_) -> "Timeout"
        HTTPError.Proxy(_) -> "Proxy"
        HTTPError.Redirect(_) -> "Redirect"
        HTTPError.Protocol(_) -> "Protocol"
        HTTPError.IO(_) -> "IO"
        HTTPError.Policy(_) -> "Policy"
        HTTPError.Cancelled -> "Cancelled"
        HTTPError.ResourceUnavailable(_) -> "ResourceUnavailable"
        HTTPError.UnsupportedTarget(_) -> "UnsupportedTarget"
        HTTPError.Internal(_) -> "Internal"
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5313
fn jet_http_devtools_publish_exception_code(request_id: &String, code: &String) -> () {
    id :: "{request_id}:exception:{code}"
    fact :: JetDevtoolsExceptionFact.new(^id, request_id, "HTTPError", code, jet_http_unix_now_ms())
    jet_http_devtools_publish_fact(JetDevtoolsRequestPanelFact.Exception(^fact))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5326
fn jet_http_devtools_source_text(value: &String, limit: USize) -> String {
    value.chars().filter(fn(character) { !character.is_control() }).take(limit).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5334
fn jet_http_devtools_publish_exception_report(request_id: &String, report: &JetErrorReport) -> () {
    code := report.code.as_ref().filter(fn(value) {
        !value.is_empty() && value.chars().all(fn(character) {
            character.is_ascii_alphanumeric() || character == '.' || character == '_' || character == '-'
        })
    }).unwrap_or("HTTPError")
    fact := JetDevtoolsExceptionFact.new("{request_id}:exception:{code}", request_id, "HTTPError", code, jet_http_unix_now_ms())
    if report.origin.is_none() && report.source_journey.is_empty() {
        if Val(frame) :: jet_error_page_source(report) {
            file :: jet_http_devtools_source_text(&frame.file, JET_ERROR_PAGE_MAX_SOURCE_BYTES)
            if !file.is_empty() {
                fact = fact.with_source_frame(JetDevtoolsSourceFrame.new(
                    "{request_id}:frame:0", request_id,
                    jet_http_devtools_source_text(&frame.fn_name, JET_ERROR_PAGE_MAX_SOURCE_BYTES),
                    ^file, frame.line, 0, 0))
            }
        }
    } else {
        for (index, frame) in report.origin.iter().chain(&report.source_journey)
            .take(JET_DEVTOOLS_REQUEST_PANEL_MAX_SOURCE_FRAMES).enumerate() {
            file :: jet_http_devtools_source_text(&frame.file, JET_ERROR_PAGE_MAX_SOURCE_BYTES)
            if file.is_empty() { continue }
            fact = fact.with_source_frame(JetDevtoolsSourceFrame.new(
                "{request_id}:frame:{index}", request_id,
                jet_http_devtools_source_text(&frame.fn_name, JET_ERROR_PAGE_MAX_SOURCE_BYTES),
                ^file, frame.line, 0, U32.try_from(index).unwrap_or(U32.MAX)))
        }
    }
    jet_http_devtools_publish_fact(JetDevtoolsRequestPanelFact.Exception(^fact))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5399
fn jet_http_mux_dispatch(mux: &JetHTTPMux, req: JetHTTPRequest) -> JetHTTPResponse HTTPError! {
