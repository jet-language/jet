fn jet_http_date_parse(value: &String) -> I64? {
    const MONTHS: [String; 12] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    parts :: value.split_ascii_whitespace().collect::<[View<Char>]>()
    if parts.len() != 6 || !parts[0].ends_with(',') || parts[5] != "GMT" { return None }
    day :: parts[1].parse::<I64>().ok()?
    month :: MONTHS.iter().position(fn(month) { *month == parts[2] })? as I64 + 1
    year :: parts[3].parse::<I64>().ok()?
    time :: parts[4].split(':').map(fn(part) { part.parse::<I64>() }).collect::<[I64] Err!>().ok()?
    if time.len() != 3 || time[0] < 0 || time[0] >= 24 || time[1] < 0 || time[1] >= 60 || time[2] < 0 || time[2] >= 60 { return None }
    seconds :: jet_http_days_from_civil(year, month, day).checked_mul(86_400)?
        .checked_add(time[0] * 3600 + time[1] * 60 + time[2])?
