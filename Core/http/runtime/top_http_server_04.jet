#Unsafe("request TLS and middleware snapshot locks are released independently of caught user callback unwinds")
fn jet_http_mux_run_handler(mux: &JetHTTPMux, req: JetHTTPRequest, handler: JetHTTPHandler) -> JetHTTPResponse {
    request_id :: jet_http_devtools_request_id(&req)
    _db_request_scope :: JetDbRequestScope.enter(Val(request_id.clone()))
    middlewares :: match mux.1.lock() {
        Ok(middlewares) -> middlewares.clone()
        Err(_) -> {
            jet_http_devtools_publish_exception_code(&request_id, "middleware_lock")
            return jet_http_srv_internal_response()
        }
    }
    if middlewares.is_empty() {
        return match std.panic.catch_unwind(std.panic.AssertUnwindSafe(fn() { handler(^req) })) {
            Ok(Ok(response)) -> ^response
            Ok(Err(error)) -> {
                jet_http_devtools_publish_exception_code(&request_id, jet_http_devtools_error_code(&error))
                jet_http_srv_error_response(^error)
            }
            Err(_) -> {
                jet_http_devtools_publish_exception_code(&request_id, "panic")
                jet_http_srv_internal_response()
            }
        }
    }
    handler := jet_http_mux_total_handler(^handler)
    for middleware in middlewares.iter().rev() {
        next :: handler.clone()
        handler = match std.panic.catch_unwind(std.panic.AssertUnwindSafe(fn() { middleware(^next) })) {
            Ok(handler) -> jet_http_mux_total_handler(^handler)
            Err(_) -> Arc.new(fn(req) {
                request_id :: jet_http_devtools_request_id(&req)
                jet_http_devtools_publish_exception_code(&request_id, "middleware_panic")
                Ok(jet_http_srv_internal_response())
            })
        }
    }
    match handler(^req) {
        Ok(response) -> ^response
        Err(error) -> {
            jet_http_devtools_publish_exception_code(&request_id, jet_http_devtools_error_code(&error))
            jet_http_srv_error_response(^error)
        }
    }
}
