// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5648
fn jet_http_srv_error_response(error: HTTPError) -> JetHTTPResponse {
    match error {
        HTTPError.BodyTooLarge(_) -> jet_http_srv_empty_response(413)
        HTTPError.InvalidFraming -> jet_http_srv_empty_response(400)
        HTTPError.UnsupportedEncoding -> jet_http_srv_empty_response(415)
        _ -> jet_http_srv_internal_response()
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5657
fn jet_http_srv_head_response(response: JetHTTPResponse, is_head: Bool) -> JetHTTPResponse {
    response := ^response
    if is_head {
        response.suppress_body = true
        response.head_content_length = response.body.length()
        response.body = JetHTTPBody.empty()
        response.trailers = JetHTTPHeaders.new()
    }
    ^response
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5667
fn jet_http_allowed_methods(registered: impl Iterator<Item = &String>) -> String {
    methods := BTreeSet.new()
    methods.extend(registered.map(fn(method) { method.clone() }))
    if methods.contains("GET") { methods.insert("HEAD") }
    methods.insert("OPTIONS")
    methods.into_iter().collect::<[String]>().join(", ")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5675
fn jet_http_mux_validate(mux: &JetHTTPMux) -> () Err! {
    mux.route_cache().validation_error.clone().map_or(Ok(()), Err)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5682
fn jet_http_srv_format(resp: &JetHTTPResponse) -> String {
    jet_http_srv_format_connection(resp, "HTTP/1.1", true)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5686
fn jet_http_srv_format_connection(resp: &JetHTTPResponse, version: &String, close: Bool) -> String {
    bytes := [U8]{}
    jet_http_srv_write_response(&bytes, resp, version, close).expect("in-memory HTTP response formatting cannot fail")
    String.from_utf8(^bytes).expect("text compatibility response contains UTF-8")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5692
fn jet_http_srv_connection_nominates(headers: &JetHTTPHeaders, name: &String) -> Bool {
    for (candidate, value) in headers {
        if candidate.eq_ignore_ascii_case("connection") && value.split(',')
            .map(fn(part) { part.trim() }).any(fn(nominated) { nominated.eq_ignore_ascii_case(name) }) {
            return true
        }
    }
    false
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:5707
// GATE #4565: kernel primitive
#Unsafe("body mutex, vectored IO and release atomic preserve one-shot byte source consumption")
fn jet_http_srv_write_bytes_response(writer: &impl Write, header: &String, body: &JetHTTPBody, expected_length: USize?) -> USize? HTTPError! {
    state := body.state.lock().map_err(fn(_) { HTTPError.Internal("http-body-lock") })?
    source :: state.source.take() ?? return Ok(None)
    reader :: match source {
        JetHTTPBodySource.Bytes(reader) -> ^reader
        _ -> { state.source = Val(^source); return Ok(None) }
    }
    position :: reader.position()
    bytes :: reader.into_inner()
    start :: USize.try_from(position).unwrap_or(bytes.len()).min(bytes.len())
    bytes := &bytes[start..]
    total :: header.len().saturating_add(bytes.len())
    slices :: [IoSlice.new(header.as_bytes()), IoSlice.new(bytes)]
    first :: writer.write_vectored(&slices).map_err(fn(_) { HTTPError.IO("write response body") })?
    if first < total {
        if first < header.len() {
            writer.write_all(&header.as_bytes()[first..]).map_err(fn(_) { HTTPError.IO("write response headers") })?
            writer.write_all(bytes).map_err(fn(_) { HTTPError.IO("write response body") })?
        } else {
            writer.write_all(&bytes[first - header.len()..]).map_err(fn(_) { HTTPError.IO("write response body") })?
        }
    }
    state.drained.store(true, Ordering.Release)
    if expected_length.is_some_and(fn(length) { length != bytes.len() }) { return Err(HTTPError.InvalidFraming) }
    Ok(Val(bytes.len()))
}
