fn jet_http_days_from_civil(year: I64, month: I64, day: I64) -> I64 {
    year :: year - I64.from(month <= 2)
    era :: year.div_euclid(400)
    yoe :: year - era * 400
    shifted_month :: month + if month > 2 { -3 } else { 9 }
    doy :: (153 * shifted_month + 2) / 5 + day - 1
    doe :: yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146_097 + doe - 719_468
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:6065
fn jet_http_civil_from_days(days: I64) -> (I64, I64, I64) {
    days :: days + 719_468
    era :: days.div_euclid(146_097)
    doe :: days - era * 146_097
    yoe :: (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365
    year := yoe + era * 400
    doy :: doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp :: (5 * doy + 2) / 153
    day :: doy - (153 * mp + 2) / 5 + 1
    month :: mp + if mp < 10 { 3 } else { -9 }
    year += I64.from(month <= 2)
