fn jet_http_chunk_size(line: &[U8]) -> USize JetHTTPReadError! {
    digits :: line.iter().take_while(fn(byte) { byte.is_ascii_hexdigit() }).count()
    if digits == 0 || !jet_http_chunk_extensions_valid(&line[digits..]) { return Err(JetHTTPReadError{status: 400, message: "chunk size is malformed"}) }
