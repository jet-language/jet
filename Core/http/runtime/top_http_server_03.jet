fn jet_http_decode_chunked_body(body: &[U8], trailer_names: [String]) -> ([U8], JetHTTPHeaders) JetHTTPReadError! {
    state := JetHTTPChunkState.new(JET_HTTP_MAX_BODY_BYTES, ^trailer_names)
