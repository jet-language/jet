where V: Fn(&String, &String) -> () Err!, S: Fn(&String, &String, TcpStream, Box<fn(&[U8], Bool) -> ([U8], Bool) Err!>, JetHTTPTlsH2, Box<fn() -> Bool>) -> () Err! + Clone + Send + Sync {
