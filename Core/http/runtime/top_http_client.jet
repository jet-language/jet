// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPClient.rs:405
// Both former macro namespaces use the one canonical Jet transport owner.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPClient.rs:407
fn native_http_error(error: JetHTTPBridgeError) -> HTTPError {
    match error {
        .InvalidURL -> .InvalidURL
        .InvalidHeader -> .InvalidHeader
        .InvalidFraming -> .InvalidFraming
        .UnsupportedEncoding -> .UnsupportedEncoding
        .Resolve -> HTTPError.Resolve(host: "<redacted>")
        .Connect -> HTTPError.Connect(address: "<redacted>")
        .TLS -> HTTPError.TLS(stage: "handshake")
        .Timeout -> HTTPError.Timeout(phase: "transport")
        .Proxy -> HTTPError.Proxy(stage: "transport")
        .Redirect -> HTTPError.Redirect(reason: "limit")
        .Protocol -> HTTPError.Protocol(version: "unsupported")
        .IO -> HTTPError.IO(operation: "transport")
        .ResourceUnavailable -> HTTPError.ResourceUnavailable(resource: "transport")
        .Cancelled -> .Cancelled
        .UnsupportedTarget -> HTTPError.UnsupportedTarget(operation: HTTPOperation.ClientConnect)
        .Internal -> HTTPError.Internal(incident_id: "http-transport")
    }
}
