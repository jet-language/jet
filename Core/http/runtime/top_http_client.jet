// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPClient.rs:325
fn jet_http_client_response_new(status: I64, body_handle: I64, body_length: I64?, headers: [(String, String)],
    body_read: fn(I64, USize) -> [U8]? HTTPError!, body_close: fn(I64) ->,
    protocol: String, remote_address: String, redirect_history: [String], timings_ms: [I64],
    reused_connection: Bool, raw_content_encoding: String?) -> JetHTTPResponse HTTPError! {
    body_length :: match body_length.map(fn(length) { USize.try_from(length) }).transpose() {
        Ok(length) -> length
        Err(_) -> { body_close(body_handle); return Err(.InvalidFraming) }
    }
    if headers.iter().any(fn((name, value)) { !JetHTTPHeaders.valid_name(name) || !JetHTTPHeaders.valid_value(value) }) {
        body_close(body_handle)
        return Err(.InvalidHeader)
    }
    Ok(JetHTTPResponse{status, version: "HTTP/1.1",
        body: JetHTTPBody.bridge(body_handle, body_length, body_read, body_close), headers: JetHTTPHeaders{entries: ^headers},
        trailers: JetHTTPHeaders.new(), head_content_length: None, suppress_body: false,
        protocol: ^protocol, remote_address: ^remote_address, redirect_history: ^redirect_history,
        timings_ms: ^timings_ms, reused_connection, raw_content_encoding: ^raw_content_encoding})
}
