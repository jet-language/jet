// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:3418
fn jet_http2_serve_with_last_stream<T: JetHTTP2Transport>(stream: &T, mux: &JetHTTPMux, options: &JetHTTPServerOptions, shutdown: &AtomicBool, dynamic_grace_ms: &AtomicU64?, drain_deadline_ms: &AtomicU64?) -> (Unit Err!, U32) {
