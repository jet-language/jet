fn jet_http2_request_trailers(headers: [(String, String)]) -> JetHTTPHeaders Err! {
    trailers := JetHTTPHeaders.new()
    for (name, value) in headers {
        if name.starts_with(':') { return Err("HTTP/2 trailer contains a pseudo-header".to_string()) }
        if name.bytes().any(byte -> byte.is_ascii_uppercase()) { return Err("HTTP/2 trailer name contains uppercase".to_string()) }
        if !jet_http_trailer_name_allowed(&name) { return Err("HTTP/2 request trailer is forbidden".to_string()) }
        trailers.append(&name, &value).map_err(_ -> "HTTP/2 trailer is invalid".to_string())?
    }
