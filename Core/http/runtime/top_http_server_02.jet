// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1808
fn jet_http_error_page_response(request: &JetHTTPRequest, status: Int, failure_id: &String, report: &JetErrorReport, correlation_links: &[String], local: Bool) -> JetHTTPResponse {
    request_id :: match request.headers.get("x-request-id") {
        .Some(value) if jet_http_request_id_valid(value) -> value.clone(),
        _ -> jet_http_new_request_id(),
    }
    jet_http_devtools_publish_exception_report(&request_id, report)
    projection :: jet_error_page_projection(status, failure_id, &request_id, report, correlation_links, local)
    wants_json :: jet_http_error_page_accepts_json(request.headers.get("accept"))
    (body, content_type) :: if wants_json { (projection.json(), "application/json; charset=utf-8") } else { (projection.html(), "text/html; charset=utf-8") }
    response := jet_http_srv_response_owned(projection.status, ^body)
    _ :: response.headers.set("content-type", content_type)
    _ :: response.headers.set("cache-control", "no-store")
    _ :: response.headers.set("vary", "Accept")
    _ :: response.headers.set("x-request-id", &projection.request_id)
    response
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1844
fn jet_http_srv_response_with_headers(status: Int, body: &String, headers: JetHTTPHeaders) -> JetHTTPResponse {
    response := jet_http_srv_response_owned(status, body.to_string())
    response.headers = ^headers
    response
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1854
fn jet_http_srv_response_header(resp: JetHTTPResponse, name: &String, value: &String) -> JetHTTPResponse {
    if resp.headers.append(name, value).is_err() {
        resp.status = 500
        resp.body = JetHTTPBody.from_text("500 Internal Server Error".to_string())
        resp.headers = JetHTTPHeaders.new()
    }
    resp
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1867
fn jet_http_srv_response_header_owned(resp: JetHTTPResponse, name: String, value: String) -> JetHTTPResponse {
    if !JetHTTPHeaders.valid_name(&name) || !JetHTTPHeaders.valid_value(&value) {
        resp.status = 500
        resp.body = JetHTTPBody.from_text("500 Internal Server Error".to_string())
        resp.headers = JetHTTPHeaders.new()
    } else {
        resp.headers.entries.push((^name, ^value))
    }
    resp
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1881
fn jet_http_srv_response_status(resp: &JetHTTPResponse) -> Int { resp.status }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1882
fn jet_http_srv_response_body(resp: &JetHTTPResponse) -> JetHTTPBody { resp.body.clone() }

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1886
fn jet_http_mux_serve(addr: &String, mux: JetHTTPMux, tls: JetHTTPServerTls?, deadline: jet_std.Duration?) -> Unit HTTPError! {
    if tls.is_some() { return Err(HTTPError.IO("TLS server requires the native TLS adapter".to_string())) }
    mux :: jet_http_mux_with_optional_deadline(^mux, deadline.as_ref())
    jet_http_mux_validate(&mux).map_err(operation -> HTTPError.IO(^operation))?
    // GATE #4565: kernel primitive
    #Unsafe("bind native listener and share atomic shutdown with the audited listener lifecycle") {
        listener :: TcpListener.bind(addr.as_str()).map_err(error -> HTTPError.IO("bind on `{addr}` failed: {error}"))?
        shutdown :: Arc.new(AtomicBool.new(false))
        jet_http_server_run_listener(^listener, ^mux, JetHTTPServerOptions.safe(), ^shutdown, None, None, None).map(_ -> ()).map_err(operation -> HTTPError.IO(^operation))
    }
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1918
fn jet_http_server_bind(addr: &String, mux: JetHTTPMux, tls: JetHTTPServerTls?, deadline: jet_std.Duration?) -> JetHTTPServer HTTPError! {
    if tls.is_some() { return Err(HTTPError.IO("TLS server requires the native TLS adapter".to_string())) }
    mux :: jet_http_mux_with_optional_deadline(^mux, deadline.as_ref())
    jet_http_server_bind_with_tls(addr, ^mux, None)
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1935
// Bind the beginner server on safe loopback and install request deadline middleware.
fn jet_http_server_default(mux: &JetHTTPMux, deadline: &jet_std.Duration) -> JetHTTPServer {
    mux :: jet_http_mux_with_deadline(mux.clone(), deadline)
    address :: "127.0.0.1:8080".to_string()
    jet_http_server_bind(&address, ^mux, None, None).unwrap_or_else(error -> panic("HTTP server bind failed: {error}"))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1948
fn jet_http_server_wait(server: &JetHTTPServer) -> JetHTTPShutdownReport HTTPError! { jet_http_server_serve(server) }

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1953
fn jet_http_server_bind_with_tls(addr: &String, mux: JetHTTPMux, tls_conn: JetHTTPTlsConn?) -> JetHTTPServer HTTPError! {
    os :: target.selected_os()
    supported :: ["linux", "android", "macos", "ios", "freebsd", "openbsd", "netbsd", "windows"].contains(os) ||
        (os == "wasi" && target.selected_env() == "p2" && target.selected_arch() == "wasm32")
    if !supported { return Err(HTTPError.UnsupportedTarget(HTTPOperation.ServerBind)) }
    jet_http_mux_validate(&mux).map_err(operation -> HTTPError.IO(^operation))?
    // GATE #4565: kernel primitive
    #Unsafe("bind supported native listener and initialize synchronized single-serve lifecycle state") {
        listener :: TcpListener.bind(addr.as_str()).map_err(error -> HTTPError.IO("bind on `{addr}` failed: {error}"))?
        local_addr :: listener.local_addr().map_err(error -> HTTPError.IO("local address failed: {error}"))?.to_string()
        Ok(JetHTTPServer { inner: Arc.new(JetHTTPServerState {
            listener: Mutex.new(Some(^listener)), mux: ^mux, local_addr: ^local_addr,
            shutdown: Arc.new(AtomicBool.new(false)), shutdown_called: AtomicBool.new(false),
            grace_ms: Arc.new(AtomicU64.new(U64{30000})),
            drain_deadline_ms: Arc.new(AtomicU64.new(U64{0})),
            lifecycle: AtomicU8.new(U8{0}), report: Mutex.new(None),
            report_ready: Condvar.new(), tls_conn: ^tls_conn,
        }) })
    }
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:2015
fn jet_http_server_local_addr(server: &JetHTTPServer) -> String HTTPError! { Ok(server.inner.local_addr.clone()) }

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:2019
fn jet_http_server_serve(server: &JetHTTPServer) -> JetHTTPShutdownReport HTTPError! {
    // GATE #4565: kernel primitive
    #Unsafe("atomic single-serve claim and mutex-protected listener/report ownership with condition wakeups") {
        server.inner.lifecycle.compare_exchange(U8{0}, U8{1}, Ordering.AcqRel, Ordering.Acquire).map_err(_ -> HTTPError.IO("HTTP server can only be served once".to_string()))?
        listener :: server.inner.listener.lock().unwrap().take().ok_or_else(() -> HTTPError.IO("HTTP server listener was already consumed".to_string()))?
        result :: jet_http_server_run_listener(^listener, server.inner.mux.clone(), JetHTTPServerOptions.safe(),
            server.inner.shutdown.clone(), Some(server.inner.grace_ms.clone()),
            Some(server.inner.drain_deadline_ms.clone()), server.inner.tls_conn.clone()).map_err(operation -> HTTPError.IO(^operation))
        server.inner.lifecycle.store(U8{2}, Ordering.Release)
        match result {
            .Ok(report) -> {
                *server.inner.report.lock().unwrap() = Some(report)
                server.inner.report_ready.notify_all()
                Ok(report)
            },
            .Err(error) -> {
                server.inner.report_ready.notify_all()
                Err(^error)
            },
        }
    }
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:2051
fn jet_http_server_wait_for_report(server: &JetHTTPServer) -> JetHTTPShutdownReport HTTPError! {
    // GATE #4565: kernel primitive
    #Unsafe("wait on report mutex until serving lifecycle becomes terminal") {
        report := server.inner.report.lock().unwrap()
        while report.is_none() && server.inner.lifecycle.load(Ordering.Acquire) == U8{1} {
            report = server.inner.report_ready.wait(^report).unwrap()
        }
        (*report).ok_or_else(() -> HTTPError.IO("HTTP server stopped without a shutdown report".to_string()))
    }
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:2064
fn jet_http_server_shutdown(server: &JetHTTPServer, grace: &jet_std.Duration) -> JetHTTPShutdownReport HTTPError! {
    // GATE #4565: kernel primitive
    #Unsafe("claim shutdown once and publish shared absolute drain deadline before release-store cancellation") {
        already_requested :: server.inner.shutdown_called.swap(true, Ordering.AcqRel)
        if already_requested { return jet_http_server_wait_for_report(server) }
        // Claim terminal state on an unserved server before a racing serve can win.
        if server.inner.lifecycle.compare_exchange(U8{0}, U8{2}, Ordering.AcqRel, Ordering.Acquire).is_ok() {
            return Err(HTTPError.IO("HTTP server is not serving".to_string()))
        }
        if server.inner.lifecycle.load(Ordering.Acquire) != U8{1} {
            return Err(HTTPError.IO("HTTP server is not serving".to_string()))
        }
        grace_ms :: grace.as_millis().max(0) as U64
        deadline_ms :: jet_http_unix_now_ms().saturating_add(grace_ms)
        server.inner.drain_deadline_ms.store(deadline_ms, Ordering.Release)
        server.inner.grace_ms.store(grace_ms, Ordering.Release)
        server.inner.shutdown.store(true, Ordering.Release)
        jet_http_server_wait_for_report(server)
    }
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:2100
fn jet_http_server_run_listener(listener: TcpListener, mux: JetHTTPMux, options: JetHTTPServerOptions, shutdown: Arc<AtomicBool>, dynamic_grace_ms: Arc<AtomicU64>?, drain_deadline_ms: Arc<AtomicU64>?, tls_conn: JetHTTPTlsConn?) -> JetHTTPShutdownReport Err! {
    jet_scheduler_with_root_control(() -> jet_http_server_run_listener_inner(^listener, ^mux, ^options, ^shutdown, ^dynamic_grace_ms, ^drain_deadline_ms, ^tls_conn))
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:2122
fn jet_http_server_run_listener_inner(listener: TcpListener, mux: JetHTTPMux, options: JetHTTPServerOptions, shutdown: Arc<AtomicBool>, dynamic_grace_ms: Arc<AtomicU64>?, drain_deadline_ms: Arc<AtomicU64>?, tls_conn: JetHTTPTlsConn?) -> JetHTTPShutdownReport Err! {
    if target.selected_os() == "wasi" && target.selected_env() == "p2" && target.selected_arch() == "wasm32" {
        return jet_http_server_run_listener_wasip2(^listener, ^mux, ^options, ^shutdown, ^dynamic_grace_ms, ^drain_deadline_ms, ^tls_conn)
    }
    // GATE #4565: kernel primitive
    #Unsafe("bounded native accept queue; synchronized worker counts, tracked socket cancellation and joined worker lifetimes") {
        listener.set_nonblocking(true).map_err(error -> "http listener setup failed: {error}")?
        (tx, rx) :: mpsc.sync_channel<(TcpStream, IpAddr)>(options.admission_queue)
        rx :: Arc.new(Mutex.new(^rx))
        active :: Arc.new(Mutex.new([TcpStream].new()))
        completed :: Arc.new(AtomicUsize.new(0))
        force_cancel :: Arc.new(AtomicBool.new(false))
        connection_count :: Arc.new(AtomicUsize.new(0))
        per_ip :: Arc.new(Mutex.new([IpAddr:Int].new()))
        drain_deadline_ms :: drain_deadline_ms.unwrap_or_else(() -> Arc.new(AtomicU64.new(U64{0})))
        workers := []
        for _ in 0..options.workers.max(1) {
            worker_rx :: rx.clone()
            worker_mux :: mux.clone()
            worker_options :: options.clone()
            worker_active :: active.clone()
            worker_completed :: completed.clone()
            worker_force_cancel :: force_cancel.clone()
            worker_shutdown :: shutdown.clone()
            worker_grace :: dynamic_grace_ms.clone()
            worker_deadline :: drain_deadline_ms.clone()
            worker_connection_count :: connection_count.clone()
            worker_per_ip :: per_ip.clone()
            worker_tls :: tls_conn.clone()
            workers.push(thread.spawn(() -> {
                loop {
                    received :: worker_rx.lock().unwrap().recv()
                    (stream, peer_ip) := match received { .Ok(pair) -> pair, .Err(_) -> break }
                    if worker_force_cancel.load(Ordering.Acquire) {
                        _ :: stream.shutdown(Shutdown.Both)
                    } else {
                        peer :: stream.peer_addr().ok()
                        match stream.try_clone() { .Ok(tracked) -> worker_active.lock().unwrap().push(^tracked), .Err(_) -> {} }
                        jet_scheduler_with_root_control(() -> {
                            if worker_tls is .Some(tls) {
                                _ :: tls(^stream, worker_shutdown.clone(), worker_options.clone(), worker_grace.clone(), worker_deadline.clone())
                            } else {
                                jet_http_server_handle_stream(&stream, &worker_mux, &worker_options, &worker_shutdown, worker_grace.as_deref(), Some(worker_deadline.as_ref()))
                            }
                        })
                        worker_completed.fetch_add(1, Ordering.Relaxed)
                        worker_active.lock().unwrap().retain(tracked -> tracked.peer_addr().ok() != peer)
                    }
                    worker_connection_count.fetch_sub(1, Ordering.AcqRel)
                    counts := worker_per_ip.lock().unwrap()
                    if counts.get_mut(&peer_ip) is .Some(count) {
                        *count -= 1
                        if *count == 0 { counts.remove(&peer_ip) }
                    }
                }
            }))
        }
        report := JetHTTPShutdownReport.default()
        accept_error := None
        while !shutdown.load(Ordering.Acquire) {
            if jet_scheduler_wait_point_cancelled() {
                shutdown.store(true, Ordering.Release)
                break
            }
            match listener.accept() {
                .Ok((stream, peer)) -> {
                    if stream.set_nonblocking(false) is .Err(error) {
                        _ :: stream.shutdown(Shutdown.Both)
                        shutdown.store(true, Ordering.Release)
                        force_cancel.store(true, Ordering.Release)
                        if active.lock() is .Ok(active_streams) {
                            for active_stream in active_streams.iter() { _ :: active_stream.shutdown(Shutdown.Both) }
                        }
                        accept_error = Some("http accepted stream setup failed: {error}")
                        break
                    }
                    peer_ip :: peer.ip()
                    globally_full :: connection_count.load(Ordering.Acquire) >= options.max_connections
                    ip_full :: per_ip.lock().unwrap().get(&peer_ip).copied().unwrap_or(0) >= options.max_connections_per_ip
                    if globally_full || ip_full {
                        report.user_overloaded += 1
                        _ :: stream.set_read_timeout(Some(Duration.from_millis(U64{10})))
                        discard := [U8].filled(8192, U8{0})
                        _ :: stream.read(&discard)
                        _ :: stream.write_all(b"HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
                        _ :: stream.flush()
                        _ :: stream.shutdown(Shutdown.Write)
                        continue
                    }
                    connection_count.fetch_add(1, Ordering.AcqRel)
                    *per_ip.lock().unwrap().entry(peer_ip).or_insert(0) += 1
                    match tx.try_send((^stream, peer_ip)) {
                        .Ok(()) -> report.user_accepted += 1,
                        .Err(mpsc.TrySendError.Full((stream, peer_ip))) -> {
                            connection_count.fetch_sub(1, Ordering.AcqRel)
                            counts := per_ip.lock().unwrap()
                            if counts.get_mut(&peer_ip) is .Some(count) {
                                *count -= 1
                                if *count == 0 { counts.remove(&peer_ip) }
                            }
                            drop(^counts)
                            report.user_overloaded += 1
                            _ :: stream.set_read_timeout(Some(Duration.from_millis(U64{10})))
                            discard := [U8].filled(8192, U8{0})
                            _ :: stream.read(&discard)
                            _ :: stream.write_all(b"HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
                            _ :: stream.flush()
                            _ :: stream.shutdown(Shutdown.Write)
                        },
                        .Err(mpsc.TrySendError.Disconnected((_stream, peer_ip))) -> {
                            connection_count.fetch_sub(1, Ordering.AcqRel)
                            counts := per_ip.lock().unwrap()
                            if counts.get_mut(&peer_ip) is .Some(count) {
                                *count -= 1
                                if *count == 0 { counts.remove(&peer_ip) }
                            }
                            break
                        },
                    }
                },
                .Err(error) if error.kind() == ErrorKind.WouldBlock -> thread.sleep(Duration.from_millis(U64{2})),
                .Err(error) -> {
                    accept_error = Some("http accept failed: {error}")
                    force_cancel.store(true, Ordering.Release)
                    for stream in active.lock().unwrap().iter() { _ :: stream.shutdown(Shutdown.Both) }
                    break
                },
            }
        }
        drop(^tx)
        grace :: dynamic_grace_ms.as_ref().map(value -> Duration.from_millis(value.load(Ordering.Acquire))).unwrap_or(options.shutdown_grace)
        existing :: drain_deadline_ms.load(Ordering.Acquire)
        deadline_ms :: if existing > U64{0} { existing } else {
            computed :: jet_http_unix_now_ms().saturating_add(grace.as_millis() as U64)
            drain_deadline_ms.store(computed, Ordering.Release)
            computed
        }
        deadline :: jet_http_instant_from_unix_ms(deadline_ms)
        while accept_error.is_none() && completed.load(Ordering.Acquire) < report.user_accepted as Int && Instant.now() < deadline {
            thread.sleep(Duration.from_millis(U64{2}))
        }
        // Let H2 observe the shared deadline after its polling read timeout.
        observe :: deadline + Duration.from_millis(U64{30})
        while accept_error.is_none() && completed.load(Ordering.Acquire) < report.user_accepted as Int && Instant.now() < observe {
            thread.sleep(Duration.from_millis(U64{2}))
        }
        report.user_completed = completed.load(Ordering.Acquire).min(report.user_accepted as Int) as Int
        report.user_cancelled = report.user_accepted.saturating_sub(report.user_completed)
        if report.user_cancelled > 0 {
            force_cancel.store(true, Ordering.Release)
            for stream in active.lock().unwrap().iter() { _ :: stream.shutdown(Shutdown.Both) }
        }
        for worker in workers { _ :: worker.join() }
        if accept_error is .Some(error) { return Err(^error) }
        Ok(report)
    }
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:2338
fn jet_http_server_run_listener_wasip2(listener: TcpListener, mux: JetHTTPMux, options: JetHTTPServerOptions, shutdown: Arc<AtomicBool>, dynamic_grace_ms: Arc<AtomicU64>?, drain_deadline_ms: Arc<AtomicU64>?, tls_conn: JetHTTPTlsConn?) -> JetHTTPShutdownReport Err! {
    // GATE #4565: kernel primitive
    #Unsafe("WASI Preview 2 accept is single-threaded; preserve protocol and cancellation without native thread spawn") {
        listener.set_nonblocking(true).map_err(error -> "http listener setup failed: {error}")?
        drain_deadline_ms :: drain_deadline_ms.unwrap_or_else(() -> Arc.new(AtomicU64.new(U64{0})))
        report := JetHTTPShutdownReport.default()
        while !shutdown.load(Ordering.Acquire) {
            if jet_scheduler_wait_point_cancelled() { shutdown.store(true, Ordering.Release); break }
            match listener.accept() {
                .Ok((stream, _peer)) -> {
                    report.user_accepted += 1
                    stream.set_nonblocking(false).map_err(error -> "http connection setup failed: {error}")?
                    if tls_conn.as_ref() is .Some(tls) {
                        if tls(^stream, shutdown.clone(), options.clone(), dynamic_grace_ms.clone(), drain_deadline_ms.clone()) is .Err(error) { eprintln("E2801: Connection failed: {error}") }
                    } else { jet_http_server_handle_stream_wasip2(&stream, &mux, &options) }
                    report.user_completed += 1
                },
                .Err(error) if error.kind() == ErrorKind.WouldBlock -> thread.sleep(Duration.from_millis(U64{2})),
                .Err(error) -> return Err("http accept failed: {error}"),
            }
        }
        report.user_cancelled = report.user_accepted.saturating_sub(report.user_completed)
        Ok(report)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:2399
fn jet_http_server_handle_stream_wasip2(stream: &TcpStream, mux: &JetHTTPMux, options: &JetHTTPServerOptions) -> {
    // GATE #4565: kernel primitive
    #Unsafe("borrow accepted WASI stream for bounded request read and response write") {
        raw :: match jet_http_srv_read_with_limits(stream, options) {
            .Ok(raw) -> raw,
            .Err(error) -> { _ :: stream.write_all(jet_http_srv_read_error_response(&error).as_bytes()); return },
        }
        request :: match jet_http_srv_parse(&raw) {
            .Ok(request) -> request,
            .Err(error) -> { _ :: stream.write_all(jet_http_srv_read_error_response(&error).as_bytes()); return },
        }
        response :: jet_http_mux_dispatch(mux, ^request).unwrap_or_else(jet_http_srv_error_response)
        _ :: jet_http_srv_write_response(stream, &response, "HTTP/1.1", true)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:2424
fn jet_http_unix_now_ms() -> U64 {
    // GATE #4565: kernel primitive
    #Unsafe("sample native wall clock relative to UNIX epoch") {
        SystemTime.now().duration_since(UNIX_EPOCH).map(duration -> duration.as_millis() as U64).unwrap_or(U64{0})
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:2431
fn jet_http_instant_from_unix_ms(deadline_ms: U64) -> Instant {
    // GATE #4565: kernel primitive
    #Unsafe("convert wall deadline to native monotonic instant at a single sampling point") {
        now :: Instant.now()
        now_ms :: jet_http_unix_now_ms()
        if deadline_ms <= now_ms { now } else { now + Duration.from_millis(deadline_ms - now_ms) }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:2441
fn jet_http_server_handle_stream(stream: &TcpStream, mux: &JetHTTPMux, options: &JetHTTPServerOptions, shutdown: &AtomicBool, dynamic_grace_ms: &AtomicU64?, drain_deadline_ms: &AtomicU64?) -> {
    // GATE #4565: kernel primitive
    #Unsafe("native socket timeout and shutdown; preserve connection loan and WebSocket guard during dispatch") {
        _ :: stream.set_write_timeout(Some(options.write_idle_timeout))
        if jet_http2_is_preface(stream, options.read_header_timeout) {
            (result, last_stream) :: jet_http2_serve_with_last_stream(stream, mux, options, shutdown, dynamic_grace_ms, drain_deadline_ms)
            if result.is_err() {
                _ :: jet_http2_write_frame(stream, U8{7}, U8{0}, U32{0}, &jet_http2_goaway_payload(last_stream, U32{1}))
                _ :: stream.flush()
            }
            _ :: stream.shutdown(Shutdown.Both)
            return
        }
