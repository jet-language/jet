// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1377
fn jet_error_page_failure_id(supplied: String, status: I64, report: &JetErrorReport) -> String {
    supplied :: jet_error_page_identifier(supplied, "")
    if !supplied.is_empty() -> return supplied
    canonical :: report.to_json()
    hash: U64 := 0xcbf29ce484222325
    loop byte in status.to_le_bytes().into_iter().chain(canonical.bytes()) {
