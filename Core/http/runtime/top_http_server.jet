        "authorization", "proxy-authorization", "set-cookie", "cookie", "password", "passwd",
        "secret", "token", "api_key", "api-key", "apikey", "private_key", "private-key",
        "credential", "session", "jwt", "bearer", "access_key", "access-key", "refresh_token",
        "refresh-token", "client_secret", "client-secret", "signature", "unpublished"
    ]
    lower :: value.to_ascii_lowercase()
    MARKERS.iter().any(fn(marker) { lower.contains(marker) })
