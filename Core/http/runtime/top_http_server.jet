        source_frame :: self.source_frame.as_ref().map(fn(frame) {
            fn_name :: jet_error_page_json_quote(frame.fn_name)
            file :: jet_error_page_json_quote(frame.file)
            note :: jet_error_page_json_quote(frame.note)
            "{{\"fn_name\":{fn_name},\"file\":{file},\"line\":{frame.line},\"note\":{note}}}"
        }).unwrap_or_else(fn() { "null" })
        context :: self.context.iter().map(fn(frame) {
            text :: jet_error_page_json_quote(frame.text)
            file :: jet_error_page_json_quote(frame.file)
            "{{\"text\":{text},\"file\":{file},\"line\":{frame.line}}}"
        }).collect<[String]>().join(",")
        links :: self.correlation_links.iter().map(fn(link) { jet_error_page_json_quote(link) }).collect<[String]>().join(",")
        failure_id :: jet_error_page_json_quote(self.failure_id)
        request_id :: jet_error_page_json_quote(self.request_id)
        message :: jet_error_page_json_quote(self.message)
        "{{\"schema\":\"jet.err/v1\",\"status\":{self.status},\"failure_id\":{failure_id},\"request_id\":{request_id},\"message\":{message},\"code\":{code},\"source_frame\":{source_frame},\"context\":[{context}],\"correlation_links\":[{links}]}}"
    }
