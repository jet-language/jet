// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:890
fn jet_http_route_schema_matches(value: &DataTree, schema: &DataTree) -> Bool {
    schema_object :: jet_http_contract_object(schema) ?? return false
    if Some(any_of) :: jet_http_contract_field(schema_object, "anyOf") {
        return match any_of {
            DataTree.Array(items) -> items.iter().any(fn(candidate) { jet_http_route_schema_matches(value, candidate) })
            _ -> false
        }
    }
    if Some(one_of) :: jet_http_contract_field(schema_object, "oneOf") {
        return match one_of {
            DataTree.Array(items) -> items.iter().filter(fn(candidate) { jet_http_route_schema_matches(value, candidate) }).count() == 1
            _ -> false
        }
    }
    kind :: jet_http_contract_text(schema_object, "type") ?? return true
    match kind {
        "null" -> match value { DataTree.Null -> true, _ -> false }
        "boolean" -> match value { DataTree.Bool(_) -> true, _ -> false }
        "integer" -> match value {
            DataTree.Int(_) -> true
            DataTree.Number(number) -> number.parse<I64>().is_ok()
            _ -> false
        }
        "number" -> match value { DataTree.Int(_) | DataTree.Float(_) | DataTree.Number(_) -> true, _ -> false }
        "string" -> match value { DataTree.Text(_) | DataTree.TypedText(_) -> true, _ -> false }
        "array" -> {
            items :: match value { DataTree.Array(items) -> items, _ -> return false }
            item_schema :: jet_http_contract_field(schema_object, "items") ?? return false
            items.iter().all(fn(item) { jet_http_route_schema_matches(item, item_schema) })
        }
        "object" -> {
            fields :: match value { DataTree.Object(fields) -> fields, _ -> return false }
            properties :: jet_http_contract_field(schema_object, "properties").and_then(jet_http_contract_object) ?? return false
            additional_properties :: match jet_http_contract_field(schema_object, "additionalProperties") {
                Some(DataTree.Bool(value)) -> *value
                None -> true
                _ -> false
            }
            required :: match jet_http_contract_field(schema_object, "required") {
                None -> []
                Some(DataTree.Array(names)) -> names.iter().filter_map(fn(name) {
                    match name { DataTree.Text(name) | DataTree.TypedText(name) -> Some(name.as_str()), _ -> None }
                }).collect<[String]>()
                Some(_) -> return false
            }
            if required.iter().any(fn(name) { !fields.iter().any(fn((field, _)) { field == *name }) }) -> return false
            fields.iter().all(fn((name, field_value)) {
                field_schema :: properties.iter().find(fn((property, _)) { property == name })
                match field_schema {
                    Some((_, schema)) -> jet_http_route_schema_matches(field_value, schema)
                    None -> additional_properties
                }
            })
        }
        _ -> false
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:995
fn jet_http_route_validate_body(request: JetHTTPRequest, contract_json: String) -> JetHTTPRequest ()! {
    request := ^request
    contract :: parse_json_strict(&contract_json).map_err(fn(_) { () })?
    contract_object :: jet_http_contract_object(&contract).ok_or(())?
    request_body :: jet_http_contract_field(contract_object, "request_body").ok_or(())?
    request_body_object :: match request_body {
        DataTree.Null -> return Ok(^request)
        value -> jet_http_contract_object(value).ok_or(())?
    }
    required :: match jet_http_contract_field(request_body_object, "required") {
        Some(DataTree.Bool(value)) -> *value
        _ -> return Err(())
    }
    schema :: jet_http_contract_field(request_body_object, "schema").ok_or(())?
    content_type :: request.body.content_type()
    bytes :: request.body.bytes(jet_http_default_body_limit() as Usize).map_err(fn(_) { () })?
    if bytes.is_empty() && !required {
        request.body = JetHTTPBody.from_bytes_with_content_type(^bytes, content_type)
        return Ok(^request)
    }
    text :: String.from_utf8(bytes.clone()).map_err(fn(_) { () })?
    value :: parse_json_typed_datatree(text).map_err(fn(_) { () })?
    if !jet_http_route_schema_matches(&value, schema) -> return Err(())
    request.body = JetHTTPBody.from_bytes_with_content_type(^bytes, content_type)
    Ok(^request)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1029
fn jet_http_require_route_contract(method: String, pattern: String, contract_json: String, file: String, line: U32, allow_empty_responses: Bool) -> {
    if contract_json.trim().is_empty() {
        jet_panic(&file, line, &"E2805: route `{method} {pattern}` has no checked endpoint contract")
    }
    contract :: match parse_json_strict(&contract_json) {
        Ok(contract) -> contract
        Err(_) -> jet_panic(&file, line, &"E2805: route `{method} {pattern}` has an invalid checked endpoint contract")
    }
    contract_object :: jet_http_contract_object(&contract) ?? jet_panic(&file, line, &"E2805: route `{method} {pattern}` has a non-object endpoint contract")
    required_fields :: ["method", "pattern", "path", "operation_id", "summary", "parameters", "request_body", "responses", "security", "provenance"]
    if required_fields.iter().any(fn(field) { jet_http_contract_field(contract_object, field).is_none() }) {
        jet_panic(&file, line, &"E2805: route `{method} {pattern}` has an incomplete endpoint contract")
    }
    if jet_http_contract_text(contract_object, "method") != Some(&method) || jet_http_contract_text(contract_object, "pattern") != Some(&pattern) {
        jet_panic(&file, line, &"E2805: route `{method} {pattern}` does not match its endpoint contract")
    }
    responses :: match jet_http_contract_field(contract_object, "responses") {
        Some(DataTree.Array(responses)) -> responses
        _ -> jet_panic(&file, line, &"E2805: route `{method} {pattern}` has invalid endpoint responses")
    }
    if responses.is_empty() && !allow_empty_responses {
        jet_panic(&file, line, &"E2805: route `{method} {pattern}` has no endpoint responses")
    }
    match jet_http_contract_field(contract_object, "parameters") {
        Some(DataTree.Array(_)) -> {}
        _ -> jet_panic(&file, line, &"E2805: route `{method} {pattern}` has invalid endpoint parameters")
    }
    match jet_http_contract_field(contract_object, "security") {
        Some(DataTree.Array(_)) -> {}
        _ -> jet_panic(&file, line, &"E2805: route `{method} {pattern}` has invalid endpoint security policy")
    }
    match jet_http_contract_field(contract_object, "request_body") {
        Some(DataTree.Null) -> {}
        Some(DataTree.Object(body)) -> {
            valid_required :: match jet_http_contract_field(body.as_slice(), "required") { Some(DataTree.Bool(_)) -> true, _ -> false }
            valid_content_type :: jet_http_contract_text(body.as_slice(), "content_type").is_some_and(fn(value) { !value.is_empty() })
            valid_schema :: jet_http_contract_field(body.as_slice(), "schema").is_some_and(fn(schema) { jet_http_contract_object(schema).is_some() })
            if !(valid_required && valid_content_type && valid_schema) {
                jet_panic(&file, line, &"E2805: route `{method} {pattern}` has an invalid endpoint request body")
            }
        }
        Some(_) | None -> jet_panic(&file, line, &"E2805: route `{method} {pattern}` has an invalid endpoint request body")
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1184
fn jet_http_mux_register(mux: &JetHTTPMux, method: String, pattern: String, handler: JetHTTPHandler, file: String, line: U32, contract_json: String) -> {
    jet_http_require_route_contract(method, pattern, contract_json, file, line, true)
    segments :: match jet_http_router_parse_pattern(&pattern) { Ok(segments) -> segments, Err(message) -> jet_panic(&file, line, &message) }
    shape :: jet_http_route_shape(&JetHTTPRoutePattern{segments: segments.clone()})
    // GATE #4565: kernel primitive
    duplicate :: #Unsafe("inspect registered native mux routes under its mutex without retaining references after unlock") {
        mux.0.lock().unwrap().iter()
            .filter(fn(route) { route.method == method })
            .filter_map(fn(route) {
                existing :: jet_http_router_parse_pattern(&route.pattern).ok()?
                Some(jet_http_route_shape(&JetHTTPRoutePattern{segments: ^existing}))
            }).any(fn(existing) { existing == shape })
    }
    if duplicate -> jet_panic(&file, line, &"E2804: duplicate route `{method} {pattern}`")
    mux.add_handler_with_contract(method, pattern, ^handler, ^contract_json)
}
