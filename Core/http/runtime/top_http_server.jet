// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1241
fn jet_http_srv_response_owned(status: I64, body: String) -> JetHTTPResponse {
    (status, body) :: if !(100..=599).contains(&status) { (I64{500}, "500 Internal Server Error") } else { (status, ^body) }
    JetHTTPResponse{
        status: status, version: "HTTP/1.1", body: JetHTTPBody.from_text(^body),
        headers: JetHTTPHeaders.new(), trailers: JetHTTPHeaders.new(),
        head_content_length: None, suppress_body: false, protocol: "HTTP/1.1",
        remote_address: "", redirect_history: [], timings_ms: [],
        reused_connection: false, raw_content_encoding: None
    }
}

