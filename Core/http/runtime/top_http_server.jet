// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1666
// Release builds and non-local callers receive the bounded generic view, regardless of requested details.
fn jet_error_page_projection(status: I64, failure_id: String, request_id: String, report: &JetErrorReport, correlation_links: &[String], local: Bool) -> JetErrorPageProjection {
    status :: jet_error_page_status(status)
    failure_id :: jet_error_page_failure_id(failure_id, status, report)
    request_id :: jet_error_page_identifier(request_id, "request-unknown")
    // GATE #4565: kernel primitive
    local :: local && #Unsafe("query the selected compilation profile, never disclose local source context in release builds") { std.cfg.debug_assertions() }
    (message, code, source_frame, context, correlation_links) :: if local {
        message :: jet_error_page_safe_text(report.message, JET_ERROR_PAGE_MAX_MESSAGE_BYTES)
        message :: if message.is_empty() { jet_error_page_status_text(status) } else { ^message }
        code :: report.code.as_ref().map(fn(code) { jet_error_page_identifier(code, "ERR") })
        links :: correlation_links.iter().take(JET_ERROR_PAGE_MAX_LINKS).filter_map(fn(link) { jet_error_page_link(link) }).collect<[String]>()
        (message, code, jet_error_page_source(report), jet_error_page_context(report), links)
    } else {
        (jet_error_page_status_text(status), None, None, [], [])
    }
    JetErrorPageProjection{
        status: status, failure_id: ^failure_id, request_id: ^request_id, message: ^message,
        code: ^code, source_frame: ^source_frame, context: ^context, correlation_links: ^correlation_links
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1730
fn jet_http_accept_quality(value: String) -> U16 {
    value := value.trim() // #4303
    if value == "1" -> return 1000
    if Some(fraction) :: value.strip_prefix("1.") {
        return if !fraction.is_empty() && fraction.bytes().all(fn(byte) { byte == U8{48} }) { 1000 } else { 0 }
    }
    fraction :: value.strip_prefix("0.") ?? return 0
    if fraction.is_empty() || fraction.len() > 3 || !fraction.bytes().all(fn(byte) { byte.is_ascii_digit() }) -> return 0
    quality: U16 := 0
    loop byte in fraction.bytes() -> quality = quality.saturating_mul(10).saturating_add((byte - U8{48}) as U16)
    quality * match fraction.len() { 1 -> 100, 2 -> 10, _ -> 1 }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1759
// Explicit types outrank wildcards; equal-quality explicit types retain client order.
fn jet_http_error_page_accepts_json(accept: &String?) -> Bool {
    accept :: accept ?? return false
    found := false
    best_quality: U16 := 0
    best_specificity: U8 := 0
    best_json := false
    loop item in accept.split(',') {
        parameters := item.split(';')
        media :: parameters.next().unwrap_or("").trim().to_ascii_lowercase()
        quality: U16 := 1000
        loop parameter in parameters {
            (name, value) :: parameter.trim().split_once('=') ?? continue
            if name.trim().eq_ignore_ascii_case("q") -> quality = jet_http_accept_quality(value)
        }
        if quality == 0 -> continue
        (supported, specificity, is_json) :: match media.as_str() {
            "application/json" -> (true, U8{2}, true)
            "text/html" -> (true, U8{2}, false)
            "application/*" -> (true, U8{1}, true)
            "text/*" -> (true, U8{1}, false)
            "*/*" -> (true, U8{0}, false)
            _ -> (false, U8{0}, false)
        }
        if !supported -> continue
        if !found || quality > best_quality || (quality == best_quality && specificity > best_specificity) {
            found = true
            best_quality = quality
            best_specificity = specificity
            best_json = is_json
        }
    }
    found && best_json
}

