fn jet_http_route_query_param(req: &JetHTTPRequest, name: String) -> String? ()! {
    query :: match req.path.split_once('?') {
        Some((_, query)) -> query
        None -> return Ok(None)
    }
    loop pair in query.split('&') {
        (raw_key, raw_value) :: pair.split_once('=').unwrap_or((pair, ""))
        key :: raw_key.replace('+', " ")
        key :: jet_http_route_decode_path_segment(key).map_err(fn(_) { () })?.into_owned()
        if key != name -> continue
        value :: raw_value.replace('+', " ")
        return Ok(Some(jet_http_route_decode_path_segment(value).map_err(fn(_) { () })?.into_owned()))
    }
    Ok(None)
}
