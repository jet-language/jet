fn jet_error_page_bounded(value: String, limit: Usize) -> String {
    output := String.new()
    loop character in value.chars() {
        character :: if character.is_control() || character as U32 == 127 { ' ' } else { character }
        if output.len().saturating_add(character.len_utf8()) > limit -> break
        output.push(character)
    }
    trimmed := output.trim() // #4303
    trimmed.to_string()
}
