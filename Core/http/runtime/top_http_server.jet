                if lengths.len().saturating_add(repeats) > total -> return Err(jet_http_gzip_invalid())
                lengths.extend(repeat_n(U8{0}, repeats))
            }
            18 -> {
                repeats :: bits.read(7)? as Usize + 11
                if lengths.len().saturating_add(repeats) > total -> return Err(jet_http_gzip_invalid())
                lengths.extend(repeat_n(U8{0}, repeats))
