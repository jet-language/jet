// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1399
fn jet_error_page_source(report: &JetErrorReport) -> JetErrorPageSourceFrame? {
    report.origin.iter().chain(&report.source_journey).next().map(fn(frame) {
        JetErrorPageSourceFrame{
            fn_name: jet_error_page_safe_text(frame.fn_name, JET_ERROR_PAGE_MAX_SOURCE_BYTES),
            file: jet_error_page_bounded(frame.file, JET_ERROR_PAGE_MAX_SOURCE_BYTES),
            line: frame.line,
            note: jet_error_page_safe_text(frame.note, JET_ERROR_PAGE_MAX_MESSAGE_BYTES)
        }
    }).or_else(fn() {
        report.context_frames.first().map(fn(frame) {
            JetErrorPageSourceFrame{
                fn_name: "", file: jet_error_page_bounded(frame.file, JET_ERROR_PAGE_MAX_SOURCE_BYTES),
                line: frame.line, note: jet_error_page_safe_text(frame.text, JET_ERROR_PAGE_MAX_MESSAGE_BYTES)
            }
        })
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1427
fn jet_error_page_context(report: &JetErrorReport) -> [JetErrorPageContext] {
    context := []
    bytes: Usize := 0
    loop frame in report.context_frames.iter().take(JET_ERROR_PAGE_MAX_CONTEXT) {
        text :: jet_error_page_safe_text(frame.text, JET_ERROR_PAGE_MAX_MESSAGE_BYTES)
        file :: jet_error_page_bounded(frame.file, JET_ERROR_PAGE_MAX_SOURCE_BYTES)
        item_bytes :: text.len().saturating_add(file.len()).saturating_add(16)
        if bytes.saturating_add(item_bytes) > JET_ERROR_PAGE_MAX_CONTEXT_BYTES -> break
        bytes = bytes.saturating_add(item_bytes)
        context.push(JetErrorPageContext{text: ^text, file: ^file, line: frame.line})
    }
    ^context
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1447
fn jet_error_page_link(value: String) -> String? {
    if value.chars().any(fn(character) { character.is_control() }) || jet_error_page_sensitive(value) -> return None
    link :: jet_error_page_bounded(value, JET_ERROR_PAGE_MAX_LINK_BYTES)
    lower :: link.to_ascii_lowercase()
    if link.is_empty() || lower.starts_with("javascript:") || lower.starts_with("data:")
        || lower.starts_with("vbscript:") || lower.starts_with("file:")
        || !(link.starts_with('/') || lower.starts_with("http://") || lower.starts_with("https://") || lower.starts_with("jet://")) {
        None
    } else { Some(^link) }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1469
fn jet_error_page_json_quote(value: String) -> String {
    output := String.with_capacity(value.len().saturating_add(2))
    output.push('"')
    loop character in value.chars() {
        match character {
            '\\' -> output.push_str("\\\\")
            '"' -> output.push_str("\\\"")
            '\n' -> output.push_str("\\n")
            '\r' -> output.push_str("\\r")
            '\t' -> output.push_str("\\t")
            character if character.is_control() -> {
                scalar :: character as U32
                output.push_str("\\u{scalar:04x}")
            }
            character -> output.push(character)
        }
    }
    output.push('"')
    ^output
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1489
fn jet_error_page_html_escape(value: String) -> String {
    output := String.with_capacity(value.len())
    loop character in value.chars() {
        match character {
            '&' -> output.push_str("&amp;")
            '<' -> output.push_str("&lt;")
            '>' -> output.push_str("&gt;")
            '"' -> output.push_str("&quot;")
            '\'' -> output.push_str("&#39;")
            character -> output.push(character)
        }
    }
    ^output
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1504
fn jet_error_page_status_text(status: I64) -> String {
    match status {
        400 -> "Bad Request"
        401 -> "Unauthorized"
        403 -> "Forbidden"
        404 -> "Not Found"
        405 -> "Method Not Allowed"
        408 -> "Request Timeout"
        409 -> "Conflict"
        413 -> "Payload Too Large"
        415 -> "Unsupported Media Type"
        422 -> "Unprocessable Content"
        429 -> "Too Many Requests"
        500 -> "Internal Server Error"
        501 -> "Not Implemented"
        502 -> "Bad Gateway"
        503 -> "Service Unavailable"
        504 -> "Gateway Timeout"
        _ if (400..=499).contains(&status) -> "Client Error"
        _ if (500..=599).contains(&status) -> "Server Error"
        _ -> "HTTP Error"
    }
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1528
impl JetErrorPageProjection {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs:1529
    fn json(self) -> String {
