// core.http.client — configured HTTP client.
//
// The canonical request/response carriers and transport builders come from
// core.http.client. This source module owns deterministic configuration and
// session policy around those provider leaves.

use core as core
use core.http as http
use core.http.[HTTPError, HTTPRequest, HTTPResponse]
use core.http.client as provider
use core.net.url as http_url
C_MAX_BODY_BYTES :: 1048576
C_MAX_URL_BYTES :: 8192
C_MAX_REDIRECTS :: 10
C_MAX_RETRIES :: 1

pub struct Client {
    pub method: String
    pub url: String
    pub headers: [String]
    pub redirects: Int
    pub proxy: String
}

pub struct Proxy { pub url: String }
pub enum RedirectPolicy {
    Disabled
    Limited
    All
}

pub struct Session {
    pub headers: [String]
    pub cookies: [String]
    pub timeout_ms: Int
    pub retries: Int
    pub redirects: Int
    pub user: String
    pub password: String
    pub proxy: String
}
pub fn get(url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    http.get(url)
}

pub fn post(url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    http.post(url, body)
}

pub fn request(method: String, url: String) -> HTTPRequest Never! {
    core.http.client.request(method, url)
}

pub fn send(req: HTTPRequest) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    req.send()
}

pub fn header(client: Client, line: String) -> Client {
    _ :: header_name(line) ?? return ~client
    _ :: header_value(line) ?? return ~client
    Client{
        method: ~client.method,
        url: ~client.url,
        headers: append_header(~client.headers, line),
        redirects: client.redirects,
        proxy: ~client.proxy,
    }
}

pub fn set_header(client: Client, name: String, value: String) -> Client {
    Client{
        method: ~client.method,
        url: ~client.url,
        headers: set_header_line(~client.headers, name, value),
        redirects: client.redirects,
        proxy: ~client.proxy,
    }
}
pub fn with_proxy(client: Client, proxy: Proxy) -> Client {
    Client{method: ~client.method, url: ~client.url, headers: ~client.headers, redirects: client.redirects, proxy: ~proxy.url}
}


pub fn timeout_redirects(client: Client, n: Int) -> Client {
    limit := n
    if limit < 0 -> limit = 0
    if limit > C_MAX_REDIRECTS -> limit = C_MAX_REDIRECTS
    Client{method: ~client.method, url: ~client.url, headers: ~client.headers, redirects: limit, proxy: ~client.proxy}
}

pub fn session() -> Session {
    Session{
        headers: [String]{},
        cookies: [String]{},
        timeout_ms: 30000,
        retries: 0,
        redirects: C_MAX_REDIRECTS,
        user: "",
        password: "",
        proxy: "",
    }
}

pub fn session_header(s: Session, name: String, value: String) -> Session Never! {
    Session{
        headers: set_header_line(~s.headers, name, value),
        cookies: ~s.cookies,
        timeout_ms: s.timeout_ms,
        retries: s.retries,
        redirects: s.redirects,
        user: ~s.user,
        password: ~s.password,
        proxy: ~s.proxy,
    }
}

pub fn session_timeout(s: Session, ms: Int) -> Session {
    t := ms
    if t < 0 -> t = 0
    Session{headers: ~s.headers, cookies: ~s.cookies, timeout_ms: t, retries: s.retries, redirects: s.redirects, user: ~s.user, password: ~s.password, proxy: ~s.proxy}
}

pub fn session_retries(s: Session, n: Int) -> Session {
    r := n
    if r < 0 -> r = 0
    if r > C_MAX_RETRIES -> r = C_MAX_RETRIES
    Session{headers: ~s.headers, cookies: ~s.cookies, timeout_ms: s.timeout_ms, retries: r, redirects: s.redirects, user: ~s.user, password: ~s.password, proxy: ~s.proxy}
}

pub fn session_redirects(s: Session, n: Int) -> Session {
    r := n
    if r < 0 -> r = 0
    if r > C_MAX_REDIRECTS -> r = C_MAX_REDIRECTS
    Session{headers: ~s.headers, cookies: ~s.cookies, timeout_ms: s.timeout_ms, retries: s.retries, redirects: r, user: ~s.user, password: ~s.password, proxy: ~s.proxy}
}

pub fn session_auth(s: Session, user: String, password: String) -> Session {
    Session{headers: ~s.headers, cookies: ~s.cookies, timeout_ms: s.timeout_ms, retries: s.retries, redirects: s.redirects, user: user, password: password, proxy: ~s.proxy}
}

pub fn session_proxy(s: Session, url: String) -> Session {
    Session{headers: ~s.headers, cookies: ~s.cookies, timeout_ms: s.timeout_ms, retries: s.retries, redirects: s.redirects, user: ~s.user, password: ~s.password, proxy: url}
}

pub fn session_cookie(s: Session, cookie: String) -> Session {
    if !valid_cookie_pair(cookie) -> return ~s
    cookies := [String]{}
    name :: cookie_name(cookie) ?? return ~s
    replaced := false
    loop c in s.cookies {
        current :: cookie_name(c) ?? next
        if current == name {
            &cookies.push(~cookie)
            replaced = true
        } else {
            &cookies.push(c)
        }
    }
    if !replaced -> &cookies.push(cookie)
    Session{headers: ~s.headers, cookies: cookies, timeout_ms: s.timeout_ms, retries: s.retries, redirects: s.redirects, user: ~s.user, password: ~s.password, proxy: ~s.proxy}
}

pub fn cookie_header(cookies: [String]) -> String Never! {
    s := ""
    first := true
    loop c in cookies {
        if !valid_cookie_pair(c) -> next
        if first {
            s = c
            first = false
        } else {
            s = "{s}; {c}"
        }
    }
    s
}

pub fn session_request(s: Session, method: String, url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    if !valid_method(method) -> return Err(.InvalidMethod)
    if !valid_url(url) -> return Err(.InvalidUrl)
    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_BODY_BYTES})
    if s.proxy.bytes().len() > 0 && !valid_url(s.proxy) -> return Err(.Proxy{stage: "invalid proxy"})
    h := session_headers(s)
    resp :: request_with_retries(s, method, url, body, h)
    session_follow(s, method, url, body, h, resp)
}

fn session_follow(s: Session, method: String, url: String, body: String, h: [String], first: HTTPResponse) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    hops := 0
    resp := first
    current_method := method
    current_url := url
    current_body := body
    headers := ~h
    loop {
        code := resp.status()
        if code < 300 || code >= 400 -> return Ok(~resp)
        if code != 301 && code != 302 && code != 303 && code != 307 && code != 308 -> return Ok(~resp)
        if hops >= s.redirects -> return Ok(~resp)
        loc :: &resp.header("Location") ?? return Ok(~resp)
        next :: resolve_location(current_url, loc) ?? return Err(.InvalidUrl)
        if is_https_downgrade(current_url, next) -> return Err(.Redirect{reason: "https downgrade"})
        on_same_origin := same_origin(current_url, next)
        preserve := code == 307 || code == 308
        if !preserve {
            current_method = "GET"
            current_body = ""
            headers = redirect_headers(headers, !on_same_origin)
        } else if !on_same_origin {
            headers = redirect_headers(headers, true)
        }
        retry :: request_with_retries(s, current_method, next, current_body, headers)
        resp = retry
        current_url = next
        hops = hops + 1
    }
}

fn request_with_retries(s: Session, method: String, url: String, body: String, headers: [String]) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    attempts := 0
    loop {
        if request_once(s, method, url, body, headers) == {
            .Ok(response) -> return Ok(response)
            .Err(error) -> {
                if attempts >= s.retries || !retryable_method(method) || !retryable_error(error) -> return Err(error)
                attempts = attempts + 1
            }
        }
    }
}

fn retryable_method(method: String) -> Bool Never! {
    u :: ascii_upper(method)
    u == "GET" || u == "HEAD" || u == "OPTIONS" || u == "TRACE" || u == "PUT" || u == "DELETE"
}

fn retryable_error(error: HTTPError) -> Bool Never! {
    if error == {
        .IO(_) -> true
        else -> false
    }
}

pub fn redirect_limit(policy: RedirectPolicy, fallback: Int) -> Int {
    if policy == {
        RedirectPolicy.Disabled -> return 0
        RedirectPolicy.All -> return C_MAX_REDIRECTS
        else -> { _ := 0 }
    }
    if fallback < 0 -> return 0
    if fallback > C_MAX_REDIRECTS -> return C_MAX_REDIRECTS
    fallback
}
pub fn session_get(s: Session, url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! { session_request(s, "GET", url, "") }
pub fn session_post(s: Session, url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! { session_request(s, "POST", url, body) }
pub fn session_put(s: Session, url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! { session_request(s, "PUT", url, body) }
pub fn session_patch(s: Session, url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! { session_request(s, "PATCH", url, body) }
pub fn session_delete(s: Session, url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! { session_request(s, "DELETE", url, "") }
pub fn session_head(s: Session, url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! { session_request(s, "HEAD", url, "") }

pub fn session_json(s: Session, url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    h := session_header(s, "Content-Type", "application/json")
    h2 := session_header(h, "Accept", "application/json")
    session_post(h2, url, body)
}

pub fn session_form(s: Session, url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    h := session_header(s, "Content-Type", "application/x-www-form-urlencoded")
    session_post(h, url, body)
}

fn request_once(s: Session, method: String, url: String, body: String, headers: [String]) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    req := provider.request(method, url)
    req = req.redirects(0)
    req = req.timeout(s.timeout_ms)
    if s.proxy.bytes().len() > 0 -> req = req.proxy(s.proxy)
    loop line in headers {
        name :: header_name(line) ?? return Err(.InvalidHeader)
        value :: header_value(line) ?? return Err(.InvalidHeader)
        req = &req.header(name, value)
    }
    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_BODY_BYTES})
    if body.bytes().len() > 0 -> req = req.body(body)
    req.send()
}

pub fn user_agent(client: Client, name: String) -> Client { set_header(client, "User-Agent", name) }
pub fn bearer(client: Client, token: String) -> Client { set_header(client, "Authorization", http.bearer_auth(token)) }
pub fn accept(client: Client, mime: String) -> Client { set_header(client, "Accept", mime) }
pub fn content_type(client: Client, mime: String) -> Client { set_header(client, "Content-Type", mime) }


fn session_headers(s: Session) -> [String] Never! {
    h := ~s.headers
    if s.user.bytes().len() > 0 -> h = set_header_line(h, "Authorization", http.basic_auth(s.user, s.password))
    jar :: cookie_header(~s.cookies)
    if jar.bytes().len() > 0 -> h = set_header_line(h, "Cookie", jar)
    h
}

fn header_name(line: String) -> String? {
    raw :: line.bytes()
    col := index_byte(raw, 58)
    if col <= 0 -> return None
    name :: slice_text(line, 0, col)
    if !valid_header_name(name) -> return None
    Val(name)
}

fn header_value(line: String) -> String? {
    raw :: line.bytes()
    col := index_byte(raw, 58)
    if col <= 0 -> return None
    value :: slice_text(line, col + 1, raw.len())
    if has_ctl(value.bytes()) -> return None
    Val(trim(value))
}

fn append_header(headers: [String], line: String) -> [String] {
    out := ~headers
    &out.push(line)
    out
}

fn set_header_line(headers: [String], name: String, value: String) -> [String] Never! {
    if !valid_header_name(name) || has_ctl(value.bytes()) -> return ~headers
    out := [String]{}
    want :: ascii_lower(name)
    replaced := false
    loop line in headers {
        current :: header_name(line) ?? next
        if ascii_lower(current) == want {
            if !replaced {
                &out.push("{name}: {value}")
                replaced = true
            }
        } else {
            &out.push(line)
        }
    }
    if !replaced -> &out.push("{name}: {value}")
    out
}

fn redirect_headers(headers: [String], strip_credentials: Bool) -> [String] Never! {
    out := [String]{}
    loop line in headers {
        name :: header_name(line) ?? next
        lower :: ascii_lower(name)
        credential := lower == "authorization" || lower == "proxy-authorization" || lower == "cookie" || lower == "host"
        body_header := lower == "content-length" || lower == "content-type" || lower == "content-encoding" || lower == "transfer-encoding" || lower == "expect"
        if !body_header && (!strip_credentials || !credential) -> &out.push(line)
    }
    out
}

fn valid_cookie_pair(cookie: String) -> Bool Never! {
    eq := index_byte(cookie.bytes(), 61)
    if eq <= 0 -> return false
    name :: slice_text(cookie, 0, eq)
    value :: slice_text(cookie, eq + 1, cookie.bytes().len())
    valid_cookie_token(name) && valid_cookie_value(value)
}

fn cookie_name(cookie: String) -> String? {
    eq := index_byte(cookie.bytes(), 61)
    if eq <= 0 -> return None
    Val(slice_text(cookie, 0, eq))
}

fn valid_cookie_token(name: String) -> Bool Never! {
    raw :: name.bytes()
    if raw.len() == 0 -> return false
    loop b in raw {
        n :: Int.from_u8(b)
        if n <= 32 || n >= 127 || n == 34 || n == 40 || n == 41 || n == 44 || n == 47 || n == 58 || n == 59 || n == 60 || n == 61 || n == 62 || n == 63 || n == 64 || n == 91 || n == 92 || n == 93 || n == 123 || n == 125 -> return false
    }
    true
}

fn valid_cookie_value(value: String) -> Bool Never! {
    loop b in value.bytes() {
        n :: Int.from_u8(b)
        if n <= 32 || n >= 127 || n == 34 || n == 44 || n == 59 || n == 92 -> return false
    }
    true
}

fn resolve_location(base: String, location: String) -> String? {
    if location.bytes().len() == 0 -> return None
    joined :: http_url.urljoin(base, location) ?? return None
    hash := index_byte(joined.bytes(), 35)
    clean := if hash >= 0 -> slice_text(joined, 0, hash) else -> joined
    if !valid_url(clean) -> return None
    Val(clean)
}

fn is_https_downgrade(base: String, next: String) -> Bool Never! {
    from :: http_url.parse(base) ?? return false
    to :: http_url.parse(next) ?? return false
    from.scheme == "https" && to.scheme == "http"
}

fn same_origin(left: String, right: String) -> Bool Never! {
    a :: http_url.parse(left) ?? return false
    b :: http_url.parse(right) ?? return false
    a.scheme == b.scheme && a.host == b.host && a.port == b.port
}

fn slice_text(text: String, start: Int, end: Int) -> String Never! {
    raw :: text.bytes()
    out := [U8]{}
    i := start
    loop {
        if i < 0 || i >= end || i >= raw.len() -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}


fn ascii_upper(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        if n >= 97 && n <= 122 -> &out.push(U8{n - 32}) else -> &out.push(b)
    }
    String.from_bytes(out) ?? text
}
fn ascii_lower(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        if n >= 65 && n <= 90 -> &out.push(U8{n + 32}) else -> &out.push(b)
    }
    String.from_bytes(out) ?? text
}

fn trim(text: String) -> String Never! {
    raw :: text.bytes()
    start := 0
    end := raw.len()
    loop start < end {
        n :: Int.from_u8(raw[start])
        if n == 32 || n == 9 || n == 13 || n == 10 -> start = start + 1 else -> break
    }
    loop end > start {
        n :: Int.from_u8(raw[end - 1])
        if n == 32 || n == 9 || n == 13 || n == 10 -> end = end - 1 else -> break
    }
    if end <= start -> return ""
    slice_text(text, start, end)
}

fn index_byte(raw: [U8], target: Int) -> Int Never! {
    loop i in 0..<raw.len() {
        if Int.from_u8(raw[i]) == target -> return i
    }
    -1
}

fn valid_header_name(name: String) -> Bool Never! {
    raw :: name.bytes()
    if raw.len() == 0 -> return false
    loop b in raw {
        if !token_char(Int.from_u8(b)) -> return false
    }
    true
}

fn token_char(n: Int) -> Bool Never! {
    (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 33 || n == 35 || n == 36 || n == 37 || n == 38 || n == 39 || n == 42 || n == 43 || n == 45 || n == 46 || n == 94 || n == 95 || n == 96 || n == 124 || n == 126
}

fn valid_method(method: String) -> Bool Never! {
    raw :: method.bytes()
    if raw.len() == 0 -> return false
    loop b in raw {
        if !token_char(Int.from_u8(b)) -> return false
    }
    true
}

fn has_ctl(raw: [U8]) -> Bool Never! {
    loop b in raw {
        n :: Int.from_u8(b)
        if (n < 32 && n != 9) || n == 127 -> return true
    }
    false
}

fn valid_url(url: String) -> Bool Never! {
    raw :: url.bytes()
    if raw.len() < 8 || raw.len() > C_MAX_URL_BYTES || has_url_ctl(raw) -> return false
    parsed :: http_url.parse(url) ?? return false
    if parsed.scheme != "http" && parsed.scheme != "https" -> return false
    if parsed.host.bytes().len() == 0 || parsed.user.bytes().len() > 0 || parsed.password.bytes().len() > 0 -> return false
    colon := index_byte(raw, 58)
    if colon <= 0 || colon + 2 >= raw.len() -> return false
    if raw[colon + 1] != (U8{47}) || raw[colon + 2] != (U8{47}) -> return false
    start := colon + 3
    end := start
    loop end < raw.len() {
        if raw[end] == (U8{47}) || raw[end] == (U8{63}) || raw[end] == (U8{35}) -> break
        n :: Int.from_u8(raw[end])
        if n <= 32 || n >= 127 || n == 34 || n == 92 -> return false
        end = end + 1
    }
    end > start
}

fn has_url_ctl(raw: [U8]) -> Bool Never! {
    loop b in raw {
        n :: Int.from_u8(b)
        if n < 32 || n == 127 -> return true
    }
    false
}
