package {
    name: "core.http"
    version: "0.1.0"
    edition: "2026"
    description: "HTTP client and server over core.net."
    license: "MIT"
    outputs: {
        http: .Library{ entry: http }
    }
}

use core as core
use core.http as http
use core.http.client as provider
use core.http.server as server_provider
// core.http — bounded HTTP/1.1 message semantics.
//
// The host bridge is used only for the already-ratified one-shot GET/POST and
// server leaves. Method parsing, header/query/cookie codecs, request framing,
// response parsing, and all deterministic convenience behavior are Jet.
module client
module server
#Error
pub enum HTTPError {
    InvalidMethod
    InvalidUrl
    InvalidHeader
    InvalidStatus
    BodyConsumed
    InvalidFraming
    UnsupportedEncoding
    Cancelled
    BodyTooLarge(limit: Int)
    Resolve(host: String)
    Connect(address: String)
    TLS(stage: String)
    Timeout(phase: String)
    Proxy(stage: String)
    Redirect(reason: String)
    Protocol(version: String)
    IO(operation: String)
    Policy(reason: String)
    ResourceUnavailable(resource: String)
    Internal(incident_id: String)
    UnsupportedTarget(operation: HTTPOperation)
}

pub enum Method {
    Get
    Head
    Post
    Put
    Patch
    Delete
    Options
    Trace
    Connect
    Custom(String)
}

pub enum Version {
    Http10
    Http11
    Http2
    Http3
}

pub struct Status {
    pub code: Int
    pub reason: String
}

pub struct Header {
    pub name: String
    pub value: String
}

pub struct Headers {
    pub fields: [Header]
}

pub enum Body {
    Empty
    Text(String)
    Bytes([U8])
}




pub fn method_parse(token: String) -> Method {
    u :: ascii_upper(token)
    if u == {
        "GET" -> Method.Get
        "HEAD" -> Method.Head
        "POST" -> Method.Post
        "PUT" -> Method.Put
        "PATCH" -> Method.Patch
        "DELETE" -> Method.Delete
        "OPTIONS" -> Method.Options
        "TRACE" -> Method.Trace
        "CONNECT" -> Method.Connect
        else -> Method.Custom(token)
    }
}

pub fn method_text(method: Method) -> String {
    if method == {
        Method.Get -> "GET"
        Method.Head -> "HEAD"
        Method.Post -> "POST"
        Method.Put -> "PUT"
        Method.Patch -> "PATCH"
        Method.Delete -> "DELETE"
        Method.Options -> "OPTIONS"
        Method.Trace -> "TRACE"
        Method.Connect -> "CONNECT"
        .Custom(s) -> s
        else -> "GET"
    }
}

pub fn version_text(v: Version) -> String {
    if v == {
        Version.Http10 -> "HTTP/1.0"
        Version.Http11 -> "HTTP/1.1"
        Version.Http2 -> "HTTP/2"
        Version.Http3 -> "HTTP/3"
        else -> "HTTP/3"
    }
}

pub fn version_parse(token: String) -> Version {
    if token == {
        "HTTP/1.0" -> Version.Http10
        "HTTP/2" -> Version.Http2
        "HTTP/3" -> Version.Http3
        "HTTP/1.1" -> Version.Http11
        else -> Version.Http11
    }
}

pub fn status(code: Int) -> Status { Status{code: code, reason: reason_phrase(code)} }
pub fn status_ok() -> Status { status(200) }
pub fn status_created() -> Status { status(201) }
pub fn status_no_content() -> Status { status(204) }
pub fn status_moved() -> Status { status(301) }
pub fn status_found() -> Status { status(302) }
pub fn status_bad_request() -> Status { status(400) }
pub fn status_unauthorized() -> Status { status(401) }
pub fn status_forbidden() -> Status { status(403) }
pub fn status_not_found() -> Status { status(404) }
pub fn status_timeout() -> Status { status(408) }
pub fn status_server_error() -> Status { status(500) }
pub fn status_continue() -> Status { status(100) }
pub fn status_switching() -> Status { status(101) }
pub fn status_accepted() -> Status { status(202) }
pub fn status_non_authoritative() -> Status { status(203) }
pub fn status_reset_content() -> Status { status(205) }
pub fn status_partial() -> Status { status(206) }
pub fn status_multi_status() -> Status { status(207) }
pub fn status_already_reported() -> Status { status(208) }
pub fn status_see_other() -> Status { status(303) }
pub fn status_not_modified() -> Status { status(304) }
pub fn status_temporary() -> Status { status(307) }
pub fn status_permanent() -> Status { status(308) }
pub fn status_payment_required() -> Status { status(402) }
pub fn status_method_not_allowed() -> Status { status(405) }
pub fn status_not_acceptable() -> Status { status(406) }
pub fn status_conflict() -> Status { status(409) }
pub fn status_gone() -> Status { status(410) }
pub fn status_length_required() -> Status { status(411) }
pub fn status_precondition_failed() -> Status { status(412) }
pub fn status_payload_too_large() -> Status { status(413) }
pub fn status_uri_too_long() -> Status { status(414) }
pub fn status_unsupported_media() -> Status { status(415) }
pub fn status_range_unsat() -> Status { status(416) }
pub fn status_expectation_failed() -> Status { status(417) }
pub fn status_teapot() -> Status { status(418) }
pub fn status_unprocessable() -> Status { status(422) }
pub fn status_locked() -> Status { status(423) }
pub fn status_failed_dependency() -> Status { status(424) }
pub fn status_too_early() -> Status { status(425) }
pub fn status_upgrade_required() -> Status { status(426) }
pub fn status_precondition_required() -> Status { status(428) }
pub fn status_too_many() -> Status { status(429) }
pub fn status_legal() -> Status { status(451) }
pub fn status_not_implemented() -> Status { status(501) }
pub fn status_bad_gateway() -> Status { status(502) }
pub fn status_unavailable() -> Status { status(503) }
pub fn status_gateway_timeout() -> Status { status(504) }
pub fn status_http_version() -> Status { status(505) }

pub fn is_informational(s: Status) -> Bool { s.code >= 100 && s.code < 200 }
pub fn is_success(s: Status) -> Bool { s.code >= 200 && s.code < 300 }
pub fn is_redirect(s: Status) -> Bool { s.code >= 300 && s.code < 400 }
pub fn is_client_error(s: Status) -> Bool { s.code >= 400 && s.code < 500 }
pub fn is_server_error(s: Status) -> Bool { s.code >= 500 && s.code < 600 }

pub fn headers() -> Headers { Headers{fields: [Header]{}} }

pub fn headers_get(h: Headers, name: String) -> ?String {
    want :: ascii_lower(name)
    loop f in h.fields {
        if ascii_lower(f.name) == want -> return Val(f.value)
    }
    None
}

pub fn headers_all(h: Headers, name: String) -> [String] {
    want :: ascii_lower(name)
    out := [String]{}
    loop f in h.fields {
        if ascii_lower(f.name) == want -> out.push(f.value)
    }
    out
}

pub fn headers_set(h: Headers, name: String, value: String) -> Headers {
    if !valid_header_name(name) || has_ctl(value.bytes()) -> return ~h
    want :: ascii_lower(name)
    fields := [Header]{}
    replaced := false
    loop f in h.fields {
        if ascii_lower(f.name) == want {
            if !replaced {
                fields.push(Header{name: name, value: trim(value)})
                replaced = true
            }
        } else {
            fields.push(f)
        }
    }
    if !replaced -> fields.push(Header{name: name, value: trim(value)})
    Headers{fields: fields}
}

pub fn headers_append(h: Headers, name: String, value: String) -> Headers {
    if !valid_header_name(name) || has_ctl(value.bytes()) -> return ~h
    fields := [Header]{}
    loop f in h.fields -> fields.push(f)
    fields.push(Header{name: name, value: trim(value)})
    Headers{fields: fields}
}

pub fn headers_remove(h: Headers, name: String) -> Headers {
    want :: ascii_lower(name)
    fields := [Header]{}
    loop f in h.fields {
        if ascii_lower(f.name) != want -> fields.push(f)
    }
    Headers{fields: fields}
}

pub fn headers_encode(h: Headers) -> [String] {
    out := [String]{}
    loop f in h.fields -> out.push("{f.name}: {f.value}")
    out
}

pub fn headers_parse(lines: [String]) -> Headers {
    h := headers()
    loop line in lines {
        raw :: line.bytes()
        col := index_byte(raw, 58)
        if col <= 0 -> next
        name_bytes :: slice_b(raw, 0, col)
        value :: slice_b(raw, col + 1, raw.len())
        name :: String.from_bytes(name_bytes) ?? ""
        if valid_header_name(name) && !has_ctl(value) -> h = headers_append(h, name, String.from_bytes(value) ?? "")
    }
    h
}

pub fn body_empty() -> Body { Body.Empty }
pub fn body_text(text: String) -> Body {
    if text.bytes().len() == 0 -> return Body.Empty
    Body.Text(text)
}
pub fn body_bytes(bytes: [U8]) -> Body {
    if bytes.len() == 0 -> return Body.Empty
    Body.Bytes(bytes)
}

pub fn body_as_text(body: Body) -> String {
    if body == Body.Empty -> return ""
    if body == {
        .Text(s) -> return s
        .Bytes(xs) -> return String.from_bytes(xs) ?? ""
        else -> return ""
    }
    ""
}

pub fn body_as_bytes(body: Body) -> [U8] {
    if body == {
        .Empty -> return [U8]{}
        .Text(s) -> return body_as_text(Body.Text(s)).bytes()
        .Bytes(xs) -> return xs
        else -> return [U8]{}
    }
    [U8]{}
}
pub fn body_len(body: Body) -> Int { body_as_bytes(body).len() }

pub fn reason_phrase(code: Int) -> String {
    if code == {
        100 -> return "Continue"
        101 -> return "Switching Protocols"
        102 -> return "Processing"
        103 -> return "Early Hints"
        200 -> return "OK"
        201 -> return "Created"
        202 -> return "Accepted"
        203 -> return "Non-Authoritative Information"
        204 -> return "No Content"
        205 -> return "Reset Content"
        206 -> return "Partial Content"
        207 -> return "Multi-Status"
        208 -> return "Already Reported"
        226 -> return "IM Used"
        300 -> return "Multiple Choices"
        301 -> return "Moved Permanently"
        302 -> return "Found"
        303 -> return "See Other"
        304 -> return "Not Modified"
        305 -> return "Use Proxy"
        307 -> return "Temporary Redirect"
        308 -> return "Permanent Redirect"
        400 -> return "Bad Request"
        401 -> return "Unauthorized"
        402 -> return "Payment Required"
        403 -> return "Forbidden"
        404 -> return "Not Found"
        405 -> return "Method Not Allowed"
        406 -> return "Not Acceptable"
        407 -> return "Proxy Authentication Required"
        408 -> return "Request Timeout"
        409 -> return "Conflict"
        410 -> return "Gone"
        411 -> return "Length Required"
        412 -> return "Precondition Failed"
        413 -> return "Payload Too Large"
        414 -> return "URI Too Long"
        415 -> return "Unsupported Media Type"
        416 -> return "Range Not Satisfiable"
        417 -> return "Expectation Failed"
        418 -> return "I'm a teapot"
        421 -> return "Misdirected Request"
        422 -> return "Unprocessable Entity"
        423 -> return "Locked"
        424 -> return "Failed Dependency"
        425 -> return "Too Early"
        426 -> return "Upgrade Required"
        428 -> return "Precondition Required"
        429 -> return "Too Many Requests"
        431 -> return "Request Header Fields Too Large"
        451 -> return "Unavailable For Legal Reasons"
        500 -> return "Internal Server Error"
        501 -> return "Not Implemented"
        502 -> return "Bad Gateway"
        503 -> return "Service Unavailable"
        504 -> return "Gateway Timeout"
        505 -> return "HTTP Version Not Supported"
        506 -> return "Variant Also Negotiates"
        507 -> return "Insufficient Storage"
        508 -> return "Loop Detected"
        510 -> return "Not Extended"
        511 -> return "Network Authentication Required"
        else -> { _ := 0 }
    }
    if code >= 500 -> return "Error"
    if code >= 400 -> return "Bad Request"
    if code >= 300 -> return "Redirect"
    return "OK"
}

fn ascii_upper(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        if n >= 97 && n <= 122 -> out.push(U8{n - 32}) else -> out.push(b)
    }
    String.from_bytes(out) ?? text
}

fn ascii_lower(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        if n >= 65 && n <= 90 -> out.push(U8{n + 32}) else -> out.push(b)
    }
    String.from_bytes(out) ?? text
}

fn trim(text: String) -> String {
    raw :: text.bytes()
    start := 0
    end := raw.len()
    loop start < end {
        n :: Int.from_u8(raw[start])
        if n == 32 || n == 9 || n == 13 || n == 10 -> start = start + 1 else -> break
    }
    loop end > start {
        n :: Int.from_u8(raw[end - 1])
        if n == 32 || n == 9 || n == 13 || n == 10 -> end = end - 1 else -> break
    }
    if end <= start -> return ""
    String.from_bytes(slice_b(raw, start, end)) ?? ""
}



pub fn get(url: String) -[Net, Time.Wait]> HTTPResponse !HTTPError {
    if !valid_url(url) -> return Err(.InvalidUrl)
    provider.get(url)
}

pub fn post(url: String, body: String) -[Net, Time.Wait]> HTTPResponse !HTTPError {
    if !valid_url(url) -> return Err(.InvalidUrl)
    provider.post(url, body)
}

pub fn put(url: String, body: String) -[Net, Time.Wait]> HTTPResponse !HTTPError {
    req := core.http.client.request("PUT", url)
    send_request(req.body(body))
}

pub fn patch(url: String, body: String) -[Net, Time.Wait]> HTTPResponse !HTTPError {
    req := core.http.client.request("PATCH", url)
    send_request(req.body(body))
}

pub fn delete(url: String) -[Net, Time.Wait]> HTTPResponse !HTTPError {
    req := core.http.client.request("DELETE", url)
    send_request(req)
}

pub fn head(url: String) -[Net, Time.Wait]> HTTPResponse !HTTPError {
    req := core.http.client.request("HEAD", url)
    send_request(req)
}

pub fn serve(addr: String, mux: HTTPMux) !HTTPError -[Net, Time.Wait]> {
    core.http.server.serve(addr, mux, tls: None, deadline: None) ?? return
}


pub fn exchange(method: String, url: String, body: String, header_lines: [String]) -[Net, Time.Wait]> HTTPResponse !HTTPError {
    if !valid_method_token(method) -> return Err(.InvalidMethod)
    parsed :: headers_parse(header_lines)
    send_request(request_with(method_parse(method), url, parsed, body_text(body)))
}

pub fn send_request(req: HTTPRequest) -[Net, Time.Wait]> HTTPResponse !HTTPError {
    provider.send(req)
}

pub fn parse_response(url: String, raw: [U8]) -> HTTPResponse !HTTPError {
    split := find_double_crlf(raw)
    if split < 0 -> return Err(.InvalidFraming)
    head_end :: header_text_end(raw, split)
    head :: String.from_bytes(slice_b(raw, 0, head_end)) ?? return Err(.Protocol{version: "HTTP"})
    body_raw :: slice_b(raw, split, raw.len())
    if body_raw.len() > 1048576 -> return Err(.BodyTooLarge{limit: 1048576})
    lines :: split_lines(head)
    if lines.len() == 0 -> return Err(.Protocol{version: "HTTP"})
    parsed :: parse_status_line(lines[0]) ?? return Err(.InvalidStatus)
    hdr_lines := [String]{}
    loop i in 1..<lines.len() {
        if lines[i].bytes().len() > 0 -> hdr_lines.push(lines[i])
    }
    if !headers_lines_valid(hdr_lines) -> return Err(.InvalidHeader)
    h := headers_parse(hdr_lines)
    if has_header(h, "transfer-encoding") -> return Err(.UnsupportedEncoding)
    if has_ambiguous_framing(h) -> return Err(.InvalidFraming)
    expected :: content_length(h)
    if expected > 1048576 || (expected >= 0 && expected != body_raw.len()) -> return Err(.InvalidFraming)
    body_text :: String.from_bytes(body_raw) ?? return Err(.UnsupportedEncoding)
    response := core.http.server.response(parsed.status.code, body_text)
    loop line in hdr_lines {
        col := index_byte(line.bytes(), 58)
        name :: String.from_bytes(slice_b(line.bytes(), 0, col)) ?? return Err(.InvalidHeader)
        value :: String.from_bytes(slice_b(line.bytes(), col + 1, line.bytes().len())) ?? return Err(.InvalidHeader)
        response = response.header(name, trim(value))
    }
    Ok(response)
}

pub fn parse_request(raw: [U8]) -> HTTPRequest !HTTPError {
    split := find_double_crlf(raw)
    if split < 0 -> return Err(.InvalidFraming)
    head_end :: header_text_end(raw, split)
    head :: String.from_bytes(slice_b(raw, 0, head_end)) ?? return Err(.Protocol{version: "HTTP"})
    body_raw :: slice_b(raw, split, raw.len())
    if body_raw.len() > 1048576 -> return Err(.BodyTooLarge{limit: 1048576})
    lines :: split_lines(head)
    if lines.len() == 0 -> return Err(.Protocol{version: "HTTP"})
    parts :: split_space_line(lines[0])
    if parts.len() != 3 -> return Err(.InvalidMethod)
    if !valid_method(parts[0]) -> return Err(.InvalidMethod)
    if !valid_target(parts[1]) -> return Err(.InvalidUrl)
    parsed_version :: version_parse(parts[2])
    if version_text(parsed_version) != parts[2] -> return Err(.Protocol{version: parts[2]})
    hlines := [String]{}
    loop i in 1..<lines.len() {
        if lines[i].bytes().len() > 0 -> hlines.push(lines[i])
    }
    if !headers_lines_valid(hlines) -> return Err(.InvalidHeader)
    h := headers_parse(hlines)
    if has_header(h, "transfer-encoding") -> return Err(.UnsupportedEncoding)
    if has_ambiguous_framing(h) -> return Err(.InvalidFraming)
    expected :: content_length(h)
    req := core.http.client.request(method_text(method_parse(parts[0])), parts[1])
    loop line in hlines {
        col := index_byte(line.bytes(), 58)
        name :: String.from_bytes(slice_b(line.bytes(), 0, col)) ?? return Err(.InvalidHeader)
        value :: String.from_bytes(slice_b(line.bytes(), col + 1, line.bytes().len())) ?? return Err(.InvalidHeader)
        req = req.header(name, trim(value))
    }
    if body_raw.len() > 0 {
        body_text :: String.from_bytes(body_raw) ?? return Err(.UnsupportedEncoding)
        req = req.body(body_text)
    }
    Ok(req)
}

pub struct StatusLine {
    pub version: Version
    pub status: Status
}

fn parse_status_line(line: String) -> ?StatusLine {
    parts :: split_space_line(line)
    if parts.len() < 2 -> return None
    if !starts(parts[0], "HTTP/") -> return None
    parsed_version :: version_parse(parts[0])
    if version_text(parsed_version) != parts[0] -> return None
    code :: parse_decimal(parts[1]) ?? return None
    if code < 100 || code > 999 -> return None
    reason := reason_phrase(code)
    if parts.len() > 2 {
        reason = parts[2]
        i := 3
        loop i < parts.len() {
            reason = "{reason} {parts[i]}"
            i = i + 1
        }
    }
    Val(StatusLine{version: version_parse(parts[0]), status: Status{code: code, reason: reason}})
}

fn split_space_line(text: String) -> [String] {
    raw :: text.bytes()
    out := [String]{}
    start := 0
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{32}) {
            if i > start -> out.push(String.from_bytes(slice_b(raw, start, i)) ?? "")
            start = i + 1
        }
        i = i + 1
    }
    if start < raw.len() -> out.push(String.from_bytes(slice_b(raw, start, raw.len())) ?? "")
    out
}

fn find_double_crlf(raw: [U8]) -> Int {
    if raw.len() < 4 {
        if raw.len() >= 2 && raw[raw.len() - 2] == (U8{10}) && raw[raw.len() - 1] == (U8{10}) -> return raw.len()
        return -1
    }
    i := 0
    loop i + 3 < raw.len() {
        if raw[i] == (U8{13}) && raw[i + 1] == (U8{10}) && raw[i + 2] == (U8{13}) && raw[i + 3] == (U8{10}) -> return i + 4
        i = i + 1
    }
    i = 0
    loop i + 1 < raw.len() {
        if raw[i] == (U8{10}) && raw[i + 1] == (U8{10}) -> return i + 2
        i = i + 1
    }
    -1
}

fn header_text_end(raw: [U8], split: Int) -> Int {
    if split >= 4 && raw[split - 4] == (U8{13}) -> return split - 4
    split - 2
}

fn split_lines(text: String) -> [String] {
    raw :: text.bytes()
    out := [String]{}
    start := 0
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{10}) {
            end := i
            if end > start && raw[end - 1] == (U8{13}) -> end = end - 1
            out.push(String.from_bytes(slice_b(raw, start, end)) ?? "")
            start = i + 1
        }
        i = i + 1
    }
    if start < raw.len() -> out.push(String.from_bytes(slice_b(raw, start, raw.len())) ?? "")
    out
}


pub struct Cookie {
    pub name: String
    pub value: String
    pub domain: String
    pub path: String
    pub secure: Bool
    pub http_only: Bool
    pub same_site: String
    pub max_age: Int
}

pub struct Query {
    pub pairs: [QueryPair]
}

pub struct QueryPair {
    pub key: String
    pub value: String
}

pub fn query() -> Query { Query{pairs: [QueryPair]{}} }

pub fn query_get(q: Query, key: String) -> ?String {
    loop p in q.pairs {
        if p.key == key -> return Val(p.value)
    }
    None
}

pub fn query_all(q: Query, key: String) -> [String] {
    out := [String]{}
    loop p in q.pairs {
        if p.key == key -> out.push(p.value)
    }
    out
}

pub fn query_set(q: Query, key: String, value: String) -> Query {
    pairs := [QueryPair]{}
    replaced := false
    loop p in q.pairs {
        if p.key == key {
            if !replaced {
                pairs.push(QueryPair{key: key, value: value})
                replaced = true
            }
        } else {
            pairs.push(p)
        }
    }
    if !replaced -> pairs.push(QueryPair{key: key, value: value})
    Query{pairs: pairs}
}

pub fn query_add(q: Query, key: String, value: String) -> Query {
    pairs := [QueryPair]{}
    loop p in q.pairs -> pairs.push(p)
    pairs.push(QueryPair{key: key, value: value})
    Query{pairs: pairs}
}

pub fn query_encode(q: Query) -> String {
    s := ""
    first := true
    loop p in q.pairs {
        piece :: "{percent_encode(p.key)}={percent_encode(p.value)}"
        if first {
            s = piece
            first = false
        } else {
            s = "{s}&{piece}"
        }
    }
    s
}

pub fn query_decode(text: String) -> Query {
    q := query()
    raw :: text.bytes()
    if raw.len() == 0 -> return q
    start := 0
    if raw[0] == (U8{63}) -> start = 1
    i := start
    loop i <= raw.len() {
        if i == raw.len() || raw[i] == (U8{38}) {
            piece :: String.from_bytes(slice_b(raw, start, i)) ?? ""
            if piece.bytes().len() > 0 {
                eq := index_byte_str(piece, 61)
                if eq >= 0 {
                    q = query_add(q, percent_decode(slice_str(piece, 0, eq)), percent_decode(slice_str(piece, eq + 1, piece.bytes().len())))
                } else {
                    q = query_add(q, percent_decode(piece), "")
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    q
}

pub fn form_encode(q: Query) -> String { query_encode(q) }
pub fn form_decode(text: String) -> Query { query_decode(text) }

pub fn cookie(name: String, value: String) -> Cookie {
    Cookie{name: name, value: value, domain: "", path: "/", secure: false, http_only: false, same_site: "Lax", max_age: -1}
}

pub fn cookie_encode(c: Cookie) -> String {
    if !valid_cookie_token(c.name) -> return ""
    s := "{c.name}={c.value}"
    if c.domain.bytes().len() > 0 && !has_ctl(c.domain.bytes()) -> s = "{s}; Domain={c.domain}"
    if c.path.bytes().len() > 0 && !has_ctl(c.path.bytes()) -> s = "{s}; Path={c.path}"
    if c.max_age >= 0 -> s = "{s}; Max-Age={c.max_age}"
    if c.http_only -> s = "{s}; HttpOnly"
    if c.secure -> s = "{s}; Secure"
    if c.same_site == "Strict" || c.same_site == "Lax" || c.same_site == "None" -> s = "{s}; SameSite={c.same_site}"
    s
}

pub fn cookies_parse(header: String) -> [Cookie] {
    out := [Cookie]{}
    raw :: header.bytes()
    start := 0
    i := 0
    first := true
    loop i <= raw.len() {
        if i == raw.len() || raw[i] == (U8{59}) {
            piece :: trim(String.from_bytes(slice_b(raw, start, i)) ?? "")
            eq := index_byte_str(piece, 61)
            if eq > 0 {
                n :: trim(slice_str(piece, 0, eq))
                v :: trim(slice_str(piece, eq + 1, piece.bytes().len()))
                lower :: ascii_lower(n)
                if first || (lower != "domain" && lower != "path" && lower != "max-age" && lower != "expires" && lower != "secure" && lower != "httponly" && lower != "samesite") {
                    if valid_cookie_token(n) -> out.push(cookie(n, v))
                }
            }
            first = false
            start = i + 1
        }
        i = i + 1
    }
    out
}

pub fn basic_auth(user: String, password: String) -> String {
    credentials := "{user}:{password}"
    "Basic {base64_encode(credentials.bytes())}"
}

pub fn bearer_auth(token: String) -> String { "Bearer {token}" }
pub fn with_header(req: HTTPRequest, name: String, value: String) -> HTTPRequest {
    req.header(name, value)
}

pub fn with_body(req: HTTPRequest, body: Body) -> HTTPRequest {
    req.body(body_as_text(body))
}

pub fn with_query(url: String, q: Query) -> String {
    enc :: query_encode(q)
    if enc.bytes().len() == 0 -> return ~url
    frag :: split_fragment(url)
    base :: frag.url
    sep := if index_byte_str(base, 63) >= 0 -> "&" else -> "?"
    suffix := ""
    if frag.fragment.bytes().len() > 0 -> suffix = "#{frag.fragment}"
    "{base}{sep}{enc}{suffix}"
}

pub fn status_class(s: Status) -> String {
    if is_informational(s) -> return "informational"
    if is_success(s) -> return "success"
    if is_redirect(s) -> return "redirect"
    if is_client_error(s) -> return "client_error"
    if is_server_error(s) -> return "server_error"
    "unknown"
}

pub fn request_with(method: Method, url: String, h: Headers, body: Body) -> HTTPRequest {
    req := core.http.client.request(method_text(method), url)
    loop f in h.fields -> req = req.header(f.name, f.value)
    with_body(req, body)
}

pub fn response_ok(body: Body) -> HTTPResponse {
    core.http.server.response(200, body_as_text(body))
}

pub fn response_json_headers() -> Headers { headers_set(headers(), "content-type", "application/json; charset=utf-8") }
pub fn response_text_headers() -> Headers { headers_set(headers(), "content-type", "text/plain; charset=utf-8") }
pub fn has_header(h: Headers, name: String) -> Bool { headers_get(h, name) != None }

pub fn content_length(h: Headers) -> Int {
    values :: headers_all(h, "content-length")
    if values.len() == 0 -> return -1
    n :: parse_decimal(trim(values[0])) ?? return -1
    if n < 0 -> return -1
    n
}

fn valid_url(url: String) -> Bool {
    raw :: url.bytes()
    if raw.len() < 8 || has_ctl(raw) -> return false
    colon := index_byte(raw, 58)
    if colon <= 0 || colon + 2 >= raw.len() -> return false
    scheme :: ascii_lower(slice_str(url, 0, colon))
    if scheme != "http" && scheme != "https" -> return false
    if raw[colon + 1] != (U8{47}) || raw[colon + 2] != (U8{47}) -> return false
    start := colon + 3
    end := start
    loop end < raw.len() {
        if raw[end] == (U8{47}) || raw[end] == (U8{63}) || raw[end] == (U8{35})-> break
        n :: Int.from_u8(raw[end])
        if n == 32 || n == 9 -> return false
        end = end + 1
    }
    if end == start -> return false
    !contains_byte(slice_str(url, start, end), 64)
}

fn valid_method_token(method: String) -> Bool { valid_method(method) }

fn valid_method(method: String) -> Bool {
    raw :: method.bytes()
    if raw.len() == 0 -> return false
    loop b in raw {
        n :: Int.from_u8(b)
        token_char := (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 45 || n == 95
        if !token_char -> return false
    }
    true
}

fn valid_target(target: String) -> Bool {
    raw :: target.bytes()
    if raw.len() == 0 -> return false
    if raw[0] == (U8{47}) || target == "*" -> true else -> false
}


fn has_ambiguous_framing(h: Headers) -> Bool {
    lengths := headers_all(h, "content-length")
    if lengths.len() > 1 {
        first :: trim(lengths[0])
        loop value in lengths {
            if trim(value) != first -> return true
        }
    }
    if invalid_content_length(h) -> return true
    has_header(h, "content-length") && has_header(h, "transfer-encoding")
}

fn invalid_content_length(h: Headers) -> Bool {
    loop value in headers_all(h, "content-length") {
        n :: parse_decimal(trim(value)) ?? return true
        if n < 0 -> return true
    }
    false
}

fn valid_header_line(line: String) -> Bool {
    raw :: line.bytes()
    col := index_byte(raw, 58)
    if col <= 0 -> return false
    name :: String.from_bytes(slice_b(raw, 0, col)) ?? return false
    value :: slice_b(raw, col + 1, raw.len())
    valid_header_name(name) && !has_ctl(value)
}

fn headers_lines_valid(lines: [String]) -> Bool {
    loop line in lines {
        if !valid_header_line(line) -> return false
    }
    true
}

fn valid_header_name(name: String) -> Bool {
    raw :: name.bytes()
    if raw.len() == 0 -> return false
    loop b in raw {
        n :: Int.from_u8(b)
        if n <= 32 || n >= 127 || n == 40 || n == 41 || n == 44 || n == 47 || n == 58 || n == 59 || n == 60 || n == 61 || n == 62 || n == 63 || n == 64 || n == 91 || n == 92 || n == 93 || n == 123 || n == 125 -> return false
    }
    true
}

fn has_ctl(bytes: [U8]) -> Bool {
    loop b in bytes {
        n :: Int.from_u8(b)
        if n < 32 && n != 9 -> return true
        if n == 127 -> return true
    }
    false
}

fn valid_cookie_token(name: String) -> Bool {
    raw :: name.bytes()
    if raw.len() == 0 -> return false
    loop b in raw {
        n :: Int.from_u8(b)
        if n <= 32 || n >= 127 || n == 40 || n == 41 || n == 44 || n == 47 || n == 58 || n == 59 || n == 60 || n == 61 || n == 62 || n == 63 || n == 64 || n == 91 || n == 92 || n == 93 || n == 123 || n == 125 -> return false
    }
    true
}

fn parse_decimal(text: String) -> ?Int {
    raw :: text.bytes()
    if raw.len() == 0 -> return None
    n := 0
    loop b in raw {
        d :: Int.from_u8(b)
        if d < 48 || d > 57 -> return None
        n = n * 10 + d - 48
    }
    Val(n)
}

fn percent_encode(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        unreserved := (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 45 || n == 46 || n == 95 || n == 126
        if unreserved -> out.push(b)
        else if n == 32 -> out.push(U8{43})
        else {
            out.push(U8{37})
            out.push(hex_digit(n /% 16))
            out.push(hex_digit(n %% 16))
        }
    }
    String.from_bytes(out) ?? text
}

fn percent_decode(text: String) -> String {
    raw :: text.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{43}) {
            out.push(U8{32})
            i = i + 1
            next
        }
        if raw[i] == (U8{37}) && i + 2 < raw.len() {
            hi :: from_hex(raw[i + 1])
            lo :: from_hex(raw[i + 2])
            if hi >= 0 && lo >= 0 {
                out.push(U8{hi * 16 + lo})
                i = i + 3
                next
            }
        }
        out.push(raw[i])
        i = i + 1
    }
    String.from_bytes(out) ?? text
}
fn base64_encode(bytes: [U8]) -> String {
    alphabet :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".bytes()
    out := [U8]{}
    i := 0
    loop i < bytes.len() {
        a :: Int.from_u8(bytes[i])
        b := 0
        c := 0
        have_b := i + 1 < bytes.len()
        have_c := i + 2 < bytes.len()
        if have_b -> b = Int.from_u8(bytes[i + 1])
        if have_c -> c = Int.from_u8(bytes[i + 2])
        block :: (a * 65536) + (b * 256) + c
        out.push(alphabet[(block /% 262144) %% 64])
        out.push(alphabet[(block /% 4096) %% 64])
        if have_b -> out.push(alphabet[(block /% 64) %% 64]) else -> out.push(U8{61})
        if have_c -> out.push(alphabet[block %% 64]) else -> out.push(U8{61})
        i = i + 3
    }
    String.from_bytes(out) ?? ""
}

fn hex_digit(n: Int) -> U8 {
    if n < 10 -> return U8{48 + n}
    U8{65 + n - 10}
}

fn from_hex(b: U8) -> Int {
    n :: Int.from_u8(b)
    if n >= 48 && n <= 57 -> return n - 48
    if n >= 65 && n <= 70 -> return n - 55
    if n >= 97 && n <= 102 -> return n - 87
    -1
}

fn index_byte(text: [U8], code: Int) -> Int {
    loop i in 0..<text.len() {
        if Int.from_u8(text[i]) == code -> return i
    }
    -1
}

fn index_byte_str(text: String, code: Int) -> Int { index_byte(text.bytes(), code) }

fn last_index(raw: [U8], code: Int) -> Int {
    i := raw.len() - 1
    loop i >= 0 {
        if Int.from_u8(raw[i]) == code -> return i
        i = i - 1
    }
    -1
}

fn starts(text: String, prefix: String) -> Bool {
    a :: text.bytes()
    b :: prefix.bytes()
    if b.len() > a.len() -> return false
    loop i in 0..<b.len() {
        if a[i] != b[i] -> return false
    }
    true
}

struct FragmentSplit {
    url: String
    fragment: String
}

fn split_fragment(text: String) -> FragmentSplit {
    at := index_byte_str(text, 35)
    if at < 0 -> return FragmentSplit{url: text, fragment: ""}
    FragmentSplit{url: slice_str(text, 0, at), fragment: slice_str(text, at + 1, text.bytes().len())}
}

fn contains_byte(text: String, code: Int) -> Bool { index_byte(text.bytes(), code) >= 0 }

fn slice_str(text: String, start: Int, end: Int) -> String {
    String.from_bytes(slice_b(text.bytes(), start, end)) ?? ""
}

fn slice_b(raw: [U8], start: Int, end: Int) -> [U8] {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i >= raw.len() -> return ~out
        out.push(raw[i])
        i = i + 1
    }
}

