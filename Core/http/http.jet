package {
    name: "core.http"
    version: "0.0.1"
    edition: "2026"
    description: "HTTP client and server over core.net."
    license: "MIT"
    outputs: {
        http: .Library{ entry: http }
    }
}

use core as core
use core.http.client as provider
use core.net.url as http_url
C_MAX_BODY_BYTES :: 1048576
C_MAX_HEADER_BYTES :: 32768
C_MAX_HEADER_LINE_BYTES :: 8192
C_MAX_HEADER_COUNT :: 100
C_MAX_REQUEST_LINE_BYTES :: 8192
C_MAX_URL_BYTES :: 8192
// core.http — bounded HTTP/1.1 message semantics.
//
// The host bridge remains only a typed request/response transport leaf.
// Method parsing, header/query/cookie codecs, request framing, response
// parsing, limits, and all deterministic convenience behavior are Jet.
module client
module server
#Error
pub enum HTTPError {
    InvalidMethod
    InvalidURL
    InvalidHeader
    InvalidStatus
    BodyConsumed
    InvalidFraming
    UnsupportedEncoding
    Cancelled
    BodyTooLarge(limit: Int)
    Resolve(host: String)
    Connect(address: String)
    TLS(stage: String)
    Timeout(phase: String)
    Proxy(stage: String)
    Redirect(reason: String)
    Protocol(version: String)
    IO(operation: String)
    Policy(reason: String)
    ResourceUnavailable(resource: String)
    Internal(incident_id: String)
    UnsupportedTarget(operation: HTTPOperation)
}

pub enum Method {
    Get
    Head
    Post
    Put
    Patch
    Delete
    Options
    Trace
    Connect
    Custom(String)
}

pub enum Version {
    HTTP10
    HTTP11
    HTTP2
    HTTP3
}

pub struct Status {
    pub code: Int
    pub reason: String
}

pub struct Header {
    pub name: String
    pub value: String
}

pub struct Headers {
    pub fields: [Header]
}

pub enum Body {
    Empty
    Text(String)
    Bytes([U8])
}




pub fn method_parse(token: String) -> Method Never! {
    u :: ascii_upper(token)
    if u == {
        "GET" -> Method.Get
        "HEAD" -> Method.Head
        "POST" -> Method.Post
        "PUT" -> Method.Put
        "PATCH" -> Method.Patch
        "DELETE" -> Method.Delete
        "OPTIONS" -> Method.Options
        "TRACE" -> Method.Trace
        "CONNECT" -> Method.Connect
        else -> Method.Custom(token)
    }
}

pub fn method_text(method: Method) -> String Never! {
    if method == {
        Method.Get -> "GET"
        Method.Head -> "HEAD"
        Method.Post -> "POST"
        Method.Put -> "PUT"
        Method.Patch -> "PATCH"
        Method.Delete -> "DELETE"
        Method.Options -> "OPTIONS"
        Method.Trace -> "TRACE"
        Method.Connect -> "CONNECT"
        .Custom(s) -> s
        else -> "GET"
    }
}

pub fn version_text(v: Version) -> String Never! {
    if v == {
        Version.HTTP10 -> "HTTP/1.0"
        Version.HTTP11 -> "HTTP/1.1"
        Version.HTTP2 -> "HTTP/2"
        Version.HTTP3 -> "HTTP/3"
        else -> "HTTP/3"
    }
}

pub fn version_parse(token: String) -> Version Never! {
    if token == {
        "HTTP/1.0" -> Version.HTTP10
        "HTTP/2" -> Version.HTTP2
        "HTTP/3" -> Version.HTTP3
        "HTTP/1.1" -> Version.HTTP11
        else -> Version.HTTP11
    }
}

pub fn status(code: Int) -> Status Never! { Status{code: code, reason: reason_phrase(code)} }
pub fn status_ok() -> Status Never! { status(200) }
pub fn status_created() -> Status Never! { status(201) }
pub fn status_no_content() -> Status Never! { status(204) }
pub fn status_moved() -> Status Never! { status(301) }
pub fn status_found() -> Status Never! { status(302) }
pub fn status_bad_request() -> Status Never! { status(400) }
pub fn status_unauthorized() -> Status Never! { status(401) }
pub fn status_forbidden() -> Status Never! { status(403) }
pub fn status_not_found() -> Status Never! { status(404) }
pub fn status_timeout() -> Status Never! { status(408) }
pub fn status_server_error() -> Status Never! { status(500) }
pub fn status_continue() -> Status Never! { status(100) }
pub fn status_switching() -> Status Never! { status(101) }
pub fn status_accepted() -> Status Never! { status(202) }
pub fn status_non_authoritative() -> Status Never! { status(203) }
pub fn status_reset_content() -> Status Never! { status(205) }
pub fn status_partial() -> Status Never! { status(206) }
pub fn status_multi_status() -> Status Never! { status(207) }
pub fn status_already_reported() -> Status Never! { status(208) }
pub fn status_see_other() -> Status Never! { status(303) }
pub fn status_not_modified() -> Status Never! { status(304) }
pub fn status_temporary() -> Status Never! { status(307) }
pub fn status_permanent() -> Status Never! { status(308) }
pub fn status_payment_required() -> Status Never! { status(402) }
pub fn status_method_not_allowed() -> Status Never! { status(405) }
pub fn status_not_acceptable() -> Status Never! { status(406) }
pub fn status_conflict() -> Status Never! { status(409) }
pub fn status_gone() -> Status Never! { status(410) }
pub fn status_length_required() -> Status Never! { status(411) }
pub fn status_precondition_failed() -> Status Never! { status(412) }
pub fn status_payload_too_large() -> Status Never! { status(413) }
pub fn status_uri_too_long() -> Status Never! { status(414) }
pub fn status_unsupported_media() -> Status Never! { status(415) }
pub fn status_range_unsat() -> Status Never! { status(416) }
pub fn status_expectation_failed() -> Status Never! { status(417) }
pub fn status_teapot() -> Status Never! { status(418) }
pub fn status_unprocessable() -> Status Never! { status(422) }
pub fn status_locked() -> Status Never! { status(423) }
pub fn status_failed_dependency() -> Status Never! { status(424) }
pub fn status_too_early() -> Status Never! { status(425) }
pub fn status_upgrade_required() -> Status Never! { status(426) }
pub fn status_precondition_required() -> Status Never! { status(428) }
pub fn status_too_many() -> Status Never! { status(429) }
pub fn status_legal() -> Status Never! { status(451) }
pub fn status_not_implemented() -> Status Never! { status(501) }
pub fn status_bad_gateway() -> Status Never! { status(502) }
pub fn status_unavailable() -> Status Never! { status(503) }
pub fn status_gateway_timeout() -> Status Never! { status(504) }
pub fn status_http_version() -> Status Never! { status(505) }

pub fn is_informational(s: Status) -> Bool Never! { s.code >= 100 && s.code < 200 }
pub fn is_success(s: Status) -> Bool Never! { s.code >= 200 && s.code < 300 }
pub fn is_redirect(s: Status) -> Bool Never! { s.code >= 300 && s.code < 400 }
pub fn is_client_error(s: Status) -> Bool Never! { s.code >= 400 && s.code < 500 }
pub fn is_server_error(s: Status) -> Bool Never! { s.code >= 500 && s.code < 600 }

pub fn headers() -> Headers Never! { Headers{fields: [Header]{}} }

pub fn headers_get(h: Headers, name: String) -> String? Never! {
    want :: ascii_lower(name)
    loop f in h.fields {
        if ascii_lower(f.name) == want -> return Val(f.value)
    }
    None
}

pub fn headers_all(h: Headers, name: String) -> [String] Never! {
    want :: ascii_lower(name)
    out := [String]{}
    loop f in h.fields {
        if ascii_lower(f.name) == want -> &out.push(f.value)
    }
    out
}

pub fn headers_set(h: Headers, name: String, value: String) -> Headers Never! {
    if !valid_header_name(name) || has_ctl(value.bytes()) -> return ~h
    want :: ascii_lower(name)
    fields := [Header]{}
    replaced := false
    loop f in h.fields {
        if ascii_lower(f.name) == want {
            if !replaced {
                &fields.push(Header{name: name, value: trim(value)})
                replaced = true
            }
        } else {
            &fields.push(f)
        }
    }
    if !replaced -> &fields.push(Header{name: name, value: trim(value)})
    Headers{fields: fields}
}

pub fn headers_append(h: Headers, name: String, value: String) -> Headers Never! {
    if !valid_header_name(name) || has_ctl(value.bytes()) -> return ~h
    fields := [Header]{}
    loop f in h.fields -> &fields.push(f)
    &fields.push(Header{name: name, value: trim(value)})
    Headers{fields: fields}
}

pub fn headers_remove(h: Headers, name: String) -> Headers Never! {
    want :: ascii_lower(name)
    fields := [Header]{}
    loop f in h.fields {
        if ascii_lower(f.name) != want -> &fields.push(f)
    }
    Headers{fields: fields}
}

pub fn headers_encode(h: Headers) -> [String] Never! {
    out := [String]{}
    loop f in h.fields -> &out.push("{f.name}: {f.value}")
    out
}

pub fn headers_parse(lines: [String]) -> Headers Never! {
    h := headers()
    if !headers_lines_bounded(lines) -> return h
    loop line in lines {
        raw :: line.bytes()
        col := index_byte(raw, 58)
        if col <= 0 -> next
        name_bytes :: slice_b(raw, 0, col)
        value :: slice_b(raw, col + 1, raw.len())
        name :: String.from_bytes(name_bytes) ?? ""
        if valid_header_name(name) && !has_ctl(value) -> h = headers_append(h, name, String.from_bytes(value) ?? "")
    }
    h
}

pub fn body_empty() -> Body Never! { Body.Empty }
pub fn body_text(text: String) -> Body Never! {
    if text.bytes().len() == 0 -> return Body.Empty
    Body.Text(text)
}
pub fn body_bytes(bytes: [U8]) -> Body Never! {
    if bytes.len() == 0 -> return Body.Empty
    Body.Bytes(bytes)
}

pub fn body_as_text(body: Body) -> String Never! {
    if body == Body.Empty -> return ""
    if body == {
        .Text(s) -> return s
        .Bytes(xs) -> return String.from_bytes(xs) ?? ""
        else -> return ""
    }
    ""
}

pub fn body_as_bytes(body: Body) -> [U8] Never! {
    if body == {
        .Empty -> return [U8]{}
        .Text(s) -> return body_as_text(Body.Text(s)).bytes()
        .Bytes(xs) -> return xs
        else -> return [U8]{}
    }
    [U8]{}
}
pub fn body_len(body: Body) -> Int Never! { body_as_bytes(body).len() }

pub fn reason_phrase(code: Int) -> String Never! {
    if code == {
        100 -> return "Continue"
        101 -> return "Switching Protocols"
        102 -> return "Processing"
        103 -> return "Early Hints"
        200 -> return "OK"
        201 -> return "Created"
        202 -> return "Accepted"
        203 -> return "Non-Authoritative Information"
        204 -> return "No Content"
        205 -> return "Reset Content"
        206 -> return "Partial Content"
        207 -> return "Multi-Status"
        208 -> return "Already Reported"
        226 -> return "IM Used"
        300 -> return "Multiple Choices"
        301 -> return "Moved Permanently"
        302 -> return "Found"
        303 -> return "See Other"
        304 -> return "Not Modified"
        305 -> return "Use Proxy"
        307 -> return "Temporary Redirect"
        308 -> return "Permanent Redirect"
        400 -> return "Bad Request"
        401 -> return "Unauthorized"
        402 -> return "Payment Required"
        403 -> return "Forbidden"
        404 -> return "Not Found"
        405 -> return "Method Not Allowed"
        406 -> return "Not Acceptable"
        407 -> return "Proxy Authentication Required"
        408 -> return "Request Timeout"
        409 -> return "Conflict"
        410 -> return "Gone"
        411 -> return "Length Required"
        412 -> return "Precondition Failed"
        413 -> return "Payload Too Large"
        414 -> return "URI Too Long"
        415 -> return "Unsupported Media Type"
        416 -> return "Range Not Satisfiable"
        417 -> return "Expectation Failed"
        418 -> return "I'm a teapot"
        421 -> return "Misdirected Request"
        422 -> return "Unprocessable Entity"
        423 -> return "Locked"
        424 -> return "Failed Dependency"
        425 -> return "Too Early"
        426 -> return "Upgrade Required"
        428 -> return "Precondition Required"
        429 -> return "Too Many Requests"
        431 -> return "Request Header Fields Too Large"
        451 -> return "Unavailable For Legal Reasons"
        500 -> return "Internal Server Error"
        501 -> return "Not Implemented"
        502 -> return "Bad Gateway"
        503 -> return "Service Unavailable"
        504 -> return "Gateway Timeout"
        505 -> return "HTTP Version Not Supported"
        506 -> return "Variant Also Negotiates"
        507 -> return "Insufficient Storage"
        508 -> return "Loop Detected"
        510 -> return "Not Extended"
        511 -> return "Network Authentication Required"
        else -> { _ := 0 }
    }
    if code >= 500 -> return "Error"
    if code >= 400 -> return "Bad Request"
    if code >= 300 -> return "Redirect"
    return "OK"
}

fn ascii_upper(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        if n >= 97 && n <= 122 -> &out.push(U8{n - 32}) else -> &out.push(b)
    }
    String.from_bytes(out) ?? text
}

fn ascii_lower(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        if n >= 65 && n <= 90 -> &out.push(U8{n + 32}) else -> &out.push(b)
    }
    String.from_bytes(out) ?? text
}

fn trim(text: String) -> String Never! {
    raw :: text.bytes()
    start := 0
    end := raw.len()
    loop start < end {
        n :: Int.from_u8(raw[start])
        if n == 32 || n == 9 || n == 13 || n == 10 -> start = start + 1 else -> break
    }
    loop end > start {
        n :: Int.from_u8(raw[end - 1])
        if n == 32 || n == 9 || n == 13 || n == 10 -> end = end - 1 else -> break
    }
    if end <= start -> return ""
    String.from_bytes(slice_b(raw, start, end)) ?? ""
}


pub fn get(url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    if !valid_url(url) -> return Err(.InvalidURL)
    provider.get(url)
}

pub fn post(url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    if !valid_url(url) -> return Err(.InvalidURL)
    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_BODY_BYTES})
    provider.post(url, body)
}

pub fn put(url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    if !valid_url(url) -> return Err(.InvalidURL)
    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_BODY_BYTES})
    req := core.http.client.request("PUT", url)
    send_request(req.body(body))
}

pub fn patch(url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    if !valid_url(url) -> return Err(.InvalidURL)
    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_BODY_BYTES})
    req := core.http.client.request("PATCH", url)
    send_request(req.body(body))
}

pub fn delete(url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    if !valid_url(url) -> return Err(.InvalidURL)
    req := core.http.client.request("DELETE", url)
    send_request(req)
}

pub fn head(url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    if !valid_url(url) -> return Err(.InvalidURL)
    req := core.http.client.request("HEAD", url)
    send_request(req)
}

pub fn serve(addr: String, mux: HTTPMux) HTTPError! {
    core.http.server.serve(addr, mux) ?? return
}


pub fn exchange(method: String, url: String, body: String, header_lines: [String]) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    if !valid_method_token(method) -> return Err(.InvalidMethod)
    if !valid_url(url) -> return Err(.InvalidURL)
    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_BODY_BYTES})
    if !headers_lines_bounded(header_lines) || !headers_lines_valid(header_lines) -> return Err(.InvalidHeader)
    parsed :: headers_parse(header_lines)
    send_request(request_with(method_parse(method), url, parsed, body_text(body)))
}

pub fn send_request(req: HTTPRequest) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    provider.send(req)
}

pub fn parse_response(url: String, raw: [U8]) -> HTTPResponse HTTPError! {
    split := find_double_crlf(raw)
    if split < 0 -> return Err(.InvalidFraming)
    if !strict_crlf(raw, split) -> return Err(.InvalidFraming)
    head_end :: header_text_end(raw, split)
    if head_end > C_MAX_HEADER_BYTES -> return Err(.InvalidHeader)
    head :: String.from_bytes(slice_b(raw, 0, head_end)) ?? return Err(.Protocol{version: "HTTP"})
    if raw.len() - split > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_BODY_BYTES})
    body_raw :: slice_b(raw, split, raw.len())
    lines :: split_lines(head)
    if lines.len() == 0 || lines[0].bytes().len() > C_MAX_REQUEST_LINE_BYTES -> return Err(.InvalidStatus)
    parsed :: parse_status_line(lines[0]) ?? return Err(.InvalidStatus)
    hdr_lines := [String]{}
    loop i in 1..<lines.len() {
        if lines[i].bytes().len() > 0 -> &hdr_lines.push(lines[i])
    }
    if !headers_lines_bounded(hdr_lines) || !headers_lines_valid(hdr_lines) -> return Err(.InvalidHeader)
    h := headers_parse(hdr_lines)
    if has_ambiguous_framing(h) -> return Err(.InvalidFraming)
    if has_unsupported_encoding(h) -> return Err(.UnsupportedEncoding)
    if response_forbids_content_length(parsed.status.code) && has_header(h, "content-length") -> return Err(.InvalidFraming)
    expected :: content_length(h)
    if parsed.status.code != 304 && (expected > C_MAX_BODY_BYTES || (expected >= 0 && expected != body_raw.len())) -> return Err(.InvalidFraming)
    if response_forbids_body(parsed.status.code) && body_raw.len() > 0 -> return Err(.InvalidFraming)
    body_text :: String.from_bytes(body_raw) ?? return Err(.UnsupportedEncoding)
    response := core.http.server.response(parsed.status.code, body_text)
    loop line in hdr_lines {
        col := index_byte(line.bytes(), 58)
        name :: String.from_bytes(slice_b(line.bytes(), 0, col)) ?? return Err(.InvalidHeader)
        value :: String.from_bytes(slice_b(line.bytes(), col + 1, line.bytes().len())) ?? return Err(.InvalidHeader)
        response = &response.header(name, trim(value))
    }
    Ok(response)
}

pub fn parse_request(raw: [U8]) -> HTTPRequest HTTPError! {
    split := find_double_crlf(raw)
    if split < 0 -> return Err(.InvalidFraming)
    if !strict_crlf(raw, split) -> return Err(.InvalidFraming)
    head_end :: header_text_end(raw, split)
    if head_end > C_MAX_HEADER_BYTES -> return Err(.InvalidHeader)
    head :: String.from_bytes(slice_b(raw, 0, head_end)) ?? return Err(.Protocol{version: "HTTP"})
    if raw.len() - split > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_BODY_BYTES})
    body_raw :: slice_b(raw, split, raw.len())
    lines :: split_lines(head)
    if lines.len() == 0 || lines[0].bytes().len() > C_MAX_REQUEST_LINE_BYTES -> return Err(.InvalidMethod)
    parts :: split_space_line(lines[0])
    if parts.len() != 3 -> return Err(.InvalidMethod)
    if !valid_method(parts[0]) -> return Err(.InvalidMethod)
    if parts[0] == "CONNECT" {
        if !valid_connect_target(parts[1]) -> return Err(.InvalidURL)
    } else {
        if !valid_target(parts[1]) -> return Err(.InvalidURL)
        if parts[1] == "*" && parts[0] != "OPTIONS" -> return Err(.InvalidURL)
    }
    parsed_version :: version_parse(parts[2])
    if version_text(parsed_version) != parts[2] -> return Err(.Protocol{version: parts[2]})
    if parsed_version == Version.HTTP2 || parsed_version == Version.HTTP3 -> return Err(.Protocol{version: parts[2]})
    hlines := [String]{}
    loop i in 1..<lines.len() {
        if lines[i].bytes().len() > 0 -> &hlines.push(lines[i])
    }
    if !headers_lines_bounded(hlines) || !headers_lines_valid(hlines) -> return Err(.InvalidHeader)
    h := headers_parse(hlines)
    hosts := headers_all(h, "host")
    if parsed_version == Version.HTTP11 {
        if hosts.len() != 1 || !valid_host_value(hosts[0]) -> return Err(.InvalidHeader)
    } else {
        loop host in hosts {
            if !valid_host_value(host) -> return Err(.InvalidHeader)
        }
    }
    if has_ambiguous_framing(h) -> return Err(.InvalidFraming)
    if has_unsupported_encoding(h) -> return Err(.UnsupportedEncoding)
    expected :: content_length(h)
    if expected > C_MAX_BODY_BYTES || (expected >= 0 && expected != body_raw.len()) || (expected < 0 && body_raw.len() > 0) -> return Err(.InvalidFraming)
    req := core.http.client.request(method_text(method_parse(parts[0])), parts[1])
    loop line in hlines {
        col := index_byte(line.bytes(), 58)
        name :: String.from_bytes(slice_b(line.bytes(), 0, col)) ?? return Err(.InvalidHeader)
        value :: String.from_bytes(slice_b(line.bytes(), col + 1, line.bytes().len())) ?? return Err(.InvalidHeader)
        req = &req.header(name, trim(value))
    }
    if body_raw.len() > 0 {
        body_text :: String.from_bytes(body_raw) ?? return Err(.UnsupportedEncoding)
        req = req.body(body_text)
    }
    Ok(req)
}

pub struct StatusLine {
    pub version: Version
    pub status: Status
}

fn parse_status_line(line: String) -> StatusLine? {
    if has_line_ctl(line.bytes()) -> return None
    parts :: split_space_line(line)
    if parts.len() < 2 -> return None
    parsed_version :: version_parse(parts[0])
    if version_text(parsed_version) != parts[0] -> return None
    if parsed_version == Version.HTTP2 || parsed_version == Version.HTTP3 -> return None
    if parts[1].bytes().len() != 3 -> return None
    code :: parse_decimal(parts[1]) ?? return None
    if code < 100 || code > 599 -> return None
    reason := reason_phrase(code)
    if parts.len() > 2 {
        reason = parts[2]
        i := 3
        loop i < parts.len() {
            reason = "{reason} {parts[i]}"
            i = i + 1
        }
    }
    Val(StatusLine{version: parsed_version, status: Status{code: code, reason: reason}})
}

fn split_space_line(text: String) -> [String] Never! {
    raw :: text.bytes()
    out := [String]{}
    if raw.len() == 0 -> return out
    start := 0
    i := 0
    loop i < raw.len() {
        n :: Int.from_u8(raw[i])
        if n == 32 {
            if i == start -> return [String]{}
            &out.push(String.from_bytes(slice_b(raw, start, i)) ?? "")
            start = i + 1
        } else if n < 32 || n == 127 {
            return [String]{}
        }
        i = i + 1
    }
    if start == raw.len() -> return [String]{}
    &out.push(String.from_bytes(slice_b(raw, start, raw.len())) ?? "")
    out
}

fn find_double_crlf(raw: [U8]) -> Int Never! {
    if raw.len() < 4 -> return -1
    i := 0
    loop i + 3 < raw.len() {
        if raw[i] == (U8{13}) && raw[i + 1] == (U8{10}) && raw[i + 2] == (U8{13}) && raw[i + 3] == (U8{10}) -> return i + 4
        i = i + 1
    }
    -1
}


fn header_text_end(raw: [U8], split: Int) -> Int Never! {
    if split >= 4 && raw[split - 4] == (U8{13}) -> return split - 4
    split - 2
}
fn strict_crlf(raw: [U8], end: Int) -> Bool Never! {
    i := 0
    loop i < end {
        if raw[i] == (U8{13}) {
            if i + 1 >= end || raw[i + 1] != (U8{10}) -> return false
        } else if raw[i] == (U8{10}) {
            if i == 0 || raw[i - 1] != (U8{13}) -> return false
        }
        i = i + 1
    }
    true
}

fn split_lines(text: String) -> [String] Never! {
    raw :: text.bytes()
    out := [String]{}
    start := 0
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{10}) {
            end := i
            if end > start && raw[end - 1] == (U8{13}) -> end = end - 1
            &out.push(String.from_bytes(slice_b(raw, start, end)) ?? "")
            start = i + 1
        }
        i = i + 1
    }
    if start < raw.len() -> &out.push(String.from_bytes(slice_b(raw, start, raw.len())) ?? "")
    out
}


pub struct Cookie {
    pub name: String
    pub value: String
    pub domain: String
    pub path: String
    pub secure: Bool
    pub http_only: Bool
    pub same_site: String
    pub max_age: Int
}

pub struct Query {
    pub pairs: [QueryPair]
}

pub struct QueryPair {
    pub key: String
    pub value: String
}

pub fn query() -> Query Never! { Query{pairs: [QueryPair]{}} }

pub fn query_get(q: Query, key: String) -> String? Never! {
    loop p in q.pairs {
        if p.key == key -> return Val(p.value)
    }
    None
}

pub fn query_all(q: Query, key: String) -> [String] Never! {
    out := [String]{}
    loop p in q.pairs {
        if p.key == key -> &out.push(p.value)
    }
    out
}

pub fn query_set(q: Query, key: String, value: String) -> Query Never! {
    pairs := [QueryPair]{}
    replaced := false
    loop p in q.pairs {
        if p.key == key {
            if !replaced {
                &pairs.push(QueryPair{key: key, value: value})
                replaced = true
            }
        } else {
            &pairs.push(p)
        }
    }
    if !replaced {
        &pairs.push(QueryPair{key: key, value: value})
    }
    Query{pairs: pairs}
}

pub fn query_encode(q: Query) -> String Never! {
    s := ""
    first := true
    loop p in q.pairs {
        piece :: "{percent_encode(p.key)}={percent_encode(p.value)}"
        piece_len := piece.bytes().len()
        if piece_len > C_MAX_BODY_BYTES -> return ""
        if first {
            s = piece
            first = false
        } else {
            if s.bytes().len() + piece_len + 1 > C_MAX_BODY_BYTES -> return ""
            s = "{s}&{piece}"
        }
    }
    s
}

pub fn query_decode(text: String) -> Query Never! {
    q := query()
    raw :: text.bytes()
    if raw.len() == 0 || raw.len() > C_MAX_BODY_BYTES -> return q
    start := 0
    if raw[0] == (U8{63}) -> start = 1
    i := start
    loop i <= raw.len() {
        if i == raw.len() || raw[i] == (U8{38}) {
            if i > start {
                eq := -1
                j := start
                loop j < i {
                    if raw[j] == (U8{61}) {
                        eq = j
                        break
                    }
                    j = j + 1
                }
                key_end := if eq >= 0 -> eq else -> i
                value_start := if eq >= 0 -> eq + 1 else -> i
                key :: String.from_bytes(slice_b(raw, start, key_end)) ?? ""
                value :: String.from_bytes(slice_b(raw, value_start, i)) ?? ""
                pairs := ~q.pairs
                &pairs.push(QueryPair{key: percent_decode(key), value: percent_decode(value)})
                q = Query{pairs: pairs}
            }
            start = i + 1
        }
        i = i + 1
    }
    q
}

pub fn form_encode(q: Query) -> String Never! { query_encode(q) }
pub fn form_decode(text: String) -> Query Never! { query_decode(text) }

pub fn cookie(name: String, value: String) -> Cookie Never! {
    Cookie{name: name, value: value, domain: "", path: "/", secure: false, http_only: false, same_site: "Lax", max_age: -1}
}

pub fn cookie_encode(c: Cookie) -> String Never! {
    if !valid_cookie_token(c.name) || !valid_cookie_value(c.value) -> return ""
    s := "{c.name}={c.value}"
    if c.domain.bytes().len() > 0 {
        if !valid_cookie_attribute(c.domain) -> return ""
        s = "{s}; Domain={c.domain}"
    }
    if c.path.bytes().len() > 0 {
        if !valid_cookie_attribute(c.path) -> return ""
        s = "{s}; Path={c.path}"
    }
    if c.max_age >= 0 -> s = "{s}; Max-Age={c.max_age}"
    if c.http_only -> s = "{s}; HttpOnly"
    if c.secure -> s = "{s}; Secure"
    if c.same_site == "Strict" || c.same_site == "Lax" || c.same_site == "None" -> s = "{s}; SameSite={c.same_site}"
    if s.bytes().len() > C_MAX_HEADER_LINE_BYTES -> return ""
    s
}

pub fn cookies_parse(header: String) -> [Cookie] Never! {
    out := [Cookie]{}
    raw :: header.bytes()
    if raw.len() > C_MAX_HEADER_LINE_BYTES -> return out
    start := 0
    i := 0
    first := true
    loop i <= raw.len() {
        if i == raw.len() || raw[i] == (U8{59}) {
            piece :: trim(String.from_bytes(slice_b(raw, start, i)) ?? "")
            eq := index_byte_str(piece, 61)
            if eq > 0 {
                n :: trim(slice_str(piece, 0, eq))
                v :: trim(slice_str(piece, eq + 1, piece.bytes().len()))
                lower :: ascii_lower(n)
                if first || (lower != "domain" && lower != "path" && lower != "max-age" && lower != "expires" && lower != "secure" && lower != "httponly" && lower != "samesite") {
                    if valid_cookie_token(n) && valid_cookie_value(v) -> &out.push(cookie(n, v))
                }
            }
            first = false
            start = i + 1
        }
        i = i + 1
    }
    out
}

pub fn basic_auth(user: String, password: String) -> String Never! {
    credentials := "{user}:{password}"
    "Basic {base64_encode(credentials.bytes())}"
}

pub fn bearer_auth(token: String) -> String Never! { "Bearer {token}" }
pub fn with_header(req: HTTPRequest, name: String, value: String) -> HTTPRequest Never! {
    if !valid_header_name(name) || has_ctl(value.bytes()) -> return ~req
    &req.header(name, value)
}

pub fn with_body(req: HTTPRequest, body: Body) -> HTTPRequest Never! {
    req.body(body_as_text(body))
}

pub fn with_query(url: String, q: Query) -> String Never! {
    enc :: query_encode(q)
    if enc.bytes().len() == 0 -> return ~url
    frag :: split_fragment(url)
    base :: frag.url
    sep := if index_byte_str(base, 63) >= 0 -> "&" else -> "?"
    suffix := ""
    if frag.fragment.bytes().len() > 0 -> suffix = "#{frag.fragment}"
    "{base}{sep}{enc}{suffix}"
}

pub fn status_class(s: Status) -> String Never! {
    if is_informational(s) -> return "informational"
    if is_success(s) -> return "success"
    if is_redirect(s) -> return "redirect"
    if is_client_error(s) -> return "client_error"
    if is_server_error(s) -> return "server_error"
    "unknown"
}

pub fn request_with(method: Method, url: String, h: Headers, body: Body) -> HTTPRequest Never! {
    req := core.http.client.request(method_text(method), url)
    loop f in h.fields -> req = &req.header(f.name, f.value)
    with_body(req, body)
}

pub fn response_ok(body: Body) -> HTTPResponse Never! {
    core.http.server.response(200, body_as_text(body))
}

pub fn response_json_headers() -> Headers Never! { headers_set(headers(), "content-type", "application/json; charset=utf-8") }
pub fn response_text_headers() -> Headers Never! { headers_set(headers(), "content-type", "text/plain; charset=utf-8") }
pub fn has_header(h: Headers, name: String) -> Bool Never! { headers_get(h, name) != None }

pub fn content_length(h: Headers) -> Int Never! {
    values :: headers_all(h, "content-length")
    if values.len() == 0 -> return -1
    first := -1
    loop value in values {
        n :: parse_content_length_value(value) ?? return -1
        if first >= 0 && n != first -> return -1
        first = n
    }
    first
}

fn valid_url(url: String) -> Bool Never! {
    raw :: url.bytes()
    if raw.len() < 8 || raw.len() > C_MAX_URL_BYTES || has_url_ctl(raw) -> return false
    parsed :: http_url.parse(url) ?? return false
    if parsed.scheme != "http" && parsed.scheme != "https" -> return false
    if parsed.host.bytes().len() == 0 || parsed.userinfo().bytes().len() > 0 -> return false
    colon := index_byte(raw, 58)
    if colon <= 0 || colon + 2 >= raw.len() -> return false
    if raw[colon + 1] != (U8{47}) || raw[colon + 2] != (U8{47}) -> return false
    start := colon + 3
    end := start
    loop end < raw.len() {
        if raw[end] == (U8{47}) || raw[end] == (U8{63}) || raw[end] == (U8{35}) -> break
        n :: Int.from_u8(raw[end])
        if n <= 32 || n >= 127 || n == 34 || n == 92 -> return false
        end = end + 1
    }
    end > start
}

fn parse_content_length_value(text: String) -> Int? {
    raw :: text.bytes()
    if raw.len() == 0 -> return None
    first := -1
    start := 0
    i := 0
    loop i <= raw.len() {
        if i == raw.len() || raw[i] == (U8{44}) {
            token :: trim(String.from_bytes(slice_b(raw, start, i)) ?? "")
            n :: parse_decimal(token) ?? return None
            if first >= 0 && first != n -> return None
            first = n
            start = i + 1
        }
        i = i + 1
    }
    if first < 0 -> return None
    Val(first)
}

fn has_url_ctl(bytes: [U8]) -> Bool Never! {
    loop b in bytes {
        n :: Int.from_u8(b)
        if n < 32 || n == 127 -> return true
    }
    false
}

fn has_line_ctl(bytes: [U8]) -> Bool Never! {
    loop b in bytes {
        n :: Int.from_u8(b)
        if n < 32 || n == 127 -> return true
    }
    false
}

fn response_forbids_body(code: Int) -> Bool Never! {
    (code >= 100 && code < 200) || code == 204 || code == 205 || code == 304
}
fn response_forbids_content_length(code: Int) -> Bool Never! {
    (code >= 100 && code < 200) || code == 204
}

fn valid_method_token(method: String) -> Bool Never! { valid_method(method) }

fn valid_method(method: String) -> Bool Never! {
    raw :: method.bytes()
    if raw.len() == 0 -> return false
    loop b in raw {
        if !token_char(Int.from_u8(b)) -> return false
    }
    true
}

fn valid_target(target: String) -> Bool Never! {
    raw :: target.bytes()
    if raw.len() == 0 -> return false
    if target != "*" && raw[0] != (U8{47}) -> return false
    loop b in raw {
        n :: Int.from_u8(b)
        if n <= 32 || n == 127 || n == 35 -> return false
    }
    true
}

fn valid_connect_target(target: String) -> Bool Never! {
    raw :: target.bytes()
    if raw.len() == 0 || has_url_ctl(raw) || index_byte(raw, 58) <= 0 -> return false
    loop b in raw {
        n :: Int.from_u8(b)
        if n >= 127 || n == 34 || n == 92 -> return false
    }
    parsed :: http_url.parse("http://{target}") ?? return false
    parsed.host.bytes().len() > 0 && parsed.userinfo().bytes().len() == 0 && parsed.path == "/" && parsed.query.bytes().len() == 0 && parsed.fragment.bytes().len() == 0
}

fn valid_host_value(value: String) -> Bool Never! {
    raw :: trim(value)
    if raw.bytes().len() == 0 || has_url_ctl(raw.bytes()) -> return false
    loop b in raw.bytes() {
        n :: Int.from_u8(b)
        if n >= 127 || n == 34 || n == 92 -> return false
    }
    parsed :: http_url.parse("http://{raw}") ?? return false
    parsed.host.bytes().len() > 0 && parsed.userinfo().bytes().len() == 0 && parsed.path == "/" && parsed.query.bytes().len() == 0 && parsed.fragment.bytes().len() == 0
}
fn token_char(n: Int) -> Bool Never! {
    (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 33 || n == 35 || n == 36 || n == 37 || n == 38 || n == 39 || n == 42 || n == 43 || n == 45 || n == 46 || n == 94 || n == 95 || n == 96 || n == 124 || n == 126
}

fn has_ambiguous_framing(h: Headers) -> Bool Never! {
    first := -1
    loop value in headers_all(h, "content-length") {
        n :: parse_content_length_value(value) ?? return true
        if first >= 0 && n != first -> return true
        first = n
    }
    has_header(h, "content-length") && has_header(h, "transfer-encoding")
}

fn has_unsupported_encoding(h: Headers) -> Bool Never! {
    if has_header(h, "transfer-encoding") -> return true
    loop value in headers_all(h, "content-encoding") {
        encoding := ascii_lower(trim(value))
        if encoding != "identity" -> return true
    }
    false
}




fn valid_header_line(line: String) -> Bool Never! {
    raw :: line.bytes()
    col := index_byte(raw, 58)
    if col <= 0 -> return false
    name :: String.from_bytes(slice_b(raw, 0, col)) ?? return false
    value :: slice_b(raw, col + 1, raw.len())
    valid_header_name(name) && !has_ctl(value)
}

fn headers_lines_bounded(lines: [String]) -> Bool Never! {
    if lines.len() > C_MAX_HEADER_COUNT -> return false
    total := 0
    loop line in lines {
        n := line.bytes().len()
        if n + 2 > C_MAX_HEADER_BYTES || n > C_MAX_HEADER_LINE_BYTES -> return false
        total = total + n + 2
        if total > C_MAX_HEADER_BYTES -> return false
    }
    true
}

fn headers_lines_valid(lines: [String]) -> Bool Never! {
    if !headers_lines_bounded(lines) -> return false
    loop line in lines {
        if !valid_header_line(line) -> return false
    }
    true
}

fn valid_header_name(name: String) -> Bool Never! {
    raw :: name.bytes()
    if raw.len() == 0 -> return false
    loop b in raw {
        if !token_char(Int.from_u8(b)) -> return false
    }
    true
}
fn has_ctl(bytes: [U8]) -> Bool Never! {
    loop b in bytes {
        n :: Int.from_u8(b)
        if n < 32 && n != 9 -> return true
        if n == 127 -> return true
    }
    false
}

fn valid_cookie_token(name: String) -> Bool {
    raw :: name.bytes()
    if raw.len() == 0 -> return false
    loop b in raw {
        n :: Int.from_u8(b)
        if n <= 32 || n >= 127 || n == 34 || n == 40 || n == 41 || n == 44 || n == 47 || n == 58 || n == 59 || n == 60 || n == 61 || n == 62 || n == 63 || n == 64 || n == 91 || n == 92 || n == 93 || n == 123 || n == 125 -> return false
    }
    true
}

fn valid_cookie_value(value: String) -> Bool {
    loop b in value.bytes() {
        n :: Int.from_u8(b)
        if n <= 32 || n >= 127 || n == 34 || n == 44 || n == 59 || n == 92 -> return false
    }
    true
}

fn valid_cookie_attribute(value: String) -> Bool {
    loop b in value.bytes() {
        n :: Int.from_u8(b)
        if n <= 32 || n >= 127 || n == 59 -> return false
    }
    true
}

fn parse_decimal(text: String) -> Int? {
    raw :: text.bytes()
    if raw.len() == 0 || raw.len() > 10 -> return None
    n := 0
    loop b in raw {
        d :: Int.from_u8(b)
        if d < 48 || d > 57 -> return None
        n = n * 10 + d - 48
    }
    Val(n)
}

fn percent_encode(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        unreserved := (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 45 || n == 46 || n == 95 || n == 126
        if unreserved -> &out.push(b)
        else if n == 32 -> &out.push(U8{43})
        else {
            &out.push(U8{37})
            &out.push(hex_digit(n /% 16))
            &out.push(hex_digit(n %% 16))
        }
    }
    String.from_bytes(out) ?? text
}

fn percent_decode(text: String) -> String {
    raw :: text.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{43}) {
            &out.push(U8{32})
            i = i + 1
            next
        }
        if raw[i] == (U8{37}) && i + 2 < raw.len() {
            hi :: from_hex(raw[i + 1])
            lo :: from_hex(raw[i + 2])
            if hi >= 0 && lo >= 0 {
                &out.push(U8{hi * 16 + lo})
                i = i + 3
                next
            }
        }
        &out.push(raw[i])
        i = i + 1
    }
    String.from_bytes(out) ?? text
}
fn base64_encode(bytes: [U8]) -> String Never! {
    alphabet :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".bytes()
    out := [U8]{}
    i := 0
    loop i < bytes.len() {
        a :: Int.from_u8(bytes[i])
        b := 0
        c := 0
        have_b := i + 1 < bytes.len()
        have_c := i + 2 < bytes.len()
        if have_b -> b = Int.from_u8(bytes[i + 1])
        if have_c -> c = Int.from_u8(bytes[i + 2])
        block :: (a * 65536) + (b * 256) + c
        &out.push(alphabet[(block /% 262144) %% 64])
        &out.push(alphabet[(block /% 4096) %% 64])
        if have_b -> &out.push(alphabet[(block /% 64) %% 64]) else -> &out.push(U8{61})
        if have_c -> &out.push(alphabet[block %% 64]) else -> &out.push(U8{61})
        i = i + 3
    }
    String.from_bytes(out) ?? ""
}

fn hex_digit(n: Int) -> U8 {
    if n < 10 -> return U8{48 + n}
    U8{65 + n - 10}
}

fn from_hex(b: U8) -> Int {
    n :: Int.from_u8(b)
    if n >= 48 && n <= 57 -> return n - 48
    if n >= 65 && n <= 70 -> return n - 55
    if n >= 97 && n <= 102 -> return n - 87
    return -1
}

fn index_byte(text: [U8], code: Int) -> Int Never! {
    loop i in 0..<text.len() {
        if Int.from_u8(text[i]) == code -> return i
    }
    -1
}

fn index_byte_str(text: String, code: Int) -> Int { index_byte(text.bytes(), code) }

fn last_index(raw: [U8], code: Int) -> Int {
    i := raw.len() - 1
    loop i >= 0 {
        if Int.from_u8(raw[i]) == code -> return i
        i = i - 1
    }
    -1
}

fn starts(text: String, prefix: String) -> Bool {
    a :: text.bytes()
    b :: prefix.bytes()
    if b.len() > a.len() -> return false
    loop i in 0..<b.len() {
        if a[i] != b[i] -> return false
    }
    true
}

struct FragmentSplit {
    url: String
    fragment: String
}

fn split_fragment(text: String) -> FragmentSplit {
    at := index_byte_str(text, 35)
    if at < 0 -> return FragmentSplit{url: text, fragment: ""}
    FragmentSplit{url: slice_str(text, 0, at), fragment: slice_str(text, at + 1, text.bytes().len())}
}

fn contains_byte(text: String, code: Int) -> Bool { index_byte(text.bytes(), code) >= 0 }

fn slice_str(text: String, start: Int, end: Int) -> String {
    String.from_bytes(slice_b(text.bytes(), start, end)) ?? ""
}

fn slice_b(raw: [U8], start: Int, end: Int) -> [U8] Never! {
    raw.slice(start, end)
}

