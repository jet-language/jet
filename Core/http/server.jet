use core as core
use core.http.[HTTPError, HTTPRequest, HTTPResponse]
use core.http.server as provider

// core.http.server — source policy over native HTTP transport carriers.
//
// Plain value constructors and deterministic policy live here. Transport and
// callback-bearing mux/lifecycle operations retain their registered carriers.
//
// `bind` and `serve` stay native rows: their label-only `tls:` and
// `deadline:` options take the payload directly and default to absent, a
// contract a Jet `T?` parameter can't state without `Val(...)` at every call.

enum HTTPCorsOrigins {
    Any
    List([String])
}

struct HTTPCorsPolicy {
    origins: HTTPCorsOrigins
    allow_methods: String
    allow_headers: String
    credentials: Bool
    max_age_secs: Int
}

// The native listener accepts this same plain credential carrier.
pub struct HTTPServerTLS {
    pub cert_pem: String
    pub key_pem: String
}

pub fn mux() -> HTTPMux Never! {
    provider.mux()
}

pub fn serve_once(addr: String, mux: HTTPMux) HTTPError! {
    provider.serve_once(addr, mux) ?? return
}

pub fn serve_once_listener(listener: TCPListener, mux: HTTPMux) HTTPError! {
    provider.serve_once_listener(listener, mux) ?? return
}

pub fn response(status: Int, body: String) -> HTTPResponse Never! {
    provider.response(status, body)
}

pub fn json<T: Encode>(status: Int, body: T) -> HTTPResponse Never! {
    provider.json<T>(status, body)
}

pub fn static_file(path: String, content_type: String) -[FS, Net, Time.Wait]> HTTPResponse HTTPError! {
    provider.static_file(path, content_type)
}

pub fn static_file_range(request: HTTPRequest, path: String, content_type: String) -[FS, Net, Time.Wait]> HTTPResponse HTTPError! {
    provider.static_file_range(request, path, content_type)
}

pub fn static_files(mux: HTTPMux, prefix: String, root: String) Never! {
    provider.static_files(mux, prefix, root)
}

pub fn tls(cert: String, key: String) -> HTTPServerTLS Never! {
    HTTPServerTLS{cert_pem: cert, key_pem: key}
}

pub fn sse(body: String) -> HTTPResponse Never! {
    provider.sse(body)
}

pub fn cors_policy(origins: [String] | HTTPCorsOrigins, methods: [String]{[String]{}}, headers: [String]{[String]{}}, credentials: Bool{false}, max_age: Int{86400}) -> HTTPCorsPolicy HTTPError! {
    selected :: if origins == {
        .M__String_(names) -> HTTPCorsOrigins.List(names)
        .HTTPCorsOrigins(value) -> value
    }
    if credentials && selected == .Any {
        return Err(HTTPError.Policy{reason: "CORS credentials need named origins. An `.Any` origin with credentials would let every website read this API, and browsers refuse the pair. List the origins you trust, or set credentials to false."})
    }
    HTTPCorsPolicy{
        origins: selected,
        allow_methods: cors_join(methods, "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS"),
        allow_headers: cors_join(headers, "content-type, authorization, x-request-id"),
        credentials: credentials,
        max_age_secs: max_age,
    }
}

pub fn cors(mux: HTTPMux, policy: HTTPCorsPolicy) Never! {
    provider.cors(mux, policy)
}

pub fn access_log(request: HTTPRequest, status: Int) -> String Never! {
    template :: #Unsafe("borrow the request's stored optional route-template metadata; no route selection or formatting policy") {
        core.http.server.__route_template(request)
    }
    access_log_parts(request.method, request.path, template, status)
}

fn access_log_parts(method: String, path: String, template: String?, status: Int) -> String Never! {
    route :: template ?? access_log_path(path)
    "{method} {route} {status}"
}

fn access_log_path(path: String) -> String Never! {
    raw :: path.bytes()
    end := 0
    loop end < raw.len() && raw[end] != U8{63} -> end = end + 1
    if end == raw.len() -> return path
    String.from_bytes(raw.slice(0, end)) ?? panic("query separator is not a UTF-8 boundary")
}

pub fn request_id(mux: HTTPMux) Never! {
    provider.request_id(mux)
}

fn cors_join(values: [String], fallback: ^String) -> String Never! {
    if values.len() == 0 -> return fallback
    result := ""
    loop i in 0..<values.len() {
        if i > 0 -> result = "{result}, "
        result = "{result}{values[i]}"
    }
    result
}

#Test("CORS policy defaults and explicit values") {
    value :: cors_policy(.Any) ?? panic("default CORS policy")
    assert(value.allow_methods == "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS")
    assert(value.allow_headers == "content-type, authorization, x-request-id")
    assert(!value.credentials)
    assert(value.max_age_secs == 86400)
    named :: cors_policy(.List([String]{"https://example.test"}), methods: [String]{"GET", "PATCH"}, headers: [String]{"x-token"}, credentials: true, max_age: -1) ?? panic("named origins")
    assert(named.allow_methods == "GET, PATCH")
    assert(named.allow_headers == "x-token")
    assert(named.credentials)
    assert(named.max_age_secs == -1)
    minimum :: cors_policy(.List([String]{"https://example.test"}), max_age: -9223372036854775808) ?? panic("explicit minimum max age")
    assert(minimum.max_age_secs == -9223372036854775808)
    if cors_policy(.Any, credentials: true) == {
        .Err(_) -> {}
        .Ok(_) -> panic("wildcard credentials must be refused")
    }
}

#Test("server TLS construction preserves PEM text without validation") {
    value :: tls("certificate\n", "private key\n")
    assert(value.cert_pem == "certificate\n")
    assert(value.key_pem == "private key\n")
    empty :: tls("", "")
    assert(empty.cert_pem == "" && empty.key_pem == "")
}

#Test("access log retains route-template presence and strips only fallback query")
fn _() {
    assert(access_log_parts("GET", "/logs/42?secret=x", None, 200) == "GET /logs/42 200")
    assert(access_log_parts("POST", "/logs/42?secret=x", Val("/logs/:id"), 201) == "POST /logs/:id 201")
    assert(access_log_parts("GET", "/ignored?query=x", Val(""), -7) == "GET  -7")
    assert(access_log_parts("GET", "/ignored", Val("/template?unchanged"), 200) == "GET /template?unchanged 200")
    assert(access_log_parts("GET", "/雪/☃?secret=x", None, 200) == "GET /雪/☃ 200")
    assert(access_log_parts("GET", "?secret=x", None, 200) == "GET  200")
    assert(access_log_parts("GET", "", None, 200) == "GET  200")
}
