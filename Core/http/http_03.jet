    version :: status_parts.next() ?? return Err(JetHTTPBridgeError.InvalidFraming)
    if !version.starts_with("HTTP/") -> return Err(JetHTTPBridgeError.InvalidFraming)
    if version != "HTTP/1.0" && version != "HTTP/1.1" -> return Err(JetHTTPBridgeError.Protocol)
    status_text :: status_parts.next() ?? return Err(JetHTTPBridgeError.InvalidFraming)
    status :: I64.parse(status_text) ?? return Err(JetHTTPBridgeError.InvalidFraming)
    if status < 100 || status > 599 || status_parts.next() == None -> return Err(JetHTTPBridgeError.InvalidFraming)
    headers := [(String, String)]{}
    loop line in lines {
        if headers.len() == 100 -> return Err(JetHTTPBridgeError.InvalidHeader)
        if line.starts_with(' ') || line.starts_with('\t') -> return Err(JetHTTPBridgeError.InvalidHeader)
        (name, value) :: line.split_once(':') ?? return Err(JetHTTPBridgeError.InvalidHeader)
        if name.is_empty() || !name.bytes().all(http_token_byte) || !value.bytes().all(http_field_value_byte) -> return Err(JetHTTPBridgeError.InvalidHeader)
        trimmed := value.trim_matches([' ', '\t']) // #4303
        &headers.push((name.to_ascii_lowercase(), ~trimmed))
    }
    (status, ~version, ^headers)
}
