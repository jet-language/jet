fn write_request(stream: &HTTPStream, bytes: [U8]) -> () (JetHTTPBridgeError, Bool)! {
    written := 0
    loop written < bytes.len() {
        if stream.write(bytes[written..]) == {
            .Ok(0) -> return Err((JetHTTPBridgeError.IO, written != 0))
            .Ok(count) -> written += count
            .Err(error) -> {
                if error.kind() == .Interrupted -> next
                if error.kind() == .TimedOut || error.kind() == .WouldBlock -> return Err((JetHTTPBridgeError.Timeout, written != 0))
                return Err((JetHTTPBridgeError.IO, written != 0))
            }
        }
    }
    stream.flush() ?? return Err((JetHTTPBridgeError.IO, written != 0))
    Ok()
}
