                body :: &bytes.split_off(scan + 4)
                &bytes.truncate(scan + 4)
                return (^bytes, ^body, first_byte_ms ?? elapsed_ms(started))
            }
            scan += 1
        }
        if bytes.len() >= MAX_HEAD -> return Err(JetHTTPBridgeError.InvalidHeader)
        read :: stream.read(&chunk) ?? return Err(if err.kind() == .TimedOut || err.kind() == .WouldBlock { JetHTTPBridgeError.Timeout } else { JetHTTPBridgeError.IO })
        if read == 0 -> return Err(JetHTTPBridgeError.IO)
        if first_byte_ms == None -> first_byte_ms = Val(elapsed_ms(started))
        &bytes.extend_from_slice(chunk[..<read])
    }
}
