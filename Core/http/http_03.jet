// Rust: crates/jet-pkg-model/src/Prelude/HTTP.rs:5413
fn coalesce_request_header_pairs(headers: ^[(String, String)]) -> [(String, String)] {
    out := [(String, String)].with_capacity(headers.len())
    indices := [String:USize]{}
    loop (name, value) in headers {
        key :: name.to_ascii_lowercase()
        if indices.get(key) == .Val(index) {
            &out[index].1.push_str(if name.eq_ignore_ascii_case("cookie") { "; " } else { ", " })
            &out[index].1.push_str(value)
        } else {
            indices[key] = out.len()
            &out.push((^name, ^value))
        }
    }
    out
}
// Rust: crates/jet-pkg-model/src/Prelude/HTTP.rs:5435
fn coalesce_request_headers(flat: [String]) -> [(String, String)] {
    headers := [(String, String)]{}
    indices := [String:USize]{}
    loop pair in flat.chunks_exact(2) {
        key :: pair[0].to_ascii_lowercase()
        if indices.get(key) == .Val(index) {
            &headers[index].1.push_str(if pair[0].eq_ignore_ascii_case("cookie") { "; " } else { ", " })
            &headers[index].1.push_str(pair[1])
        } else {
            indices[key] = headers.len()
            &headers.push((~pair[0], ~pair[1]))
        }
    }
    headers
}
// Rust: crates/jet-pkg-model/src/Prelude/HTTP.rs:5455
fn encode_component(s: String) -> String {
    out := String.new()
    loop b in s.bytes() {
        if b.is_ascii_alphanumeric() || b == 45 || b == 95 || b == 46 || b == 126 { &out.push(b as Char) }
        else if b == 32 { &out.push('+') }
        else { &out.push_str(format("%{:02X}", b)) }
    }
    out
}
// Rust: crates/jet-pkg-model/src/Prelude/HTTP.rs:5469
fn encode_form(fields: [String]) -> String {
    out := String.new()
    i := 0
    loop i + 1 < fields.len() {
        if !out.is_empty() -> &out.push('&')
        &out.push_str(encode_component(fields[i])); &out.push('='); &out.push_str(encode_component(fields[i + 1]))
        i += 2
    }
    out
}
// Rust: crates/jet-pkg-model/src/Prelude/HTTP.rs:5484
fn multipart_boundary(fields: [String]) -> String {
    PREFIX :: "jet-http-boundary-"
    LENGTH :: PREFIX.len() + 16
    used := Set<U64>.new()
    loop field in fields {
        loop window in field.as_bytes().windows(LENGTH) {
            suffix :: window.strip_prefix(PREFIX.as_bytes()) ?? next
            text :: String.from_utf8(suffix) ?? next
            value :: U64.from_str_radix(text, 16) ?? next
            _ :: &used.insert(value)
        }
    }
    suffix := U64{0}
    loop used.contains(suffix) -> suffix = suffix.checked_add(1).expect("in-memory multipart fields cannot contain every u64 boundary suffix")
    format("{}{:016x}", PREFIX, suffix)
}
// Rust: crates/jet-pkg-model/src/Prelude/HTTP.rs:5512
fn encode_multipart(fields: [String], boundary: String) -> String {
    out := String.new()
    i := 0
    loop i + 1 < fields.len() {
        &out.push_str("--"); &out.push_str(boundary); &out.push_str("\r\nContent-Disposition: form-data; name=\"")
        &out.push_str(fields[i].replace('"', "%22").replace('\r', "%0D").replace('\n', "%0A"))
        &out.push_str("\"\r\n\r\n"); &out.push_str(fields[i + 1]); &out.push_str("\r\n")
        i += 2
    }
    &out.push_str("--"); &out.push_str(boundary); &out.push_str("--\r\n")
    out
}
