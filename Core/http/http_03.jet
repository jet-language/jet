fn parse_status_and_headers(head: [U8]) -> (I64, String, [(String, String)]) JetHTTPBridgeError! {
    text :: String.from_utf8(head) ?? return Err(JetHTTPBridgeError.InvalidHeader)
    lines := (text.strip_suffix("\r\n\r\n") ?? return Err(JetHTTPBridgeError.InvalidFraming)).split("\r\n")
