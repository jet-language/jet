fn set_stream_timeouts(stream: &HTTPStream, read: Duration, write: Duration, deadline: Instant?) -> () JetHTTPBridgeError! {
    read :: remaining_timeout(read, deadline) ?? return Err(err)
    write :: remaining_timeout(write, deadline) ?? return Err(err)
    tcp :: if stream == {
        .Plain(value) -> value
        .TLS(value) -> value.get_mut()
        .H2(connection) -> {
            guard :: connection.lock() ?? return Err(JetHTTPBridgeError.Internal)
            return set_stream_timeouts(&guard.io, read, write, deadline)
        }
    }
    tcp.set_read_timeout(Val(read)) ?? return Err(JetHTTPBridgeError.IO)
    tcp.set_write_timeout(Val(write)) ?? return Err(JetHTTPBridgeError.IO)
    Ok()
}
// Rust: crates/jet-pkg-model/src/Prelude/HTTP.rs:3640
fn encode_request(method: String, url: ParsedUrl, proxy: ParsedUrl?, headers: [(String, String)], body_len: USize?, chunked: Bool, decompress: Bool) -> [U8] JetHTTPBridgeError! {
    target :: if proxy != None && url.scheme == "http" { "{url.scheme}://{url.authority}{url.target}" } else { ~url.target }
    out := "{method} {target} HTTP/1.1\r\nHost: {url.authority}\r\n".into_bytes()
    has_length := false
    has_connection := false
    has_accept_encoding := false
    has_transfer := false
    loop (name, value) in headers {
        has_length |= name.eq_ignore_ascii_case("content-length")
        has_connection |= name.eq_ignore_ascii_case("connection")
        has_accept_encoding |= name.eq_ignore_ascii_case("accept-encoding")
        has_transfer |= name.eq_ignore_ascii_case("transfer-encoding")
        &out.extend_from_slice(name.as_bytes()); &out.extend_from_slice(": ".as_bytes())
        &out.extend_from_slice(value.as_bytes()); &out.extend_from_slice("\r\n".as_bytes())
    }
    if decompress && !has_accept_encoding -> &out.extend_from_slice("Accept-Encoding: gzip\r\n".as_bytes())
    if !has_connection -> &out.extend_from_slice("Connection: keep-alive\r\n".as_bytes())
    if chunked {
        if !has_transfer -> &out.extend_from_slice("Transfer-Encoding: chunked\r\n".as_bytes())
    } else if body_len == .Val(length) && !has_length { &out.extend_from_slice("Content-Length: {length}\r\n".as_bytes()) }
    &out.extend_from_slice("\r\n".as_bytes())
    out
}
