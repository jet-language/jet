// core.time.expiring — pure deadline comparison for clock-bound values.
//
// The caller owns the absolute millisecond deadline.  A TTL is applied before
// calling these helpers (`deadline_ms = start_ms + ttl_ms`); this module does
// not own a clock or mutate the value, so refresh is an explicit new deadline.
//
// Expiry is an open boundary: the value is valid at its deadline and expires
// only on a later tick.  A zero TTL is therefore valid at its starting tick;
// a negative TTL is already expired there.  The same rule makes every
// non-positive remaining interval return zero.
/// True only when `now_ms` is strictly after `expires_at_ms`.
pub fn expired(expires_at_ms: Int, now_ms: Int) -> Bool Never! { now_ms > expires_at_ms }

/// Remaining milliseconds, clamped at zero and saturated at `Int`'s maximum.
pub fn remaining_ms(expires_at_ms: Int, now_ms: Int) -> Int Never! {
    if now_ms >= expires_at_ms -> return 0
    // When `now_ms` is negative, subtraction can exceed the positive Int
    // range even though the interval is valid.  Saturate instead of wrapping.
    if now_ms < 0 && expires_at_ms > 9223372036854775807 + now_ms {
        return 9223372036854775807
    }
    expires_at_ms - now_ms
}
