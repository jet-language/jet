//RS     }
//RS }
//RS 
//RS /// A civil-time method the resident JIT admitted but this host cannot marshal is
//RS /// Jet's own defect, never the running program's fault. Returning `0` handed the
//RS /// program a null carrier handle that a later read resolved against an unrelated
//RS /// heap slot, so `ZonedDateTime.add_duration` printed the source file path and
//RS /// answered `offset_seconds() == 0` (#2030). `set_host_fault` is the branded ICE
//RS /// rail for a broken compiler invariant (`jit/runtime_host.rs`); `set_trap`
//RS /// would render `Stop [E3001]` and blame the running program instead.
//RS fn civil_method_defect(recv: &TimeValue, method: &str, detail: &str) -> i64 {
//RS     let kind = time_value_kind(recv);
//RS     Concurrency::with_runtime_mut(|rt| {
//RS         rt.set_host_fault(&format!(
//RS             "jit civil-time host: {detail} for `{kind}.{method}`"
//RS         ));
//RS         0
//RS     })
//RS }
