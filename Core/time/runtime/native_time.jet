//RS     date_new: "jet_jit_date_new" => jet_jit_date_new: ternary;
//RS     date_today: "jet_jit_date_today" => jet_jit_date_today: nullary;
//RS     date_today_prelude: "jet_time_today" => jet_jit_date_today: nullary;
//RS     date_equal: "jet_jit_date_equal" => jet_jit_date_equal: binary_i8;
//RS     date_compare: "jet_jit_date_compare" => jet_jit_date_compare: binary;
//RS     display: "jet_jit_time_display" => jet_jit_time_display: unary;
//RS     duration_display: "jet_jit_duration_display" => jet_jit_duration_display: unary;
//RS     start: "jet_jit_time_start" => jet_jit_time_start: nullary;
//RS     start_canonical: "jet_std_time_start" => jet_jit_time_start: nullary;
//RS     sleep_duration: "jet_std_time_sleep_duration" => jet_jit_time_sleep_duration_ns: unary_void;
