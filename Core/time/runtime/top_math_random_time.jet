// Lines are trimmed before parsing; a record error is re-labelled JSONL with
// its line counted from the record's zero-based index, as in Rust.
fn jet_std_jsonl_parse(text: String) -> [DataTree] EncodingError! {
    out := [DataTree]{}
    lines :: text.lines()
    loop idx in 0..<lines.len() {
        trimmed :: lines[idx].trim()
        if trimmed == "" -> next
        &out.push(jet_std_json_parse(trimmed) ?? return Err(jsonl_error(err, idx)))
    }
    Ok(out)
}
fn jsonl_error(error: EncodingError, index: Int) -> EncodingError {
    failure := error
    failure.format = EncodingFormat.JSONL
    failure.line = if error.line == .Val(line) -> Val(index + line) else -> None
    failure
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:1758
fn jet_std_jsonl_render(rows: [DataTree]) -> String {
    out := ""
    loop row in rows -> out = "{out}{jet_std_json_render_canonical(row)}\n"
    out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:1769
fn jet_std_jsonl_count_rows(text: String) -> Int {
    count := 0
    loop line in text.lines() {
        if line.trim() != "" -> count += 1
    }
    count
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:1774
fn jet_std_jsonl_append_line(text: String, value: DataTree) -> String {
    rendered :: jet_std_json_render_canonical(value)
    if {
        text == "" -> "{rendered}\n"
        text.ends_with("\n") -> "{text}{rendered}\n"
        else -> "{text}\n{rendered}\n"
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:1785
fn jet_std_jsonl_first(text: String) -> DataTree? EncodingError! {
    lines :: text.lines()
    loop idx in 0..<lines.len() {
        trimmed :: lines[idx].trim()
        if trimmed == "" -> next
        return Ok(Val(jet_std_json_parse(trimmed) ?? return Err(jsonl_error(err, idx))))
    }
    Ok(None)
}
