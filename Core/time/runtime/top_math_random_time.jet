// Rust decodes the AOT exact-Int words; the draw itself stays I64.
fn jet_rng_int(r: &Rng, lo: Int, hi: Int) -> Int {
    low :: I64.from_int(lo) ?? int_range_stop()
    high :: I64.from_int(hi) ?? int_range_stop()
    if jet_seeded_rng_int_checked(&r.state, low, high) == {
        .Ok(value) -> Int{value}
        .Err(message) -> jet_runtime_stop("E3010", "", 0, message)
    }
}
// Rust file!()/line!() name the Rust source; jet_runtime_stop routes the
// C-Int range code to the entry report without them.
fn int_range_stop() -> Never { jet_runtime_stop("E1003", "", 0, jet_c_int_range_message()) }
