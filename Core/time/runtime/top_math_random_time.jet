fn jet_clock_tick(c: &Clock, ms: I64) -> I64 {
    now :: c.now().saturating_add(ms)
    c.set(now)
    c.now()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:61
fn jet_clock_advance(c: &Clock, to_ms: I64) -> I64 { c.set(to_ms); c.now() }
