fn jet_std_time_start() -> Stopwatch {
    jet_scheduler_world_reject_uncontrolled("clock")
    Stopwatch{start: host_instant_now()}
}
// GATE #4565: kernel primitive — sample the host monotonic clock.
fn host_instant_now() -> std.time.Instant {
    #Unsafe("sample host monotonic clock for the stopwatch") { std.time.Instant.now() }
