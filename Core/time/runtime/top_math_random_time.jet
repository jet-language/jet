// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:22
fn jet_deadline_exceeded(wait_kind: String) -> Never {
    rendered :: jet_task_deadline(wait_kind).render()
    jet_task_deadline_mark_pending()
    if jet_interrupt_handler_should_unwind() || jet_scheduler_wait_boundary_should_unwind() || jet_typed_deadline_boundary_should_unwind() {
        // GATE #4565: kernel primitive
        #Unsafe("raise the runtime deadline unwind at an audited wait boundary") {
            std.panic.panic_any(JetDeadlineUnwind{rendered})
        }
    }
    jet_runtime_diagnostic(rendered)
}
