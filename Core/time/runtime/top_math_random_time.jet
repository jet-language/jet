// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:1669
// Escapes `char::is_control` (C0, DEL, and the C1 range U+0080-U+009F, whose
// UTF-8 form is C2 80-9F) as \u00xx; \b and \f stay \u0008/\u000c here.
fn jet_quote_json_local(s: String) -> String {
    raw :: s.bytes()
    out := [U8]{34}
    i := 0
    loop i < raw.len() {
        b :: raw[i]
        // A C1 control is the two-byte sequence C2 80..C2 9F.
        c1 :: b == 194 && i + 1 < raw.len() && c1_control(raw[i + 1])
        if {
            b == 34 -> push_ascii(&out, "\\\"")
            b == 92 -> push_ascii(&out, "\\\\")
            b == 10 -> push_ascii(&out, "\\n")
            b == 13 -> push_ascii(&out, "\\r")
            b == 9 -> push_ascii(&out, "\\t")
            b < 32 || b == 127 -> push_ascii(&out, unicode_escape(b))
            c1 -> {
                push_ascii(&out, unicode_escape(raw[i + 1]))
                i += 1
            }
            else -> &out.push(b)
        }
        i += 1
    }
    &out.push(U8{34})
    String.from_bytes(out) ?? ~s
}
fn push_ascii(out: &[U8], text: String) { loop b in text.bytes() -> &out.push(b) }
fn c1_control(second: U8) -> Bool { second >= 128 && second <= 159 }
fn unicode_escape(code: U8) -> String {
    digits :: "0123456789abcdef"
    n :: Int.from_u8(code)
    "\\u00{digits.slice(n /% 16, n /% 16 + 1)}{digits.slice(n %% 16, n %% 16 + 1)}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:1685
// Object keys sort by byte order; Float uses the Rust Debug spelling.
fn jet_std_json_render_canonical(d: DataTree) -> String {
    if d == {
        .Null -> "null"
        .Bool(b) -> "{b}"
        .Int(n) -> "{n}"
        .Float(f) -> float_format.debug(f)
        .Number(_) | .TypedText(_) -> panic("internal JSON carrier escaped typed decode")
        .Text(s) -> jet_quote_json_local(s)
        .Bytes(bs) -> {
            parts :: loop b in bs -> "{b}"
            "[{parts.join(",")}]"
        }
        .Array(xs) -> {
            parts :: loop x in xs -> jet_std_json_render_canonical(x)
            "[{parts.join(",")}]"
        }
        .Object(entries) -> {
            pairs :: loop pair in entries -> pair
            sorted := pairs
            &sorted.sort_by(pair -> pair.key)
            parts :: loop pair in sorted -> "{jet_quote_json_local(pair.key)}:{jet_std_json_render_canonical(pair.value)}"
            "{{{parts.join(",")}}}"
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:1715
fn jet_std_json_events(d: DataTree) -> String {
    out := [String]{}
    json_event_walk("", d, &out)
    out.join("\n")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:1716 (walk)
fn json_event_walk(path: String, t: DataTree, out: &[String]) {
    here :: if path == "" -> "$" else -> path
    if t == {
        .Object(entries) -> {
            &out.push("object_start {here}")
            loop pair in entries -> json_event_walk("{here}.{pair.key}", pair.value, &out)
            &out.push("object_end {here}")
        }
        .Array(items) -> {
            &out.push("array_start {here}")
            loop i in 0..<items.len() -> json_event_walk("{here}[{i}]", items[i], &out)
            &out.push("array_end {here}")
        }
        else -> &out.push("value {here} {jet_std_json_render_canonical(t)}")
    }
}
