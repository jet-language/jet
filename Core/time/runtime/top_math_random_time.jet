    Ok(Duration{ns})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:152
fn jet_duration_from_float(n: F64, unit: DurationUnit) -> Duration RangeError! {
    ns :: duration_kernel.from_float(n, unit.nanoseconds()) ?? return Err(RangeError{reason: duration_kernel.FLOAT_ERROR_REASON})
    Ok(Duration{ns})
}
