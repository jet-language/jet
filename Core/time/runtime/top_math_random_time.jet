}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:638
fn jet_calendar_monthcalendar(year: I64, month: I64) -> [[JetInt]] { jet_calendar_monthcalendar_start(year, month, 0) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:644
fn jet_calendar_monthcalendar_start(year: I64, month: I64, firstweekday: I64) -> [[JetInt]] {
    days :: jet_time_days_in_month(year, month)
    start :: (jet_calendar_weekday_i64(year, month, 1) - firstweekday).rem_euclid(7)
    weeks := [[JetInt]]{}
    week := [JetInt]{}
    for _ in 0..start { week.push(jet_int_owned_from_i64(0)) }
    for day in 1..=days {
        week.push(jet_int_owned_from_i64(day))
        if week.len() == 7 { weeks.push(^week); week = [] }
    }
    if !week.is_empty() {
        while week.len() < 7 { week.push(jet_int_owned_from_i64(0)) }
        weeks.push(^week)
    }
    ^weeks
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:671
fn jet_calendar_yearcalendar(year: I64) -> [[[JetInt]]] { (1..=12).map(month -> jet_calendar_monthcalendar(year, month)).collect() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:678
fn jet_calendar_weekheader(width: I64, firstweekday: I64) -> [String] {
    cell_width :: width.max(1) as USize
    (0..7).map(index -> {
        text :: jet_calendar_day_abbr((index + firstweekday).rem_euclid(7))
        bytes :: text.as_bytes()
        if bytes.len() >= cell_width -> String.from_utf8_lossy(bytes[..cell_width]).into_owned()
        else -> "{text}{\" \".repeat(cell_width - bytes.len())}"
    }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:692
fn jet_calendar_formatmonth(year: I64, month: I64, width: I64) -> String {
    cell_width :: width.max(2) as USize
    heading :: "{jet_calendar_month_name(month)} {year}"
    title_width :: cell_width.saturating_mul(7).saturating_add(6)
    title_bytes :: heading.as_bytes()
    title :: if title_bytes.len() >= title_width -> String.from_utf8_lossy(title_bytes[..title_width]).into_owned()
    else -> {
        left :: (title_width - title_bytes.len()) / 2
        right :: title_width - title_bytes.len() - left
        "{\" \".repeat(left)}{heading}{\" \".repeat(right)}"
    }
    cells :: jet_calendar_weekheader(cell_width as I64, 0)
    out := "{title}\n{cells.join(\" \")}\n"
    for week in jet_calendar_monthcalendar(year, month) {
        row :: week.into_iter().map(day -> {
            text :: day.to_raw().to_string()
            cell :: if text == "0" -> "" else -> text
            if cell.len() >= cell_width -> cell[..cell_width].to_string()
            else -> "{\" \".repeat(cell_width - cell.len())}{cell}"
        }).collect<[String]>().join(" ")
        out.push_str(row)
        out.push('\n')
    }
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:725
fn jet_calendar_formatyear(year: I64) -> String {
    out := String.new()
    for month in 1..=12 { out.push_str(jet_calendar_formatmonth(year, month, 3)); out.push('\n') }
    ^out
}
