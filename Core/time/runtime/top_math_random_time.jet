// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs:428-617
// core.collections owns the binary-heap operations (same sift order: the
// parent stays on ties, then the left child). The named result tuples print
// as the Rust JetShow impls did: "(heap,value) { heap: [...], value: ... }".
use core.collections as collections
fn jet_coll_ints(values: [I64]) -> [Int] {
    ints :: loop value in values -> Int{value}
    ints
}
fn jet_coll_heappop(values: [I64]) -> (heap: [Int], value: Int?) { collections.heappop(jet_coll_ints(values)) }
fn jet_coll_heappushpop(values: [I64], value: I64) -> (heap: [Int], value: Int) {
    collections.heappushpop(jet_coll_ints(values), Int{value})
}
fn jet_coll_heapreplace(values: [I64], value: I64) -> (heap: [Int], value: Int?) {
    collections.heapreplace(jet_coll_ints(values), Int{value})
}
