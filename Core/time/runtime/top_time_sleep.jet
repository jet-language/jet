// One deadline-aware sleep kernel shared by AOT, scheduler, and interpreter adapters.
use core.time.runtime.deadline.[jet_ctx_deadline_ms, jet_ctx_set_deadline_min, jet_std_time_now]
use core.time.runtime.top_math_random_time.[jet_deadline_exceeded]
use jet_std.[jet_task_deadline_if_expired, jet_task_wait_policy, JetTaskWaitInterrupt]
use jet_std.[jet_scheduler_shielded, jet_task_sleep_ms_defaulted, jet_task_delay_ms_defaulted, jet_task_sleep_duration_ns_defaulted]

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TimeSleep.rs:18
pub fn jet_deadline_remaining_ms() -> I64? {
    jet_ctx_deadline_ms().map(d -> d.saturating_sub(jet_std_time_now()))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TimeSleep.rs:25
fn jet_deadline_check(wait_kind: String) -> Unit {
    deadline :: jet_task_deadline_if_expired(jet_deadline_remaining_ms(), wait_kind)
    if Err(JetTaskWaitInterrupt.Deadline(_)) = jet_task_wait_policy(deadline, false, jet_scheduler_shielded()) {
        jet_deadline_exceeded(wait_kind)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TimeSleep.rs:35
pub fn jet_std_time_sleep(millis: I64) -> Unit { jet_task_sleep_ms_defaulted(millis) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TimeSleep.rs:42
pub fn jet_std_time_duration_to_millis(nanos: I64) -> I64 { nanos.saturating_div(1_000_000) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TimeSleep.rs:49
pub fn jet_task_timeout_duration_ns(nanos: I64) -> Unit {
    millis :: jet_std_time_duration_to_millis(nanos)
    delay :: jet_task_delay_ms_defaulted(millis) as I64
    jet_ctx_set_deadline_min(jet_std_time_now().saturating_add(delay))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TimeSleep.rs:57
pub fn jet_std_time_sleep_duration_ns(nanos: I64) -> Unit { jet_task_sleep_duration_ns_defaulted(nanos) }
