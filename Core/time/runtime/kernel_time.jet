// Rust :1728–1758. After the six-byte shape and ASCII-digit checks, both
// two-digit parse calls are infallible; decode directly without span copies.
// The canonical UTF-8 owner still has its documented #4318/#4392 retention
// gate; this consumer does not add a materializing byte seam.
pub fn jet_time_parse_offset(value: String) -> I64 Err! {
    if value == "Z" -> return Ok(I64{0})
    bytes :: time_text.utf8_bytes(value)
    if bytes.len() != 6 -> return Err("bad RFC3339 offset: {value}")
    if bytes[3] != (U8{58}) -> return Err("bad RFC3339 offset: {value}")
    sign :: if {
        bytes[0] == (U8{45}) -> I64{-1}
        bytes[0] == (U8{43}) -> I64{1}
        else -> return Err("bad RFC3339 offset: {value}")
    }
    if bytes[1] < (U8{48}) || bytes[1] > (U8{57}) ||
       bytes[2] < (U8{48}) || bytes[2] > (U8{57}) ||
       bytes[4] < (U8{48}) || bytes[4] > (U8{57}) ||
       bytes[5] < (U8{48}) || bytes[5] > (U8{57}) -> return Err("bad RFC3339 offset: {value}")
    hours :: I64.from_u8(bytes[1] - U8{48}) * I64{10} + I64.from_u8(bytes[2] - U8{48})
    minutes :: I64.from_u8(bytes[4] - U8{48}) * I64{10} + I64.from_u8(bytes[5] - U8{48})
    if hours > (I64{23}) || minutes > (I64{59}) -> return Err("RFC3339 offset out of range: {value}")
    Ok(sign * (hours * I64{3600} + minutes * I64{60}))
