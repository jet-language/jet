    // escaping field loans still require #4392, never clone the info table.
    pub fn info_at_utc(self, secs: I64) -> &CivilTtInfo Never! {
        lo := 0
        hi := self.transitions.len()
        loop lo < hi {
            mid :: lo + (hi - lo) /% 2
            if self.transitions[mid].seconds <= secs -> lo = mid + 1 else -> hi = mid
        }
        index :: if lo == 0 -> 0 else -> self.transitions[lo - 1].info_index
        &self.infos[index]
