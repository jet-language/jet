        None
    }
    pub fn start_of_day(self, date: civil.CivilDate) -> I64 Never! { self.local_to_utc(date, civil.CivilTime.new(I64{0}, I64{0}, I64{0})) }
    pub fn start_of_day_zoned(self, date: civil.CivilDate) -> CivilZonedDateTime Never! { CivilZonedDateTime{instant: CivilDateTime.from_timestamp(self.start_of_day(date)), zone: ~self} }
    pub fn hours_in_day(self, date: civil.CivilDate) -> I64 Never! {
