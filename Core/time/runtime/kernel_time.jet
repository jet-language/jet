// Rust :1474–1498. Equality includes zone NAME, ordering only the instant.
// They must NOT share a derived Comparable implementation.
pub struct CivilZonedDateTime { instant: CivilDateTime, zone: CivilZone }
impl CivilZonedDateTime {
    pub fn equals(self, other: CivilZonedDateTime) -> Bool Never! { self.instant == other.instant && self.zone.name == other.zone.name }
    pub fn compare(self, other: CivilZonedDateTime) -> I64 Never! {
