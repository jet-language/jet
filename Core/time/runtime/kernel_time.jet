// Rust :715–719.
pub fn jet_time_split_unix_nanoseconds(nanoseconds: I64) -> (seconds: I64, nanos: U32) Never! {
    (seconds: nanoseconds /% I64{1000000000}, nanos: U32.from_i64(time_rem(nanoseconds, I64{1000000000})) ?? panic("normalized nanoseconds"))
