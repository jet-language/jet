        CivilDateTime.from_parts(year, month, day, hour, minute, second, self.nanos)
    }
    pub fn in_zone(self, zone: CivilZone) -> CivilZonedDateTime Never! { CivilZonedDateTime{instant: ~self, zone: ~zone} }
}
// Rust :1159–1170, with original transition index semantics.
#Equatable
pub struct CivilTtInfo { pub offset: I64, pub is_dst: Bool }
#Equatable
pub struct CivilTransition { pub seconds: I64, pub info_index: Int }
#Equatable
pub struct CivilZone { name: String, transitions: [CivilTransition], infos: [CivilTtInfo] }

// Rust parse_tzif nested helpers :1226–1253. Index arithmetic is bounded by
// the selected usize maximum supplied by Main from core.sys.usize_max()
// (#4483). This explicit fact argument is NOT inferred from the host or bytes.
fn tz_size_add(a: U64, b: U64, usize_max: U64) -> U64 Never! {
    value :: a.checked_add(b) ?? panic("tzif usize addition overflow")
    if value > usize_max -> panic("tzif usize addition overflow")
    value
}
fn tz_size_mul(a: U64, b: U64, usize_max: U64) -> U64 Never! {
    value :: a.checked_mul(b) ?? panic("tzif usize multiplication overflow")
    if value > usize_max -> panic("tzif usize multiplication overflow")
    value
}
fn tz_index(value: U64) -> Int Never! { Int.from_u64(value) }
fn tz_be_u32(bytes: View<U8>, at: U64, usize_max: U64) -> U32 Err! {
    end :: tz_size_add(at, U64{4}, usize_max)
    if tz_index(end) > bytes.len() -> return Err("truncated tzif")
    i :: tz_index(at)
    Ok((U32.from_u8(bytes[i]) << 24) | (U32.from_u8(bytes[i + 1]) << 16) | (U32.from_u8(bytes[i + 2]) << 8) | U32.from_u8(bytes[i + 3]))
}
fn tz_signed32(word: U32) -> I64 Never! {
    value :: I64.from_u32(word)
    if word >= (U32{2147483648}) -> return value - I64{4294967296}
    value
}
fn tz_be_i64(bytes: View<U8>, at: U64, usize_max: U64) -> I64 Err! {
    end :: tz_size_add(at, U64{8}, usize_max)
    if tz_index(end) > bytes.len() -> return Err("truncated tzif")
    high :: tz_be_u32(bytes, at, usize_max) ?? return Err(err)
    low :: tz_be_u32(bytes, tz_size_add(at, U64{4}, usize_max), usize_max) ?? return Err(err)
    Ok(tz_signed32(high) * I64{4294967296} + I64.from_u32(low))
}
struct TzifHeader { version: U8, gmt: U64, standard: U64, leap: U64, times: U64, types: U64, chars: U64 }
fn tz_header(bytes: View<U8>, base: U64, usize_max: U64) -> TzifHeader Err! {
    end :: tz_size_add(base, U64{4}, usize_max)
    if tz_index(end) > bytes.len() -> return Err("invalid tzif header")
    i :: tz_index(base)
    if bytes[i] != (U8{84}) || bytes[i + 1] != (U8{90}) || bytes[i + 2] != (U8{105}) || bytes[i + 3] != (U8{102}) -> return Err("invalid tzif header")
    version_at :: tz_index(tz_size_add(base, U64{4}, usize_max))
    version :: if version_at < bytes.len() -> bytes[version_at] else -> U8{0}
    gmt :: tz_be_u32(bytes, tz_size_add(base, U64{20}, usize_max), usize_max) ?? return Err(err)
    standard :: tz_be_u32(bytes, tz_size_add(base, U64{24}, usize_max), usize_max) ?? return Err(err)
    leap :: tz_be_u32(bytes, tz_size_add(base, U64{28}, usize_max), usize_max) ?? return Err(err)
    times :: tz_be_u32(bytes, tz_size_add(base, U64{32}, usize_max), usize_max) ?? return Err(err)
    types :: tz_be_u32(bytes, tz_size_add(base, U64{36}, usize_max), usize_max) ?? return Err(err)
    chars :: tz_be_u32(bytes, tz_size_add(base, U64{40}, usize_max), usize_max) ?? return Err(err)
    Ok(TzifHeader{version: version, gmt: U64.from_u32(gmt), standard: U64.from_u32(standard), leap: U64.from_u32(leap), times: U64.from_u32(times), types: U64.from_u32(types), chars: U64.from_u32(chars)})
}
impl CivilZone {
