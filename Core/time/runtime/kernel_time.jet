    // dedup. Only the minimum/maximum/distinct count affect any branch, so no
    // candidate list, sort, or copied zone payload is needed.
    pub fn local_to_utc_with_disambiguation(self, date: civil.CivilDate, time: civil.CivilTime, disambiguation: String) -> I64 Err! {
        if disambiguation != "compatible" && disambiguation != "earlier" && disambiguation != "later" && disambiguation != "reject" -> return Err("invalid disambiguation: {disambiguation}")
        local :: jet_time_utc_from_parts(date, time)
        offsets := [I64: Bool]{}
        candidates := [I64: Bool]{}
        first := I64{0}
        last := I64{0}
        count := 0
        loop info in self.infos {
            if offsets.get(info.offset) != None -> next
            offsets[info.offset] = true
            utc :: local.saturating_sub(info.offset)
            candidate :: self.local_parts(utc)
            if candidate.offset != info.offset || candidate.date != date || candidate.time.to_seconds() != time.to_seconds() -> next
            if candidates.get(utc) != None -> next
            candidates[utc] = true
            if count == 0 || utc < first -> first = utc
            if count == 0 || utc > last -> last = utc
            count += 1
        }
        if count == 1 -> return Ok(first)
        if count > 1 {
            if disambiguation == "reject" -> return Err("ambiguous local time in {self.name}")
            return Ok(if disambiguation == "later" -> last else -> first)
        }
        loop i in 0..<self.transitions.len() {
            transition :: self.transitions[i]
            before :: if i == 0 -> self.infos[0].offset else -> self.infos[self.transitions[i - 1].info_index].offset
            after :: self.infos[transition.info_index].offset
            if after > before {
                start :: transition.seconds.saturating_add(before)
                end :: transition.seconds.saturating_add(after)
                if local >= start && local < end {
                    if disambiguation == "reject" -> return Err("nonexistent local time in {self.name}")
                    return Ok(local.saturating_sub(if disambiguation == "earlier" -> after else -> before))
