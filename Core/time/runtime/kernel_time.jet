    }
    // Rust :1225–1309. Exact validation order: first header, block32 math,
    // second header, timestamps, index span, then ttinfo. Zero typecnt still
    // reads one ttinfo, and invalid indexes clamp, just as the source does.
    pub fn parse_tzif(name: ^String, bytes: View<U8>, usize_max: U64) -> CivilZone Err! {
        first :: tz_header(bytes, U64{0}, usize_max) ?? return Err(err)
        block := tz_size_mul(first.times, U64{4}, usize_max)
        block = tz_size_add(block, first.times, usize_max)
        block = tz_size_add(block, tz_size_mul(first.types, U64{6}, usize_max), usize_max)
        block = tz_size_add(block, first.chars, usize_max)
        block = tz_size_add(block, tz_size_mul(first.leap, U64{8}, usize_max), usize_max)
        block = tz_size_add(block, first.gmt, usize_max)
        block = tz_size_add(block, first.standard, usize_max)
        base := U64{44}
        wide :: first.version == (U8{50}) || first.version == (U8{51}) || first.version == (U8{52})
        counts := first
        if wide {
            base = tz_size_add(U64{44}, block, usize_max)
            counts = tz_header(bytes, base, usize_max) ?? return Err(err)
            base = tz_size_add(base, U64{44}, usize_max)
        }
        typecnt :: if counts.types < (U64{1}) -> U64{1} else -> counts.types
        time_size :: if wide -> U64{8} else -> U64{4}
        pos := base
        times := [I64]{}
        loop _ in 0..<tz_index(counts.times) {
            seconds :: if wide -> tz_be_i64(bytes, pos, usize_max) ?? return Err(err) else -> tz_signed32(tz_be_u32(bytes, pos, usize_max) ?? return Err(err))
            &times.push(seconds)
            pos = tz_size_add(pos, time_size, usize_max)
        }
        index_start :: pos
        index_end :: tz_size_add(pos, counts.times, usize_max)
        if tz_index(index_end) > bytes.len() -> return Err("truncated tzif index")
        pos = index_end
        infos := [CivilTtInfo]{}
        loop _ in 0..<tz_index(typecnt) {
            offset :: tz_signed32(tz_be_u32(bytes, pos, usize_max) ?? return Err(err))
            dst_index :: tz_index(tz_size_add(pos, U64{4}, usize_max))
            dst :: if dst_index < bytes.len() -> bytes[dst_index] != (U8{0}) else -> false
            &infos.push(CivilTtInfo{offset: offset, is_dst: dst})
            pos = tz_size_add(pos, U64{6}, usize_max)
        }
        transitions := [CivilTransition]{}
        loop i in 0..<times.len() {
            raw_index :: Int.from_u8(bytes[tz_index(index_start) + i])
            index :: if raw_index >= infos.len() -> infos.len() - 1 else -> raw_index
            &transitions.push(CivilTransition{seconds: times[i], info_index: index})
        }
        Ok(CivilZone{name: ^name, transitions: transitions, infos: infos})
    }
