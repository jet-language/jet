    seconds == (I64{126230400}) || seconds == (I64{157766400}) ||
    seconds == (I64{189302400}) || seconds == (I64{220924800}) ||
    seconds == (I64{252460800}) || seconds == (I64{283996800}) ||
    seconds == (I64{315532800}) || seconds == (I64{362793600}) ||
    seconds == (I64{394329600}) || seconds == (I64{425865600}) ||
    seconds == (I64{489024000}) || seconds == (I64{567993600}) ||
    seconds == (I64{631152000}) || seconds == (I64{662688000}) ||
    seconds == (I64{709948800}) || seconds == (I64{741484800}) ||
    seconds == (I64{773020800}) || seconds == (I64{820454400}) ||
    seconds == (I64{867715200}) || seconds == (I64{915148800}) ||
    seconds == (I64{1136073600}) || seconds == (I64{1230768000}) ||
    seconds == (I64{1341100800}) || seconds == (I64{1435708800}) ||
    seconds == (I64{1483228800})
