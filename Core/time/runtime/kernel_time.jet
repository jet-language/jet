// Rust :1715–1720. Gregorian day-number owner and saturation order unchanged.
pub fn jet_time_utc_from_parts(date: civil.CivilDate, time: civil.CivilTime) -> I64 Never! {
    epoch :: civil.CivilDate.new(I64{1970}, I64{1}, I64{1}).to_day_number()
    (date.to_day_number() - epoch).saturating_mul(I64{86400}).saturating_add(time.to_seconds())
}
// Rust :722–752. Field order MUST be secs, leap_second, nanos for derived
// ordering; this intentionally differs from Rust's physical field order.
#Comparable
pub struct CivilDateTime { pub secs: I64, pub leap_second: Bool, pub nanos: U32 }
impl CivilDateTime {
