// Prelude/Core/Time.rs:627–1758. Private runtime policy; canonical civil and
// period payloads remain at their existing owners. No public alternate types.
// Source handoff: core.time.runtime assembly needs `module kernel_time`.
// Native clock/world sampling (:288,801,1512), named-zone OS discovery
// (:1186–1224), retained UTF-8/I64 parsing (:73–149,322–375,898–924,
// 1535–1570), and padded append formatting (:1760–2004) are
// explicit #4494/#4483/#4318/#4392 dependencies, NOT callable placeholders.
// Signed128 total/difference/rounding (:249–273,397–465,575–618,695–714,
// 873–892,953–975,1031–1055,1094–1129,1589–1597,1619–1644) requires
// Duration's canonical native signed128 owner (#4262); UInt128Parts is unsigned
// metadata math and cannot replace it. No exact-Int scratch or Rust bridge.
// #4500/#4392: borrowed self/list loops and escaping info_at_utc field loans
// retain the original zone owner; bootstrap copying is not ownership parity.
// :878 to_unix_seconds is exactly :869 to_timestamp for normalized nanos:
// floor((secs + leap)*1e9 + nanos)/1e9 = secs + leap, saturated to I64.
// Integration maps both Rust anchors to the latter canonical body, not an
// additional wide implementation or compatibility alias.
use core.time.runtime.kernel_civil as civil
use core.time.runtime.kernel_period as period
use core.text.runtime.kernel_unicode_string as time_text

// Rust :627–649. All operands retain the source i64 width.
pub fn jet_time_instant_add_duration_ns(start_ns: I64, duration_ns: I64) -> I64 Never! { start_ns.saturating_add(duration_ns) }
pub fn jet_time_instant_sub_duration_ns(start_ns: I64, duration_ns: I64) -> I64 Never! { start_ns.saturating_sub(duration_ns) }
pub fn jet_time_instant_difference_ns(left_ns: I64, right_ns: I64) -> I64 Never! { left_ns.saturating_sub(right_ns) }
pub fn jet_time_instant_elapsed_ns(now_ns: I64, start_ns: I64) -> I64 Never! { now_ns.saturating_sub(start_ns) }
pub fn jet_time_instant_compare(left_ns: I64, right_ns: I64) -> I64 Never! {
    if left_ns < right_ns -> return I64{-1}
    if left_ns > right_ns -> return I64{1}
    I64{0}
}
fn time_rem(value: I64, divisor: I64) -> I64 Never! {
    rem :: value %% divisor
    if rem < (I64{0}) -> return rem + divisor
    rem
}
// Rust :653–685. Fixed membership avoids allocating the static slice per call.
pub fn jet_time_is_leap_second_epoch(seconds: I64) -> Bool Never! {
