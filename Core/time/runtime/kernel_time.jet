        None
    }
    pub fn previous_transition(self, utc_seconds: I64) -> I64? Never! {
        i := self.transitions.len()
        loop i > 0 {
            i -= 1
            if self.transitions[i].seconds < utc_seconds -> return Val(self.transitions[i].seconds)
