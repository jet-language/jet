    pub fn from_timestamp_ns(secs: I64, nanos: U32) -> CivilDateTime Never! { CivilDateTime.from_timestamp_ns_with_leap(secs, nanos, false) }
    pub fn from_timestamp_ns_with_leap(secs: I64, nanos: U32, leap_second: Bool) -> CivilDateTime Never! {
