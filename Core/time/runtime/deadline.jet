// Card #1747: one clock and deadline budget for all execution tiers.
// Policy is plain Jet; the four GATE #4565 kernel primitives below (process
// environment, host wall clock, and the per-thread deadline cell read/swap)
// are the only native leaves.
use core.cell.[Cell, ThreadLocal]
use std.env
use std.time.[SystemTime, UNIX_EPOCH]
use core.tasks.runtime.scheduler.[jet_scheduler_world_now_ms]

// Rust: crates/jet-codegen/src/Prelude/Deadline.rs:13
// Controlled-world wall time precedes the replay environment, the test epoch,
// and the host clock; an unset or non-integer variable falls through.
pub fn jet_std_time_now() -> I64 {
    if {
        jet_scheduler_world_now_ms() == .Val(ms) -> ms
        env_millis("JET_PROVE_REPLAY_TIME_MS") == .Val(ms) -> ms
        env_millis("LEX_TEST_EPOCH") == .Val(ms) -> ms
        else -> host_wall_millis()
    }
}

fn env_millis(name: String) -> I64? {
    text :: env_text(name) ?? return None
    whole :: text.parse<Int>() ?? return None
    Val(I64.from_int(whole) ?? return None)
}

// GATE #4565: kernel primitive — read the actual process environment.
fn env_text(name: String) -> String? {
    #Unsafe("read the named process environment value") { env.var(name).ok() }
}

// GATE #4565: kernel primitive — host wall clock as Unix milliseconds.
fn host_wall_millis() -> I64 {
    #Unsafe("sample real wall clock with pre-epoch fallback to zero") {
        SystemTime.now().duration_since(UNIX_EPOCH).unwrap_or_default().as_millis() as I64
    }
}

// Rust: crates/jet-codegen/src/Prelude/Deadline.rs:36
// GATE #4565: kernel primitive — one deadline cell per executing thread.
JET_CTX_DEADLINE_MS :: #Unsafe("each executing thread owns its independent deadline cell") {
    ThreadLocal.new(() -> Cell.new(None as I64?))
}

// Rust: crates/jet-codegen/src/Prelude/Deadline.rs:51
pub fn jet_ctx_deadline_ms() -> I64? {
    // GATE #4565: kernel primitive
    #Unsafe("read the executing thread's deadline cell") { JET_CTX_DEADLINE_MS.with(cell -> cell.get()) }
}

// Replaces this thread's deadline and returns the previous one.
fn swap_deadline(deadline_ms: I64?) -> I64? {
    // GATE #4565: kernel primitive
    #Unsafe("replace only the executing thread's deadline cell") { JET_CTX_DEADLINE_MS.with(cell -> cell.replace(deadline_ms)) }
}

// Rust: crates/jet-codegen/src/Prelude/Deadline.rs:40
// Restores the previous deadline when the scoped owner drops.
pub struct JetDeadlineGuard { saved: I64? }
// Rust: crates/jet-codegen/src/Prelude/Deadline.rs:44
impl JetDeadlineGuard.Drop {
    fn drop(self: &JetDeadlineGuard) { _ :: swap_deadline(self.saved) }
}

// Rust: crates/jet-codegen/src/Prelude/Deadline.rs:56
pub fn jet_ctx_push_deadline(deadline_ms: I64) -> JetDeadlineGuard {
    JetDeadlineGuard{saved: swap_deadline(Val(deadline_ms))}
}
pub fn jet_ctx_set_deadline_min(deadline_ms: I64) {
    current :: jet_ctx_deadline_ms()
    tightened :: if current == .Val(earlier) && earlier < deadline_ms -> earlier else -> deadline_ms
    _ :: swap_deadline(Val(tightened))
}
