// Card #1747: one clock and deadline budget for all execution tiers.
use core.cell.[Cell, ThreadLocal]
use std.env
use std.time.[SystemTime, UNIX_EPOCH]
use core.tasks.runtime.scheduler.[jet_scheduler_world_now_ms]

// Rust: crates/jet-codegen/src/Prelude/Deadline.rs:13
pub fn jet_std_time_now() -> I64 {
    if Val(now) = jet_scheduler_world_now_ms() -> return now
    // Controlled-world wall time precedes replay environment and the host clock.
    // GATE #4565: kernel primitive
    replay :: #Unsafe("read actual replay clock environment") { env.var("JET_PROVE_REPLAY_TIME_MS") }
    if Ok(s) = replay { if Ok(n) = s.parse<I64>() -> return n }
    // GATE #4565: kernel primitive
    epoch :: #Unsafe("read actual test epoch environment") { env.var("LEX_TEST_EPOCH") }
    if Ok(s) = epoch { if Ok(n) = s.parse<I64>() -> return n }
    // GATE #4565: kernel primitive
    #Unsafe("sample real wall clock with pre-epoch fallback to zero") {
        SystemTime.now().duration_since(UNIX_EPOCH).unwrap_or_default().as_millis() as I64
    }
}
// Rust: crates/jet-codegen/src/Prelude/Deadline.rs:36
// GATE #4565: kernel primitive
JET_CTX_DEADLINE_MS :: #Unsafe("each executing thread owns its independent deadline cell") {
    ThreadLocal.new(fn() { Cell.new(None as I64?) })
}
// Rust: crates/jet-codegen/src/Prelude/Deadline.rs:40
pub struct JetDeadlineGuard { saved: I64? }
// Rust: crates/jet-codegen/src/Prelude/Deadline.rs:44
impl JetDeadlineGuard.Drop {
    // Rust: crates/jet-codegen/src/Prelude/Deadline.rs:45
    fn drop(self: &JetDeadlineGuard) -> Unit {
        // GATE #4565: kernel primitive
        #Unsafe("restore previous thread deadline when the scoped owner drops") {
            JET_CTX_DEADLINE_MS.with(c -> c.set(self.saved))
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Deadline.rs:51
pub fn jet_ctx_deadline_ms() -> I64? {
    // GATE #4565: kernel primitive
    #Unsafe("read current executing thread deadline cell") { JET_CTX_DEADLINE_MS.with(c -> c.get()) }
}
// Rust: crates/jet-codegen/src/Prelude/Deadline.rs:56
pub fn jet_ctx_push_deadline(deadline_ms: I64) -> JetDeadlineGuard {
    // GATE #4565: kernel primitive
    saved :: #Unsafe("replace current thread deadline and retain its previous value for scoped restoration") {
        JET_CTX_DEADLINE_MS.with(c -> c.replace(Val(deadline_ms)))
    }
    JetDeadlineGuard{saved}
}
// Rust: crates/jet-codegen/src/Prelude/Deadline.rs:63
pub fn jet_ctx_set_deadline_min(deadline_ms: I64) -> Unit {
    // GATE #4565: kernel primitive
    #Unsafe("tighten only the current executing thread deadline") {
        JET_CTX_DEADLINE_MS.with(c -> {
            deadline :: c.get().map_or(deadline_ms, current -> current.min(deadline_ms))
            c.set(Val(deadline))
        })
    }
}
