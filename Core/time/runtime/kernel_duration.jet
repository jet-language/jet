// Duration.rs:1–197: fixed nanosecond policy for the shared runtime.
// Scalar operations lower to the canonical primitive/fixed-arithmetic leaves
// and never re-enter this duration owner. Arguments are value scalars.
// String rendering/error-message transport still needs the canonical native
// append/retention owner for allocation parity.
use core.math as duration_math

// Rust jet_duration_kernel_{scale,int,float}_error_reason (:25–35).
pub SCALE_ERROR_REASON :: "duration scaling overflowed or divided by zero"
pub INT_ERROR_REASON :: "duration is outside the supported range"
pub FLOAT_ERROR_REASON :: "duration must be finite and inside the supported range"

SECOND_NS :: I64{1000000000}

// Rust jet_duration_kernel_{from_int,scale} (:3, :17): one checked multiply
// for integer construction and scaling; callers pick the error reason.
pub fn scale(value: I64, factor: I64) -> I64? Never! { value.checked_mul(factor) }

// Rust jet_duration_kernel_from_float (:7). Check before truncating; +2^63 is
// exclusive, whereas -2^63 is an admissible exact Float.
pub fn from_float(value: Float, scale: I64) -> I64? Never! {
    nanoseconds :: value * Float.from_i64(scale)
    if !duration_math.is_finite(nanoseconds) || nanoseconds < -9223372036854775808.0 || nanoseconds >= 9223372036854775808.0 -> return None
    Val(I64.from_float(duration_math.trunc(nanoseconds)) ?? return None)
}

// Rust jet_duration_kernel_divide (:21): checked division truncates, not floors.
pub fn divide(value: I64, factor: I64) -> I64? Never! { value.checked_div(factor) }

// Rust jet_duration_kernel_in (:37): sized I64 division truncates and keeps
// the divide-by-zero/overflow trap (unlike exact Int `/`).
pub fn whole_units(value: I64, scale: I64) -> I64 Never! { value / scale }

// Rust jet_duration_kernel_is_zero (:41).
pub fn is_zero(value: I64) -> Bool Never! { value == 0 }

// Rust jet_duration_kernel_total_seconds (:45).
pub fn total_seconds(value: I64) -> I64 Never! { whole_units(value, SECOND_NS) }

// Rust jet_duration_kernel_seconds_value (:49).
pub fn seconds_value(value: I64) -> Float Never! { Float.from_i64(value) / 1000000000.0 }

// Rust jet_duration_kernel_unit_nanoseconds (:56). Every unit is exactly
// representable in I64; widening this lookup for the signed128 rounding owner
// requires the compiler's native signed128 scalar carrier, not exact Int.
pub fn unit_nanoseconds(unit: String) -> I64? Never! {
    if unit == {
        "nanosecond" | "nanoseconds" | "ns" -> Val(I64{1})
        "microsecond" | "microseconds" | "us" | "µs" -> Val(I64{1000})
        "millisecond" | "milliseconds" | "ms" -> Val(I64{1000000})
        "second" | "seconds" | "s" -> Val(SECOND_NS)
        "minute" | "minutes" | "min" -> Val(I64{60000000000})
        "hour" | "hours" | "h" -> Val(I64{3600000000000})
        "day" | "days" | "d" -> Val(I64{86400000000000})
        "week" | "weeks" | "w" -> Val(I64{604800000000000})
        else -> None
    }
}

// Rust jet_duration_kernel_total_in (:70): unknown units return zero.
pub fn total_in(value: I64, unit: String) -> Float Never! {
    unit_ns :: unit_nanoseconds(unit) ?? return 0.0
    Float.from_i64(value) / Float.from_i64(unit_ns)
}

// Rust jet_duration_kernel_round_quotient (:76), round_i128 (:143), round
// (:156) require native I128 quotient/remainder and checked multiplication.
// Their exact behavioral corpus is retained separately from the executable
// I64 cases; no allocating Int or second wide-arithmetic owner substitutes
// for this missing compiler carrier.

// Rust jet_duration_kernel_negated (:171): MIN saturates to MAX.
pub fn negated(value: I64) -> I64 Never! { I64{0}.saturating_sub(value) }

// Rust jet_duration_kernel_abs (:167).
pub fn abs(value: I64) -> I64 Never! { if value < 0 -> negated(value) else -> value }

// Rust jet_duration_kernel_sign (:175).
pub fn sign(value: I64) -> I64 Never! {
    if {
        value < 0 -> -1
        value > 0 -> 1
        else -> 0
    }
}

// Rust jet_duration_kernel_{add,sub,difference} (:179–190); difference is sub.
pub fn add(left: I64, right: I64) -> I64 Never! { left.saturating_add(right) }
pub fn sub(left: I64, right: I64) -> I64 Never! { left.saturating_sub(right) }

// Rust jet_duration_kernel_show (:195).
pub fn show(value: I64) -> String Never! { "{value}ns" }
