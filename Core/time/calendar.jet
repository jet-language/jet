use core.time as time
// core.time.calendar — Python `calendar` without locale tables.
//
// Weeks start on Monday (`MONDAY = 0`) unless a function takes `firstweekday`.
// Day `0` in a month matrix is a slot outside the month. Names are English
// and fixed; there is no locale override.
MONDAY :: 0

TUESDAY :: 1

WEDNESDAY :: 2

THURSDAY :: 3

FRIDAY :: 4

SATURDAY :: 5

SUNDAY :: 6
// `/%` already rounds toward negative infinity.
fn floor_div(a: Int, b: Int) -> Int { a /% b }


fn isleap(year: Int) -> Bool Never! { time.is_leap_year(year) }

fn leapdays(y1: Int, y2: Int) -> Int Never! {
    a := y1
    b := y2
    if b < a {
        t := a
        a = b
        b = t
    }
    by4 :: leap_multiple_count(a, b, 4)
    by100 :: leap_multiple_count(a, b, 100)
    by400 :: leap_multiple_count(a, b, 400)
    by4 - by100 + by400
}

fn leap_multiple_count(start: Int, end: Int, divisor: Int) -> Int {
    floor_before(end, divisor) - floor_before(start, divisor)
}

fn floor_before(value: Int, divisor: Int) -> Int {
    // `value - 1` is not representable at Int's lower bound.  floor_div
    // already accounts for the negative remainder; only an exact multiple
    // needs one additional step for the exclusive upper bound.
    if value == -9223372036854775808 {
        q :: floor_div(value, divisor)
        if value %% divisor == 0 -> return q - 1
        return q
    }
    floor_div(value - 1, divisor)
}
fn weekday(year: Int, month: Int, day: Int) -> Int Never! {
    // Sakamoto: 0 = Sunday. Convert to Monday = 0.
    y := year
    m := month
    if m < 1 -> m = 1
    if m > 12 -> m = 12
    t :: [Int]{0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4}
    if month < 3 -> y = y - 1
    sun0 := (y + floor_div(y, 4) - floor_div(y, 100) + floor_div(y, 400) + t[m - 1] + day) %% 7
    if sun0 < 0 -> sun0 = sun0 + 7
    (sun0 + 6) %% 7

}
fn monthrange(year: Int, month: Int) -> (days: Int, weekday: Int) Never! {
    days :: time.days_in_month(year, month)
    (days: days, weekday: weekday(year, month, 1))
}

fn monthcalendar(year: Int, month: Int) -> [[Int]] Never! { monthcalendar_start(year, month, 0) }
fn monthcalendar_start(year: Int, month: Int, firstweekday: Int) -> [[Int]] Never! {
    range :: monthrange(year, month)
    first := firstweekday %% 7
    if first < 0 -> first = first + 7
    start := (range.weekday - first) %% 7
    if start < 0 -> start = start + 7
    weeks := [[Int]]{}
    week := [Int]{}
    loop _ in 0..<start -> &week.push(0)
    d := 1
    loop d <= range.days {
        &week.push(d)
        if week.len() == 7 {
            &weeks.push(week)
            week = [Int]{}
        }
        d = d + 1
    }
    if week.len() > 0 {
        loop week.len() < 7 -> &week.push(0)
        &weeks.push(week)
    }
    weeks
}


fn yearcalendar(year: Int) -> [[[Int]]] Never! {
    months := [[[Int]]]{}
    m := 1
    loop m <= 12 {
        &months.push(monthcalendar(year, m))
        m = m + 1
    }
    months
}

fn day_name(weekday: Int) -> String Never! {
    i := weekday
    if i < 0 -> i = 0
    if i > 6 -> i = 6
    if i == {
        0 -> "Monday"
        1 -> "Tuesday"
        2 -> "Wednesday"
        3 -> "Thursday"
        4 -> "Friday"
        5 -> "Saturday"
        else -> "Sunday"
    }
}

fn day_abbr(weekday: Int) -> String Never! {
    i := weekday
    if i < 0 -> i = 0
    if i > 6 -> i = 6
    if i == {
        0 -> "Mon"
        1 -> "Tue"
        2 -> "Wed"
        3 -> "Thu"
        4 -> "Fri"
        5 -> "Sat"
        else -> "Sun"
    }
}

fn month_name(month: Int) -> String Never! {
    i := month
    if i < 1 -> i = 1
    if i > 12 -> i = 12
    if i == {
        1 -> "January"
        2 -> "February"
        3 -> "March"
        4 -> "April"
        5 -> "May"
        6 -> "June"
        7 -> "July"
        8 -> "August"
        9 -> "September"
        10 -> "October"
        11 -> "November"
        else -> "December"
    }
}

fn month_abbr(month: Int) -> String Never! {
    i := month
    if i < 1 -> i = 1
    if i > 12 -> i = 12
    if i == {
        1 -> "Jan"
        2 -> "Feb"
        3 -> "Mar"
        4 -> "Apr"
        5 -> "May"
        6 -> "Jun"
        7 -> "Jul"
        8 -> "Aug"
        9 -> "Sep"
        10 -> "Oct"
        11 -> "Nov"
        else -> "Dec"
    }
}

fn weekheader(width: Int, firstweekday: Int) -> [String] Never! {
    w := width
    if w < 1 -> w = 1
    first := firstweekday %% 7
    if first < 0 -> first = first + 7
    out := [String]{}
    i := 0
    loop i < 7 {
        name :: day_abbr((i + first) %% 7)
        &out.push(clip(name, w))
        i = i + 1
    }
    out
}

fn formatmonth(year: Int, month: Int, width: Int) -> String Never! {
    w := width
    if w < 2 -> w = 2
    title :: "{month_name(month)} {year}"
    out := "{center(title, w * 7 + 6)}\n{join_row(weekheader(w, 0), w)}\n"
    loop week in monthcalendar(year, month) {
        row := [String]{}
        loop d in week {
            if d == 0 -> &row.push(pad("", w)) else -> &row.push(pad("{d}", w))
        }
        out = "{out}{join_row(row, w)}\n"
    }
    out
}

fn formatyear(year: Int) -> String Never! {
    out := ""
    m := 1
    loop m <= 12 {
        out = "{out}{formatmonth(year, m, 3)}\n"
        m = m + 1
    }
    out
}

fn timegm(year: Int, month: Int, day: Int, hour: Int, minute: Int, second: Int) -> Int Never! {
    m :: constrain(month, 1, 12)
    d :: constrain(day, 1, time.days_in_month(year, m))
    y :: year - 1
    offsets :: [Int]{0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334}
    days := 365 * y + floor_div(y, 4) - floor_div(y, 100) + floor_div(y, 400) + offsets[m - 1] + d - 1
    if m > 2 && isleap(year) -> days = days + 1
    // 719162 is the civil day number of 1970-01-01. The epoch carrier
    // saturates the day product before adding the constrained time of day.
    base :: constrain((days - 719162) * 86400, -9223372036854775808, 9223372036854775807)
    seconds :: constrain(hour, 0, 23) * 3600 + constrain(minute, 0, 59) * 60 + constrain(second, 0, 59)
    timestamp := constrain(base + seconds, -9223372036854775808, 9223372036854775807)
    if hour == 23 && minute == 59 && second == 60 -> timestamp = constrain(timestamp + 1, -9223372036854775808, 9223372036854775807)
    timestamp
}


fn clip(text: String, width: Int) -> String {
    raw :: text.bytes()
    if raw.len() <= width -> return pad_end(text, width)
    out := [U8]{}
    i := 0
    loop i < width {
        &out.push(raw[i])
        i = i + 1
    }
    String.from_bytes(out) ?? text.copy()
}

fn pad(text: String, width: Int) -> String {
    raw :: text.bytes()
    if raw.len() >= width -> return text.copy()
    out := text
    n := width - raw.len()
    loop n > 0 {
        out = " {out}"
        n = n - 1
    }
    out
}

fn center(text: String, width: Int) -> String {
    raw :: text.bytes()
    if raw.len() >= width -> return clip(text, width)
    left := (width - raw.len()) /% 2
    right := width - raw.len() - left
    out := ""
    loop left > 0 {
        out = "{out} "
        left = left - 1
    }
    out = "{out}{text}"
    loop right > 0 {
        out = "{out} "
        right = right - 1
    }
    out
}

fn join_row(cells: [String], width: Int) -> String {
    _ :: width
    out := ""
    i := 0
    loop i < cells.len() {
        if i > 0 -> out = "{out} "
        out = "{out}{cells[i]}"
        i = i + 1
    }
    out
}


fn constrain(value: Int, low: Int, high: Int) -> Int Never! {
    if value < low -> return low
    if value > high -> return high
    value
}

fn pad_end(text: String, width: Int) -> String Never! {
    out := text
    n := width - text.bytes().len()
    loop n > 0 {
        out = "{out} "
        n = n - 1
    }
    out
}

#Test("Calendar keeps signed leap intervals and unconstrained month weekdays") {
    assert(isleap(-400))
    assert(!isleap(-100))
    assert(leapdays(1996, 2005) == 3)
    assert(leapdays(2005, 1996) == 3)
    assert(weekday(2024, 2, 1) == 3)
    assert(monthrange(2024, 0).days == 30)
    assert(monthrange(2024, 13).days == 30)
    assert(monthcalendar_start(2024, 2, -1)[0][4] == 1)
    assert(yearcalendar(2024).len() == 12)
}

#Test("Calendar names clamp and headers pad on the right") {
    assert(day_name(-1) == "Monday")
    assert(day_abbr(99) == "Sun")
    assert(month_name(0) == "January")
    assert(month_abbr(99) == "Dec")
    assert(weekheader(5, -1)[0] == "Sun  ")
    assert(weekheader(1, 0)[0] == "M")
    assert(formatmonth(2024, 2, 2).starts_with("   February 2024    \nMo Tu We Th Fr Sa Su\n"))
    assert(formatyear(2024).starts_with(formatmonth(2024, 1, 3)))
}

#Test("Calendar UTC epoch clamps civil fields and preserves leap labels") {
    assert(timegm(1970, 1, 1, 0, 0, 0) == 0)
    assert(timegm(1969, 12, 31, 23, 59, 59) == -1)
    assert(timegm(1970, 0, 0, -1, -1, -1) == 0)
    assert(timegm(1970, 1, 1, 23, 59, 60) == 86400)
    assert(timegm(1970, 1, 1, 23, 58, 60) == 86339)
    assert(timegm(2000, 2, 30, 0, 0, 0) == 951782400)
}
