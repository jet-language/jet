// Rust: crates/jet-pkg-model/src/Prelude/Plugin.rs:250
fn plugin_relative_candidate(path: OSPath, root_text: String) -> OSPath? Err! {
    explicit_root :: root_text != "repo"
    if path.is_absolute() {
        if not explicit_root -> return None
        root :: OSPath.new(root_text)
        if not root.is_absolute() -> return Err("an absolute plugin path requires an absolute explicit FS.Read root")
        relative :: match path.strip_prefix(root).ok() { Val(relative) -> relative, None -> return None }
        if relative.as_os_str().is_empty() -> return Err("plugin path names the FS.Read root, not a file")
        if relative.components().any(|c| -> c is .ParentDir or c is .RootDir or c is .Prefix(_)) -> return Err("plugin path escapes its explicit FS.Read root")
        return Val(relative.to_path_buf())
    }
    if path.components().any(|c| -> c is .ParentDir or c is .RootDir or c is .Prefix(_)) -> return Err("plugin path must be relative and must not contain `..`")
    Val(path.to_path_buf())
}
// Rust: crates/jet-pkg-model/src/Prelude/Plugin.rs:292
fn plugin_authority_from_wire(wire: String) -> CanonicalAuthority Err! {
    rights := [String]{}
    loop raw in wire.split('\n') {
        right := raw.trim() // #4303
        if right.is_empty() -> continue
        if parse_right(right).is_none() -> return Err("plugin authority contains an unknown right `{right}`")
        &rights.push(right.to_string())
    }
    CanonicalAuthority.from_rights(^rights)
}
