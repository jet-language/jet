//RS     let engine = match plugin_engine() {
//RS         Ok(engine) => engine,
//RS         Err(error) => return plugin_error(PluginFailureKind::InternalDefect, error),
//RS     };
//RS     let component = match Component::new(&engine, &component_bytes) {
//RS         Ok(c) => c,
//RS         Err(error) => {
//RS             return plugin_error(
//RS                 PluginFailureKind::UserError,
//RS                 format!("couldn't load plugin `{path}`: {error}"),
//RS             )
//RS         }
//RS     };
//RS     // Host-import registration is driven by typed component facts and this
//RS     // one authority decision.  An import with no checked host definition
//RS     // remains a load error; it is never silently ambient. Every import is
//RS     // admitted before linker instantiation, so denied imports cannot trigger
//RS     // an external adapter.
