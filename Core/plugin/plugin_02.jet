impl PluginCallGuard {
    // Rust: crates/jet-pkg-model/src/Prelude/Plugin.rs:208
    fn enter() -> PluginCallGuard Err! {
        PLUGIN_CALL_DEPTH.with(|depth| -> {
            if depth.get() != USize{0} -> return Err("plugin re-entry is not supported during an active call")
            depth.set(USize{1})
            PluginCallGuard{}
        })
    }
    // Rust: crates/jet-pkg-model/src/Prelude/Plugin.rs:220
    fn drop(self: &PluginCallGuard) -> { PLUGIN_CALL_DEPTH.with(|depth| -> depth.set(depth.get().saturating_sub(USize{1}))) }
}
