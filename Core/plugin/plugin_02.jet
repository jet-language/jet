//RS             "plugin load re-entry is not supported during an active call",
//RS         );
//RS     }
//RS     let authority = match plugin_authority_from_wire(authority_wire) {
//RS         Ok(authority) => authority,
//RS         Err(error) => return plugin_error(PluginFailureKind::UserError, error),
//RS     };
//RS     let authority_decision = plugin_load_import_fact().decision(&authority);
//RS     if authority_decision.verdict != Verdict::Allowed {
//RS         return plugin_error(
