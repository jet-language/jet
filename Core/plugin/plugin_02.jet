//RS /// Close a loaded plugin. Returns `true` if the handle was valid, `false`
//RS /// otherwise (already closed, or never opened).
//RS pub fn jet_plugin_close(handle: u64) -> bool {
//RS     // Unload is owner-thread and call-boundary scoped.  A nested close would
//RS     // invalidate the store while Component Model post-return still owns guest
//RS     // views, so reject it rather than mutating the active map.
