package {
    name: "core.regex"
    version: "0.1.0"
    edition: "2026"
    description: "Checked regular expressions."
    license: "MIT"
    outputs: {
        regex: .Library{ entry: regex }
    }
}

// core.regex — one engine, compile-checked literals, fallible runtime.
//
// `r"..."` literals are a compiler feature. `compile` is for patterns that
// arrive at run time. This file is a bounded backtracking NFA over UTF-8
// bytes: concatenation, `|`, `()` , `*` `+` `?` `{n,m}`, `.`, `^`, `$`,
// `[]`/`[^]` and the usual `\d\w\s` classes. Flags: `ignore_case` (ASCII),
// `multiline`, and `dot_matches_newline`. Every execution consumes an
// explicit finite budget, so hostile nested quantifiers terminate; a pattern
// that does not compile fails with RegexError, never a panic.

#Error
pub enum RegexError {
    Syntax
    Cache
}

pub struct RegexFlags {
    pub ignore_case: Bool
    pub multiline: Bool
    pub dot_matches_newline: Bool
}

pub struct Pattern {
    pub pattern: String
}

pub struct RegexFlag {
    pub name: String
    pub value: Int
}

pub struct Regex {
    pub pattern: String
    pub flags: RegexFlags
    pub nodes: [Node]
    pub root: Int
}

pub struct Match {
    pub start: Int
    pub end: Int
    pub text: String
    pub groups: [String]
}

pub struct Node {
    pub kind: String
    pub s: String
    pub a: Int
    pub b: Int
    pub left: Int
    pub right: Int
    pub neg: Bool
}

pub fn flags(ignore_case: Bool, multiline: Bool, dot_matches_newline: Bool) -> RegexFlags Never! {
    RegexFlags{
    ignore_case: ignore_case,
    multiline: multiline,
    dot_matches_newline: dot_matches_newline,
    }
}

/// Quote regex metacharacters in `text` so it matches as a literal.
pub fn escape(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        if is_meta(b) -> &out.push(U8{92})
        &out.push(b)
    }
    String.from_bytes(out) ?? ""
}

pub fn compile(pattern: String) -> Regex RegexError! { compile_with(pattern, flags(false, false, false)) }

pub fn compile_with(pattern: String, flags: RegexFlags) -> Regex RegexError! {
    p := Parser{bytes: pattern.bytes(), i: 0, flags: flags, nodes: [Node]{}}
    root :: &p.parse_alt()
    if p.i != p.bytes.len() -> return Err(RegexError.Syntax)
    Ok(Regex{pattern: pattern, flags: flags, nodes: p.nodes, root: root})
}

pub fn is_match(pattern: Regex, text: String) -> Bool {
    m :: find(pattern, text)
    m != None
}

pub fn full_match(pattern: Regex, text: String) -> Bool {
    raw :: text.bytes()
    caps := [CaptureSpan]{}
    if run_exec(pattern, raw, 0, pattern.root, &caps) != raw.len() -> return false
    true
}

pub fn match(pattern: Regex, text: String) -> Match? { find_match(pattern, text) }
pub fn finditer(pattern: Regex, text: String) -> [Match] { matches(pattern, text) }

/// The source-owned engine has no process-global cache to mutate. Report that
/// capability explicitly instead of pretending a purge happened.
pub fn purge() RegexError! {
    return Err(RegexError.Cache)
}

pub fn find(pattern: Regex, text: String) -> String? {
    m :: find_match(pattern, text) ?? return None
    Val(m.text)
}

pub fn find_all(pattern: Regex, text: String) -> [String] {
    out := [String]{}
    loop m in matches(pattern, text) -> &out.push(m.text)
    out
}

pub fn matches(pattern: Regex, text: String) -> [Match] {
    raw :: text.bytes()
    out := [Match]{}
    i := 0
    loop i <= raw.len() {
        caps := [CaptureSpan]{}
        end :: run_exec(pattern, raw, i, pattern.root, &caps)
        if end >= i && (end > i || empty_ok(pattern)) {
            &out.push(make_match(raw, i, end, caps))
            if end == i {
                i = i + scalar_width(raw, i)
            } else {
                i = end
            }
        } else {
            i = i + scalar_width(raw, i)
        }
        if out.len() > raw.len() + 1 -> break
    }
    out
}

pub fn split(pattern: Regex, text: String) -> [String] { split_limit(pattern, text, 0) }

pub fn split_limit(pattern: Regex, text: String, n: Int) -> [String] {
    raw :: text.bytes()
    ms :: matches(pattern, text)
    out := [String]{}
    cur := 0
    used := 0
    loop m in ms {
        if n > 0 && used + 1 >= n -> break
        &out.push(slice(raw, cur, m.start))
        cur = m.end
        used = used + 1
    }
    &out.push(slice(raw, cur, raw.len()))
    out
}

pub fn replace(pattern: Regex, text: String, replacement: String) -> String { replace_n(pattern, text, replacement, false) }

/// Expand numbered capture references in a replacement template.
/// Supported forms are `\1` through `\9`, `\g<1>`, `$1`, `${1}`, and `\\`.
pub fn expand(m: Match, template: String) -> String {
    raw :: template.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        marker :: raw[i]
        if marker != (U8{92}) && marker != (U8{36}) {
            &out.push(marker)
            i = i + 1
            next
        }
        i = i + 1
        if i >= raw.len() {
            &out.push(marker)
            break
        }
        n :: raw[i]
        if (marker == (U8{92}) || marker == (U8{36})) && n >= 49 && n <= 57 {
            index := n - 49
            if index < m.groups.len() {
                loop b in m.groups[index].bytes() -> &out.push(b)
            }
            i = i + 1
            next
        }
        if marker == (U8{36}) && n == (U8{123}) {
            j := i + 1
            index := 0
            found := false
            loop j < raw.len() {
                d :: raw[j]
                if d == (U8{125}) {
                    found = true
                    break
                }
                if d < 48 || d > 57 -> break
                index = index * 10 + d - 48
                j = j + 1
            }
            if found && index > 0 && index - 1 < m.groups.len() {
                loop b in m.groups[index - 1].bytes() -> &out.push(b)
                i = j + 1
                next
            }
        }
        if marker == (U8{92}) && n == (U8{103}) && i + 1 < raw.len() && raw[i + 1] == (U8{60}) {
            j := i + 2
            index := 0
            found := false
            loop j < raw.len() {
                d :: raw[j]
                if d == (U8{62}) {
                    found = true
                    break
                }
                if d < 48 || d > 57 -> break
                index = index * 10 + d - 48
                j = j + 1
            }
            if found && index > 0 && index - 1 < m.groups.len() {
                loop b in m.groups[index - 1].bytes() -> &out.push(b)
                i = j + 1
                next
            }
        }
        &out.push(marker)
        &out.push(n)
        i = i + 1
    }
    String.from_bytes(out) ?? ""
}

pub fn replace_first(pattern: Regex, text: String, replacement: String) -> String { replace_n(pattern, text, replacement, true) }

fn replace_n(pattern: Regex, text: String, replacement: String, first_only: Bool) -> String {
    raw :: text.bytes()
    ms :: matches(pattern, text)
    out := [U8]{}
    cur := 0
    loop m in ms {
        loop b in slice(raw, cur, m.start).bytes() -> &out.push(b)
        expanded :: expand(m, replacement)
        loop b in expanded.bytes() -> &out.push(b)
        cur = m.end
        if first_only -> break
    }
    loop b in slice(raw, cur, raw.len()).bytes() -> &out.push(b)
    String.from_bytes(out) ?? ""
}

struct Parser {
    bytes: [U8]
    i: Int
    flags: RegexFlags
    nodes: [Node]
}

struct CaptureSpan {
    start: Int
    end: Int
}

impl Parser {
    fn parse_alt(&self) -> Int RegexError! {
        left :: &self.parse_seq()
        next_byte :: self.peek() ?? (U8{0})
        if next_byte != (U8{124}) -> return Ok(left)
        _ :: &self.bump()
        right :: &self.parse_alt()
        Ok(&self.emit("alt", "", 0, 0, left, right, false))
    }

    fn parse_seq(&self) -> Int RegexError! {
        ids := [Int]{}
        loop {
            b :: self.peek() ?? break
            n :: b
            if n == 124 || n == 41 -> break
            &ids.push(&self.parse_atom())
        }
        if ids.len() == 0 -> return Ok(&self.emit("empty", "", 0, 0, -1, -1, false))
        if ids.len() == 1 -> return Ok(ids[0])
        acc := ids[0]
        loop i in 1..<ids.len() {
            acc = &self.emit("seq", "", 0, 0, acc, ids[i], false)
        }
        Ok(acc)
    }

    fn parse_atom(&self) -> Int RegexError! {
        id :: &self.parse_piece()
        b :: self.peek() ?? return Ok(id)
        n :: b
        if n == 42 {
            _ :: &self.bump()
            return Ok(&self.emit("rep", "", 0, -1, id, -1, false))
        }
        if n == 43 {
            _ :: &self.bump()
            return Ok(&self.emit("rep", "", 1, -1, id, -1, false))
        }
        if n == 63 {
            _ :: &self.bump()
            return Ok(&self.emit("rep", "", 0, 1, id, -1, false))
        }
        if n == 123 {
            _ :: &self.bump()
            lo :: &self.num()
            hi := lo
            comma :: self.peek() ?? (U8{0})
            if comma == (U8{44}) {
                _ :: &self.bump()
                quant_close :: self.peek() ?? (U8{0})
                if quant_close == (U8{125}) {
                    hi = -1
                } else {
                    hi = &self.num()
                }
            }
            if hi >= 0 && hi < lo -> return Err(RegexError.Syntax)
            quant_end :: self.peek() ?? (U8{0})
            if quant_end != (U8{125}) -> return Err(RegexError.Syntax)
            _ :: &self.bump()
            return Ok(&self.emit("rep", "", lo, hi, id, -1, false))
        }
        Ok(id)
    }

    fn parse_piece(&self) -> Int RegexError! {
        b :: &self.bump() ?? return Err(RegexError.Syntax)
        n :: b
        if n == {
            46 -> return Ok(&self.emit("dot", "", 0, 0, -1, -1, false))
            94 -> return Ok(&self.emit("start", "", 0, 0, -1, -1, false))
            36 -> return Ok(&self.emit("end", "", 0, 0, -1, -1, false))
            else -> { _ := 0 }
        }
        if n == 40 -> return &self.parse_group()
        if n == 91 -> return &self.parse_class()
        if n == 92 -> return &self.parse_escape()
        if n == 41 || n == 124 || n == 42 || n == 43 || n == 63 || n == 123 {
            return Err(RegexError.Syntax)
        }
        Ok(&self.emit("lit", String.from_bytes([U8]{b}) ?? "", 0, 0, -1, -1, false))
    }

    fn parse_group(&self) -> Int RegexError! {
        name := ""
        marker :: self.peek() ?? (U8{0})
        if marker == (U8{63}) {
            _ :: &self.bump()
            kind :: &self.bump() ?? return Err(RegexError.Syntax)
            if kind == (U8{58}) {
                inner :: &self.parse_alt()
                group_close :: self.peek() ?? (U8{0})
                if group_close != (U8{41}) -> return Err(RegexError.Syntax)
                _ :: &self.bump()
                return Ok(inner)
            }
            if kind != (U8{60}) -> return Err(RegexError.Syntax)
            raw_name := [U8]{}
            loop {
                c :: &self.bump() ?? return Err(RegexError.Syntax)
                if c == (U8{62}) -> break
                if !is_group_name_char(c) -> return Err(RegexError.Syntax)
                &raw_name.push(c)
            }
            if raw_name.len() == 0 -> return Err(RegexError.Syntax)
            name = String.from_bytes(raw_name) ?? ""
        }
        inner :: &self.parse_alt()
        group_close :: self.peek() ?? (U8{0})
        if group_close != (U8{41}) -> return Err(RegexError.Syntax)
        _ :: &self.bump()
        Ok(&self.emit("group", name, 0, 0, inner, -1, false))
    }

    fn parse_escape(&self) -> Int RegexError! {
        b :: &self.bump() ?? return Err(RegexError.Syntax)
        n :: b
        if n == {
            100 -> return Ok(&self.emit("class", "0-9", 0, 0, -1, -1, false))
            68 -> return Ok(&self.emit("class", "0-9", 0, 0, -1, -1, true))
            119 -> return Ok(&self.emit("class", "A-Za-z0-9_", 0, 0, -1, -1, false))
            87 -> return Ok(&self.emit("class", "A-Za-z0-9_", 0, 0, -1, -1, true))
            115 -> return Ok(&self.emit("class", String.from_bytes([U8]{32, 9, 10, 13, 11, 12}) ?? "", 0, 0, -1, -1, false))
            83 -> return Ok(&self.emit("class", String.from_bytes([U8]{32, 9, 10, 13, 11, 12}) ?? "", 0, 0, -1, -1, true))
            110 -> return Ok(&self.emit("lit", "\n", 0, 0, -1, -1, false))
            114 -> return Ok(&self.emit("lit", String.from_bytes([U8]{13}) ?? "", 0, 0, -1, -1, false))
            116 -> return Ok(&self.emit("lit", "\t", 0, 0, -1, -1, false))
            else -> { _ := 0 }
        }
        Ok(&self.emit("lit", String.from_bytes([U8]{b}) ?? "", 0, 0, -1, -1, false))
    }

    fn parse_class(&self) -> Int RegexError! {
        neg := false
        class_first :: self.peek() ?? (U8{0})
        if class_first == (U8{94}) {
            neg = true
            _ :: &self.bump()
        }
        body := [U8]{}
        first := true
        escaped := false
        loop {
            b :: &self.bump() ?? return Err(RegexError.Syntax)
            if escaped {
                &body.push(b)
                escaped = false
                first = false
                next
            }
            if b == (U8{92}) {
                &body.push(b)
                escaped = true
                first = false
                next
            }
            if b == (U8{93}) {
                // `]` is a literal when it is the first class member, so
                // `[^]]` is a valid negated class rather than an empty one.
                if first {
                    &body.push(b)
                    first = false
                    next
                }
                break
            }
            &body.push(b)
            first = false
        }
        if escaped || body.len() == 0 -> return Err(RegexError.Syntax)
        Ok(&self.emit("class", String.from_bytes(body) ?? "", 0, 0, -1, -1, neg))
    }

    fn emit(&self, kind: String, s: String, a: Int, b: Int, left: Int, right: Int, neg: Bool) -> Int Never! {
        &self.nodes.push(Node{kind: kind, s: s, a: a, b: b, left: left, right: right, neg: neg})
        self.nodes.len() - 1
    }

    fn num(&self) -> Int RegexError! {
        n := 0
        got := false
        loop {
            b :: self.peek() ?? break
            d :: b
            if d < 48 || d > 57 -> break
            // Keep the existing 4096 quantifier limit, but check before
            // multiplying so an arbitrarily long hostile number cannot
            // overflow Int and escape validation.
            if n > 409 || (n == 409 && d > 54) -> return Err(RegexError.Syntax)
            _ :: &self.bump()
            n = n * 10 + (d - 48)
            got = true
        }
        if !got -> return Err(RegexError.Syntax)
        Ok(n)
    }


    fn peek(self) -> U8? {
        if self.i >= self.bytes.len() -> return None
        Val(self.bytes[self.i])
    }

    fn bump(&self) -> U8? {
        if self.i >= self.bytes.len() -> return None
        b :: self.bytes[self.i]
        self.i = self.i + 1
        Val(b)
    }
}

struct MatchBudget {
    remaining: Int
}

fn budget_limit(re: Regex, text: [U8]) -> Int Never! {
    nodes := re.nodes.len()
    bytes := text.len()
    n := nodes
    if n > 4096 -> n = 4096
    m := bytes
    if m > 4096 -> m = 4096
    limit := (n + 1) * (m + 1) * 32
    if limit < 4096 -> return 4096
    if limit > 1000000 -> return 1000000
    limit
}

fn scalar_width(raw: [U8], i: Int) -> Int Never! {
    if i < 0 || i >= raw.len() -> return 1
    n :: raw[i]
    if n < 128 -> return 1
    need := 0
    if n >= 194 && n <= 223 {
        need = 1
    } else if n >= 224 && n <= 239 {
        need = 2
    } else if n >= 240 && n <= 244 {
        need = 3
    } else {
        return 1
    }
    if i + need >= raw.len() -> return 1
    loop k in 1..<(need + 1) {
        c :: raw[i + k]
        if c < 128 || c > 191 -> return 1
    }
    need + 1
}

fn trim_caps(caps: &[CaptureSpan], keep: Int) Never! {
    loop caps.len() > keep -> _ :: &caps.pop()
}

fn run_exec(re: Regex, text: [U8], i: Int, node: Int, caps: &[CaptureSpan]) -> Int Never! {
    budget := MatchBudget{remaining: budget_limit(re, text)}
    exec(re, text, i, node, &caps, &budget)
}

fn flatten_seq(re: Regex, node: Int, parts: &[Int]) Never! {
    if node < 0 || node >= re.nodes.len() -> return
    n :: re.nodes[node]
    if n.kind == "seq" {
        flatten_seq(re, n.left, &parts)
        flatten_seq(re, n.right, &parts)
        return
    }
    &parts.push(node)
}

fn exec_sequence(re: Regex, text: [U8], i: Int, node: Int, caps: &[CaptureSpan], budget: &MatchBudget) -> Int Never! {
    parts := [Int]{}
    flatten_seq(re, node, &parts)
    exec_parts(re, text, i, parts, 0, &caps, &budget)
}

fn exec_parts(re: Regex, text: [U8], pos: Int, parts: [Int], index: Int, caps: &[CaptureSpan], budget: &MatchBudget) -> Int Never! {
    if index >= parts.len() -> return pos
    n :: re.nodes[parts[index]]
    if n.kind == "rep" -> return exec_rep_tail(re, text, pos, n, parts, index + 1, &caps, &budget, 0)
    if n.kind == "alt" -> return exec_alt_tail(re, text, pos, n, parts, index + 1, &caps, &budget)
    end :: exec(re, text, pos, parts[index], &caps, &budget)
    if end < 0 -> return -1
    exec_parts(re, text, end, parts, index + 1, &caps, &budget)
}

fn exec_alt_tail(re: Regex, text: [U8], pos: Int, n: Node, parts: [Int], next: Int, caps: &[CaptureSpan], budget: &MatchBudget) -> Int Never! {
    saved := caps.len()
    left :: exec(re, text, pos, n.left, &caps, &budget)
    if left >= 0 {
        end :: exec_parts(re, text, left, parts, next, &caps, &budget)
        if end >= 0 -> return end
    }
    trim_caps(&caps, saved)
    right :: exec(re, text, pos, n.right, &caps, &budget)
    if right < 0 -> return -1
    exec_parts(re, text, right, parts, next, &caps, &budget)
}

fn exec_rep_tail(re: Regex, text: [U8], pos: Int, n: Node, parts: [Int], next: Int, caps: &[CaptureSpan], budget: &MatchBudget, count: Int) -> Int Never! {
    if n.b >= 0 && count >= n.b -> return exec_parts(re, text, pos, parts, next, &caps, &budget)
    if count >= n.a {
        saved := caps.len()
        nxt :: exec(re, text, pos, n.left, &caps, &budget)
        if nxt >= 0 && nxt != pos {
            deeper :: exec_rep_tail(re, text, nxt, n, parts, next, &caps, &budget, count + 1)
            if deeper >= 0 -> return deeper
            trim_caps(&caps, saved)
        } else {
            trim_caps(&caps, saved)
        }
        return exec_parts(re, text, pos, parts, next, &caps, &budget)
    }
    saved := caps.len()
    nxt :: exec(re, text, pos, n.left, &caps, &budget)
    if nxt < 0 || nxt == pos {
        trim_caps(&caps, saved)
        return -1
    }
    end :: exec_rep_tail(re, text, nxt, n, parts, next, &caps, &budget, count + 1)
    if end < 0 -> trim_caps(&caps, saved)
    end
}

fn exec(re: Regex, text: [U8], i: Int, node: Int, caps: &[CaptureSpan], budget: &MatchBudget) -> Int Never! {
    saved := caps.len()
    if budget.remaining <= 0 -> return -1
    budget.remaining = budget.remaining - 1
    if i < 0 || node < 0 || node >= re.nodes.len() -> return -1
    n :: re.nodes[node]
    if n.kind == "empty" -> return i
    if n.kind == "lit" {
        lit :: n.s.bytes()
        if i + lit.len() > text.len() -> return -1
        loop k in 0..<lit.len() {
            a :: fold(text[i + k], re.flags.ignore_case)
            b :: fold(lit[k], re.flags.ignore_case)
            if a != b -> return -1
        }
        return i + lit.len()
    }
    if n.kind == "dot" {
        if i >= text.len() -> return -1
        if text[i] == (U8{10}) && !re.flags.dot_matches_newline -> return -1
        return i + scalar_width(text, i)
    }
    if n.kind == "start" {
        if i == 0 -> return i
        if re.flags.multiline && i > 0 && text[i - 1] == (U8{10}) -> return i
        return -1
    }
    if n.kind == "end" {
        if i == text.len() -> return i
        if re.flags.multiline && i < text.len() && text[i] == (U8{10}) -> return i
        return -1
    }
    if n.kind == "seq" {
        end :: exec_sequence(re, text, i, node, &caps, &budget)
        if end < 0 -> trim_caps(&caps, saved)
        return end
    }
    if n.kind == "alt" {
        left_saved := caps.len()
        a :: exec(re, text, i, n.left, &caps, &budget)
        if a >= 0 -> return a
        trim_caps(&caps, left_saved)
        return exec(re, text, i, n.right, &caps, &budget)
    }
    if n.kind == "group" {
        slot := caps.len()
        &caps.push(CaptureSpan{start: i, end: -1})
        end :: exec(re, text, i, n.left, &caps, &budget)
        if end >= 0 {
            caps[slot] = CaptureSpan{start: i, end: end}
            return end
        }
        trim_caps(&caps, saved)
        return -1
    }
    if n.kind == "class" {
        if i >= text.len() -> return -1
        width :: scalar_width(text, i)
        if text[i] > (U8{127}) && !n.neg -> return -1
        ok :: class_hit(n.s, text[i], re.flags.ignore_case)
        if n.neg {
            if ok -> return -1
            return i + width
        }
        if ok -> return i + width
        return -1
    }
    if n.kind == "rep" {
        end :: exec_rep(re, text, i, n, &caps, 0, &budget)
        if end < 0 -> trim_caps(&caps, saved)
        return end
    }
    -1
}

fn exec_rep(re: Regex, text: [U8], i: Int, n: Node, caps: &[CaptureSpan], count: Int, budget: &MatchBudget) -> Int Never! {
    if n.b >= 0 && count == n.b -> return i
    if count >= n.a {
        rest :: exec_rep_more(re, text, i, n, &caps, count, &budget)
        if rest >= 0 -> return rest
        return i
    }
    saved := caps.len()
    nxt :: exec(re, text, i, n.left, &caps, &budget)
    if nxt < 0 || (nxt == i && n.b != 0) {
        trim_caps(&caps, saved)
        return -1
    }
    end :: exec_rep(re, text, nxt, n, &caps, count + 1, &budget)
    if end < 0 -> trim_caps(&caps, saved)
    end
}

fn exec_rep_more(re: Regex, text: [U8], i: Int, n: Node, caps: &[CaptureSpan], count: Int, budget: &MatchBudget) -> Int Never! {
    if n.b >= 0 && count >= n.b -> return -1
    saved := caps.len()
    nxt :: exec(re, text, i, n.left, &caps, &budget)
    if nxt < 0 || nxt == i {
        trim_caps(&caps, saved)
        return -1
    }
    after_child := caps.len()
    deeper :: exec_rep_more(re, text, nxt, n, &caps, count + 1, &budget)
    if deeper >= 0 -> return deeper
    trim_caps(&caps, after_child)
    nxt
}

fn class_hit(spec: String, b: U8, fold_case: Bool) -> Bool Never! {
    ch :: fold(b, fold_case)
    raw :: spec.bytes()
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{92}) && i + 1 < raw.len() {
            escaped :: raw[i + 1]
            if escaped == (U8{100}) {
                if b >= (U8{48}) && b <= (U8{57}) -> return true
                i = i + 2
                next
            }
            if escaped == (U8{119}) {
                if ((b >= (U8{48}) && b <= (U8{57})) ||
                    (b >= (U8{65}) && b <= (U8{90})) ||
                    (b >= (U8{97}) && b <= (U8{122})) ||
                    b == (U8{95})) -> return true
                i = i + 2
                next
            }
            if escaped == (U8{115}) {
                if b == (U8{32}) || b == (U8{9}) || b == (U8{10}) ||
                    b == (U8{13}) || b == (U8{11}) || b == (U8{12}) -> return true
                i = i + 2
                next
            }
            if fold(escaped, fold_case) == ch -> return true
            i = i + 2
            next
        }
        if i + 2 < raw.len() && raw[i + 1] == (U8{45}) {
            lo :: fold(raw[i], fold_case)
            hi :: fold(raw[i + 2], fold_case)
            if ch >= lo && ch <= hi -> return true
            i = i + 3
        } else {
            if fold(raw[i], fold_case) == ch -> return true
            i = i + 1
        }
    }
    false
}

fn fold(b: U8, on: Bool) -> Int Never! {
    n :: b
    if on && n >= 65 && n <= 90 -> return n + 32
    n
}

fn find_match(pattern: Regex, text: String) -> Match? {
    raw :: text.bytes()
    i := 0
    loop i <= raw.len() {
        caps := [CaptureSpan]{}
        end :: run_exec(pattern, raw, i, pattern.root, &caps)
        if end >= i {
            return Val(make_match(raw, i, end, caps))
        }
        i = i + scalar_width(raw, i)
    }
    None
}

fn make_match(raw: [U8], start: Int, end: Int, caps: [CaptureSpan]) -> Match Never! {
    groups := [String]{}
    loop g in caps -> &groups.push(slice(raw, g.start, g.end))
    Match{start: start, end: end, text: slice(raw, start, end), groups: groups}
}

fn empty_ok(pattern: Regex) -> Bool { true }

fn slice(raw: [U8], start: Int, end: Int) -> String Never! {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i >= raw.len() -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}

fn is_group_name_char(b: U8) -> Bool Never! {
    n :: b
    n == 95 ||
        (n >= 48 && n <= 57) ||
        (n >= 65 && n <= 90) ||
        (n >= 97 && n <= 122)
}

fn is_meta(b: U8) -> Bool {
    n :: b
    n == 92 || n == 46 || n == 94 || n == 36 || n == 42 || n == 43 || n == 63 || n == 40 || n == 41 || n == 91 || n == 93 || n == 123 || n == 125 || n == 124
}
/// Python-style constructor spelling for a runtime pattern.
pub fn regex(pattern: String) -> Regex RegexError! { compile(pattern) }

/// Return the canonical source pattern represented by a compiled regex.
pub fn join(pattern: Regex) -> String { pattern.pattern }
/// Python `re` spellings over the same compiled Regex carrier.
pub fn search(pattern: Regex, text: String) -> Match? { match(pattern, text) }
pub fn findall(pattern: Regex, text: String) -> [String] { find_all(pattern, text) }
pub fn fullmatch(pattern: Regex, text: String) -> Bool { full_match(pattern, text) }
pub fn sub(pattern: Regex, text: String, replacement: String) -> String {
    replace(pattern, text, replacement)
}
pub fn subn(pattern: Regex, text: String, replacement: String) -> (text: String, count: Int) {
    ms :: matches(pattern, text)
    (text: replace(pattern, text, replacement), count: ms.len())
}
