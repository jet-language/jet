package {
    name: "core.regex"
    version: "0.0.1"
    edition: "2026"
    description: "Checked regular expressions."
    license: "MIT"
    outputs: {
        regex: .Library{ entry: regex }
    }
}

// core.regex — one engine, compile-checked literals, fallible runtime.
//
// `r"..."` literals are a compiler feature. `compile` is for patterns that
// arrive at run time. This file is the same Thompson/Pike VM as the Prelude
// engine (Prelude/CoreLib/JetStd/Regex.rs): the pattern compiles to
// Consume/Save/Split/Assert/Match instructions and one scan advances every
// live thread a scalar at a time, so matching is linear in the text with no
// recursion and no budget. Leftmost-first priority, captures (numbered by
// their `(`), `(?:…)`, `(?<name>…)`, `*` `+` `?` `{n,m}`, `.`, `^`, `$`,
// `[]`/`[^]` and `\d\w\s` follow the Prelude rules; backreferences and
// lookaround are syntax errors there and here. Flags: `ignore_case` (ASCII),
// `multiline` (`^` after a newline), and `dot_matches_newline`. A pattern that
// does not compile fails with RegexError, never a panic.

#Error
pub enum RegexError {
    Syntax
    Cache
}

pub struct RegexFlags {
    pub ignore_case: Bool
    pub multiline: Bool
    pub dot_matches_newline: Bool
}

pub struct Pattern {
    pub pattern: String
}

pub struct RegexFlag {
    pub name: String
    pub value: Int
}

pub struct Regex {
    pub pattern: String
    pub flags: RegexFlags
    insts: [Inst]
    start: Int
    anchored_start: Bool
    groups: Int
}

pub struct Match {
    pub start: Int
    pub end: Int
    pub text: String
    pub groups: [String]
}

struct Node {
    kind: String
    s: String
    a: Int
    b: Int
    left: Int
    right: Int
    neg: Bool
}

pub fn flags(ignore_case: Bool, multiline: Bool, dot_matches_newline: Bool) -> RegexFlags Never! {
    RegexFlags{
    ignore_case: ignore_case,
    multiline: multiline,
    dot_matches_newline: dot_matches_newline,
    }
}

/// Quote regex metacharacters in `text` so it matches as a literal.
pub fn escape(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        if is_meta(b) -> &out.push(U8{92})
        &out.push(b)
    }
    String.from_bytes(out) ?? ""
}

pub fn compile(pattern: String) -> Regex RegexError! { compile_with(pattern, flags(false, false, false)) }

pub fn compile_with(pattern: String, flags: RegexFlags) -> Regex RegexError! {
    p := Parser{bytes: pattern.bytes(), i: 0, flags: flags, nodes: [Node]{}, groups: 0}
    root :: &p.parse_alt()
    if p.i != p.bytes.len() -> return Err(RegexError.Syntax)
    c := Compiler{nodes: p.nodes, insts: [Inst]{}}
    frag :: &c.compile(root)
    done :: &c.push(OP_MATCH, "", false, -1)
    &c.patch(frag.outs, done)
    anchored :: c.insts[frag.start].op == OP_ASSERT_START
    Ok(Regex{pattern: pattern, flags: flags, insts: c.insts, start: frag.start, anchored_start: anchored, groups: p.groups})
}

pub fn is_match(pattern: Regex, text: String) -> Bool Never! {
    scan(pattern, text.bytes(), 0, false, false, true, 1).len() > 0
}

pub fn full_match(pattern: Regex, text: String) -> Bool Never! {
    raw :: text.bytes()
    runs :: scan(pattern, raw, 0, true, false, false, 1)
    runs.len() == 1 && runs[0].start == 0 && runs[0].end == raw.len()
}

pub fn match(pattern: Regex, text: String) -> Match? Never! { find_match(pattern, text) }
pub fn finditer(pattern: Regex, text: String) -> [Match] Never! { matches(pattern, text) }

/// The source-owned engine has no process-global cache to mutate. Report that
/// capability explicitly instead of pretending a purge happened.
pub fn purge() RegexError! {
    return Err(RegexError.Cache)
}

pub fn find(pattern: Regex, text: String) -> String? Never! {
    m :: find_match(pattern, text) ?? return None
    Val(m.text)
}

pub fn find_all(pattern: Regex, text: String) -> [String] Never! {
    out := [String]{}
    loop m in matches(pattern, text) -> &out.push(m.text)
    out
}

pub fn matches(pattern: Regex, text: String) -> [Match] Never! {
    raw :: text.bytes()
    out := [Match]{}
    loop run in scan(pattern, raw, 0, false, true, false, -1) -> &out.push(make_match(raw, run, pattern.groups))
    out
}

pub fn split(pattern: Regex, text: String) -> [String] Never! { split_limit(pattern, text, 0) }

pub fn split_limit(pattern: Regex, text: String, n: Int) -> [String] Never! {
    raw :: text.bytes()
    if n == 1 -> return [String]{text}
    limit := -1
    if n > 1 -> limit = n - 1
    out := [String]{}
    cur := 0
    loop run in scan(pattern, raw, 0, false, false, false, limit) {
        &out.push(slice(raw, cur, run.start))
        cur = run.end
    }
    &out.push(slice(raw, cur, raw.len()))
    out
}

pub fn replace(pattern: Regex, text: String, replacement: String) -> String Never! { replace_n(pattern, text, replacement, false) }

/// Expand numbered capture references in a replacement template.
/// Supported forms are `\1` through `\9`, `\g<1>`, `$1`, `${1}`, and `\\`.
pub fn expand(m: Match, template: String) -> String Never! {
    raw :: template.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        marker :: raw[i]
        if marker != (U8{92}) && marker != (U8{36}) {
            &out.push(marker)
            i = i + 1
            next
        }
        i = i + 1
        if i >= raw.len() {
            &out.push(marker)
            break
        }
        n :: raw[i]
        if (marker == (U8{92}) || marker == (U8{36})) && n >= 49 && n <= 57 {
            index := n - 49
            if index < m.groups.len() {
                loop b in m.groups[index].bytes() -> &out.push(b)
            }
            i = i + 1
            next
        }
        if marker == (U8{36}) && n == (U8{123}) {
            j := i + 1
            index := 0
            found := false
            loop j < raw.len() {
                d :: raw[j]
                if d == (U8{125}) {
                    found = true
                    break
                }
                if d < 48 || d > 57 -> break
                index = index * 10 + d - 48
                j = j + 1
            }
            if found && index > 0 && index - 1 < m.groups.len() {
                loop b in m.groups[index - 1].bytes() -> &out.push(b)
                i = j + 1
                next
            }
        }
        if marker == (U8{92}) && n == (U8{103}) && i + 1 < raw.len() && raw[i + 1] == (U8{60}) {
            j := i + 2
            index := 0
            found := false
            loop j < raw.len() {
                d :: raw[j]
                if d == (U8{62}) {
                    found = true
                    break
                }
                if d < 48 || d > 57 -> break
                index = index * 10 + d - 48
                j = j + 1
            }
            if found && index > 0 && index - 1 < m.groups.len() {
                loop b in m.groups[index - 1].bytes() -> &out.push(b)
                i = j + 1
                next
            }
        }
        &out.push(marker)
        &out.push(n)
        i = i + 1
    }
    String.from_bytes(out) ?? ""
}

pub fn replace_first(pattern: Regex, text: String, replacement: String) -> String Never! { replace_n(pattern, text, replacement, true) }

fn replace_n(pattern: Regex, text: String, replacement: String, first_only: Bool) -> String {
    raw :: text.bytes()
    limit := -1
    if first_only -> limit = 1
    out := [U8]{}
    cur := 0
    loop run in scan(pattern, raw, 0, false, true, false, limit) {
        loop b in slice(raw, cur, run.start).bytes() -> &out.push(b)
        expanded :: expand(make_match(raw, run, pattern.groups), replacement)
        loop b in expanded.bytes() -> &out.push(b)
        cur = run.end
    }
    loop b in slice(raw, cur, raw.len()).bytes() -> &out.push(b)
    String.from_bytes(out) ?? ""
}

struct Parser {
    bytes: [U8]
    i: Int
    flags: RegexFlags
    nodes: [Node]
    groups: Int
}

impl Parser {
    fn parse_alt(&self) -> Int RegexError! {
        left :: &self.parse_seq()
        next_byte :: self.peek() ?? (U8{0})
        if next_byte != (U8{124}) -> return Ok(left)
        _ :: &self.bump()
        right :: &self.parse_alt()
        Ok(&self.emit("alt", "", 0, 0, left, right, false))
    }

    fn parse_seq(&self) -> Int RegexError! {
        ids := [Int]{}
        loop {
            b :: self.peek() ?? break
            n :: b
            if n == 124 || n == 41 -> break
            &ids.push(&self.parse_atom())
        }
        if ids.len() == 0 -> return Ok(&self.emit("empty", "", 0, 0, -1, -1, false))
        if ids.len() == 1 -> return Ok(ids[0])
        acc := ids[0]
        loop i in 1..<ids.len() {
            acc = &self.emit("seq", "", 0, 0, acc, ids[i], false)
        }
        Ok(acc)
    }

    fn parse_atom(&self) -> Int RegexError! {
        id :: &self.parse_piece()
        b :: self.peek() ?? return Ok(id)
        n :: b
        if n == 42 {
            _ :: &self.bump()
            return Ok(&self.emit("rep", "", 0, -1, id, -1, false))
        }
        if n == 43 {
            _ :: &self.bump()
            return Ok(&self.emit("rep", "", 1, -1, id, -1, false))
        }
        if n == 63 {
            _ :: &self.bump()
            return Ok(&self.emit("rep", "", 0, 1, id, -1, false))
        }
        if n == 123 {
            _ :: &self.bump()
            lo :: &self.num()
            hi := lo
            comma :: self.peek() ?? (U8{0})
            if comma == (U8{44}) {
                _ :: &self.bump()
                quant_close :: self.peek() ?? (U8{0})
                if quant_close == (U8{125}) {
                    hi = -1
                } else {
                    hi = &self.num()
                }
            }
            if hi >= 0 && hi < lo -> return Err(RegexError.Syntax)
            quant_end :: self.peek() ?? (U8{0})
            if quant_end != (U8{125}) -> return Err(RegexError.Syntax)
            _ :: &self.bump()
            return Ok(&self.emit("rep", "", lo, hi, id, -1, false))
        }
        Ok(id)
    }

    fn parse_piece(&self) -> Int RegexError! {
        b :: &self.bump() ?? return Err(RegexError.Syntax)
        n :: b
        if n == {
            46 -> return Ok(&self.emit("dot", "", 0, 0, -1, -1, false))
            94 -> return Ok(&self.emit("start", "", 0, 0, -1, -1, false))
            36 -> return Ok(&self.emit("end", "", 0, 0, -1, -1, false))
            else -> { _ := 0 }
        }
        if n == 40 -> return &self.parse_group()
        if n == 91 -> return &self.parse_class()
        if n == 92 -> return &self.parse_escape()
        if n == 41 || n == 124 || n == 42 || n == 43 || n == 63 || n == 123 {
            return Err(RegexError.Syntax)
        }
        // One literal is one scalar: a UTF-8 lead byte takes its continuation
        // bytes, so the VM consumes the whole character in one step.
        lit := [U8]{b}
        if n >= 192 {
            loop {
                c :: self.peek() ?? break
                if c < (U8{128}) || c > (U8{191}) -> break
                _ :: &self.bump()
                &lit.push(c)
            }
        }
        Ok(&self.emit("lit", String.from_bytes(lit) ?? "", 0, 0, -1, -1, false))
    }

    fn parse_group(&self) -> Int RegexError! {
        name := ""
        marker :: self.peek() ?? (U8{0})
        if marker == (U8{63}) {
            _ :: &self.bump()
            kind :: &self.bump() ?? return Err(RegexError.Syntax)
            if kind == (U8{58}) {
                inner :: &self.parse_alt()
                group_close :: self.peek() ?? (U8{0})
                if group_close != (U8{41}) -> return Err(RegexError.Syntax)
                _ :: &self.bump()
                return Ok(inner)
            }
            if kind != (U8{60}) -> return Err(RegexError.Syntax)
            raw_name := [U8]{}
            loop {
                c :: &self.bump() ?? return Err(RegexError.Syntax)
                if c == (U8{62}) -> break
                if !is_group_name_char(c) -> return Err(RegexError.Syntax)
                &raw_name.push(c)
            }
            if raw_name.len() == 0 -> return Err(RegexError.Syntax)
            name = String.from_bytes(raw_name) ?? ""
        }
        // Capture numbers follow the opening `(`, as in the Prelude engine.
        self.groups = self.groups + 1
        index :: self.groups
        inner :: &self.parse_alt()
        group_close :: self.peek() ?? (U8{0})
        if group_close != (U8{41}) -> return Err(RegexError.Syntax)
        _ :: &self.bump()
        Ok(&self.emit("group", name, index, 0, inner, -1, false))
    }

    fn parse_escape(&self) -> Int RegexError! {
        b :: &self.bump() ?? return Err(RegexError.Syntax)
        n :: b
        if n == {
            100 -> return Ok(&self.emit("class", "0-9", 0, 0, -1, -1, false))
            68 -> return Ok(&self.emit("class", "0-9", 0, 0, -1, -1, true))
            119 -> return Ok(&self.emit("class", "A-Za-z0-9_", 0, 0, -1, -1, false))
            87 -> return Ok(&self.emit("class", "A-Za-z0-9_", 0, 0, -1, -1, true))
            115 -> return Ok(&self.emit("class", String.from_bytes([U8]{32, 9, 10, 13, 11, 12}) ?? "", 0, 0, -1, -1, false))
            83 -> return Ok(&self.emit("class", String.from_bytes([U8]{32, 9, 10, 13, 11, 12}) ?? "", 0, 0, -1, -1, true))
            110 -> return Ok(&self.emit("lit", "\n", 0, 0, -1, -1, false))
            114 -> return Ok(&self.emit("lit", String.from_bytes([U8]{13}) ?? "", 0, 0, -1, -1, false))
            116 -> return Ok(&self.emit("lit", "\t", 0, 0, -1, -1, false))
            else -> {
                // Backreferences are not linear; the Prelude engine rejects them too.
                if n >= 48 && n <= 57 -> return Err(RegexError.Syntax)
            }
        }
        Ok(&self.emit("lit", String.from_bytes([U8]{b}) ?? "", 0, 0, -1, -1, false))
    }

    fn parse_class(&self) -> Int RegexError! {
        neg := false
        class_first :: self.peek() ?? (U8{0})
        if class_first == (U8{94}) {
            neg = true
            _ :: &self.bump()
        }
        body := [U8]{}
        first := true
        escaped := false
        loop {
            b :: &self.bump() ?? return Err(RegexError.Syntax)
            if escaped {
                &body.push(b)
                escaped = false
                first = false
                next
            }
            if b == (U8{92}) {
                &body.push(b)
                escaped = true
                first = false
                next
            }
            if b == (U8{93}) {
                // `]` is a literal when it is the first class member, so
                // `[^]]` is a valid negated class rather than an empty one.
                if first {
                    &body.push(b)
                    first = false
                    next
                }
                break
            }
            &body.push(b)
            first = false
        }
        if escaped || body.len() == 0 -> return Err(RegexError.Syntax)
        Ok(&self.emit("class", String.from_bytes(body) ?? "", 0, 0, -1, -1, neg))
    }

    fn emit(&self, kind: String, s: String, a: Int, b: Int, left: Int, right: Int, neg: Bool) -> Int Never! {
        &self.nodes.push(Node{kind: kind, s: s, a: a, b: b, left: left, right: right, neg: neg})
        self.nodes.len() - 1
    }

    fn num(&self) -> Int RegexError! {
        n := 0
        got := false
        loop {
            b :: self.peek() ?? break
            d :: b
            if d < 48 || d > 57 -> break
            // Keep the existing 4096 quantifier limit, but check before
            // multiplying so an arbitrarily long hostile number cannot
            // overflow Int and escape validation.
            if n > 409 || (n == 409 && d > 54) -> return Err(RegexError.Syntax)
            _ :: &self.bump()
            n = n * 10 + (d - 48)
            got = true
        }
        if !got -> return Err(RegexError.Syntax)
        Ok(n)
    }


    fn peek(self) -> U8? {
        if self.i >= self.bytes.len() -> return None
        Val(self.bytes[self.i])
    }

    fn bump(&self) -> U8? {
        if self.i >= self.bytes.len() -> return None
        b :: self.bytes[self.i]
        self.i = self.i + 1
        Val(b)
    }
}

fn scalar_width(raw: [U8], i: Int) -> Int Never! {
    if i < 0 || i >= raw.len() -> return 1
    n :: raw[i]
    if n < 128 -> return 1
    need := 0
    if n >= 194 && n <= 223 {
        need = 1
    } else if n >= 224 && n <= 239 {
        need = 2
    } else if n >= 240 && n <= 244 {
        need = 3
    } else {
        return 1
    }
    if i + need >= raw.len() -> return 1
    loop k in 1..<(need + 1) {
        c :: raw[i + k]
        if c < 128 || c > 191 -> return 1
    }
    need + 1
}

// Program instructions, the Prelude engine's RegexInst set. A consuming
// instruction continues at `x`; Split prefers `x` over `y` (leftmost-first).
OP_LIT :: 0
OP_ANY :: 1
OP_CLASS :: 2
OP_SAVE :: 3
OP_SPLIT :: 4
OP_ASSERT_START :: 5
OP_ASSERT_END :: 6
OP_MATCH :: 7

struct Inst {
    op: Int
    s: String
    neg: Bool
    slot: Int
    x: Int
    y: Int
}

// A fragment's dangling exits: `inst` patches `x`, `-inst - 1` patches `y`.
struct Frag {
    start: Int
    outs: [Int]
}

struct Compiler {
    nodes: [Node]
    insts: [Inst]
}

impl Compiler {
    fn push(&self, op: Int, s: String, neg: Bool, slot: Int) -> Int Never! {
        &self.insts.push(Inst{op: op, s: s, neg: neg, slot: slot, x: -1, y: -1})
        self.insts.len() - 1
    }

    fn single(&self, op: Int, s: String, neg: Bool, slot: Int) -> Frag Never! {
        id :: &self.push(op, s, neg, slot)
        Frag{start: id, outs: [Int]{id}}
    }

    fn patch(&self, outs: [Int], target: Int) Never! {
        loop code in outs {
            if {
                code >= 0 -> {
                    old :: ~self.insts[code]
                    self.insts[code] = Inst{op: old.op, s: old.s, neg: old.neg, slot: old.slot, x: target, y: old.y}
                }
                else -> {
                    id :: -code - 1
                    old :: ~self.insts[id]
                    self.insts[id] = Inst{op: old.op, s: old.s, neg: old.neg, slot: old.slot, x: old.x, y: target}
                }
            }
        }
    }

    fn star(&self, node: Int) -> Frag Never! {
        atom :: &self.compile(node)
        split :: &self.push(OP_SPLIT, "", false, -1)
        &self.patch([Int]{split}, atom.start)
        &self.patch(atom.outs, split)
        Frag{start: split, outs: [Int]{-split - 1}}
    }

    fn optional(&self, node: Int) -> Frag Never! {
        atom :: &self.compile(node)
        split :: &self.push(OP_SPLIT, "", false, -1)
        &self.patch([Int]{split}, atom.start)
        outs := atom.outs
        &outs.push(-split - 1)
        Frag{start: split, outs: outs}
    }

    // Recursion here follows the pattern's nesting, never the text.
    fn compile(&self, node: Int) -> Frag Never! {
        n :: ~self.nodes[node]
        if n.kind == "lit" -> return &self.single(OP_LIT, n.s, false, -1)
        if n.kind == "dot" -> return &self.single(OP_ANY, "", false, -1)
        if n.kind == "class" -> return &self.single(OP_CLASS, n.s, n.neg, -1)
        if n.kind == "start" -> return &self.single(OP_ASSERT_START, "", false, -1)
        if n.kind == "end" -> return &self.single(OP_ASSERT_END, "", false, -1)
        if n.kind == "seq" {
            left :: &self.compile(n.left)
            right :: &self.compile(n.right)
            &self.patch(left.outs, right.start)
            return Frag{start: left.start, outs: right.outs}
        }
        if n.kind == "alt" {
            left :: &self.compile(n.left)
            right :: &self.compile(n.right)
            split :: &self.push(OP_SPLIT, "", false, -1)
            &self.patch([Int]{split}, left.start)
            &self.patch([Int]{-split - 1}, right.start)
            outs := left.outs
            loop code in right.outs -> &outs.push(code)
            return Frag{start: split, outs: outs}
        }
        if n.kind == "group" {
            open :: &self.push(OP_SAVE, "", false, n.a * 2)
            inner :: &self.compile(n.left)
            &self.patch([Int]{open}, inner.start)
            close :: &self.push(OP_SAVE, "", false, n.a * 2 + 1)
            &self.patch(inner.outs, close)
            return Frag{start: open, outs: [Int]{close}}
        }
        if n.kind == "rep" {
            // `{min,max}`: min required copies, then max - min optional
            // copies or one star, exactly the Prelude compile_range shape.
            frag := &self.single(OP_SAVE, "", false, -1)
            loop k in 0..<n.a {
                piece :: &self.compile(n.left)
                &self.patch(frag.outs, piece.start)
                frag = Frag{start: frag.start, outs: piece.outs}
            }
            if n.b < 0 {
                tail :: &self.star(n.left)
                &self.patch(frag.outs, tail.start)
                return Frag{start: frag.start, outs: tail.outs}
            }
            loop k in n.a..<n.b {
                tail :: &self.optional(n.left)
                &self.patch(frag.outs, tail.start)
                frag = Frag{start: frag.start, outs: tail.outs}
            }
            return frag
        }
        // "empty": a no-op save keeps the fragment shape uniform.
        &self.single(OP_SAVE, "", false, -1)
    }
}

struct Thread {
    pc: Int
    start: Int
    caps: Int
}

// Captures are a persistent list: each Save pushes one node that points at
// the thread's previous head, so forking a thread copies one Int.
struct CapNode {
    slot: Int
    pos: Int
    prev: Int
}

struct VMState {
    threads: [Thread]
    seen: [Int]
    epoch: Int
    min_start: Int
    matched: Thread
}

struct Run {
    start: Int
    end: Int
    caps: [Int]
}

fn no_thread() -> Thread Never! { Thread{pc: -1, start: -1, caps: -1} }

fn new_state(size: Int) -> VMState Never! {
    seen := [Int]{}
    loop k in 0..<size -> &seen.push(-1)
    VMState{threads: [Thread]{}, seen: seen, epoch: 0, min_start: -1, matched: no_thread()}
}

/// Follow every epsilon edge from `first` with an explicit stack, in
/// priority order, recording consuming and matching threads once per pc.
fn add_thread(re: Regex, text: [U8], state: &VMState, arena: &[CapNode], first: Thread, pos: Int, capture: Bool) Never! {
    stack := [Thread]{first}
    loop stack.len() > 0 {
        t :: &stack.pop() ?? break
        if state.seen[t.pc] == state.epoch -> next
        state.seen[t.pc] = state.epoch
        inst :: re.insts[t.pc]
        if inst.op == OP_SAVE {
            caps := t.caps
            if capture && inst.slot >= 0 {
                &arena.push(CapNode{slot: inst.slot, pos: pos, prev: t.caps})
                caps = arena.len() - 1
            }
            &stack.push(Thread{pc: inst.x, start: t.start, caps: caps})
            next
        }
        if inst.op == OP_SPLIT {
            &stack.push(Thread{pc: inst.y, start: t.start, caps: t.caps})
            &stack.push(Thread{pc: inst.x, start: t.start, caps: t.caps})
            next
        }
        if inst.op == OP_ASSERT_START {
            if pos == 0 || (re.flags.multiline && text[pos - 1] == (U8{10})) {
                &stack.push(Thread{pc: inst.x, start: t.start, caps: t.caps})
            }
            next
        }
        if inst.op == OP_ASSERT_END {
            if pos == text.len() -> &stack.push(Thread{pc: inst.x, start: t.start, caps: t.caps})
            next
        }
        if state.min_start < 0 || t.start < state.min_start -> state.min_start = t.start
        if inst.op == OP_MATCH && (state.matched.pc < 0 || t.start < state.matched.start) {
            state.matched = t
        }
        &state.threads.push(t)
    }
}

fn consumes(re: Regex, inst: Inst, text: [U8], pos: Int, width: Int) -> Bool Never! {
    if inst.op == OP_ANY -> return re.flags.dot_matches_newline || text[pos] != (U8{10})
    if inst.op == OP_CLASS {
        if text[pos] > (U8{127}) -> return inst.neg
        return class_hit(inst.s, text[pos], re.flags.ignore_case) != inst.neg
    }
    lit :: inst.s.bytes()
    if lit.len() != width -> return false
    loop k in 0..<width {
        if fold(text[pos + k], re.flags.ignore_case) != fold(lit[k], re.flags.ignore_case) -> return false
    }
    true
}

fn capture_slots(arena: [CapNode], found: Thread, end: Int, groups: Int, capture: Bool) -> [Int] Never! {
    slots := [Int]{}
    if !capture -> return slots
    loop k in 0..<((groups + 1) * 2) -> &slots.push(-1)
    head := found.caps
    loop head >= 0 {
        node :: arena[head]
        if node.slot < slots.len() && slots[node.slot] < 0 -> slots[node.slot] = node.pos
        head = node.prev
    }
    slots[0] = found.start
    slots[1] = end
    slots
}

fn next_search_pos(text: [U8], start: Int, end: Int) -> Int Never! {
    if end > start -> return end
    if end >= text.len() -> return text.len() + 1
    end + scalar_width(text, end)
}

/// The Prelude `regex_scan`: start threads enter one shared VM at each scalar
/// boundary until the leftmost match begins; that start's last match wins,
/// and the scan resumes at the non-overlap boundary. Collects at most
/// `limit` runs (all when `limit` < 0).
fn scan(re: Regex, text: [U8], from: Int, anchored: Bool, capture: Bool, stop_on_match: Bool, limit: Int) -> [Run] Never! {
    out := [Run]{}
    if from > text.len() -> return out
    size :: re.insts.len()
    current := new_state(size)
    arena := [CapNode]{}
    pos := from
    winner := -1
    has_last := false
    last := Run{start: 0, end: 0, caps: [Int]{}}
    single_start :: anchored || (re.anchored_start && !re.flags.multiline)
    loop {
        can_start :: !re.anchored_start || re.flags.multiline || pos == 0
        if winner < 0 && can_start && (!anchored || pos == from) {
            add_thread(re, text, &current, &arena, Thread{pc: re.start, start: pos, caps: -1}, pos, capture)
        }
        if stop_on_match && current.matched.pc >= 0 {
            &out.push(Run{start: current.matched.start, end: pos, caps: [Int]{}})
            return out
        }
        if current.threads.len() == 0 && single_start -> return out
        found :: current.matched
        if winner < 0 && found.pc >= 0 -> winner = found.start
        if winner >= 0 && found.pc >= 0 && found.start == winner {
            last = Run{start: found.start, end: pos, caps: capture_slots(arena, found, pos, re.groups, capture)}
            has_last = true
        }
        boundary := pos == text.len()
        if !boundary {
            width :: scalar_width(text, pos)
            next_pos :: pos + width
            following := new_state(size)
            loop t in current.threads {
                inst :: re.insts[t.pc]
                if inst.op > OP_CLASS -> next
                if !consumes(re, inst, text, pos, width) -> next
                add_thread(re, text, &following, &arena, Thread{pc: inst.x, start: t.start, caps: t.caps}, next_pos, capture)
            }
            current = following
            if stop_on_match && current.matched.pc >= 0 {
                &out.push(Run{start: current.matched.start, end: next_pos, caps: [Int]{}})
                return out
            }
            pos = next_pos
            boundary = winner >= 0 && current.min_start != winner
        }
        if boundary {
            if !has_last -> return out
            resume :: next_search_pos(text, last.start, last.end)
            &out.push(last)
            has_last = false
            last = Run{start: 0, end: 0, caps: [Int]{}}
            if limit >= 0 && out.len() >= limit -> return out
            if resume > text.len() -> return out
            current = new_state(size)
            winner = -1
            pos = resume
        }
    }
}

fn class_hit(spec: String, b: U8, fold_case: Bool) -> Bool Never! {
    ch :: fold(b, fold_case)
    raw :: spec.bytes()
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{92}) && i + 1 < raw.len() {
            escaped :: raw[i + 1]
            if escaped == (U8{100}) {
                if b >= (U8{48}) && b <= (U8{57}) -> return true
                i = i + 2
                next
            }
            if escaped == (U8{119}) {
                if ((b >= (U8{48}) && b <= (U8{57})) ||
                    (b >= (U8{65}) && b <= (U8{90})) ||
                    (b >= (U8{97}) && b <= (U8{122})) ||
                    b == (U8{95})) -> return true
                i = i + 2
                next
            }
            if escaped == (U8{115}) {
                if b == (U8{32}) || b == (U8{9}) || b == (U8{10}) ||
                    b == (U8{13}) || b == (U8{11}) || b == (U8{12}) -> return true
                i = i + 2
                next
            }
            // `\n`, `\r`, `\t` name their control bytes in a class too.
            literal := escaped
            if escaped == (U8{110}) -> literal = U8{10}
            if escaped == (U8{114}) -> literal = U8{13}
            if escaped == (U8{116}) -> literal = U8{9}
            if fold(literal, fold_case) == ch -> return true
            i = i + 2
            next
        }
        if i + 2 < raw.len() && raw[i + 1] == (U8{45}) {
            lo :: fold(raw[i], fold_case)
            hi :: fold(raw[i + 2], fold_case)
            if ch >= lo && ch <= hi -> return true
            i = i + 3
        } else {
            if fold(raw[i], fold_case) == ch -> return true
            i = i + 1
        }
    }
    false
}

fn fold(b: U8, on: Bool) -> Int Never! {
    n :: b
    if on && n >= 65 && n <= 90 -> return n + 32
    n
}

fn find_match(pattern: Regex, text: String) -> Match? {
    raw :: text.bytes()
    runs :: scan(pattern, raw, 0, false, true, false, 1)
    if runs.len() == 0 -> return None
    Val(make_match(raw, runs[0], pattern.groups))
}

fn make_match(raw: [U8], run: Run, group_count: Int) -> Match Never! {
    groups := [String]{}
    loop g in 1..<(group_count + 1) {
        start := -1
        end := -1
        if 2 * g + 1 < run.caps.len() {
            start = run.caps[2 * g]
            end = run.caps[2 * g + 1]
        }
        if {
            start >= 0 && end >= start -> &groups.push(slice(raw, start, end))
            else -> &groups.push("")
        }
    }
    Match{start: run.start, end: run.end, text: slice(raw, run.start, run.end), groups: groups}
}

fn slice(raw: [U8], start: Int, end: Int) -> String Never! {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i >= raw.len() -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}

fn is_group_name_char(b: U8) -> Bool Never! {
    n :: b
    n == 95 ||
        (n >= 48 && n <= 57) ||
        (n >= 65 && n <= 90) ||
        (n >= 97 && n <= 122)
}

fn is_meta(b: U8) -> Bool {
    n :: b
    n == 92 || n == 46 || n == 94 || n == 36 || n == 42 || n == 43 || n == 63 || n == 40 || n == 41 || n == 91 || n == 93 || n == 123 || n == 125 || n == 124
}
/// Python-style constructor spelling for a runtime pattern.
pub fn regex(pattern: String) -> Regex RegexError! { compile(pattern) }

/// Return the canonical source pattern represented by a compiled regex.
pub fn join(pattern: Regex) -> String Never! { pattern.pattern }
/// Python `re` spellings over the same compiled Regex carrier.
pub fn search(pattern: Regex, text: String) -> Match? Never! { match(pattern, text) }
pub fn findall(pattern: Regex, text: String) -> [String] Never! { find_all(pattern, text) }
pub fn fullmatch(pattern: Regex, text: String) -> Bool Never! { full_match(pattern, text) }
pub fn sub(pattern: Regex, text: String, replacement: String) -> String Never! {
    replace(pattern, text, replacement)
}
pub fn subn(pattern: Regex, text: String, replacement: String) -> (text: String, count: Int) Never! {
    ms :: matches(pattern, text)
    (text: replace(pattern, text, replacement), count: ms.len())
}
