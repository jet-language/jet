    match *REGEX_BYTE_BACKEND {
        .Avx2 -> regex_find_byte_avx2(haystack, needle, start)
        .Sse2 -> {
            if core.sys.target.selected_arch() == "x86" {
                regex_find_byte_sse2_x86(haystack, needle, start)
