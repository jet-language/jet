        .Word -> ch == '_' || ch.is_ascii_alphanumeric()
        .Space -> ch.is_whitespace()
        .UnicodeLetter -> ch.is_alphabetic()
        .UnicodeNumber -> ch.is_numeric()
        .UnicodeAlphabetic -> ch.is_alphabetic()
        .UnicodeWhitespace -> ch.is_whitespace()
    }
}
