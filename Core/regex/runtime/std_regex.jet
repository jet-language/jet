                    (.Literal(ch), .One) -> {
                        bytes := [U8; 4].filled(0)
                        run.extend(ch.encode_utf8(&bytes).as_bytes())
                    }
                    (.Literal(ch), _) -> {
                        regex_push_required_literal(&candidates, std.mem.take(&run))
                        regex_push_required_literal(&candidates, ch.to_string().into_bytes())
