    }
    if !flags.case_insensitive && !program.required_literals.is_empty()
        && !program.required_literals.iter().all(fn(literal) {
            regex_find_literal(text.as_bytes(), literal, start).is_some()
        }) -> return
    scratch := program.scratch.lock().unwrap()
    scratch.current.clear()
    scratch.next.clear()
    scratch.capture_arena.clear()
    prefilter :: if !anchored && !flags.case_insensitive { program.prefix.as_deref() } else { None }
    prefilter_pos := start
    pos := start
    winner_start: Usize? := None
    last_match: RegexRun? := None
    single_start :: anchored || (program.anchored_start && !flags.multiline)
    loop {
        if prefilter is Val(prefix) {
            if scratch.current.threads.is_empty() && winner_start.is_none() && last_match.is_none() {
                candidate :: regex_find_literal_boundary(text, prefix, prefilter_pos) ?? return
                pos = candidate
                prefilter_pos = regex_next_search_pos(text, candidate, candidate + prefix.len())
