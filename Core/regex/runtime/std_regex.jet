fn regex_class_item_matches(item: &RegexClassItem, ch: Char, case_insensitive: Bool) -> Bool {
    match item {
        .Char(c) -> {
            if case_insensitive { regex_simple_fold(c as U32) == regex_simple_fold(ch as U32) }
            else { c == ch }
        }
        .Range(a, b) -> {
            if case_insensitive {
                lc :: Char.from_u32(regex_simple_fold(ch as U32)).unwrap_or(ch)
                la :: Char.from_u32(regex_simple_fold(a as U32)).unwrap_or(a)
                lb :: Char.from_u32(regex_simple_fold(b as U32)).unwrap_or(b)
                la <= lc && lc <= lb
            } else { a <= ch && ch <= b }
        }
