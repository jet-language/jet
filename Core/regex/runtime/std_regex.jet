        bytes := [U8; 8].filled(0)
        bytes.copy_from_slice(haystack.slice(pos, pos + 8))
        different :: U64.from_ne_bytes(bytes) ^ repeated
        if different.wrapping_sub(LOW_BITS) & !different & HIGH_BITS != 0 {
            loop offset in Usize{0}..8 {
                if haystack[pos + offset] == needle -> return Val(pos + offset)
            }
        }
        pos += 8
    }
    rest :: haystack.get(pos..) ?? return None
