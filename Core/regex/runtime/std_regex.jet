// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Regex.rs:2122
// GATE #4565: kernel primitive
#Unsafe("native once initialization and CPUID feature detection select only instructions supported by the runtime CPU")
static REGEX_BYTE_BACKEND: LazyLock<RegexByteBackend> = LazyLock.new(fn() {
    arch :: core.sys.target.selected_arch()
    if arch == "x86_64" && std.arch.is_x86_feature_detected("avx2") -> return RegexByteBackend.Avx2
    if (arch == "x86" || arch == "x86_64") && std.arch.is_x86_feature_detected("sse2") -> return RegexByteBackend.Sse2
