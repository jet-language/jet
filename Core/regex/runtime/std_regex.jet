#Unsafe("scratch mutex guards the VM; release it before invoking callbacks and reacquire before reuse")
fn regex_scan(program: &RegexProgram, flags: &RegexFlags, groups: Usize, text: &String, start: Usize, anchored: Bool, capture: Bool, stop_on_match: Bool, on_match: fn(RegexRun) -> Bool) -> {
    if start > text.len() -> return
