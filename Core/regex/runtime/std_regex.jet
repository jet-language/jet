fn expand_regex_replacement(repl: &String, mat: &JetRegexMatch) -> String {
    out := String.with_capacity(repl.len())
    chars := repl.chars().peekable()
    loop {
        ch :: chars.next() ?? break
        if ch != '$' {
            out.push(ch)
            continue
        }
        match chars.peek().copied() {
            Val('$') -> {
                _ :: chars.next()
                out.push('$')
            }
            Val('{') -> {
                _ :: chars.next()
                name := String.new()
                loop {
                    c :: chars.next() ?? break
                    if c == '}' -> break
                    name.push(c)
                }
                if mat.name(&name) is Ok(value) -> out.push_str(&value)
            }
            Val(c) if c.is_ascii_digit() -> {
                idx := I64{0}
                valid := true
                loop chars.peek().is_some_and(fn(c) { c.is_ascii_digit() }) {
                    digit :: chars.next().unwrap() as I64 - '0' as I64
                    if idx.checked_mul(10).and_then(fn(n) { n.checked_add(digit) }) is Val(next) {
                        idx = next
                    } else { valid = false }
                }
                if valid {
                    if mat.group(idx) is Ok(value) -> out.push_str(&value)
                }
            }
            _ -> out.push('$')
        }
    }
    out
}

