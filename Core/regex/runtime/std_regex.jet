        can_start :: !program.anchored_start || flags.multiline || pos == 0
        if winner_start.is_none() && can_start && (!anchored || pos == start) {
            regex_add_thread(&scratch.current, program, flags,
                RegexThread{pc: program.start, start: pos, caps: None},
                pos, text, capture, &scratch.capture_arena)
        }
        if stop_on_match {
            if scratch.current.matched is Val(found) {
                run :: RegexRun{span: (found.start, pos), caps: None}
                drop(^scratch)
                _ :: on_match(^run)
                return
            }
        }
        if scratch.current.threads.is_empty() && single_start -> return
        found :: scratch.current.matched
        if winner_start.is_none() -> winner_start = found.map(fn(thread) { thread.start })
        if winner_start is Val(winner) {
            if found.filter(fn(thread) { thread.start == winner }) is Val(found) {
                caps :: if capture {
                    found.caps.map(fn(head) {
                        caps := regex_capture_slots(Val(head), &scratch.capture_arena, (groups + 1) * 2)
                        caps[0] = Val(found.start)
                        caps[1] = Val(pos)
                        caps
                    })
                } else { None }
                last_match = Val(RegexRun{span: (found.start, pos), caps: ^caps})
            }
        }
        if pos == text.len() {
            run :: last_match.take() ?? return
            resume :: regex_next_search_pos(text, run.span.0, run.span.1)
            drop(^scratch)
            if !on_match(^run) -> return
            if resume > text.len() -> return
            scratch = program.scratch.lock().unwrap()
            scratch.current.clear()
            winner_start = None
            last_match = None
            prefilter_pos = resume
            pos = resume
            continue
        }
        (ch, next_pos) :: regex_next_char(text, pos) ?? return
        {
            current :: &scratch.current
            next :: &scratch.next
            capture_arena :: &scratch.capture_arena
            next.clear()
            loop thread in &current.threads {
                match &program.insts[thread.pc] {
                    .Consume(matcher, Val(target)) -> {
                        if !regex_matcher_matches(matcher, ch, flags) -> continue
                        if capture {
                            regex_add_thread(next, program, flags,
                                RegexThread{pc: target, start: thread.start, caps: thread.caps},
                                next_pos, text, capture, capture_arena)
                        } else {
                            regex_add_thread(next, program, flags,
                                RegexThread{pc: target, start: thread.start, caps: None},
                                next_pos, text, capture, capture_arena)
                        }
                    }
                    _ -> continue
                }
            }
            std.mem.swap(current, next)
        }
        if stop_on_match {
            if scratch.current.matched is Val(found) {
                run :: RegexRun{span: (found.start, next_pos), caps: None}
                drop(^scratch)
                _ :: on_match(^run)
                return
            }
        }
        if winner_start is Val(winner) {
            if scratch.current.min_start != Val(winner) {
                run :: last_match.take() ?? return
                resume :: regex_next_search_pos(text, run.span.0, run.span.1)
                drop(^scratch)
                if !on_match(^run) -> return
                if resume > text.len() -> return
                scratch = program.scratch.lock().unwrap()
                scratch.current.clear()
                winner_start = None
                last_match = None
                prefilter_pos = resume
                pos = resume
                continue
            }
        }
        pos = next_pos
    }
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Regex.rs:1799
fn regex_add_thread(state: &RegexState, program: &RegexProgram, flags: &RegexFlags, thread: RegexThread, pos: Usize, text: &String, capture: Bool, capture_arena: &[RegexCaptureNode]) -> {
    state.stack.clear()
    state.stack.push(thread)
    loop {
        thread := state.stack.pop() ?? break
        if state.seen[thread.pc] == state.epoch -> continue
        state.seen[thread.pc] = state.epoch
        match &program.insts[thread.pc] {
            .Save(slot, Val(next)) -> {
                if capture && slot != Usize.MAX {
                    index :: capture_arena.len()
                    capture_arena.push(RegexCaptureNode{slot: slot, pos: pos, previous: thread.caps})
                    thread.caps = Val(index)
                }
                thread.pc = next
                state.stack.push(thread)
            }
            .Split(a, Val(b)) -> {
                right := thread
                right.pc = b
                state.stack.push(right)
                thread.pc = a
                state.stack.push(thread)
            }
            .AssertStart(Val(next)) -> {
                if pos == 0 || (flags.multiline && text.slice(0, pos).ends_with('\n')) {
                    thread.pc = next
                    state.stack.push(thread)
                }
            }
            .AssertEnd(Val(next)) -> {
                if pos == text.len() {
                    thread.pc = next
                    state.stack.push(thread)
                }
            }
            .Match -> {
                state.min_start = Val(state.min_start.map_or(thread.start, fn(start) { start.min(thread.start) }))
                if state.matched.map_or(true, fn(matched) { thread.start < matched.start }) {
                    state.matched = Val(thread)
                }
                state.threads.push(thread)
            }
            .Consume(_, _) -> {
                state.min_start = Val(state.min_start.map_or(thread.start, fn(start) { start.min(thread.start) }))
                state.threads.push(thread)
            }
            _ -> {}
        }
    }
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Regex.rs:1878
fn regex_prefix_literal(node: &RegexNode) -> [U8]? {
    match node {
        .Seq(pieces) -> {
            prefix := [U8]{}
            loop piece in pieces {
                required :: match piece.quant {
                    .One | .OneOrMore -> true
                    .Range{min, max: _} -> min >= 1
                    .ZeroOrMore | .ZeroOrOne -> false
