                if !required -> break
                match &piece.atom {
                    .Literal(ch) -> {
                        bytes := [U8; 4].filled(0)
                        prefix.extend_from_slice(ch.encode_utf8(&bytes).as_bytes())
                    }
                    .Group(_, inner) -> {
                        inner_prefix :: regex_prefix_literal(inner) ?? break
                        if inner_prefix.is_empty() -> break
                        prefix.extend_from_slice(&inner_prefix)
                    }
                    .Start -> {}
                    .Any | .Class(_) | .End -> break
                }
            }
            if !prefix.is_empty() { Val(^prefix) } else { None }
        }
        .Alt(arms) -> {
            arms := arms.iter()
            first :: arms.next() ?? return None
            prefix := regex_prefix_literal(first) ?? return None
            loop arm in arms {
                other :: regex_prefix_literal(arm) ?? return None
                common :: prefix.iter().zip(other.iter()).take_while(fn(pair) { pair.0 == pair.1 }).count()
                prefix.truncate(common)
                if prefix.is_empty() -> return None
            }
            Val(^prefix)
        }
    }
}

