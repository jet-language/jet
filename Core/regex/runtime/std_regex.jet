// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/Regex.rs:2149
fn regex_find_byte_scalar(haystack: View<U8>, needle: U8, start: Usize) -> Usize? {
    pos := start.min(haystack.len())
