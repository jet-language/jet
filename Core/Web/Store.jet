use reactive: core.reactive

C_MAX_STORE_NAME: 256
C_MAX_STORE_SUBSCRIBERS: 1000000


// core.web.store — typed state history, transactions, and patches.

#Error
WebStoreError: enum {
    NotFound
    Invalid
}

WebStore: struct<T> {
    name: String
    state: Signal<T>
    initial: T
    transactions: [WebStoreTransaction<T>]
    event_log: [WebStoreEvent]
    history: [T]
    cursor: Int
    generation: Int
    history_enabled: Bool
    history_limit: Int
    subs: Int

    value: fn(self) -> T Never! { value<T>(self) }
    get: fn(self) -> T Never! { value<T>(self) }
    facts_json: fn(self) -> String Never! { facts_json<T>(self) }
    event_json: fn(self) -> String Never! { event_json<T>(self) }
    history: fn(self) -> [WebStoreTransaction<T>] Never! { history<T>(self) }
    events: fn(self) -> [WebStoreEvent] Never! { events<T>(self) }
    signal: fn(self) -> Signal<T> Never! { signal<T>(self) }
    state_signal: fn(self) -> Signal<T> Never! { state_signal<T>(self) }
    set: fn(&self, value: T) -> WebStoreTransaction<T> Never! { set<T>(self, value) }
    transact: fn(&self, label: String, apply: fn() Never!) -> WebStoreTransaction<T> Never! { transaction<T>(self, label, [String]{}, apply) }
    back: fn(&self) -> WebStore<T>? Never! { back<T>(self) }
    forward: fn(&self) -> WebStore<T>? Never! { forward<T>(self) }
    jump: fn(&self, index: Int) -> WebStore<T>? Never! { jump<T>(self, index) }
}


WebStoreEvent: struct {
    kind: String
    cursor: Int
    generation: Int
    diff: String
    transaction: String
}

WebStoreTransaction: struct<T> {
    action: String
    after: T
    generation: Int
    changed_fields: [String]
    before: T
    diff: String
}

WebStorePatch: struct<T> {
    store: WebStore<T>
    backup: T
    transaction: WebStoreTransaction<T>
    active: Bool
}

WebStoreSubscription: struct {
    id: Int
    active: Bool
    selector: String
}

WebStoreInspection: struct {
    name: String
    cursor: Int
    generation: Int
    history_len: Int
}

Derived: struct<T> {
    value: T
    get: fn(self) -> T Never! { self.value }
}


new: fn<T>(name: String, value: T) -> WebStore<T> Never! {
    WebStore<T>{name: name, state: reactive.signal(value), initial: value, history: [T]{}, transactions: [WebStoreTransaction<T>]{}, event_log: [WebStoreEvent]{}, cursor: 0, generation: 0, history_enabled: true, history_limit: 1000, subs: 0}
}

with_history: fn<T>(name: String, value: T, limit: Int) -> WebStore<T> Never! {
    store := new<T>(name, value)
    n := limit
    if n < 1 -> n = 1
    if n > 1000 -> n = 1000
    store.history_limit = n
    store
}

value: fn<T>(store: WebStore<T>) -> T Never! { reactive.get(store.state) }
get: fn<T>(store: WebStore<T>) -> T Never! { value<T>(store) }
signal: fn<T>(store: WebStore<T>) -> Signal<T> Never! { store.state }
state_signal: fn<T>(store: WebStore<T>) -> Signal<T> Never! { signal<T>(store) }

transaction: fn<T>(store: &WebStore<T>, label: String, values: [String], apply: fn() Never!) -> WebStoreTransaction<T> Never! {
    before: value<T>(store.copy())
    apply()
    record<T>(store, label, values, before)
}

update: fn<T>(store: &WebStore<T>, label: String, values: [String], apply: fn() Never!) -> WebStoreTransaction<T> Never! {
    transaction<T>(store, label, values, apply)
}

batch: fn<T>(store: &WebStore<T>, label: String, values: [String], apply: fn() Never!) -> WebStoreTransaction<T> Never! {
    transaction<T>(store, label, values, apply)
}

set: fn<T>(store: &WebStore<T>, value: T) -> WebStoreTransaction<T> Never! {
    // The transaction of update/batch with label set, no changed field names,
    // and the root replaced.
    before: get<T>(store.copy())
    store.state = reactive.set(store.state, value)
    record<T>(store, "set", [String]{}, before)
}

set_state: fn<T>(store: &WebStore<T>, value: T) -> WebStoreTransaction<T> Never! { set<T>(store, value) }

optimistic: fn<T>(store: &WebStore<T>, label: String, values: [String], apply: fn() Never!) -> WebStorePatch<T> Never! {
    backup := value<T>(store.copy())
    apply()
    transaction: record<T>(store, label, values, backup)
    WebStorePatch<T>{store: store.copy(), backup: backup, transaction: transaction, active: true}
}

patch: fn<T>(store: &WebStore<T>, label: String, values: [String], apply: fn() Never!) -> WebStorePatch<T> Never! {
    optimistic<T>(store, label, values, apply)
}

patch_generation: fn<T>(patch: WebStorePatch<T>) -> Int Never! { patch.store.generation }
patch_active: fn<T>(patch: WebStorePatch<T>) -> Bool Never! { patch.active }

patch_transaction: fn<T>(patch: WebStorePatch<T>) -> WebStoreTransaction<T> Never! {
    patch.transaction
}

patch_commit: fn<T>(patch: &WebStorePatch<T>) -> WebStoreTransaction<T> Never! {
    patch.active = false
    patch_transaction<T>(patch)
}

patch_rollback: fn<T>(patch: &WebStorePatch<T>) -> WebStore<T>? Never! {
    if !patch.active -> return None
    store := patch.store
    before: value<T>(store)
    store.state = reactive.set(store.state, patch.backup)
    _: record<T>(store, "rollback", [String]{}, before)
    patch.active = false
    Val(store)
}

back: fn<T>(store: &WebStore<T>) -> WebStore<T>? Never! {
    cursor: store.cursor
    jump<T>(store, cursor - 1)
}
forward: fn<T>(store: &WebStore<T>) -> WebStore<T>? Never! {
    cursor: store.cursor
    jump<T>(store, cursor + 1)
}
restore: fn<T>(store: &WebStore<T>) -> WebStore<T>? Never! {
    cursor: store.cursor
    jump<T>(store, cursor)
}

jump: fn<T>(store: &WebStore<T>, index: Int) -> WebStore<T>? Never! {
    if index < 0 || index > store.history.len() -> return None
    store.state = reactive.set(store.state, if index == 0 -> store.initial else -> store.history[index - 1])
    store.cursor = index
    store.generation = store.generation + 1
    Val(store)
}

scrub: fn<T>(store: &WebStore<T>, index: Int) -> WebStore<T>? Never! { jump<T>(store, index) }

history: fn<T>(store: WebStore<T>) -> [WebStoreTransaction<T>] Never! {
    store.transactions
}

history_at: fn<T>(store: WebStore<T>, index: Int) -> WebStoreTransaction<T>? Never! {
    if index < 0 || index >= store.transactions.len() -> return None
    Val(store.transactions[index])
}

events: fn<T>(store: WebStore<T>) -> [WebStoreEvent] Never! {
    store.event_log
}

events_since: fn<T>(store: WebStore<T>, cursor: Int) -> [WebStoreEvent] Never! {
    out := [WebStoreEvent]{ }
    loop event in events<T>(store) {
        if event.cursor >= cursor -> out.push(event)
    }
    out
}

clear_history: fn<T>(store: &WebStore<T>) Never! {
    store.initial = value<T>(store.copy())
    store.history = [T]{}
    store.transactions = [WebStoreTransaction<T>]{}
    store.event_log = [WebStoreEvent]{}
    store.cursor = 0
    store.generation = store.generation + 1
}

set_history_limit: fn<T>(store: &WebStore<T>, limit: Int) Never! {
    n := limit
    if n < 1 -> n = 1
    if n > 1000 -> n = 1000
    if n == store.history_limit -> return
    store.history_limit = n
    trim<T>(store)
    store.generation = store.generation + 1
}

history_enabled: fn<T>(store: WebStore<T>) -> Bool Never! { store.history_enabled }
history_limit: fn<T>(store: WebStore<T>) -> Int Never! { store.history_limit }
cursor: fn<T>(store: WebStore<T>) -> Int Never! { store.cursor }
current_generation: fn<T>(store: WebStore<T>) -> Int Never! { store.generation }

subscribe: fn<T>(store: &WebStore<T>, callback: fn(T)) -> WebStoreSubscription Never! {
    if store.subs >= C_MAX_STORE_SUBSCRIBERS -> return WebStoreSubscription{id: store.subs, active: false, selector: ""}
    callback(value<T>(store.copy()))
    store.subs = store.subs + 1
    WebStoreSubscription{id: store.subs, active: true, selector: ""}
}

subscription_unsubscribe: fn(subscription: &WebStoreSubscription) Never! { subscription.active = false }
subscription_active: fn(subscription: WebStoreSubscription) -> Bool Never! { subscription.active }

subscribe_selector: fn<T, U, E>(store: &WebStore<T>, project: fn(T) -> U E!, callback: fn(U)) -> WebStoreSubscription E! {
    if store.subs >= C_MAX_STORE_SUBSCRIBERS -> return WebStoreSubscription{id: store.subs, active: false, selector: "derived"}
    callback(project(value<T>(store.copy())))
    store.subs = store.subs + 1
    WebStoreSubscription{id: store.subs, active: true, selector: "derived"}
}

derived: fn<T, U, E>(store: WebStore<T>, project: fn(T) -> U E!) -> Derived<U> E! { Derived<U>{value: project(value<T>(store))} }
selector: fn<T, U, E>(store: WebStore<T>, project: fn(T) -> U E!) -> Derived<U> E! { derived<T, U, E>(store, project) }

inspect: fn<T>(store: WebStore<T>) -> WebStoreInspection Never! {
    WebStoreInspection{name: store.name, cursor: store.cursor, generation: store.generation, history_len: store.history.len()}
}

// The summaries (Examples/features/expected/web/store_history.out) describe
// the store's value timeline: its base value and every retained transaction's
// value, of which the last `history_limit` are summarized. `history` is that
// window's length, `cursor` the current value's index in it, and `generation`
// counts the store's creation as generation 1.
facts_json: fn<T>(store: WebStore<T>) -> String Never! {
    timeline: store.history.len() + 1
    window: if timeline > store.history_limit -> store.history_limit else -> timeline
    "{{\"name\":\"{esc_json(store.name)}\",\"cursor\":{store.cursor - (timeline - window)},\"generation\":{store.generation + 1},\"history\":{window}}}"
}

event_json: fn<T>(store: WebStore<T>) -> String Never! {
    timeline: store.history.len() + 1
    window: if timeline > store.history_limit -> store.history_limit else -> timeline
    "{{\"name\":\"{esc_json(store.name)}\",\"cursor\":{store.cursor - (timeline - window)},\"generation\":{store.generation + 1}}}"
}

record: fn<T>(store: &WebStore<T>, action: String, fields: [String], before: T) -> WebStoreTransaction<T> Never! {
    store.generation = store.generation + 1
    changed := [String]{}
    loop field in fields -> changed.push("\"{esc_json(field)}\"")
    diff: "{{\"kind\":\"transaction\",\"generation\":{store.generation},\"action\":\"{esc_json(action)}\",\"changed_fields\":[{changed.join(",")}]}}"
    transaction: WebStoreTransaction<T>{action: action, after: value<T>(store.copy()), generation: store.generation, changed_fields: fields, before: before, diff: diff}
    if store.history_enabled {
        if store.cursor < store.history.len() {
            kept := [T]{}
            entries := [WebStoreTransaction<T>]{}
            loop i in 0..<store.cursor {
                kept.push(store.history[i])
                entries.push(store.transactions[i])
            }
            store.history = kept
            store.transactions = entries
        }
        store.history.push(value<T>(store.copy()))
        store.transactions.push(transaction)
        store.cursor = store.history.len()
        store.event_log.push(WebStoreEvent{kind: "commit", cursor: store.cursor, generation: store.generation, diff: diff, transaction: "{action}#{store.generation}"})
        trim<T>(store)
    }
    transaction
}

trim: fn<T>(store: &WebStore<T>) Never! {
    excess: store.history.len() - store.history_limit
    if excess > 0 {
        store.initial = store.history[excess - 1]
        store.history = tail<T>(store.history, store.history_limit)
        store.transactions = tail<WebStoreTransaction<T>>(store.transactions, store.history_limit)
        store.cursor = store.cursor - excess
        if store.cursor < 0 -> store.cursor = 0
    }
    if store.event_log.len() > store.history_limit -> store.event_log = tail<WebStoreEvent>(store.event_log, store.history_limit)
}

// `U`, not `T`: `trim` calls this with `WebStoreTransaction<T>`, and the
// solver reads a callee parameter spelled like the caller's as a cycle.
tail: fn<U>(values: [U], count: Int) -> [U] Never! {
    start := values.len() - count
    if start < 0 -> start = 0
    out := [U]{ }
    loop i in start..<values.len() -> out.push(values[i])
    out
}
esc_json: fn(text: String) -> String {
    raw: text.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        b: raw[i]
        escaped := ""
        if {
            b == (U8{34}) -> escaped = "\\\""
            b == (U8{92}) -> escaped = "\\\\"
            b == (U8{10}) -> escaped = "\\n"
            b == (U8{13}) -> escaped = "\\r"
            b == (U8{9}) -> escaped = "\\t"
            b < (U8{32}) || b == (U8{127}) -> escaped = control_escape(Int{b})
            b == (U8{194}) && i + 1 < raw.len() && raw[i + 1] >= (U8{128}) && raw[i + 1] <= (U8{159}) -> {
                escaped = control_escape(Int{raw[i + 1]})
                i += 1
            }
        }
        if escaped == "" -> out.push(b) else -> loop e in escaped.bytes() -> out.push(e)
        i += 1
    }
    String.from_bytes(out) ?? ""
}

control_escape: fn(value: Int) -> String Never! {
    digits: "0123456789abcdef".bytes()
    String.from_bytes([U8]{U8{92}, U8{117}, U8{48}, U8{48}, digits[value /% 16], digits[value % 16]}) ?? ""
}

#Test("store facts quoting preserves Unicode and escapes Rust control scalars") {
    controls: String.from_bytes([U8]{U8{206}, U8{187}, U8{194}, U8{133}, U8{0}, U8{127}, U8{10}}) ?? ""
    assert_eq(esc_json(controls), "λ\\u0085\\u0000\\u007f\\n")
}
