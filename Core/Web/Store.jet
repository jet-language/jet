use core as core
use core.reactive as reactive

C_MAX_STORE_NAME :: 256
C_MAX_STORE_SUBSCRIBERS :: 1000000


// core.web.store — typed state history, transactions, and patches.

#Error
enum WebStoreError {
    NotFound
    Invalid
}

struct WebStore<T> {
    name: String
    state: Signal<T>
    initial: T
    transactions: [WebStoreTransaction<T>]
    event_log: [WebStoreEvent]
    history: [T]
    cursor: Int
    generation: Int
    history_enabled: Bool
    history_limit: Int
    subs: Int

    fn value(self) -> T Never! { value<T>(self) }
    fn get(self) -> T Never! { value<T>(self) }
    fn facts_json(self) -> String Never! { facts_json<T>(self) }
    fn event_json(self) -> String Never! { event_json<T>(self) }
    fn history(self) -> [WebStoreTransaction<T>] Never! { history<T>(self) }
    fn events(self) -> [WebStoreEvent] Never! { events<T>(self) }
    fn signal(self) -> Signal<T> Never! { signal<T>(self) }
    fn state_signal(self) -> Signal<T> Never! { state_signal<T>(self) }
    fn set(&self, value: T) -> WebStoreTransaction<T> Never! { set<T>(&self, value) }
    fn transact(&self, label: String, apply: fn() Never!) -> WebStoreTransaction<T> Never! { transaction<T>(&self, label, [String]{}, apply) }
    fn back(&self) -> WebStore<T>? Never! { back<T>(&self) }
    fn forward(&self) -> WebStore<T>? Never! { forward<T>(&self) }
    fn jump(&self, index: Int) -> WebStore<T>? Never! { jump<T>(&self, index) }
}


struct WebStoreEvent {
    kind: String
    cursor: Int
    generation: Int
    diff: String
    transaction: String
}

struct WebStoreTransaction<T> {
    action: String
    after: T
    generation: Int
    changed_fields: [String]
    before: T
    diff: String
}

struct WebStorePatch<T> {
    store: WebStore<T>
    backup: T
    transaction: WebStoreTransaction<T>
    active: Bool
}

struct WebStoreSubscription {
    id: Int
    active: Bool
    selector: String
}

struct WebStoreInspection {
    name: String
    cursor: Int
    generation: Int
    history_len: Int
}

struct Derived<T> {
    value: T
    fn get(self) -> T Never! { self.value }
}


fn new<T>(name: String, value: T) -> WebStore<T> Never! {
    WebStore<T>{name: name, state: reactive.signal(value), initial: value, history: [T]{}, transactions: [WebStoreTransaction<T>]{}, event_log: [WebStoreEvent]{}, cursor: 0, generation: 0, history_enabled: true, history_limit: 1000, subs: 0}
}

fn with_history<T>(name: String, value: T, limit: Int) -> WebStore<T> Never! {
    store := new<T>(name, value)
    n := limit
    if n < 1 -> n = 1
    if n > 1000 -> n = 1000
    store.history_limit = n
    store
}

fn value<T>(store: WebStore<T>) -> T Never! { reactive.get(store.state) }
fn get<T>(store: WebStore<T>) -> T Never! { value<T>(store) }
fn signal<T>(store: WebStore<T>) -> Signal<T> Never! { store.state }
fn state_signal<T>(store: WebStore<T>) -> Signal<T> Never! { signal<T>(store) }

fn transaction<T>(store: &WebStore<T>, label: String, values: [String], apply: fn() Never!) -> WebStoreTransaction<T> Never! {
    before :: value<T>(store.copy())
    apply()
    record<T>(&store, label, values, before)
}

fn update<T>(store: &WebStore<T>, label: String, values: [String], apply: fn() Never!) -> WebStoreTransaction<T> Never! {
    transaction<T>(&store, label, values, apply)
}

fn batch<T>(store: &WebStore<T>, label: String, values: [String], apply: fn() Never!) -> WebStoreTransaction<T> Never! {
    transaction<T>(&store, label, values, apply)
}

fn set<T>(store: &WebStore<T>, value: T) -> WebStoreTransaction<T> Never! {
    // WebStore.rs:594-595: one reactive transaction, label set, no changed
    // field names, root replacement; the runtime gate defers reentrant events.
    core.web.store.__transact(store, "set", [String]{}, (state) -> state = value)
}

fn set_state<T>(store: &WebStore<T>, value: T) -> WebStoreTransaction<T> Never! { set<T>(&store, value) }

fn optimistic<T>(store: &WebStore<T>, label: String, values: [String], apply: fn() Never!) -> WebStorePatch<T> Never! {
    backup := value<T>(store.copy())
    apply()
    transaction :: record<T>(&store, label, values, backup)
    WebStorePatch<T>{store: store.copy(), backup: backup, transaction: transaction, active: true}
}

fn patch<T>(store: &WebStore<T>, label: String, values: [String], apply: fn() Never!) -> WebStorePatch<T> Never! {
    optimistic<T>(&store, label, values, apply)
}

fn patch_generation<T>(patch: WebStorePatch<T>) -> Int Never! { patch.store.generation }
fn patch_active<T>(patch: WebStorePatch<T>) -> Bool Never! { patch.active }

fn patch_transaction<T>(patch: WebStorePatch<T>) -> WebStoreTransaction<T> Never! {
    patch.transaction
}

fn patch_commit<T>(patch: &WebStorePatch<T>) -> WebStoreTransaction<T> Never! {
    patch.active = false
    patch_transaction<T>(patch)
}

fn patch_rollback<T>(patch: &WebStorePatch<T>) -> WebStore<T>? Never! {
    if !patch.active -> return None
    store := patch.store
    before :: value<T>(store)
    store.state = reactive.set(store.state, patch.backup)
    _ :: record<T>(&store, "rollback", [String]{}, before)
    patch.active = false
    Val(store)
}

fn back<T>(store: &WebStore<T>) -> WebStore<T>? Never! {
    cursor :: store.cursor
    jump<T>(&store, cursor - 1)
}
fn forward<T>(store: &WebStore<T>) -> WebStore<T>? Never! {
    cursor :: store.cursor
    jump<T>(&store, cursor + 1)
}
fn restore<T>(store: &WebStore<T>) -> WebStore<T>? Never! {
    cursor :: store.cursor
    jump<T>(&store, cursor)
}

fn jump<T>(store: &WebStore<T>, index: Int) -> WebStore<T>? Never! {
    if index < 0 || index > store.history.len() -> return None
    store.state = reactive.set(store.state, if index == 0 -> store.initial else -> store.history[index - 1])
    store.cursor = index
    store.generation = store.generation + 1
    Val(store)
}

fn scrub<T>(store: &WebStore<T>, index: Int) -> WebStore<T>? Never! { jump<T>(&store, index) }

fn history<T>(store: WebStore<T>) -> [WebStoreTransaction<T>] Never! {
    store.transactions
}

fn history_at<T>(store: WebStore<T>, index: Int) -> WebStoreTransaction<T>? Never! {
    if index < 0 || index >= store.transactions.len() -> return None
    Val(store.transactions[index])
}

fn events<T>(store: WebStore<T>) -> [WebStoreEvent] Never! {
    store.event_log
}

fn events_since<T>(store: WebStore<T>, cursor: Int) -> [WebStoreEvent] Never! {
    out := [WebStoreEvent]{ }
    loop event in events<T>(store) {
        if event.cursor >= cursor -> &out.push(event)
    }
    out
}

fn clear_history<T>(store: &WebStore<T>) Never! {
    store.initial = value<T>(store.copy())
    store.history = [T]{}
    store.transactions = [WebStoreTransaction<T>]{}
    store.event_log = [WebStoreEvent]{}
    store.cursor = 0
    store.generation = store.generation + 1
}

fn set_history_limit<T>(store: &WebStore<T>, limit: Int) Never! {
    n := limit
    if n < 1 -> n = 1
    if n > 1000 -> n = 1000
    if n == store.history_limit -> return
    store.history_limit = n
    trim<T>(&store)
    store.generation = store.generation + 1
}

fn history_enabled<T>(store: WebStore<T>) -> Bool Never! { store.history_enabled }
fn history_limit<T>(store: WebStore<T>) -> Int Never! { store.history_limit }
fn cursor<T>(store: WebStore<T>) -> Int Never! { store.cursor }
fn current_generation<T>(store: WebStore<T>) -> Int Never! { store.generation }

fn subscribe<T>(store: &WebStore<T>, callback: fn(T)) -> WebStoreSubscription Never! {
    if store.subs >= C_MAX_STORE_SUBSCRIBERS -> return WebStoreSubscription{id: store.subs, active: false, selector: ""}
    callback(value<T>(store.copy()))
    store.subs = store.subs + 1
    WebStoreSubscription{id: store.subs, active: true, selector: ""}
}

fn subscription_unsubscribe(subscription: &WebStoreSubscription) Never! { subscription.active = false }
fn subscription_active(subscription: WebStoreSubscription) -> Bool Never! { subscription.active }

fn subscribe_selector<T, U, E>(store: &WebStore<T>, project: fn(T) -> U E!, callback: fn(U)) -> WebStoreSubscription E! {
    if store.subs >= C_MAX_STORE_SUBSCRIBERS -> return WebStoreSubscription{id: store.subs, active: false, selector: "derived"}
    callback(project(value<T>(store.copy())))
    store.subs = store.subs + 1
    WebStoreSubscription{id: store.subs, active: true, selector: "derived"}
}

fn derived<T, U, E>(store: WebStore<T>, project: fn(T) -> U E!) -> Derived<U> E! { Derived<U>{value: project(value<T>(store))} }
fn selector<T, U, E>(store: WebStore<T>, project: fn(T) -> U E!) -> Derived<U> E! { derived<T, U, E>(store, project) }

fn inspect<T>(store: WebStore<T>) -> WebStoreInspection Never! {
    WebStoreInspection{name: store.name, cursor: store.cursor, generation: store.generation, history_len: store.history.len()}
}

fn facts_json<T>(store: WebStore<T>) -> String Never! {
    // WebStore.rs:917-929: guard the ledger before reading all six facts.
    facts :: core.web.store.__facts_snapshot(store)
    "{{\"name\":\"{esc_json(store.name)}\",\"generation\":{facts.generation},\"cursor\":{facts.cursor},\"history_length\":{facts.history_length},\"history_limit\":{facts.history_limit},\"event_length\":{facts.event_length},\"history_enabled\":{facts.history_enabled}}}"
}

fn event_json<T>(store: WebStore<T>) -> String Never! {
    if store.event_log.len() == 0 -> return "{{\"name\":\"{esc_json(store.name)}\",\"transaction\":\"\",\"diff\":\"\",\"cursor\":{store.cursor}}}"
    event :: store.event_log[store.event_log.len() - 1]
    "{{\"name\":\"{esc_json(store.name)}\",\"transaction\":\"{esc_json(event.transaction)}\",\"diff\":\"{esc_json(event.diff)}\",\"cursor\":{store.cursor}}}"
}

fn record<T>(store: &WebStore<T>, action: String, fields: [String], before: T) -> WebStoreTransaction<T> Never! {
    store.generation = store.generation + 1
    changed := [String]{}
    loop field in fields -> &changed.push("\"{esc_json(field)}\"")
    diff :: "{{\"kind\":\"transaction\",\"generation\":{store.generation},\"action\":\"{esc_json(action)}\",\"changed_fields\":[{changed.join(",")}]}}"
    transaction :: WebStoreTransaction<T>{action: action, after: value<T>(store.copy()), generation: store.generation, changed_fields: fields, before: before, diff: diff}
    if store.history_enabled {
        if store.cursor < store.history.len() {
            kept := [T]{}
            entries := [WebStoreTransaction<T>]{}
            loop i in 0..<store.cursor {
                &kept.push(store.history[i])
                &entries.push(store.transactions[i])
            }
            store.history = kept
            store.transactions = entries
        }
        &store.history.push(value<T>(store.copy()))
        &store.transactions.push(transaction)
        store.cursor = store.history.len()
        &store.event_log.push(WebStoreEvent{kind: "commit", cursor: store.cursor, generation: store.generation, diff: diff, transaction: "{action}#{store.generation}"})
        trim<T>(&store)
    }
    transaction
}

fn trim<T>(store: &WebStore<T>) Never! {
    excess :: store.history.len() - store.history_limit
    if excess > 0 {
        store.initial = store.history[excess - 1]
        store.history = tail<T>(store.history, store.history_limit)
        store.transactions = tail<WebStoreTransaction<T>>(store.transactions, store.history_limit)
        store.cursor = store.cursor - excess
        if store.cursor < 0 -> store.cursor = 0
    }
    if store.event_log.len() > store.history_limit -> store.event_log = tail<WebStoreEvent>(store.event_log, store.history_limit)
}

fn tail<T>(values: [T], count: Int) -> [T] Never! {
    start := values.len() - count
    if start < 0 -> start = 0
    out := [T]{ }
    loop i in start..<values.len() -> &out.push(values[i])
    out
}
fn esc_json(text: String) -> String {
    raw :: text.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        b :: raw[i]
        escaped := ""
        if {
            b == (U8{34}) -> escaped = "\\\""
            b == (U8{92}) -> escaped = "\\\\"
            b == (U8{10}) -> escaped = "\\n"
            b == (U8{13}) -> escaped = "\\r"
            b == (U8{9}) -> escaped = "\\t"
            b < (U8{32}) || b == (U8{127}) -> escaped = control_escape(Int{b})
            b == (U8{194}) && i + 1 < raw.len() && raw[i + 1] >= (U8{128}) && raw[i + 1] <= (U8{159}) -> {
                escaped = control_escape(Int{raw[i + 1]})
                i += 1
            }
        }
        if escaped == "" -> &out.push(b) else -> loop e in escaped.bytes() -> &out.push(e)
        i += 1
    }
    String.from_bytes(out) ?? ""
}

fn control_escape(value: Int) -> String Never! {
    digits :: "0123456789abcdef".bytes()
    String.from_bytes([U8]{U8{92}, U8{117}, U8{48}, U8{48}, digits[value /% 16], digits[value % 16]}) ?? ""
}

#Test("store facts quoting preserves Unicode and escapes Rust control scalars") {
    controls :: String.from_bytes([U8]{U8{206}, U8{187}, U8{194}, U8{133}, U8{0}, U8{127}, U8{10}}) ?? ""
    assert_eq(esc_json(controls), "λ\\u0085\\u0000\\u007f\\n")
}
