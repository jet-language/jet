// core.web.query — typed live-query state and mutation transitions.
C_MAX_QUERY_KEY: 256

C_MAX_QUERY_PAYLOAD: 1048576

C_MAX_QUERY_SUBSCRIBERS: 1000000


#Error
WebQueryError: enum {
    Offline
    Conflict
    Invalid
}

WebQueryStatus: enum {
    Pending
    Fresh
    Stale
    Fetching
    Error
    Offline
}

WebMutationStatus: enum {
    Idle
    Pending
    Success
    Error
    Settled
}

WebQueryNetworkMode: enum {
    Online
    Always
    OfflineFirst
}

WebQueryState: struct {
    status: WebQueryStatus
    generation: Int
    online: Bool
}

WebQuery: struct {
    key: String
    data: String
    status: WebQueryStatus
    error: String
    generation: Int
    mode: WebQueryNetworkMode
    online: Bool
    subscribers: Int

    get: fn(self) -> String Never! { self.data }
    show: fn(self) -> String Never! { "{self.key}={self.data}" }
    state: fn(self) -> WebQueryState Never! { state(self) }
    state_signal: fn(self) -> String Never! { state_signal(self) }
    mutation_state: fn(self) -> WebMutationState Never! { mutation_state(self) }
    mutation_signal: fn(self) -> String Never! { mutation_signal(self) }
    facts: fn(self) -> String Never! { facts(self) }
    invalidate: fn(&self) -> Int Never! { invalidate(self) }
    refresh: fn(&self) WebQueryError! { refresh(self) }
    cancel: fn(&self) -> Bool Never! { cancel(self) }
    queue: fn(&self, data: String) -> Int WebQueryError! { queue(self, data) }
    retry: fn(&self, replay: fn(String)) -> Int WebQueryError! { retry(self, replay) }
    set_online: fn(&self, online: Bool) Never! { set_online(self, online) }
    set_mode: fn(&self, mode: WebQueryNetworkMode) Never! { set_mode(self, mode) }
    mutate: fn<E>(&self, key: String, expected: String?, mutation: fn(String) -> String E!) -> WebMutationState E! { mutate<E>(self, key, expected, mutation) }
    mutate_with_invalidations: fn<E>(&self, key: String, expected: String?, invalidations: [String], mutation: fn(String) -> String E!) -> WebMutationState E! { mutate_with_invalidations<E>(self, key, expected, invalidations, mutation) }
}

WebMutationState: struct {
    status: WebMutationStatus
    data: String
    error: String
}
WebQuerySeed: struct {
    data: String
    generation: Int
    subscribers: Int
}

new: fn(key: String, initial: WebQuerySeed) -> WebQuery Never! {
    generation := initial.generation
    if generation < 1 -> generation = 1
    subscribers := initial.subscribers
    if subscribers < 0 -> subscribers = 0
    if subscribers > C_MAX_QUERY_SUBSCRIBERS -> subscribers = C_MAX_QUERY_SUBSCRIBERS
    status := WebQueryStatus.Fresh
    error := ""
    if !valid_key(key) || initial.data.len() > C_MAX_QUERY_PAYLOAD {
        status = WebQueryStatus.Error
        error = "invalid"
    }
    WebQuery{key: key.copy(), data: initial.data, status: status, error: error, generation: generation, mode: WebQueryNetworkMode.Online, online: true, subscribers: subscribers}
}

live: fn<E>(key: String, data: String, url: String, loader: fn() -> String E!) -> WebQuery E! {
    loaded := data
    if url.len() > 0 -> loaded = loader()
    status := WebQueryStatus.Fresh
    error := ""
    if !valid_key(key) || loaded.len() > C_MAX_QUERY_PAYLOAD {
        status = WebQueryStatus.Error
        error = "invalid"
    }
    WebQuery{key: key.copy(), data: loaded, status: status, error: error, generation: 1, mode: WebQueryNetworkMode.Online, online: true, subscribers: 0}
}

get: fn(q: WebQuery) -> String Never! { q.data }
show: fn(q: WebQuery) -> String Never! { "{q.key}={q.data}" }

state: fn(q: WebQuery) -> WebQueryState Never! {
    WebQueryState{status: q.status, generation: q.generation, online: q.online}
}

state_signal: fn(q: WebQuery) -> String Never! { "{q.key}:{status_name(q.status)}:{q.generation}" }

mutation_state: fn(q: WebQuery) -> WebMutationState Never! {
    status := WebMutationStatus.Idle
    if q.status == WebQueryStatus.Pending || q.status == WebQueryStatus.Fetching -> status = WebMutationStatus.Pending
    if q.status == WebQueryStatus.Error || q.status == WebQueryStatus.Offline -> status = WebMutationStatus.Error
    if q.status == WebQueryStatus.Fresh -> status = WebMutationStatus.Success
    WebMutationState{status: status, data: q.data, error: q.error}
}

mutation_signal: fn(q: WebQuery) -> String Never! { "{status_name(q.status)}:{q.generation}" }

subscribe: fn(key: String) -> WebQuery Never! {
    status := WebQueryStatus.Stale
    error := ""
    if !valid_key(key) {
        status = WebQueryStatus.Error
        error = "invalid"
    }
    WebQuery{key: key.copy(), data: "", status: status, error: error, generation: 1, mode: WebQueryNetworkMode.Online, online: true, subscribers: 1}
}

invalidate: fn(q: &WebQuery) -> Int Never! {
    q.status = WebQueryStatus.Stale
    q.generation = q.generation + 1
    q.generation
}

refresh: fn(q: &WebQuery) WebQueryError! {
    if q.status == WebQueryStatus.Fetching || q.status == WebQueryStatus.Pending -> return Err(WebQueryError.Invalid)
    if !q.online && q.mode != WebQueryNetworkMode.Always {
        q.status = WebQueryStatus.Offline
        q.error = "offline"
        q.generation = q.generation + 1
        return Err(WebQueryError.Offline)
    }
    q.status = WebQueryStatus.Fetching
    q.error = ""
    q.generation = q.generation + 1
    return Ok()
}

cancel: fn(q: &WebQuery) -> Bool Never! {
    if q.status == WebQueryStatus.Fetching || q.status == WebQueryStatus.Pending {
        q.status = WebQueryStatus.Stale
        q.error = "cancelled"
        q.generation = q.generation + 1
        return true
    }
    false
}

queue: fn(q: &WebQuery, data: String) -> Int WebQueryError! {
    if data.len() > C_MAX_QUERY_PAYLOAD -> return Err(WebQueryError.Invalid)
    if q.status == WebQueryStatus.Fetching || q.status == WebQueryStatus.Pending -> return Err(WebQueryError.Invalid)
    q.data = data.copy()
    q.status = WebQueryStatus.Pending
    q.error = ""
    q.generation = q.generation + 1
    q.generation
}

retry: fn(q: &WebQuery, replay: fn(String)) -> Int WebQueryError! {
    if q.status == WebQueryStatus.Fetching || q.status == WebQueryStatus.Pending -> return Err(WebQueryError.Invalid)
    if !q.online && q.mode != WebQueryNetworkMode.Always -> return Err(WebQueryError.Offline)
    q.status = WebQueryStatus.Fetching
    q.error = ""
    replay(q.key.copy())
    q.generation = q.generation + 1
    q.generation
}

mutate: fn<E>(q: &WebQuery, key: String, expected: String?, mutation: fn(String) -> String E!) -> WebMutationState E! {
    if !valid_key(key) || key != q.key {
        q.status = WebQueryStatus.Error
        q.error = "key"
        q.generation = q.generation + 1
        return WebMutationState{status: WebMutationStatus.Error, data: q.data, error: q.error}
    }
    if expected != None {
        actual: expected
        if actual.len() > C_MAX_QUERY_PAYLOAD || actual != q.data {
            q.status = WebQueryStatus.Error
            q.error = "conflict"
            q.generation = q.generation + 1
            return WebMutationState{status: WebMutationStatus.Error, data: q.data, error: q.error}
        }
    }
    if !q.online && q.mode != WebQueryNetworkMode.Always && q.mode != WebQueryNetworkMode.OfflineFirst {
        q.status = WebQueryStatus.Offline
        q.error = "offline"
        q.generation = q.generation + 1
        return WebMutationState{status: WebMutationStatus.Error, data: q.data, error: q.error}
    }
    q.status = WebQueryStatus.Pending
    q.error = ""
    next := mutation(q.data)
    if next.len() > C_MAX_QUERY_PAYLOAD {
        q.status = WebQueryStatus.Error
        q.error = "payload"
        q.generation = q.generation + 1
        return WebMutationState{status: WebMutationStatus.Error, data: q.data, error: q.error}
    }
    q.data = next.copy()
    q.generation = q.generation + 1
    if !q.online && q.mode == WebQueryNetworkMode.OfflineFirst {
        q.error = "offline"
        return WebMutationState{status: WebMutationStatus.Pending, data: q.data, error: q.error}
    }
    q.status = WebQueryStatus.Fresh
    WebMutationState{status: WebMutationStatus.Success, data: q.data, error: ""}
}

mutate_with_invalidations: fn<E>(q: &WebQuery, key: String, expected: String?, invalidations: [String], mutation: fn(String) -> String E!) -> WebMutationState E! {
    if invalidations.len() > C_MAX_QUERY_SUBSCRIBERS {
        q.status = WebQueryStatus.Error
        q.error = "invalidations"
        q.generation = q.generation + 1
        return WebMutationState{status: WebMutationStatus.Error, data: q.data, error: q.error}
    }
    loop target in invalidations {
        if !valid_key(target) {
            q.status = WebQueryStatus.Error
            q.error = "invalidations"
            q.generation = q.generation + 1
            return WebMutationState{status: WebMutationStatus.Error, data: q.data, error: q.error}
        }
    }
    result: mutate<E>(q, key, expected, mutation)
    if result.status == WebMutationStatus.Success && invalidations.len() > 0 {
        return WebMutationState{status: WebMutationStatus.Settled, data: result.data, error: ""}
    }
    result
}

set_online: fn(q: &WebQuery, online: Bool) Never! {
    if q.online == online -> return
    q.online = online
    q.generation = q.generation + 1
    if !online {
        q.status = WebQueryStatus.Offline
        q.error = "offline"
    } else if q.status == WebQueryStatus.Offline {
        q.status = WebQueryStatus.Stale
        q.error = ""
    }
}

set_mode: fn(q: &WebQuery, mode: WebQueryNetworkMode) Never! {
    if q.mode == mode -> return
    q.mode = mode
    q.generation = q.generation + 1
    if q.online || mode != WebQueryNetworkMode.Always -> return
    if q.status == WebQueryStatus.Offline {
        q.status = WebQueryStatus.Stale
        q.error = ""
    }
}


facts: fn(q: WebQuery) -> String Never! {
    "{{\"key\":\"{esc_json(q.key)}\",\"status\":\"{status_name(q.status)}\",\"generation\":{q.generation},\"online\":{bool_json(q.online)},\"subscribers\":{q.subscribers}}}"
}

valid_key: fn(key: String) -> Bool {
    if key.len() == 0 || key.len() > C_MAX_QUERY_KEY -> return false
    loop b in key.bytes() {
        n: Int.from_u8(b)
        if n < 33 || n == 127 -> return false
    }
    true
}

esc_json: fn(text: String) -> String {
    out := [U8]{}
    hex: "0123456789abcdef".bytes()
    loop b in text.bytes() {
        n: Int.from_u8(b)
        if n == 34 || n == 92 {
            out.push(U8{92})
            out.push(b)
        } else if n == 8 {
            out.push(U8{92})
            out.push(U8{98})
        } else if n == 10 {
            out.push(U8{92})
            out.push(U8{110})
        } else if n == 12 {
            out.push(U8{92})
            out.push(U8{102})
        } else if n == 13 {
            out.push(U8{92})
            out.push(U8{114})
        } else if n == 9 {
            out.push(U8{92})
            out.push(U8{116})
        } else if n < 32 || n == 127 {
            out.push(U8{92})
            out.push(U8{117})
            out.push(U8{48})
            out.push(U8{48})
            out.push(hex[n /% 16])
            out.push(hex[n %% 16])
        } else {
            out.push(b)
        }
    }
    String.from_bytes(out) ?? ""
}
status_name: fn(s: WebQueryStatus) -> String {
    if s == {
        WebQueryStatus.Pending -> "pending"
        WebQueryStatus.Fresh -> "fresh"
        WebQueryStatus.Stale -> "stale"
        WebQueryStatus.Fetching -> "fetching"
        WebQueryStatus.Error -> "error"
        else -> "offline"
    }
}

bool_json: fn(b: Bool) -> String {
    if b -> return "true"
    "false"
}
