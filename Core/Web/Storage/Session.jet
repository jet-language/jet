use {
    core: core
    local_storage: core.web.storage.local
}

// The shipped process-default store is separate from local storage. Web is
// registered-unsupported, not a tab store.
SessionStorage: struct {
    entries: [String:String]
}

init_session_storage: fn() -> Shared<SessionStorage> Never! {
    Shared{SessionStorage{entries: [String:String]{}}}
}

get: fn(key: String) -[Browser]> String? Never! {
    state: core.mem.__process_shared(init_session_storage)
    guard: state.guard_read()
    guard.value.entries.get(key)
}

set: fn(key: String, value: String) Never! -[Browser]> {
    state: core.mem.__process_shared(init_session_storage)
    guard := state.guard_edit()
    _: guard.value.entries.add(key.copy(), value.copy())
}

remove: fn(key: String) Never! -[Browser]> {
    state: core.mem.__process_shared(init_session_storage)
    guard := state.guard_edit()
    _: guard.value.entries.remove(key)
}

clear: fn() Never! -[Browser]> {
    state: core.mem.__process_shared(init_session_storage)
    guard := state.guard_edit()
    guard.value.entries.clear()
}

get_or: fn(key: String, fallback: String) -> String Never! { get(key) ?? fallback }

has: fn(key: String) -> Bool Never! { get(key) != None }

test_helper_effects: fn() Never! -[Browser]> {
    key: "Core.web.storage.session.helper.effects"
    remove(key)
    assert_eq(get_or(key, "fallback"), "fallback")
    assert_eq(has(key), false)
}

#Test("session helper calls fit the shipped Browser effect row") {
    test_helper_effects()
}

#Test("session storage preserves miss, replacement and removal") {
    key: "Core.web.storage.session.contract"
    remove(key)
    assert_eq(get(key), None)
    set(key, "first")
    set(key, "second")
    assert_eq(get(key), Val("second"))
    remove(key)
    assert_eq(get(key), None)
}

#Test("session clear removes all session entries without clearing local") {
    key: "Core.web.storage.clear"
    local_storage.set(key, "local")
    set(key, "session")
    set("", "empty key")
    clear()
    assert_eq(get(key), None)
    assert_eq(get(""), None)
    assert_eq(local_storage.get(key), Val("local"))
    local_storage.remove(key)
}
