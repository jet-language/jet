use core: core

// The shipped process-default store survives evaluator runs and reloads. Web is
// registered-unsupported, not an origin store.
LocalStorage: struct {
    entries: [String:String]
}

init_local_storage: fn() -> Shared<LocalStorage> Never! {
    shared LocalStorage{entries: [String:String]{}}
}

get: fn(key: String) -[Browser]> String? Never! {
    state: core.mem.__process_shared(init_local_storage)
    guard: state.guard_read()
    guard.value.entries.get(key)
}

set: fn(key: String, value: String) Never! -[Browser]> {
    state: core.mem.__process_shared(init_local_storage)
    guard := state.guard_edit()
    _: guard.value.entries.add(key, value)
}

remove: fn(key: String) Never! -[Browser]> {
    state: core.mem.__process_shared(init_local_storage)
    guard := state.guard_edit()
    _: guard.value.entries.remove(key)
}

clear: fn() Never! -[Browser]> {
    state: core.mem.__process_shared(init_local_storage)
    guard := state.guard_edit()
    guard.value.entries.clear()
}

get_or: fn(key: String, fallback: String) -> String Never! { get(key) ?? fallback }

has: fn(key: String) -> Bool Never! { get(key) != None }

// An explicit Browser-only caller bounds the inferred effects of both helpers.
test_helper_effects: fn() Never! -[Browser]> {
    key: "Core.web.storage.local.helper.effects"
    remove(key)
    assert_eq(get_or(key, "fallback"), "fallback")
    assert_eq(has(key), false)
}

#Test("local helper calls fit the shipped Browser effect row") {
    test_helper_effects()
}


#Test("local storage preserves miss, replacement, removal and empty keys") {
    key: "Core.web.storage.local.contract"
    remove(key)
    assert_eq(get(key), None)
    set(key, "first")
    set(key, "second")
    assert_eq(get(key), Val("second"))
    remove(key)
    assert_eq(get(key), None)
    set("", "")
    assert_eq(get(""), Val(""))
    remove("")
}

#Test("local and session storage keep separate identities") {
    key: "Core.web.storage.separation"
    set(key, "local")
    core.web.storage.session.set(key, "session")
    assert_eq(get(key), Val("local"))
    assert_eq(core.web.storage.session.get(key), Val("session"))
    remove(key)
    assert_eq(core.web.storage.session.get(key), Val("session"))
    core.web.storage.session.remove(key)
}

#Test("two tasks do not lose independent local storage writes") {
    first: task { loop i in 0..<64 -> set("Core.local.first.{i}", "{i}") }
    second: task { loop i in 0..<64 -> set("Core.local.second.{i}", "{i}") }
    first.join() ?? panic("first storage writer failed")
    second.join() ?? panic("second storage writer failed")
    loop i in 0..<64 {
        assert_eq(get("Core.local.first.{i}"), Val("{i}"))
        assert_eq(get("Core.local.second.{i}"), Val("{i}"))
        remove("Core.local.first.{i}")
        remove("Core.local.second.{i}")
    }
}
