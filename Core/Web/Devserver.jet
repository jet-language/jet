// core.web.devserver — hot-reload wrapper around an App.
DevServer: struct {
    app_name: String
    url: String
    watching: Bool
}

app: fn() -> DevServer Never! { {app_name: "app", url: "http://127.0.0.1:3000", watching: true} }

for_app: fn(name: String) -> DevServer Never! {
    {app_name: name, url: "http://127.0.0.1:3000", watching: true}
}

url: fn(host: String, port: Int) -> String Never! { "http://{host}:{port}" }

is_local: fn(host: String) -> Bool Never! {
    host == "127.0.0.1" || host == "localhost" || host == "::1"
}
