package: {
    name: "core.web"
    version: "0.0.1"
    edition: "2026"
    description: "App, pages, live queries, forms, and browser tests."
    license: "MIT"
    outputs: {
        web: .Library{ entry: web }
    }
}

use {
    core: core
    core.http.[HTTPRequest, HTTPResponse, HTTPRouter]
    web_http: core.http
    core.http.server.[HTTPMux]
    http_server: core.http.server
    live_json: core.encoding.json
    core.encoding.[Dyn]
    core.reactive.loadable.[Loadable]
    // `web.form(Model, action: handler)` elaborates (in sema) into
    // core.web.forms values and calls, so core.web reaches that module.
    core.web.forms.[WebFormTyped]
    rt: jet.runtime.time
}

// core.web — server-rendered apps on `core.http`.
//
// An `App` owns routes, live-query keys, and session auth. Nested modules
// own router, store, forms, table, virtual windows, storage, and browser
// tests. Nothing here talks to a browser; `core.http` is the wire.

browser: module
devserver: module
forms: module
query: module
router: module
storage: module
store: module
table: module
virtual: module

// ── App: the full-stack application builder ──────────────────────────────
//
// `web.app()` starts one application graph; every builder call registers
// into it and returns the builder, and copies share the graph. Sema writes
// each registered handler as an adapter over `__AppCall`: the adapter
// decodes the handler's typed route inputs (path parameters, the search
// record or field, the loader data) and wraps its result as an `__AppReply`,
// so the graph stores one handler shape. `serve` answers the graph over
// `core.http.server`: each route is a GET page, each action, form or data
// function a POST `/actions/<name>` server function, each mount a prefix,
// and the first assets root `/assets`.

/// A rendered page: its document title and its body markup.
WebPage: struct {
    title: String
    body: String
}

page: fn(title: String, body: String) -> WebPage Never! { WebPage{title: title, body: body} }

// One request into a handler adapter: the matched request and the route's
// encoded loader data ("" when the route has no loader).
__AppCall: struct {
    request: HTTPRequest
    data: String

    __input: fn<Target: Decode>(self, name: String) -> Target? { self.request.__route_input<Target>(name) }

    __body: fn<Target: Decode>(self) -[Net]> Target? Never! {
        if self.request.json<Target>() == .Ok(value) -> return Val(value)
        None
    }

    __data: fn<Target: Decode>(self) -> Target? {
        if self.data == "" -> return None
        if live_json.decode<Target>(self.data) == .Ok(value) -> return Val(value)
        None
    }

    __path: fn(self) -> String Never! { self.request.path() }

    __page: fn(self, page: WebPage) -> __AppReply Never! { __AppReply.Page(page) }

    __json: fn<Value: Encode>(self, value: Value) -> __AppReply Never! {
        text: live_json.to_string(value.encode()) ?? return __AppReply.Failed("the handler result does not encode as JSON: {err}")
        __AppReply.JSON(text)
    }

    __done: fn(self) -> __AppReply Never! { __AppReply.JSON("null") }

    __rejected: fn(self, input: String) -> __AppReply Never! { __AppReply.Rejected("the {input} input is missing or does not decode") }

    __failed: fn(self, message: String) -> __AppReply Never! { __AppReply.Failed(message) }
}

__AppReply: enum {
    Page(WebPage)
    JSON(String)
    Rejected(String)
    Failed(String)
}

__AppHandlerCell: struct {
    call: fn(__AppCall) -[Net, FS.Read]> __AppReply Err!
}

// A registered adapter. Copies share the one handler.
__AppHandler: struct {
    __cell: Shared<__AppHandlerCell>

    // A handler failure is the route's 500 answer, never the server's.
    run: fn(self, call: __AppCall) -[Net, FS.Read]> __AppReply Never! {
        guard: self.__cell.guard_read()
        reply: guard.value.call(call) ?? return __AppReply.Failed("the handler failed: {err}")
        reply
    }
}

__app_handler: fn(call: &&fn(__AppCall) -[Net, FS.Read]> __AppReply Err!) -> __AppHandler Never! {
    __AppHandler{__cell: Shared{__AppHandlerCell{call: call.move()}}}
}

// One route and the facts its registration fixed. An empty identity string
// is an absent boundary, loader or form.
__AppRoute: struct {
    path: String
    handler: __AppHandler
    identity: String
    binding: String
    mode: String
    explicit_mode: Bool
    loader: __AppHandler?
    loader_identity: String
    loader_data_type: String
    preload: Bool
    pending: __AppHandler?
    pending_identity: String
    error: __AppHandler?
    error_identity: String
    form: String
}

// A server function (`handler` set) or the loader dependency row a loader
// registration adds (`handler` None).
__AppAction: struct {
    name: String
    kind: String
    handler: __AppHandler?
    preload: Bool
}

__AppMount: struct {
    prefix: String
    handler: __AppHandler
    effects: [String]
    security: [String]
}

__AppState: struct {
    routes: [__AppRoute]
    actions: [__AppAction]
    mounts: [__AppMount]
    routes_from: [String]
    not_found: __AppHandler?
    security: [String]
    assets: [String]
    split: [String]
    cache: [String]
    a11y: [String]
    adapters: [String]
    hydration: String
    // The render mode the next registered route takes.
    mode: String
    explicit_mode: Bool
}

/// One application graph: routes, server functions, mounts and policies.
/// Copies share the one graph.
App: struct {
    __state: Shared<__AppState>

    // `route`, `page` and `layout` land here with the handler's adapter, its
    // name and its typed input binding.
    __route: fn(self, path: String, handler: &&fn(__AppCall) -[Net, FS.Read]> __AppReply Err!, identity: String, binding: String) -> App Never! {
        guard := self.__state.guard_edit()
        mode: guard.value.mode.copy()
        explicit: guard.value.explicit_mode
        route: __AppRoute{
            path: path, handler: __app_handler(handler), identity: identity, binding: binding,
            mode: mode, explicit_mode: explicit,
            loader: None, loader_identity: "", loader_data_type: "", preload: false,
            pending: None, pending_identity: "", error: None, error_identity: "", form: "",
        }
        guard.value.routes.push(route)
        self.copy()
    }

    // `pending`, `error` and `not_found`. A pending or error boundary belongs
    // to the route registered just before it; not-found answers every
    // unmatched navigation.
    __boundary: fn(self, kind: String, handler: &&fn(__AppCall) -[Net, FS.Read]> __AppReply Err!, identity: String) -> App Never! {
        guard := self.__state.guard_edit()
        boundary: __app_handler(handler)
        if kind == "not_found" {
            guard.value.not_found = Val(boundary)
            return self.copy()
        }
        last: guard.value.routes.len() - 1
        if last < 0 -> panic("app boundary `{identity}` has no preceding route")
        route := guard.value.routes[last].copy()
        if kind == "pending" {
            route.pending = Val(boundary)
            route.pending_identity = identity
        } else {
            route.error = Val(boundary)
            route.error_identity = identity
        }
        guard.value.routes[last] = route
        self.copy()
    }

    // `action`, `form` and `data`: one POST server function each. The first
    // action or form after a route is that route's form.
    __action: fn(self, kind: String, name: String, handler: &&fn(__AppCall) -[Net, FS.Read]> __AppReply Err!) -> App Never! {
        guard := self.__state.guard_edit()
        last: guard.value.routes.len() - 1
        if last >= 0 && (kind == "action" || kind == "form") && guard.value.routes[last].form == "" {
            route := guard.value.routes[last].copy()
            route.form = name.copy()
            guard.value.routes[last] = route
        }
        guard.value.actions.push(__AppAction{name: name, kind: kind, handler: Val(__app_handler(handler)), preload: false})
        self.copy()
    }

    // `loader(route_handler, loader, preload)`: the route registered just
    // before it loads its data through `handler` first.
    __loader: fn(self, handler: &&fn(__AppCall) -[Net, FS.Read]> __AppReply Err!, identity: String, data_type: String, preload: Bool) -> App Never! {
        guard := self.__state.guard_edit()
        last: guard.value.routes.len() - 1
        if last < 0 -> panic("app loader `{identity}` has no preceding route")
        route := guard.value.routes[last].copy()
        route.loader = Val(__app_handler(handler))
        route.loader_identity = identity
        route.loader_data_type = data_type
        route.preload = preload
        dependency: route.identity.copy()
        guard.value.routes[last] = route
        guard.value.actions.push(__AppAction{name: dependency, kind: "loader", handler: None, preload: preload})
        self.copy()
    }

    // `mount(prefix, handler[, effect[, policy]])`; "" is an absent effect or
    // policy.
    __mount: fn(self, prefix: String, handler: &&fn(__AppCall) -[Net, FS.Read]> __AppReply Err!, effect_name: String, policy: String) -> App Never! {
        effects := [String]{}
        if effect_name != "" -> effects.push(effect_name.copy())
        security := [String]{}
        if policy != "" -> security.push(policy.copy())
        guard := self.__state.guard_edit()
        guard.value.mounts.push(__AppMount{prefix: prefix, handler: __app_handler(handler), effects: effects, security: security})
        self.copy()
    }

    routes: fn(self, from: String) -> App Never! {
        guard := self.__state.guard_edit()
        guard.value.routes_from.push(from.copy())
        self.copy()
    }

    csr: fn(self) -> App Never! { __app_mode(self, "csr") }
    ssr: fn(self) -> App Never! { __app_mode(self, "ssr") }
    ssg: fn(self) -> App Never! { __app_mode(self, "ssg") }
    stream: fn(self) -> App Never! { __app_mode(self, "stream") }
    streaming: fn(self) -> App Never! { __app_mode(self, "stream") }
    island: fn(self) -> App Never! { __app_mode(self, "island") }

    hydration_dev: fn(self) -> App Never! {
        guard := self.__state.guard_edit()
        guard.value.hydration = "dev-overlay"
        self.copy()
    }

    hydration_release: fn(self) -> App Never! {
        guard := self.__state.guard_edit()
        guard.value.hydration = "release-keep-server"
        self.copy()
    }

    security: fn(self, policy: String) -> App Never! {
        guard := self.__state.guard_edit()
        guard.value.security.push(policy.copy())
        self.copy()
    }

    assets: fn(self, path: String) -> App Never! {
        guard := self.__state.guard_edit()
        guard.value.assets.push(path.copy())
        self.copy()
    }

    split: fn(self, name: String) -> App Never! {
        guard := self.__state.guard_edit()
        guard.value.split.push(name.copy())
        self.copy()
    }

    code_split: fn(self, name: String) -> App Never! { self.split(name) }

    cache: fn(self, policy: String) -> App Never! {
        guard := self.__state.guard_edit()
        guard.value.cache.push(policy.copy())
        self.copy()
    }

    a11y: fn(self, policy: String) -> App Never! {
        guard := self.__state.guard_edit()
        guard.value.a11y.push(policy.copy())
        self.copy()
    }

    adapter: fn(self, name: String) -> App Never! {
        guard := self.__state.guard_edit()
        guard.value.adapters.push(name.copy())
        self.copy()
    }

    facts_json: fn(self) -> String Never! { __app_facts_json(self) }

    // Serve on 127.0.0.1 until the process stops: on `JET_APP_PORT` when it
    // holds a port, else on `port` (8080 for `serve()`).
    serve: fn(self, port: Int{8080}) Never! -[Env, Net, FS.Read, Time]> { __app_serve(self, __app_port(port)) }

    serve_on: fn(self, port: Int) Never! -[Env, Net, FS.Read, Time]> { __app_serve(self, __app_port(port)) }
}

app: fn() -> App Never! {
    App{__state: Shared{__AppState{
        routes: [__AppRoute]{},
        actions: [__AppAction]{},
        mounts: [__AppMount]{},
        routes_from: [String]{},
        not_found: None,
        security: [String]{},
        assets: [String]{},
        split: [String]{},
        cache: [String]{},
        a11y: [String]{},
        adapters: [String]{},
        hydration: "dev-overlay",
        mode: "csr",
        explicit_mode: false,
    }}}
}

__app_mode: fn(app: App, mode: String) -> App Never! {
    guard := app.__state.guard_edit()
    guard.value.mode = mode
    guard.value.explicit_mode = true
    app.copy()
}

__app_state: fn(app: App) -> __AppState Never! {
    guard: app.__state.guard_read()
    guard.value.copy()
}

__app_port: fn(fallback: Int) -> Int Never! {
    raw: core.sys.__env_value("JET_APP_PORT") ?? return fallback
    text: String.from_bytes(raw) ?? return fallback
    port: Int.parse(text) ?? return fallback
    if port < 1 || port > 65535 -> return fallback
    port
}

__app_serve: fn(app: App, port: Int) Never! -[Net, FS.Read, Time]> {
    if port < 1 || port > 65535 -> panic("web app port {port} is out of range")
    state: __app_state(app)
    mux: http_server.mux()
    loop route in state.routes {
        target: app.copy()
        path: route.path.copy()
        mux.__route("GET", route.path, fn(request: HTTPRequest) { Ok(__app_page_response(target, path, request)) }, "")
    }
    loop action in state.actions {
        if action.handler == .Val(handler) {
            mux.__route("POST", "/actions/{action.name}", fn(request: HTTPRequest) { Ok(__app_action_response(handler, request)) }, "")
        }
    }
    loop mount in state.mounts {
        base: __app_trim_slashes(mount.prefix)
        handler: mount.handler.copy()
        mux.__route("GET", "{base}/*jet_app_mount_path", fn(request: HTTPRequest) { Ok(__app_mount_response(handler, request)) }, "")
        mux.__route("POST", "{base}/*jet_app_mount_path", fn(request: HTTPRequest) { Ok(__app_mount_response(handler, request)) }, "")
    }
    if state.assets.len() > 0 -> http_server.static_files(mux, "/assets", state.assets[0])
    fallback: app.copy()
    mux.__route("GET", "/*jet_app_unmatched", fn(request: HTTPRequest) { Ok(__app_not_found_response(fallback, request)) }, "")
    server: http_server.__bind_entry("127.0.0.1:{port}", mux, None, None) ?? panic("web app could not listen on 127.0.0.1:{port}: {err}")
    _: server.serve() ?? panic("web app server failed: {err}")
}

__app_route: fn(app: App, path: String) -> __AppRoute? Never! {
    guard: app.__state.guard_read()
    loop route in guard.value.routes {
        if route.path == path -> return Val(route.copy())
    }
    None
}

// A route request: run the route's loader, then its handler with the
// loader's data; a failure renders the route's error boundary.
__app_page_response: fn(app: App, path: String, request: HTTPRequest) -[Net, FS.Read]> HTTPResponse Never! {
    route: __app_route(app, path) ?? return __app_html(500, WebPage{title: "Route error", body: "route `{path}` is not registered on the app graph"}, "")
    call := __AppCall{request: request, data: ""}
    if route.loader == .Val(loader) {
        if loader.run(call) == {
            .JSON(text) -> call.data = text
            .Rejected(message) -> return __app_boundary(400, route.error, "Route error", message, call)
            .Failed(message) -> return __app_boundary(500, route.error, "Route error", message, call)
            .Page(_) -> return __app_boundary(500, route.error, "Route error", "the loader of `{path}` rendered a page instead of data", call)
        }
    }
    if route.handler.run(call) == {
        .Page(rendered) -> __app_html(200, rendered, __app_route_data(path, request.path, call.data))
        .Rejected(message) -> __app_boundary(400, route.error, "Route error", message, call)
        .Failed(message) -> __app_boundary(500, route.error, "Route error", message, call)
        .JSON(_) -> __app_boundary(500, route.error, "Route error", "the handler of `{path}` returned data instead of a page", call)
    }
}

__app_not_found_response: fn(app: App, request: HTTPRequest) -[Net, FS.Read]> HTTPResponse Never! {
    state: __app_state(app)
    __app_boundary(404, state.not_found, "Not found", "no web route matches `{request.path}`", __AppCall{request: request, data: ""})
}

// The boundary's page, or a page of `title` and `message` without one; a
// boundary that fails itself shows both messages.
__app_boundary: fn(status: Int, boundary: __AppHandler?, title: String, message: String, call: __AppCall) -[Net, FS.Read]> HTTPResponse Never! {
    handler: boundary ?? return __app_html(status, WebPage{title: title, body: message}, "")
    if handler.run(call) == {
        .Page(rendered) -> __app_html(status, rendered, "")
        .Rejected(failure) -> __app_html(status, WebPage{title: title, body: "{message}\n{failure}"}, "")
        .Failed(failure) -> __app_html(status, WebPage{title: title, body: "{message}\n{failure}"}, "")
        .JSON(_) -> __app_html(status, WebPage{title: title, body: message}, "")
    }
}

__app_html: fn(status: Int, rendered: WebPage, route_data: String) -> HTTPResponse Never! {
    document: "<!doctype html><html><head><meta charset=\"utf-8\"><title>{rendered.title}</title></head><body>{rendered.body}{route_data}</body></html>"
    fields: core.http.headers_set(core.http.headers(), "content-type", "text/html; charset=utf-8")
    payload: core.http.body_text(document)
    http_server.response_body(status, payload, fields)
}

// The route identity and navigation status a served page publishes; the
// body is the route's encoded loader data, `null` without a loader.
__app_route_data: fn(route: String, url: String, data: String) -> String Never! {
    body: if data == "" -> "null" else -> __app_script_safe(data)
    "<script type=\"application/json\" id=\"jet-route-data\" data-route=\"{__app_html_attr(route)}\" data-url=\"{__app_html_attr(url)}\" data-status=\"ready\">{body}</script>"
}

// A server function call: same-origin POST only; the JSON result answers
// with a content security policy.
__app_action_response: fn(handler: __AppHandler, request: HTTPRequest) -[Net, FS.Read]> HTTPResponse Never! {
    if !__app_same_origin(request) -> return __app_json(403, __app_error_json("cross-origin server function call"))
    if handler.run(__AppCall{request: request, data: ""}) == {
        .JSON(text) -> __app_json(200, text)
        .Rejected(message) -> __app_json(400, __app_error_json(message))
        .Failed(message) -> __app_json(500, __app_error_json(message))
        .Page(_) -> __app_json(500, __app_error_json("a server function rendered a page"))
    }
}

__app_mount_response: fn(handler: __AppHandler, request: HTTPRequest) -[Net, FS.Read]> HTTPResponse Never! {
    if handler.run(__AppCall{request: request, data: ""}) == {
        .JSON(text) -> __app_json(200, text)
        .Page(rendered) -> __app_html(200, rendered, "")
        .Rejected(message) -> __app_json(400, __app_error_json(message))
        .Failed(message) -> __app_json(500, __app_error_json(message))
    }
}

__app_json: fn(status: Int, text: String) -> HTTPResponse Never! {
    typed: core.http.headers_set(core.http.headers(), "content-type", "application/json")
    fields: core.http.headers_set(typed, "content-security-policy", "default-src 'self'")
    payload: core.http.body_text(text)
    http_server.response_body(status, payload, fields)
}

__app_error_json: fn(message: String) -> String Never! { "{{\"error\":{__app_json_string(message)}}}" }

// A request without an Origin header is same-origin; one with it must name
// the Host it was sent to.
__app_same_origin: fn(request: HTTPRequest) -> Bool Never! {
    origin: request.header("origin") ?? return true
    host: request.header("host") ?? return false
    plain: "http://{host}"
    secure: "https://{host}"
    origin == plain || origin == secure
}

__app_trim_slashes: fn(prefix: String) -> String Never! {
    raw: prefix.bytes()
    end := raw.len()
    loop end > 0 && raw[end - 1] == (U8{47}) -> end = end - 1
    String.from_bytes(raw.slice(0, end)) ?? ""
}

__app_push: fn(out: &[U8], text: String) Never! {
    loop byte in text.bytes() -> out.push(byte)
}

__app_hex_digit: fn(value: Int) -> U8 Never! {
    digits: "0123456789abcdef".bytes()
    digits[value]
}

__app_json_string: fn(value: String) -> String Never! {
    out := [U8]{34}
    loop byte in value.bytes() {
        n: Int.from_u8(byte)
        if n == 34 || n == 92 {
            out.push(U8{92})
            out.push(byte)
        } else if n == 10 {
            __app_push(out, "\\n")
        } else if n == 13 {
            __app_push(out, "\\r")
        } else if n == 9 {
            __app_push(out, "\\t")
        } else if n < 32 {
            __app_push(out, "\\u00")
            out.push(__app_hex_digit(n >> 4))
            out.push(__app_hex_digit(n.bit_and(15)))
        } else {
            out.push(byte)
        }
    }
    out.push(U8{34})
    String.from_bytes(out) ?? ""
}

__app_html_attr: fn(value: String) -> String Never! {
    out := [U8]{}
    loop byte in value.bytes() {
        n: Int.from_u8(byte)
        if n == 38 {
            __app_push(out, "&amp;")
        } else if n == 60 {
            __app_push(out, "&lt;")
        } else if n == 62 {
            __app_push(out, "&gt;")
        } else if n == 34 {
            __app_push(out, "&quot;")
        } else {
            out.push(byte)
        }
    }
    String.from_bytes(out) ?? ""
}

// JSON inside a `<script>` element: every `<` as `\u003c`.
__app_script_safe: fn(text: String) -> String Never! {
    out := [U8]{}
    loop byte in text.bytes() {
        if byte == (U8{60}) {
            __app_push(out, "\\u003c")
        } else {
            out.push(byte)
        }
    }
    String.from_bytes(out) ?? ""
}

__app_json_list: fn(values: [String]) -> String Never! {
    items := [String]{}
    loop value in values -> items.push(__app_json_string(value))
    "[{items.join(",")}]"
}

// The debug spelling of a string list (`["a", "b"]`) the policy rows use.
__app_debug_list: fn(values: [String]) -> String Never! {
    items := [String]{}
    loop value in values -> items.push(__app_json_string(value))
    "[{items.join(", ")}]"
}

__app_json_or_null: fn(value: String) -> String Never! {
    if value == "" -> return "null"
    __app_json_string(value)
}

// FNV-1a 64 of `path\0handler`: the route's cache identity.
__app_route_identity: fn(path: String, handler: String) -> String Never! {
    hash := U64{14695981039346656037}
    bytes := path.bytes()
    bytes.push(U8{0})
    loop byte in handler.bytes() -> bytes.push(byte)
    loop byte in bytes {
        hash = (hash.bit_xor(U64{Int.from_u8(byte)})).wrapping_mul(U64{1099511628211})
    }
    out := [U8]{}
    loop index in 0..<16 {
        out.push(__app_hex_digit(Int.from_u64((hash >> (60 - index * 4)).bit_and(U64{15}))))
    }
    "route-{String.from_bytes(out) ?? ""}"
}

// One route field of the binding sema serialized: `p:<name>=<Type>` is a
// path parameter, `s=<codec>:<name>=<Type>[?],…` the search fields, `d` the
// loader data.
__app_field_json: fn(name: String, ty: String, codec: String, required: Bool) -> String Never! {
    "{{\"name\":{__app_json_string(name)},\"ty\":{__app_json_string(ty)},\"codec\":{__app_json_string(codec)},\"required\":{required},\"default\":null}}"
}

__app_search_field_json: fn(item: String, codec: String) -> String Never! {
    parts: item.split("=").to_list()
    if parts.len() != 2 -> panic("invalid app search field binding `{item}`")
    raw: parts[1].bytes()
    optional: raw.len() > 0 && raw[raw.len() - 1] == (U8{63})
    ty: if optional -> String.from_bytes(raw.slice(0, raw.len() - 1)) ?? "" else -> parts[1].copy()
    __app_field_json(parts[0], ty, codec, !optional)
}

__app_route_facts_json: fn(route: __AppRoute) -> String Never! {
    path_params := [String]{}
    search_params := [String]{}
    search_codec := "query"
    loop item in route.binding.split(";") {
        if item == "" || item == "d" -> next
        if item.starts_with("p:") {
            field: String.from_bytes(item.bytes().slice(2, item.bytes().len())) ?? ""
            parts: field.split("=").to_list()
            if parts.len() != 2 -> panic("invalid app path binding `{item}`")
            path_params.push(__app_field_json(parts[0], parts[1], "path", true))
        } else if item.starts_with("s=") {
            spec: String.from_bytes(item.bytes().slice(2, item.bytes().len())) ?? ""
            pieces: spec.split(":").to_list()
            if pieces.len() != 2 -> panic("invalid app search binding `{item}`")
            search_codec = pieces[0].copy()
            loop field in pieces[1].split(",") {
                if field != "" -> search_params.push(__app_search_field_json(field, search_codec))
            }
        } else {
            panic("invalid app route binding `{item}`")
        }
    }
    identity: __app_route_identity(route.path, route.identity)
    loader_contract: if route.loader_identity == "" -> "null" else -> "{{\"handler\":{__app_json_string(route.loader_identity)},\"data_type\":{__app_json_string(route.loader_data_type)},\"dependency\":{__app_json_string(route.identity)},\"preload\":{route.preload},\"cache_identity\":{__app_json_string(identity)}}}"
    reason: if route.explicit_mode -> __app_json_list([String]{"explicit render mode `{route.mode}`"}) else -> "[]"
    override_mode: if route.explicit_mode -> __app_json_string(route.mode) else -> "null"
    "{{\"route_identity\":{__app_json_string(identity)},\"path_params\":[{path_params.join(",")}],\"search_params\":[{search_params.join(",")}],\"search_codec\":{__app_json_string(search_codec)},\"loader_contract\":{loader_contract},\"pending_boundary\":{__app_json_or_null(route.pending_identity)},\"not_found_boundary\":null,\"error_boundary\":{__app_json_or_null(route.error_identity)},\"mode\":{__app_json_string(route.mode)},\"reason\":{reason},\"effects\":[],\"interactive\":false,\"loader\":{__app_json_or_null(route.loader_identity)},\"form\":{__app_json_or_null(route.form)},\"cache\":\"unspecified\",\"override_mode\":{override_mode},\"pending_boundary_id\":null,\"island\":null}}"
}

__app_facts_json: fn(app: App) -> String Never! {
    state: __app_state(app)
    routes := [String]{}
    loop route in state.routes {
        routes.push("    {{\"path\": {__app_json_string(route.path)}, \"handler\": {__app_json_string(route.identity)}, \"provenance\": \"runtime\", \"render_facts\": {__app_route_facts_json(route)}}}")
    }
    actions := [String]{}
    loop action in state.actions {
        server: if action.handler == None -> "null" else -> "{{\"name\":{__app_json_string(action.name)},\"endpoint\":{__app_json_string("/actions/{action.name}")},\"method\":\"POST\",\"csrf\":\"same-origin\",\"middleware\":[]}}"
        actions.push("    {{\"name\": {__app_json_string(action.name)}, \"handler\": \"callable\", \"kind\": {__app_json_string(action.kind)}, \"preload\": {action.preload}, \"server_function\": {server}}}")
    }
    route_rows: if routes.len() == 0 -> "" else -> "{routes.join(",\n")}\n"
    action_rows: if actions.len() == 0 -> "" else -> "{actions.join(",\n")}\n"
    // The Jet query module keeps no process-wide registry, so the graph
    // names no queries.
    "{{\n  \"hydration\": {__app_json_string(state.hydration)},\n  \"shared_tir\": true,\n  \"routes\": [\n{route_rows}  ],\n  \"actions\": [\n{action_rows}  ],\n  \"queries\": [],\n  \"security\": {__app_debug_list(state.security)},\n  \"assets\": {__app_debug_list(state.assets)},\n  \"split\": {__app_debug_list(state.split)},\n  \"cache\": {__app_debug_list(state.cache)},\n  \"a11y\": {__app_debug_list(state.a11y)},\n  \"adapters\": {__app_debug_list(state.adapters)}\n}}"
}


WebEvent: struct {
    path: String
    title: String
    payload: String
}

Context: struct {
    path: String
    method: String
    session: String
}

Mount: struct {
    path: String
    page: String
}

Auth: struct {
    kind: String
    client_id: String
}

Session: struct {
    id: String
    user_id: String
}

// A live binding: one source function applied to one argument list. The
// compiler builds it from `live(source, args...)` or
// `subscribe(source, args...)`; `state` reads it.
Live: struct<T, E> {
    id: Int
    run: fn() -> T E!
}

// One registry binding, named by its source's wire name and its encoded
// argument list. `value` is the last result, `ok:` or `err:` then its JSON,
// and empty before the first run; `every_ns` is the poll interval (0: none)
// and `ran_ns` the monotonic time of the last run.
LiveRecord: struct {
    id: Int
    source: String
    key: String
    value: String
    dirty: Bool
    every_ns: Int
    ran_ns: Int
}

LiveRegistry: struct {
    next_id: Int
    invalidations: Int
    changes: Int
    evictions: Int
    ws_pushes: Int
    records: [LiveRecord]
}

// Web.form(Model, action: handler) is elaborated by sema.
// It returns the opaque typed-model form boundary, not the source forms
// module's explicit input/action-name record API.


// `jet_web_on` has registry entries but no implementation in this
// repository: the generated web host binds no DOM route by path. This
// forwarding declaration is not an implementation or cutover. Native
// callback admission must keep the actual backend contract.
on: fn(path: String, title: String, handler: fn(WebEvent)) Never! -[Browser]> {
    core.web.on(path, title, handler)
}

// `web.openapi(mux)` checks as `__openapi_mux(mux)` below (sema
// sema_call_http_web_openapi_mux); a router renders its route table the same way.
openapi: fn(router: HTTPRouter) -> String Never! {
    __openapi_mux(web_http.__router_mux(router))
}

// OpenAPI for an HTTPMux (`JetHTTPRouteSource for JetHTTPMux` and
// `jet_web_openapi`): each route's checked contract is parsed
// (jet_openapi_contract_input) and checked against the route registered, then
// the routes are canonicalized and checked as one document
// (JetOpenApiDocument::with_openapi) and rendered (::json).
__openapi_mux: fn(routes: HTTPMux) -> String Never! {
    __openapi_mux_document(routes) ?? core.web.__contract_stop(err.message)
}

// An OpenAPI contract or document problem: `web.openapi` stops with it.
#Error
__OpenAPIFault: struct {
    message: String

    impl Display { display: fn(self) -> String { self.message.copy() } }

    impl Debug { debug: fn(&&self) -> String { self.message } }
}
__openapi_fault: fn(message: String) -> __OpenAPIFault Never! { __OpenAPIFault{message: message} }

__OpenAPIParameter: struct {
    // Index into __openapi_locations(): path, query, header, cookie.
    location: Int
    name: String
    // The canonical rendered schema and its definition problems.
    schema: String
    schema_errors: [String]
    required: Bool
    catch_all: Bool
}

__OpenAPIBody: struct {
    required: Bool
    content_type: String
    schema: String
    schema_errors: [String]
}

__OpenAPIResponse: struct {
    status: Int
    description: String
    schema: String?
    schema_errors: [String]
    content_type: String?
}

__OpenAPISecurity: struct {
    scheme: String
    scopes: [String]
}

__OpenAPIPattern: struct {
    path: String
    // The parsed segments, kind and name: equal keys are equal patterns.
    key: String
    names: [String]
    catch_alls: [String]
}

__OpenAPIRoute: struct {
    // Index into __openapi_methods(), JetOpenApiHttpMethod order; a custom
    // method ranks after them all and is `token`, exactly as sent.
    method: Int
    token: String
    path: String
    names: [String]
    catch_alls: [String]
    operation_id: String
    summary: String?
    parameters: [__OpenAPIParameter]
    body: __OpenAPIBody?
    responses: [__OpenAPIResponse]
    security: [__OpenAPISecurity]
}

// The eight OpenAPI 3.1 Path Item operation fields, then `connect`: 3.1 has no
// field for CONNECT or for a custom method, so their operations go under
// OpenAPI 3.2 `additionalOperations` (keyed by the method as sent) and that
// document says 3.2.0.
__openapi_methods: fn() -> [String] Never! { [String]{"get", "put", "post", "delete", "options", "head", "patch", "trace", "connect"} }

__openapi_additional_method: fn(route: __OpenAPIRoute) -> Bool Never! { route.token != "" || __openapi_methods()[route.method] == "connect" }

// A route's method as sent: the upper-case standard name, or the custom
// token exactly (so `get` and `GET` are two routes).
__openapi_route_method: fn(route: __OpenAPIRoute) -> String Never! {
    if route.token != "" -> return route.token.copy()
    __openapi_methods()[route.method].to_upper()
}

// The method part of a derived operation id: the Path Item field of a
// standard method, or `custom_` and the token, which no standard field is.
__openapi_operation_method: fn(route: __OpenAPIRoute) -> String Never! {
    if route.token != "" -> return "custom_{route.token}"
    __openapi_methods()[route.method].copy()
}

__openapi_locations: fn() -> [String] Never! { [String]{"path", "query", "header", "cookie"} }

__openapi_index: fn(values: [String], value: String) -> Int? {
    loop index in 0..<values.len() {
        if values[index] == value -> return Val(index)
    }
    None
}

// The rank of a method as sent: a standard method is exactly its upper-case
// name, and any other token (`get` too) is a custom method, ranked last.
__openapi_method: fn(value: String) -> Int Never! {
    methods: __openapi_methods()
    loop index in 0..<methods.len() {
        if methods[index].to_upper() == value -> return index
    }
    methods.len()
}

__openapi_problem: fn(path: String, reason: String) -> String Never! {
    if path == "" -> return reason.copy()
    "{path}: {reason}"
}

__openapi_mux_document: fn(mux: HTTPMux) -> String __OpenAPIFault! {
    routes := [__OpenAPIRoute]{}
    loop route in http_server.__mux_routes(mux) {
        routes.push(__openapi_route_input(route.contract, route.method, route.pattern) ?? return Err(err))
    }
    __openapi_document(routes, "Jet HTTP Router", "1")
}

__openapi_pattern: fn(pattern: String) -> __OpenAPIPattern __OpenAPIFault! {
    parsed: http_server.__route_parse(pattern)
    if parsed.problem != "" -> return Err(__openapi_fault("E2805: invalid HTTP route `{pattern}`: {parsed.problem}"))
    key := ""
    names := [String]{}
    catch_alls := [String]{}
    loop segment in parsed.segments {
        if segment == {
            .Static(text) -> key = "{key}/s{text.bytes().len()}:{text}"
            .Param(name) -> {
                key = "{key}/p:{name}"
                names.push(name)
            }
            .CatchAll(name) -> {
                key = "{key}/w:{name}"
                names.push(name.copy())
                catch_alls.push(name)
            }
        }
    }
    Ok(__OpenAPIPattern{path: http_server.__route_openapi_path(parsed.segments), key: key, names: names, catch_alls: catch_alls})
}

__openapi_object: fn(value: Dyn) -> [(key: String, value: Dyn)] __OpenAPIFault! {
    if value == {
        .Object(members) -> return Ok(members)
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) -> return Err(__openapi_fault("OpenAPI route contract must be an object"))
    }
}

__openapi_is_object: fn(value: Dyn) -> Bool Never! {
    if value == {
        .Object(_) -> true
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) -> false
    }
}

__openapi_member: fn(fields: [(key: String, value: Dyn)], name: String) -> Dyn? {
    loop pair in fields {
        if pair.key == name -> return Val(pair.value)
    }
    None
}

__openapi_field: fn(fields: [(key: String, value: Dyn)], name: String) -> Dyn __OpenAPIFault! {
    value: __openapi_member(fields, name) ?? return Err(__openapi_fault("OpenAPI route contract is missing `{name}`"))
    Ok(value)
}

__openapi_text: fn(fields: [(key: String, value: Dyn)], name: String) -> String __OpenAPIFault! {
    value: __openapi_field(fields, name) ?? return Err(err)
    if value == {
        .Text(text) -> return Ok(text)
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> return Err(__openapi_fault("OpenAPI route contract field `{name}` must be text"))
    }
}

__openapi_optional_text: fn(fields: [(key: String, value: Dyn)], name: String) -> String? __OpenAPIFault! {
    value: __openapi_field(fields, name) ?? return Err(err)
    if value == {
        .Null -> return Ok(String?{None})
        .Text(text) -> return Ok(Val(text))
        .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> return Err(__openapi_fault("OpenAPI route contract field `{name}` must be text or null"))
    }
}

__openapi_bool: fn(fields: [(key: String, value: Dyn)], name: String) -> Bool __OpenAPIFault! {
    value: __openapi_field(fields, name) ?? return Err(err)
    if value == {
        .Bool(flag) -> return Ok(flag)
        .Null | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> return Err(__openapi_fault("OpenAPI route contract field `{name}` must be boolean"))
    }
}

__openapi_array: fn(fields: [(key: String, value: Dyn)], name: String) -> [Dyn] __OpenAPIFault! {
    value: __openapi_field(fields, name) ?? return Err(err)
    if value == {
        .Array(items) -> return Ok(items)
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> return Err(__openapi_fault("OpenAPI route contract field `{name}` must be an array"))
    }
}

__openapi_integer: fn(fields: [(key: String, value: Dyn)], name: String) -> Int __OpenAPIFault! {
    value: __openapi_field(fields, name) ?? return Err(err)
    if value == {
        .Int(number) -> return Ok(number)
        .Number(text) -> {
            number: Int.parse(text) ?? return Err(__openapi_fault("OpenAPI route contract field `{name}` is out of range"))
            return Ok(number)
        }
        .Null | .Bool(_) | .Float(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> return Err(__openapi_fault("OpenAPI route contract field `{name}` must be an integer"))
    }
}

// jet_openapi_contract_schema then render_json: the schema rendered canonically
// (object properties by name). Definition problems (validate_definition) are
// collected in `errors` under `path`.
__openapi_schema: fn(value: Dyn, path: String, errors: &[String]) -> String __OpenAPIFault! {
    fields: __openapi_object(value) ?? return Err(err)
    if __openapi_member(fields, "type") == .Val(kind) -> return __openapi_typed_schema(kind, fields, path, errors)
    if __openapi_member(fields, "anyOf") == .Val(any_of) {
        items: if any_of == {
            .Array(entries) -> entries
            .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> { return Err(__openapi_fault("OpenAPI schema `anyOf` must be an array")) }
        }
        if items.len() == 2 && __openapi_is_object(items[1]) {
            probe := [String]{}
            second: __openapi_schema(items[1], path, probe) ?? return Err(err)
            if second == "{{\"type\":\"null\"}}" {
                inner: __openapi_schema(items[0], path, errors) ?? return Err(err)
                return Ok("{{\"anyOf\":[{inner},{{\"type\":\"null\"}}]}}")
            }
        }
    }
    if __openapi_member(fields, "oneOf") == .Val(one_of) {
        items: if one_of == {
            .Array(entries) -> entries
            .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> { return Err(__openapi_fault("OpenAPI schema `oneOf` must be an array")) }
        }
        if items.len() == 0 -> errors.push(__openapi_problem(path, "oneOf needs at least one schema"))
        rendered := [String]{}
        loop item in items {
            rendered.push(__openapi_schema(item, path, errors) ?? return Err(err))
        }
        return Ok("{{\"oneOf\":[{rendered.join(",")}]}}")
    }
    Ok("{{}}")
}

__openapi_typed_schema: fn(kind: Dyn, fields: [(key: String, value: Dyn)], path: String, errors: &[String]) -> String __OpenAPIFault! {
    name: if kind == {
        .Text(text) -> text
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> { return Err(__openapi_fault("OpenAPI schema `type` must be text")) }
    }
    if name == "null" -> return Ok("{{\"type\":\"null\"}}")
    if name == "boolean" -> return Ok("{{\"type\":\"boolean\"}}")
    if name == "integer" -> return Ok("{{\"type\":\"integer\",\"format\":\"int64\"}}")
    if name == "number" -> return Ok("{{\"type\":\"number\",\"format\":\"double\"}}")
    if name == "string" -> return Ok("{{\"type\":\"string\"}}")
    if name == "array" {
        items: __openapi_field(fields, "items") ?? return Err(err)
        item: __openapi_schema(items, path, errors) ?? return Err(err)
        return Ok("{{\"type\":\"array\",\"items\":{item}}}")
    }
    if name != "object" -> return Err(__openapi_fault("unsupported OpenAPI schema type `{name}`"))
    declared: __openapi_field(fields, "properties") ?? return Err(err)
    properties := if declared == {
        .Object(members) -> members
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) -> { return Err(__openapi_fault("OpenAPI object schema `properties` must be an object")) }
    }
    required := [String]{}
    if __openapi_member(fields, "required") == .Val(listed) {
        entries: if listed == {
            .Array(items) -> items
            .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> { return Err(__openapi_fault("OpenAPI schema `required` must be an array")) }
        }
        loop entry in entries {
            if entry == {
                .Text(text) -> required.push(text)
                .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> return Err(__openapi_fault("OpenAPI schema `required` names must be text"))
            }
        }
    }
    additional: __openapi_field(fields, "additionalProperties") ?? return Err(err)
    open: if additional == {
        .Bool(flag) -> flag
        .Null | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> { return Err(__openapi_fault("OpenAPI object schema `additionalProperties` must be boolean")) }
    }
    properties.sort_by(fn(left: (key: String, value: Dyn), right: (key: String, value: Dyn)) { left.key <=> right.key })
    rendered := [String]{}
    required_names := [String]{}
    loop property in properties {
        schema: __openapi_schema(property.value, "{path}.{property.key}", errors) ?? return Err(err)
        rendered.push("{__app_json_string(property.key)}:{schema}")
        if required.contains(property.key) -> required_names.push(__app_json_string(property.key))
    }
    out := "{{\"type\":\"object\",\"properties\":{{{rendered.join(",")}}},\"additionalProperties\":{open}"
    if required_names.len() > 0 -> out = "{out},\"required\":[{required_names.join(",")}]"
    Ok("{out}}}")
}

__openapi_parameter: fn(value: Dyn) -> __OpenAPIParameter __OpenAPIFault! {
    fields: __openapi_object(value) ?? return Err(err)
    location_text: __openapi_text(fields, "in") ?? return Err(err)
    location: __openapi_index(__openapi_locations(), location_text) ?? return Err(__openapi_fault("unsupported OpenAPI parameter location `{location_text}`"))
    name: __openapi_text(fields, "name") ?? return Err(err)
    schema_value: __openapi_field(fields, "schema") ?? return Err(err)
    schema_errors := [String]{}
    schema: __openapi_schema(schema_value, name, schema_errors) ?? return Err(err)
    required: __openapi_bool(fields, "required") ?? return Err(err)
    catch_all: __openapi_bool(fields, "catch_all") ?? return Err(err)
    Ok(__OpenAPIParameter{location: location, name: name, schema: schema, schema_errors: schema_errors, required: required, catch_all: catch_all})
}

__openapi_body: fn(value: Dyn) -> __OpenAPIBody __OpenAPIFault! {
    fields: __openapi_object(value) ?? return Err(err)
    required: __openapi_bool(fields, "required") ?? return Err(err)
    content_type: __openapi_text(fields, "content_type") ?? return Err(err)
    schema_value: __openapi_field(fields, "schema") ?? return Err(err)
    schema_errors := [String]{}
    schema: __openapi_schema(schema_value, "requestBody", schema_errors) ?? return Err(err)
    Ok(__OpenAPIBody{required: required, content_type: content_type, schema: schema, schema_errors: schema_errors})
}

__openapi_response: fn(value: Dyn) -> __OpenAPIResponse __OpenAPIFault! {
    fields: __openapi_object(value) ?? return Err(err)
    status: __openapi_integer(fields, "status") ?? return Err(err)
    if status < 0 || status > 65535 -> return Err(__openapi_fault("OpenAPI response status is outside the u16 range"))
    schema_value: __openapi_field(fields, "schema") ?? return Err(err)
    schema_errors := [String]{}
    schema := String?{None}
    if !(schema_value == Dyn.Null) -> schema = Val(__openapi_schema(schema_value, "response", schema_errors) ?? return Err(err))
    description: __openapi_text(fields, "description") ?? return Err(err)
    content_type: if __openapi_optional_text(fields, "content_type") == {
        .Ok(text) -> text
        .Err(fault) -> { return Err(fault) }
    }
    Ok(__OpenAPIResponse{status: status, description: description, schema: schema, schema_errors: schema_errors, content_type: content_type})
}

__openapi_security: fn(value: Dyn) -> __OpenAPISecurity __OpenAPIFault! {
    fields: __openapi_object(value) ?? return Err(err)
    listed: __openapi_array(fields, "scopes") ?? return Err(err)
    scopes := [String]{}
    loop scope in listed {
        if scope == {
            .Text(text) -> scopes.push(text)
            .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> return Err(__openapi_fault("OpenAPI security scopes must be text"))
        }
    }
    scheme: __openapi_text(fields, "scheme") ?? return Err(err)
    Ok(__OpenAPISecurity{scheme: scheme, scopes: scopes})
}

// jet_openapi_contract_input and JetOpenApiRouteFact::from_input, checked
// against the method and pattern the mux registered.
__openapi_route_input: fn(contract: String, method: String, pattern: String) -> __OpenAPIRoute __OpenAPIFault! {
    value: live_json.parse(contract) ?? return Err(__openapi_fault("invalid checked OpenAPI route contract: {err.reason}"))
    fields: __openapi_object(value) ?? return Err(err)
    method_text: __openapi_text(fields, "method") ?? return Err(err)
    rank: __openapi_method(method_text)
    token: if rank == __openapi_methods().len() -> method_text.copy() else -> ""
    pattern_text: __openapi_text(fields, "pattern") ?? return Err(err)
    parsed: __openapi_pattern(pattern_text) ?? return Err(err)
    path: __openapi_text(fields, "path") ?? return Err(err)
    if path != parsed.path -> return Err(__openapi_fault("checked OpenAPI route path does not match its route pattern"))
    parameter_values: __openapi_array(fields, "parameters") ?? return Err(err)
    parameters := [__OpenAPIParameter]{}
    loop item in parameter_values {
        parameters.push(__openapi_parameter(item) ?? return Err(err))
    }
    response_values: __openapi_array(fields, "responses") ?? return Err(err)
    responses := [__OpenAPIResponse]{}
    loop item in response_values {
        responses.push(__openapi_response(item) ?? return Err(err))
    }
    if responses.len() == 0 -> return Err(__openapi_fault("checked OpenAPI route contract has no responses"))
    security_values: __openapi_array(fields, "security") ?? return Err(err)
    security := [__OpenAPISecurity]{}
    loop item in security_values {
        security.push(__openapi_security(item) ?? return Err(err))
    }
    operation_id: __openapi_text(fields, "operation_id") ?? return Err(err)
    body_value: __openapi_field(fields, "request_body") ?? return Err(err)
    body := __OpenAPIBody?{None}
    if !(body_value == Dyn.Null) -> body = Val(__openapi_body(body_value) ?? return Err(err))
    _: __openapi_text(fields, "provenance") ?? return Err(err)
    summary: if __openapi_optional_text(fields, "summary") == {
        .Ok(text) -> text
        .Err(fault) -> { return Err(fault) }
    }
    registered: __openapi_pattern(pattern) ?? return Err(err)
    if method != method_text || registered.key != parsed.key -> return Err(__openapi_fault("checked OpenAPI contract does not match route `{method} {pattern}`"))
    route := __OpenAPIRoute{method: rank, token: token, path: parsed.path, names: parsed.names, catch_alls: parsed.catch_alls, operation_id: operation_id, summary: summary, parameters: parameters, body: body, responses: responses, security: security}
    if route.operation_id == "" -> route.operation_id = __openapi_operation_id(__openapi_operation_method(route), route.path)
    Ok(route)
}

// jet_openapi_operation_id_for_path: FNV-1a 64 of
// `jet-openapi-operation-v1:<method>\0<path>`, the method as
// __openapi_operation_method names it.
__openapi_operation_id: fn(name: String, path: String) -> String Never! {
    bytes := "jet-openapi-operation-v1:".bytes()
    loop byte in name.bytes() -> bytes.push(byte)
    bytes.push(U8{0})
    loop byte in path.bytes() -> bytes.push(byte)
    hash := U64{14695981039346656037}
    loop byte in bytes {
        hash = (hash.bit_xor(U64{Int.from_u8(byte)})).wrapping_mul(U64{1099511628211})
    }
    out := [U8]{}
    loop index in 0..<16 {
        out.push(__app_hex_digit(Int.from_u64((hash >> (60 - index * 4)).bit_and(U64{15}))))
    }
    "jet_{name}_{String.from_bytes(out) ?? ""}"
}

__openapi_compare_lists: fn(left: [String], right: [String]) -> Ordering Never! {
    common: if left.len() < right.len() -> left.len() else -> right.len()
    loop index in 0..<common {
        if left[index] != right[index] -> return left[index] <=> right[index]
    }
    left.len() <=> right.len()
}

__openapi_canonical: fn(route: __OpenAPIRoute) -> __OpenAPIRoute Never! {
    out := route
    out.parameters.sort_by(fn(left: __OpenAPIParameter, right: __OpenAPIParameter) {
        if left.location != right.location -> return left.location <=> right.location
        left.name <=> right.name
    })
    out.responses.sort_by(fn(left: __OpenAPIResponse, right: __OpenAPIResponse) {
        if left.status != right.status -> return left.status <=> right.status
        left.description <=> right.description
    })
    security := [__OpenAPISecurity]{}
    loop requirement in out.security {
        scopes := requirement.scopes.copy()
        scopes.sort()
        security.push(__OpenAPISecurity{scheme: requirement.scheme.copy(), scopes: scopes})
    }
    security.sort_by(fn(left: __OpenAPISecurity, right: __OpenAPISecurity) {
        if left.scheme != right.scheme -> return left.scheme <=> right.scheme
        __openapi_compare_lists(left.scopes, right.scopes)
    })
    out.security = security
    out
}

// JetOpenApiDocument::with_openapi then ::json, with no security schemes: a mux
// declares none.
__openapi_document: fn(inputs: [__OpenAPIRoute], title: String, version: String) -> String __OpenAPIFault! {
    routes := [__OpenAPIRoute]{}
    loop input in inputs -> routes.push(__openapi_canonical(input))
    routes.sort_by(fn(left: __OpenAPIRoute, right: __OpenAPIRoute) {
        if left.path != right.path -> return left.path <=> right.path
        if left.method != right.method -> return left.method <=> right.method
        if left.token != right.token -> return left.token <=> right.token
        left.operation_id <=> right.operation_id
    })
    if title == "" || version == "" -> return Err(__openapi_fault("OpenAPI info title and version must not be empty"))
    errors := [String]{}
    keys := [String]{}
    operation_ids := [String]{}
    loop route in routes {
        if !route.path.starts_with("/") || route.path.contains("?") || route.path.contains("#") -> errors.push("invalid OpenAPI route path `{route.path}` for canonical pattern `{route.path}`")
        if route.operation_id == "" -> errors.push("OpenAPI route `{route.path}` needs an operationId")
        if operation_ids.contains(route.operation_id) {
            errors.push("duplicate OpenAPI operationId `{route.operation_id}`")
        } else {
            operation_ids.push(route.operation_id.copy())
        }
        key: "{__openapi_route_method(route)} {route.path}"
        if keys.contains(key) {
            errors.push("duplicate OpenAPI route `{key}`")
        } else {
            keys.push(key.copy())
        }
        schema_errors := [String]{}
        parameter_keys := [String]{}
        declared := [String]{}
        loop parameter in route.parameters {
            location: __openapi_locations()[parameter.location]
            parameter_key: "{location}:{parameter.name}"
            if parameter_keys.contains(parameter_key) {
                schema_errors.push("parameter: duplicate {location} parameter `{parameter.name}`")
            } else {
                parameter_keys.push(parameter_key.copy())
            }
            if parameter.location == 0 {
                declared.push(parameter.name.copy())
                if !route.names.contains(parameter.name) -> schema_errors.push(__openapi_problem(parameter.name, "path parameter is not present in the route template"))
                if parameter.catch_all != route.catch_alls.contains(parameter.name) -> schema_errors.push(__openapi_problem(parameter.name, "path parameter catch-all fact disagrees with the canonical route pattern"))
            }
            loop problem in parameter.schema_errors -> schema_errors.push(problem.copy())
            if parameter.name == "" -> schema_errors.push("parameter: parameter name must not be empty")
            if parameter.location == 0 && !parameter.required -> schema_errors.push(__openapi_problem(parameter.name, "path parameters are always required"))
        }
        template := route.names.copy()
        template.sort()
        loop name in template {
            if !declared.contains(name) -> schema_errors.push(__openapi_problem(name, "route template parameter has no parameter fact"))
        }
        if route.body == .Val(body) {
            loop problem in body.schema_errors -> schema_errors.push(problem.copy())
            if body.content_type == "" -> schema_errors.push("requestBody: request body content type must not be empty")
        }
        statuses := [Int]{}
        loop response in route.responses {
            if response.status < 100 || response.status > 599 -> errors.push("response status {response.status} is out of range")
            if statuses.contains(response.status) {
                errors.push("route `{key}` declares response status {response.status} more than once")
            } else {
                statuses.push(response.status)
            }
            loop problem in response.schema_errors -> schema_errors.push(problem.copy())
        }
        if route.responses.len() == 0 -> errors.push("route `{key}` must declare a response")
        loop requirement in route.security {
            if requirement.scheme == "" {
                errors.push("route `{key}` has an empty security scheme")
            } else {
                errors.push("route `{key}` references unknown security scheme `{requirement.scheme}`")
            }
        }
        loop problem in schema_errors -> errors.push(problem.copy())
    }
    if errors.len() > 0 -> return Err(__openapi_fault(errors.join("; ")))
    paths := [String]{}
    additional_operations := false
    index := 0
    loop index < routes.len() {
        path: routes[index].path.copy()
        methods := [String]{}
        additional := [String]{}
        loop index < routes.len() && routes[index].path == path {
            if __openapi_additional_method(routes[index]) {
                // Keyed by the method as sent: CONNECT, or the custom token.
                additional.push("{__app_json_string(__openapi_route_method(routes[index]))}:{__openapi_route_json(routes[index])}")
            } else {
                methods.push("{__app_json_string(__openapi_methods()[routes[index].method])}:{__openapi_route_json(routes[index])}")
            }
            index += 1
        }
        if additional.len() > 0 {
            methods.push("\"additionalOperations\":{{{additional.join(",")}}}")
            additional_operations = true
        }
        paths.push("{__app_json_string(path)}:{{{methods.join(",")}}}")
    }
    openapi_version: if additional_operations -> "3.2.0" else -> "3.1.0"
    Ok("{{\"openapi\":\"{openapi_version}\",\"info\":{{\"title\":{__app_json_string(title)},\"version\":{__app_json_string(version)}}},\"paths\":{{{paths.join(",")}}}}}")
}

// jet_openapi_route_json and jet_openapi_parameter_json.
__openapi_route_json: fn(route: __OpenAPIRoute) -> String Never! {
    out := "{{\"operationId\":{__app_json_string(route.operation_id)}"
    if route.summary == .Val(summary) -> out = "{out},\"summary\":{__app_json_string(summary)}"
    if route.parameters.len() > 0 {
        rendered := [String]{}
        loop parameter in route.parameters {
            required: parameter.required || parameter.location == 0
            rendered.push("{{\"name\":{__app_json_string(parameter.name)},\"in\":{__app_json_string(__openapi_locations()[parameter.location])},\"required\":{required},\"schema\":{parameter.schema}}}")
        }
        out = "{out},\"parameters\":[{rendered.join(",")}]"
    }
    if route.body == .Val(body) -> out = "{out},\"requestBody\":{{\"required\":{body.required},\"content\":{{{__app_json_string(body.content_type)}:{{\"schema\":{body.schema}}}}}}}"
    responses := [String]{}
    loop response in route.responses {
        rendered := "\"{response.status}\":{{\"description\":{__app_json_string(response.description)}"
        if response.schema == .Val(schema) {
            if response.content_type == .Val(content_type) -> rendered = "{rendered},\"content\":{{{__app_json_string(content_type)}:{{\"schema\":{schema}}}}}"
        }
        responses.push("{rendered}}}")
    }
    out = "{out},\"responses\":{{{responses.join(",")}}}"
    if route.security.len() > 0 {
        rendered := [String]{}
        loop requirement in route.security {
            scopes := [String]{}
            loop scope in requirement.scopes -> scopes.push(__app_json_string(scope))
            rendered.push("{{{__app_json_string(requirement.scheme)}:[{scopes.join(",")}]}}")
        }
        out = "{out},\"security\":[{rendered.join(",")}]"
    }
    "{out}}}"
}

value: fn(key: String) -[Browser]> String Never! { core.web.value(key) }

storage: fn() -> String Never! { "local" }

auth: fn(kind: String) -> Auth Never! { Auth{kind: kind, client_id: ""} }

auth_oauth: fn(auth: Auth, client_id: String) -> Auth Never! {
    Auth{kind: "oauth", client_id: client_id}
}

auth_routes: fn(auth: Auth) -> [String] Never! {
    if {
        auth.kind == "oauth" -> return [String]{"/auth/login", "/auth/callback", "/auth/logout"}
        else -> [String]{"/login", "/logout"}
    }
}

auth_show: fn(auth: Auth) -> String Never! { "{auth.kind}:{auth.client_id}" }

// Live bindings. `app` and `core.web` share this one registry. It lives in a
// process-wide runtime byte cell; every update reads the cell, edits the
// decoded registry and installs it only if the cell is unchanged, retrying
// otherwise, so concurrent callers never lose an update.
//
// The compiler checks `live`, `subscribe`, `push` and `invalidate` against
// their source function and lowers them to the `__live_*` helpers below.

// The binding's current state. The source re-runs when the binding has no
// result yet, was invalidated, or its poll interval has passed; the stored
// result changes only when the re-run's encoding differs.
state: fn<T: [Encode, Decode], E: [Encode, Decode]>(binding: Live<T, E>) -> Loadable<T, E> Never! {
    now: rt.clock_mono_ns()
    if live_current(binding.id, now) == .Val(text) {
        if live_value_state<T, E>(text) == .Val(current) -> return current
    }
    value: binding.run() ?? {
        if live_json.to_string<E>(err) == .Ok(encoded) -> live_store(binding.id, "err:{encoded}", now)
        return Loadable.Failed(err)
    }
    if live_json.to_string<T>(value) == .Ok(encoded) -> live_store(binding.id, "ok:{encoded}", now)
    Loadable.Loaded(value)
}

// `changes` counts stored results that differed from the one before;
// `ws_pushes` counts the invalidations published to the WebSocket live hub.
live_stats: fn() -> String Never! {
    registry: live_decode(live_cell_load()) ?? return "LiveStats(error=live registry unavailable)"
    "LiveStats(queries={live_query_count(registry)}, limit={LIVE_MAX_QUERIES}, evictions={registry.evictions}, invalidations={registry.invalidations}, changes={registry.changes}, ws_pushes={registry.ws_pushes})"
}

// The live bindings of `registry`; app.sync's session records are not queries.
live_query_count: fn(registry: LiveRegistry) -> Int {
    count := 0
    loop record in registry.records {
        if record.source != LIVE_SYNC_SOURCE -> count += 1
    }
    count
}

// `live(source, args...)`: `args` are the encoded arguments.
__live_bind: fn<T: [Encode, Decode], E: [Encode, Decode]>(source: String, args: [String], run: &&fn() -> T E!) -> Live<T, E> Never! {
    Live<T, E>{id: live_register(source, live_key(args), 0), run: run}
}

// `subscribe(source, args..., every:)`: a binding polled every `every`.
__live_poll: fn<T: [Encode, Decode], E: [Encode, Decode]>(source: String, args: [String], every: Duration?, run: &&fn() -> T E!) -> Live<T, E> Never! {
    every_ns := 0
    if every == .Val(interval) && interval.ns > 0 -> every_ns = interval.ns
    Live<T, E>{id: live_register(source, live_key(args), every_ns), run: run}
}

// `push(source, args..., value:)` stores `value` as that binding's result,
// registering the binding when nothing has read it yet.
__live_push: fn<T: Encode>(source: String, args: [String], value: T) Never! {
    encoded: live_json.to_string<T>(value) ?? return
    key: live_key(args)
    id: live_register(source, key, 0)
    live_store(id, "ok:{encoded}", -1)
}

// `invalidate(source, args...)`: exactly that argument list re-runs.
__live_invalidate: fn(source: String, args: [String]) Never! { live_invalidate(source, Val(live_key(args))) }

// `invalidate(source)`: every binding of `source` re-runs.
__live_invalidate_all: fn(source: String) Never! { live_invalidate(source, None) }

// One argument's part of a binding's identity.
__live_arg: fn<A: Encode>(value: A) -> String Never! { live_json.to_string<A>(value) ?? "_" }

sync: fn(key: String, data: String) -> String Never! {
    "{key}:{data}"
}

LIVE_MAX_QUERIES: 1024
LIVE_MAX_PAYLOAD: 4194304
// The registry source of app.sync's session records (Core/App/App.jet): a
// session keeps its generation and document as the record's value.
LIVE_SYNC_SOURCE: "app.sync"

live_cell_load: fn() -> [U8] { core.web.__live_load() }

live_cell_replace: fn(expected: [U8], replacement: &&[U8]) -> Bool { core.web.__live_replace(expected, replacement) }

live_key: fn(args: [String]) -> String { "[{args.join(",")}]" }

// The id of the binding named by `source` and `key`, registered when absent;
// a full registry evicts its oldest binding. Two registrations of one
// binding poll at the shorter interval. 0 when the registry is unavailable.
live_register: fn(source: String, key: String, every_ns: Int) -> Int {
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return 0
        found := 0
        loop index in 0..<registry.records.len() {
            if registry.records[index].source != source || registry.records[index].key != key -> next
            found = registry.records[index].id
            current: registry.records[index].every_ns
            if every_ns <= 0 || (current > 0 && current <= every_ns) -> return found
            registry.records[index].every_ns = every_ns
        }
        if found == 0 {
            found = registry.next_id + 1
            registry.next_id = found
            if live_query_count(registry) >= LIVE_MAX_QUERIES {
                kept := [LiveRecord]{}
                evicted := false
                loop record in registry.records {
                    if !evicted && record.source != LIVE_SYNC_SOURCE {
                        evicted = true
                        next
                    }
                    kept.push(record)
                }
                registry.records = kept
                registry.evictions += 1
            }
            // copy: a lost race retries with the same source and key
            registry.records.push(LiveRecord{id: found, source: source.copy(), key: key.copy(), value: "", dirty: false, every_ns: every_ns, ran_ns: 0})
        }
        if live_cell_replace(seen, live_encode(registry)) -> return found
    }
}

// The stored result of binding `id` when it is current at `now`; None when
// the binding must re-run.
live_current: fn(id: Int, now: Int) -> String? {
    registry: live_decode(live_cell_load()) ?? return None
    index: live_index(registry, id) ?? return None
    record: registry.records[index]
    if record.value == "" || record.dirty -> return None
    if record.every_ns > 0 && now - record.ran_ns >= record.every_ns -> return None
    Val(record.value.copy()) // copy: the registry snapshot is dropped here
}

live_value_state: fn<T: [Encode, Decode], E: [Encode, Decode]>(text: String) -> Loadable<T, E>? {
    if text.starts_with("ok:") {
        value: live_json.decode<T>(text.slice(3, text.len())) ?? return None
        return Val(Loadable.Loaded(value))
    }
    if !text.starts_with("err:") -> return None
    reason: live_json.decode<E>(text.slice(4, text.len())) ?? return None
    Val(Loadable.Failed(reason))
}

// Stores `value` as binding `id`'s result, clean; a value that differs from
// the stored one counts as a change. `now` < 0 keeps the last run time.
live_store: fn(id: Int, value: String, now: Int) {
    if value.len() > LIVE_MAX_PAYLOAD -> return
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return
        index: live_index(registry, id) ?? return
        if registry.records[index].value != value {
            registry.records[index].value = value.copy() // copy: a lost race retries with the same value
            registry.changes += 1
        }
        registry.records[index].dirty = false
        if now >= 0 -> registry.records[index].ran_ns = now
        if live_cell_replace(seen, live_encode(registry)) -> return
    }
}

// Marks dirty every binding of `source`, or only the one whose key is `key`,
// then publishes the invalidation to the WebSocket live hub:
// topic `live:<source>`, a JSON event every joined server connection receives
// and a connection that joins later gets replayed as the topic's latest.
live_invalidate: fn(source: String, key: String?) {
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return
        hit := 0
        loop index in 0..<registry.records.len() {
            if registry.records[index].source != source -> next
            if key == .Val(only) && registry.records[index].key != only -> next
            registry.records[index].dirty = true
            hit += 1
        }
        if hit == 0 -> return
        registry.invalidations += hit
        registry.ws_pushes += 1
        if live_cell_replace(seen, live_encode(registry)) {
            key_json: if key == .Val(only) -> __app_json_string(only) else -> "null"
            core.web.__live_publish("live:{source}", "{{\"live\":\"invalidate\",\"source\":{__app_json_string(source)},\"key\":{key_json},\"invalidations\":{registry.invalidations}}}")
            return
        }
    }
}

live_index: fn(registry: LiveRegistry, id: Int) -> Int? {
    loop index in 0..<registry.records.len() {
        if registry.records[index].id == id -> return Val(index)
    }
    None
}

// The cell holds the registry as length-prefixed fields: next id,
// invalidations, changes, evictions, WebSocket pushes, then seven fields per
// binding.
live_encode: fn(registry: LiveRegistry) -> [U8] {
    out := [U8]{}
    live_put(out, "{registry.next_id}")
    live_put(out, "{registry.invalidations}")
    live_put(out, "{registry.changes}")
    live_put(out, "{registry.evictions}")
    live_put(out, "{registry.ws_pushes}")
    loop record in registry.records {
        live_put(out, "{record.id}")
        live_put(out, record.source)
        live_put(out, record.key)
        live_put(out, record.value)
        live_put(out, if record.dirty -> "1" else -> "0")
        live_put(out, "{record.every_ns}")
        live_put(out, "{record.ran_ns}")
    }
    out
}

live_put: fn(out: &[U8], text: String) {
    loop byte in "{text.len()}:".bytes() -> out.push(byte)
    loop byte in text.bytes() -> out.push(byte)
}

// An empty cell is the empty registry; None when the bytes are malformed.
live_decode: fn(raw: [U8]) -> LiveRegistry? {
    if raw.len() == 0 -> return Val(LiveRegistry{next_id: 0, invalidations: 0, changes: 0, evictions: 0, ws_pushes: 0, records: [LiveRecord]{}})
    fields: live_fields(raw) ?? return None
    if fields.len() < 5 || (fields.len() - 5) % 7 != 0 -> return None
    next_id: Int.parse(fields[0]) ?? return None
    invalidations: Int.parse(fields[1]) ?? return None
    changes: Int.parse(fields[2]) ?? return None
    evictions: Int.parse(fields[3]) ?? return None
    ws_pushes: Int.parse(fields[4]) ?? return None
    records := [LiveRecord]{}
    at := 5
    loop at < fields.len() {
        id: Int.parse(fields[at]) ?? return None
        every_ns: Int.parse(fields[at + 5]) ?? return None
        ran_ns: Int.parse(fields[at + 6]) ?? return None
        records.push(LiveRecord{id: id, source: fields[at + 1], key: fields[at + 2], value: fields[at + 3], dirty: fields[at + 4] == "1", every_ns: every_ns, ran_ns: ran_ns})
        at += 7
    }
    Val(LiveRegistry{next_id: next_id, invalidations: invalidations, changes: changes, evictions: evictions, ws_pushes: ws_pushes, records: records})
}

// The length-prefixed fields (`<decimal byte length>:<bytes>`) of `raw`.
live_fields: fn(raw: [U8]) -> [String]? {
    fields := [String]{}
    at := 0
    loop at < raw.len() {
        length := 0
        loop {
            if at >= raw.len() -> return None
            n: Int.from_u8(raw[at])
            at += 1
            if n == 58 -> break
            if n < 48 || n > 57 -> return None
            length = length * 10 + n - 48
        }
        if at + length > raw.len() -> return None
        fields.push(String.from_bytes(raw.slice(at, at + length)) ?? return None)
        at += length
    }
    Val(fields)
}

