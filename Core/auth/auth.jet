
package {
    name: "core.auth"
    version: "0.0.1"
    edition: "2026"
    description: "Sessions, passwords, magic links, OAuth, JWT, PASETO."
    license: "MIT"
    outputs: {
        auth: .Library{ entry: auth }
    }
}
use core as core
use core.crypto as crypto
use core.crypto.expert as expert
use core.encoding as encoding
use core.encoding.json as json
use core.time as time
// core.auth — closed token verification and session cookies.
//
// JWT verification is strict HS256 with exact NumericDate claims. Password
// hashes are provider-owned values verified by the auth provider. The direct
// PASETO surface verifies v4.public with the local Ed25519 primitive; the
// extended footer/implicit form is a host provider call.
#Error
pub enum AuthError {
    Rejected
    Expired
    Malformed
    Unavailable
}

pub struct Claims {
    pub issuer: String
    pub audience: String
    pub subject: String
    pub expires_at: Int
    pub json: String
}

pub struct Session {
    pub id: String
    pub user_id: String
    pub cookie: String
    pub expires_at: Int
}

pub struct Auth {
    pub issuer: String
}

pub fn verify_jwt(token: String, key: [U8], audience: String, issuer: String, clock_skew: Duration) -[Time]> Claims AuthError! {
    token_raw :: (~token).bytes()
    if token_raw.len() == 0 || token_raw.len() > 1048576 -> return Err(AuthError.Malformed)
    if key.len() < 32 -> return Err(AuthError.Rejected)
    if clock_skew.ns < 0 -> return Err(AuthError.Malformed)

    parts :: split_dot_optional(token) ?? return Err(AuthError.Malformed)
    if parts.len() != 3 || parts[0].len() == 0 || parts[1].len() == 0 || parts[2].len() == 0 {
        return Err(AuthError.Malformed)
    }
    header_b :: b64url(parts[0]) ?? return Err(AuthError.Malformed)
    payload_b :: b64url(parts[1]) ?? return Err(AuthError.Malformed)
    sig_b :: b64url(parts[2]) ?? return Err(AuthError.Malformed)
    if sig_b.len() != 32 -> return Err(AuthError.Malformed)
    header :: String.from_bytes(header_b) ?? return Err(AuthError.Malformed)
    payload :: String.from_bytes(payload_b) ?? return Err(AuthError.Malformed)
    header_tree :: json.parse(header) ?? return Err(AuthError.Malformed)
    payload_tree :: json.parse(payload) ?? return Err(AuthError.Malformed)
    if !json_object(header_tree) || !json_object(payload_tree) -> return Err(AuthError.Malformed)
    alg :: json_text(header_tree, "alg") ?? return Err(AuthError.Malformed)
    if alg != "HS256" -> return Err(AuthError.Unavailable)

    mac_src :: "{parts[0]}.{parts[1]}"
    expect :: crypto.hmac_sha256(key, mac_src.bytes()) ?? return Err(AuthError.Rejected)
    equal :: crypto.constant_time_equal_bytes(expect, sig_b) ?? return Err(AuthError.Rejected)
    if equal == false -> return Err(AuthError.Rejected)

    exp :: json_required_int(payload_tree, "exp") ?? return Err(AuthError.Malformed)
    nbf := 0
    if json_has(payload_tree, "nbf") {
        nbf = json_required_int(payload_tree, "nbf") ?? return Err(AuthError.Malformed)
    }
    if json_has(payload_tree, "iat") {
        _ :: json_required_int(payload_tree, "iat") ?? return Err(AuthError.Malformed)
    }
    iss :: json_optional_text(payload_tree, "iss") ?? return Err(AuthError.Malformed)
    aud_text :: json_audience_text(payload_tree, "aud") ?? return Err(AuthError.Malformed)
    sub :: json_optional_text(payload_tree, "sub") ?? return Err(AuthError.Malformed)
    if audience.len() > 0 && !json_audience_matches(payload_tree, "aud", audience) -> return Err(AuthError.Rejected)
    now :: time.unix_ns()
    exp_ns :: unix_seconds_ns(exp) ?? return Err(AuthError.Malformed)
    if exp <= 0 -> return Err(AuthError.Expired)
    expiry :: add_leeway(exp_ns, clock_skew.ns) ?? return Err(AuthError.Malformed)
    if now >= expiry -> return Err(AuthError.Expired)
    if json_has(payload_tree, "nbf") {
        nbf_ns :: unix_seconds_ns(nbf) ?? return Err(AuthError.Malformed)
        earliest :: subtract_leeway(nbf_ns, clock_skew.ns) ?? return Err(AuthError.Malformed)
        if now < earliest -> return Err(AuthError.Rejected)
    }
    claims_aud := aud_text
    if audience.len() > 0 -> claims_aud = audience
    Ok(Claims{issuer: iss, audience: claims_aud, subject: sub, expires_at: exp, json: payload})
}

pub fn verify_paseto(token: String, key: [U8], audience: String) -[Time]> Claims AuthError! {
    token_raw :: (~token).bytes()
    if token_raw.len() == 0 || token_raw.len() > 1048576 -> return Err(AuthError.Malformed)
    if key.len() != 32 || audience.len() == 0 || has_control(audience) || audience != trim_ascii(audience) {
        return Err(AuthError.Rejected)
    }
    parts :: split_dot_optional(token) ?? return Err(AuthError.Malformed)
    if parts.len() < 3 || parts.len() > 4 || parts[0] != "v4" || parts[1] != "public" {
        return Err(AuthError.Unavailable)
    }
    body :: b64url(parts[2]) ?? return Err(AuthError.Malformed)
    if body.len() < 64 -> return Err(AuthError.Malformed)
    footer := [U8]{}
    if parts.len() == 4 {
        footer = b64url(parts[3]) ?? return Err(AuthError.Malformed)
    }
    message_len := body.len() - 64
    message :: slice_u8(body, 0, message_len)
    signature :: slice_u8(body, message_len, body.len())
    signed :: paseto_pae(message, footer)
    verified := false
    #Unsafe("auth PASETO v4.public verification uses the fixed Ed25519 primitive") {
        verified = expert.ed25519_verify_strict(key, signed, signature) ?? return Err(AuthError.Rejected)
    }
    if !verified -> return Err(AuthError.Rejected)
    payload :: String.from_bytes(message) ?? return Err(AuthError.Malformed)
    payload_tree :: json.parse(payload) ?? return Err(AuthError.Malformed)
    if !json_object(payload_tree) -> return Err(AuthError.Malformed)
    exp :: json_required_int(payload_tree, "exp") ?? return Err(AuthError.Malformed)
    nbf := 0
    if json_has(payload_tree, "nbf") {
        nbf = json_required_int(payload_tree, "nbf") ?? return Err(AuthError.Malformed)
    }
    if json_has(payload_tree, "iat") {
        _ :: json_required_int(payload_tree, "iat") ?? return Err(AuthError.Malformed)
    }
    iss :: json_optional_text(payload_tree, "iss") ?? return Err(AuthError.Malformed)
    sub :: json_optional_text(payload_tree, "sub") ?? return Err(AuthError.Malformed)
    if !json_audience_matches(payload_tree, "aud", audience) -> return Err(AuthError.Rejected)
    now :: time.unix_ns()
    exp_ns :: unix_seconds_ns(exp) ?? return Err(AuthError.Malformed)
    if exp <= 0 || now >= exp_ns -> return Err(AuthError.Expired)
    if json_has(payload_tree, "nbf") {
        nbf_ns :: unix_seconds_ns(nbf) ?? return Err(AuthError.Malformed)
        if now < nbf_ns -> return Err(AuthError.Rejected)
    }
    Ok(Claims{issuer: iss, audience: audience, subject: sub, expires_at: exp, json: payload})
}


pub fn register_user(name: String, password: String) -[Rand, DB, Time]> Session AuthError! {
    if !valid_identity(name) || !valid_password_hash(password) -> return Err(AuthError.Rejected)
    core.auth.register_user(~name, ~password) ?? return Err(AuthError.Rejected)
    ttl := 86400
    now :: host_unix_s()
    native :: core.auth.password_login(~name, ~password, now * 1000, ttl * 1000) ?? return Err(AuthError.Unavailable)
    Ok(Session{
        id: core.auth.session_id(native),
        user_id: core.auth.session_user(native),
        cookie: core.auth.session_cookie(native),
        expires_at: now + ttl,
    })
}
 
pub fn password_login(name: String, password: String, ttl_s: Int, flags: Int) -[Rand, DB, Time]> Session AuthError! {
    if !valid_identity(name) || !valid_password_hash(password) -> return Err(AuthError.Rejected)
    if !valid_ttl(ttl_s) -> return Err(AuthError.Malformed)
    if flags != 0 -> return Err(AuthError.Malformed)
    now :: host_unix_s()
    native :: core.auth.password_login(~name, ~password, now * 1000, ttl_s * 1000) ?? return Err(AuthError.Rejected)
    user :: core.auth.session_user(native)
    cookie :: core.auth.session_cookie(native)
    id :: core.auth.session_id(native)
    Ok(Session{id: id, user_id: user, cookie: cookie, expires_at: now + ttl_s})
}


pub fn oauth_begin(provider: String) -[DB]> String AuthError! {
    if provider.len() == 0 || provider.len() > 128 || has_control(provider) || provider != trim_ascii(provider) -> return Err(AuthError.Malformed)
    state :: core.auth.oauth_begin(provider) ?? return Err(AuthError.Unavailable)
    Ok(state)
}

pub fn oauth_finish(state: String, assertion: String, ttl_s: Int, flags: Int) -[DB, Time]> Session AuthError! {
    if state.len() == 0 || assertion.len() == 0 -> return Err(AuthError.Malformed)
    if !valid_ttl(ttl_s) -> return Err(AuthError.Malformed)
    if has_control(state) || has_control(assertion) -> return Err(AuthError.Malformed)
    if flags != 0 -> return Err(AuthError.Malformed)
    now :: host_unix_s()
    native :: core.auth.oauth_finish(state, assertion, now * 1000, ttl_s * 1000) ?? return Err(AuthError.Unavailable)
    Ok(Session{
        id: core.auth.session_id(native),
        user_id: core.auth.session_user(native),
        cookie: core.auth.session_cookie(native),
        expires_at: now + ttl_s,
    })
}

pub fn magic_link_issue(email: String, ttl_s: Int, flags: Int) -[DB, Time]> String AuthError! {
    if !valid_email(email) -> return Err(AuthError.Malformed)
    if !valid_ttl(ttl_s) -> return Err(AuthError.Malformed)
    if flags != 0 -> return Err(AuthError.Malformed)
    now :: host_unix_s()
    token :: core.auth.magic_link_issue(email, now * 1000, ttl_s * 1000) ?? return Err(AuthError.Unavailable)
    Ok(token)
}

pub fn magic_link_consume(token: String, ttl_s: Int, flags: Int) -[DB, Time]> Session AuthError! {
    if token.len() == 0 || has_control(token) -> return Err(AuthError.Rejected)
    if !valid_ttl(ttl_s) -> return Err(AuthError.Malformed)
    if flags != 0 -> return Err(AuthError.Malformed)
    now :: host_unix_s()
    native :: core.auth.magic_link_consume(token, now * 1000, ttl_s * 1000) ?? return Err(AuthError.Rejected)
    user :: core.auth.session_user(native)
    cookie :: core.auth.session_cookie(native)
    id :: core.auth.session_id(native)
    Ok(Session{id: id, user_id: user, cookie: cookie, expires_at: now + ttl_s})
}

pub fn session_validate(cookie: String, ttl_s: Int) -[DB, Time]> Session AuthError! {
    if cookie.len() == 0 || has_control(cookie) -> return Err(AuthError.Rejected)
    if !valid_ttl(ttl_s) -> return Err(AuthError.Malformed)
    id :: session_id_from_cookie(cookie) ?? return Err(AuthError.Malformed)
    now :: host_unix_s()
    native :: core.auth.session_validate(id, now * 1000) ?? return Err(AuthError.Rejected)
    native_cookie :: core.auth.session_cookie(native)
    equal :: crypto.constant_time_equal_bytes(cookie.bytes(), native_cookie.bytes()) ?? return Err(AuthError.Rejected)
    if equal == false {
        return Err(AuthError.Rejected)
    }
    Ok(Session{
        id: core.auth.session_id(native),
        user_id: core.auth.session_user(native),
        cookie: native_cookie,
        expires_at: now + ttl_s,
    })
}
fn session_id_from_cookie(cookie: String) -> String? {
    prefix := "jet_session="
    if !starts(~cookie, prefix) -> return None
    cookie_raw :: (~cookie).bytes()
    raw :: slice_u8(cookie_raw, prefix.bytes().len(), cookie_raw.len())
    semi := index_byte(raw, (U8{59}))
    if semi < 1 -> return None
    attrs :: slice_bytes(raw, semi, raw.len()) ?? return None
    if attrs != "; HttpOnly; Secure; SameSite=Lax; Path=/" -> return None
    id :: slice_bytes(raw, 0, semi) ?? return None
    if !valid_session_id(id) -> return None
    Val(id)
}


pub fn session_user(session: Session) -> String Never! { session.user_id }

pub fn session_cookie(session: Session) -> String Never! { session.cookie }

pub fn session_id(session: Session) -> String Never! { session.id }
pub fn session_show(session: Session) -> String Never! {
    cookie_len :: session.cookie.bytes().len()
    return "Session(id=<redacted>, user={session.user_id}, exp={session.expires_at}, cookie_len={cookie_len})"
}



fn b64url(text: String) -> [U8]? {
    raw :: (~text).bytes()
    if raw.len() == 0 || raw.len() %% 4 == 1 -> return None
    decode_url_local(text)
}

fn decode_url_local(text: String) -> [U8]? {
    // JWT/PASETO use the unpadded RFC 4648 URL alphabet. Reject padding,
    // non-canonical trailing bits, and lengths that cannot form whole bytes.
    alphabet :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    ab :: alphabet.bytes()
    val := [Int]{}
    loop i in 0..<256 -> &val.push(-1)
    loop i in 0..<ab.len() -> val[Int.from_u8(ab[i])] = i
    out := [U8]{}
    acc := 0
    bits := 0
    loop b in text.bytes() {
        n :: b
        if n == 61 -> return None
        v :: val[Int.from_u8(n)]
        if v < 0 -> return None
        acc = (acc << 6) | v
        bits = bits + 6
        if bits >= 8 {
            bits = bits - 8
            &out.push(to_u8(acc >> bits))
            if bits == 0 {
                acc = 0
            } else {
                acc = acc & ((1 << bits) - 1)
            }
        }
    }
    if bits > 0 && (acc & ((1 << bits) - 1)) != 0 -> return None
    Val(out)
}

fn json_object(tree: encoding.DataTree) -> Bool Never! {
    if tree == {
        .Object(_) -> return true
        else -> return false
    }
}

fn json_text(tree: encoding.DataTree, key: String) -> String? {
    value :: &tree.field(key) ?? return None
    text :: value.text() ?? return None
    Val(text)
}

fn json_optional_text(tree: encoding.DataTree, key: String) -> String? {
    value :: &tree.field(key) ?? return Val("")
    text :: value.text() ?? return None
    Val(text)
}
fn json_has(tree: encoding.DataTree, key: String) -> Bool Never! {
    if &tree.field(key) == {
        .Ok(_) -> return true
        .Err(_) -> return false
    }
}

fn json_audience_text(tree: encoding.DataTree, key: String) -> String? {
    value :: &tree.field(key) ?? return None
    if value == {
        .Text(text) -> return Val(text)
        .Array(items) -> {
            if items.len() == 0 -> return None
            loop item in items {
                text :: item.text() ?? return None
                return Val(text)
            }
            return None
        }
        else -> return None
    }
}

fn json_audience_matches(tree: encoding.DataTree, key: String, expected: String) -> Bool Never! {
    value :: &tree.field(key) ?? return false
    if value == {
        .Text(text) -> return text == expected
        .Array(items) -> {
            if items.len() == 0 -> return false
            loop item in items {
                text :: item.text() ?? return false
                if text == expected -> return true
            }
            return false
        }
        else -> false
    }
}

fn json_required_int(tree: encoding.DataTree, key: String) -> Int? {
    value :: &tree.field(key) ?? return None
    number :: value.int() ?? return None
    Val(number)
}


fn unix_seconds_ns(seconds: Int) -> Int? {
    if seconds > 9223372036 || seconds < -9223372036 -> return None
    Val(seconds * 1000000000)
}

fn add_leeway(value: Int, leeway: Int) -> Int? {
    if leeway < 0 || value > 9223372036854775807 - leeway -> return None
    Val(value + leeway)
}

fn subtract_leeway(value: Int, leeway: Int) -> Int? {
    if leeway < 0 || value < -9223372036854775808 + leeway -> return None
    Val(value - leeway)
}

fn split_dot_optional(text: String) -> [String]? {
    out := [String]{}
    cur := [U8]{}
    loop b in text.bytes() {
        if b == (U8{46}) {
            part :: String.from_bytes(cur) ?? return None
            &out.push(part)
            cur = [U8]{}
        } else { &cur.push(b) }
    }
    part :: String.from_bytes(cur) ?? return None
    &out.push(part)
    Val(out)
}


fn contains(text: String, needle: String) -> Bool Never! { index_of(text, needle) >= 0 }

fn index_of(text: String, needle: String) -> Int Never! {
    hay :: text.bytes()
    nd :: needle.bytes()
    if nd.len() == 0 -> return 0
    if nd.len() > hay.len() -> return -1
    loop i in 0..<(hay.len() - nd.len() + 1) {
        ok := true
        loop j in 0..<nd.len() {
            if hay[i + j] != nd[j] -> ok = false
        }
        if ok -> return i
    }
    -1
}

fn starts(text: String, prefix: String) -> Bool Never! { index_of(text, prefix) == 0 }

fn drop_prefix(text: String, n: Int) -> String? {
    raw :: text.bytes()
    if n < 0 || n > raw.len() -> return None
    slice_bytes(raw, n, raw.len())
}

fn slice_bytes(raw: [U8], start: Int, end: Int) -> String? {
    if start < 0 || end < start || end > raw.len() -> return None
    out := [U8]{}
    i := start
    loop {
        if i >= end {
            text :: String.from_bytes(out) ?? return None
            return Val(text)
        }
        &out.push(raw[i])
        i = i + 1
    }
}

fn slice_u8(bytes: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i >= bytes.len() -> return ~out
        &out.push(bytes[i])
        i = i + 1
    }
}

fn parse_int(text: String) -> Int? {
    n := 0
    any := false
    loop b in text.bytes() {
        d :: Int.from_u8(b)
        if d < 48 || d > 57 -> return None
        digit := d - 48
        if n > (9223372036854775807 - digit) /% 10 -> return None
        n = n * 10 + digit
        any = true
    }
    if !any -> return None
    Val(n)
}
fn valid_ttl(ttl_s: Int) -> Bool Never! {
    ttl_s >= 1 && ttl_s <= 315360000
}

fn valid_session_id(text: String) -> Bool Never! {
    raw := text.bytes()
    if raw.len() != 69 || !starts(text, "sess-") -> return false
    loop i in 5..<raw.len() {
        b :: raw[i]
        n :: Int.from_u8(b)
        if !((n >= 48 && n <= 57) || (n >= 97 && n <= 102)) -> return false
    }
    true
}
fn valid_identity(text: String) -> Bool Never! {
    if text.len() == 0 || text.len() > 256 || has_control(text) || text != trim_ascii(text) -> return false
    true
}
fn valid_password_hash(text: String) -> Bool Never! {
    text.len() >= 8 && text.len() <= 4096 && !has_control(text) && text == trim_ascii(text)
}

fn valid_email(text: String) -> Bool Never! {
    if text.len() < 3 || text.len() > 512 || has_control(text) || text != trim_ascii(text) -> return false
    at := -1
    raw := text.bytes()
    loop i in 0..<raw.len() {
        if raw[i] == (U8{64}) {
            if at >= 0 -> return false
            at = i
        }
    }
    if at <= 0 || at >= raw.len() - 1 -> return false
    local :: slice_bytes(raw, 0, at) ?? return false
    domain :: slice_bytes(raw, at + 1, raw.len()) ?? return false
    if local.len() > 64 || domain.len() > 253 || starts(local, ".") || starts(domain, ".") || ends(local, ".") || ends(domain, ".") || contains(local, "..") || contains(domain, "..") -> return false
    loop b in local.bytes() {
        n :: Int.from_u8(b)
        if !((n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || contains_byte([U8]{33,35,36,37,38,39,42,43,45,47,61,63,94,95,96,123,124,125,126}, b) || b == (U8{46})) -> return false
    }
    loop label in split_dot_parts(domain) {
        if label.len() == 0 || label.len() > 63 || starts(label, "-") || ends(label, "-") -> return false
        loop b in label.bytes() {
            n :: Int.from_u8(b)
            if !((n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 45) -> return false
        }
    }
    true
}

fn trim_ascii(text: String) -> String Never! {
    raw :: text.bytes()
    start := 0
    end := raw.len()
    loop start < end {
        n :: Int.from_u8(raw[start])
        if n == 32 || n == 9 || n == 10 || n == 13 -> start = start + 1 else -> break
    }
    loop end > start {
        n :: Int.from_u8(raw[end - 1])
        if n == 32 || n == 9 || n == 10 || n == 13 -> end = end - 1 else -> break
    }
    slice_text(text, start, end)
}
fn slice_text(text: String, start: Int, end: Int) -> String Never! {
    slice_bytes(text.bytes(), start, end) ?? ""
}

fn split_dot_parts(text: String) -> [String] Never! {
    out := [String]{}
    raw := text.bytes()
    start := 0
    loop i in 0..<raw.len() {
        if raw[i] == (U8{46}) {
            &out.push(slice_text(text, start, i))
            start = i + 1
        }
    }
    &out.push(slice_text(text, start, raw.len()))
    out
}

fn contains_byte(values: [U8], value: U8) -> Bool Never! {
    loop item in values {
        if item == value -> return true
    }
    false
}

fn has_control(text: String) -> Bool Never! {
    loop b in text.bytes() {
        n :: Int.from_u8(b)
        if n < 32 || n == 127 -> return true
    }
    false
}

fn ends(text: String, suffix: String) -> Bool Never! {
    raw := text.bytes()
    tail := suffix.bytes()
    if tail.len() > raw.len() -> return false
    start := raw.len() - tail.len()
    loop i in 0..<tail.len() {
        if raw[start + i] != tail[i] -> return false
    }
    true
}
fn host_unix_s() -[Time]> Int Never! { time.unix_ns() /% 1000000000 }

fn index_byte(bytes: [U8], needle: U8) -> Int Never! {
    loop i in 0..<bytes.len() {
        if bytes[i] == needle -> return i
    }
    -1
}
fn paseto_pae(message: [U8], footer: [U8]) -> [U8] Never! {
    out := [U8]{}
    paseto_pae_len(&out, 4)
    paseto_pae_part(&out, "v4.public.".bytes())
    paseto_pae_part(&out, message)
    paseto_pae_part(&out, footer)
    paseto_pae_part(&out, [U8]{})
    out
}

fn paseto_pae_part(out: &[U8], bytes: [U8]) Never! {
    paseto_pae_len(&out, bytes.len())
    loop byte in bytes -> &out.push(byte)
}

fn paseto_pae_len(out: &[U8], value: Int) Never! {
    n := value
    loop _ in 0..<8 {
        &out.push(to_u8(n))
        n = n >> 8
    }
}

/// Low byte of `n`. The mask runs in `Int`, so a wide value never reaches the
/// checked `U8{}` conversion.
fn to_u8(n: Int) -> U8 Never! {
    v :: n & 255
    (U8{v})
}
