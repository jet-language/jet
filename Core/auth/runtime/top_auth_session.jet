// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:623
pub fn jet_auth_register_user(user_id: String, password_hash: String) -> () Err! {
    if !jet_auth_valid_identifier(user_id, 512) { return Err("user id is invalid") }
    if password_hash.trim().is_empty() || password_hash.len() > 4096 { return Err("password hash is invalid") }
    delivery_capability :: jet_auth_delivery_capability(user_id)
    // GATE #4565: kernel primitive
    #Unsafe("auth users are changed only under the store mutex; poison remains an unavailable-store error") {
        store := jet_auth_store().lock().map_err(fn(error) { "auth store is unavailable" })?
        if store.users.iter().any(fn(user) { user.user_id == user_id }) { return Err("user `{user_id}` already registered") }
        store.users.push(JetAuthUser{user_id: ^user_id, password_hash: ^password_hash, delivery_capability: ^delivery_capability})
        Ok(())
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:645
fn jet_auth_password_login(user_id: String, password_hash: String, now_ms: I64, ttl_ms: I64) -> JetAuthSession Err! {
    session :: jet_auth_session_value(user_id.clone(), now_ms, ttl_ms)?
    // GATE #4565: kernel primitive
    #Unsafe("credential lookup and session insertion are serialized under the auth store mutex") {
        store := jet_auth_store().lock().map_err(fn(error) { "auth store is unavailable" })?
        ok :: store.users.iter().any(fn(user) { user.user_id == user_id && jet_auth_constant_time_text_eq(user.password_hash, password_hash) })
        if !ok { return Err("invalid credentials") }
        store.sessions.push(session.clone())
        Ok(^session)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:669
fn jet_auth_session_validate(session_id: &String, now_ms: I64) -> JetAuthSession Err! {
    if !jet_auth_valid_session_id(session_id) { return Err("missing: session") }
    // GATE #4565: kernel primitive
    #Unsafe("lookup retained session while holding auth store lock; compare secret ID without early byte exit") {
        store :: jet_auth_store().lock().map_err(fn(error) { "auth store is unavailable" })?
        store.sessions.iter().find(fn(session) { jet_auth_constant_time_text_eq(session.id, session_id) }).cloned()
            .ok_or_else(fn() { "missing: session" }).and_then(fn(session) {
                if now_ms >= session.expires_at { Err("token expired") } else { Ok(^session) }
            })
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:694
fn jet_auth_magic_link_issue(user_id: String, now_ms: I64, ttl_ms: I64) -> String Err! {
    expires_at :: jet_auth_expiry(now_ms, ttl_ms)?
    if !jet_auth_valid_identifier(user_id, 512) { return Err("user id is invalid") }
    delivery_capability :: jet_auth_delivery_capability(user_id).ok_or_else(fn() { "magic link requires a delivery-capable identity" })?
    // GATE #4565: kernel primitive
    #Unsafe("bind token to registered delivery identity and insert atomically under store mutex") {
        store := jet_auth_store().lock().map_err(fn(error) { "auth store is unavailable" })?
        if !store.users.iter().any(fn(user) { user.user_id == user_id && user.delivery_capability.as_deref() == Val(delivery_capability.as_str()) }) {
            return Err("magic link requires a registered delivery identity")
        }
        token :: jet_auth_opaque_token("magic")?
        store.magic_tokens.push(JetAuthMagicToken{token: token.clone(), user_id: ^user_id, expires_at, delivery_capability: ^delivery_capability})
        Ok(^token)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:724
pub fn jet_auth_magic_link_consume(token: String, now_ms: I64, ttl_ms: I64) -> JetAuthSession Err! {
    _ :: jet_auth_expiry(now_ms, ttl_ms)?
    if !jet_auth_valid_identifier(token, 256) { return Err("token expired") }
    // GATE #4565: kernel primitive
    #Unsafe("consume token once only after identity validation and fresh entropy succeed, under auth store lock") {
        store := jet_auth_store().lock().map_err(fn(error) { "auth store is unavailable" })?
        idx :: store.magic_tokens.iter().position(fn(entry) { jet_auth_constant_time_text_eq(entry.token, token) && now_ms < entry.expires_at })
            .ok_or_else(fn() { "token expired" })?
        entry :: store.magic_tokens[idx].clone()
        user :: store.users.iter().find(fn(user) { user.user_id == entry.user_id }).ok_or_else(fn() { "magic link identity is no longer registered" })?
        if user.delivery_capability.as_deref() != Val(entry.delivery_capability.as_str()) { return Err("magic link delivery identity is unavailable") }
        id :: jet_auth_opaque_token("sess")?
        _ :: store.magic_tokens.remove(idx)
        expires_at :: jet_auth_expiry(now_ms, ttl_ms)?
        session :: JetAuthSession{id: id.clone(), user_id: ^entry.user_id, expires_at, cookie: jet_auth_session_cookie_mint(id)}
        store.sessions.push(session.clone())
        Ok(^session)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:763
fn jet_auth_oauth_begin(provider: String) -> String Err! {
    _ :: jet_auth_oauth_config(provider)?
    now_ms :: jet_auth_now_ms()?
    expires_at :: now_ms.checked_add(10 * 60 * 1000).ok_or_else(fn() { "OAuth state lifetime is out of range" })?
    state :: jet_auth_opaque_token("oauth")?
    // The returned state doubles as OIDC nonce in the provider request.
    nonce :: state.clone()
    // GATE #4565: kernel primitive
    #Unsafe("prune and bound pending OAuth state under the one process store mutex") {
        store := jet_auth_store().lock().map_err(fn(error) { "auth store is unavailable" })?
        store.oauth_states.retain(fn(entry) { entry.expires_at > now_ms })
        if store.oauth_states.len() >= 256 { _ :: store.oauth_states.remove(0) }
        store.oauth_states.push(JetAuthOAuthState{state: state.clone(), provider: ^provider, nonce: ^nonce, expires_at})
        Ok(^state)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:789
fn jet_auth_oauth_finish(state: String, assertion: String, now_ms: I64, ttl_ms: I64) -> JetAuthSession Err! {
    if !jet_auth_valid_identifier(state, 256) || assertion.is_empty() { return Err("OAuth completion is invalid") }
    // GATE #4565: kernel primitive
    #Unsafe("verify and consume pending OAuth state once; keep failed assertions retryable without consuming state") {
        store := jet_auth_store().lock().map_err(fn(error) { "auth store is unavailable" })?
        index :: store.oauth_states.iter().position(fn(entry) { jet_auth_constant_time_text_eq(entry.state, state) && now_ms < entry.expires_at })
            .ok_or_else(fn() { "OAuth state is expired or unknown" })?
        entry :: store.oauth_states[index].clone()
        (secret, issuer, audience) :: jet_auth_oauth_config(entry.provider)?
        subject :: jet_auth_oauth_verify(&entry, assertion, now_ms, secret, issuer, audience)?
        session :: jet_auth_session_value(^subject, now_ms, ttl_ms)?
        _ :: store.oauth_states.remove(index)
        store.sessions.push(session.clone())
        Ok(^session)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:824
fn jet_auth_session_user(session: &JetAuthSession) -> String { session.user_id.clone() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:828
fn jet_auth_session_cookie(session: &JetAuthSession) -> String { session.cookie.clone() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:832
fn jet_auth_session_id(session: &JetAuthSession) -> String { session.id.clone() }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:836
fn jet_app_auth(users_table: String) -> JetAuthApp { JetAuthApp{users_table: ^users_table, providers: []} }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:843
fn jet_app_auth_oauth(auth: JetAuthApp, providers: String) -> JetAuthApp {
    for part in providers.split(fn(c) { c == ',' || c == ' ' }) {
        provider := part.trim() // #4303
        if jet_auth_valid_identifier(provider, 128) && !auth.providers.iter().any(fn(existing) { existing == provider }) { auth.providers.push(provider.to_string()) }
    }
    ^auth
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:855
fn jet_app_auth_routes(auth: &JetAuthApp) -> String {
    routes := ["POST /login -> password ({auth.users_table})", "POST /logout -> revoke session", "GET /magic -> begin magic link", "POST /magic -> consume magic link"]
    for provider in &auth.providers { routes.push("GET /oauth/{provider}/begin"); routes.push("GET /oauth/{provider}/callback") }
    "AuthRoutes({routes.join("; ")})"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:869
fn jet_app_auth_show(auth: &JetAuthApp) -> String { "Auth(users={auth.users_table}, providers=[{auth.providers.join(",")}])" }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:880
pub fn auth_runtime_reset() -> {
    // GATE #4565: kernel primitive
    #Unsafe("reset existing process store under mutex; retain original poison recovery without clearing mutex poison") {
        store :: match JET_AUTH_STORE.get() { Val(store) -> store, None -> return }
        locked := match store.lock() { Ok(store) -> store, Err(poisoned) -> poisoned.into_inner() }
        *locked = JetAuthUserStore.default()
    }
}
