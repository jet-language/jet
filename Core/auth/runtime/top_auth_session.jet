// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:594
fn jet_auth_session_cookie_mint(id: String) -> String { "jet_session={id}; HttpOnly; Secure; SameSite=Lax; Path=/" }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:598
