// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:218
fn jet_oauth_b64url_decode(text: String) -> [U8] Err! {
    if text.is_empty() || text.len() > 16 * 1024 || text.len() % 4 == 1 { return Err("OAuth assertion encoding is invalid") }
    out := [U8].with_capacity(text.len().saturating_mul(3) / 4)
    accumulator := U32{0}
    bits := U8{0}
    for byte in text.bytes() {
        value :: match byte {
            65..=90 -> byte - U8{65}
            97..=122 -> byte - U8{97} + U8{26}
            48..=57 -> byte - U8{48} + U8{52}
            45 -> U8{62}
            95 -> U8{63}
            _ -> return Err("OAuth assertion encoding is invalid")
        }
        accumulator = ((accumulator << 6) | U32.from(value)) & 0x00ffffff
        bits += 6
        if bits >= 8 { bits -= 8; out.push(((accumulator >> bits) & 0xff) as U8) }
    }
    if bits != 0 && (accumulator & ((U32{1} << bits) - 1)) != 0 { return Err("OAuth assertion encoding is non-canonical") }
    Ok(^out)
}
