// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:257
fn jet_oauth_json_string(chars: [Char], position: &USize) -> String? {
    if chars.get(*position) != Val(&'"') { return None }
    *position += 1
    out := String.new()
    loop {
        character :: match chars.get(*position).copied() { Val(character) -> character, None -> break }
        *position += 1
        match character {
            '"' -> return Val(^out)
            '\\' -> {
                escaped :: chars.get(*position).copied()?
                *position += 1
                match escaped {
                    '"' -> out.push('"')
                    '\\' -> out.push('\\')
                    '/' -> out.push('/')
                    'b' -> out.push(Char.from_u32(8).unwrap())
                    'f' -> out.push(Char.from_u32(12).unwrap())
                    'n' -> out.push('\n')
                    'r' -> out.push('\r')
                    't' -> out.push('\t')
                    'u' -> {
                        high :: jet_oauth_json_hex4(chars, position)?
                        if (0xD800..=0xDBFF).contains(&high) {
                            if chars.get(*position) != Val(&'\\') { return None }
                            *position += 1
                            if chars.get(*position) != Val(&'u') { return None }
                            *position += 1
                            low :: jet_oauth_json_hex4(chars, position)?
                            if !(0xDC00..=0xDFFF).contains(&low) { return None }
                            combined :: 0x10000 + ((high - 0xD800) << 10) + (low - 0xDC00)
                            out.push(Char.from_u32(combined)?)
                        } else if (0xDC00..=0xDFFF).contains(&high) { return None }
                        else { out.push(Char.from_u32(high)?) }
                    }
                    _ -> return None
                }
            }
            _ -> { if (character as U32) < 0x20 { return None }; out.push(character) }
        }
    }
    None
}
