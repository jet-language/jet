// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:326
fn jet_oauth_json_skip_value(chars: [Char], position: &USize) -> Bool {
    first :: match chars.get(*position).copied() { Val(first) -> first, None -> return false }
    if first == '"' { return jet_oauth_json_string(chars, position).is_some() }
    if first == '{' || first == '[' {
        closers := [if first == '{' { '}' } else { ']' }]
        *position += 1
        loop {
            character :: match chars.get(*position).copied() { Val(character) -> character, None -> break }
            if character == '"' { if jet_oauth_json_string(chars, position).is_none() { return false }; continue }
            if character == '{' { closers.push('}'); *position += 1; continue }
            if character == '[' { closers.push(']'); *position += 1; continue }
            if character == '}' || character == ']' {
                if closers.last().copied() != Val(character) { return false }
                _ :: closers.pop()
                *position += 1
                if closers.is_empty() { return true }
                continue
            }
            *position += 1
        }
        return false
    }
    start :: *position
    loop {
        character :: match chars.get(*position).copied() { Val(character) -> character, None -> break }
        if jet_oauth_json_whitespace(character) || character == ',' || character == '}' || character == ']' { break }
        *position += 1
    }
    *position > start
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:380
fn jet_oauth_parse_i64(text: String) -> I64? {
    (negative, digits) :: text.strip_prefix('-').map_or((false, text), fn(digits) { (true, digits) })
    if digits.is_empty() || !digits.bytes().all(fn(byte) { byte.is_ascii_digit() }) { return None }
    if negative && digits == "0" { return None }
    limit :: if negative { U64{1} << 63 } else { I64.MAX as U64 }
    magnitude :: digits.bytes().try_fold(U64{0}, fn(value, byte) {
        next :: value.checked_mul(10)?.checked_add(U64.from(byte - U8{48}))?
        (next <= limit).then_some(next)
    })?
    if negative {
        if magnitude == U64{1} << 63 { Val(I64.MIN) } else { I64.try_from(magnitude).ok()?.checked_neg() }
    } else { I64.try_from(magnitude).ok() }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:408
fn jet_oauth_parse_claims(text: String) -> JetAuthOAuthClaims Err! {
    if text.len() > 32 * 1024 { return Err("OAuth assertion payload is too large") }
    chars: [Char] :: text.chars().collect()
    position := USize{0}
    jet_oauth_skip_whitespace(chars, &position)
    if chars.get(position) != Val(&'{') { return Err("OAuth assertion payload is not an object") }
    position += 1
    claims := JetAuthOAuthClaims.default()
    loop {
        jet_oauth_skip_whitespace(chars, &position)
        if chars.get(position) == Val(&'}') { position += 1; break }
        key :: jet_oauth_json_string(chars, &position).ok_or_else(fn() { "OAuth assertion claim name is invalid" })?
        jet_oauth_skip_whitespace(chars, &position)
        if chars.get(position) != Val(&':') { return Err("OAuth assertion claim separator is invalid") }
        position += 1
        jet_oauth_skip_whitespace(chars, &position)
        match key {
            "alg" | "nonce" | "iss" | "aud" | "sub" -> {
                value :: jet_oauth_json_string(chars, &position).ok_or_else(fn() { "OAuth claim `{key}` must be text" })?
                slot :: match key {
                    "alg" -> &claims.algorithm
                    "nonce" -> &claims.nonce
                    "iss" -> &claims.issuer
                    "aud" -> &claims.audience
                    "sub" -> &claims.subject
                    _ -> unreachable()
                }
                if slot.replace(^value).is_some() { return Err("OAuth claim `{key}` is duplicated") }
            }
            "exp" | "iat" -> {
                start :: position
                loop {
                    character :: match chars.get(position).copied() { Val(character) -> character, None -> break }
                    if jet_oauth_json_whitespace(character) || character == ',' || character == '}' || character == ']' { break }
                    position += 1
                }
                value :: jet_oauth_parse_i64(chars[start..position].iter().copied().collect::<String>()).ok_or_else(fn() { "OAuth claim `{key}` must be an integer" })?
                slot :: if key == "exp" { &claims.expires_at } else { &claims.issued_at }
                if slot.replace(value).is_some() { return Err("OAuth claim `{key}` is duplicated") }
            }
            _ -> { if !jet_oauth_json_skip_value(chars, &position) { return Err("OAuth assertion claim value is invalid") } }
        }
        jet_oauth_skip_whitespace(chars, &position)
        match chars.get(position).copied() {
            Val(',') -> position += 1
            Val('}') -> { position += 1; break }
            _ -> return Err("OAuth assertion object is invalid")
        }
    }
    jet_oauth_skip_whitespace(chars, &position)
    if position != chars.len() { return Err("OAuth assertion has trailing data") }
    Ok(^claims)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/AuthSession.rs:496
fn jet_auth_oauth_verify(entry: &JetAuthOAuthState, assertion: String, now_ms: I64, secret: [U8], issuer: String, audience: String) -> String Err! {
    if assertion.len() > 64 * 1024 { return Err("OAuth assertion is too large") }
    parts := assertion.split('.')
    header_part :: parts.next().ok_or_else(fn() { "OAuth assertion is malformed" })?
    payload_part :: parts.next().ok_or_else(fn() { "OAuth assertion is malformed" })?
    signature_part :: parts.next().ok_or_else(fn() { "OAuth assertion is malformed" })?
    if parts.next().is_some() || header_part.is_empty() || payload_part.is_empty() || signature_part.is_empty() { return Err("OAuth assertion is malformed") }
    header :: String.from_utf8(jet_oauth_b64url_decode(header_part)?).map_err(fn(error) { "OAuth assertion header is not UTF-8" })?
    payload :: String.from_utf8(jet_oauth_b64url_decode(payload_part)?).map_err(fn(error) { "OAuth assertion payload is not UTF-8" })?
    signature :: jet_oauth_b64url_decode(signature_part)?
    header_claims :: jet_oauth_parse_claims(header)?
    if header_claims.algorithm.as_deref() != Val("HS256") { return Err("OAuth assertion algorithm is not allowed") }
    expected :: jet_hmac_sha256(secret, "{header_part}.{payload_part}".as_bytes())
    if !jet_ct_eq(&expected, &signature) { return Err("OAuth assertion signature is invalid") }
    claims :: jet_oauth_parse_claims(payload)?
    if claims.nonce.as_deref().is_none_or(fn(nonce) { !jet_auth_constant_time_text_eq(nonce, entry.nonce) }) { return Err("OAuth assertion nonce is invalid") }
    if claims.issuer.as_deref() != Val(issuer) { return Err("OAuth assertion issuer is invalid") }
    if claims.audience.as_deref() != Val(audience) { return Err("OAuth assertion audience is invalid") }
    now_s :: now_ms.checked_div(1000).ok_or_else(fn() { "OAuth clock is invalid" })?
    expires_at :: claims.expires_at.ok_or_else(fn() { "OAuth assertion expiry is missing" })?
    if expires_at <= now_s { return Err("OAuth assertion is expired") }
    if claims.issued_at.is_some_and(fn(issued_at) { issued_at > now_s.saturating_add(60) }) { return Err("OAuth assertion was issued in the future") }
    subject :: claims.subject.ok_or_else(fn() { "OAuth assertion subject is missing" })?
    if !jet_auth_valid_identifier(subject, 512) { return Err("OAuth assertion subject is invalid") }
    Ok(^subject)
}
