// A rolling hash of decoded words, the one computed over libjpeg's output.
word_hash: fn(words: [Int]) -> Int {
    hash := 0
    loop word in words -> hash = (hash * 31 + word) % 1000000007
    hash
}

#Test("jpeg files from libjpeg decode to the bytes djpeg writes") {
    // djpeg -dct int -nosmooth: the integer inverse DCT and chroma
    // repeated, hashed the same way.
    assert_eq(word_hash(jpeg_words(C_TEST_JPEG_420)), 988099183)
    assert_eq(word_hash(jpeg_words(C_TEST_JPEG_444_RESTART)), 403664533)
    assert_eq(word_hash(jpeg_words(C_TEST_JPEG_GRAY)), 458349796)
}

// A `width` x `height` image whose bytes run 0, 37, 74, ... mod 256, with
// alpha `alpha` (or the running byte when `alpha` is negative).
test_image: fn(width: Int, height: Int, alpha: Int) -> Image {
    pixels := [U8]{}
    loop index in 0..<(width * height * 4) {
        running: (index * 37) % 256
        pixels.push(U8{if index % 4 == 3 && alpha >= 0 -> alpha else -> running})
    }
    Image{width: width, height: height, pixels: pixels}
}

encode_error: fn(image: Image, format: ImageFormat, limits: Limits) -> ImageError {
    if encode(image, format, limits) == {
        .Ok(_) -> panic("encoded")
        .Err(error) -> error
    }
}

#Test("png encode round-trips through decode") {
    loop alpha in ([Int]{255, -1}) {
        original: test_image(5, 3, alpha)
        bytes: encode(original, .PNG, C_TEST_LIMITS) ?? panic("encode: {err:Debug}")
        info: inspect(bytes, C_TEST_LIMITS) ?? panic("inspect: {err:Debug}")
        assert(info.format == .PNG && info.color == (if alpha < 0 -> ImageColor.RGBA else -> ImageColor.RGB))
        assert_eq(decoded_words(bytes), image_words(original))
        // Every chunk carries its CRC-32; IEND's is fixed.
        tail: bytes.len() - 4
        assert_eq(be32(bytes, tail), 0xAE426082)
    }
}

#Test("png encode refuses bad images and budgets") {
    short: Image{width: 2, height: 2, pixels: [U8]{1, 2, 3}}
    assert(encode_error(short, .PNG, C_TEST_LIMITS) == .Malformed)
    assert(encode_error(Image{width: 0, height: 2, pixels: [U8]{}}, .PNG, C_TEST_LIMITS) == .Malformed)
    // 9 x 8 is 72 pixels, above the 64 the limits allow.
    assert(encode_error(test_image(9, 8, 255), .PNG, C_TEST_LIMITS) == .TooLarge)
    assert(encode_error(test_image(5, 3, 255), .PNG, Limits{max_input_bytes: 4096, max_pixels: 64, max_output_bytes: 20}) == .TooLarge)
    assert(encode_error(test_image(5, 3, 255), .GIF, C_TEST_LIMITS) == .Unsupported)
}

// A smooth `width` x `height` image with half-transparent alpha, gray when
// `gray` is 1.
smooth_image: fn(width: Int, height: Int, gray: Int) -> Image {
    pixels := [U8]{}
    loop y in 0..<height {
        loop x in 0..<width {
            red: (x * 9 + y * 3) % 256
            loop value in ([Int]{red, if gray == 1 -> red else -> (y * 11) % 256, if gray == 1 -> red else -> ((x + y) * 5) % 256, 128}) -> pixels.push(U8{value})
        }
    }
    Image{width: width, height: height, pixels: pixels}
}

// The squared differences of two same-size images' red, green and blue.
squared_error: fn(left: Image, right: Image) -> Int {
    total := 0
    loop index in 0..<left.pixels.len() {
        if index % 4 != 3 {
            difference: byte_at(left.pixels, index) - byte_at(right.pixels, index)
            total += difference * difference
        }
    }
    total
}

#Test("jpeg encode decodes back within 35 dB of the source") {
    limits: Limits{max_input_bytes: 8192, max_pixels: 1024, max_output_bytes: 8192}
    loop gray in 0..<2 {
        // 21 x 13 leaves partial blocks on the right and bottom edges.
        original: smooth_image(21, 13, gray)
        bytes: encode(original, .JPEG, limits) ?? panic("encode: {err:Debug}")
        info: inspect(bytes, limits) ?? panic("inspect: {err:Debug}")
        assert(info.format == .JPEG && info.width == 21 && info.height == 13)
        assert(info.color == (if gray == 1 -> ImageColor.Gray else -> ImageColor.RGB))
        back: decode(bytes, limits) ?? panic("decode: {err:Debug}")
        // A PSNR of 35 dB is a mean squared error of at most 20.
        assert(squared_error(original, back) <= 20 * 21 * 13 * 3)
        // JPEG has no alpha: the decoded pixels are opaque.
        assert_eq(back.pixels[3], U8{255})
    }
    assert(encode_error(smooth_image(21, 13, 0), .JPEG, Limits{max_input_bytes: 8192, max_pixels: 1024, max_output_bytes: 300}) == .TooLarge)
}
