//RS /// Marshal the resident `EncodingError` record into the one Prelude rendering
//RS /// AOT's `impl JetShow for EncodingError` embeds. The index tables and the
//RS /// Option ABI decode below are this host's ABI adapter; the text ladder is not
//RS /// re-encoded here (I9).
//RS fn jet_jit_encoding_error_show(handle: i64) -> i64 {
//RS     const FORMAT: &[&str] = &["JSON", "JSONL", "CSV", "TOML", "YAML", "XML", "CBOR"];
//RS     const KIND: &[&str] = &["Syntax", "Truncated", "Unsupported", "Limit", "IO", "State"];
//RS     Concurrency::with_runtime_mut(|rt| {
//RS         let format = rt.heap.record_get_int(handle, 0).unwrap_or(0) as usize;
//RS         let kind = rt.heap.record_get_int(handle, 1).unwrap_or(0) as usize;
//RS         let byte_offset = rt.heap.record_get_int(handle, 2).unwrap_or(0);
//RS         let line = rt.heap.record_get_int(handle, 3).unwrap_or(0);
//RS         let column = rt.heap.record_get_int(handle, 4).unwrap_or(0);
//RS         let path_id = rt.heap.record_get_string(handle, 5).unwrap_or(0);
//RS         let reason_id = rt.heap.record_get_string(handle, 6).unwrap_or(0);
//RS         let path = rt.heap.clone_string(path_id).unwrap_or_default();
//RS         let reason = rt.heap.clone_string(reason_id).unwrap_or_default();
//RS         // `line` and `column` are `Int?` fields written by Jet code, so each
//RS         // holds a result-arena Option handle carrying `(ok, bits)`.
//RS         let option_field = |field: i64| match crate::runtime_host::jit_result_parts(rt, field) {
//RS             Some((true, bits)) => Some(bits as i64),
//RS             _ => None,
//RS         };
//RS         let line = option_field(line);
//RS         let column = option_field(column);
//RS         let out = encoding_error_rt::jet_encoding_error_kernel_show(
//RS             FORMAT.get(format).copied().unwrap_or("?"),
//RS             KIND.get(kind).copied().unwrap_or("?"),
//RS             byte_offset,
//RS             line,
//RS             column,
//RS             &path,
//RS             &reason,
//RS         );
//RS         rt.heap.alloc_string(out)
//RS     })
//RS }
//RS 
//RS 
//RS 
//RS /// Resident `[FieldError]` rendering for `print(errors)`, `"{errors}"` and an
//RS /// uncaught `[FieldError]` entry failure. Marshals each record out of the heap
//RS /// and calls the one Prelude projection (`jet_field_error_kernel_show`); the
//RS /// `[a, b]` wrapper matches AOT's `impl<T: JetShow> JetShow for Vec<T>`
//RS /// (Prelude/Core/Values.rs).
//RS pub(crate) fn field_error_list_show_text(heap: &jet_rt::JetArena, handle: i64) -> String {
//RS     let len = heap.list_len(handle).unwrap_or(0);
//RS     let shown = (0..len)
//RS         .map(|i| {
//RS             let error = heap.list_get_int(handle, i).unwrap_or(0);
//RS             let path = heap.record_clone_string(error, 0).unwrap_or_default();
//RS             let reason = heap.record_clone_string(error, 1).unwrap_or_default();
//RS             field_error_rt::jet_field_error_kernel_show(&path, &reason)
//RS         })
//RS         .collect::<Vec<_>>();
//RS     format!("[{}]", shown.join(", "))
//RS }
//RS 
//RS fn jet_jit_decode_error_show(handle: i64) -> i64 {
//RS     Concurrency::with_runtime_mut(|rt| {
//RS         let shown = field_error_list_show_text(&rt.heap, handle);
//RS         rt.heap.alloc_string(shown)
//RS     })
//RS }
