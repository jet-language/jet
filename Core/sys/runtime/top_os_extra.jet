// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/OsExtra.rs:128
pub fn jet_std_os_expand(template: String) -> String {
    out := String.with_capacity(template.len())
    bytes :: template.as_bytes()
    i := USize{0}
    loop while i < bytes.len() {
        if bytes[i] == U8{36} {
            i += 1
            if i < bytes.len() && bytes[i] == U8{123} {
                i += 1
                start :: i
                loop while i < bytes.len() && bytes[i] != U8{125} { i += 1 }
                name := template[start..<i] // #4303
                if i < bytes.len() { i += 1 }
                &out.push_str(jet_std_env_get(name.to_string()).unwrap_or_default())
            } else {
                start :: i
                loop while i < bytes.len() && (bytes[i].is_ascii_alphanumeric() || bytes[i] == U8{95}) { i += 1 }
                name := template[start..<i] // #4303
                &out.push_str(jet_std_env_get(name.to_string()).unwrap_or_default())
            }
        } else {
            // Rust deliberately promotes each non-variable byte to a scalar.
            &out.push(bytes[i] as Char)
            i += 1
        }
    }
    ^out
}
