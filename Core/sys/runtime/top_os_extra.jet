// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/OsExtra.rs:48
pub fn jet_std_os_release() -> String {
    // GATE #4565: kernel primitive
    #Unsafe("resolve selected target release via native files, uname or Windows environment") {
        if target.selected_os() == .Linux {
            if fs.read_to_string(OSPath.new("/proc/sys/kernel/osrelease")) is Ok(text) {
                trimmed := text.trim() // #4303
                if !trimmed.is_empty() -> return trimmed.to_string()
            }
            if fs.read_to_string(OSPath.new("/etc/os-release")) is Ok(text) {
                loop line in text.lines() {
                    if line.strip_prefix("VERSION_ID=") is Val(value) {
                        value := value.trim_matches('"') // #4303
                        return value.to_string()
                    }
                }
            }
        }
        if target.selected_os() == .MacOS {
            if Command.new("uname").arg("-r").output() is Ok(output) {
                if String.from_utf8(^output.stdout) is Ok(s) {
                    trimmed := s.trim() // #4303
                    if !trimmed.is_empty() -> return trimmed.to_string()
                }
            }
        }
        if target.selected_family() == .Windows {
            if env.var("OS") is Ok(v) { if !v.is_empty() -> return ^v }
        }
        String.new()
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/OsExtra.rs:87
pub fn jet_std_os_version() -> String {
    // GATE #4565: kernel primitive
    #Unsafe("resolve selected target version and retain release fallback") {
        if target.selected_os() == .Linux {
            if fs.read_to_string(OSPath.new("/etc/os-release")) is Ok(text) {
                loop line in text.lines() {
                    if line.strip_prefix("PRETTY_NAME=") is Val(value) {
                        value := value.trim_matches('"') // #4303
                        return value.to_string()
                    }
                }
            }
            return jet_std_os_release()
        }
        if target.selected_os() == .MacOS {
            if Command.new("sw_vers").arg("-productVersion").output() is Ok(output) {
                if String.from_utf8(^output.stdout) is Ok(s) {
                    trimmed := s.trim() // #4303
                    if !trimmed.is_empty() -> return "macOS {trimmed}"
                }
            }
            return jet_std_os_release()
        }
        if target.selected_family() == .Windows -> return env.var("OS").unwrap_or_default()
        String.new()
    }
}
