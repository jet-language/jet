// Rust: crates/jet-codegen/src/Prelude/Core/EnvConfig.rs:1
// Extend the existing canonical environment configuration owner; entries and
// parsing stay in core.sys.runtime.kernel_env_config rather than a second codec.
// Rust: crates/jet-codegen/src/Prelude/Core/EnvConfig.rs:6
// JetEnvConfigEntry -> kernel_env_config.JetEnvConfigEntry (kernel_env_config.jet:29).
// Rust: crates/jet-codegen/src/Prelude/Core/EnvConfig.rs:13
pub fn jet_env_config_file_is_project_relative(file: String) -> Bool {
    // GATE #4565: kernel primitive
    #Unsafe("classify the selected target's native path components without IO or normalization") {
        path :: OSPath.new(file)
        !path.is_absolute() && !path.components().any(part -> part is .ParentDir)
    }
}
