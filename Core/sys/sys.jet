fn is_ident(b: U8) -> Bool {
    n :: b
    if n >= 65 && n <= 90 -> return true
    if n >= 97 && n <= 122 -> return true
    if n >= 48 && n <= 57 -> return true
    n == 95
}

fn slice_ascii(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    i := start
    loop {
        if i >= end -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i = i + 1
    }
}

fn ascii_lower(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n :: b
        if n >= 65 && n <= 90 -> out.push(U8{n + 32}) else -> out.push(b)
    }
    String.from_bytes(out) ?? text
}

fn starts(text: String, prefix: String) -> Bool {
    a :: text.bytes()
    b :: prefix.bytes()
    if b.len() > a.len() -> return false
    loop i in 0..<b.len() {
        if a[i] != b[i] -> return false
    }
    true
}

pub fn platform() -> String { "{name()}-{arch()}" }

pub fn is_windows() -> Bool { family() == "windows" }

pub fn is_unix() -> Bool {
    f :: family()
    f == "unix" || f == "posix" || f == "linux" || f == "darwin"
}

pub fn is_linux() -> Bool { name() == "linux" }

pub fn is_macos() -> Bool { name() == "darwin" || name() == "macos" }

pub fn uname() -> String { "{sysname()} {release()} {machine()}" }

pub fn sysname() -> String { name() }

pub fn machine() -> String { arch() }

pub fn getenv(name: String, fallback: String) -[Env]> String { get(name) ?? fallback }

pub fn pathsep() -> String {
    if is_windows() -> ";"
    ":"
}

pub fn linesep() -> String {
    if is_windows() -> return String.from_bytes([U8]{13, 10}) ?? "\n"
    "\n"
}
