package {
    name: "core.sys"
    version: "0.0.1"
    edition: "2026"
    description: "System environment and process operations."
    license: "MIT"
    outputs: {
        sys: .Library{ entry: sys }
    }
}
use core as core


fn get(name: String) -[Env]> String? Never! { core.sys.get(name) }

fn set(name: String, value: String) Never! -[Env]> { core.sys.set(name, value) }

fn unset(name: String) -[Env]> Bool EnvError! { core.sys.unset(name) }

fn vars() -[Env]> [String] EnvError! { core.sys.vars() }

fn current_dir() -[FS, Env]> String IOError! { core.sys.current_dir() }

fn home_dir() -[Env]> String? Never! {
    home :: get("HOME")
    if home != None -> return Val(home)
    get("USERPROFILE")
}

fn name() -[Env]> String Never! { core.sys.name() }

fn family() -[Env]> String Never! {
    platform_name :: ascii_lower(name())
    if platform_name == "windows" || platform_name.starts_with("windows") -> return "windows"
    if platform_name == "linux" || platform_name == "darwin" || platform_name == "macos" || platform_name == "osx" || platform_name == "freebsd" || platform_name == "openbsd" || platform_name == "netbsd" || platform_name == "android" {
        return "unix"
    }
    platform_name
}

fn arch() -[Env]> String Never! { core.sys.arch() }

fn temp_dir() -[Env]> String Never! {
    tmp :: get("TMPDIR")
    if tmp != None -> return tmp
    temp :: get("TEMP")
    if temp != None -> return temp
    fallback :: get("TMP")
    if fallback != None -> return fallback
    "/tmp"
}

fn executable() -[Env]> String Never! { core.sys.executable() }

fn hostname() -[Env]> String Never! { core.sys.hostname() }

fn username() -[Env]> String Never! {
    user :: get("USER")
    if user != None -> return user
    username :: get("USERNAME")
    if username != None -> return username
    core.sys.username()
}

fn release() -[Env]> String Never! { core.sys.release() }

fn version() -[Env]> String Never! { core.sys.version() }

fn expand(value: String) -[Env]> String Never! {
    raw :: value.bytes()
    out := [U8]{}
    i := 0
    loop {
        if i >= raw.len() -> return String.from_bytes(out) ?? value
        byte :: raw[i]
        if byte == (U8{36}) {
            if i + 1 < raw.len() && raw[i + 1] == (U8{36}) {
                &out.push(U8{36})
                i = i + 2
                next
            }
            if i + 1 < raw.len() && raw[i + 1] == (U8{123}) {
                j := i + 2
                loop {
                    if j >= raw.len() -> break
                    if raw[j] == (U8{125}) -> break
                    j = j + 1
                }
                if j >= raw.len() {
                    &out.push(byte)
                    i = i + 1
                    next
                }
                key :: slice_ascii(raw, i + 2, j)
                replacement :: get(key) ?? ""
                loop item in replacement.bytes() -> &out.push(item)
                i = j + 1
                next
            }
            j := i + 1
            loop {
                if j >= raw.len() || !is_env_ident(raw[j]) -> break
                j = j + 1
            }
            if j == i + 1 {
                &out.push(byte)
                i = i + 1
                next
            }
            key :: slice_ascii(raw, i + 1, j)
            replacement :: get(key) ?? ""
            loop item in replacement.bytes() -> &out.push(item)
            i = j
            next
        }
        if byte == (U8{37}) {
            j := i + 1
            loop {
                if j >= raw.len() -> break
                if raw[j] == (U8{37}) -> break
                j = j + 1
            }
            if j < raw.len() && raw[j] == (U8{37}) && j > i + 1 {
                key :: slice_ascii(raw, i + 1, j)
                replacement :: get(key) ?? ""
                loop item in replacement.bytes() -> &out.push(item)
                i = j + 1
                next
            }
        }
        &out.push(byte)
        i = i + 1
    }
}

fn pid() -[Env]> Int Never! { core.sys.getpid() }

fn getpid() -[Env]> Int Never! { core.sys.getpid() }

fn cpu_count() -[Env]> Int Never! {
    count :: core.sys.cpu_count()
    if count < 1 -> return 1
    count
}

fn getppid() -[Env]> Int Never! { core.sys.getppid() }

fn getuid() -[Env]> Int Never! { core.sys.getuid() }

fn geteuid() -[Env]> Int Never! { core.sys.geteuid() }

fn getgid() -[Env]> Int Never! { core.sys.getgid() }

fn getegid() -[Env]> Int Never! { core.sys.getegid() }

fn getpgrp() -[Env]> Int Never! { core.sys.getpgrp() }

#Unsafe("posix umask: the caller owns the process file-creation mask and restores it when other code relies on it") fn umask(mask: Int) -[FS, Env]> Int Never! {
    core.sys.umask(mask)
}
fn exitcode(code: Int) -> Int Never! { code }

fn success(code: Int) -> Bool Never! { code == 0 }

fn uptime() -[Time, Env]> Float Never! { core.sys.uptime() }

fn getgroups() -[Env]> [Int] Never! { core.sys.getgroups() }

fn loadavg() -[Env]> [Float] Never! { core.sys.loadavg() }

fn times() -[Env]> [Float] Never! { core.sys.times() }

fn getpgid(pid: Int) -[Env]> Int IOError! {
    #Unsafe("posix getpgid: inspect a process group") {
        return core.sys.getpgid(pid)
    }
}

fn getsid(pid: Int) -[Env]> Int IOError! {
    #Unsafe("posix getsid: inspect a process session") {
        return core.sys.getsid(pid)
    }
}

#Unsafe("posix getpriority: the caller vouches that `which` names this process or one it controls") fn getpriority(which: Int) -[Env]> Int IOError! {
    core.sys.getpriority(which)
}

#Unsafe("posix setpriority: the caller owns the scheduling priority of the process it changes") fn setpriority(which: Int, priority: Int) IOError! -[Env]> {
    core.sys.setpriority(which, priority)
}

#Unsafe("posix utime: the caller owns the file whose timestamps it rewrites") fn utime(path: String, atime: Int, mtime: Int) IOError! -[FS, Env]> {
    core.sys.utime(path, atime, mtime)
}

fn sync() Never! -[FS, Env]> { core.sys.sync() }

#Unsafe("posix stop: the caller accepts that the process ends here after the shared cleanup boundary") fn stop(code: Int) Never! -[Env]> {
    core.sys.stop(code)
}

fn set_current_dir(path: String) IOError! -[FS, Env]> {
    return core.sys.set_current_dir(path)
}
#Unsafe("posix pipe: the caller owns both returned descriptors and closes each exactly once") fn pipe() -[FS, Env]> [Int] IOError! {
    core.sys.pipe()
}

#Unsafe("posix close_fd: the caller owns `fd` and nothing uses it after this call") fn close_fd(fd: Int) Never! -[FS, Env]> {
    core.sys.close_fd(fd)
}

#Unsafe("posix mkfifo: the caller owns `path` and removes the named pipe it creates") fn mkfifo(path: String, mode: Int) IOError! -[FS, Env]> {
    core.sys.mkfifo(path, mode)
}

#Unsafe("posix fork: the caller handles both the parent and the child return and reaps the child") fn fork() -[Env]> Int IOError! {
    core.sys.fork()
}

#Unsafe("posix setsid: the caller owns the process session topology it changes") fn setsid() -[Env]> Int IOError! {
    core.sys.setsid()
}

#Unsafe("posix wait: the caller owns the child processes it reaps") fn wait() -[Env, Time.Wait]> Int IOError! {
    core.sys.wait()
}

#Unsafe("posix waitpid: the caller owns the child process it reaps") fn waitpid(pid: Int, options: Int) -[Env, Time.Wait]> Int IOError! {
    core.sys.waitpid(pid, options)
}

#Unsafe("posix setuid: the caller drops or changes process credentials deliberately") fn setuid(uid: Int) IOError! -[Env]> {
    core.sys.setuid(uid)
}

#Unsafe("posix setgid: the caller drops or changes process credentials deliberately") fn setgid(gid: Int) IOError! -[Env]> {
    core.sys.setgid(gid)
}

#Unsafe("posix setpgrp: the caller owns the process group topology it changes") fn setpgrp() IOError! -[Env]> {
    core.sys.setpgrp()
}

#Unsafe("posix setpgid: the caller owns the process group topology it changes") fn setpgid(pid: Int, pgid: Int) IOError! -[Env]> {
    core.sys.setpgid(pid, pgid)
}

#Unsafe("posix kill: the caller owns or is entitled to signal the target process") fn kill(pid: Int, signal: Int) IOError! -[Env]> {
    core.sys.kill(pid, signal)
}

#Unsafe("posix initgroups: the caller changes supplementary groups deliberately") fn initgroups(user: String, group: Int) IOError! -[Env]> {
    core.sys.initgroups(user, group)
}


fn platform() -[Env]> String Never! { "{name()}-{arch()}" }

fn is_windows() -[Env]> Bool Never! { family() == "windows" }

fn is_unix() -[Env]> Bool Never! { family() == "unix" }

fn is_linux() -[Env]> Bool Never! {
    platform_name :: ascii_lower(name())
    platform_name == "linux"
}

fn is_macos() -[Env]> Bool Never! {
    platform_name :: ascii_lower(name())
    platform_name == "macos" || platform_name == "darwin" || platform_name == "osx"
}

fn uname() -[Env]> String Never! { "{name()} {release()} {version()} {arch()}" }

fn sysname() -[Env]> String Never! { name() }

fn machine() -[Env]> String Never! { arch() }

fn getenv(name: String) -[Env]> String? Never! { get(name) }

fn pathsep() -[Env]> String Never! {
    if is_windows() -> return ";"
    ":"
}

fn linesep() -[Env]> String Never! {
    if is_windows() -> return String.from_bytes([U8]{13, 10}) ?? ""
    "\n"
}
fn is_env_ident(byte: U8) -> Bool {
    n :: byte
    if n >= 65 && n <= 90 -> return true
    if n >= 97 && n <= 122 -> return true
    if n >= 48 && n <= 57 -> return true
    n == 95
}

fn slice_ascii(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    i := start
    loop {
        if i >= end -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}

fn ascii_lower(text: String) -> String {
    out := [U8]{}
    loop byte in text.bytes() {
        n :: byte
        if n >= 65 && n <= 90 -> &out.push(U8{n + 32}) else -> &out.push(byte)
    }
    String.from_bytes(out) ?? text
}
