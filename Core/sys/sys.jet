package {
    name: "core.sys"
    version: "0.0.1"
    edition: "2026"
    description: "System environment and process operations."
    license: "MIT"
    outputs: {
        sys: .Library{ entry: sys }
    }
}
use core as core


pub fn get(name: String) -[Env]> String? Never! { core.sys.get(name) }

pub fn set(name: String, value: String) Never! -[Env]> { core.sys.set(name, value) }

pub fn unset(name: String) -[Env]> Bool EnvError! { core.sys.unset(name) }

pub fn vars() -[Env]> [String] EnvError! { core.sys.vars() }

pub fn current_dir() -[FS, Env]> String IOError! { core.sys.current_dir() }

pub fn home_dir() -[Env]> String? Never! {
    home :: get("HOME")
    if home != None -> return Val(home)
    get("USERPROFILE")
}

pub fn name() -[Env]> String Never! { core.sys.name() }

pub fn family() -[Env]> String Never! { core.sys.family() }

pub fn arch() -[Env]> String Never! { core.sys.arch() }

pub fn temp_dir() -[Env]> String Never! {
    tmp :: get("TMPDIR")
    if tmp != None -> return tmp
    temp :: get("TEMP")
    if temp != None -> return temp
    fallback :: get("TMP")
    if fallback != None -> return fallback
    "/tmp"
}

pub fn executable() -[Env]> String Never! { core.sys.executable() }

pub fn hostname() -[Env]> String Never! { core.sys.hostname() }

pub fn username() -[Env]> String Never! {
    user :: get("USER")
    if user != None -> return user
    username :: get("USERNAME")
    if username != None -> return username
    host_user :: host_env("USER")
    if host_user != None -> return host_user
    host_env("USERNAME") ?? ""
}

pub fn release() -[Env]> String Never! { core.sys.release() }

pub fn version() -[Env]> String Never! { core.sys.version() }

pub fn expand(value: String) -[Env]> String Never! {
    raw :: value.bytes()
    out := [U8]{}
    i := 0
    loop {
        if i >= raw.len() -> return String.from_bytes(out) ?? ""
        byte :: raw[i]
        if byte == (U8{36}) {
            i = i + 1
            start := i
            if i < raw.len() && raw[i] == (U8{123}) {
                i = i + 1
                start = i
                loop {
                    if i >= raw.len() || raw[i] == (U8{125}) -> break
                    i = i + 1
                }
                key :: slice_ascii(raw, start, i)
                if i < raw.len() -> i = i + 1
                replacement :: get(key) ?? ""
                loop item in replacement.bytes() -> &out.push(item)
            } else {
                loop {
                    if i >= raw.len() || !is_env_ident(raw[i]) -> break
                    i = i + 1
                }
                replacement :: get(slice_ascii(raw, start, i)) ?? ""
                loop item in replacement.bytes() -> &out.push(item)
            }
        } else {
            // The historical host contract expands each non-variable byte as
            // a Unicode scalar (U+0000..U+00FF), not as a UTF-8 text segment.
            n :: Int.from_u8(byte)
            if n < 128 -> &out.push(byte)
            else {
                &out.push(U8{192 | (n >> 6)})
                &out.push(U8{128 | (n & 63)})
            }
            i = i + 1
        }
    }
}

pub fn pid() -[Env]> Int Never! { core.sys.getpid() }

pub fn getpid() -[Env]> Int Never! { core.sys.getpid() }

pub fn cpu_count() -[Env]> Int Never! {
    count :: core.sys.cpu_count()
    if count < 1 -> return 1
    count
}

pub fn getppid() -[Env]> Int Never! { posix_identity(core.sys.__getppid()) }

pub fn getuid() -[Env]> Int Never! { posix_identity(core.sys.__getuid()) }

pub fn geteuid() -[Env]> Int Never! { posix_identity(core.sys.__geteuid()) }

pub fn getgid() -[Env]> Int Never! { posix_identity(core.sys.__getgid()) }

pub fn getegid() -[Env]> Int Never! { posix_identity(core.sys.__getegid()) }

pub fn getpgrp() -[Env]> Int Never! { posix_identity(core.sys.__getpgrp()) }

#Unsafe("posix umask: the caller owns the process file-creation mask and restores it when other code relies on it") pub fn umask(mask: Int) -[FS, Env]> Int Never! {
    core.sys.umask(mask)
}
pub fn exitcode(code: Int) -> Int Never! { code }

pub fn success(code: Int) -> Bool Never! { code == 0 }

pub fn uptime() -[Time, Env]> Float Never! { core.sys.uptime() }

pub fn getgroups() -[Env]> [Int] Never! { core.sys.getgroups() }

pub fn loadavg() -[Env]> [Float] Never! { core.sys.loadavg() }

pub fn times() -[Env]> [Float] Never! { core.sys.times() }

pub fn getpgid(pid: Int) -[Env]> Int IOError! {
    #Unsafe("posix getpgid: inspect a process group") {
        return core.sys.getpgid(pid)
    }
}

pub fn getsid(pid: Int) -[Env]> Int IOError! {
    #Unsafe("posix getsid: inspect a process session") {
        return core.sys.getsid(pid)
    }
}

#Unsafe("posix getpriority: the caller vouches that `which` names this process or one it controls") pub fn getpriority(which: Int) -[Env]> Int IOError! {
    core.sys.getpriority(which)
}

#Unsafe("posix setpriority: the caller owns the scheduling priority of the process it changes") pub fn setpriority(which: Int, priority: Int) IOError! -[Env]> {
    core.sys.setpriority(which, priority)
}

#Unsafe("posix utime: the caller owns the file whose timestamps it rewrites") pub fn utime(path: String, atime: Int, mtime: Int) IOError! -[FS, Env]> {
    core.sys.utime(path, atime, mtime)
}

pub fn sync() Never! -[FS, Env]> { core.sys.sync() }

#Unsafe("posix stop: the caller accepts that the process ends here after the shared cleanup boundary") pub fn stop(code: Int) Never! -[Env]> {
    core.sys.stop(code)
}

pub fn set_current_dir(path: String) IOError! -[FS, Env]> {
    return core.sys.set_current_dir(path)
}
#Unsafe("posix pipe: the caller owns both returned descriptors and closes each exactly once") pub fn pipe() -[FS, Env]> [Int] IOError! {
    core.sys.pipe()
}

#Unsafe("posix close_fd: the caller owns `fd` and nothing uses it after this call") pub fn close_fd(fd: Int) Never! -[FS, Env]> {
    core.sys.close_fd(fd)
}

#Unsafe("posix mkfifo: the caller owns `path` and removes the named pipe it creates") pub fn mkfifo(path: String, mode: Int) IOError! -[FS, Env]> {
    core.sys.mkfifo(path, mode)
}

#Unsafe("posix fork: the caller handles both the parent and the child return and reaps the child") pub fn fork() -[Env]> Int IOError! {
    core.sys.fork()
}

#Unsafe("posix setsid: the caller owns the process session topology it changes") pub fn setsid() -[Env]> Int IOError! {
    core.sys.setsid()
}

#Unsafe("posix wait: the caller owns the child processes it reaps") pub fn wait() -[Env, Time.Wait]> Int IOError! {
    core.sys.wait()
}

#Unsafe("posix waitpid: the caller owns the child process it reaps") pub fn waitpid(pid: Int, options: Int) -[Env, Time.Wait]> Int IOError! {
    core.sys.waitpid(pid, options)
}

#Unsafe("posix setuid: the caller drops or changes process credentials deliberately") pub fn setuid(uid: Int) IOError! -[Env]> {
    core.sys.setuid(uid)
}

#Unsafe("posix setgid: the caller drops or changes process credentials deliberately") pub fn setgid(gid: Int) IOError! -[Env]> {
    core.sys.setgid(gid)
}

#Unsafe("posix setpgrp: the caller owns the process group topology it changes") pub fn setpgrp() IOError! -[Env]> {
    core.sys.setpgrp()
}

#Unsafe("posix setpgid: the caller owns the process group topology it changes") pub fn setpgid(pid: Int, pgid: Int) IOError! -[Env]> {
    core.sys.setpgid(pid, pgid)
}

#Unsafe("posix kill: the caller owns or is entitled to signal the target process") pub fn kill(pid: Int, signal: Int) IOError! -[Env]> {
    core.sys.kill(pid, signal)
}

#Unsafe("posix initgroups: the caller changes supplementary groups deliberately") pub fn initgroups(user: String, group: Int) IOError! -[Env]> {
    core.sys.initgroups(user, group)
}


pub fn platform() -[Env]> String Never! { "{name()}-{arch()}" }

pub fn is_windows() -[Env]> Bool Never! { family() == "windows" }

pub fn is_unix() -[Env]> Bool Never! { family() == "unix" }

pub fn is_linux() -[Env]> Bool Never! {
    platform_name :: ascii_lower(name())
    platform_name == "linux"
}

pub fn is_macos() -[Env]> Bool Never! {
    platform_name :: ascii_lower(name())
    platform_name == "macos" || platform_name == "darwin" || platform_name == "osx"
}

pub fn uname() -[Env]> String Never! { "{name()} {release()} {version()} {arch()}" }

pub fn sysname() -[Env]> String Never! { name() }

pub fn machine() -[Env]> String Never! { arch() }

pub fn getenv(name: String) -[Env]> String? Never! { get(name) }

pub fn pathsep() -[Env]> String Never! {
    if is_windows() -> return ";"
    ":"
}

pub fn linesep() -[Env]> String Never! {
    if is_windows() -> return String.from_bytes([U8]{13, 10}) ?? ""
    "\n"
}
fn is_env_ident(byte: U8) -> Bool {
    n :: byte
    if n >= 65 && n <= 90 -> return true
    if n >= 97 && n <= 122 -> return true
    if n >= 48 && n <= 57 -> return true
    n == 95
}

fn slice_ascii(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    i := start
    loop {
        if i >= end -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}

fn ascii_lower(text: String) -> String {
    out := [U8]{}
    loop byte in text.bytes() {
        n :: byte
        if n >= 65 && n <= 90 -> &out.push(U8{n + 32}) else -> &out.push(byte)
    }
    String.from_bytes(out) ?? text
}

// A platform with no POSIX identity syscall keeps the public zero fact.
// The provider reports availability, never supplies this fallback.
fn posix_identity(value: Int?) -> Int Never! { value ?? 0 }

#Test
fn posix_identity_policy() {
    assert(posix_identity(None) == 0)
    assert(posix_identity(Val(0)) == 0)
    assert(posix_identity(Val(4294967295)) == 4294967295)
}

#Test
fn expansion_literal_policy() -[Env]> {
    assert(expand("$") == "")
    assert(expand("$$$") == "")
    assert(expand("%VALUE%") == "%VALUE%")
    assert(expand("é") == "Ã©")
}

fn host_env(name: String) -[Env]> String? Never! {
    decode_host_env(core.sys.__host_env(name))
}

fn decode_host_env(raw: [U8]?) -> String? Never! {
    bytes :: raw ?? return None
    String.from_bytes(bytes)
}

#Test
fn host_environment_text_policy() {
    assert(decode_host_env(None) == None)
    assert(decode_host_env(Val([U8]{})) == Val(""))
    assert(decode_host_env(Val([U8]{195, 169})) == Val("é"))
    assert(decode_host_env(Val([U8]{255})) == None)
}
