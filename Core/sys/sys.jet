package {
    name: "core.sys"
    version: "0.1.0"
    edition: "2026"
    description: "System environment and process operations."
    license: "MIT"
    outputs: {
        sys: .Library{ entry: sys }
    }
}
use core as core


pub fn get(name: String) -[Env]> String? { core.sys.get(name) }

pub fn set(name: String, value: String) -[Env]> { core.sys.set(name, value) }

pub fn unset(name: String) -[Env]> Bool EnvError! { core.sys.unset(name) }

pub fn vars() -[Env]> [String] EnvError! { core.sys.vars() }

pub fn current_dir() -[FS, Env]> String IOError! { core.sys.current_dir() }

pub fn home_dir() -[Env]> String? {
    home :: get("HOME")
    if home != None -> return Val(home)
    get("USERPROFILE")
}

pub fn name() -[Env]> String { core.sys.name() }

pub fn family() -[Env]> String {
    platform_name :: ascii_lower(name())
    if platform_name == "windows" || platform_name.starts_with("windows") -> return "windows"
    if platform_name == "linux" || platform_name == "darwin" || platform_name == "macos" || platform_name == "osx" || platform_name == "freebsd" || platform_name == "openbsd" || platform_name == "netbsd" || platform_name == "android" {
        return "unix"
    }
    platform_name
}

pub fn arch() -[Env]> String { core.sys.arch() }

pub fn temp_dir() -[Env]> String {
    tmp :: get("TMPDIR")
    if tmp != None -> return tmp
    temp :: get("TEMP")
    if temp != None -> return temp
    fallback :: get("TMP")
    if fallback != None -> return fallback
    "/tmp"
}

pub fn executable() -[Env]> String { core.sys.executable() }

pub fn hostname() -[Env]> String { core.sys.hostname() }

pub fn username() -[Env]> String {
    user :: get("USER")
    if user != None -> return user
    username :: get("USERNAME")
    if username != None -> return username
    core.sys.username()
}

pub fn release() -[Env]> String { core.sys.release() }

pub fn version() -[Env]> String { core.sys.version() }

pub fn expand(value: String) -[Env]> String {
    raw :: value.bytes()
    out := [U8]{}
    i := 0
    loop {
        if i >= raw.len() -> return String.from_bytes(out) ?? value
        byte :: raw[i]
        if byte == (U8{36}) {
            if i + 1 < raw.len() && raw[i + 1] == (U8{36}) {
                &out.push(U8{36})
                i = i + 2
                next
            }
            if i + 1 < raw.len() && raw[i + 1] == (U8{123}) {
                j := i + 2
                loop {
                    if j >= raw.len() -> break
                    if raw[j] == (U8{125}) -> break
                    j = j + 1
                }
                if j >= raw.len() {
                    &out.push(byte)
                    i = i + 1
                    next
                }
                key :: slice_ascii(raw, i + 2, j)
                replacement :: get(key) ?? ""
                loop item in replacement.bytes() -> &out.push(item)
                i = j + 1
                next
            }
            j := i + 1
            loop {
                if j >= raw.len() || !is_env_ident(raw[j]) -> break
                j = j + 1
            }
            if j == i + 1 {
                &out.push(byte)
                i = i + 1
                next
            }
            key :: slice_ascii(raw, i + 1, j)
            replacement :: get(key) ?? ""
            loop item in replacement.bytes() -> &out.push(item)
            i = j
            next
        }
        if byte == (U8{37}) {
            j := i + 1
            loop {
                if j >= raw.len() -> break
                if raw[j] == (U8{37}) -> break
                j = j + 1
            }
            if j < raw.len() && raw[j] == (U8{37}) && j > i + 1 {
                key :: slice_ascii(raw, i + 1, j)
                replacement :: get(key) ?? ""
                loop item in replacement.bytes() -> &out.push(item)
                i = j + 1
                next
            }
        }
        &out.push(byte)
        i = i + 1
    }
}

pub fn pid() -[Env]> Int { core.sys.getpid() }

pub fn getpid() -[Env]> Int { core.sys.getpid() }

pub fn cpu_count() -[Env]> Int {
    count :: core.sys.cpu_count()
    if count < 1 -> return 1
    count
}

pub fn getppid() -[Env]> Int { core.sys.getppid() }

pub fn getuid() -[Env]> Int { core.sys.getuid() }

pub fn geteuid() -[Env]> Int { core.sys.geteuid() }

pub fn getgid() -[Env]> Int { core.sys.getgid() }

pub fn getegid() -[Env]> Int { core.sys.getegid() }

pub fn getpgrp() -[Env]> Int { core.sys.getpgrp() }

pub fn umask(mask: Int) -[FS, Env]> Int {
    #Unsafe("posix umask: change the process file-creation mask") {
        return core.sys.umask(mask)
    }
}
pub fn exitcode(code: Int) -> Int { code }

pub fn success(code: Int) -> Bool { code == 0 }

pub fn uptime() -[Time, Env]> Float { core.sys.uptime() }

pub fn getgroups() -[Env]> [Int] { core.sys.getgroups() }

pub fn loadavg() -[Env]> [Float] { core.sys.loadavg() }

pub fn times() -[Env]> [Float] { core.sys.times() }

pub fn getpgid(pid: Int) -[Env]> Int IOError! {
    #Unsafe("posix getpgid: inspect a process group") {
        return core.sys.getpgid(pid)
    }
}

pub fn getsid(pid: Int) -[Env]> Int IOError! {
    #Unsafe("posix getsid: inspect a process session") {
        return core.sys.getsid(pid)
    }
}

pub fn getpriority(which: Int) -[Env]> Int IOError! {
    #Unsafe("posix getpriority: read process scheduling priority") {
        return core.sys.getpriority(which)
    }
}

pub fn setpriority(which: Int, priority: Int) IOError! -[Env]> {
    #Unsafe("posix setpriority: change process scheduling priority") {
        return core.sys.setpriority(which, priority)
    }
}

pub fn utime(path: String, atime: Int, mtime: Int) IOError! -[FS, Env]> {
    #Unsafe("posix utime: change file timestamps") {
        return core.sys.utime(path, atime, mtime)
    }
}

pub fn sync() -[FS, Env]> { core.sys.sync() }

pub fn stop(code: Int) -[Env]> {
    #Unsafe("posix stop: terminate the process with an exit code") {
        core.sys.stop(code)
    }
}

pub fn set_current_dir(path: String) IOError! -[FS, Env]> {
    return core.sys.set_current_dir(path)
}
pub fn pipe() -[FS, Env]> [Int] IOError! {
    #Unsafe("posix pipe: create process file descriptors") {
        return core.sys.pipe()
    }
}

pub fn close_fd(fd: Int) -[FS, Env]> {
    #Unsafe("posix close_fd: close a process file descriptor") {
        core.sys.close_fd(fd)
    }
}

pub fn mkfifo(path: String, mode: Int) IOError! -[FS, Env]> {
    #Unsafe("posix mkfifo: create a named pipe") {
        return core.sys.mkfifo(path, mode)
    }
}

pub fn fork() -[Env]> Int IOError! {
    #Unsafe("posix fork: create a child process") {
        return core.sys.fork()
    }
}

pub fn setsid() -[Env]> Int IOError! {
    #Unsafe("posix setsid: create a process session") {
        return core.sys.setsid()
    }
}

pub fn wait() -[Env, Time.Wait]> Int IOError! {
    #Unsafe("posix wait: reap a child process") {
        return core.sys.wait()
    }
}

pub fn waitpid(pid: Int, options: Int) -[Env, Time.Wait]> Int IOError! {
    #Unsafe("posix waitpid: reap a selected child process") {
        return core.sys.waitpid(pid, options)
    }
}

pub fn setuid(uid: Int) IOError! -[Env]> {
    #Unsafe("posix setuid: change process credentials") {
        return core.sys.setuid(uid)
    }
}

pub fn setgid(gid: Int) IOError! -[Env]> {
    #Unsafe("posix setgid: change process credentials") {
        return core.sys.setgid(gid)
    }
}

pub fn setpgrp() IOError! -[Env]> {
    #Unsafe("posix setpgrp: change process group topology") {
        return core.sys.setpgrp()
    }
}

pub fn setpgid(pid: Int, pgid: Int) IOError! -[Env]> {
    #Unsafe("posix setpgid: change process group topology") {
        return core.sys.setpgid(pid, pgid)
    }
}

pub fn kill(pid: Int, signal: Int) IOError! -[Env]> {
    #Unsafe("posix kill: send a signal to a process") {
        return core.sys.kill(pid, signal)
    }
}

pub fn initgroups(user: String, group: Int) IOError! -[Env]> {
    #Unsafe("posix initgroups: change supplementary groups") {
        return core.sys.initgroups(user, group)
    }
}


pub fn platform() -[Env]> String { "{name()}-{arch()}" }

pub fn is_windows() -[Env]> Bool { family() == "windows" }

pub fn is_unix() -[Env]> Bool { family() == "unix" }

pub fn is_linux() -[Env]> Bool {
    platform_name :: ascii_lower(name())
    platform_name == "linux"
}

pub fn is_macos() -[Env]> Bool {
    platform_name :: ascii_lower(name())
    platform_name == "macos" || platform_name == "darwin" || platform_name == "osx"
}

pub fn uname() -[Env]> String { "{name()} {release()} {version()} {arch()}" }

pub fn sysname() -[Env]> String { name() }

pub fn machine() -[Env]> String { arch() }

pub fn getenv(name: String) -[Env]> String? { get(name) }

pub fn pathsep() -[Env]> String {
    if is_windows() -> return ";"
    ":"
}

pub fn linesep() -[Env]> String {
    if is_windows() -> return String.from_bytes([U8]{13, 10}) ?? ""
    "\n"
}
fn is_env_ident(byte: U8) -> Bool {
    n :: byte
    if n >= 65 && n <= 90 -> return true
    if n >= 97 && n <= 122 -> return true
    if n >= 48 && n <= 57 -> return true
    n == 95
}

fn slice_ascii(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    i := start
    loop {
        if i >= end -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}

fn ascii_lower(text: String) -> String {
    out := [U8]{}
    loop byte in text.bytes() {
        n :: byte
        if n >= 65 && n <= 90 -> &out.push(U8{n + 32}) else -> &out.push(byte)
    }
    String.from_bytes(out) ?? text
}
