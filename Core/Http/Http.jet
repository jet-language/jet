package: {
    name: "core.http"
    version: "0.0.1"
    edition: "2026"
    description: "HTTP client and server over core.net."
    license: "MIT"
    outputs: {
        http: .Library{ entry: http }
    }
}

use {
    core: core
    provider: core.http.client
    http_url: core.net.url
    json_codec: core.encoding.json
    core.files.[FileReader, FileWriter]
    routes: core.http.server
    core.http.server.[HTTPMux]
    core.prelude.[SourceLocation]
}
C_MAX_BODY_BYTES: 1048576
C_MAX_HEADER_BYTES: 32768
C_MAX_HEADER_LINE_BYTES: 8192
C_MAX_HEADER_COUNT: 100
C_MAX_REQUEST_LINE_BYTES: 8192
C_MAX_URL_BYTES: 8192
// core.http — bounded HTTP/1.1 message semantics.
//
// The host bridge remains only a typed request/response transport leaf.
// Method parsing, header/query/cookie codecs, request framing, response
// parsing, limits, and all deterministic convenience behavior are Jet.
client: module
server: module
#Error
HTTPError: enum {
    InvalidMethod
    InvalidURL
    InvalidHeader
    InvalidStatus
    BodyConsumed
    InvalidFraming
    UnsupportedEncoding
    Cancelled
    BodyTooLarge(limit: Int)
    Resolve(host: String)
    Connect(address: String)
    TLS(stage: String)
    Timeout(phase: String)
    Proxy(stage: String)
    Redirect(reason: String)
    Protocol(version: String)
    IO(operation: String)
    Policy(reason: String)
    ResourceUnavailable(resource: String)
    Internal(incident_id: String)
    UnsupportedTarget(operation: HTTPOperation)
}

Method: enum {
    Get
    Head
    Post
    Put
    Patch
    Delete
    Options
    Trace
    Connect
    Custom(String)

    /// The method named by `token`: a standard method is its own variant and
    /// any other RFC 9110 token is `Custom`. Methods are case-sensitive, so
    /// `get` is a custom method. An empty token or a non-token byte is
    /// InvalidMethod.
    custom: fn(token: String) -> Method HTTPError! {
        if !valid_method(token) -> return Err(.InvalidMethod)
        parsed: method_parse(token)
        if method_text(parsed) == token -> return Ok(parsed)
        Ok(Method.Custom(token))
    }

    impl Display { display: fn(self) -> String { method_text(self) } }
}

Version: enum {
    HTTP10
    HTTP11
    HTTP2
    HTTP3

    http_1_0: fn() -> Version Never! { Version.HTTP10 }
    http_1_1: fn() -> Version Never! { Version.HTTP11 }
    http_2: fn() -> Version Never! { Version.HTTP2 }

    impl Display { display: fn(self) -> String { version_text(self) } }
}

Status: struct {
    code: Int
    reason: String

    /// The status `code` with its reason phrase; a code outside 100..=599 is
    /// InvalidStatus.
    new: fn(code: Int) -> Status HTTPError! {
        if code < 100 || code > 599 -> return Err(.InvalidStatus)
        Ok(status(code))
    }

    impl Display { display: fn(self) -> String { "{self.code}" } }
}

Header: struct {
    name: String
    value: String
}

Headers: struct {
    fields: [Header]
}

/// A checked field name: one RFC 9110 token (`HeaderName.new`).
HeaderName: struct {
    __text: String

    /// `name` as a field name; a name that is not one token is InvalidHeader.
    new: fn(name: String) -> HeaderName HTTPError! {
        if !valid_header_name(name) -> return Err(.InvalidHeader)
        Ok(HeaderName{__text: name})
    }

    impl Display { display: fn(self) -> String { self.__text.copy() } }
}

/// A checked field value: HTAB, space, visible ASCII and obs-text bytes
/// (`HeaderValue.new`).
HeaderValue: struct {
    __text: String

    /// `value` as a field value; a control byte other than HTAB is
    /// InvalidHeader.
    new: fn(value: String) -> HeaderValue HTTPError! {
        if !client_header_value(value) -> return Err(.InvalidHeader)
        Ok(HeaderValue{__text: value})
    }

    impl Display { display: fn(self) -> String { self.__text.copy() } }
}

Body: enum {
    Empty
    Text(String)
    Bytes([U8])

    /// The body's bytes when there are at most `limit` (0..=1 GiB) of them.
    bytes: fn(self, limit: Int) -[Net]> [U8] HTTPError! { __body_bytes_within(self, limit) }

    /// The body as UTF-8 text when it has at most `limit` bytes.
    text: fn(self, limit: Int) -[Net]> String HTTPError! { __body_text_within(self, limit) }

    /// The body decoded from JSON when it has at most `limit` bytes; a body
    /// that is not the target's JSON is InvalidFraming.
    json: fn<Target: Decode>(self, limit: Int) -[Net]> Target HTTPError! {
        text: __body_text_within(self, limit) ?? return Err(err)
        json_codec.decode<Target>(text) ?? return Err(.InvalidFraming)
    }

    /// Write the body to `writer` when it has at most `limit` bytes; the
    /// count written.
    copy_to: fn(self, writer: &&FileWriter, limit: Int) -[Net, Time.Wait]> Int HTTPError! {
        raw: __body_bytes_within(self, limit) ?? return Err(err)
        out := writer.move()
        out.write_all(raw) ?? return Err(.IO{operation: "copy body"})
        out.flush() ?? return Err(.IO{operation: "copy body"})
        Ok(raw.len())
    }

    /// The body in pieces of at most `max_chunk` (1..=1 GiB) bytes.
    chunks: fn(self, max_chunk: Int{C_BODY_CHUNK_BYTES}) -[Net]> HTTPBodyChunks Never! {
        if max_chunk < 1 || max_chunk > C_MAX_CONSUME_BYTES -> return HTTPBodyChunks{__bytes: [U8]{}, __max: 1, __error: Val(HTTPError.BodyTooLarge{limit: 0})}
        HTTPBodyChunks{__bytes: body_as_bytes(self), __max: max_chunk}
    }
}

C_MAX_CONSUME_BYTES: 1073741824
C_BODY_CHUNK_BYTES: 65536

// A message body is read once, shared by every copy of its message: the
// first `text`/`json` read takes it and later reads fail with BodyConsumed.
__HTTPBodyCell: struct { taken: Bool }

// A server request carries its connection's plain TCP socket (-1 over TLS),
// shared by every copy, so core.net.ws.upgrade can take the connection over.
// An upgraded connection gets no HTTP response from the server.
__HTTPUpgradeCell: struct {
    fd: Int
    upgraded: Bool
}

/// One HTTP request: what a client builds and sends, and what a server
/// parses and routes. The method, path, body and headers are public facts;
/// the rest is the client's send configuration and the server's route state.
HTTPRequest: struct {
    method: String
    path: String
    body: Body
    headers: Headers
    __url: String{""}
    __trailers: Headers?{None}
    __header_error: HTTPError?{None}
    __body_set: Bool{false}
    __params: [Header]{[]}
    __route_template: String?{None}
    __timeout_ms: Int?{None}
    __connect_timeout_ms: Int?{None}
    __read_timeout_ms: Int?{None}
    __total_timeout_ms: Int?{None}
    __dns_timeout_ms: Int?{None}
    __tls_timeout_ms: Int?{None}
    __write_timeout_ms: Int?{None}
    __first_byte_timeout_ms: Int?{None}
    __redirects: Int?{None}
    __proxy: String?{None}
    __cookies: [Header]{[]}
    __form: [Header]{[]}
    __multipart: [Header]{[]}
    __cell: Shared<__HTTPBodyCell>?{None}
    __upgrade: Shared<__HTTPUpgradeCell>?{None}

    method: fn(self) -> String Never! { self.method.copy() }
    path: fn(self) -> String Never! { self.path.copy() }
    body: fn(self) -> Body Never! { self.body.copy() }

    /// The body as text, at most `limit` bytes; the first read takes the body.
    text: fn(self, limit: Int{C_MAX_BODY_BYTES}) -> String HTTPError! {
        _: __take_body(self.__cell, None) ?? return Err(err)
        __body_text_within(self.body, limit)
    }

    /// The body decoded from JSON (1 MiB bound); the first read takes the body.
    json: fn<Target: Decode>(self) -> Target HTTPError! {
        _: __take_body(self.__cell, None) ?? return Err(err)
        text: __body_text_within(self.body, C_MAX_BODY_BYTES) ?? return Err(err)
        json_codec.decode<Target>(text) ?? return Err(.InvalidFraming)
    }

    trailers: fn(self) -[Net]> Headers HTTPError! { Ok(self.__trailers ?? headers()) }

    param: fn(self, name: String) -[Net]> String? Never! {
        loop pair in self.__params {
            if pair.name == name -> return Val(pair.value)
        }
        None
    }

    // A typed route input: the path parameter, else the query field. The
    // text decodes as a JSON string first, then as a JSON value; an absent
    // input decodes `null`, so only optional targets accept it.
    __route_input: fn<Target: Decode>(self, name: String) -> Target? {
        if __route_text(self, name) == .Val(text) {
            quoted: json_codec.to_string(text.encode()) ?? return None
            if json_codec.decode<Target>(quoted) == .Ok(value) -> return Val(value)
            if json_codec.decode<Target>(text) == .Ok(value) -> return Val(value)
            return None
        }
        if json_codec.decode<Target>("null") == .Ok(value) -> return Val(value)
        None
    }

    // The answer when a typed route input does not decode.
    __route_rejected: fn(self) -> HTTPResponse Never! {
        payload: body_text("400 Bad Request")
        fields: headers()
        __response(400, payload, fields)
    }

    header: fn(self, name: String) -> String? Never! { headers_get(self.headers, name) }

    // `header(name, value)`: an invalid name or value fails the send.
    __with_header: fn(self, name: String, value: String) -[Net]> HTTPRequest Never! {
        out := self.copy()
        if !client_header_name(name) || !client_header_value(value) {
            out.__header_error = Val(HTTPError.InvalidHeader)
            return out
        }
        out.headers.fields.push(Header{name: name, value: value})
        out
    }

    // `body(text)`.
    __with_body: fn(self, text: String) -[Net]> HTTPRequest Never! { self.__with_body_value(Body.Text(text)) }

    // `with_body(request, body)`: any body, bytes kept as bytes.
    __with_body_value: fn(self, body: Body) -> HTTPRequest Never! {
        out := self.copy()
        out.body = body
        out.__body_set = true
        out
    }

    // `json(value)`: the value's JSON as the body, typed application/json.
    __with_json: fn<Value: Encode>(self, value: Value) -[Net]> HTTPRequest Never! {
        out := self.copy()
        if json_codec.to_string(value) == {
            .Ok(text) -> {
                out.body = Body.Bytes(text.bytes())
                out.__body_set = true
                out.headers = headers_set_raw(out.headers, "content-type", "application/json")
            }
            .Err(_) -> out.__header_error = Val(HTTPError.InvalidFraming)
        }
        out
    }

    timeout: fn(self, ms: Int) -[Net]> HTTPRequest Never! {
        out := self.copy()
        out.__timeout_ms = Val(ms)
        out
    }
    connect_timeout: fn(self, ms: Int) -[Net]> HTTPRequest Never! {
        out := self.copy()
        out.__connect_timeout_ms = Val(ms)
        out
    }
    read_timeout: fn(self, ms: Int) -[Net]> HTTPRequest Never! {
        out := self.copy()
        out.__read_timeout_ms = Val(ms)
        out
    }
    total_timeout: fn(self, ms: Int) -[Net]> HTTPRequest Never! {
        out := self.copy()
        out.__total_timeout_ms = Val(ms)
        out
    }
    dns_timeout: fn(self, ms: Int) -[Net]> HTTPRequest Never! {
        out := self.copy()
        out.__dns_timeout_ms = Val(ms)
        out
    }
    tls_timeout: fn(self, ms: Int) -[Net]> HTTPRequest Never! {
        out := self.copy()
        out.__tls_timeout_ms = Val(ms)
        out
    }
    write_timeout: fn(self, ms: Int) -[Net]> HTTPRequest Never! {
        out := self.copy()
        out.__write_timeout_ms = Val(ms)
        out
    }
    first_byte_timeout: fn(self, ms: Int) -[Net]> HTTPRequest Never! {
        out := self.copy()
        out.__first_byte_timeout_ms = Val(ms)
        out
    }
    redirects: fn(self, limit: Int) -[Net]> HTTPRequest Never! {
        out := self.copy()
        out.__redirects = Val(limit)
        out
    }
    proxy: fn(self, url: String) -[Net]> HTTPRequest Never! {
        out := self.copy()
        out.__proxy = Val(url)
        out
    }
    cookie: fn(self, name: String, value: String) -[Net]> HTTPRequest Never! {
        out := self.copy()
        out.__cookies.push(Header{name: name, value: value})
        out
    }
    form: fn(self, name: String, value: String) -[Net]> HTTPRequest Never! {
        out := self.copy()
        out.__form.push(Header{name: name, value: value})
        out
    }
    multipart_text: fn(self, name: String, value: String) -[Net]> HTTPRequest Never! {
        out := self.copy()
        out.__multipart.push(Header{name: name, value: value})
        out
    }

    send: fn(self) -[Net, Time.Wait]> HTTPResponse HTTPError! { provider.__send(self) }

    body_len: fn(self) -> Int Never! { body_len(self.body) }
    under_limit: fn(self, limit: Int) -> Bool Never! { body_len(self.body) <= limit }
}

/// One HTTP response: the status, body and headers, plus the client's
/// transport facts (redirects followed, phase timings, connection reuse).
HTTPResponse: struct {
    status: Int
    body: Body
    headers: Headers
    __trailers: Headers?{None}
    __redirect_history: [String]{[]}
    __timings: [Int]{[]}
    __reused: Bool{false}
    __raw_encoding: String?{None}
    __body_error: HTTPError?{None}
    __cell: Shared<__HTTPBodyCell>?{None}

    status: fn(self) -> Int Never! { self.status }
    body: fn(self) -> Body Never! { self.body.copy() }

    /// The body as text, at most `limit` bytes; the first read takes the body.
    text: fn(self, limit: Int{C_MAX_BODY_BYTES}) -[Net]> String HTTPError! {
        _: __take_body(self.__cell, self.__body_error) ?? return Err(err)
        self.body.text(limit)
    }

    /// The body decoded from JSON, at most `limit` bytes; the first read
    /// takes the body.
    json: fn<Target: Decode>(self, limit: Int{C_MAX_BODY_BYTES}) -[Net]> Target HTTPError! {
        _: __take_body(self.__cell, self.__body_error) ?? return Err(err)
        self.body.json<Target>(limit)
    }

    header: fn(self, name: String) -> String? Never! { headers_get(self.headers, name) }

    // `header(name, value)` appends one field; an invalid one is dropped.
    __with_header: fn(self, name: String, value: String) -> HTTPResponse Never! {
        out := self.copy()
        if !client_header_name(name) || !client_header_value(value) -> return out
        out.headers.fields.push(Header{name: name, value: value})
        out
    }

    trailers: fn(self, fields: &&Headers) -[Net]> HTTPResponse HTTPError! {
        loop field in fields.fields {
            if !client_header_name(field.name) || !client_header_value(field.value) -> return Err(.InvalidHeader)
        }
        out := self.copy()
        out.__trailers = Val(fields)
        Ok(out)
    }

    cookies: fn(self) -> [String] Never! { headers_all(self.headers, "set-cookie") }
    redirect_history: fn(self) -> [String] Never! { self.__redirect_history.copy() }
    timings: fn(self) -> [Int] Never! { self.__timings.copy() }
    reused_connection: fn(self) -> Bool Never! { self.__reused }
    raw_content_encoding: fn(self) -> String? Never! { self.__raw_encoding.copy() }
}

/// A body read in bounded pieces: `loop chunk in body.chunks(n)` yields each
/// piece of at most `n` bytes as `[U8] HTTPError!`.
HTTPBodyChunks: struct {
    __bytes: [U8]
    __max: Int
    __error: HTTPError?{None}

    impl Iterable {
        Iter: __HTTPBodyCursor

        iter: fn(&&self) -> __HTTPBodyCursor {
            __HTTPBodyCursor{bytes: self.__bytes, max: self.__max, at: 0, error: self.__error, done: false}
        }
    }
}

__HTTPBodyCursor: struct {
    bytes: [U8]
    max: Int
    at: Int
    error: HTTPError?
    done: Bool

    impl Iterator {
        Item: Result<[U8], HTTPError>

        next: fn(&self) -> Result<[U8], HTTPError>? {
            if self.done -> return None
            if self.error == .Val(error) {
                self.done = true
                return Val(Err(error))
            }
            if self.at >= self.bytes.len() {
                self.done = true
                return None
            }
            end: if self.bytes.len() - self.at > self.max -> self.at + self.max else -> self.bytes.len()
            piece: slice_b(self.bytes, self.at, end)
            self.at = end
            Val(Ok(piece))
        }
    }
}

__body_bytes_within: fn(body: Body, limit: Int) -> [U8] HTTPError! {
    if limit < 0 || limit > C_MAX_CONSUME_BYTES -> return Err(.BodyTooLarge{limit: limit})
    raw: body_as_bytes(body)
    if raw.len() > limit -> return Err(.BodyTooLarge{limit: limit})
    Ok(raw)
}

__body_text_within: fn(body: Body, limit: Int) -> String HTTPError! {
    raw: __body_bytes_within(body, limit) ?? return Err(err)
    String.from_bytes(raw) ?? return Err(.UnsupportedEncoding)
}

// The first read of a message body takes it; a transport failure met while
// the body arrived surfaces at that read, as the reference's lazy body did.
__take_body: fn(cell: Shared<__HTTPBodyCell>?, failure: HTTPError?) HTTPError! {
    if cell == .Val(state) {
        guard := state.guard_edit()
        if guard.value.taken -> return Err(.BodyConsumed)
        guard.value.taken = true
    }
    if failure == .Val(error) -> return Err(error)
    Ok()
}

__upgrade_cell: fn(fd: Int) -> Shared<__HTTPUpgradeCell> Never! {
    Shared{__HTTPUpgradeCell{fd: fd, upgraded: false}}
}

__upgraded: fn(cell: Shared<__HTTPUpgradeCell>) -> Bool Never! {
    guard: cell.guard_read()
    guard.value.upgraded
}

// The request's plain socket, taken at most once; None for a client request,
// a TLS connection or a connection already upgraded.
__upgrade_claim: fn(request: HTTPRequest) -> Int? Never! {
    cell: request.__upgrade ?? return None
    guard := cell.guard_edit()
    if guard.value.upgraded || guard.value.fd < 0 -> return None
    guard.value.upgraded = true
    Val(guard.value.fd)
}

__request: fn(method: String, url: String) -> HTTPRequest Never! {
    HTTPRequest{method: method, path: request_target_path(url), body: Body.Empty, headers: headers(), __url: url, __cell: Val(Shared{__HTTPBodyCell{taken: false}})}
}

__server_request: fn(method: String, path: String, body: Body, fields: Headers) -> HTTPRequest Never! {
    HTTPRequest{method: method, path: path, body: body, headers: fields, __url: path, __body_set: true, __cell: Val(Shared{__HTTPBodyCell{taken: false}})}
}

__response: fn(status: Int, body: &&Body, fields: &&Headers) -> HTTPResponse Never! {
    HTTPResponse{status: status, body: body, headers: fields, __cell: Val(Shared{__HTTPBodyCell{taken: false}})}
}

// A text response; an out-of-range status is a 500.
__text_response: fn(status: Int, text: String) -> HTTPResponse Never! {
    fields: headers()
    if status < 100 || status > 599 {
        fallback: body_text("500 Internal Server Error")
        return __response(500, fallback, fields)
    }
    payload: body_text(text)
    __response(status, payload, fields)
}

__client_response: fn(status: Int, body: Body, fields: Headers, redirect_history: [String], timings: [Int], reused: Bool, raw_encoding: String?, body_error: HTTPError?) -> HTTPResponse Never! {
    HTTPResponse{
        status: status, body: body, headers: fields,
        __redirect_history: redirect_history, __timings: timings, __reused: reused,
        __raw_encoding: raw_encoding, __body_error: body_error,
        __cell: Val(Shared{__HTTPBodyCell{taken: false}}),
    }
}

// The request target of an absolute URL: its path (`/` when empty) and
// query; any other text is taken as the target itself.
request_target_path: fn(url: String) -> String Never! {
    parsed: http_url.parse(url) ?? return url.copy()
    path := parsed.path()
    if path == "" -> path = "/"
    query: parsed.query()
    if query != "" -> return "{path}?{query}"
    path
}

// A route input's text: the matched path parameter, else the first query
// field of that name.
__route_text: fn(request: HTTPRequest, name: String) -> String? Never! {
    loop pair in request.__params {
        if pair.name == name -> return Val(pair.value)
    }
    raw: request.path.bytes()
    at: index_byte(raw, 63)
    if at < 0 -> return None
    // Strict: a route input can name an identity, so a
    // query that does not decode exactly gives no input.
    fields: query_decode_strict(slice_str(request.path, at + 1, raw.len())) ?? return None
    query_get(fields, name)
}

// RFC 9110 field-name token bytes.
client_header_name: fn(name: String) -> Bool Never! {
    raw: name.bytes()
    if raw.len() == 0 -> return false
    loop byte in raw {
        n: Int{byte}
        alnum: (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122)
        if !alnum && n != 33 && n != 35 && n != 36 && n != 37 && n != 38 && n != 39 && n != 42 && n != 43 && n != 45 && n != 46 && n != 94 && n != 95 && n != 96 && n != 124 && n != 126 -> return false
    }
    true
}

// Field-value bytes: HTAB, visible ASCII, space and obs-text.
client_header_value: fn(value: String) -> Bool Never! {
    loop byte in value.bytes() {
        n: Int{byte}
        if n != 9 && (n < 32 || n == 127) -> return false
    }
    true
}

// Set one field without the public setter's trimming or validation.
headers_set_raw: fn(h: Headers, name: String, value: String) -> Headers Never! {
    want: ascii_lower(name)
    fields := [Header]{}
    loop f in h.fields {
        if ascii_lower(f.name) != want -> fields.push(f.copy())
    }
    fields.push(Header{name: name, value: value})
    Headers{fields: fields}
}

/// A checked route table answered in process: `router.get(pattern, handler)`
/// and its sibling verbs register typed handlers, `dispatch` answers a
/// request without a listener, and `web.openapi(router)` renders the same
/// routes. Copies share the one route table; routes match as a mux's do.
HTTPRouter: struct {
    __mux: HTTPMux
    __state: Shared<__HTTPRouterState>

    // `router.get(pattern, handler)` and its sibling verbs land here with the
    // route's checked contract (sema sema_call_try_http_router). The route
    // registers on the router's mux, so duplicates, matching and
    // `web.openapi` are the mux's; the handler keeps its `Net`-only type.
    // `at` is the registering call's place, handed on to the mux.
    __route: fn(self, method: String, pattern: String, handler: &&fn(HTTPRequest) -[Net]> HTTPResponse HTTPError!, contract: String, at: SourceLocation{#caller}) Never! -[Net]> {
        state: self.__state
        index: __router_handler_count(self.__state)
        self.__mux.__route(method, pattern, (request: HTTPRequest) -> __router_call(state, index, request), contract, at)
        guard := self.__state.guard_edit()
        guard.value.handlers.push(__HTTPRouterHandler{call: handler.move()})
    }
}

// A router's handlers, in registration order: the `index`th is the handler
// of the mux's `index`th route.
__HTTPRouterState: struct {
    handlers: [__HTTPRouterHandler]
}

__HTTPRouterHandler: struct {
    call: fn(HTTPRequest) -[Net]> HTTPResponse HTTPError!
}

__router_handler_count: fn(state: Shared<__HTTPRouterState>) -> Int Never! {
    guard: state.guard_read()
    guard.value.handlers.len()
}

__router_call: fn(state: Shared<__HTTPRouterState>, index: Int, request: HTTPRequest) -[Net]> HTTPResponse HTTPError! {
    guard: state.guard_read()
    guard.value.handlers[index].call(request)
}

router: fn() -> HTTPRouter Never! {
    HTTPRouter{__mux: routes.__mux_new(), __state: Shared{__HTTPRouterState{handlers: [__HTTPRouterHandler]{}}}}
}

// The router's route table, for `web.openapi(router)`.
__router_mux: fn(router: HTTPRouter) -> HTTPMux Never! {
    router.__mux
}

// A request message, leniently: text without a blank line is taken as
// newline-separated head lines, and an unparseable message is `GET /`.
parse: fn(raw: String) -> HTTPRequest Never! {
    bytes := raw.bytes()
    if find_double_crlf(bytes) < 0 -> bytes = "{raw.replace("\n", "\r\n")}\r\n\r\n".bytes()
    parse_request(bytes) ?? __request("GET", "/")
}

// A request routed as a mux routes it, with no middleware or request id; a
// handler's error is the dispatch error.
dispatch: fn(router: HTTPRouter, request: HTTPRequest) -> HTTPResponse HTTPError! {
    pick: routes.__pick(router.__mux, request)
    if pick.answer == .Val(answer) -> return Ok(answer)
    __router_call(router.__state, pick.index, pick.request)
}

method_parse: fn(token: String) -> Method Never! {
    u: ascii_upper(token)
    if u == {
        "GET" -> Method.Get
        "HEAD" -> Method.Head
        "POST" -> Method.Post
        "PUT" -> Method.Put
        "PATCH" -> Method.Patch
        "DELETE" -> Method.Delete
        "OPTIONS" -> Method.Options
        "TRACE" -> Method.Trace
        "CONNECT" -> Method.Connect
        else -> Method.Custom(token)
    }
}

method_text: fn(method: Method) -> String Never! {
    if method == {
        Method.Get -> "GET"
        Method.Head -> "HEAD"
        Method.Post -> "POST"
        Method.Put -> "PUT"
        Method.Patch -> "PATCH"
        Method.Delete -> "DELETE"
        Method.Options -> "OPTIONS"
        Method.Trace -> "TRACE"
        Method.Connect -> "CONNECT"
        .Custom(s) -> s
        else -> "GET"
    }
}

version_text: fn(v: Version) -> String Never! {
    if v == {
        Version.HTTP10 -> "HTTP/1.0"
        Version.HTTP11 -> "HTTP/1.1"
        Version.HTTP2 -> "HTTP/2"
        Version.HTTP3 -> "HTTP/3"
        else -> "HTTP/3"
    }
}

version_parse: fn(token: String) -> Version Never! {
    if token == {
        "HTTP/1.0" -> Version.HTTP10
        "HTTP/2" -> Version.HTTP2
        "HTTP/3" -> Version.HTTP3
        "HTTP/1.1" -> Version.HTTP11
        else -> Version.HTTP11
    }
}

// Why a custom route method token was refused.
#Error
__MethodTokenError: struct { reason: String }

// The one check of a custom route method token (`mux.custom(token, …)`,
// `router.custom` and `#Server.Custom`): the compiler runs it on a static
// token while building and a mux runs it on a run-time token when the route
// registers. Any RFC 9110 token is a method, kept in its exact case; only a
// token that is exactly a standard method is refused, since that method has
// its own verb.
__method_token_check: fn(token: String) __MethodTokenError! -[]> {
    if !valid_method(token) -> return Err(__MethodTokenError{reason: "`{token}` is not an HTTP method token: a method is one or more letters, digits or characters of !#$%&'*+-.^_`|~"})
    standard: method_parse(token)
    if standard != Method.Custom(token.copy()) && method_text(standard) == token -> return Err(__MethodTokenError{reason: "`{token}` is a standard method, which registers with its own verb `{token.lower()}`"})
    Ok()
}

status: fn(code: Int) -> Status Never! { Status{code: code, reason: reason_phrase(code)} }
status_ok: fn() -> Status Never! { status(200) }
status_created: fn() -> Status Never! { status(201) }
status_no_content: fn() -> Status Never! { status(204) }
status_moved: fn() -> Status Never! { status(301) }
status_found: fn() -> Status Never! { status(302) }
status_bad_request: fn() -> Status Never! { status(400) }
status_unauthorized: fn() -> Status Never! { status(401) }
status_forbidden: fn() -> Status Never! { status(403) }
status_not_found: fn() -> Status Never! { status(404) }
status_timeout: fn() -> Status Never! { status(408) }
status_server_error: fn() -> Status Never! { status(500) }
status_continue: fn() -> Status Never! { status(100) }
status_switching: fn() -> Status Never! { status(101) }
status_accepted: fn() -> Status Never! { status(202) }
status_non_authoritative: fn() -> Status Never! { status(203) }
status_reset_content: fn() -> Status Never! { status(205) }
status_partial: fn() -> Status Never! { status(206) }
status_multi_status: fn() -> Status Never! { status(207) }
status_already_reported: fn() -> Status Never! { status(208) }
status_see_other: fn() -> Status Never! { status(303) }
status_not_modified: fn() -> Status Never! { status(304) }
status_temporary: fn() -> Status Never! { status(307) }
status_permanent: fn() -> Status Never! { status(308) }
status_payment_required: fn() -> Status Never! { status(402) }
status_method_not_allowed: fn() -> Status Never! { status(405) }
status_not_acceptable: fn() -> Status Never! { status(406) }
status_conflict: fn() -> Status Never! { status(409) }
status_gone: fn() -> Status Never! { status(410) }
status_length_required: fn() -> Status Never! { status(411) }
status_precondition_failed: fn() -> Status Never! { status(412) }
status_payload_too_large: fn() -> Status Never! { status(413) }
status_uri_too_long: fn() -> Status Never! { status(414) }
status_unsupported_media: fn() -> Status Never! { status(415) }
status_range_unsat: fn() -> Status Never! { status(416) }
status_expectation_failed: fn() -> Status Never! { status(417) }
status_teapot: fn() -> Status Never! { status(418) }
status_unprocessable: fn() -> Status Never! { status(422) }
status_locked: fn() -> Status Never! { status(423) }
status_failed_dependency: fn() -> Status Never! { status(424) }
status_too_early: fn() -> Status Never! { status(425) }
status_upgrade_required: fn() -> Status Never! { status(426) }
status_precondition_required: fn() -> Status Never! { status(428) }
status_too_many: fn() -> Status Never! { status(429) }
status_legal: fn() -> Status Never! { status(451) }
status_not_implemented: fn() -> Status Never! { status(501) }
status_bad_gateway: fn() -> Status Never! { status(502) }
status_unavailable: fn() -> Status Never! { status(503) }
status_gateway_timeout: fn() -> Status Never! { status(504) }
status_http_version: fn() -> Status Never! { status(505) }

is_informational: fn(s: Status) -> Bool Never! { s.code >= 100 && s.code < 200 }
is_success: fn(s: Status) -> Bool Never! { s.code >= 200 && s.code < 300 }
is_redirect: fn(s: Status) -> Bool Never! { s.code >= 300 && s.code < 400 }
is_client_error: fn(s: Status) -> Bool Never! { s.code >= 400 && s.code < 500 }
is_server_error: fn(s: Status) -> Bool Never! { s.code >= 500 && s.code < 600 }

headers: fn() -> Headers Never! { Headers{fields: [Header]{}} }

headers_get: fn(h: Headers, name: String) -> String? Never! {
    want: ascii_lower(name)
    loop f in h.fields {
        if ascii_lower(f.name) == want -> return Val(f.value)
    }
    None
}

headers_all: fn(h: Headers, name: String) -> [String] Never! {
    want: ascii_lower(name)
    out := [String]{}
    loop f in h.fields {
        if ascii_lower(f.name) == want -> out.push(f.value)
    }
    out
}

headers_set: fn(h: Headers, name: String, value: String) -> Headers Never! {
    if !valid_header_name(name) || has_ctl(value.bytes()) -> return h.copy()
    want: ascii_lower(name)
    fields := [Header]{}
    replaced := false
    loop f in h.fields {
        if ascii_lower(f.name) == want {
            if !replaced {
                fields.push(Header{name: name, value: trim(value)})
                replaced = true
            }
        } else {
            fields.push(f.copy())
        }
    }
    if !replaced -> fields.push(Header{name: name, value: trim(value)})
    Headers{fields: fields}
}

headers_append: fn(h: Headers, name: String, value: String) -> Headers Never! {
    if !valid_header_name(name) || has_ctl(value.bytes()) -> return h.copy()
    fields := [Header]{}
    loop f in h.fields -> fields.push(f.copy())
    fields.push(Header{name: name, value: trim(value)})
    Headers{fields: fields}
}

headers_remove: fn(h: Headers, name: String) -> Headers Never! {
    want: ascii_lower(name)
    fields := [Header]{}
    loop f in h.fields {
        if ascii_lower(f.name) != want -> fields.push(f.copy())
    }
    Headers{fields: fields}
}

headers_encode: fn(h: Headers) -> [String] Never! {
    out := [String]{}
    loop f in h.fields -> out.push("{f.name}: {f.value}")
    out
}

headers_parse: fn(lines: [String]) -> Headers Never! {
    h := headers()
    if !headers_lines_bounded(lines) -> return h
    loop line in lines {
        raw: line.bytes()
        col := index_byte(raw, 58)
        if col <= 0 -> next
        name_bytes: slice_b(raw, 0, col)
        value: slice_b(raw, col + 1, raw.len())
        name: String.from_bytes(name_bytes) ?? ""
        if valid_header_name(name) && !has_ctl(value) -> h = headers_append(h, name, String.from_bytes(value) ?? "")
    }
    h
}

body_empty: fn() -> Body Never! { Body.Empty }
body_text: fn(text: String) -> Body Never! {
    if text.bytes().len() == 0 -> return Body.Empty
    Body.Text(text)
}
body_bytes: fn(bytes: [U8]) -> Body Never! {
    if bytes.len() == 0 -> return Body.Empty
    Body.Bytes(bytes)
}

// The `http.Body.text(text, media_type)`, `http.Body.form(fields)` and
// `http.Body.json(value)` constructors: sema checks the call and runs these.
// A Body holds only its payload; a message names the media type in its own
// Content-Type field, so the typed text form keeps the text.
__body_typed_text: fn(text: String, _media_type: String) -> Body Never! { body_text(text) }

// application/x-www-form-urlencoded fields, in map order.
__body_form: fn(fields: [String:String]) -> Body Never! {
    pairs := [QueryPair]{}
    loop (name, value) in fields -> pairs.push(QueryPair{key: name.copy(), value: value.copy()})
    body_text(form_encode(Query{pairs: pairs}))
}

// Compact JSON text; a value with no JSON form (a NaN Float) stops the call.
__body_json: fn<T: Encode>(value: T) -> Body Never! {
    text: json_codec.to_string(value) ?? panic("http.Body.json: the value has no JSON form")
    body_text(text)
}

// `http.Body.reader(reader)`: the reader's bytes to end of file, at most
// 1 GiB (BodyTooLarge past it).
__body_reader: fn(reader: &&FileReader) -[FS.Read, Time.Wait]> Body HTTPError! {
    source := reader.move()
    __body_read(source, -1)
}

// `http.Body.reader(reader, length)`: exactly `length` (at most 1 GiB) of the
// reader's bytes. A negative length, or a reader that ends short, is
// InvalidFraming.
__body_reader_sized: fn(reader: &&FileReader, length: Int) -[FS.Read, Time.Wait]> Body HTTPError! {
    source := reader.move()
    if length < 0 -> return Err(.InvalidFraming)
    if length > C_MAX_CONSUME_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_CONSUME_BYTES})
    __body_read(source, length)
}

// Up to `want` bytes of `source` (to end of file when `want` is -1).
__body_read: fn(source: &FileReader, want: Int) -[FS.Read, Time.Wait]> Body HTTPError! {
    cap: if want >= 0 -> want else -> C_MAX_CONSUME_BYTES + 1
    out := [U8]{}
    loop out.len() < cap {
        room: cap - out.len()
        piece: source.read(if room > C_BODY_CHUNK_BYTES -> C_BODY_CHUNK_BYTES else -> room) ?? return Err(.IO{operation: "read body"})
        if piece.len() == 0 -> break
        out.extend(piece)
    }
    if want >= 0 && out.len() != want -> return Err(.InvalidFraming)
    if out.len() > C_MAX_CONSUME_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_CONSUME_BYTES})
    Ok(body_bytes(out))
}

// `http.Body.multipart(fields)`: multipart/form-data text fields in map
// order, delimited by the first `jet-http-boundary-%016x` no field contains.
// The body's first line is `--` and that boundary; the message names it in
// its Content-Type field (`multipart/form-data; boundary=...`).
__body_multipart: fn(fields: [String:String]) -> Body Never! {
    pairs := [Header]{}
    loop (name, value) in fields -> pairs.push(Header{name: name.copy(), value: value.copy()})
    body_text(provider.__client_multipart(pairs, provider.__client_boundary(pairs)))
}

body_as_text: fn(body: Body) -> String Never! {
    if body == Body.Empty -> return ""
    if body == {
        .Text(s) -> return s
        .Bytes(xs) -> return String.from_bytes(xs) ?? ""
        .Empty -> return ""
    }
    ""
}

body_as_bytes: fn(body: Body) -> [U8] Never! {
    if body == {
        .Empty -> return [U8]{}
        .Text(s) -> return body_as_text(Body.Text(s)).bytes()
        .Bytes(xs) -> return xs
    }
    [U8]{}
}
body_len: fn(body: Body) -> Int Never! { body_as_bytes(body).len() }

reason_phrase: fn(code: Int) -> String Never! {
    if code == {
        100 -> return "Continue"
        101 -> return "Switching Protocols"
        102 -> return "Processing"
        103 -> return "Early Hints"
        200 -> return "OK"
        201 -> return "Created"
        202 -> return "Accepted"
        203 -> return "Non-Authoritative Information"
        204 -> return "No Content"
        205 -> return "Reset Content"
        206 -> return "Partial Content"
        207 -> return "Multi-Status"
        208 -> return "Already Reported"
        226 -> return "IM Used"
        300 -> return "Multiple Choices"
        301 -> return "Moved Permanently"
        302 -> return "Found"
        303 -> return "See Other"
        304 -> return "Not Modified"
        305 -> return "Use Proxy"
        307 -> return "Temporary Redirect"
        308 -> return "Permanent Redirect"
        400 -> return "Bad Request"
        401 -> return "Unauthorized"
        402 -> return "Payment Required"
        403 -> return "Forbidden"
        404 -> return "Not Found"
        405 -> return "Method Not Allowed"
        406 -> return "Not Acceptable"
        407 -> return "Proxy Authentication Required"
        408 -> return "Request Timeout"
        409 -> return "Conflict"
        410 -> return "Gone"
        411 -> return "Length Required"
        412 -> return "Precondition Failed"
        413 -> return "Payload Too Large"
        414 -> return "URI Too Long"
        415 -> return "Unsupported Media Type"
        416 -> return "Range Not Satisfiable"
        417 -> return "Expectation Failed"
        418 -> return "I'm a teapot"
        421 -> return "Misdirected Request"
        422 -> return "Unprocessable Entity"
        423 -> return "Locked"
        424 -> return "Failed Dependency"
        425 -> return "Too Early"
        426 -> return "Upgrade Required"
        428 -> return "Precondition Required"
        429 -> return "Too Many Requests"
        431 -> return "Request Header Fields Too Large"
        451 -> return "Unavailable For Legal Reasons"
        500 -> return "Internal Server Error"
        501 -> return "Not Implemented"
        502 -> return "Bad Gateway"
        503 -> return "Service Unavailable"
        504 -> return "Gateway Timeout"
        505 -> return "HTTP Version Not Supported"
        506 -> return "Variant Also Negotiates"
        507 -> return "Insufficient Storage"
        508 -> return "Loop Detected"
        510 -> return "Not Extended"
        511 -> return "Network Authentication Required"
        else -> { _ := 0 }
    }
    if code >= 500 -> return "Error"
    if code >= 400 -> return "Bad Request"
    if code >= 300 -> return "Redirect"
    return "OK"
}

ascii_upper: fn(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n: Int.from_u8(b)
        if n >= 97 && n <= 122 -> out.push(U8{n - 32}) else -> out.push(b)
    }
    String.from_bytes(out) ?? text
}

ascii_lower: fn(text: String) -> String Never! {
    out := [U8]{}
    loop b in text.bytes() {
        n: Int.from_u8(b)
        if n >= 65 && n <= 90 -> out.push(U8{n + 32}) else -> out.push(b)
    }
    String.from_bytes(out) ?? text
}

trim: fn(text: String) -> String Never! {
    raw: text.bytes()
    start := 0
    end := raw.len()
    loop start < end {
        n: Int.from_u8(raw[start])
        if n == 32 || n == 9 || n == 13 || n == 10 -> start = start + 1 else -> break
    }
    loop end > start {
        n: Int.from_u8(raw[end - 1])
        if n == 32 || n == 9 || n == 13 || n == 10 -> end = end - 1 else -> break
    }
    if end <= start -> return ""
    String.from_bytes(slice_b(raw, start, end)) ?? ""
}


get: fn(url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    if !valid_url(url) -> return Err(.InvalidURL)
    provider.get(url)
}

post: fn(url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    if !valid_url(url) -> return Err(.InvalidURL)
    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_BODY_BYTES})
    provider.post(url, body)
}

put: fn(url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    if !valid_url(url) -> return Err(.InvalidURL)
    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_BODY_BYTES})
    req := core.http.client.request("PUT", url)
    send_request(req.__with_body(body))
}

patch: fn(url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    if !valid_url(url) -> return Err(.InvalidURL)
    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_BODY_BYTES})
    req := core.http.client.request("PATCH", url)
    send_request(req.__with_body(body))
}

delete: fn(url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    if !valid_url(url) -> return Err(.InvalidURL)
    req := core.http.client.request("DELETE", url)
    send_request(req)
}

head: fn(url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    if !valid_url(url) -> return Err(.InvalidURL)
    req := core.http.client.request("HEAD", url)
    send_request(req)
}


exchange: fn(method: String, url: String, body: String, header_lines: [String]) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    if !valid_method_token(method) -> return Err(.InvalidMethod)
    if !valid_url(url) -> return Err(.InvalidURL)
    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_BODY_BYTES})
    if !headers_lines_bounded(header_lines) || !headers_lines_valid(header_lines) -> return Err(.InvalidHeader)
    parsed: headers_parse(header_lines)
    send_request(request_with(method_parse(method), url, parsed, body_text(body)))
}

send_request: fn(req: HTTPRequest) -[Net, Time.Wait]> HTTPResponse HTTPError! {
    provider.send(req)
}

parse_response: fn(url: String, raw: [U8]) -> HTTPResponse HTTPError! {
    split := find_double_crlf(raw)
    if split < 0 -> return Err(.InvalidFraming)
    if !strict_crlf(raw, split) -> return Err(.InvalidFraming)
    head_end: header_text_end(raw, split)
    if head_end > C_MAX_HEADER_BYTES -> return Err(.InvalidHeader)
    head: String.from_bytes(slice_b(raw, 0, head_end)) ?? return Err(.Protocol{version: "HTTP"})
    if raw.len() - split > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_BODY_BYTES})
    body_raw: slice_b(raw, split, raw.len())
    lines: split_lines(head)
    if lines.len() == 0 || lines[0].bytes().len() > C_MAX_REQUEST_LINE_BYTES -> return Err(.InvalidStatus)
    parsed: parse_status_line(lines[0]) ?? return Err(.InvalidStatus)
    hdr_lines := [String]{}
    loop i in 1..<lines.len() {
        if lines[i].bytes().len() > 0 -> hdr_lines.push(lines[i])
    }
    if !headers_lines_bounded(hdr_lines) || !headers_lines_valid(hdr_lines) -> return Err(.InvalidHeader)
    h := headers_parse(hdr_lines)
    if has_ambiguous_framing(h) -> return Err(.InvalidFraming)
    if has_unsupported_encoding(h) -> return Err(.UnsupportedEncoding)
    if response_forbids_content_length(parsed.status.code) && has_header(h, "content-length") -> return Err(.InvalidFraming)
    expected: content_length(h)
    if parsed.status.code != 304 && (expected > C_MAX_BODY_BYTES || (expected >= 0 && expected != body_raw.len())) -> return Err(.InvalidFraming)
    if response_forbids_body(parsed.status.code) && body_raw.len() > 0 -> return Err(.InvalidFraming)
    body_text: String.from_bytes(body_raw) ?? return Err(.UnsupportedEncoding)
    parsed_response := __text_response(parsed.status.code, body_text)
    loop line in hdr_lines {
        col := index_byte(line.bytes(), 58)
        name: String.from_bytes(slice_b(line.bytes(), 0, col)) ?? return Err(.InvalidHeader)
        value: String.from_bytes(slice_b(line.bytes(), col + 1, line.bytes().len())) ?? return Err(.InvalidHeader)
        parsed_response = parsed_response.__with_header(name, trim(value))
    }
    Ok(parsed_response)
}

parse_request: fn(raw: [U8]) -> HTTPRequest HTTPError! {
    split := find_double_crlf(raw)
    if split < 0 -> return Err(.InvalidFraming)
    if !strict_crlf(raw, split) -> return Err(.InvalidFraming)
    head_end: header_text_end(raw, split)
    if head_end > C_MAX_HEADER_BYTES -> return Err(.InvalidHeader)
    head: String.from_bytes(slice_b(raw, 0, head_end)) ?? return Err(.Protocol{version: "HTTP"})
    if raw.len() - split > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{limit: C_MAX_BODY_BYTES})
    body_len: raw.len() - split
    lines: split_lines(head)
    if lines.len() == 0 || lines[0].bytes().len() > C_MAX_REQUEST_LINE_BYTES -> return Err(.InvalidMethod)
    parts: split_space_line(lines[0])
    if parts.len() != 3 -> return Err(.InvalidMethod)
    if !valid_method(parts[0]) -> return Err(.InvalidMethod)
    if parts[0] == "CONNECT" {
        if !valid_connect_target(parts[1]) -> return Err(.InvalidURL)
    } else {
        if !valid_target(parts[1]) -> return Err(.InvalidURL)
        if parts[1] == "*" && parts[0] != "OPTIONS" -> return Err(.InvalidURL)
    }
    parsed_version: version_parse(parts[2])
    if version_text(parsed_version) != parts[2] -> return Err(.Protocol{version: parts[2]})
    if parsed_version == Version.HTTP2 || parsed_version == Version.HTTP3 -> return Err(.Protocol{version: parts[2]})
    hlines := [String]{}
    loop i in 1..<lines.len() {
        if lines[i].bytes().len() > 0 -> hlines.push(lines[i])
    }
    if !headers_lines_bounded(hlines) || !headers_lines_valid(hlines) -> return Err(.InvalidHeader)
    h := headers_parse(hlines)
    hosts := headers_all(h, "host")
    if parsed_version == Version.HTTP11 {
        if hosts.len() != 1 || !valid_host_value(hosts[0]) -> return Err(.InvalidHeader)
    } else {
        loop host in hosts {
            if !valid_host_value(host) -> return Err(.InvalidHeader)
        }
    }
    if has_ambiguous_framing(h) -> return Err(.InvalidFraming)
    if has_unsupported_encoding(h) -> return Err(.UnsupportedEncoding)
    expected: content_length(h)
    if expected > C_MAX_BODY_BYTES || (expected >= 0 && expected != body_len) || (expected < 0 && body_len > 0) -> return Err(.InvalidFraming)
    fields := headers()
    loop line in hlines {
        col := index_byte(line.bytes(), 58)
        name: String.from_bytes(slice_b(line.bytes(), 0, col)) ?? return Err(.InvalidHeader)
        value: String.from_bytes(slice_b(line.bytes(), col + 1, line.bytes().len())) ?? return Err(.InvalidHeader)
        fields.fields.push(Header{name: name, value: trim(value)})
    }
    // The body stays the wire bytes, sliced once after every length check
    // (#4428, #4431). A read as text decodes it then, so a binary upload parses.
    body_raw: slice_b(raw, split, raw.len())
    body: if body_len > 0 -> Body.Bytes(body_raw) else -> Body.Empty
    // The method stays as sent: methods are case-sensitive, so `get` is not
    // `GET` (the server reads it the same way).
    Ok(__server_request(parts[0], parts[1], body, fields))
}

StatusLine: struct {
    version: Version
    status: Status
}

parse_status_line: fn(line: String) -> StatusLine? {
    if has_line_ctl(line.bytes()) -> return None
    parts: split_space_line(line)
    if parts.len() < 2 -> return None
    parsed_version: version_parse(parts[0])
    if version_text(parsed_version) != parts[0] -> return None
    if parsed_version == Version.HTTP2 || parsed_version == Version.HTTP3 -> return None
    if parts[1].bytes().len() != 3 -> return None
    code: parse_decimal(parts[1]) ?? return None
    if code < 100 || code > 599 -> return None
    reason := reason_phrase(code)
    if parts.len() > 2 {
        reason = parts[2]
        i := 3
        loop i < parts.len() {
            reason = "{reason} {parts[i]}"
            i = i + 1
        }
    }
    Val(StatusLine{version: parsed_version, status: Status{code: code, reason: reason}})
}

split_space_line: fn(text: String) -> [String] Never! {
    raw: text.bytes()
    out := [String]{}
    if raw.len() == 0 -> return out
    start := 0
    i := 0
    loop i < raw.len() {
        n: Int.from_u8(raw[i])
        if n == 32 {
            if i == start -> return [String]{}
            out.push(String.from_bytes(slice_b(raw, start, i)) ?? "")
            start = i + 1
        } else if n < 32 || n == 127 {
            return [String]{}
        }
        i = i + 1
    }
    if start == raw.len() -> return [String]{}
    out.push(String.from_bytes(slice_b(raw, start, raw.len())) ?? "")
    out
}

find_double_crlf: fn(raw: [U8]) -> Int Never! {
    if raw.len() < 4 -> return -1
    i := 0
    loop i + 3 < raw.len() {
        if raw[i] == (U8{13}) && raw[i + 1] == (U8{10}) && raw[i + 2] == (U8{13}) && raw[i + 3] == (U8{10}) -> return i + 4
        i = i + 1
    }
    -1
}


header_text_end: fn(raw: [U8], split: Int) -> Int Never! {
    if split >= 4 && raw[split - 4] == (U8{13}) -> return split - 4
    split - 2
}
strict_crlf: fn(raw: [U8], end: Int) -> Bool Never! {
    i := 0
    loop i < end {
        if raw[i] == (U8{13}) {
            if i + 1 >= end || raw[i + 1] != (U8{10}) -> return false
        } else if raw[i] == (U8{10}) {
            if i == 0 || raw[i - 1] != (U8{13}) -> return false
        }
        i = i + 1
    }
    true
}

split_lines: fn(text: String) -> [String] Never! {
    raw: text.bytes()
    out := [String]{}
    start := 0
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{10}) {
            end := i
            if end > start && raw[end - 1] == (U8{13}) -> end = end - 1
            out.push(String.from_bytes(slice_b(raw, start, end)) ?? "")
            start = i + 1
        }
        i = i + 1
    }
    if start < raw.len() -> out.push(String.from_bytes(slice_b(raw, start, raw.len())) ?? "")
    out
}


Cookie: struct {
    name: String
    value: String
    domain: String
    path: String
    secure: Bool
    http_only: Bool
    same_site: String
    max_age: Int
}

Query: struct {
    pairs: [QueryPair]
}

QueryPair: struct {
    key: String
    value: String
}

query: fn() -> Query Never! { Query{pairs: [QueryPair]{}} }

query_get: fn(q: Query, key: String) -> String? Never! {
    loop p in q.pairs {
        if p.key == key -> return Val(p.value)
    }
    None
}

query_all: fn(q: Query, key: String) -> [String] Never! {
    out := [String]{}
    loop p in q.pairs {
        if p.key == key -> out.push(p.value)
    }
    out
}

query_set: fn(q: Query, key: String, value: String) -> Query Never! {
    pairs := [QueryPair]{}
    replaced := false
    loop p in q.pairs {
        if p.key == key {
            if !replaced {
                pairs.push(QueryPair{key: key, value: value})
                replaced = true
            }
        } else {
            pairs.push(p.copy())
        }
    }
    if !replaced {
        pairs.push(QueryPair{key: key, value: value})
    }
    Query{pairs: pairs}
}

query_encode: fn(q: Query) -> String Never! {
    s := ""
    first := true
    loop p in q.pairs {
        piece: "{percent_encode(p.key)}={percent_encode(p.value)}"
        piece_len := piece.bytes().len()
        if piece_len > C_MAX_BODY_BYTES -> return ""
        if first {
            s = piece
            first = false
        } else {
            if s.bytes().len() + piece_len + 1 > C_MAX_BODY_BYTES -> return ""
            s = "{s}&{piece}"
        }
    }
    s
}

// Form and query decoding. One splitter and
// one scanner serve every entry point. Tolerant decoding follows the WHATWG
// application/x-www-form-urlencoded parser: + is a space, %HH is one byte, a
// broken escape such as %QZ stays as written, and bytes that are not UTF-8
// become U+FFFD, one per maximal invalid subpart. Strict decoding refuses
// both instead; code whose decoded value picks a file, path, account or other
// identity uses it, since %FF and %FE both read as U+FFFD when tolerant.
FormPolicy: enum {
    Tolerant
    Strict
}

// Why a strict form or query decode refused its input.
#Error
FormDecodeError: enum {
    // A % not followed by two hex digits.
    Escape
    // Decoded bytes that are not UTF-8.
    UTF8
    // Input above 1 MiB.
    TooLarge
}

// The fields of a query or form, in order: one leading ? is stripped, empty
// segments are skipped, a field without = has an empty value, and an empty
// name and duplicate names are kept. Above 1 MiB a tolerant split is an
// empty Query.
__form_split: fn(text: String, policy: FormPolicy) -> Query FormDecodeError! {
    raw: text.bytes()
    if raw.len() > C_MAX_BODY_BYTES {
        if policy == FormPolicy.Strict -> return Err(.TooLarge)
        return Ok(query())
    }
    pairs := [QueryPair]{}
    start := 0
    if raw.len() > 0 && raw[0] == (U8{63}) -> start = 1
    i := start
    loop i <= raw.len() {
        if i == raw.len() || raw[i] == (U8{38}) {
            if i > start {
                eq := start
                loop eq < i && raw[eq] != (U8{61}) -> eq = eq + 1
                value_start: if eq < i -> eq + 1 else -> i
                key: __form_scan(raw, start, eq, policy) ?? return Err(err)
                value: __form_scan(raw, value_start, i, policy) ?? return Err(err)
                pairs.push(QueryPair{key: key, value: value})
            }
            start = i + 1
        }
        i = i + 1
    }
    Ok(Query{pairs: pairs})
}

// Decodes raw[from..<to], one form component, once: %252F is %2F.
__form_scan: fn(raw: [U8], from: Int, to: Int, policy: FormPolicy) -> String FormDecodeError! {
    out := [U8]{}
    i := from
    loop i < to {
        b: raw[i]
        if b == (U8{43}) {
            out.push(U8{32})
            i = i + 1
            next
        }
        if b == (U8{37}) {
            if i + 2 < to {
                hi: from_hex(raw[i + 1])
                lo: from_hex(raw[i + 2])
                if hi >= 0 && lo >= 0 {
                    out.push(U8{hi * 16 + lo})
                    i = i + 3
                    next
                }
            }
            if policy == FormPolicy.Strict -> return Err(.Escape)
        }
        out.push(b)
        i = i + 1
    }
    if policy == FormPolicy.Strict -> return Ok(String.from_bytes(out) ?? return Err(.UTF8))
    Ok(String.from_bytes(out) ?? __utf8_replacing(out))
}

// UTF-8 decoding with replacement: each maximal subpart of an invalid
// sequence becomes one U+FFFD (FF: one; C0 AF: two; ED A0 80: three;
// E2 28 A1: U+FFFD ( U+FFFD; a truncated E2 82: one).
__utf8_replacing: fn(bytes: [U8]) -> String Never! {
    out := [U8]{}
    at := 0
    loop at < bytes.len() {
        lead: Int.from_u8(bytes[at])
        width := if lead < 128 -> 1 else -> 0
        low := 128
        high := 191
        if lead >= 194 && lead <= 223 -> width = 2
        if lead >= 224 && lead <= 239 {
            width = 3
            if lead == 224 -> low = 160
            if lead == 237 -> high = 159
        }
        if lead >= 240 && lead <= 244 {
            width = 4
            if lead == 240 -> low = 144
            if lead == 244 -> high = 143
        }
        good := 1
        loop good < width && at + good < bytes.len() {
            byte: Int.from_u8(bytes[at + good])
            valid: if good == 1 -> byte >= low && byte <= high else -> byte >= 128 && byte <= 191
            if !valid -> break
            good = good + 1
        }
        if width > 0 && good == width {
            loop k in 0..<width -> out.push(bytes[at + k])
        } else {
            out.push(U8{239})
            out.push(U8{191})
            out.push(U8{189})
        }
        at = at + good
    }
    String.from_bytes(out) ?? ""
}

// One form value, tolerant: never fails.
form_component_decode: fn(text: String) -> String Never! {
    raw: text.bytes()
    __form_scan(raw, 0, raw.len(), FormPolicy.Tolerant) ?? ""
}

// One form value, strict: Escape or UTF8 instead of replacing.
form_component_decode_strict: fn(text: String) -> String FormDecodeError! {
    raw: text.bytes()
    __form_scan(raw, 0, raw.len(), FormPolicy.Strict)
}

query_decode: fn(text: String) -> Query Never! { __form_split(text, FormPolicy.Tolerant) ?? query() }
query_decode_strict: fn(text: String) -> Query FormDecodeError! { __form_split(text, FormPolicy.Strict) }

form_encode: fn(q: Query) -> String Never! { query_encode(q) }
form_decode: fn(text: String) -> Query Never! { query_decode(text) }
form_decode_strict: fn(text: String) -> Query FormDecodeError! { query_decode_strict(text) }

#Test("form components decode once, tolerant by WHATWG replacement or strict by refusal") {
    r: String.from_bytes([U8]{239, 191, 189}) ?? panic("U+FFFD")
    assert_eq(form_component_decode("%FF"), r)
    assert_eq(form_component_decode("%C0%AF"), "{r}{r}")
    assert_eq(form_component_decode("%ED%A0%80"), "{r}{r}{r}")
    assert_eq(form_component_decode("%E2(%A1"), "{r}({r}")
    assert_eq(form_component_decode("%E2%82"), r)
    assert_eq(form_component_decode("a+b%41%e2%82%ac"), "a bA€")
    assert_eq(form_component_decode("%QZ%4"), "%QZ%4")
    assert_eq(form_component_decode("%252F"), "%2F")
    assert_eq(form_component_decode("%00").bytes(), [U8]{0})
    assert(form_component_decode_strict("%QZ") == .Err(.Escape))
    assert(form_component_decode_strict("ab%4") == .Err(.Escape))
    assert(form_component_decode_strict("%FF") == .Err(.UTF8))
    assert(form_component_decode_strict("%C0%AF") == .Err(.UTF8))
    assert(form_component_decode_strict("%E2%82") == .Err(.UTF8))
    assert_eq(form_component_decode_strict("a+%41%252F") ?? panic("strict component"), "a A%2F")
}

#Test("queries and forms split one way under both policies") {
    r: String.from_bytes([U8]{239, 191, 189}) ?? panic("U+FFFD")
    q: form_decode("?name=%FF+&&x=%41&path=%252F&flag&=e&x=2")
    assert_eq(q.pairs.len(), 6)
    assert_eq(query_get(q, "name"), Val("{r} "))
    assert_eq(query_all(q, "x"), [String]{"A", "2"})
    assert_eq(query_get(q, "path"), Val("%2F"))
    assert_eq(query_get(q, "flag"), Val(""))
    assert_eq(query_get(q, ""), Val("e"))
    assert_eq(query_decode("?x=%QZ").pairs[0].value, "%QZ")
    assert(form_decode_strict("name=%FF+&x=%41") == .Err(.UTF8))
    assert(query_decode_strict("x=%QZ") == .Err(.Escape))
    strict: query_decode_strict("?x=%41&&y") ?? panic("strict query")
    assert_eq(strict.pairs.len(), 2)
    assert_eq(query_get(strict, "y"), Val(""))
    big: "a={"b".repeat(C_MAX_BODY_BYTES)}"
    assert_eq(query_decode(big).pairs.len(), 0)
    assert(query_decode_strict(big) == .Err(.TooLarge))
    assert(form_decode_strict(big) == .Err(.TooLarge))
}

#Test("a binary body stays bytes through parse_request, with_body, request_with and response_ok") {
    crlf: String.from_bytes([U8]{13, 10}) ?? panic("CRLF")
    raw := "POST / HTTP/1.1{crlf}Host: example{crlf}Content-Length: 2{crlf}{crlf}".bytes()
    raw.push(U8{255})
    raw.push(U8{0})
    req: parse_request(raw) ?? panic("binary upload framing")
    assert_eq(body_as_bytes(req.body), [U8]{255, 0})
    assert(req.text() == .Err(.UnsupportedEncoding))
    assert(req.text() == .Err(.BodyConsumed))
    assert_eq(body_as_bytes(with_body(req, body_bytes([U8]{255, 0})).body), [U8]{255, 0})
    sent: request_with(Method.Post, "http://example/", headers(), body_bytes([U8]{255, 0}))
    assert_eq(body_as_bytes(sent.body), [U8]{255, 0})
    assert_eq(body_as_bytes(response_ok(body_bytes([U8]{255, 0})).body), [U8]{255, 0})
}

cookie: fn(name: String, value: String) -> Cookie Never! {
    Cookie{name: name, value: value, domain: "", path: "/", secure: false, http_only: false, same_site: "Lax", max_age: -1}
}

cookie_encode: fn(c: Cookie) -> String Never! {
    if !valid_cookie_token(c.name) || !valid_cookie_value(c.value) -> return ""
    s := "{c.name}={c.value}"
    if c.domain.bytes().len() > 0 {
        if !valid_cookie_attribute(c.domain) -> return ""
        s = "{s}; Domain={c.domain}"
    }
    if c.path.bytes().len() > 0 {
        if !valid_cookie_attribute(c.path) -> return ""
        s = "{s}; Path={c.path}"
    }
    if c.max_age >= 0 -> s = "{s}; Max-Age={c.max_age}"
    if c.http_only -> s = "{s}; HttpOnly"
    if c.secure -> s = "{s}; Secure"
    if c.same_site == "Strict" || c.same_site == "Lax" || c.same_site == "None" -> s = "{s}; SameSite={c.same_site}"
    if s.bytes().len() > C_MAX_HEADER_LINE_BYTES -> return ""
    s
}

cookies_parse: fn(header: String) -> [Cookie] Never! {
    out := [Cookie]{}
    raw: header.bytes()
    if raw.len() > C_MAX_HEADER_LINE_BYTES -> return out
    start := 0
    i := 0
    first := true
    loop i <= raw.len() {
        if i == raw.len() || raw[i] == (U8{59}) {
            piece: trim(String.from_bytes(slice_b(raw, start, i)) ?? "")
            eq := index_byte_str(piece, 61)
            if eq > 0 {
                n: trim(slice_str(piece, 0, eq))
                v: trim(slice_str(piece, eq + 1, piece.bytes().len()))
                lower: ascii_lower(n)
                if first || (lower != "domain" && lower != "path" && lower != "max-age" && lower != "expires" && lower != "secure" && lower != "httponly" && lower != "samesite") {
                    if valid_cookie_token(n) && valid_cookie_value(v) -> out.push(cookie(n, v))
                }
            }
            first = false
            start = i + 1
        }
        i = i + 1
    }
    out
}

basic_auth: fn(user: String, password: String) -> String Never! {
    credentials := "{user}:{password}"
    "Basic {base64_encode(credentials.bytes())}"
}

bearer_auth: fn(token: String) -> String Never! { "Bearer {token}" }
with_header: fn(req: HTTPRequest, name: String, value: String) -> HTTPRequest Never! {
    if !valid_header_name(name) || has_ctl(value.bytes()) -> return req.copy()
    req.__with_header(name, value)
}

// The body as given: Body.Bytes stays bytes.
with_body: fn(req: HTTPRequest, body: Body) -> HTTPRequest Never! {
    req.__with_body_value(body)
}

with_query: fn(url: String, q: Query) -> String Never! {
    enc: query_encode(q)
    if enc.bytes().len() == 0 -> return url.copy()
    frag: split_fragment(url)
    base: frag.url
    sep := if index_byte_str(base, 63) >= 0 -> "&" else -> "?"
    suffix := ""
    if frag.fragment.bytes().len() > 0 -> suffix = "#{frag.fragment}"
    "{base}{sep}{enc}{suffix}"
}

status_class: fn(s: Status) -> String Never! {
    if is_informational(s) -> return "informational"
    if is_success(s) -> return "success"
    if is_redirect(s) -> return "redirect"
    if is_client_error(s) -> return "client_error"
    if is_server_error(s) -> return "server_error"
    "unknown"
}

request_with: fn(method: Method, url: String, h: Headers, body: Body) -> HTTPRequest Never! {
    req := core.http.client.request(method_text(method), url)
    loop f in h.fields -> req = req.__with_header(f.name, f.value)
    with_body(req, body)
}

response_ok: fn(body: Body) -> HTTPResponse Never! {
    fields: headers()
    __response(200, body.copy(), fields)
}

response_json_headers: fn() -> Headers Never! { headers_set(headers(), "content-type", "application/json; charset=utf-8") }
response_text_headers: fn() -> Headers Never! { headers_set(headers(), "content-type", "text/plain; charset=utf-8") }
has_header: fn(h: Headers, name: String) -> Bool Never! { headers_get(h, name) != None }

content_length: fn(h: Headers) -> Int Never! {
    values: headers_all(h, "content-length")
    if values.len() == 0 -> return -1
    first := -1
    loop value in values {
        n: parse_content_length_value(value) ?? return -1
        if first >= 0 && n != first -> return -1
        first = n
    }
    first
}

valid_url: fn(url: String) -> Bool Never! {
    raw: url.bytes()
    if raw.len() < 8 || raw.len() > C_MAX_URL_BYTES || has_url_ctl(raw) -> return false
    parsed: http_url.parse(url) ?? return false
    if parsed.scheme() != "http" && parsed.scheme() != "https" -> return false
    if parsed.host() == None || parsed.userinfo().bytes().len() > 0 -> return false
    colon := index_byte(raw, 58)
    if colon <= 0 || colon + 2 >= raw.len() -> return false
    if raw[colon + 1] != (U8{47}) || raw[colon + 2] != (U8{47}) -> return false
    start := colon + 3
    end := start
    loop end < raw.len() {
        if raw[end] == (U8{47}) || raw[end] == (U8{63}) || raw[end] == (U8{35}) -> break
        n: Int.from_u8(raw[end])
        if n <= 32 || n >= 127 || n == 34 || n == 92 -> return false
        end = end + 1
    }
    end > start
}

parse_content_length_value: fn(text: String) -> Int? {
    raw: text.bytes()
    if raw.len() == 0 -> return None
    first := -1
    start := 0
    i := 0
    loop i <= raw.len() {
        if i == raw.len() || raw[i] == (U8{44}) {
            token: trim(String.from_bytes(slice_b(raw, start, i)) ?? "")
            n: parse_decimal(token) ?? return None
            if first >= 0 && first != n -> return None
            first = n
            start = i + 1
        }
        i = i + 1
    }
    if first < 0 -> return None
    Val(first)
}

has_url_ctl: fn(bytes: [U8]) -> Bool Never! {
    loop b in bytes {
        n: Int.from_u8(b)
        if n < 32 || n == 127 -> return true
    }
    false
}

has_line_ctl: fn(bytes: [U8]) -> Bool Never! {
    loop b in bytes {
        n: Int.from_u8(b)
        if n < 32 || n == 127 -> return true
    }
    false
}

response_forbids_body: fn(code: Int) -> Bool Never! {
    (code >= 100 && code < 200) || code == 204 || code == 205 || code == 304
}
response_forbids_content_length: fn(code: Int) -> Bool Never! {
    (code >= 100 && code < 200) || code == 204
}

valid_method_token: fn(method: String) -> Bool Never! { valid_method(method) }

valid_method: fn(method: String) -> Bool Never! {
    raw: method.bytes()
    if raw.len() == 0 -> return false
    loop b in raw {
        if !token_char(Int.from_u8(b)) -> return false
    }
    true
}

valid_target: fn(target: String) -> Bool Never! {
    raw: target.bytes()
    if raw.len() == 0 -> return false
    if target != "*" && raw[0] != (U8{47}) -> return false
    loop b in raw {
        n: Int.from_u8(b)
        if n <= 32 || n == 127 || n == 35 -> return false
    }
    true
}

valid_connect_target: fn(target: String) -> Bool Never! {
    raw: target.bytes()
    if raw.len() == 0 || has_url_ctl(raw) || index_byte(raw, 58) <= 0 -> return false
    loop b in raw {
        n: Int.from_u8(b)
        if n >= 127 || n == 34 || n == 92 -> return false
    }
    parsed: http_url.parse("http://{target}") ?? return false
    parsed.host() != None && parsed.userinfo().bytes().len() == 0 && parsed.path() == "/" && parsed.query().bytes().len() == 0 && parsed.fragment() == None
}

valid_host_value: fn(value: String) -> Bool Never! {
    raw: trim(value)
    if raw.bytes().len() == 0 || has_url_ctl(raw.bytes()) -> return false
    loop b in raw.bytes() {
        n: Int.from_u8(b)
        if n >= 127 || n == 34 || n == 92 -> return false
    }
    parsed: http_url.parse("http://{raw}") ?? return false
    parsed.host() != None && parsed.userinfo().bytes().len() == 0 && parsed.path() == "/" && parsed.query().bytes().len() == 0 && parsed.fragment() == None
}
token_char: fn(n: Int) -> Bool Never! {
    (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 33 || n == 35 || n == 36 || n == 37 || n == 38 || n == 39 || n == 42 || n == 43 || n == 45 || n == 46 || n == 94 || n == 95 || n == 96 || n == 124 || n == 126
}

has_ambiguous_framing: fn(h: Headers) -> Bool Never! {
    first := -1
    loop value in headers_all(h, "content-length") {
        n: parse_content_length_value(value) ?? return true
        if first >= 0 && n != first -> return true
        first = n
    }
    has_header(h, "content-length") && has_header(h, "transfer-encoding")
}

has_unsupported_encoding: fn(h: Headers) -> Bool Never! {
    if has_header(h, "transfer-encoding") -> return true
    loop value in headers_all(h, "content-encoding") {
        encoding := ascii_lower(trim(value))
        if encoding != "identity" -> return true
    }
    false
}




valid_header_line: fn(line: String) -> Bool Never! {
    raw: line.bytes()
    col := index_byte(raw, 58)
    if col <= 0 -> return false
    name: String.from_bytes(slice_b(raw, 0, col)) ?? return false
    value: slice_b(raw, col + 1, raw.len())
    valid_header_name(name) && !has_ctl(value)
}

headers_lines_bounded: fn(lines: [String]) -> Bool Never! {
    if lines.len() > C_MAX_HEADER_COUNT -> return false
    total := 0
    loop line in lines {
        n := line.bytes().len()
        if n + 2 > C_MAX_HEADER_BYTES || n > C_MAX_HEADER_LINE_BYTES -> return false
        total = total + n + 2
        if total > C_MAX_HEADER_BYTES -> return false
    }
    true
}

headers_lines_valid: fn(lines: [String]) -> Bool Never! {
    if !headers_lines_bounded(lines) -> return false
    loop line in lines {
        if !valid_header_line(line) -> return false
    }
    true
}

valid_header_name: fn(name: String) -> Bool Never! {
    raw: name.bytes()
    if raw.len() == 0 -> return false
    loop b in raw {
        if !token_char(Int.from_u8(b)) -> return false
    }
    true
}
has_ctl: fn(bytes: [U8]) -> Bool Never! {
    loop b in bytes {
        n: Int.from_u8(b)
        if n < 32 && n != 9 -> return true
        if n == 127 -> return true
    }
    false
}

valid_cookie_token: fn(name: String) -> Bool {
    raw: name.bytes()
    if raw.len() == 0 -> return false
    loop b in raw {
        n: Int.from_u8(b)
        if n <= 32 || n >= 127 || n == 34 || n == 40 || n == 41 || n == 44 || n == 47 || n == 58 || n == 59 || n == 60 || n == 61 || n == 62 || n == 63 || n == 64 || n == 91 || n == 92 || n == 93 || n == 123 || n == 125 -> return false
    }
    true
}

valid_cookie_value: fn(value: String) -> Bool {
    loop b in value.bytes() {
        n: Int.from_u8(b)
        if n <= 32 || n >= 127 || n == 34 || n == 44 || n == 59 || n == 92 -> return false
    }
    true
}

valid_cookie_attribute: fn(value: String) -> Bool {
    loop b in value.bytes() {
        n: Int.from_u8(b)
        if n <= 32 || n >= 127 || n == 59 -> return false
    }
    true
}

parse_decimal: fn(text: String) -> Int? {
    raw: text.bytes()
    if raw.len() == 0 || raw.len() > 10 -> return None
    n := 0
    loop b in raw {
        d: Int.from_u8(b)
        if d < 48 || d > 57 -> return None
        n = n * 10 + d - 48
    }
    Val(n)
}

percent_encode: fn(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n: Int.from_u8(b)
        unreserved := (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 45 || n == 46 || n == 95 || n == 126
        if unreserved -> out.push(b)
        else if n == 32 -> out.push(U8{43})
        else {
            out.push(U8{37})
            out.push(hex_digit(n /% 16))
            out.push(hex_digit(n %% 16))
        }
    }
    String.from_bytes(out) ?? text
}

base64_encode: fn(bytes: [U8]) -> String Never! {
    alphabet: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".bytes()
    out := [U8]{}
    i := 0
    loop i < bytes.len() {
        a: Int.from_u8(bytes[i])
        b := 0
        c := 0
        have_b := i + 1 < bytes.len()
        have_c := i + 2 < bytes.len()
        if have_b -> b = Int.from_u8(bytes[i + 1])
        if have_c -> c = Int.from_u8(bytes[i + 2])
        block: (a * 65536) + (b * 256) + c
        out.push(alphabet[(block /% 262144) %% 64])
        out.push(alphabet[(block /% 4096) %% 64])
        if have_b -> out.push(alphabet[(block /% 64) %% 64]) else -> out.push(U8{61})
        if have_c -> out.push(alphabet[block %% 64]) else -> out.push(U8{61})
        i = i + 3
    }
    String.from_bytes(out) ?? ""
}

hex_digit: fn(n: Int) -> U8 {
    if n < 10 -> return U8{48 + n}
    U8{65 + n - 10}
}

from_hex: fn(b: U8) -> Int {
    n: Int.from_u8(b)
    if n >= 48 && n <= 57 -> return n - 48
    if n >= 65 && n <= 70 -> return n - 55
    if n >= 97 && n <= 102 -> return n - 87
    return -1
}

index_byte: fn(text: [U8], code: Int) -> Int Never! {
    loop i in 0..<text.len() {
        if Int.from_u8(text[i]) == code -> return i
    }
    -1
}

index_byte_str: fn(text: String, code: Int) -> Int { index_byte(text.bytes(), code) }

last_index: fn(raw: [U8], code: Int) -> Int {
    i := raw.len() - 1
    loop i >= 0 {
        if Int.from_u8(raw[i]) == code -> return i
        i = i - 1
    }
    -1
}

starts: fn(text: String, prefix: String) -> Bool {
    a: text.bytes()
    b: prefix.bytes()
    if b.len() > a.len() -> return false
    loop i in 0..<b.len() {
        if a[i] != b[i] -> return false
    }
    true
}

FragmentSplit: struct {
    url: String
    fragment: String
}

split_fragment: fn(text: String) -> FragmentSplit {
    at := index_byte_str(text, 35)
    if at < 0 -> return FragmentSplit{url: text, fragment: ""}
    FragmentSplit{url: slice_str(text, 0, at), fragment: slice_str(text, at + 1, text.bytes().len())}
}

contains_byte: fn(text: String, code: Int) -> Bool { index_byte(text.bytes(), code) >= 0 }

slice_str: fn(text: String, start: Int, end: Int) -> String {
    String.from_bytes(slice_b(text.bytes(), start, end)) ?? ""
}

slice_b: fn(raw: [U8], start: Int, end: Int) -> [U8] Never! {
    raw.slice(start, end)
}

