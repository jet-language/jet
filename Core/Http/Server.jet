use core as core
use core.http.[Body, Headers, HTTPError, HTTPRequest, HTTPResponse]
use core.http.server as provider
use core.encoding.json as json_codec

// core.http.server — source policy over native HTTP transport carriers.
//
// Plain value constructors and deterministic policy live here. Transport and
// callback-bearing mux/lifecycle operations retain their registered carriers.
//
// Public arity/label rows retain the existing implicit-Optional admission.
// Their source entries receive the normalized options; no user-facing `Val`
// spelling or new deadline/TLS default is introduced.

enum HTTPCorsOrigins {
    Any
    List([String])
}

struct HTTPCorsPolicy {
    origins: HTTPCorsOrigins
    allow_methods: String
    allow_headers: String
    credentials: Bool
    max_age_secs: Int
}

// The native listener accepts this same plain credential carrier.
struct HTTPServerTLS {
    cert_pem: String
    key_pem: String
}

fn mux() -[Net]> HTTPMux Never! {
    provider.__mux()
}

fn serve_once(addr: String, mux: HTTPMux) HTTPError! -[Net, Time.Wait]> {
    provider.__serve_once(addr, mux) ?? return
}

fn serve_once_listener(listener: TCPListener, mux: HTTPMux) HTTPError! -[Net, Time.Wait]> {
    provider.__serve_once_listener(listener, mux) ?? return
}

fn __serve_entry(addr: String, mux: HTTPMux, tls: HTTPServerTLS?, deadline: Duration?) HTTPError! -[Net, Time.Wait]> {
    provider.__serve(addr, mux, tls, deadline)
}

fn __bind_entry(addr: String, mux: HTTPMux, tls: HTTPServerTLS?, deadline: Duration?) -[Net]> HTTPServer HTTPError! {
    provider.__bind(addr, mux, tls, deadline)
}

fn __static_files_entry(mux: HTTPMux, prefix: String, root: String, index: Bool?, dotfiles: Bool?, follow_links: Bool?) Never! -[Net]> {
    provider.__static_files(mux, prefix, root, index, dotfiles, follow_links)
}

// Preserve HTTPMux.middleware's existing checked escaping-callback
// admission before routing its receiver+callback into this source entry.
fn __middleware_entry(mux: HTTPMux, middleware: ^fn(HTTPHandler) -> HTTPHandler) Never! -[Net]> {
    provider.__middleware(mux, ^middleware)
}

fn response(status: Int, body: String) -> HTTPResponse Never! {
    payload :: core.http.body_text(body)
    fields :: core.http.headers()
    response_body(status, ^payload, ^fields)
}

// Head policy stays in Jet. The resource transfer consumes the selected body
// once without reading it; streaming bodies are never flattened into text.
fn response_body(status: Int, body: ^Body, headers: ^Headers) -> HTTPResponse Never! {
    selected := status
    payload := ^body
    if selected < 100 || selected > 599 {
        selected = 500
        payload = core.http.body_text("500 Internal Server Error")
    }
    version :: "HTTP/1.1"
    trailers :: core.http.headers()
    wire_version :: "HTTP/1.1"
    wire_length :: ""
    wire_transfer :: [String]{}
    wire_chunks :: [I64]{}
    wire_failure :: String?{None}
    #Unsafe("move the normalized response head and one-shot body into the transport carrier") {
        return core.http.server.__response_parts(
            I64{selected}, ^version, ^headers, ^payload, ^trailers,
            None, false, ^wire_version, ^wire_length, ^wire_transfer, ^wire_chunks, false, ^wire_failure
        )
    }
}

fn json<T: Encode>(status: Int, body: T) -> HTTPResponse HTTPError! {
    text :: json_codec.to_string(body.encode()) ?? return Err(HTTPError.InvalidFraming)
    fields :: core.http.headers_set(core.http.headers(), "content-type", "application/json; charset=utf-8")
    payload :: core.http.body_text(text)
    response_body(status, ^payload, ^fields)
}

fn static_file(path: String, content_type: String) -[Net]> HTTPResponse HTTPError! {
    provider.__static_file(path, content_type)
}

fn static_file_range(request: HTTPRequest, path: String, content_type: String) -[Net]> HTTPResponse HTTPError! {
    provider.__static_file_range(request, path, content_type)
}

fn static_files(mux: HTTPMux, prefix: String, root: String) Never! -[Net]> {
    provider.__static_files(mux, prefix, root, None, None, None)
}

fn tls(cert: String, key: String) -> HTTPServerTLS Never! {
    HTTPServerTLS{cert_pem: cert, key_pem: key}
}

fn sse(body: String) -> HTTPResponse Never! {
    fields :: core.http.headers_set(core.http.headers(), "content-type", "text/event-stream")
    headers :: core.http.headers_set(fields, "cache-control", "no-cache")
    payload :: core.http.body_text("data: {body}\n\n")
    response_body(200, ^payload, ^headers)
}

fn cors_policy(origins: [String] | HTTPCorsOrigins, methods: [String]{[String]{}}, headers: [String]{[String]{}}, credentials: Bool{false}, max_age: Int{86400}) -> HTTPCorsPolicy HTTPError! {
    selected :: if origins == {
        .M__String_(names) -> HTTPCorsOrigins.List(names)
        .HTTPCorsOrigins(value) -> value
    }
    if credentials && selected == .Any {
        return Err(HTTPError.Policy{reason: "CORS credentials need named origins. An `.Any` origin with credentials would let every website read this API, and browsers refuse the pair. List the origins you trust, or set credentials to false."})
    }
    HTTPCorsPolicy{
        origins: selected,
        allow_methods: cors_join(methods, "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS"),
        allow_headers: cors_join(headers, "content-type, authorization, x-request-id"),
        credentials: credentials,
        max_age_secs: max_age,
    }
}

fn cors(mux: HTTPMux, policy: HTTPCorsPolicy) Never! -[Net]> {
    provider.__cors(mux, policy)
}

fn access_log(request: HTTPRequest, status: Int) -[Net]> String Never! {
    template :: access_log_template(request)
    access_log_parts(request.method, request.path, template, status)
}

fn access_log_template(request: HTTPRequest) -> String? Never! {
    #Unsafe("borrow the request's stored optional route-template metadata; no route selection or formatting policy") {
        return core.http.server.__route_template(request)
    }
}

fn access_log_parts(method: String, path: String, template: String?, status: Int) -> String Never! {
    route :: template ?? access_log_path(path)
    "{method} {route} {status}"
}

fn access_log_path(path: String) -> String Never! {
    raw :: path.bytes()
    end := 0
    loop end < raw.len() && raw[end] != (U8{63}) -> end = end + 1
    if end == raw.len() -> return path.copy()
    String.from_bytes(raw.slice(0, end)) ?? panic("query separator is not a UTF-8 boundary")
}

fn request_id(mux: HTTPMux) Never! -[Net]> {
    provider.__request_id(mux)
}

fn cors_join(values: [String], fallback: ^String) -> String Never! {
    if values.len() == 0 -> return fallback
    result := ""
    loop i in 0..<values.len() {
        if i > 0 -> result = "{result}, "
        result = "{result}{values[i]}"
    }
    result
}

#Test("CORS policy defaults and explicit values") {
    value :: cors_policy(.Any) ?? panic("default CORS policy")
    assert(value.allow_methods == "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS")
    assert(value.allow_headers == "content-type, authorization, x-request-id")
    assert(!value.credentials)
    assert(value.max_age_secs == 86400)
    named :: cors_policy(.List([String]{"https://example.test"}), methods: [String]{"GET", "PATCH"}, headers: [String]{"x-token"}, credentials: true, max_age: -1) ?? panic("named origins")
    assert(named.allow_methods == "GET, PATCH")
    assert(named.allow_headers == "x-token")
    assert(named.credentials)
    assert(named.max_age_secs == -1)
    minimum :: cors_policy(.List([String]{"https://example.test"}), max_age: -9223372036854775808) ?? panic("explicit minimum max age")
    assert(minimum.max_age_secs == -9223372036854775808)
    if cors_policy(.Any, credentials: true) == {
        .Err(_) -> {}
        .Ok(_) -> panic("wildcard credentials must be refused")
    }
}

#Test("server TLS construction preserves PEM text without validation") {
    value :: tls("certificate\n", "private key\n")
    assert(value.cert_pem == "certificate\n")
    assert(value.key_pem == "private key\n")
    empty :: tls("", "")
    assert(empty.cert_pem == "" && empty.key_pem == "")
}

#Test("access log retains route-template presence and strips only fallback query") {
    assert(access_log_parts("GET", "/logs/42?secret=x", None, 200) == "GET /logs/42 200")
    assert(access_log_parts("POST", "/logs/42?secret=x", Val("/logs/:id"), 201) == "POST /logs/:id 201")
    assert(access_log_parts("GET", "/ignored?query=x", Val(""), -7) == "GET  -7")
    assert(access_log_parts("GET", "/ignored", Val("/template?unchanged"), 200) == "GET /template?unchanged 200")
    assert(access_log_parts("GET", "/雪/☃?secret=x", None, 200) == "GET /雪/☃ 200")
    assert(access_log_parts("GET", "?secret=x", None, 200) == "GET  200")
    assert(access_log_parts("GET", "", None, 200) == "GET  200")
}

#Test("response policy normalizes only statuses outside 100 through 599") {
    assert(response(99, "discarded").status == 500)
    assert(response(100, "").status == 100)
    assert(response(599, "retained").status == 599)
    assert(response(600, "discarded").status == 500)
    assert(response(-9223372036854775808, "discarded").status == 500)
    assert(response(9223372036854775807, "discarded").status == 500)
}

#Test("response transport accepts every source body kind by move") {
    empty :: core.http.body_empty()
    empty_headers :: core.http.headers()
    assert(response_body(204, ^empty, ^empty_headers).status == 204)
    text :: core.http.body_text("text")
    text_headers :: core.http.headers()
    assert(response_body(200, ^text, ^text_headers).status == 200)
    bytes :: core.http.body_bytes([U8]{0, 255})
    bytes_headers :: core.http.headers()
    assert(response_body(201, ^bytes, ^bytes_headers).status == 201)
}

#Test("JSON response encoding rejects non-finite numbers on the HTTP error rail") {
    if json(200, math.nan()) == {
        .Err(error) -> assert(error == .InvalidFraming)
        .Ok(_) -> panic("non-finite JSON response accepted")
    }
    response :: json(201, "witness") ?? panic("JSON response")
    assert(response.status == 201)
}
