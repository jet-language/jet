package: {
    name: "app"
    version: "0.0.1"
    edition: "2026"
    description: "Process-level live queries, sync, and auth configuration."
    license: "MIT"
    outputs: {
        app: .Library{ entry: app }
    }
}
AUTH_MAX_PROVIDERS: 64
SYNC_MAX_SESSION: 256
SYNC_MAX_DOCUMENT: 4194304
SYNC_MAX_TEXT: 1048576
SYNC_MAX_ENTRIES: 100000
SYNC_MAX_REPLICAS: 4096
SYNC_MAX_INT: 9223372036854775807
// Live bindings live in one process-wide registry below; sync sessions are
// records of that registry under LIVE_SYNC_SOURCE.
use {
    unicode: core.text
    live_json: core.encoding.json
    core.reactive.loadable.[Loadable]
    rt: jet.runtime.time
    rt_web: jet.runtime.web
}

#Error
AppError: enum {
    Invalid
    Unsupported
}

Auth: struct {
    users_table: String
    providers: [String]
}

Session: struct {
    id: String
    user_id: String
    cookie: String
    expires_at: Int
}

auth: fn(users_table: String) -> Auth Never! {
    Auth{users_table: canonical_table(users_table), providers: [String]{}}
}

auth_oauth: fn(auth: Auth, providers: String) -> Auth Never! {
    configured := [String]{}
    loop comma_group in providers.split(",") {
        loop raw in comma_group.split(" ") {
            provider: raw.trim()
            if valid_provider(provider) && !contains_string(configured, provider) && configured.len() < AUTH_MAX_PROVIDERS {
                configured.push(provider.copy())
            }
        }
    }
    Auth{users_table: canonical_table(auth.users_table), providers: configured}
}

auth_routes: fn(auth: Auth) -> String Never! {
    table := canonical_table(auth.users_table)
    routes := [String]{
        "POST /login -> password ({table})",
        "POST /logout -> revoke session",
        "GET /magic -> begin magic link",
        "POST /magic -> consume magic link",
    }
    providers := canonical_providers(auth.providers)
    loop provider in providers {
        routes.push("GET /oauth/{provider}/begin")
        routes.push("GET /oauth/{provider}/callback")
    }
    "AuthRoutes({routes.join("; ")})"
}

auth_show: fn(auth: Auth) -> String Never! {
    table := canonical_table(auth.users_table)
    providers := canonical_providers(auth.providers)
    "Auth(users={table}, providers=[{providers.join(",")}])"
}
canonical_table: fn(value: String) -> String {
    if valid_identifier(value) -> return value.copy()
    ""
}

canonical_providers: fn(values: [String]) -> [String] {
    providers := [String]{}
    loop provider in values {
        if valid_provider(provider) && !contains_string(providers, provider) && providers.len() < AUTH_MAX_PROVIDERS {
            providers.push(provider.copy())
        }
    }
    providers
}

// A live binding: one source function applied to one argument list. The
// compiler builds it from `live(source, args...)` or
// `subscribe(source, args...)`; `state` reads it.
Live: struct<T, E> {
    id: Int
    run: fn() -> T E!
}

// One registry binding, named by its source's wire name and its encoded
// argument list. `value` is the last result, `ok:` or `err:` then its JSON,
// and empty before the first run; `every_ns` is the poll interval (0: none)
// and `ran_ns` the monotonic time of the last run.
LiveRecord: struct {
    id: Int
    source: String
    key: String
    value: String
    dirty: Bool
    every_ns: Int
    ran_ns: Int
}

LiveRegistry: struct {
    next_id: Int
    invalidations: Int
    changes: Int
    evictions: Int
    ws_pushes: Int
    records: [LiveRecord]
}

// The live registry lives in a process-wide runtime byte cell; every update
// reads the cell, edits the decoded registry and installs it only if the cell
// is unchanged, retrying otherwise, so concurrent callers never lose an update.
//
// The compiler checks `live`, `subscribe`, `push` and `invalidate` against
// their source function and lowers them to the `__live_*` helpers below.

// The binding's current state. The source re-runs when the binding has no
// result yet, was invalidated, or its poll interval has passed; the stored
// result changes only when the re-run's encoding differs.
state: fn<T: [Encode, Decode], E: [Encode, Decode]>(binding: Live<T, E>) -> Loadable<T, E> Never! {
    now: rt.clock_mono_ns()
    if live_current(binding.id, now) == .Val(text) {
        if live_value_state<T, E>(text) == .Val(current) -> return current
    }
    value: binding.run() ?? {
        if live_json.to_string<E>(err) == .Ok(encoded) -> live_store(binding.id, "err:{encoded}", now)
        return Loadable.Failed(err)
    }
    if live_json.to_string<T>(value) == .Ok(encoded) -> live_store(binding.id, "ok:{encoded}", now)
    Loadable.Loaded(value)
}

// `changes` counts stored results that differed from the one before;
// `ws_pushes` counts the invalidations published to the WebSocket live hub.
live_stats: fn() -> String Never! {
    registry: live_decode(live_cell_load()) ?? return "LiveStats(error=live registry unavailable)"
    "LiveStats(queries={live_query_count(registry)}, limit={LIVE_MAX_QUERIES}, evictions={registry.evictions}, invalidations={registry.invalidations}, changes={registry.changes}, ws_pushes={registry.ws_pushes})"
}

// The live bindings of `registry`; sync's session records are not queries.
live_query_count: fn(registry: LiveRegistry) -> Int {
    count := 0
    loop record in registry.records {
        if record.source != LIVE_SYNC_SOURCE -> count += 1
    }
    count
}

// `live(source, args...)`: `args` are the encoded arguments.
__live_bind: fn<T: [Encode, Decode], E: [Encode, Decode]>(source: String, args: [String], run: &&fn() -> T E!) -> Live<T, E> Never! {
    Live<T, E>{id: live_register(source, live_key(args), 0), run: run}
}

// `subscribe(source, args..., every:)`: a binding polled every `every`.
__live_poll: fn<T: [Encode, Decode], E: [Encode, Decode]>(source: String, args: [String], every: Duration?, run: &&fn() -> T E!) -> Live<T, E> Never! {
    every_ns := 0
    if every == .Val(interval) && interval.ns > 0 -> every_ns = interval.ns
    Live<T, E>{id: live_register(source, live_key(args), every_ns), run: run}
}

// `push(source, args..., value:)` stores `value` as that binding's result,
// registering the binding when nothing has read it yet.
__live_push: fn<T: Encode>(source: String, args: [String], value: T) Never! {
    encoded: live_json.to_string<T>(value) ?? return
    key: live_key(args)
    id: live_register(source, key, 0)
    live_store(id, "ok:{encoded}", -1)
}

// `invalidate(source, args...)`: exactly that argument list re-runs.
__live_invalidate: fn(source: String, args: [String]) Never! { live_invalidate(source, Val(live_key(args))) }

// `invalidate(source)`: every binding of `source` re-runs.
__live_invalidate_all: fn(source: String) Never! { live_invalidate(source, None) }

// One argument's part of a binding's identity.
__live_arg: fn<A: Encode>(value: A) -> String Never! { live_json.to_string<A>(value) ?? "_" }

LIVE_MAX_QUERIES: 1024
LIVE_MAX_PAYLOAD: 4194304
// The registry source of sync's session records: a session keeps its
// generation and document as the record's value.
LIVE_SYNC_SOURCE: "app.sync"

live_cell_load: fn() -> [U8] { rt_web.live_load() }

live_cell_replace: fn(expected: [U8], replacement: &&[U8]) -> Bool { rt_web.live_replace(expected, replacement) }

live_key: fn(args: [String]) -> String { "[{args.join(",")}]" }

// The id of the binding named by `source` and `key`, registered when absent;
// a full registry evicts its oldest binding. Two registrations of one
// binding poll at the shorter interval. 0 when the registry is unavailable.
live_register: fn(source: String, key: String, every_ns: Int) -> Int {
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return 0
        found := 0
        loop index in 0..<registry.records.len() {
            if registry.records[index].source != source || registry.records[index].key != key -> next
            found = registry.records[index].id
            current: registry.records[index].every_ns
            if every_ns <= 0 || (current > 0 && current <= every_ns) -> return found
            registry.records[index].every_ns = every_ns
        }
        if found == 0 {
            found = registry.next_id + 1
            registry.next_id = found
            if live_query_count(registry) >= LIVE_MAX_QUERIES {
                kept := [LiveRecord]{}
                evicted := false
                loop record in registry.records {
                    if !evicted && record.source != LIVE_SYNC_SOURCE {
                        evicted = true
                        next
                    }
                    kept.push(record)
                }
                registry.records = kept
                registry.evictions += 1
            }
            // copy: a lost race retries with the same source and key
            registry.records.push(LiveRecord{id: found, source: source.copy(), key: key.copy(), value: "", dirty: false, every_ns: every_ns, ran_ns: 0})
        }
        if live_cell_replace(seen, live_encode(registry)) -> return found
    }
}

// The stored result of binding `id` when it is current at `now`; None when
// the binding must re-run.
live_current: fn(id: Int, now: Int) -> String? {
    registry: live_decode(live_cell_load()) ?? return None
    index: live_index(registry, id) ?? return None
    record: registry.records[index]
    if record.value == "" || record.dirty -> return None
    if record.every_ns > 0 && now - record.ran_ns >= record.every_ns -> return None
    Val(record.value.copy()) // copy: the registry snapshot is dropped here
}

live_value_state: fn<T: [Encode, Decode], E: [Encode, Decode]>(text: String) -> Loadable<T, E>? {
    if text.starts_with("ok:") {
        value: live_json.decode<T>(text.slice(3, text.len())) ?? return None
        return Val(Loadable.Loaded(value))
    }
    if !text.starts_with("err:") -> return None
    reason: live_json.decode<E>(text.slice(4, text.len())) ?? return None
    Val(Loadable.Failed(reason))
}

// Stores `value` as binding `id`'s result, clean; a value that differs from
// the stored one counts as a change. `now` < 0 keeps the last run time.
live_store: fn(id: Int, value: String, now: Int) {
    if value.len() > LIVE_MAX_PAYLOAD -> return
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return
        index: live_index(registry, id) ?? return
        if registry.records[index].value != value {
            registry.records[index].value = value.copy() // copy: a lost race retries with the same value
            registry.changes += 1
        }
        registry.records[index].dirty = false
        if now >= 0 -> registry.records[index].ran_ns = now
        if live_cell_replace(seen, live_encode(registry)) -> return
    }
}

// Marks dirty every binding of `source`, or only the one whose key is `key`,
// then publishes the invalidation to the WebSocket live hub:
// topic `live:<source>`, a JSON event every joined server connection receives
// and a connection that joins later gets replayed as the topic's latest.
live_invalidate: fn(source: String, key: String?) {
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return
        hit := 0
        loop index in 0..<registry.records.len() {
            if registry.records[index].source != source -> next
            if key == .Val(only) && registry.records[index].key != only -> next
            registry.records[index].dirty = true
            hit += 1
        }
        if hit == 0 -> return
        registry.invalidations += hit
        registry.ws_pushes += 1
        if live_cell_replace(seen, live_encode(registry)) {
            key_json := "null"
            if key == .Val(only) -> key_json = live_json.to_string<String>(only) ?? "null"
            source_json: live_json.to_string<String>(source) ?? "null"
            rt_web.live_publish("live:{source}", "{{\"live\":\"invalidate\",\"source\":{source_json},\"key\":{key_json},\"invalidations\":{registry.invalidations}}}")
            return
        }
    }
}

live_index: fn(registry: LiveRegistry, id: Int) -> Int? {
    loop index in 0..<registry.records.len() {
        if registry.records[index].id == id -> return Val(index)
    }
    None
}

// The cell holds the registry as length-prefixed fields: next id,
// invalidations, changes, evictions, WebSocket pushes, then seven fields per
// binding.
live_encode: fn(registry: LiveRegistry) -> [U8] {
    out := [U8]{}
    live_put(out, "{registry.next_id}")
    live_put(out, "{registry.invalidations}")
    live_put(out, "{registry.changes}")
    live_put(out, "{registry.evictions}")
    live_put(out, "{registry.ws_pushes}")
    loop record in registry.records {
        live_put(out, "{record.id}")
        live_put(out, record.source)
        live_put(out, record.key)
        live_put(out, record.value)
        live_put(out, if record.dirty -> "1" else -> "0")
        live_put(out, "{record.every_ns}")
        live_put(out, "{record.ran_ns}")
    }
    out
}

live_put: fn(out: &[U8], text: String) {
    loop byte in "{text.len()}:".bytes() -> out.push(byte)
    loop byte in text.bytes() -> out.push(byte)
}

// An empty cell is the empty registry; None when the bytes are malformed.
live_decode: fn(raw: [U8]) -> LiveRegistry? {
    if raw.len() == 0 -> return Val(LiveRegistry{next_id: 0, invalidations: 0, changes: 0, evictions: 0, ws_pushes: 0, records: [LiveRecord]{}})
    fields: live_fields(raw) ?? return None
    if fields.len() < 5 || (fields.len() - 5) % 7 != 0 -> return None
    next_id: Int.parse(fields[0]) ?? return None
    invalidations: Int.parse(fields[1]) ?? return None
    changes: Int.parse(fields[2]) ?? return None
    evictions: Int.parse(fields[3]) ?? return None
    ws_pushes: Int.parse(fields[4]) ?? return None
    records := [LiveRecord]{}
    at := 5
    loop at < fields.len() {
        id: Int.parse(fields[at]) ?? return None
        every_ns: Int.parse(fields[at + 5]) ?? return None
        ran_ns: Int.parse(fields[at + 6]) ?? return None
        records.push(LiveRecord{id: id, source: fields[at + 1], key: fields[at + 2], value: fields[at + 3], dirty: fields[at + 4] == "1", every_ns: every_ns, ran_ns: ran_ns})
        at += 7
    }
    Val(LiveRegistry{next_id: next_id, invalidations: invalidations, changes: changes, evictions: evictions, ws_pushes: ws_pushes, records: records})
}

// The length-prefixed fields (`<decimal byte length>:<bytes>`) of `raw`.
live_fields: fn(raw: [U8]) -> [String]? {
    fields := [String]{}
    at := 0
    loop at < raw.len() {
        length := 0
        loop {
            if at >= raw.len() -> return None
            n: Int.from_u8(raw[at])
            at += 1
            if n == 58 -> break
            if n < 48 || n > 57 -> return None
            length = length * 10 + n - 48
        }
        if at + length > raw.len() -> return None
        fields.push(String.from_bytes(raw.slice(at, at + length)) ?? return None)
        at += length
    }
    Val(fields)
}

// Publish the canonical display of a CRDT document onto session `over`
// (jet_sync_publish). A session keeps its generation and merged document; a
// publication that changes the document advances the generation, and a
// duplicate delivery returns the existing receipt. The document merges only
// facts that survive the display: map keys with equal values, list members and
// counter components. A conflicting map value or a differing text document is
// denied rather than replaced by a lexical winner. The Rust adapter also handed
// each change to the installed live transport subscribers; the native runtime
// installs none.
sync: fn(doc_show: String, over: String) -> String Never! {
    if over.trim() == "" || over.len() > SYNC_MAX_SESSION || unicode.has_control(over) -> return "SyncError(invalid session)"
    document: sync_document_parse(doc_show) ?? return "SyncError(document is not a canonical CRDT value)"
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return "SyncError(session registry is unavailable)"
        found := -1
        sessions := 0
        loop index in 0..<registry.records.len() {
            if registry.records[index].source != LIVE_SYNC_SOURCE -> next
            sessions += 1
            if registry.records[index].key == over -> found = index
        }
        generation := 0
        current := document.copy()
        if found >= 0 {
            stored: sync_session_decode(registry.records[found].value) ?? return "SyncError(session registry is unavailable)"
            generation = stored.generation
            current = stored.document.copy()
        } else if sessions >= SYNC_MAX_ENTRIES {
            return "SyncError(session limit exceeded)"
        }
        changed := false
        if current != document {
            merged: sync_document_merge(current, document) ?? return "SyncError(document merge denied)"
            if merged != current {
                if generation >= SYNC_MAX_INT -> return "SyncError(session generation exhausted)"
                generation += 1
                current = merged
                changed = true
            }
        } else if generation == 0 {
            generation = 1
            changed = true
        }
        receipt: "SyncOver(session={over}, generation={generation}, doc={current})"
        if !changed -> return receipt
        value: "{generation}:{current}"
        if found >= 0 {
            registry.records[found].value = value
        } else {
            id: registry.next_id + 1
            registry.next_id = id
            registry.records.push(LiveRecord{id: id, source: LIVE_SYNC_SOURCE, key: over.copy(), value: value, dirty: false, every_ns: 0, ran_ns: 0})
        }
        if live_cell_replace(seen, live_encode(registry)) -> return receipt
    }
}

SyncSession: struct {
    generation: Int
    document: String
}

sync_session_decode: fn(value: String) -> SyncSession? {
    colon: value.find(":")
    if colon < 0 -> return None
    generation: Int.parse(value.slice(0, colon)) ?? return None
    Val(SyncSession{generation: generation, document: value.slice(colon + 1, value.len())})
}

// The canonical document `value` names, or None when it is malformed or not in
// canonical order (JetSyncDocument::parse).
sync_document_parse: fn(value: String) -> String? {
    if value == "" || value.trim() != value || value.len() > SYNC_MAX_DOCUMENT || unicode.has_control(value) -> return None
    if !value.ends_with(")") -> return None
    if value.starts_with("SyncText(") -> return Val(value.copy())
    canonical := ""
    if value.starts_with("SyncMap(") {
        canonical = sync_map_show(sync_map_entries(value) ?? return None)
    } else if value.starts_with("SyncList(") {
        canonical = sync_list_show(sync_list_items(value) ?? return None)
    } else if value.starts_with("PNCounter(") {
        canonical = sync_counter_show(sync_counter_entries(value) ?? return None)
    } else {
        return None
    }
    if canonical != value -> return None
    Val(canonical)
}

sync_document_merge: fn(left: String, right: String) -> String? {
    if left == right -> return Val(left.copy())
    merged := ""
    if left.starts_with("SyncMap(") && right.starts_with("SyncMap(") {
        entries := sync_map_entries(left) ?? return None
        other: sync_map_entries(right) ?? return None
        loop key in other.keys() {
            value: other.get(key) ?? next
            if entries.get(key) == .Val(existing) {
                if existing != value -> return None
            } else {
                _: entries.add(key, value)
            }
        }
        if entries.len() > SYNC_MAX_ENTRIES -> return None
        merged = sync_map_show(entries)
    } else if left.starts_with("SyncList(") && right.starts_with("SyncList(") {
        items := sync_list_items(left) ?? return None
        loop item in sync_list_items(right) ?? return None {
            items = sync_pair_insert(items, item) ?? items
        }
        if items.len() > SYNC_MAX_ENTRIES -> return None
        merged = sync_list_show(items)
    } else if left.starts_with("PNCounter(") && right.starts_with("PNCounter(") {
        counts := sync_counter_entries(left) ?? return None
        other: sync_counter_entries(right) ?? return None
        loop replica in other.keys() {
            count: other.get(replica) ?? next
            slot: counts.get(replica) ?? SyncCount{positive: 0, negative: 0}
            positive: if count.positive > slot.positive -> count.positive else -> slot.positive
            negative: if count.negative > slot.negative -> count.negative else -> slot.negative
            _: counts.add(replica, SyncCount{positive: positive, negative: negative})
        }
        if counts.len() > SYNC_MAX_REPLICAS -> return None
        merged = sync_counter_show(counts)
    } else {
        return None
    }
    sync_document_parse(merged)
}

SyncPair: struct {
    first: String
    second: String
}

SyncCount: struct {
    positive: Int
    negative: Int
}

sync_map_entries: fn(value: String) -> [String:String]? {
    body: sync_document_body(value, "SyncMap(") ?? return None
    entries := [String:String]{}
    if body == "" -> return Val(entries)
    loop entry in sync_split(body, ",") ?? return None {
        pair: sync_split_once(entry, "=") ?? return None
        key: sync_unescape(pair.first) ?? return None
        item: sync_unescape(pair.second) ?? return None
        if !sync_token_valid(key) || item.len() > SYNC_MAX_TEXT || entries.get(key) != .None -> return None
        _: entries.add(key, item)
    }
    Val(entries)
}

sync_map_show: fn(entries: [String:String]) -> String {
    keys := [String]{}
    loop key in entries.keys() -> keys.push(key)
    keys.sort()
    shown := [String]{}
    loop key in keys {
        value: entries.get(key) ?? next
        shown.push("{sync_escape(key)}={sync_escape(value)}")
    }
    "SyncMap({shown.join(",")})"
}

sync_list_items: fn(value: String) -> [SyncPair]? {
    body: sync_document_body(value, "SyncList(") ?? return None
    items := [SyncPair]{}
    if body == "" -> return Val(items)
    loop raw in sync_split(body, "|") ?? return None {
        pair: sync_split_once(raw, ":") ?? return None
        replica: sync_unescape(pair.first) ?? return None
        item: sync_unescape(pair.second) ?? return None
        if !sync_token_valid(replica) || item.len() > SYNC_MAX_TEXT -> return None
        items = sync_pair_insert(items, SyncPair{first: replica, second: item}) ?? return None
    }
    if items.len() > SYNC_MAX_ENTRIES -> return None
    Val(items)
}

// `items` with `item` in (first, second) order; None when already present.
sync_pair_insert: fn(items: [SyncPair], item: SyncPair) -> [SyncPair]? {
    out := [SyncPair]{}
    placed := false
    loop existing in items {
        if existing.first == item.first && existing.second == item.second -> return None
        later: if existing.first == item.first -> existing.second > item.second else -> existing.first > item.first
        if !placed && later {
            out.push(item.copy())
            placed = true
        }
        out.push(existing.copy())
    }
    if !placed -> out.push(item.copy())
    Val(out)
}

sync_list_show: fn(items: [SyncPair]) -> String {
    shown := [String]{}
    loop item in items -> shown.push("{sync_escape(item.first)}:{sync_escape(item.second)}")
    "SyncList({shown.join("|")})"
}

sync_counter_entries: fn(value: String) -> [String:SyncCount]? {
    body: sync_document_body(value, "PNCounter(") ?? return None
    counts := [String:SyncCount]{}
    if body == "" -> return Val(counts)
    loop entry in sync_split(body, ",") ?? return None {
        pair: sync_split_once(entry, "=") ?? return None
        replica: sync_unescape(pair.first) ?? return None
        sides: sync_split_once(pair.second, "/") ?? return None
        positive: sync_count_parse(sync_unescape(sides.first) ?? return None, "+") ?? return None
        negative: sync_count_parse(sync_unescape(sides.second) ?? return None, "-") ?? return None
        if !sync_token_valid(replica) || counts.get(replica) != .None -> return None
        _: counts.add(replica, SyncCount{positive: positive, negative: negative})
    }
    if counts.len() > SYNC_MAX_REPLICAS -> return None
    // The checked total of positive minus negative counts must stay an Int.
    total := 0
    loop replica in counts.keys() {
        count: counts.get(replica) ?? next
        if total > 0 && count.positive > SYNC_MAX_INT - total -> return None
        total = total + count.positive
        if total < 0 && count.negative > SYNC_MAX_INT + total + 1 -> return None
        total = total - count.negative
    }
    Val(counts)
}

sync_counter_show: fn(counts: [String:SyncCount]) -> String {
    replicas := [String]{}
    loop replica in counts.keys() -> replicas.push(replica)
    replicas.sort()
    shown := [String]{}
    loop replica in replicas {
        count: counts.get(replica) ?? next
        shown.push("{sync_escape(replica)}=+{count.positive}/-{count.negative}")
    }
    "PNCounter({shown.join(",")})"
}

// `text` is `sign` then decimal digits; its value.
sync_count_parse: fn(text: String, sign: String) -> Int? {
    if !text.starts_with(sign) || text.len() == 1 -> return None
    digits: text.slice(1, text.len())
    loop byte in digits.bytes() {
        n: Int.from_u8(byte)
        if n < 48 || n > 57 -> return None
    }
    Val(Int.parse(digits) ?? return None)
}

sync_document_body: fn(value: String, prefix: String) -> String? {
    if !value.starts_with(prefix) || !value.ends_with(")") || value.len() < prefix.len() + 1 -> return None
    Val(value.slice(prefix.len(), value.len() - 1))
}

sync_token_valid: fn(value: String) -> Bool {
    value.trim() != "" && value.len() <= SYNC_MAX_TEXT && !unicode.has_control(value)
}

sync_is_separator: fn(scalar: String) -> Bool {
    scalar == "," || scalar == "=" || scalar == "|" || scalar == ":" || scalar == "/"
}

sync_escape: fn(value: String) -> String {
    out := ""
    loop scalar in unicode.scalars(value) {
        if scalar == "\\" || sync_is_separator(scalar) -> out = "{out}\\"
        out = "{out}{scalar}"
    }
    out
}

// None when an escape is dangling or names no separator, or when a separator
// appears unescaped.
sync_unescape: fn(value: String) -> String? {
    out := ""
    escaped := false
    loop scalar in unicode.scalars(value) {
        if escaped {
            if scalar != "\\" && !sync_is_separator(scalar) -> return None
            out = "{out}{scalar}"
            escaped = false
        } else if scalar == "\\" {
            escaped = true
        } else if sync_is_separator(scalar) {
            return None
        } else {
            out = "{out}{scalar}"
        }
    }
    if escaped -> return None
    Val(out)
}

// The parts of `value` between unescaped `separator`s, escapes kept.
sync_split: fn(value: String, separator: String) -> [String]? {
    parts := [String]{}
    current := ""
    escaped := false
    loop scalar in unicode.scalars(value) {
        if escaped {
            current = "{current}\\{scalar}"
            escaped = false
        } else if scalar == "\\" {
            escaped = true
        } else if scalar == separator {
            parts.push(current)
            current = ""
        } else {
            current = "{current}{scalar}"
        }
    }
    if escaped -> return None
    parts.push(current)
    Val(parts)
}

// `value` split at its first unescaped `separator`; None without one.
sync_split_once: fn(value: String, separator: String) -> SyncPair? {
    before := ""
    escaped := false
    at := 0
    loop scalar in unicode.scalars(value) {
        at += scalar.len()
        if escaped {
            escaped = false
        } else if scalar == "\\" {
            escaped = true
        } else if scalar == separator {
            return Val(SyncPair{first: before, second: value.slice(at, value.len())})
        }
        before = "{before}{scalar}"
    }
    None
}

valid_provider: fn(value: String) -> Bool {
    if value == "" || value.len() > 64 -> return false
    loop byte in value.bytes() {
        n: Int.from_u8(byte)
        allowed:
            (n >= 48 && n <= 57) ||
            (n >= 65 && n <= 90) ||
            (n >= 97 && n <= 122) ||
            n == 95 || n == 45
        if !allowed -> return false
    }
    true
}

valid_identifier: fn(value: String) -> Bool {
    trimmed: value.trim()
    if trimmed == "" || trimmed.len() > 128 || value != trimmed -> return false
    loop byte in value.bytes() {
        n: Int.from_u8(byte)
        allowed:
            (n >= 48 && n <= 57) ||
            (n >= 65 && n <= 90) ||
            (n >= 97 && n <= 122) ||
            n == 95
        if !allowed -> return false
    }
    true
}


contains_string: fn(values: [String], value: String) -> Bool {
    loop item in values {
        if item == value -> return true
    }
    false
}
