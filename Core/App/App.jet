package: {
    name: "app"
    version: "0.0.1"
    edition: "2026"
    description: "Process-level live queries, subscriptions, invalidation and sync."
    license: "MIT"
    outputs: {
        app: .Library{ entry: app }
    }
}

// Live bindings live in one process-wide registry below; sync sessions are
// records of that registry under LIVE_SYNC_SOURCE.
use {
    auth: core.auth
    unicode: core.text
    http: core.http
    crypto: core.crypto
    live_json: core.encoding.json
    core.encoding.[Dyn]
    core.reactive.loadable.[Loadable]
    ws: core.net.ws
    core.net.ws.[WsConn]
    tasks: core.tasks
    core.tasks.[TaskID]
    time: core.time
    rt: jet.runtime.time
    rt_web: jet.runtime.web
    world_rt: jet.runtime.testing
}

SYNC_MAX_SESSION: 256

SYNC_MAX_DOCUMENT: 4194304

SYNC_MAX_TEXT: 1048576

SYNC_MAX_ENTRIES: 100000

SYNC_MAX_REPLICAS: 4096

SYNC_MAX_INT: 9223372036854775807

#Error
AppError: enum {
    Invalid
    Unsupported
}

// Endpoint markers. A method of a mounted service is an endpoint only when
// one of these marks it: `#App.SignedIn` for a signed-in caller,
// `#App.Public` for any caller. An unmarked method is server-only.
// `limit:` caps the calls one caller makes in each `per` window
// (`#App.Public(limit: 30, per: 1min)`); a call past it is answered 429
// with `Retry-After`, which a Remote reads as `CallError.Unreachable`.
// `#App.Public` counts per network address; `#App.SignedIn` counts per
// account once sign-in names one, and per network address until then.
// `limit: 0`, the default, is no limit.
SignedIn: struct {
    limit: Int{0}
    per: Duration{1min}

    impl Marker {
        sites: [.Method]
    }
}

Public: struct {
    limit: Int{0}
    per: Duration{1min}

    impl Marker {
        sites: [.Method]
    }
}

// A webhook: `#App.Webhook(path: "/hooks/github/:project", signature:
// app.Signature.GitHub, key: "webhook_secret")` makes a method of a mounted
// service answer POST `path` for a sender that signs each delivery. Its
// parameters are the path's parameters, then the delivery's decoded JSON
// body. `key:` names the service's `#App.SigningKey` method, which gives the
// delivery's key from the same path parameters. A delivery runs only when
// that key is there and the delivery carries a valid `signature` under it,
// checked in constant time before the body is decoded; any other is answered
// 401. A webhook is no endpoint: no Remote calls it.
Webhook: struct {
    path: String
    signature: Signature
    key: String

    impl Marker {
        sites: [.Method]
    }
}

// The method a webhook's `key:` names. It takes some of the webhook's path
// parameters, by name, and gives the key the sender signs with, or None,
// which answers 401. It is server-only.
SigningKey: struct {
    impl Marker {
        sites: [.Method]
    }
}

// A job: `#App.Job(retries: 3)` makes a method of a service a job, which the
// service's own methods queue with `enqueue(fn() { self.method(args) })`.
// Queued inside a call, a job waits for the call: when the call commits it
// runs, once its transaction is done, and when the call rolls back it never
// runs. A job runs as the system (`as_system`), in a call of its own, and a
// run that fails runs again after a backoff, up to `retries:` more times. A
// job is no endpoint: no Remote calls it.
Job: struct {
    retries: Int{5}

    impl Marker {
        sites: [.Method]
    }
}

// A schedule: `#App.Every(cron: "0 8 * * *")` runs a method of a mounted
// service at each minute its cron line allows, in UTC, while the App serves.
// The line has five fields, each a `*`, a number, a range `a-b`, or a list
// of those, each optionally stepped (`*/15`): the minute (0-59), the hour
// (0-23), the day of the month (1-31), the month (1-12) and the day of the
// week (0-7, Sunday 0 or 7). A day is due when both day fields allow it,
// or either does when neither starts with `*`. At start-up a server runs
// the schedule's latest due minute, a run it missed while no server ran,
// and then each next one. A store the run uses records it, so each due
// minute runs on one server, however many serve the App. A schedule runs
// as the system (`as_system`), in a call of its own, and is no endpoint:
// no Remote calls it.
Every: struct {
    cron: String

    impl Marker {
        sites: [.Method]
    }
}

// How a webhook's sender signs a delivery: an HMAC-SHA256, hex-encoded,
// under the webhook's key.
Signature: enum {
    GitHub
    Stripe
}

// GitHub: `X-Hub-Signature-256: sha256=<mac>`, the MAC of the body.
// Stripe: `Stripe-Signature: t=<seconds>,v1=<mac>`, the MAC of
// `<seconds>.<body>`; any one `v1` entry may match.

// The request header that carries a delivery's `signature`.
priv webhook_header: fn(signature: Signature) -> String Never! {
    if signature == {
        .GitHub -> "x-hub-signature-256"
        .Stripe -> "stripe-signature"
    }
}

// Whether `sent`, the delivery's signature header, signs `body` under `key`
// by `signature`. Each MAC is compared in constant time, and every `v1`
// entry of a Stripe header is compared.
priv webhook_signed: fn(signature: Signature, key: String, sent: String, body: String) -> Bool Never! {
    if signature == {
        .GitHub -> {
            expected: "sha256={crypto.hex_encode(crypto.hmac_sha256(key.bytes(), body.bytes()))}"
            crypto.constant_time_equal_bytes(expected.bytes(), sent.bytes())
        }
        .Stripe -> {
            stamp := ""
            macs := [String]{}
            loop part in sent.split(",") {
                entry: part.trim()
                if entry.starts_with("t=") -> stamp = entry.slice(2, entry.len())
                if entry.starts_with("v1=") -> macs.push(entry.slice(3, entry.len()))
            }
            if stamp == "" -> return false
            expected: crypto.hex_encode(crypto.hmac_sha256(key.bytes(), "{stamp}.{body}".bytes()))
            matched := false
            loop mac in macs {
                if crypto.constant_time_equal_bytes(expected.bytes(), mac.bytes()) -> matched = true
            }
            matched
        }
    }
}

#Test("webhook signatures check the sender's MAC") {
    // GitHub's published example delivery.
    github: "sha256=757107ea0eb2509fc211221cce984b8a37570b6d7586c22c46f4379c8b043e17"
    assert(webhook_signed(.GitHub, "It's a Secret to Everybody", github, "Hello, World!"))
    assert(!webhook_signed(.GitHub, "It's a Secret to Everybody", github, "Hello, World?"))
    assert(!webhook_signed(.GitHub, "another key", github, "Hello, World!"))
    assert(!webhook_signed(.GitHub, "It's a Secret to Everybody", "", "Hello, World!"))
    mac: crypto.hex_encode(crypto.hmac_sha256("whsec".bytes(), "1700000000.{{\"id\":\"evt_1\"}}".bytes()))
    assert(webhook_signed(.Stripe, "whsec", "t=1700000000,v1=00,v1={mac}", "{{\"id\":\"evt_1\"}}"))
    assert(!webhook_signed(.Stripe, "whsec", "t=1700000001,v1={mac}", "{{\"id\":\"evt_1\"}}"))
    assert(!webhook_signed(.Stripe, "whsec", "v1={mac}", "{{\"id\":\"evt_1\"}}"))
    assert_eq(webhook_header(.Stripe), "stripe-signature")
}

// A client of the service `S`. It offers only the methods of `S` that
// `#App.SignedIn` or `#App.Public` marks: a call of any other method of `S`
// is E2812, and the service itself stays out of reach. A call through a
// Remote that `remote` made runs the method directly on that service; one
// through a Remote that `remote_at` made posts it to the server. Either way
// the call is one transaction on each store it uses, as a served call is
// (`transactions`), and the call's error type takes a `CallError`: a method
// that fails with `E` needs `impl CallError -> E`, and one that can't fail
// answers `R CallError!`.
Remote: struct<S> {
    priv service: S?
    priv address: String

    // A call of the endpoint method `method` of `S`, which can fail with
    // `E`. The compiler lowers each such call here: `direct` runs it on the
    // service the Remote holds; otherwise `args`, the encoded arguments, go to
    // the server, and `fail` gives a `CallError` as the method's own error.
    __call: fn<R: [Encode, Decode], E: [Encode, Decode]>(self, method: String, args: [String], direct: fn(S) -> R E!, fail: fn(CallError) -> R E!) -[Net, Time.Wait]> R E! {
        if self.service == .Val(service) {
            loop _ in 0..<transactions.attempts() {
                call: transactions.begin() ?? return direct(service)
                if direct(service) == {
                    .Ok(value) -> {
                        if transactions.end(call, true) -> return Ok(value)
                    }
                    .Err(error) -> {
                        if transactions.end(call, false) -> return Err(error)
                    }
                }
            }
            return fail(.Unreachable("the database stayed busy"))
        }
        reply: remote_post(self.address, method, args) ?? return fail(err)
        tree: live_json.parse(reply) ?? return fail(.Unreachable("the server's reply to `{method}` is not JSON"))
        if live_json.at<E>(tree, "/err") == .Ok(error) -> return Err(error)
        value: live_json.at<R>(tree, "/ok") ?? return fail(.Unreachable("the server's reply to `{method}` has no value"))
        Ok(value)
    }

    // A call of the endpoint method `method` of `S`, which can't fail.
    __call_value: fn<R: [Encode, Decode]>(self, method: String, args: [String], direct: fn(S) -> R Never!) -[Net, Time.Wait]> R CallError! {
        if self.service == .Val(service) {
            loop _ in 0..<transactions.attempts() {
                call: transactions.begin() ?? return Ok(direct(service))
                value: direct(service)
                if transactions.end(call, true) -> return Ok(value)
            }
            return Err(.Unreachable("the database stayed busy"))
        }
        reply: remote_post(self.address, method, args)
        tree: live_json.parse(reply) ?? return Err(.Unreachable("the server's reply to `{method}` is not JSON"))
        value: live_json.at<R>(tree, "/ok") ?? return Err(.Unreachable("the server's reply to `{method}` has no value"))
        Ok(value)
    }

    // One argument of a remote call, encoded.
    __arg: fn<A: Encode>(self, value: A) -> String Never! {
        live_json.to_string<A>(value) ?? "null"
    }

    // `failure` as an error of the call; the compiler's `fail` binds it, so
    // the method's error type takes it through its conversion.
    __raise: fn<R>(self, failure: CallError) -> R CallError! { Err(failure) }
}

// How a remote call failed. Every call through a `Remote` can fail this way,
// so the error type of a service method converts from it.
#Error
CallError: enum {
    Unreachable(String)
    Invalid([FieldError])
    SignedOut
    UpdateRequired
}

// No answer: the server is down or unreachable, or its reply was not one
// a Remote reads.
// The server could not decode the call's arguments (HTTP 422): the field
// errors its reply names.
// The method needs a signed-in caller, and the call had none (HTTP 401).
// The server no longer accepts this client's wire version (HTTP 426).

// A field error a method reports for one of its arguments, from a rule the
// argument's `validate` block can't check (one that reads the database):
// `at` is the path of the field it is about, in that argument (`assignee`,
// `tasks[3].title`, `tasks[{index}].title`), and `reason` what is wrong with
// it. `at` must be a string literal, interpolated only inside a `[…]` index,
// that walks to a stored field of a struct argument of the method that
// reports it (E2813), so the error shows beside that field, as a failed
// `validate` check does.
field_error: fn(at: String, reason: String) -> FieldError Never! {
    FieldError{path: at, reason: reason}
}

// The largest reply a remote call reads.
REMOTE_MAX_REPLY: 16777216

// The Remote of a service the server holds: each call through it runs the
// marked method on `service` directly.
remote: fn<S>(service: &&S) -> Remote<S> Never! { Remote<S>{service: Val(service), address: ""} }

// The Remote of a service a server mounts at `address`, its mount prefix
// (`http://127.0.0.1:8080/api`): each call posts its JSON arguments to
// `{address}/{method}`.
remote_at: fn<S>(address: String) -> Remote<S> Never! { Remote<S>{service: None, address: address} }

// One remote call: POST the JSON array of `args` to `{address}/{method}`;
// the reply's body on 200, else the failure its status names. The call
// carries a W3C `traceparent` that starts its trace, and that trace's id as
// its `x-request-id`, so the server's span of the call has both.
priv remote_post: fn(address: String, method: String, args: [String]) -[Net, Time.Wait]> String CallError! {
    seed: "{rt.clock_mono_ns()}:{trace_next()}:{address}/{method}"
    trace: make_trace_id("trace:{seed}", 16)
    sent: http.__request("POST", "{address}/{method}").__with_header("traceparent", "00-{trace}-{make_trace_id("span:{seed}", 8)}-01").__with_header("x-request-id", trace).__with_body("[{args.join(",")}]")
    response: sent.send() ?? return Err(.Unreachable("{address}/{method}: {err}"))
    text: response.body.text(REMOTE_MAX_REPLY) ?? return Err(.Unreachable("{address}/{method}: {err}"))
    if {
        response.status == 200 -> Ok(text)
        response.status == 401 -> Err(.SignedOut)
        response.status == 422 -> Err(.Invalid(remote_invalid(text)))
        response.status == 426 -> Err(.UpdateRequired)
        response.status == 429 -> Err(.Unreachable("{address}/{method} is limited: retry after {response.header("retry-after") ?? "?"} s"))
        else -> Err(.Unreachable("{address}/{method} answered {response.status}"))
    }
}

// A W3C trace-context id of `n` bytes (16 for a trace, 8 for a span) as
// lowercase hex: the leading bytes of `seed`'s SHA-256. Each caller's seed
// holds a clock reading and a count, so no two ids it makes repeat; ids
// need no random source, which a handler's effects do not allow.
priv make_trace_id: fn(seed: String, n: Int) -> String Never! {
    digest: crypto.sha256(seed)
    crypto.hex_encode(digest.bytes.slice(0, n))
}

// The process's count of the trace seeds a Remote makes.
TRACE_SEEDS: Shared{0}

priv trace_next: fn() -> Int Never! {
    guard := TRACE_SEEDS.guard_edit()
    guard.value += 1
    guard.value
}

// The field errors of a 422 reply, `{"invalid": [{"path": …, "reason":
// …}, …]}`; a reply that is not that shape is one error with its text.
priv remote_invalid: fn(text: String) -> [FieldError] Never! {
    tree: live_json.parse(text) ?? return [FieldError]{FieldError{path: "", reason: "{text}"}}
    errors := [FieldError]{}
    index := 0
    loop {
        reason: live_json.at<String>(tree, "/invalid/{index}/reason") ?? break
        path: live_json.at<String>(tree, "/invalid/{index}/path") ?? ""
        errors.push(FieldError{path: path, reason: reason})
        index += 1
    }
    if errors.len() == 0 -> return [FieldError]{FieldError{path: "", reason: "{text}"}}
    errors
}

// A live binding: one source function applied to one argument list, run as
// the caller that made it. The compiler builds it from
// `live(source, args...)` or `subscribe(source, args...)`; `state` reads it.
// A source may read the database, fetch over the network and wait, nothing
// more, so `state` runs on every target that has those, the web included.
Live: struct<T, E> {
    id: Int
    run: fn() -[DB.Read, Net, Time]> T E!
    priv acting: Acting?
}

// One registry binding, named by its source's wire name, its encoded
// argument list and `caller`, the caller it runs as (`acting_tag`), so two
// callers never share a result. `value` is the last result, `ok:` or `err:`
// then its JSON, and empty before the first run; `generation` counts the
// invalidations that reached the binding; `overtaken` counts its runs in a
// row that an invalidation overtook, and `held_ns` is the monotonic time
// until which a stale binding serves its stored result (0: none); `every_ns`
// is the poll interval (0: none) and `ran_ns` the monotonic time of the last
// run. `reads` is its read set: the other sources (a table's
// `core.db.live:<table>`) its runs read (`live_reads`), so a write to any of
// them re-runs it too.
LiveRecord: struct {
    id: Int
    source: String
    key: String
    value: String
    dirty: Bool
    generation: Int
    overtaken: Int
    held_ns: Int
    every_ns: Int
    ran_ns: Int
    reads: [String]
    caller: String
}

// What `state` reads before it runs a binding: the stored result when it is
// current, held, or capped (live_current), and the binding's generation then.
LiveCurrent: struct {
    value: String?
    generation: Int
}

// `capped` counts the re-runs the per-second cap turned into holds;
// `window_ns` starts the current second of re-runs and `window_runs` counts
// the re-runs in it.
LiveRegistry: struct {
    next_id: Int
    invalidations: Int
    changes: Int
    evictions: Int
    ws_pushes: Int
    capped: Int
    window_ns: Int
    window_runs: Int
    records: [LiveRecord]
}

// The live registry lives in a process-wide runtime byte cell; every update
// reads the cell, edits the decoded registry and installs it only if the cell
// is unchanged, retrying otherwise, so concurrent callers never lose an update.
//
// The compiler checks `live`, `subscribe`, `push` and `invalidate` against
// their source function and lowers them to the `__live_*` helpers below.

// The binding's current state. The source re-runs when the binding has no
// result yet, was invalidated, or its poll interval has passed; the stored
// result changes only when the re-run's encoding differs. A re-run that an
// invalidation overtook stores its result but leaves the binding stale, since
// what it read may predate that write. Under writes that keep overtaking it, a
// binding settles: from its second overtaken run in a row, its stale result
// is served for a hold (live_store) instead of running the source on every
// read, and its watchers (`watch`) are told when to read it again. A server
// re-runs at most LIVE_MAX_RERUNS_PER_SECOND bindings a second; past that, a
// binding's stored result is held until the next second (live_current). Writes
// between two reads cost one re-run, however many there were. While the
// source runs, the tables it reads join the binding's read set (`live_reads`).
state: fn<T: [Encode, Decode], E: [Encode, Decode]>(binding: Live<T, E>) -> Loadable<T, E> Never! {
    now: rt.clock_mono_ns()
    seen: live_current(binding.id, now)
    if seen.value == .Val(text) {
        if live_value_state<T, E>(text) == .Val(current) -> return current
    }
    value: live_run(binding) ?? {
        if live_json.to_string<E>(err) == .Ok(encoded) {
            live_store(binding.id, "err:{encoded}", now, Val(seen.generation))
        }
        return Loadable.Failed(err)
    }
    if live_json.to_string<T>(value) == .Ok(encoded) {
        live_store(binding.id, "ok:{encoded}", now, Val(seen.generation))
    }
    Loadable.Loaded(value)
}

// Runs `binding`'s source as this task's running binding, so the reads it
// makes join the binding's read set, and as the caller that made the
// binding, whoever reads it now.
live_run: fn<T: [Encode, Decode], E: [Encode, Decode]>(binding: Live<T, E>) -> T E! {
    me: tasks.current_task()
    live_run_begin(me, binding.id)
    acting_begin(me, binding.acting.copy())
    value: binding.run() ?? {
        acting_end(me)
        live_run_end(me)
        return Err(err)
    }
    acting_end(me)
    live_run_end(me)
    Ok(value)
}

// `socket`, a server-side WebSocket connection, receives
// `{"live":"invalidate","binding":<id>}` each time `binding` is invalidated,
// starting with the latest such event when there was one. While the binding
// is held (live_store), the event carries `"after_ms":<n>`: a read in the
// next n milliseconds gets the held stale result, so the client reads again
// after them, and the binding's first current result after the hold sends the
// event again. A connection receives only the bindings its handler watches;
// the handler holds `binding` because it read it for its own caller under
// that caller's policy.
watch: fn<T: [Encode, Decode], E: [Encode, Decode]>(socket: WsConn, binding: Live<T, E>) Never! -[Net]> {
    ws.__live_watch(socket, "live:{binding.id}")
}

// `changes` counts stored results that differed from the one before;
// `ws_pushes` counts the publishes to the WebSocket live hub: one per
// `invalidate` that marked a binding, and one per hold's start and end;
// `capped` counts the re-runs the per-second cap held over.
live_stats: fn() -> String Never! {
    registry: live_decode(live_cell_load()) ?? return "LiveStats(error=live registry unavailable)"
    "LiveStats(queries={live_query_count(registry)}, limit={LIVE_MAX_QUERIES}, evictions={registry.evictions}, invalidations={registry.invalidations}, changes={registry.changes}, ws_pushes={registry.ws_pushes}, reruns_per_second={LIVE_MAX_RERUNS_PER_SECOND}, capped={registry.capped})"
}

// The live bindings of `registry`; sync's session records are not queries.
live_query_count: fn(registry: LiveRegistry) -> Int {
    count := 0
    loop record in registry.records {
        if record.source != LIVE_SYNC_SOURCE -> count += 1
    }
    count
}

// `live(source, args...)`: `args` are the encoded arguments. The binding
// runs as this task's caller.
__live_bind: fn<T: [Encode, Decode], E: [Encode, Decode]>(source: String, args: [String], run: &&fn() -[DB.Read, Net, Time]> T E!) -> Live<T, E> Never! {
    acting: acting_now(tasks.current_task())
    Live<T, E>{id: live_register(source, live_key(args), acting_tag(acting), 0), run: run, acting: acting}
}

// `subscribe(source, args..., every:)`: a binding polled every `every`.
__live_poll: fn<T: [Encode, Decode], E: [Encode, Decode]>(source: String, args: [String], every: Duration?, run: &&fn() -[DB.Read, Net, Time]> T E!) -> Live<T, E> Never! {
    every_ns := 0
    if every == .Val(interval) && interval.ns > 0 -> every_ns = interval.ns
    acting: acting_now(tasks.current_task())
    Live<T, E>{id: live_register(source, live_key(args), acting_tag(acting), every_ns), run: run, acting: acting}
}

// `push(source, args..., value:)` stores `value` as that binding's result,
// registering the binding when nothing has read it yet. Only the binding of
// this task's caller gets it: a value one caller computed never reaches
// another's binding.
__live_push: fn<T: Encode>(source: String, args: [String], value: T) Never! {
    encoded: live_json.to_string<T>(value) ?? return
    key: live_key(args)
    id: live_register(source, key, acting_tag(acting_now(tasks.current_task())), 0)
    live_store(id, "ok:{encoded}", -1, None)
}

// `invalidate(source, args...)`: exactly that argument list re-runs.
__live_invalidate: fn(source: String, args: [String]) Never! {
    live_invalidate(source, Val(live_key(args)))
}

// `invalidate(source)`: every binding of `source` re-runs.
__live_invalidate_all: fn(source: String) Never! { live_invalidate(source, None) }

// One argument's part of a binding's identity, and one argument of a queued
// job's call: the argument encoded, or `_`, which no JSON reads, when it
// doesn't encode, so a job given it fails each run.
__live_arg: fn<A: Encode>(value: A) -> String Never! { live_json.to_string<A>(value) ?? "_" }

// A binding's read set, for core.db: while a task runs a binding's source,
// each table it reads joins that binding's read set, so a write to the table
// re-runs the binding as it re-runs the table's own bindings.
priv(package) live_reads: module {
    // Whether this task is running a binding's source, so a database read
    // it makes belongs to that binding's read set.
    running: fn() -> Bool Never! { live_running(tasks.current_task()) != None }

    // Adds `source` (a table's `core.db.live:<table>`) to the read set of
    // the binding this task runs. Recorded before the read runs, so a write
    // committed after the read always reaches the binding.
    record: fn(source: String) Never! {
        id: live_running(tasks.current_task()) ?? return
        loop {
            seen: live_cell_load()
            registry := live_decode(seen) ?? return
            index: live_index(registry, id) ?? return
            if registry.records[index].source == source || registry.records[index].reads.contains(source) {
                return
            }
            registry.records[index].reads.push(source.copy())  // copy: a lost race retries with the same source
            if live_cell_replace(seen, live_encode(registry)) {
                return
            }
        }
    }
}

// The bindings whose sources are running now, each with its task; a source
// that reads another binding stacks that binding on its own.
LiveRun: struct {
    task: TaskID
    id: Int
}

LiveRunning: struct {
    runs: [LiveRun]
}

LIVE_RUNNING: Shared{LiveRunning{runs: [LiveRun]{}}}

live_run_begin: fn(task: TaskID, id: Int) {
    running := LIVE_RUNNING.guard_edit()
    running.value.runs.push(LiveRun{task: task, id: id})
}

live_run_end: fn(task: TaskID) {
    running := LIVE_RUNNING.guard_edit()
    at := running.value.runs.len()
    loop at > 0 {
        at -= 1
        if task == running.value.runs[at].task {
            _: running.value.runs.remove(at, .Slot)
            return
        }
    }
}

// The binding `task` is running now, the innermost when it runs several.
live_running: fn(task: TaskID) -> Int? {
    running := LIVE_RUNNING.guard_edit()
    at := running.value.runs.len()
    loop at > 0 {
        at -= 1
        if running.value.runs[at].task == task -> return Val(running.value.runs[at].id)
    }
    None
}

// Whom a task acts for. `as_caller` runs a function for an account and
// `as_system` for the server itself. A task that runs neither acts for no
// one, and so does a task another one spawns: a caller never passes to
// another task. A guarded core.db table asks its row policy as this caller,
// and as no one, never as the system, when there is none. A live binding
// runs as the caller that made it.
Acting: enum {
    Account(auth.AccountID)
    System
}

// The runs of `as_caller`, `as_system` and binding sources, each with its
// task and the caller it acts for (None: no one); a task's innermost run
// names its caller.
ActingRun: struct {
    task: TaskID
    acting: Acting?
}

ActingRuns: struct {
    runs: [ActingRun]
}

ACTING: Shared{ActingRuns{runs: [ActingRun]{}}}

// Runs `run` acting for the account `account` and gives what it gives; the
// account is `maybe_caller()` within it. `run` handles its own failures, so
// a caller with any failure contract may call this.
as_caller: fn<R>(account: auth.AccountID, run: fn() -> R Never!) -> R Never! {
    acting_within(Val(Acting.Account(account.copy())), run)
}

// Runs `run` acting for the server itself, which no row policy limits, and
// gives what it gives. A job or a schedule that reads every row runs so; a
// request never does.
as_system: fn<R>(run: fn() -> R Never!) -> R Never! { acting_within(Val(Acting.System), run) }

// The account this task acts for: None when it acts for the system or for
// no one.
maybe_caller: fn() -> auth.AccountID? Never! {
    if acting_now(tasks.current_task()) == .Val(.Account(account)) -> return Val(account)
    None
}

// The account this task acts for, where a caller is certain: the compiler
// accepts a call only on a path that starts at an `#App.SignedIn` method or
// inside `as_caller`. A path the compiler can't follow (a function value
// another task runs) that reaches it acting for no account stops here.
caller: fn() -> auth.AccountID Never! {
    maybe_caller() ?? panic("app.caller() ran acting for no account")
}

priv acting_within: fn<R>(acting: Acting?, run: fn() -> R Never!) -> R Never! {
    me: tasks.current_task()
    acting_begin(me, acting)
    defer acting_end(me)
    run()
}

priv acting_begin: fn(task: TaskID, acting: Acting?) {
    runs := ACTING.guard_edit()
    runs.value.runs.push(ActingRun{task: task, acting: acting})
}

priv acting_end: fn(task: TaskID) {
    runs := ACTING.guard_edit()
    at := runs.value.runs.len()
    loop at > 0 {
        at -= 1
        if task == runs.value.runs[at].task {
            _: runs.value.runs.remove(at, .Slot)
            return
        }
    }
}

// The caller `task` acts for now: None for no one.
priv acting_now: fn(task: TaskID) -> Acting? {
    runs := ACTING.guard_edit()
    at := runs.value.runs.len()
    loop at > 0 {
        at -= 1
        if runs.value.runs[at].task == task -> return runs.value.runs[at].acting.copy()
    }
    None
}

// A binding's registry name for the caller `acting`: empty for no one.
priv acting_tag: fn(acting: Acting?) -> String {
    if acting == {
        .Val(.Account(account)) -> "account:{account.raw()}"
        .Val(.System) -> "system"
        .None -> ""
    }
}

// The caller this task acts for, for core.db's row policies.
priv(package) callers: module {
    // Whether this task acts for the system.
    system: fn() -> Bool Never! {
        if acting_now(tasks.current_task()) == .Val(.System) -> return true
        false
    }

    // The account this task acts for: None for the system or no one.
    account: fn() -> auth.AccountID? Never! { maybe_caller() }

    // This task acts for the system until `end`, as a row policy's own
    // reads do.
    begin_system: fn() Never! { acting_begin(tasks.current_task(), Val(Acting.System)) }

    // Ends this task's innermost `begin_system`.
    end: fn() Never! { acting_end(tasks.current_task()) }
}

#Test("a task acts for its innermost run's caller, and a task it spawns for no one") {
    ann: auth.AccountID.from_string("ann")
    ben: auth.AccountID.from_string("ben")
    assert_eq(maybe_caller(), auth.AccountID?{None})
    seen: as_caller<String>(ann, fn() {
        assert(as_system(fn() { callers.system() }))
        assert_eq(as_system(fn() { maybe_caller() }), auth.AccountID?{None})
        assert_eq(as_caller(ben, fn() { maybe_caller() }), Val(ben))
        spawned: task { (maybe_caller() ?? auth.AccountID.from_string("no one")).raw() }
        assert_eq(spawned.join() ?? panic("the spawned task runs"), "no one")
        assert(!callers.system())
        (maybe_caller() ?? auth.AccountID.from_string("no one")).raw()
    })
    assert_eq(seen, "ann")
    assert_eq(maybe_caller(), auth.AccountID?{None})
    as_caller(ben, fn() {
        assert_eq(maybe_caller(), Val(ben))
        assert_eq(caller(), ben)
        assert(!callers.system())
    })
    assert_eq(maybe_caller(), auth.AccountID?{None})
    assert_eq(acting_tag(Val(Acting.Account(ann))), "account:ann")
    assert_eq(acting_tag(None), "")
}

// A call of a mounted service's method runs as one transaction on each
// store it uses. The framework opens the call on the task that runs it
// (`transactions.begin`); core.db begins an IMMEDIATE transaction on a
// store's connection at the call's first statement there and joins it to the
// call (`join`); `end` commits every joined transaction or rolls each back.
// A method the call reaches, and a row policy it asks, run on the same task
// and so in the same transaction; a task the call spawns is outside it. A
// store that can't begin or commit marks the call refused, and the framework
// then runs it again. A webhook's call carries its delivery (`deliver`),
// whose ID core.db records in each store's transaction as the call joins
// it; a store that has run the delivery already marks the call repeated, and
// the framework rolls it back and drops the delivery. A schedule's call
// carries its due run (`schedule`), which core.db records the same way, so
// a run another server has done is dropped as well. A job the call queues
// (`enqueue`) waits for it: `end` keeps the job in the outbox of the first
// store the call joined, in that store's transaction, under a key of its
// own, and once the call commits, runs it on a task of its own (`job_run`);
// a call that rolls back drops its jobs with its writes. Each run of a job
// carries its key as its delivery, so a store that has run the job drops a
// second run of it.
CallJoin: struct {
    // Commits (true) or rolls back (false) one store's transaction; false
    // when it couldn't do as asked.
    end: fn(Bool) -[]> Bool Never!
    outbox: CallOutbox
}

// One store's outbox: the jobs committed calls queued there that haven't
// run yet, a row each, found by the job's key. Each row is taken until a
// time (Unix milliseconds): the server that runs its job takes it again
// each tick while the job runs (`hold`), and once that time has passed, a
// serving server takes the row (`take`) and runs the job again, as when the
// server that ran it stopped.
CallOutbox: struct {
    // Names the store among the open ones: the database file's path, or
    // one of its own for an in-memory database.
    store: String
    // The time it is by the store's clock, the one its engine reads for
    // SQL's `'now'`, in Unix milliseconds.
    now: fn() -[]> Int Never!
    // Keeps job `name` with its encoded arguments, in the transaction of
    // the call this task runs, taken until `until`; the job's key, a new
    // random one, or "" when the store couldn't keep it.
    keep: fn(String, String, Int) -[]> String Never!
    // Deletes the row of key `key`, in the transaction of the call this
    // task runs, as its job runs there: 1; 0 when the row has gone, as
    // another run did the job; -1 when the store couldn't delete it.
    done: fn(String) -[]> Int Never!
    // Records on the row of key `key` that its job ran `runs` times and
    // failed each time, the last with `error`, and takes it until `until`;
    // false when the store couldn't.
    failed: fn(String, Int, String, Int) -[]> Bool Never!
    // Takes each row of a job named in `names` that is not taken at `now`,
    // until `until`, and gives each; None once the store has closed.
    take: fn([String], Int, Int) -[]> [CallQueued]? Never!
    // Takes the rows of keys `keys` until `until`; false when the store
    // couldn't.
    hold: fn([String], Int) -[]> Bool Never!
}

// A row a server took from a store's outbox: its job's key, name and
// encoded arguments, and the runs the job made so far, each failed.
CallQueued: struct {
    key: String
    name: String
    args: String
    runs: Int
}

// The function that decodes a job's arguments and runs it, which replies
// `{"err":...}` when the job failed. Copies share the one function.
CallJobCall: struct {
    call: fn(RemoteArgs) -> String [FieldError]!
}

// A job a call queued: its name (`<service module>.<Service>.<method>`), its
// arguments as one encoded JSON array, the runs it gets after a first that
// fails, and the function that runs it.
CallJob: struct {
    name: String
    args: String
    retries: Int
    run: Shared<CallJobCall>
}

// A webhook delivery a call runs: the ID its sender gives it, the same each
// time it is delivered again, and the second (since the Unix epoch) the
// server received it.
#Equatable
CallDelivery: struct {
    id: String
    at: Int
}

// A schedule's run a call is: the schedule's name (`<service
// module>.<Service>.<method>`) and the second (since the Unix epoch) it was
// due.
#Equatable
CallTick: struct {
    schedule: String
    due: Int
}

CallRun: struct {
    task: TaskID
    id: Int
    joins: [CallJoin]
    refused: Bool
    delivery: CallDelivery?
    tick: CallTick?
    repeated: Bool
    jobs: [CallJob]
}

CallRuns: struct {
    runs: [CallRun]
    made: Int
}

CALLS: Shared{CallRuns{runs: [CallRun]{}, made: 0}}

priv(package) transactions: module {
    // The times a call runs, in all, while a busy store refuses it. Each
    // refusal has already waited out the store's busy timeout, so the
    // attempts need no wait of their own.
    attempts: fn() -> Int Never! { 5 }

    // Opens a call on this task and gives its number; None when the task
    // runs one already, which the new call then belongs to.
    begin: fn() -> Int? Never! {
        me: tasks.current_task()
        runs := CALLS.guard_edit()
        loop run in runs.value.runs {
            if run.task == me -> return None
        }
        runs.value.made += 1
        runs.value.runs.push(CallRun{task: me, id: runs.value.made, joins: [CallJoin]{}, refused: false, delivery: None, tick: None, repeated: false, jobs: [CallJob]{}})
        Val(runs.value.made)
    }

    // The call this task runs, by number; None outside one.
    current: fn() -> Int? Never! {
        me: tasks.current_task()
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.task == me -> return Val(run.id)
        }
        None
    }

    // Joins one store's transaction, which `end` finishes, and that store's
    // outbox to call `call`.
    join: fn(call: Int, end: &&fn(Bool) -[]> Bool Never!, outbox: &&CallOutbox) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call {
                runs.value.runs[index].joins.push(CallJoin{end: end.move(), outbox: outbox.move()})
                return
            }
        }
    }

    // Queues `job` in call `call`, to run once the call commits.
    enqueue: fn(call: Int, job: &&CallJob) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call {
                runs.value.runs[index].jobs.push(job.move())
                return
            }
        }
    }

    // Marks call `call` refused: a store it uses was busy.
    refuse: fn(call: Int) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call -> runs.value.runs[index].refused = true
        }
    }

    // Whether a store refused call `call`.
    refused: fn(call: Int) -> Bool Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.refused
        }
        false
    }

    // Gives call `call` the webhook delivery it runs.
    deliver: fn(call: Int, delivery: CallDelivery) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call {
                runs.value.runs[index].delivery = Val(delivery.copy())
            }
        }
    }

    // The webhook delivery call `call` runs; None for any other call.
    delivery: fn(call: Int) -> CallDelivery? Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.delivery.copy()
        }
        None
    }

    // Gives call `call` the schedule's run it is.
    schedule: fn(call: Int, tick: CallTick) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call -> runs.value.runs[index].tick = Val(tick.copy())
        }
    }

    // The schedule's run call `call` is; None for any other call.
    tick: fn(call: Int) -> CallTick? Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.tick.copy()
        }
        None
    }

    // Marks call `call` repeated: a store it uses has run its delivery or
    // its schedule's run.
    repeat: fn(call: Int) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call -> runs.value.runs[index].repeated = true
        }
    }

    // Whether a store has run call `call`'s delivery or schedule's run
    // already.
    repeated: fn(call: Int) -> Bool Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.repeated
        }
        false
    }

    // Ends call `call`: commits each joined transaction, in the order the
    // call joined them, when `commit` holds and no store refused the call or
    // had run its delivery, and otherwise rolls each back. False when the
    // call has to run again: a store refused it, the first store couldn't
    // keep its jobs, or the first commit failed (and was rolled back). A
    // call that writes two stores commits each on its own; once one has
    // committed, a later failed commit can't undo it, so the call stands, and
    // its jobs run. A call that joined no store runs its jobs as it ends.
    end: fn(call: Int, commit: Bool) -> Bool Never! {
        ended := calls_take(call) ?? return true
        if ended.refused || ended.repeated || !commit {
            loop joined in ended.joins -> _: joined.end(false)
            return !ended.refused
        }
        keys := [String]{}
        if ended.joins.len() > 0 {
            loop job in ended.jobs {
                key: ended.joins[0].outbox.keep(job.name, job.args, ended.joins[0].outbox.now() + JOB_HOLD_MS)
                if key == "" {
                    loop joined in ended.joins -> _: joined.end(false)
                    return false
                }
                keys.push(key)
            }
        }
        loop (index, joined) in ended.joins {
            if joined.end(true) || index > 0 -> next
            loop rest in 1..<ended.joins.len() -> _: ended.joins[rest].end(false)
            return false
        }
        if ended.joins.len() == 0 {
            loop job in ended.jobs.move() -> job_start(job, "", None, 0)
            return true
        }
        // The jobs' runs share the first store's outbox.
        first := ended.joins.remove(0, .Slot) ?? return true
        outbox: jobs_store(first.outbox.move(), false)
        at := 0
        loop job in ended.jobs.move() {
            job_start(job, keys[at].copy(), Val(outbox.copy()), 0)
            at += 1
        }
        true
    }
}

// Removes call `call` from the open calls and gives it.
priv calls_take: fn(call: Int) -> CallRun? Never! {
    runs := CALLS.guard_edit()
    loop index in 0..<runs.value.runs.len() {
        if runs.value.runs[index].id == call -> return runs.value.runs.remove(index, .Slot)
    }
    None
}

// The arguments of a mounted method's call or of a job, decoded from their
// JSON array, and the reply each gives.
priv RemoteArgs: struct {
    tree: Dyn

    // The argument at `index`, decoded as the method's parameter type.
    __take: fn<T: Decode>(self, index: Int) -> T [FieldError]! {
        live_json.at<T>(self.tree, "/{index}")
    }

    // The reply of a call that failed: `{"err": error}`.
    __reply_err: fn<E: Encode>(self, error: E) -> String Never! {
        "{{\"err\":{live_json.to_string<E>(error) ?? "null"}}}"
    }

    // The reply of a call that gave `value`: `{"ok": value}`.
    __reply_value: fn<R: Encode>(self, value: R) -> String Never! {
        "{{\"ok\":{live_json.to_string<R>(value) ?? "null"}}}"
    }

    // The reply of a job that failed with an error that doesn't encode.
    __failed: fn<E>(self, _error: E) -> String Never! { "{{\"err\":null}}" }

    // The reply of a job that ran, whatever it gave.
    __ran: fn<R>(self, _value: R) -> String Never! { "" }
}

// A job's call, as the compiler lowers `enqueue(fn() { self.method(args)
// })`: `name` names the job, `args` are its arguments, each encoded
// (`__live_arg`), `retries` are its `#App.Job`'s, and `run` decodes the
// arguments and calls the method on a copy of the service. Queued in a call,
// the job runs once the call commits (`transactions`); queued outside one,
// it runs at once, on a task of its own.
__enqueue: fn(name: String, args: [String], retries: Int, run: &&fn(RemoteArgs) -> String [FieldError]!) Never! {
    job: CallJob{name: name, args: "[{args.join(",")}]", retries: retries, run: Shared{CallJobCall{call: run.move()}}}
    call: transactions.current() ?? return job_start(job, "", None, 0)
    transactions.enqueue(call, job)
}

// The wait before a failed job's next run, in milliseconds: half a second
// after its first failure, doubling after each one after, to an hour at
// most.
JOB_BACKOFF_FIRST_MS: 500

JOB_BACKOFF_MOST_MS: 3600000

priv job_backoff_ms: fn(failures: Int) -> Int Never! {
    wait := JOB_BACKOFF_FIRST_MS
    loop _ in 1..<failures {
        wait *= 2
        if wait >= JOB_BACKOFF_MOST_MS -> return JOB_BACKOFF_MOST_MS
    }
    wait
}

// How long a store's row stays taken for the server that runs its job, in
// milliseconds. That server takes it again each tick while the job runs or
// waits to run again, so the time passes only once the server has stopped
// or can't reach the store; then a serving server takes the row and runs the
// job again.
priv JOB_HOLD_MS: 5000

// How often the task of each store a server takes jobs from takes the rows
// of its running jobs again and the rows no server holds, in milliseconds.
priv JOB_TICK_MS: 1000

// The time a row of a job that failed every run it gets is taken until:
// never again.
priv JOB_NEVER: 9223372036854775807

// A job a mounted service declares (`App.__job`), which a serving server
// takes from a store's outbox by its name and runs.
priv CallJobRunner: struct {
    name: String
    retries: Int
    run: Shared<CallJobCall>
}

// A store whose outbox the process runs jobs from: the keys of the jobs it
// runs from there, the keys of the ones a stop left (`jobs.stop`), which
// still run but no longer hold their rows, and whether core.db named the
// store as it opened (`jobs.store`). A store it didn't name is forgotten
// once no job of it runs.
priv JobStore: struct {
    store: String
    outbox: Shared<CallOutbox>
    running: [String]
    left: [String]
    named: Bool
}

// The process's jobs: the jobs mounted services declare, the stores it runs
// jobs from, how many times a server began serving an App that declares
// jobs, which take the rows no server holds while any serves, and whether
// the task that tends the stores (`jobs_tend`) runs.
priv JobRuntime: struct {
    runners: [CallJobRunner]
    stores: [JobStore]
    serving: Int
    tended: Bool
}

priv JOBS: Shared{JobRuntime{runners: [CallJobRunner]{}, stores: [JobStore]{}, serving: 0, tended: false}}

// The jobs of a served App: core.web declares each `#App.Job` method of a
// mounted service (`know`) and tells when the App serves (`serve`); core.db
// names each database file whose outbox keeps jobs as it opens (`store`).
priv(package) jobs: module {
    // Declares job `name`, run with `run` and retried `retries` times, so a
    // serving server takes its rows by its name. The first declaration of a
    // name stands.
    know: fn(name: String, retries: Int, run: &&fn(RemoteArgs) -> String [FieldError]!) Never! {
        runtime := JOBS.guard_edit()
        loop known in runtime.value.runners {
            if known.name == name {
                return
            }
        }
        runtime.value.runners.push(CallJobRunner{name: name.copy(), retries: retries, run: Shared{CallJobCall{call: run.move()}}})
    }

    // Names a store whose outbox keeps jobs, so a serving server takes the
    // rows no server holds from it.
    store: fn(outbox: &&CallOutbox) Never! { _: jobs_store(outbox, true) }

    // A server began serving an App that declares jobs: from now on, each
    // tick takes the rows no server holds from each store.
    serve: fn() Never! {
        runtime := JOBS.guard_edit()
        runtime.value.serving += 1
        jobs_tend_start(runtime.value)
    }

    // A server that began serving an App that declares jobs stopped, with
    // `wait_ms` milliseconds left. Once no server serves such an App, no
    // tick takes rows, and the stop waits up to `wait_ms` for the jobs that
    // run, and leaves the ones that still do (`jobs_leave`): none of them
    // deletes its row or records a failure, and their rows are no longer
    // held, so a serving server runs them again once their time passes.
    stop: fn(wait_ms: Int) Never! {
        if !jobs_unserve() {
            return
        }
        end: rt.clock_mono_ns() + wait_ms * 1000000
        loop jobs_busy() && rt.clock_mono_ns() < end -> tasks.sleep(10)
        jobs_leave()
    }
}

// One server less serves an App that declares jobs: whether none does now.
priv jobs_unserve: fn() -> Bool Never! {
    runtime := JOBS.guard_edit()
    if runtime.value.serving > 0 -> runtime.value.serving -= 1
    runtime.value.serving == 0
}

// Whether a job the process runs from a store still runs.
priv jobs_busy: fn() -> Bool Never! {
    runtime: JOBS.guard_read()
    loop store in runtime.value.stores {
        if store.running.len() > 0 -> return true
    }
    false
}

// Leaves each job the process runs from a store: it no longer holds its
// row, and its run neither deletes the row nor records a failure there.
priv jobs_leave: fn() Never! {
    runtime := JOBS.guard_edit()
    loop index in 0..<runtime.value.stores.len() {
        loop key in runtime.value.stores[index].running {
            runtime.value.stores[index].left.push(key.copy())
        }
        runtime.value.stores[index].running = [String]{}
    }
}

// Whether a stop left the job of key `key` the process runs from `outbox`.
priv jobs_left: fn(outbox: Shared<CallOutbox>?, key: String) -> Bool Never! {
    kept: outbox ?? return false
    store: jobs_store_name(kept)
    runtime: JOBS.guard_read()
    loop known in runtime.value.stores {
        if known.store == store -> return known.left.contains(key)
    }
    false
}

// The outbox the process runs jobs from for the store `outbox` names: the
// one it has, or `outbox`, which it then has; `named` when core.db names
// the store.
priv jobs_store: fn(outbox: &&CallOutbox, named: Bool) -> Shared<CallOutbox> Never! {
    runtime := JOBS.guard_edit()
    loop index in 0..<runtime.value.stores.len() {
        if runtime.value.stores[index].store != outbox.store -> next
        if named -> runtime.value.stores[index].named = true
        return runtime.value.stores[index].outbox.copy()
    }
    name: outbox.store.copy()
    kept: Shared{outbox.move()}
    runtime.value.stores.push(JobStore{store: name, outbox: kept.copy(), running: [String]{}, left: [String]{}, named: named})
    kept
}

// Starts the task that tends the stores (`jobs_tend`) unless it runs.
priv jobs_tend_start: fn(runtime: &JobRuntime) Never! {
    if runtime.tended {
        return
    }
    runtime.tended = true
    tending: task { jobs_tend() }
    tending.detach()
}

// What one tick does on store `store`: take the rows of `running` again,
// and, while a server serves an App that declares jobs, take the rows of
// jobs named in `names` that no server holds.
priv JobTick: struct {
    store: String
    outbox: Shared<CallOutbox>
    running: [String]
    names: [String]
}

// What the next tick does on each store; None when it has nothing to do, as
// no job runs and no server serves an App that declares jobs, and then the
// task that tends the stores ends (`tended` is false again).
priv jobs_ticks: fn() -> [JobTick]? Never! {
    runtime := JOBS.guard_edit()
    names := [String]{}
    if runtime.value.serving > 0 {
        loop known in runtime.value.runners -> names.push(known.name.copy())
    }
    ticks := [JobTick]{}
    loop store in runtime.value.stores {
        if store.running.len() == 0 && names.len() == 0 -> next
        ticks.push(JobTick{store: store.store.copy(), outbox: store.outbox.copy(), running: store.running.copy(), names: names.copy()})
    }
    if ticks.len() == 0 && names.len() == 0 {
        runtime.value.tended = false
        return None
    }
    Val(ticks)
}

// The task that tends the stores: each tick, it takes the rows of the jobs
// the process runs again, so no other server takes them, and while a server
// serves an App that declares jobs, it takes the rows no server holds and
// runs their jobs. A store that has closed is forgotten.
priv jobs_tend: fn() Never! {
    loop {
        ticks: jobs_ticks() ?? return
        loop tick in ticks -> jobs_tick(tick)
        tasks.sleep(JOB_TICK_MS)
    }
}

// Runs one tick on its store.
priv jobs_tick: fn(tick: JobTick) Never! {
    taken: jobs_tick_rows(tick) ?? return jobs_forget(tick.store)
    loop queued in taken {
        job: jobs_declared(queued) ?? next
        job_start(job, queued.key.copy(), Val(tick.outbox.copy()), queued.runs)
    }
}

// Takes the rows of `tick` on its store, and gives the rows it took that no
// server held; None once the store has closed.
priv jobs_tick_rows: fn(tick: JobTick) -> [CallQueued]? Never! {
    kept: tick.outbox.guard_read()
    now: kept.value.now()
    if tick.running.len() > 0 -> _: kept.value.hold(tick.running, now + JOB_HOLD_MS)
    if tick.names.len() == 0 -> return Val([CallQueued]{})
    kept.value.take(tick.names, now, now + JOB_HOLD_MS)
}

// The job of the row `queued`, run by its declared runner; None when no
// mounted service declares it.
priv jobs_declared: fn(queued: CallQueued) -> CallJob? Never! {
    runtime: JOBS.guard_read()
    loop known in runtime.value.runners {
        if known.name == queued.name {
            return Val(CallJob{name: queued.name.copy(), args: queued.args.copy(), retries: known.retries, run: known.run.copy()})
        }
    }
    None
}

// Forgets store `store`, which has closed.
priv jobs_forget: fn(store: String) Never! {
    runtime := JOBS.guard_edit()
    loop index in 0..<runtime.value.stores.len() {
        if runtime.value.stores[index].store == store {
            _: runtime.value.stores.remove(index, .Slot)
            return
        }
    }
}

// Marks the job of key `key` as running from store `store` (`running`), or
// as no longer running, whether a stop left it or not; a store core.db
// didn't name is forgotten once no job of it runs.
priv jobs_running: fn(store: String, key: String, running: Bool) Never! {
    runtime := JOBS.guard_edit()
    loop index in 0..<runtime.value.stores.len() {
        if runtime.value.stores[index].store != store -> next
        if running {
            runtime.value.stores[index].running.push(key.copy())
            return jobs_tend_start(runtime.value)
        }
        loop at in 0..<runtime.value.stores[index].running.len() {
            if runtime.value.stores[index].running[at] == key {
                _: runtime.value.stores[index].running.remove(at, .Slot)
                break
            }
        }
        loop at in 0..<runtime.value.stores[index].left.len() {
            if runtime.value.stores[index].left[at] == key {
                _: runtime.value.stores[index].left.remove(at, .Slot)
                break
            }
        }
        done: runtime.value.stores[index].running.len() == 0 && runtime.value.stores[index].left.len() == 0
        if done && !runtime.value.stores[index].named {
            _: runtime.value.stores.remove(index, .Slot)
        }
        return
    }
}

// The name of the store `outbox` keeps jobs in.
priv jobs_store_name: fn(outbox: Shared<CallOutbox>) -> String Never! {
    kept: outbox.guard_read()
    kept.value.store.copy()
}

// Runs `job` on a task of its own; `outbox` keeps it under key `key` (None:
// it is kept nowhere), after `runs` runs that failed.
priv job_start: fn(job: &&CallJob, key: &&String, outbox: &&Shared<CallOutbox>?, runs: Int) Never! {
    if outbox == .Val(store) -> jobs_running(jobs_store_name(store), key, true)
    runner: task { job_run(job, key, outbox, runs) }
    runner.detach()
}

// Runs `job`, after `runs` runs that failed, until a run succeeds, each run
// as the system and in a call of its own, which also deletes the job's row
// from `outbox`. A run that fails runs again after a backoff, up to
// `job.retries` more runs in all; each failure is recorded on the row, so a
// server that takes it later goes on from there. After the last, the row
// keeps the last failure, and no server takes it again. A job a stop left
// (`jobs.stop`) runs no more, and records nothing on its row.
priv job_run: fn(job: CallJob, key: String, outbox: Shared<CallOutbox>?, runs: Int) Never! {
    failures := runs
    loop !jobs_left(outbox, key) {
        failures += 1
        failure: job_attempt(job, key, outbox)
        if failure == "" || jobs_left(outbox, key) -> break
        last: failures > job.retries
        if outbox == .Val(store) {
            kept: store.guard_read()
            until: if last -> JOB_NEVER else -> kept.value.now() + job_backoff_ms(failures) + JOB_HOLD_MS
            _: kept.value.failed(key, failures, failure, until)
        }
        if last -> break
        tasks.sleep(job_backoff_ms(failures))
    }
    if outbox == .Val(store) -> jobs_running(jobs_store_name(store), key, false)
}

// One run of `job` in a call of its own, under its key `key` as the call's
// delivery: "" when it ran, or when another run had done it already (its
// row is gone, or a store it uses has run it); otherwise why it failed. A
// run a store has run already rolls back, and its row is deleted then. A
// run that a stop left before it ended rolls back, and its row stays.
priv job_attempt: fn(job: CallJob, key: String, outbox: Shared<CallOutbox>?) -> String Never! {
    call: transactions.begin() ?? panic("a job's task runs no other call")
    if outbox == .Val(store) {
        kept: store.guard_read()
        transactions.deliver(call, CallDelivery{id: "job:{key}", at: kept.value.now() /% 1000})
    }
    reply: as_system<String>(fn() {
        held: job.run.guard_read()
        job_reply(held.value.call, job.args)
    })
    failed: reply.starts_with("{{\"err\":")
    left: jobs_left(outbox, key)
    removed := 1
    if !failed && !left {
        if outbox == .Val(store) {
            kept: store.guard_read()
            removed = kept.value.done(key)
        }
    }
    repeated: transactions.repeated(call)
    committed: transactions.end(call, !failed && !left && removed == 1)
    if repeated {
        if outbox == .Val(store) -> return job_done(store, key)
        return ""
    }
    if failed -> return reply
    if removed < 0 -> return "the store couldn't delete the job's row"
    if !committed -> return "the job's call couldn't commit"
    ""
}

// Deletes the row of key `key` from `outbox`, in a call of its own, as a
// store the job uses has run it already: "" once it is gone, otherwise why
// not.
priv job_done: fn(outbox: Shared<CallOutbox>, key: String) -> String Never! {
    call: transactions.begin() ?? panic("a job's task runs no other call")
    kept: outbox.guard_read()
    removed: kept.value.done(key)
    if !transactions.end(call, removed >= 0) || removed < 0 {
        return "the store couldn't delete the job's row"
    }
    ""
}

// What `run` replies to the encoded arguments `args`.
priv job_reply: fn(run: fn(RemoteArgs) -> String [FieldError]!, args: String) -> String Never! {
    tree: live_json.parse(args) ?? return "{{\"err\":\"the job's arguments are not JSON\"}}"
    run(RemoteArgs{tree: tree}) ?? "{{\"err\":\"the job's arguments don't decode\"}}"
}

// The schedules of a served App: core.web starts each `#App.Every` method
// of a mounted service as the App starts serving (`start`).
priv(package) schedules: module {
    // Whether `cron` is a cron line a schedule runs on.
    valid: fn(cron: String) -> Bool Never! { cron_parse(cron) != None }

    // Starts schedule `name` on a task of its own: it runs `run` at the
    // latest minute the cron line `cron` allows, unless a store records that
    // run, and then at each next one (`schedule_run`).
    start: fn(name: String, cron: String, run: &&fn(RemoteArgs) -> String [FieldError]!) Never! {
        line: cron_parse(cron) ?? panic("`{cron}` is not a cron line")
        runner: task { schedule_run(name, line, run) }
        runner.detach()
    }
}

// Runs schedule `name` on its cron line `line`: first the latest minute the
// line allows, a run missed while no server ran, then each next minute it
// allows, each as a call of its own (`schedule_tick`). A run that ends
// after its next minute has passed is followed by the latest minute that
// passed, once.
priv schedule_run: fn(name: String, line: CronLine, run: fn(RemoteArgs) -> String [FieldError]!) Never! {
    due := schedule_minute()
    if cron_due_by(line, due) == .Val(missed) {
        schedule_tick(name, missed, run)
        due = missed
    }
    loop {
        next := cron_due_after(line, due) ?? return
        now: schedule_minute()
        if next < now -> next = cron_due_by(line, now) ?? next
        loop {
            wait_ms: next * 60000 - time.unix_ns() /% 1000000
            if wait_ms <= 0 -> break
            tasks.sleep(wait_ms)
        }
        schedule_tick(name, next, run)
        due = next
    }
}

// The minute it is, since the Unix epoch.
priv schedule_minute: fn() -> Int Never! { time.unix_ns() /% 60000000000 }

// One run of schedule `name`, due at minute `due`, in a call of its own as
// the system. Each store the run uses records it in the call's transaction
// (core.db's `__jet_schedules`): a store that has recorded it, or a later
// run, already marks the call repeated, and the run is dropped. A store
// busy with another server's run refuses the call, which runs again, up to
// `transactions.attempts()` times, and then finds the run recorded. A run
// that fails rolls back and records nothing. A run that uses no store
// records nothing, so each server runs it.
priv schedule_tick: fn(name: String, due: Int, run: fn(RemoteArgs) -> String [FieldError]!) Never! {
    loop _ in 0..<transactions.attempts() {
        call: transactions.begin() ?? panic("a schedule's task runs no other call")
        transactions.schedule(call, CallTick{schedule: name.copy(), due: due * 60})
        reply: as_system<String>(fn() { job_reply(run, "[]") })
        if transactions.end(call, !reply.starts_with("{{\"err\":")) {
            return
        }
    }
}

// A cron line's five fields, each as the values it allows, by value: the
// minutes (0-59), hours (0-23), days of the month (1-31), months (1-12) and
// days of the week (0-6, Sunday 0). `any_day` and `any_weekday` hold when
// the day field and the weekday field start with `*`.
priv CronLine: struct {
    minutes: [Bool]
    hours: [Bool]
    days: [Bool]
    months: [Bool]
    weekdays: [Bool]
    any_day: Bool
    any_weekday: Bool
}

// The days, back or ahead, a due minute is looked for in: eight years,
// enough to reach a February 29.
CRON_SEARCH_DAYS: 2928

// `text` as a cron line; None when it isn't one.
priv cron_parse: fn(text: String) -> CronLine? {
    fields := [String]{}
    loop part in text.split(" ") {
        if part != "" -> fields.push(part)
    }
    if fields.len() != 5 -> return None
    weekdays := cron_field(fields[4], 0, 7) ?? return None
    if weekdays[7] -> weekdays[0] = true
    _: weekdays.pop()
    Val(CronLine{
        minutes: cron_field(fields[0], 0, 59) ?? return None,
        hours: cron_field(fields[1], 0, 23) ?? return None,
        days: cron_field(fields[2], 1, 31) ?? return None,
        months: cron_field(fields[3], 1, 12) ?? return None,
        weekdays: weekdays,
        any_day: fields[2].starts_with("*"),
        any_weekday: fields[4].starts_with("*"),
    })
}

// The values from `low` to `high` that the cron field `text` allows, by
// value (each below `low` false); None when it isn't a field of that range.
priv cron_field: fn(text: String, low: Int, high: Int) -> [Bool]? {
    allowed := [Bool]{}
    loop _ in 0..<(high + 1) -> allowed.push(false)
    loop item in text.split(",") {
        stepped: item.split("/").to_list()
        if stepped.len() > 2 -> return None
        step: if {
            stepped.len() == 2 -> cron_number(stepped[1]) ?? return None
            else -> 1
        }
        if step < 1 -> return None
        first := low
        last := high
        if stepped[0] != "*" {
            bounds: stepped[0].split("-").to_list()
            if bounds.len() > 2 -> return None
            first = cron_number(bounds[0]) ?? return None
            // `5/15` steps from 5 to the field's end.
            last = if {
                bounds.len() == 2 -> cron_number(bounds[1]) ?? return None
                stepped.len() == 2 -> high
                else -> first
            }
        }
        if first < low || last > high || first > last -> return None
        at := first
        loop {
            if at > last -> break
            allowed[at] = true
            at += step
        }
    }
    Val(allowed)
}

// The number `text` writes, of one or two digits; None otherwise.
priv cron_number: fn(text: String) -> Int? {
    if text.len() == 0 || text.len() > 2 -> return None
    loop byte in text.bytes() {
        n: Int{byte}
        if n < 48 || n > 57 -> return None
    }
    Val(Int.parse(text) ?? return None)
}

// Whether `line` allows day `day` (since the Unix epoch): its month, and its
// day of the month and day of the week, both, or either when neither field
// starts with `*`.
priv cron_day_allowed: fn(line: CronLine, day: Int) -> Bool {
    date: cron_date(day)
    if !line.months[date.month] -> return false
    by_date: line.days[date.day]
    by_weekday: line.weekdays[(day + 4) % 7]
    if line.any_day || line.any_weekday -> return by_date && by_weekday
    by_date || by_weekday
}

// A day's month (1-12) and day of the month (1-31).
priv CronDate: struct {
    month: Int
    day: Int
}

// The date of day `day` since the Unix epoch, in the proleptic Gregorian
// calendar (Howard Hinnant's `civil_from_days`).
priv cron_date: fn(day: Int) -> CronDate {
    shifted: day + 719468
    era: shifted /% 146097
    of_era: shifted - era * 146097
    year_of_era: (of_era - of_era /% 1460 + of_era /% 36524 - of_era /% 146096) /% 365
    of_year: of_era - (365 * year_of_era + year_of_era /% 4 - year_of_era /% 100)
    month_from_march: (5 * of_year + 2) /% 153
    CronDate{
        month: if month_from_march < 10 -> month_from_march + 3 else -> month_from_march - 9,
        day: of_year - (153 * month_from_march + 2) /% 5 + 1,
    }
}

// The latest minute, since the Unix epoch, at or before `minute` that
// `line` allows; None when none does in the search window.
priv cron_due_by: fn(line: CronLine, minute: Int) -> Int? {
    first_day: minute /% 1440
    loop back in 0..<CRON_SEARCH_DAYS {
        day: first_day - back
        if !cron_day_allowed(line, day) -> next
        top_hour: if back == 0 -> (minute % 1440) /% 60 else -> 23
        loop hour_back in 0..<(top_hour + 1) {
            hour: top_hour - hour_back
            if !line.hours[hour] -> next
            top_minute: if back == 0 && hour == top_hour -> minute % 60 else -> 59
            loop minute_back in 0..<(top_minute + 1) {
                at: top_minute - minute_back
                if line.minutes[at] -> return Val(day * 1440 + hour * 60 + at)
            }
        }
    }
    None
}

// The earliest minute, since the Unix epoch, after `minute` that `line`
// allows; None when none does in the search window.
priv cron_due_after: fn(line: CronLine, minute: Int) -> Int? {
    start: minute + 1
    first_day: start /% 1440
    loop ahead in 0..<CRON_SEARCH_DAYS {
        day: first_day + ahead
        if !cron_day_allowed(line, day) -> next
        low_hour: if ahead == 0 -> (start % 1440) /% 60 else -> 0
        loop hour in low_hour..<24 {
            if !line.hours[hour] -> next
            low_minute: if ahead == 0 && hour == low_hour -> start % 60 else -> 0
            loop at in low_minute..<60 {
                if line.minutes[at] -> return Val(day * 1440 + hour * 60 + at)
            }
        }
    }
    None
}

#Test("a cron line allows the minutes its fields allow, in UTC, and a malformed one is refused") {
    daily: cron_parse("0 8 * * *") ?? panic("a daily line")
    // 2026-11-16 07:00 UTC, a Monday.
    monday_seven: 29913540
    assert_eq(cron_due_by(daily, monday_seven), Val(29912160))
    assert_eq(cron_due_after(daily, monday_seven), Val(29913600))
    assert_eq(cron_due_by(daily, 29913600), Val(29913600))
    assert_eq(cron_due_after(daily, 29913600), Val(29915040))
    quarters: cron_parse("*/15 * * * *") ?? panic("a quarter-hour line")
    assert_eq(cron_due_by(quarters, 29913571), Val(29913570))
    assert_eq(cron_due_after(quarters, 29913571), Val(29913585))
    // Either the 13th or a Friday, since neither day field is `*`.
    friday_or_13th: cron_parse("0 0 13 * 5") ?? panic("a day line")
    assert_eq(cron_due_by(friday_or_13th, 29908800), Val(29908800))
    assert_eq(cron_due_after(friday_or_13th, 29908800), Val(29918880))
    assert_eq(cron_due_after(cron_parse("0 0 29 2 *") ?? panic("a leap-day line"), monday_seven), Val(30589920))
    monthly: cron_parse("0 0 1 * *") ?? panic("a monthly line")
    assert_eq(cron_due_by(monthly, 29934719), Val(29891520))
    assert_eq(cron_due_after(monthly, 29934719), Val(29934720))
    assert_eq(cron_due_by(cron_parse("0 8 * * 7") ?? panic("a Sunday line"), monday_seven), Val(29912160))
    assert_eq(cron_due_after(cron_parse("0 0 31 2 *") ?? panic("a line no day matches"), monday_seven), Int?{None})
    assert(schedules.valid("5/15 1-3,9 * 1-12/2 1-5"))
    malformed_lines: [String]{"0 8 * *", "0 8 * * * *", "60 * * * *", "*/0 * * * *", "a * * * *", "5-1 * * * *", "1,,2 * * * *", "* * 0 * *", "* * * 13 *", "* * * * 8", "1-2-3 * * * *", "*/100 * * * *"}
    loop malformed in malformed_lines { assert(!schedules.valid(malformed), malformed) }
}

// An outbox that keeps nothing, for the calls of the test below, which queue
// no job.
priv outbox_unused: fn() -> CallOutbox Never! {
    CallOutbox{
        store: "unused",
        now: fn() { 0 },
        keep: fn(_: String, _: String, _: Int) { "" },
        done: fn(_: String) { 0 },
        failed: fn(_: String, _: Int, _: String, _: Int) { false },
        take: fn(_: [String], _: Int, _: Int) { None },
        hold: fn(_: [String], _: Int) { false },
    }
}

#Test("a call commits or rolls back every transaction joined to it, runs again when one refused it, and rolls back a delivery run already") {
    seen: Shared{[String]{}}
    note: fn(name: String, commits: Bool) -> fn(Bool) -[]> Bool Never! {
        fn(commit: Bool) {
            log := seen.guard_edit()
            log.value.push(if commit -> "commit {name}" else -> "roll back {name}")
            commits || !commit
        }
    }
    assert_eq(transactions.current(), Int?{None})
    call: transactions.begin() ?? panic("no call is open")
    assert_eq(transactions.begin(), Int?{None})
    assert_eq(transactions.current(), Val(call))
    transactions.join(call, note("a", true), outbox_unused())
    transactions.join(call, note("b", true), outbox_unused())
    assert(transactions.end(call, true))
    assert_eq(transactions.current(), Int?{None})
    failed: transactions.begin() ?? panic("no call is open")
    transactions.join(failed, note("c", true), outbox_unused())
    assert(transactions.end(failed, false))
    refused: transactions.begin() ?? panic("no call is open")
    transactions.join(refused, note("d", true), outbox_unused())
    transactions.refuse(refused)
    assert(transactions.refused(refused))
    assert(!transactions.end(refused, true))
    lost: transactions.begin() ?? panic("no call is open")
    transactions.join(lost, note("e", false), outbox_unused())
    transactions.join(lost, note("f", true), outbox_unused())
    assert(!transactions.end(lost, true))
    delivered: transactions.begin() ?? panic("no call is open")
    assert_eq(transactions.delivery(delivered), CallDelivery?{None})
    transactions.deliver(delivered, CallDelivery{id: "d-1", at: 1})
    assert_eq(transactions.delivery(delivered), Val(CallDelivery{id: "d-1", at: 1}))
    transactions.join(delivered, note("g", true), outbox_unused())
    assert(!transactions.repeated(delivered))
    transactions.repeat(delivered)
    assert(transactions.repeated(delivered))
    assert(transactions.end(delivered, true))
    log: seen.guard_read()
    assert_eq(log.value.join(", "), "commit a, commit b, roll back c, roll back d, commit e, roll back f, roll back g")
}

// The entries `seen` holds so far.
priv jobs_seen: fn(seen: Shared<[String]>) -> [String] Never! {
    log: seen.guard_read()
    log.value.copy()
}

#Test("a committed call keeps each job it queued in its first store's outbox and runs it after the commit, again after a failure, recording each; a rolled-back call runs none") {
    seen: Shared{[String]{}}
    outbox: fn() -> CallOutbox {
        CallOutbox{
            store: "app.Test outbox",
            now: fn() { 0 },
            keep: fn(name: String, args: String, _: Int) {
                log := seen.guard_edit()
                log.value.push("keep {name} {args}")
                "key {name}"
            },
            done: fn(key: String) {
                log := seen.guard_edit()
                log.value.push("done {key}")
                1
            },
            failed: fn(key: String, runs: Int, error: String, _: Int) {
                log := seen.guard_edit()
                log.value.push("failed {key} after {runs}: {error}")
                true
            },
            take: fn(_: [String], _: Int, _: Int) { Val([CallQueued]{}) },
            hold: fn(_: [String], _: Int) { true },
        }
    }
    tries: Shared{0}
    flaky: fn(args: RemoteArgs) -> String [FieldError]! {
        count := tries.guard_edit()
        count.value += 1
        taken: args.__take<Int>(0)
        if count.value == 1 -> return Ok(args.__reply_err<String>("once"))
        Ok(args.__reply_value<Int>(taken))
    }
    failing: fn(args: RemoteArgs) -> String [FieldError]! { Ok(args.__reply_err<String>("always")) }
    dropped: Shared{0}
    never: fn(args: RemoteArgs) -> String [FieldError]! {
        count := dropped.guard_edit()
        count.value += 1
        Ok(args.__reply_value<Int>(0))
    }
    rolled: transactions.begin() ?? panic("no call is open")
    transactions.join(rolled, fn(_: Bool) { true }, outbox())
    __enqueue("app.Test.never", [String]{}, 0, never)
    assert(transactions.end(rolled, false))
    committed: transactions.begin() ?? panic("no call is open")
    transactions.join(committed, fn(_: Bool) { true }, outbox())
    __enqueue("app.Test.flaky", [String]{__live_arg<Int>(2)}, 1, flaky)
    __enqueue("app.Test.failing", [String]{}, 1, failing)
    assert(transactions.end(committed, true))
    loop _ in 0..<1000 {
        if jobs_seen(seen).len() >= 6 -> break
        tasks.sleep(10)
    }
    log := jobs_seen(seen)
    log.sort()
    assert_eq(log.join(", "), "done key app.Test.flaky, failed key app.Test.failing after 1: {{\"err\":\"always\"}}, failed key app.Test.failing after 2: {{\"err\":\"always\"}}, failed key app.Test.flaky after 1: {{\"err\":\"once\"}}, keep app.Test.failing [], keep app.Test.flaky [2]")
    assert_eq(job_backoff_ms(1), 500)
    assert_eq(job_backoff_ms(3), 2000)
    assert_eq(job_backoff_ms(40), JOB_BACKOFF_MOST_MS)
    taken: tries.guard_read()
    assert_eq(taken.value, 2)
    never_ran: dropped.guard_read()
    assert_eq(never_ran.value, 0)
}

LIVE_MAX_QUERIES: 1024

LIVE_MAX_PAYLOAD: 4194304

// A binding whose runs this many times in a row were overtaken serves its
// stale result for a hold before it runs again.
LIVE_HOLD_AFTER: 2

// The shortest hold, in nanoseconds; a run that took longer holds as long as
// it took, so a binding over a busy table spends at most half its time
// running.
LIVE_HOLD_MIN_NS: 100000000

// The re-runs a server makes in one second, over all its bindings; a binding
// due past them serves its stored result until the next second.
LIVE_MAX_RERUNS_PER_SECOND: 1000

LIVE_RERUN_WINDOW_NS: 1000000000

// The registry source of sync's session records: a session keeps its
// generation and document as the record's value.
LIVE_SYNC_SOURCE: "app.sync"

// The encoded registry, in one process-wide cell. A replacement installs only
// while the cell still holds the bytes its caller read, so a concurrent change
// makes the caller retry instead of being lost. Inside a deterministic world
// the registry is the World's own cell instead, starting empty, so a world and
// its tasks never read or change the process registry.
LiveCell: struct {
    bytes: [U8]
}

LIVE_CELL: Shared{LiveCell{bytes: [U8]{}}}

live_cell_load: fn() -> [U8] {
    if world_rt.world_store_load("app.live") == .Val(bytes) -> return bytes
    LIVE_CELL.bytes
}

live_cell_replace: fn(expected: [U8], replacement: &&[U8]) -> Bool {
    if world_rt.world_store_replace("app.live", expected, replacement) == .Val(replaced) {
        return replaced
    }
    cell := LIVE_CELL.guard_edit()
    if cell.value.bytes != expected -> return false
    cell.value.bytes = replacement.move()
    true
}

live_key: fn(args: [String]) -> String { "[{args.join(",")}]" }

// The id of the binding named by `source`, `key` and `caller` (acting_tag),
// registered when absent; a full registry evicts its oldest binding. Two
// registrations of one binding poll at the shorter interval. 0 when the
// registry is unavailable.
live_register: fn(source: String, key: String, caller: String, every_ns: Int) -> Int {
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return 0
        found := 0
        loop index in 0..<registry.records.len() {
            if registry.records[index].source != source || registry.records[index].key != key || registry.records[index].caller != caller {
                next
            }
            found = registry.records[index].id
            current: registry.records[index].every_ns
            if every_ns <= 0 || (current > 0 && current <= every_ns) -> return found
            registry.records[index].every_ns = every_ns
        }
        if found == 0 {
            found = registry.next_id + 1
            registry.next_id = found
            if live_query_count(registry) >= LIVE_MAX_QUERIES {
                kept := [LiveRecord]{}
                evicted := false
                loop record in registry.records {
                    if !evicted && record.source != LIVE_SYNC_SOURCE {
                        evicted = true
                        next
                    }
                    kept.push(record)
                }
                registry.records = kept
                registry.evictions += 1
            }
            // copy: a lost race retries with the same source, key and caller
            registry.records.push(LiveRecord{id: found, source: source.copy(), key: key.copy(), value: "", dirty: false, generation: 0, overtaken: 0, held_ns: 0, every_ns: every_ns, ran_ns: 0, reads: [String]{}, caller: caller.copy()})
        }
        if live_cell_replace(seen, live_encode(registry)) -> return found
    }
}

// The stored result of binding `id` when it is current at `now`, or stale
// but held, and its generation; None when the binding must re-run. A re-run
// takes one of this second's LIVE_MAX_RERUNS_PER_SECOND; once they are spent,
// the stored result is held until the next second, its start published as a
// hold's is (live_store), so watchers read again when it ends and every write
// before then costs the one re-run that follows it. A first run is not capped:
// it has no result to hold.
live_current: fn(id: Int, now: Int) -> LiveCurrent {
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return LiveCurrent{value: None, generation: 0}
        index: live_index(registry, id) ?? return LiveCurrent{value: None, generation: 0}
        generation: registry.records[index].generation
        if registry.records[index].value == "" {
            return LiveCurrent{value: None, generation: generation}
        }
        dirty: registry.records[index].dirty
        held: now < registry.records[index].held_ns
        every_ns: registry.records[index].every_ns
        polled: every_ns > 0 && now - registry.records[index].ran_ns >= every_ns
        if held || (!dirty && !polled) {
            return LiveCurrent{value: Val(registry.records[index].value.copy()), generation: generation}  // copy: the registry snapshot is dropped here
        }
        if now - registry.window_ns >= LIVE_RERUN_WINDOW_NS {
            registry.window_ns = now
            registry.window_runs = 0
        }
        event := ""
        if registry.window_runs < LIVE_MAX_RERUNS_PER_SECOND -> registry.window_runs += 1 else {
            ends: registry.window_ns + LIVE_RERUN_WINDOW_NS
            registry.records[index].held_ns = ends
            registry.capped += 1
            registry.ws_pushes += 1
            event = live_event(id, Val(live_hold_ms(ends - now)))
        }
        if live_cell_replace(seen, live_encode(registry)) {
            if event == "" -> return LiveCurrent{value: None, generation: generation}
            rt_web.live_publish("live:{id}", event)
            return LiveCurrent{value: Val(registry.records[index].value.copy()), generation: generation}  // copy: the registry snapshot is dropped here
        }
    }
}

live_value_state: fn<T: [Encode, Decode], E: [Encode, Decode]>(text: String) -> Loadable<T, E>? {
    if text.starts_with("ok:") {
        value: live_json.decode<T>(text.slice(3, text.len())) ?? return None
        return Val(Loadable.Loaded(value))
    }
    if !text.starts_with("err:") -> return None
    reason: live_json.decode<E>(text.slice(4, text.len())) ?? return None
    Val(Loadable.Failed(reason))
}

// Stores `value` as binding `id`'s result; a value that differs from the
// stored one counts as a change. The binding becomes clean unless `started`,
// its generation when the run began, is older than its generation now: an
// invalidation that arrived during the run keeps it stale, so the next read
// runs it again. From the LIVE_HOLD_AFTER-th such run in a row, the stale
// result is held: reads serve it until the hold ends (as long as the run took,
// at least LIVE_HOLD_MIN_NS), and the first read after that runs the source
// again, so the binding never runs on every read. A hold is never served as
// current: its start publishes the binding's event with `after_ms`, so a
// watching client that read the held result reads again once it ends, and the
// first current result after a hold publishes the event again, so every
// watcher reads it. A push (`started` None) is current as stored. `now`, the
// time the run began, < 0 keeps the last run time.
live_store: fn(id: Int, value: String, now: Int, started: Int?) {
    if value.len() > LIVE_MAX_PAYLOAD {
        return
    }
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return
        index: live_index(registry, id) ?? return
        if registry.records[index].value != value {
            registry.records[index].value = value.copy()  // copy: a lost race retries with the same value
            registry.changes += 1
        }
        overtaken := false
        if started == .Val(generation) && registry.records[index].generation != generation {
            overtaken = true
        }
        // The hub event this store publishes: a hold's start or its end.
        event := ""
        if overtaken {
            registry.records[index].overtaken += 1
            if registry.records[index].overtaken >= LIVE_HOLD_AFTER && now >= 0 {
                ended: rt.clock_mono_ns()
                took: ended - now
                hold: if took > LIVE_HOLD_MIN_NS -> took else -> LIVE_HOLD_MIN_NS
                registry.records[index].held_ns = ended + hold
                event = live_event(id, Val(live_hold_ms(hold)))
            }
        } else {
            if registry.records[index].held_ns != 0 -> event = live_event(id, None)
            registry.records[index].dirty = false
            registry.records[index].overtaken = 0
            registry.records[index].held_ns = 0
        }
        if event != "" -> registry.ws_pushes += 1
        if now >= 0 -> registry.records[index].ran_ns = now
        if live_cell_replace(seen, live_encode(registry)) {
            if event != "" -> rt_web.live_publish("live:{id}", event)
            return
        }
    }
}

// Marks dirty every binding of `source`, or only the one whose key is `key`,
// then publishes each marked binding's invalidation to the WebSocket live
// hub: topic `live:<id>`, the event `live_event` (with the rest of its hold
// when the binding is held). Only connections that watch that binding
// (`watch`) receive it; one that starts watching later first receives the
// topic's latest.
live_invalidate: fn(source: String, key: String?) {
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return
        now: rt.clock_mono_ns()
        hits := [Int]{}
        events := [String]{}
        loop index in 0..<registry.records.len() {
            // An exact-key invalidation names one binding of `source`; a
            // whole-source one also reaches every binding that read it.
            if registry.records[index].source == source {
                if key == .Val(only) && registry.records[index].key != only -> next
            } else if key != None || !registry.records[index].reads.contains(source) { next }
            registry.records[index].dirty = true
            registry.records[index].generation += 1
            id: registry.records[index].id
            held: registry.records[index].held_ns
            hits.push(id)
            events.push(live_event(id, if held > now -> Val(live_hold_ms(held - now)) else -> None))
        }
        if hits.len() == 0 {
            return
        }
        registry.invalidations += hits.len()
        registry.ws_pushes += 1
        if live_cell_replace(seen, live_encode(registry)) {
            loop at in 0..<hits.len() -> rt_web.live_publish("live:{hits[at]}", events[at])
            return
        }
    }
}

// The live hub's event for binding `id`: re-read it, or, while it is held,
// re-read it after `after_ms`, since a read before then gets its held stale
// result.
live_event: fn(id: Int, after_ms: Int?) -> String {
    if after_ms == .Val(ms) {
        return "{{\"live\":\"invalidate\",\"binding\":{id},\"after_ms\":{ms}}}"
    }
    "{{\"live\":\"invalidate\",\"binding\":{id}}}"
}

// `ns` in whole milliseconds, rounded up, so a client that waits them reads
// after the hold.
live_hold_ms: fn(ns: Int) -> Int { (ns + 999999) /% 1000000 }

live_index: fn(registry: LiveRegistry, id: Int) -> Int? {
    loop index in 0..<registry.records.len() {
        if registry.records[index].id == id -> return Val(index)
    }
    None
}

// The cell holds the registry as length-prefixed fields: next id,
// invalidations, changes, evictions, WebSocket pushes, capped re-runs, the
// re-run window's start and count, then twelve fields per binding, the
// eleventh its read set joined by newlines and the last its caller.
live_encode: fn(registry: LiveRegistry) -> [U8] {
    out := [U8]{}
    live_put(out, "{registry.next_id}")
    live_put(out, "{registry.invalidations}")
    live_put(out, "{registry.changes}")
    live_put(out, "{registry.evictions}")
    live_put(out, "{registry.ws_pushes}")
    live_put(out, "{registry.capped}")
    live_put(out, "{registry.window_ns}")
    live_put(out, "{registry.window_runs}")
    loop record in registry.records {
        live_put(out, "{record.id}")
        live_put(out, record.source)
        live_put(out, record.key)
        live_put(out, record.value)
        live_put(out, if record.dirty -> "1" else -> "0")
        live_put(out, "{record.generation}")
        live_put(out, "{record.overtaken}")
        live_put(out, "{record.held_ns}")
        live_put(out, "{record.every_ns}")
        live_put(out, "{record.ran_ns}")
        live_put(out, record.reads.join("\n"))
        live_put(out, record.caller)
    }
    out
}

live_put: fn(out: &[U8], text: String) {
    loop byte in "{text.len()}:".bytes() -> out.push(byte)
    loop byte in text.bytes() -> out.push(byte)
}

// An empty cell is the empty registry; None when the bytes are malformed.
live_decode: fn(raw: [U8]) -> LiveRegistry? {
    if raw.len() == 0 {
        return Val(LiveRegistry{next_id: 0, invalidations: 0, changes: 0, evictions: 0, ws_pushes: 0, capped: 0, window_ns: 0, window_runs: 0, records: [LiveRecord]{}})
    }
    fields: live_fields(raw) ?? return None
    if fields.len() < 8 || (fields.len() - 8) % 12 != 0 -> return None
    next_id: Int.parse(fields[0]) ?? return None
    invalidations: Int.parse(fields[1]) ?? return None
    changes: Int.parse(fields[2]) ?? return None
    evictions: Int.parse(fields[3]) ?? return None
    ws_pushes: Int.parse(fields[4]) ?? return None
    capped: Int.parse(fields[5]) ?? return None
    window_ns: Int.parse(fields[6]) ?? return None
    window_runs: Int.parse(fields[7]) ?? return None
    records := [LiveRecord]{}
    at := 8
    loop at < fields.len() {
        id: Int.parse(fields[at]) ?? return None
        generation: Int.parse(fields[at + 5]) ?? return None
        overtaken: Int.parse(fields[at + 6]) ?? return None
        held_ns: Int.parse(fields[at + 7]) ?? return None
        every_ns: Int.parse(fields[at + 8]) ?? return None
        ran_ns: Int.parse(fields[at + 9]) ?? return None
        reads: if fields[at + 10] == "" -> [String]{} else -> fields[at + 10].split("\n").to_list()
        records.push(LiveRecord{id: id, source: fields[at + 1], key: fields[at + 2], value: fields[at + 3], dirty: fields[at + 4] == "1", generation: generation, overtaken: overtaken, held_ns: held_ns, every_ns: every_ns, ran_ns: ran_ns, reads: reads, caller: fields[at + 11]})
        at += 12
    }
    Val(LiveRegistry{next_id: next_id, invalidations: invalidations, changes: changes, evictions: evictions, ws_pushes: ws_pushes, capped: capped, window_ns: window_ns, window_runs: window_runs, records: records})
}

// The length-prefixed fields (`<decimal byte length>:<bytes>`) of `raw`.
live_fields: fn(raw: [U8]) -> [String]? {
    fields := [String]{}
    at := 0
    loop at < raw.len() {
        length := 0
        loop {
            if at >= raw.len() -> return None
            n: Int{raw[at]}
            at += 1
            if n == 58 -> break
            if n < 48 || n > 57 -> return None
            length = length * 10 + n - 48
        }
        if at + length > raw.len() -> return None
        fields.push(String.from_bytes(raw.slice(at, at + length)) ?? return None)
        at += length
    }
    Val(fields)
}

// Publish the canonical display of a CRDT document onto session `over`
// (jet_sync_publish). A session keeps its generation and merged document; a
// publication that changes the document advances the generation, and a
// duplicate delivery returns the existing receipt. The document merges only
// facts that survive the display: map keys with equal values, list members and
// counter components. A conflicting map value or a differing text document is
// denied rather than replaced by a lexical winner. The Rust adapter also handed
// each change to the installed live transport subscribers; the native runtime
// installs none.
sync: fn(doc_show: String, over: String) -> String Never! {
    if over.trim() == "" || over.len() > SYNC_MAX_SESSION || unicode.has_control(over) {
        return "SyncError(invalid session)"
    }
    document: sync_document_parse(doc_show) ?? return "SyncError(document is not a canonical CRDT value)"
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return "SyncError(session registry is unavailable)"
        found := -1
        sessions := 0
        loop index in 0..<registry.records.len() {
            if registry.records[index].source != LIVE_SYNC_SOURCE -> next
            sessions += 1
            if registry.records[index].key == over -> found = index
        }
        generation := 0
        current := document.copy()
        if found >= 0 {
            stored: sync_session_decode(registry.records[found].value) ?? return "SyncError(session registry is unavailable)"
            generation = stored.generation
            current = stored.document.copy()
        } else if sessions >= SYNC_MAX_ENTRIES { return "SyncError(session limit exceeded)" }
        changed := false
        if current != document {
            merged: sync_document_merge(current, document) ?? return "SyncError(document merge denied)"
            if merged != current {
                if generation >= SYNC_MAX_INT -> return "SyncError(session generation exhausted)"
                generation += 1
                current = merged
                changed = true
            }
        } else if generation == 0 {
            generation = 1
            changed = true
        }
        receipt: "SyncOver(session={over}, generation={generation}, doc={current})"
        if !changed -> return receipt
        value: "{generation}:{current}"
        if found >= 0 -> registry.records[found].value = value else {
            id: registry.next_id + 1
            registry.next_id = id
            registry.records.push(LiveRecord{id: id, source: LIVE_SYNC_SOURCE, key: over.copy(), value: value, dirty: false, generation: 0, overtaken: 0, held_ns: 0, every_ns: 0, ran_ns: 0, reads: [String]{}, caller: ""})
        }
        if live_cell_replace(seen, live_encode(registry)) -> return receipt
    }
}

SyncSession: struct {
    generation: Int
    document: String
}

sync_session_decode: fn(value: String) -> SyncSession? {
    colon: value.find(":")
    if colon < 0 -> return None
    generation: Int.parse(value.slice(0, colon)) ?? return None
    Val(SyncSession{generation: generation, document: value.slice(colon + 1, value.len())})
}

// The canonical document `value` names, or None when it is malformed or not in
// canonical order (JetSyncDocument::parse).
sync_document_parse: fn(value: String) -> String? {
    if value == "" || value.trim() != value || value.len() > SYNC_MAX_DOCUMENT || unicode.has_control(value) {
        return None
    }
    if !value.ends_with(")") -> return None
    if value.starts_with("SyncText(") -> return Val(value.copy())
    canonical := ""
    if value.starts_with("SyncMap(") {
        canonical = sync_map_show(sync_map_entries(value) ?? return None)
    } else if value.starts_with("SyncList(") {
        canonical = sync_list_show(sync_list_items(value) ?? return None)
    } else if value.starts_with("PNCounter(") {
        canonical = sync_counter_show(sync_counter_entries(value) ?? return None)
    } else { return None }
    if canonical != value -> return None
    Val(canonical)
}

sync_document_merge: fn(left: String, right: String) -> String? {
    if left == right -> return Val(left.copy())
    merged := ""
    if left.starts_with("SyncMap(") && right.starts_with("SyncMap(") {
        entries := sync_map_entries(left) ?? return None
        other: sync_map_entries(right) ?? return None
        loop key in other.keys() {
            value: other.get(key) ?? next
            if entries.get(key) == .Val(existing) {
                if existing != value -> return None
            } else { _: entries.add(key, value) }
        }
        if entries.len() > SYNC_MAX_ENTRIES -> return None
        merged = sync_map_show(entries)
    } else if left.starts_with("SyncList(") && right.starts_with("SyncList(") {
        items := sync_list_items(left) ?? return None
        loop item in sync_list_items(right) ?? return None {
            items = sync_pair_insert(items, item) ?? items
        }
        if items.len() > SYNC_MAX_ENTRIES -> return None
        merged = sync_list_show(items)
    } else if left.starts_with("PNCounter(") && right.starts_with("PNCounter(") {
        counts := sync_counter_entries(left) ?? return None
        other: sync_counter_entries(right) ?? return None
        loop replica in other.keys() {
            count: other.get(replica) ?? next
            slot: counts.get(replica) ?? SyncCount{positive: 0, negative: 0}
            positive: if count.positive > slot.positive -> count.positive else -> slot.positive
            negative: if count.negative > slot.negative -> count.negative else -> slot.negative
            _: counts.add(replica, SyncCount{positive: positive, negative: negative})
        }
        if counts.len() > SYNC_MAX_REPLICAS -> return None
        merged = sync_counter_show(counts)
    } else { return None }
    sync_document_parse(merged)
}

SyncPair: struct {
    first: String
    second: String
}

SyncCount: struct {
    positive: Int
    negative: Int
}

sync_map_entries: fn(value: String) -> [String:String]? {
    body: sync_document_body(value, "SyncMap(") ?? return None
    entries := [String:String]{}
    if body == "" -> return Val(entries)
    loop entry in sync_split(body, ",") ?? return None {
        pair: sync_split_once(entry, "=") ?? return None
        key: sync_unescape(pair.first) ?? return None
        item: sync_unescape(pair.second) ?? return None
        if !sync_token_valid(key) || item.len() > SYNC_MAX_TEXT || entries.get(key) != .None {
            return None
        }
        _: entries.add(key, item)
    }
    Val(entries)
}

sync_map_show: fn(entries: [String:String]) -> String {
    keys := [String]{}
    loop key in entries.keys() -> keys.push(key)
    keys.sort()
    shown := [String]{}
    loop key in keys {
        value: entries.get(key) ?? next
        shown.push("{sync_escape(key)}={sync_escape(value)}")
    }
    "SyncMap({shown.join(",")})"
}

sync_list_items: fn(value: String) -> [SyncPair]? {
    body: sync_document_body(value, "SyncList(") ?? return None
    items := [SyncPair]{}
    if body == "" -> return Val(items)
    loop raw in sync_split(body, "|") ?? return None {
        pair: sync_split_once(raw, ":") ?? return None
        replica: sync_unescape(pair.first) ?? return None
        item: sync_unescape(pair.second) ?? return None
        if !sync_token_valid(replica) || item.len() > SYNC_MAX_TEXT -> return None
        items = sync_pair_insert(items, SyncPair{first: replica, second: item}) ?? return None
    }
    if items.len() > SYNC_MAX_ENTRIES -> return None
    Val(items)
}

// `items` with `item` in (first, second) order; None when already present.
sync_pair_insert: fn(items: [SyncPair], item: SyncPair) -> [SyncPair]? {
    out := [SyncPair]{}
    placed := false
    loop existing in items {
        if existing.first == item.first && existing.second == item.second -> return None
        later: if existing.first == item.first -> existing.second > item.second else -> existing.first > item.first
        if !placed && later {
            out.push(item.copy())
            placed = true
        }
        out.push(existing.copy())
    }
    if !placed -> out.push(item.copy())
    Val(out)
}

sync_list_show: fn(items: [SyncPair]) -> String {
    shown := [String]{}
    loop item in items -> shown.push("{sync_escape(item.first)}:{sync_escape(item.second)}")
    "SyncList({shown.join("|")})"
}

sync_counter_entries: fn(value: String) -> [String:SyncCount]? {
    body: sync_document_body(value, "PNCounter(") ?? return None
    counts := [String:SyncCount]{}
    if body == "" -> return Val(counts)
    loop entry in sync_split(body, ",") ?? return None {
        pair: sync_split_once(entry, "=") ?? return None
        replica: sync_unescape(pair.first) ?? return None
        sides: sync_split_once(pair.second, "/") ?? return None
        positive: sync_count_parse(sync_unescape(sides.first) ?? return None, "+") ?? return None
        negative: sync_count_parse(sync_unescape(sides.second) ?? return None, "-") ?? return None
        if !sync_token_valid(replica) || counts.get(replica) != .None -> return None
        _: counts.add(replica, SyncCount{positive: positive, negative: negative})
    }
    if counts.len() > SYNC_MAX_REPLICAS -> return None
    // The checked total of positive minus negative counts must stay an Int.
    total := 0
    loop replica in counts.keys() {
        count: counts.get(replica) ?? next
        if total > 0 && count.positive > SYNC_MAX_INT - total -> return None
        total += count.positive
        if total < 0 && count.negative > SYNC_MAX_INT + total + 1 -> return None
        total -= count.negative
    }
    Val(counts)
}

sync_counter_show: fn(counts: [String:SyncCount]) -> String {
    replicas := [String]{}
    loop replica in counts.keys() -> replicas.push(replica)
    replicas.sort()
    shown := [String]{}
    loop replica in replicas {
        count: counts.get(replica) ?? next
        shown.push("{sync_escape(replica)}=+{count.positive}/-{count.negative}")
    }
    "PNCounter({shown.join(",")})"
}

// `text` is `sign` then decimal digits; its value.
sync_count_parse: fn(text: String, sign: String) -> Int? {
    if !text.starts_with(sign) || text.len() == 1 -> return None
    digits: text.slice(1, text.len())
    loop byte in digits.bytes() {
        n: Int{byte}
        if n < 48 || n > 57 -> return None
    }
    Val(Int.parse(digits) ?? return None)
}

sync_document_body: fn(value: String, prefix: String) -> String? {
    if !value.starts_with(prefix) || !value.ends_with(")") || value.len() < prefix.len() + 1 {
        return None
    }
    Val(value.slice(prefix.len(), value.len() - 1))
}

sync_token_valid: fn(value: String) -> Bool {
    value.trim() != "" && value.len() <= SYNC_MAX_TEXT && !unicode.has_control(value)
}

sync_is_separator: fn(scalar: String) -> Bool {
    scalar == "," || scalar == "=" || scalar == "|" || scalar == ":" || scalar == "/"
}

sync_escape: fn(value: String) -> String {
    out := ""
    loop scalar in unicode.scalars(value) {
        if scalar == "\\" || sync_is_separator(scalar) -> out = "{out}\\"
        out = "{out}{scalar}"
    }
    out
}

// None when an escape is dangling or names no separator, or when a separator
// appears unescaped.
sync_unescape: fn(value: String) -> String? {
    out := ""
    escaped := false
    loop scalar in unicode.scalars(value) {
        if escaped {
            if scalar != "\\" && !sync_is_separator(scalar) -> return None
            out = "{out}{scalar}"
            escaped = false
        } else if scalar == "\\" { escaped = true } else if sync_is_separator(scalar) {
            return None
        } else { out = "{out}{scalar}" }
    }
    if escaped -> return None
    Val(out)
}

// The parts of `value` between unescaped `separator`s, escapes kept.
sync_split: fn(value: String, separator: String) -> [String]? {
    parts := [String]{}
    current := ""
    escaped := false
    loop scalar in unicode.scalars(value) {
        if escaped {
            current = "{current}\\{scalar}"
            escaped = false
        } else if scalar == "\\" { escaped = true } else if scalar == separator {
            parts.push(current)
            current = ""
        } else { current = "{current}{scalar}" }
    }
    if escaped -> return None
    parts.push(current)
    Val(parts)
}

// `value` split at its first unescaped `separator`; None without one.
sync_split_once: fn(value: String, separator: String) -> SyncPair? {
    before := ""
    escaped := false
    at := 0
    loop scalar in unicode.scalars(value) {
        at += scalar.len()
        if escaped -> escaped = false else if scalar == "\\" -> escaped = true else if scalar == separator {
            return Val(SyncPair{first: before, second: value.slice(at, value.len())})
        }
        before = "{before}{scalar}"
    }
    None
}
