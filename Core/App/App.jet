package: {
    name: "app"
    version: "0.0.1"
    edition: "2026"
    description: "Process-level live queries, subscriptions, invalidation and sync."
    license: "MIT"
    outputs: {
        app: .Library{ entry: app }
    }
}

// Live bindings live in one process-wide registry below; sync sessions are
// records of that registry under LIVE_SYNC_SOURCE.
use {
    auth: core.auth
    unicode: core.text
    http: core.http
    crypto: core.crypto
    live_json: core.encoding.json
    core.encoding.[Dyn]
    core.reactive.loadable.[Loadable]
    ws: core.net.ws
    core.net.ws.[WsConn]
    tasks: core.tasks
    core.tasks.[TaskID]
    uuid: core.crypto.uuid
    time: core.time
    rt: jet.runtime.time
    rt_web: jet.runtime.web
    world_rt: jet.runtime.testing
    log_rt: jet.runtime.log
    push_wire: __core_app_push
    dbus: __core_ui_dbus
    url: core.net.url
    markup: core.text.html
    files: core.files
    sys: core.sys
    process: core.process
    net: core.net
    core.net.[UnixListener, UnixStream]
    builtin: jet_builtins
}

SYNC_MAX_SESSION: 256

SYNC_MAX_DOCUMENT: 4194304

SYNC_MAX_TEXT: 1048576

SYNC_MAX_ENTRIES: 100000

SYNC_MAX_REPLICAS: 4096

SYNC_MAX_INT: 9223372036854775807

#Error
AppError: enum {
    Invalid,
    Unsupported
}

// Endpoint markers. A method of a mounted service is an endpoint only when
// one of these marks it: `#App.SignedIn` for a signed-in caller,
// `#App.Public` for any caller. An unmarked method is server-only.
// `limit:` caps the calls one caller makes in each `per` window
// (`#App.Public(limit: 30, per: 1min)`); a call past it is answered 429
// with `Retry-After`, which a Remote reads as `CallError.Unreachable`.
// `#App.Public` counts per network address; `#App.SignedIn` counts per
// account once sign-in names one, and per network address until then.
// `limit: 0`, the default, is no limit.
SignedIn: struct {
    limit: Int{0},
    per: Duration{1min},

    impl Marker {
        sites: [.Method]
    }
}

Public: struct {
    limit: Int{0},
    per: Duration{1min},

    impl Marker {
        sites: [.Method]
    }
}

// A webhook: `#App.Webhook(path: "/hooks/github/:project", signature:
// app.Signature.GitHub, key: "webhook_secret")` makes a method of a mounted
// service answer POST `path` for a sender that signs each delivery. Its
// parameters are the path's parameters, then the delivery's decoded JSON
// body. `key:` names the service's `#App.SigningKey` method, which gives the
// delivery's key from the same path parameters. A delivery runs only when
// that key is there and the delivery carries a valid `signature` under it,
// checked in constant time before the body is decoded; any other is answered
// 401. A webhook is no endpoint: no Remote calls it.
Webhook: struct {
    path: String,
    signature: Signature,
    key: String,

    impl Marker {
        sites: [.Method]
    }
}

// The method a webhook's `key:` names. It takes some of the webhook's path
// parameters, by name, and gives the key the sender signs with, or None,
// which answers 401. It is server-only.
SigningKey: struct {
    impl Marker {
        sites: [.Method]
    }
}

// An upload endpoint's check: `#App.UploadCheck(method: "may_attach")` on an
// endpoint method that takes an `Upload` names the method of the same
// service that decides whether the caller may send the file. That method
// takes, by name, some of the endpoint's arguments other than the `Upload`,
// and gives nothing or the error that refuses the call. It runs after the
// request's head is read and before its body is: as the caller, in a
// transaction that is always rolled back, so it can read but never write. An
// error ends the request 403 with that error, and the body is never read.
// An endpoint that takes an `Upload` has to name its check.
UploadCheck: struct {
    method: String,

    impl Marker {
        sites: [.Method]
    }
}

// A job: `#App.Job(retries: 3)` makes a method of a service a job, which the
// service's own methods queue with `enqueue(fn() { self.method(args) })`.
// Queued inside a call, a job waits for the call: when the call commits it
// runs, once its transaction is done, and when the call rolls back it never
// runs. A job runs as the system (`as_system`), in a call of its own, and a
// run that fails runs again after a backoff, up to `retries:` more times. A
// job is no endpoint: no Remote calls it.
Job: struct {
    retries: Int{5},

    impl Marker {
        sites: [.Method]
    }
}

// A schedule: `#App.Every(cron: "0 8 * * *")` runs a method of a mounted
// service at each minute its cron line allows, in UTC, while the App serves.
// The line has five fields, each a `*`, a number, a range `a-b`, or a list
// of those, each optionally stepped (`*/15`): the minute (0-59), the hour
// (0-23), the day of the month (1-31), the month (1-12) and the day of the
// week (0-7, Sunday 0 or 7). A day is due when both day fields allow it,
// or either does when neither starts with `*`. At start-up a server runs
// the schedule's latest due minute, a run it missed while no server ran,
// and then each next one. A store the run uses records it, so each due
// minute runs on one server, however many serve the App. A schedule runs
// as the system (`as_system`), in a call of its own, and is no endpoint:
// no Remote calls it.
Every: struct {
    cron: String,

    impl Marker {
        sites: [.Method]
    }
}

// How a webhook's sender signs a delivery: an HMAC-SHA256, hex-encoded,
// under the webhook's key.
Signature: enum {
    GitHub,
    Stripe
}

// GitHub: `X-Hub-Signature-256: sha256=<mac>`, the MAC of the body.
// Stripe: `Stripe-Signature: t=<seconds>,v1=<mac>`, the MAC of
// `<seconds>.<body>`; any one `v1` entry may match.

// The request header that carries a delivery's `signature`.
priv webhook_header: fn(signature: Signature) -> String Never! {
    if signature == {
        .GitHub -> "x-hub-signature-256"
        .Stripe -> "stripe-signature"
    }
}

// Whether `sent`, the delivery's signature header, signs `body` under `key`
// by `signature`. Each MAC is compared in constant time, and every `v1`
// entry of a Stripe header is compared.
priv webhook_signed: fn(signature: Signature, key: String, sent: String, body: String) -> Bool Never! {
    if signature == {
        .GitHub -> {
            expected: "sha256={crypto.hex_encode(crypto.hmac_sha256(key.bytes(), body.bytes()))}"
            crypto.constant_time_equal_bytes(expected.bytes(), sent.bytes())
        }
        .Stripe -> {
            stamp := ""
            macs := [String]{}
            loop part in sent.split(",") {
                entry: part.trim()
                if entry.starts_with("t=") -> stamp = entry.slice(2, entry.len())
                if entry.starts_with("v1=") -> macs.push(entry.slice(3, entry.len()))
            }
            if stamp == "" -> return false
            expected: crypto.hex_encode(crypto.hmac_sha256(key.bytes(), "{stamp}.{body}".bytes()))
            matched := false
            loop mac in macs {
                if crypto.constant_time_equal_bytes(expected.bytes(), mac.bytes()) -> matched = true
            }
            matched
        }
    }
}

#Test("webhook signatures check the sender's MAC") {
    // GitHub's published example delivery.
    github: "sha256=757107ea0eb2509fc211221cce984b8a37570b6d7586c22c46f4379c8b043e17"
    assert(webhook_signed(.GitHub, "It's a Secret to Everybody", github, "Hello, World!"))
    assert(!webhook_signed(.GitHub, "It's a Secret to Everybody", github, "Hello, World?"))
    assert(!webhook_signed(.GitHub, "another key", github, "Hello, World!"))
    assert(!webhook_signed(.GitHub, "It's a Secret to Everybody", "", "Hello, World!"))
    mac: crypto.hex_encode(crypto.hmac_sha256("whsec".bytes(), "1700000000.{{\"id\":\"evt_1\"}}".bytes()))
    assert(webhook_signed(.Stripe, "whsec", "t=1700000000,v1=00,v1={mac}", "{{\"id\":\"evt_1\"}}"))
    assert(!webhook_signed(.Stripe, "whsec", "t=1700000001,v1={mac}", "{{\"id\":\"evt_1\"}}"))
    assert(!webhook_signed(.Stripe, "whsec", "v1={mac}", "{{\"id\":\"evt_1\"}}"))
    assert_eq(webhook_header(.Stripe), "stripe-signature")
}

// A client of the service `S`. It offers only the methods of `S` that
// `#App.SignedIn` or `#App.Public` marks: a call of any other method of `S`
// is E2812, and the service itself stays out of reach. A call through a
// Remote that `remote` made runs the method directly on that service; one
// through a Remote that `remote_at` made posts it to the server, and one
// through the app graph's Remote of a service the graph mounts (`App.__remote`)
// is answered in this process as a server answers it (`graph_post`). Either
// way the call is one transaction on each store it uses, as a served call is
// (`transactions`), and the call's error type takes a `CallError`: a method
// that fails with `E` needs `impl CallError -> E`, and one that can't fail
// answers `R CallError!`. A Remote made for a named client fails each call
// `.Unreachable`, running nothing, while a test has that client cut off
// (`disconnect`). On a device that queues (`App.offline(.Queue)`), a
// method that answers nothing is a write, and a write through a Remote
// that posts joins the device's queue when it can't be sent now (`__write`);
// every call through such a Remote sends its client's queued writes first.
Remote: struct<S> {
    priv service: S?,
    priv address: String,
    priv client: String,
    // Whether the app graph mounts `S`, so `address` names `S` in it.
    priv local: Bool,

    // A call of the endpoint method `method` of `S`, which can fail with
    // `E`. The compiler lowers each such call here: `direct` runs it on the
    // service the Remote holds; otherwise `args`, the encoded arguments, go to
    // the server, and `fail` gives a `CallError` as the method's own error.
    __call: fn<R: [Encode, Decode], E: [Encode, Decode]>(self, method: String, args: [String], direct: fn(S) -> R E!, fail: fn(CallError) -> R E!) -[Net, Time]> R E! {
        if links_cut(self.client) -> return fail(links_unreachable(self.client, method))
        if self.service == .Val(service) -> return remote_direct(service, direct, fail)
        if queue_on() -> _: queue_drain(self.client)
        reply: remote_post(self.address, self.local, method, args) ?? return fail(err)
        tree: live_json.parse(reply) ?? return fail(.Unreachable("the server's reply to `{method}` is not JSON"))
        if live_json.at<E>(tree, "/err") == .Ok(error) -> return Err(error)
        value: live_json.at<R>(tree, "/ok") ?? return fail(.Unreachable("the server's reply to `{method}` has no value"))
        Ok(value)
    }

    // A call of the endpoint method `method` of `S`, which can't fail.
    __call_value: fn<R: [Encode, Decode]>(self, method: String, args: [String], direct: fn(S) -> R Never!) -[Net, Time]> R CallError! {
        if links_cut(self.client) -> return Err(links_unreachable(self.client, method))
        if self.service == .Val(service) -> return remote_direct_value(service, direct)
        if queue_on() -> _: queue_drain(self.client)
        reply: remote_post(self.address, self.local, method, args)
        tree: live_json.parse(reply) ?? return Err(.Unreachable("the server's reply to `{method}` is not JSON"))
        value: live_json.at<R>(tree, "/ok") ?? return Err(.Unreachable("the server's reply to `{method}` has no value"))
        Ok(value)
    }

    // A call of the endpoint method `method` of `S` that answers nothing
    // and can fail with `E`: a write. On a device that queues, a write
    // through a Remote that posts joins the queue, and the call succeeds at
    // once, when its client is cut off, when the client's earlier writes
    // are still queued, or when no answer comes (`queue_post`); otherwise
    // it runs as `__call` runs a call.
    __write: fn<E: [Encode, Decode]>(self, method: String, args: [String], direct: fn(S) E!, fail: fn(CallError) E!) -[Net, Time]> E! {
        held: self.service == .Val(_)
        queues: queue_on() && !held
        if !queues && links_cut(self.client) -> return fail(links_unreachable(self.client, method))
        if self.service == .Val(service) -> return remote_direct(service, direct, fail)
        reply := ""
        if queues {
            reply = queue_post(self.client, self.address, self.local, method, args) ?? return fail(err)
        } else { reply = remote_post(self.address, self.local, method, args) ?? return fail(err) }
        if reply == "" -> return Ok()
        tree: live_json.parse(reply) ?? return fail(.Unreachable("the server's reply to `{method}` is not JSON"))
        if live_json.at<E>(tree, "/err") == .Ok(error) -> return Err(error)
        Ok()
    }

    // A write of the endpoint method `method` of `S`, which can't fail.
    __write_value: fn(self, method: String, args: [String], direct: fn(S) Never!) -[Net, Time]> CallError! {
        held: self.service == .Val(_)
        queues: queue_on() && !held
        if !queues && links_cut(self.client) -> return Err(links_unreachable(self.client, method))
        if self.service == .Val(service) -> return remote_direct_value(service, direct)
        reply := ""
        if queues {
            reply = queue_post(self.client, self.address, self.local, method, args) ?? return Err(err)
        } else { reply = remote_post(self.address, self.local, method, args) }
        if reply == "" -> return Ok()
        _: live_json.parse(reply) ?? return Err(.Unreachable("the server's reply to `{method}` is not JSON"))
        Ok()
    }

    // One argument of a remote call, encoded.
    __arg: fn<A: Encode>(self, value: A) -> String Never! {
        live_json.to_string<A>(value) ?? "null"
    }
}

// A call that `direct` runs on `service`, the service a Remote holds, as one
// transaction on each store it uses, retried while a store stays busy.
priv remote_direct: fn<S, R, E>(service: S, direct: fn(S) -> R E!, fail: fn(CallError) -> R E!) -> R E! {
    loop _ in 0..<transactions.attempts() {
        call: transactions.begin() ?? return direct(service)
        if direct(service) == {
            .Ok(value) -> {
                if transactions.end(call, true) -> return Ok(value)
            }
            .Err(error) -> {
                if transactions.end(call, false) -> return Err(error)
            }
        }
    }
    fail(.Unreachable("the database stayed busy"))
}

// remote_direct for a method that can't fail.
priv remote_direct_value: fn<S, R>(service: S, direct: fn(S) -> R Never!) -> R CallError! {
    loop _ in 0..<transactions.attempts() {
        call: transactions.begin() ?? return Ok(direct(service))
        value: direct(service)
        if transactions.end(call, true) -> return Ok(value)
    }
    Err(.Unreachable("the database stayed busy"))
}

// How a remote call failed. Every call through a `Remote` can fail this way,
// so the error type of a service method converts from it.
#Error
CallError: enum {
    Unreachable(String),
    Invalid([FieldError]),
    SignedOut,
    UpdateRequired,

    // This failure as an error of the call; the compiler's `fail` binds it,
    // so the method's error type takes it through its conversion.
    __raise: fn<R>(self) -> R CallError! { Err(self) }
}

// No answer: the server is down or unreachable, or its reply was not one
// a Remote reads.
// The server could not decode the call's arguments (HTTP 422): the field
// errors its reply names.
// The method needs a signed-in caller, and the call had none (HTTP 401).
// The server no longer accepts this client's wire version (HTTP 426).

// A field error a method reports for one of its arguments, from a rule the
// argument's `validate` block can't check (one that reads the database):
// `at` is the path of the field it is about, in that argument (`assignee`,
// `tasks[3].title`, `tasks[{index}].title`), and `reason` what is wrong with
// it. `at` must be a string literal, interpolated only inside a `[…]` index,
// that walks to a stored field of a struct argument of the method that
// reports it (E2813), so the error shows beside that field, as a failed
// `validate` check does.
field_error: fn(at: String, reason: String) -> FieldError Never! {
    FieldError{path: at, reason: reason}
}

// A fresh UUIDv7, as lowercase text, made where it is called: the Unix
// millisecond it was made, then 74 random bits. A client gives a row it
// creates this ID, so a row made offline has its final ID at once, and IDs
// made later sort after it. It stops the task when the system has no
// random source.
new_id: fn() -[Rand, Time]> String Never! {
    clock := time.Clock.new(time.now_utc().to_unix_ms())
    uuid.v7(clock) ?? panic("app.new_id: {err}")
}

#Test("a new ID is UUIDv7 text that names the millisecond it was made") {
    before: time.now_utc().to_unix_ms()
    first: new_id()
    second: new_id()
    after: time.now_utc().to_unix_ms()
    assert(first != second)
    assert_eq(first.len(), 36)
    assert_eq(first.slice(14, 15), "7")
    assert(first.slice(19, 20) == "8" || first.slice(19, 20) == "9" || first.slice(19, 20) == "a" || first.slice(19, 20) == "b")
    assert_eq(uuid.parse(first) ?? panic("the ID parses"), first)
    made := 0
    loop b in "{first.slice(0, 8)}{first.slice(9, 13)}".bytes() {
        digit: if b >= 97 -> Int{b} - 87 else -> Int{b} - 48
        made = made * 16 + digit
    }
    assert(made >= before && made <= after)
}

// Where a handler's failure goes. A control's handler has the type
// `fn() app.Notice!`, so its error type converts to a Notice; the frame
// shows the notice beside the control, announces it, and keeps it until
// it is dismissed. `retry` offers to run the handler again.
#Error
Notice: struct {
    text: String,
    retry: Bool{false}
}

// The app's notice list holds the notices that have no control to sit
// beside: a failed background run, a queued write refused after its screen
// closed. The frame shows the list on every screen and keeps each notice
// until it is dismissed. The list lives in the device store, so it outlasts
// a restart (`jet.runtime.web` device_load/device_replace: a file under the
// platform data directory and the app's package name, written through
// atomically); inside a deterministic world it is the World's own cell, and
// in a program with no device store (a test build) one process-wide cell.
// It is kept as length-prefixed fields: each notice's text, then "1" or "0"
// for its retry.
NoticeCell: struct {
    bytes: [U8]
}

NOTICE_CELL: Shared{NoticeCell{bytes: [U8]{}}}

NOTICE_STORE: "app.notices"

notice_cell_load: fn() -> [U8] {
    if world_rt.world_store_load(NOTICE_STORE) == .Val(bytes) -> return bytes
    if rt_web.device_load(NOTICE_STORE) == .Val(bytes) -> return bytes
    NOTICE_CELL.bytes
}

notice_cell_replace: fn(expected: [U8], replacement: &&[U8]) -> Bool {
    if world_rt.world_store_replace(NOTICE_STORE, expected, replacement) == .Val(replaced) {
        return replaced
    }
    if rt_web.device_replace(NOTICE_STORE, expected, replacement) == .Val(replaced) {
        return replaced
    }
    cell := NOTICE_CELL.guard_edit()
    if cell.value.bytes != expected -> return false
    cell.value.bytes = replacement.move()
    true
}

// Adds `notice` to the end of the app's notice list.
__keep_notice: fn(notice: Notice) {
    loop {
        seen: notice_cell_load()
        kept := seen.copy()
        live_put(kept, notice.text)
        live_put(kept, if notice.retry -> "1" else -> "0")
        if notice_cell_replace(seen, kept) {
            return
        }
    }
}

// The app's notice list, oldest first: the notices with no control to sit
// beside, each kept until it is dismissed.
notices: fn() -> [Notice] { notice_decode(notice_cell_load()) }

// Removes the notice at position `at` of the app's notice list; nothing
// when there is none.
__dismiss: fn(at: Int) {
    loop {
        seen: notice_cell_load()
        listed: notice_decode(seen)
        if at < 0 || at >= listed.len() {
            return
        }
        kept := [U8]{}
        loop index in 0..<listed.len() {
            if index == at -> next
            live_put(kept, listed[index].text)
            live_put(kept, if listed[index].retry -> "1" else -> "0")
        }
        if notice_cell_replace(seen, kept) {
            return
        }
    }
}

// The notices of an encoded list; malformed bytes are an empty list.
notice_decode: fn(raw: [U8]) -> [Notice] {
    fields: live_fields(raw) ?? return [Notice]{}
    listed := [Notice]{}
    at := 0
    loop at + 1 < fields.len() {
        listed.push(Notice{text: fields[at], retry: fields[at + 1] == "1"})
        at += 2
    }
    listed
}

#Test("a kept notice stays in the app's notice list, in order, until it is dismissed") {
    before: notices().len()
    __keep_notice(Notice{text: "Couldn't sync the board.", retry: true})
    __keep_notice(Notice{text: "That task no longer exists."})
    kept: notices()
    assert_eq(kept.len(), before + 2)
    assert_eq(kept[before].text, "Couldn't sync the board.")
    assert(kept[before].retry, "the first notice offers a retry")
    assert_eq(kept[before + 1].text, "That task no longer exists.")
    assert(!kept[before + 1].retry, "a notice offers no retry unless it says so")
    __dismiss(before)
    __dismiss(kept.len())
    left: notices()
    assert_eq(left.len(), before + 1)
    assert_eq(left[before].text, "That task no longer exists.")
}

// The largest reply a remote call reads.
REMOTE_MAX_REPLY: 16777216

// The Remote of a service the server holds: each call through it runs the
// marked method on `service` directly. `client` names the client that holds
// it, which a test can cut off (`disconnect`); "" names none.
remote: fn<S>(service: &&S, client: String{""}) -> Remote<S> Never! {
    Remote<S>{service: Val(service), address: "", client: client, local: false}
}

// The Remote of a service a server mounts at `address`, its mount prefix
// (`http://127.0.0.1:8080/api`): each call posts its JSON arguments to
// `{address}/{method}`. `client` is as for `remote`.
remote_at: fn<S>(address: String, client: String{""}) -> Remote<S> Never! {
    Remote<S>{service: None, address: address, client: client, local: false}
}

// The test host's link between each client and the servers. `disconnect`
// cuts client `client` off: until `reconnect`, each call through a Remote made
// for it (`remote(service, client: …)`, `remote_at`) fails `.Unreachable`,
// naming the client and the method, and runs nothing on the server. Nothing
// touches the network: the cut is one recorded fact, so an offline, catch-up
// or replay case runs the same each time. The servers, and every other
// client, go on; writes made on either side while cut off merge when the
// client calls again (`sync`). Inside a deterministic world (`testing.world`)
// the links are the World's own, so each world starts with every client
// connected. A client name is not blank and has no control character.
disconnect: fn(client: String) Never! { links_set(client, true) }

// Restores the link `disconnect` cut: the client's next call reaches the
// server again, and the writes the client queued meanwhile are sent now, in
// order (`queue_drain`).
reconnect: fn(client: String) -[Net, Time]> Never! {
    links_set(client, false)
    _: queue_drain(client)
}

// The clients a test cut off, one name a line, sorted, in one process-wide
// cell; inside a deterministic world, the World's own cell `app.links`.
priv LINKS_CELL: Shared{LiveCell{bytes: [U8]{}}}

priv links_load: fn() -> [U8] Never! {
    if world_rt.world_store_load("app.links") == .Val(bytes) -> return bytes
    LINKS_CELL.bytes
}

priv links_replace: fn(expected: [U8], replacement: &&[U8]) -> Bool Never! {
    if world_rt.world_store_replace("app.links", expected, replacement) == .Val(replaced) {
        return replaced
    }
    cell := LINKS_CELL.guard_edit()
    if cell.value.bytes != expected -> return false
    cell.value.bytes = replacement.move()
    true
}

priv links_names: fn(raw: [U8]) -> [String] Never! {
    text: String.from_bytes(raw) ?? return [String]{}
    if text == "" -> return [String]{}
    text.split("\n").to_list()
}

// Whether a test cut client `client` off; a Remote of no client never is.
priv links_cut: fn(client: String) -> Bool Never! {
    if client == "" -> return false
    loop name in links_names(links_load()) {
        if name == client -> return true
    }
    false
}

priv links_set: fn(client: String, cut: Bool) Never! {
    if client.trim() == "" || unicode.has_control(client) {
        panic("app.disconnect: `{client}` is no client name: a name is not blank and has no control character")
    }
    loop {
        seen: links_load()
        names := [String]{}
        loop name in links_names(seen) {
            if name != client -> names.push(name)
        }
        if cut -> names.push(client.copy())
        names.sort()
        if links_replace(seen, names.join("\n").bytes()) {
            return
        }
    }
}

priv links_unreachable: fn(client: String, method: String) -> CallError Never! {
    .Unreachable("client `{client}` is disconnected, so `{method}` did not reach the server")
}

#Test("the test host cuts one client off until it reconnects, and leaves every other client and the unnamed one connected") {
    assert(!links_cut("phone"))
    disconnect("phone")
    disconnect("phone")
    disconnect("tablet")
    assert(links_cut("phone"))
    assert(!links_cut("desk"))
    assert(!links_cut(""))
    assert_eq(links_names(links_load()).join(","), "phone,tablet")
    assert_eq(links_unreachable("phone", "save"), CallError.Unreachable("client `phone` is disconnected, so `save` did not reach the server"))
    reconnect("phone")
    assert(!links_cut("phone"))
    assert(links_cut("tablet"))
    reconnect("phone")
    reconnect("tablet")
    assert_eq(links_names(links_load()).len(), 0)
}

// The device's queue of the writes it couldn't send, oldest first, when the
// app graph queues (`App.offline(.Queue)`): each is the call of `method`
// through a Remote of `client` that posts to `address` (`local`: the app
// graph answers it), its encoded arguments `body`, and the request key it
// keeps on every send, so a server that ran it once answers a repeat with
// the reply it kept.
#Equatable
priv QueuedWrite: struct {
    client: String,
    address: String,
    local: Bool,
    method: String,
    body: String,
    key: String
}

// The queue lives where the notice list does (NoticeCell): in the device
// store, so a restart finds it as the run left it; in the World's own cell
// `app.queue` inside a deterministic world; else one process-wide cell. It
// is kept as length-prefixed fields: each write's client, address, "1" or
// "0" for local, method, body and key.
priv QUEUE_CELL: Shared{LiveCell{bytes: [U8]{}}}

priv QUEUE_STORE: "app.queue"

priv queue_load: fn() -> [U8] Never! {
    if world_rt.world_store_load(QUEUE_STORE) == .Val(bytes) -> return bytes
    if rt_web.device_load(QUEUE_STORE) == .Val(bytes) -> return bytes
    QUEUE_CELL.bytes
}

priv queue_replace: fn(expected: [U8], replacement: &&[U8]) -> Bool Never! {
    if world_rt.world_store_replace(QUEUE_STORE, expected, replacement) == .Val(replaced) {
        return replaced
    }
    if rt_web.device_replace(QUEUE_STORE, expected, replacement) == .Val(replaced) {
        return replaced
    }
    cell := QUEUE_CELL.guard_edit()
    if cell.value.bytes != expected -> return false
    cell.value.bytes = replacement.move()
    true
}

// The writes of an encoded queue; malformed bytes are an empty queue.
priv queue_decode: fn(raw: [U8]) -> [QueuedWrite] Never! {
    fields: live_fields(raw) ?? return [QueuedWrite]{}
    writes := [QueuedWrite]{}
    at := 0
    loop at + 5 < fields.len() {
        writes.push(QueuedWrite{client: fields[at], address: fields[at + 1], local: fields[at + 2] == "1", method: fields[at + 3], body: fields[at + 4], key: fields[at + 5]})
        at += 6
    }
    writes
}

priv queue_put: fn(out: &[U8], write: QueuedWrite) Never! {
    live_put(out, write.client)
    live_put(out, write.address)
    live_put(out, if write.local -> "1" else -> "0")
    live_put(out, write.method)
    live_put(out, write.body)
    live_put(out, write.key)
}

// Adds `write` to the end of the queue.
priv queue_add: fn(write: QueuedWrite) Never! {
    loop {
        seen: queue_load()
        kept := seen.copy()
        queue_put(kept, write)
        if queue_replace(seen, kept) {
            return
        }
    }
}

// Removes the write whose request key is `key`; nothing when none is queued.
priv queue_remove: fn(key: String) Never! {
    loop {
        seen: queue_load()
        kept := [U8]{}
        loop write in queue_decode(seen) {
            if write.key != key -> queue_put(kept, write)
        }
        if queue_replace(seen, kept) {
            return
        }
    }
}

// The oldest write client `client` queued.
priv queue_first: fn(client: String) -> QueuedWrite? Never! {
    loop write in queue_decode(queue_load()) {
        if write.client == client -> return Val(write.copy())
    }
    None
}

// Whether the app graph queues the writes it can't send.
priv queue_on: fn() -> Bool Never! {
    held: APP_GRAPH.guard_read()
    held.value.offline == .Queue
}

// The number of writes the device's queue holds, waiting to send.
pending: fn() -> Int Never! { queue_decode(queue_load()).len() }

// The clients whose queue a task is sending now, so one task sends a
// client's writes, in order, and a write made meanwhile, even by a call the
// sending runs, waits behind them.
priv QUEUE_SENDERS: Shared{[String]{}}

priv queue_claim: fn(client: String) -> Bool Never! {
    senders := QUEUE_SENDERS.guard_edit()
    loop name in senders.value {
        if name == client -> return false
    }
    senders.value.push(client.copy())
    true
}

priv queue_release: fn(client: String) Never! {
    senders := QUEUE_SENDERS.guard_edit()
    kept := [String]{}
    loop name in senders.value {
        if name != client -> kept.push(name.copy())
    }
    senders.value = kept
}

// Sends client `client`'s queued writes, oldest first, each under its own
// request key, unless another task sends them now. A write the server
// commits leaves the queue. A write it refuses (its method's error, or
// `.Invalid`) is rolled back: it leaves the queue, and a notice naming it
// and the refusal joins the app's notice list (`__keep_notice`), since its
// screen may be long gone. No answer, `.SignedOut` or `.UpdateRequired`
// stops the sending and keeps the write. True when the client's queue is
// empty after.
priv queue_drain: fn(client: String) -[Net, Time]> Bool Never! {
    if !queue_claim(client) -> return false
    sent: queue_send(client)
    queue_release(client)
    sent
}

priv queue_send: fn(client: String) -[Net, Time]> Bool Never! {
    loop {
        if links_cut(client) -> return false
        write: queue_first(client) ?? return true
        refusal := String?{None}
        if remote_send(write.address, write.local, write.method, write.body, write.key) == {
            .Ok(reply) -> { refusal = queue_refusal(reply) }
            .Err(failure) -> {
                if failure == {
                    .Invalid(fields) -> { refusal = Val(queue_invalid(fields)) }
                    .Unreachable(_) | .SignedOut | .UpdateRequired -> return false
                }
            }
        }
        queue_remove(write.key)
        if refusal == .Val(why) {
            __keep_notice(Notice{text: "The server refused `{write.method}`, so it was undone: {why}"})
        }
    }
}

// The error JSON of a reply that `__reply_err` made, `{"err":…}`; None for
// any other reply.
priv queue_refusal: fn(reply: String) -> String? Never! {
    if !reply.starts_with("{{\"err\":") || !reply.ends_with("}}") -> return None
    Val(reply.slice(7, reply.len() - 1))
}

priv queue_invalid: fn(fields: [FieldError]) -> String Never! {
    reasons := [String]{}
    loop field in fields {
        reasons.push(if field.path == "" -> field.reason.copy() else -> "{field.path}: {field.reason}")
    }
    reasons.join("; ")
}

// A write of `method` through a Remote of `client` that posts to `address`,
// on a device that queues: queued, so the call succeeds at once (""), when
// the client is cut off, when its earlier writes are still queued, or when
// no answer comes; else the reply it got, which is never empty. Sent or
// queued, the write keeps one request key.
priv queue_post: fn(client: String, address: String, local: Bool, method: String, args: [String]) -[Net, Time]> String CallError! {
    write: QueuedWrite{client: client, address: address, local: local, method: method, body: "[{args.join(",")}]", key: remote_key(address, method)}
    if links_cut(client) || !queue_drain(client) {
        queue_add(write)
        return Ok("")
    }
    sent: remote_send(write.address, write.local, write.method, write.body, write.key) ?? {
        if !call_unanswered(err) -> return Err(err)
        queue_add(write)
        return Ok("")
    }
    Ok(sent)
}

// Whether `failure` is no answer at all, so a write may wait in the queue.
priv call_unanswered: fn(failure: CallError) -> Bool Never! {
    if failure == {
        .Unreachable(_) -> true
        .Invalid(_) | .SignedOut | .UpdateRequired -> false
    }
}

#Test("a queued write keeps its key and order, and leaves the queue by its key") {
    before: pending()
    queue_add(QueuedWrite{client: "queue-test", address: "http://127.0.0.1:9/api", local: false, method: "save", body: "[1]", key: "k1"})
    queue_add(QueuedWrite{client: "queue-test", address: "http://127.0.0.1:9/api", local: false, method: "save", body: "[2]", key: "k2"})
    assert_eq(pending(), before + 2)
    first: queue_first("queue-test") ?? panic("a write is queued")
    assert_eq(first.key, "k1")
    assert_eq(first.body, "[1]")
    assert(!first.local)
    assert_eq(queue_first("queue-other"), None)
    queue_remove("k1")
    assert_eq((queue_first("queue-test") ?? panic("one write is left")).key, "k2")
    queue_remove("k2")
    assert_eq(pending(), before)
}

#Test("a refusal is the error JSON of an err reply, and an ok reply is none") {
    assert_eq(queue_refusal("{{\"err\":\"Conflict\"}}"), Val("\"Conflict\""))
    assert_eq(queue_refusal("{{\"ok\":null}}"), None)
    assert_eq(queue_invalid([FieldError]{FieldError{path: "title", reason: "is empty"}, FieldError{path: "", reason: "no JSON"}}), "title: is empty; no JSON")
    assert(call_unanswered(.Unreachable("down")))
    assert(!call_unanswered(.SignedOut))
}

#Test("one task sends a client's queue at a time") {
    assert(queue_claim("queue-claim"))
    assert(!queue_claim("queue-claim"))
    assert(queue_claim("queue-claim-other"))
    queue_release("queue-claim")
    queue_release("queue-claim-other")
    assert(queue_claim("queue-claim"))
    queue_release("queue-claim")
}

// The times a remote call is sent, in all, while its reply is lost: each
// send carries the call's one request key, so a server that ran the call
// answers a repeat with the reply it kept, and the call runs once.
priv REMOTE_SENDS: 3

// The wait before a remote call is sent again, in milliseconds, times the
// sends so far.
priv REMOTE_RESEND_MS: 200

// One remote call: POST the JSON array of `args` to `{address}/{method}`
// under a fresh request key (`remote_send`).
priv remote_post: fn(address: String, local: Bool, method: String, args: [String]) -[Net, Time]> String CallError! {
    remote_send(address, local, method, "[{args.join(",")}]", remote_key(address, method))
}

// A fresh request key for a call of `{address}/{method}`.
priv remote_key: fn(address: String, method: String) -> String Never! {
    make_trace_id("key:{rt.clock_mono_ns()}:{trace_next()}:{address}/{method}", 16)
}

// One send of a remote call: POST `body`, the JSON array of its arguments,
// to `{address}/{method}`; the reply's body on 200, else the failure its
// status names. The call carries a W3C `traceparent` that starts its trace,
// and that trace's id as its `x-request-id`, so the server's span of the
// call has both. It also carries its request key `key`, its
// `idempotency-key`, and is sent again under that key when no reply comes,
// up to `REMOTE_SENDS` times. A `local` call is the app graph's, answered in
// this process under the same key (`graph_post`).
priv remote_send: fn(address: String, local: Bool, method: String, body: String, key: String) -[Net, Time]> String CallError! {
    if local -> return graph_post("{address}/{method}", key, body)
    seed: "{rt.clock_mono_ns()}:{trace_next()}:{key}"
    trace: make_trace_id("trace:{seed}", 16)
    lost := ""
    loop sends in 0..<REMOTE_SENDS {
        if sends > 0 -> tasks.sleep(REMOTE_RESEND_MS * sends)
        sent: http.__request("POST", "{address}/{method}").__with_header("traceparent", "00-{trace}-{make_trace_id("span:{seed}", 8)}-01").__with_header("x-request-id", trace).__with_header("idempotency-key", key).__with_body(body)
        response: sent.send() ?? {
            lost = "{err}"
            next
        }
        text: response.body.text(REMOTE_MAX_REPLY) ?? {
            lost = "{err}"
            next
        }
        return if {
            response.status == 200 -> Ok(text)
            response.status == 401 -> Err(.SignedOut)
            response.status == 422 -> Err(.Invalid(remote_invalid(text)))
            response.status == 426 -> Err(.UpdateRequired)
            response.status == 429 -> Err(.Unreachable("{address}/{method} is limited: retry after {response.header("retry-after") ?? "?"} s"))
            else -> Err(.Unreachable("{address}/{method} answered {response.status}"))
        }
    }
    Err(.Unreachable("{address}/{method}: {lost}"))
}

// A W3C trace-context id of `n` bytes (16 for a trace, 8 for a span) as
// lowercase hex: the leading bytes of `seed`'s SHA-256. Each caller's seed
// holds a clock reading and a count, so no two ids it makes repeat; ids
// need no random source, which a handler's effects do not allow.
priv make_trace_id: fn(seed: String, n: Int) -> String Never! {
    digest: crypto.sha256(seed)
    crypto.hex_encode(digest.bytes.slice(0, n))
}

// The process's count of the trace seeds a Remote makes.
TRACE_SEEDS: Shared{0}

priv trace_next: fn() -> Int Never! {
    guard := TRACE_SEEDS.guard_edit()
    guard.value += 1
    guard.value
}

// The field errors of a 422 reply, `{"invalid": [{"path": …, "reason":
// …}, …]}`; a reply that is not that shape is one error with its text.
priv remote_invalid: fn(text: String) -> [FieldError] Never! {
    tree: live_json.parse(text) ?? return [FieldError]{FieldError{path: "", reason: "{text}"}}
    errors := [FieldError]{}
    index := 0
    loop {
        reason: live_json.at<String>(tree, "/invalid/{index}/reason") ?? break
        path: live_json.at<String>(tree, "/invalid/{index}/path") ?? ""
        errors.push(FieldError{path: path, reason: reason})
        index += 1
    }
    if errors.len() == 0 -> return [FieldError]{FieldError{path: "", reason: "{text}"}}
    errors
}

// A live binding: one source function applied to one argument list, run as
// the caller that made it. The compiler builds it from
// `live(source, args...)` or `subscribe(source, args...)`; `state` reads it.
// A source may read the database, fetch over the network and wait, nothing
// more, so `state` runs on every target that has those, the web included.
Live: struct<T, E> {
    id: Int,
    run: fn() -[DB.Read, Net, Time]> T E!,
    priv acting: Acting?
}

// One registry binding, named by its source's wire name, its encoded
// argument list and `caller`, the caller it runs as (`acting_tag`), so two
// callers never share a result. `value` is the last result, `ok:` or `err:`
// then its JSON, and empty before the first run; `generation` counts the
// invalidations that reached the binding; `overtaken` counts its runs in a
// row that an invalidation overtook, and `held_ns` is the monotonic time
// until which a stale binding serves its stored result (0: none); `every_ns`
// is the poll interval (0: none) and `ran_ns` the monotonic time of the last
// run. `reads` is its read set: the other sources (a table's
// `core.db.live:<table>`) its runs read (`live_reads`), so a write to any of
// them re-runs it too.
LiveRecord: struct {
    id: Int,
    source: String,
    key: String,
    value: String,
    dirty: Bool,
    generation: Int,
    overtaken: Int,
    held_ns: Int,
    every_ns: Int,
    ran_ns: Int,
    reads: [String],
    caller: String
}

// What `state` reads before it runs a binding: the stored result when it is
// current, held, or capped (live_current), and the binding's generation then.
LiveCurrent: struct {
    value: String?,
    generation: Int
}

// `capped` counts the re-runs the per-second cap turned into holds;
// `window_ns` starts the current second of re-runs and `window_runs` counts
// the re-runs in it.
LiveRegistry: struct {
    next_id: Int,
    invalidations: Int,
    changes: Int,
    evictions: Int,
    ws_pushes: Int,
    capped: Int,
    window_ns: Int,
    window_runs: Int,
    records: [LiveRecord]
}

// The live registry lives in a process-wide runtime byte cell; every update
// reads the cell, edits the decoded registry and installs it only if the cell
// is unchanged, retrying otherwise, so concurrent callers never lose an update.
//
// The compiler checks `live`, `subscribe`, `push` and `invalidate` against
// their source function and lowers them to the `__live_*` helpers below.

// The binding's current state. The source re-runs when the binding has no
// result yet, was invalidated, or its poll interval has passed; the stored
// result changes only when the re-run's encoding differs. A re-run that an
// invalidation overtook stores its result but leaves the binding stale, since
// what it read may predate that write. Under writes that keep overtaking it, a
// binding settles: from its second overtaken run in a row, its stale result
// is served for a hold (live_store) instead of running the source on every
// read, and its watchers (`watch`) are told when to read it again. A server
// re-runs at most LIVE_MAX_RERUNS_PER_SECOND bindings a second; past that, a
// binding's stored result is held until the next second (live_current). Writes
// between two reads cost one re-run, however many there were. While the
// source runs, the tables it reads join the binding's read set (`live_reads`).
// While a server renders a page, the view's reads are noted for the page's
// resume state (`resume`).
state: fn<T: [Encode, Decode], E: [Encode, Decode]>(binding: Live<T, E>) -> Loadable<T, E> Never! {
    resume_note(binding.id)
    now: rt.clock_mono_ns()
    seen: live_current(binding.id, now)
    if seen.value == .Val(text) {
        if live_value_state<T, E>(text) == .Val(current) -> return current
    }
    value: live_run(binding) ?? {
        if live_json.to_string<E>(err) == .Ok(encoded) {
            live_store(binding.id, "err:{encoded}", now, Val(seen.generation))
        }
        return Loadable.Failed(err)
    }
    if live_json.to_string<T>(value) == .Ok(encoded) {
        live_store(binding.id, "ok:{encoded}", now, Val(seen.generation))
    }
    Loadable.Loaded(value)
}

// Runs `binding`'s source as this task's running binding, so the reads it
// makes join the binding's read set, and as the caller that made the
// binding, whoever reads it now. The screen addresses the run asked
// `presence` of become the ones its caller is present at (live_presence_settle).
live_run: fn<T: [Encode, Decode], E: [Encode, Decode]>(binding: Live<T, E>) -> T E! {
    me: tasks.current_task()
    live_run_begin(me, binding.id)
    acting_begin(me, binding.acting.copy())
    value: binding.run() ?? {
        acting_end(me)
        live_presence_settle(binding.id, binding.acting, live_run_end(me))
        return Err(err)
    }
    acting_end(me)
    live_presence_settle(binding.id, binding.acting, live_run_end(me))
    Ok(value)
}

// `socket`, a server-side WebSocket connection, receives
// `{"live":"invalidate","binding":<id>}` each time `binding` is invalidated,
// starting with the latest such event when there was one. While the binding
// is held (live_store), the event carries `"after_ms":<n>`: a read in the
// next n milliseconds gets the held stale result, so the client reads again
// after them, and the binding's first current result after the hold sends the
// event again. A connection receives only the bindings its handler watches;
// the handler holds `binding` because it read it for its own caller under
// that caller's policy. Once the last connection watching `binding` closes,
// its caller is present nowhere through it (__live_left_settle).
watch: fn<T: [Encode, Decode], E: [Encode, Decode]>(socket: WsConn, binding: Live<T, E>) -[Net]> Never! {
    ws.__live_watch(socket, "live:{binding.id}")
}

// `changes` counts stored results that differed from the one before;
// `ws_pushes` counts the publishes to the WebSocket live hub: one per
// `invalidate` that marked a binding, and one per hold's start and end;
// `capped` counts the re-runs the per-second cap held over.
live_stats: fn() -> String Never! {
    registry: live_decode(live_cell_load()) ?? return "LiveStats(error=live registry unavailable)"
    "LiveStats(queries={live_query_count(registry)}, limit={LIVE_MAX_QUERIES}, evictions={registry.evictions}, invalidations={registry.invalidations}, changes={registry.changes}, ws_pushes={registry.ws_pushes}, reruns_per_second={LIVE_MAX_RERUNS_PER_SECOND}, capped={registry.capped})"
}

// The live bindings of `registry`; sync's session records are not queries.
live_query_count: fn(registry: LiveRegistry) -> Int {
    count := 0
    loop record in registry.records {
        if record.source != LIVE_SYNC_SOURCE -> count += 1
    }
    count
}

// `live(source, args...)`: `args` are the encoded arguments. The binding
// runs as this task's caller.
__live_bind: fn<T: [Encode, Decode], E: [Encode, Decode]>(source: String, args: [String], run: &&fn() -[DB.Read, Net, Time]> T E!) -> Live<T, E> Never! {
    acting: acting_now(tasks.current_task())
    Live<T, E>{id: live_register(source, live_key(args), acting_tag(acting), 0), run: run, acting: acting}
}

// `subscribe(source, args..., every:)`: a binding polled every `every`.
__live_poll: fn<T: [Encode, Decode], E: [Encode, Decode]>(source: String, args: [String], every: Duration?, run: &&fn() -[DB.Read, Net, Time]> T E!) -> Live<T, E> Never! {
    every_ns := 0
    if every == .Val(interval) && interval.ns > 0 -> every_ns = interval.ns
    acting: acting_now(tasks.current_task())
    Live<T, E>{id: live_register(source, live_key(args), acting_tag(acting), every_ns), run: run, acting: acting}
}

// `push(source, args..., value:)` stores `value` as that binding's result,
// registering the binding when nothing has read it yet. Only the binding of
// this task's caller gets it: a value one caller computed never reaches
// another's binding.
__live_push: fn<T: Encode>(source: String, args: [String], value: T) Never! {
    encoded: live_json.to_string<T>(value) ?? return
    key: live_key(args)
    id: live_register(source, key, acting_tag(acting_now(tasks.current_task())), 0)
    live_store(id, "ok:{encoded}", -1, None)
}

// `invalidate(source, args...)`: exactly that argument list re-runs.
__live_invalidate: fn(source: String, args: [String]) Never! {
    live_invalidate(source, Val(live_key(args)), None, 0)
}

// `invalidate(source)`: every binding of `source` re-runs.
__live_invalidate_all: fn(source: String) Never! { live_invalidate(source, None, None, 0) }

// One argument's part of a binding's identity, and one argument of a queued
// job's call: the argument encoded, or `_`, which no JSON reads, when it
// doesn't encode, so a job given it fails each run.
__live_arg: fn<A: Encode>(value: A) -> String Never! { live_json.to_string<A>(value) ?? "_" }

// A binding's read set, for core.db: while a task runs a binding's source,
// each table it reads joins that binding's read set, so a write to the table
// re-runs the binding as it re-runs the table's own bindings. A read the
// compiler narrowed to the rows a SQL condition holds for joins it as the
// table narrowed so, `<source>?<condition and values as a JSON list>`, and a
// write re-runs it only when the condition holds for a row the write changed.
priv(package) live_reads: module {
    // Whether this task is running a binding's source, so a database read
    // it makes belongs to that binding's read set.
    running: fn() -> Bool Never! { live_running(tasks.current_task()) != None }

    // Adds `source` (a table's `core.db.live:<table>`) to the read set of
    // the binding this task runs. Recorded before the read runs, so a write
    // committed after the read always reaches the binding.
    record: fn(source: String) Never! { live_read_record(source, source) }

    // Adds `source` narrowed by the SQL `condition` over a stored row, with
    // `values` bound to its `?`s in order, to the read set of the binding
    // this task runs, unless it read all of `source` already.
    record_where: fn(source: String, condition: String, values: [String]) Never! {
        fields := [String]{condition.copy()}
        fields.extend(values.copy())
        encoded: live_json.to_string<[String]>(fields) ?? return live_read_record(source, source)
        live_read_record(source, "{source}?{encoded}")
    }

    // The narrowed reads of `source` in the bindings' read sets, each once:
    // its read-set entry, its condition and the values it binds.
    narrowed: fn(source: String) -> [{entry: String, condition: String, values: [String]}] Never! {
        out := [{entry: String, condition: String, values: [String]}]{}
        registry: live_decode(live_cell_load()) ?? return out
        prefix: "{source}?"
        seen := [String]{}
        loop record in registry.records {
            loop read in record.reads {
                if !read.starts_with(prefix) || seen.contains(read) -> next
                seen.push(read.copy())
                tree: live_json.parse(read.slice(prefix.len(), read.len())) ?? next
                fields: tree.decode<[String]>() ?? next
                if fields.len() == 0 -> next
                values := [String]{}
                loop at in 1..<fields.len() -> values.push(fields[at].copy())
                out.push({entry: read.copy(), condition: fields[0].copy(), values: values})
            }
        }
        out
    }

    // Marks for a re-run every binding of `source`, every binding that read
    // all of it, and every one whose read set holds one of the narrowed reads
    // `held` (`narrowed`): those whose condition holds for a changed row.
    invalidate: fn(source: String, held: [String]) Never! {
        live_invalidate(source, None, Val(held), 0)
    }
}

// Adds `entry`, a read of `source`, to the read set of the binding this task
// runs (`live_reads`), unless that binding is `source`'s own or read all of
// `source` already.
live_read_record: fn(source: String, entry: String) {
    id: live_running(tasks.current_task()) ?? return
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return
        index: live_index(registry, id) ?? return
        reads: registry.records[index].reads
        if registry.records[index].source == source || reads.contains(source) || reads.contains(entry) {
            return
        }
        registry.records[index].reads.push(entry.copy())  // copy: a lost race retries with the same entry
        if live_cell_replace(seen, live_encode(registry)) {
            return
        }
    }
}

// The bindings whose sources are running now, each with its task and the
// screen addresses its run asked `presence` of so far; a source that reads
// another binding stacks that binding on its own.
LiveRun: struct {
    task: TaskID,
    id: Int,
    asked: [String]
}

LiveRunning: struct {
    runs: [LiveRun]
}

LIVE_RUNNING: Shared{LiveRunning{runs: [LiveRun]{}}}

live_run_begin: fn(task: TaskID, id: Int) {
    running := LIVE_RUNNING.guard_edit()
    running.value.runs.push(LiveRun{task: task, id: id, asked: [String]{}})
}

// Ends `task`'s innermost run and gives the addresses it asked `presence` of.
live_run_end: fn(task: TaskID) -> [String] {
    running := LIVE_RUNNING.guard_edit()
    at := running.value.runs.len()
    loop at > 0 {
        at -= 1
        if task == running.value.runs[at].task {
            asked: running.value.runs[at].asked.copy()
            _: running.value.runs.remove(at, .Slot)
            return asked
        }
    }
    [String]{}
}

// Adds `address` to what the run of `task`'s innermost binding asked
// `presence` of; false when `task` runs no binding.
live_presence_ask: fn(task: TaskID, address: String) -> Bool {
    running := LIVE_RUNNING.guard_edit()
    at := running.value.runs.len()
    loop at > 0 {
        at -= 1
        if task == running.value.runs[at].task {
            if !running.value.runs[at].asked.contains(address) {
                running.value.runs[at].asked.push(address.copy())
            }
            return true
        }
    }
    false
}

// One account present at a screen address: the latest run of the live
// binding `binding`, acting for `account`, asked `presence` of `address`.
AppPresent: struct {
    binding: Int,
    account: String,
    address: String
}

APP_PRESENT: Shared{[AppPresent]{}}

// The read-set source of who is present at a screen address: a binding
// that asked `presence` of the address reads it, so a change of who is
// present there re-runs the binding.
LIVE_PRESENCE_SOURCE: "app.presence:"

// Makes `asked`, the addresses the run of binding `id` that just ended asked
// `presence` of, the ones its account (`acting`) is present at, and re-runs
// every other binding that reads one whose accounts changed. A run that
// asked none, such as one a row policy refused before it asked, leaves its
// account present nowhere through this binding.
live_presence_settle: fn(id: Int, acting: Acting?, asked: [String]) {
    account: if acting == .Val(.Account(who)) -> who.raw() else -> ""
    changed: live_presence_keep(id, account, asked)
    loop address in changed -> live_invalidate("{LIVE_PRESENCE_SOURCE}{address}", None, None, id)
}

// Makes `asked` the addresses `account` is present at through binding `id`
// (none when `account` is ""), and gives each address whose accounts that
// changes.
live_presence_keep: fn(id: Int, account: String, asked: [String]) -> [String] {
    changed := [String]{}
    had := [String]{}
    held := APP_PRESENT.guard_edit()
    kept := [AppPresent]{}
    loop entry in held.value {
        mine: entry.binding == id
        if mine && (account == "" || entry.account != account || !asked.contains(entry.address)) {
            changed.push(entry.address.copy())
            next
        }
        if mine -> had.push(entry.address.copy())
        kept.push(entry.copy())
    }
    loop address in asked {
        if account == "" || had.contains(address) -> next
        kept.push(AppPresent{binding: id, account: account.copy(), address: address.copy()})
        changed.push(address.copy())
    }
    held.value = kept
    changed
}

// The accounts present at `address`, sorted, each once: those of the
// registered bindings whose latest run asked `presence` of it, and
// `asking`, the account of the run asking now (none when ""). A binding
// whose last watching connection closed is not among them (__live_left_settle).
live_present: fn(address: String, asking: String) -> [auth.AccountID] {
    __live_left_settle()
    names := [String]{}
    if asking != "" -> names.push(asking.copy())
    registry: live_decode(live_cell_load())
    held: APP_PRESENT.guard_read()
    loop entry in held.value {
        if entry.address != address || names.contains(entry.account) -> next
        if registry == .Val(bindings) && live_index(bindings, entry.binding) == None -> next
        names.push(entry.account.copy())
    }
    names.sort()
    out := [auth.AccountID]{}
    loop name in names -> out.push(auth.AccountID.from_string(name))
    out
}

// The leave signal of the WebSocket live hub: each binding whose last
// watching connection (`watch`) closed since the last call is present
// nowhere (live_left). A server runs this once each upgraded connection's
// handler returns, and every presence read runs it first, so a closed
// session is never counted.
__live_left_settle: fn() Never! { live_left(rt_web.live_left()) }

// Ends the presence of each binding `topics` names, one hub topic
// (`live:<id>`, `watch`'s) per line, and re-runs every binding that reads an
// address it was present at. That binding re-runs too: a connection that
// watches it again first receives its event, so the client reads it, and
// the run asks again, counting its account.
priv live_left: fn(topics: String) Never! {
    loop topic in topics.split("\n") {
        if !topic.starts_with("live:") -> next
        id: Int.parse(topic.slice(5, topic.len())) ?? next
        changed: live_presence_keep(id, "", [String]{})
        loop address in changed -> live_invalidate("{LIVE_PRESENCE_SOURCE}{address}", None, None, 0)
    }
}

// The binding `task` is running now, the innermost when it runs several.
live_running: fn(task: TaskID) -> Int? {
    running := LIVE_RUNNING.guard_edit()
    at := running.value.runs.len()
    loop at > 0 {
        at -= 1
        if running.value.runs[at].task == task -> return Val(running.value.runs[at].id)
    }
    None
}

// A page's resume state. While a task renders a page (`resume.render`),
// each binding its view reads (`state`) is noted, but not one a source
// reads while it runs. The page then carries each noted binding's source
// wire name, encoded arguments and stored result. A client that resumes the
// page (`resume.seed`) stores those results as its own bindings' results,
// so its first `state` of each gives the server's result and runs no source:
// the client does not run the view's reads again to rebuild the page.
priv(package) resume: module {
    // The HTML `view` gives, rendered as this task's page, then the resume
    // script of the reads it made: `<script type="application/json"
    // id="jet-resume">` holding a JSON list of `{source, key, value}`, each
    // `<` written `\u003c`. A read with no stored result, or one a write made
    // stale since, is left out, so the client runs that one itself.
    render: fn(view: fn() -> String Never!) -> String Never! {
        me: tasks.current_task()
        resume_begin(me)
        body: view()
        "{body}{resume_script(resume_end(me))}"
    }

    // Stores the results the resume script of the served page `page`
    // carries as the bindings of this task's caller, and gives how many it
    // stored.
    seed: fn(page: String) -> Int Never! {
        start: page.find(RESUME_OPEN)
        if start < 0 -> return 0
        rest: page.slice(start + RESUME_OPEN.len(), page.len())
        end: rest.find("</script>")
        if end < 0 -> return 0
        reads: live_json.decode<[AppResumed]>(rest.slice(0, end)) ?? return 0
        caller: acting_tag(acting_now(tasks.current_task()))
        stored := 0
        loop read in reads {
            id: live_register(read.source, read.key, caller, 0)
            if id == 0 -> next
            live_store(id, read.value, -1, None)
            stored += 1
        }
        stored
    }
}

priv RESUME_OPEN: "<script type=\"application/json\" id=\"jet-resume\">"

// One read a page carries: its binding's source wire name, encoded
// argument list and stored result (`ok:` or `err:`, then its JSON).
priv AppResumed: struct {
    source: String,
    key: String,
    value: String
}

// The bindings a task rendering a page or opening a screen (`App.__go`)
// read, in first-read order.
priv AppResumeReads: struct {
    task: TaskID,
    ids: [Int]
}

priv APP_RESUME_READS: Shared{[AppResumeReads]{}}

priv resume_begin: fn(task: TaskID) Never! {
    held := APP_RESUME_READS.guard_edit()
    held.value.push(AppResumeReads{task: task, ids: [Int]{}})
}

// Ends `task`'s innermost page and gives the bindings its view read.
priv resume_end: fn(task: TaskID) -> [Int] Never! {
    held := APP_RESUME_READS.guard_edit()
    at := held.value.len()
    loop at > 0 {
        at -= 1
        if task == held.value[at].task {
            ids: held.value[at].ids.copy()
            _: held.value.remove(at, .Slot)
            return ids
        }
    }
    [Int]{}
}

// Notes that this task's page or screen read binding `id`, when this task
// renders a page or opens a screen and runs no binding's source.
priv resume_note: fn(id: Int) Never! {
    if !resume_rendering() {
        return
    }
    me: tasks.current_task()
    if live_running(me) != None {
        return
    }
    held := APP_RESUME_READS.guard_edit()
    at := held.value.len()
    loop at > 0 {
        at -= 1
        if held.value[at].task != me -> next
        if !held.value[at].ids.contains(id) -> held.value[at].ids.push(id)
        return
    }
}

// Whether any task renders a page now, so a read outside one costs one
// look at an empty list.
priv resume_rendering: fn() -> Bool Never! {
    held: APP_RESUME_READS.guard_read()
    held.value.len() != 0
}

// The resume script of the bindings `ids`: each one's stored result, when
// it has one and no write made it stale.
priv resume_script: fn(ids: [Int]) -> String Never! {
    reads := [AppResumed]{}
    registry: live_decode(live_cell_load()) ?? return "{RESUME_OPEN}[]</script>"
    loop id in ids {
        index: live_index(registry, id) ?? next
        record: registry.records[index]
        if record.value == "" || record.dirty -> next
        reads.push(AppResumed{source: record.source.copy(), key: record.key.copy(), value: record.value.copy()})
    }
    text: live_json.to_string<[AppResumed]>(reads) ?? "[]"
    "{RESUME_OPEN}{text.replace("<", "\\u003c")}</script>"
}

// Whom a task acts for. `as_caller` runs a function for an account and
// `as_system` for the server itself. A task that runs neither acts for no
// one, and so does a task another one spawns: a caller never passes to
// another task. A guarded core.db table asks its row policy as this caller,
// and as no one, never as the system, when there is none. A live binding
// runs as the caller that made it.
Acting: enum {
    Account(auth.AccountID),
    System
}

// The runs of `as_caller`, `as_system` and binding sources, each with its
// task and the caller it acts for (None: no one); a task's innermost run
// names its caller.
ActingRun: struct {
    task: TaskID,
    acting: Acting?
}

ActingRuns: struct {
    runs: [ActingRun]
}

ACTING: Shared{ActingRuns{runs: [ActingRun]{}}}

// Runs `run` acting for the account `account` and gives what it gives; the
// account is `maybe_caller()` within it. `run` handles its own failures, so
// a caller with any failure contract may call this.
as_caller: fn<R>(account: auth.AccountID, run: fn() -> R Never!) -> R Never! {
    acting_within(Val(Acting.Account(account.copy())), run)
}

// Runs `run` acting for the server itself, which no row policy limits, and
// gives what it gives. A job or a schedule that reads every row runs so; a
// request never does.
as_system: fn<R>(run: fn() -> R Never!) -> R Never! { acting_within(Val(Acting.System), run) }

// The account this task acts for: None when it acts for the system or for
// no one.
maybe_caller: fn() -> auth.AccountID? Never! {
    if acting_now(tasks.current_task()) == .Val(.Account(account)) -> return Val(account)
    None
}

// The account this task acts for, where a caller is certain: the compiler
// accepts a call only on a path that starts at an `#App.SignedIn` method or
// inside `as_caller`. A path the compiler can't follow (a function value
// another task runs) that reaches it acting for no account stops here.
caller: fn() -> auth.AccountID Never! {
    maybe_caller() ?? panic("app.caller() ran acting for no account")
}

priv acting_within: fn<R>(acting: Acting?, run: fn() -> R Never!) -> R Never! {
    me: tasks.current_task()
    acting_begin(me, acting)
    defer acting_end(me)
    run()
}

priv acting_begin: fn(task: TaskID, acting: Acting?) {
    runs := ACTING.guard_edit()
    runs.value.runs.push(ActingRun{task: task, acting: acting})
}

priv acting_end: fn(task: TaskID) {
    runs := ACTING.guard_edit()
    at := runs.value.runs.len()
    loop at > 0 {
        at -= 1
        if task == runs.value.runs[at].task {
            _: runs.value.runs.remove(at, .Slot)
            return
        }
    }
}

// The caller `task` acts for now: None for no one.
priv acting_now: fn(task: TaskID) -> Acting? {
    runs := ACTING.guard_edit()
    at := runs.value.runs.len()
    loop at > 0 {
        at -= 1
        if runs.value.runs[at].task == task -> return runs.value.runs[at].acting.copy()
    }
    None
}

// A binding's registry name for the caller `acting`: empty for no one.
priv acting_tag: fn(acting: Acting?) -> String {
    if acting == {
        .Val(.Account(account)) -> "account:{account.raw()}"
        .Val(.System) -> "system"
        .None -> ""
    }
}

// The caller this task acts for, for core.db's row policies.
priv(package) callers: module {
    // Whether this task acts for the system.
    system: fn() -> Bool Never! {
        if acting_now(tasks.current_task()) == .Val(.System) -> return true
        false
    }

    // The account this task acts for: None for the system or no one.
    account: fn() -> auth.AccountID? Never! { maybe_caller() }

    // This task acts for the system until `end`, as a row policy's own
    // reads do.
    begin_system: fn() Never! { acting_begin(tasks.current_task(), Val(Acting.System)) }

    // This task acts for `account` until `end`, as a signed-in call does.
    begin_account: fn(account: auth.AccountID) Never! {
        acting_begin(tasks.current_task(), Val(Acting.Account(account)))
    }

    // Ends this task's innermost `begin_system` or `begin_account`.
    end: fn() Never! { acting_end(tasks.current_task()) }
}

#Test("a task acts for its innermost run's caller, and a task it spawns for no one") {
    ann: auth.AccountID.from_string("ann")
    ben: auth.AccountID.from_string("ben")
    assert_eq(maybe_caller(), auth.AccountID?{None})
    seen: as_caller<String>(ann, fn() {
        assert(as_system(fn() { callers.system() }))
        assert_eq(as_system(fn() { maybe_caller() }), auth.AccountID?{None})
        nested: auth.AccountID.from_string("ben")
        assert_eq(as_caller(nested, fn() { maybe_caller() }), Val(nested))
        spawned: task { (maybe_caller() ?? auth.AccountID.from_string("no one")).raw() }
        assert_eq(spawned.join() ?? panic("the spawned task runs"), "no one")
        assert(!callers.system())
        (maybe_caller() ?? auth.AccountID.from_string("no one")).raw()
    })
    assert_eq(seen, "ann")
    assert_eq(maybe_caller(), auth.AccountID?{None})
    as_caller(ben.copy(), fn() {
        assert_eq(maybe_caller(), Val(ben))
        assert_eq(caller(), ben)
        assert(!callers.system())
    })
    assert_eq(maybe_caller(), auth.AccountID?{None})
    assert_eq(acting_tag(Val(Acting.Account(ann))), "account:ann")
    assert_eq(acting_tag(None), "")
}

// A call of a mounted service's method runs as one transaction on each
// store it uses. The framework opens the call on the task that runs it
// (`transactions.begin`); core.db begins an IMMEDIATE transaction on a
// store's connection at the call's first statement there and joins it to the
// call (`join`); `end` commits every joined transaction or rolls each back.
// A method the call reaches, and a row policy it asks, run on the same task
// and so in the same transaction; a task the call spawns is outside it. A
// store that can't begin or commit marks the call refused, and the framework
// then runs it again. A webhook's call carries its delivery (`deliver`),
// whose ID core.db records in each store's transaction as the call joins
// it; a store that has run the delivery already marks the call repeated, and
// the framework rolls it back and drops the delivery. A schedule's call
// carries its due run (`schedule`), which core.db records the same way, so
// a run another server has done is dropped as well. A remote call that
// carries a request key (`ask`) gives its reply (`answer`), which `end`
// keeps under the key in the first store the call joined: in that store's
// transaction when the call commits, and on its own after the call rolls
// back. A store that keeps a reply under the key of a call that joins it
// gives the call that reply and marks it repeated, so the framework rolls
// the call back and answers with the kept reply. A job the call queues
// (`enqueue`) waits for it: `end` keeps the job in the outbox of the first
// store the call joined, in that store's transaction, under a key of its
// own, and once the call commits, runs it on a task of its own (`job_run`);
// a call that rolls back drops its jobs with its writes. Each run of a job
// carries its key as its delivery, so a store that has run the job drops a
// second run of it.
priv CallJoin: struct {
    // Commits (true) or rolls back (false) one store's transaction; false
    // when it couldn't do as asked.
    end: fn(Bool) -[]> Bool Never!,
    outbox: CallOutbox
}

// One store's outbox: the jobs committed calls queued there that haven't
// run yet, a row each, found by the job's key. Each row is taken until a
// time (Unix milliseconds): the server that runs its job takes it again
// each tick while the job runs (`hold`), and once that time has passed, a
// serving server takes the row (`take`) and runs the job again, as when the
// server that ran it stopped. It also keeps the replies of calls that
// carried a request key (`answered`).
priv CallOutbox: struct {
    // Names the store among the open ones: the database file's path, or
    // one of its own for an in-memory database.
    store: String,
    // The time it is by the store's clock, the one its engine reads for
    // SQL's `'now'`, in Unix milliseconds.
    now: fn() -[]> Int Never!,
    // Keeps job `name` with its encoded arguments, in the transaction of
    // the call this task runs, taken until `until`; the job's key, a new
    // random one, or "" when the store couldn't keep it.
    keep: fn(String, String, Int) -[]> String Never!,
    // Deletes the row of key `key`, in the transaction of the call this
    // task runs, as its job runs there: 1; 0 when the row has gone, as
    // another run did the job; -1 when the store couldn't delete it.
    done: fn(String) -[]> Int Never!,
    // Records on the row of key `key` that its job ran `runs` times and
    // failed each time, the last with `error`, and takes it until `until`;
    // false when the store couldn't.
    failed: fn(String, Int, String, Int) -[]> Bool Never!,
    // Takes each row of a job named in `names` that is not taken at `now`,
    // until `until`, and gives each; None once the store has closed.
    take: fn([String], Int, Int) -[]> [CallQueued]? Never!,
    // Takes the rows of keys `keys` until `until`; false when the store
    // couldn't.
    hold: fn([String], Int) -[]> Bool Never!,
    // Keeps the reply of request `request`, in the transaction of call
    // `call`, or on its own for call 0 (after the call rolled back); false
    // when the store couldn't.
    answered: fn(Int, CallRequest, String) -[]> Bool Never!
}

// A row a server took from a store's outbox: its job's key, name and
// encoded arguments, and the runs the job made so far, each failed.
priv CallQueued: struct {
    key: String,
    name: String,
    args: String,
    runs: Int
}

// The function that decodes a job's arguments and runs it, which replies
// `{"err":...}` when the job failed. Copies share the one function.
priv CallJobCall: struct {
    call: fn(RemoteArgs) -> String [FieldError]!
}

// A job a call queued: its name (`<service module>.<Service>.<method>`), its
// arguments as one encoded JSON array, the runs it gets after a first that
// fails, and the function that runs it.
priv CallJob: struct {
    name: String,
    args: String,
    retries: Int,
    run: Shared<CallJobCall>
}

// A webhook delivery a call runs: the ID its sender gives it, the same each
// time it is delivered again, and the second (since the Unix epoch) the
// server received it.
#Equatable
priv CallDelivery: struct {
    id: String,
    at: Int
}

// A schedule's run a call is: the schedule's name (`<service
// module>.<Service>.<method>`) and the second (since the Unix epoch) it was
// due.
#Equatable
priv CallTick: struct {
    schedule: String,
    due: Int
}

// The request key of a remote call: the account the call acts for ("" for
// none), the key the client gave the call, the same each time it sends the
// call again, and the second (since the Unix epoch) the server received it.
// The account scopes the key, so one account's key never answers another's.
#Equatable
priv CallRequest: struct {
    account: String,
    key: String,
    at: Int
}

priv CallRun: struct {
    task: TaskID,
    id: Int,
    joins: [CallJoin],
    refused: Bool,
    delivery: CallDelivery?,
    tick: CallTick?,
    request: CallRequest?,
    reply: String?,
    repeated: Bool,
    jobs: [CallJob]
}

priv CallRuns: struct {
    runs: [CallRun],
    made: Int
}

priv CALLS: Shared{CallRuns{runs: [CallRun]{}, made: 0}}

priv(package) transactions: module {
    // The times a call runs, in all, while a busy store refuses it. Each
    // refusal has already waited out the store's busy timeout, so the
    // attempts need no wait of their own.
    attempts: fn() -> Int Never! { 5 }

    // Opens a call on this task and gives its number; None when the task
    // runs one already, which the new call then belongs to.
    begin: fn() -> Int? Never! {
        me: tasks.current_task()
        runs := CALLS.guard_edit()
        loop run in runs.value.runs {
            if run.task == me -> return None
        }
        runs.value.made += 1
        runs.value.runs.push(CallRun{task: me, id: runs.value.made, joins: [CallJoin]{}, refused: false, delivery: None, tick: None, request: None, reply: None, repeated: false, jobs: [CallJob]{}})
        Val(runs.value.made)
    }

    // The call this task runs, by number; None outside one.
    current: fn() -> Int? Never! {
        me: tasks.current_task()
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.task == me -> return Val(run.id)
        }
        None
    }

    // Joins one store's transaction, which `end` finishes, and that store's
    // outbox to call `call`.
    join: fn(call: Int, end: &&fn(Bool) -[]> Bool Never!, outbox: &&CallOutbox) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call {
                runs.value.runs[index].joins.push(CallJoin{end: end.move(), outbox: outbox.move()})
                return
            }
        }
    }

    // Queues `job` in call `call`, to run once the call commits.
    enqueue: fn(call: Int, job: &&CallJob) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call {
                runs.value.runs[index].jobs.push(job.move())
                return
            }
        }
    }

    // Marks call `call` refused: a store it uses was busy.
    refuse: fn(call: Int) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call -> runs.value.runs[index].refused = true
        }
    }

    // Whether a store refused call `call`.
    refused: fn(call: Int) -> Bool Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.refused
        }
        false
    }

    // Gives call `call` the webhook delivery it runs.
    deliver: fn(call: Int, delivery: CallDelivery) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call {
                runs.value.runs[index].delivery = Val(delivery.copy())
            }
        }
    }

    // The webhook delivery call `call` runs; None for any other call.
    delivery: fn(call: Int) -> CallDelivery? Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.delivery.copy()
        }
        None
    }

    // Gives call `call` the schedule's run it is.
    schedule: fn(call: Int, tick: CallTick) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call -> runs.value.runs[index].tick = Val(tick.copy())
        }
    }

    // The schedule's run call `call` is; None for any other call.
    tick: fn(call: Int) -> CallTick? Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.tick.copy()
        }
        None
    }

    // Gives call `call` the request key it carries.
    ask: fn(call: Int, request: CallRequest) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call {
                runs.value.runs[index].request = Val(request.copy())
            }
        }
    }

    // The request key call `call` carries; None for a call that carries none.
    request: fn(call: Int) -> CallRequest? Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.request.copy()
        }
        None
    }

    // Gives call `call` its reply: the one a store kept under its request
    // key already, which a store gives as the call joins it, or else the one
    // its run gave, which `end` keeps under that key. The first reply the
    // call is given stands.
    answer: fn(call: Int, reply: String) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call && runs.value.runs[index].reply == None {
                runs.value.runs[index].reply = Val(reply.copy())
            }
        }
    }

    // Call `call`'s reply (`answer`); None before it has one.
    reply: fn(call: Int) -> String? Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.reply.copy()
        }
        None
    }

    // Marks call `call` repeated: a store it uses has run its delivery or
    // its schedule's run, or keeps a reply under its request key.
    repeat: fn(call: Int) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call -> runs.value.runs[index].repeated = true
        }
    }

    // Whether a store has run call `call`'s delivery or schedule's run
    // already, or keeps a reply under its request key.
    repeated: fn(call: Int) -> Bool Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.repeated
        }
        false
    }

    // Ends call `call`: commits each joined transaction, in the order the
    // call joined them, when `commit` holds and no store refused the call or
    // had run its delivery, and otherwise rolls each back. A call that
    // carries a request key keeps its reply (`calls_answered`) in the first
    // store's transaction before the commits, or on its own once a run that
    // failed has rolled back. False when the call has to run again: a store
    // refused it, the first store couldn't keep its jobs or its reply, or the
    // first commit failed (and was rolled back). A call that writes two
    // stores commits each on its own; once one has committed, a later failed
    // commit can't undo it, so the call stands, and its jobs run. A call
    // that joined no store runs its jobs as it ends, and keeps no reply.
    end: fn(call: Int, commit: Bool) -> Bool Never! {
        ended := calls_take(call) ?? return true
        if ended.refused || ended.repeated || !commit {
            loop joined in ended.joins -> _: joined.end(false)
            if !ended.refused && !ended.repeated -> _: calls_answered(ended, 0)
            return !ended.refused
        }
        keys := [String]{}
        if ended.joins.len() > 0 {
            loop job in ended.jobs {
                key: ended.joins[0].outbox.keep(job.name, job.args, ended.joins[0].outbox.now() + JOB_HOLD_MS)
                if key == "" {
                    loop joined in ended.joins -> _: joined.end(false)
                    return false
                }
                keys.push(key)
            }
        }
        if !calls_answered(ended, call) {
            loop joined in ended.joins -> _: joined.end(false)
            return false
        }
        loop (index, joined) in ended.joins {
            if joined.end(true) || index > 0 -> next
            loop rest in 1..<ended.joins.len() -> _: ended.joins[rest].end(false)
            return false
        }
        // The blobs the call kept stay once it ends (`uploads_finish`).
        uploads_committed(call)
        if ended.joins.len() == 0 {
            loop job in ended.jobs.move() -> job_start(job, "", None, 0)
            return true
        }
        // The jobs' runs share the first store's outbox.
        first := ended.joins.remove(0, .Slot) ?? return true
        outbox: jobs_store(first.outbox.move(), false)
        at := 0
        loop job in ended.jobs.move() {
            job_start(job, keys[at].copy(), Val(outbox.copy()), 0)
            at += 1
        }
        true
    }
}

// Removes call `call` from the open calls and gives it.
priv calls_take: fn(call: Int) -> CallRun? Never! {
    runs := CALLS.guard_edit()
    loop index in 0..<runs.value.runs.len() {
        if runs.value.runs[index].id == call -> return runs.value.runs.remove(index, .Slot)
    }
    None
}

// Keeps `run`'s reply under its request key in the first store it joined,
// in call `call`'s transaction there, or on its own for call 0; true when
// the run carries no key, has no reply or joined no store.
priv calls_answered: fn(run: &CallRun, call: Int) -> Bool Never! {
    if run.joins.len() == 0 -> return true
    if run.request == .Val(request) {
        if run.reply == .Val(reply) -> return run.joins[0].outbox.answered(call, request, reply)
    }
    true
}

// A device an account registered for pushes: its push service (`apns`,
// `fcm` or `web`), the service's token for it (for Web Push, the
// subscription's endpoint URL) and, for Web Push only, the subscription's
// P-256 public key and authentication secret, base64url.
priv PushDevice: struct {
    account: String,
    service: String,
    token: String,
    key: String,
    auth: String
}

// One store's push devices, which core.db keeps in the table
// `__jet_push_devices` and names as the store opens (`push.store`). A
// device is found by its service and token.
priv PushDevices: struct {
    // Names the store among the open ones, as CallOutbox.store does.
    store: String,
    // Registers a device in place of the one with its service and token;
    // false when the store couldn't.
    add: fn(PushDevice) -[]> Bool Never!,
    // The devices the account registered; None when the store couldn't
    // read them, as once it has closed.
    of: fn(String) -[]> [PushDevice]? Never!,
    // Forgets the device of a service and a token; false when the store
    // couldn't.
    forget: fn(String, String) -[]> Bool Never!
}

priv PushRegistry: struct {
    stores: [Shared<PushDevices>]
}

priv PUSH_REGISTRY: Shared{PushRegistry{stores: [Shared<PushDevices>]{}}}

// The devices accounts register for pushes. core.db names each database
// file as it opens (`store`). A device registers in the first store named
// that takes it, which is the app's first store still open; a push goes to
// the devices any named store holds.
priv(package) push: module {
    // Names a store; a store named again replaces the one of its name.
    store: fn(devices: &&PushDevices) Never! {
        registry := PUSH_REGISTRY.guard_edit()
        loop index in 0..<registry.value.stores.len() {
            if push_store_name(registry.value.stores[index]) == devices.store {
                registry.value.stores[index] = Shared{devices.move()}
                return
            }
        }
        registry.value.stores.push(Shared{devices.move()})
    }

    // Registers `device` in the first named store that takes it; false
    // when none does.
    register: fn(device: PushDevice) -> Bool Never! {
        loop devices in push_stores() {
            held: devices.guard_read()
            if held.value.add(device.copy()) -> return true
        }
        false
    }

    // The devices the account `account` registered, each once.
    devices: fn(account: String) -> [PushDevice] Never! {
        found := [PushDevice]{}
        loop devices in push_stores() {
            held: devices.guard_read()
            listed: held.value.of(account.copy()) ?? next
            loop device in listed {
                if !push_device_listed(found, device) -> found.push(device.copy())
            }
        }
        found
    }

    // Forgets the device of `service` and `token` in each named store, as
    // its push service says it is gone.
    forget: fn(service: String, token: String) Never! {
        loop devices in push_stores() {
            held: devices.guard_read()
            _: held.value.forget(service.copy(), token.copy())
        }
    }

    // Sets up the push services `settings` names, in place of the ones set
    // up before.
    configure: fn(settings: push_wire.PushSettings) -[FS.Read, Net]> push_wire.PushError! {
        push_wire.push_configure(settings)
    }

    // The last pushes skipped or failed, oldest first: `skipped <service>
    // <account>: <reason>` or `failed …`.
    outcomes: fn() -> [String] Never! {
        held: PUSH_NOTES.guard_read()
        held.value.last.copy()
    }
}

// The pushes skipped and failed since the process started, and the last
// C_PUSH_NOTES_KEPT of them.
priv PushNotes: struct {
    skipped: Int,
    failed: Int,
    last: [String]
}

priv PUSH_NOTES: Shared{PushNotes{skipped: 0, failed: 0, last: [String]{}}}

priv C_PUSH_NOTES_KEPT: 32

// The app graph: the services its clients call, the screens every target
// shows, each at the address of the state it opens, and whether a device
// queues the writes it can't send. `new` starts it, `.api<S>(path)` declares
// the service `S` the clients reach at `path`, `.mount(service)` answers
// `S`'s calls in this process, `.screen` adds a screen and `.offline` sets
// the queue. Every target runs this one graph, so its screens are every
// target's route set, and each `app.Remote<S>` a screen's view takes is the
// graph's Remote of `S`. The graph is the process's: each copy of an App,
// and the members that take none, read and change that one graph. The
// compiler lowers `.api`, `.mount`, `.screen`, `.cache`, `.sitemap`,
// `app.go`, `app.current`, `app.url_of`, `app.presence` and `app.notify` to
// the graph's `__` members below.
App: struct {
    title: String,

    // `.api<S>(path, max_upload:)` as the compiler lowers it: `service`
    // names `S`. A client posts each call of an endpoint method of `S` to
    // `{path}/{method}`, a body of at most `max_upload` bytes; a graph that
    // mounts `S` answers its calls in this process (`__remote`).
    __api: fn<S>(self, path: String, service: String, max_upload: Int) -> App Never! {
        held := APP_GRAPH.guard_edit()
        held.value.apis[service] = AppAPI{path: path, max_upload: max_upload}
        self.copy()
    }

    // `.cache<V>(policy)` as the compiler lowers it: `reply` names `V` as
    // an endpoint's reply type is named where it mounts, so each endpoint
    // method that replies a `V` is answered under `policy`
    // (`reply_cache.policy`). The last policy set for `V` holds.
    __cache: fn<V>(self, reply: String, policy: CachePolicy) -> App Never! {
        held := APP_CACHE.guard_edit()
        held.value[reply.copy()] = policy
        self.copy()
    }

    // `.sitemap(list)` as the compiler lowers it: `list` gives the states
    // `V` of the pages the sitemap lists, `state` names `V` as `__screen`'s
    // does, and `address` gives a state's fields' address text in the order
    // of `names` (`__address_arg`). The sitemap asks `list` each time it is
    // read (`sitemap.addresses`).
    __sitemap: fn<V>(self, state: String, names: [String], list: &&fn() -> [V] Never!, address: &&fn(App, V) -> [String] Never!) -> App Never! {
        graph: self.copy()
        opens: state.copy()
        fields: names.copy()
        listed := APP_SITEMAPS.guard_edit()
        listed.value.push(
            Shared{AppSitemap{
                state: state.copy(),
                addresses: fn() {
                    found := [String]{}
                    loop view in list() {
                        found.push(App.__url_of<V>(opens, fields, address(graph, view)))
                    }
                    found
                },
            }},
        )
        self.copy()
    }

    // Whether a device queues the writes it can't send (`.Queue`) or fails
    // them at once (`.Off`, the start).
    offline: fn(self, mode: Offline) -> App Never! {
        held := APP_GRAPH.guard_edit()
        held.value.offline = mode
        self.copy()
    }

    // Makes the app installable from a browser: a server of the graph
    // answers a web app manifest that names the app `name` in `color`
    // (0xRRGGBB), with icons of 192 and 512 pixels and a maskable one of 512
    // made from the one `icon` file, and every page it serves links the
    // manifest. The last call holds.
    installable: fn(self, name: String, icon: String, color: Int) -> App Never! {
        if name == "" {
            panic("`.installable` needs the app's name: an installed app shows it under its icon")
        }
        if icon == "" {
            panic("`.installable` needs the path of the app's icon, a PNG or JPEG file")
        }
        if color < 0 || color > 0xFFFFFF {
            panic("`.installable(color: {color})` is no color: write it as 0xRRGGBB, as 0x2a5bd7")
        }
        held := APP_GRAPH.guard_edit()
        held.value.install = Val(AppInstall{name: name, icon: icon, color: color})
        self.copy()
    }

    // Gives the app the link scheme `name`: `{name}://tasks/7` opens what
    // the address `/tasks/7` opens (`open_link`), and the desktop entry
    // `launch` installs on Linux names the app the handler of `name:` links
    // (`x-scheme-handler/{name}`), so the desktop opens such a link in the
    // app. A scheme is a letter, then letters, digits, `+`, `-` or `.`; it is
    // kept in lowercase, as schemes compare without case.
    url_scheme: fn(self, name: String) -> App Never! {
        scheme: name.lower()
        if !app_link_scheme_valid(scheme) {
            panic("`.url_scheme(\"{name}\")` is no link scheme: write a letter, then letters, digits, `+`, `-` or `.`, as \"crewboard\"")
        }
        if scheme == "http" || scheme == "https" || scheme == "file" {
            panic("`.url_scheme(\"{name}\")` names a scheme the system's browser and files own: give the app its own, as \"crewboard\", and its web links with `.app_links(domain:)`")
        }
        held := APP_GRAPH.guard_edit()
        if !held.value.schemes.contains(scheme) -> held.value.schemes.push(scheme)
        self.copy()
    }

    // Gives the app the web links of `domain`: `https://{domain}/tasks/7`
    // opens what the address `/tasks/7` opens (`open_link`), as the page at
    // that link does on the web. `domain` is a host name, without a scheme,
    // port or path; it is kept in lowercase, as host names compare without
    // case.
    app_links: fn(self, domain: String) -> App Never! {
        host: domain.lower()
        if host == "" || host.contains("/") || host.contains(":") || host.contains("@") || host.contains(" ") {
            panic("`.app_links(domain: \"{domain}\")` is no host name: write the domain alone, as \"crew.example.com\"")
        }
        held := APP_GRAPH.guard_edit()
        if !held.value.link_domains.contains(host) -> held.value.link_domains.push(host)
        self.copy()
    }

    // Opens the screen state `link` addresses, through the graph's route
    // set, as `go` opens a state: the state's fields are the texts of each
    // `:name` segment of the screen's path and of each `#App.Query` field in
    // the query, and the first screen, in the order the graph adds them,
    // whose path the link's path fits and whose texts make its state opens.
    // A link is an address (`/tasks/7`), a link of a scheme the app has
    // (`url_scheme`: `crewboard://tasks/7`) or a web link of one of its
    // domains (`app_links`: `https://crew.example.com/tasks/7`). Any other
    // link, and one no screen opens, opens the not-found state: no screen
    // is current, and `lost_link` gives the link. True when a screen opened.
    open_link: fn(self, link: String) -[Net, FS.Read]> Bool Never! {
        found: app_link_address(link) ?? return app_link_lost(link)
        path := found
        query := ""
        mark: found.find("?")
        if mark >= 0 {
            path = found.slice(0, mark)
            query = found.slice(mark + 1, found.len())
        }
        loop screen in self.__screens() {
            fields: app_link_fields(screen, path, query) ?? next
            graph: app_graph_open(screen.state, fields.copy())
            me: tasks.current_task()
            resume_begin(me)
            shown: graph.__open(screen, fields)
            live_drop(app_graph_route_data(resume_end(me)))
            if shown != None -> return true
        }
        app_link_lost(link)
    }

    // The link the not-found state shows (`open_link`), None while a screen
    // is current or before a link opens.
    lost_link: fn(self) -> String? Never! {
        now: app_graph_current() ?? return None
        if now.state != "" -> return None
        now.fields.get(C_APP_LOST_LINK).copy()
    }

    // Starts the app on a Linux desktop, as its one running copy. While a
    // copy runs, a launch hands it the link it was given and its activation
    // token, and is false: the caller exits. The running copy opens that
    // link (`open_link`) and keeps the token (`activations`). The copy
    // listens at `{runtime}/{id}.link`: `{runtime}` is `$XDG_RUNTIME_DIR`,
    // else the temporary directory, and `{id}` is the desktop entry's. When
    // no copy runs, this launch becomes it. When the graph has a link scheme
    // (`url_scheme`), it installs the app's desktop entry
    // (`{data}/applications/{id}.desktop`, `desktop_entry`). It also makes
    // that entry the default handler of each scheme's links in
    // `{config}/mimeapps.list`, as `xdg-mime default` does. `{data}` is
    // `$XDG_DATA_HOME`, else `~/.local/share`; `{config}` is
    // `$XDG_CONFIG_HOME`, else `~/.config`. It starts the graph's background
    // work (`background`). Then it opens the link the launch was given
    // (`open_link`) and is true. That link is the first argument that is
    // one, as the desktop passes the link the entry's `%u` names.
    launch: fn(self) -[Env, Exec.Args, FS.Read, FS.Write, Net, Time.Wait]> Bool Never! {
        link := ""
        loop given in process.args() {
            if app_link_address(given) == None -> next
            link = given.copy()
            break
        }
        socket: "{app_runtime_dir()}/{app_desktop_id(self.title)}.link"
        token: sys.get("XDG_ACTIVATION_TOKEN") ?? sys.get("DESKTOP_STARTUP_ID") ?? ""
        if app_launch_hand(socket, link, token) -> return false
        if app_graph_schemes().len() > 0 -> app_link_register(self.title)
        app_launch_listen(App{title: self.title.copy()}, socket)
        app_background_start(self.title)
        if link != "" -> _: self.open_link(link)
        true
    }

    // The activation token of each later launch that handed this running
    // copy its link (`launch`), in order, "" for a launch the desktop gave
    // none. A launch's token is the one the desktop's activation protocol
    // takes to bring the app's window to the front:
    // `$XDG_ACTIVATION_TOKEN` (Wayland), else `$DESKTOP_STARTUP_ID` (X11).
    activations: fn(self) -> [String] Never! {
        held: APP_GRAPH.guard_read()
        held.value.activations.copy()
    }

    // Runs `run` in the background on a Linux desktop, every `every`
    // while the app runs, from `launch` on. When `at_login`, the app also
    // runs at login: `launch` installs its XDG autostart entry
    // (`{config}/autostart/{id}.desktop`, `desktop_entry`), and a launch
    // whose graph asks no work to run at login removes it. A run that
    // fails puts its notice in the app's notice list (`notices`): no
    // control shows it. Gives back the graph. Panics when `every` isn't
    // positive.
    background: fn(self, every: Duration, run: &&fn() Notice!, at_login: Bool{false}) -> App Never! {
        if every.ns <= 0 {
            panic("background work runs every positive duration, not every {every.ns}ns")
        }
        held := APP_GRAPH.guard_edit()
        held.value.backgrounds.push(AppBackground{every_ns: every.ns, at_login: at_login, run: Shared{AppBackgroundRun{run: run.move()}}})
        self.copy()
    }

    // The text of the app's Linux desktop entry: an application named
    // `title` that `exec` runs with the link it opens (`%u`), handling the
    // links of each scheme the graph has (`x-scheme-handler/{scheme}`).
    desktop_entry: fn(self, exec: String) -> String Never! {
        lines := [String]{"[Desktop Entry]", "Type=Application", "Name={app_desktop_value(self.title)}", "Exec={app_desktop_exec(exec)} %u", "Terminal=false"}
        handlers := ""
        loop scheme in app_graph_schemes() -> handlers = "{handlers}x-scheme-handler/{scheme};"
        if handlers != "" -> lines.push("MimeType={handlers}")
        "{lines.join("\n")}\n"
    }

    // `.screen(path, view, signed_in:)` as the compiler lowers it, once it
    // has checked `view`'s state `V` against `path`: `state` names `V`,
    // `query` lists its `#App.Query` fields, and `open` opens the screen at
    // an address: from the text of each of `V`'s fields there, by name, it
    // makes the state, runs `view` with it and the graph's Remotes, and gives
    // the HTML of what the view shows (a tree's `__html`, else
    // `__view_html`); None when the texts don't make a `V`. The screen joins
    // the graph's route set, in the order the graph adds it, where
    // `__url_of` finds its address, `__go` opens it, and a renderer walks it
    // (`screens`).
    __screen: fn<V>(self, path: String, state: String, query: [String], signed_in: Bool, open: &&fn(App, [String:String]) -[Net, FS.Read]> String? Never!) -> App Never! {
        held := APP_GRAPH.guard_edit()
        held.value.screens.push(AppScreen{path: path, state: state, query: query, signed_in: signed_in, open: Shared{AppOpen{run: open.move()}}})
        self.copy()
    }

    // An `#App.Public` method of a mounted service, as the compiler lowers
    // `.mount(service)`: `path` is `{service}/{method}`, where the graph's
    // Remote of the service posts the call (`graph_post`), and `answer` runs
    // the call from its decoded arguments. A call in this process comes from
    // no network address, so the endpoint's limit of `limit` calls per
    // `window_ns` from one address, which a server keeps, doesn't apply.
    __remote_public: fn(self, path: String, answer: &&fn(RemoteArgs) -> String [FieldError]!, limit: Int, window_ns: Int) -> App Never! {
        held := APP_GRAPH.guard_edit()
        held.value.endpoints[path] = AppEndpoint{answer: Val(Shared{AppAnswer{run: answer.move()}})}
        self.copy()
    }

    // An `#App.SignedIn` method of a mounted service: its call answers
    // `SignedOut`, as a server's does, until the graph signs a caller in.
    __remote_signed_in: fn(self, path: String, limit: Int, window_ns: Int) -> App Never! {
        held := APP_GRAPH.guard_edit()
        held.value.endpoints[path] = AppEndpoint{answer: None}
        self.copy()
    }

    // An `#App.Job` method of a mounted service, declared to this process's
    // jobs (`jobs.know`), so a server serving here runs the job's kept rows.
    __job: fn(self, name: String, retries: Int, run: &&fn(RemoteArgs) -> String [FieldError]!) -> App Never! {
        jobs.know(name, retries, run.move())
        self.copy()
    }

    // The graph's Remote of the service `S` (`.api<S>`, which `service`
    // names), as the compiler passes it to each `app.Remote<S>` parameter of
    // a screen's view: when the graph mounts `S`, each call runs in this
    // process (`graph_post`); otherwise it posts to `{path}/{method}`. The
    // compiler passes only a service a `.api` of the graph declares.
    __remote: fn<S>(self, service: String) -> Remote<S> Never! {
        held: APP_GRAPH.guard_read()
        api: held.value.apis.get(service) ?? panic("the app graph declares no `.api` of `{service}`: add `.api<{service}>(path)` to the graph")
        loop path in held.value.endpoints.keys() {
            if path.starts_with("{service}/") {
                return Remote<S>{service: None, address: service, client: "", local: true}
            }
        }
        Remote<S>{service: None, address: api.path.copy(), client: "", local: false}
    }

    // The JSON of the field `name` of a state, of type `T`, from its text in
    // an address (`fields`, by field name): a value whose JSON is a string
    // is its own text, any other its JSON (`__address_arg`). None when the
    // address has no such field or its text is no `T`.
    __address_json: fn<T: [Encode, Decode]>(self, fields: [String:String], name: String) -> String? Never! {
        text: fields.get(name) ?? return None
        quoted: live_json.to_string<String>(text) ?? return None
        if live_json.decode<T>(quoted) == .Ok(value) {
            return Val(live_json.to_string<T>(value) ?? return None)
        }
        value: live_json.decode<T>(text) ?? return None
        Val(live_json.to_string<T>(value) ?? return None)
    }

    // The state `V` whose fields `names` have the JSON `values`
    // (`__address_json`), in order; None when a value is missing or the
    // values make no `V`.
    __address_state: fn<V: Decode>(self, names: [String], values: [String?]) -> V? Never! {
        parts := [String]{}
        loop index in 0..<names.len() {
            value: values[index] ?? return None
            name: live_json.to_string<String>(names[index]) ?? return None
            parts.push("{name}:{value}")
        }
        Val(live_json.decode<V>("{{{parts.join(",")}}}") ?? return None)
    }

    // The HTML of what a screen's view shows when it is no node tree: its
    // text (a string's own text, any other value's JSON), escaped, as a
    // paragraph. A view that gives a tree shows the tree's HTML (`__html`).
    __view_html: fn<N: Encode>(self, shown: N) -> String Never! {
        "<p>{markup.escape(App.__address_arg<N>(shown))}</p>"
    }

    // `app.go(view)` as the compiler lowers it: opens the screen whose state
    // is `V`, which `state` names, at the address of the fields `names` with
    // the texts `values` (`__address_arg`): the screen becomes the current
    // one (`__current`), and its view runs. The bindings the view reads are
    // the screen's route data (app_graph_route_data). The compiler refuses a
    // state that no screen of the program's graph opens, so a state with no
    // screen here is one whose graph this process has not built.
    __go: fn<V>(state: String, names: [String], values: [String]) -[Net, FS.Read]> Never! {
        fields := [String:String]{}
        loop index in 0..<names.len() -> fields[names[index].copy()] = values[index].copy()
        screen: app_screen(state) ?? panic("no screen opens `{state}` yet: build the app graph (`app.new`) before opening a screen")
        graph: app_graph_open(state, fields.copy())
        me: tasks.current_task()
        resume_begin(me)
        _: graph.__open(screen, fields)
        live_drop(app_graph_route_data(resume_end(me)))
    }

    // `app.current<V>()` as the compiler lowers it: the state of the current
    // screen (`__go`) when it is a `V`, which `state` names, made from its
    // address's field texts by `decode`; None otherwise.
    __current: fn<V>(state: String, decode: fn(App, [String:String]) -> V? Never!) -> V? Never! {
        now: app_graph_current() ?? return None
        if now.state != state -> return None
        decode(App{title: app_graph_title()}, now.fields)
    }

    // The graph as it stands, as a server holds it to answer its screens'
    // addresses.
    __graph: fn() -> App Never! { App{title: app_graph_title()} }

    // The screens of the graph, in the order it adds them: what a renderer
    // walks to answer each address.
    __screens: fn(self) -> [AppScreen] Never! {
        held: APP_GRAPH.guard_read()
        held.value.screens.copy()
    }

    // What `.installable` set, None when the graph is not installable.
    __install: fn(self) -> AppInstall? Never! {
        held: APP_GRAPH.guard_read()
        held.value.install.copy()
    }

    // The paths of the graph's services when it queues the writes it can't
    // send (`.offline(.Queue)`), which a browser's service worker holds;
    // none when it doesn't.
    __queued_apis: fn(self) -> [String] Never! {
        held: APP_GRAPH.guard_read()
        paths := [String]{}
        if held.value.offline != .Queue -> return paths
        loop service in held.value.apis.keys() -> paths.push(held.value.apis[service].path.copy())
        paths.sort()
        paths
    }

    // Opens `screen` at the address whose field texts are `fields`, by field
    // name, as a renderer does: the HTML of what its view shows, or None
    // when the texts make no state of the screen.
    __open: fn(self, screen: AppScreen, fields: [String:String]) -[Net, FS.Read]> String? Never! {
        opener: screen.open.guard_read()
        opener.value.run(self.copy(), fields)
    }

    // `.head(head)` as the compiler lowers it: `head` gives the page
    // metadata of the screen whose state is `V`, and `state` names `V` as
    // `__screen`'s does. `decode` makes a `V` from its address's field
    // texts, as `__current`'s does. The last head given for `V` holds; a
    // page asks it for the address it shows (`heads.of`).
    __head: fn<V>(self, state: String, decode: &&fn(App, [String:String]) -> V? Never!, head: &&fn(V) -> Head Never!) -> App Never! {
        held := APP_HEADS.guard_edit()
        held.value[state.copy()] = Shared{AppHead{
            run: fn(graph: App, fields: [String:String]) {
                shown: decode(graph, fields) ?? return Head?{None}
                Val(head(shown))
            },
        }}
        self.copy()
    }

    // The address of the screen whose state is `V`, as the compiler lowers
    // `url_of(view)` and a push's `open:`. `names` are `V`'s fields, in
    // order, and `values` their address text (`__address_arg`). Each `:name`
    // segment of the screen's path is its field's value, and each query
    // field with a value joins the query, in field order; both are
    // percent-encoded. The compiler refuses a state that no screen of the
    // program's graph opens, so a state with no screen here is one whose
    // graph this process has not built.
    __url_of: fn<V>(state: String, names: [String], values: [String]) -> String Never! {
        screen: app_screen(state) ?? panic("no screen opens `{state}` yet: build the app graph (`app.new`) before taking an address")
        parts := [String]{}
        loop segment in screen.path.split("/") {
            if !segment.starts_with(":") {
                parts.push(segment)
                next
            }
            name: segment.removeprefix(":")
            index: names.index_of(name) ?? panic("`{state}` has no field `{name}` for the path `{screen.path}`")
            parts.push(url.percent_encode(values[index]))
        }
        address := parts.join("/")
        separator := "?"
        loop field in screen.query {
            index: names.index_of(field) ?? next
            if values[index] == "" -> next
            address = "{address}{separator}{url.percent_encode(field)}={url.percent_encode(values[index])}"
            separator = "&"
        }
        address
    }

    // A state field's text in an address: a string's own text, and any
    // other value's JSON.
    __address_arg: fn<A: Encode>(value: A) -> String Never! {
        text: live_json.to_string<A>(value) ?? return ""
        tree: live_json.parse(text) ?? return text
        live_json.at<String>(tree, "") ?? text
    }

    // `__address_arg` through a graph, as a lowered `.sitemap` reads each
    // state's fields (`__sitemap`).
    __address_text: fn<A: Encode>(self, value: A) -> String Never! { App.__address_arg<A>(value) }

    // Who has the screen state at `address` open, as the compiler lowers
    // `presence(view)` (`address` is `__url_of`'s): each account whose live
    // binding's latest run asked this, sorted. A run that a row policy
    // refuses before it asks, as a method that reads the state's row first
    // is refused, leaves its account out, so only accounts whose last read
    // of the screen's data passed are counted. Asked in a binding's run, the
    // run's own account is present, and the binding re-runs when the
    // accounts present change, as a live query does; asked elsewhere, it only
    // reads them.
    __presence: fn(address: String) -> [auth.AccountID] Never! {
        asking := ""
        if maybe_caller() == .Val(account) && live_presence_ask(tasks.current_task(), address) {
            asking = account.raw()
            source: "{LIVE_PRESENCE_SOURCE}{address}"
            live_read_record(source, source)
        }
        live_present(address, asking)
    }

    // A push to each device the account `to` registered, as the compiler
    // lowers `app.notify(to:, title:, body:, open:)`: `open_route` is the
    // address of the state a tap opens (`__url_of`). Inside a job, a
    // webhook's call or a scheduled run, each push's key is made from the
    // run's key, `to` and `open_route`, so a run that runs again replaces the
    // pushes it sent; outside one, each push has a fresh key. A device whose
    // push service is not set up is skipped. A push its service refuses is
    // dropped, and when the service says the device is gone, the device is
    // forgotten. Each skip and failure is counted (`jet.push.skipped`,
    // `jet.push.failed`) and kept with its service, account and reason
    // (`push.outcomes`): the published signature declares only Net, so no
    // log record can carry them.
    __notify: fn(to: auth.AccountID, title: String, body: String, open_route: String) -[Net]> Never! {
        account: to.raw()
        devices: push.devices(account)
        if devices.len() == 0 {
            return
        }
        run: push_run_key()
        key: if run != "" -> push_wire.push_collapse_key(run, account, open_route) else -> {
            push_wire.push_fresh_key() ?? {
                loop device in devices -> push_note(false, device.service, account, err.reason)
                return
            }
        }
        now: push_wire.push_now()
        loop device in devices {
            if !push_wire.push_configured(device.service) {
                push_note(true, device.service, account, "no {push_wire.push_service_label(device.service)} settings")
                next
            }
            outcome: push_wire.push_deliver(device.service, device.token, device.key, device.auth, key, title, body, open_route, now)
            if outcome.reason == "" -> next
            if outcome.gone {
                push.forget(device.service, device.token)
                push_note(false, device.service, account, "{outcome.reason}; the device is forgotten")
            } else { push_note(false, device.service, account, outcome.reason) }
        }
    }

    // A notification on this device, as the compiler lowers
    // `app.notify(title:, body:, open:)` written without `to:`. `open_route`
    // is the address of the state a click on it opens (`__url_of`). On a
    // Linux desktop the desktop's notification service shows it, with no
    // server, and while the app runs a click on it opens that state through
    // the graph's route set (`open_link`). A notification that can't be
    // shown is never dropped: a notice saying so joins the app's notice
    // list (`notices`).
    __notify_here: fn(title: String, body: String, open_route: String) -[Env, FS.Read, Net, Time]> Never! {
        #if #build.target.os == {
            .Linux -> { app_notify_linux(title, body, open_route) }
            .MacOS -> { app_notify_unshown(title, NOTIFY_UNBUILT) }
            .Windows -> { app_notify_unshown(title, NOTIFY_UNBUILT) }
            .Web -> { app_notify_unshown(title, "a page shows no notification of its own") }
            .Wasm -> { app_notify_unshown(title, "a page shows no notification of its own") }
            .Freestanding -> { app_notify_unshown(title, "there is no desktop to show it") }
        }
    }
}

// A field of a screen's state that the address carries after `?`:
// `#App.Query q: String{""}` is `?q=…`. Every other field of the state is
// the `:name` segment of its screen's path that has its name.
Query: struct {
    impl Marker {
        sites: [.Field]
    }
}

// Starts the app graph, titled `title`: a graph with no services, screens,
// heads, queue or links yet.
new: fn(title: String) -> App Never! {
    held := APP_GRAPH.guard_edit()
    held.value = AppGraph{title: title.copy(), apis: [String:AppAPI]{}, endpoints: [String:AppEndpoint]{}, screens: [AppScreen]{}, offline: .Off, install: None, current: None, route_data: [Int]{}, schemes: [String]{}, link_domains: [String]{}, activations: [String]{}, backgrounds: [AppBackground]{}}
    heads := APP_HEADS.guard_edit()
    heads.value = [String:Shared<AppHead>]{}
    App{title: title}
}

// Whether a device queues the writes it can't send, to send them once it
// reaches the server again (`.Queue`), or fails them (`.Off`).
#Equatable
Offline: enum {
    Off,
    Queue
}

// One screen of the route set: the path its state's fields fill, the state's
// name, its `#App.Query` fields, whether only a signed-in caller opens it,
// and how it opens at an address (`App.__screen`).
AppScreen: struct {
    path: String,
    state: String,
    query: [String],
    signed_in: Bool,
    open: Shared<AppOpen>
}

// How a screen opens at an address: from its fields' texts, the text of
// what its view shows, or None when they make no state.
AppOpen: struct {
    run: fn(App, [String:String]) -[Net, FS.Read]> String? Never!
}

// How the replies of one type may be kept, as `.cache<V>(policy)` sets it.
// `.Private` is kept by no one: `Cache-Control: private, no-store`, as
// every `#App.SignedIn` reply is answered, whatever its type's policy.
// `.Public(max_age)` lets any cache keep an `#App.Public` reply for
// `max_age` (`Cache-Control: public, max-age=<seconds>`) and then
// revalidate it with its `ETag`: a GET whose `If-None-Match` names the
// reply's ETag is answered 304 with no body.
CachePolicy: enum {
    Private,
    Public(max_age: Duration)
}

// The cache policy of each reply type, by the name `__cache` was given.
priv APP_CACHE: Shared{[String:CachePolicy]{}}

// A page's metadata on the web output, as `.head(fn)` gives it for a
// screen's state: the page's title, the description and share image a search
// result or a shared link shows, whether the page names its own address as
// its canonical one, and whether search engines may index it. A screen only
// a signed-in caller opens is never indexed, whatever its head says.
Head: struct {
    title: String,
    description: String?{None},
    image: String?{None},
    canonical: Bool{true},
    index: Bool{true}
}

// A reply a store keeps for a `.Public` policy, as it finds it: the encoded
// reply and the milliseconds since it was kept, by the store's clock.
priv KeptReply: struct {
    reply: String,
    age_ms: Int
}

// One store's kept replies, which core.db keeps in the table
// `__jet_kept_replies` of each database file and names as the file opens
// (`reply_cache.store`), so the servers of an App that share the file
// share them. A write any server commits to the file drops them all, as a
// kept reply may have read what it changed.
priv KeptReplies: struct {
    // Names the store among the open ones, as CallOutbox.store does.
    store: String,
    // The reply kept under a key while it is fresh by the store's clock:
    // through the instant its max_age ends, and not after it; None when
    // there is none, or the store couldn't read it.
    find: fn(String) -[]> KeptReply? Never!,
    // Keeps a reply under a key for a max_age in milliseconds, in place of
    // the one kept under it, and drops the stale ones; a reply whose run
    // began, the last milliseconds given ago, no later than a write the file
    // took is not kept, as it may hold what the write changed. False when
    // the store couldn't keep or judge it.
    keep: fn(String, String, Int, Int) -[]> Bool Never!
}

// The stores named for kept replies, in the order they opened.
priv KEPT_REGISTRY: Shared{[Shared<KeptReplies>]{}}

// The writes committed to any store of this process (`reply_cache.written`).
priv KEPT_WRITES: Shared{0}

// The cache policies core.web answers endpoint replies under, and the
// replies the servers that share the App's database files keep under them.
// core.db names each database file as it opens (`store`). A reply is kept
// in the first named store that takes it, the App's first store still
// open, and found in any named store.
priv(package) reply_cache: module {
    // The policy `.cache<V>` set for the reply type named `reply`; None when
    // none was set.
    policy: fn(reply: String) -> CachePolicy? Never! {
        held: APP_CACHE.guard_read()
        found: held.value.get(reply) ?? return None
        Val(found.copy())
    }

    // Names a store; a store named again replaces the one of its name.
    store: fn(replies: &&KeptReplies) Never! {
        registry := KEPT_REGISTRY.guard_edit()
        loop index in 0..<registry.value.len() {
            if kept_store_name(registry.value[index]) == replies.store {
                registry.value[index] = Shared{replies.move()}
                return
            }
        }
        registry.value.push(Shared{replies.move()})
    }

    // The fresh reply a named store keeps under `key`; None when none does.
    find: fn(key: String) -> KeptReply? Never! {
        loop replies in kept_stores() {
            held: replies.guard_read()
            if held.value.find(key.copy()) == .Val(found) -> return Val(found)
        }
        None
    }

    // Keeps `reply`, whose run began `ran_ms` ago, under `key` for
    // `max_age_ms` in the first named store that takes or judges it; false
    // when none does.
    keep: fn(key: String, reply: String, max_age_ms: Int, ran_ms: Int) -> Bool Never! {
        loop replies in kept_stores() {
            held: replies.guard_read()
            if held.value.keep(key.copy(), reply.copy(), max_age_ms, ran_ms) -> return true
        }
        false
    }

    // Counts a write committed to a store of this process (core.db). A reply
    // this process keeps for itself is fresh only while the count is the one
    // its run began at (`writes`).
    written: fn() Never! {
        held := KEPT_WRITES.guard_edit()
        held.value += 1
    }

    // The writes committed to the stores of this process so far.
    writes: fn() -> Int Never! {
        held: KEPT_WRITES.guard_read()
        held.value
    }
}

// The named stores, copied out so no store runs under the registry's lock.
priv kept_stores: fn() -> [Shared<KeptReplies>] Never! {
    registry: KEPT_REGISTRY.guard_read()
    registry.value.copy()
}

priv kept_store_name: fn(replies: Shared<KeptReplies>) -> String Never! {
    held: replies.guard_read()
    held.value.store.copy()
}

// A sitemap `.sitemap(list)` gave: the name of the state its list gives,
// and the address of each state the list gives when asked.
priv AppSitemap: struct {
    state: String,
    addresses: fn() -[]> [String] Never!
}

// The sitemaps the graph gave, in the order it gave them.
priv APP_SITEMAPS: Shared{[Shared<AppSitemap>]{}}

// What core.web's `/sitemap.xml` and `/robots.txt` answer: the pages the
// sitemap lists, which are only ever pages a caller who is not signed in
// opens, and the screens a crawler is asked to leave, which are those only
// a signed-in caller opens.
priv(package) sitemap: module {
    // Whether the graph gave a sitemap.
    given: fn() -> Bool Never! {
        listed: APP_SITEMAPS.guard_read()
        listed.value.len() > 0
    }

    // The address of each state the sitemaps' lists give now, once each,
    // in the order given. A list whose state no screen opens, or whose
    // screen only a signed-in caller opens, gives none.
    addresses: fn() -> [String] Never! {
        found := [String]{}
        loop listed in app_sitemaps() {
            held: listed.guard_read()
            if !app_screen_public(held.value.state) -> next
            loop address in held.value.addresses() {
                if !found.contains(address) -> found.push(address)
            }
        }
        found
    }

    // The path of each screen only a signed-in caller opens, sorted, as a
    // robots.txt rule matches it: each `:name` segment is `*`, and `$` ends
    // the path, so a public page under it stays open to crawlers.
    signed_in_paths: fn() -> [String] Never! {
        held: APP_GRAPH.guard_read()
        paths := [String]{}
        loop screen in held.value.screens {
            if !screen.signed_in -> next
            segments := [String]{}
            loop segment in screen.path.split("/") {
                segments.push(if segment.starts_with(":") -> "*" else -> segment)
            }
            rule: "{segments.join("/")}$"
            if !paths.contains(rule) -> paths.push(rule)
        }
        paths.sort()
        paths
    }
}

// The sitemaps, copied out so no list runs under the lock.
priv app_sitemaps: fn() -> [Shared<AppSitemap>] Never! {
    listed: APP_SITEMAPS.guard_read()
    listed.value.copy()
}

// Whether a screen opens the state named `state` for a caller who is not
// signed in.
priv app_screen_public: fn(state: String) -> Bool Never! {
    screen: app_screen(state) ?? return false
    !screen.signed_in
}

// The head `.head(fn)` gave a screen's state: `run` gives the head of the
// state whose address has the field texts it is given, None when the texts
// make no such state.
priv AppHead: struct {
    run: fn(App, [String:String]) -[]> Head? Never!
}

// The head of each screen's state, by the state's name.
priv APP_HEADS: Shared{[String:Shared<AppHead>]{}}

// What core.web's screen pages put in their `<head>`: the metadata the
// graph gave a state, and whether search engines may index its page.
priv(package) heads: module {
    // The head `.head(fn)` gives the state named `state` of `graph` at the
    // address whose field texts are `fields`, by field name; None when no
    // head was given for it or the texts make no such state.
    of: fn(graph: App, state: String, fields: [String:String]) -> Head? Never! {
        given: app_head(state) ?? return None
        held: given.guard_read()
        held.value.run(graph, fields)
    }

    // Whether search engines may index the page of the state named
    // `state`, whose head is `head`: never when only a signed-in caller
    // opens its screen, else as its head says, and yes with no head.
    indexed: fn(state: String, head: Head?) -> Bool Never! {
        if !app_screen_public(state) -> return false
        if head == .Val(given) -> return given.index
        true
    }
}

// The head given for the state named `state`, copied out so it runs with no
// lock held.
priv app_head: fn(state: String) -> Shared<AppHead>? Never! {
    held: APP_HEADS.guard_read()
    held.value.get(state)
}

// The states of a sitemap test's public guide screen and signed-in inbox.
priv SitemapTestGuide: struct {
    slug: String
}

priv SitemapTestInbox: struct {
    box: String
}

#Test("a sitemap lists each state its list gives whose screen opens without signing in, and robots leave each signed-in screen") {
    graph: new("Crew").__screen<SitemapTestGuide>("/guides/:slug", "app.SitemapTestGuide", [String]{}, false, fn(_: App, _: [String:String]) { String?{None} }).__screen<SitemapTestInbox>("/inbox/:box", "app.SitemapTestInbox", [String]{}, true, fn(_: App, _: [String:String]) { String?{None} })
    _: graph.__sitemap<SitemapTestGuide>(
        "app.SitemapTestGuide",
        [String]{"slug"},
        fn() { [SitemapTestGuide]{SitemapTestGuide{slug: "start here"}, SitemapTestGuide{slug: "faq"}, SitemapTestGuide{slug: "faq"}} },
        fn(on: App, guide: SitemapTestGuide) { [String]{on.__address_text<String>(guide.slug)} },
    )
    _: graph.__sitemap<SitemapTestInbox>(
        "app.SitemapTestInbox",
        [String]{"box"},
        fn() { [SitemapTestInbox]{SitemapTestInbox{box: "mine"}} },
        fn(on: App, inbox: SitemapTestInbox) { [String]{on.__address_text<String>(inbox.box)} },
    )
    // A list whose state no screen opens yet gives no address.
    _: graph.__sitemap<SitemapTestGuide>(
        "app.SitemapTestNowhere",
        [String]{"slug"},
        fn() { [SitemapTestGuide]{SitemapTestGuide{slug: "lost"}} },
        fn(on: App, guide: SitemapTestGuide) { [String]{on.__address_text<String>(guide.slug)} },
    )
    assert(sitemap.given())
    assert_eq(sitemap.addresses().join(" "), "/guides/start%20here /guides/faq")
    paths: sitemap.signed_in_paths()
    assert(paths.contains("/inbox/*$"))
    assert(!paths.contains("/guides/*$"))
}

// The states of the head test's public guide screen and signed-in inbox.
priv HeadTestGuide: struct {
    slug: String
}

priv HeadTestInbox: struct {
    box: String
}

// The guide and the inbox at an address, as the compiler lowers their
// decoding from its field texts.
priv head_test_guide: fn(_: App, fields: [String:String]) -> HeadTestGuide? Never! {
    slug: fields.get("slug") ?? return None
    Val(HeadTestGuide{slug: slug})
}

priv head_test_inbox: fn(_: App, fields: [String:String]) -> HeadTestInbox? Never! {
    box: fields.get("box") ?? return None
    Val(HeadTestInbox{box: box})
}

#Test("a screen's head is the last `.head` given for its state, and only a public screen whose head allows it is indexed") {
    graph: new("Crew").__screen<HeadTestGuide>("/help/:slug", "app.HeadTestGuide", [String]{}, false, fn(_: App, _: [String:String]) { String?{None} }).__screen<HeadTestInbox>("/mail/:box", "app.HeadTestInbox", [String]{}, true, fn(_: App, _: [String:String]) { String?{None} })
    faq_fields: [String:String]{"slug": "faq"}
    assert(heads.of(graph, "app.HeadTestGuide", faq_fields) == None)
    assert(heads.indexed("app.HeadTestGuide", None))
    _: graph.__head<HeadTestGuide>("app.HeadTestGuide", head_test_guide, fn(guide: HeadTestGuide) { Head{title: "old {guide.slug}"} })
    _: graph.__head<HeadTestGuide>("app.HeadTestGuide", head_test_guide, fn(guide: HeadTestGuide) { Head{title: "Help: {guide.slug}", description: Val("Answers about {guide.slug}"), index: guide.slug != "draft"} })
    _: graph.__head<HeadTestInbox>("app.HeadTestInbox", head_test_inbox, fn(inbox: HeadTestInbox) { Head{title: "Mail: {inbox.box}"} })
    faq: heads.of(graph, "app.HeadTestGuide", faq_fields) ?? panic("the guide has a head")
    assert_eq(faq.title, "Help: faq")
    assert_eq(faq.description, Val("Answers about faq"))
    assert_eq(faq.image, String?{None})
    assert(faq.canonical)
    assert(heads.indexed("app.HeadTestGuide", Val(faq)))
    draft: heads.of(graph, "app.HeadTestGuide", [String:String]{"slug": "draft"}) ?? panic("the draft has a head")
    assert(!heads.indexed("app.HeadTestGuide", Val(draft)))
    // Texts that make no guide give no head.
    assert(heads.of(graph, "app.HeadTestGuide", [String:String]{"box": "mine"}) == None)
    // A signed-in screen is never indexed, whatever its head says.
    mine: heads.of(graph, "app.HeadTestInbox", [String:String]{"box": "mine"}) ?? panic("the inbox has a head")
    assert_eq(mine.title, "Mail: mine")
    assert(mine.index)
    assert(!heads.indexed("app.HeadTestInbox", Val(mine)))
    assert(!heads.indexed("app.HeadTestNowhere", None))
}

#Test("a reply type's cache policy is the last `.cache` set for it") {
    assert(reply_cache.policy("app.CacheTestView") == None)
    graph: new("Crew").__cache<RouteTestBoard>("app.CacheTestView", CachePolicy.Public{max_age: 10min})
    assert_eq(graph.title, "Crew")
    if reply_cache.policy("app.CacheTestView") == .Val(.Public(max_age)) -> assert(max_age == 10min) else {
        panic("the public policy was not kept")
    }
    _: graph.__cache<RouteTestBoard>("app.CacheTestView", CachePolicy.Private)
    assert(reply_cache.policy("app.CacheTestView") == .Val(.Private))
}

#Test("a kept reply goes to the first named store that takes it, is found in any, and each committed write is counted") {
    refusing: KeptReplies{store: "app.Test refusing replies", find: fn(_: String) { KeptReply?{None} }, keep: fn(_: String, _: String, _: Int, _: Int) { false }}
    held: Shared{[String:String]{}}
    kept: held.copy()
    found: held.copy()
    taking: KeptReplies{
        store: "app.Test kept replies",
        find: fn(key: String) {
            seen: found.guard_read()
            reply: seen.value.get(key) ?? return KeptReply?{None}
            Val(KeptReply{reply: reply.copy(), age_ms: 0})
        },
        keep: fn(key: String, reply: String, _: Int, _: Int) {
            guard := kept.guard_edit()
            guard.value[key] = reply
            true
        },
    }
    reply_cache.store(refusing)
    reply_cache.store(taking)
    assert(reply_cache.find("/api/board [1]") == None)
    assert(reply_cache.keep("/api/board [1]", "{{\"ok\":false}}", 1000, 0))
    assert_eq((reply_cache.find("/api/board [1]") ?? panic("the reply was not kept")).reply, "{{\"ok\":false}}")
    assert(reply_cache.find("/api/board [2]") == None)
    before: reply_cache.writes()
    reply_cache.written()
    assert(reply_cache.writes() > before)
}

// How many times the resume test's source ran.
priv ResumeTestRuns: struct {
    runs: Int
}

priv RESUME_TEST_RUNS: Shared{ResumeTestRuns{runs: 0}}

// The resume test's source: 7 squared, each run counted.
priv resume_test_square: fn() -> Int AppError! {
    held := RESUME_TEST_RUNS.guard_edit()
    held.value.runs += 1
    Ok(49)
}

priv resume_test_runs: fn() -> Int Never! {
    held: RESUME_TEST_RUNS.guard_read()
    held.value.runs
}

// The resume test's view: one read, drawn in each of its states.
priv resume_test_view: fn() -> String Never! {
    binding: __live_bind<Int, AppError>("app.resume_test_square", [String]{"7"}, fn() { resume_test_square() })
    if state(binding) == {
        .Loaded(value) -> "<p>{value}</p>"
        .Failed(_) -> "<p>failed</p>"
        .Idle | .Loading -> "<p>loading</p>"
    }
}

#Test("a page carries the reads its view made, and a client that resumes the page reads them without running their source") {
    page: resume.render(fn() { resume_test_view() })
    assert_eq(resume_test_runs(), 1)
    assert_eq(page, "<p>49</p><script type=\"application/json\" id=\"jet-resume\">[{{\"source\":\"app.resume_test_square\",\"key\":\"[7]\",\"value\":\"ok:49\"}}]</script>")
    ann: auth.AccountID.from_string("ann")
    assert_eq(as_caller(ann, fn() { resume.seed(page) }), 1)
    assert_eq(as_caller(ann, fn() { resume_test_view() }), "<p>49</p>")
    assert_eq(resume_test_runs(), 1)
    // A client that resumed no page runs the read itself.
    ben: auth.AccountID.from_string("ben")
    assert_eq(as_caller(ben, fn() { resume_test_view() }), "<p>49</p>")
    assert_eq(resume_test_runs(), 2)
    // A read a write made stale before the page was sent is left out, so
    // the client runs it itself.
    stale: resume.render(fn() {
        shown: resume_test_view()
        __live_invalidate("app.resume_test_square", [String]{"7"})
        shown
    })
    assert_eq(stale, "<p>49</p>{RESUME_OPEN}[]</script>")
    assert_eq(resume_test_runs(), 2)
    // A page whose view reads nothing carries an empty list, and a page
    // without a resume script seeds nothing.
    assert_eq(resume.render(fn() { "<p>still</p>" }), "<p>still</p>{RESUME_OPEN}[]</script>")
    assert_eq(resume.seed("<p>49</p>"), 0)
}

// A service a graph declares (`.api<S>`): where its clients post its calls,
// and the most bytes one call's body holds.
priv AppAPI: struct {
    path: String,
    max_upload: Int
}

// An endpoint method of a service the graph mounts: how it answers a call
// from its decoded arguments, or None for a method only a signed-in caller
// calls.
priv AppEndpoint: struct {
    answer: Shared<AppAnswer>?
}

priv AppAnswer: struct {
    run: fn(RemoteArgs) -> String [FieldError]!
}

// The screen open now (`App.__go`): its state's name and its address's
// field texts, by field name. The not-found state (`App.open_link`) has no
// state name and keeps the link it shows under C_APP_LOST_LINK.
priv AppCurrent: struct {
    state: String,
    fields: [String:String]
}

// How a browser installs the app (`App.installable`): the name an installed
// app shows, the path of its icon (a PNG or JPEG, relative to the working
// directory like every app path) and its color as 0xRRGGBB.
AppInstall: struct {
    name: String,
    icon: String,
    color: Int
}

// The process's app graph: its title, its services by the name of each
// (`.api`), the endpoints of the services it mounts by `{service}/{method}`,
// its screens in the order it adds them, its offline mode, how a browser
// installs it, the screen open now and that screen's route data: the ids of
// the live bindings its view read, the link schemes and web domains whose
// links open its screens (`.url_scheme`, `.app_links`), the activation
// tokens of the later launches that handed it their links (`.launch`) and
// its background work (`.background`).
priv AppGraph: struct {
    title: String,
    apis: [String:AppAPI],
    endpoints: [String:AppEndpoint],
    screens: [AppScreen],
    offline: Offline,
    install: AppInstall?,
    current: AppCurrent?,
    route_data: [Int],
    schemes: [String],
    link_domains: [String],
    activations: [String],
    backgrounds: [AppBackground]
}

priv APP_GRAPH: Shared{AppGraph{title: "", apis: [String:AppAPI]{}, endpoints: [String:AppEndpoint]{}, screens: [AppScreen]{}, offline: .Off, install: None, current: None, route_data: [Int]{}, schemes: [String]{}, link_domains: [String]{}, activations: [String]{}, backgrounds: [AppBackground]{}}}

// One piece of a graph's background work (`App.background`): it runs every
// `every_ns` nanoseconds while the app runs, and at login when `at_login`.
priv AppBackground: struct {
    every_ns: Int,
    at_login: Bool,
    run: Shared<AppBackgroundRun>
}

priv AppBackgroundRun: struct {
    run: fn() Notice!
}

// The most bytes one call's body to the service `service` (its key) may
// hold, when the app graph's `.api<S>(path, max_upload:)` names it.
__api_max_upload: fn(service: String) -> Int? Never! {
    held: APP_GRAPH.guard_read()
    api: held.value.apis.get(service) ?? return None
    Val(api.max_upload)
}

// Makes the screen of `state`, at the address of the field texts `fields`,
// the current one, and gives the graph.
priv app_graph_open: fn(state: String, fields: [String:String]) -> App Never! {
    held := APP_GRAPH.guard_edit()
    held.value.current = Val(AppCurrent{state: state, fields: fields})
    App{title: held.value.title.copy()}
}

// Makes the bindings `reads` the route data of the screen open now and
// gives the ones the screen before it read that this one does not, which
// no open screen holds any more. A binding is keyed by its source and
// arguments (live_register), so route data is keyed by the route's
// arguments; a write that meets a binding's read set makes it stale, and
// the screen's next read runs its source again (`state`).
priv app_graph_route_data: fn(reads: [Int]) -> [Int] Never! {
    held := APP_GRAPH.guard_edit()
    left := [Int]{}
    loop id in held.value.route_data {
        if !reads.contains(id) -> left.push(id)
    }
    held.value.route_data = reads
    left
}

// The screen open now (`App.__go`); None before one opens.
priv app_graph_current: fn() -> AppCurrent? Never! {
    held: APP_GRAPH.guard_read()
    held.value.current.copy()
}

priv app_graph_title: fn() -> String Never! {
    held: APP_GRAPH.guard_read()
    held.value.title.copy()
}

// The screen of the graph whose state `state` names.
priv app_screen: fn(state: String) -> AppScreen? Never! {
    held: APP_GRAPH.guard_read()
    loop screen in held.value.screens {
        if screen.state == state -> return Val(screen.copy())
    }
    None
}

// The field the not-found state keeps its link under (`App.lost_link`).
priv C_APP_LOST_LINK: "link"

// Makes the not-found state that shows `link` the open one: no screen is,
// and the bindings the screen before it read are dropped. False, for
// `App.open_link`: no screen opened.
priv app_link_lost: fn(link: String) -> Bool Never! {
    fields := [String:String]{}
    fields[C_APP_LOST_LINK] = link.copy()
    _: app_graph_open("", fields)
    live_drop(app_graph_route_data([Int]{}))
    false
}

// The link schemes of the graph (`App.url_scheme`), in the order it gives
// them.
priv app_graph_schemes: fn() -> [String] Never! {
    held: APP_GRAPH.guard_read()
    held.value.schemes.copy()
}

// Whether `scheme` is a link scheme (RFC 3986 section 3.1) in lowercase: a
// letter, then letters, digits, `+`, `-` or `.`.
priv app_link_scheme_valid: fn(scheme: String) -> Bool Never! {
    if scheme == "" -> return false
    letters: "abcdefghijklmnopqrstuvwxyz"
    first := true
    loop scalar in unicode.scalars(scheme) {
        if !letters.contains(scalar) && (first || !"0123456789+-.".contains(scalar)) -> return false
        first = false
    }
    true
}

// The address a link names, its path and query without its fragment: an
// address itself, a link of one of the graph's schemes (`crewboard://tasks/7`,
// `crewboard:tasks/7` and `crewboard:///tasks/7` all name `/tasks/7`), or an
// `https` link of one of its domains, with or without a port. None for any
// other link.
priv app_link_address: fn(link: String) -> String? Never! {
    rest := link.copy()
    hash: rest.find("#")
    if hash >= 0 -> rest = rest.slice(0, hash)
    if rest.starts_with("/") && app_link_authority(rest) == None -> return Val(rest)
    colon: rest.find(":")
    if colon <= 0 -> return None
    scheme: rest.slice(0, colon).lower()
    after: rest.slice(colon + 1, rest.len())
    held: APP_GRAPH.guard_read()
    if held.value.schemes.contains(scheme) {
        tail: app_link_authority(after) ?? after
        if tail.starts_with("/") -> return Val(tail)
        return Val("/{tail}")
    }
    if scheme != "https" -> return None
    authority := app_link_authority(after) ?? return None
    path := "/"
    loop index in 0..<authority.len() {
        mark: authority.slice(index, index + 1)
        if mark != "/" && mark != "?" -> next
        path = if mark == "/" -> authority.slice(index, authority.len()) else -> "/{authority.slice(index, authority.len())}"
        authority = authority.slice(0, index)
        break
    }
    if authority.contains("@") -> return None
    host := authority.lower()
    port: host.find(":")
    if port >= 0 -> host = host.slice(0, port)
    if !held.value.link_domains.contains(host) -> return None
    Val(path)
}

// What follows the two slashes that open a link's authority (RFC 3986
// section 3.2) at the start of `text`; None when `text` doesn't start with
// them.
priv app_link_authority: fn(text: String) -> String? Never! {
    if !text.starts_with("/") -> return None
    tail: text.slice(1, text.len())
    if !tail.starts_with("/") -> return None
    Val(tail.slice(1, tail.len()))
}

// The field texts of `screen`'s state at the address whose path is `path`
// and whose query is `query`: each `:name` segment's text and each
// `#App.Query` field's query value, percent-decoded. None when the path
// doesn't fit the screen's, segment by segment, as a server's route table
// matches it, or a text is not percent-encoded right.
priv app_link_fields: fn(screen: AppScreen, path: String, query: String) -> [String:String]? Never! {
    want: screen.path.split("/").to_list()
    have: path.split("/").to_list()
    if want.len() != have.len() -> return None
    fields := [String:String]{}
    loop index in 0..<want.len() {
        if !want[index].starts_with(":") {
            if want[index] != have[index] -> return None
            next
        }
        if have[index] == "" -> return None
        fields[want[index].removeprefix(":")] = url.percent_decode(have[index]) ?? return None
    }
    if query == "" || screen.query.len() == 0 -> return Val(fields)
    pairs: url.parse_qsl(query) ?? return None
    loop pair in pairs {
        if pair.len() == 2 && screen.query.contains(pair[0]) {
            fields[pair[0].copy()] = pair[1].copy()
        }
    }
    Val(fields)
}

// Installs the app's desktop entry (`App.desktop_entry`) as
// `{data}/applications/{id}.desktop`, where `id` is the app's title in
// lowercase letters and digits joined by `-` (`app_desktop_id`), and makes
// it the default handler of each of the graph's link schemes in
// `{config}/mimeapps.list` (`app_mimeapps_with`), as `App.launch` says.
// Without a home directory or an XDG directory there is nowhere to install
// it; a file that can't be written leaves the links unregistered, and the
// app runs as it would without them.
priv app_link_register: fn(title: String) -[Env, FS.Read, FS.Write]> Never! {
    home: sys.home_dir() ?? ""
    data: app_xdg_dir("XDG_DATA_HOME", home, ".local/share") ?? return
    config: app_xdg_dir("XDG_CONFIG_HOME", home, ".config") ?? return
    id: "{app_desktop_id(title)}.desktop"
    files.create_dir_all("{data}/applications") ?? return
    files.write("{data}/applications/{id}", App{title: title}.desktop_entry(sys.executable())) ?? return
    files.create_dir_all(config) ?? return
    list: "{config}/mimeapps.list"
    kept: if files.exists(list) -> files.read(list) ?? return else -> ""
    files.write(list, app_mimeapps_with(kept, app_graph_schemes(), id)) ?? return
}

// How long a launch and the running copy of the app wait for each other's
// next text (`App.launch`).
C_APP_HANDOFF_WAIT_NS: 5000000000

// The directory of the app's link socket (`App.launch`): `$XDG_RUNTIME_DIR`
// when it is an absolute path, else the temporary directory.
priv app_runtime_dir: fn() -[Env]> String Never! {
    if sys.get("XDG_RUNTIME_DIR") == .Val(dir) && dir.starts_with("/") -> return dir
    sys.temp_dir()
}

// Hands `link` and `token` to the running copy of the app that listens at
// `socket` (`App.launch`), as one JSON line `[link, token]`, and waits for
// it to take them. True once they are sent; false when no copy listens.
priv app_launch_hand: fn(socket: String, link: String, token: String) -[Net, Time.Wait]> Bool Never! {
    stream := net.unix_connect(socket) ?? return false
    message: live_json.to_string<[String]>([String]{link, token}) ?? return false
    net.unix_write(stream, "{message}\n") ?? return false
    _: app_launch_line(stream)
    net.unix_close(stream) ?? return true
    true
}

// Makes this process the running copy of the app that `graph` is
// (`App.launch`), listening at `socket`; listening replaces a socket left
// there, which is stale: a launch that could not hand it a link found no
// copy behind it. For each later launch, a task opens the link the launch
// hands over (`open_link`) and keeps its activation token, then answers
// `ok`. When nothing can listen at `socket`, the app runs without taking
// later launches.
priv app_launch_listen: fn(graph: App, socket: String) -[FS.Read, Net, Time.Wait]> Never! {
    listener: net.unix_listen(socket) ?? return
    serving: task { app_launch_serve(graph, listener) }
    serving.detach()
}

// Takes each later launch that connects to `listener` (`App.launch`): opens
// the link it hands over and keeps its activation token, then answers `ok`.
priv app_launch_serve: fn(graph: App, listener: UnixListener) -[Net, FS.Read, Time.Wait]> Never! {
    loop {
        peer := net.unix_accept(listener) ?? return
        given: live_json.decode<[String]>(app_launch_line(peer)) ?? [String]{}
        if given.len() == 2 {
            if given[0] != "" -> _: graph.open_link(given[0])
            held := APP_GRAPH.guard_edit()
            held.value.activations.push(given[1].copy())
        }
        net.unix_write(peer, "ok\n") ?? next
        net.unix_close(peer) ?? next
    }
}

// The next line `stream` gives, without its end; what came when it ends or
// goes quiet first.
priv app_launch_line: fn(stream: &UnixStream) -[Net, Time.Wait]> String Never! {
    text := ""
    loop !text.contains("\n") {
        if !(net.unix_wait(stream, C_APP_HANDOFF_WAIT_NS) ?? false) -> break
        part: net.unix_read(stream) ?? break
        if part == "" -> break
        text = "{text}{part}"
    }
    text.removesuffix("\n")
}

// Starts the graph's background work (`App.background`) as this process
// becomes the app's running copy (`App.launch`): a task for each piece
// runs it on its timer. The app's autostart entry is installed when a
// piece asks to run at login, and removed otherwise.
priv app_background_start: fn(title: String) -[Env, FS.Read, FS.Write, Time.Wait]> Never! {
    at_login := false
    loop work in app_graph_backgrounds() {
        if work.at_login -> at_login = true
        runner: task { app_background_run(work.every_ns, work.run) }
        runner.detach()
    }
    app_autostart(title, at_login)
}

priv app_graph_backgrounds: fn() -> [AppBackground] Never! {
    held: APP_GRAPH.guard_read()
    held.value.backgrounds.copy()
}

// Runs one piece of background work every `every_ns` nanoseconds, the
// first time one interval after it starts; a failed run's notice joins the
// app's notice list (`__keep_notice`).
priv app_background_run: fn(every_ns: Int, work: Shared<AppBackgroundRun>) -[Time.Wait]> Never! {
    every_ms: if every_ns < 1000000 -> 1 else -> every_ns /% 1000000
    loop {
        tasks.sleep(every_ms)
        held: work.guard_read()
        app_background_once(held.value.run)
    }
}

priv app_background_once: fn(run: fn() Notice!) Never! {
    if run() == .Err(notice) -> __keep_notice(notice)
}

// Installs the app's XDG autostart entry (`{config}/autostart/{id}.desktop`,
// its desktop entry), which starts the app when the user logs in, when
// `at_login`; otherwise removes the one an earlier launch installed.
priv app_autostart: fn(title: String, at_login: Bool) -[Env, FS.Read, FS.Write]> Never! {
    config: app_xdg_dir("XDG_CONFIG_HOME", sys.home_dir() ?? "", ".config") ?? return
    entry: "{config}/autostart/{app_desktop_id(title)}.desktop"
    if !at_login {
        if files.exists(entry) -> files.remove(entry) ?? return
        return
    }
    files.create_dir_all("{config}/autostart") ?? return
    files.write(entry, App{title: title}.desktop_entry(sys.executable())) ?? return
}

// `$name` when it is an absolute path, else `{home}/{fallback}`; None
// without either, as the XDG base directory specification reads them.
priv app_xdg_dir: fn(name: String, home: String, fallback: String) -[Env]> String? Never! {
    if sys.get(name) == .Val(set) && set.starts_with("/") -> return Val(set)
    if home == "" -> return None
    Val("{home}/{fallback}")
}

// The desktop entry ID of the app titled `title`: its letters and digits,
// in lowercase, each run of anything else one `-` between them; `app` when
// it has none.
priv app_desktop_id: fn(title: String) -> String Never! {
    id := ""
    gap := false
    loop scalar in unicode.scalars(title.lower()) {
        if !"abcdefghijklmnopqrstuvwxyz0123456789".contains(scalar) {
            gap = true
            next
        }
        if gap && id != "" -> id = "{id}-"
        gap = false
        id = "{id}{scalar}"
    }
    if id == "" -> return "app"
    id
}

// `text` as a desktop entry's string value: a backslash, a line break, a
// tab and a carriage return are each written as their escape.
priv app_desktop_value: fn(text: String) -> String Never! {
    text.replace("\\", "\\\\").replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r")
}

// The path of the program as the first word of a desktop entry's `Exec`
// key: in double quotes, with `"`, `` ` ``, `$` and `\` each after a
// backslash and `%` doubled, then written as a string value
// (`app_desktop_value`), as the Desktop Entry Specification says.
priv app_desktop_exec: fn(path: String) -> String Never! {
    quoted := ""
    loop scalar in unicode.scalars(path) {
        if scalar == "\"" || scalar == "`" || scalar == "$" || scalar == "\\" {
            quoted = "{quoted}\\{scalar}"
        } else if scalar == "%" { quoted = "{quoted}%%" } else { quoted = "{quoted}{scalar}" }
    }
    app_desktop_value("\"{quoted}\"")
}

// `text`, a mimeapps.list, with the desktop entry `id` as the default
// handler of each scheme's links: its `[Default Applications]` group,
// added at the end when it has none, names `id` for each
// `x-scheme-handler/{scheme}` first, and any handler it named for one
// before is gone. Every other line stays as it was.
priv app_mimeapps_with: fn(text: String, schemes: [String], id: String) -> String Never! {
    handlers := [String]{}
    keys := [String]{}
    loop scheme in schemes {
        keys.push("x-scheme-handler/{scheme}")
        handlers.push("x-scheme-handler/{scheme}={id}")
    }
    lines: text.split("\n").to_list()
    end := 0
    loop index in 0..<lines.len() {
        if lines[index].trim() != "" -> end = index + 1
    }
    out := [String]{}
    group := false
    added := false
    loop line in lines[0..<end] {
        trimmed: line.trim()
        if trimmed.starts_with("[") {
            group = trimmed == "[Default Applications]"
            out.push(line.copy())
            if group && !added {
                loop handler in handlers -> out.push(handler.copy())
                added = true
            }
            next
        }
        at: trimmed.find("=")
        if group && at > 0 && keys.contains(trimmed.slice(0, at).trim()) -> next
        out.push(line.copy())
    }
    if !added {
        if out.len() > 0 -> out.push("")
        out.push("[Default Applications]")
        loop handler in handlers -> out.push(handler.copy())
    }
    "{out.join("\n")}\n"
}

// A device permission the app asks the person for with `ask`. The package
// says why it wants each one it asks for in its `purposes:` (`camera`,
// `location`, `notifications`), which the system shows when it asks, and
// `jet check` refuses an `ask` whose permission has no purpose.
Permission: enum {
    Camera,
    Location,
    Notifications,
}

// The person's answer to `ask`. `Restricted` is an answer they could not
// give: the device has no such hardware, or nothing on it can ask (no
// session bus or desktop portal on Linux).
Grant: enum {
    Granted,
    Denied,
    Restricted,
}

// How long `ask` waits for the person, and for the session bus.
priv ASK_WAIT_NS: 300000000000

priv ASK_BUS_WAIT_NS: 1000000000

// An answer `ask` had in this process.
priv AppAsked: struct {
    permission: Permission,
    grant: Grant,
}

priv ASKED: Shared{[AppAsked]{}}

// Asks the person for `permission` and gives their answer. The process asks
// once: a later call gives the first answer. On Linux the desktop portal
// asks (org.freedesktop.portal.Camera, org.freedesktop.portal.Location) and
// remembers the person's choice across runs; notifications need no
// permission there, so they are `.Granted`. A request the person dismisses,
// or leaves unanswered for five minutes, is `.Denied`. Without a session
// bus or a portal, and on the other native targets, the answer is
// `.Restricted`.
ask: fn(permission: Permission) -[Env, Net, Time]> Grant {
    if app_asked(permission) == .Val(known) -> return known
    grant: app_ask_system(permission)
    app_remember(permission, grant)
    grant
}

priv app_remember: fn(permission: Permission, grant: Grant) Never! {
    held := ASKED.guard_edit()
    held.value.push(AppAsked{permission: permission, grant: grant})
}

priv app_asked: fn(permission: Permission) -> Grant? Never! {
    held: ASKED.guard_read()
    loop asked in held.value {
        if asked.permission == permission -> return Val(asked.grant)
    }
    None
}

priv app_ask_system: fn(permission: Permission) -[Env, Net, Time]> Grant Never! {
    #if #build.target.os == {
        .Linux -> {
            if permission == .Notifications -> return Grant.Granted
            bus := dbus.session(ASK_BUS_WAIT_NS) ?? return Grant.Restricted
            said: app_portal_ask(bus, permission) ?? return Grant.Restricted
            return app_grant(said)
        }
        .MacOS -> { return Grant.Restricted }
        .Windows -> { return Grant.Restricted }
        .Web -> { return Grant.Restricted }
        .Wasm -> { return Grant.Restricted }
        .Freestanding -> { return Grant.Restricted }
    }
}

priv app_portal_ask: fn(bus: &dbus.DbusConnection, permission: Permission) -[Net, Time]> dbus.PortalAnswer dbus.DbusError! {
    if permission == .Camera -> return dbus.portal_camera(bus, ASK_WAIT_NS)
    dbus.portal_location(bus, ASK_WAIT_NS)
}

// The grant a portal's answer gives.
priv app_grant: fn(said: dbus.PortalAnswer) -> Grant Never! {
    if said == {
        .Allowed -> Grant.Granted
        .Refused -> Grant.Denied
        .Ended -> Grant.Denied
        .Absent -> Grant.Restricted
    }
}

#Test("ask asks once per process and reads the portal's answer as a grant") {
    assert_eq(app_grant(dbus.PortalAnswer.Allowed), Grant.Granted)
    assert_eq(app_grant(dbus.PortalAnswer.Refused), Grant.Denied)
    assert_eq(app_grant(dbus.PortalAnswer.Ended), Grant.Denied)
    assert_eq(app_grant(dbus.PortalAnswer.Absent), Grant.Restricted)
    app_remember(Permission.Location, Grant.Denied)
    assert_eq(ask(Permission.Location), Grant.Denied)
}

// Opens the system's settings page for this app, where the person changes
// the permissions `ask` got, and gives whether one opened. On Linux that is
// GNOME Settings' Apps page for the app's desktop entry
// (`gnome-control-center applications {id}`, `id` made from the graph's
// title as `app_desktop_id` makes it), started apart from the app so it
// stays open when the app exits. It is `false` when that program does not
// start, and on the other native targets.
open_settings: fn() -[Env, Exec]> Bool {
    #if #build.target.os == {
        .Linux -> {
            page: process.cmd([String]{"gnome-control-center", "applications", app_desktop_id(app_graph_title())})
            _ := page.stdout(.Inherit).stderr(.Inherit).detached().spawn() ?? return false
            return true
        }
        .MacOS -> { return false }
        .Windows -> { return false }
        .Web -> { return false }
        .Wasm -> { return false }
        .Freestanding -> { return false }
    }
}

// A file the person gave the app: a photo it took, or one they picked or
// dropped. It has a name, a size in bytes and what it holds, and the app
// reads it through the handle; where it is kept never reaches the app.
PickedFile: struct {
    name: String,
    bytes: Int,
    media: Media?,
    priv path: String,

    // The file's bytes.
    read: fn(self) -[FS.Read]> [U8] IOError! { files.read_bytes(self.path) }
}

// A place on Earth: degrees north and east, and how far off it may be, in
// metres (0 when the system did not say).
Place: struct {
    latitude: Float,
    longitude: Float,
    accuracy_m: Float,
}

// The frames `take_photo` lets the camera take; the last is the photo, so
// the camera has settled its exposure.
priv PHOTO_FRAMES: 15

// How many photos this process took.
priv PHOTOS: Shared{0}

// Takes a photo with the device's camera and gives it, or `None` when the
// person does not allow the camera, there is none, or it gave no photo. It
// asks for the camera as `ask(.Camera)` does when this process has not
// asked yet, and the answer counts as that ask's. On Linux the camera
// portal asks, and the photo comes from the camera through PipeWire:
// GStreamer's `pipewiresrc` (`gst-launch-1.0`, with its PipeWire plugin)
// takes a few frames and keeps the last as a JPEG, `photo-1.jpg` for the
// process's first. On the other native targets it is `None`.
take_photo: fn() -[Env, Exec, FS, Net, Time]> PickedFile? {
    if app_asked(Permission.Camera) == .Val(known) {
        if known != .Granted -> return None
    }
    #if #build.target.os == {
        .Linux -> {
            said: app_linux_camera()
            app_settle(Permission.Camera, app_grant(said))
            if said != .Allowed -> return None
            return app_photo()
        }
        .MacOS -> { return None }
        .Windows -> { return None }
        .Web -> { return None }
        .Wasm -> { return None }
        .Freestanding -> { return None }
    }
}

// Where the device is now, or `None` when the person does not allow the
// location or no location came in time. It asks for the location as
// `ask(.Location)` does when this process has not asked yet, and the
// answer counts as that ask's. On Linux it is the first location the
// desktop portal's location session reports after the person allows it
// (GeoClue finds it). On the other native targets it is `None`.
location: fn() -[Env, Net, Time]> Place? {
    if app_asked(Permission.Location) == .Val(known) {
        if known != .Granted -> return None
    }
    #if #build.target.os == {
        .Linux -> {
            fix: app_linux_place()
            app_settle(Permission.Location, app_grant(fix.answer))
            if fix.place == .Val(at) {
                return Val(Place{latitude: at.latitude, longitude: at.longitude, accuracy_m: at.accuracy})
            }
            return None
        }
        .MacOS -> { return None }
        .Windows -> { return None }
        .Web -> { return None }
        .Wasm -> { return None }
        .Freestanding -> { return None }
    }
}

// How the device is held, from its accelerometer: upright, upside down, or
// on its side with its left or its right edge up.
Orientation: enum {
    Upright,
    UpsideDown,
    LeftUp,
    RightUp,
}

// How long a stream waits for its next reading before it waits again.
priv UPDATE_WAIT_NS: 60000000000

// Where the device is each time it moves, until the loop reading the stream
// stops. It asks for the location as `ask(.Location)` does when this
// process has not asked yet, and the answer counts as that ask's; after an
// answer other than `.Granted` the stream is empty. On Linux the desktop
// portal's location session reports each place (GeoClue finds it), and the
// stream closes the session, and its bus connection with it, when it stops.
// On the other native targets the stream is empty.
location_updates: fn() -[Env, Net, Time]> Stream<Place> {
    // One pass: each `break` ends the stream.
    loop {
        bus := app_location_bus() ?? break
        session: dbus.open_location(bus, true, ASK_WAIT_NS) ?? dbus.PortalSession{answer: .Absent, path: ""}
        app_settle(Permission.Location, app_grant(session.answer))
        if session.path == "" -> break
        defer dbus.close_location(bus, session.path)
        if session.answer != .Allowed -> break
        loop {
            found: if dbus.next_place(bus, session.path, UPDATE_WAIT_NS) == {
                .Err(_) -> {
                    break
                }
                .Ok(got) -> got
            }
            if found == .Val(at) {
                yield Place{latitude: at.latitude, longitude: at.longitude, accuracy_m: at.accuracy}
            }
        }
        break
    }
}

// How the device is held, now and each time that changes, until the loop
// reading the stream stops. On Linux the sensor proxy (iio-sensor-proxy)
// reads the accelerometer for the app while the stream runs; the stream
// gives it back, and closes its system bus connection, when it stops. A
// device with no accelerometer, and the other native targets, give an
// empty stream.
orientation_updates: fn() -[Env, Net, Time]> Stream<Orientation> {
    // One pass: each `break` ends the stream.
    loop {
        bus := app_sensor_bus() ?? break
        // No accelerometer, or no answer: nothing to give back.
        first: dbus.claim_sensor(bus, dbus.Sensor.Accelerometer, ASK_BUS_WAIT_NS) ?? break
        defer dbus.release_sensor(bus, dbus.Sensor.Accelerometer)
        reading := dbus.DbusValue?{Val(first)}
        loop {
            held: app_orientation(reading)
            if held == .Val(way) {
                yield way
            }
            reading = if dbus.sensor_change(bus, dbus.Sensor.Accelerometer, UPDATE_WAIT_NS) == {
                .Err(_) -> {
                    break
                }
                .Ok(got) -> got
            }
        }
        break
    }
}

// Where the device points, in degrees clockwise from north, now and each
// time that changes, until the loop reading the stream stops. On Linux the
// sensor proxy reads the compass for the app while the stream runs; the
// stream gives it back, and closes its system bus connection, when it
// stops. A device with no compass, and the other native targets, give an
// empty stream.
heading_updates: fn() -[Env, Net, Time]> Stream<Float> {
    // One pass: each `break` ends the stream.
    loop {
        bus := app_sensor_bus() ?? break
        // No compass, or no answer: nothing to give back.
        first: dbus.claim_sensor(bus, dbus.Sensor.Compass, ASK_BUS_WAIT_NS) ?? break
        defer dbus.release_sensor(bus, dbus.Sensor.Compass)
        reading := dbus.DbusValue?{Val(first)}
        loop {
            if reading == .Val(value) {
                if value == .Double(degrees) {
                    yield degrees
                }
            }
            reading = if dbus.sensor_change(bus, dbus.Sensor.Compass, UPDATE_WAIT_NS) == {
                .Err(_) -> {
                    break
                }
                .Ok(got) -> got
            }
        }
        break
    }
}

// Keeps `grant` as this process's answer for `permission` unless it has one.
priv app_settle: fn(permission: Permission, grant: Grant) Never! {
    if app_asked(permission) == None -> app_remember(permission, grant)
}

// The camera portal's answer; no session bus or portal is `.Absent`.
priv app_linux_camera: fn() -[Env, Net, Time]> dbus.PortalAnswer Never! {
    bus := dbus.session(ASK_BUS_WAIT_NS) ?? return dbus.PortalAnswer.Absent
    dbus.portal_camera(bus, ASK_WAIT_NS) ?? dbus.PortalAnswer.Absent
}

// The location portal's answer and first location; no session bus or
// portal is `.Absent`.
priv app_linux_place: fn() -[Env, Net, Time]> dbus.PortalFix Never! {
    nothing: dbus.PortalFix{answer: .Absent, place: None}
    bus := dbus.session(ASK_BUS_WAIT_NS) ?? return nothing
    dbus.portal_place(bus, ASK_WAIT_NS) ?? nothing
}

// The session bus that `location_updates` follows the location on, when
// this process may still be allowed it: `None` after an answer other than
// `.Granted`, and on targets other than Linux. With no session bus it is
// `None` and the location counts as restricted, as `location` has it.
priv app_location_bus: fn() -[Env, Net, Time]> dbus.DbusConnection? Never! {
    if app_asked(Permission.Location) == .Val(known) {
        if known != .Granted -> return None
    }
    #if #build.target.os == {
        .Linux -> {
            bus := dbus.session(ASK_BUS_WAIT_NS) ?? return app_no_location_bus()
            return Val(bus)
        }
        .MacOS -> { return None }
        .Windows -> { return None }
        .Web -> { return None }
        .Wasm -> { return None }
        .Freestanding -> { return None }
    }
}

priv app_no_location_bus: fn() -> dbus.DbusConnection? Never! {
    app_settle(Permission.Location, app_grant(dbus.PortalAnswer.Absent))
    None
}

// The system bus the sensor proxy is on; `None` when there is none, and on
// targets other than Linux.
priv app_sensor_bus: fn() -[Env, Net, Time]> dbus.DbusConnection? Never! {
    #if #build.target.os == {
        .Linux -> {
            bus := dbus.system(ASK_BUS_WAIT_NS) ?? return None
            return Val(bus)
        }
        .MacOS -> { return None }
        .Windows -> { return None }
        .Web -> { return None }
        .Wasm -> { return None }
        .Freestanding -> { return None }
    }
}

// How the device is held, from the sensor proxy's accelerometer reading;
// `None` for "undefined", when it cannot tell.
priv app_orientation: fn(reading: dbus.DbusValue?) -> Orientation? Never! {
    if reading == .Val(value) {
        if value == .Text(name) {
            if name == "normal" -> return Val(Orientation.Upright)
            if name == "bottom-up" -> return Val(Orientation.UpsideDown)
            if name == "left-up" -> return Val(Orientation.LeftUp)
            if name == "right-up" -> return Val(Orientation.RightUp)
        }
    }
    None
}

// How long showing a notification may take.
priv NOTIFY_WAIT_NS: 5000000000

// Why a notification isn't shown on a native system whose notification
// service the app can't reach yet.
priv NOTIFY_UNBUILT: "this system's notifications are not built yet"

// Shows a notification through the desktop's notification service on the
// session bus (`App.__notify_here`), in a task that keeps the bus
// connection until the person clicks the notification or it closes.
priv app_notify_linux: fn(title: String, body: String, open_route: String) -[Env, FS.Read, Net, Time]> Never! {
    showing: task { app_notify_show(title, body, open_route) }
    showing.detach()
}

// Shows the notification and waits until the person clicks it or it
// closes; a click opens `open_route` (`open_link`).
priv app_notify_show: fn(title: String, body: String, open_route: String) -[Env, FS.Read, Net, Time]> Never! {
    bus := dbus.session(ASK_BUS_WAIT_NS) ?? {
        app_notify_unshown(title, "{err}")
        return
    }
    app: app_graph_title()
    shown: dbus.notify(bus, app, app_desktop_id(app), title, body, NOTIFY_WAIT_NS) ?? {
        app_notify_unshown(title, "{err}")
        return
    }
    loop {
        ended: if dbus.notification_end(bus, shown, UPDATE_WAIT_NS) == {
            .Err(_) -> {
                return
            }
            .Ok(got) -> got
        }
        clicked: ended ?? next
        if clicked -> _: App{title: app_graph_title()}.open_link(open_route)
        return
    }
}

// Keeps a notice that the notification `title` couldn't be shown, and why.
priv app_notify_unshown: fn(title: String, why: String) Never! {
    __keep_notice(Notice{text: "Couldn't show the notification \"{title}\": {why}"})
}

// A photo from the camera through PipeWire, kept in a directory of this
// process's under the temporary directory. The camera has 30 seconds.
priv app_photo: fn() -[Env, Exec, FS, Time]> PickedFile? Never! {
    held := PHOTOS.guard_edit()
    held.value += 1
    name: "photo-{held.value}.jpg"
    folder: "{sys.temp_dir()}/jet-photos-{sys.getpid()}"
    files.create_dir_all(folder) ?? return None
    path: "{folder}/{name}"
    argv: [String]{"gst-launch-1.0", "-q", "pipewiresrc", "num-buffers={PHOTO_FRAMES}", "!", "videoconvert", "!", "jpegenc", "!", "multifilesink", "location={path}"}
    ran: process.cmd(argv).timeout(30s).run() ?? return None
    if ran.code != 0 -> return None
    photo: files.read_bytes(path) ?? return None
    if photo.len() == 0 -> return None
    Val(PickedFile{name: name, bytes: photo.len(), media: Val(Media.Image), path: path})
}

#Test("a photo and a place are none once the person refused them") {
    app_remember(Permission.Camera, Grant.Denied)
    assert_eq(take_photo(), None)
    app_remember(Permission.Location, Grant.Restricted)
    assert_eq(location(), None)
}

#Test("the place stream is empty once the person refused the location") {
    app_remember(Permission.Location, Grant.Denied)
    places := 0
    loop _ in location_updates() -> places += 1
    assert_eq(places, 0)
}

// One remote call of the endpoint at `path` of a service the app graph
// mounts (`App.__remote_public`), answered in this process as a server
// answers it (Web's `app_remote_response`): `body` is the JSON array of its
// arguments, and the call carries the request key `key` with the account it
// acts for, so it is one transaction on each store it uses, and a store that
// keeps a reply under the key answers with that reply. A run that fails
// rolls back, and a busy store's refusal runs it again, up to
// `transactions.attempts()` times.
priv graph_post: fn(path: String, key: String, body: String) -[Time]> String CallError! {
    endpoint: graph_endpoint(path) ?? return Err(.Unreachable("no service the app graph mounts answers `{path}`"))
    answer: endpoint.answer ?? return Err(.SignedOut)
    tree: live_json.parse(body) ?? return Err(.Invalid([FieldError]{FieldError{path: "", reason: "the call's arguments are not JSON: {err}"}}))
    account := ""
    if maybe_caller() == .Val(who) -> account = who.raw()
    asked: CallRequest{account: account, key: key, at: time.now_utc().to_timestamp()}
    held: answer.guard_read()
    loop _ in 0..<transactions.attempts() {
        call: transactions.begin() ?? return graph_answered(graph_run(held.value.run, tree))
        transactions.ask(call, asked.copy())
        failed := CallError?{None}
        given: graph_run(held.value.run, tree) ?? {
            failed = Val(CallError.Invalid(err))
            ""
        }
        if failed == None -> transactions.answer(call, given)
        if transactions.repeated(call) {
            kept: transactions.reply(call)
            _: transactions.end(call, false)
            return Ok(kept ?? return Err(.Unreachable("the reply kept for `{path}` is lost")))
        }
        if transactions.end(call, failed == None && !given.starts_with("{{\"err\":")) {
            if failed == .Val(failure) -> return Err(failure)
            return Ok(given)
        }
    }
    Err(.Unreachable("the database stayed busy"))
}

// Runs a mounted method's call, `run`, with the arguments `tree`.
priv graph_run: fn(run: fn(RemoteArgs) -> String [FieldError]!, tree: Dyn) -> String [FieldError]! {
    run(RemoteArgs{tree: tree.copy()})
}

// The endpoint at `path` of a service the graph mounts.
priv graph_endpoint: fn(path: String) -> AppEndpoint? Never! {
    held: APP_GRAPH.guard_read()
    held.value.endpoints.get(path).copy()
}

// A mounted method's reply as a remote call's: its field errors are the
// call's `Invalid`.
priv graph_answered: fn(replied: String [FieldError]!) -> String CallError! {
    if replied == {
        .Ok(given) -> Ok(given)
        .Err(fields) -> Err(.Invalid(fields))
    }
}

// A board's state, for the graph test: its project is a path segment and its
// filter the query.
priv RouteTestBoard: struct {
    project: String,
    q: String
}

// The service the graph test's board calls.
priv RouteTestService: struct {}

// The graph test's board view, as the compiler lowers `.screen`'s `open`:
// it makes the state from the address's texts, and shows its project and
// filter.
priv route_test_open: fn(graph: App, fields: [String:String]) -[Net, FS.Read]> String? Never! {
    state: graph.__address_state<RouteTestBoard>([String]{"project", "q"}, [String?]{graph.__address_json<String>(fields, "project"), graph.__address_json<String>(fields, "q")}) ?? return None
    Val(graph.__view_html<String>("{state.project} <{state.q}>"))
}

#Test("the app graph opens each screen at its state's address, with the graph's Remotes") {
    graph: new("Crew").__api<RouteTestService>("/api", "app.RouteTestService", 1000000).__remote_public(
        "app.RouteTestService/greet",
        fn(args: RemoteArgs) {
            name: args.__take<String>(0) ?? return Err(err)
            Ok(args.__reply_value<String>("hello {name}"))
        },
        0,
        0,
    )
        .__screen<RouteTestBoard>("/projects/:project/board", "app.RouteTestBoard", [String]{"q"}, true, route_test_open).offline(.Queue)
    assert_eq(graph.title, "Crew")
    names: [String]{"project", "q"}
    assert_eq(App.__url_of<RouteTestBoard>("app.RouteTestBoard", names, [String]{App.__address_arg<String>("p 1/2"), App.__address_arg<String>("")}), "/projects/p%201%2F2/board")
    assert_eq(App.__url_of<RouteTestBoard>("app.RouteTestBoard", names, [String]{App.__address_arg<String>("p1"), App.__address_arg<String>("login & fix")}), "/projects/p1/board?q=login%20%26%20fix")
    assert_eq(App.__address_arg<Int>(42), "42")
    assert_eq(App.__address_arg<Bool>(true), "true")
    assert_eq(App.__address_arg<String>("say \"hi\""), "say \"hi\"")
    // A field's address text makes its value back: a string's own text, any
    // other value's JSON.
    texts: [String:String]{"id": "42", "name": "42", "done": "true"}
    assert_eq(graph.__address_json<Int>(texts, "id"), Val("42"))
    assert_eq(graph.__address_json<String>(texts, "name"), Val("\"42\""))
    assert_eq(graph.__address_json<Bool>(texts, "done"), Val("true"))
    assert_eq(graph.__address_json<Int>(texts, "absent"), String?{None})
    assert_eq(graph.__address_json<Int>([String:String]{"id": "four"}, "id"), String?{None})
    // The registry a renderer walks.
    screens: graph.__screens()
    assert_eq(screens.len(), 1)
    assert_eq(screens[0].path, "/projects/:project/board")
    assert_eq(screens[0].signed_in, true)
    assert_eq(graph.__open(screens[0], [String:String]{"project": "p1", "q": "mine"}), Val("<p>p1 &lt;mine&gt;</p>"))
    // A view calls the graph's Remote of a service it mounts in this process.
    assert_eq(remote_post("app.RouteTestService", true, "greet", [String]{"\"p1\""}) ?? "{err}", "{{\"ok\":\"hello p1\"}}")
    assert_eq(graph.__open(screens[0], [String:String]{"q": "mine"}), String?{None})
    // `go` makes a screen the current one.
    assert_eq(App.__current<RouteTestBoard>("app.RouteTestBoard", fn(at: App, fields: [String:String]) { at.__address_state<RouteTestBoard>([String]{"project", "q"}, [String?]{at.__address_json<String>(fields, "project"), at.__address_json<String>(fields, "q")}) }) == None, true)
    App.__go<RouteTestBoard>("app.RouteTestBoard", names, [String]{"p2", ""})
    now: App.__current<RouteTestBoard>("app.RouteTestBoard", fn(at: App, fields: [String:String]) { at.__address_state<RouteTestBoard>([String]{"project", "q"}, [String?]{at.__address_json<String>(fields, "project"), at.__address_json<String>(fields, "q")}) }) ?? panic("the board is open")
    assert_eq(now.project, "p2")
    assert_eq(App.__current<RouteTestService>("app.RouteTestService", fn(_at: App, _fields: [String:String]) { RouteTestService?{None} }) == None, true)
}

// The board open now, as the compiler lowers `app.current<RouteTestBoard>()`.
priv route_test_current: fn() -> RouteTestBoard? Never! {
    App.__current<RouteTestBoard>("app.RouteTestBoard", fn(at: App, fields: [String:String]) { at.__address_state<RouteTestBoard>([String]{"project", "q"}, [String?]{at.__address_json<String>(fields, "project"), at.__address_json<String>(fields, "q")}) })
}

#Test("an address, a link of the graph's scheme and a web link of its domain open one screen state, and any other link the not-found state") {
    graph: new("Crew Board!").__screen<RouteTestBoard>("/projects/:project/board", "app.RouteTestBoard", [String]{"q"}, false, route_test_open).url_scheme("CrewBoard").app_links(domain: "Crew.Example.com")
    opening: [String]{"/projects/p%201/board?q=mine", "crewboard://projects/p%201/board?q=mine", "crewboard:projects/p%201/board?q=mine#top", "https://crew.example.com/projects/p%201/board?q=mine", "HTTPS://CREW.EXAMPLE.COM:443/projects/p%201/board?q=mine&other=1"}
    loop link in opening {
        assert(graph.open_link(link))
        now: route_test_current() ?? panic("{link} opens the board")
        assert_eq(now.project, "p 1")
        assert_eq(now.q, "mine")
        assert_eq(graph.lost_link(), String?{None})
    }
    // Another host, another scheme, a path no screen has and an address
    // whose texts make no board each open the not-found state.
    lost: [String]{"https://elsewhere.example.com/projects/p1/board?q=mine", "http://crew.example.com/projects/p1/board?q=mine", "mailto:ann@example.com", "crewboard://projects/p1", "/nowhere", "/projects/p1/board", "/projects/p%zz/board?q=mine"}
    loop link in lost {
        assert(!graph.open_link(link))
        assert_eq(route_test_current() == None, true)
        assert_eq(graph.lost_link(), Val(link))
    }
    // The desktop entry names the app the handler of its scheme's links,
    // and runs the program, quoted, with the link.
    assert_eq(graph.desktop_entry("/opt/crew board/run$"), "[Desktop Entry]\nType=Application\nName=Crew Board!\nExec=\"/opt/crew board/run\\\\$\" %u\nTerminal=false\nMimeType=x-scheme-handler/crewboard;\n")
    assert_eq(app_desktop_id("Crew Board!"), "crew-board")
    assert_eq(app_desktop_id("¡!"), "app")
    // The list keeps every other line and names the entry for the scheme
    // once, in the default group, adding the group when it has none.
    assert_eq(app_mimeapps_with("", [String]{"crewboard"}, "crew-board.desktop"), "[Default Applications]\nx-scheme-handler/crewboard=crew-board.desktop\n")
    assert_eq(app_mimeapps_with("[Added Associations]\ntext/plain=edit.desktop\n\n", [String]{"crewboard"}, "crew-board.desktop"), "[Added Associations]\ntext/plain=edit.desktop\n\n[Default Applications]\nx-scheme-handler/crewboard=crew-board.desktop\n")
    assert_eq(app_mimeapps_with("[Default Applications]\nx-scheme-handler/crewboard=old.desktop\ntext/html=web.desktop\n", [String]{"crewboard"}, "crew-board.desktop"), "[Default Applications]\nx-scheme-handler/crewboard=crew-board.desktop\ntext/html=web.desktop\n")
}

// The accounts the presence test's source refuses, as a row policy would.
priv PRESENCE_TEST_REFUSED: Shared{[String]{}}

// `account`'s binding of the presence test's source: refused, or who has
// the task at `/tasks/7` open.
priv presence_test_bind: fn(account: String) -> Live<String, AppError> {
    as_caller(auth.AccountID.from_string(account), fn() {
        __live_bind<String, AppError>("app.test.presence", [String]{account.copy()}, fn() {
            who: maybe_caller() ?? return Err(AppError.Invalid)
            if PRESENCE_TEST_REFUSED.guard_read().value.contains(who.raw()) {
                return Err(AppError.Unsupported)
            }
            names := [String]{}
            loop present in App.__presence("/tasks/7") -> names.push(present.raw())
            Ok(names.join(","))
        })
    })
}

priv presence_test_read: fn(binding: Live<String, AppError>) -> String {
    if state(binding) == {
        .Loaded(names) -> names
        .Failed(_) -> "refused"
        .Idle | .Loading -> "pending"
    }
}

priv presence_test_refuse: fn(account: String) {
    refused := PRESENCE_TEST_REFUSED.guard_edit()
    refused.value.push(account.copy())
}

#Test("presence counts each account whose binding's latest run asked, and re-runs the other bindings when that changes") {
    ann: presence_test_bind("ann")
    assert_eq(presence_test_read(ann), "ann")
    presence_test_refuse("eve")
    eve: presence_test_bind("eve")
    assert_eq(presence_test_read(eve), "refused")
    assert_eq(presence_test_read(ann), "ann")
    ben: presence_test_bind("ben")
    assert_eq(presence_test_read(ben), "ann,ben")
    assert_eq(presence_test_read(ann), "ann,ben")
    presence_test_refuse("ben")
    __live_invalidate("app.test.presence", [String]{"ben"})
    assert_eq(presence_test_read(ben), "refused")
    assert_eq(presence_test_read(ann), "ann")
    asked := [String]{}
    loop present in App.__presence("/tasks/7") -> asked.push(present.raw())
    assert_eq(asked.join(","), "ann")
}

// `account`'s binding of who has the task at `/tasks/8` open.
priv presence_left_test_bind: fn(account: String) -> Live<String, AppError> {
    as_caller(auth.AccountID.from_string(account), fn() {
        __live_bind<String, AppError>("app.test.presence_left", [String]{account.copy()}, fn() {
            names := [String]{}
            loop present in App.__presence("/tasks/8") -> names.push(present.raw())
            Ok(names.join(","))
        })
    })
}

#Test("a binding whose last watching connection closed is present nowhere, and every binding that read its presence re-runs") {
    ann: presence_left_test_bind("ann")
    ben: presence_left_test_bind("ben")
    assert_eq(presence_test_read(ann), "ann")
    assert_eq(presence_test_read(ben), "ann,ben")
    assert_eq(presence_test_read(ann), "ann,ben")
    // The hub's leave signal: ben's only connection closed. A line that
    // names no binding is passed over.
    live_left("chat\nlive:{ben.id}\nlive:none")
    asked := [String]{}
    loop present in App.__presence("/tasks/8") -> asked.push(present.raw())
    assert_eq(asked.join(","), "ann")
    assert_eq(presence_test_read(ann), "ann")
    // Ben's binding re-runs on its next read, as a reconnected client reads
    // it, and counts ben again.
    assert_eq(presence_test_read(ben), "ann,ben")
    assert_eq(presence_test_read(ann), "ann,ben")
}

// The key of the run this task is in: its delivery's ID for a job or a
// webhook's call, `<schedule>@<due>` for a scheduled run, and "" outside
// a run.
priv push_run_key: fn() -> String Never! {
    call: transactions.current() ?? return ""
    if transactions.delivery(call) == .Val(delivery) -> return delivery.id.copy()
    if transactions.tick(call) == .Val(tick) -> return "{tick.schedule}@{tick.due}"
    ""
}

// Counts a skipped (`skipped`) or failed push to a device of `service` of
// `account`, and keeps why.
priv push_note: fn(skipped: Bool, service: String, account: String, reason: String) Never! {
    kind: if skipped -> "skipped" else -> "failed"
    held := PUSH_NOTES.guard_edit()
    if held.value.last.len() == C_PUSH_NOTES_KEPT -> _: held.value.last.remove(0, .Slot)
    held.value.last.push("{kind} {service} {account}: {reason}")
    if skipped {
        held.value.skipped += 1
        log_rt.metric_publish("jet.push.skipped", held.value.skipped)
    } else {
        held.value.failed += 1
        log_rt.metric_publish("jet.push.failed", held.value.failed)
    }
}

// The named stores, copied out so no store runs under the registry's lock.
priv push_stores: fn() -> [Shared<PushDevices>] Never! {
    registry: PUSH_REGISTRY.guard_read()
    registry.value.stores.copy()
}

priv push_store_name: fn(devices: Shared<PushDevices>) -> String Never! {
    held: devices.guard_read()
    held.value.store.copy()
}

priv push_device_listed: fn(found: [PushDevice], device: PushDevice) -> Bool Never! {
    loop known in found {
        if known.service == device.service && known.token == device.token -> return true
    }
    false
}

// ── Uploads and blobs ─────────────────────────────────────────────────────
//
// An endpoint method that takes an `Upload` answers POST `{prefix}/{method}`
// with the file as the request's raw body, the name its sender gave it as
// the query's `name`, and the method's other arguments as the JSON array of
// the query's `args`. The server reads the request's head first, and refuses
// it before it reads the body when the endpoint's check (`UploadCheck`)
// fails or the body is over the size limit. It then streams the body, as it
// reads it, to a file staged under UPLOAD_STAGING, never holding the whole
// body; a chunked body is refused 413 before the chunk that would pass the
// limit is read. All this happens before the call's transaction begins, so
// each run of the transaction, a retry's too, keeps the same staged file
// (`Blobs.keep`).
// When the request ends, the staged file is removed, and so is each blob that
// a run kept and then rolled back. The compiler writes the lambda that runs
// each of these steps (`FileJob.run`) where the service is mounted, so the
// steps use the files and stores of the program that mounts it, and a server
// with no upload endpoint never reaches them.

// A file a person sent to an upload endpoint: the name the sender gave it,
// which is never a path on the server, and its size in bytes. Only the
// request that sent it can keep it (`Blobs.keep`).
#Codable
Upload: struct {
    name: String,
    bytes: Int
}

// What a blob's bytes are, as their first bytes show: an image (PNG, JPEG,
// GIF or WebP), a PDF, or UTF-8 text that is not markup.
#Codable
Media: enum {
    Image,
    PDF,
    Text
}

// The id of a kept blob. A row stores it to hold the blob, and it names the
// blob's file in its store.
#[Codable, Comparable, Printable]
BlobID: distinct String

// A blob `Blobs.keep` stored: its id, what its bytes are and how many.
#Codable
Blob: struct {
    id: BlobID,
    media: Media,
    bytes: Int
}

// Why `Blobs.keep` kept no blob: the file's bytes are none of the media the
// call allows (a call that fails on it is answered 415), or the store
// failed.
#Error
BlobError: enum {
    WrongType,
    Storage(String)
}

// A store of blobs: the directory `name`, under the working directory, which
// holds each blob as a file named by its id. `blobs(name)` makes one.
Blobs: struct {
    name: String,

    // Keeps `file`, the upload the running request staged, as a blob in this
    // store when its bytes are one of the media `allow` lists. Their first
    // bytes decide that, never the type the sender declared. The blob stays
    // only if the call that keeps it commits: a call that rolls back leaves
    // none, and a retry keeps the staged file again.
    keep: fn(self, file: Upload, allow: [Media]) -[FS.Write]> Blob BlobError! {
        blobs_keep(self.name, file, allow)
    }
}

// The blob store `name`. A served app answers GET `{BLOB_PATH}/<id>` with a
// blob from any store made so far (`blob_url`).
blobs: fn(name: String) -> Blobs Never! {
    held := BLOBS.guard_edit()
    if !held.value.stores.contains(name) -> held.value.stores.push(name.copy())
    Blobs{name: name.copy()}
}

// The path a served app answers each blob under: GET `{BLOB_PATH}/<id>`
// gives the blob to a caller that the read policy of a row holding the
// blob's id admits, and 404 to any other caller.
BLOB_PATH: "/__jet/blobs"

// The address a served app answers the blob `id` at.
blob_url: fn(id: BlobID) -> String Never! { "{BLOB_PATH}/{id.raw()}" }

// The directory, under the working directory, where each request's upload
// is staged until the request ends.
UPLOAD_STAGING: ".jet/uploads"

// How many of a file's first bytes tell what it is (`blob_type`).
priv BLOB_HEAD: 512

// An upload staged for the request that the task `task` answers: its file,
// its size and first bytes, the blobs `keep` made of it, and whether `keep`
// refused its media.
priv StagedUpload: struct {
    task: TaskID,
    path: String,
    bytes: Int,
    head: [U8],
    kept: [KeptBlob],
    refused: Bool
}

// A blob a call kept: its file, the call, and whether the call committed.
// A blob kept outside any call is committed at once.
priv KeptBlob: struct {
    path: String,
    call: Int,
    committed: Bool
}

// How a table's blob reader (`__blob_reader`) answers whether the caller
// may read a blob.
priv BlobReader: struct {
    read: fn(String) -[DB.Read]> Int Never!
}

// The process's blob stores by name; the uploads staged now; whether the
// staging a stopped server left behind is removed; and the blob reader of
// each table that has been read or written since a store was made
// (`__blob_reader`), with whether a row policy guards that table.
priv BlobState: struct {
    stores: [String],
    staged: [StagedUpload],
    cleaned: Bool,
    readers: [String:Shared<BlobReader>],
    guarded: [String:Bool]
}

priv BLOBS: Shared{BlobState{stores: [String]{}, staged: [StagedUpload]{}, cleaned: false, readers: [String:Shared<BlobReader>]{}, guarded: [String:Bool]{}}}

// One file step of an upload endpoint, as core.web hands it to the lambda the
// compiler writes where the service is mounted, which calls `run`.
priv FileJob: struct {
    step: builtin.FileStep,

    run: fn(self) -[FS, DB.Read]> builtin.FileDone Never! { file_steps(self.step) }
}

// Runs one file step of an upload endpoint (`FileJob`).
priv file_steps: fn(step: builtin.FileStep) -[FS, DB.Read]> builtin.FileDone Never! {
    if step == {
        .Open -> uploads_open()
        .Write(name, piece) -> uploads_write(name, piece)
        .Abandon(name) -> uploads_abandon(name)
        .Claim(name) -> uploads_claim(name)
        .Finish -> uploads_finish()
        .Serve(id) -> blobs_serve(id)
        .Clean -> {
            uploads_clean()
            file_done(200)
        }
    }
}

priv file_done: fn(status: Int) -> builtin.FileDone Never! {
    builtin.FileDone{status: status, body: [U8]{}, media: ""}
}

// Stages an empty file for a request whose body the server is about to
// read, and gives its name.
priv uploads_open: fn() -[FS.Write]> builtin.FileDone Never! {
    files.create_dir_all(UPLOAD_STAGING) ?? return file_done(500)
    name: blob_id()
    path: "{UPLOAD_STAGING}/{name}"
    files.write_bytes(path, [U8]{}) ?? return file_done(500)
    staged: StagedUpload{task: tasks.current_task(), path: path, bytes: 0, head: [U8]{}, kept: [KeptBlob]{}, refused: false}
    held := BLOBS.guard_edit()
    held.value.staged.push(staged)
    builtin.FileDone{status: 200, body: [U8]{}, media: "", staged: name}
}

// Appends `piece`, the next bytes of a body, to the staged file `name`, and
// keeps the first BLOB_HEAD bytes, which tell what the file is.
priv uploads_write: fn(name: String, piece: [U8]) -[FS.Write]> builtin.FileDone Never! {
    if !blob_id_valid(name) -> return file_done(404)
    path: "{UPLOAD_STAGING}/{name}"
    writer := files.append(path) ?? return file_done(500)
    writer.write_bytes(piece) ?? return file_done(500)
    writer.flush() ?? return file_done(500)
    held := BLOBS.guard_edit()
    loop index in 0..<held.value.staged.len() {
        if held.value.staged[index].path == path {
            held.value.staged[index].bytes += piece.len()
            loop byte in piece {
                if held.value.staged[index].head.len() >= BLOB_HEAD -> break
                held.value.staged[index].head.push(byte)
            }
            return file_done(200)
        }
    }
    file_done(404)
}

// Removes the staged file `name`, whose request ended before its body did.
priv uploads_abandon: fn(name: String) -[FS.Write]> builtin.FileDone Never! {
    if !blob_id_valid(name) -> return file_done(404)
    path: "{UPLOAD_STAGING}/{name}"
    held := BLOBS.guard_edit()
    loop index in 0..<held.value.staged.len() {
        if held.value.staged[index].path == path {
            _: held.value.staged.remove(index, .Slot)
            break
        }
    }
    files.remove(path).drop("a staged file that can't be removed waits for the next start")
    file_done(200)
}

// Hands the staged file `name` to the request this task answers, and gives
// its size.
priv uploads_claim: fn(name: String) -> builtin.FileDone Never! {
    path: "{UPLOAD_STAGING}/{name}"
    held := BLOBS.guard_edit()
    loop index in 0..<held.value.staged.len() {
        if held.value.staged[index].path == path {
            held.value.staged[index].task = tasks.current_task()
            return builtin.FileDone{status: 200, body: [U8]{}, media: "", bytes: held.value.staged[index].bytes}
        }
    }
    file_done(404)
}

// Removes the files a stopped server left staged, once per process.
priv uploads_clean: fn() -[FS]> Never! {
    held := BLOBS.guard_edit()
    if held.value.cleaned {
        return
    }
    held.value.cleaned = true
    left: files.list_dir(UPLOAD_STAGING) ?? return
    loop entry in left {
        if !entry.is_dir {
            files.remove(entry.path).drop("a staged file that can't be removed waits for the next start")
        }
    }
}

// Ends the request this task answers: removes its staged file and each blob
// that a run of its call kept and that call did not commit. 415 when `keep`
// refused the file's media, else 200.
priv uploads_finish: fn() -[FS.Write]> builtin.FileDone Never! {
    ended: uploads_take(tasks.current_task()) ?? return file_done(200)
    files.remove(ended.path).drop("a staged file that can't be removed waits for the next start")
    loop kept in ended.kept {
        if !kept.committed -> files.remove(kept.path).drop("a blob no row holds is never served")
    }
    file_done(if ended.refused -> 415 else -> 200)
}

// Removes the upload staged for the request the task `task` answers, and
// gives it.
priv uploads_take: fn(task: TaskID) -> StagedUpload? Never! {
    held := BLOBS.guard_edit()
    loop index in 0..<held.value.staged.len() {
        if held.value.staged[index].task == task -> return held.value.staged.remove(index, .Slot)
    }
    None
}

// The upload staged for the request the task `task` answers.
priv uploads_staged: fn(task: TaskID) -> StagedUpload? Never! {
    held: BLOBS.guard_read()
    loop staged in held.value.staged {
        if staged.task == task -> return Val(staged.copy())
    }
    None
}

// Marks the upload staged for the task `task` as one `keep` refused.
priv uploads_refused: fn(task: TaskID) Never! {
    held := BLOBS.guard_edit()
    loop index in 0..<held.value.staged.len() {
        if held.value.staged[index].task == task -> held.value.staged[index].refused = true
    }
}

// Records the blob `path`, which the running call kept from the upload
// staged for the task `owner`.
priv uploads_kept: fn(owner: TaskID, path: String) Never! {
    call: transactions.current()
    kept: KeptBlob{path: path.copy(), call: call ?? 0, committed: call == .None}
    held := BLOBS.guard_edit()
    loop index in 0..<held.value.staged.len() {
        if held.value.staged[index].task == owner {
            held.value.staged[index].kept.push(kept)
            return
        }
    }
}

// Marks the blobs that call `call` kept as committed (`transactions.end`).
priv uploads_committed: fn(call: Int) Never! {
    held := BLOBS.guard_edit()
    loop staged in 0..<held.value.staged.len() {
        loop kept in 0..<held.value.staged[staged].kept.len() {
            if held.value.staged[staged].kept[kept].call == call {
                held.value.staged[staged].kept[kept].committed = true
            }
        }
    }
}

// `Blobs.keep` of the store `store`: links the staged file into the store
// under a fresh id, so a retry finds the staged file still there.
priv blobs_keep: fn(store: String, file: Upload, allow: [Media]) -[FS.Write]> Blob BlobError! {
    me: tasks.current_task()
    staged: uploads_staged(me) ?? return Err(.Storage("no upload is staged for this request: `keep` keeps only the Upload its endpoint was called with"))
    if staged.bytes != file.bytes {
        return Err(.Storage("`{file.name}` is not the upload this request staged"))
    }
    media: blob_media(blob_type(staged.head, staged.bytes)) ?? {
        uploads_refused(me)
        return Err(.WrongType)
    }
    if !allow.contains(media) {
        uploads_refused(me)
        return Err(.WrongType)
    }
    files.create_dir_all(store) ?? return Err(.Storage("the blob store `{store}` can't be made: {err}"))
    id: blob_id()
    path: "{store}/{id}"
    files.hard_link(staged.path, path) ?? return Err(.Storage("the upload can't be kept in `{store}`: {err}"))
    uploads_kept(me, path)
    Ok(Blob{id: BlobID.from_string(id), media: media, bytes: staged.bytes})
}

// A fresh blob id: 32 lowercase hex digits.
priv blob_id: fn() -> String Never! {
    make_trace_id("blob:{rt.clock_mono_ns()}:{trace_next()}", 16)
}

// Whether `id` can be a blob id, so it never names a path outside a store.
priv blob_id_valid: fn(id: String) -> Bool Never! {
    raw: id.bytes()
    if raw.len() != 32 -> return false
    loop byte in raw {
        n: Int{byte}
        if !(n >= 48 && n <= 57) && !(n >= 97 && n <= 102) -> return false
    }
    true
}

// The first bytes of `body` that tell what it is.
priv blob_head: fn(body: [U8]) -> [U8] Never! {
    body.slice(0, if body.len() < BLOB_HEAD -> body.len() else -> BLOB_HEAD)
}

// The content type of a file of `bytes` bytes that starts with `head`, by
// its first bytes alone; "" for none of the media a blob can be.
priv blob_type: fn(head: [U8], bytes: Int) -> String Never! {
    if blob_at(head, 0, [U8]{137, 80, 78, 71, 13, 10, 26, 10}) -> return "image/png"
    if blob_at(head, 0, [U8]{255, 216, 255}) -> return "image/jpeg"
    if blob_at(head, 0, "GIF87a".bytes()) || blob_at(head, 0, "GIF89a".bytes()) {
        return "image/gif"
    }
    if blob_at(head, 0, "RIFF".bytes()) && blob_at(head, 8, "WEBP".bytes()) -> return "image/webp"
    if blob_at(head, 0, "%PDF-".bytes()) -> return "application/pdf"
    if bytes > 0 && blob_text(head, bytes > head.len()) -> return "text/plain; charset=utf-8"
    ""
}

// The media of the content type `kind` (`blob_type`).
priv blob_media: fn(kind: String) -> Media? Never! {
    if kind.starts_with("image/") -> return Val(Media.Image)
    if kind == "application/pdf" -> return Val(Media.PDF)
    if kind.starts_with("text/") -> return Val(Media.Text)
    None
}

// Whether `head` holds `sign` from byte `at` on.
priv blob_at: fn(head: [U8], at: Int, sign: [U8]) -> Bool Never! {
    if head.len() < at + sign.len() -> return false
    loop index in 0..<sign.len() {
        if head[at + index] != sign[index] -> return false
    }
    true
}

// Whether `head`, a file's first bytes, is text that is not markup: UTF-8,
// whose last character may be split when the file goes on past `head`
// (`cut`); no control byte but tab, newline, form feed and carriage return;
// and no `<` as its first byte past white space, so a browser told it is
// text never takes it for HTML.
priv blob_text: fn(head: [U8], cut: Bool) -> Bool Never! {
    end := head.len()
    if cut {
        back := 0
        loop back < 3 && back < end && (blob_byte(head, end - 1 - back) & 192) == 128 -> back += 1
        if back < end && blob_byte(head, end - 1 - back) >= 192 -> end = end - 1 - back
    }
    if String.from_bytes(head.slice(0, end)) == .Err(_) -> return false
    loop index in 0..<end {
        n: blob_byte(head, index)
        if n == 127 || (n < 32 && n != 9 && n != 10 && n != 12 && n != 13) -> return false
    }
    loop index in 0..<end {
        n: blob_byte(head, index)
        if n == 32 || n == 9 || n == 10 || n == 12 || n == 13 -> next
        return n != 60
    }
    true
}

priv blob_byte: fn(head: [U8], at: Int) -> Int Never! { Int{head[at]} }

// Answers a blob's GET: its bytes and content type when `id` names a blob in
// a store this process made and the read policy of a row that holds the id
// admits the caller (`blobs_admitted`); else 404, the same for a blob that
// isn't there as for one the caller may not read.
priv blobs_serve: fn(id: String) -[FS.Read, DB.Read]> builtin.FileDone Never! {
    if !blob_id_valid(id) || !blobs_admitted(id) -> return file_done(404)
    loop store in blob_stores() {
        body: files.read_bytes("{store}/{id}") ?? next
        kind: blob_type(blob_head(body), body.len())
        return builtin.FileDone{status: 200, body: body, media: if kind == "" -> "application/octet-stream" else -> kind}
    }
    file_done(404)
}

priv blob_stores: fn() -> [String] Never! {
    held: BLOBS.guard_read()
    held.value.stores.copy()
}

// Whether the table `table` of the store `store` wants a blob reader
// (`__blob_reader`): once a blob store is made, a table that has none yet,
// or one whose row policy now guards it when its reader was made unguarded.
__blob_reader_wanted: fn(store: String, table: String, guarded: Bool) -> Bool Never! {
    held: BLOBS.guard_read()
    if held.value.stores.len() == 0 -> return false
    known: held.value.guarded.get("{store} {table}") ?? return true
    guarded && !known
}

// Keeps `read` as the blob reader of the table `table` of the store
// `store`. For a blob id, `read` gives 1 when a row of the table holds it and
// the row's read policy admits the caller, 0 when rows hold it and none
// admits the caller, and -1 when no row holds it. The reader of a guarded
// table is never replaced by one that isn't.
__blob_reader: fn(store: String, table: String, guarded: Bool, read: &&fn(String) -[DB.Read]> Int Never!) Never! {
    key: "{store} {table}"
    held := BLOBS.guard_edit()
    if (held.value.guarded.get(key) ?? false) && !guarded {
        return
    }
    held.value.readers[key.copy()] = Shared{BlobReader{read: read}}
    held.value.guarded[key] = guarded
}

// Whether the caller may read the blob `id`: some table holds it in a row
// whose read policy admits the caller. The readers run after the lock is
// released, since each one reads its table.
priv blobs_admitted: fn(id: String) -[DB.Read]> Bool Never! {
    loop reader in blob_readers() {
        each: reader.guard_read()
        if each.value.read(id) == 1 -> return true
    }
    false
}

priv blob_readers: fn() -> [Shared<BlobReader>] Never! {
    held: BLOBS.guard_read()
    readers := [Shared<BlobReader>]{}
    loop key in held.value.readers.keys() {
        reader: held.value.readers.get(key) ?? next
        readers.push(reader.copy())
    }
    readers
}

#Test("a blob's media is what its first bytes show") {
    png: [U8]{137, 80, 78, 71, 13, 10, 26, 10, 0, 0}
    assert_eq(blob_type(png, png.len()), "image/png")
    assert_eq(blob_type("%PDF-1.7\n".bytes(), 9), "application/pdf")
    assert_eq(blob_type("a note\n".bytes(), 7), "text/plain; charset=utf-8")
    assert_eq(blob_type("  <html><script>x</script>".bytes(), 26), "")
    assert_eq(blob_type([U8]{104, 105, 0}, 3), "")
    assert_eq(blob_type([U8]{}, 0), "")
    // A head cut inside "é" is still text when the file goes on.
    assert_eq(blob_type([U8]{104, 195}, 3), "text/plain; charset=utf-8")
    assert_eq(blob_type([U8]{104, 195}, 2), "")
    assert(blob_media("image/gif") == .Val(.Image))
    assert(blob_media("") == .None)
    assert(blob_id_valid(blob_id()))
    assert(!blob_id_valid("../../etc/passwd"))
}

// The arguments of a mounted method's call or of a job, decoded from their
// JSON array, and the reply each gives.
priv RemoteArgs: struct {
    tree: Dyn,

    // The argument at `index`, decoded as the method's parameter type.
    __take: fn<T: Decode>(self, index: Int) -> T [FieldError]! {
        live_json.at<T>(self.tree, "/{index}")
    }

    // The reply of a call that failed: `{"err": error}`.
    __reply_err: fn<E: Encode>(self, error: E) -> String Never! {
        "{{\"err\":{live_json.to_string<E>(error) ?? "null"}}}"
    }

    // The reply of a call that gave `value`: `{"ok": value}`.
    __reply_value: fn<R: Encode>(self, value: R) -> String Never! {
        "{{\"ok\":{live_json.to_string<R>(value) ?? "null"}}}"
    }

    // The reply of a call whose method answers nothing: `{"ok": null}`.
    __reply_unit: fn<R>(self, _value: R) -> String Never! { "{{\"ok\":null}}" }

    // The reply of a job that failed with an error that doesn't encode.
    __failed: fn<E>(self, _error: E) -> String Never! { "{{\"err\":null}}" }

    // The reply of a job that ran, whatever it gave.
    __ran: fn<R>(self, _value: R) -> String Never! { "" }
}

// A job's call, as the compiler lowers `enqueue(fn() { self.method(args)
// })`: `name` names the job, `args` are its arguments, each encoded
// (`__live_arg`), `retries` are its `#App.Job`'s, and `run` decodes the
// arguments and calls the method on a copy of the service. Queued in a call,
// the job runs once the call commits (`transactions`); queued outside one,
// it runs at once, on a task of its own.
__enqueue: fn(name: String, args: [String], retries: Int, run: &&fn(RemoteArgs) -> String [FieldError]!) Never! {
    job: CallJob{name: name, args: "[{args.join(",")}]", retries: retries, run: Shared{CallJobCall{call: run.move()}}}
    call: transactions.current() ?? return job_start(job, "", None, 0)
    transactions.enqueue(call, job)
}

// The wait before a failed job's next run, in milliseconds: half a second
// after its first failure, doubling after each one after, to an hour at
// most.
JOB_BACKOFF_FIRST_MS: 500

JOB_BACKOFF_MOST_MS: 3600000

priv job_backoff_ms: fn(failures: Int) -> Int Never! {
    wait := JOB_BACKOFF_FIRST_MS
    loop _ in 1..<failures {
        wait *= 2
        if wait >= JOB_BACKOFF_MOST_MS -> return JOB_BACKOFF_MOST_MS
    }
    wait
}

// How long a store's row stays taken for the server that runs its job, in
// milliseconds. That server takes it again each tick while the job runs or
// waits to run again, so the time passes only once the server has stopped
// or can't reach the store; then a serving server takes the row and runs the
// job again.
priv JOB_HOLD_MS: 5000

// How often the task of each store a server takes jobs from takes the rows
// of its running jobs again and the rows no server holds, in milliseconds.
priv JOB_TICK_MS: 1000

// The time a row of a job that failed every run it gets is taken until:
// never again.
priv JOB_NEVER: 9223372036854775807

// A job a mounted service declares (`App.__job`), which a serving server
// takes from a store's outbox by its name and runs.
priv CallJobRunner: struct {
    name: String,
    retries: Int,
    run: Shared<CallJobCall>
}

// A store whose outbox the process runs jobs from: the keys of the jobs it
// runs from there, the keys of the ones a stop left (`jobs.stop`), which
// still run but no longer hold their rows, and whether core.db named the
// store as it opened (`jobs.store`). A store it didn't name is forgotten
// once no job of it runs.
priv JobStore: struct {
    store: String,
    outbox: Shared<CallOutbox>,
    running: [String],
    left: [String],
    named: Bool
}

// The process's jobs: the jobs mounted services declare, the stores it runs
// jobs from, how many times a server began serving an App that declares
// jobs, which take the rows no server holds while any serves, and whether
// the task that tends the stores (`jobs_tend`) runs.
priv JobRuntime: struct {
    runners: [CallJobRunner],
    stores: [JobStore],
    serving: Int,
    tended: Bool
}

priv JOBS: Shared{JobRuntime{runners: [CallJobRunner]{}, stores: [JobStore]{}, serving: 0, tended: false}}

// The jobs of a served App: core.web declares each `#App.Job` method of a
// mounted service (`know`) and tells when the App serves (`serve`); core.db
// names each database file whose outbox keeps jobs as it opens (`store`).
priv(package) jobs: module {
    // Declares job `name`, run with `run` and retried `retries` times, so a
    // serving server takes its rows by its name. The first declaration of a
    // name stands.
    know: fn(name: String, retries: Int, run: &&fn(RemoteArgs) -> String [FieldError]!) Never! {
        runtime := JOBS.guard_edit()
        loop known in runtime.value.runners {
            if known.name == name {
                return
            }
        }
        runtime.value.runners.push(CallJobRunner{name: name.copy(), retries: retries, run: Shared{CallJobCall{call: run.move()}}})
    }

    // Names a store whose outbox keeps jobs, so a serving server takes the
    // rows no server holds from it.
    store: fn(outbox: &&CallOutbox) Never! { _: jobs_store(outbox, true) }

    // A server began serving an App that declares jobs: from now on, each
    // tick takes the rows no server holds from each store.
    serve: fn() Never! {
        runtime := JOBS.guard_edit()
        runtime.value.serving += 1
        jobs_tend_start(runtime.value)
    }

    // A server that began serving an App that declares jobs stopped, with
    // `wait_ms` milliseconds left. Once no server serves such an App, no
    // tick takes rows, and the stop waits up to `wait_ms` for the jobs that
    // run, and leaves the ones that still do (`jobs_leave`): none of them
    // deletes its row or records a failure, and their rows are no longer
    // held, so a serving server runs them again once their time passes.
    stop: fn(wait_ms: Int) Never! {
        if !jobs_unserve() {
            return
        }
        end: rt.clock_mono_ns() + wait_ms * 1000000
        loop jobs_busy() && rt.clock_mono_ns() < end -> tasks.sleep(10)
        jobs_leave()
    }
}

// One server less serves an App that declares jobs: whether none does now.
priv jobs_unserve: fn() -> Bool Never! {
    runtime := JOBS.guard_edit()
    if runtime.value.serving > 0 -> runtime.value.serving -= 1
    runtime.value.serving == 0
}

// Whether a job the process runs from a store still runs.
priv jobs_busy: fn() -> Bool Never! {
    runtime: JOBS.guard_read()
    loop store in runtime.value.stores {
        if store.running.len() > 0 -> return true
    }
    false
}

// Leaves each job the process runs from a store: it no longer holds its
// row, and its run neither deletes the row nor records a failure there.
priv jobs_leave: fn() Never! {
    runtime := JOBS.guard_edit()
    loop index in 0..<runtime.value.stores.len() {
        loop key in runtime.value.stores[index].running {
            runtime.value.stores[index].left.push(key.copy())
        }
        runtime.value.stores[index].running = [String]{}
    }
}

// Whether a stop left the job of key `key` the process runs from `outbox`.
priv jobs_left: fn(outbox: Shared<CallOutbox>?, key: String) -> Bool Never! {
    kept: outbox ?? return false
    store: jobs_store_name(kept)
    runtime: JOBS.guard_read()
    loop known in runtime.value.stores {
        if known.store == store -> return known.left.contains(key)
    }
    false
}

// The outbox the process runs jobs from for the store `outbox` names: the
// one it has, or `outbox`, which it then has; `named` when core.db names
// the store.
priv jobs_store: fn(outbox: &&CallOutbox, named: Bool) -> Shared<CallOutbox> Never! {
    runtime := JOBS.guard_edit()
    loop index in 0..<runtime.value.stores.len() {
        if runtime.value.stores[index].store != outbox.store -> next
        if named -> runtime.value.stores[index].named = true
        return runtime.value.stores[index].outbox.copy()
    }
    name: outbox.store.copy()
    kept: Shared{outbox.move()}
    runtime.value.stores.push(JobStore{store: name, outbox: kept.copy(), running: [String]{}, left: [String]{}, named: named})
    kept
}

// Starts the task that tends the stores (`jobs_tend`) unless it runs.
priv jobs_tend_start: fn(runtime: &JobRuntime) Never! {
    if runtime.tended {
        return
    }
    runtime.tended = true
    tending: task { jobs_tend() }
    tending.detach()
}

// What one tick does on store `store`: take the rows of `running` again,
// and, while a server serves an App that declares jobs, take the rows of
// jobs named in `names` that no server holds.
priv JobTick: struct {
    store: String,
    outbox: Shared<CallOutbox>,
    running: [String],
    names: [String]
}

// What the next tick does on each store; None when it has nothing to do, as
// no job runs and no server serves an App that declares jobs, and then the
// task that tends the stores ends (`tended` is false again).
priv jobs_ticks: fn() -> [JobTick]? Never! {
    runtime := JOBS.guard_edit()
    names := [String]{}
    if runtime.value.serving > 0 {
        loop known in runtime.value.runners -> names.push(known.name.copy())
    }
    ticks := [JobTick]{}
    loop store in runtime.value.stores {
        if store.running.len() == 0 && names.len() == 0 -> next
        ticks.push(JobTick{store: store.store.copy(), outbox: store.outbox.copy(), running: store.running.copy(), names: names.copy()})
    }
    if ticks.len() == 0 && names.len() == 0 {
        runtime.value.tended = false
        return None
    }
    Val(ticks)
}

// The task that tends the stores: each tick, it takes the rows of the jobs
// the process runs again, so no other server takes them, and while a server
// serves an App that declares jobs, it takes the rows no server holds and
// runs their jobs. A store that has closed is forgotten.
priv jobs_tend: fn() Never! {
    loop {
        ticks: jobs_ticks() ?? return
        loop tick in ticks -> jobs_tick(tick)
        tasks.sleep(JOB_TICK_MS)
    }
}

// Runs one tick on its store.
priv jobs_tick: fn(tick: JobTick) Never! {
    taken: jobs_tick_rows(tick) ?? return jobs_forget(tick.store)
    loop queued in taken {
        job: jobs_declared(queued) ?? next
        job_start(job, queued.key.copy(), Val(tick.outbox.copy()), queued.runs)
    }
}

// Takes the rows of `tick` on its store, and gives the rows it took that no
// server held; None once the store has closed.
priv jobs_tick_rows: fn(tick: JobTick) -> [CallQueued]? Never! {
    kept: tick.outbox.guard_read()
    now: kept.value.now()
    if tick.running.len() > 0 -> _: kept.value.hold(tick.running, now + JOB_HOLD_MS)
    if tick.names.len() == 0 -> return Val([CallQueued]{})
    kept.value.take(tick.names, now, now + JOB_HOLD_MS)
}

// The job of the row `queued`, run by its declared runner; None when no
// mounted service declares it.
priv jobs_declared: fn(queued: CallQueued) -> CallJob? Never! {
    runtime: JOBS.guard_read()
    loop known in runtime.value.runners {
        if known.name == queued.name {
            return Val(CallJob{name: queued.name.copy(), args: queued.args.copy(), retries: known.retries, run: known.run.copy()})
        }
    }
    None
}

// Forgets store `store`, which has closed.
priv jobs_forget: fn(store: String) Never! {
    runtime := JOBS.guard_edit()
    loop index in 0..<runtime.value.stores.len() {
        if runtime.value.stores[index].store == store {
            _: runtime.value.stores.remove(index, .Slot)
            return
        }
    }
}

// Marks the job of key `key` as running from store `store` (`running`), or
// as no longer running, whether a stop left it or not; a store core.db
// didn't name is forgotten once no job of it runs.
priv jobs_running: fn(store: String, key: String, running: Bool) Never! {
    runtime := JOBS.guard_edit()
    loop index in 0..<runtime.value.stores.len() {
        if runtime.value.stores[index].store != store -> next
        if running {
            runtime.value.stores[index].running.push(key.copy())
            return jobs_tend_start(runtime.value)
        }
        loop at in 0..<runtime.value.stores[index].running.len() {
            if runtime.value.stores[index].running[at] == key {
                _: runtime.value.stores[index].running.remove(at, .Slot)
                break
            }
        }
        loop at in 0..<runtime.value.stores[index].left.len() {
            if runtime.value.stores[index].left[at] == key {
                _: runtime.value.stores[index].left.remove(at, .Slot)
                break
            }
        }
        done: runtime.value.stores[index].running.len() == 0 && runtime.value.stores[index].left.len() == 0
        if done && !runtime.value.stores[index].named {
            _: runtime.value.stores.remove(index, .Slot)
        }
        return
    }
}

// The name of the store `outbox` keeps jobs in.
priv jobs_store_name: fn(outbox: Shared<CallOutbox>) -> String Never! {
    kept: outbox.guard_read()
    kept.value.store.copy()
}

// Runs `job` on a task of its own; `outbox` keeps it under key `key` (None:
// it is kept nowhere), after `runs` runs that failed.
priv job_start: fn(job: &&CallJob, key: &&String, outbox: &&Shared<CallOutbox>?, runs: Int) Never! {
    if outbox == .Val(store) -> jobs_running(jobs_store_name(store), key, true)
    runner: task { job_run(job, key, outbox, runs) }
    runner.detach()
}

// Runs `job`, after `runs` runs that failed, until a run succeeds, each run
// as the system and in a call of its own, which also deletes the job's row
// from `outbox`. A run that fails runs again after a backoff, up to
// `job.retries` more runs in all; each failure is recorded on the row, so a
// server that takes it later goes on from there. After the last, the row
// keeps the last failure, and no server takes it again. A job a stop left
// (`jobs.stop`) runs no more, and records nothing on its row.
priv job_run: fn(job: CallJob, key: String, outbox: Shared<CallOutbox>?, runs: Int) Never! {
    failures := runs
    loop !jobs_left(outbox, key) {
        failures += 1
        failure: job_attempt(job, key, outbox)
        if failure == "" || jobs_left(outbox, key) -> break
        last: failures > job.retries
        if outbox == .Val(store) {
            kept: store.guard_read()
            until: if last -> JOB_NEVER else -> kept.value.now() + job_backoff_ms(failures) + JOB_HOLD_MS
            _: kept.value.failed(key, failures, failure, until)
        }
        if last -> break
        tasks.sleep(job_backoff_ms(failures))
    }
    if outbox == .Val(store) -> jobs_running(jobs_store_name(store), key, false)
}

// One run of `job` in a call of its own, under its key `key` as the call's
// delivery: "" when it ran, or when another run had done it already (its
// row is gone, or a store it uses has run it); otherwise why it failed. A
// run a store has run already rolls back, and its row is deleted then. A
// run that a stop left before it ended rolls back, and its row stays.
priv job_attempt: fn(job: CallJob, key: String, outbox: Shared<CallOutbox>?) -> String Never! {
    call: transactions.begin() ?? panic("a job's task runs no other call")
    if outbox == .Val(store) {
        kept: store.guard_read()
        transactions.deliver(call, CallDelivery{id: "job:{key}", at: kept.value.now() /% 1000})
    }
    reply: as_system<String>(fn() {
        held: job.run.guard_read()
        job_reply(held.value.call, job.args)
    })
    failed: reply.starts_with("{{\"err\":")
    left: jobs_left(outbox, key)
    removed := 1
    if !failed && !left {
        if outbox == .Val(store) {
            kept: store.guard_read()
            removed = kept.value.done(key)
        }
    }
    repeated: transactions.repeated(call)
    committed: transactions.end(call, !failed && !left && removed == 1)
    if repeated {
        if outbox == .Val(store) -> return job_done(store, key)
        return ""
    }
    if failed -> return reply
    if removed < 0 -> return "the store couldn't delete the job's row"
    if !committed -> return "the job's call couldn't commit"
    ""
}

// Deletes the row of key `key` from `outbox`, in a call of its own, as a
// store the job uses has run it already: "" once it is gone, otherwise why
// not.
priv job_done: fn(outbox: Shared<CallOutbox>, key: String) -> String Never! {
    call: transactions.begin() ?? panic("a job's task runs no other call")
    kept: outbox.guard_read()
    removed: kept.value.done(key)
    if !transactions.end(call, removed >= 0) || removed < 0 {
        return "the store couldn't delete the job's row"
    }
    ""
}

// What `run` replies to the encoded arguments `args`.
priv job_reply: fn(run: fn(RemoteArgs) -> String [FieldError]!, args: String) -> String Never! {
    tree: live_json.parse(args) ?? return "{{\"err\":\"the job's arguments are not JSON\"}}"
    run(RemoteArgs{tree: tree}) ?? "{{\"err\":\"the job's arguments don't decode\"}}"
}

// The schedules of a served App: core.web starts each `#App.Every` method
// of a mounted service as the App starts serving (`start`).
priv(package) schedules: module {
    // Whether `cron` is a cron line a schedule runs on.
    valid: fn(cron: String) -> Bool Never! { cron_parse(cron) != None }

    // Starts schedule `name` on a task of its own: it runs `run` at the
    // latest minute the cron line `cron` allows, unless a store records that
    // run, and then at each next one (`schedule_run`).
    start: fn(name: String, cron: String, run: &&fn(RemoteArgs) -> String [FieldError]!) Never! {
        line: cron_parse(cron) ?? panic("`{cron}` is not a cron line")
        runner: task { schedule_run(name, line, run) }
        runner.detach()
    }
}

// Runs schedule `name` on its cron line `line`: first the latest minute the
// line allows, a run missed while no server ran, then each next minute it
// allows, each as a call of its own (`schedule_tick`). A run that ends
// after its next minute has passed is followed by the latest minute that
// passed, once.
priv schedule_run: fn(name: String, line: CronLine, run: fn(RemoteArgs) -> String [FieldError]!) Never! {
    due := schedule_minute()
    if cron_due_by(line, due) == .Val(missed) {
        schedule_tick(name, missed, run)
        due = missed
    }
    loop {
        next := cron_due_after(line, due) ?? return
        now: schedule_minute()
        if next < now -> next = cron_due_by(line, now) ?? next
        loop {
            wait_ms: next * 60000 - time.unix_ns() /% 1000000
            if wait_ms <= 0 -> break
            tasks.sleep(wait_ms)
        }
        schedule_tick(name, next, run)
        due = next
    }
}

// The minute it is, since the Unix epoch.
priv schedule_minute: fn() -> Int Never! { time.unix_ns() /% 60000000000 }

// One run of schedule `name`, due at minute `due`, in a call of its own as
// the system. Each store the run uses records it in the call's transaction
// (core.db's `__jet_schedules`): a store that has recorded it, or a later
// run, already marks the call repeated, and the run is dropped. A store
// busy with another server's run refuses the call, which runs again, up to
// `transactions.attempts()` times, and then finds the run recorded. A run
// that fails rolls back and records nothing. A run that uses no store
// records nothing, so each server runs it.
priv schedule_tick: fn(name: String, due: Int, run: fn(RemoteArgs) -> String [FieldError]!) Never! {
    loop _ in 0..<transactions.attempts() {
        call: transactions.begin() ?? panic("a schedule's task runs no other call")
        transactions.schedule(call, CallTick{schedule: name.copy(), due: due * 60})
        reply: as_system<String>(fn() { job_reply(run, "[]") })
        if transactions.end(call, !reply.starts_with("{{\"err\":")) {
            return
        }
    }
}

// A cron line's five fields, each as the values it allows, by value: the
// minutes (0-59), hours (0-23), days of the month (1-31), months (1-12) and
// days of the week (0-6, Sunday 0). `any_day` and `any_weekday` hold when
// the day field and the weekday field start with `*`.
priv CronLine: struct {
    minutes: [Bool],
    hours: [Bool],
    days: [Bool],
    months: [Bool],
    weekdays: [Bool],
    any_day: Bool,
    any_weekday: Bool
}

// The days, back or ahead, a due minute is looked for in: eight years,
// enough to reach a February 29.
CRON_SEARCH_DAYS: 2928

// `text` as a cron line; None when it isn't one.
priv cron_parse: fn(text: String) -> CronLine? {
    fields := [String]{}
    loop part in text.split(" ") {
        if part != "" -> fields.push(part)
    }
    if fields.len() != 5 -> return None
    weekdays := cron_field(fields[4], 0, 7) ?? return None
    if weekdays[7] -> weekdays[0] = true
    _: weekdays.pop()
    Val(CronLine{
        minutes: cron_field(fields[0], 0, 59) ?? return None,
        hours: cron_field(fields[1], 0, 23) ?? return None,
        days: cron_field(fields[2], 1, 31) ?? return None,
        months: cron_field(fields[3], 1, 12) ?? return None,
        weekdays: weekdays,
        any_day: fields[2].starts_with("*"),
        any_weekday: fields[4].starts_with("*"),
    })
}

// The values from `low` to `high` that the cron field `text` allows, by
// value (each below `low` false); None when it isn't a field of that range.
priv cron_field: fn(text: String, low: Int, high: Int) -> [Bool]? {
    allowed := [Bool]{}
    loop _ in 0..<(high + 1) -> allowed.push(false)
    loop item in text.split(",") {
        stepped: item.split("/").to_list()
        if stepped.len() > 2 -> return None
        step: if {
            stepped.len() == 2 -> cron_number(stepped[1]) ?? return None
            else -> 1
        }
        if step < 1 -> return None
        first := low
        last := high
        if stepped[0] != "*" {
            bounds: stepped[0].split("-").to_list()
            if bounds.len() > 2 -> return None
            first = cron_number(bounds[0]) ?? return None
            // `5/15` steps from 5 to the field's end.
            last = if {
                bounds.len() == 2 -> cron_number(bounds[1]) ?? return None
                stepped.len() == 2 -> high
                else -> first
            }
        }
        if first < low || last > high || first > last -> return None
        at := first
        loop {
            if at > last -> break
            allowed[at] = true
            at += step
        }
    }
    Val(allowed)
}

// The number `text` writes, of one or two digits; None otherwise.
priv cron_number: fn(text: String) -> Int? {
    if text.len() == 0 || text.len() > 2 -> return None
    loop byte in text.bytes() {
        n: Int{byte}
        if n < 48 || n > 57 -> return None
    }
    Val(Int.parse(text) ?? return None)
}

// Whether `line` allows day `day` (since the Unix epoch): its month, and its
// day of the month and day of the week, both, or either when neither field
// starts with `*`.
priv cron_day_allowed: fn(line: CronLine, day: Int) -> Bool {
    date: cron_date(day)
    if !line.months[date.month] -> return false
    by_date: line.days[date.day]
    by_weekday: line.weekdays[(day + 4) % 7]
    if line.any_day || line.any_weekday -> return by_date && by_weekday
    by_date || by_weekday
}

// A day's month (1-12) and day of the month (1-31).
priv CronDate: struct {
    month: Int,
    day: Int
}

// The date of day `day` since the Unix epoch, in the proleptic Gregorian
// calendar (Howard Hinnant's `civil_from_days`).
priv cron_date: fn(day: Int) -> CronDate {
    shifted: day + 719468
    era: shifted /% 146097
    of_era: shifted - era * 146097
    year_of_era: (of_era - of_era /% 1460 + of_era /% 36524 - of_era /% 146096) /% 365
    of_year: of_era - (365 * year_of_era + year_of_era /% 4 - year_of_era /% 100)
    month_from_march: (5 * of_year + 2) /% 153
    CronDate{
        month: if month_from_march < 10 -> month_from_march + 3 else -> month_from_march - 9,
        day: of_year - (153 * month_from_march + 2) /% 5 + 1,
    }
}

// The latest minute, since the Unix epoch, at or before `minute` that
// `line` allows; None when none does in the search window.
priv cron_due_by: fn(line: CronLine, minute: Int) -> Int? {
    first_day: minute /% 1440
    loop back in 0..<CRON_SEARCH_DAYS {
        day: first_day - back
        if !cron_day_allowed(line, day) -> next
        top_hour: if back == 0 -> (minute % 1440) /% 60 else -> 23
        loop hour_back in 0..<(top_hour + 1) {
            hour: top_hour - hour_back
            if !line.hours[hour] -> next
            top_minute: if back == 0 && hour == top_hour -> minute % 60 else -> 59
            loop minute_back in 0..<(top_minute + 1) {
                at: top_minute - minute_back
                if line.minutes[at] -> return Val(day * 1440 + hour * 60 + at)
            }
        }
    }
    None
}

// The earliest minute, since the Unix epoch, after `minute` that `line`
// allows; None when none does in the search window.
priv cron_due_after: fn(line: CronLine, minute: Int) -> Int? {
    start: minute + 1
    first_day: start /% 1440
    loop ahead in 0..<CRON_SEARCH_DAYS {
        day: first_day + ahead
        if !cron_day_allowed(line, day) -> next
        low_hour: if ahead == 0 -> (start % 1440) /% 60 else -> 0
        loop hour in low_hour..<24 {
            if !line.hours[hour] -> next
            low_minute: if ahead == 0 && hour == low_hour -> start % 60 else -> 0
            loop at in low_minute..<60 {
                if line.minutes[at] -> return Val(day * 1440 + hour * 60 + at)
            }
        }
    }
    None
}

#Test("a cron line allows the minutes its fields allow, in UTC, and a malformed one is refused") {
    daily: cron_parse("0 8 * * *") ?? panic("a daily line")
    // 2026-11-16 07:00 UTC, a Monday.
    monday_seven: 29913540
    assert_eq(cron_due_by(daily, monday_seven), Val(29912160))
    assert_eq(cron_due_after(daily, monday_seven), Val(29913600))
    assert_eq(cron_due_by(daily, 29913600), Val(29913600))
    assert_eq(cron_due_after(daily, 29913600), Val(29915040))
    quarters: cron_parse("*/15 * * * *") ?? panic("a quarter-hour line")
    assert_eq(cron_due_by(quarters, 29913571), Val(29913570))
    assert_eq(cron_due_after(quarters, 29913571), Val(29913585))
    // Either the 13th or a Friday, since neither day field is `*`.
    friday_or_13th: cron_parse("0 0 13 * 5") ?? panic("a day line")
    assert_eq(cron_due_by(friday_or_13th, 29908800), Val(29908800))
    assert_eq(cron_due_after(friday_or_13th, 29908800), Val(29918880))
    assert_eq(cron_due_after(cron_parse("0 0 29 2 *") ?? panic("a leap-day line"), monday_seven), Val(30589920))
    monthly: cron_parse("0 0 1 * *") ?? panic("a monthly line")
    assert_eq(cron_due_by(monthly, 29934719), Val(29891520))
    assert_eq(cron_due_after(monthly, 29934719), Val(29934720))
    assert_eq(cron_due_by(cron_parse("0 8 * * 7") ?? panic("a Sunday line"), monday_seven), Val(29912160))
    assert_eq(cron_due_after(cron_parse("0 0 31 2 *") ?? panic("a line no day matches"), monday_seven), Int?{None})
    assert(schedules.valid("5/15 1-3,9 * 1-12/2 1-5"))
    malformed_lines: [String]{"0 8 * *", "0 8 * * * *", "60 * * * *", "*/0 * * * *", "a * * * *", "5-1 * * * *", "1,,2 * * * *", "* * 0 * *", "* * * 13 *", "* * * * 8", "1-2-3 * * * *", "*/100 * * * *"}
    loop malformed in malformed_lines { assert(!schedules.valid(malformed), malformed) }
}

// An outbox that keeps nothing, for the calls of the test below, which queue
// no job.
priv outbox_unused: fn() -> CallOutbox Never! {
    CallOutbox{
        store: "unused",
        now: fn() { 0 },
        keep: fn(_: String, _: String, _: Int) { "" },
        done: fn(_: String) { 0 },
        failed: fn(_: String, _: Int, _: String, _: Int) { false },
        take: fn(_: [String], _: Int, _: Int) { None },
        hold: fn(_: [String], _: Int) { false },
        answered: fn(_: Int, _: CallRequest, _: String) { false },
    }
}

#Test("a call commits or rolls back every transaction joined to it, runs again when one refused it, and rolls back a delivery run already") {
    seen: Shared{[String]{}}
    note: fn(name: String, commits: Bool) -> fn(Bool) -[]> Bool Never! {
        fn(commit: Bool) {
            log := seen.guard_edit()
            log.value.push(if commit -> "commit {name}" else -> "roll back {name}")
            commits || !commit
        }
    }
    assert_eq(transactions.current(), Int?{None})
    call: transactions.begin() ?? panic("no call is open")
    assert_eq(transactions.begin(), Int?{None})
    assert_eq(transactions.current(), Val(call))
    transactions.join(call, note("a", true), outbox_unused())
    transactions.join(call, note("b", true), outbox_unused())
    assert(transactions.end(call, true))
    assert_eq(transactions.current(), Int?{None})
    failed: transactions.begin() ?? panic("no call is open")
    transactions.join(failed, note("c", true), outbox_unused())
    assert(transactions.end(failed, false))
    refused: transactions.begin() ?? panic("no call is open")
    transactions.join(refused, note("d", true), outbox_unused())
    transactions.refuse(refused)
    assert(transactions.refused(refused))
    assert(!transactions.end(refused, true))
    lost: transactions.begin() ?? panic("no call is open")
    transactions.join(lost, note("e", false), outbox_unused())
    transactions.join(lost, note("f", true), outbox_unused())
    assert(!transactions.end(lost, true))
    delivered: transactions.begin() ?? panic("no call is open")
    assert_eq(transactions.delivery(delivered), CallDelivery?{None})
    transactions.deliver(delivered, CallDelivery{id: "d-1", at: 1})
    assert_eq(transactions.delivery(delivered), Val(CallDelivery{id: "d-1", at: 1}))
    transactions.join(delivered, note("g", true), outbox_unused())
    assert(!transactions.repeated(delivered))
    transactions.repeat(delivered)
    assert(transactions.repeated(delivered))
    assert(transactions.end(delivered, true))
    log: seen.guard_read()
    assert_eq(log.value.join(", "), "commit a, commit b, roll back c, roll back d, commit e, roll back f, roll back g")
}

#Test("a call that carries a request key keeps its reply in its first store before the commits, or on its own after a rollback, and a repeated or refused call keeps none") {
    seen: Shared{[String]{}}
    outbox: fn(name: String) -> CallOutbox {
        CallOutbox{
            store: "app.Test request outbox",
            now: fn() { 0 },
            keep: fn(_: String, _: String, _: Int) { "" },
            done: fn(_: String) { 0 },
            failed: fn(_: String, _: Int, _: String, _: Int) { false },
            take: fn(_: [String], _: Int, _: Int) { None },
            hold: fn(_: [String], _: Int) { false },
            answered: fn(call: Int, request: CallRequest, reply: String) {
                at: if call == 0 -> "on its own" else -> "in its call"
                log := seen.guard_edit()
                log.value.push("{name} keeps {request.account}/{request.key} {reply} {at}")
                true
            },
        }
    }
    ends: fn(name: String) -> fn(Bool) -[]> Bool Never! {
        fn(commit: Bool) {
            log := seen.guard_edit()
            log.value.push(if commit -> "commit {name}" else -> "roll back {name}")
            true
        }
    }
    asked: fn(key: String) -> CallRequest { CallRequest{account: "ann", key: key, at: 1} }
    committed: transactions.begin() ?? panic("no call is open")
    assert_eq(transactions.request(committed), CallRequest?{None})
    transactions.ask(committed, asked("k1"))
    assert_eq(transactions.request(committed), Val(asked("k1")))
    transactions.join(committed, ends("a"), outbox("a"))
    transactions.join(committed, ends("b"), outbox("b"))
    assert_eq(transactions.reply(committed), String?{None})
    transactions.answer(committed, "ok 1")
    // The first reply stands: a store's kept reply comes before the run's.
    transactions.answer(committed, "ok 2")
    assert_eq(transactions.reply(committed), Val("ok 1"))
    assert(transactions.end(committed, true))
    failed: transactions.begin() ?? panic("no call is open")
    transactions.ask(failed, asked("k2"))
    transactions.join(failed, ends("c"), outbox("c"))
    transactions.answer(failed, "err no")
    assert(transactions.end(failed, false))
    repeated: transactions.begin() ?? panic("no call is open")
    transactions.ask(repeated, asked("k3"))
    transactions.join(repeated, ends("d"), outbox("d"))
    transactions.answer(repeated, "kept")
    transactions.repeat(repeated)
    assert(transactions.end(repeated, true))
    refused: transactions.begin() ?? panic("no call is open")
    transactions.ask(refused, asked("k4"))
    transactions.join(refused, ends("e"), outbox("e"))
    transactions.answer(refused, "ok 4")
    transactions.refuse(refused)
    assert(!transactions.end(refused, true))
    // A call whose arguments didn't decode ran nothing, so it has no reply.
    undecoded: transactions.begin() ?? panic("no call is open")
    transactions.ask(undecoded, asked("k5"))
    transactions.join(undecoded, ends("f"), outbox("f"))
    assert(transactions.end(undecoded, false))
    log: seen.guard_read()
    assert_eq(log.value.join(", "), "a keeps ann/k1 ok 1 in its call, commit a, commit b, roll back c, c keeps ann/k2 err no on its own, roll back d, roll back e, roll back f")
}

// The entries `seen` holds so far.
priv jobs_seen: fn(seen: Shared<[String]>) -> [String] Never! {
    log: seen.guard_read()
    log.value.copy()
}

#Test("a committed call keeps each job it queued in its first store's outbox and runs it after the commit, again after a failure, recording each; a rolled-back call runs none") {
    seen: Shared{[String]{}}
    outbox: fn() -> CallOutbox {
        CallOutbox{
            store: "app.Test outbox",
            now: fn() { 0 },
            keep: fn(name: String, args: String, _: Int) {
                log := seen.guard_edit()
                log.value.push("keep {name} {args}")
                "key {name}"
            },
            done: fn(key: String) {
                log := seen.guard_edit()
                log.value.push("done {key}")
                1
            },
            failed: fn(key: String, runs: Int, error: String, _: Int) {
                log := seen.guard_edit()
                log.value.push("failed {key} after {runs}: {error}")
                true
            },
            take: fn(_: [String], _: Int, _: Int) { Val([CallQueued]{}) },
            hold: fn(_: [String], _: Int) { true },
            answered: fn(_: Int, _: CallRequest, _: String) { false },
        }
    }
    tries: Shared{0}
    flaky: fn(args: RemoteArgs) -> String [FieldError]! {
        count := tries.guard_edit()
        count.value += 1
        taken: args.__take<Int>(0)
        if count.value == 1 -> return Ok(args.__reply_err<String>("once"))
        Ok(args.__reply_value<Int>(taken))
    }
    failing: fn(args: RemoteArgs) -> String [FieldError]! { Ok(args.__reply_err<String>("always")) }
    dropped: Shared{0}
    never: fn(args: RemoteArgs) -> String [FieldError]! {
        count := dropped.guard_edit()
        count.value += 1
        Ok(args.__reply_value<Int>(0))
    }
    rolled: transactions.begin() ?? panic("no call is open")
    transactions.join(rolled, fn(_: Bool) { true }, outbox())
    __enqueue("app.Test.never", [String]{}, 0, never)
    assert(transactions.end(rolled, false))
    committed: transactions.begin() ?? panic("no call is open")
    transactions.join(committed, fn(_: Bool) { true }, outbox())
    __enqueue("app.Test.flaky", [String]{__live_arg<Int>(2)}, 1, flaky)
    __enqueue("app.Test.failing", [String]{}, 1, failing)
    assert(transactions.end(committed, true))
    loop _ in 0..<1000 {
        if jobs_seen(seen).len() >= 6 -> break
        tasks.sleep(10)
    }
    log := jobs_seen(seen)
    log.sort()
    assert_eq(log.join(", "), "done key app.Test.flaky, failed key app.Test.failing after 1: {{\"err\":\"always\"}}, failed key app.Test.failing after 2: {{\"err\":\"always\"}}, failed key app.Test.flaky after 1: {{\"err\":\"once\"}}, keep app.Test.failing [], keep app.Test.flaky [2]")
    assert_eq(job_backoff_ms(1), 500)
    assert_eq(job_backoff_ms(3), 2000)
    assert_eq(job_backoff_ms(40), JOB_BACKOFF_MOST_MS)
    taken: tries.guard_read()
    assert_eq(taken.value, 2)
    never_ran: dropped.guard_read()
    assert_eq(never_ran.value, 0)
}

LIVE_MAX_QUERIES: 1024

LIVE_MAX_PAYLOAD: 4194304

// A binding whose runs this many times in a row were overtaken serves its
// stale result for a hold before it runs again.
LIVE_HOLD_AFTER: 2

// The shortest hold, in nanoseconds; a run that took longer holds as long as
// it took, so a binding over a busy table spends at most half its time
// running.
LIVE_HOLD_MIN_NS: 100000000

// The re-runs a server makes in one second, over all its bindings; a binding
// due past them serves its stored result until the next second.
LIVE_MAX_RERUNS_PER_SECOND: 1000

LIVE_RERUN_WINDOW_NS: 1000000000

// The registry source of sync's session records: a session keeps its
// generation and document as the record's value.
LIVE_SYNC_SOURCE: "app.sync"

// The encoded registry, in one process-wide cell. A replacement installs only
// while the cell still holds the bytes its caller read, so a concurrent change
// makes the caller retry instead of being lost. Inside a deterministic world
// the registry is the World's own cell instead, starting empty, so a world and
// its tasks never read or change the process registry.
LiveCell: struct {
    bytes: [U8]
}

LIVE_CELL: Shared{LiveCell{bytes: [U8]{}}}

live_cell_load: fn() -> [U8] {
    if world_rt.world_store_load("app.live") == .Val(bytes) -> return bytes
    LIVE_CELL.bytes
}

live_cell_replace: fn(expected: [U8], replacement: &&[U8]) -> Bool {
    if world_rt.world_store_replace("app.live", expected, replacement) == .Val(replaced) {
        return replaced
    }
    cell := LIVE_CELL.guard_edit()
    if cell.value.bytes != expected -> return false
    cell.value.bytes = replacement.move()
    true
}

live_key: fn(args: [String]) -> String { "[{args.join(",")}]" }

// The id of the binding named by `source`, `key` and `caller` (acting_tag),
// registered when absent; a full registry evicts its oldest binding. Two
// registrations of one binding poll at the shorter interval. 0 when the
// registry is unavailable.
live_register: fn(source: String, key: String, caller: String, every_ns: Int) -> Int {
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return 0
        found := 0
        loop index in 0..<registry.records.len() {
            if registry.records[index].source != source || registry.records[index].key != key || registry.records[index].caller != caller {
                next
            }
            found = registry.records[index].id
            current: registry.records[index].every_ns
            if every_ns <= 0 || (current > 0 && current <= every_ns) -> return found
            registry.records[index].every_ns = every_ns
        }
        if found == 0 {
            found = registry.next_id + 1
            registry.next_id = found
            if live_query_count(registry) >= LIVE_MAX_QUERIES {
                kept := [LiveRecord]{}
                evicted := false
                loop record in registry.records {
                    if !evicted && record.source != LIVE_SYNC_SOURCE {
                        evicted = true
                        next
                    }
                    kept.push(record)
                }
                registry.records = kept
                registry.evictions += 1
            }
            // copy: a lost race retries with the same source, key and caller
            registry.records.push(LiveRecord{id: found, source: source.copy(), key: key.copy(), value: "", dirty: false, generation: 0, overtaken: 0, held_ns: 0, every_ns: every_ns, ran_ns: 0, reads: [String]{}, caller: caller.copy()})
        }
        if live_cell_replace(seen, live_encode(registry)) -> return found
    }
}

// Removes the bindings `ids` from the registry with their stored results
// and read sets: the data of a screen that left. A screen that reads one
// again registers it anew and runs its source.
priv live_drop: fn(ids: [Int]) {
    if ids.len() == 0 {
        return
    }
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return
        kept := [LiveRecord]{}
        loop record in registry.records {
            if record.source == LIVE_SYNC_SOURCE || !ids.contains(record.id) -> kept.push(record)
        }
        registry.records = kept
        if live_cell_replace(seen, live_encode(registry)) {
            return
        }
    }
}

// The stored result of binding `id` when it is current at `now`, or stale
// but held, and its generation; None when the binding must re-run. A re-run
// takes one of this second's LIVE_MAX_RERUNS_PER_SECOND; once they are spent,
// the stored result is held until the next second, its start published as a
// hold's is (live_store), so watchers read again when it ends and every write
// before then costs the one re-run that follows it. A first run is not capped:
// it has no result to hold.
live_current: fn(id: Int, now: Int) -> LiveCurrent {
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return LiveCurrent{value: None, generation: 0}
        index: live_index(registry, id) ?? return LiveCurrent{value: None, generation: 0}
        generation: registry.records[index].generation
        if registry.records[index].value == "" {
            return LiveCurrent{value: None, generation: generation}
        }
        dirty: registry.records[index].dirty
        held: now < registry.records[index].held_ns
        every_ns: registry.records[index].every_ns
        polled: every_ns > 0 && now - registry.records[index].ran_ns >= every_ns
        if held || (!dirty && !polled) {
            return LiveCurrent{value: Val(registry.records[index].value.copy()), generation: generation}  // copy: the registry snapshot is dropped here
        }
        if now - registry.window_ns >= LIVE_RERUN_WINDOW_NS {
            registry.window_ns = now
            registry.window_runs = 0
        }
        event := ""
        if registry.window_runs < LIVE_MAX_RERUNS_PER_SECOND -> registry.window_runs += 1 else {
            ends: registry.window_ns + LIVE_RERUN_WINDOW_NS
            registry.records[index].held_ns = ends
            registry.capped += 1
            registry.ws_pushes += 1
            event = live_event(id, Val(live_hold_ms(ends - now)))
        }
        if live_cell_replace(seen, live_encode(registry)) {
            if event == "" -> return LiveCurrent{value: None, generation: generation}
            rt_web.live_publish("live:{id}", event)
            return LiveCurrent{value: Val(registry.records[index].value.copy()), generation: generation}  // copy: the registry snapshot is dropped here
        }
    }
}

live_value_state: fn<T: [Encode, Decode], E: [Encode, Decode]>(text: String) -> Loadable<T, E>? {
    if text.starts_with("ok:") {
        value: live_json.decode<T>(text.slice(3, text.len())) ?? return None
        return Val(Loadable.Loaded(value))
    }
    if !text.starts_with("err:") -> return None
    reason: live_json.decode<E>(text.slice(4, text.len())) ?? return None
    Val(Loadable.Failed(reason))
}

// Stores `value` as binding `id`'s result; a value that differs from the
// stored one counts as a change. The binding becomes clean unless `started`,
// its generation when the run began, is older than its generation now: an
// invalidation that arrived during the run keeps it stale, so the next read
// runs it again. From the LIVE_HOLD_AFTER-th such run in a row, the stale
// result is held: reads serve it until the hold ends (as long as the run took,
// at least LIVE_HOLD_MIN_NS), and the first read after that runs the source
// again, so the binding never runs on every read. A hold is never served as
// current: its start publishes the binding's event with `after_ms`, so a
// watching client that read the held result reads again once it ends, and the
// first current result after a hold publishes the event again, so every
// watcher reads it. A push (`started` None) is current as stored. `now`, the
// time the run began, < 0 keeps the last run time.
live_store: fn(id: Int, value: String, now: Int, started: Int?) {
    if value.len() > LIVE_MAX_PAYLOAD {
        return
    }
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return
        index: live_index(registry, id) ?? return
        if registry.records[index].value != value {
            registry.records[index].value = value.copy()  // copy: a lost race retries with the same value
            registry.changes += 1
        }
        overtaken := false
        if started == .Val(generation) && registry.records[index].generation != generation {
            overtaken = true
        }
        // The hub event this store publishes: a hold's start or its end.
        event := ""
        if overtaken {
            registry.records[index].overtaken += 1
            if registry.records[index].overtaken >= LIVE_HOLD_AFTER && now >= 0 {
                ended: rt.clock_mono_ns()
                took: ended - now
                hold: if took > LIVE_HOLD_MIN_NS -> took else -> LIVE_HOLD_MIN_NS
                registry.records[index].held_ns = ended + hold
                event = live_event(id, Val(live_hold_ms(hold)))
            }
        } else {
            if registry.records[index].held_ns != 0 -> event = live_event(id, None)
            registry.records[index].dirty = false
            registry.records[index].overtaken = 0
            registry.records[index].held_ns = 0
        }
        if event != "" -> registry.ws_pushes += 1
        if now >= 0 -> registry.records[index].ran_ns = now
        if live_cell_replace(seen, live_encode(registry)) {
            if event != "" -> rt_web.live_publish("live:{id}", event)
            return
        }
    }
}

// Marks dirty every binding of `source`, or only the one whose key is `key`,
// then publishes each marked binding's invalidation to the WebSocket live
// hub: topic `live:<id>`, the event `live_event` (with the rest of its hold
// when the binding is held). Only connections that watch that binding
// (`watch`) receive it; one that starts watching later first receives the
// topic's latest. A whole-source invalidation also marks every binding that
// read `source`: of those that read it narrowed (`live_reads`), only the ones
// whose narrowed read is in `reached`, when it is given. The binding `skip`
// (none when 0) is never marked: its own run made the change.
live_invalidate: fn(source: String, key: String?, reached: [String]?, skip: Int) {
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return
        now: rt.clock_mono_ns()
        hits := [Int]{}
        events := [String]{}
        loop index in 0..<registry.records.len() {
            if registry.records[index].id == skip -> next
            // An exact-key invalidation names one binding of `source`; a
            // whole-source one also reaches every binding that read it.
            if registry.records[index].source == source {
                if key == .Val(only) && registry.records[index].key != only -> next
            } else if key != None || !live_read_hit(registry.records[index].reads, source, reached) {
                next
            }
            registry.records[index].dirty = true
            registry.records[index].generation += 1
            id: registry.records[index].id
            held: registry.records[index].held_ns
            hits.push(id)
            events.push(live_event(id, if held > now -> Val(live_hold_ms(held - now)) else -> None))
        }
        if hits.len() == 0 {
            return
        }
        registry.invalidations += hits.len()
        registry.ws_pushes += 1
        if live_cell_replace(seen, live_encode(registry)) {
            loop at in 0..<hits.len() -> rt_web.live_publish("live:{hits[at]}", events[at])
            return
        }
    }
}

// Whether a binding with read set `reads` read `source`: all of it, or
// narrowed by a read in `held` (every narrowed read when it is None).
live_read_hit: fn(reads: [String], source: String, held: [String]?) -> Bool {
    if reads.contains(source) -> return true
    prefix: "{source}?"
    loop read in reads {
        if !read.starts_with(prefix) -> next
        if held == .Val(narrowed) && !narrowed.contains(read) -> next
        return true
    }
    false
}

// The live hub's event for binding `id`: re-read it, or, while it is held,
// re-read it after `after_ms`, since a read before then gets its held stale
// result.
live_event: fn(id: Int, after_ms: Int?) -> String {
    if after_ms == .Val(ms) {
        return "{{\"live\":\"invalidate\",\"binding\":{id},\"after_ms\":{ms}}}"
    }
    "{{\"live\":\"invalidate\",\"binding\":{id}}}"
}

// `ns` in whole milliseconds, rounded up, so a client that waits them reads
// after the hold.
live_hold_ms: fn(ns: Int) -> Int { (ns + 999999) /% 1000000 }

live_index: fn(registry: LiveRegistry, id: Int) -> Int? {
    loop index in 0..<registry.records.len() {
        if registry.records[index].id == id -> return Val(index)
    }
    None
}

// The cell holds the registry as length-prefixed fields: next id,
// invalidations, changes, evictions, WebSocket pushes, capped re-runs, the
// re-run window's start and count, then twelve fields per binding, the
// eleventh its read set joined by newlines and the last its caller.
live_encode: fn(registry: LiveRegistry) -> [U8] {
    out := [U8]{}
    live_put(out, "{registry.next_id}")
    live_put(out, "{registry.invalidations}")
    live_put(out, "{registry.changes}")
    live_put(out, "{registry.evictions}")
    live_put(out, "{registry.ws_pushes}")
    live_put(out, "{registry.capped}")
    live_put(out, "{registry.window_ns}")
    live_put(out, "{registry.window_runs}")
    loop record in registry.records {
        live_put(out, "{record.id}")
        live_put(out, record.source)
        live_put(out, record.key)
        live_put(out, record.value)
        live_put(out, if record.dirty -> "1" else -> "0")
        live_put(out, "{record.generation}")
        live_put(out, "{record.overtaken}")
        live_put(out, "{record.held_ns}")
        live_put(out, "{record.every_ns}")
        live_put(out, "{record.ran_ns}")
        live_put(out, record.reads.join("\n"))
        live_put(out, record.caller)
    }
    out
}

live_put: fn(out: &[U8], text: String) {
    loop byte in "{text.len()}:".bytes() -> out.push(byte)
    loop byte in text.bytes() -> out.push(byte)
}

// An empty cell is the empty registry; None when the bytes are malformed.
live_decode: fn(raw: [U8]) -> LiveRegistry? {
    if raw.len() == 0 {
        return Val(LiveRegistry{next_id: 0, invalidations: 0, changes: 0, evictions: 0, ws_pushes: 0, capped: 0, window_ns: 0, window_runs: 0, records: [LiveRecord]{}})
    }
    fields: live_fields(raw) ?? return None
    if fields.len() < 8 || (fields.len() - 8) % 12 != 0 -> return None
    next_id: Int.parse(fields[0]) ?? return None
    invalidations: Int.parse(fields[1]) ?? return None
    changes: Int.parse(fields[2]) ?? return None
    evictions: Int.parse(fields[3]) ?? return None
    ws_pushes: Int.parse(fields[4]) ?? return None
    capped: Int.parse(fields[5]) ?? return None
    window_ns: Int.parse(fields[6]) ?? return None
    window_runs: Int.parse(fields[7]) ?? return None
    records := [LiveRecord]{}
    at := 8
    loop at < fields.len() {
        id: Int.parse(fields[at]) ?? return None
        generation: Int.parse(fields[at + 5]) ?? return None
        overtaken: Int.parse(fields[at + 6]) ?? return None
        held_ns: Int.parse(fields[at + 7]) ?? return None
        every_ns: Int.parse(fields[at + 8]) ?? return None
        ran_ns: Int.parse(fields[at + 9]) ?? return None
        reads: if fields[at + 10] == "" -> [String]{} else -> fields[at + 10].split("\n").to_list()
        records.push(LiveRecord{id: id, source: fields[at + 1], key: fields[at + 2], value: fields[at + 3], dirty: fields[at + 4] == "1", generation: generation, overtaken: overtaken, held_ns: held_ns, every_ns: every_ns, ran_ns: ran_ns, reads: reads, caller: fields[at + 11]})
        at += 12
    }
    Val(LiveRegistry{next_id: next_id, invalidations: invalidations, changes: changes, evictions: evictions, ws_pushes: ws_pushes, capped: capped, window_ns: window_ns, window_runs: window_runs, records: records})
}

// The length-prefixed fields (`<decimal byte length>:<bytes>`) of `raw`.
live_fields: fn(raw: [U8]) -> [String]? {
    fields := [String]{}
    at := 0
    loop at < raw.len() {
        length := 0
        loop {
            if at >= raw.len() -> return None
            n: Int{raw[at]}
            at += 1
            if n == 58 -> break
            if n < 48 || n > 57 -> return None
            length = length * 10 + n - 48
        }
        if at + length > raw.len() -> return None
        fields.push(String.from_bytes(raw.slice(at, at + length)) ?? return None)
        at += length
    }
    Val(fields)
}

// Publish the canonical display of a CRDT document onto session `over`
// (jet_sync_publish). A session keeps its generation and merged document; a
// publication that changes the document advances the generation, and a
// duplicate delivery returns the existing receipt. The document merges only
// facts that survive the display: map keys with equal values, list members and
// counter components. A conflicting map value or a differing text document is
// denied rather than replaced by a lexical winner. The Rust adapter also handed
// each change to the installed live transport subscribers; the native runtime
// installs none.
sync: fn(doc_show: String, over: String) -> String Never! {
    if over.trim() == "" || over.len() > SYNC_MAX_SESSION || unicode.has_control(over) {
        return "SyncError(invalid session)"
    }
    document: sync_document_parse(doc_show) ?? return "SyncError(document is not a canonical CRDT value)"
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return "SyncError(session registry is unavailable)"
        found := -1
        sessions := 0
        loop index in 0..<registry.records.len() {
            if registry.records[index].source != LIVE_SYNC_SOURCE -> next
            sessions += 1
            if registry.records[index].key == over -> found = index
        }
        generation := 0
        current := document.copy()
        if found >= 0 {
            stored: sync_session_decode(registry.records[found].value) ?? return "SyncError(session registry is unavailable)"
            generation = stored.generation
            current = stored.document.copy()
        } else if sessions >= SYNC_MAX_ENTRIES { return "SyncError(session limit exceeded)" }
        changed := false
        if current != document {
            merged: sync_document_merge(current, document) ?? return "SyncError(document merge denied)"
            if merged != current {
                if generation >= SYNC_MAX_INT -> return "SyncError(session generation exhausted)"
                generation += 1
                current = merged
                changed = true
            }
        } else if generation == 0 {
            generation = 1
            changed = true
        }
        receipt: "SyncOver(session={over}, generation={generation}, doc={current})"
        if !changed -> return receipt
        value: "{generation}:{current}"
        if found >= 0 -> registry.records[found].value = value else {
            id: registry.next_id + 1
            registry.next_id = id
            registry.records.push(LiveRecord{id: id, source: LIVE_SYNC_SOURCE, key: over.copy(), value: value, dirty: false, generation: 0, overtaken: 0, held_ns: 0, every_ns: 0, ran_ns: 0, reads: [String]{}, caller: ""})
        }
        if live_cell_replace(seen, live_encode(registry)) -> return receipt
    }
}

SyncSession: struct {
    generation: Int,
    document: String
}

sync_session_decode: fn(value: String) -> SyncSession? {
    colon: value.find(":")
    if colon < 0 -> return None
    generation: Int.parse(value.slice(0, colon)) ?? return None
    Val(SyncSession{generation: generation, document: value.slice(colon + 1, value.len())})
}

// The canonical document `value` names, or None when it is malformed or not in
// canonical order (JetSyncDocument::parse).
sync_document_parse: fn(value: String) -> String? {
    if value == "" || value.trim() != value || value.len() > SYNC_MAX_DOCUMENT || unicode.has_control(value) {
        return None
    }
    if !value.ends_with(")") -> return None
    if value.starts_with("SyncText(") -> return Val(value.copy())
    canonical := ""
    if value.starts_with("SyncMap(") {
        canonical = sync_map_show(sync_map_entries(value) ?? return None)
    } else if value.starts_with("SyncList(") {
        canonical = sync_list_show(sync_list_items(value) ?? return None)
    } else if value.starts_with("PNCounter(") {
        canonical = sync_counter_show(sync_counter_entries(value) ?? return None)
    } else { return None }
    if canonical != value -> return None
    Val(canonical)
}

sync_document_merge: fn(left: String, right: String) -> String? {
    if left == right -> return Val(left.copy())
    merged := ""
    if left.starts_with("SyncMap(") && right.starts_with("SyncMap(") {
        entries := sync_map_entries(left) ?? return None
        other: sync_map_entries(right) ?? return None
        loop key in other.keys() {
            value: other.get(key) ?? next
            if entries.get(key) == .Val(existing) {
                if existing != value -> return None
            } else { _: entries.add(key, value) }
        }
        if entries.len() > SYNC_MAX_ENTRIES -> return None
        merged = sync_map_show(entries)
    } else if left.starts_with("SyncList(") && right.starts_with("SyncList(") {
        items := sync_list_items(left) ?? return None
        loop item in sync_list_items(right) ?? return None {
            items = sync_pair_insert(items, item) ?? items
        }
        if items.len() > SYNC_MAX_ENTRIES -> return None
        merged = sync_list_show(items)
    } else if left.starts_with("PNCounter(") && right.starts_with("PNCounter(") {
        counts := sync_counter_entries(left) ?? return None
        other: sync_counter_entries(right) ?? return None
        loop replica in other.keys() {
            count: other.get(replica) ?? next
            slot: counts.get(replica) ?? SyncCount{positive: 0, negative: 0}
            positive: if count.positive > slot.positive -> count.positive else -> slot.positive
            negative: if count.negative > slot.negative -> count.negative else -> slot.negative
            _: counts.add(replica, SyncCount{positive: positive, negative: negative})
        }
        if counts.len() > SYNC_MAX_REPLICAS -> return None
        merged = sync_counter_show(counts)
    } else { return None }
    sync_document_parse(merged)
}

SyncPair: struct {
    first: String,
    second: String
}

SyncCount: struct {
    positive: Int,
    negative: Int
}

sync_map_entries: fn(value: String) -> [String:String]? {
    body: sync_document_body(value, "SyncMap(") ?? return None
    entries := [String:String]{}
    if body == "" -> return Val(entries)
    loop entry in sync_split(body, ",") ?? return None {
        pair: sync_split_once(entry, "=") ?? return None
        key: sync_unescape(pair.first) ?? return None
        item: sync_unescape(pair.second) ?? return None
        if !sync_token_valid(key) || item.len() > SYNC_MAX_TEXT || entries.get(key) != .None {
            return None
        }
        _: entries.add(key, item)
    }
    Val(entries)
}

sync_map_show: fn(entries: [String:String]) -> String {
    keys := [String]{}
    loop key in entries.keys() -> keys.push(key)
    keys.sort()
    shown := [String]{}
    loop key in keys {
        value: entries.get(key) ?? next
        shown.push("{sync_escape(key)}={sync_escape(value)}")
    }
    "SyncMap({shown.join(",")})"
}

sync_list_items: fn(value: String) -> [SyncPair]? {
    body: sync_document_body(value, "SyncList(") ?? return None
    items := [SyncPair]{}
    if body == "" -> return Val(items)
    loop raw in sync_split(body, "|") ?? return None {
        pair: sync_split_once(raw, ":") ?? return None
        replica: sync_unescape(pair.first) ?? return None
        item: sync_unescape(pair.second) ?? return None
        if !sync_token_valid(replica) || item.len() > SYNC_MAX_TEXT -> return None
        items = sync_pair_insert(items, SyncPair{first: replica, second: item}) ?? return None
    }
    if items.len() > SYNC_MAX_ENTRIES -> return None
    Val(items)
}

// `items` with `item` in (first, second) order; None when already present.
sync_pair_insert: fn(items: [SyncPair], item: SyncPair) -> [SyncPair]? {
    out := [SyncPair]{}
    placed := false
    loop existing in items {
        if existing.first == item.first && existing.second == item.second -> return None
        later: if existing.first == item.first -> existing.second > item.second else -> existing.first > item.first
        if !placed && later {
            out.push(item.copy())
            placed = true
        }
        out.push(existing.copy())
    }
    if !placed -> out.push(item.copy())
    Val(out)
}

sync_list_show: fn(items: [SyncPair]) -> String {
    shown := [String]{}
    loop item in items -> shown.push("{sync_escape(item.first)}:{sync_escape(item.second)}")
    "SyncList({shown.join("|")})"
}

sync_counter_entries: fn(value: String) -> [String:SyncCount]? {
    body: sync_document_body(value, "PNCounter(") ?? return None
    counts := [String:SyncCount]{}
    if body == "" -> return Val(counts)
    loop entry in sync_split(body, ",") ?? return None {
        pair: sync_split_once(entry, "=") ?? return None
        replica: sync_unescape(pair.first) ?? return None
        sides: sync_split_once(pair.second, "/") ?? return None
        positive: sync_count_parse(sync_unescape(sides.first) ?? return None, "+") ?? return None
        negative: sync_count_parse(sync_unescape(sides.second) ?? return None, "-") ?? return None
        if !sync_token_valid(replica) || counts.get(replica) != .None -> return None
        _: counts.add(replica, SyncCount{positive: positive, negative: negative})
    }
    if counts.len() > SYNC_MAX_REPLICAS -> return None
    // The checked total of positive minus negative counts must stay an Int.
    total := 0
    loop replica in counts.keys() {
        count: counts.get(replica) ?? next
        if total > 0 && count.positive > SYNC_MAX_INT - total -> return None
        total += count.positive
        if total < 0 && count.negative > SYNC_MAX_INT + total + 1 -> return None
        total -= count.negative
    }
    Val(counts)
}

sync_counter_show: fn(counts: [String:SyncCount]) -> String {
    replicas := [String]{}
    loop replica in counts.keys() -> replicas.push(replica)
    replicas.sort()
    shown := [String]{}
    loop replica in replicas {
        count: counts.get(replica) ?? next
        shown.push("{sync_escape(replica)}=+{count.positive}/-{count.negative}")
    }
    "PNCounter({shown.join(",")})"
}

// `text` is `sign` then decimal digits; its value.
sync_count_parse: fn(text: String, sign: String) -> Int? {
    if !text.starts_with(sign) || text.len() == 1 -> return None
    digits: text.slice(1, text.len())
    loop byte in digits.bytes() {
        n: Int{byte}
        if n < 48 || n > 57 -> return None
    }
    Val(Int.parse(digits) ?? return None)
}

sync_document_body: fn(value: String, prefix: String) -> String? {
    if !value.starts_with(prefix) || !value.ends_with(")") || value.len() < prefix.len() + 1 {
        return None
    }
    Val(value.slice(prefix.len(), value.len() - 1))
}

sync_token_valid: fn(value: String) -> Bool {
    value.trim() != "" && value.len() <= SYNC_MAX_TEXT && !unicode.has_control(value)
}

sync_is_separator: fn(scalar: String) -> Bool {
    scalar == "," || scalar == "=" || scalar == "|" || scalar == ":" || scalar == "/"
}

sync_escape: fn(value: String) -> String {
    out := ""
    loop scalar in unicode.scalars(value) {
        if scalar == "\\" || sync_is_separator(scalar) -> out = "{out}\\"
        out = "{out}{scalar}"
    }
    out
}

// None when an escape is dangling or names no separator, or when a separator
// appears unescaped.
sync_unescape: fn(value: String) -> String? {
    out := ""
    escaped := false
    loop scalar in unicode.scalars(value) {
        if escaped {
            if scalar != "\\" && !sync_is_separator(scalar) -> return None
            out = "{out}{scalar}"
            escaped = false
        } else if scalar == "\\" { escaped = true } else if sync_is_separator(scalar) {
            return None
        } else { out = "{out}{scalar}" }
    }
    if escaped -> return None
    Val(out)
}

// The parts of `value` between unescaped `separator`s, escapes kept.
sync_split: fn(value: String, separator: String) -> [String]? {
    parts := [String]{}
    current := ""
    escaped := false
    loop scalar in unicode.scalars(value) {
        if escaped {
            current = "{current}\\{scalar}"
            escaped = false
        } else if scalar == "\\" { escaped = true } else if scalar == separator {
            parts.push(current)
            current = ""
        } else { current = "{current}{scalar}" }
    }
    if escaped -> return None
    parts.push(current)
    Val(parts)
}

// `value` split at its first unescaped `separator`; None without one.
sync_split_once: fn(value: String, separator: String) -> SyncPair? {
    before := ""
    escaped := false
    at := 0
    loop scalar in unicode.scalars(value) {
        at += scalar.len()
        if escaped -> escaped = false else if scalar == "\\" -> escaped = true else if scalar == separator {
            return Val(SyncPair{first: before, second: value.slice(at, value.len())})
        }
        before = "{before}{scalar}"
    }
    None
}
