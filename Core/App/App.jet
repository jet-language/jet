package: {
    name: "app"
    version: "0.0.1"
    edition: "2026"
    description: "Process-level live queries, subscriptions, invalidation and sync."
    license: "MIT"
    outputs: {
        app: .Library{ entry: app }
    }
}

// Live bindings live in one process-wide registry below; sync sessions are
// records of that registry under LIVE_SYNC_SOURCE.
use {
    auth: core.auth
    base64: core.encoding.base64
    unicode: core.text
    http: core.http
    crypto: core.crypto
    live_json: core.encoding.json
    core.encoding.[Dyn]
    core.reactive.loadable.[Loadable]
    ws: core.net.ws
    core.net.ws.[WsConn]
    tasks: core.tasks
    core.tasks.[TaskID]
    uuid: core.crypto.uuid
    time: core.time
    rt: jet.runtime.time
    rt_web: jet.runtime.web
    ui_rt: jet.runtime.ui
    world_rt: jet.runtime.testing
    log_rt: jet.runtime.log
    push_wire: __core_app_push
    dbus: __core_ui_dbus
    url: core.net.url
    files: core.files
    core.term.[Key]
    core.ui.host.[UIShortcut, UIShortcutModifiers]
    sys: core.sys
    process: core.process
    net: core.net
    core.net.[UnixListener, UnixStream]
    builtin: jet_builtins
    core.ui.[UINode]
    core.ui.host.drag_drop.[UIDropItem]
    ui: core.ui
    event: core.event
}

SYNC_MAX_SESSION: 256

SYNC_MAX_DOCUMENT: 4194304

SYNC_MAX_TEXT: 1048576

SYNC_MAX_ENTRIES: 100000

SYNC_MAX_REPLICAS: 4096

SYNC_MAX_INT: 9223372036854775807

#Error
AppError: enum {
    Invalid,
    Unsupported,
}

// Endpoint markers. A method of a mounted service is an endpoint only when
// one of these marks it: `#App.SignedIn` for a signed-in caller,
// `#App.Public` for any caller. An unmarked method is server-only.
// `limit:` caps the calls one caller makes in each `per` window
// (`#App.Public(limit: 30, per: 1min)`); a call past it is answered 429
// with `Retry-After`, which a Remote reads as `CallError.Unreachable`.
// `#App.Public` counts per network address; `#App.SignedIn` counts per
// account once sign-in names one, and per network address until then.
// `limit: 0`, the default, is no limit.
SignedIn: struct {
    limit: Int{0},
    per: Duration{1min},

    impl Marker {
        sites: [.Method],
    }
}

Public: struct {
    limit: Int{0},
    per: Duration{1min},

    impl Marker {
        sites: [.Method],
    }
}

// A webhook: `#App.Webhook(path: "/hooks/github/:project", signature:
// app.Signature.GitHub, key: "webhook_secret")` makes a method of a mounted
// service answer POST `path` for a sender that signs each delivery. Its
// parameters are the path's parameters, then the delivery's decoded JSON
// body. `key:` names the service's `#App.SigningKey` method, which gives the
// delivery's key from the same path parameters. A delivery runs only when
// that key is there and the delivery carries a valid `signature` under it,
// checked in constant time before the body is decoded; any other is answered
// 401. A webhook is no endpoint: no Remote calls it.
Webhook: struct {
    path: String,
    signature: Signature,
    key: String,

    impl Marker {
        sites: [.Method],
    }
}

// The method a webhook's `key:` names. It takes some of the webhook's path
// parameters, by name, and gives the key the sender signs with, or None,
// which answers 401. It is server-only.
SigningKey: struct {
    impl Marker {
        sites: [.Method],
    }
}

// An upload endpoint's check: `#App.UploadCheck(method: "may_attach")` on an
// endpoint method that takes an `Upload` names the method of the same
// service that decides whether the caller may send the file. That method
// takes, by name, some of the endpoint's arguments other than the `Upload`,
// and gives nothing or the error that refuses the call. It runs after the
// request's head is read and before its body is: as the caller, in a
// transaction that is always rolled back, so it can read but never write. An
// error ends the request 403 with that error, and the body is never read.
// An endpoint that takes an `Upload` has to name its check.
UploadCheck: struct {
    method: String,

    impl Marker {
        sites: [.Method],
    }
}

// A job: `#App.Job(retries: 3)` makes a method of a service a job, which the
// service's own methods queue with `enqueue(fn() { self.method(args) })`.
// Queued inside a call, a job waits for the call: when the call commits it
// runs, once its transaction is done, and when the call rolls back it never
// runs. A job runs as the system (`as_system`), in a call of its own, and a
// run that fails runs again after a backoff, up to `retries:` more times. A
// job is no endpoint: no Remote calls it.
Job: struct {
    retries: Int{5},

    impl Marker {
        sites: [.Method],
    }
}

// A schedule: `#App.Every(cron: "0 8 * * *")` runs a method of a mounted
// service at each minute its cron line allows, in UTC, while the App serves.
// The line has five fields, each a `*`, a number, a range `a-b`, or a list
// of those, each optionally stepped (`*/15`): the minute (0-59), the hour
// (0-23), the day of the month (1-31), the month (1-12) and the day of the
// week (0-7, Sunday 0 or 7). A day is due when both day fields allow it,
// or either does when neither starts with `*`. At start-up a server runs
// the schedule's latest due minute, a run it missed while no server ran,
// and then each next one. A store the run uses records it, so each due
// minute runs on one server, however many serve the App. A schedule runs
// as the system (`as_system`), in a call of its own, and is no endpoint:
// no Remote calls it.
Every: struct {
    cron: String,

    impl Marker {
        sites: [.Method],
    }
}

// How a webhook's sender signs a delivery: an HMAC-SHA256, hex-encoded,
// under the webhook's key.
Signature: enum {
    GitHub,
    Stripe,
}

// GitHub: `X-Hub-Signature-256: sha256=<mac>`, the MAC of the body.
// Stripe: `Stripe-Signature: t=<seconds>,v1=<mac>`, the MAC of
// `<seconds>.<body>`; any one `v1` entry may match.

// The request header that carries a delivery's `signature`.
priv webhook_header: fn(signature: Signature) -> String Never! {
    if signature == {
        .GitHub -> "x-hub-signature-256"
        .Stripe -> "stripe-signature"
    }
}

// Whether `sent`, the delivery's signature header, signs `body` under `key`
// by `signature`. Each MAC is compared in constant time, and every `v1`
// entry of a Stripe header is compared.
priv webhook_signed: fn(signature: Signature, key: String, sent: String, body: String) -> Bool Never! {
    if signature == {
        .GitHub -> {
            expected: "sha256={crypto.hex_encode(crypto.hmac_sha256(key.bytes(), body.bytes()))}"
            crypto.constant_time_equal_bytes(expected.bytes(), sent.bytes())
        }
        .Stripe -> {
            stamp := ""
            macs := [String]{}
            loop part in sent.split(",") {
                entry: part.trim()
                if entry.starts_with("t=") -> stamp = entry.slice(2, entry.len())
                if entry.starts_with("v1=") -> macs.push(entry.slice(3, entry.len()))
            }
            if stamp == "" -> return false
            expected: crypto.hex_encode(crypto.hmac_sha256(key.bytes(), "{stamp}.{body}".bytes()))
            matched := false
            loop mac in macs {
                if crypto.constant_time_equal_bytes(expected.bytes(), mac.bytes()) -> matched = true
            }
            matched
        }
    }
}

#Test("webhook signatures check the sender's MAC") {
    // GitHub's published example delivery.
    github: "sha256=757107ea0eb2509fc211221cce984b8a37570b6d7586c22c46f4379c8b043e17"
    assert(webhook_signed(.GitHub, "It's a Secret to Everybody", github, "Hello, World!"))
    assert(!webhook_signed(.GitHub, "It's a Secret to Everybody", github, "Hello, World?"))
    assert(!webhook_signed(.GitHub, "another key", github, "Hello, World!"))
    assert(!webhook_signed(.GitHub, "It's a Secret to Everybody", "", "Hello, World!"))
    mac: crypto.hex_encode(crypto.hmac_sha256("whsec".bytes(), "1700000000.{{\"id\":\"evt_1\"}}".bytes()))
    assert(webhook_signed(.Stripe, "whsec", "t=1700000000,v1=00,v1={mac}", "{{\"id\":\"evt_1\"}}"))
    assert(!webhook_signed(.Stripe, "whsec", "t=1700000001,v1={mac}", "{{\"id\":\"evt_1\"}}"))
    assert(!webhook_signed(.Stripe, "whsec", "v1={mac}", "{{\"id\":\"evt_1\"}}"))
    assert_eq(webhook_header(.Stripe), "stripe-signature")
}

// A client of the service `S`. It offers only the methods of `S` that
// `#App.SignedIn` or `#App.Public` marks: a call of any other method of `S`
// is E2812, and the service itself stays out of reach. A call through a
// Remote that `remote` made runs the method directly on that service; one
// through a Remote that `remote_at` made posts it to the server, and one
// through the app graph's Remote of a service the graph mounts (`App.__remote`)
// is answered in this process as a server answers it (`graph_post`). Either
// way the call is one transaction on each store it uses, as a served call is
// (`transactions`), and the call's error type takes a `CallError`: a method
// that fails with `E` needs `impl CallError -> E`, and one that can't fail
// answers `R CallError!`. A Remote made for a named client fails each call
// `.Unreachable`, running nothing, while a test has that client cut off
// (`disconnect`). On a device that queues (`App.offline(.Queue)`), a
// method that answers nothing is a write, and a write through a Remote
// that posts joins the device's queue when it can't be sent now (`__write`);
// every call through such a Remote sends its client's queued writes first.
Remote: struct<S> {
    priv service: S?,
    priv address: String,
    priv client: String,
    // Whether the app graph mounts `S`, so `address` names `S` in it.
    priv local: Bool,

    // A call of the endpoint method `method` of `S`, which can fail with
    // `E`. The compiler lowers each such call here: `direct` runs it on the
    // service the Remote holds; otherwise `args`, the encoded arguments, go to
    // the server, and `fail` gives a `CallError` as the method's own error.
    __call: fn<R: [Encode, Decode], E: [Encode, Decode]>(self, method: String, args: [String], direct: fn(S) -> R E!, fail: fn(CallError) -> R E!) -[Net, Time]> R E! {
        if links_cut(self.client) -> return fail(links_unreachable(self.client, method))
        if self.service == .Val(service) -> return remote_direct(service, direct, fail)
        if queue_on() -> _: queue_drain(self.client)
        reply: remote_post(self.address, self.local, method, args) ?? return fail(err)
        tree: live_json.parse(reply) ?? return fail(.Unreachable("the server's reply to `{method}` is not JSON"))
        if live_json.at<E>(tree, "/err") == .Ok(error) -> return Err(error)
        value: live_json.at<R>(tree, "/ok") ?? return fail(.Unreachable("the server's reply to `{method}` has no value"))
        Ok(value)
    }

    // A call of the endpoint method `method` of `S`, which can't fail.
    __call_value: fn<R: [Encode, Decode]>(self, method: String, args: [String], direct: fn(S) -> R Never!) -[Net, Time]> R CallError! {
        if links_cut(self.client) -> return Err(links_unreachable(self.client, method))
        if self.service == .Val(service) -> return remote_direct_value(service, direct)
        if queue_on() -> _: queue_drain(self.client)
        reply: remote_post(self.address, self.local, method, args)
        tree: live_json.parse(reply) ?? return Err(.Unreachable("the server's reply to `{method}` is not JSON"))
        value: live_json.at<R>(tree, "/ok") ?? return Err(.Unreachable("the server's reply to `{method}` has no value"))
        Ok(value)
    }

    // A call of the endpoint method `method` of `S` that answers nothing
    // and can fail with `E`: a write. On a device that queues, a write
    // through a Remote that posts joins the queue, and the call succeeds at
    // once, when its client is cut off, when the client's earlier writes
    // are still queued, or when no answer comes (`queue_post`); otherwise
    // it runs as `__call` runs a call.
    __write: fn<E: [Encode, Decode]>(self, method: String, args: [String], direct: fn(S) E!, fail: fn(CallError) E!) -[Net, Time]> E! {
        held: self.service == .Val(_)
        queues: queue_on() && !held
        if !queues && links_cut(self.client) -> return fail(links_unreachable(self.client, method))
        if self.service == .Val(service) -> return remote_direct(service, direct, fail)
        reply := ""
        if queues {
            reply = queue_post(self.client, self.address, self.local, method, args) ?? return fail(err)
        } else { reply = remote_post(self.address, self.local, method, args) ?? return fail(err) }
        if reply == "" -> return Ok()
        tree: live_json.parse(reply) ?? return fail(.Unreachable("the server's reply to `{method}` is not JSON"))
        if live_json.at<E>(tree, "/err") == .Ok(error) -> return Err(error)
        Ok()
    }

    // A write of the endpoint method `method` of `S`, which can't fail.
    __write_value: fn(self, method: String, args: [String], direct: fn(S) Never!) -[Net, Time]> CallError! {
        held: self.service == .Val(_)
        queues: queue_on() && !held
        if !queues && links_cut(self.client) -> return Err(links_unreachable(self.client, method))
        if self.service == .Val(service) -> return remote_direct_value(service, direct)
        reply := ""
        if queues {
            reply = queue_post(self.client, self.address, self.local, method, args) ?? return Err(err)
        } else { reply = remote_post(self.address, self.local, method, args) }
        if reply == "" -> return Ok()
        _: live_json.parse(reply) ?? return Err(.Unreachable("the server's reply to `{method}` is not JSON"))
        Ok()
    }

    // One argument of a remote call, encoded.
    __arg: fn<A: Encode>(self, value: A) -> String Never! {
        live_json.to_string<A>(value) ?? "null"
    }
}

// A call that `direct` runs on `service`, the service a Remote holds, as one
// transaction on each store it uses, retried while a store stays busy.
priv remote_direct: fn<S, R, E>(service: S, direct: fn(S) -> R E!, fail: fn(CallError) -> R E!) -> R E! {
    loop _ in 0..<transactions.attempts() {
        call: transactions.begin() ?? return direct(service)
        if direct(service) == {
            .Ok(value) -> {
                if transactions.end(call, true) -> return Ok(value)
            }
            .Err(error) -> {
                if transactions.end(call, false) -> return Err(error)
            }
        }
    }
    fail(.Unreachable("the database stayed busy"))
}

// remote_direct for a method that can't fail.
priv remote_direct_value: fn<S, R>(service: S, direct: fn(S) -> R Never!) -> R CallError! {
    loop _ in 0..<transactions.attempts() {
        call: transactions.begin() ?? return Ok(direct(service))
        value: direct(service)
        if transactions.end(call, true) -> return Ok(value)
    }
    Err(.Unreachable("the database stayed busy"))
}

// How a remote call failed. Every call through a `Remote` can fail this way,
// so the error type of a service method converts from it.
#Error
CallError: enum {
    Unreachable(String),
    Invalid([FieldError]),
    SignedOut,
    UpdateRequired,

    // This failure as an error of the call; the compiler's `fail` binds it,
    // so the method's error type takes it through its conversion.
    __raise: fn<R>(self) -> R CallError! { Err(self) }
}

// No answer: the server is down or unreachable, or its reply was not one
// a Remote reads.
// The server could not decode the call's arguments (HTTP 422): the field
// errors its reply names.
// The method needs a signed-in caller, and the call had none (HTTP 401).
// The server no longer accepts this client's wire version (HTTP 426).

// A field error a method reports for one of its arguments, from a rule the
// argument's `validate` block can't check (one that reads the database):
// `at` is the path of the field it is about, in that argument (`assignee`,
// `tasks[3].title`, `tasks[{index}].title`), and `reason` what is wrong with
// it. `at` must be a string literal, interpolated only inside a `[…]` index,
// that walks to a stored field of a struct argument of the method that
// reports it (E2813), so the error shows beside that field, as a failed
// `validate` check does.
field_error: fn(at: String, reason: String) -> FieldError Never! {
    FieldError{path: at, reason: reason}
}

// A fresh UUIDv7, as lowercase text, made where it is called: the Unix
// millisecond it was made, then 74 random bits. A client gives a row it
// creates this ID, so a row made offline has its final ID at once, and IDs
// made later sort after it. It stops the task when the system has no
// random source.
new_id: fn() -[Rand, Time]> String Never! {
    clock := time.Clock.new(time.now_utc().to_unix_ms())
    uuid.v7(clock) ?? panic("app.new_id: {err}")
}

#Test("a new ID is UUIDv7 text that names the millisecond it was made") {
    before: time.now_utc().to_unix_ms()
    first: new_id()
    second: new_id()
    after: time.now_utc().to_unix_ms()
    assert(first != second)
    assert_eq(first.len(), 36)
    assert_eq(first.slice(14, 15), "7")
    assert(first.slice(19, 20) == "8" || first.slice(19, 20) == "9" || first.slice(19, 20) == "a" || first.slice(19, 20) == "b")
    assert_eq(uuid.parse(first) ?? panic("the ID parses"), first)
    made := 0
    loop b in "{first.slice(0, 8)}{first.slice(9, 13)}".bytes() {
        digit: if b >= 97 -> Int{b} - 87 else -> Int{b} - 48
        made = made * 16 + digit
    }
    assert(made >= before && made <= after)
}

// Where a handler's failure goes. A control's handler has the type
// `fn() app.Notice!`, so its error type converts to a Notice; the frame
// shows the notice beside the control, announces it, and keeps it until
// it is dismissed. `retry` offers to run the handler again.
#Error
Notice: struct {
    text: String,
    retry: Bool{false},
}

// The app's notice list holds the notices that have no control to sit
// beside: a failed background run, a queued write refused after its screen
// closed. The frame shows the list on every screen and keeps each notice
// until it is dismissed. The list lives in the device store
// (`device_cell_load`), so it outlasts a restart. It is kept as
// length-prefixed fields: each notice's text, then "1" or "0" for its retry.
NOTICE_CELL: Shared{LiveCell{bytes: [U8]{}}}

NOTICE_STORE: "app.notices"

priv notice_cell_load: fn() -> [U8] { device_cell_load(NOTICE_STORE, NOTICE_CELL) }

priv notice_cell_replace: fn(expected: [U8], replacement: ^^[U8]) -> Bool {
    device_cell_replace(NOTICE_STORE, NOTICE_CELL, expected, replacement)
}

// The bytes of the store `store`: on the device (`jet.runtime.web`
// device_load: a file under the platform data directory and the app's
// package name, written through atomically), so a restart finds them as the
// run left them; inside a deterministic world, the World's own cell of that
// name; in a program with no device store (a test build), `cell`, one
// process-wide cell.
priv device_cell_load: fn(store: String, cell: Shared<LiveCell>) -> [U8] Never! {
    if world_rt.world_store_load(store) == .Val(bytes) -> return bytes
    if rt_web.device_load(store) == .Val(bytes) -> return bytes
    cell.bytes
}

// Replaces the bytes of the store `store` (`device_cell_load`) with
// `replacement` only while they still equal `expected`; gives whether it did.
priv device_cell_replace: fn(store: String, cell: Shared<LiveCell>, expected: [U8], replacement: ^^[U8]) -> Bool Never! {
    if world_rt.world_store_replace(store, expected, replacement) == .Val(replaced) {
        return replaced
    }
    if rt_web.device_replace(store, expected, replacement) == .Val(replaced) -> return replaced
    held := cell.guard_edit()
    if held.value.bytes != expected -> return false
    held.value.bytes = replacement.move()
    true
}

// Adds `notice` to the end of the app's notice list, which the app's
// window then shows (`app_window_noticed`).
priv __keep_notice: fn(notice: Notice) {
    loop {
        seen: notice_cell_load()
        kept := seen.copy()
        live_put(kept, notice.text)
        live_put(kept, if notice.retry -> "1" else -> "0")
        if notice_cell_replace(seen, kept) {
            app_window_noticed()
            return
        }
    }
}

// The app's notice list, oldest first: the notices with no control to sit
// beside, each kept until it is dismissed.
notices: fn() -> [Notice] { notice_decode(notice_cell_load()) }

// Removes the notice at position `at` of the app's notice list; nothing
// when there is none.
priv __dismiss: fn(at: Int) {
    loop {
        seen: notice_cell_load()
        listed: notice_decode(seen)
        if at < 0 || at >= listed.len() {
            return
        }
        kept := [U8]{}
        loop index in 0..<listed.len() {
            if index == at -> next
            live_put(kept, listed[index].text)
            live_put(kept, if listed[index].retry -> "1" else -> "0")
        }
        if notice_cell_replace(seen, kept) {
            return
        }
    }
}

// The notices of an encoded list; malformed bytes are an empty list.
priv notice_decode: fn(raw: [U8]) -> [Notice] {
    fields: live_fields(raw) ?? return [Notice]{}
    listed := [Notice]{}
    at := 0
    loop at + 1 < fields.len() {
        listed.push(Notice{text: fields[at], retry: fields[at + 1] == "1"})
        at += 2
    }
    listed
}

#Test("a kept notice stays in the app's notice list, in order, until it is dismissed") {
    before: notices().len()
    __keep_notice(Notice{text: "Couldn't sync the board.", retry: true})
    __keep_notice(Notice{text: "That task no longer exists."})
    kept: notices()
    assert_eq(kept.len(), before + 2)
    assert_eq(kept[before].text, "Couldn't sync the board.")
    assert(kept[before].retry, "the first notice offers a retry")
    assert_eq(kept[before + 1].text, "That task no longer exists.")
    assert(!kept[before + 1].retry, "a notice offers no retry unless it says so")
    __dismiss(before)
    __dismiss(kept.len())
    left: notices()
    assert_eq(left.len(), before + 1)
    assert_eq(left[before].text, "That task no longer exists.")
}

// The largest reply a remote call reads.
REMOTE_MAX_REPLY: 16777216

// The Remote of a service the server holds: each call through it runs the
// marked method on `service` directly. `client` names the client that holds
// it, which a test can cut off (`disconnect`); "" names none.
remote: fn<S>(service: ^^S, client: String{""}) -> Remote<S> Never! {
    Remote<S>{service: Val(service), address: "", client: client, local: false}
}

// The Remote of a service a server mounts at `address`, its mount prefix
// (`http://127.0.0.1:8080/api`): each call posts its JSON arguments to
// `{address}/{method}`. In a page an address with no origin (`/api`) is on
// the page's own. `client` is as for `remote`.
remote_at: fn<S>(address: String, client: String{""}) -> Remote<S> Never! {
    Remote<S>{service: None, address: address, client: client, local: false}
}

// The test host's link between each client and the servers. `disconnect`
// cuts client `client` off: until `reconnect`, each call through a Remote made
// for it (`remote(service, client: …)`, `remote_at`) fails `.Unreachable`,
// naming the client and the method, and runs nothing on the server. Nothing
// touches the network: the cut is one recorded fact, so an offline, catch-up
// or replay case runs the same each time. The servers, and every other
// client, go on; writes made on either side while cut off merge when the
// client calls again (`sync`). Inside a deterministic world (`testing.world`)
// the links are the World's own, so each world starts with every client
// connected. A client name is not blank and has no control character.
disconnect: fn(client: String) Never! { links_set(client, true) }

// Restores the link `disconnect` cut: the client's next call reaches the
// server again, and the writes the client queued meanwhile are sent now, in
// order (`queue_drain`).
reconnect: fn(client: String) -[Net, Time]> Never! {
    links_set(client, false)
    _: queue_drain(client)
}

// The clients a test cut off, one name a line, sorted, in one process-wide
// cell; inside a deterministic world, the World's own cell `app.links`.
priv LINKS_CELL: Shared{LiveCell{bytes: [U8]{}}}

priv links_load: fn() -> [U8] Never! {
    if world_rt.world_store_load("app.links") == .Val(bytes) -> return bytes
    LINKS_CELL.bytes
}

priv links_replace: fn(expected: [U8], replacement: ^^[U8]) -> Bool Never! {
    if world_rt.world_store_replace("app.links", expected, replacement) == .Val(replaced) {
        return replaced
    }
    cell := LINKS_CELL.guard_edit()
    if cell.value.bytes != expected -> return false
    cell.value.bytes = replacement.move()
    true
}

priv links_names: fn(raw: [U8]) -> [String] Never! {
    text: String.from_bytes(raw) ?? return [String]{}
    if text == "" -> return [String]{}
    text.split("\n").to_list()
}

// Whether a test cut client `client` off; a Remote of no client never is.
priv links_cut: fn(client: String) -> Bool Never! {
    if client == "" -> return false
    loop name in links_names(links_load()) {
        if name == client -> return true
    }
    false
}

priv links_set: fn(client: String, cut: Bool) Never! {
    if client.trim() == "" || unicode.has_control(client) {
        panic("app.disconnect: `{client}` is no client name: a name is not blank and has no control character")
    }
    loop {
        seen: links_load()
        names := [String]{}
        loop name in links_names(seen) {
            if name != client -> names.push(name)
        }
        if cut -> names.push(client.copy())
        names.sort()
        if links_replace(seen, names.join("\n").bytes()) {
            return
        }
    }
}

priv links_unreachable: fn(client: String, method: String) -> CallError Never! {
    .Unreachable("client `{client}` is disconnected, so `{method}` did not reach the server")
}

#Test("the test host cuts one client off until it reconnects, and leaves every other client and the unnamed one connected") {
    assert(!links_cut("phone"))
    disconnect("phone")
    disconnect("phone")
    disconnect("tablet")
    assert(links_cut("phone"))
    assert(!links_cut("desk"))
    assert(!links_cut(""))
    assert_eq(links_names(links_load()).join(","), "phone,tablet")
    assert_eq(links_unreachable("phone", "save"), CallError.Unreachable("client `phone` is disconnected, so `save` did not reach the server"))
    reconnect("phone")
    assert(!links_cut("phone"))
    assert(links_cut("tablet"))
    reconnect("phone")
    reconnect("tablet")
    assert_eq(links_names(links_load()).len(), 0)
}

// The device's queue of the writes it couldn't send, oldest first, when the
// app graph queues (`App.offline(.Queue)`): each is the call of `method`
// through a Remote of `client` that posts to `address` (`local`: the app
// graph answers it), its encoded arguments `body`, and the request key it
// keeps on every send, so a server that ran it once answers a repeat with
// the reply it kept.
#Equatable
priv QueuedWrite: struct {
    client: String,
    address: String,
    local: Bool,
    method: String,
    body: String,
    key: String,
}

// The queue lives where the notice list does: in the device store
// (`device_cell_load`), so a restart finds it as the run left it. It is kept
// as length-prefixed fields: each write's client, address, "1" or "0" for
// local, method, body and key.
priv QUEUE_CELL: Shared{LiveCell{bytes: [U8]{}}}

priv QUEUE_STORE: "app.queue"

priv queue_load: fn() -> [U8] Never! { device_cell_load(QUEUE_STORE, QUEUE_CELL) }

priv queue_replace: fn(expected: [U8], replacement: ^^[U8]) -> Bool Never! {
    device_cell_replace(QUEUE_STORE, QUEUE_CELL, expected, replacement)
}

// The writes of an encoded queue; malformed bytes are an empty queue.
priv queue_decode: fn(raw: [U8]) -> [QueuedWrite] Never! {
    fields: live_fields(raw) ?? return [QueuedWrite]{}
    writes := [QueuedWrite]{}
    at := 0
    loop at + 5 < fields.len() {
        writes.push(QueuedWrite{client: fields[at], address: fields[at + 1], local: fields[at + 2] == "1", method: fields[at + 3], body: fields[at + 4], key: fields[at + 5]})
        at += 6
    }
    writes
}

priv queue_put: fn(out: ^[U8], write: QueuedWrite) Never! {
    live_put(out, write.client)
    live_put(out, write.address)
    live_put(out, if write.local -> "1" else -> "0")
    live_put(out, write.method)
    live_put(out, write.body)
    live_put(out, write.key)
}

// Adds `write` to the end of the queue.
priv queue_add: fn(write: QueuedWrite) Never! {
    loop {
        seen: queue_load()
        kept := seen.copy()
        queue_put(kept, write)
        if queue_replace(seen, kept) {
            return
        }
    }
}

// Removes the write whose request key is `key`; nothing when none is queued.
priv queue_remove: fn(key: String) Never! {
    loop {
        seen: queue_load()
        kept := [U8]{}
        loop write in queue_decode(seen) {
            if write.key != key -> queue_put(kept, write)
        }
        if queue_replace(seen, kept) {
            return
        }
    }
}

// The oldest write client `client` queued.
priv queue_first: fn(client: String) -> QueuedWrite? Never! {
    loop write in queue_decode(queue_load()) {
        if write.client == client -> return Val(write.copy())
    }
    None
}

// Whether the app graph queues the writes it can't send.
priv queue_on: fn() -> Bool Never! {
    held: APP_GRAPH.guard_read()
    held.value.offline == .Queue
}

// The number of writes the device's queue holds, waiting to send.
pending: fn() -> Int Never! { queue_decode(queue_load()).len() }

// The clients whose queue a task is sending now, so one task sends a
// client's writes, in order, and a write made meanwhile, even by a call the
// sending runs, waits behind them.
priv QUEUE_SENDERS: Shared{[String]{}}

priv queue_claim: fn(client: String) -> Bool Never! {
    senders := QUEUE_SENDERS.guard_edit()
    loop name in senders.value {
        if name == client -> return false
    }
    senders.value.push(client.copy())
    true
}

priv queue_release: fn(client: String) Never! {
    senders := QUEUE_SENDERS.guard_edit()
    kept := [String]{}
    loop name in senders.value {
        if name != client -> kept.push(name.copy())
    }
    senders.value = kept
}

// Sends client `client`'s queued writes, oldest first, each under its own
// request key, unless another task sends them now. A write the server
// commits leaves the queue. A write it refuses (its method's error, or
// `.Invalid`) is rolled back: it leaves the queue, and a notice naming it
// and the refusal joins the app's notice list (`__keep_notice`), since its
// screen may be long gone. No answer, `.SignedOut` or `.UpdateRequired`
// stops the sending and keeps the write. True when the client's queue is
// empty after.
priv queue_drain: fn(client: String) -[Net, Time]> Bool Never! {
    if !queue_claim(client) -> return false
    sent: queue_send(client)
    queue_release(client)
    sent
}

// Sends every client's queued writes (`queue_drain`), each client's in
// order, when the app comes back (`app_resume_run`): the link they waited
// on may be back.
priv queue_resume: fn() -[Net, Time]> Never! {
    clients := [String]{}
    loop write in queue_decode(queue_load()) {
        if !clients.contains(write.client) -> clients.push(write.client.copy())
    }
    loop client in clients -> _: queue_drain(client)
}

priv queue_send: fn(client: String) -[Net, Time]> Bool Never! {
    loop {
        if links_cut(client) -> return false
        write: queue_first(client) ?? return true
        refusal := String?{None}
        if remote_send(write.address, write.local, write.method, write.body, write.key) == {
            .Ok(reply) -> { refusal = queue_refusal(reply) }
            .Err(failure) -> {
                if failure == {
                    .Invalid(fields) -> { refusal = Val(queue_invalid(fields)) }
                    .Unreachable(_) | .SignedOut | .UpdateRequired -> return false
                }
            }
        }
        queue_remove(write.key)
        if refusal == .Val(why) {
            __keep_notice(Notice{text: "The server refused `{write.method}`, so it was undone: {why}"})
        }
    }
}

// The error JSON of a reply that `__reply_err` made, `{"err":…}`; None for
// any other reply.
priv queue_refusal: fn(reply: String) -> String? Never! {
    if !reply.starts_with("{{\"err\":") || !reply.ends_with("}}") -> return None
    Val(reply.slice(7, reply.len() - 1))
}

priv queue_invalid: fn(fields: [FieldError]) -> String Never! {
    reasons := [String]{}
    loop field in fields {
        reasons.push(if field.path == "" -> field.reason.copy() else -> "{field.path}: {field.reason}")
    }
    reasons.join("; ")
}

// A write of `method` through a Remote of `client` that posts to `address`,
// on a device that queues: queued, so the call succeeds at once (""), when
// the client is cut off, when its earlier writes are still queued, or when
// no answer comes; else the reply it got, which is never empty. Sent or
// queued, the write keeps one request key.
priv queue_post: fn(client: String, address: String, local: Bool, method: String, args: [String]) -[Net, Time]> String CallError! {
    write: QueuedWrite{client: client, address: address, local: local, method: method, body: "[{args.join(",")}]", key: remote_key(address, method)}
    if links_cut(client) || !queue_drain(client) {
        queue_add(write)
        return Ok("")
    }
    sent: remote_send(write.address, write.local, write.method, write.body, write.key) ?? {
        if !call_unanswered(err) -> return Err(err)
        queue_add(write)
        return Ok("")
    }
    Ok(sent)
}

// Whether `failure` is no answer at all, so a write may wait in the queue.
priv call_unanswered: fn(failure: CallError) -> Bool Never! {
    if failure == {
        .Unreachable(_) -> true
        .Invalid(_) | .SignedOut | .UpdateRequired -> false
    }
}

#Test("a queued write keeps its key and order, and leaves the queue by its key") {
    before: pending()
    queue_add(QueuedWrite{client: "queue-test", address: "http://127.0.0.1:9/api", local: false, method: "save", body: "[1]", key: "k1"})
    queue_add(QueuedWrite{client: "queue-test", address: "http://127.0.0.1:9/api", local: false, method: "save", body: "[2]", key: "k2"})
    assert_eq(pending(), before + 2)
    first: queue_first("queue-test") ?? panic("a write is queued")
    assert_eq(first.key, "k1")
    assert_eq(first.body, "[1]")
    assert(!first.local)
    assert_eq(queue_first("queue-other"), None)
    queue_remove("k1")
    assert_eq((queue_first("queue-test") ?? panic("one write is left")).key, "k2")
    queue_remove("k2")
    assert_eq(pending(), before)
}

#Test("a refusal is the error JSON of an err reply, and an ok reply is none") {
    assert_eq(queue_refusal("{{\"err\":\"Conflict\"}}"), Val("\"Conflict\""))
    assert_eq(queue_refusal("{{\"ok\":null}}"), None)
    assert_eq(queue_invalid([FieldError]{FieldError{path: "title", reason: "is empty"}, FieldError{path: "", reason: "no JSON"}}), "title: is empty; no JSON")
    assert(call_unanswered(.Unreachable("down")))
    assert(!call_unanswered(.SignedOut))
}

#Test("one task sends a client's queue at a time") {
    assert(queue_claim("queue-claim"))
    assert(!queue_claim("queue-claim"))
    assert(queue_claim("queue-claim-other"))
    queue_release("queue-claim")
    queue_release("queue-claim-other")
    assert(queue_claim("queue-claim"))
    queue_release("queue-claim")
}

// The times a remote call is sent, in all, while its reply is lost: each
// send carries the call's one request key, so a server that ran the call
// answers a repeat with the reply it kept, and the call runs once.
priv REMOTE_SENDS: 3

// The wait before a remote call is sent again, in milliseconds, times the
// sends so far.
priv REMOTE_RESEND_MS: 200

// One remote call: POST the JSON array of `args` to `{address}/{method}`
// under a fresh request key (`remote_send`).
priv remote_post: fn(address: String, local: Bool, method: String, args: [String]) -[Net, Time]> String CallError! {
    remote_send(address, local, method, "[{args.join(",")}]", remote_key(address, method))
}

// A fresh request key for a call of `{address}/{method}`.
priv remote_key: fn(address: String, method: String) -> String Never! {
    make_trace_id("key:{rt.clock_mono_ns()}:{trace_next()}:{address}/{method}", 16)
}

// One send of a remote call: POST `body`, the JSON array of its arguments,
// to `{address}/{method}`; the reply's body on 200, else the failure its
// status names. The call carries a W3C `traceparent` that starts its trace,
// and that trace's id as its `x-request-id`, so the server's span of the
// call has both. It also carries its request key `key`, its
// `idempotency-key`, and is sent again under that key when no reply comes,
// up to `REMOTE_SENDS` times. A `local` call is the app graph's, answered in
// this process under the same key (`graph_post`). A call to a server the
// app signed in to (`sign_in`) carries the session's access token, renewed
// first when it has ended, and once more when the server refuses it.
priv remote_send: fn(address: String, local: Bool, method: String, body: String, key: String) -[Net, Time]> String CallError! {
    if local -> return graph_post("{address}/{method}", key, body)
    origin: session_origin(address)
    bearer: session_access(origin) ?? return Err(err)
    if bearer == "" -> return remote_send_as(address, method, body, key, "")
    if remote_send_as(address, method, body, key, bearer) == {
        .Ok(text) -> return Ok(text)
        .Err(.SignedOut) -> {}
        .Err(failure) -> return Err(failure)
    }
    renewed: session_renew(origin) ?? return Err(err)
    remote_send_as(address, method, body, key, renewed)
}

// `remote_send`'s sends of one call, carrying `bearer` as its
// `Authorization` unless it is "".
priv remote_send_as: fn(address: String, method: String, body: String, key: String, bearer: String) -[Net, Time]> String CallError! {
    seed: "{rt.clock_mono_ns()}:{trace_next()}:{key}"
    trace: make_trace_id("trace:{seed}", 16)
    headers := [http.Header]{
        http.Header{name: "traceparent", value: "00-{trace}-{make_trace_id("span:{seed}", 8)}-01"},
        http.Header{name: "x-request-id", value: trace},
        http.Header{name: "idempotency-key", value: key},
    }
    if bearer != "" -> headers.push(http.Header{name: "authorization", value: "Bearer {bearer}"})
    lost := ""
    loop sends in 0..<REMOTE_SENDS {
        if sends > 0 -> time.sleep(time.duration_ms(REMOTE_RESEND_MS * sends))
        reply: remote_send_once("{address}/{method}", headers, body)
        if reply.status == 0 {
            lost = reply.text
            next
        }
        return if {
            reply.status == 200 -> Ok(reply.text)
            reply.status == 401 -> Err(.SignedOut)
            reply.status == 422 -> Err(.Invalid(remote_invalid(reply.text)))
            reply.status == 426 -> Err(.UpdateRequired)
            reply.status == 429 -> Err(.Unreachable("{address}/{method} is limited: retry after {reply.retry_after ?? "?"} s"))
            else -> Err(.Unreachable("{address}/{method} answered {reply.status}"))
        }
    }
    Err(.Unreachable("{address}/{method}: {lost}"))
}

// One reply to a send of a remote call: its status, its `retry-after`, and
// its body's text; status 0 when no reply came, and then `text` says why.
priv RemoteReply: struct {
    status: Int,
    retry_after: String?,
    text: String,
}

// One send of a remote call: POST `body` to `url` with `headers`. A page
// sends it through the browser's fetch (`remote_send_page`), every other
// target through core.http (`remote_send_http`).
priv remote_send_once: fn(url: String, headers: [http.Header], body: String) -[Net, Time]> RemoteReply Never! {
    #if #build.target.os == {
        .Linux -> { return remote_send_http(url, headers, body) }
        .MacOS -> { return remote_send_http(url, headers, body) }
        .Windows -> { return remote_send_http(url, headers, body) }
        .Web -> { return remote_send_page(url, headers, body) }
        .Wasm -> { return remote_send_http(url, headers, body) }
        .Freestanding -> { return remote_send_http(url, headers, body) }
    }
}

priv remote_send_http: fn(url: String, headers: [http.Header], body: String) -[Net, Time]> RemoteReply Never! {
    sent := http.__request("POST", url).__with_body(body)
    loop header in headers -> sent = sent.__with_header(header.name, header.value)
    response: sent.send() ?? return RemoteReply{status: 0, retry_after: None, text: "{err}"}
    text: response.body.text(REMOTE_MAX_REPLY) ?? return RemoteReply{status: 0, retry_after: None, text: "{err}"}
    RemoteReply{status: response.status, retry_after: response.header("retry-after"), text: text}
}

// `remote_send_once` in a page: the browser's fetch posts `body` to `url`
// with `headers` (device request 18), and the page answers the reply's
// status, its `retry-after` ("" for none) and its body's text, or why no
// reply came. A reply over `REMOTE_MAX_REPLY` bytes is lost, as core.http
// loses it.
priv remote_send_page: fn(url: String, headers: [http.Header], body: String) -> RemoteReply Never! {
    lines := [String]{url}
    loop header in headers -> lines.push("{header.name}: {header.value}")
    fields: app_page_answer(WEB_DEVICE_POST, "{lines.join("\n")}\n\n{body}")
    if fields.len() < 3 {
        why: if fields.len() == 1 -> fields[0] else -> "There is no page to send it from"
        return RemoteReply{status: 0, retry_after: None, text: why}
    }
    status: Int.parse(fields[0]) ?? return RemoteReply{status: 0, retry_after: None, text: "The page answered no status"}
    if fields[2].len() > REMOTE_MAX_REPLY {
        return RemoteReply{status: 0, retry_after: None, text: "The reply is over {REMOTE_MAX_REPLY} bytes"}
    }
    RemoteReply{status: status, retry_after: if fields[1] == "" -> None else -> Val(fields[1]), text: fields[2]}
}

// ---- native sessions
//
// A native app signs its person in to a server (`sign_in`) for a pair of
// tokens. The access token is short-lived and kept in memory: each call
// through a Remote of that server carries it as `Authorization: Bearer`.
// The refresh token is kept in the desktop's Secret Service, where
// libsecret keeps secrets, and buys the next pair when the access token
// ends or the server refuses it; each refresh token works once. A server
// that revokes the device (`auth.revoke_device`) drops its refresh token,
// so the device's next refresh is refused, at the latest when its access
// token ends: the kept token is deleted and the call fails `.SignedOut`.

// Where a server of an app graph that gives `.sessions` answers a native
// app: POST `{SESSION_PATH}/sign-in` with `{"account", "password",
// "device"}` and POST `{SESSION_PATH}/refresh` with `{"refresh"}`, each
// with the device's next tokens, `{"access", "refresh", "expires_in_ms"}`,
// or 401 when it refuses them.
priv SESSION_PATH: "/__jet/session"

// The Secret Service schema of a kept refresh token, as libsecret names
// schemas; its other attribute is the server's origin.
priv SESSION_SCHEMA: "dev.jet.Session"

// The longest wait for the Secret Service, in nanoseconds.
priv SESSION_WAIT_NS: 10000000000

// The session this app holds with the server at `origin`: its access
// token and when that ends, on the monotonic clock ("" before the first),
// and the session bus socket and user the kept refresh token is reached
// through.
priv AppSession: struct {
    origin: String,
    access: String,
    access_until_ns: Int,
    bus: String,
    uid: Int,
}

priv APP_SESSIONS: Shared{[AppSession]{}}

// A sign-in or refresh as a server answers it.
#Codable
priv AppSessionTokens: struct {
    access: String,
    refresh: String,
    expires_in_ms: Int,
}

#Codable
priv AppSessionSignIn: struct {
    account: String,
    password: String,
    device: String,
}

#Codable
priv AppSessionRefresh: struct {
    refresh: String,
}

// Signs `account` in to the server at `server` (its origin,
// `https://crew.example`) as the device `device`, with `password` as the
// server's `auth` store holds the account's credential. The access token
// is kept in memory and the refresh token in the Secret Service, in place
// of one kept for that server before; from then on each call through a
// Remote of that server carries the session. Fails `.SignedOut` when the
// server refuses the credentials, and `.Unreachable` when the server or
// the Secret Service doesn't answer.
sign_in: fn(server: String, account: String, password: String, device: String) -[Env, Net, Time]> CallError! {
    held: session_start(session_origin(server)) ?? return Err(err)
    body: live_json.to_string(AppSessionSignIn{account: account, password: password, device: device}) ?? return Err(.Unreachable("the sign-in can't be encoded: {err}"))
    tokens: session_post(held.origin, "sign-in", body) ?? return Err(err)
    session_keep(held, tokens) ?? return Err(err)
    Ok()
}

// Whether this app holds a session with the server at `server`: one it
// signed in to (`sign_in`), or one whose refresh token the Secret Service
// keeps from an earlier run, which the next call through a Remote of that
// server spends for its first access token.
signed_in: fn(server: String) -[Env, Net, Time]> Bool Never! {
    origin: session_origin(server)
    if session_held(origin) != None -> return true
    held: session_start(origin) ?? return false
    kept: session_secret(held, .Lookup) ?? return false
    if kept == "" -> return false
    session_put(held)
    true
}

// A session with `origin` that holds no access token yet, reaching the
// Secret Service on this user's session bus.
priv session_start: fn(origin: String) -[Env]> AppSession CallError! {
    #if #build.target.os == {
        .Linux -> {
            bus: dbus.session_path(sys.get("DBUS_SESSION_BUS_ADDRESS") ?? "", sys.get("XDG_RUNTIME_DIR") ?? "") ?? return Err(.Unreachable("the Secret Service: {err}"))
            return Ok(AppSession{origin: origin, access: "", access_until_ns: 0, bus: bus, uid: sys.getuid()})
        }
        .MacOS -> { return Err(.Unreachable(SESSION_UNBUILT)) }
        .Windows -> { return Err(.Unreachable(SESSION_UNBUILT)) }
        .Web -> { return Err(.Unreachable("a page signs in with its server's cookie")) }
        .Wasm -> { return Err(.Unreachable("a page signs in with its server's cookie")) }
        .Freestanding -> { return Err(.Unreachable(SESSION_UNBUILT)) }
    }
}

priv SESSION_UNBUILT: "this system's keychain for native sessions is not built yet"

// The origin of `address`: its scheme, host and port, with no path.
priv session_origin: fn(address: String) -> String Never! {
    parts: address.split("://").to_list()
    if parts.len() < 2 -> return address.copy()
    host: parts[1].split("/").to_list()
    "{parts[0]}://{host[0]}"
}

// The session held with `origin`, if any.
priv session_held: fn(origin: String) -> AppSession? Never! {
    held: APP_SESSIONS.guard_read()
    loop session in held.value {
        if session.origin == origin -> return Val(session.copy())
    }
    None
}

// Holds `session` in place of the one held with its origin.
priv session_put: fn(session: AppSession) Never! {
    held := APP_SESSIONS.guard_edit()
    kept := [AppSession]{}
    loop i in 0..<held.value.len() {
        if held.value[i].origin != session.origin -> kept.push(held.value[i])
    }
    kept.push(session.copy())
    held.value = kept
}

// Drops the session held with `origin`.
priv session_drop: fn(origin: String) Never! {
    held := APP_SESSIONS.guard_edit()
    kept := [AppSession]{}
    loop i in 0..<held.value.len() {
        if held.value[i].origin != origin -> kept.push(held.value[i])
    }
    held.value = kept
}

// The access token a call to `origin` carries: "" with no session, the
// held one while it lasts, else the one a refresh buys (`session_renew`).
priv session_access: fn(origin: String) -[Net, Time]> String CallError! {
    held: session_held(origin) ?? return Ok("")
    if held.access != "" && rt.clock_mono_ns() < held.access_until_ns -> return Ok(held.access)
    session_renew(origin)
}

// Spends the kept refresh token of the session with `origin` for the
// next pair of tokens, keeps them, and gives the access token. A refresh
// the server refuses deletes the kept token and drops the session:
// `.SignedOut`.
priv session_renew: fn(origin: String) -[Net, Time]> String CallError! {
    held: session_held(origin) ?? return Err(.SignedOut)
    refresh: session_secret(held, .Lookup) ?? return Err(err)
    if refresh == "" {
        session_drop(origin)
        return Err(.SignedOut)
    }
    body: live_json.to_string(AppSessionRefresh{refresh: refresh}) ?? return Err(.Unreachable("the refresh can't be encoded: {err}"))
    tokens: if session_post(origin, "refresh", body) == {
        .Ok(tokens) -> tokens
        .Err(failure) -> {
            if failure == .SignedOut {
                session_drop(origin)
                _: session_secret(held, .Clear) ?? return Err(err)
            }
            return Err(failure)
        }
    }
    session_keep(held, tokens) ?? return Err(err)
    Ok(tokens.access)
}

// Keeps `tokens` for the session `held`: the refresh token in the Secret
// Service, then the access token in memory.
priv session_keep: fn(held: AppSession, tokens: AppSessionTokens) -[Net, Time]> CallError! {
    _: session_secret(held, .Store(tokens.refresh)) ?? return Err(err)
    next := held.copy()
    next.access = tokens.access.copy()
    next.access_until_ns = rt.clock_mono_ns() + tokens.expires_in_ms * 1000000
    session_put(next)
    Ok()
}

// What `session_secret` does with a server's refresh token.
priv AppSessionSecret: enum {
    Store(String),
    Lookup,
    Clear,
}

// Keeps, reads or deletes the refresh token the Secret Service keeps for
// `held`'s server; the token read, or "" (a refresh token is never empty).
priv session_secret: fn(held: AppSession, change: AppSessionSecret) -[Net, Time]> String CallError! {
    #if #build.target.os == {
        .Linux -> { return session_secret_linux(held, change) }
        .MacOS -> { return Err(.Unreachable(SESSION_UNBUILT)) }
        .Windows -> { return Err(.Unreachable(SESSION_UNBUILT)) }
        .Web -> { return Err(.Unreachable(SESSION_UNBUILT)) }
        .Wasm -> { return Err(.Unreachable(SESSION_UNBUILT)) }
        .Freestanding -> { return Err(.Unreachable(SESSION_UNBUILT)) }
    }
}

// `session_secret` on Linux, over the session bus `held` names.
priv session_secret_linux: fn(held: AppSession, change: AppSessionSecret) -[Net, Time]> String CallError! {
    stream := net.unix_connect(held.bus) ?? return Err(.Unreachable("the Secret Service: the session bus at {held.bus}: {err}"))
    c := dbus.start(stream.move(), held.uid, SESSION_WAIT_NS) ?? return Err(.Unreachable("the Secret Service: {err}"))
    attributes: [String:String]{"xdg:schema": SESSION_SCHEMA, "server": held.origin}
    if change == {
        .Store(refresh) -> {
            dbus.secret_store(c, "Session with {held.origin}", attributes, refresh, SESSION_WAIT_NS) ?? return Err(.Unreachable("the Secret Service: {err}"))
        }
        .Lookup -> {
            if dbus.secret_lookup(c, attributes, SESSION_WAIT_NS) == {
                .Ok(kept) -> return Ok(kept ?? "")
                .Err(problem) -> return Err(.Unreachable("the Secret Service: {problem}"))
            }
        }
        .Clear -> {
            dbus.secret_clear(c, attributes, SESSION_WAIT_NS) ?? return Err(.Unreachable("the Secret Service: {err}"))
        }
    }
    Ok("")
}

// POSTs `body` to `{origin}{SESSION_PATH}/{step}` and gives the tokens
// the server answers; 401 is `.SignedOut`.
priv session_post: fn(origin: String, step: String, body: String) -[Net, Time]> AppSessionTokens CallError! {
    address: "{origin}{SESSION_PATH}/{step}"
    response: http.__request("POST", address).__with_header("content-type", "application/json").__with_body(body).send() ?? return Err(.Unreachable("{address}: {err}"))
    text: response.body.text(REMOTE_MAX_REPLY) ?? return Err(.Unreachable("{address}: {err}"))
    if response.status == 401 -> return Err(.SignedOut)
    if response.status != 200 -> return Err(.Unreachable("{address} answered {response.status}"))
    live_json.decode<AppSessionTokens>(text) ?? return Err(.Unreachable("{address} answered no tokens"))
}

#Test("a native session is held per server origin, and a server the app can't reach signs no app in") {
    assert_eq(session_origin("http://127.0.0.1:8080/api/"), "http://127.0.0.1:8080")
    assert_eq(session_origin("https://example.net"), "https://example.net")
    session_put(AppSession{origin: "http://held.test", access: "a", access_until_ns: 0, bus: "", uid: 0})
    assert(signed_in("http://held.test/api"))
    session_drop("http://held.test")
    assert(session_held("http://held.test") == None)
    // No session: a call carries no token and fails as any unanswered call.
    unanswered: if remote_send("http://127.0.0.1:9/api", false, "ping", "[]", "k") == {
        .Ok(_) -> "answered"
        .Err(.Unreachable(_)) -> "unreachable"
        .Err(failure) -> "{failure}"
    }
    assert_eq(unanswered, "unreachable")
    refused: if sign_in("http://127.0.0.1:9", "acct", "hash", "laptop") == {
        .Ok(_) -> "signed in"
        .Err(.Unreachable(_)) -> "unreachable"
        .Err(failure) -> "{failure}"
    }
    assert_eq(refused, "unreachable")
    assert(session_held("http://127.0.0.1:9") == None)
}

// A W3C trace-context id of `n` bytes (16 for a trace, 8 for a span) as
// lowercase hex: the leading bytes of `seed`'s SHA-256. Each caller's seed
// holds a clock reading and a count, so no two ids it makes repeat; ids
// need no random source, which a handler's effects do not allow.
priv make_trace_id: fn(seed: String, n: Int) -> String Never! {
    digest: crypto.sha256(seed)
    crypto.hex_encode(digest.bytes.slice(0, n))
}

// The process's count of the trace seeds a Remote makes.
TRACE_SEEDS: Shared{0}

priv trace_next: fn() -> Int Never! {
    guard := TRACE_SEEDS.guard_edit()
    guard.value += 1
    guard.value
}

// The field errors of a 422 reply, `{"invalid": [{"path": …, "reason":
// …}, …]}`; a reply that is not that shape is one error with its text.
priv remote_invalid: fn(text: String) -> [FieldError] Never! {
    tree: live_json.parse(text) ?? return [FieldError]{FieldError{path: "", reason: "{text}"}}
    errors := [FieldError]{}
    index := 0
    loop {
        reason: live_json.at<String>(tree, "/invalid/{index}/reason") ?? break
        path: live_json.at<String>(tree, "/invalid/{index}/path") ?? ""
        errors.push(FieldError{path: path, reason: reason})
        index += 1
    }
    if errors.len() == 0 -> return [FieldError]{FieldError{path: "", reason: "{text}"}}
    errors
}

// A live binding: one source function applied to one argument list, run as
// the caller that made it. The compiler builds it from
// `live(source, args...)` or `subscribe(source, args...)`; `state` reads it.
// A source may read the database, fetch over the network and wait, nothing
// more, so `state` runs on every target that has those, the web included.
Live: struct<T, E> {
    id: Int,
    run: fn() -[DB.Read, Net, Time]> T E!,
    priv acting: Acting?,
}

// One registry binding, named by its source's wire name, its encoded
// argument list and `caller`, the caller it runs as (`acting_tag`), so two
// callers never share a result. `value` is the last result, `ok:` or `err:`
// then its JSON, and empty before the first run; `generation` counts the
// invalidations that reached the binding; `overtaken` counts its runs in a
// row that an invalidation overtook, and `held_ns` is the monotonic time
// until which a stale binding serves its stored result (0: none); `every_ns`
// is the poll interval (0: none) and `ran_ns` the monotonic time of the last
// run. `reads` is its read set: the other sources (a table's
// `core.db.live:<table>`) its runs read (`live_reads`), so a write to any of
// them re-runs it too.
LiveRecord: struct {
    id: Int,
    source: String,
    key: String,
    value: String,
    dirty: Bool,
    generation: Int,
    overtaken: Int,
    held_ns: Int,
    every_ns: Int,
    ran_ns: Int,
    reads: [String],
    caller: String,
}

// What `state` reads before it runs a binding: the stored result when it is
// current, held, or capped (live_current), and the binding's generation then.
LiveCurrent: struct {
    value: String?,
    generation: Int,
}

// `capped` counts the re-runs the per-second cap turned into holds;
// `window_ns` starts the current second of re-runs and `window_runs` counts
// the re-runs in it.
LiveRegistry: struct {
    next_id: Int,
    invalidations: Int,
    changes: Int,
    evictions: Int,
    ws_pushes: Int,
    capped: Int,
    window_ns: Int,
    window_runs: Int,
    records: [LiveRecord],
}

// The live registry lives in a process-wide runtime byte cell; every update
// reads the cell, edits the decoded registry and installs it only if the cell
// is unchanged, retrying otherwise, so concurrent callers never lose an update.
//
// The compiler checks `live`, `subscribe`, `push` and `invalidate` against
// their source function and lowers them to the `__live_*` helpers below.

// The binding's current state. The source re-runs when the binding has no
// result yet, was invalidated, or its poll interval has passed; the stored
// result changes only when the re-run's encoding differs. A re-run that an
// invalidation overtook stores its result but leaves the binding stale, since
// what it read may predate that write. Under writes that keep overtaking it, a
// binding settles: from its second overtaken run in a row, its stale result
// is served for a hold (live_store) instead of running the source on every
// read, and its watchers (`watch`) are told when to read it again. A server
// re-runs at most LIVE_MAX_RERUNS_PER_SECOND bindings a second; past that, a
// binding's stored result is held until the next second (live_current). Writes
// between two reads cost one re-run, however many there were. While the
// source runs, the tables it reads join the binding's read set (`live_reads`).
// While a server renders a page, the view's reads are noted for the page's
// resume state (`resume`).
state: fn<T: [Encode, Decode], E: [Encode, Decode]>(binding: Live<T, E>) -> Loadable<T, E> Never! {
    resume_note(binding.id)
    now: rt.clock_mono_ns()
    seen: live_current(binding.id, now)
    if seen.value == .Val(text) {
        if live_value_state<T, E>(text) == .Val(current) -> return current
    }
    value: live_run(binding) ?? {
        if live_json.to_string<E>(err) == .Ok(encoded) {
            live_store(binding.id, "err:{encoded}", now, Val(seen.generation))
        }
        return Loadable.Failed(err)
    }
    if live_json.to_string<T>(value) == .Ok(encoded) {
        live_store(binding.id, "ok:{encoded}", now, Val(seen.generation))
    }
    Loadable.Loaded(value)
}

// Runs `binding`'s source as this task's running binding, so the reads it
// makes join the binding's read set, and as the caller that made the
// binding, whoever reads it now. The screen addresses the run asked
// `presence` of become the ones its caller is present at (live_presence_settle).
priv live_run: fn<T: [Encode, Decode], E: [Encode, Decode]>(binding: Live<T, E>) -> T E! {
    me: tasks.current_task()
    live_run_begin(me, binding.id)
    acting_begin(me, binding.acting.copy())
    value: binding.run() ?? {
        acting_end(me)
        live_presence_settle(binding.id, binding.acting, live_run_end(me))
        return Err(err)
    }
    acting_end(me)
    live_presence_settle(binding.id, binding.acting, live_run_end(me))
    Ok(value)
}

// `socket`, a server-side WebSocket connection, receives
// `{"live":"invalidate","binding":<id>}` each time `binding` is invalidated,
// starting with the latest such event when there was one. While the binding
// is held (live_store), the event carries `"after_ms":<n>`: a read in the
// next n milliseconds gets the held stale result, so the client reads again
// after them, and the binding's first current result after the hold sends the
// event again. A connection receives only the bindings its handler watches;
// the handler holds `binding` because it read it for its own caller under
// that caller's policy. Once the last connection watching `binding` closes,
// its caller is present nowhere through it (__live_left_settle).
watch: fn<T: [Encode, Decode], E: [Encode, Decode]>(socket: WsConn, binding: Live<T, E>) -[Net]> Never! {
    ws.__live_watch(socket, "live:{binding.id}")
}

// `changes` counts stored results that differed from the one before;
// `ws_pushes` counts the publishes to the WebSocket live hub: one per
// `invalidate` that marked a binding, and one per hold's start and end;
// `capped` counts the re-runs the per-second cap held over.
live_stats: fn() -> String Never! {
    registry: live_decode(live_cell_load()) ?? return "LiveStats(error=live registry unavailable)"
    "LiveStats(queries={live_query_count(registry)}, limit={LIVE_MAX_QUERIES}, evictions={registry.evictions}, invalidations={registry.invalidations}, changes={registry.changes}, ws_pushes={registry.ws_pushes}, reruns_per_second={LIVE_MAX_RERUNS_PER_SECOND}, capped={registry.capped})"
}

// The live bindings of `registry`; sync's session records are not queries.
live_query_count: fn(registry: LiveRegistry) -> Int {
    count := 0
    loop record in registry.records {
        if record.source != LIVE_SYNC_SOURCE -> count += 1
    }
    count
}

// `live(source, args...)`: `args` are the encoded arguments. The binding
// runs as this task's caller.
priv __live_bind: fn<T: [Encode, Decode], E: [Encode, Decode]>(source: String, args: [String], run: ^^fn() -[DB.Read, Net, Time]> T E!) -> Live<T, E> Never! {
    acting: acting_now(tasks.current_task())
    Live<T, E>{id: live_register(source, live_key(args), acting_tag(acting), 0), run: run, acting: acting}
}

// `subscribe(source, args..., every:)`: a binding polled every `every`.
priv __live_poll: fn<T: [Encode, Decode], E: [Encode, Decode]>(source: String, args: [String], every: Duration?, run: ^^fn() -[DB.Read, Net, Time]> T E!) -> Live<T, E> Never! {
    every_ns := 0
    if every == .Val(interval) && interval.ns > 0 -> every_ns = interval.ns
    acting: acting_now(tasks.current_task())
    Live<T, E>{id: live_register(source, live_key(args), acting_tag(acting), every_ns), run: run, acting: acting}
}

// `push(source, args..., value:)` stores `value` as that binding's result,
// registering the binding when nothing has read it yet. Only the binding of
// this task's caller gets it: a value one caller computed never reaches
// another's binding.
priv __live_push: fn<T: Encode>(source: String, args: [String], value: T) Never! {
    encoded: live_json.to_string<T>(value) ?? return
    key: live_key(args)
    id: live_register(source, key, acting_tag(acting_now(tasks.current_task())), 0)
    live_store(id, "ok:{encoded}", -1, None)
}

// `invalidate(source, args...)`: exactly that argument list re-runs.
priv __live_invalidate: fn(source: String, args: [String]) Never! {
    live_invalidate(Val(source), Val(live_key(args)), None, 0)
}

// `invalidate(source)`: every binding of `source` re-runs.
priv __live_invalidate_all: fn(source: String) Never! { live_invalidate(Val(source), None, None, 0) }

// One argument's part of a binding's identity, and one argument of a queued
// job's call: the argument encoded, or `_`, which no JSON reads, when it
// doesn't encode, so a job given it fails each run.
priv __live_arg: fn<A: Encode>(value: A) -> String Never! { live_json.to_string<A>(value) ?? "_" }

// A binding's read set, for core.db: while a task runs a binding's source,
// each table it reads joins that binding's read set, so a write to the table
// re-runs the binding as it re-runs the table's own bindings. A read the
// compiler narrowed to the rows a SQL condition holds for joins it as the
// table narrowed so, `<source>?<condition and values as a JSON list>`, and a
// write re-runs it only when the condition holds for a row the write changed.
priv(package) live_reads: module {
    // Whether this task is running a binding's source, so a database read
    // it makes belongs to that binding's read set.
    running: fn() -> Bool Never! { live_running(tasks.current_task()) != None }

    // Adds `source` (a table's `core.db.live:<table>`) to the read set of
    // the binding this task runs. Recorded before the read runs, so a write
    // committed after the read always reaches the binding.
    record: fn(source: String) Never! { live_read_record(source, source) }

    // Adds `source` narrowed by the SQL `condition` over a stored row, with
    // `values` bound to its `?`s in order, to the read set of the binding
    // this task runs, unless it read all of `source` already.
    record_where: fn(source: String, condition: String, values: [String]) Never! {
        fields := [String]{condition.copy()}
        fields.extend(values.copy())
        encoded: live_json.to_string<[String]>(fields) ?? return live_read_record(source, source)
        live_read_record(source, "{source}?{encoded}")
    }

    // The narrowed reads of `source` in the bindings' read sets, each once:
    // its read-set entry, its condition and the values it binds.
    narrowed: fn(source: String) -> [{entry: String, condition: String, values: [String]}] Never! {
        out := [{entry: String, condition: String, values: [String]}]{}
        registry: live_decode(live_cell_load()) ?? return out
        prefix: "{source}?"
        seen := [String]{}
        loop record in registry.records {
            loop read in record.reads {
                if !read.starts_with(prefix) || seen.contains(read) -> next
                seen.push(read.copy())
                tree: live_json.parse(read.slice(prefix.len(), read.len())) ?? next
                fields: tree.decode<[String]>() ?? next
                if fields.len() == 0 -> next
                values := [String]{}
                loop at in 1..<fields.len() -> values.push(fields[at].copy())
                out.push({entry: read.copy(), condition: fields[0].copy(), values: values})
            }
        }
        out
    }

    // Marks for a re-run every binding of `source`, every binding that read
    // all of it, and every one whose read set holds one of the narrowed reads
    // `held` (`narrowed`): those whose condition holds for a changed row.
    invalidate: fn(source: String, held: [String]) Never! {
        live_invalidate(Val(source), None, Val(held), 0)
    }
}

// Adds `entry`, a read of `source`, to the read set of the binding this task
// runs (`live_reads`), unless that binding is `source`'s own or read all of
// `source` already.
priv live_read_record: fn(source: String, entry: String) {
    id: live_running(tasks.current_task()) ?? return
    loop {
        seen: live_cell_load()
        registry := live_decode(seen) ?? return
        index: live_index(registry, id) ?? return
        reads: registry.records[index].reads
        if registry.records[index].source == source || reads.contains(source) || reads.contains(entry) {
            return
        }
        registry.records[index].reads.push(entry.copy())  // copy: a lost race retries with the same entry
        if live_cell_replace(seen, live_encode(registry)) {
            return
        }
    }
}

// The bindings whose sources are running now, each with its task and the
// screen addresses its run asked `presence` of so far; a source that reads
// another binding stacks that binding on its own.
LiveRun: struct {
    task: TaskID,
    id: Int,
    asked: [String],
}

LiveRunning: struct {
    runs: [LiveRun],
}

LIVE_RUNNING: Shared{LiveRunning{runs: [LiveRun]{}}}

priv live_run_begin: fn(task: TaskID, id: Int) {
    running := LIVE_RUNNING.guard_edit()
    running.value.runs.push(LiveRun{task: task, id: id, asked: [String]{}})
}

// Ends `task`'s innermost run and gives the addresses it asked `presence` of.
priv live_run_end: fn(task: TaskID) -> [String] {
    running := LIVE_RUNNING.guard_edit()
    at := running.value.runs.len()
    loop at > 0 {
        at -= 1
        if task == running.value.runs[at].task {
            asked: running.value.runs[at].asked.copy()
            _: running.value.runs.remove(at, .Slot)
            return asked
        }
    }
    [String]{}
}

// Adds `address` to what the run of `task`'s innermost binding asked
// `presence` of; false when `task` runs no binding.
priv live_presence_ask: fn(task: TaskID, address: String) -> Bool {
    running := LIVE_RUNNING.guard_edit()
    at := running.value.runs.len()
    loop at > 0 {
        at -= 1
        if task == running.value.runs[at].task {
            if !running.value.runs[at].asked.contains(address) {
                running.value.runs[at].asked.push(address.copy())
            }
            return true
        }
    }
    false
}

// One account present at a screen address: the latest run of the live
// binding `binding`, acting for `account`, asked `presence` of `address`.
AppPresent: struct {
    binding: Int,
    account: String,
    address: String,
}

APP_PRESENT: Shared{[AppPresent]{}}

// The read-set source of who is present at a screen address: a binding
// that asked `presence` of the address reads it, so a change of who is
// present there re-runs the binding.
LIVE_PRESENCE_SOURCE: "app.presence:"

// Makes `asked`, the addresses the run of binding `id` that just ended asked
// `presence` of, the ones its account (`acting`) is present at, and re-runs
// every other binding that reads one whose accounts changed. A run that
// asked none, such as one a row policy refused before it asked, leaves its
// account present nowhere through this binding.
priv live_presence_settle: fn(id: Int, acting: Acting?, asked: [String]) {
    account: if acting == .Val(.Account(who)) -> who.raw() else -> ""
    changed: live_presence_keep(id, account, asked)
    loop address in changed {
        live_invalidate(Val("{LIVE_PRESENCE_SOURCE}{address}"), None, None, id)
    }
}

// Makes `asked` the addresses `account` is present at through binding `id`
// (none when `account` is ""), and gives each address whose accounts that
// changes.
priv live_presence_keep: fn(id: Int, account: String, asked: [String]) -> [String] {
    changed := [String]{}
    had := [String]{}
    held := APP_PRESENT.guard_edit()
    kept := [AppPresent]{}
    loop entry in held.value {
        mine: entry.binding == id
        if mine && (account == "" || entry.account != account || !asked.contains(entry.address)) {
            changed.push(entry.address.copy())
            next
        }
        if mine -> had.push(entry.address.copy())
        kept.push(entry.copy())
    }
    loop address in asked {
        if account == "" || had.contains(address) -> next
        kept.push(AppPresent{binding: id, account: account.copy(), address: address.copy()})
        changed.push(address.copy())
    }
    held.value = kept
    changed
}

// The accounts present at `address`, sorted, each once: those of the
// registered bindings whose latest run asked `presence` of it, and
// `asking`, the account of the run asking now (none when ""). A binding
// whose last watching connection closed is not among them (__live_left_settle).
priv live_present: fn(address: String, asking: String) -> [auth.AccountID] {
    __live_left_settle()
    names := [String]{}
    if asking != "" -> names.push(asking.copy())
    registry: live_decode(live_cell_load())
    held: APP_PRESENT.guard_read()
    loop entry in held.value {
        if entry.address != address || names.contains(entry.account) -> next
        if registry == .Val(bindings) && live_index(bindings, entry.binding) == None -> next
        names.push(entry.account.copy())
    }
    names.sort()
    out := [auth.AccountID]{}
    loop name in names -> out.push(auth.AccountID.from_string(name))
    out
}

// The leave signal of the WebSocket live hub: each binding whose last
// watching connection (`watch`) closed since the last call is present
// nowhere (live_left). A server runs this once each upgraded connection's
// handler returns, and every presence read runs it first, so a closed
// session is never counted.
priv __live_left_settle: fn() Never! { live_left(rt_web.live_left()) }

// Ends the presence of each binding `topics` names, one hub topic
// (`live:<id>`, `watch`'s) per line, and re-runs every binding that reads an
// address it was present at. That binding re-runs too: a connection that
// watches it again first receives its event, so the client reads it, and
// the run asks again, counting its account.
priv live_left: fn(topics: String) Never! {
    loop topic in topics.split("\n") {
        if !topic.starts_with("live:") -> next
        id: Int.parse(topic.slice(5, topic.len())) ?? next
        changed: live_presence_keep(id, "", [String]{})
        loop address in changed {
            live_invalidate(Val("{LIVE_PRESENCE_SOURCE}{address}"), None, None, 0)
        }
    }
}

// The binding `task` is running now, the innermost when it runs several.
priv live_running: fn(task: TaskID) -> Int? {
    running := LIVE_RUNNING.guard_edit()
    at := running.value.runs.len()
    loop at > 0 {
        at -= 1
        if running.value.runs[at].task == task -> return Val(running.value.runs[at].id)
    }
    None
}

// A page's resume state. While a task renders a page (`resume.render`),
// each binding its view reads (`state`) is noted, but not one a source
// reads while it runs. The page then carries each noted binding's source
// wire name, encoded arguments and stored result. A client that resumes the
// page (`resume.seed`) stores those results as its own bindings' results,
// so its first `state` of each gives the server's result and runs no source:
// the client does not run the view's reads again to rebuild the page.
priv(package) resume: module {
    // The HTML `view` gives, rendered as this task's page, then the resume
    // script of the reads it made: `<script type="application/json"
    // id="jet-resume">` holding a JSON list of `{source, key, value}`, each
    // `<` written `\u003c`. A read with no stored result, or one a write made
    // stale since, is left out, so the client runs that one itself.
    render: fn(view: fn() -> String Never!) -> String Never! {
        me: tasks.current_task()
        resume_begin(me)
        body: view()
        "{body}{resume_script(resume_end(me))}"
    }

    // Stores the results the resume script of the served page `page`
    // carries as the bindings of this task's caller, and gives how many it
    // stored.
    seed: fn(page: String) -> Int Never! {
        start: page.find(RESUME_OPEN)
        if start < 0 -> return 0
        rest: page.slice(start + RESUME_OPEN.len(), page.len())
        end: rest.find("</script>")
        if end < 0 -> return 0
        reads: live_json.decode<[AppResumed]>(rest.slice(0, end)) ?? return 0
        caller: acting_tag(acting_now(tasks.current_task()))
        stored := 0
        loop read in reads {
            id: live_register(read.source, read.key, caller, 0)
            if id == 0 -> next
            live_store(id, read.value, -1, None)
            stored += 1
        }
        stored
    }
}

priv RESUME_OPEN: "<script type=\"application/json\" id=\"jet-resume\">"

// One read a page carries: its binding's source wire name, encoded
// argument list and stored result (`ok:` or `err:`, then its JSON).
priv AppResumed: struct {
    source: String,
    key: String,
    value: String,
}

// The bindings a task rendering a page or opening a screen (`App.__go`)
// read, in first-read order.
priv AppResumeReads: struct {
    task: TaskID,
    ids: [Int],
}

priv APP_RESUME_READS: Shared{[AppResumeReads]{}}

priv resume_begin: fn(task: TaskID) Never! {
    held := APP_RESUME_READS.guard_edit()
    held.value.push(AppResumeReads{task: task, ids: [Int]{}})
}

// Ends `task`'s innermost page and gives the bindings its view read.
priv resume_end: fn(task: TaskID) -> [Int] Never! {
    held := APP_RESUME_READS.guard_edit()
    at := held.value.len()
    loop at > 0 {
        at -= 1
        if task == held.value[at].task {
            ids: held.value[at].ids.copy()
            _: held.value.remove(at, .Slot)
            return ids
        }
    }
    [Int]{}
}

// Notes that this task's page or screen read binding `id`, when this task
// renders a page or opens a screen and runs no binding's source.
priv resume_note: fn(id: Int) Never! {
    if !resume_rendering() {
        return
    }
    me: tasks.current_task()
    if live_running(me) != None {
        return
    }
    held := APP_RESUME_READS.guard_edit()
    at := held.value.len()
    loop at > 0 {
        at -= 1
        if held.value[at].task != me -> next
        if !held.value[at].ids.contains(id) -> held.value[at].ids.push(id)
        return
    }
}

// Whether any task renders a page now, so a read outside one costs one
// look at an empty list.
priv resume_rendering: fn() -> Bool Never! {
    held: APP_RESUME_READS.guard_read()
    held.value.len() != 0
}

// The resume script of the bindings `ids`: each one's stored result, when
// it has one and no write made it stale.
priv resume_script: fn(ids: [Int]) -> String Never! {
    reads := [AppResumed]{}
    registry: live_decode(live_cell_load()) ?? return "{RESUME_OPEN}[]</script>"
    loop id in ids {
        index: live_index(registry, id) ?? next
        record: registry.records[index]
        if record.value == "" || record.dirty -> next
        reads.push(AppResumed{source: record.source.copy(), key: record.key.copy(), value: record.value.copy()})
    }
    text: live_json.to_string<[AppResumed]>(reads) ?? "[]"
    "{RESUME_OPEN}{text.replace("<", "\\u003c")}</script>"
}

// Whom a task acts for. `as_caller` runs a function for an account and
// `as_system` for the server itself. A task that runs neither acts for no
// one, and so does a task another one spawns: a caller never passes to
// another task. A guarded core.db table asks its row policy as this caller,
// and as no one, never as the system, when there is none. A live binding
// runs as the caller that made it.
Acting: enum {
    Account(auth.AccountID),
    System,
}

// The runs of `as_caller`, `as_system` and binding sources, each with its
// task and the caller it acts for (None: no one); a task's innermost run
// names its caller.
ActingRun: struct {
    task: TaskID,
    acting: Acting?,
}

ActingRuns: struct {
    runs: [ActingRun],
}

ACTING: Shared{ActingRuns{runs: [ActingRun]{}}}

// Runs `run` acting for the account `account` and gives what it gives; the
// account is `maybe_caller()` within it. A failure of `run` is this call's,
// unchanged.
as_caller: fn<R, E>(account: auth.AccountID, run: fn() -> R E!) -> R E! {
    acting_within(Val(Acting.Account(account.copy())), run)
}

// Runs `run` acting for the server itself, which no row policy limits, and
// gives what it gives. A job or a schedule that reads every row runs so; a
// request never does.
as_system: fn<R, E>(run: fn() -> R E!) -> R E! { acting_within(Val(Acting.System), run) }

// The account this task acts for: None when it acts for the system or for
// no one.
maybe_caller: fn() -> auth.AccountID? Never! {
    if acting_now(tasks.current_task()) == .Val(.Account(account)) -> return Val(account)
    None
}

// The account this task acts for, where a caller is certain: the compiler
// accepts a call only on a path that starts at an `#App.SignedIn` method or
// inside `as_caller`. A path the compiler can't follow (a function value
// another task runs) that reaches it acting for no account stops here.
caller: fn() -> auth.AccountID Never! {
    maybe_caller() ?? panic("app.caller() ran acting for no account")
}

priv acting_within: fn<R, E>(acting: Acting?, run: fn() -> R E!) -> R E! {
    me: tasks.current_task()
    acting_begin(me, acting)
    defer acting_end(me)
    run()
}

priv acting_begin: fn(task: TaskID, acting: Acting?) {
    runs := ACTING.guard_edit()
    runs.value.runs.push(ActingRun{task: task, acting: acting})
}

priv acting_end: fn(task: TaskID) {
    runs := ACTING.guard_edit()
    at := runs.value.runs.len()
    loop at > 0 {
        at -= 1
        if task == runs.value.runs[at].task {
            _: runs.value.runs.remove(at, .Slot)
            return
        }
    }
}

// The caller `task` acts for now: None for no one.
priv acting_now: fn(task: TaskID) -> Acting? {
    runs := ACTING.guard_edit()
    at := runs.value.runs.len()
    loop at > 0 {
        at -= 1
        if runs.value.runs[at].task == task -> return runs.value.runs[at].acting.copy()
    }
    None
}

// A binding's registry name for the caller `acting`: empty for no one.
priv acting_tag: fn(acting: Acting?) -> String {
    if acting == {
        .Val(.Account(account)) -> "account:{account.raw()}"
        .Val(.System) -> "system"
        .None -> ""
    }
}

// The caller this task acts for, for core.db's row policies.
priv(package) callers: module {
    // Whether this task acts for the system.
    system: fn() -> Bool Never! {
        if acting_now(tasks.current_task()) == .Val(.System) -> return true
        false
    }

    // The account this task acts for: None for the system or no one.
    account: fn() -> auth.AccountID? Never! { maybe_caller() }

    // This task acts for the system until `end`, as a row policy's own
    // reads do.
    begin_system: fn() Never! { acting_begin(tasks.current_task(), Val(Acting.System)) }

    // This task acts for `account` until `end`, as a signed-in call does.
    begin_account: fn(account: auth.AccountID) Never! {
        acting_begin(tasks.current_task(), Val(Acting.Account(account)))
    }

    // Ends this task's innermost `begin_system` or `begin_account`.
    end: fn() Never! { acting_end(tasks.current_task()) }
}

#Test("a task acts for its innermost run's caller, and a task it spawns for no one") {
    ann: auth.AccountID.from_string("ann")
    ben: auth.AccountID.from_string("ben")
    assert_eq(maybe_caller(), auth.AccountID?{None})
    seen: as_caller<String, Never>(ann, fn() {
        assert(as_system(fn() { callers.system() }))
        assert_eq(as_system(fn() { maybe_caller() }), auth.AccountID?{None})
        nested: auth.AccountID.from_string("ben")
        assert_eq(as_caller(nested, fn() { maybe_caller() }), Val(nested))
        spawned: task { (maybe_caller() ?? auth.AccountID.from_string("no one")).raw() }
        assert_eq(spawned.join() ?? panic("the spawned task runs"), "no one")
        assert(!callers.system())
        (maybe_caller() ?? auth.AccountID.from_string("no one")).raw()
    })
    assert_eq(seen, "ann")
    assert_eq(maybe_caller(), auth.AccountID?{None})
    as_caller(ben.copy(), fn() {
        assert_eq(maybe_caller(), Val(ben))
        assert_eq(caller(), ben)
        assert(!callers.system())
    })
    assert_eq(maybe_caller(), auth.AccountID?{None})
    assert_eq(acting_tag(Val(Acting.Account(ann))), "account:ann")
    assert_eq(acting_tag(None), "")
}

// A call of a mounted service's method runs as one transaction on each
// store it uses. The framework opens the call on the task that runs it
// (`transactions.begin`); core.db begins an IMMEDIATE transaction on a
// store's connection at the call's first statement there and joins it to the
// call (`join`); `end` commits every joined transaction or rolls each back.
// A method the call reaches, and a row policy it asks, run on the same task
// and so in the same transaction; a task the call spawns is outside it. A
// store that can't begin or commit marks the call refused, and the framework
// then runs it again. A webhook's call carries its delivery (`deliver`),
// whose ID core.db records in each store's transaction as the call joins
// it; a store that has run the delivery already marks the call repeated, and
// the framework rolls it back and drops the delivery. A schedule's call
// carries its due run (`schedule`), which core.db records the same way, so
// a run another server has done is dropped as well. A remote call that
// carries a request key (`ask`) gives its reply (`answer`), which `end`
// keeps under the key in the first store the call joined: in that store's
// transaction when the call commits, and on its own after the call rolls
// back. A store that keeps a reply under the key of a call that joins it
// gives the call that reply and marks it repeated, so the framework rolls
// the call back and answers with the kept reply. A job the call queues
// (`enqueue`) waits for it: `end` keeps the job in the outbox of the first
// store the call joined, in that store's transaction, under a key of its
// own, and once the call commits, runs it on a task of its own (`job_run`);
// a call that rolls back drops its jobs with its writes. Each run of a job
// carries its key as its delivery, so a store that has run the job drops a
// second run of it.
priv CallJoin: struct {
    // Commits (true) or rolls back (false) one store's transaction; false
    // when it couldn't do as asked.
    end: fn(Bool) -[]> Bool Never!,
    outbox: CallOutbox,
}

// One store's outbox: the jobs committed calls queued there that haven't
// run yet, a row each, found by the job's key. Each row is taken until a
// time (Unix milliseconds): the server that runs its job takes it again
// each tick while the job runs (`hold`), and once that time has passed, a
// serving server takes the row (`take`) and runs the job again, as when the
// server that ran it stopped. It also keeps the replies of calls that
// carried a request key (`answered`).
priv CallOutbox: struct {
    // Names the store among the open ones: the database file's path, or
    // one of its own for an in-memory database.
    store: String,
    // The time it is by the store's clock, the one its engine reads for
    // SQL's `'now'`, in Unix milliseconds.
    now: fn() -[]> Int Never!,
    // Keeps job `name` with its encoded arguments, in the transaction of
    // the call this task runs, taken until `until`; the job's key, a new
    // random one, or "" when the store couldn't keep it.
    keep: fn(String, String, Int) -[]> String Never!,
    // Deletes the row of key `key`, in the transaction of the call this
    // task runs, as its job runs there: 1; 0 when the row has gone, as
    // another run did the job; -1 when the store couldn't delete it.
    done: fn(String) -[]> Int Never!,
    // Records on the row of key `key` that its job ran `runs` times and
    // failed each time, the last with `error`, and takes it until `until`;
    // false when the store couldn't.
    failed: fn(String, Int, String, Int) -[]> Bool Never!,
    // Takes each row of a job named in `names` that is not taken at `now`,
    // until `until`, and gives each; None once the store has closed.
    take: fn([String], Int, Int) -[]> [CallQueued]? Never!,
    // Takes the rows of keys `keys` until `until`; false when the store
    // couldn't.
    hold: fn([String], Int) -[]> Bool Never!,
    // Keeps the reply of request `request`, in the transaction of call
    // `call`, or on its own for call 0 (after the call rolled back); false
    // when the store couldn't.
    answered: fn(Int, CallRequest, String) -[]> Bool Never!,
}

// A row a server took from a store's outbox: its job's key, name and
// encoded arguments, and the runs the job made so far, each failed.
priv CallQueued: struct {
    key: String,
    name: String,
    args: String,
    runs: Int,
}

// The function that decodes a job's arguments and runs it, which replies
// `{"err":...}` when the job failed. Copies share the one function.
priv CallJobCall: struct {
    call: fn(RemoteArgs) -> String [FieldError]!,
}

// A job a call queued: its name (`<service module>.<Service>.<method>`), its
// arguments as one encoded JSON array, the runs it gets after a first that
// fails, and the function that runs it.
priv CallJob: struct {
    name: String,
    args: String,
    retries: Int,
    run: Shared<CallJobCall>,
}

// A webhook delivery a call runs: the ID its sender gives it, the same each
// time it is delivered again, and the second (since the Unix epoch) the
// server received it.
#Equatable
priv CallDelivery: struct {
    id: String,
    at: Int,
}

// A schedule's run a call is: the schedule's name (`<service
// module>.<Service>.<method>`) and the second (since the Unix epoch) it was
// due.
#Equatable
priv CallTick: struct {
    schedule: String,
    due: Int,
}

// The request key of a remote call: the account the call acts for ("" for
// none), the key the client gave the call, the same each time it sends the
// call again, and the second (since the Unix epoch) the server received it.
// The account scopes the key, so one account's key never answers another's.
#Equatable
priv CallRequest: struct {
    account: String,
    key: String,
    at: Int,
}

priv CallRun: struct {
    task: TaskID,
    id: Int,
    joins: [CallJoin],
    refused: Bool,
    delivery: CallDelivery?,
    tick: CallTick?,
    request: CallRequest?,
    reply: String?,
    repeated: Bool,
    jobs: [CallJob],
}

priv CallRuns: struct {
    runs: [CallRun],
    made: Int,
}

priv CALLS: Shared{CallRuns{runs: [CallRun]{}, made: 0}}

priv(package) transactions: module {
    // The times a call runs, in all, while a busy store refuses it. Each
    // refusal has already waited out the store's busy timeout, so the
    // attempts need no wait of their own.
    attempts: fn() -> Int Never! { 5 }

    // Opens a call on this task and gives its number; None when the task
    // runs one already, which the new call then belongs to.
    begin: fn() -> Int? Never! {
        me: tasks.current_task()
        runs := CALLS.guard_edit()
        loop run in runs.value.runs {
            if run.task == me -> return None
        }
        runs.value.made += 1
        runs.value.runs.push(CallRun{task: me, id: runs.value.made, joins: [CallJoin]{}, refused: false, delivery: None, tick: None, request: None, reply: None, repeated: false, jobs: [CallJob]{}})
        Val(runs.value.made)
    }

    // The call this task runs, by number; None outside one.
    current: fn() -> Int? Never! {
        me: tasks.current_task()
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.task == me -> return Val(run.id)
        }
        None
    }

    // Joins one store's transaction, which `end` finishes, and that store's
    // outbox to call `call`.
    join: fn(call: Int, end: ^^fn(Bool) -[]> Bool Never!, outbox: ^^CallOutbox) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call {
                runs.value.runs[index].joins.push(CallJoin{end: end.move(), outbox: outbox.move()})
                return
            }
        }
    }

    // Queues `job` in call `call`, to run once the call commits.
    enqueue: fn(call: Int, job: ^^CallJob) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call {
                runs.value.runs[index].jobs.push(job.move())
                return
            }
        }
    }

    // Marks call `call` refused: a store it uses was busy.
    refuse: fn(call: Int) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call -> runs.value.runs[index].refused = true
        }
    }

    // Whether a store refused call `call`.
    refused: fn(call: Int) -> Bool Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.refused
        }
        false
    }

    // Gives call `call` the webhook delivery it runs.
    deliver: fn(call: Int, delivery: CallDelivery) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call {
                runs.value.runs[index].delivery = Val(delivery.copy())
            }
        }
    }

    // The webhook delivery call `call` runs; None for any other call.
    delivery: fn(call: Int) -> CallDelivery? Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.delivery.copy()
        }
        None
    }

    // Gives call `call` the schedule's run it is.
    schedule: fn(call: Int, tick: CallTick) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call -> runs.value.runs[index].tick = Val(tick.copy())
        }
    }

    // The schedule's run call `call` is; None for any other call.
    tick: fn(call: Int) -> CallTick? Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.tick.copy()
        }
        None
    }

    // Gives call `call` the request key it carries.
    ask: fn(call: Int, request: CallRequest) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call {
                runs.value.runs[index].request = Val(request.copy())
            }
        }
    }

    // The request key call `call` carries; None for a call that carries none.
    request: fn(call: Int) -> CallRequest? Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.request.copy()
        }
        None
    }

    // Gives call `call` its reply: the one a store kept under its request
    // key already, which a store gives as the call joins it, or else the one
    // its run gave, which `end` keeps under that key. The first reply the
    // call is given stands.
    answer: fn(call: Int, reply: String) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call && runs.value.runs[index].reply == None {
                runs.value.runs[index].reply = Val(reply.copy())
            }
        }
    }

    // Call `call`'s reply (`answer`); None before it has one.
    reply: fn(call: Int) -> String? Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.reply.copy()
        }
        None
    }

    // Marks call `call` repeated: a store it uses has run its delivery or
    // its schedule's run, or keeps a reply under its request key.
    repeat: fn(call: Int) Never! {
        runs := CALLS.guard_edit()
        loop index in 0..<runs.value.runs.len() {
            if runs.value.runs[index].id == call -> runs.value.runs[index].repeated = true
        }
    }

    // Whether a store has run call `call`'s delivery or schedule's run
    // already, or keeps a reply under its request key.
    repeated: fn(call: Int) -> Bool Never! {
        runs: CALLS.guard_read()
        loop run in runs.value.runs {
            if run.id == call -> return run.repeated
        }
        false
    }

    // Ends call `call`: commits each joined transaction, in the order the
    // call joined them, when `commit` holds and no store refused the call or
    // had run its delivery, and otherwise rolls each back. A call that
    // carries a request key keeps its reply (`calls_answered`) in the first
    // store's transaction before the commits, or on its own once a run that
    // failed has rolled back. False when the call has to run again: a store
    // refused it, the first store couldn't keep its jobs or its reply, or the
    // first commit failed (and was rolled back). A call that writes two
    // stores commits each on its own; once one has committed, a later failed
    // commit can't undo it, so the call stands, and its jobs run. A call
    // that joined no store runs its jobs as it ends, and keeps no reply.
    end: fn(call: Int, commit: Bool) -> Bool Never! {
        ended := calls_take(call) ?? return true
        if ended.refused || ended.repeated || !commit {
            loop joined in ended.joins -> _: joined.end(false)
            if !ended.refused && !ended.repeated -> _: calls_answered(ended, 0)
            return !ended.refused
        }
        keys := [String]{}
        if ended.joins.len() > 0 {
            loop job in ended.jobs {
                key: ended.joins[0].outbox.keep(job.name, job.args, ended.joins[0].outbox.now() + JOB_HOLD_MS)
                if key == "" {
                    loop joined in ended.joins -> _: joined.end(false)
                    return false
                }
                keys.push(key)
            }
        }
        if !calls_answered(ended, call) {
            loop joined in ended.joins -> _: joined.end(false)
            return false
        }
        loop (index, joined) in ended.joins {
            if joined.end(true) || index > 0 -> next
            loop rest in 1..<ended.joins.len() -> _: ended.joins[rest].end(false)
            return false
        }
        // The blobs the call kept stay once it ends (`uploads_finish`).
        uploads_committed(call)
        if ended.joins.len() == 0 {
            loop job in ended.jobs.move() -> job_start(job, "", None, 0)
            return true
        }
        // The jobs' runs share the first store's outbox.
        first := ended.joins.remove(0, .Slot) ?? return true
        outbox: jobs_store(first.outbox.move(), false)
        at := 0
        loop job in ended.jobs.move() {
            job_start(job, keys[at].copy(), Val(outbox.copy()), 0)
            at += 1
        }
        true
    }
}

// Removes call `call` from the open calls and gives it.
priv calls_take: fn(call: Int) -> CallRun? Never! {
    runs := CALLS.guard_edit()
    loop index in 0..<runs.value.runs.len() {
        if runs.value.runs[index].id == call -> return runs.value.runs.remove(index, .Slot)
    }
    None
}

// Keeps `run`'s reply under its request key in the first store it joined,
// in call `call`'s transaction there, or on its own for call 0; true when
// the run carries no key, has no reply or joined no store.
priv calls_answered: fn(run: ^CallRun, call: Int) -> Bool Never! {
    if run.joins.len() == 0 -> return true
    if run.request == .Val(request) {
        if run.reply == .Val(reply) -> return run.joins[0].outbox.answered(call, request, reply)
    }
    true
}

// A device an account registered for pushes: its push service (`apns`,
// `fcm` or `web`), the service's token for it (for Web Push, the
// subscription's endpoint URL) and, for Web Push only, the subscription's
// P-256 public key and authentication secret, base64url.
priv PushDevice: struct {
    account: String,
    service: String,
    token: String,
    key: String,
    auth: String,
}

// One store's push devices, which core.db keeps in the table
// `__jet_push_devices` and names as the store opens (`push.store`). A
// device is found by its service and token.
priv PushDevices: struct {
    // Names the store among the open ones, as CallOutbox.store does.
    store: String,
    // Registers a device in place of the one with its service and token;
    // false when the store couldn't.
    add: fn(PushDevice) -[]> Bool Never!,
    // The devices the account registered; None when the store couldn't
    // read them, as once it has closed.
    of: fn(String) -[]> [PushDevice]? Never!,
    // Forgets the device of a service and a token; false when the store
    // couldn't.
    forget: fn(String, String) -[]> Bool Never!,
}

priv PushRegistry: struct {
    stores: [Shared<PushDevices>],
}

priv PUSH_REGISTRY: Shared{PushRegistry{stores: [Shared<PushDevices>]{}}}

// The devices accounts register for pushes. core.db names each database
// file as it opens (`store`). A device registers in the first store named
// that takes it, which is the app's first store still open; a push goes to
// the devices any named store holds.
priv(package) push: module {
    // Names a store; a store named again replaces the one of its name.
    store: fn(devices: ^^PushDevices) Never! {
        registry := PUSH_REGISTRY.guard_edit()
        loop index in 0..<registry.value.stores.len() {
            if push_store_name(registry.value.stores[index]) == devices.store {
                registry.value.stores[index] = Shared{devices.move()}
                return
            }
        }
        registry.value.stores.push(Shared{devices.move()})
    }

    // Registers `device` in the first named store that takes it; false
    // when none does.
    register: fn(device: PushDevice) -> Bool Never! {
        loop devices in push_stores() {
            held: devices.guard_read()
            if held.value.add(device.copy()) -> return true
        }
        false
    }

    // The devices the account `account` registered, each once.
    devices: fn(account: String) -> [PushDevice] Never! {
        found := [PushDevice]{}
        loop devices in push_stores() {
            held: devices.guard_read()
            listed: held.value.of(account.copy()) ?? next
            loop device in listed {
                if !push_device_listed(found, device) -> found.push(device.copy())
            }
        }
        found
    }

    // Forgets the device of `service` and `token` in each named store, as
    // its push service says it is gone.
    forget: fn(service: String, token: String) Never! {
        loop devices in push_stores() {
            held: devices.guard_read()
            _: held.value.forget(service.copy(), token.copy())
        }
    }

    // Sets up the push services `settings` names, in place of the ones set
    // up before.
    configure: fn(settings: push_wire.PushSettings) -[Net]> push_wire.PushError! {
        push_wire.push_configure(settings)
    }

    // The last pushes skipped or failed, oldest first: `skipped <service>
    // <account>: <reason>` or `failed …`.
    outcomes: fn() -> [String] Never! {
        held: PUSH_NOTES.guard_read()
        held.value.last.copy()
    }

    // Sets up the push services the graph's `.push` named, from the keys
    // it read (`App.push`), as a server starts: "" once they are set up or
    // when the graph names none, and otherwise why the start is refused,
    // ending in the `.push` call's place. It reads no variable itself, so a
    // server whose graph names no push services never reaches `Env`.
    start: fn() -[Net]> String Never! {
        named: app_push_named() ?? return ""
        place: "\n  --> {named.at.file}:{named.at.line} in {named.at.function}"
        if named.again == .Val(again) {
            return "The app gives its push services twice: give them in one `.push`, as at {named.at.file}:{named.at.line}.\n  --> {again.file}:{again.line} in {again.function}"
        }
        if named.refused != "" -> return "{named.refused}{place}"
        push_wire.push_configure(named.settings) ?? return "{err.reason}{place}"
        ""
    }
}

// The pushes skipped and failed since the process started, and the last
// C_PUSH_NOTES_KEPT of them.
priv PushNotes: struct {
    skipped: Int,
    failed: Int,
    last: [String],
}

priv PUSH_NOTES: Shared{PushNotes{skipped: 0, failed: 0, last: [String]{}}}

priv C_PUSH_NOTES_KEPT: 32

// The app graph: the services its clients call, the screens every target
// shows, each at the address of the state it opens, and whether a device
// queues the writes it can't send. `new` starts it, `.api<S>(path)` declares
// the service `S` the clients reach at `path`, `.mount(service)` answers
// `S`'s calls in this process, `.screen` adds a screen and `.offline` sets
// the queue. Every target runs this one graph, so its screens are every
// target's route set, and each `app.Remote<S>` a screen's view takes is the
// graph's Remote of `S`. The graph is the process's: each copy of an App,
// and the members that take none, read and change that one graph. The
// compiler lowers `.api`, `.mount`, `.screen`, `.cache`, `.sitemap`,
// `app.go`, `app.current`, `app.url_of`, `app.presence` and `app.notify` to
// the graph's `__` members below.
App: struct {
    title: String,

    // `.api<S>(path, max_upload:)` as the compiler lowers it: `service`
    // names `S`. A client posts each call of an endpoint method of `S` to
    // `{path}/{method}`, a body of at most `max_upload` bytes; a graph that
    // mounts `S` answers its calls in this process (`__remote`).
    __api: fn<S>(self, path: String, service: String, max_upload: Int) -> App Never! {
        held := APP_GRAPH.guard_edit()
        held.value.apis[service] = AppAPI{path: path, max_upload: max_upload}
        self.copy()
    }

    // `.cache<V>(policy)` as the compiler lowers it: `reply` names `V` as
    // an endpoint's reply type is named where it mounts, so each endpoint
    // method that replies a `V` is answered under `policy`
    // (`reply_cache.policy`). The last policy set for `V` holds.
    __cache: fn<V>(self, reply: String, policy: CachePolicy) -> App Never! {
        held := APP_CACHE.guard_edit()
        held.value[reply.copy()] = policy
        self.copy()
    }

    // `.sitemap(list)` as the compiler lowers it: `list` gives the states
    // `V` of the pages the sitemap lists, `state` names `V` as `__screen`'s
    // does, and `address` gives a state's fields' address text in the order
    // of `names` (`__address_arg`). The sitemap asks `list` each time it is
    // read (`sitemap.addresses`).
    __sitemap: fn<V>(self, state: String, names: [String], list: ^^fn() -> [V] Never!, address: ^^fn(App, V) -> [String] Never!) -> App Never! {
        graph: self.copy()
        opens: state.copy()
        fields: names.copy()
        listed := APP_SITEMAPS.guard_edit()
        listed.value.push(
            Shared{AppSitemap{
                state: state.copy(),
                addresses: fn() {
                    found := [String]{}
                    loop view in list() {
                        found.push(App.__url_of<V>(opens, fields, address(graph, view)))
                    }
                    found
                },
            }},
        )
        self.copy()
    }

    // Whether a device queues the writes it can't send (`.Queue`) or fails
    // them at once (`.Off`, the start).
    offline: fn(self, mode: Offline) -> App Never! {
        held := APP_GRAPH.guard_edit()
        held.value.offline = mode
        self.copy()
    }

    // Makes the app installable from a browser: a server of the graph
    // answers a web app manifest that names the app `name` in `color`
    // (0xRRGGBB), with icons of 192 and 512 pixels and a maskable one of 512
    // made from the one `icon` file, and every page it serves links the
    // manifest. The last call holds.
    installable: fn(self, name: String, icon: String, color: Int) -> App Never! {
        if name == "" {
            panic("`.installable` needs the app's name: an installed app shows it under its icon")
        }
        if icon == "" {
            panic("`.installable` needs the path of the app's icon, a PNG or JPEG file")
        }
        if color < 0 || color > 0xFFFFFF {
            panic("`.installable(color: {color})` is no color: write it as 0xRRGGBB, as 0x2a5bd7")
        }
        held := APP_GRAPH.guard_edit()
        held.value.install = Val(AppInstall{name: name, icon: icon, color: color})
        self.copy()
    }

    // Gives the app the link scheme `name`: `{name}://tasks/7` opens what
    // the address `/tasks/7` opens (`open_link`), and the desktop entry
    // `launch` installs on Linux names the app the handler of `name:` links
    // (`x-scheme-handler/{name}`), so the desktop opens such a link in the
    // app. A scheme is a letter, then letters, digits, `+`, `-` or `.`; it is
    // kept in lowercase, as schemes compare without case.
    url_scheme: fn(self, name: String) -> App Never! {
        scheme: name.lower()
        if !app_link_scheme_valid(scheme) {
            panic("`.url_scheme(\"{name}\")` is no link scheme: write a letter, then letters, digits, `+`, `-` or `.`, as \"crewboard\"")
        }
        if scheme == "http" || scheme == "https" || scheme == "file" {
            panic("`.url_scheme(\"{name}\")` names a scheme the system's browser and files own: give the app its own, as \"crewboard\", and its web links with `.app_links(domain:)`")
        }
        held := APP_GRAPH.guard_edit()
        if !held.value.schemes.contains(scheme) -> held.value.schemes.push(scheme)
        self.copy()
    }

    // Gives the app the web links of `domain`: `https://{domain}/tasks/7`
    // opens what the address `/tasks/7` opens (`open_link`), as the page at
    // that link does on the web. `domain` is a host name, without a scheme,
    // port or path; it is kept in lowercase, as host names compare without
    // case.
    app_links: fn(self, domain: String) -> App Never! {
        host: domain.lower()
        if host == "" || host.contains("/") || host.contains(":") || host.contains("@") || host.contains(" ") {
            panic("`.app_links(domain: \"{domain}\")` is no host name: write the domain alone, as \"crew.example.com\"")
        }
        held := APP_GRAPH.guard_edit()
        if !held.value.link_domains.contains(host) -> held.value.link_domains.push(host)
        self.copy()
    }

    // Opens the screen state `link` addresses, through the graph's route
    // set, as `go` opens a state: the state's fields are the texts of each
    // `:name` segment of the screen's path and of each `#App.Query` field in
    // the query, and the first screen, in the order the graph adds them,
    // whose path the link's path fits and whose texts make its state opens.
    // A link is an address (`/tasks/7`), a link of a scheme the app has
    // (`url_scheme`: `crewboard://tasks/7`) or a web link of one of its
    // domains (`app_links`: `https://crew.example.com/tasks/7`). Any other
    // link, and one no screen opens, opens the not-found state: no screen
    // is current, and `lost_link` gives the link. True when a screen opened.
    open_link: fn(self, link: String) -[Net, FS.Read]> Bool Never! {
        found: app_link_address(link) ?? return app_link_lost(link)
        path := found
        query := ""
        mark: found.find("?")
        if mark >= 0 {
            path = found.slice(0, mark)
            query = found.slice(mark + 1, found.len())
        }
        loop screen in self.__screens() {
            fields: app_link_fields(screen, path, query) ?? next
            graph: app_graph_open(screen.state, fields.copy())
            me: tasks.current_task()
            resume_begin(me)
            shown: graph.__open(screen, fields)
            live_drop(app_graph_route_data(resume_end(me)))
            if shown != None -> return true
        }
        app_link_lost(link)
    }

    // The link the not-found state shows (`open_link`), None while a screen
    // is current or before a link opens.
    lost_link: fn(self) -> String? Never! {
        now: app_graph_current() ?? return None
        if now.state != "" -> return None
        now.fields.get(C_APP_LOST_LINK).copy()
    }

    // Starts the app on a Linux desktop, as its one running copy. While a
    // copy runs, a launch hands it the link it was given and its activation
    // token, and is false: the caller exits. The running copy opens that
    // link (`open_link`) and keeps the token (`activations`). The copy
    // listens at `{runtime}/{id}.link`: `{runtime}` is `$XDG_RUNTIME_DIR`,
    // else the temporary directory, and `{id}` is the desktop entry's. When
    // no copy runs, this launch becomes it. When the graph has a link scheme
    // (`url_scheme`), it installs the app's desktop entry
    // (`{data}/applications/{id}.desktop`, `desktop_entry`). It also makes
    // that entry the default handler of each scheme's links in
    // `{config}/mimeapps.list`, as `xdg-mime default` does. `{data}` is
    // `$XDG_DATA_HOME`, else `~/.local/share`; `{config}` is
    // `$XDG_CONFIG_HOME`, else `~/.config`. It starts the graph's background
    // work (`background`), puts its tray in the desktop's (`tray`), starts
    // the app's run (`phase`, `LIFECYCLE`) and follows the machine's sleep
    // into it.
    // Then it opens the link the launch was given (`open_link`), else,
    // when the graph has a window (`window`), the address `/`, opens the
    // window, and is true. That link is the first argument that is one, as
    // the desktop passes the link the entry's `%u` names. In a page there
    // is no other copy, desktop entry or window to open: a launch starts
    // the app's run and follows the page's lifecycle into it, and a graph
    // with screens opens the page's address and draws its screen into the
    // page, again after each of the page's turns that changed what it shows
    // (`app_launch_page`); it is true.
    launch: fn(self) -[Browser, Env, Exec.Args, Exec.Exit, FS.Read, FS.Write, Net, Time]> Bool Never! {
        #if #build.target.os == {
            .Linux -> { return app_launch_desktop(self) }
            .MacOS -> { return app_launch_desktop(self) }
            .Windows -> { return app_launch_desktop(self) }
            .Web -> { return app_launch_page(self) }
            .Wasm -> { return app_launch_desktop(self) }
            .Freestanding -> { return app_launch_desktop(self) }
        }
    }

    // The activation token of each later launch that handed this running
    // copy its link (`launch`), in order, "" for a launch the desktop gave
    // none. A launch's token is the one the desktop's activation protocol
    // takes to bring the app's window to the front:
    // `$XDG_ACTIVATION_TOKEN` (Wayland), else `$DESKTOP_STARTUP_ID` (X11).
    activations: fn(self) -> [String] Never! {
        held: APP_GRAPH.guard_read()
        held.value.activations.copy()
    }

    // Runs `run` in the background on a Linux desktop, every `every`
    // while the app runs, from `launch` on. When `at_login`, the app also
    // runs at login: `launch` installs its XDG autostart entry
    // (`{config}/autostart/{id}.desktop`, `desktop_entry`), and a launch
    // whose graph asks no work to run at login removes it. A run that
    // fails puts its notice in the app's notice list (`notices`): no
    // control shows it. Gives back the graph. Panics when `every` isn't
    // positive.
    background: fn(self, every: Duration, run: ^^fn() Notice!, at_login: Bool{false}) -> App Never! {
        if every.ns <= 0 {
            panic("background work runs every positive duration, not every {every.ns}ns")
        }
        held := APP_GRAPH.guard_edit()
        held.value.backgrounds.push(AppBackground{every_ns: every.ns, at_login: at_login, run: Shared{AppBackgroundRun{run: run.move()}}})
        self.copy()
    }

    // Puts the app's icon in the Linux desktop's tray from `launch` on,
    // where it stays while the app runs, whatever windows close. `icon`
    // names it in the desktop's icon theme. Its menu is the items `menu`
    // makes: the tray asks again every quarter second and after each call
    // the desktop makes, so a menu made from a live binding (`state`)
    // follows it, and the desktop hears when the items change. When `menu`
    // fails, the tray keeps its last items under a first item, which can't
    // be chosen, with the notice's text. Choosing an item runs it (`item`,
    // `quit_item`). A desktop with no tray leaves a notice in the app's
    // notice list (`notices`). Gives back the graph.
    tray: fn(self, icon: String, menu: ^^fn() -> [MenuItem] Notice!) -> App Never! {
        held := APP_GRAPH.guard_edit()
        held.value.tray = Val(AppTray{icon: icon, menu: Shared{AppTrayMenu{menu: menu.move()}}})
        self.copy()
    }

    // Gives the app's window (`.window`) a menu bar: the menus `menus`
    // makes (`menu`, `edit_menu`, `window_menu`). On a Linux desktop with
    // a global menu (KDE Plasma's) the window names its menu, a dbusmenu
    // on the session bus, through org_kde_kwin_appmenu, and the desktop
    // shows it as the window's menu bar, each item with its key
    // equivalent. The bar asks `menus` again every quarter second and
    // after each call the desktop makes, as the tray does; when `menus`
    // fails, it keeps its last menus under a first entry, which can't be
    // chosen, with the notice's text. On any desktop, a key pressed in the
    // window with exactly an enabled item's key equivalent chooses the
    // item. Choosing an item runs it (`item`, `quit_item`); the Edit and
    // Window menus' items act on the window. Gives back the graph.
    menu_bar: fn(self, menus: ^^fn() -> [Menu] Notice!) -> App Never! {
        held := APP_GRAPH.guard_edit()
        held.value.menu_bar = Val(Shared{AppMenuBar{menus: menus.move()}})
        self.copy()
    }

    // Runs `on_resume` each time the app comes back from `launch` on: on
    // a Linux desktop, when its window takes the focus again after it lost
    // it, and when the machine wakes from sleep (logind's PrepareForSleep
    // on the system bus), as the app's lifecycle hears them (`LIFECYCLE`,
    // a listener of which this subscribes for the graph's life). Losing
    // the focus and the machine going to sleep take the app away; only a
    // focus or a wake after that brings it back, and the window being
    // shown again does not. Coming back, with or without `on_resume`,
    // first sends the writes the device queued (`offline(.Queue)`) and then
    // re-runs every live binding at its next read, so the screen shows what
    // changed while the app was away, in a task of its own. A notice
    // `on_resume` fails with shows at the top of the window that came back
    // until a click dismisses it; with no window open it joins the app's
    // notice list (`notices`). Gives back the graph.
    lifecycle: fn(self, on_resume: ^^fn() Notice!) -> App Never! {
        resume: Shared{AppResume{run: on_resume.move()}}
        held := APP_LIFECYCLE.guard_edit()
        if held.value.scope == None -> held.value.scope = Val(event.scope())
        held.value.adapted = true
        if held.value.scope == .Val(scope) {
            LIFECYCLE.on(scope, fn(_heard: LifecycleEvent) {
                if app_lifecycle_resuming() -> app_resume_start(Val(resume.copy()))
            })
        }
        self.copy()
    }

    // Gives the server the push services `app.notify(to:)` sends through:
    // Apple's (`apns`), Google's (`fcm`) and the browsers' (`web`), each
    // made by its maker (`apns`, `fcm`, `web_push`), which names the
    // environment variables that hold its keys. This call reads them once,
    // as secrets, so only an app that names push services reaches `Env`;
    // a variable that is unset or empty, or that holds no key its service
    // takes, refuses the server's start, naming the variable and this
    // call's place. A service left out sends nothing: a push to one of its
    // devices is skipped. A second `.push` on the graph refuses the start,
    // naming both places. Gives back the graph.
    push: fn(self, *, apns: APNs?{None}, fcm: FCM?{None}, web: WebPush?{None}, at: SourceLocation{#caller}) -[Env]> App Never! {
        held := APP_GRAPH.guard_edit()
        if held.value.push == .Val(first) {
            held.value.push = Val(AppPush{settings: first.settings.copy(), refused: first.refused.copy(), at: first.at.copy(), again: Val(at)})
            return self.copy()
        }
        named := AppPush{settings: push_wire.PushSettings{apns: None, fcm: None, web: None}, refused: "", at: at, again: None}
        if app_push_read(apns, fcm, web) == {
            .Ok(settings) -> { named.settings = settings }
            .Err(problem) -> named.refused = problem.reason
        }
        held.value.push = Val(named)
        self.copy()
    }

    // Lets a native app sign in to a server of the graph (`sign_in`) with
    // an account core.auth keeps (`auth.register_user`): the server answers
    // POST `{SESSION_PATH}/sign-in` and `{SESSION_PATH}/refresh` with the
    // device's tokens, an access token, a core.auth session that lasts
    // `access`, and a refresh token that lasts `refresh` and works once. A
    // device the server revokes (`auth.revoke_device`) is signed out when
    // its access token ends. The graph keeps core.auth's `tokens_login` and
    // `tokens_refresh` for its servers to call, so the app that gives
    // `.sessions` reaches `DB` and `Rand`, which they use, here. Gives back
    // the graph. Panics when a lifetime is under a millisecond.
    sessions: fn(self, access: Duration{15min}, refresh: Duration{30d}) -[DB, Rand]> App Never! {
        if access.ns < 1000000 || refresh.ns < 1000000 {
            panic("a session's tokens last at least a millisecond, not {access.ns}ns and {refresh.ns}ns")
        }
        mint: AppSessionMint{
            sign_in: fn(account: String, password: String, device: String, now_ms: Int, access_ms: Int, refresh_ms: Int) { auth.tokens_login(account, password, device, now_ms, access_ms, refresh_ms) },
            refresh: fn(token: String, now_ms: Int, access_ms: Int, refresh_ms: Int) { auth.tokens_refresh(token, now_ms, access_ms, refresh_ms) },
        }
        held := APP_GRAPH.guard_edit()
        held.value.sessions = Val(AppSessions{access_ms: access.ns /% 1000000, refresh_ms: refresh.ns /% 1000000, mint: Shared{mint}})
        self.copy()
    }

    // Shows the app in a window `width` x `height` logical pixels on a Linux
    // desktop from `launch` on, titled the app's title. The window shows the
    // current screen (`go`, `open_link`): the node tree its view gives, as
    // core.ui lays it out and draws it, drawn again when another screen
    // opens. Closing the window ends the app. A desktop with no display, or
    // one that fails, leaves a notice in the app's notice list (`notices`).
    // Gives back the graph. Panics when a side isn't positive.
    window: fn(self, width: Int, height: Int) -> App Never! {
        if width < 1 || height < 1 {
            panic("a window is at least one pixel on each side, not {width}x{height}")
        }
        held := APP_GRAPH.guard_edit()
        held.value.window = Val(AppWindow{width: width, height: height})
        self.copy()
    }

    // The text of the app's Linux desktop entry: an application named
    // `title` that `exec` runs with the link it opens (`%u`), handling the
    // links of each scheme the graph has (`x-scheme-handler/{scheme}`).
    desktop_entry: fn(self, exec: String) -> String Never! {
        lines := [String]{"[Desktop Entry]", "Type=Application", "Name={app_desktop_value(self.title)}", "Exec={app_desktop_exec(exec)} %u", "Terminal=false"}
        handlers := ""
        loop scheme in app_graph_schemes() -> handlers = "{handlers}x-scheme-handler/{scheme};"
        if handlers != "" -> lines.push("MimeType={handlers}")
        "{lines.join("\n")}\n"
    }

    // `.screen(path, view, signed_in:)` as the compiler lowers it, once it
    // has checked `view`'s state `V` against `path`: `state` names `V`,
    // `query` lists its `#App.Query` fields, and `open` opens the screen at
    // an address: from the text of each of `V`'s fields there, by name, it
    // makes the state, runs `view` with it and the graph's Remotes, and gives
    // the node tree of what the view shows (the view's own tree, else
    // `__view_node`); None when the texts don't make a `V`. The screen joins
    // the graph's route set, in the order the graph adds it, where
    // `__url_of` finds its address, `__go` opens it, and a renderer walks it
    // (`screens`).
    __screen: fn<V>(self, path: String, state: String, query: [String], signed_in: Bool, open: ^^fn(App, [String:String]) -[Net, FS.Read]> UINode? Never!) -> App Never! {
        held := APP_GRAPH.guard_edit()
        held.value.screens.push(AppScreen{path: path, state: state, query: query, signed_in: signed_in, open: Shared{AppOpen{run: open.move()}}})
        self.copy()
    }

    // An `#App.Public` method of a mounted service, as the compiler lowers
    // `.mount(service)`: `path` is `{service}/{method}`, where the graph's
    // Remote of the service posts the call (`graph_post`), and `answer` runs
    // the call from its decoded arguments. A call in this process comes from
    // no network address, so the endpoint's limit of `limit` calls per
    // `window_ns` from one address, which a server keeps, doesn't apply.
    __remote_public: fn(self, path: String, answer: ^^fn(RemoteArgs) -> String [FieldError]!, limit: Int, window_ns: Int) -> App Never! {
        held := APP_GRAPH.guard_edit()
        held.value.endpoints[path] = AppEndpoint{answer: Val(Shared{AppAnswer{run: answer.move()}})}
        self.copy()
    }

    // An `#App.SignedIn` method of a mounted service: its call answers
    // `SignedOut`, as a server's does, until the graph signs a caller in.
    __remote_signed_in: fn(self, path: String, limit: Int, window_ns: Int) -> App Never! {
        held := APP_GRAPH.guard_edit()
        held.value.endpoints[path] = AppEndpoint{answer: None}
        self.copy()
    }

    // An `#App.Job` method of a mounted service, declared to this process's
    // jobs (`jobs.know`), so a server serving here runs the job's kept rows.
    __job: fn(self, name: String, retries: Int, run: ^^fn(RemoteArgs) -> String [FieldError]!) -> App Never! {
        jobs.know(name, retries, run.move())
        self.copy()
    }

    // The graph's Remote of the service `S` (`.api<S>`, which `service`
    // names), as the compiler passes it to each `app.Remote<S>` parameter of
    // a screen's view: when the graph mounts `S`, each call runs in this
    // process (`graph_post`); otherwise it posts to `{path}/{method}`. The
    // compiler passes only a service a `.api` of the graph declares.
    __remote: fn<S>(self, service: String) -> Remote<S> Never! {
        held: APP_GRAPH.guard_read()
        api: held.value.apis.get(service) ?? panic("the app graph declares no `.api` of `{service}`: add `.api<{service}>(path)` to the graph")
        loop path in held.value.endpoints.keys() {
            if path.starts_with("{service}/") {
                return Remote<S>{service: None, address: service, client: "", local: true}
            }
        }
        Remote<S>{service: None, address: api.path.copy(), client: "", local: false}
    }

    // The JSON of the field `name` of a state, of type `T`, from its text in
    // an address (`fields`, by field name): a value whose JSON is a string
    // is its own text, any other its JSON (`__address_arg`). None when the
    // address has no such field or its text is no `T`.
    __address_json: fn<T: [Encode, Decode]>(self, fields: [String:String], name: String) -> String? Never! {
        text: fields.get(name) ?? return None
        quoted: live_json.to_string<String>(text) ?? return None
        if live_json.decode<T>(quoted) == .Ok(value) {
            return Val(live_json.to_string<T>(value) ?? return None)
        }
        value: live_json.decode<T>(text) ?? return None
        Val(live_json.to_string<T>(value) ?? return None)
    }

    // The state `V` whose fields `names` have the JSON `values`
    // (`__address_json`), in order; None when a value is missing or the
    // values make no `V`.
    __address_state: fn<V: Decode>(self, names: [String], values: [String?]) -> V? Never! {
        parts := [String]{}
        loop index in 0..<names.len() {
            value: values[index] ?? return None
            name: live_json.to_string<String>(names[index]) ?? return None
            parts.push("{name}:{value}")
        }
        Val(live_json.decode<V>("{{{parts.join(",")}}}") ?? return None)
    }

    // What a screen's view shows when it gives no node tree: its text (a
    // string's own text, any other value's JSON) as a text node, whose HTML
    // is that text, escaped, as a paragraph. A view that gives a tree shows
    // the tree.
    __view_node: fn<N: Encode>(self, shown: N) -> UINode Never! {
        ui.text(App.__address_arg<N>(shown))
    }

    // `app.go(view)` as the compiler lowers it: opens the screen whose state
    // is `V`, which `state` names, at the address of the fields `names` with
    // the texts `values` (`__address_arg`): the screen becomes the current
    // one (`__current`), and its view runs. The bindings the view reads are
    // the screen's route data (app_graph_route_data). The compiler refuses a
    // state that no screen of the program's graph opens, so a state with no
    // screen here is one whose graph this process has not built.
    __go: fn<V>(state: String, names: [String], values: [String]) -[Net, FS.Read]> Never! {
        fields := [String:String]{}
        loop index in 0..<names.len() -> fields[names[index].copy()] = values[index].copy()
        screen: app_screen(state) ?? panic("no screen opens `{state}` yet: build the app graph (`app.new`) before opening a screen")
        graph: app_graph_open(state, fields.copy())
        me: tasks.current_task()
        resume_begin(me)
        _: graph.__open(screen, fields)
        live_drop(app_graph_route_data(resume_end(me)))
    }

    // `app.current<V>()` as the compiler lowers it: the state of the current
    // screen (`__go`) when it is a `V`, which `state` names, made from its
    // address's field texts by `decode`; None otherwise.
    __current: fn<V>(state: String, decode: fn(App, [String:String]) -> V? Never!) -> V? Never! {
        now: app_graph_current() ?? return None
        if now.state != state -> return None
        decode(App{title: app_graph_title()}, now.fields)
    }

    // The graph as it stands, as a server holds it to answer its screens'
    // addresses.
    __graph: fn() -> App Never! { App{title: app_graph_title()} }

    // The screens of the graph, in the order it adds them: what a renderer
    // walks to answer each address.
    __screens: fn(self) -> [AppScreen] Never! {
        held: APP_GRAPH.guard_read()
        held.value.screens.copy()
    }

    // What `.installable` set, None when the graph is not installable.
    __install: fn(self) -> AppInstall? Never! {
        held: APP_GRAPH.guard_read()
        held.value.install.copy()
    }

    // The paths of the graph's services when it queues the writes it can't
    // send (`.offline(.Queue)`), which a browser's service worker holds;
    // none when it doesn't.
    __queued_apis: fn(self) -> [String] Never! {
        held: APP_GRAPH.guard_read()
        paths := [String]{}
        if held.value.offline != .Queue -> return paths
        loop service in held.value.apis.keys() -> paths.push(held.value.apis[service].path.copy())
        paths.sort()
        paths
    }

    // Opens `screen` at the address whose field texts are `fields`, by field
    // name, as a renderer does: the node tree of what its view shows, or
    // None when the texts make no state of the screen.
    __open: fn(self, screen: AppScreen, fields: [String:String]) -[Net, FS.Read]> UINode? Never! {
        opener: screen.open.guard_read()
        opener.value.run(self.copy(), fields)
    }

    // `.head(head)` as the compiler lowers it: `head` gives the page
    // metadata of the screen whose state is `V`, and `state` names `V` as
    // `__screen`'s does. `decode` makes a `V` from its address's field
    // texts, as `__current`'s does. The last head given for `V` holds; a
    // page asks it for the address it shows (`heads.of`).
    __head: fn<V>(self, state: String, decode: ^^fn(App, [String:String]) -> V? Never!, head: ^^fn(V) -> Head Never!) -> App Never! {
        held := APP_HEADS.guard_edit()
        held.value[state.copy()] = Shared{AppHead{
            run: fn(graph: App, fields: [String:String]) {
                shown: decode(graph, fields) ?? return Head?{None}
                Val(head(shown))
            },
        }}
        self.copy()
    }

    // The address of the screen whose state is `V`, as the compiler lowers
    // `url_of(view)` and a push's `open:`. `names` are `V`'s fields, in
    // order, and `values` their address text (`__address_arg`). Each `:name`
    // segment of the screen's path is its field's value, and each query
    // field with a value joins the query, in field order; both are
    // percent-encoded. The compiler refuses a state that no screen of the
    // program's graph opens, so a state with no screen here is one whose
    // graph this process has not built.
    __url_of: fn<V>(state: String, names: [String], values: [String]) -> String Never! {
        screen: app_screen(state) ?? panic("no screen opens `{state}` yet: build the app graph (`app.new`) before taking an address")
        parts := [String]{}
        loop segment in screen.path.split("/") {
            if !segment.starts_with(":") {
                parts.push(segment)
                next
            }
            name: segment.removeprefix(":")
            index: names.index_of(name) ?? panic("`{state}` has no field `{name}` for the path `{screen.path}`")
            parts.push(url.percent_encode(values[index]))
        }
        address := parts.join("/")
        separator := "?"
        loop field in screen.query {
            index: names.index_of(field) ?? next
            if values[index] == "" -> next
            address = "{address}{separator}{url.percent_encode(field)}={url.percent_encode(values[index])}"
            separator = "&"
        }
        address
    }

    // A state field's text in an address: a string's own text, and any
    // other value's JSON.
    __address_arg: fn<A: Encode>(value: A) -> String Never! {
        text: live_json.to_string<A>(value) ?? return ""
        tree: live_json.parse(text) ?? return text
        live_json.at<String>(tree, "") ?? text
    }

    // `__address_arg` through a graph, as a lowered `.sitemap` reads each
    // state's fields (`__sitemap`).
    __address_text: fn<A: Encode>(self, value: A) -> String Never! { App.__address_arg<A>(value) }

    // Who has the screen state at `address` open, as the compiler lowers
    // `presence(view)` (`address` is `__url_of`'s): each account whose live
    // binding's latest run asked this, sorted. A run that a row policy
    // refuses before it asks, as a method that reads the state's row first
    // is refused, leaves its account out, so only accounts whose last read
    // of the screen's data passed are counted. Asked in a binding's run, the
    // run's own account is present, and the binding re-runs when the
    // accounts present change, as a live query does; asked elsewhere, it only
    // reads them.
    __presence: fn(address: String) -> [auth.AccountID] Never! {
        asking := ""
        if maybe_caller() == .Val(account) && live_presence_ask(tasks.current_task(), address) {
            asking = account.raw()
            source: "{LIVE_PRESENCE_SOURCE}{address}"
            live_read_record(source, source)
        }
        live_present(address, asking)
    }

    // A push to each device the account `to` registered, as the compiler
    // lowers `app.notify(to:, title:, body:, open:)`: `open_route` is the
    // address of the state a tap opens (`__url_of`). Inside a job, a
    // webhook's call or a scheduled run, each push's key is made from the
    // run's key, `to` and `open_route`, so a run that runs again replaces the
    // pushes it sent; outside one, each push has a fresh key. A device whose
    // push service is not set up is skipped. A push its service refuses is
    // dropped, and when the service says the device is gone, the device is
    // forgotten. Each skip and failure is counted (`jet.push.skipped`,
    // `jet.push.failed`) and kept with its service, account and reason
    // (`push.outcomes`): the published signature declares only Net, so no
    // log record can carry them.
    __notify: fn(to: auth.AccountID, title: String, body: String, open_route: String) -[Net]> Never! {
        account: to.raw()
        devices: push.devices(account)
        if devices.len() == 0 {
            return
        }
        run: push_run_key()
        key: if run != "" -> push_wire.push_collapse_key(run, account, open_route) else -> {
            push_wire.push_fresh_key() ?? {
                loop device in devices -> push_note(false, device.service, account, err.reason)
                return
            }
        }
        now: push_wire.push_now()
        loop device in devices {
            if !push_wire.push_configured(device.service) {
                push_note(true, device.service, account, "no {push_wire.push_service_label(device.service)} settings")
                next
            }
            outcome: push_wire.push_deliver(device.service, device.token, device.key, device.auth, key, title, body, open_route, now)
            if outcome.reason == "" -> next
            if outcome.gone {
                push.forget(device.service, device.token)
                push_note(false, device.service, account, "{outcome.reason}; the device is forgotten")
            } else { push_note(false, device.service, account, outcome.reason) }
        }
    }

    // A notification on this device, as the compiler lowers
    // `app.notify(title:, body:, open:)` written without `to:`. `open_route`
    // is the address of the state a click on it opens (`__url_of`). On a
    // Linux desktop the desktop's notification service shows it, with no
    // server, and while the app runs a click on it opens that state through
    // the graph's route set (`open_link`). A notification that can't be
    // shown is never dropped: a notice saying so joins the app's notice
    // list (`notices`).
    __notify_here: fn(title: String, body: String, open_route: String) -[Env, FS.Read, Net, Time]> Never! {
        #if #build.target.os == {
            .Linux -> { app_notify_linux(title, body, open_route) }
            .MacOS -> { app_notify_unshown(title, NOTIFY_UNBUILT) }
            .Windows -> { app_notify_unshown(title, NOTIFY_UNBUILT) }
            .Web -> { app_notify_unshown(title, "a page shows no notification of its own") }
            .Wasm -> { app_notify_unshown(title, "a page shows no notification of its own") }
            .Freestanding -> { app_notify_unshown(title, "there is no desktop to show it") }
        }
    }
}

// A field of a screen's state that the address carries after `?`:
// `#App.Query q: String{""}` is `?q=…`. Every other field of the state is
// the `:name` segment of its screen's path that has its name.
Query: struct {
    impl Marker {
        sites: [.Field],
    }
}

// Starts the app graph, titled `title`: a graph with no services, screens,
// heads, queue, links or lifecycle listeners of its own yet.
new: fn(title: String) -> App Never! {
    held := APP_GRAPH.guard_edit()
    held.value = AppGraph{title: title.copy(), apis: [String:AppAPI]{}, endpoints: [String:AppEndpoint]{}, screens: [AppScreen]{}, offline: .Off, install: None, current: None, route_data: [Int]{}, schemes: [String]{}, link_domains: [String]{}, activations: [String]{}, backgrounds: [AppBackground]{}, tray: None, window: None, menu_bar: None, push: None, sessions: None}
    heads := APP_HEADS.guard_edit()
    heads.value = [String:Shared<AppHead>]{}
    app_lifecycle_graph()
    App{title: title}
}

// Apple's push service (APNs), as `App.push(apns:)` takes it: the
// variables that hold the `.p8` signing key (`key_env`) and its key ID
// (`key_id_env`), the team's ID and the app's bundle ID (`topic`).
APNs: struct {
    key_env: String,
    key_id_env: String,
    team: String,
    topic: String,
}

// Firebase Cloud Messaging (FCM), as `App.push(fcm:)` takes it: the
// variable that holds the service account file, whose `project_id` names
// the Firebase project.
FCM: struct {
    service_account_env: String,
}

// Web Push, as `App.push(web:)` takes it: the variable that holds the
// application server's P-256 private key (VAPID, PEM) and the contact a
// push service may write to (`mailto:` or `https:`).
WebPush: struct {
    key_env: String,
    contact: String,
}

// APNs's settings for `App.push(apns:)`: `key_env` and `key_id_env` name
// the variables that hold the `.p8` key, as the file or its base64 on one
// line, and its key ID; `team` and `topic` are the team's ID and the app's
// bundle ID.
apns: fn(key_env: String, key_id_env: String, team: String, topic: String) -> APNs Never! {
    APNs{key_env: key_env, key_id_env: key_id_env, team: team, topic: topic}
}

// FCM's settings for `App.push(fcm:)`: `service_account_env` names the
// variable that holds the service account file, as the JSON or its base64
// on one line.
fcm: fn(service_account_env: String) -> FCM Never! { FCM{service_account_env: service_account_env} }

// Web Push's settings for `App.push(web:)`: `key_env` names the variable
// that holds the VAPID private key, as the PEM file or its base64 on one
// line, and `contact` is the `mailto:` or `https:` address push services
// may write to.
web_push: fn(key_env: String, contact: String) -> WebPush Never! {
    WebPush{key_env: key_env, contact: contact}
}

// The push services a graph's `.push` names, with the keys it read, or why
// they can't start (`refused`, "" when they can), where it named them, and
// where a second `.push` named them again.
priv AppPush: struct {
    settings: push_wire.PushSettings,
    refused: String,
    at: SourceLocation,
    again: SourceLocation?,
}

// The push services the graph names, if any.
priv app_push_named: fn() -> AppPush? Never! {
    held: APP_GRAPH.guard_read()
    held.value.push.copy()
}

// How long the tokens of a graph's `.sessions` last, in milliseconds, and
// what mints them.
priv AppSessions: struct {
    access_ms: Int,
    refresh_ms: Int,
    mint: Shared<AppSessionMint>,
}

// core.auth's `tokens_login` and `tokens_refresh`, as `.sessions` keeps
// them for the graph's servers.
priv AppSessionMint: struct {
    sign_in: fn(String, String, String, Int, Int, Int) -> auth.Tokens Err!,
    refresh: fn(String, Int, Int, Int) -> auth.Tokens Err!,
}

// Where and how long the graph's `.sessions` sign a native app in, as
// core.web's servers answer its sign-in and refresh.
priv(package) sessions: module {
    // The path the sign-in and refresh routes live under.
    path: fn() -> String Never! { SESSION_PATH }

    // How long an access token lasts; None when the graph gives no
    // `.sessions`, so its servers sign no native app in.
    access_ms: fn() -> Int? Never! {
        given: app_sessions_given() ?? return None
        Val(given.access_ms)
    }

    // Signs `device` in for `account` with its credential `password`, at
    // the Unix millisecond `now_ms`, for the graph's lifetimes
    // (`auth.tokens_login`).
    sign_in: fn(account: String, password: String, device: String, now_ms: Int) -> auth.Tokens Err! {
        given: app_sessions_given() ?? return Err(SESSIONS_NONE)
        held: given.mint.guard_read()
        app_sessions_sign_in(held.value.sign_in, account, password, device, now_ms, given)
    }

    // Spends the refresh token `token` at the Unix millisecond `now_ms` for
    // its device's next tokens, for the graph's lifetimes
    // (`auth.tokens_refresh`).
    refresh: fn(token: String, now_ms: Int) -> auth.Tokens Err! {
        given: app_sessions_given() ?? return Err(SESSIONS_NONE)
        held: given.mint.guard_read()
        app_sessions_refresh(held.value.refresh, token, now_ms, given)
    }
}

priv SESSIONS_NONE: "this app signs no native app in"

// The graph's `.sessions`, if it gives them.
priv app_sessions_given: fn() -> AppSessions? Never! {
    held: APP_GRAPH.guard_read()
    held.value.sessions.copy()
}

priv app_sessions_sign_in: fn(mint: fn(String, String, String, Int, Int, Int) -> auth.Tokens Err!, account: String, password: String, device: String, now_ms: Int, given: AppSessions) -> auth.Tokens Err! {
    mint(account, password, device, now_ms, given.access_ms, given.refresh_ms)
}

priv app_sessions_refresh: fn(mint: fn(String, Int, Int, Int) -> auth.Tokens Err!, token: String, now_ms: Int, given: AppSessions) -> auth.Tokens Err! {
    mint(token, now_ms, given.access_ms, given.refresh_ms)
}

// The settings of the services `apns`, `fcm` and `web` name, each from the
// variables its maker names, read once here: a variable that is unset,
// empty or holds no key its service takes fails, naming it.
priv app_push_read: fn(apns: APNs?, fcm: FCM?, web: WebPush?) -[Env]> push_wire.PushSettings push_wire.PushError! {
    settings := push_wire.PushSettings{apns: None, fcm: None, web: None}
    if apns == .Val(given) {
        key: app_push_variable(given.key_env, "app.apns", "key_env") ?? return Err(err)
        key_id: app_push_variable(given.key_id_env, "app.apns", "key_id_env") ?? return Err(err)
        settings.apns = Val(push_wire.PushAPNs{origin: push_wire.PUSH_APNS_ORIGIN, team_id: given.team.copy(), key_id: key_id.trim(), key: push_wire.push_key_text(key), key_from: app_push_source(given.key_env, "app.apns", "key_env"), topic: given.topic.copy()})
    }
    if fcm == .Val(given) {
        account: app_push_variable(given.service_account_env, "app.fcm", "service_account_env") ?? return Err(err)
        source: app_push_source(given.service_account_env, "app.fcm", "service_account_env")
        settings.fcm = Val(push_wire.push_fcm_account(push_wire.push_key_text(account), source) ?? return Err(err))
    }
    if web == .Val(given) {
        key: app_push_variable(given.key_env, "app.web_push", "key_env") ?? return Err(err)
        settings.web = Val(push_wire.PushWeb{contact: given.contact.copy(), key: push_wire.push_key_text(key), key_from: app_push_source(given.key_env, "app.web_push", "key_env")})
    }
    Ok(settings)
}

// The value of the variable `name` that `argument` of `maker` names; an
// unset or empty variable fails.
priv app_push_variable: fn(name: String, maker: String, argument: String) -[Env]> String push_wire.PushError! {
    value: sys.get(name) ?? return Err(push_wire.PushError{reason: "{app_push_source(name, maker, argument)} is unset, so the app's push services can't start"})
    if value.trim() == "" {
        return Err(push_wire.PushError{reason: "{app_push_source(name, maker, argument)} is empty, so the app's push services can't start"})
    }
    Ok(value)
}

// The variable `name`, as the `argument` of `maker` names it, for a reason.
priv app_push_source: fn(name: String, maker: String, argument: String) -> String Never! {
    "`{name}` (`{maker}({argument}:)`)"
}

// Whether a device queues the writes it can't send, to send them once it
// reaches the server again (`.Queue`), or fails them (`.Off`).
#Equatable
Offline: enum {
    Off,
    Queue,
}

// One screen of the route set: the path its state's fields fill, the state's
// name, its `#App.Query` fields, whether only a signed-in caller opens it,
// and how it opens at an address (`App.__screen`).
AppScreen: struct {
    path: String,
    state: String,
    query: [String],
    signed_in: Bool,
    open: Shared<AppOpen>,
}

// How a screen opens at an address: from its fields' texts, the node tree
// of what its view shows, or None when they make no state.
AppOpen: struct {
    run: fn(App, [String:String]) -[Net, FS.Read]> UINode? Never!,
}

// How the replies of one type may be kept, as `.cache<V>(policy)` sets it.
// `.Private` is kept by no one: `Cache-Control: private, no-store`, as
// every `#App.SignedIn` reply is answered, whatever its type's policy.
// `.Public(max_age)` lets any cache keep an `#App.Public` reply for
// `max_age` (`Cache-Control: public, max-age=<seconds>`) and then
// revalidate it with its `ETag`: a GET whose `If-None-Match` names the
// reply's ETag is answered 304 with no body.
CachePolicy: enum {
    Private,
    Public(max_age: Duration),
}

// The cache policy of each reply type, by the name `__cache` was given.
priv APP_CACHE: Shared{[String:CachePolicy]{}}

// A page's metadata on the web output, as `.head(fn)` gives it for a
// screen's state: the page's title, the description and share image a search
// result or a shared link shows, whether the page names its own address as
// its canonical one, and whether search engines may index it. A screen only
// a signed-in caller opens is never indexed, whatever its head says.
Head: struct {
    title: String,
    description: String?{None},
    image: String?{None},
    canonical: Bool{true},
    index: Bool{true},
}

// A reply a store keeps for a `.Public` policy, as it finds it: the encoded
// reply and the milliseconds since it was kept, by the store's clock.
priv KeptReply: struct {
    reply: String,
    age_ms: Int,
}

// One store's kept replies, which core.db keeps in the table
// `__jet_kept_replies` of each database file and names as the file opens
// (`reply_cache.store`), so the servers of an App that share the file
// share them. A write any server commits to the file drops them all, as a
// kept reply may have read what it changed.
priv KeptReplies: struct {
    // Names the store among the open ones, as CallOutbox.store does.
    store: String,
    // The reply kept under a key while it is fresh by the store's clock:
    // through the instant its max_age ends, and not after it; None when
    // there is none, or the store couldn't read it.
    find: fn(String) -[]> KeptReply? Never!,
    // Keeps a reply under a key for a max_age in milliseconds, in place of
    // the one kept under it, and drops the stale ones; a reply whose run
    // began, the last milliseconds given ago, no later than a write the file
    // took is not kept, as it may hold what the write changed. False when
    // the store couldn't keep or judge it.
    keep: fn(String, String, Int, Int) -[]> Bool Never!,
}

// The stores named for kept replies, in the order they opened.
priv KEPT_REGISTRY: Shared{[Shared<KeptReplies>]{}}

// The writes committed to any store of this process (`reply_cache.written`).
priv KEPT_WRITES: Shared{0}

// The cache policies core.web answers endpoint replies under, and the
// replies the servers that share the App's database files keep under them.
// core.db names each database file as it opens (`store`). A reply is kept
// in the first named store that takes it, the App's first store still
// open, and found in any named store.
priv(package) reply_cache: module {
    // The policy `.cache<V>` set for the reply type named `reply`; None when
    // none was set.
    policy: fn(reply: String) -> CachePolicy? Never! {
        held: APP_CACHE.guard_read()
        found: held.value.get(reply) ?? return None
        Val(found.copy())
    }

    // Names a store; a store named again replaces the one of its name.
    store: fn(replies: ^^KeptReplies) Never! {
        registry := KEPT_REGISTRY.guard_edit()
        loop index in 0..<registry.value.len() {
            if kept_store_name(registry.value[index]) == replies.store {
                registry.value[index] = Shared{replies.move()}
                return
            }
        }
        registry.value.push(Shared{replies.move()})
    }

    // The fresh reply a named store keeps under `key`; None when none does.
    find: fn(key: String) -> KeptReply? Never! {
        loop replies in kept_stores() {
            held: replies.guard_read()
            if held.value.find(key.copy()) == .Val(found) -> return Val(found)
        }
        None
    }

    // Keeps `reply`, whose run began `ran_ms` ago, under `key` for
    // `max_age_ms` in the first named store that takes or judges it; false
    // when none does.
    keep: fn(key: String, reply: String, max_age_ms: Int, ran_ms: Int) -> Bool Never! {
        loop replies in kept_stores() {
            held: replies.guard_read()
            if held.value.keep(key.copy(), reply.copy(), max_age_ms, ran_ms) -> return true
        }
        false
    }

    // Counts a write committed to a store of this process (core.db). A reply
    // this process keeps for itself is fresh only while the count is the one
    // its run began at (`writes`).
    written: fn() Never! {
        held := KEPT_WRITES.guard_edit()
        held.value += 1
    }

    // The writes committed to the stores of this process so far.
    writes: fn() -> Int Never! {
        held: KEPT_WRITES.guard_read()
        held.value
    }
}

// The named stores, copied out so no store runs under the registry's lock.
priv kept_stores: fn() -> [Shared<KeptReplies>] Never! {
    registry: KEPT_REGISTRY.guard_read()
    registry.value.copy()
}

priv kept_store_name: fn(replies: Shared<KeptReplies>) -> String Never! {
    held: replies.guard_read()
    held.value.store.copy()
}

// A sitemap `.sitemap(list)` gave: the name of the state its list gives,
// and the address of each state the list gives when asked.
priv AppSitemap: struct {
    state: String,
    addresses: fn() -[]> [String] Never!,
}

// The sitemaps the graph gave, in the order it gave them.
priv APP_SITEMAPS: Shared{[Shared<AppSitemap>]{}}

// What core.web's `/sitemap.xml` and `/robots.txt` answer: the pages the
// sitemap lists, which are only ever pages a caller who is not signed in
// opens, and the screens a crawler is asked to leave, which are those only
// a signed-in caller opens.
priv(package) sitemap: module {
    // Whether the graph gave a sitemap.
    given: fn() -> Bool Never! {
        listed: APP_SITEMAPS.guard_read()
        listed.value.len() > 0
    }

    // The address of each state the sitemaps' lists give now, once each,
    // in the order given. A list whose state no screen opens, or whose
    // screen only a signed-in caller opens, gives none.
    addresses: fn() -> [String] Never! {
        found := [String]{}
        loop listed in app_sitemaps() {
            held: listed.guard_read()
            if !app_screen_public(held.value.state) -> next
            loop address in held.value.addresses() {
                if !found.contains(address) -> found.push(address)
            }
        }
        found
    }

    // The path of each screen only a signed-in caller opens, sorted, as a
    // robots.txt rule matches it: each `:name` segment is `*`, and `$` ends
    // the path, so a public page under it stays open to crawlers.
    signed_in_paths: fn() -> [String] Never! {
        held: APP_GRAPH.guard_read()
        paths := [String]{}
        loop screen in held.value.screens {
            if !screen.signed_in -> next
            segments := [String]{}
            loop segment in screen.path.split("/") {
                segments.push(if segment.starts_with(":") -> "*" else -> segment)
            }
            rule: "{segments.join("/")}$"
            if !paths.contains(rule) -> paths.push(rule)
        }
        paths.sort()
        paths
    }
}

// The sitemaps, copied out so no list runs under the lock.
priv app_sitemaps: fn() -> [Shared<AppSitemap>] Never! {
    listed: APP_SITEMAPS.guard_read()
    listed.value.copy()
}

// Whether a screen opens the state named `state` for a caller who is not
// signed in.
priv app_screen_public: fn(state: String) -> Bool Never! {
    screen: app_screen(state) ?? return false
    !screen.signed_in
}

// The head `.head(fn)` gave a screen's state: `run` gives the head of the
// state whose address has the field texts it is given, None when the texts
// make no such state.
priv AppHead: struct {
    run: fn(App, [String:String]) -[]> Head? Never!,
}

// The head of each screen's state, by the state's name.
priv APP_HEADS: Shared{[String:Shared<AppHead>]{}}

// What core.web's screen pages put in their `<head>`: the metadata the
// graph gave a state, and whether search engines may index its page.
priv(package) heads: module {
    // The head `.head(fn)` gives the state named `state` of `graph` at the
    // address whose field texts are `fields`, by field name; None when no
    // head was given for it or the texts make no such state.
    of: fn(graph: App, state: String, fields: [String:String]) -> Head? Never! {
        given: app_head(state) ?? return None
        held: given.guard_read()
        held.value.run(graph, fields)
    }

    // Whether search engines may index the page of the state named
    // `state`, whose head is `head`: never when only a signed-in caller
    // opens its screen, else as its head says, and yes with no head.
    indexed: fn(state: String, head: Head?) -> Bool Never! {
        if !app_screen_public(state) -> return false
        if head == .Val(given) -> return given.index
        true
    }
}

// The head given for the state named `state`, copied out so it runs with no
// lock held.
priv app_head: fn(state: String) -> Shared<AppHead>? Never! {
    held: APP_HEADS.guard_read()
    held.value.get(state)
}

// The states of a sitemap test's public guide screen and signed-in inbox.
priv SitemapTestGuide: struct {
    slug: String,
}

priv SitemapTestInbox: struct {
    box: String,
}

#Test("a sitemap lists each state its list gives whose screen opens without signing in, and robots leave each signed-in screen") {
    graph: new("Crew").__screen<SitemapTestGuide>("/guides/:slug", "app.SitemapTestGuide", [String]{}, false, fn(_: App, _: [String:String]) { UINode?{None} }).__screen<SitemapTestInbox>("/inbox/:box", "app.SitemapTestInbox", [String]{}, true, fn(_: App, _: [String:String]) { UINode?{None} })
    _: graph.__sitemap<SitemapTestGuide>(
        "app.SitemapTestGuide",
        [String]{"slug"},
        fn() { [SitemapTestGuide]{SitemapTestGuide{slug: "start here"}, SitemapTestGuide{slug: "faq"}, SitemapTestGuide{slug: "faq"}} },
        fn(on: App, guide: SitemapTestGuide) { [String]{on.__address_text<String>(guide.slug)} },
    )
    _: graph.__sitemap<SitemapTestInbox>(
        "app.SitemapTestInbox",
        [String]{"box"},
        fn() { [SitemapTestInbox]{SitemapTestInbox{box: "mine"}} },
        fn(on: App, inbox: SitemapTestInbox) { [String]{on.__address_text<String>(inbox.box)} },
    )
    // A list whose state no screen opens yet gives no address.
    _: graph.__sitemap<SitemapTestGuide>(
        "app.SitemapTestNowhere",
        [String]{"slug"},
        fn() { [SitemapTestGuide]{SitemapTestGuide{slug: "lost"}} },
        fn(on: App, guide: SitemapTestGuide) { [String]{on.__address_text<String>(guide.slug)} },
    )
    assert(sitemap.given())
    assert_eq(sitemap.addresses().join(" "), "/guides/start%20here /guides/faq")
    paths: sitemap.signed_in_paths()
    assert(paths.contains("/inbox/*$"))
    assert(!paths.contains("/guides/*$"))
}

// The states of the head test's public guide screen and signed-in inbox.
priv HeadTestGuide: struct {
    slug: String,
}

priv HeadTestInbox: struct {
    box: String,
}

// The guide and the inbox at an address, as the compiler lowers their
// decoding from its field texts.
priv head_test_guide: fn(_: App, fields: [String:String]) -> HeadTestGuide? Never! {
    slug: fields.get("slug") ?? return None
    Val(HeadTestGuide{slug: slug})
}

priv head_test_inbox: fn(_: App, fields: [String:String]) -> HeadTestInbox? Never! {
    box: fields.get("box") ?? return None
    Val(HeadTestInbox{box: box})
}

#Test("a screen's head is the last `.head` given for its state, and only a public screen whose head allows it is indexed") {
    graph: new("Crew").__screen<HeadTestGuide>("/help/:slug", "app.HeadTestGuide", [String]{}, false, fn(_: App, _: [String:String]) { UINode?{None} }).__screen<HeadTestInbox>("/mail/:box", "app.HeadTestInbox", [String]{}, true, fn(_: App, _: [String:String]) { UINode?{None} })
    faq_fields: [String:String]{"slug": "faq"}
    assert(heads.of(graph, "app.HeadTestGuide", faq_fields) == None)
    assert(heads.indexed("app.HeadTestGuide", None))
    _: graph.__head<HeadTestGuide>("app.HeadTestGuide", head_test_guide, fn(guide: HeadTestGuide) { Head{title: "old {guide.slug}"} })
    _: graph.__head<HeadTestGuide>("app.HeadTestGuide", head_test_guide, fn(guide: HeadTestGuide) { Head{title: "Help: {guide.slug}", description: Val("Answers about {guide.slug}"), index: guide.slug != "draft"} })
    _: graph.__head<HeadTestInbox>("app.HeadTestInbox", head_test_inbox, fn(inbox: HeadTestInbox) { Head{title: "Mail: {inbox.box}"} })
    faq: heads.of(graph, "app.HeadTestGuide", faq_fields) ?? panic("the guide has a head")
    assert_eq(faq.title, "Help: faq")
    assert_eq(faq.description, Val("Answers about faq"))
    assert_eq(faq.image, String?{None})
    assert(faq.canonical)
    assert(heads.indexed("app.HeadTestGuide", Val(faq)))
    draft: heads.of(graph, "app.HeadTestGuide", [String:String]{"slug": "draft"}) ?? panic("the draft has a head")
    assert(!heads.indexed("app.HeadTestGuide", Val(draft)))
    // Texts that make no guide give no head.
    assert(heads.of(graph, "app.HeadTestGuide", [String:String]{"box": "mine"}) == None)
    // A signed-in screen is never indexed, whatever its head says.
    mine: heads.of(graph, "app.HeadTestInbox", [String:String]{"box": "mine"}) ?? panic("the inbox has a head")
    assert_eq(mine.title, "Mail: mine")
    assert(mine.index)
    assert(!heads.indexed("app.HeadTestInbox", Val(mine)))
    assert(!heads.indexed("app.HeadTestNowhere", None))
}

#Test("a reply type's cache policy is the last `.cache` set for it") {
    assert(reply_cache.policy("app.CacheTestView") == None)
    graph: new("Crew").__cache<RouteTestBoard>("app.CacheTestView", CachePolicy.Public{max_age: 10min})
    assert_eq(graph.title, "Crew")
    if reply_cache.policy("app.CacheTestView") == .Val(.Public(max_age)) -> assert(max_age == 10min) else {
        panic("the public policy was not kept")
    }
    _: graph.__cache<RouteTestBoard>("app.CacheTestView", CachePolicy.Private)
    assert(reply_cache.policy("app.CacheTestView") == .Val(.Private))
}

#Test("a kept reply goes to the first named store that takes it, is found in any, and each committed write is counted") {
    refusing: KeptReplies{store: "app.Test refusing replies", find: fn(_: String) { KeptReply?{None} }, keep: fn(_: String, _: String, _: Int, _: Int) { false }}
    held: Shared{[String:String]{}}
    kept: held.copy()
    found: held.copy()
    taking: KeptReplies{
        store: "app.Test kept replies",
        find: fn(key: String) {
            seen: found.guard_read()
            reply: seen.value.get(key) ?? return KeptReply?{None}
            Val(KeptReply{reply: reply.copy(), age_ms: 0})
        },
        keep: fn(key: String, reply: String, _: Int, _: Int) {
            guard := kept.guard_edit()
            guard.value[key] = reply
            true
        },
    }
    reply_cache.store(refusing)
    reply_cache.store(taking)
    assert(reply_cache.find("/api/board [1]") == None)
    assert(reply_cache.keep("/api/board [1]", "{{\"ok\":false}}", 1000, 0))
    assert_eq((reply_cache.find("/api/board [1]") ?? panic("the reply was not kept")).reply, "{{\"ok\":false}}")
    assert(reply_cache.find("/api/board [2]") == None)
    before: reply_cache.writes()
    reply_cache.written()
    assert(reply_cache.writes() > before)
}

// How many times the resume test's source ran.
priv ResumeTestRuns: struct {
    runs: Int,
}

priv RESUME_TEST_RUNS: Shared{ResumeTestRuns{runs: 0}}

// The resume test's source: 7 squared, each run counted.
priv resume_test_square: fn() -> Int AppError! {
    held := RESUME_TEST_RUNS.guard_edit()
    held.value.runs += 1
    Ok(49)
}

priv resume_test_runs: fn() -> Int Never! {
    held: RESUME_TEST_RUNS.guard_read()
    held.value.runs
}

// The resume test's view: one read, drawn in each of its states.
priv resume_test_view: fn() -> String Never! {
    binding: __live_bind<Int, AppError>("app.resume_test_square", [String]{"7"}, fn() { resume_test_square() })
    if state(binding) == {
        .Loaded(value) -> "<p>{value}</p>"
        .Failed(_) -> "<p>failed</p>"
        .Idle | .Loading -> "<p>loading</p>"
    }
}

#Test("a page carries the reads its view made, and a client that resumes the page reads them without running their source") {
    page: resume.render(fn() { resume_test_view() })
    assert_eq(resume_test_runs(), 1)
    assert_eq(page, "<p>49</p><script type=\"application/json\" id=\"jet-resume\">[{{\"source\":\"app.resume_test_square\",\"key\":\"[7]\",\"value\":\"ok:49\"}}]</script>")
    ann: auth.AccountID.from_string("ann")
    assert_eq(as_caller(ann, fn() { resume.seed(page) }), 1)
    assert_eq(as_caller(ann, fn() { resume_test_view() }), "<p>49</p>")
    assert_eq(resume_test_runs(), 1)
    // A client that resumed no page runs the read itself.
    ben: auth.AccountID.from_string("ben")
    assert_eq(as_caller(ben, fn() { resume_test_view() }), "<p>49</p>")
    assert_eq(resume_test_runs(), 2)
    // A read a write made stale before the page was sent is left out, so
    // the client runs it itself.
    stale: resume.render(fn() {
        shown: resume_test_view()
        __live_invalidate("app.resume_test_square", [String]{"7"})
        shown
    })
    assert_eq(stale, "<p>49</p>{RESUME_OPEN}[]</script>")
    assert_eq(resume_test_runs(), 2)
    // A page whose view reads nothing carries an empty list, and a page
    // without a resume script seeds nothing.
    assert_eq(resume.render(fn() { "<p>still</p>" }), "<p>still</p>{RESUME_OPEN}[]</script>")
    assert_eq(resume.seed("<p>49</p>"), 0)
}

// A service a graph declares (`.api<S>`): where its clients post its calls,
// and the most bytes one call's body holds.
priv AppAPI: struct {
    path: String,
    max_upload: Int,
}

// An endpoint method of a service the graph mounts: how it answers a call
// from its decoded arguments, or None for a method only a signed-in caller
// calls.
priv AppEndpoint: struct {
    answer: Shared<AppAnswer>?,
}

priv AppAnswer: struct {
    run: fn(RemoteArgs) -> String [FieldError]!,
}

// The screen open now (`App.__go`): its state's name and its address's
// field texts, by field name. The not-found state (`App.open_link`) has no
// state name and keeps the link it shows under C_APP_LOST_LINK.
priv AppCurrent: struct {
    state: String,
    fields: [String:String],
}

// How a browser installs the app (`App.installable`): the name an installed
// app shows, the path of its icon (a PNG or JPEG, relative to the working
// directory like every app path) and its color as 0xRRGGBB.
AppInstall: struct {
    name: String,
    icon: String,
    color: Int,
}

// The process's app graph: its title, its services by the name of each
// (`.api`), the endpoints of the services it mounts by `{service}/{method}`,
// its screens in the order it adds them, its offline mode, how a browser
// installs it, the screen open now and that screen's route data: the ids of
// the live bindings its view read, the link schemes and web domains whose
// links open its screens (`.url_scheme`, `.app_links`), the activation
// tokens of the later launches that handed it their links (`.launch`), its
// background work (`.background`), its tray (`.tray`), its window
// (`.window`), the window's menu bar (`.menu_bar`), its push services
// (`.push`) and its native sessions' lifetimes (`.sessions`).
priv AppGraph: struct {
    title: String,
    apis: [String:AppAPI],
    endpoints: [String:AppEndpoint],
    screens: [AppScreen],
    offline: Offline,
    install: AppInstall?,
    current: AppCurrent?,
    route_data: [Int],
    schemes: [String],
    link_domains: [String],
    activations: [String],
    backgrounds: [AppBackground],
    tray: AppTray?,
    window: AppWindow?,
    menu_bar: Shared<AppMenuBar>?,
    push: AppPush?,
    sessions: AppSessions?,
}

priv APP_GRAPH: Shared{AppGraph{title: "", apis: [String:AppAPI]{}, endpoints: [String:AppEndpoint]{}, screens: [AppScreen]{}, offline: .Off, install: None, current: None, route_data: [Int]{}, schemes: [String]{}, link_domains: [String]{}, activations: [String]{}, backgrounds: [AppBackground]{}, tray: None, window: None, menu_bar: None, push: None, sessions: None}}

// One piece of a graph's background work (`App.background`): it runs every
// `every_ns` nanoseconds while the app runs, and at login when `at_login`.
priv AppBackground: struct {
    every_ns: Int,
    at_login: Bool,
    run: Shared<AppBackgroundRun>,
}

priv AppBackgroundRun: struct {
    run: fn() Notice!,
}

// A graph's tray (`App.tray`): its icon's name in the desktop's icon theme
// and what makes its menu.
priv AppTray: struct {
    icon: String,
    menu: Shared<AppTrayMenu>,
}

priv AppTrayMenu: struct {
    menu: fn() -> [MenuItem] Notice!,
}

// What a graph runs each time the app comes back (`App.lifecycle`), which
// its lifecycle listener hands each resume's task.
priv AppResume: struct {
    run: fn() Notice!,
}

// A graph's window (`App.window`): its size in logical pixels.
priv AppWindow: struct {
    width: Int,
    height: Int,
}

// A graph's menu bar (`App.menu_bar`): what makes its menus.
priv AppMenuBar: struct {
    menus: fn() -> [Menu] Notice!,
}

// A menu of the app window's menu bar (`App.menu_bar`): its title and its
// items. `menu` makes one; `edit_menu` and `window_menu` make the usual
// ones.
Menu: struct {
    title: String,
    items: [MenuItem],
}

// One entry of a menu the app shows, its tray's (`App.tray`) or its menu
// bar's (`App.menu_bar`): an item the person chooses to run it, a
// separator line, the item that quits the app, a notice that shows but
// can't be chosen, or an item of the Edit or Window menu, which acts on
// the window. `key` is its key equivalent, "" for none (`item`), and an
// item that is not `enabled` shows but can't be chosen. `item`,
// `separator`, `quit_item`, `edit_menu` and `window_menu` make them.
MenuItem: struct {
    label: String,
    kind: MenuItemKind,
    key: String,
    enabled: Bool,
    priv run: Shared<AppMenuRun>,
}

MenuItemKind: enum {
    Item,
    Separator,
    Quit,
    Notice,
    Cut,
    Copy,
    Paste,
    Minimize,
}

priv AppMenuRun: struct {
    run: fn() Notice!,
}

// An item labeled `label` that runs `run` when the person chooses it. Its
// key equivalent `key` is modifiers among Cmd, Ctrl, Alt, Shift and Super
// and then a key, joined by `+` (`Cmd+Shift+E`); Cmd is the platform's
// command key, Control on Linux. An item that is not `enabled` shows but
// can't be chosen. A run that fails puts its notice in the app's notice
// list (`notices`). Panics on a key equivalent it can't read.
item: fn(label: String, run: ^^fn() Notice!, key: String{""}, enabled: Bool{true}) -> MenuItem Never! {
    _: app_menu_shortcut(key)
    MenuItem{label: label, kind: .Item, key: key, enabled: enabled, run: Shared{AppMenuRun{run: run.move()}}}
}

// A separator line between items.
separator: fn() -> MenuItem Never! { app_menu_entry("", .Separator, "") }

// The item that quits the app (Cmd+Q).
quit_item: fn() -> MenuItem Never! { app_menu_entry("Quit", .Quit, "Cmd+Q") }

// The menu titled `title` with the items `items`.
menu: fn(title: String, items: [MenuItem]) -> Menu Never! { Menu{title: title, items: items} }

// The Edit menu: Cut (Cmd+X), Copy (Cmd+C) and Paste (Cmd+V), on the text
// input the window's focus is on, through the clipboard. Cut and Copy take
// its whole text.
edit_menu: fn() -> Menu Never! {
    Menu{title: "Edit", items: [MenuItem]{app_menu_entry("Cut", .Cut, "Cmd+X"), app_menu_entry("Copy", .Copy, "Cmd+C"), app_menu_entry("Paste", .Paste, "Cmd+V")}}
}

// The Window menu: Minimize (Cmd+M), and Close (Cmd+W), which ends the app
// as closing the window does.
window_menu: fn() -> Menu Never! {
    Menu{title: "Window", items: [MenuItem]{app_menu_entry("Minimize", .Minimize, "Cmd+M"), app_menu_entry("Close", .Quit, "Cmd+W")}}
}

// An enabled entry of the kind `kind` with nothing of its own to run.
priv app_menu_entry: fn(label: String, kind: MenuItemKind, key: String) -> MenuItem Never! {
    MenuItem{label: label, kind: kind, key: key, enabled: true, run: Shared{AppMenuRun{run: app_menu_nothing}}}
}

// The shortcut the key equivalent `key` names (`item`), None for "".
// Panics on one it can't read.
priv app_menu_shortcut: fn(key: String) -> UIShortcut? Never! {
    if key == "" -> return None
    parts: key.split("+").to_list()
    last: parts.len() - 1
    name: parts[last].to_ascii_lower()
    if name == "" {
        panic("a menu item's key equivalent ends with a key, like Cmd+Shift+E, not {key}")
    }
    bits := 0
    loop at in 0..<last {
        part: parts[at]
        bit: if part == {
            "Cmd" -> 16
            "Ctrl" -> 1
            "Alt" -> 2
            "Shift" -> 4
            "Super" -> 8
            else -> panic("a menu item's key equivalent has modifiers among Cmd, Ctrl, Alt, Shift and Super, not {part} in {key}")
        }
        if bits & bit == 0 -> bits += bit
    }
    Val(UIShortcut{key: name, modifiers: UIShortcutModifiers{bits: bits}})
}

// The keys of the key equivalent `key` as dbusmenu names them: Control,
// Alt, Shift and Super, then the key; Cmd is Control.
priv app_menu_key_names: fn(key: String) -> [String] Never! {
    shortcut: app_menu_shortcut(key) ?? return [String]{}
    bits: shortcut.modifiers.bits
    names := [String]{}
    if bits & 17 != 0 -> names.push("Control")
    if bits & 2 != 0 -> names.push("Alt")
    if bits & 4 != 0 -> names.push("Shift")
    if bits & 8 != 0 -> names.push("Super")
    names.push(shortcut.key)
    names
}

// The most bytes one call's body to the service `service` (its key) may
// hold, when the app graph's `.api<S>(path, max_upload:)` names it.
priv __api_max_upload: fn(service: String) -> Int? Never! {
    held: APP_GRAPH.guard_read()
    api: held.value.apis.get(service) ?? return None
    Val(api.max_upload)
}

// Makes the screen of `state`, at the address of the field texts `fields`,
// the current one, and gives the graph.
priv app_graph_open: fn(state: String, fields: [String:String]) -> App Never! {
    held := APP_GRAPH.guard_edit()
    held.value.current = Val(AppCurrent{state: state, fields: fields})
    App{title: held.value.title.copy()}
}

// Makes the bindings `reads` the route data of the screen open now and
// gives the ones the screen before it read that this one does not, which
// no open screen holds any more. A binding is keyed by its source and
// arguments (live_register), so route data is keyed by the route's
// arguments; a write that meets a binding's read set makes it stale, and
// the screen's next read runs its source again (`state`).
priv app_graph_route_data: fn(reads: [Int]) -> [Int] Never! {
    held := APP_GRAPH.guard_edit()
    left := [Int]{}
    loop id in held.value.route_data {
        if !reads.contains(id) -> left.push(id)
    }
    held.value.route_data = reads
    left
}

// The screen open now (`App.__go`); None before one opens.
priv app_graph_current: fn() -> AppCurrent? Never! {
    held: APP_GRAPH.guard_read()
    held.value.current.copy()
}

priv app_graph_title: fn() -> String Never! {
    held: APP_GRAPH.guard_read()
    held.value.title.copy()
}

// The screen of the graph whose state `state` names.
priv app_screen: fn(state: String) -> AppScreen? Never! {
    held: APP_GRAPH.guard_read()
    loop screen in held.value.screens {
        if screen.state == state -> return Val(screen.copy())
    }
    None
}

// The field the not-found state keeps its link under (`App.lost_link`).
priv C_APP_LOST_LINK: "link"

// Makes the not-found state that shows `link` the open one: no screen is,
// and the bindings the screen before it read are dropped. False, for
// `App.open_link`: no screen opened.
priv app_link_lost: fn(link: String) -> Bool Never! {
    fields := [String:String]{}
    fields[C_APP_LOST_LINK] = link.copy()
    _: app_graph_open("", fields)
    live_drop(app_graph_route_data([Int]{}))
    false
}

// The link schemes of the graph (`App.url_scheme`), in the order it gives
// them.
priv app_graph_schemes: fn() -> [String] Never! {
    held: APP_GRAPH.guard_read()
    held.value.schemes.copy()
}

// Whether `scheme` is a link scheme (RFC 3986 section 3.1) in lowercase: a
// letter, then letters, digits, `+`, `-` or `.`.
priv app_link_scheme_valid: fn(scheme: String) -> Bool Never! {
    if scheme == "" -> return false
    letters: "abcdefghijklmnopqrstuvwxyz"
    first := true
    loop scalar in unicode.scalars(scheme) {
        if !letters.contains(scalar) && (first || !"0123456789+-.".contains(scalar)) -> return false
        first = false
    }
    true
}

// The address a link names, its path and query without its fragment: an
// address itself, a link of one of the graph's schemes (`crewboard://tasks/7`,
// `crewboard:tasks/7` and `crewboard:///tasks/7` all name `/tasks/7`), or an
// `https` link of one of its domains, with or without a port. None for any
// other link.
priv app_link_address: fn(link: String) -> String? Never! {
    rest := link.copy()
    hash: rest.find("#")
    if hash >= 0 -> rest = rest.slice(0, hash)
    if rest.starts_with("/") && app_link_authority(rest) == None -> return Val(rest)
    colon: rest.find(":")
    if colon <= 0 -> return None
    scheme: rest.slice(0, colon).lower()
    after: rest.slice(colon + 1, rest.len())
    held: APP_GRAPH.guard_read()
    if held.value.schemes.contains(scheme) {
        tail: app_link_authority(after) ?? after
        if tail.starts_with("/") -> return Val(tail)
        return Val("/{tail}")
    }
    if scheme != "https" -> return None
    authority := app_link_authority(after) ?? return None
    path := "/"
    loop index in 0..<authority.len() {
        mark: authority.slice(index, index + 1)
        if mark != "/" && mark != "?" -> next
        path = if mark == "/" -> authority.slice(index, authority.len()) else -> "/{authority.slice(index, authority.len())}"
        authority = authority.slice(0, index)
        break
    }
    if authority.contains("@") -> return None
    host := authority.lower()
    port: host.find(":")
    if port >= 0 -> host = host.slice(0, port)
    if !held.value.link_domains.contains(host) -> return None
    Val(path)
}

// What follows the two slashes that open a link's authority (RFC 3986
// section 3.2) at the start of `text`; None when `text` doesn't start with
// them.
priv app_link_authority: fn(text: String) -> String? Never! {
    if !text.starts_with("/") -> return None
    tail: text.slice(1, text.len())
    if !tail.starts_with("/") -> return None
    Val(tail.slice(1, tail.len()))
}

// The field texts of `screen`'s state at the address whose path is `path`
// and whose query is `query`: each `:name` segment's text and each
// `#App.Query` field's query value, percent-decoded. None when the path
// doesn't fit the screen's, segment by segment, as a server's route table
// matches it, or a text is not percent-encoded right.
priv app_link_fields: fn(screen: AppScreen, path: String, query: String) -> [String:String]? Never! {
    want: screen.path.split("/").to_list()
    have: path.split("/").to_list()
    if want.len() != have.len() -> return None
    fields := [String:String]{}
    loop index in 0..<want.len() {
        if !want[index].starts_with(":") {
            if want[index] != have[index] -> return None
            next
        }
        if have[index] == "" -> return None
        fields[want[index].removeprefix(":")] = url.percent_decode(have[index]) ?? return None
    }
    if query == "" || screen.query.len() == 0 -> return Val(fields)
    pairs: url.parse_qsl(query) ?? return None
    loop pair in pairs {
        if pair.len() == 2 && screen.query.contains(pair[0]) {
            fields[pair[0].copy()] = pair[1].copy()
        }
    }
    Val(fields)
}

// Installs the app's desktop entry (`App.desktop_entry`) as
// `{data}/applications/{id}.desktop`, where `id` is the app's title in
// lowercase letters and digits joined by `-` (`app_desktop_id`), and makes
// it the default handler of each of the graph's link schemes in
// `{config}/mimeapps.list` (`app_mimeapps_with`), as `App.launch` says.
// Without a home directory or an XDG directory there is nowhere to install
// it; a file that can't be written leaves the links unregistered, and the
// app runs as it would without them.
priv app_link_register: fn(title: String) -[Env, FS.Read, FS.Write]> Never! {
    home: sys.home_dir() ?? ""
    data: app_xdg_dir("XDG_DATA_HOME", home, ".local/share") ?? return
    config: app_xdg_dir("XDG_CONFIG_HOME", home, ".config") ?? return
    id: "{app_desktop_id(title)}.desktop"
    files.create_dir_all("{data}/applications") ?? return
    files.write("{data}/applications/{id}", App{title: title}.desktop_entry(sys.executable())) ?? return
    files.create_dir_all(config) ?? return
    list: "{config}/mimeapps.list"
    kept: if files.exists(list) -> files.read(list) ?? return else -> ""
    files.write(list, app_mimeapps_with(kept, app_graph_schemes(), id)) ?? return
}

// How long a launch and the running copy of the app wait for each other's
// next text (`App.launch`).
C_APP_HANDOFF_WAIT_NS: 5000000000

// `App.launch` on a desktop: hands the launch's link to the running copy
// and is false, or becomes that copy, starts its run and opens its window.
priv app_launch_desktop: fn(graph: App) -[Env, Exec.Args, Exec.Exit, FS.Read, FS.Write, Net, Time]> Bool Never! {
    link := ""
    loop given in process.args() {
        if app_link_address(given) == None -> next
        link = given.copy()
        break
    }
    socket: "{app_runtime_dir()}/{app_desktop_id(graph.title)}.link"
    token: sys.get("XDG_ACTIVATION_TOKEN") ?? sys.get("DESKTOP_STARTUP_ID") ?? ""
    if app_launch_hand(socket, link, token) -> return false
    if app_graph_schemes().len() > 0 -> app_link_register(graph.title)
    app_launch_listen(App{title: graph.title.copy()}, socket)
    app_background_start(graph.title)
    app_tray_start(graph.title)
    app_lifecycle_start(app_graph_window() != None)
    app_sleep_start()
    if link != "" -> _: graph.open_link(link) else if app_graph_window() != None {
        _: graph.open_link("/")
    }
    app_window_start(graph.title)
    true
}

// `App.launch` in a page: starts the app's run, its visibility unknown
// until the page says, and has the page tell it each change of its
// lifecycle (`app_page_moments`). A graph with screens opens the page's
// address, unless a screen is open already, draws that screen into the
// page, and has the page run its draw hook after each of its turns
// (`app_page_redraw`).
priv app_launch_page: fn(graph: App) -[Browser, FS.Read, Net, Time]> Bool Never! {
    app_lifecycle_start(true)
    hook: ui.button("", fn() { app_page_moments() })
    _: ui_rt.device(WEB_DEVICE_LIFECYCLE, "{hook.__click_slot()}")
    app_page_moments()
    if graph.__screens().len() == 0 -> return true
    draw: ui.button("", fn() { app_page_redraw() })
    address: ui_rt.device(WEB_DEVICE_DRAW, "{draw.__click_slot()}") ?? "/"
    if app_graph_current() == None -> _: graph.open_link(address)
    app_page_redraw()
    true
}

// The page's draw hook, which the page runs after each of its turns (and
// `app_launch_page` once): when another screen opened since the page last
// drew, or a live binding of the screen it shows changed
// (`app_window_wake`), it opens the screen again as a window's frame does
// (`app_window_tree`) and lays it out within the graph's window size, else
// a desktop's (`ui.desktop`); the page then shows what it painted.
priv app_page_redraw: fn() -[Browser, FS.Read, Net]> Never! {
    now: app_graph_current()
    if !app_page_due(now) {
        return
    }
    tree: app_window_tree(now)
    desktop: ui.desktop()
    size: app_graph_window() ?? AppWindow{width: desktop.width, height: desktop.height}
    ui.null_backend().mount(tree, ui.constraint(0.0, 0.0, Float{size.width}, Float{size.height}))
}

// Whether the page's draw is due for the screen `now` (`app_page_redraw`),
// which it then takes as drawn. From the first call on, a change to the
// data the screen shows marks it due (`app_window_wake`).
priv app_page_due: fn(now: AppCurrent?) -> Bool Never! {
    held := APP_WINDOW_WAKE.guard_edit()
    held.value.page = true
    saved_ver: ui.saved_version()
    if !held.value.stale && held.value.drawn == now && held.value.saved_version == saved_ver -> return false
    held.value.stale = false
    held.value.drawn = now.copy()
    held.value.saved_version = saved_ver
    true
}

// Takes the moments of the page's lifecycle the page holds for the app,
// oldest first, each one observed (`app_moment`): the page shown or
// hidden, its window taking or losing the focus, the page frozen or
// resumed, and the page going away.
priv app_page_moments: fn() -[Net, Time]> Never! {
    loop {
        said: ui_rt.device(WEB_DEVICE_MOMENT, "") ?? return
        moment: if said == {
            "visible" -> AppMoment.Shown(.Visible)
            "hidden" -> AppMoment.Shown(.Hidden)
            "focus" -> AppMoment.Foreground
            "blur" -> AppMoment.Background
            "freeze" -> AppMoment.Suspend
            "resume" -> AppMoment.Wake
            "gone" -> AppMoment.Closed
            else -> next
        }
        app_moment(moment)
    }
}

// The directory of the app's link socket (`App.launch`): `$XDG_RUNTIME_DIR`
// when it is an absolute path, else the temporary directory.
priv app_runtime_dir: fn() -[Env]> String Never! {
    if sys.get("XDG_RUNTIME_DIR") == .Val(dir) && dir.starts_with("/") -> return dir
    sys.temp_dir()
}

// Hands `link` and `token` to the running copy of the app that listens at
// `socket` (`App.launch`), as one JSON line `[link, token]`, and waits for
// it to take them. True once they are sent; false when no copy listens.
priv app_launch_hand: fn(socket: String, link: String, token: String) -[Net, Time.Wait]> Bool Never! {
    stream := net.unix_connect(socket) ?? return false
    message: live_json.to_string<[String]>([String]{link, token}) ?? return false
    net.unix_write(stream, "{message}\n") ?? return false
    _: app_launch_line(stream)
    net.unix_close(stream) ?? return true
    true
}

// Makes this process the running copy of the app that `graph` is
// (`App.launch`), listening at `socket`; listening replaces a socket left
// there, which is stale: a launch that could not hand it a link found no
// copy behind it. For each later launch, a task opens the link the launch
// hands over (`open_link`) and keeps its activation token, then answers
// `ok`. When nothing can listen at `socket`, the app runs without taking
// later launches.
priv app_launch_listen: fn(graph: App, socket: String) -[FS.Read, Net, Time.Wait]> Never! {
    listener: net.unix_listen(socket) ?? return
    serving: task { app_launch_serve(graph, listener) }
    serving.detach()
}

// Takes each later launch that connects to `listener` (`App.launch`): opens
// the link it hands over and keeps its activation token, then answers `ok`.
priv app_launch_serve: fn(graph: App, listener: UnixListener) -[Net, FS.Read, Time.Wait]> Never! {
    loop {
        peer := net.unix_accept(listener) ?? return
        given: live_json.decode<[String]>(app_launch_line(peer)) ?? [String]{}
        if given.len() == 2 {
            if given[0] != "" -> _: graph.open_link(given[0])
            held := APP_GRAPH.guard_edit()
            held.value.activations.push(given[1].copy())
        }
        net.unix_write(peer, "ok\n") ?? next
        net.unix_close(peer) ?? next
    }
}

// The next line `stream` gives, without its end; what came when it ends or
// goes quiet first.
priv app_launch_line: fn(stream: ^UnixStream) -[Net, Time.Wait]> String Never! {
    text := ""
    loop !text.contains("\n") {
        if !(net.unix_wait(stream, C_APP_HANDOFF_WAIT_NS) ?? false) -> break
        part: net.unix_read(stream) ?? break
        if part == "" -> break
        text = "{text}{part}"
    }
    text.removesuffix("\n")
}

// Starts the graph's background work (`App.background`) as this process
// becomes the app's running copy (`App.launch`): a task for each piece
// runs it on its timer. The app's autostart entry is installed when a
// piece asks to run at login, and removed otherwise.
priv app_background_start: fn(title: String) -[Env, FS.Read, FS.Write, Time.Wait]> Never! {
    at_login := false
    loop work in app_graph_backgrounds() {
        if work.at_login -> at_login = true
        runner: task { app_background_run(work.every_ns, work.run) }
        runner.detach()
    }
    app_autostart(title, at_login)
}

priv app_graph_backgrounds: fn() -> [AppBackground] Never! {
    held: APP_GRAPH.guard_read()
    held.value.backgrounds.copy()
}

// Runs one piece of background work every `every_ns` nanoseconds, the
// first time one interval after it starts; a failed run's notice joins the
// app's notice list (`__keep_notice`).
priv app_background_run: fn(every_ns: Int, work: Shared<AppBackgroundRun>) -[Time.Wait]> Never! {
    every_ms: if every_ns < 1000000 -> 1 else -> every_ns /% 1000000
    loop {
        time.sleep(time.duration_ms(every_ms))
        held: work.guard_read()
        app_background_once(held.value.run)
    }
}

priv app_background_once: fn(run: fn() Notice!) Never! {
    if run() == .Err(notice) -> __keep_notice(notice)
}

// What the app last observed of itself (`phase`). `instance` numbers the
// app's run, from 1 at the process's first `launch`; `sequence` counts the
// run's observations, from 0 at its start; `visibility` gathers the app's
// windows and `execution` follows the machine's sleep. It is the latest
// observation published, not a promise about now: a platform may hide,
// freeze or end the app with no word first, so an app saves its changes as
// they happen, never only when it hears it is going.
Phase: struct {
    instance: Int,
    sequence: Int,
    visibility: Visibility,
    execution: Execution,
}

// Whether the app shows (`Phase.visibility`): `Visible` when the
// compositor shows a window the app owns (mapped, not minimized, not
// suspended), `Hidden` when it shows none, or the app has no window, and
// `Unknown` before its window's first frame and when no window that
// shows can tell (minimized on a compositor that never says when it comes
// back). Focus never decides it, and the platform doesn't say when another
// window covers one.
Visibility: enum {
    Visible,
    Hidden,
    Unknown,
}

// Whether the app runs (`Phase.execution`): `Suspending` from the machine
// saying it prepares to sleep until it says it woke, which doesn't mean the
// process is frozen yet, and `Unknown` where nothing says.
Execution: enum {
    Running,
    Suspending,
    Unknown,
}

// Why the app's phase moved (`LifecycleEvent`): its visibility changed,
// the machine prepares to sleep or woke, its window took the focus again
// after it lost it or after the app was asleep, or its window closed,
// which ends the app. A focus regained and a wake are each heard, even
// when the phase stays the same.
LifecycleReason: enum {
    VisibilityChanged,
    SleepPreparing,
    Woke,
    FocusRegained,
    Closing,
}

// One observation of the app's run (`LIFECYCLE`): the run's `instance`, the
// observation's `sequence` in it, why the app's phase moved, and the phase
// before and after it.
LifecycleEvent: struct {
    instance: Int,
    sequence: Int,
    reason: LifecycleReason,
    before: Phase,
    after: Phase,
}

// The app's lifecycle, from `launch` on: on a Linux desktop its window is
// shown or hidden (the compositor's configure and the window's
// `minimize`), takes the focus again, or closes, and the machine prepares
// to sleep or wakes (logind's PrepareForSleep on the system bus). In a
// page the document is shown or hidden (`visibilitychange`), the page's
// window takes the focus again, the browser freezes the page or resumes
// it (the Page Lifecycle API's `freeze` and `resume`, and a page kept in
// the back-forward cache), and the page goes away (`pagehide`), which
// ends the app as a closed window does. Each
// listener (`.on(scope, handler)`) hears the observations one at a time,
// in the order they arrived, never two at once; `phase` gives each one's
// `after` before its listeners hear it, and an observation made while
// they listen, their own included, waits its turn. An observation that
// leaves the phase as it was, other than a focus regained or a wake, is
// not heard. The app hears nothing once its window closed, and no
// platform promises a last word before it ends.
LIFECYCLE: event.new<LifecycleEvent>()

// The app's phase: the latest observation of its run its lifecycle's
// listeners hear (`LIFECYCLE`), from `launch` on; `None` before `launch`
// and once the app's window closed.
phase: fn() -> Phase? Never! {
    held: APP_LIFECYCLE.guard_read()
    held.value.published.copy()
}

// The moments the runtime observes while the app runs: its window took or
// lost the focus, the machine prepares to sleep or woke, the compositor
// showed or hid the window, and the window closed.
priv AppMoment: enum {
    Foreground,
    Background,
    Suspend,
    Wake,
    Shown(Visibility),
    Closed,
}

// The app's lifecycle (`LIFECYCLE`, `phase`): the runs `launch` started;
// the run's latest observation (`observed`, `None` before `launch` and once
// the window closed); the phase its listeners heard last (`published`);
// the observations waiting for them, oldest first; whether a task is
// handing them out; whether the app has been away, in the background or
// asleep, and its window without the focus, since it last came back;
// whether the observation the listeners hear now brings it back
// (`app_lifecycle_resuming`); and the scope of the graph's own listeners,
// which resume the app, and whether `App.lifecycle` gave one.
priv AppLifecycle: struct {
    runs: Int,
    observed: Phase?,
    published: Phase?,
    waiting: [AppObserved],
    handing: Bool,
    away: Bool,
    unfocused: Bool,
    resuming: Bool,
    scope: EventScope?,
    adapted: Bool,
}

// An observation waiting for LIFECYCLE's listeners, and whether it brings
// the app back from away.
priv AppObserved: struct {
    event: LifecycleEvent,
    came_back: Bool,
}

priv APP_LIFECYCLE: Shared{AppLifecycle{runs: 0, observed: None, published: None, waiting: [AppObserved]{}, handing: false, away: false, unfocused: false, resuming: false, scope: None, adapted: false}}

// A new graph (`new`) resumes through listeners of its own: the ones an
// earlier graph subscribed stop.
priv app_lifecycle_graph: fn() Never! {
    held := APP_LIFECYCLE.guard_edit()
    held.value.scope = Val(event.scope())
    held.value.adapted = false
}

// Starts the app's run (`launch`): its first phase is published, running,
// with its visibility unknown until the window's first frame, or hidden
// with no window. A graph without `App.lifecycle` still resumes when the
// app comes back, with no code of its own (`app_resume_run`).
priv app_lifecycle_start: fn(windowed: Bool) -[Net, Time]> Never! {
    held := APP_LIFECYCLE.guard_edit()
    held.value.runs += 1
    visibility: if windowed -> Visibility.Unknown else -> Visibility.Hidden
    first: Phase{instance: held.value.runs, sequence: 0, visibility: visibility, execution: .Running}
    held.value.published = Val(first.copy())
    held.value.observed = Val(first)
    held.value.waiting = [AppObserved]{}
    held.value.away = false
    held.value.unfocused = false
    if held.value.scope == None -> held.value.scope = Val(event.scope())
    if held.value.adapted {
        return
    }
    if held.value.scope == .Val(scope) {
        LIFECYCLE.on(scope, fn(_heard: LifecycleEvent) {
            if app_lifecycle_resuming() -> app_resume_start(None)
        })
    }
}

// The app observes `moment` (`app_observe`), and LIFECYCLE's listeners hear
// it when it moved the app's phase (`app_lifecycle_hand`).
priv app_moment: fn(moment: AppMoment) -[Net, Time]> Never! {
    if app_observe(moment) -> app_lifecycle_hand()
}

// Joins `moment` to the run's observations; whether it waits for the
// listeners. The window losing the focus, or the machine preparing to
// sleep, takes the app away; the focus or the wake that follows brings it
// back. A moment before `launch` or after the window closed, or one that
// leaves the phase as it was other than a focus regained or a wake, is
// not heard.
priv app_observe: fn(moment: AppMoment) -> Bool Never! {
    held := APP_LIFECYCLE.guard_edit()
    before: held.value.observed.copy() ?? return false
    was_away: held.value.away
    unfocused: held.value.unfocused
    if moment == {
        .Background -> {
            held.value.away = true
            held.value.unfocused = true
        }
        .Suspend -> { held.value.away = true }
        .Foreground -> {
            held.value.away = false
            held.value.unfocused = false
        }
        .Wake -> held.value.away = false
        .Shown(_) | .Closed -> {}
    }
    came_back: was_away && !held.value.away
    reason: if moment == {
        .Background -> {
            return false
        }
        .Foreground -> {
            if !unfocused && !came_back -> return false
            LifecycleReason.FocusRegained
        }
        .Suspend -> LifecycleReason.SleepPreparing
        .Wake -> LifecycleReason.Woke
        .Shown(_) -> LifecycleReason.VisibilityChanged
        .Closed -> LifecycleReason.Closing
    }
    visibility: if moment == {
        .Shown(shown) -> shown
        .Closed -> Visibility.Hidden
        .Foreground | .Background | .Suspend | .Wake -> before.visibility
    }
    execution: if moment == {
        .Suspend -> Execution.Suspending
        .Wake -> Execution.Running
        .Foreground | .Background | .Shown(_) | .Closed -> before.execution
    }
    moved: visibility != before.visibility || execution != before.execution
    if !moved && (reason == .VisibilityChanged || reason == .SleepPreparing) -> return false
    after: Phase{instance: before.instance, sequence: before.sequence + 1, visibility: visibility, execution: execution}
    held.value.observed = if reason == .Closing -> None else -> Val(after.copy())
    held.value.waiting.push(AppObserved{event: LifecycleEvent{instance: before.instance, sequence: after.sequence, reason: reason, before: before, after: after}, came_back: came_back})
    true
}

// Hands the waiting observations to LIFECYCLE's listeners, oldest first,
// unless another task is handing them out, which hands these too: one
// task at a time, so the listeners hear one observation at a time, in the
// order they arrived. A listener's own observation waits for the one it
// hears.
priv app_lifecycle_hand: fn() -[Net, Time]> Never! {
    handing := false
    loop {
        heard: app_lifecycle_next(handing) ?? return
        handing = true
        _: LIFECYCLE.emit(heard)
    }
}

// The next observation for LIFECYCLE's listeners, published first as the
// app's phase (`phase`), when `handing` or no other task hands them out;
// `None` once none waits, when the phase of a closed window's run goes too.
priv app_lifecycle_next: fn(handing: Bool) -> LifecycleEvent? Never! {
    held := APP_LIFECYCLE.guard_edit()
    if held.value.handing && !handing -> return None
    if held.value.waiting.len() == 0 {
        held.value.handing = false
        held.value.resuming = false
        if held.value.observed == None -> held.value.published = None
        return None
    }
    observed: held.value.waiting.remove(0, .Slot) ?? return None
    held.value.handing = true
    held.value.resuming = observed.came_back
    held.value.published = Val(observed.event.after.copy())
    Val(observed.event)
}

// Whether the observation LIFECYCLE's listeners hear now brings the app
// back from away: the window took the focus again, or the machine woke,
// after the app was in the background or asleep.
priv app_lifecycle_resuming: fn() -> Bool Never! {
    held: APP_LIFECYCLE.guard_read()
    held.value.resuming
}

// The visibility a window's `UIEvent.Visible` says.
priv app_visibility: fn(shown: Bool?) -> Visibility Never! {
    seen: shown ?? return .Unknown
    if seen -> .Visible else -> .Hidden
}

// Resumes the app in a task of its own, so the window's frames and the
// sleep watch never wait on it (`app_resume_run`), with the graph's
// `on_resume` (`App.lifecycle`) when it gave one.
priv app_resume_start: fn(resume: Shared<AppResume>?) -[Net, Time]> Never! {
    running: task { app_resume_run(resume) }
    running.detach()
}

// Resumes the app, with no code of its own: the writes the device queued
// while it was away go to the server (`queue_resume`), then every live
// binding re-runs at its next read (`live_invalidate`), so what the screen
// reads again holds them, and then `on_resume` (`App.lifecycle`), when
// there is one, runs once. The notice it fails with shows at the top of
// the window (`app_window_resumed`), or joins the notice list without
// one.
priv app_resume_run: fn(resume: Shared<AppResume>?) -[Net, Time]> Never! {
    queue_resume()
    live_invalidate(None, None, None, 0)
    on_resume: resume ?? return
    held: on_resume.guard_read()
    app_resume_once(held.value.run)
}

priv app_resume_once: fn(run: fn() Notice!) Never! {
    if run() == .Err(notice) {
        if !app_window_resumed(notice) -> __keep_notice(notice)
    }
}

// How long the sleep watch waits on the system bus at a time.
priv APP_SLEEP_WAIT_NS: 60000000000

// Follows the machine going to sleep and waking, from `launch` on, into
// the app's lifecycle (`app_moment`). logind says PrepareForSleep(true)
// before the sleep and PrepareForSleep(false) after the wake, on the
// system bus. Without a system bus or logind there is nothing to follow.
priv app_sleep_start: fn() -[Env, Net, Time]> Never! {
    watching: task { app_sleep_watch() }
    watching.detach()
}

priv app_sleep_watch: fn() -[Env, Net, Time]> Never! {
    bus := dbus.system(ASK_BUS_WAIT_NS) ?? return
    dbus.add_match(bus, "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep',path='/org/freedesktop/login1'", ASK_BUS_WAIT_NS) ?? return
    loop {
        got: dbus.signals(bus, APP_SLEEP_WAIT_NS) ?? return
        loop signal in got {
            if signal.member != "PrepareForSleep" || signal.body.len() != 1 -> next
            if signal.body[0] == .Bool(sleeping) {
                app_moment(if sleeping -> AppMoment.Suspend else -> AppMoment.Wake)
            }
        }
    }
}

// Installs the app's XDG autostart entry (`{config}/autostart/{id}.desktop`,
// its desktop entry), which starts the app when the user logs in, when
// `at_login`; otherwise removes the one an earlier launch installed.
priv app_autostart: fn(title: String, at_login: Bool) -[Env, FS.Read, FS.Write]> Never! {
    config: app_xdg_dir("XDG_CONFIG_HOME", sys.home_dir() ?? "", ".config") ?? return
    entry: "{config}/autostart/{app_desktop_id(title)}.desktop"
    if !at_login {
        if files.exists(entry) -> files.remove(entry) ?? return
        return
    }
    files.create_dir_all("{config}/autostart") ?? return
    files.write(entry, App{title: title}.desktop_entry(sys.executable())) ?? return
}

// `$name` when it is an absolute path, else `{home}/{fallback}`; None
// without either, as the XDG base directory specification reads them.
priv app_xdg_dir: fn(name: String, home: String, fallback: String) -[Env]> String? Never! {
    if sys.get(name) == .Val(set) && set.starts_with("/") -> return Val(set)
    if home == "" -> return None
    Val("{home}/{fallback}")
}

// The desktop entry ID of the app titled `title`: its letters and digits,
// in lowercase, each run of anything else one `-` between them; `app` when
// it has none.
priv app_desktop_id: fn(title: String) -> String Never! {
    id := ""
    gap := false
    loop scalar in unicode.scalars(title.lower()) {
        if !"abcdefghijklmnopqrstuvwxyz0123456789".contains(scalar) {
            gap = true
            next
        }
        if gap && id != "" -> id = "{id}-"
        gap = false
        id = "{id}{scalar}"
    }
    if id == "" -> return "app"
    id
}

// `text` as a desktop entry's string value: a backslash, a line break, a
// tab and a carriage return are each written as their escape.
priv app_desktop_value: fn(text: String) -> String Never! {
    text.replace("\\", "\\\\").replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r")
}

// The path of the program as the first word of a desktop entry's `Exec`
// key: in double quotes, with `"`, `` ` ``, `$` and `\` each after a
// backslash and `%` doubled, then written as a string value
// (`app_desktop_value`), as the Desktop Entry Specification says.
priv app_desktop_exec: fn(path: String) -> String Never! {
    quoted := ""
    loop scalar in unicode.scalars(path) {
        if scalar == "\"" || scalar == "`" || scalar == "$" || scalar == "\\" {
            quoted = "{quoted}\\{scalar}"
        } else if scalar == "%" { quoted = "{quoted}%%" } else { quoted = "{quoted}{scalar}" }
    }
    app_desktop_value("\"{quoted}\"")
}

// `text`, a mimeapps.list, with the desktop entry `id` as the default
// handler of each scheme's links: its `[Default Applications]` group,
// added at the end when it has none, names `id` for each
// `x-scheme-handler/{scheme}` first, and any handler it named for one
// before is gone. Every other line stays as it was.
priv app_mimeapps_with: fn(text: String, schemes: [String], id: String) -> String Never! {
    handlers := [String]{}
    keys := [String]{}
    loop scheme in schemes {
        keys.push("x-scheme-handler/{scheme}")
        handlers.push("x-scheme-handler/{scheme}={id}")
    }
    lines: text.split("\n").to_list()
    end := 0
    loop index in 0..<lines.len() {
        if lines[index].trim() != "" -> end = index + 1
    }
    out := [String]{}
    group := false
    added := false
    loop line in lines[0..<end] {
        trimmed: line.trim()
        if trimmed.starts_with("[") {
            group = trimmed == "[Default Applications]"
            out.push(line.copy())
            if group && !added {
                loop handler in handlers -> out.push(handler.copy())
                added = true
            }
            next
        }
        at: trimmed.find("=")
        if group && at > 0 && keys.contains(trimmed.slice(0, at).trim()) -> next
        out.push(line.copy())
    }
    if !added {
        if out.len() > 0 -> out.push("")
        out.push("[Default Applications]")
        loop handler in handlers -> out.push(handler.copy())
    }
    "{out.join("\n")}\n"
}

// A device permission the app asks the person for with `ask`. The package
// says why it wants each one it asks for in its `purposes:` (`camera`,
// `location`, `notifications`), which the system shows when it asks, and
// `jet check` refuses an `ask` whose permission has no purpose.
Permission: enum {
    Camera,
    Location,
    Notifications,
}

// The person's answer to `ask`. `Restricted` is an answer they could not
// give: the device has no such hardware, or nothing on it can ask (no
// session bus or desktop portal on Linux).
Grant: enum {
    Granted,
    Denied,
    Restricted,
}

// How long `ask` waits for the person, and for the session bus.
priv ASK_WAIT_NS: 300000000000

priv ASK_BUS_WAIT_NS: 1000000000

// An answer `ask` had in this process.
priv AppAsked: struct {
    permission: Permission,
    grant: Grant,
}

priv ASKED: Shared{[AppAsked]{}}

// Asks the person for `permission` and gives their answer. The process asks
// once: a later call gives the first answer. On Linux the desktop portal
// asks (org.freedesktop.portal.Camera, org.freedesktop.portal.Location) and
// remembers the person's choice across runs; notifications need no
// permission there, so they are `.Granted`. In a page the browser answers,
// through its Permissions API and, for a permission it would still ask
// for, its own request; the program waits for the answer while the page
// goes on. A request the person dismisses, or leaves unanswered for five
// minutes, is `.Denied`. Without a session bus or a portal, with no page to
// ask in or a browser without the device, and on the other native targets,
// the answer is `.Restricted`.
ask: fn(permission: Permission) -[Env, Net, Time]> Grant {
    if app_asked(permission) == .Val(known) -> return known
    grant: app_ask_system(permission)
    app_remember(permission, grant)
    grant
}

priv app_remember: fn(permission: Permission, grant: Grant) Never! {
    held := ASKED.guard_edit()
    held.value.push(AppAsked{permission: permission, grant: grant})
}

priv app_asked: fn(permission: Permission) -> Grant? Never! {
    held: ASKED.guard_read()
    loop asked in held.value {
        if asked.permission == permission -> return Val(asked.grant)
    }
    None
}

priv app_ask_system: fn(permission: Permission) -[Env, Net, Time]> Grant Never! {
    #if #build.target.os == {
        .Linux -> {
            if permission == .Notifications -> return Grant.Granted
            bus := dbus.session(ASK_BUS_WAIT_NS) ?? return Grant.Restricted
            said: app_portal_ask(bus, permission) ?? return Grant.Restricted
            return app_grant(said)
        }
        .MacOS -> { return Grant.Restricted }
        .Windows -> { return Grant.Restricted }
        .Web -> {
            return app_grant_web(ui_rt.device(WEB_DEVICE_ASK, app_permission_key(permission)))
        }
        .Wasm -> { return Grant.Restricted }
        .Freestanding -> { return Grant.Restricted }
    }
}

priv app_portal_ask: fn(bus: ^dbus.DbusConnection, permission: Permission) -[Net, Time]> dbus.PortalAnswer dbus.DbusError! {
    if permission == .Camera -> return dbus.portal_camera(bus, ASK_WAIT_NS)
    dbus.portal_location(bus, ASK_WAIT_NS)
}

// The grant a portal's answer gives.
priv app_grant: fn(said: dbus.PortalAnswer) -> Grant Never! {
    if said == {
        .Allowed -> Grant.Granted
        .Refused -> Grant.Denied
        .Ended -> Grant.Denied
        .Absent -> Grant.Restricted
    }
}

// The name `permission` has as a `purposes:` key, and in a page's request.
priv app_permission_key: fn(permission: Permission) -> String Never! {
    if permission == {
        .Camera -> "camera"
        .Location -> "location"
        .Notifications -> "notifications"
    }
}

// The grant a page's answer gives: none when there is no page to ask in, or
// its entry can't wait for the browser.
priv app_grant_web: fn(said: String?) -> Grant Never! {
    answer: said ?? return Grant.Restricted
    if answer == "granted" -> return Grant.Granted
    if answer == "denied" -> return Grant.Denied
    Grant.Restricted
}

#Test("ask asks once per process and reads the portal's or the page's answer as a grant") {
    assert_eq(app_grant(dbus.PortalAnswer.Allowed), Grant.Granted)
    assert_eq(app_grant(dbus.PortalAnswer.Refused), Grant.Denied)
    assert_eq(app_grant(dbus.PortalAnswer.Ended), Grant.Denied)
    assert_eq(app_grant(dbus.PortalAnswer.Absent), Grant.Restricted)
    assert_eq(app_grant_web(Val("granted")), Grant.Granted)
    assert_eq(app_grant_web(Val("denied")), Grant.Denied)
    assert_eq(app_grant_web(Val("restricted")), Grant.Restricted)
    assert_eq(app_grant_web(None), Grant.Restricted)
    assert_eq(app_permission_key(Permission.Notifications), "notifications")
    app_remember(Permission.Location, Grant.Denied)
    assert_eq(ask(Permission.Location), Grant.Denied)
}

// Opens the system's settings page for this app, where the person changes
// the permissions `ask` got, and gives whether one opened. On Linux that is
// GNOME Settings' Apps page for the app's desktop entry
// (`gnome-control-center applications {id}`, `id` made from the graph's
// title as `app_desktop_id` makes it), started apart from the app so it
// stays open when the app exits. It is `false` when that program does not
// start, on the other native targets, and in a page: a browser keeps no
// settings page of an app's, and the person changes a site's permissions in
// the browser's own site settings.
open_settings: fn() -[Env, Exec]> Bool {
    #if #build.target.os == {
        .Linux -> {
            page: process.cmd([String]{"gnome-control-center", "applications", app_desktop_id(app_graph_title())})
            _ := page.stdout(.Inherit).stderr(.Inherit).detached().spawn() ?? return false
            return true
        }
        .MacOS -> { return false }
        .Windows -> { return false }
        .Web -> { return false }
        .Wasm -> { return false }
        .Freestanding -> { return false }
    }
}

// A file the person gave the app: a photo it took, or one they picked or
// dropped. It has a name, a size in bytes and what it holds, and the app
// reads it through the handle; where it is kept never reaches the app.
PickedFile: struct {
    name: String,
    bytes: Int,
    media: Media?,
    priv source: PickedSource,

    // The file's bytes.
    read: fn(self) -[FS.Read]> [U8] IOError! {
        if self.source == {
            .Path(path) -> files.read_bytes(path)
            .Page(number) -> app_page_whole(number, self.name, self.bytes)
        }
    }

    // The file's text; an error when its bytes are not UTF-8.
    text: fn(self) -[FS.Read]> String IOError! {
        if self.source == {
            .Path(path) -> files.read(path)
            .Page(number) -> {
                bytes: app_page_whole(number, self.name, self.bytes) ?? return Err(err)
                text: String.from_bytes(bytes) ?? return Err(IOError.InvalidInput(IOContext{operation: .Codec, resource: Val(self.name), os_code: None, cause: Val("the file is not UTF-8 text")}))
                Ok(text)
            }
        }
    }

    // The file's bytes a part at a time, for a file too big to hold whole.
    stream: fn(self) -[FS.Read]> PickedStream IOError! {
        if self.source == {
            .Path(path) -> Ok(PickedStream{file: Val(files.open(path) ?? return Err(err)), page: -1, name: self.name, at: 0})
            .Page(number) -> Ok(PickedStream{file: None, page: number, name: self.name, at: 0})
        }
    }
}

// Where a picked file or folder is: a path on this device, or one a page's
// browser holds for the app, under the number its UI provider gave it.
priv PickedSource: enum {
    Path(String),
    Page(Int),
}

// A picked file's bytes as a `Reader`, from its first byte to its last: an
// open file on this device, or the page's file `page` read a part at a time
// from `at`.
#[!Equatable, !Comparable]
PickedStream: struct {
    priv file: files.FileReader?,
    priv page: Int,
    priv name: String,
    priv at: Int,

    impl Reader {
        read_bytes: fn(^self, limit: Int) -[Time.Wait]> [U8] IOError! {
            if ^self.file == .Val(reader) -> return reader.read_bytes(limit)
            part: app_page_read(self.page, self.name, self.at, limit) ?? return Err(err)
            self.at += part.len()
            Ok(part)
        }

        read_into: fn(^self, buffer: ^[U8], limit: Int) -[Time.Wait]> Int IOError! {
            if ^self.file == .Val(reader) -> return reader.read_into(buffer, limit)
            part: app_page_read(self.page, self.name, self.at, limit) ?? return Err(err)
            loop byte in part -> buffer.push(byte)
            self.at += part.len()
            Ok(part.len())
        }
    }
}

// The page's kinds of device request (Host.jet deviceRequest).
priv WEB_DEVICE_ASK: 0

priv WEB_DEVICE_PLACE: 1

priv WEB_DEVICE_PHOTO: 2

priv WEB_DEVICE_READ: 3

priv WEB_DEVICE_WATCH: 4

priv WEB_DEVICE_NEXT: 5

priv WEB_DEVICE_STOP: 6

priv WEB_DEVICE_PASTE: 7

priv WEB_DEVICE_SHARE: 8

priv WEB_DEVICE_OPEN: 9

priv WEB_DEVICE_DROPPED: 10

priv WEB_DEVICE_FOLDER: 11

priv WEB_DEVICE_LIST: 12

priv WEB_DEVICE_WRITE: 13

priv WEB_DEVICE_KEEP: 14

priv WEB_DEVICE_KEPT: 15

priv WEB_DEVICE_LIFECYCLE: 16

priv WEB_DEVICE_MOMENT: 17

priv WEB_DEVICE_POST: 18

priv WEB_DEVICE_DRAW: 19

// The `size` bytes of the file a page holds under `number` for the app.
priv app_page_whole: fn(number: Int, name: String, size: Int) -> [U8] IOError! {
    if size == 0 -> return Ok([U8]{})
    app_page_read(number, name, 0, size)
}

// Up to `limit` bytes from `at` of the file a page holds under `number`
// for the app (`name`), none past its end. A limit below one is an error
// before any read, as a Reader's is, and so is a file the page no longer
// has.
priv app_page_read: fn(number: Int, name: String, at: Int, limit: Int) -> [U8] IOError! {
    if limit < 1 {
        return Err(IOError.InvalidInput(IOContext{operation: .Read, resource: Val(name), os_code: None, cause: Val("a read takes at least one byte")}))
    }
    part: ui_rt.device_bytes(WEB_DEVICE_READ, "{number} {at} {limit}") ?? return Err(IOError.NotFound(IOContext{operation: .Read, resource: Val(name), os_code: None, cause: Val("the page no longer holds the file")}))
    Ok(part)
}

// The fields of the page's answer to the device request `request` of kind
// `kind`: none when there is no page to ask, or its entry can't wait for
// the browser.
priv app_page_answer: fn(kind: Int, request: String) -> [String] Never! {
    said: ui_rt.device(kind, request) ?? return [String]{}
    ui.host.provider_record_fields(said) ?? [String]{}
}

// The first field of a page's answer: a device request's grant.
priv app_page_first: fn(fields: [String]) -> String? Never! {
    if fields.len() == 0 -> return None
    Val(fields[0])
}

// The place a page's answer holds from its field `from` on: latitude,
// longitude and accuracy in meters. None when it has none.
priv app_page_place: fn(fields: [String], from: Int) -> Place? Never! {
    if fields.len() < from + 3 -> return None
    latitude: Float.parse(fields[from]) ?? return None
    longitude: Float.parse(fields[from + 1]) ?? return None
    accuracy: Float.parse(fields[from + 2]) ?? return None
    Val(Place{latitude: latitude, longitude: longitude, accuracy_m: accuracy})
}

// The file a page's answer holds from its field `from` on: the number the
// page keeps it under, its size and its name, as a PickedFile whose media
// its first bytes show (`blob_type`), as a kept blob's is. None when it has
// none.
priv app_page_file: fn(fields: [String], from: Int) -> PickedFile? Never! {
    if fields.len() < from + 3 -> return None
    number: Int.parse(fields[from]) ?? return None
    size: Int.parse(fields[from + 1]) ?? return None
    name: fields[from + 2]
    head: if size == 0 -> [U8]{} else -> app_page_read(number, name, 0, min(size, BLOB_HEAD)) ?? [U8]{}
    Val(PickedFile{name: name.copy(), bytes: size, media: blob_media(blob_type(head, size)), source: .Page(number)})
}

// The fields of the next reading of the sensor the page follows under
// `watch` for a stream, once there is one; none when the page no longer
// follows it.
priv app_page_reading: fn(watch: String) -> [String]? Never! {
    said: ui_rt.device(WEB_DEVICE_NEXT, watch) ?? return None
    ui.host.provider_record_fields(said)
}

// Stops the page following the sensor under `watch`.
priv app_page_unwatch: fn(watch: String) Never! { _: ui_rt.device(WEB_DEVICE_STOP, watch) }

// The folder a page's answer holds from its field `from` on: the number
// the page keeps its handle under and its name. None when it has none.
priv app_page_folder: fn(fields: [String], from: Int) -> PickedFolder? Never! {
    if fields.len() < from + 2 -> return None
    number: Int.parse(fields[from]) ?? return None
    Val(PickedFolder{name: fields[from + 1].copy(), source: .Page(number)})
}

// The files directly in the folder a page keeps under `number` (`name`),
// in name order, each one the page then keeps as a picked file's. A folder
// the page no longer holds, or one the browser no longer lets it list, is
// an error.
priv app_page_listed: fn(number: Int, name: String) -> [PickedFile] IOError! {
    fields: app_page_answer(WEB_DEVICE_LIST, "{number}")
    if app_page_first(fields) != .Val("listed") {
        return Err(IOError.PermissionDenied(IOContext{operation: .Read, resource: Val(name), os_code: None, cause: Val("the browser no longer lets the page list the folder")}))
    }
    found := [PickedFile]{}
    at := 1
    loop at + 3 <= fields.len() {
        found.push(app_page_file(fields, at) ?? return Err(IOError.InvalidInput(IOContext{operation: .Read, resource: Val(name), os_code: None, cause: Val("the page listed a file without its number and size")})))
        at += 3
    }
    Ok(found)
}

// Writes `bytes` as the file `file` in the folder a page keeps under
// `number` (`name`): the browser writes them all to a new copy of the file
// and only then replaces it, so a failed write leaves the file as it was.
priv app_page_write: fn(number: Int, name: String, file: String, bytes: [U8]) IOError! {
    said: ui_rt.device(WEB_DEVICE_WRITE, "{number} {base64.encode(bytes)} {file}") ?? ""
    if said != "written" {
        return Err(IOError.PermissionDenied(IOContext{operation: .Write, resource: Val(file), os_code: None, cause: Val("the browser did not let the page write to {name}")}))
    }
    Ok()
}

// Has the page's browser keep the folder it holds under `number` under
// `key`, for `kept_folder` in a later visit.
priv app_page_keep: fn(number: Int, key: String) Never! {
    _: ui_rt.device(WEB_DEVICE_KEEP, "{number} {key}")
}

// `kept_folder` in a page: the folder whose handle the browser keeps under
// `key`. The browser may ask the person again before the page reaches it;
// a refusal, or no folder kept under `key`, is `None`.
priv app_page_kept_folder: fn(key: String) -> PickedFolder? Never! {
    fields: app_page_answer(WEB_DEVICE_KEPT, key)
    if app_page_first(fields) != .Val("granted") -> return None
    app_page_folder(fields, 1)
}

#Test("a page's answers read as a grant, a place, a file, a folder and a sensor's reading, and a page's file and folder are reached only in their page") {
    assert_eq(app_page_first([String]{}), None)
    assert_eq(app_page_first([String]{"denied"}), Val("denied"))
    assert_eq(app_page_place([String]{"granted", "52.52", "13.405", "20"}, 1), Val(Place{latitude: 52.52, longitude: 13.405, accuracy_m: 20.0}))
    assert_eq(app_page_place([String]{"granted"}, 1), None)
    assert_eq(app_page_place([String]{"granted", "north", "13.405", "20"}, 1), None)
    assert_eq(app_page_place([String]{"52.5201", "13.4051", "10"}, 0), Val(Place{latitude: 52.5201, longitude: 13.4051, accuracy_m: 10.0}))
    assert_eq(app_orientation_named("left-up"), Val(Orientation.LeftUp))
    assert_eq(app_orientation_named("undefined"), None)
    assert_eq(app_page_reading("1"), None)
    if app_page_file([String]{"granted", "2", "0", "crew-tasks.csv"}, 1) == .Val(file) {
        assert_eq(file.name, "crew-tasks.csv")
        assert_eq(file.bytes, 0)
    } else { panic("an answer with a file gives it") }
    if app_page_file([String]{"granted"}, 1) == .Val(_) {
        panic("an answer without a file gives none")
    }
    if app_page_file([String]{"granted", "two", "0", "crew-tasks.csv"}, 1) == .Val(_) {
        panic("a file needs its number")
    }
    assert_eq(app_file_accept([FileType]{FileType.CSV, FileType.Image}), ".csv,text/csv,.png,.jpg,.jpeg,image/png,image/jpeg")
    empty: PickedFile{name: "empty.csv", bytes: 0, media: None, source: .Page(1)}
    assert_eq(empty.read() ?? panic("an empty file: {err}"), [U8]{})
    photo: PickedFile{name: "photo-1.jpg", bytes: 4, media: Val(Media.Image), source: .Page(0)}
    if photo.read() == {
        .Ok(_) -> { panic("a page's file reads only in its page") }
        .Err(_) -> {}
    }
    if app_page_folder([String]{"granted", "3", "exports"}, 1) == .Val(folder) {
        assert_eq(folder.name, "exports")
    } else { panic("an answer with a folder gives it") }
    if app_page_folder([String]{"granted"}, 1) == .Val(_) {
        panic("an answer without a folder gives none")
    }
    assert(app_page_kept_folder("exports") == PickedFolder?{None}, "with no page, no folder is kept")
    held: PickedFolder{name: "exports", source: .Page(3)}
    if held.files() == .Ok(_) -> panic("a page's folder lists only in its page")
    if held.write("board.csv", [U8]{}) == .Ok(_) {
        panic("a page's folder is written only in its page")
    }
}

// A place on Earth: degrees north and east, and how far off it may be, in
// meters (0 when the system did not say).
Place: struct {
    latitude: Float,
    longitude: Float,
    accuracy_m: Float,
}

// A kind of file `open_file` and `save_file` offer.
FileType: enum {
    CSV,
    JSON,
    Image,
}

// Asks the person for a file to open and gives it, or `None` when they
// cancel. The dialog offers the kinds in `types`, the first one chosen. A
// file that can't be read, or no dialog to ask with, is `None` with a
// notice. On Linux the desktop portal's open dialog asks
// (org.freedesktop.portal.FileChooser); in a page the browser's file
// chooser asks (`app_open_web`); the other native targets keep that
// notice.
open_file: fn(types: [FileType]) -[Env, FS.Read, Net, Time]> PickedFile? {
    #if #build.target.os == {
        .Linux -> { return app_open_linux(types) }
        .MacOS -> { return app_unopened(OPEN_UNBUILT) }
        .Windows -> { return app_unopened(OPEN_UNBUILT) }
        .Web -> { return app_open_web(types) }
        .Wasm -> { return app_unopened(OPEN_UNBUILT) }
        .Freestanding -> { return app_unopened(OPEN_UNBUILT) }
    }
}

priv OPEN_UNBUILT: "this system's open dialog is not built yet"

// `open_file` on Linux: the portal's dialog, then the chosen file's size
// and what its first bytes show it holds.
priv app_open_linux: fn(types: [FileType]) -[Env, FS.Read, Net, Time]> PickedFile? Never! {
    bus := dbus.session(ASK_BUS_WAIT_NS) ?? return app_unopened("{err}")
    filters := [dbus.FileFilter]{}
    loop kind in types -> filters.push(app_file_filter(kind))
    uri: if dbus.portal_open_file(bus, "Open File", filters, ASK_WAIT_NS) == {
        .Err(err) -> {
            return app_unopened("{err}")
        }
        .Ok(chosen) -> chosen ?? return None
    }
    path: app_chosen_path(uri) ?? return app_unopened("the dialog chose {uri}, which is not a local file")
    if app_picked(path) == {
        .Ok(file) -> Val(file)
        .Err(err) -> app_unopened("{err}")
    }
}

// `open_file` in a page: the browser's file chooser offers the kinds in
// `types` (`app_file_accept`), and the page keeps the chosen file, which
// `read` reads from there, its size and its name. The person closing the
// chooser is `None`; with no page to ask in (node runs the build), it
// keeps the notice.
priv app_open_web: fn(types: [FileType]) -> PickedFile? Never! {
    fields: app_page_answer(WEB_DEVICE_OPEN, app_file_accept(types))
    if app_page_first(fields) != .Val("granted") {
        return app_unopened("there is no page to ask in")
    }
    app_page_file(fields, 1)
}

// What a page's file chooser offers for `types`, as an `<input
// type=file>`'s accept says it: each kind's name endings, then its media
// types, comma-separated.
priv app_file_accept: fn(types: [FileType]) -> String Never! {
    offered := [String]{}
    loop kind in types {
        filter: app_file_filter(kind)
        loop glob in filter.globs -> offered.push(glob.removeprefix("*"))
        loop media in filter.media -> offered.push(media.copy())
    }
    offered.join(",")
}

// The file at `path` as a PickedFile: its name, its size, and its media
// as its first bytes show (`blob_type`), as a kept blob's is.
priv app_picked: fn(path: String) -[FS.Read]> PickedFile IOError! {
    size: files.stat(path).size
    head: files.read_at(path, 0, BLOB_HEAD)
    Ok(PickedFile{name: files.basename(path), bytes: size, media: blob_media(blob_type(head, size)), source: .Path(path)})
}

// Keeps the notice that no file was opened, and why; gives `None`.
priv app_unopened: fn(why: String) -> PickedFile? Never! {
    __keep_notice(Notice{text: "Couldn't open a file: {why}"})
    None
}

// The path of the local file a file dialog chose, given as a `file://`
// URI; `None` for any other URI.
priv app_chosen_path: fn(uri: String) -> String? Never! {
    if !uri.starts_with("file://") -> return None
    path: url.percent_decode(uri.removeprefix("file://")) ?? return None
    Val(path)
}

// A folder the person gave the app (`open_folder`). It has a name, the
// files in it and a way to write one there; where it is kept never reaches
// the app. `keep` keeps access to it, so a later run finds it again
// (`kept_folder`).
PickedFolder: struct {
    name: String,
    priv source: PickedSource,

    // The files directly in the folder, each a PickedFile, in name order.
    files: fn(self) -[FS.Read]> [PickedFile] IOError! {
        if self.source == {
            .Path(path) -> app_folder_files(path)
            .Page(number) -> app_page_listed(number, self.name)
        }
    }

    // Writes `bytes` as the file `name` in the folder, all at once, so a
    // failed write leaves any file that was there whole. A name with a `/`,
    // or `.` or `..`, is an error: it would leave the folder.
    write: fn(self, name: String, bytes: [U8]) -[FS.Write]> IOError! {
        if name == "" || name == "." || name == ".." || name.contains("/") {
            return Err(IOError.InvalidInput(IOContext{operation: .Write, resource: Val(name), os_code: None, cause: Val("a file in a folder is named without a `/`, and is not `.` or `..`")}))
        }
        if self.source == {
            .Path(path) -> { files.write_atomic("{path}/{name}", bytes) }
            .Page(number) -> app_page_write(number, self.name, name, bytes)
        }
    }

    // Keeps access to the folder under `key`: `kept_folder(key)` gives it
    // back in this run and every later one, until another folder is kept
    // under `key`. On this device the device store (`device_cell_load`)
    // keeps the folder's path or, for one the document portal shares into a
    // sandbox, its document portal ID (`app_folder_form`). A page's browser
    // keeps the folder's handle (`app_page_keep`).
    keep: fn(self, key: String) -[Env]> Never! {
        if self.source == {
            .Path(path) -> { app_keep_folder(key, path) }
            .Page(number) -> app_page_keep(number, key)
        }
    }
}

// The files directly in the folder at `path`, in name order.
priv app_folder_files: fn(path: String) -[FS.Read]> [PickedFile] IOError! {
    found := [PickedFile]{}
    loop entry in files.list_dir(path) ?? return Err(err) {
        if entry.is_dir -> next
        found.push(app_picked(entry.path) ?? return Err(err))
    }
    Ok(found)
}

// Keeps the folder at `path` under `key` in the device store
// (`PickedFolder.keep`).
priv app_keep_folder: fn(key: String, path: String) -[Env]> Never! {
    form: app_folder_form(path, sys.get("XDG_RUNTIME_DIR") ?? "")
    loop {
        seen: device_cell_load(FOLDER_STORE, FOLDER_CELL)
        listed: live_fields(seen) ?? [String]{}
        kept := [U8]{}
        at := 0
        loop at + 1 < listed.len() {
            if listed[at] != key {
                live_put(kept, listed[at])
                live_put(kept, listed[at + 1])
            }
            at += 2
        }
        live_put(kept, key)
        live_put(kept, form)
        if device_cell_replace(FOLDER_STORE, FOLDER_CELL, seen, kept) {
            return
        }
    }
}

// The folders `keep` kept on this device, as length-prefixed fields: each
// key, then its folder's form (`app_folder_form`).
priv FOLDER_CELL: Shared{LiveCell{bytes: [U8]{}}}

priv FOLDER_STORE: "app.folders"

// The folder kept under `key` (`PickedFolder.keep`), in this run or an
// earlier one; `None` when none is, or it is no longer a folder. A page
// asks its browser (`app_page_kept_folder`), which may ask the person
// again for access to it.
kept_folder: fn(key: String) -[Env, FS.Read]> PickedFolder? {
    #if #build.target.os == {
        .Linux -> { return app_kept_folder(key) }
        .MacOS -> { return app_kept_folder(key) }
        .Windows -> { return app_kept_folder(key) }
        .Web -> { return app_page_kept_folder(key) }
        .Wasm -> { return app_kept_folder(key) }
        .Freestanding -> { return app_kept_folder(key) }
    }
}

// `kept_folder` on this device: the folder's form in the device store.
priv app_kept_folder: fn(key: String) -[Env, FS.Read]> PickedFolder? Never! {
    listed: live_fields(device_cell_load(FOLDER_STORE, FOLDER_CELL)) ?? return None
    at := 0
    loop at + 1 < listed.len() {
        if listed[at] == key {
            path: app_folder_path(listed[at + 1], sys.get("XDG_RUNTIME_DIR") ?? "") ?? return None
            if !files.is_dir(path) -> return None
            return Val(PickedFolder{name: files.basename(path), source: .Path(path)})
        }
        at += 2
    }
    None
}

// How `keep` writes down the folder at `path`, given the runtime directory
// `runtime`. A folder the document portal shares into a sandbox lives
// under `{runtime}/doc/{id}/`; it is `doc:` and the rest of its path from
// the ID on, which a later run finds under its own runtime directory. Any
// other folder is `path:` and its path.
priv app_folder_form: fn(path: String, runtime: String) -> String Never! {
    shared: "{runtime}/doc/"
    if runtime != "" && path.starts_with(shared) -> return "doc:{path.removeprefix(shared)}"
    "path:{path}"
}

// The path of the folder `keep` wrote down as `form` (`app_folder_form`),
// given this run's runtime directory `runtime`; `None` for a form it
// doesn't write.
priv app_folder_path: fn(form: String, runtime: String) -> String? Never! {
    if form.starts_with("path:") -> return Val(form.removeprefix("path:"))
    if form.starts_with("doc:") && runtime != "" {
        return Val("{runtime}/doc/{form.removeprefix("doc:")}")
    }
    None
}

// Asks the person for a folder and gives it, or `None` when they cancel.
// No dialog to ask with, or a choice that is not a local folder, is `None`
// with a notice. On Linux the desktop portal's open dialog asks for a
// directory (org.freedesktop.portal.FileChooser); in a page the browser's
// directory picker asks (`app_open_folder_web`); the other native targets
// keep that notice.
open_folder: fn() -[Env, FS.Read, Net, Time]> PickedFolder? {
    #if #build.target.os == {
        .Linux -> { return app_open_folder_linux() }
        .MacOS -> { return app_no_folder(OPEN_UNBUILT) }
        .Windows -> { return app_no_folder(OPEN_UNBUILT) }
        .Web -> { return app_open_folder_web() }
        .Wasm -> { return app_no_folder(OPEN_UNBUILT) }
        .Freestanding -> { return app_no_folder(OPEN_UNBUILT) }
    }
}

// `open_folder` in a page: the browser's directory picker asks for a
// folder the page may read and write, and the page keeps its handle, which
// the folder's files, writes and `keep` go through. The person closing the
// picker is `None`. A browser without a directory picker, a picker it
// opens only inside the person's gesture, one it refuses, or no page to
// ask in keeps the notice of why.
priv app_open_folder_web: fn() -> PickedFolder? Never! {
    fields: app_page_answer(WEB_DEVICE_FOLDER, "")
    grant: app_page_first(fields) ?? return app_no_folder("there is no page to ask in")
    if grant == {
        "granted" -> app_page_folder(fields, 1)
        "restricted" -> app_no_folder("this browser gives a page no folder to pick")
        "gesture" -> app_no_folder("the browser opens its folder picker only inside a click or a key press")
        else -> app_no_folder("the browser refused the page a folder")
    }
}

// `open_folder` on Linux: the portal's dialog, asked for a directory.
priv app_open_folder_linux: fn() -[Env, FS.Read, Net, Time]> PickedFolder? Never! {
    bus := dbus.session(ASK_BUS_WAIT_NS) ?? return app_no_folder("{err}")
    uri: if dbus.portal_open_folder(bus, "Open Folder", ASK_WAIT_NS) == {
        .Err(err) -> {
            return app_no_folder("{err}")
        }
        .Ok(chosen) -> chosen ?? return None
    }
    path: app_chosen_path(uri) ?? return app_no_folder("the dialog chose {uri}, which is not a local folder")
    if !files.is_dir(path) {
        return app_no_folder("the dialog chose {files.basename(path)}, which is not a folder")
    }
    Val(PickedFolder{name: files.basename(path), source: .Path(path)})
}

// Keeps the notice that no folder was opened, and why; gives `None`.
priv app_no_folder: fn(why: String) -> PickedFolder? Never! {
    __keep_notice(Notice{text: "Couldn't open a folder: {why}"})
    None
}

// Puts `text` on the clipboard, for the app and every other program to
// paste (`paste_text`) until another copy replaces it. On Linux the app's
// window (`App.window`) puts it there before its next frame, since the
// display server takes a copy only from a window: a copy while the app
// has no window, or one the display server refuses, adds a notice to
// `notices()` and copies nothing. A page writes it through the browser's
// Clipboard API; a browser without one adds a notice instead. The other
// native targets keep a notice that says their clipboard is not built yet.
copy_text: fn(text: String) Never! {
    #if #build.target.os == {
        .Linux -> { app_window_copy(text) }
        .MacOS -> { app_no_clipboard() }
        .Windows -> { app_no_clipboard() }
        .Web -> { app_page_copy(text) }
        .Wasm -> { app_no_clipboard() }
        .Freestanding -> { app_no_clipboard() }
    }
}

// The clipboard's text, which the app or another program copied; None
// when the clipboard holds no text. On Linux the app's window reads it,
// waiting up to 2 s for another program's copy: a read while the app has
// no window, or one that fails, adds a notice to `notices()` and gives
// None. A page reads it through the browser's Clipboard API, which lends
// it only inside the person's gesture, such as a click's handler: the
// program waits for the browser's answer, and a read the browser refuses,
// or one outside a gesture, adds a notice and gives None. The other native
// targets keep a notice that says their clipboard is not built yet and
// give None.
paste_text: fn() -[Env, Net, Time]> String? Never! {
    #if #build.target.os == {
        .Linux -> { return app_window_paste() }
        .MacOS -> { return app_no_paste() }
        .Windows -> { return app_no_paste() }
        .Web -> { return app_page_paste() }
        .Wasm -> { return app_no_paste() }
        .Freestanding -> { return app_no_paste() }
    }
}

// Keeps the notice that this target has no clipboard yet.
priv app_no_clipboard: fn() Never! {
    __keep_notice(Notice{text: "Couldn't reach the clipboard: this system's clipboard is not built yet"})
}

// Keeps the notice that this target has no clipboard yet; gives None.
priv app_no_paste: fn() -> String? Never! {
    app_no_clipboard()
    None
}

// `copy_text` in a page: the provider writes the browser's clipboard
// (Host.jet clipboardSet); whether it could.
priv app_page_copied: fn(text: String) -> Bool Never! {
    if ui_rt.clipboard_set(text) -> return true
    __keep_notice(Notice{text: "Couldn't copy: the browser gives the page no clipboard"})
    false
}

priv app_page_copy: fn(text: String) Never! { _: app_page_copied(text) }

// `paste_text` in a page (Host.jet pasteText): None, with no notice, when
// the clipboard holds no text.
priv app_page_paste: fn() -> String? Never! {
    text: ui_rt.device(WEB_DEVICE_PASTE, "") ?? {
        __keep_notice(Notice{text: "Couldn't paste: the browser lends the clipboard only inside a click or a key press, and refused it here"})
        return None
    }
    if text == "" -> return None
    Val(text)
}

// Shares `url` through the system's share sheet. On Linux, which has none,
// the app's window copies `url` to the clipboard, as `copy_text` does, and
// then keeps a notice that says so, for the person to paste the link where
// they would share it; a copy that fails keeps its own notice instead. A
// page shares it through the browser's Web Share API, which opens the
// share sheet only inside the person's gesture, such as a click's handler;
// a browser without one, or one that refuses this share, copies `url` and
// says so, as on Linux. A share the person dismisses is no failure. The
// other native targets keep a notice that says their share sheet is not
// built yet.
share: fn(url: String) Never! {
    #if #build.target.os == {
        .Linux -> { app_window_share(url) }
        .MacOS -> { app_no_share() }
        .Windows -> { app_no_share() }
        .Web -> { app_page_share(url) }
        .Wasm -> { app_no_share() }
        .Freestanding -> { app_no_share() }
    }
}

// Keeps the notice that this target has no share sheet yet.
priv app_no_share: fn() Never! {
    __keep_notice(Notice{text: "Couldn't share: this system's share sheet is not built yet"})
}

// `share` in a page (Host.jet shareLink).
priv app_page_share: fn(url: String) Never! {
    said: ui_rt.device(WEB_DEVICE_SHARE, url) ?? "copy"
    if said != "copy" {
        return
    }
    if app_page_copied(url) -> __keep_notice(Notice{text: "Copied the link to share it: {url}"})
}

// `body`, taking the files a person drops on it: each one of a kind in
// `types` goes to `on_drop` as a PickedFile, and a notice `on_drop` fails
// with shows beside `body`, as a button's does. A native target delivers
// drops through the window that shows `body`: on Linux the app's window
// (`App.window`) takes them (`app_window_drop`); the other native targets
// keep a notice that says their drop target is not built yet and give
// `body` back as it is. In a page the browser's drop gives the files
// (`app_drop_web`), which the page keeps and `read` reads from there.
drop_files: fn(body: UINode, types: [FileType], on_drop: ^^fn([PickedFile]) Notice!) -> UINode {
    #if #build.target.os == {
        .Linux -> { return app_drop_target(body, types, on_drop.move()) }
        .MacOS -> { return app_undroppable(body) }
        .Windows -> { return app_undroppable(body) }
        .Web -> { return app_drop_web(body, types, on_drop.move()) }
        .Wasm -> { return app_undroppable(body) }
        .Freestanding -> { return app_undroppable(body) }
    }
}

// The bodies that take dropped files (`drop_files`) in the tree the
// window shows, each one's id one past its index (`app_window_tree`
// starts them over).
priv APP_DROPS: Shared{[AppDrop]{}}

priv AppDrop: struct {
    types: [FileType],
    run: Shared<AppDropRun>,
}

priv AppDropRun: struct {
    run: fn([PickedFile]) Notice!,
}

// `body` as one the window gives the files dropped on it, of a kind in
// `types`, to `on_drop`.
priv app_drop_target: fn(body: UINode, types: [FileType], on_drop: ^^fn([PickedFile]) Notice!) -> UINode Never! {
    held: APP_DROPS.guard_edit()
    held.value.push(AppDrop{types: types.copy(), run: Shared{AppDropRun{run: on_drop.move()}}})
    body.__taking_files(held.value.len())
}

// Keeps the notice that this target takes no dropped files; gives `body`.
priv app_undroppable: fn(body: UINode) -> UINode Never! {
    __keep_notice(Notice{text: "Couldn't take dropped files: this system's drop target is not built yet"})
    body.copy()
}

// `body` as one a page gives the files dropped on it, of a kind in `types`,
// to `on_drop` (`UINode.__taking_web_files`): a drop of files on it clicks
// a handler that takes them from the page (`app_drop_web_run`).
priv app_drop_web: fn(body: UINode, types: [FileType], on_drop: ^^fn([PickedFile]) Notice!) -> UINode Never! {
    target: AppDrop{types: types.copy(), run: Shared{AppDropRun{run: on_drop.move()}}}
    body.__taking_web_files(ui.button("", fn() { app_drop_web_run(target) }))
}

// The files of the page's last drop on a body that takes them, as
// `drop_files` gives them: each of a kind `target` takes, as a PickedFile
// in the drop's order, to its `on_drop` once. A drop with none of them
// calls nothing.
priv app_drop_web_run: fn(target: AppDrop) Never! {
    fields: app_page_answer(WEB_DEVICE_DROPPED, "")
    dropped := [PickedFile]{}
    at := 0
    loop at + 3 <= fields.len() {
        if app_file_kind(fields[at + 2], target.types) {
            if app_page_file(fields, at) == .Val(file) -> dropped.push(file)
        }
        at += 3
    }
    if dropped.len() == 0 {
        return
    }
    held: target.run.guard_read()
    app_drop_once(held.value.run, dropped)
}

// Starts the window's drop targets over, for a tree opened anew.
priv app_drops_clear: fn() Never! {
    held: APP_DROPS.guard_edit()
    held.value.clear()
}

// The drop target whose id is `id`, if the shown tree has it.
priv app_drop: fn(id: Int) -> AppDrop? Never! {
    held: APP_DROPS.guard_read()
    if id < 1 || id > held.value.len() -> return None
    Val(held.value[id - 1].copy())
}

// A drop's items on the window, at the body whose drop target id is `id`
// (0 for none), as `drop_files` gives them: each item a local file
// (`file://`) of a kind the body takes, as a PickedFile, in the drop's
// order, to its `on_drop` once. A drop with none of them calls nothing; a
// file that can't be read, and the notice `on_drop` fails with, join the
// app's notices.
priv app_window_drop: fn(id: Int, items: [UIDropItem]) -[FS.Read]> Never! {
    target: app_drop(id) ?? return
    dropped := [PickedFile]{}
    loop item in items {
        if item == .URI(uri) {
            path: app_chosen_path(uri) ?? next
            if !app_file_kind(files.basename(path), target.types) -> next
            if app_picked(path) == {
                .Ok(file) -> { dropped.push(file) }
                .Err(err) -> {
                    __keep_notice(Notice{text: "Couldn't take {files.basename(path)}: {err}"})
                }
            }
        }
    }
    if dropped.len() == 0 {
        return
    }
    held: target.run.guard_read()
    app_drop_once(held.value.run, dropped)
}

// Gives `dropped` to a body's `on_drop`, as a button's handler runs; the
// notice it fails with joins the app's notices.
priv app_drop_once: fn(run: fn([PickedFile]) Notice!, dropped: [PickedFile]) Never! {
    if run(dropped) == .Err(notice) -> __keep_notice(notice)
}

// `body` with the context menu `items`, which opens where the person
// right-clicks on `body`: choosing an item runs it as a menu bar's item
// runs (`item`, `edit_menu`, `window_menu`), and an item's run that fails
// adds its notice to the app's notice list (`notices`), which the window
// shows. On Linux the app's window (`App.window`) opens it over the
// screen (`app_window_run`); in a web build the page opens it on the
// browser's `contextmenu` event in place of the browser's own menu
// (`app_context_web`). The other native targets keep a notice that says
// their context menu is not built yet and give `body` back as it is.
context_menu: fn(body: UINode, items: [MenuItem]) -> UINode Never! {
    #if #build.target.os == {
        .Linux -> { return app_context_target(body, items) }
        .MacOS -> { return app_no_context_menu(body) }
        .Windows -> { return app_no_context_menu(body) }
        .Web -> { return app_context_web(body, items) }
        .Wasm -> { return app_no_context_menu(body) }
        .Freestanding -> { return app_no_context_menu(body) }
    }
}

// The context menus of the bodies in the tree the window shows, each
// one's id one past its index (`app_window_tree` starts them over).
priv APP_CONTEXT_MENUS: Shared{[AppContextMenu]{}}

priv AppContextMenu: struct {
    items: [MenuItem],
}

// A context menu open in the window, in window pixels: its top left
// corner, its width, the height of one of its rows, and its items.
priv AppOpenMenu: struct {
    x: Int,
    y: Int,
    width: Int,
    row: Int,
    items: [MenuItem],
}

// One row of a context menu, and the width of each character of a label
// beside the padding before it, in units (`ui.Frame` pixels at scale 1).
priv APP_MENU_ROW: 24

priv APP_MENU_CHAR: 9

priv APP_MENU_PAD: 8

// `body` as one whose context menu the window opens with `items`.
priv app_context_target: fn(body: UINode, items: [MenuItem]) -> UINode Never! {
    held: APP_CONTEXT_MENUS.guard_edit()
    held.value.push(AppContextMenu{items: items.copy()})
    body.__with_menu(held.value.len())
}

// Keeps the notice that this target opens no context menu; gives `body`.
priv app_no_context_menu: fn(body: UINode) -> UINode Never! {
    __keep_notice(Notice{text: "Couldn't add a context menu: this system's context menu is not built yet"})
    body.copy()
}

// `body` as one whose context menu a page opens with `items`
// (`UINode.__with_web_menu`): an enabled item is a button whose click runs
// it, its failed run's notice joining the app's notice list; a separator
// is a separator; an item not `enabled`, a notice, and Quit and the Edit
// and Window menus' items, which a page can't act on, show but can't be
// chosen.
priv app_context_web: fn(body: UINode, items: [MenuItem]) -> UINode Never! {
    entries := [UINode]{}
    loop item in items {
        if item.kind == .Separator -> entries.push(ui.node("", 0.0, 0.0)) else if item.kind == .Item && item.enabled {
            run: item.run.copy()
            entries.push(ui.button(item.label, fn() { app_context_web_run(run) }))
        } else { entries.push(ui.text(item.label)) }
    }
    body.__with_web_menu(entries)
}

// Runs the item a page's context menu chose, as the menu bar runs one.
priv app_context_web_run: fn(run: Shared<AppMenuRun>) Never! {
    held: run.guard_read()
    app_background_once(held.value.run)
}

// Starts the window's context menus over, for a tree opened anew.
priv app_context_menus_clear: fn() Never! {
    held: APP_CONTEXT_MENUS.guard_edit()
    held.value.clear()
}

// The items of the context menu whose id is `id` in the shown tree; none
// when it has no such menu.
priv app_context_items: fn(id: Int) -> [MenuItem] Never! {
    held: APP_CONTEXT_MENUS.guard_read()
    if id < 1 || id > held.value.len() -> return [MenuItem]{}
    held.value[id - 1].items.copy()
}

// A menu of `items`, opened at the pointer of `frame`, moved left and up
// as far as it must be to fit in the window; None when it has no items.
priv app_context_open: fn(frame: ui.Frame, items: [MenuItem]) -> AppOpenMenu? Never! {
    if items.len() == 0 -> return None
    widest := 0
    loop item in items {
        length: item.label.chars().len()
        if length > widest -> widest = length
    }
    width: frame.__pixels(widest * APP_MENU_CHAR + 2 * APP_MENU_PAD)
    row: frame.__pixels(APP_MENU_ROW)
    x: app_menu_fit(frame.get_mouse_x(), width, frame.width)
    y: app_menu_fit(frame.get_mouse_y(), row * items.len(), frame.height)
    Val(AppOpenMenu{x: x, y: y, width: width, row: row, items: items.copy()})
}

// Where a span `size` long that starts at `at` starts so it ends in
// `room`, as near `at` as it can.
priv app_menu_fit: fn(at: Int, size: Int, room: Int) -> Int Never! {
    if at + size <= room -> return at
    if size >= room -> return 0
    room - size
}

// The item of the open menu `open` under the pointer of `frame`, if it
// is one the person can choose.
priv app_context_chosen: fn(frame: ui.Frame, open: AppOpenMenu?) -> MenuItem? Never! {
    menu: open ?? return None
    x: frame.get_mouse_x()
    y: frame.get_mouse_y()
    if x < menu.x || x >= menu.x + menu.width || y < menu.y || menu.row < 1 -> return None
    index: (y - menu.y) /% menu.row
    if index >= menu.items.len() -> return None
    item: menu.items[index]
    if !item.enabled || item.kind == .Separator || item.kind == .Notice -> return None
    Val(item.copy())
}

// Draws the open menu `menu` into `frame`, over the screen
// (`Frame.__draw_menu`): a separator is a row with no label, and an item
// that can't be chosen shows in gray.
priv app_context_draw: fn(frame: ui.Frame, menu: AppOpenMenu) Never! {
    labels := [String]{}
    enabled := [Bool]{}
    loop item in menu.items {
        labels.push(if item.kind == .Separator -> "" else -> item.label.copy())
        enabled.push(item.enabled && item.kind != .Separator && item.kind != .Notice)
    }
    frame.__draw_menu(menu.x, menu.y, menu.width, menu.row, labels, enabled)
}

// `body` as one a person drags `value` with, named `label`: dropped on a
// body that takes a `V` (`drop_zone`), `value` goes to that body's
// `on_drop`; a drop zone that takes another type refuses it. The move
// needs no drag, too. The keyboard reaches `body`: its first leaf that is
// neither a button nor a text input joins the focus ring. Space picks it
// up, the arrow keys step it through the drop zones by their labels,
// Enter drops it on the one shown and Escape puts it back. A long press on
// it (half a second, then letting go where it began) opens a menu of the
// drop zones to move it to. On Linux the app's window (`App.window`)
// carries the move; in a web build the page does, with the browser's drag
// and drop, the same keys and, on its `contextmenu` (a long press on a
// touch screen, or the menu key), the same menu (`app_drag_web`). The
// other native targets keep a notice that says their drag and drop is not
// built yet and give `body` back as it is.
draggable: fn<V: Encode>(body: UINode, value: V, label: String) -> UINode Never! {
    #if #build.target.os == {
        .Linux -> { return app_drag_source(body, value.encode(), Type{V}, label) }
        .MacOS -> { return app_no_drag(body) }
        .Windows -> { return app_no_drag(body) }
        .Web -> { return app_drag_web(body, value.encode(), Type{V}, label) }
        .Wasm -> { return app_no_drag(body) }
        .Freestanding -> { return app_no_drag(body) }
    }
}

// `body`, named `label`, taking the values of type `V` a person drops on
// it (`draggable`), each to `on_drop`; a notice `on_drop` fails with
// joins the app's notices, as a button's does, and the window shows it.
// A value of another type, and a file or text another program drops on
// it, is refused with a notice and goes nowhere. On Linux the app's
// window (`App.window`) delivers the drops, and in a web build the page
// (`app_zone_web`); the other native targets keep a notice that says
// their drag and drop is not built yet and give `body` back as it is.
drop_zone: fn<V: Decode>(body: UINode, label: String, on_drop: ^^fn(V) Notice!) -> UINode {
    #if #build.target.os == {
        .Linux -> {
            return app_zone_target(body, label, Type{V}, app_zone_decoding<V>(on_drop.move()))
        }
        .MacOS -> { return app_no_drag(body) }
        .Windows -> { return app_no_drag(body) }
        .Web -> { return app_zone_web(body, label, Type{V}, app_zone_decoding<V>(on_drop.move())) }
        .Wasm -> { return app_no_drag(body) }
        .Freestanding -> { return app_no_drag(body) }
    }
}

// The bodies a person drags (`draggable`) and the bodies that take what
// they drop (`drop_zone`) in the tree the window shows, each one's id one
// past its index (`app_window_tree` starts them over). `kind` is the
// value's type (`Type{V}`); a drop zone takes only a value of its own.
priv APP_DRAGS: Shared{[AppDrag]{}}

priv AppDrag: struct {
    label: String,
    kind: Type,
    value: Dyn,
}

priv APP_ZONES: Shared{[AppZone]{}}

priv AppZone: struct {
    label: String,
    kind: Type,
    run: Shared<AppZoneRun>,
}

priv AppZoneRun: struct {
    run: fn(Dyn) Notice!,
}

// A press of the primary button on a body a person drags (`draggable`):
// its id, where it began, in window pixels, and when (`rt.clock_mono_ns`).
priv AppPress: struct {
    drag: Int,
    x: Int,
    y: Int,
    at: Int,
}

// A body the keyboard picked up (`draggable`) and the drop zone it shows
// it would drop on, by their ids.
priv AppPicked: struct {
    drag: Int,
    zone: Int,
}

// How long a press lasts to be a long press, and how far, in units, the
// pointer moves from where it began to be a drag.
priv APP_LONG_PRESS_NS: 500000000

priv APP_DRAG_SLOP: 4

// `on_drop` taking the encoded value it is given, decoded as a `V`.
priv app_zone_decoding: fn<V: Decode>(on_drop: ^^fn(V) Notice!) -> (fn(Dyn) Notice!) Never! {
    run: on_drop.move()
    fn(tree: Dyn) Notice! {
        value: tree.decode<V>() ?? return Err(Notice{text: "Couldn't take what was dropped: {err}"})
        run(value)
    }
}

// `body` as one a person drags `value`, of the type `kind`, with.
priv app_drag_source: fn(body: UINode, value: Dyn, kind: Type, label: String) -> UINode Never! {
    held: APP_DRAGS.guard_edit()
    held.value.push(AppDrag{label: label.copy(), kind: kind.copy(), value: value.copy()})
    body.__dragging(held.value.len())
}

// `body` as one whose drops of a value of the type `kind` go to
// `run`.
priv app_zone_target: fn(body: UINode, label: String, kind: Type, run: ^^fn(Dyn) Notice!) -> UINode Never! {
    held: APP_ZONES.guard_edit()
    held.value.push(AppZone{label: label.copy(), kind: kind.copy(), run: Shared{AppZoneRun{run: run.move()}}})
    body.__taking_drops(held.value.len())
}

// Keeps the notice that this target carries no drags; gives `body`.
priv app_no_drag: fn(body: UINode) -> UINode Never! {
    __keep_notice(Notice{text: "Couldn't add drag and drop: this system's drag and drop is not built yet"})
    body.copy()
}

// What a page's drag picked up last (`app_drag_web`), which the drop zone
// it moves onto takes (`app_zone_web`); None for nothing.
priv APP_WEB_PICKED: Shared{AppWebPicked{moved: None}}

priv AppWebPicked: struct {
    moved: AppDrag?,
}

// The kinds of value a page's dragged bodies and drop zones move
// (`Type{V}`), each one's key its index, so the page offers a body only
// the drop zones that take its kind.
priv APP_WEB_KINDS: Shared{[Type]{}}

// The key of the kind `kind` in a page (`APP_WEB_KINDS`).
priv app_web_kind: fn(kind: Type) -> Int Never! {
    held: APP_WEB_KINDS.guard_edit()
    loop index in 0..<held.value.len() {
        if held.value[index] == kind -> return index
    }
    held.value.push(kind.copy())
    held.value.len() - 1
}

// `body` as one a page drags `value`, of the type `kind`, with
// (`UINode.__dragging_in_page`): a move picks it up first, through a
// handler that holds what it moves.
priv app_drag_web: fn(body: UINode, value: Dyn, kind: Type, label: String) -> UINode Never! {
    moved: AppDrag{label: label.copy(), kind: kind.copy(), value: value.copy()}
    pick: ui.button("", fn() { app_web_pick(moved) })
    body.__dragging_in_page(pick, app_web_kind(kind), label)
}

// `body` as one whose drops in a page of a value of the type `kind` go to
// `run` (`UINode.__taking_drops_in_page`), through a handler that takes
// what the move picked up.
priv app_zone_web: fn(body: UINode, label: String, kind: Type, run: ^^fn(Dyn) Notice!) -> UINode Never! {
    target: AppZone{label: label.copy(), kind: kind.copy(), run: Shared{AppZoneRun{run: run.move()}}}
    taker: ui.button("", fn() { app_web_take(target) })
    body.__taking_drops_in_page(taker, app_web_kind(kind), label)
}

// Picks up what a page moves.
priv app_web_pick: fn(moved: AppDrag) Never! {
    held := APP_WEB_PICKED.guard_edit()
    held.value.moved = Val(moved.copy())
}

// A page's drop on the drop zone `target`: what the move picked up goes
// there (`app_move`), and with nothing picked up, a drop from elsewhere,
// the drop is refused (`app_refuse`).
priv app_web_take: fn(target: AppZone) Never! {
    picked: app_web_taken()
    if picked == .Val(moved) -> app_move(moved, target) else -> app_refuse(target)
}

// What the move picked up, which no longer is; None for nothing. Its guard
// ends before the drop zone's `on_drop` runs.
priv app_web_taken: fn() -> AppDrag? Never! {
    held := APP_WEB_PICKED.guard_edit()
    picked: held.value.moved.copy()
    held.value.moved = None
    picked
}

// Starts the window's dragged bodies and drop zones over, for a tree
// opened anew.
priv app_drags_clear: fn() Never! {
    drags: APP_DRAGS.guard_edit()
    drags.value.clear()
    zones: APP_ZONES.guard_edit()
    zones.value.clear()
}

// The dragged body whose id is `id`, if the shown tree has it.
priv app_drag: fn(id: Int) -> AppDrag? Never! {
    held: APP_DRAGS.guard_read()
    if id < 1 || id > held.value.len() -> return None
    Val(held.value[id - 1].copy())
}

// The drop zone whose id is `id`, if the shown tree has it.
priv app_zone: fn(id: Int) -> AppZone? Never! {
    held: APP_ZONES.guard_read()
    if id < 1 || id > held.value.len() -> return None
    Val(held.value[id - 1].copy())
}

// How many drop zones the shown tree has.
priv app_zones: fn() -> Int Never! {
    held: APP_ZONES.guard_read()
    held.value.len()
}

// Drops the value of the dragged body `drag` on the drop zone `zone`
// (`app_move`).
priv app_drag_drop: fn(drag: Int, zone: Int) Never! {
    moved: app_drag(drag) ?? return
    target: app_zone(zone) ?? return
    app_move(moved, target)
}

// Drops the value `moved` carries on the drop zone `target`: its
// `on_drop` takes it when it is of the zone's type, and its failure joins
// the app's notices; a value of another type is refused with a notice.
priv app_move: fn(moved: AppDrag, target: AppZone) Never! {
    if moved.kind != target.kind {
        __keep_notice(Notice{text: "Couldn't move {moved.label} to {target.label}: it doesn't take that"})
        return
    }
    held: target.run.guard_read()
    app_zone_once(held.value.run, moved.value)
}

// Gives `value` to a drop zone's `on_drop`, as a button's handler runs;
// the notice it fails with joins the app's notices.
priv app_zone_once: fn(run: fn(Dyn) Notice!, value: Dyn) Never! {
    if run(value) == .Err(notice) -> __keep_notice(notice)
}

// A drop from another program on the drop zone `zone` (0 for none)
// (`app_refuse`).
priv app_zone_refuse: fn(zone: Int) Never! {
    target: app_zone(zone) ?? return
    app_refuse(target)
}

// A drop from another program on the drop zone `target`: a drop zone
// takes only what the app's own bodies carry, so it is refused with a
// notice.
priv app_refuse: fn(target: AppZone) Never! {
    __keep_notice(Notice{text: "Couldn't drop that on {target.label}: it takes only what you move there in this app"})
}

// The menu a long press on the dragged body `drag` opens: an item for
// each drop zone, which moves it there.
priv app_drag_items: fn(drag: Int) -> [MenuItem] Never! {
    moved: app_drag(drag) ?? return [MenuItem]{}
    items := [MenuItem]{}
    loop index in 0..<app_zones() {
        zone: index + 1
        target: app_zone(zone) ?? next
        if target.kind != moved.kind -> next
        items.push(
            item("Move {moved.label} to {target.label}", fn() Notice! {
                app_drag_drop(drag, zone)
                Ok()
            }),
        )
    }
    items
}

// Whether the pointer of `frame` is more than APP_DRAG_SLOP units from
// where `press` began.
priv app_press_moved: fn(frame: ui.Frame, press: AppPress) -> Bool Never! {
    slop: frame.__pixels(APP_DRAG_SLOP)
    dx: frame.get_mouse_x() - press.x
    dy: frame.get_mouse_y() - press.y
    dx > slop || -dx > slop || dy > slop || -dy > slop
}

// The keyboard's move of the picked-up body `picked` after `key`: the
// arrow keys step it to the next or the previous drop zone, Enter drops
// it on the one shown, and Escape puts it back; None once it is down.
priv app_picked_key: fn(picked: AppPicked, key: Key) -> AppPicked? Never! {
    count: app_zones()
    if count == 0 -> return None
    if key == {
        .Right | .Down -> Val(AppPicked{drag: picked.drag, zone: picked.zone % count + 1})
        .Left | .Up -> Val(AppPicked{drag: picked.drag, zone: (picked.zone + count - 2) % count + 1})
        .Enter -> {
            app_drag_drop(picked.drag, picked.zone)
            None
        }
        .Escape -> None
        .Char(_) | .Backspace | .Tab | .Delete | .Insert | .Home | .End | .PageUp | .PageDown | .Shift | .Control | .Alt | .Super | .CapsLock | .F(_) | .Ctrl(_) | .Unknown -> Val(picked.copy())
    }
}

// Draws the picked-up body `picked` into `frame` (`Frame.__draw_picked`):
// a frame around the drop zone it would drop on in `tree`, and a bar over
// the top of the screen that says where it would go.
priv app_picked_draw: fn(frame: ui.Frame, tree: UINode, picked: AppPicked) Never! {
    moved: app_drag(picked.drag) ?? return
    target: app_zone(picked.zone) ?? return
    text: "Moving {moved.label} to {target.label}: Enter drops it, Escape puts it back"
    frame.__draw_picked(tree.__zone_place(frame, picked.zone), text, frame.__pixels(APP_NOTICE_BAR))
}

// The height of the bar the window shows the app's newest notice in, at
// its bottom (`Frame.__draw_notice`), in units.
priv APP_NOTICE_BAR: 24

// Draws the app's newest notice (`notices`) into `frame`, on a bar over
// the bottom of the screen, which a click dismisses
// (`app_notice_dismissed`). Nothing when there is none.
priv app_notice_draw: fn(frame: ui.Frame) Never! {
    listed: notices()
    if listed.len() == 0 {
        return
    }
    frame.__draw_notice(listed[listed.len() - 1].text, frame.__pixels(APP_NOTICE_BAR), false)
}

// Whether the pointer of `frame` is on the bar the window shows the
// newest notice in; if it is, the notice is dismissed (`__dismiss`).
priv app_notice_dismissed: fn(frame: ui.Frame) -> Bool Never! {
    listed: notices()
    if listed.len() == 0 -> return false
    if frame.get_mouse_y() < frame.height - frame.__pixels(APP_NOTICE_BAR) -> return false
    __dismiss(listed.len() - 1)
    true
}

// Draws `notice`, which a resume failed with (`App.lifecycle`), into
// `frame`, on a bar over the top of the screen, which a click dismisses
// (`app_resumed_dismissed`).
priv app_resumed_draw: fn(frame: ui.Frame, notice: Notice) Never! {
    frame.__draw_notice(notice.text, frame.__pixels(APP_NOTICE_BAR), true)
}

// Whether the pointer of `frame` is on the bar at the top of the window
// that shows `back`, the notice a resume failed with; if it is, the notice
// is dismissed.
priv app_resumed_dismissed: fn(frame: ui.Frame, back: ^Notice?) -> Bool Never! {
    if back == None || frame.get_mouse_y() >= frame.__pixels(APP_NOTICE_BAR) -> return false
    back = None
    true
}

// Whether the file named `name` is of a kind in `types`, as a file
// dialog matches it (`app_file_filter`): its name ends as one of the
// kind's patterns, in any case.
priv app_file_kind: fn(name: String, types: [FileType]) -> Bool Never! {
    lower: name.lower()
    loop kind in types {
        loop glob in app_file_filter(kind).globs {
            if lower.ends_with(glob.removeprefix("*")) -> return true
        }
    }
    false
}

// Asks the person where to save a file and writes `bytes` there, all at
// once, giving whether it did. The dialog suggests the name `suggested`
// and offers the kinds in `types`, the first one chosen. The person
// canceling is `false` with no notice; a file that can't be written, or
// no dialog to ask with, is `false` with a notice that names the file. On
// Linux the desktop portal's save dialog asks
// (org.freedesktop.portal.FileChooser); a page downloads the bytes under
// the name `suggested`; the other targets keep that notice.
save_file: fn(suggested: String, bytes: [U8], types: [FileType]) -[Env, FS.Write, Net, Time]> Bool {
    #if #build.target.os == {
        .Linux -> { return app_save_linux(suggested, bytes, types) }
        .MacOS -> { return app_unsaved(suggested, SAVE_UNBUILT) }
        .Windows -> { return app_unsaved(suggested, SAVE_UNBUILT) }
        .Web -> { return app_save_web(suggested, bytes, types) }
        .Wasm -> { return app_unsaved(suggested, SAVE_UNBUILT) }
        .Freestanding -> { return app_unsaved(suggested, SAVE_UNBUILT) }
    }
}

priv SAVE_UNBUILT: "this system's save dialog is not built yet"

// `save_file` on Linux: the portal's dialog, then the chosen file written
// in one step, so a failed write leaves any file that was there whole.
priv app_save_linux: fn(suggested: String, bytes: [U8], types: [FileType]) -[Env, FS.Write, Net, Time]> Bool Never! {
    bus := dbus.session(ASK_BUS_WAIT_NS) ?? return app_unsaved(suggested, "{err}")
    filters := [dbus.FileFilter]{}
    loop kind in types -> filters.push(app_file_filter(kind))
    uri: if dbus.portal_save_file(bus, "Save File", suggested, filters, ASK_WAIT_NS) == {
        .Err(err) -> {
            return app_unsaved(suggested, "{err}")
        }
        .Ok(chosen) -> chosen ?? return false
    }
    path: app_chosen_path(uri) ?? return app_unsaved(suggested, "the dialog chose {uri}, which is not a local file")
    files.write_atomic(path, bytes) ?? return app_unsaved(suggested, "{err}")
    true
}

// `save_file` in a page: the browser downloads the bytes under the name
// `suggested`, into its downloads folder or where the person says when it
// asks. A page never learns where the person kept the file, or whether they
// canceled the browser's dialog, so it is true once the browser has the
// download. With no page to download in (node runs the build), it keeps
// the notice.
priv app_save_web: fn(suggested: String, bytes: [U8], types: [FileType]) -> Bool Never! {
    if ui_rt.save_file(suggested, app_save_media(suggested, types), bytes) -> return true
    app_unsaved(suggested, "there is no page to download it in")
}

// The media type of the file `suggested`: that of the first kind in `types`
// whose pattern its name matches, else the first kind's first one.
priv app_save_media: fn(suggested: String, types: [FileType]) -> String Never! {
    if types.len() == 0 -> return "application/octet-stream"
    name: suggested.lower()
    loop kind in types {
        filter: app_file_filter(kind)
        loop (at, glob) in filter.globs {
            if name.ends_with(glob.removeprefix("*")) {
                return if at < filter.media.len() -> filter.media[at].copy() else -> filter.media[filter.media.len() - 1].copy()
            }
        }
    }
    app_file_filter(types[0]).media[0].copy()
}

// What a file dialog shows and matches for `kind`.
priv app_file_filter: fn(kind: FileType) -> dbus.FileFilter Never! {
    if kind == {
        .CSV -> dbus.FileFilter{name: "CSV", globs: [String]{"*.csv"}, media: [String]{"text/csv"}}
        .JSON -> dbus.FileFilter{name: "JSON", globs: [String]{"*.json"}, media: [String]{"application/json"}}
        .Image -> dbus.FileFilter{name: "Image", globs: [String]{"*.png", "*.jpg", "*.jpeg"}, media: [String]{"image/png", "image/jpeg"}}
    }
}

// Keeps the notice that `suggested` was not saved, and why; gives `false`.
priv app_unsaved: fn(suggested: String, why: String) -> Bool Never! {
    __keep_notice(Notice{text: "Couldn't save {suggested}: {why}"})
    false
}

// The frames `take_photo` lets the camera take; the last is the photo, so
// the camera has settled its exposure.
priv PHOTO_FRAMES: 15

// How many photos this process took.
priv PHOTOS: Shared{0}

// Takes a photo with the device's camera and gives it, or `None` when the
// person does not allow the camera, there is none, or it gave no photo. It
// asks for the camera as `ask(.Camera)` does when this process has not
// asked yet, and the answer counts as that ask's. A photo is named
// `photo-1.jpg` for the process's first. On Linux the camera portal asks,
// and the photo comes from the camera through PipeWire: GStreamer's
// `pipewiresrc` (`gst-launch-1.0`, with its PipeWire plugin) takes a few
// frames and keeps the last as a JPEG. In a page the browser asks
// (`getUserMedia`), and the photo is the browser's `ImageCapture` photo, or
// a frame of the camera's video as a JPEG where it has none; the page keeps
// it, and `read` reads it from there. On the other native targets, and with
// no page to ask in, it is `None`.
take_photo: fn() -[Env, Exec, FS, Net, Time]> PickedFile? {
    if app_asked(Permission.Camera) == .Val(known) {
        if known != .Granted -> return None
    }
    #if #build.target.os == {
        .Linux -> {
            said: app_linux_camera()
            app_settle(Permission.Camera, app_grant(said))
            if said != .Allowed -> return None
            return app_photo()
        }
        .MacOS -> { return None }
        .Windows -> { return None }
        .Web -> {
            fields: app_page_answer(WEB_DEVICE_PHOTO, "")
            app_settle(Permission.Camera, app_grant_web(app_page_first(fields)))
            if fields.len() < 3 -> return None
            number: Int.parse(fields[1]) ?? return None
            size: Int.parse(fields[2]) ?? return None
            return Val(PickedFile{name: app_photo_name(), bytes: size, media: Val(Media.Image), source: .Page(number)})
        }
        .Wasm -> { return None }
        .Freestanding -> { return None }
    }
}

// Where the device is now, or `None` when the person does not allow the
// location or no location came in time. It asks for the location as
// `ask(.Location)` does when this process has not asked yet, and the
// answer counts as that ask's. On Linux it is the first location the
// desktop portal's location session reports after the person allows it
// (GeoClue finds it). In a page it is the browser's position (the
// Geolocation API's `getCurrentPosition`, which asks). On the other native
// targets, and with no page to ask in, it is `None`.
location: fn() -[Env, Net, Time]> Place? {
    if app_asked(Permission.Location) == .Val(known) {
        if known != .Granted -> return None
    }
    #if #build.target.os == {
        .Linux -> {
            fix: app_linux_place()
            app_settle(Permission.Location, app_grant(fix.answer))
            if fix.place == .Val(at) {
                return Val(Place{latitude: at.latitude, longitude: at.longitude, accuracy_m: at.accuracy})
            }
            return None
        }
        .MacOS -> { return None }
        .Windows -> { return None }
        .Web -> {
            fields: app_page_answer(WEB_DEVICE_PLACE, "")
            app_settle(Permission.Location, app_grant_web(app_page_first(fields)))
            return app_page_place(fields, 1)
        }
        .Wasm -> { return None }
        .Freestanding -> { return None }
    }
}

// How the device is held, from its accelerometer: upright, upside down, or
// on its side with its left or its right edge up.
Orientation: enum {
    Upright,
    UpsideDown,
    LeftUp,
    RightUp,
}

// How long a stream waits for its next reading before it waits again.
priv UPDATE_WAIT_NS: 60000000000

// Where the device is each time it moves, until the loop reading the stream
// stops. It asks for the location as `ask(.Location)` does when this
// process has not asked yet, and the answer counts as that ask's; after an
// answer other than `.Granted` the stream is empty. On Linux the desktop
// portal's location session reports each place (GeoClue finds it), and the
// stream closes the session, and its bus connection with it, when it stops.
// In a page the browser's position watch reports each place, and the
// stream clears the watch when it stops. On the other native targets the
// stream is empty.
location_updates: fn() -[Env, Net, Time]> Stream<Place> {
    // One pass: each `break` ends the stream.
    loop {
        #if #build.target.os == {
            .Linux -> {
                bus := app_location_bus() ?? break
                session: dbus.open_location(bus, true, ASK_WAIT_NS) ?? dbus.PortalSession{answer: .Absent, path: ""}
                app_settle(Permission.Location, app_grant(session.answer))
                if session.path == "" -> break
                defer dbus.close_location(bus, session.path)
                if session.answer != .Allowed -> break
                loop {
                    found: if dbus.next_place(bus, session.path, UPDATE_WAIT_NS) == {
                        .Err(_) -> {
                            break
                        }
                        .Ok(got) -> got
                    }
                    if found == .Val(at) {
                        yield Place{latitude: at.latitude, longitude: at.longitude, accuracy_m: at.accuracy}
                    }
                }
            }
            .MacOS -> {}
            .Windows -> {}
            .Web -> {
                if app_location_refused() -> break
                started: app_page_answer(WEB_DEVICE_WATCH, "place")
                app_settle(Permission.Location, app_grant_web(app_page_first(started)))
                if started.len() < 2 -> break
                defer app_page_unwatch(started[1])
                loop {
                    reading: app_page_reading(started[1]) ?? break
                    if app_page_place(reading, 0) == .Val(at) {
                        yield at
                    }
                }
            }
            .Wasm -> {}
            .Freestanding -> {}
        }
        break
    }
}

// How the device is held, now and each time that changes, until the loop
// reading the stream stops. On Linux the sensor proxy (iio-sensor-proxy)
// reads the accelerometer for the app while the stream runs; the stream
// gives it back, and closes its system bus connection, when it stops. In a
// page the browser's orientation events tell it, and the stream removes its
// listener when it stops. A device with no accelerometer, and the other
// native targets, give an empty stream.
orientation_updates: fn() -[Env, Net, Time]> Stream<Orientation> {
    // One pass: each `break` ends the stream.
    loop {
        #if #build.target.os == {
            .Linux -> {
                bus := app_sensor_bus() ?? break
                // No accelerometer, or no answer: nothing to give back.
                first: dbus.claim_sensor(bus, dbus.Sensor.Accelerometer, ASK_BUS_WAIT_NS) ?? break
                defer dbus.release_sensor(bus, dbus.Sensor.Accelerometer)
                reading := dbus.DbusValue?{Val(first)}
                loop {
                    held: app_orientation(reading)
                    if held == .Val(way) {
                        yield way
                    }
                    reading = if dbus.sensor_change(bus, dbus.Sensor.Accelerometer, UPDATE_WAIT_NS) == {
                        .Err(_) -> {
                            break
                        }
                        .Ok(got) -> got
                    }
                }
            }
            .MacOS -> {}
            .Windows -> {}
            .Web -> {
                started: app_page_answer(WEB_DEVICE_WATCH, "orientation")
                if started.len() < 2 -> break
                defer app_page_unwatch(started[1])
                loop {
                    reading: app_page_reading(started[1]) ?? break
                    held: app_orientation_named(app_page_first(reading) ?? "")
                    if held == .Val(way) {
                        yield way
                    }
                }
            }
            .Wasm -> {}
            .Freestanding -> {}
        }
        break
    }
}

// Where the device points, in degrees clockwise from north, now and each
// time that changes, until the loop reading the stream stops. On Linux the
// sensor proxy reads the compass for the app while the stream runs; the
// stream gives it back, and closes its system bus connection, when it
// stops. In a page the browser's absolute orientation events tell it, and
// the stream removes its listener when it stops. A device with no compass,
// and the other native targets, give an empty stream.
heading_updates: fn() -[Env, Net, Time]> Stream<Float> {
    // One pass: each `break` ends the stream.
    loop {
        #if #build.target.os == {
            .Linux -> {
                bus := app_sensor_bus() ?? break
                // No compass, or no answer: nothing to give back.
                first: dbus.claim_sensor(bus, dbus.Sensor.Compass, ASK_BUS_WAIT_NS) ?? break
                defer dbus.release_sensor(bus, dbus.Sensor.Compass)
                reading := dbus.DbusValue?{Val(first)}
                loop {
                    if reading == .Val(value) {
                        if value == .Double(degrees) {
                            yield degrees
                        }
                    }
                    reading = if dbus.sensor_change(bus, dbus.Sensor.Compass, UPDATE_WAIT_NS) == {
                        .Err(_) -> {
                            break
                        }
                        .Ok(got) -> got
                    }
                }
            }
            .MacOS -> {}
            .Windows -> {}
            .Web -> {
                started: app_page_answer(WEB_DEVICE_WATCH, "heading")
                if started.len() < 2 -> break
                defer app_page_unwatch(started[1])
                loop {
                    reading: app_page_reading(started[1]) ?? break
                    degrees: Float.parse(app_page_first(reading) ?? "") ?? next
                    yield degrees
                }
            }
            .Wasm -> {}
            .Freestanding -> {}
        }
        break
    }
}

// Keeps `grant` as this process's answer for `permission` unless it has one.
priv app_settle: fn(permission: Permission, grant: Grant) Never! {
    if app_asked(permission) == None -> app_remember(permission, grant)
}

// The camera portal's answer; no session bus or portal is `.Absent`.
priv app_linux_camera: fn() -[Env, Net, Time]> dbus.PortalAnswer Never! {
    bus := dbus.session(ASK_BUS_WAIT_NS) ?? return dbus.PortalAnswer.Absent
    dbus.portal_camera(bus, ASK_WAIT_NS) ?? dbus.PortalAnswer.Absent
}

// The location portal's answer and first location; no session bus or
// portal is `.Absent`.
priv app_linux_place: fn() -[Env, Net, Time]> dbus.PortalFix Never! {
    nothing: dbus.PortalFix{answer: .Absent, place: None}
    bus := dbus.session(ASK_BUS_WAIT_NS) ?? return nothing
    dbus.portal_place(bus, ASK_WAIT_NS) ?? nothing
}

// The session bus that `location_updates` follows the location on, when
// this process may still be allowed it: `None` after an answer other than
// `.Granted`, and on targets other than Linux. With no session bus it is
// `None` and the location counts as restricted, as `location` has it.
priv app_location_bus: fn() -[Env, Net, Time]> dbus.DbusConnection? Never! {
    if app_location_refused() -> return None
    #if #build.target.os == {
        .Linux -> {
            bus := dbus.session(ASK_BUS_WAIT_NS) ?? return app_no_location_bus()
            return Val(bus)
        }
        .MacOS -> { return None }
        .Windows -> { return None }
        .Web -> { return None }
        .Wasm -> { return None }
        .Freestanding -> { return None }
    }
}

// Whether this process's location ask had an answer other than `.Granted`.
priv app_location_refused: fn() -> Bool Never! {
    if app_asked(Permission.Location) == .Val(known) -> return known != .Granted
    false
}

priv app_no_location_bus: fn() -> dbus.DbusConnection? Never! {
    app_settle(Permission.Location, app_grant(dbus.PortalAnswer.Absent))
    None
}

// The system bus the sensor proxy is on; `None` when there is none, and on
// targets other than Linux.
priv app_sensor_bus: fn() -[Env, Net, Time]> dbus.DbusConnection? Never! {
    #if #build.target.os == {
        .Linux -> {
            bus := dbus.system(ASK_BUS_WAIT_NS) ?? return None
            return Val(bus)
        }
        .MacOS -> { return None }
        .Windows -> { return None }
        .Web -> { return None }
        .Wasm -> { return None }
        .Freestanding -> { return None }
    }
}

// How the device is held, from the sensor proxy's accelerometer reading;
// `None` for "undefined", when it cannot tell.
priv app_orientation: fn(reading: dbus.DbusValue?) -> Orientation? Never! {
    if reading == .Val(value) {
        if value == .Text(name) -> return app_orientation_named(name)
    }
    None
}

// How the device is held, by the sensor proxy's name for it, which a page
// gives too; `None` for "undefined" and any other name.
priv app_orientation_named: fn(name: String) -> Orientation? Never! {
    if name == "normal" -> return Val(Orientation.Upright)
    if name == "bottom-up" -> return Val(Orientation.UpsideDown)
    if name == "left-up" -> return Val(Orientation.LeftUp)
    if name == "right-up" -> return Val(Orientation.RightUp)
    None
}

// How long showing a notification may take.
priv NOTIFY_WAIT_NS: 5000000000

// Why a notification isn't shown on a native system whose notification
// service the app can't reach yet.
priv NOTIFY_UNBUILT: "this system's notifications are not built yet"

// Shows a notification through the desktop's notification service on the
// session bus (`App.__notify_here`), in a task that keeps the bus
// connection until the person clicks the notification or it closes.
priv app_notify_linux: fn(title: String, body: String, open_route: String) -[Env, FS.Read, Net, Time]> Never! {
    showing: task { app_notify_show(title, body, open_route) }
    showing.detach()
}

// Shows the notification and waits until the person clicks it or it
// closes; a click opens `open_route` (`open_link`).
priv app_notify_show: fn(title: String, body: String, open_route: String) -[Env, FS.Read, Net, Time]> Never! {
    bus := dbus.session(ASK_BUS_WAIT_NS) ?? {
        app_notify_unshown(title, "{err}")
        return
    }
    app: app_graph_title()
    shown: dbus.notify(bus, app, app_desktop_id(app), title, body, NOTIFY_WAIT_NS) ?? {
        app_notify_unshown(title, "{err}")
        return
    }
    loop {
        ended: if dbus.notification_end(bus, shown, UPDATE_WAIT_NS) == {
            .Err(_) -> {
                return
            }
            .Ok(got) -> got
        }
        clicked: ended ?? next
        if clicked -> _: App{title: app_graph_title()}.open_link(open_route)
        return
    }
}

// Keeps a notice that the notification `title` couldn't be shown, and why.
priv app_notify_unshown: fn(title: String, why: String) Never! {
    __keep_notice(Notice{text: "Couldn't show the notification \"{title}\": {why}"})
}

// How long the tray waits for the session bus and its tray host, and how
// often it asks its menu again between the desktop's calls.
priv TRAY_WAIT_NS: 5000000000

priv TRAY_TICK_NS: 250000000

// Starts the graph's tray (`App.tray`), when it has one, in a task that
// keeps the session bus connection while the app runs.
priv app_tray_start: fn(title: String) -[Env, Exec.Exit, Net, Time]> Never! {
    tray: app_graph_tray() ?? return
    showing: task { app_tray_run(title, tray.icon, tray.menu) }
    showing.detach()
}

priv app_graph_tray: fn() -> AppTray? Never! {
    held: APP_GRAPH.guard_read()
    held.value.tray.copy()
}

// Puts the icon in the desktop's tray (a StatusNotifierItem) and keeps its
// menu current: it asks `menu` again every TRAY_TICK_NS and after each
// call the desktop makes, and the desktop hears when the items change.
// Choosing an item runs it (`app_menu_choose`). A desktop with no tray, or
// a bus that goes away, leaves a notice.
priv app_tray_run: fn(title: String, icon: String, menu: Shared<AppTrayMenu>) -[Env, Exec.Exit, Net, Time]> Never! {
    bus := dbus.session(TRAY_WAIT_NS) ?? return app_tray_lost("{err}")
    tray := dbus.tray_start(bus, title, icon, sys.getpid(), TRAY_WAIT_NS) ?? return app_tray_lost("{err}")
    shown := [MenuItem]{}
    loaded := [MenuItem]{}
    loop {
        held: menu.guard_read()
        failed: if app_tray_menu_make(held.value.menu) == {
            .Ok(items) -> {
                loaded = items.copy()
                String?{None}
            }
            .Err(notice) -> notice.text.copy()
        }
        shown = loaded.copy()
        if failed == .Val(text) -> shown.insert(0, app_menu_entry(text, .Notice, ""))
        dbus.menu_show(bus, tray.menu, app_menu_entries(shown, false)) ?? return app_tray_lost("{err}")
        asked: if dbus.next_call(bus, TRAY_TICK_NS) == {
            .Err(err) -> {
                return app_tray_lost("{err}")
            }
            .Ok(got) -> got
        }
        call: asked ?? next
        chosen: if dbus.tray_answer(bus, tray, call) == {
            .Err(err) -> {
                return app_tray_lost("{err}")
            }
            .Ok(got) -> got
        }
        index: chosen ?? next
        app_menu_choose(shown[index])
    }
}

// The menu entries for `items`: a notice, or an item that is not enabled,
// shows but can't be chosen. `keys` shows each item's key equivalent.
priv app_menu_entries: fn(items: [MenuItem], keys: Bool) -> [dbus.MenuEntry] Never! {
    entries := [dbus.MenuEntry]{}
    loop item in items {
        shortcut: if keys -> app_menu_key_names(item.key) else -> [String]{}
        entries.push(dbus.MenuEntry{label: item.label.copy(), enabled: item.enabled && item.kind != .Notice, separator: item.kind == .Separator, shortcut: shortcut, children: [dbus.MenuEntry]{}})
    }
    entries
}

// Runs the item the person chose: Quit ends the app, and an item's failed
// run puts its notice in the app's notice list.
priv app_menu_choose: fn(item: MenuItem) -[Exec.Exit]> Never! {
    if item.kind == .Quit -> process.exit(0)
    held: item.run.guard_read()
    app_background_once(held.value.run)
}

priv app_tray_menu_make: fn(menu: fn() -> [MenuItem] Notice!) -> [MenuItem] Notice! { menu() }

priv app_menu_nothing: fn() Notice! { Ok() }

// Keeps a notice that the tray couldn't be shown or kept, and why.
priv app_tray_lost: fn(why: String) Never! {
    __keep_notice(Notice{text: "Couldn't show the app in the tray: {why}"})
}

// Opens the graph's window (`App.window`), when it has one, in a task that
// keeps it while the app runs.
priv app_window_start: fn(title: String) -[Env, Exec.Exit, FS.Read, Net, Time]> Never! {
    size: app_graph_window() ?? return
    showing: task { app_window_run(title, size) }
    showing.detach()
}

priv app_graph_window: fn() -> AppWindow? Never! {
    held: APP_GRAPH.guard_read()
    held.value.window.copy()
}

// Shows the window until the person closes it, which ends the app. The
// window shows the current screen's tree (`app_window_tree`), opened again
// when another screen opens, and routes each event to it (`__input`), which
// keeps its focus until then; a drop on a body that takes dropped files
// (`drop_files`) gives them to its handler (`app_window_drop`). The tree is
// opened again too when a live binding the screen read changes with no
// input (`app_window_wake`), which wakes the frames. With a menu bar
// (`App.menu_bar`) the window names its menu (`app_menu_bar_start`), a key
// with an item's key equivalent chooses the item instead of going to the
// tree (`app_menu_bar_keyed`), and the items of the Edit and Window menus
// chosen from the bar wake the frames to act (`app_window_act`). The
// window taking or losing the focus brings the app to the foreground or
// the background, and the compositor showing or hiding it, and its
// closing, change the app's phase (`app_moment`); a resume that fails
// shows its notice at the top until a click there dismisses it. A frame
// draws the tree when nothing is drawn yet, the tree is new or an event
// changed it, or the window took another size. A display that is missing
// or fails leaves a notice.
priv app_window_run: fn(title: String, size: AppWindow) -[Env, Exec.Exit, FS.Read, Net, Time]> Never! {
    window: ui.open(width: size.width, height: size.height, title: title) ?? return app_window_lost("{err}")
    // Taken before the frames: a frame's wait holds the window.
    app_window_watch(window.__waker())
    app_window_keep(window)
    bar: app_graph_menu_bar()
    if bar == .Val(menus) -> app_menu_bar_start(window, menus)
    tree := ui.box([UINode]{})
    focused := -1
    drawn := false
    saved_seen := -1
    shown := AppCurrent?{None}
    open := AppOpenMenu?{None}
    back := Notice?{None}
    pressed := AppPress?{None}
    picked := AppPicked?{None}
    loop frame in window.frames() {
        stale := !drawn
        loop event in frame.events() {
            if event == .Resize(_, _) -> stale = true
            if event == .Focus(on) {
                app_moment(if on -> AppMoment.Foreground else -> AppMoment.Background)
            }
            if event == .Visible(visible) -> app_moment(AppMoment.Shown(app_visibility(visible)))
            if event == .Drop(x, y, items) -> app_window_dropped(tree, frame, x, y, items)
            if event == .PointerDown(.Right) {
                open = app_context_open(frame, app_context_items(tree.__menu_at(frame, frame.get_mouse_x(), frame.get_mouse_y())))
                stale = true
                next
            }
            if open == .Val(_) {
                // An open context menu takes the next click and Escape.
                if event == .PointerDown(.Left) {
                    chosen: app_context_chosen(frame, open)
                    open = None
                    stale = true
                    if chosen == .Val(item) {
                        _: app_window_choose(window, frame, tree, focused, item)
                    }
                    next
                }
                if event == .KeyDown(.Escape) {
                    open = None
                    stale = true
                    next
                }
            }
            if event == .PointerDown(.Left) && app_resumed_dismissed(frame, back) {
                stale = true
                next
            }
            if event == .PointerDown(.Left) && app_notice_dismissed(frame) {
                stale = true
                next
            }
            if app_window_drag(frame, tree, event, focused, pressed, picked, open) {
                stale = true
                next
            }
            if event == .KeyDown(key) {
                if app_menu_bar_keyed(frame, key) == .Val(chosen) {
                    if app_window_choose(window, frame, tree, focused, chosen) -> stale = true
                    next
                }
            }
            if tree.__input(frame, event, focused) -> stale = true
        }
        woken: app_window_take()
        loop chosen in woken.acts {
            if app_window_choose(window, frame, tree, focused, chosen) -> stale = true
        }
        if woken.copied == .Val(text) {
            if app_window_put_copy(window, text) && woken.shared {
                __keep_notice(Notice{text: "Copied the link to share it: {text}"})
            }
        }
        loop asked in woken.pastes { asked.send(app_window_clipboard(window)) ?? next }
        if woken.noticed -> stale = true
        if woken.resumed == .Val(notice) {
            back = Val(notice.copy())
            stale = true
        }
        now: app_graph_current()
        saved_ver: ui.saved_version()
        if now != shown || woken.stale || saved_ver != saved_seen {
            if now != shown {
                focused = -1
                open = None
                pressed = None
                picked = None
            }
            tree = app_window_tree(now)
            shown = now
            saved_seen = saved_ver
            stale = true
        }
        if !stale -> next
        tree.__draw(frame)
        if picked == .Val(held) -> app_picked_draw(frame, tree, held)
        if open == .Val(menu) -> app_context_draw(frame, menu)
        app_notice_draw(frame)
        if back == .Val(notice) -> app_resumed_draw(frame, notice)
        drawn = true
    }
    if window.failure() == .Val(failure) -> app_window_lost("{failure}")
    app_moment(AppMoment.Closed)
    process.exit(0)
}

// A drag's part of `event` in the window showing `tree`. A press of the
// primary button on a dragged body (`draggable`) begins one (`pressed`);
// letting go drops it on the drop zone under the pointer once it moved,
// or, after a long press where it began, opens the menu of the drop zones
// it can move to (`open`). Space picks up the focused dragged body
// (`picked`), which then takes the keys (`app_picked_key`). Whether it
// took the event, which changes what the window shows.
priv app_window_drag: fn(frame: ui.Frame, tree: UINode, event: ui.UIEvent, focused: Int, pressed: ^AppPress?, picked: ^AppPicked?, open: ^AppOpenMenu?) -[Time]> Bool Never! {
    held: picked ?? AppPicked{drag: 0, zone: 0}
    if held.drag != 0 {
        if event == .KeyDown(key) {
            picked = app_picked_key(held, key)
            return true
        }
        return false
    }
    if event == {
        .PointerDown(button) -> {
            if button != .Left -> return false
            x: frame.get_mouse_x()
            y: frame.get_mouse_y()
            drag: tree.__drag_at(frame, x, y)
            pressed = if drag == 0 -> None else -> Val(AppPress{drag: drag, x: x, y: y, at: rt.clock_mono_ns()})
            false
        }
        .PointerUp(button) -> {
            if button != .Left -> return false
            press: pressed ?? return false
            pressed = None
            if app_press_moved(frame, press) {
                zone: tree.__zone_at(frame, frame.get_mouse_x(), frame.get_mouse_y())
                if zone == 0 -> return false
                app_drag_drop(press.drag, zone)
                return true
            }
            if rt.clock_mono_ns() - press.at < APP_LONG_PRESS_NS -> return false
            open = app_context_open(frame, app_drag_items(press.drag))
            true
        }
        .KeyDown(key) -> {
            if key != .Char(' ') -> return false
            drag: tree.__focused_drag(focused)
            if drag == 0 || app_zones() == 0 -> return false
            picked = Val(AppPicked{drag: drag, zone: 1})
            true
        }
        .KeyUp(_) | .Text(_) | .Compose(_) | .PointerMove(_, _) | .Scroll(_, _) | .Resize(_, _) | .Focus(_) | .Visible(_) | .Drop(_, _, _) | .Close -> false
    }
}

// A drop from another program at (x, y), in pixels, on the window showing
// `tree`: files on a body that takes them go to it (`app_window_drop`),
// and a drop zone refuses it (`app_zone_refuse`).
priv app_window_dropped: fn(tree: UINode, frame: ui.Frame, x: Int, y: Int, items: [UIDropItem]) -[FS.Read]> Never! {
    files: tree.__files_at(frame, x, y)
    if files != 0 {
        app_window_drop(files, items)
        return
    }
    app_zone_refuse(tree.__zone_at(frame, x, y))
}

// Runs the menu item `chosen` in the window: Cut, Copy and Paste on the
// text input `focused` of `tree` (`edit_menu`), Minimize on the window,
// and any other item as the tray runs it (`app_menu_choose`). Whether the
// tree changed.
priv app_window_choose: fn(window: ui.Window, frame: ui.Frame, tree: ^UINode, focused: ^Int, chosen: MenuItem) -[Env, Exec.Exit, Net, Time]> Bool Never! {
    if chosen.kind == {
        .Cut -> {
            text: tree.__focused_text(focused) ?? return false
            window.set_clipboard_text(text) ?? return false
            tree.__set_focused_text(focused, "")
        }
        .Copy -> {
            text: tree.__focused_text(focused) ?? return false
            window.set_clipboard_text(text) ?? return false
            false
        }
        .Paste -> {
            if tree.__focused_text(focused) == None -> return false
            text: window.clipboard_text() ?? return false
            tree.__input(frame, ui.UIEvent.Text(text), focused)
        }
        .Minimize -> {
            window.minimize()
            false
        }
        .Item | .Quit | .Separator | .Notice -> {
            app_menu_choose(chosen)
            false
        }
    }
}

priv app_graph_menu_bar: fn() -> Shared<AppMenuBar>? Never! {
    held: APP_GRAPH.guard_read()
    held.value.menu_bar.copy()
}

// Serves the window's menu bar in a task that keeps its session bus
// connection while the app runs (`app_menu_bar_run`), and names the bus
// address the task gives it on the window. A desktop without a session
// bus, or whose display server shows no global menu, has the key
// equivalents alone.
priv app_menu_bar_start: fn(window: ui.Window, menus: Shared<AppMenuBar>) -[Env, Exec.Exit, Net, Time]> Never! {
    pair: tasks.__channel_new<String>()
    serving: task { app_menu_bar_run(pair.sender, menus) }
    serving.detach()
    name: pair.receiver.receive() ?? return
    _: window.__menu_address(name, dbus.MENU_PATH)
}

// Serves the window's menu bar on the session bus, first giving the bus
// name it serves under through `named`, and keeps it current: it asks
// `menus` again every TRAY_TICK_NS and after each call the desktop makes,
// and the desktop hears when the menus change. When `menus` fails the bar
// keeps its last menus under a first entry, which can't be chosen, with
// the notice's text. Choosing an item from an Edit or Window menu acts on
// the window (`app_window_act`); any other runs as the tray runs it
// (`app_menu_choose`). Without a session bus it ends at once, and a bus
// that goes away leaves a notice.
priv app_menu_bar_run: fn(named: Sender<String>, menus: Shared<AppMenuBar>) -[Env, Exec.Exit, Net, Time]> Never! {
    connection := dbus.session(TRAY_WAIT_NS) ?? return
    bar := dbus.menu_start(connection)
    named.send(connection.name.copy()) ?? return
    loaded := [Menu]{}
    loop {
        held: menus.guard_read()
        failed: if app_menu_bar_make(held.value.menus) == {
            .Ok(made) -> {
                loaded = made.copy()
                String?{None}
            }
            .Err(notice) -> notice.text.copy()
        }
        shown: app_menu_bar_shown(loaded, failed)
        dbus.menu_show(connection, bar, shown.entries) ?? return app_menu_bar_lost("{err}")
        asked: if dbus.next_call(connection, TRAY_TICK_NS) == {
            .Err(err) -> {
                return app_menu_bar_lost("{err}")
            }
            .Ok(got) -> got
        }
        call: asked ?? next
        chosen: if dbus.menu_answer(connection, bar, call) == {
            .Err(err) -> {
                return app_menu_bar_lost("{err}")
            }
            .Ok(got) -> got
        }
        index: chosen ?? next
        item: shown.items[index]
        if item.kind == .Cut || item.kind == .Copy || item.kind == .Paste || item.kind == .Minimize {
            app_window_act(item)
        } else { app_menu_choose(item) }
    }
}

// The menu bar's entries for `menus`, each a submenu of its items, under
// a first entry with the text `failed`, which can't be chosen, when the
// menus failed; and the items in the order the bar numbers its entries
// (`dbus.menu_entries`), a menu standing for its own entry.
priv app_menu_bar_shown: fn(menus: [Menu], failed: String?) -> {entries: [dbus.MenuEntry], items: [MenuItem]} Never! {
    entries := [dbus.MenuEntry]{}
    items := [MenuItem]{}
    if failed == .Val(text) {
        entries.push(dbus.MenuEntry{label: text.copy(), enabled: false, separator: false, shortcut: [String]{}, children: [dbus.MenuEntry]{}})
        items.push(app_menu_entry(text, .Notice, ""))
    }
    loop menu in menus {
        entries.push(dbus.MenuEntry{label: menu.title.copy(), enabled: true, separator: false, shortcut: [String]{}, children: app_menu_entries(menu.items, true)})
        items.push(app_menu_entry(menu.title, .Notice, ""))
        loop item in menu.items -> items.push(item.copy())
    }
    {entries: entries, items: items}
}

// The enabled item of the menu bar whose key equivalent `key` is, pressed
// in `frame` with the modifiers it holds; None without a menu bar or when
// its menus fail.
priv app_menu_bar_keyed: fn(frame: ui.Frame, key: Key) -> MenuItem? Never! {
    bar: app_graph_menu_bar() ?? return None
    held: bar.guard_read()
    menus: app_menu_bar_make(held.value.menus) ?? return None
    loop menu in menus {
        loop item in menu.items {
            if !item.enabled || item.kind == .Separator || item.kind == .Notice -> next
            shortcut: app_menu_shortcut(item.key) ?? next
            if frame.__pressed(shortcut, key) -> return Val(item.copy())
        }
    }
    None
}

priv app_menu_bar_make: fn(menus: fn() -> [Menu] Notice!) -> [Menu] Notice! { menus() }

// Keeps a notice that the menu bar couldn't be kept, and why.
priv app_menu_bar_lost: fn(why: String) Never! {
    __keep_notice(Notice{text: "Couldn't keep the app's menu bar: {why}"})
}

// The tree the window shows for the screen `now`, opened as `go` opens it,
// so the bindings its view reads are the screen's route data: an empty box
// before a screen opens and for the not-found state. The drop targets and
// context menus of the tree shown before (`drop_files`, `context_menu`) go
// with it.
priv app_window_tree: fn(now: AppCurrent?) -[FS.Read, Net]> UINode Never! {
    app_drops_clear()
    app_context_menus_clear()
    app_drags_clear()
    current: now ?? return ui.box([UINode]{})
    screen: app_screen(current.state) ?? return ui.box([UINode]{})
    me: tasks.current_task()
    resume_begin(me)
    ui.saved_scope_begin(app_saved_scope_key(current))
    shown: App{title: app_graph_title()}.__open(screen, current.fields)
    ui.saved_scope_end()
    live_drop(app_graph_route_data(resume_end(me)))
    shown ?? ui.box([UINode]{})
}

// A stable key for the screen and route fields currently shown, so `ui.saved`
// state stays bound to the screen (for example, each task's comment box).
priv app_saved_scope_key: fn(current: AppCurrent) -> String Never! {
    if current.fields.len() == 0 -> return current.state.copy()
    names := [String]{}
    loop name in current.fields.keys() -> names.push(name.copy())
    names.sort()
    parts := [String]{}
    loop name in names {
        value: current.fields.get(name) ?? ""
        parts.push("{name}={value}")
    }
    "{current.state}?{parts.join("&")}"
}

// Keeps a notice that the window couldn't be shown or kept, and why.
priv app_window_lost: fn(why: String) Never! {
    __keep_notice(Notice{text: "Couldn't show the app's window: {why}"})
}

// The window's wake (`app_window_watch`) while it shows; whether a live
// binding of the screen it shows changed since it last opened the screen,
// whether the app kept a notice since its last frame, the menu bar's items
// chosen for it to act on since that frame, the newest text the app copied
// since then (`copy_text`) and whether it shared that text (`share`), the
// pastes other tasks wait on (`paste_text`), and the newest notice a
// resume failed with (`App.lifecycle`), all taken by `app_window_take`;
// whether a wake waits for that frame; and the window itself and the task
// its frames run in (`app_window_keep`). In a page, whether the page draws
// the app's screens and the screen it last drew (`app_page_due`), with
// `stale` taken there.
priv AppWindowWake: struct {
    wakes: [Sender<Int>],
    stale: Bool,
    noticed: Bool,
    acts: [MenuItem],
    copied: String?,
    shared: Bool,
    pastes: [Sender<String?>],
    resumed: Notice?,
    woken: Bool,
    window: ui.Window?,
    task: TaskID?,
    page: Bool,
    drawn: AppCurrent?,
    saved_version: Int,
}

priv APP_WINDOW_WAKE: Shared{AppWindowWake{wakes: [Sender<Int>]{}, stale: false, noticed: false, acts: [MenuItem]{}, copied: None, shared: false, pastes: [Sender<String?>]{}, resumed: None, woken: false, window: None, task: None, page: false, drawn: None, saved_version: -1}}

// Keeps `window`, whose frames run in this task, for the clipboard
// (`copy_text`, `paste_text`).
priv app_window_keep: fn(window: ui.Window) Never! {
    held := APP_WINDOW_WAKE.guard_edit()
    held.value.window = Val(window.copy())
    held.value.task = Val(tasks.current_task())
}

// Wakes the window's frames through `waker` (`Window.__waker`) each time a
// change to the data its screen shows comes (`app_window_wake`): the code
// that changes data may not touch a file, so it sends on a channel and a
// task of the window's writes the wake.
priv app_window_watch: fn(waker: ^^sys.Fd?) -[Env, Time.Wait]> Never! {
    fd: waker ?? return
    pair: tasks.__channel_new<Int>()
    held := APP_WINDOW_WAKE.guard_edit()
    held.value.wakes = [Sender<Int>]{pair.sender}
    relaying: task { app_window_relay(pair.receiver, fd) }
    relaying.detach()
}

// Writes a wake to `waker` for each change `changes` brings, until the
// channel closes. Nothing waits for the window: a full pipe already holds
// a wake.
priv app_window_relay: fn(changes: Receiver<Int>, waker: sys.Fd) -[Env, Time.Wait]> Never! {
    loop {
        _: changes.receive() ?? return
        _: waker.write([U8]{1}, 0) ?? 0
    }
}

// What woke the window since the last call: whether a live binding of the
// screen it shows changed, so it opens the screen again, whether the app
// kept a notice, so it draws the frame again, the menu bar's items chosen
// for it to act on, in order, the newest text the app copied and whether
// it shared it, the pastes other tasks wait on, and the newest notice a
// resume failed with.
priv app_window_take: fn() -> {stale: Bool, noticed: Bool, acts: [MenuItem], copied: String?, shared: Bool, pastes: [Sender<String?>], resumed: Notice?} Never! {
    held := APP_WINDOW_WAKE.guard_edit()
    stale: held.value.stale
    noticed: held.value.noticed
    acts: held.value.acts.copy()
    copied: held.value.copied.copy()
    shared: held.value.shared
    pastes: held.value.pastes.copy()
    resumed: held.value.resumed.copy()
    held.value.stale = false
    held.value.noticed = false
    held.value.acts = [MenuItem]{}
    held.value.copied = None
    held.value.shared = false
    held.value.pastes = [Sender<String?>]{}
    held.value.resumed = None
    held.value.woken = false
    {stale: stale, noticed: noticed, acts: acts, copied: copied, shared: shared, pastes: pastes, resumed: resumed}
}

// Wakes the window's frames to draw the notice the app just kept
// (`__keep_notice`) without opening the screen again, which may keep
// the notice anew. Without a window it does nothing.
priv app_window_noticed: fn() Never! {
    held := APP_WINDOW_WAKE.guard_edit()
    if held.value.wakes.len() == 0 {
        return
    }
    held.value.noticed = true
    app_window_rouse(held.value)
}

// Wakes the window's frames to show `notice`, which a resume failed with
// (`App.lifecycle`), at the top of the window. Whether there is a window
// to show it.
priv app_window_resumed: fn(notice: Notice) -> Bool Never! {
    held := APP_WINDOW_WAKE.guard_edit()
    if held.value.wakes.len() == 0 -> return false
    held.value.resumed = Val(notice.copy())
    app_window_rouse(held.value)
    true
}

// `copy_text` on Linux: wakes the window's frames to put `text` on the
// clipboard, replacing a copy that waits for them. Without a window it
// keeps a notice.
priv app_window_copy: fn(text: String) Never! {
    if !app_window_copied(text, false) {
        __keep_notice(Notice{text: "Couldn't copy: the app has no window open"})
    }
}

// `share` on Linux, which has no share sheet: wakes the window's frames to
// copy `url` as `copy_text` does, and to keep a notice that they copied it
// once they have. Without a window it keeps a notice.
priv app_window_share: fn(url: String) Never! {
    if !app_window_copied(url, true) {
        __keep_notice(Notice{text: "Couldn't share: the app has no window open"})
    }
}

// Whether the window takes `text` to copy, `shared` or not; false without
// one.
priv app_window_copied: fn(text: String, shared: Bool) -> Bool Never! {
    held := APP_WINDOW_WAKE.guard_edit()
    if held.value.wakes.len() == 0 -> return false
    held.value.copied = Val(text.copy())
    held.value.shared = shared
    app_window_rouse(held.value)
    true
}

// Puts `text` on the clipboard through `window`; whether it did. A copy the
// display server refuses keeps a notice.
priv app_window_put_copy: fn(window: ui.Window, text: String) -[Net, Time]> Bool Never! {
    window.set_clipboard_text(text) ?? {
        __keep_notice(Notice{text: "Couldn't copy: {err}"})
        return false
    }
    true
}

// `paste_text` on Linux: the window's frames read the clipboard. In the
// window's own task, between its frames, that is now; another task asks
// them and waits for the answer. Without a window it keeps a notice and
// gives None.
priv app_window_paste: fn() -[Env, Net, Time]> String? Never! {
    shown: app_window_shown()
    if shown.window == .Val(window) && shown.mine -> return app_window_clipboard(window)
    answer: app_window_ask_paste() ?? {
        __keep_notice(Notice{text: "Couldn't paste: the app has no window open"})
        return None
    }
    answer.receive() ?? return None
}

// The window, and whether this task is the one its frames run in.
priv app_window_shown: fn() -> {window: ui.Window?, mine: Bool} Never! {
    held: APP_WINDOW_WAKE.guard_read()
    current: tasks.current_task()
    mine: if held.value.task == .Val(task) -> task == current else -> false
    {window: held.value.window.copy(), mine: mine}
}

// Asks the window's frames for the clipboard's text; where it comes. None
// without a window.
priv app_window_ask_paste: fn() -> Receiver<String?>? Never! {
    held := APP_WINDOW_WAKE.guard_edit()
    if held.value.wakes.len() == 0 -> return None
    pair: tasks.__channel_new<String?>()
    held.value.pastes.push(pair.sender)
    app_window_rouse(held.value)
    Val(pair.receiver)
}

// The clipboard's text through `window`; None when it holds none. A read
// that fails keeps a notice and gives None.
priv app_window_clipboard: fn(window: ui.Window) -[Env, Net, Time]> String? Never! {
    text: window.clipboard_text() ?? {
        __keep_notice(Notice{text: "Couldn't paste: {err}"})
        return None
    }
    if text == "" -> return None
    Val(text)
}

// Wakes the window's frames when one of the bindings `ids`, just
// invalidated or given a new value, is route data of the screen it shows
// (app_graph_route_data): its next frame opens the screen again, which
// reads them anew. In a page, the page's next draw does (`app_page_due`).
// Without a window or a page it does nothing.
priv app_window_wake: fn(ids: [Int]) Never! {
    if !app_graph_shows(ids) {
        return
    }
    held := APP_WINDOW_WAKE.guard_edit()
    if held.value.page {
        held.value.stale = true
        return
    }
    if held.value.wakes.len() == 0 {
        return
    }
    held.value.stale = true
    app_window_rouse(held.value)
}

// Wakes the window's frames to act on `chosen`, an item of its Edit or
// Window menu the person chose from the menu bar. Without a window it
// does nothing.
priv app_window_act: fn(chosen: MenuItem) Never! {
    held := APP_WINDOW_WAKE.guard_edit()
    if held.value.wakes.len() == 0 {
        return
    }
    held.value.acts.push(chosen.copy())
    app_window_rouse(held.value)
}

// Sends the window's relay (`app_window_relay`) a wake, unless one waits
// for the next frame already: what comes meanwhile joins it.
priv app_window_rouse: fn(wake: ^AppWindowWake) Never! {
    if wake.woken {
        return
    }
    wake.woken = true
    app_window_send(wake.wakes[0]).drop("the window's relay holds the channel's other end while the app runs")
}

// Sends a wake to the window's relay (`app_window_relay`).
priv app_window_send: fn(wake: Sender<Int>) Err! { wake.send(1) }

// Whether one of the bindings `ids` is route data of the screen open now.
priv app_graph_shows: fn(ids: [Int]) -> Bool Never! {
    held: APP_GRAPH.guard_read()
    loop id in ids {
        if held.value.route_data.contains(id) -> return true
    }
    false
}

#Test("a tray shows its items, a notice can't be chosen, and an item's failed run joins the notices") {
    items: [MenuItem]{item("Gate repair", fn() Notice! { Err(Notice{text: "The board is offline"}) }), separator(), app_menu_entry("Can't load", .Notice, ""), quit_item()}
    entries: app_menu_entries(items, false)
    assert_eq(entries.len(), 4)
    assert_eq(entries[0].label, "Gate repair")
    assert(entries[0].enabled && !entries[0].separator)
    assert(entries[1].separator)
    assert(!entries[2].enabled)
    assert_eq(entries[3].label, "Quit")
    before: notices().len()
    app_menu_choose(items[0])
    after: notices()
    assert_eq(after.len(), before + 1)
    assert_eq(after[after.len() - 1].text, "The board is offline")
}

// What LIFECYCLE's listeners hear of `moment`, one line per observation:
// its reason, sequence, phase after and whether it resumes the app.
priv app_lifecycle_test_hear: fn(moment: AppMoment) -> [String] Never! {
    heard := [String]{}
    if !app_observe(moment) -> return heard
    loop {
        event: app_lifecycle_next(true) ?? return heard
        heard.push("{event.reason} {event.sequence} {event.after.visibility} {event.after.execution} resumes={app_lifecycle_resuming()}")
    }
}

#Test("a run's phase follows its observations in order, one hand at a time; only a focus or a wake after away resumes it, and a repeated state is heard once") {
    app_lifecycle_graph()
    app_lifecycle_start(true)
    started: phase() ?? panic("a started run has a phase")
    assert_eq(started.sequence, 0)
    assert(started.visibility == .Unknown && started.execution == .Running, "a window's run starts running, its visibility unknown")
    assert_eq(app_lifecycle_test_hear(.Shown(.Visible)), [String]{"VisibilityChanged 1 Visible Running resumes=false"})
    assert_eq(app_lifecycle_test_hear(.Shown(.Visible)), [String]{})
    assert_eq(app_lifecycle_test_hear(.Background), [String]{})
    assert_eq(app_lifecycle_test_hear(.Foreground), [String]{"FocusRegained 2 Visible Running resumes=true"})
    assert_eq(app_lifecycle_test_hear(.Foreground), [String]{})
    assert_eq(app_lifecycle_test_hear(.Shown(.Hidden)), [String]{"VisibilityChanged 3 Hidden Running resumes=false"})
    assert_eq(app_lifecycle_test_hear(.Suspend), [String]{"SleepPreparing 4 Hidden Suspending resumes=false"})
    assert_eq(app_lifecycle_test_hear(.Suspend), [String]{})
    assert_eq(app_lifecycle_test_hear(.Wake), [String]{"Woke 5 Hidden Running resumes=true"})
    assert_eq(app_lifecycle_test_hear(.Wake), [String]{"Woke 6 Hidden Running resumes=false"})
    // Asleep, then the focus: it comes back with no wake.
    assert_eq(app_lifecycle_test_hear(.Suspend), [String]{"SleepPreparing 7 Hidden Suspending resumes=false"})
    assert_eq(app_lifecycle_test_hear(.Foreground), [String]{"FocusRegained 8 Hidden Suspending resumes=true"})
    now: phase() ?? panic("a running app has a phase")
    assert_eq(now.sequence, 8)
    // Observations made while one task hands them out wait for it, in order.
    assert(app_observe(.Wake) && app_observe(.Shown(.Visible)))
    first: app_lifecycle_next(false) ?? panic("an observation waits")
    assert(first.reason == .Woke && first.before.sequence == 8 && first.after.sequence == 9)
    assert((phase() ?? panic("published")).sequence == 9, "the phase is published before the listeners hear it")
    assert(app_lifecycle_next(false) == None, "another task leaves the handing to the one handing out")
    assert(app_observe(.Closed))
    second: app_lifecycle_next(true) ?? panic("the second observation waits")
    assert(second.reason == .VisibilityChanged && second.after.visibility == .Visible)
    closing: app_lifecycle_next(true) ?? panic("the closing waits")
    assert(closing.reason == .Closing && closing.after.visibility == .Hidden && closing.after.sequence == 11)
    assert((phase() ?? panic("published")).sequence == 11, "the closing's listeners still read its phase")
    assert(app_lifecycle_next(true) == None)
    assert(phase() == None, "a closed window's run has no phase")
    assert(!app_observe(.Wake), "nothing is heard after the window closed")
    // The next run starts its own sequence.
    app_lifecycle_start(false)
    again: phase() ?? panic("a new run has a phase")
    assert(again.instance == started.instance + 1 && again.sequence == 0 && again.visibility == .Hidden)
}

#Test("the app resumes re-running every live binding, and a failed resume with no window joins the notices") {
    binding: __live_bind<Int, AppError>("app.test.resumed", [String]{}, fn() { resume_test_square() })
    _: state(binding)
    assert(live_current(binding.id, rt.clock_mono_ns()).value != None, "a binding just read is current")
    before: notices().len()
    app_resume_run(Val(Shared{AppResume{run: fn() Notice! { Err(Notice{text: "Couldn't refresh the board"}) }}}))
    assert(live_current(binding.id, rt.clock_mono_ns()).value == None, "coming back made the binding re-run")
    after: notices()
    assert_eq(after.len(), before + 1)
    assert_eq(after[after.len() - 1].text, "Couldn't refresh the board")
    // Without an on_resume, coming back keeps no notice.
    app_resume_run(None)
    assert_eq(notices().len(), after.len())
}

#Test("a drop zone takes only its own type and refuses another program's drop, and every move works without a drag") {
    app_drags_clear()
    _: draggable<Int>(ui.text("card"), value: 7, label: "Ship it")
    _: draggable<String>(ui.text("note"), value: "Standup notes", label: "Standup notes")
    _: drop_zone<Int>(ui.text("doing"), label: "Doing", on_drop: fn(task: Int) Notice! { Err(Notice{text: "Doing took {task}"}) })
    _: drop_zone<String>(ui.text("notes"), label: "Notes", on_drop: fn(text: String) Notice! { Err(Notice{text: "Notes took {text}"}) })
    app_drag_drop(1, 1)
    shown := notices()
    assert_eq(shown[shown.len() - 1].text, "Doing took 7")
    app_drag_drop(2, 1)
    shown = notices()
    assert_eq(shown[shown.len() - 1].text, "Couldn't move Standup notes to Doing: it doesn't take that")
    app_zone_refuse(2)
    shown = notices()
    assert_eq(shown[shown.len() - 1].text, "Couldn't drop that on Notes: it takes only what you move there in this app")
    // A long press lists only the zones that take the value.
    labels := [String]{}
    loop entry in app_drag_items(1) -> labels.push(entry.label.copy())
    assert_eq(labels.join("|"), "Move Ship it to Doing")
    app_menu_choose(app_drag_items(2)[0])
    shown = notices()
    assert_eq(shown[shown.len() - 1].text, "Notes took Standup notes")
    // The keyboard steps through every zone, wrapping, and Enter drops.
    picked: AppPicked{drag: 1, zone: 1}
    right: app_picked_key(picked, .Right) ?? AppPicked{drag: 0, zone: 0}
    assert_eq(right.zone, 2)
    wrapped: app_picked_key(right, .Down) ?? AppPicked{drag: 0, zone: 0}
    assert_eq(wrapped.zone, 1)
    left: app_picked_key(picked, .Left) ?? AppPicked{drag: 0, zone: 0}
    assert_eq(left.zone, 2)
    if app_picked_key(picked, .Escape) == .Val(_) -> assert(false)
    if app_picked_key(picked, .Enter) == .Val(_) -> assert(false)
    shown = notices()
    assert_eq(shown[shown.len() - 1].text, "Doing took 7")
    app_drags_clear()
    assert_eq(app_zones(), 0)
}

#Test("a page's drop zone takes what the move picked up, refuses another type, and refuses a drop with nothing picked up") {
    assert_eq(app_web_kind(Type{Int}), app_web_kind(Type{Int}))
    assert(app_web_kind(Type{Int}) != app_web_kind(Type{String}))
    doing: AppZone{label: "Doing", kind: Type{Int}, run: Shared{AppZoneRun{run: app_zone_decoding<Int>(fn(task: Int) Notice! { Err(Notice{text: "Doing took {task}"}) })}}}
    app_web_pick(AppDrag{label: "Ship it", kind: Type{Int}, value: 7.encode()})
    app_web_take(doing)
    shown := notices()
    assert_eq(shown[shown.len() - 1].text, "Doing took 7")
    app_web_take(doing)
    shown = notices()
    assert_eq(shown[shown.len() - 1].text, "Couldn't drop that on Doing: it takes only what you move there in this app")
    app_web_pick(AppDrag{label: "Standup notes", kind: Type{String}, value: "Standup notes".encode()})
    app_web_take(doing)
    shown = notices()
    assert_eq(shown[shown.len() - 1].text, "Couldn't move Standup notes to Doing: it doesn't take that")
}

#Test("a menu bar's menus hold their items with their keys, and a key equivalent names its keys") {
    file: menu("File", [MenuItem]{item("New Task", app_menu_nothing, key: "Cmd+N"), item("Export", app_menu_nothing, key: "Cmd+Shift+E", enabled: false), separator(), quit_item()})
    shown: app_menu_bar_shown([Menu]{file, edit_menu(), window_menu()}, String?{None})
    assert_eq(shown.entries.len(), 3)
    assert_eq(shown.entries[0].label, "File")
    assert_eq(shown.entries[0].children[0].shortcut, [String]{"Control", "n"})
    assert_eq(shown.entries[0].children[1].shortcut, [String]{"Control", "Shift", "e"})
    assert(!shown.entries[0].children[1].enabled)
    assert(shown.entries[0].children[2].separator)
    labels := [String]{}
    loop entry in dbus.menu_entries(shown.entries) -> labels.push(entry.label.copy())
    assert_eq(labels.join("|"), "File|New Task|Export||Quit|Edit|Cut|Copy|Paste|Window|Minimize|Close")
    kinds := [String]{}
    loop chosen in shown.items -> kinds.push(chosen.label.copy())
    assert_eq(kinds.join("|"), labels.join("|"))
    assert_eq(shown.items[10].kind, MenuItemKind.Minimize)
    failed: app_menu_bar_shown([Menu]{edit_menu()}, Val("The board is offline"))
    assert_eq(failed.entries[0].label, "The board is offline")
    assert(!failed.entries[0].enabled)
    assert_eq(failed.items[2].kind, MenuItemKind.Cut)
    assert_eq(app_menu_key_names("Ctrl+Alt+Super+F5"), [String]{"Control", "Alt", "Super", "f5"})
    assert_eq(app_menu_shortcut("Cmd+Shift+E"), Val(UIShortcut{key: "e", modifiers: UIShortcutModifiers{bits: 20}}))
    assert_eq(app_menu_shortcut(""), UIShortcut?{None})
}

#Test("a picked file has its name, size and media, and reads whole, as text and a part at a time") {
    folder: "{sys.temp_dir()}/jet-picked-{sys.getpid()}"
    files.create_dir_all(folder) ?? panic("folder: {err}")
    path: "{folder}/tasks 1.csv"
    files.write(path, "title,notes\nGate repair,hinge\n") ?? panic("write: {err}")
    assert_eq(app_chosen_path("file://{folder}/tasks%201.csv"), Val(path.copy()))
    assert_eq(app_chosen_path("https://example.com/tasks.csv"), String?{None})
    file: app_picked(path) ?? panic("picked: {err}")
    assert_eq(file.name, "tasks 1.csv")
    assert_eq(file.bytes, 30)
    assert_eq(file.media, Val(Media.Text))
    assert_eq(file.text() ?? panic("text: {err}"), "title,notes\nGate repair,hinge\n")
    assert_eq(file.read() ?? panic("read: {err}"), "title,notes\nGate repair,hinge\n".bytes())
    parts := file.stream() ?? panic("stream: {err}")
    assert_eq(parts.read_bytes(12) ?? panic("part: {err}"), "title,notes\n".bytes())
    assert_eq(parts.read_bytes(100) ?? panic("rest: {err}"), "Gate repair,hinge\n".bytes())
    assert_eq(parts.read_bytes(100) ?? panic("end: {err}"), [U8]{})
    files.remove_all(folder) ?? panic("clean: {err}")
}

#Test("a drop on a window's body that takes files gives its handler the local files of its kinds once, in order") {
    folder: "{sys.temp_dir()}/jet-dropped-{sys.getpid()}"
    files.create_dir_all(folder) ?? panic("folder: {err}")
    files.write("{folder}/tasks 1.csv", "id,title\n1,Fix the gate\n") ?? panic("write: {err}")
    files.write("{folder}/BOARD.CSV", "id\n") ?? panic("write: {err}")
    files.write("{folder}/notes.txt", "notes\n") ?? panic("write: {err}")
    app_drops_clear()
    _: drop_files(
        ui.box([UINode]{}),
        [FileType]{.CSV},
        fn(dropped: [PickedFile]) Notice! {
            names := [String]{}
            loop file in dropped -> names.push("{file.name} {file.bytes}")
            Err(Notice{text: names.join(", ")})
        },
    )
    items: [UIDropItem]{.URI{value: "file://{folder}/tasks%201.csv"}, .Text{value: "id,title"}, .URI{value: "file://{folder}/notes.txt"}, .URI{value: "https://example.com/a.csv"}, .URI{value: "file://{folder}/BOARD.CSV"}}
    before: notices().len()
    app_window_drop(1, items)
    after: notices()
    assert_eq(after.len(), before + 1)
    assert_eq(after[after.len() - 1].text, "tasks 1.csv 24, BOARD.CSV 3")
    // No file of its kinds, or no body that takes files, calls nothing.
    app_window_drop(1, [UIDropItem]{.URI{value: "file://{folder}/notes.txt"}})
    app_window_drop(0, items)
    app_window_drop(2, items)
    assert_eq(notices().len(), before + 1)
    app_drops_clear()
    files.remove_all(folder) ?? panic("clean: {err}")
}

#Test("a kept folder is found again by its key, by its path or its document portal ID, until it is gone") {
    assert_eq(app_folder_form("/srv/crew/Exports", "/run/user/1000"), "path:/srv/crew/Exports")
    assert_eq(app_folder_form("/run/user/1000/doc/4f2a/Exports", "/run/user/1000"), "doc:4f2a/Exports")
    assert_eq(app_folder_form("/run/user/1000/doc/4f2a/Exports", ""), "path:/run/user/1000/doc/4f2a/Exports")
    assert_eq(app_folder_path("doc:4f2a/Exports", "/run/user/1001"), Val("/run/user/1001/doc/4f2a/Exports"))
    assert_eq(app_folder_path("path:/srv/crew/Exports", ""), Val("/srv/crew/Exports"))
    assert_eq(app_folder_path("doc:4f2a/Exports", ""), String?{None})
    assert_eq(app_folder_path("Exports", "/run/user/1000"), String?{None})
    folder: "{sys.temp_dir()}/jet-folder-{sys.getpid()}"
    files.create_dir_all("{folder}/Exports") ?? panic("folder: {err}")
    assert(kept_folder("exports") == PickedFolder?{None}, "nothing is kept under a new key")
    PickedFolder{name: "Exports", source: .Path("{folder}/Exports")}.keep("exports")
    kept: kept_folder("exports") ?? panic("the folder kept as `exports` is found")
    assert_eq(kept.name, "Exports")
    kept.write("board.csv", "title\nFix the gate\n".bytes()) ?? panic("write: {err}")
    refused := false
    if kept.write("../board.csv", [U8]{}) == .Err(_) -> refused = true
    assert(refused, "a name with a `/` would leave the folder")
    listed: kept.files() ?? panic("files: {err}")
    assert_eq(listed.len(), 1)
    assert_eq(listed[0].name, "board.csv")
    assert_eq(listed[0].bytes, 19)
    files.remove_all(folder) ?? panic("clean: {err}")
    assert(kept_folder("exports") == PickedFolder?{None}, "a folder that is gone is not found")
}

// The name of the process's next photo: `photo-1.jpg` for its first.
priv app_photo_name: fn() -> String Never! {
    held := PHOTOS.guard_edit()
    held.value += 1
    "photo-{held.value}.jpg"
}

// A photo from the camera through PipeWire, kept in a directory of this
// process's under the temporary directory. The camera has 30 seconds.
priv app_photo: fn() -[Env, Exec, FS, Time]> PickedFile? Never! {
    name: app_photo_name()
    folder: "{sys.temp_dir()}/jet-photos-{sys.getpid()}"
    files.create_dir_all(folder) ?? return None
    path: "{folder}/{name}"
    argv: [String]{"gst-launch-1.0", "-q", "pipewiresrc", "num-buffers={PHOTO_FRAMES}", "!", "videoconvert", "!", "jpegenc", "!", "multifilesink", "location={path}"}
    ran: process.cmd(argv).timeout(30s).run() ?? return None
    if ran.code != 0 -> return None
    photo: files.read_bytes(path) ?? return None
    if photo.len() == 0 -> return None
    Val(PickedFile{name: name, bytes: photo.len(), media: Val(Media.Image), source: .Path(path)})
}

