#Test("RFC 8291 Appendix A: the example push encrypts to the example body") {
    rng := push_test_rng()
    sender: push_key_pair(push_b64("yfWPiYE-n46HLnH0KqZOF1fJJU3MYrct3AELtAQ-oRw"), rng) ?? panic("the sender's key")
    assert(sender.public == push_b64("BP4z9KsN6nGRTbVYI_c7VJSPQTBtkgcy27mlmlMoZIIgDll6e3vCYLocInmYWAmS6TlzAC8wEqKK6PBru3jl7A8"))
    ua_public: push_b64("BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4")
    auth_secret: push_b64("BTBZMqHH6r4Tts7J_aSIgg")
    salt: push_b64("DGv6ra1nlYgDCS1FRnbzlw")
    body: push_web_encrypt("When I grow up, I want to be a watermelon".bytes(), ua_public, auth_secret, sender, salt, rng) ?? panic("the example push seals")
    assert_eq(base64.encode_url(body), "DGv6ra1nlYgDCS1FRnbzlwAAEABBBP4z9KsN6nGRTbVYI_c7VJSPQTBtkgcy27mlmlMoZIIgDll6e3vCYLocInmYWAmS6TlzAC8wEqKK6PBru3jl7A_yl95bQpu6cVPTpK4Mqgkf1CXztLVBSt2Ks3oZwbuwXPXLWyouBWLVWGNWQexSgSxsj_Qulcy4a-fN")
}

#Test("A push opens with the subscription's key, and a fresh seal differs each time") {
    rng := push_test_rng()
    ua: push_key_pair(push_b64("q1dXpw3UpT5VOmu_cf_v6ih07Aems3njxI-JWgLcM94"), rng) ?? panic("the subscription's key")
    auth_secret: push_b64("BTBZMqHH6r4Tts7J_aSIgg")
    first: push_web_seal("ping".bytes(), ua.public, auth_secret, rng) ?? panic("the first push seals")
    second: push_web_seal("ping".bytes(), ua.public, auth_secret, rng) ?? panic("the second push seals")
    assert(first != second)
    assert_eq(first.len(), 16 + 4 + 1 + 65 + 4 + 1 + 16)
    want := "ping".bytes()
    want.push(U8{2})
    assert_eq(push_test_open(first, ua, auth_secret), want)
}

#Test("A payload longer than one record, and keys of the wrong size, are refused") {
    rng := push_test_rng()
    ua: push_key_pair(push_b64("q1dXpw3UpT5VOmu_cf_v6ih07Aems3njxI-JWgLcM94"), rng) ?? panic("the subscription's key")
    auth_secret: push_b64("BTBZMqHH6r4Tts7J_aSIgg")
    long := [U8]{}
    loop _ in 0..<(PUSH_PAYLOAD_MAX + 1) -> long.push(U8{120})
    too_long: if push_web_seal(long, ua.public, auth_secret, rng) == {
        .Ok(_) -> ""
        .Err(e) -> e.reason
    }
    assert_eq(too_long, "a push payload is at most 3993 bytes, not 3994")
    _: long.pop()
    assert(push_web_seal(long, ua.public, auth_secret, rng) == .Ok(_))
    short_key: if push_web_seal("ping".bytes(), cipher.bytes_of(ua.public, 0, 64), auth_secret, rng) == {
        .Ok(_) -> ""
        .Err(e) -> e.reason
    }
    assert_eq(short_key, "a subscription's public key is 65 bytes, not 64")
}

#Test("RFC 6979 A.2.5: ES256 of \"sample\" is the example's r and s") {
    rng := push_test_rng()
    private: bn.write_binary(bn.read_string(16, "C9AFA9D845BA75166B5C215767B1D6934E50C3DB36E89B127B8A622B120F6721") ?? panic("x"), 32) ?? panic("x bytes")
    got: push_es256(private, "sample".bytes(), rng) ?? panic("sign")
    r: bn.write_binary(bn.read_string(16, "EFD48B2AACB6A8FD1140DD9CD45E81D69D2C877B56AAF991C34D0EA84EAF3716") ?? panic("r"), 32) ?? panic("r bytes")
    s: bn.write_binary(bn.read_string(16, "F7CB1C942D657C41D436C7A1B6E29F65F3E900DBB9AFF4064DC4AB2F843ACDA8") ?? panic("s"), 32) ?? panic("s bytes")
    want := r.copy()
    want.extend(s)
    assert_eq(got, want)
}

#Test("A VAPID header carries a token its key verifies, with the push service's origin") {
    rng := push_test_rng()
    sender: push_key_pair(push_b64("yfWPiYE-n46HLnH0KqZOF1fJJU3MYrct3AELtAQ-oRw"), rng) ?? panic("the sender's key")
    header: push_vapid_authorization("https://push.example.net", "mailto:push@example.com", 1700000000, 1700043200, sender, rng) ?? panic("the header signs")
    key_part: ", k={base64.encode_url(sender.public)}"
    assert(header.starts_with("vapid t="))
    assert(header.ends_with(key_part))
    token: String.from_bytes(cipher.bytes_of(header.bytes(), 8, header.len() - 8 - key_part.len())) ?? panic("token text")
    claims: push_test_jwt_claims(token, "{{\"typ\":\"JWT\",\"alg\":\"ES256\"}}", sender.public)
    assert_eq(claims, "{{\"aud\":\"https://push.example.net\",\"exp\":1700043200,\"sub\":\"mailto:push@example.com\"}}")
    late: if push_vapid_authorization("https://push.example.net", "mailto:push@example.com", 1700000000, 1700000000 + PUSH_VAPID_MAX_SECONDS + 1, sender, rng) == {
        .Ok(_) -> ""
        .Err(e) -> e.reason
    }
    assert_eq(late, "a VAPID token expires within 24 hours, not in 86401 seconds")
}

#Test("Generators seeded from the system entropy source draw different keys") {
    first_rng := push_rng() ?? panic("the system entropy source")
    second_rng := push_rng() ?? panic("the system entropy source")
    first: push_key_pair_new(first_rng) ?? panic("the first key")
    second: push_key_pair_new(second_rng) ?? panic("the second key")
    assert(first.public != second.public)
    assert_eq(first.public.len(), 65)
}

#Test("A collapse key is 32 base64url characters of its run, recipient and state") {
    key: push_collapse_key("Crew.remind_due_today@29170080", "acct_ann", "{{\"TaskView\":{{\"id\":7}}}}")
    assert_eq(key, "pFQJvnnN1Np_dA1rXFXz9-kChARR6hdC")
    assert(push_collapse_key("Crew.remind_due_today@29170080", "acct_ann", "{{\"TaskView\":{{\"id\":8}}}}") != key)
    assert(push_collapse_key("Crew.remind_due_today@29170140", "acct_ann", "{{\"TaskView\":{{\"id\":7}}}}") != key)
    // The parts are length-prefixed: moving a byte between them changes it.
    assert_eq(push_collapse_key("ab", "c", ""), "EYqH7y1LOewmi9aeInkSJU9tmdHxP4ZM")
    assert_eq(push_collapse_key("a", "bc", ""), "jc5kwA44pgiD66SQRk6rk0Fx2n4S1HSY")
}

#Test("An APNs push carries a provider token its .p8 key verifies, and the collapse key") {
    rng := push_test_rng()
    private: push_ec_private(push_test_apns_key(), rng) ?? panic("the .p8 key")
    sender: push_key_pair(private, rng) ?? panic("the key pair")
    token: push_apns_token("TEAM123456", "KEY1234567", 1700000000, private, rng) ?? panic("the provider token signs")
    assert_eq(push_test_jwt_claims(token, "{{\"alg\":\"ES256\",\"kid\":\"KEY1234567\"}}", sender.public), "{{\"iss\":\"TEAM123456\",\"iat\":1700000000}}")
    request: push_apns_request("https://api.push.apple.com", "a1b2c3", "com.example.crew", token, "pFQJvnnN1Np_dA1rXFXz9-kChARR6hdC", "Due \"today\"", "Ship v2", "{{\"TaskView\":{{\"id\":7}}}}")
    assert_eq(request.url, "https://api.push.apple.com/3/device/a1b2c3")
    assert_eq(push_test_header(request, "authorization"), "bearer {token}")
    assert_eq(push_test_header(request, "apns-topic"), "com.example.crew")
    assert_eq(push_test_header(request, "apns-push-type"), "alert")
    assert_eq(push_test_header(request, "apns-collapse-id"), "pFQJvnnN1Np_dA1rXFXz9-kChARR6hdC")
    body: String.from_bytes(request.body) ?? panic("body text")
    assert_eq(body, "{{\"aps\":{{\"alert\":{{\"title\":\"Due \\\"today\\\"\",\"body\":\"Ship v2\"}}}},\"open\":\"{{\\\"TaskView\\\":{{\\\"id\\\":7}}}}\"}}")
    rsa: if push_ec_private(push_test_fcm_key(), rng) == {
        .Ok(_) -> ""
        .Err(e) -> e.reason
    }
    assert_eq(rsa, "the key is no EC key")
}

#Test("An FCM push trades an RS256 assertion for a token, and tags the notification with the collapse key") {
    rng := push_test_rng()
    exchange: push_fcm_token_request("push@crew-test.iam.gserviceaccount.com", "https://oauth2.googleapis.com/token", 1700000000, push_test_fcm_key(), rng) ?? panic("the assertion signs")
    assert_eq(exchange.url, "https://oauth2.googleapis.com/token")
    assert_eq(push_test_header(exchange, "content-type"), "application/x-www-form-urlencoded")
    // RSASSA-PKCS1-v1_5 is deterministic: `openssl dgst -sha256 -sign` of the
    // signing input with the test key gives this assertion.
    assertion: "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJwdXNoQGNyZXctdGVzdC5pYW0uZ3NlcnZpY2VhY2NvdW50LmNvbSIsInNjb3BlIjoiaHR0cHM6Ly93d3cuZ29vZ2xlYXBpcy5jb20vYXV0aC9maXJlYmFzZS5tZXNzYWdpbmciLCJhdWQiOiJodHRwczovL29hdXRoMi5nb29nbGVhcGlzLmNvbS90b2tlbiIsImlhdCI6MTcwMDAwMDAwMCwiZXhwIjoxNzAwMDAzNjAwfQ.IPr9LmHwt0FxWx2bqQe3Pq_Th9CwoYJyX1cftU5tfvW993CfUBRfEa8l8yCfE8fF1GYRbw-fjgIh57MofCuJlf-U9CoS7rE67I-jRPpFy1o0WBVF3EUbh__yLxi1CpmzQsIGIgaQptjpCVycF5KVovj4PgdaNi4bHot71lOA8eaNiWHsWMNn197rf3BlvTr8-9diHBdLKsQeMuN5UaPBw-09ngIqAHwbwD_SQq2KiGtNquF6TYCwweAVMFWdmtaDtJARU8DLZmyPDCrrRFsCOnK4nSLFlBXGE1WZpE2WWULB2uZbuG-cSRiXYxkL3ftXm-vRJDOKspdwpilvhA-jVQ"
    assert_eq(String.from_bytes(exchange.body) ?? panic("form text"), "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Ajwt-bearer&assertion={assertion}")
    request: push_fcm_request("https://fcm.googleapis.com", "crew-test", "ya29.token", "dev-1", "pFQJvnnN1Np_dA1rXFXz9-kChARR6hdC", "Due today", "Ship v2", "{{\"TaskView\":{{\"id\":7}}}}")
    assert_eq(request.url, "https://fcm.googleapis.com/v1/projects/crew-test/messages:send")
    assert_eq(push_test_header(request, "authorization"), "Bearer ya29.token")
    body: String.from_bytes(request.body) ?? panic("body text")
    assert_eq(body, "{{\"message\":{{\"token\":\"dev-1\",\"notification\":{{\"title\":\"Due today\",\"body\":\"Ship v2\"}},\"android\":{{\"notification\":{{\"tag\":\"pFQJvnnN1Np_dA1rXFXz9-kChARR6hdC\"}}}},\"data\":{{\"open\":\"{{\\\"TaskView\\\":{{\\\"id\\\":7}}}}\"}}}}}}")
}

#Test("A Web Push request is sealed to the subscription, signed for its origin and topped with the collapse key") {
    rng := push_test_rng()
    ua: push_key_pair(push_b64("q1dXpw3UpT5VOmu_cf_v6ih07Aems3njxI-JWgLcM94"), rng) ?? panic("the subscription's key")
    sender: push_key_pair(push_b64("yfWPiYE-n46HLnH0KqZOF1fJJU3MYrct3AELtAQ-oRw"), rng) ?? panic("the sender's key")
    to: PushSubscription{endpoint: "https://push.example.net:8443/wpush/v2/abc", public: ua.public.copy(), auth_secret: push_b64("BTBZMqHH6r4Tts7J_aSIgg")}
    request: push_web_request(to, sender, "mailto:push@example.com", 1700000000, "pFQJvnnN1Np_dA1rXFXz9-kChARR6hdC", "Due today", "Ship v2", "{{\"TaskView\":{{\"id\":7}}}}", rng) ?? panic("the push seals")
    assert_eq(request.url, "https://push.example.net:8443/wpush/v2/abc")
    assert_eq(push_test_header(request, "topic"), "pFQJvnnN1Np_dA1rXFXz9-kChARR6hdC")
    assert_eq(push_test_header(request, "ttl"), "86400")
    assert_eq(push_test_header(request, "content-encoding"), "aes128gcm")
    authorization: push_test_header(request, "authorization")
    key_part: ", k={base64.encode_url(sender.public)}"
    token: String.from_bytes(cipher.bytes_of(authorization.bytes(), 8, authorization.len() - 8 - key_part.len())) ?? panic("token text")
    assert_eq(push_test_jwt_claims(token, "{{\"typ\":\"JWT\",\"alg\":\"ES256\"}}", sender.public), "{{\"aud\":\"https://push.example.net:8443\",\"exp\":1700043200,\"sub\":\"mailto:push@example.com\"}}")
    want := "{{\"title\":\"Due today\",\"body\":\"Ship v2\",\"tag\":\"pFQJvnnN1Np_dA1rXFXz9-kChARR6hdC\",\"open\":\"{{\\\"TaskView\\\":{{\\\"id\\\":7}}}}\"}}".bytes()
    want.push(U8{2})
    assert_eq(push_test_open(request.body, ua, to.auth_secret), want)
    assert_eq(push_origin("http://127.0.0.1:9000/push/1"), .Val("http://127.0.0.1:9000"))
    assert_eq(push_origin("https://push.example.net"), .Val("https://push.example.net"))
    assert_eq(push_origin("ftp://push.example.net/x"), None)
    assert_eq(push_origin("https:///x"), None)
}
