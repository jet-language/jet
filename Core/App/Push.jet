// Private Core source part: the wire forms of a push notification, and
// the senders that send them. A push goes to APNs, to FCM or to a
// browser's push service (Web Push), as one HTTP POST each. A Web Push
// payload is encrypted to the browser's subscription (RFC 8291, the
// aes128gcm content coding of RFC 8188), and the application server proves
// who sends it with a VAPID token (RFC 8292). APNs takes an ES256 provider
// token over HTTP/2, and FCM an OAuth 2.0 access token that a service
// account's RS256 assertion buys (RFC 7523). Each push carries a collapse
// key, so a repeated run replaces the push it sent before.
use {
    core
    bn: __core_crypto_bignum
    __core_crypto_bignum.[RNG]
    cipher: __core_crypto_cipher
    aead: __core_crypto_aead
    hashes: __core_crypto_md
    drbg: __core_crypto_drbg
    ecp: __core_crypto_ecp
    ecdh: __core_crypto_ecdh
    ecdsa: __core_crypto_ecdsa
    pk: __core_crypto_pk
    pkparse: __core_crypto_pkparse
    base64: core.encoding.base64
    http: core.http
    client: core.http.client
    h2: __core_http_h2
    net: core.net
}

/// The record size of an encrypted push: one record holds the whole
/// payload (RFC 8291 section 4).
PUSH_RECORD_SIZE: 4096

/// The longest payload one push carries: the record less the header (86
/// bytes), the padding delimiter and the 16-byte tag (RFC 8291 section 4).
PUSH_PAYLOAD_MAX: 3993

/// The longest a VAPID token may stay valid: 24 hours (RFC 8292 section 2).
PUSH_VAPID_MAX_SECONDS: 86400

/// How long a push service keeps a Web Push it cannot deliver yet: a day.
PUSH_WEB_TTL_SECONDS: 86400

/// The OAuth 2.0 scope an FCM access token needs.
PUSH_FCM_SCOPE: "https://www.googleapis.com/auth/firebase.messaging"

/// Why a push could not be sealed or signed: a key or a secret has the
/// wrong length or form, the payload is longer than one push record holds,
/// or the system entropy source failed.
#Error
PushError: struct {
    reason: String

    impl Display {
        display: fn(self) -> String { self.reason }
    }
}

/// An application server's P-256 key pair: the 32-byte private scalar and
/// the 65-byte uncompressed public point.
PushKeyPair: struct {
    #Redact private: [U8]
    public: [U8]
}

/// A browser's push subscription: the push service's `endpoint` URL, its
/// P-256 public key (65 bytes) and its authentication secret (16 bytes).
PushSubscription: struct {
    endpoint: String
    public: [U8]
    auth_secret: [U8]
}

/// One HTTP request of a push: a POST of `body` to `url`.
PushRequest: struct {
    url: String
    headers: [PushHeader]
    body: [U8]
}

PushHeader: struct {
    name: String
    value: String
}

/// A random generator seeded from the system entropy source, for the keys
/// and the salt of each push.
push_rng: fn() -> drbg.HMACDrbg PushError! {
    seed := core.net.tls.__host_entropy(48) ?? return Err(push_fail("the system entropy source failed"))
    if seed.len() != 48 {
        core.crypto.wipe(seed)
        return Err(push_fail("the system entropy source failed"))
    }
    rng := drbg.hmac_drbg_new(.SHA256)
    drbg.hmac_drbg_seed_buf(rng, seed)
    core.crypto.wipe(seed)
    Ok(rng)
}

/// The key pair whose private scalar is `private` (32 bytes).
push_key_pair: fn<R: RNG>(private: [U8], rng: &R) -> PushKeyPair PushError! {
    grp: push_group() ?? return Err(err)
    d: push_scalar(grp, private) ?? return Err(err)
    q: ecp.ecp_mul(grp, d, grp.g, rng) ?? return Err(push_fail("the private key gives no public point"))
    public: ecp.point_write_binary(grp, q, .Uncompressed, 65) ?? return Err(push_fail("the public point does not encode"))
    Ok(PushKeyPair{private: private.copy(), public: public})
}

/// A fresh key pair drawn from `rng`.
push_key_pair_new: fn<R: RNG>(rng: &R) -> PushKeyPair PushError! {
    grp: push_group() ?? return Err(err)
    d: ecp.gen_privkey(grp, rng) ?? return Err(push_fail("no private key could be drawn"))
    private: bn.write_binary(d, 32) ?? return Err(push_fail("the private key does not encode"))
    push_key_pair(private, rng)
}

/// The P-256 private scalar (32 bytes) of the PEM or DER key `key`: an APNs
/// signing key (`.p8`, PKCS#8) or a SEC1 EC key.
push_ec_private: fn<R: RNG>(key: String, rng: &R) -> [U8] PushError! {
    parsed: pkparse.pk_parse_key(key.bytes(), None, rng) ?? return Err(push_fail("the key does not parse"))
    if parsed.kind != .Val(.ECKey) && parsed.kind != .Val(.ECDSA) {
        return Err(push_fail("the key is no EC key"))
    }
    if pk.pk_get_ec_group_id(parsed) != .Secp256r1 {
        return Err(push_fail("the key is not on P-256"))
    }
    private: bn.write_binary(parsed.ec.d, 32) ?? return Err(push_fail("the private key does not encode"))
    Ok(private)
}

/// The key of one push: a fixed-length hash of the key of the run that
/// sends it, its recipient and the state a tap opens, so a repeated run
/// replaces the push it sent before and two pushes of one run never replace
/// each other. It is 32 base64url characters (24 bytes of SHA-256), within
/// APNs's 64-byte `apns-collapse-id` and Web Push's 32-character `Topic`
/// (RFC 8030 section 5.4). Each part is length-prefixed, so no two triples
/// hash the same input.
push_collapse_key: fn(run_key: String, to: String, open: String) -> String Never! {
    data := [U8]{}
    loop part in ([String]{run_key, to, open}) {
        bytes: part.bytes()
        data.extend("{bytes.len()}:".bytes())
        data.extend(bytes)
    }
    base64.encode_url(cipher.bytes_of(hashes.hash(.SHA256, data), 0, 24))
}

/// The aes128gcm body of a push of `plain` to the subscription whose
/// public key is `ua_public` (65 bytes) and whose authentication secret is
/// `auth_secret` (16 bytes), sealed with a fresh key pair and salt from
/// `rng` (RFC 8291 section 3).
push_web_seal: fn<R: RNG>(plain: [U8], ua_public: [U8], auth_secret: [U8], rng: &R) -> [U8] PushError! {
    sender: push_key_pair_new(rng) ?? return Err(err)
    salt := cipher.zero_bytes(16)
    if !rng.fill(salt) -> return Err(push_fail("the system entropy source failed"))
    push_web_encrypt(plain, ua_public, auth_secret, sender, salt, rng)
}

/// The aes128gcm body of a push of `plain` to the subscription whose
/// public key is `ua_public` and whose authentication secret is
/// `auth_secret`, sealed with the key pair `sender` and `salt` (16 bytes):
/// `salt || rs || idlen || keyid || ciphertext` (RFC 8188 section 2.1),
/// with `sender`'s public key as the key ID. `rng` blinds the key
/// agreement.
push_web_encrypt: fn<R: RNG>(plain: [U8], ua_public: [U8], auth_secret: [U8], sender: PushKeyPair, salt: [U8], rng: &R) -> [U8] PushError! {
    if plain.len() > PUSH_PAYLOAD_MAX {
        return Err(push_fail("a push payload is at most {PUSH_PAYLOAD_MAX} bytes, not {plain.len()}"))
    }
    if ua_public.len() != 65 {
        return Err(push_fail("a subscription's public key is 65 bytes, not {ua_public.len()}"))
    }
    if auth_secret.len() != 16 {
        return Err(push_fail("a subscription's authentication secret is 16 bytes, not {auth_secret.len()}"))
    }
    if salt.len() != 16 -> return Err(push_fail("a push's salt is 16 bytes, not {salt.len()}"))
    grp: push_group() ?? return Err(err)
    ua: ecp.point_read_binary(grp, ua_public) ?? return Err(push_fail("a subscription's public key is no P-256 point"))
    ecp.check_pubkey(grp, ua) ?? return Err(push_fail("a subscription's public key is not on P-256"))
    d: push_scalar(grp, sender.private) ?? return Err(err)
    shared: ecdh.ecdh_compute_shared(grp, ua, d, rng) ?? return Err(push_fail("the key agreement failed"))
    ecdh_secret := bn.write_binary(shared, 32) ?? return Err(push_fail("the shared secret does not encode"))
    // IKM = HKDF(auth_secret, ecdh_secret, "WebPush: info" 0 ua_public
    // as_public, 32) (RFC 8291 section 3.4).
    key_info := push_label("WebPush: info")
    key_info.extend(ua_public.copy())
    key_info.extend(sender.public.copy())
    ikm := push_hkdf(auth_secret, ecdh_secret, key_info, 32)
    core.crypto.wipe(ecdh_secret)
    cek := push_hkdf(salt, ikm, push_label("Content-Encoding: aes128gcm"), 16)
    nonce: push_hkdf(salt, ikm, push_label("Content-Encoding: nonce"), 12)
    core.crypto.wipe(ikm)
    // One record: the payload, then the last record's delimiter 2.
    record := plain.copy()
    record.push(U8{2})
    key: aead.gcm_key(cipher.aes_key(cek, false) ?? panic("a content-encryption key is 16 bytes"))
    core.crypto.wipe(cek)
    sealed: aead.gcm_encrypt(key, nonce, [U8]{}, record, 16) ?? panic("one push record seals")
    core.crypto.wipe(record)
    body := salt.copy()
    body.push(U8{0})
    body.push(U8{0})
    body.push(U8{PUSH_RECORD_SIZE /% 256})
    body.push(U8{PUSH_RECORD_SIZE %% 256})
    body.push(U8{65})
    body.extend(sender.public.copy())
    body.extend(sealed)
    Ok(body)
}

/// The `Authorization` header of a push to the push service at `audience`
/// (the endpoint's origin, `https://host`): `vapid t=JWT, k=key` (RFC 8292
/// section 3). The JWT claims `aud` `audience`, `exp` `expires` (Unix
/// seconds) and `sub` `contact` (a `mailto:` or `https:` URL), and is
/// signed ES256 by `sender` with an RFC 6979 nonce; `rng` blinds the
/// signing. `now` (Unix seconds) bounds `expires` to 24 hours ahead.
push_vapid_authorization: fn<R: RNG>(audience: String, contact: String, now: Int, expires: Int, sender: PushKeyPair, rng: &R) -> String PushError! {
    if expires <= now || expires - now > PUSH_VAPID_MAX_SECONDS {
        return Err(push_fail("a VAPID token expires within 24 hours, not in {expires - now} seconds"))
    }
    claims: "{{\"aud\":{push_json_text(audience)},\"exp\":{expires},\"sub\":{push_json_text(contact)}}}"
    token: push_jwt_es256("{{\"typ\":\"JWT\",\"alg\":\"ES256\"}}", claims, sender.private, rng) ?? return Err(err)
    Ok("vapid t={token}, k={base64.encode_url(sender.public)}")
}

/// The Web Push request (RFC 8030 section 5) of a notification to the
/// subscription `to`, from the application server `sender` whose contact
/// is `contact`. The payload, the JSON of `title`, `body`, `tag` `key` and
/// `open` (the JSON of the state a tap opens), is sealed to the
/// subscription (RFC 8291). `key` is also the `Topic`, which replaces a
/// push still waiting at the push service. `now` is Unix seconds; the VAPID
/// token is good for 12 hours.
push_web_request: fn<R: RNG>(to: PushSubscription, sender: PushKeyPair, contact: String, now: Int, key: String, title: String, body: String, open: String, rng: &R) -> PushRequest PushError! {
    audience: push_origin(to.endpoint) ?? return Err(push_fail("a subscription's endpoint is no http or https URL: {to.endpoint}"))
    payload: "{{\"title\":{push_json_text(title)},\"body\":{push_json_text(body)},\"tag\":{push_json_text(key)},\"open\":{push_json_text(open)}}}"
    sealed: push_web_seal(payload.bytes(), to.public, to.auth_secret, rng) ?? return Err(err)
    authorization: push_vapid_authorization(audience, contact, now, now + PUSH_VAPID_MAX_SECONDS /% 2, sender, rng) ?? return Err(err)
    headers: [PushHeader]{
        PushHeader{name: "authorization", value: authorization},
        PushHeader{name: "ttl", value: "{PUSH_WEB_TTL_SECONDS}"},
        PushHeader{name: "topic", value: key},
        PushHeader{name: "urgency", value: "normal"},
        PushHeader{name: "content-encoding", value: "aes128gcm"},
        PushHeader{name: "content-type", value: "application/octet-stream"},
    }
    Ok(PushRequest{url: to.endpoint.copy(), headers: headers, body: sealed})
}

/// The provider token of APNs's token-based authentication: an ES256 JWT
/// whose header names the signing key `key_id` and whose claims are `iss`
/// the team ID and `iat` `now` (Unix seconds), signed by the P-256 scalar
/// `private`. APNs takes one for up to an hour.
push_apns_token: fn<R: RNG>(team_id: String, key_id: String, now: Int, private: [U8], rng: &R) -> String PushError! {
    header: "{{\"alg\":\"ES256\",\"kid\":{push_json_text(key_id)}}}"
    push_jwt_es256(header, "{{\"iss\":{push_json_text(team_id)},\"iat\":{now}}}", private, rng)
}

/// The APNs request of an alert to the device `device_token`, from the app
/// `topic` (its bundle ID), at the APNs `origin` (`https://api.push.apple.com`
/// or a local fake). `key` is the push's collapse key and `open` the JSON of
/// the state a tap opens.
push_apns_request: fn(origin: String, device_token: String, topic: String, provider_token: String, key: String, title: String, body: String, open: String) -> PushRequest Never! {
    alert: "{{\"title\":{push_json_text(title)},\"body\":{push_json_text(body)}}}"
    PushRequest{
        url: "{origin}/3/device/{device_token}",
        headers: [PushHeader]{
            PushHeader{name: "authorization", value: "bearer {provider_token}"},
            PushHeader{name: "apns-topic", value: topic},
            PushHeader{name: "apns-push-type", value: "alert"},
            PushHeader{name: "apns-priority", value: "10"},
            PushHeader{name: "apns-collapse-id", value: key},
            PushHeader{name: "content-type", value: "application/json"},
        },
        body: "{{\"aps\":{{\"alert\":{alert}}},\"open\":{push_json_text(open)}}}".bytes(),
    }
}

/// The request that trades a service account's signed assertion for an
/// FCM access token at `token_uri` (RFC 7523 section 2.1): an RS256 JWT
/// with `iss` the account's `client_email`, the messaging scope, `aud`
/// `token_uri`, `iat` `now` and `exp` an hour later, signed by the
/// account's RSA key `key` (PEM).
push_fcm_token_request: fn<R: RNG>(client_email: String, token_uri: String, now: Int, key: String, rng: &R) -> PushRequest PushError! {
    parsed := pkparse.pk_parse_key(key.bytes(), None, rng) ?? return Err(push_fail("the service account's key does not parse"))
    if parsed.kind != .Val(.RSA) -> return Err(push_fail("the service account's key is no RSA key"))
    claims: "{{\"iss\":{push_json_text(client_email)},\"scope\":\"{PUSH_FCM_SCOPE}\",\"aud\":{push_json_text(token_uri)},\"iat\":{now},\"exp\":{now + 3600}}}"
    signing_input: "{base64.encode_url("{{\"alg\":\"RS256\",\"typ\":\"JWT\"}}".bytes())}.{base64.encode_url(claims.bytes())}"
    signature: pk.pk_sign(parsed, .SHA256, hashes.hash(.SHA256, signing_input.bytes()), pk.PK_SIGNATURE_MAX_SIZE, rng) ?? return Err(push_fail("the assertion's signature failed"))
    body: "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Ajwt-bearer&assertion={signing_input}.{base64.encode_url(signature)}"
    Ok(PushRequest{url: token_uri, headers: [PushHeader]{PushHeader{name: "content-type", value: "application/x-www-form-urlencoded"}}, body: body.bytes()})
}

/// The FCM HTTP v1 request of a notification to the device `device_token`
/// of the Firebase project `project`, at the FCM `origin`
/// (`https://fcm.googleapis.com` or a local fake). The message is
/// non-collapsible: FCM keeps at most four collapse keys per device, so
/// `key` goes in `android.notification.tag`, which replaces a shown
/// notification with the same tag. `open` is the JSON of the state a tap
/// opens.
push_fcm_request: fn(origin: String, project: String, access_token: String, device_token: String, key: String, title: String, body: String, open: String) -> PushRequest Never! {
    notification: "{{\"title\":{push_json_text(title)},\"body\":{push_json_text(body)}}}"
    android: "{{\"notification\":{{\"tag\":{push_json_text(key)}}}}}"
    message: "{{\"token\":{push_json_text(device_token)},\"notification\":{notification},\"android\":{android},\"data\":{{\"open\":{push_json_text(open)}}}}}"
    PushRequest{
        url: "{origin}/v1/projects/{project}/messages:send",
        headers: [PushHeader]{
            PushHeader{name: "authorization", value: "Bearer {access_token}"},
            PushHeader{name: "content-type", value: "application/json"},
        },
        body: "{{\"message\":{message}}}".bytes(),
    }
}

/// The compact JWT of the JSON `header` and `claims`, signed ES256 by the
/// private scalar `private` (RFC 7515 section 7.1).
push_jwt_es256: fn<R: RNG>(header: String, claims: String, private: [U8], rng: &R) -> String PushError! {
    signing_input: "{base64.encode_url(header.bytes())}.{base64.encode_url(claims.bytes())}"
    signature: push_es256(private, signing_input.bytes(), rng) ?? return Err(err)
    Ok("{signing_input}.{base64.encode_url(signature)}")
}

/// The ES256 signature of `data` by the private scalar `private`: `r || s`,
/// 32 bytes each (RFC 7518 section 3.4), with the RFC 6979 nonce.
push_es256: fn<R: RNG>(private: [U8], data: [U8], rng: &R) -> [U8] PushError! {
    grp: push_group() ?? return Err(err)
    d: push_scalar(grp, private) ?? return Err(err)
    hash: hashes.hash(.SHA256, data)
    sig: ecdsa.ecdsa_sign_det(grp, d, hash, .SHA256, rng) ?? return Err(push_fail("the signature failed"))
    out := bn.write_binary(sig.r, 32) ?? return Err(push_fail("the signature does not encode"))
    out.extend(bn.write_binary(sig.s, 32) ?? return Err(push_fail("the signature does not encode")))
    Ok(out)
}

/// The origin (`scheme://authority`) of the http or https URL `url`.
push_origin: fn(url: String) -> String? Never! {
    start: if url.starts_with("https://") -> 8 else if url.starts_with("http://") -> 7 else -> {
        return None
    }
    bytes: url.bytes()
    slash: U8{47}
    end := start
    loop end < bytes.len() && bytes[end] != slash -> end += 1
    if end == start -> return None
    origin: String.from_bytes(cipher.bytes_of(bytes, 0, end)) ?? return None
    origin
}

/// The push services a server sends through. A service left None sends
/// nothing: a push to one of its devices is skipped.
PushSettings: struct {
    apns: PushAPNs?
    fcm: PushFCM?
    web: PushWeb?
}

/// APNs's token-based authentication: the APNs `origin`
/// (`https://api.push.apple.com`, `https://api.sandbox.push.apple.com`, or
/// an `http` origin a local fake answers over h2c), the team's ID, the
/// signing key's ID and the path of its `.p8` file, and the app's bundle
/// ID, which is each push's `apns-topic`.
PushAPNs: struct {
    origin: String
    team_id: String
    key_id: String
    key_path: String
    topic: String
}

/// FCM's HTTP v1 API: the FCM `origin` (`https://fcm.googleapis.com` or a
/// local fake), the Firebase project's ID, and the service account's email,
/// token URI and the path of its private key (PEM).
PushFCM: struct {
    origin: String
    project: String
    client_email: String
    token_uri: String
    key_path: String
}

/// Web Push: the VAPID `contact` (a `mailto:` or `https:` URI) and the path
/// of the application server's P-256 private key (PEM), whose public key
/// browsers subscribe with.
PushWeb: struct {
    contact: String
    key_path: String
}

/// What one push to one device came to: `reason` is "" once its service
/// took the push, and `gone` says the service no longer knows the device.
PushOutcome: struct {
    reason: String
    gone: Bool
}

/// How long one push's request may take, its connection included.
PUSH_SEND_MS: 10000

/// How long an APNs provider token is reused: APNs refuses one older than
/// an hour and a new one more often than every 20 minutes.
PUSH_APNS_TOKEN_SECONDS: 3000

/// How long before an FCM access token expires it is renewed.
PUSH_FCM_RENEW_SECONDS: 300

// The services set up to send, each with its key as read once, and the
// bearer token APNs and FCM were last sent with, renewed from the Unix
// second `*_until`.
priv PushSenders: struct {
    apns: PushAPNs?
    #Redact apns_key: [U8]
    #Redact apns_token: String
    apns_until: Int
    fcm: PushFCM?
    #Redact fcm_key: String
    #Redact fcm_token: String
    fcm_until: Int
    web: PushWeb?
    web_key: PushKeyPair?
}

priv PUSH_SENDERS: Shared{PushSenders{apns: None, apns_key: [U8]{}, apns_token: "", apns_until: 0, fcm: None, fcm_key: "", fcm_token: "", fcm_until: 0, web: None, web_key: None}}

// What an FCM token exchange answers.
#Codable
priv PushFCMGrant: struct {
    access_token: String
    expires_in: Int
}

/// Sets up the services `settings` names, reading each one's key, in place
/// of the services set up before. Fails, keeping those, when a key can't be
/// read or is not the kind its service takes.
push_configure: fn(settings: PushSettings) PushError! -[FS.Read, Net]> {
    rng := push_rng() ?? return Err(err)
    senders := PushSenders{apns: None, apns_key: [U8]{}, apns_token: "", apns_until: 0, fcm: None, fcm_key: "", fcm_token: "", fcm_until: 0, web: None, web_key: None}
    if settings.apns == .Val(apns) {
        text: core.files.read(apns.key_path) ?? return Err(push_fail("the APNs key {apns.key_path} can't be read: {err}"))
        senders.apns_key = push_ec_private(text, rng) ?? return Err(push_fail("the APNs key {apns.key_path}: {err.reason}"))
        senders.apns = Val(apns.copy())
    }
    if settings.fcm == .Val(fcm) {
        text: core.files.read(fcm.key_path) ?? return Err(push_fail("the FCM key {fcm.key_path} can't be read: {err}"))
        _: push_fcm_token_request(fcm.client_email, fcm.token_uri, 0, text, rng) ?? return Err(push_fail("the FCM key {fcm.key_path}: {err.reason}"))
        senders.fcm_key = text
        senders.fcm = Val(fcm.copy())
    }
    if settings.web == .Val(web) {
        text: core.files.read(web.key_path) ?? return Err(push_fail("the Web Push key {web.key_path} can't be read: {err}"))
        private: push_ec_private(text, rng) ?? return Err(push_fail("the Web Push key {web.key_path}: {err.reason}"))
        senders.web_key = Val(push_key_pair(private, rng) ?? return Err(push_fail("the Web Push key {web.key_path}: {err.reason}")))
        senders.web = Val(web.copy())
    }
    held := PUSH_SENDERS.guard_edit()
    held.value = senders
    Ok()
}

/// Whether the push service `service` (`apns`, `fcm` or `web`) is set up.
push_configured: fn(service: String) -> Bool Never! {
    held: PUSH_SENDERS.guard_read()
    if service == "apns" -> return held.value.apns != None
    if service == "fcm" -> return held.value.fcm != None
    if service == "web" -> return held.value.web != None
    false
}

/// The name of the push service `service` for a reason.
push_service_label: fn(service: String) -> String Never! {
    if service == "apns" -> return "APNs"
    if service == "fcm" -> return "FCM"
    if service == "web" -> return "Web Push"
    service.copy()
}

/// A key no other push has: 24 random bytes, base64url, as long as a
/// collapse key.
push_fresh_key: fn() -> String PushError! {
    rng := push_rng() ?? return Err(err)
    bytes := cipher.zero_bytes(24)
    if !rng.fill(bytes) -> return Err(push_fail("the system entropy source failed"))
    Ok(base64.encode_url(bytes))
}

/// Sends one push of `title` and `body`, keyed `key`, whose tap opens
/// `open`, to the device `token` of the set-up push service `service`; a
/// Web Push device's token is its subscription's endpoint, with its `p256dh`
/// key and `auth` secret base64url. `now` (Unix seconds) dates the tokens.
push_deliver: fn(service: String, token: String, p256dh: String, auth: String, key: String, title: String, body: String, open: String, now: Int) -[Net, Time.Wait]> PushOutcome Never! {
    rng := push_rng() ?? return push_failed(err.reason)
    if service == "apns" -> return push_deliver_apns(token, key, title, body, open, now, rng)
    if service == "fcm" -> return push_deliver_fcm(token, key, title, body, open, now, rng)
    if service == "web" {
        return push_deliver_web(token, p256dh, auth, key, title, body, open, now, rng)
    }
    push_failed("there is no push service `{service}`")
}

// The Unix second it is now.
push_now: fn() -> Int Never! {
    // core.net.tls's host clock, so a push needs Net alone.
    sample: core.net.tls.__host_wall_sample()
    if sample.before_epoch -> 0 else -> sample.seconds
}

priv push_failed: fn(reason: String) -> PushOutcome Never! {
    PushOutcome{reason: reason, gone: false}
}

// A copy of the services set up, so no request is sent under their lock.
priv push_senders: fn() -> PushSenders Never! {
    held: PUSH_SENDERS.guard_read()
    held.value.copy()
}

priv push_deliver_apns: fn<R: RNG>(token: String, key: String, title: String, body: String, open: String, now: Int, rng: &R) -[Net, Time.Wait]> PushOutcome Never! {
    senders: push_senders()
    apns: senders.apns ?? return push_failed("no APNs settings")
    bearer := senders.apns_token.copy()
    if bearer == "" || now >= senders.apns_until {
        bearer = push_apns_token(apns.team_id, apns.key_id, now, senders.apns_key, rng) ?? return push_failed(err.reason)
        held := PUSH_SENDERS.guard_edit()
        held.value.apns_token = bearer.copy()
        held.value.apns_until = now + PUSH_APNS_TOKEN_SECONDS
    }
    request: push_apns_request(apns.origin, token, apns.topic, bearer, key, title, body, open)
    fields := [http.Header]{}
    loop header in request.headers {
        fields.push(http.Header{name: header.name.copy(), value: header.value.copy()})
    }
    response: client.__h2_request("POST", request.url, fields, request.body, PUSH_SEND_MS) ?? return push_failed("APNs: {err}")
    if response.status == 200 -> return PushOutcome{reason: "", gone: false}
    answer: response.text() ?? ""
    if answer.contains("ExpiredProviderToken") {
        held := PUSH_SENDERS.guard_edit()
        held.value.apns_token = ""
    }
    gone: response.status == 410 || answer.contains("BadDeviceToken") || answer.contains("Unregistered")
    PushOutcome{reason: "APNs answered {response.status} {answer}", gone: gone}
}

priv push_deliver_fcm: fn<R: RNG>(token: String, key: String, title: String, body: String, open: String, now: Int, rng: &R) -[Net, Time.Wait]> PushOutcome Never! {
    senders: push_senders()
    fcm: senders.fcm ?? return push_failed("no FCM settings")
    bearer := senders.fcm_token.copy()
    if bearer == "" || now >= senders.fcm_until {
        exchange: push_fcm_token_request(fcm.client_email, fcm.token_uri, now, senders.fcm_key, rng) ?? return push_failed(err.reason)
        granted: push_post(exchange) ?? return push_failed("the FCM token exchange: {err}")
        if granted.status != 200 {
            return push_failed("the FCM token exchange answered {granted.status} {granted.text() ?? ""}")
        }
        grant: granted.json<PushFCMGrant>() ?? return push_failed("the FCM token exchange's answer: {err}")
        bearer = grant.access_token.copy()
        held := PUSH_SENDERS.guard_edit()
        held.value.fcm_token = bearer.copy()
        held.value.fcm_until = now + grant.expires_in - PUSH_FCM_RENEW_SECONDS
    }
    request: push_fcm_request(fcm.origin, fcm.project, bearer, token, key, title, body, open)
    response: push_post(request) ?? return push_failed("FCM: {err}")
    if response.status == 200 -> return PushOutcome{reason: "", gone: false}
    answer: response.text() ?? ""
    if response.status == 401 {
        held := PUSH_SENDERS.guard_edit()
        held.value.fcm_token = ""
    }
    PushOutcome{reason: "FCM answered {response.status} {answer}", gone: response.status == 404}
}

priv push_deliver_web: fn<R: RNG>(endpoint: String, p256dh: String, auth: String, key: String, title: String, body: String, open: String, now: Int, rng: &R) -[Net, Time.Wait]> PushOutcome Never! {
    senders: push_senders()
    web: senders.web ?? return push_failed("no Web Push settings")
    sender: senders.web_key ?? return push_failed("no Web Push settings")
    public: base64.decode_url(p256dh) ?? return push_failed("the subscription's key is no base64url")
    secret: base64.decode_url(auth) ?? return push_failed("the subscription's auth secret is no base64url")
    to: PushSubscription{endpoint: endpoint.copy(), public: public, auth_secret: secret}
    request: push_web_request(to, sender, web.contact, now, key, title, body, open, rng) ?? return push_failed(err.reason)
    response: push_post(request) ?? return push_failed("Web Push: {err}")
    if response.status >= 200 && response.status < 300 {
        return PushOutcome{reason: "", gone: false}
    }
    answer: response.text() ?? ""
    PushOutcome{reason: "Web Push answered {response.status} {answer}", gone: response.status == 404 || response.status == 410}
}

// Sends `request` over HTTP/1.1.
priv push_post: fn(request: PushRequest) -[Net, Time.Wait]> http.HTTPResponse http.HTTPError! {
    out := http.__request("POST", request.url).timeout(PUSH_SEND_MS)
    loop header in request.headers -> out = out.__with_header(header.name, header.value)
    out.__with_body_value(http.body_bytes(request.body.copy())).send()
}

priv push_fail: fn(reason: String) -> PushError Never! { PushError{reason: reason} }

// P-256.
priv push_group: fn() -> ecp.EcpGroup PushError! {
    grp: ecp.group_load(.Secp256r1) ?? return Err(push_fail("P-256 does not load"))
    Ok(grp)
}

// The private scalar `private` (32 bytes) of a key on `grp`.
priv push_scalar: fn(grp: ecp.EcpGroup, private: [U8]) -> bn.Mpi PushError! {
    if private.len() != 32 {
        return Err(push_fail("a P-256 private key is 32 bytes, not {private.len()}"))
    }
    d: bn.read_binary(private) ?? return Err(push_fail("the private key does not decode"))
    ecp.check_privkey(grp, d) ?? return Err(push_fail("the private key is not a P-256 scalar"))
    Ok(d)
}

// `label`, then a zero byte: an HKDF info of RFC 8291 and RFC 8188.
priv push_label: fn(label: String) -> [U8] Never! {
    out := label.bytes()
    out.push(U8{0})
    out
}

// HKDF-SHA-256 of `ikm` with `salt` and `info`, `len` bytes.
priv push_hkdf: fn(salt: [U8], ikm: [U8], info: [U8], len: Int) -> [U8] Never! {
    hashes.hkdf_with(hashes.SHA256Hash{}, .SHA256, salt, ikm, info, len) ?? panic("HKDF-SHA-256 gives up to 8160 bytes")
}

// `text` as a JSON string.
priv push_json_text: fn(text: String) -> String Never! {
    digits: "0123456789abcdef".bytes()
    quote: U8{34}
    backslash: U8{92}
    space: U8{32}
    out := [U8]{quote}
    loop b in text.bytes() {
        if b == quote || b == backslash {
            out.push(backslash)
            out.push(b)
        } else if b < space {
            out.extend("\\u00".bytes())
            out.push(digits[Int{b} /% 16])
            out.push(digits[Int{b} %% 16])
        } else { out.push(b) }
    }
    out.push(quote)
    String.from_bytes(out) ?? panic("JSON-quoted UTF-8 stays UTF-8")
}

// A generator that only blinds: the tests' results do not depend on it.
priv push_test_rng: fn() -> drbg.HMACDrbg Never! {
    rng := drbg.hmac_drbg_new(.SHA256)
    drbg.hmac_drbg_seed_buf(rng, "Jet push test blinding".bytes())
    rng
}

priv push_b64: fn(text: String) -> [U8] Never! {
    base64.decode_url(text) ?? panic("test base64url: {text}")
}

// The browser's side of RFC 8291 section 3.4: the record of the aes128gcm
// `body`, opened with the subscription's key pair `ua` and `auth_secret`.
priv push_test_open: fn(body: [U8], ua: PushKeyPair, auth_secret: [U8]) -> [U8] Never! {
    rng := push_test_rng()
    grp: push_group() ?? panic("P-256")
    sender_public: cipher.bytes_of(body, 21, 65)
    sender: ecp.point_read_binary(grp, sender_public) ?? panic("the key ID is a P-256 point")
    shared: ecdh.ecdh_compute_shared(grp, sender, push_scalar(grp, ua.private) ?? panic("scalar"), rng) ?? panic("agree")
    key_info := push_label("WebPush: info")
    key_info.extend(ua.public.copy())
    key_info.extend(sender_public)
    ikm: push_hkdf(auth_secret, bn.write_binary(shared, 32) ?? panic("secret"), key_info, 32)
    salt: cipher.bytes_of(body, 0, 16)
    cek: push_hkdf(salt, ikm, push_label("Content-Encoding: aes128gcm"), 16)
    nonce: push_hkdf(salt, ikm, push_label("Content-Encoding: nonce"), 12)
    key: aead.gcm_key(cipher.aes_key(cek, false) ?? panic("AES key"))
    aead.gcm_decrypt(key, nonce, [U8]{}, cipher.bytes_of(body, 86, body.len() - 86), 16) ?? panic("the push opens")
}

// The claims of the ES256 JWT `token`, which must verify with the P-256
// public key `public`; the header must be `header`.
priv push_test_jwt_claims: fn(token: String, header: String, public: [U8]) -> String Never! {
    parts: token.split(".").to_list()
    assert_eq(parts.len(), 3)
    assert_eq(String.from_bytes(push_b64(parts[0])) ?? panic("header text"), header)
    grp: push_group() ?? panic("P-256")
    signature: push_b64(parts[2])
    assert_eq(signature.len(), 64)
    q: ecp.point_read_binary(grp, public) ?? panic("the public key")
    hash: hashes.hash(.SHA256, "{parts[0]}.{parts[1]}".bytes())
    r: bn.read_binary(cipher.bytes_of(signature, 0, 32)) ?? panic("r")
    s: bn.read_binary(cipher.bytes_of(signature, 32, 32)) ?? panic("s")
    ecdsa.ecdsa_verify(grp, hash, q, r, s) ?? panic("the token's signature verifies")
    String.from_bytes(push_b64(parts[1])) ?? panic("claims text")
}

priv push_test_header: fn(request: PushRequest, name: String) -> String Never! {
    loop header in request.headers {
        if header.name == name -> return header.value.copy()
    }
    panic("the request has no `{name}` header")
}

// The APNs signing key of the tests: a P-256 key in PKCS#8, as a `.p8`.
