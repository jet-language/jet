// The keyword table: every literal spelled as a word is found from the
// word with one hash, `i` keywords in any case, and nothing else is.
use {
    core.grammar.[analyze]
    core.grammar.plan.[GrammarKeywords, GrammarPlan, GrammarSource]
    core.grammar.runtime.[keyword_find, keyword_next, word_end, word_shaped]
}

plan_of: fn(text: String) -> GrammarPlan Never! {
    if analyze(text, "", [GrammarSource]{}) == {
        .Ok(plan) -> plan
        .Err(error) -> panic("{error}")
    }
}

/// The token kind of the keyword `word` spells, or -1.
kind_of: fn(keywords: GrammarKeywords, word: String) -> Int Never! {
    bytes: word.bytes()
    entry: keyword_find(keywords, bytes, 0, bytes.len())
    if entry < 0 -> return -1
    keywords.kinds[entry]
}

/// The token kind named `name`.
token_kind: fn(plan: GrammarPlan, name: String) -> Int Never! {
    loop (k, token) in plan.tokens {
        if token.name == name -> return k
    }
    panic("no token {name}")
}

#Test("a word is a keyword only when spelled as a word") {
    assert(word_shaped("select"))
    assert(word_shaped("_rowid_"))
    assert(word_shaped("x2"))
    assert(!word_shaped("2x"))
    assert(!word_shaped("->"))
    assert(!word_shaped("a-b"))
    assert(!word_shaped(""))
    assert_eq(word_end("ab_9-c".bytes(), 0), 4)
    assert_eq(word_end("ab_9-c".bytes(), 4), 4)
}

#Test("each word literal is found from its word, an i literal in any case") {
    plan: plan_of("s : 'select'i name=NAME 'FROM' table=NAME '->' 'x' ;\nNAME : [a-z]+ ;\nWS : ' '+ -> skip ;")
    keywords: plan.keywords
    assert_eq(keywords.kinds.len(), 3)
    assert_eq(kind_of(keywords, "select"), token_kind(plan, "\"select\""))
    assert_eq(kind_of(keywords, "SeLeCt"), token_kind(plan, "\"select\""))
    assert_eq(kind_of(keywords, "FROM"), token_kind(plan, "\"FROM\""))
    assert_eq(kind_of(keywords, "from"), -1)
    assert_eq(kind_of(keywords, "x"), token_kind(plan, "\"x\""))
    assert_eq(kind_of(keywords, "selec"), -1)
    assert_eq(kind_of(keywords, "selects"), -1)
    assert_eq(kind_of(keywords, "->"), -1)
    assert_eq(kind_of(keywords, ""), -1)
}

#Test("a word lexes from inside a longer text") {
    plan: plan_of("s : 'select'i name=NAME ;\nNAME : [a-z]+ ;\nWS : ' '+ -> skip ;")
    bytes: "(SELECT x)".bytes()
    end: word_end(bytes, 1)
    assert_eq(end, 7)
    entry: keyword_find(plan.keywords, bytes, 1, end)
    assert(entry >= 0)
    assert_eq(plan.keywords.kinds[entry], token_kind(plan, "\"select\""))
}

#Test("an i keyword and a plain one of the same letters are both found") {
    plan: plan_of("s : 'select'i 'a' # Folded | '(' 'SELECT' ')' # Exact ;\nWS : ' '+ -> skip ;")
    keywords: plan.keywords
    bytes: "SELECT".bytes()
    first: keyword_find(keywords, bytes, 0, bytes.len())
    assert(first >= 0)
    second: keyword_next(keywords, first, bytes, 0, bytes.len())
    assert(second >= 0)
    assert(keywords.kinds[first] != keywords.kinds[second])
    assert_eq(keyword_next(keywords, second, bytes, 0, bytes.len()), -1)
    lower: "select".bytes()
    only: keyword_find(keywords, lower, 0, lower.len())
    assert(only >= 0)
    assert_eq(keyword_next(keywords, only, lower, 0, lower.len()), -1)
}

#Test("three hundred keywords each find their own slot") {
    ^words: [String]{}
    loop i in 0..<300 -> words.push("'kw{i}'i")
    plan: plan_of("s : k ;\nk : {words.join(" | ")} ;")
    keywords: plan.keywords
    assert_eq(keywords.kinds.len(), 300)
    assert(keywords.slots.len() <= 600)
    loop i in 0..<300 {
        kind: kind_of(keywords, "KW{i}")
        assert(kind > 0)
        assert_eq(plan.tokens[kind].text, "kw{i}")
    }
    assert_eq(kind_of(keywords, "kw300"), -1)
    assert_eq(kind_of(keywords, "kw"), -1)
}

#Test("a grammar with no word literals has an empty table") {
    plan: plan_of("s : '(' s ')' # Group | '-' # Dash ;")
    assert_eq(plan.keywords.slots.len(), 0)
    assert_eq(kind_of(plan.keywords, "x"), -1)
}
