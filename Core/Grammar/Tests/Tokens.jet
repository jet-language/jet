// Token refusals: a non-greedy repeat that ends no token, token clashes
// where both tokens can come next, tokens that match no text, and tokens
// that name themselves. What the automata match is tested in Grammar.jet,
// the Core source that can reach the run-time lexer.
use {
    core.grammar.[analyze]
    core.grammar.error.[GrammarFault, GrammarFaultKind]
    core.grammar.plan.[GrammarPlan, GrammarSource]
}

plan_of: fn(text: String) -> GrammarPlan Never! {
    if analyze(text, "", [GrammarSource]{}) == {
        .Ok(plan) -> plan
        .Err(error) -> panic("{error}")
    }
}

faults_of: fn(text: String) -> [GrammarFault] Never! {
    if analyze(text, "", [GrammarSource]{}) == {
        .Ok(_) -> [GrammarFault]{}
        .Err(error) -> error.faults
    }
}

#Test("a non-greedy repeat must come just before the literal that ends its token") {
    faults: faults_of("a : C ;\nC : '/*' .*? ;")
    assert_eq(faults.len(), 1)
    assert_eq(faults[0].kind, GrammarFaultKind.Notation)
    assert_eq(faults[0].message, "a non-greedy repeat must come just before the literal that ends its token")
    assert_eq(faults[0].at.offset, 18)
}

#Test("two token classes the parser can take at one point may not match the same text") {
    faults: faults_of("v : NAME | HEX ;\nNAME : [a-z]+ ;\nHEX : [0-9a-f]+ ;")
    assert_eq(faults.len(), 1)
    assert_eq(faults[0].kind, GrammarFaultKind.TokenClash)
    assert_eq(faults[0].message, "the token rules `NAME` and `HEX` both match \"a\" where the parser can take either")
    assert_eq(faults[0].at.offset, 33)
    plan: plan_of("v : '+' name=NAME # Name | '-' hex=HEX # Hex ;\nNAME : [a-z]+ ;\nHEX : [0-9a-f]+ ;")
    assert_eq(plan.tokens.len(), 5)
}

#Test("a skipped token clashes with every token it can match the text of") {
    faults: faults_of("s : NAME ;\nNAME : [a-z]+ ;\nWS : [ a]+ -> skip ;")
    assert_eq(faults.len(), 1)
    assert_eq(faults[0].message, "the token rules `NAME` and `WS` both match \"a\" where the parser can take either")
}

#Test("an i literal and a literal of the same letters clash where both can come") {
    faults: faults_of("s : 'select'i | 'SELECT' ;")
    assert_eq(faults.len(), 1)
    assert_eq(faults[0].kind, GrammarFaultKind.TokenClash)
    assert_eq(faults[0].message, "the literals \"select\" and \"SELECT\" both match \"select\" where the parser can take either")
    plan: plan_of("s : 'select'i '+' # X | 'SELECT'i '-' # Y ;")
    assert_eq(plan.tokens.len(), 4)
}

#Test("a token rule must match some text, and may not name itself") {
    empty: faults_of("s : A ;\nA : 'a'* ;")
    assert_eq(empty.len(), 1)
    assert_eq(empty[0].message, "the token rule `A` can match no text")
    nested: faults_of("s : A ;\nA : '(' B? ')' ;\nB : 'x' A ;")
    assert_eq(nested.len(), 1)
    assert_eq(nested[0].message, "the token rule `A` names itself through `A -> B -> A`: a token matches text without nesting")
}
