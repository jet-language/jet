// core.grammar.runtime — what a generated parser and printer call.
//
// Every meaning a generated parser has lives here: the cursor, the
// character columns, the token automata, keyword lookup, the depth bound,
// error text and resynchronization. A parse into a sink sends each token,
// skipped ones included, as the parser takes it. A generated printer writes
// through a pen: token texts, the separator where two tokens would lex as
// one, and the check that a field's text is its token. The generated code
// only arranges calls.
//
// Lexing is contextual: the parser asks for the next token among the kinds
// it can take there, so a word is a keyword only where the keyword can
// come. Skipped tokens (spaces, comments) go first; then the longest match
// among the kinds wins, a literal over a token rule of the same length. A
// keyword matches a whole word only: the word is scanned and looked up.
use {
    core.grammar.error.[GrammarError, expected_list, grammar_error_at, literal_name]
    core.grammar.plan.[GrammarDecision, GrammarKeywords, GrammarLexer, GrammarPlan, GrammarPrinter, GrammarScanner, GrammarToken]
    core.grammar.sink.[GrammarSink]
}

/// The byte length of the UTF-8 sequence that starts with `lead`. Jet
/// Strings are valid UTF-8.
code_point_width: fn(lead: Int) -> Int Never! {
    if lead < 128 -> return 1
    if lead < 224 -> return 2
    if lead < 240 -> return 3
    4
}

/// The code point that starts at byte `at` of `bytes`.
code_point_at: fn(bytes: [U8], at: Int) -> Int Never! {
    first: Int{bytes[at]}
    if first < 128 -> return first
    width: code_point_width(first)
    ^cp: first & 7
    if width == 2 -> cp = first & 31
    if width == 3 -> cp = first & 15
    ^k: 1
    loop k < width && at + k < bytes.len() {
        cp = (cp << 6) | Int{bytes[at + k]} & 63
        k += 1
    }
    cp
}

/// The UTF-8 bytes of code point `cp`, appended to `out`.
push_code_point: fn(out: ^[U8], cp: Int) Never! {
    if cp < 128 -> out.push(U8{cp}) else if cp < 2048 {
        out.push(U8{Int{192} | cp >> 6})
        out.push(U8{Int{128} | cp & 63})
    } else if cp < 65536 {
        out.push(U8{Int{224} | cp >> 12})
        out.push(U8{Int{128} | (cp >> 6) & 63})
        out.push(U8{Int{128} | cp & 63})
    } else {
        out.push(U8{Int{240} | cp >> 18})
        out.push(U8{Int{128} | (cp >> 12) & 63})
        out.push(U8{Int{128} | (cp >> 6) & 63})
        out.push(U8{Int{128} | cp & 63})
    }
}

/// The text of code point `cp`.
code_point_text: fn(cp: Int) -> String Never! {
    ^out: [U8]{}
    push_code_point(out, cp)
    String.from_bytes(out) ?? ""
}

/// The Unicode property bits of an ASCII code point: 1 Alphabetic, 2
/// Numeric, 4 White_Space (bit `1 << PROPERTY_…`).
ascii_property_bits: fn(cp: Int) -> Int Never! {
    if (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) -> return 1
    if cp >= 48 && cp <= 57 -> return 2
    if (cp >= 9 && cp <= 13) || cp == 32 -> return 4
    0
}

/// The Unicode property bits of code point `cp`, as `\p{L}`, `\p{N}` and
/// `\p{White_Space}` classes test them.
property_bits: fn(cp: Int) -> Int Never! {
    if cp < 128 -> return ascii_property_bits(cp)
    text: code_point_text(cp)
    ^bits: 0
    if text.is_alphabetic() -> bits |= 1
    if text.is_numeric() -> bits |= 2
    if text.is_whitespace() -> bits |= 4
    bits
}

/// How an `i` literal compares a code point: ASCII capitals lowered.
fold_code_point: fn(cp: Int) -> Int Never! {
    if cp >= 65 && cp <= 90 -> return cp + 32
    cp
}

/// `text` as an `i` literal compares it: ASCII capitals lowered.
fold_text: fn(text: String) -> String Never! {
    ^out: [U8]{}
    loop b in text.bytes() {
        if b >= 65 && b <= 90 -> out.push(b + 32) else -> out.push(b)
    }
    String.from_bytes(out) ?? ""
}

/// Whether byte `b` is a word character: an ASCII letter, digit or `_`.
is_word_byte: fn(b: Int) -> Bool Never! {
    (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || b == 95 || (b >= 97 && b <= 122)
}

/// Whether `text` is spelled as a word: an ASCII letter or `_`, then word
/// characters. A literal spelled so is a keyword.
word_shaped: fn(text: String) -> Bool Never! {
    bytes: text.bytes()
    if bytes.len() == 0 -> return false
    first: Int{bytes[0]}
    if first >= 48 && first <= 57 -> return false
    loop b in bytes {
        if !is_word_byte(Int{b}) -> return false
    }
    true
}

/// The end of the run of word characters that starts at byte `at`, before
/// byte `stop`.
word_end: fn(bytes: [U8], at: Int, stop: Int) -> Int Never! {
    ^end: at
    loop end < stop && is_word_byte(Int{bytes[end]}) {
        end += 1
    }
    end
}

/// The hash of bytes `from..<to`, ASCII capitals lowered: 32-bit FNV-1a.
keyword_hash: fn(bytes: [U8], from: Int, to: Int) -> Int Never! {
    ^hash: 2166136261
    loop i in from..<to {
        hash = ((hash ~ fold_code_point(Int{bytes[i]})) * 16777619) & 4294967295
    }
    hash
}

/// The slot a keyword of hash `hash` takes in a table of `size` slots when
/// its bucket is displaced by `shift`.
keyword_slot: fn(hash: Int, shift: Int, size: Int) -> Int Never! {
    ^x: (hash ~ (shift * 2654435761)) & 4294967295
    x = ((x ~ (x >> 16)) * 73244475) & 4294967295
    x = ((x ~ (x >> 16)) * 73244475) & 4294967295
    (x ~ (x >> 16)) % size
}

/// Whether keyword entry `entry` is spelled by bytes `from..<to`.
keyword_spells: fn(keywords: GrammarKeywords, entry: Int, bytes: [U8], from: Int, to: Int) -> Bool Never! {
    text: keywords.texts[entry].bytes()
    if text.len() != to - from -> return false
    fold: keywords.folds[entry]
    loop i in 0..<text.len() {
        ^x: Int{text[i]}
        ^y: Int{bytes[from + i]}
        if fold {
            x = fold_code_point(x)
            y = fold_code_point(y)
        }
        if x != y -> return false
    }
    true
}

/// The first keyword entry from `entry` on its chain spelled by bytes
/// `from..<to`, or -1.
keyword_chain: fn(keywords: GrammarKeywords, entry: Int, bytes: [U8], from: Int, to: Int) -> Int Never! {
    ^at: entry
    loop at >= 0 {
        if keyword_spells(keywords, at, bytes, from, to) -> return at
        at = keywords.next[at]
    }
    -1
}

/// The keyword entry the word at bytes `from..<to` spells, or -1: one hash
/// and one compare. `keywords.kinds[entry]` is its token kind.
keyword_find: fn(keywords: GrammarKeywords, bytes: [U8], from: Int, to: Int) -> Int Never! {
    if keywords.slots.len() == 0 -> return -1
    hash: keyword_hash(bytes, from, to)
    shift: keywords.displace[hash % keywords.displace.len()]
    keyword_chain(keywords, keywords.slots[keyword_slot(hash, shift, keywords.slots.len())], bytes, from, to)
}

/// The next keyword entry after `entry` that the same word spells (it
/// differs only in case), or -1.
keyword_next: fn(keywords: GrammarKeywords, entry: Int, bytes: [U8], from: Int, to: Int) -> Int Never! {
    keyword_chain(keywords, keywords.next[entry], bytes, from, to)
}

/// The column of code point `cp` in `lexer`, found among its bounds.
bounds_column: fn(lexer: GrammarLexer, cp: Int) -> Int Never! {
    ^low: 0
    ^high: lexer.bounds.len()
    loop high - low > 1 {
        mid: (low + high) /% 2
        if lexer.bounds[mid] <= cp -> low = mid else -> high = mid
    }
    if lexer.masked -> return low * 8 + property_bits(cp)
    low
}

/// The column of code point `cp` in `lexer`: ASCII from its table.
lexer_column: fn(lexer: GrammarLexer, cp: Int) -> Int Never! {
    if cp < 128 -> return lexer.ascii[cp]
    bounds_column(lexer, cp)
}

/// The end of the longest match of token `kind` at byte `at` of `bytes`
/// (the first match, past a non-greedy repeat), or -1 for none.
lexer_match: fn(lexer: GrammarLexer, kind: Int, bytes: [U8], at: Int) -> Int Never! {
    lexer_match_to(lexer, kind, bytes, at, bytes.len())
}

/// `lexer_match` reading no byte at or past `stop`.
lexer_match_to: fn(lexer: GrammarLexer, kind: Int, bytes: [U8], at: Int, stop: Int) -> Int Never! {
    ^state: lexer.starts[kind]
    ^end: -1
    ^pos: at
    loop state >= 0 {
        if lexer.accept[state] > 0 -> end = pos
        if lexer.accept[state] == 2 || pos >= stop -> return end
        state = lexer.next[state * lexer.columns + lexer_column(lexer, code_point_at(bytes, pos))]
        pos += code_point_width(Int{bytes[pos]})
    }
    end
}

/// The most rules a parse may be inside at once. Deeper input is a
/// `GrammarError`, never a stack overflow. The parsers grammars replace
/// bound their nesting at 4,096 levels or fewer (SQLite's expressions at
/// 1,000), and one level of nesting enters a few rules; a format with a
/// smaller bound enforces it in its sink.
GRAMMAR_MAX_DEPTH: 10000

/// The kind of a lexeme where nothing the parser can take matches.
NO_TOKEN: -1

/// The kind of a lexeme at a hole where the parser can take no hole.
NO_HOLE: -2

/// One token read from the input: its kind (or `NO_TOKEN`, `NO_HOLE`), its
/// bytes `start..<end`, and `hole`, the index of the first hole not yet
/// passed after it.
GrammarLexeme: struct {
    kind: Int,
    start: Int,
    end: Int,
    hole: Int,
}

/// Where a parse is. `text` is the input (the parts joined, for a checked
/// literal with holes) and `holes` the byte offsets the holes sit at, in
/// order. `at` is the next byte to read, with skipped tokens not yet
/// passed, and `hole` the index of the next hole. `depth` counts the rules
/// the parse is inside. `errors` are the errors so far; `quiet` is set
/// after an error until the parser resynchronizes, so one spot reports
/// once.
GrammarCursor: struct {
    text: String,
    bytes: [U8],
    holes: [Int],
    at: Int,
    hole: Int,
    depth: Int,
    quiet: Bool,
    errors: [GrammarError],
}

/// What a generated parser lexes and decides with: the scanner of token
/// kinds `tokens` over `lexer` and `keywords`, deciding by `decisions`.
grammar_scanner_of: fn(lexer: GrammarLexer, keywords: GrammarKeywords, tokens: [GrammarToken], decisions: [GrammarDecision]) -> GrammarScanner Never! {
    ^names: [String]{}
    ^texts: [String]{}
    ^folds: [Bool]{}
    ^words: [Bool]{}
    ^skips: [Int]{}
    ^holes: [Int]{}
    ^alone: [[Int]]{}
    loop (k, token) in tokens {
        literal: k > 0 && token.rule < 0 && token.hole == ""
        names.push(token.name.copy())
        if literal -> texts.push(token.text.copy()) else -> texts.push("")
        folds.push(token.fold)
        words.push(literal && word_shaped(token.text))
        if token.skip -> skips.push(k)
        if token.hole != "" -> holes.push(k)
        alone.push([Int]{k})
    }
    ^first_steps: [Int]{}
    ^fallbacks: [Int]{}
    ^step_kinds: [[Int]]{}
    ^routes: [[Int]]{}
    loop decision in decisions {
        base: step_kinds.len()
        first_steps.push(base)
        fallbacks.push(decision.fallback)
        loop step in decision.steps {
            ^route: [Int]{}
            loop _ in 0..<tokens.len() -> route.push(-1)
            loop (i, kind) in step.kinds {
                target: step.targets[i]
                route[kind] = if target >= 0 -> target else -> -(base - target - 1) - 2
            }
            // copy: the scanner keeps the steps apart from the plan
            step_kinds.push(step.kinds.copy())
            routes.push(route)
        }
    }
    // copy: the scanner keeps its own tables, the plan's or the literals'
    GrammarScanner{lexer: lexer.copy(), keywords: keywords.copy(), names: names, texts: texts, folds: folds, words: words, skips: skips, holes: holes, alone: alone, first_steps: first_steps, fallbacks: fallbacks, step_kinds: step_kinds, routes: routes}
}

/// What a generated parser lexes `plan`'s input with.
grammar_scanner: fn(plan: GrammarPlan) -> GrammarScanner Never! {
    grammar_scanner_of(plan.lexer, plan.keywords, plan.tokens, plan.decisions)
}

/// A cursor at the start of `text`.
cursor_of: fn(text: String) -> GrammarCursor Never! {
    GrammarCursor{text: text.copy(), bytes: text.bytes(), holes: [Int]{}, at: 0, hole: 0, depth: 0, quiet: false, errors: [GrammarError]{}}
}

/// A cursor at the start of a checked literal's `parts`, with a hole
/// between each two.
cursor_of_parts: fn(parts: [String]) -> GrammarCursor Never! {
    ^holes: [Int]{}
    ^length: 0
    loop (i, part) in parts {
        if i > 0 -> holes.push(length)
        length += part.bytes().len()
    }
    text: parts.join("")
    GrammarCursor{text: text.copy(), bytes: text.bytes(), holes: holes, at: 0, hole: 0, depth: 0, quiet: false, errors: [GrammarError]{}}
}

/// Whether `kinds` holds `kind`.
kinds_have: fn(kinds: [Int], kind: Int) -> Bool Never! {
    loop k in kinds {
        if k == kind -> return true
    }
    false
}

/// The end of literal `kind` at byte `at`, before byte `stop`, or -1.
literal_end: fn(scanner: GrammarScanner, kind: Int, bytes: [U8], at: Int, stop: Int) -> Int Never! {
    text: scanner.texts[kind].bytes()
    if at + text.len() > stop -> return -1
    fold: scanner.folds[kind]
    loop i in 0..<text.len() {
        ^x: Int{text[i]}
        ^y: Int{bytes[at + i]}
        if fold {
            x = fold_code_point(x)
            y = fold_code_point(y)
        }
        if x != y -> return -1
    }
    at + text.len()
}

/// The skipped token at byte `at`, before byte `stop`: the longest match
/// of a skip kind, or a `NO_TOKEN` lexeme when none matches.
skip_at: fn(scanner: GrammarScanner, bytes: [U8], at: Int, stop: Int, hole: Int) -> GrammarLexeme Never! {
    ^kind: NO_TOKEN
    ^end: at
    loop k in scanner.skips {
        m: lexer_match_to(scanner.lexer, k, bytes, at, stop)
        if m > end {
            kind = k
            end = m
        }
    }
    GrammarLexeme{kind: kind, start: at, end: end, hole: hole}
}

/// The next token at or after byte `at` among `kinds`, `hole` being the
/// next hole: skipped tokens are passed first. At a hole it is the first
/// hole kind among `kinds`, or `NO_HOLE`; at the end of the input kind 0;
/// where no kind matches, `NO_TOKEN`.
scan_from: fn(scanner: GrammarScanner, cursor: GrammarCursor, at: Int, hole: Int, kinds: [Int]) -> GrammarLexeme Never! {
    bytes: cursor.bytes
    ^stop: bytes.len()
    if hole < cursor.holes.len() -> stop = cursor.holes[hole]
    ^start: at
    loop start < stop {
        skipped: skip_at(scanner, bytes, start, stop, hole)
        if skipped.kind == NO_TOKEN -> break
        start = skipped.end
    }
    if start >= stop && hole < cursor.holes.len() {
        loop k in kinds {
            if kinds_have(scanner.holes, k) -> return GrammarLexeme{kind: k, start: start, end: start, hole: hole + 1}
        }
        return GrammarLexeme{kind: NO_HOLE, start: start, end: start, hole: hole + 1}
    }
    if start >= bytes.len() -> return GrammarLexeme{kind: 0, start: start, end: start, hole: hole}
    ^kind: NO_TOKEN
    ^end: -1
    first: Int{bytes[start]}
    if is_word_byte(first) && !(first >= 48 && first <= 57) {
        word: word_end(bytes, start, stop)
        ^entry: keyword_find(scanner.keywords, bytes, start, word)
        loop entry >= 0 {
            if kinds_have(kinds, scanner.keywords.kinds[entry]) {
                kind = scanner.keywords.kinds[entry]
                end = word
                break
            }
            entry = keyword_next(scanner.keywords, entry, bytes, start, word)
        }
    }
    loop k in kinds {
        if k <= 0 || scanner.words[k] -> next
        if scanner.texts[k] != "" {
            m: literal_end(scanner, k, bytes, start, stop)
            if m > end || (m >= 0 && m == end && scanner.texts[kind] == "") {
                kind = k
                end = m
            }
        } else if k < scanner.lexer.starts.len() && scanner.lexer.starts[k] >= 0 {
            m: lexer_match_to(scanner.lexer, k, bytes, start, stop)
            if m > end {
                kind = k
                end = m
            }
        }
    }
    if kind == NO_TOKEN -> end = start
    GrammarLexeme{kind: kind, start: start, end: end, hole: hole}
}

/// The next token among `kinds`; the cursor does not move.
scan: fn(scanner: GrammarScanner, cursor: GrammarCursor, kinds: [Int]) -> GrammarLexeme Never! {
    scan_from(scanner, cursor, cursor.at, cursor.hole, kinds)
}

/// The token after `before` among `kinds`, for a decision that reads more
/// than one token; the cursor does not move.
scan_after: fn(scanner: GrammarScanner, cursor: GrammarCursor, before: GrammarLexeme, kinds: [Int]) -> GrammarLexeme Never! {
    scan_from(scanner, cursor, before.end, before.hole, kinds)
}

/// Moves the cursor past `lexeme`.
cursor_take: fn(cursor: ^GrammarCursor, lexeme: GrammarLexeme) Never! {
    cursor.at = lexeme.end
    cursor.hole = lexeme.hole
}

/// How an error shows what the parser found: `end of input`, `end of
/// line`, a hole, or the token's text (one character where no token
/// matches) in quotes.
lexeme_found: fn(scanner: GrammarScanner, cursor: GrammarCursor, lexeme: GrammarLexeme) -> String Never! {
    bytes: cursor.bytes
    if lexeme.kind == NO_HOLE -> return "a hole"
    if lexeme.kind > 0 && kinds_have(scanner.holes, lexeme.kind) -> return scanner.names[lexeme.kind].copy()
    if lexeme.kind == 0 || lexeme.start >= bytes.len() -> return "end of input"
    first: Int{bytes[lexeme.start]}
    if first == 10 || (first == 13 && lexeme.start + 1 < bytes.len() && Int{bytes[lexeme.start + 1]} == 10) -> return "end of line"
    ^end: lexeme.end
    if lexeme.kind == NO_TOKEN || end <= lexeme.start -> end = lexeme.start + code_point_width(first)
    ^found: [U8]{}
    loop i in lexeme.start..<end -> found.push(bytes[i])
    literal_name(String.from_bytes(found) ?? "")
}

/// How an error lists `kinds`: each name once, in order.
expected_names: fn(scanner: GrammarScanner, kinds: [Int]) -> [String] Never! {
    ^names: [String]{}
    loop k in kinds {
        name: scanner.names[k]
        ^seen: false
        loop have in names {
            if have == name -> seen = true
        }
        if !seen -> names.push(name.copy())
    }
    names
}

/// Records that the parser expected one of `kinds` where it found
/// `lexeme`, unless an error is already reported since the last
/// resynchronization. Line and column are counted here, only on error.
cursor_fail: fn(cursor: ^GrammarCursor, scanner: GrammarScanner, lexeme: GrammarLexeme, kinds: [Int]) Never! {
    if cursor.quiet -> return
    error: grammar_error_at(cursor.text, lexeme.start, expected_names(scanner, kinds), lexeme_found(scanner, cursor, lexeme))
    cursor.errors.push(error)
    cursor.quiet = true
}

/// The next token, taken when it is one of `kinds`; otherwise it stays,
/// and the error is recorded.
cursor_expect: fn(cursor: ^GrammarCursor, scanner: GrammarScanner, kinds: [Int]) -> GrammarLexeme Never! {
    lexeme: scan(scanner, cursor, kinds)
    if kinds_have(kinds, lexeme.kind) -> cursor_take(cursor, lexeme) else -> cursor_fail(cursor, scanner, lexeme, kinds)
    lexeme
}

/// Enters a rule: false, with an error recorded, when that nests deeper
/// than `GRAMMAR_MAX_DEPTH`.
cursor_enter: fn(cursor: ^GrammarCursor) -> Bool Never! {
    cursor.depth += 1
    if cursor.depth <= GRAMMAR_MAX_DEPTH -> return true
    if !cursor.quiet {
        cursor.errors.push(grammar_error_at(cursor.text, cursor.at, [String]{}, "nesting deeper than {GRAMMAR_MAX_DEPTH} rules"))
        cursor.quiet = true
    }
    false
}

/// Leaves a rule.
cursor_leave: fn(cursor: ^GrammarCursor) Never! {
    cursor.depth -= 1
}

/// After an error, passes tokens up to the next of `stops` (the separator
/// or closing literal of the nearest enclosing repeat) and returns it
/// untaken. Nothing is invented: a token of any kind is passed whole, and
/// a character no token matches alone. Errors are reported again from a
/// stop on; at the end of the input, unless it is a stop, they stay quiet.
cursor_resync: fn(cursor: ^GrammarCursor, scanner: GrammarScanner, stops: [Int]) -> GrammarLexeme Never! {
    ^any: [Int]{}
    loop k in 1..<scanner.names.len() {
        if !kinds_have(scanner.holes, k) -> any.push(k)
    }
    loop {
        lexeme: scan(scanner, cursor, stops)
        if lexeme.kind >= 0 && kinds_have(stops, lexeme.kind) {
            cursor.quiet = false
            return lexeme
        }
        if lexeme.kind == 0 -> return lexeme
        if lexeme.kind == NO_HOLE {
            cursor_take(cursor, lexeme)
            next
        }
        passed: scan_from(scanner, cursor, lexeme.start, lexeme.hole, any)
        if passed.kind > 0 && passed.end > passed.start {
            cursor_take(cursor, passed)
        } else {
            cursor.at = lexeme.start + code_point_width(Int{cursor.bytes[lexeme.start]})
        }
    }
}

/// The text of `lexeme`, as the input spells it.
lexeme_text: fn(cursor: GrammarCursor, lexeme: GrammarLexeme) -> String Never! {
    ^out: [U8]{}
    loop i in lexeme.start..<lexeme.end -> out.push(cursor.bytes[i])
    String.from_bytes(out) ?? ""
}

/// The branch decision `decision` takes at the cursor, reading up to its
/// depth in tokens and taking none. Where the token read leads nowhere,
/// the decision takes its fallback, if it has one; otherwise the error is
/// recorded and the branch is -1.
parse_decide: fn(cursor: ^GrammarCursor, scanner: GrammarScanner, decision: Int) -> Int Never! {
    ^step: scanner.first_steps[decision]
    ^lexeme: scan(scanner, cursor, scanner.step_kinds[step])
    loop {
        ^target: -1
        if lexeme.kind >= 0 -> target = scanner.routes[step][lexeme.kind]
        if target >= 0 -> return target
        if target == -1 {
            fallback: scanner.fallbacks[decision]
            if fallback >= 0 -> return fallback
            cursor_fail(cursor, scanner, lexeme, scanner.step_kinds[step])
            return -1
        }
        step = -target - 2
        lexeme = scan_after(scanner, cursor, lexeme, scanner.step_kinds[step])
    }
}

/// Takes the next token when it is of kind `kind`; otherwise it stays and
/// the error is recorded. Whether it was taken.
parse_token: fn(cursor: ^GrammarCursor, scanner: GrammarScanner, kind: Int) -> Bool Never! {
    cursor_expect(cursor, scanner, scanner.alone[kind]).kind == kind
}

/// The text of the next token, taken, when it is of kind `kind`; otherwise
/// it stays, the error is recorded and there is no text.
parse_text: fn(cursor: ^GrammarCursor, scanner: GrammarScanner, kind: Int) -> String? Never! {
    lexeme: cursor_expect(cursor, scanner, scanner.alone[kind])
    if lexeme.kind != kind -> return None
    Val(lexeme_text(cursor, lexeme))
}

/// Whether a parse that built its value reached the end of the input with
/// no error; trailing input is recorded as the error.
parse_end: fn(cursor: ^GrammarCursor, scanner: GrammarScanner) -> Bool Never! {
    if cursor.errors.len() > 0 -> return false
    parse_token(cursor, scanner, 0)
}

/// The error a failed parse reports: its first. Every failed parse has
/// recorded one.
parse_error: fn(cursor: GrammarCursor) -> GrammarError Never! {
    // copy: the error outlives the cursor
    cursor.errors[0].copy()
}

/// Sends `sink` the skipped tokens from the cursor up to byte `to`.
into_skips: fn<S: GrammarSink>(cursor: GrammarCursor, scanner: GrammarScanner, to: Int, sink: ^S) Never! {
    ^at: cursor.at
    loop at < to {
        skipped: skip_at(scanner, cursor.bytes, at, to, cursor.hole)
        if skipped.kind == NO_TOKEN -> return
        sink.token(skipped.kind, skipped.start, skipped.end)
        at = skipped.end
    }
}

/// Takes the next token when it is of kind `kind`, sending `sink` the
/// skipped tokens before it and then the token; otherwise it stays and the
/// error is recorded. Whether it was taken.
into_token: fn<S: GrammarSink>(cursor: ^GrammarCursor, scanner: GrammarScanner, kind: Int, sink: ^S) -> Bool Never! {
    kinds: scanner.alone[kind]
    lexeme: scan(scanner, cursor, kinds)
    if lexeme.kind != kind {
        cursor_fail(cursor, scanner, lexeme, kinds)
        return false
    }
    into_skips(cursor, scanner, lexeme.start, sink)
    sink.token(kind, lexeme.start, lexeme.end)
    cursor_take(cursor, lexeme)
    true
}

/// What a parse into a sink returns: the end of the last token taken, or
/// the first error recorded.
into_result: fn(cursor: GrammarCursor) -> Int GrammarError! {
    if cursor.errors.len() > 0 -> return Err(parse_error(cursor))
    Ok(cursor.at)
}

/// A print in progress: where it started in its output, the token kind it
/// wrote last (-1 for none yet) and, once it failed, why.
GrammarPen: struct {
    start: Int,
    last: Int,
    error: GrammarError?,
}

/// A pen that prints onto the end of `out`.
pen_of: fn(out: [U8]) -> GrammarPen Never! {
    GrammarPen{start: out.len(), last: -1, error: None}
}

/// Whether the printer separates a token of kind `b` from one of kind `a`
/// before it.
print_glued: fn(printer: GrammarPrinter, a: Int, b: Int) -> Bool Never! {
    bit: a * printer.texts.len() + b
    ((printer.glue[bit /% 32] >> (bit % 32)) & 1) == 1
}

/// Writes `bytes`, a token of kind `kind`, after the separator if the
/// token before could run on into it.
print_bytes: fn(out: ^[U8], pen: ^GrammarPen, printer: GrammarPrinter, kind: Int, bytes: [U8]) Never! {
    if pen.last >= 0 && print_glued(printer, pen.last, kind) {
        loop b in printer.separator.bytes() -> out.push(b)
    }
    loop b in bytes -> out.push(b)
    pen.last = kind
}

/// Writes the token of kind `kind` that no field keeps: its fixed text.
print_token: fn(out: ^[U8], pen: ^GrammarPen, printer: GrammarPrinter, kind: Int) Never! {
    print_bytes(out, pen, printer, kind, printer.texts[kind].bytes())
}

/// Whether all of `bytes`, and nothing less, is a token of kind `kind`: its
/// literal text, folded as the scanner folds it, or a match of its rule.
print_matches: fn(scanner: GrammarScanner, kind: Int, bytes: [U8]) -> Bool Never! {
    if bytes.len() == 0 -> return false
    if scanner.texts[kind] != "" -> return literal_end(scanner, kind, bytes, 0, bytes.len()) == bytes.len()
    lexer_match(scanner.lexer, kind, bytes, 0) == bytes.len()
}

/// Writes field `field`'s `text` as a token of kind `kind`, when it is all
/// one such token; otherwise the error is recorded and nothing is written.
/// Whether it was written.
print_text: fn(out: ^[U8], pen: ^GrammarPen, scanner: GrammarScanner, printer: GrammarPrinter, field: String, text: String, kind: Int) -> Bool Never! {
    bytes: text.bytes()
    if print_matches(scanner, kind, bytes) {
        print_bytes(out, pen, printer, kind, bytes)
        return true
    }
    print_fail(out, pen, "{scanner.names[kind]} for `{field}`", print_text_name(text))
}

/// Writes field `field`'s `text` as the first token of `kinds`, the
/// literals of a labeled choice, that it is all of; otherwise the error is
/// recorded. Whether it was written.
print_text_in: fn(out: ^[U8], pen: ^GrammarPen, scanner: GrammarScanner, printer: GrammarPrinter, field: String, text: String, kinds: [Int]) -> Bool Never! {
    bytes: text.bytes()
    loop kind in kinds {
        if print_matches(scanner, kind, bytes) {
            print_bytes(out, pen, printer, kind, bytes)
            return true
        }
    }
    ^names: [String]{}
    loop kind in kinds -> names.push(scanner.names[kind].copy())
    print_fail(out, pen, "{expected_list(names)} for `{field}`", print_text_name(text))
}

/// A field's text as an error names it: in double quotes, with quotes,
/// backslashes, tabs and line breaks escaped, so a text that would inject a
/// line still reads as one.
print_text_name: fn(text: String) -> String Never! {
    ^quoted: [U8]{U8{34}}
    loop b in text.bytes() {
        code: Int{b}
        escape: if code == {
            9 -> 116
            10 -> 110
            13 -> 114
            34 -> 34
            92 -> 92
            else -> 0
        }
        if escape != 0 -> quoted.push(U8{92})
        quoted.push(if escape != 0 -> U8{escape} else -> b)
    }
    quoted.push(U8{34})
    String.from_bytes(quoted) ?? ""
}

/// Records that field `field` has no value, or list field `field` no more
/// elements, where the grammar needs one. Always false.
print_missing: fn(out: [U8], pen: ^GrammarPen, field: String) -> Bool Never! {
    print_fail(out, pen, "a value for `{field}`", "none")
}

/// Records that list field `field` has an element the grammar has no
/// place for. Always false.
print_extra: fn(out: [U8], pen: ^GrammarPen, field: String) -> Bool Never! {
    print_fail(out, pen, "the end of `{field}`", "another element")
}

/// Records that case `case` binds looser than its place and the rule has
/// no grouping alternative to parenthesize it. Always false.
print_ungrouped: fn(out: [U8], pen: ^GrammarPen, case: String) -> Bool Never! {
    print_fail(out, pen, "a value that binds as tightly as its place", "`{case}`, which the grammar cannot parenthesize")
}

/// Records the error at the end of the text printed so far: the first
/// failure stands. Always false.
print_fail: fn(out: [U8], pen: ^GrammarPen, expected: String, found: String) -> Bool Never! {
    if pen.error == .Val(_) -> return false
    ^printed: [U8]{}
    loop i in pen.start..<out.len() -> printed.push(out[i])
    text: String.from_bytes(printed) ?? ""
    pen.error = Val(grammar_error_at(text, printed.len(), [String]{expected}, found))
    false
}

/// The error a failed print reports. What the print wrote is taken back
/// off `out`, so a refused value leaves no partial text.
print_error: fn(out: ^[U8], pen: GrammarPen) -> GrammarError Never! {
    loop out.len() > pen.start -> _: out.pop()
    // copy: the error outlives the pen
    held: pen.error ?? return grammar_error_at("", 0, [String]{}, "a value the printer refused")
    held.copy()
}

/// The text printed onto `out`, from its start.
print_result: fn(out: [U8]) -> String Never! {
    String.from_bytes(out) ?? ""
}
