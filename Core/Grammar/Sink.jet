// core.grammar.sink — the events a generated `parse_into` sends instead of
// building a tree.

/// Receives one parse as events, in input order: `open(rule)` when a rule
/// starts, `close(rule)` when it ends, and `token(kind, start, end)` for each
/// token, skipped ones (spaces, comments) included. `rule` is the rule's
/// `RULE` constant and `kind` a token-kind constant of the generated types;
/// `start` and `end` are byte offsets into the parsed text, so a sink reads a
/// token's text without a copy being made for it.
GrammarSink: trait {
    open: fn(^self, rule: Int),
    close: fn(^self, rule: Int),
    token: fn(^self, kind: Int, start: Int, end: Int),
}
