// core.grammar — grammars as checked values.
//
// A grammar literal is rule notation in the style ANTLR 4 and Bison share.
// `analyze` reads it, checks it (left recursion outside the operator form,
// ambiguity within 3 tokens, token clashes, unprintable token pairs and
// field shapes are refusals) and returns its plan: the data a generated
// parser and printer run from. Every refusal is a `GrammarFault`.
// `Grammar` is the checked head: `Grammar{"""…"""}` runs `analyze` while
// building and keeps the plan.
use {
    core.grammar.error.[GrammarFault, GrammarFaultKind, GrammarFaults, TextSpot, grammar_faults]
    core.grammar.plan.[GrammarKeywords, GrammarPlan, GrammarScanner, GrammarSource]
    core.grammar.runtime.[GRAMMAR_MAX_DEPTH, NO_HOLE, NO_TOKEN, bounds_column, cursor_enter, cursor_expect, cursor_fail, cursor_leave, cursor_of, cursor_of_parts, cursor_resync, cursor_take, grammar_scanner, keyword_find, keyword_next, lexer_column, lexer_match, parse_decide, parse_end, parse_error, parse_text, parse_token, scan, scan_after, word_end, word_shaped]
    __core_grammar_analyze.[mark_nullable, mark_parents, report_left_recursion, resolve, split_operators]
    __core_grammar_keywords.[plan_keywords]
    __core_grammar_lookahead.[assign_tokens, plan_decisions, plan_sets]
    __core_grammar_precedence.[plan_precedence, report_empty_repeats]
    __core_grammar_print.[plan_printer]
    __core_grammar_shape.[plan_kind_names, plan_shapes]
    __core_grammar_tokens.[plan_tokens]
}

/// The plan of grammar `text`, or every fault in it. `start` is the
/// binding name of the rule a parse starts from; "" lets every parser rule
/// start one. `imports` are the grammars `import Name ;` may name.
analyze: fn(text: String, start: String, imports: [GrammarSource]) -> GrammarPlan GrammarFaults! {
    ^work: resolve(text, start, imports)
    if work.faults.len() > 0 -> return Err(grammar_faults(work.faults))
    split_operators(work)
    mark_parents(work)
    mark_nullable(work)
    report_left_recursion(work)
    report_empty_repeats(work)
    if work.faults.len() > 0 -> return Err(grammar_faults(work.faults))
    plan_precedence(work)
    assign_tokens(work)
    plan_sets(work)
    plan_decisions(work)
    lexer: plan_tokens(work)
    if work.faults.len() > 0 -> return Err(grammar_faults(work.faults))
    shapes: plan_shapes(work)
    kind_names: plan_kind_names(work, shapes)
    if work.faults.len() > 0 -> return Err(grammar_faults(work.faults))
    printer: plan_printer(work, lexer, shapes)
    if work.faults.len() > 0 -> return Err(grammar_faults(work.faults))
    keywords: plan_keywords(work)
    ^decision_of: [Int]{}
    loop _ in work.tree.nodes -> decision_of.push(-1)
    loop (d, decision) in work.decisions -> decision_of[decision.node] = d
    Ok(GrammarPlan{tree: work.tree, start: work.start, parent: work.parent, nullable: work.nullable, operators: work.operators, tokens: work.tokens, decisions: work.decisions, decision_of: decision_of, lexer: lexer, keywords: keywords, shapes: shapes, kind_names: kind_names, printer: printer})
}

/// A checked grammar: the plan of its literal's rule notation, built while
/// building, with every parser rule a start. A refused grammar reports each
/// fault at its spot in the literal. A grammar literal has no holes.
Grammar: struct {
    plan: GrammarPlan,

    impl CheckedText {
        Error: [GrammarFault],
        Hole: String,
        Shape: GrammarPlan,

        check: fn(parts: [String]) -[]> Checked<GrammarPlan, TextSlot> [GrammarFault]! {
            if parts.len() > 1 -> return Err(grammar_hole_faults(parts))
            if analyze(parts[0], "", [GrammarSource]{}) == {
                .Ok(plan) -> Ok(Checked{shape: plan, slots: [TextSlot]{}})
                .Err(faults) -> Err(faults.faults)
            }
        }

        accepts: fn(_slot: TextSlot, _hole: TypeId) -[]> String? { Val(GRAMMAR_HOLE_MESSAGE) }

        encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> String { "{value}" }

        build: fn(shape: GrammarPlan, _holes: [String]) -[]> Grammar { Grammar{plan: shape} }
    }
}

priv GRAMMAR_HOLE_MESSAGE: "a grammar literal has no holes"

/// One fault for each hole of a grammar literal's `parts`, at the place the
/// hole opens: the end of the part before it.
priv grammar_hole_faults: fn(parts: [String]) -> [GrammarFault] Never! {
    ^faults: [GrammarFault]{}
    loop part in 0..<parts.len() - 1 {
        faults.push(GrammarFault{kind: GrammarFaultKind.Notation, at: TextSpot{part: part, offset: parts[part].len()}, message: GRAMMAR_HOLE_MESSAGE, fix: "write the grammar's text whole: it is read while building, so no value can fill a hole"})
    }
    faults
}

// The run-time support over analyzed plans: keyword lookup, the class
// table, the token automata, and what a generated parser calls (contextual
// lexing, keywords as whole words, holes, the depth bound, error text and
// resynchronization). These tests live here because `core.grammar.runtime`
// is private to Core and this is the Core source that both analyzes a
// grammar and imports it.

priv INI: "ini : lines+=line (EOL lines+=line)* ;\nline : section | entry | blank ;\nsection : '[' name=KEY ']' ;\nentry : name=KEY SEP value? ;\nblank : ;\nvalue : text=QUOTED # Quoted | text=BARE # Bare ;\nKEY : [A-Za-z0-9_.\\-]+ ;\nSEP : '=' | ':' ;\nQUOTED : '\"' [^\"\\r\\n]* '\"' ;\nBARE : [^ \\t\\r\\n;#\"'] [^\\r\\n;#]* ;\nEOL : '\\r'? '\\n' ;\nWS : [ \\t]+ -> skip ;\nCOMMENT : [;#] [^\\r\\n]* -> skip ;"

priv plan_of: fn(text: String) -> GrammarPlan Never! {
    if analyze(text, "", [GrammarSource]{}) == {
        .Ok(plan) -> plan
        .Err(error) -> panic("{error}")
    }
}

/// The token kind of the keyword `word` spells, or -1.
priv kind_of: fn(keywords: GrammarKeywords, word: String) -> Int Never! {
    bytes: word.bytes()
    entry: keyword_find(keywords, bytes, 0, bytes.len())
    if entry < 0 -> return -1
    keywords.kinds[entry]
}

/// The token kind named `name`.
priv token_kind: fn(plan: GrammarPlan, name: String) -> Int Never! {
    loop (k, token) in plan.tokens {
        if token.name == name -> return k
    }
    panic("no token {name}")
}

#Test("a word is a keyword only when spelled as a word") {
    assert(word_shaped("select"))
    assert(word_shaped("_rowid_"))
    assert(word_shaped("x2"))
    assert(!word_shaped("2x"))
    assert(!word_shaped("->"))
    assert(!word_shaped("a-b"))
    assert(!word_shaped(""))
    assert_eq(word_end("ab_9-c".bytes(), 0, 6), 4)
    assert_eq(word_end("ab_9-c".bytes(), 4, 6), 4)
    assert_eq(word_end("ab_9-c".bytes(), 0, 2), 2)
}

#Test("each word literal is found from its word, an i literal in any case") {
    plan: plan_of("s : 'select'i name=NAME 'FROM' table=NAME '->' 'x' ;\nNAME : [a-z]+ ;\nWS : ' '+ -> skip ;")
    keywords: plan.keywords
    assert_eq(keywords.kinds.len(), 3)
    assert_eq(kind_of(keywords, "select"), token_kind(plan, "\"select\""))
    assert_eq(kind_of(keywords, "SeLeCt"), token_kind(plan, "\"select\""))
    assert_eq(kind_of(keywords, "FROM"), token_kind(plan, "\"FROM\""))
    assert_eq(kind_of(keywords, "from"), -1)
    assert_eq(kind_of(keywords, "x"), token_kind(plan, "\"x\""))
    assert_eq(kind_of(keywords, "selec"), -1)
    assert_eq(kind_of(keywords, "selects"), -1)
    assert_eq(kind_of(keywords, "->"), -1)
    assert_eq(kind_of(keywords, ""), -1)
}

#Test("a word lexes from inside a longer text") {
    plan: plan_of("s : 'select'i name=NAME ;\nNAME : [a-z]+ ;\nWS : ' '+ -> skip ;")
    bytes: "(SELECT x)".bytes()
    end: word_end(bytes, 1, bytes.len())
    assert_eq(end, 7)
    entry: keyword_find(plan.keywords, bytes, 1, end)
    assert(entry >= 0)
    assert_eq(plan.keywords.kinds[entry], token_kind(plan, "\"select\""))
}

#Test("an i keyword and a plain one of the same letters are both found") {
    plan: plan_of("s : 'select'i 'a' # Folded | '(' 'SELECT' ')' # Exact ;\nWS : ' '+ -> skip ;")
    keywords: plan.keywords
    bytes: "SELECT".bytes()
    first: keyword_find(keywords, bytes, 0, bytes.len())
    assert(first >= 0)
    second: keyword_next(keywords, first, bytes, 0, bytes.len())
    assert(second >= 0)
    assert(keywords.kinds[first] != keywords.kinds[second])
    assert_eq(keyword_next(keywords, second, bytes, 0, bytes.len()), -1)
    lower: "select".bytes()
    only: keyword_find(keywords, lower, 0, lower.len())
    assert(only >= 0)
    assert_eq(keyword_next(keywords, only, lower, 0, lower.len()), -1)
}

#Test("three hundred keywords each find their own slot") {
    ^words: [String]{}
    loop i in 0..<300 -> words.push("'kw{i}'i")
    plan: plan_of("s : k ;\nk : {words.join(" | ")} ;")
    keywords: plan.keywords
    assert_eq(keywords.kinds.len(), 300)
    assert(keywords.slots.len() <= 600)
    loop i in 0..<300 {
        kind: kind_of(keywords, "KW{i}")
        assert(kind > 0)
        assert_eq(plan.tokens[kind].text, "kw{i}")
    }
    assert_eq(kind_of(keywords, "kw300"), -1)
    assert_eq(kind_of(keywords, "kw"), -1)
}

#Test("a grammar with no word literals has an empty table") {
    plan: plan_of("s : '(' s ')' # Group | '-' # Dash ;")
    assert_eq(plan.keywords.slots.len(), 0)
    assert_eq(kind_of(plan.keywords, "x"), -1)
}

#Test("ASCII columns come from the class table, with property bits when masked") {
    plain: plan_of(INI)
    masked: plan_of("a : word=WORD ;\nWORD : \\p{{L}}+ ;")
    assert(!plain.lexer.masked)
    assert(masked.lexer.masked)
    loop lexer in [plain.lexer, masked.lexer] {
        assert_eq(lexer.ascii.len(), 128)
        loop cp in 0..<128 {
            assert_eq(lexer_column(lexer, cp), bounds_column(lexer, cp))
        }
    }
    assert(lexer_column(masked.lexer, 97) != lexer_column(masked.lexer, 49))
    assert_eq(lexer_column(masked.lexer, 233), bounds_column(masked.lexer, 233))
}

#Test("a token matches its longest text") {
    plan: plan_of("a : value=NUM ;\nNUM : [0-9]+ ('.' [0-9]+)? ;")
    assert_eq(lexer_match(plan.lexer, 1, "12.5x".bytes(), 0), 4)
    assert_eq(lexer_match(plan.lexer, 1, "12.x".bytes(), 0), 2)
    assert_eq(lexer_match(plan.lexer, 1, "a1".bytes(), 0), -1)
    assert_eq(lexer_match(plan.lexer, 1, "a1".bytes(), 1), 2)
}

#Test("fragments are matched inside the tokens that name them") {
    plan: plan_of("a : value=NUM ;\nNUM : DIGIT+ ;\nfragment DIGIT : [0-9] ;")
    assert_eq(lexer_match(plan.lexer, 1, "123;".bytes(), 0), 3)
}

#Test("a non-greedy repeat stops at the literal after it") {
    plan: plan_of("a : COMMENT ;\nCOMMENT : '/*' .*? '*/' ;")
    assert_eq(lexer_match(plan.lexer, 1, "/* a */ b */".bytes(), 0), 7)
    assert_eq(lexer_match(plan.lexer, 1, "/* open".bytes(), 0), -1)
}

#Test("Unicode property classes match by property") {
    plan: plan_of("a : word=WORD ;\nWORD : \\p{{L}}+ ;")
    assert(plan.lexer.masked)
    assert_eq(lexer_match(plan.lexer, 1, "héllo1".bytes(), 0), 6)
    assert_eq(lexer_match(plan.lexer, 1, "1a".bytes(), 0), -1)
}

#Test("a literal and a token class that match the same text are no clash") {
    plan: plan_of("s : 'select'i name=NAME ;\nNAME : [a-z]+ ;\nWS : ' '+ -> skip ;")
    assert_eq(lexer_match(plan.lexer, 1, "select".bytes(), 0), 6)
}

/// The token kind `scanner` names `name`.
priv scanner_kind: fn(scanner: GrammarScanner, name: String) -> Int Never! {
    loop (k, have) in scanner.names {
        if have == name -> return k
    }
    panic("no token {name}")
}

priv SELECT: "s : 'select'i name=NAME ;\nNAME : [a-z]+ ;\nWS : ' '+ -> skip ;"

priv LIST: "s : '[' items+=NAME (',' items+=NAME)* ']' ;\nNAME : [a-z]+ ;\nWS : [ \\n]+ -> skip ;"

#Test("the scanner names each kind and marks keywords, skips and holes") {
    scanner: grammar_scanner(plan_of("s : 'go' '->' name=NAME HOLE<slot=Value> ;\nNAME : [a-z]+ ;\nWS : ' '+ -> skip ;"))
    assert_eq(scanner.names[0], "end of input")
    go: scanner_kind(scanner, "\"go\"")
    arrow: scanner_kind(scanner, "\"->\"")
    assert(scanner.words[go])
    assert(!scanner.words[arrow])
    assert_eq(scanner.texts[arrow], "->")
    assert_eq(scanner.texts[scanner_kind(scanner, "NAME")], "")
    assert_eq(scanner.skips, [scanner_kind(scanner, "WS")])
    assert_eq(scanner.holes, [scanner_kind(scanner, "a `Value` hole")])
}

#Test("a keyword lexes only where it can come, and only as a whole word") {
    scanner: grammar_scanner(plan_of(SELECT))
    select: scanner_kind(scanner, "\"select\"")
    name: scanner_kind(scanner, "NAME")
    cursor: cursor_of("  select abc")
    first: scan(scanner, cursor, [select, name])
    assert_eq(first.kind, select)
    assert_eq(first.start, 2)
    assert_eq(first.end, 8)
    assert_eq(scan(scanner, cursor, [name]).kind, name)
    assert_eq(scan(scanner, cursor_of("SeLeCt"), [select, name]).kind, select)
    longer: scan(scanner, cursor_of("selects"), [select, name])
    assert_eq(longer.kind, name)
    assert_eq(longer.end, 7)
}

#Test("the longest literal wins, and a literal beats a token rule of its length") {
    scanner: grammar_scanner(plan_of("s : '-' '>' # Split | '->' # Arrow | name=NAME '=' # Name ;\nNAME : [a-z=]+ ;\nWS : ' '+ -> skip ;"))
    dash: scanner_kind(scanner, "\"-\"")
    arrow: scanner_kind(scanner, "\"->\"")
    equals: scanner_kind(scanner, "\"=\"")
    name: scanner_kind(scanner, "NAME")
    assert_eq(scan(scanner, cursor_of("->"), [dash, arrow]).kind, arrow)
    assert_eq(scan(scanner, cursor_of("- >"), [dash, arrow]).kind, dash)
    assert_eq(scan(scanner, cursor_of("="), [name, equals]).kind, equals)
    assert_eq(scan(scanner, cursor_of("=a"), [name, equals]).kind, name)
}

#Test("taking a token moves the cursor, and a decision can read past it") {
    scanner: grammar_scanner(plan_of(LIST))
    open: scanner_kind(scanner, "\"[\"")
    name: scanner_kind(scanner, "NAME")
    comma: scanner_kind(scanner, "\",\"")
    ^cursor: cursor_of("[ a , b ]")
    _: cursor_expect(cursor, scanner, [open])
    item: scan(scanner, cursor, [name])
    after: scan_after(scanner, cursor, item, [comma])
    assert_eq(after.kind, comma)
    assert_eq(after.start, 4)
    assert_eq(cursor.at, 1)
    cursor_take(cursor, item)
    assert_eq(cursor.at, 3)
}

#Test("the end of input and a character nothing matches") {
    scanner: grammar_scanner(plan_of(LIST))
    name: scanner_kind(scanner, "NAME")
    end: scan(scanner, cursor_of("   "), [name])
    assert_eq(end.kind, 0)
    assert_eq(end.start, 3)
    stray: scan(scanner, cursor_of(" #"), [name])
    assert_eq(stray.kind, NO_TOKEN)
    assert_eq(stray.start, 1)
}

#Test("an error gives line:column, the expected names and what was found") {
    scanner: grammar_scanner(plan_of(LIST))
    open: scanner_kind(scanner, "\"[\"")
    name: scanner_kind(scanner, "NAME")
    close: scanner_kind(scanner, "\"]\"")
    comma: scanner_kind(scanner, "\",\"")
    ^cursor: cursor_of("[a,\n  #é")
    _: cursor_expect(cursor, scanner, [open])
    _: cursor_expect(cursor, scanner, [name])
    _: cursor_expect(cursor, scanner, [comma, close])
    stray: scan(scanner, cursor, [name])
    cursor_fail(cursor, scanner, stray, [name, name])
    assert_eq(cursor.errors.len(), 1)
    assert_eq("{cursor.errors[0]}", "2:3: expected NAME, found \"#\"")
    assert_eq(cursor.errors[0].offset, 6)
    ^ended: cursor_of("[a")
    _: cursor_expect(ended, scanner, [open])
    _: cursor_expect(ended, scanner, [name])
    _: cursor_expect(ended, scanner, [comma, close])
    assert_eq("{ended.errors[0]}", "1:3: expected \",\" or \"]\", found end of input")
}

#Test("a newline the parser cannot take is found as the end of a line") {
    scanner: grammar_scanner(plan_of("s : '[' name=NAME ']' ;\nNAME : [a-z]+ ;\nWS : ' '+ -> skip ;"))
    open: scanner_kind(scanner, "\"[\"")
    name: scanner_kind(scanner, "NAME")
    close: scanner_kind(scanner, "\"]\"")
    ^cursor: cursor_of("[a\n]")
    _: cursor_expect(cursor, scanner, [open])
    _: cursor_expect(cursor, scanner, [name])
    _: cursor_expect(cursor, scanner, [close])
    assert_eq("{cursor.errors[0]}", "1:3: expected \"]\", found end of line")
}

#Test("one error per resync point: after an error the parser is quiet to the next stop") {
    scanner: grammar_scanner(plan_of(LIST))
    open: scanner_kind(scanner, "\"[\"")
    name: scanner_kind(scanner, "NAME")
    close: scanner_kind(scanner, "\"]\"")
    comma: scanner_kind(scanner, "\",\"")
    ^cursor: cursor_of("[a, #b c, %]")
    _: cursor_expect(cursor, scanner, [open])
    _: cursor_expect(cursor, scanner, [name])
    _: cursor_expect(cursor, scanner, [comma, close])
    stray: cursor_expect(cursor, scanner, [name])
    assert_eq(stray.kind, NO_TOKEN)
    _: cursor_expect(cursor, scanner, [name])
    assert_eq(cursor.errors.len(), 1)
    stop: cursor_resync(cursor, scanner, [comma, close])
    assert_eq(stop.kind, comma)
    assert_eq(stop.start, 8)
    cursor_take(cursor, stop)
    _: cursor_expect(cursor, scanner, [name])
    assert_eq(cursor.errors.len(), 2)
    assert_eq("{cursor.errors[1]}", "1:11: expected NAME, found \"%\"")
    last: cursor_resync(cursor, scanner, [comma, close])
    assert_eq(last.kind, close)
    assert_eq(last.start, 11)
}

#Test("resync at the end of the input stays quiet") {
    scanner: grammar_scanner(plan_of(LIST))
    open: scanner_kind(scanner, "\"[\"")
    name: scanner_kind(scanner, "NAME")
    comma: scanner_kind(scanner, "\",\"")
    close: scanner_kind(scanner, "\"]\"")
    ^cursor: cursor_of("[# a b")
    _: cursor_expect(cursor, scanner, [open])
    _: cursor_expect(cursor, scanner, [name])
    end: cursor_resync(cursor, scanner, [comma, close])
    assert_eq(end.kind, 0)
    assert_eq(end.start, 6)
    cursor_fail(cursor, scanner, end, [close])
    assert_eq(cursor.errors.len(), 1)
}

#Test("a hole sits between parts, and no token runs across it") {
    scanner: grammar_scanner(plan_of("s : name=NAME HOLE<slot=Value> other=NAME ;\nNAME : [a-z]+ ;\nWS : ' '+ -> skip ;"))
    name: scanner_kind(scanner, "NAME")
    hole: scanner_kind(scanner, "a `Value` hole")
    ^cursor: cursor_of_parts(["ab ", " cd"])
    first: scan(scanner, cursor, [name])
    assert_eq(first.end, 2)
    cursor_take(cursor, first)
    assert_eq(scan(scanner, cursor, [name]).kind, NO_HOLE)
    at: scan(scanner, cursor, [hole])
    assert_eq(at.kind, hole)
    assert_eq(at.start, 3)
    cursor_take(cursor, at)
    second: scan(scanner, cursor, [name])
    assert_eq(second.start, 4)
    assert_eq(second.end, 6)
    glued: scan(scanner, cursor_of_parts(["ab", "cd"]), [name])
    assert_eq(glued.end, 2)
    ^refused: cursor_of_parts(["ab", "cd"])
    _: cursor_expect(refused, scanner, [name])
    _: cursor_expect(refused, scanner, [name])
    assert_eq("{refused.errors[0]}", "1:3: expected NAME, found a hole")
}

#Test("nesting deeper than the bound is an error, not a stack overflow") {
    ^cursor: cursor_of("x")
    loop _ in 0..<GRAMMAR_MAX_DEPTH -> assert(cursor_enter(cursor))
    assert(!cursor_enter(cursor))
    assert_eq("{cursor.errors[0]}", "1:1: unexpected nesting deeper than {GRAMMAR_MAX_DEPTH} rules")
    cursor_leave(cursor)
    assert_eq(cursor.depth, GRAMMAR_MAX_DEPTH)
}

#Test("a decision reads as far as it needs and takes no token") {
    plan: plan_of("s : name=NAME '=' value=NAME # Set | name=NAME '(' ')' # Call ;\nNAME : [a-z]+ ;\nWS : ' '+ -> skip ;")
    scanner: grammar_scanner(plan)
    decision: plan.decision_of[plan.tree.rules[0].body]
    ^set: cursor_of("a = b")
    assert_eq(parse_decide(set, scanner, decision), 0)
    assert_eq(set.at, 0)
    ^call: cursor_of("a ( )")
    assert_eq(parse_decide(call, scanner, decision), 1)
    assert_eq(call.errors.len(), 0)
    ^neither: cursor_of("a ;")
    assert_eq(parse_decide(neither, scanner, decision), -1)
    assert_eq(neither.errors.len(), 1)
    assert("{neither.errors[0]}".starts_with("1:3: expected "))
}

#Test("a parse takes tokens by kind, reads their text and ends at the end of the input") {
    scanner: grammar_scanner(plan_of("s : name=NAME '=' value=NAME ;\nNAME : [a-z]+ ;\nWS : ' '+ -> skip ;"))
    name: scanner_kind(scanner, "NAME")
    equals: scanner_kind(scanner, "\"=\"")
    ^cursor: cursor_of("ab = cd")
    assert_eq(parse_text(cursor, scanner, name) ?? "", "ab")
    assert(parse_token(cursor, scanner, equals))
    assert_eq(parse_text(cursor, scanner, name) ?? "", "cd")
    assert(parse_end(cursor, scanner))
    ^trailing: cursor_of("ab = cd ef")
    _: parse_text(trailing, scanner, name)
    _: parse_token(trailing, scanner, equals)
    _: parse_text(trailing, scanner, name)
    assert(!parse_end(trailing, scanner))
    assert("{parse_error(trailing)}".starts_with("1:9: expected "))
    ^wrong: cursor_of("ab cd")
    _: parse_text(wrong, scanner, name)
    assert(!parse_token(wrong, scanner, equals))
    assert_eq(wrong.errors.len(), 1)
    assert("{parse_error(wrong)}".starts_with("1:4: expected \"=\""))
    assert(!parse_end(wrong, scanner))
}
