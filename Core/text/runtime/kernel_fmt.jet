// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:1-462
// D-FMT1: runtime entry points for formatting. core.text.fmt is the one
// implementation (D-CORE-SOURCE-AUTHORITY1, owner rulings on #4588); these
// adapters only marshal the compiler's carriers (I64, the exact Int's decimal
// spelling) and keep the compiler-referenced jet_fmt_* names until the
// compiler side changes with them. Members reached only through their
// source-owned dispatcher rows (number, bytes, duration, ordinal, plural,
// pad_right, pad_center) have no runtime entry point here; interpolation
// selectors and quantity display still name the rows below.
use core.text.fmt as fmt
use core.text.runtime.kernel_float_format as float_format

// Rust: Fmt.rs:7
pub fn jet_fmt_decimal(value: F64, precision: I64) -> String Never! { fmt.decimal(value, Int{precision}) }
// Rust: Fmt.rs:14. Quantity display drops only an incidental ".0" from the
// Debug spelling; fractional digits survive.
pub fn jet_fmt_quantity(value: F64) -> String Never! {
    text :: float_format.debug(value)
    if text.ends_with(".0") -> text.slice(0, text.len() - 2) else -> text
}
// Rust: Fmt.rs:23
pub fn jet_fmt_grouped(value: F64, precision: I64) -> String Never! { fmt.grouped(value, Int{precision}) }
// Rust: Fmt.rs:31,37. Exact decimal carriers never pass through a lossy float.
pub fn jet_fmt_decimal_int(value: String, precision: I64) -> String Never! { exact_decimal(value, precision, false) }
pub fn jet_fmt_grouped_int(value: String, precision: I64) -> String Never! { exact_decimal(value, precision, true) }
// Rust: Fmt.rs:81-91. Malformed spellings are returned trimmed, unchanged.
pub fn jet_fmt_hex_decimal(value: String, width: I64) -> String Never! {
    n :: decimal_spelling(value) ?? return value.trim()
    fmt.hex(n, Int{width})
}
pub fn jet_fmt_bin_decimal(value: String) -> String Never! {
    n :: decimal_spelling(value) ?? return value.trim()
    fmt.bin(n)
}
pub fn jet_fmt_oct_decimal(value: String) -> String Never! {
    n :: decimal_spelling(value) ?? return value.trim()
    fmt.oct(n)
}
// Rust: Fmt.rs:153-461.
pub fn jet_fmt_sci(value: F64, precision: I64) -> String Never! { fmt.sci(value, Int{precision}) }
pub fn jet_fmt_pretty(value: String) -> String Never! { fmt.pretty(value) }
pub fn jet_fmt_percent(value: F64, precision: I64) -> String Never! { fmt.percent(value, Int{precision}) }
pub fn jet_fmt_pad(text: String, width: I64, fill: String) -> String Never! { fmt.pad(text, Int{width}, fill) }
pub fn jet_fmt_pad_left(text: String, width: I64, fill: String) -> String Never! { fmt.pad_left(text, Int{width}, fill) }

// An optional sign then ASCII digits only (Rust rejects everything else).
fn decimal_spelling(value: String) -> Int? Never! {
    text :: value.trim()
    negative :: text.starts_with("-")
    digits :: if negative || text.starts_with("+") -> text.slice(1, text.len()) else -> text
    if digits == "" -> return None
    loop byte in digits.bytes() {
        if byte < 48 || byte > 57 -> return None
    }
    magnitude :: digits.parse<Int>() ?? return None
    Val(if negative -> -magnitude else -> magnitude)
}

// Rust: Fmt.rs:41. Leading zeros and a negative zero normalize through Int.
fn exact_decimal(value: String, precision: I64, grouped: Bool) -> String Never! {
    n :: decimal_spelling(value) ?? return value.trim()
    whole :: if grouped -> fmt.number(n) else -> "{n}"
    if precision <= 0 -> return whole
    "{whole}.{"0".repeat(Int{precision})}"
}
