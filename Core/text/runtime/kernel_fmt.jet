// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:1
// D-FMT1: pure formatting value kernel shared by native and comptime consumers.
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:3
pub fn jet_fmt_number(value: I64) -> String { comma_int(value) }
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:7
pub fn jet_fmt_decimal(value: F64, precision: I64) -> String {
    precision :: precision.max(0) as USize
    format("{:.*}", precision, value)
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:14
// Quantity display drops only incidental .0; fractional magnitude digits survive.
pub fn jet_fmt_quantity(value: F64) -> String {
    text := format("{:?}", value)
    if text.ends_with(".0") { text.truncate(text.len() - 2) }
    text
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:23
pub fn jet_fmt_grouped(value: F64, precision: I64) -> String {
    precision :: precision.max(0) as USize
    comma_decimal(format("{:.*}", precision, value))
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:31
// Exact decimal carriers never pass through a lossy float conversion.
pub fn jet_fmt_decimal_int(value: String, precision: I64) -> String { format_decimal_int(value, precision, false) }
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:37
pub fn jet_fmt_grouped_int(value: String, precision: I64) -> String { format_decimal_int(value, precision, true) }
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:41
fn format_decimal_int(value: String, precision: I64, grouped: Bool) -> String {
    precision :: precision.max(0) as USize
    value := value.trim() // #4303
    (negative, digits) :: if value.strip_prefix('-') is Val(rest) { (true, rest) }
        else if value.strip_prefix('+') is Val(rest) { (false, rest) }
        else { (false, value) }
    if digits.is_empty() || !digits.bytes().all(fn(digit) { digit.is_ascii_digit() }) { return value.to_string() }
    digits := digits.trim_start_matches('0') // #4303
    digits :: if digits.is_empty() { "0" } else { digits }
    sign :: if negative && digits != "0" { "-" } else { "" }
    grouped_digits :: if grouped { Val(group_decimal_digits(digits)) } else { None }
    whole :: grouped_digits.as_deref().unwrap_or(digits)
    out := String.with_capacity(sign.len() + whole.len() + (precision > 0) as USize + precision)
    out.push_str(sign)
    out.push_str(whole)
    if precision > 0 {
        out.push('.')
        loop _ in 0..<precision { out.push('0') }
    }
    out
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:81
pub fn jet_fmt_hex_decimal(value: String, width: I64) -> String { jet_fmt_radix_decimal(value, 16, width) }
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:85
pub fn jet_fmt_bin_decimal(value: String) -> String { jet_fmt_radix_decimal(value, 2, 0) }
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:89
pub fn jet_fmt_oct_decimal(value: String) -> String { jet_fmt_radix_decimal(value, 8, 0) }
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:93
fn jet_fmt_radix_decimal(value: String, radix: U16, width: I64) -> String {
    value := value.trim() // #4303
    (negative, digits) :: if value.strip_prefix('-') is Val(rest) { (true, rest) }
        else if value.strip_prefix('+') is Val(rest) { (false, rest) }
        else { (false, value) }
    decimal := [U8].with_capacity(digits.len())
    loop digit in digits.bytes() {
        digit :: digit.wrapping_sub('0' as U8)
        if digit > 9 { return value.to_string() }
        if digit != 0 || !decimal.is_empty() { decimal.push(digit) }
    }
    if decimal.is_empty() {
        if digits.is_empty() { return value.to_string() }
        decimal.push(0)
    }
    converted := [Char].with_capacity(decimal.len())
    loop decimal.iter().any(fn(digit) { *digit != 0 }) {
        carry := U16{0}
        quotient := [U8].with_capacity(decimal.len())
        loop digit in decimal {
            current :: carry * 10 + digit as U16
            next :: current / radix
            carry = current % radix
            if !quotient.is_empty() || next != 0 { quotient.push(next as U8) }
        }
        converted.push("0123456789abcdef".as_bytes()[carry as USize] as Char)
        decimal = ^quotient
    }
    if converted.is_empty() { converted.push('0') } else { converted.reverse() }
    padding :: (width.max(0) as USize).saturating_sub(converted.len())
    zero :: converted.len() == 1 && converted[0] == '0'
    signed :: negative && !zero
    out := String.with_capacity(signed as USize + padding + converted.len())
    if signed { out.push('-') }
    loop _ in 0..<padding { out.push('0') }
    out.extend(^converted)
    out
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:153
pub fn jet_fmt_sci(value: F64, precision: I64) -> String {
    precision :: precision.max(0) as USize
    format("{:.*e}", precision, value)
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:162
// Layout canonical Debug text only: preserve ordering/redaction and skip quoted strings.
pub fn jet_fmt_pretty(value: String) -> String { pretty_fragment(value, 0) }
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:166
fn pretty_fragment(value: String, indent: USize) -> String {
    value := value.trim() // #4303
    (open_at, open, close) :: match first_structure(value) { Val(pair) -> pair, None -> return value.to_string() }
    end :: match matching_close(value, open, close) { Val(end) -> end, None -> return value.to_string() }
    if !value[end + close.len_utf8()..].trim().is_empty() { return value.to_string() }
    prefix := value[..open_at].trim_end() // #4303
    body :: &value[open_at + open.len_utf8()..<end]
    if body.trim().is_empty() {
        result := "{prefix} {open}{close}".trim_start() // #4303
        return result.to_string()
    }
    if open == '[' && (body.trim() == ":" || body.trim().eq_ignore_ascii_case("redacted")) { return value.to_string() }
    out := String.new()
    if !prefix.is_empty() { out.push_str(prefix); out.push(' ') }
    out.push(open)
    loop item in split_top_level(body) {
        out.push('\n')
        out.push_str(&" ".repeat(indent + 2))
        out.push_str(&pretty_fragment(item, indent + 2))
    }
    out.push('\n')
    out.push_str(&" ".repeat(indent))
    out.push(close)
    out
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:207
// Structural offsets are UTF-8 byte positions from the scan, never scalar indices.
fn first_structure(value: String) -> (USize, Char, Char)? {
    quoted := false
    escaped := false
    loop (offset, ch) in value.char_indices() {
        if quoted {
            if escaped { escaped = false }
            else if ch == '\\' { escaped = true }
            else if ch == '"' { quoted = false }
            next
        }
        if ch == '"' { quoted = true }
        else if close_for(ch) is Val(close) { return Val((offset, ch, close)) }
    }
    None
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:230
fn close_for(open: Char) -> Char? {
    match open { '{' -> Val('}'), '[' -> Val(']'), '(' -> Val(')'), _ -> None }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:239
fn matching_close(value: String, start: Char, expected: Char) -> USize? {
    stack := [expected]
    quoted := false
    escaped := false
    seen_start := false
    loop (index, ch) in value.char_indices() {
        if !seen_start {
            if ch == start { seen_start = true }
            next
        }
        if quoted {
            if escaped { escaped = false }
            else if ch == '\\' { escaped = true }
            else if ch == '"' { quoted = false }
            next
        }
        if ch == '"' { quoted = true; next }
        if close_for(ch) is Val(close) { stack.push(close) }
        else if stack.last().copied() == Val(ch) {
            _ :: stack.pop()
            if stack.is_empty() { return Val(index) }
        }
    }
    None
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:277
fn split_top_level(value: String) -> [String] {
    items := [String]{}
    start := USize{0}
    stack := [Char]{}
    quoted := false
    escaped := false
    loop (index, ch) in value.char_indices() {
        if quoted {
            if escaped { escaped = false }
            else if ch == '\\' { escaped = true }
            else if ch == '"' { quoted = false }
            next
        }
        if ch == '"' { quoted = true }
        else if close_for(ch) is Val(close) { stack.push(close) }
        else if stack.last().copied() == Val(ch) { _ :: stack.pop() }
        else if ch == ',' && stack.is_empty() {
            item := value[start..<index].trim() // #4303
            if !item.is_empty() { items.push(item) }
            start = index + ch.len_utf8()
        }
    }
    item := value[start..].trim() // #4303
    if !item.is_empty() { items.push(item) }
    items
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:313
pub fn jet_fmt_percent(value: F64, precision: I64) -> String { "{jet_fmt_grouped(value * 100.0, precision)}%" }
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:317
pub fn jet_fmt_bytes(value: I64) -> String {
    sign :: if value < 0 { "-" } else { "" }
    size := (value as F64).abs()
    units :: ["B", "KB", "MB", "GB", "TB", "PB", "EB"]
    unit := USize{0}
    loop size >= 1000.0 && unit + 1 < units.len() { size /= 1000.0; unit += 1 }
    if unit == 0 { format("{}{} {}", sign, size as I64, units[unit]) }
    else if size >= 10.0 { format("{}{} {}", sign, size.round() as I64, units[unit]) }
    else {
        shown :: format("{:.1}", size)
        shown := shown.trim_end_matches(".0") // #4303
        format("{}{} {}", sign, shown, units[unit])
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:336
pub fn jet_fmt_duration(ms: I64) -> String {
    sign :: if ms < 0 { "-" } else { "" }
    rest := ms.abs()
    if rest < 1000 { return "{sign}{rest}ms" }
    days :: rest / 86_400_000
    rest %= 86_400_000
    hours :: rest / 3_600_000
    rest %= 3_600_000
    minutes :: rest / 60_000
    rest %= 60_000
    seconds :: rest / 1000
    parts := [String]{}
    if days > 0 { parts.push("{days}d") }
    if hours > 0 { parts.push("{hours}h") }
    if minutes > 0 { parts.push("{minutes}m") }
    if seconds > 0 || parts.is_empty() { parts.push("{seconds}s") }
    format("{}{}", sign, parts.into_iter().take(3).collect<[String]>().join(" "))
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:365
pub fn jet_fmt_ordinal(value: I64) -> String {
    n :: value.abs()
    suffix :: if (11..=13).contains(&(n % 100)) { "th" }
        else { match n % 10 { 1 -> "st", 2 -> "nd", 3 -> "rd", _ -> "th" } }
    "{comma_int(value)}{suffix}"
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:380
pub fn jet_fmt_plural(count: I64, singular: &String, plural: &String) -> String {
    word :: if count.abs() == 1 { singular } else { plural }
    "{comma_int(count)} {word}"
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:385
pub fn jet_fmt_pad(text: &String, width: I64, fill: &String) -> String { jet_fmt_pad_right(text, width, fill) }
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:389
pub fn jet_fmt_pad_left(text: &String, width: I64, fill: &String) -> String {
    need :: pad_need(text, width)
    "{pad_fill(fill, need)}{text}"
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:394
pub fn jet_fmt_pad_right(text: &String, width: I64, fill: &String) -> String {
    need :: pad_need(text, width)
    "{text}{pad_fill(fill, need)}"
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:399
pub fn jet_fmt_pad_center(text: &String, width: I64, fill: &String) -> String {
    need :: pad_need(text, width)
    left :: need / 2
    right :: need - left
    "{pad_fill(fill, left)}{text}{pad_fill(fill, right)}"
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:406
fn pad_need(text: String, width: I64) -> USize { (width.max(0) as USize).saturating_sub(text.chars().count()) }
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:410
fn pad_fill(fill: String, len: USize) -> String {
    if len == 0 { return "" }
    fill :: if fill.is_empty() { " " } else { fill }
    out := String.new()
    loop out.chars().count() < len { out.push_str(fill) }
    out.chars().take(len).collect()
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:422
fn comma_int(value: I64) -> String { group_decimal_digits(&value.to_string()) }
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:426
fn group_decimal_digits(raw: String) -> String {
    (sign, digits) :: if raw.strip_prefix('-') is Val(rest) { ("-", rest) }
        else if raw.strip_prefix('+') is Val(rest) { ("+", rest) }
        else { ("", raw) }
    count :: digits.chars().count()
    out := String.with_capacity(sign.len() + digits.len() + count.saturating_sub(1) / 3)
    out.push_str(sign)
    loop (index, ch) in digits.chars().enumerate() {
        if index > 0 && (count - index) % 3 == 0 { out.push(',') }
        out.push(ch)
    }
    out
}
// Rust: crates/jet-codegen/src/Prelude/Core/Fmt.rs:448
fn comma_decimal(raw: String) -> String {
    (sign, rest) :: raw.strip_prefix('-').map_or(("", raw.as_str()), fn(s) { ("-", s) })
    split := rest.splitn(2, '.')
    whole :: split.next().unwrap_or("0")
    frac :: split.next()
    // Retain exact decimal text; parsing whole as I64 loses large magnitudes.
    whole_text :: group_decimal_digits(whole)
    match frac { Val(frac) -> "{sign}{whole_text}.{frac}", None -> "{sign}{whole_text}" }
}
