impl<T: JetDisplay> JetDisplay for HashSet<T> {
    // Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:104
    fn jet_display(self) -> String {
        parts := self.iter().map(fn(value) { value.jet_display() }).collect<[String]>()
        parts.sort()
        jet_text_list(^parts)
    }
}
