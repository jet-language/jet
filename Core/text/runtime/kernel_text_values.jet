// D-DISPLAYDBG1 / I9: one Display/Debug formatter at every execution seam.
// Adapters marshal carriers; they do not choose container or clean/told shapes.
// Main ruling A (#4588): the impls live on the Jet Core collection types, never
// on the Rust containers they currently lower to (HashSet, BTreeSet, VecDeque,
// BinaryHeap stay a backend detail).
use core.prelude.runtime.kernel_values.[JetDisplay, JetDebug]
use core.mem.runtime.portable_core.[JetAbsent, JetOutcome]
use jet_std.JetTaskFailure

// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:5
fn jet_text_list(values: [String]) -> String Never! { "[{values.join(", ")}]" }
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:22. An empty map renders `[:]`.
fn jet_text_map(entries: [(key: String, value: String)]) -> String Never! {
    if entries.len() == 0 -> return "[:]"
    parts :: loop entry in entries -> "{entry.key}: {entry.value}"
    jet_text_list(parts)
}
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:45
fn jet_text_debug_optional(payload: String?) -> String Never! {
    text :: payload ?? return "None"
    "Val({text})"
}
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:59-66 (`&T` forwarding):
// no port. Jet has no reference value type; a read parameter already renders
// through the referent's own impl.

// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:70-90. Lists, fixed
// lists and views render elements in order.
impl View<T>.JetDisplay {
    fn jet_display(self) -> String Never! { jet_text_list(loop value in self -> value.jet_display()) }
}
impl View<T>.JetDebug {
    fn jet_debug(self) -> String Never! { jet_text_list(loop value in self -> value.jet_debug()) }
}
impl [T].JetDisplay {
    fn jet_display(self) -> String Never! { jet_text_list(loop value in self -> value.jet_display()) }
}
impl [T].JetDebug {
    fn jet_debug(self) -> String Never! { jet_text_list(loop value in self -> value.jet_debug()) }
}
impl [T#N].JetDisplay {
    fn jet_display(self) -> String Never! { jet_text_list(loop value in self -> value.jet_display()) }
}
impl [T#N].JetDebug {
    fn jet_debug(self) -> String Never! { jet_text_list(loop value in self -> value.jet_debug()) }
}
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:103-117 (HashSet). A
// Set has no element order, so the rendered elements are sorted as text.
impl Set<T>.JetDisplay {
    fn jet_display(self) -> String Never! {
        parts :: loop value in self.to_list() -> value.jet_display()
        sorted := ~parts
        &sorted.sort()
        jet_text_list(sorted)
    }
}
impl Set<T>.JetDebug {
    fn jet_debug(self) -> String Never! {
        parts :: loop value in self.to_list() -> value.jet_debug()
        sorted := ~parts
        &sorted.sort()
        jet_text_list(sorted)
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:118-127 (BTreeSet): ascending order.
impl Rank<T>.JetDisplay {
    fn jet_display(self) -> String Never! { jet_text_list(loop value in self.to_list() -> value.jet_display()) }
}
impl Rank<T>.JetDebug {
    fn jet_debug(self) -> String Never! { jet_text_list(loop value in self.to_list() -> value.jet_debug()) }
}
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:129-150 (BinaryHeap):
// greatest first, i.e. the ascending sorted list reversed.
impl PriorityQueue<T>.JetDisplay {
    fn jet_display(self) -> String Never! {
        sorted :: self.to_sorted_list()
        jet_text_list(loop i in 0..<sorted.len() -> sorted[sorted.len() - 1 - i].jet_display())
    }
}
impl PriorityQueue<T>.JetDebug {
    fn jet_debug(self) -> String Never! {
        sorted :: self.to_sorted_list()
        jet_text_list(loop i in 0..<sorted.len() -> sorted[sorted.len() - 1 - i].jet_debug())
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:152-161 (VecDeque): front to back.
impl Queue<T>.JetDisplay {
    fn jet_display(self) -> String Never! { jet_text_list(loop value in self.to_list() -> value.jet_display()) }
}
impl Queue<T>.JetDebug {
    fn jet_debug(self) -> String Never! { jet_text_list(loop value in self.to_list() -> value.jet_debug()) }
}
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:163-178 (BTreeMap) and
// 201-210 (Infallible): no port. No Jet type lowers to BTreeMap ([K:V] is the
// ordered JetMap) and Jet has no uninhabited Infallible carrier.

// D-FAIL-CARRIER1=A: only JetAbsent's rail is clean, all other errors are told.
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:182-199
impl JetAbsent.JetDisplay {
    fn jet_display(self) -> String Never! { "null" }
    fn jet_report_is_clean() -> Bool Never! { true }
}
impl JetAbsent.JetDebug {
    fn jet_debug(self) -> String Never! { "null" }
    fn jet_report_is_clean() -> Bool Never! { true }
}
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:212-229
impl JetTaskFailure.JetDisplay {
    fn jet_display(self) -> String Never! {
        if self == {
            .Cancelled -> "Cancelled"
            .DeadlineBlown -> "DeadlineBlown"
            .Panicked(reason) -> "Panicked({reason})"
        }
    }
}
impl JetTaskFailure.JetDebug {
    fn jet_debug(self) -> String Never! {
        if self == {
            .Cancelled -> "Cancelled"
            .DeadlineBlown -> "DeadlineBlown"
            .Panicked(reason) -> "Panicked({reason:Debug})"
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:231-252. A clean error
// rail renders the bare payload (Debug: Val(..)/None); a told rail names Ok/Err.
impl JetOutcome<T, E>.JetDisplay {
    fn jet_display(self) -> String Never! {
        clean :: E.jet_report_is_clean()
        if self == {
            .Ok(value) -> if clean -> value.jet_display() else -> "Ok({value.jet_display()})"
            .Err(error) -> if clean -> error.jet_display() else -> "Err({error.jet_display()})"
        }
    }
}
impl JetOutcome<T, E>.JetDebug {
    fn jet_debug(self) -> String Never! {
        clean :: E.jet_report_is_clean()
        if self == {
            .Ok(value) -> if clean -> jet_text_debug_optional(Val(value.jet_debug())) else -> "Ok({value.jet_debug()})"
            .Err(error) -> if clean -> jet_text_debug_optional(None) else -> "Err({error.jet_debug()})"
        }
    }
}
