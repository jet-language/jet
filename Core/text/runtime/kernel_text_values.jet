// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:5
fn jet_text_list<I: IntoIterator<Item=String>>(values: I) -> String {
    out := String.from("[")
    first := true
    for value in values {
        if !first { out.push_str(", ") }
        out.push_str(&value)
        first = false
    }
    out.push(']')
    out
}
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:22
fn jet_text_map<I: IntoIterator<Item=(String, String)>>(entries: I) -> String {
    out := String.from("[")
    first := true
    for (key, value) in entries {
        if !first { out.push_str(", ") }
        out.push_str(&key)
        out.push_str(": ")
        out.push_str(&value)
        first = false
    }
    if first { "[:]" } else { out.push(']'); out }
}
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:45
fn jet_text_debug_optional(payload: String?) -> String {
    match payload {
        Val(payload) -> {
            out := String.with_capacity(payload.len() + 5)
            out.push_str("Val(")
            out.push_str(&payload)
            out.push(')')
            out
        }
        None -> "None"
    }
}
