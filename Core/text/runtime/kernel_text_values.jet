// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:212
impl JetDisplay for JetTaskFailure {
    // Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:213
    fn jet_display(self) -> String {
        match self { .Cancelled -> "Cancelled", .DeadlineBlown -> "DeadlineBlown", .Panicked(reason) -> "Panicked({reason})" }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:221
impl JetDebug for JetTaskFailure {
    // Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:222
    fn jet_debug(self) -> String {
        match self { .Cancelled -> "Cancelled", .DeadlineBlown -> "DeadlineBlown", .Panicked(reason) -> "Panicked({reason:?})" }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:231
impl<T: JetDisplay, E: JetDisplay> JetDisplay for JetOutcome<T, E> {
    // Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:232
    fn jet_display(self) -> String {
        clean :: E.jet_report_is_clean()
        match self {
            Ok(value) -> if clean { value.jet_display() } else { "Ok({value.jet_display()})" }
            Err(error) -> if clean { error.jet_display() } else { "Err({error.jet_display()})" }
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:242
impl<T: JetDebug, E: JetDebug> JetDebug for JetOutcome<T, E> {
    // Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:243
    fn jet_debug(self) -> String {
        clean :: E.jet_report_is_clean()
        match self {
            Ok(value) -> if clean { jet_text_debug_optional(Val(value.jet_debug())) } else { "Ok({value.jet_debug()})" }
            Err(error) -> if clean { jet_text_debug_optional(None) } else { "Err({error.jet_debug()})" }
        }
    }
}
