// Unsized views must render too; the reference layer never allocates a copy.
impl<T: JetDisplay + ?Sized> JetDisplay for &T {
    // Rust: crates/jet-codegen/src/Prelude/Core/TextValues.rs:60
    fn jet_display(self) -> String { self.deref().jet_display() }
}
