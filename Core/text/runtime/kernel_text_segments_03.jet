fn jet_std_fs_is_dir(path: &String) -> Bool {
    // GATE #4565: kernel primitive
    #Unsafe("query actual path metadata with native is-directory semantics") { OSPath.from(path).is_dir() }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1850
fn jet_std_fs_remove_dir(path: &String) -> () IOError! {
    if jet_fault_should_fail("FS.Write") { return Err(IOError.other(IOOperation.Write, Val(path.clone()), "fault injected: FS.Write")) }
    // GATE #4565: kernel primitive
    #Unsafe("remove an actual empty directory, preserving native failure") { fs.remove_dir(OSPath.from(path)) }.map_err(fn(e) { io_error_at(IOOperation.Write, path, e) })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1860
fn jet_std_fs_remove_all(path: &String) -> () IOError! {
    if jet_fault_should_fail("FS.Write") { return Err(IOError.other(IOOperation.Write, Val(path.clone()), "fault injected: FS.Write")) }
    p :: OSPath.from(path)
    // GATE #4565: kernel primitive
    #Unsafe("classify actual path and remove directory tree or file with original symlink behavior") {
        if p.is_dir() { fs.remove_dir_all(p) } else { fs.remove_file(p) }
    }.map_err(fn(e) { io_error_at(IOOperation.Write, path, e) })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1875
fn jet_std_fs_copy(from: &String, to: &String) -> () IOError! {
    if jet_fault_should_fail("FS.Read") { return Err(IOError.other(IOOperation.Read, Val(from.clone()), "fault injected: FS.Read")) }
    if jet_fault_should_fail("FS.Write") { return Err(IOError.other(IOOperation.Write, Val(to.clone()), "fault injected: FS.Write")) }
    // GATE #4565: kernel primitive
    #Unsafe("copy real file bytes and retain source-path Write error attribution") { fs.copy(OSPath.from(from), OSPath.from(to)) }.map(fn(_) { () }).map_err(fn(e) { io_error_at(IOOperation.Write, from, e) })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1894
fn jet_std_fs_copy_dir(from: &String, to: &String) -> () IOError! {
    if jet_fault_should_fail("FS.Read") { return Err(IOError.other(IOOperation.Read, Val(from.clone()), "fault injected: FS.Read")) }
    if jet_fault_should_fail("FS.Write") { return Err(IOError.other(IOOperation.Write, Val(to.clone()), "fault injected: FS.Write")) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1909
    fn copy_tree(src: &OSPath, dst: &OSPath, shown: &String) -> () IOError! {
        // GATE #4565: kernel primitive
        #Unsafe("create real destination ancestors") { fs.create_dir_all(dst) }.map_err(fn(e) { io_error_at(IOOperation.Write, shown, e) })?
        // GATE #4565: kernel primitive
        entries :: #Unsafe("enumerate real source directory entries") { fs.read_dir(src) }.map_err(fn(e) { io_error_at(IOOperation.Read, shown, e) })?
        loop entry in entries {
            entry :: entry.map_err(fn(e) { io_error_at(IOOperation.Read, shown, e) })?
            src_path :: entry.path()
            dst_path :: dst.join(entry.file_name())
            // GATE #4565: kernel primitive
            ft :: #Unsafe("read actual entry file type without following symlinks") { entry.file_type() }.map_err(fn(e) { io_error_at(IOOperation.Read, shown, e) })?
            if ft.is_dir() { copy_tree(&src_path, &dst_path, shown)? }
            else if ft.is_file() {
                // GATE #4565: kernel primitive
                _ :: #Unsafe("copy actual regular-file content, ignoring non-file/non-directory entries") { fs.copy(&src_path, &dst_path) }.map_err(fn(e) { io_error_at(IOOperation.Write, shown, e) })?
            }
        }
        Ok(())
    }
    copy_tree(&OSPath.from(from), &OSPath.from(to), from)
}

