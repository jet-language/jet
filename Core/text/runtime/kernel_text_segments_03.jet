// Marshaling only: Unicode/scalar/display semantics stay in the canonical text owner.
// Main publishes the following C exports only for selected_arch() == wasm32.
module jet_text_wasm {
    use super.*
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1943
    // GATE #4565: kernel primitive
    static JET_TEXT_WASM_INPUT_SUBJECT: ThreadLocal<RefCell<[U8]>> = #Unsafe("one owned subject allocation per wasm thread") { ThreadLocal.new(fn() { RefCell.new([]) }) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1945
    // GATE #4565: kernel primitive
    static JET_TEXT_WASM_INPUT_SEARCH: ThreadLocal<RefCell<[U8]>> = #Unsafe("one owned search allocation per wasm thread") { ThreadLocal.new(fn() { RefCell.new([]) }) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1947
    // GATE #4565: kernel primitive
    static JET_TEXT_WASM_INPUT_FILL: ThreadLocal<RefCell<[U8]>> = #Unsafe("one owned fill allocation per wasm thread") { ThreadLocal.new(fn() { RefCell.new([]) }) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1949
    // GATE #4565: kernel primitive
    static JET_TEXT_WASM_OUTPUT: ThreadLocal<RefCell<[U8]>> = #Unsafe("one retained output allocation per wasm thread") { ThreadLocal.new(fn() { RefCell.new([]) }) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1954
    fn jet_text_wasm_checked_len(length: U32) -> USize {
        length :: length as USize
        assert(length <= U32.MAX as USize, "text Wasm buffer length exceeds the u32 ABI")
        length
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1964
    fn jet_text_wasm_input_cell(slot: U32) -> &ThreadLocal<RefCell<[U8]>> {
        match slot { 0 -> &JET_TEXT_WASM_INPUT_SUBJECT, 1 -> &JET_TEXT_WASM_INPUT_SEARCH, 2 -> &JET_TEXT_WASM_INPUT_FILL, _ -> panic("text Wasm input slot is invalid") }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1976
    // GATE #4565: kernel primitive
    #Unsafe("publish only the owning slot's initialized wasm allocation until resize or free")
    fn jet_text_wasm_input_alloc_slot(slot: U32, length: U32) -> U32 {
        length :: jet_text_wasm_checked_len(length)
        jet_text_wasm_input_cell(slot).with(fn(cell) {
            bytes := cell.borrow_mut()
            bytes.resize(length, 0)
            bytes.as_mut_ptr() as USize as U32
        })
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1986
    // GATE #4565: kernel primitive
    #Unsafe("free only the exact thread-local slot allocation identified by the caller")
    fn jet_text_wasm_input_free_slot(slot: U32, pointer: U32) -> () {
        jet_text_wasm_input_cell(slot).with(fn(cell) {
            bytes := cell.borrow_mut()
            assert(pointer as USize == bytes.as_ptr() as USize, "text Wasm input pointer does not own the slot")
            bytes.clear()
            bytes.shrink_to_fit()
        })
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:2000
    // GATE #4565: kernel primitive
    #Unsafe("copy a bounded input span only after pointer ownership and allocation length checks")
    fn jet_text_wasm_input_string(slot: U32, pointer: U32, length: U32) -> String {
        length :: jet_text_wasm_checked_len(length)
        bytes :: jet_text_wasm_input_cell(slot).with(fn(cell) {
            bytes :: cell.borrow()
            assert(pointer as USize == bytes.as_ptr() as USize, "text Wasm input pointer does not own the slot")
            assert(length <= bytes.len(), "text Wasm input length exceeds the allocated slot")
            bytes[0..<length].to_vec()
        })
        String.from_utf8(^bytes).expect("text Wasm input is not valid UTF-8")
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:2019
    // GATE #4565: kernel primitive
    #Unsafe("replace only the caller thread's retained output bytes")
    fn jet_text_wasm_output_set(value: String) -> () { JET_TEXT_WASM_OUTPUT.with(fn(cell) { *cell.borrow_mut() = value.into_bytes() }) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:2027
    #FFI(c)
    pub fn jet_text_wasm_input_alloc(slot: U32, length: U32) -> U32 { jet_text_wasm_input_alloc_slot(slot, length) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:2033
    #FFI(c)
    pub fn jet_text_wasm_input_free(slot: U32, pointer: U32) -> () { jet_text_wasm_input_free_slot(slot, pointer) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:2039
    // GATE #4565: kernel primitive
    #FFI(c)
    #Unsafe("lend retained output address until output mutation or clear")
    pub fn jet_text_wasm_output_ptr() -> U32 { JET_TEXT_WASM_OUTPUT.with(fn(cell) { cell.borrow().as_ptr() as USize as U32 }) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:2045
    // GATE #4565: kernel primitive
    #FFI(c)
    #Unsafe("read retained output length under immutable thread-local borrow")
    pub fn jet_text_wasm_output_len() -> U32 { JET_TEXT_WASM_OUTPUT.with(fn(cell) { U32.try_from(cell.borrow().len()).expect("text Wasm output exceeds the u32 ABI") }) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:2053
    // GATE #4565: kernel primitive
    #FFI(c)
    #Unsafe("release retained output allocation only after host relinquishes the address")
    pub fn jet_text_wasm_output_clear() -> () {
        JET_TEXT_WASM_OUTPUT.with(fn(cell) { output := cell.borrow_mut(); output.clear(); output.shrink_to_fit() })
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:2063
    #FFI(c)
    pub fn jet_text_wasm_pad_start(subject_pointer: U32, subject_length: U32, width: I64, fill_pointer: U32, fill_length: U32) -> () {
        subject :: jet_text_wasm_input_string(0, subject_pointer, subject_length)
        fill :: jet_text_wasm_input_string(2, fill_pointer, fill_length)
        jet_text_wasm_output_set(jet_text_pad_start(&subject, JetInt.from_i64(width), &fill))
    }
