// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1800
// jet_std_fs_list_dir is completed by the preceding slice under the whole-function splitting rule.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1827
fn jet_std_fs_create_dir(path: &String) -> () IOError! {
    if jet_fault_should_fail("FS.Write") { return Err(IOError.other(IOOperation.Write, Val(path.clone()), "fault injected: FS.Write")) }
    // GATE #4565: kernel primitive
    #Unsafe("create actual directory ancestors, preserving native OS failures") { fs.create_dir_all(OSPath.from(path)) }.map_err(fn(e) { io_error_at(IOOperation.Write, path, e) })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1837
