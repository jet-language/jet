use core.text.runtime.kernel_fmt.[jet_fmt_hex_decimal, jet_fmt_bin_decimal, jet_fmt_oct_decimal]
use core.prelude.runtime.std_common_types_03.jet_int_to_string

// Rust: crates/jet-codegen/src/Prelude/Core/FmtAot.rs:1
// Marshal packed exact Int to decimal text; shared kernel owns radix formatting.
// Rust: crates/jet-codegen/src/Prelude/Core/FmtAot.rs:5
pub fn jet_fmt_hex(value: I64, width: I64) -> String { jet_fmt_hex_decimal(&jet_int_to_string(value), width) }
// Rust: crates/jet-codegen/src/Prelude/Core/FmtAot.rs:9
pub fn jet_fmt_bin(value: I64) -> String { jet_fmt_bin_decimal(&jet_int_to_string(value)) }
// Rust: crates/jet-codegen/src/Prelude/Core/FmtAot.rs:13
pub fn jet_fmt_oct(value: I64) -> String { jet_fmt_oct_decimal(&jet_int_to_string(value)) }
