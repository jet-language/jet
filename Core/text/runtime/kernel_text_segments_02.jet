// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:583
fn jet_text_word_reduce<I: IntoIterator<Item=Char>>(chars: I) -> ([(U8, Char)], [USize]) {
    units := [(U8, Char)]{}
    ends := [USize]{}
    loop (idx, c) in chars.into_iter().enumerate() {
        cl :: jet_text_word_class(c as U32)
        if cl == JET_WB_EXTEND || cl == JET_WB_FORMAT || cl == JET_WB_ZWJ {
            if units.last() == .Val(last) {
                last_cl :: last.0
                if last_cl != JET_WB_CR && last_cl != JET_WB_LF && last_cl != JET_WB_NEWLINE {
                    ends[ends.len() - 1] = idx
                    next
                }
            }
        }
        &units.push((cl, c))
        &ends.push(idx)
    }
    (^units, ^ends)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:605
fn jet_text_word_break_at(units: View<(U8, Char)>, ends: View<USize>, char_at: fn(USize) -> Char, i: USize) -> Bool {
    pc :: units[i].0
    cc :: units[i + 1].0
    if pc == JET_WB_CR && cc == JET_WB_LF -> return false // WB3
    if pc == JET_WB_NEWLINE || pc == JET_WB_CR || pc == JET_WB_LF -> return true // WB3a
    if cc == JET_WB_NEWLINE || cc == JET_WB_CR || cc == JET_WB_LF -> return true // WB3b
    if jet_text_word_class(char_at(ends[i]) as U32) == JET_WB_ZWJ && jet_text_is_ext_pictographic(units[i + 1].1 as U32) -> return false // WB3c
    if pc == JET_WB_WSEGSPACE && cc == JET_WB_WSEGSPACE && jet_text_word_class(char_at(ends[i]) as U32) == JET_WB_WSEGSPACE -> return false // WB3d
    if (pc == JET_WB_ALETTER || pc == JET_WB_HEBREW) && (cc == JET_WB_ALETTER || cc == JET_WB_HEBREW) -> return false // WB5
    if (pc == JET_WB_ALETTER || pc == JET_WB_HEBREW) && (cc == JET_WB_MIDLETTER || cc == JET_WB_MIDNUMLET || cc == JET_WB_SINGLEQUOTE) {
        if i + 2 < units.len() {
            nc :: units[i + 2].0
            if nc == JET_WB_ALETTER || nc == JET_WB_HEBREW -> return false // WB6
        }
    }
    if (cc == JET_WB_ALETTER || cc == JET_WB_HEBREW) && (pc == JET_WB_MIDLETTER || pc == JET_WB_MIDNUMLET || pc == JET_WB_SINGLEQUOTE) {
        if i >= 1 {
            pp :: units[i - 1].0
            if pp == JET_WB_ALETTER || pp == JET_WB_HEBREW -> return false // WB7
        }
    }
    if pc == JET_WB_HEBREW && cc == JET_WB_SINGLEQUOTE -> return false // WB7a
    if pc == JET_WB_HEBREW && cc == JET_WB_DOUBLEQUOTE && i + 2 < units.len() && units[i + 2].0 == JET_WB_HEBREW -> return false // WB7b
    if pc == JET_WB_DOUBLEQUOTE && cc == JET_WB_HEBREW && i >= 1 && units[i - 1].0 == JET_WB_HEBREW -> return false // WB7c
    if pc == JET_WB_NUMERIC && cc == JET_WB_NUMERIC -> return false // WB8
    if (pc == JET_WB_ALETTER || pc == JET_WB_HEBREW) && cc == JET_WB_NUMERIC -> return false // WB9
    if pc == JET_WB_NUMERIC && (cc == JET_WB_ALETTER || cc == JET_WB_HEBREW) -> return false // WB10
    if cc == JET_WB_NUMERIC && (pc == JET_WB_MIDNUM || pc == JET_WB_MIDNUMLET || pc == JET_WB_SINGLEQUOTE) && i >= 1 && units[i - 1].0 == JET_WB_NUMERIC -> return false // WB11
    if pc == JET_WB_NUMERIC && (cc == JET_WB_MIDNUM || cc == JET_WB_MIDNUMLET || cc == JET_WB_SINGLEQUOTE) && i + 2 < units.len() && units[i + 2].0 == JET_WB_NUMERIC -> return false // WB12
    if pc == JET_WB_KATAKANA && cc == JET_WB_KATAKANA -> return false // WB13
    if (pc == JET_WB_ALETTER || pc == JET_WB_HEBREW || pc == JET_WB_NUMERIC || pc == JET_WB_KATAKANA || pc == JET_WB_EXTENDNUMLET) && cc == JET_WB_EXTENDNUMLET -> return false // WB13a
    if pc == JET_WB_EXTENDNUMLET && (cc == JET_WB_ALETTER || cc == JET_WB_HEBREW || cc == JET_WB_NUMERIC || cc == JET_WB_KATAKANA) -> return false // WB13b
    true // WB999
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:654
fn jet_text_word_segments(s: &String) -> [String] {
    cps: [Char] :: s.chars().collect()
    if cps.is_empty() -> return []
    (units, ends) :: jet_text_word_reduce(cps.iter().copied())
    n :: units.len()
    brk := [Bool].with_capacity(n.saturating_sub(1))
    &brk.resize(n.saturating_sub(1), true)
    ri_run := 0
    loop i in 0..<n {
        cl :: units[i].0
        ri_run = if cl == JET_WB_RI -> ri_run + 1 else -> 0
        if i + 1 < n {
            nc :: units[i + 1].0
            brk[i] = if cl == JET_WB_RI && nc == JET_WB_RI -> ri_run % 2 == 0
                else -> jet_text_word_break_at(units, ends, fn(index) -> cps[index], i)
        }
    }
    out := [String]{}
    cur := String.new()
    ui := 0
    loop (idx, c) in cps.iter().enumerate() {
        &cur.push(c)
        if idx == ends[ui] && ui + 1 < n {
            if brk[ui] { &out.push(^cur); cur = String.new() }
            ui += 1
        }
    }
    if !cur.is_empty() -> &out.push(^cur)
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:689
fn jet_text_words(s: &String) -> [String] {
    jet_text_word_segments(s).into_iter()
        .filter(fn(w) -> w.chars().any(fn(c) -> jet_text_alphabetic(c as U32) || jet_text_numeric(c as U32))).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:699
fn jet_text_word_view_spans(s: View<str>) -> [(USize, USize)] {
    indexed: [(USize, Char)] :: s.char_indices().collect()
    if indexed.is_empty() -> return []
    (units, ends) :: jet_text_word_reduce(indexed.iter().map(fn(row) -> row.1))
    n :: units.len()
    breaks := [Bool].with_capacity(n.saturating_sub(1))
    &breaks.resize(n.saturating_sub(1), true)
    ri_run: USize := 0
    loop i in 0..<n {
        class :: units[i].0
        ri_run = if class == JET_WB_RI -> ri_run.saturating_add(1) else -> 0
        if i + 1 < n {
            next_class :: units[i + 1].0
            breaks[i] = if class == JET_WB_RI && next_class == JET_WB_RI -> ri_run % 2 == 0
                else -> jet_text_word_break_at(units, ends, fn(index) -> indexed[index].1, i)
        }
    }
    out := [(USize, USize)]{}
    start_byte := 0
    unit_index := 0
    loop (char_index, row) in indexed.iter().enumerate() {
        (byte, current) :: row
        if char_index != ends[unit_index] || unit_index + 1 >= n || !breaks[unit_index] -> next
        end_byte :: byte + current.len_utf8()
        segment :: s[start_byte..<end_byte]
        if segment.chars().any(fn(c) -> jet_text_alphabetic(c as U32) || jet_text_numeric(c as U32)) -> &out.push((start_byte, end_byte))
        start_byte = end_byte
        unit_index += 1
    }
    if start_byte < s.len() {
        segment :: s[start_byte..]
        if segment.chars().any(fn(c) -> jet_text_alphabetic(c as U32) || jet_text_numeric(c as U32)) -> &out.push((start_byte, s.len()))
    }
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:755
fn jet_text_word_views(s: View<str>) -> JetViewIter<View<str>> {
    source :: s
    spans :: jet_text_word_view_spans(source)
    jet_view_iter_from_iter(spans.into_iter().map(fn(span) -> source[span.0..<span.1]))
}
