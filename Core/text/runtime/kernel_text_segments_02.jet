// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:796
fn jet_text_sentence_breaks(units: View<U8>) -> [Bool] {
    n :: units.len()
    brk := [Bool].with_capacity(n.saturating_sub(1))
    &brk.resize(n.saturating_sub(1), false) // SB999 defaults to no break.
    i := 0
    loop i + 1 < n {
        cc0 :: units[i]
        if cc0 == JET_SB_CR && units[i + 1] == JET_SB_LF { i += 1; next } // SB3
        if cc0 == JET_SB_SEP || cc0 == JET_SB_CR || cc0 == JET_SB_LF { brk[i] = true; i += 1; next } // SB4
        if cc0 == JET_SB_ATERM || cc0 == JET_SB_STERM {
            if cc0 == JET_SB_ATERM && units[i + 1] == JET_SB_NUMERIC { i += 1; next } // SB6
            if cc0 == JET_SB_ATERM && i > 0 && (units[i - 1] == JET_SB_UPPER || units[i - 1] == JET_SB_LOWER) && i + 1 < n && units[i + 1] == JET_SB_UPPER { i += 1; next } // SB7
            j := i + 1
            loop j < n && units[j] == JET_SB_CLOSE -> j += 1
            close_end :: j
            loop j < n && units[j] == JET_SB_SP -> j += 1
            sp_end :: j
            sb9 :: close_end < n && (units[close_end] == JET_SB_SEP || units[close_end] == JET_SB_CR || units[close_end] == JET_SB_LF)
            sb10 :: sp_end < n && (units[sp_end] == JET_SB_SP || units[sp_end] == JET_SB_SEP || units[sp_end] == JET_SB_CR || units[sp_end] == JET_SB_LF)
            sb8a :: sp_end < n && (units[sp_end] == JET_SB_SCONTINUE || units[sp_end] == JET_SB_STERM || units[sp_end] == JET_SB_ATERM)
            sb8 := false
            if cc0 == JET_SB_ATERM {
                k := sp_end
                loop k < n {
                    kc :: units[k]
                    if kc == JET_SB_LOWER { sb8 = true; break }
                    if kc == JET_SB_OLETTER || kc == JET_SB_UPPER || kc == JET_SB_SEP || kc == JET_SB_CR || kc == JET_SB_LF || kc == JET_SB_STERM || kc == JET_SB_ATERM -> break
                    k += 1
                }
            }
            if !(sb9 || sb10 || sb8a || sb8) && sp_end > 0 && sp_end - 1 < brk.len() -> brk[sp_end - 1] = true // SB11
            i = if sp_end > i -> sp_end else -> i + 1
            next
        }
        i += 1
    }
    ^brk
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:844
fn jet_text_sentence_segments(s: &String) -> [String] {
    cps: [Char] :: s.chars().collect()
    if cps.is_empty() -> return []
    units := [U8]{}
    ends := [USize]{}
    loop (idx, c) in cps.iter().enumerate() {
        cl :: jet_text_sentence_class(c as U32)
        if cl == JET_SB_EXTEND || cl == JET_SB_FORMAT {
            if units.last() == .Val(last_cl) {
                if last_cl != JET_SB_CR && last_cl != JET_SB_LF && last_cl != JET_SB_SEP {
                    ends[ends.len() - 1] = idx
                    next
                }
            }
        }
        &units.push(cl)
        &ends.push(idx)
    }
    brk :: jet_text_sentence_breaks(units)
    n :: units.len()
    out := [String]{}
    cur := String.new()
    ui := 0
    loop (idx, c) in cps.iter().enumerate() {
        &cur.push(c)
        if idx == ends[ui] && ui + 1 < n {
            if brk[ui] { &out.push(^cur); cur = String.new() }
            ui += 1
        }
    }
    if !cur.is_empty() -> &out.push(^cur)
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:880
fn jet_text_sentences(s: &String) -> [String] {
    jet_text_sentence_segments(s).into_iter().filter_map(fn(seg) -> {
