fn jet_text_unicode_name(cp: U32) -> View<str> {
    index :: text_asset.records(UNICODE_NAME_INDEX, 8, 11)
    names :: text_asset.pool(UNICODE_NAME_INDEX, 8, 11)
    span :: text_tables.name_span(index, names, Int.from_u32(cp)) ?? return "UNASSIGNED"
