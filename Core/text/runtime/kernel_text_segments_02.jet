fn jet_text_shorten(text: &String, width: I64, placeholder: &String) -> String {
    if width < 0 || text.len() <= width as USize -> return text.clone()
    keep :: (width as USize).saturating_sub(placeholder.len())
    end :: text.char_indices().take_while(fn(row) -> row.0 < keep)
        .map(fn(row) -> row.0 + row.1.len_utf8()).last().unwrap_or(0).min(keep)
    format("{}{}", text[..<end], placeholder)
}
