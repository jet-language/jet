// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:416
fn jet_text_grapheme_break_classes(pc: U8, cc: U8) -> Bool {
    if pc == JET_GB_CR && cc == JET_GB_LF -> return false // GB3
    if pc == JET_GB_CR || pc == JET_GB_LF || pc == JET_GB_CONTROL -> return true // GB4
    if cc == JET_GB_CR || cc == JET_GB_LF || cc == JET_GB_CONTROL -> return true // GB5
    if pc == JET_GB_L && (cc == JET_GB_L || cc == JET_GB_V || cc == JET_GB_LV || cc == JET_GB_LVT) -> return false // GB6
    if (pc == JET_GB_LV || pc == JET_GB_V) && (cc == JET_GB_V || cc == JET_GB_T) -> return false // GB7
    if (pc == JET_GB_LVT || pc == JET_GB_T) && cc == JET_GB_T -> return false // GB8
    if cc == JET_GB_EXTEND || cc == JET_GB_ZWJ -> return false // GB9
    if cc == JET_GB_SPACINGMARK -> return false // GB9a
    if pc == JET_GB_PREPEND -> return false // GB9b
    true // GB999
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:429
fn jet_text_graphemes(s: &String) -> [String] {
    cps: [Char] :: s.chars().collect()
    if cps.is_empty() -> return []
    out := [String]{}
    cur := String.new()
    &cur.push(cps[0])
    ri_run := if jet_text_grapheme_class(cps[0] as U32) == JET_GB_RI -> 1 else -> 0
    saw_pic := jet_text_is_ext_pictographic(cps[0] as U32)
    incb_pending := jet_text_incb_class(cps[0] as U32) == JET_INCB_CONSONANT
    incb_linker := false
    loop i in 1..<cps.len() {
        prev :: cps[i - 1]
        curc :: cps[i]
        pc :: jet_text_grapheme_class(prev as U32)
        cc :: jet_text_grapheme_class(curc as U32)
        brk :: if pc == JET_GB_ZWJ && saw_pic && jet_text_is_ext_pictographic(curc as U32) -> false
            else if pc == JET_GB_RI && cc == JET_GB_RI -> ri_run % 2 == 0
            else if incb_pending && incb_linker && jet_text_incb_class(curc as U32) == JET_INCB_CONSONANT -> false
            else -> jet_text_grapheme_break_classes(pc, cc)
        if brk {
            &out.push(^cur)
            cur = String.new()
        }
        &cur.push(curc)
        ri_run = if cc == JET_GB_RI -> ri_run + 1 else -> 0
        saw_pic = if cc == JET_GB_EXTEND || cc == JET_GB_ZWJ -> saw_pic else -> jet_text_is_ext_pictographic(curc as U32)
        match jet_text_incb_class(curc as U32) {
            JET_INCB_CONSONANT -> { incb_pending = true; incb_linker = false }
            JET_INCB_LINKER -> if incb_pending -> incb_linker = true
            JET_INCB_EXTEND -> {}
            _ -> { incb_pending = false; incb_linker = false }
        }
    }
    &out.push(^cur)
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:470
// CharIndices yields exact UTF-8 source windows, never grapheme-sized copies.
struct JetTextGraphemeViewIter {
    source: View<str>
    chars: std.str.CharIndices
    pending: (USize, Char)?
    ri_run: USize
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:477
impl JetTextGraphemeViewIter.Iterator {
    type Item = View<str>
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:480
    fn next(self: &JetTextGraphemeViewIter) -> View<str>? {
        (start, first) :: self.pending.take().or_else(fn() -> &self.chars.next())?
        previous := first
        end := start + first.len_utf8()
        ri_run := if jet_text_grapheme_class(first as U32) == JET_GB_RI -> self.ri_run.saturating_add(1) else -> 0
        saw_pic := jet_text_is_ext_pictographic(first as U32)
        incb_pending := jet_text_incb_class(first as U32) == JET_INCB_CONSONANT
        incb_linker := false
        loop {
            item :: &self.chars.next()
            if item == .None -> break
            (index, current) :: item.unwrap()
            previous_class :: jet_text_grapheme_class(previous as U32)
            current_class :: jet_text_grapheme_class(current as U32)
            breaks :: if previous_class == JET_GB_ZWJ && saw_pic && jet_text_is_ext_pictographic(current as U32) -> false
                else if previous_class == JET_GB_RI && current_class == JET_GB_RI -> ri_run % 2 == 0
                else if incb_pending && incb_linker && jet_text_incb_class(current as U32) == JET_INCB_CONSONANT -> false
                else -> jet_text_grapheme_break_classes(previous_class, current_class)
            if breaks {
                self.pending = Val((index, current))
                self.ri_run = ri_run
                return Val(self.source[start..<index])
            }
            previous = current
            end = index + current.len_utf8()
            ri_run = if current_class == JET_GB_RI -> ri_run.saturating_add(1) else -> 0
            saw_pic = if current_class == JET_GB_EXTEND || current_class == JET_GB_ZWJ -> saw_pic else -> jet_text_is_ext_pictographic(current as U32)
            match jet_text_incb_class(current as U32) {
                JET_INCB_CONSONANT -> { incb_pending = true; incb_linker = false }
                JET_INCB_LINKER -> if incb_pending -> incb_linker = true
                JET_INCB_EXTEND -> {}
                _ -> { incb_pending = false; incb_linker = false }
            }
        }
        self.ri_run = ri_run
        Val(self.source[start..<end])
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:552
fn jet_text_grapheme_views(s: View<str>) -> JetViewIter<View<str>> {
    source :: s
    jet_view_iter_from_iter(JetTextGraphemeViewIter{
        source: source, chars: source.char_indices(), pending: None, ri_run: 0
    })
}

