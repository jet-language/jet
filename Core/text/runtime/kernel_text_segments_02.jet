fn jet_text_parse_splitlines(text: &String, keepends: Bool) -> [String] {
    out := [String]{}
    start := 0
    bytes :: text.as_bytes()
    index := 0
    loop index < bytes.len() {
        width := 0
        if bytes[index] == U8{10} -> width = 1
        else if bytes[index] == U8{13} -> width = if bytes.get(index + 1) == .Val(U8{10}) -> 2 else -> 1
        else { index += 1; next }
        end :: index + width
        stop :: if keepends -> end else -> index
        &out.push(text.get(start..<stop).unwrap_or_default().to_string())
        start = end
        index = end
    }
    if start < bytes.len() || (start == 0 && !text.is_empty()) -> &out.push(text.get(start..).unwrap_or_default().to_string())
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1316
fn jet_text_wrap(text: &String, width: I64) -> [String] {
    if width <= 0 -> return [text.clone()]
    out := [String]{}
    line := String.new()
    loop word in text.split_whitespace() {
        if line.is_empty() {
            &line.push_str(word)
        } else {
            trial :: format("{} {}", line, word)
            if trial.len() <= width as USize -> line = trial
            else {
                &out.push(^line)
                line = String.new()
                &line.push_str(word)
            }
        }
    }
    if !line.is_empty() -> &out.push(^line)
    ^out
}
