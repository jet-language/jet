fn jet_text_fill_columns(fill: &String, columns: I64) -> String {
    unit :: jet_text_grapheme_views(fill.as_str()).into_iter().next() ?? return " ".repeat(columns.max(0) as USize)
    width :: jet_text_cluster_width(unit, false, false).unwrap_or(0)
    if width <= 0 || width > columns -> return " ".repeat(columns.max(0) as USize)
