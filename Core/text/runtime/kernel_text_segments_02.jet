// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1366
fn jet_text_hanging_indent(text: &String, first: &String, rest: &String, width: I64) -> String {
    words: [View<str>] :: text.split_whitespace().collect()
    if words.is_empty() -> return String.new()
    lines := [String]{}
    current := String.new()
    prefix := first.as_str()
    loop word in words {
        limit :: (width - prefix.len() as I64).max(1) as USize
        trial :: if current.is_empty() -> word.to_string() else -> format("{} {}", current, word)
        if !current.is_empty() && trial.len() > limit {
            &lines.push(format("{}{}", prefix, current))
            prefix = rest.as_str()
            current = word.to_string()
        } else -> current = trial
    }
    if !current.is_empty() -> &lines.push(format("{}{}", prefix, current))
    lines.join("\n")
}
