// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1586
fn jet_text_parse_escape_c(text: &String) -> String {
    out := String.with_capacity(text.len())
    loop character in text.chars() {
        match character {
            '\n' -> &out.push_str("\\n")
            '\t' -> &out.push_str("\\t")
            '\r' -> &out.push_str("\\r")
            '\\' -> &out.push_str("\\\\")
            '"' -> &out.push_str("\\\"")
            other -> &out.push(other)
        }
    }
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1600
fn jet_text_parse_unescape_c(text: &String) -> String {
    out := String.with_capacity(text.len())
    chars := text.chars()
    loop {
        character :: &chars.next() ?? break
        if character != '\\' { &out.push(character); next }
        match &chars.next() {
            .Val('n') -> &out.push('\n')
            .Val('t') -> &out.push('\t')
            .Val('r') -> &out.push('\r')
            .Val('\\') -> &out.push('\\')
            .Val('"') -> &out.push('"')
            .Val(other) -> &out.push(other)
            .None -> &out.push('\\')
        }
    }
    ^out
}
