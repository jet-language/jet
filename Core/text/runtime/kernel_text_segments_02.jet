// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1419
fn jet_text_dedent(text: &String) -> String {
    lines: [View<str>] :: text.split('\n').collect()
    margin :: lines.iter().filter(fn(line) -> !line.trim_matches([' ', '\t']).is_empty())
        .map(fn(line) -> line.len() - line.trim_start_matches([' ', '\t']).len()).min().unwrap_or(0)
    if margin == 0 -> return text.clone()
    parts: [String] :: lines.iter().map(fn(line) -> {
        if line.trim_matches([' ', '\t']).is_empty() -> line.to_string()
        else -> line.get(margin..).unwrap_or("").to_string()
    }).collect()
    parts.join("\n")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1442
fn jet_text_expand_tabs(text: &String, tabsize: I64) -> String {
    size :: if tabsize <= 0 -> USize{8} else -> tabsize as USize
    out := String.with_capacity(text.len())
    column: USize := 0
    loop character in text.chars() {
        match character {
            '\t' -> {
                spaces :: size - (column % size)
                &out.extend(std.iter.repeat_n(' ', spaces))
                column += spaces
            }
            '\n' -> { &out.push('\n'); column = 0 }
            _ -> { &out.push(character); column += 1 }
        }
    }
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1465
fn jet_text_html_entity(name: View<str>) -> String? {
    named: Char? :: match name {
        "amp" -> Val('&')
        "lt" -> Val('<')
        "gt" -> Val('>')
        "quot" -> Val('"')
        "apos" -> Val('\'')
        "nbsp" -> Val(' ')
        "copy" -> Val('©')
        "reg" -> Val('®')
        "trade" -> Val('™')
        "mdash" -> Val('—')
        "ndash" -> Val('–')
        "hellip" -> Val('…')
        _ -> None
    }
    if named == .Val(character) -> return Val(character.to_string())
    number :: if name.strip_prefix("#x").or_else(fn() -> name.strip_prefix("#X")) == .Val(hex) {
        U32.from_str_radix(hex, 16).ok()
    } else {
        name.strip_prefix('#').and_then(fn(decimal) -> decimal.parse<U32>().ok())
    }
    number.and_then(Char.from_u32).map(fn(character) -> character.to_string())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1491
fn jet_text_html_escape(text: &String, quote: Bool) -> String {
    out := String.with_capacity(text.len())
    loop character in text.chars() {
        match character {
            '&' -> &out.push_str("&amp;")
            '<' -> &out.push_str("&lt;")
            '>' -> &out.push_str("&gt;")
            '"' if quote -> &out.push_str("&quot;")
            '\'' if quote -> &out.push_str("&#x27;")
            _ -> &out.push(character)
        }
    }
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1505
fn jet_text_html_unescape(text: &String) -> String {
    out := String.with_capacity(text.len())
    rest := text.as_str()
    loop {
        start :: rest.find('&') ?? break
        &out.push_str(rest[..<start])
        after :: rest[start + 1..]
        end_option :: after.find(';').filter(fn(end) -> end <= 31)
        if end_option == .None {
            &out.push('&')
            rest = after
            next
        }
        end :: end_option.unwrap()
        name :: after[..<end]
        if jet_text_html_entity(name) == .Val(decoded) {
            &out.push_str(decoded)
            rest = after[end + 1..]
        } else {
            &out.push('&')
            rest = after
        }
    }
    &out.push_str(rest)
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1528
fn jet_text_html_strip_tags(text: &String) -> String {
    out := String.with_capacity(text.len())
    in_tag := false
    loop character in text.chars() {
        match character {
            '<' -> in_tag = true
            '>' if in_tag -> in_tag = false
            _ if !in_tag -> &out.push(character)
            _ -> {}
        }
    }
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1541
fn jet_text_html_escape_quoted(text: &String) -> String { jet_text_html_escape(text, true) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1544
fn jet_text_html_escape_text(text: &String) -> String { jet_text_html_escape(text, false) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1547
fn jet_text_html_unescape_and_strip(text: &String) -> String { jet_text_html_unescape(jet_text_html_strip_tags(text)) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1550
fn jet_text_parse_capwords(text: &String) -> String {
    words: [String] :: text.split_whitespace().map(fn(word) -> jet_text_capitalize(word.to_string())).collect()
    words.join(" ")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1556
fn jet_text_parse_find_from(text: &String, needle: &String, start: I64) -> I64 {
    offset :: start.max(0) as USize
    rest :: text.get(offset..) ?? return -1
    rest.find(needle.as_str()).map_or(-1, fn(index) -> (offset + index) as I64)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1564
fn jet_text_parse_rfind_from(text: &String, needle: &String, end: I64) -> I64 {
    stop :: end.clamp(0, text.len() as I64) as USize
    prefix :: text.get(..<stop) ?? return -1
    prefix.rfind(needle.as_str()).map_or(-1, fn(index) -> index as I64)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1571
fn jet_text_parse_index(text: &String, needle: &String) -> I64 { jet_text_parse_find(text, needle) }
