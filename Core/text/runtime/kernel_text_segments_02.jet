// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1649
fn jet_text_istitle(s: &String) -> Bool {
    has_cased := false
    expect_upper := true
    loop character in s.chars() {
        if character.is_uppercase() {
            has_cased = true
            expect_upper = false
        } else if character.is_lowercase() {
            has_cased = true
            if expect_upper -> return false
        } else if character.is_alphabetic() -> return false
        else -> expect_upper = true
    }
    has_cased
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1669
fn jet_text_isprintable(s: &String) -> Bool { s.chars().all(fn(character) -> !character.is_control()) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1672
fn jet_text_expandtabs(s: &String, tabsize: JetInt) -> String {
    width :: tabsize.to_i64().unwrap_or_else(fn() -> panic("text tab size does not fit native i64")).max(0)
    column: I64 := 0
    out := String.with_capacity(s.len())
    loop character in s.chars() {
        match character {
            '\t' if width > 0 -> {
                spaces :: width - column.rem_euclid(width)
                &out.extend(std.iter.repeat_n(' ', spaces as USize))
                column += spaces
            }
            '\t' -> {}
            '\n' | '\r' -> { &out.push(character); column = 0 }
            _ -> { &out.push(character); column += 1 }
        }
    }
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1702
fn jet_text_zfill(s: &String, width: I64) -> String {
    length :: s.chars().count() as I64
    if width <= length -> return s.clone()
    (sign, body) :: if s.strip_prefix('+') == .Val(rest) -> ("+", rest)
        else if s.strip_prefix('-') == .Val(rest) -> ("-", rest)
        else -> ("", s.as_str())
    format("{}{}{}", sign, "0".repeat((width - length) as USize), body)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1716
fn jet_text_zfill_int(s: &String, width: JetInt) -> String {
    jet_text_zfill(s, width.to_i64().unwrap_or_else(fn() -> panic("text zfill width does not fit native i64")))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1727
fn jet_text_zfill_ref(s: &String, width: &JetInt) -> String {
    jet_text_zfill(s, width.to_i64().unwrap_or_else(fn() -> panic("text zfill width does not fit native i64")))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1735
fn jet_text_char_indices(s: &String) -> [String] {
    s.char_indices().map(fn(row) -> format("{}:{}", row.0, row.1)).collect()
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1739
fn jet_std_fs_read(path: &OSPath) -> String IOError! {
    if jet_fault_should_fail("FS.Read") -> return Err(IOError.other(IOOperation.Read, Val(path.to_string()), "fault injected: FS.Read"))
    // GATE #4565: kernel primitive
    #Unsafe("native filesystem reads only the retained path and returns owned UTF-8 or an OS error") {
        fs.read_to_string(path).map_err(fn(e) -> io_error_at(IOOperation.Read, path.to_string(), e))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1749
fn jet_std_fs_write(path: &OSPath, text: &String) -> Unit IOError! {
    if jet_fault_should_fail("FS.Write") -> return Err(IOError.other(IOOperation.Write, Val(path.to_string()), "fault injected: FS.Write"))
    // GATE #4565: kernel primitive
    #Unsafe("native filesystem write borrows the retained path and text through completion") {
        fs.write(path, text).map_err(fn(e) -> io_error_at(IOOperation.Write, path.to_string(), e))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1759
fn jet_std_fs_append(path: &OSPath, text: &String) -> Unit IOError! {
    if jet_fault_should_fail("FS.Write") -> return Err(IOError.other(IOOperation.Write, Val(path.to_string()), "fault injected: FS.Write"))
    // GATE #4565: kernel primitive
    #Unsafe("native append handle owns its descriptor and borrows text only during write_all") {
        f := fs.OpenOptions.new().create(true).append(true).open(path)
            .map_err(fn(e) -> io_error_at(IOOperation.Write, path.to_string(), e))?
        f.write_all(text.as_bytes()).map_err(fn(e) -> io_error_at(IOOperation.Write, path.to_string(), e))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1776
fn jet_std_fs_exists(path: &OSPath) -> Bool {
    // GATE #4565: kernel primitive
    #Unsafe("native existence query borrows a retained OSPath without following owner memory") { path.exists() }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1779
fn jet_fs_remove_entry(path: &OSPath) -> Unit io.Error! {
    // GATE #4565: kernel primitive
    #Unsafe("symlink metadata decides directory removal without following a link to its target") {
        metadata :: fs.symlink_metadata(path)?
        if metadata.file_type().is_dir() -> fs.remove_dir(path) else -> fs.remove_file(path)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1788
fn jet_std_fs_remove(path: &OSPath) -> Unit IOError! {
    if jet_fault_should_fail("FS.Write") -> return Err(IOError.other(IOOperation.Write, Val(path.to_string()), "fault injected: FS.Write"))
    jet_fs_remove_entry(path).map_err(fn(error) -> io_error_at(IOOperation.Write, path.to_string(), error))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:1800
fn jet_std_fs_list_dir(path: &OSPath) -> [DirEntry] IOError! {
    if jet_fault_should_fail("FS.Read") -> return Err(IOError.other(IOOperation.Read, Val(path.to_string()), "fault injected: FS.Read"))
    out := [DirEntry]{}
    // GATE #4565: kernel primitive
    #Unsafe("native directory iterator owns its handle; names and joined paths are materialized before release") {
        rd :: fs.read_dir(path).map_err(fn(e) -> io_error_at(IOOperation.Read, path.to_string(), e))?
        loop entry_result in rd {
            entry :: entry_result.map_err(fn(e) -> io_error_at(IOOperation.Read, path.to_string(), e))?
            name :: entry.file_name().to_string_lossy().to_string()
            full_path :: path.join(name).to_string_lossy().to_string()
            is_dir :: entry.file_type().map(fn(ft) -> ft.is_dir()).unwrap_or(false)
            &out.push(DirEntry{name: name, path: full_path, is_dir: is_dir})
        }
    }
    &out.sort_by(fn(a, b) -> a.name.cmp(b.name))
    Ok(^out)
}

