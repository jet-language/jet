impl<T> JetViewIter<T> {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:9
    fn to_list(^self) -> [T] { self.source.collect() }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:12
