// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:310
fn jet_text_append_title_mapping(out: &String, cp: U32) {
    if jet_text_title_mapping(cp) == .Val(mapped) {
        loop i in 0..<(mapped.len() /% 3) {
            if Char.from_u32(text_asset.scalar(mapped, i) as U32) == .Val(ch) -> &out.push(ch)
        }
    } else if Char.from_u32(cp) == .Val(ch) {
        &out.push(ch)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:317
fn jet_text_title(s: &String) -> String {
    out := String.with_capacity(s.len())
    word_start := true
    loop ch in s.chars() {
        cp :: ch as U32
        if jet_text_alphabetic(cp) || jet_text_numeric(cp) {
            if word_start {
                jet_text_append_title_mapping(&out, cp)
            } else {
                one :: ch.to_string()
                &out.push_str(jet_text_lower(&one))
            }
            word_start = false
        } else {
            &out.push(ch)
            word_start = true
        }
    }
    ^out
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:338
fn jet_text_caseless_eq(a: &String, b: &String) -> Bool {
    jet_text_nfd(jet_text_casefold(jet_text_nfd(a))) == jet_text_nfd(jet_text_casefold(jet_text_nfd(b)))
}

