HANGUL_SBASE: U32 :: 0xAC00
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:81
HANGUL_LBASE: U32 :: 0x1100
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:82
HANGUL_VBASE: U32 :: 0x1161
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:83
HANGUL_TBASE: U32 :: 0x11A7
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:84
HANGUL_LCOUNT: U32 :: 19
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:85
HANGUL_VCOUNT: U32 :: 21
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:86
HANGUL_TCOUNT: U32 :: 28
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:87
HANGUL_NCOUNT: U32 :: HANGUL_VCOUNT * HANGUL_TCOUNT
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:88
HANGUL_SCOUNT: U32 :: HANGUL_LCOUNT * HANGUL_NCOUNT

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:90
fn jet_text_ccc(cp: U32) -> U8 { text_asset.asset_tag(UNICODE_CCC, Int.from_u32(cp), 0) as U8 }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:101
fn jet_text_hangul_decompose(cp: U32) -> [U32; 3]? {
    if cp < HANGUL_SBASE || cp >= HANGUL_SBASE + HANGUL_SCOUNT -> return None
    s_index :: cp - HANGUL_SBASE
    l :: HANGUL_LBASE + s_index / HANGUL_NCOUNT
    v :: HANGUL_VBASE + (s_index % HANGUL_NCOUNT) / HANGUL_TCOUNT
    t_index :: s_index % HANGUL_TCOUNT
    if t_index == 0 -> Val([l, v, 0]) else -> Val([l, v, HANGUL_TBASE + t_index])
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:116
fn jet_text_decomp_lookup(cp: U32, compat: Bool) -> View<U8>? {
    index :: text_asset.records(UNICODE_DECOMP_INDEX, 5, 7)
    row :: text_asset.mapping_row(index, Int.from_u32(cp), 7)?
    start :: text_asset.uint(index, row + 3, 2)
    len :: text_asset.uint(index, row + 5, 1)
    is_canon :: text_asset.uint(index, row + 6, 1)
    if !compat && is_canon == 0 -> return None
    pool :: text_asset.records(UNICODE_DECOMP_POOL, 1, 3)
    Val(pool[start * 3..<(start + len) * 3])
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:131
// Decomposition mappings are one step; recursively expand until stable.
fn jet_text_expand_char(cp: U32, compat: Bool, seq: &[U32]) {
    if jet_text_hangul_decompose(cp) == .Val(parts) {
        &seq.push(parts[0])
        &seq.push(parts[1])
        if parts[2] != 0 -> &seq.push(parts[2])
        return
    }
    if jet_text_decomp_lookup(cp, compat) == .Val(expansion) {
        loop i in 0..<(expansion.len() /% 3) -> jet_text_expand_char(text_asset.scalar(expansion, i) as U32, compat, &seq)
        return
    }
    &seq.push(cp)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:149
fn jet_text_canonical_order(seq: &[U32]) {
    // Stable linear counting sort of every non-starter run by u8 CCC.
    start := 0
    loop start < seq.len() {
        if jet_text_ccc(seq[start]) == 0 -> start += 1
        end := start
        ordered := true
        previous: U8 := 0
        loop end < seq.len() {
            class :: jet_text_ccc(seq[end])
            if class == 0 -> break
            ordered = ordered && class >= previous
            previous = class
            end += 1
        }
        if !ordered {
            counts := [USize; 256].filled(0)
            loop cp in seq[start..<end] -> counts[jet_text_ccc(cp) as USize] += 1
            offsets := [USize; 256].filled(0)
            next_at := start
            loop class in 1..<256 {
                offsets[class] = next_at
                next_at += counts[class]
            }
            sorted := [U32].with_capacity(end - start)
            &sorted.resize(end - start, 0)
            loop cp in seq[start..<end] {
                class :: jet_text_ccc(cp) as USize
                at :: offsets[class] - start
                sorted[at] = cp
                offsets[class] += 1
            }
            &seq[start..<end].copy_from_slice(sorted)
        }
        start = end
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:186
fn jet_text_nfd_inner(s: &String, compat: Bool) -> String {
    seq := [U32].with_capacity(s.len())
    loop c in s.chars() -> jet_text_expand_char(c as U32, compat, &seq)
    jet_text_canonical_order(&seq)
    seq.into_iter().filter_map(Char.from_u32).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:196
fn jet_text_nfd(s: &String) -> String { jet_text_nfd_inner(s, false) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:197
fn jet_text_nfkd(s: &String) -> String { jet_text_nfd_inner(s, true) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:199
fn jet_text_compose_pair_cp(a: U32, b: U32) -> U32? {
    table :: text_asset.records(UNICODE_COMPOSE_PAIRS, 6, 9)
    low := 0
    high := table.len() /% 9
    needle :: (Int.from_u32(a), Int.from_u32(b))
    loop low < high {
        mid :: (low + high) /% 2
        row :: mid * 9
        key :: (text_asset.uint(table, row, 3), text_asset.uint(table, row + 3, 3))
        if key < needle -> low = mid + 1
        else if key > needle -> high = mid
        else -> return Val(text_asset.uint(table, row + 6, 3) as U32)
    }
    None
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:206
fn jet_text_hangul_compose_pair(a: U32, b: U32) -> U32? {
    // L + V -> LV
    if a >= HANGUL_LBASE && a < HANGUL_LBASE + HANGUL_LCOUNT
        && b >= HANGUL_VBASE && b < HANGUL_VBASE + HANGUL_VCOUNT {
        l_index :: a - HANGUL_LBASE
        v_index :: b - HANGUL_VBASE
        return Val(HANGUL_SBASE + (l_index * HANGUL_VCOUNT + v_index) * HANGUL_TCOUNT)
    }
    // LV + T -> LVT
    if a >= HANGUL_SBASE && a < HANGUL_SBASE + HANGUL_SCOUNT
        && (a - HANGUL_SBASE) % HANGUL_TCOUNT == 0
        && b > HANGUL_TBASE && b < HANGUL_TBASE + HANGUL_TCOUNT {
        return Val(a + (b - HANGUL_TBASE))
    }
    None
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:225
fn jet_text_compose(s: String) -> String {
    // UAX #15 blocking: -1 means no intervening character, including CCC=0.
    seq: [U32] :: s.chars().map(fn(c) -> c as U32).collect()
    out := [U32].with_capacity(seq.len())
    starter_idx: USize? := None
    last_class: I32 := -1
    loop cp in seq {
        cls :: jet_text_ccc(cp) as I32
        if starter_idx == .Val(si) {
            starter :: out[si]
            composed :: jet_text_hangul_compose_pair(starter, cp)
                .or_else(fn() -> jet_text_compose_pair_cp(starter, cp))
            if composed == .Val(composed_cp) && last_class < cls {
                out[si] = composed_cp
                next
            }
        }
        if cls == 0 {
            &out.push(cp)
            starter_idx = Val(out.len() - 1)
            last_class = -1
        } else {
            &out.push(cp)
            last_class = cls
        }
    }
    out.into_iter().filter_map(Char.from_u32).collect()
}
