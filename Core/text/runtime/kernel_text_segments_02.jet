fn jet_text_indent_with(text: &String, prefix: &String, predicate_nonblank: Bool) -> String {
    parts: [String] :: text.split('\n').map(fn(line) -> {
        if !predicate_nonblank || !line.trim_matches([' ', '\t']).is_empty() -> format("{}{}", prefix, line)
