fn jet_text_isidentifier(s: &String) -> Bool {
    chars := s.chars()
    first :: &chars.next() ?? return false
    (first == '_' || first.is_alphabetic()) && chars.all(fn(character) -> character == '_' || character.is_alphanumeric())
}
