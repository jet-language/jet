// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:888
fn jet_text_cluster_is_wide(cluster: View<str>) -> Bool {
    codepoints: [Char] :: cluster.chars().collect()
    keycap := false
    if codepoints.len() == 2 || codepoints.len() == 3 {
        first :: codepoints[0]
        starter :: (first >= '0' && first <= '9') || first == '#' || first == '*'
        keycap = starter && codepoints[codepoints.len() - 1] == '\u{20E3}'
            && (codepoints.len() == 2 || codepoints[1] == '\u{FE0F}')
    }
    chars := cluster.chars()
    ri_pair := false
    if &chars.next() == .Val(a) {
        if jet_text_grapheme_class(a as U32) == JET_GB_RI {
            if &chars.next() == .Val(b) -> ri_pair = jet_text_grapheme_class(b as U32) == JET_GB_RI
        }
    }
    emoji_style :: cluster.contains('\u{FE0F}') && cluster.chars().any(fn(c) -> jet_text_is_emoji(c as U32))
    keycap || ri_pair || emoji_style || cluster.chars().any(fn(c) -> jet_text_eaw_class(c as U32) == 2 || jet_text_is_emoji_presentation(c as U32))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:902
fn jet_text_cluster_width(cluster: View<str>, ambiguous_wide: Bool, controls_reject: Bool) -> I64 Err! {
    base :: cluster.chars().next() ?? return Ok(0)
    if jet_text_is_control(base as U32) {
        if controls_reject -> return Err(format("control character U+{:04X} rejected by TextWidth policy", base as U32))
        return Ok(0)
    }
    if jet_text_cluster_is_wide(cluster) -> return Ok(2)
    if cluster.chars().all(fn(c) -> jet_text_is_zero_width_scalar(c as U32)) -> return Ok(0)
    if jet_text_eaw_class(base as U32) == 1 -> return Ok(if ambiguous_wide -> 2 else -> 1)
    Ok(1)
}
