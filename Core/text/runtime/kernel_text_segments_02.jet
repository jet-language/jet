fn jet_text_fold_lookup(cp: U32) -> View<U8>? {
    index :: text_asset.records(UNICODE_FOLD_INDEX, 4, 11)
    pool :: text_asset.records(UNICODE_FOLD_POOL, 1, 3)
    span :: text_asset.mapping(index, pool, Int.from_u32(cp))?
    Val(pool[span.start * 3..<(span.start + span.length) * 3])
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Text.rs:268
fn jet_text_casefold(s: &String) -> String {
    out := String.with_capacity(s.len())
    loop c in s.chars() {
        match jet_text_fold_lookup(c as U32) {
            .Val(seq) -> loop i in 0..<(seq.len() /% 3) {
                cp :: text_asset.scalar(seq, i) as U32
                if Char.from_u32(cp) == .Val(fc) -> &out.push(fc)
            }
            .None -> &out.push(c)
        }
    }
    ^out
}
