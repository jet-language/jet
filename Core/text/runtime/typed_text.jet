use jet_foundation.Text.TEXT_NUL

// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:1
// One typed-text semantic kernel; SQL binding element type stays at the adapter.
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:6
pub fn jet_typed_sql_raw<T>(template: String) -> (String, [T]) { (^template, []) }
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:10
pub fn jet_typed_sql_interpolate<T>(literals: &[String], holes: [T]) -> (String, [T]) {
    capacity :: literals.iter().map(fn(literal) { literal.len() }).sum<USize>() + holes.len()
    template := String.with_capacity(capacity)
    loop (index, literal) in literals.iter().enumerate() {
        template.push_str(literal)
        if index < holes.len() { template.push('?') }
    }
    (^template, ^holes)
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:26
pub fn jet_typed_sql_template<T>(value: &(String, [T])) -> String { value.0.clone() }
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:30
pub fn jet_typed_sql_params<T: Clone>(value: &(String, [T])) -> [T] { value.1.clone() }
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:34
pub fn jet_typed_html_raw(value: String) -> String { ^value }
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:38
pub fn jet_typed_html_text(value: String) -> String { ^value }
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:42
pub fn jet_typed_html_escape(value: String) -> String {
    out := String.with_capacity(value.len())
    loop ch in value.chars() {
        match ch {
            '&' -> out.push_str("&amp;")
            '<' -> out.push_str("&lt;")
            '>' -> out.push_str("&gt;")
            '"' -> out.push_str("&quot;")
            '\'' -> out.push_str("&#39;")
            _ -> out.push(ch)
        }
    }
    out
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:57
pub fn jet_typed_html_interpolate(literals: &[String], holes: [String], trusted_html: &[Bool]) -> String {
    capacity :: literals.iter().map(fn(literal) { literal.len() }).sum<USize>() + holes.iter().map(fn(hole) { hole.len() }).sum<USize>()
    out := String.with_capacity(capacity)
    holes := holes.into_iter()
    loop (index, literal) in literals.iter().enumerate() {
        out.push_str(literal)
        if holes.next() is Val(hole) {
            if trusted_html.get(index).copied().unwrap_or(false) { out.push_str(&hole) }
            else { out.push_str(&jet_typed_html_escape(&hole)) }
        }
    }
    out
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:79
pub fn jet_typed_sh_raw(value: String) -> [String] {
    value.split_whitespace().map(fn(word) { word.to_string() }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:83
pub fn jet_typed_sh_interpolate(literals: &[String], holes: [String]) -> [String] {
    argv := [String].with_capacity(holes.len())
    holes := holes.into_iter()
    loop literal in literals {
        argv.extend(literal.split_whitespace().map(fn(word) { word.to_string() }))
        if holes.next() is Val(hole) { argv.push(^hole) }
    }
    argv
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:95
// Checked boundary heads share encoding/traversal semantics across adapters.
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:99
pub fn jet_typed_path_interpolate(literals: &[String], holes: &[String]) -> String {
    interpolate_typed_head(literals, holes, encode_path_component)
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:103
pub fn jet_typed_datetime_interpolate(literals: &[String], holes: &[String]) -> String {
    interpolate_typed_head(literals, holes, fn(hole) { hole.to_string() })
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:107
pub fn jet_validate_typed_path_literal(literals: &[String]) -> Unit Err! {
    if literals.iter().any(fn(literal) { literal.contains(TEXT_NUL) }) { Err("a Path cannot contain a NUL character") }
    else { Ok(()) }
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:115
fn interpolate_typed_head<F: Fn(String) -> String>(literals: &[String], holes: &[String], encode_hole: F) -> String {
    capacity :: literals.iter().map(fn(literal) { literal.len() }).sum<USize>() + holes.iter().map(fn(hole) { hole.len() }).sum<USize>()
    out := String.with_capacity(capacity)
    loop (index, literal) in literals.iter().enumerate() {
        out.push_str(literal)
        if holes.get(index) is Val(hole) { out.push_str(&encode_hole(hole)) }
    }
    out
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:132
fn encode_path_component(value: String) -> String {
    // Encode separators/control bytes and both traversal components: holes are one component.
    if value == "." || value == ".." {
        return value.as_bytes().iter().map(fn(byte) { format("%{:02X}", byte) }).collect()
    }
    percent_encode_path(value)
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:146
fn percent_encode_path(value: String) -> String {
    out := String.with_capacity(value.len())
    loop byte in value.as_bytes() {
        byte :: *byte
        if byte.is_ascii_alphanumeric() || byte == '-' as U8 || byte == '.' as U8 || byte == '_' as U8 || byte == '~' as U8 {
            out.push(byte as Char)
        } else {
            out.push('%')
            out.push(typed_text_hex_digit(byte >> 4))
            out.push(typed_text_hex_digit(byte & 0x0f))
        }
    }
    out
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:160
fn typed_text_hex_digit(nibble: U8) -> Char {
    match nibble {
        0..=9 -> ('0' as U8 + nibble) as Char
        10..=15 -> ('A' as U8 + nibble - 10) as Char
        _ -> panic("percent hex nibble is always four bits")
    }
}
