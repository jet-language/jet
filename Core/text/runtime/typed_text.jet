// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:1
// D-TYPEDTEXT1=D: one typed-text semantic kernel for every tier. SQL keeps its
// binding element type at the adapter, so the checked SQL carrier can use
// DBValue while this kernel stays independent of the database wire module.
use core.text.runtime.kernel_unicode_string as unicode_string

// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:6
pub fn jet_typed_sql_raw<T>(template: String) -> (template: String, params: [T]) Never! {
    (template: template, params: [T]{})
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:10. Each literal that has
// a following hole contributes one `?` placeholder.
pub fn jet_typed_sql_interpolate<T>(literals: [String], holes: ^[T]) -> (template: String, params: [T]) Never! {
    parts :: loop index in 0..<literals.len() -> if holes.len() > index -> "{literals[index]}?" else -> literals[index]
    (template: parts.join(""), params: ^holes)
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:26
pub fn jet_typed_sql_template<T>(value: (template: String, params: [T])) -> String Never! { ~value.template }
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:30
pub fn jet_typed_sql_params<T>(value: (template: String, params: [T])) -> [T] Never! { ~value.params }
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:34
pub fn jet_typed_html_raw(value: ^String) -> String Never! { value }
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:38
pub fn jet_typed_html_text(value: ^String) -> String Never! { value }
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:42. Every escaped character
// is ASCII, so a byte walk leaves multi-byte UTF-8 sequences untouched.
pub fn jet_typed_html_escape(value: String) -> String Never! {
    out := [U8]{}
    loop byte in value.bytes() {
        if byte == {
            38 -> push_text(&out, "&amp;")
            60 -> push_text(&out, "&lt;")
            62 -> push_text(&out, "&gt;")
            34 -> push_text(&out, "&quot;")
            39 -> push_text(&out, "&#39;")
            else -> &out.push(byte)
        }
    }
    String.from_bytes(out) ?? panic("HTML escaping keeps UTF-8 intact")
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:57. Hole i follows literal
// i; a missing trust flag escapes.
pub fn jet_typed_html_interpolate(literals: [String], holes: [String], trusted_html: [Bool]) -> String Never! {
    parts :: loop index in 0..<literals.len() -> if {
        index >= holes.len() -> literals[index]
        trusted_html.len() > index && trusted_html[index] -> "{literals[index]}{holes[index]}"
        else -> "{literals[index]}{jet_typed_html_escape(holes[index])}"
    }
    parts.join("")
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:79
pub fn jet_typed_sh_raw(value: String) -> [String] Never! { unicode_string.split_whitespace(value) }
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:83. Literal words split on
// White_Space; each hole stays one argument.
pub fn jet_typed_sh_interpolate(literals: [String], holes: [String]) -> [String] Never! {
    argv := [String]{}
    loop index in 0..<literals.len() {
        loop word in unicode_string.split_whitespace(literals[index]) -> &argv.push(word)
        if holes.len() > index -> &argv.push(holes[index])
    }
    argv
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:95
// D-BOUND-HEAD1=A: checked boundary heads use this one interpolation kernel on
// every tier; adapters marshal lists and never decide encoding or traversal.
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:99
pub fn jet_typed_path_interpolate(literals: [String], holes: [String]) -> String Never! {
    interpolate_typed_head(literals, holes, encode_path_component)
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:103
pub fn jet_typed_datetime_interpolate(literals: [String], holes: [String]) -> String Never! {
    interpolate_typed_head(literals, holes, (hole: String) -> hole)
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:107
pub fn jet_validate_typed_path_literal(literals: [String]) Err! {
    loop literal in literals {
        loop byte in literal.bytes() {
            if byte == 0 -> return Err("a Path cannot contain a NUL character")
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:115
fn interpolate_typed_head(literals: [String], holes: [String], encode_hole: fn(String) -> String Never!) -> String Never! {
    parts :: loop index in 0..<literals.len() -> if holes.len() > index -> "{literals[index]}{encode_hole(holes[index])}" else -> literals[index]
    parts.join("")
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:132-158. Separators and
// control bytes are percent-encoded, so a hole is one filesystem component;
// `.` and `..` are encoded whole so a hole never becomes a traversal step.
fn encode_path_component(value: String) -> String Never! {
    traversal :: value == "." || value == ".."
    out := [U8]{}
    loop byte in value.bytes() {
        n :: Int.from_u8(byte)
        if !traversal && path_safe(n) {
            &out.push(byte)
        } else {
            &out.push(U8{37})
            &out.push(hex_digit(n >> 4))
            &out.push(hex_digit(n & 15))
        }
    }
    String.from_bytes(out) ?? panic("path encoding keeps UTF-8 intact")
}
// ASCII alphanumerics and `-` `.` `_` `~` stay literal.
fn path_safe(n: Int) -> Bool Never! {
    (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 45 || n == 46 || n == 95 || n == 126
}
// Rust: crates/jet-codegen/src/Prelude/TypedText.rs:160. Uppercase hex nibble.
fn hex_digit(nibble: Int) -> U8 Never! {
    if nibble < 10 -> U8{48 + nibble} else -> U8{55 + nibble}
}
fn push_text(out: &[U8], text: String) Never! {
    loop byte in text.bytes() -> &out.push(byte)
}
