package {
    name: "core.text.wrap"
    version: "0.1.0"
    edition: "2026"
    description: "core.text.wrap core library."
    license: "MIT"
    outputs: {
        wrap: .Library{ entry: wrap }
    }
}
use core.text as unicode
// core.text.wrap — paragraph filling, indent, and HTML escaping.
//
// Python `textwrap` plus display-column-safe width, indentation, and escaping.
// Width is measured in terminal display columns using `core.text`.
pub fn wrap(text: String, width: Int) -> [String] {
    spec :: wrapper(width)
    wrap_with(text, spec)
}

pub fn fill(text: String, width: Int) -> String {
    lines :: wrap(text, width)
    s := ""
    i := 0
    loop i < lines.len() {
        if i == 0 -> s = lines[0] else -> s = "{s}\n{lines[i]}"
        i = i + 1
    }
    s
}

pub fn shorten(text: String, width: Int, placeholder: String) -> String {
    if width <= 0 -> return ""
    if unicode.display_width(text) <= width -> return ~text
    shorten_text(text, width, placeholder, false)
}

pub fn indent(text: String, prefix: String) -> String {
    lines :: split_lines(text)
    s := ""
    i := 0
    loop i < lines.len() {
        piece :: "{prefix}{lines[i]}"
        if i == 0 -> s = piece else -> s = "{s}\n{piece}"
        i = i + 1
    }
    s
}

pub fn dedent(text: String) -> String {
    lines :: split_lines(text)
    margin := -1
    loop line in lines {
        if is_blank(line) -> next
        m :: leading_spaces(line)
        if margin < 0 || m < margin -> margin = m
    }
    if margin <= 0 -> return ~text
    s := ""
    i := 0
    loop i < lines.len() {
        line := lines[i]
        if !is_blank(line) && line.bytes().len() >= margin {
            line = slice_b(line.bytes(), margin, line.bytes().len())
        }
        if i == 0 -> s = line else -> s = "{s}\n{line}"
        i = i + 1
    }
    s
}

pub fn expand_tabs(text: String, tabsize: Int) -> String {
    size := tabsize
    if size <= 0 -> size = 8
    out := ""
    col := 0
    cr :: String.from_bytes([U8]{13}) ?? ""
    crlf :: "{cr}\n"
    loop cluster in unicode.graphemes(text) {
        if cluster == "\t" {
            n := size - (col % size)
            i := 0
            loop i < n {
                out = "{out} "
                i = i + 1
            }
            col = col + n
        } else {
            out = "{out}{cluster}"
            if cluster == "\n" || cluster == cr || cluster == crlf {
                col = 0
            } else {
                col = col + unicode.display_width(cluster)
            }
        }
    }
    out
}

pub fn html_escape(text: String, quote: Bool) -> String {
    out := ""
    loop scalar in unicode.scalars(text) {
        if scalar == "&" -> out = "{out}&amp;"
        else if scalar == "<" -> out = "{out}&lt;"
        else if scalar == ">" -> out = "{out}&gt;"
        else if quote && scalar == "\"" -> out = "{out}&quot;"
        else if quote && scalar == "'" -> out = "{out}&#x27;"
        else -> out = "{out}{scalar}"
    }
    out
}

pub fn html_unescape(text: String) -> String {
    s := replace_all(text, "&amp;", "&")
    s = replace_all(s, "&lt;", "<")
    s = replace_all(s, "&gt;", ">")
    s = replace_all(s, "&quot;", "\"")
    s = replace_all(s, "&#x27;", "'")
    s = replace_all(s, "&apos;", "'")
    s
}

fn split_ws(text: String) -> [String] {
    out := [String]{}
    current := ""
    loop scalar in unicode.scalars(text) {
        if unicode.is_whitespace(scalar) {
            if current.bytes().len() > 0 {
                out.push(current)
                current = ""
            }
        } else {
            current = "{current}{scalar}"
        }
    }
    if current.bytes().len() > 0 -> out.push(current)
    out
}

fn split_ws_preserving(text: String) -> [String] {
    out := [String]{}
    current := ""
    current_whitespace := false
    has_current := false
    loop scalar in unicode.scalars(text) {
        whitespace := unicode.is_whitespace(scalar)
        if has_current && whitespace != current_whitespace {
            out.push(current)
            current = ""
            has_current = false
        }
        current = "{current}{scalar}"
        current_whitespace = whitespace
        has_current = true
    }
    if has_current -> out.push(current)
    out
}

fn split_lines(text: String) -> [String] {
    raw :: text.bytes()
    out := [String]{}
    start := 0
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{10}) {
            end := i
            if end > start && raw[end - 1] == (U8{13}) -> end = end - 1
            out.push(slice_b(raw, start, end))
            start = i + 1
        }
        i = i + 1
    }
    out.push(slice_b(raw, start, raw.len()))
    out
}

fn is_blank(text: String) -> Bool {
    loop b in text.bytes() {
        n :: b
        if n != 32 && n != 9 -> return false
    }
    true
}

fn leading_spaces(text: String) -> Int {
    n := 0
    loop b in text.bytes() {
        if b == (U8{32}) || b == (U8{9}) -> n = n + 1 else -> return n
    }
    n
}

fn slice_b(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i < 0 || i >= raw.len() -> return String.from_bytes(out) ?? ""
        out.push(raw[i])
        i = i + 1
    }
}

fn replace_all(text: String, old: String, new: String) -> String {
    if old.bytes().len() == 0 -> return ~text
    out := ""
    i := 0
    loop {
        rest :: slice_b(text.bytes(), i, text.bytes().len())
        j :: find_at(rest, old)
        if j < 0 -> return "{out}{rest}"
        out = "{out}{slice_b(rest.bytes(), 0, j)}{new}"
        i = i + j + old.bytes().len()
    }
}

fn find_at(text: String, needle: String) -> Int {
    raw :: text.bytes()
    nd :: needle.bytes()
    if nd.len() == 0 -> return 0
    if nd.len() > raw.len() -> return -1
    loop i in 0..<(raw.len() - nd.len() + 1) {
        ok := true
        loop j in 0..<nd.len() {
            if raw[i + j] != nd[j] -> ok = false
        }
        if ok -> return i
    }
    -1
}

pub struct Wrapper {
    pub width: Int
    pub initial_indent: String
    pub subsequent_indent: String
    pub expand_tabs: Bool
    pub drop_whitespace: Bool
    pub break_long_words: Bool
    pub break_on_hyphens: Bool
    pub max_lines: Int
    pub placeholder: String
    pub tabsize: Int
}

pub fn wrapper(width: Int) -> Wrapper {
    {
        width: width,
        initial_indent: "",
        subsequent_indent: "",
        expand_tabs: true,
        drop_whitespace: true,
        break_long_words: true,
        break_on_hyphens: true,
        max_lines: 0,
        placeholder: " [...]",
        tabsize: 8,
    }
}

pub fn wrap_with(text: String, spec: Wrapper) -> [String] {
    if spec.width <= 0 -> return [String]{text}
    body := text
    if spec.expand_tabs -> body = expand_tabs(body, spec.tabsize)
    words := split_ws(body)
    if !spec.drop_whitespace -> words = split_ws_preserving(body)
    out := [String]{}
    line_indent := spec.initial_indent
    indent_width := unicode.display_width(line_indent)
    line := ~line_indent
    line_has_text := false
    loop piece in words {
        if spec.drop_whitespace && is_blank(piece) -> next
        if line_has_text {
            separator := " "
            if !spec.drop_whitespace -> separator = ""
            trial :: "{line}{separator}{piece}"
            if unicode.display_width(trial) <= spec.width {
                line = trial
                next
            }
            out.push(line)
            line_indent = spec.subsequent_indent
            indent_width = unicode.display_width(line_indent)
            line = ~line_indent
            line_has_text = false
        }
        capacity := spec.width - indent_width
        if capacity <= 0 -> capacity = 1
        piece_width := unicode.display_width(piece)
        if piece_width <= capacity || !spec.break_long_words {
            line = "{line_indent}{piece}"
            line_has_text = true
        } else {
            remaining := piece
            loop remaining.bytes().len() > 0 {
                chunks :: break_word(remaining, capacity, spec.break_on_hyphens)
                if chunks.len() == 0 {
                    line = "{line_indent}{remaining}"
                    line_has_text = true
                    remaining = ""
                } else if chunks.len() == 1 {
                    line = "{line_indent}{chunks[0]}"
                    line_has_text = true
                    remaining = ""
                } else {
                    out.push("{line_indent}{chunks[0]}")
                    remaining = join_chunks(chunks, 1)
                    line_indent = spec.subsequent_indent
                    indent_width = unicode.display_width(line_indent)
                    line = ~line_indent
                    line_has_text = false
                    capacity = spec.width - indent_width
                    if capacity <= 0 -> capacity = 1
                }
            }
        }
    }
    if line_has_text -> out.push(line)
    if spec.max_lines > 0 && out.len() > spec.max_lines {
        keep := [String]{}
        i := 0
        loop i < spec.max_lines {
            if i + 1 == spec.max_lines {
                last_indent := spec.initial_indent
                if i > 0 -> last_indent = spec.subsequent_indent
                keep.push(line_with_placeholder(out[i], last_indent, spec.width, spec.placeholder))
            } else {
                keep.push(out[i])
            }
            i = i + 1
        }
        return keep
    }
    out
}

pub fn fill_with(text: String, spec: Wrapper) -> String { join_lines(wrap_with(text, spec)) }

pub fn indent_with(text: String, prefix: String, predicate_nonblank: Bool) -> String {
    lines :: split_lines(text)
    s := ""
    i := 0
    loop i < lines.len() {
        line := lines[i]
        if !predicate_nonblank || !is_blank(line) -> line = "{prefix}{line}"
        if i == 0 -> s = line else -> s = "{s}\n{line}"
        i = i + 1
    }
    s
}

pub fn wrap_paragraphs(text: String, width: Int) -> String {
    paras :: split_paragraphs(text)
    s := ""
    i := 0
    loop i < paras.len() {
        filled :: fill(paras[i], width)
        if i == 0 -> s = filled else -> s = "{s}\n\n{filled}"
        i = i + 1
    }
    s
}

pub fn hanging_indent(text: String, first: String, rest: String, width: Int) -> String {
    spec :: Wrapper{
        width: width,
        initial_indent: first,
        subsequent_indent: rest,
        expand_tabs: true,
        drop_whitespace: true,
        break_long_words: true,
        break_on_hyphens: true,
        max_lines: 0,
        placeholder: " [...]",
        tabsize: 8,
    }
    fill_with(text, spec)
}

fn break_word(word: String, width: Int, break_on_hyphens: Bool) -> [String] {
    if width <= 0 -> return [String]{word}
    units :: unicode.graphemes(word)
    out := [String]{}
    if units.len() == 0 -> return out
    start := 0
    loop start < units.len() {
        i := start
        current_width := 0
        last_hyphen := -1
        overflowed := false
        loop i < units.len() {
            unit :: units[i]
            unit_width :: unicode.display_width(unit)
            if i > start && current_width + unit_width > width {
                overflowed = true
                break
            }
            if i == start && current_width + unit_width > width {
                i = i + 1
                overflowed = true
                break
            }
            current_width = current_width + unit_width
            if unit == "-" -> last_hyphen = i + 1
            i = i + 1
        }
        if i <= start -> i = start + 1
        end := i
        if overflowed && break_on_hyphens && last_hyphen > start && last_hyphen < i {
            end = last_hyphen
        }
        if end <= start -> end = start + 1
        out.push(join_units(units, start, end))
        start = end
    }
    out
}

fn join_units(units: [String], start: Int, end: Int) -> String {
    out := ""
    i := start
    loop i < end {
        out = "{out}{units[i]}"
        i = i + 1
    }
    out
}

fn join_chunks(chunks: [String], start: Int) -> String {
    out := ""
    i := start
    loop i < chunks.len() {
        out = "{out}{chunks[i]}"
        i = i + 1
    }
    out
}

fn shorten_text(text: String, width: Int, placeholder: String, force_placeholder: Bool) -> String {
    if width <= 0 -> return ""
    placeholder_width := unicode.display_width(placeholder)
    text_width := unicode.display_width(text)
    if !force_placeholder && text_width <= width -> return ~text
    if force_placeholder && text_width + placeholder_width <= width -> return "{text}{placeholder}"
    if placeholder_width > width -> return take_width(placeholder, width)
    available := width - placeholder_width
    prefix := word_prefix(text, available)
    "{prefix}{placeholder}"
}

fn word_prefix(text: String, width: Int) -> String {
    if width <= 0 -> return ""
    words :: split_ws(text)
    if words.len() == 0 -> return ""
    current := ""
    i := 0
    loop i < words.len() {
        candidate := words[i]
        if current.bytes().len() > 0 -> candidate = "{current} {words[i]}"
        if unicode.display_width(candidate) <= width {
            current = candidate
        } else {
            if current.bytes().len() == 0 -> return take_width(words[i], width)
            return ~current
        }
        i = i + 1
    }
    current
}

fn take_width(text: String, width: Int) -> String {
    if width <= 0 -> return ""
    out := ""
    current_width := 0
    clusters :: unicode.graphemes(text)
    i := 0
    loop i < clusters.len() {
        cluster :: clusters[i]
        cluster_width :: unicode.display_width(cluster)
        if current_width + cluster_width > width -> return ~out
        out = "{out}{cluster}"
        current_width = current_width + cluster_width
        i = i + 1
    }
    out
}

fn line_with_placeholder(line: String, line_indent: String, width: Int, placeholder: String) -> String {
    capacity := width - unicode.display_width(line_indent)
    if capacity <= 0 -> return ~line_indent
    indent_bytes := line_indent.bytes().len()
    content := line
    if line.bytes().len() >= indent_bytes -> content = slice_b(line.bytes(), indent_bytes, line.bytes().len())
    "{line_indent}{shorten_text(content, capacity, placeholder, true)}"
}

fn join_lines(lines: [String]) -> String {
    s := ""
    i := 0
    loop i < lines.len() {
        if i == 0 -> s = lines[0] else -> s = "{s}\n{lines[i]}"
        i = i + 1
    }
    s
}

fn split_paragraphs(text: String) -> [String] {
    lines :: split_lines(text)
    out := [String]{}
    cur := ""
    started := false
    loop line in lines {
        if is_blank(line) {
            if started {
                out.push(cur)
                cur = ""
                started = false
            }
            next
        }
        if started -> cur = "{cur} {line}" else {
            cur = line
            started = true
        }
    }
    if started -> out.push(cur)
    out
}
