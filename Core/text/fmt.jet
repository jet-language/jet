use core.text as unicode
use core.math as math
// core.text.fmt — deterministic number, quantity, and display formatting.
// Calls run this source; interpolation selectors and compile-time calls run the
// shared Prelude kernel crates/jet-codegen/src/Prelude/Core/Fmt.rs, which takes
// the same steps, so both give one meaning (owner rows, card #4588). Radix
// helpers use lowercase digits; text padding counts UTF-8 scalars.
// Fixed-precision rounding is half away from zero and never prints a negative
// zero; non-finite Floats keep their ordinary display.
pub fn number(n: Int) -> String Never! { grouped_int(n) }
pub fn bin(n: Int) -> String Never! { radix_signed_width(n, 2, 0) }
pub fn oct(n: Int) -> String Never! { radix_signed_width(n, 8, 0) }

/// `width` is the minimum digit count, zero-padded. Negative `n` keeps sign.
pub fn hex(n: Int, width: Int) -> String Never! { radix_signed_width(n, 16, width) }

pub fn ordinal(n: Int) -> String Never! {
    abs :: abs_int(n)
    suffix :: if {
        abs % 100 >= 11 && abs % 100 <= 13 -> "th"
        abs % 10 == 1 -> "st"
        abs % 10 == 2 -> "nd"
        abs % 10 == 3 -> "rd"
        else -> "th"
    }
    "{grouped_int(n)}{suffix}"
}

pub fn plural(n: Int, singular: String, many: String) -> String Never! {
    word :: if abs_int(n) == 1 -> singular else -> many
    "{grouped_int(n)} {word}"
}

/// An empty `fill` pads with spaces; the fill pattern restarts on each side.
pub fn pad_left(text: String, width: Int, fill: String) -> String Never! { "{pad_fill(fill, pad_need(text, width))}{text}" }
pub fn pad_right(text: String, width: Int, fill: String) -> String Never! { "{text}{pad_fill(fill, pad_need(text, width))}" }
pub fn pad_center(text: String, width: Int, fill: String) -> String Never! {
    need :: pad_need(text, width)
    left :: need /% 2
    "{pad_fill(fill, left)}{text}{pad_fill(fill, need - left)}"
}
pub fn pad(text: String, width: Int, fill: String) -> String Never! { pad_right(text, width, fill) }

pub fn grouped(n: Float, frac: Int) -> String Never! { group_decimal(float_fixed(n, frac)) }
pub fn decimal(n: Float, frac: Int) -> String Never! { float_fixed(n, frac) }
pub fn percent(n: Float, frac: Int) -> String Never! { "{grouped(n * 100.0, frac)}%" }

/// Normalized scientific notation with a plain exponent: `1.23e3`, `1.23e-3`.
pub fn sci(n: Float, frac: Int) -> String Never! {
    if !math.is_finite(n) -> return "{n}"
    if n == 0.0 -> return "{float_fixed(0.0, frac)}e0"
    sign :: if n < 0.0 -> "-" else -> ""
    value := if n < 0.0 -> -n else -> n
    exponent := 0
    loop value >= 10.0 {
        value /= 10.0
        exponent += 1
    }
    loop value < 1.0 {
        value *= 10.0
        exponent -= 1
    }
    mantissa := float_fixed(value, frac)
    // Rounding can carry the mantissa to 10; renormalize instead of printing "10.00".
    if mantissa.starts_with("10") {
        exponent += 1
        mantissa = float_fixed(value / 10.0, frac)
    }
    "{sign}{mantissa}e{exponent}"
}

/// Lays out canonical Debug text: one item per line, commas between items,
/// strings skipped while scanning. Empty collections stay on one line, and
/// `[:]` and `[redacted]` are returned unchanged.
pub fn pretty(value: String) -> String Never! { pretty_fragment(value.trim(), 0) }

/// SI units (1000), one decimal below 10 and rounded at or above 10.
pub fn bytes(n: Int) -> String Never! {
    sign :: if n < 0 -> "-" else -> ""
    units :: ["B", "KB", "MB", "GB", "TB", "PB", "EB"]
    size := Float{abs_int(n)}
    unit := 0
    loop size >= 1000.0 && unit + 1 < units.len() {
        size /= 1000.0
        unit += 1
    }
    shown :: if {
        unit == 0 -> "{abs_int(n)}"
        size >= 10.0 -> "{math.round(size)}"
        else -> trim_point_zero(float_fixed(size, 1))
    }
    "{sign}{shown} {units[unit]}"
}

/// `n` is milliseconds. Composite output is bounded to three non-zero units.
pub fn duration(n: Int) -> String Never! {
    sign :: if n < 0 -> "-" else -> ""
    rest := abs_int(n)
    if rest < 1000 -> return "{sign}{rest}ms"
    days :: rest /% 86400000
    rest %%= 86400000
    hours :: rest /% 3600000
    rest %%= 3600000
    minutes :: rest /% 60000
    rest %%= 60000
    seconds :: rest /% 1000
    parts := [String]{}
    if days > 0 -> &parts.push("{days}d")
    if hours > 0 -> &parts.push("{hours}h")
    if minutes > 0 -> &parts.push("{minutes}m")
    if seconds > 0 || parts.len() == 0 -> &parts.push("{seconds}s")
    "{sign}{parts.take(3).join(" ")}"
}

fn abs_int(n: Int) -> Int Never! { if n < 0 -> -n else -> n }

fn grouped_int(n: Int) -> String Never! {
    sign :: if n < 0 -> "-" else -> ""
    "{sign}{grouped_digits(radix(abs_int(n), 10))}"
}

fn radix_signed_width(n: Int, base: Int, width: Int) -> String Never! {
    sign :: if n < 0 -> "-" else -> ""
    "{sign}{pad_left(radix(abs_int(n), base), width, "0")}"
}

fn radix(n: Int, base: Int) -> String Never! {
    if n == 0 -> return "0"
    digits := [U8]{}
    x := n
    loop x > 0 {
        d :: x % base
        if d < 10 -> &digits.push(U8{48 + d}) else -> &digits.push(U8{87 + d})
        x /%= base
    }
    &digits.reverse()
    String.from_bytes(digits) ?? "0"
}

fn power_of_ten(precision: Int) -> Float Never! {
    scale := Float{1}
    loop _ in 0..<precision -> scale *= Float{10}
    scale
}

// Half away from zero at `precision` places (core.math.round).
fn fixed_digits(n: Float, precision: Int) -> Int Never! { math.round(n * power_of_ten(precision)) }

fn float_fixed(n: Float, frac: Int) -> String Never! {
    if !math.is_finite(n) -> return "{n}"
    precision :: if frac < 0 -> 0 else -> frac
    rounded :: fixed_digits(n, precision)
    sign :: if rounded < 0 -> "-" else -> ""
    digits :: radix(abs_int(rounded), 10)
    if precision == 0 -> return "{sign}{digits}"
    body :: pad_left(digits, precision + 1, "0")
    split :: unicode.scalar_count(body) - precision
    "{sign}{body.slice(0, split)}.{body.slice(split, unicode.scalar_count(body))}"
}

fn trim_point_zero(text: String) -> String Never! {
    if text.ends_with(".0") -> text.slice(0, unicode.scalar_count(text) - 2) else -> ~text
}

// Groups the whole part of a fixed decimal; sign and fraction are kept verbatim.
fn group_decimal(text: String) -> String Never! {
    sign :: if text.starts_with("-") || text.starts_with("+") -> text.slice(0, 1) else -> ""
    body :: text.slice(unicode.scalar_count(sign), unicode.scalar_count(text))
    dot :: body.index_of(".") ?? unicode.scalar_count(body)
    "{sign}{grouped_digits(body.slice(0, dot))}{body.slice(dot, unicode.scalar_count(body))}"
}

fn grouped_digits(text: String) -> String Never! {
    raw :: text.bytes()
    out := [U8]{}
    loop i in 0..<raw.len() {
        if i > 0 && (raw.len() - i) % 3 == 0 -> &out.push(U8{44})
        &out.push(raw[i])
    }
    String.from_bytes(out) ?? ~text
}

fn pad_need(text: String, width: Int) -> Int Never! {
    need :: width - unicode.scalar_count(text)
    if need < 0 -> 0 else -> need
}

// `len` scalars of `fill` repeated; an empty fill is one space.
fn pad_fill(fill: String, len: Int) -> String Never! {
    units :: unicode.scalars(if fill == "" -> " " else -> fill)
    parts :: loop i in 0..<len -> units[i % units.len()]
    parts.join("")
}

fn close_for(open: String) -> String? Never! {
    if open == {
        "{{" -> Val("}}")
        "[" -> Val("]")
        "(" -> Val(")")
        else -> None
    }
}

// Scalar index of the first opener outside a quoted string.
fn first_structure(cps: [String]) -> Int? Never! {
    quoted := false
    escaped := false
    loop i in 0..<cps.len() {
        ch :: cps[i]
        if quoted {
            if {
                escaped -> escaped = false
                ch == "\\" -> escaped = true
                ch == "\"" -> quoted = false
            }
            next
        }
        if {
            ch == "\"" -> quoted = true
            close_for(ch) != None -> return Val(i)
        }
    }
    None
}

// Index of the closer that balances the first `open` scalar.
fn matching_close(cps: [String], open: String) -> Int? Never! {
    stack := [String]{close_for(open) ?? return None}
    quoted := false
    escaped := false
    seen_start := false
    loop i in 0..<cps.len() {
        ch :: cps[i]
        if !seen_start {
            if ch == open -> seen_start = true
            next
        }
        if quoted {
            if {
                escaped -> escaped = false
                ch == "\\" -> escaped = true
                ch == "\"" -> quoted = false
            }
            next
        }
        if {
            ch == "\"" -> quoted = true
            close_for(ch) == .Val(close) -> &stack.push(close)
            stack.len() > 0 && stack[stack.len() - 1] == ch -> {
                _ :: &stack.pop()
                if stack.len() == 0 -> return Val(i)
            }
        }
    }
    None
}

fn joined(cps: [String], start: Int, end: Int) -> String Never! {
    parts :: loop i in start..<end -> cps[i]
    parts.join("")
}

// Top-level comma-separated items, trimmed, empty items dropped.
fn split_top_level(cps: [String]) -> [String] Never! {
    items := [String]{}
    start := 0
    stack := [String]{}
    quoted := false
    escaped := false
    loop i in 0..<cps.len() {
        ch :: cps[i]
        if quoted {
            if {
                escaped -> escaped = false
                ch == "\\" -> escaped = true
                ch == "\"" -> quoted = false
            }
            next
        }
        if {
            ch == "\"" -> quoted = true
            close_for(ch) == .Val(close) -> &stack.push(close)
            stack.len() > 0 && stack[stack.len() - 1] == ch -> _ :: &stack.pop()
            ch == "," && stack.len() == 0 -> {
                item :: joined(cps, start, i).trim()
                if item != "" -> &items.push(item)
                start = i + 1
            }
        }
    }
    item :: joined(cps, start, cps.len()).trim()
    if item != "" -> &items.push(item)
    items
}

fn ascii_lower(text: String) -> String Never! {
    raw :: text.bytes()
    out := [U8]{}
    loop byte in raw -> &out.push(if byte >= 65 && byte <= 90 -> byte + U8{32} else -> byte)
    String.from_bytes(out) ?? ~text
}

fn pretty_fragment(value: String, indent: Int) -> String Never! {
    cps :: unicode.scalars(value)
    open_at :: first_structure(cps) ?? return ~value
    open :: cps[open_at]
    close :: close_for(open) ?? return ~value
    end :: matching_close(cps, open) ?? return ~value
    if joined(cps, end + 1, cps.len()).trim() != "" -> return ~value
    prefix :: joined(cps, 0, open_at).trim()
    head :: if prefix == "" -> open else -> "{prefix} {open}"
    body :: joined(cps, open_at + 1, end).trim()
    if body == "" -> return "{head}{close}"
    if open == "[" && (body == ":" || ascii_lower(body) == "redacted") -> return ~value
    inner :: " ".repeat(indent + 2)
    lines :: loop item in split_top_level(unicode.scalars(body)) -> "{inner}{pretty_fragment(item, indent + 2)}"
    "{head}\n{lines.join(",\n")}\n{" ".repeat(indent)}{close}"
}
