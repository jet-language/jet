use core.math as math
use core.text as unicode
// core.text.fmt — deterministic number, quantity, and display formatting.
// Radix helpers use lowercase digits; text padding counts UTF-8 scalars.
pub fn number(n: Int) -> String Never! { grouped_int(n) }
pub fn bin(n: Int) -> String Never! { radix_signed(n, 2) }
pub fn oct(n: Int) -> String Never! { radix_signed(n, 8) }

/// `width` is the minimum digit count, zero-padded. Negative `n` keeps sign.
pub fn hex(n: Int, width: Int) -> String Never! { radix_signed_width(n, 16, width) }

pub fn ordinal(n: Int) -> String Never! {
    abs :: abs_int(n)
    mod100 :: abs % 100
    suffix := "th"
    if mod100 < 11 || mod100 > 13 {
        m :: abs % 10
        if m == 1 -> suffix = "st"
        if m == 2 -> suffix = "nd"
        if m == 3 -> suffix = "rd"
    }
    "{grouped_int(n)}{suffix}"
}

pub fn plural(n: Int, singular: String, many: String) -> String Never! {
    word :: if abs_int(n) == 1 -> singular else -> many
    "{grouped_int(n)} {word}"
}

pub fn pad_left(text: String, width: Int, fill: String) -> String Never! { pad_mode(text, width, fill, 0) }
pub fn pad_right(text: String, width: Int, fill: String) -> String Never! { pad_mode(text, width, fill, 1) }
pub fn pad_center(text: String, width: Int, fill: String) -> String Never! { pad_mode(text, width, fill, 2) }
pub fn pad(text: String, width: Int, fill: String) -> String Never! { pad_right(text, width, fill) }

pub fn grouped(n: Float, frac: Int) -> String Never! { group_decimal(float_fixed(n, frac)) }
pub fn decimal(n: Float, frac: Int) -> String Never! { float_fixed(n, frac) }
pub fn percent(n: Float, frac: Int) -> String Never! { "{grouped(n * 100.0, frac)}%" }

// Compiler interpolation helpers reuse the source-owned formatting policy.
// Ported from aa45bf8fc Core/text/runtime/kernel_fmt.jet; no C ABI adapter.
pub fn quantity(n: Float) -> String Never! {
    text :: "{n}"
    if text.ends_with(".0") -> slice(text, 0, unicode.scalar_count(text) - 2) else -> text
}

pub fn fixed_int(n: Int, frac: Int) -> String Never! { exact_int_decimal(n, frac, false) }

pub fn grouped_int_fixed(n: Int, frac: Int) -> String Never! { exact_int_decimal(n, frac, true) }

fn exact_int_decimal(n: Int, frac: Int, grouped: Bool) -> String Never! {
    whole :: if grouped -> grouped_int(n) else -> "{n}"
    if frac <= 0 -> return whole
    "{whole}.{"0".repeat(frac)}"
}

// The exact decimal spelling rail rejects everything except an optional
// sign and ASCII digits. Malformed spellings return trimmed and unchanged.
pub fn hex_decimal(value: String, width: Int) -> String Never! {
    n :: decimal_spelling(value) ?? return value.trim()
    hex(n, width)
}

pub fn bin_decimal(value: String) -> String Never! {
    n :: decimal_spelling(value) ?? return value.trim()
    bin(n)
}

pub fn oct_decimal(value: String) -> String Never! {
    n :: decimal_spelling(value) ?? return value.trim()
    oct(n)
}

fn decimal_spelling(value: String) -> Int? Never! {
    text :: ~value.trim()
    negative :: text.starts_with("-")
    digits :: if negative || text.starts_with("+") -> slice(text, 1, unicode.scalar_count(text)) else -> text
    if digits == "" -> return None
    loop byte in digits.bytes() {
        if byte < (U8{48}) || byte > (U8{57}) -> return None
    }
    magnitude :: digits.parse<Int>() ?? return None
    Val(if negative -> -magnitude else -> magnitude)
}

// Core/Fmt.rs:153-155 formats the exact binary value with ties-to-even.
// Unlike shortest Float display, an explicit precision cannot round a
// repeatedly scaled Float without changing boundary cases.
pub fn sci(n: Float, frac: Int) -> String Never! {
    if !math.is_finite(n) -> return "{n}"
    precision :: if frac < 0 -> 0 else -> frac
    bits :: math.to_bits(n)
    sign :: if bits < 0 -> "-" else -> ""
    if n == 0.0 -> return "{sign}{scaled_decimal(0, precision)}e0"
    binary_exponent :: (bits >> 52) & 2047
    numerator := bits & 4503599627370495
    shift := -1074
    if binary_exponent != 0 {
        numerator = numerator + 4503599627370496
        shift = binary_exponent - 1075
    }
    denominator := 1
    if shift >= 0 -> numerator = numerator << shift
    else -> denominator = denominator << -shift
    exponent := 0
    loop numerator >= denominator * 10 {
        denominator = denominator * 10
        exponent = exponent + 1
    }
    loop numerator < denominator {
        numerator = numerator * 10
        exponent = exponent - 1
    }
    scale := 1
    i := 0
    loop i < precision {
        scale = scale * 10
        i = i + 1
    }
    numerator = numerator * scale
    rounded := numerator /% denominator
    remainder :: numerator % denominator
    if remainder * 2 > denominator || (remainder * 2 == denominator && rounded % 2 != 0) -> rounded = rounded + 1
    if rounded == scale * 10 {
        rounded = scale
        exponent = exponent + 1
    }
    "{sign}{scaled_decimal(rounded, precision)}e{exponent}"
}

fn scaled_decimal(n: Int, precision: Int) -> String Never! {
    digits :: radix(n, 10)
    if precision == 0 -> return digits
    body :: pad_left(digits, precision + 1, "0")
    split :: body.bytes().len() - precision
    "{slice(body, 0, split)}.{slice(body, split, body.bytes().len())}"
}

// Core/Fmt.rs:166-310: expand only one complete outer fragment, with quoted
// delimiters ignored and commas split only at the current structural depth.
pub fn pretty(value: String) -> String Never! { pretty_fragment(value, 0) }

fn pretty_fragment(value: String, indent: Int) -> String Never! {
    text :: ~value.trim()
    open_at :: first_structure(text) ?? return text
    raw :: text.bytes()
    open :: raw[open_at]
    close :: structure_close(open) ?? return text
    end :: matching_close(text, open, close) ?? return text
    if byte_slice(text, end + 1, raw.len()).trim() != "" -> return text
    prefix :: ~byte_slice(text, 0, open_at).trim_end()
    body :: byte_slice(text, open_at + 1, end)
    trimmed_body :: ~body.trim()
    open_text :: String.from_bytes([U8]{open}) ?? ""
    close_text :: String.from_bytes([U8]{close}) ?? ""
    if trimmed_body == "" -> return ~"{prefix} {open_text}{close_text}".trim_start()
    if open == (U8{91}) && (trimmed_body == ":" || trimmed_body.lower() == "redacted") -> return text
    out := if prefix == "" -> open_text else -> "{prefix} {open_text}"
    stack := [U8]{}
    quoted := false
    escaped := false
    start := 0
    i := 0
    body_raw :: body.bytes()
    loop i < body_raw.len() {
        ch :: body_raw[i]
        if quoted {
            if escaped -> escaped = false
            else if ch == (U8{92}) -> escaped = true
            else if ch == (U8{34}) -> quoted = false
        } else if ch == (U8{34}) {
            quoted = true
        } else if structure_close(ch) == .Val(expected) {
            &stack.push(expected)
        } else if stack.len() > 0 && stack[stack.len() - 1] == ch {
            _ :: &stack.pop()
        } else if ch == (U8{44}) && stack.len() == 0 {
            item :: ~byte_slice(body, start, i).trim()
            if item != "" -> out = "{out}\n{spaces(indent + 2)}{pretty_fragment(item, indent + 2)}"
            start = i + 1
        }
        i = i + 1
    }
    item :: ~byte_slice(body, start, body_raw.len()).trim()
    if item != "" -> out = "{out}\n{spaces(indent + 2)}{pretty_fragment(item, indent + 2)}"
    "{out}\n{spaces(indent)}{close_text}"
}

fn structure_close(open: U8) -> U8? Never! {
    if open == (U8{123}) -> return Val(U8{125})
    if open == (U8{91}) -> return Val(U8{93})
    if open == (U8{40}) -> return Val(U8{41})
    None
}

fn first_structure(value: String) -> Int? Never! {
    quoted := false
    escaped := false
    raw :: value.bytes()
    i := 0
    loop i < raw.len() {
        ch :: raw[i]
        if quoted {
            if escaped -> escaped = false
            else if ch == (U8{92}) -> escaped = true
            else if ch == (U8{34}) -> quoted = false
        } else if ch == (U8{34}) {
            quoted = true
        } else if structure_close(ch) != None {
            return Val(i)
        }
        i = i + 1
    }
    None
}

fn matching_close(value: String, open: U8, close: U8) -> Int? Never! {
    stack := [U8]{close}
    quoted := false
    escaped := false
    seen_start := false
    raw :: value.bytes()
    i := 0
    loop i < raw.len() {
        ch :: raw[i]
        if !seen_start {
            if ch == open -> seen_start = true
        } else if quoted {
            if escaped -> escaped = false
            else if ch == (U8{92}) -> escaped = true
            else if ch == (U8{34}) -> quoted = false
        } else if ch == (U8{34}) {
            quoted = true
        } else if structure_close(ch) == .Val(expected) {
            &stack.push(expected)
        } else if stack.len() > 0 && stack[stack.len() - 1] == ch {
            _ :: &stack.pop()
            if stack.len() == 0 -> return Val(i)
        }
        i = i + 1
    }
    None
}

fn byte_slice(value: String, start: Int, end: Int) -> String Never! {
    String.from_bytes(slice_b(value.bytes(), start, end)) ?? ""
}

/// Decimal byte display (1000-based), with the unit selected before rounding.
pub fn bytes(n: Int) -> String Never! { bytes_scaled(n, 1000) }

/// Binary byte display (1024-based), with the same signed rounding rules.
pub fn bytes_binary(n: Int) -> String Never! { bytes_scaled(n, 1024) }

fn bytes_scaled(n: Int, base: Int) -> String Never! {
    value :: abs_int(n)
    if value < base -> return "{n} B"
    sign :: if n < 0 -> "-" else -> ""
    divisor := base
    unit := 1
    loop unit < 6 && value >= divisor * base {
        divisor = divisor * base
        unit = unit + 1
    }
    suffix := if base == 1000 -> "kB" else -> "KiB"
    if unit == 2 -> suffix = if base == 1000 -> "MB" else -> "MiB"
    if unit == 3 -> suffix = if base == 1000 -> "GB" else -> "GiB"
    if unit == 4 -> suffix = if base == 1000 -> "TB" else -> "TiB"
    if unit == 5 -> suffix = if base == 1000 -> "PB" else -> "PiB"
    if unit == 6 -> suffix = if base == 1000 -> "EB" else -> "EiB"
    if value >= divisor * 10 {
        rounded := value /% divisor
        if (value % divisor) * 2 >= divisor -> rounded = rounded + 1
        return "{sign}{rounded} {suffix}"
    }
    // One fractional digit uses ties-to-even; whole units use half-away.
    scaled :: value * 10
    tenths := scaled /% divisor
    remainder :: scaled % divisor
    if remainder * 2 > divisor || (remainder * 2 == divisor && tenths % 2 != 0) {
        tenths = tenths + 1
    }
    whole :: tenths /% 10
    digit :: tenths % 10
    if digit == 0 -> return "{sign}{whole} {suffix}"
    "{sign}{whole}.{digit} {suffix}"
}

/// `n` is milliseconds. Composite output is bounded to three non-zero units.
pub fn duration(n: Int) -> String Never! {
    sign := ""
    rest := n
    if rest < 0 {
        sign = "-"
        rest = -rest
    }
    if rest < 1000 -> return "{sign}{rest}ms"
    days := rest /% 86400000
    rest = rest %% 86400000
    hours := rest /% 3600000
    rest = rest %% 3600000
    minutes := rest /% 60000
    rest = rest %% 60000
    seconds := rest /% 1000
    parts := [String]{}
    if days > 0 -> &parts.push("{days}d")
    if hours > 0 -> &parts.push("{hours}h")
    if minutes > 0 -> &parts.push("{minutes}m")
    if seconds > 0 || parts.len() == 0 -> &parts.push("{seconds}s")
    out := ""
    limit := parts.len()
    if limit > 3 -> limit = 3
    i := 0
    loop i < limit {
        if i > 0 -> out = "{out} "
        out = "{out}{parts[i]}"
        i = i + 1
    }
    "{sign}{out}"
}

fn abs_int(n: Int) -> Int {
    if n < 0 -> return -n
    n
}

fn grouped_int(n: Int) -> String {
    sign := ""
    rest := n
    if rest < 0 {
        sign = "-"
        rest = -rest
    }
    digits :: radix(rest, 10)
    raw :: digits.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        remaining :: raw.len() - i
        if i > 0 && remaining % 3 == 0 -> &out.push(U8{44})
        &out.push(raw[i])
        i = i + 1
    }
    "{sign}{String.from_bytes(out) ?? digits}"
}

fn radix_signed(n: Int, base: Int) -> String { radix_signed_width(n, base, 0) }

fn radix_signed_width(n: Int, base: Int, width: Int) -> String {
    sign := ""
    value := n
    if value < 0 {
        sign = "-"
        value = -value
    }
    digits :: radix(value, base)
    "{sign}{pad_left(digits, width, "0")}"
}

fn radix(n: Int, base: Int) -> String {
    if n == 0 -> return "0"
    digits := [U8]{}
    x := n
    loop x > 0 {
        d :: x % base
        if d < 10 -> &digits.push(U8{48 + d}) else -> &digits.push(U8{87 + d})
        x = x /% base
    }
    out := [U8]{}
    i := digits.len() - 1
    loop i >= 0 {
        &out.push(digits[i])
        i = i - 1
    }
    String.from_bytes(out) ?? "0"
}

fn float_fixed(n: Float, frac: Int) -> String Never! {
    precision := frac
    if precision < 0 -> precision = 0
    scale := Float{1}
    i := 0
    loop i < precision {
        scale = scale * Float{10}
        i = i + 1
    }
    scaled := n * scale
    rounded := math.round(scaled)
    sign := ""
    if rounded < 0 {
        sign = "-"
        rounded = -rounded
    }
    digits :: radix(rounded, 10)
    if precision == 0 -> return "{sign}{digits}"
    body := pad_left(digits, precision + 1, "0")
    split :: body.bytes().len() - precision
    "{sign}{slice(body, 0, split)}.{slice(body, split, body.bytes().len())}"
}

fn group_decimal(text: String) -> String {
    raw :: text.bytes()
    sign := ""
    start := 0
    if raw.len() > 0 && (raw[0] == (U8{45}) || raw[0] == (U8{43})) {
        sign = String.from_bytes([U8]{raw[0]}) ?? ""
        start = 1
    }
    dot := raw.len()
    i := start
    loop i < raw.len() {
        if raw[i] == (U8{46}) {
            dot = i
            break
        }
        i = i + 1
    }
    whole := String.from_bytes(slice_b(raw, start, dot)) ?? "0"
    frac := if dot < raw.len() -> String.from_bytes(slice_b(raw, dot, raw.len())) ?? "" else -> ""
    "{sign}{grouped_digits(whole)}{frac}"
}

fn grouped_digits(text: String) -> String {
    raw :: text.bytes()
    out := [U8]{}
    i := 0
    loop i < raw.len() {
        remain :: raw.len() - i
        if i > 0 && remain % 3 == 0 -> &out.push(U8{44})
        &out.push(raw[i])
        i = i + 1
    }
    String.from_bytes(out) ?? text
}

// Core/Fmt.rs:389-419: empty fill means space, and each centered side
// begins its own fill cycle.
fn pad_mode(text: String, width: Int, fill: String, mode: Int) -> String Never! {
    need :: width - unicode.scalar_count(text)
    if need <= 0 -> return ~text
    units :: unicode.scalars(if fill == "" -> " " else -> fill)
    if mode == 2 {
        left :: need /% 2
        return "{pad_fill(units, left)}{text}{pad_fill(units, need - left)}"
    }
    added :: pad_fill(units, need)
    if mode == 0 -> "{added}{text}" else -> "{text}{added}"
}

fn pad_fill(units: [String], need: Int) -> String Never! {
    out := ""
    i := 0
    loop i < need {
        out = "{out}{units[i % units.len()]}"
        i = i + 1
    }
    out
}

fn spaces(n: Int) -> String {
    out := ""
    i := 0
    loop i < n {
        out = "{out} "
        i = i + 1
    }
    out
}


fn slice(text: String, start: Int, end: Int) -> String Never! {
    units :: unicode.scalars(text)
    out := ""
    i := start
    loop i < end && i < units.len() {
        if i >= 0 -> out = "{out}{units[i]}"
        i = i + 1
    }
    out
}

fn slice_b(raw: [U8], start: Int, end: Int) -> [U8] {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i < 0 || i >= raw.len() -> return out
        &out.push(raw[i])
        i = i + 1
    }
}

#Test("fmt Rust scientific grouping and padding policy") {
    assert_eq(percent(12345.625, 2), "1,234,562.50%")
    assert_eq(sci(2.5, 0), "2e0")
    assert_eq(sci(-0.0, 2), "-0.00e0")
    assert_eq(sci(999.999, 2), "1.00e3")
    assert_eq(sci(0.125, 1), "1.2e-1")
    assert_eq(sci(1e23, 2), "1.00e23")
    assert_eq(sci(math.from_bits(1), 2), "4.94e-324")
    assert_eq(pad_left("x", 3, ""), "  x")
    assert_eq(pad_center("x", 6, "ab"), "abxaba")
}

#Test("fmt Rust nested fragment scanner") {
    assert_eq(pretty("  scalar  "), "scalar")
    assert_eq(pretty("[]"), "[]")
    assert_eq(pretty("[redacted]"), "[redacted]")
    assert_eq(pretty("[1] trailing"), "[1] trailing")
    assert_eq(pretty("[1, 2"), "[1, 2")
    assert_eq(pretty("Point {{x: 1, y: [2, 3]}}"), "Point {{\n  x: 1\n  y: [\n    2\n    3\n  ]\n}}")
    assert_eq(pretty("\"quoted [1, 2]\""), "\"quoted [1, 2]\"")
}
