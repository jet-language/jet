use core.text as unicode
use core.math as math
// core.text.fmt — deterministic number, quantity, and display formatting.
// Calls run this source; interpolation selectors and compile-time calls run the
// shared Prelude kernel crates/jet-codegen/src/Prelude/Core/Fmt.rs, which takes
// the same steps, so both give one meaning (owner rows, card #4588). Radix
// helpers use lowercase digits; text padding counts UTF-8 scalars.
// Fixed-precision formats preserve the exact binary Float's ties-to-even
// rounding and signed zero; non-finite Floats keep their ordinary display.
fn number(n: Int) -> String Never! { grouped_int(n) }
fn bin(n: Int) -> String Never! { radix_signed_width(n, 2, 0) }
fn oct(n: Int) -> String Never! { radix_signed_width(n, 8, 0) }

/// `width` is the minimum digit count, zero-padded. Negative `n` keeps sign.
fn hex(n: Int, width: Int) -> String Never! { radix_signed_width(n, 16, width) }

fn ordinal(n: Int) -> String Never! {
    abs :: abs_int(n)
    suffix :: if {
        abs % 100 >= 11 && abs % 100 <= 13 -> "th"
        abs % 10 == 1 -> "st"
        abs % 10 == 2 -> "nd"
        abs % 10 == 3 -> "rd"
        else -> "th"
    }
    "{grouped_int(n)}{suffix}"
}

fn plural(n: Int, singular: String, many: String) -> String Never! {
    word :: if abs_int(n) == 1 -> singular else -> many
    "{grouped_int(n)} {word}"
}

/// An empty `fill` pads with spaces; the fill pattern restarts on each side.
fn pad_left(text: String, width: Int, fill: String) -> String Never! { pad_mode(text, width, fill, 0) }
fn pad_right(text: String, width: Int, fill: String) -> String Never! { pad_mode(text, width, fill, 1) }
fn pad_center(text: String, width: Int, fill: String) -> String Never! { pad_mode(text, width, fill, 2) }
fn pad(text: String, width: Int, fill: String) -> String Never! { pad_right(text, width, fill) }

fn grouped(n: Float, frac: Int) -> String Never! { group_decimal(float_fixed(n, frac)) }
fn decimal(n: Float, frac: Int) -> String Never! { float_fixed(n, frac) }
fn percent(n: Float, frac: Int) -> String Never! { "{grouped(n * 100.0, frac)}%" }

// Compiler interpolation helpers reuse the source-owned formatting policy.
// Ported from aa45bf8fc Core/text/runtime/kernel_fmt.jet; no C ABI adapter.
fn quantity(n: Float) -> String Never! {
    text :: "{n}"
    if text.ends_with(".0") -> slice(text, 0, unicode.scalar_count(text) - 2) else -> text
}

fn fixed_int(n: Int, frac: Int) -> String Never! { exact_int_decimal(n, frac, false) }

fn grouped_int_fixed(n: Int, frac: Int) -> String Never! { exact_int_decimal(n, frac, true) }

fn exact_int_decimal(n: Int, frac: Int, grouped: Bool) -> String Never! {
    whole :: if grouped -> grouped_int(n) else -> "{n}"
    if frac <= 0 -> return whole
    "{whole}.{"0".repeat(frac)}"
}

// The exact decimal spelling rail rejects everything except an optional
// sign and ASCII digits. Malformed spellings return trimmed and unchanged.
fn hex_decimal(value: String, width: Int) -> String Never! {
    n :: decimal_spelling(value) ?? return value.trim()
    hex(n, width)
}

fn bin_decimal(value: String) -> String Never! {
    n :: decimal_spelling(value) ?? return value.trim()
    bin(n)
}

fn oct_decimal(value: String) -> String Never! {
    n :: decimal_spelling(value) ?? return value.trim()
    oct(n)
}

fn decimal_spelling(value: String) -> Int? Never! {
    text :: value.trim().copy()
    negative :: text.starts_with("-")
    digits :: if negative || text.starts_with("+") -> slice(text, 1, unicode.scalar_count(text)) else -> text
    if digits == "" -> return None
    loop byte in digits.bytes() {
        if byte < (U8{48}) || byte > (U8{57}) -> return None
    }
    magnitude :: digits.parse<Int>() ?? return None
    Val(if negative -> -magnitude else -> magnitude)
}

// Core/Fmt.rs:153-155 formats the exact binary value with ties-to-even.
// Unlike shortest Float display, an explicit precision cannot round a
// repeatedly scaled Float without changing boundary cases.
fn sci(n: Float, frac: Int) -> String Never! {
    if !math.is_finite(n) -> return "{n}"
    precision :: if frac < 0 -> 0 else -> frac
    bits :: math.to_bits(n)
    sign :: if bits < 0 -> "-" else -> ""
    if n == 0.0 -> return "{sign}{scaled_decimal(0, precision)}e0"
    binary_exponent :: (bits >> 52).bit_and(2047)
    numerator := bits.bit_and(4503599627370495)
    shift := -1074
    if binary_exponent != 0 {
        numerator = numerator + 4503599627370496
        shift = binary_exponent - 1075
    }
    denominator := 1
    if shift >= 0 -> numerator = numerator << shift
    else -> denominator = denominator << -shift
    exponent := 0
    loop numerator >= denominator * 10 {
        denominator = denominator * 10
        exponent = exponent + 1
    }
    loop numerator < denominator {
        numerator = numerator * 10
        exponent = exponent - 1
    }
    scale := 1
    i := 0
    loop i < precision {
        scale = scale * 10
        i = i + 1
    }
    numerator = numerator * scale
    rounded := round_ratio_even(numerator, denominator)
    if rounded == scale * 10 {
        rounded = scale
        exponent = exponent + 1
    }
    "{sign}{scaled_decimal(rounded, precision)}e{exponent}"
}

fn scaled_decimal(n: Int, precision: Int) -> String Never! {
    digits :: radix(n, 10)
    if precision == 0 -> return digits
    body :: pad_left(digits, precision + 1, "0")
    split :: body.bytes().len() - precision
    "{slice(body, 0, split)}.{slice(body, split, body.bytes().len())}"
}

// Exact positive rational rounding shared by scientific and fixed formats.
fn round_ratio_even(numerator: Int, denominator: Int) -> Int Never! {
    rounded := numerator /% denominator
    remainder :: numerator % denominator
    if remainder * 2 > denominator || (remainder * 2 == denominator && rounded % 2 != 0) -> rounded = rounded + 1
    rounded
}

// Core/Fmt.rs:166-310: expand only one complete outer fragment, with quoted
// delimiters ignored and commas split only at the current structural depth.
fn pretty(value: String) -> String Never! { pretty_fragment(value, 0) }

fn pretty_fragment(value: String, indent: Int) -> String Never! {
    text :: value.trim().copy()
    open_at :: first_structure(text) ?? return text
    raw :: text.bytes()
    open :: raw[open_at]
    close :: structure_close(open) ?? return text
    end :: matching_close(text, open, close) ?? return text
    if byte_slice(text, end + 1, raw.len()).trim() != "" -> return text
    prefix :: byte_slice(text, 0, open_at).trim_end().copy()
    body :: byte_slice(text, open_at + 1, end)
    trimmed_body :: body.trim().copy()
    open_text :: String.from_bytes([U8]{open}) ?? ""
    close_text :: String.from_bytes([U8]{close}) ?? ""
    if trimmed_body == "" -> return "{prefix} {open_text}{close_text}".trim_start().copy()
    if open == (U8{91}) && (trimmed_body == ":" || trimmed_body.lower() == "redacted") -> return text
    out := if prefix == "" -> open_text else -> "{prefix} {open_text}"
    stack := [U8]{}
    quoted := false
    escaped := false
    start := 0
    i := 0
    body_raw :: body.bytes()
    loop i < body_raw.len() {
        ch :: body_raw[i]
        if quoted {
            if escaped -> escaped = false
            else if ch == (U8{92}) -> escaped = true
            else if ch == (U8{34}) -> quoted = false
        } else if ch == (U8{34}) {
            quoted = true
        } else if structure_close(ch) == .Val(expected) {
            &stack.push(expected)
        } else if stack.len() > 0 && stack[stack.len() - 1] == ch {
            _ :: &stack.pop()
        } else if ch == (U8{44}) && stack.len() == 0 {
            item :: byte_slice(body, start, i).trim().copy()
            if item != "" -> out = "{out}\n{spaces(indent + 2)}{pretty_fragment(item, indent + 2)}"
            start = i + 1
        }
        i = i + 1
    }
    item :: byte_slice(body, start, body_raw.len()).trim().copy()
    if item != "" -> out = "{out}\n{spaces(indent + 2)}{pretty_fragment(item, indent + 2)}"
    "{out}\n{spaces(indent)}{close_text}"
}

fn structure_close(open: U8) -> U8? Never! {
    if open == (U8{123}) -> return Val(U8{125})
    if open == (U8{91}) -> return Val(U8{93})
    if open == (U8{40}) -> return Val(U8{41})
    None
}

fn first_structure(value: String) -> Int? Never! {
    quoted := false
    escaped := false
    raw :: value.bytes()
    i := 0
    loop i < raw.len() {
        ch :: raw[i]
        if quoted {
            if escaped -> escaped = false
            else if ch == (U8{92}) -> escaped = true
            else if ch == (U8{34}) -> quoted = false
        } else if ch == (U8{34}) {
            quoted = true
        } else if structure_close(ch) != None {
            return Val(i)
        }
        i = i + 1
    }
    None
}

fn matching_close(value: String, open: U8, close: U8) -> Int? Never! {
    stack := [U8]{close}
    quoted := false
    escaped := false
    seen_start := false
    raw :: value.bytes()
    i := 0
    loop i < raw.len() {
        ch :: raw[i]
        if !seen_start {
            if ch == open -> seen_start = true
        } else if quoted {
            if escaped -> escaped = false
            else if ch == (U8{92}) -> escaped = true
            else if ch == (U8{34}) -> quoted = false
        } else if ch == (U8{34}) {
            quoted = true
        } else if structure_close(ch) == .Val(expected) {
            &stack.push(expected)
        } else if stack.len() > 0 && stack[stack.len() - 1] == ch {
            _ :: &stack.pop()
            if stack.len() == 0 -> return Val(i)
        }
        i = i + 1
    }
    None
}

fn byte_slice(value: String, start: Int, end: Int) -> String Never! {
    String.from_bytes(slice_b(value.bytes(), start, end)) ?? ""
}

/// SI units (1000), one decimal below 10 and rounded at or above 10.
fn bytes(n: Int) -> String Never! {
    sign :: if n < 0 -> "-" else -> ""
    units :: ["B", "KB", "MB", "GB", "TB", "PB", "EB"]
    size := Float{abs_int(n)}
    unit := 0
    loop size >= 1000.0 && unit + 1 < units.len() {
        size /= 1000.0
        unit += 1
    }
    shown :: if {
        unit == 0 -> "{abs_int(n)}"
        size >= 10.0 -> "{math.round(size)}"
        else -> trim_point_zero(float_fixed(size, 1))
    }
    "{sign}{shown} {units[unit]}"
}

/// `n` is milliseconds. Composite output is bounded to three non-zero units.
fn duration(n: Int) -> String Never! {
    // Matches native bug; #4798 / D-FMT-DURATION-MIN1 (owner decision pending).
    if n == -9223372036854775808 -> return "--9223372036854775808ms"
    sign := ""
    rest := n
    if rest < 0 {
        sign = "-"
        rest = -rest
    }
    if rest < 1000 -> return "{sign}{rest}ms"
    days :: rest /% 86400000
    rest %%= 86400000
    hours :: rest /% 3600000
    rest %%= 3600000
    minutes :: rest /% 60000
    rest %%= 60000
    seconds :: rest /% 1000
    parts := [String]{}
    if days > 0 -> &parts.push("{days}d")
    if hours > 0 -> &parts.push("{hours}h")
    if minutes > 0 -> &parts.push("{minutes}m")
    if seconds > 0 || parts.len() == 0 -> &parts.push("{seconds}s")
    "{sign}{parts.take(3).join(" ")}"
}

fn abs_int(n: Int) -> Int Never! { if n < 0 -> -n else -> n }

fn grouped_int(n: Int) -> String Never! {
    sign :: if n < 0 -> "-" else -> ""
    "{sign}{grouped_digits(radix(abs_int(n), 10))}"
}

fn radix_signed_width(n: Int, base: Int, width: Int) -> String Never! {
    sign :: if n < 0 -> "-" else -> ""
    "{sign}{pad_left(radix(abs_int(n), base), width, "0")}"
}

fn radix(n: Int, base: Int) -> String Never! {
    if n == 0 -> return "0"
    digits := [U8]{}
    x := n
    loop x > 0 {
        d :: x % base
        if d < 10 -> &digits.push(U8{48 + d}) else -> &digits.push(U8{87 + d})
        x /%= base
    }
    &digits.reverse()
    String.from_bytes(digits) ?? "0"
}

// Core/Fmt.rs:7-9 formats the exact binary Float, ties-to-even, signed zero.
fn float_fixed(n: Float, frac: Int) -> String Never! {
    if !math.is_finite(n) -> return "{n}"
    precision :: if frac < 0 -> 0 else -> frac
    bits :: math.to_bits(n)
    sign :: if bits < 0 -> "-" else -> ""
    if n == 0.0 -> return "{sign}{scaled_decimal(0, precision)}"
    binary_exponent :: (bits >> 52).bit_and(2047)
    numerator := bits.bit_and(4503599627370495)
    shift := -1074
    if binary_exponent != 0 {
        numerator = numerator + 4503599627370496
        shift = binary_exponent - 1075
    }
    denominator := 1
    if shift >= 0 -> numerator = numerator << shift
    else -> denominator = denominator << -shift
    i := 0
    loop i < precision {
        numerator = numerator * 10
        i = i + 1
    }
    "{sign}{scaled_decimal(round_ratio_even(numerator, denominator), precision)}"
}

fn trim_point_zero(text: String) -> String Never! {
    if text.ends_with(".0") -> text.slice(0, unicode.scalar_count(text) - 2) else -> text.copy()
}

// Groups the whole part of a fixed decimal; sign and fraction are kept verbatim.
fn group_decimal(text: String) -> String Never! {
    sign :: if text.starts_with("-") || text.starts_with("+") -> text.slice(0, 1) else -> ""
    body :: text.slice(unicode.scalar_count(sign), unicode.scalar_count(text))
    dot :: body.index_of(".") ?? unicode.scalar_count(body)
    "{sign}{grouped_digits(body.slice(0, dot))}{body.slice(dot, unicode.scalar_count(body))}"
}

fn grouped_digits(text: String) -> String Never! {
    raw :: text.bytes()
    out := [U8]{}
    loop i in 0..<raw.len() {
        if i > 0 && (raw.len() - i) % 3 == 0 -> &out.push(U8{44})
        &out.push(raw[i])
    }
    String.from_bytes(out) ?? text.copy()
}


// Core/Fmt.rs:389-419: empty fill means space, and each centered side
// begins its own fill cycle.
fn pad_mode(text: String, width: Int, fill: String, mode: Int) -> String Never! {
    need :: width - unicode.scalar_count(text)
    if need <= 0 -> return text.copy()
    units :: unicode.scalars(if fill == "" -> " " else -> fill)
    if mode == 2 {
        left :: need /% 2
        return "{pad_fill(units, left)}{text}{pad_fill(units, need - left)}"
    }
    added :: pad_fill(units, need)
    if mode == 0 -> "{added}{text}" else -> "{text}{added}"
}

fn pad_fill(units: [String], need: Int) -> String Never! {
    out := ""
    i := 0
    loop i < need {
        out = "{out}{units[i % units.len()]}"
        i = i + 1
    }
    out
}

fn spaces(n: Int) -> String {
    out := ""
    i := 0
    loop i < n {
        out = "{out} "
        i = i + 1
    }
    out
}


fn slice(text: String, start: Int, end: Int) -> String Never! {
    units :: unicode.scalars(text)
    out := ""
    i := start
    loop i < end && i < units.len() {
        if i >= 0 -> out = "{out}{units[i]}"
        i = i + 1
    }
    out
}

fn slice_b(raw: [U8], start: Int, end: Int) -> [U8] {
    out := [U8]{}
    i := start
    loop {
        if i >= end || i < 0 || i >= raw.len() -> return out
        &out.push(raw[i])
        i = i + 1
    }
}

#Test("fmt Rust scientific grouping and padding policy") {
    assert_eq(percent(12345.625, 2), "1,234,562.50%")
    assert_eq(sci(2.5, 0), "2e0")
    assert_eq(sci(-0.0, 2), "-0.00e0")
    assert_eq(sci(999.999, 2), "1.00e3")
    assert_eq(sci(0.125, 1), "1.2e-1")
    assert_eq(sci(1e23, 2), "1.00e23")
    assert_eq(sci(math.from_bits(1), 2), "4.94e-324")
    assert_eq(pad_left("x", 3, ""), "  x")
    assert_eq(pad_center("x", 6, "ab"), "abxaba")
}

#Test("fmt Rust fixed rounding signed zero and compatibility units") {
    assert_eq(decimal(2.5, 0), "2")
    assert_eq(decimal(3.5, 0), "4")
    assert_eq(decimal(-2.5, -1), "-2")
    assert_eq(decimal(0.125, 2), "0.12")
    assert_eq(decimal(-0.0, 2), "-0.00")
    assert_eq(decimal(-0.125, 0), "-0")
    assert_eq(grouped(12345.625, 2), "12,345.62")
    assert_eq(percent(-12345.625, 0), "-1,234,562%")
    assert_eq(bytes(1001), "1 KB")
    assert_eq(bytes(-1001), "-1 KB")
    assert_eq(duration(-9223372036854775808), "--9223372036854775808ms")
}

#Test("fmt Rust nested fragment scanner") {
    assert_eq(pretty("  scalar  "), "scalar")
    assert_eq(pretty("[]"), "[]")
    assert_eq(pretty("[redacted]"), "[redacted]")
    assert_eq(pretty("[1] trailing"), "[1] trailing")
    assert_eq(pretty("[1, 2"), "[1, 2")
    assert_eq(pretty("Point {{x: 1, y: [2, 3]}}"), "Point {{\n  x: 1\n  y: [\n    2\n    3\n  ]\n}}")
    assert_eq(pretty("\"quoted [1, 2]\""), "\"quoted [1, 2]\"")
}

#Test("Compiler-only formatting helpers retain exact lexical policy") {
    assert_eq(quantity(Float{-0.0}), "-0")
    assert_eq(quantity(Float{0.1}), "0.1")
    assert_eq(fixed_int(-123456789012345678901234567890, 2), "-123456789012345678901234567890.00")
    assert_eq(grouped_int_fixed(123456789012345678901234567890, 1), "123,456,789,012,345,678,901,234,567,890.0")
    assert_eq(hex_decimal(" +000255 ", 4), "00ff")
    assert_eq(bin_decimal("-00010"), "-1010")
    assert_eq(oct_decimal(" 10 "), "12")
    assert_eq(hex_decimal("-0000", 0), "0")
    assert_eq(bin_decimal(" 1_0 "), "1_0")
    assert_eq(oct_decimal("+"), "+")
}
