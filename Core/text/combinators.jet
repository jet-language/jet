// Pure parser combinators over UTF-8 text. Input.pos is a byte offset, but
// predicate scans advance only at validated scalar boundaries.
use core.text as unicode

pub struct Input {
    pub text: String
    pub pos: Int
}

pub struct Took {
    pub next: Input
    pub chunk: String
}

pub struct Digit {
    pub next: Input
    pub n: Int
}

pub fn input(text: String) -> Input { {text: text, pos: 0} }

pub fn remaining(src: Input) -> String {
    raw :: src.text.bytes()
    if src.pos < 0 || src.pos >= raw.len() -> return ""
    String.from_bytes(slice_rest(raw, src.pos)) ?? ""
}

pub fn eof(src: Input) -> Bool { src.pos >= src.text.bytes().len() }

pub fn peek(src: Input) -> U8? {
    raw :: src.text.bytes()
    if src.pos < 0 || src.pos >= raw.len() -> return None
    Val(raw[src.pos])
}

pub fn take_n(src: Input, n: Int) -> Took? {
    raw :: src.text.bytes()
    if n < 0 || src.pos < 0 || src.pos + n > raw.len() -> return None
    chunk :: String.from_bytes(slice_range(raw, src.pos, src.pos + n)) ?? return None
    Val(Took{next: Input{text: src.text, pos: src.pos + n}, chunk: chunk})
}

pub fn tag(src: Input, lit: String) -> Took? {
    got :: take_n(src, lit.bytes().len()) ?? return None
    if got.chunk != lit -> return None
    Val(got)
}

pub fn take_while(src: Input, predicate: String) -> Took {
    raw :: src.text.bytes()
    i := src.pos
    loop i < raw.len() {
        width :: utf8_width(raw, i)
        scalar :: String.from_bytes(slice_range(raw, i, i + width)) ?? break
        if !pred_scalar(predicate, scalar) -> break
        i = i + width
    }
    chunk :: String.from_bytes(slice_range(raw, src.pos, i)) ?? ""
    {next: Input{text: src.text, pos: i}, chunk: chunk}
}

pub fn skip_ws(src: Input) -> Input { take_while(src, "space").next }

pub fn digit(src: Input) -> Digit? {
    b :: peek(src) ?? return None
    if b < 48 || b > 57 -> return None
    nxt :: take_n(src, 1) ?? return None
    Val(Digit{next: nxt.next, n: Int.from_u8(b) - 48})
}

pub fn int_dec(src: Input) -> Digit? {
    cur := skip_ws(src) ?? return None
    sign := 1
    b :: peek(cur) ?? return None
    if b == 45 || b == 43 {
        if b == 45 -> sign = -1
        taken :: take_n(cur, 1) ?? return None
        cur = taken.next
    }
    acc := 0
    saw := false
    loop {
        d :: digit(cur) ?? break
        saw = true
        acc = acc * 10 + d.n
        cur = d.next
    }
    if !saw -> return None
    return Val(Digit{next: cur, n: acc * sign})
}

fn pred_scalar(kind: String, scalar: String) -> Bool {
    if kind == "space" -> return unicode.is_whitespace(scalar)
    if kind == "digit" -> return unicode.is_numeric(scalar)
    if kind == "alpha" -> return unicode.is_alphabetic(scalar)
    if kind == "alnum" -> return unicode.is_alphabetic(scalar) || unicode.is_numeric(scalar)
    false
}

fn utf8_width(raw: [U8], at: Int) -> Int {
    if at < 0 || at >= raw.len() -> return 1
    b :: raw[at]
    if b < 128 -> return 1
    if b >= 194 && b <= 223 && at + 1 < raw.len() && raw[at + 1] >= 128 && raw[at + 1] <= 191 -> return 2
    if b >= 224 && b <= 239 && at + 2 < raw.len() && raw[at + 1] >= 128 && raw[at + 1] <= 191 && raw[at + 2] >= 128 && raw[at + 2] <= 191 -> return 3
    if b >= 240 && b <= 244 && at + 3 < raw.len() && raw[at + 1] >= 128 && raw[at + 1] <= 191 && raw[at + 2] >= 128 && raw[at + 2] <= 191 && raw[at + 3] >= 128 && raw[at + 3] <= 191 -> return 4
    1
}

fn slice_range(raw: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    lo := start
    hi := end
    if lo < 0 -> lo = 0
    if hi > raw.len() -> hi = raw.len()
    if hi < lo -> hi = lo
    i := lo
    loop {
        if i >= hi -> return ~out
        &out.push(raw[i])
        i = i + 1
    }
}

fn slice_rest(raw: [U8], start: Int) -> [U8] { slice_range(raw, start, raw.len()) }
