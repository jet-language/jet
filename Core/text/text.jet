package {
    name: "core.text"
    version: "0.0.1"
    edition: "2026"
    description: "Unicode text, ASCII helpers, and display formatting."
    license: "MIT"
    outputs: {
        text: .Library{ entry: text }
    }
}

// core.text — strings as Unicode scalar sequences.
//
// Jet `String` is UTF-8. Counting, trimming, and case mapping are defined on
// scalars, not raw bytes, except where a function is named `byte_*`. UTF-8
// decode and Unicode 17.0.0 normalization/casing/classification/width use the
// canonical pinned assets. UAX #29 grapheme segmentation is below; word and
// sentence segmentation is the private runtime kernel_text_segments owner.
// Tables: node Tools/agent/gen-unicode-tables.mjs --core-only tests/data/unicode/ucd
// All immutable JUCD schema-1 assets use little-endian fields and pinned inputs.
//
// Predicates on the empty string are false (`is_alphabetic("")` is false).
// `splitn` / `rsplitn` take a maximum part count, matching Rust `splitn`.


module fmt
module parse
module wrap
module html
module combinators
module runtime
// Every member is a Jet body; no member calls its own `core.text` provider.
use core.text.runtime.kernel_unicode_string as text_unicode_string
use core.text.runtime.kernel_text_segments as text_segments
use core.text.runtime.kernel_text_normal as text_normal
use core.text.runtime.kernel_text_width as text_width
module catalog

/// Byte-offset cursor into UTF-8 text. Line and column are 1-based.
pub struct Cursor {
    pub offset: Int
    pub line: Int
    pub column: Int
}

/// Cursor at the start of `text` (offset 0, line 1, column 1).
pub fn cursor(_text: String) -> Cursor Never! {
    Cursor{offset: 0, line: 1, column: 1}
}

/// Advance `cur` by one UTF-8 scalar in `text`. Past the end is a no-op.
pub fn cursor_advance(text: String, cur: Cursor) -> Cursor Never! {
    raw :: text_unicode_string.utf8_bytes(text)
    if cur.offset < 0 -> return Cursor{offset: 0, line: 1, column: 1}
    if cur.offset >= raw.len() -> return ~cur
    width :: text_unicode_string.utf8_width_at(raw, cur.offset)
    next :: cur.offset + width
    if raw[cur.offset] == (U8{10}) -> return Cursor{offset: next, line: cur.line + 1, column: 1}
    Cursor{offset: next, line: cur.line, column: cur.column + 1}
}

/// Byte length of UTF-8 `text`. Equal to `text.bytes().len()`.
pub fn byte_count(text: String) -> Int Never! { text_unicode_string.utf8_bytes(text).len() }

pub fn is_ascii(text: String) -> Bool Never! {
    loop b in text_unicode_string.utf8_bytes(text) {
        if b > (U8{127}) -> return false
    }
    true
}

/// Unicode scalar count (replacement character U+FFFD counts as one).
pub fn scalar_count(text: String) -> Int Never! { decode_scalars(text).len() }

pub fn scalars(text: String) -> [String] Never! {
    out := [String]{}
    loop cp in decode_scalars(text) -> &out.push(encode_cp(cp))
    out
}

/// Full Unicode lowercase mapping (`"İ"` lowers to `"i̇"`). The String method
/// routes to the same runtime kernel, so both spellings agree (I8, I9).
pub fn lower(text: String) -> String Never! { text_unicode_string.lower(text) }

/// Full Unicode uppercase mapping (`"ß"` uppers to `"SS"`), same kernel.
pub fn upper(text: String) -> String Never! { text_unicode_string.upper(text) }

/// Unicode 17.0.0 default full C+F folding (locale-free): `"Straße"` folds to
/// `"strasse"`.
pub fn casefold(text: String) -> String Never! { text_unicode_string.casefold(text) }

// Rust Text.rs:337-341: canonical default caseless matching, not fold-only.
pub fn caseless_eq(left: String, right: String) -> Bool Never! {
    nfd(casefold(nfd(left))) == nfd(casefold(nfd(right)))
}

/// Unicode 17.0.0 canonical composition (UAX #15 NFC).
pub fn nfc(text: String) -> String Never! { text_normal.normalize(text, false, true) }
/// Unicode 17.0.0 canonical decomposition (UAX #15 NFD).
pub fn nfd(text: String) -> String Never! { text_normal.normalize(text, false, false) }
/// Unicode 17.0.0 compatibility decomposition followed by composition.
pub fn nfkc(text: String) -> String Never! { text_normal.normalize(text, true, true) }
/// Unicode 17.0.0 compatibility decomposition (UAX #15 NFKD).
pub fn nfkd(text: String) -> String Never! { text_normal.normalize(text, true, false) }

pub fn graphemes(text: String) -> [String] Never! { text_width.graphemes(text) }
/// Unicode 17.0.0 UAX #29 owned word segments containing Alphabetic or Numeric.
// Rust Text.rs:689-694; boundary/filter policy lives in kernel_text_segments.
pub fn words(text: String) -> [String] Never! { text_segments.words(text) }
/// Unicode 17.0.0 UAX #29 owned sentences, White_Space-trimmed; empty segments omitted.
// Rust Text.rs:880-885; boundary/trim policy lives in kernel_text_segments.
pub fn sentences(text: String) -> [String] Never! { text_segments.sentences(text) }
pub fn inspect(text: String) -> [String] Never! {
    out := [String]{}
    loop cp in decode_scalars(text) -> &out.push(hex_cp(cp))
    out
}

/// `"index:scalar"` pairs, index in bytes.
pub fn char_indices(text: String) -> [String] Never! {
    out := [String]{}
    loop pair in decode_indexed(text) -> &out.push("{pair.index}:{encode_cp(pair.cp)}")
    out
}

// Rust Text.rs:916-921 portable-default width; owner kernel_text_width.
pub fn display_width(text: String) -> Int Never! { text_width.display_width(text) }

pub fn grapheme_views(text: String) -> [String] Never! { graphemes(text) }
pub fn word_views(text: String) -> [String] Never! { words(text) }
pub fn line_views(text: String) -> [String] Never! { split_lines(text) }
/// The UTF-8 bytes of `text`, one decimal element per byte (dev meaning:
/// `byte_views("jet")` prints `[106, 101, 116]`).
pub fn byte_views(text: String) -> [String] Never! {
    out := [String]{}
    loop b in text_unicode_string.utf8_bytes(text) -> &out.push("{b}")
    out
}

// Rust Text.rs:939: nonempty, all scalars have DerivedCoreProperties Alphabetic.
pub fn is_alphabetic(text: String) -> Bool Never! { text_unicode_string.is_alphabetic(text) }

// Rust Text.rs:940: Numeric is General_Category Nd/Nl/No, not only decimal digits.
pub fn is_numeric(text: String) -> Bool Never! { text_unicode_string.is_numeric(text) }

pub fn is_whitespace(text: String) -> Bool Never! { text_unicode_string.is_whitespace(text) }

/// True iff any scalar is Unicode 17 Cc (D-TEXT-CONTROL1=A).
/// Empty text is false. Scan UTF-8 bytes without per-scalar allocation.
pub fn has_control(value: String) -> Bool Never! {
    after_c2 := false
    loop b in value.bytes() {
        if b < (U8{32}) || b == (U8{127}) -> return true
        if after_c2 && b >= (U8{128}) && b <= (U8{159}) -> return true
        after_c2 = b == (U8{194})
    }
    false
}

pub fn trim(text: String) -> String Never! { text_unicode_string.trim(text) }

pub fn trim_start(text: String) -> String Never! { text_unicode_string.trim_start(text) }

pub fn trim_end(text: String) -> String Never! { text_unicode_string.trim_end(text) }

/// Pad on the left until `width` UTF-8 scalars. Empty `fill` returns text unchanged.
pub fn pad_start(text: String, width: Int, fill: String) -> String Never! { pad_side(text, width, fill, true) }

pub fn pad_end(text: String, width: Int, fill: String) -> String Never! { pad_side(text, width, fill, false) }

pub fn center(text: String, width: Int, fill: String) -> String Never! {
    extra :: width - scalar_count(text)
    if extra <= 0 || scalar_count(fill) == 0 -> return ~text
    left :: extra /% 2
    pad_end(pad_start(text, scalar_count(text) + left, fill), width, fill)
}

pub fn starts_any(text: String, prefixes: [String]) -> Bool Never! {
    loop p in prefixes {
        if starts_with(text, p) -> return true
    }
    false
}

pub fn ends_any(text: String, suffixes: [String]) -> Bool Never! {
    loop s in suffixes {
        if ends_with(text, s) -> return true
    }
    false
}

/// At most `n` parts. `n <= 0` yields an empty list.
pub fn splitn(text: String, sep: String, n: Int) -> [String] Never! { split_limit(text, sep, n, false) }

pub fn rsplitn(text: String, sep: String, n: Int) -> [String] Never! { split_limit(text, sep, n, true) }


fn ascii_space(b: U8) -> Bool {
    n :: b
    n == 32 || n == 9 || n == 10 || n == 11 || n == 12 || n == 13
}

fn slice_bytes(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    lo := start
    hi := end
    if lo < 0 -> lo = 0
    if hi > raw.len() -> hi = raw.len()
    if hi < lo -> hi = lo
    i := lo
    loop {
        if i >= hi -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}

fn starts_with(text: String, prefix: String) -> Bool {
    a :: text_unicode_string.utf8_bytes(text)
    b :: text_unicode_string.utf8_bytes(prefix)
    if b.len() > a.len() -> return false
    loop i in 0..<b.len() {
        if a[i] != b[i] -> return false
    }
    true
}

fn ends_with(text: String, suffix: String) -> Bool {
    a :: text_unicode_string.utf8_bytes(text)
    b :: text_unicode_string.utf8_bytes(suffix)
    if b.len() > a.len() -> return false
    off :: a.len() - b.len()
    loop i in 0..<b.len() {
        if a[off + i] != b[i] -> return false
    }
    true
}

fn pad_side(text: String, width: Int, fill: String, left: Bool) -> String {
    extra :: width - scalar_count(text)
    units :: scalars(fill)
    if extra <= 0 || units.len() == 0 -> return ~text
    added := [String]{}
    i := 0
    loop added.len() < extra {
        &added.push(units[i])
        i = (i + 1) % units.len()
    }
    prefix := ""
    suffix := ""
    loop part in added {
        if left -> prefix = "{prefix}{part}" else -> suffix = "{suffix}{part}"
    }
    "{prefix}{text}{suffix}"
}

fn split_limit(text: String, sep: String, n: Int, from_right: Bool) -> [String] {
    if n <= 0 -> return [String]{}
    if n == 1 || text_unicode_string.utf8_bytes(sep).len() == 0 -> return [String]{text}
    parts := [String]{}
    rest := text
    loop {
        if parts.len() + 1 >= n {
            &parts.push(rest)
            return parts
        }
        at :: find_sep(rest, sep, from_right)
        if at < 0 {
            &parts.push(rest)
            return parts
        }
        if from_right {
            &parts.push(slice_bytes(text_unicode_string.utf8_bytes(rest), at + text_unicode_string.utf8_bytes(sep).len(), text_unicode_string.utf8_bytes(rest).len()))
            rest = slice_bytes(text_unicode_string.utf8_bytes(rest), 0, at)
        } else {
            &parts.push(slice_bytes(text_unicode_string.utf8_bytes(rest), 0, at))
            rest = slice_bytes(text_unicode_string.utf8_bytes(rest), at + text_unicode_string.utf8_bytes(sep).len(), text_unicode_string.utf8_bytes(rest).len())
        }
    }
}

fn find_sep(text: String, sep: String, from_right: Bool) -> Int {
    hay :: text.bytes()
    needle :: sep.bytes()
    if needle.len() == 0 || needle.len() > hay.len() -> return -1
    last :: hay.len() - needle.len()
    if from_right {
        i := last
        loop {
            if i < 0 -> return -1
            if match_at(hay, needle, i) -> return i
            i = i - 1
        }
    }
    loop i in 0..<(last + 1) {
        if match_at(hay, needle, i) -> return i
    }
    -1
}

fn match_at(hay: [U8], needle: [U8], start: Int) -> Bool {
    loop i in 0..<needle.len() {
        if hay[start + i] != needle[i] -> return false
    }
    true
}

pub struct IndexedCp {
    pub index: Int
    pub cp: Int
}

fn decode_scalars(text: String) -> [Int] Never! { text_width.decode_scalars(text) }

fn decode_indexed(text: String) -> [IndexedCp] Never! {
    raw :: text_unicode_string.utf8_bytes(text)
    out := [IndexedCp]{}
    i := 0
    loop {
        if i >= raw.len() -> return out
        start := i
        first := Int.from_u8(raw[i])
        width :: text_unicode_string.utf8_width_at(raw, i)
        if width == 1 {
            if first < 128 {
                &out.push(IndexedCp{index: start, cp: first})
            } else {
                &out.push(IndexedCp{index: start, cp: 65533})
            }
            i = i + 1
            next
        }
        cp := 0
        if width == 2 -> cp = first & 31
        if width == 3 -> cp = first & 15
        if width == 4 -> cp = first & 7
        valid := true
        k := 1
        loop k < width {
            byte := Int.from_u8(raw[i + k])
            if byte < 128 || byte >= 192 {
                valid = false
                break
            }
            cp = (cp << 6) | (byte & 63)
            k = k + 1
        }
        if !valid {
            &out.push(IndexedCp{index: start, cp: 65533})
            i = i + 1
            next
        }
        &out.push(IndexedCp{index: start, cp: cp})
        i = i + width
    }
}

fn encode_cp(cp: Int) -> String {
    out := [U8]{}
    text_unicode_string.append_cp(&out, cp)
    String.from_bytes(out) ?? ""
}

fn split_lines(text: String) -> [String] {
    raw :: text.bytes()
    if raw.len() == 0 -> return [String]{}
    out := [String]{}
    start := 0
    i := 0
    loop i < raw.len() {
        if raw[i] == (U8{10}) || raw[i] == (U8{13}) {
            &out.push(slice_bytes(raw, start, i))
            if raw[i] == (U8{13}) && i + 1 < raw.len() && raw[i + 1] == (U8{10}) -> i = i + 1
            i = i + 1
            start = i
            next
        }
        i = i + 1
    }
    if start < raw.len() -> &out.push(slice_bytes(raw, start, raw.len()))
    out
}


fn hex_cp(cp: Int) -> String {
    hex := "0123456789ABCDEF"
    hb :: hex.bytes()
    n := cp
    digits := [U8]{}
    if n == 0 -> &digits.push(U8{48})
    loop {
        if n == 0 -> break
        &digits.push(hb[n % 16])
        n = n /% 16
    }
    // pad to 4
    loop {
        if digits.len() >= 4 -> break
        &digits.push(U8{48})
    }
    out := [U8]{85, 43} // U+
    i := digits.len() - 1
    loop {
        if i < 0 -> return String.from_bytes(out) ?? ""
        &out.push(digits[i])
        i = i - 1
    }
}
