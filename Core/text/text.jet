package {
    name: "core.text"
    version: "0.0.1"
    edition: "2026"
    description: "Unicode text, ASCII helpers, and display formatting."
    license: "MIT"
    outputs: {
        text: .Library{ entry: text }
    }
}

// core.text — strings as Unicode scalar sequences.
//
// Jet `String` is UTF-8. Counting, trimming, and case mapping are defined on
// scalars, not raw bytes, except where a function is named `byte_*`. UTF-8
// decode, Unicode 17.0.0 normalization, UAX #29 grapheme/word segmentation
// (extended grapheme clusters, WB simple alphanumerics), East-Asian width, and Latin-1
// case mapping are Jet. Full Unicode case-fold tables beyond Latin-1 map
// identity (C+F for ASCII/Latin-1 still applied).
// Normalization data: node Tools/agent/gen-core-normalization.mjs tests/data/unicode/ucd
// (same checksum-verified Unicode 17.0.0 UCD as Rust jet_unicode).
//
// Predicates on the empty string are false (`is_alphabetic("")` is false).
// `splitn` / `rsplitn` take a maximum part count, matching Rust `splitn`.


module fmt
module parse
module wrap
module html
module combinators

/// Byte-offset cursor into UTF-8 text. Line and column are 1-based.
pub struct Cursor {
    pub offset: Int
    pub line: Int
    pub column: Int
}

/// Cursor at the start of `text` (offset 0, line 1, column 1).
pub fn cursor(_text: String) -> Cursor Never! {
    Cursor{offset: 0, line: 1, column: 1}
}

/// Advance `cur` by one UTF-8 scalar in `text`. Past the end is a no-op.
pub fn cursor_advance(text: String, cur: Cursor) -> Cursor Never! {
    raw :: text.bytes()
    if cur.offset < 0 -> return Cursor{offset: 0, line: 1, column: 1}
    if cur.offset >= raw.len() -> return ~cur
    width :: utf8_width_at(raw, cur.offset)
    next :: cur.offset + width
    if raw[cur.offset] == (U8{10}) -> return Cursor{offset: next, line: cur.line + 1, column: 1}
    Cursor{offset: next, line: cur.line, column: cur.column + 1}
}

/// Byte length of UTF-8 `text`. Equal to `text.bytes().len()`.
pub fn byte_count(text: String) -> Int Never! { text.bytes().len() }

pub fn is_ascii(text: String) -> Bool Never! {
    loop b in text.bytes() {
        if b > (U8{127}) -> return false
    }
    true
}

/// Unicode scalar count (replacement character U+FFFD counts as one).
pub fn scalar_count(text: String) -> Int Never! { decode_scalars(text).len() }

pub fn scalars(text: String) -> [String] Never! {
    out := [String]{}
    loop cp in decode_scalars(text) -> &out.push(encode_cp(cp))
    out
}

pub fn lower(text: String) -> String Never! { map_case(text, false) }

pub fn upper(text: String) -> String Never! { map_case(text, true) }

/// Unicode C+F case folding. Latin-1 folds through `lower`; other scalars identity.
pub fn casefold(text: String) -> String Never! { lower(text) }

pub fn caseless_eq(left: String, right: String) -> Bool Never! { casefold(left) == casefold(right) }

/// Unicode 17.0.0 canonical composition (UAX #15 NFC).
pub fn nfc(text: String) -> String Never! { normalize(text, false, true) }
/// Unicode 17.0.0 canonical decomposition (UAX #15 NFD).
pub fn nfd(text: String) -> String Never! { normalize(text, false, false) }
/// Unicode 17.0.0 compatibility decomposition followed by composition.
pub fn nfkc(text: String) -> String Never! { normalize(text, true, true) }
/// Unicode 17.0.0 compatibility decomposition (UAX #15 NFKD).
pub fn nfkd(text: String) -> String Never! { normalize(text, true, false) }

pub fn graphemes(text: String) -> [String] Never! { split_graphemes(text) }
pub fn words(text: String) -> [String] Never! { split_words(text) }
pub fn sentences(text: String) -> [String] Never! { split_sentences(text) }
pub fn inspect(text: String) -> [String] Never! {
    out := [String]{}
    loop cp in decode_scalars(text) -> &out.push(hex_cp(cp))
    out
}

/// `"index:scalar"` pairs, index in bytes.
pub fn char_indices(text: String) -> [String] Never! {
    out := [String]{}
    loop pair in decode_indexed(text) -> &out.push("{pair.index}:{encode_cp(pair.cp)}")
    out
}

pub fn display_width(text: String) -> Int Never! {
    total := 0
    loop cluster in split_graphemes(text) -> total = total + cluster_width(decode_scalars(cluster))
    total
}

pub fn grapheme_views(text: String) -> [String] Never! { graphemes(text) }
pub fn word_views(text: String) -> [String] Never! { words(text) }
pub fn line_views(text: String) -> [String] Never! { split_lines(text) }
pub fn byte_views(text: String) -> [String] Never! {
    out := [String]{}
    loop b in text.bytes() -> &out.push("{b}")
    out
}

pub fn is_alphabetic(text: String) -> Bool Never! {
    if text.bytes().len() == 0 -> return false
    if is_ascii(text) {
        loop b in text.bytes() {
            if !ascii_alpha(b) -> return false
        }
        return true
    }
    loop cp in decode_scalars(text) {
        if !is_alpha_cp(cp) -> return false
    }
    true
}

pub fn is_numeric(text: String) -> Bool Never! {
    if text.bytes().len() == 0 -> return false
    loop cp in decode_scalars(text) {
        if !is_digit_cp(cp) -> return false
    }
    true
}

pub fn is_whitespace(text: String) -> Bool Never! {
    if text.bytes().len() == 0 -> return false
    loop cp in decode_scalars(text) {
        if !is_space_cp(cp) -> return false
    }
    true
}

pub fn trim(text: String) -> String Never! { trim_end(trim_start(text)) }

pub fn trim_start(text: String) -> String Never! {
    pairs :: decode_indexed(text)
    i := 0
    loop i < pairs.len() {
        if !is_space_cp(pairs[i].cp) -> break
        i = i + 1
    }
    if i >= pairs.len() -> return ""
    slice_bytes(text.bytes(), pairs[i].index, text.bytes().len())
}

pub fn trim_end(text: String) -> String Never! {
    pairs :: decode_indexed(text)
    end := text.bytes().len()
    i := pairs.len() - 1
    loop i >= 0 {
        if !is_space_cp(pairs[i].cp) {
            end = pairs[i].index + utf8_width_at(text.bytes(), pairs[i].index)
            break
        }
        i = i - 1
    }
    slice_bytes(text.bytes(), 0, end)
}

/// Pad on the left until `width` UTF-8 scalars. Empty `fill` returns text unchanged.
pub fn pad_start(text: String, width: Int, fill: String) -> String Never! { pad_side(text, width, fill, true) }

pub fn pad_end(text: String, width: Int, fill: String) -> String Never! { pad_side(text, width, fill, false) }

pub fn center(text: String, width: Int, fill: String) -> String Never! {
    extra :: width - scalar_count(text)
    if extra <= 0 || scalar_count(fill) == 0 -> return ~text
    left :: extra /% 2
    pad_end(pad_start(text, scalar_count(text) + left, fill), width, fill)
}

pub fn starts_any(text: String, prefixes: [String]) -> Bool Never! {
    loop p in prefixes {
        if starts_with(text, p) -> return true
    }
    false
}

pub fn ends_any(text: String, suffixes: [String]) -> Bool Never! {
    loop s in suffixes {
        if ends_with(text, s) -> return true
    }
    false
}

/// At most `n` parts. `n <= 0` yields an empty list.
pub fn splitn(text: String, sep: String, n: Int) -> [String] Never! { split_limit(text, sep, n, false) }

pub fn rsplitn(text: String, sep: String, n: Int) -> [String] Never! { split_limit(text, sep, n, true) }

fn ascii_alpha(b: U8) -> Bool {
    n :: b
    (n >= 65 && n <= 90) || (n >= 97 && n <= 122)
}

fn ascii_space(b: U8) -> Bool {
    n :: b
    n == 32 || n == 9 || n == 10 || n == 11 || n == 12 || n == 13
}

fn ascii_lower(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n :: b
        if n >= 65 && n <= 90 {
            &out.push(U8{n + 32})
        } else {
            &out.push(b)
        }
    }
    String.from_bytes(out) ?? ""
}

fn ascii_upper(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n :: b
        if n >= 97 && n <= 122 {
            &out.push(U8{n - 32})
        } else {
            &out.push(b)
        }
    }
    String.from_bytes(out) ?? ""
}

fn slice_bytes(raw: [U8], start: Int, end: Int) -> String {
    out := [U8]{}
    lo := start
    hi := end
    if lo < 0 -> lo = 0
    if hi > raw.len() -> hi = raw.len()
    if hi < lo -> hi = lo
    i := lo
    loop {
        if i >= hi -> return String.from_bytes(out) ?? ""
        &out.push(raw[i])
        i = i + 1
    }
}

fn starts_with(text: String, prefix: String) -> Bool {
    a :: text.bytes()
    b :: prefix.bytes()
    if b.len() > a.len() -> return false
    loop i in 0..<b.len() {
        if a[i] != b[i] -> return false
    }
    true
}

fn ends_with(text: String, suffix: String) -> Bool {
    a :: text.bytes()
    b :: suffix.bytes()
    if b.len() > a.len() -> return false
    off :: a.len() - b.len()
    loop i in 0..<b.len() {
        if a[off + i] != b[i] -> return false
    }
    true
}

fn pad_side(text: String, width: Int, fill: String, left: Bool) -> String {
    extra :: width - scalar_count(text)
    units :: scalars(fill)
    if extra <= 0 || units.len() == 0 -> return ~text
    added := [String]{}
    i := 0
    loop added.len() < extra {
        &added.push(units[i])
        i = (i + 1) % units.len()
    }
    prefix := ""
    suffix := ""
    loop part in added {
        if left -> prefix = "{prefix}{part}" else -> suffix = "{suffix}{part}"
    }
    "{prefix}{text}{suffix}"
}

fn split_limit(text: String, sep: String, n: Int, from_right: Bool) -> [String] {
    if n <= 0 -> return [String]{}
    if n == 1 || sep.bytes().len() == 0 -> return [String]{text}
    parts := [String]{}
    rest := text
    loop {
        if parts.len() + 1 >= n {
            &parts.push(rest)
            return ~parts
        }
        at :: find_sep(rest, sep, from_right)
        if at < 0 {
            &parts.push(rest)
            return ~parts
        }
        if from_right {
            &parts.push(slice_bytes(rest.bytes(), at + sep.bytes().len(), rest.bytes().len()))
            rest = slice_bytes(rest.bytes(), 0, at)
        } else {
            &parts.push(slice_bytes(rest.bytes(), 0, at))
            rest = slice_bytes(rest.bytes(), at + sep.bytes().len(), rest.bytes().len())
        }
    }
}

fn find_sep(text: String, sep: String, from_right: Bool) -> Int {
    hay :: text.bytes()
    needle :: sep.bytes()
    if needle.len() == 0 || needle.len() > hay.len() -> return -1
    last :: hay.len() - needle.len()
    if from_right {
        i := last
        loop {
            if i < 0 -> return -1
            if match_at(hay, needle, i) -> return i
            i = i - 1
        }
    }
    loop i in 0..<(last + 1) {
        if match_at(hay, needle, i) -> return i
    }
    -1
}

fn match_at(hay: [U8], needle: [U8], start: Int) -> Bool {
    loop i in 0..<needle.len() {
        if hay[start + i] != needle[i] -> return false
    }
    true
}

pub struct IndexedCp {
    pub index: Int
    pub cp: Int
}

fn decode_scalars(text: String) -> [Int] Never! {
    pairs :: decode_indexed(text)
    out := [Int]{}
    loop p in pairs -> &out.push(p.cp)
    out
}

fn decode_indexed(text: String) -> [IndexedCp] Never! {
    raw :: text.bytes()
    out := [IndexedCp]{}
    i := 0
    loop {
        if i >= raw.len() -> return ~out
        start := i
        first := Int.from_u8(raw[i])
        width :: utf8_width_at(raw, i)
        if width == 1 {
            if first < 128 {
                &out.push(IndexedCp{index: start, cp: first})
            } else {
                &out.push(IndexedCp{index: start, cp: 65533})
            }
            i = i + 1
            next
        }
        cp := 0
        if width == 2 -> cp = first & 31
        if width == 3 -> cp = first & 15
        if width == 4 -> cp = first & 7
        valid := true
        k := 1
        loop k < width {
            byte := Int.from_u8(raw[i + k])
            if byte < 128 || byte >= 192 {
                valid = false
                break
            }
            cp = (cp << 6) | (byte & 63)
            k = k + 1
        }
        if !valid {
            &out.push(IndexedCp{index: start, cp: 65533})
            i = i + 1
            next
        }
        &out.push(IndexedCp{index: start, cp: cp})
        i = i + width
    }
}

fn utf8_width_at(raw: [U8], at: Int) -> Int Never! {
    if at < 0 || at >= raw.len() -> return 1
    first :: raw[at]
    if first < 128 -> return 1
    if first >= 194 && first <= 223 {
        if at + 1 < raw.len() {
            second :: raw[at + 1]
            if second >= 128 && second <= 191 -> return 2
        }
        return 1
    }
    if first >= 224 && first <= 239 {
        if at + 2 < raw.len() {
            second :: raw[at + 1]
            third :: raw[at + 2]
            if second >= 128 && second <= 191 && third >= 128 && third <= 191 {
                if first != 224 || second >= 160 {
                    if first != 237 || second <= 159 -> return 3
                }
            }
        }
        return 1
    }
    if first >= 240 && first <= 244 {
        if at + 3 < raw.len() {
            second :: raw[at + 1]
            third :: raw[at + 2]
            fourth :: raw[at + 3]
            if second >= 128 && second <= 191 && third >= 128 && third <= 191 && fourth >= 128 && fourth <= 191 {
                if first != 240 || second >= 144 {
                    if first != 244 || second <= 143 -> return 4
                }
            }
        }
    }
    1
}
fn encode_cp(cp: Int) -> String {
    out := [U8]{}
    append_cp(&out, cp)
    String.from_bytes(out) ?? ""
}

// Write into the caller's UTF-8 buffer: normalization allocates no per-scalar strings.
fn append_cp(out: &[U8], cp: Int) Never! {
    n := cp
    if n < 0 || n > 1114111 || (n >= 55296 && n <= 57343) -> n = 65533
    if n < 128 {
        &out.push(U8{n})
    } else if n < 2048 {
        &out.push(U8{Int{192} | (n >> 6)})
        &out.push(U8{Int{128} | (n & Int{63})})
    } else if n < 65536 {
        &out.push(U8{Int{224} | (n >> 12)})
        &out.push(U8{Int{128} | ((n >> 6) & Int{63})})
        &out.push(U8{Int{128} | (n & Int{63})})
    } else {
        &out.push(U8{Int{240} | (n >> 18)})
        &out.push(U8{Int{128} | ((n >> 12) & Int{63})})
        &out.push(U8{Int{128} | ((n >> 6) & Int{63})})
        &out.push(U8{Int{128} | (n & Int{63})})
    }
}

fn encode_cps(cps: [Int]) -> String { encode_cps_prefix(cps, cps.len()) }

fn encode_cps_prefix(cps: [Int], length: Int) -> String Never! {
    out := [U8]{}
    loop i in 0..<length -> append_cp(&out, cps[i])
    String.from_bytes(out) ?? ""
}

fn map_case(text: String, to_upper: Bool) -> String {
    out := ""
    loop cp in decode_scalars(text) -> out = "{out}{case_string(cp, to_upper)}"
    out
}

fn case_string(cp: Int, to_upper: Bool) -> String {
    if to_upper {
        if cp == 223 || cp == 7838 -> return "SS"
        if cp >= 97 && cp <= 122 -> return encode_cp(cp - 32)
        if cp >= 224 && cp <= 254 && cp != 247 -> return encode_cp(cp - 32)
        if cp == 255 -> return encode_cp(376)
        if cp >= 945 && cp <= 961 -> return encode_cp(cp - 32)
        if cp >= 963 && cp <= 969 -> return encode_cp(cp - 32)
        if cp >= 1072 && cp <= 1103 -> return encode_cp(cp - 32)
        return encode_cp(cp)
    }
    if cp >= 65 && cp <= 90 -> return encode_cp(cp + 32)
    if cp >= 192 && cp <= 222 && cp != 215 -> return encode_cp(cp + 32)
    if cp == 376 -> return encode_cp(255)
    if cp >= 913 && cp <= 929 -> return encode_cp(cp + 32)
    if cp >= 931 && cp <= 939 -> return encode_cp(cp + 32)
    if cp >= 1040 && cp <= 1071 -> return encode_cp(cp + 32)
    encode_cp(cp)
}

fn fold_case(text: String) -> String {
    out := ""
    loop cp in decode_scalars(text) {
        if cp == 223 || cp == 7838 {
            out = "{out}ss"
        } else if cp == 304 {
            out = "{out}i{encode_cp(775)}"
        } else if cp == 962 {
            out = "{out}{encode_cp(963)}"
        } else if cp == 8490 {
            out = "{out}k"
        } else if cp == 8491 {
            out = "{out}{encode_cp(229)}"
        } else {
            out = "{out}{case_string(cp, false)}"
        }
    }
    out
}

fn is_alpha_cp(cp: Int) -> Bool {
    if (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) -> return true
    if (cp >= 192 && cp <= 214) || (cp >= 216 && cp <= 246) || (cp >= 248 && cp <= 255) -> return true
    if cp >= 256 && cp <= 687 -> return true
    if cp >= 880 && cp <= 1023 -> return true
    if cp >= 1024 && cp <= 1279 -> return true
    if cp >= 1329 && cp <= 1366 -> return true
    if cp >= 1377 && cp <= 1415 -> return true
    if cp >= 1424 && cp <= 1469 -> return true
    if cp >= 1471 && cp <= 1471 -> return true
    if cp >= 1488 && cp <= 1514 -> return true
    if cp >= 1568 && cp <= 1747 -> return true
    if cp >= 1810 && cp <= 1866 -> return true
    if cp >= 1994 && cp <= 2026 -> return true
    if cp >= 2304 && cp <= 2423 -> return true
    if cp >= 2437 && cp <= 2444 -> return true
    if cp >= 2561 && cp <= 2576 -> return true
    if cp >= 3585 && cp <= 3632 -> return true
    if cp >= 4256 && cp <= 4293 -> return true
    if cp >= 4304 && cp <= 4346 -> return true
    if cp >= 4352 && cp <= 4607 -> return true
    if cp >= 7680 && cp <= 7935 -> return true
    if cp >= 7936 && cp <= 8191 -> return true
    if cp >= 8448 && cp <= 8521 -> return true
    if cp >= 11264 && cp <= 11310 -> return true
    if cp >= 11312 && cp <= 11358 -> return true
    if cp >= 19968 && cp <= 40959 -> return true
    if cp >= 44032 && cp <= 55203 -> return true
    if cp >= 65313 && cp <= 65338 -> return true
    if cp >= 65345 && cp <= 65370 -> return true
    if cp >= 66560 && cp <= 66639 -> return true
    false
}

fn is_digit_cp(cp: Int) -> Bool {
    if cp >= 48 && cp <= 57 -> return true
    if cp >= 1632 && cp <= 1641 -> return true
    if cp >= 1776 && cp <= 1785 -> return true
    if cp >= 1984 && cp <= 1993 -> return true
    if cp >= 2406 && cp <= 2415 -> return true
    if cp >= 2534 && cp <= 2543 -> return true
    if cp >= 2662 && cp <= 2671 -> return true
    if cp >= 2790 && cp <= 2799 -> return true
    if cp >= 2918 && cp <= 2927 -> return true
    if cp >= 3046 && cp <= 3055 -> return true
    if cp >= 3174 && cp <= 3183 -> return true
    if cp >= 3302 && cp <= 3311 -> return true
    if cp >= 3430 && cp <= 3439 -> return true
    if cp >= 3558 && cp <= 3567 -> return true
    if cp >= 3664 && cp <= 3673 -> return true
    if cp >= 3792 && cp <= 3801 -> return true
    if cp >= 3872 && cp <= 3881 -> return true
    if cp >= 4160 && cp <= 4169 -> return true
    if cp >= 4240 && cp <= 4249 -> return true
    if cp >= 6112 && cp <= 6121 -> return true
    if cp >= 6470 && cp <= 6479 -> return true
    if cp >= 65296 && cp <= 65305 -> return true
    false
}

fn is_space_cp(cp: Int) -> Bool {
    if cp >= 9 && cp <= 13 -> return true
    if cp == 32 || cp == 133 || cp == 160 -> return true
    if cp == 5760 || cp == 8239 || cp == 8287 || cp == 12288 -> return true
    if cp >= 8192 && cp <= 8202 -> return true
    if cp == 8232 || cp == 8233 -> return true
    false
}

fn combining_class(cp: Int) -> Int {
    if cp >= 768 && cp <= 879 -> return 230
    if cp >= 7616 && cp <= 7679 -> return 230
    if cp >= 8400 && cp <= 8432 -> return 230
    if cp >= 65056 && cp <= 65071 -> return 230
    0
}

fn is_extend(cp: Int) -> Bool { combining_class(cp) != 0 || (cp >= 0xFE00 && cp <= 0xFE0F) || (cp >= 0x1F3FB && cp <= 0x1F3FF) || cp == 0x200C || cp == 0x200D || cp == 0xFF9E || cp == 0xFF9F }

C_SBASE :: 44032
C_LBASE :: 4352
C_VBASE :: 4449
C_TBASE :: 4519
C_LCOUNT :: 19
C_VCOUNT :: 21
C_TCOUNT :: 28
C_NCOUNT :: 588
C_SCOUNT :: 11172


fn hangul_compose(a: Int, b: Int) -> Int? {
    lindex :: a - C_LBASE
    if lindex >= 0 && lindex < C_LCOUNT {
        vindex :: b - C_VBASE
        if vindex >= 0 && vindex < C_VCOUNT -> return Val(C_SBASE + (lindex * C_VCOUNT + vindex) * C_TCOUNT)
    }
    sindex :: a - C_SBASE
    if sindex >= 0 && sindex < C_SCOUNT && sindex % C_TCOUNT == 0 {
        tindex :: b - C_TBASE
        if tindex > 0 && tindex < C_TCOUNT -> return Val(a + tindex)
    }
    None
}

// Rust `nfc` / `canonical_decompose` (BudgetStore.rs:1259-1325);
// compatibility uses the same jet_unicode decomposition index, including tagged rows.
fn normalize(text: String, compat: Bool, recompose: Bool) -> String Never! {
    bytes :: text.bytes()
    non_ascii := false
    loop byte in bytes { if byte >= (U8{128}) { non_ascii = true; break } }
    if !non_ascii -> return ~text
    // #4318: capture static-list values once, not at each lookup/recursive child;
    // current bootstrap constant emission copies a list at each mention.
    index :: C_NORMAL_DECOMP_INDEX
    pool :: C_NORMAL_DECOMP_POOL
    ccc :: C_NORMAL_CCC
    out := [Int]{}
    at := 0
    loop at < bytes.len() {
        width :: utf8_width_at(bytes, at)
        cp := Int.from_u8(bytes[at])
        if width == 2 -> cp = cp & 31
        if width == 3 -> cp = cp & 15
        if width == 4 -> cp = cp & 7
        loop k in 1..<width -> cp = (cp << 6) | (Int.from_u8(bytes[at + k]) & 63)
        decompose_cp(&out, cp, compat, index, pool)
        at = at + width
    }
    canon_order(&out, ccc)
    if recompose {
        pairs :: C_NORMAL_COMPOSE
        return compose(&out, ccc, pairs)
    }
    encode_cps(out)
}

// Recursive expansion appends to one buffer, including algorithmic Hangul LV/LVT.
fn decompose_cp(out: &[Int], cp: Int, compat: Bool, index: [U8], pool: [U8]) Never! {
    sindex :: cp - C_SBASE
    if sindex >= 0 && sindex < C_SCOUNT {
        &out.push(C_LBASE + sindex /% C_NCOUNT)
        &out.push(C_VBASE + (sindex % C_NCOUNT) /% C_TCOUNT)
        if sindex % C_TCOUNT != 0 -> &out.push(C_TBASE + sindex % C_TCOUNT)
        return
    }
    low := 0
    high := index.len() /% 7
    loop low < high {
        mid :: (low + high) /% 2
        row :: mid * 7
        code :: normal_u21(index, row)
        if {
            cp < code -> high = mid
            cp > code -> low = mid + 1
            else -> {
                if compat || index[row + 6] == (U8{1}) {
                    offset :: Int.from_u8(index[row + 3]) * 256 + Int.from_u8(index[row + 4])
                    length :: Int.from_u8(index[row + 5])
                    loop child in offset..<(offset + length) {
                        decompose_cp(&out, normal_u21(pool, child * 3), compat, index, pool)
                    }
                    return
                }
