use jet_foundation.generated.UnicodeData.[UNICODE_CCC, UNICODE_DECOMP_INDEX, UNICODE_DECOMP_POOL, UNICODE_COMPOSE_PAIRS]

// Rust: crates/jet-pkg-model/src/Prelude/VaultNfc.rs:1
VAULT_HANGUL_SBASE :: U32{0xAC00}
// Rust: crates/jet-pkg-model/src/Prelude/VaultNfc.rs:2
VAULT_HANGUL_LBASE :: U32{0x1100}
// Rust: crates/jet-pkg-model/src/Prelude/VaultNfc.rs:3
VAULT_HANGUL_VBASE :: U32{0x1161}
// Rust: crates/jet-pkg-model/src/Prelude/VaultNfc.rs:4
VAULT_HANGUL_TBASE :: U32{0x11A7}
// Rust: crates/jet-pkg-model/src/Prelude/VaultNfc.rs:5
VAULT_HANGUL_LCOUNT :: U32{19}
// Rust: crates/jet-pkg-model/src/Prelude/VaultNfc.rs:6
VAULT_HANGUL_VCOUNT :: U32{21}
// Rust: crates/jet-pkg-model/src/Prelude/VaultNfc.rs:7
VAULT_HANGUL_TCOUNT :: U32{28}
// Rust: crates/jet-pkg-model/src/Prelude/VaultNfc.rs:8
VAULT_HANGUL_NCOUNT :: VAULT_HANGUL_VCOUNT * VAULT_HANGUL_TCOUNT
// Rust: crates/jet-pkg-model/src/Prelude/VaultNfc.rs:9
VAULT_HANGUL_SCOUNT :: VAULT_HANGUL_LCOUNT * VAULT_HANGUL_NCOUNT

// Rust: crates/jet-pkg-model/src/Prelude/VaultNfc.rs:11
fn jet_vault_ccc(cp: U32) -> U8 {
    index :: UNICODE_CCC.binary_search_by(|row| -> {
        if cp < row.0 { .Greater } else if cp > row.1 { .Less } else { .Equal }
    }).ok()
    index.map(|i| -> UNICODE_CCC[i].2).unwrap_or(U8{0})
}
// Rust: crates/jet-pkg-model/src/Prelude/VaultNfc.rs:26
fn jet_vault_hangul_decompose(cp: U32) -> ([U32#3])? {
    if cp < VAULT_HANGUL_SBASE or cp >= VAULT_HANGUL_SBASE + VAULT_HANGUL_SCOUNT -> return None
    index :: cp - VAULT_HANGUL_SBASE
    trailing :: index % VAULT_HANGUL_TCOUNT
    Val([VAULT_HANGUL_LBASE + index / VAULT_HANGUL_NCOUNT,
         VAULT_HANGUL_VBASE + (index % VAULT_HANGUL_NCOUNT) / VAULT_HANGUL_TCOUNT,
         if trailing == U32{0} { U32{0} } else { VAULT_HANGUL_TBASE + trailing }])
}
// Rust: crates/jet-pkg-model/src/Prelude/VaultNfc.rs:39
fn jet_vault_decomposition(cp: U32) -> ([U32]View)? {
    index :: UNICODE_DECOMP_INDEX.binary_search_by_key(cp, |row| -> row.0).ok()?
    (_, start, len, canonical) :: UNICODE_DECOMP_INDEX[index]
    if canonical == U8{0} -> return None
    Val(UNICODE_DECOMP_POOL[USize{start}..USize{start + len}])
}
// Rust: crates/jet-pkg-model/src/Prelude/VaultNfc.rs:50
fn jet_vault_decompose(cp: U32, output: &[U32]) -> {
    if jet_vault_hangul_decompose(cp) is Val(parts) {
        &output.push(parts[0])
        &output.push(parts[1])
        if parts[2] != U32{0} { &output.push(parts[2]) }
    } else if jet_vault_decomposition(cp) is Val(decomposition) {
        loop part in decomposition { jet_vault_decompose(part, &output) }
    } else { &output.push(cp) }
}
// Rust: crates/jet-pkg-model/src/Prelude/VaultNfc.rs:66
fn jet_vault_compose_pair(first: U32, second: U32) -> U32? {
    if first >= VAULT_HANGUL_LBASE and first < VAULT_HANGUL_LBASE + VAULT_HANGUL_LCOUNT
        and second >= VAULT_HANGUL_VBASE and second < VAULT_HANGUL_VBASE + VAULT_HANGUL_VCOUNT {
        return Val(VAULT_HANGUL_SBASE + ((first - VAULT_HANGUL_LBASE) * VAULT_HANGUL_VCOUNT + second - VAULT_HANGUL_VBASE) * VAULT_HANGUL_TCOUNT)
    }
    if first >= VAULT_HANGUL_SBASE and first < VAULT_HANGUL_SBASE + VAULT_HANGUL_SCOUNT
        and (first - VAULT_HANGUL_SBASE) % VAULT_HANGUL_TCOUNT == U32{0}
        and second > VAULT_HANGUL_TBASE and second < VAULT_HANGUL_TBASE + VAULT_HANGUL_TCOUNT {
        return Val(first + second - VAULT_HANGUL_TBASE)
    }
    UNICODE_COMPOSE_PAIRS.binary_search_by(|row| -> (row.0, row.1).cmp((first, second))).ok().map(|i| -> UNICODE_COMPOSE_PAIRS[i].2)
}
// Rust: crates/jet-pkg-model/src/Prelude/VaultNfc.rs:91
pub fn jet_vault_nfc(input: String) -> String {
    decomposed := [U32]{}.with_capacity(input.len())
    loop character in input.chars() { jet_vault_decompose(U32{character}, &decomposed) }
    loop index in 1..<decomposed.len() {
        class :: jet_vault_ccc(decomposed[index])
        if class == U8{0} -> continue
        cursor := index
        loop cursor > 0 and jet_vault_ccc(decomposed[cursor - 1]) > class {
            &decomposed.swap(cursor - 1, cursor)
            cursor -= 1
        }
    }
    composed := [U32]{}.with_capacity(decomposed.len())
    starter := None as Int?
    last_class := I32{-1}
    loop codepoint in decomposed {
        class :: I32{jet_vault_ccc(codepoint)}
        if starter is Val(starter_index) {
            if jet_vault_compose_pair(composed[starter_index], codepoint) is Val(result) {
                if last_class < class { composed[starter_index] = result; continue }
            }
        }
        &composed.push(codepoint)
        if class == I32{0} { starter = Val(composed.len() - 1); last_class = I32{-1} }
        else { last_class = class }
    }
    composed.into_iter().filter_map(|cp| -> Char.from_u32(cp)).collect()
}
