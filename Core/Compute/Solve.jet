// core.compute.solve — checked CPU linear solvers over core.compute tensors.
//
// The solver owns a real LU factorization with partial pivoting.  It never
// returns an opaque success marker: malformed, non-square, non-finite, and
// singular systems are reported through ComputeError.
use {
    math: core.math
    core: core
    core.compute.[Tensor, ComputeError]
    compute: core.compute
}

// The finite constraint counter is separate from the tensor LU solver.
// This is the exact three-field Solver kernel formerly owned by the Prelude.
Solver: struct {
    seed: Int
    checked: Int
    failures: Int
}

impl Solver {
    new: fn(seed: Int) -> Solver Never! {
        Solver{seed: seed, checked: 0, failures: 0}
    }

    require: fn(&self, ok: Bool) Never! {
        self.checked += 1
        if !ok -> self.failures += 1
    }

    failure_count: fn(self) -> Int Never! { self.failures }

    status: fn(self) -> String Never! {
        if self.failures == 0 -> return "ok"
        "failed"
    }

    __show: fn(self) -> String Never! {
        "Solver {{ seed: {self.seed}, checked: {self.checked}, failures: {self.failures} }}"
    }

    __debug: fn(self) -> String Never! { self.__show() }
}

#Test("finite Solver retains seed and counts every checked requirement") {
    solver := Solver.new(-17)
    assert_eq(solver.seed, -17)
    assert_eq(solver.checked, 0)
    assert_eq(solver.failure_count(), 0)
    assert_eq(solver.status(), "ok")
    solver.require(true)
    solver.require(false)
    solver.require(false)
    assert_eq(solver.checked, 3)
    assert_eq(solver.failure_count(), 2)
    assert_eq(solver.status(), "failed")
    copied := solver.copy()
    copied.require(false)
    assert_eq(solver.failure_count(), 2)
    assert_eq(copied.failure_count(), 3)
    assert_eq(solver.__show(), "Solver {{ seed: -17, checked: 3, failures: 2 }}")
    assert_eq("{solver}", "Solver {{ seed: -17, checked: 3, failures: 2 }}")
    assert_eq("{solver:Debug}", "Solver {{ seed: -17, checked: 3, failures: 2 }}")
    assert_eq("{[solver]}", "[Solver {{ seed: -17, checked: 3, failures: 2 }}]")
    assert_eq("{[solver]:Debug}", "[Solver {{ seed: -17, checked: 3, failures: 2 }}]")
}

LinearSolver: struct {
    kind: String
    dimension: Int
    factors: [Float]
    pivots: [Int]
    device: String
}

// LU with partial pivoting and the scale-relative singular test of
// `factorize`, then forward and back substitution per right-hand column.
// The solution is built through `from_list`/`reshape` in b's shape.
dense: fn(a: Tensor, b: Tensor) -> Tensor ComputeError! {
    shape: compute.shape(a)
    data: compute.to_list(a)
    profile: tensor_profile(a)
    validate_matrix(shape, data, profile)
    rhs_shape: compute.shape(b)
    rhs: compute.to_list(b)
    validate_rhs(rhs_shape, rhs, tensor_profile(b))
    device: compute.device(a)
    if device != compute.device(b) -> return Err(ComputeError.Device)
    if device != "CPU" -> return Err(ComputeError.Unsupported)
    if tensor_profile(b) != profile -> return Err(ComputeError.Device)
    n: shape[0]
    if rhs_shape[0] != n -> return Err(ComputeError.Shape)
    rhs_cols := 1
    if rhs_shape.len() == 2 -> rhs_cols = rhs_shape[1]
    factors: factorize(data, n, profile)
    solution: solve_factors(factors, n, rhs, rhs_cols, profile)
    flat: compute.from_list(solution)
    compute.reshape(flat, rhs_shape)
}

lu: fn(a: Tensor) -> LinearSolver ComputeError! {
    shape: compute.shape(a)
    data: compute.to_list(a)
    profile: tensor_profile(a)
    validate_matrix(shape, data, profile)
    device: compute.device(a)
    if device != "CPU" -> return Err(ComputeError.Unsupported)
    n: shape[0]
    factors: factorize(data, n, profile)
    Ok(LinearSolver{kind: "lu", dimension: n, factors: factors.factors, pivots: factors.pivots, device: device})
}

Factorization: struct {
    factors: [Float]
    pivots: [Int]
    pivot_threshold: Float
}


C_MAX_ELEMENTS: 16777216

validate_matrix: fn(shape: [Int], data: [Float], profile: String) ComputeError! {
    if shape.len() != 2 -> return Err(ComputeError.RankMismatch)
    if shape[0] != shape[1] -> return Err(ComputeError.Shape)
    if shape[0] < 0 || shape[1] < 0 -> return Err(ComputeError.Shape)
    expected: checked_numel(shape)
    if expected != data.len() -> return Err(ComputeError.Shape)
    if profile != "F64Strict+Reproducible" && profile != "F32Strict+Reproducible" {
        return Err(ComputeError.Serialization)
    }
    loop value in data {
        if !math_is_finite(value) -> return Err(ComputeError.Arithmetic)
        if profile == "F32Strict+Reproducible" {
            representable: f32_representable(value)
            if !representable -> return Err(ComputeError.Arithmetic)
        }
    }
    return
}

validate_rhs: fn(shape: [Int], data: [Float], profile: String) ComputeError! {
    if shape.len() != 1 && shape.len() != 2 -> return Err(ComputeError.RankMismatch)
    expected: checked_numel(shape)
    if expected != data.len() -> return Err(ComputeError.Shape)
    if profile != "F64Strict+Reproducible" && profile != "F32Strict+Reproducible" {
        return Err(ComputeError.Serialization)
    }
    loop value in data {
        if !math_is_finite(value) -> return Err(ComputeError.Arithmetic)
        if profile == "F32Strict+Reproducible" {
            representable: f32_representable(value)
            if !representable -> return Err(ComputeError.Arithmetic)
        }
    }
    return
}


checked_numel: fn(shape: [Int]) -> Int ComputeError! {
    if shape.len() == 0 -> return Err(ComputeError.Shape)
    n := 1
    loop dim in shape {
        if dim < 0 || dim > C_MAX_ELEMENTS -> return Err(ComputeError.Shape)
        if dim == 0 {
            n = 0
            next
        }
        if n > C_MAX_ELEMENTS /% dim -> return Err(ComputeError.Shape)
        n = n * dim
    }
    Ok(n)
}

factorize: fn(input: &&[Float], n: Int, profile: String) -> Factorization ComputeError! {
    factors := input
    pivots := [Int]{}
    matrix_scale := Float{0.0}
    loop value in factors {
        magnitude: abs_f(value)
        if magnitude > matrix_scale -> matrix_scale = magnitude
    }
    pivot_tolerance: Float{0.000000000000001}
    pivot_threshold: profile_round(matrix_scale * pivot_tolerance, profile) ?? return Err(ComputeError.Arithmetic)
    loop k in 0..<n {
        pivot := k
        best := abs_f(factors[k * n + k])
        loop i in (k + 1)..<n {
            value: abs_f(factors[i * n + k])
            if value > best {
                best = value
                pivot = i
            }
        }
        if best <= pivot_threshold -> return Err(ComputeError.Singular)
        pivots.push(pivot)
        if pivot != k {
            loop j in 0..<n {
                tmp := factors[k * n + j]
                factors[k * n + j] = factors[pivot * n + j]
                factors[pivot * n + j] = tmp
            }
        }
        loop i in (k + 1)..<n {
            multiplier: profile_round(factors[i * n + k] / factors[k * n + k], profile) ?? return Err(ComputeError.Arithmetic)
            factors[i * n + k] = multiplier
            loop j in (k + 1)..<n {
                value: profile_round(factors[i * n + j] - multiplier * factors[k * n + j], profile) ?? return Err(ComputeError.Arithmetic)
                factors[i * n + j] = value
            }
        }
    }
    Ok(Factorization{factors: factors, pivots: pivots, pivot_threshold: pivot_threshold})
}

// Apply the factorization's row swaps to the right-hand side, solve L*y = P*b
// with L's unit diagonal, then U*x = y.
solve_factors: fn(factors: Factorization, n: Int, rhs: [Float], rhs_cols: Int, profile: String) -> [Float] ComputeError! {
    work := rhs.copy()
    loop k in 0..<factors.pivots.len() {
        pivot: factors.pivots[k]
        if pivot != k {
            loop j in 0..<rhs_cols {
                tmp := work[k * rhs_cols + j]
                work[k * rhs_cols + j] = work[pivot * rhs_cols + j]
                work[pivot * rhs_cols + j] = tmp
            }
        }
    }
    loop i in 0..<n {
        loop j in 0..<rhs_cols {
            value := work[i * rhs_cols + j]
            loop k in 0..<i {
                value = profile_round(value - factors.factors[i * n + k] * work[k * rhs_cols + j], profile) ?? return Err(ComputeError.Arithmetic)
            }
            work[i * rhs_cols + j] = value
        }
    }
    i := n
    loop i > 0 {
        i = i - 1
        diagonal: factors.factors[i * n + i]
        if abs_f(diagonal) <= factors.pivot_threshold -> return Err(ComputeError.Singular)
        loop j in 0..<rhs_cols {
            value := work[i * rhs_cols + j]
            loop k in (i + 1)..<n {
                value = profile_round(value - factors.factors[i * n + k] * work[k * rhs_cols + j], profile) ?? return Err(ComputeError.Arithmetic)
            }
            value = profile_round(value / diagonal, profile) ?? return Err(ComputeError.Arithmetic)
            work[i * rhs_cols + j] = value
        }
    }
    work
}


tensor_profile: fn(tensor: Tensor) -> String ComputeError! {
    receipt: compute.placement(tensor)
    if receipt.contains("profile=F32Strict+Reproducible,") -> return "F32Strict+Reproducible"
    if receipt.contains("profile=F64Strict+Reproducible,") -> return "F64Strict+Reproducible"
    Err(ComputeError.Serialization)
}


f32_round_value: fn(value: Float) -> Float ComputeError! {
    if value == (Float{0.0}) -> return value
    negative := value < Float{0.0}
    magnitude := value
    if negative -> magnitude = Float{0.0} - value
    parts: math.frexp(magnitude) ?? return Err(ComputeError.Arithmetic)
    exponent := parts.exp - 1
    scale := 23 - exponent
    if exponent < -126 -> scale = 149
    scaled: math.ldexp(magnitude, scale) ?? return Err(ComputeError.Arithmetic)
    lower: math.floor(scaled) ?? return Err(ComputeError.Arithmetic)
    fraction := scaled - lower
    rounded := lower
    round_up := fraction > (Float{0.5})
    if fraction == (Float{0.5}) {
        remainder: math.fmod(lower, (Float{2.0})) ?? return Err(ComputeError.Arithmetic)
        if remainder != (Float{0.0}) -> round_up = true
    }
    if round_up -> rounded = rounded + Float{1.0}
    result: math.ldexp(rounded, 0 - scale) ?? return Err(ComputeError.Arithmetic)
    if negative -> return Float{0.0} - result
    result
}

f32_range_ok: fn(value: Float) -> Bool Never! {
    if !math_is_finite(value) -> return false
    abs_f(value) <= 3.4028234663852886e38
}

f32_representable: fn(value: Float) -> Bool ComputeError! {
    if !f32_range_ok(value) -> return false
    rounded: f32_round_value(value)
    rounded == value
}



abs_f: fn(value: Float) -> Float Never! {
    if value < 0.0 -> return 0.0 - value
    value
}

math_is_finite: fn(value: Float) -> Bool Never! { core.math.isfinite(value) ?? panic("finite check failed") }

profile_round: fn(value: Float, profile: String) -> Float ComputeError! {
    if !math_is_finite(value) -> return Err(ComputeError.Arithmetic)
    if profile == "F32Strict+Reproducible" {
        if !f32_range_ok(value) -> return Err(ComputeError.Arithmetic)
        return f32_round_value(value)
    }
    value
}
