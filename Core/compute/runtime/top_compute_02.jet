// CUDA continuation: these items retain the canonical jet_compute_cuda owner.
impl Buffer {
    fn copy_from<T>(self: &Self, context: &Context, value: &T) -> Result<(), JetComputeError> {
        bytes :: mem.size_of<T>()
        context.make_current()?
        // GATE #4565: kernel primitive
        check(#Unsafe("current CUDA context owns device buffer; borrow parameter bytes only for synchronous transfer") {
            (self.api.memcpy_htod)(self.raw, (value as *const T).cast<c_void>(), bytes)
        }, "parameter transfer")
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:1810
    fn copy_to_f32(self: &Self, context: &Context, values: &[F32]) -> Result<(), JetComputeError> {
        bytes :: values.len().checked_mul(mem.size_of<F32>())
            .ok_or_else(fn() { JetComputeError.InvalidShape("CUDA output size overflow") })?
        context.make_current()?
        // GATE #4565: kernel primitive
        check(#Unsafe("exclusive output slice remains live until synchronous device-to-host transfer completes") {
            (self.api.memcpy_dtoh)(values.as_mut_ptr().cast<c_void>(), self.raw, bytes)
        }, "device-to-host transfer")
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:1828
    fn raw(self: &Self) -> CuDevicePtr { self.raw }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:1833
impl Drop for Buffer {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:1834
    fn drop(self: &Self) -> {
        // GATE #4565: kernel primitive
        #Unsafe("release the CUDA device allocation exactly once through its retained driver API") {
            _ :: (self.api.mem_free)(self.raw)
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:1841
fn u32_value(value: USize, label: &String) -> Result<U32, JetComputeError> {
    U32.try_from(value).map_err(fn(_) {
        JetComputeError.InvalidShape("CUDA {label} exceeds the u32 kernel limit")
    })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:1847
fn run(function_name: &String, inputs: [&[F32]], output_len: USize, params: Params) -> Result<[F32], JetComputeError> {
    if target.selected_os() != .Linux -> return unavailable()
    if output_len == 0 -> return Ok([])
    api :: Api.load()?
    context :: Context.new(api.clone())?
    module :: Module.load(&context)?
    function :: module.function(function_name)?
    input_buffers :: inputs.iter().map(fn(values) { Buffer.from_f32(&context, values) })
        .collect<Result<[Buffer], JetComputeError>>()?
    output :: Buffer.new(&context, output_len.checked_mul(mem.size_of<F32>())
        .ok_or_else(fn() { JetComputeError.InvalidShape("CUDA output size overflow") })?)?
    parameter :: Buffer.new(&context, mem.size_of<Params>())?
    parameter.copy_from(&context, &params)?
    argument_values := input_buffers.iter().map(fn(buffer) { buffer.raw() }).collect<[CuDevicePtr]>()
    argument_values.push(output.raw())
    argument_values.push(parameter.raw())
    grid :: output_len.checked_add(BLOCK_SIZE - 1)
        .and_then(fn(value) { value.checked_div(BLOCK_SIZE) })
        .and_then(fn(value) { U32.try_from(value).ok() })
        .ok_or_else(fn() { JetComputeError.InvalidShape("CUDA launch grid is too large") })?
    // GATE #4565: kernel primitive
    #Unsafe("argument word storage, buffers, module and context remain live until launched kernel synchronizes") {
        arguments := argument_values.iter_mut().map(fn(value) { (value as *mut U64).cast<c_void>() }).collect()
        check((api.launch_kernel)(function, grid, 1, 1, BLOCK_SIZE as U32, 1, 1, 0,
            ptr.null_mut(), arguments.as_mut_ptr(), ptr.null_mut()), "kernel launch")?
    }
    context.synchronize()?
    values := [F32].repeat(F32{0.0}, output_len)
    output.copy_to_f32(&context, &values)?
    if values.iter().any(fn(value) { not value.is_finite() }) {
        return Err(JetComputeError.Arithmetic("CUDA kernel produced a non-finite F32 value"))
    }
    Ok(^values)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:1916
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:2182
pub fn available() -> Bool {
    if target.selected_os() != .Linux -> return false
    api :: match Api.load() { Ok(api) -> ^api, Err(_) -> return false }
    count := 0
    // GATE #4565: kernel primitive
    #Unsafe("availability reflects successful native device enumeration, never a CPU fallback") {
        (api.device_get_count)(&count) == CUDA_SUCCESS && count > 0
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:1924
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:2183
pub fn copy(values: &[F32]) -> Result<[F32], JetComputeError> {
    if target.selected_os() != .Linux -> return unavailable()
    run("jet_copy", [values], values.len(), Params{
        count: u32_value(values.len(), "copy count")?, rows: 0, inner: 0, cols: 0, op: 0, scalar: 0.0})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:1940
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:2184
pub fn binary(op: U32, left: &[F32], right: &[F32]) -> Result<[F32], JetComputeError> {
    if target.selected_os() != .Linux -> return unavailable()
    if left.len() != right.len() {
        return Err(JetComputeError.InvalidShape("CUDA binary inputs have different lengths"))
    }
    run("jet_binary", [left, right], left.len(), Params{
        count: u32_value(left.len(), "binary count")?, rows: 0, inner: 0, cols: 0, op: op, scalar: 0.0})
}
