// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:2193
pub fn stream_new() -> Result<StreamHandle, JetComputeError> {
    if target.selected_os() != .Linux -> return unavailable()
    api :: Api.load()?
    context :: Context.new(^api)?
    // GATE #4565: kernel primitive
    #Unsafe("native CUDA stream is owned with its creating context, and no handle escapes failed creation") {
        stream := ptr.null_mut()
        check((context.api.stream_create)(&stream, 0), "stream creation")?
        Ok(StreamHandle{context: ^context, stream: stream})
    }
}
