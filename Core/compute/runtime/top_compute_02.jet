// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:1977
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:2186
pub fn matmul(left: &[F32], right: &[F32], rows: USize, inner: USize, cols: USize) -> Result<[F32], JetComputeError> {
    if target.selected_os() != .Linux -> return unavailable()
    count :: rows.checked_mul(cols).ok_or_else(fn() { JetComputeError.InvalidShape("CUDA matmul output size overflow") })?
    run("jet_matmul", [left, right], count, Params{
        count: u32_value(count, "matmul output")?, rows: u32_value(rows, "matmul rows")?,
        inner: u32_value(inner, "matmul inner dimension")?, cols: u32_value(cols, "matmul columns")?, op: 0, scalar: 0.0})
}
