impl Drop for StreamHandle {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:2161
    fn drop(self: &Self) -> {
        // GATE #4565: kernel primitive
        #Unsafe("stream only exists after selected Linux creation, destroy exactly once before context release") {
            _ :: (self.context.api.stream_destroy)(self.stream)
        }
    }
}
