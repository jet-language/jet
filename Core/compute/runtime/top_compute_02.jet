// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:2194
pub fn stream_sync(stream: &StreamHandle) -> Result<(), JetComputeError> {
    if target.selected_os() != .Linux -> return unavailable()
    stream.context.make_current()?
    // GATE #4565: kernel primitive
    check(#Unsafe("synchronize the retained CUDA stream in its owning current context") {
        (stream.context.api.stream_synchronize)(stream.stream)
    }, "stream synchronization")
}
