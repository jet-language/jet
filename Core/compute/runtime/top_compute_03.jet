// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:4927
fn jet_compute_row_major_strides(shape: &[I64]) -> [I64] JetComputeError! {
    if shape.is_empty() -> return Err(JetComputeError.InvalidShape("Tensor shape must have at least one axis"))
    if shape.iter().any(fn(d) { *d < 0 }) -> return Err(JetComputeError.InvalidShape("Tensor shape axes must be non-negative"))
    if shape.iter().any(fn(d) { *d > I64.try_from(MAX_TENSOR_ELEMENTS).unwrap_or(I64.MAX) }) {
        return Err(JetComputeError.InvalidShape("Tensor shape axis exceeds the Core storage limit"))
    }
    strides := [I64].repeat(1, shape.len())
    loop i in (0..<shape.len().saturating_sub(1)).rev() {
        next :: shape[i + 1].checked_mul(strides[i + 1]).ok_or_else(fn() { JetComputeError.InvalidShape("Tensor stride overflow") })?
        strides[i] = next
    }
    ^strides
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:4956
fn jet_compute_numel(shape: &[I64]) -> I64 JetComputeError! {
    n := I64{1}
    loop d in shape {
        if *d < 0 -> return Err(JetComputeError.InvalidShape("Tensor shape axes must be non-negative"))
        n = n.checked_mul(*d).ok_or_else(fn() { JetComputeError.InvalidShape("Tensor numel overflow") })?
    }
    n
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:4971
fn jet_compute_storage_len(shape: &[I64]) -> USize JetComputeError! {
    // Validate all axes even when a preceding zero makes numel zero.
    _ :: jet_compute_row_major_strides(shape)?
    n :: jet_compute_numel(shape)?
    len :: USize.try_from(n).map_err(fn(_) { JetComputeError.InvalidShape("Tensor storage length is too large") })?
    if len > MAX_TENSOR_ELEMENTS -> return Err(JetComputeError.InvalidShape("Tensor storage exceeds the {MAX_TENSOR_ELEMENTS}-element Core limit"))
    len
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:4989
fn jet_compute_view_metadata(tensor: &JetTensor) -> (&[I64], USize) JetComputeError! {
    rank :: tensor.shape.len()
    if tensor.strides.len() == rank -> return (&tensor.strides, 0)
    if rank.checked_add(1) != Val(tensor.strides.len()) -> return Err(JetComputeError.InvalidShape("Tensor stride and view metadata disagree"))
    offset :: USize.try_from(tensor.strides[rank]).map_err(fn(_) { JetComputeError.InvalidShape("Tensor view offset must be non-negative") })?
    (&tensor.strides[..rank], offset)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5007
fn jet_compute_view_strides(shape: &[I64], offset: USize) -> [I64] JetComputeError! {
    strides := jet_compute_row_major_strides(shape)?
    if offset != 0 {
        strides.push(I64.try_from(offset).map_err(fn(_) { JetComputeError.InvalidShape("Tensor view offset is too large") })?)
    }
    ^strides
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5020
fn jet_compute_view_storage_end(tensor: &JetTensor, strides: &[I64], offset: USize) -> USize JetComputeError! {
    relative_end := USize{0}
    loop (dim, stride) in tensor.shape.iter().zip(strides.iter()) {
        if *dim == 0 -> continue
        dim :: USize.try_from(*dim).map_err(fn(_) { JetComputeError.InvalidShape("Tensor shape axis is too large") })?
        stride :: USize.try_from(*stride).map_err(fn(_) { JetComputeError.InvalidShape("Tensor view strides must be non-negative and representable") })?
        extent :: dim.checked_sub(1).and_then(fn(last) { last.checked_mul(stride) })
            .ok_or_else(fn() { JetComputeError.InvalidShape("Tensor view extent overflows backing storage") })?
        relative_end = relative_end.checked_add(extent).ok_or_else(fn() { JetComputeError.InvalidShape("Tensor view extent overflows backing storage") })?
    }
    offset.checked_add(relative_end).and_then(fn(end) { end.checked_add(1) })
        .ok_or_else(fn() { JetComputeError.InvalidShape("Tensor view end overflows backing storage") })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5050
fn jet_compute_visit_tensor_values(tensor: &JetTensor, visit: fn(F64) -> () JetComputeError!) -> () JetComputeError! {
    visit := ^visit
    expected_len :: jet_compute_storage_len(&tensor.shape)?
    (strides, offset) :: jet_compute_view_metadata(tensor)?
    if expected_len == 0 -> return ()
    expected_strides :: jet_compute_row_major_strides(&tensor.shape)?
    data :: tensor.data.as_ref()
    if strides == expected_strides.as_slice() {
        end :: offset.checked_add(expected_len).ok_or_else(fn() { JetComputeError.InvalidShape("Tensor view metadata does not address its logical storage") })?
        values :: data.get(offset..<end).ok_or_else(fn() { JetComputeError.InvalidShape("Tensor view metadata does not address its logical storage") })?
        loop value in values { visit(*value)? }
        return ()
    }
    dimensions := [USize].with_capacity(tensor.shape.len())
    loop dimension in &tensor.shape {
        dimensions.push(USize.try_from(*dimension).map_err(fn(_) { JetComputeError.InvalidShape("Tensor shape axis is too large") })?)
    }
    physical_strides := [USize].with_capacity(strides.len())
    loop stride in strides {
        physical_strides.push(USize.try_from(*stride).map_err(fn(_) { JetComputeError.InvalidShape("Tensor view strides must be non-negative and representable") })?)
    }
    coordinates := [USize].repeat(0, dimensions.len())
    physical_offset := offset
    loop _ in 0..<expected_len {
        value :: data.get(physical_offset).copied().ok_or_else(fn() { JetComputeError.InvalidShape("Tensor view metadata does not address its logical storage") })?
        visit(value)?
        axis := dimensions.len()
        loop while axis > 0 {
            axis -= 1
            dimension :: dimensions[axis]
            if coordinates[axis] + 1 < dimension {
                coordinates[axis] += 1
                physical_offset = physical_offset.checked_add(physical_strides[axis])
                    .ok_or_else(fn() { JetComputeError.InvalidShape("Tensor view metadata does not address its logical storage") })?
                break
            }
            coordinates[axis] = 0
            rewind :: physical_strides[axis].checked_mul(dimension - 1)
                .ok_or_else(fn() { JetComputeError.InvalidShape("Tensor view metadata does not address its logical storage") })?
            physical_offset = physical_offset.checked_sub(rewind)
                .ok_or_else(fn() { JetComputeError.InvalidShape("Tensor view metadata does not address its logical storage") })?
        }
    }
    ()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5133
fn jet_compute_tensor_values(tensor: &JetTensor) -> [F64] {
    expected_len :: jet_compute_storage_len(&tensor.shape).ok() ?? return []
    (strides, offset) :: jet_compute_view_metadata(tensor).ok() ?? return []
    data :: tensor.data.as_ref()
    if expected_len == 0 -> return []
    expected_strides :: jet_compute_row_major_strides(&tensor.shape).ok() ?? return []
    if strides == expected_strides.as_slice() {
        end :: offset.checked_add(expected_len) ?? return []
        values :: data.get(offset..<end) ?? return []
        return values.to_vec()
    }
    dimensions := [USize].with_capacity(tensor.shape.len())
    loop dimension in &tensor.shape { dimensions.push(USize.try_from(*dimension).ok() ?? return []) }
    physical_strides := [USize].with_capacity(strides.len())
    loop stride in strides { physical_strides.push(USize.try_from(*stride).ok() ?? return []) }
    coordinates := [USize].repeat(0, dimensions.len())
    physical_offset := offset
    values := [F64].with_capacity(expected_len)
    loop _ in 0..<expected_len {
        value :: data.get(physical_offset).copied() ?? return []
        values.push(value)
        axis := dimensions.len()
        loop while axis > 0 {
            axis -= 1
            dimension :: dimensions[axis]
            if coordinates[axis] + 1 < dimension {
                coordinates[axis] += 1
                physical_offset = physical_offset.checked_add(physical_strides[axis]) ?? return []
                break
            }
            coordinates[axis] = 0
            rewind :: physical_strides[axis].checked_mul(dimension - 1) ?? return []
            physical_offset = physical_offset.checked_sub(rewind) ?? return []
        }
    }
    ^values
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5207
fn jet_compute_validate_placement(device: JetComputeDevice, receipt: &JetComputePlacementReceipt) -> () JetComputeError! {
    if device == .Auto || receipt.selected == .Auto -> return Err(JetComputeError.Unsupported("a Tensor must record the concrete backend selected by Auto placement"))
    expected_abilities :: jet_compute_registered_backend_abilities(&receipt.backend, &receipt.profile)
        ?? return Err(JetComputeError.Unsupported("compute backend `{receipt.backend}` does not register profile `{receipt.profile}`"))
    registered :: match receipt.selected {
        .Cpu -> receipt.backend == CPU_ORACLE_BACKEND && receipt.version == CPU_ORACLE_VERSION
            && receipt.cache == CPU_ORACLE_CACHE && (receipt.requested == .Cpu || receipt.requested == .Auto)
        .Metal -> receipt.backend == METAL_BACKEND && receipt.version == METAL_VERSION && receipt.cache == METAL_CACHE && receipt.requested == .Metal
        .Cuda -> receipt.backend == CUDA_BACKEND && receipt.version == CUDA_VERSION && receipt.cache == CUDA_CACHE && receipt.requested == .Cuda
        .Vulkan -> receipt.backend == VULKAN_BACKEND && receipt.version == VULKAN_VERSION && receipt.cache == VULKAN_CACHE && receipt.requested == .Vulkan
        .WebGpu -> receipt.backend == WEBGPU_BACKEND && receipt.version == WEBGPU_VERSION && receipt.cache == WEBGPU_CACHE && receipt.requested == .WebGpu
        .Auto -> false
    }
    if device != receipt.selected || !registered || receipt.reason.is_empty()
        || receipt.reason.chars().any(fn(c) { c.is_control() })
        || !jet_compute_abilities_match(&receipt.abilities, expected_abilities) {
        return Err(JetComputeError.Device("Tensor placement receipt does not match a registered backend ability"))
    }
    ()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5274
fn jet_compute_validate_tensor(tensor: &JetTensor) -> () JetComputeError! {
    jet_compute_validate_placement(tensor.device, &tensor.last_placement)?
    expected_len :: jet_compute_storage_len(&tensor.shape)?
    (strides, offset) :: jet_compute_view_metadata(tensor)?
    if strides.iter().any(fn(stride) { *stride < 0 }) -> return Err(JetComputeError.InvalidShape("Tensor view strides must be non-negative"))
    if strides.iter().zip(tensor.shape.iter()).any(fn(pair) { *pair.1 > 1 && *pair.0 == 0 }) {
        return Err(JetComputeError.Unsupported("zero-stride Tensor views are not writable aliases"))
    }
    if expected_len == 0 {
        if offset > tensor.data.len() -> return Err(JetComputeError.InvalidShape("empty Tensor view starts outside backing storage"))
        return ()
    }
    storage_end :: jet_compute_view_storage_end(tensor, strides, offset)?
    if storage_end > tensor.data.len() -> return Err(JetComputeError.InvalidShape("Tensor view exceeds backing storage"))
    jet_compute_visit_tensor_values(tensor, fn(value) {
        if value.is_finite() { () } else { Err(JetComputeError.Arithmetic("Tensor values must be finite")) }
    })?
    jet_compute_visit_tensor_values(tensor, fn(value) {
        jet_compute_validate_profile_value(&tensor.last_placement.profile, value, "Tensor value")
    })?
    ()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5325
fn jet_compute_place_with_profile(requested: JetComputeDevice, profile: &String) -> JetComputePlacementReceipt JetComputeError! {
    selected :: match requested {
        .Auto | .Cpu -> JetComputeDevice.Cpu
        .Metal -> {
            if profile != CPU_ORACLE_F32_PROFILE -> return Err(JetComputeError.Unsupported("Metal backend supports only F32Strict+Reproducible; create an F32 Tensor first"))
            if !jet_compute_metal.available() -> return Err(JetComputeError.Device("Metal device is unavailable; no CPU fallback was selected"))
            JetComputeDevice.Metal
        }
        .Cuda -> {
            if profile != CPU_ORACLE_F32_PROFILE -> return Err(JetComputeError.Unsupported("CUDA backend supports only F32Strict+Reproducible; create an F32 Tensor first"))
            if !jet_compute_cuda.available() -> return Err(JetComputeError.Device("CUDA device is unavailable; no CPU fallback was selected"))
            JetComputeDevice.Cuda
        }
        .Vulkan -> {
            if profile != CPU_ORACLE_F32_PROFILE -> return Err(JetComputeError.Unsupported("Vulkan backend supports only F32Strict+Reproducible; create an F32 Tensor first"))
            if !jet_compute_vulkan.available() -> return Err(JetComputeError.Device("Vulkan device is unavailable; no CPU fallback was selected"))
            JetComputeDevice.Vulkan
        }
        .WebGpu -> {
            if profile != CPU_ORACLE_F32_PROFILE -> return Err(JetComputeError.Unsupported("WebGPU backend supports only F32Strict+Reproducible; create an F32 Tensor first"))
            if !jet_compute_webgpu.available() -> return Err(JetComputeError.Device("WebGPU device is unavailable; no CPU fallback was selected"))
            JetComputeDevice.WebGpu
        }
    }
    backend :: match selected { .Metal -> METAL_BACKEND, .Cuda -> CUDA_BACKEND, .Vulkan -> VULKAN_BACKEND, .WebGpu -> WEBGPU_BACKEND, _ -> CPU_ORACLE_BACKEND }
    version :: match selected { .Metal -> METAL_VERSION, .Cuda -> CUDA_VERSION, .Vulkan -> VULKAN_VERSION, .WebGpu -> WEBGPU_VERSION, _ -> CPU_ORACLE_VERSION }
    cache :: match selected { .Metal -> METAL_CACHE, .Cuda -> CUDA_CACHE, .Vulkan -> VULKAN_CACHE, .WebGpu -> WEBGPU_CACHE, _ -> CPU_ORACLE_CACHE }
    profile :: if matches(selected, .Metal | .Cuda | .Vulkan | .WebGpu) { CPU_ORACLE_F32_PROFILE } else { profile }
    abilities :: jet_compute_registered_backend_abilities(backend, profile)
        .ok_or_else(fn() { JetComputeError.Unsupported("compute profile is not registered") })?
        .iter().map(fn(ability) { ability.to_string() }).collect()
    ability :: match selected {
        .Metal -> "metal.f32", .Cuda -> "cuda.f32", .Vulkan -> "vulkan.f32", .WebGpu -> "webgpu.f32"
        _ if profile == CPU_ORACLE_F32_PROFILE -> "cpu-oracle.f32"
        _ -> "cpu-oracle.f64"
    }
    reason :: if requested == .Auto {
        "policy=auto; selected=cpu; ability={ability}"
    } else {
        match selected {
            .Metal -> "policy=explicit; selected=metal; ability=metal.f32"
            .Cuda -> "policy=explicit; selected=cuda; ability=cuda.f32"
            .Vulkan -> "policy=explicit; selected=vulkan; ability=vulkan.f32"
            .WebGpu -> "policy=explicit; selected=webgpu; ability=webgpu.f32"
            _ -> "policy=explicit; selected=cpu; ability={ability}"
        }
    }
    JetComputePlacementReceipt{requested: requested, selected: selected, backend: backend.to_string(), version: version.to_string(),
        profile: profile.to_string(), cache: cache.to_string(), abilities: ^abilities, reason: ^reason}
}

