    pub fn probe() -> () JetComputeError! {
        if target.selected_os() != "linux" -> return unavailable()
        context :: Context.new(Api.load()?)?
        drop(^context)
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:3657
