// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:3951
fn jet_compute_registered_abilities(profile: &String) -> &[String]? {
    match profile {
        CPU_ORACLE_F64_PROFILE -> Val(&CPU_ORACLE_F64_CAPABILITIES)
        CPU_ORACLE_F32_PROFILE -> Val(&CPU_ORACLE_F32_CAPABILITIES)
        _ -> None
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:3959
fn jet_compute_registered_backend_abilities(backend: &String, profile: &String) -> &[String]? {
    match backend {
        CPU_ORACLE_BACKEND -> jet_compute_registered_abilities(profile)
        METAL_BACKEND if profile == CPU_ORACLE_F32_PROFILE -> Val(&METAL_F32_CAPABILITIES)
        CUDA_BACKEND if profile == CPU_ORACLE_F32_PROFILE -> Val(&CUDA_F32_CAPABILITIES)
        VULKAN_BACKEND if profile == CPU_ORACLE_F32_PROFILE -> Val(&VULKAN_F32_CAPABILITIES)
        WEBGPU_BACKEND if profile == CPU_ORACLE_F32_PROFILE -> Val(&WEBGPU_F32_CAPABILITIES)
        _ -> None
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:3973
fn jet_compute_abilities_match(actual: &[String], expected: &[String]) -> Bool {
    actual.len() == expected.len() && actual.iter().zip(expected.iter()).all(fn(pair) { pair.0 == pair.1 })
}
