fn jet_compute_curried_flat_input(entry: &JetComputeCurriedEntry, input: JetComputeInputPack) -> JetComputeInputPack JetComputeError! {
    if !input.flat -> return ^input
    primals :: ^input.primals
    match entry {
        .Plan{base, kind, ..} -> {
            if !kind.is_jvp() -> return JetComputeInputPack.new(^primals, [])
            split :: base.arity
            if primals.len() != split.saturating_mul(2) -> return Err(JetComputeError.Unsupported("jvp needs one tangent for every primal"))
            JetComputeInputPack.new(primals[..split].to_vec(), primals[split..].to_vec())
        }
        _ -> JetComputeInputPack.new(^primals, [])
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:4559
pub fn jet_compute_call_curried(handle: I64, input: JetComputeInputPack) -> JetComputeCurriedResult JetComputeError! {
    entry :: jet_compute_curried_entry(handle) ?? return Err(JetComputeError.Unsupported("autodiff callable handle is invalid or expired"))
    input :: jet_compute_curried_flat_input(&entry, ^input)?
    match entry {
        .Plan{base, kind, targets, result_shape} -> {
            if kind.is_jvp() {
                if input.primals.len() != input.tangents.len() -> return Err(JetComputeError.Unsupported("jvp needs one tangent for every primal"))
            } else if !input.tangents.is_empty() {
                return Err(JetComputeError.Unsupported("non-JVP autodiff callable received tangent values"))
            }
            jet_compute_curried_call_plan(&base, kind, &targets, result_shape, ^input)
        }
        .Continuation{state, targets, kind} -> {
            expected :: if matches(kind, .Pull) { 1 } else { 0 }
            if !input.tangents.is_empty() || input.primals.len() != expected {
                return Err(JetComputeError.Unsupported("autodiff continuation received the wrong arguments"))
            }
            gradients :: match kind {
                .Pull -> jet_compute_vjp_pull(&state, &input.primals[0], &targets)?
                .Grads -> {
                    seed :: jet_compute_gradient_seed(&state)?
                    jet_compute_vjp_pull(&state, &seed, &targets)?
                }
            }
            JetComputeCurriedResult.Gradient(gradients.into_iter().map(fn(gradient) { [^gradient] }).collect())
        }
    }
}
