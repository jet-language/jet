    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:4161
    pub fn is_jvp(self: Self) -> Bool { self == .Jvp }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:4165
    pub fn name(self: Self) -> String {
        match self { .Gradient -> "gradient", .ValueAndGradient -> "value_and_gradient", .Vjp -> "vjp", .Jvp -> "jvp" }
    }
}
