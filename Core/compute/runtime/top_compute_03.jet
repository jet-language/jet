    pub fn copy(values: &[F32]) -> [F32] JetComputeError! {
        if target.selected_os() != "linux" -> return unavailable()
        run(17, [values], values.len(), Params{
            count: U32.try_from(values.len()).map_err(fn(_) { JetComputeError.InvalidShape("Vulkan copy count is too large") })?,
            rows: 0, inner: 0, cols: 0, op: 17, scalar: 0.0})
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:3677
    pub fn binary(op: U32, left: &[F32], right: &[F32]) -> [F32] JetComputeError! {
        if target.selected_os() != "linux" -> return unavailable()
        if left.len() != right.len() -> return Err(JetComputeError.InvalidShape("Vulkan binary inputs have different lengths"))
        run(op, [left, right], left.len(), Params{
            count: U32.try_from(left.len()).map_err(fn(_) { JetComputeError.InvalidShape("Vulkan binary count is too large") })?,
            rows: 0, inner: 0, cols: 0, op: op, scalar: 0.0})
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:3698
    pub fn unary(op: U32, values: &[F32]) -> [F32] JetComputeError! {
        if target.selected_os() != "linux" -> return unavailable()
        run(6 + op, [values], values.len(), Params{
            count: U32.try_from(values.len()).map_err(fn(_) { JetComputeError.InvalidShape("Vulkan unary count is too large") })?,
            rows: 0, inner: 0, cols: 0, op: 6 + op, scalar: 0.0})
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:3714
    pub fn matmul(left: &[F32], right: &[F32], rows: USize, inner: USize, cols: USize) -> [F32] JetComputeError! {
        if target.selected_os() != "linux" -> return unavailable()
        count :: rows.checked_mul(cols).ok_or_else(fn() { JetComputeError.InvalidShape("Vulkan matmul output size overflow") })?
        run(11, [left, right], count, Params{
            count: U32.try_from(count).map_err(fn(_) { JetComputeError.InvalidShape("Vulkan matmul output is too large") })?,
            rows: U32.try_from(rows).map_err(fn(_) { JetComputeError.InvalidShape("Vulkan matmul rows are too large") })?,
            inner: U32.try_from(inner).map_err(fn(_) { JetComputeError.InvalidShape("Vulkan matmul inner dimension is too large") })?,
            cols: U32.try_from(cols).map_err(fn(_) { JetComputeError.InvalidShape("Vulkan matmul columns are too large") })?,
            op: 11, scalar: 0.0})
    }
