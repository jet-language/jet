use core.prelude.runtime.std_common_types_02.Solver

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Solver.rs:1
// One finite-solver counter kernel for every execution tier.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Solver.rs:3
pub fn jet_solver_new(seed: I64) -> Solver { Solver{seed, checked: I64{0}, failures: I64{0}} }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Solver.rs:11
pub fn jet_solver_require(solver: &Solver, ok: Bool) -> {
    solver.checked += 1
    if !ok -> solver.failures += 1
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Solver.rs:18
pub fn jet_solver_failure_count(solver: Solver) -> I64 { solver.failures }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Solver.rs:22
pub fn jet_solver_status(solver: Solver) -> String { if solver.failures == 0 { "ok" } else { "failed" } }
