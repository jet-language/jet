// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:10312
// CPU-SIMD profile: blocked F32 matmul, runtime intrinsics, ordered lanes and scalar tail.
fn jet_compute_matmul_f32_tile(a: &JetTensor, b: &JetTensor) -> JetTensor JetComputeError! {
    if a.shape.len() != 2 || b.shape.len() != 2 -> return Err(JetComputeError.RankMismatch("matmul_f32_tile requires rank-2 tensors"))
    jet_compute_validate_tensor(a)?
    jet_compute_validate_tensor(b)?
    (m, k) :: (a.shape[0], a.shape[1])
    (k2, n) :: (b.shape[0], b.shape[1])
    if m < 0 || k < 0 || k2 < 0 || n < 0 -> return Err(JetComputeError.InvalidShape("matmul_f32_tile dimensions must be non-negative"))
    if k != k2 -> return Err(JetComputeError.RankMismatch("matmul_f32_tile inner dims {k} and {k2} disagree"))
    if a.device == JetComputeDevice.Metal {
        jet_compute_require_same_contract(a, b, "matmul_f32_tile")?
        rows :: USize.try_from(m).map_err(_ -> JetComputeError.InvalidShape("Metal f32 tile row count is too large"))?
        inner :: USize.try_from(k).map_err(_ -> JetComputeError.InvalidShape("Metal f32 tile inner dimension is too large"))?
        cols :: USize.try_from(n).map_err(_ -> JetComputeError.InvalidShape("Metal f32 tile column count is too large"))?
        left :: jet_compute_metal_values(a, "f32 tile input")?
        right :: jet_compute_metal_values(b, "f32 tile input")?
        data :: jet_compute_metal.matmul(&left, &right, rows, inner, cols)?
        out := jet_compute_metal_result_like(a, [m, n], ^data)?
        out.last_placement.reason = "algorithm=metal-matmul; arithmetic=f32; reduction=ordered; dispatch=metal"
        return jet_compute_record(^out, &[a, b], [a.clone(), b.clone()], JetComputeTapeRule.MatmulF32Tile)
    }
    if a.device == JetComputeDevice.Cuda {
        jet_compute_require_same_contract(a, b, "matmul_f32_tile")?
        rows :: USize.try_from(m).map_err(_ -> JetComputeError.InvalidShape("CUDA f32 tile row count is too large"))?
        inner :: USize.try_from(k).map_err(_ -> JetComputeError.InvalidShape("CUDA f32 tile inner dimension is too large"))?
        cols :: USize.try_from(n).map_err(_ -> JetComputeError.InvalidShape("CUDA f32 tile column count is too large"))?
        left :: jet_compute_cuda_values(a, "f32 tile input")?
        right :: jet_compute_cuda_values(b, "f32 tile input")?
        data :: jet_compute_cuda.matmul(&left, &right, rows, inner, cols)?
        out := jet_compute_cuda_result_like(a, [m, n], ^data)?
        out.last_placement.reason = "algorithm=cuda-matmul; arithmetic=f32; reduction=ordered; dispatch=cuda"
        return jet_compute_record(^out, &[a, b], [a.clone(), b.clone()], JetComputeTapeRule.MatmulF32Tile)
    }
    if a.device == JetComputeDevice.Vulkan {
        jet_compute_require_same_contract(a, b, "matmul_f32_tile")?
        rows :: USize.try_from(m).map_err(_ -> JetComputeError.InvalidShape("Vulkan f32 tile row count is too large"))?
        inner :: USize.try_from(k).map_err(_ -> JetComputeError.InvalidShape("Vulkan f32 tile inner dimension is too large"))?
        cols :: USize.try_from(n).map_err(_ -> JetComputeError.InvalidShape("Vulkan f32 tile column count is too large"))?
        left :: jet_compute_vulkan_values(a, "f32 tile input")?
        right :: jet_compute_vulkan_values(b, "f32 tile input")?
        data :: jet_compute_vulkan.matmul(&left, &right, rows, inner, cols)?
        out := jet_compute_vulkan_result_like(a, [m, n], ^data)?
        out.last_placement.reason = "algorithm=vulkan-matmul; arithmetic=f32; reduction=ordered; dispatch=vulkan"
        return jet_compute_record(^out, &[a, b], [a.clone(), b.clone()], JetComputeTapeRule.MatmulF32Tile)
    }
    if a.device == JetComputeDevice.WebGpu -> return Err(JetComputeError.Unsupported("WebGPU backend requires a browser WebGPU host"))
    output_shape :: [m, n]
    rows :: USize.try_from(m).map_err(_ -> JetComputeError.InvalidShape("f32 tile row count is too large"))?
    inner :: USize.try_from(k).map_err(_ -> JetComputeError.InvalidShape("f32 tile inner dimension is too large"))?
    cols :: USize.try_from(n).map_err(_ -> JetComputeError.InvalidShape("f32 tile column count is too large"))?
    a_values :: jet_compute_tensor_values(a).into_iter().map(value -> jet_compute_f32_value(value, "f32 tile input")).collect<[F32] JetComputeError!>()?
    b_values :: jet_compute_tensor_values(b).into_iter().map(value -> jet_compute_f32_value(value, "f32 tile input")).collect<[F32] JetComputeError!>()?
    packed_b_len :: cols.checked_mul(inner).ok_or_else(fn() { JetComputeError.InvalidShape("f32 tile packed-B storage length overflow") })?
    packed_b := [F32].filled(packed_b_len, F32{0.0})
    for row in 0..<inner {
        for column in 0..<cols { packed_b[column * inner + row] = b_values[row * cols + column] }
    }
    output_len :: rows.checked_mul(cols).ok_or_else(fn() { JetComputeError.InvalidShape("f32 tile output storage length overflow") })?
    backend :: jet_compute_simd_backend()
    output := [F64].filled(output_len, F64{0.0})
    TILE: USize :: 8
    for row_tile in (0..<rows).step_by(TILE) {
        row_end :: row_tile.saturating_add(TILE).min(rows)
        for column_tile in (0..<cols).step_by(TILE) {
            column_end :: column_tile.saturating_add(TILE).min(cols)
            for row in row_tile..<row_end {
                left :: a_values.slice(row * inner, (row + 1) * inner)
                for column in column_tile..<column_end {
                    right :: packed_b.slice(column * inner, (column + 1) * inner)
                    value :: jet_compute_f32_dot(backend, left, right)?
                    output[row * cols + column] = F64.from(value)
                }
            }
        }
    }
    out := jet_compute_tensor_from_shape(^output_shape, F64{0.0}, JetComputeDevice.Cpu)?
    // GATE #4565: kernel primitive
    #Unsafe("retain initialized blocked-matmul output without duplicating its backing allocation") { out.data = Arc.new(^output) }
    out.last_placement.profile = CPU_ORACLE_F32_PROFILE.to_string()
    out.last_placement.abilities = CPU_ORACLE_F32_CAPABILITIES.iter().map(ability -> ability.to_string()).collect()
    out.last_placement.reason = "algorithm=blocked-matmul; tile={TILE}; arithmetic=f32; reduction=ordered; dispatch={backend.name()}; vector_width={backend.width()}; tail=scalar"
    jet_compute_record(^out, &[a, b], [a.clone(), b.clone()], JetComputeTapeRule.MatmulF32Tile)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:10482
fn jet_compute_profile_f32_strict() -> String {
    backend :: jet_compute_simd_backend()
    "backend={CPU_ORACLE_BACKEND};version={CPU_ORACLE_VERSION};profile={CPU_ORACLE_F32_PROFILE};algorithm=blocked-matmul;tile=8;dispatch={backend.name()};vector_width={backend.width()};tail=scalar;cache={CPU_ORACLE_CACHE}"
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:10495
fn jet_compute_profile_show() -> String { jet_compute_profile_f32_strict() }

