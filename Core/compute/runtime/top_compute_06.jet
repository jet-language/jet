}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:10135
fn jet_compute_simd_backend_for_features(avx2: Bool, sse2: Bool) -> JetComputeSimdBackend {
    if avx2 -> return .Avx2
    if sse2 -> return .Sse2
    .Scalar
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:10145
// Rust attribute: inline(never); preserve ordered scalar reduction.
fn jet_compute_f32_dot_scalar(a: View<F32>, b: View<F32>) -> F32 {
    a.iter().zip(b.iter()).fold(F32{0.0}, fn(sum, pair) { sum + pair.0 * pair.1 })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:10152
fn jet_compute_simd_backend_available(backend: JetComputeSimdBackend) -> Bool {
    arch :: core.sys.target.selected_arch()
    if arch == "x86" || arch == "x86_64" {
        // GATE #4565: kernel primitive
        return #Unsafe("query runtime x86 features and OS-enabled vector state before intrinsic dispatch") {
            match backend {
                .Avx2 -> std.arch.is_x86_feature_detected("avx2")
                .Sse2 -> std.arch.is_x86_feature_detected("sse2")
                .Scalar -> true
            }
        }
    }
    matches(backend, .Scalar)
}
