enum JetComputeSimdBackend { Avx2, Sse2, Scalar }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:10103
impl JetComputeSimdBackend {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:10104
    fn name(self: Self) -> String {
