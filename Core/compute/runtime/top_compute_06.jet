// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9065
// GATE #4565: kernel primitive
#Unsafe("snapshot the shared autodiff tape under its mutex; preserve poison failure and retained tensor ownership")
fn jet_compute_jvp(state: JetComputeVjpState, input_tangents: ^[JetTensor]) -> JetTensor JetComputeError! {
    (nodes, inputs) :: {
        tape :: state.tape.lock().map_err(_ -> JetComputeError.Unsupported("autodiff tape is poisoned"))?
        (tape.nodes.clone(), tape.inputs.clone())
    }
    if input_tangents.len() != inputs.len() -> return Err(JetComputeError.RankMismatch("JVP tangent count must equal the function input count"))
    for (input, tangent) in inputs.iter().zip(input_tangents.iter()) {
        if input.shape != tangent.shape -> return Err(JetComputeError.RankMismatch("JVP tangent shapes must match their primal inputs"))
        jet_compute_require_same_contract(input, tangent, "JVP tangent")?
    }
    tangents := [JetTensor?].filled(nodes.len(), None)
    for (index, tangent) in input_tangents.into_iter().enumerate() {
        if index < tangents.len() -> tangents[index] = Val(jet_compute_remove_trace_level(tangent, state.tape))
    }
    for (index, node) in nodes.iter().enumerate().skip(inputs.len()) {
        rule :: match node.rule.as_ref() { Val(rule) -> rule, None -> continue }
        node_tangents := [JetTensor].with_capacity(node.parents.len())
        for (parent, value) in node.parents.iter().zip(node.values.iter()) {
            node_tangents.push(parent.and_then(parent -> tangents.get(parent).and_then(value -> value.as_ref()).cloned()).unwrap_or(jet_compute_zero_like(value)?))
        }
        tangents[index] = Val(jet_compute_jvp_rule(rule, node.values, node.output, node_tangents)?)
    }
    match state.output_node {
        Val(node) -> tangents.get(node).and_then(value -> value.clone()).ok_or_else(fn() { JetComputeError.Unsupported("JVP output tangent is unavailable") })
        None -> jet_compute_zero_like(state.value)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9123
fn jet_compute_vjp_matmul(a: JetTensor, b: JetTensor, cot: JetTensor) -> (JetTensor, JetTensor) JetComputeError! {
    jet_compute_validate_tensor(a)?
    jet_compute_validate_tensor(b)?
    jet_compute_validate_tensor(cot)?
    if a.shape.len() != 2 || b.shape.len() != 2 || cot.shape.len() != 2 || a.shape[1] != b.shape[0] || cot.shape[0] != a.shape[0] || cot.shape[1] != b.shape[1] {
        return Err(JetComputeError.RankMismatch("matmul cotangent shape must equal the matmul output"))
    }
    jet_compute_require_same_contract(a, b, "matmul cotangent")?
    jet_compute_require_same_contract(a, cot, "matmul cotangent")?
    b_t :: jet_compute_transpose(b)?
    a_t :: jet_compute_transpose(a)?
    Ok((jet_compute_inherit_placement(^jet_compute_matmul(cot, b_t)?, a), jet_compute_inherit_placement(^jet_compute_matmul(a_t, cot)?, b)))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9152
// GATE #4565: kernel primitive
#Unsafe("retain projected tensor storage in the canonical shared allocation")
fn jet_compute_f32_projection(tensor: JetTensor) -> JetTensor JetComputeError! {
    jet_compute_validate_tensor(tensor)?
    values :: jet_compute_tensor_values(tensor).into_iter().map(value -> jet_compute_f32_value(value, "f32 autodiff input")).collect::<[F32] JetComputeError!>()?
    projected := jet_compute_tensor_from_shape_like(tensor, tensor.shape.clone(), F64{0.0})?
    projected.data = Arc.new(values.into_iter().map(value -> F64.from(value)).collect())
    if !jet_compute_is_accelerator(projected.device) {
        projected.last_placement.profile = CPU_ORACLE_F32_PROFILE.to_string()
        projected.last_placement.abilities = CPU_ORACLE_F32_CAPABILITIES.iter().map(ability -> ability.to_string()).collect()
        projected.last_placement.reason = "autodiff f32 projection"
    }
    jet_compute_validate_tensor(projected)?
    Ok(^projected)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9172
fn jet_compute_vjp_matmul_f32_tile(a: JetTensor, b: JetTensor, cot: JetTensor) -> (JetTensor, JetTensor) JetComputeError! {
    jet_compute_validate_tensor(a)?
    jet_compute_validate_tensor(b)?
    jet_compute_validate_tensor(cot)?
    if a.shape.len() != 2 || b.shape.len() != 2 || cot.shape.len() != 2 || a.shape[1] != b.shape[0] || cot.shape[0] != a.shape[0] || cot.shape[1] != b.shape[1] {
        return Err(JetComputeError.RankMismatch("matmul_f32_tile cotangent shape must equal the matmul output"))
    }
    if a.device != b.device || a.device != cot.device -> return Err(JetComputeError.Device("matmul_f32_tile cotangent devices must match the inputs"))
    a32 :: jet_compute_f32_projection(a)?
    b32 :: jet_compute_f32_projection(b)?
    cot32 :: jet_compute_f32_projection(cot)?
    b_transposed :: jet_compute_transpose(b32)?
    a_transposed :: jet_compute_transpose(a32)?
    a_gradient :: jet_compute_matmul_f32_tile(cot32, b_transposed)?
    b_gradient :: jet_compute_matmul_f32_tile(a_transposed, cot32)?
    Ok((jet_compute_tensor_from_values_like(a, jet_compute_tensor_values(a_gradient))?, jet_compute_tensor_from_values_like(b, jet_compute_tensor_values(b_gradient))?))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9209
fn jet_compute_jvp_matmul_f32_tile(a: JetTensor, b: JetTensor, a_tangent: JetTensor, b_tangent: JetTensor) -> JetTensor JetComputeError! {
    jet_compute_validate_tensor(a)?
    jet_compute_validate_tensor(b)?
    jet_compute_validate_tensor(a_tangent)?
    jet_compute_validate_tensor(b_tangent)?
    if a.shape != a_tangent.shape || b.shape != b_tangent.shape -> return Err(JetComputeError.RankMismatch("matmul_f32_tile tangent shapes must match the inputs"))
    if a.device != b.device || a.device != a_tangent.device || b.device != b_tangent.device {
        return Err(JetComputeError.Device("matmul_f32_tile tangent devices must match the inputs"))
    }
    a32 :: jet_compute_f32_projection(a)?
    b32 :: jet_compute_f32_projection(b)?
    a_tangent32 :: jet_compute_f32_projection(a_tangent)?
    b_tangent32 :: jet_compute_f32_projection(b_tangent)?
    left :: jet_compute_matmul_f32_tile(a_tangent32, b32)?
    right :: jet_compute_matmul_f32_tile(a32, b_tangent32)?
    jet_compute_binary("add", left, right)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9241
fn jet_compute_f32_value(value: F64, context: String) -> F32 JetComputeError! {
    narrowed :: value as F32
    if !narrowed.is_finite() -> return Err(JetComputeError.Arithmetic("{context} is outside the finite F32 range"))
    Ok(narrowed)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9251
fn jet_compute_validate_profile_value(profile: String, value: F64, context: String) -> () JetComputeError! {
    if profile == CPU_ORACLE_F32_PROFILE {
        narrowed :: jet_compute_f32_value(value, context)?
        if F64.from(narrowed) != value -> return Err(JetComputeError.Arithmetic("{context} is not canonical for the F32 precision profile"))
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9267
fn jet_compute_validate_serialized_profile_values(profile: String, values: [F64]) -> () JetComputeError! {
    if profile == CPU_ORACLE_F32_PROFILE {
        for value in values {
            narrowed :: jet_compute_f32_value(value, "serialized Tensor value")?
            if F64.from(narrowed) != value {
                return Err(JetComputeError.Serialization("serialized Tensor value is not canonical for its F32 profile"))
            }
        }
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9284
fn jet_compute_wire_checksum(body: String) -> String Never! {
    hash := U64{0xcbf29ce484222325}
    for byte in body.as_bytes() {
        hash = hash ~| U64{byte}
        hash = hash.wrapping_mul(U64{0x100000001b3})
    }
    bytes :: hash.to_be_bytes()
    jet_std_hex_encode(bytes[0..<bytes.len()])
}
