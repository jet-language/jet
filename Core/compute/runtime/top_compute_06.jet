// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:10121
fn jet_compute_simd_backend() -> JetComputeSimdBackend {
    arch :: core.sys.target.selected_arch()
    if arch == "x86" || arch == "x86_64" {
        // GATE #4565: kernel primitive
        return #Unsafe("runtime CPU feature detection includes OS enabled AVX state on selected x86 target") {
            jet_compute_simd_backend_for_features(std.arch.is_x86_feature_detected("avx2"), std.arch.is_x86_feature_detected("sse2"))
