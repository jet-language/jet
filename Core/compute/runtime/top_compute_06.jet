// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9772
fn jet_compute_serialize(tensor: &JetTensor) -> String JetComputeError! {
    jet_compute_validate_tensor(tensor)?
    if tensor.trace.is_some() -> return Err(JetComputeError.Unsupported("Tensor serialization does not accept traced tensors"))
    if jet_compute_is_accelerator(tensor.device) -> return Err(JetComputeError.Unsupported("accelerator Tensor serialization requires an explicit transfer to CPU"))
    values :: jet_compute_tensor_values(tensor)
    shape :: tensor.shape.iter().map(d -> d.to_string()).collect<[String]>().join(",")
    // Debug formatting preserves shortest round-tripping f64 spelling.
    data :: values.iter().map(v -> "{v:?}").collect<[String]>().join(",")
    profile :: tensor.last_placement.profile.as_str()
    jet_compute_validate_serialized_profile_values(profile, &values)?
    body :: "shape={shape};data={data};profile={profile}"
    checksum :: jet_compute_wire_checksum(&body)
    Ok("{body};checksum={checksum}")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9805
fn jet_compute_deserialize(payload: &String) -> JetTensor JetComputeError! {
    fields := payload.split(';')
    shape_part :: fields.next() ?? return Err(JetComputeError.InvalidShape("deserialize expects shape=…;data=…;profile=…;checksum=…"))
    data_part :: fields.next() ?? return Err(JetComputeError.InvalidShape("deserialize expects shape=…;data=…;profile=…;checksum=…"))
    profile_part :: fields.next() ?? return Err(JetComputeError.InvalidShape("deserialize expects shape=…;data=…;profile=…;checksum=…"))
    checksum_part :: fields.next() ?? return Err(JetComputeError.InvalidShape("deserialize expects shape=…;data=…;profile=…;checksum=…"))
    if fields.next().is_some() || !data_part.starts_with("data=") || !profile_part.starts_with("profile=") || !checksum_part.starts_with("checksum=") {
        return Err(JetComputeError.Serialization("deserialize contains duplicate or unknown fields"))
    }
    shape_str :: shape_part.strip_prefix("shape=").ok_or_else(fn() { JetComputeError.Serialization("missing shape=") })?
    if shape_str.is_empty() -> return Err(JetComputeError.Serialization("serialized Tensor shape cannot be empty"))
    shape :: shape_str.split(',').map(fn(p) {
        if p.is_empty() -> return Err(JetComputeError.Serialization("serialized Tensor shape contains an empty axis"))
        axis :: p.parse<I64>().map_err(_ -> JetComputeError.Serialization("bad shape axis `{p}`"))?
        if axis.to_string() != p -> return Err(JetComputeError.Serialization("non-canonical shape axis `{p}`"))
        Ok(axis)
    }).collect<[I64] JetComputeError!>()?
    data_str :: data_part.strip_prefix("data=").unwrap_or("")
    data :: if data_str.is_empty() { [] } else {
        data_str.split(',').map(fn(p) {
            if p.is_empty() -> return Err(JetComputeError.Serialization("serialized Tensor data contains an empty value"))
            value :: p.parse<F64>().map_err(_ -> JetComputeError.Serialization("bad data value `{p}`"))?
            if !value.is_finite() -> return Err(JetComputeError.Serialization("serialized Tensor contains a non-finite value"))
            if "{value:?}" != p -> return Err(JetComputeError.Serialization("non-canonical data value `{p}`"))
            Ok(value)
        }).collect<[F64] JetComputeError!>()?
    }
    profile :: profile_part.strip_prefix("profile=").unwrap_or("")
    abilities :: jet_compute_registered_abilities(profile) ?? return Err(JetComputeError.Serialization("unsupported Tensor precision profile `{profile}`"))
    jet_compute_validate_serialized_profile_values(profile, &data)?
    checksum :: checksum_part.strip_prefix("checksum=").unwrap_or("")
    if checksum.len() != 16 || !checksum.bytes().all(byte -> (byte >= U8{48} && byte <= U8{57}) || (byte >= U8{97} && byte <= U8{102})) {
        return Err(JetComputeError.Serialization("serialized Tensor checksum is not canonical"))
    }
    body :: "{shape_part};{data_part};{profile_part}"
    if jet_compute_wire_checksum(&body) != checksum -> return Err(JetComputeError.Serialization("serialized Tensor checksum does not match its contents"))
    expected :: jet_compute_storage_len(&shape)?
    if expected != data.len() -> return Err(JetComputeError.Serialization("deserialize storage length mismatch: shape wants {expected}, got {data.len()}"))
    tensor := jet_compute_tensor_from_shape(^shape, F64{0.0}, JetComputeDevice.Cpu)?
    // GATE #4565: kernel primitive
    #Unsafe("retain the validated owned deserialized tensor backing storage") { tensor.data = Arc.new(^data) }
    tensor.last_placement.profile = profile.to_string()
    tensor.last_placement.abilities = abilities.iter().map(ability -> ability.to_string()).collect()
    tensor.last_placement.reason = "deserialized canonical Tensor"
    jet_compute_validate_tensor(&tensor)?
    Ok(^tensor)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9934
// Sparse CSR, CPU SIMD tile and precision profile.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9936
#Derive(Clone, Debug, PartialEq)
pub struct JetSparseCsr {
    rows: I64,
    cols: I64,
    row_ptr: [I64],
    col_idx: [I64],
    values: [F64],
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9945
impl JetShow for JetSparseCsr {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9946
    fn jet_show(self: &Self) -> String { "SparseCsr({self.rows}x{self.cols}, nnz={self.values.len()})" }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9956
fn jet_compute_to_sparse(tensor: &JetTensor) -> JetSparseCsr JetComputeError! {
    if tensor.trace.is_some() -> return Err(JetComputeError.Unsupported("to_sparse has no registered autodiff rule"))
    if tensor.shape.len() != 2 -> return Err(JetComputeError.RankMismatch("to_sparse requires a rank-2 tensor"))
    jet_compute_validate_tensor(tensor)?
    if jet_compute_is_accelerator(tensor.device) -> return Err(JetComputeError.Unsupported("accelerator backend does not support sparse conversion; transfer to CPU explicitly"))
    rows :: tensor.shape[0]
    cols :: tensor.shape[1]
    row_ptr := [I64{0}]
    col_idx := [I64].new()
    values := [F64].new()
    for r in 0..<rows {
        for c in 0..<cols {
            v :: jet_compute_get_raw(tensor, &[r, c])?
            if v != F64{0.0} { col_idx.push(c); values.push(v) }
        }
        row_ptr.push(I64.try_from(values.len()).map_err(_ -> JetComputeError.InvalidShape("sparse nnz is too large"))?)
    }
    Ok(JetSparseCsr{rows: rows, cols: cols, row_ptr: ^row_ptr, col_idx: ^col_idx, values: ^values})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:10000
fn jet_compute_sparse_nnz(sparse: &JetSparseCsr) -> I64 { I64.try_from(sparse.values.len()).unwrap_or(I64.MAX) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:10004
fn jet_compute_sparse_mv(sparse: &JetSparseCsr, vector: &JetTensor) -> JetTensor JetComputeError! {
    if vector.trace.is_some() -> return Err(JetComputeError.Unsupported("sparse_mv has no registered autodiff rule"))
    jet_compute_validate_sparse(sparse)?
    jet_compute_validate_tensor(vector)?
    if jet_compute_is_accelerator(vector.device) -> return Err(JetComputeError.Unsupported("accelerator backend does not support sparse_mv; transfer the vector to CPU explicitly"))
    if vector.shape.len() != 1 || vector.shape[0] != sparse.cols -> return Err(JetComputeError.RankMismatch("sparse_mv expects a length-{sparse.cols} vector"))
    out := jet_compute_zeros(&[sparse.rows])?
    for r in 0..<sparse.rows {
        row :: USize.try_from(r).map_err(_ -> JetComputeError.InvalidShape("sparse row index is too large"))?
        start :: USize.try_from(sparse.row_ptr[row]).map_err(_ -> JetComputeError.InvalidShape("sparse row pointer is invalid"))?
        end :: USize.try_from(sparse.row_ptr[row + 1]).map_err(_ -> JetComputeError.InvalidShape("sparse row pointer is invalid"))?
        acc := F64{0.0}
        for k in start..<end {
            c :: sparse.col_idx[k]
            acc += sparse.values[k] * jet_compute_get_raw(vector, &[c])?
            if !acc.is_finite() -> return Err(JetComputeError.Arithmetic("sparse matrix-vector multiplication produced a non-finite value"))
        }
        jet_compute_set(&out, &[r], acc)?
    }
    Ok(^out)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:10054
fn jet_compute_validate_sparse(sparse: &JetSparseCsr) -> () JetComputeError! {
    if sparse.rows < 0 || sparse.cols < 0 -> return Err(JetComputeError.InvalidShape("sparse dimensions must be non-negative"))
    rows :: USize.try_from(sparse.rows).map_err(_ -> JetComputeError.InvalidShape("sparse row count is too large"))?
    if sparse.row_ptr.len() != rows.saturating_add(1) || sparse.col_idx.len() != sparse.values.len() -> return Err(JetComputeError.InvalidShape("sparse CSR arrays have inconsistent lengths"))
    nnz :: I64.try_from(sparse.values.len()).map_err(_ -> JetComputeError.InvalidShape("sparse nnz is too large"))?
    if sparse.row_ptr.first().copied() != Val(I64{0}) || sparse.row_ptr.last().copied() != Val(nnz)
        || sparse.row_ptr.windows(2).any(pair -> pair[0] < 0 || pair[1] < pair[0] || pair[1] > nnz)
        || sparse.col_idx.iter().any(col -> col < 0 || col >= sparse.cols)
        || sparse.values.iter().any(value -> !value.is_finite()) {
        return Err(JetComputeError.InvalidShape("sparse CSR invariants are invalid"))
    }
    Ok(())
}
