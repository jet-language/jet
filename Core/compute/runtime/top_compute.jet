// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:1
// D-COMPUTE1=D / D-COMPUTE-TYPE1=D / D-COMPUTE-PLACE1=D (#443).
// Tensor owns ranked storage on the selected CPU oracle or explicit accelerator;
// views retain backing allocation and strides. Mutable access requires sema-proved
// exclusive ViewMut; shared writes fail closed, never copy to simulate alias updates.
// Explicit Tensor copies materialize logical values in fresh backing storage.
// Engines only marshal these canonical compute symbols.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:10
#Derive(Clone, Copy, Debug, PartialEq, Eq)
pub enum JetComputeDevice { Auto, Cpu, Metal, Cuda, Vulkan, WebGpu }
