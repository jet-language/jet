//RS // D-COMPUTE-BACKEND1=D / #1145: the Metal bridge is a Prelude-owned native
//RS // adapter. It stages canonical F32 values into shared Metal buffers, launches
//RS // checked kernels, and reads the result back into the Tensor owner. No host
//RS // engine selects a kernel or supplies a fallback policy.
//RS #[cfg(any(target_os = "macos", target_os = "ios"))]
//RS mod jet_compute_metal {
//RS     use super::JetComputeError;
//RS     use std::ffi::CString;
