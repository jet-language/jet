// Kernels validate inputs once; scalar addressing stays bounded by rank.
fn jet_compute_offset(tensor: &JetTensor, indices: [I64]) -> Result<USize, JetComputeError> {
    if indices.len() != tensor.shape.len() { return Err(JetComputeError.RankMismatch("expected {tensor.shape.len()} indices, got {indices.len()}")) }
    (strides, base_offset) :: jet_compute_view_metadata(tensor)?
    relative_offset := I64{0}
    for (i, (idx, (dim, stride))) in indices.iter().zip(tensor.shape.iter().zip(strides.iter())).enumerate() {
        if *idx < 0 || *idx >= *dim { return Err(JetComputeError.OutOfBounds("index {idx} out of range for axis {i} of extent {dim}")) }
        term :: idx.checked_mul(*stride).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })?
        relative_offset = relative_offset.checked_add(term).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })?
    }
    USize.try_from(relative_offset).ok().and_then(fn(relative) { base_offset.checked_add(relative) })
        .filter(fn(index) { *index < tensor.data.len() }).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index is outside storage") })
}
