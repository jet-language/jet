        return jet_compute_record(jet_compute_metal_result_like(a, [m, n], ^data)?, &[a, b], [a.clone(), b.clone()], JetComputeTapeRule.Matmul)
    }
    if a.device == JetComputeDevice.Cuda {
        rows :: USize.try_from(m).map_err(fn(error) { JetComputeError.InvalidShape("CUDA matmul rows are too large") })?
        inner :: USize.try_from(k).map_err(fn(error) { JetComputeError.InvalidShape("CUDA matmul inner dimension is too large") })?
        cols :: USize.try_from(n).map_err(fn(error) { JetComputeError.InvalidShape("CUDA matmul columns are too large") })?
        left :: jet_compute_cuda_values(a, "matmul input")?
        right :: jet_compute_cuda_values(b, "matmul input")?
        data :: jet_compute_cuda.matmul(left, right, rows, inner, cols)?
        return jet_compute_record(jet_compute_cuda_result_like(a, [m, n], ^data)?, &[a, b], [a.clone(), b.clone()], JetComputeTapeRule.Matmul)
    }
    if a.device == JetComputeDevice.Vulkan {
        rows :: USize.try_from(m).map_err(fn(error) { JetComputeError.InvalidShape("Vulkan matmul rows are too large") })?
        inner :: USize.try_from(k).map_err(fn(error) { JetComputeError.InvalidShape("Vulkan matmul inner dimension is too large") })?
        cols :: USize.try_from(n).map_err(fn(error) { JetComputeError.InvalidShape("Vulkan matmul columns are too large") })?
        left :: jet_compute_vulkan_values(a, "matmul input")?
        right :: jet_compute_vulkan_values(b, "matmul input")?
        data :: jet_compute_vulkan.matmul(left, right, rows, inner, cols)?
        return jet_compute_record(jet_compute_vulkan_result_like(a, [m, n], ^data)?, &[a, b], [a.clone(), b.clone()], JetComputeTapeRule.Matmul)
    }
    if a.device == JetComputeDevice.WebGpu {
        rows :: USize.try_from(m).map_err(fn(error) { JetComputeError.InvalidShape("WebGPU matmul rows are too large") })?
        inner :: USize.try_from(k).map_err(fn(error) { JetComputeError.InvalidShape("WebGPU matmul inner dimension is too large") })?
        cols :: USize.try_from(n).map_err(fn(error) { JetComputeError.InvalidShape("WebGPU matmul columns are too large") })?
        left :: jet_compute_webgpu_values(a, "matmul input")?
        right :: jet_compute_webgpu_values(b, "matmul input")?
        data :: jet_compute_webgpu.matmul(left, right, rows, inner, cols)?
        return jet_compute_record(jet_compute_webgpu_result_like(a, [m, n], ^data)?, &[a, b], [a.clone(), b.clone()], JetComputeTapeRule.Matmul)
