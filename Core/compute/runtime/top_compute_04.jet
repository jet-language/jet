        inner :: USize.try_from(k).map_err(fn(error) { JetComputeError.InvalidShape("Metal matmul inner dimension is too large") })?
        cols :: USize.try_from(n).map_err(fn(error) { JetComputeError.InvalidShape("Metal matmul columns are too large") })?
        left :: jet_compute_metal_values(a, "matmul input")?
        right :: jet_compute_metal_values(b, "matmul input")?
