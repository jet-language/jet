fn jet_compute_window_set(tensor: &JetTensor, start: I64, end: I64, exclusive: Bool, index: I64, value: F64) -> () Err! {
    if tensor.trace.is_some() { return Err("Tensor mutation is not differentiable; use a pure Tensor function") }
