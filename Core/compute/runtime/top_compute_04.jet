    start_offset :: base_offset.checked_add(axis.checked_mul(stride).ok_or_else(fn() { JetComputeError.OutOfBounds("Tensor slice start overflows storage") })?)
        .ok_or_else(fn() { JetComputeError.OutOfBounds("Tensor slice start overflows storage") })?
    view_strides := source_strides.to_vec()
    if start_offset != 0 { view_strides.push(I64.try_from(start_offset).map_err(fn(error) { JetComputeError.InvalidShape("Tensor view offset is too large") })?) }
