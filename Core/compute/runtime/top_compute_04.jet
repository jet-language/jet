fn jet_compute_metal_upload(tensor: &JetTensor) -> Result<(), JetComputeError> {
    if tensor.last_placement.profile != CPU_ORACLE_F32_PROFILE { return Err(JetComputeError.Unsupported("Metal transfers support only F32Strict+Reproducible")) }
    if !jet_compute_metal.available() { return Err(JetComputeError.Device("Metal device was lost before transfer")) }
    values :: jet_compute_tensor_values(tensor).into_iter().map(fn(value) { jet_compute_f32_value(value, "Metal transfer") }).collect()?
    jet_compute_metal.copy(values).map(fn(value) { () })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:6765
fn jet_compute_cuda_upload(tensor: &JetTensor) -> Result<(), JetComputeError> {
    if tensor.last_placement.profile != CPU_ORACLE_F32_PROFILE { return Err(JetComputeError.Unsupported("CUDA transfers support only F32Strict+Reproducible")) }
    if !jet_compute_cuda.available() { return Err(JetComputeError.Device("CUDA device was lost before transfer")) }
    values :: jet_compute_tensor_values(tensor).into_iter().map(fn(value) { jet_compute_f32_value(value, "CUDA transfer") }).collect()?
    jet_compute_cuda.copy(values).map(fn(value) { () })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:6783
fn jet_compute_vulkan_upload(tensor: &JetTensor) -> Result<(), JetComputeError> {
    if tensor.last_placement.profile != CPU_ORACLE_F32_PROFILE { return Err(JetComputeError.Unsupported("Vulkan transfers support only F32Strict+Reproducible")) }
    if !jet_compute_vulkan.available() { return Err(JetComputeError.Device("Vulkan device was lost before transfer")) }
    values :: jet_compute_tensor_values(tensor).into_iter().map(fn(value) { jet_compute_f32_value(value, "Vulkan transfer") }).collect()?
    jet_compute_vulkan.copy(values).map(fn(value) { () })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:6801
fn jet_compute_webgpu_upload(tensor: &JetTensor) -> Result<(), JetComputeError> {
    if tensor.last_placement.profile != CPU_ORACLE_F32_PROFILE { return Err(JetComputeError.Unsupported("WebGPU transfers support only F32Strict+Reproducible")) }
    values :: jet_compute_tensor_values(tensor).into_iter().map(fn(value) { jet_compute_f32_value(value, "WebGPU transfer") }).collect()?
    jet_compute_webgpu.copy(values).map(fn(value) { () })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:6814
fn jet_compute_on_device(tensor: &JetTensor, device: JetComputeDevice) -> Result<JetTensor, JetComputeError> {
    jet_compute_validate_tensor(tensor)?
    receipt := jet_compute_place_with_profile(device, tensor.last_placement.profile)?
    match receipt.selected {
        JetComputeDevice.Metal -> jet_compute_metal_upload(tensor)?
        JetComputeDevice.Cuda -> jet_compute_cuda_upload(tensor)?
        JetComputeDevice.Vulkan -> jet_compute_vulkan_upload(tensor)?
        JetComputeDevice.WebGpu -> jet_compute_webgpu_upload(tensor)?
        _ -> {}
    }
    if receipt.selected == JetComputeDevice.Cpu && tensor.last_placement.profile == CPU_ORACLE_F32_PROFILE {
        receipt.reason = if device == JetComputeDevice.Auto { "policy=auto; selected=cpu; ability=cpu-oracle.f32" }
            else { "policy=explicit; selected=cpu; ability=cpu-oracle.f32" }
    }
    // GATE #4565: kernel primitive
    #Unsafe("device placement retains the same validated host backing and trace; provider uploads complete before publication") {
        Ok(JetTensor{shape: tensor.shape.clone(), strides: tensor.strides.clone(), data: tensor.data.clone(),
            device: receipt.selected, last_placement: ^receipt, last_transfer: None, trace: tensor.trace.clone()})
    }
}
// D-COMPUTE1=D / #1136: ndarray broadcast, ufuncs, reductions.
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:6849
fn jet_compute_broadcast_shape(a: &[I64], b: &[I64]) -> Result<[I64], JetComputeError> {
    if a.is_empty() || b.is_empty() { return Err(JetComputeError.InvalidShape("broadcasting requires ranked tensors")) }
    if a.iter().chain(b.iter()).any(fn(dim) { *dim < 0 }) { return Err(JetComputeError.InvalidShape("broadcast shapes cannot contain negative axes")) }
    rank :: a.len().max(b.len())
    out := [I64].repeat(1, rank)
    for i in 0..rank {
        da :: if i < rank - a.len() { 1 } else { a[i - (rank - a.len())] }
        db :: if i < rank - b.len() { 1 } else { b[i - (rank - b.len())] }
        if da == db { out[i] = da }
        else if da == 1 { out[i] = db }
        else if db == 1 { out[i] = da }
        else { return Err(JetComputeError.RankMismatch("cannot broadcast shapes {a:?} and {b:?}")) }
    }
    _ :: jet_compute_storage_len(out)?
    Ok(^out)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:6895
fn jet_compute_materialize_broadcast(tensor: &JetTensor, shape: &[I64]) -> Result<JetTensor, JetComputeError> {
    jet_compute_validate_tensor(tensor)?
    n :: jet_compute_storage_len(shape)?
    strides :: jet_compute_row_major_strides(shape)?
    src_rank :: tensor.shape.len()
    dst_rank :: shape.len()
    if src_rank == 0 || src_rank > dst_rank { return Err(JetComputeError.RankMismatch("cannot broadcast rank {src_rank} into rank {dst_rank}")) }
    if jet_compute_broadcast_shape(tensor.shape, shape)? != shape {
        return Err(JetComputeError.InvalidShape("broadcast target {shape:?} is incompatible with {tensor.shape:?}"))
    }
    // Empty output never reads the source backing.
    if n == 0 { return jet_compute_tensor_from_shape_like(tensor, shape.to_vec(), 0.0) }
    (source_offset, layout_strides) :: jet_compute_broadcast_strided_layout(tensor, shape)?.ok_or_else(fn() {
        JetComputeError.RankMismatch("cannot broadcast rank {src_rank} into rank {dst_rank}")
    })?
    dimensions :: shape.iter().map(fn(dimension) {
        USize.try_from(*dimension).map_err(fn(error) { JetComputeError.InvalidShape("broadcast shape axis is too large") })
    }).collect()?
    source_strides :: layout_strides.iter().map(fn(stride) {
        USize.try_from(*stride).map_err(fn(error) { JetComputeError.InvalidShape("Tensor view strides must be non-negative and representable") })
    }).collect()?
    data := [F64].with_capacity(n)
    coordinates := [USize].repeat(0, dst_rank)
    source_index := source_offset
    for _ in 0..n {
        data.push(tensor.data[source_index])
        axis := dst_rank
        while axis > 0 {
            axis -= 1
            dimension :: dimensions[axis]
            if coordinates[axis] + 1 < dimension {
                coordinates[axis] += 1
                source_index = source_index.checked_add(source_strides[axis]).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })?
                break
            }
            coordinates[axis] = 0
            rewind :: source_strides[axis].checked_mul(dimension - 1).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })?
            source_index = source_index.checked_sub(rewind).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })?
        }
    }
    // GATE #4565: kernel primitive
    output :: #Unsafe("publish a newly owned row-major broadcast backing; source stride iteration never aliases output") {
        JetTensor{strides: ^strides, data: Arc.new(^data), shape: shape.to_vec(), device: JetComputeDevice.Cpu,
            last_placement: jet_compute_place(JetComputeDevice.Cpu)?, last_transfer: None, trace: None}
    }
    Ok(jet_compute_inherit_placement(^output, tensor))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:6990
fn jet_compute_broadcast_to(tensor: &JetTensor, shape: &[I64]) -> Result<JetTensor, JetComputeError> {
    out_shape :: jet_compute_broadcast_shape(tensor.shape, shape)?
    if out_shape != shape { return Err(JetComputeError.InvalidShape("broadcast target {shape:?} is incompatible with {tensor.shape:?}")) }
    output :: jet_compute_materialize_broadcast(tensor, shape)?
    jet_compute_record(^output, &[tensor], [tensor.clone()], JetComputeTapeRule.Broadcast{source_shape: tensor.shape.clone()})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7012
fn jet_compute_transpose(tensor: &JetTensor) -> Result<JetTensor, JetComputeError> {
    jet_compute_validate_tensor(tensor)?
    if tensor.shape.len() != 2 { return Err(JetComputeError.RankMismatch("transpose requires rank-2 tensor")) }
    (source_strides, offset) :: jet_compute_view_metadata(tensor)?
    strides := [source_strides[1], source_strides[0]]
    if offset != 0 { strides.push(I64.try_from(offset).map_err(fn(error) { JetComputeError.InvalidShape("Tensor view offset is too large") })?) }
    // GATE #4565: kernel primitive
    out :: #Unsafe("transpose retains validated backing and exchanges only axis strides, preserving any view offset") {
        JetTensor{shape: [tensor.shape[1], tensor.shape[0]], strides: ^strides, data: tensor.data.clone(),
            device: tensor.device, last_placement: tensor.last_placement.clone(), last_transfer: None, trace: None}
    }
    jet_compute_validate_tensor(&out)?
    jet_compute_record(^out, &[tensor], [tensor.clone()], JetComputeTapeRule.Transpose)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7044
fn jet_compute_sum_axis(tensor: &JetTensor, axis: I64) -> Result<JetTensor, JetComputeError> {
    jet_compute_validate_tensor(tensor)?
    axis :: match USize.try_from(axis).ok().filter(fn(index) { *index < tensor.shape.len() }) {
        Val(index) -> index
        None -> return Err(JetComputeError.OutOfBounds("sum_axis axis {axis} out of range for rank {tensor.shape.len()}"))
    }
    out_shape := [I64]{}
    for (i, d) in tensor.shape.iter().enumerate() { if i != axis { out_shape.push(*d) } }
    if out_shape.is_empty() { out_shape.push(1) }
    (source_strides, source_offset) :: jet_compute_view_metadata(tensor)?
    axis_stride :: USize.try_from(source_strides[axis]).map_err(fn(error) { JetComputeError.InvalidShape("Tensor view strides must be non-negative and representable") })?
    axis_len :: USize.try_from(tensor.shape[axis]).map_err(fn(error) { JetComputeError.InvalidShape("sum_axis extent is too large") })?
    out_n :: USize.try_from(jet_compute_numel(out_shape)?).map_err(fn(error) { JetComputeError.InvalidShape("sum_axis output is too large") })?
    source_data :: tensor.data.as_ref()
    source_offset_for :: fn(flat: USize) -> Result<USize, JetComputeError> {
        remainder := flat
        offset := source_offset
        for source_axis in (0..tensor.shape.len()).rev() {
            if source_axis == axis { continue }
            dimension :: USize.try_from(tensor.shape[source_axis]).map_err(fn(error) { JetComputeError.InvalidShape("Tensor shape axis is too large") })?
            coordinate :: if dimension == 0 { 0 } else { remainder % dimension }
            remainder = if dimension == 0 { 0 } else { remainder / dimension }
            stride :: USize.try_from(source_strides[source_axis]).map_err(fn(error) { JetComputeError.InvalidShape("Tensor view strides must be non-negative and representable") })?
            term :: coordinate.checked_mul(stride).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })?
            offset = offset.checked_add(term).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })?
        }
        Ok(offset)
    }
    if jet_compute_is_accelerator(tensor.device) {
        out := jet_compute_tensor_from_shape_like(tensor, ^out_shape, 0.0)?
        // GATE #4565: kernel primitive
        #Unsafe("sum_axis writes only a newly allocated exclusive Arc output; accelerator reductions finish before tape publication") {
            output_data :: match Arc.get_mut(&out.data) {
                Val(data) -> data
                None -> return Err(JetComputeError.Unsupported("accelerator sum_axis requires exclusive output storage"))
            }
            values := [F32].with_capacity(axis_len)
            for flat in 0..out_n {
                source_index := source_offset_for(flat)?
                values.clear()
                for k in 0..axis_len {
                    values.push(jet_compute_f32_value(source_data[source_index], "accelerator sum input")?)
                    if k + 1 < axis_len { source_index = source_index.checked_add(axis_stride).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })? }
                }
                sum :: if values.is_empty() { 0.0 } else {
                    jet_compute_accelerator_sum(tensor.device, values)?.into_iter().next().ok_or_else(fn() {
                        JetComputeError.Device("{tensor.device.jet_show()} sum returned no value")
                    })?
                }
                output :: F64.from(sum)
                if !output.is_finite() { return Err(JetComputeError.Arithmetic("Tensor values must be finite")) }
                jet_compute_validate_profile_value(tensor.last_placement.profile, output, "Tensor write value")?
                output_data[flat] = output
            }
        }
        return jet_compute_record(^out, &[tensor], [tensor.clone()], JetComputeTapeRule.SumAxis{axis: axis, source_shape: tensor.shape.clone()})
    }
    f32_profile :: tensor.last_placement.profile == CPU_ORACLE_F32_PROFILE
    out := jet_compute_tensor_from_shape_like(tensor, ^out_shape, 0.0)?
    // GATE #4565: kernel primitive
    #Unsafe("CPU reduction writes one exclusive newly allocated backing, retaining source strides and selected precision") {
        output_data :: match Arc.get_mut(&out.data) {
            Val(data) -> data
            None -> return Err(JetComputeError.Unsupported("sum_axis requires exclusive output storage"))
        }
        for flat in 0..out_n {
            source_index := source_offset_for(flat)?
            sum := 0.0
            for k in 0..axis_len {
                value :: source_data[source_index]
                sum = if f32_profile {
                    value :: jet_compute_f32_value(value, "sum_axis input")?
                    F64.from(value + (sum as F32))
                } else { sum + value }
                if !sum.is_finite() { return Err(JetComputeError.Arithmetic("sum_axis accumulation produced a non-finite value")) }
                if k + 1 < axis_len { source_index = source_index.checked_add(axis_stride).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })? }
            }
            output_data[flat] = sum
        }
    }
    jet_compute_record(^out, &[tensor], [tensor.clone()], JetComputeTapeRule.SumAxis{axis: axis, source_shape: tensor.shape.clone()})
}

