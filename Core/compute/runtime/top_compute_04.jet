        _ -> Err(JetComputeError.Device("accelerator scaling requires an accelerator Tensor"))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5955
fn jet_compute_require_same_contract(left: &JetTensor, right: &JetTensor, operation: String) -> Result<(), JetComputeError> {
    if left.device != right.device { return Err(JetComputeError.Device("{operation} tensors must use the same device")) }
    if left.last_placement.profile != right.last_placement.profile { return Err(JetComputeError.Device("{operation} tensors must use the same precision profile")) }
    Ok(())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5973
fn jet_compute_tensor_from_shape(shape: [I64], fill: F64, requested: JetComputeDevice) -> Result<JetTensor, JetComputeError> {
    if !fill.is_finite() { return Err(JetComputeError.Arithmetic("Tensor values must be finite")) }
    strides :: jet_compute_row_major_strides(shape)?
    n :: jet_compute_storage_len(shape)?
    receipt :: jet_compute_place(requested)?
    // GATE #4565: kernel primitive
    #Unsafe("retain new initialized tensor storage in an owned reference-counted allocation") {
        Ok(JetTensor{shape: ^shape, strides: ^strides, data: Arc.new([fill].repeat(n)),
            device: receipt.selected, last_placement: ^receipt, last_transfer: None, trace: None})
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5997
fn jet_compute_zeros(shape: &[I64]) -> Result<JetTensor, JetComputeError> { jet_compute_tensor_from_shape(shape.clone(), 0.0, JetComputeDevice.Auto) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:6001
fn jet_compute_ones(shape: &[I64]) -> Result<JetTensor, JetComputeError> { jet_compute_tensor_from_shape(shape.clone(), 1.0, JetComputeDevice.Auto) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:6005
fn jet_compute_full(shape: &[I64], value: F64) -> Result<JetTensor, JetComputeError> { jet_compute_tensor_from_shape(shape.clone(), value, JetComputeDevice.Auto) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:6009
fn jet_compute_from_list(values: &[F64]) -> Result<JetTensor, JetComputeError> {
    if values.iter().any(fn(value) { !value.is_finite() }) { return Err(JetComputeError.Arithmetic("Tensor values must be finite")) }
    len :: I64.try_from(values.len()).map_err(fn(error) { JetComputeError.InvalidShape("Tensor list is too long") })?
    shape :: [len]
    strides :: jet_compute_row_major_strides(shape)?
    storage_len :: jet_compute_storage_len(shape)?
    receipt :: jet_compute_place(JetComputeDevice.Auto)?
    // GATE #4565: kernel primitive
    #Unsafe("list constructor owns exactly the checked tensor storage projection") {
        Ok(JetTensor{shape: ^shape, strides: ^strides, data: Arc.new(values[..storage_len].to_vec()),
            device: receipt.selected, last_placement: ^receipt, last_transfer: None, trace: None})
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:6033
fn jet_compute_copy_checked(tensor: &JetTensor) -> Result<JetTensor, JetComputeError> {
    jet_compute_validate_tensor(tensor)?
    shape :: tensor.shape.clone()
    // GATE #4565: kernel primitive
    copy :: #Unsafe("copy materializes one independent row-major backing store from validated tensor values") {
        JetTensor{strides: jet_compute_row_major_strides(shape)?, data: Arc.new(jet_compute_tensor_values(tensor)), shape: ^shape,
            device: tensor.device, last_placement: tensor.last_placement.clone(),
            last_transfer: tensor.last_transfer.clone(), trace: tensor.trace.clone()}
    }
    jet_compute_validate_tensor(&copy)?
    Ok(^copy)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:6053
fn jet_compute_replace_data_checked(tensor: &JetTensor, values: [F64]) -> Result<(), JetComputeError> {
    jet_compute_validate_tensor(tensor)?
    if tensor.trace.is_some() { return Err(JetComputeError.Unsupported("Tensor mutation is not differentiable; use a pure Tensor function")) }
    expected :: jet_compute_storage_len(tensor.shape)?
    if values.len() != expected { return Err(JetComputeError.InvalidShape("Tensor write-back length does not match its shape")) }
    // GATE #4565: kernel primitive
    #Unsafe("replace storage only if this tensor is its exclusive Arc owner; no copy-on-write bypass") {
        data :: match Arc.get_mut(&tensor.data) {
            Val(data) -> data
            None -> return Err(JetComputeError.Unsupported("Tensor mutable view requires exclusive backing storage"))
        }
        *data = ^values
    }
    tensor.strides = jet_compute_row_major_strides(tensor.shape)?
    jet_compute_validate_tensor(tensor)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:6079
fn jet_compute_copy(tensor: &JetTensor) -> JetTensor {
    match jet_compute_copy_checked(tensor) {
        Ok(copy) -> ^copy
        Err(error) -> jet_panic("Compute.rs", 6082, error.jet_show())
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:6091
// A bracket range selects whole first-axis slabs; inner axes stay in the same contiguous projection.
fn jet_compute_window_bounds(tensor: &JetTensor, start: I64, end: I64, exclusive: Bool) -> Result<Range<USize>, JetComputeError> {
    jet_compute_validate_tensor(tensor)?
    (strides, offset) :: jet_compute_view_metadata(tensor)?
