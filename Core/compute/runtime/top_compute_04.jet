    axis_len :: tensor.shape.first().copied().ok_or_else(fn() { JetComputeError.InvalidShape("Tensor shape must have at least one axis") })?
    (axis_start, axis_end) :: match jet_range_bounds(start, end, exclusive, axis_len) {
        Val(bounds) -> bounds
        None -> {
            separator :: if exclusive { "..<" } else { ".." }
            return Err(JetComputeError.OutOfBounds("Tensor range {start}{separator}{end} is outside first axis of extent {axis_len}"))
        }
