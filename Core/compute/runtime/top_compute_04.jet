//RS /// Return the flat storage range selected by a bracket range.  A Tensor range
//RS /// selects rows on its first axis, so a rank-2 matrix window keeps complete
//RS /// rows and a higher-rank window keeps complete first-axis slabs.  This is the
//RS /// one-dimensional bracket surface ratified by D-SHAPE-PLACE1; the inner axes
//RS /// remain part of the same contiguous storage projection.
//RS fn jet_compute_window_bounds(
//RS     tensor: &JetTensor,
//RS     start: i64,
//RS     end: i64,
//RS     exclusive: bool,
//RS ) -> Result<std::ops::Range<usize>, JetComputeError> {
//RS     jet_compute_validate_tensor(tensor)?;
//RS     let (strides, offset) = jet_compute_view_metadata(tensor)?;
//RS     let expected_strides = jet_compute_row_major_strides(&tensor.shape)?;
//RS     if strides != expected_strides {
//RS         return Err(JetComputeError::Unsupported(
//RS             "Tensor window is non-contiguous; use the strided View projection".to_string(),
//RS         ));
//RS     }
//RS     let axis_len = tensor.shape.first().copied().ok_or_else(|| {
//RS         JetComputeError::InvalidShape("Tensor shape must have at least one axis".to_string())
//RS     })?;
//RS     let Some((axis_start, axis_end)) = jet_range_bounds(start, end, exclusive, axis_len) else {
//RS         return Err(JetComputeError::OutOfBounds(format!(
//RS             "Tensor range {}{}{} is outside first axis of extent {}",
//RS             start,
//RS             if exclusive { "..<" } else { ".." },
//RS             end,
//RS             axis_len
//RS         )));
//RS     };
//RS     // In row-major storage the first stride is the number of scalar values in
//RS     // one first-axis slab.  For an empty first axis the selected range is also
//RS     // empty, so the stride is still safe to use.
//RS     let slab = strides.first().copied().ok_or_else(|| {
//RS         JetComputeError::InvalidShape("Tensor is missing its first-axis stride".to_string())
//RS     })?;
//RS     let flat_start = axis_start.checked_mul(slab).ok_or_else(|| {
//RS         JetComputeError::OutOfBounds("Tensor view start overflows storage".to_string())
//RS     })?;
//RS     let flat_end = axis_end.checked_mul(slab).ok_or_else(|| {
//RS         JetComputeError::OutOfBounds("Tensor view end overflows storage".to_string())
//RS     })?;
//RS     let start = usize::try_from(flat_start).map_err(|_| {
//RS         JetComputeError::OutOfBounds("Tensor view start is outside storage".to_string())
//RS     })?;
//RS     let end = usize::try_from(flat_end).map_err(|_| {
//RS         JetComputeError::OutOfBounds("Tensor view end is outside storage".to_string())
//RS     })?;
//RS     let start = offset.checked_add(start).ok_or_else(|| {
//RS         JetComputeError::OutOfBounds("Tensor view start overflows storage".to_string())
//RS     })?;
//RS     let end = offset.checked_add(end).ok_or_else(|| {
//RS         JetComputeError::OutOfBounds("Tensor view end overflows storage".to_string())
//RS     })?;
//RS     if end > tensor.data.len() || start > end {
//RS         return Err(JetComputeError::OutOfBounds(
//RS             "Tensor view is outside storage".to_string(),
//RS         ));
//RS     }
//RS     Ok(start..end)
//RS }
