    first_stride :: source_strides.first().copied().ok_or_else(fn() { JetComputeError.InvalidShape("Tensor is missing its first-axis stride") })?
    stride :: USize.try_from(first_stride).map_err(fn(error) { JetComputeError.InvalidShape("Tensor view stride is not representable") })?
