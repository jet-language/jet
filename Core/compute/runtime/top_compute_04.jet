// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5457
fn jet_compute_place(requested: JetComputeDevice) -> Result<JetComputePlacementReceipt, JetComputeError> {
    jet_compute_place_with_profile(requested, CPU_ORACLE_F64_PROFILE)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5463
fn jet_compute_inherit_placement(tensor: JetTensor, source: &JetTensor) -> JetTensor {
    tensor.device = source.device
    tensor.last_placement = source.last_placement.clone()
    tensor.last_transfer = None
    ^tensor
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5470
fn jet_compute_tensor_from_shape_like(source: &JetTensor, shape: [I64], fill: F64) -> Result<JetTensor, JetComputeError> {
    Ok(jet_compute_inherit_placement(jet_compute_tensor_from_shape(^shape, fill, JetComputeDevice.Cpu)?, source))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5481
fn jet_compute_metal_values(tensor: &JetTensor, context: String) -> Result<[F32], JetComputeError> {
    if tensor.device != JetComputeDevice.Metal { return Err(JetComputeError.Device("{context} requires a Metal Tensor")) }
    if tensor.last_placement.profile != CPU_ORACLE_F32_PROFILE { return Err(JetComputeError.Unsupported("Metal {context} supports only F32Strict+Reproducible")) }
    if !jet_compute_metal.available() { return Err(JetComputeError.Device("Metal device was lost before launch")) }
    jet_compute_tensor_values(tensor).into_iter().map(fn(value) { jet_compute_f32_value(value, context) }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5506
fn jet_compute_metal_result_like(source: &JetTensor, shape: [I64], values: [F32]) -> Result<JetTensor, JetComputeError> {
    expected :: jet_compute_storage_len(shape)?
    if values.len() != expected { return Err(JetComputeError.InvalidShape("Metal kernel returned the wrong storage length")) }
    output := jet_compute_tensor_from_shape_like(source, shape.clone(), 0.0)?
    output.strides = jet_compute_row_major_strides(shape)?
    // GATE #4565: kernel primitive
    #Unsafe("retain owned accelerator result storage; no native buffer or alias escapes") { output.data = Arc.new(values.into_iter().map(F64.from).collect()) }
    jet_compute_validate_tensor(&output)?
    Ok(^output)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5524
fn jet_compute_metal_binary_values(op: String, left: [F32], right: [F32]) -> Result<[F32], JetComputeError> {
    opcode :: match op {
        "add" -> 0
        "mul" -> 1
        "sub" -> 2
        "div" -> 3
        "maximum" -> 4
        "minimum" -> 5
        _ -> return Err(JetComputeError.Unsupported("unsupported Metal binary operation `{op}`"))
    }
    jet_compute_metal.binary(opcode, left, right)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5545
fn jet_compute_metal_unary_values(op: String, values: [F32]) -> Result<[F32], JetComputeError> {
    opcode :: match op {
        "negate" -> 0
        "abs" -> 1
        "exp" -> 2
        "log" -> 3
        "sqrt" -> 4
        _ -> return Err(JetComputeError.Unsupported("unsupported Metal unary operation `{op}`"))
    }
    jet_compute_metal.unary(opcode, values)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:5564
fn jet_compute_is_accelerator(device: JetComputeDevice) -> Bool {
    match device {
        JetComputeDevice.Metal | JetComputeDevice.Cuda | JetComputeDevice.Vulkan | JetComputeDevice.WebGpu -> true
        _ -> false
    }
}
