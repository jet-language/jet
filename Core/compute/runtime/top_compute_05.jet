// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7214
fn jet_compute_unary(op: String, tensor: &JetTensor) -> JetTensor JetComputeError! {
    jet_compute_validate_tensor(tensor)?
    if op != "negate" && op != "abs" && op != "exp" && op != "log" && op != "sqrt" {
        return Err(JetComputeError.Unsupported("unsupported unary compute operation `{op}`"))
    }
    if jet_compute_is_accelerator(tensor.device) {
        values :: jet_compute_accelerator_values(tensor, "unary input")?
        if op == "log" && values.iter().any(fn(value) { *value <= 0.0 }) { return Err(JetComputeError.Arithmetic("log requires strictly positive values")) }
        if op == "sqrt" && values.iter().any(fn(value) { *value < 0.0 }) { return Err(JetComputeError.Arithmetic("sqrt requires non-negative values")) }
        data :: jet_compute_accelerator_unary_values(tensor.device, op, &values)?
        return jet_compute_record(jet_compute_accelerator_result_like(tensor, tensor.shape.clone(), ^data)?, &[tensor], [tensor.clone()], JetComputeTapeRule.Unary(op.to_string()))
    }
    f32_profile :: tensor.last_placement.profile == CPU_ORACLE_F32_PROFILE
    expected_len :: jet_compute_storage_len(&tensor.shape)?
    data := [F64].with_capacity(expected_len)
    jet_compute_visit_tensor_values(tensor, fn(value) {
        output :: if f32_profile {
            value :: jet_compute_f32_value(value, "unary input")?
            output :: match op {
                "negate" -> -value
                "abs" -> value.abs()
                "exp" -> value.exp()
                "log" -> {
                    if !(value > 0.0) { return Err(JetComputeError.Arithmetic("log requires strictly positive values")) }
                    value.ln()
                }
                "sqrt" -> {
                    if !(value >= 0.0) { return Err(JetComputeError.Arithmetic("sqrt requires non-negative values")) }
                    value.sqrt()
                }
                _ -> panic("unvalidated unary operation")
            }
            F64{output}
        } else {
            match op {
                "negate" -> -value
                "abs" -> value.abs()
                "exp" -> value.exp()
                "log" -> {
                    if !(value > 0.0) { return Err(JetComputeError.Arithmetic("log requires strictly positive values")) }
                    value.ln()
                }
                "sqrt" -> {
                    if !(value >= 0.0) { return Err(JetComputeError.Arithmetic("sqrt requires non-negative values")) }
                    value.sqrt()
                }
                _ -> panic("unvalidated unary operation")
            }
        }
        if !output.is_finite() { return Err(JetComputeError.Arithmetic("unary operation `{op}` produced a non-finite value")) }
        data.push(output)
        Ok(())
    })?
    shape :: tensor.shape.clone()
    // GATE #4565: kernel primitive
    backing :: #Unsafe("retain freshly allocated unary result storage without copying") { Arc.new(^data) }
    output :: JetTensor{strides: jet_compute_row_major_strides(&shape)?, data: ^backing, shape: ^shape, device: tensor.device, last_placement: tensor.last_placement.clone(), last_transfer: None, trace: None}
    jet_compute_record(^output, &[tensor], [tensor.clone()], JetComputeTapeRule.Unary(op.to_string()))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7312
fn jet_compute_binary_element(op: String, x: F64, y: F64, f32_profile: Bool) -> F64 JetComputeError! {
    if op == "div" && y == 0.0 { return Err(JetComputeError.Arithmetic("division by zero in compute operation")) }
    output :: if f32_profile {
        x :: jet_compute_f32_value(x, "binary operation input")?
        y :: jet_compute_f32_value(y, "binary operation input")?
        output :: match op {
            "sub" -> x - y, "div" -> x / y, "maximum" -> x.max(y),
            "minimum" -> x.min(y), "add" -> x + y, "mul" -> x * y,
            _ -> panic("unvalidated binary operation")
        }
        F64{output}
    } else {
        match op {
            "sub" -> x - y, "div" -> x / y, "maximum" -> x.max(y),
            "minimum" -> x.min(y), "add" -> x + y, "mul" -> x * y,
            _ -> panic("unvalidated binary operation")
        }
    }
    if !output.is_finite() { return Err(JetComputeError.Arithmetic("compute operation produced a non-finite value")) }
    Ok(output)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7355
fn jet_compute_contiguous_broadcast_layout(tensor: &JetTensor, output_shape: &[I64]) -> (USize, [I64])? JetComputeError! {
    if tensor.shape.len() > output_shape.len() { return Ok(None) }
    source_strides :: jet_compute_row_major_strides(&tensor.shape)?
    (strides, offset) :: jet_compute_view_metadata(tensor)?
    if strides != source_strides { return Ok(None) }
    rank_delta :: output_shape.len() - tensor.shape.len()
    effective_strides := [I64].with_capacity(output_shape.len())
    for axis in 0..output_shape.len() {
        if axis < rank_delta { effective_strides.push(0); continue }
        source_axis :: axis - rank_delta
        effective_strides.push(if tensor.shape[source_axis] == 1 { 0 } else { source_strides[source_axis] })
    }
    Ok(Val((offset, ^effective_strides)))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7384
fn jet_compute_broadcast_strided_layout(tensor: &JetTensor, output_shape: &[I64]) -> (USize, [I64])? JetComputeError! {
    if tensor.shape.len() > output_shape.len() { return Ok(None) }
    (source_strides, offset) :: jet_compute_view_metadata(tensor)?
    rank_delta :: output_shape.len() - tensor.shape.len()
    effective_strides := [I64].with_capacity(output_shape.len())
    for axis in 0..output_shape.len() {
        if axis < rank_delta { effective_strides.push(0); continue }
        source_axis :: axis - rank_delta
        effective_strides.push(if tensor.shape[source_axis] == 1 { 0 } else { source_strides[source_axis] })
    }
    Ok(Val((offset, ^effective_strides)))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7409
fn jet_compute_binary_strided(op: String, a: &JetTensor, b: &JetTensor, shape: &[I64], f32_profile: Bool) -> [F64] JetComputeError! {
    (left_offset, left_strides) :: jet_compute_broadcast_strided_layout(a, shape)?.ok_or_else(fn() { JetComputeError.RankMismatch("left tensor rank exceeds broadcast output rank") })?
    (right_offset, right_strides) :: jet_compute_broadcast_strided_layout(b, shape)?.ok_or_else(fn() { JetComputeError.RankMismatch("right tensor rank exceeds broadcast output rank") })?
    n :: jet_compute_storage_len(shape)?
    if n == 0 { return Ok([]) }
    row_width :: USize.try_from(*shape.last().ok_or_else(fn() { JetComputeError.InvalidShape("Tensor shape must have at least one axis") })?).map_err(fn(_) { JetComputeError.InvalidShape("Tensor row width is too large") })?
    if row_width == 0 { return Ok([]) }
    row_count :: n / row_width
    left_column_stride :: USize.try_from(*left_strides.last().ok_or_else(fn() { JetComputeError.InvalidShape("Tensor shape must have at least one axis") })?).map_err(fn(_) { JetComputeError.InvalidShape("Tensor view strides must be non-negative and representable") })?
    right_column_stride :: USize.try_from(*right_strides.last().ok_or_else(fn() { JetComputeError.InvalidShape("Tensor shape must have at least one axis") })?).map_err(fn(_) { JetComputeError.InvalidShape("Tensor view strides must be non-negative and representable") })?
    data := [F64].with_capacity(n)
    for row in 0..row_count {
        left_index := jet_compute_contiguous_row_offset(row, shape, &left_strides, left_offset)?
        right_index := jet_compute_contiguous_row_offset(row, shape, &right_strides, right_offset)?
        for _ in 0..row_width {
            x :: a.data[left_index]
            y :: b.data[right_index]
            data.push(jet_compute_binary_element(op, x, y, f32_profile)?)
            left_index = left_index.checked_add(left_column_stride).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })?
            right_index = right_index.checked_add(right_column_stride).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })?
        }
    }
    Ok(^data)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7484
fn jet_compute_contiguous_row_offset(row: USize, shape: &[I64], effective_strides: &[I64], base_offset: USize) -> USize JetComputeError! {
    remainder := row
    relative_offset := USize{0}
    for axis in (0..shape.len().saturating_sub(1)).rev() {
        dim :: USize.try_from(shape[axis]).map_err(fn(_) { JetComputeError.InvalidShape("Tensor shape axis is too large") })?
        if dim == 0 { return Err(JetComputeError.InvalidShape("Tensor row axis cannot be empty")) }
        index :: remainder % dim
        remainder /= dim
        stride :: USize.try_from(effective_strides[axis]).map_err(fn(_) { JetComputeError.InvalidShape("Tensor view strides must be non-negative and representable") })?
        term :: index.checked_mul(stride).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })?
        relative_offset = relative_offset.checked_add(term).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })?
    }
    base_offset.checked_add(relative_offset).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7520
fn jet_compute_binary_contiguous(op: String, a: &JetTensor, b: &JetTensor, shape: &[I64], f32_profile: Bool) -> [F64]? JetComputeError! {
    (left_offset, left_strides) :: match jet_compute_contiguous_broadcast_layout(a, shape)? {
        Val(layout) -> layout
        None -> return Ok(None)
    }
    (right_offset, right_strides) :: match jet_compute_contiguous_broadcast_layout(b, shape)? {
        Val(layout) -> layout
        None -> return Ok(None)
    }
    n :: jet_compute_storage_len(shape)?
    if n == 0 { return Ok(Val([])) }
    // Equal-shape row-major tensors write directly into the one output allocation.
    if !shape.is_empty() && a.shape.as_slice() == shape && b.shape.as_slice() == shape {
        expected_strides :: jet_compute_row_major_strides(shape)?
        (left_source_strides, left_source_offset) :: jet_compute_view_metadata(a)?
        (right_source_strides, right_source_offset) :: jet_compute_view_metadata(b)?
        if left_source_strides == expected_strides.as_slice() && right_source_strides == expected_strides.as_slice() {
            left_end :: left_source_offset.checked_add(n).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })?
            right_end :: right_source_offset.checked_add(n).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })?
            left_values :: a.data.get(left_source_offset..left_end).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index is outside storage") })?
            right_values :: b.data.get(right_source_offset..right_end).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index is outside storage") })?
            data := [F64].with_capacity(n)
            for (x, y) in left_values.iter().zip(right_values) { data.push(jet_compute_binary_element(op, *x, *y, f32_profile)?) }
            return Ok(Val(^data))
        }
    }
    row_width :: USize.try_from(*shape.last().ok_or_else(fn() { JetComputeError.InvalidShape("Tensor shape must have at least one axis") })?).map_err(fn(_) { JetComputeError.InvalidShape("Tensor row width is too large") })?
    if row_width == 0 { return Ok(Val([])) }
    row_count :: n / row_width
    left_column_stride :: USize.try_from(*left_strides.last().ok_or_else(fn() { JetComputeError.InvalidShape("Tensor shape must have at least one axis") })?).map_err(fn(_) { JetComputeError.InvalidShape("Tensor view strides must be non-negative and representable") })?
    right_column_stride :: USize.try_from(*right_strides.last().ok_or_else(fn() { JetComputeError.InvalidShape("Tensor shape must have at least one axis") })?).map_err(fn(_) { JetComputeError.InvalidShape("Tensor view strides must be non-negative and representable") })?
    data := [F64].with_capacity(n)
    for row in 0..row_count {
        left_index := jet_compute_contiguous_row_offset(row, shape, &left_strides, left_offset)?
        right_index := jet_compute_contiguous_row_offset(row, shape, &right_strides, right_offset)?
        for _ in 0..row_width {
            x :: a.data[left_index]
            y :: b.data[right_index]
            data.push(jet_compute_binary_element(op, x, y, f32_profile)?)
            left_index = left_index.checked_add(left_column_stride).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })?
            right_index = right_index.checked_add(right_column_stride).ok_or_else(fn() { JetComputeError.OutOfBounds("tensor index offset overflow") })?
        }
    }
    Ok(Val(^data))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7620
fn jet_compute_binary(op: String, a: &JetTensor, b: &JetTensor) -> JetTensor JetComputeError! {
    jet_compute_validate_tensor(a)?
    jet_compute_validate_tensor(b)?
    jet_compute_require_same_contract(a, b, "compute operation")?
    shape :: jet_compute_broadcast_shape(&a.shape, &b.shape)?
    if op != "sub" && op != "div" && op != "maximum" && op != "minimum" && op != "add" && op != "mul" { return Err(JetComputeError.Unsupported("unsupported binary compute operation `{op}`")) }
    rule :: match op {
        "add" -> JetComputeTapeRule.Add
        "sub" -> JetComputeTapeRule.Sub
        "mul" -> JetComputeTapeRule.Mul
        "div" -> JetComputeTapeRule.Div
        "maximum" -> JetComputeTapeRule.Maximum
        "minimum" -> JetComputeTapeRule.Minimum
        _ -> panic("validated binary operation")
    }
    if jet_compute_is_accelerator(a.device) {
        left :: jet_compute_materialize_broadcast(a, &shape)?
        right :: jet_compute_materialize_broadcast(b, &shape)?
        left_values :: jet_compute_accelerator_values(&left, "binary input")?
        right_values :: jet_compute_accelerator_values(&right, "binary input")?
        if op == "div" && right_values.iter().any(fn(value) { *value == 0.0 }) { return Err(JetComputeError.Arithmetic("division by zero in compute operation")) }
        data :: jet_compute_accelerator_binary_values(a.device, op, &left_values, &right_values)?
        return jet_compute_record(jet_compute_accelerator_result_like(a, ^shape, ^data)?, &[a, b], [a.clone(), b.clone()], ^rule)
    }
    f32_profile :: a.last_placement.profile == CPU_ORACLE_F32_PROFILE
    data :: match jet_compute_binary_contiguous(op, a, b, &shape, f32_profile)? {
        Val(data) -> ^data
        None -> jet_compute_binary_strided(op, a, b, &shape, f32_profile)?
    }
    strides :: jet_compute_row_major_strides(&shape)?
    // GATE #4565: kernel primitive
    backing :: #Unsafe("retain freshly allocated binary result storage without copying") { Arc.new(^data) }
    output :: JetTensor{strides: ^strides, data: ^backing, shape: ^shape, device: JetComputeDevice.Cpu, last_placement: a.last_placement.clone(), last_transfer: None, trace: None}
    jet_compute_record(^output, &[a, b], [a.clone(), b.clone()], ^rule)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7683
fn jet_compute_eye(n: I64) -> JetTensor JetComputeError! {
    if n < 0 { return Err(JetComputeError.InvalidShape("eye size must be non-negative")) }
    out := jet_compute_tensor_from_shape([n, n], 0.0, JetComputeDevice.Cpu)?
    for i in 0..n { jet_compute_set(&out, &[i, i], 1.0)? }
    Ok(^out)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7696
fn jet_compute_det(tensor: &JetTensor) -> F64 JetComputeError! {
    jet_compute_validate_tensor(tensor)?
    if jet_compute_is_accelerator(tensor.device) { return Err(JetComputeError.Unsupported("accelerator backend does not support det; transfer to CPU explicitly")) }
    if tensor.trace.is_some() { return Err(JetComputeError.Unsupported("det has no registered autodiff rule")) }
    if tensor.shape.len() != 2 || tensor.shape[0] != tensor.shape[1] { return Err(JetComputeError.RankMismatch("det requires a square rank-2 tensor")) }
    n :: USize.try_from(tensor.shape[0]).map_err(fn(_) { JetComputeError.InvalidShape("det dimension is too large") })?
    matrix_len :: n.checked_mul(n).ok_or_else(fn() { JetComputeError.InvalidShape("det matrix storage length overflow") })?
    values :: jet_compute_tensor_values(tensor)
    if matrix_len != values.len() { return Err(JetComputeError.InvalidShape("det matrix storage is inconsistent")) }
    a := values.to_vec()
    det := 1.0
    for i in 0..n {
        pivot := i
        for r in i..n { if a[r * n + i].abs() > a[pivot * n + i].abs() { pivot = r } }
        if a[pivot * n + i].abs() < 1e-15 { return Ok(0.0) }
        if pivot != i {
            for c in 0..n { a.swap(i * n + c, pivot * n + c) }
            det = -det
        }
        piv :: a[i * n + i]
        det *= piv
        if !det.is_finite() { return Err(JetComputeError.Arithmetic("det overflowed to a non-finite value")) }
        for r in (i + 1)..n {
            factor :: a[r * n + i] / piv
            if !factor.is_finite() { return Err(JetComputeError.Arithmetic("det elimination produced a non-finite factor")) }
            for c in i..n {
                a[r * n + c] -= factor * a[i * n + c]
                if !a[r * n + c].is_finite() { return Err(JetComputeError.Arithmetic("det elimination produced a non-finite value")) }
            }
        }
    }
    Ok(det)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7770
fn jet_compute_inv(tensor: &JetTensor) -> JetTensor JetComputeError! {
    if tensor.trace.is_some() { return Err(JetComputeError.Unsupported("inv has no registered autodiff rule")) }
    if tensor.shape.len() != 2 || tensor.shape[0] != tensor.shape[1] { return Err(JetComputeError.RankMismatch("inv requires a square rank-2 tensor")) }
    jet_compute_validate_tensor(tensor)?
    if jet_compute_is_accelerator(tensor.device) { return Err(JetComputeError.Unsupported("accelerator backend does not support inv; transfer to CPU explicitly")) }
    n :: USize.try_from(tensor.shape[0]).map_err(fn(_) { JetComputeError.InvalidShape("inv dimension is too large") })?
    width :: n.checked_mul(2).ok_or_else(fn() { JetComputeError.InvalidShape("inv augmented width overflow") })?
    matrix_len :: n.checked_mul(width).ok_or_else(fn() { JetComputeError.InvalidShape("inv matrix storage length overflow") })?
    if matrix_len > MAX_TENSOR_ELEMENTS { return Err(JetComputeError.InvalidShape("inv workspace exceeds the Core storage limit")) }
    a := [F64{0.0}].repeat(matrix_len)
    for i in 0..n {
        for j in 0..n {
            a[i * width + j] = jet_compute_get_raw(tensor, &[I64{i}, I64{j}])?
            a[i * width + n + j] = if i == j { 1.0 } else { 0.0 }
        }
    }
    for i in 0..n {
        pivot := i
        for r in i..n { if a[r * width + i].abs() > a[pivot * width + i].abs() { pivot = r } }
        if a[pivot * width + i].abs() < 1e-15 { return Err(JetComputeError.InvalidShape("matrix is singular")) }
        if pivot != i { for c in 0..width { a.swap(i * width + c, pivot * width + c) } }
        piv :: a[i * width + i]
        for c in 0..width {
            a[i * width + c] /= piv
            if !a[i * width + c].is_finite() { return Err(JetComputeError.Arithmetic("inv normalization produced a non-finite value")) }
        }
        for r in 0..n {
            if r == i { continue }
            factor :: a[r * width + i]
            for c in 0..width {
                a[r * width + c] -= factor * a[i * width + c]
                if !a[r * width + c].is_finite() { return Err(JetComputeError.Arithmetic("inv elimination produced a non-finite value")) }
            }
        }
    }
    out := jet_compute_tensor_from_shape([tensor.shape[0], tensor.shape[1]], 0.0, JetComputeDevice.Cpu)?
    for i in 0..n { for j in 0..n { jet_compute_set(&out, &[I64{i}, I64{j}], a[i * width + n + j])? } }
    Ok(^out)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7862
fn jet_compute_solve(a: &JetTensor, b: &JetTensor) -> JetTensor JetComputeError! {
    if a.trace.is_some() || b.trace.is_some() { return Err(JetComputeError.Unsupported("solve has no registered autodiff rule")) }
    if a.shape.len() != 2 || a.shape[0] != a.shape[1] { return Err(JetComputeError.RankMismatch("solve requires a square rank-2 coefficient tensor")) }
    jet_compute_validate_tensor(a)?
    jet_compute_validate_tensor(b)?
    if jet_compute_is_accelerator(a.device) || jet_compute_is_accelerator(b.device) { return Err(JetComputeError.Unsupported("accelerator backend does not support solve; transfer inputs to CPU explicitly")) }
    n :: USize.try_from(a.shape[0]).map_err(fn(_) { JetComputeError.InvalidShape("solve dimension is too large") })?
    rhs_cols :: match b.shape.as_slice() {
        [rows] if *rows == a.shape[0] -> USize{1}
        [rows, cols] if *rows == a.shape[0] && *cols >= 0 -> USize.try_from(*cols).map_err(fn(_) { JetComputeError.InvalidShape("solve right-hand side is too large") })?
        _ -> return Err(JetComputeError.RankMismatch("solve expects a length-{a.shape[0]} vector or a matrix with {a.shape[0]} rows"))
    }
    width :: n.checked_add(rhs_cols).ok_or_else(fn() { JetComputeError.InvalidShape("solve augmented width overflow") })?
    workspace :: n.checked_mul(width).ok_or_else(fn() { JetComputeError.InvalidShape("solve workspace length overflow") })?
    if workspace > MAX_TENSOR_ELEMENTS { return Err(JetComputeError.InvalidShape("solve workspace exceeds the Core storage limit")) }
    augmented := (0..n).map(fn(_) { [F64{0.0}].repeat(width) }).collect::<[[F64]]>()
    for row in 0..n {
        for col in 0..n { augmented[row][col] = jet_compute_get_raw(a, &[I64{row}, I64{col}])? }
        for col in 0..rhs_cols {
            augmented[row][n + col] = if b.shape.len() == 1 { jet_compute_get_raw(b, &[I64{row}])? } else { jet_compute_get_raw(b, &[I64{row}, I64{col}])? }
        }
    }
    for pivot in 0..n {
        best := pivot
        for row in pivot..n { if augmented[row][pivot].abs() > augmented[best][pivot].abs() { best = row } }
        if augmented[best][pivot].abs() < 1e-15 { return Err(JetComputeError.Arithmetic("solve coefficient matrix is singular")) }
        augmented.swap(pivot, best)
        divisor :: augmented[pivot][pivot]
