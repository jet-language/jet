fn jet_compute_transfer(tensor: &JetTensor, device: JetComputeDevice) -> JetTensor JetComputeError! {
    jet_compute_validate_tensor(tensor)?
    scalar_bytes :: if tensor.last_placement.profile == CPU_ORACLE_F32_PROFILE { mem.size_of<F32>() } else { mem.size_of<F64>() }
    logical_byte_count :: jet_compute_tensor_values(tensor).len().checked_mul(scalar_bytes).and_then(fn(bytes) { I64.try_from(bytes).ok() }).ok_or_else(fn() { JetComputeError.Device("transfer byte count overflow") })?
    from :: tensor.device
    out := jet_compute_on_device(tensor, device)?
    if jet_compute_is_accelerator(from) && out.device == JetComputeDevice.Cpu {
        values :: jet_compute_accelerator_values(tensor, "download")?
        values :: match from {
            JetComputeDevice.Metal -> jet_compute_metal.copy(&values)?
            JetComputeDevice.Cuda -> jet_compute_cuda.copy(&values)?
            JetComputeDevice.Vulkan -> jet_compute_vulkan.copy(&values)?
            JetComputeDevice.WebGpu -> jet_compute_webgpu.copy(&values)?
            _ -> return Err(JetComputeError.Device("download source is not an accelerator"))
        }
        out.strides = jet_compute_row_major_strides(&out.shape)?
        // GATE #4565: kernel primitive
        #Unsafe("retain completed device download as owned CPU storage") { out.data = Arc.new(values.into_iter().map(F64.from).collect()) }
        jet_compute_validate_tensor(&out)?
