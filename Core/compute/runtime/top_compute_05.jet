// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8259
fn jet_compute_stream_new_on_device(requested: JetComputeDevice) -> JetComputeStream JetComputeError! {
    receipt :: jet_compute_place_with_profile(requested, CPU_ORACLE_F32_PROFILE)?
    // GATE #4565: kernel primitive
    #Unsafe("allocate retained native streams and reserve a process-local relaxed atomic identity") {
        static NEXT_STREAM_ID: AtomicI64 = AtomicI64.new(1)
        cuda :: if receipt.selected == JetComputeDevice.Cuda { Val(Arc.new(jet_compute_cuda.stream_new()?)) } else { None }
        vulkan :: if receipt.selected == JetComputeDevice.Vulkan { Val(Arc.new(jet_compute_vulkan.stream_new()?)) } else { None }
        Ok(JetComputeStream{id: NEXT_STREAM_ID.fetch_add(1, Ordering.Relaxed), device: receipt.selected, cuda: ^cuda, vulkan: ^vulkan})
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8283
fn jet_compute_stream_sync(stream: &JetComputeStream) -> () JetComputeError! {
    if stream.id <= 0 { return Err(JetComputeError.Device("cannot synchronize an invalid compute stream")) }
    match stream.device {
        JetComputeDevice.Metal if !jet_compute_metal.available() -> return Err(JetComputeError.Device("Metal device was lost before stream synchronization"))
        JetComputeDevice.Cuda -> {
            cuda :: stream.cuda.as_ref().ok_or_else(fn() { JetComputeError.Device("CUDA stream has no live driver handle") })?
            jet_compute_cuda.stream_sync(cuda)?
        }
        JetComputeDevice.Vulkan -> {
            vulkan :: stream.vulkan.as_ref().ok_or_else(fn() { JetComputeError.Device("Vulkan stream has no live device context") })?
            jet_compute_vulkan.stream_sync(vulkan)?
        }
        JetComputeDevice.WebGpu if !jet_compute_webgpu.available() -> return Err(JetComputeError.Device("WebGPU device was lost before stream synchronization"))
        _ -> {}
    }
    // GATE #4565: kernel primitive
    #Unsafe("publish completion only to the existing current native resource frame") {
        if ResourceSchedule.current_frame_completion_state().is_some() {
            ResourceSchedule.signal_frame_completion("jet_compute_stream_sync").map_err(JetComputeError.Device)?
        }
    }
    Ok(())
}
