// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8108
fn jet_compute_fft(tensor: &JetTensor) -> JetTensor JetComputeError! {
    if tensor.trace.is_some() { return Err(JetComputeError.Unsupported("fft has no registered autodiff rule")) }
    jet_compute_validate_tensor(tensor)?
    if jet_compute_is_accelerator(tensor.device) { return Err(JetComputeError.Unsupported("accelerator backend does not support fft; transfer to CPU explicitly")) }
    if tensor.shape.len() != 1 { return Err(JetComputeError.RankMismatch("fft requires a rank-1 tensor")) }
    values :: jet_compute_tensor_values(tensor)
    n :: values.len()
    output_len :: n.checked_mul(2).and_then(fn(length) { I64.try_from(length).ok() }).ok_or_else(fn() { JetComputeError.InvalidShape("fft output length overflow") })?
    f32_profile :: tensor.last_placement.profile == CPU_ORACLE_F32_PROFILE
    output_data :: if n == 0 { [] } else if f32_profile {
        values :: values.into_iter().map(fn(value) { F32{value} }).collect::<[F32]>()
        jet_compute_fft_radix2_f32(^values)?
    } else { jet_compute_fft_radix2_f64(^values)? }
    output_shape :: [output_len]
    // GATE #4565: kernel primitive
    backing :: #Unsafe("retain freshly allocated FFT output storage without copying") { Arc.new(^output_data) }
    output := JetTensor{strides: jet_compute_row_major_strides(&output_shape)?, data: ^backing, shape: ^output_shape, device: JetComputeDevice.Cpu, last_placement: jet_compute_place(JetComputeDevice.Cpu)?, last_transfer: None, trace: None}
    output = jet_compute_inherit_placement(^output, tensor)
    jet_compute_validate_tensor(&output)?
    Ok(^output)
}
