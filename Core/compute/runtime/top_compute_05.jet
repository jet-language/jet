// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8401
fn jet_compute_kernel_bounds_ok(shape: &[I64], indices: &[I64]) -> Bool JetComputeError! {
    if shape.len() != indices.len() { return Err(JetComputeError.RankMismatch("kernel index rank must match tensor shape")) }
    _ :: jet_compute_storage_len(shape)?
    if shape.iter().any(fn(dim) { *dim < 0 }) { return Err(JetComputeError.InvalidShape("kernel shape axes must be non-negative")) }
    for (i, (idx, dim)) in indices.iter().zip(shape.iter()).enumerate() {
