        // GATE #4565: kernel primitive
        #Unsafe("write reduction results only into exclusively owned output storage") {
            storage :: Arc.get_mut(&out.data).ok_or_else(fn() { JetComputeError.Unsupported("accelerator gradient accumulation requires exclusive output storage") })?
            for (slot, sum) in storage.iter_mut().zip(sums) { *slot = F64{sum} }
        }
        return jet_compute_record(^out, &[tensor], [tensor.clone()], JetComputeTapeRule.ReduceToShape{source_shape: tensor.shape.clone()})
    }
    for flat in 0..values.len() {
        rem := I64{flat}
        output_coords := [I64{0}].repeat(tensor.shape.len())
        for axis in (0..tensor.shape.len()).rev() {
            dim :: tensor.shape[axis]
            output_coords[axis] = if dim == 0 { 0 } else { rem % dim }
            rem = if dim == 0 { 0 } else { rem / dim }
        }
        target_coords := [I64{0}].repeat(target_shape.len())
        for axis in 0..target_shape.len() {
            source_axis :: axis + rank_delta
            target_coords[axis] = if target_shape[axis] == 1 { 0 } else { output_coords[source_axis] }
        }
        target_offset :: jet_compute_offset(&out, &target_coords)?
        // GATE #4565: kernel primitive
        #Unsafe("accumulate into checked slot of exclusively owned gradient storage") {
            data :: Arc.get_mut(&out.data).ok_or_else(fn() { JetComputeError.Unsupported("gradient accumulation requires exclusive output storage") })?
            slot :: data.get_mut(target_offset).ok_or_else(fn() { JetComputeError.OutOfBounds("gradient accumulation is outside storage") })?
            *slot = if f32_profile {
                previous :: jet_compute_f32_value(*slot, "gradient accumulation")?
                value :: jet_compute_f32_value(values[flat], "gradient accumulation")?
                F64{previous + value}
            } else { *slot + values[flat] }
            if !slot.is_finite() { return Err(JetComputeError.Arithmetic("gradient accumulation produced a non-finite value")) }
        }
    }
    jet_compute_record(^out, &[tensor], [tensor.clone()], JetComputeTapeRule.ReduceToShape{source_shape: tensor.shape.clone()})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8561
fn jet_compute_zero_like(tensor: &JetTensor) -> JetTensor JetComputeError! {
    Ok(jet_compute_inherit_placement(jet_compute_tensor_from_shape(tensor.shape.clone(), 0.0, JetComputeDevice.Cpu)?, tensor))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8568
fn jet_compute_tensor_from_values_like(template: &JetTensor, values: &[F64]) -> JetTensor JetComputeError! {
    expected :: jet_compute_storage_len(&template.shape)?
    if values.len() != expected || values.iter().any(fn(value) { !value.is_finite() }) { return Err(JetComputeError.Arithmetic("autodiff values do not match the Tensor shape")) }
    output := jet_compute_tensor_from_shape(template.shape.clone(), 0.0, JetComputeDevice.Cpu)?
    // GATE #4565: kernel primitive
    #Unsafe("initialize autodiff result only through exclusive owned storage") {
        storage :: Arc.get_mut(&output.data).ok_or_else(fn() { JetComputeError.Unsupported("autodiff output requires exclusive storage") })?
        storage.clone_from_slice(values)
    }
    output :: jet_compute_inherit_placement(^output, template)
    jet_compute_validate_tensor(&output)?
    Ok(^output)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8594
fn jet_compute_unary_vjp(op: String, input: &JetTensor, output: &JetTensor, cot: &JetTensor) -> JetTensor JetComputeError! {
    jet_compute_validate_tensor(input)?
    jet_compute_validate_tensor(output)?
    jet_compute_validate_tensor(cot)?
    if input.shape != output.shape || output.shape != cot.shape { return Err(JetComputeError.RankMismatch("unary cotangent shape must equal the unary output")) }
    jet_compute_require_same_contract(input, output, "unary cotangent")?
    jet_compute_require_same_contract(output, cot, "unary cotangent")?
    input_values :: jet_compute_tensor_values(input)
    match op {
        "negate" -> jet_compute_unary("negate", cot)
        "abs" -> {
            signs :: input_values.iter().map(fn(value) { if *value > 0.0 { 1.0 } else if *value < 0.0 { -1.0 } else { 0.0 } }).collect::<[F64]>()
            signs :: jet_compute_tensor_from_values_like(input, &signs)?
            jet_compute_binary("mul", &signs, cot)
        }
        "exp" -> jet_compute_binary("mul", output, cot)
        "log" -> jet_compute_binary("div", cot, input)
        "sqrt" -> {
            two :: jet_compute_tensor_from_shape_like(output, output.shape.clone(), 2.0)?
            denominator :: jet_compute_binary("mul", &two, output)?
            jet_compute_binary("div", cot, &denominator)
        }
        _ -> Err(JetComputeError.Unsupported("unsupported unary derivative `{op}`"))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8642
fn jet_compute_rule_gradients(rule: &JetComputeTapeRule, values: &[JetTensor], output: &JetTensor, cot: &JetTensor, active_tape: &Arc<Mutex<JetComputeTape>>) -> [JetTensor] JetComputeError! {
    cot :: jet_compute_remove_trace_level(cot, active_tape)
    match rule {
        JetComputeTapeRule.Add -> {
            a :: jet_compute_reduce_to_shape(&cot, &values[0].shape)?
            b :: jet_compute_reduce_to_shape(&cot, &values[1].shape)?
            Ok([jet_compute_inherit_placement(^a, &values[0]), jet_compute_inherit_placement(^b, &values[1])])
        }
        JetComputeTapeRule.Sub -> {
            a :: jet_compute_reduce_to_shape(&cot, &values[0].shape)?
            negative :: jet_compute_unary("negate", &cot)?
            b :: jet_compute_reduce_to_shape(&negative, &values[1].shape)?
            Ok([jet_compute_inherit_placement(^a, &values[0]), jet_compute_inherit_placement(^b, &values[1])])
        }
        JetComputeTapeRule.Mul -> {
            a_full :: jet_compute_binary("mul", &values[1], &cot)?
            b_full :: jet_compute_binary("mul", &values[0], &cot)?
            a :: jet_compute_reduce_to_shape(&a_full, &values[0].shape)?
            b :: jet_compute_reduce_to_shape(&b_full, &values[1].shape)?
            Ok([jet_compute_inherit_placement(^a, &values[0]), jet_compute_inherit_placement(^b, &values[1])])
        }
        JetComputeTapeRule.Div -> {
            a_full :: jet_compute_binary("div", &cot, &values[1])?
            denominator :: jet_compute_binary("mul", &values[1], &values[1])?
            numerator :: jet_compute_binary("mul", &values[0], &cot)?
            b_full :: jet_compute_unary("negate", &jet_compute_binary("div", &numerator, &denominator)?)?
            a :: jet_compute_reduce_to_shape(&a_full, &values[0].shape)?
            b :: jet_compute_reduce_to_shape(&b_full, &values[1].shape)?
            Ok([jet_compute_inherit_placement(^a, &values[0]), jet_compute_inherit_placement(^b, &values[1])])
        }
        JetComputeTapeRule.Maximum | JetComputeTapeRule.Minimum -> {
            maximum :: matches(rule, JetComputeTapeRule.Maximum)
            output_values :: jet_compute_tensor_values(output)
            left_value :: if values[0].shape == output.shape { values[0].clone() } else { jet_compute_materialize_broadcast(&values[0], &output.shape)? }
            right_value :: if values[1].shape == output.shape { values[1].clone() } else { jet_compute_materialize_broadcast(&values[1], &output.shape)? }
            left_values :: jet_compute_tensor_values(&left_value)
            right_values :: jet_compute_tensor_values(&right_value)
            left_mask := [F64].with_capacity(output_values.len())
            right_mask := [F64].with_capacity(output_values.len())
            for ((output, a), b) in output_values.iter().zip(left_values.iter()).zip(right_values.iter()) {
                if *a == *b { return Err(JetComputeError.Unsupported("maximum/minimum has no derivative at a tie")) }
                left_slot :: if (maximum && *a == *output) || (!maximum && *a == *output) { 1.0 } else { 0.0 }
                right_slot :: if (maximum && *b == *output) || (!maximum && *b == *output) { 1.0 } else { 0.0 }
                left_mask.push(left_slot)
                right_mask.push(right_slot)
            }
            left_mask :: jet_compute_tensor_from_values_like(output, &left_mask)?
            right_mask :: jet_compute_tensor_from_values_like(output, &right_mask)?
            left :: jet_compute_binary("mul", &left_mask, &cot)?
            right :: jet_compute_binary("mul", &right_mask, &cot)?
            Ok([jet_compute_reduce_to_shape(&left, &values[0].shape)?, jet_compute_reduce_to_shape(&right, &values[1].shape)?])
        }
        JetComputeTapeRule.Matmul -> {
            (a, b) :: jet_compute_vjp_matmul(&values[0], &values[1], &cot)?
            Ok([^a, ^b])
        }
        JetComputeTapeRule.MatmulF32Tile -> {
            (a, b) :: jet_compute_vjp_matmul_f32_tile(&values[0], &values[1], &cot)?
            Ok([^a, ^b])
        }
        // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8750-8753
        // CUT #3955: AI/ML library removed by owner ruling
//RS         JetComputeTapeRule::MseLoss => Ok(vec![
//RS             jet_compute_mse_vjp(&values[0], &values[1], &cot, true)?,
//RS             jet_compute_mse_vjp(&values[0], &values[1], &cot, false)?,
//RS         ]),
        // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8754-8762
        // CUT #3955: AI/ML library removed by owner ruling
//RS         JetComputeTapeRule::SgdStep { learning_rate } => {
//RS             let (parameter, gradient) = jet_compute_sgd_vjp(
//RS                 &values[0],
//RS                 &values[1],
//RS                 &cot,
//RS                 *learning_rate,
//RS             )?;
//RS             Ok(vec![parameter, gradient])
//RS         }
        JetComputeTapeRule.Unary(op) -> Ok([jet_compute_unary_vjp(op, &values[0], output, &cot)?])
        JetComputeTapeRule.Reshape{source_shape} -> Ok([jet_compute_reshape(&cot, &source_shape.clone())?])
        JetComputeTapeRule.Broadcast{source_shape} -> Ok([jet_compute_reduce_to_shape(&cot, source_shape)?])
        JetComputeTapeRule.ReduceToShape{source_shape} -> Ok([jet_compute_broadcast_to(&cot, source_shape)?])
        JetComputeTapeRule.Transpose -> Ok([jet_compute_transpose(&cot)?])
        JetComputeTapeRule.SumAxis{axis, source_shape} -> {
            reduced_shape := source_shape.clone()
            reduced_shape[*axis] = 1
            cot :: jet_compute_reshape(&cot, &reduced_shape)?
            Ok([jet_compute_broadcast_to(&cot, source_shape)?])
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8789
fn jet_compute_reverse(state: &JetComputeVjpState, seed: &JetTensor) -> [JetTensor] JetComputeError! {
    jet_compute_validate_tensor(&state.value)?
    jet_compute_validate_tensor(seed)?
    if state.value.shape != seed.shape { return Err(JetComputeError.RankMismatch("VJP seed shape must equal the function output shape")) }
    jet_compute_require_same_contract(&state.value, seed, "VJP seed")?
    // GATE #4565: kernel primitive
    (nodes, inputs) :: #Unsafe("snapshot retained tape nodes and inputs under their mutex with poison errors preserved") {
        tape :: state.tape.lock().map_err(fn(_) { JetComputeError.Unsupported("autodiff tape is poisoned") })?
        (tape.nodes.clone(), tape.inputs.clone())
    }
    cotangents := [JetTensor?].filled(nodes.len(), None)
    if Val(output_node) :: state.output_node {
        slot :: cotangents.get_mut(output_node).ok_or_else(fn() { JetComputeError.Unsupported("VJP output node is outside its tape") })?
        *slot = Val(jet_compute_untracked(seed))
    }
    // Input leaves retain accumulated cotangents; reverse only operation nodes.
    for index in (inputs.len()..nodes.len()).rev() {
        cot :: match cotangents[index].take() { Val(cot) -> ^cot, None -> continue }
        node :: &nodes[index]
        rule :: match node.rule.as_ref() { Val(rule) -> rule, None -> continue }
        gradients :: jet_compute_rule_gradients(rule, &node.values, &node.output, &cot, &state.tape)?
        for (parent, gradient) in node.parents.iter().zip(gradients) {
            parent :: match parent { Val(parent) -> parent, None -> continue }
            gradient :: jet_compute_remove_trace_level(&gradient, &state.tape)
            slot :: cotangents.get_mut(*parent).ok_or_else(fn() { JetComputeError.Unsupported("VJP parent node is outside its tape") })?
            *slot = Val(match slot.take() {
                Val(previous) -> jet_compute_binary("add", &previous, &gradient)?
                None -> ^gradient
            })
        }
    }
    result := [JetTensor].with_capacity(inputs.len())
    for (index, input) in inputs.iter().enumerate() {
        gradient :: cotangents.get(index).and_then(fn(value) { value.as_ref() }).cloned().unwrap_or(jet_compute_zero_like(input)?)
        result.push(jet_compute_inherit_placement(^gradient, input))
    }
    Ok(^result)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8862
fn jet_compute_select_gradients(all: [JetTensor], targets: &[I64]) -> [JetTensor] JetComputeError! {
    targets.iter().map(fn(target) {
        index :: USize.try_from(*target).map_err(fn(_) { JetComputeError.Unsupported("negative autodiff target index") })?
        all.get(index).cloned().ok_or_else(fn() { JetComputeError.Unsupported("autodiff target index is outside the function signature") })
    }).collect()
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8879
fn jet_compute_gradient_seed(state: &JetComputeVjpState) -> JetTensor JetComputeError! {
    if jet_compute_tensor_numel(&state.value) != 1 { return Err(JetComputeError.RankMismatch("compute.gradient requires a scalar Tensor output")) }
    Ok(jet_compute_inherit_placement(jet_compute_ones(&state.value.shape)?, &state.value))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8891
fn jet_compute_vjp_pull(state: &JetComputeVjpState, seed: &JetTensor, targets: &[I64]) -> [JetTensor] JetComputeError! {
    jet_compute_select_gradients(jet_compute_reverse(state, seed)?, targets)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8899
fn jet_compute_vjp_pull_or_panic(state: &JetComputeVjpState, seed: &JetTensor, targets: &[I64], context: String) -> [JetTensor] {
    match jet_compute_vjp_pull(state, seed, targets) {
        Ok(values) -> ^values
        Err(error) -> jet_panic("Compute.rs", 8907, &"{context}: {error.jet_show()}")
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8915
/// Shared AOT/interpreter dispatcher owns selection, seeding and VJP state.
fn jet_compute_transform(method: String, state: &JetComputeVjpState, tangents: &[JetTensor], targets: &[I64]) -> JetComputeTransformResult JetComputeError! {
    value :: jet_compute_remove_trace_level(&state.value, &state.tape)
    match method {
        "gradient" -> Ok(JetComputeTransformResult.Gradient(jet_compute_vjp_pull(state, &jet_compute_gradient_seed(state)?, targets)?))
        "value_and_gradient" -> Ok(JetComputeTransformResult.ValueAndGradient{value: ^value, gradients: jet_compute_vjp_pull(state, &jet_compute_gradient_seed(state)?, targets)?})
        "vjp" -> Ok(JetComputeTransformResult.Vjp{value: ^value, state: state.clone()})
        "jvp" -> Ok(JetComputeTransformResult.Jvp{value: ^value, tangent: jet_compute_jvp(state, tangents.to_vec())?})
        _ -> Err(JetComputeError.Unsupported("unknown autodiff transform `{method}`"))
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8944
fn jet_compute_nested_gradient(states: &[JetComputeVjpState], targets: &[I64]) -> [[JetTensor]] JetComputeError! {
    jet_compute_seeded_gradient_rows(states, targets)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8951
fn jet_compute_jvp_rule(rule: &JetComputeTapeRule, values: &[JetTensor], output: &JetTensor, tangents: &[JetTensor]) -> JetTensor JetComputeError! {
    match rule {
        JetComputeTapeRule.Add -> jet_compute_binary("add", &tangents[0], &tangents[1])
        JetComputeTapeRule.Sub -> jet_compute_binary("sub", &tangents[0], &tangents[1])
        JetComputeTapeRule.Mul -> {
            left :: jet_compute_binary("mul", &tangents[0], &values[1])?
            right :: jet_compute_binary("mul", &values[0], &tangents[1])?
            jet_compute_binary("add", &left, &right)
        }
        JetComputeTapeRule.Div -> {
            left :: jet_compute_binary("div", &tangents[0], &values[1])?
            numerator :: jet_compute_binary("mul", &values[0], &tangents[1])?
            denominator :: jet_compute_binary("mul", &values[1], &values[1])?
            right :: jet_compute_binary("div", &numerator, &denominator)?
            jet_compute_binary("sub", &left, &right)
        }
        JetComputeTapeRule.Maximum | JetComputeTapeRule.Minimum -> {
            maximum :: matches(rule, JetComputeTapeRule.Maximum)
            output_values :: jet_compute_tensor_values(output)
            left_value :: if values[0].shape == output.shape { values[0].clone() } else { jet_compute_materialize_broadcast(&values[0], &output.shape)? }
            right_value :: if values[1].shape == output.shape { values[1].clone() } else { jet_compute_materialize_broadcast(&values[1], &output.shape)? }
            left_tangent :: if tangents[0].shape == output.shape { tangents[0].clone() } else { jet_compute_broadcast_to(&tangents[0], &output.shape.to_vec())? }
            right_tangent :: if tangents[1].shape == output.shape { tangents[1].clone() } else { jet_compute_broadcast_to(&tangents[1], &output.shape.to_vec())? }
            left_values :: jet_compute_tensor_values(&left_value)
            right_values :: jet_compute_tensor_values(&right_value)
            left_mask := [F64].with_capacity(output_values.len())
            right_mask := [F64].with_capacity(output_values.len())
            for ((output, a), b) in output_values.iter().zip(left_values.iter()).zip(right_values.iter()) {
                if *a == *b { return Err(JetComputeError.Unsupported("maximum/minimum has no JVP at a tie")) }
                if (maximum && *a == *output) || (!maximum && *a == *output) {
                    left_mask.push(1.0)
                    right_mask.push(0.0)
                } else {
                    left_mask.push(0.0)
                    right_mask.push(1.0)
                }
            }
            left_mask :: jet_compute_tensor_from_values_like(output, &left_mask)?
            right_mask :: jet_compute_tensor_from_values_like(output, &right_mask)?
            left :: jet_compute_binary("mul", &left_mask, &left_tangent)?
            right :: jet_compute_binary("mul", &right_mask, &right_tangent)?
            jet_compute_binary("add", &left, &right)
        }
        JetComputeTapeRule.Matmul -> {
            left :: jet_compute_matmul(&tangents[0], &values[1])?
            right :: jet_compute_matmul(&values[0], &tangents[1])?
            jet_compute_binary("add", &left, &right)
        }
        JetComputeTapeRule.MatmulF32Tile -> jet_compute_jvp_matmul_f32_tile(&values[0], &values[1], &tangents[0], &tangents[1])
        // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9034-9039
        // CUT #3955: AI/ML library removed by owner ruling
//RS         JetComputeTapeRule::MseLoss => jet_compute_mse_jvp(
//RS             &values[0],
//RS             &values[1],
//RS             &tangents[0],
//RS             &tangents[1],
//RS         ),
        // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:9040-9044
        // CUT #3955: AI/ML library removed by owner ruling
//RS         JetComputeTapeRule::SgdStep { learning_rate } => jet_compute_sgd_step(
//RS             &tangents[0],
//RS             &tangents[1],
//RS             *learning_rate,
//RS         ),
        JetComputeTapeRule.Unary(op) -> jet_compute_unary_vjp(op, &values[0], output, &tangents[0])
        JetComputeTapeRule.Reshape{..} -> jet_compute_reshape(&tangents[0], &output.shape)
        JetComputeTapeRule.Broadcast{..} -> jet_compute_broadcast_to(&tangents[0], &output.shape)
        JetComputeTapeRule.ReduceToShape{..} -> jet_compute_reduce_to_shape(&tangents[0], &output.shape)
        JetComputeTapeRule.Transpose -> jet_compute_transpose(&tangents[0])
        JetComputeTapeRule.SumAxis{axis, ..} -> jet_compute_sum_axis(&tangents[0], I64{*axis})
    }
}

