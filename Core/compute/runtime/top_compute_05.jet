    if target_shape.is_empty() || target_shape.len() > tensor.shape.len() { return Err(JetComputeError.RankMismatch("gradient target must be a ranked tensor with no greater rank")) }
    if jet_compute_broadcast_shape(target_shape, &tensor.shape)? != tensor.shape { return Err(JetComputeError.RankMismatch("gradient shape {target_shape:?} is not broadcast-compatible with {tensor.shape:?}")) }
