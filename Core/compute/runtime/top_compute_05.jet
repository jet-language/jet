            }
        }
    }
    output_shape :: if b.shape.len() == 1 { [a.shape[0]] } else { [a.shape[0], b.shape[1]] }
    out := jet_compute_tensor_from_shape(^output_shape, 0.0, JetComputeDevice.Cpu)?
    for row in 0..n {
        for col in 0..rhs_cols {
            index :: if b.shape.len() == 1 { [I64{row}] } else { [I64{row}, I64{col}] }
