    out.last_placement.reason = "transfer kind={transfer_kind} bytes={bytes} from={from.jet_show()} to={out.device.jet_show()}"
    receipt :: JetComputeTransferReceipt{from: from, to: out.device, bytes: bytes, fallback: if from == out.device { "none" } else { "not-applicable" }}
    jet_compute_validate_transfer_receipt(&out, &receipt)?
    out.last_transfer = Val(^receipt)
    // GATE #4565: kernel primitive
    #Unsafe("publish transfer completion only to the existing current native resource frame") {
        if ResourceSchedule.current_frame_completion_state().is_some() {
            ResourceSchedule.signal_frame_completion("jet_compute_transfer").map_err(JetComputeError.Device)?
        }
    }
    Ok(^out)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:8392
fn jet_compute_transfer_show(tensor: &JetTensor) -> String {
