}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7981,8105
// Both profiles retain radix-2 butterflies and Bluestein's padded convolution.
fn jet_compute_fft_radix2_f64(values: [F64]) -> [F64] JetComputeError! {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs:7984
    fn radix2(real: &[F64], imaginary: &[F64], inverse: Bool) -> () {
        n :: real.len()
        if n <= 1 { return }
        direction :: if inverse { 2.0 } else { -2.0 }
        phase :: direction * F64{3.14159265358979323846264338327950288} / F64{n}
        twiddles :: (0..n / 2).map(fn(index) { (phase * F64{index}).sin_cos() }).collect::<[(F64, F64)]>()
        reversed := USize{0}
        for index in 1..n {
            bit := n >> 1
            while reversed & bit != 0 { reversed ^= bit; bit >>= 1 }
            reversed ^= bit
            if index < reversed { real.swap(index, reversed); imaginary.swap(index, reversed) }
        }
        stage_length := USize{2}
        while stage_length <= n {
            half :: stage_length / 2
            twiddle_step :: n / stage_length
            for block_start in (0..n).step_by(stage_length) {
                for offset in 0..half {
                    even :: block_start + offset
                    odd :: even + half
                    (sin, cos) :: twiddles[offset * twiddle_step]
                    product_real :: cos * real[odd] - sin * imaginary[odd]
                    product_imaginary :: cos * imaginary[odd] + sin * real[odd]
                    even_real :: real[even]
                    even_imaginary :: imaginary[even]
                    real[even] = even_real + product_real
                    imaginary[even] = even_imaginary + product_imaginary
                    real[odd] = even_real - product_real
                    imaginary[odd] = even_imaginary - product_imaginary
                }
            }
            if stage_length == n { break }
            stage_length <<= 1
        }
        if inverse {
            scale :: F64{1.0} / F64{n}
            for index in 0..n { real[index] *= scale; imaginary[index] *= scale }
        }
    }
    n :: values.len()
    (real, imaginary) :: if n.is_power_of_two() {
        real := ^values
        imaginary := [F64{0.0}].repeat(n)
        radix2(&real, &imaginary, false)
        (^real, ^imaginary)
    } else {
        padded :: n.checked_mul(2).and_then(fn(length) { length.checked_sub(1) }).and_then(USize.checked_next_power_of_two).ok_or_else(fn() { JetComputeError.InvalidShape("fft convolution length overflow") })?
        real := [F64{0.0}].repeat(padded)
        imaginary := [F64{0.0}].repeat(padded)
        kernel_real := [F64{0.0}].repeat(padded)
        kernel_imaginary := [F64{0.0}].repeat(padded)
        chirps :: (0..n).map(fn(index) {
            // Reduce before conversion to preserve phase at large indexes.
            square :: (U128{index} * U128{index}) % (2 * U128{n})
            (F64{3.14159265358979323846264338327950288} * F64{square} / F64{n}).sin_cos()
        }).collect::<[(F64, F64)]>()
        for (index, value) in values.into_iter().enumerate() {
            (sin, cos) :: chirps[index]
            real[index] = value * cos
            imaginary[index] = -value * sin
            kernel_real[index] = cos
            kernel_imaginary[index] = sin
            if index != 0 { kernel_real[padded - index] = cos; kernel_imaginary[padded - index] = sin }
        }
        radix2(&real, &imaginary, false)
        radix2(&kernel_real, &kernel_imaginary, false)
        for index in 0..padded {
            product_real :: real[index] * kernel_real[index] - imaginary[index] * kernel_imaginary[index]
            imaginary[index] = real[index] * kernel_imaginary[index] + imaginary[index] * kernel_real[index]
            real[index] = product_real
        }
        radix2(&real, &imaginary, true)
        real.truncate(n)
        imaginary.truncate(n)
        for (index, (sin, cos)) in chirps.into_iter().enumerate() {
            rotated_real :: real[index] * cos + imaginary[index] * sin
            imaginary[index] = imaginary[index] * cos - real[index] * sin
            real[index] = rotated_real
        }
        (^real, ^imaginary)
    }
    output := [F64].with_capacity(n * 2)
    for (real, imaginary) in real.into_iter().zip(imaginary) { output.push(real); output.push(imaginary) }
    Ok(^output)
}
