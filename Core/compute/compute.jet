package {
    name: "core.compute"
    version: "0.0.1"
    edition: "2026"
    description: "Tensors, devices, and autodiff."
    license: "MIT"
    outputs: {
        compute: .Library{ entry: compute }
    }
}

// core.compute publishes the ranked compute vocabulary. Storage, placement,
// autodiff traces, streams, and execution receipts have one owner: the shared
// compute provider. The registered functions bind these opaque carriers in
// both compiler halves; there is no second Vec-backed tensor implementation.
// Construct tensors and inspect them through the core.compute operations.

use core.compute.[ComputeDevice, ComputeError, ComputeStream, SparseTensor, Tensor, VJPRun]
