// core.reactive.loadable — async slot states.
pub enum Loadable {
    Idle
    Loading
    Loaded(Int)
    Failed(String)
}

pub fn idle() -> Loadable { Loadable.Idle }

pub fn loading() -> Loadable { Loadable.Loading }

pub fn loaded(value: Int) -> Loadable { Loadable.Loaded(value) }

pub fn failed(reason: String) -> Loadable { Loadable.Failed(reason) }
