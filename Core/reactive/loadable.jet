// core.reactive.loadable — bounded async slot states.
// The provider owns scheduling and transport; this carrier owns the legal
// state transitions and never manufactures a success value from an error.
pub enum Loadable<T, E> {
    Idle
    Loading
    Loaded(T)
    Failed(E)
}

pub fn idle<T, E>() -> Loadable<T, E> { Loadable.Idle }

pub fn loading<T, E>() -> Loadable<T, E> { Loadable.Loading }

pub fn loaded<T, E>(value: T) -> Loadable<T, E> { Loadable.Loaded(value) }

pub fn failed<T, E>(reason: E) -> Loadable<T, E> { Loadable.Failed(reason) }

pub fn is_idle<T, E>(state: Loadable<T, E>) -> Bool {
    if state == {
        .Idle -> true
        else -> false
    }
}
pub fn is_loading<T, E>(state: Loadable<T, E>) -> Bool {
    if state == {
        .Loading -> true
        else -> false
    }
}
pub fn is_loaded<T, E>(state: Loadable<T, E>) -> Bool {
    if state == {
        .Loaded(_) -> true
        else -> false
    }
}
pub fn is_failed<T, E>(state: Loadable<T, E>) -> Bool {
    if state == {
        .Failed(_) -> true
        else -> false
    }
}

pub fn value<T, E>(state: Loadable<T, E>) -> T? {
    if state == {
        .Loaded(value) -> Val(value)
        else -> None
    }
}

pub fn reason<T, E>(state: Loadable<T, E>) -> E? {
    if state == {
        .Failed(message) -> Val(message)
        else -> None
    }
}

// Retry starts a fresh attempt only from an idle or failed state.  A loaded
// result is stable, and retrying an in-flight request must not discard it.
pub fn retry<T, E>(state: Loadable<T, E>) -> Loadable<T, E> {
    if is_failed<T, E>(state) || is_idle<T, E>(state) -> return Loadable.Loading
    ~state
}
