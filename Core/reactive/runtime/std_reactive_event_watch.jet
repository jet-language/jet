                Err(e) -> [WatchEvent{domain: .File, kind: .Error, path: root.clone(), detail: "{e:Debug}", pid: 0, port: 0}]
            }
            .Process(pid) -> {
                alive :: pid > 0 && jet_process_alive(pid)
                id :: "watch:process:{pid}"
                if state.seen_ready && not alive {
                    state.seen_ready = false
                    jet_watch_publish_readiness(&id, "not_ready", "waiting_for_process")
                    [WatchEvent{domain: .Process, kind: .Exited, path: "", detail: "process exited", pid: pid, port: 0}]
                } else if not state.seen_ready && alive {
                    state.seen_ready = true
                    jet_watch_publish_readiness(&id, "ready", "probe_passed")
                    [WatchEvent{domain: .Process, kind: .Ready, path: "", detail: "process is running", pid: pid, port: 0}]
                } else if not state.seen_ready && not alive {
