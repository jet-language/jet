    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2215
    pub fn events(self: &Self) -> [WatchEvent] { self.poll() }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2218
    pub fn summary(self: &Self) -> String { "watchset handles={self.handles.borrow().len()}" }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2223
// GATE #4565: kernel primitive
#Unsafe("snapshot actual selected filesystem using symlink metadata without following directory symlinks")
fn jet_watch_snapshot(root: &String) -> JetWatchSnapshot IOError! {
    out := [String:(U64, I64, Bool)]{}
    stack := [OSPath.from(root)]
    loop stack.pop() is Val(path) {
        meta :: fs.symlink_metadata(&path).map_err(fn(e) { io_error_at(.Read, path.to_string_lossy().as_ref(), ^e) })?
        modified :: meta.modified().ok().and_then(fn(t) { t.duration_since(time.UNIX_EPOCH).ok() }).map(fn(d) { d.as_millis() as U64 }).unwrap_or(0)
        path_s :: path.to_string_lossy().to_string()
        is_dir :: meta.is_dir()
        out[^path_s] = (modified, meta.len() as I64, is_dir)
        if is_dir {
            for entry in fs.read_dir(&path).map_err(fn(e) { io_error_at(.Read, path.to_string_lossy().as_ref(), ^e) })? {
                entry :: entry.map_err(fn(e) { io_error_at(.Read, path.to_string_lossy().as_ref(), ^e) })?
                stack.push(entry.path())
            }
        }
    }
    Ok(^out)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2250
fn jet_watch_diff(old: &JetWatchSnapshot, new: &JetWatchSnapshot) -> [WatchEvent] {
    out := []
    // Rust BTreeMap order: sorted new additions/modifications, then sorted removals.
    new_keys := new.keys().cloned().collect<[String]>()
    new_keys.sort()
    for path in new_keys {
        facts :: new[&path]
        match old.get(&path) {
            None -> out.push(jet_watch_event(.Created, &path, facts.2))
            Val(prev) if prev != facts -> out.push(jet_watch_event(.Modified, &path, facts.2))
            _ -> {}
        }
    }
    old_keys := old.keys().cloned().collect<[String]>()
    old_keys.sort()
    for path in old_keys {
        if not new.contains_key(&path) { out.push(jet_watch_event(.Removed, &path, old[&path].2)) }
    }
    ^out
}
