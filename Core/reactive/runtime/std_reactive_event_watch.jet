    pub fn events(self: &Self) -> [WatchEvent] { self.poll() }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2149
    pub fn on(self: &Self, scope: &JetEventScope, handler: fn(WatchEvent) -> Unit) -> JetSubscription { self.event.on(scope, handler) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2157
    pub fn once(self: &Self, scope: &JetEventScope, handler: fn(WatchEvent) -> Unit) -> JetSubscription { self.event.once(scope, handler) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2165
    pub fn cancel(self: &Self) -> {
        selected :: {
            state := self.state.borrow_mut()
            state.active = false
            state.target.clone()
        }
        match selected {
            .Files(_) -> {}
            .Process(pid) -> jet_watch_publish_readiness("watch:process:{pid}", "not_ready", "stopped")
            .Port(host, port) -> jet_watch_publish_readiness("watch:port:{host}:{port}", "not_ready", "stopped")
        }
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2186
    pub fn active(self: &Self) -> Bool { self.state.borrow().active }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2190
    pub fn summary(self: &Self) -> String {
        match &self.state.borrow().target {
            .Files(root) -> "watch file {root}"
            .Process(pid) -> "watch process {pid}"
            .Port(host, port) -> "watch port {host}:{port}"
        }
    }
}
impl WatchSet {
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2200
    pub fn new() -> Self { WatchSet{handles: Rc.new(RefCell.new([]))} }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2205
    pub fn add(self: &Self, handle: WatchHandle) -> { self.handles.borrow_mut().push(^handle) }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2208
    pub fn poll(self: &Self) -> [WatchEvent] {
