        valid :: port >= 0 && port <= U16.MAX as I64 && not host.is_empty() && not host.chars().any(fn(c) { c.is_control() })
        handle :: WatchHandle{state: Rc.new(RefCell.new(JetWatchState{target: .Port(^host, port),
            snapshot: [:], seen_ready: false, active: true})), event: JetEvent.new()}
        if valid { jet_watch_publish_readiness(&id, "checking", "waiting_for_endpoint") }
        else { jet_watch_publish_readiness(&id, "failed", "probe_failed") }
