//RS     /// A transaction keeps its staged value on the same signal read path.
//RS     /// The cell is thread-local and lives only for the synchronous update
//RS     /// callback, so a read cannot observe an uncommitted value from another
//RS     /// thread. `UnsafeCell` permits the callback's mutable borrow and a
//RS     /// re-entrant signal read to share this one staged value.
//RS     struct ReactiveTransactionValue<T> {
//RS         value: UnsafeCell<T>,
//RS     }
