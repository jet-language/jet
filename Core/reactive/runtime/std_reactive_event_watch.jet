            snapshot: [:], seen_ready: ready, active: true})), event: JetEvent.new()}
        (state, reason) :: if pid <= 0 { ("unknown", "not_checked") }
            else if ready { ("ready", "probe_passed") } else { ("not_ready", "waiting_for_process") }
        jet_watch_publish_readiness("watch:process:{pid}", state, reason)
        ^handle
    }
    // Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2032
    pub fn port(host: String, port: I64) -> Self {
