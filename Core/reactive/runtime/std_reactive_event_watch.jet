// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2282
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2297
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:2321
// GATE #4565: kernel primitive
#Unsafe("selected OS process probe owns Windows handle through wait and close; POSIX errno captured immediately")
fn jet_process_alive(pid: I64) -> Bool {
    if target.selected_family() == "unix" {
        if pid <= 0 { return false }
        pid :: I32.try_from(pid).ok() ?? return false
        result :: kill(pid, 0)
        result == 0 || std.io.Error.last_os_error().raw_os_error() == Val(1)
    } else if target.selected_family() == "windows" {
        if pid <= 0 { return false }
        SYNCHRONIZE :: U32{0x0010_0000}
        WAIT_TIMEOUT :: U32{0x0000_0102}
        pid :: U32.try_from(pid).ok() ?? return false
        handle :: OpenProcess(SYNCHRONIZE, 0, pid)
        if handle.is_null() { return false }
        alive :: WaitForSingleObject(handle, 0) == WAIT_TIMEOUT
        _ :: CloseHandle(handle)
        alive
    } else { pid > 0 && pid == std.process.id() as I64 }
}
