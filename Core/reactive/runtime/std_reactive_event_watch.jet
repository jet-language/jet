// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:1918
#Derive(Clone)
enum JetWatchTarget { Files(root: String), Process(pid: I64), Port(host: String, port: I64) }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:1924
type JetWatchSnapshot = [String:(U64, I64, Bool)]
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:1926
#Derive(Clone)
struct JetWatchState { target: JetWatchTarget, snapshot: JetWatchSnapshot, seen_ready: Bool, active: Bool }
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:1933
// GATE #4565: kernel primitive
fn jet_watch_topology_now() -> U64 {
    #Unsafe("native wall clock supplies actual readiness timestamp") {
        time.SystemTime.now().duration_since(time.UNIX_EPOCH).ok()
            .and_then(fn(duration) { U64.try_from(duration.as_millis()).ok() }).unwrap_or(0)
    }
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:1941
fn jet_watch_json_string(value: &String) -> String {
    escaped := String.with_capacity(value.len() + 2)
    escaped.push('"')
    for character in value.chars() {
        match character {
            '"' -> escaped.push_str("\\\"")
            '\\' -> escaped.push_str("\\\\")
            '\n' -> escaped.push_str("\\n")
            '\r' -> escaped.push_str("\\r")
            '\t' -> escaped.push_str("\\t")
            character if character.is_control() -> escaped.push_str("\\u{character as U32:04x}")
            character -> escaped.push(character)
        }
    }
    escaped.push('"')
    ^escaped
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs:1961
fn jet_watch_publish_readiness(id: &String, state: &String, reason: &String) -> {
    timestamp :: jet_watch_topology_now()
    fields :: "{{\"id\":{jet_watch_json_string(id)},\"source\":\"watch-runtime\",\"parent_id\":null,\"state\":{jet_watch_json_string(state)},\"reason\":{jet_watch_json_string(reason)},\"freshness\":{{\"state\":\"fresh\",\"observed_at_ms\":{timestamp}}}}}"
    if JetDevtoolsEvent.from_parts(timestamp, "watch-runtime", "Readiness", id, ^fields) is Ok(event) { jet_devtools_publish_event(^event) }
}
