//RS         pub fn value(&self) -> f64 {
//RS             self.value
//RS         }
//RS         pub fn uncertainty(&self) -> f64 {
//RS             self.uncertainty
//RS         }
//RS         // Addition / subtraction: σ_z = sqrt(σ_a² + σ_b²)
