                id :: "watch:port:{host}:{port}"
                if ready && not state.seen_ready {
                    state.seen_ready = true
                    jet_watch_publish_readiness(&id, "ready", "probe_passed")
                    [WatchEvent{domain: .Port, kind: .Ready, path: "", detail: "{host}:{port}", pid: 0, port: port}]
                } else if not ready && state.seen_ready {
                    state.seen_ready = false
                    jet_watch_publish_readiness(&id, "not_ready", "probe_failed")
