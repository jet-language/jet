package {
    name: "core.reactive"
    version: "0.0.1"
    edition: "2026"
    description: "Signals, derived values, and effects."
    license: "MIT"
    outputs: {
        reactive: .Library{ entry: reactive }
    }
}
module loadable

// Reactive values are immutable Jet carriers. The runtime provider owns the
// `signal`, `computed`, `derived` and `effect` constructors, which return
// shared, dependency-tracked cells; keeping the transition rules here makes
// the source-level API deterministic as well.
struct Signal<T> {
    value: T
    version: Int
}

struct Computed<T> {
    value: T
    version: Int
}

struct Derived<T> {
    value: T
    version: Int
}

struct Effect {
    last: Int
    active: Bool
}

fn unsubscribe(e: Effect) -> Effect Never! {
    Effect{last: e.last, active: false}
}

fn is_active(e: Effect) -> Bool Never! { e.active }

fn set<T>(sig: Signal<T>, value: T) -> Signal<T> Never! {
    Signal<T>{value: value, version: sig.version + 1}
}

fn set_if_changed(sig: Signal<Int>, value: Int) -> Signal<Int> Never! {
    if sig.value == value -> return sig.copy()
    set(sig, value)
}

fn changed(sig: Signal<Int>, value: Int) -> Bool Never! { sig.value != value }

fn computed_update(c: Computed<Int>, delta: Int) -> Computed<Int> Never! {
    computed_set(c, c.value + delta)
}

fn computed_version<T>(c: Computed<T>) -> Int Never! { c.version }

fn effect_run_if(e: Effect, value: Int) -> Effect Never! {
    if e.active && e.last == value -> return e.copy()
    effect_run(e, value)
}

fn effect_changed(e: Effect, value: Int) -> Bool Never! { !e.active || e.last != value }

fn get<T>(sig: Signal<T>) -> T Never! { sig.value }

fn version<T>(sig: Signal<T>) -> Int Never! { sig.version }

fn update(sig: Signal<Int>, delta: Int) -> Signal<Int> Never! { set(sig, sig.value + delta) }

fn computed_get<T>(c: Computed<T>) -> T Never! { c.value }

fn computed_set<T>(c: Computed<T>, value: T) -> Computed<T> Never! {
    Computed<T>{value: value, version: c.version + 1}
}

fn effect_run(e: Effect, value: Int) -> Effect Never! {
    if !e.active || e.last != value -> return Effect{last: value, active: true}
    e.copy()
}

fn effect_last(e: Effect) -> Int Never! { e.last }
